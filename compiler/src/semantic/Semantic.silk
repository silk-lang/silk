fn answerLayoutIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Layout {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    _ => Option.none<usize>()
  }
}

fn answerLayoutUnsupported(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: selected} => match &selected {
        Value.LayoutUnsupported => true
        _ => false
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn signatureBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.typeParameters,
      ) + Vector.length<Shared<Lifetime>>(&signature.lifetimeParameters) + Vector.length<
        RowParameter,
      >(&signature.rowParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureCallableParameterStart(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      return signature.callableParameterStart
    }
  }
  return usize.MAX
}

// Snapshot one binder handle without retaining a borrow of the cached signature.
union InferenceBinder {
  Type {value: Shared<Type>},
  Lifetime {value: Shared<Lifetime>},
  Row {value: RowParameter},
}

fn inferenceBinderAt(answer: &Result<Answer, NoRejection>, ordinal: usize) -> Option<InferenceBinder> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      // Signature lists group kinds; substitution slots follow the written binder ordinal.
      let types = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
      let mut at = usize.ZERO
      while at < types.length {
        let found = Shared.with<Type, usize>(&types[at], fn(ty: &Type) -> usize {
          return match &ty.* { Type.Parameter {ordinal: position, ..} => position _ => usize.MAX }
        })
        if found == ordinal { return Option.some<InferenceBinder>(InferenceBinder.Type {value: Shared.clone<Type>(&types[at])}) }
        at = at + usize.ONE
      }
      let regions = Vector.asSlice<Shared<Lifetime>>(&signature.lifetimeParameters)
      at = usize.ZERO
      while at < regions.length {
        let found = Shared.with<Lifetime, usize>(&regions[at], fn(region: &Lifetime) -> usize {
          return match &region.* { Lifetime.Parameter {ordinal: position, ..} => position _ => usize.MAX }
        })
        if found == ordinal { return Option.some<InferenceBinder>(InferenceBinder.Lifetime {value: Shared.clone<Lifetime>(&regions[at])}) }
        at = at + usize.ONE
      }
      let rows = Vector.asSlice<RowParameter>(&signature.rowParameters)
      at = usize.ZERO
      while at < rows.length {
        if rows[at].ordinal == ordinal { return Option.some<InferenceBinder>(InferenceBinder.Row {value: RowParameter {
          declaration: Shared.clone<DeclarationId>(&rows[at].declaration), ordinal: rows[at].ordinal,
        }}) }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<InferenceBinder>()
}

fn signatureRetainedRegion(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Lifetime>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if let Option<Intersection>.Some {value: environment} = &signature.environment {
        let listed = Vector.asSlice<LifetimeMember>(&environment.members)
        if at < listed.length { return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&listed[at].region)) }
      }
    }
  }
  return Option.none<Shared<Lifetime>>()
}

effect fn applyConstraintBindings(value: &Constraint, bindings: &[Binding]) -> Constraint
! OutOfMemoryError
? &mut Allocator {
  return match & value.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: run Type.applyBindings(&provider, bindings, true),
      contract: run Type.applyBindings(&contract, bindings, true),
    }
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: run Type.applyBindings(&parameter, bindings, true),
      contract: run Type.applyBindings(&contract, bindings, true),
    }
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: run Type.applyBindings(&subject, bindings, true),
      region: run Type.applyLifetimeBindings(&region, bindings),
    }
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: run Type.applyLifetimeBindings(&longer, bindings),
      shorter: run Type.applyLifetimeBindings(&shorter, bindings),
    }
    Constraint.Copyable {subject} => Constraint.Copyable {
      subject: run Type.applyBindings(&subject, bindings, true),
    }
    Constraint.Property {subject, property} => Constraint.Property {
      subject: run Type.applyBindings(&subject, bindings, true),
      property: property,
    }
    Constraint.Provides {provider, selector, source} => Constraint.Provides {
      provider: run Type.applyBindings(&provider, bindings, true),
      selector: run Row.applyBindings(&selector, bindings, true),
      source: run Row.applyBindings(&source, bindings, true),
    }
  }
}

effect fn appendInferenceSlot(
  owner: &DeclarationId,
  slot: &ApplicationSlot,
  fresh: &DeclarationId,
  dense: usize,
  types: &mut Vector<Shared<Type>>,
  lifetimes: &mut Vector<Shared<Lifetime>>,
  rows: &mut Vector<RowParameter>,
  bindings: &mut Vector<Binding>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let argument = run scopeArgument(fresh, dense, slot.kind)
  match & argument {
    Argument.Type {value} => {
      run Vector.append<Shared<Type>>(&mut types.*, Shared.clone<Type>(&value))
    }
    Argument.Lifetime {value} => {
      run Vector.append<Shared<Lifetime>>(&mut lifetimes.*, Shared.clone<Lifetime>(&value))
    }
    Argument.Row {..} => {
      run Vector.append<RowParameter>(
        &mut rows.*,
        RowParameter {
          declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)),
          ordinal: dense,
        },
      )
    }
  }
  run Vector.append<Binding>(
    &mut bindings.*,
    Binding {
      declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(owner)),
      ordinal: slot.ordinal,
      value: move argument,
    },
  )
  return ()
}

// This transformation has no query/resolver calls. Fresh identities exist only in local owned
// handles and unification bindings, never in query interning, caches or backend instance keys.
effect fn callInferenceSignature(
  resolver: &Resolver,
  signature: &Shared<Result<Answer, NoRejection>>,
  schema: &TargetSchema,
  fresh: &DeclarationId,
  module: &ModuleId,
  span: Span,
) -> Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(signature, signatureFacts,
  ) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Result.failResult<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(run reject(resolver, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let mut types = Vector.make<Shared<Type>>()
  let mut lifetimes = Vector.make<Shared<Lifetime>>()
  let mut rows = Vector.make<RowParameter>()
  let mut remappedBindings = Vector.make<Binding>()
  let mut callableParameterStart = usize.MAX
  let mut at = usize.ZERO
  let scopes = Vector.asSlice<ApplicationScope>(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let scopeOwner = run DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = Vector.asSlice<ApplicationSlot>(&scopes[scopeAt].slots)
    let mut slotAt = usize.ZERO
    while slotAt < slots.length {
      if Shared.with<Result<Answer, NoRejection>, bool>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(answer, &scopeOwner, slots[slotAt]) }) {
        run appendInferenceSlot(
          &scopeOwner,
          &slots[slotAt],
          fresh,
          at,
          &mut types,
          &mut lifetimes,
          &mut rows,
          &mut remappedBindings,
        )
        at = at + usize.ONE
      }
      slotAt = slotAt + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  let ownOwner = run DeclarationId.copyShared(&schema.declaration)
  let own = Vector.asSlice<ApplicationSlot>(&schema.own)
  let mut ownAt = usize.ZERO
  while ownAt < own.length {
    if own[ownAt].ordinal == facts.callableParameterStart {
      callableParameterStart = at
    }
    run appendInferenceSlot(
      &ownOwner,
      &own[ownAt],
      fresh,
      at,
      &mut types,
      &mut lifetimes,
      &mut rows,
      &mut remappedBindings,
    )
    at = at + usize.ONE
    ownAt = ownAt + usize.ONE
  }
  return Result.succeed<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(
    run applyCallInferenceSignature(signature, &facts, move types, move lifetimes, move rows,
      callableParameterStart, Vector.asSlice<Binding>(&remappedBindings)))
}

// Rebuild signature contents while retaining the binder lists and their dense coordinates.
effect fn applyCallInferenceSignature(signature: &Shared<Result<Answer, NoRejection>>, facts: &SignatureFacts,
  types: Vector<Shared<Type>>, lifetimes: Vector<Shared<Lifetime>>, rows: Vector<RowParameter>,
  callableParameterStart: usize, mapped: &[Binding]) -> Shared<Result<Answer, NoRejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut parameters = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < facts.parameters {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) },
    )
    if let Option<Shared<Type>>.Some {value} = move parameter {
      run Vector.append<Shared<Type>>(
        &mut parameters,
        run Type.applyBindings(&value, mapped, true),
      )
    }
    at = at + usize.ONE
  }
  let mut constraints = Vector.make<Constraint>()
  at = usize.ZERO
  while at < facts.constraints {
    let constraint = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) },
    )
    if let Option<Constraint>.Some {value} = move constraint {
      run Vector.append<Constraint>(&mut constraints, run applyConstraintBindings(&value, mapped))
    }
    at = at + usize.ONE
  }
  let mut environment = Option.none<Intersection>()
  if facts.environment != usize.MAX {
    let mut regions = Vector.make<Shared<Lifetime>>()
    at = usize.ZERO
    while at < facts.environment {
      let region = Shared.with<Result<Answer, NoRejection>, Option<Shared<Lifetime>>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureRetainedRegion(answer, at) },
      )
      if let Option<Shared<Lifetime>>.Some {value} = move region {
        run Vector.append<Shared<Lifetime>>(
          &mut regions,
          run Type.applyLifetimeBindings(&value, mapped),
        )
      }
      at = at + usize.ONE
    }
    environment = Option.some<Intersection>(
      run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)),
    )
  }
  let result = run Type.applyBindings(&facts.result, mapped, true)
  let failure = run Type.applyBindings(&facts.failure, mapped, true)
  let requirements = run Row.applyBindings(&facts.requirements, mapped, true)
  let applied = memberSuccess(
    Value.Signature {
      signature: Signature {
        typeParameters: move types,
        callableParameterStart: callableParameterStart,
        lifetimeParameters: move lifetimes,
        rowParameters: move rows,
        constraints: move constraints,
        parameters: move parameters,
        result: move result,
        failure: move failure,
        requirements: move requirements,
        isEffect: facts.isEffect,
        isVariadic: facts.isVariadic,
        isUnsafe: facts.isUnsafe,
        isStatic: facts.isStatic,
        staticSlots: run signatureStaticSlots(signature, facts.staticSlots),
        environment: move environment,
      },
    },
    Vector.make<Dependency>(),
  )
  return run Shared.make<Result<Answer, NoRejection>>(Result.succeed<Answer, NoRejection>(move applied))
}

// Explicit types are fixed before operand inference, so their omitted regions are visible even
// behind an ordinary type parameter. Extra binders are private to this call and follow every
// original scope/own slot; they are never coordinates in a target application.
effect fn callPrefixInferenceSignature(original: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  extra: usize, fixed: &[Binding]) -> Shared<Result<Answer, NoRejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let facts = match move Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(original, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  let mut types = Vector.make<Shared<Type>>()
  let mut lifetimes = Vector.make<Shared<Lifetime>>()
  let mut rows = Vector.make<RowParameter>()
  let mut at = usize.ZERO
  while at < facts.binders {
    let binder = Shared.with<Result<Answer, NoRejection>, Option<InferenceBinder>>(original,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => { run Vector.append<Shared<Type>>(&mut types, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {value}} => { run Vector.append<Shared<Lifetime>>(&mut lifetimes, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => { run Vector.append<RowParameter>(&mut rows, move value) }
      _ => { fail RevisionMismatch {} }
    }
    at = at + usize.ONE
  }
  let mut generated = usize.ZERO
  while generated < extra {
    run Vector.append<Shared<Lifetime>>(&mut lifetimes, run Shared.make<Lifetime>(Lifetime.Parameter {
      declaration: run DeclarationId.copy(fresh), ordinal: facts.binders + generated}))
    generated = generated + usize.ONE
  }
  return run applyCallInferenceSignature(original, &facts, move types, move lifetimes, move rows,
    facts.callableParameterStart, fixed)
}

effect fn typeMentionsOwner(value: &Shared<Type>, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  return Vector.length<usize>(&types) > usize.ZERO || Vector.length<usize>(&lifetimes) > usize.ZERO || Vector.length<usize>(&rows) > usize.ZERO
}

effect fn argumentMentionsOwner(value: &Argument, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  match &value.* {
    Argument.Type {value: ty} => { run Type.collectOwned(&ty, owner, &mut types, &mut lifetimes, &mut rows) }
    Argument.Lifetime {value: region} => { run Type.collectOwnedLifetime(&region, owner, &mut lifetimes) }
    Argument.Row {value: row} => { run Type.collectOwnedRow(&row, owner, &mut types, &mut lifetimes, &mut rows) }
  }
  return Vector.length<usize>(&types) > usize.ZERO || Vector.length<usize>(&lifetimes) > usize.ZERO || Vector.length<usize>(&rows) > usize.ZERO
}

effect fn constraintMentionsOwner(value: &Constraint, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Constraint.Conforms {provider, contract} => (run typeMentionsOwner(&provider, owner)) || (run typeMentionsOwner(&contract, owner))
    Constraint.Represents {parameter, contract} => (run typeMentionsOwner(&parameter, owner)) || (run typeMentionsOwner(&contract, owner))
    Constraint.Contents {subject, region} => (run typeMentionsOwner(&subject, owner)) || (run argumentMentionsOwner(&Argument.Lifetime {value: Shared.clone<Lifetime>(&region)}, owner))
    Constraint.Outlives {longer, shorter} => (run argumentMentionsOwner(&Argument.Lifetime {value: Shared.clone<Lifetime>(&longer)}, owner)) || (run argumentMentionsOwner(&Argument.Lifetime {value: Shared.clone<Lifetime>(&shorter)}, owner))
    Constraint.Copyable {subject} => run typeMentionsOwner(&subject, owner)
    Constraint.Property {subject, ..} => run typeMentionsOwner(&subject, owner)
    Constraint.Provides {provider, selector, source} => (run typeMentionsOwner(&provider, owner)) || (run argumentMentionsOwner(&Argument.Row {value: Shared.clone<Row>(&selector)}, owner)) || (run argumentMentionsOwner(&Argument.Row {value: Shared.clone<Row>(&source)}, owner))
  }
}

fn signatureTypeParameterCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.typeParameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureNonLifetimeBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.typeParameters,
      ) + Vector.length<RowParameter>(&signature.rowParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureConstraintCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Constraint>(
        &signature.constraints,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

// Canonical signature evidence includes retained environments and bounds as well as result
// types. None of those fields may retain a private prefix or invocation inference owner.
effect fn signatureMentionsOwner(signature: &Signature, owner: &DeclarationId)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  if run typeMentionsOwner(&signature.result, owner) { return true }
  if run typeMentionsOwner(&signature.failure, owner) { return true }
  if run argumentMentionsOwner(&Argument.Row {value: Shared.clone<Row>(&signature.requirements)}, owner) { return true }
  let written = Vector.asSlice<Shared<Type>>(&signature.parameters)
  let mut at = usize.ZERO
  while at < written.length {
    if run typeMentionsOwner(&written[at], owner) { return true }
    at = at + usize.ONE
  }
  let bounds = Vector.asSlice<Constraint>(&signature.constraints)
  at = usize.ZERO
  while at < bounds.length {
    if run constraintMentionsOwner(&bounds[at], owner) { return true }
    at = at + usize.ONE
  }
  if let Option<Intersection>.Some {value: retained} = &signature.environment {
    let members = Vector.asSlice<LifetimeMember>(&retained.members)
    at = usize.ZERO
    while at < members.length {
      if run argumentMentionsOwner(&Argument.Lifetime {value: Shared.clone<Lifetime>(&members[at].region)}, owner) { return true }
      at = at + usize.ONE
    }
  }
  return false
}

// Whether a callee's binder at `ordinal` is one of its lifetime binders.
fn signatureLifetimeBinder(answer: &Result<Answer, NoRejection>, ordinal: usize) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let listed = Vector.asSlice<Shared<Lifetime>>(&signature.lifetimeParameters)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<Lifetime, bool>(&listed[at], fn(binder: &Lifetime) -> bool {
          return match &binder.* { Lifetime.Parameter {ordinal: declared, ..} => declared == ordinal _ => false }
        }) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Whether a callee's binder at `ordinal` is the lifetime its written Effect environment names.
fn signatureEnvironmentBinder(answer: &Result<Answer, NoRejection>, ordinal: usize) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => match &signature.environment {
        Option<Intersection>.Some {value: retained} => environmentNamesBinder(&retained, ordinal)
        Option<Intersection>.None => false
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn environmentNamesBinder(retained: &Intersection, ordinal: usize) -> bool {
  let members = Vector.asSlice<LifetimeMember>(&retained.members)
  let mut at = usize.ZERO
  while at < members.length {
    let named = Shared.with<Lifetime, bool>(&members[at].region, fn(value: &Lifetime) -> bool {
      if let Lifetime.Parameter {ordinal: written, ..} = &value.* { return written == ordinal }
      return false
    })
    if named { return true }
    at = at + usize.ONE
  }
  return false
}

// The region the first borrowed call argument retains; none when every argument is owned.
fn capturedRegion(nodes: &[BodyNode], arguments: &[BodyNodeId]) -> Option<Shared<Lifetime>> {
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Option<Shared<Type>>.Some {value: ty} = move bodyExpressionType(nodes, &arguments[at]) {
      let region = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, fn(value: &Type) -> Option<Shared<Lifetime>> {
        if let Type.Reference {lifetime, ..} = &value.* { return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime)) }
        return Option.none<Shared<Lifetime>>()
      })
      match move region {
        Option<Shared<Lifetime>>.Some {value} => { return Option.some<Shared<Lifetime>>(move value) }
        Option<Shared<Lifetime>>.None => ()
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Lifetime>>()
}

// A lifetime binder that only the call's outcome mentions, such as an impl lifetime only the
// result names, is chosen by the call's use rather than by an operand (LIFE-003). An ordinary
// call's expected result fixes it; otherwise the outcome retains no operand region through it, so
// it is 'static. A lifetime binder that nothing mentions relates no region, so it is 'static too;
// only type and row binders can stay uninferred.
effect fn bindUseLifetimes(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  callOwner: &Shared<DeclarationId>, binderCount: usize, expected: &Option<Shared<Type>>, effectTarget: bool,
  inferred: &mut Vector<Binding>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut types = Vector.make<usize>()
  let mut mentioned = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  let parameters = run signatureParameterTypes(inference)
  let listed = Vector.asSlice<Shared<Type>>(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    run Type.collectOwned(&listed[at], fresh, &mut types, &mut mentioned, &mut rows)
    at = at + usize.ONE
  }
  let mut outcomeTypes = Vector.make<usize>()
  let mut produced = Vector.make<usize>()
  let mut outcomeRows = Vector.make<usize>()
  let declared = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(inference, signatureResult)
  if let Option<Shared<Type>>.Some {value: written} = &declared {
    run Type.collectOwned(&written, fresh, &mut outcomeTypes, &mut produced, &mut outcomeRows)
  }
  let failure = run signatureFailure(inference)
  run Type.collectOwned(&failure, fresh, &mut outcomeTypes, &mut produced, &mut outcomeRows)
  let requirements = run signatureRequirements(inference)
  run Type.collectOwnedRow(&requirements, fresh, &mut outcomeTypes, &mut produced, &mut outcomeRows)
  let mut evidence = Vector.make<Binding>()
  if !effectTarget {
    if let Option<Shared<Type>>.Some {value: wanted} = &expected.* {
      if let Option<Shared<Type>>.Some {value: written} = &declared {
        let pattern = run Type.applyBindings(&written, Vector.asSlice<Binding>(&inferred.*), true)
        let mut variables = Vector.make<Shared<DeclarationId>>()
        run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(callOwner))
        drop run Type.unify(&pattern, &wanted, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut evidence)
      }
    }
  }
  at = usize.ZERO
  while at < binderCount {
    let open = match move bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), at) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => !containsOrdinal(&mentioned, at) && (containsOrdinal(&produced, at)
        || (Shared.with<Result<Answer, NoRejection>, bool>(inference,
          fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureLifetimeBinder(answer, at) })
          && !Shared.with<Result<Answer, NoRejection>, bool>(inference,
            fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureEnvironmentBinder(answer, at) })))
    }
    if open {
      let mut region = run Shared.make<Lifetime>(Lifetime.Static)
      if let Option<Argument>.Some {value: Argument.Lifetime {value: selected}} = move bindingArgumentAt(Vector.asSlice<Binding>(&evidence), at) {
        let mut owned = Vector.make<usize>()
        run Type.collectOwnedLifetime(&selected, fresh, &mut owned)
        if Vector.length<usize>(&owned) == usize.ZERO { region = Shared.clone<Lifetime>(&selected) }
      }
      run Vector.append<Binding>(&mut inferred.*, Binding {declaration: Shared.clone<DeclarationId>(callOwner), ordinal: at,
        value: Argument.Lifetime {value: move region}})
    }
    at = at + usize.ONE
  }
  return ()
}

// Result context may solve new region holes only. The whole comparison must succeed, and a
// transaction that also learns an unrelated original type, row or lifetime is not committed.
effect fn bindCallPrefixResult(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  originalCount: usize, totalCount: usize, expected: &Option<Shared<Type>>, effectTarget: bool,
  inferred: &mut Vector<Binding>) -> () ! OutOfMemoryError ? &mut Allocator {
  if originalCount == totalCount || effectTarget { return () }
  let wanted = match &expected.* {
    Option<Shared<Type>>.Some {value} => Shared.clone<Type>(&value)
    Option<Shared<Type>>.None => { return () }
  }
  let written = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(inference, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return () }
  }
  let pattern = run Type.applyBindings(&written, Vector.asSlice<Binding>(&inferred.*), true)
  let mut candidate = Vector.make<Binding>()
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)))
  let matched = run Type.unify(&pattern, &wanted, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut candidate)
  match move matched {
    Unification.Unified => ()
    Unification.Distinct => { return () }
    Unification.Undetermined {..} => { return () }
  }
  let learned = Vector.asSlice<Binding>(&candidate)
  let mut at = usize.ZERO
  while at < learned.length {
    if learned[at].ordinal < originalCount || learned[at].ordinal >= totalCount { return () }
    if !Shared.with<DeclarationId, bool>(&learned[at].declaration,
      fn(owner: &DeclarationId) -> bool { return DeclarationId.equals(owner, fresh) }) { return () }
    let selected = match &learned[at].value {
      Argument.Lifetime {value} => Shared.clone<Lifetime>(&value)
      _ => { return () }
    }
    if run argumentMentionsOwner(&learned[at].value, fresh) { return () }
    if let Option<Argument>.Some {value} = move bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), learned[at].ordinal) {
      if let Argument.Lifetime {value: previous} = move value {
        if !Lifetime.equalsShared(&previous, &selected) { return () }
      } else { return () }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < learned.length {
    if let Option<Argument>.None = move bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), learned[at].ordinal) {
      run Vector.append<Binding>(&mut inferred.*, Binding {declaration: Shared.clone<DeclarationId>(&learned[at].declaration),
        ordinal: learned[at].ordinal, value: copyArgument(&learned[at].value)})
    }
    at = at + usize.ONE
  }
  return ()
}

// A region the written prefix elides that no parameter mentions relates no operand region. As for
// an outcome-only binder (bindUseLifetimes), the outcome retains nothing through it, so it is
// 'static once neither the operands nor the result context chose it.
effect fn bindOutcomeCallPrefixRegions(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  originalCount: usize, totalCount: usize, inferred: &mut Vector<Binding>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut types = Vector.make<usize>()
  let mut mentioned = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  let parameters = run signatureParameterTypes(inference)
  let listed = Vector.asSlice<Shared<Type>>(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    let applied = run Type.applyBindings(&listed[at], Vector.asSlice<Binding>(&inferred.*), true)
    run Type.collectOwned(&applied, fresh, &mut types, &mut mentioned, &mut rows)
    at = at + usize.ONE
  }
  at = originalCount
  while at < totalCount {
    let open = match move bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), at) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => !containsOrdinal(&mentioned, at)
    }
    if open {
      run Vector.append<Binding>(&mut inferred.*, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)),
        ordinal: at, value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)}})
    }
    at = at + usize.ONE
  }
  return ()
}

// A section's pending parameters still receive the invocation's operands. A region its written
// prefix elides that they mention, and that only a 'static operand chose, is the region of the
// section's call site, as for a contextual call argument: the invoking operand must outlive it,
// while the 'static operand already does. A region another operand chose keeps that loan.
effect fn localizeSectionCallPrefixRegions(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  caller: &DeclarationId, expression: HirId, originalCount: usize, remaining: usize, inferred: &mut Vector<Binding>)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let mut originals = Vector.make<Binding>()
  let mut at = usize.ZERO
  let bound = Vector.asSlice<Binding>(&inferred.*)
  while at < bound.length {
    if bound[at].ordinal < originalCount {
      run Vector.append<Binding>(&mut originals, Binding {declaration: Shared.clone<DeclarationId>(&bound[at].declaration),
        ordinal: bound[at].ordinal, value: Argument.copy(&bound[at].value)})
    }
    at = at + usize.ONE
  }
  let mut types = Vector.make<usize>()
  let mut pending = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  at = usize.ZERO
  while at < remaining {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move parameter {
      let applied = run Type.applyBindings(&value, Vector.asSlice<Binding>(&originals), true)
      run Type.collectOwned(&applied, fresh, &mut types, &mut pending, &mut rows)
    }
    at = at + usize.ONE
  }
  let mut localized = Vector.make<Binding>()
  at = usize.ZERO
  while at < bound.length {
    let mut value = Argument.copy(&bound[at].value)
    if bound[at].ordinal >= originalCount && containsOrdinal(&pending, bound[at].ordinal) {
      if let Argument.Lifetime {value: region} = &bound[at].value {
        if Shared.with<Lifetime, bool>(&region, staticLifetime) {
          value = Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Local {
            declaration: run DeclarationId.copy(caller), ordinal: expression.index})}
        }
      }
    }
    run Vector.append<Binding>(&mut localized, Binding {declaration: Shared.clone<DeclarationId>(&bound[at].declaration),
      ordinal: bound[at].ordinal, value: move value})
    at = at + usize.ONE
  }
  inferred.* = move localized
  return ()
}

// A finite owner-local chain closes one inferred region. Cycles, absent evidence and a binding
// of another kind are unresolved; no distinguished region is supplied to make them disappear.
effect fn closedCallPrefixRegion(inferred: &[Binding], fresh: &DeclarationId, ordinal: usize,
  totalCount: usize) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut current = ordinal
  let mut seen = Vector.make<usize>()
  while current < totalCount {
    if containsOrdinal(&seen, current) { return Option.none<Shared<Lifetime>>() }
    run Vector.append<usize>(&mut seen, current)
    let region = match move bindingArgumentAt(inferred, current) {
      Option<Argument>.Some {value: Argument.Lifetime {value}} => move value
      _ => { return Option.none<Shared<Lifetime>>() }
    }
    let next = ownedLifetimeOrdinal(&region, fresh)
    if next == usize.MAX { return Option.some<Shared<Lifetime>>(move region) }
    current = next
  }
  return Option.none<Shared<Lifetime>>()
}

// Close every extra slot first, then rewrite only original argument values. The returned vector
// retains the original dense map for section selection; no extra coordinate can be published.
effect fn closeCallPrefixBindings(inferred: &[Binding], fresh: &DeclarationId,
  template: &Option<Shared<DeclarationId>>, originalCount: usize, totalCount: usize)
  -> Option<Vector<Binding>> ! OutOfMemoryError ? &mut Allocator {
  let owner = run Shared.make<DeclarationId>(run DeclarationId.copy(fresh))
  let mut regions = Vector.make<Binding>()
  let mut at = originalCount
  while at < totalCount {
    let value = match move run closedCallPrefixRegion(inferred, fresh, at, totalCount) {
      Option<Shared<Lifetime>>.Some {value} => move value
      _ => { return Option.none<Vector<Binding>>() }
    }
    let argument = Argument.Lifetime {value: move value}
    if let Option<Shared<DeclarationId>>.Some {value: pending} = &template.* {
      let declared = run DeclarationId.copyShared(&pending)
      if run argumentMentionsOwner(&argument, &declared) { return Option.none<Vector<Binding>>() }
    }
    run Vector.append<Binding>(&mut regions, Binding {declaration: Shared.clone<DeclarationId>(&owner),
      ordinal: at, value: move argument})
    at = at + usize.ONE
  }
  let mut closed = Vector.make<Binding>()
  at = usize.ZERO
  while at < originalCount {
    if let Option<Argument>.Some {value} = move bindingArgumentAt(inferred, at) {
      let argument = run Argument.applyBindings(&value, Vector.asSlice<Binding>(&regions), true)
      if let Option<Shared<DeclarationId>>.Some {value: pending} = &template.* {
        let declared = run DeclarationId.copyShared(&pending)
        if run argumentMentionsOwner(&argument, &declared) { return Option.none<Vector<Binding>>() }
      }
      // An original binder may still be deferred; extra holes may not occur in that evidence.
      let mut types = Vector.make<usize>()
      let mut lifetimes = Vector.make<usize>()
      let mut rows = Vector.make<usize>()
      match &argument {
        Argument.Type {value: boundType} => { run Type.collectOwned(&boundType, fresh, &mut types, &mut lifetimes, &mut rows) }
        Argument.Lifetime {value: boundRegion} => { run Type.collectOwnedLifetime(&boundRegion, fresh, &mut lifetimes) }
        Argument.Row {value: boundRow} => { run Type.collectOwnedRow(&boundRow, fresh, &mut types, &mut lifetimes, &mut rows) }
      }
      let used = Vector.asSlice<usize>(&lifetimes)
      let mut usedAt = usize.ZERO
      while usedAt < used.length {
        if used[usedAt] >= originalCount { return Option.none<Vector<Binding>>() }
        usedAt = usedAt + usize.ONE
      }
      run Vector.append<Binding>(&mut closed, Binding {declaration: Shared.clone<DeclarationId>(&owner), ordinal: at, value: move argument})
    }
    at = at + usize.ONE
  }
  return Option.some<Vector<Binding>>(move closed)
}

fn bindingArgumentAt(bindings: &[Binding], ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal {
      return match & bindings[at].value {
        Argument.Type {value} => Option.some<Argument>(
          Argument.Type {value: Shared.clone<Type>(&value)},
        )
        Argument.Lifetime {value} => Option.some<Argument>(
          Argument.Lifetime {value: Shared.clone<Lifetime>(&value)},
        )
        Argument.Row {value} => Option.some<Argument>(
          Argument.Row {value: Shared.clone<Row>(&value)},
        )
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

fn signatureParameter(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        if at < parameters.length {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[at]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn signatureConstraint(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let constraints = Vector.asSlice<Constraint>(&signature.constraints)
        if at < constraints.length {
          return Option.some<Constraint>(copyConstraint(&constraints[at]))
        }
        return Option.none<Constraint>()
      }
      _ => Option.none<Constraint>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Constraint>()
  }
}

fn contractProvider(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => match & contract.provider {
        Option<Shared<Type>>.Some {value: provider} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&provider),
        )
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

effect fn inferenceArgumentOpen(argument: &Argument) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match & argument.* {
    Argument.Type {value} => Type.hasOpenParameters(&value)
    Argument.Lifetime {value} => Lifetime.anyAtom(
      &value,
      fn(region: &Lifetime) -> bool {
        return match & region.* {
          Lifetime.Parameter {..} => true
          _ => false
        }
      },
    )
    Argument.Row {value} => {
      let carrier = run rowCarrier(&value)
      return Type.hasOpenParameters(&carrier)
    }
  }
}

// A caller's written bound is itself direct evidence even when its provider is an abstract type
// parameter. It cannot choose a concrete conformance for an unknown provider.
effect fn inferFromDeclaredBound(
  resolver: &Resolver,
  module: &ModuleId,
  provider: &Shared<Type>,
  contract: &Shared<Type>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut Vector<Binding>,
  span: Span,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = Option.none<Vector<Binding>>()
  let mut undecided = false
  let mut boundAt = usize.ZERO
  while boundAt < declared.length {
    if let Constraint.Conforms {provider: assumedProvider, contract: assumedContract} = &declared[boundAt] {
      let mut left = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(provider))
      run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(contract))
      let mut right = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&assumedProvider))
      run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&assumedContract))
      let mut variables = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(
        &mut variables,
        Shared.clone<DeclarationId>(callOwner),
      )
      let mut trial = Vector.make<Binding>()
      let fixed = Vector.asSlice<Binding>(&inferred.*)
      let mut fixedAt = usize.ZERO
      while fixedAt < fixed.length {
        run Vector.append<Binding>(
          &mut trial,
          Binding {
            declaration: Shared.clone<DeclarationId>(&fixed[fixedAt].declaration),
            ordinal: fixed[fixedAt].ordinal,
            value: copyArgument(&fixed[fixedAt].value),
          },
        )
        fixedAt = fixedAt + usize.ONE
      }
      let matched = run Type.unifyAll(
        Vector.asSlice<Shared<Type>>(&left),
        Vector.asSlice<Shared<Type>>(&right),
        Vector.asSlice<Shared<DeclarationId>>(&variables),
        Comparison.Exact,
        &mut trial,
      )
      match move matched {
        Unification.Unified => {
          if let Option<Vector<Binding>>.Some {..} = &selected {
            return Option.some<Shared<Rejection>>(
              run reject(resolver, module, RejectionCode.UninferredParameter, span),
            )
          }
          selected = Option.some<Vector<Binding>>(move trial)
        }
        Unification.Undetermined {at: unresolved} => {
          drop unresolved
          undecided = true
        }
        Unification.Distinct => ()
      }
    }
    boundAt = boundAt + usize.ONE
  }
  if undecided {
    return Option.some<Shared<Rejection>>(
      run reject(resolver, module, RejectionCode.Unsupported, span),
    )
  }
  if let Option<Vector<Binding>>.Some {value: evidence} = move selected {
    let entries = Vector.asSlice<Binding>(&evidence)
    let mut at = usize.ZERO
    while at < entries.length {
      if sameDeclarationShared(&entries[at].declaration, callOwner) {
        let prior = bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), entries[at].ordinal)
        if let Option<Argument>.None = move prior {
          run Vector.append<Binding>(
            &mut inferred.*,
            Binding {
              declaration: Shared.clone<DeclarationId>(callOwner),
              ordinal: entries[at].ordinal,
              value: copyArgument(&entries[at].value),
            },
          )
        }
      }
      at = at + usize.ONE
    }
  }
  return Option.none<Shared<Rejection>>()
}

// The ordinal of the call owner's type parameter that `value` names, or `usize.MAX` otherwise.
fn ownerParameterOrdinal(value: &Type, callOwner: &Shared<DeclarationId>) -> usize {
  return match & value.* {
    Type.Parameter {declaration, ordinal} => {
      if declarationEqualsShared(&declaration, callOwner) {
        return ordinal
      }
      return usize.MAX
    }
    _ => usize.MAX
  }
}

// The type argument already inferred for the parameter at `ordinal`, if any.
fn fixedTypeArgument(inferred: &[Binding], ordinal: usize) -> Option<Shared<Type>> {
  let fixed = bindingArgumentAt(inferred, ordinal)
  if let Option<Argument>.Some {value: argument} = move fixed {
    if let Argument.Type {value} = move argument {
      return Option.some<Shared<Type>>(move value)
    }
  }
  return Option.none<Shared<Type>>()
}

// Adopts one binding of the selected evidence for the call owner unless it is already inferred.
effect fn adoptEvidenceEntry(
  resolver: &Resolver,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  inferred: &mut Vector<Binding>,
  entry: &Binding,
  span: Span,
) -> Option<Shared<Rejection>>
! OutOfMemoryError
? &mut Allocator {
  if !sameDeclarationShared(&entry.declaration, callOwner) {
    return Option.none<Shared<Rejection>>()
  }
  let prior = bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), entry.ordinal)
  if let Option<Argument>.None = move prior {
    if run inferenceArgumentOpen(&entry.value) {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    run Vector.append<Binding>(
      &mut inferred.*,
      Binding {
        declaration: Shared.clone<DeclarationId>(callOwner),
        ordinal: entry.ordinal,
        value: copyArgument(&entry.value),
      },
    )
  }
  return Option.none<Shared<Rejection>>()
}

// Adopts the call owner's bindings from the evidence of the uniquely selected head.
effect fn adoptEvidence(
  resolver: &Resolver,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  inferred: &mut Vector<Binding>,
  evidence: Vector<Binding>,
  span: Span,
) -> Option<Shared<Rejection>>
! OutOfMemoryError
? &mut Allocator {
  let entries = Vector.asSlice<Binding>(&evidence)
  let mut evidenceAt = usize.ZERO
  while evidenceAt < entries.length {
    let failed = run adoptEvidenceEntry(
      &resolver.*, module, callOwner, &mut inferred.*, &entries[evidenceAt], span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option.some<Shared<Rejection>>(move value)
    }
    evidenceAt = evidenceAt + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

// Unifies the candidate head at `candidateAt` with the known provider and open contract. A unique
// unifying head is recorded in `selected`; an undetermined head makes the whole selection undecided.
effect fn unifyHeadCandidate(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  fixed: &[Binding],
  knownProvider: &Shared<Type>,
  contract: &Shared<Type>,
  bucket: &Shared<Result<Answer, NoRejection>>,
  candidateAt: usize,
  selected: &mut Option<Vector<Binding>>,
  undecided: &mut bool,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let candidate = Shared.with<
    Result<Answer, NoRejection>,
    Option<Shared<ImplementationHead>>,
  >(
    bucket,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return bucketAt(answer, candidateAt)
    },
  )
  let head = match move candidate {
    Option<Shared<ImplementationHead>>.Some {value} => value
    Option<Shared<ImplementationHead>>.None => {
      return Option.none<Shared<Rejection>>()
    }
  }
  let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(&head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => value
    Option<HeadTerms>.None => {
      return Option.none<Shared<Rejection>>()
    }
  }
  let headModule = Shared.with<DeclarationId, usize>(
    &found.declaration,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if headModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let headSource = run resolvedModule(&resolver.*, headModule)
  let headOrdinal = run ordinalOfIdentity(
    &mut resolver.*,
    &headSource,
    &found.declaration,
  )
  let headPosition = match move headOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.UnknownMember, span),
      )
    }
  }
  let coherence = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Coherence,
      module: headModule,
      name: usize.ZERO,
      declaration: headPosition,
      member: usize.ZERO,
      external: false,
    },
    span,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &coherence,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Option.some<Shared<Rejection>>(move value)
  }
  let mut left = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(&found.provider))
  run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(contract))
  let mut right = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(knownProvider))
  run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&found.contract))
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, move found.declaration)
  run Vector.append<Shared<DeclarationId>>(
    &mut variables,
    Shared.clone<DeclarationId>(callOwner),
  )
  let mut trial = Vector.make<Binding>()
  let mut fixedAt = usize.ZERO
  while fixedAt < fixed.length {
    run Vector.append<Binding>(
      &mut trial,
      Binding {
        declaration: Shared.clone<DeclarationId>(&fixed[fixedAt].declaration),
        ordinal: fixed[fixedAt].ordinal,
        value: copyArgument(&fixed[fixedAt].value),
      },
    )
    fixedAt = fixedAt + usize.ONE
  }
  let matched = run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&left),
    Vector.asSlice<Shared<Type>>(&right),
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut trial,
  )
  match move matched {
    Unification.Unified => {
      if let Option<Vector<Binding>>.Some {..} = &selected.* {
        return Option.some<Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.UninferredParameter, span),
        )
      }
      selected.* = Option.some<Vector<Binding>>(move trial)
    }
    Unification.Undetermined {at: unresolved} => {
      drop unresolved
      undecided.* = true
    }
    Unification.Distinct => ()
  }
  return Option.none<Shared<Rejection>>()
}

// A closed provider selects the contract's implementation head by unification. Exactly one coherent
// head may unify, and its evidence supplies the call owner's still-open parameters.
effect fn inferFromKnownProvider(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  inferred: &mut Vector<Binding>,
  knownProvider: &Shared<Type>,
  contract: &Shared<Type>,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let contractModule = declaringModuleOrdinal(&resolver.*, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let contractSource = run resolvedModule(&resolver.*, contractModule)
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractSource, contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let inferenceOwner = run DeclarationId.copyShared(callOwner)
  if run typeMentionsOwner(knownProvider, &inferenceOwner) {
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UninferredParameter, span))
  }
  let providerApplication = run internApplication(&mut resolver.*, knownProvider)
  let bucket = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.ConformanceHeads,
      module: contractModule,
      name: providerApplication,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    },
    span,
  )
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bucket,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Option.some<Shared<Rejection>>(move value)
  }
  let candidates = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
  let mut selected = Option.none<Vector<Binding>>()
  let mut undecided = false
  let mut candidateAt = usize.ZERO
  while candidateAt < candidates {
    let failed = run unifyHeadCandidate(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      callOwner,
      Vector.asSlice<Binding>(&inferred.*),
      knownProvider,
      contract,
      &bucket,
      candidateAt,
      &mut selected,
      &mut undecided,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option.some<Shared<Rejection>>(move value)
    }
    candidateAt = candidateAt + usize.ONE
  }
  if undecided {
    return Option.some<Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    )
  }
  if let Option<Vector<Binding>>.Some {value: evidence} = move selected {
    return run adoptEvidence(&resolver.*, module, callOwner, &mut inferred.*, move evidence, span)
  }
  return Option.none<Shared<Rejection>>()
}

// Infers from one direct `provider: contract` bound, first against the declared bounds when both
// sides are open and then through the implementation heads once the provider is known.
effect fn inferFromConformance(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut Vector<Binding>,
  provider: &Shared<Type>,
  contract: &Shared<Type>,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let providerOrdinal = Shared.with<Type, usize>(
    provider,
    fn(value: &Type) -> usize {
      return ownerParameterOrdinal(value, callOwner)
    },
  )
  let mut knownProvider = Shared.clone<Type>(provider)
  if providerOrdinal != usize.MAX {
    let fixed = fixedTypeArgument(Vector.asSlice<Binding>(&inferred.*), providerOrdinal)
    if let Option<Shared<Type>>.Some {value} = move fixed {
      knownProvider = move value
    }
  }
  // Lifetimes never select an implementation head: a nominal provider whose only open arguments
  // are regions is known, and head unification binds the impl's own lifetimes to them.
  if Type.hasOpenRuntimeParameters(&knownProvider) && Type.hasOpenParameters(contract) {
    let failed = run inferFromDeclaredBound(
      &resolver.*,
      module,
      provider,
      contract,
      callOwner,
      declared,
      &mut inferred.*,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option.some<Shared<Rejection>>(move value)
    }
  }
  if !Type.hasOpenRuntimeParameters(&knownProvider) && Type.hasOpenParameters(contract) {
    return run inferFromKnownProvider(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      callOwner,
      &mut inferred.*,
      &knownProvider,
      contract,
      span,
    )
  }
  return Option.none<Shared<Rejection>>()
}

// Infers from the signature's bound at `boundAt` when it is a direct conformance.
effect fn inferFromBoundAt(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  signature: &Shared<Result<Answer, NoRejection>>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut Vector<Binding>,
  boundAt: usize,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
    signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
      return signatureConstraint(answer, boundAt)
    },
  )
  let direct = match move bound {
    Option<Constraint>.Some {value} => value
    Option<Constraint>.None => {
      return Option.none<Shared<Rejection>>()
    }
  }
  match move direct {
    Constraint.Represents {parameter, contract} => {
      let fresh = run DeclarationId.copyShared(callOwner)
      return run inferCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &fresh, declared,
        &mut inferred.*, &parameter, &contract, span)
    }
    Constraint.Conforms {provider, contract} => { return run inferFromConformance(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      callOwner,
      declared,
      &mut inferred.*,
      &provider,
      &contract,
      span,
    ) }
    _ => ()
  }
  return Option.none<Shared<Rejection>>()
}

// Each bound may contribute arguments from its own uniquely selected, coherent direct
// conformance. Match the provider first: this fixes an impl's own parameters before its
// interface arguments are compared with the call's still-open parameters.
effect fn inferFromProviderBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  signature: &Shared<Result<Answer, NoRejection>>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut Vector<Binding>,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  let mut boundAt = usize.ZERO
  while boundAt < count {
    let failed = run inferFromBoundAt(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      signature,
      callOwner,
      declared,
      &mut inferred.*,
      boundAt,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option.some<Shared<Rejection>>(move value)
    }
    boundAt = boundAt + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

fn foreignTypeGap(ty: &Type) -> Option<RejectionCode> {
  if let Type.Callable {..} = &ty.* { return Option.some<RejectionCode>(RejectionCode.ForeignCallback) }
  if CAbi.admit(ty) { return Option.none<RejectionCode>() }
  if let Type.Primitive {..} = &ty.* { return Option.some<RejectionCode>(RejectionCode.ForeignType) }
  return Option.some<RejectionCode>(RejectionCode.ForeignAggregate)
}

fn foreignSignatureGap(answer: &Result<Answer, NoRejection>) -> Option<RejectionCode> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let result = Shared.with<Type, Option<RejectionCode>>(&signature.result, foreignTypeGap)
      if let Option<RejectionCode>.Some {value: reason} = move result { return Option.some<RejectionCode>(reason) }
      let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
      let mut at = usize.ZERO
      while at < parameters.length {
        let gap = Shared.with<Type, Option<RejectionCode>>(&parameters[at], foreignTypeGap)
        if let Option<RejectionCode>.Some {value: reason} = move gap { return Option.some<RejectionCode>(reason) }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<RejectionCode>()
}

// Effect construction remains outside runtime body lowering; unsafe is checked lexically.
fn signatureUnsafe(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => signature.isUnsafe
      _ => false
    }
    _ => false
  }
}

// Runtime representation admission is independent of the unfinished borrow-safety stage.
fn runtimeType(value: &Type) -> bool {
  return match & value.* {
    Type.Array {..} => true
    Type.Anonymous {..} => true
    Type.CallableValue {..} => true
    Type.CallableSchema {..} => true
    // Semantic storage remains exact and opaque until the runtime projection query proves
    // its finite environment.
    Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, bool>(&contract, callableType) || Shared.with<Type, bool>(&contract, bareEffect)
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableResult {..} => true
    // A staged source recipe is admitted here; its original environment must still be
    // realized by the runtime projection query before MIR can use its storage.
    Type.CallableStage {..} => true
    Type.CallableView {..} => true
    // Ordinary callable contracts need their original returned environment before lowering.
    Type.Callable {..} => true
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    Type.Slice {..} => true
    Type.String {..} => true
    Type.Reference {..} => true
    Type.Pointer {..} => true
    Type.Nominal {..} => true
    Type.Primitive {name} => scalarType(value) || pointerSizedIntegerType(value) || same(Bytes.asSlice(&name), b"f32") || same(Bytes.asSlice(&name), b"f64")
      || same(Bytes.asSlice(&name), b"char")
    // Closed structural unions have a Tagged layout and lowered injection and matching.
    Type.Union {..} => sourceUnion(value)
    _ => scalarType(value)
  }
}

// An Effect contract with no producer body to realize its storage, such as an interface
// operation's declared `Effect<...>` result.
fn effectStorageType(value: &Type) -> bool {
  return match &value.* {
    Type.Effect {..} => true
    Type.Union {members} => {
      let listed = Vector.asSlice<Shared<Type>>(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<Type, bool>(&listed[at], effectStorageType) { return true }
        at = at + usize.ONE
      }
      return false
    }
    _ => false
  }
}

fn mutableSlice(value: &Type) -> bool {
  return match &value.* { Type.Slice {access, ..} => access == Access.Mutable _ => false }
}

fn mutablePlace(nodes: &[BodyNode], locals: &[BodyLocal], id: BodyNodeId) -> bool {
  return match & nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => locals[local.index].mutable
    // Only a `match &mut` binding is an exclusive place; copied, moved and shared bindings are not.
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {access, ..}, ..} => access == BodyBindingAccess.Exclusive
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => mutablePlace(nodes, locals, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => {
      if let BodyNodeKind.Expression {ty, ..} = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&ty) {
          return Shared.with<Type, bool>(&ty, mutableSlice)
        }
      }
      return mutablePlace(nodes, locals, value)
    }
    BodyNodeKind.Expression {form: BodyExpression.Dereference {value}, ..} => match & nodes[value.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.with<Type, bool>(
        &ty,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Reference {access, ..} => access == Access.Mutable
            Type.Pointer {access, ..} => access == Access.Mutable
            _ => false
          }
        },
      )
      _ => false
    }
    _ => false
  }
}

fn checkedPlace(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match & nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => checkedPlace(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => checkedPlace(nodes, value)
    // A pattern binding names a place projected from its matched subject or that subject's copy.
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {..}, ..} => true
    _ => false
  }
}

// What a consuming site transfers out of its operand: a static owned place, an owned rvalue, a
// complete referent behind a reference, or a projection whose extraction would leave a hole behind
// a reference, at a runtime index or in an owned rvalue (OWN-004). A binding of a borrowing match
// cannot leave its arm, and moving out of a `match place` binding is not lowered yet.
union Consumption {
  Rvalue,
  // `ancestors` are the types of the owners a non-empty path passes through.
  Place {place: BodyConsumedPlace, ancestors: Vector<Shared<Type>>},
  Borrowed,
  Boundary,
  // `binding` is the type of the borrowing match binding the place is rooted at; `ancestors` are
  // the types of the owners its path passes through.
  Escape {binding: Shared<Type>, ancestors: Vector<Shared<Type>>},
  PlaceBinding,
}

// The owned place a `move`, `drop`, consuming match or by-value receiver transfers out of.
effect fn consumption(source: &SourceIndex, cursor: &AuthoredCursor, nodes: &[BodyNode], id: BodyNodeId) -> Consumption
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => Consumption.Place {
      place: BodyConsumedPlace {root: BodyPlaceRoot.Local {local: local}, steps: Vector.make<BodyPlaceStep>()},
      ancestors: Vector.make<Shared<Type>>(),
    }
    BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {subject, path, access}} => match access {
      // A consuming match's binding owns its part of the evaluated subject (MATCH-002); a bare
      // match's binding is a place of the copied subject.
      BodyBindingAccess.Moved => Consumption.Place {
        place: BodyConsumedPlace {root: BodyPlaceRoot.Subject {subject: subject}, steps: run copySteps(&path)},
        ancestors: Vector.make<Shared<Type>>(),
      }
      BodyBindingAccess.Copied => Consumption.Place {
        place: BodyConsumedPlace {root: BodyPlaceRoot.Subject {subject: subject}, steps: run copySteps(&path)},
        ancestors: Vector.make<Shared<Type>>(),
      }
      BodyBindingAccess.Place => Consumption.PlaceBinding
      BodyBindingAccess.Shared => Consumption.Escape {binding: Shared.clone<Type>(&ty), ancestors: Vector.make<Shared<Type>>()}
      BodyBindingAccess.Exclusive => Consumption.Escape {binding: Shared.clone<Type>(&ty), ancestors: Vector.make<Shared<Type>>()}
    }
    BodyNodeKind.Expression {form: BodyExpression.Field {value, index}, ..} => run extendedConsumption(
      run consumption(source, cursor, nodes, value), BodyPlaceStep.Field {index: index}, bodyExpressionType(nodes, &value),
    )
    BodyNodeKind.Expression {form: BodyExpression.Index {value, index}, ..} => run indexedConsumption(source, cursor, nodes, value, index)
    BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => Consumption.Borrowed
    _ => Consumption.Rvalue
  }
}

// An element leaves a hole only in a fixed array at a literal in-bounds index; a slice element is
// reached through a reference.
effect fn indexedConsumption(source: &SourceIndex, cursor: &AuthoredCursor, nodes: &[BodyNode], subject: BodyNodeId,
  index: BodyNodeId) -> Consumption ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // A slice element is behind the slice's reference whatever the slice came from.
  let subjectType = bodyExpressionType(nodes, &subject)
  let sliced = match &subjectType {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, sliceType)
    Option<Shared<Type>>.None => false
  }
  if sliced { return Consumption.Borrowed }
  let base = run consumption(source, cursor, nodes, subject)
  let place = match &base {
    Consumption.Place {..} => true
    _ => false
  }
  if !place { return run extendedConsumption(move base, BodyPlaceStep.Element {index: usize.ZERO}, Option.none<Shared<Type>>()) }
  let fixed = match move subjectType {
    Option<Shared<Type>>.Some {value} => match move Type.arrayShape(&value) {
      Option<ArrayShape>.Some {..} => true
      Option<ArrayShape>.None => false
    }
    Option<Shared<Type>>.None => false
  }
  if !fixed { return Consumption.Boundary }
  let mut element = Option.none<usize>()
  if let BodyNodeKind.Expression {form: BodyExpression.Integer {literal}, ..} = &nodes[index.index].kind {
    if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(source, cursor, literal) {
      let digits = run bodyText(source, cursor, magnitude)
      if sign == Sign.Positive { element = Type.extentValue(Bytes.asSlice(&digits)) }
    }
  }
  return match move element {
    Option<usize>.Some {value: at} => run extendedConsumption(move base, BodyPlaceStep.Element {index: at}, bodyExpressionType(nodes, &subject))
    Option<usize>.None => Consumption.Boundary
  }
}

effect fn extendedConsumption(base: Consumption, step: BodyPlaceStep, parent: Option<Shared<Type>>) -> Consumption ! OutOfMemoryError ? &mut Allocator {
  return match move base {
    Consumption.Place {place, ancestors} => {
      let mut owners = move ancestors
      if let Option<Shared<Type>>.Some {value} = move parent { run Vector.append<Shared<Type>>(&mut owners, move value) }
      return Consumption.Place {
        place: BodyConsumedPlace {root: move place.root, steps: run extendedPath(&place.steps, move step)}, ancestors: move owners,
      }
    }
    // A projection out of an owned rvalue would leave its remainder without an owner.
    Consumption.Rvalue => Consumption.Boundary
    Consumption.Borrowed => Consumption.Boundary
    Consumption.Boundary => Consumption.Boundary
    Consumption.Escape {binding, ancestors} => {
      let mut owners = move ancestors
      if let Option<Shared<Type>>.Some {value} = move parent { run Vector.append<Shared<Type>>(&mut owners, move value) }
      return Consumption.Escape {binding: move binding, ancestors: move owners}
    }
    Consumption.PlaceBinding => Consumption.PlaceBinding
  }
}

fn sliceType(value: &Type) -> bool {
  return match &value.* {
    Type.Slice {..} => true
    _ => false
  }
}

// Whether any owner type a consumed path passes through has a `Drop` hook.
effect fn hookedAncestor(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  ancestors: &[Shared<Type>], constraints: &[Constraint]) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < ancestors.length {
    match move run dropImplementation(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ancestors[at], constraints) {
      Result<Option<SealedMatch>, Shared<Rejection>>.Success {value: hook} => {
        if let Option<SealedMatch>.Some {..} = &hook { return Result.succeed<bool, Shared<Rejection>>(true) }
      }
      Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => { return Result.failResult<bool, Shared<Rejection>>(move error) }
    }
    at = at + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(false)
}

// The consumed place a site records, or the rejection for a place that cannot be extracted. A
// `drop` of a Copy value behind a reference ends no owner, so it records no place (DROP-001). A
// partial move cannot leave a hole beneath an owner with a `Drop` hook (OWN-004), whatever the
// moved value's type; that is reported at `hookSpan`. `copyBinding` marks a `drop`, which a
// borrowing match binding exempts only when the binding itself is Copy; a consuming match of a
// Copy part of that binding copies it out, still checked against the binding's Drop hooks.
effect fn consumedPlace(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, nodes: &[BodyNode],
  operand: BodyNodeId, copyExempt: bool, copyBinding: bool, span: Span, hookSpan: Span, constraints: &[Constraint]) -> Result<Option<BodyConsumedPlace>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut code = RejectionCode.ExtractionBoundary
  let mut exempt = copyExempt
  match move run consumption(&resolver.source, cursor, nodes, operand) {
    Consumption.Place {place, ancestors} => {
      match move run hookedAncestor(&mut resolver.*, &mut owner.*, &mut dependencies.*, Vector.asSlice<Shared<Type>>(&ancestors), constraints) {
        Result<bool, Shared<Rejection>>.Success {value: hooked} => {
          if hooked {
            return Result.failResult<Option<BodyConsumedPlace>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ExtractionBoundary, hookSpan))
          }
        }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<BodyConsumedPlace>, Shared<Rejection>>(move error) }
      }
      return Result.succeed<Option<BodyConsumedPlace>, Shared<Rejection>>(Option.some<BodyConsumedPlace>(move place))
    }
    Consumption.Rvalue => { return Result.succeed<Option<BodyConsumedPlace>, Shared<Rejection>>(Option.none<BodyConsumedPlace>()) }
    Consumption.Borrowed => { code = RejectionCode.BorrowedExtraction }
    Consumption.Boundary => {}
    Consumption.Escape {binding, ancestors} => {
      code = RejectionCode.MatchBorrowEscape
      if exempt && copyBinding {
        exempt = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &binding, constraints, span) {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<BodyConsumedPlace>, Shared<Rejection>>(move error) }
        }
      } else if exempt {
        match move run hookedAncestor(&mut resolver.*, &mut owner.*, &mut dependencies.*, Vector.asSlice<Shared<Type>>(&ancestors), constraints) {
          Result<bool, Shared<Rejection>>.Success {value: hooked} => {
            if hooked {
              return Result.failResult<Option<BodyConsumedPlace>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ExtractionBoundary, hookSpan))
            }
          }
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<BodyConsumedPlace>, Shared<Rejection>>(move error) }
        }
      }
    }
    Consumption.PlaceBinding => { code = RejectionCode.Unsupported }
  }
  if exempt { return Result.succeed<Option<BodyConsumedPlace>, Shared<Rejection>>(Option.none<BodyConsumedPlace>()) }
  return Result.failResult<Option<BodyConsumedPlace>, Shared<Rejection>>(run reject(&resolver.*, module, code, span))
}

fn signatureIsEffect(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => signature.isEffect
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn answerRejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      _ => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn fixedIntegerName(name: &[u8]) -> bool {
  return same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(name, b"i64") || same(
    name,
    b"u8",
  ) || same(name, b"u16") || same(name, b"u32") || same(name, b"u64")
}

fn pointerSizedIntegerName(name: &[u8]) -> bool {
  return same(name, b"isize") || same(name, b"usize")
}

fn scalarType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Unit => true
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"bool") || fixedIntegerName(
      Bytes.asSlice(&name),
    )
    _ => false
  }
}

fn fixedIntegerType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Primitive {name} => fixedIntegerName(Bytes.asSlice(&name))
    _ => false
  }
}

fn pointerSizedIntegerType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Primitive {name} => pointerSizedIntegerName(Bytes.asSlice(&name))
    _ => false
  }
}

fn neverType(typeValue: &Type) -> bool {
  return Type.isNever(typeValue)
}

fn scalarCode(typeValue: &Type) -> usize {
  return match & typeValue.* {
    Type.Unit => 1
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      if same(spelling, b"bool") {
        return 2
      }
      if same(spelling, b"i8") {
        return 3
      }
      if same(spelling, b"i16") {
        return 4
      }
      if same(spelling, b"i32") {
        return 5
      }
      if same(spelling, b"i64") {
        return 6
      }
      if same(spelling, b"u8") {
        return 7
      }
      if same(spelling, b"u16") {
        return 8
      }
      if same(spelling, b"u32") {
        return 9
      }
      if same(spelling, b"u64") {
        return 10
      }
      return usize.ZERO
    }
    _ => usize.ZERO
  }
}

// An enum participates in the closed equality contract only when the canonical nominal type
// resolves to a scalar enum declaration. A struct with the same representation has no privilege.
effect fn operatorFamily(resolver: &mut Resolver, ty: &Shared<Type>) -> Operator.Family
! Cycle | OutOfMemoryError
? &mut Allocator {
  let declaring = declaringModuleOrdinal(&resolver.*, ty)
  let mut isScalarEnum = false
  if declaring != usize.MAX {
    let module = run resolvedModule(&resolver.*, declaring)
    let ordinal = run ordinalOfProvider(&mut resolver.*, &module, ty)
    if let Option<usize>.Some {value} = move ordinal {
      let written = run header(&mut resolver.*, &module, value)
      if let Option<HeaderSyntax>.Some {value: syntax} = move written {
        if let Node.EnumHeader {..} = syntax.header {
          isScalarEnum = true
        }
      }
    }
  }
  return Shared.with<Type, Operator.Family>(
    ty,
    fn(value: &Type) -> Operator.Family {
      return Operator.family(value, isScalarEnum)
    },
  )
}

fn fitsMagnitude(magnitude: &[u8], maximum: &[u8]) -> bool {
  if magnitude.length != maximum.length {
    return magnitude.length < maximum.length
  }
  let mut at = usize.ZERO
  while at < magnitude.length {
    if magnitude[at] != maximum[at] {
      return magnitude[at] < maximum[at]
    }
    at = at + usize.ONE
  }
  return true
}

fn fitsInteger(target: &MachineTarget, name: &[u8], sign: Sign, magnitude: &[u8]) -> bool {
  if sign == Sign.Negative && magnitude.length == 1 && magnitude[0] == 48 {
    return true
  }
  if same(name, b"isize") {
    return MachineTarget.fitsIsize(target, sign == Sign.Negative, magnitude)
  }
  if same(name, b"usize") {
    return sign != Sign.Negative && MachineTarget.fitsUsize(target, magnitude)
  }
  if same(name, b"i8") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"128")
    }
    return fitsMagnitude(magnitude, b"127")
  }
  if same(name, b"i16") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"32768")
    }
    return fitsMagnitude(magnitude, b"32767")
  }
  if same(name, b"i32") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"2147483648")
    }
    return fitsMagnitude(magnitude, b"2147483647")
  }
  if same(name, b"i64") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"9223372036854775808")
    }
    return fitsMagnitude(magnitude, b"9223372036854775807")
  }
  if sign == Sign.Negative {
    return false
  }
  if same(name, b"u8") {
    return fitsMagnitude(magnitude, b"255")
  }
  if same(name, b"u16") {
    return fitsMagnitude(magnitude, b"65535")
  }
  if same(name, b"u32") {
    return fitsMagnitude(magnitude, b"4294967295")
  }
  if same(name, b"u64") {
    return fitsMagnitude(magnitude, b"18446744073709551615")
  }
  return false
}

effect fn primitiveType(name: &[u8]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)})
}

// Character HIR already retains its decoded scalar. Canonical digits reuse integer admission
// without interpreting the authored UTF-8 or escape spelling again.
effect fn characterDigits(scalar: u32) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut digits = Vector.make<u8>()
  let mut remaining = u32.toU64(scalar)
  while remaining > 0 {
    run Vector.insert<u8>(&mut digits, usize.ZERO, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
  }
  if Vector.length<u8>(&digits) == usize.ZERO { run Vector.append<u8>(&mut digits, 48) }
  return run Bytes.copy(Vector.asSlice<u8>(&digits))
}

effect fn intrinsicValueType(kind: IntrinsicValueKind) -> Shared<Type>
! OutOfMemoryError
? &mut Allocator {
  return match kind {
    IntrinsicValueKind.Scalar {scalar} => run primitiveType(ScalarOperation.scalarSpelling(scalar))
    IntrinsicValueKind.Borrowed {scalar} => run Shared.make<Type>(Type.Reference {
      access: Access.Shared,
      lifetime: run Shared.make<Lifetime>(Lifetime.Static),
      referent: run primitiveType(ScalarOperation.scalarSpelling(scalar)),
    })
    IntrinsicValueKind.Text => run Shared.make<Type>(
      Type.String {lifetime: run Shared.make<Lifetime>(Lifetime.Static)},
    )
    IntrinsicValueKind.StaticText => run Shared.make<Type>(
      Type.String {lifetime: run Shared.make<Lifetime>(Lifetime.Static)},
    )
  }
}

effect fn bodyRejection(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Result<
  BodyNodeId,
  Shared<Rejection>,
> ! OutOfMemoryError ? &mut Allocator {
  return Result.failResult<BodyNodeId, Shared<Rejection>>(run reject(resolver, module, code, span))
}

// Deferred evidence must not become an inference mismatch or a negative conformance proof.
fn unavailableRejection(code: RejectionCode) -> bool {
  if code == RejectionCode.Unsupported { return true }
  return match move BackendGap.forRejection(code) {
    Option<GapCode>.Some {..} => true
    Option<GapCode>.None => false
  }
}

// Pattern annotations share the body's ordinary type-resolution pass. Record them recursively so
// complete applications such as `Cell<i64> { value }` retain their written arguments.
effect fn collectPatternAnnotations(hir: &Module, pattern: HirId, annotations: &mut Vector<HirId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match Module.node(hir, pattern) {
    Node.NominalPattern {annotation, fields} => {
      run Vector.append<HirId>(&mut annotations.*, annotation)
      let mut at = usize.ZERO
      while at < fields.length {
        let field = Module.child(hir, fields, at)
        if let Node.PatternField {pattern: nested, ..} = Module.node(hir, field) {
          run collectPatternAnnotations(hir, nested, &mut annotations.*)
        }
        at = at + usize.ONE
      }
    }
    Node.VariantPattern {selector, fields} => {
      if let Node.MemberSelector {subject, ..} = Module.node(hir, selector) {
        run Vector.append<HirId>(&mut annotations.*, subject)
      }
      if fields.present {
        let mut at = usize.ZERO
        while at < fields.range.length {
          let field = Module.child(hir, fields.range, at)
          if let Node.PatternField {pattern: nested, ..} = Module.node(hir, field) {
            run collectPatternAnnotations(hir, nested, &mut annotations.*)
          }
          at = at + usize.ONE
        }
      }
    }
    Node.BindingPattern {annotation, ..} => {
      if annotation.present { run Vector.append<HirId>(&mut annotations.*, annotation.id) }
    }
    _ => ()
  }
  return ()
}

// These targets are values checked through their expression, rather than names selected from
// the call table. Discovery must still visit the expression to retain any calls it contains.
fn callableExpressionTarget(node: Node) -> bool {
  return match node {
    Node.IdentifierExpression {binding, ..} => binding.present
    Node.CallableExpression {..} => true
    Node.MoveExpression {..} => true
    Node.BorrowExpression {..} => true
    Node.ReferentExpression {..} => true
    Node.PrefixExpression {..} => true
    Node.CallExpression {..} => true
    Node.MatchExpression {..} => true
    _ => false
  }
}

// Qualified names retain the same declaration selection in calls, value construction and
// applied-owner syntax. Bound fields are runtime places and have no declaration reference.
effect fn qualifiedCallReference(hir: &Module, expression: HirId) -> Option<CallReference>
! OutOfMemoryError ? &mut Allocator {
  if let Node.FieldExpression {subject, field} = Module.node(hir, expression) {
    if let Node.IdentifierExpression {name, binding} = Module.node(hir, subject) {
      if !binding.present {
        if let Node.Name {text: namespace} = Module.node(hir, name) {
          if let Node.Name {text: member} = Module.node(hir, field) {
            return Option.some<CallReference>(CallReference.Qualified {
              namespace: run Bytes.copy(Module.text(hir, namespace)), member: run Bytes.copy(Module.text(hir, member)),
              subjectSpan: Module.span(hir, subject), memberSpan: Module.span(hir, field), application: HirRef.absent(),
            })
          }
        }
      }
    }
  }
  if let Node.MemberExpression {selector, fields} = Module.node(hir, expression) {
    if !fields.present {
      if let Node.MemberSelector {subject, member} = Module.node(hir, selector) {
        if let Node.AppliedType {target, ..} = Module.node(hir, subject) {
          if let Node.NamedType {path, hasMode, ..} = Module.node(hir, target) {
            if !hasMode {
              if let Node.Path {segments} = Module.node(hir, path) {
                if segments.length == usize.ONE {
                  if let Node.Name {text: namespace} = Module.node(hir, Module.child(hir, segments, usize.ZERO)) {
                    if let Node.Name {text: memberName} = Module.node(hir, member) {
                      return Option.some<CallReference>(CallReference.Qualified {
                        namespace: run Bytes.copy(Module.text(hir, namespace)), member: run Bytes.copy(Module.text(hir, memberName)),
                        subjectSpan: Module.span(hir, subject), memberSpan: Module.span(hir, member), application: HirRef.of(subject),
                      })
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return Option.none<CallReference>()
}

// A qualified name used as a value selects its declaration through the call table.
effect fn collectQualifiedValue(hir: &Module, expression: HirId, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let qualified = run qualifiedCallReference(hir, expression)
  if let Option<CallReference>.Some {value: reference} = move qualified {
    run Vector.append<CallSyntax>(&mut calls.*, CallSyntax {
      value: true, id: expression, span: Module.span(hir, expression), reference: move reference,
      generics: HirRef.absent(), pipeline: false,
    })
  }
  return ()
}

effect fn collectElements(hir: &Module, elements: Range, annotations: &mut Vector<HirId>, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < elements.length {
    run collectCall(hir, Module.child(hir, elements, at), &mut annotations.*, &mut calls.*)
    at = at + usize.ONE
  }
  return ()
}

effect fn collectInitializers(hir: &Module, fields: Range, annotations: &mut Vector<HirId>, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < fields.length {
    if let Node.FieldInitializer {value, ..} = Module.node(hir, Module.child(hir, fields, at)) {
      run collectCall(hir, value, &mut annotations.*, &mut calls.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// Body typing finds a call's target only in the table this discovery builds, so every expression
// form that can hold a call or a qualified value is listed here and visits each operand it owns.
effect fn collectCall(hir: &Module, expression: HirId, annotations: &mut Vector<HirId>, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError
? &mut Allocator {
  // Calls and pipelines share one authored input shape and record their target first.
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(Module.node(hir, expression)) {
    return run collectInvocation(hir, expression, input, &mut annotations.*, &mut calls.*)
  }
  match Module.node(hir, expression) {
    Node.BorrowExpression {operand, ..} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.MoveExpression {operand} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.RunExpression {operand} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.UnsafeExpression {operand} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.PrefixExpression {operand, ..} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.CompileErrorExpression {message} => run collectCall(hir, message, &mut annotations.*, &mut calls.*)
    Node.ReferentExpression {subject} => run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
    Node.OrdinalExpression {subject, ..} => run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
    Node.InfixExpression {left, right, ..} => {
      run collectCall(hir, left, &mut annotations.*, &mut calls.*)
      run collectCall(hir, right, &mut annotations.*, &mut calls.*)
    }
    Node.IndexExpression {subject, index} => {
      run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
      run collectCall(hir, index, &mut annotations.*, &mut calls.*)
    }
    Node.TupleExpression {elements} => run collectElements(hir, elements, &mut annotations.*, &mut calls.*)
    Node.ArrayExpression {elements} => run collectElements(hir, elements, &mut annotations.*, &mut calls.*)
    Node.StructExpression {fields, ..} => run collectInitializers(hir, fields, &mut annotations.*, &mut calls.*)
    Node.RecordExpression {fields} => run collectInitializers(hir, fields, &mut annotations.*, &mut calls.*)
    Node.MemberExpression {fields, ..} => {
      if fields.present {
        run collectInitializers(hir, fields.range, &mut annotations.*, &mut calls.*)
      } else {
        run collectQualifiedValue(hir, expression, &mut calls.*)
      }
    }
    Node.FieldExpression {subject, ..} => {
      run collectQualifiedValue(hir, expression, &mut calls.*)
      run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
    }
    Node.IdentifierExpression {name, binding} => {
      if !binding.present {
        if let Node.Name {text} = Module.node(hir, name) {
          run Vector.append<CallSyntax>(&mut calls.*, CallSyntax {
            value: true, id: expression, span: Module.span(hir, name),
            reference: CallReference.Unbound {name: run Bytes.copy(Module.text(hir, text))},
            generics: HirRef.absent(), pipeline: false,
          })
        }
      }
    }
    Node.MatchExpression {subject, arms, ..} => {
      run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
      let mut at = usize.ZERO
      while at < arms.length {
        if let Node.MatchArm {pattern, guard, result} = Module.node(hir, Module.child(hir, arms, at)) {
          run collectPatternAnnotations(hir, pattern, &mut annotations.*)
          if guard.present { run collectCall(hir, guard.id, &mut annotations.*, &mut calls.*) }
          // A block arm holds statements, whose calls and annotations its body check will demand.
          if let Node.Block {statements} = Module.node(hir, result) {
            run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
          } else {
            run collectCall(hir, result, &mut annotations.*, &mut calls.*)
          }
        }
        at = at + usize.ONE
      }
    }
    // A literal's own block resolves its facts when the literal is checked (`literalFacts`).
    Node.CallableExpression {..} => ()
    Node.EffectExpression {..} => ()
    // Literals and non-expression nodes hold no call. A damaged `InvalidExpression` deliberately
    // leaves its retained children unvisited: body typing rejects it as a whole without reading
    // the call table. Calls and pipelines were dispatched above.
    _ => ()
  }
  return ()
}

// A call or pipeline records its target, then visits the callee value and every argument.
effect fn collectInvocation(hir: &Module, expression: HirId, input: CallInput, annotations: &mut Vector<HirId>, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let CallInput {callee, generics, arguments, pipeline} = input
  let mut reference = CallReference.Unsupported
  let mut receiverCall = false

  match Module.node(hir, callee) {
    Node.IdentifierExpression {name, binding} => {
      if binding.present {
        reference = CallReference.NonCallable
        if pipeline { reference = CallReference.CallableValue }
      } else if let Node.Name {text} = Module.node(hir, name) {
        reference = CallReference.Named {name: run Bytes.copy(Module.text(hir, text))}
      }
    }
    Node.FieldExpression {..} => {
      let qualified = run qualifiedCallReference(hir, callee)
      if let Option<CallReference>.Some {value} = move qualified { reference = move value }
      else { receiverCall = true }
    }
    Node.MemberExpression {..} => {
      let qualified = run qualifiedCallReference(hir, callee)
      if let Option<CallReference>.Some {value} = move qualified { reference = move value }
    }
    Node.IntegerLiteral {..} => {
      reference = CallReference.NonCallable
    }
    Node.BooleanLiteral {..} => {
      reference = CallReference.NonCallable
    }
    Node.UnitLiteral => {
      reference = CallReference.NonCallable
    }
    _ => ()
  }
  if pipeline && receiverCall { reference = CallReference.CallableValue }
  if !receiverCall || pipeline {
    let mut targetSpan = Module.span(hir, callee)
    if pipeline { targetSpan = Module.span(hir, expression) }
    run Vector.append<CallSyntax>(
      &mut calls.*,
      CallSyntax {
        value: false,
        id: expression,
        span: targetSpan,
        reference: move reference,
        generics: generics,
        pipeline: pipeline,
      },
    )
  } else if let Node.FieldExpression {subject, ..} = Module.node(hir, callee) {
    run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
  }

  if callableExpressionTarget(Module.node(hir, callee)) {
    run collectCall(hir, callee, &mut annotations.*, &mut calls.*)
  }
  let mut at = usize.ZERO
  while at < CallArguments.length(arguments) {
    run collectCall(hir, CallArguments.child(arguments, hir, at), &mut annotations.*, &mut calls.*)
    at = at + usize.ONE
  }
  return ()
}

// An `if` or `if let` and its whole `else` chain.
effect fn collectConditional(hir: &Module, statement: HirId, annotations: &mut Vector<HirId>, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut current = HirRef.of(statement)
  while current.present {
    let mut thenBranch = current.id
    let mut elseBranch = HirRef.absent()
    match Module.node(hir, current.id) {
      Node.Block {statements} => {
        run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        return ()
      }
      Node.ConditionalStatement {condition, thenBranch: selected, elseBranch: otherwise} => {
        run collectCall(hir, condition, &mut annotations.*, &mut calls.*)
        thenBranch = selected
        elseBranch = otherwise
      }
      Node.PatternConditionalStatement {pattern, subject, thenBranch: selected, elseBranch: otherwise} => {
        run collectPatternAnnotations(hir, pattern, &mut annotations.*)
        run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
        thenBranch = selected
        elseBranch = otherwise
      }
      _ => { return () }
    }
    if let Node.Block {statements} = Module.node(hir, thenBranch) {
      run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
    }
    current = elseBranch
  }
  return ()
}

effect fn collectBodySyntax(
  hir: &Module,
  written: Range,
  annotations: &mut Vector<HirId>,
  calls: &mut Vector<CallSyntax>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < written.length {
    let statement = Module.child(hir, written, at)
    match Module.node(hir, statement) {
      Node.ReturnStatement {value} => {
        if value.present {
          run collectCall(hir, value.id, &mut annotations.*, &mut calls.*)
        }
      }
      Node.ExpressionStatement {expression} => {
        run collectCall(hir, expression, &mut annotations.*, &mut calls.*)
      }
      Node.DropStatement {value} => {
        run collectCall(hir, value, &mut annotations.*, &mut calls.*)
      }
      Node.FailStatement {value, ..} => {
        run collectCall(hir, value, &mut annotations.*, &mut calls.*)
      }
      Node.BindingStatement {isStatic, annotation, initializer, ..} => {
        if !isStatic && annotation.present {
          run Vector.append<HirId>(&mut annotations.*, annotation.id)
        }
        run collectCall(hir, initializer, &mut annotations.*, &mut calls.*)
      }
      Node.UnsafeStatement {body} => {
        if let Node.Block {statements} = Module.node(hir, body) {
          run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        }
      }
      Node.AssignmentStatement {target, value} => {
        run collectCall(hir, target, &mut annotations.*, &mut calls.*)
        run collectCall(hir, value, &mut annotations.*, &mut calls.*)
      }
      Node.WhileStatement {condition, body} => {
        run collectCall(hir, condition, &mut annotations.*, &mut calls.*)
        if let Node.Block {statements} = Module.node(hir, body) {
          run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        }
      }
      Node.PatternBindingStatement {pattern, initializer} => {
        run collectPatternAnnotations(hir, pattern, &mut annotations.*)
        run collectCall(hir, initializer, &mut annotations.*, &mut calls.*)
      }
      Node.ConditionalStatement {..} => run collectConditional(hir, statement, &mut annotations.*, &mut calls.*)
      Node.PatternConditionalStatement {..} => run collectConditional(hir, statement, &mut annotations.*, &mut calls.*)
      _ => ()
    }
    at = at + usize.ONE
  }
  return ()
}

// Only binders retained by the resolved contract remain writable or need call-site evidence.
// Member-owned parameters and generated lifetimes are distinct from an impl's owner binders.
fn signatureListsBinder(answer: &Result<Answer, NoRejection>, binder: &Binder) -> bool {
  if let Result<Answer, NoRejection>.Success {value: resolved} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &resolved.outcome {
      match &binder.* {
        Binder.Type {value: parameter, ..} => {
          let listed = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
          let mut at = usize.ZERO
          while at < listed.length {
            if sameReusableType(&parameter, &listed[at]) { return true }
            at = at + usize.ONE
          }
        }
        Binder.Lifetime {value: region, ..} => {
          let listed = Vector.asSlice<Shared<Lifetime>>(&signature.lifetimeParameters)
          let mut at = usize.ZERO
          while at < listed.length {
            if Lifetime.equalsShared(&region, &listed[at]) { return true }
            at = at + usize.ONE
          }
        }
        Binder.Row {value: parameter, ..} => {
          let listed = Vector.asSlice<RowParameter>(&signature.rowParameters)
          let mut at = usize.ZERO
          while at < listed.length {
            if parameter.ordinal == listed[at].ordinal && sameDeclarationShared(&parameter.declaration, &listed[at].declaration) {
              return true
            }
            at = at + usize.ONE
          }
        }
      }
    }
  }
  return false
}

fn callArityRejection(parameters: usize, arguments: usize) -> Option<RejectionCode> {
  if arguments > parameters { return Option.some<RejectionCode>(RejectionCode.CallArity) }
  if arguments == usize.ZERO && parameters > usize.ZERO {
    return Option.some<RejectionCode>(RejectionCode.RedundantCall)
  }
  return Option.none<RejectionCode>()
}

// Lifetime parameters a signature declares, as read from its resolved answer.
fn signatureLifetimeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: resolvedAnswer} => match & resolvedAnswer.outcome {
      Outcome.Success {value: Value.Signature {signature: resolved}} => Vector.length<
        Shared<Lifetime>,
      >(&resolved.lifetimeParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureLifetimeAt(answer: &Result<Answer, NoRejection>, index: usize) -> Option<Shared<Lifetime>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: resolvedAnswer} => match & resolvedAnswer.outcome {
      Outcome.Success {value: Value.Signature {signature: resolved}} => {
        let lifetimes = Vector.asSlice<Shared<Lifetime>>(&resolved.lifetimeParameters)
        if index < lifetimes.length {
          return Option.some<Shared<Lifetime>>(
            Shared.clone<Lifetime>(&lifetimes[index]),
          )
        }
        return Option.none<Shared<Lifetime>>()
      }
      _ => Option.none<Shared<Lifetime>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Lifetime>>()
  }
}

// Appends an anonymous binder for each signature lifetime the written binders do not cover.
effect fn appendGeneratedLifetimes(
  signature: &Shared<Result<Answer, NoRejection>>,
  binders: &mut Vector<Binder>,
) -> ()
! OutOfMemoryError
? &mut Allocator {
  let totalLifetimes = Shared.with<Result<Answer, NoRejection>, usize>(
    signature,
    signatureLifetimeCount,
  )
  let mut generatedAt = writtenLifetimeCount(Vector.asSlice<Binder>(&binders.*))
  while generatedAt < totalLifetimes {
    let generated = Shared.with<Result<Answer, NoRejection>, Option<Shared<Lifetime>>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> {
        return signatureLifetimeAt(answer, generatedAt)
      },
    )
    if let Option<Shared<Lifetime>>.Some {value: generatedLifetime} = move generated {
      run Vector.append<Binder>(
        &mut binders.*,
        Binder.Lifetime {name: Bytes.make(), value: move generatedLifetime},
      )
    }
    generatedAt = generatedAt + usize.ONE
  }
}

// The binders a prefix may write for a declaration that refines its enclosing scope: the
// enclosing binders its signature lists, then its own binders the enclosing scope does not name.
effect fn callableBinders(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  target: &ModuleId,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  binders: &Vector<Binder>,
) -> Result<Vector<Binder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let targetModule = knownModuleOrdinal(&resolver.*, target)
  if targetModule == usize.MAX { fail InvalidModulePath {} }
  let inherited = run enclosingScope(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, targetModule, target, ordinal,
  )
  let enclosing = match move inherited {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value: inheritedBinders} => move inheritedBinders
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(move error)
    }
  }
  let visible = Vector.asSlice<Binder>(&enclosing)
  let mut callable = Vector.make<Binder>()
  let mut at = usize.ZERO
  while at < visible.length {
    if Shared.with<Result<Answer, NoRejection>, bool>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return signatureListsBinder(answer, &visible[at])
      },
    ) {
      run Vector.append<Binder>(&mut callable, run copyBinder(&visible[at]))
    }
    at = at + usize.ONE
  }
  let own = Vector.asSlice<Binder>(&binders.*)
  at = usize.ZERO
  while at < own.length {
    if !hasBinder(visible, binderName(&own[at])) {
      run Vector.append<Binder>(&mut callable, run copyBinder(&own[at]))
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Binder>, Shared<Rejection>>(move callable)
}

// The first binder at or after `start` in the lifetime namespace or the ordinary one.
fn nextBinderOfKind(formal: &[Binder], start: usize, lifetime: bool) -> usize {
  let mut at = start
  while at < formal.length {
    let isLifetime = binderKind(&formal[at]) == GenericKind.Lifetime
    if isLifetime == lifetime {
      return at
    }
    at = at + usize.ONE
  }
  return formal.length
}

fn binderCountOfKind(formal: &[Binder], lifetime: bool) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < formal.length {
    let isLifetime = binderKind(&formal[at]) == GenericKind.Lifetime
    if isLifetime == lifetime {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// The binder each written argument fixes (GEN-007). Lifetime arguments and ordinary (type, row,
// static) arguments are separate namespaces: each takes the next binder of its own kind, so an
// unwritten lifetime stays an inference variable wherever it appears. A written `? R` suffix
// continues the ordinary namespace and is the last ordinal when `suffix` is set.
effect fn writtenBinderOrdinals(
  resolver: &mut Resolver,
  module: &ModuleId,
  arguments: Range,
  span: Span,
  formal: &[Binder],
  suffix: bool,
) -> Result<Vector<usize>, Shared<Rejection>>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut writtenLifetimes = usize.ZERO
  let mut at = usize.ZERO
  while at < arguments.length {
    let supplied = run suppliedArgument(&mut resolver.*, module, arguments, at, span)
    if supplied.kind == GenericKind.Lifetime {
      writtenLifetimes = writtenLifetimes + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut ordinals = Vector.make<usize>()
  let mut lifetimeAt = usize.ZERO
  let mut ordinaryAt = usize.ZERO
  at = usize.ZERO
  while at < arguments.length {
    let supplied = run suppliedArgument(&mut resolver.*, module, arguments, at, span)
    let lifetime = supplied.kind == GenericKind.Lifetime
    let mut formalAt = usize.ZERO
    if lifetime {
      formalAt = nextBinderOfKind(formal, lifetimeAt, true)
      lifetimeAt = formalAt + usize.ONE
    } else {
      formalAt = nextBinderOfKind(formal, ordinaryAt, false)
      ordinaryAt = formalAt + usize.ONE
    }
    if formalAt == formal.length {
      // A declaration with no binder of the written kind reports the kind of the binder the
      // argument would otherwise reach; an exhausted namespace reports its own arity.
      let other = nextBinderOfKind(formal, usize.ZERO, true)
      if lifetime {
        let ordinary = nextBinderOfKind(formal, ordinaryAt, false)
        if binderCountOfKind(formal, true) == usize.ZERO && ordinary < formal.length {
          return Result.failResult<Vector<usize>, Shared<Rejection>>(
            run rejectKind(&resolver.*, module, supplied.span, binderName(&formal[ordinary]), binderKind(&formal[ordinary]), supplied.kind),
          )
        }
      } else if binderCountOfKind(formal, false) == usize.ZERO && other < formal.length {
        return Result.failResult<Vector<usize>, Shared<Rejection>>(
          run rejectKind(&resolver.*, module, supplied.span, binderName(&formal[other]), GenericKind.Lifetime, supplied.kind),
        )
      }
      let mut written = arguments.length - writtenLifetimes
      if lifetime {
        written = writtenLifetimes
      }
      return Result.failResult<Vector<usize>, Shared<Rejection>>(
        run rejectArity(&resolver.*, module, supplied.span, binderCountOfKind(formal, lifetime), written),
      )
    }
    run Vector.append<usize>(&mut ordinals, formalAt)
    at = at + usize.ONE
  }
  if suffix {
    run Vector.append<usize>(&mut ordinals, nextBinderOfKind(formal, ordinaryAt, false))
  }
  return Result.succeed<Vector<usize>, Shared<Rejection>>(move ordinals)
}

// Whether `binder` is a `?S` that some `provides` bound of the signature uses as its selector, so
// an explicit argument for it names an access-free service-role key (SERV-007).
fn selectsBinder(answer: &Result<Answer, NoRejection>, binder: &Binder) -> bool {
  if let Binder.Row {value: parameter, ..} = &binder.* {
    if let Result<Answer, NoRejection>.Success {value} = &answer.* {
      if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
        let constraints = Vector.asSlice<Constraint>(&signature.constraints)
        let mut at = usize.ZERO
        while at < constraints.length {
          if let Constraint.Provides {selector, ..} = &constraints[at] {
            let ordinal = Shared.with<Row, usize>(
              &selector,
              fn(row: &Row) -> usize {
                return selectorOrdinalIn(row, &parameter.declaration)
              },
            )
            if ordinal == parameter.ordinal {
              return true
            }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  return false
}

// Resolves the written generic argument at `at` against its formal binder and appends it.
effect fn appendWrittenArgument(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  callerOrdinal: usize,
  caller: &ModuleId,
  arguments: Range,
  formal: &[Binder],
  at: usize,
  formalAt: usize,
  scope: &[Binder],
  elision: &mut LifetimeElision,
  selector: bool,
  explicit: &mut Vector<Argument>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let child = run typeChild(&mut resolver.*, caller, arguments, at)
  let argument = match move child {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return Option.none<Shared<Rejection>>()
    }
  }
  let source = run typeNode(&mut resolver.*, caller, argument)
  let found = match move source {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Option.none<Shared<Rejection>>()
    }
  }
  let mut supplied = GenericKind.Type
  if let Node.Lifetime {..} = found.header {
    supplied = GenericKind.Lifetime
  }
  if let Node.RequirementSelector {..} = found.header {
    supplied = GenericKind.Requirement
  }
  let expected = binderKind(&formal[formalAt])
  if (expected == GenericKind.Type && supplied != GenericKind.Type) || (expected == GenericKind.Lifetime && supplied != GenericKind.Lifetime) || (expected == GenericKind.Requirement && supplied == GenericKind.Lifetime) {
    return Option.some<Shared<Rejection>>(
      run rejectKind(
        &resolver.*,
        caller,
        found.span,
        binderName(&formal[formalAt]),
        expected,
        supplied,
      ),
    )
  }
  if expected == GenericKind.Type {
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      callerOrdinal,
      argument,
      scope,
      &mut elision.*,
    )
    match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
        run Vector.append<Argument>(&mut explicit.*, Argument.Type {value: move ty})
      }
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Shared<Rejection>>(move error)
      }
    }
  } else if expected == GenericKind.Lifetime {
    let resolved = run lifetimeAt(&mut resolver.*, caller, argument, scope)
    match move resolved {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
        run Vector.append<Argument>(
          &mut explicit.*,
          Argument.Lifetime {value: move lifetime},
        )
      }
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Shared<Rejection>>(move error)
      }
    }
  } else {
    let mut row = Row.empty()
    let added = run rowArgument(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      callerOrdinal,
      caller,
      argument,
      binderName(&formal[formalAt]),
      scope,
      &mut elision.*,
      selector,
      &mut row,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
      return Option.some<Shared<Rejection>>(move diagnostic)
    }
    run Vector.append<Argument>(
      &mut explicit.*,
      Argument.Row {value: run Shared.make<Row>(move row)},
    )
  }
  return Option.none<Shared<Rejection>>()
}

// Resolves a written requirement suffix into the one writable row binder that follows the
// positional arguments.
effect fn appendRequirementsSuffix(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  callerOrdinal: usize,
  caller: &ModuleId,
  formal: &[Binder],
  argumentCount: usize,
  requirements: HirRef,
  span: Span,
  scope: &[Binder],
  elision: &mut LifetimeElision,
  explicit: &mut Vector<Argument>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if rowBinderCount(formal) > usize.ONE {
    // The reference does not define a suffix when more than one row remains writable.
    return Option.some<Shared<Rejection>>(
      run reject(&resolver.*, caller, RejectionCode.Unsupported, span),
    )
  }
  if argumentCount == formal.length {
    return Option.some<Shared<Rejection>>(
      run rejectArity(
        &resolver.*,
        caller,
        span,
        formal.length,
        argumentCount + usize.ONE,
      ),
    )
  }
  if binderKind(&formal[argumentCount]) != GenericKind.Requirement {
    return Option.some<Shared<Rejection>>(
      run rejectKind(
        &resolver.*,
        caller,
        span,
        binderName(&formal[argumentCount]),
        binderKind(&formal[argumentCount]),
        GenericKind.Requirement,
      ),
    )
  }
  let resolved = run resolveChannels(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    callerOrdinal,
    caller,
    HirRef.absent(),
    requirements,
    scope,
    &mut elision.*,
  )
  match move resolved {
    Result<Channels, Shared<Rejection>>.Success {value: channels} => {
      run Vector.append<Argument>(
        &mut explicit.*,
        Argument.Row {value: move channels.requirements},
      )
    }
    Result<Channels, Shared<Rejection>>.Failure {error} => {
      return Option.some<Shared<Rejection>>(move error)
    }
  }
  return Option.none<Shared<Rejection>>()
}

fn callPrefixSlot(binder: &Binder) -> CallPrefixSlot {
  return match &binder.* {
    Binder.Type {value, ..} => CallPrefixSlot.Type {value: Shared.clone<Type>(&value)}
    Binder.Lifetime {value, ..} => CallPrefixSlot.Lifetime {value: Shared.clone<Lifetime>(&value)}
    Binder.Row {value, ..} => CallPrefixSlot.Row {value: RowParameter {
      declaration: Shared.clone<DeclarationId>(&value.declaration), ordinal: value.ordinal}}
  }
}

fn copyCallPrefixOwner(owner: &Option<Shared<DeclarationId>>) -> Option<Shared<DeclarationId>> {
  return match &owner.* {
    Option<Shared<DeclarationId>>.Some {value} => Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&value))
    Option<Shared<DeclarationId>>.None => Option.none<Shared<DeclarationId>>()
  }
}

effect fn copyCallPrefixSlots(slots: &[CallPrefixSlot]) -> Vector<CallPrefixSlot>
! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<CallPrefixSlot>()
  let mut at = usize.ZERO
  while at < slots.length {
    let value = match &slots[at] {
      CallPrefixSlot.Type {value} => CallPrefixSlot.Type {value: Shared.clone<Type>(&value)}
      CallPrefixSlot.Lifetime {value} => CallPrefixSlot.Lifetime {value: Shared.clone<Lifetime>(&value)}
      CallPrefixSlot.Row {value} => CallPrefixSlot.Row {value: RowParameter {
        declaration: Shared.clone<DeclarationId>(&value.declaration), ordinal: value.ordinal}}
    }
    run Vector.append<CallPrefixSlot>(&mut copied, move value)
    at = at + usize.ONE
  }
  return move copied
}

fn callPrefixSlotOrdinal(slot: &CallPrefixSlot, owner: &DeclarationId) -> usize {
  return match &slot.* {
    CallPrefixSlot.Type {value} => Shared.with<Type, usize>(&value,
      fn(parameter: &Type) -> usize { return Type.parameterOrdinalOf(parameter, owner) })
    CallPrefixSlot.Lifetime {value} => ownedLifetimeOrdinal(&value, owner)
    CallPrefixSlot.Row {value} => {
      if Shared.with<DeclarationId, bool>(&value.declaration, fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, owner) }) { return value.ordinal }
      return usize.MAX
    }
  }
}

effect fn callPrefixInferenceOrdinal(slot: &CallPrefixSlot, schema: &TargetSchema,
  signature: &Shared<Result<Answer, NoRejection>>, opened: &Shared<Result<Answer, NoRejection>>)
  -> usize ! OutOfMemoryError ? &mut Allocator {
  let owner = run DeclarationId.copyShared(&schema.declaration)
  let ordinal = callPrefixSlotOrdinal(slot, &owner)
  if ordinal != usize.MAX { return sectionInferenceOrdinal(schema, opened, ordinal) }
  let scopes = Vector.asSlice<ApplicationScope>(&schema.scopes)
  let mut at = usize.ZERO
  while at < scopes.length {
    let owner = run DeclarationId.copyShared(&scopes[at].owner)
    let ordinal = callPrefixSlotOrdinal(slot, &owner)
    if ordinal != usize.MAX { return run sectionScopeInferenceOrdinal(schema, signature, &owner, ordinal) }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A written call prefix fixes binders like an aggregate prefix: lifetime and ordinary arguments
// are mapped in separate namespaces (`writtenBinderOrdinals`), and every unwritten binder is an
// inference variable.
effect fn resolveCallPrefix(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  callerOrdinal: usize,
  caller: &ModuleId,
  target: &ModuleId,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  written: HirRef,
  scope: &[Binder],
  constraints: &[Constraint],
) -> Result<CallPrefix, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut explicit = Vector.make<Argument>()
  let mut slots = Vector.make<CallPrefixSlot>()
  if !written.present {
    return Result.succeed<CallPrefix, Shared<Rejection>>(CallPrefix {arguments: move explicit, slots: move slots, owner: Option.none<Shared<DeclarationId>>(), lifetimes: usize.ZERO})
  }
  let source = run typeNode(&mut resolver.*, caller, written.id)
  let value = match move source {
    Option<HeaderSyntax>.Some {value: syntax} => syntax
    Option<HeaderSyntax>.None => {
      return Result.failResult<CallPrefix, Shared<Rejection>>(
        run reject(&resolver.*, caller, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
      )
    }
  }
  if let Node.TypeArguments {arguments, environment, failures, requirements} = value.header {
    let template = run templateBinders(&mut resolver.*, target, ordinal)
    let mut binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CallPrefix, Shared<Rejection>>(move error)
      }
    }
    if run refinesEnclosing(&mut resolver.*, target, ordinal) {
      let callable = run callableBinders(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, target, ordinal, signature, &binders,
      )
      binders = match move callable {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CallPrefix, Shared<Rejection>>(move error)
        }
      }
    }
    run appendGeneratedLifetimes(signature, &mut binders)
    let formal = Vector.asSlice<Binder>(&binders)
    if environment.present || failures.present {
      let mut supplied = GenericKind.Lifetime
      if failures.present {
        supplied = GenericKind.Failure
      }
      return Result.failResult<CallPrefix, Shared<Rejection>>(
        run rejectKind(&resolver.*, caller, value.span, b"", GenericKind.Type, supplied),
      )
    }
    let declaredAnswer = run declarationAt(&mut resolver.*, target, ordinal)
    let declared = match move declaredAnswer {
      Option<DeclarationId>.Some {value: prefixDeclaration} => move prefixDeclaration
      _ => { fail RevisionMismatch {} }
    }
    let mut prefixScope = Bytes.make()
    run Bytes.append(&mut prefixScope, b"\0call-prefix-lifetimes")
    run RuntimeEncoding.word(&mut prefixScope, usize.toU64(callerOrdinal))
    run RuntimeEncoding.word(&mut prefixScope, usize.toU64(written.id.index))
    let prefixOwner = run DeclarationId.inference(&declared, Bytes.asSlice(&prefixScope))
    let mut elision = LifetimeElision {
      owner: Option.some<DeclarationId>(run DeclarationId.copy(&prefixOwner)),
      nextOrdinal: usize.ZERO,
      output: false,
      resultDefault: Option.none<Shared<Lifetime>>(),
      generated: Vector.make<Shared<Lifetime>>(),
      invocation: false,
      nested: false,
      renumber: Vector.make<usize>(),
      staticEnvironment: false,
      supplied: Option.none<Vector<Argument>>(),
      assumptions: Option.some<Vector<Constraint>>(run copyConstraints(constraints)),
    }
    let mapped = run writtenBinderOrdinals(&mut resolver.*, caller, arguments, value.span, formal, requirements.present)
    let positions = match move mapped {
      Result<Vector<usize>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<usize>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CallPrefix, Shared<Rejection>>(move error)
      }
    }
    let targets = Vector.asSlice<usize>(&positions)
    let mut at = usize.ZERO
    while at < arguments.length {
      let formalAt = targets[at]
      let selector = Shared.with<Result<Answer, NoRejection>, bool>(
        signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return selectsBinder(answer, &formal[formalAt])
        },
      )
      let failure = run appendWrittenArgument(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, callerOrdinal, caller, arguments,
        formal, at, formalAt, scope, &mut elision, selector, &mut explicit,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result.failResult<CallPrefix, Shared<Rejection>>(move diagnostic)
      }
      run Vector.append<CallPrefixSlot>(&mut slots, callPrefixSlot(&formal[formalAt]))
      at = at + usize.ONE
    }
    if requirements.present {
      let suffixAt = targets[arguments.length]
      let failure = run appendRequirementsSuffix(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, callerOrdinal, caller, formal,
        suffixAt, requirements, value.span, scope, &mut elision, &mut explicit,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result.failResult<CallPrefix, Shared<Rejection>>(move diagnostic)
      }
      run Vector.append<CallPrefixSlot>(&mut slots, callPrefixSlot(&formal[suffixAt]))
    }
    let mut pending = Option.none<Shared<DeclarationId>>()
    if elision.nextOrdinal != usize.ZERO { pending = Option.some<Shared<DeclarationId>>(run Shared.make<DeclarationId>(move prefixOwner)) }
    return Result.succeed<CallPrefix, Shared<Rejection>>(CallPrefix {arguments: move explicit, slots: move slots,
      owner: move pending, lifetimes: elision.nextOrdinal})
  }
  return Result.failResult<CallPrefix, Shared<Rejection>>(
    run reject(&resolver.*, caller, RejectionCode.Unsupported, value.span),
  )
}

// Static aggregate reflection and raw-pointer primitives take their contracts from exactly
// their written type arguments, resolved in the caller's binders; the sealed contract is
// otherwise closed.
effect fn typedIntrinsicTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  member: IntrinsicMember,
  generics: HirRef,
  span: Span,
  scope: &[Binder],
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let count = intrinsicTypeArity(member)
  if !generics.present {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(run rejectArity(&resolver.*, module, span, count, usize.ZERO))
  }
  let mut elision = LifetimeElision {
    owner: Option.none<DeclarationId>(),
    nextOrdinal: usize.ZERO,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let written = run typeNode(&mut resolver.*, module, generics.id)
  if let Option<HeaderSyntax>.Some {value: found} = move written {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != count {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(run rejectArity(&resolver.*, module, found.span, count, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let mut typeArguments = Vector.make<Shared<Type>>()
      let mut at = usize.ZERO
      while at < count {
        let child = run typeChild(&mut resolver.*, module, supplied, at)
        let argument = match move child {
          Option<HirId>.Some {value} => value
          Option<HirId>.None => {
            return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
          }
        }
        let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, scope, &mut elision)
        let described = match move resolved {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
          }
        }
        run Vector.append<Shared<Type>>(&mut typeArguments, move described)
        at = at + usize.ONE
      }
      return Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Intrinsic {member: member, typeArguments: move typeArguments})
    }
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// A storage primitive's contract is instantiated from exactly its written type arguments, resolved
// in the caller's binders. `replace` may omit its one type argument and takes it from its place.
effect fn storageTarget(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, moduleOrdinal: usize, operation: StorageOperation,
  generics: HirRef, scope: &[Binder], span: Span) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let count = StorageOperation.typeArity(operation)
  let mut typeArguments = Vector.make<Shared<Type>>()
  if !generics.present {
    if count != usize.ZERO && operation != StorageOperation.Replace {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(run rejectArity(&resolver.*, module, span, count, usize.ZERO))
    }
    return Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Storage {operation: operation,
      typeArguments: move typeArguments})
  }
  let mut elision = LifetimeElision {
    owner: Option.none<DeclarationId>(), nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option.none<Shared<Lifetime>>(), generated: Vector.make<Shared<Lifetime>>(), invocation: false,
    nested: false, renumber: Vector.make<usize>(), staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(), assumptions: Option.none<Vector<Constraint>>(),
  }
  let syntax = run typeNode(&mut resolver.*, module, generics.id)
  if let Option<HeaderSyntax>.Some {value: found} = move syntax {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != count {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(run rejectArity(&resolver.*, module, found.span, count, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let mut at = usize.ZERO
      while at < count {
        let argument = match move run typeChild(&mut resolver.*, module, supplied, at) {
          Option<HirId>.Some {value} => value
          Option<HirId>.None => { return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span)) }
        }
        match move run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, scope, &mut elision) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => { run Vector.append<Shared<Type>>(&mut typeArguments, move value) }
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error) }
        }
        at = at + usize.ONE
      }
      return Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Storage {operation: operation,
        typeArguments: move typeArguments})
    }
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// A composition intrinsic's written arguments: the caught failure subset of `catchFailure`, the
// service-role key a binding serves, or the optional `<A, E, ?R, ?S>` of a finalizer (preceded by
// `Resource` for `useReleaseNonParking`).
fn bindingComposition(operation: Composition) -> bool {
  return operation == Composition.BindShared || operation == Composition.BindExclusive || operation == Composition.BindOwned
}

effect fn compositionTarget(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, moduleOrdinal: usize, operation: Composition,
  generics: HirRef, scope: &[Binder], span: Span) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut arity = usize.ONE
  if operation == Composition.Finalize || operation == Composition.FinalizeNonParking { arity = 4 }
  if operation == Composition.UseRelease { arity = 5 }
  if operation == Composition.Observe { arity = 4 }
  // A suspension infers its channels from the deferred Effect and writes no type arguments.
  if operation == Composition.Suspend { arity = usize.ZERO }
  let mut written = Vector.make<Argument>()
  if !generics.present {
    // A finalizer and an observation infer their arguments from their operands.
    if operation == Composition.CatchFailure || bindingComposition(operation) {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(run rejectArity(&resolver.*, module, span, usize.ONE, usize.ZERO))
    }
    return Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Composition {operation: operation, written: move written})
  }
  let mut elision = LifetimeElision {
    owner: Option.none<DeclarationId>(), nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option.none<Shared<Lifetime>>(), generated: Vector.make<Shared<Lifetime>>(), invocation: false,
    nested: false, renumber: Vector.make<usize>(), staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(), assumptions: Option.none<Vector<Constraint>>(),
  }
  let syntax = run typeNode(&mut resolver.*, module, generics.id)
  if let Option<HeaderSyntax>.Some {value: found} = move syntax {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != arity {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(run rejectArity(&resolver.*, module, found.span, arity, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let mut at = usize.ZERO
      while at < arity {
        let child = run typeChild(&mut resolver.*, module, supplied, at)
        let argument = match move child {
          Option<HirId>.Some {value} => value
          Option<HirId>.None => { return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span)) }
        }
        // A binding selects one service-role key (SERV-007), carried as a row.
        if bindingComposition(operation) {
          let mut keys = Row.empty()
          let failed = run rowArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, argument,
            b"S", scope, &mut elision, true, &mut keys)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value) }
          run Vector.append<Argument>(&mut written, Argument.Row {value: run Shared.make<Row>(move keys)})
        } else if (operation == Composition.Observe && at == 2) || (operation != Composition.CatchFailure &&
          operation != Composition.Observe && at + 2 >= arity) {
          let mut row = Row.empty()
          let failed = run rowArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, argument,
            b"", scope, &mut elision, false, &mut row)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value) }
          run Vector.append<Argument>(&mut written, Argument.Row {value: run Shared.make<Row>(move row)})
        } else {
          let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, scope, &mut elision)
          match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => { run Vector.append<Argument>(&mut written, Argument.Type {value: move value}) }
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error) }
          }
        }
        at = at + usize.ONE
      }
      return Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Composition {operation: operation, written: move written})
    }
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// Reads the single type a tuple element shape answers with.
fn singleMemberShapeType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: shapedAnswer} => match & shapedAnswer.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let fields = Vector.asSlice<Shared<Type>>(&types)
        if fields.length == usize.ONE {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[usize.ZERO]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

// The arity rejection for a written call against the signature it selected, if any.
effect fn writtenCallArityRejection(
  resolver: &mut Resolver,
  module: &ModuleId,
  syntax: &CallSyntax,
  signature: &Shared<Result<Answer, NoRejection>>,
) -> Option<RejectionCode>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let writtenCall = run typeNode(&mut resolver.*, module, syntax.id)
  let callSyntax = match move writtenCall {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Option.none<RejectionCode>()
    }
  }
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(callSyntax.header) {
    let arguments = input.arguments
    let parameters = Shared.with<Result<Answer, NoRejection>, usize>(
      signature, signatureParameterCount,
    )
    return callArityRejection(parameters, CallArguments.length(arguments))
  }
  return Option.none<RejectionCode>()
}

// Resolves a `Type.member(...)` call whose inherent lookup selected `selectedTarget`.
effect fn inherentSelectedCallTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  qualifier: &SelectedDeclaration,
  qualifierModule: &ModuleId,
  selectedTarget: CallTarget,
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut target = move selectedTarget
  let targetIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(&target.declaration))
  let targetOrdinal = run ordinalOfIdentity(
    &mut resolver.*, qualifierModule, &targetIdentity)
  let ordinal = match move targetOrdinal {
    Option<usize>.Some {value: selectedOrdinal} => selectedOrdinal
    Option<usize>.None => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, memberSpan),
      )
    }
  }
  let shape = run writtenCallArityRejection(&mut resolver.*, module, syntax, &target.signature)
  if let Option<RejectionCode>.Some {value: reason} = move shape {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(
      run reject(&resolver.*, module, reason, span),
    )
  }
  let prefix = run resolveCallPrefix(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    module, qualifierModule, ordinal, &target.signature, syntax.generics, scope, constraints,
  )
  target.explicitSyntax = syntax.generics.present
  let written = match move prefix {
    Result<CallPrefix, Shared<Rejection>>.Success {value: prefixArguments} => move prefixArguments
    Result<CallPrefix, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  target.explicit = move written.arguments
  target.explicitSlots = move written.slots
  target.prefixOwner = move written.owner
  target.prefixLifetimes = written.lifetimes
  return Result.succeed<ResolvedTarget, Shared<Rejection>>(
    ResolvedTarget.Function {target: move target},
  )
}

// A service operation call target. The operation keeps its own signature; the service's binders
// are supplied by the written qualifier application, and the provider is not an argument.
effect fn serviceOperationTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  qualifier: &SelectedDeclaration,
  qualifierModule: &ModuleId,
  operation: usize,
  applied: Option<Shared<Type>>,
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Operations, module: qualifier.module, name: usize.ZERO, declaration: qualifier.ordinal,
    member: usize.ZERO, external: false,
  }, memberSpan)
  let refused = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&listed, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value)
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: qualifier.module, name: usize.ZERO, declaration: operation,
    member: usize.ZERO, external: false,
  }, memberSpan)
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&signature, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value)
  }
  // The bootstrap dispatches an operation that takes its service's `Self` as an operand on that
  // operand's conformance. Native serves a service operation from the run site's row and has no
  // operand-dispatched lane yet, so such a call is deferred rather than mistyped.
  if run selfOperandOperation(&mut resolver.*, qualifierModule, qualifier.ordinal, &signature) {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let shape = run writtenCallArityRejection(&mut resolver.*, module, syntax, &signature)
  if let Option<RejectionCode>.Some {value: reason} = move shape {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, reason, span))
  }
  let prefix = run resolveCallPrefix(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    module, qualifierModule, operation, &signature, syntax.generics, scope, constraints)
  let written = match move prefix {
    Result<CallPrefix, Shared<Rejection>>.Success {value} => move value
    Result<CallPrefix, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, qualifierModule, operation)
  let declaration = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan))
    }
  }
  let mut scopeArguments = Vector.make<Argument>()
  let mut inferOwner = true
  if let Option<Shared<Type>>.Some {value: serviceType} = &applied {
    scopeArguments = run typeApplicationArguments(&serviceType)
    inferOwner = false
  }
  return Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.Function {target: CallTarget {
    foreign: false, declaration: move declaration, isPublic: true, signature: move signature,
    explicit: move written.arguments, explicitSlots: move written.slots, prefixOwner: move written.owner, prefixLifetimes: written.lifetimes, scopeArguments: move scopeArguments,
    inferOwner: inferOwner, explicitSyntax: syntax.generics.present,
  }})
}

// Whether a service operation's parameters mention the service's implicit `Self` provider, which
// is bound after the service's written binders.
effect fn selfOperandOperation(resolver: &mut Resolver, serviceModule: &ModuleId, serviceOrdinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>) -> bool ! Cycle | OutOfMemoryError ? &mut Allocator {
  let identity = match move run declarationAt(&mut resolver.*, serviceModule, serviceOrdinal) {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => { return false }
  }
  let written = match move run templateBinders(&mut resolver.*, serviceModule, serviceOrdinal) {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => Vector.length<Binder>(&value)
    Result<Vector<Binder>, Shared<Rejection>>.Failure {..} => { return false }
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move parameter {
      let mut types = Vector.make<usize>()
      let mut lifetimes = Vector.make<usize>()
      let mut rows = Vector.make<usize>()
      run Type.collectOwned(&value, &identity, &mut types, &mut lifetimes, &mut rows)
      if containsOrdinal(&types, written) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Resolves the authored owner application of a qualifier, if any. Its arguments belong to the
// qualifier, independently of call-site generics.
effect fn qualifierApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  application: HirRef,
  scope: &[Binder],
  constraints: &[Constraint],
) -> Result<Option<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if !application.present {
    return Result.succeed<Option<Shared<Type>>, Shared<Rejection>>(Option.none<Shared<Type>>())
  }
  let mut elision = LifetimeElision {
    owner: Option.none<DeclarationId>(), nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option.none<Shared<Lifetime>>(), generated: Vector.make<Shared<Lifetime>>(),
    invocation: false, nested: false, renumber: Vector.make<usize>(), staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(), assumptions: Option.some<Vector<Constraint>>(run copyConstraints(constraints)),
  }
  let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, application.id, scope, &mut elision)
  return match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => Result.succeed<
      Option<Shared<Type>>,
      Shared<Rejection>,
    >(Option.some<Shared<Type>>(move value))
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result.failResult<
      Option<Shared<Type>>,
      Shared<Rejection>,
    >(move error)
  }
}

// Resolves `Namespace.member(...)` when `Namespace` names a source or imported declaration. Only a
// nominal type can own the member; anything else is not callable.
effect fn qualifiedNominalCallTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  namespaceName: &[u8],
  member: &[u8],
  application: HirRef,
  subjectSpan: Span,
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let chosen = run selectDeclaration(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
    namespaceName, false, subjectSpan, RejectionCode.NotCallable,
  )
  let qualifier = match move chosen {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  let qualifierModule = run resolvedModule(&resolver.*, qualifier.module)
  let written = run header(&mut resolver.*, &qualifierModule, qualifier.ordinal)
  let mut nominal = false
  let mut isService = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    isService = match value.header { Node.ServiceHeader {..} => true _ => false }
    if syntax.pipeline {
      if let Node.InterfaceHeader {..} = value.header {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.PipelineInterfaceUnavailable, span))
      }
    }
    nominal = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.UnionHeader {..} => true
      Node.EnumHeader {..} => true
      Node.ServiceHeader {..} => true
      _ => false
    }
  }
  if !nominal {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
    )
  }
  let applied = run qualifierApplication(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, application, scope, constraints,
  )
  let appliedType = match move applied {
    Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => value
    Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  // `Svc.op(args)` constructs the operation's Effect; its provider comes from the run site's row.
  if isService {
    let lookup = run memberOrdinal(&mut resolver.*, &qualifierModule, qualifier.ordinal, member)
    if let Option<usize>.Some {value: operation} = move lookup.ordinal {
      let applied = match &appliedType {
        Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      return run serviceOperationTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax,
        scope, constraints, &qualifier, &qualifierModule, operation, move applied, memberSpan, span)
    }
  }
  let identity = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Identity,
      module: qualifier.module,
      name: usize.ZERO,
      declaration: qualifier.ordinal,
      member: usize.ZERO,
      external: false,
    },
    subjectSpan,
  )
  let mut provider = Shared.with<Result<Answer, NoRejection>, TypeSelection>(
    &identity,
    selectedType,
  )
  if let Option<Shared<Type>>.Some {value} = move appliedType {
    provider.resolved = Option.some<Shared<Type>>(move value)
  }
  if let Option<Shared<Rejection>>.Some {value} = move provider.rejected {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value)
  }
  let ownerType = match move provider.resolved {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
      )
    }
  }
  let mut request = Request.make()
  let found = run selectInherentReceiverCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request,
    &mut dependencies.*,
    true,
    &ownerType,
    member,
    !application.present,
    false,
    module,
    memberSpan,
  )
  let choice = match move found {
    Result<InherentCallChoice, Shared<Rejection>>.Success {value} => value
    Result<InherentCallChoice, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  return match move choice {
    InherentCallChoice.Selected {target: selectedTarget, ..} => run inherentSelectedCallTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax, scope, constraints,
      &qualifier, &qualifierModule, move selectedTarget, memberSpan, span,
    )
    InherentCallChoice.Claimed => Result.failResult<ResolvedTarget, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan),
    )
    InherentCallChoice.Missing => Result.failResult<ResolvedTarget, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.UnknownMember, memberSpan),
    )
  }
}

// Resolves `Intrinsic.member(...)` against the sealed intrinsic catalog.
effect fn intrinsicCallTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  syntax: &CallSyntax,
  scope: &[Binder],
  member: &[u8],
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  // Composition intrinsics build exact Effects that a run site expands (Effect note D4).
  let mut composition = Option.none<Composition>()
  if same(member, b"catchFailure") { composition = Option.some<Composition>(Composition.CatchFailure) }
  if same(member, b"finalizeEffect") { composition = Option.some<Composition>(Composition.Finalize) }
  if same(member, b"finalizeEffectNonParking") { composition = Option.some<Composition>(Composition.FinalizeNonParking) }
  if same(member, b"useReleaseNonParking") { composition = Option.some<Composition>(Composition.UseRelease) }
  if same(member, b"bindRequirement") { composition = Option.some<Composition>(Composition.BindShared) }
  if same(member, b"bindRequirementMut") { composition = Option.some<Composition>(Composition.BindExclusive) }
  if same(member, b"bindRequirementOwned") { composition = Option.some<Composition>(Composition.BindOwned) }
  if same(member, b"observeDiagnostics") { composition = Option.some<Composition>(Composition.Observe) }
  if same(member, b"suspendEffect") { composition = Option.some<Composition>(Composition.Suspend) }
  if let Option<Composition>.Some {value: operation} = move composition {
    return run compositionTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal,
      operation, syntax.generics, scope, span)
  }
  if let Option<StorageOperation>.Some {value: operation} = move StorageOperation.lookup(member) {
    return run storageTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, operation,
      syntax.generics, scope, span)
  }
  return match move intrinsicLookup(member) {
    Option<IntrinsicMember>.Some {value} => {
      if intrinsicTypeArity(value) != usize.ZERO {
        return run typedIntrinsicTarget(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, value,
          syntax.generics, span, scope,
        )
      }
      if syntax.generics.present {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
      return Result.succeed<ResolvedTarget, Shared<Rejection>>(
        ResolvedTarget.Intrinsic {member: value, typeArguments: Vector.make<Shared<Type>>()},
      )
    }
    Option<IntrinsicMember>.None => {
      let mut code = RejectionCode.UnknownMember
      if intrinsicRuntimeMember(member) {
        code = RejectionCode.IntrinsicUnavailable
      }
      // External parking belongs to the Execution stage (Effect note D6).
      if same(member, b"park") {
        code = RejectionCode.SuspensionUnavailable
      }
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, code, memberSpan),
      )
    }
  }
}

// Resolves one element type of a tuple constructor from its member shape.
effect fn tupleElementType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  target: &SelectedDeclaration,
  application: usize,
  index: usize,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let shape = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    Key {
      family: Family.MemberShape,
      module: target.module,
      name: application,
      declaration: target.ordinal,
      member: index,
      external: false,
    }, span,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &shape, answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
  }
  let field = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &shape, singleMemberShapeType,
  )
  if let Option<Shared<Type>>.Some {value: ty} = move field {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move ty)
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

// Resolves a tuple declaration used as a constructor call.
effect fn callTupleTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  target: &SelectedDeclaration,
  elements: Range,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut elision = LifetimeElision {
    owner: Option.none<DeclarationId>(),
    nextOrdinal: usize.ZERO,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let mut applicationSyntax = Option.none<HirId>()
  if syntax.generics.present {
    applicationSyntax = Option.some<HirId>(syntax.generics.id)
  }
  let applied = run declarationType(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, target.module, target.ordinal,
    module, span, move applicationSyntax,
    scope, &mut elision,
  )
  let provider = match move applied {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => ty
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  let application = run internApplication(&mut resolver.*, &provider)
  let mut fields = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < elements.length {
    let field = run tupleElementType(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, target, application, at, span,
    )
    match move field {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
        run Vector.append<Shared<Type>>(&mut fields, move ty)
      }
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<ResolvedTarget, Shared<Rejection>>(
    ResolvedTarget.Tuple {ty: move provider, elements: move fields},
  )
}

// Resolves a package parameter used as a call. Only its schema errors are reportable today.
effect fn callPackageParameterTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  syntax: &CallSyntax,
  target: &SelectedDeclaration,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let schema = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    Key {
      family: Family.ParameterSchema,
      module: target.module,
      name: usize.ZERO,
      declaration: target.ordinal,
      member: usize.ZERO,
      external: false,
    },
    span,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &schema, answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(move diagnostic)
  }
  let written = run typeNode(&mut resolver.*, module, syntax.id)
  if let Option<HeaderSyntax>.Some {value: expression} = move written {
    if let Option<CallInput>.Some {..} = move CallInput.ofNode(expression.header) {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
  }
  // A schema is not its final profile value: defaults, bindings and validation still need
  // the package-value execution lane. Preserve schema errors before deferring that lane.
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.ProfileInputUnavailable, span),
  )
}

// Resolves a constant used as a call. A constant is only callable when its checked type resolves.
effect fn callConstantTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  targetModule: &ModuleId,
  target: &SelectedDeclaration,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let checked = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    Key {
      family: Family.Constant,
      module: target.module,
      name: usize.ZERO,
      declaration: target.ordinal,
      member: usize.ZERO,
      external: false,
    },
    span,
  )
  let constantType = Shared.with<Result<Answer, NoRejection>, TypeSelection>(&checked, selectedType)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move constantType.rejected {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(move diagnostic)
  }
  if let Option<Shared<Type>>.Some {value: ty} = move constantType.resolved {
    let identity = run declarationAt(&mut resolver.*, targetModule, target.ordinal)
    if let Option<DeclarationId>.Some {value: declaration} = move identity {
      return Result.succeed<ResolvedTarget, Shared<Rejection>>(
        ResolvedTarget.Constant {declaration: move declaration, ty: move ty},
      )
    }
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

// The declared type of one imported C static. Its scalar or pointer type is read by copy; an
// exported definition, a non-C ABI and linkage properties stay deferred.
effect fn foreignStaticType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  ordinal: usize,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let written = run foreignHeader(&mut resolver.*, &module, ordinal)
  let deferred = match &written.gap {
    Option<GapCode>.Some {..} => true
    Option<GapCode>.None => false
  }
  if written.exported || deferred {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, &module, RejectionCode.ForeignStaticUnavailable, span),
    )
  }
  let mut annotation = Option.none<HirId>()
  let found = run header(&mut resolver.*, &module, ordinal)
  if let Option<HeaderSyntax>.Some {value} = move found {
    if let Node.StaticHeader {annotation: declared, ..} = value.header { annotation = Option.some<HirId>(declared) }
  }
  let typeSyntax = match move annotation {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, &module, RejectionCode.NotCallable, span))
    }
  }
  let noBinders = Vector.make<Binder>()
  // Foreign storage lives for the whole program, so an omitted reference lifetime is `'static`.
  let mut elision = LifetimeElision {
    owner: Option.none<DeclarationId>(),
    nextOrdinal: usize.ZERO,
    output: true,
    resultDefault: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Static)),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, typeSyntax,
    Vector.asSlice<Binder>(&noBinders), &mut elision)
  let ty = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let admitted = Shared.with<Type, bool>(&ty, foreignStaticAdmitted)
  if !admitted {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, &module, RejectionCode.ForeignType, span))
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(move ty)
}

// A foreign static holds one immediate C scalar or pointer; it is never unit.
fn foreignStaticAdmitted(value: &Type) -> bool {
  return match &value.* {
    Type.Unit => false
    _ => CAbi.admit(value)
  }
}

// Resolves an imported C static used by name as a value. The use site anchors any deferral.
effect fn foreignStaticTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  targetModule: &ModuleId,
  target: &SelectedDeclaration,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let selected = run foreignStaticType(&mut resolver.*, &mut owner.*, &mut dependencies.*, target.module, target.ordinal, span)
  let ty = match move selected {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      let code = Shared.with<Rejection, RejectionCode>(&error, fn(rejection: &Rejection) -> RejectionCode {
        return rejection.code
      })
      if code == RejectionCode.ForeignStaticUnavailable || code == RejectionCode.ForeignType {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, code, span))
      }
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, targetModule, target.ordinal)
  if let Option<DeclarationId>.Some {value: declaration} = move identity {
    return Result.succeed<ResolvedTarget, Shared<Rejection>>(ResolvedTarget.ForeignStatic {declaration: move declaration, ty: move ty})
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotCallable, span))
}

// Resolves a source or foreign function used as a call, including its written generic prefix.
effect fn callFunctionTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  targetModule: &ModuleId,
  target: &SelectedDeclaration,
  foreign: bool,
  isPublic: bool,
  bareValue: bool,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  // A C function has no Silk callable representation (bootstrap SEM0189).
  if bareValue && foreign {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.ForeignFunctionNotFirstClass, span),
    )
  }
  let signatureKey = Key {
    family: Family.Signature,
    module: target.module,
    name: usize.ZERO,
    declaration: target.ordinal,
    member: usize.ZERO,
    external: false,
  }
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    signatureKey,
    span,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(move diagnostic)
  }
  let prefix = run resolveCallPrefix(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    targetModule,
    target.ordinal,
    &signature,
    syntax.generics,
    scope,
    constraints,
  )
  let explicit = match move prefix {
    Result<CallPrefix, Shared<Rejection>>.Success {value: resolvedArguments} => move resolvedArguments
    Result<CallPrefix, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, targetModule, target.ordinal)
  if let Option<DeclarationId>.Some {value: declaration} = move identity {
    return Result.succeed<ResolvedTarget, Shared<Rejection>>(
      ResolvedTarget.Function {
        target: CallTarget {
          foreign: foreign,
          declaration: move declaration,
          isPublic: isPublic,
          signature: move signature,
          explicit: move explicit.arguments,
          explicitSlots: move explicit.slots, prefixOwner: move explicit.owner, prefixLifetimes: explicit.lifetimes,
          scopeArguments: Vector.make<Argument>(),
          inferOwner: false,
        explicitSyntax: syntax.generics.present,
        },
      },
    )
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

effect fn callTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = syntax.span
  let mut selected = Result.failResult<SelectedDeclaration, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
  let mut bareValue = syntax.value
  match & syntax.reference {
    CallReference.Named {name} => {
      selected = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.NotCallable,
      )
    }
    CallReference.Qualified {namespace, member, subjectSpan, memberSpan, application} => {
      let namespaceName = Bytes.asSlice(&namespace)
      // The unbound qualifier names the sealed namespace, never an import or source declaration.
      if same(namespaceName, b"Intrinsic") {
        if application.present {
          return Result.failResult<ResolvedTarget, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.NotType, subjectSpan))
        }
        return run intrinsicCallTarget(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, syntax, scope,
          Bytes.asSlice(&member), memberSpan, span,
        )
      }
      let nameKey = Key {
        family: Family.Name,
        module: moduleOrdinal,
        name: run internName(&mut resolver.*, namespaceName),
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      }
      let observed = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        nameKey,
        subjectSpan,
      )
      drop observed
      let namespaceBindingSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespaceName, false)
      let namespaceBinding = match move namespaceBindingSelection {
        Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
        Result<Selection, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
        }
      }
      if namespaceBinding.count == usize.ZERO {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.UnknownName, subjectSpan),
        )
      }
      if namespaceBinding.count > usize.ONE {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Collision, subjectSpan),
        )
      }
      if namespaceBinding.kind == CandidateKind.Declaration || namespaceBinding.kind == CandidateKind.ImportMember {
        return run qualifiedNominalCallTarget(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax,
          scope, constraints, namespaceName, Bytes.asSlice(&member), application, subjectSpan, memberSpan, span,
        )
      }
      if namespaceBinding.kind != CandidateKind.ImportModule {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
        )
      }
      if application.present {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.NotType, subjectSpan))
      }
      let importKey = Key {
        family: Family.Import,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: namespaceBinding.declaration,
        member: usize.MAX,
        external: false,
      }
      let imported = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        importKey,
        subjectSpan,
      )
      let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
        &imported,
        selectedImport,
      )
      if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value)
      }
      if let Option<usize>.Some {value: targetModule} = move binding.module {
        selected = run selectDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          targetModule,
          module,
          Bytes.asSlice(&member),
          true,
          memberSpan,
          RejectionCode.NotCallable,
        )
      }
    }
    CallReference.Unbound {name} => {
      bareValue = true
      selected = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.Unsupported,
      )
    }
    CallReference.NonCallable => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
    CallReference.CallableValue => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    CallReference.Unsupported => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let target = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  let targetModule = run resolvedModule(&resolver.*, target.module)
  let written = run header(&mut resolver.*, &targetModule, target.ordinal)
  let declared = match move written {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
  }
  if let Node.StaticHeader {..} = declared.header {
    // This header is a foreign or exported static, both with required linkage.
    if bareValue {
      return run foreignStaticTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &targetModule, &target, span)
    }
    return Result.failResult<ResolvedTarget, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.NotCallable, span),
    )
  }
  if let Node.PackageParameterHeader {..} = declared.header {
    return run callPackageParameterTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, syntax, &target, span,
    )
  }
  if let Node.TupleHeader {elements, ..} = declared.header {
    if bareValue {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    return run callTupleTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, syntax, scope, &target,
      elements, span,
    )
  }
  if let Node.ConstantHeader {..} = declared.header {
    return run callConstantTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &targetModule, &target, span,
    )
  }
  if let Node.FunctionHeader {isPublic, linkage, ..} = declared.header {
    return run callFunctionTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax, scope, constraints,
      &targetModule, &target, linkage.present, isPublic, bareValue, span,
    )
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

effect fn invalidExactRepresentation(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(resolver, module, RejectionCode.InvalidExactRepresentation, span),
  )
}

effect fn resolveNamedRepresentation(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  subject: HirId,
  span: Span,
  scope: &[Binder],
  assumptions: &Option<Vector<Constraint>>,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let source = run typeNode(&mut resolver.*, module, subject)
  let written = match move source {
    Option<HeaderSyntax>.Some {value} => move value
    Option<HeaderSyntax>.None => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
  }
  let mut selected = written.header
  let mut generics = HirRef.absent()
  if let Node.AppliedType {target, arguments} = selected {
    generics = HirRef.of(arguments)
    let named = run typeNode(&mut resolver.*, module, target)
    if let Option<HeaderSyntax>.Some {value: found} = move named {
      selected = found.header
    }
  }
  let mut namedPath = HirRef.absent()
  if let Node.NamedType {path: spelled, hasMode, ..} = selected {
    if !hasMode {
      namedPath = HirRef.of(spelled)
    }
  }
  if !namedPath.present {
    return run invalidExactRepresentation(&resolver.*, module, span)
  }
  let parsed = run path(&mut resolver.*, module, namedPath.id)
  if !parsed.valid {
    return run invalidExactRepresentation(&resolver.*, module, span)
  }
  let segments = Vector.asSlice<Bytes>(&parsed.segments)
  let mut reference = CallReference.Unsupported
  if segments.length == usize.ONE {
    reference = CallReference.Named {name: run Bytes.copy(Bytes.asSlice(&segments[usize.ZERO]))}
  }
  if segments.length == 2 {
    reference = CallReference.Qualified {
      namespace: run Bytes.copy(Bytes.asSlice(&segments[usize.ZERO])),
      member: run Bytes.copy(Bytes.asSlice(&segments[usize.ONE])),
      subjectSpan: parsed.span,
      memberSpan: parsed.span,
      application: HirRef.absent(),
    }
  }
  let syntax = CallSyntax {
    value: true,
    id: subject,
    span: span,
    reference: move reference,
    generics: generics,
    pipeline: false,
  }
  let mut constraints = Vector.make<Constraint>()
  if let Option<Vector<Constraint>>.Some {value} = &assumptions.* {
    constraints = run copyConstraints(Vector.asSlice<Constraint>(&value))
  }
  let found = run callTarget(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    module,
    moduleOrdinal,
    &syntax,
    scope,
    Vector.asSlice<Constraint>(&constraints),
  )
  let selectedTarget = match move found {
    Result<ResolvedTarget, Shared<Rejection>>.Success {value} => value
    Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  let target = match move selectedTarget {
    ResolvedTarget.Function {target} => target
    ResolvedTarget.Tuple {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Selected {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Constant {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.ForeignStatic {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Intrinsic {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Composition {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Storage {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
  }
  if target.prefixLifetimes != usize.ZERO {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span))
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(
    &target.signature,
    signatureBinderCount,
  )
  if Vector.length<Argument>(&target.explicit) != count {
    return run invalidExactRepresentation(&resolver.*, module, span)
  }
  if target.foreign {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.ForeignFunctionNotFirstClass, span))
  }
  if Shared.with<Result<Answer, NoRejection>, bool>(&target.signature, signatureIsEffect)
    || Shared.with<Result<Answer, NoRejection>, usize>(&target.signature, signatureStaticCount) != usize.ZERO
    || Shared.with<Result<Answer, NoRejection>, bool>(&target.signature, signatureIsStatic) {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let mut request = Request.make()
  let selectedApplication = run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, &target.declaration, &target.signature,
    run copyArguments(Vector.asSlice<Argument>(&target.explicit)), &target.scopeArguments, module, span)
  let application = match move selectedApplication {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  // typeof names one runtime-concrete construction, not an open generic template.
  if !Application.isRuntimeClosed(&application) {
    return run invalidExactRepresentation(&resolver.*, module, span)
  }
  let bindings = run Application.bindings(&application)
  let countBounds = Shared.with<Result<Answer, NoRejection>, usize>(&target.signature, signatureConstraintCount)
  let mut applied = Vector.make<Constraint>()
  let mut at = usize.ZERO
  while at < countBounds {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&target.signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut applied, run bindConstraint(&value, Vector.asSlice<Binding>(&bindings)))
    }
    at = at + usize.ONE
  }
  let refused = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &constraints,
    Vector.asSlice<Constraint>(&applied), module, span)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move value)
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(&target.signature, signatureParameterCount)
  let mut parameters = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < parameterCount {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&target.signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected {
      run Vector.append<Shared<Type>>(&mut parameters, run Type.applyBindings(&value, Vector.asSlice<Binding>(&bindings), true))
    } else { return run invalidExactRepresentation(&resolver.*, module, span) }
    at = at + usize.ONE
  }
  let result = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&target.signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => run Type.applyBindings(&value, Vector.asSlice<Binding>(&bindings), true)
    _ => { return run invalidExactRepresentation(&resolver.*, module, span) }
  }
  let contract = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared,
    isUnsafe: Shared.with<Result<Answer, NoRejection>, bool>(&target.signature, signatureUnsafe),
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&Vector.make<Shared<Lifetime>>()))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: Vector.make<Outlives>(), parameters: move parameters, result: move result})
  return Result.succeed<Shared<Type>, Shared<Rejection>>(
    run Type.callableValue(target.isPublic, run Shared.make<Application>(move application), move contract,
      Vector.make<Shared<Type>>(), Vector.make<CallableFieldInput>()))
}

fn isStaticIndex(slots: &[usize], at: usize) -> bool {
  let mut index = usize.ZERO
  while index < slots.length {
    if slots[index] == at { return true }
    index = index + usize.ONE
  }
  return false
}

// Calling shape is read from the same canonical signature retained as a semantic dependency.
fn signatureIsVariadic(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome { return signature.isVariadic }
  }
  return false
}

fn signatureIsStatic(answer: &Result<Answer, NoRejection>) -> bool {
  return match move signatureFacts(answer) {
    Option<SignatureFacts>.Some {value} => value.isStatic
    _ => false
  }
}

fn signatureStaticCount(answer: &Result<Answer, NoRejection>) -> usize {
  let facts = signatureFacts(answer)
  return match move facts {
    Option<SignatureFacts>.Some {value} => value.staticSlots
    Option<SignatureFacts>.None => usize.ZERO
  }
}

// The static values this body's selection pass recorded for one call.
fn staticArgumentsFact(calls: &[ResolvedCall], id: HirId) -> Option<Shared<Vector<StaticSlot>>> {
  let fact = selectedFact(calls, id)
  return match move fact {
    Option<SelectionFact>.Some {value: SelectionFact.StaticArguments {slots}} => Option.some<Shared<Vector<StaticSlot>>>(slots)
    _ => Option.none<Shared<Vector<StaticSlot>>>()
  }
}

fn staticSlotValue(slots: &Vector<StaticSlot>, ordinal: usize) -> Option<Shared<StaticData>> {
  let listed = Vector.asSlice<StaticSlot>(slots)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].ordinal == ordinal { return Option.some<Shared<StaticData>>(StaticValue.copy(&listed[at].value)) }
    at = at + usize.ONE
  }
  return Option.none<Shared<StaticData>>()
}

effect fn copySharedStaticSlots(slots: &Shared<Vector<StaticSlot>>) -> Vector<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Vector<StaticSlot>, usize>(slots, slotCount)
  let mut copied = Vector.make<StaticSlot>()
  let mut at = usize.ZERO
  while at < count {
    let slot = Shared.with<Vector<StaticSlot>, StaticSlot>(slots, fn(listed: &Vector<StaticSlot>) -> StaticSlot { return slotAt(listed, at) })
    run Vector.append<StaticSlot>(&mut copied, move slot)
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyStaticSlots(slots: &[StaticSlot]) -> Vector<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<StaticSlot>()
  let mut at = usize.ZERO
  while at < slots.length {
    run Vector.append<StaticSlot>(&mut copied, StaticSlot {ordinal: slots[at].ordinal, value: StaticValue.copy(&slots[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyTypes(types: &[Shared<Type>]) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < types.length {
    run Vector.append<Shared<Type>>(&mut copied, Shared.clone<Type>(&types[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyTupleTarget(ty: &Shared<Type>, elements: &Vector<Shared<Type>>) -> ResolvedTarget
! OutOfMemoryError ? &mut Allocator {
  return ResolvedTarget.Tuple {ty: Shared.clone<Type>(ty), elements: run copyTypes(Vector.asSlice<Shared<Type>>(elements))}
}

effect fn copyResolvedTarget(value: &ResolvedTarget) -> ResolvedTarget
! OutOfMemoryError ? &mut Allocator {
  return match & value.* {
    ResolvedTarget.Intrinsic {member, typeArguments} => ResolvedTarget.Intrinsic {
      member: member, typeArguments: run copyTypes(Vector.asSlice<Shared<Type>>(&typeArguments)),
    }
    ResolvedTarget.Selected {fact} => ResolvedTarget.Selected {fact: match & fact {
      SelectionFact.Embedded {value: embedded, ty: embeddedType} => SelectionFact.Embedded {
        value: StaticValue.copy(&embedded), ty: Shared.clone<Type>(&embeddedType),
      }
      SelectionFact.Condition {selected} => SelectionFact.Condition {selected: selected}
      SelectionFact.StaticFor {iterations} => SelectionFact.StaticFor {iterations: Shared.clone<Vector<IterationFacts>>(&iterations)}
      SelectionFact.StaticBinding {value: bound} => SelectionFact.StaticBinding {value: StaticValue.copy(&bound),
        }
      SelectionFact.StaticArguments {slots} => SelectionFact.StaticArguments {slots: Shared.clone<Vector<StaticSlot>>(&slots),
        }
    },
    }
    ResolvedTarget.Tuple {ty, elements} => run copyTupleTarget(&ty, &elements)
    ResolvedTarget.Composition {operation, written} => ResolvedTarget.Composition {operation: operation,
      written: run copyArguments(Vector.asSlice<Argument>(&written))}
    ResolvedTarget.Storage {operation, typeArguments} => ResolvedTarget.Storage {operation: operation,
      typeArguments: run copyTypes(Vector.asSlice<Shared<Type>>(&typeArguments))}
    ResolvedTarget.Constant {declaration, ty} => ResolvedTarget.Constant {
      declaration: run DeclarationId.copy(&declaration),
      ty: Shared.clone<Type>(&ty),
    }
    ResolvedTarget.ForeignStatic {declaration, ty} => ResolvedTarget.ForeignStatic {
      declaration: run DeclarationId.copy(&declaration),
      ty: Shared.clone<Type>(&ty),
    }
    ResolvedTarget.Function {target} => ResolvedTarget.Function {target: CallTarget {
      foreign: target.foreign,
      declaration: run DeclarationId.copy(&target.declaration),
      isPublic: target.isPublic,
      signature: Shared.clone<Result<Answer, NoRejection>>(&target.signature),
      explicit: run copyArguments(Vector.asSlice<Argument>(&target.explicit)),
      explicitSlots: run copyCallPrefixSlots(Vector.asSlice<CallPrefixSlot>(&target.explicitSlots)),
      prefixOwner: copyCallPrefixOwner(&target.prefixOwner), prefixLifetimes: target.prefixLifetimes,
      scopeArguments: run copyArguments(Vector.asSlice<Argument>(&target.scopeArguments)),
      inferOwner: target.inferOwner,
    explicitSyntax: target.explicitSyntax,
    }}
  }
}

fn indexOfResolvedCall(calls: &[ResolvedCall], id: HirId) -> Option<usize> {
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].id.index == id.index {
      return Option.some<usize>(at)
    }
    at = at + usize.ONE
  }
  return Option.none<usize>()
}

effect fn resolvedCall(calls: &[ResolvedCall], id: HirId) -> Option<
  Result<ResolvedTarget, Shared<Rejection>>,
> ! OutOfMemoryError ? &mut Allocator {
  let found = indexOfResolvedCall(calls, id)
  let at = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option.none<Result<ResolvedTarget, Shared<Rejection>>>()
    }
  }
  return match & calls[at].result {
    Result<ResolvedTarget, Shared<Rejection>>.Success {value} => Option.some<
      Result<ResolvedTarget, Shared<Rejection>>,
    >(Result.succeed<ResolvedTarget, Shared<Rejection>>(run copyResolvedTarget(&value)))
    Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Option.some<
      Result<ResolvedTarget, Shared<Rejection>>,
    >(Result.failResult<ResolvedTarget, Shared<Rejection>>(Shared.clone<Rejection>(&error)))
  }
}

// A written interface qualifier fixes the contract declaration. Its unique declared bound fixes
// the application and provider; without a bound, the leading operand supplies an open provider
// whose conformance must still be proved rather than assumed from a concrete caller.
struct BodyScope {
  binders: Vector<Binder>
  ownCount: usize
}

// Checked bodies retain lexical declaration owners; only backend realization supplies values.
effect fn bodyScope(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize, module: &ModuleId, ordinal: usize,
) -> Result<BodyScope, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let own = run templateBinders(&mut resolver.*, module, ordinal)
  let mut binders = match move own {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyScope, Shared<Rejection>>(move error) }
  }
  let ownCount = Vector.length<Binder>(&binders)
  let scope = run enclosingScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, ordinal)
  let enclosing = match move scope {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyScope, Shared<Rejection>>(move error) }
  }
  let visible = Vector.asSlice<Binder>(&enclosing)
  let refines = run refinesEnclosing(&mut resolver.*, module, ordinal)
  let mut at = usize.ZERO
  while at < ownCount {
    let restated = run restatedBinder(&binders, at, visible, refines)
    if let Option<Binder>.Some {value} = move restated { Vector.set<Binder>(&mut binders, at, move value) }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < visible.length {
    run Vector.append<Binder>(&mut binders, run copyBinder(&visible[at]))
    at = at + usize.ONE
  }
  return Result.succeed<BodyScope, Shared<Rejection>>(BodyScope {binders: move binders, ownCount: ownCount})
}

// Resolve the authored qualifier in the same lexical binder and constraint scope as its caller.
effect fn qualifiedInterfaceContract(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, caller: &DeclarationId, syntax: HirId, span: Span, constraints: &[Constraint],
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(caller))
  let found = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let ordinal = match move found {
    Option<usize>.Some {value} => value
    _ => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let scope = run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, ordinal)
  let scoped = match move scope {
    Result<BodyScope, Shared<Rejection>>.Success {value} => move value
    Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let mut elision = LifetimeElision {
    owner: Option.some<DeclarationId>(run DeclarationId.copy(caller)), nextOrdinal: scoped.ownCount, output: false,
    resultDefault: Option.none<Shared<Lifetime>>(), generated: Vector.make<Shared<Lifetime>>(),
    invocation: false, nested: false, renumber: Vector.make<usize>(), staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(), assumptions: Option.some<Vector<Constraint>>(run copyConstraints(constraints)),
  }
  return run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, syntax,
    Vector.asSlice<Binder>(&scoped.binders), &mut elision)
}

// Missing operation-owned inputs keep the selected operation in diagnostic evidence, so the
// backend can name this boundary without guessing from qualifier syntax or reading a body.
effect fn genericOperationRejection(module: &ModuleId, span: Span, operation: &DeclarationId) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut path = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut path, run Shared.make<DeclarationId>(run DeclarationId.copy(operation)))
  return run Shared.make<Rejection>(Rejection {
    code: RejectionCode.Unsupported, module: run ModuleId.copy(module), span: span,
    related: Option.none<RelatedSite>(), path: move path, expected: usize.ZERO, supplied: usize.ZERO,
    parameterName: Bytes.make(), expectedKind: GenericKind.Type, suppliedKind: GenericKind.Type,
    witness: Option.none<WitnessProblem>(), termination: TerminationStep.Peer,
    staticFailure: Option.none<StaticDiagnostic>(), specialization: Vector.make<Application>(),
  })
}

// INTF-006: an unapplied qualified call of a generic interface takes the one application the
// provider's visible conformances supply. A conformance head contributes when it matches the
// provider and that match fixes every one of its binders; distinct applications, or a head whose
// application the provider leaves open, make the call ambiguous. The expected result never selects.
effect fn inferredInterfaceApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  contractModule: usize,
  contractOrdinal: usize,
  provider: &Shared<Type>,
  module: &ModuleId,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let providerApplication = run internApplication(&mut resolver.*, provider)
  let bucket = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.ConformanceHeads,
      module: contractModule,
      name: providerApplication,
      declaration: contractOrdinal,
      member: usize.ZERO,
      external: false,
    },
    span,
    true,
  )
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&bucket, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
  let mut candidates = Vector.make<Shared<Type>>()
  let mut open = false
  let mut undecided = false
  let mut at = usize.ZERO
  while at < count {
    let listed = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &bucket,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return bucketAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move listed {
      let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(&head, headTerms)
      if let Option<HeadTerms>.Some {value: found} = move terms {
        let headOwner = run DeclarationId.copyShared(&found.declaration)
        let mut variables = Vector.make<Shared<DeclarationId>>()
        run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(&found.declaration))
        let mut bindings = Vector.make<Binding>()
        let matched = run Type.unify(&found.provider, provider, Vector.asSlice<Shared<DeclarationId>>(&variables),
          Comparison.Exact, &mut bindings)
        if exactHeadUndetermined(&matched) {
          undecided = true
        }
        if exactHeadMatched(&matched) {
          let binderCount = Shared.with<ImplementationHead, usize>(&head, headBinderCount)
          let lent = Vector.make<Shared<Lifetime>>()
          let fixed = run matchedArguments(binderCount, &headOwner, Vector.asSlice<Binding>(&bindings),
            Vector.asSlice<Shared<Lifetime>>(&lent))
          if let Option<Vector<Argument>>.Some {value: arguments} = move fixed {
            drop arguments
            let candidate = run Type.applyBindings(&found.contract, Vector.asSlice<Binding>(&bindings), true)
            let known = Vector.asSlice<Shared<Type>>(&candidates)
            let mut repeated = false
            let mut seen = usize.ZERO
            while seen < known.length {
              if run Type.equalsShared(&known[seen], &candidate) {
                repeated = true
              }
              seen = seen + usize.ONE
            }
            if !repeated {
              run Vector.append<Shared<Type>>(&mut candidates, move candidate)
            }
          } else {
            open = true
          }
        }
      }
    }
    at = at + usize.ONE
  }
  if undecided {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let distinct = Vector.length<Shared<Type>>(&candidates)
  if open || distinct > usize.ONE {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.AmbiguousConformanceMethod, span),
    )
  }
  if distinct == usize.ZERO {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.MissingConformance, span),
    )
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(Vector.remove<Shared<Type>>(&mut candidates, usize.ZERO))
}

effect fn checkQualifiedInterfaceCall<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  operationGenerics: HirRef,
  arguments: CallArguments,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  qualifier: &QualifiedBodyName,
  selected: SelectedDeclaration,
  isPublic: bool,
  unsafeAllowed: bool,
  callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let contractModule = run resolvedModule(&resolver.*, selected.module)
  let identity = run declarationAt(&mut resolver.*, &contractModule, selected.ordinal)
  let interfaceId = match move identity {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut explicitContract = Option.none<Shared<Type>>()
  if let Option<HirId>.Some {value: syntax} = &qualifier.application {
    let resolved = run qualifiedInterfaceContract(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, caller, syntax, qualifier.subjectSpan, constraints)
    explicitContract = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => Option.some<Shared<Type>>(move value)
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
  }
  let mut chosenContract = Option.none<Shared<Type>>()
  let mut chosenProvider = Option.none<Shared<Type>>()
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Conforms {provider, contract} = &constraints[at] {
      let matches = Shared.with<Type, bool>(
        &contract,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, &interfaceId)
            _ => false
          }
        },
      )
      let mut selectedGoal = matches
      if let Option<Shared<Type>>.Some {value: requested} = &explicitContract {
        if selectedGoal { selectedGoal = run Type.equalsShared(&contract, &requested) }
      }
      if selectedGoal {
        if let Option<Shared<Type>>.Some {value: unused} = &chosenContract {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        chosenContract = Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
        chosenProvider = Option.some<Shared<Type>>(Shared.clone<Type>(&provider))
      }
    }
    at = at + usize.ONE
  }
  let mut firstArgument = Option.none<BodyNodeId>()
  let needsInference = match & chosenContract {
    Option<Shared<Type>>.Some {..} => false
    Option<Shared<Type>>.None => true
  }
  if needsInference {
    let mut generic = false
    if let Option<Shared<Type>>.None = &explicitContract {
      let template = run templateBinders(&mut resolver.*, &contractModule, selected.ordinal)
      let binders = match move template {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      generic = Vector.length<Binder>(&binders) > usize.ZERO
    }
    if CallArguments.length(arguments) == usize.ZERO {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let firstId = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
    let checked = run checkExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut statementScope.*,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      firstId,
      &Option.none<Shared<Type>>(),
      constraints,
      contractBody,
      false,
      unsafeAllowed,
    )
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    let inferred = match & Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    firstArgument = Option.some<BodyNodeId>(node)
    let provider = Shared.with<Type, Option<Shared<Type>>>(
      &inferred,
      fn(value: &Type) -> Option<Shared<Type>> {
        return match & value.* {
          Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
          _ => Option.none<Shared<Type>>()
        }
      },
    )
    let operand = match move provider {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => move inferred
    }
    if generic {
      // INTF-006: the operand's provider selects the one application its conformances supply.
      let application = run inferredInterfaceApplication(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, selected.module, selected.ordinal, &operand, module, span)
      chosenContract = match move application {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => Option.some<Shared<Type>>(move value)
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    } else {
      chosenContract = match &explicitContract {
        Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
        Option<Shared<Type>>.None => Option.some<Shared<Type>>(run Shared.make<Type>(Type.Nominal {
          declaration: run DeclarationId.copy(&interfaceId), isPublic: isPublic, arguments: Vector.make<Argument>(),
        }))
      }
    }
    chosenProvider = Option.some<Shared<Type>>(move operand)
  }
  let contract = match move chosenContract {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let provider = match move chosenProvider {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let listed = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: selected.module,
      name: usize.ZERO,
      declaration: selected.ordinal,
      member: usize.ZERO,
      external: false,
    },
    span,
    true,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, operationCount)
  let mut operation = Option.none<DeclarationId>()
  at = usize.ZERO
  while at < count {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operationAt(answer, at)
      },
    )
    if let Option<Shared<DeclarationId>>.Some {value: candidate} = move found {
      let named = Shared.with<DeclarationId, bool>(
        &candidate,
        fn(value: &DeclarationId) -> bool {
          return DeclarationId.named(value, Bytes.asSlice(&qualifier.member))
        },
      )
      if named {
        let ordinal = run ordinalOfIdentity(&mut resolver.*, &contractModule, &candidate)
        if let Option<usize>.Some {value: position} = move ordinal {
          operation = run declarationAt(&mut resolver.*, &contractModule, position)
        }
        break
      }
    }
    at = at + usize.ONE
  }
  let operationId = match move operation {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, span)
    }
  }
  let selectedCall = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &contract,
    &provider,
    &operationId,
    constraints,
    module,
    span,
  )
  let selectedOperation = match move selectedCall {
    Result<OperationCall, Shared<Rejection>>.Success {value} => value
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let OperationCall {operation: chosenOperation, implementation, signature, proof, receiver: _} = move selectedOperation
  drop proof
  // Static parameters reach a callee only through a direct call's selected static arguments; an
  // operation call cannot supply them yet, so it is an explicit gap rather than a dropped value.
  if Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureStaticCount) > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signature,
    signatureParameterCount,
  )
  if CallArguments.length(arguments) > parameterCount {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if CallArguments.length(arguments) == usize.ZERO && parameterCount > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.RedundantCall, span)
  }
  if CallArguments.length(arguments) < parameterCount {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  // Calling an `effect fn` operation constructs the Effect its applied contract promises
  // (INTF-005); the enclosing `run` executes it as one call of the selected witness.
  let isEffect = Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureIsEffect)
  if operationGenerics.present || Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureNonLifetimeBinderCount) > usize.ZERO {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(run genericOperationRejection(module, span, &chosenOperation))
  }
  let unsafeCall = Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureUnsafe)
  if unsafeCall && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if callAcknowledged && !unsafeCall {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(
    &mut variables,
    run Shared.make<DeclarationId>(run DeclarationId.copy(&chosenOperation)),
  )
  let mut inferred = Vector.make<Binding>()
  let mut typedArguments = Vector.make<BodyNodeId>()
  at = usize.ZERO
  while at < CallArguments.length(arguments) {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let mut already = false
    let mut argumentNode = BodyNodeId {index: usize.ZERO}
    if at == usize.ZERO {
      if let Option<BodyNodeId>.Some {value} = &firstArgument {
        already = true
        argumentNode = BodyNodeId {index: value.index}
      }
    }
    if !already {
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
      let context = run operationArgumentContext(&resolver.source, cursor, argumentId, &parameterType,
        &chosenOperation, caller)
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        argumentId,
        &context,
        constraints,
        contractBody,
        false,
        unsafeAllowed,
      )
      argumentNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    }
    let slicedArgument = run sliceArgument(&mut nodes.*, argumentNode, &parameterType)
    let adaptedArgument = run unionArgument(&mut nodes.*, slicedArgument, &parameterType)
    let argumentType = match & Vector.asSlice<BodyNode>(&nodes.*)[adaptedArgument.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let failed = run matchCallArgument(
      &resolver.*,
      module,
      span,
      &parameterType,
      &argumentType,
      Vector.asSlice<Shared<DeclarationId>>(&variables),
      &mut inferred, constraints)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move diagnostic)
    }
    run Vector.append<BodyNodeId>(&mut typedArguments, adaptedArgument)
    at = at + usize.ONE
  }
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let rawResult = match move result {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut resultType = run Type.applyBindings(&rawResult, Vector.asSlice<Binding>(&inferred), true)
  if !contractBody && !Shared.with<Type, bool>(&resultType, runtimeType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  if Shared.with<Type, bool>(&resultType, rawCallableType) {
    // A callable success would need the witness's original environment through its Effect.
    if isEffect {
      return run bodyRejection(&resolver.*, module, RejectionCode.InterfaceEffectUnavailable, span)
    }
    let recipe = run callableWitnessResult(caller, &chosenOperation, &contract, &provider, &resultType, &signature,
      Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyNodeId>(&typedArguments), Vector.asSlice<Binding>(&inferred))
    resultType = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &recipe, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
  }
  if isEffect {
    // The applied contract's channels bound every conforming witness (EFF-009); the call keeps
    // them even when the selected witness declares smaller ones.
    let declaredFailure = run signatureFailure(&signature)
    let declaredRequirements = run signatureRequirements(&signature)
    let constructed = run constructEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
      Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyNodeId>(&typedArguments), move resultType,
      run Type.applyBindings(&declaredFailure, Vector.asSlice<Binding>(&inferred), true),
      run Row.applyBindings(&declaredRequirements, Vector.asSlice<Binding>(&inferred), true),
      constraints, expression.index, span)
    let built = match move constructed {
      Result<EffectConstruction, Shared<Rejection>>.Success {value} => value
      Result<EffectConstruction, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    let EffectConstruction {contract: constructedContract, captures, fieldInputs} = move built
    drop captures
    drop fieldInputs
    resultType = move constructedContract
  }
  run Vector.append<SignatureDependency>(
    &mut signatures.*,
    SignatureDependency {declaration: run DeclarationId.copy(&chosenOperation)},
  )
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {
        ty: move resultType,
        form: BodyExpression.InterfaceCall {
          contract: move contract,
          provider: move provider,
          operation: move chosenOperation,
          bindings: run Shared.make<Vector<Binding>>(move inferred),
          implementation: move implementation,
          receiverPass: Option.none<BodyReceiverPass>(),
          isEffect: isEffect,
          arguments: move typedArguments,
        },
      },
    },
  )
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, span)
}

effect fn callableWitnessResult(caller: &DeclarationId, operation: &DeclarationId, contract: &Shared<Type>,
  provider: &Shared<Type>, result: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  nodes: &[BodyNode], operands: &[BodyNodeId], assignments: &[Binding])
  -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let mut bindings = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < assignments.length {
    run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&assignments[at].declaration),
      ordinal: assignments[at].ordinal, value: Argument.copy(&assignments[at].value)})
    at = at + usize.ONE
  }
  let mut arguments = Vector.make<Shared<Type>>()
  let mut loans = Vector.make<WitnessLoan>()
  at = usize.ZERO
  while at < operands.length {
    let node = &nodes[operands[at].index]
    if let BodyNodeKind.Expression {ty, ..} = &node.kind {
      run Vector.append<Shared<Type>>(&mut arguments, Shared.clone<Type>(&ty))
    }
    // Descriptor operands must keep their shape through the header witness. They cannot use
    // owned-value borrowing, so their existing region needs no extra fresh transport slot.
    let publicOperand = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    let mut lent = true
    if let Option<Shared<Type>>.Some {value} = move publicOperand {
      lent = Shared.with<Type, usize>(&value, operandShape) == usize.ZERO
    }
    let mut loan = Option.none<Shared<Lifetime>>()
    if lent { loan = Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Local {
      declaration: run DeclarationId.copy(caller), ordinal: node.origin.syntax.index})) }
    run Vector.append<WitnessLoan>(&mut loans, WitnessLoan {region: move loan})
    at = at + usize.ONE
  }
  return run Shared.make<Type>(Type.CallableWitnessResult {witness: run Shared.make<WitnessRecipe>(WitnessRecipe {
    operation: run Shared.make<DeclarationId>(run DeclarationId.copy(operation)),
    contract: Shared.clone<Type>(contract), provider: Shared.clone<Type>(provider), result: Shared.clone<Type>(result),
    bindings: run Shared.make<Vector<Binding>>(move bindings), arguments: run Shared.make<Vector<Shared<Type>>>(move arguments),
    loans: run Shared.make<Vector<WitnessLoan>>(move loans),
  })})
}

fn bodyExpressionType(nodes: &[BodyNode], node: &BodyNodeId) -> Option<Shared<Type>> {
  return match & nodes[node.index].kind {
    BodyNodeKind.Expression {ty, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    _ => Option.none<Shared<Type>>()
  }
}

struct CheckedOperand {
  node: BodyNodeId
  ty: Shared<Type>
}

struct CheckedOperands {
  leftNode: BodyNodeId
  leftType: Shared<Type>
  rightNode: BodyNodeId
  rightType: Shared<Type>
}

struct CheckedOperatorCall {
  ty: Shared<Type>
  form: BodyExpression
}

fn orderCheckedOperands(swapped: bool, first: CheckedOperand, second: CheckedOperand) -> CheckedOperands {
  let CheckedOperand {node: firstNode, ty: firstType} = move first
  let CheckedOperand {node: secondNode, ty: secondType} = move second
  if swapped {
    return CheckedOperands {
      leftNode: secondNode,
      leftType: move secondType,
      rightNode: firstNode,
      rightType: move firstType,
    }
  }
  return CheckedOperands {
    leftNode: firstNode,
    leftType: move firstType,
    rightNode: secondNode,
    rightType: move secondType,
  }
}

effect fn checkedOperatorCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  caller: &DeclarationId,
  nodes: &[BodyNode],
  constraints: &[Constraint],
  selected: SelectedOperator,
  arguments: Vector<BodyNodeId>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  module: &ModuleId,
  span: Span,
  unsafeAllowed: bool,
) -> Result<CheckedOperatorCall, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let SelectedOperator {contract, provider, call} = move selected
  let OperationCall {
    operation,
    implementation,
    signature,
    proof: unusedProof,
    receiver: unusedReceiver,
  } = move call
  if Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureNonLifetimeBinderCount) > usize.ZERO {
    return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(run genericOperationRejection(module, span, &operation))
  }
  if Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureStaticCount) > usize.ZERO
    || Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureIsStatic) {
    return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  if Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureUnsafe) && !unsafeAllowed {
    return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span))
  }
  // An operator on an `effect fn` operation constructs its Effect (OP-009), which `run (a * b)`
  // could execute; that construction has no representation here yet (named gap).
  if Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureIsEffect) {
    return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InterfaceEffectUnavailable, span),
    )
  }
  let supplied = Vector.asSlice<BodyNodeId>(&arguments)
  let mut operands = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < supplied.length {
    let ty = match move bodyExpressionType(nodes, &supplied[at]) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
    run Vector.append<Shared<Type>>(&mut operands, move ty)
    at = at + usize.ONE
  }
  let inferred = match move run inferOperatorOperands(&mut resolver.*, &signature, &operation, Vector.asSlice<Shared<Type>>(&operands)) {
    Option<Vector<Binding>>.Some {value} => move value
    Option<Vector<Binding>>.None => {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
    }
  }
  // No use context or default region chooses an operand-free operation lifetime here. Keep
  // that unresolved operation application explicit rather than publishing an incomplete recipe.
  let lifetimeCount = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureLifetimeCount)
  at = usize.ZERO
  while at < lifetimeCount {
    let region = Shared.with<Result<Answer, NoRejection>, Option<Shared<Lifetime>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureLifetimeAt(answer, at) })
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      let ordinal = Shared.with<Lifetime, usize>(&value, fn(lifetime: &Lifetime) -> usize {
        return match &lifetime.* {
          Lifetime.Parameter {declaration, ordinal} => {
            if DeclarationId.equals(&declaration, &operation) { return ordinal }
            return usize.MAX
          }
          _ => usize.MAX
        }
      })
      if ordinal != usize.MAX {
        if let Option<Argument>.None = move bindingArgumentAt(Vector.asSlice<Binding>(&inferred), ordinal) {
          return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
        }
      }
    }
    at = at + usize.ONE
  }
  let mut bounds = Vector.make<Constraint>()
  let constraintCount = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureConstraintCount)
  at = usize.ZERO
  while at < constraintCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut bounds, run applyConstraintBindings(&value, Vector.asSlice<Binding>(&inferred)))
    } else {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    at = at + usize.ONE
  }
  let premises = run copyConstraints(constraints)
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &premises,
    Vector.asSlice<Constraint>(&bounds), module, span)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(move value)
  }
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let mut ty = match move result {
    Option<Shared<Type>>.Some {value} => run Type.applyBindings(&value, Vector.asSlice<Binding>(&inferred), true)
    Option<Shared<Type>>.None => {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  if Shared.with<Type, bool>(&ty, rawCallableType) {
    let recipe = run callableWitnessResult(caller, &operation, &contract, &provider, &ty, &signature,
      nodes, Vector.asSlice<BodyNodeId>(&arguments), Vector.asSlice<Binding>(&inferred))
    ty = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &recipe, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(move error) }
    }
  }
  run Vector.append<SignatureDependency>(
    &mut signatures.*,
    SignatureDependency {declaration: run DeclarationId.copy(&operation)},
  )
  if let Option<Shared<DeclarationId>>.Some {value: witness} = &implementation {
    let moduleOrdinal = Shared.with<DeclarationId, usize>(
      &witness,
      fn(value: &DeclarationId) -> usize {
        return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
      },
    )
    if moduleOrdinal == usize.MAX {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    let witnessModule = run resolvedModule(&resolver.*, moduleOrdinal)
    let found = run ordinalOfIdentity(&mut resolver.*, &witnessModule, &witness)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
    }
    let declaration = run declarationAt(&mut resolver.*, &witnessModule, ordinal)
    if let Option<DeclarationId>.Some {value} = move declaration {
      run Vector.append<DeclarationId>(&mut requiredBodies.*, move value)
    } else {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  return Result.succeed<CheckedOperatorCall, Shared<Rejection>>(
    CheckedOperatorCall {
      ty: move ty,
      form: BodyExpression.InterfaceCall {
        contract: move contract,
        provider: move provider,
        operation: move operation,
        bindings: run Shared.make<Vector<Binding>>(move inferred),
        implementation: move implementation,
        receiverPass: Option.none<BodyReceiverPass>(),
        isEffect: false,
        arguments: move arguments,
      },
    },
  )
}

effect fn checkOperatorOperand<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
) -> Result<CheckedOperand, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    expression,
    expected,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CheckedOperand, Shared<Rejection>>(move error)
    }
  }
  let ty = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return Result.failResult<CheckedOperand, Shared<Rejection>>(
        run reject(
          &resolver.*,
          module,
          RejectionCode.Unsupported,
          run bodySpan(&resolver.source, cursor, expression),
        ),
      )
    }
  }
  return Result.succeed<CheckedOperand, Shared<Rejection>>(CheckedOperand {node: node, ty: move ty})
}

effect fn selectInterfaceReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  provider: &Shared<Type>,
  member: &[u8],
  constraints: &[Constraint],
  module: &ModuleId,
  memberSpan: Span,
) -> Result<ReceiverCallChoice, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut selected = Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
    Option.none<SelectedReceiverOperation>(),
  )
  if Shared.with<Type, bool>(provider, isTypeParameter) {
    selected = run selectBoundReceiverCall(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      true,
      provider,
      member,
      constraints,
      module,
      memberSpan,
    )
  } else {
    selected = run selectConcreteReceiverCall(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      true,
      provider,
      member,
      constraints,
      module,
      memberSpan,
    )
  }
  let found = match move selected {
    Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.Success {value} => value
    Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ReceiverCallChoice, Shared<Rejection>>(move error)
    }
  }
  let operation = match move found {
    Option<SelectedReceiverOperation>.Some {value} => value
    Option<SelectedReceiverOperation>.None => {
      return Result.failResult<ReceiverCallChoice, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.UnknownMember, memberSpan),
      )
    }
  }
  return Result.succeed<ReceiverCallChoice, Shared<Rejection>>(
    ReceiverCallChoice.Interface {selected: move operation},
  )
}

// Receiver spelling evaluates the subject once, selects its owner name before interfaces, and
// only then checks supplied arguments. The selected signature determines any receiver loan.
effect fn checkReceiverCall<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  callee: HirId,
  subject: HirId,
  field: HirId,
  generics: HirRef,
  arguments: CallArguments,
  pipeline: bool,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let memberSpan = run bodySpan(&resolver.source, cursor, field)
  if generics.present {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let memberSymbol = match run bodyNode(&resolver.source, cursor, field) {
    Node.Name {text} => text
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
    }
  }
  let member = run bodyText(&resolver.source, cursor, memberSymbol)
  let checkedReceiver = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    subject,
    &Option.none<Shared<Type>>(),
    constraints,
    contractBody,
    false,
    unsafeAllowed,
  )
  let receiverNode = match move checkedReceiver {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let receiverType = match & Vector.asSlice<BodyNode>(&nodes.*)[receiverNode.index].kind {
    BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let referent = Shared.with<Type, Option<Shared<Type>>>(
    &receiverType,
    fn(value: &Type) -> Option<Shared<Type>> {
      return match & value.* {
        Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
        _ => Option.none<Shared<Type>>()
      }
    },
  )
  let provider = match move referent {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => Shared.clone<Type>(&receiverType)
  }
  let fieldSelection = run selectedRecordField(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, &provider, Bytes.asSlice(&member), memberSpan)
  match move fieldSelection {
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Success {value: Option<CheckedRecordMember>.Some {..}} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      let calleeSpan = run bodySpan(&resolver.source, cursor, callee)
      let projected = run projectFieldValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, constraints, &mut nodes.*, callee, subject, field, calleeSpan, receiverNode, &Option.none<Shared<Type>>())
      let target = match move projected {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      return run invokeCallableValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, callee, target, generics, arguments, pipeline, expected, constraints, contractBody,
        unsafeAllowed, callAcknowledged)
    }
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Success {value: Option<CheckedRecordMember>.None} => ()
  }
  if pipeline { return run bodyRejection(&resolver.*, module, RejectionCode.CallTargetUnavailable, span) }
  let inherent = run selectInherentReceiverCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &provider,
    Bytes.asSlice(&member),
    false,
    true,
    module,
    memberSpan,
  )
  let own = match move inherent {
    Result<InherentCallChoice, Shared<Rejection>>.Success {value} => value
    Result<InherentCallChoice, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let mut maybeChoice = Option.none<ReceiverCallChoice>()
  match move own {
    InherentCallChoice.Selected {target, receiver} => match move receiver {
      Option<ReceiverPosition>.Some {value} => {
        maybeChoice = Option.some<ReceiverCallChoice>(
          ReceiverCallChoice.Inherent {target: move target, receiver: value},
        )
      }
      Option<ReceiverPosition>.None => {
        return run bodyRejection(
          &resolver.*,
          module,
          RejectionCode.AssociatedFunctionOnValue,
          memberSpan,
        )
      }
    }
    InherentCallChoice.Claimed => {
      // A claimed non-field owner name does not escape to conformance lookup.
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
    }
    InherentCallChoice.Missing => {
      let selected = run selectInterfaceReceiverCall(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &provider,
        Bytes.asSlice(&member),
        constraints,
        module,
        memberSpan,
      )
      match move selected {
        Result<ReceiverCallChoice, Shared<Rejection>>.Success {value} => {
          maybeChoice = Option.some<ReceiverCallChoice>(move value)
        }
        Result<ReceiverCallChoice, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    }
  }
  let choice = match move maybeChoice {
    Option<ReceiverCallChoice>.Some {value} => value
    Option<ReceiverCallChoice>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, memberSpan)
    }
  }
  let signature = match & choice {
    ReceiverCallChoice.Inherent {target, ..} => Shared.clone<Result<Answer, NoRejection>>(
      &target.signature,
    )
    ReceiverCallChoice.Interface {selected} => Shared.clone<Result<Answer, NoRejection>>(
      &selected.call.signature,
    )
  }
  let receiverPositionValue = match & choice {
    ReceiverCallChoice.Inherent {receiver, ..} => receiver
    ReceiverCallChoice.Interface {selected} => match & selected.call.receiver {
      Option<ReceiverPosition>.Some {value} => value
      Option<ReceiverPosition>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
      }
    }
  }
  // A receiver call cannot supply static arguments yet: an explicit gap, never a dropped value.
  if Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureStaticCount) > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signature,
    signatureParameterCount,
  )
  if receiverPositionValue.ordinal != usize.ZERO || parameterCount != CallArguments.length(arguments) + usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  // An inherent `effect fn` method constructs its Effect like the qualified call; an interface
  // operation's Effect needs the witness construction (named gap).
  let effectCall = Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureIsEffect)
  if effectCall {
    if let ReceiverCallChoice.Interface {..} = &choice {
      return run bodyRejection(&resolver.*, module, RejectionCode.InterfaceEffectUnavailable, span)
    }
  }
  if Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureNonLifetimeBinderCount) > usize.ZERO {
    if let ReceiverCallChoice.Interface {selected} = &choice {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(run genericOperationRejection(module, span, &selected.call.operation))
    }
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let unsafeCall = Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureUnsafe)
  if unsafeCall && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if callAcknowledged && !unsafeCall {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
  }
  let callDeclaration = match & choice {
    ReceiverCallChoice.Inherent {target, ..} => run DeclarationId.copy(&target.declaration)
    ReceiverCallChoice.Interface {selected} => run DeclarationId.copy(&selected.call.operation)
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(
    &mut variables,
    run Shared.make<DeclarationId>(run DeclarationId.copy(&callDeclaration)),
  )
  let mut inferred = Vector.make<Binding>()
  let receiverParameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return signatureParameter(answer, usize.ZERO)
    },
  )
  let expectedReceiver = match move receiverParameter {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let exactReceiver = run Type.equalsShared(&receiverType, &expectedReceiver)
  if !exactReceiver {
    let sameValue = run Type.equalsShared(&receiverType, &provider)
    let borrowsValue = match receiverPositionValue.mode {
      BodyReceiverPass.Shared => true
      BodyReceiverPass.Mutable => true
      BodyReceiverPass.Take => false
    }
    let borrowed = Shared.with<Type, Option<ReferenceReceiver>>(
      &receiverType,
      fn(value: &Type) -> Option<ReferenceReceiver> {
        return match & value.* {
          Type.Reference {referent: foundReferent, access, ..} => Option.some<ReferenceReceiver>(
            ReferenceReceiver {
              referent: Shared.clone<Type>(&foundReferent),
              mode: match access {
                Access.Shared => BodyReceiverPass.Shared
                Access.Mutable => BodyReceiverPass.Mutable
              },
            },
          )
          _ => Option.none<ReferenceReceiver>()
        }
      },
    )
    let mut sameBorrow = false
    if let Option<ReferenceReceiver>.Some {value} = move borrowed {
      if value.mode == receiverPositionValue.mode || receiverPositionValue.mode == BodyReceiverPass.Shared && value.mode == BodyReceiverPass.Mutable {
        sameBorrow = run Type.equalsShared(&value.referent, &provider)
      }
    }
    if !(sameValue && borrowsValue) && !sameBorrow {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, memberSpan)
    }
  }
  let mut adaptedReceiver = receiverNode
  if !exactReceiver && receiverPositionValue.mode != BodyReceiverPass.Take {
    let access = match receiverPositionValue.mode {
      BodyReceiverPass.Shared => Access.Shared
      BodyReceiverPass.Mutable => Access.Mutable
      BodyReceiverPass.Take => Access.Shared
    }
    let mut receiverPlace = receiverNode
    if !run Type.equalsShared(&receiverType, &provider) {
      receiverPlace = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
      run Vector.append<BodyNode>(
        &mut nodes.*,
        BodyNode {
          origin: BodyOrigin {syntax: subject, span: span},
          kind: BodyNodeKind.Expression {
            ty: Shared.clone<Type>(&provider),
            form: BodyExpression.Dereference {value: receiverNode},
          },
        },
      )
    }
    // A receiver that names no existing storage is lent as an owned temporary (BORROW-006).
    let temporary = !existingStorage(Vector.asSlice<BodyNode>(&nodes.*), receiverPlace)
    if access == Access.Mutable && !temporary && !mutablePlace(
      Vector.asSlice<BodyNode>(&nodes.*),
      Vector.asSlice<BodyLocal>(&statementScope.locals.*),
      receiverPlace,
    ) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, memberSpan)
    }
    let borrowedReceiver = run callerReferenceType(
      &expectedReceiver,
      caller,
      subject,
    )
    let borrowedReceiverType = match move borrowedReceiver {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
      }
    }
    adaptedReceiver = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: subject, span: span},
        kind: BodyNodeKind.Expression {
          ty: move borrowedReceiverType,
          form: BodyExpression.Borrow {access: access, value: receiverPlace},
        },
      },
    )
  }
  // A by-value receiver transfers an affine place without a written `move`; a Copy receiver is
  // copied, and an owned rvalue receiver has no place to leave.
  if receiverPositionValue.mode == BodyReceiverPass.Take {
    let written = match &Vector.asSlice<BodyNode>(&nodes.*)[receiverNode.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Move {..}, ..} => true
      _ => false
    }
    let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &receiverType, constraints, memberSpan) {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    if !written && !copied {
      let receiverSpan = Vector.asSlice<BodyNode>(&nodes.*)[receiverNode.index].origin.span
      let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, Vector.asSlice<BodyNode>(&nodes.*), receiverNode, false, false, receiverSpan, receiverSpan, constraints) {
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => value
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      let owned = match &consumed {
        Option<BodyConsumedPlace>.Some {..} => true
        Option<BodyConsumedPlace>.None => false
      }
      if owned {
        adaptedReceiver = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {syntax: subject, span: span},
          kind: BodyNodeKind.Expression {
            ty: Shared.clone<Type>(&receiverType),
            form: BodyExpression.Move {value: receiverNode, consumed: move consumed},
          },
        })
      }
    }
  }
  let actualReceiver = match move bodyExpressionType(
    Vector.asSlice<BodyNode>(&nodes.*),
    &adaptedReceiver,
  ) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
    }
  }
  let mut receiverFailure = run matchCallArgument(
    &resolver.*,
    module,
    memberSpan,
    &expectedReceiver,
    &actualReceiver,
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    &mut inferred, constraints)
  // A receiver meets its parameter by covariant region subtyping like any operand, such as
  // `Trailers<'decoder>` borrowed for `self: &'owner Trailers<'owner>`.
  let receiverMismatch = match &receiverFailure {
    Option<Shared<Rejection>>.Some {value} => Shared.with<Rejection, bool>(&value,
      fn(rejection: &Rejection) -> bool { return rejection.code == RejectionCode.TypeMismatch })
    Option<Shared<Rejection>>.None => false
  }
  if receiverMismatch {
    let none = Vector.make<usize>()
    let subtyped = run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, &expectedReceiver,
      &actualReceiver, &callDeclaration, caller, Vector.asSlice<Shared<DeclarationId>>(&variables),
      Vector.asSlice<Binding>(&inferred), Vector.asSlice<usize>(&none), constraints, memberSpan)
    if let Option<RelatedArgument>.Some {value: candidate} = move subtyped {
      let committed = run matchCallArgument(&resolver.*, module, memberSpan, &expectedReceiver, &candidate.ty,
        Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred, constraints)
      if let Option<Shared<Rejection>>.None = move committed {
        let subjectSpan = run bodySpan(&resolver.source, cursor, subject)
        if run retainRegionPairs(&mut resolver.*, BodyOrigin {syntax: subject, span: subjectSpan},
          Vector.asSlice<RegionPair>(&candidate.relations)) {
          receiverFailure = Option.none<Shared<Rejection>>()
        }
      }
    }
  }
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move receiverFailure {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move diagnostic)
  }
  let mut typedArguments = Vector.make<BodyNodeId>()
  run Vector.append<BodyNodeId>(&mut typedArguments, adaptedReceiver)
  let mut at = usize.ZERO
  while at < CallArguments.length(arguments) {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at + usize.ONE)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
    let context = run operationArgumentContext(&resolver.source, cursor, argumentId, &parameterType,
      &callDeclaration, caller)
    let checked = run checkExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut statementScope.*,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      argumentId,
      &context,
      constraints,
      contractBody,
      false,
      unsafeAllowed,
    )
    let argumentNode = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    let slicedArgument = run sliceArgument(&mut nodes.*, argumentNode, &parameterType)
    let adaptedArgument = run unionArgument(&mut nodes.*, slicedArgument, &parameterType)
    let argumentType = match & Vector.asSlice<BodyNode>(&nodes.*)[adaptedArgument.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let failed = run matchCallArgument(
      &resolver.*,
      module,
      span,
      &parameterType,
      &argumentType,
      Vector.asSlice<Shared<DeclarationId>>(&variables),
      &mut inferred, constraints)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move diagnostic)
    }
    run Vector.append<BodyNodeId>(&mut typedArguments, adaptedArgument)
    at = at + usize.ONE
  }
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let rawResult = match move result {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut resultType = run Type.applyBindings(&rawResult, Vector.asSlice<Binding>(&inferred), true)
  if !contractBody && !Shared.with<Type, bool>(&resultType, runtimeType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let mut form = BodyExpression.Unit
  let receiverPass = receiverPositionValue.mode
  match move choice {
    ReceiverCallChoice.Inherent {target, ..} => {
      run Vector.append<SignatureDependency>(
        &mut signatures.*,
        SignatureDependency {declaration: run DeclarationId.copy(&target.declaration)},
      )
      run Vector.append<DeclarationId>(
        &mut requiredBodies.*,
        run DeclarationId.copy(&target.declaration),
      )
      let selected = run checkedReceiverApplication(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        &target.declaration, &provider, Vector.asSlice<Binding>(&inferred), module, span)
      let application = match move selected {
        Result<Application, Shared<Rejection>>.Success {value} => move value
        Result<Application, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      if effectCall {
        // The Effect's exact representation is this application with the receiver and written
        // arguments as stored fields (EFF-001, REP-001), as for `Owner.method(receiver, ..)`.
        let declaredFailure = run signatureFailure(&signature)
        let declaredRequirements = run signatureRequirements(&signature)
        let failure = run Type.applyBindings(&declaredFailure, Vector.asSlice<Binding>(&inferred), true)
        let requirements = run Row.applyBindings(&declaredRequirements, Vector.asSlice<Binding>(&inferred), true)
        let construction = run effectConstruction(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
          Vector.asSlice<BodyNode>(&nodes.*), &application, Vector.asSlice<BodyNodeId>(&typedArguments), move resultType,
          move failure, move requirements, constraints, expression.index, target.isPublic, span)
        resultType = match move construction {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      } else if Shared.with<Type, bool>(&resultType, rawCallableType) {
        resultType = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          &application, constraints, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      form = BodyExpression.DirectCall {
        declaration: run DeclarationId.copy(&target.declaration),
        application: run Shared.make<Application>(move application),
        receiverPass: Option.some<BodyReceiverPass>(receiverPass),
        arguments: move typedArguments,
      }
    }
    ReceiverCallChoice.Interface {selected} => {
      let OperationCall {
        operation,
        implementation,
        signature: unusedSignature,
        proof,
        receiver: unusedReceiver,
      } = move selected.call
      drop unusedSignature
      drop unusedReceiver
      drop proof
      run Vector.append<SignatureDependency>(
        &mut signatures.*,
        SignatureDependency {declaration: run DeclarationId.copy(&operation)},
      )
      if Shared.with<Type, bool>(&resultType, rawCallableType) {
        let recipe = run callableWitnessResult(caller, &operation, &selected.contract, &provider, &resultType, &signature,
          Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyNodeId>(&typedArguments), Vector.asSlice<Binding>(&inferred))
        resultType = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &recipe, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      form = BodyExpression.InterfaceCall {
        contract: move selected.contract,
        provider: move provider,
        operation: move operation,
        bindings: run Shared.make<Vector<Binding>>(move inferred),
        implementation: move implementation,
        receiverPass: Option.some<BodyReceiverPass>(receiverPass),
        isEffect: false,
        arguments: move typedArguments,
      }
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move resultType, form: move form},
    },
  )
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, span)
}

// The enclosing declaration owns expression-local regions independently of demanded signatures.
struct RecordMemberSelection {
  index: usize
  count: usize
  isPublic: bool
}

impl Copy for RecordMemberSelection {}

struct CheckedRecordMember {
  index: usize
  count: usize
  ty: Shared<Type>
}

// Field identity and visibility come from the same cached member list used by type queries.
fn selectRecordMember(answer: &Result<Answer, NoRejection>, name: &[u8]) -> Option<RecordMemberSelection> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let fields = Vector.asSlice<Member>(&members)
      let mut at = usize.ZERO
      while at < fields.length {
        if fields[at].kind == MemberKind.Field {
          if let Option<Bytes>.Some {value: written} = &fields[at].name {
            if same(Bytes.asSlice(&written), name) {
              return Option.some<RecordMemberSelection>(RecordMemberSelection {
                index: at, count: fields.length, isPublic: fields[at].isPublic,
              })
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<RecordMemberSelection>()
}

effect fn checkedRecordMember(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId,
  ty: &Shared<Type>, name: &[u8], span: Span,
) -> Result<CheckedRecordMember, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = run selectedRecordField(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, ty, name, span)
  match move selected {
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Success {value: Option<CheckedRecordMember>.Some {value}} => {
      return Result.succeed<CheckedRecordMember, Shared<Rejection>>(move value)
    }
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CheckedRecordMember, Shared<Rejection>>(move error)
    }
    _ => ()
  }
  let anonymous = match move run Type.anonymousParts(ty) { Option<AnonymousParts>.Some {..} => true _ => false }
  let mut code = RejectionCode.UnknownMember
  if !anonymous && declaringModuleOrdinal(&resolver.*, ty) == usize.MAX {
    code = RejectionCode.TypeMismatch
  }
  return Result.failResult<CheckedRecordMember, Shared<Rejection>>(run reject(&resolver.*, module, code, span))
}

// Absence permits method lookup; a claimed field keeps every visibility and type rejection.
effect fn selectedRecordField(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId,
  ty: &Shared<Type>, name: &[u8], span: Span,
) -> Result<Option<CheckedRecordMember>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let anonymous = run Type.anonymousParts(ty)
  if let Option<AnonymousParts>.Some {value: parts} = move anonymous {
    let index = AnonymousOccurrence.labelIndex(&parts.occurrence, name)
    let members = Vector.asSlice<Shared<Type>>(&parts.members)
    if index >= members.length {
      return Result.succeed<Option<CheckedRecordMember>, Shared<Rejection>>(Option.none<CheckedRecordMember>())
    }
    return Result.succeed<Option<CheckedRecordMember>, Shared<Rejection>>(
      Option.some<CheckedRecordMember>(CheckedRecordMember {index: index, count: members.length, ty: Shared.clone<Type>(&members[index])}),
    )
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX {
    return Result.succeed<Option<CheckedRecordMember>, Shared<Rejection>>(Option.none<CheckedRecordMember>())
  }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result.succeed<Option<CheckedRecordMember>, Shared<Rejection>>(Option.none<CheckedRecordMember>()) }
  }
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Members, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }, span)
  let rejectedNames = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&names, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejectedNames {
    return Result.failResult<Option<CheckedRecordMember>, Shared<Rejection>>(move value)
  }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<RecordMemberSelection>>(&names,
    fn(answer: &Result<Answer, NoRejection>) -> Option<RecordMemberSelection> {
      return selectRecordMember(answer, name)
    },
  )
  let field = match move selected {
    Option<RecordMemberSelection>.Some {value} => value
    Option<RecordMemberSelection>.None => { return Result.succeed<Option<CheckedRecordMember>, Shared<Rejection>>(Option.none<CheckedRecordMember>()) }
  }
  if !field.isPublic && !ModuleId.equals(module, &declaredModule) {
    return Result.failResult<Option<CheckedRecordMember>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.PrivateMember, span),
    )
  }
  let application = run internApplication(&mut resolver.*, ty)
  let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.MemberShape, module: moduleOrdinal, name: application,
    declaration: declaration, member: field.index, external: false,
  }, span)
  let rejectedShape = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&shaped, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejectedShape {
    return Result.failResult<Option<CheckedRecordMember>, Shared<Rejection>>(move value)
  }
  let fieldType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&shaped, singleMemberType)
  return match move fieldType {
    Option<Shared<Type>>.Some {value} => Result.succeed<Option<CheckedRecordMember>, Shared<Rejection>>(
      Option.some<CheckedRecordMember>(CheckedRecordMember {index: field.index, count: field.count, ty: move value}),
    )
    Option<Shared<Type>>.None => Result.failResult<Option<CheckedRecordMember>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    )
  }
}

// Resolve a constructor's written annotation in the actual enclosing declaration's binder scope.
effect fn recordFieldCount(resolver: &mut Resolver, module: &ModuleId, ty: &Shared<Type>, span: Span)
-> Result<usize, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX {
    return Result.failResult<usize, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, span))
  }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  if let Option<usize>.Some {value: declaration} = move ordinal {
    let written = run header(&mut resolver.*, &declaredModule, declaration)
    if let Option<HeaderSyntax>.Some {value: syntax} = move written {
      if let Node.StructHeader {fields, ..} = syntax.header {
        return Result.succeed<usize, Shared<Rejection>>(fields.length)
      }
    }
  }
  return Result.failResult<usize, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, span))
}

// Deferred generic union representation is reported only after ordinary ownership and member validation.
effect fn deferredUnionVariant(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId,
  namespace: &[u8], member: &[u8], span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let candidateSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let candidate = match move candidateSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Option.some<Shared<Rejection>>(move error)
    }
  }
  if candidate.count != usize.ONE || (candidate.kind != CandidateKind.Declaration && candidate.kind != CandidateKind.ImportMember) {
    return Option.none<Shared<Rejection>>()
  }
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, namespace, false, span, RejectionCode.NotType)
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Option.none<Shared<Rejection>>()
    }
  }
  let declaredModule = run resolvedModule(&resolver.*, declaration.module)
  let written = run header(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut relevant = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {generics, ..} = value.header { relevant = generics.length > usize.ZERO }
  }
  if !relevant { return Option.none<Shared<Rejection>>() }
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Members, module: declaration.module, name: usize.ZERO,
    declaration: declaration.ordinal, member: usize.ZERO, external: false,
  }, span)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&names, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Option.some<Shared<Rejection>>(move value)
  }
  let visibility = Shared.with<Result<Answer, NoRejection>, Option<bool>>(&names,
    fn(answer: &Result<Answer, NoRejection>) -> Option<bool> {
      if let Result<Answer, NoRejection>.Success {value} = &answer.* {
        if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
          let values = Vector.asSlice<Member>(&members)
          let mut at = usize.ZERO
          while at < values.length {
            if let Option<Bytes>.Some {value: name} = &values[at].name {
              if same(Bytes.asSlice(&name), member) { return Option.some<bool>(values[at].isPublic) }
            }
            at = at + usize.ONE
          }
        }
      }
      return Option.none<bool>()
    },
  )
  if let Option<bool>.Some {value: isPublic} = move visibility {
    if !isPublic && !ModuleId.equals(module, &declaredModule) {
      return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.PrivateMember, span))
    }
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
  }
  return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnknownMember, span))
}

// A scalar enum's nominal type and its validated Members answer, which owns every discriminant.
struct SelectedScalarEnum {
  ty: Shared<Type>
  members: Shared<Result<Answer, NoRejection>>
  module: usize
}

struct ScalarEnumMember {
  value: BodyEnumMember
  isPublic: bool
}

// A qualified scalar enum use: one member value, or the representation operation `Enum.value`.
union EnumSelection {
  Member {ty: Shared<Type>, member: BodyEnumMember},
  Value {ty: Shared<Type>, representation: Shared<Type>},
}

fn scalarEnumMember(answer: &Result<Answer, NoRejection>, name: &[u8]) -> Option<ScalarEnumMember> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, enumRepresentation, ..}} = &value.outcome {
      let values = Vector.asSlice<Member>(&members)
      let mut at = usize.ZERO
      while at < values.length {
        if let Option<Bytes>.Some {value: written} = &values[at].name {
          if same(Bytes.asSlice(&written), name) {
            if let Option<EnumCase>.Some {value: discriminant} = &values[at].discriminant {
              return Option.some<ScalarEnumMember>(ScalarEnumMember {
                value: BodyEnumMember {
                  ordinal: at, negative: discriminant.sign == StaticSign.Negative, magnitude: discriminant.magnitude,
                  representation: enumRepresentation,
                },
                isPublic: values[at].isPublic,
              })
            }
            return Option.none<ScalarEnumMember>()
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<ScalarEnumMember>()
}

fn scalarEnumCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      return Vector.length<Member>(&members)
    }
  }
  return usize.ZERO
}

fn scalarEnumRepresentation(answer: &Result<Answer, NoRejection>) -> Option<StaticIntegerType> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {enumRepresentation, ..}} = &value.outcome {
      return Option.some<StaticIntegerType>(enumRepresentation)
    }
  }
  return Option.none<StaticIntegerType>()
}

effect fn scalarEnumMembers(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, declaredModule: usize, declaration: usize, span: Span,
) -> Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Members, module: declaredModule, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }, span)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&names, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result.failResult<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(move value)
  }
  return Result.succeed<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>(move names)
}

// Select a scalar enum written as a namespace; absence means the name is not one.
effect fn selectScalarEnum(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, namespace: &[u8], span: Span,
) -> Option<Result<SelectedScalarEnum, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let candidateSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let candidate = match move candidateSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Option.some<Result<SelectedScalarEnum, Shared<Rejection>>>(Result.failResult<SelectedScalarEnum, Shared<Rejection>>(move error))
    }
  }
  if candidate.count != usize.ONE || (candidate.kind != CandidateKind.Declaration && candidate.kind != CandidateKind.ImportMember) {
    return Option.none<Result<SelectedScalarEnum, Shared<Rejection>>>()
  }
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, namespace, false, span, RejectionCode.NotType)
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Option.none<Result<SelectedScalarEnum, Shared<Rejection>>>()
    }
  }
  let declaredModule = run resolvedModule(&resolver.*, declaration.module)
  let written = run header(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut relevant = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.EnumHeader {..} = value.header { relevant = true }
  }
  if !relevant { return Option.none<Result<SelectedScalarEnum, Shared<Rejection>>>() }
  let demanded = run scalarEnumMembers(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    declaration.module, declaration.ordinal, span)
  let members = match move demanded {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
      return Option.some<Result<SelectedScalarEnum, Shared<Rejection>>>(
        Result.failResult<SelectedScalarEnum, Shared<Rejection>>(move error))
    }
  }
  let identity = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Identity, module: declaration.module, name: usize.ZERO,
    declaration: declaration.ordinal, member: usize.ZERO, external: false,
  }, span)
  let selectedType = run typeFromAnswer(&identity)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selectedType.rejected {
    return Option.some<Result<SelectedScalarEnum, Shared<Rejection>>>(
      Result.failResult<SelectedScalarEnum, Shared<Rejection>>(move diagnostic))
  }
  return match move selectedType.resolved {
    Option<Shared<Type>>.Some {value: ty} => Option.some<Result<SelectedScalarEnum, Shared<Rejection>>>(
      Result.succeed<SelectedScalarEnum, Shared<Rejection>>(
        SelectedScalarEnum {ty: move ty, members: move members, module: declaration.module},
      ),
    )
    Option<Shared<Type>>.None => Option.none<Result<SelectedScalarEnum, Shared<Rejection>>>()
  }
}

// The checked subject's own declaration supplies the members; absence means it is not a scalar enum.
effect fn subjectScalarEnum(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, ty: &Shared<Type>, span: Span,
) -> Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Option.none<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>() }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option.none<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>() }
  }
  let written = run header(&mut resolver.*, &declaredModule, declaration)
  let mut relevant = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.EnumHeader {..} = value.header { relevant = true }
  }
  if !relevant { return Option.none<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>() }
  return Option.some<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>(
    run scalarEnumMembers(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, declaration, span))
}

// Member visibility is checked before selection; `value` names the representation operation.
effect fn checkedEnumSelection(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId,
  namespace: &[u8], member: &[u8], span: Span, invocation: bool,
) -> Option<Result<EnumSelection, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = run selectScalarEnum(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, span)
  let chosen = match move selected {
    Option<Result<SelectedScalarEnum, Shared<Rejection>>>.Some {value: found} => match move found {
      Result<SelectedScalarEnum, Shared<Rejection>>.Success {value} => value
      Result<SelectedScalarEnum, Shared<Rejection>>.Failure {error} => {
        return Option.some<Result<EnumSelection, Shared<Rejection>>>(Result.failResult<EnumSelection, Shared<Rejection>>(move error))
      }
    }
    Option<Result<SelectedScalarEnum, Shared<Rejection>>>.None => { return Option.none<Result<EnumSelection, Shared<Rejection>>>() }
  }
  let found = Shared.with<Result<Answer, NoRejection>, Option<ScalarEnumMember>>(&chosen.members,
    fn(answer: &Result<Answer, NoRejection>) -> Option<ScalarEnumMember> { return scalarEnumMember(answer, member) })
  let mut code = RejectionCode.UnknownMember
  if invocation { code = RejectionCode.NotCallable }
  if let Option<ScalarEnumMember>.Some {value} = move found {
    let declaredModule = run resolvedModule(&resolver.*, chosen.module)
    if invocation {
      code = RejectionCode.NotCallable
    } else if !value.isPublic && !ModuleId.equals(module, &declaredModule) {
      code = RejectionCode.PrivateMember
    } else {
      return Option.some<Result<EnumSelection, Shared<Rejection>>>(Result.succeed<EnumSelection, Shared<Rejection>>(
        EnumSelection.Member {ty: move chosen.ty, member: value.value},
      ))
    }
  } else if invocation && same(member, b"value") {
    let representation = Shared.with<Result<Answer, NoRejection>, Option<StaticIntegerType>>(&chosen.members, scalarEnumRepresentation)
    if let Option<StaticIntegerType>.Some {value: integer} = move representation {
      return Option.some<Result<EnumSelection, Shared<Rejection>>>(Result.succeed<EnumSelection, Shared<Rejection>>(
        EnumSelection.Value {ty: move chosen.ty, representation: run primitiveType(StaticConstant.integerName(integer))},
      ))
    }
    code = RejectionCode.Unsupported
  } else if invocation {
    // Any other invoked name is not an enum selection: ordinary qualified resolution owns the
    // enum's inherent members, as it does for every other nominal namespace.
    return Option.none<Result<EnumSelection, Shared<Rejection>>>()
  }
  return Option.some<Result<EnumSelection, Shared<Rejection>>>(
    Result.failResult<EnumSelection, Shared<Rejection>>(run reject(&resolver.*, module, code, span)))
}

effect fn deferredRecordAnnotation(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, annotation: HirId, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let written = run typeNode(&mut resolver.*, module, annotation)
  if let Option<HeaderSyntax>.Some {value: annotationSyntax} = move written {
    if let Node.NamedType {path: named, hasMode, ..} = annotationSyntax.header {
      if hasMode { return Option.none<Shared<Rejection>>() }
      let parsed = run path(&mut resolver.*, module, named)
      let segments = Vector.asSlice<Bytes>(&parsed.segments)
      if parsed.valid && segments.length == 2 {
        return run deferredUnionVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, Bytes.asSlice(&segments[usize.ZERO]), Bytes.asSlice(&segments[usize.ONE]), span)
      }
    }
  }
  return Option.none<Shared<Rejection>>()
}

// A bare generic nominal literal owns one open application while its fields are checked.
// Only the completed application is published to MIR, layout and instance interning.
struct InferredAggregateTarget {
  ty: Shared<Type>
  // The producer's source shape supplies nested literal context without fixing opaque slots.
  construction: Option<Shared<Type>>
  owner: Shared<DeclarationId>
  module: usize
  declaration: usize
  generics: Range
  binders: Vector<Binder>
  isPublic: bool
}

effect fn inferredAggregateDeclaration(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, declaration: &SelectedDeclaration,
  generics: Range, isPublic: bool, span: Span,
) -> Result<Option<InferredAggregateTarget>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let declaredModule = run resolvedModule(&resolver.*, declaration.module)
  let template = run templateBinders(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut binders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value: resolvedBinders} => move resolvedBinders
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move error)
    }
  }
  let aggregateFailure = run completeAggregateBinders(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declaration.module,
    &declaredModule,
    declaration.ordinal,
    span,
    &mut binders,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move aggregateFailure {
    return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move diagnostic)
  }
  let boundFailure = run completeBoundBinders(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declaration.module,
    &declaredModule,
    declaration.ordinal,
    span,
    &mut binders,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move boundFailure {
    return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move diagnostic)
  }
  if Vector.length<Binder>(&binders) > usize.ZERO {
    let identity = run declarationAt(&mut resolver.*, &declaredModule, declaration.ordinal)
    if let Option<DeclarationId>.Some {value: id} = move identity {
      let ownerId = run Shared.make<DeclarationId>(run DeclarationId.copy(&id))
      let generated = Vector.make<Shared<Lifetime>>()
      let arguments = run ownedArguments(
        &id,
        Vector.asSlice<Binder>(&binders),
        Vector.asSlice<Shared<Lifetime>>(&generated),
      )
      let ty = run Shared.make<Type>(Type.Nominal {
        declaration: move id,
        isPublic: isPublic,
        arguments: move arguments,
      })
      return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(
        Option.some<InferredAggregateTarget>(InferredAggregateTarget {
          ty: move ty,
          construction: Option.none<Shared<Type>>(),
          owner: move ownerId,
          module: declaration.module,
          declaration: declaration.ordinal,
          generics: generics,
          binders: move binders,
          isPublic: isPublic,
        }),
      )
    }
  }
  return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>())
}

// Only this producer's opaque arguments are construction holes. Other arguments, including
// authored caller parameters, lifetimes and foreign opaque families, remain fixed evidence.
effect fn inferredContextualAggregate(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId,
  expected: &Shared<Type>, span: Span) -> Result<Option<InferredAggregateTarget>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if !run Type.containsOpaque(expected, caller) {
    return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>())
  }
  let copied = run Type.copy(expected)
  if let Type.Nominal {declaration, arguments, isPublic} = move copied {
  let declaredModule = run ModuleId.copy(DeclarationId.moduleId(&declaration))
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(&declaration))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &declaredModule, &identity) {
    Option<usize>.Some {value} => value
    _ => { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  }
  let syntax = run header(&mut resolver.*, &declaredModule, ordinal)
  let mut generics = Range.empty()
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    match value.header {
      Node.StructHeader {generics: written, ..} => { generics = written }
      Node.TupleHeader {generics: written, ..} => { generics = written }
      _ => { return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>()) }
    }
  } else { fail RevisionMismatch {} }
  let selected = SelectedDeclaration {module: run internModule(&mut resolver.*, &declaredModule), ordinal: ordinal}
  let found = run inferredAggregateDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, generics, isPublic, span)
  let mut target = match move found {
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value: Option<InferredAggregateTarget>.Some {value}} => move value
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move error) }
    _ => { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UninferredParameter, span)) }
  }
  let formal = run Type.copy(&target.ty)
  let template = match move formal { Type.Nominal {arguments: formalArguments, ..} => move formalArguments _ => { fail RevisionMismatch {} } }
  let written = Vector.asSlice<Argument>(&arguments)
  let slots = Vector.asSlice<Argument>(&template)
  if written.length != slots.length { fail RevisionMismatch {} }
  let mut construction = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < written.length {
    let mut open = false
    if let Argument.Type {value} = &written[at] { open = run Type.containsOpaque(&value, caller) }
    if open { run Vector.append<Argument>(&mut construction, Argument.copy(&slots[at])) }
    else { run Vector.append<Argument>(&mut construction, Argument.copy(&written[at])) }
    at = at + usize.ONE
  }
  target.ty = run Shared.make<Type>(Type.Nominal {declaration: move declaration, arguments: move construction, isPublic: isPublic})
  target.construction = Option.some<Shared<Type>>(Shared.clone<Type>(expected))
  return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.some<InferredAggregateTarget>(move target))
  }
  return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>())
}

// The construction transaction of a written generic struct, or of the union a written variant
// qualifier names (`variantOwner`). Written arguments fix their binders; every lifetime they elide
// is a further slot of the same transaction, numbered after the declaration's binders, that the
// checked operands infer (LIFE-003).
effect fn inferredRecordAnnotation(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId,
  annotation: HirId, constraints: &[Constraint], span: Span, variantOwner: bool,
) -> Result<Option<InferredAggregateTarget>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let written = run typeNode(&mut resolver.*, module, annotation)
  let syntax = match move written {
    Option<HeaderSyntax>.Some {value} => value
    _ => { return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>()) }
  }
  let mut selectedNode = syntax.header
  let mut application = HirRef.absent()
  if let Node.AppliedType {target, arguments} = selectedNode {
    application = HirRef.of(arguments)
    let targetSyntax = run typeNode(&mut resolver.*, module, target)
    if let Option<HeaderSyntax>.Some {value} = move targetSyntax { selectedNode = value.header }
  }
  let mut named = HirRef.absent()
  if let Node.NamedType {path: spelled, hasMode, ..} = selectedNode {
    if !hasMode { named = HirRef.of(spelled) }
  }
  if !named.present { return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>()) }
  let parsed = run path(&mut resolver.*, module, named.id)
  let segments = Vector.asSlice<Bytes>(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 {
    return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>())
  }
  // A record constructor annotation is a type root. A reserved storage owner cannot become a
  // source generic aggregate through the inference shortcut either.
  if segments.length == usize.ONE {
    if let Option<SealedKind>.Some {..} = move SealedCore.reservedName(Bytes.asSlice(&segments[usize.ZERO])) {
      return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>())
    }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let mut selected = Result.failResult<SelectedDeclaration, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, parsed.span))
  if segments.length == usize.ONE {
    selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      moduleOrdinal, module, Bytes.asSlice(&segments[usize.ZERO]), false, parsed.span, RejectionCode.NotType)
  } else {
    selected = run qualifiedTypeDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      moduleOrdinal, module, segments, parsed.span)
  }
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>())
    }
  }
  let declaredModule = run resolvedModule(&resolver.*, declaration.module)
  let headerSyntax = run header(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut generics = Range.empty()
  let mut isPublic = false
  let mut record = false
  if let Option<HeaderSyntax>.Some {value} = move headerSyntax {
    match value.header {
      Node.StructHeader {generics: writtenGenerics, isPublic: published, ..} => {
        generics = writtenGenerics
        isPublic = published
        record = !variantOwner
      }
      Node.UnionHeader {generics: writtenGenerics, isPublic: published, ..} => {
        generics = writtenGenerics
        isPublic = published
        record = variantOwner
      }
      _ => ()
    }
  }
  if !record { return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>()) }
  let found = run inferredAggregateDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &declaration, generics, isPublic, span)
  let mut target = match move found {
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value: optional} => match move optional {
      Option<InferredAggregateTarget>.Some {value: aggregate} => move aggregate
      _ => { return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.none<InferredAggregateTarget>()) }
    }
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move error)
    }
  }
  if application.present {
    let callerIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(caller))
    let located = run ordinalOfIdentity(&mut resolver.*, module, &callerIdentity)
    let callerOrdinal = match move located {
      Option<usize>.Some {value} => value
      _ => { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let scoped = match move run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, callerOrdinal) {
      Result<BodyScope, Shared<Rejection>>.Success {value} => value
      Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move error) }
    }
    let prefixSyntax = run typeNode(&mut resolver.*, module, application.id)
    let prefix = match move prefixSyntax {
      Option<HeaderSyntax>.Some {value} => value
      _ => { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    if let Node.TypeArguments {arguments, environment, failures, requirements} = prefix.header {
      let formal = Vector.asSlice<Binder>(&target.binders)
      let mut elision = LifetimeElision {
        owner: Option.some<DeclarationId>(run DeclarationId.copyShared(&target.owner)), nextOrdinal: formal.length, output: false,
        resultDefault: Option.none<Shared<Lifetime>>(), generated: Vector.make<Shared<Lifetime>>(),
        invocation: false, nested: false, renumber: Vector.make<usize>(), staticEnvironment: false,
        supplied: Option.none<Vector<Argument>>(), assumptions: Option.some<Vector<Constraint>>(run copyConstraints(constraints)),
      }
      if environment.present || failures.present {
        let mut suppliedKind = GenericKind.Lifetime
        if failures.present { suppliedKind = GenericKind.Failure }
        return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run rejectKind(&resolver.*, module, prefix.span, b"", GenericKind.Type, suppliedKind))
      }
      let mut bindings = Vector.make<Binding>()
      let mapped = run writtenBinderOrdinals(&mut resolver.*, module, arguments, prefix.span, formal, requirements.present)
      let positions = match move mapped {
        Result<Vector<usize>, Shared<Rejection>>.Success {value: mappedOrdinals} => move mappedOrdinals
        Result<Vector<usize>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move error)
        }
      }
      let targets = Vector.asSlice<usize>(&positions)
      let mut at = usize.ZERO
      while at < arguments.length {
        let formalAt = targets[at]
        let mut explicit = Vector.make<Argument>()
        let refused = run appendWrittenArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          moduleOrdinal, module, arguments, formal, at, formalAt, Vector.asSlice<Binder>(&scoped.binders), &mut elision, false,
          &mut explicit)
        if let Option<Shared<Rejection>>.Some {value} = move refused {
          return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move value)
        }
        let values = Vector.asSlice<Argument>(&explicit)
        if values.length != usize.ONE { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, prefix.span)) }
        run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&target.owner),
          ordinal: formalAt, value: copyArgument(&values[usize.ZERO])})
        at = at + usize.ONE
      }
      if requirements.present {
        let formalAt = targets[arguments.length]
        let mut explicit = Vector.make<Argument>()
        let refused = run appendRequirementsSuffix(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          moduleOrdinal, module, formal, formalAt, requirements, prefix.span,
          Vector.asSlice<Binder>(&scoped.binders), &mut elision, &mut explicit)
        if let Option<Shared<Rejection>>.Some {value} = move refused { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(move value) }
        let values = Vector.asSlice<Argument>(&explicit)
        if values.length != usize.ONE { return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, prefix.span)) }
        run Vector.append<Binding>(&mut bindings, Binding {declaration: Shared.clone<DeclarationId>(&target.owner),
          ordinal: formalAt, value: copyArgument(&values[usize.ZERO])})
      }
      target.ty = run Type.applyBindings(&target.ty, Vector.asSlice<Binding>(&bindings), true)
    } else {
      return Result.failResult<Option<InferredAggregateTarget>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, prefix.span))
    }
  }
  return Result.succeed<Option<InferredAggregateTarget>, Shared<Rejection>>(Option.some<InferredAggregateTarget>(move target))
}

// A written record or union qualifier in the caller's body. Each lifetime it elides is a variable
// of the caller's elided-lifetime owner, which the qualifier's use must infer (LIFE-003).
effect fn recordAnnotation(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId,
  annotation: HirId, span: Span, constraints: &[Constraint],
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let deferred = run deferredRecordAnnotation(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, annotation, span)
  if let Option<Shared<Rejection>>.Some {value} = move deferred {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move value)
  }
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(caller))
  let ordinal = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    ) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let scope = run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, declaration)
  let scoped = match move scope {
    Result<BodyScope, Shared<Rejection>>.Success {value} => move value
    Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let mut elision = LifetimeElision {
    owner: Option.some<DeclarationId>(run elidedLifetimeOwner(caller)),
    nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option.none<Shared<Lifetime>>(), generated: Vector.make<Shared<Lifetime>>(),
    invocation: false, nested: false, renumber: Vector.make<usize>(), staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(), assumptions: Option.some<Vector<Constraint>>(run copyConstraints(constraints)),
  }
  return run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    annotation, Vector.asSlice<Binder>(&scoped.binders), &mut elision)
}

effect fn recordConstructionType(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, caller: &DeclarationId,
  annotation: HirId, span: Span, inference: &Option<InferredAggregateTarget>, constraints: &[Constraint],
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(&target.ty))
  }
  let resolved = run recordAnnotation(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, annotation, span, constraints,
  )
  // Only a written generic owner infers construction slots; a lifetime elided behind an alias
  // has no slot in this construction.
  let elided = run elidedLifetimeOwner(caller)
  if let Result<Shared<Type>, Shared<Rejection>>.Success {value} = &resolved {
    if run typeMentionsOwner(&value, &elided) {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span),
      )
    }
  }
  return move resolved
}

// Contextual operands never receive inference identities. Written borrows share a caller-owned
// call region; fixed lifetime evidence stays in the unifier so context cannot manufacture 'static.
effect fn callArgumentType(
  parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], caller: &DeclarationId, expression: HirId,
  contextual: bool,
) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureBinderCount)
  let mut supplied = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < count {
    let binder = Shared.with<Result<Answer, NoRejection>, Option<InferenceBinder>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    let selected = match move binder {
      Option<InferenceBinder>.Some {value} => move value
      Option<InferenceBinder>.None => { return Shared.clone<Type>(parameter) }
    }
    let isLifetime = match &selected { InferenceBinder.Lifetime {..} => true _ => false }
    let mut value = run contextBinderArgument(&selected, caller, expression, contextual)
    if !contextual || !isLifetime {
      let known = bindingArgumentAt(bindings, at)
      if let Option<Argument>.Some {value: evidence} = move known { value = move evidence }
    }
    run Vector.append<Argument>(&mut supplied, move value)
    at = at + usize.ONE
  }
  return run Type.instantiate(parameter, fresh, Vector.asSlice<Argument>(&supplied))
}

effect fn callArgumentContext(
  parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], caller: &DeclarationId, expression: HirId,
) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let context = run callArgumentType(parameter, signature, fresh, bindings, caller, expression, true)
  if run typeMentionsOwner(&context, fresh) { return Option.none<Shared<Type>>() }
  if !Shared.with<Type, bool>(&context, runtimeType) { return Option.none<Shared<Type>>() }
  return Option.some<Shared<Type>>(move context)
}

// The known positions of a representation parameter's callable bound inform a named value.
// Unknown consumer positions retain their private owner; the whole bound is proved separately.
effect fn representationPromise(parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], caller: &DeclarationId, expression: HirId) -> Option<NamedCallableEvidence>
! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract}} = move bound {
      if run Type.equalsShared(parameter, &representation) {
        let promised = run callArgumentType(&contract, signature, fresh, bindings, caller, expression, false)
        let callable = Shared.with<Type, bool>(&promised, fn(ty: &Type) -> bool {
          return match &ty.* { Type.Callable {..} => true _ => false }
        })
        if !callable { return Option.none<NamedCallableEvidence>() }
        let mut pending = Option.none<DeclarationId>()
        if run typeMentionsOwner(&promised, fresh) {
          pending = Option.some<DeclarationId>(run DeclarationId.copy(fresh))
        }
        return Option.some<NamedCallableEvidence>(NamedCallableEvidence {contract: move promised, pending: move pending})
      }
    }
    at = at + usize.ONE
  }
  return Option.none<NamedCallableEvidence>()
}

effect fn contextBinderArgument(binder: &InferenceBinder, caller: &DeclarationId, expression: HirId, contextual: bool) -> Argument
! OutOfMemoryError ? &mut Allocator {
  match &binder.* {
    InferenceBinder.Lifetime {value} => {
      if !contextual { return Argument.Lifetime {value: Shared.clone<Lifetime>(&value)} }
      return Argument.Lifetime {
        value: run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: expression.index}),
      }
    }
    InferenceBinder.Type {value} => { return Argument.Type {value: Shared.clone<Type>(&value)} }
    InferenceBinder.Row {value} => {
      let mut row = Row.empty()
      run Row.include(&mut row, RowParameter {declaration: Shared.clone<DeclarationId>(&value.declaration), ordinal: value.ordinal})
      return Argument.Row {value: run Shared.make<Row>(move row)}
    }
  }
}

effect fn rootCallBorrowContext(context: &Option<Shared<Type>>, caller: &DeclarationId, expression: HirId) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value} = &context.* {
    let adjusted = run callerReferenceType(&value, caller, expression)
    if let Option<Shared<Type>>.Some {value: reference} = move adjusted { return Option.some<Shared<Type>>(move reference) }
    return Option.some<Shared<Type>>(Shared.clone<Type>(&value))
  }
  return Option.none<Shared<Type>>()
}

// Positional fields are authorized by the selected nominal tuple, never by record names.
effect fn checkedTupleElements(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, ty: &Shared<Type>, span: Span,
) -> Result<Vector<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let anonymous = run Type.anonymousParts(ty)
  if let Option<AnonymousParts>.Some {value: parts} = move anonymous {
    if AnonymousOccurrence.isPositional(&parts.occurrence) {
      return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move parts.members)
    }
    return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, span))
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  }
  let written = run header(&mut resolver.*, &declaredModule, declaration)
  let mut count = usize.MAX
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.TupleHeader {elements, ..} = value.header { count = elements.length }
  }
  if count == usize.MAX { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  let application = run internApplication(&mut resolver.*, ty)
  let mut fields = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: at, external: false,
    }, span)
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&shape, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(move value)
    }
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&shape, singleMemberType)
    let field = match move selected {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    run Vector.append<Shared<Type>>(&mut fields, move field)
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move fields)
}

// Projection auto-dereferences references while retaining the original access evidence.
effect fn checkedProjectionSubject<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  subject: HirId, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    subject, &Option.none<Shared<Type>>(), constraints, contractBody, false, unsafeAllowed)
  let mut node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  while true {
    let evidence = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node)
    let selected = match move evidence {
      Option<Shared<Type>>.Some {value} => Shared.with<Type, Option<Shared<Type>>>(&value,
        fn(value: &Type) -> Option<Shared<Type>> {
          if let Type.Reference {referent, ..} = &value.* { return Option.some<Shared<Type>>(Shared.clone<Type>(&referent)) }
          return Option.none<Shared<Type>>()
        })
      Option<Shared<Type>>.None => Option.none<Shared<Type>>()
    }
    let referent = match move selected {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { break }
    }
    let next = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
      origin: BodyOrigin {syntax: subject, span: run bodySpan(&resolver.source, cursor, subject)},
      kind: BodyNodeKind.Expression {ty: move referent, form: BodyExpression.Dereference {value: node}},
    })
    node = next
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
}

// Positional construction uses the same aggregate operand/storage representation as records.
effect fn checkPositionalAggregate<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, elements: CallArguments, ty: &Shared<Type>, fields: &[Shared<Type>],
  inference: &Option<InferredAggregateTarget>, expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  if CallArguments.length(elements) != fields.length { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  let mut operands = Vector.make<BodyAggregateField>()
  let mut inferred = Vector.make<Binding>()
  let mut constructionFields = Vector.make<Shared<Type>>()
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    if let Option<Shared<Type>>.Some {value: blueprint} = &target.construction {
      constructionFields = match move run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &blueprint, span) {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
    }
  }
  let mut at = usize.ZERO
  while at < fields.length {
    let context = Option.some<Shared<Type>>(Shared.clone<Type>(&fields[at]))
    let argument = run bodyArgument(&resolver.source, cursor, elements, at)
    let mut construction = Option.none<Shared<Type>>()
    let blueprints = Vector.asSlice<Shared<Type>>(&constructionFields)
    if at < blueprints.length { construction = Option.some<Shared<Type>>(Shared.clone<Type>(&blueprints[at])) }
    let mut checked = Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: usize.ZERO})
    if let Option<InferredAggregateTarget>.Some {..} = &inference.* {
      checked = run checkAggregateInitializer(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        &fields[at], inference, &construction, &mut inferred, argument, expression.index, constraints, contractBody, unsafeAllowed)
    } else {
      checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        argument, &context, constraints, contractBody, staticBody, unsafeAllowed)
    }
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    run Vector.append<BodyAggregateField>(&mut operands, BodyAggregateField {index: at, value: node})
    at = at + usize.ONE
  }
  let completed = match move run completeAggregateInference(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    ty, inference, Vector.asSlice<Binding>(&inferred), constraints, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !Shared.with<Type, bool>(&value, sourceUnion) {
      let variables = Vector.make<Shared<DeclarationId>>()
      let mut inferred = Vector.make<Binding>()
      let failed = run matchCallArgument(&resolver.*, module, span, &value, &completed,
        Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred, constraints)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move diagnostic)
      }
    }
  }
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move completed, form: BodyExpression.Aggregate {fields: move operands}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, span)
}

// Tuple field patterns are queried under the nominal declaration's authored template. Applying
// call-inference arguments happens only afterwards in owned storage; fresh IDs never form a key.
effect fn callTupleFields(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, parameter: &Shared<Type>, span: Span,
) -> Result<Vector<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let shape = run Type.copy(parameter)
  if let Type.Nominal {declaration, isPublic, arguments} = move shape {
    let declaredModule = DeclarationId.moduleId(&declaration)
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, declaredModule)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(&declaration))
    let selected = run ordinalOfIdentity(&mut resolver.*, declaredModule, &identity)
    let ordinal = match move selected {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, span)) }
    }
    let template = run templateBinders(&mut resolver.*, declaredModule, ordinal)
    let mut binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(move error) }
    }
    let failed = run completeAggregateBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      moduleOrdinal, declaredModule, ordinal, span, &mut binders)
    if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(move value) }
    let generated = Vector.make<Shared<Lifetime>>()
    let authored = run ownedArguments(&declaration, Vector.asSlice<Binder>(&binders), Vector.asSlice<Shared<Lifetime>>(&generated))
    let queryType = run Shared.make<Type>(Type.Nominal {
      declaration: run DeclarationId.copy(&declaration), isPublic: isPublic, arguments: move authored,
    })
    let queried = run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &queryType, span)
    let fields = match move queried {
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
      Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(move error) }
    }
    let listed = Vector.asSlice<Shared<Type>>(&fields)
    let mut applied = Vector.make<Shared<Type>>()
    let mut at = usize.ZERO
    while at < listed.length {
      run Vector.append<Shared<Type>>(&mut applied, run Type.instantiate(&listed[at], &declaration, Vector.asSlice<Argument>(&arguments)))
      at = at + usize.ONE
    }
    return Result.succeed<Vector<Shared<Type>>, Shared<Rejection>>(move applied)
  }
  return Result.failResult<Vector<Shared<Type>>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.NotType, span))
}

struct CheckedBorrow {
  ty: Shared<Type>
  value: BodyNodeId
}

// The validity of borrowed storage comes from the descriptor crossed by a place projection,
// not the type of the projected value or its expected result. Owned local descriptors themselves
// are local storage; only dereferencing one borrows the storage its lifetime describes.
fn borrowedPlaceRegion(nodes: &[BodyNode], id: BodyNodeId) -> Option<Shared<Lifetime>> {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Dereference {value}, ..} => match &nodes[value.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.with<Type, Option<Shared<Lifetime>>>(&ty, operandRegion)
      _ => Option.none<Shared<Lifetime>>()
    }
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => borrowedPlaceRegion(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => {
      if let BodyNodeKind.Expression {ty, ..} = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some {..} = move Type.sliceElement(&ty) {
          return Shared.with<Type, Option<Shared<Lifetime>>>(&ty, operandRegion)
        }
      }
      return borrowedPlaceRegion(nodes, value)
    }
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {subject, access, ..}, ..} => {
      if access == BodyBindingAccess.Shared || access == BodyBindingAccess.Exclusive {
        return borrowedPlaceRegion(nodes, subject)
      }
      return Option.none<Shared<Lifetime>>()
    }
    _ => Option.none<Shared<Lifetime>>()
  }
}

// The conversion shape is separate from expected element/access/region evidence. Call inference
// requests slice reborrowing here, then validates the actual loan through its persistent unifier.
effect fn checkBorrowOperand<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, access: Access, operand: HirId, expected: &Option<Shared<Type>>,
  sliceHint: bool, loanOrdinal: usize, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool,
) -> Result<CheckedBorrow, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  if staticBody {
    return Result.failResult<CheckedBorrow, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
  }
  // A borrowed array literal is checked against its loan context, so `&[1, 2]` for `&[u8]`
  // infers u8 elements; an uncontextualized literal keeps ordinary element inference.
  let operandContext = run borrowedArrayContext(&resolver.source, cursor, operand, expected)
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    operand,
    &operandContext,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let mut operandNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CheckedBorrow, Shared<Rejection>>(move error)
    }
  }
  let mut referent = match move bodyExpressionType(
    Vector.asSlice<BodyNode>(&nodes.*),
    &operandNode,
  ) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return Result.failResult<CheckedBorrow, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let sourceRegion = Shared.with<Type, Option<Shared<Lifetime>>>(&referent, operandRegion)
  let mut sliceContext = sliceHint
  if let Option<Shared<Type>>.Some {value: context} = &expected.* {
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&context) { sliceContext = true }
  }
  if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&referent) {
    if access == Access.Mutable && !Shared.with<Type, bool>(&referent, mutableSlice) {
      return Result.failResult<CheckedBorrow, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
    }
    let ty = run Shared.make<Type>(Type.Slice {
      element: move element, access: access,
      lifetime: match move sourceRegion {
        Option<Shared<Lifetime>>.Some {value} => move value
        Option<Shared<Lifetime>>.None => { return Result.failResult<CheckedBorrow, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
      },
    })
    return Result.succeed<CheckedBorrow, Shared<Rejection>>(CheckedBorrow {ty: move ty, value: operandNode})
  }
  // A contextual reference borrow reborrows the referent, rather than the stored descriptor.
  let mut reborrow = false
  if sliceContext {
    reborrow = Shared.with<Type, bool>(&referent, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {..} => true
        _ => false
      }
    })
  } else if let Option<Shared<Type>>.Some {value: context} = &expected.* {
    reborrow = Shared.with<Type, bool>(
      &context,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Reference {..} => true
          Type.Slice {..} => true
          _ => false
        }
      },
    ) && Shared.with<Type, bool>(
      &referent,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Reference {..} => true
          _ => false
        }
      },
    )
  }
  if reborrow {
    let pointee = Shared.with<Type, Option<Shared<Type>>>(
      &referent,
      fn(value: &Type) -> Option<Shared<Type>> {
        return match & value.* {
          Type.Reference {referent: target, ..} => Option.some<Shared<Type>>(
            Shared.clone<Type>(&target),
          )
          _ => Option.none<Shared<Type>>()
        }
      },
    )
    let target = match move pointee {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return Result.failResult<CheckedBorrow, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
    let descriptor = operandNode
    operandNode = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: expression, span: span},
        kind: BodyNodeKind.Expression {
          ty: Shared.clone<Type>(&target),
          form: BodyExpression.Dereference {value: descriptor},
        },
      },
    )
    referent = move target
  }
  // An operand that names no existing storage is an owned temporary with a hidden owner
  // (BORROW-006). A mutable loan may change it because no other name observes it.
  let temporary = !existingStorage(Vector.asSlice<BodyNode>(&nodes.*), operandNode)
  if access == Access.Mutable && !temporary && !mutablePlace(
    Vector.asSlice<BodyNode>(&nodes.*),
    Vector.asSlice<BodyLocal>(&statementScope.locals.*),
    operandNode,
  ) {
    return Result.failResult<CheckedBorrow, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ExclusiveBorrowRequiresMutable, span))
  }
  let place = borrowedPlaceRegion(Vector.asSlice<BodyNode>(&nodes.*), operandNode)
  let described = match &place {
    Option<Shared<Lifetime>>.Some {..} => true
    Option<Shared<Lifetime>>.None => false
  }
  let mut region = match move place {
    Option<Shared<Lifetime>>.Some {value} => move value
    Option<Shared<Lifetime>>.None => run Shared.make<Lifetime>(
      Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: loanOrdinal},
    )
  }
  if !sliceContext {
    if let Option<Shared<Type>>.Some {value: context} = &expected.* {
      let expectedRegion = Shared.with<Type, Option<Shared<Lifetime>>>(&context,
        fn(value: &Type) -> Option<Shared<Lifetime>> {
          return match &value.* {
            Type.Reference {lifetime: validity, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&validity))
            _ => Option.none<Shared<Lifetime>>()
          }
        })
      if let Option<Shared<Lifetime>>.Some {value: requested} = move expectedRegion {
        // A caller-local region shortens this loan within the current body. Any nonlocal
        // context must be justified: a fresh loan of storage this body owns only by declared
        // premises, and a place reached through a descriptor by its region as at every other
        // boundary (`admitsRegion`), so a caller-local descriptor region stays open on the body
        // as a relation.
        let mut deferred = Vector.make<RegionPair>()
        if !callerLocalRegion(&requested, caller) {
          let mut admitted = run knownOutlives(constraints, &region, &requested)
          if described { admitted = run admitsRegion(&region, &requested, caller, constraints, &mut deferred) }
          if !admitted
            || !run retainRegionPairs(&mut resolver.*, BodyOrigin {syntax: expression, span: span},
              Vector.asSlice<RegionPair>(&deferred)) {
            return Result.failResult<CheckedBorrow, Shared<Rejection>>(run reject(&resolver.*, module,
              RejectionCode.TypeMismatch, span))
          }
        }
        region = move requested
      }
    }
  }
  let ty = run Shared.make<Type>(
    Type.Reference {referent: move referent, access: access, lifetime: move region},
  )
  return Result.succeed<CheckedBorrow, Shared<Rejection>>(CheckedBorrow {ty: move ty, value: operandNode})
}

// Whether a loan addresses storage that already has an owner: a local, a match binding, or the
// referent of a reference or slice, reached through field and element projections. Any other
// operand, such as a call result, a literal or a projection of one, is evaluated into a temporary
// that the loan's hidden owner keeps for the full expression or a borrowing binding (BORROW-006).
fn existingStorage(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => existingStorage(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => {
      // A slice element lives in the slice's referent, however the descriptor was produced.
      if let BodyNodeKind.Expression {ty, ..} = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&ty) { return true }
      }
      return existingStorage(nodes, value)
    }
    _ => false
  }
}

// The array type a borrowed array literal must have under its loan context, if any.
effect fn borrowedArrayContext(
  source: &SourceIndex, cursor: &AuthoredCursor, operand: HirId, expected: &Option<Shared<Type>>,
) -> Option<Shared<Type>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let length = match run bodyNode(source, cursor, operand) {
    Node.ArrayExpression {elements} => elements.length
    _ => { return Option.none<Shared<Type>>() }
  }
  if let Option<Shared<Type>>.Some {value: context} = &expected.* {
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&context) {
      return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Array {element: move element, extent: run Type.extentText(length)}))
    }
    return Shared.with<Type, Option<Shared<Type>>>(&context, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Reference {referent, ..} = &value.* {
        if let Option<ArrayShape>.Some {..} = move Type.arrayShape(&referent) {
          // A fixed loan region is useful context even when the aggregate must infer the
          // element type. An open element must not contextually type the literal itself.
          if Type.hasOpenRuntimeParameters(&referent) { return Option.none<Shared<Type>>() }
          return Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
        }
      }
      return Option.none<Shared<Type>>()
    })
  }
  return Option.none<Shared<Type>>()
}

effect fn repeatedTypes(element: &Shared<Type>, count: usize) -> Vector<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let mut repeated = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    run Vector.append<Shared<Type>>(&mut repeated, Shared.clone<Type>(element))
    at = at + usize.ONE
  }
  return move repeated
}

// A concrete slice element types a borrowed array literal; an inferred element does not.
effect fn concreteSliceContext(parameter: &Shared<Type>, fresh: &DeclarationId) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let element = match move Type.sliceElement(parameter) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option.none<Shared<Type>>() }
  }
  if run typeMentionsOwner(&element, fresh) {
    return Option.none<Shared<Type>>()
  }
  return Option.some<Shared<Type>>(Shared.clone<Type>(parameter))
}

// A reference parameter whose referent has inferred lifetimes, such as `&mut Plan` for
// `Plan<'a>`. Its contextual referent carries call-region stand-ins, so the loan's actual referent
// is matched by the exact unifier instead of the expected-value check.
effect fn inferredReferentLifetimes(parameter: &Shared<Type>, fresh: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let referent = Shared.with<Type, Option<Shared<Type>>>(parameter, fn(value: &Type) -> Option<Shared<Type>> {
    if let Type.Reference {referent, ..} = &value.* { return Option.some<Shared<Type>>(Shared.clone<Type>(&referent)) }
    return Option.none<Shared<Type>>()
  })
  if let Option<Shared<Type>>.Some {value} = move referent {
    let mut types = Vector.make<usize>()
    let mut lifetimes = Vector.make<usize>()
    let mut rows = Vector.make<usize>()
    run Type.collectOwned(&value, fresh, &mut types, &mut lifetimes, &mut rows)
    return Vector.length<usize>(&lifetimes) > usize.ZERO
  }
  return false
}

// Rewrites the borrow node's reference type to carry the caller call region; a node whose type is
// not a reference is left untouched.
effect fn contributeBorrowCallRegion(
  resolver: &Resolver, module: &ModuleId, nodes: &mut Vector<BodyNode>, caller: &DeclarationId,
  node: BodyNodeId, call: HirId, callSpan: Span,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let borrowed = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node)
  let value = match move borrowed {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option.none<Shared<Rejection>>() }
  }
  let shape = run Type.copy(&value)
  let actualShape = match move shape {
    Type.Reference {referent, access, lifetime: previousLifetime} => Option.some<Type>(Type.Reference {
      referent: move referent, access: access,
      lifetime: run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: call.index},
        ),
    },
    )
    _ => Option.none<Type>()
  }
  let actualType = match move actualShape {
    Option<Type>.Some {value: shaped} => move shaped
    Option<Type>.None => { return Option.none<Shared<Rejection>>() }
  }
  let actual = run Shared.make<Type>(move actualType)
  let previous = Vector.remove<BodyNode>(&mut nodes.*, node.index)
  let form = match move previous.kind {
    BodyNodeKind.Expression {form, ty: previousType} => move form
    _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, callSpan),
      ) }
  }
  run Vector.insert<BodyNode>(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
    kind: BodyNodeKind.Expression {ty: move actual, form: move form},
  },
  )
  return Option.none<Shared<Rejection>>()
}

// Aggregate argument inference checks each child once, retaining its actual caller evidence.
// The parent is constructed only after those bindings have been solved; contextual placeholder
// lifetimes are never published as the array element or nominal tuple's actual arguments.
// A representation can occur behind a source reference. Match only the type slot named by
// the bound, never the enclosing descriptor or an unrelated lifetime/type argument.
effect fn reachesRepresentation(reached: &[Shared<Type>], representation: &Shared<Type>, fresh: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < reached.length {
    if run parameterUsesRepresentation(&reached[at], representation, fresh) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn parameterUsesRepresentation(
  parameter: &Shared<Type>,
  representation: &Shared<Type>,
  fresh: &DeclarationId,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let ordinal = Shared.with<Type, usize>(
    representation,
    fn(value: &Type) -> usize {
      return Type.parameterOrdinalOf(value, fresh)
    },
  )
  if ordinal == usize.MAX {
    return false
  }
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(parameter, fresh, &mut types, &mut lifetimes, &mut rows)
  let used = Vector.asSlice<usize>(&types)
  let mut at = usize.ZERO
  while at < used.length {
    if used[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a written call argument fixed the binder at `ordinal`.
fn fixedOrdinal(explicit: &[usize], ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < explicit.length {
    if explicit[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Implicit source calls infer their authored binders, including lifetimes. Explicit source
// specialization selects lifetimes before inference; hidden exact slots are never authored binders.
fn sourceCallableInference(
  signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId,
  explicit: &[usize],
  explicitSyntax: bool,
  callableParameterStart: usize,
) -> bool {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureBinderCount)
  let mut at = usize.ZERO
  while at < count && at < callableParameterStart {
    if fixedOrdinal(explicit, at) {
      at = at + usize.ONE
      continue
    }
    let binder = Shared.with<Result<Answer, NoRejection>, Option<InferenceBinder>>(
      signature,
      fn(value: &Result<Answer, NoRejection>) -> Option<InferenceBinder> {
        return inferenceBinderAt(value, at)
      },
    )
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => {
        if Shared.with<Type, usize>(
          &value,
          fn(ty: &Type) -> usize {
            return Type.parameterOrdinalOf(ty, fresh)
          },
        ) != usize.MAX {
          return true
        }
      }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => {
        if declarationEqualsShared(fresh, &value.declaration) {
          return true
        }
      }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {..}} => {
        if !explicitSyntax {
          return true
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return false
}

// Hidden representations do not introduce a source generic-inference failure when every
// authored binder was explicitly fixed. Such plain callable mismatches use the argument span.
effect fn callableArgumentFailure(
  resolver: &Resolver,
  module: &ModuleId,
  failure: &Shared<Rejection>,
  source: &Shared<Type>,
  constraints: &[Constraint],
  inferredRepresentation: bool,
  sourceInference: bool,
  span: Span,
  callSpan: Span,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let code = Shared.with<Rejection, RejectionCode>(
    failure,
    fn(value: &Rejection) -> RejectionCode {
      return value.code
    },
  )
  if !inferredRepresentation || unavailableRejection(code) {
    return Shared.clone<Rejection>(failure)
  }
  // A plain callable's signature may match while its retained environment is too short.
  // Keep that lifetime proof failure at the supplied operand instead of relabeling its shape.
  if !sourceInference && code == RejectionCode.UnsatisfiedLifetimeBound {
    return run reject(resolver, module, code, span)
  }
  let contract = run valueCallableContract(source, constraints)
  if sourceInference {
    // Inferring a callable bound from a value whose result is an Effect (an `effect fn` value)
    // needs Effect environment and run-mode inference; that remains the named effect-form gap.
    if let Option<Shared<Type>>.Some {value: offered} = &contract {
      if Shared.with<Type, bool>(&offered, effectProducing) {
        return run reject(resolver, module, RejectionCode.EffectFormUnavailable, callSpan)
      }
    }
    return run reject(resolver, module, RejectionCode.TypeArgumentInference, callSpan)
  }
  if let Option<Shared<Type>>.Some {..} = move contract {
    return run reject(resolver, module, RejectionCode.IncompatibleCallableSignature, span)
  }
  return run reject(resolver, module, code, span)
}

fn pendingCallableSelection(value: &Shared<Type>) -> bool {
  return Type.containsCallableOrigin(value) || Type.containsCallableWitness(value)
}

fn pendingOriginContext(value: &Option<Shared<Type>>) -> bool {
  return match &value.* { Option<Shared<Type>>.Some {value: pending} => pendingCallableSelection(&pending) _ => false }
}

effect fn checkInferredCallArgument<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  argument: HirId, parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>, captured: &[Shared<Type>],
  fresh: &DeclarationId, variables: &[Shared<DeclarationId>], explicit: &[usize],
  explicitSyntax: bool, inferred: &mut Vector<Binding>,
  call: HirId, callSpan: Span, constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, argument)
  let sliceParameter = match move Type.sliceElement(parameter) {
    Option<Shared<Type>>.Some {..} => true
    Option<Shared<Type>>.None => false
  }
  let pattern = run callArgumentType(parameter, signature, fresh, Vector.asSlice<Binding>(&inferred.*), caller, call, false,
  )
  let ordinal = Shared.with<Type, usize>(parameter,
    fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, fresh) },
  )
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount,
  )
  let callableParameterStart = Shared.with<Result<Answer, NoRejection>, usize>(
    signature,
    signatureCallableParameterStart,
  )
  let sourceInference = sourceCallableInference(
    signature,
    fresh,
    explicit,
    explicitSyntax,
    callableParameterStart,
  )
  let mut inferredRepresentation = false
  if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) {
    let mut at = usize.ZERO
    while at < boundCount {
      let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) },
      )
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, ..}} = move bound {
        if run Type.equalsShared(parameter, &representation) { inferredRepresentation = true }
      }
      at = at + usize.ONE
    }
  }
  let mut elements = Range.empty()
  let mut fields = Vector.make<Shared<Type>>()
  let mut aggregate = false
  let mut array = false
  if run typeMentionsOwner(parameter, fresh) {
    match run bodyNode(&resolver.source, cursor, argument) {
      Node.ArrayExpression {elements: values} => {
        if let Option<ArrayShape>.Some {value} = move Type.arrayShape(&pattern) {
          if value.length != values.length { return run bodyRejection(&resolver.*, module, RejectionCode.ArrayLengthMismatch, span) }
          elements = values
          aggregate = true
          array = true
          fields = run repeatedTypes(&value.element, elements.length)
        }
      }
      Node.TupleExpression {elements: values} => {
        // Only a named tuple pattern supplies element context; otherwise the literal is anonymous.
        if Shared.with<Type, OwnerKind>(&pattern, nominalKind) == OwnerKind.Tuple {
          let queried = run callTupleFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &pattern, span,
          )
          fields = match move queried {
            Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
            Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
          }
          if Vector.length<Shared<Type>>(&fields) != values.length { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
          elements = values
          aggregate = true
        }
      }
      _ => ()
    }
  }
  let mut node = BodyNodeId {index: usize.ZERO}
  if aggregate {
    if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    let mut operands = Vector.make<BodyAggregateField>()
    let mut elementType = Option.none<Shared<Type>>()
    let mut at = usize.ZERO
    while at < elements.length {
      let child = run bodyChild(&resolver.source, cursor, elements, at)
      let patterns = Vector.asSlice<Shared<Type>>(&fields)
      let field = Shared.clone<Type>(&patterns[at])
      let checked = run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        child, &field, signature, captured, fresh, variables, explicit, explicitSyntax,
        &mut inferred.*, call, callSpan, constraints, contractBody, false, unsafeAllowed,
      )
      let operand = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      if at == usize.ZERO { elementType = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &operand) }
      run Vector.append<BodyAggregateField>(&mut operands, BodyAggregateField {index: at, value: operand},
      )
      at = at + usize.ONE
    }
    let mut actual = run callArgumentType(parameter, signature, fresh, Vector.asSlice<Binding>(&inferred.*), caller, call, false,
    )
    if array {
      if let Option<Shared<Type>>.Some {value} = move elementType {
        actual = run Shared.make<Type>(Type.Array {element: move value, extent: run Type.extentText(elements.length)},
        )
      }
    }
    if run typeMentionsOwner(&actual, fresh) { return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, callSpan) }
    node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: argument, span: span},
      kind: BodyNodeKind.Expression {ty: move actual, form: BodyExpression.Aggregate {fields: move operands},
        },
    },
    )
  } else {
    let mut context = run callArgumentContext(parameter, signature, fresh, Vector.asSlice<Binding>(&inferred.*), caller, call,
    )
    // Each inferred representation is independently inferred from its operand. A prior F
    // binding must not contextualize another closure as that exact declaration before matching.
    // A named function value still learns its open binders from the bound's promised contract
    // from positions already determined; the bound itself is proved after matching.
    let mut promised = Option.none<NamedCallableEvidence>()
    if inferredRepresentation {
      context = Option.none<Shared<Type>>()
      promised = run representationPromise(parameter, signature, fresh, Vector.asSlice<Binding>(&inferred.*), caller, call)
    }
    if privateOriginPhase(&resolver.*).phase == usize.ONE && pendingOriginContext(&context) {
      context = Option.none<Shared<Type>>()
    }
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(parameter) {
      context = Option.none<Shared<Type>>()
    }
    if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, argument) {
      context = run rootCallBorrowContext(&context, caller, call)
    } else {
      let mut types = Vector.make<usize>()
      let mut lifetimes = Vector.make<usize>()
      let mut rows = Vector.make<usize>()
      run Type.collectOwned(parameter, fresh, &mut types, &mut lifetimes, &mut rows)
      if Vector.length<usize>(&lifetimes) > usize.ZERO { context = Option.none<Shared<Type>>() }
      context = run referenceArgumentContext(&resolver.source, cursor, argument, &context, caller)
    }
    let mut sliceBorrow = false
    if sliceParameter || (run inferredReferentLifetimes(parameter, fresh)) {
      if let Node.BorrowExpression {access, operand} = run bodyNode(&resolver.source, cursor, argument,
      ) {
        // A concrete slice element types a borrowed array literal; an inferred element does not.
        // Other loans keep the call-region reference context but not its referent stand-ins.
        let mut elementContext = Option.none<Shared<Type>>()
        if sliceParameter {
          elementContext = run concreteSliceContext(parameter, fresh)
        } else if let Option<Shared<Type>>.Some {value} = &context {
          elementContext = Option.some<Shared<Type>>(Shared.clone<Type>(&value))
        }
        let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
          &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, argument, access, operand, &elementContext, sliceParameter,
          call.index, constraints, contractBody, staticBody, unsafeAllowed,
        )
        let borrowed = match move checked {
          Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
          Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: argument, span: span},
          kind: BodyNodeKind.Expression {ty: move borrowed.ty,
            form: BodyExpression.Borrow {access: access, value: borrowed.value},
            },
        },
        )
        sliceBorrow = true
      }
    }
    if !sliceBorrow {
      let mut namedValue = Option.none<Result<BodyNodeId, Shared<Rejection>>>()
      if let Option<NamedCallableEvidence>.Some {..} = &promised {
        namedValue = run checkNamedValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
          argument, &context, &promised, constraints, contractBody, staticBody, unsafeAllowed)
      }
      let checked = match move namedValue {
        Option<Result<BodyNodeId, Shared<Rejection>>>.Some {value: valueResult} => move valueResult
        Option<Result<BodyNodeId, Shared<Rejection>>>.None => run checkExpression(&mut resolver.*, &mut owner.*,
          &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, argument, &context, constraints, contractBody, staticBody, unsafeAllowed)
      }
      node = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
    }
  }
  // Raw mutable callable parameters lend their environment to another raw mutable
  // parameter. Authored constrained F arguments still transfer ownership normally.
  if inferredRepresentation && ordinal >= callableParameterStart {
    let mut mutableTarget = false
    let mut boundAt = usize.ZERO
    while boundAt < boundCount {
      let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, boundAt) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract}} = move bound {
        if run Type.equalsShared(parameter, &representation) {
          mutableTarget = Shared.with<Type, CallableMode>(&contract, callableInvocationMode) == CallableMode.Mutable
        }
      }
      boundAt = boundAt + usize.ONE
    }
    if mutableTarget && run plainMutableCallableParameter(&resolver.source, cursor,
      Vector.asSlice<BodyLocal>(&statementScope.locals.*), Vector.asSlice<BodyNode>(&nodes.*), node, caller) {
      if !mutablePlace(Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyLocal>(&statementScope.locals.*), node) {
        return run bodyRejection(&resolver.*, module, RejectionCode.ExclusiveBorrowRequiresMutable, span)
      }
      let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
        Option<Shared<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} }
      }
      let contract = match move run valueCallableContract(&actual, constraints) {
        Option<Shared<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} }
      }
      let reference = run Shared.make<Type>(Type.Reference {referent: move actual, access: Access.Mutable,
        lifetime: run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: call.index})})
      let borrowed = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: argument, span: span},
        kind: BodyNodeKind.Expression {ty: run Type.callableView(move reference, move contract),
          form: BodyExpression.Borrow {access: Access.Mutable, value: node}}})
      node = borrowed
    }
  }
  // Fresh reference loans use the caller's call region for this inference transaction.
  // Slice reborrows already carry their source region and must retain it, including Static.
  if !sliceParameter {
    if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, argument) {
      let rejected = run contributeBorrowCallRegion(&resolver.*, module, &mut nodes.*, caller, node, call, callSpan,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
      }
    }
  }
  node = run sliceArgument(&mut nodes.*, node, parameter)
  node = run unionArgument(&mut nodes.*, node, parameter)
  node = run pointerArgument(&mut nodes.*, node, parameter, variables, Vector.asSlice<Binding>(&inferred.*),
  )
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, callSpan) }
  }
  let mut failed = run matchCallArgument(&resolver.*, module, callSpan, parameter, &actual, variables, &mut inferred.*, constraints)
  let mismatch = match &failed {
    Option<Shared<Rejection>>.Some {value} => Shared.with<Rejection, bool>(&value, fn(rejection: &Rejection) -> bool {
      return rejection.code == RejectionCode.TypeMismatch
    })
    Option<Shared<Rejection>>.None => false
  }
  // An exact mismatch leaves the bindings unchanged, so the shortened loan is matched against the
  // same inference state.
  if mismatch && !inferredRepresentation {
    let shortened = run shortenedLoan(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, &actual, callSpan)
    if let Option<Shared<Type>>.Some {value: weaker} = move shortened {
      let again = run matchCallArgument(&resolver.*, module, callSpan, parameter, &weaker, variables, &mut inferred.*, constraints)
      if let Option<Shared<Rejection>>.None = move again { failed = Option.none<Shared<Rejection>>() }
    }
  }
  // A remaining mismatch whose only difference is a region its binder already fixed relates the
  // two regions: the operand meets the binder's region, and each caller-local relation typing
  // cannot prove stays open on the body.
  let mut relatable = false
  if let Option<Shared<Rejection>>.Some {value} = &failed {
    relatable = Shared.with<Rejection, bool>(&value, fn(rejection: &Rejection) -> bool {
      return rejection.code == RejectionCode.TypeMismatch
    })
  }
  if relatable && !inferredRepresentation {
    let related = run relatedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      parameter, &pattern, &actual, fresh, caller, variables, Vector.asSlice<Binding>(&inferred.*), explicit, constraints,
      callSpan,
    )
    if let Option<RelatedArgument>.Some {value: candidate} = move related {
      let again = run matchCallArgument(&resolver.*, module, callSpan, parameter, &candidate.ty, variables, &mut inferred.*, constraints)
      if let Option<Shared<Rejection>>.None = move again {
        if run retainRegionPairs(&mut resolver.*, BodyOrigin {syntax: argument, span: span},
          Vector.asSlice<RegionPair>(&candidate.relations)) {
          failed = Option.none<Shared<Rejection>>()
        }
      }
    }
  }
  // A remaining mismatch may be a region meeting a binder that earlier evidence fixed; the binder
  // shortens to the offered region or to the meet of both when nothing observes it invariantly.
  let mut shortenable = false
  if let Option<Shared<Rejection>>.Some {value} = &failed {
    shortenable = !inferredRepresentation && Shared.with<Rejection, bool>(&value, fn(rejection: &Rejection) -> bool {
      return rejection.code == RejectionCode.TypeMismatch
    })
  }
  if shortenable && run shortenedBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, &actual,
    signature, fresh, variables, &mut inferred.*, explicit, callSpan) {
    let again = run matchCallArgument(&resolver.*, module, callSpan, parameter, &actual, variables, &mut inferred.*, constraints)
    if let Option<Shared<Rejection>>.None = move again {
      failed = Option.none<Shared<Rejection>>()
    } else {
      // An operand whose region is one constituent of the new meet reaches it by subtyping.
      let subtyped = run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, &actual,
        fresh, caller, variables, Vector.asSlice<Binding>(&inferred.*), explicit, constraints, callSpan)
      if let Option<RelatedArgument>.Some {value: candidate} = move subtyped {
        let committed = run matchCallArgument(&resolver.*, module, callSpan, parameter, &candidate.ty, variables, &mut inferred.*, constraints)
        if let Option<Shared<Rejection>>.None = move committed {
          if run retainRegionPairs(&mut resolver.*, BodyOrigin {syntax: argument, span: span},
            Vector.asSlice<RegionPair>(&candidate.relations)) {
            failed = Option.none<Shared<Rejection>>()
          }
        }
      }
    }
  }
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    if inferredRepresentation && Shared.with<Rejection, bool>(&value, fn(rejection: &Rejection) -> bool {
      return rejection.code == RejectionCode.TypeMismatch
    }) {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(
        run callableArgumentFailure(&resolver.*, module, &value,
          &actual,
          constraints,
          true,
          sourceInference,
          span, callSpan,
        ),
      )
    }
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
  }
  // Infer representation signature evidence before later operands. Implicit representations
  // that cannot satisfy their promise fail specialization at the whole call. A representation
  // nested in an earlier reached contract follows it, since that contract's inference binds it.
  let mut reached = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut reached, Shared.clone<Type>(parameter))
  let mut boundAt = usize.ZERO
  while boundAt < boundCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, boundAt) },
    )
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract},
    } = move bound {
      if run reachesRepresentation(Vector.asSlice<Shared<Type>>(&reached), &representation, fresh) {
        run Vector.append<Shared<Type>>(&mut reached, Shared.clone<Type>(&contract))
        let representationOrdinal = Shared.with<Type, usize>(
          &representation,
          fn(value: &Type) -> usize {
            return Type.parameterOrdinalOf(value, fresh)
          },
        )
        let inferRepresentation = representationOrdinal != usize.MAX && !fixedOrdinal(explicit, representationOrdinal)
        let sourceRepresentation = run Type.applyBindings(
          &representation,
          Vector.asSlice<Binding>(&inferred.*),
          true,
        )
        let rejected = run inferCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, fresh, constraints,
          &mut inferred.*, &representation, &contract, span,
        )
        if let Option<Shared<Rejection>>.Some {value} = move rejected {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(run callableArgumentFailure(
              &resolver.*,
              module,
              &value,
              &sourceRepresentation,
              constraints,
              inferRepresentation,
              sourceInference,
              span,
              callSpan,
            ),
          )
        }
        let applied = run Type.applyBindings(&contract, Vector.asSlice<Binding>(&inferred.*), true)
        let mut incompatible = Option.none<Shared<Rejection>>()
        if !Shared.with<Type, bool>(&sourceRepresentation, genericSectionType) || !run sectionContextUndetermined(&applied, fresh) {
          incompatible = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &sourceRepresentation, &applied, span)
        }
        let inferredEnvironment = Shared.with<Type, bool>(&contract, fn(value: &Type) -> bool { return environmentBinder(value, fresh) })
        let mismatched = match &incompatible {
          Option<Shared<Rejection>>.Some {..} => true
          Option<Shared<Rejection>>.None => false
        }
        if mismatched && inferredEnvironment {
          let related = run relatedEffectEnvironment(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints,
            &sourceRepresentation, &applied, caller, span)
          if let Option<Vector<RegionPair>>.Some {value: relations} = move related {
            if run retainRegionPairs(&mut resolver.*, BodyOrigin {syntax: argument, span: span}, Vector.asSlice<RegionPair>(&relations)) {
              incompatible = Option.none<Shared<Rejection>>()
            }
          }
          let unrelated = match &incompatible {
            Option<Shared<Rejection>>.Some {..} => true
            Option<Shared<Rejection>>.None => false
          }
          if unrelated {
            if run shortenedEnvironmentBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, &contract,
              &sourceRepresentation, signature, captured, fresh, variables, &mut inferred.*, explicit, constraints, span) {
              let shortened = run Type.applyBindings(&contract, Vector.asSlice<Binding>(&inferred.*), true)
              incompatible = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints,
                &sourceRepresentation, &shortened, span)
            }
          }
        }
        if let Option<Shared<Rejection>>.Some {value} = move incompatible {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(run callableArgumentFailure(
              &resolver.*,
              module,
              &value,
              &sourceRepresentation,
              constraints,
              inferRepresentation,
              sourceInference,
              span,
              callSpan,
            ),
          )
        }
      }
    }
    boundAt = boundAt + usize.ONE
  }
  // Exact callable representations own their environment. An affine place cannot be
  // copied into a by-value argument; fresh values and explicit moves are already transfers.
  let callable = run callableArgumentContract(&actual, constraints)
  if let Option<Shared<Type>>.Some {..} = move callable {
    let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &actual, constraints, span)
    let copy = match move copied {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    if !copy {
      if Shared.with<Type, bool>(&actual, fn(value: &Type) -> bool {
        return match &value.* { Type.Callable {..} => true _ => false }
      }) { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      let transfer = run consumption(&resolver.source, cursor, Vector.asSlice<BodyNode>(&nodes.*), node)
      let mut code = Option.none<RejectionCode>()
      match move transfer {
        Consumption.Rvalue => ()
        Consumption.Borrowed => { code = Option.some<RejectionCode>(RejectionCode.BorrowedExtraction) }
        Consumption.Boundary => { code = Option.some<RejectionCode>(RejectionCode.ExtractionBoundary) }
        Consumption.Escape {..} => { code = Option.some<RejectionCode>(RejectionCode.MatchBorrowEscape) }
        Consumption.Place {..} => {
          let movedPattern = match &Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
            BodyNodeKind.Expression {form: BodyExpression.PatternBinding {access, ..}, ..} => access == BodyBindingAccess.Moved
            _ => false
          }
          if movedPattern {
            // A moved match binding already owns its part of the subject. Its consuming
            // argument transfers that part implicitly, recording the same cleanup hole as move.
            let selected = run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*,
              module, cursor, Vector.asSlice<BodyNode>(&nodes.*), node, false, false, span, span, constraints)
            let consumed = match move selected {
              Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
              Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
              }
            }
            let moved = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
            run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
              origin: BodyOrigin {syntax: argument, span: span},
              kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(&actual),
                form: BodyExpression.Move {value: node, consumed: move consumed}},
            })
            node = moved
          } else if Shared.with<Type, bool>(&actual, unconsumedArgument) {
            // The bootstrap does not consume an Effect or callable value whose run access is not
            // `once` when it is passed by value; native has no such non-consuming argument yet.
            code = Option.some<RejectionCode>(RejectionCode.Unsupported)
          } else {
            code = Option.some<RejectionCode>(RejectionCode.ExplicitMoveRequired)
          }
        }
        Consumption.PlaceBinding => { code = Option.some<RejectionCode>(RejectionCode.Unsupported) }
      }
      if let Option<RejectionCode>.Some {value} = move code {
        return run bodyRejection(&resolver.*, module, value, span)
      }
    }
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
}

// An Effect or callable value (not a reference to one) that the bootstrap may pass by value without
// consuming its place: one whose run access is shared or mutable (`argumentConsumes`), or the Effect
// an anonymous `effect fn` value's invocation produced. Native types the latter at its contract's
// promised access, while the bootstrap derives it from the retained environment (COMPOSE-001).
fn unconsumedArgument(value: &Type) -> bool {
  return match &value.* {
    Type.Reference {..} => false
    Type.Effect {..} => true
    _ => callableInvocationMode(value) != CallableMode.Once
  }
}

// A source-written mutable callable parameter is a reusable environment view in the
// bootstrap. Forwarding that view needs a retained reborrow, not a copy of its exact F.
// Keep the source role narrow: owned generic values and explicit moves are not views.
effect fn plainMutableCallableParameter(source: &SourceIndex, cursor: &AuthoredCursor,
  locals: &[BodyLocal], nodes: &[BodyNode], node: BodyNodeId, caller: &DeclarationId) -> bool
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} = &nodes[node.index].kind {
    let ordinal = Shared.with<Type, usize>(&ty,
      fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, caller) })
    if ordinal == usize.MAX { return false }
    if let Node.Parameter {annotation, ..} = run bodyNode(source, cursor, locals[local.index].origin.syntax) {
      if let Node.CallableType {mode, ..} = run bodyNode(source, cursor, annotation) {
        return mode == CallableMode.Mutable
      }
    }
  }
  return false
}

// Generated raw representation slots retain their source role through aliases and captures.
// Authored F slots remain owners even when their callable bounds are nonshared.
effect fn unknownOwnedCallableReturn(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, nodes: &[BodyNode], node: BodyNodeId,
  span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let ty = match move bodyExpressionType(nodes, &node) {
    Option<Shared<Type>>.Some {value} => move value _ => { return Option.none<Shared<Rejection>>() }
  }
  return run unknownOwnedCallableTypeReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ty, span)
}

effect fn unknownOwnedCallableTypeReturn(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, ty: &Shared<Type>, span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(ty)
  if let Type.CallableView {representation, ..} = &copied {
    return run unknownOwnedCallableTypeReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &representation, span)
  }
  if let Type.Parameter {declaration, ordinal: parameterOrdinal} = move copied {
    // Function and ordinary anonymous headers introduce raw representation slots. Outer
    // authored parameters retain their original owner and never acquire the anonymous role.
    let kind = DeclarationId.kind(&declaration)
    if kind != OwnerKind.Function && kind != OwnerKind.Anonymous { return Option.none<Shared<Rejection>>() }
    let originalModule = DeclarationId.moduleId(&declaration)
    let sharedDeclaration = run Shared.make<DeclarationId>(run DeclarationId.copy(&declaration))
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, originalModule, &sharedDeclaration) {
      Option<usize>.Some {value} => value
      _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let originalModuleOrdinal = knownModuleOrdinal(&resolver.*, originalModule)
    let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
      family: Family.Signature, module: originalModuleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false}, span)
    let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&signature, answerRejection)
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option.some<Shared<Rejection>>(move value)
    }
    let start = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureCallableParameterStart)
    if parameterOrdinal < start { return Option.none<Shared<Rejection>>() }
    let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureConstraintCount)
    let mut at = usize.ZERO
    while at < count {
      let selected = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&signature,
        fn(value: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(value, at) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: slot, contract}} = move selected {
        let originalSlot = Shared.with<Type, usize>(&slot,
          fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, &declaration) })
        if originalSlot == parameterOrdinal {
          let rawOwnedCallable = Shared.with<Type, bool>(&contract, fn(value: &Type) -> bool {
            return match &value.* { Type.Callable {mode, ..} => mode != CallableMode.Shared _ => false }
          })
          if rawOwnedCallable {
            return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnknownOwnedCallableReturn, span))
          }
          return Option.none<Shared<Rejection>>()
        }
      }
      at = at + usize.ONE
    }
    return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Option.none<Shared<Rejection>>()
}

// Whether an unapplied Effect contract's environment is a lifetime binder of the inference owner.
// Only such an environment was fixed by evidence; a written lifetime is a contract.
fn environmentBinder(contract: &Type, fresh: &DeclarationId) -> bool {
  if let Type.Effect {environment, ..} = &contract.* {
    return Shared.with<Intersection, bool>(&environment, fn(value: &Intersection) -> bool { return binderMember(value, fresh) })
  }
  return false
}

fn binderMember(value: &Intersection, fresh: &DeclarationId) -> bool {
  let members = Vector.asSlice<LifetimeMember>(&value.members)
  let mut at = usize.ZERO
  while at < members.length {
    let ordinal = Shared.with<Lifetime, usize>(&members[at].region, fn(region: &Lifetime) -> usize { return lifetimeOrdinalOf(region, fresh) })
    if ordinal != usize.MAX { return true }
    at = at + usize.ONE
  }
  return false
}

// An Effect environment binder fixed by earlier evidence, such as a section's captured provider
// loan or a 'static callable, meets an operand retaining a distinct caller-local region. The
// environments relate (`environmentRelations`) when the bound holds once each such relation is a
// premise, the same premises the call's remaining bound proofs receive (`retainedRelationPremises`);
// None when the environment is not the only mismatch.
effect fn relatedEffectEnvironment(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, constraints: &[Constraint], source: &Shared<Type>,
  wanted: &Shared<Type>, caller: &DeclarationId, span: Span) -> Option<Vector<RegionPair>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let offered = match move run valueCallableContract(source, constraints) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Option.none<Vector<RegionPair>>() }
  }
  let retained = match move run Type.copy(&offered) {
    Type.Effect {environment, ..} => environment
    _ => { return Option.none<Vector<RegionPair>>() }
  }
  let localRetained = Shared.with<Intersection, bool>(&retained, fn(value: &Intersection) -> bool {
    let members = Vector.asSlice<LifetimeMember>(&value.members)
    let mut at = usize.ZERO
    while at < members.length {
      if callerLocalRegion(&members[at].region, caller) { return true }
      at = at + usize.ONE
    }
    return false
  })
  if !localRetained { return Option.none<Vector<RegionPair>>() }
  let bound = match move run Type.copy(wanted) {
    Type.Effect {environment, ..} => environment
    _ => { return Option.none<Vector<RegionPair>>() }
  }
  let mut relations = Vector.make<RegionPair>()
  run environmentRelations(&retained, &bound, caller, &mut relations)
  let mut premises = run copyConstraints(constraints)
  run appendRegionPremises(Vector.asSlice<RegionPair>(&relations), &mut premises)
  let failed = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    Vector.asSlice<Constraint>(&premises), source, wanted, span)
  if let Option<Shared<Rejection>>.Some {..} = move failed { return Option.none<Vector<RegionPair>>() }
  return Option.some<Vector<RegionPair>>(move relations)
}

// An Effect environment binder that an earlier operand fixed, such as `'env` of
// `JsonObject.field` fixed by the section's `"x"` before its piped Effect is checked, shortens to
// the meet of that region and the regions the piped Effect retains, as the bootstrap's region
// inference chooses the shortest region (LIFE-002). As in `shortenedBinder`, a written binder or a
// binder holding a call loan never moves and every parameter, including the `captured` ones the
// section already bound, must store the binder covariantly, so each earlier operand still meets
// it; the caller then proves the bound again.
effect fn shortenedEnvironmentBinder(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  contract: &Shared<Type>, source: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  captured: &[Shared<Type>], fresh: &DeclarationId, variables: &[Shared<DeclarationId>], inferred: &mut Vector<Binding>,
  explicit: &[usize], constraints: &[Constraint], span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let promised = match move run Type.copy(contract) {
    Type.Effect {environment, ..} => environment
    _ => { return false }
  }
  let promisedRegions = run callableEnvironmentRegions(&promised)
  let listedPromise = Vector.asSlice<Shared<Lifetime>>(&promisedRegions)
  if listedPromise.length != usize.ONE { return false }
  let ordinal = Shared.with<Lifetime, usize>(&listedPromise[usize.ZERO],
    fn(region: &Lifetime) -> usize { return lifetimeOrdinalOf(region, fresh) })
  if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) { return false }
  let bindings = Vector.asSlice<Binding>(&inferred.*)
  let mut chosen = usize.MAX
  let mut at = usize.ZERO
  while at < bindings.length && chosen == usize.MAX {
    if bindings[at].ordinal == ordinal && Shared.with<DeclarationId, bool>(&bindings[at].declaration,
      fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, fresh) }) {
      chosen = at
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX { return false }
  let earlier = match &bindings[chosen].value {
    Argument.Lifetime {value} => Shared.clone<Lifetime>(&value)
    _ => { return false }
  }
  drop bindings
  if variableCallLoan(&earlier, variables) { return false }
  let offered = match move run valueCallableContract(source, constraints) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return false }
  }
  let retained = match move run Type.copy(&offered) {
    Type.Effect {environment, ..} => environment
    _ => { return false }
  }
  let mut members = run callableEnvironmentRegions(&retained)
  let offeredRegions = Vector.asSlice<Shared<Lifetime>>(&members)
  at = usize.ZERO
  while at < offeredRegions.length {
    if variableCallLoan(&offeredRegions[at], variables) { return false }
    at = at + usize.ONE
  }
  drop offeredRegions
  run Vector.append<Shared<Lifetime>>(&mut members, Shared.clone<Lifetime>(&earlier))
  let shorter = run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&members))
  if Lifetime.equalsShared(&shorter, &earlier) { return false }
  let mut parameters = run signatureParameterTypes(signature)
  at = usize.ZERO
  while at < captured.length {
    run Vector.append<Shared<Type>>(&mut parameters, Shared.clone<Type>(&captured[at]))
    at = at + usize.ONE
  }
  if !run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, Vector.asSlice<Shared<Type>>(&parameters),
    fresh, ordinal, span) { return false }
  let replaced = Vector.asMutSlice<Binding>(&mut inferred.*)
  replaced[chosen].value = Argument.Lifetime {value: move shorter}
  return true
}

// Each admitted pair as the premise it stands for: the offered region outlives the region its
// boundary fixed. The pair itself stays open on the body as a `RegionRelation` obligation.
effect fn appendRegionPremises(pairs: &[RegionPair], premises: &mut Vector<Constraint>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < pairs.length {
    run Vector.append<Constraint>(&mut premises.*, Constraint.Outlives {longer: Shared.clone<Lifetime>(&pairs[at].offered),
      shorter: Shared.clone<Lifetime>(&pairs[at].wanted)})
    at = at + usize.ONE
  }
  return ()
}

// The relations of an operand environment `offered` admitted where `wanted` is bound: each
// caller-local region of `offered` that `wanted` does not name pairs with every region `wanted`
// names, or with 'static when it names none.
effect fn environmentRelations(offered: &Shared<Intersection>, wanted: &Shared<Intersection>, caller: &DeclarationId,
  relations: &mut Vector<RegionPair>) -> () ! OutOfMemoryError ? &mut Allocator {
  let offeredRegions = run callableEnvironmentRegions(offered)
  let mut wantedRegions = run callableEnvironmentRegions(wanted)
  let listed = Vector.asSlice<Shared<Lifetime>>(&offeredRegions)
  let mut covered = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < listed.length {
    let bound = Vector.asSlice<Shared<Lifetime>>(&wantedRegions)
    let mut named = false
    let mut position = usize.ZERO
    while position < bound.length {
      if Lifetime.equalsShared(&listed[at], &bound[position]) { named = true }
      position = position + usize.ONE
    }
    run Vector.append<bool>(&mut covered, named || !callerLocalRegion(&listed[at], caller))
    at = at + usize.ONE
  }
  if Vector.length<Shared<Lifetime>>(&wantedRegions) == usize.ZERO {
    run Vector.append<Shared<Lifetime>>(&mut wantedRegions, run Shared.make<Lifetime>(Lifetime.Static))
  }
  let bound = Vector.asSlice<Shared<Lifetime>>(&wantedRegions)
  let skipped = Vector.asSlice<bool>(&covered)
  at = usize.ZERO
  while at < listed.length {
    if !skipped[at] {
      let mut position = usize.ZERO
      while position < bound.length {
        run Vector.append<RegionPair>(&mut relations.*, RegionPair {offered: Shared.clone<Lifetime>(&listed[at]),
          wanted: Shared.clone<Lifetime>(&bound[position])})
        position = position + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn callerLocalRegion(region: &Shared<Lifetime>, caller: &DeclarationId) -> bool {
  return Lifetime.allAtoms(region, fn(value: &Lifetime) -> bool {
    if let Lifetime.Local {declaration, ..} = &value.* {
      return DeclarationId.equals(&declaration, caller)
    }
    return false
  })
}

// A shared loan `&'x T` requires `T: 'x` (LIFE-002). When an exact match fails, each lifetime of
// `T` that the parameter writes as its own loan lifetime, in a covariant position, may shorten to
// `'x`; every other lifetime keeps its evidence. Variance follows the bootstrap NominalVariance.
// None means the argument is not a shared loan against a shared loan parameter.
effect fn shortenedLoan(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  pattern: &Shared<Type>, actual: &Shared<Type>, span: Span,
) -> Option<Shared<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut active = Vector.make<DeclarationId>()
  let wanted = run Type.copy(pattern)
  match move run Type.copy(actual) {
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: loan} = move wanted {
        if access != Access.Shared || writtenAccess != Access.Shared { return Option.none<Shared<Type>>() }
        let shortened = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &referent, &loan, &lifetime, &mut active, span)
        return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Reference {referent: move shortened, access: access, lifetime: move lifetime}))
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: loan} = move wanted {
        if access != Access.Shared || writtenAccess != Access.Shared { return Option.none<Shared<Type>>() }
        let shortened = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &element, &loan, &lifetime, &mut active, span)
        return Option.some<Shared<Type>>(run Shared.make<Type>(Type.Slice {element: move shortened, access: access, lifetime: move lifetime}))
      }
    }
    _ => {}
  }
  return Option.none<Shared<Type>>()
}

// Shortens `actual` to `region` exactly where `pattern` writes `loan` in a covariant position of a
// shared referent. Exclusive referents, pointees, type arguments and unclassified forms stay exact.
effect fn shortenAgainst(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  pattern: &Shared<Type>, actual: &Shared<Type>, loan: &Shared<Lifetime>, region: &Shared<Lifetime>,
  active: &mut Vector<DeclarationId>, span: Span,
) -> Shared<Type>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let wanted = run Type.copy(pattern)
  match move run Type.copy(actual) {
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: writtenLifetime} = move wanted {
        if access == writtenAccess {
          let mut validity = move lifetime
          if Lifetime.equalsShared(&writtenLifetime, loan) { validity = Shared.clone<Lifetime>(region) }
          let mut inner = Shared.clone<Type>(&referent)
          if access == Access.Shared {
            inner = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &referent, loan, region, &mut active.*, span)
          }
          return run Shared.make<Type>(Type.Reference {referent: move inner, access: access, lifetime: move validity})
        }
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: writtenLifetime} = move wanted {
        if access == writtenAccess {
          let mut validity = move lifetime
          if Lifetime.equalsShared(&writtenLifetime, loan) { validity = Shared.clone<Lifetime>(region) }
          let mut inner = Shared.clone<Type>(&element)
          if access == Access.Shared {
            inner = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &element, loan, region, &mut active.*, span)
          }
          return run Shared.make<Type>(Type.Slice {element: move inner, access: access, lifetime: move validity})
        }
      }
    }
    Type.String {..} => {
      if let Type.String {lifetime: writtenLifetime} = move wanted {
        if Lifetime.equalsShared(&writtenLifetime, loan) {
          return run Shared.make<Type>(Type.String {lifetime: Shared.clone<Lifetime>(region)})
        }
      }
    }
    Type.Array {element, extent} => {
      if let Type.Array {element: written, ..} = move wanted {
        let inner = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &element, loan, region, &mut active.*, span)
        return run Shared.make<Type>(Type.Array {element: move inner, extent: move extent})
      }
    }
    Type.Nominal {declaration, isPublic, arguments} => {
      if let Type.Nominal {declaration: writtenDeclaration, arguments: writtenArguments, ..} = move wanted {
        let listed = Vector.asSlice<Argument>(&arguments)
        let writtenListed = Vector.asSlice<Argument>(&writtenArguments)
        if DeclarationId.equals(&declaration, &writtenDeclaration) && listed.length == writtenListed.length {
          let mut shortened = Vector.make<Argument>()
          let mut at = usize.ZERO
          while at < listed.length {
            let mut next = Argument.copy(&listed[at])
            if let Argument.Lifetime {value: written} = &writtenListed[at] {
              if Lifetime.equalsShared(&written, loan) {
                if run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, listed, at, &mut active.*, span) {
                  next = Argument.Lifetime {value: Shared.clone<Lifetime>(region)}
                }
              }
            }
            run Vector.append<Argument>(&mut shortened, move next)
            at = at + usize.ONE
          }
          return run Shared.make<Type>(Type.Nominal {declaration: move declaration, isPublic: isPublic, arguments: move shortened})
        }
      }
    }
    _ => {}
  }
  return Shared.clone<Type>(actual)
}

// Whether binder `ordinal` of a struct, tuple, union or enum, a lifetime or a type, occurs only in
// covariant storage positions of its own generic fields (bootstrap NominalVariance). Services,
// interfaces and other declarations, row binders, a declaration already being summarized, and an
// unavailable member shape are invariant.
// ponytail: recomputed per use through cached member-shape queries; add a per-declaration summary
// query when profiles show this matters.
effect fn covariantParameter(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  declaration: &DeclarationId, arguments: &[Argument], ordinal: usize, active: &mut Vector<DeclarationId>, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let kind = DeclarationId.kind(declaration)
  if kind != OwnerKind.Struct && kind != OwnerKind.Tuple && kind != OwnerKind.Union && kind != OwnerKind.Enumeration { return false }
  let prior = Vector.asSlice<DeclarationId>(&active.*)
  let mut seen = usize.ZERO
  while seen < prior.length {
    if DeclarationId.equals(&prior[seen], declaration) { return false }
    seen = seen + usize.ONE
  }
  // The identity application names each binder by itself, so the fields mention binder `ordinal`.
  let mut generic = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < arguments.length {
    match &arguments[at] {
      Argument.Type {..} => {
        let parameter = run Shared.make<Type>(Type.Parameter {declaration: run DeclarationId.copy(declaration), ordinal: at})
        run Vector.append<Argument>(&mut generic, Argument.Type {value: move parameter})
      }
      Argument.Lifetime {..} => {
        let parameter = run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(declaration), ordinal: at})
        run Vector.append<Argument>(&mut generic, Argument.Lifetime {value: move parameter})
      }
      _ => { return false }
    }
    at = at + usize.ONE
  }
  let generics = Vector.asSlice<Argument>(&generic)
  let marker = Argument.copy(&generics[ordinal])
  let identity = run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(declaration), isPublic: true, arguments: move generic})
  // Covariance requires authored member evidence. Opaque core storage and unavailable shapes
  // cannot use the empty structural-parts answer that other ownership consumers accept.
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, &identity)
  if moduleOrdinal == usize.MAX { return false }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let found = run ordinalOfProvider(&mut resolver.*, &declaredModule, &identity)
  let declarationOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let written = run header(&mut resolver.*, &declaredModule, declarationOrdinal)
  let count = match move written {
    Option<HeaderSyntax>.Some {value} => match value.header {
      Node.StructHeader {fields, ..} => fields.length
      Node.TupleHeader {elements, ..} => elements.length
      Node.UnionHeader {variants, ..} => variants.length
      Node.EnumHeader {..} => usize.ZERO
      _ => usize.MAX
    }
    Option<HeaderSyntax>.None => usize.MAX
  }
  if count == usize.MAX { return false }
  let application = run internApplication(&mut resolver.*, &identity)
  run Vector.append<DeclarationId>(&mut active.*, run DeclarationId.copy(declaration))
  let mut covariant = true
  let mut member = usize.ZERO
  while covariant && member < count {
    let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declarationOrdinal, member: member, external: false,
    }, span)
    let length = Shared.with<Result<Answer, NoRejection>, usize>(&shape, shapeLength)
    if length == usize.MAX { covariant = false }
    let mut part = usize.ZERO
    while covariant && part < length {
      let stored = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&shape,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return shapeTypeAt(answer, part) })
      match move stored {
        Option<Shared<Type>>.Some {value} => {
          covariant = run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &value, &marker, true, &mut active.*, span)
        }
        Option<Shared<Type>>.None => { covariant = false }
      }
      part = part + usize.ONE
    }
    member = member + usize.ONE
  }
  drop Vector.pop<DeclarationId>(&mut active.*)
  return covariant
}

// Whether `region` is the lifetime binder `marker` names.
fn markedRegion(region: &Shared<Lifetime>, marker: &Argument) -> bool {
  return match &marker.* {
    Argument.Lifetime {value} => Lifetime.equalsShared(region, &value)
    _ => false
  }
}

// Whether `marker`, a lifetime or type binder, occurs in `value` only in covariant positions; with
// `covariant` false, whether it does not occur at all. A shared referent, a shared slice element, an
// array element and a covariant nominal argument keep their position's variance; exclusive referents,
// pointees and every unclassified form are conservatively invariant.
effect fn flowsCovariantly(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  value: &Shared<Type>, marker: &Argument, covariant: bool, active: &mut Vector<DeclarationId>, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Argument.Type {value: binder} = &marker.* {
    if run Type.equalsShared(value, &binder) { return covariant }
  }
  match move run Type.copy(value) {
    Type.Primitive {..} => { return true }
    Type.Unit => { return true }
    Type.Parameter {..} => { return true }
    Type.String {lifetime} => { return covariant || !markedRegion(&lifetime, marker) }
    Type.Reference {referent, access, lifetime} => {
      if !covariant && markedRegion(&lifetime, marker) { return false }
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &referent, marker,
        covariant && access == Access.Shared, &mut active.*, span)
    }
    Type.Slice {element, access, lifetime} => {
      if !covariant && markedRegion(&lifetime, marker) { return false }
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, marker,
        covariant && access == Access.Shared, &mut active.*, span)
    }
    Type.Pointer {pointee, ..} => {
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &pointee, marker, false, &mut active.*, span)
    }
    Type.Array {element, ..} => {
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, marker, covariant, &mut active.*, span)
    }
    Type.Nominal {declaration, arguments, ..} => {
      let listed = Vector.asSlice<Argument>(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        match &listed[at] {
          Argument.Lifetime {value: argument} => {
            if markedRegion(&argument, marker) {
              if !covariant { return false }
              if !run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, listed, at, &mut active.*, span) {
                return false
              }
            }
          }
          Argument.Type {value: argument} => {
            let flows = covariant
              && run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, listed, at, &mut active.*, span)
            if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &argument, marker, flows, &mut active.*, span) {
              return false
            }
          }
          // ponytail: a requirement row is treated as mentioning every binder.
          _ => { return false }
        }
        at = at + usize.ONE
      }
      return true
    }
    _ => { return false }
  }
}

// A region a boundary admitted where it fixes another region without proof, before the body
// retains the pair as a `RegionRelation` safety obligation.
struct RegionPair {
  offered: Shared<Lifetime>
  wanted: Shared<Lifetime>
}

// A call argument admitted at its binder's already fixed region, with the relations it needs.
struct RelatedArgument {
  ty: Shared<Type>
  relations: Vector<RegionPair>
}

// One covariant region pair at a boundary. A pair the body's declared outlives premises prove is
// admitted (`knownOutlives`: equal regions, an offered 'static, an enclosing declaration's lifetime
// offered where a caller-local loan is wanted, or a chain of declared bounds such as `'data: 'view`).
// A caller-local offered region meeting any other non-static region is a relation typing cannot
// prove yet; it is deferred as a pair. Every other pair, including a fixed 'static expectation of a
// shorter region, is a mismatch.
effect fn admitsRegion(offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>, caller: &DeclarationId,
  constraints: &[Constraint], deferred: &mut Vector<RegionPair>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if run knownOutlives(constraints, offered, wanted) { return true }
  if !callerLocalRegion(offered, caller) || Shared.with<Lifetime, bool>(wanted, staticLifetime) { return false }
  run Vector.append<RegionPair>(&mut deferred.*, RegionPair {offered: Shared.clone<Lifetime>(offered),
    wanted: Shared.clone<Lifetime>(wanted)})
  return true
}

// The type a type argument names; none for a lifetime or row argument.
fn argumentType(value: &Argument) -> Option<Shared<Type>> {
  return match &value.* {
    Argument.Type {value: argument} => Option.some<Shared<Type>>(Shared.clone<Type>(&argument))
    _ => Option.none<Shared<Type>>()
  }
}

// The region a lifetime argument names; none for a type or row argument.
fn argumentRegion(value: &Argument) -> Option<Shared<Lifetime>> {
  return match &value.* {
    Argument.Lifetime {value: region} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&region))
    _ => Option.none<Shared<Lifetime>>()
  }
}

// Whether two type or row arguments are exactly equal.
effect fn sameExactArgument(left: &Argument, right: &Argument) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Argument.Type {value} = &left.* {
    if let Argument.Type {value: other} = &right.* { return run Type.equalsShared(&value, &other) }
    return false
  }
  if let Argument.Row {value} = &left.* {
    if let Argument.Row {value: other} = &right.* { return run Row.equalsShared(&value, &other) }
    return false
  }
  return false
}

// Whether `offered` meets `wanted` by covariant region subtyping (LIFE-002). Variance follows the
// bootstrap NominalVariance: reference, slice and `string` regions are covariant, a shared referent
// and an array element keep their position's variance, and a nominal lifetime or type argument is
// covariant only when `covariantParameter` proves it. Exclusive referents, pointees, requirement
// rows and every other form stay exact. `admitsRegion` decides each covariant region pair.
effect fn admitsRegions(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  offered: &Shared<Type>, wanted: &Shared<Type>, caller: &DeclarationId, constraints: &[Constraint], covariant: bool,
  deferred: &mut Vector<RegionPair>, active: &mut Vector<DeclarationId>, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if run Type.equalsShared(offered, wanted) { return true }
  if !covariant { return false }
  let target = run Type.copy(wanted)
  match move run Type.copy(offered) {
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: writtenLifetime} = move target {
        if access != writtenAccess { return false }
        if !run admitsRegion(&lifetime, &writtenLifetime, caller, constraints, &mut deferred.*) { return false }
        return run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &referent, &written, caller, constraints,
          access == Access.Shared, &mut deferred.*, &mut active.*, span)
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: writtenLifetime} = move target {
        if access != writtenAccess { return false }
        if !run admitsRegion(&lifetime, &writtenLifetime, caller, constraints, &mut deferred.*) { return false }
        return run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, &written, caller, constraints,
          access == Access.Shared, &mut deferred.*, &mut active.*, span)
      }
    }
    Type.String {lifetime} => {
      if let Type.String {lifetime: writtenLifetime} = move target {
        return run admitsRegion(&lifetime, &writtenLifetime, caller, constraints, &mut deferred.*)
      }
    }
    Type.Array {element, extent} => {
      if let Type.Array {element: written, extent: writtenExtent} = move target {
        if !same(Bytes.asSlice(&extent), Bytes.asSlice(&writtenExtent)) { return false }
        return run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, &written, caller, constraints,
          true, &mut deferred.*, &mut active.*, span)
      }
    }
    Type.Nominal {declaration, arguments, ..} => {
      if let Type.Nominal {declaration: writtenDeclaration, arguments: writtenArguments, ..} = move target {
        let listed = Vector.asSlice<Argument>(&arguments)
        let writtenListed = Vector.asSlice<Argument>(&writtenArguments)
        if !DeclarationId.equals(&declaration, &writtenDeclaration) || listed.length != writtenListed.length { return false }
        let mut at = usize.ZERO
        while at < listed.length {
          let region = argumentRegion(&listed[at])
          let writtenRegion = argumentRegion(&writtenListed[at])
          if let Option<Shared<Lifetime>>.Some {value: offeredRegion} = move region {
            let boundRegion = match move writtenRegion {
              Option<Shared<Lifetime>>.Some {value} => value
              Option<Shared<Lifetime>>.None => { return false }
            }
            if !Lifetime.equalsShared(&offeredRegion, &boundRegion) {
              if !run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, listed, at,
                &mut active.*, span) { return false }
              if !run admitsRegion(&offeredRegion, &boundRegion, caller, constraints, &mut deferred.*) { return false }
            }
          } else if !run sameExactArgument(&listed[at], &writtenListed[at]) {
            let offeredType = argumentType(&listed[at])
            let writtenType = argumentType(&writtenListed[at])
            if let Option<Shared<Type>>.Some {value: offeredArgument} = move offeredType {
              if let Option<Shared<Type>>.Some {value: writtenArgument} = move writtenType {
                if !run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, listed, at,
                  &mut active.*, span) { return false }
                if !run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &offeredArgument, &writtenArgument,
                  caller, constraints, true, &mut deferred.*, &mut active.*, span) { return false }
                at = at + usize.ONE
                continue
              }
            }
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
    }
    _ => {}
  }
  return false
}

// The ordinal of an inference binder `fresh` owns, or usize.MAX for any other region.
fn freshLifetimeOrdinal(region: &Shared<Lifetime>, fresh: &DeclarationId) -> usize {
  return Shared.with<Lifetime, usize>(region, fn(value: &Lifetime) -> usize {
    if let Lifetime.Parameter {declaration, ordinal} = &value.* {
      if DeclarationId.equals(&declaration, fresh) { return ordinal }
    }
    return usize.MAX
  })
}

// Whether a later operand's covariant region `source` meets `bound`, the region an earlier operand
// fixed for the same inferred binder: a caller-local region or inferred 'static. An offered
// 'static, or the caller's own lifetime against a caller-local loan, outlives it, which is proven.
// A caller-local region, or any region where the
// binder holds 'static (inferred 'static evidence never requires 'static), relates to `bound` as a
// pair typing cannot prove yet. A bound declared region, and any other pair, is a mismatch.
effect fn relatesToFixedRegion(bound: &Shared<Lifetime>, source: &Shared<Lifetime>, caller: &DeclarationId,
  relations: &mut Vector<RegionPair>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if Lifetime.equalsShared(bound, source) { return false }
  let staticBound = Shared.with<Lifetime, bool>(bound, staticLifetime)
  if !staticBound && !callerLocalRegion(bound, caller) { return false }
  if Shared.with<Lifetime, bool>(source, staticLifetime) || enclosingLifetimeOutlivesLoan(source, bound) { return true }
  if !staticBound && !callerLocalRegion(source, caller) { return false }
  run Vector.append<RegionPair>(&mut relations.*, RegionPair {offered: Shared.clone<Lifetime>(source),
    wanted: Shared.clone<Lifetime>(bound)})
  return true
}

// The region an inferred lifetime binder shortens to when a later operand offers it a different
// region, as the bootstrap's region inference chooses the shortest region (LIFE-002): a binder fixed
// to 'static takes the offered region, and any other binder takes the complete meet of both. A
// written binder, a binder holding a call loan and an offered 'static region never move it.
effect fn binderMeet(
  parameter: &Shared<Type>, actual: &Shared<Type>, variables: &[Shared<DeclarationId>], bindings: &[Binding], at: usize,
  explicit: &[usize],
) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let ordinal = bindings[at].ordinal
  let fixed = match &bindings[at].value {
    Argument.Lifetime {value} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&value))
    _ => Option.none<Shared<Lifetime>>()
  }
  let mut held = Option.none<Shared<Lifetime>>()
  if !fixedOrdinal(explicit, ordinal) {
    if let Option<Shared<Lifetime>>.Some {value: region} = move fixed {
      if !variableCallLoan(&region, variables) { held = Option.some<Shared<Lifetime>>(move region) }
    }
  }
  let earlier = match move held {
    Option<Shared<Lifetime>>.Some {value} => value
    Option<Shared<Lifetime>>.None => { return Option.none<Shared<Lifetime>>() }
  }
  let mut trial = Vector.make<Binding>()
  let mut copied = usize.ZERO
  while copied < bindings.length {
    if copied != at {
      run Vector.append<Binding>(&mut trial, Binding {declaration: Shared.clone<DeclarationId>(&bindings[copied].declaration),
        ordinal: bindings[copied].ordinal, value: Argument.copy(&bindings[copied].value)})
    }
    copied = copied + usize.ONE
  }
  let unified = run Type.unify(parameter, actual, variables, Comparison.Exact, &mut trial)
  let mut region = Option.none<Shared<Lifetime>>()
  let matched = match &unified {
    Unification.Unified => true
    _ => false
  }
  if matched {
    if let Option<Argument>.Some {value: Argument.Lifetime {value: offered}} = move bindingArgumentAt(Vector.asSlice<Binding>(&trial), ordinal) {
      if !Lifetime.equalsShared(&offered, &earlier) && !Shared.with<Lifetime, bool>(&offered, staticLifetime)
        && !variableCallLoan(&offered, variables) {
        if Shared.with<Lifetime, bool>(&earlier, staticLifetime) {
          region = Option.some<Shared<Lifetime>>(move offered)
        } else {
          let mut both = Vector.make<Shared<Lifetime>>()
          run Vector.append<Shared<Lifetime>>(&mut both, Shared.clone<Lifetime>(&earlier))
          run Vector.append<Shared<Lifetime>>(&mut both, move offered)
          region = Option.some<Shared<Lifetime>>(run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&both)))
        }
      }
    }
  }
  return move region
}

// An inferred call lifetime binder that earlier operands fixed shortens to its `binderMeet` with a
// later operand, so every earlier operand still meets it by covariant subtyping (LIFE-002). This
// holds only when every parameter stores the binder covariantly (bootstrap NominalVariance) and no
// bound names it. An `effect fn` environment binder qualifies too: the Effect it returns is only
// valid for a shorter region. On success the binding is replaced and the caller matches the operand
// again.
effect fn shortenedBinder(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  parameter: &Shared<Type>, actual: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, variables: &[Shared<DeclarationId>], inferred: &mut Vector<Binding>,
  explicit: &[usize], span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount) != usize.ZERO { return false }
  let parameters = run signatureParameterTypes(signature)
  let listed = Vector.asSlice<Shared<Type>>(&parameters)
  let count = Vector.length<Binding>(&inferred.*)
  let mut chosen = usize.MAX
  let mut shorter = Option.none<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < count && chosen == usize.MAX {
    let bindings = Vector.asSlice<Binding>(&inferred.*)
    let ordinal = bindings[at].ordinal
    let region = run binderMeet(parameter, actual, variables, bindings, at, explicit)
    if let Option<Shared<Lifetime>>.Some {value: offered} = move region {
      if run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, listed, fresh, ordinal, span) {
        chosen = at
        shorter = Option.some<Shared<Lifetime>>(move offered)
      }
    }
    at = at + usize.ONE
  }
  if let Option<Shared<Lifetime>>.Some {value} = move shorter {
    let replaced = Vector.asMutSlice<Binding>(&mut inferred.*)
    replaced[chosen].value = Argument.Lifetime {value: move value}
    return true
  }
  return false
}

// Whether every parameter that mentions inference binder `ordinal` stores it covariantly, so any
// operand that met a longer region still meets a shorter one (bootstrap NominalVariance).
effect fn storedCovariantly(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  listed: &[Shared<Type>], fresh: &DeclarationId, ordinal: usize, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let marker = Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(fresh), ordinal: ordinal})}
  let mut position = usize.ZERO
  while position < listed.length {
    let mut types = Vector.make<usize>()
    let mut lifetimes = Vector.make<usize>()
    let mut rows = Vector.make<usize>()
    run Type.collectOwned(&listed[position], fresh, &mut types, &mut lifetimes, &mut rows)
    if containsOrdinal(&lifetimes, ordinal) {
      let mut active = Vector.make<DeclarationId>()
      if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[position], &marker, true,
        &mut active, span) {
        return false
      }
    }
    position = position + usize.ONE
  }
  return true
}

// An inferred lifetime binder that a `T: 'binder` bound names shortens to the meet of the regions T
// retains when the binder's evidence does not already cover them, as the bootstrap's region inference
// chooses the shortest region (LIFE-002). A capture-free callback fixes `'env` of
// `useReleaseNonParking` to 'static, while `Resource: 'env` asks only for the resource's named
// regions; a stored type parameter without a contents premise names none (see `proveAppliedBounds`).
// When T's contents are generic storage with no premise naming a region, as for a bare caller type
// parameter, the shortest region is the call's own: a binder that holds only 'static evidence, such as
// the environment of a capture-free `effect fn` passed as a callback, shortens to this call's local
// region, which every type the caller names outlives (see `proveAppliedBounds`).
// As in `shortenedBinder`, a written binder never moves and every parameter must store the binder
// covariantly; the bound proof then runs on the shortened binding.
effect fn boundShortenedBinders(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  module: &ModuleId, signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  inferred: &mut Vector<Binding>, explicit: &[usize], constraints: &[Constraint], caller: &DeclarationId,
  expression: HirId, span: Span,
) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  if count == usize.ZERO { return () }
  let parameters = run signatureParameterTypes(signature)
  let listed = Vector.asSlice<Shared<Type>>(&parameters)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Contents {subject, region}} = move bound {
      let ordinal = freshLifetimeOrdinal(&region, fresh)
      let mut current = Option.none<Shared<Lifetime>>()
      if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) {
        if let Option<Argument>.Some {value: Argument.Lifetime {value}} = move bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), ordinal) {
          current = Option.some<Shared<Lifetime>>(move value)
        }
      }
      if let Option<Shared<Lifetime>>.Some {value: held} = move current {
        let applied = run Type.applyBindings(&subject, Vector.asSlice<Binding>(&inferred.*), true)
        let anchor = run DeclarationId.fromParts(run ModuleId.copy(module), Vector.make<OwnerStep>())
        let mut retained = Vector.make<Shared<Lifetime>>()
        let mut unresolved = Vector.make<Shared<Type>>()
        let open = run typeMentionsOwner(&applied, fresh)
        if !open && run captureContents(&applied, &anchor, constraints, &mut retained, &mut unresolved) {
          let regions = Vector.asSlice<Shared<Lifetime>>(&retained)
          let mut members = Vector.make<Shared<Lifetime>>()
          if !Shared.with<Lifetime, bool>(&held, staticLifetime) { run Vector.append<Shared<Lifetime>>(&mut members, Shared.clone<Lifetime>(&held)) }
          let mut uncovered = false
          let mut regionAt = usize.ZERO
          while regionAt < regions.length {
            if !run knownOutlives(constraints, &regions[regionAt], &held) { uncovered = true }
            run Vector.append<Shared<Lifetime>>(&mut members, Shared.clone<Lifetime>(&regions[regionAt]))
            regionAt = regionAt + usize.ONE
          }
          let staticHeld = Shared.with<Lifetime, bool>(&held, staticLifetime)
          if regions.length == usize.ZERO && staticHeld && Vector.length<Shared<Type>>(&unresolved) != usize.ZERO {
            run Vector.append<Shared<Lifetime>>(&mut members, run Shared.make<Lifetime>(Lifetime.Local {
              declaration: run DeclarationId.copy(caller), ordinal: expression.index}))
            uncovered = true
          }
          if uncovered && run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, listed, fresh, ordinal, span) {
            let shorter = run Lifetime.meet(Vector.asSlice<Shared<Lifetime>>(&members))
            let replaced = Vector.asMutSlice<Binding>(&mut inferred.*)
            let mut bindingAt = usize.ZERO
            while bindingAt < replaced.length {
              if replaced[bindingAt].ordinal == ordinal {
                replaced[bindingAt].value = Argument.Lifetime {value: Shared.clone<Lifetime>(&shorter)}
              }
              bindingAt = bindingAt + usize.ONE
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
}

// A call argument whose remaining mismatch is a covariant region relation: a region its inferred
// binder already holds differently (`fixedRegionArgument`), or any argument meeting a parameter its
// bindings fully determine (`subtypedCallArgument`).
effect fn relatedCallArgument(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  parameter: &Shared<Type>, pattern: &Shared<Type>, evidence: &Shared<Type>,
  fresh: &DeclarationId, caller: &DeclarationId, variables: &[Shared<DeclarationId>],
  bindings: &[Binding], explicit: &[usize], constraints: &[Constraint], span: Span,
) -> Option<RelatedArgument>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let fixed = run fixedRegionArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, pattern, evidence,
    fresh, caller, variables, bindings, explicit, span)
  let found = match &fixed {
    Option<RelatedArgument>.Some {..} => true
    Option<RelatedArgument>.None => false
  }
  if found { return move fixed }
  return run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, evidence,
    fresh, caller, variables, bindings, explicit, constraints, span)
}

// An argument whose only mismatch is a covariant region that its inferred binder already holds
// differently: an earlier operand fixed the binder to a caller-local region or 'static. The
// candidate replaces the argument's region with the bound one, and Exact unification with copied
// bindings proves no other mismatch remains; the caller matches the candidate against its real
// bindings. An explicitly written binder is never related. Variance follows the bootstrap
// NominalVariance.
effect fn fixedRegionArgument(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  parameter: &Shared<Type>, pattern: &Shared<Type>, evidence: &Shared<Type>,
  fresh: &DeclarationId, caller: &DeclarationId, variables: &[Shared<DeclarationId>],
  bindings: &[Binding], explicit: &[usize], span: Span,
) -> Option<RelatedArgument>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut relations = Vector.make<RegionPair>()
  let authored = run Type.copy(parameter)
  let expected = run Type.copy(pattern)
  let actual = run Type.copy(evidence)
  let mut candidate = Option.none<Type>()
  match move expected {
    // Shared slices and references are covariant in their region, so a later operand meets the
    // region an earlier operand fixed for the same inferred binder (`relatesToFixedRegion`).
    Type.Slice {lifetime: boundRegion, ..} => {
      let mut ordinal = usize.MAX
      if let Type.Slice {access, lifetime: binderRegion, ..} = move authored {
        if access == Access.Shared { ordinal = freshLifetimeOrdinal(&binderRegion, fresh) }
      }
      if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) { return Option.none<RelatedArgument>() }
      if let Type.Slice {element, access, lifetime: sourceRegion} = move actual {
        if access != Access.Shared { return Option.none<RelatedArgument>() }
        if !run relatesToFixedRegion(&boundRegion, &sourceRegion, caller, &mut relations) { return Option.none<RelatedArgument>() }
        candidate = Option.some<Type>(Type.Slice {
          element: move element, access: Access.Shared, lifetime: move boundRegion,
        })
      }
    }
    Type.Reference {lifetime: boundRegion, ..} => {
      let mut ordinal = usize.MAX
      if let Type.Reference {lifetime: binderRegion, ..} = move authored {
        ordinal = freshLifetimeOrdinal(&binderRegion, fresh)
      }
      if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) { return Option.none<RelatedArgument>() }
      if let Type.Reference {referent, access, lifetime: sourceRegion} = move actual {
        if !run relatesToFixedRegion(&boundRegion, &sourceRegion, caller, &mut relations) { return Option.none<RelatedArgument>() }
        candidate = Option.some<Type>(Type.Reference {
          referent: move referent, access: access, lifetime: move boundRegion,
        })
      }
    }
    // A `string` view is covariant in its region like a shared slice (TYPE-003, LIFE-002).
    Type.String {lifetime: boundRegion} => {
      let mut ordinal = usize.MAX
      if let Type.String {lifetime: binderRegion} = move authored { ordinal = freshLifetimeOrdinal(&binderRegion, fresh) }
      if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) { return Option.none<RelatedArgument>() }
      if let Type.String {lifetime: sourceRegion} = move actual {
        if !run relatesToFixedRegion(&boundRegion, &sourceRegion, caller, &mut relations) { return Option.none<RelatedArgument>() }
        candidate = Option.some<Type>(Type.String {lifetime: move boundRegion})
      }
    }
    // A covariant nominal lifetime slot meets a caller-local region an earlier operand fixed for its
    // own fresh binder under the same rule as a shared slice (`relatesToFixedRegion`). A binder that
    // holds 'static evidence is left to the binder meet (`subtypedCallArgument`).
    Type.Nominal {declaration: wantedOwner, arguments: wantedArguments, ..} => {
      if let Type.Nominal {declaration: writtenOwner, arguments: writtenArguments, ..} = move authored {
        if let Type.Nominal {declaration: actualOwner, isPublic, arguments: actualArguments} = move actual {
          let wanted = Vector.asSlice<Argument>(&wantedArguments)
          let written = Vector.asSlice<Argument>(&writtenArguments)
          let offered = Vector.asSlice<Argument>(&actualArguments)
          if !DeclarationId.equals(&writtenOwner, &wantedOwner) || !DeclarationId.equals(&actualOwner, &wantedOwner)
            || written.length != wanted.length || offered.length != wanted.length { return Option.none<RelatedArgument>() }
          let mut changed = Vector.make<usize>()
          let mut adjusted = Vector.make<Argument>()
          let mut at = usize.ZERO
          while at < offered.length {
            let mut next = Argument.copy(&offered[at])
            if let Argument.Lifetime {value: sourceRegion} = &offered[at] {
              if let Argument.Lifetime {value: boundRegion} = &wanted[at] {
                if !Lifetime.equalsShared(&sourceRegion, &boundRegion) && callerLocalRegion(&boundRegion, caller) {
                  let ordinal = match &written[at] {
                    Argument.Lifetime {value: binderRegion} => freshLifetimeOrdinal(&binderRegion, fresh)
                    _ => usize.MAX
                  }
                  if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) {
                    return Option.none<RelatedArgument>()
                  }
                  if run relatesToFixedRegion(&boundRegion, &sourceRegion, caller, &mut relations) {
                    next = Argument.Lifetime {value: Shared.clone<Lifetime>(&boundRegion)}
                    run Vector.append<usize>(&mut changed, at)
                  }
                }
              }
            }
            run Vector.append<Argument>(&mut adjusted, move next)
            at = at + usize.ONE
          }
          let positions = Vector.asSlice<usize>(&changed)
          if positions.length == usize.ZERO { return Option.none<RelatedArgument>() }
          let mut active = Vector.make<DeclarationId>()
          at = usize.ZERO
          while at < positions.length {
            if !run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &actualOwner,
              offered, positions[at], &mut active, span) { return Option.none<RelatedArgument>() }
            at = at + usize.ONE
          }
          candidate = Option.some<Type>(Type.Nominal {declaration: move actualOwner, isPublic: isPublic, arguments: move adjusted})
        }
      }
    }
    _ => ()
  }
  let compared = match move candidate {
    Option<Type>.Some {value} => run Shared.make<Type>(move value)
    Option<Type>.None => {
      return Option.none<RelatedArgument>()
    }
  }
  let mut proof = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < bindings.length {
    run Vector.append<Binding>(&mut proof, Binding {
      declaration: Shared.clone<DeclarationId>(&bindings[at].declaration),
      ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value),
    })
    at = at + usize.ONE
  }
  let proved = run Type.unify(parameter, &compared, variables, Comparison.Exact, &mut proof)
  return match move proved {
    Unification.Unified => Option.some<RelatedArgument>(RelatedArgument {ty: move compared, relations: move relations})
    _ => Option.none<RelatedArgument>()
  }
}

// The outer loan of a shared reference; exclusive access never participates in this adapter.
fn sharedCallLoan(value: &Type) -> Option<Shared<Lifetime>> {
  if let Type.Reference {access, lifetime, ..} = &value.* {
    if access == Access.Shared { return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime)) }
  }
  return Option.none<Shared<Lifetime>>()
}

// Whether a loan is still a variable of this call, rather than rigid caller evidence.
fn variableCallLoan(region: &Shared<Lifetime>, variables: &[Shared<DeclarationId>]) -> bool {
  let mut at = usize.ZERO
  while at < variables.length {
    if Shared.with<DeclarationId, bool>(&variables[at], fn(owner: &DeclarationId) -> bool {
      return freshLifetimeOrdinal(region, owner) != usize.MAX
    }) { return true }
    at = at + usize.ONE
  }
  return false
}

// An argument meets a parameter its bindings determine by covariant region subtyping, as at an
// expected-value boundary, such as `&HeaderPolicy<'static>` where an earlier operand fixed
// `&HeaderPolicy<'call>`, or `b"gzip"` for an explicitly written `&'value [u8]`; each caller-local
// relation it needs stays open on the body. Binders only this operand determines, such as the
// loan's own region, are taken from it first; a parameter that still mentions a free binder is
// never related.
effect fn subtypedCallArgument(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  parameter: &Shared<Type>, evidence: &Shared<Type>, fresh: &DeclarationId, caller: &DeclarationId,
  variables: &[Shared<DeclarationId>], bindings: &[Binding], explicit: &[usize], constraints: &[Constraint], span: Span,
) -> Option<RelatedArgument>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut completed = Vector.make<Binding>()
  let mut copied = usize.ZERO
  while copied < bindings.length {
    run Vector.append<Binding>(&mut completed, Binding {declaration: Shared.clone<DeclarationId>(&bindings[copied].declaration),
      ordinal: bindings[copied].ordinal, value: Argument.copy(&bindings[copied].value)})
    copied = copied + usize.ONE
  }
  // Exact composite unification rolls back a fresh outer loan when an inner nominal region
  // differs. Infer only that loan on this private candidate; the full variance proof below must
  // still admit every nested component, and the caller commits the candidate transactionally.
  let determined = run Type.applyBindings(parameter, bindings, true)
  let loan = Shared.with<Type, Option<Shared<Lifetime>>>(&determined, sharedCallLoan)
  let offered = Shared.with<Type, Option<Shared<Lifetime>>>(evidence, sharedCallLoan)
  if let Option<Shared<Lifetime>>.Some {value: targetRegion} = move loan {
    let ordinal = freshLifetimeOrdinal(&targetRegion, fresh)
    if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) && variableCallLoan(&targetRegion, variables) {
      if let Option<Shared<Lifetime>>.Some {value: sourceRegion} = move offered {
        if !variableCallLoan(&sourceRegion, variables) {
          run Vector.append<Binding>(&mut completed, Binding {
            declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(fresh)), ordinal: ordinal,
            value: Argument.Lifetime {value: move sourceRegion},
          })
        }
      }
    }
  }
  // Type and row binders only this operand determines are taken from it too, such as `T` in
  // `value: &'env T` when an earlier operand fixed `'env`: a trial without lifetime evidence
  // still unifies them, and the variance proof below decides every region.
  let mut trial = Vector.make<Binding>()
  copied = usize.ZERO
  while copied < bindings.length {
    let lifetime = match &bindings[copied].value { Argument.Lifetime {..} => true _ => false }
    if !lifetime {
      run Vector.append<Binding>(&mut trial, Binding {declaration: Shared.clone<DeclarationId>(&bindings[copied].declaration),
        ordinal: bindings[copied].ordinal, value: Argument.copy(&bindings[copied].value)})
    }
    copied = copied + usize.ONE
  }
  let unified = run Type.unify(parameter, evidence, variables, Comparison.Exact, &mut trial)
  let determines = match &unified { Unification.Unified => true _ => false }
  if determines {
    let found = Vector.asSlice<Binding>(&trial)
    let mut at = usize.ZERO
    while at < found.length {
      let lifetime = match &found[at].value { Argument.Lifetime {..} => true _ => false }
      let own = Shared.with<DeclarationId, bool>(&found[at].declaration, fn(owner: &DeclarationId) -> bool {
        return DeclarationId.equals(owner, fresh)
      })
      let known = match move bindingArgumentAt(Vector.asSlice<Binding>(&completed), found[at].ordinal) {
        Option<Argument>.Some {..} => true
        Option<Argument>.None => false
      }
      if !lifetime && own && !known {
        run Vector.append<Binding>(&mut completed, Binding {declaration: Shared.clone<DeclarationId>(&found[at].declaration),
          ordinal: found[at].ordinal, value: Argument.copy(&found[at].value)})
      }
      at = at + usize.ONE
    }
  }
  let pattern = run Type.applyBindings(parameter, Vector.asSlice<Binding>(&completed), true)
  if run typeMentionsOwner(&pattern, fresh) { return Option.none<RelatedArgument>() }
  let mut relations = Vector.make<RegionPair>()
  let mut active = Vector.make<DeclarationId>()
  if !run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, evidence, &pattern, caller, constraints, true,
    &mut relations, &mut active, span) { return Option.none<RelatedArgument>() }
  return Option.some<RelatedArgument>(RelatedArgument {ty: move pattern, relations: move relations})
}

// The selection fact recorded for one authored syntax node, if this is a selected body.
fn selectedFact(calls: &[ResolvedCall], id: HirId) -> Option<SelectionFact> {
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].id.index == id.index {
      if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Selected {fact}} = &calls[at].result {
        return Option.some<SelectionFact>(match & fact {
          SelectionFact.Embedded {value, ty} => SelectionFact.Embedded {value: Shared.clone<StaticData>(&value), ty: Shared.clone<Type>(&ty)}
          SelectionFact.Condition {selected} => SelectionFact.Condition {selected: selected}
      SelectionFact.StaticFor {iterations} => SelectionFact.StaticFor {iterations: Shared.clone<Vector<IterationFacts>>(&iterations)}
          SelectionFact.StaticBinding {value: bound} => SelectionFact.StaticBinding {value: StaticValue.copy(&bound)}
          SelectionFact.StaticArguments {slots} => SelectionFact.StaticArguments {slots: Shared.clone<Vector<StaticSlot>>(&slots)}
        })
      }
    }
    at = at + usize.ONE
  }
  return Option.none<SelectionFact>()
}

// Whether a selected body's pass evaluated this `let static` statement.
fn staticBindingFact(calls: &[ResolvedCall], id: HirId) -> bool {
  let fact = selectedFact(calls, id)
  return match & fact {
    Option<SelectionFact>.Some {value: found} => match & found {
      SelectionFact.StaticBinding {..} => true
      _ => false
    }
    Option<SelectionFact>.None => false
  }
}

// Publishes one selected static value as a checked constant of its exact type.
effect fn embeddedExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  caller: &DeclarationId,
  constraints: &[Constraint],
  nodes: &mut Vector<BodyNode>,
  expression: HirId,
  span: Span,
  value: Shared<StaticData>,
  ty: Shared<Type>,
  expected: &Option<Shared<Type>>,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let index = Vector.length<BodyNode>(&nodes.*)
  let mismatch = match &expected.* {
    Option<Shared<Type>>.Some {value: wanted} => !run Type.equalsShared(&ty, &wanted)
    Option<Shared<Type>>.None => false
  }
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Embedded {value: move value}},
  })
  if mismatch {
    return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
      BodyNodeId {index: index}, expected, span)
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

// One read of an imported C static, checked at its declared type.
effect fn foreignStaticExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  caller: &DeclarationId,
  constraints: &[Constraint],
  nodes: &mut Vector<BodyNode>,
  expression: HirId,
  span: Span,
  declaration: DeclarationId,
  ty: Shared<Type>,
  expected: &Option<Shared<Type>>,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let index = Vector.length<BodyNode>(&nodes.*)
  let mismatch = match &expected.* {
    Option<Shared<Type>>.Some {value: wanted} => !run Type.equalsShared(&ty, &wanted)
    Option<Shared<Type>>.None => false
  }
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.ForeignStatic {
      declaration: run Shared.make<DeclarationId>(move declaration),
    }},
  })
  if mismatch {
    return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
      BodyNodeId {index: index}, expected, span)
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

// Checks one static reflection call. The owner is the call's single resolved type argument:
// `reflectType<Owner>()` yields `Intrinsic.Type<Owner>`, and `reflectTypeKind<Owner>` accepts
// exactly that descriptor and yields `u8`.
effect fn checkReflectionCall<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  span: Span,
  member: IntrinsicMember,
  typeArguments: &[Shared<Type>],
  arguments: CallArguments,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if typeArguments.length != usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  let descriptor = run Shared.make<Type>(Type.TypeDescriptor {owner: Shared.clone<Type>(&typeArguments[usize.ZERO])})
  let mut checkedArguments = Vector.make<BodyNodeId>()
  let mut ty = Shared.clone<Type>(&descriptor)
  if CallArguments.length(arguments) == usize.ONE {
    let context = Option.some<Shared<Type>>(Shared.clone<Type>(&descriptor))
    let argumentId = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
    let checked = run checkExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argumentId, &context,
      constraints, contractBody, staticBody, unsafeAllowed,
    )
    let argumentNode = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    let evidence = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &argumentNode)
    let valid = match move evidence {
      Option<Shared<Type>>.Some {value} => run Type.equalsShared(&value, &descriptor)
      Option<Shared<Type>>.None => false
    }
    if !valid {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    run Vector.append<BodyNodeId>(&mut checkedArguments, argumentNode)
    ty = run primitiveType(b"u8")
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !run Type.equalsShared(&ty, &value) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.IntrinsicCall {member: member, arguments: move checkedArguments}},
    },
  )
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

struct PatternBindingUse {
  ty: Shared<Type>
  form: BodyExpression
}

effect fn copyUnionMember(member: &Option<BodyUnionMember>) -> Option<BodyUnionMember> ! OutOfMemoryError ? &mut Allocator {
  return match &member.* {
    Option<BodyUnionMember>.Some {value} => Option.some<BodyUnionMember>(BodyUnionMember {tag: value.tag, ty: Shared.clone<Type>(&value.ty), source: Shared.clone<Type>(&value.source)})
    Option<BodyUnionMember>.None => Option.none<BodyUnionMember>()
  }
}

effect fn copySteps(path: &Vector<BodyPlaceStep>) -> Vector<BodyPlaceStep> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<BodyPlaceStep>()
  let listed = Vector.asSlice<BodyPlaceStep>(path)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut step = BodyPlaceStep.Field {index: usize.ZERO}
    if let BodyPlaceStep.Member {tag, ty, source} = &listed[at] { step = BodyPlaceStep.Member {tag: tag, ty: Shared.clone<Type>(&ty), source: Shared.clone<Type>(&source)} }
    if let BodyPlaceStep.VariantField {tag, field} = &listed[at] { step = BodyPlaceStep.VariantField {tag: tag, field: field} }
    if let BodyPlaceStep.Field {index} = &listed[at] { step = BodyPlaceStep.Field {index: index} }
    if let BodyPlaceStep.Element {index} = &listed[at] { step = BodyPlaceStep.Element {index: index} }
    run Vector.append<BodyPlaceStep>(&mut copied, move step)
    at = at + usize.ONE
  }
  return move copied
}

effect fn extendedPath(path: &Vector<BodyPlaceStep>, step: BodyPlaceStep) -> Vector<BodyPlaceStep> ! OutOfMemoryError ? &mut Allocator {
  let mut extended = run copySteps(path)
  run Vector.append<BodyPlaceStep>(&mut extended, move step)
  return move extended
}

// Coverage mirrors the bootstrap row model: the uncovered values are rows, each a top-level member
// plus the tags its nested union paths may still hold; an absent path may hold any tag.
struct CoverageConstraint {
  path: Vector<BodyPlaceStep>
  allowed: Vector<bool>
}

struct CoverageRow {
  member: usize
  constraints: Vector<CoverageConstraint>
}

fn sameStep(left: &BodyPlaceStep, right: &BodyPlaceStep) -> bool {
  if let BodyPlaceStep.Member {tag, ..} = &left.* {
    if let BodyPlaceStep.Member {tag: other, ..} = &right.* { return tag == other }
  }
  if let BodyPlaceStep.VariantField {tag, field} = &left.* {
    if let BodyPlaceStep.VariantField {tag: otherTag, field: otherField} = &right.* { return tag == otherTag && field == otherField }
  }
  if let BodyPlaceStep.Field {index} = &left.* {
    if let BodyPlaceStep.Field {index: other} = &right.* { return index == other }
  }
  return false
}

fn samePath(left: &Vector<BodyPlaceStep>, right: &Vector<BodyPlaceStep>) -> bool {
  let first = Vector.asSlice<BodyPlaceStep>(left)
  let second = Vector.asSlice<BodyPlaceStep>(right)
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if !sameStep(&first[at], &second[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// The tags `test.path` may still hold in `row`.
effect fn allowedTags(row: &CoverageRow, test: &BodyPatternTest) -> Vector<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut tags = Vector.make<bool>()
  let constraints = Vector.asSlice<CoverageConstraint>(&row.constraints)
  let mut at = usize.ZERO
  while at < constraints.length {
    if samePath(&constraints[at].path, &test.path) {
      let listed = Vector.asSlice<bool>(&constraints[at].allowed)
      let mut tag = usize.ZERO
      while tag < listed.length {
        run Vector.append<bool>(&mut tags, listed[tag])
        tag = tag + usize.ONE
      }
      return move tags
    }
    at = at + usize.ONE
  }
  while Vector.length<bool>(&tags) < test.tags { run Vector.append<bool>(&mut tags, true) }
  return move tags
}

// `row` with `test.path` restricted to exactly `allowed`.
effect fn constrainedRow(row: &CoverageRow, test: &BodyPatternTest, allowed: Vector<bool>) -> CoverageRow ! OutOfMemoryError ? &mut Allocator {
  let mut constraints = Vector.make<CoverageConstraint>()
  let prior = Vector.asSlice<CoverageConstraint>(&row.constraints)
  let mut at = usize.ZERO
  while at < prior.length {
    if !samePath(&prior[at].path, &test.path) {
      let mut kept = Vector.make<bool>()
      let listed = Vector.asSlice<bool>(&prior[at].allowed)
      let mut tag = usize.ZERO
      while tag < listed.length {
        run Vector.append<bool>(&mut kept, listed[tag])
        tag = tag + usize.ONE
      }
      run Vector.append<CoverageConstraint>(&mut constraints, CoverageConstraint {path: run copySteps(&prior[at].path), allowed: move kept})
    }
    at = at + usize.ONE
  }
  run Vector.append<CoverageConstraint>(&mut constraints, CoverageConstraint {path: run copySteps(&test.path), allowed: move allowed})
  return CoverageRow {member: row.member, constraints: move constraints}
}

// Whether an arm with these nested tests can select some value of `row`.
effect fn rowIntersects(row: &CoverageRow, tests: &Vector<BodyPatternTest>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<BodyPatternTest>(tests)
  let mut at = usize.ZERO
  while at < listed.length {
    let allowed = run allowedTags(row, &listed[at])
    let flags = Vector.asSlice<bool>(&allowed)
    if !flags[listed[at].tag] { return false }
    at = at + usize.ONE
  }
  return true
}

// Appends the values of `row` that an unguarded arm with these nested tests does not select.
effect fn subtractRow(row: &CoverageRow, tests: &Vector<BodyPatternTest>, residual: &mut Vector<CoverageRow>) ! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<BodyPatternTest>(tests)
  let mut matched = run copiedRow(row)
  let mut at = usize.ZERO
  while at < listed.length {
    let test = &listed[at]
    let values = run allowedTags(&matched, test)
    let flags = Vector.asSlice<bool>(&values)
    let mut other = Vector.make<bool>()
    let mut only = Vector.make<bool>()
    let mut remains = false
    let mut tag = usize.ZERO
    while tag < flags.length {
      let kept = flags[tag] && tag != test.tag
      if kept { remains = true }
      run Vector.append<bool>(&mut other, kept)
      run Vector.append<bool>(&mut only, tag == test.tag)
      tag = tag + usize.ONE
    }
    if remains { run Vector.append<CoverageRow>(&mut residual.*, run constrainedRow(&matched, test, move other)) }
    if !flags[test.tag] { return }
    matched = run constrainedRow(&matched, test, move only)
    at = at + usize.ONE
  }
}

effect fn copiedRow(row: &CoverageRow) -> CoverageRow ! OutOfMemoryError ? &mut Allocator {
  let mut constraints = Vector.make<CoverageConstraint>()
  let prior = Vector.asSlice<CoverageConstraint>(&row.constraints)
  let mut at = usize.ZERO
  while at < prior.length {
    let mut kept = Vector.make<bool>()
    let listed = Vector.asSlice<bool>(&prior[at].allowed)
    let mut tag = usize.ZERO
    while tag < listed.length {
      run Vector.append<bool>(&mut kept, listed[tag])
      tag = tag + usize.ONE
    }
    run Vector.append<CoverageConstraint>(&mut constraints, CoverageConstraint {path: run copySteps(&prior[at].path), allowed: move kept})
    at = at + usize.ONE
  }
  return CoverageRow {member: row.member, constraints: move constraints}
}

fn memberUncovered(rows: &Vector<CoverageRow>, member: usize) -> bool {
  let listed = Vector.asSlice<CoverageRow>(rows)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].member == member { return true }
    at = at + usize.ONE
  }
  return false
}

// A pattern binder resolves to the binding place declared by its arm; every use is a fresh place node.
effect fn patternBindingUse(resolver: &Resolver, nodes: &[BodyNode], binder: HirId) -> Option<PatternBindingUse> ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < nodes.length {
    if nodes[at].origin.syntax.index == binder.index && !completedOccurrenceContains(resolver, at, false) {
      if let BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {subject, path, access}} = &nodes[at].kind {
        return Option.some<PatternBindingUse>(PatternBindingUse {
          ty: Shared.clone<Type>(&ty),
          form: BodyExpression.PatternBinding {subject: subject, path: run copySteps(&path), access: access},
        })
      }
    }
    at = at + usize.ONE
  }
  return Option.none<PatternBindingUse>()
}

// A runtime-complete nominal union declaration: tags are variant positions in declaration order,
// the same order the Members query, static values and runtime identities use.
struct NominalUnion {
  module: usize
  declaration: usize
  count: usize
}

impl Copy for NominalUnion {}

effect fn nominalUnionOf(resolver: &mut Resolver, ty: &Shared<Type>) -> Option<NominalUnion>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if !Shared.with<Type, bool>(ty, isNominalType) { return Option.none<NominalUnion>() }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Option.none<NominalUnion>() }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option.none<NominalUnion>() }
  }
  let written = run header(&mut resolver.*, &declaredModule, declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {variants, ..} = value.header {
      return Option.some<NominalUnion>(NominalUnion {module: moduleOrdinal, declaration: declaration, count: variants.length})
    }
  }
  return Option.none<NominalUnion>()
}

fn variantPosition(answer: &Result<Answer, NoRejection>, name: &[u8]) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let values = Vector.asSlice<Member>(&members)
      let mut at = usize.ZERO
      while at < values.length {
        if let Option<Bytes>.Some {value: written} = &values[at].name {
          if same(Bytes.asSlice(&written), name) { return at }
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

// The declaration-order tag of a written variant name. Variants have no visibility of their own:
// access is the union declaration's, enforced when its name is selected.
effect fn variantTag(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, nominal: &NominalUnion, name: &[u8], span: Span,
) -> Result<usize, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Members, module: nominal.module, name: usize.ZERO,
    declaration: nominal.declaration, member: usize.ZERO, external: false,
  }, span)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&names, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Result.failResult<usize, Shared<Rejection>>(move value) }
  let tag = Shared.with<Result<Answer, NoRejection>, usize>(&names, fn(answer: &Result<Answer, NoRejection>) -> usize {
    return variantPosition(answer, name)
  })
  if tag == usize.MAX { return Result.failResult<usize, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnknownMember, span)) }
  return Result.succeed<usize, Shared<Rejection>>(tag)
}

// One variant's written field names (declaration order), whether braces were written, and the
// payload field types from the variant's member shape.
struct VariantShape {
  braces: bool
  names: Vector<Bytes>
  types: Vector<Shared<Type>>
}

fn shapeLength(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.MemberShape {types}} = &value.outcome { return Vector.length<Shared<Type>>(&types) }
  }
  return usize.MAX
}

fn shapeTypeAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.MemberShape {types}} = &value.outcome {
      let listed = Vector.asSlice<Shared<Type>>(&types)
      if at < listed.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&listed[at])) }
    }
  }
  return Option.none<Shared<Type>>()
}

effect fn variantShape(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, unionType: &Shared<Type>, nominal: &NominalUnion,
  tag: usize, span: Span,
) -> Result<VariantShape, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let declaredModule = run resolvedModule(&resolver.*, nominal.module)
  let written = run header(&mut resolver.*, &declaredModule, nominal.declaration)
  let mut variants = Range.empty()
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {variants: listed, ..} = value.header { variants = listed }
  }
  if tag >= variants.length { return Result.failResult<VariantShape, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnknownMember, span)) }
  let mut names = Vector.make<Bytes>()
  let mut braces = false
  let sourceAnswer = run source(&mut resolver.*, &declaredModule)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, &declaredModule) {
    let hir = IndexedSource.authored(indexed)
    if let Node.Variant {fields, braces: writtenBraces, ..} = Module.node(hir, Module.child(hir, variants, tag)) {
      braces = writtenBraces
      let mut at = usize.ZERO
      while at < fields.length {
        if let Node.Field {name, ..} = Module.node(hir, Module.child(hir, fields, at)) {
          if let Node.Name {text} = Module.node(hir, name) {
            run Vector.append<Bytes>(&mut names, run Bytes.copy(Module.text(hir, text)))
          }
        }
        at = at + usize.ONE
      }
    }
  }
  drop sourceAnswer
  let application = run internApplication(&mut resolver.*, unionType)
  let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.MemberShape, module: nominal.module, name: application,
    declaration: nominal.declaration, member: tag, external: false,
  }, span)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&shaped, answerRejection)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Result.failResult<VariantShape, Shared<Rejection>>(move value) }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&shaped, shapeLength)
  if count != Vector.length<Bytes>(&names) {
    return Result.failResult<VariantShape, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let mut types = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&shaped, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return shapeTypeAt(answer, at)
    })
    if let Option<Shared<Type>>.Some {value} = move selected { run Vector.append<Shared<Type>>(&mut types, move value) }
    at = at + usize.ONE
  }
  return Result.succeed<VariantShape, Shared<Rejection>>(VariantShape {braces: braces, names: move names, types: move types})
}

// One selected nominal-union variant, optionally awaiting ordinary payload inference.
struct SelectedVariant {
  ty: Shared<Type>
  nominal: NominalUnion
  tag: usize
  shape: VariantShape
  inference: Option<InferredAggregateTarget>
}

effect fn selectedVariant(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, ty: &Shared<Type>,
  nominal: NominalUnion, member: &[u8], span: Span,
) -> Result<SelectedVariant, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let tagged = run variantTag(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &nominal, member, span)
  let tag = match move tagged {
    Result<usize, Shared<Rejection>>.Success {value} => value
    Result<usize, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<SelectedVariant, Shared<Rejection>>(move error)
    }
  }
  let shaped = run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, ty, &nominal, tag, span)
  return match move shaped {
    Result<VariantShape, Shared<Rejection>>.Success {value} =>
      Result.succeed<SelectedVariant, Shared<Rejection>>(SelectedVariant {
        ty: Shared.clone<Type>(ty), nominal: nominal, tag: tag, shape: move value,
        inference: Option.none<InferredAggregateTarget>(),
      })
    Result<VariantShape, Shared<Rejection>>.Failure {error} =>
      Result.failResult<SelectedVariant, Shared<Rejection>>(move error)
  }
}

effect fn selectAppliedVariant(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, ty: &Shared<Type>, member: &[u8], span: Span,
) -> Option<Result<SelectedVariant, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = run nominalUnionOf(&mut resolver.*, ty)
  return match move selected {
    Option<NominalUnion>.Some {value} => Option.some<Result<SelectedVariant, Shared<Rejection>>>(
      run selectedVariant(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, module, ty, value, member, span,
      ),
    )
    Option<NominalUnion>.None => Option.none<Result<SelectedVariant, Shared<Rejection>>>()
  }
}

// A written `Union.Variant` qualifier: immediate nominal context fixes its arguments; otherwise
// generic payload fields infer them through the same aggregate lane as a bare struct literal.
effect fn selectVariant(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, namespace: &[u8], member: &[u8],
  expected: &Option<Shared<Type>>, span: Span,
) -> Option<Result<SelectedVariant, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let candidateSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let candidate = match move candidateSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Option.some<Result<SelectedVariant, Shared<Rejection>>>(Result.failResult<SelectedVariant, Shared<Rejection>>(move error))
    }
  }
  if candidate.count != usize.ONE || (candidate.kind != CandidateKind.Declaration && candidate.kind != CandidateKind.ImportMember) {
    return Option.none<Result<SelectedVariant, Shared<Rejection>>>()
  }
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, namespace, false, span, RejectionCode.NotType)
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Option.none<Result<SelectedVariant, Shared<Rejection>>>()
    }
  }
  let declaredModule = run resolvedModule(&resolver.*, declaration.module)
  let written = run header(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut count = usize.MAX
  let mut genericParameters = Range.empty()
  let mut isPublic = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {generics, variants, isPublic: published, ..} = value.header {
      count = variants.length
      genericParameters = generics
      isPublic = published
    }
  }
  if count == usize.MAX { return Option.none<Result<SelectedVariant, Shared<Rejection>>>() }
  let nominal = NominalUnion {module: declaration.module, declaration: declaration.ordinal, count: count}
  if genericParameters.length > usize.ZERO {
    if let Option<Shared<Type>>.Some {value: context} = &expected.* {
      let contextModule = declaringModuleOrdinal(&resolver.*, &context)
      if contextModule == declaration.module {
        let contextOrdinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, &context)
        if let Option<usize>.Some {value} = move contextOrdinal {
          if value == declaration.ordinal {
            return Option.some<Result<SelectedVariant, Shared<Rejection>>>(run selectedVariant(
              &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &context, nominal, member, span,
            ))
          }
        }
      }
    }
    let target = match move run inferredAggregateDeclaration(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration,
      genericParameters, isPublic, span,
    ) {
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value: inferred} => match move inferred {
        Option<InferredAggregateTarget>.Some {value: aggregate} => move aggregate
        Option<InferredAggregateTarget>.None => { return Option.none<Result<SelectedVariant, Shared<Rejection>>>() }
      }
      Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Result<SelectedVariant, Shared<Rejection>>>(Result.failResult<SelectedVariant, Shared<Rejection>>(move error))
      }
    }
    let selected = run selectedVariant(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &target.ty, nominal, member, span,
    )
    match move selected {
      Result<SelectedVariant, Shared<Rejection>>.Success {value} => {
        let mut variant = move value
        variant.inference = Option.some<InferredAggregateTarget>(move target)
        return Option.some<Result<SelectedVariant, Shared<Rejection>>>(
          Result.succeed<SelectedVariant, Shared<Rejection>>(move variant),
        )
      }
      Result<SelectedVariant, Shared<Rejection>>.Failure {error} => {
        return Option.some<Result<SelectedVariant, Shared<Rejection>>>(
          Result.failResult<SelectedVariant, Shared<Rejection>>(move error),
        )
      }
    }
  }
  let identity = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Identity, module: declaration.module, name: usize.ZERO,
    declaration: declaration.ordinal, member: usize.ZERO, external: false,
  }, span)
  let selectedType = run typeFromAnswer(&identity)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selectedType.rejected {
    return Option.some<Result<SelectedVariant, Shared<Rejection>>>(Result.failResult<SelectedVariant, Shared<Rejection>>(move diagnostic))
  }
  let ty = match move selectedType.resolved {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Option.none<Result<SelectedVariant, Shared<Rejection>>>() }
  }
  return Option.some<Result<SelectedVariant, Shared<Rejection>>>(run selectedVariant(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ty, nominal, member, span,
  ))
}

// A two-segment written path in a type or pattern position.
effect fn namedPathPair(source: &SourceIndex, cursor: &AuthoredCursor, annotation: HirId) -> Option<QualifiedBodyName>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.NamedType {path, hasMode, ..} = run bodyNode(source, cursor, annotation) {
    if !hasMode { return run bodyPathPair(source, cursor, path) }
  }
  return Option.none<QualifiedBodyName>()
}

// The fields a record or variant pattern can name.
union FieldSource {
  Record {ty: Shared<Type>},
  Variant {tag: usize, names: Vector<Bytes>, types: Vector<Shared<Type>>},
}

// A struct or scalar enum annotation in a pattern, resolved once with every other reached body
// annotation. A scalar enum, like a primitive, names a member only a binding pattern can select.
effect fn patternMemberType(
  resolver: &mut Resolver, module: &ModuleId, annotations: &[ResolvedAnnotation], annotation: HirId, span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut resolved = Option.none<Shared<Type>>()
  let mut at = usize.ZERO
  while at < annotations.length {
    if annotations[at].id.index == annotation.index {
      match &annotations[at].result {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
          resolved = Option.some<Shared<Type>>(Shared.clone<Type>(&value))
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(Shared.clone<Rejection>(&error))
        }
      }
      break
    }
    at = at + usize.ONE
  }
  let ty = match move resolved {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, &ty)
  if moduleOrdinal == usize.MAX {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move ty)
  }
  let declaredModule = run resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, &ty)
  let mut selectable = false
  if let Option<usize>.Some {value: declaration} = move ordinal {
    let writtenHeader = run header(&mut resolver.*, &declaredModule, declaration)
    if let Option<HeaderSyntax>.Some {value} = move writtenHeader {
      selectable = match value.header { Node.StructHeader {..} => true Node.EnumHeader {..} => true _ => false }
    }
  }
  if !selectable { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(move ty)
}

// LIFE-003: an omitted lifetime in a body annotation is a variable of this body-local owner. The
// annotation describes a value the body types itself, such as a pattern's scrutinee or a binding's
// initializer, and unifying with that value's type supplies each such lifetime. No variable of
// this owner reaches a checked type, a signature, or a published fact.
effect fn elidedLifetimeOwner(caller: &DeclarationId) -> DeclarationId ! OutOfMemoryError ? &mut Allocator {
  return run DeclarationId.inference(caller, b"\0elided-lifetime")
}

// The value type a written body annotation describes, once each lifetime it elides is taken from
// `actual`. Every written part must agree exactly; an annotation that elides nothing must equal it.
effect fn inferredAnnotation(written: &Shared<Type>, actual: &Shared<Type>, elided: &DeclarationId)
-> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  if !run typeMentionsOwner(written, elided) {
    if run Type.equalsShared(written, actual) { return Option.some<Shared<Type>>(Shared.clone<Type>(actual)) }
    return Option.none<Shared<Type>>()
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(elided)))
  let mut bindings = Vector.make<Binding>()
  let unified = run Type.unify(written, actual, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut bindings)
  let described = match &unified {
    Unification.Unified => true
    _ => false
  }
  if described {
    let filled = run Type.applyBindings(written, Vector.asSlice<Binding>(&bindings), true)
    if !run typeMentionsOwner(&filled, elided) { return Option.some<Shared<Type>>(Shared.clone<Type>(actual)) }
  }
  return Option.none<Shared<Type>>()
}

// The candidate a written pattern annotation names, with its elided lifetimes taken from that
// candidate. Candidates that differ only where the annotation elides leave the choice ambiguous.
union PatternMember {
  Selected {tag: usize, ty: Shared<Type>},
  Missing,
  Ambiguous,
}

effect fn patternMember(written: &Shared<Type>, candidates: &[Shared<Type>], elided: &DeclarationId) -> PatternMember
! OutOfMemoryError ? &mut Allocator {
  let mut selected = PatternMember.Missing
  let mut at = usize.ZERO
  while at < candidates.length {
    let inferred = run inferredAnnotation(written, &candidates[at], elided)
    if let Option<Shared<Type>>.Some {value} = move inferred {
      if let PatternMember.Selected {..} = &selected { return PatternMember.Ambiguous }
      selected = PatternMember.Selected {tag: at, ty: move value}
    }
    at = at + usize.ONE
  }
  return move selected
}

// An annotation naming no candidate is a type mismatch; one whose elided lifetimes fit several
// candidates cannot choose among them (SEM0210).
effect fn rejectPatternMember(resolver: &Resolver, module: &ModuleId, member: &PatternMember, span: Span)
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let code = match &member.* {
    PatternMember.Ambiguous => RejectionCode.AmbiguousLifetime
    _ => RejectionCode.TypeMismatch
  }
  return run reject(resolver, module, code, span)
}

// A selected variant must belong to the matched subject's own union.
effect fn checkedVariant(
  resolver: &Resolver, module: &ModuleId, selected: Option<Result<SelectedVariant, Shared<Rejection>>>,
  subjectType: &Shared<Type>, span: Span,
) -> Result<SelectedVariant, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let chosen = match move selected {
    Option<Result<SelectedVariant, Shared<Rejection>>>.Some {value} => value
    Option<Result<SelectedVariant, Shared<Rejection>>>.None => {
      return Result.failResult<SelectedVariant, Shared<Rejection>>(run reject(resolver, module, RejectionCode.TypeMismatch, span))
    }
  }
  let variant = match move chosen {
    Result<SelectedVariant, Shared<Rejection>>.Success {value} => value
    Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result.failResult<SelectedVariant, Shared<Rejection>>(move error) }
  }
  if !run Type.equalsShared(&variant.ty, subjectType) {
    return Result.failResult<SelectedVariant, Shared<Rejection>>(run reject(resolver, module, RejectionCode.TypeMismatch, span))
  }
  return Result.succeed<SelectedVariant, Shared<Rejection>>(move variant)
}

effect fn patternVariant(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  subjectType: &Shared<Type>, annotation: HirId, span: Span,
) -> Result<SelectedVariant, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let writtenPair = run namedPathPair(&resolver.source, cursor, annotation)
  let pair = match move writtenPair {
    Option<QualifiedBodyName>.Some {value} => value
    Option<QualifiedBodyName>.None => {
      return Result.failResult<SelectedVariant, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
    }
  }
  let context = Option.some<Shared<Type>>(Shared.clone<Type>(subjectType))
  let selected = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), &context, span)
  return run checkedVariant(&resolver.*, module, move selected, subjectType, span)
}

// The variant an applied selector such as `Option<T>.Some` names in a nominal union subject.
effect fn appliedPatternVariant(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  constraints: &[Constraint], elided: &DeclarationId, subjectType: &Shared<Type>, selector: HirId, pattern: HirId, span: Span,
) -> Result<SelectedVariant, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut writtenSubject = HirId {index: usize.ZERO}
  let mut writtenMember = HirId {index: usize.ZERO}
  match run bodyNode(&resolver.source, cursor, selector) {
    Node.MemberSelector {subject, member} => {
      writtenSubject = subject
      writtenMember = member
    }
    _ => { return Result.failResult<SelectedVariant, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span)) }
  }
  let resolved = run recordAnnotation(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, writtenSubject, span, constraints,
  )
  let writtenOwner = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<SelectedVariant, Shared<Rejection>>(move error) }
  }
  let memberName = match run bodyNode(&resolver.source, cursor, writtenMember) {
    Node.Name {text} => run bodyText(&resolver.source, cursor, text)
    _ => { return Result.failResult<SelectedVariant, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnknownMember, span)) }
  }
  // The written union names its member before the qualifier meets the subject, so an unknown
  // variant keeps its own diagnostic. The qualifier's elided lifetimes come from the subject.
  let writtenUnion = run nominalUnionOf(&mut resolver.*, &writtenOwner)
  if let Option<NominalUnion>.Some {value: named} = &writtenUnion {
    let tagged = run variantTag(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &named,
      Bytes.asSlice(&memberName), span)
    if let Result<usize, Shared<Rejection>>.Failure {error} = move tagged {
      return Result.failResult<SelectedVariant, Shared<Rejection>>(move error)
    }
  }
  let inferred = run inferredAnnotation(&writtenOwner, subjectType, elided)
  let mut ownerType = Shared.clone<Type>(subjectType)
  match move inferred {
    Option<Shared<Type>>.Some {value} => { ownerType = move value }
    Option<Shared<Type>>.None => {
      // A qualifier that writes every region admits the subject by covariant region subtyping, as
      // at an expected-value boundary (LIFE-002): a 'static subject meets `'a`, and a caller-local
      // subject region stays open on the body as a relation. The arm selects the subject's own
      // variant.
      let mut deferred = Vector.make<RegionPair>()
      let mut active = Vector.make<DeclarationId>()
      if run typeMentionsOwner(&writtenOwner, elided) {
        return Result.failResult<SelectedVariant, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
      }
      let admitted = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, subjectType, &writtenOwner,
        caller, constraints, true, &mut deferred, &mut active, span)
      if !admitted || !run retainRegionPairs(&mut resolver.*, BodyOrigin {syntax: pattern, span: span},
        Vector.asSlice<RegionPair>(&deferred)) {
        return Result.failResult<SelectedVariant, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
      }
    }
  }
  let selected = run selectAppliedVariant(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ownerType, Bytes.asSlice(&memberName), span,
  )
  return run checkedVariant(&resolver.*, module, move selected, subjectType, span)
}

// The structural union member whose nominal union declares a written `Union.Variant` path, and
// that variant.
struct NestedVariant {
  tag: usize
  ty: Shared<Type>
  variant: SelectedVariant
}

// Selects the variant a two-segment path names in one nominal union member of a structural union.
effect fn nestedVariant(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, members: &[Shared<Type>], pair: &QualifiedBodyName,
  span: Span,
) -> Option<NestedVariant>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < members.length {
    let nominal = run nominalUnionOf(&mut resolver.*, &members[at])
    if let Option<NominalUnion>.Some {..} = &nominal {
      let context = Option.some<Shared<Type>>(Shared.clone<Type>(&members[at]))
      let selected = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), &context, span)
      let checked = run checkedVariant(&resolver.*, module, move selected, &members[at], span)
      if let Result<SelectedVariant, Shared<Rejection>>.Success {value} = move checked {
        return Option.some<NestedVariant>(NestedVariant {tag: at, ty: Shared.clone<Type>(&members[at]), variant: move value})
      }
    }
    at = at + usize.ONE
  }
  return Option.none<NestedVariant>()
}

// Checks `Union.Variant { .. }` or `Union.Variant` against the nominal union member of a structural
// union subject: the arm selects that member, tests the variant tag inside it, then binds the
// variant's fields below the member.
effect fn checkNestedVariantPattern(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  constraints: &[Constraint], annotations: &[ResolvedAnnotation], elided: &DeclarationId, nodes: &mut Vector<BodyNode>,
  subject: BodyNodeId, subjectType: &Shared<Type>, nested: NestedVariant, fields: Range, access: BodyBindingAccess,
  tests: &mut Vector<BodyPatternTest>, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let NestedVariant {tag, ty, variant} = move nested
  let mut path = Vector.make<BodyPlaceStep>()
  run Vector.append<BodyPlaceStep>(&mut path, BodyPlaceStep.Member {tag: tag, ty: Shared.clone<Type>(&ty), source: Shared.clone<Type>(subjectType)})
  run Vector.append<BodyPatternTest>(&mut tests.*, BodyPatternTest {path: run copySteps(&path), tag: variant.tag,
    tags: variant.nominal.count, source: Option.none<Shared<Type>>()})
  let origin = FieldSource.Variant {tag: variant.tag, names: move variant.shape.names, types: move variant.shape.types}
  return run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
    annotations, elided, &mut nodes.*, subject, &origin, fields, &path, access, &mut tests.*, span)
}

// Binds the fields of one record pattern as places below `path` in the selected member. Every field
// is named once unless `..` acknowledges the rest; a nested union subpattern appends its tag test.
// A nested annotation takes the lifetimes it elides from the field it matches.
effect fn checkRecordPatternFields(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  constraints: &[Constraint], annotations: &[ResolvedAnnotation], elided: &DeclarationId, nodes: &mut Vector<BodyNode>,
  subject: BodyNodeId, origin: &FieldSource, fields: Range, path: &Vector<BodyPlaceStep>, access: BodyBindingAccess,
  tests: &mut Vector<BodyPatternTest>, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut seen = Vector.make<usize>()
  let mut rest = false
  let mut at = usize.ZERO
  while at < fields.length {
    let entry = run bodyChild(&resolver.source, cursor, fields, at)
    let entrySpan = run bodySpan(&resolver.source, cursor, entry)
    let mut fieldName = entry
    let mut subpattern = entry
    let mut named = false
    match run bodyNode(&resolver.source, cursor, entry) {
      Node.RestPattern => { rest = true }
      Node.PatternField {name, pattern} => {
        fieldName = name
        subpattern = pattern
        named = true
      }
      _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.InvalidRecordPattern, entrySpan)) }
    }
    if named {
      let text = match run bodyNode(&resolver.source, cursor, fieldName) {
        Node.Name {text} => run bodyText(&resolver.source, cursor, text)
        _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.InvalidRecordPattern, entrySpan)) }
      }
      let fieldSpan = run bodySpan(&resolver.source, cursor, fieldName)
      let mut field = CheckedRecordMember {index: usize.MAX, count: usize.ZERO, ty: run Shared.make<Type>(Type.Unit)}
      let mut step = BodyPlaceStep.Field {index: usize.ZERO}
      match &origin.* {
        FieldSource.Record {ty} => {
          let selected = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ty, Bytes.asSlice(&text), fieldSpan)
          field = match move selected {
            Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => value
            Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
          }
          step = BodyPlaceStep.Field {index: field.index}
        }
        FieldSource.Variant {tag, names, types} => {
          let written = Vector.asSlice<Bytes>(&names)
          let listed = Vector.asSlice<Shared<Type>>(&types)
          let mut index = usize.ZERO
          while index < written.length {
            if same(Bytes.asSlice(&written[index]), Bytes.asSlice(&text)) { break }
            index = index + usize.ONE
          }
          if index == written.length { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.UnknownMember, fieldSpan)) }
          field = CheckedRecordMember {index: index, count: written.length, ty: Shared.clone<Type>(&listed[index])}
          step = BodyPlaceStep.VariantField {tag: tag, field: index}
        }
      }
      let prior = Vector.asSlice<usize>(&seen)
      let mut repeated = false
      let mut scan = usize.ZERO
      while scan < prior.length {
        if prior[scan] == field.index { repeated = true }
        scan = scan + usize.ONE
      }
      if repeated { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.InvalidRecordPattern, fieldSpan)) }
      run Vector.append<usize>(&mut seen, field.index)
      let fieldPath = run extendedPath(path, move step)
      let subpatternSpan = run bodySpan(&resolver.source, cursor, subpattern)
      match run bodyNode(&resolver.source, cursor, subpattern) {
        Node.BindingPattern {annotation, ..} => {
          if annotation.present { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
          run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
            origin: BodyOrigin {syntax: subpattern, span: subpatternSpan},
            kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(&field.ty),
              form: BodyExpression.PatternBinding {subject: subject, path: move fieldPath, access: access}},
          })
        }
        Node.UniversalPattern {name} => {
          if name.present { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
        }
        Node.NominalPattern {annotation, fields: nested} => {
          let nominalField = run nominalUnionOf(&mut resolver.*, &field.ty)
          if let Option<NominalUnion>.Some {value: fieldUnion} = &nominalField {
            // A nested variant pattern tests the field's variant tag, then destructures its payload.
            let selected = run patternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
              &field.ty, annotation, subpatternSpan)
            let variant = match move selected {
              Result<SelectedVariant, Shared<Rejection>>.Success {value} => value
              Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
            }
            run Vector.append<BodyPatternTest>(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath), tag: variant.tag, tags: fieldUnion.count, source: Option.none<Shared<Type>>()})
            let nestedOrigin = FieldSource.Variant {tag: variant.tag, names: move variant.shape.names, types: move variant.shape.types}
            let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
              annotations, elided, &mut nodes.*, subject, &nestedOrigin, nested, &fieldPath, access, &mut tests.*, subpatternSpan)
            if let Option<Shared<Rejection>>.Some {value} = move failed { return Option.some<Shared<Rejection>>(move value) }
          } else {
            let written = run patternMemberType(&mut resolver.*, module, annotations, annotation, subpatternSpan)
            let writtenType = match move written {
              Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
              Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
            }
            let mut nestedPath = run copySteps(&fieldPath)
            let unionField = Shared.with<Type, bool>(&field.ty, sourceUnion)
            let mut candidates = Vector.make<Shared<Type>>()
            if unionField {
              // A nested member pattern tests the field's canonical member tag, then destructures it.
              let ordered = run UnionProjection.members(&field.ty)
              candidates = match move ordered {
                Option<Vector<Shared<Type>>>.Some {value} => value
                Option<Vector<Shared<Type>>>.None => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
              }
            } else {
              run Vector.append<Shared<Type>>(&mut candidates, Shared.clone<Type>(&field.ty))
            }
            let chosen = run patternMember(&writtenType, Vector.asSlice<Shared<Type>>(&candidates), elided)
            let mut tag = usize.ZERO
            let mut nestedType = Shared.clone<Type>(&field.ty)
            match &chosen {
              PatternMember.Selected {tag: found, ty: selectedType} => {
                tag = found
                nestedType = Shared.clone<Type>(&selectedType)
              }
              _ => { return Option.some<Shared<Rejection>>(run rejectPatternMember(&resolver.*, module, &chosen, subpatternSpan)) }
            }
            if unionField {
              run Vector.append<BodyPatternTest>(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath), tag: tag,
                tags: Vector.length<Shared<Type>>(&candidates), source: Option.some<Shared<Type>>(Shared.clone<Type>(&field.ty))})
              nestedPath = run extendedPath(&fieldPath, BodyPlaceStep.Member {tag: tag, ty: Shared.clone<Type>(&nestedType), source: Shared.clone<Type>(&field.ty)})
            }
            let nestedOrigin = FieldSource.Record {ty: move nestedType}
            let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
              annotations, elided, &mut nodes.*, subject, &nestedOrigin, nested, &nestedPath, access, &mut tests.*, subpatternSpan)
            if let Option<Shared<Rejection>>.Some {value} = move failed { return Option.some<Shared<Rejection>>(move value) }
          }
        }
        // An applied variant of a nominal union field, such as `Option<T>.None`, tests its tag like a
        // nested nominal pattern, then destructures any written payload.
        Node.VariantPattern {selector, fields: nested} => {
          let fieldUnion = match move run nominalUnionOf(&mut resolver.*, &field.ty) {
            Option<NominalUnion>.Some {value} => value
            Option<NominalUnion>.None => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, subpatternSpan)) }
          }
          let selected = run appliedPatternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
            constraints, elided, &field.ty, selector, subpattern, subpatternSpan)
          let variant = match move selected {
            Result<SelectedVariant, Shared<Rejection>>.Success {value} => value
            Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
          }
          if nested.present != variant.shape.braces {
            return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.InvalidRecordPattern, subpatternSpan))
          }
          run Vector.append<BodyPatternTest>(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath), tag: variant.tag, tags: fieldUnion.count, source: Option.none<Shared<Type>>()})
          let nestedOrigin = FieldSource.Variant {tag: variant.tag, names: move variant.shape.names, types: move variant.shape.types}
          let mut nestedFields = Range.empty()
          if nested.present { nestedFields = nested.range }
          let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
            constraints, annotations, elided, &mut nodes.*, subject, &nestedOrigin, nestedFields, &fieldPath, access, &mut tests.*, subpatternSpan)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Option.some<Shared<Rejection>>(move value) }
        }
        _ => { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
      }
    }
    at = at + usize.ONE
  }
  if !rest {
    let mut total = usize.ZERO
    match &origin.* {
      FieldSource.Record {ty} => {
        let counted = run recordFieldCount(&mut resolver.*, module, &ty, span)
        total = match move counted {
          Result<usize, Shared<Rejection>>.Success {value} => value
          Result<usize, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
        }
      }
      FieldSource.Variant {names, ..} => { total = Vector.length<Bytes>(&names) }
    }
    if Vector.length<usize>(&seen) != total {
      return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.InvalidRecordPattern, span))
    }
  }
  return Option.none<Shared<Rejection>>()
}

// Every variant field is initialized exactly once with its declared type; the value stores the
// declaration-order tag and the written operand order.
effect fn checkVariantConstruct<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, chosen: Result<SelectedVariant, Shared<Rejection>>, fields: Range,
  expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let variant = match move chosen {
    Result<SelectedVariant, Shared<Rejection>>.Success {value} => value
    Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let names = Vector.asSlice<Bytes>(&variant.shape.names)
  let types = Vector.asSlice<Shared<Type>>(&variant.shape.types)
  if fields.length != names.length { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  let mut operands = Vector.make<BodyAggregateField>()
  let mut inferred = Vector.make<Binding>()
  // An expectation of the same union fixes the slots it determines before any operand, so a
  // variant without fields still receives the lifetimes its written qualifier elides.
  if let Option<InferredAggregateTarget>.Some {value: target} = &variant.inference {
    if let Option<Shared<Type>>.Some {value: context} = &expected.* {
      let sameUnion = Shared.with<Type, bool>(&variant.ty, fn(value: &Type) -> bool { return providerOwnerWith(value, &context) })
      if sameUnion {
        let mut variables = Vector.make<Shared<DeclarationId>>()
        run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(&target.owner))
        let seeded = run Type.unify(&variant.ty, &context, Vector.asSlice<Shared<DeclarationId>>(&variables),
          Comparison.Exact, &mut inferred)
        drop seeded
      }
    }
  }
  let mut at = usize.ZERO
  while at < fields.length {
    let initializer = run bodyChild(&resolver.source, cursor, fields, at)
    let mut name = HirId {index: usize.ZERO}
    let mut initializerValue = HirId {index: usize.ZERO}
    if let Node.FieldInitializer {name: fieldNameId, value: fieldValueId} = run bodyNode(&resolver.source, cursor, initializer) {
      name = fieldNameId
      initializerValue = fieldValueId
    } else {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let fieldSpan = run bodySpan(&resolver.source, cursor, name)
    let fieldName = match run bodyNode(&resolver.source, cursor, name) {
      Node.Name {text} => run bodyText(&resolver.source, cursor, text)
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, fieldSpan) }
    }
    let mut index = usize.ZERO
    while index < names.length {
      if same(Bytes.asSlice(&names[index]), Bytes.asSlice(&fieldName)) { break }
      index = index + usize.ONE
    }
    if index == names.length { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, fieldSpan) }
    let known = Vector.asSlice<BodyAggregateField>(&operands)
    let mut prior = usize.ZERO
    while prior < known.length {
      if known[prior].index == index { return run bodyRejection(&resolver.*, module, RejectionCode.Collision, fieldSpan) }
      prior = prior + usize.ONE
    }
    let checked = run checkAggregateInitializer(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      &types[index], &variant.inference, &Option.none<Shared<Type>>(), &mut inferred, initializerValue, fields.start,
      constraints, contractBody, unsafeAllowed,
    )
    let operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    run Vector.append<BodyAggregateField>(&mut operands, BodyAggregateField {index: index, value: operand})
    at = at + usize.ONE
  }
  let completed = match move run completeAggregateInference(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &variant.ty, &variant.inference,
    Vector.asSlice<Binding>(&inferred), constraints, span,
  ) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move completed, form: BodyExpression.VariantConstruct {tag: variant.tag, fields: move operands}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, span)
}

// A record or closed structural-union subject: arms select a member by its canonical tag, bind
// field places, then test their guard. Borrowed and place matches address the subject's storage.
// Checks one expression a statement owns, with that statement's scope; the scope's loans end here.
effect fn checkStatementExpression(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, locals: &mut Vector<BodyLocal>, annotations: &[ResolvedAnnotation],
  resultType: &Shared<Type>, loopDepth: usize, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool, opaqueConstruction: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut statementScope = StatementScope {locals: &mut locals.*, annotations: annotations, resultType: resultType, loopDepth: loopDepth}
  return run checkExpressionUnder(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, expected, constraints, contractBody, staticBody, unsafeAllowed, opaqueConstruction)
}

// One checked match arm result. Immediately after `=>`, braces introduce a statement block of type
// `()` when it can complete; a block whose paths all transfer contributes no result type.
struct CheckedArmResult {
  node: BodyNodeId
  ty: Option<Shared<Type>>
  block: bool
}

effect fn checkArmResult<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>, signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>, written: HirRef, arm: HirId, expected: &Option<Shared<Type>>,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<CheckedArmResult, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // An `if let` without `else`, or a destructuring `let`, selects an empty statement block.
  if !written.present {
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
      origin: BodyOrigin {syntax: arm, span: run bodySpan(&resolver.source, cursor, arm)},
      kind: BodyNodeKind.Block {statements: Vector.make<BodyNodeId>(), canComplete: true},
    })
    return Result.succeed<CheckedArmResult, Shared<Rejection>>(
      CheckedArmResult {node: node, ty: Option.some<Shared<Type>>(run Shared.make<Type>(Type.Unit)), block: true},
    )
  }
  let result = written.id
  let mut block = false
  let mut statement = false
  match run bodyNode(&resolver.source, cursor, result) {
    Node.Block {..} => {
      block = true
      statement = true
    }
    Node.ConditionalStatement {..} => { statement = true }
    Node.PatternConditionalStatement {..} => { statement = true }
    _ => ()
  }
  if statement {
    let annotations = statementScope.annotations
    let resultType = statementScope.resultType
    let loopDepth = statementScope.loopDepth
    let checked = run checkControl(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.locals.*, annotations, calls,
      &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, result, resultType,
      constraints, contractBody, false, loopDepth, unsafeAllowed)
    let mut control = match move checked {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedArmResult, Shared<Rejection>>(move error)
      }
    }
    // An `else if` mismatch path runs as a one-statement block.
    if !block {
      let mut statements = Vector.make<BodyNodeId>()
      run Vector.append<BodyNodeId>(&mut statements, control.node)
      control.node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
        origin: BodyOrigin {syntax: result, span: run bodySpan(&resolver.source, cursor, result)},
        kind: BodyNodeKind.Block {statements: move statements, canComplete: control.canComplete},
      })
    }
    let mut completed = Option.none<Shared<Type>>()
    if control.canComplete { completed = Option.some<Shared<Type>>(run Shared.make<Type>(Type.Unit)) }
    return Result.succeed<CheckedArmResult, Shared<Rejection>>(
      CheckedArmResult {node: control.node, ty: move completed, block: true},
    )
  }
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, result, expected,
    constraints, contractBody, false, unsafeAllowed)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CheckedArmResult, Shared<Rejection>>(move error)
    }
  }
  let mut produced = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node)
  let diverges = match &produced {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, neverType)
    Option<Shared<Type>>.None => false
  }
  if diverges { produced = Option.none<Shared<Type>>() }
  return Result.succeed<CheckedArmResult, Shared<Rejection>>(
    CheckedArmResult {node: node, ty: move produced, block: false},
  )
}

// The joined result of the checked arms: equal results keep their type, no result is `never`,
// distinct exact Effects join (EFF-013), and other distinct results are `IncompatibleMatchResults`
// on the whole match.
struct ArmJoin {
  joined: Option<Shared<Type>>
  incompatible: bool
  // Each arm that produced a value, by its position among the checked arms.
  produced: Vector<ArmResult>
}

struct ArmResult {
  arm: usize
  ty: Shared<Type>
}

fn emptyArmJoin() -> ArmJoin {
  return ArmJoin {joined: Option.none<Shared<Type>>(), incompatible: false, produced: Vector.make<ArmResult>()}
}

effect fn joinArm(join: &mut ArmJoin, arm: usize, produced: &Option<Shared<Type>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value} = &produced.* {
    run Vector.append<ArmResult>(&mut join.produced, ArmResult {arm: arm, ty: Shared.clone<Type>(&value)})
    let prior = match &join.joined {
      Option<Shared<Type>>.Some {value: earlier} => Option.some<Shared<Type>>(Shared.clone<Type>(&earlier))
      Option<Shared<Type>>.None => Option.none<Shared<Type>>()
    }
    match move prior {
      Option<Shared<Type>>.Some {value: earlier} => {
        if !run Type.equalsShared(&earlier, &value) { join.incompatible = true }
      }
      Option<Shared<Type>>.None => { join.joined = Option.some<Shared<Type>>(Shared.clone<Type>(&value)) }
    }
  }
  return ()
}

// The match's type. Arms producing distinct exact Effects store the selected one in their finite
// join: each arm result is injected under its alternative's tag (EFF-013).
effect fn joinedMatchType(resolver: &Resolver, module: &ModuleId, nodes: &mut Vector<BodyNode>, arms: &mut Vector<BodyMatchArm>,
  join: ArmJoin, span: Span) -> Result<Shared<Type>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if !join.incompatible {
    let single = match move join.joined {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()})
    }
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move single)
  }
  let results = Vector.asSlice<ArmResult>(&join.produced)
  let mut types = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < results.length {
    run Vector.append<Shared<Type>>(&mut types, Shared.clone<Type>(&results[at].ty))
    at = at + usize.ONE
  }
  let joined = match move run effectJoinType(Vector.asSlice<Shared<Type>>(&types)) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(resolver, module, RejectionCode.IncompatibleMatchResults, span)) }
  }
  at = usize.ZERO
  while at < results.length {
    let previous = Vector.asSlice<BodyMatchArm>(&arms.*)[results[at].arm].result
    let injected = match move run injectJoined(&mut nodes.*, previous, &joined) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(resolver, module, RejectionCode.NestedEffectJoinUnavailable, span)) }
    }
    let mut listed = Vector.asMutSlice<BodyMatchArm>(&mut arms.*)
    listed[results[at].arm].result = injected
    at = at + usize.ONE
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(move joined)
}

// The finite join of exact Effects behind one contract (EFF-013): their distinct alternatives in
// first-seen order. Joins that share a contract keep it; otherwise the contract joins successes
// and failures, unites requirement rows, takes the strongest run access, and retains the
// intersection of every environment, which each alternative outlives. Absent when a value is not
// an exact Effect.
effect fn effectJoinType(types: &[Shared<Type>]) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut alternatives = Vector.make<Shared<Type>>()
  let mut shared = Option.none<Shared<Type>>()
  let mut sameContract = true
  let mut successes = Vector.make<Shared<Type>>()
  let mut failures = Vector.make<Shared<Type>>()
  let mut requirements = Row.empty()
  let mut mode = CallableMode.Shared
  let mut regions = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < types.length {
    if !Shared.with<Type, bool>(&types[at], joinableEffect) { return Option.none<Shared<Type>>() }
    let parts = match move Shared.with<Type, Option<EffectParts>>(&types[at], effectParts) {
      Option<EffectParts>.Some {value} => value
      Option<EffectParts>.None => { return Option.none<Shared<Type>>() }
    }
    let retained = run callableEnvironmentRegions(&parts.environment)
    let listedRegions = Vector.asSlice<Shared<Lifetime>>(&retained)
    let mut region = usize.ZERO
    while region < listedRegions.length {
      run Vector.append<Shared<Lifetime>>(&mut regions, Shared.clone<Lifetime>(&listedRegions[region]))
      region = region + usize.ONE
    }
    run Vector.append<Shared<Type>>(&mut successes, Shared.clone<Type>(&parts.success))
    run Vector.append<Shared<Type>>(&mut failures, Shared.clone<Type>(&parts.failure))
    run Row.merge(&mut requirements, &parts.requirements)
    if runStrength(parts.mode) > runStrength(mode) { mode = parts.mode }
    let copied = run Type.copy(&types[at])
    if let Type.EffectJoin {contract, ..} = move copied {
      match &shared {
        Option<Shared<Type>>.Some {value: previous} => { if !run Type.equalsShared(&previous, &contract) { sameContract = false } }
        Option<Shared<Type>>.None => { shared = Option.some<Shared<Type>>(move contract) }
      }
    } else { sameContract = false }
    let stored = run joinAlternatives(&types[at])
    let listed = Vector.asSlice<Shared<Type>>(&stored)
    let mut item = usize.ZERO
    while item < listed.length {
      if (run joinAlternative(Vector.asSlice<Shared<Type>>(&alternatives), &listed[item])) == usize.MAX {
        run Vector.append<Shared<Type>>(&mut alternatives, Shared.clone<Type>(&listed[item]))
      }
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  let retained = run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)))
  if sameContract {
    if let Option<Shared<Type>>.Some {value: contract} = move shared {
      return Option.some<Shared<Type>>(run Shared.make<Type>(Type.EffectJoin {contract: move contract, alternatives: move alternatives}))
    }
  }
  let contract = run Shared.make<Type>(Type.Effect {mode: mode, environment: move retained, success: run joinedType(move successes),
    failure: run joinedType(move failures), requirements: run Shared.make<Row>(move requirements)})
  return Option.some<Shared<Type>>(run Shared.make<Type>(Type.EffectJoin {contract: move contract, alternatives: move alternatives}))
}

// The position of an exact Effect among a join's alternatives, or `usize.MAX`.
effect fn joinAlternative(alternatives: &[Shared<Type>], value: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < alternatives.length {
    if run Type.equalsShared(&alternatives[at], value) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Stores a value holding one alternative of `joined` as that join: a union injection under the
// alternative's tag, or the value itself when it already has the join's type. Absent for a value
// that already holds several alternatives of a different join.
effect fn injectJoined(nodes: &mut Vector<BodyNode>, node: BodyNodeId, joined: &Shared<Type>) -> Option<BodyNodeId>
! OutOfMemoryError ? &mut Allocator {
  let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Option.none<BodyNodeId>() }
  }
  if run Type.equalsShared(&actual, joined) { return Option.some<BodyNodeId>(node) }
  let held = run joinAlternatives(&actual)
  if Vector.length<Shared<Type>>(&held) != usize.ONE { return Option.none<BodyNodeId>() }
  let all = run joinAlternatives(joined)
  let single = Vector.asSlice<Shared<Type>>(&held)
  let tag = run joinAlternative(Vector.asSlice<Shared<Type>>(&all), &single[usize.ZERO])
  if tag == usize.MAX { return Option.none<BodyNodeId>() }
  let origin = Vector.asSlice<BodyNode>(&nodes.*)[node.index].origin
  let injected = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: origin, kind: BodyNodeKind.Expression {
    ty: Shared.clone<Type>(joined), form: BodyExpression.UnionInject {tag: tag, value: node}}})
  return Option.some<BodyNodeId>(injected)
}

// The arms one pattern selection checks: the written arms of a `match`, the selected body and
// mismatch path of `if let` (PATT-007), or the single irrefutable arm of a destructuring `let`
// (PATT-006), whose bindings stay visible to the statements after it.
union MatchArms {
  Written {arms: Range},
  Conditional {pattern: HirId, thenBranch: HirId, elseBranch: HirRef},
  Binding {pattern: HirId},
}

impl Copy for MatchArms {}

fn matchArmCount(arms: MatchArms) -> usize {
  return match arms {
    MatchArms.Written {arms: written} => written.length
    MatchArms.Conditional {..} => usize.ONE + usize.ONE
    MatchArms.Binding {..} => usize.ONE
  }
}

// How a binding of a match with `access` reaches its subject.
fn bindingAccess(access: MatchAccess) -> BodyBindingAccess {
  return match access {
    MatchAccess.Default => BodyBindingAccess.Copied
    MatchAccess.Move => BodyBindingAccess.Moved
    MatchAccess.Place => BodyBindingAccess.Place
    MatchAccess.Shared => BodyBindingAccess.Shared
    MatchAccess.Mutable => BodyBindingAccess.Exclusive
  }
}

// The bindings one arm's pattern declared: the `PatternBinding` nodes of `subject` appended from
// node `from` on, before any guard or result uses them.
effect fn declaredBindings(nodes: &[BodyNode], from: usize, subject: BodyNodeId) -> Vector<BodyNodeId>
! OutOfMemoryError ? &mut Allocator {
  let mut declared = Vector.make<BodyNodeId>()
  let mut at = from
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {subject: bound, ..}, ..} = &nodes[at].kind {
      if bound.index == subject.index { run Vector.append<BodyNodeId>(&mut declared, BodyNodeId {index: at}) }
    }
    at = at + usize.ONE
  }
  return move declared
}

// A consuming match records its subject's owned place. Copy values still cannot be extracted
// through a Drop-hooked ancestor. Invalid extraction is anchored at the subject; a hook at the match.
effect fn consumingMatchAccess(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &[BodyNode], subject: BodyNodeId, subjectType: &Shared<Type>, constraints: &[Constraint], span: Span)
  -> Result<BodySubjectAccess, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, subjectType, constraints, span) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodySubjectAccess, Shared<Rejection>>(move error) }
  }
  let subjectSpan = nodes[subject.index].origin.span
  let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
    nodes, subject, copied, false, subjectSpan, span, constraints) {
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodySubjectAccess, Shared<Rejection>>(move error)
    }
  }
  return Result.succeed<BodySubjectAccess, Shared<Rejection>>(BodySubjectAccess.Consume {consumed: move consumed})
}

effect fn checkRecordMatch<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, subjectNode: BodyNodeId, subjectType: &Shared<Type>, access: MatchAccess, arms: MatchArms,
  expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // A bare match reads one copy, so it is valid only for a Copy scrutinee (MATCH-001).
  if access == MatchAccess.Default {
    let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, subjectType, constraints, span)
    match move copied {
      Result<bool, Shared<Rejection>>.Success {value} => {
        if !value { return run bodyRejection(&resolver.*, module, RejectionCode.ExplicitMoveRequired, span) }
      }
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
  }
  // A place, shared or exclusive match addresses its subject's storage. A shared subject that names
  // no existing storage is evaluated into a temporary, like a borrowed operand (BORROW-006); an
  // exclusive or place match must name an existing place (MATCH-001).
  let place = access != MatchAccess.Move && access != MatchAccess.Default
  if (access == MatchAccess.Mutable || access == MatchAccess.Place) && !checkedPlace(Vector.asSlice<BodyNode>(&nodes.*), subjectNode) {
    return run bodyRejection(&resolver.*, module, RejectionCode.InvalidMatchScrutineePlace, span)
  }
  // A consuming match transfers the subject's place into the selected arm (MATCH-002).
  let mut subjectAccess = BodySubjectAccess.Copy
  if place { subjectAccess = BodySubjectAccess.Place {access: bindingAccess(access)} }
  if access == MatchAccess.Move {
    subjectAccess = match move run consumingMatchAccess(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      cursor, Vector.asSlice<BodyNode>(&nodes.*), subjectNode, subjectType, constraints, span) {
      Result<BodySubjectAccess, Shared<Rejection>>.Success {value} => move value
      Result<BodySubjectAccess, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
  }
  // Pattern annotations take every lifetime they elide from the subject they match (LIFE-003).
  let elided = run elidedLifetimeOwner(caller)
  let isUnion = Shared.with<Type, bool>(subjectType, sourceUnion)
  let nominal = run nominalUnionOf(&mut resolver.*, subjectType)
  let isNominal = match &nominal {
    Option<NominalUnion>.Some {..} => true
    Option<NominalUnion>.None => false
  }
  let mut members = Vector.make<Shared<Type>>()
  let mut count = usize.ZERO
  if let Option<NominalUnion>.Some {value} = &nominal {
    count = value.count
  } else if isUnion {
    let canonical = run UnionProjection.members(subjectType)
    members = match move canonical {
      Option<Vector<Shared<Type>>>.Some {value} => value
      Option<Vector<Shared<Type>>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
  } else if run declaredRecord(&mut resolver.*, subjectType) {
    run Vector.append<Shared<Type>>(&mut members, Shared.clone<Type>(subjectType))
  } else if !Shared.with<Type, bool>(subjectType, scalarSubject) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  // A scalar subject has no finite member set here, so only an unguarded `_` arm covers it.
  let open = Shared.with<Type, bool>(subjectType, scalarSubject)
  if !isNominal { count = Vector.length<Shared<Type>>(&members) }
  let mut rows = Vector.make<CoverageRow>()
  while Vector.length<CoverageRow>(&rows) < count {
    let member = Vector.length<CoverageRow>(&rows)
    run Vector.append<CoverageRow>(&mut rows, CoverageRow {member: member, constraints: Vector.make<CoverageConstraint>()})
  }
  let mut universal = false
  let mut resultType = match &expected.* {
    Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
    Option<Shared<Type>>.None => Option.none<Shared<Type>>()
  }
  let mut join = emptyArmJoin()
  // Integer values an unguarded earlier arm already selected; a repeat is a duplicate pattern.
  let mut integerCases = Vector.make<Bytes>()
  let integerSubject = Shared.with<Type, bool>(subjectType, fn(value: &Type) -> bool {
    return fixedIntegerType(value) || pointerSizedIntegerType(value)
  })
  let mut checkedArms = Vector.make<BodyMatchArm>()
  let armCount = matchArmCount(arms)
  let mut at = usize.ZERO
  while at < armCount {
    let mut armId = expression
    let mut pattern = expression
    let mut guard = HirRef.absent()
    let mut result = HirRef.absent()
    // The `if let` mismatch path is an unwritten `_` arm; a redundant one stays valid (PATT-010).
    let mut fallback = false
    match arms {
      MatchArms.Written {arms: written} => {
        armId = run bodyChild(&resolver.source, cursor, written, at)
        if let Node.MatchArm {pattern: writtenPattern, guard: writtenGuard, result: writtenResult} = run bodyNode(&resolver.source, cursor, armId) {
          pattern = writtenPattern
          guard = writtenGuard
          result = HirRef.of(writtenResult)
        } else {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, armId))
        }
      }
      MatchArms.Conditional {pattern: selected, thenBranch, elseBranch} => {
        if at == usize.ZERO {
          armId = thenBranch
          pattern = selected
          result = HirRef.of(thenBranch)
        } else {
          fallback = true
          if elseBranch.present { armId = elseBranch.id }
          result = elseBranch
        }
      }
      MatchArms.Binding {pattern: selected} => { pattern = selected }
    }
    let armSpan = run bodySpan(&resolver.source, cursor, armId)
    let patternSpan = run bodySpan(&resolver.source, cursor, pattern)
    let mut writtenPattern = Node.UniversalPattern {name: HirRef.absent()}
    if !fallback { writtenPattern = run bodyNode(&resolver.source, cursor, pattern) }
    if !fallback && (universal || (!open && Vector.length<CoverageRow>(&rows) == usize.ZERO)) {
      let mut code = RejectionCode.UnreachableMatchArm
      if universal { code = RejectionCode.MatchArmAfterUniversal }
      return run bodyRejection(&resolver.*, module, code, patternSpan)
    }
    let mut checkedPattern = BodyPattern.Universal
    let mut ordinal = usize.MAX
    let mut integerCase = Option.none<Bytes>()
    let mut armTests = Vector.make<BodyPatternTest>()
    // Pattern checking appends exactly the nodes that declare this arm's bindings.
    let bindingsFrom = Vector.length<BodyNode>(&nodes.*)
    match writtenPattern {
      // An integer literal selects one value of an integer scrutinee at the scrutinee's type.
      Node.IntegerPattern {value} => {
        // A bool scrutinee has no integer values, so the arm can never select one (SEM0043).
        if !integerSubject { return run bodyRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, patternSpan) }
        if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, value) {
          let digits = run bodyText(&resolver.source, cursor, magnitude)
          let fits = Shared.with<Type, bool>(subjectType, fn(resolved: &Type) -> bool {
            return match &resolved.* {
              Type.Primitive {name} => fitsInteger(&resolver.target, Bytes.asSlice(&name), sign, Bytes.asSlice(&digits))
              _ => false
            }
          })
          if !fits { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, patternSpan) }
          let negative = sign == Sign.Negative && !zeroDigits(Bytes.asSlice(&digits))
          let mut key = Bytes.make()
          if negative { run Bytes.append(&mut key, b"-") }
          run Bytes.append(&mut key, Bytes.asSlice(&digits))
          let seen = Vector.asSlice<Bytes>(&integerCases)
          let mut scan = usize.ZERO
          while scan < seen.length {
            if same(Bytes.asSlice(&seen[scan]), Bytes.asSlice(&key)) { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan) }
            scan = scan + usize.ONE
          }
          let magnitude = match move decimalU64(Bytes.asSlice(&digits)) {
            Option<u64>.Some {value: parsed} => parsed
            Option<u64>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, patternSpan) }
          }
          integerCase = Option.some<Bytes>(move key)
          checkedPattern = BodyPattern.Integer {magnitude: magnitude, negative: negative}
        } else {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan)
        }
      }
      Node.UniversalPattern {name} => {
        if name.present { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
      }
      // `T name` selects one exact record member and binds the complete selected value; `T _`
      // selects it without a usable name. Neither is a wildcard (PATT-015).
      Node.BindingPattern {annotation, ..} => {
        if !annotation.present || isNominal || open { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
        let written = run patternMemberType(&mut resolver.*, module, statementScope.annotations, annotation.id, patternSpan)
        let writtenType = match move written {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
        let chosen = run patternMember(&writtenType, Vector.asSlice<Shared<Type>>(&members), &elided)
        let mut tag = usize.ZERO
        let mut patternType = Shared.clone<Type>(&writtenType)
        match &chosen {
          PatternMember.Selected {tag: found, ty: selectedType} => {
            tag = found
            patternType = Shared.clone<Type>(&selectedType)
          }
          _ => { return Result.failResult<BodyNodeId, Shared<Rejection>>(run rejectPatternMember(&resolver.*, module, &chosen, patternSpan)) }
        }
        if !memberUncovered(&rows, tag) { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan) }
        ordinal = tag
        let mut member = Option.none<BodyUnionMember>()
        let mut path = Vector.make<BodyPlaceStep>()
        if isUnion {
          member = Option.some<BodyUnionMember>(BodyUnionMember {tag: tag, ty: Shared.clone<Type>(&patternType), source: Shared.clone<Type>(subjectType)})
          run Vector.append<BodyPlaceStep>(&mut path, BodyPlaceStep.Member {tag: tag, ty: Shared.clone<Type>(&patternType), source: Shared.clone<Type>(subjectType)})
        }
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {syntax: pattern, span: patternSpan},
          kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(&patternType),
            form: BodyExpression.PatternBinding {subject: subjectNode, path: move path, access: bindingAccess(access)}},
        })
        checkedPattern = BodyPattern.Record {member: move member}
      }
      Node.VariantPattern {selector, fields} => {
        if !isNominal { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, patternSpan) }
        let checkedSelection = run appliedPatternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
          caller, constraints, &elided, subjectType, selector, pattern, patternSpan)
        let variant = match move checkedSelection {
          Result<SelectedVariant, Shared<Rejection>>.Success {value} => value
          Result<SelectedVariant, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        if fields.present != variant.shape.braces {
          return run bodyRejection(&resolver.*, module, RejectionCode.InvalidRecordPattern, patternSpan)
        }
        if !memberUncovered(&rows, variant.tag) {
          return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan)
        }
        ordinal = variant.tag
        let origin = FieldSource.Variant {
          tag: variant.tag, names: move variant.shape.names, types: move variant.shape.types,
        }
        let root = Vector.make<BodyPlaceStep>()
        let mut writtenFields = Range.empty()
        if fields.present { writtenFields = fields.range }
        let failed = run checkRecordPatternFields(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
          statementScope.annotations, &elided, &mut nodes.*, subjectNode, &origin, writtenFields,
          &root, bindingAccess(access), &mut armTests, patternSpan,
        )
        if let Option<Shared<Rejection>>.Some {value} = move failed {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
        }
        checkedPattern = BodyPattern.Variant {tag: ordinal}
      }
      Node.NominalPattern {annotation, fields} => {
        if isNominal {
          let selected = run patternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
            subjectType, annotation, patternSpan)
          let variant = match move selected {
            Result<SelectedVariant, Shared<Rejection>>.Success {value} => value
            Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
          }
          if !memberUncovered(&rows, variant.tag) { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan) }
          ordinal = variant.tag
          let origin = FieldSource.Variant {tag: variant.tag, names: move variant.shape.names, types: move variant.shape.types}
          let root = Vector.make<BodyPlaceStep>()
          let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
            statementScope.annotations, &elided, &mut nodes.*, subjectNode, &origin, fields, &root, bindingAccess(access), &mut armTests, patternSpan)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
          checkedPattern = BodyPattern.Variant {tag: ordinal}
        } else {
          // `Member.Variant { .. }` names a variant of a nominal union member of a structural union.
          let mut nested = Option.none<NestedVariant>()
          if isUnion {
            let writtenPair = run namedPathPair(&resolver.source, cursor, annotation)
            if let Option<QualifiedBodyName>.Some {value: pair} = &writtenPair {
              nested = run nestedVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
                Vector.asSlice<Shared<Type>>(&members), &pair, patternSpan)
            }
          }
          if let Option<NestedVariant>.Some {value: selected} = move nested {
            if !memberUncovered(&rows, selected.tag) { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan) }
            ordinal = selected.tag
            let member = BodyUnionMember {tag: selected.tag, ty: Shared.clone<Type>(&selected.ty), source: Shared.clone<Type>(subjectType)}
            let failed = run checkNestedVariantPattern(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
              constraints, statementScope.annotations, &elided, &mut nodes.*, subjectNode, subjectType, move selected, fields,
              bindingAccess(access), &mut armTests, patternSpan)
            if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
            checkedPattern = BodyPattern.Record {member: Option.some<BodyUnionMember>(move member)}
          } else {
            let written = run patternMemberType(&mut resolver.*, module, statementScope.annotations, annotation, patternSpan)
            let writtenType = match move written {
              Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
              Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
              }
            }
            let chosen = run patternMember(&writtenType, Vector.asSlice<Shared<Type>>(&members), &elided)
            let mut tag = usize.ZERO
            let mut patternType = Shared.clone<Type>(&writtenType)
            match &chosen {
              PatternMember.Selected {tag: found, ty: selectedType} => {
                tag = found
                patternType = Shared.clone<Type>(&selectedType)
              }
              _ => { return Result.failResult<BodyNodeId, Shared<Rejection>>(run rejectPatternMember(&resolver.*, module, &chosen, patternSpan)) }
            }
            // `{ }` destructures a record; a scalar member has no fields to name.
            if !run declaredRecord(&mut resolver.*, &patternType) {
              return run bodyRejection(&resolver.*, module, RejectionCode.InvalidRecordPattern, patternSpan)
            }
            if !memberUncovered(&rows, tag) { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan) }
            ordinal = tag
            let mut member = Option.none<BodyUnionMember>()
            let mut root = Vector.make<BodyPlaceStep>()
            if isUnion {
              member = Option.some<BodyUnionMember>(BodyUnionMember {tag: tag, ty: Shared.clone<Type>(&patternType), source: Shared.clone<Type>(subjectType)})
              run Vector.append<BodyPlaceStep>(&mut root, BodyPlaceStep.Member {tag: tag, ty: Shared.clone<Type>(&patternType), source: Shared.clone<Type>(subjectType)})
            }
            let origin = FieldSource.Record {ty: Shared.clone<Type>(&patternType)}
            let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
              statementScope.annotations, &elided, &mut nodes.*, subjectNode, &origin, fields, &root, bindingAccess(access), &mut armTests, patternSpan)
            if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
            checkedPattern = BodyPattern.Record {member: move member}
          }
        }
      }
      Node.EnumPattern {path} => {
        let writtenPair = run bodyPathPair(&resolver.source, cursor, path)
        if !isNominal {
          // `Member.Variant` names a unit variant of a nominal union member of a structural union.
          let mut nested = Option.none<NestedVariant>()
          if isUnion {
            if let Option<QualifiedBodyName>.Some {value: pair} = &writtenPair {
              nested = run nestedVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
                Vector.asSlice<Shared<Type>>(&members), &pair, patternSpan)
            }
          }
          let selected = match move nested {
            Option<NestedVariant>.Some {value} => value
            Option<NestedVariant>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, patternSpan) }
          }
          if selected.variant.shape.braces { return run bodyRejection(&resolver.*, module, RejectionCode.InvalidRecordPattern, patternSpan) }
          if !memberUncovered(&rows, selected.tag) { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan) }
          ordinal = selected.tag
          let member = BodyUnionMember {tag: selected.tag, ty: Shared.clone<Type>(&selected.ty), source: Shared.clone<Type>(subjectType)}
          let failed = run checkNestedVariantPattern(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
            constraints, statementScope.annotations, &elided, &mut nodes.*, subjectNode, subjectType, move selected, Range.empty(),
            bindingAccess(access), &mut armTests, patternSpan)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
          checkedPattern = BodyPattern.Record {member: Option.some<BodyUnionMember>(move member)}
        } else {
          let pair = match move writtenPair {
            Option<QualifiedBodyName>.Some {value} => value
            Option<QualifiedBodyName>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
          }
          let context = Option.some<Shared<Type>>(Shared.clone<Type>(subjectType))
          let selected = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
            Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), &context, patternSpan)
          let checkedSelection = run checkedVariant(&resolver.*, module, move selected, subjectType, patternSpan)
          let variant = match move checkedSelection {
            Result<SelectedVariant, Shared<Rejection>>.Success {value} => value
            Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
          }
          if variant.shape.braces { return run bodyRejection(&resolver.*, module, RejectionCode.InvalidRecordPattern, patternSpan) }
          if !memberUncovered(&rows, variant.tag) { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan) }
          ordinal = variant.tag
          checkedPattern = BodyPattern.Variant {tag: ordinal}
        }
      }
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
    }
    let armBindings = run declaredBindings(Vector.asSlice<BodyNode>(&nodes.*), bindingsFrom, subjectNode)
    // A nested arm whose every value an earlier unguarded arm already selected is unreachable (SEM0043).
    if ordinal != usize.MAX && Vector.length<BodyPatternTest>(&armTests) != usize.ZERO {
      let uncovered = Vector.asSlice<CoverageRow>(&rows)
      let mut reachable = false
      let mut scan = usize.ZERO
      while scan < uncovered.length && !reachable {
        reachable = uncovered[scan].member == ordinal && run rowIntersects(&uncovered[scan], &armTests)
        scan = scan + usize.ONE
      }
      if !reachable { return run bodyRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, patternSpan) }
    }
    let mut checkedGuard = Option.none<BodyNodeId>()
    if guard.present {
      let tested = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, guard.id, &Option.none<Shared<Type>>(),
        constraints, contractBody, false, unsafeAllowed)
      let guardNode = match move tested {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let guardType = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &guardNode)
      let boolean = run primitiveType(b"bool")
      // A guard that always exits, such as a match whose arms return, is `never` (any type).
      let isBoolean = match &guardType {
        Option<Shared<Type>>.Some {value} => (run Type.equalsShared(&value, &boolean)) || Shared.with<Type, bool>(&value, neverType)
        Option<Shared<Type>>.None => false
      }
      if !isBoolean {
        return run bodyRejection(&resolver.*, module, RejectionCode.ConditionNotBool,
          run bodySpan(&resolver.source, cursor, guard.id))
      }
      checkedGuard = Option.some<BodyNodeId>(guardNode)
    } else if let Option<Bytes>.Some {value: selectedCase} = move integerCase {
      run Vector.append<Bytes>(&mut integerCases, move selectedCase)
    } else {
      if ordinal == usize.MAX {
        universal = true
        rows = Vector.make<CoverageRow>()
      } else {
        let mut remaining = Vector.make<CoverageRow>()
        let uncovered = Vector.asSlice<CoverageRow>(&rows)
        let mut scan = usize.ZERO
        while scan < uncovered.length {
          if uncovered[scan].member == ordinal {
            run subtractRow(&uncovered[scan], &armTests, &mut remaining)
          } else {
            run Vector.append<CoverageRow>(&mut remaining, run copiedRow(&uncovered[scan]))
          }
          scan = scan + usize.ONE
        }
        rows = move remaining
      }
    }
    let checkedResult = run checkArmResult(&mut resolver.*, &mut owner.*, &mut request.*,
      &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
      &mut signatures.*, &mut requiredBodies.*, result, armId, &resultType, constraints, contractBody, unsafeAllowed)
    let armResult = match move checkedResult {
      Result<CheckedArmResult, Shared<Rejection>>.Success {value} => value
      Result<CheckedArmResult, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    let resultNode = armResult.node
    // Only expression arms supply the expected type of later expression arms; a block never does.
    let unset = match &resultType {
      Option<Shared<Type>>.Some {..} => false
      Option<Shared<Type>>.None => true
    }
    // Distinct exact Effects join instead (EFF-013), so an Effect arm does not fix later arms.
    if unset && !armResult.block {
      if let Option<Shared<Type>>.Some {value: produced} = &armResult.ty {
        if !Shared.with<Type, bool>(&produced, joinableEffect) { resultType = Option.some<Shared<Type>>(Shared.clone<Type>(&produced)) }
      }
    }
    run joinArm(&mut join, Vector.length<BodyMatchArm>(&checkedArms), &armResult.ty)
    run Vector.append<BodyMatchArm>(&mut checkedArms, BodyMatchArm {
      origin: BodyOrigin {syntax: armId, span: armSpan},
      pattern: move checkedPattern, tests: move armTests, guard: move checkedGuard, result: resultNode,
      bindings: move armBindings,
    })
    at = at + usize.ONE
  }
  // An unconditional `let` must prove its pattern matches every value (PATT-006, SEM0133).
  if let MatchArms.Binding {pattern} = arms {
    if (open && !universal) || Vector.length<CoverageRow>(&rows) != usize.ZERO {
      return run bodyRejection(&resolver.*, module, RejectionCode.RefutableBinding, run bodySpan(&resolver.source, cursor, pattern))
    }
  }
  // A scalar scrutinee's values are not enumerated, so it needs an unguarded `_` (SEM0044).
  if !universal && open { return run bodyRejection(&resolver.*, module, RejectionCode.IncompleteMatch, span) }
  if Vector.length<CoverageRow>(&rows) != usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.MissingUnionMember, span)
  }
  let mut tags = usize.ZERO
  if isUnion || isNominal { tags = count }
  let mut domain = count
  if open { domain = usize.MAX }
  drop resultType
  let matchType = match move run joinedMatchType(&resolver.*, module, &mut nodes.*, &mut checkedArms, move join, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let diverges = Shared.with<Type, bool>(&matchType, neverType)
  // The written form fixes where consuming bindings and the subject's untaken parts end.
  let syntax = match arms {
    MatchArms.Written {..} => BodyMatchSyntax.Match
    MatchArms.Conditional {..} => BodyMatchSyntax.IfLet
    MatchArms.Binding {..} => BodyMatchSyntax.Let
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move matchType, form: BodyExpression.Match {subject: subjectNode, access: move subjectAccess,
      tags: tags, domain: domain, arms: move checkedArms, syntax: syntax}},
  })
  // A match whose arms all transfer is `never`, which every context accepts.
  if diverges { return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index}) }
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, span)
}

struct CheckedRecordFields {
  ty: Shared<Type>
  fields: Vector<BodyAggregateField>
}

// Record and nominal-variant payload inference share one operand, borrow-region and unifier lane.
effect fn checkAggregateInitializer<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>, signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>, memberType: &Shared<Type>,
  inference: &Option<InferredAggregateTarget>, construction: &Option<Shared<Type>>, inferred: &mut Vector<Binding>,
  initializerValue: HirId, loanOrdinal: usize, constraints: &[Constraint],
  contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut appliedMember = Shared.clone<Type>(memberType)
  let mut context = Option.some<Shared<Type>>(Shared.clone<Type>(memberType))
  let mut nestedConstruction = false
  let mut inferredBorrowRegion = false
  let mut fixedBorrowContext = false
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    appliedMember = run Type.applyBindings(memberType, Vector.asSlice<Binding>(&inferred.*), true)
    let targetOwner = Shared.clone<DeclarationId>(&target.owner)
    let ownerId = run DeclarationId.copyShared(&targetOwner)
    let memberRegion = Shared.with<Type, Option<Shared<Lifetime>>>(&appliedMember, operandRegion)
    if let Option<Shared<Lifetime>>.Some {value: region} = move memberRegion {
      inferredBorrowRegion = ownedLifetimeOrdinal(&region, &ownerId) != usize.MAX
      fixedBorrowContext = !inferredBorrowRegion
    }
    // A region an earlier field fixed for an inferred binder is evidence, not an expectation: a
    // later field that reads an existing value meets it through binder shortening below. A field
    // that constructs its value, such as a borrow or a call with elided regions, still takes it
    // as its context.
    let mut typeBindings = Vector.make<Binding>()
    let held = Vector.asSlice<Binding>(&inferred.*)
    let mut at = usize.ZERO
    while at < held.length {
      if let Argument.Lifetime {..} = &held[at].value {} else {
        run Vector.append<Binding>(&mut typeBindings, Binding {declaration: Shared.clone<DeclarationId>(&held[at].declaration),
          ordinal: held[at].ordinal, value: Argument.copy(&held[at].value)})
      }
      at = at + usize.ONE
    }
    let typed = run Type.applyBindings(memberType, Vector.asSlice<Binding>(&typeBindings), true)
    let readSyntax = match run bodyNode(&resolver.source, cursor, initializerValue) {
      Node.IdentifierExpression {..} => true
      Node.FieldExpression {..} => true
      Node.MemberExpression {..} => true
      Node.ReferentExpression {..} => true
      _ => false
    }
    let open = run typeMentionsOwner(&appliedMember, &ownerId)
    let fieldFixed = run typeMentionsOwner(&typed, &ownerId)
    if open || (readSyntax && fieldFixed) {
      context = Option.none<Shared<Type>>()
    } else {
      context = Option.some<Shared<Type>>(Shared.clone<Type>(&appliedMember))
    }
  }
  // A nested literal keeps the original nominal shell even when the parent infers its whole
  // argument. This is construction context, not permission to fix an opaque representation.
  if let Option<Shared<Type>>.Some {value: blueprint} = &construction.* {
    if run Type.containsOpaque(&blueprint, caller) {
      let kind = Shared.with<Type, OwnerKind>(&blueprint, nominalKind)
      let literal = run bodyNode(&resolver.source, cursor, initializerValue)
      nestedConstruction = match literal {
        Node.RecordExpression {..} => kind == OwnerKind.Struct
        Node.TupleExpression {..} => kind == OwnerKind.Tuple
        _ => false
      }
      if nestedConstruction {
        context = Option.some<Shared<Type>>(Shared.clone<Type>(&blueprint))
      }
    }
  }
  let mut operand = BodyNodeId {index: usize.ZERO}
  let mut checkedAggregateBorrow = false
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&appliedMember) {
      if let Node.BorrowExpression {access, operand: borrowedOperand} = run bodyNode(
        &resolver.source,
        cursor,
        initializerValue,
      ) {
        let mut elementContext = Option.none<Shared<Type>>()
        let targetOwner = Shared.clone<DeclarationId>(&target.owner)
        let ownerId = run DeclarationId.copyShared(&targetOwner)
        if !run typeMentionsOwner(&element, &ownerId) {
          elementContext = Option.some<Shared<Type>>(Shared.clone<Type>(&appliedMember))
        }
        let checked = run checkBorrowOperand(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut statementScope.*,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          initializerValue,
          access,
          borrowedOperand,
          &elementContext,
          true,
          loanOrdinal,
          constraints,
          contractBody,
          false,
          unsafeAllowed,
        )
        let borrowed = match move checked {
          Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
          Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        operand = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {
            syntax: initializerValue,
            span: run bodySpan(&resolver.source, cursor, initializerValue),
          },
          kind: BodyNodeKind.Expression {
            ty: move borrowed.ty,
            form: BodyExpression.Borrow {access: access, value: borrowed.value},
          },
        })
        operand = run sliceArgument(&mut nodes.*, operand, &appliedMember)
        checkedAggregateBorrow = true
      }
    }
  }
  // A fixed reference lifetime still supplies the reborrow context when its referent type is
  // inferred. Check that borrow without the ordinary exact-type boundary; the aggregate unifier
  // below checks the inferred referent and every written binding together.
  if !checkedAggregateBorrow && fixedBorrowContext {
    if let Option<Shared<Type>>.None = &context {
      if let Node.BorrowExpression {access, operand: borrowedOperand} = run bodyNode(&resolver.source, cursor, initializerValue) {
        let borrowContext = Option.some<Shared<Type>>(Shared.clone<Type>(&appliedMember))
        let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
          &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, initializerValue, access, borrowedOperand,
          &borrowContext, false, loanOrdinal, constraints, contractBody, false, unsafeAllowed)
        let borrowed = match move checked {
          Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
          Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        operand = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {syntax: initializerValue, span: run bodySpan(&resolver.source, cursor, initializerValue)},
          kind: BodyNodeKind.Expression {ty: move borrowed.ty,
            form: BodyExpression.Borrow {access: access, value: borrowed.value}},
        })
        checkedAggregateBorrow = true
      }
    }
  }
  if !checkedAggregateBorrow {
    let checked = run checkExpressionUnder(&mut resolver.*, &mut owner.*, &mut request.*,
      &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
      &mut signatures.*, &mut requiredBodies.*, initializerValue, &context,
      constraints, contractBody, false, unsafeAllowed, nestedConstruction)
    operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
  }
  if inferredBorrowRegion {
    if !checkedAggregateBorrow {
      if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, initializerValue) {
        run setBorrowRegion(&mut nodes.*, operand, caller, loanOrdinal)
      }
    }
  }
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    let actual = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &operand) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Result.failResult<BodyNodeId, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, initializerValue)),
      ) }
    }
    let mut variables = Vector.make<Shared<DeclarationId>>()
    run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(&target.owner))
    let initializerSpan = run bodySpan(&resolver.source, cursor, initializerValue)
    let mut failed = run matchCallArgument(&resolver.*, module, initializerSpan, memberType, &actual,
      Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred.*, constraints)
    let mut mismatch = false
    if let Option<Shared<Rejection>>.Some {value} = &failed {
      mismatch = Shared.with<Rejection, bool>(&value, fn(rejection: &Rejection) -> bool { return rejection.code == RejectionCode.TypeMismatch })
    }
    // A field region meeting a binder that an earlier field fixed shortens the binder; a field whose
    // region is one constituent of the new meet reaches it by covariant subtyping (LIFE-002).
    if mismatch && run shortenedAggregateBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target.ty, memberType,
      &actual, Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred.*, initializerSpan) {
      failed = run matchCallArgument(&resolver.*, module, initializerSpan, memberType, &actual,
        Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred.*, constraints)
      let pending = match &failed { Option<Shared<Rejection>>.Some {..} => true Option<Shared<Rejection>>.None => false }
      if pending {
        let fresh = run DeclarationId.copyShared(&target.owner)
        let explicit = Vector.make<usize>()
        let subtyped = run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, memberType, &actual,
          &fresh, caller, Vector.asSlice<Shared<DeclarationId>>(&variables), Vector.asSlice<Binding>(&inferred.*),
          Vector.asSlice<usize>(&explicit), constraints, initializerSpan)
        if let Option<RelatedArgument>.Some {value: candidate} = move subtyped {
          let committed = run matchCallArgument(&resolver.*, module, initializerSpan, memberType, &candidate.ty,
            Vector.asSlice<Shared<DeclarationId>>(&variables), &mut inferred.*, constraints)
          if let Option<Shared<Rejection>>.None = move committed {
            if run retainRegionPairs(&mut resolver.*, BodyOrigin {syntax: initializerValue, span: initializerSpan},
              Vector.asSlice<RegionPair>(&candidate.relations)) {
              failed = Option.none<Shared<Rejection>>()
            }
          }
        }
      }
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move diagnostic)
    }
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(operand)
}

// An inferred aggregate lifetime binder that an earlier field fixed shortens to its `binderMeet`
// with a later field. The declaration must store the binder only covariantly (bootstrap
// NominalVariance), so every earlier field still meets the shorter region.
effect fn shortenedAggregateBinder(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>,
  aggregate: &Shared<Type>, memberType: &Shared<Type>, actual: &Shared<Type>, variables: &[Shared<DeclarationId>],
  inferred: &mut Vector<Binding>, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let shape = run Type.copy(aggregate)
  let mut nominal = Option.none<DeclarationId>()
  let mut arguments = Vector.make<Argument>()
  if let Type.Nominal {declaration: written, arguments: applied, ..} = move shape {
    nominal = Option.some<DeclarationId>(move written)
    arguments = move applied
  }
  let declaration = match move nominal {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => { return false }
  }
  let explicit = Vector.make<usize>()
  let count = Vector.length<Binding>(&inferred.*)
  let mut chosen = usize.MAX
  let mut shorter = Option.none<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < count && chosen == usize.MAX {
    let bindings = Vector.asSlice<Binding>(&inferred.*)
    let ordinal = bindings[at].ordinal
    let region = run binderMeet(memberType, actual, variables, bindings, at, Vector.asSlice<usize>(&explicit))
    if let Option<Shared<Lifetime>>.Some {value: candidate} = move region {
      let mut active = Vector.make<DeclarationId>()
      if run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration,
        Vector.asSlice<Argument>(&arguments), ordinal, &mut active, span) {
        chosen = at
        shorter = Option.some<Shared<Lifetime>>(move candidate)
      }
    }
    at = at + usize.ONE
  }
  if let Option<Shared<Lifetime>>.Some {value} = move shorter {
    let replaced = Vector.asMutSlice<Binding>(&mut inferred.*)
    replaced[chosen].value = Argument.Lifetime {value: move value}
    return true
  }
  return false
}

// The same complete nominal application and bound proof completes structs and union payloads.
effect fn completeAggregateInference(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, recordType: &Shared<Type>,
  inference: &Option<InferredAggregateTarget>, inferred: &[Binding],
  constraints: &[Constraint], span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut completed = Shared.clone<Type>(recordType)
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    completed = run Type.applyBindings(recordType, inferred, true)
    let targetOwner = Shared.clone<DeclarationId>(&target.owner)
    let ownerId = run DeclarationId.copyShared(&targetOwner)
    if run typeMentionsOwner(&completed, &ownerId) {
      let declaredModule = run resolvedModule(&resolver.*, target.module)
      let anchors = run genericAnchors(&mut resolver.*, &declaredModule, target.generics)
      let written = Vector.asSlice<Span>(&anchors.binders)
      let count = Shared.with<Type, usize>(&completed, applicationLength)
      let mut at = usize.ZERO
      while at < count && at < written.length {
        let argument = Shared.with<Type, Option<Argument>>(&completed,
          fn(value: &Type) -> Option<Argument> { return applicationArgument(value, at) })
        if let Option<Argument>.Some {value} = move argument {
          if run argumentMentionsOwner(&value, &ownerId) {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, &declaredModule, RejectionCode.UninferredParameter, written[at]),
            )
          }
        }
        at = at + usize.ONE
      }
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.UninferredParameter, span),
      )
    }
    let declaredModule = run resolvedModule(&resolver.*, target.module)
    if run declaresBounds(&mut resolver.*, &declaredModule, target.declaration) {
      let count = Shared.with<Type, usize>(&completed, applicationLength)
      let mut arguments = Vector.make<Argument>()
      let mut argumentAt = usize.ZERO
      while argumentAt < count {
        let argument = Shared.with<Type, Option<Argument>>(
          &completed,
          fn(ty: &Type) -> Option<Argument> { return applicationArgument(ty, argumentAt) },
        )
        if let Option<Argument>.Some {value} = move argument {
          run Vector.append<Argument>(&mut arguments, move value)
        }
        argumentAt = argumentAt + usize.ONE
      }
      let resolvedBounds = run appliedDeclarationBounds(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        target.module,
        target.declaration,
        target.generics,
        Vector.asSlice<Binder>(&target.binders),
        Vector.asSlice<Argument>(&arguments),
        span,
        target.isPublic,
      )
      let bounds = match move resolvedBounds {
        Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
      let assumptions = run copyConstraints(constraints)
      let failure = run proveAppliedBounds(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &assumptions,
        Vector.asSlice<Constraint>(&bounds),
        module,
        span,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
      }
    }
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(move completed)
}

// Field authority, completeness and written evaluation order of a record literal (STRUCT-002).
// A bare generic owner is inferred transactionally from its checked operands; `.{ ... }` reaches
// this path only through an immediate complete struct expectation.
effect fn checkRecordFields<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  recordType: &Shared<Type>, inference: &Option<InferredAggregateTarget>, fields: Range,
  constraints: &[Constraint], contractBody: bool,
  unsafeAllowed: bool, span: Span,
) -> Result<CheckedRecordFields, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let counted = run recordFieldCount(&mut resolver.*, module, recordType, span)
  let count = match move counted {
    Result<usize, Shared<Rejection>>.Success {value} => value
    Result<usize, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CheckedRecordFields, Shared<Rejection>>(move error)
    }
  }
  if count != fields.length {
    return Result.failResult<CheckedRecordFields, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.CallArity, span),
    )
  }
  let mut inferred = Vector.make<Binding>()
  let mut operands = Vector.make<BodyAggregateField>()
  let mut at = usize.ZERO
  while at < fields.length {
    let initializer = run bodyChild(&resolver.source, cursor, fields, at)
    let written = run bodyNode(&resolver.source, cursor, initializer)
    let mut name = HirId {index: usize.ZERO}
    let mut initializerValue = HirId {index: usize.ZERO}
    if let Node.FieldInitializer {name: fieldNameId, value: fieldValueId} = written {
      name = fieldNameId
      initializerValue = fieldValueId
    } else {
      return Result.failResult<CheckedRecordFields, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    let fieldName = match run bodyNode(&resolver.source, cursor, name) {
      Node.Name {text} => run bodyText(&resolver.source, cursor, text)
      _ => { return Result.failResult<CheckedRecordFields, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.UnknownMember, span),
      ) }
    }
    let fieldSpan = run bodySpan(&resolver.source, cursor, name)
    let selected = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, recordType, Bytes.asSlice(&fieldName), fieldSpan)
    let member = match move selected {
      Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => move value
      Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedRecordFields, Shared<Rejection>>(move error)
      }
    }
    if member.count != fields.length {
      return Result.failResult<CheckedRecordFields, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.CallArity, span),
      )
    }
    let known = Vector.asSlice<BodyAggregateField>(&operands)
    let mut prior = usize.ZERO
    while prior < known.length {
      if known[prior].index == member.index {
        return Result.failResult<CheckedRecordFields, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Collision, run bodySpan(&resolver.source, cursor, name)),
        )
      }
      prior = prior + usize.ONE
    }
    let mut construction = Option.none<Shared<Type>>()
    if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
      if let Option<Shared<Type>>.Some {value: blueprint} = &target.construction {
        let original = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, &blueprint, Bytes.asSlice(&fieldName), fieldSpan)
        match move original {
          Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => { construction = Option.some<Shared<Type>>(move value.ty) }
          Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => { return Result.failResult<CheckedRecordFields, Shared<Rejection>>(move error) }
        }
      }
    }
    let checked = run checkAggregateInitializer(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      &member.ty, inference, &construction, &mut inferred, initializerValue, fields.start,
      constraints, contractBody, unsafeAllowed,
    )
    let operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedRecordFields, Shared<Rejection>>(move error)
      }
    }
    run Vector.append<BodyAggregateField>(&mut operands,
      BodyAggregateField {index: member.index, value: operand})
    at = at + usize.ONE
  }
  let completed = match move run completeAggregateInference(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, recordType, inference,
    Vector.asSlice<Binding>(&inferred), constraints, span,
  ) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CheckedRecordFields, Shared<Rejection>>(move error)
    }
  }
  return Result.succeed<CheckedRecordFields, Shared<Rejection>>(
    CheckedRecordFields {ty: move completed, fields: move operands},
  )
}

// A contextual aggregate literal constructs its expectation only when that is exactly a named
// declaration of the literal's kind (TUPLE-002, RECORD-001); otherwise it is anonymous.
fn namedAggregateExpectation(expected: &Option<Shared<Type>>, kind: OwnerKind) -> Option<Shared<Type>> {
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if Shared.with<Type, OwnerKind>(&value, nominalKind) == kind { return Option.some<Shared<Type>>(Shared.clone<Type>(&value)) }
  }
  return Option.none<Shared<Type>>()
}

// An uncontextualized tuple or record literal finalizes one occurrence-nominal type (RECORD-002).
// Members are checked without context in written order; the literal's syntax names the type.
effect fn checkAnonymousAggregate<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, children: Range, positional: bool, expected: &Option<Shared<Type>>,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut labels = Vector.make<Bytes>()
  let mut members = Vector.make<Shared<Type>>()
  let mut operands = Vector.make<BodyAggregateField>()
  let mut at = usize.ZERO
  while at < children.length {
    let mut value = run bodyChild(&resolver.source, cursor, children, at)
    if !positional {
      let mut name = HirId {index: usize.ZERO}
      if let Node.FieldInitializer {name: fieldNameId, value: fieldValueId} = run bodyNode(&resolver.source, cursor, value) {
        name = fieldNameId
        value = fieldValueId
      } else {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let label = match run bodyNode(&resolver.source, cursor, name) {
        Node.Name {text} => run bodyText(&resolver.source, cursor, text)
        _ => { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, span) }
      }
      let known = Vector.asSlice<Bytes>(&labels)
      let mut prior = usize.ZERO
      while prior < known.length {
        if same(Bytes.asSlice(&known[prior]), Bytes.asSlice(&label)) {
          return run bodyRejection(&resolver.*, module, RejectionCode.Collision, run bodySpan(&resolver.source, cursor, name))
        }
        prior = prior + usize.ONE
      }
      run Vector.append<Bytes>(&mut labels, move label)
    }
    let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      value, &Option.none<Shared<Type>>(), constraints, contractBody, false, unsafeAllowed)
    let operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: checkedValue} => checkedValue
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    let member = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &operand) {
      Option<Shared<Type>>.Some {value: memberType} => memberType
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, value)) }
    }
    run Vector.append<Shared<Type>>(&mut members, move member)
    run Vector.append<BodyAggregateField>(&mut operands, BodyAggregateField {index: at, value: operand})
    at = at + usize.ONE
  }
  let generator = run DeclarationId.copy(caller)
  let occurrence = run Shared.make<AnonymousOccurrence>(AnonymousOccurrence {
    declaration: run Shared.make<DeclarationId>(move generator),
    syntax: expression.index, positional: positional, labels: move labels,
  })
  let ty = run Shared.make<Type>(Type.Anonymous {occurrence: move occurrence, members: move members})
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Aggregate {fields: move operands}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, span)
}

// A literal's declaration comes from the syntax-only abstract-body walk, never from body checking.
effect fn literalOrdinal(resolver: &mut Resolver, module: &ModuleId, expression: HirId) -> Option<usize>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    return ModuleIndex.ordinalAtLocal(IndexedSource.moduleIndex(indexed), expression)
  }
  return Option.none<usize>()
}

effect fn lexicalLocals(locals: &[BodyLocal]) -> Vector<BodyLocal> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<BodyLocal>()
  let mut at = usize.ZERO
  while at < locals.length {
    run Vector.append<BodyLocal>(&mut copied, BodyLocal {origin: locals[at].origin, ty: Shared.clone<Type>(&locals[at].ty), mutable: locals[at].mutable,
      meetDepth: Option.none<usize>()})
    at = at + usize.ONE
  }
  return move copied
}

effect fn localCopyFacts(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>, locals: &[BodyLocal], count: usize, constraints: &[Constraint]) -> Result<Vector<bool>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut copies = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < count {
    let selected = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &locals[at].ty, constraints, locals[at].origin.span)
    match move selected {
      Result<bool, Shared<Rejection>>.Success {value} => run Vector.append<bool>(&mut copies, value && !Type.containsViewBorrow(&locals[at].ty))
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<bool>, Shared<Rejection>>(move error) }
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<bool>, Shared<Rejection>>(move copies)
}

effect fn expressionCopyFacts(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, dependencies: &mut Vector<Dependency>, nodes: &[BodyNode], constraints: &[Constraint]) -> Result<Vector<bool>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut copies = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < nodes.length {
    let mut copied = false
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let selected = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, nodes[at].origin.span)
      match move selected {
        Result<bool, Shared<Rejection>>.Success {value} => { copied = value }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<Vector<bool>, Shared<Rejection>>(move error) }
      }
    }
    run Vector.append<bool>(&mut copies, copied)
    at = at + usize.ONE
  }
  return Result.succeed<Vector<bool>, Shared<Rejection>>(move copies)
}

effect fn anonymousInvocationSlots(signature: &Shared<Result<Answer, NoRejection>>, identity: &DeclarationId) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected { run Type.collectOwned(&value, identity, &mut types, &mut lifetimes, &mut rows) }
    at = at + usize.ONE
  }
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature, signatureResult)
  if let Option<Shared<Type>>.Some {value} = move result { run Type.collectOwned(&value, identity, &mut types, &mut lifetimes, &mut rows) }
  let bounds = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move selected {
      run collectConstraint(&value, identity, &mut types, &mut lifetimes, &mut rows)
    }
    at = at + usize.ONE
  }
  return move lifetimes
}

// `delayed` is the run access of the Effect an anonymous `effect fn` constructs when invoked.
effect fn anonymousUseContract(signature: &Shared<Result<Answer, NoRejection>>, identity: &DeclarationId, mode: CallableMode,
  regions: &[Shared<Lifetime>], delayed: Option<CallableMode>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let mut parameters = Vector.make<Shared<Type>>()
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected { run Vector.append<Shared<Type>>(&mut parameters, move value) }
    at = at + usize.ONE
  }
  let mut result = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => absurd<Shared<Type>>()
  }
  // Invocation representation slots implement authored raw contracts, not capture fields.
  let firstRepresentation = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureCallableParameterStart)
  let countBounds = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  let mut representations = Vector.make<Binding>()
  at = usize.ZERO
  while at < countBounds {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter, contract}} = move bound {
      let slot = Shared.with<Type, usize>(&parameter, fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, identity) })
      if slot != usize.MAX && slot >= firstRepresentation {
        run Vector.append<Binding>(&mut representations, Binding {
          declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(identity)), ordinal: slot,
          value: Argument.Type {value: move contract}})
      }
    }
    at = at + usize.ONE
  }
  let original = Vector.asSlice<Shared<Type>>(&parameters)
  let mut authored = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < original.length {
    run Vector.append<Shared<Type>>(&mut authored, run Type.applyBindings(&original[at], Vector.asSlice<Binding>(&representations), true))
    at = at + usize.ONE
  }
  parameters = move authored
  result = run Type.applyBindings(&result, Vector.asSlice<Binding>(&representations), true)
  let lifetimes = run anonymousInvocationSlots(signature, identity)
  let declared = Vector.asSlice<Shared<Type>>(&parameters)
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  let mut bounds = Vector.make<Outlives>()
  at = usize.ZERO
  while at < boundCount {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Outlives {longer, shorter}} = move selected {
      run Vector.append<Outlives>(&mut bounds, Outlives {longer: move longer, shorter: move shorter})
    }
    at = at + usize.ONE
  }
  let slots = Vector.asSlice<usize>(&lifetimes)
  let mut bindings = Vector.make<Binding>()
  at = usize.ZERO
  while at < slots.length {
    run Vector.append<Binding>(&mut bindings, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(identity)),
      ordinal: slots[at], value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Invocation {ordinal: at})}})
    at = at + usize.ONE
  }
  let assigned = Vector.asSlice<Binding>(&bindings)
  let mut quantified = Vector.make<Shared<Type>>()
  at = usize.ZERO
  while at < declared.length {
    run Vector.append<Shared<Type>>(&mut quantified, run Type.applyBindings(&declared[at], assigned, true))
    at = at + usize.ONE
  }
  let originalBounds = Vector.asSlice<Outlives>(&bounds)
  let mut quantifiedBounds = Vector.make<Outlives>()
  at = usize.ZERO
  while at < originalBounds.length {
    run Vector.append<Outlives>(&mut quantifiedBounds, Outlives {
      longer: run Type.applyLifetimeBindings(&originalBounds[at].longer, assigned),
      shorter: run Type.applyLifetimeBindings(&originalBounds[at].shorter, assigned),
    })
    at = at + usize.ONE
  }
  let returned = run Type.applyBindings(&result, assigned, true)
  let mut produced = Shared.clone<Type>(&returned)
  if let Option<CallableMode>.Some {value: runMode} = move delayed {
    // The constructed Effect retains the closure's environment and every region its stored
    // arguments retain (LIFE-004).
    let mut retained = run copyRegions(regions)
    let none = Vector.make<Option<Shared<Type>>>()
    let mut parameterAt = usize.ZERO
    while parameterAt < Vector.length<Shared<Type>>(&quantified) {
      let stored = Vector.asSlice<Shared<Type>>(&quantified)
      drop run Type.retainedRegions(&stored[parameterAt], identity, Vector.asSlice<Option<Shared<Type>>>(&none), &mut retained)
      parameterAt = parameterAt + usize.ONE
    }
    let declaredFailure = run signatureFailure(signature)
    let declaredRequirements = run signatureRequirements(signature)
    produced = run Shared.make<Type>(Type.Effect {mode: runMode,
      environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&retained))),
      success: move returned, failure: run Type.applyBindings(&declaredFailure, assigned, true),
      requirements: run Row.applyBindings(&declaredRequirements, assigned, true)})
  }
  return run Shared.make<Type>(Type.Callable {mode: mode,
    isUnsafe: Shared.with<Result<Answer, NoRejection>, bool>(signature, signatureUnsafe),
    environment: run Shared.make<Intersection>(run Intersection.of(regions)),
    invocationBinders: slots.length, invocationUse: usize.MAX, invocationBounds: move quantifiedBounds, parameters: move quantified, result: move produced})
}


effect fn copyRegions(regions: &[Shared<Lifetime>]) -> Vector<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < regions.length {
    run Vector.append<Shared<Lifetime>>(&mut copied, Shared.clone<Lifetime>(&regions[at]))
    at = at + usize.ONE
  }
  return move copied
}

// The written parameter types of a signature.
effect fn signatureParameterTypes(signature: &Shared<Result<Answer, NoRejection>>) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut parameters = Vector.make<Shared<Type>>()
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected { run Vector.append<Shared<Type>>(&mut parameters, move value) }
    at = at + usize.ONE
  }
  return move parameters
}

// The run access of an Effect that stores arguments of these types (EFFECT-OWN-002): shared when
// every one is Copy, exclusive when one is an exclusive view, otherwise once.
effect fn storedRunMode(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, stored: &[Shared<Type>], constraints: &[Constraint], span: Span)
  -> Result<CallableMode, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut runMode = CallableMode.Shared
  let mut at = usize.ZERO
  while at < stored.length {
    let exclusive = Shared.with<Type, bool>(&stored[at], fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if exclusive {
      runMode = strongerMode(runMode, CallableMode.Mutable)
    } else {
      let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[at], constraints, span) {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<CallableMode, Shared<Rejection>>(move error) }
      }
      if !copied { runMode = CallableMode.Once }
    }
    at = at + usize.ONE
  }
  return Result.succeed<CallableMode, Shared<Rejection>>(runMode)
}

fn strongerMode(first: CallableMode, second: CallableMode) -> CallableMode {
  if first == CallableMode.Once || second == CallableMode.Once { return CallableMode.Once }
  if first == CallableMode.Mutable || second == CallableMode.Mutable { return CallableMode.Mutable }
  return CallableMode.Shared
}

// Pattern binders are checked places rather than ordinary body locals. Give each visible binder
// an environment alias while retaining its parent place as the construction operand.
effect fn capturePatternLocals(source: &SourceIndex, cursor: &AuthoredCursor, nodes: &[BodyNode],
  locals: &mut Vector<BodyLocal>, parents: &mut Vector<BodyNodeId>) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {access, ..}} = &nodes[at].kind {
      if let Node.BindingPattern {..} = run bodyNode(source, cursor, nodes[at].origin.syntax) {
        run Vector.append<BodyLocal>(&mut locals.*, BodyLocal {origin: nodes[at].origin,
          ty: Shared.clone<Type>(&ty), mutable: access == BodyBindingAccess.Exclusive, meetDepth: Option.none<usize>()})
        run Vector.append<BodyNodeId>(&mut parents.*, BodyNodeId {index: at})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn callableType(ty: &Type) -> bool {
  return match &ty.* { Type.Callable {..} => true Type.CallableSchema {..} => true Type.CallableValue {..} => true Type.CallableStage {..} => true _ => false }
}

fn sharedCallableType(ty: &Type) -> bool {
  return match &ty.* { Type.Callable {mode, ..} => mode == CallableMode.Shared _ => false }
}

effect fn capturePatternOperand(nodes: &[BodyNode], parent: BodyNodeId) -> Option<BodyExpression>
! OutOfMemoryError ? &mut Allocator {
  if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {subject, path, access}, ..} = &nodes[parent.index].kind {
    return Option.some<BodyExpression>(BodyExpression.PatternBinding {subject: subject, path: run copySteps(&path), access: access})
  }
  return Option.none<BodyExpression>()
}

// Declared contents contracts prove public validity. Otherwise a stored parameter remains an
// explicit local obligation; it is not added to the declaration's universally usable premises.
effect fn captureContents(ty: &Shared<Type>, caller: &DeclarationId, constraints: &[Constraint],
  regions: &mut Vector<Shared<Lifetime>>, unresolved: &mut Vector<Shared<Type>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let representations = Vector.make<Option<Shared<Type>>>()
  if run Type.retainedRegions(ty, caller, Vector.asSlice<Option<Shared<Type>>>(&representations), &mut regions.*) { return true }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Contents {subject, region} = &constraints[at] {
      if run Type.equalsShared(ty, &subject) {
        run Vector.append<Shared<Lifetime>>(&mut regions.*, Shared.clone<Lifetime>(&region))
        return true
      }
    }
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      if run Type.equalsShared(ty, &parameter) {
        return run Type.retainedRegions(&contract, caller, Vector.asSlice<Option<Shared<Type>>>(&representations), &mut regions.*)
      }
    }
    at = at + usize.ONE
  }
  let mut parameters = Vector.make<Shared<Type>>()
  run Type.storedParameters(ty, &mut parameters)
  let listed = Vector.asSlice<Shared<Type>>(&parameters)
  if listed.length == usize.ZERO { return false }
  at = usize.ZERO
  while at < listed.length {
    // This recursion reaches individual parameters, not the original aggregate again.
    let parameter = Shared.with<Type, bool>(ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Parameter {..} => true _ => false }
    })
    if parameter {
      run Vector.append<Shared<Type>>(&mut unresolved.*, Shared.clone<Type>(&listed[at]))
    } else {
      if !run captureContents(&listed[at], caller, constraints, &mut regions.*, &mut unresolved.*) { return false }
    }
    at = at + usize.ONE
  }
  return true
}

effect fn captureRetainedRegions(ty: &Shared<Type>, caller: &DeclarationId, ordinal: usize,
  constraints: &[Constraint], regions: &mut Vector<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut unresolved = Vector.make<Shared<Type>>()
  if !run captureContents(ty, caller, constraints, &mut regions.*, &mut unresolved) { return false }
  if Vector.length<Shared<Type>>(&unresolved) != usize.ZERO {
    run Vector.append<Shared<Lifetime>>(&mut regions.*, run Shared.make<Lifetime>(Lifetime.Local {
      declaration: run DeclarationId.copy(caller), ordinal: ordinal}))
  }
  return true
}

// Numeric facts come from the same authored literals that indexed consumption checks. The
// source proof receives typed-node ordinals, never reparses source or backend projections.
effect fn callableMovement(nodes: &[BodyNode], constraints: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Move {..}} = &nodes[at].kind {
      let callable = run callableArgumentContract(&ty, constraints)
      if let Option<Shared<Type>>.Some {..} = move callable { return true }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn captureAvailability(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &[BodyNode], root: BodyNodeId, parameters: usize, constraints: &[Constraint]) -> Option<Shared<Rejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if !CaptureAvailability.applies(nodes) {
    if !run callableMovement(nodes, constraints) { return Option.none<Shared<Rejection>>() }
  }
  let mut indices = Vector.make<Option<usize>>()
  let mut at = usize.ZERO
  while at < nodes.length {
    let mut known = Option.none<usize>()
    if let BodyNodeKind.Expression {form: BodyExpression.Integer {literal}, ..} = &nodes[at].kind {
      if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, literal) {
        if sign == Sign.Positive {
          let digits = run bodyText(&resolver.source, cursor, magnitude)
          known = Type.extentValue(Bytes.asSlice(&digits))
        }
      }
    }
    run Vector.append<Option<usize>>(&mut indices, move known)
    at = at + usize.ONE
  }
  let checked = run CaptureAvailability.check(nodes, Vector.asSlice<Option<usize>>(&indices), root, parameters)
  if let Option<CaptureAvailability.Failure>.Some {value} = move checked {
    let code = match value.kind {
      CaptureFailureKind.Unavailable => RejectionCode.UseAfterMove
      CaptureFailureKind.LoopChanged => RejectionCode.IncompatibleLoopHeader
      CaptureFailureKind.OverlappingWrite => RejectionCode.OverlappingAssignment
      CaptureFailureKind.GuardConsumed => RejectionCode.GuardConsumesPattern
      CaptureFailureKind.Unproved => RejectionCode.CaptureAvailabilityUnavailable
    }
    let mut related = Option.none<RelatedSite>()
    if let Option<BodyOrigin>.Some {value: previous} = &value.previous {
      related = Option.some<RelatedSite>(RelatedSite {module: run ModuleId.copy(module), span: previous.span})
    }
    return Option.some<Shared<Rejection>>(run rejectWithRelated(resolver, module, code, value.origin.span, move related))
  }
  return Option.none<Shared<Rejection>>()
}

// How a checked literal body becomes its use contract.
union LiteralContract {
  // An anonymous `fn` or `effect fn` with a written header. Invoking an `effect fn` constructs the
  // Effect it promises (EFF-001).
  Callable {signature: Shared<Result<Answer, NoRejection>>},
  // An `effect {}` block: running it runs its body, whose channels it derives (EFF-002, EFF-011).
  Block {success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>},
}

// The enclosing locals a literal body sees, before its own parameters.
struct LiteralLocals {
  locals: Vector<BodyLocal>
  // Pattern binders get environment aliases after the ordinary locals; their parent places are the
  // construction operands.
  patternParents: Vector<BodyNodeId>
  ordinaryCount: usize
}

effect fn literalLocals<'scope>(source: &SourceIndex, cursor: &AuthoredCursor, statementScope: &StatementScope<'scope>,
  nodes: &[BodyNode]) -> LiteralLocals ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let ordinaryCount = Vector.length<BodyLocal>(&statementScope.locals.*)
  let mut locals = run lexicalLocals(Vector.asSlice<BodyLocal>(&statementScope.locals.*))
  let mut patternParents = Vector.make<BodyNodeId>()
  run capturePatternLocals(source, cursor, nodes, &mut locals, &mut patternParents)
  return LiteralLocals {locals: move locals, patternParents: move patternParents, ordinaryCount: ordinaryCount}
}

// The annotation and call facts of a literal's own block.
effect fn literalFacts(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, moduleOrdinal: usize, ordinal: usize, block: HirId)
  -> Result<BodyFacts, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut annotations = Vector.make<HirId>()
  let mut writtenCalls = Vector.make<CallSyntax>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let hir = IndexedSource.authored(indexed)
    if let Node.Block {statements} = Module.node(hir, block) { run collectBodySyntax(hir, statements, &mut annotations, &mut writtenCalls) }
  }
  return run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal, &annotations, &writtenCalls)
}

effect fn checkAnonymous<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, nodes: &mut Vector<BodyNode>, expression: HirId,
  expected: &Option<Shared<Type>>, constraints: &[Constraint],
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let position = run literalOrdinal(&mut resolver.*, module, expression)
  let ordinal = match move position {
    Option<usize>.Some {value} => value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, Key {
    family: Family.Signature, module: moduleOrdinal, declaration: ordinal, name: usize.ZERO, member: usize.ZERO, external: false,
  }, span)
  let refused = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(&signature, answerRejection)
  if let Option<Shared<Rejection>>.Some {value: rejected} = move refused {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move rejected)
  }
  let sourceAnswer = run source(&mut resolver.*, module)
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureParameterCount)
  let prepared = match move sourceOf(&resolver.*, &sourceAnswer, module) {
    Option<&IndexedSource>.Some {value: indexed} => run prepareBody(&resolver.*, module, indexed, ordinal, &signature, count, true, false)
    _ => Result.failResult<PreparedBody, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let preparedBody = match move prepared {
    Result<PreparedBody, Shared<Rejection>>.Success {value} => move value
    Result<PreparedBody, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let PreparedBody {block, identity, locals: parameters, ..} = move preparedBody
  let facts = run literalFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal, block)
  let resolvedFacts = match move facts {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let BodyFacts {annotations: resolvedAnnotations, calls} = move resolvedFacts
  let lexical = run literalLocals(&resolver.source, cursor, &statementScope.*, Vector.asSlice<BodyNode>(&nodes.*))
  let LiteralLocals {locals: outer, patternParents, ordinaryCount} = move lexical
  let mut locals = move outer
  let outerCount = Vector.length<BodyLocal>(&locals)
  let writtenParameters = Vector.asSlice<BodyLocal>(&parameters)
  let mut at = usize.ZERO
  while at < writtenParameters.length {
    run Vector.append<BodyLocal>(&mut locals, BodyLocal {origin: writtenParameters[at].origin,
      ty: Shared.clone<Type>(&writtenParameters[at].ty), mutable: writtenParameters[at].mutable, meetDepth: Option.none<usize>()})
    at = at + usize.ONE
  }
  let resultType = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let mut lexicalConstraints = run copyConstraints(constraints)
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureConstraintCount)
  at = usize.ZERO
  while at < boundCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move bound { run Vector.append<Constraint>(&mut lexicalConstraints, move value) }
    at = at + usize.ONE
  }
  let bodyConstraints = Vector.asSlice<Constraint>(&lexicalConstraints)
  let mut checkedNodes = Vector.make<BodyNode>()
  let mut signatures = Vector.make<SignatureDependency>()
  let mut required = Vector.make<DeclarationId>()
  run enterBodyFrame(&mut resolver.*, &signature)
  let checked = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
    &mut locals, Vector.asSlice<ResolvedAnnotation>(&resolvedAnnotations), Vector.asSlice<ResolvedCall>(&calls),
    &mut checkedNodes, &mut signatures, &mut required, block, &resultType, bodyConstraints, true, false, usize.ZERO, false)
  let relations = leaveBodyFrame(&mut resolver.*)
  let control = match move checked {
    Result<CheckedControl, Shared<Rejection>>.Success {value} => value
    Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  if control.canComplete && Shared.with<Type, usize>(&resultType, scalarCode) != usize.ONE {
    let closing = run bodySpan(&resolver.source, cursor, block)
    return run bodyRejection(&resolver.*, module, RejectionCode.MissingReturn, Span.make(closing.end - usize.ONE, closing.end))
  }
  let checkedBody = CheckedLiteral {ordinal: ordinal, identity: move identity, locals: move locals, outerCount: outerCount,
    ordinaryCount: ordinaryCount, patternParents: move patternParents, parameters: count, nodes: move checkedNodes,
    root: control.node, signatures: move signatures, required: move required, relations: move relations}
  return run finishLiteral(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut nodes.*, expression, span, expected, constraints, bodyConstraints, move checkedBody, LiteralContract.Callable {signature: move signature})
}

// An `effect {}` block is checked like an anonymous body with no parameters. Without a header, its
// channels are the join of what its body returns, fails with and runs (EFF-002, EFF-011). Sites
// whose type differs from that join are checked again against it, so each converts exactly as in
// a declared body.
effect fn checkEffectBlock<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, nodes: &mut Vector<BodyNode>, expression: HirId, block: HirId,
  expected: &Option<Shared<Type>>, constraints: &[Constraint],
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let position = run literalOrdinal(&mut resolver.*, module, expression)
  let ordinal = match move position {
    Option<usize>.Some {value} => value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let identity = match move run declarationAt(&mut resolver.*, module, ordinal) {
    Option<DeclarationId>.Some {value} => value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let facts = run literalFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal, block)
  let resolvedFacts = match move facts {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let BodyFacts {annotations: resolvedAnnotations, calls} = move resolvedFacts
  let lexical = run literalLocals(&resolver.source, cursor, &statementScope.*, Vector.asSlice<BodyNode>(&nodes.*))
  let LiteralLocals {locals: outer, patternParents, ordinaryCount} = move lexical
  let outerCount = Vector.length<BodyLocal>(&outer)
  let unit = run Shared.make<Type>(Type.Unit)
  let mut locals = run lexicalLocals(Vector.asSlice<BodyLocal>(&outer))
  let mut checkedNodes = Vector.make<BodyNode>()
  let mut signatures = Vector.make<SignatureDependency>()
  let mut required = Vector.make<DeclarationId>()
  // A closed expected Effect supplies the block's channels (EFF-011): its body is checked against
  // them directly, so returns convert to the expected success and undeclared failures or
  // requirements are reported where they occur.
  let expectedChannels = run expectedBlockChannels(expected)
  if let Option<EffectChannels>.Some {value: declared} = move expectedChannels {
    run Vector.append<BodyFrame>(&mut resolver.*.bodies, BodyFrame {isEffect: true, failure: Shared.clone<Type>(&declared.failure),
      requirements: Shared.clone<Row>(&declared.requirements), derived: Option.none<DerivedChannels>(),
      obligations: Vector.make<BodySafetyObligation>(), occurrences: Vector.make<SelectedFact>()})
    let declaredCheck = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
      &mut locals, Vector.asSlice<ResolvedAnnotation>(&resolvedAnnotations), Vector.asSlice<ResolvedCall>(&calls),
      &mut checkedNodes, &mut signatures, &mut required, block, &declared.success, constraints, true, false, usize.ZERO, false)
    let declaredRelations = leaveBodyFrame(&mut resolver.*)
    let checked = match move declaredCheck {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    if checked.canComplete && Shared.with<Type, usize>(&declared.success, scalarCode) != usize.ONE {
      let closing = run bodySpan(&resolver.source, cursor, block)
      return run bodyRejection(&resolver.*, module, RejectionCode.MissingReturn, Span.make(closing.end - usize.ONE, closing.end))
    }
    let checkedBody = CheckedLiteral {ordinal: ordinal, identity: move identity, locals: move locals, outerCount: outerCount,
      ordinaryCount: ordinaryCount, patternParents: move patternParents, parameters: usize.ZERO, nodes: move checkedNodes,
      root: checked.node, signatures: move signatures, required: move required, relations: move declaredRelations}
    return run finishLiteral(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut nodes.*, expression, span, expected, constraints, constraints, move checkedBody,
      LiteralContract.Block {success: move declared.success, failure: move declared.failure, requirements: move declared.requirements})
  }
  run Vector.append<BodyFrame>(&mut resolver.*.bodies, BodyFrame {isEffect: true,
    failure: run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()}),
    requirements: run Shared.make<Row>(Row.empty()), derived: Option.some<DerivedChannels>(DerivedChannels {
      returns: Vector.make<Shared<Type>>(), failed: Vector.make<Shared<Type>>(), failures: Vector.make<Shared<Type>>(),
      requirements: Row.empty()}), obligations: Vector.make<BodySafetyObligation>(), occurrences: Vector.make<SelectedFact>()})
  let derivedCheck = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
    &mut locals, Vector.asSlice<ResolvedAnnotation>(&resolvedAnnotations), Vector.asSlice<ResolvedCall>(&calls),
    &mut checkedNodes, &mut signatures, &mut required, block, &unit, constraints, true, false, usize.ZERO, false)
  let frame = Vector.pop<BodyFrame>(&mut resolver.*.bodies)
  let mut control = match move derivedCheck {
    Result<CheckedControl, Shared<Rejection>>.Success {value} => value
    Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let popped = match move frame {
    Option<BodyFrame>.Some {value} => value
    Option<BodyFrame>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  // A body checked again against its joined channels retains only that check's relations.
  let BodyFrame {derived: derivedFacts, obligations: derivedRelations, ..} = move popped
  let mut relations = move derivedRelations
  let derived = match move derivedFacts {
    Option<DerivedChannels>.Some {value} => value
    Option<DerivedChannels>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let DerivedChannels {returns, failed, failures, requirements: ran} = move derived
  let returned = Vector.asSlice<Shared<Type>>(&returns)
  let mut successes = run copyTypes(returned)
  // Falling off the end returns `()` only when nothing else is returned (EFF-002).
  if control.canComplete && returned.length == usize.ZERO { run Vector.append<Shared<Type>>(&mut successes, Shared.clone<Type>(&unit)) }
  let success = run joinedType(move successes)
  let failure = run joinedType(move failures)
  let requirements = run Shared.make<Row>(move ran)
  let mut exact = true
  let mut at = usize.ZERO
  while at < returned.length {
    if !run Type.equalsShared(&returned[at], &success) { exact = false }
    at = at + usize.ONE
  }
  let failedSites = Vector.asSlice<Shared<Type>>(&failed)
  at = usize.ZERO
  while at < failedSites.length {
    if !run Type.equalsShared(&failedSites[at], &failure) { exact = false }
    at = at + usize.ONE
  }
  if !exact {
    locals = run lexicalLocals(Vector.asSlice<BodyLocal>(&outer))
    checkedNodes = Vector.make<BodyNode>()
    signatures = Vector.make<SignatureDependency>()
    required = Vector.make<DeclarationId>()
    run Vector.append<BodyFrame>(&mut resolver.*.bodies, BodyFrame {isEffect: true, failure: Shared.clone<Type>(&failure),
      requirements: Shared.clone<Row>(&requirements), derived: Option.none<DerivedChannels>(),
      obligations: Vector.make<BodySafetyObligation>(), occurrences: Vector.make<SelectedFact>()})
    let declaredCheck = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
      &mut locals, Vector.asSlice<ResolvedAnnotation>(&resolvedAnnotations), Vector.asSlice<ResolvedCall>(&calls),
      &mut checkedNodes, &mut signatures, &mut required, block, &success, constraints, true, false, usize.ZERO, false)
    relations = leaveBodyFrame(&mut resolver.*)
    control = match move declaredCheck {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
  }
  if control.canComplete && Shared.with<Type, usize>(&success, scalarCode) != usize.ONE {
    let closing = run bodySpan(&resolver.source, cursor, block)
    return run bodyRejection(&resolver.*, module, RejectionCode.MissingReturn, Span.make(closing.end - usize.ONE, closing.end))
  }
  let checkedBody = CheckedLiteral {ordinal: ordinal, identity: move identity, locals: move locals, outerCount: outerCount,
    ordinaryCount: ordinaryCount, patternParents: move patternParents, parameters: usize.ZERO, nodes: move checkedNodes,
    root: control.node, signatures: move signatures, required: move required, relations: move relations}
  return run finishLiteral(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut nodes.*, expression, span, expected, constraints, constraints, move checkedBody,
    LiteralContract.Block {success: move success, failure: move failure, requirements: move requirements})
}

// The channels of a closed written Effect the block is expected to be; an open or absent
// expectation leaves the block to derive its own.
effect fn expectedBlockChannels(expected: &Option<Shared<Type>>) -> Option<EffectChannels> ! OutOfMemoryError ? &mut Allocator {
  let ty = match &expected.* {
    Option<Shared<Type>>.Some {value} => Shared.clone<Type>(&value)
    _ => { return Option.none<EffectChannels>() }
  }
  if Type.hasOpenParameters(&ty) { return Option.none<EffectChannels>() }
  return Shared.with<Type, Option<EffectChannels>>(&ty, fn(value: &Type) -> Option<EffectChannels> {
    return match &value.* { Type.Effect {..} => effectChannels(value) _ => Option.none<EffectChannels>() }
  })
}

// One literal body after checking, before its environment is built.
struct CheckedLiteral {
  ordinal: usize
  identity: DeclarationId
  locals: Vector<BodyLocal>
  outerCount: usize
  ordinaryCount: usize
  patternParents: Vector<BodyNodeId>
  parameters: usize
  nodes: Vector<BodyNode>
  root: BodyNodeId
  signatures: Vector<SignatureDependency>
  required: Vector<DeclarationId>
  // The region relations its typing admitted without proof.
  relations: Vector<BodySafetyObligation>
}

// Builds a checked literal's environment from its captures and appends the construction: the
// literal's exact representation, whose runner is its own instance (MIR note §7, Effect note D1).
effect fn finishLiteral(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>, expression: HirId, span: Span, expected: &Option<Shared<Type>>, constraints: &[Constraint],
  bodyConstraints: &[Constraint], literal: CheckedLiteral, literalContract: LiteralContract,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let CheckedLiteral {ordinal, identity, locals, outerCount, ordinaryCount, patternParents, parameters: count,
    nodes: checkedNodes, root, signatures, required, relations} = move literal
  if let Option<Span>.Some {value: stranded} = move strandedInterfaceEffect(Vector.asSlice<BodyNode>(&checkedNodes)) {
    return run bodyRejection(&resolver.*, module, RejectionCode.InterfaceEffectUnavailable, stranded)
  }
  let availability = run captureAvailability(&resolver.*, module, cursor, Vector.asSlice<BodyNode>(&checkedNodes), root, outerCount + count, bodyConstraints)
  if let Option<Shared<Rejection>>.Some {value} = move availability {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
  }
  let localCopies = match move run localCopyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, Vector.asSlice<BodyLocal>(&locals), outerCount, bodyConstraints) {
    Result<Vector<bool>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<bool>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let expressionCopies = match move run expressionCopyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, Vector.asSlice<BodyNode>(&checkedNodes), bodyConstraints) {
    Result<Vector<bool>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<bool>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let captures = run Capture.collect(Vector.asSlice<BodyNode>(&checkedNodes), Vector.asSlice<BodyLocal>(&locals), outerCount,
    Vector.asSlice<bool>(&localCopies), Vector.asSlice<bool>(&expressionCopies))
  let captured = Vector.asSlice<Capture.Capture>(&captures)
  let mode = Capture.invocation(captured)
  let mut fieldTypes = Vector.make<Shared<Type>>()
  let mut fields = Vector.make<BodyAggregateField>()
  let mut aliases = Vector.make<BodyEnvironmentCapture>()
  let mut regions = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < captured.length {
    let capture = &captured[at]
    let mut local = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    if capture.local.index < ordinaryCount {
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
        ty: Shared.clone<Type>(&capture.ty), form: BodyExpression.Local {local: capture.local}}})
    } else {
      let parent = Vector.get<BodyNodeId>(&patternParents, capture.local.index - ordinaryCount)
      let copied = run capturePatternOperand(Vector.asSlice<BodyNode>(&nodes.*), parent)
      if let Option<BodyExpression>.Some {value: binding} = move copied {
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
          ty: Shared.clone<Type>(&capture.ty), form: move binding}})
      }
    }
    let mut operand = local
    let mut fieldType = Shared.clone<Type>(&capture.ty)
    let view = Shared.with<Type, bool>(&capture.ty, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Reference {..} => true
        Type.Slice {..} => true
        Type.String {..} => true
        Type.Callable {..} => true
        _ => false
      }
    })
    // Descriptors carry their existing source loan. Exact callable values and opaque returned
    // representations own their environment; shared/exclusive access borrows that owner.
    let borrowed = !view && (capture.access == CaptureAccess.Shared || capture.access == CaptureAccess.Mutable)
    if borrowed {
      let mut access = Access.Shared
      if capture.access == CaptureAccess.Mutable { access = Access.Mutable }
      let region = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(caller), ordinal: expression.index})
      fieldType = run Shared.make<Type>(Type.Reference {access: access, referent: Shared.clone<Type>(&capture.ty), lifetime: move region})
      operand = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
        ty: Shared.clone<Type>(&fieldType), form: BodyExpression.Borrow {access: access, value: local}}})
    }
    if capture.access == CaptureAccess.Move {
      let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
        Vector.asSlice<BodyNode>(&nodes.*), local, false, false, capture.accessOrigin.span, capture.accessOrigin.span, constraints) {
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      operand = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
        ty: Shared.clone<Type>(&capture.ty), form: BodyExpression.Move {value: local, consumed: move consumed}}})
    }
    let known = run captureRetainedRegions(&fieldType, caller, expression.index, bodyConstraints, &mut regions)
    if !known { return run bodyRejection(&resolver.*, module, RejectionCode.AmbiguousLifetime, capture.firstUse.span) }
    run Vector.append<Shared<Type>>(&mut fieldTypes, move fieldType)
    run Vector.append<BodyAggregateField>(&mut fields, BodyAggregateField {index: at, value: operand})
    run Vector.append<BodyEnvironmentCapture>(&mut aliases, BodyEnvironmentCapture {local: capture.local, field: at, dereference: borrowed})
    at = at + usize.ONE
  }
  let schemaAnswer = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, true, &identity, span)
  let schema = match move schemaAnswer {
    Option<TargetSchema>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let ownSlots = Vector.asSlice<ApplicationSlot>(&schema.own)
  let mut ownArguments = Vector.make<Argument>()
  at = usize.ZERO
  while at < ownSlots.length {
    run Vector.append<Argument>(&mut ownArguments, run scopeArgument(&identity, ownSlots[at].ordinal, ownSlots[at].kind))
    at = at + usize.ONE
  }
  let application = run Shared.make<Application>(Application {target: SpecializationTarget.Named {declaration: run DeclarationId.copy(&identity)},
    arguments: move ownArguments, argumentOrdinals: run applicationOrdinals(ownSlots), scopes: run formalCallableScopes(&schema), statics: Vector.make<StaticSlot>()})
  let environment = Vector.asSlice<Shared<Lifetime>>(&regions)
  let mut useContract = Option.none<Shared<Type>>()
  let mut representationSignature = Option.none<Shared<Result<Answer, NoRejection>>>()
  if let LiteralContract.Callable {signature} = &literalContract {
    representationSignature = Option.some<Shared<Result<Answer, NoRejection>>>(Shared.clone<Result<Answer, NoRejection>>(&signature))
    // Invoking an anonymous `effect fn` constructs an Effect whose run access follows its stored
    // arguments, as a named `effect fn` value's does (EFFECT-OWN-002), and no weaker than the
    // closure's own access to its environment.
    let mut delayed = Option.none<CallableMode>()
    if Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureIsEffect) {
      let written = run signatureParameterTypes(&signature)
      let stored = match move run storedRunMode(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        Vector.asSlice<Shared<Type>>(&written), bodyConstraints, span) {
        Result<CallableMode, Shared<Rejection>>.Success {value} => value
        Result<CallableMode, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      delayed = Option.some<CallableMode>(strongerMode(stored, mode))
    }
    useContract = Option.some<Shared<Type>>(run anonymousUseContract(&signature, &identity, mode, environment, move delayed))
  }
  if let LiteralContract.Block {success, failure, requirements} = move literalContract {
    useContract = Option.some<Shared<Type>>(run Shared.make<Type>(Type.Effect {mode: mode,
      environment: run Shared.make<Intersection>(run Intersection.of(environment)), success: move success, failure: move failure,
      requirements: move requirements}))
  }
  let selectedContract = match move useContract {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let exact = match move representationSignature {
    Option<Shared<Result<Answer, NoRejection>>>.Some {value: signature} => run anonymousEnvironmentType(&identity, &signature, move application, move selectedContract, move fieldTypes, ownSlots)
    Option<Shared<Result<Answer, NoRejection>>>.None => run Type.callableValue(false, move application, move selectedContract, move fieldTypes, Vector.make<CallableFieldInput>())
  }
  let sourceAnswer = run source(&mut resolver.*, module)
  let selectedInput = run SourceIndex.bodyInput(&mut resolver.source, &sourceAnswer, module, ordinal)
  let input = match move selectedInput {
    Option<Shared<BodyInput>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let obligations = run bodySafetyObligations(&identity, Vector.asSlice<BodyLocal>(&locals), Vector.asSlice<BodyNode>(&checkedNodes),
    bodyConstraints, move relations)
  let mut body = run TypedBody.make(&identity, move input, move locals, move checkedNodes, root, move signatures,
    move required, BodyStage.ContractTyped {obligations: move obligations}, Vector.make<SelectedFact>())
  let preparedEnvironment = run TypedBody.materializeEnvironment(move body, BodyEnvironment {ty: Shared.clone<Type>(&exact), outerCount: outerCount, captures: move aliases})
  let ready = match move preparedEnvironment {
    Option<TypedBody>.Some {value} => value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let id = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: expression, span: span}, kind: BodyNodeKind.Expression {
    ty: move exact, form: BodyExpression.Callable {fields: move fields, body: run Shared.make<TypedBody>(move ready)}}})
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    id, expected, span)
}

// Deferred invocation arguments select code; only captured lexical values form storage.
effect fn anonymousEnvironmentType(identity: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>,
  application: Shared<Application>, contract: Shared<Type>, fields: Vector<Shared<Type>>, ownSlots: &[ApplicationSlot]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureCallableParameterStart) == usize.MAX {
    return run Type.callableValue(false, move application, move contract, move fields, Vector.make<CallableFieldInput>())
  }
  let formal = run Application.copyShared(&application)
  let bindings = run Application.bindings(&formal)
  let allBindings = Vector.asSlice<Binding>(&bindings)
  let mut selected = Vector.make<Binding>()
  let mut at = usize.ZERO
  while at < allBindings.length {
    if !declarationEqualsShared(identity, &allBindings[at].declaration) {
      run Vector.append<Binding>(&mut selected, Binding {declaration: Shared.clone<DeclarationId>(&allBindings[at].declaration),
        ordinal: allBindings[at].ordinal, value: Argument.copy(&allBindings[at].value)})
    }
    at = at + usize.ONE
  }
  let recipe = run Shared.make<SectionSchema>(SectionSchema {
    target: run Shared.make<DeclarationId>(run DeclarationId.copy(identity)), contract: move contract,
    selected: move selected, deferred: run applicationOrdinals(ownSlots)})
  return run Type.callableSchema(move recipe, move fields, Vector.make<CallableFieldInput>())
}

// Original HIR binders are shared by generated iterations; a finished iteration's actual
// local/node ranges have left lexical scope. Lookup retains the outer body's bindings and
// the currently checked occurrence, which is recorded only after its body succeeds.
fn completedOccurrenceContains(resolver: &Resolver, index: usize, local: bool) -> bool {
  let frames = Vector.asSlice<BodyFrame>(&resolver.bodies)
  if frames.length == usize.ZERO { return false }
  let facts = Vector.asSlice<SelectedFact>(&frames[frames.length - usize.ONE].occurrences)
  let mut at = usize.ZERO
  while at < facts.length {
    if let SelectedFact.Iteration {nodeStart, nodeEnd, localStart, localEnd, ..} = &facts[at] {
      let mut start = nodeStart
      let mut end = nodeEnd
      if local {
        start = localStart
        end = localEnd
      }
      if start <= index && index < end { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyLocalIndex(resolver: &Resolver, locals: &[BodyLocal], syntax: usize) -> Option<usize> {
  let mut at = usize.ZERO
  while at < locals.length {
    if locals[at].origin.syntax.index == syntax && !completedOccurrenceContains(resolver, at, true) {
      return Option.some<usize>(at)
    }
    at = at + usize.ONE
  }
  return Option.none<usize>()
}

fn contextualArrayShape(expected: &Option<Shared<Type>>) -> Option<ArrayShape> {
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    return Type.arrayShape(&value)
  }
  return Option.none<ArrayShape>()
}

struct CheckedIdentifier {
  ty: Shared<Type>
  form: BodyExpression
}

// Function values are handled by the construction path before this helper. An unbound identifier
// here names a constant; a bound one names a local or runtime pattern binder.
effect fn checkedIdentifier(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &[BodyLocal],
  calls: &[ResolvedCall],
  nodes: &[BodyNode],
  expression: HirId,
  name: HirId,
  bound: bool,
  binder: HirId,
  span: Span,
  staticBody: bool,
) -> Result<CheckedIdentifier, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if !bound {
    let found = run resolvedCall(calls, expression)
    let resolved = match move found {
      Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} => value
      Option<Result<ResolvedTarget, Shared<Rejection>>>.None => {
        return Result.failResult<CheckedIdentifier, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.UnknownName, run bodySpan(&resolver.source, cursor, name)),
        )
      }
    }
    return match move resolved {
      Result<ResolvedTarget, Shared<Rejection>>.Success {
        value: ResolvedTarget.Constant {declaration, ty: constantType},
      } => {
        if staticBody {
          return Result.succeed<CheckedIdentifier, Shared<Rejection>>(CheckedIdentifier {
            ty: move constantType,
            form: BodyExpression.Constant {
              declaration: run Shared.make<DeclarationId>(move declaration),
            },
          })
        }
        let read = run runtimeConstantRead(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, move declaration, span)
        return match move read {
          Result<BodyExpression, Shared<Rejection>>.Success {value: form} => Result.succeed<CheckedIdentifier, Shared<Rejection>>(
            CheckedIdentifier {ty: move constantType, form: move form},
          )
          Result<BodyExpression, Shared<Rejection>>.Failure {error} => Result.failResult<CheckedIdentifier, Shared<Rejection>>(move error)
        }
      }
      Result<ResolvedTarget, Shared<Rejection>>.Success {value: _} => Result.failResult<CheckedIdentifier, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.UnknownName, run bodySpan(&resolver.source, cursor, name)),
      )
      Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Result.failResult<CheckedIdentifier, Shared<Rejection>>(move error)
    }
  }
  if let Option<usize>.Some {value: at} = move bodyLocalIndex(&resolver.*, locals, binder.index) {
    return Result.succeed<CheckedIdentifier, Shared<Rejection>>(CheckedIdentifier {
      ty: Shared.clone<Type>(&locals[at].ty),
      form: BodyExpression.Local {local: BodyLocalId {index: at}},
    })
  }
  if !staticBody {
    let used = run patternBindingUse(&resolver.*, nodes, binder)
    if let Option<PatternBindingUse>.Some {value: use} = move used {
      return Result.succeed<CheckedIdentifier, Shared<Rejection>>(CheckedIdentifier {
        ty: move use.ty,
        form: move use.form,
      })
    }
  }
  if staticBody {
    return Result.failResult<CheckedIdentifier, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, cursor, name)),
    )
  }
  return Result.failResult<CheckedIdentifier, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

// An element rejected with a mismatch at its own span is reported as an array element mismatch.
effect fn checkArrayElement<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  child: HirId,
  elementType: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    child, elementType, constraints, contractBody, staticBody, unsafeAllowed)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      let childSpan = run bodySpan(&resolver.source, cursor, child)
      let direct = Shared.with<Rejection, bool>(&error, fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.TypeMismatch && value.span.start == childSpan.start && value.span.end == childSpan.end
      })
      if direct { return run bodyRejection(&resolver.*, module, RejectionCode.ArrayElementMismatch, childSpan) }
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
}

// None means no overload was selected, leaving only the closed scalar form to apply.
effect fn checkedSelectedOperator(
  resolver: &mut Resolver,
  caller: &DeclarationId,
  nodes: &[BodyNode],
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  constraints: &[Constraint],
  closed: bool,
  module: &ModuleId,
  operatorAnchor: Span,
  firstArgument: BodyNodeId,
  secondArgument: Option<BodyNodeId>,
  unsafeAllowed: bool,
) -> Result<Option<CheckedOperatorCall>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let selected = run selectOperator(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    requested,
    operands,
    constraints,
    closed,
    module,
    operatorAnchor,
  )
  let available = match move selected {
    Result<Option<SelectedOperator>, Shared<Rejection>>.Success {value} => value
    Result<Option<SelectedOperator>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<CheckedOperatorCall>, Shared<Rejection>>(move error)
    }
  }
  let chosen = match move available {
    Option<SelectedOperator>.Some {value} => value
    Option<SelectedOperator>.None => {
      return Result.succeed<Option<CheckedOperatorCall>, Shared<Rejection>>(
        Option.none<CheckedOperatorCall>(),
      )
    }
  }
  let mut arguments = Vector.make<BodyNodeId>()
  run Vector.append<BodyNodeId>(&mut arguments, firstArgument)
  if let Option<BodyNodeId>.Some {value: second} = move secondArgument {
    run Vector.append<BodyNodeId>(&mut arguments, second)
  }
  let typed = run checkedOperatorCall(
    &mut resolver.*,
    &mut owner.*, &mut dependencies.*, caller, nodes, constraints,
    move chosen,
    move arguments,
    &mut signatures.*,
    &mut requiredBodies.*,
    module,
    operatorAnchor,
    unsafeAllowed,
  )
  let accepted = match move typed {
    Result<CheckedOperatorCall, Shared<Rejection>>.Success {value} => value
    Result<CheckedOperatorCall, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<CheckedOperatorCall>, Shared<Rejection>>(move error)
    }
  }
  return Result.succeed<Option<CheckedOperatorCall>, Shared<Rejection>>(
    Option.some<CheckedOperatorCall>(move accepted),
  )
}

// A field lookup that missed may still name a bound method, which is rejected distinctly.
effect fn rejectMissingField(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  subjectType: &Shared<Type>,
  name: &[u8],
  fieldSpan: Span,
  span: Span,
  error: Shared<Rejection>,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if !Shared.with<Rejection, bool>(&error, fn(value: &Rejection) -> bool {
    return value.code == RejectionCode.UnknownMember
  }) {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
  }
  let method = run selectInherentReceiverCall(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, true, subjectType, name, false, true, module, fieldSpan)
  match move method {
    Result<InherentCallChoice, Shared<Rejection>>.Success {value: InherentCallChoice.Selected {..}} => {
      return run bodyRejection(&resolver.*, module, RejectionCode.BoundMethodUnavailable, span)
    }
    Result<InherentCallChoice, Shared<Rejection>>.Failure {error: diagnostic} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move diagnostic)
    }
    _ => ()
  }
  return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
}

// A field read outside a static body: enum members and unit variants answer first, then the
// subject is dereferenced through references before the field is selected.
effect fn checkFieldAccess<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  subject: HirId,
  field: HirId,
  span: Span,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let qualified = run bodyQualifiedName(&resolver.source, cursor, expression)
  if let Option<QualifiedBodyName>.Some {value} = move qualified {
    let selection = run checkedEnumSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, Bytes.asSlice(&value.namespace), Bytes.asSlice(&value.member), span, false)
    if let Option<Result<EnumSelection, Shared<Rejection>>>.Some {value: selected} = move selection {
      let chosen = match move selected {
        Result<EnumSelection, Shared<Rejection>>.Success {value: choice} => choice
        Result<EnumSelection, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      if let EnumSelection.Member {ty: enumType, member} = move chosen {
        let index = Vector.length<BodyNode>(&nodes.*)
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
          origin: BodyOrigin {syntax: expression, span: span},
          kind: BodyNodeKind.Expression {ty: move enumType, form: BodyExpression.EnumMember {member: member}},
        })
        return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          BodyNodeId {index: index}, expected, span)
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let unitSelection = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      Bytes.asSlice(&value.namespace), Bytes.asSlice(&value.member), expected, span)
    if let Option<Result<SelectedVariant, Shared<Rejection>>>.Some {value: chosen} = move unitSelection {
      let variant = match move chosen {
        Result<SelectedVariant, Shared<Rejection>>.Success {value: selectedVariant} => selectedVariant
        Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      if variant.shape.braces { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
      return run checkVariantConstruct(
        &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, Result.succeed<SelectedVariant, Shared<Rejection>>(move variant), Range.empty(),
        expected, constraints, contractBody, unsafeAllowed, span,
      )
    }
  }
  // A qualified constant is a declaration selection, not a runtime namespace value. Preserve
  // enum and unit-variant construction above, then read the constant's published value.
  let constantSelection = run resolvedCall(calls, expression)
  if let Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} = move constantSelection {
    if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Constant {declaration, ty: constantType}} = move value {
      let read = run runtimeConstantRead(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, move declaration, span)
      let form = match move read {
        Result<BodyExpression, Shared<Rejection>>.Success {value: selected} => selected
        Result<BodyExpression, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let index = Vector.length<BodyNode>(&nodes.*)
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
        origin: BodyOrigin {syntax: expression, span: span},
        kind: BodyNodeKind.Expression {ty: move constantType, form: move form},
      })
      return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
        BodyNodeId {index: index}, expected, span)
    }
  }
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, subject, &Option.none<Shared<Type>>(),
    constraints, contractBody, false, unsafeAllowed)
  let subjectNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  return run projectFieldValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, constraints, &mut nodes.*, expression, subject, field, span, subjectNode, expected)
}

// Field expressions and field invocation share privacy, reference dereference and applied
// member typing, while retaining the subject node supplied by the owning expression checker.
effect fn projectFieldValue(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request, dependencies: &mut Vector<Dependency>, module: &ModuleId,
  cursor: &AuthoredCursor, caller: &DeclarationId, constraints: &[Constraint], nodes: &mut Vector<BodyNode>, expression: HirId,
  subject: HirId, field: HirId, span: Span, checkedSubject: BodyNodeId, expected: &Option<Shared<Type>>)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut subjectNode = checkedSubject
  let subjectEvidence = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &subjectNode)
  let mut subjectType = match move subjectEvidence {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let mut referent = Shared.with<Type, Option<Shared<Type>>>(&subjectType,
    fn(value: &Type) -> Option<Shared<Type>> {
      return match &value.* {
        Type.Reference {referent: pointee, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&pointee))
        _ => Option.none<Shared<Type>>()
      }
    },
  )
  while true {
    let value = match move referent {
      Option<Shared<Type>>.Some {value: selected} => move selected
      Option<Shared<Type>>.None => { break }
    }
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
      origin: BodyOrigin {syntax: subject, span: run bodySpan(&resolver.source, cursor, subject)},
      kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(&value),
        form: BodyExpression.Dereference {value: subjectNode}},
    })
    subjectNode = node
    subjectType = move value
    referent = Shared.with<Type, Option<Shared<Type>>>(&subjectType,
      fn(value: &Type) -> Option<Shared<Type>> {
        return match &value.* {
          Type.Reference {referent: pointee, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&pointee))
          _ => Option.none<Shared<Type>>()
        }
      },
    )
  }
  if Shared.with<Type, bool>(&subjectType, fn(value: &Type) -> bool {
    return match &value.* { Type.Parameter {..} => true
      _ => false
    }
  }) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let name = match run bodyNode(&resolver.source, cursor, field) {
    Node.Name {text} => run bodyText(&resolver.source, cursor, text)
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, span) }
  }
  let fieldSpan = run bodySpan(&resolver.source, cursor, field)
  if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&subjectType) {
    if !same(Bytes.asSlice(&name), b"length") { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, fieldSpan) }
    let lengthType = run primitiveType(b"usize")
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if !run Type.equalsShared(&lengthType, &value) { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span) }
    }
    let index = Vector.length<BodyNode>(&nodes.*)
    run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move lengthType, form: BodyExpression.ArrayLength {value: subjectNode, count: array.length}},
    })
    return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
  }
  if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&subjectType) {
    if !same(Bytes.asSlice(&name), b"length") { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, fieldSpan) }
    let lengthType = run primitiveType(b"usize")
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if !run Type.equalsShared(&lengthType, &value) { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span) }
    }
    let index = Vector.length<BodyNode>(&nodes.*)
    run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move lengthType, form: BodyExpression.SliceLength {value: subjectNode}},
    })
    return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
  }
  let selected = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, &subjectType, Bytes.asSlice(&name), fieldSpan)
  let member = match move selected {
    Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => move value
    Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => {
      return run rejectMissingField(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, &subjectType, Bytes.asSlice(&name), fieldSpan, span, move error)
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move member.ty,
      form: BodyExpression.Field {value: subjectNode, index: member.index}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, span)
}

struct CheckedScalarPattern {
  pattern: BodyPattern
  ordinal: usize
}

// A scalar-enum match pattern is the universal pattern or one not yet covered member of the subject.
effect fn checkScalarEnumPattern(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  pattern: HirId,
  patternSpan: Span,
  subjectType: &Shared<Type>,
  covered: &[bool],
) -> Result<CheckedScalarPattern, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  return match run bodyNode(&resolver.source, cursor, pattern) {
    Node.UniversalPattern {name} => {
      if name.present {
        return Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, patternSpan),
        )
      }
      return Result.succeed<CheckedScalarPattern, Shared<Rejection>>(
        CheckedScalarPattern {pattern: BodyPattern.Universal, ordinal: usize.MAX},
      )
    }
    Node.EnumPattern {path} => {
      let written = run bodyPathPair(&resolver.source, cursor, path)
      let pair = match move written {
        Option<QualifiedBodyName>.Some {value} => value
        Option<QualifiedBodyName>.None => {
          return Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, patternSpan),
          )
        }
      }
      let selection = run checkedEnumSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), patternSpan, false)
      let selected = match move selection {
        Option<Result<EnumSelection, Shared<Rejection>>>.Some {value} => value
        Option<Result<EnumSelection, Shared<Rejection>>>.None => {
          return Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.TypeMismatch, patternSpan),
          )
        }
      }
      let chosen = match move selected {
        Result<EnumSelection, Shared<Rejection>>.Success {value} => value
        Result<EnumSelection, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CheckedScalarPattern, Shared<Rejection>>(move error)
        }
      }
      if let EnumSelection.Member {ty: patternType, member} = move chosen {
        if !run Type.equalsShared(&patternType, subjectType) {
          return Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.TypeMismatch, patternSpan),
          )
        }
        if covered[member.ordinal] {
          return Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.DuplicateMatchPattern, patternSpan),
          )
        }
        let ordinal = member.ordinal
        return Result.succeed<CheckedScalarPattern, Shared<Rejection>>(
          CheckedScalarPattern {pattern: BodyPattern.EnumMember {member: member}, ordinal: ordinal},
        )
      }
      return Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.TypeMismatch, patternSpan),
      )
    }
    Node.IntegerPattern {..} => Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.IntegerPatternOnEnum, patternSpan),
    )
    _ => Result.failResult<CheckedScalarPattern, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, patternSpan),
    )
  }
}

// A match guard must be a bool expression.
effect fn checkMatchGuard<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  guard: HirId,
  constraints: &[Constraint],
  contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let tested = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, guard, &Option.none<Shared<Type>>(),
    constraints, contractBody, false, unsafeAllowed)
  let guardNode = match move tested {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let guardType = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &guardNode)
  let boolean = run primitiveType(b"bool")
  // A guard that always exits, such as a match whose arms return, is `never` (any type).
  let isBoolean = match &guardType {
    Option<Shared<Type>>.Some {value} => (run Type.equalsShared(&value, &boolean)) || Shared.with<Type, bool>(&value, neverType)
    Option<Shared<Type>>.None => false
  }
  if !isBoolean {
    return run bodyRejection(&resolver.*, module, RejectionCode.ConditionNotBool,
      run bodySpan(&resolver.source, cursor, guard))
  }
  return Result.succeed<BodyNodeId, Shared<Rejection>>(guardNode)
}

// The success, failure and requirement channels of a runnable operand, or absence for a value
// that is not an Effect (EFF-003).
struct EffectChannels {
  success: Shared<Type>
  failure: Shared<Type>
  requirements: Shared<Row>
}

fn effectChannels(value: &Type) -> Option<EffectChannels> {
  return match &value.* {
    Type.Effect {success, failure, requirements, ..} => Option.some<EffectChannels>(EffectChannels {
      success: Shared.clone<Type>(&success), failure: Shared.clone<Type>(&failure), requirements: Shared.clone<Row>(&requirements),
    })
    Type.CallableValue {contract, ..} => Shared.with<Type, Option<EffectChannels>>(&contract, effectChannels)
    Type.EffectComposite {contract, ..} => Shared.with<Type, Option<EffectChannels>>(&contract, effectChannels)
    Type.EffectJoin {contract, ..} => Shared.with<Type, Option<EffectChannels>>(&contract, effectChannels)
    // A producer's Effect family runs through its contract; its storage is realized at layout.
    Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, Option<EffectChannels>>(&contract, effectChannels)
    _ => Option.none<EffectChannels>()
  }
}

// A representation parameter runs through the Effect use contract its bound names.
effect fn runnableChannels(ty: &Shared<Type>, constraints: &[Constraint]) -> Option<EffectChannels>
! OutOfMemoryError ? &mut Allocator {
  let direct = Shared.with<Type, Option<EffectChannels>>(ty, effectChannels)
  if let Option<EffectChannels>.Some {value} = move direct {
    return Option.some<EffectChannels>(move value)
  }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      if run Type.equalsShared(ty, &parameter) {
        let bound = Shared.with<Type, Option<EffectChannels>>(&contract, effectChannels)
        if let Option<EffectChannels>.Some {value} = move bound {
          return Option.some<EffectChannels>(move value)
        }
      }
    }
    at = at + usize.ONE
  }
  return Option.none<EffectChannels>()
}

// A copy of the channels of the innermost body being checked, without its retained relations; a
// body outside every Effect has none.
effect fn currentBodyChannels(resolver: &Resolver) -> BodyFrame ! OutOfMemoryError ? &mut Allocator {
  let bodies = Vector.asSlice<BodyFrame>(&resolver.bodies)
  if bodies.length == usize.ZERO {
    return BodyFrame {isEffect: false, failure: run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()}),
      requirements: run Shared.make<Row>(Row.empty()), derived: Option.none<DerivedChannels>(),
      obligations: Vector.make<BodySafetyObligation>(), occurrences: Vector.make<SelectedFact>()}
  }
  let current = &bodies[bodies.length - usize.ONE]
  return BodyFrame {isEffect: current.isEffect, failure: Shared.clone<Type>(&current.failure),
    requirements: Shared.clone<Row>(&current.requirements), derived: Option.none<DerivedChannels>(),
    obligations: Vector.make<BodySafetyObligation>(), occurrences: Vector.make<SelectedFact>()}
}

// Whether the innermost body derives its channels from its `return`, `fail` and `run` sites.
fn derivingBody(resolver: &Resolver) -> bool {
  let bodies = Vector.asSlice<BodyFrame>(&resolver.bodies)
  if bodies.length == usize.ZERO { return false }
  return match &bodies[bodies.length - usize.ONE].derived { Option<DerivedChannels>.Some {..} => true _ => false }
}

// Retains one region relation that typing admitted without proof on the innermost body. Without a
// body frame there is no body to retain it, so the relation cannot be admitted.
effect fn retainRegionRelation(resolver: &mut Resolver, origin: BodyOrigin, offered: &Shared<Lifetime>,
  wanted: &Shared<Lifetime>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let popped = Vector.pop<BodyFrame>(&mut resolver.*.bodies)
  let mut current = match move popped {
    Option<BodyFrame>.Some {value} => value
    Option<BodyFrame>.None => { return false }
  }
  run Vector.append<BodySafetyObligation>(&mut current.obligations, BodySafetyObligation.RegionRelation {
    origin: origin, offered: Shared.clone<Lifetime>(offered), wanted: Shared.clone<Lifetime>(wanted),
  })
  run Vector.append<BodyFrame>(&mut resolver.*.bodies, move current)
  return true
}

// Retains every deferred pair of one admission at `origin`.
effect fn retainRegionPairs(resolver: &mut Resolver, origin: BodyOrigin, pairs: &[RegionPair]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < pairs.length {
    if !run retainRegionRelation(&mut resolver.*, origin, &pairs[at].offered, &pairs[at].wanted) { return false }
    at = at + usize.ONE
  }
  return true
}

// How many obligations the innermost body frame retains so far; a call marks this before its
// operands so that `retainedRelationPremises` reads only the relations they retained.
fn retainedRelationCount(resolver: &Resolver) -> usize {
  let bodies = Vector.asSlice<BodyFrame>(&resolver.bodies)
  if bodies.length == usize.ZERO { return usize.ZERO }
  let current = &bodies[bodies.length - usize.ONE]
  return Vector.length<BodySafetyObligation>(&current.obligations)
}

// The relations a call's operands retained from `since` onward are premises of the call's own
// bound proofs: an operand admitted under a relation must not fail the same bound again when the
// call proves its applied bounds. Each relation stays open on the body as an obligation.
effect fn retainedRelationPremises(resolver: &Resolver, since: usize, premises: &mut Vector<Constraint>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let bodies = Vector.asSlice<BodyFrame>(&resolver.bodies)
  if bodies.length == usize.ZERO { return () }
  let current = &bodies[bodies.length - usize.ONE]
  let retained = Vector.asSlice<BodySafetyObligation>(&current.obligations)
  let mut at = since
  while at < retained.length {
    if let BodySafetyObligation.RegionRelation {offered, wanted, ..} = &retained[at] {
      run Vector.append<Constraint>(&mut premises.*, Constraint.Outlives {longer: Shared.clone<Lifetime>(&offered),
        shorter: Shared.clone<Lifetime>(&wanted)})
    }
    at = at + usize.ONE
  }
  return ()
}

// Records one site of a deriving body: a returned type, a `fail` operand's type, or a run's
// failure and requirements.
effect fn deriveChannels(resolver: &mut Resolver, returned: Option<Shared<Type>>, failed: Option<Shared<Type>>,
  ranFailure: Option<Shared<Type>>, ranRequirements: Option<Shared<Row>>) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = Vector.pop<BodyFrame>(&mut resolver.*.bodies)
  let mut current = match move popped {
    Option<BodyFrame>.Some {value} => value
    Option<BodyFrame>.None => { return () }
  }
  if let Option<DerivedChannels>.Some {value: derived} = &mut current.derived {
    if let Option<Shared<Type>>.Some {value} = move returned { run Vector.append<Shared<Type>>(&mut derived.returns, move value) }
    if let Option<Shared<Type>>.Some {value} = move failed {
      run appendMembers(&mut derived.failures, &value)
      run Vector.append<Shared<Type>>(&mut derived.failed, move value)
    }
    if let Option<Shared<Type>>.Some {value} = move ranFailure { run appendMembers(&mut derived.failures, &value) }
    if let Option<Shared<Row>>.Some {value} = move ranRequirements { run Row.merge(&mut derived.requirements, &value) }
  }
  return run Vector.append<BodyFrame>(&mut resolver.*.bodies, move current)
}

// The members of a failure type: a structural union's, none for `never`, otherwise itself.
effect fn failureMembers(value: &Shared<Type>) -> Vector<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  if Shared.with<Type, bool>(value, neverType) { return Vector.make<Shared<Type>>() }
  let listed = run Type.canonicalUnionMembers(value)
  if let Option<Vector<Shared<Type>>>.Some {value: members} = move listed { return move members }
  let mut single = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut single, Shared.clone<Type>(value))
  return move single
}

// The canonical join of member sets: `never` when empty, the member when single, else a union.
effect fn joinedType(members: Vector<Shared<Type>>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let mut joined = Vector.make<Shared<Type>>()
  let listed = Vector.asSlice<Shared<Type>>(&members)
  let mut at = usize.ZERO
  while at < listed.length {
    run Type.joinMember(&mut joined, &listed[at])
    at = at + usize.ONE
  }
  if Vector.length<Shared<Type>>(&joined) == usize.ONE {
    let single = Vector.asSlice<Shared<Type>>(&joined)
    return Shared.clone<Type>(&single[usize.ZERO])
  }
  return run Shared.make<Type>(Type.Union {members: move joined})
}

effect fn appendMembers(output: &mut Vector<Shared<Type>>, value: &Shared<Type>) -> () ! OutOfMemoryError ? &mut Allocator {
  let members = run failureMembers(value)
  let listed = Vector.asSlice<Shared<Type>>(&members)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Shared<Type>>(&mut output.*, Shared.clone<Type>(&listed[at]))
    at = at + usize.ONE
  }
  return ()
}

effect fn channelRejection(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span)
-> Result<EffectChannels, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  return Result.failResult<EffectChannels, Shared<Rejection>>(run reject(resolver, module, code, span))
}

fn unitShape(value: &Type) -> bool {
  return match &value.* { Type.Unit => true _ => false }
}

// The channels of the Effect a callable returns when it is lent `&mut resource`.
effect fn lentChannels(callable: &Shared<Type>, resource: &Shared<Type>, constraints: &[Constraint]) -> Option<EffectChannels>
! OutOfMemoryError ? &mut Allocator {
  let contract = match move run valueCallableContract(callable, constraints) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return Option.none<EffectChannels>() }
  }
  let shape = run Type.copy(&contract)
  if let Type.Callable {parameters, result, ..} = move shape {
    let accepted = Vector.asSlice<Shared<Type>>(&parameters)
    if accepted.length != usize.ONE { return Option.none<EffectChannels>() }
    let lent = run Type.copy(&accepted[usize.ZERO])
    // The loan is quantified per invocation (`for<'scope>`), never a fixed or caller region.
    if let Type.Reference {referent, access, lifetime} = move lent {
      let quantified = Shared.with<Lifetime, bool>(&lifetime, fn(value: &Lifetime) -> bool {
        return match &value.* { Lifetime.Invocation {..} => true _ => false }
      })
      if access == Access.Mutable && quantified && run Type.equalsShared(&referent, resource) { return Shared.with<Type, Option<EffectChannels>>(&result, effectChannels) }
    }
  }
  return Option.none<EffectChannels>()
}

// The channels of a finalizer composition: the protected Effect's success and failure, and both
// requirement rows. The finalizer is `() ! never`; written arguments, when present, name exactly
// `[Resource,] A, E, R, S` (D4).
effect fn finalizedChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operation: Composition, operands: &[Shared<Type>], written: &[Argument], constraints: &[Constraint], span: Span)
-> Result<EffectChannels, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let lends = operation == Composition.UseRelease
  let mut protectedAt = usize.ZERO
  if lends { protectedAt = usize.ONE }
  let finalizerAt = protectedAt + usize.ONE
  let protectedSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, protectedAt))
  let finalizerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, finalizerAt))
  let mut protected = Option.none<EffectChannels>()
  let mut finalizer = Option.none<EffectChannels>()
  let mut code = RejectionCode.RunNonEffect
  if lends {
    protected = run lentChannels(&operands[protectedAt], &operands[usize.ZERO], constraints)
    finalizer = run lentChannels(&operands[finalizerAt], &operands[usize.ZERO], constraints)
    code = RejectionCode.TypeMismatch
  } else {
    protected = run runnableChannels(&operands[protectedAt], constraints)
    finalizer = run runnableChannels(&operands[finalizerAt], constraints)
  }
  let kept = match move protected {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, code, protectedSpan) }
  }
  let cleanup = match move finalizer {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, code, finalizerSpan) }
  }
  if !Shared.with<Type, bool>(&cleanup.success, unitShape) || !Shared.with<Type, bool>(&cleanup.failure, neverType) {
    return run channelRejection(resolver, module, RejectionCode.TypeMismatch, finalizerSpan)
  }
  if written.length != usize.ZERO {
    let mut derived = Vector.make<Argument>()
    if lends { run Vector.append<Argument>(&mut derived, Argument.Type {value: Shared.clone<Type>(&operands[usize.ZERO])}) }
    run Vector.append<Argument>(&mut derived, Argument.Type {value: Shared.clone<Type>(&kept.success)})
    run Vector.append<Argument>(&mut derived, Argument.Type {value: Shared.clone<Type>(&kept.failure)})
    run Vector.append<Argument>(&mut derived, Argument.Row {value: Shared.clone<Row>(&kept.requirements)})
    run Vector.append<Argument>(&mut derived, Argument.Row {value: Shared.clone<Row>(&cleanup.requirements)})
    if !sameArguments(written, Vector.asSlice<Argument>(&derived)) {
      return run channelRejection(resolver, module, RejectionCode.TypeMismatch, span)
    }
  }
  let mut requirements = Row.empty()
  run Row.merge(&mut requirements, &kept.requirements)
  run Row.merge(&mut requirements, &cleanup.requirements)
  return Result.succeed<EffectChannels, Shared<Rejection>>(EffectChannels {success: move kept.success, failure: move kept.failure,
    requirements: run Shared.make<Row>(move requirements)})
}

effect fn compositionChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operation: Composition, operands: &[Shared<Type>], written: &[Argument], selector: &Shared<Type>, constraints: &[Constraint],
  span: Span) -> Result<EffectChannels, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if operation == Composition.CatchFailure {
    return run caughtChannels(resolver, module, cursor, arguments, operands, selector, constraints)
  }
  if operation == Composition.Suspend {
    // Suspension keeps the deferred child's channels exactly (SUSP-005).
    return match move run runnableChannels(&operands[usize.ZERO], constraints) {
      Option<EffectChannels>.Some {value} => Result.succeed<EffectChannels, Shared<Rejection>>(move value)
      Option<EffectChannels>.None => run channelRejection(resolver, module, RejectionCode.RunNonEffect,
        run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)))
    }
  }
  if operation == Composition.Observe {
    return run observedChannels(resolver, module, cursor, arguments, operands, written, constraints, span)
  }
  return run finalizedChannels(resolver, module, cursor, arguments, operation, operands, written, constraints, span)
}

// Whether `value` is the primitive named `name`.
fn primitiveNamed(value: &Type, name: &[u8]) -> bool {
  return match &value.* { Type.Primitive {name: spelled} => same(Bytes.asSlice(&spelled), name) _ => false }
}

fn stringType(value: &Type) -> bool {
  return match &value.* { Type.String {..} => true _ => false }
}

// The observer callback's contract `fn(&mut S, u8, usize, usize, string, string) -> usize`.
effect fn observerCallback(callback: &Shared<Type>, state: &Shared<Type>, constraints: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let contract = match move run valueCallableContract(callback, constraints) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return false }
  }
  let parts = run Type.copy(&contract)
  if let Type.Callable {parameters, result, ..} = move parts {
    let listed = Vector.asSlice<Shared<Type>>(&parameters)
    if listed.length != 6 || !Shared.with<Type, bool>(&result, fn(value: &Type) -> bool { return primitiveNamed(value, b"usize") }) {
      return false
    }
    let receiver = Shared.with<Type, Option<Shared<Type>>>(&listed[usize.ZERO], fn(value: &Type) -> Option<Shared<Type>> {
      return match &value.* {
        Type.Reference {referent, access, ..} => {
          if access != Access.Mutable { return Option.none<Shared<Type>>() }
          return Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
        }
        _ => Option.none<Shared<Type>>()
      }
    })
    let lent = match move receiver { Option<Shared<Type>>.Some {value} => value Option<Shared<Type>>.None => { return false } }
    let same = run Type.equalsShared(&lent, state)
    return same &&
      Shared.with<Type, bool>(&listed[usize.ONE], fn(value: &Type) -> bool { return primitiveNamed(value, b"u8") }) &&
      Shared.with<Type, bool>(&listed[2], fn(value: &Type) -> bool { return primitiveNamed(value, b"usize") }) &&
      Shared.with<Type, bool>(&listed[3], fn(value: &Type) -> bool { return primitiveNamed(value, b"usize") }) &&
      Shared.with<Type, bool>(&listed[4], stringType) && Shared.with<Type, bool>(&listed[5], stringType)
  }
  return false
}

// The channels of `observeDiagnostics<S, A, R, F>(state, callback, body)`: the body's, whose
// failure row is empty, so no failure leaves an observation (failure observer note N1).
effect fn observedChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operands: &[Shared<Type>], written: &[Argument], constraints: &[Constraint], span: Span)
-> Result<EffectChannels, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let callbackSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ONE))
  let bodySpanned = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, 2))
  let observed = match move run runnableChannels(&operands[2], constraints) {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, RejectionCode.RunNonEffect, bodySpanned) }
  }
  if !Shared.with<Type, bool>(&observed.failure, neverType) {
    return run channelRejection(resolver, module, RejectionCode.TypeMismatch, bodySpanned)
  }
  if !run observerCallback(&operands[usize.ONE], &operands[usize.ZERO], constraints) {
    return run channelRejection(resolver, module, RejectionCode.TypeMismatch, callbackSpan)
  }
  if written.length != usize.ZERO {
    let mut derived = Vector.make<Argument>()
    run Vector.append<Argument>(&mut derived, Argument.Type {value: Shared.clone<Type>(&operands[usize.ZERO])})
    run Vector.append<Argument>(&mut derived, Argument.Type {value: Shared.clone<Type>(&observed.success)})
    run Vector.append<Argument>(&mut derived, Argument.Row {value: Shared.clone<Row>(&observed.requirements)})
    run Vector.append<Argument>(&mut derived, Argument.Type {value: Shared.clone<Type>(&operands[usize.ONE])})
    if !sameArguments(written, Vector.asSlice<Argument>(&derived)) {
      return run channelRejection(resolver, module, RejectionCode.TypeMismatch, span)
    }
  }
  return Result.succeed<EffectChannels, Shared<Rejection>>(move observed)
}

// The channels of `catchFailure<S>`: the protected or handler success, the residual and handler
// failures, and both requirement rows.
effect fn caughtChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operands: &[Shared<Type>], selector: &Shared<Type>, constraints: &[Constraint]) -> Result<EffectChannels, Shared<Rejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let protectedSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO))
  let handlerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ONE))
  let protected = match move run runnableChannels(&operands[usize.ZERO], constraints) {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, RejectionCode.RunNonEffect, protectedSpan) }
  }
  // The handler is invoked with one selected failure and returns the Effect that recovers it.
  let handlerContract = match move run valueCallableContract(&operands[usize.ONE], constraints) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return run channelRejection(resolver, module, RejectionCode.InvalidEffectHandler, handlerSpan) }
  }
  let handlerParts = run Type.copy(&handlerContract)
  let mut recovered = Option.none<EffectChannels>()
  let mut accepts = false
  if let Type.Callable {parameters, result, ..} = move handlerParts {
    let accepted = Vector.asSlice<Shared<Type>>(&parameters)
    if accepted.length == usize.ONE { accepts = run Type.equalsShared(&accepted[usize.ZERO], selector) }
    recovered = Shared.with<Type, Option<EffectChannels>>(&result, effectChannels)
  }
  let recovery = match move recovered {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, RejectionCode.InvalidEffectHandler, handlerSpan) }
  }
  // `S` must be a nonempty subset of the protected failure members (FAIL-005).
  let selected = run failureMembers(selector)
  if !accepts || Vector.length<Shared<Type>>(&selected) == usize.ZERO || !run Type.coversFailure(&protected.failure, selector) {
    return run channelRejection(resolver, module, RejectionCode.InvalidEffectHandler, handlerSpan)
  }
  let mut residual = Vector.make<Shared<Type>>()
  let caught = run failureMembers(&protected.failure)
  let listed = Vector.asSlice<Shared<Type>>(&caught)
  let mut at = usize.ZERO
  while at < listed.length {
    if !run Type.coversFailure(selector, &listed[at]) { run Vector.append<Shared<Type>>(&mut residual, Shared.clone<Type>(&listed[at])) }
    at = at + usize.ONE
  }
  run appendMembers(&mut residual, &recovery.failure)
  let mut successes = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut successes, Shared.clone<Type>(&protected.success))
  run Vector.append<Shared<Type>>(&mut successes, Shared.clone<Type>(&recovery.success))
  let mut requirements = Row.empty()
  run Row.merge(&mut requirements, &protected.requirements)
  run Row.merge(&mut requirements, &recovery.requirements)
  return Result.succeed<EffectChannels, Shared<Rejection>>(EffectChannels {success: run joinedType(move successes),
    failure: run joinedType(move residual), requirements: run Shared.make<Row>(move requirements)})
}

// `Intrinsic.catchFailure<S>(protected, handler)` builds the exact Effect that runs `protected`
// and recovers its failures in `S` through `handler`; other failures stay residual (FAIL-005, D4).
// A finalizer composition keeps the protected outcome and runs a `() ! never` finalizer on every
// exit; `useReleaseNonParking(resource, use, release)` lends the owned resource to both callables.
effect fn checkComposition<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>, expression: HirId,
  span: Span, operation: Composition, written: Vector<Argument>, arguments: CallArguments, expected: &Option<Shared<Type>>,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut count = usize.ONE + usize.ONE
  if operation == Composition.UseRelease || operation == Composition.Observe { count = count + usize.ONE }
  if operation == Composition.Suspend { count = usize.ONE }
  if CallArguments.length(arguments) != count { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  let mut parts = Vector.make<BodyNodeId>()
  let mut types = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let argument = run bodyArgument(&resolver.source, cursor, arguments, at)
    let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argument,
      &Option.none<Shared<Type>>(), constraints, contractBody, false, unsafeAllowed)
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    let ty = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    // A stored part is moved into the composite unless it is Copy, like a closure capture.
    let mut part = node
    if checkedPlace(Vector.asSlice<BodyNode>(&nodes.*), node) && !movedBodyValue(Vector.asSlice<BodyNode>(&nodes.*), node) {
      let argumentSpan = run bodySpan(&resolver.source, cursor, argument)
      let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, argumentSpan) {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      if !copied {
        let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
          Vector.asSlice<BodyNode>(&nodes.*), node, false, false, argumentSpan, argumentSpan, constraints) {
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
        part = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: argument, span: argumentSpan},
          kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(&ty), form: BodyExpression.Move {value: node, consumed: move consumed}}})
      }
    }
    run Vector.append<BodyNodeId>(&mut parts, part)
    run Vector.append<Shared<Type>>(&mut types, move ty)
    at = at + usize.ONE
  }
  let operands = Vector.asSlice<Shared<Type>>(&types)
  // A finalizer composition selects no failure: its selector is `never`.
  let mut selector = run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()})
  let listed = Vector.asSlice<Argument>(&written)
  if operation == Composition.CatchFailure {
    if let Argument.Type {value} = &listed[usize.ZERO] { selector = Shared.clone<Type>(&value) }
  }
  let mut composed = Result.failResult<EffectChannels, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  if bindingComposition(operation) {
    if let Argument.Row {value: keys} = &listed[usize.ZERO] { selector = run selectorCarrier(&keys) }
    composed = run bindingChannels(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, arguments, operation,
      &selector, operands, constraints)
  } else {
    composed = run compositionChannels(&resolver.*, module, cursor, arguments, operation, operands, listed, &selector,
      constraints, span)
  }
  let channels = match move composed {
    Result<EffectChannels, Shared<Rejection>>.Success {value} => value
    Result<EffectChannels, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let mut regions = Vector.make<Shared<Lifetime>>()
  at = usize.ZERO
  while at < count {
    if !run captureRetainedRegions(&operands[at], caller, expression.index, constraints, &mut regions) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    at = at + usize.ONE
  }
  let contract = run Shared.make<Type>(Type.Effect {mode: CallableMode.Once,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))),
    success: move channels.success, failure: move channels.failure, requirements: move channels.requirements})
  let ty = run Shared.make<Type>(Type.EffectComposite {operation: operation, selector: move selector, parts: move types,
    contract: move contract})
  let ordered = Vector.asSlice<BodyNodeId>(&parts)
  let mut fields = Vector.make<BodyAggregateField>()
  at = usize.ZERO
  while at < count {
    run Vector.append<BodyAggregateField>(&mut fields, BodyAggregateField {index: at, value: ordered[at]})
    at = at + usize.ONE
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    expression, span, move ty,
    BodyExpression.Aggregate {fields: move fields}, false, expected, contractBody, false)
}

// A checked scalar operation's carrier offers its expected contract's exact parameters and result
// in any invocation mode. Like a stored composition part, it is moved into the call unless it is Copy.
effect fn carrierArgument(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, nodes: &mut Vector<BodyNode>,
  node: BodyNodeId, argument: HirId, expected: &Option<Shared<Type>>, constraints: &[Constraint]) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let argumentSpan = run bodySpan(&resolver.source, cursor, argument)
  let ty = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, argumentSpan) }
  }
  let contract = run valueCallableContract(&ty, constraints)
  let mut accepted = false
  if let Option<Shared<Type>>.Some {value: offered} = &contract {
    if let Option<Shared<Type>>.Some {value: wanted} = &expected.* { accepted = run carrierAccepts(&offered, &wanted) }
  }
  if !accepted { return run bodyRejection(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, argumentSpan) }
  if !checkedPlace(Vector.asSlice<BodyNode>(&nodes.*), node) || movedBodyValue(Vector.asSlice<BodyNode>(&nodes.*), node) {
    return Result.succeed<BodyNodeId, Shared<Rejection>>(node)
  }
  let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, argumentSpan) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  if copied { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
  let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
    Vector.asSlice<BodyNode>(&nodes.*), node, false, false, argumentSpan, argumentSpan, constraints) {
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let moved = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: argument, span: argumentSpan},
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Move {value: node, consumed: move consumed}}})
  return Result.succeed<BodyNodeId, Shared<Rejection>>(moved)
}

// Whether an offered callable contract serves a carrier: a safe invocation with the same
// parameters and result. Any invocation mode can be invoked once by the call that owns it.
effect fn carrierAccepts(offered: &Shared<Type>, wanted: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let left = run Type.copy(offered)
  let right = run Type.copy(wanted)
  if let Type.Callable {parameters, result, isUnsafe, ..} = move left {
    if let Type.Callable {parameters: expected, result: produced, ..} = move right {
      let given = Vector.asSlice<Shared<Type>>(&parameters)
      let required = Vector.asSlice<Shared<Type>>(&expected)
      if isUnsafe || given.length != required.length || !run Type.equalsShared(&result, &produced) { return false }
      let mut at = usize.ZERO
      while at < given.length {
        if !run Type.equalsShared(&given[at], &required[at]) { return false }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

// A binding's selected key travels as the requirement row of a unit Effect, so substitution and
// runtime encoding treat it like any other row (`Type.EffectComposite.selector`).
effect fn selectorCarrier(row: &Shared<Row>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let none = Vector.make<Shared<Lifetime>>()
  return run Shared.make<Type>(Type.Effect {mode: CallableMode.Once,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&none))),
    success: run Shared.make<Type>(Type.Unit), failure: run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()}),
    requirements: Shared.clone<Row>(row)})
}

fn carriedRow(value: &Type) -> Option<Shared<Row>> {
  return match &value.* { Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements)) _ => Option.none<Shared<Row>>() }
}

// The one service-role key a binding's selector carries.
effect fn carriedKey(selector: &Shared<Type>) -> Option<Requirement> ! OutOfMemoryError ? &mut Allocator {
  return match move Shared.with<Type, Option<Shared<Row>>>(selector, carriedRow) {
    Option<Shared<Row>>.Some {value} => run selectorKey(&value)
    Option<Shared<Row>>.None => Option.none<Requirement>()
  }
}

// Whether a binding's provider part has the shape its intrinsic takes: a shared or exclusive
// borrow, or an owned value.
fn bindingProviderShape(operation: Composition, provider: &Type) -> bool {
  return match &provider.* {
    Type.Reference {access, ..} => operation == Composition.BindOwned || (operation == Composition.BindShared) == (access == Access.Shared)
    _ => operation == Composition.BindOwned
  }
}

// `Intrinsic.bindRequirement*<S>(inner, provider)` builds the exact Effect that runs `inner` with
// key `S` served by `provider` for that execution only (SERV-009, D2 rule 2). The provider must
// provide `S` from the inner row, which then loses the selected entry (SERV-008).
effect fn bindingChannels(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operation: Composition, selector: &Shared<Type>, operands: &[Shared<Type>], constraints: &[Constraint])
  -> Result<EffectChannels, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let innerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO))
  let providerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ONE))
  let inner = match move run runnableChannels(&operands[usize.ZERO], constraints) {
    Option<EffectChannels>.Some {value} => value
    Option<EffectChannels>.None => { return run channelRejection(&resolver.*, module, RejectionCode.RunNonEffect, innerSpan) }
  }
  if !Shared.with<Type, bool>(&operands[usize.ONE], fn(value: &Type) -> bool { return bindingProviderShape(operation, value) }) {
    return run channelRejection(&resolver.*, module, RejectionCode.TypeMismatch, providerSpan)
  }
  let keys = match move Shared.with<Type, Option<Shared<Row>>>(selector, carriedRow) {
    Option<Shared<Row>>.Some {value} => value
    Option<Shared<Row>>.None => { return run channelRejection(&resolver.*, module, RejectionCode.Unsupported, providerSpan) }
  }
  let mut bounds = Vector.make<Constraint>()
  run Vector.append<Constraint>(&mut bounds, Constraint.Provides {provider: Shared.clone<Type>(&operands[usize.ONE]),
    selector: Shared.clone<Row>(&keys), source: Shared.clone<Row>(&inner.requirements)})
  let declared = run copyConstraints(constraints)
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    Vector.asSlice<Constraint>(&bounds), module, providerSpan)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result.failResult<EffectChannels, Shared<Rejection>>(move value) }
  let mut residual = Row.empty()
  run Row.subtract(&mut residual, &inner.requirements, &keys)
  return Result.succeed<EffectChannels, Shared<Rejection>>(EffectChannels {success: move inner.success,
    failure: move inner.failure, requirements: run Shared.make<Row>(move residual)})
}

// `run` executes one Effect layer. Its residual failures and requirements must fit the enclosing
// body's channels (EFF-003, EFF-006, FAIL-003).
// The referent or element a storage operand borrows, with its access and region.
struct StorageView {
  target: Shared<Type>
  access: Access
  region: Shared<Lifetime>
}

// The referent of a reference operand, or the element of a slice operand when `slice` is set.
effect fn storageView(value: &Shared<Type>, slice: bool) -> Option<StorageView> ! OutOfMemoryError ? &mut Allocator {
  return match move run Type.copy(value) {
    Type.Reference {referent, access, lifetime} => {
      if slice { return Option.none<StorageView>() }
      return Option.some<StorageView>(StorageView {target: move referent, access: access, region: move lifetime})
    }
    Type.Slice {element, access, lifetime} => {
      if !slice { return Option.none<StorageView>() }
      return Option.some<StorageView>(StorageView {target: move element, access: access, region: move lifetime})
    }
    _ => Option.none<StorageView>()
  }
}

// The region of a `string` operand.
effect fn storageText(value: &Shared<Type>) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  return match move run Type.copy(value) {
    Type.String {lifetime} => Option.some<Shared<Lifetime>>(move lifetime)
    _ => Option.none<Shared<Lifetime>>()
  }
}

// Checks one storage primitive operand. An exact parameter type is the operand's context and is
// then required with the ordinary argument adaptations; a structural parameter has no context.
effect fn storageOperand<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  arguments: CallArguments, at: usize, context: Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argumentId, &context, constraints,
    contractBody, false, unsafeAllowed)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  if let Option<Shared<Type>>.None = &context { return Result.succeed<BodyNodeId, Shared<Rejection>>(node) }
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*, node, &context, span)
}

// The checked type of one operand node.
effect fn storageOperandType(resolver: &Resolver, module: &ModuleId, nodes: &Vector<BodyNode>, node: BodyNodeId, span: Span)
-> Result<Shared<Type>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  return match move bodyExpressionType(Vector.asSlice<BodyNode>(nodes), &node) {
    Option<Shared<Type>>.Some {value} => Result.succeed<Shared<Type>, Shared<Rejection>>(move value)
    Option<Shared<Type>>.None => Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(resolver, module, RejectionCode.TypeMismatch, span))
  }
}

// The standard library's `Layout` record, which `layoutOf`, `sharedLayout` and
// `systemAllocationAcquire` exchange as the bootstrap's intrinsic contracts name it. Its storage must
// be exactly the byte count and then the alignment, both `usize`.
effect fn layoutDescriptor(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, span: Span) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let path = run ModuleId.make(ModuleId.sourceOrigin(module), ModuleId.packageIdentity(module), b"silk/layout.silk")
  let loaded = run source(&mut resolver.*, &path)
  if let Option<&IndexedSource>.None = move sourceOf(&resolver.*, &loaded, &path) {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.MissingModule, span))
  }
  let ordinal = run internModule(&mut resolver.*, &path)
  let none = Vector.make<Binder>()
  let mut elision = LifetimeElision {
    owner: Option.none<DeclarationId>(), nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option.none<Shared<Lifetime>>(), generated: Vector.make<Shared<Lifetime>>(), invocation: false,
    nested: false, renumber: Vector.make<usize>(), staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(), assumptions: Option.none<Vector<Constraint>>(),
  }
  let ty = match move run namedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ordinal, module, b"Layout", true, span,
    Option.none<HirId>(), Vector.asSlice<Binder>(&none), &mut elision) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, span) {
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => value
    Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<Shared<Type>, Shared<Rejection>>(move error) }
  }
  let word = run primitiveType(b"usize")
  let listed = Vector.asSlice<Shared<Type>>(&parts)
  if listed.length != 2 {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let counted = run Type.equalsShared(&listed[usize.ZERO], &word)
  let aligned = run Type.equalsShared(&listed[usize.ONE], &word)
  if !counted || !aligned {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(move ty)
}

// Checks one callable operand of `sharedWithMut`: a safe callable taking exactly `parameter` as
// `&mut T` (or nothing), and producing `result` or, for the conflict policy, `never`. An affine
// callable place must be moved into the call.
effect fn storageCallable(resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, nodes: &Vector<BodyNode>, node: BodyNodeId,
  parameter: Option<Shared<Type>>, result: &Shared<Type>, divergent: bool, constraints: &[Constraint], span: Span)
-> Option<Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mismatch = Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
  let ty = match move bodyExpressionType(Vector.asSlice<BodyNode>(nodes), &node) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return move mismatch }
  }
  let contract = match move run valueCallableContract(&ty, constraints) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => { return move mismatch }
  }
  let facts = match move run CallableContract.ofType(&contract) {
    Option<CallableFacts>.Some {value} => value
    Option<CallableFacts>.None => { return move mismatch }
  }
  if facts.isUnsafe { return move mismatch }
  let listed = Vector.asSlice<Shared<Type>>(&facts.parameters)
  match move parameter {
    Option<Shared<Type>>.Some {value: element} => {
      if listed.length != usize.ONE { return move mismatch }
      let accepted = match move run storageView(&listed[usize.ZERO], false) {
        Option<StorageView>.Some {value: view} => view.access == Access.Mutable && run Type.equalsShared(&view.target, &element)
        Option<StorageView>.None => false
      }
      if !accepted { return move mismatch }
    }
    Option<Shared<Type>>.None => { if listed.length != usize.ZERO { return move mismatch } }
  }
  let exact = run Type.equalsShared(&facts.result, result)
  let diverges = divergent && Shared.with<Type, bool>(&facts.result, neverType)
  if !exact && !diverges { return move mismatch }
  let entries = Vector.asSlice<BodyNode>(nodes)
  if checkedPlace(entries, node) && !movedBodyValue(entries, node) {
    let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span) {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return Option.some<Shared<Rejection>>(move error) }
    }
    if !copied { return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, RejectionCode.ExplicitMoveRequired, span)) }
  }
  return Option.none<Shared<Rejection>>()
}

// Checks one sealed storage primitive against its contract, instantiated from its type arguments.
// Raw-buffer and slot contents stay owned by library code; only the operands' own types are checked.
effect fn checkStorageCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, span: Span, operation: StorageOperation, typeArguments: Vector<Shared<Type>>, arguments: CallArguments,
  expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let unsafeOperation = StorageOperation.isUnsafe(operation)
  if callAcknowledged && !unsafeOperation { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
  if unsafeOperation && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if CallArguments.length(arguments) != StorageOperation.arity(operation) {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  let mut instantiation = move typeArguments
  let word = run primitiveType(b"usize")
  let mut checked = Vector.make<BodyNodeId>()
  let mut ty = run Shared.make<Type>(Type.Unit)
  // The one element type every element-generic primitive is instantiated with.
  let mut element = run Shared.make<Type>(Type.Unit)
  if Vector.length<Shared<Type>>(&instantiation) > usize.ZERO {
    let written = Vector.asSlice<Shared<Type>>(&instantiation)
    element = Shared.clone<Type>(&written[usize.ZERO])
  }
  if operation == StorageOperation.Replace {
    let place = match move run storageOperand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, arguments, usize.ZERO,
      Option.none<Shared<Type>>(), constraints, contractBody, unsafeAllowed, span) {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    // The displaced place is written like an assignment target.
    if !mutablePlace(Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyLocal>(&statementScope.locals.*), place) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    let placeType = match move run storageOperandType(&resolver.*, module, &nodes.*, place, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    if Vector.length<Shared<Type>>(&instantiation) == usize.ONE && !run Type.equalsShared(&element, &placeType) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    let value = match move run storageOperand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, arguments, usize.ONE,
      Option.some<Shared<Type>>(Shared.clone<Type>(&placeType)), constraints, contractBody, unsafeAllowed, span) {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
    }
    run Vector.append<BodyNodeId>(&mut checked, place)
    run Vector.append<BodyNodeId>(&mut checked, value)
    instantiation = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut instantiation, Shared.clone<Type>(&placeType))
    ty = move placeType
  } else {
    // Exact operand contexts in parameter order; absence marks a structural parameter checked below.
    let mut contexts = Vector.make<Option<Shared<Type>>>()
    let allocation = run SealedCore.allocation()
    match operation {
      StorageOperation.RawBufferFrom => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&allocation)))
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
      }
      StorageOperation.RawBufferSlot => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
      }
      StorageOperation.RawBufferRead => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
      }
      StorageOperation.RawBufferCopy => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
      }
      StorageOperation.RawBufferFill => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(run primitiveType(b"u8")))
      }
      StorageOperation.RawBufferView => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
      }
      StorageOperation.RawBufferViewMut => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&word)))
      }
      StorageOperation.SlotWrite => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&element)))
      }
      StorageOperation.SharedFromAllocation => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&allocation)))
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&element)))
      }
      // The package takes the allocation, then the body, readiness state and endpoint as written.
      StorageOperation.ExecutionFromAllocation => {
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&allocation)))
        let written = Vector.asSlice<Shared<Type>>(&instantiation)
        let mut at = usize.ONE
        while at < written.length {
          run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(Shared.clone<Type>(&written[at])))
          at = at + usize.ONE
        }
      }
      StorageOperation.SystemAllocationAcquire => {
        let layout = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
        run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.some<Shared<Type>>(move layout))
      }
      _ => {
        let mut at = usize.ZERO
        while at < StorageOperation.arity(operation) {
          run Vector.append<Option<Shared<Type>>>(&mut contexts, Option.none<Shared<Type>>())
          at = at + usize.ONE
        }
      }
    }
    let mut at = usize.ZERO
    while at < StorageOperation.arity(operation) {
      let listedContexts = Vector.asSlice<Option<Shared<Type>>>(&contexts)
      let context = match &listedContexts[at] {
        Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      let node = match move run storageOperand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, arguments, at, move context,
        constraints, contractBody, unsafeAllowed, span) {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      run Vector.append<BodyNodeId>(&mut checked, node)
      at = at + usize.ONE
    }
    let operands = Vector.asSlice<BodyNodeId>(&checked)
    // The first operand's type, which every structural parameter reads.
    let mut subject = run Shared.make<Type>(Type.Unit)
    if operands.length > usize.ZERO {
      subject = match move run storageOperandType(&resolver.*, module, &nodes.*, operands[usize.ZERO], span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
    }
    let buffer = run SealedCore.applied(SealedKind.RawBuffer, &element)
    let shared = run SealedCore.applied(SealedKind.SharedCore, &element)
    let mismatch = run reject(&resolver.*, module, RejectionCode.TypeMismatch, span)
    match operation {
      StorageOperation.RawBufferFrom => { ty = move buffer }
      StorageOperation.RawBufferSlot => {
        let view = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value} => value
          Option<StorageView>.None => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        }
        if view.access != Access.Mutable || !run Type.equalsShared(&view.target, &buffer) {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch)
        }
        ty = run SealedCore.slot(&view.region, &element)
      }
      StorageOperation.RawBufferCount => {
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &buffer)
          Option<StorageView>.None => false
        }
        if !accepted { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        ty = Shared.clone<Type>(&word)
      }
      StorageOperation.RawBufferRead => {
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &buffer)
          Option<StorageView>.None => false
        }
        if !accepted { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        ty = Shared.clone<Type>(&element)
      }
      StorageOperation.RawBufferCopy => {
        let destination = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => view.access == Access.Mutable && run Type.equalsShared(&view.target, &buffer)
          Option<StorageView>.None => false
        }
        let sourceType = match move run storageOperandType(&resolver.*, module, &nodes.*, operands[2], span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
        let source = match move run storageView(&sourceType, true) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &element)
          Option<StorageView>.None => false
        }
        if !destination || !source { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
      }
      StorageOperation.RawBufferFill => {
        let octet = run primitiveType(b"u8")
        let bytes = run SealedCore.applied(SealedKind.RawBuffer, &octet)
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => view.access == Access.Mutable && run Type.equalsShared(&view.target, &bytes)
          Option<StorageView>.None => false
        }
        if !accepted { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
      }
      StorageOperation.RawBufferView => {
        let view = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value} => value
          Option<StorageView>.None => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        }
        if !run Type.equalsShared(&view.target, &buffer) { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        ty = run Shared.make<Type>(Type.Slice {element: Shared.clone<Type>(&element), access: Access.Shared, lifetime: move view.region})
      }
      StorageOperation.RawBufferViewMut => {
        let view = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value} => value
          Option<StorageView>.None => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        }
        if view.access != Access.Mutable || !run Type.equalsShared(&view.target, &buffer) {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch)
        }
        ty = run Shared.make<Type>(Type.Slice {element: Shared.clone<Type>(&element), access: Access.Mutable, lifetime: move view.region})
      }
      StorageOperation.SharedLayout => {
        ty = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      StorageOperation.LayoutOf => {
        ty = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      StorageOperation.SharedFromAllocation => { ty = move shared }
      StorageOperation.ExecutionLayout => {
        ty = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      StorageOperation.ExecutionFromAllocation => { ty = run SealedCore.applied(SealedKind.Execution, &element) }
      StorageOperation.ExecutionNotifyInitial => {
        let execution = run SealedCore.applied(SealedKind.Execution, &element)
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => view.access == Access.Mutable && run Type.equalsShared(&view.target, &execution)
          Option<StorageView>.None => false
        }
        if !accepted { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
      }
      StorageOperation.SharedClone => {
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &shared)
          Option<StorageView>.None => false
        }
        if !accepted { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        ty = move shared
      }
      StorageOperation.SharedWithMut => {
        let arguments = Vector.asSlice<Shared<Type>>(&instantiation)
        let result = Shared.clone<Type>(&arguments[usize.ONE])
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &shared)
          Option<StorageView>.None => false
        }
        if !accepted { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        let selected = run storageCallable(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &nodes.*, operands[usize.ONE],
          Option.some<Shared<Type>>(Shared.clone<Type>(&element)), &result, false, constraints, span)
        if let Option<Shared<Rejection>>.Some {value} = move selected { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
        let conflict = run storageCallable(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &nodes.*, operands[2],
          Option.none<Shared<Type>>(), &result, true, constraints, span)
        if let Option<Shared<Rejection>>.Some {value} = move conflict { return Result.failResult<BodyNodeId, Shared<Rejection>>(move value) }
        ty = move result
      }
      StorageOperation.SystemAllocationAcquire => {
        ty = run Shared.make<Type>(Type.Effect {mode: CallableMode.Once,
          environment: run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()}),
          success: Shared.clone<Type>(&allocation), failure: run SealedCore.make(SealedKind.StorageFailure, Vector.make<Argument>()),
          requirements: run Shared.make<Row>(Row.empty())})
      }
      StorageOperation.StringUtf8Bytes => {
        let region = match move run storageText(&subject) {
          Option<Shared<Lifetime>>.Some {value} => value
          Option<Shared<Lifetime>>.None => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        }
        ty = run Shared.make<Type>(Type.Slice {element: run primitiveType(b"u8"), access: Access.Shared, lifetime: move region})
      }
      StorageOperation.StringFromUtf8Unchecked => {
        let view = match move run storageView(&subject, true) {
          Option<StorageView>.Some {value} => value
          Option<StorageView>.None => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        }
        let octet = run primitiveType(b"u8")
        if !run Type.equalsShared(&view.target, &octet) { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        ty = run Shared.make<Type>(Type.String {lifetime: move view.region})
      }
      StorageOperation.StringByteLength => {
        let region = run storageText(&subject)
        if let Option<Shared<Lifetime>>.None = move region { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        ty = Shared.clone<Type>(&word)
      }
      _ => {
        // The slot primitives consume one selection of exactly the instantiated element.
        let mut selection = false
        if SealedCore.isCore(&subject, SealedKind.Slot) {
          if let Option<Shared<Type>>.Some {value: stored} = move SealedCore.element(&subject) {
            selection = run Type.equalsShared(&stored, &element)
          }
        }
        if !selection { return Result.failResult<BodyNodeId, Shared<Rejection>>(move mismatch) }
        if operation == StorageOperation.SlotTake || operation == StorageOperation.SlotCopy { ty = Shared.clone<Type>(&element) }
        if operation == StorageOperation.SlotAddress { ty = run SealedCore.address(&element) }
      }
    }
    // A read that leaves its storage initialized copies the element.
    if operation == StorageOperation.RawBufferRead || operation == StorageOperation.SlotCopy {
      let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, constraints, span) {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      if !copied { return run bodyRejection(&resolver.*, module, RejectionCode.MissingConformance, span) }
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(&mut nodes.*, BodyNode {
    origin: BodyOrigin {syntax: expression, span: span},
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.StorageCall {operation: operation,
      typeArguments: move instantiation, arguments: move checked}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*, BodyNodeId {index: index}, expected, span)
}

effect fn checkRun<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>, expression: HirId,
  operand: HirId, span: Span, expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    operand, &Option.none<Shared<Type>>(), constraints, contractBody, false, unsafeAllowed)
  let mut value = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
  }
  let operandSpan = run bodySpan(&resolver.source, cursor, operand)
  let operandType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &value) {
    Option<Shared<Type>>.Some {value: selected} => selected
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.RunNonEffect, operandSpan) }
  }
  let channels = match move run runnableChannels(&operandType, constraints) {
    Option<EffectChannels>.Some {value: selected} => selected
    Option<EffectChannels>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.RunNonEffect, operandSpan) }
  }
  // A stored Effect is run with the access its contract grants: a once Effect is consumed and an
  // exclusive one needs a mutable place, as a callable invocation is (CALLABLE-002).
  // The operand is the call to run only when it calls an `effect fn` (its result is that call's
  // own construction) or invokes an `effect fn` value; any other call produced a stored Effect.
  let immediate = immediateOperand(Vector.asSlice<BodyNode>(&nodes.*), value)
  if !immediate {
    let mut mode = CallableMode.Once
    let runContract = run valueCallableContract(&operandType, constraints)
    if let Option<Shared<Type>>.Some {value: contract} = move runContract {
      mode = Shared.with<Type, CallableMode>(&contract, callableInvocationMode)
    }
    if mode == CallableMode.Mutable && checkedPlace(Vector.asSlice<BodyNode>(&nodes.*), value) &&
      !mutablePlace(Vector.asSlice<BodyNode>(&nodes.*), Vector.asSlice<BodyLocal>(&statementScope.locals.*), value) {
      return run bodyRejection(&resolver.*, module, RejectionCode.InvalidCallableInvocationAccess, operandSpan)
    }
    if mode == CallableMode.Once && !movedBodyValue(Vector.asSlice<BodyNode>(&nodes.*), value) {
      let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
        Vector.asSlice<BodyNode>(&nodes.*), value, false, false, operandSpan, operandSpan, constraints) {
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      let moved = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
      run Vector.append<BodyNode>(&mut nodes.*, BodyNode {origin: BodyOrigin {syntax: operand, span: operandSpan},
        kind: BodyNodeKind.Expression {ty: Shared.clone<Type>(&operandType), form: BodyExpression.Move {value: value, consumed: move consumed}}})
      value = moved
    }
  }
  if derivingBody(&resolver.*) {
    run deriveChannels(&mut resolver.*, Option.none<Shared<Type>>(), Option.none<Shared<Type>>(),
      Option.some<Shared<Type>>(Shared.clone<Type>(&channels.failure)), Option.some<Shared<Row>>(Shared.clone<Row>(&channels.requirements)))
  } else {
    let enclosing = run currentBodyChannels(&resolver.*)
    if !run Type.coversFailure(&enclosing.failure, &channels.failure) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnhandledFailure, span)
    }
    let coverage = run Row.covers(&enclosing.requirements, &channels.requirements)
    if coverage != RowCoverage.Covered {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnhandledRequirement, span)
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    expression, span, move channels.success,
    BodyExpression.Run {value: value, immediate: immediate}, false, expected, contractBody, false)
}

fn immediateOperand(nodes: &[BodyNode], value: BodyNodeId) -> bool {
  if let BodyNodeKind.Expression {form, ty} = &nodes[value.index].kind {
    if let BodyExpression.DirectCall {declaration, ..} = &form {
      return Shared.with<Type, bool>(&ty, fn(result: &Type) -> bool { return constructs(result, &declaration) })
    }
    if let BodyExpression.CallableCall {constructs: invoked, ..} = &form { return invoked }
    // The primitive allocation boundary is an Effect its run executes in place.
    if let BodyExpression.StorageCall {operation, ..} = &form { return operation == StorageOperation.SystemAllocationAcquire }
    // An `effect fn` interface operation runs as one call of its selected witness.
    if let BodyExpression.InterfaceCall {isEffect, ..} = &form { return isEffect }
  }
  return false
}

// Whether a `run` executes the call at `call` in place, as its immediate operand.
fn ranInPlace(nodes: &[BodyNode], call: usize) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Run {value, immediate}, ..} = &nodes[at].kind {
      if immediate && value.index == call { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// The first `effect fn` interface call no `run` executes in place. Its Effect has no exact
// representation until the witness construction exists, so it cannot be stored or returned.
fn strandedInterfaceEffect(nodes: &[BodyNode]) -> Option<Span> {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {isEffect, ..}, ..} = &nodes[at].kind {
      if isEffect && !ranInPlace(nodes, at) { return Option.some<Span>(nodes[at].origin.span) }
    }
    at = at + usize.ONE
  }
  return Option.none<Span>()
}

// Whether `result` is the exact Effect constructed by calling `declaration` itself.
fn constructs(result: &Type, declaration: &DeclarationId) -> bool {
  if let Type.CallableValue {application, contract, ..} = &result.* {
    if !Shared.with<Type, bool>(&contract, bareEffect) { return false }
    return Shared.with<Application, bool>(&application, fn(selected: &Application) -> bool {
      return DeclarationId.equals(Application.bodyDeclaration(selected), declaration)
    })
  }
  return false
}

fn effectProducing(value: &Type) -> bool {
  return match &value.* { Type.Callable {result, ..} => Shared.with<Type, bool>(&result, bareEffect) _ => false }
}

fn bareEffect(value: &Type) -> bool {
  return match &value.* { Type.Effect {..} => true _ => false }
}

// A named function or foreign static used as a value, or none when `expression` names neither.
// `promised` is the callable contract the use site already knows: a function value takes the type
// binders its target leaves open from it, and the consumer still proves the whole contract.
effect fn checkNamedValue<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, expected: &Option<Shared<Type>>, promised: &Option<NamedCallableEvidence>, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Option<Result<BodyNodeId, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let namedValue = match run bodyNode(&resolver.source, cursor, expression) {
    Node.IdentifierExpression {binding, ..} => !binding.present
    Node.FieldExpression {..} => true
    Node.MemberExpression {fields, ..} => !fields.present
    _ => false
  }
  if !namedValue { return Option.none<Result<BodyNodeId, Shared<Rejection>>>() }
  let span = run bodySpan(&resolver.source, cursor, expression)
  let selected = run resolvedCall(calls, expression)
  match move selected {
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {
      value: Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Function {target}},
    } => {
      if staticBody {
        return Option.some<Result<BodyNodeId, Shared<Rejection>>>(run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
      }
      if target.foreign {
        return Option.some<Result<BodyNodeId, Shared<Rejection>>>(run bodyRejection(&resolver.*, module, RejectionCode.ForeignFunctionNotFirstClass, span))
      }
      return Option.some<Result<BodyNodeId, Shared<Rejection>>>(run checkInvocation(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
        &mut requiredBodies.*, expression, CallInput {callee: expression, generics: HirRef.absent(),
          arguments: CallArguments.Written {range: Range.empty()}, pipeline: false},
        expected, constraints, contractBody, false, unsafeAllowed, false, true, promised))
    }
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {
      value: Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.ForeignStatic {declaration, ty}},
    } => {
      if staticBody {
        return Option.some<Result<BodyNodeId, Shared<Rejection>>>(run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
      }
      // Reading foreign storage observes memory outside Silk's ownership, so it needs `unsafe`.
      if !unsafeAllowed {
        return Option.some<Result<BodyNodeId, Shared<Rejection>>>(run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span))
      }
      return Option.some<Result<BodyNodeId, Shared<Rejection>>>(run foreignStaticExpression(&mut resolver.*, &mut owner.*,
        &mut dependencies.*, module, caller, constraints, &mut nodes.*, expression, span, move declaration, move ty, expected))
    }
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value: Result<ResolvedTarget, Shared<Rejection>>.Failure {error}} => {
      let rejectedValue = Shared.with<Rejection, bool>(&error, fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.ForeignFunctionNotFirstClass || value.code == RejectionCode.ForeignStaticUnavailable
          || value.code == RejectionCode.PrivateMember
      })
      if rejectedValue {
        return Option.some<Result<BodyNodeId, Shared<Rejection>>>(Result.failResult<BodyNodeId, Shared<Rejection>>(move error))
      }
    }
    _ => ()
  }
  return Option.none<Result<BodyNodeId, Shared<Rejection>>>()
}

effect fn checkExpression<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Word, Answer, NoRejection>, request: &mut Request,
  dependencies: &mut Vector<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>, requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId, expected: &Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return run checkExpressionUnder(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
    caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, expected, constraints, contractBody, staticBody, unsafeAllowed, false)
}

// Exact value admission is the default. Only an opaque return literal and its matching nested
// literals receive construction authority; ordinary assignments and arguments never inherit it.
effect fn checkExpressionUnder<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  authoredExpression: HirId,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  opaqueConstruction: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  // Prefix acknowledgement selects one invocation. Child checks retain only block permission.
  let mut expression = authoredExpression
  let mut callAcknowledged = false
  if let Node.UnsafeExpression {operand} = run bodyNode(
    &resolver.source,
    cursor,
    authoredExpression,
  ) {
    if let Option<CallInput>.Some {..} = move CallInput.ofNode(run bodyNode(&resolver.source, cursor, operand)) {
      expression = operand
      callAcknowledged = true
    } else {
      return run bodyRejection(
        &resolver.*,
        module,
        RejectionCode.UnsafeInvocation,
        run bodySpan(&resolver.source, cursor, authoredExpression),
      )
    }
  }
  let span = run bodySpan(&resolver.source, cursor, expression)
  let pendingFact = selectedFact(calls, expression)
  if let Option<SelectionFact>.Some {value: SelectionFact.Embedded {value: embedded, ty: embeddedType}} = move pendingFact {
    return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
      expression, span, move embedded, move embeddedType, expected)
  }
  let authored = run bodyNode(&resolver.source, cursor, expression)
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(authored) {
    return run checkInvocation(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      expression, input, expected, constraints, contractBody, staticBody, unsafeAllowed, callAcknowledged, false,
      &Option.none<NamedCallableEvidence>())
  }
  let namedValue = run checkNamedValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, expected, &Option.none<NamedCallableEvidence>(), constraints, contractBody, staticBody, unsafeAllowed)
  if let Option<Result<BodyNodeId, Shared<Rejection>>>.Some {value: checkedValue} = move namedValue {
    return move checkedValue
  }
  if let Node.CallableExpression {..} = authored {
    if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
    return run checkAnonymous(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut statementScope.*, &mut nodes.*, expression, expected, constraints)
  }
  let mut ty = run Shared.make<Type>(Type.Unit)
  let mut form = BodyExpression.Unit
  let mut diverges = false
  match authored {
    Node.RunExpression {operand} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      return run checkRun(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
        &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, operand, span,
        expected, constraints, contractBody, unsafeAllowed)
    }
    Node.EffectExpression {body} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      return run checkEffectBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
        &mut statementScope.*, &mut nodes.*, expression, body, expected, constraints)
    }
    Node.IntegerLiteral {sign, magnitude, suffix, ..} => {
      let digits = run bodyText(&resolver.source, cursor, magnitude)
      let mut written = run Bytes.copy(b"i32")
      let mut contextual = false
      if suffix.present {
        written = run bodyText(&resolver.source, cursor, suffix.symbol)
      } else if let Option<Shared<Type>>.Some {value} = &expected.* {
        if Shared.with<Type, bool>(
          &value,
          fn(ty: &Type) -> bool {
            return fixedIntegerType(ty) || pointerSizedIntegerType(ty)
          },
        ) {
          contextual = true
        }
      }
      let selected = Bytes.asSlice(&written)
      if contextual {
        if let Option<Shared<Type>>.Some {value} = &expected.* {
          let fits = Shared.with<Type, bool>(
            &value,
            fn(resolved: &Type) -> bool {
              return match & resolved.* {
                Type.Primitive {name} => fitsInteger(
                  &resolver.target,
                  Bytes.asSlice(&name),
                  sign,
                  Bytes.asSlice(&digits),
                )
                _ => false
              }
            },
          )
          if !fits {
            return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span)
          }
          ty = Shared.clone<Type>(&value)
        }
      } else {
        if !fixedIntegerName(selected) && !pointerSizedIntegerName(selected) {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        if !fitsInteger(&resolver.target, selected, sign, Bytes.asSlice(&digits)) {
          return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span)
        }
        ty = run primitiveType(selected)
      }
      form = BodyExpression.Integer {literal: expression}
    }
    Node.CharacterLiteral {scalar} => {
      if let Option<Shared<Type>>.Some {value} = &expected.* {
        let integer = Shared.with<Type, Option<StaticIntegerType>>(&value, fn(ty: &Type) -> Option<StaticIntegerType> {
          if let Type.Primitive {name} = &ty.* { return StaticExecution.integerType(Bytes.asSlice(&name)) }
          return Option.none<StaticIntegerType>()
        })
        if let Option<StaticIntegerType>.Some {value: selected} = move integer {
          let digits = run characterDigits(scalar)
          let fits = Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
            if let Type.Primitive {name} = &ty.* { return fitsInteger(&resolver.target, Bytes.asSlice(&name), Sign.Positive, Bytes.asSlice(&digits)) }
            return false
          })
          if !fits { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span) }
          let actual = match move StaticValue.integer(selected, StaticSign.Positive, u32.toU64(scalar), resolver.target.pointerBits()) {
            Option<StaticData>.Some {value: actual} => actual
            Option<StaticData>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span) }
          }
          return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
            expression, span,
            run Shared.make<StaticData>(move actual), Shared.clone<Type>(&value), expected)
        }
      }
      let actual = match move StaticValue.character(scalar) {
        Option<StaticData>.Some {value} => value
        Option<StaticData>.None => { fail RevisionMismatch {} }
      }
      return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
        expression, span,
        run Shared.make<StaticData>(move actual), run primitiveType(b"char"), expected)
    }
    // DURATION-001: a duration literal is its exact `u64` nanosecond total, independent of context.
    Node.DurationLiteral {components} => {
      let mut total: u64 = 0
      let mut at = usize.ZERO
      while at < components.length {
        let component = run bodyChild(&resolver.source, cursor, components, at)
        let sum = match run bodyNode(&resolver.source, cursor, component) {
          Node.DurationComponent {magnitude, unit} => DurationUnit.accumulate(unit, total, magnitude)
          _ => { fail RevisionMismatch {} }
        }
        total = match move sum {
          Option<u64>.Some {value} => value
          Option<u64>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.DurationOutOfRange, span) }
        }
        at = at + usize.ONE
      }
      let actual = match move StaticValue.integer(StaticIntegerType.U64, StaticSign.Positive, total, resolver.target.pointerBits()) {
        Option<StaticData>.Some {value} => value
        Option<StaticData>.None => { fail RevisionMismatch {} }
      }
      return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
        expression, span,
        run Shared.make<StaticData>(move actual), run primitiveType(b"u64"), expected)
    }
    Node.FloatingLiteral {suffix, ..} => {
      let mut contextual = false
      if let Option<Shared<Type>>.Some {value} = &expected.* {
        contextual = Shared.with<Type, bool>(
          &value,
          fn(checked: &Type) -> bool {
            if let Type.Primitive {name} = &checked.* {
              let written = Bytes.asSlice(&name)
              return same(written, b"f32") || same(written, b"f64")
            }
            return false
          },
        )
      }
      if suffix.present { contextual = false }
      if contextual {
        if let Option<Shared<Type>>.Some {value} = &expected.* {
          ty = Shared.clone<Type>(&value)
        }
      } else {
        let mut spelling = run Bytes.copy(b"f64")
        if suffix.present { spelling = run bodyText(&resolver.source, cursor, suffix.symbol) }
        if !same(Bytes.asSlice(&spelling), b"f32") && !same(Bytes.asSlice(&spelling), b"f64") { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
        ty = run primitiveType(Bytes.asSlice(&spelling))
      }
      form = BodyExpression.Float {literal: expression}
    }
    Node.TextLiteral {..} => {
      ty = run intrinsicValueType(IntrinsicValueKind.StaticText)
      form = BodyExpression.Text {literal: expression}
    }
    // A byte-string literal is a shared `&'static [u8]` view of its exact bytes (TEXT-001).
    Node.BytesLiteral {..} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      ty = run Shared.make<Type>(Type.Slice {
        element: run primitiveType(b"u8"), access: Access.Shared, lifetime: run Shared.make<Lifetime>(Lifetime.Static),
      })
      form = BodyExpression.Text {literal: expression}
    }
    Node.BooleanLiteral {value} => {
      ty = run primitiveType(b"bool")
      form = BodyExpression.Boolean {value: value}
    }
    Node.UnitLiteral => {
      form = BodyExpression.Unit
    }
    Node.CompileErrorExpression {message} => {
      if !staticBody {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let textType = Option.some<Shared<Type>>(
        run intrinsicValueType(IntrinsicValueKind.StaticText),
      )
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        message,
        &textType,
        constraints,
        contractBody,
        staticBody,
        unsafeAllowed,
      )
      let messageNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      ty = run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()})
      form = BodyExpression.CompileError {message: messageNode}
      diverges = true
    }
    Node.IdentifierExpression {name, binding} => {
      let found = run checkedIdentifier(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
        Vector.asSlice<BodyLocal>(&statementScope.locals.*), calls, Vector.asSlice<BodyNode>(&nodes.*),
        expression, name, binding.present, binding.id, span, staticBody)
      let identifier = match move found {
        Result<CheckedIdentifier, Shared<Rejection>>.Success {value} => value
        Result<CheckedIdentifier, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let CheckedIdentifier {ty: identifierType, form: identifierForm} = move identifier
      ty = move identifierType
      form = move identifierForm
    }
    Node.ArrayExpression {elements} => {
      let mut elementType = Option.none<Shared<Type>>()
      let mut inferElement = true
      if let Option<ArrayShape>.Some {value: array} = move contextualArrayShape(expected) {
        if array.length != elements.length { return run bodyRejection(&resolver.*, module, RejectionCode.ArrayLengthMismatch, span) }
        elementType = Option.some<Shared<Type>>(move array.element)
        inferElement = false
      }
      if elements.length == usize.ZERO && inferElement {
        return run bodyRejection(&resolver.*, module, RejectionCode.UninferredArrayElement, span)
      }
      let mut operands = Vector.make<BodyAggregateField>()
      let mut at = usize.ZERO
      while at < elements.length {
        let child = run bodyChild(&resolver.source, cursor, elements, at)
        let checked = run checkArrayElement(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
          child, &elementType, constraints, contractBody, staticBody, unsafeAllowed)
        let node = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        if inferElement {
          elementType = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node)
          inferElement = false
        }
        run Vector.append<BodyAggregateField>(&mut operands, BodyAggregateField {index: at, value: node})
        at = at + usize.ONE
      }
      let selected = match move elementType {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.UninferredArrayElement, span) }
      }
      ty = run Shared.make<Type>(Type.Array {element: move selected, extent: run Type.extentText(elements.length)})
      form = BodyExpression.Aggregate {fields: move operands}
    }
    Node.TupleExpression {elements} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      let mut selected = match move namedAggregateExpectation(expected, OwnerKind.Tuple) {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => {
          return run checkAnonymousAggregate(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
            module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
            expression, elements, true, expected, constraints, contractBody, unsafeAllowed, span)
        }
      }
      let mut inference = Option.none<InferredAggregateTarget>()
      if opaqueConstruction {
        inference = match move run inferredContextualAggregate(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, &selected, span) {
          Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value} => move value
          Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
        }
      }
      if let Option<InferredAggregateTarget>.Some {value} = &inference { selected = Shared.clone<Type>(&value.ty) }
      let queried = run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &selected, span)
      let fields = match move queried {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      let mut admitted = Option.none<Shared<Type>>()
      if let Option<InferredAggregateTarget>.None = &inference {
        if let Option<Shared<Type>>.Some {value} = &expected.* { admitted = Option.some<Shared<Type>>(Shared.clone<Type>(&value)) }
      }
      return run checkPositionalAggregate(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, CallArguments.Written {range: elements}, &selected, Vector.asSlice<Shared<Type>>(&fields), &inference, &admitted,
        constraints, contractBody, staticBody, unsafeAllowed)
    }
    Node.OrdinalExpression {subject, ordinal} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      let checked = run checkedProjectionSubject(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        subject, constraints, contractBody, unsafeAllowed)
      let subjectNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      let evidence = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &subjectNode)
      let subjectType = match move evidence {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      }
      let fields = run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &subjectType, span)
      let elements = match move fields {
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Success {value} => value
        Result<Vector<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      let mut index = usize.MAX
      if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, ordinal) {
        let digits = run bodyText(&resolver.source, cursor, magnitude)
        if sign == Sign.Positive {
          if let Option<usize>.Some {value} = move Type.extentValue(Bytes.asSlice(&digits)) { index = value }
        }
      }
      let positions = Vector.asSlice<Shared<Type>>(&elements)
      if index >= positions.length { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, run bodySpan(&resolver.source, cursor, ordinal)) }
      ty = Shared.clone<Type>(&positions[index])
      form = BodyExpression.Field {value: subjectNode, index: index}
    }
    Node.IndexExpression {subject, index} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      let checked = run checkedProjectionSubject(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        subject, constraints, contractBody, unsafeAllowed)
      let subjectNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result.failResult<BodyNodeId, Shared<Rejection>>(move error) }
      }
      let subjectType = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &subjectNode) {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.NotIndexable, span) }
      }
      let mut knownLength = Option.none<usize>()
      let mut selectedElement = Option.none<Shared<Type>>()
      if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&subjectType) {
        knownLength = Option.some<usize>(array.length)
        selectedElement = Option.some<Shared<Type>>(move array.element)
      } else {
        selectedElement = Type.sliceElement(&subjectType)
      }
      let element = match move selectedElement {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.NotIndexable, run bodySpan(&resolver.source, cursor, subject)) }
      }
      let indexType = Option.some<Shared<Type>>(run primitiveType(b"usize"))
      let checkedIndex = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        index, &indexType, constraints, contractBody, false, unsafeAllowed)
      let indexNode = match move checkedIndex {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          let indexSpan = run bodySpan(&resolver.source, cursor, index)
          let mismatch = Shared.with<Rejection, bool>(&error, fn(value: &Rejection) -> bool {
            return value.code == RejectionCode.TypeMismatch && value.span.start == indexSpan.start && value.span.end == indexSpan.end
          })
          if mismatch { return run bodyRejection(&resolver.*, module, RejectionCode.InvalidIndexType, indexSpan) }
