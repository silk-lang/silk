        Option<Result<SelectedVariant, Shared<Rejection>>>.Some {value} => value
        Option<Result<SelectedVariant, Shared<Rejection>>>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
