      if fields.present { writtenFields = fields.range }
      return run checkVariantConstruct(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, move chosen, writtenFields, expected, constraints, contractBody, unsafeAllowed, span)
