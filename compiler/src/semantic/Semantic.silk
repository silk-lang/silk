}

struct WrittenSignature {
  foreign: bool
  isVariadic: bool
  generics: Range
  parameters: Vector<HirId>
  // The authored parameter named `self`; only its outer borrow supplies a result default.
  receiver: Option<usize>
  result: Option<HirId>
  failures: HirRef
  requirements: HirRef
  environment: RangeRef
  // The written `where` clauses; only `provides` clauses are supported.
  constraints: Range
  isEffect: bool
  isUnsafe: bool
  isStatic: bool
  isPublic: bool
  supported: bool
