effect fn checkSourceIntegerLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  sign: Sign,
  magnitude: Symbol,
  suffix: SymbolRef,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let digits = run bodyText(&resolver.source, cursor, magnitude)
  let mut written = run Bytes.copy(b"i32")
  let mut contextual = false
  if suffix.present {
    written = run bodyText(&resolver.source, cursor, suffix.symbol)
  } else if let Option<Shared<Type>>.Some {value} = &expected.* {
    if Shared<Type>.with<bool>(
      &value,
      fn(ty: &Type) -> bool {
        return fixedIntegerType(ty) || pointerSizedIntegerType(ty)
      },
    ) {
      contextual = true
    }
  }
  let selected = Bytes.asSlice(&written)
  if contextual {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      let fits = Shared<Type>.with<bool>(
        &value,
        fn(resolved: &Type) -> bool {
          return match & resolved.* {
            Type.Primitive {name} => fitsInteger(
              &resolver.target,
              Bytes.asSlice(&name),
              sign,
              Bytes.asSlice(&digits),
            )
            _ => false
          }
        },
      )
      if !fits {
        let code = Shared<Type>.with<RejectionCode>(&value, fn(resolved: &Type) -> RejectionCode {
          return integerTypeRangeCode(resolved, sign)
        })
        return run bodyRejection(&resolver.*, module, code, span)
      }
      ty = Shared<Type>.clone(&value)
    }
  } else {
    if !fixedIntegerName(selected) && !pointerSizedIntegerName(selected) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    if !fitsInteger(&resolver.target, selected, sign, Bytes.asSlice(&digits)) {
      return run bodyRejection(&resolver.*, module, integerRangeCode(selected, sign), span)
    }
    ty = run primitiveType(selected)
  }
  form = BodyExpression.Integer {literal: run anchoredNode(cursor, expression)}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceCharacterLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  scalar: u32,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    let integer = Shared<Type>.with<Option<StaticIntegerType>>(&value, fn(ty: &Type) -> Option<StaticIntegerType> {
      if let Type.Primitive {name} = &ty.* { return StaticExecution.integerType(Bytes.asSlice(&name)) }
      return Option<StaticIntegerType>.none()
    })
    if let Option<StaticIntegerType>.Some {value: selected} = move integer {
      let digits = run characterDigits(scalar)
      let fits = Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
        if let Type.Primitive {name} = &ty.* { return fitsInteger(&resolver.target, Bytes.asSlice(&name), Sign.Positive, Bytes.asSlice(&digits)) }
        return false
      })
      if !fits { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span) }
      let actual = match move StaticValue.integer(selected, StaticSign.Positive, u32.toU64(scalar), resolver.target.pointerBits()) {
        Option<StaticData>.Some {value: actual} => move actual
        Option<StaticData>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span) }
      }
      return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
        expression, span,
        run Shared<StaticData>.make(move actual), Shared<Type>.clone(&value), expected, mismatchCode)
    }
  }
  let actual = match move StaticValue.character(scalar) {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => { fail RevisionMismatch {} }
  }
  return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span,
    run Shared<StaticData>.make(move actual), run primitiveType(b"char"), expected, mismatchCode)

}

// DURATION-001: a duration literal is its exact `u64` nanosecond total, independent of context.
effect fn checkSourceDurationLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  components: Range,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let mut total: u64 = 0
  let mut at = usize.ZERO
  while at < components.length {
    let component = run bodyChild(&resolver.source, cursor, components, at)
    let sum = match run bodyNode(&resolver.source, cursor, component) {
      Node.DurationComponent {magnitude, unit} => DurationUnit.accumulate(unit, total, magnitude)
      _ => { fail RevisionMismatch {} }
    }
    total = match move sum {
      Option<u64>.Some {value} => value
      Option<u64>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.DurationOutOfRange, span) }
    }
    at = at + usize.ONE
  }
  let actual = match move StaticValue.integer(StaticIntegerType.U64, StaticSign.Positive, total, resolver.target.pointerBits()) {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => { fail RevisionMismatch {} }
  }
  return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span,
    run Shared<StaticData>.make(move actual), run primitiveType(b"u64"), expected, mismatchCode)

}

effect fn checkSourceFloatingLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut Vector<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  suffix: SymbolRef,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let mut contextual = false
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    contextual = Shared<Type>.with<bool>(
      &value,
      fn(checked: &Type) -> bool {
        if let Type.Primitive {name} = &checked.* {
          let written = Bytes.asSlice(&name)
          return same(written, b"f32") || same(written, b"f64")
        }
        return false
      },
    )
  }
  if suffix.present { contextual = false }
  if contextual {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      ty = Shared<Type>.clone(&value)
    }
  } else {
    let mut spelling = run Bytes.copy(b"f64")
    if suffix.present { spelling = run bodyText(&resolver.source, cursor, suffix.symbol) }
    if !same(Bytes.asSlice(&spelling), b"f32") && !same(Bytes.asSlice(&spelling), b"f64") { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    ty = run primitiveType(Bytes.asSlice(&spelling))
  }
  form = BodyExpression.Float {literal: run anchoredNode(cursor, expression)}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

