/// The semantic fact selected by a query key.
pub enum Family {
  /// All candidates for one written name.
  Name,
  /// One imported namespace or selected member.
  Import,
  /// The target of a type alias.
  Alias,
  /// A nominal declaration's identity.
  Identity,
  /// The ordered names or positions declared by one nominal aggregate.
  Members,
  /// The written types of one requested field, position, or variant payload.
  MemberShape,
  /// The binders and declared bounds of a type, alias, interface, or service declaration.
  Contract,
  /// The ordered operation declarations of an interface or service.
  Operations,
  /// The operator interfaces nameable from one module in the current condition/profile scope.
  OperatorInterfaces,
  /// The ordered test catalog of one discovery root (TEST-003, TEST-004).
  Tests,
  /// The resolved heads of every `impl` declaration in one module.
  Implementations,
  /// Implementation shapes collected without proving their applied argument bounds.
  ImplementationShapes,
  /// One implementation shape with its applied argument obligations retained.
  ImplementationShape,
  /// The resolved head of one `impl` declaration, including applied argument validity.
  ImplementationHead,
  /// The published inherent members of one nominal owner across its module's inherent `impl`s.
  InherentMembers,
  /// What one owner's inherent members say about one member name: a projection of
  /// `InherentMembers` whose answer is unchanged when another member is added or removed, so its
  /// readers do not rerun.
  InherentMember,
  /// Every conformance head for one interface or service and one provider owner, read from only
  /// the modules permitted to own such a conformance.
  ConformanceHeads,
  /// The written members of one conformance or sealed-property `impl`, with mapped targets resolved.
  ImplementationMembers,
  /// Whether one conformance `impl` is coherent: every parameter is determined by its head, every
  /// bound descends through the provider, and no other head of its complete owner bucket could
  /// name the same goal.
  Coherence,
  /// The conditional bounds of one exact conformance head applied to a requested goal.
  ProofBounds,
  /// The premises one body may assume, shared by its typing and its lowering (`bodyPremises`).
  BodyPremises,
  /// How many lifetimes a struct, tuple, or union generates for lifetimes its fields leave unwritten.
  FieldLifetimes,
  /// The variance of each binder of one struct, tuple, union, or enum (LIFE-002).
  Variance,
  /// Which binders of one struct, tuple, union, or enum its cleanup may observe (LIFE-005).
  DropObservation,
  /// The types written on a function header.
  Signature,
  /// A contract operation's signature under one conformance `impl`: the contract's binders take
  /// the head's contract arguments and `Self` takes its provider. The key is the implementation's
  /// module and declaration handle; `member` is the operation's position in its contract's operation list.
  OperationUnder,
  /// A contract operation's signature with applied interface arguments and `Self`, independent
  /// of which declared bound or concrete witness proves the application.
  AppliedOperation,
  /// An inherent member's signature under its nominal owner's applied arguments and `Self`.
  AppliedInherent,
  /// Which member implements each contract operation of one conformance `impl`, each checked
  /// against its operation's header under the conformance head. No member body is read.
  Witnesses,
  /// The written type of a constant declaration, independent of its initializer.
  Constant,
  /// The concrete header of one explicitly registered package parameter.
  ParameterSchema,
  /// One registered parameter's evaluated source default.
  ParameterDefault,
  /// The complete selected value of a constant initializer.
  Initializer,
  /// The evaluated condition of one module-level `static if` declaration.
  Condition,
  /// The explicitly supplied, content-interned build profile.
  ProfileInput,
  /// Whether one runtime function needs static residualization (`needsStaticResidualization`):
  /// its own static markers, or a call to a static helper. Body checking, lowering and selection
  /// all route on it, so the body's calls are resolved for it once.
  StaticRouting,
  /// The resolved annotations and call targets written in one ordinary function's body
  /// (`resolveBodyFacts`), which its static routing and its checking both read.
  BodyFacts,
  /// One checked ordinary function body.
  Body,
  /// The finite exact environment established by one complete ordinary opaque producer.
  OpaqueRealization,
  /// The canonical original environment behind one complete ordinary callable-result producer.
  CallableOrigin,
  /// Private source-evidence collection and exact replay for a finite origin transaction.
  OriginGraph,
  OriginDraft,
  OriginSolve,
  OriginValidate,
  /// A backend-neutral control-flow graph for one closed runtime instance.
  Mir,
  /// Backend-neutral storage, field offsets and ABI facts for one type on this store's target.
  Layout,
  /// Whether one type has no runtime layout (STATIC-009). The key names the type by its
  /// lifetime-erased intern, because lifetimes never decide the answer: every signature that
  /// mentions the same type up to its regions shares one walk.
  PhaseOnly,
  /// Source-validated immutable emission inputs for one instance.
  EmissionInputs,
  /// One LLVM definition keyed by the complete immutable emission input content.
  LlvmText,
  /// One module's declaration check in a revisable store. It is no provider: `checkModule` runs
  /// it and records the root demands and source reads of its sweep against it, so a later check
  /// of an unaffected module is verified instead of swept again.
  ModuleCheck,
  /// Whether dropping a value of one closed nominal type runs no cleanup (`cleanupFree`). The key
  /// names the type by its lifetime-erased intern, so every body that holds the type shares one
  /// walk of its fields instead of each walking them again.
  CleanupFree,
}

// The Tracy zone name of one query family's provider run.
fn familyZone(family: Family) -> &'static [u8] {
  return match family {
    Family.Name => b"Name"
    Family.Import => b"Import"
    Family.Alias => b"Alias"
    Family.Identity => b"Identity"
    Family.Members => b"Members"
    Family.MemberShape => b"MemberShape"
    Family.Contract => b"Contract"
    Family.Operations => b"Operations"
    Family.OperatorInterfaces => b"OperatorInterfaces"
    Family.Tests => b"Tests"
    Family.Implementations => b"Implementations"
    Family.ImplementationShapes => b"ImplementationShapes"
    Family.ImplementationShape => b"ImplementationShape"
    Family.ImplementationHead => b"ImplementationHead"
    Family.InherentMembers => b"InherentMembers"
    Family.InherentMember => b"InherentMember"
    Family.ConformanceHeads => b"ConformanceHeads"
    Family.ImplementationMembers => b"ImplementationMembers"
    Family.Coherence => b"Coherence"
    Family.ProofBounds => b"ProofBounds"
    Family.BodyPremises => b"BodyPremises"
    Family.FieldLifetimes => b"FieldLifetimes"
    Family.Variance => b"Variance"
    Family.DropObservation => b"DropObservation"
    Family.Signature => b"Signature"
    Family.OperationUnder => b"OperationUnder"
    Family.AppliedOperation => b"AppliedOperation"
    Family.AppliedInherent => b"AppliedInherent"
    Family.Witnesses => b"Witnesses"
    Family.Constant => b"Constant"
    Family.ParameterSchema => b"ParameterSchema"
    Family.ParameterDefault => b"ParameterDefault"
    Family.Initializer => b"Initializer"
    Family.Condition => b"Condition"
    Family.ProfileInput => b"ProfileInput"
    Family.Body => b"Body"
    Family.OpaqueRealization => b"OpaqueRealization"
    Family.CallableOrigin => b"CallableOrigin"
    Family.OriginGraph => b"OriginGraph"
    Family.OriginDraft => b"OriginDraft"
    Family.OriginSolve => b"OriginSolve"
    Family.OriginValidate => b"OriginValidate"
    Family.Mir => b"Mir"
    Family.Layout => b"Layout"
    Family.PhaseOnly => b"PhaseOnly"
    Family.StaticRouting => b"StaticRouting"
    Family.BodyFacts => b"BodyFacts"
    Family.EmissionInputs => b"EmissionInputs"
    Family.LlvmText => b"LlvmText"
    Family.ModuleCheck => b"ModuleCheck"
    Family.CleanupFree => b"CleanupFree"
  }
}

/// A function contract resolved from its written header, including binders, bounds, and channels.
///
/// # Details
///
/// The contract describes what callers may rely on. Bounds are recorded, not proved; channels are
/// declared upper bounds, not facts derived from the body.
pub struct Signature {
  /// The declaration-owned ordinary type parameters, including exact callable representations.
  pub typeParameters: List<Shared<Type>>,
  /// The first implicit callable representation ordinal, or `usize.MAX` when there are none.
  /// These slots follow written binders and elided lifetimes and cannot be supplied in source.
  pub callableParameterStart: usize,
  /// The declaration-owned written and elided lifetime parameters.
  pub lifetimeParameters: List<Shared<Lifetime>>,
  /// The declaration-owned `?R` requirement-row parameters in written order.
  pub rowParameters: List<RowParameter>,
  /// The member's declared bounds followed by its inherent owner's substituted domain premises
  /// and its inherent impl's substituted `where` bounds.
  pub constraints: List<Constraint>,
  /// The parameter types in written order.
  pub parameters: List<Shared<Type>>,
  /// The written result type, or unit when omitted. For `effect fn`, the Effect's success type.
  pub result: Shared<Type>,
  /// The declared failure type; `never` when omitted.
  pub failure: Shared<Type>,
  /// The declared requirement row; empty when omitted.
  pub requirements: Shared<Row>,
  /// Whether `effect` was written, so calling constructs an Effect with these channels.
  pub isEffect: bool,
  /// Whether an unnamed C variadic tail was written after the fixed parameters.
  /// This invocation shape is part of dependency identity; tail types belong to each call.
  pub isVariadic: bool,
  /// Whether `unsafe` was written, so a complete invocation needs an `unsafe` acknowledgement.
  pub isUnsafe: bool,
  /// Whether this is a `static fn`, whose every call executes during static evaluation.
  pub isStatic: bool,
  /// The original indices of `static` parameters of a runtime function, in written order. Their
  /// types stay in `parameters` (source arity); their values are static, never runtime lanes.
  pub staticSlots: List<usize>,
  /// The environment of the Effect constructed by calling an `effect fn`. It is either written, or
  /// elaborated from the captured inputs as the intersection of the regions they retain (`'static`
  /// when they retain none), with one elaborated lifetime binder bounding the inputs whose stored
  /// contents are generic. An anonymous `effect fn` with such inputs is rejected, so an `effect fn`
  /// always has one. `None` means an ordinary function.
  pub environment: Option<Intersection>,
  /// Whether `environment` was written (LIFE-004). The body then assumes every input outlives it,
  /// so a call owes that (`impliedSignatureBounds`); an elaborated one holds of its inputs already.
  pub environmentWritten: bool,
  /// The input a written environment does not cover (`environmentExemptInput`), as a position in
  /// `parameters`; `usize.MAX` when it covers every input.
  pub environmentExempt: usize,
}

/// The binders and bounds declared by a type, alias, interface, or service declaration.
///
/// # Details
///
/// The contract records what every application must satisfy. It proves nothing about a particular
/// application; applying a bounded declaration proves its instantiated constraints.
pub struct Contract {
  /// The declaration-owned ordinary type parameters in written order.
  pub typeParameters: List<Shared<Type>>,
  /// The declaration-owned written and elided lifetime parameters.
  pub lifetimeParameters: List<Shared<Lifetime>>,
  /// The declaration-owned `?R` requirement-row parameters in written order.
  pub rowParameters: List<RowParameter>,
  /// The declared binder bounds in written order.
  pub constraints: List<Constraint>,
  /// The implicit `Self` provider of an interface or service, bound after the written binders;
  /// absent for every other declaration.
  pub provider: Option<Shared<Type>>,
}

/// One declared generic bound. It states a requirement; it does not select or prove a conformance.
pub union Constraint {
  /// `T: Contract<Arguments>` requires the provider to conform to an interface or service.
  Conforms {pub provider: Shared<Type>, pub contract: Shared<Type>},
  /// `F: fn(A) -> B` or `F: once Effect<A>` binds one exact executable representation that
  /// satisfies the callable or Effect use contract.
  Represents {pub parameter: Shared<Type>, pub contract: Shared<Type>},
  /// `T: 'region` requires the borrowed contents of `T` to remain valid for the region.
  Contents {pub subject: Shared<Type>, pub region: Shared<Lifetime>},
  /// `'longer: 'shorter` requires the first lifetime to cover the second.
  Outlives {pub longer: Shared<Lifetime>, pub shorter: Shared<Lifetime>},
  /// `T: Copy` requires the compiler-sealed Copy property, which no ordinary interface supplies.
  Copyable {pub subject: Shared<Type>},
  /// `T: Transferable` or `T: Concurrent` requires that sealed thread property, derived from the
  /// type's parts or asserted by its declaring module's `impl` (THREAD-002, THREAD-003).
  ThreadSafe {pub subject: Shared<Type>, pub property: SealedProperty},
  /// `F: Intrinsic.Detached` or `F: Intrinsic.NonParking` requires one sealed compiler property of
  /// an executable. It is a witness-free static obligation, not an interface or service.
  Property {pub subject: Shared<Type>, pub property: IntrinsicProperty},
  /// `where Provider provides S from R` (SERV-007): `provider` conforms to the one service-role key
  /// `selector` names, that key is present in `source`, and the provider's capture (a shared
  /// borrow, an exclusive borrow, or an owned value) has access sufficient for the stored entry.
  Provides {pub provider: Shared<Type>, pub selector: Shared<Row>, pub source: Shared<Row>},
  /// `where S in E` (FAIL-005): every member of the selected failure type is a member of the
  /// source failure type, and the selection is not empty.
  FailureSubset {pub selected: Shared<Type>, pub source: Shared<Type>},
  /// `where ?S in R` over requirement rows: every entry and row parameter of the selected row is
  /// promised by the source row, as in the bootstrap's requirement subset.
  RequirementSubset {pub selected: Shared<Row>, pub source: Shared<Row>},
}

/// One normalized compile-time conformance goal.
pub struct ConformanceGoal {
  pub contract: Shared<Type>,
  pub provider: Shared<Type>,
}

/// The exact evidence used at one step of a conformance proof.
pub union ConformanceEvidence {
  /// A bound written on the declaration being checked.
  Declared {pub bound: Constraint},
  /// A coherent concrete implementation, with its head binders matched to the goal.
  Concrete {pub head: Shared<ImplementationHead>, pub bindings: List<Binding>},
  /// A structural union provider whose every member conforms; each member's own steps precede
  /// this one, and a call dispatches on the receiver's tag to the member's witness.
  Union,
}

/// One goal and the evidence that discharged it.
pub struct ConformanceStep {
  pub goal: ConformanceGoal,
  pub evidence: ConformanceEvidence,
}

/// Complete compile-time evidence for a requested goal and all its conditional requirements.
pub struct ConformanceProof {
  pub steps: List<ConformanceStep>,
}

/// The result of proving a goal without selecting a runtime provider.
pub union ConformanceDecision {
  Proven {pub proof: ConformanceProof},
  /// The chain starts at the requested goal and ends at the failed requirement.
  Rejected {pub diagnostic: Shared<Rejection>, pub chain: List<ConformanceGoal>},
}

/// A sealed compiler property that refines an executable representation bound.
pub enum IntrinsicProperty {
  /// The executable retains no external lexical or provider loan.
  Detached,
  /// The specialized transitive graph cannot reach external parking.
  NonParking,
}

/// A compiler-sealed language property an `impl` may request. It is not an ordinary interface:
/// eligibility is checked by the language, and users cannot supply its behavior.
pub enum SealedProperty {
  /// Duplication without running user code.
  Copy,
  /// One restricted automatic cleanup hook.
  Drop,
  /// Ownership of a value may move to another thread.
  Transferable,
  /// A shared borrow of a value may be used from several threads at once.
  Concurrent,
}

/// What one `impl` declaration implements.
pub union ImplementationKind {
  /// `impl Owner { ... }` declares inherent members of one nominal owner.
  Inherent,
  /// `impl Contract for Provider` conforms the provider to the head's interface or service.
  Conformance,
  /// `impl Copy for Provider` or `impl Drop for Provider` requests a sealed property.
  Sealed {pub property: SealedProperty},
}

/// One written member of a conformance or sealed-property `impl`.
///
/// # Details
///
/// The member's name is its declaration's name. Matching members to contract operations and
/// checking their contracts is witness validation, not part of this list.
pub union ImplementationMember {
  /// An operation defined inline by a function declared in the `impl`.
  Inline {pub declaration: Shared<DeclarationId>, pub span: Span},
  /// `name: Path` maps an operation to one existing function, resolved from its header path only.
  Mapped {pub declaration: Shared<DeclarationId>, pub span: Span, pub target: Shared<DeclarationId>},
  /// `name: Intrinsic.member` maps an operation to one unchecked, safe scalar intrinsic.
  Intrinsic {pub declaration: Shared<DeclarationId>, pub span: Span, pub member: IntrinsicMember},
}

/// What implements one contract operation: a source function, or a sealed scalar intrinsic that
/// an interface call lowers in place.
pub union WitnessImplementation {
  Declaration {pub declaration: Shared<DeclarationId>},
  Intrinsic {pub member: IntrinsicMember},
}

/// The member that implements one contract operation in a conformance.
///
/// # Details
///
/// A witness is compile-time evidence that the implementation's header satisfies the operation's
/// header under the conformance head. It proves no conformance, and its implementation's body is
/// not read.
pub struct Witness {
  /// The contract operation.
  pub operation: Shared<DeclarationId>,
  /// The inline function, mapped target or mapped scalar intrinsic that implements it.
  pub implementation: WitnessImplementation,
  /// The matched arguments for the implementation's written and elided binders.
  pub arguments: List<Argument>,
  pub argumentOrdinals: List<usize>,
  pub scopes: List<ScopeBinding>,
  /// One validated operand transport recipe per contract parameter.
  pub operands: List<OperandPass>,
}

/// An inherent member that is not published, with the anchored reason.
pub struct RejectedMember {
  /// The rejected member declaration.
  pub declaration: Shared<DeclarationId>,
  /// Why the member is not an associated item of its owner.
  pub rejection: Shared<Rejection>,
}

struct HeadObligation {
  bound: Constraint,
  module: ModuleId,
  span: Span,
}

/// The resolved head of one `impl` declaration, without its members.
///
/// # Details
///
/// The binders are the written `impl` binders followed by lifetimes elided from its heads, with
/// the written bounds recorded, not proved. The provider is what `Self` denotes inside the
/// implementation; its nominal declaration, or its foundational scalar or `string` spelling, is
/// the provider owner. A head claims only that its declaration is well formed and permitted in its
/// module; it proves no conformance and checks no member.
pub struct ImplementationHead {
  obligations: List<HeadObligation>,
  /// The `impl` declaration.
  pub declaration: Shared<DeclarationId>,
  /// Whether it is inherent, a conformance, or a sealed property.
  pub kind: ImplementationKind,
  /// The implementation's binders and bounds.
  pub binders: Contract,
  /// An inherent owner's declaration bounds, substituted onto the implementation's family
  /// binders. These are domain premises, not authored impl bounds or conformance obligations.
  pub ownerPremises: List<Constraint>,
  /// The applied interface or service of a conformance; absent otherwise.
  pub contract: Option<Shared<Type>>,
  /// The applied provider or inherent owner.
  pub provider: Shared<Type>,
  /// The whole `impl` header.
  pub span: Span,
  /// The written contract, or the inherent owner for an inherent `impl`.
  pub contractSpan: Span,
  /// The written provider after `for`, or the inherent owner.
  pub providerSpan: Span,
  /// Each written binder, in written order; generated lifetimes have no span.
  pub binderSpans: List<Span>,
  /// Each written bound, parallel to `binders.constraints`.
  pub boundSpans: List<Span>,
  /// How many trailing type binders stand for use contracts written in the heads (REP-001).
  pub reified: usize,
}

/// One declared nominal member; tuple positions have no written name.
pub struct Member {
  pub name: Option<Bytes>,
  pub isPublic: bool,
  pub kind: MemberKind,
  /// Validated scalar enum value; absent for every other member kind.
  pub discriminant: Option<EnumCase>,
}

/// The source form of a nominal member.
pub enum MemberKind {
  Field,
  Position,
  EnumCase,
  Variant,
}

/// One explicitly registered parameter and its demandable header answer.
pub struct RegisteredParameter {
  pub module: ModuleId,
  pub name: Bytes,
  pub identity: DeclarationId,
  pub answer: Shared<Result<Answer, NoRejection>>,
}

struct RegisteredName {
  name: Bytes,
  identity: DeclarationId,
}

/// A statically known local visible to one reached expression in a mixed body.
/// Parameter types come from the written signature; prior checked roots must agree with a binding's annotation.
pub union StaticRootBinder {
  Parameter {pub syntax: HirId},
  Binding {pub syntax: HirId, pub checked: Shared<Result<Answer, NoRejection>>},
  /// A source for-binder authenticated by one actually evaluated sequence and ordinal.
  Iteration {pub syntax: HirId, pub evidence: StaticExecution.IterationEvidence},
}

/// The context that selects the type of a reached static expression.
pub union StaticRootExpectation {
  Inferred,
  Boolean,
  /// Widen bare integer arithmetic for value admission without changing declared types.
  IntegerExtent,
  Resolved {pub ty: Shared<Type>, pub mismatchCode: RejectionCode},
  Annotation {pub syntax: HirId},
}

/// One completed semantic query value.
pub union Value {
  /// A source-neutral completed key refusal. Only the actual requesting origin turns it into
  /// Unsupported; cached glue preparation does not retain another caller's module or span.
  CanonicalizationFailed {pub reason: CanonicalizationFailure},
  /// The complete syntactic name bucket, including an empty bucket.
  Name {pub bucket: Shared<NameObservation>},
  /// A namespace import's target module.
  Namespace {pub module: ModuleId, pub ordinal: usize},
  /// A selected import's canonical target declaration.
  Selected {pub declaration: DeclarationId, pub module: usize, pub handle: usize},
  /// An alias target or nominal type identity.
  Type {pub resolved: Shared<Type>},
  /// An alias whose target is a sealed property such as `Intrinsic.Copy` (TYPE-004).
  Property {pub property: SealedProperty},
  /// Ordered member names without resolving any member's type.
  Members {pub identity: Shared<DeclarationId>, pub members: List<Member>, pub enumRepresentation: StaticIntegerType},
  /// Resolved types of only the selected member; zero for a scalar enum case.
  MemberShape {pub types: List<Shared<Type>>},
  /// A declaration's binders and bounds.
  Contract {pub contract: Contract},
  /// An interface's or service's operation declarations in written order, and for each whether
  /// it writes a default body that a conformance may omit the operation to use.
  Operations {pub operations: List<Shared<DeclarationId>>, pub defaults: List<bool>},
  /// Shared identities of interfaces eligible for operator discovery in one module.
  OperatorInterfaces {pub interfaces: List<Shared<DeclarationId>>},
  /// The discovered tests of one root, in catalog order.
  Tests {pub catalog: Shared<TestCatalog>},
  /// Every `impl` head of one module in written order; empty when the module has none.
  // `owners` buckets the heads by the hash of their provider's owner, in head order.
  Implementations {pub heads: List<Shared<ImplementationHead>>, owners: InternIndex},
  /// One `impl` declaration's head.
  ImplementationHead {pub head: Shared<ImplementationHead>},
  /// An owner's inherent members. A member that duplicates another or claims an owner item's name
  /// is not published; its anchored rejection is kept instead, and no winner is chosen.
  InherentMembers {pub members: List<Shared<DeclarationId>>, pub rejected: List<RejectedMember>},
  /// The published inherent member of one name, or the rejection that keeps it unpublished.
  InherentMember {pub published: Option<Shared<DeclarationId>>, pub rejected: Option<Shared<Rejection>>},
  /// The conformance heads relevant to one contract and provider owner; empty observes absence.
  ConformanceHeads {pub heads: List<Shared<ImplementationHead>>},
  /// A conformance `impl` is coherent. It proves no bound and admits no witness by itself.
  Coherent,
  /// Conditional bounds after the selected head's exact bindings have been applied.
  ProofBounds {pub constraints: List<Constraint>},
  /// The premises one body may assume.
  BodyPremises {pub constraints: List<Constraint>},
  /// A conformance's members in written order; empty observes that it writes none.
  ImplementationMembers {pub members: List<ImplementationMember>},
  /// The generated lifetime count of one struct, tuple, or union.
  FieldLifetimes {pub count: usize},
  /// One variance per binder of a nominal declaration, in complete binder order.
  Variance {pub binders: List<Variance>},
  /// What cleanup of a nominal declaration observes of each binder, in complete binder order.
  DropObservation {pub binders: List<DropUse>},
  /// A function's written signature.
  Signature {pub signature: Signature},
  /// A conformance's implementations in its contract's operation order.
  Witnesses {pub witnesses: List<Witness>},
  /// A constant's initializer value at the type published by its `Constant` fact.
  Initializer {pub value: Shared<StaticData>},
  /// Whether a module-level `static if` condition holds.
  Condition {pub holds: bool},
  /// Whether a type has no runtime layout (STATIC-009).
  PhaseOnly {pub holds: bool},
  /// Whether dropping a value of a closed nominal type runs no cleanup.
  CleanupFree {pub holds: bool},
  /// Whether a runtime function needs static residualization.
  StaticRouting {pub holds: bool},
  /// The position of a function body's resolved annotations and call targets in this store's
  /// body facts arena.
  BodyFacts {pub index: usize},
  /// A package parameter's checked declaration header.
  ParameterSchema {pub schema: Shared<ParameterSchema>},
  /// A reached registered default, checked at the declaration's resolved type.
  ParameterDefault {pub value: Shared<StaticData>, pub span: Span},
  /// The content-interned profile slot observed by a sealed static query.
  ProfileInput {pub slot: usize},
  /// A complete checked ordinary function body.
  Body {
    /// The checked payload, whose positions count from its declaration's anchor.
    pub body: Shared<TypedBody>,
  },
  /// The position of a MIR answer in this store's immutable answer arena.
  OriginPlan {pub index: usize},
  OriginEvidence {pub index: usize},
  Mir {pub index: usize},
  /// The position of a target layout answer in this store's immutable answer arena.
  Layout {pub index: usize},
  /// This target-neutral type has no layout in the current backend subset.
  LayoutUnsupported,
  /// The position of validated emission inputs in this store's immutable answer arena.
  EmissionInputs {pub index: usize},
  /// The position of an immutable per-instance LLVM answer in this store.
  LlvmText {pub index: usize},
  /// A reached backend form outside the current implementation.
  Unsupported {pub gap: Shared<BackendGap>},
}

/// Whole-program assembly of demanded instance text, with reached unsupported forms preserved.
pub union BackendBuild {
  /// `unchecked` counts the emitted definitions and the unemitted checked root bodies not
  /// borrow-checked, per `uncheckedReason`.
  /// `units` holds the same definitions split into codegen units when the store selected them
  /// ([`Semantic.selectCodegenUnits`]), and is empty otherwise.
  Module {pub text: Bytes, pub unchecked: List<usize>, pub plan: EmissionPlan, pub units: List<CodegenUnit>},
  Unsupported {pub gaps: List<Shared<BackendGap>>},
  /// Source refusals, in the order the walk reached them, with every gap reached beside them.
  /// A refused instance contributes no references, so the walk continues past it and reports
  /// each independent refusal once.
  Rejected {pub first: Shared<Rejection>, pub further: List<Shared<Rejection>>, pub gaps: List<Shared<BackendGap>>},
}

// A build refused before or after the instance walk, by one diagnostic.
fn refusedBuild(diagnostic: Shared<Rejection>) -> BackendBuild {
  return BackendBuild.Rejected {first: move diagnostic, further: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make()}
}

/// The edge that reached a closure root, kept so a rejection carries the original context.
pub struct ClosureIncoming {
  pub caller: Option<Application>,
  pub edge: Edge,
  pub module: ModuleId,
  pub span: Span,
}

/// One complete outgoing reference inside a closure: node indices, provenance and call site.
pub struct ClosureEdge {
  pub from: usize,
  pub to: usize,
  pub edge: Edge,
  pub module: ModuleId,
  pub span: Span,
}

/// A complete reachable-key closure: every node's lowered successors are listed and included.
pub struct FiniteClosureEvidence {
  pub incoming: ClosureIncoming,
  pub ancestors: List<Application>,
  pub nodes: List<Application>,
  pub edges: List<ClosureEdge>,
}

/// The outcome of one demand-local closure transaction over changing static values.
pub union StaticClosure {
  Certified {pub evidence: FiniteClosureEvidence},
  /// The node budget ended construction before closure; nothing is admitted or assumed infinite.
  NotProven {pub diagnostic: Shared<Rejection>},
  Rejected {pub diagnostic: Shared<Rejection>},
  Unsupported {pub gaps: List<Shared<BackendGap>>},
}

/// The node budget of one closure transaction during a build. A resource control, not a proof.
pub const staticClosureNodes: usize = 256

// One pending step of a closure transaction's depth-first walk.
union ClosureVisit {
  Enter {key: InstanceKey, from: usize, edge: Edge, module: ModuleId, span: Span},
  Leave,
}

// The drafts one closure transaction owns; released on success, failure or interruption. Semantic
// is never part of the resource.
struct ClosureDraft {
  pending: List<ClosureVisit>,
  nodes: List<Application>,
  edges: List<ClosureEdge>,
  admission: Admission,
}

/// A direct query dependency retained with a completed semantic answer.
///
/// # Details
///
/// It holds the demanded key's store ordinals, so recording one allocates nothing. Read its
/// module, name and declaration with [`Semantic.dependencyModule`], [`Semantic.dependencyName`]
/// and [`Semantic.dependencyDeclaration`] on the store that recorded it.
pub struct Dependency {
  /// The demanded query family.
  pub family: Family,
  // The store's module ordinal, and the name symbol for a name query.
  module: usize,
  name: usize,
  // The dense declaration handle for a declaration query, otherwise `usize.MAX`.
  declaration: usize,
  // The selected import-member ordinal, otherwise `usize.MAX`.
  selected: usize,
  /// Whether a name query used the importing module's public-member view.
  pub external: bool,
}

impl Copy for Dependency {}

impl Dependency {
  /// Returns the selected import-member ordinal, absent for namespace imports and other families.
  pub fn member(self: &Self) -> Option<usize> {
    if self.selected == usize.MAX {
      return Option<usize>.none()
    }
    return Option<usize>.some(self.selected)
  }
}

// Families whose key names one declaration handle.
// The declaration a query key names, as `module.Owner.name`, for its Tracy zone text; empty for a
// family keyed by content. Reads the preloaded source unobserved, so it records no dependency.
effect fn zoneSubject(resolver: &mut Resolver, key: Key) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !declarationFamily(key.family) || key.declaration == usize.MAX || key.module >= List<ModuleId>.length(&resolver.modules) {
    return Bytes.make()
  }
  let module = resolvedModule(&resolver.*, key.module)
  let answer = run demandSource(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let position = declarationPosition(&resolver.*, key)
    if position < declarations.length {
      return run Mir.declarationName(&declarations[position].identity)
    }
  }
  return Bytes.make()
}

// The declaration `identity` names for progress and `--timings`, as `module.Owner.name`. An
// implementation's owner key does not spell a generic subject, so that step reads as the header
// the source writes, as `List<T>` or `(Drop for List<T>)`. Reads the preloaded source unobserved,
// so it records no dependency.
effect fn shownName(resolver: &mut Resolver, identity: &DeclarationId) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
  let module = DeclarationId.moduleId(identity)
  let mut name = run TypeText.modulePath(module)
  let count = DeclarationId.ownerCount(identity)
  let mut step = usize.ZERO
  while step < count {
    if DeclarationId.ownerKind(identity, step) == OwnerKind.Implementation {
      let header = run implementationHeader(&mut resolver.*, identity, step)
      if Bytes.length(&header) > usize.ZERO {
        run Bytes.append(&mut name, b".")
        run Bytes.append(&mut name, Bytes.asSlice(&header))
      }
    } else if DeclarationId.ownerNamed(identity, step) {
      run Bytes.append(&mut name, b".")
      let ownerName = run DeclarationId.copyOwnerName(identity, step)
      run Bytes.append(&mut name, Bytes.asSlice(&ownerName))
    }
    step = step + usize.ONE
  }
  return move name
}

// The written header of the implementation at owner step `step` of `identity`, without `impl`
// and its generic parameters, its whitespace folded; parenthesized when it names an interface.
effect fn implementationHeader(resolver: &mut Resolver, identity: &DeclarationId, step: usize) -> Bytes
! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut shown = Bytes.make()
  let owner = run DeclarationId.enclosing(identity, step + usize.ONE)
  let module = DeclarationId.moduleId(identity)
  let answer = run demandSource(&mut resolver.*, module)
  let indexed = match move sourceOf(&resolver.*, &answer, module) {
    Option<&IndexedSource>.Some {value} => value
    Option<&IndexedSource>.None => { return move shown }
  }
  let hir = IndexedSource.authored(indexed)
  let text = SourceUnit.bytes(IndexedSource.sourceUnit(indexed))
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  let mut at = usize.ZERO
  while at < declarations.length && !DeclarationId.equals(&declarations[at].identity, &owner) { at = at + usize.ONE }
  if at == declarations.length { return move shown }
  let mut start = Module.span(hir, declarations[at].local).start
  if let Node.Declaration {header, ..} = Module.node(hir, declarations[at].local) { start = Module.span(hir, header).start }
  // Past `impl` and its generic parameters, up to the body.
  if start + 4 <= text.length && text[start] == 105 && text[start + 1] == 109 && text[start + 2] == 112 && text[start + 3] == 108 {
    start = start + 4
  }
  while start < text.length && isBlank(text[start]) { start = start + usize.ONE }
  if start < text.length && text[start] == 60 {
    let mut depth = usize.ZERO
    while start < text.length {
      if text[start] == 60 { depth = depth + usize.ONE }
      if text[start] == 62 && depth > usize.ZERO { depth = depth - usize.ONE }
      start = start + usize.ONE
      if depth == usize.ZERO { break }
    }
  }
  let mut end = start
  while end < text.length && text[end] != 123 { end = end + usize.ONE }
  run Progress.appendFolded(&mut shown, text, start, end)
  if DeclarationId.ownerNamed(&owner, DeclarationId.ownerCount(&owner) - usize.ONE)
    && DeclarationId.withOwnerName<bool>(&owner, DeclarationId.ownerCount(&owner) - usize.ONE, namesInterface) {
    let mut wrapped = run Bytes.copy(b"(")
    run Bytes.append(&mut wrapped, Bytes.asSlice(&shown))
    run Bytes.append(&mut wrapped, b")")
    return move wrapped
  }
  return move shown
}

// Whether an implementation's owner key, `subject` or `subject for target`, names an interface.
fn namesInterface(key: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + 5 <= key.length {
    if key[at] == 32 && key[at + 1] == 102 && key[at + 2] == 111 && key[at + 3] == 114 && key[at + 4] == 32 { return true }
    at = at + usize.ONE
  }
  return false
}

fn isBlank(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn declarationFamily(family: Family) -> bool {
  return family != Family.Name && family != Family.OperatorInterfaces && family != Family.Tests
    && family != Family.Implementations && family != Family.ImplementationShapes
    && family != Family.ProfileInput
    && family != Family.Layout
    && family != Family.PhaseOnly
    && family != Family.CleanupFree
    && family != Family.LlvmText
    && family != Family.ModuleCheck
}

/// A successful fact, the key's own semantic rejection, or a dependency's forwarded failure.
///
/// # Details
///
/// Only `Rejected` diagnostics are reported, each by the key that owns them. A key that cannot
/// proceed because a demanded dependency failed is `Unavailable`: it carries that failure as its
/// cause and reports nothing, like the bootstrap's `Unavailable` facts.
pub union Outcome {
  /// A resolved fact.
  Success {pub value: Value},
  /// The key's own completed semantic rejection: at least one diagnostic, in report order. A body
  /// rejected for statements it recovered past keeps, for an editor, what it still checked in
  /// `partial`; it is absent unless the store keeps editor tables, and nothing else reads it.
  Rejected {pub diagnostics: List<Shared<Rejection>>, pub partial: Option<Shared<TypedBody>>},
  /// A dependency's failure forwarded as this key's cause; reported by the dependency's owner.
  /// `partial` is as for `Rejected`: what a body that recovered past the failure still checked.
  Unavailable {pub cause: Shared<Rejection>, pub partial: Option<Shared<TypedBody>>},
}

impl Outcome {
  /// The failure a dependent forwards as its own cause: the first of this key's own diagnostics,
  /// or the cause it already forwards. Never reported; owners report their `diagnostics`.
  pub fn cause(self: &Self) -> Option<Shared<Rejection>> {
    return match &self.* {
      Outcome.Rejected {diagnostics, ..} => {
        let listed = List<Shared<Rejection>>.asSlice(&diagnostics)
        return Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&listed[usize.ZERO]))
      }
      Outcome.Unavailable {cause, ..} => Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&cause))
      Outcome.Success {..} => Option<Shared<Rejection>>.none()
    }
  }
}

// The cause of a rejected or unavailable outcome, which always has one.
fn forwardedCause(outcome: &Outcome) -> Shared<Rejection> {
  return match move Outcome.cause(outcome) {
    Option<Shared<Rejection>>.Some {value} => move value
    Option<Shared<Rejection>>.None => CompilerBug.panic(b"a successful outcome has no cause")
  }
}

/// The rejected outcome of one diagnostic; the query core turns a forwarded one into `Unavailable`.
effect fn rejectedOutcome(diagnostic: Shared<Rejection>) -> Outcome
! OutOfMemoryError ? &mut Allocator {
  if dependentFailure(&diagnostic) { return CompilerBug.panic(b"an answer carries a read of an unavailable binding") }
  let mut diagnostics = List<Shared<Rejection>>.make()
  run List<Shared<Rejection>>.append(&mut diagnostics, move diagnostic)
  return Outcome.Rejected {diagnostics: move diagnostics, partial: Option<Shared<TypedBody>>.none()}
}

/// One completed outcome and its direct nested demands.
pub struct Answer {
  /// The resolved fact or semantic rejection.
  pub outcome: Outcome,
  /// Every direct nested query demanded to produce the fact, including memo hits.
  pub dependencies: List<Dependency>,
}

/// An actual namespace-import answer paired with its authored declaration address.
pub struct InventoryImport {
  pub declaration: DeclarationId,
  pub answer: Shared<Result<Answer, NoRejection>>,
}

/// Copied source addresses; no Signature/Body success is inferred from syntax presence.
pub union SourceInventory {
  /// A missing path remains a retained observation for publication/revision.
  Absent {pub observation: Observation},
  Present {
    pub observation: Observation,
    /// SHA-256 of exact source bytes, including trivia.
    pub sourceDigest: [u8; 32],
    pub syntax: FunctionInventory,
    /// One actual static-arm availability answer per syntax.functions entry, in the same order.
    pub availability: List<Result<bool, Shared<Rejection>>>,
    pub imports: List<InventoryImport>,
  },
}

struct Root {
  family: Family,
  module: ModuleId,
  name: Bytes,
  answer: Shared<Result<Answer, NoRejection>>,
}

/// The roots and discovered facts of one semantic request.
///
/// # Details
///
/// A request retains only its own roots. A revisable store's graph records what each root's unit
/// consumed, so a cache hit answers the same discovery queries for a new request.
pub struct Request {
  roots: List<Root>,
  application: Option<ModuleId>,
  schemaModules: List<ModuleId>,
  // Whether the request demanded a root, which closes registration even after its roots are
  // forgotten.
  demanded: bool,
}

/// Registration cannot change after this request starts demanding facts.
pub struct RegistrationClosed {}

/// Two source origins claim the same logical package in one request.
pub struct ConflictingPackageSource {}

/// One query event in demand order.
/// An outdated unit a traced store reran, and the first dependee it found changed.
pub struct StaleCause {
  pub unit: usize,
  pub dependee: Dependee,
}

pub struct Event {
  /// Whether the query started, hit a completed answer, or completed.
  pub kind: EventKind,
  /// The family of the queried fact.
  pub family: Family,
  /// The key ordinal within this held semantic store.
  pub key: usize,
}

/// The lifecycle stage of an observable semantic query event.
pub enum EventKind {
  /// The query provider began work on a missing or invalid answer.
  Start,
  /// The query reused a completed answer.
  Hit,
  /// The query provider completed and stored an answer.
  Finish,
}

struct Key {
  family: Family,
  module: usize,
  name: usize,
  declaration: usize,
  member: usize,
  external: bool,
}

impl Copy for Key {}

// The current parse position is read only when a source projection needs it.
fn declarationPosition(resolver: &Resolver, key: Key) -> usize {
  if
    !declarationFamily(key.family) {
    return usize.ZERO
  }
  return DeclarationTable.position(&resolver.declarations, key.declaration)
}

// The direct position cache avoids source lookup and identity hashing on repeated key requests.
effect fn internDeclaration(resolver: &mut Resolver, key: Key) -> Key
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
  run reconcileSources(&mut resolver.*)
  if
    !declarationFamily(key.family) || key.declaration == usize.MAX {
    return key
  }
  let cached = DeclarationTable.cached(&resolver.declarations, key.module, key.declaration)
  let mut handle = cached
  if handle == usize.MAX {
    let module = resolvedModule(&resolver.*, key.module)
    let answer = run demandSource(&mut resolver.*, &module)
    if let Option<&IndexedSource>.Some {
      value: indexed
    } = move SourceIndex.source(&resolver.source, &answer, &module) {
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      if key.declaration < declarations.length {
        let identity = DeclarationId.copy(&declarations[key.declaration].identity)
        handle = run DeclarationTable.intern(
          &mut resolver.declarations,
          key.module,
          key.declaration,
          &identity
        )
      }
    }
  }
  let module = resolvedModule(&resolver.*, key.module)
  drop run observedSource(&mut resolver.*, &module, SourceSelector.Declaration {handle: handle, facet: SourceFacet.Alive})
  return Key {
    family: key.family,
    module: key.module,
    name: key.name,
    declaration: handle,
    member: key.member,
    external: key.external
  }
}

struct ScopedKey {
  key: Key,
  application: usize,
  profile: usize,
  // The interned word of the module-level `static if` condition whose evaluation demands this
  // key, or `usize.MAX`. Interface scans inside that evaluation skip the condition's own arms,
  // so its answers are distinct queries from the ordinary ones and never shared across contexts.
  condition: usize,
  // Private origin drafts and replay answers never share normal semantic cache entries.
  origin: OriginContext,
}

impl Copy for ScopedKey {}

// The scope identity `internKey` interns: the fields `sameKey` compares for the key's family,
// under one request application, profile, condition context and origin transaction. Layout is
// application-free.
fn sameScopedKey(left: &ScopedKey, right: &ScopedKey) -> bool {
  let sameApplication = left.key.family == Family.Layout || left.application == right.application
  return sameApplication && left.profile == right.profile && left.condition == right.condition
    && sameOriginContext(&left.origin, &right.origin) && sameKey(left.key, right.key)
}

// Hashes exactly the fields `sameKey` compares. Layout and LlvmText name immutable subjects;
// MIR and EmissionInputs also name the live declaration handle that owns their instance.
fn hashKey(hashed: u64, key: Key) -> u64 {
  let named = Hash.combine(Hash.combine(hashed, u8.toU64(Family.value(key.family))), usize.toU64(key.name))
  if key.family == Family.Layout || key.family == Family.LlvmText { return named }
  let placed = Hash.combine(Hash.combine(named, usize.toU64(key.module)), usize.toU64(key.declaration))
  if key.family == Family.Mir || key.family == Family.EmissionInputs { return placed }
  let member = Hash.combine(placed, usize.toU64(key.member))
  if key.external {
    return Hash.combine(member, 1)
  }
  return Hash.combine(member, 0)
}

// Hashes exactly the fields `sameScopedKey` compares.
fn hashScopedKey(value: &ScopedKey) -> u64 {
  let mut hashed = hashKey(Hash.mix(&Hash.seed(0), usize.toU64(value.profile)), value.key)
  if value.key.family != Family.Layout {
    hashed = Hash.combine(hashed, usize.toU64(value.application))
  }
  hashed = Hash.combine(hashed, usize.toU64(value.condition))
  if value.origin.active {
    return hashKey(Hash.combine(hashed, 1), value.origin.key)
  }
  return Hash.combine(hashed, 0)
}

struct InstanceLocation {
  module: usize,
  declaration: usize,
}

impl Copy for InstanceLocation {}

struct Selection {
  count: usize,
  publicCount: usize,
  declaration: usize,
  member: usize,
  kind: CandidateKind,
  span: Span,
  isPublic: bool,
  // The name span of the second admitted candidate; meaningful only when `count` exceeds one.
  repeat: Span,
  // Whether every admitted candidate is a module declaration rather than an import binding.
  declarationsOnly: bool,
}

impl Copy for Selection {}

struct HeaderSyntax {
  header: Node,
  span: Span,
}

// The syntax-owned address and phase eligibility copied before declaration demands mutate the
// source store. Anonymous bodies stay under their named owner's typing query.
pub struct DeclarationCheckResult {
  pub rejections: List<Shared<Rejection>>,
  pub gaps: List<Shared<BackendGap>>,
  /// The root-package bodies borrow checking left unchecked, in check order: concrete bodies, and
  /// open templates by their abstract status.
  pub unchecked: List<UncheckedDeclaration>,
}

/// A declaration whose checked body, or open template's abstract body, borrow checking left
/// unchecked.
pub struct UncheckedDeclaration {
  pub identity: DeclarationId,
  pub borrow: BodyBorrowStatus,
}

pub struct DeferredStaticTemplate {
  pub declaration: DeclarationId,
  pub reason: StaticTemplate.Reason,
}

/// A concrete root-package body the declaration sweep left without borrow checking: its module,
/// the source span of its body block, and its `uncheckedReason`.
pub struct UncheckedBody {
  pub module: ModuleId,
  pub block: Span,
  pub reason: usize,
}

struct DeclarationCheck {
  identity: DeclarationId,
  ordinal: usize,
  span: Span,
  // The body block, when the declaration has one.
  block: Span,
  body: bool,
  callable: bool,
  conditional: bool,
  alias: bool,
  open: bool,
  staticWork: bool,
  default: bool,
  conformance: bool,
  deferred: Option<StaticTemplate.Reason>,
  // For a mapping member (`name: target`) of an inherent impl, that impl's ordinal.
  inherentMapping: Option<usize>,
}

struct CheckedName {
  name: Bytes,
}

// The declarations of one module a check covers, and its candidate names.
struct ModuleChecks {
  declarations: List<DeclarationCheck>,
  names: List<CheckedName>,
}

// What a declaration sweep has found so far.
struct Sweep {
  rejections: List<Shared<Rejection>>,
  gaps: List<Shared<BackendGap>>,
  unchecked: List<UncheckedDeclaration>,
  // The concrete bodies whose escapes the sweep checks once it ends.
  concrete: List<DeclarationId>,
}

impl Sweep {
  fn make() -> Sweep {
    return Sweep {
      rejections: List<Shared<Rejection>>.make(),
      gaps: List<Shared<BackendGap>>.make(),
      unchecked: List<UncheckedDeclaration>.make(),
      concrete: List<DeclarationId>.make(),
    }
  }
}

// A method remains a template when its owner has unsupplied type/row arguments, even if a
// signature trims an owner binder it does not mention. A named empty application cannot provide
// the missing owner environment for the analysis-only MIR closure.
fn declarationOpen(hir: &Module, declarations: &[IndexedDeclaration], ordinal: usize) -> bool {
  let mut current = Option<usize>.some(ordinal)
  while true {
    let at = match move current {
      Option<usize>.Some { value } => value
      _ => {
        return false
      }
    }
    let mut generics = Range.empty()
    match Module.node(hir, declarations[at].header) {
      Node.ImplHeader { generics: written, .. } => {
        generics = written
      }
      Node.FunctionHeader { contract, .. } => {
        if let Node.CallableContract { generics: written, .. } = Module.node(hir, contract) {
          generics = written
        }
      }
      Node.OperationHeader { contract, .. } => {
        if let Node.CallableContract { generics: written, .. } = Module.node(hir, contract) {
          generics = written
        }
      }
      Node.StructHeader { generics: written, .. } => { generics = written }
      Node.TupleHeader { generics: written, .. } => { generics = written }
      Node.UnionHeader { generics: written, .. } => { generics = written }
      Node.ServiceHeader { generics: written, .. } => { generics = written }
      // An interface operation's default body is open over the interface's implicit `Self`.
      Node.InterfaceHeader { .. } => {
        return true
      }
      Node.AliasHeader { generics: written, .. } => { generics = written }
      _ => ()
    }
    let mut parameter = usize.ZERO
    while parameter < generics.length {
      match Module.node(hir, Module.child(hir, generics, parameter)) {
        Node.TypeParameter { .. } => {
          return true
        }
        Node.RowParameter { .. } => {
          return true
        }
        _ => ()
      }
      parameter = parameter + usize.ONE
    }
    current = match &declarations[at].parent {
      Option<usize>.Some { value } => Option<usize>.some(value)
      _ => Option<usize>.none()
    }
  }
  return false
}

// The borrow status of a checked body answer, or `Checked` when the answer holds no body.
fn bodyAnswerBorrowStatus(answer: &Result<Answer, NoRejection>) -> BodyBorrowStatus {
  return match &answer.* {
    Result<Answer, NoRejection>.Success { value } => match &value.outcome {
      Outcome.Success { value: Value.Body { body } } => Shared<TypedBody>.with<BodyBorrowStatus>(&body, TypedBody.borrowStatus)
      _ => BodyBorrowStatus.Checked
    }
    _ => BodyBorrowStatus.Checked
  }
}

fn bodyAnswerPresent(answer: &Result<Answer, NoRejection>) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success { value } => match &value.outcome {
      Outcome.Success { value: Value.Body { .. } } => true
      _ => false
    }
    _ => false
  }
}

// A Body answer's `uncheckedReason`, `usize.MAX` for a borrow-checked body or any other answer.
fn bodyUnchecked(answer: &Result<Answer, NoRejection>) -> usize {
  return match &answer.* {
    Result<Answer, NoRejection>.Success { value } => match &value.outcome {
      Outcome.Success { value: Value.Body { body, .. } } => Shared<TypedBody>.with<usize>(&body, fn(checked: &TypedBody) -> usize {
        return uncheckedReason(TypedBody.borrowStatus(checked))
      })
      _ => usize.MAX
    }
    _ => usize.MAX
  }
}

// Records the body block at `block` of `module` under `reason`, unless it is borrow-checked.
effect fn recordUnchecked(bodies: &mut List<UncheckedBody>, module: &ModuleId, block: Span, reason: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if reason == usize.MAX { return () }
  run List<UncheckedBody>.append(&mut bodies.*, UncheckedBody {module: ModuleId.copy(module), block: block, reason: reason})
}

fn declarationMemberCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match &answer.* {
    Result<Answer, NoRejection>.Success { value } => match &value.outcome {
      Outcome.Success { value: Value.Members { members, .. } } => List<Member>.length(&members)
      _ => usize.ZERO
    }
    _ => usize.ZERO
  }
}


fn checkedConformanceHead(answer: &Result<Answer, NoRejection>) -> bool {
  let head = headOf(answer)
  return match move head {
    Option<Shared<ImplementationHead>>.Some {
      value
    } => Shared<ImplementationHead>.with<bool>(
      &value,
      fn(checked: &ImplementationHead) -> bool {
        return match &checked.kind {
          ImplementationKind.Conformance => true
          _ => false
        }
      }
    )
    _ => false
  }
}

// Whether each declaration one escape walk reached is an imported C declaration
// (`foreignDeclaration`). The walk reaches a declaration at every call of it, and reads its header
// once: a repeat would record the same reads against the same unit.
struct ForeignDeclarations {
  seen: List<ForeignDeclaration>,
  lookup: InternIndex,
}

struct ForeignDeclaration {
  identity: Shared<DeclarationId>,
  foreign: bool,
}

// `foreignDeclaration`, read once per declaration of one walk.
effect fn walkedForeign(resolver: &mut Resolver, walked: &mut ForeignDeclarations, instance: &InstanceKey) -> bool
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
  match &instance.* {
    InstanceKey.DropGlue {..} => { return false }
    InstanceKey.Helper {..} => { return false }
    _ => ()
  }
  let identity = InstanceKey.identity(instance)
  let hashed = Shared<DeclarationId>.with<u64>(&identity, DeclarationId.hash)
  let seen = List<ForeignDeclaration>.asSlice(&walked.seen)
  let mut at = InternIndex.first(&walked.lookup, hashed)
  while at != usize.MAX {
    if sameDeclarationShared(&seen[at].identity, &identity) { return seen[at].foreign }
    at = InternIndex.after(&walked.lookup, at)
  }
  let foreign = run foreignDeclaration(&mut resolver.*, instance)
  run List<ForeignDeclaration>.append(&mut walked.seen, ForeignDeclaration {identity: move identity, foreign: foreign})
  run InternIndex.record(&mut walked.lookup, hashed)
  return foreign
}

effect fn foreignDeclaration(resolver: &mut Resolver, instance: &InstanceKey) -> bool
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
  // Generated glue/helpers have no source function header. A sealed core's glue must never
  // request its compiler-owned identity from the source resolver.
  match &instance.* {
    InstanceKey.DropGlue { .. } => {
      return false
    }
    InstanceKey.Helper { .. } => {
      return false
    }
    _ => ()
  }
  let shared = InstanceKey.identity(instance)
  let declaration = DeclarationId.copyShared(&shared)
  let module = DeclarationId.moduleId(&declaration)
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, module, &shared) {
    Option<usize>.Some { value } => value
    _ => {
      return false
    }
  }
  let written = run header(&mut resolver.*, module, ordinal)
  if let Option<HeaderSyntax>.Some { value } = move written {
    if let Node.FunctionHeader { linkage, .. } = value.header {
      if linkage.present {
        let foreign = run foreignHeader(&mut resolver.*, module, ordinal)
        return !foreign.exported
      }
    }
  }
  return false
}

effect fn checkedAggregateApplication(
  resolver: &mut Resolver,
  query: &mut Query<Answer, NoRejection>,
  moduleOrdinal: usize,
  declaration: usize,
  span: Span
) -> Result<usize, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let template = run templateBinders(&mut resolver.*, &module, declaration)
  let mut binders = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success { value } => move value
    Result<List<Binder>, Shared<Rejection>>.Failure { error } => {
      return Result<usize, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut dependencies = List<Dependency>.make()
  let incomplete = run completeApplicationBinders(
    &mut resolver.*,
    &mut query.*,
    &mut dependencies,
    moduleOrdinal,
    &module,
    declaration,
    span,
    &mut binders
  )
  if let Option<Shared<Rejection>>.Some { value } = move incomplete {
    return Result<usize, Shared<Rejection>>.failResult(move value)
  }
  let identity = match move run declarationAt(&mut resolver.*, &module, declaration) {
    Option<DeclarationId>.Some { value } => move value
    _ => {
      return Result<
        usize,
        Shared<Rejection>
      >.failResult(run reject(&resolver.*, &module, RejectionCode.UnknownName, span))
    }
  }
  let arguments = run ownedArguments(
    &identity,
    List<Binder>.asSlice(&binders),
    List<Shared<Lifetime>>.asSlice(&List<Shared<Lifetime>>.make())
  )
  let written = run scopedHeader(&mut resolver.*, &module, declaration)
  let isPublic = match move written {
    Option<HeaderSyntax>.Some { value } => genericOwnerPublic(value.header)
    _ => false
  }
  let application = run Types.intern(
    Type.Nominal { declaration: move identity, isPublic: isPublic, arguments: move arguments }
  )
  return Result<
    usize,
    Shared<Rejection>
  >.succeed(run internApplication(&mut resolver.*, &application))
}

effect fn appendCheckedModule(modules: &mut List<usize>, ordinal: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = List<usize>.asSlice(&modules.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == ordinal {
      return ()
    }
    at = at + usize.ONE
  }
  return run List<usize>.append(&mut modules.*, ordinal)
}

struct DeclarationRejectionSite {
  code: RejectionCode,
  module: ModuleId,
  span: Span,
  related: Option<RelatedSite>,
}

fn declarationRejectionSite(rejection: &Rejection) -> DeclarationRejectionSite {
  let related = match &rejection.related {
    Option<RelatedSite>.Some { value } => Option<RelatedSite>.some(RelatedSite {
      module: ModuleId.copy(&value.module), span: value.span
    })
    _ => Option<RelatedSite>.none()
  }
  return DeclarationRejectionSite {
    code: rejection.code, module: ModuleId.copy(&rejection.module), span: rejection.span,
    related: move related
  }
}

fn sameDeclarationRejection(left: &DeclarationRejectionSite, right: &DeclarationRejectionSite) -> bool {
  if left.code != right.code || !sameSpan(left.span, right.span)
    || !ModuleId.equals(&left.module, &right.module) {
    return false
  }
  return match &left.related {
    Option<RelatedSite>.None => match &right.related {
      Option<RelatedSite>.None => true
      _ => false
    }
    Option<RelatedSite>.Some { value: earlier } => match &right.related {
      Option<RelatedSite>.Some {
        value: compared
      } => sameSpan(earlier.span, compared.span)
        && ModuleId.equals(&earlier.module, &compared.module)
      _ => false
    }
  }
}

// Whether `moved` is a refusal of another package's body moved to the call that requested it
// (`requestedRejection`) while `own` reports that same refusal at its own site: the other package's
// body is wrong whatever the call, so the refusal is reported once, where it is.
fn relocatedCopy(moved: &DeclarationRejectionSite, own: &DeclarationRejectionSite) -> bool {
  if moved.code != own.code { return false }
  if let Option<RelatedSite>.Some {..} = &own.related { return false }
  return match &moved.related {
    Option<RelatedSite>.Some {value: site} => sameSpan(site.span, own.span) && ModuleId.equals(&site.module, &own.module)
      && !ModuleId.samePackage(&moved.module, &site.module)
    Option<RelatedSite>.None => false
  }
}

effect fn appendDeclarationRejection(
  found: &mut List<Shared<Rejection>>,
  rejection: Shared<Rejection>
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let candidate = Shared<Rejection>.with<DeclarationRejectionSite>(&rejection, declarationRejectionSite)
  let mut scan = usize.ZERO
  while scan < List<Shared<Rejection>>.length(&found.*) {
    let known = Shared<Rejection>.with<DeclarationRejectionSite>(&List<Shared<Rejection>>.asSlice(&found.*)[scan],
      declarationRejectionSite)
    if relocatedCopy(&candidate, &known) { return () }
    if relocatedCopy(&known, &candidate) {
      drop List<Shared<Rejection>>.remove(&mut found.*, scan)
    } else {
      scan = scan + usize.ONE
    }
  }
  let listed = List<Shared<Rejection>>.asSlice(&found.*)
  let mut at = usize.ZERO
  while at < listed.length {
    // Unavailable answers that share an owner report that owner's same allocations, and keys that
    // re-derive a diagnostic at one site report equal ones; each is listed once. Shared.with
    // access is exclusive even for inspection, so recognize aliases before nesting payloads.
    if sameAllocation<Rejection>(&rejection, &listed[at]) {
      return ()
    }
    let known = Shared<Rejection>.with<DeclarationRejectionSite>(&listed[at], declarationRejectionSite)
    if sameDeclarationRejection(&candidate, &known) {
      return ()
    }
    at = at + usize.ONE
  }
  return run List<Shared<Rejection>>.append(&mut found.*, move rejection)
}

effect fn appendDeclarationAnswer(
  found: &mut List<Shared<Rejection>>,
  store: &mut Query<Answer, NoRejection>,
  answer: &Shared<Result<Answer, NoRejection>>
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let reported = run reportedDiagnostics(&mut store.*, answer)
  let listed = List<Shared<Rejection>>.asSlice(&reported)
  let mut at = usize.ZERO
  while at < listed.length {
    run appendDeclarationRejection(&mut found.*, Shared<Rejection>.clone(&listed[at]))
    at = at + usize.ONE
  }
  return ()
}

struct CheckedGapSite {
  code: GapCode,
  module: ModuleId,
  span: Span,
  kind: usize,
  declaration: Option<DeclarationId>,
}

fn checkedGapSite(gap: &BackendGap) -> CheckedGapSite {
  return match &gap.source {
    GapSource.Declaration { declaration, span } => {
      let identity = DeclarationId.copyShared(&declaration)
      return CheckedGapSite {code: gap.code, module: ModuleId.copy(DeclarationId.moduleId(&identity)),
        span: span, kind: usize.ZERO, declaration: Option<DeclarationId>.none()}
    }
    GapSource.Diagnostic { diagnostic } => {
      let module = Shared<Rejection>.with<ModuleId>(&diagnostic,
        fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
      return CheckedGapSite {code: gap.code, module: move module, span: BackendGap.span(gap),
        kind: usize.ZERO, declaration: Option<DeclarationId>.none()}
    }
    GapSource.Generated { declaration } => {
      let identity = DeclarationId.copyShared(&declaration)
      return CheckedGapSite {code: gap.code, module: ModuleId.copy(DeclarationId.moduleId(&identity)),
        span: Span.make(usize.ZERO, usize.ZERO), kind: usize.ONE,
        declaration: Option<DeclarationId>.some(move identity)}
    }
    GapSource.Relative { declaration, location } => {
      let identity = DeclarationId.copyShared(&declaration)
      return CheckedGapSite {code: gap.code, module: ModuleId.copy(DeclarationId.moduleId(&identity)),
        span: Span.make(location.start, location.end), kind: 2,
        declaration: Option<DeclarationId>.some(move identity)}
    }
  }
}

// A body and its MIR/callers can forward one coverage failure. Copy its primary site before
// inspecting another gap: their source diagnostic handles can alias the same Shared allocation.
effect fn appendDeclarationGap(
  found: &mut List<Shared<BackendGap>>,
  gap: Shared<BackendGap>
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let site = Shared<BackendGap>.with<CheckedGapSite>(&gap, checkedGapSite)
  let listed = List<Shared<BackendGap>>.asSlice(&found.*)
  let mut at = usize.ZERO
  while at < listed.length {
    let same = Shared<BackendGap>.with<bool>(
      &listed[at],
      fn(known: &BackendGap) -> bool {
        let earlier = checkedGapSite(known)
        if earlier.code != site.code || earlier.kind != site.kind
          || !sameSpan(earlier.span, site.span) || !ModuleId.equals(&earlier.module, &site.module) {
          return false
        }
        if earlier.kind == usize.ZERO { return true }
        return match &earlier.declaration {
          Option<DeclarationId>.Some { value: left } => match &site.declaration {
            Option<DeclarationId>.Some { value: right } => DeclarationId.equals(&left, &right)
            _ => false
          }
          _ => false
        }
      }
    )
    if same {
      return ()
    }
    at = at + usize.ONE
  }
  return run List<Shared<BackendGap>>.append(&mut found.*, move gap)
}

// Typed Body and MIR refusals preserve the existing named backend-gap classification. Every
// other diagnostic remains a source rejection; no failed query is treated as a checked body.
effect fn appendCheckedAnswer(
  found: &mut List<Shared<Rejection>>,
  gaps: &mut List<Shared<BackendGap>>,
  store: &mut Query<Answer, NoRejection>,
  declaration: &DeclarationId,
  answer: &Shared<Result<Answer, NoRejection>>
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let reported = run reportedDiagnostics(&mut store.*, answer)
  let listed = List<Shared<Rejection>>.asSlice(&reported)
  let mut at = usize.ZERO
  while at < listed.length {
    run appendCheckedRejection(&mut found.*, &mut gaps.*, declaration, Shared<Rejection>.clone(&listed[at]))
    at = at + usize.ONE
  }
  if listed.length > usize.ZERO {
    return ()
  }
  let gap = Shared<
    Result<Answer, NoRejection>
  >.with<Option<Shared<BackendGap>>>(answer, answerBackendGap)
  if let Option<Shared<BackendGap>>.Some { value } = move gap {
    return run appendDeclarationGap(&mut gaps.*, move value)
  }
  return ()
}

// A typed Body or MIR refusal keeps its named backend-gap classification; every other diagnostic
// stays a source rejection.
effect fn appendCheckedRejection(
  found: &mut List<Shared<Rejection>>,
  gaps: &mut List<Shared<BackendGap>>,
  declaration: &DeclarationId,
  value: Shared<Rejection>
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let code = Shared<
    Rejection
  >.with<RejectionCode>(
    &value,
    fn(diagnostic: &Rejection) -> RejectionCode {
      return diagnostic.code
    }
  )
  let gap = BackendGap.forRejection(code)
  if let Option<GapCode>.Some { value: reason } = move gap {
    return run appendDeclarationGap(
      &mut gaps.*,
      run Shared<
        BackendGap
      >.make(
        BackendGap.fromRejection(
          reason,
          &run Shared<DeclarationId>.make(DeclarationId.copy(declaration)),
          &value
        )
      )
    )
  }
  return run appendDeclarationRejection(&mut found.*, move value)
}

impl Copy for HeaderSyntax {}

struct PathSyntax {
  segments: List<Bytes>,
  span: Span,
  valid: bool,
}

struct WrittenSignature {
  foreign: bool,
  isVariadic: bool,
  generics: Range,
  parameters: List<HirId>,
  // The whole authored `name: Type` span of each accepted parameter, parallel to `parameters`.
  parameterSpans: List<Span>,
  // The authored parameter named `self`; only its outer borrow supplies a result default.
  receiver: Option<usize>,
  result: Option<HirId>,
  failures: HirRef,
  requirements: HirRef,
  environment: RangeRef,
  // The written `where` clauses; only `provides` clauses are supported.
  constraints: Range,
  isEffect: bool,
  /// Whether the function is written `test fn`, so failure advice names `test effect fn`.
  isTest: bool,
  isUnsafe: bool,
  isStatic: bool,
  isPublic: bool,
  supported: bool,
  span: Span,
  // The original indices of `static` parameters of a runtime function.
  staticSlots: List<usize>,
  // The first rejected header form: an invalid `test` entry (TEST-001) or a `mut` parameter of an
  // interface or service operation (OWN-005).
  headerConflict: Option<HeaderConflict>,
}

struct HeaderConflict {
  code: RejectionCode,
  span: Span,
  // The catalog template's filled holes, when the conflict names a value.
  arguments: List<MessageArgument>,
}

// A header conflict that fills no template hole.
fn conflictAt(code: RejectionCode, span: Span) -> Option<HeaderConflict> {
  return Option<HeaderConflict>.some(HeaderConflict {code: code, span: span, arguments: List<MessageArgument>.make()})
}

// A header conflict that fills one template hole.
effect fn namedHeaderConflict(code: RejectionCode, span: Span, hole: &[u8], value: &[u8]) -> Option<HeaderConflict>
! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(hole), value: run Bytes.copy(value)})
  return Option<HeaderConflict>.some(HeaderConflict {code: code, span: span, arguments: move arguments})
}

// A C-linked function header that retains Silk-only `restriction` syntax (SEM0188), worded for an
// imported foreign declaration or an `export "C"` definition.
effect fn linkageRestriction(span: Span, imported: bool, restriction: &[u8]) -> Option<HeaderConflict>
! OutOfMemoryError ? &mut Allocator {
  let mut declaration = b"A foreign function declaration"
  if !imported { declaration = b"An `export \"C\"` function" }
  let mut arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"declaration"), value: run Bytes.copy(declaration)})
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"restriction"), value: run Bytes.copy(restriction)})
  return Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.ForeignDeclarationRestriction, span: span, arguments: move arguments})
}

union Binder {
  Type {name: Bytes, value: Shared<Type>},
  Lifetime {name: Bytes, value: Shared<Lifetime>},
  // `bound` is the row supplied by an application; an unapplied binder stays a row parameter.
  Row {name: Bytes, value: RowParameter, bound: Option<Shared<Row>>},
}

struct LifetimeElision {
  owner: Option<DeclarationId>,
  nextOrdinal: usize,
  output: bool,
  resultDefault: Option<Shared<Lifetime>>,
  generated: List<Shared<Lifetime>>,
  // Inside a callable contract, an omitted input lifetime is a fresh invocation binder.
  invocation: bool,
  // Inside an invocation-quantified contract, a further quantifier is outside the language.
  nested: bool,
  // Maps a provisional invocation ordinal to its canonical first-occurrence ordinal; empty when
  // the provisional numbering is already canonical.
  renumber: List<usize>,
  // Set only while resolving the `Effect` result of a function with no parameters, whose omitted
  // environment is `'static`. The first environment elided under it consumes it.
  staticEnvironment: bool,
  // Arguments for declaration-owned elided lifetimes in an instantiated signature.
  supplied: Option<List<Argument>>,
  // Bounds already declared by the enclosing generic declaration while resolving its body.
  assumptions: Option<List<Constraint>>,
  // Set only while a declaration resolves its own bounds: the bounds of a declaration applied
  // there wait for all of its premises, inline or in its `where` clause, in any order.
  deferred: Option<List<DeferredBounds>>,
}

// An applied declaration's bounds, proved once the enclosing declaration's premises are complete.
struct DeferredBounds {
  bounds: List<Constraint>,
  module: ModuleId,
  span: Span,
}

// Proves the applied bounds deferred while a declaration resolved its own bounds, under all of them.
effect fn proveDeferredBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  elision: &mut LifetimeElision,
  constraints: &List<Constraint>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Option<List<DeferredBounds>>.Some {value: pending} = &elision.deferred {
    let waiting = List<DeferredBounds>.asSlice(&pending)
    let mut at = usize.ZERO
    while at < waiting.length {
      let failure = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, constraints,
        List<Constraint>.asSlice(&waiting[at].bounds), &waiting[at].module, waiting[at].span, RegionProof.Typing)
      if let Option<Shared<Rejection>>.Some {value} = move failure { return Option<Shared<Rejection>>.some(move value) }
      at = at + usize.ONE
    }
  }
  elision.deferred = Option<List<DeferredBounds>>.none()
  return Option<Shared<Rejection>>.none()
}

struct Channels {
  failure: Shared<Type>,
  requirements: Shared<Row>,
}

struct TypeSelection {
  resolved: Option<Shared<Type>>,
  rejected: Option<Shared<Rejection>>,
}

struct ResolvedAnnotation {
  id: HirId,
  result: Result<Shared<Type>, Shared<Rejection>>,
}

struct ImportSelection {
  module: Option<usize>,
  declaration: Option<usize>,
  rejected: Option<Shared<Rejection>>,
}

struct SelectedDeclaration {
  module: usize,
  ordinal: usize,
}

// Written slots retain their authentic owner when a member opens enclosing binders.
union CallPrefixSlot {
  Type {value: Shared<Type>},
  Lifetime {value: Shared<Lifetime>},
  Row {value: RowParameter},
}

struct CallTarget {
  foreign: bool,
  declaration: DeclarationId,
  isPublic: bool,
  signature: Shared<Result<Answer, NoRejection>>,
  explicit: List<Argument>,
  // The authentic binder each argument fixes; unwritten leading lifetimes are inferred.
  explicitSlots: List<CallPrefixSlot>,
  prefixOwner: Option<Shared<DeclarationId>>,
  prefixLifetimes: usize,
  scopeArguments: List<Argument>,
  inferOwner: bool,
  explicitSyntax: bool,
}

// A receiver call's adapted receiver, supplied as argument zero of its selected declaration. A
// bound method value supplies only the receiver and leaves the other parameters open (CALL-003).
struct CallReceiver {
  node: BodyNodeId,
  pass: BodyReceiverPass,
  subject: HirId,
  memberSpan: Span,
  bound: bool,
  // The receiver supplies the owner's binders by inference, matched as the explicit argument it
  // stands for: the `&place` loan of an implicit borrow, or the value it takes.
  open: bool,
}

// A written call prefix and its private templates for omitted body regions.
struct CallPrefix {
  arguments: List<Argument>,
  slots: List<CallPrefixSlot>,
  owner: Option<Shared<DeclarationId>>,
  lifetimes: usize,
}

fn emptyCallPrefix() -> CallPrefix {
  return CallPrefix {arguments: List<Argument>.make(), slots: List<CallPrefixSlot>.make(),
    owner: Option<Shared<DeclarationId>>.none(), lifetimes: usize.ZERO}
}

// Advisory positions for selecting a named callable, separate from a concrete expected type.
// The pending owner is the consumer call's private inference identity, never the target's.
struct NamedCallableEvidence {
  contract: Shared<Type>,
  pending: Option<DeclarationId>,
  /// The enclosing call, when the contract depends on binders that call infers rather than writes.
  /// An invocation region escaping such a contract is the call's unsatisfied lifetime relation.
  call: Option<Span>,
}

// A selected body's static result for one authored syntax node. The checker consumes these
// facts; it never evaluates static work itself.
union SelectionFact {
  // A static value used at runtime at its exact type: a `let static` read or static-helper call.
  Embedded {value: Shared<StaticData>, ty: Shared<Type>},
  // The evaluated condition of one static conditional.
  Condition {selected: bool},
  // A `let static` statement and its value, which has no runtime local.
  StaticBinding {value: Shared<StaticData>},
  // A call to a runtime function with `static` parameters: the values the selection pass
  // evaluated for them, at the callee's original parameter indices.
  StaticArguments {slots: Shared<List<StaticSlot>>},
  StaticFor {iterations: Shared<List<IterationFacts>>},
}

struct IterationFacts {
  ordinal: usize,
  calls: List<ResolvedCall>,
}

// An authored name resolves to a source function, a constant, a sealed primitive, or a selected
// body's static fact.
union ResolvedTarget {
  Function {target: CallTarget},
  Constant {declaration: DeclarationId, ty: Shared<Type>},
  /// An imported C static read by value, with its admitted scalar or pointer type.
  ForeignStatic {declaration: DeclarationId, ty: Shared<Type>},
  Intrinsic {member: IntrinsicMember, typeArguments: List<Shared<Type>>},
  /// A sealed Effect composition intrinsic and its written type and row arguments.
  Composition {operation: Composition, written: List<Argument>},
  /// A sealed core storage primitive and its written type arguments.
  Storage {operation: StorageOperation, typeArguments: List<Shared<Type>>},
  Tuple {ty: Shared<Type>, elements: List<Shared<Type>>},
  Selected {fact: SelectionFact},
}

// A selected static operation. The caller uses the contract signature, while `implementation`
// names the concrete body required at runtime; a declared bound has no concrete body yet, and a
// scalar intrinsic witness runs in place without one.
struct OperationCall {
  operation: DeclarationId,
  implementation: Option<Shared<DeclarationId>>,
  signature: Shared<Result<Answer, NoRejection>>,
  proof: ConformanceProof,
  receiver: Option<ReceiverPosition>,
}

struct OperatorCandidate {
  contract: Shared<Type>,
  provider: Shared<Type>,
  operationModule: usize,
  operationOrdinal: usize,
}

struct SelectedOperator {
  contract: Shared<Type>,
  provider: Shared<Type>,
  call: OperationCall,
}

// Duplicate bound spellings or the same head observed from two permitted owner buckets still
// name one supplier. Coherence of that exact goal is checked by the common proof after selection.
effect fn addOperatorCandidate(
  suppliers: &mut List<OperatorCandidate>,
  choice: &mut CallSelection,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operationModule: usize,
  operationOrdinal: usize,
) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = List<OperatorCandidate>.asSlice(&suppliers.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].operationModule == operationModule && listed[at].operationOrdinal == operationOrdinal {
      let sameContract = run Type.equalsShared(&listed[at].contract, contract)
      let sameProvider = run Type.equalsShared(&listed[at].provider, provider)
      if sameContract && sameProvider {
        return ()
      }
    }
    at = at + usize.ONE
  }
  let ordinal = List<OperatorCandidate>.length(&suppliers.*)
  run List<OperatorCandidate>.append(
    &mut suppliers.*,
    OperatorCandidate {
      contract: Shared<Type>.clone(contract),
      provider: Shared<Type>.clone(provider),
      operationModule: operationModule,
      operationOrdinal: operationOrdinal,
    },
  )
  CallSelection.add(&mut choice.*, ordinal)
  return ()
}

struct ReceiverPosition {
  ordinal: usize,
  mode: BodyReceiverPass,
}

struct MethodSupplier {
  contract: Shared<Type>,
  operationModule: usize,
  operationOrdinal: usize,
  receiver: ReceiverPosition,
}

struct SelectedReceiverOperation {
  contract: Shared<Type>,
  call: OperationCall,
}

union ReceiverCallChoice {
  Inherent {target: CallTarget, receiver: ReceiverPosition},
  Interface {selected: SelectedReceiverOperation},
}

struct VisibleName {
  module: usize,
  name: Bytes,
  external: bool,
}

struct VisibleInterface {
  module: usize,
  ordinal: usize,
}

union InherentCallChoice {
  Missing,
  Claimed,
  Selected {target: CallTarget, receiver: Option<ReceiverPosition>},
}

impl Copy for ReceiverPosition {}

union CallReference {
  Named {name: Bytes},
  // A value read with no local binding. Functions construct exact environments; constants
  // remain available only to static bodies.
  Unbound {name: Bytes},
  Qualified {namespace: Bytes, member: Bytes, subjectSpan: Span, memberSpan: Span, application: HirRef},
  NonCallable,
  CallableValue,
  Unsupported,
}

struct CallSyntax {
  exactItem: bool,
  // Value reads preserve foreign/constant admission even when qualified by a namespace or type.
  value: bool,
  pipeline: bool,
  id: HirId,
  span: Span,
  reference: CallReference,
  generics: HirRef,
}

struct ResolvedCall {
  id: HirId,
  result: Result<ResolvedTarget, Shared<Rejection>>,
}

struct PreparedBody {
  block: HirId,
  identity: DeclarationId,
  locals: List<BodyLocal>,
  contractBody: bool,
  staticBody: bool,
}

struct QualifiedBodyName {
  // Whether the applied qualifier names a public declaration of Intrinsic.
  intrinsic: bool,
  namespace: Bytes,
  member: Bytes,
  subjectSpan: Span,
  application: Option<HirId>,
}

// The enclosing statement context an expression needs to check a block-bodied match arm: arm
// locals join the body's locals, and return, break and continue keep their enclosing targets.
struct StatementScope<'scope> {
  locals: &'scope mut List<BodyLocal>,
  annotations: &'scope [ResolvedAnnotation],
  resultType: &'scope Shared<Type>,
  loopDepth: usize,
  staticBinders: &'scope [StaticRootBinder],
  staticValues: &'scope [StaticBinding],
  // The expression whose value its statement discards, if the statement is an expression
  // statement: a `match` there is a statement whose arm blocks yield nothing.
  discarded: HirRef,
}

struct CheckedControl {
  node: BodyNodeId,
  canComplete: bool,
}

// Effective bindings and exact registration for one unpublished defaults graph.
struct ParameterAssembly {
  parameters: List<DeclarationId>,
  bindings: List<ProfileEntry>,
}

fn replaceAssemblyValues(assembly: &mut ParameterAssembly, values: List<ProfileEntry>) -> () {
  assembly.*.bindings = move values
  return ()
}

// Deferred identity transitions keep source loading at its demand boundary. Each intermediate
// observation matters: deleting and reintroducing a declaration cannot revive its old handle.
struct DeclarationChange {
  module: ModuleId,
  ordinal: usize,
  previous: Option<ModuleIndex>,
  observations: List<Observation>,
}

struct Resolver {
  staticDemandDepth: usize,
  staticDemandLimit: usize,
  // The receiver call whose static arguments the body being checked found no selection for: its
  // Body query selects again with it (`resolveBody`).
  discoveredStaticCall: Option<StaticCallHint>,
  source: SourceIndex,
  baseTarget: MachineTarget,
  target: MachineTarget,
  initialProfile: Option<FinalProfile>,
  assemblyFacts: Option<InitialProfile>,
  parameterAssembly: Option<ParameterAssembly>,
  nextAssembly: usize,
  /// The composition's execution-storage component, which suspendable frames use (SUSP-005).
  executionStorage: Option<ExecutionStorage>,
  /// The composition's explicit retention roots (ARTIFACT-003), in manifest order.
  retention: List<RetentionRoot>,
  /// Whether checked bodies keep the names they resolve for an editor (`selectEditorTables`).
  editorTables: bool,
  /// The discovery root of a test build and its package-relative module directory (TEST-003).
  discovery: Option<Discovery>,
  /// The dependency names of every package in the build, which turn import paths into modules.
  packages: PackageGraph,
  profiles: List<FinalProfile>,
  profileSlot: usize,
  mirValues: List<MirFunction>,
  // Which lowered functions `releaseStaleMir` emptied, by index, and how many.
  mirReleased: List<bool>,
  mirReleasedCount: usize,
  layoutValues: List<Shared<BackendLayout>>,
  // The instance-text content of each layout value, encoded on first supply; empty until then.
  layoutContents: List<Bytes>,
  // The C objects the current artifact build defines for its exported statics (FFI-005).
  exportedObjects: List<ExportedObject>,
  // The C declaration each exported function root would print as an import of its own symbol.
  exportedFunctions: List<LlvmCode.Declaration>,
  emissionInputs: List<EmissionInputs>,
  llvmInputs: List<LlvmInput>,
  llvmValues: List<InstanceDefinition>,
  // Whether an assembled module is also split into codegen units.
  codegenUnits: bool,
  // Whether LLVM text is shaped for an unoptimized compile (`LlvmCode.Writer.fastPath`).
  fastPathIr: bool,
  // Whether an assembled module is split into packs for a cache to store beside its image
  // (`Semantic.offerPacks`), the bodies offered, and the packs of the image an adoption read that
  // claimed one.
  packing: bool,
  offeredBodies: List<BuildRecord.PackBody>,
  packs: List<HeldPack>,
  // Each interned table below keeps its lookup beside it, so interning never scans the table.
  modules: List<ModuleId>,
  moduleLookup: InternIndex,
  declarations: DeclarationTable.DeclarationTable,
  sourceInputs: SourceInputs,
  declarationChanges: List<DeclarationChange>,
  names: StringTable,
  applications: List<Shared<Type>>,
  applicationLookup: InternIndex,
  // Types interned up to lifetime erasure. Layout and PhaseOnly keys name a type by its position
  // here, since neither answer depends on a region.
  erasedTypes: List<Shared<Type>>,
  erasedTypeLookup: InternIndex,
  // Every handle already interned there, by allocation address. Each entry holds its handle, so
  // an address names one live allocation for as long as the resolver.
  erasedHandles: List<ErasedHandle>,
  erasedHandleLookup: InternIndex,
  // Header fingerprints of signature content, by module, declaration and source revision.
  headerFingerprints: List<HeaderFingerprint>,
  headerFingerprintLookup: InternIndex,
  // Whether each static function's body reads its argument values, by module, declaration and
  // source revision.
  staticReads: List<StaticReads>,
  staticReadsLookup: InternIndex,
  // Per module, family selector and source revision: declaration ordinals or names a whole-module
  // scan found, so a query asked once per type or per call does not rescan the module.
  moduleScans: List<ModuleScan>,
  moduleScanLookup: InternIndex,
  backendInstances: List<BackendInstance>,
  // The modules, by ordinal, whose source the loader read and found to declare no foreign claim
  // (`claimsForeignSymbols`), so `foreignClaims` need not read them. Cleared on a new revision.
  claimFree: List<bool>,
  backendInstanceLookup: InternIndex,
  // Semantic applications of selected bodies; a Body key's member is one plus this index.
  originEvidence: List<CallableOrigin.Producer>,
  originPlans: List<CallableOrigin.Plan>,
  selectedApplications: List<Application>,
  selectedApplicationLookup: InternIndex,
  llvmInputLookup: InternIndex,
  keys: List<ScopedKey>,
  keyLookup: InternIndex,
  // The request-selected application module ordinal, or MAX when no binding was supplied.
  currentApplication: usize,
  active: List<Word>,
  // What the units of a revisable store consumed. A one-shot store records nothing into it.
  graph: DependencyGraph,
  // Demands, memo hits among them, and units run, counted in every store.
  demands: usize,
  hits: usize,
  runs: usize,
  // Query lifecycle events, recorded only by a traced store; every demand, hit included, adds one.
  tracing: bool,
  events: List<Event>,
  // Why each outdated unit failed verification while the store is traced: the unit, then the
  // dependee that changed.
  staleCauses: List<StaleCause>,
  // Never published; separates nested inference transactions within this resolver.
  nextInferenceId: usize,
  // Set while a section's arguments are checked: the region check does not relate a section's bound
  // regions to its captured loans, so caller-local invariant regions stay exact there.
  exactLocalRegions: bool,
  // The checking frame of each body being checked, innermost last.
  bodies: List<BodyFrame>,
  // Where a command-line build reports how far checking and emission have come; off otherwise.
  progress: Progress,
  // Whether lowered MIR is checked for uses after drop before it is stored. Only tests and CI
  // turn it on: a defect it finds is a compiler bug, never a verdict on the program.
  verifyMir: bool,
  // The module check unit whose root demands and reads are recorded while no provider runs, or
  // `usize.MAX`. A provider's own unit records its demands as usual.
  rootRecorder: usize,
  // The unit run in progress, numbered by `runs` when it began; zero while no unit runs.
  currentRun: usize,
  // Each function body's resolved annotations and calls (`Family.BodyFacts`), until its checking
  // takes them, and its slot here by dense declaration handle, or `usize.MAX`. A rerun refills its
  // declaration's slot.
  bodyFacts: List<Option<BodyFacts>>,
  bodyFactsSlots: List<usize>,
  // The implied-bound walks shared by every unit of this revision (`signatureImpliedBounds`), by
  // signature address, owing and request scope, and the revision they belong to. An update drops
  // them with the answers they read.
  impliedWalks: List<ImpliedWalk>,
  impliedLookup: InternIndex,
  impliedRevision: u32,
  // The walks of the unit runs in progress whose demand path a walk may read, innermost last. Each
  // run reads only its own and drops them when it ends.
  runWalks: List<ImpliedWalk>,
  // How many running units' answers depend on more of the demand path than their own scoped key:
  // static-if conditions, callable origins and their transactions, and applied bodies.
  pathFrames: usize,
  // How many answers read the demand path itself (cycle answers, active producer checks); a walk
  // that met one is not shared.
  pathReads: usize,
}

// One implied-bound walk: the run that made it (zero when shared), the request scope it ran under,
// the signature it read, retained so its address names that signature while the walk is kept,
// whether a call owes the bounds, what the walk found, and the answer edges and graph records its
// unit made, which a unit reusing the walk makes again.
struct ImpliedWalk {
  unitRun: usize,
  application: usize,
  profile: usize,
  signature: Shared<Result<Answer, NoRejection>>,
  owed: bool,
  bounds: List<Constraint>,
  dependencies: List<Dependency>,
  recorded: List<Dependee>,
}

// One body being checked. Its channels are what a `run` or `fail` in the body may use (EFF-006,
// FAIL-003); an `effect {}` block without an expected contract derives them from its body instead
// (EFF-002, EFF-011).
struct BodyFrame {
  /// Whether the body is an `effect fn`; only such a body may `fail` (FAIL-002).
  isEffect: bool,
  /// Whether the body is a `test fn`, so failure advice names `test effect fn`.
  isTest: bool,
  failure: Shared<Type>,
  requirements: Shared<Row>,
  derived: Option<DerivedChannels>,
  occurrences: List<StaticIteration>,
  staticApplication: Option<Application>,
  staticPrefixes: List<List<StaticPrefixWork>>,
  /// Diagnostics a recovering construct reported before checking went on. Every one belongs to a
  /// body that fails: the construct that recorded it still fails its own check.
  recovered: List<Shared<Rejection>>,
  /// The statements of this body that failed and were recovered past. A binder inside one has no
  /// local, and a read of it fails as `UnavailableBinding` instead of reporting a cascade.
  failedStatements: List<FailedStatement>,
  /// The calls of this body whose result-only binder shortened to its outlives bound
  /// (`outlivesShortenedBinders`). Their binding is admitted only when the borrow check proves the
  /// whole body; otherwise each call keeps its unshortened bound refusal (SEM0212).
  shortened: List<Span>,
  /// A declaration body's own signature, whose implied bounds the region checks of its anonymous
  /// bodies assume (`rootBodySignature`); none for every other frame.
  signature: Option<Shared<Result<Answer, NoRejection>>>,
  /// Whether this frame begins a body of its own: a declaration's body or a static root. A frame
  /// nested in it (a callable literal, an Effect block) reads its failed statements; a frame of
  /// another body pushed above it never does.
  root: bool,
  /// The operand of the `run` being checked in this frame, if any: a call at it is consumed in
  /// place, so its Effect never outlives the call (`runsInPlace`).
  runOperand: Option<HirId>,
  /// A declaration body's own source, where a diagnostic finds the spelling of a type parameter
  /// (`spellParameters`); none for every other frame.
  naming: Option<AuthoredCursor>,
}

// A recovered statement's module and source span.
struct FailedStatement {
  module: ModuleId,
  span: Span,
}

// What one deriving `effect {}` body returns, fails with and runs.
struct DerivedChannels {
  returns: List<Shared<Type>>,
  // The type of each `fail` operand, as written.
  failed: List<Shared<Type>>,
  // Every failure member from `fail` and `run` sites.
  failures: List<Shared<Type>>,
  requirements: Row,
}

// Whether the selected target and profile admit an architecture operation (SIMD-007). Without a
// selected profile only the architecture is checked; the backend never runs without one.
fn archAdmitted(resolver: &Resolver, signature: CheckedIntrinsic.ArchSignature, listed: &[Bytes]) -> bool {
  if !same(resolver.target.architecture(), signature.architecture) { return false }
  return featureEnabled(&resolver.target, listed, signature.feature) || profileFeature(resolver, signature.feature)
}

// Whether the selected profile enables `feature`; true when no profile is selected.
fn profileFeature(resolver: &Resolver, feature: &[u8]) -> bool {
  let mut facts = Option<&InitialProfile>.none()
  if let Option<&FinalProfile>.Some {value} = move selectedProfile(resolver) {
    facts = Option<&InitialProfile>.some(FinalProfile.facts(value))
  } else if let Option<InitialProfile>.Some {value} = &resolver.assemblyFacts {
    facts = Option<&InitialProfile>.some(&value)
  }
  return match move facts {
    Option<&InitialProfile>.Some {value} => match move InitialProfile.contains(value, b"cpu-features", feature) {
      Option<bool>.Some {value: enabled} => enabled
      Option<bool>.None => false
    }
    Option<&InitialProfile>.None => true
  }
}

fn selectedProfile<'a>(resolver: &'a Resolver) -> Option<&'a FinalProfile> {
  if resolver.profileSlot == usize.ZERO || resolver.profileSlot == usize.MAX {
    return Option<&FinalProfile>.none()
  }
  if resolver.profileSlot == usize.ONE {
    return match &resolver.initialProfile {
      Option<FinalProfile>.Some {value} => Option<&FinalProfile>.some(&value)
      Option<FinalProfile>.None => Option<&FinalProfile>.none()
    }
  }
  let profiles = List<FinalProfile>.asSlice(&resolver.profiles)
  let index = resolver.profileSlot - 2
  if index < profiles.length {
    return Option<&FinalProfile>.some(&profiles[index])
  }
  return Option<&FinalProfile>.none()
}

effect fn sameStoredProfile(resolver: &Resolver, candidate: &FinalProfile, slot: usize) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if slot == usize.ONE {
    if let Option<FinalProfile>.Some {value: initial} = &resolver.initialProfile {
      return run FinalProfile.sameIdentity(&initial, candidate)
    }
    return false
  }
  let known = List<FinalProfile>.asSlice(&resolver.profiles)
  let index = slot - 2
  if index < known.length {
    return run FinalProfile.sameIdentity(&known[index], candidate)
  }
  return false
}

struct Running<'a, 'b> {
  resolver: &'a mut Resolver,
  query: &'b mut Query<Answer, NoRejection>,
  key: Word,
  base: usize,
  /// The open body frames when this query began; any failed exit restores them.
  bodies: usize,
  /// The enclosing unit run, and how many implied-bound walks it held, restored on any exit.
  outerRun: usize,
  walks: usize,
  /// Whether this unit counts in `pathFrames`.
  pathFrame: bool,
}

/// The demand counters of one store, and its graph's counters when it records a graph.
pub struct Statistics {
  /// Every demand of a unit, memo hits included.
  pub demands: usize,
  /// The demands a completed answer served.
  pub hits: usize,
  /// The units run.
  pub runs: usize,
  /// The completed answers the store holds.
  pub answers: usize,
  /// The lowered MIR functions the store holds and has not released.
  pub mirFunctions: usize,
  /// The graph a revisable store records; a one-shot store has none.
  pub graph: Option<GraphCounters>,
}

/// A serial semantic store for one immutable in-memory revision.
///
/// # Details
///
/// Semantic rejections are completed answers. Provider failures leave a key available for retry.
/// This actor keeps query events and direct dependencies for later request replay.
pub struct Semantic {
  resolver: Resolver,
  query: Query<Answer, NoRejection>,
  deferredTemplates: List<DeferredStaticTemplate>,
  uncheckedRoot: List<UncheckedBody>,
  // The last completed sweep of each module and the last escape checks in a revisable store, by
  // their `ModuleCheck` units.
  moduleMemos: List<ModuleCheckMemo>,
  escapeMemos: List<EscapeMemo>,
  declarationMemos: List<DeclarationMemo>,
  // The memo of each declaration check unit, by unit.
  declarationSlots: List<usize>,
  pendingImage: Option<PendingImage>,
  // What `cacheImage` wrote for each replayed escape check that reports, for `imageReplayedChecks`.
  replayReports: List<ReplayReport>,
  // The module check units an unlinked cache adoption made current, which `cacheImage` leaves to
  // the image they came from, and the index of each one's root in that image.
  carriedUnits: List<usize>,
  carriedRoots: List<usize>,
  // How many module sweeps and escape checks this store ran rather than reused.
  checkRuns: usize,
  // The record of this store's last successful build walk, which `cacheImage` writes, and
  // whether it holds anything the image this store read does not.
  capturedBuild: Option<CapturedBuild>,
  freshBuild: bool,
  // The packs the last build's assembly described and reused.
  packedBuild: PackedBuild,
  // The build record an adoption read, until a build replays it (see `BuildRecord`).
  replay: Option<ReplayState>,
  // The build roots of the image an adoption read that the image `cacheImage` wrote last
  // carries over, by their index in that image.
  carriedBuild: List<usize>,
  // The escape walk records and green entries an unlinked adoption read, until a check replays or
  // replaces a record (see `replayEscapes`), and whether a replay lowered anything they lack.
  escapeImage: EscapeImage,
  freshEscapes: bool,
}

// What one module's sweep found, kept until its unit is no longer current.
struct ModuleCheckMemo {
  unit: usize,
  sweep: Sweep,
  deferred: List<DeferredStaticTemplate>,
  unchecked: List<UncheckedBody>,
}

// The check of one declaration of a module sweep that found nothing to report, kept until its
// unit is no longer current, so a sweep of its module after an edit elsewhere reuses it.
struct DeclarationMemo {
  // `usize.MAX` once the check is outdated.
  unit: usize,
  identity: DeclarationId,
  // Whether the declaration is a concrete body the module's escape check walks.
  concrete: bool,
  // Whether an unlinked `adoptCache` reused it, so the image written carries it.
  carried: bool,
}

// The escape check of one list of concrete bodies, kept until its unit is no longer current.
struct EscapeMemo {
  unit: usize,
  concrete: List<DeclarationId>,
  result: DeclarationCheckResult,
  // The record of the walk that found nothing to report, which `cacheImage` writes.
  captured: Option<CapturedBuild>,
  // For a replay, the unit that holds what it demanded, which the root of a replay that reports
  // rests on (`imageReplayedChecks`); `usize.MAX` otherwise.
  reads: usize,
}

// One escape walk record an adoption read: its check's stable unit key, its root in the image
// and the record's bytes.
struct EscapeRecordRoot {
  unit: Bytes,
  root: usize,
  answer: Bytes,
}

// The escape walk records an image holds whose guard reads are green, and its green escape
// entries by exact identity, each with its root in the image.
// Which entries of a replayed record name each entry among their references, built when a
// replay first needs another way to an entry than its parent (`replayOrphan`).
struct RecordReferrers {
  built: bool,
  // The referrers of entry `e` are `from[starts[e]..starts[e + 1]]`, each naming it at its
  // reference `positions` holds.
  starts: List<usize>,
  from: List<usize>,
  positions: List<usize>,
}

effect fn recordReferrers(entries: &[BuildRecord.Entry]) -> RecordReferrers ! OutOfMemoryError ? &mut Allocator {
  let mut starts = List<usize>.make()
  while List<usize>.length(&starts) <= entries.length { run List<usize>.append(&mut starts, usize.ZERO) }
  let mut at = usize.ZERO
  while at < entries.length {
    let references = List<BuildRecord.Reference>.asSlice(&entries[at].references)
    let mut reference = usize.ZERO
    while reference < references.length {
      let target = references[reference].target
      if target < entries.length {
        let counted = List<usize>.get(&starts, target + usize.ONE) + usize.ONE
        List<usize>.set(&mut starts, target + usize.ONE, counted)
      }
      reference = reference + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ONE
  while at <= entries.length {
    let summed = List<usize>.get(&starts, at) + List<usize>.get(&starts, at - usize.ONE)
    List<usize>.set(&mut starts, at, summed)
    at = at + usize.ONE
  }
  let total = List<usize>.get(&starts, entries.length)
  let mut from = List<usize>.make()
  let mut positions = List<usize>.make()
  let mut next = List<usize>.make()
  while List<usize>.length(&from) < total {
    run List<usize>.append(&mut from, usize.ZERO)
    run List<usize>.append(&mut positions, usize.ZERO)
  }
  at = usize.ZERO
  while at < entries.length {
    run List<usize>.append(&mut next, List<usize>.get(&starts, at))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < entries.length {
    let references = List<BuildRecord.Reference>.asSlice(&entries[at].references)
    let mut reference = usize.ZERO
    while reference < references.length {
      let target = references[reference].target
      if target < entries.length {
        let slot = List<usize>.get(&next, target)
        List<usize>.set(&mut from, slot, at)
        List<usize>.set(&mut positions, slot, reference)
        List<usize>.set(&mut next, target, slot + usize.ONE)
      }
      reference = reference + usize.ONE
    }
    at = at + usize.ONE
  }
  return RecordReferrers {built: true, starts: move starts, from: move from, positions: move positions}
}

// Whether `instance` applies generic, static or scope arguments, which a walk admits by the path
// it reaches the instance along.
fn specializedInstance(instance: &InstanceKey) -> bool {
  if let Option<Shared<Application>>.Some {value} = move InstanceKey.application(instance) {
    return Shared<Application>.with<bool>(&value, fn(applied: &Application) -> bool {
      return List<Argument>.length(&applied.arguments) > usize.ZERO || List<StaticSlot>.length(&applied.statics) > usize.ZERO
        || List<ScopeBinding>.length(&applied.scopes) > usize.ZERO
    })
  }
  return false
}

// The key of entry `index` of a replayed record when it is the entry of a root the walk still
// starts from; `entryRoots` names each entry's root.
fn replayRootKey(roots: &[Option<InstanceKey>], entryRoots: &[usize], index: usize) -> Option<InstanceKey> {
  let root = entryRoots[index]
  if root >= roots.length { return Option<InstanceKey>.none() }
  if let Option<InstanceKey>.Some {value} = &roots[root] { return Option<InstanceKey>.some(InstanceKey.copy(&value)) }
  return Option<InstanceKey>.none()
}

struct EscapeImage {
  records: List<EscapeRecordRoot>,
  entries: DigestSet,
  roots: List<usize>,
}

impl EscapeImage {
  fn make() -> EscapeImage {
    return EscapeImage {records: List<EscapeRecordRoot>.make(), entries: DigestSet.make(), roots: List<usize>.make()}
  }

  // The image root of the green entry named `exact`, or `usize.MAX`.
  fn entryRoot(self: &Self, exact: ContentHash) -> usize {
    let found = DigestSet.find(&self.entries, exact)
    if found == usize.MAX { return usize.MAX }
    return List<usize>.get(&self.roots, found)
  }

  // Takes the record of the check whose stable unit key is `unit`, if the image holds one.
  fn take(self: &mut Self, unit: &[u8]) -> Option<EscapeRecordRoot> {
    let held = List<EscapeRecordRoot>.asSlice(&self.records)
    let mut at = usize.ZERO
    while at < held.length {
      if same(Bytes.asSlice(&held[at].unit), unit) {
        return Option<EscapeRecordRoot>.some(List<EscapeRecordRoot>.remove(&mut self.records, at))
      }
      at = at + usize.ONE
    }
    return Option<EscapeRecordRoot>.none()
  }
}

// Byte strings by position, found through their hashes.
struct ExactSet {
  values: List<Bytes>,
  lookup: InternIndex,
}

impl ExactSet {
  fn make() -> ExactSet {
    return ExactSet {values: List<Bytes>.make(), lookup: InternIndex.make()}
  }

  // The position of `value`, or `usize.MAX`.
  fn find(self: &Self, value: &[u8]) -> usize {
    let values = List<Bytes>.asSlice(&self.values)
    let mut at = InternIndex.first(&self.lookup, InternIndex.hashBytes(0, value))
    while at != usize.MAX {
      if same(Bytes.asSlice(&values[at]), value) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  // Adds `value` unless it is held already; whether it was added.
  effect fn add(self: &mut Self, value: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
    if ExactSet.find(&self.*, value) != usize.MAX { return false }
    run InternIndex.record(&mut self.lookup, InternIndex.hashBytes(0, value))
    run List<Bytes>.append(&mut self.values, run Bytes.copy(value))
    return true
  }
}

// Digests by position, found through their hashes.
struct DigestSet {
  values: List<ContentHash>,
  lookup: InternIndex,
}

impl DigestSet {
  fn make() -> DigestSet {
    return DigestSet {values: List<ContentHash>.make(), lookup: InternIndex.make()}
  }

  // The position of `value`, or `usize.MAX`.
  fn find(self: &Self, value: ContentHash) -> usize {
    let values = List<ContentHash>.asSlice(&self.values)
    let mut at = InternIndex.first(&self.lookup, digestHash(value))
    while at != usize.MAX {
      if ContentHash.equals(values[at], value) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  // Adds `value` unless it is held already; whether it was added.
  effect fn add(self: &mut Self, value: ContentHash) -> bool ! OutOfMemoryError ? &mut Allocator {
    if DigestSet.find(&self.*, value) != usize.MAX { return false }
    run InternIndex.record(&mut self.lookup, digestHash(value))
    run List<ContentHash>.append(&mut self.values, value)
    return true
  }
}

fn escapeMemoOf(memos: &[EscapeMemo], unit: usize) -> usize {
  let mut at = usize.ZERO
  while at < memos.length {
    if memos[at].unit == unit { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn sameDeclarations(left: &[DeclarationId], right: &[DeclarationId]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !DeclarationId.equals(&left[at], &right[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn copyDeclarations(declarations: &[DeclarationId]) -> List<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<DeclarationId>.make()
  let mut at = usize.ZERO
  while at < declarations.length {
    run List<DeclarationId>.append(&mut copied, DeclarationId.copy(&declarations[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyRejections(rejections: &[Shared<Rejection>]) -> List<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Shared<Rejection>>.make()
  let mut at = usize.ZERO
  while at < rejections.length {
    run List<Shared<Rejection>>.append(&mut copied, Shared<Rejection>.clone(&rejections[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn mergeRejections(into: &mut List<Shared<Rejection>>, rejections: &[Shared<Rejection>]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < rejections.length {
    run appendDeclarationRejection(&mut into.*, Shared<Rejection>.clone(&rejections[at]))
    at = at + usize.ONE
  }
}

// Adds the rejections a walk from the runtime's roots found outside the runtime module itself. The
// runtime's own refusals are checked against the entry separately, which reports a `main` the
// runtime cannot start in place of the runtime body that fails to start it.
effect fn appendOutsideRuntime(into: &mut List<Shared<Rejection>>, rejections: &[Shared<Rejection>], runtime: &Option<ModuleId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < rejections.length {
    let inside = match &runtime.* {
      Option<ModuleId>.Some {value: selected} => Shared<Rejection>.with<bool>(&rejections[at], fn(value: &Rejection) -> bool {
        return ModuleId.equals(&value.module, &selected)
      })
      Option<ModuleId>.None => false
    }
    if !inside { run appendDeclarationRejection(&mut into.*, Shared<Rejection>.clone(&rejections[at])) }
    at = at + usize.ONE
  }
}

effect fn mergeGaps(into: &mut List<Shared<BackendGap>>, gaps: &[Shared<BackendGap>]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < gaps.length {
    run appendDeclarationGap(&mut into.*, Shared<BackendGap>.clone(&gaps[at]))
    at = at + usize.ONE
  }
}

// Adds a kept sweep's findings to `result` and its concrete bodies to `concrete`.
effect fn mergeSweep(result: &mut DeclarationCheckResult, concrete: &mut List<DeclarationId>, sweep: &Sweep) -> () ! OutOfMemoryError ? &mut Allocator {
  run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&sweep.rejections))
  run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&sweep.gaps))
  let unchecked = List<UncheckedDeclaration>.asSlice(&sweep.unchecked)
  let mut at = usize.ZERO
  while at < unchecked.length {
    run List<UncheckedDeclaration>.append(&mut result.unchecked,
      UncheckedDeclaration {identity: DeclarationId.copy(&unchecked[at].identity), borrow: unchecked[at].borrow})
    at = at + usize.ONE
  }
  let bodies = List<DeclarationId>.asSlice(&sweep.concrete)
  at = usize.ZERO
  while at < bodies.length {
    run List<DeclarationId>.append(&mut concrete.*, DeclarationId.copy(&bodies[at]))
    at = at + usize.ONE
  }
}

effect fn copyCheckResult(result: &DeclarationCheckResult) -> DeclarationCheckResult ! OutOfMemoryError ? &mut Allocator {
  let mut copied = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()}
  let rejections = List<Shared<Rejection>>.asSlice(&result.rejections)
  let mut at = usize.ZERO
  while at < rejections.length {
    run List<Shared<Rejection>>.append(&mut copied.rejections, Shared<Rejection>.clone(&rejections[at]))
    at = at + usize.ONE
  }
  let gaps = List<Shared<BackendGap>>.asSlice(&result.gaps)
  at = usize.ZERO
  while at < gaps.length {
    run List<Shared<BackendGap>>.append(&mut copied.gaps, Shared<BackendGap>.clone(&gaps[at]))
    at = at + usize.ONE
  }
  let unchecked = List<UncheckedDeclaration>.asSlice(&result.unchecked)
  at = usize.ZERO
  while at < unchecked.length {
    run List<UncheckedDeclaration>.append(&mut copied.unchecked,
      UncheckedDeclaration {identity: DeclarationId.copy(&unchecked[at].identity), borrow: unchecked[at].borrow})
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyDeferred(deferred: &[DeferredStaticTemplate]) -> List<DeferredStaticTemplate> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<DeferredStaticTemplate>.make()
  run appendDeferred(&mut copied, deferred)
  return move copied
}

effect fn appendDeferred(into: &mut List<DeferredStaticTemplate>, deferred: &[DeferredStaticTemplate]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < deferred.length {
    run List<DeferredStaticTemplate>.append(&mut into.*,
      DeferredStaticTemplate {declaration: DeclarationId.copy(&deferred[at].declaration), reason: deferred[at].reason})
    at = at + usize.ONE
  }
}

effect fn copyUnchecked(unchecked: &[UncheckedBody]) -> List<UncheckedBody> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<UncheckedBody>.make()
  run appendUnchecked(&mut copied, unchecked)
  return move copied
}

effect fn appendUnchecked(into: &mut List<UncheckedBody>, unchecked: &[UncheckedBody]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < unchecked.length {
    run List<UncheckedBody>.append(&mut into.*,
      UncheckedBody {module: ModuleId.copy(&unchecked[at].module), block: unchecked[at].block, reason: unchecked[at].reason})
    at = at + usize.ONE
  }
}

// The position of `unit`'s memo, or `usize.MAX`.
fn declarationMemoOf(slots: &[usize], unit: usize) -> usize {
  if unit < slots.length { return slots[unit] }
  return usize.MAX
}

fn memoOf(memos: &[ModuleCheckMemo], unit: usize) -> usize {
  let mut at = usize.ZERO
  while at < memos.length {
    if memos[at].unit == unit { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// An owned snapshot of one checked direct call's canonical selection.
pub struct StaticCall {
  pub application: Application,
  // Whether the call's receiver, the subject of its callee, is its first argument.
  pub receiver: bool,
}

/// A short loan of an active semantic query for static call resolution.
/// Its dependency ledger is the caller's ledger, including an in-flight initializer.
pub struct StaticPort<'source> {
  resolver: &'source mut Resolver,
  query: &'source mut Query<Answer, NoRejection>,
  dependencies: &'source mut List<Dependency>,
}

// A selected-body checking reservation restores its enclosing evaluator budget on every exit.
struct StaticDemandReservation<'source, 'request> {
  port: &'request mut StaticPort<'source>,
  depth: usize,
  limit: usize,
}

fn sameDigest(left: [u8; 32], right: [u8; 32]) -> bool {
  let mut at = usize.ZERO
  while at < 32 {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn endsWithBytes(text: &[u8], suffix: &[u8]) -> bool {
  if text.length < suffix.length { return false }
  let offset = text.length - suffix.length
  let mut at = usize.ZERO
  while at < suffix.length {
    if text[offset + at] != suffix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn bytesLess(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] < right[at] {
      return true
    }
    if left[at] > right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return left.length < right.length
}

// Whether this store keeps what a later revision needs. A one-shot store never revises, so it
// keeps none of it and computes the same answers.
fn recording(resolver: &Resolver) -> bool {
  return SourceIndex.revisable(&resolver.source)
}

// Shared.with takes an exclusive runtime borrow, including for inspection. Compare aliases
// before entering the other handle in the structural comparators below.
fn sameAllocation<T>(left: &Shared<T>, right: &Shared<T>) -> bool {
  let first = Shared<T>.with<usize>(
    left,
    fn(value: &T) -> usize {
      return Pointer.address<T>(Pointer.fromRef<T>(value))
    },
  )
  let second = Shared<T>.with<usize>(
    right,
    fn(value: &T) -> usize {
      return Pointer.address<T>(Pointer.fromRef<T>(value))
    },
  )
  return first == second
}

fn sameBucketWith(first: &NameObservation, other: &Shared<NameObservation>) -> bool {
  return Shared<NameObservation>.with<bool>(
    other,
    fn(second: &NameObservation) -> bool {
      return NameObservation.equals(first, second)
    },
  )
}

fn sameBuckets(left: &Shared<NameObservation>, right: &Shared<NameObservation>) -> bool {
  if sameAllocation<NameObservation>(left, right) {
    return true
  }
  return Shared<NameObservation>.with<bool>(
    left,
    fn(first: &NameObservation) -> bool {
      return sameBucketWith(first, right)
    },
  )
}

fn reusableTypeKind(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {..} => usize.ONE
    Type.Unit => 2
    Type.Nominal {..} => 3
    Type.OpaqueRepresentation {..} => 14
    Type.Parameter {..} => 4
    Type.String {..} => 5
    Type.Reference {..} => 6
    Type.Slice {..} => 7
    Type.Pointer {..} => 8
    Type.Array {..} => 9
    Type.Union {..} => 10
    Type.Callable {..} => 11
    Type.Effect {..} => 12
    Type.TypeDescriptor {..} => 15
    Type.Anonymous {..} => 16
    Type.CallableValue {..} => 17
    Type.CallableStage {..} => 18
    Type.CallableSchema {..} => 19
    Type.CallableWitnessResult {..} => 23
    Type.CallableOrigin {..} => 22
    Type.CallableResult {..} => 21
    Type.CallableView {..} => 20
    Type.EffectComposite {..} => 24
    Type.EffectJoin {..} => 25
    Type.Without {..} => 26
    Type.ForeignFunction {..} => 27
    Type.Vector {..} => 28
  }
}

fn primitiveLength(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {name} => Bytes.asSlice(&name).length
    _ => usize.ZERO
  }
}

fn primitiveByte(value: &Type, at: usize) -> u8 {
  return match & value.* {
    Type.Primitive {name} => Bytes.asSlice(&name)[at]
    _ => 0
  }
}

fn sameOptionalAlignment(left: &Option<u64>, right: &Option<u64>) -> bool {
  return match & left.* {
    Option<u64>.Some {value} => match & right.* {
      Option<u64>.Some {value: other} => value == other
      Option<u64>.None => false
    }
    Option<u64>.None => match & right.* {
      Option<u64>.Some {value: _} => false
      Option<u64>.None => true
    }
  }
}

fn sameIntersectionWith(first: &Intersection, right: &Shared<Intersection>) -> bool {
  return Shared<Intersection>.with<bool>(
    right,
    fn(second: &Intersection) -> bool {
      return Intersection.equals(first, second)
    },
  )
}

fn sameIntersection(left: &Shared<Intersection>, right: &Shared<Intersection>) -> bool {
  if sameAllocation<Intersection>(left, right) {
    return true
  }
  return Shared<Intersection>.with<bool>(
    left,
    fn(first: &Intersection) -> bool {
      return sameIntersectionWith(first, right)
    },
  )
}

fn sameOutlives(left: &[Outlives], right: &[Outlives]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !Lifetime.equalsShared(&left[at].longer, &right[at].longer) || !Lifetime.equalsShared(
      &left[at].shorter,
      &right[at].shorter,
    ) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameReusableType(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if sameAllocation<Type>(left, right) {
    return true
  }
  let first = Shared<Type>.with<usize>(left, reusableTypeKind)
  let second = Shared<Type>.with<usize>(right, reusableTypeKind)
  if first != second {
    return false
  }
  if first == 2 {
    return true
  }
  if first == usize.ONE {
    let length = Shared<Type>.with<usize>(left, primitiveLength)
    if length != Shared<Type>.with<usize>(right, primitiveLength) {
      return false
    }
    let mut at = usize.ZERO
    while at < length {
      let from = Shared<Type>.with<u8>(
        left,
        fn(value: &Type) -> u8 {
          return primitiveByte(value, at)
        },
      )
      let to = Shared<Type>.with<u8>(
        right,
        fn(value: &Type) -> u8 {
          return primitiveByte(value, at)
        },
      )
      if from != to {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  return Shared<Type>.with<bool>(
    left,
    fn(value: &Type) -> bool {
      return sameReusableTypeWith(value, right)
    },
  )
}

fn reusableApplicationAddress(value: &Application) -> usize {
  return Pointer.address<Application>(Pointer.fromRef<Application>(value))
}

fn sameReusableApplicationWith(first: &Application, right: &Shared<Application>) -> bool {
  return Shared<Application>.with<bool>(right, fn(second: &Application) -> bool {
    // Ordinary callable targets can be reconstructed from header queries. Operation/static
    // evidence has no allocation-free comparison here; conservatively propagate its change.
    if let SpecializationTarget.Named {declaration} = &first.target {
      if let SpecializationTarget.Named {declaration: compared} = &second.target {
        if !DeclarationId.equals(&declaration, &compared) { return false }
      } else { return false }
    } else { return false }
    if List<StaticSlot>.length(&first.statics) != usize.ZERO || List<StaticSlot>.length(&second.statics) != usize.ZERO { return false }
    if !sameArguments(List<Argument>.asSlice(&first.arguments), List<Argument>.asSlice(&second.arguments))
      || !sameApplicationOrdinals(List<usize>.asSlice(&first.argumentOrdinals), List<usize>.asSlice(&second.argumentOrdinals)) { return false }
    return sameScopeBindings(List<ScopeBinding>.asSlice(&first.scopes), List<ScopeBinding>.asSlice(&second.scopes))
  })
}

fn sameReusableApplication(left: &Shared<Application>, right: &Shared<Application>) -> bool {
  if Shared<Application>.with<usize>(left, reusableApplicationAddress) == Shared<Application>.with<usize>(right, reusableApplicationAddress) { return true }
  return Shared<Application>.with<bool>(left, fn(first: &Application) -> bool {
    return sameReusableApplicationWith(first, right)
  })
}


fn sameReusableTypeWith(value: &Type, right: &Shared<Type>) -> bool {
  return Shared<Type>.with<bool>(
    right,
    fn(other: &Type) -> bool {
      return match & value.* {
        Type.Nominal {declaration, arguments, ..} => match & other.* {
          Type.Nominal {declaration: selected, arguments: supplied, ..} => DeclarationId.equals(
            &declaration,
            &selected,
          ) && sameArguments(
            List<Argument>.asSlice(&arguments),
            List<Argument>.asSlice(&supplied),
          )
          _ => false
        }
        Type.Parameter {declaration, ordinal} => match & other.* {
          Type.Parameter {declaration: selected, ordinal: position} => DeclarationId.equals(
            &declaration,
            &selected,
          ) && ordinal == position
          _ => false
        }
        Type.String {lifetime} => match & other.* {
          Type.String {lifetime: validity} => Lifetime.equalsShared(&lifetime, &validity)
          _ => false
        }
        Type.Reference {referent, access, lifetime} => match & other.* {
          Type.Reference {referent: target, access: selected, lifetime: validity} => access == selected && Lifetime.equalsShared(
            &lifetime,
            &validity,
          ) && sameReusableType(&referent, &target)
          _ => false
        }
        Type.Slice {element, access, lifetime} => match & other.* {
          Type.Slice {element: target, access: selected, lifetime: validity} => access == selected && Lifetime.equalsShared(
            &lifetime,
            &validity,
          ) && sameReusableType(&element, &target)
          _ => false
        }
        Type.Pointer {pointee, access, nullable, multiplicity, alignment} => match & other.* {
          Type.Pointer {
            pointee: target,
            access: selected,
            nullable: otherNullable,
            multiplicity: otherMultiplicity,
            alignment: otherAlignment,
          } => access == selected && nullable == otherNullable && multiplicity == otherMultiplicity && sameOptionalAlignment(
            &alignment,
            &otherAlignment,
          ) && sameReusableType(&pointee, &target)
          _ => false
        }
        Type.Array {element, extent} => match & other.* {
          Type.Array {element: target, extent: length} => same(
            Bytes.asSlice(&extent),
            Bytes.asSlice(&length),
          ) && sameReusableType(&element, &target)
          _ => false
        }
        Type.Union {members} => match & other.* {
          Type.Union {members: otherMembers} => sameTypeList(
            List<Shared<Type>>.asSlice(&members),
            List<Shared<Type>>.asSlice(&otherMembers),
          )
          _ => false
        }
        Type.Without {source, removed} => match & other.* {
          Type.Without {source: otherSource, removed: otherRemoved} => sameReusableType(&source, &otherSource) &&
            sameReusableType(&removed, &otherRemoved)
          _ => false
        }
        Type.Anonymous {occurrence, members} => match & other.* {
          Type.Anonymous {occurrence: selected, members: otherMembers} => AnonymousOccurrence.equalsShared(
            &occurrence,
            &selected,
          ) && sameTypeList(
            List<Shared<Type>>.asSlice(&members),
            List<Shared<Type>>.asSlice(&otherMembers),
          )
          _ => false
        }
        Type.CallableValue {isPublic, application, contract, captures, fieldInputs, ..} => match &other.* {
          Type.CallableValue {isPublic: visible, application: selected, contract: compared, captures: fields, fieldInputs: inputs, ..} =>
            isPublic == visible && sameReusableApplication(&application, &selected) && sameReusableType(&contract, &compared)
              && sameTypeList(List<Shared<Type>>.asSlice(&captures), List<Shared<Type>>.asSlice(&fields))
              && CallableFieldInput.allEqual(List<CallableFieldInput>.asSlice(&fieldInputs), List<CallableFieldInput>.asSlice(&inputs))
          _ => false
        }
        Type.CallableWitnessResult {witness} => match &other.* {
          Type.CallableWitnessResult {witness: selected} => sameReusableWitness(&witness, &selected)
          _ => false
        }
        Type.CallableOrigin {application, contract} => match &other.* {
          Type.CallableOrigin {application: selected, contract: exposed} => sameReusableApplication(&application, &selected)
            && sameReusableType(&contract, &exposed)
          _ => false
        }
        Type.CallableResult {producer, contract, arguments, selected, selectedOrdinals} => match &other.* {
          Type.CallableResult {producer: target, contract: exposed, arguments: supplied, selected: choices, selectedOrdinals: ordinals} =>
            sameReusableType(&producer, &target) && sameReusableType(&contract, &exposed)
              && sameTypeList(List<Shared<Type>>.asSlice(&arguments), List<Shared<Type>>.asSlice(&supplied))
              && sameArguments(List<Argument>.asSlice(&selected), List<Argument>.asSlice(&choices))
              && sameUsizeList(List<usize>.asSlice(&selectedOrdinals), List<usize>.asSlice(&ordinals))
          _ => false
        }
        Type.CallableView {representation, contract} => match &other.* {
          Type.CallableView {representation: selected, contract: exposed} =>
            sameReusableType(&representation, &selected) && sameReusableType(&contract, &exposed)
          _ => false
        }
        Type.OpaqueRepresentation {application, contract, detached, nonParking} => match &other.* {
          Type.OpaqueRepresentation {application: selected, contract: useContract, detached: otherDetached, nonParking: otherNonParking} =>
            sameReusableApplication(&application, &selected) && sameReusableType(&contract, &useContract)
              && detached == otherDetached && nonParking == otherNonParking
          _ => false
        }
        Type.ForeignFunction {signature, behavior} => match &other.* {
          Type.ForeignFunction {signature: selected, behavior: actual} =>
            ForeignContract.same(behavior, actual) && sameReusableType(&signature, &selected)
          _ => false
        }
        Type.Callable {
          mode,
          isUnsafe,
          environment,
          invocationBinders,
          invocationUse,
          invocationBounds,
          parameters,
          result,
        } => match & other.* {
          Type.Callable {
            mode: otherMode,
            isUnsafe: otherUnsafe,
            environment: otherEnvironment,
            invocationBinders: otherBinders,
            invocationUse: otherUse,
            invocationBounds: otherBounds,
            parameters: otherParameters,
            result: otherResult,
          } => mode == otherMode && isUnsafe == otherUnsafe && sameIntersection(
            &environment,
            &otherEnvironment,
          ) && invocationBinders == otherBinders && invocationUse == otherUse && sameOutlives(
            List<Outlives>.asSlice(&invocationBounds),
            List<Outlives>.asSlice(&otherBounds),
          ) && sameTypeList(
            List<Shared<Type>>.asSlice(&parameters),
            List<Shared<Type>>.asSlice(&otherParameters),
          ) && sameReusableType(&result, &otherResult)
          _ => false
        }
        Type.Effect {mode, environment, success, failure, requirements} => match & other.* {
          Type.Effect {
            mode: otherMode,
            environment: otherEnvironment,
            success: otherSuccess,
            failure: otherFailure,
            requirements: otherRequirements,
          } => mode == otherMode && sameIntersection(&environment, &otherEnvironment) && sameReusableType(
            &success,
            &otherSuccess,
          ) && sameReusableType(&failure, &otherFailure) && sameRow(
            &requirements,
            &otherRequirements,
          )
          _ => false
        }
        _ => false
      }
    },
  )
}

fn sameTypeOption(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>) -> bool {
  return match & left.* {
    Option<Shared<Type>>.Some {value} => match & right.* {
      Option<Shared<Type>>.Some {value: other} => sameReusableType(&value, &other)
      Option<Shared<Type>>.None => false
    }
    Option<Shared<Type>>.None => match & right.* {
      Option<Shared<Type>>.Some {value: _} => false
      Option<Shared<Type>>.None => true
    }
  }
}

fn sameUsizeList(left: &[usize], right: &[usize]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}

fn sameReusableWitness(left: &Shared<WitnessRecipe>, right: &Shared<WitnessRecipe>) -> bool {
  let first = Shared<WitnessRecipe>.with<WitnessRecipe>(left, CallableWitness.copy)
  let second = Shared<WitnessRecipe>.with<WitnessRecipe>(right, CallableWitness.copy)
  if !sameDeclarationShared(&first.operation, &second.operation)
    || !sameReusableType(&first.contract, &second.contract)
    || !sameReusableType(&first.provider, &second.provider)
    || !sameReusableType(&first.result, &second.result) { return false }
  let count = CallableWitness.bindingCount(&first)
  if count != CallableWitness.bindingCount(&second)
    || CallableWitness.argumentCount(&first) != CallableWitness.argumentCount(&second)
    || CallableWitness.loanCount(&first) != CallableWitness.loanCount(&second) { return false }
  let mut at = usize.ZERO
  while at < count {
    let original = CallableWitness.bindingAt(&first, at)
    let selected = CallableWitness.bindingAt(&second, at)
    if original.ordinal != selected.ordinal || !sameDeclarationShared(&original.declaration, &selected.declaration)
      || !sameReusableArgument(&original.value, &selected.value) { return false }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < CallableWitness.argumentCount(&first) {
    if !sameReusableType(&CallableWitness.argumentAt(&first, at), &CallableWitness.argumentAt(&second, at)) { return false }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < CallableWitness.loanCount(&first) {
    let original = CallableWitness.loanAt(&first, at)
    let selected = CallableWitness.loanAt(&second, at)
    if let Option<Shared<Lifetime>>.Some {value: region} = move original {
      if let Option<Shared<Lifetime>>.Some {value: compared} = move selected {
        if !Lifetime.equalsShared(&region, &compared) { return false }
      } else { return false }
    } else { if let Option<Shared<Lifetime>>.Some {..} = move selected { return false } }
    at = at + usize.ONE
  }
  return true
}

fn sameReusableArgument(left: &Argument, right: &Argument) -> bool {
  return match &left.* {
    Argument.Type {value} => match &right.* { Argument.Type {value: other} => sameReusableType(&value, &other) _ => false }
    Argument.Lifetime {value} => match &right.* { Argument.Lifetime {value: other} => Lifetime.equalsShared(&value, &other) _ => false }
    Argument.Row {value} => match &right.* { Argument.Row {value: other} => sameRow(&value, &other) _ => false }
  }
}

fn sameTypeList(left: &[Shared<Type>], right: &[Shared<Type>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameReusableType(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameVariances(left: &[Variance], right: &[Variance]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameDropUses(left: &[DropUse], right: &[DropUse]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameFlags(left: &[bool], right: &[bool]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameDeclarationList(left: &[Shared<DeclarationId>], right: &[Shared<DeclarationId>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameDeclarationShared(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameReuseConstraint(left: &Constraint, right: &Constraint) -> bool {
  return match & left.* {
    Constraint.Conforms {provider, contract} => match & right.* {
      Constraint.Conforms {provider: otherProvider, contract: otherContract} => sameReusableType(
        &provider,
        &otherProvider,
      ) && sameReusableType(&contract, &otherContract)
      _ => false
    }
    Constraint.Represents {parameter, contract} => match & right.* {
      Constraint.Represents {parameter: otherParameter, contract: otherContract} => sameReusableType(
        &parameter,
        &otherParameter,
      ) && sameReusableType(&contract, &otherContract)
      _ => false
    }
    Constraint.Contents {subject, region} => match & right.* {
      Constraint.Contents {subject: otherSubject, region: otherRegion} => sameReusableType(
        &subject,
        &otherSubject,
      ) && Lifetime.equalsShared(&region, &otherRegion)
      _ => false
    }
    Constraint.Outlives {longer, shorter} => match & right.* {
      Constraint.Outlives {longer: otherLonger, shorter: otherShorter} => Lifetime.equalsShared(
        &longer,
        &otherLonger,
      ) && Lifetime.equalsShared(&shorter, &otherShorter)
      _ => false
    }
    Constraint.Copyable {subject} => match & right.* {
      Constraint.Copyable {subject: other} => sameReusableType(&subject, &other)
      _ => false
    }
    Constraint.ThreadSafe {subject, property} => match & right.* {
      Constraint.ThreadSafe {subject: other, property: otherProperty} => property == otherProperty && sameReusableType(
        &subject,
        &other,
      )
      _ => false
    }
    Constraint.Property {subject, property} => match & right.* {
      Constraint.Property {subject: other, property: otherProperty} => property == otherProperty && sameReusableType(
        &subject,
        &other,
      )
      _ => false
    }
    Constraint.Provides {provider, selector, source} => match & right.* {
      Constraint.Provides {provider: otherProvider, selector: otherSelector, source: otherSource} => sameReusableType(
        &provider,
        &otherProvider,
      ) && sameRow(&selector, &otherSelector) && sameRow(&source, &otherSource)
      _ => false
    }
    Constraint.FailureSubset {selected, source} => match & right.* {
      Constraint.FailureSubset {selected: other, source: otherSource} => sameReusableType(&selected, &other) &&
        sameReusableType(&source, &otherSource)
      _ => false
    }
    Constraint.RequirementSubset {selected, source} => match & right.* {
      Constraint.RequirementSubset {selected: other, source: otherSource} => sameRow(&selected, &other) &&
        sameRow(&source, &otherSource)
      _ => false
    }
  }
}

fn sameConstraints(left: &[Constraint], right: &[Constraint]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameReuseConstraint(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameRowParameters(left: &[RowParameter], right: &[RowParameter]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at].ordinal != right[at].ordinal || !sameDeclarationShared(
      &left[at].declaration,
      &right[at].declaration,
    ) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameRow(left: &Shared<Row>, right: &Shared<Row>) -> bool {
  if sameAllocation<Row>(left, right) {
    return true
  }
  return Shared<Row>.with<bool>(
    left,
    fn(first: &Row) -> bool {
      return sameRowWith(first, right)
    },
  )
}

fn sameRowWith(first: &Row, right: &Shared<Row>) -> bool {
  return Shared<Row>.with<bool>(
    right,
    fn(second: &Row) -> bool {
      let entries = List<Requirement>.asSlice(&first.entries)
      let otherEntries = List<Requirement>.asSlice(&second.entries)
      if entries.length != otherEntries.length || !sameRowParameters(
        List<RowParameter>.asSlice(&first.parameters),
        List<RowParameter>.asSlice(&second.parameters),
      ) {
        return false
      }
      let mut at = usize.ZERO
      while at < entries.length {
        if entries[at].access != otherEntries[at].access || !sameReusableType(
          &entries[at].capability,
          &otherEntries[at].capability,
        ) || !sameTypeOption(&entries[at].roleType, &otherEntries[at].roleType) {
          return false
        }
        at = at + usize.ONE
      }
      let terms = List<RowSubtraction>.asSlice(&first.subtractions)
      let otherTerms = List<RowSubtraction>.asSlice(&second.subtractions)
      if terms.length != otherTerms.length {
        return false
      }
      at = usize.ZERO
      while at < terms.length {
        if !sameRow(&terms[at].source, &otherTerms[at].source) || !sameRow(&terms[at].removed, &otherTerms[at].removed) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    },
  )
}

fn sameEnvironment(left: &Option<Intersection>, right: &Option<Intersection>) -> bool {
  return match & left.* {
    Option<Intersection>.Some {value} => match & right.* {
      Option<Intersection>.Some {value: other} => Intersection.equals(&value, &other)
      Option<Intersection>.None => false
    }
    Option<Intersection>.None => match & right.* {
      Option<Intersection>.Some {value: _} => false
      Option<Intersection>.None => true
    }
  }
}

fn sameSlots(left: &[usize], right: &[usize]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameSignature(left: &Signature, right: &Signature) -> bool {
  return left.callableParameterStart == right.callableParameterStart && left.isEffect == right.isEffect
    && left.environmentWritten == right.environmentWritten && left.environmentExempt == right.environmentExempt && left.isVariadic == right.isVariadic && left.isUnsafe == right.isUnsafe && left.isStatic == right.isStatic
    && sameSlots(List<usize>.asSlice(&left.staticSlots), List<usize>.asSlice(&right.staticSlots),
  ) && sameEnvironment(
    &left.environment,
    &right.environment) && sameTypeList(
    List<Shared<Type>>.asSlice(&left.typeParameters),
    List<Shared<Type>>.asSlice(&right.typeParameters),
  ) && sameLifetimes(
    List<Shared<Lifetime>>.asSlice(&left.lifetimeParameters),
    List<Shared<Lifetime>>.asSlice(&right.lifetimeParameters),
  ) && sameRowParameters(
    List<RowParameter>.asSlice(&left.rowParameters),
    List<RowParameter>.asSlice(&right.rowParameters),
  ) && sameConstraints(
    List<Constraint>.asSlice(&left.constraints),
    List<Constraint>.asSlice(&right.constraints),
  ) && sameTypeList(
    List<Shared<Type>>.asSlice(&left.parameters),
    List<Shared<Type>>.asSlice(&right.parameters),
  ) && sameReusableType(&left.result, &right.result) && sameReusableType(
    &left.failure,
    &right.failure,
  ) && sameRow(&left.requirements, &right.requirements)
}

fn sameLifetimes(left: &[Shared<Lifetime>], right: &[Shared<Lifetime>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !Lifetime.equalsShared(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameContract(left: &Contract, right: &Contract) -> bool {
  return sameTypeList(
    List<Shared<Type>>.asSlice(&left.typeParameters),
    List<Shared<Type>>.asSlice(&right.typeParameters),
  ) && sameLifetimes(
    List<Shared<Lifetime>>.asSlice(&left.lifetimeParameters),
    List<Shared<Lifetime>>.asSlice(&right.lifetimeParameters),
  ) && sameRowParameters(
    List<RowParameter>.asSlice(&left.rowParameters),
    List<RowParameter>.asSlice(&right.rowParameters),
  ) && sameConstraints(
    List<Constraint>.asSlice(&left.constraints),
    List<Constraint>.asSlice(&right.constraints),
  ) && sameTypeOption(&left.provider, &right.provider)
}

fn sameImplementationKind(left: &ImplementationKind, right: &ImplementationKind) -> bool {
  return match & left.* {
    ImplementationKind.Inherent => match & right.* {
      ImplementationKind.Inherent => true
      _ => false
    }
    ImplementationKind.Conformance => match & right.* {
      ImplementationKind.Conformance => true
      _ => false
    }
    ImplementationKind.Sealed {property} => match & right.* {
      ImplementationKind.Sealed {property: other} => property == other
      _ => false
    }
  }
}

fn sameHead(left: &Shared<ImplementationHead>, right: &Shared<ImplementationHead>) -> bool {
  if sameAllocation<ImplementationHead>(left, right) {
    return true
  }
  return Shared<ImplementationHead>.with<bool>(
    left,
    fn(first: &ImplementationHead) -> bool {
      return sameHeadWith(first, right)
    },
  )
}

// Whether a sealed head depends on a region: it names `'static` or one region at two positions,
// or it states a region bound (`'a: 'b`, `T: 'a`, an interface bound, or a representation contract
// that names a region) that the provider's declaration does not already imply. Each other region position is
// its own unbounded binder, and an implied bound holds for every value of the provider type, so
// every region pattern of a type matches the head alike.
effect fn regionDependentHead(provider: &Shared<Type>, constraints: &[Constraint], implied: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < constraints.length {
    if run regionBound(&constraints[at]) {
      let mut covered = false
      let mut candidate = usize.ZERO
      while candidate < implied.length && !covered {
        covered = run sameConstraint(&constraints[at], &implied[candidate])
        candidate = candidate + usize.ONE
      }
      if !covered { return true }
    }
    at = at + usize.ONE
  }
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.regionAtoms(provider, &mut atoms)
  let listed = List<Shared<Lifetime>>.asSlice(&atoms)
  at = usize.ZERO
  while at < listed.length {
    let kind = Shared<Lifetime>.with<usize>(&listed[at], fn(held: &Lifetime) -> usize {
      return match &held.* { Lifetime.Static => 1 Lifetime.Invocation {..} => 2 _ => 0 }
    })
    if kind == 1 { return true }
    if kind == 0 {
      let mut other = at + usize.ONE
      while other < listed.length {
        if Lifetime.equalsShared(&listed[at], &listed[other]) { return true }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a declared bound can constrain a region: `'a: 'b`, `T: 'a`, an interface bound, or a
// representation contract that names a region.
effect fn regionBound(constraint: &Constraint) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Constraint.Represents {contract, ..} = &constraint.* {
    let mut atoms = List<Shared<Lifetime>>.make()
    run Type.regionAtoms(&contract, &mut atoms)
    return List<Shared<Lifetime>>.length(&atoms) > usize.ZERO
  }
  // A conformance can hold for some regions of a type and not others, so an interface bound is a
  // region bound in disguise. A `Copy` bound is region-independent under this same rule.
  return match &constraint.* {
    Constraint.Outlives {..} => true
    Constraint.Contents {..} => true
    Constraint.Conforms {..} => true
    _ => false
  }
}

// The bounds a nominal provider's declaration places on its parameters, applied to the provider's
// arguments. Every well-formed value of the provider type satisfies them.
effect fn providerDeclaredBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, provider: &Shared<Type>, span: Span) -> List<Constraint>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(provider)
  if let Type.Nominal {declaration, arguments, ..} = move copied {
    let module = ModuleId.copy(DeclarationId.moduleId(&declaration))
    let moduleOrdinal = run internModule(&mut resolver.*, &module)
    let identity = run Shared<DeclarationId>.make(move declaration)
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &module, &identity) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return List<Constraint>.make() }
    }
    // `declaresBounds` answers only for bounds a use must prove; lifetime bounds count here too.
    let syntax = match move run scopedHeader(&mut resolver.*, &module, ordinal) {
      Option<HeaderSyntax>.Some {value} => value
      Option<HeaderSyntax>.None => { return List<Constraint>.make() }
    }
    let mut binders = match move run templateBinders(&mut resolver.*, &module, ordinal) {
      Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
      Result<List<Binder>, Shared<Rejection>>.Failure {..} => { return List<Constraint>.make() }
    }
    let incomplete = run completeApplicationBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
      &module, ordinal, span, &mut binders)
    if let Option<Shared<Rejection>>.Some {..} = move incomplete { return List<Constraint>.make() }
    let isPublic = match syntax.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      _ => false
    }
    let applied = run appliedDeclarationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, ordinal,
      headerGenerics(syntax.header), List<Binder>.asSlice(&binders), List<Argument>.asSlice(&arguments), span, isPublic)
    return match move applied {
      Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
      Result<List<Constraint>, Shared<Rejection>>.Failure {..} => List<Constraint>.make()
    }
  }
  return List<Constraint>.make()
}

// The region bounds the types of a signature imply by being well formed (LIFE-002), and, under a
// written environment (`environment`), that every input outlives it (LIFE-004): each nominal's
// declared outlives and contents bounds applied to its arguments, in every type they hold and every
// field, element and variant payload those store, and a view's referent outliving the view's region.
// The callee's body assumes them of its parameters and result, so a call instantiating the signature
// proves them as it proves the declared bounds. A call (`owed`) owes no view bound under an exclusive
// view of a parameter or result type: its referent is invariant, so the argument's own views already
// satisfy them. The declared bounds of nominals inside it are still owed, since a literal does not
// prove its own.
effect fn impliedSignatureBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, types: &[Shared<Type>], inputs: usize, environment: &Option<Shared<Lifetime>>, exempt: usize,
  owed: bool, span: Span) -> List<Constraint>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut implied = List<Constraint>.make()
  if let Option<Shared<Lifetime>>.Some {value: region} = &environment.* {
    let mut input = usize.ZERO
    while input < inputs && input < types.length {
      if input != exempt {
        run List<Constraint>.append(&mut implied, Constraint.Contents {subject: Shared<Type>.clone(&types[input]),
          region: Shared<Lifetime>.clone(&region)})
      }
      input = input + usize.ONE
    }
  }
  // Each pending type, and whether it lies in one of the first `inputs` types: the body assumes
  // what an input's stored data implies, but a result's it builds itself.
  let mut pending = List<Shared<Type>>.make()
  let mut stores = List<bool>.make()
  let mut visited = List<StoredShape>.make()
  let mut walked = List<Shared<Type>>.make()
  let mut revisits = usize.ZERO
  let mut reached = ReachedTypes {held: List<Shared<Type>>.make(), inputs: List<bool>.make(), lookup: InternIndex.make()}
  // Handles whose view bounds are listed in full (`Type.impliedBounds`), which lists those of every
  // type inside them too.
  let mut bounded = ReachedTypes {held: List<Shared<Type>>.make(), inputs: List<bool>.make(), lookup: InternIndex.make()}
  let mut at = usize.ZERO
  while at < types.length {
    run appendViewBounds(&types[at], owed, &mut implied)
    if !owed { drop run reachType(&mut bounded, &types[at], false) }
    run List<Shared<Type>>.append(&mut pending, Shared<Type>.clone(&types[at]))
    run List<bool>.append(&mut stores, at < inputs)
    at = at + usize.ONE
  }
  while List<Shared<Type>>.length(&pending) > usize.ZERO {
    let last = List<Shared<Type>>.length(&pending) - usize.ONE
    let current = List<Shared<Type>>.remove(&mut pending, last)
    let input = List<bool>.remove(&mut stores, last)
    // A stored member is often the very handle its application also holds as an argument, so the
    // walk reaches it twice; reading it again adds nothing and would repeat its whole subtree.
    if !run reachType(&mut reached, &current, input) { continue }
    let mut children = List<Shared<Type>>.make()
    run Type.structuralChildren(&current, &mut children)
    let inside = List<Shared<Type>>.asSlice(&children)
    if reachedType(&bounded, &current, false) {
      let mut child = usize.ZERO
      while child < inside.length {
        drop run reachType(&mut bounded, &inside[child], false)
        child = child + usize.ONE
      }
    }
    // A compiler-sealed family (the `silk/core` cores, the `Intrinsic` families) has no source
    // declaration to read bounds from; its arguments are still walked.
    let named = Shared<Type>.with<Option<DeclarationId>>(&current, fn(node: &Type) -> Option<DeclarationId> {
      if let Type.Nominal {declaration, ..} = &node.* { return Option<DeclarationId>.some(DeclarationId.copy(&declaration)) }
      return Option<DeclarationId>.none()
    })
    let mut nominal = false
    if let Option<DeclarationId>.Some {value: identity} = &named {
      nominal = !ModuleId.withOrigin<bool>(DeclarationId.moduleId(&identity), sealedOrigin)
    }
    if nominal {
      let declared = run providerDeclaredBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &current, span)
      let listed = List<Constraint>.asSlice(&declared)
      let mut each = usize.ZERO
      while each < listed.length {
        match &listed[each] {
          Constraint.Outlives {..} => run List<Constraint>.append(&mut implied, copyConstraint(&listed[each]))
          Constraint.Contents {..} => run List<Constraint>.append(&mut implied, copyConstraint(&listed[each]))
          _ => ()
        }
        each = each + usize.ONE
      }
      // The body also assumes what each field, element and variant payload of an input implies
      // under the application (`appendStoredInputPremises`), so the walk reads every stored
      // application of an input once, until it runs out of revisits.
      let mut read = false
      if input {
        if let Option<bool>.Some {value} = move run readStoredApplication(&current, &mut visited, &mut walked, &mut revisits) {
          read = value
        }
      }
      if read {
        let members = run storedMemberTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, &current, span)
        let stored = List<Shared<Type>>.asSlice(&members)
        let mut member = usize.ZERO
        while member < stored.length {
          // A member typed by a parameter is often the argument's own handle, bounded already.
          if run reachType(&mut bounded, &stored[member], false) { run appendViewBounds(&stored[member], false, &mut implied) }
          run List<Shared<Type>>.append(&mut pending, Shared<Type>.clone(&stored[member]))
          run List<bool>.append(&mut stores, true)
          member = member + usize.ONE
        }
      }
    }
    let mut child = usize.ZERO
    while child < inside.length {
      run List<Shared<Type>>.append(&mut pending, Shared<Type>.clone(&inside[child]))
      run List<bool>.append(&mut stores, input)
      child = child + usize.ONE
    }
  }
  // A callable's invocation regions are fresh at each of its invocations, which owe the bounds its
  // contract's types imply there; a call that only passes or returns the callable owes none of them.
  let mut held = List<Constraint>.make()
  let listed = List<Constraint>.asSlice(&implied)
  at = usize.ZERO
  while at < listed.length {
    let quantified = match &listed[at] {
      Constraint.Outlives {longer, shorter} => Lifetime.anyAtom(&longer, invocationRegion) || Lifetime.anyAtom(&shorter, invocationRegion)
      Constraint.Contents {region, ..} => Lifetime.anyAtom(&region, invocationRegion)
      _ => false
    }
    if !quantified { run List<Constraint>.append(&mut held, copyConstraint(&listed[at])) }
    at = at + usize.ONE
  }
  return move held
}

// Type handles one implied-bound walk already read, and whether as part of an input. Each handle is
// retained so its address stays unique for the walk.
struct ReachedTypes {
  held: List<Shared<Type>>,
  inputs: List<bool>,
  lookup: InternIndex,
}

// Records that the walk reads `value`, as part of an input or not, unless it already read that handle
// as an input, or at all when `input` is false: an input reading does everything another one does.
effect fn reachType(reached: &mut ReachedTypes, value: &Shared<Type>, input: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  if reachedType(&reached.*, value, input) { return false }
  run List<Shared<Type>>.append(&mut reached.held, Shared<Type>.clone(value))
  run List<bool>.append(&mut reached.inputs, input)
  run InternIndex.record(&mut reached.lookup, usize.toU64(Shared<Type>.with<usize>(value, typeAddress)))
  return true
}

fn reachedType(reached: &ReachedTypes, value: &Shared<Type>, input: bool) -> bool {
  let address = Shared<Type>.with<usize>(value, typeAddress)
  let held = List<Shared<Type>>.asSlice(&reached.held)
  let inputs = List<bool>.asSlice(&reached.inputs)
  let mut at = InternIndex.first(&reached.lookup, usize.toU64(address))
  while at != usize.MAX {
    if (inputs[at] || !input) && Shared<Type>.with<usize>(&held[at], typeAddress) == address { return true }
    at = InternIndex.after(&reached.lookup, at)
  }
  return false
}

// Appends the bounds the views `value` holds imply: each referent outlives its view's region. With
// `shared`, none under an exclusive view (`Type.impliedSharedBounds`).
effect fn appendViewBounds(value: &Shared<Type>, shared: bool, implied: &mut List<Constraint>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut views = List<KeptBound>.make()
  if shared { run Type.impliedSharedBounds(value, &mut views) } else { run Type.impliedBounds(value, &mut views) }
  let bounds = List<KeptBound>.asSlice(&views)
  let mut each = usize.ZERO
  while each < bounds.length {
    match &bounds[each] {
      KeptBound.Outlives {longer, shorter} => run List<Constraint>.append(&mut implied.*,
        Constraint.Outlives {longer: Shared<Lifetime>.clone(&longer), shorter: Shared<Lifetime>.clone(&shorter)})
      KeptBound.Contents {subject, region} => run List<Constraint>.append(&mut implied.*,
        Constraint.Contents {subject: Shared<Type>.clone(&subject), region: Shared<Lifetime>.clone(&region)})
      _ => ()
    }
    each = each + usize.ONE
  }
  return ()
}

fn sealedOrigin(origin: &[u8]) -> bool { return same(origin, b"compiler-sealed-core") || same(origin, b"compiler-sealed-intrinsic") }

fn invocationRegion(value: &Lifetime) -> bool { return match &value.* { Lifetime.Invocation {..} => true _ => false } }

// The bounds a resolved signature's parameter and result types imply (`impliedSignatureBounds`),
// in its own binders' terms: all of them as its body's premises, or those a call owes (`owed`).
// A unit run asks this of one callee's signature at each of its calls, so it walks each signature
// once (`ImpliedWalk`).
effect fn signatureImpliedBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, signature: &Shared<Result<Answer, NoRejection>>, owed: bool, span: Span) -> List<Constraint>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if resolver.currentRun == usize.ZERO {
    return run walkSignatureImpliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, owed, span)
  }
  let revision = Graph.revision(&resolver.graph)
  if resolver.impliedRevision != revision {
    List<ImpliedWalk>.clear(&mut resolver.impliedWalks)
    resolver.impliedLookup = InternIndex.make()
    resolver.impliedRevision = revision
  }
  // A walk demands its children in its unit's scope. Units outside a path frame, not themselves
  // cycle members, demand them in the request scope alone, so they share walks; any other unit
  // keeps its walks for its own run.
  let running = List<ScopedKey>.get(&resolver.keys, u64.toUsize(List<Word>.get(&resolver.active, List<Word>.length(&resolver.active) - usize.ONE).value))
  let shared = resolver.pathFrames == usize.ZERO && !cycleMember(running.key.family)
  let address = Shared<Result<Answer, NoRejection>>.with<usize>(signature, answerAddress)
  let mut hashed = Hash.combine(Hash.combine(usize.toU64(address), usize.toU64(resolver.currentApplication)), usize.toU64(resolver.profileSlot))
  if owed { hashed = Hash.combine(hashed, 1) }
  let unit = recordingUnit(&resolver.*)
  let mut known = usize.MAX
  if shared { known = sharedWalkAt(&resolver.*, address, owed, hashed) } else { known = runWalkAt(&resolver.*, address, owed) }
  if known != usize.MAX {
    let mut walks = List<ImpliedWalk>.asSlice(&resolver.runWalks)
    if shared { walks = List<ImpliedWalk>.asSlice(&resolver.impliedWalks) }
    let edges = List<Dependency>.asSlice(&walks[known].dependencies)
    let mut edge = usize.ZERO
    while edge < edges.length {
      run List<Dependency>.append(&mut dependencies.*, edges[edge])
      edge = edge + usize.ONE
    }
    // A run's own walk made its graph records in that run already.
    if shared && unit != usize.MAX {
      let recorded = List<Dependee>.asSlice(&walks[known].recorded)
      let mut each = usize.ZERO
      while each < recorded.length {
        run Graph.record(&mut resolver.graph, unit, recorded[each])
        each = each + usize.ONE
      }
    }
    return run copyConstraints(List<Constraint>.asSlice(&walks[known].bounds))
  }
  let before = List<Dependency>.length(&dependencies.*)
  let reads = resolver.pathReads
  let mark = Graph.beginCapture(&mut resolver.graph, unit)
  let attempted = run Effect.result(walkSignatureImpliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, owed, span))
  let captured = run Graph.endCapture(&mut resolver.graph, mark)
  let bounds = match move attempted {
    Result<List<Constraint>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<List<Constraint>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      Cycle {} => {fail Cycle {}}
      InvalidModulePath {} => {fail InvalidModulePath {}}
      RevisionMismatch {} => {fail RevisionMismatch {}}
      OutOfMemoryError {} => {fail OutOfMemoryError {}}
    }
  }
  let recorded = List<Dependency>.asSlice(&dependencies.*)
  let mut edges = List<Dependency>.make()
  let mut edge = before
  while edge < recorded.length {
    run List<Dependency>.append(&mut edges, recorded[edge])
    edge = edge + usize.ONE
  }
  let mut walk = ImpliedWalk {unitRun: resolver.currentRun, application: resolver.currentApplication, profile: resolver.profileSlot,
    signature: Shared<Result<Answer, NoRejection>>.clone(signature), owed: owed,
    bounds: run copyConstraints(List<Constraint>.asSlice(&bounds)), dependencies: move edges, recorded: move captured}
  if shared && resolver.pathReads == reads {
    walk.unitRun = usize.ZERO
    run List<ImpliedWalk>.append(&mut resolver.impliedWalks, move walk)
    run InternIndex.record(&mut resolver.impliedLookup, hashed)
  } else {
    run List<ImpliedWalk>.append(&mut resolver.runWalks, move walk)
  }
  return move bounds
}

// The shared walk of this revision that read the signature at `address` with `owed` in the current
// request scope, or `usize.MAX`.
fn sharedWalkAt(resolver: &Resolver, address: usize, owed: bool, hashed: u64) -> usize {
  let walks = List<ImpliedWalk>.asSlice(&resolver.impliedWalks)
  let mut at = InternIndex.first(&resolver.impliedLookup, hashed)
  while at != usize.MAX {
    if walks[at].owed == owed && walks[at].application == resolver.currentApplication && walks[at].profile == resolver.profileSlot
      && Shared<Result<Answer, NoRejection>>.with<usize>(&walks[at].signature, answerAddress) == address {
      return at
    }
    at = InternIndex.after(&resolver.impliedLookup, at)
  }
  return usize.MAX
}

// The walk the current unit run made of the signature at `address` with `owed`, or `usize.MAX`.
fn runWalkAt(resolver: &Resolver, address: usize, owed: bool) -> usize {
  let walks = List<ImpliedWalk>.asSlice(&resolver.runWalks)
  let mut at = walks.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if walks[at].unitRun != resolver.currentRun { break }
    if walks[at].owed == owed && Shared<Result<Answer, NoRejection>>.with<usize>(&walks[at].signature, answerAddress) == address {
      return at
    }
  }
  return usize.MAX
}

// Whether a unit's answer depends on more of the demand path than its own scoped key, so walks
// beneath it are not shared: a static-if condition, a callable origin or its transaction, and a
// body checked under a selected application (`selectedBodyBindings`).
fn readsDemandPath(key: Key) -> bool {
  return key.family == Family.Condition || key.family == Family.CallableOrigin || key.family == Family.OriginDraft
    || key.family == Family.OriginSolve || key.family == Family.OriginValidate
    || (key.family == Family.Body && key.member != usize.ZERO)
}

fn answerAddress(answer: &Result<Answer, NoRejection>) -> usize {
  return Pointer.address<Result<Answer, NoRejection>>(Pointer.fromRef<Result<Answer, NoRejection>>(answer))
}

effect fn walkSignatureImpliedBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, signature: &Shared<Result<Answer, NoRejection>>, owed: bool, span: Span) -> List<Constraint>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut types = run signatureParameterTypes(signature)
  let inputs = List<Shared<Type>>.length(&types)
  if let Option<Shared<Type>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature, signatureResult) {
    run List<Shared<Type>>.append(&mut types, move value)
  }
  let mut environment = Option<Shared<Lifetime>>.none()
  let mut exempt = usize.MAX
  if let Option<SignatureFacts>.Some {value: facts} = move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(signature, signatureFacts) {
    if facts.environmentWritten {
      let regions = run environmentRegions(signature, facts.environment)
      environment = Option<Shared<Lifetime>>.some(run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&regions)))
      exempt = facts.environmentExempt
    }
  }
  return run impliedSignatureBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<Shared<Type>>.asSlice(&types), inputs,
    &environment, exempt, owed, span)
}

// The signature of the declaration whose body the innermost root frame checks, if it has one.
fn rootBodySignature(resolver: &Resolver) -> Option<Shared<Result<Answer, NoRejection>>> {
  let bodies = List<BodyFrame>.asSlice(&resolver.bodies)
  let mut at = bodies.length
  while at > usize.ZERO {
    at = at - usize.ONE
    if bodies[at].root {
      return match &bodies[at].signature {
        Option<Shared<Result<Answer, NoRejection>>>.Some {value} => Option<Shared<Result<Answer, NoRejection>>>.some(Shared<Result<Answer, NoRejection>>.clone(&value))
        _ => Option<Shared<Result<Answer, NoRejection>>>.none()
      }
    }
  }
  return Option<Shared<Result<Answer, NoRejection>>>.none()
}

fn sameHeadObligations(left: &[HeadObligation], right: &[HeadObligation]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameReuseConstraint(&left[at].bound, &right[at].bound) || !ModuleId.equals(&left[at].module, &right[at].module)
      || left[at].span.start != right[at].span.start || left[at].span.end != right[at].span.end { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameHeadWith(first: &ImplementationHead, right: &Shared<ImplementationHead>) -> bool {
  return Shared<ImplementationHead>.with<bool>(
    right,
    fn(second: &ImplementationHead) -> bool {
      return sameDeclarationShared(&first.declaration, &second.declaration) && sameImplementationKind(
        &first.kind,
        &second.kind,
      ) && sameContract(&first.binders, &second.binders) && sameTypeOption(
        &first.contract,
        &second.contract,
      ) && sameHeadObligations(List<HeadObligation>.asSlice(&first.obligations), List<HeadObligation>.asSlice(&second.obligations))
      && sameReusableType(&first.provider, &second.provider) && first.reified == second.reified && sameConstraints(
        List<Constraint>.asSlice(&first.ownerPremises),
        List<Constraint>.asSlice(&second.ownerPremises),
      )
    },
  )
}

fn sameHeads(left: &[Shared<ImplementationHead>], right: &[Shared<ImplementationHead>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameHead(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameArguments(left: &[Argument], right: &[Argument]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    let equal = match & left[at] {
      Argument.Type {value} => match & right[at] {
        Argument.Type {value: other} => sameReusableType(&value, &other)
        _ => false
      }
      Argument.Lifetime {value} => match & right[at] {
        Argument.Lifetime {value: other} => Lifetime.equalsShared(&value, &other)
        _ => false
      }
      Argument.Row {value} => match & right[at] {
        Argument.Row {value: other} => sameRow(&value, &other)
        _ => false
      }
    }
    if !equal {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameApplicationOrdinals(left: &[usize], right: &[usize]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameScopeBindings(left: &[ScopeBinding], right: &[ScopeBinding]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameDeclarationShared(&left[at].owner, &right[at].owner)
      || !sameApplicationOrdinals(List<usize>.asSlice(&left[at].argumentOrdinals), List<usize>.asSlice(&right[at].argumentOrdinals))
      || !sameArguments(List<Argument>.asSlice(&left[at].arguments), List<Argument>.asSlice(&right[at].arguments)) { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameOperandPasses(left: &[OperandPass], right: &[OperandPass]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    let equal = match left[at] {
      OperandPass.Value => match right[at] { OperandPass.Value => true _ => false }
      OperandPass.Borrow {access, lifetimeOrdinal} => match right[at] {
        OperandPass.Borrow {access: other, lifetimeOrdinal: ordinal} => access == other && lifetimeOrdinal == ordinal
        _ => false
      }
    }
    if !equal { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameIntrinsicMember(left: IntrinsicMember, right: IntrinsicMember) -> bool {
  return match left {
    IntrinsicMember.Primitive {primitive} => match right {
      IntrinsicMember.Primitive {primitive: other} => primitive == other
      _ => false
    }
    IntrinsicMember.Scalar {operation} => match right {
      IntrinsicMember.Scalar {operation: other} => operation.actor == other.actor && operation.code == other.code
        && operation.target == other.target
      _ => false
    }
  }
}

fn sameWitnessImplementation(left: &WitnessImplementation, right: &WitnessImplementation) -> bool {
  return match &left.* {
    WitnessImplementation.Declaration {declaration} => match &right.* {
      WitnessImplementation.Declaration {declaration: other} => sameDeclarationShared(&declaration, &other)
      _ => false
    }
    WitnessImplementation.Intrinsic {member} => match &right.* {
      WitnessImplementation.Intrinsic {member: other} => sameIntrinsicMember(member, other)
      _ => false
    }
  }
}

fn copyWitnessImplementation(value: &WitnessImplementation) -> WitnessImplementation {
  return match &value.* {
    WitnessImplementation.Declaration {declaration} => WitnessImplementation.Declaration {declaration: Shared<DeclarationId>.clone(&declaration)}
    WitnessImplementation.Intrinsic {member} => WitnessImplementation.Intrinsic {member: member}
  }
}

fn sameWitnesses(left: &[Witness], right: &[Witness]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameDeclarationShared(&left[at].operation, &right[at].operation) || !sameWitnessImplementation(
      &left[at].implementation,
      &right[at].implementation,
    ) || !sameArguments(
      List<Argument>.asSlice(&left[at].arguments),
      List<Argument>.asSlice(&right[at].arguments),
    ) || !sameApplicationOrdinals(List<usize>.asSlice(&left[at].argumentOrdinals), List<usize>.asSlice(&right[at].argumentOrdinals))
      || !sameScopeBindings(List<ScopeBinding>.asSlice(&left[at].scopes), List<ScopeBinding>.asSlice(&right[at].scopes))
      || !sameOperandPasses(List<OperandPass>.asSlice(&left[at].operands), List<OperandPass>.asSlice(&right[at].operands)) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameImplementationMembers(left: &[ImplementationMember], right: &[ImplementationMember]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    let equal = match & left[at] {
      ImplementationMember.Inline {declaration, ..} => match & right[at] {
        ImplementationMember.Inline {declaration: other, ..} => sameDeclarationShared(
          &declaration,
          &other,
        )
        _ => false
      }
      ImplementationMember.Mapped {declaration, target, ..} => match & right[at] {
        ImplementationMember.Mapped {declaration: other, target: otherTarget, ..} => sameDeclarationShared(
          &declaration,
          &other,
        ) && sameDeclarationShared(&target, &otherTarget)
        _ => false
      }
      ImplementationMember.Intrinsic {declaration, member, ..} => match & right[at] {
        ImplementationMember.Intrinsic {declaration: other, member: otherMember, ..} => sameDeclarationShared(
          &declaration,
          &other,
        ) && sameIntrinsicMember(member, otherMember)
        _ => false
      }
    }
    if !equal {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameMemberName(left: &Option<Bytes>, right: &Option<Bytes>) -> bool {
  return match & left.* {
    Option<Bytes>.Some {value} => match & right.* {
      Option<Bytes>.Some {value: other} => same(Bytes.asSlice(&value), Bytes.asSlice(&other))
      Option<Bytes>.None => false
    }
    Option<Bytes>.None => match & right.* {
      Option<Bytes>.Some {..} => false
      Option<Bytes>.None => true
    }
  }
}

fn sameMembers(left: &[Member], right: &[Member]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameMemberName(&left[at].name, &right[at].name) || left[at].isPublic != right[at].isPublic || left[at].kind != right[at].kind || !sameEnumCase(
      &left[at].discriminant,
      &right[at].discriminant,
    ) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameEnumCase(left: &Option<EnumCase>, right: &Option<EnumCase>) -> bool {
  return match & left.* {
    Option<EnumCase>.Some {value} => match & right.* {
      Option<EnumCase>.Some {value: other} => value.sign == other.sign && value.magnitude == other.magnitude
      Option<EnumCase>.None => false
    }
    Option<EnumCase>.None => match & right.* {
      Option<EnumCase>.Some {..} => false
      Option<EnumCase>.None => true
    }
  }
}

fn sameValue(left: &Value, right: &Value) -> bool {
  return match & left.* {
    Value.Name {bucket} => match & right.* {
      Value.Name {bucket: other} => sameBuckets(&bucket, &other)
      _ => false
    }
    Value.Namespace {module, ordinal} => match & right.* {
      Value.Namespace {module: other, ordinal: position} => ModuleId.equals(&module, &other) && ordinal == position
      _ => false
    }
    Value.Selected {declaration, module, handle} => match & right.* {
      Value.Selected {declaration: other, module: selected, handle: position} => DeclarationId.equals(
        &declaration,
        &other,
      ) && module == selected && handle == position
      _ => false
    }
    Value.Type {resolved} => match & right.* {
      Value.Type {resolved: other} => sameReusableType(&resolved, &other)
      _ => false
    }
    Value.Property {property} => match & right.* {
      Value.Property {property: other} => property == other
      _ => false
    }
    Value.ParameterSchema {schema} => match &right.* {
      Value.ParameterSchema {schema: other} => sameParameterSchema(&schema, &other)
      _ => false
    }
    Value.ParameterDefault {..} => false
    Value.Members {identity, members, enumRepresentation} => match & right.* {
      Value.Members {identity: otherIdentity, members: other, enumRepresentation: otherRepresentation} => sameDeclarationShared(&identity, &otherIdentity) && enumRepresentation == otherRepresentation && sameMembers(
        List<Member>.asSlice(&members),
        List<Member>.asSlice(&other),
      )
      _ => false
    }
    Value.Contract {contract} => match & right.* {
      Value.Contract {contract: other} => sameContract(&contract, &other)
      _ => false
    }
    Value.Operations {operations, defaults} => match & right.* {
      Value.Operations {operations: other, defaults: otherDefaults} => sameDeclarationList(
        List<Shared<DeclarationId>>.asSlice(&operations),
        List<Shared<DeclarationId>>.asSlice(&other),
      ) && sameFlags(List<bool>.asSlice(&defaults), List<bool>.asSlice(&otherDefaults))
      _ => false
    }
    Value.OperatorInterfaces {interfaces} => match &right.* {
      Value.OperatorInterfaces {interfaces: other} => sameDeclarationList(
        List<Shared<DeclarationId>>.asSlice(&interfaces),
        List<Shared<DeclarationId>>.asSlice(&other),
      )
      _ => false
    }
    Value.Implementations {heads, ..} => match & right.* {
      Value.Implementations {heads: other, ..} => sameHeads(
        List<Shared<ImplementationHead>>.asSlice(&heads),
        List<Shared<ImplementationHead>>.asSlice(&other),
      )
      _ => false
    }
    Value.ImplementationHead {head} => match & right.* {
      Value.ImplementationHead {head: other} => sameHead(&head, &other)
      _ => false
    }
    Value.InherentMember {published, rejected} => match & right.* {
      Value.InherentMember {published: other, rejected: otherRejected} => sameMemberOption(&published, &other)
        && optionNone<Shared<Rejection>>(&rejected) && optionNone<Shared<Rejection>>(&otherRejected)
      _ => false
    }
    Value.InherentMembers {members, rejected} => match & right.* {
      Value.InherentMembers {members: other, rejected: otherRejected} => List<
        RejectedMember,
      >.length(&rejected) == usize.ZERO && List<RejectedMember>.length(&otherRejected) == usize.ZERO && sameDeclarationList(
        List<Shared<DeclarationId>>.asSlice(&members),
        List<Shared<DeclarationId>>.asSlice(&other),
      )
      _ => false
    }
    Value.ConformanceHeads {heads} => match & right.* {
      Value.ConformanceHeads {heads: other} => sameHeads(
        List<Shared<ImplementationHead>>.asSlice(&heads),
        List<Shared<ImplementationHead>>.asSlice(&other),
      )
      _ => false
    }
    Value.Coherent => match & right.* {
      Value.Coherent => true
      _ => false
    }
    Value.ProofBounds {constraints} => match & right.* {
      Value.ProofBounds {constraints: other} => sameConstraints(
        List<Constraint>.asSlice(&constraints),
        List<Constraint>.asSlice(&other),
      )
      _ => false
    }
    Value.BodyPremises {constraints} => match & right.* {
      Value.BodyPremises {constraints: other} => sameConstraints(
        List<Constraint>.asSlice(&constraints),
        List<Constraint>.asSlice(&other),
      )
      _ => false
    }
    Value.ImplementationMembers {members} => match & right.* {
      Value.ImplementationMembers {members: other} => sameImplementationMembers(
        List<ImplementationMember>.asSlice(&members),
        List<ImplementationMember>.asSlice(&other),
      )
      _ => false
    }
    Value.FieldLifetimes {count} => match & right.* {
      Value.FieldLifetimes {count: other} => count == other
      _ => false
    }
    Value.Variance {binders} => match & right.* {
      Value.Variance {binders: other} => sameVariances(List<Variance>.asSlice(&binders), List<Variance>.asSlice(&other))
      _ => false
    }
    Value.DropObservation {binders} => match & right.* {
      Value.DropObservation {binders: other} => sameDropUses(List<DropUse>.asSlice(&binders), List<DropUse>.asSlice(&other))
      _ => false
    }
    Value.Witnesses {witnesses} => match & right.* {
      Value.Witnesses {witnesses: other} => sameWitnesses(
        List<Witness>.asSlice(&witnesses),
        List<Witness>.asSlice(&other),
      )
      _ => false
    }
    Value.MemberShape {types} => match & right.* {
      Value.MemberShape {types: other} => sameTypeList(
        List<Shared<Type>>.asSlice(&types),
        List<Shared<Type>>.asSlice(&other),
      )
      _ => false
    }
    Value.Signature {signature} => match & right.* {
      Value.Signature {signature: other} => sameSignature(&signature, &other)
      _ => false
    }
    Value.Initializer {..} => false
    Value.Condition {holds} => match & right.* {
      Value.Condition {holds: other} => holds == other
      _ => false
    }
    Value.PhaseOnly {holds} => match & right.* {
      Value.PhaseOnly {holds: other} => holds == other
      _ => false
    }
    Value.CleanupFree {holds} => match & right.* {
      Value.CleanupFree {holds: other} => holds == other
      _ => false
    }
    Value.StaticRouting {holds} => match & right.* {
      Value.StaticRouting {holds: other} => holds == other
      _ => false
    }
    Value.BodyFacts {..} => false
    Value.ProfileInput {slot} => match & right.* {
      Value.ProfileInput {slot: other} => slot == other
      _ => false
    }
    // A validated body replay retains this immutable payload. An executed-body edit creates
    // a different payload even when its signature and returned value stay equal.
    Value.Body {body, ..} => match &right.* {
      Value.Body {body: other, ..} => sameAllocation<TypedBody>(&body, &other)
      _ => false
    }
    Value.Tests {catalog} => match &right.* {
      Value.Tests {catalog: other} => sameTestCatalog(&catalog, &other)
      _ => false
    }
    Value.Mir {..} => false
    Value.Layout {..} => false
    Value.LayoutUnsupported => false
    Value.OriginPlan {..} => false
    Value.OriginEvidence {..} => false
    Value.EmissionInputs {..} => false
    Value.LlvmText {..} => false
    Value.Unsupported {..} => false
    Value.CanonicalizationFailed {..} => false
  }
}

fn sameParameterSchemaWith(first: &ParameterSchema, right: &Shared<ParameterSchema>) -> bool {
  return Shared<ParameterSchema>.with<bool>(right, fn(second: &ParameterSchema) -> bool {
    return DeclarationId.equals(&first.declaration, &second.declaration) &&
      sameReusableType(&first.ty, &second.ty) && first.isPublic == second.isPublic &&
      first.hasDefault == second.hasDefault && first.hasValidation == second.hasValidation
  })
}

fn sameParameterSchema(left: &Shared<ParameterSchema>, right: &Shared<ParameterSchema>) -> bool {
  if sameAllocation<ParameterSchema>(left, right) { return true }
  return Shared<ParameterSchema>.with<bool>(left, fn(first: &ParameterSchema) -> bool {
    return sameParameterSchemaWith(first, right)
  })
}

fn copyConstraint(constraint: &Constraint) -> Constraint {
  return match & constraint.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: Shared<Type>.clone(&provider),
      contract: Shared<Type>.clone(&contract),
    }
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: Shared<Type>.clone(&parameter),
      contract: Shared<Type>.clone(&contract),
    }
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: Shared<Type>.clone(&subject),
      region: Shared<Lifetime>.clone(&region),
    }
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: Shared<Lifetime>.clone(&longer),
      shorter: Shared<Lifetime>.clone(&shorter),
    }
    Constraint.Copyable {subject} => Constraint.Copyable {subject: Shared<Type>.clone(&subject)}
    Constraint.ThreadSafe {subject, property} => Constraint.ThreadSafe {
      subject: Shared<Type>.clone(&subject),
      property: property,
    }
    Constraint.Property {subject, property} => Constraint.Property {
      subject: Shared<Type>.clone(&subject),
      property: property,
    }
    Constraint.Provides {provider, selector, source} => Constraint.Provides {
      provider: Shared<Type>.clone(&provider),
      selector: Shared<Row>.clone(&selector),
      source: Shared<Row>.clone(&source),
    }
    Constraint.FailureSubset {selected, source} => Constraint.FailureSubset {
      selected: Shared<Type>.clone(&selected),
      source: Shared<Type>.clone(&source),
    }
    Constraint.RequirementSubset {selected, source} => Constraint.RequirementSubset {
      selected: Shared<Row>.clone(&selected),
      source: Shared<Row>.clone(&source),
    }
  }
}

effect fn copyConstraints(values: &[Constraint]) -> List<Constraint>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = List<Constraint>.make()
  run appendConstraints(&mut copied, values)
  return move copied
}

effect fn appendConstraints(target: &mut List<Constraint>, values: &[Constraint]) -> ()
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run List<Constraint>.append(&mut target.*, copyConstraint(&values[at]))
    at = at + usize.ONE
  }
}

effect fn copySlots(slots: &[usize]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<usize>.make()
  let mut at = usize.ZERO
  while at < slots.length {
    run List<usize>.append(&mut copied, slots[at])
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyScopeBindings(values: &[ScopeBinding]) -> List<ScopeBinding> ! OutOfMemoryError ? &mut Allocator {
  let mut output = List<ScopeBinding>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run List<ScopeBinding>.append(&mut output, run ScopeBinding.copy(&values[at]))
    at = at + usize.ONE
  }
  return move output
}

effect fn recordRoot(
  request: &mut Request,
  family: Family,
  module: &ModuleId,
  name: &[u8],
  answer: &Shared<Result<Answer, NoRejection>>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  request.demanded = true
  run List<Root>.append(
    &mut request.roots,
    Root {
      family: family,
      module: ModuleId.copy(module),
      name: run Bytes.copy(name),
      answer: Shared<Result<Answer, NoRejection>>.clone(answer),
    },
  )
  return ()
}

impl Request {
  /// Creates an empty ledger for one independent semantic request.
  pub fn make() -> Request {
    return Request {
      roots: List<Root>.make(),
      application: Option<ModuleId>.none(),
      schemaModules: List<ModuleId>.make(),
      demanded: false,
    }
  }
  /// Creates a request whose sealed application import selects this canonical module.
  pub fn forApplication(application: ModuleId) -> Request {
    return Request {
      roots: List<Root>.make(),
      application: Option<ModuleId>.some(move application),
      schemaModules: List<ModuleId>.make(),
      demanded: false,
    }
  }
  /// Borrows the application selected by this request's sealed application import.
  pub fn applicationModule(self: &Self) -> Option<&ModuleId> {
    return match &self.application {
      Option<ModuleId>.Some {value} => Option<&ModuleId>.some(&value)
      Option<ModuleId>.None => Option<&ModuleId>.none()
    }
  }
  /// Registers one canonical module whose package parameter headers must enter this request.
  /// Imports and their local aliases do not register a module.
  pub effect fn registerSchemaModule(self: &mut Self, id: &ModuleId) -> ()
  ! RegistrationClosed | ConflictingPackageSource | OutOfMemoryError
  ? &mut Allocator {
    if self.demanded {
      fail RegistrationClosed {}
    }
    let registered = List<ModuleId>.asSlice(&self.schemaModules)
    let mut at = usize.ZERO
    let mut position = registered.length
    while at < registered.length {
      if ModuleId.equals(&registered[at], id) {
        return ()
      }
      if ModuleId.samePackage(&registered[at], id) && !ModuleId.sameOrigin(&registered[at], id) {
        fail ConflictingPackageSource {}
      }
      if position == registered.length && ModuleId.compare(id, &registered[at]) < 0 {
        position = at
      }
      at = at + usize.ONE
    }
    run List<ModuleId>.insert(&mut self.schemaModules, position, ModuleId.copy(id))
    return ()
  }
  /// Borrows the modules explicitly registered before the request's first demand.
  pub fn registeredSchemaModules(self: &Self) -> &[ModuleId] {
    return List<ModuleId>.asSlice(&self.schemaModules)
  }
  /// Reports whether this exact canonical module has been registered.
  pub fn hasRegisteredSchemaModule(self: &Self, id: &ModuleId) -> bool {
    let registered = List<ModuleId>.asSlice(&self.schemaModules)
    let mut at = usize.ZERO
    while at < registered.length {
      if ModuleId.equals(&registered[at], id) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Drops the roots demanded so far and the answers they hold. A long-lived request, such as a
  /// language server's, forgets them after each check so old answers do not accumulate.
  /// Registration stays closed.
  pub fn forgetRoots(self: &mut Self) -> () {
    self.roots = List<Root>.make()
    return ()
  }
  /// Returns the number of roots demanded through this request.
  pub fn rootCount(self: &Self) -> usize {
    return List<Root>.length(&self.roots)
  }
  /// Reports whether this request demanded the named root.
  pub fn hasRoot(self: &Self, family: Family, module: &ModuleId, name: &[u8]) -> bool {
    let roots = List<Root>.asSlice(&self.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if roots[at].family == family && ModuleId.equals(&roots[at].module, module) && same(
        Bytes.asSlice(&roots[at].name),
        name,
      ) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
}

// The unit whose completed answer `answer` is, or `usize.MAX` for an answer made outside a unit.
fn rootUnit(store: &mut Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let mut unit = usize.ZERO
  while unit < List<ScopedKey>.length(&store.resolver.keys) {
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move Query.completed(&mut store.query, Hash.word(usize.toU64(unit))) {
      if sameAllocation<Result<Answer, NoRejection>>(&value, answer) {
        return unit
      }
    }
    unit = unit + usize.ONE
  }
  return usize.MAX
}

// Whether `unit`, or a unit whose result it consumed, is keyed by `family` in module `ordinal`.
fn reachesDemand(resolver: &mut Resolver, unit: usize, family: Family, ordinal: usize) -> bool {
  if !Graph.visit(&mut resolver.graph, unit) {
    return false
  }
  let scoped = List<ScopedKey>.get(&resolver.keys, unit)
  if scoped.key.family == family && scoped.key.module == ordinal {
    return true
  }
  let mut edge = Graph.firstEdgeOf(&resolver.graph, unit)
  while edge != usize.MAX {
    let dependee = Graph.dependeeOf(&resolver.graph, edge)
    if let Dependee.UnitResult {unit: child} = &dependee {
      if reachesDemand(&mut resolver.*, child, family, ordinal) {
        return true
      }
    }
    edge = Graph.nextEdgeOf(&resolver.graph, edge)
  }
  return false
}

// Whether `unit`, or a unit whose result it consumed, read the source of module `ordinal`.
fn reachesSource(resolver: &mut Resolver, unit: usize, ordinal: usize) -> bool {
  if !Graph.visit(&mut resolver.graph, unit) {
    return false
  }
  let mut edge = Graph.firstEdgeOf(&resolver.graph, unit)
  while edge != usize.MAX {
    let dependee = Graph.dependeeOf(&resolver.graph, edge)
    match &dependee {
      Dependee.SourceFile {module} => {
        if module == ordinal {
          return true
        }
      }
      Dependee.SourceInput {module, ..} => {
        if module == ordinal { return true }
      }
      Dependee.UnitResult {unit: child} => {
        if reachesSource(&mut resolver.*, child, ordinal) {
          return true
        }
      }
    }
    edge = Graph.nextEdgeOf(&resolver.graph, edge)
  }
  return false
}


fn sameKey(left: Key, right: Key) -> bool {
  if left.family == Family.Layout || right.family == Family.Layout {
    return left.family == Family.Layout && right.family == Family.Layout && left.name == right.name
  }
  if left.family == Family.LlvmText || right.family == Family.LlvmText {
    return left.family == right.family && left.name == right.name
  }
  if left.family == Family.Mir || left.family == Family.EmissionInputs || right.family == Family.Mir || right.family == Family.EmissionInputs {
    return left.family == right.family && left.name == right.name && left.module == right.module && left.declaration == right.declaration
  }
  return left.family == right.family && left.module == right.module && left.name == right.name && left.declaration == right.declaration && left.member == right.member && left.external == right.external
}

effect fn internApplication(resolver: &mut Resolver, application: &Shared<Type>) -> usize
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let hashed = Type.hash(application)
  let known = List<Shared<Type>>.asSlice(&resolver.applications)
  let mut at = InternIndex.first(&resolver.applicationLookup, hashed)
  while at != usize.MAX {
    if run Type.equalsShared(&known[at], application) {
      return at
    }
    at = InternIndex.after(&resolver.applicationLookup, at)
  }
  let interned = known.length
  run List<Shared<Type>>.append(&mut resolver.applications, Shared<Type>.clone(application))
  run InternIndex.record(&mut resolver.applicationLookup, hashed)
  return interned
}

// One handle interned up to lifetime erasure, retained so its address stays unique.
struct ErasedHandle {
  ty: Shared<Type>,
  address: usize,
  ordinal: usize,
}

// A handle interned before answers by its address; any other handle is hashed and compared
// structurally once, then remembered.
effect fn internErasedType(resolver: &mut Resolver, ty: &Shared<Type>) -> usize
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let address = Shared<Type>.with<usize>(ty, typeAddress)
  let handles = List<ErasedHandle>.asSlice(&resolver.erasedHandles)
  let mut seen = InternIndex.first(&resolver.erasedHandleLookup, usize.toU64(address))
  while seen != usize.MAX {
    if handles[seen].address == address {
      return handles[seen].ordinal
    }
    seen = InternIndex.after(&resolver.erasedHandleLookup, seen)
  }
  let ordinal = run internErasedStructure(&mut resolver.*, ty)
  run List<ErasedHandle>.append(&mut resolver.erasedHandles,
    ErasedHandle {ty: Shared<Type>.clone(ty), address: address, ordinal: ordinal})
  run InternIndex.record(&mut resolver.erasedHandleLookup, usize.toU64(address))
  return ordinal
}

effect fn internErasedStructure(resolver: &mut Resolver, ty: &Shared<Type>) -> usize
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let hashed = Type.hash(ty)
  let known = List<Shared<Type>>.asSlice(&resolver.erasedTypes)
  let mut at = InternIndex.first(&resolver.erasedTypeLookup, hashed)
  while at != usize.MAX {
    if run Type.runtimeEqualsShared(&known[at], ty) {
      return at
    }
    at = InternIndex.after(&resolver.erasedTypeLookup, at)
  }
  let interned = known.length
  run List<Shared<Type>>.append(&mut resolver.erasedTypes, Shared<Type>.clone(ty))
  run InternIndex.record(&mut resolver.erasedTypeLookup, hashed)
  return interned
}

// One backend query subject: an instance, lowered for a program that does or does not observe
// diagnostics (failure observer note N1), and emitted with its suspension facts when it is
// suspendable. Neither the program mode nor the facts are part of the instance's identity; MIR is
// lowered once per mode and shared by every suspension variant. Every region pattern of an
// application shares the subject and the body of the first pattern reached: lifetimes never decide
// which code runs (IMPL-007), so no lowering depends on a pattern's regions.
struct BackendInstance {
  key: InstanceKey,
  observing: bool,
  suspension: Option<CoroutineFacts>,
}

effect fn sameSuspension(left: &Option<CoroutineFacts>, right: &Option<CoroutineFacts>) -> bool
! OutOfMemoryError ? &mut Allocator {
  if let Option<CoroutineFacts>.Some {value: first} = &left.* {
    if let Option<CoroutineFacts>.Some {value: second} = &right.* { return run CoroutineFacts.equals(&first, &second) }
    return false
  }
  return match &right.* {
    Option<CoroutineFacts>.Some {..} => false
    Option<CoroutineFacts>.None => true
  }
}

effect fn copySuspension(value: &Option<CoroutineFacts>) -> Option<CoroutineFacts> ! OutOfMemoryError ? &mut Allocator {
  if let Option<CoroutineFacts>.Some {value: facts} = &value.* {
    return Option<CoroutineFacts>.some(run CoroutineFacts.copy(&facts))
  }
  return Option<CoroutineFacts>.none()
}

effect fn internBackendInstance(resolver: &mut Resolver, instance: &InstanceKey, observing: bool) -> usize
! OutOfMemoryError
? &mut Allocator {
  return run internBackendVariant(&mut resolver.*, instance, observing, &Option<CoroutineFacts>.none())
}

effect fn internBackendVariant(resolver: &mut Resolver, instance: &InstanceKey, observing: bool,
  suspension: &Option<CoroutineFacts>) -> usize
! OutOfMemoryError
? &mut Allocator {
  let hashed = InstanceKey.runtimeHash(instance)
  let known = List<BackendInstance>.asSlice(&resolver.backendInstances)
  let mut at = InternIndex.first(&resolver.backendInstanceLookup, hashed)
  while at != usize.MAX {
    let sameVariant = run sameSuspension(&known[at].suspension, suspension)
    if sameVariant && known[at].observing == observing && run InstanceKey.sameInstance(&known[at].key, instance) {
      return at
    }
    at = InternIndex.after(&resolver.backendInstanceLookup, at)
  }
  let interned = known.length
  run List<BackendInstance>.append(&mut resolver.*.backendInstances,
    BackendInstance {key: InstanceKey.copy(instance), observing: observing, suspension: run copySuspension(suspension)})
  run InternIndex.record(&mut resolver.backendInstanceLookup, hashed)
  return interned
}

// The backend instance of one exact application, lowered from that application's own key. Region
// patterns of one application share a backend instance under `internBackendVariant`, whose MIR is
// lowered from the first pattern interned, and its references carry that pattern's regions. A
// build walk enters each application under the pattern it reaches first and follows that
// pattern's own MIR, so what it reaches, and what its record replays, never depends on which
// pattern a check interned first.
effect fn exactBackendVariant(resolver: &mut Resolver, instance: &InstanceKey, observing: bool,
  suspension: &Option<CoroutineFacts>) -> usize
! OutOfMemoryError
? &mut Allocator {
  let hashed = InstanceKey.runtimeHash(instance)
  let known = List<BackendInstance>.asSlice(&resolver.backendInstances)
  let mut at = InternIndex.first(&resolver.backendInstanceLookup, hashed)
  while at != usize.MAX {
    let sameVariant = run sameSuspension(&known[at].suspension, suspension)
    if sameVariant && known[at].observing == observing && run InstanceKey.sameApplication(&known[at].key, instance) {
      return at
    }
    at = InternIndex.after(&resolver.backendInstanceLookup, at)
  }
  let interned = known.length
  run List<BackendInstance>.append(&mut resolver.*.backendInstances,
    BackendInstance {key: InstanceKey.copy(instance), observing: observing, suspension: run copySuspension(suspension)})
  run InternIndex.record(&mut resolver.backendInstanceLookup, hashed)
  return interned
}

fn applicationLength(value: &Type) -> usize {
  return match & value.* {
    Type.Nominal {arguments, ..} => List<Argument>.length(&arguments)
    _ => usize.MAX
  }
}

fn applicationArgument(value: &Type, at: usize) -> Option<Argument> {
  return match & value.* {
    Type.Nominal {arguments, ..} => {
      let entries = List<Argument>.asSlice(&arguments)
      if at >= entries.length {
        return Option<Argument>.none()
      }
      return match & entries[at] {
        Argument.Type {value: ty} => Option<Argument>.some(
          Argument.Type {value: Shared<Type>.clone(&ty)},
        )
        Argument.Lifetime {value: lifetime} => Option<Argument>.some(
          Argument.Lifetime {value: Shared<Lifetime>.clone(&lifetime)},
        )
        Argument.Row {value: row} => Option<Argument>.some(
          Argument.Row {value: Shared<Row>.clone(&row)},
        )
      }
    }
    _ => Option<Argument>.none()
  }
}

fn applicationMatches(value: &Type, declaration: &DeclarationId) -> bool {
  return match & value.* {
    Type.Nominal {declaration: owner, ..} => DeclarationId.equals(&owner, declaration)
    _ => false
  }
}

effect fn internModule(resolver: &mut Resolver, module: &ModuleId) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = knownModuleOrdinal(&resolver.*, module)
  if known != usize.MAX {
    return known
  }
  let interned = List<ModuleId>.length(&resolver.modules)
  run List<ModuleId>.append(&mut resolver.modules, ModuleId.copy(module))
  run InternIndex.record(&mut resolver.moduleLookup, ModuleId.hash(module))
  return interned
}

effect fn selectRequest(resolver: &mut Resolver, request: &Request) -> ()
! Cycle | OutOfMemoryError
? &mut Allocator {
  run reconcileSources(&mut resolver.*)
  resolver.currentApplication = usize.MAX
  if let Option<ModuleId>.Some {value: application} = &request.application {
    resolver.currentApplication = run internModule(&mut resolver.*, &application)
  }
  return ()
}

effect fn internName(resolver: &mut Resolver, name: &[u8]) -> usize
! OutOfMemoryError
? &mut Allocator {
  let symbol = run StringTable.intern(&mut resolver.names, name)
  return symbol.index
}

// The condition evaluation that a newly demanded key runs under. A condition starts its own
// context; every other demand inherits its parent's. Layout and conditions are context-free.
fn demandContext(resolver: &Resolver, key: Key) -> usize {
  if key.family == Family.Condition || key.family == Family.Layout {
    return usize.MAX
  }
  let active = List<Word>.asSlice(&resolver.active)
  if active.length == usize.ZERO {
    return usize.MAX
  }
  let parentWord = u64.toUsize(active[active.length - usize.ONE].value)
  let parent = List<ScopedKey>.get(&resolver.keys, parentWord)
  if parent.key.family == Family.Condition {
    return parentWord
  }
  return parent.condition
}

struct OriginPhase {
  phase: usize,
  plan: usize,
  application: usize,
}
impl Copy for OriginPhase {}

// Context comes from query ancestry, not mutable resolver flags. Drafts, partial solving and
// exact replay have separate arenas even when they demand identical body-derived signatures.
fn privateOriginPhase(resolver: &Resolver) -> OriginPhase {
  let active = List<Word>.asSlice(&resolver.active)
  let keys = List<ScopedKey>.asSlice(&resolver.keys)
  let mut at = active.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let key = keys[u64.toUsize(active[at].value)].key
    if key.family == Family.OriginDraft { return OriginPhase {phase: usize.ONE, plan: usize.MAX, application: key.name} }
    if key.family == Family.OriginSolve { return OriginPhase {phase: 2, plan: key.name, application: key.member - usize.ONE} }
    if key.family == Family.OriginValidate { return OriginPhase {phase: 3, plan: key.name, application: key.member - usize.ONE} }
  }
  return OriginPhase {phase: usize.ZERO, plan: usize.MAX, application: usize.MAX}
}

struct OriginContext {
  active: bool,
  key: Key,
}
impl Copy for OriginContext {}
fn sameOriginContext(first: &OriginContext, second: &OriginContext) -> bool {
  return first.active == second.active && (!first.active || sameKey(first.key, second.key))
}
fn originContext(resolver: &Resolver, key: Key) -> OriginContext {
  if key.family == Family.OriginGraph { return OriginContext {active: false, key: key} }
  if key.family == Family.OriginDraft || key.family == Family.OriginSolve || key.family == Family.OriginValidate {
    return OriginContext {active: true, key: key}
  }
  let active = List<Word>.asSlice(&resolver.active)
  if active.length == usize.ZERO { return OriginContext {active: false, key: key} }
  let keys = List<ScopedKey>.asSlice(&resolver.keys)
  let inherited = keys[u64.toUsize(active[active.length - usize.ONE].value)].origin
  if key.family == Family.Body && key.member == usize.ZERO && inherited.active
    && inherited.key.family == Family.OriginDraft {
    // An ordinary draft checks the authored symbolic body without selected substitution.
    // Reuse that evidence across applications of the same source declaration. Residual
    // drafts and every solve/validate body retain their complete transaction context.
    return OriginContext {active: true, key: Key {family: Family.OriginDraft, module: key.module,
      name: usize.MAX, declaration: key.declaration, member: usize.ZERO, external: false}}
  }
  return inherited
}

effect fn internKey(resolver: &mut Resolver, key: Key) -> Word ! OutOfMemoryError ? &mut Allocator {
  let mut application = resolver.currentApplication
  let mut profile = resolver.profileSlot
  let mut context = demandContext(&resolver.*, key)
  let mut origin = originContext(&resolver.*, key)
  if key.family == Family.LlvmText {
    // Every semantic, profile and target input is already in this immutable content subject.
    // Request scopes must not cause the same definition to be produced more than once.
    application = usize.MAX
    profile = usize.MAX
    context = usize.MAX
    origin = OriginContext {active: false, key: key}
  }
  let scoped = ScopedKey {
    key: key,
    application: application,
    profile: profile,
    condition: context,
    origin: origin,
  }
  let hashed = hashScopedKey(&scoped)
  let known = List<ScopedKey>.asSlice(&resolver.keys)
  let mut at = InternIndex.first(&resolver.keyLookup, hashed)
  while at != usize.MAX && !sameScopedKey(&known[at], &scoped) {
    at = InternIndex.after(&resolver.keyLookup, at)
  }
  if at != usize.MAX {
    return Hash.word(usize.toU64(at))
  }
  let interned = List<ScopedKey>.length(&resolver.keys)
  run List<ScopedKey>.append(&mut resolver.keys, scoped)
  run InternIndex.record(&mut resolver.keyLookup, hashed)
  return Hash.word(usize.toU64(interned))
}

effect fn rejectWithRelated(
  resolver: &Resolver,
  module: &ModuleId,
  code: RejectionCode,
  span: Span,
  related: Option<RelatedSite>,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  diagnostic.related = move related
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether a type-suffixed literal's decimal `amount` has a fraction or an exponent while its
// `suffix` names an integer type (`i8` through `usize`).
fn floatAmountIntegerSuffix(amount: &[u8], suffix: &[u8]) -> bool {
  if suffix.length == usize.ZERO || (suffix[usize.ZERO] != 'i' && suffix[usize.ZERO] != 'u') { return false }
  if amount.length > usize.ONE && amount[usize.ZERO] == '0' {
    let base = amount[usize.ONE]
    if base == 'x' || base == 'X' || base == 'b' || base == 'B' || base == 'o' || base == 'O' { return false }
  }
  let mut at = usize.ZERO
  while at < amount.length {
    if amount[at] == '.' || amount[at] == 'e' || amount[at] == 'E' { return true }
    at = at + usize.ONE
  }
  return false
}

/// A syntax rejection, naming the token a missing-token diagnostic required (PAR0001), and filling
/// a lexical failure's holes from `holes`, the source text it names (`SourceIndex.sourceHoles`).
pub effect fn syntaxRejection(module: &ModuleId, code: RejectionCode, span: Span, detail: DiagnosticDetail, holes: &[Bytes])
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  match detail {
    DiagnosticDetail.Token {kind} => {
      if code == RejectionCode.MissingToken {
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"Token"),
          value: run Bytes.copy(String.utf8Bytes(Token.describe(kind)))})
      }
    }
    DiagnosticDetail.Lexical {diagnostic: failure} => {
      // The holes a lexical failure fills without its source text (LEX0004, LEX0007, LEX0012).
      match failure {
        LexicalDiagnostic.MissingBaseDigits {radix, span: _} => {
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"radix"),
            value: run decimalText(u8.toUsize(radix))})
        }
        LexicalDiagnostic.CharacterLiteralScalarCount {scalars, span: _} => {
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"scalars"),
            value: run decimalText(scalars)})
        }
        // The holes a lexical failure fills from the source text it names (LEX0002, LEX0003, LEX0009-LEX0014).
        LexicalDiagnostic.UnknownLiteralModifier {..} => { run appendQuotedHole(&mut diagnostic, b"modifier", holes, usize.ZERO) }
        LexicalDiagnostic.UnterminatedStaticLiteral {modifier: ignoredModifier, delimiter, delimiterWidth, span: ignoredSpan} => {
          let mut subject = Bytes.make()
          if holes.length > usize.ZERO && Bytes.length(&holes[usize.ZERO]) > usize.ZERO {
            let first = Bytes.asSlice(&holes[usize.ZERO])[usize.ZERO]
            if first == 98 { run Bytes.append(&mut subject, b"byte ") }
            if first == 114 { run Bytes.append(&mut subject, b"raw ") }
          }
          if delimiter == 39 {
            run Bytes.append(&mut subject, b"character")
          } else if delimiterWidth > usize.ONE {
            run Bytes.append(&mut subject, b"multi-line string")
          } else {
            run Bytes.append(&mut subject, b"string")
          }
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"subject"), value: move subject})
        }
        LexicalDiagnostic.UnknownDurationUnit {..} => { run appendQuotedHole(&mut diagnostic, b"spelling", holes, usize.ZERO) }
        LexicalDiagnostic.InvalidBaseDigit {radix, digit: ignoredDigit, span: ignoredSpan} => {
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"radix"),
            value: run decimalText(u8.toUsize(radix))})
          run appendQuotedHole(&mut diagnostic, b"digit", holes, usize.ZERO)
        }
        LexicalDiagnostic.LiteralTypeSuffix {..} => {
          run appendQuotedHole(&mut diagnostic, b"suffix", holes, usize.ZERO)
          // A fraction or exponent with an integer suffix, as `2.5e3u8`, cannot initialize that
          // integer type, so the suggested annotation names a float type (template 1).
          let mut template = b"0"
          if holes.length > usize.ONE && floatAmountIntegerSuffix(Bytes.asSlice(&holes[usize.ONE]), Bytes.asSlice(&holes[usize.ZERO])) {
            template = b"1"
          }
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"),
            value: run Bytes.copy(template)})
          if holes.length > usize.ONE {
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"),
              value: run Bytes.copy(Bytes.asSlice(&holes[usize.ZERO]))})
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"amount"),
              value: run Bytes.copy(Bytes.asSlice(&holes[usize.ONE]))})
          }
        }
        LexicalDiagnostic.RepeatedDurationUnit {..} => { run appendQuotedHole(&mut diagnostic, b"unit", holes, usize.ZERO) }
        LexicalDiagnostic.OutOfOrderDurationUnit {..} => {
          run appendQuotedHole(&mut diagnostic, b"unit", holes, usize.ZERO)
          run appendQuotedHole(&mut diagnostic, b"previous", holes, usize.ONE)
        }
        LexicalDiagnostic.SubordinateDurationOutOfRange {unit: ignoredUnit, amount: ignoredAmount, maximum, span: ignoredSpan} => {
          run appendQuotedHole(&mut diagnostic, b"unit", holes, usize.ZERO)
          if holes.length > usize.ONE {
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"amount"),
              value: run Bytes.copy(Bytes.asSlice(&holes[usize.ONE]))})
          }
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"maximum"),
            value: run decimalText(maximum)})
        }
        _ => ()
      }
    }
    DiagnosticDetail.Template {choice} => {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"),
        value: run decimalText(choice)})
    }
    DiagnosticDetail.Absent => ()
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Fills hole `name` with `holes[index]` in backticks, when the source text is there.
effect fn appendQuotedHole(diagnostic: &mut Rejection, name: &[u8], holes: &[Bytes], index: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  if index >= holes.length { return () }
  let mut value = run Bytes.copy(b"`")
  run Bytes.append(&mut value, Bytes.asSlice(&holes[index]))
  run Bytes.append(&mut value, b"`")
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(name), value: move value})
}

// The decimal spelling of `value`.
effect fn decimalText(value: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  run appendDecimal(&mut text, value)
  return move text
}

// A rejection naming an imported module's missing (SEM0014) or private (SEM0015) member, or the
// unknown type or qualifier `name` for SEM0001 and SEM0009.
effect fn memberRejection(
  resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span, target: &ModuleId, name: &[u8],
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  if code == RejectionCode.UnknownType || code == RejectionCode.UnknownActor {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: run unknownNameText(name)})
  }
  if code == RejectionCode.UnknownImportedMember || code == RejectionCode.PrivateMember {
    // A module is named as an import spells it, `util.helper`, not as its file path.
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"module"), value: run importedModuleText(resolver, module, target)})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: run Bytes.copy(name)})
  }
  if code == RejectionCode.PrivateMember {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// A module of the build's root package, which reports read other packages' names from.
fn standardRoot(resolver: &Resolver) -> Option<ModuleId> {
  return PackageGraph.standardOwner(&resolver.packages)
}

// The path `importer` writes to import `target`: `util.helper` within one package, and
// `taskcore.Store`, led by the importer's name for the dependency, for another package's module.
effect fn importedModuleText(resolver: &Resolver, importer: &ModuleId, target: &ModuleId) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let path = run TypeText.importPath(target)
  if let Option<Bytes>.Some {value: dependency} = move run PackageGraph.dependencyName(&resolver.packages, importer, target) {
    let mut text = move dependency
    run Bytes.append(&mut text, b".")
    run Bytes.append(&mut text, Bytes.asSlice(&path))
    return move text
  }
  return move path
}

// SEM0015 for a name `target` only imports: the advice names `origin`, the module that declares it.
effect fn reimportRejection(resolver: &Resolver, module: &ModuleId, span: Span, target: &ModuleId, name: &[u8],
  origin: &ModuleId) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.PrivateMember, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"module"), value: run importedModuleText(resolver, module, target)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: run Bytes.copy(name)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"origin"), value: run importedModuleText(resolver, module, origin)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  return run Shared<Rejection>.make(move diagnostic)
}

// The module declaring what the private import binding `candidate` of module `targetOrdinal`
// brings in; none for any other candidate, or an import that does not resolve.
effect fn reimportOrigin(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  targetOrdinal: usize,
  candidate: &Selection,
  span: Span,
) -> Option<ModuleId>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if candidate.count != usize.ONE || candidate.kind != CandidateKind.ImportMember { return Option<ModuleId>.none() }
  let key = run internDeclaration(&mut resolver.*, Key {family: Family.Import, module: targetOrdinal, name: usize.ZERO,
    declaration: candidate.declaration, member: candidate.member, external: false})
  let nested = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(
    &nested,
    fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) },
  )
  if let Option<usize>.Some {value: declaringOrdinal} = move binding.module {
    return Option<ModuleId>.some(resolvedModule(&resolver.*, declaringOrdinal))
  }
  return Option<ModuleId>.none()
}

// An ambiguous receiver operation (SEM0200 for a bound parameter, SEM0202 for a concrete receiver),
// naming the `member`, the receiver in the `subject` hole and the interfaces that each supply it,
// when the receiver type has an exact spelling.
effect fn ambiguousOperationRejection(
  module: &ModuleId, code: RejectionCode, span: Span, member: &[u8], subject: &[u8], provider: &Shared<Type>,
  suppliers: &[MethodSupplier],
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  if let Option<Bytes>.Some {value: receiver} = move run TypeText.display(provider, module) {
    let mut names = List<Bytes>.make()
    let mut at = usize.ZERO
    while at < suppliers.length {
      if let Option<DeclarationId>.Some {value: contract} = move Shared<Type>.with<Option<DeclarationId>>(&suppliers[at].contract, nominalOf) {
        let name = run DeclarationId.copySpelling(&contract)
        let listed = List<Bytes>.asSlice(&names)
        let mut seen = false
        let mut look = usize.ZERO
        while look < listed.length {
          if same(Bytes.asSlice(&listed[look]), Bytes.asSlice(&name)) { seen = true }
          look = look + usize.ONE
        }
        if !seen { run List<Bytes>.append(&mut names, move name) }
      }
      at = at + usize.ONE
    }
    if List<Bytes>.length(&names) > usize.ONE {
      // `interfaces` lists the suppliers; `calls` spells one qualified call per supplier.
      let mut interfaces = Bytes.make()
      let mut calls = Bytes.make()
      let listed = List<Bytes>.asSlice(&names)
      let mut joined = usize.ZERO
      while joined < listed.length {
        if joined > usize.ZERO {
          run Bytes.append(&mut interfaces, b" or ")
          run Bytes.append(&mut calls, b" or ")
        }
        run Bytes.append(&mut interfaces, Bytes.asSlice(&listed[joined]))
        run Bytes.append(&mut calls, Bytes.asSlice(&listed[joined]))
        run Bytes.append(&mut calls, b".")
        run Bytes.append(&mut calls, member)
        run Bytes.append(&mut calls, b"(...)")
        joined = joined + usize.ONE
      }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: run Bytes.copy(member)})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(subject), value: move receiver})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"interfaces"), value: move interfaces})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"calls"), value: move calls})
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The length of the name of member `at` of a members answer; zero when it has none.
fn answerMemberLength(answer: &Result<Answer, NoRejection>, at: usize) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = List<Member>.asSlice(&members)
      if at < listed.length {
        if let Option<Bytes>.Some {value: name} = &listed[at].name { return Bytes.length(&name) }
      }
    }
  }
  return usize.ZERO
}

// Copies the name of member `at` of a members answer into `target`, which has its length.
fn fillAnswerMemberName(answer: &Result<Answer, NoRejection>, at: usize, target: &mut Bytes) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = List<Member>.asSlice(&members)
      if at < listed.length {
        if let Option<Bytes>.Some {value: name} = &listed[at].name {
          let written = Bytes.asSlice(&name)
          let output = Bytes.asMutSlice(&mut target.*)
          if output.length != written.length { return false }
          let mut copied = usize.ZERO
          while copied < written.length {
            output[copied] = written[copied]
            copied = copied + usize.ONE
          }
          return true
        }
      }
    }
  }
  return false
}

// The declaration a members answer describes.
fn answerMembersOwner(answer: &Result<Answer, NoRejection>) -> Option<DeclarationId> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {identity, ..}} = &value.outcome {
      return Option<DeclarationId>.some(Shared<DeclarationId>.with<DeclarationId>(&identity, fn(held: &DeclarationId) -> DeclarationId { return DeclarationId.copy(held) }))
    }
  }
  return Option<DeclarationId>.none()
}

// An incomplete match over an enum (SEM0158) or a nominal union (SEM0044), naming the declaration
// and the members at the `uncovered` ordinals of its members answer when every one is named.
effect fn missingMembersRejection(
  module: &ModuleId, code: RejectionCode, span: Span, members: &Shared<Result<Answer, NoRejection>>, uncovered: &[usize],
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  let mut missing = Bytes.make()
  let mut named = uncovered.length > usize.ZERO
  let mut at = usize.ZERO
  while named && at < uncovered.length {
    let ordinal = uncovered[at]
    let length = Shared<Result<Answer, NoRejection>>.with<usize>(members, fn(answer: &Result<Answer, NoRejection>) -> usize { return answerMemberLength(answer, ordinal) })
    let mut name = run Bytes.zeroed(length)
    let filled = Shared<Result<Answer, NoRejection>>.with<bool>(members, fn(answer: &Result<Answer, NoRejection>) -> bool { return fillAnswerMemberName(answer, ordinal, &mut name) })
    if length == usize.ZERO || !filled { named = false }
    if at > usize.ZERO { run Bytes.append(&mut missing, b", ") }
    run Bytes.append(&mut missing, Bytes.asSlice(&name))
    at = at + usize.ONE
  }
  let owner = Shared<Result<Answer, NoRejection>>.with<Option<DeclarationId>>(members, answerMembersOwner)
  if named {
    if let Option<DeclarationId>.Some {value: declared} = move owner {
      if code == RejectionCode.MissingEnumMember {
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"enum_"), value: run DeclarationId.copySpelling(&declared)})
      }
      // A union names itself the way an enum does: "Match over Shape does not cover Square".
      if code == RejectionCode.MissingUnionMember {
        diagnostic.arguments = List<MessageArgument>.make()
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"union_"), value: run DeclarationId.copySpelling(&declared)})
      }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"missing"), value: move missing})
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether `indices` lists `index`.
fn holdsIndex(indices: &[usize], index: usize) -> bool {
  let mut at = usize.ZERO
  while at < indices.length {
    if indices[at] == index { return true }
    at = at + usize.ONE
  }
  return false
}

// An incomplete match over a structural union (SEM0044), naming the member types at the `uncovered`
// ordinals when each has an exact spelling.
effect fn missingTypesRejection(module: &ModuleId, span: Span, members: &[Shared<Type>], uncovered: &[usize]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.MissingUnionMember, module, span)
  let mut missing = Bytes.make()
  let mut named = uncovered.length > usize.ZERO
  let mut at = usize.ZERO
  while named && at < uncovered.length {
    named = uncovered[at] < members.length
    if named {
      if let Option<Bytes>.Some {value: text} = move run TypeText.display(&members[uncovered[at]], module) {
        if at > usize.ZERO { run Bytes.append(&mut missing, b", ") }
        run Bytes.append(&mut missing, Bytes.asSlice(&text))
      } else {
        named = false
      }
    }
    at = at + usize.ONE
  }
  if named { run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"missing"), value: move missing}) }
  return run Shared<Rejection>.make(move diagnostic)
}

// An import naming a module the sources do not supply (MOD0001), spelled as written.
effect fn missingModuleRejection(module: &ModuleId, span: Span, path: &PathSyntax) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  return run importPathRejection(RejectionCode.MissingModule, module, span, path)
}

// A rejection with `code` naming the module an import spells, as written.
effect fn importPathRejection(code: RejectionCode, module: &ModuleId, span: Span, path: &PathSyntax) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  return run Shared<Rejection>.make(run importPathDiagnostic(code, module, span, path))
}

effect fn importPathDiagnostic(code: RejectionCode, module: &ModuleId, span: Span, path: &PathSyntax) -> Rejection
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  let segments = List<Bytes>.asSlice(&path.segments)
  if segments.length > usize.ZERO {
    let mut written = Bytes.make()
    let mut at = usize.ZERO
    while at < segments.length {
      if at > usize.ZERO { run Bytes.append(&mut written, b".") }
      run Bytes.append(&mut written, Bytes.asSlice(&segments[at]))
      at = at + usize.ONE
    }
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"module"), value: move written})
  }
  return move diagnostic
}

// An import whose path names both a module file and a barrel file (MOD0005), naming both files.
effect fn ambiguousModuleRejection(module: &ModuleId, span: Span, path: &PathSyntax, file: &ModuleId, barrel: &ModuleId)
  -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run importPathDiagnostic(RejectionCode.AmbiguousModule, module, span, path)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"file"), value: run ModuleId.copyPath(file)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"barrel"), value: run ModuleId.copyPath(barrel)})
  return run Shared<Rejection>.make(move diagnostic)
}

// A rejection naming the module and package of an import another package does not export (MOD0003).
effect fn internalModuleRejection(module: &ModuleId, span: Span, target: &ModuleId) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InternalModule, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"module"), value: run TypeText.importPath(target)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"package"), value: run ModuleId.copyPackage(target)})
  return run Shared<Rejection>.make(move diagnostic)
}

effect fn reject(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run rejectWithRelated(resolver, module, code, span, Option<RelatedSite>.none())
}

fn staticRejectionCode(fault: StaticFault) -> RejectionCode {
  return match fault {
    StaticFault.CompileError => RejectionCode.SelectedCompileError
    StaticFault.Cycle => RejectionCode.StaticEvaluationCycle
    StaticFault.StepLimit => RejectionCode.StaticStepLimit
    StaticFault.DepthLimit => RejectionCode.StaticDepthLimit
    StaticFault.ValueLimit => RejectionCode.StaticValueLimit
    StaticFault.Unsupported => RejectionCode.Unsupported
    StaticFault.Unavailable => RejectionCode.Unsupported
    _ => RejectionCode.StaticViolation
  }
}

// The call span of the outermost frame of a static fault's call trace, if any.
fn outermostStaticCall(diagnostic: &StaticDiagnostic) -> Option<Span> {
  let trace = List<StaticExecution.TraceStep>.asSlice(&diagnostic.trace)
  if trace.length == usize.ZERO { return Option<Span>.none() }
  return Option<Span>.some(trace[usize.ZERO].span)
}

// The span of the outermost call frame when the innermost call frame of a static fault's trace
// executes a body of a module other than `module`; none otherwise.
fn foreignFaultCall(diagnostic: &StaticDiagnostic, module: &ModuleId) -> Option<Span> {
  let trace = List<StaticExecution.TraceStep>.asSlice(&diagnostic.trace)
  let mut outermost = Span.make(usize.ZERO, usize.ZERO)
  let mut framed = false
  let mut foreign = false
  let mut at = usize.ZERO
  while at < trace.length {
    if let Option<ModuleId>.Some {value: frame} = &trace[at].module {
      if !framed { outermost = trace[at].span }
      framed = true
      foreign = !ModuleId.equals(&frame, module)
    }
    at = at + usize.ONE
  }
  if !foreign { return Option<Span>.none() }
  return Option<Span>.some(outermost)
}

// A rejection a static fault carries, such as the refused checked body of a standard-library
// function the evaluation called, belongs to that function's module. When that module is owned
// elsewhere, by the toolchain or another package, this module locates the refusal at the
// outermost call frame of the fault's trace, with the refusal's own site related. A refusal in
// this package's own source stays where it is, as does one whose trace has no call frame.
effect fn relocatedStaticRejection(module: &ModuleId, rejected: Shared<Rejection>, trace: &List<StaticExecution.TraceStep>)
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let foreign = Shared<Rejection>.with<bool>(&rejected, fn(value: &Rejection) -> bool {
    return !ModuleId.samePackage(&value.module, module) || (toolchainModule(&value.module) && !toolchainModule(module))
  })
  if !foreign { return move rejected }
  let steps = List<StaticExecution.TraceStep>.asSlice(trace)
  let mut call = Option<Span>.none()
  let mut at = usize.ZERO
  while at < steps.length {
    if let Option<ModuleId>.Some {..} = &steps[at].module {
      call = Option<Span>.some(steps[at].span)
      break
    }
    at = at + usize.ONE
  }
  let span = match move call {
    Option<Span>.Some {value} => value
    Option<Span>.None => { return move rejected }
  }
  return run rejectionAtCall(module, span, move rejected)
}

// A rejection that the body of an instance reported in a module owned elsewhere, by the toolchain
// or another package, located instead at the call in `module` that requested the instance, with
// the original site related. A rejection in the requester's own package stays where it is, as
// does one requested from a module owned elsewhere or from no authored call.
effect fn requestedRejection(module: &ModuleId, span: Span, rejected: Shared<Rejection>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let foreign = Shared<Rejection>.with<bool>(&rejected, fn(value: &Rejection) -> bool {
    return !ModuleId.samePackage(&value.module, module) || (toolchainModule(&value.module) && !toolchainModule(module))
  })
  if toolchainModule(module) || span.end == usize.ZERO { return move rejected }
  if foreign { return run rejectionAtCall(module, span, move rejected) }
  // A `compileError` a static branch of this package selected stays at its own site and relates
  // the call whose static arguments selected it.
  let unrelated = Shared<Rejection>.with<bool>(&rejected, fn(value: &Rejection) -> bool {
    if let Option<RelatedSite>.None = &value.related {
      return value.code == RejectionCode.SelectedCompileError && ModuleId.equals(&value.module, module)
        && value.span.start != span.start
    }
    return false
  })
  if !unrelated { return move rejected }
  return run rejectionRelating(module, span, move rejected)
}

// `rejected` at its own site, relating `span` of `module`, the call that requested its body.
effect fn rejectionRelating(module: &ModuleId, span: Span, rejected: Shared<Rejection>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let code = Shared<Rejection>.with<RejectionCode>(&rejected, fn(value: &Rejection) -> RejectionCode { return value.code })
  let site = Shared<Rejection>.with<Span>(&rejected, fn(value: &Rejection) -> Span { return value.span })
  let mut diagnostic = run makeRejection(code, module, site)
  diagnostic.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: span})
  run copySharedArguments(&rejected, &mut diagnostic)
  return run Shared<Rejection>.make(move diagnostic)
}

// Appends the message arguments of a shared rejection to `diagnostic`.
effect fn copySharedArguments(rejected: &Shared<Rejection>, diagnostic: &mut Rejection) -> ()
! OutOfMemoryError ? &mut Allocator {
  // The shared rejection is read through pure accessors; its message arguments are copied outside them.
  let count = Shared<Rejection>.with<usize>(rejected, fn(value: &Rejection) -> usize { return List<MessageArgument>.length(&value.arguments) })
  let mut index = usize.ZERO
  while index < count {
    let name = run sharedArgumentBytes(rejected, index, true)
    let value = run sharedArgumentBytes(rejected, index, false)
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: move name, value: move value})
    index = index + usize.ONE
  }
}

// Relocates each rejection of `found` from `start` on with `requestedRejection`.
effect fn relocateRequested(found: &mut List<Shared<Rejection>>, start: usize, module: &ModuleId, span: Span) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = start
  while at < List<Shared<Rejection>>.length(&found.*) {
    let original = Shared<Rejection>.clone(&List<Shared<Rejection>>.asSlice(&found.*)[at])
    let relocated = run requestedRejection(module, span, move original)
    let mut listed = List<Shared<Rejection>>.asMutSlice(&mut found.*)
    listed[at] = move relocated
    at = at + usize.ONE
  }
}

// `rejected` located at `span` of `module`, relating its own site unless that is in the standard
// library, and keeping its message arguments.
effect fn rejectionAtCall(module: &ModuleId, span: Span, rejected: Shared<Rejection>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let code = Shared<Rejection>.with<RejectionCode>(&rejected, fn(value: &Rejection) -> RejectionCode { return value.code })
  let mut diagnostic = run makeRejection(code, module, span)
  // A site inside the standard library's own implementation, such as the template check of
  // `Format.format`, tells the caller nothing, so only a site in another package is related.
  let internal = Shared<Rejection>.with<bool>(&rejected, fn(value: &Rejection) -> bool { return toolchainModule(&value.module) })
  if !internal || toolchainModule(module) {
    diagnostic.related = Option<RelatedSite>.some(Shared<Rejection>.with<RelatedSite>(&rejected,
      fn(value: &Rejection) -> RelatedSite { return RelatedSite {module: ModuleId.copy(&value.module), span: value.span} }))
  }
  run copySharedArguments(&rejected, &mut diagnostic)
  return run Shared<Rejection>.make(move diagnostic)
}

// A copy of the name, or the value, of message argument `index` of a shared rejection.
effect fn sharedArgumentBytes(rejection: &Shared<Rejection>, index: usize, name: bool) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = Shared<Rejection>.with<usize>(rejection, fn(value: &Rejection) -> usize {
    let listed = List<MessageArgument>.asSlice(&value.arguments)
    if name { return Bytes.length(&listed[index].name) }
    return Bytes.length(&listed[index].value)
  })
  let mut copied = Bytes.make()
  let mut at = usize.ZERO
  while at < length {
    let byte = Shared<Rejection>.with<u8>(rejection, fn(value: &Rejection) -> u8 {
      let listed = List<MessageArgument>.asSlice(&value.arguments)
      if name { return Bytes.asSlice(&listed[index].name)[at] }
      return Bytes.asSlice(&listed[index].value)[at]
    })
    run Bytes.append(&mut copied, &[byte])
    at = at + usize.ONE
  }
  return move copied
}

effect fn rejectStatic(resolver: &Resolver, module: &ModuleId, diagnostic: StaticDiagnostic) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  let code = staticRejectionCode(diagnostic.fault)
  let mut span = diagnostic.span
  // A fault reached in the body of another module's function has a span in that module; this
  // module locates it at its outermost call, the first call frame of the trace.
  if let Option<Span>.Some {value: call} = move foreignFaultCall(&diagnostic, module) { span = call }
  // A selected `compileError` names its own text (SEM0177 `{detail}`), and the outermost frame of
  // the static call trace is the call in the evaluated module that selected it.
  let mut arguments = List<MessageArgument>.make()
  if code == RejectionCode.SelectedCompileError {
    if let Option<Bytes>.Some {value: text} = &diagnostic.message {
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: run Bytes.copy(Bytes.asSlice(&text))})
    }
  }
  // A budget fault names the budget every checked program runs under.
  let limits = StaticExecution.defaultLimits()
  let mut limit = usize.MAX
  if code == RejectionCode.StaticStepLimit { limit = limits.steps }
  if code == RejectionCode.StaticDepthLimit { limit = limits.depth }
  if code == RejectionCode.StaticValueLimit { limit = limits.valueBytes }
  if limit != usize.MAX {
    run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"limit"), value: run decimalText(limit)})
  }
  // An evaluation fault chooses the SEM0176 wording for its kind; the report names the expression.
  if code == RejectionCode.StaticViolation {
    let mut template: &[u8] = b""
    if diagnostic.fault == StaticFault.Overflow { template = b"3" }
    if diagnostic.fault == StaticFault.DivisionByZero { template = b"4" }
    if let Option<Bytes>.Some {value: text} = &diagnostic.message {
      template = b"5"
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: run Bytes.copy(Bytes.asSlice(&text))})
    }
    if template.length != usize.ZERO {
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
    }
  }
  let mut related = Option<RelatedSite>.none()
  if let Option<Span>.Some {value: call} = move outermostStaticCall(&diagnostic) {
    related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: call})
  }
  return run Shared<Rejection>.make(
    Rejection {
      code: code,
      module: ModuleId.copy(module),
      span: span,
      related: move related,
      path: List<Shared<DeclarationId>>.make(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.some(move diagnostic),
      specialization: List<Application>.make(),
      arguments: move arguments, owner: usize.MAX,
    },
  )
}

effect fn rejectArity(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  expected: usize,
  supplied: usize,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.TypeArity,
      module: ModuleId.copy(module),
      span: span,
      related: Option<RelatedSite>.none(),
      path: List<Shared<DeclarationId>>.make(),
      expected: expected,
      supplied: supplied,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: List<MessageArgument>.make(), owner: usize.MAX,
    },
  )
}

// The kind of a generic binder or argument as a message words it.
fn genericKindWord(kind: GenericKind) -> &'static [u8] {
  return match kind {
    GenericKind.Type => b"a type"
    GenericKind.Lifetime => b"a lifetime"
    GenericKind.Requirement => b"a requirement row"
    GenericKind.Failure => b"a failure row"
  }
}

effect fn rejectKind(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  parameter: &[u8],
  expectedKind: GenericKind,
  supplied: GenericKind,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  return run kindRejection(resolver, module, span, parameter, expectedKind, supplied, parameter.length == usize.ZERO)
}

// A generic kind mismatch (SEM0088). When `binderUse`, `parameter` (or, when empty, the span) is a
// binder written where another kind belongs, and the message names it with the kind it has and the
// kind its position wants. Otherwise `parameter` is the formal an argument was supplied for, which
// that wording does not fit, so the message keeps the catalog meaning.
effect fn kindRejection(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  parameter: &[u8],
  expectedKind: GenericKind,
  supplied: GenericKind,
  binderUse: bool,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let name = run Bytes.copy(parameter)
  let mut arguments = List<MessageArgument>.make()
  if binderUse {
    if parameter.length != usize.ZERO {
      let mut spelling = run Bytes.copy(b"`")
      if supplied == GenericKind.Requirement { run Bytes.append(&mut spelling, b"?") }
      run Bytes.append(&mut spelling, parameter)
      run Bytes.append(&mut spelling, b"`")
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: move spelling})
    }
    run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"actual"),
      value: run Bytes.copy(genericKindWord(supplied))})
    run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"expected"),
      value: run Bytes.copy(genericKindWord(expectedKind))})
  }
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.TypeArgumentKind,
      module: ModuleId.copy(module),
      span: span,
      related: Option<RelatedSite>.none(),
      path: List<Shared<DeclarationId>>.make(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: move name,
      expectedKind: expectedKind,
      suppliedKind: supplied,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: move arguments, owner: usize.MAX,
    },
  )
}

effect fn emit(resolver: &mut Resolver, kind: EventKind, key: Word) -> ()
! OutOfMemoryError
? &mut Allocator {
  if !resolver.tracing {
    return ()
  }
  let stored = List<ScopedKey>.get(&resolver.keys, u64.toUsize(key.value))
  let selected = stored.key
  run List<Event>.append(
    &mut resolver.events,
    Event {kind: kind, family: selected.family, key: u64.toUsize(key.value)},
  )
  return ()
}

fn sourceOf<'a>(
  resolver: &'a Resolver,
  answer: &Shared<Result<SourceResult, NoRejection>>,
  module: &ModuleId,
) -> Option<&'a IndexedSource> {
  return SourceIndex.source(&resolver.source, answer, module)
}

fn pendingDeclarationChange(resolver: &Resolver, module: &ModuleId) -> usize {
  let changes = List<DeclarationChange>.asSlice(&resolver.declarationChanges)
  let mut at = usize.ZERO
  while at < changes.length {
    if ModuleId.equals(&changes[at].module, module) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Intermediate published observations are reconciled in order. Deletion is irreversible even
// when the final bytes again spell the same declaration. Each completed step is retryable.
effect fn reconcileHistory(declarations: &mut DeclarationTable.DeclarationTable, change: &mut DeclarationChange) -> ()
! OutOfMemoryError ? &mut Allocator {
  while List<Observation>.length(&change.observations) > usize.ONE {
    let observations = List<Observation>.asSlice(&change.observations)
    let content = run Observation.copyContent(&observations[0])
    if let Option<Bytes>.Some {value: bytes} = move content {
      let unit = run SourceUnit.parse(&change.module, usize.ONE, move bytes)
      let next = run ModuleIndex.build(&unit, true)
      run DeclarationTable.refresh(&mut declarations.*, change.ordinal, &change.previous, &next)
      change.previous = Option<ModuleIndex>.some(move next)
    } else {
      DeclarationTable.lose(&mut declarations.*, change.ordinal)
      change.previous = Option<ModuleIndex>.none()
    }
    drop List<Observation>.remove(&mut change.observations, usize.ZERO)
  }
}

struct SourceInputUpdate {
  input: usize,
  digest: ContentHash,
}

// Source-only barrier: no semantic providers, keys, or answer publication inside this operation.
// Every pending observed module is reconciled before a client can hit a cached foreign handle.
effect fn reconcileSources(resolver: &mut Resolver) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  while List<DeclarationChange>.length(&resolver.declarationChanges) > usize.ZERO {
    let changes = List<DeclarationChange>.asSlice(&resolver.declarationChanges)
    let module = ModuleId.copy(&changes[0].module)
    let ordinal = changes[0].ordinal
    let answer = run SourceIndex.demand(&mut resolver.source, &module)
    let mut pending = List<DeclarationChange>.asMutSlice(&mut resolver.declarationChanges)
    run reconcileHistory(&mut resolver.declarations, &mut pending[0])
    let mut updates = List<SourceInputUpdate>.make()
    let inputs = List<Inputs.Input>.asSlice(&resolver.sourceInputs.inputs)
    let previous = &List<DeclarationChange>.asSlice(&resolver.declarationChanges)[0].previous
    let mut at = usize.ZERO
    while at < inputs.length {
      if inputs[at].module == ordinal {
        let mut position = usize.MAX
        let handle = Inputs.handle(&inputs[at].selector)
        if handle != usize.MAX {
          if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &module) {
            position = DeclarationTable.nextPosition(&resolver.declarations, handle, previous, IndexedSource.moduleIndex(indexed))
          }
        }
        let value = run captureInput(&resolver.*, &module, &inputs[at].selector, &answer, position)
        let digest = ContentHash.of(Bytes.asSlice(&value))
        if !Inputs.unchanged(&inputs[at], digest) {
          run List<SourceInputUpdate>.append(&mut updates, SourceInputUpdate {input: at, digest: digest})
        }
      }
      at = at + usize.ONE
    }
    // All snapshot allocation precedes invalidation and final handle publication. markOutdated
    // itself reserves its traversal before mutation; failure leaves this pending entry retryable.
    run Graph.sourceChanged(&mut resolver.graph, ordinal)
    let changed = List<SourceInputUpdate>.asSlice(&updates)
    at = usize.ZERO
    while at < changed.length {
      run Graph.inputChanged(&mut resolver.graph, changed[at].input, ordinal)
      at = at + usize.ONE
    }
    if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.source(&resolver.source, &answer, &module) {
      run DeclarationTable.refresh(&mut resolver.declarations, ordinal, previous, IndexedSource.moduleIndex(indexed))
    } else { DeclarationTable.lose(&mut resolver.declarations, ordinal) }
    // No fallible work follows refresh. Observation values and the reconciled table publish together.
    while List<SourceInputUpdate>.length(&updates) > usize.ZERO {
      let last = List<SourceInputUpdate>.length(&updates) - usize.ONE
      let update = List<SourceInputUpdate>.remove(&mut updates, last)
      let mut writable = List<Inputs.Input>.asMutSlice(&mut resolver.sourceInputs.inputs)
      writable[update.input].digest = update.digest
    }
    drop List<DeclarationChange>.remove(&mut resolver.declarationChanges, usize.ZERO)
  }
}

effect fn demandSource(resolver: &mut Resolver, module: &ModuleId) -> Shared<Result<SourceResult, NoRejection>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  run reconcileSources(&mut resolver.*)
  return run SourceIndex.demand(&mut resolver.source, module)
}

// Loads syntax and records the exact fact the caller consumes. Raw readers use source instead.
effect fn observedSource(resolver: &mut Resolver, module: &ModuleId, observed: SourceSelector) -> Shared<Result<SourceResult, NoRejection>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run demandSource(&mut resolver.*, module)
  if recordingUnit(&resolver.*) != usize.MAX {
    let ordinal = run internModule(&mut resolver.*, module)
    run recordSourceInput(&mut resolver.*, module, ordinal, &answer, move observed)
  }
  return move answer
}

// Records that the running unit read `observed` of `module`, whose ordinal is `ordinal` and whose
// loaded syntax is `answer`. A unit that reads several facts of one module loads it once.
effect fn recordSourceInput(resolver: &mut Resolver, module: &ModuleId, ordinal: usize,
  answer: &Shared<Result<SourceResult, NoRejection>>, observed: SourceSelector) -> ()
! OutOfMemoryError ? &mut Allocator {
  let selector = Inputs.settled(move observed)
  let unit = recordingUnit(&resolver.*)
  // A known input keeps the value it was captured with; only a new one is captured.
  let mut input = Inputs.find(&resolver.sourceInputs, ordinal, &selector)
  if input == usize.MAX {
    let mut position = usize.MAX
    let handle = Inputs.handle(&selector)
    if handle != usize.MAX {
      position = DeclarationTable.position(&resolver.declarations, handle)
    }
    // The captured value is only hashed, so its encoding buffers come from a bump arena.
    let mut arena = Arena.withOptions(Allocator.systemAllocatorProvider(),
      ArenaOptions {firstChunkBytes: 16384, maximumChunkBytes: 65536})
    let value = run captureInput(&resolver.*, module, &selector, answer, position) |> Effect.provideMut<Allocator>(&mut arena)
    let text = Inputs.text(&selector, sourceOf(&resolver.*, answer, module), position)
    input = run Inputs.add(&mut resolver.sourceInputs, ordinal, move selector, ContentHash.of(Bytes.asSlice(&value)), text)
  } else {
    drop selector
  }
  run Graph.record(&mut resolver.graph, unit, Dependee.SourceInput {input: input, module: ordinal})
}

// What `selector` of `module` reads now. A resolution reads the selected package graph; any other
// selector reads the module's loaded syntax `answer`.
effect fn captureInput(resolver: &Resolver, module: &ModuleId, selector: &SourceSelector,
  answer: &Shared<Result<SourceResult, NoRejection>>, position: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if let SourceSelector.Resolution {path} = &selector.* { return run captureResolution(resolver, module, Bytes.asSlice(&path)) }
  return run Inputs.capture(selector, sourceOf(resolver, answer, module), position)
}

// The value of a resolution input: both files `path` can name (MODULE-007), each with whether
// `module` may import it. It reads the package graph, never `module`'s source.
effect fn captureResolution(resolver: &Resolver, module: &ModuleId, path: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = Bytes.make()
  run captureCandidate(resolver, module, &mut output, run Effect.result(PackageGraph.target(&resolver.packages, module, path)))
  run captureCandidate(resolver, module, &mut output, run Effect.result(PackageGraph.barrel(&resolver.packages, module, path)))
  return move output
}

effect fn captureCandidate(resolver: &Resolver, module: &ModuleId, output: &mut Bytes,
  resolved: Result<ModuleId, InvalidModulePath | OutOfMemoryError>) -> () ! OutOfMemoryError ? &mut Allocator {
  match move resolved {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value: target} => {
      run StableKey.module(&mut output.*, &target)
      let visible = run PackageGraph.exported(&resolver.packages, module, &target)
      let mut access: &[u8] = b"internal"
      if visible { access = b"exported" }
      run RuntimeEncoding.field(&mut output.*, access)
    }
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidModulePath invalid => { run RuntimeEncoding.field(&mut output.*, b"invalid") }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return ()
}

// The unit a demand or source read is recorded against: the running provider's, else the module
// check recording root demands, else none (`usize.MAX`). A one-shot store records nothing.
fn recordingUnit(resolver: &Resolver) -> usize {
  if !Graph.recording(&resolver.graph) { return usize.MAX }
  let count = List<Word>.length(&resolver.active)
  if count > usize.ZERO { return u64.toUsize(List<Word>.get(&resolver.active, count - usize.ONE).value) }
  return resolver.rootRecorder
}

effect fn observedName(resolver: &mut Resolver, module: &ModuleId, name: &[u8], selection: bool) -> Shared<Result<SourceResult, NoRejection>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if recordingUnit(&resolver.*) == usize.MAX {
    return run demandSource(&mut resolver.*, module)
  }
  let spelling = run Bytes.copy(name)
  if selection { return run observedSource(&mut resolver.*, module, SourceSelector.Selection {spelling: move spelling}) }
  return run observedSource(&mut resolver.*, module, SourceSelector.Name {spelling: move spelling})
}

effect fn observedDeclaration(resolver: &mut Resolver, module: &ModuleId, position: usize, facet: SourceFacet) -> Shared<Result<SourceResult, NoRejection>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if recordingUnit(&resolver.*) == usize.MAX {
    return run demandSource(&mut resolver.*, module)
  }
  let answer = run demandSource(&mut resolver.*, module)
  return run observedDeclarationIn(&mut resolver.*, module, move answer, position, facet)
}

// `observedDeclaration` for a recording unit that already loaded `module` as `answer`.
effect fn observedDeclarationIn(resolver: &mut Resolver, module: &ModuleId, answer: Shared<Result<SourceResult, NoRejection>>,
  position: usize, facet: SourceFacet) -> Shared<Result<SourceResult, NoRejection>>
! OutOfMemoryError ? &mut Allocator {
  let ordinal = run internModule(&mut resolver.*, module)
  let mut handle = DeclarationTable.cached(&resolver.declarations, ordinal, position)
  if handle == usize.MAX {
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      if position < declarations.length {
        let identity = DeclarationId.copy(&declarations[position].identity)
        handle = run DeclarationTable.intern(&mut resolver.declarations, ordinal, position, &identity)
      }
    }
  }
  run recordSourceInput(&mut resolver.*, module, ordinal, &answer, SourceSelector.Declaration {handle: handle, facet: facet})
  return move answer
}

// Every syntax traversal retains its actual declaration/member/body subject, including foreign
// nodes. No active-family whitelist can turn a raw load into an untracked read.
effect fn observedMember(resolver: &mut Resolver, module: &ModuleId, position: usize, member: usize)
-> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, position, SourceFacet.Alive)
  if recordingUnit(&resolver.*) == usize.MAX { return move answer }
  let ordinal = knownModuleOrdinal(&resolver.*, module)
  let handle = DeclarationTable.cached(&resolver.declarations, ordinal, position)
  run recordSourceInput(&mut resolver.*, module, ordinal, &answer, SourceSelector.Member {handle: handle, ordinal: member})
  return move answer
}

effect fn observedSyntax(resolver: &mut Resolver, module: &ModuleId, id: HirId)
-> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run demandSource(&mut resolver.*, module)
  if recordingUnit(&resolver.*) == usize.MAX { return move answer }
  let mut found = Option<SourceSyntax.Subject>.none()
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    found = run SourceSyntax.subject(value, id)
  }
  if let Option<SourceSyntax.Subject>.Some {value: subject} = move found {
    if subject.body { return run observedDeclarationIn(&mut resolver.*, module, move answer, subject.position, SourceFacet.Body) }
    if subject.member != usize.MAX { return run observedMember(&mut resolver.*, module, subject.position, subject.member) }
    return run observedDeclarationIn(&mut resolver.*, module, move answer, subject.position, SourceFacet.Header)
  }
  // Recovery/unowned syntax stays explicitly protected; absence never invents a narrow subject.
  return run source(&mut resolver.*, module)
}

effect fn observedRange(resolver: &mut Resolver, module: &ModuleId, range: Range)
-> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run demandSource(&mut resolver.*, module)
  if recordingUnit(&resolver.*) == usize.MAX { return move answer }
  let mut children = List<HirId>.make()
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < range.length {
      run List<HirId>.append(&mut children, Module.child(hir, range, at))
      at = at + usize.ONE
    }
  }
  let listed = List<HirId>.asSlice(&children)
  let mut at = usize.ZERO
  while at < listed.length {
    drop run observedSyntax(&mut resolver.*, module, listed[at])
    at = at + usize.ONE
  }
  // The parent syntax read guards the list's membership, including an empty list.
  return move answer
}

effect fn scopedHeader(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError ? &mut Allocator {
  return run observedHeader(&mut resolver.*, module, ordinal, SourceFacet.Header)
}

effect fn source(resolver: &mut Resolver, module: &ModuleId) -> Shared<
  Result<SourceResult, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run demandSource(&mut resolver.*, module)
  let unit = recordingUnit(&resolver.*)
  // Only a recording graph needs the module's ordinal, which costs an interning lookup.
  if unit != usize.MAX {
    let ordinal = run internModule(&mut resolver.*, module)
    run Graph.record(&mut resolver.graph, unit, Dependee.SourceFile {module: ordinal})
  }
  return move answer
}

effect fn declarationAt(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  DeclarationId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Alive)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      return Option<DeclarationId>.some(DeclarationId.copy(&declarations[ordinal].identity))
    }
  }
  return Option<DeclarationId>.none()
}

fn pathText(hir: &Module, path: HirId, other: HirId) -> bool {
  if let Node.Path {segments} = Module.node(hir, path) {
    if let Node.Path {segments: compared} = Module.node(hir, other) {
      if segments.length != compared.length {
        return false
      }
      let mut at = usize.ZERO
      while at < segments.length {
        let left = Module.node(hir, Module.child(hir, segments, at))
        let right = Module.node(hir, Module.child(hir, compared, at))
        if let Node.Name {text} = left {
          if let Node.Name {text: otherText} = right {
            if !same(Module.text(hir, text), Module.text(hir, otherText)) {
              return false
            }
          } else {
            return false
          }
        } else {
          return false
        }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

// The selected member name of one import-member candidate, as written before any alias.
fn importedMemberName(hir: &Module, header: HirId, ordinal: usize) -> HirRef {
  if let Node.ImportHeader {members, ..} = Module.node(hir, header) {
    if members.present && ordinal < members.range.length {
      if let Node.ImportMember {name, ..} = Module.node(
        hir,
        Module.child(hir, members.range, ordinal),
      ) {
        return HirRef.of(name)
      }
    }
  }
  return HirRef.absent()
}

fn sameWrittenName(hir: &Module, left: HirRef, right: HirRef) -> bool {
  if !left.present || !right.present {
    return false
  }
  if let Node.Name {text} = Module.node(hir, left.id) {
    if let Node.Name {text: otherText} = Module.node(hir, right.id) {
      return same(Module.text(hir, text), Module.text(hir, otherText))
    }
  }
  return false
}

// IMPORT-006: importing an identical binding twice is one binding. Admitted candidate `limit`
// repeats an earlier admitted one when both are imports of the same kind and visibility, naming
// the same module path and, for a member import, the same selected member.
fn repeatsImport(
  hir: &Module,
  declarations: &[IndexedDeclaration],
  candidates: &[Candidate],
  admitted: &[usize],
  limit: usize,
) -> bool {
  let current = &candidates[admitted[limit]]
  if current.kind == CandidateKind.Declaration {
    return false
  }
  let mut position = usize.ZERO
  while position < limit {
    let earlier = &candidates[admitted[position]]
    if earlier.kind == current.kind && earlier.isPublic == current.isPublic {
      let earlierHeader = declarations[earlier.declaration].header
      let currentHeader = declarations[current.declaration].header
      if let Node.ImportHeader {path: earlierPath, ..} = Module.node(hir, earlierHeader) {
        if let Node.ImportHeader {path: currentPath, ..} = Module.node(hir, currentHeader) {
          let samePath = pathText(hir, earlierPath, currentPath)
          let sameMember = current.kind == CandidateKind.ImportModule || sameWrittenName(
            hir,
            importedMemberName(hir, earlierHeader, earlier.ordinal),
            importedMemberName(hir, currentHeader, current.ordinal),
          )
          if samePath && sameMember {
            return true
          }
        }
      }
    }
    position = position + usize.ONE
  }
  return false
}

// Whether the import whose header is `header` in `module`'s `hir` names `module` itself.
effect fn importsItself(resolver: &Resolver, module: &ModuleId, hir: &Module, header: HirId) -> bool
! OutOfMemoryError ? &mut Allocator {
  if let Node.ImportHeader {path, ..} = Module.node(hir, header) {
    if let Node.Path {segments} = Module.node(hir, path) {
      let mut written = Bytes.make()
      let mut length = b".silk".length
      let mut at = usize.ZERO
      while at < segments.length {
        if let Node.Name {text} = Module.node(hir, Module.child(hir, segments, at)) { length = length + Module.text(hir, text).length + usize.ONE }
        at = at + usize.ONE
      }
      run Bytes.reserveExact(&mut written, length)
      at = usize.ZERO
      while at < segments.length {
        if let Node.Name {text} = Module.node(hir, Module.child(hir, segments, at)) {
          if at > usize.ZERO { run Bytes.append(&mut written, b"/") }
          run Bytes.append(&mut written, Module.text(hir, text))
        } else {
          return false
        }
        at = at + usize.ONE
      }
      run Bytes.append(&mut written, b".silk")
      if PackageGraph.targetsItself(&resolver.packages, module, Bytes.asSlice(&written)) { return true }
      // A barrel module is also named by its directory's path (MODULE-007).
      if !ModuleId.withPath<bool>(module, PackageGraph.isBarrel) { return false }
      let barrel = run PackageGraph.barrelPath(Bytes.asSlice(&written))
      return PackageGraph.targetsItself(&resolver.packages, module, Bytes.asSlice(&barrel))
    }
  }
  return false
}

// One written candidate of a name, copied out of the source loan before its arm is selected.
struct WrittenCandidate {
  candidate: usize,
  declaration: usize,
  conditional: bool,
  span: Span,
  // Whether the candidate is a member of an import of its own module.
  selfImport: bool,
}

impl Copy for WrittenCandidate {}

fn emptySelection() -> Selection {
  return Selection {
    count: usize.ZERO,
    publicCount: usize.ZERO,
    declaration: usize.ZERO,
    member: usize.ZERO,
    kind: CandidateKind.Declaration,
    span: Span {start: usize.ZERO, end: usize.ZERO},
    isPublic: false,
    repeat: Span {start: usize.ZERO, end: usize.ZERO},
    declarationsOnly: true,
  }
}

// MODULE-STATIC-001/002: a candidate in an unselected module-level `static if` arm is absent, and
// a repeated import counts once among admitted candidates only. Each governing condition becomes
// the caller's dependency; any failed condition fails the whole lookup, even when another
// candidate is admitted.
effect fn select(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  name: &[u8],
  external: bool,
) -> Result<Selection, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut written = List<WrittenCandidate>.make()
  let answer = run observedName(&mut resolver.*, module, name, true)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    let candidates = ModuleIndex.listCandidates(index)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(value)
    let mut at = ModuleIndex.firstCandidateNamed(index, name)
    while at != usize.MAX {
      let mut selfImport = false
      if candidates[at].kind != CandidateKind.Declaration {
        selfImport = run importsItself(&resolver.*, module, hir, declarations[candidates[at].declaration].header)
      }
      let conditional = match &declarations[candidates[at].declaration].arm {
        Option<Arm>.Some {..} => true
        Option<Arm>.None => false
      }
      run List<WrittenCandidate>.append(&mut written, WrittenCandidate {
        candidate: at, declaration: candidates[at].declaration, conditional: conditional,
        span: Module.span(hir, candidates[at].local), selfImport: selfImport,
      })
      at = ModuleIndex.nextCandidateNamed(index, at)
    }
  }
  drop answer
  let mut admitted = List<usize>.make()
  let listed = List<WrittenCandidate>.asSlice(&written)
  // IMPORT-001: MOD0002 rejects a self-import, so beside another binding of the name it binds
  // nothing: it neither collides with the module's own declaration nor reaches importers twice.
  let mut otherwise = false
  let mut scan = usize.ZERO
  while scan < listed.length {
    if !listed[scan].selfImport { otherwise = true }
    scan = scan + usize.ONE
  }
  let mut at = usize.ZERO
  while at < listed.length {
    if otherwise && listed[at].selfImport {
      at = at + usize.ONE
      continue
    }
    let mut present = true
    if listed[at].conditional {
      let outcome = run available(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, module, listed[at].declaration, listed[at].span,
      )
      present = match move outcome {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => {
          return Result<Selection, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    if present {
      run List<usize>.append(&mut admitted, listed[at].candidate)
    }
    at = at + usize.ONE
  }
  let mut chosen = emptySelection()
  let reread = run observedName(&mut resolver.*, module, name, true)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &reread, module) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(value))
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let present = List<usize>.asSlice(&admitted)
    let mut count = usize.ZERO
    let mut publicCount = usize.ZERO
    let mut position = usize.ZERO
    while position < present.length {
      let at = present[position]
      if !repeatsImport(hir, declarations, candidates, present, position) {
        count = count + usize.ONE
        if count == 2 { chosen.repeat = Module.span(hir, candidates[at].local) }
        if candidates[at].kind != CandidateKind.Declaration { chosen.declarationsOnly = false }
        if candidates[at].isPublic {
          publicCount = publicCount + usize.ONE
        }
        if count == usize.ONE || (external && candidates[at].isPublic && !chosen.isPublic) {
          chosen.declaration = candidates[at].declaration
          chosen.member = candidates[at].ordinal
          chosen.kind = candidates[at].kind
          chosen.span = Module.span(hir, candidates[at].local)
          chosen.isPublic = candidates[at].isPublic
        }
      }
      position = position + usize.ONE
    }
    // INTR-001: the sealed `Intrinsic` namespace is bound in every module, so a declaration or
    // import binding that name always collides with it.
    if count > usize.ZERO && same(name, b"Intrinsic") {
      count = count + usize.ONE
      chosen.declarationsOnly = false
    }
    chosen.count = count
    chosen.publicCount = publicCount
  }
  return Result<Selection, Shared<Rejection>>.succeed(chosen)
}

// A module name claimed more than once: two declarations repeat a name (SEM0003, at the second,
// related to the first); a binding that meets an import or `Intrinsic` collides (SEM0016).
effect fn nameCollision(resolver: &Resolver, module: &ModuleId, selection: Selection, name: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  if selection.declarationsOnly {
    return run rejectWithRelated(resolver, module, RejectionCode.DuplicateDeclarationName, selection.repeat,
      Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: selection.span}))
  }
  return run bindingCollision(module, selection, name)
}

// Two bindings of one spelling where at least one is an import (SEM0016). The collision is
// reported once, at the second binding, naming the spelling and noting the first; every use of
// the spelling in the module reports this same site, so the uses add no diagnostics of their own.
effect fn bindingCollision(module: &ModuleId, selection: Selection, name: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  // A sealed binding such as `Intrinsic` has no written site: report at the one written binding.
  if selection.repeat.end <= selection.repeat.start || selection.span.end <= selection.span.start {
    let mut site = selection.repeat
    if site.end <= site.start { site = selection.span }
    let mut sealed = run makeRejection(RejectionCode.Collision, module, site)
    run List<MessageArgument>.append(&mut sealed.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: run Bytes.copy(name)})
    return run Shared<Rejection>.make(move sealed)
  }
  let mut diagnostic = run makeRejection(RejectionCode.Collision, module, selection.repeat)
  diagnostic.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: selection.span})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: run Bytes.copy(name)})
  return run Shared<Rejection>.make(move diagnostic)
}

// MODULE-STATIC-003: configuration precedes module selection. A package parameter written in a
// module-level `static if` arm is found by syntax alone, so no condition is evaluated to reject it.
effect fn conditionalParameterSpan(resolver: &mut Resolver, module: &ModuleId, name: &[u8]) -> Option<Span>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedName(&mut resolver.*, module, name, true)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    let candidates = ModuleIndex.listCandidates(index)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(value)
    let mut at = ModuleIndex.firstCandidateNamed(index, name)
    while at != usize.MAX {
      let ordinal = candidates[at].declaration
      if DeclarationId.kind(&declarations[ordinal].identity) == OwnerKind.PackageParameter {
        if let Option<Arm>.Some {..} = &declarations[ordinal].arm {
          return Option<Span>.some(Module.span(hir, declarations[ordinal].header))
        }
      }
      at = ModuleIndex.nextCandidateNamed(index, at)
    }
  }
  return Option<Span>.none()
}

// The innermost module-level arm that admits one declaration.
effect fn armOf(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<Arm>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Arm)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<Arm>.Some {value: arm} = &declarations[ordinal].arm {
        return Option<Arm>.some(arm)
      }
    }
  }
  return Option<Arm>.none()
}

fn conditionHolds(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Condition {holds}} => holds
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// MODULE-STATIC-002: a declaration exists only when every enclosing module-level arm is selected,
// innermost first. Each governing condition is a dependency of the demand that observes it.
effect fn available(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  declaration: usize,
  span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let mut current = run armOf(&mut resolver.*, module, declaration)
  while true {
    let arm = match move current {
      Option<Arm>.Some {value} => value
      Option<Arm>.None => { return Result<bool, Shared<Rejection>>.succeed(true) }
    }
    let declarationAccess1Request = Key {
      family: Family.Condition,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: arm.conditional,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess1 = run internDeclaration(&mut resolver.*, declarationAccess1Request)
    let conditionKey = declarationAccess1
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, conditionKey, span)
    let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return Result<bool, Shared<Rejection>>.failResult(move diagnostic)
    }
    if Shared<Result<Answer, NoRejection>>.with<bool>(&answer, conditionHolds) != arm.holds {
      return Result<bool, Shared<Rejection>>.succeed(false)
    }
    current = run armOf(&mut resolver.*, module, arm.conditional)
  }
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// Whether a declaration is an `effect {}` block, whose header is the block expression itself.
effect fn effectBlockHeader(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool ! Cycle | OutOfMemoryError ? &mut Allocator {
  let found = run observedHeader(&mut resolver.*, module, ordinal, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value} = move found {
    if let Node.EffectExpression {..} = value.header { return true }
  }
  return false
}

effect fn header(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Written)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      let id = declarations[ordinal].header
      return Option<HeaderSyntax>.some(
        HeaderSyntax {header: Module.node(hir, id), span: Module.span(hir, id)},
      )
    }
  }
  return Option<HeaderSyntax>.none()
}

effect fn observedHeader(resolver: &mut Resolver, module: &ModuleId, ordinal: usize, facet: SourceFacet) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, facet)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      let id = declarations[ordinal].header
      return Option<HeaderSyntax>.some(
        HeaderSyntax {header: Module.node(hir, id), span: Module.span(hir, id)},
      )
    }
  }
  return Option<HeaderSyntax>.none()
}

effect fn path(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> PathSyntax
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedSyntax(&mut resolver.*, module, id)
  return run sourcePath(&resolver.*, module, id, &answer)
}

effect fn importPathSyntax(resolver: &mut Resolver, module: &ModuleId, ordinal: usize, id: HirId) -> PathSyntax
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Import)
  return run sourcePath(&resolver.*, module, id, &answer)
}

effect fn sourcePath(resolver: &Resolver, module: &ModuleId, id: HirId, answer: &Shared<Result<SourceResult, NoRejection>>) -> PathSyntax
! OutOfMemoryError ? &mut Allocator {
  if let Option<&IndexedSource>.Some {value} = move sourceOf(resolver, answer, module) {
    let hir = IndexedSource.authored(value)
    let span = Module.span(hir, id)
    if let Node.Path {segments} = Module.node(hir, id) {
      let mut names = List<Bytes>.make()
      let mut at = usize.ZERO
      while at < segments.length {
        let child = Module.child(hir, segments, at)
        if let Node.Name {text} = Module.node(hir, child) {
          run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text)))
        } else {
          return PathSyntax {segments: move names, span: span, valid: false}
        }
        at = at + usize.ONE
      }
      return PathSyntax {segments: move names, span: span, valid: segments.length > usize.ZERO}
    }
    return PathSyntax {segments: List<Bytes>.make(), span: span, valid: false}
  }
  return PathSyntax {
    segments: List<Bytes>.make(),
    span: Span.make(usize.ZERO, usize.ZERO),
    valid: false,
  }
}

// A written keyword's span, or the declaration's when the keyword has no recorded anchor.
fn writtenAnchor(anchor: SpanRef, declaration: Span) -> Span {
  if anchor.present { return anchor.span }
  return declaration
}

// Whether the interface or service directly enclosing `ordinal` is public.
fn contractPublic(hir: &Module, declarations: &[IndexedDeclaration], ordinal: usize) -> bool {
  if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
    return match Module.node(hir, declarations[parent].header) {
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      _ => false
    }
  }
  return false
}

// Whether every written `where` clause is a `provides` or a membership clause over failures or
// requirement rows.
fn supportedConstraints(hir: &Module, constraints: Range) -> bool {
  let mut at = usize.ZERO
  while at < constraints.length {
    let supported = match Module.node(hir, Module.child(hir, constraints, at)) {
      Node.ProviderConstraint {..} => true
      Node.MembershipConstraint {..} => true
      _ => false
    }
    if !supported { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn signatureSyntax(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  WrittenSignature,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  drop run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Parent)
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Header)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length {
      return Option<WrittenSignature>.none()
    }
    let hir = IndexedSource.authored(value)
    let declarationSpan = Module.span(hir, declarations[ordinal].header)
    // A static function is a top-level declaration, an inherent method, an interface operation or
    // its conformance's witness; a service operation runs only at runtime.
    let mut staticPosition = match & declarations[ordinal].parent {
      Option<usize>.None => true
      Option<usize>.Some {..} => false
    }
    if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
      if parent < declarations.length {
        staticPosition = match Module.node(hir, declarations[parent].header) {
          Node.ImplHeader {..} => true
          Node.InterfaceHeader {..} => true
          _ => false
        }
      }
    }
    let written = Module.node(hir, declarations[ordinal].header)
    let mut callable = Option<HirId>.none()
    let mut isPublic = false
    // Foreign headers are typed normally; backend coverage checks retain linkage gaps.
    let mut plain = true
    let mut foreign = false
    let mut linkageSpan = declarationSpan
    let mut unknown = Option<Span>.none()
    let mut misplaced = Option<Span>.none()
    // A linked function's ABI other than "C", its spelling, whether it is imported, and its name.
    let mut foreignAbi = Option<Span>.none()
    let mut abiText = Bytes.make()
    let mut imported = false
    let mut functionName = Bytes.make()
    // A `with Intrinsic.machine(features: ...)` clause of an ordinary function (SIMD-009).
    let mut features = Option<FeaturesProperty>.none()
    // The first `Intrinsic.inline()`, `inlineAlways()` or `inlineNever()` clause (FUNC-003).
    let mut inlineSpan = Option<Span>.none()
    if let Node.FunctionHeader {name: spelled, contract, linkage, properties, isPublic: visible, ..} = written {
      callable = Option<HirId>.some(contract)
      isPublic = visible
      foreign = linkage.present
      if linkage.present { linkageSpan = Module.span(hir, linkage.id) }
      if let Node.Name {text} = Module.node(hir, spelled) { functionName = run Bytes.copy(Module.text(hir, text)) }
      if linkage.present {
        if let Node.Linkage {direction, abi, ..} = Module.node(hir, linkage.id) {
          imported = direction != LinkageDirection.Export
          if let Node.TextLiteral {value: text} = Module.node(hir, abi) {
            if !same(Module.text(hir, text), b"C") {
              foreignAbi = Option<Span>.some(Module.span(hir, abi))
              abiText = run Bytes.copy(Module.text(hir, text))
            }
          }
        }
      }
      plain = linkage.present || plainProperties(hir, properties)
      unknown = unknownProperty(hir, properties)
      if !linkage.present { misplaced = misplacedProperty(hir, properties, true) }
      // An inline clause shapes how callers compile a Silk body, which a linked function has none of.
      if linkage.present { misplaced = inlineClause(hir, properties) }
      inlineSpan = inlineClause(hir, properties)
      features = featuresProperty(hir, properties)
      if linkage.present {
        if let Option<FeaturesProperty>.Some {value: property} = &features {
          misplaced = Option<Span>.some(Module.span(hir, property.clause))
        }
      }
    }
    let mut operation = false
    if let Node.OperationHeader {contract, properties, ..} = written {
      operation = true
      callable = Option<HirId>.some(contract)
      // An operation has no visibility of its own; it shares its interface's or service's.
      isPublic = contractPublic(hir, declarations, ordinal)
      plain = nonParkingProperties(hir, properties)
      unknown = unknownProperty(hir, properties)
      misplaced = misplacedProperty(hir, properties, false)
    }
    if let Node.CallableContract {..} = written {
      callable = Option<HirId>.some(declarations[ordinal].header)
    }
    if let Option<HirId>.Some {value: contract} = move callable {
      if let Node.CallableContract {
        generics,
        parameters,
        variadic,
        result,
        failures,
        requirements,
        constraints,
        isEffect,
        isTest,
        environment,
        isUnsafe,
        isStatic,
        anchors,
        ..,
      } = Module.node(hir, contract) {
        let writtenAnchors = Module.anchors(hir, anchors)
        // An ordinary build analyzes a valid test entry like any other function (TEST-002). An
        // invalid one is rejected at its first conflicting qualifier, binder, parameter or
        // success type (TEST-001).
        let mut testConflict = Option<Span>.none()
        let mut testDetail: &'static [u8] = b""
        if isTest {
          let associated = match & declarations[ordinal].parent {
            Option<usize>.None => false
            Option<usize>.Some {..} => true
          }
          let unitResult = !result.present || match Module.node(hir, result.id) { Node.UnitType => true _ => false }
          if associated {
            testConflict = Option<Span>.some(writtenAnchor(writtenAnchors.testAnchor, declarationSpan))
            testDetail = b"a test is a top-level function, not a member of a type"
          } else if isStatic {
            testConflict = Option<Span>.some(writtenAnchor(writtenAnchors.staticAnchor, declarationSpan))
            testDetail = b"a test cannot be `static`"
          } else if isUnsafe {
            testConflict = Option<Span>.some(writtenAnchor(writtenAnchors.unsafeAnchor, declarationSpan))
            testDetail = b"a test cannot be `unsafe`"
          } else if foreign {
            testConflict = Option<Span>.some(linkageSpan)
            testDetail = b"a test cannot be a foreign function"
          } else if generics.length > usize.ZERO {
            testConflict = Option<Span>.some(Module.span(hir, Module.child(hir, generics, usize.ZERO)))
            testDetail = b"a test has no type parameters; the test runner has no type to give it"
          } else if parameters.length > usize.ZERO {
            testConflict = Option<Span>.some(Module.span(hir, Module.child(hir, parameters, usize.ZERO)))
            testDetail = b"a test takes no parameters; the test runner calls it with none"
          } else if !unitResult {
            testConflict = Option<Span>.some(Module.span(hir, result.id))
            testDetail = b"a test returns `()`; to report a failure, write `test effect fn` with `! AssertionError<'static>`"
          } else if requirements.present {
            // The runner calls each test with no provider in scope, so a test cannot require one.
            testConflict = Option<Span>.some(Module.span(hir, requirements.id))
            testDetail = b"a test cannot have a requirement row; the test runner provides no services, so provide them inside the test"
          }
        }
        let mut headerConflict = Option<HeaderConflict>.none()
        let mut featureProblem = Option<HeaderConflict>.none()
        // A `static` function runs only at compile time, so no caller inlines it.
        let mut staticInline = Option<Span>.none()
        if isStatic { staticInline = move inlineSpan }
        if let Option<FeaturesProperty>.Some {value: property} = &features {
          if !foreign {
            featureProblem = run featuresConflict(&resolver.*, hir, &property, isUnsafe, isStatic, Bytes.asSlice(&functionName), declarationSpan)
          }
        }
        if let Option<Span>.Some {value: conflict} = move testConflict {
          if testDetail.length != usize.ZERO {
            headerConflict = run namedHeaderConflict(RejectionCode.InvalidTestDeclaration, conflict, b"detail", testDetail)
          } else {
            headerConflict = conflictAt(RejectionCode.InvalidTestDeclaration, conflict)
          }
        } else if let Option<Span>.Some {value: clause} = move unknown {
          headerConflict = conflictAt(RejectionCode.UnknownProperty, clause)
        } else if let Option<Span>.Some {value: clause} = move misplaced {
          headerConflict = conflictAt(RejectionCode.MisplacedProperty, clause)
        } else if let Option<HeaderConflict>.Some {value: problem} = move featureProblem {
          headerConflict = Option<HeaderConflict>.some(move problem)
        } else if let Option<Span>.Some {value: clause} = move staticInline {
          headerConflict = conflictAt(RejectionCode.MisplacedProperty, clause)
        } else if let Option<Span>.Some {value: abiSpan} = move foreignAbi {
          // Only the C ABI exists (SEM0185); the linkage names the ABI it asked for.
          headerConflict = run namedHeaderConflict(RejectionCode.UnsupportedForeignAbi, abiSpan, b"abi", Bytes.asSlice(&abiText))
        } else if foreign && generics.length > usize.ZERO {
          // A linked function has one C signature, so it has no Silk-only contract (SEM0188).
          headerConflict = run linkageRestriction(Module.span(hir, Module.child(hir, generics, usize.ZERO)), imported,
            b"generic parameters")
        } else if foreign && isStatic {
          headerConflict = run linkageRestriction(writtenAnchor(writtenAnchors.staticAnchor, declarationSpan), imported, b"static")
        } else if foreign && isEffect {
          headerConflict = run linkageRestriction(declarationSpan, imported, b"effect")
        } else if imported && !isUnsafe {
          // Calling foreign code is unsafe, so an imported function says so (SEM0186).
          headerConflict = run namedHeaderConflict(RejectionCode.ForeignFunctionRequiresUnsafe, declarationSpan, b"name",
            Bytes.asSlice(&functionName))
        } else if operation {
          // `mut` declares function-local owned storage, which a contract operation has none of.
          let mut scanned = usize.ZERO
          while scanned < parameters.length {
            let parameterId = Module.child(hir, parameters, scanned)
            if let Node.Parameter {mode, ..} = Module.node(hir, parameterId) {
              if mode == ParameterMode.Mutable {
                headerConflict = conflictAt(RejectionCode.MutableContractParameter, Module.span(hir, parameterId))
                break
              }
            }
            scanned = scanned + usize.ONE
          }
        }
        let mut params = List<HirId>.make()
        let mut parameterSpans = List<Span>.make()
        let mut receiver = Option<usize>.none()
        let mut staticSlots = List<usize>.make()
        let mut at = usize.ZERO
        while at < parameters.length {
          let parameterId = Module.child(hir, parameters, at)
          let mut accepted = false
          if let Node.Parameter {name, annotation, mode} = Module.node(hir, parameterId) {
            // Parameter mode changes the calling phase or local storage, not its declared type.
            if !isStatic || mode == ParameterMode.Value {
              if let Node.Name {text} = Module.node(hir, name) {
                if same(Module.text(hir, text), b"self") {
                  receiver = Option<usize>.some(List<HirId>.length(&params))
                }
              }
              run List<HirId>.append(&mut params, annotation)
              run List<Span>.append(&mut parameterSpans, Module.span(hir, parameterId))
              if mode == ParameterMode.Static { run List<usize>.append(&mut staticSlots, at) }
              accepted = true
            }
          }
          if !accepted {
            return Option<WrittenSignature>.some(
              WrittenSignature {
                foreign: foreign,
                isVariadic: variadic,
                generics: generics,
                parameters: move params,
                parameterSpans: move parameterSpans,
                receiver: Option<usize>.none(),
                result: Option<HirId>.none(),
                failures: failures,
                requirements: requirements,
                environment: environment,
                constraints: constraints,
                isEffect: isEffect,
                isTest: isTest,
                isUnsafe: isUnsafe,
                isStatic: isStatic,
                isPublic: isPublic,
                supported: false,
                span: Module.span(hir, parameterId),
                staticSlots: List<usize>.make(),
                headerConflict: move headerConflict,
              },
            )
          }
          at = at + usize.ONE
        }
        let mut written = Option<HirId>.none()
        if result.present {
          written = Option<HirId>.some(result.id)
        }
        return Option<WrittenSignature>.some(
          WrittenSignature {
            foreign: foreign,
            isVariadic: variadic,
            generics: generics,
            parameters: move params,
            parameterSpans: move parameterSpans,
            receiver: move receiver,
            result: move written,
            failures: failures,
            requirements: requirements,
            environment: environment,
            constraints: constraints,
            isEffect: isEffect,
            isTest: isTest,
            isUnsafe: isUnsafe,
            isStatic: isStatic,
            isPublic: isPublic,
            supported: (!variadic || foreign) && supportedConstraints(hir, constraints) && plain && (!isStatic || (!isEffect && !isUnsafe && !failures.present && !requirements.present && !environment.present && staticPosition)),
            span: Module.span(hir, contract),
            staticSlots: move staticSlots,
            headerConflict: move headerConflict,
          },
        )
      }
      return Option<WrittenSignature>.some(
        WrittenSignature {
          foreign: foreign,
          isVariadic: false,
          generics: Range.empty(),
          parameters: List<HirId>.make(),
          parameterSpans: List<Span>.make(),
          receiver: Option<usize>.none(),
          result: Option<HirId>.none(),
          failures: HirRef.absent(),
          requirements: HirRef.absent(),
          environment: RangeRef.absent(),
          constraints: Range.empty(),
          isEffect: false,
          isTest: false,
          isUnsafe: false,
          isStatic: false,
          isPublic: isPublic,
          supported: false,
          span: Module.span(hir, contract),
          staticSlots: List<usize>.make(),
          headerConflict: Option<HeaderConflict>.none(),
        },
      )
    }
    return Option<WrittenSignature>.some(
      WrittenSignature {
        foreign: foreign,
        isVariadic: false,
        generics: Range.empty(),
        parameters: List<HirId>.make(),
        parameterSpans: List<Span>.make(),
        receiver: Option<usize>.none(),
        result: Option<HirId>.none(),
        failures: HirRef.absent(),
        requirements: HirRef.absent(),
        environment: RangeRef.absent(),
        constraints: Range.empty(),
        isEffect: false,
        isTest: false,
        isUnsafe: false,
        isStatic: false,
        isPublic: false,
        supported: false,
        span: declarationSpan,
        staticSlots: List<usize>.make(),
        headerConflict: Option<HeaderConflict>.none(),
      },
    )
  }
  return Option<WrittenSignature>.none()
}

fn selectedType(answer: &Result<Answer, NoRejection>) -> TypeSelection {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.ParameterSchema {schema} => TypeSelection {
          resolved: Option<Shared<Type>>.some(Shared<ParameterSchema>.with<Shared<Type>>(&schema,
            fn(header: &ParameterSchema) -> Shared<Type> { return Shared<Type>.clone(&header.ty) })),
          rejected: Option<Shared<Rejection>>.none(),
        }
        Value.Type {resolved} => TypeSelection {
          resolved: Option<Shared<Type>>.some(Shared<Type>.clone(&resolved)),
          rejected: Option<Shared<Rejection>>.none(),
        }
        _ => TypeSelection {
          resolved: Option<Shared<Type>>.none(),
          rejected: Option<Shared<Rejection>>.none(),
        }
      }
      _ => TypeSelection {
        resolved: Option<Shared<Type>>.none(),
        rejected: answerCause(answer),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => TypeSelection {
      resolved: Option<Shared<Type>>.none(),
      rejected: Option<Shared<Rejection>>.none(),
    }
  }
}

fn importOfFact(resolver: &Resolver, fact: &Value) -> ImportSelection {
  return match & fact.* {
    Value.Namespace {module: _, ordinal} => ImportSelection {
      module: Option<usize>.some(ordinal),
      declaration: Option<usize>.none(),
      rejected: Option<Shared<Rejection>>.none(),
    }
    Value.Selected {declaration: _, module, handle} => ImportSelection {
      module: Option<usize>.some(module),
      declaration: Option<usize>.some(DeclarationTable.position(&resolver.declarations, handle)),
      rejected: Option<Shared<Rejection>>.none(),
    }
    _ => ImportSelection {
      module: Option<usize>.none(),
      declaration: Option<usize>.none(),
      rejected: Option<Shared<Rejection>>.none(),
    }
  }
}

fn selectedImport(resolver: &Resolver, answer: &Result<Answer, NoRejection>) -> ImportSelection {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => importOfFact(resolver, &fact)
      _ => ImportSelection {
        module: Option<usize>.none(),
        declaration: Option<usize>.none(),
        rejected: answerCause(answer),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => ImportSelection {
      module: Option<usize>.none(),
      declaration: Option<usize>.none(),
      rejected: Option<Shared<Rejection>>.none(),
    }
  }
}

// Keep the callback's resolver capture within this call, not on a mutable StaticPort receiver.
// ImportSelection contains owned identities/rejections; no resolver view escapes.
fn documentationImportSelection(resolver: &Resolver, answer: &Shared<Result<Answer, NoRejection>>) -> ImportSelection {
  return Shared<Result<Answer, NoRejection>>.with<ImportSelection>(answer,
    fn(value: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(resolver, value) })
}

fn dependency(key: Key) -> Dependency {
  let mut declaration = usize.MAX
  if declarationFamily(key.family) {
    declaration = key.declaration
  }
  let mut member = usize.MAX
  if key.family == Family.Import || key.family == Family.MemberShape || key.family == Family.OperationUnder {
    member = key.member
  }
  let mut name = usize.MAX
  if key.family == Family.Name {
    name = key.name
  }
  return Dependency {
    family: key.family,
    module: key.module,
    name: name,
    declaration: declaration,
    selected: member,
    external: key.external,
  }
}

effect fn cycleAnswer(resolver: &mut Resolver, key: Key, span: Span) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  resolver.pathReads = resolver.pathReads + usize.ONE
  let modules = List<ModuleId>.asSlice(&resolver.modules)
  let activeKeys = List<Word>.asSlice(&resolver.active)
  let currentScope = List<ScopedKey>.get(
    &resolver.keys,
    u64.toUsize(activeKeys[activeKeys.length - usize.ONE].value),
  )
  let current = currentScope.key
  let module = ModuleId.copy(&modules[current.module])
  let repeated = ModuleId.copy(&modules[key.module])
  let mut path = List<Shared<DeclarationId>>.make()
  let mut withinCycle = false
  let mut code = RejectionCode.Cycle
  let mut at = usize.ZERO
  while at < List<Word>.length(&resolver.active) {
    let active = List<Word>.get(&resolver.active, at)
    let existingScope = List<ScopedKey>.get(&resolver.keys, u64.toUsize(active.value))
    let existing = existingScope.key
    if sameKey(existing, key) {
      withinCycle = true
    }
    if withinCycle && existing.family == Family.Alias { code = RejectionCode.CyclicTypeAlias }
    if withinCycle && cycleMember(existing.family) {
      let ownerModule = List<ModuleId>.asSlice(&resolver.modules)
      let owner = ModuleId.copy(&ownerModule[existing.module])
      let declarationAccess2 = declarationPosition(&resolver.*, existing)
      let found = run declarationAt(&mut resolver.*, &owner, declarationAccess2)
      if let Option<DeclarationId>.Some {value} = move found {
        run List<Shared<DeclarationId>>.append(
          &mut path,
          run Shared<DeclarationId>.make(move value),
        )
      }
    }
    at = at + usize.ONE
  }
  let declarationAccess3 = declarationPosition(&resolver.*, key)
  let found = run declarationAt(&mut resolver.*, &repeated, declarationAccess3)
  if let Option<DeclarationId>.Some {value} = move found {
    run List<Shared<DeclarationId>>.append(&mut path, run Shared<DeclarationId>.make(move value))
  }
  let rejection = run Shared<Rejection>.make(
    Rejection {
      code: code,
      module: move module,
      span: span,
      related: Option<RelatedSite>.none(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: List<MessageArgument>.make(), owner: usize.MAX,
    },
  )
  return run Shared<Result<Answer, NoRejection>>.make(
    Result<Answer, NoRejection>.succeed(
      Answer {
        outcome: run rejectedOutcome(move rejection),
        dependencies: List<Dependency>.make(),
      },
    ),
  )
}

effect fn resolve(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // Body selection can recursively demand another body while checking a static condition.
  // Keep unrelated query-family result temporaries out of that active checking frame.
  if key.family == Family.Body {
    return run resolveBody(&mut resolver.*, &mut owner.*, key)
  }
  return run resolveOtherFamily(&mut resolver.*, &mut owner.*, key)
}

effect fn resolveOtherFamily(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match key.family {
    Family.Name => run resolveBucket(&mut resolver.*, &mut owner.*, key)
    Family.Import => run resolveImport(&mut resolver.*, &mut owner.*, key)
    Family.Alias => run resolveAlias(&mut resolver.*, &mut owner.*, key)
    Family.Identity => run resolveIdentity(&mut resolver.*, &mut owner.*, key)
    Family.Members => run resolveMembers(&mut resolver.*, &mut owner.*, key)
    Family.MemberShape => run resolveMemberShape(&mut resolver.*, &mut owner.*, key)
    Family.Contract => run resolveContract(&mut resolver.*, &mut owner.*, key)
    Family.Operations => run resolveOperations(&mut resolver.*, &mut owner.*, key)
    Family.OperatorInterfaces => run resolveOperatorInterfaces(&mut resolver.*, &mut owner.*, key)
    Family.Tests => run resolveTests(&mut resolver.*, &mut owner.*, key)
    Family.Implementations => run resolveImplementations(&mut resolver.*, &mut owner.*, key)
    Family.ImplementationShapes => run resolveImplementations(&mut resolver.*, &mut owner.*, key)
    Family.ImplementationShape => run resolveImplementationShape(&mut resolver.*, &mut owner.*, key)
    Family.ImplementationHead => run resolveImplementationHead(&mut resolver.*, &mut owner.*, key)
    Family.InherentMembers => run resolveInherentMembers(&mut resolver.*, &mut owner.*, key)
    Family.InherentMember => run resolveInherentMember(&mut resolver.*, &mut owner.*, key)
    Family.ConformanceHeads => run resolveConformanceHeads(&mut resolver.*, &mut owner.*, key)
    Family.ImplementationMembers => run resolveImplementationMembers(
      &mut resolver.*,
      &mut owner.*,
      key,
    )
    Family.FieldLifetimes => run resolveFieldLifetimes(&mut resolver.*, &mut owner.*, key)
    Family.Variance => run resolveVariance(&mut resolver.*, &mut owner.*, key)
    Family.DropObservation => run resolveDropObservation(&mut resolver.*, &mut owner.*, key)
    Family.Signature => run resolveSignature(&mut resolver.*, &mut owner.*, key)
    Family.OperationUnder => run resolveOperationUnder(&mut resolver.*, &mut owner.*, key)
    Family.AppliedOperation => run resolveAppliedOperation(&mut resolver.*, &mut owner.*, key)
    Family.AppliedInherent => run resolveAppliedInherent(&mut resolver.*, &mut owner.*, key)
    Family.Witnesses => run resolveWitnesses(&mut resolver.*, &mut owner.*, key)
    Family.Coherence => run resolveCoherence(&mut resolver.*, &mut owner.*, key)
    Family.ProofBounds => run resolveProofBounds(&mut resolver.*, &mut owner.*, key)
    Family.BodyPremises => run resolveBodyPremises(&mut resolver.*, &mut owner.*, key)
    Family.Constant => run resolveConstant(&mut resolver.*, &mut owner.*, key)
    Family.Initializer => run resolveInitializer(&mut resolver.*, &mut owner.*, key)
    Family.Condition => run resolveCondition(&mut resolver.*, &mut owner.*, key)
    Family.ParameterSchema => run resolveParameterSchema(&mut resolver.*, &mut owner.*, key)
    Family.ParameterDefault => run resolveParameterDefault(&mut resolver.*, &mut owner.*, key)
    Family.ProfileInput => memberSuccess(
      Value.ProfileInput {slot: resolver.profileSlot},
      List<Dependency>.make(),
    )
    Family.OriginGraph => run resolveOriginGraph(&mut resolver.*, &mut owner.*, key)
    Family.OriginDraft => run resolveOriginDraft(&mut resolver.*, &mut owner.*, key)
    Family.OriginSolve => run resolveOriginSolve(&mut resolver.*, &mut owner.*, key)
    Family.OriginValidate => run resolveOriginValidate(&mut resolver.*, &mut owner.*, key)
    Family.Body => run resolveBody(&mut resolver.*, &mut owner.*, key)
    Family.OpaqueRealization => run resolveOpaqueRealization(&mut resolver.*, &mut owner.*, key)
    Family.CallableOrigin => run resolveCallableOrigin(&mut resolver.*, &mut owner.*, key)
    Family.Mir => run lowerMir(&mut resolver.*, &mut owner.*, key)
    Family.Layout => run resolveLayout(&mut resolver.*, &mut owner.*, key)
    Family.PhaseOnly => run resolvePhaseOnly(&mut resolver.*, &mut owner.*, key)
    Family.StaticRouting => run resolveStaticRouting(&mut resolver.*, &mut owner.*, key)
    Family.BodyFacts => run resolveBodyFactsUnit(&mut resolver.*, &mut owner.*, key)
    Family.EmissionInputs => run resolveEmissionInputs(&mut resolver.*, &mut owner.*, key)
    Family.LlvmText => run resolveLlvmText(&mut resolver.*, key)
    Family.ModuleCheck => CompilerBug.panic(b"a module check runs in checkModule, never as a provider")
    Family.CleanupFree => run resolveCleanupFree(&mut resolver.*, &mut owner.*, key)
  }
}

fn sameDependency(left: Dependency, right: Dependency) -> bool {
  return left.family == right.family && left.module == right.module && left.name == right.name && left.declaration == right.declaration && left.selected == right.selected && left.external == right.external
}

fn dependencyHash(edge: Dependency) -> u64 {
  let named = Hash.combine(Hash.combine(u8.toU64(Family.value(edge.family)), usize.toU64(edge.name)), usize.toU64(edge.module))
  let placed = Hash.combine(Hash.combine(named, usize.toU64(edge.declaration)), usize.toU64(edge.selected))
  if edge.external {
    return Hash.combine(placed, 1)
  }
  return Hash.combine(placed, 0)
}

fn listsDependency(kept: &[Dependency], lookup: &InternIndex, edge: Dependency, hashed: u64) -> bool {
  let mut at = InternIndex.first(lookup, hashed)
  while at != usize.MAX {
    if sameDependency(kept[at], edge) {
      return true
    }
    at = InternIndex.after(lookup, at)
  }
  return false
}

// The exact hash of a completed answer: its successful value and its direct dependencies. None
// when the outcome is a rejection, or its value holds a part with no exact encoding; such an
// answer counts as changed whenever its unit reruns.
fn answerFingerprint(answer: &Answer) -> Option<ContentHash> {
  let mut writer = AnswerFingerprint.writer()
  match &answer.outcome {
    Outcome.Success {value} => { fingerprintValue(&mut writer, &value) }
    _ => { AnswerFingerprint.incomplete(&mut writer) }
  }
  let dependencies = List<Dependency>.asSlice(&answer.dependencies)
  AnswerFingerprint.count(&mut writer, dependencies.length)
  let mut at = usize.ZERO
  while at < dependencies.length {
    let edge = dependencies[at]
    AnswerFingerprint.text(&mut writer, familyZone(edge.family))
    AnswerFingerprint.count(&mut writer, edge.module)
    AnswerFingerprint.count(&mut writer, edge.name)
    AnswerFingerprint.count(&mut writer, edge.declaration)
    AnswerFingerprint.count(&mut writer, edge.selected)
    AnswerFingerprint.flag(&mut writer, edge.external)
    at = at + usize.ONE
  }
  return AnswerFingerprint.finish(move writer)
}

fn sealedCode(property: SealedProperty) -> u64 {
  return match property { SealedProperty.Copy => 0 SealedProperty.Drop => 1 SealedProperty.Transferable => 2 SealedProperty.Concurrent => 3 }
}

fn fingerprintConstraint(writer: &mut AnswerFingerprint.Writer, constraint: &Constraint) -> () {
  match &constraint.* {
    Constraint.Conforms {provider, contract} => {
      AnswerFingerprint.word(&mut writer.*, 0)
      AnswerFingerprint.ty(&mut writer.*, &provider)
      AnswerFingerprint.ty(&mut writer.*, &contract)
    }
    Constraint.Represents {parameter, contract} => {
      AnswerFingerprint.word(&mut writer.*, 1)
      AnswerFingerprint.ty(&mut writer.*, &parameter)
      AnswerFingerprint.ty(&mut writer.*, &contract)
    }
    Constraint.Contents {subject, region} => {
      AnswerFingerprint.word(&mut writer.*, 2)
      AnswerFingerprint.ty(&mut writer.*, &subject)
      AnswerFingerprint.lifetime(&mut writer.*, &region)
    }
    Constraint.Outlives {longer, shorter} => {
      AnswerFingerprint.word(&mut writer.*, 3)
      AnswerFingerprint.lifetime(&mut writer.*, &longer)
      AnswerFingerprint.lifetime(&mut writer.*, &shorter)
    }
    Constraint.Copyable {subject} => {
      AnswerFingerprint.word(&mut writer.*, 4)
      AnswerFingerprint.ty(&mut writer.*, &subject)
    }
    Constraint.ThreadSafe {subject, property} => {
      AnswerFingerprint.word(&mut writer.*, 5)
      AnswerFingerprint.ty(&mut writer.*, &subject)
      AnswerFingerprint.word(&mut writer.*, sealedCode(property))
    }
    Constraint.Property {subject, property} => {
      AnswerFingerprint.word(&mut writer.*, 6)
      AnswerFingerprint.ty(&mut writer.*, &subject)
      AnswerFingerprint.word(&mut writer.*, match property { IntrinsicProperty.Detached => 0 IntrinsicProperty.NonParking => 1 })
    }
    Constraint.Provides {provider, selector, source} => {
      AnswerFingerprint.word(&mut writer.*, 7)
      AnswerFingerprint.ty(&mut writer.*, &provider)
      AnswerFingerprint.row(&mut writer.*, &selector)
      AnswerFingerprint.row(&mut writer.*, &source)
    }
    Constraint.FailureSubset {selected, source} => {
      AnswerFingerprint.word(&mut writer.*, 8)
      AnswerFingerprint.ty(&mut writer.*, &selected)
      AnswerFingerprint.ty(&mut writer.*, &source)
    }
    Constraint.RequirementSubset {selected, source} => {
      AnswerFingerprint.word(&mut writer.*, 9)
      AnswerFingerprint.row(&mut writer.*, &selected)
      AnswerFingerprint.row(&mut writer.*, &source)
    }
  }
  return ()
}

fn fingerprintConstraints(writer: &mut AnswerFingerprint.Writer, constraints: &[Constraint]) -> () {
  AnswerFingerprint.count(&mut writer.*, constraints.length)
  let mut at = usize.ZERO
  while at < constraints.length {
    fingerprintConstraint(&mut writer.*, &constraints[at])
    at = at + usize.ONE
  }
  return ()
}

fn fingerprintContract(writer: &mut AnswerFingerprint.Writer, contract: &Contract) -> () {
  AnswerFingerprint.typeList(&mut writer.*, List<Shared<Type>>.asSlice(&contract.typeParameters))
  AnswerFingerprint.lifetimes(&mut writer.*, List<Shared<Lifetime>>.asSlice(&contract.lifetimeParameters))
  AnswerFingerprint.rowParameters(&mut writer.*, List<RowParameter>.asSlice(&contract.rowParameters))
  fingerprintConstraints(&mut writer.*, List<Constraint>.asSlice(&contract.constraints))
  AnswerFingerprint.optionalType(&mut writer.*, &contract.provider)
  return ()
}

fn fingerprintSignature(writer: &mut AnswerFingerprint.Writer, signature: &Signature) -> () {
  AnswerFingerprint.typeList(&mut writer.*, List<Shared<Type>>.asSlice(&signature.typeParameters))
  AnswerFingerprint.count(&mut writer.*, signature.callableParameterStart)
  AnswerFingerprint.lifetimes(&mut writer.*, List<Shared<Lifetime>>.asSlice(&signature.lifetimeParameters))
  AnswerFingerprint.rowParameters(&mut writer.*, List<RowParameter>.asSlice(&signature.rowParameters))
  fingerprintConstraints(&mut writer.*, List<Constraint>.asSlice(&signature.constraints))
  AnswerFingerprint.typeList(&mut writer.*, List<Shared<Type>>.asSlice(&signature.parameters))
  AnswerFingerprint.ty(&mut writer.*, &signature.result)
  AnswerFingerprint.ty(&mut writer.*, &signature.failure)
  AnswerFingerprint.row(&mut writer.*, &signature.requirements)
  AnswerFingerprint.flag(&mut writer.*, signature.isEffect)
  AnswerFingerprint.flag(&mut writer.*, signature.isVariadic)
  AnswerFingerprint.flag(&mut writer.*, signature.isUnsafe)
  AnswerFingerprint.flag(&mut writer.*, signature.isStatic)
  let slots = List<usize>.asSlice(&signature.staticSlots)
  AnswerFingerprint.count(&mut writer.*, slots.length)
  let mut at = usize.ZERO
  while at < slots.length {
    AnswerFingerprint.count(&mut writer.*, slots[at])
    at = at + usize.ONE
  }
  match &signature.environment {
    Option<Intersection>.Some {value} => {
      AnswerFingerprint.word(&mut writer.*, 1)
      AnswerFingerprint.intersection(&mut writer.*, &value)
    }
    Option<Intersection>.None => { AnswerFingerprint.word(&mut writer.*, 0) }
  }
  AnswerFingerprint.flag(&mut writer.*, signature.environmentWritten)
  AnswerFingerprint.count(&mut writer.*, signature.environmentExempt)
  return ()
}

fn integerTypeCode(value: StaticIntegerType) -> u64 {
  return match value {
    StaticIntegerType.U8 => 0
    StaticIntegerType.U16 => 1
    StaticIntegerType.U32 => 2
    StaticIntegerType.U64 => 3
    StaticIntegerType.Usize => 4
    StaticIntegerType.I8 => 5
    StaticIntegerType.I16 => 6
    StaticIntegerType.I32 => 7
    StaticIntegerType.I64 => 8
    StaticIntegerType.Isize => 9
  }
}

fn fingerprintMembers(writer: &mut AnswerFingerprint.Writer, members: &[Member]) -> () {
  AnswerFingerprint.count(&mut writer.*, members.length)
  let mut at = usize.ZERO
  while at < members.length {
    match &members[at].name {
      Option<Bytes>.Some {value} => {
        AnswerFingerprint.word(&mut writer.*, 1)
        AnswerFingerprint.text(&mut writer.*, Bytes.asSlice(&value))
      }
      Option<Bytes>.None => { AnswerFingerprint.word(&mut writer.*, 0) }
    }
    AnswerFingerprint.flag(&mut writer.*, members[at].isPublic)
    AnswerFingerprint.word(&mut writer.*, match members[at].kind {
      MemberKind.Field => 0 MemberKind.Position => 1 MemberKind.EnumCase => 2 MemberKind.Variant => 3 })
    match &members[at].discriminant {
      Option<EnumCase>.Some {value} => {
        AnswerFingerprint.word(&mut writer.*, 1)
        AnswerFingerprint.word(&mut writer.*, match value.sign { StaticSign.Positive => 0 StaticSign.Negative => 1 })
        AnswerFingerprint.word(&mut writer.*, value.magnitude)
      }
      Option<EnumCase>.None => { AnswerFingerprint.word(&mut writer.*, 0) }
    }
    at = at + usize.ONE
  }
  return ()
}

// A head's absolute spans are left out: every unit whose answer stores them observes where each
// sits (`observeValueLocations`), and a unit that reports one observes its diagnostic site, so a
// moved span reruns exactly the units that hold or report it.
fn fingerprintHead(writer: &mut AnswerFingerprint.Writer, head: &ImplementationHead) -> () {
  let obligations = List<HeadObligation>.asSlice(&head.obligations)
  AnswerFingerprint.count(&mut writer.*, obligations.length)
  let mut at = usize.ZERO
  while at < obligations.length {
    fingerprintConstraint(&mut writer.*, &obligations[at].bound)
    AnswerFingerprint.module(&mut writer.*, &obligations[at].module)
    at = at + usize.ONE
  }
  AnswerFingerprint.sharedDeclaration(&mut writer.*, &head.declaration)
  match &head.kind {
    ImplementationKind.Inherent => { AnswerFingerprint.word(&mut writer.*, 0) }
    ImplementationKind.Conformance => { AnswerFingerprint.word(&mut writer.*, 1) }
    ImplementationKind.Sealed {property} => {
      AnswerFingerprint.word(&mut writer.*, 2)
      AnswerFingerprint.word(&mut writer.*, sealedCode(property))
    }
  }
  fingerprintContract(&mut writer.*, &head.binders)
  fingerprintConstraints(&mut writer.*, List<Constraint>.asSlice(&head.ownerPremises))
  AnswerFingerprint.optionalType(&mut writer.*, &head.contract)
  AnswerFingerprint.ty(&mut writer.*, &head.provider)
  AnswerFingerprint.count(&mut writer.*, List<Span>.length(&head.binderSpans))
  AnswerFingerprint.count(&mut writer.*, List<Span>.length(&head.boundSpans))
  AnswerFingerprint.count(&mut writer.*, head.reified)
  return ()
}

fn fingerprintHeads(writer: &mut AnswerFingerprint.Writer, heads: &[Shared<ImplementationHead>]) -> () {
  AnswerFingerprint.count(&mut writer.*, heads.length)
  let mut at = usize.ZERO
  while at < heads.length {
    Shared<ImplementationHead>.with<()>(&heads[at], fn(head: &ImplementationHead) -> () {
      fingerprintHead(&mut writer.*, head)
      return ()
    })
    at = at + usize.ONE
  }
  return ()
}

fn valueTag(value: &Value) -> u64 {
  return match &value.* {
    Value.Namespace {..} => 1
    Value.Selected {..} => 2
    Value.Type {..} => 3
    Value.Property {..} => 4
    Value.Members {..} => 5
    Value.MemberShape {..} => 6
    Value.Contract {..} => 7
    Value.Operations {..} => 8
    Value.OperatorInterfaces {..} => 9
    Value.Implementations {..} => 10
    Value.ImplementationHead {..} => 11
    Value.InherentMembers {..} => 12
    Value.ConformanceHeads {..} => 13
    Value.Coherent => 14
    Value.ProofBounds {..} => 15
    Value.BodyPremises {..} => 16
    Value.FieldLifetimes {..} => 17
    Value.Variance {..} => 18
    Value.DropObservation {..} => 19
    Value.Signature {..} => 20
    Value.Condition {..} => 21
    Value.PhaseOnly {..} => 22
    Value.ProfileInput {..} => 23
    Value.LayoutUnsupported => 24
    Value.ImplementationMembers {..} => 25
    Value.InherentMember {..} => 26
    Value.StaticRouting {..} => 27
    Value.CleanupFree {..} => 28
    _ => 0
  }
}

// Writes one successful value. Values that hold rejections, checked bodies, arena positions or
// static data have no exact encoding here and leave the writer incomplete.
fn fingerprintValue(writer: &mut AnswerFingerprint.Writer, value: &Value) -> () {
  AnswerFingerprint.word(&mut writer.*, valueTag(value))
  match &value.* {
    Value.Namespace {module, ordinal} => {
      AnswerFingerprint.module(&mut writer.*, &module)
      AnswerFingerprint.count(&mut writer.*, ordinal)
    }
    Value.Selected {declaration, module, handle} => {
      AnswerFingerprint.declaration(&mut writer.*, &declaration)
      AnswerFingerprint.count(&mut writer.*, module)
      AnswerFingerprint.count(&mut writer.*, handle)
    }
    Value.Type {resolved} => { AnswerFingerprint.ty(&mut writer.*, &resolved) }
    Value.Property {property} => { AnswerFingerprint.word(&mut writer.*, sealedCode(property)) }
    Value.Members {identity, members, enumRepresentation} => {
      AnswerFingerprint.sharedDeclaration(&mut writer.*, &identity)
      fingerprintMembers(&mut writer.*, List<Member>.asSlice(&members))
      AnswerFingerprint.word(&mut writer.*, integerTypeCode(enumRepresentation))
    }
    Value.MemberShape {types} => { AnswerFingerprint.typeList(&mut writer.*, List<Shared<Type>>.asSlice(&types)) }
    Value.Contract {contract} => { fingerprintContract(&mut writer.*, &contract) }
    Value.Operations {operations, defaults} => {
      AnswerFingerprint.declarations(&mut writer.*, List<Shared<DeclarationId>>.asSlice(&operations))
      let flags = List<bool>.asSlice(&defaults)
      let mut flagAt = usize.ZERO
      while flagAt < flags.length {
        AnswerFingerprint.flag(&mut writer.*, flags[flagAt])
        flagAt = flagAt + usize.ONE
      }
    }
    Value.OperatorInterfaces {interfaces} => {
      AnswerFingerprint.declarations(&mut writer.*, List<Shared<DeclarationId>>.asSlice(&interfaces))
    }
    Value.Implementations {heads, ..} => { fingerprintHeads(&mut writer.*, List<Shared<ImplementationHead>>.asSlice(&heads)) }
    Value.ImplementationHead {head} => {
      Shared<ImplementationHead>.with<()>(&head, fn(selected: &ImplementationHead) -> () {
        fingerprintHead(&mut writer.*, selected)
        return ()
      })
    }
    Value.InherentMember {published, rejected} => {
      if let Option<Shared<DeclarationId>>.Some {value: member} = &published {
        AnswerFingerprint.word(&mut writer.*, 1)
        AnswerFingerprint.sharedDeclaration(&mut writer.*, &member)
      } else { AnswerFingerprint.word(&mut writer.*, 0) }
      if let Option<Shared<Rejection>>.Some {..} = &rejected { AnswerFingerprint.incomplete(&mut writer.*) }
    }
    Value.InherentMembers {members, rejected} => {
      AnswerFingerprint.declarations(&mut writer.*, List<Shared<DeclarationId>>.asSlice(&members))
      if List<RejectedMember>.length(&rejected) > usize.ZERO { AnswerFingerprint.incomplete(&mut writer.*) }
    }
    Value.ConformanceHeads {heads} => { fingerprintHeads(&mut writer.*, List<Shared<ImplementationHead>>.asSlice(&heads)) }
    Value.ImplementationMembers {members} => {
      // Spans are left out, as a head's are.
      let listed = List<ImplementationMember>.asSlice(&members)
      AnswerFingerprint.count(&mut writer.*, listed.length)
      let mut at = usize.ZERO
      while at < listed.length {
        match &listed[at] {
          ImplementationMember.Inline {declaration, ..} => {
            AnswerFingerprint.word(&mut writer.*, 0)
            AnswerFingerprint.sharedDeclaration(&mut writer.*, &declaration)
          }
          ImplementationMember.Mapped {declaration, target, ..} => {
            AnswerFingerprint.word(&mut writer.*, 1)
            AnswerFingerprint.sharedDeclaration(&mut writer.*, &declaration)
            AnswerFingerprint.sharedDeclaration(&mut writer.*, &target)
          }
          ImplementationMember.Intrinsic {..} => { AnswerFingerprint.incomplete(&mut writer.*) }
        }
        at = at + usize.ONE
      }
    }
    Value.Coherent => {}
    Value.ProofBounds {constraints} => { fingerprintConstraints(&mut writer.*, List<Constraint>.asSlice(&constraints)) }
    Value.BodyPremises {constraints} => { fingerprintConstraints(&mut writer.*, List<Constraint>.asSlice(&constraints)) }
    Value.FieldLifetimes {count} => { AnswerFingerprint.count(&mut writer.*, count) }
    Value.Variance {binders} => {
      let listed = List<Variance>.asSlice(&binders)
      AnswerFingerprint.count(&mut writer.*, listed.length)
      let mut at = usize.ZERO
      while at < listed.length {
        AnswerFingerprint.word(&mut writer.*, match listed[at] {
          Variance.Covariant => 0 Variance.Contravariant => 1 Variance.Invariant => 2 Variance.Bivariant => 3 })
        at = at + usize.ONE
      }
    }
    Value.DropObservation {binders} => {
      let listed = List<DropUse>.asSlice(&binders)
      AnswerFingerprint.count(&mut writer.*, listed.length)
      let mut at = usize.ZERO
      while at < listed.length {
        AnswerFingerprint.word(&mut writer.*, match listed[at] { DropUse.Unobserved => 0 DropUse.Dropped => 1 DropUse.Observed => 2 })
        at = at + usize.ONE
      }
    }
    Value.Signature {signature} => { fingerprintSignature(&mut writer.*, &signature) }
    Value.Condition {holds} => { AnswerFingerprint.flag(&mut writer.*, holds) }
    Value.PhaseOnly {holds} => { AnswerFingerprint.flag(&mut writer.*, holds) }
    Value.CleanupFree {holds} => { AnswerFingerprint.flag(&mut writer.*, holds) }
    Value.StaticRouting {holds} => { AnswerFingerprint.flag(&mut writer.*, holds) }
    Value.ProfileInput {slot} => { AnswerFingerprint.count(&mut writer.*, slot) }
    Value.LayoutUnsupported => {}
    Value.Initializer {value: published} => { StaticValue.fingerprint(&mut writer.*, &published) }
    _ => { AnswerFingerprint.incomplete(&mut writer.*) }
  }
  return ()
}

// Keeps the first occurrence of each direct dependency. A provider records one edge per demand,
// cache hits included; a repeated edge adds no evidence, so a completed answer keeps one.
effect fn distinctDependencies(edges: &[Dependency]) -> List<Dependency> ! OutOfMemoryError ? &mut Allocator {
  let mut kept = List<Dependency>.make()
  if edges.length == usize.ZERO { return move kept }
  run List<Dependency>.reserveExact(&mut kept, edges.length)
  let mut at = usize.ZERO
  // A short list is scanned instead of indexed.
  if edges.length <= 16 {
    while at < edges.length {
      let edge = edges[at]
      let listed = List<Dependency>.asSlice(&kept)
      let mut seen = false
      let mut each = usize.ZERO
      while each < listed.length && !seen {
        seen = sameDependency(listed[each], edge)
        each = each + usize.ONE
      }
      if !seen { run List<Dependency>.append(&mut kept, edge) }
      at = at + usize.ONE
    }
    run List<Dependency>.shrinkToFit(&mut kept)
    return move kept
  }
  let mut lookup = InternIndex.make()
  while at < edges.length {
    let edge = edges[at]
    let hashed = dependencyHash(edge)
    if !listsDependency(List<Dependency>.asSlice(&kept), &lookup, edge, hashed) {
      run List<Dependency>.append(&mut kept, edge)
      run InternIndex.record(&mut lookup, hashed)
    }
    at = at + usize.ONE
  }
  // Dependency lists are stored with their query for the rest of the compilation.
  run List<Dependency>.shrinkToFit(&mut kept)
  return move kept
}


// This unit owns every rejection it returns that no other unit has claimed. Rejections another
// unit owns are its dependencies' failures: an answer left with none of its own forwards the first
// as its unavailable cause, and only owners report diagnostics.
effect fn claimOutcome(outcome: Outcome, unit: usize) -> Outcome ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostics = List<Shared<Rejection>>.make()
  let mut partial = Option<Shared<TypedBody>>.none()
  match move outcome {
    Outcome.Rejected {diagnostics: listed, partial: kept} => {
      diagnostics = move listed
      partial = move kept
    }
    Outcome.Success {value} => { return Outcome.Success {value: move value} }
    Outcome.Unavailable {cause, partial: kept} => { return Outcome.Unavailable {cause: move cause, partial: move kept} }
  }
  let listed = List<Shared<Rejection>>.asSlice(&diagnostics)
  let mut own = List<Shared<Rejection>>.make()
  let mut cause = Option<Shared<Rejection>>.none()
  let mut forwarded = false
  let mut at = usize.ZERO
  while at < listed.length {
    let owner = Shared<Rejection>.withMut<usize>(&listed[at], fn(rejection: &mut Rejection) -> usize {
      if rejection.owner == usize.MAX {
        rejection.owner = unit
      }
      return rejection.owner
    })
    if owner == unit {
      run List<Shared<Rejection>>.append(&mut own, Shared<Rejection>.clone(&listed[at]))
    } else if !forwarded {
      cause = Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&listed[at]))
      forwarded = true
    }
    at = at + usize.ONE
  }
  if List<Shared<Rejection>>.length(&own) > usize.ZERO {
    return Outcome.Rejected {diagnostics: move own, partial: move partial}
  }
  return match move cause {
    Option<Shared<Rejection>>.Some {value} => Outcome.Unavailable {cause: move value, partial: move partial}
    Option<Shared<Rejection>>.None => Outcome.Rejected {diagnostics: move diagnostics, partial: move partial}
  }
}

fn diagnosticSiteCount(rejection: &Rejection) -> usize {
  let mut count = usize.ONE
  if let Option<RelatedSite>.Some {..} = &rejection.related { count = count + usize.ONE }
  if let Option<StaticDiagnostic>.Some {value} = &rejection.staticFailure {
    count = count + usize.ONE + List<StaticExecution.TraceStep>.length(&value.trace)
    if let Option<Span>.Some {..} = &value.origin { count = count + usize.ONE }
    if let Option<Shared<Rejection>>.Some {value: nested} = &value.rejection {
      count = count + Shared<Rejection>.with<usize>(&nested, diagnosticSiteCount)
    }
  }
  return count
}

fn diagnosticSite(rejection: &Rejection, index: usize) -> RelatedSite {
  if index == usize.ZERO { return RelatedSite {module: ModuleId.copy(&rejection.module), span: rejection.span} }
  let mut at = index - usize.ONE
  if let Option<RelatedSite>.Some {value} = &rejection.related {
    if at == usize.ZERO { return RelatedSite {module: ModuleId.copy(&value.module), span: value.span} }
    at = at - usize.ONE
  }
  if let Option<StaticDiagnostic>.Some {value} = &rejection.staticFailure {
    if at == usize.ZERO { return RelatedSite {module: ModuleId.copy(&rejection.module), span: value.span} }
    at = at - usize.ONE
    if let Option<Span>.Some {value: origin} = &value.origin {
      if at == usize.ZERO { return RelatedSite {module: ModuleId.copy(&rejection.module), span: origin} }
      at = at - usize.ONE
    }
    let trace = List<StaticExecution.TraceStep>.asSlice(&value.trace)
    if at < trace.length { return RelatedSite {module: ModuleId.copy(&rejection.module), span: trace[at].span} }
    at = at - trace.length
    if let Option<Shared<Rejection>>.Some {value: nested} = &value.rejection {
      return Shared<Rejection>.with<RelatedSite>(&nested, fn(inner: &Rejection) -> RelatedSite { return diagnosticSite(inner, at) })
    }
  }
  return RelatedSite {module: ModuleId.copy(&rejection.module), span: rejection.span}
}

effect fn observeDiagnosticSite(resolver: &mut Resolver, site: &RelatedSite) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run demandSource(&mut resolver.*, &site.module)
  let mut position = usize.MAX
  let mut selected = Option<Location>.none()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &site.module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let hir = IndexedSource.authored(indexed)
    // Declarations are listed in source order, each after its parent, so the innermost one that
    // can hold the site is the last starting at or before it, or one of that one's ancestors.
    let mut low = usize.ZERO
    let mut high = declarations.length
    while low < high {
      let middle = low + (high - low) / 2
      if Module.span(hir, declarations[middle].local).start <= site.span.start { low = middle + usize.ONE } else { high = middle }
    }
    let mut at = usize.MAX
    if low > usize.ZERO { at = low - usize.ONE }
    while at != usize.MAX {
      let span = Module.span(hir, declarations[at].local)
      if span.start <= site.span.start && site.span.end <= span.end {
        if let Option<Anchor>.Some {value: anchor} = move IndexedSource.anchorOf(indexed, at) {
          if let Option<Location>.Some {value: location} = move Anchor.findLocation(&anchor, site.span) {
            position = at
            selected = Option<Location>.some(location)
            break
          }
        }
      }
      at = match &declarations[at].parent {
        Option<usize>.Some {value} => value
        Option<usize>.None => usize.MAX
      }
    }
  }
  if let Option<Location>.Some {value: location} = move selected {
    // This subject supplies only retained coordinates; semantic content has its own input edge.
    drop run observedDeclaration(&mut resolver.*, &site.module, position, SourceFacet.Alive)
    let module = knownModuleOrdinal(&resolver.*, &site.module)
    let handle = DeclarationTable.cached(&resolver.declarations, module, position)
    drop run observedSource(&mut resolver.*, &site.module, SourceSelector.Location {handle: handle, location: location})
  } else {
    drop run observedSource(&mut resolver.*, &site.module, SourceSelector.Prefix {end: site.span.end})
  }
}

effect fn observeRejectionLocations(resolver: &mut Resolver, rejection: &Shared<Rejection>) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  let count = Shared<Rejection>.with<usize>(rejection, diagnosticSiteCount)
  let mut at = usize.ZERO
  while at < count {
    let site = Shared<Rejection>.with<RelatedSite>(rejection, fn(value: &Rejection) -> RelatedSite { return diagnosticSite(value, at) })
    run observeDiagnosticSite(&mut resolver.*, &site)
    at = at + usize.ONE
  }
}

effect fn observeOutcomeLocations(resolver: &mut Resolver, outcome: &Outcome) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  if !Graph.recording(&resolver.graph) { return () }
  match &outcome.* {
    Outcome.Rejected {diagnostics, ..} => {
      let values = List<Shared<Rejection>>.asSlice(&diagnostics)
      let mut at = usize.ZERO
      while at < values.length {
        run observeRejectionLocations(&mut resolver.*, &values[at])
        at = at + usize.ONE
      }
    }
    Outcome.Unavailable {cause, ..} => { run observeRejectionLocations(&mut resolver.*, &cause) }
    Outcome.Success {..} => {}
  }
}

// The absolute span one implementation member stores, with its module.
fn memberSite(member: &ImplementationMember) -> RelatedSite {
  return match &member.* {
    ImplementationMember.Inline {declaration, span} => siteOf(&declaration, span)
    ImplementationMember.Mapped {declaration, span, ..} => siteOf(&declaration, span)
    ImplementationMember.Intrinsic {declaration, span, ..} => siteOf(&declaration, span)
  }
}

fn siteOf(declaration: &Shared<DeclarationId>, span: Span) -> RelatedSite {
  let module = Shared<DeclarationId>.with<ModuleId>(declaration, fn(identity: &DeclarationId) -> ModuleId {
    return ModuleId.copy(DeclarationId.moduleId(identity))
  })
  return RelatedSite {module: move module, span: span}
}

fn headSiteCount(head: &ImplementationHead) -> usize {
  return 3 + List<Span>.length(&head.binderSpans) + List<Span>.length(&head.boundSpans) + List<HeadObligation>.length(&head.obligations)
}

// The `index`th absolute span a head stores, with its module.
fn headSite(head: &ImplementationHead, index: usize) -> RelatedSite {
  let site = siteOf(&head.declaration, head.span)
  let module = move site.module
  if index == usize.ZERO { return RelatedSite {module: move module, span: head.span} }
  if index == usize.ONE { return RelatedSite {module: move module, span: head.contractSpan} }
  if index == 2 { return RelatedSite {module: move module, span: head.providerSpan} }
  let mut at = index - 3
  let binders = List<Span>.asSlice(&head.binderSpans)
  if at < binders.length { return RelatedSite {module: move module, span: binders[at]} }
  at = at - binders.length
  let bounds = List<Span>.asSlice(&head.boundSpans)
  if at < bounds.length { return RelatedSite {module: move module, span: bounds[at]} }
  at = at - bounds.length
  let obligations = List<HeadObligation>.asSlice(&head.obligations)
  return RelatedSite {module: ModuleId.copy(&obligations[at].module), span: obligations[at].span}
}

effect fn observeHeadLocations(resolver: &mut Resolver, head: &Shared<ImplementationHead>) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  let count = Shared<ImplementationHead>.with<usize>(head, headSiteCount)
  let mut at = usize.ZERO
  while at < count {
    let site = Shared<ImplementationHead>.with<RelatedSite>(head, fn(value: &ImplementationHead) -> RelatedSite { return headSite(value, at) })
    run observeDiagnosticSite(&mut resolver.*, &site)
    at = at + usize.ONE
  }
}

effect fn observeHeadsLocations(resolver: &mut Resolver, heads: &[Shared<ImplementationHead>]) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < heads.length {
    run observeHeadLocations(&mut resolver.*, &heads[at])
    at = at + usize.ONE
  }
}

// A successful value that stores absolute spans observes where each sits, as a rejection's
// sites are observed: its unit's typed inputs are position-free, so a span that moves must
// rerun the unit that stored it.
effect fn observeValueLocations(resolver: &mut Resolver, outcome: &Outcome) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  if !Graph.recording(&resolver.graph) { return () }
  if let Outcome.Success {value} = &outcome.* { run observeSuccessLocations(&mut resolver.*, &value) }
}

effect fn observeSuccessLocations(resolver: &mut Resolver, value: &Value) -> ()
! Cycle | OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Value.ImplementationMembers {members} => {
      let listed = List<ImplementationMember>.asSlice(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        run observeDiagnosticSite(&mut resolver.*, &memberSite(&listed[at]))
        at = at + usize.ONE
      }
    }
    Value.ImplementationHead {head} => { run observeHeadLocations(&mut resolver.*, &head) }
    Value.Implementations {heads, ..} => { run observeHeadsLocations(&mut resolver.*, List<Shared<ImplementationHead>>.asSlice(&heads)) }
    Value.ConformanceHeads {heads} => { run observeHeadsLocations(&mut resolver.*, List<Shared<ImplementationHead>>.asSlice(&heads)) }
    Value.InherentMember {rejected, ..} => {
      if let Option<Shared<Rejection>>.Some {value: rejection} = &rejected { run observeRejectionLocations(&mut resolver.*, &rejection) }
    }
    Value.InherentMembers {rejected, ..} => {
      let listed = List<RejectedMember>.asSlice(&rejected)
      let mut at = usize.ZERO
      while at < listed.length {
        run observeRejectionLocations(&mut resolver.*, &listed[at].rejection)
        at = at + usize.ONE
      }
    }
    _ => {}
  }
}

effect fn withRunning<'a, 'b>(
  resolver: &'a mut Resolver,
  query: &'b mut Query<Answer, NoRejection>,
  key: Word,
) -> Result<Answer, NoRejection>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let base = List<Word>.length(&resolver.active)
  let bodies = List<BodyFrame>.length(&resolver.bodies)
  let outerRun = resolver.currentRun
  let walks = List<ImpliedWalk>.length(&resolver.runWalks)
  let pathFrame = readsDemandPath(List<ScopedKey>.get(&resolver.keys, u64.toUsize(key.value)).key)
  if pathFrame { resolver.pathFrames = resolver.pathFrames + usize.ONE }
  let running = Running {resolver: move resolver, query: move query, key: key, base: base, bodies: bodies, outerRun: outerRun,
    walks: walks, pathFrame: pathFrame}
  let use = effect fn(resource: &mut Running<'a, 'b>) -> Result<Answer, NoRejection>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run List<Word>.append(&mut resource.resolver.*.active, resource.key)
    resource.resolver.runs = resource.resolver.runs + usize.ONE
    resource.resolver.currentRun = resource.resolver.runs
    let unit = u64.toUsize(resource.key.value)
    run Graph.startRun(&mut resource.resolver.*.graph, unit)
    let selectedScope = List<ScopedKey>.get(&resource.resolver.keys, unit)
    let selected = selectedScope.key
    if declarationFamily(selected.family) {
      let module = resolvedModule(&resource.resolver.*, selected.module)
      drop run observedSource(&mut resource.resolver.*, &module,
        SourceSelector.Declaration {handle: selected.declaration, facet: SourceFacet.Alive})
    }
    let mut value = run resolve(&mut resource.resolver.*, &mut resource.query.*, selected)
    run observeOutcomeLocations(&mut resource.resolver.*, &value.outcome)
    run observeValueLocations(&mut resource.resolver.*, &value.outcome)
    // A provider records one edge per demand, cache hits included; the answer keeps one of each.
    value.dependencies = run distinctDependencies(List<Dependency>.asSlice(&value.dependencies))
    let claimed = Answer {outcome: run claimOutcome(move value.outcome, unit), dependencies: move value.dependencies}
    // Only a revisable store compares answers across revisions.
    let mut fingerprint = Option<ContentHash>.none()
    if Graph.recording(&resource.resolver.graph) { fingerprint = answerFingerprint(&claimed) }
    drop run Graph.finishRun(&mut resource.resolver.*.graph, unit, move fingerprint)
    return Result<Answer, NoRejection>.succeed(move claimed)
  }
  let release = effect fn(resource: &mut Running<'a, 'b>) -> () {
    List<Word>.truncate(&mut resource.resolver.*.active, resource.base)
    List<BodyFrame>.truncate(&mut resource.resolver.*.bodies, resource.bodies)
    List<ImpliedWalk>.truncate(&mut resource.resolver.*.runWalks, resource.walks)
    if resource.pathFrame { resource.resolver.pathFrames = resource.resolver.pathFrames - usize.ONE }
    resource.resolver.currentRun = resource.outerRun
    return ()
  }
  return run Effect.useReleaseNonParking(move running, move use, move release)
}

// Configured depth exhaustion belongs to this evaluation attempt, never to the source fact.
// Sending it through Query's provider failure channel releases the unpublished reservation
// while retaining the complete answer for the current demand and its dependency evidence.
struct StaticBudgetRefusal {
  answer: Result<Answer, NoRejection>,
}

fn isStaticDepthRefusal(rejection: &Rejection) -> bool {
  return match &rejection.staticFailure {
    Option<StaticDiagnostic>.Some {value} => value.fault == StaticFault.DepthLimit
    _ => false
  }
}

fn isTransientStaticBudgetAnswer(answer: &Result<Answer, NoRejection>) -> bool {
  let rejection = answerCause(answer)
  return match move rejection {
    Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value, isStaticDepthRefusal)
    _ => false
  }
}

effect fn demandRaw(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
  span: Span,
) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  run reconcileSources(&mut resolver.*)
  let word = run internKey(&mut resolver.*, key)
  let answer = run demandUnit(&mut resolver.*, &mut owner.*, key, word, span)
  if List<Word>.length(&resolver.active) == usize.ZERO && resolver.rootRecorder != usize.MAX {
    run Graph.record(&mut resolver.graph, resolver.rootRecorder, Dependee.UnitResult {unit: u64.toUsize(word.value)})
  }
  return move answer
}

// Whether an outdated `unit` is current after all: no source file or input it consumed changed
// since it was last verified, and every unit result it consumed, brought up to date in the order
// the unit consumed them, kept the answer it had then. A unit that is not outdated, or whose
// verification needs a unit that is running, is not verified.
// Whether a family's `name` and `member` are zero, a count, or a written position in syntax its
// key's declaration already names, so they mean the same in every store.
fn plainFields(family: Family) -> bool {
  return family == Family.Import || family == Family.Alias || family == Family.Identity || family == Family.Members
    || family == Family.Contract || family == Family.Operations || family == Family.OperatorInterfaces
    || family == Family.Tests || family == Family.Implementations || family == Family.ImplementationShapes
    || family == Family.ImplementationHead || family == Family.InherentMembers || family == Family.ImplementationMembers
    || family == Family.Coherence || family == Family.BodyPremises || family == Family.FieldLifetimes
    || family == Family.Variance || family == Family.DropObservation || family == Family.Signature
    || family == Family.OperationUnder || family == Family.Witnesses || family == Family.Constant
    || family == Family.ParameterSchema || family == Family.ParameterDefault || family == Family.Initializer
    || family == Family.Condition || family == Family.ProfileInput || family == Family.StaticRouting
    || family == Family.ModuleCheck
}

// The stable bytes of one unit's scoped key: its family, its scope, and each field encoded
// through what it indexes (module path, declaration content, name spelling), never an ordinal of
// this store. None when a field indexes a table with no stable form yet: type applications,
// selected applications, backend instances, LLVM inputs, origin plans and condition contexts.
// Such a unit is not persisted, and is recomputed when demanded.
effect fn stableUnit(resolver: &Resolver, unit: usize) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if unit >= List<ScopedKey>.length(&resolver.keys) { return Option<Bytes>.none() }
  let scoped = List<ScopedKey>.get(&resolver.keys, unit)
  let key = scoped.key
  if scoped.origin.active || scoped.condition != usize.MAX { return Option<Bytes>.none() }
  let named = key.family == Family.Name || key.family == Family.InherentMember
  let body = key.family == Family.Body && key.member == usize.ZERO
  if !plainFields(key.family) && !named && !body { return Option<Bytes>.none() }
  let modules = List<ModuleId>.asSlice(&resolver.modules)
  let mut output = Bytes.make()
  run RuntimeEncoding.word(&mut output, u8.toU64(Family.value(key.family)))
  // The profile is the store's selected one, which the cache's stamp names, or none.
  if scoped.profile == usize.ZERO || scoped.profile == usize.MAX {
    run RuntimeEncoding.word(&mut output, 0)
  } else if scoped.profile == resolver.profileSlot {
    run RuntimeEncoding.word(&mut output, 1)
  } else {
    return Option<Bytes>.none()
  }
  if scoped.application == usize.MAX || key.family == Family.Layout {
    run RuntimeEncoding.word(&mut output, 0)
  } else if scoped.application < modules.length {
    run RuntimeEncoding.word(&mut output, 1)
    run StableKey.module(&mut output, &modules[scoped.application])
  } else {
    return Option<Bytes>.none()
  }
  if key.module >= modules.length { return Option<Bytes>.none() }
  run StableKey.module(&mut output, &modules[key.module])
  if declarationFamily(key.family) && key.declaration != usize.MAX {
    let identity = match move DeclarationTable.identity(&resolver.declarations, key.declaration) {
      Option<&DeclarationId>.Some {value} => value
      Option<&DeclarationId>.None => { return Option<Bytes>.none() }
    }
    run RuntimeEncoding.word(&mut output, 1)
    run StableKey.declaration(&mut output, identity)
  } else {
    run RuntimeEncoding.word(&mut output, 0)
    run RuntimeEncoding.word(&mut output, usize.toU64(key.declaration))
  }
  if named {
    run RuntimeEncoding.field(&mut output, StringTable.get(&resolver.names, Symbol {index: key.name}))
  } else {
    run RuntimeEncoding.word(&mut output, usize.toU64(key.name))
  }
  run RuntimeEncoding.word(&mut output, usize.toU64(key.member))
  if key.external { run RuntimeEncoding.word(&mut output, 1) } else { run RuntimeEncoding.word(&mut output, 0) }
  return Option<Bytes>.some(move output)
}

// The stable bytes of one source input: its module and its selector, with a declaration handle
// written as the declaration it was interned for. None for an input whose handle was never issued.
effect fn stableInput(resolver: &Resolver, input: usize) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let inputs = List<Inputs.Input>.asSlice(&resolver.sourceInputs.inputs)
  if input >= inputs.length { return Option<Bytes>.none() }
  let modules = List<ModuleId>.asSlice(&resolver.modules)
  if inputs[input].module >= modules.length { return Option<Bytes>.none() }
  let mut output = Bytes.make()
  run StableKey.module(&mut output, &modules[inputs[input].module])
  let handle = Inputs.handle(&inputs[input].selector)
  let mut identity = Option<&DeclarationId>.none()
  if handle != usize.MAX { identity = DeclarationTable.identity(&resolver.declarations, handle) }
  if !run StableKey.selector(&mut output, &inputs[input].selector, move identity) { return Option<Bytes>.none() }
  return Option<Bytes>.some(move output)
}

// A source input read back from its stable bytes: its module ordinal and its selector in this
// store, with a declaration selector's identity interned at its current position. None when the
// bytes are not an input, or its declaration is not in its module's current source.
struct PlacedInput {
  module: usize,
  selector: SourceSelector,
}

effect fn placeStableInput(resolver: &mut Resolver, bytes: &[u8], unchanged: bool, recorded: usize) -> Option<PlacedInput>
! Cycle | OutOfMemoryError ? &mut Allocator {
  return run placeStableInputIn(&mut resolver.*, bytes, unchanged, recorded, usize.MAX)
}

// `placeStableInput` for an input of a file already placed as module `known` (or `usize.MAX`).
// An input of an unchanged file names the declaration at its recorded position, so one a leaf
// before it already interned there is taken without building its identity or its module's.
effect fn placeStableInputIn(resolver: &mut Resolver, bytes: &[u8], unchanged: bool, recorded: usize, known: usize) -> Option<PlacedInput>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if known != usize.MAX && unchanged && recorded != usize.MAX {
    let mut skim = StableKey.reader()
    StableKey.skipModule(bytes, &mut skim)
    if let Option<StableKey.ReadSelector>.Some {value: read} = move run StableKey.readSelectorDeferred(bytes, &mut skim) {
      let StableKey.ReadSelector {selector, declaration, ..} = move read
      if StableKey.finished(bytes, &skim) {
        if declaration.end == declaration.start {
          return Option<PlacedInput>.some(PlacedInput {module: known, selector: move selector})
        }
        let cached = DeclarationTable.cached(&resolver.declarations, known, recorded)
        if cached != usize.MAX {
          return Option<PlacedInput>.some(PlacedInput {module: known, selector: StableKey.withHandle(move selector, cached)})
        }
      }
    }
  }
  let mut reader = StableKey.reader()
  let module = match move run StableKey.readModule(bytes, &mut reader) {
    Option<ModuleId>.Some {value} => move value
    Option<ModuleId>.None => { return Option<PlacedInput>.none() }
  }
  let read = match move run StableKey.readSelector(bytes, &mut reader) {
    Option<StableKey.ReadSelector>.Some {value} => move value
    Option<StableKey.ReadSelector>.None => { return Option<PlacedInput>.none() }
  }
  if !StableKey.finished(bytes, &reader) { return Option<PlacedInput>.none() }
  let ordinal = run internModule(&mut resolver.*, &module)
  let StableKey.ReadSelector {selector, identity, ..} = move read
  let declared = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return Option<PlacedInput>.some(PlacedInput {module: ordinal, selector: move selector}) }
  }
  // A file with the bytes the image recorded indexes its declarations where it did then.
  if recorded != usize.MAX && unchanged {
    let handle = run DeclarationTable.intern(&mut resolver.declarations, ordinal, recorded, &declared)
    return Option<PlacedInput>.some(PlacedInput {module: ordinal, selector: StableKey.withHandle(move selector, handle)})
  }
  // A module this build does not load is not read, which would read outside the build's
  // preloaded import graph; no declaration of it has a handle.
  let observed = run SourceIndex.captureObservation(&resolver.source, &module)
  if !Observation.isPresent(&observed) { return Option<PlacedInput>.none() }
  let answer = run demandSource(&mut resolver.*, &module)
  let mut handle = usize.MAX
  if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.source(&resolver.source, &answer, &module) {
    if let Option<usize>.Some {value: indexedAt} = move ModuleIndex.ordinalOf(IndexedSource.moduleIndex(indexed), &declared) {
      handle = run DeclarationTable.intern(&mut resolver.declarations, ordinal, indexedAt, &declared)
    }
  }
  if handle == usize.MAX { return Option<PlacedInput>.none() }
  return Option<PlacedInput>.some(PlacedInput {module: ordinal, selector: StableKey.withHandle(move selector, handle)})
}

/// What [`Semantic.adoptCache`] reused from a cache image.
pub struct Adopted {
  /// Module checks reused without sweeping.
  pub roots: usize,
  /// Module checks whose sources changed, or that this store names by another key.
  pub stale: usize,
  /// Units adopted current.
  pub nodes: usize,
  /// Source files and inputs that read differently now.
  pub changedLeaves: usize,
}

// Whether `leaf` records only where a span sits: a location in a declaration, or a source
// prefix. Such an input guards the spans a value or report holds, never what is checked.
effect fn positionalLeaf(leaf: &CacheImage.Leaf) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !leaf.input { return false }
  let mut reader = StableKey.reader()
  let module = run StableKey.readModule(Bytes.asSlice(&leaf.key), &mut reader)
  if let Option<ModuleId>.Some {..} = &module {} else { return false }
  let tag = StableKey.readWord(Bytes.asSlice(&leaf.key), &mut reader)
  return !StableKey.failed(&reader) && (tag == 9 || tag == 10)
}

// Where a unit stands while a cache image is built: not yet reached, reached and not finished,
// or unfit for the image because it reaches a unit that is not current or a leaf with no stable
// form. Any other value is the unit's node.
fn unreached() -> usize { return usize.MAX }
fn entered() -> usize { return usize.MAX - usize.ONE }
fn unfit() -> usize { return usize.MAX - 2 }

// The image under construction, with the node or leaf each unit and dependee became.
struct ImageBuild {
  image: CacheImage.Image,
  nodes: List<usize>,
  files: List<usize>,
  inputs: List<usize>,
  // The module of each file leaf, for its digest once the walk ends.
  fileModules: List<usize>,
}

// What `cacheImage` leaves for `imageCarriedChecks`: what each unit and dependee became, and the
// checks it could not write, some of which rest on a check an unlinked adoption reused.
struct PendingImage {
  nodes: List<usize>,
  files: List<usize>,
  inputs: List<usize>,
  fileModules: List<usize>,
  checks: List<PendingCheck>,
}

// A replayed escape check that reports: its unit, the node of what its replay demanded and the
// files its reports point into, and its answer.
struct ReplayReport {
  unit: usize,
  node: usize,
  answer: Bytes,
}

struct PendingCheck {
  unit: usize,
  answer: Bytes,
  sites: List<ModuleId>,
}

effect fn slotFor(slots: &mut List<usize>, at: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  while List<usize>.length(&slots.*) <= at { run List<usize>.append(&mut slots.*, unreached()) }
}

// The leaf of one consumed file or input, added on first use, or `unfit` when it has no stable form.
effect fn imageLeaf(resolver: &Resolver, build: &mut ImageBuild, dependee: Dependee) -> usize ! OutOfMemoryError ? &mut Allocator {
  return match &dependee {
    Dependee.SourceFile {module} => {
      run slotFor(&mut build.files, module)
      let known = List<usize>.get(&build.files, module)
      if known != unreached() { return known }
      let modules = List<ModuleId>.asSlice(&resolver.modules)
      let mut key = Bytes.make()
      run StableKey.module(&mut key, &modules[module])
      let leaf = List<CacheImage.Leaf>.length(&build.image.leaves)
      run List<CacheImage.Leaf>.append(&mut build.image.leaves, CacheImage.Leaf {input: false, key: move key,
        digest: ContentHash {high: 0, low: 0}, position: usize.MAX, file: usize.MAX, text: ContentHash {high: 0, low: 0}})
      run List<usize>.append(&mut build.fileModules, module)
      List<usize>.set(&mut build.files, module, leaf)
      return leaf
    }
    Dependee.SourceInput {input, ..} => {
      run slotFor(&mut build.inputs, input)
      let known = List<usize>.get(&build.inputs, input)
      if known != unreached() { return known }
      let mut found = unfit()
      if let Option<Bytes>.Some {value: key} = move run stableInput(&resolver.*, input) {
        // The file of the input's module rides along, so an adoption that finds the file
        // unchanged takes the input's digest without capturing it again.
        let file = run imageLeaf(resolver, &mut build.*, Dependee.SourceFile {module: List<Inputs.Input>.asSlice(&resolver.sourceInputs.inputs)[input].module})
        let values = List<Inputs.Input>.asSlice(&resolver.sourceInputs.inputs)
        let handle = Inputs.handle(&values[input].selector)
        let mut position = usize.MAX
        if handle != usize.MAX { position = DeclarationTable.position(&resolver.declarations, handle) }
        found = List<CacheImage.Leaf>.length(&build.image.leaves)
        run List<CacheImage.Leaf>.append(&mut build.image.leaves, CacheImage.Leaf {input: true, key: move key,
          digest: values[input].digest, position: position, file: file, text: values[input].text})
      }
      List<usize>.set(&mut build.inputs, input, found)
      return found
    }
    Dependee.UnitResult {..} => unfit()
  }
}

// Adds every unit `root` reaches to the image, children first, and returns `root`'s node, or
// `unfit` when it reaches a unit that is not current or a leaf with no stable form.
effect fn imageUnit(resolver: &Resolver, build: &mut ImageBuild, root: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  run slotFor(&mut build.nodes, root)
  if List<usize>.get(&build.nodes, root) != unreached() { return List<usize>.get(&build.nodes, root) }
  // Each frame keeps the unit and the next of its edges to look at, so every edge is passed once.
  let mut stack = List<usize>.make()
  let mut cursors = List<usize>.make()
  run List<usize>.append(&mut stack, root)
  run List<usize>.append(&mut cursors, Graph.firstEdgeOf(&resolver.graph, root))
  List<usize>.set(&mut build.nodes, root, entered())
  let mut edges = List<usize>.make()
  while List<usize>.length(&stack) > usize.ZERO {
    let top = List<usize>.length(&stack) - usize.ONE
    let unit = List<usize>.get(&stack, top)
    // Enter the next child not reached yet; the unit finishes once every child has.
    let mut pending = unreached()
    let mut edge = List<usize>.get(&cursors, top)
    while edge != usize.MAX && pending == unreached() {
      let consumed = Graph.dependeeOf(&resolver.graph, edge)
      if let Dependee.UnitResult {unit: child} = &consumed {
        run slotFor(&mut build.nodes, child)
        if List<usize>.get(&build.nodes, child) == unreached() { pending = child }
      }
      edge = Graph.nextEdgeOf(&resolver.graph, edge)
    }
    List<usize>.set(&mut cursors, top, edge)
    if pending != unreached() {
      List<usize>.set(&mut build.nodes, pending, entered())
      run List<usize>.append(&mut stack, pending)
      run List<usize>.append(&mut cursors, Graph.firstEdgeOf(&resolver.graph, pending))
      continue
    }
    drop List<usize>.remove(&mut stack, top)
    drop List<usize>.remove(&mut cursors, top)
    let mut fit = Graph.state(&resolver.graph, unit) == UnitState.UpToDate
    edges = List<usize>.make()
    edge = Graph.firstEdgeOf(&resolver.graph, unit)
    while edge != usize.MAX && fit {
      let dependee = Graph.dependeeOf(&resolver.graph, edge)
      if let Dependee.UnitResult {unit: child} = &dependee {
        let node = List<usize>.get(&build.nodes, child)
        // A child still entered closes a cycle; neither is fit.
        if node >= unfit() { fit = false } else { run List<usize>.append(&mut edges, CacheImage.nodeEdge(node)) }
      } else {
        let leaf = run imageLeaf(&resolver.*, &mut build.*, dependee)
        if leaf == unfit() { fit = false } else { run List<usize>.append(&mut edges, CacheImage.leafEdge(leaf)) }
      }
      edge = Graph.nextEdgeOf(&resolver.graph, edge)
    }
    if fit {
      let node = run CacheImage.addNode(&mut build.image, List<usize>.asSlice(&edges))
      List<usize>.set(&mut build.nodes, unit, node)
    } else {
      List<usize>.set(&mut build.nodes, unit, unfit())
    }
  }
  return List<usize>.get(&build.nodes, root)
}

// Adds to `edges` the node of each Layout unit the EmissionInputs unit `emission` demanded: the
// layouts its definition's text is emitted against, the supplied ones and those of its foreign
// signatures. False when one of them, or `emission` itself, is unfit for the image.
//
// The definition's own LlvmText unit names an immutable content subject and reads nothing, so a
// root resting on it and the MIR alone stays green when only an element's layout changed, and a
// later build reuses code with the old stride (silk-lang/silk#2468). The EmissionInputs unit
// itself reads more than its text needs, such as what places a gap and what its callees' signature
// content rests on, so a root resting on it would lower again after edits that leave the
// definition as it was; the root rests on the layouts it read instead.
effect fn emittedLayoutEdges(resolver: &Resolver, build: &mut ImageBuild, emission: usize, edges: &mut List<usize>) -> bool
! OutOfMemoryError ? &mut Allocator {
  if emission == usize.MAX || Graph.state(&resolver.graph, emission) != UnitState.UpToDate { return false }
  let mut edge = Graph.firstEdgeOf(&resolver.graph, emission)
  while edge != usize.MAX {
    let consumed = Graph.dependeeOf(&resolver.graph, edge)
    if let Dependee.UnitResult {unit: child} = &consumed {
      if List<ScopedKey>.get(&resolver.keys, child).key.family == Family.Layout {
        let node = run imageUnit(resolver, &mut build.*, child)
        if node >= unfit() { return false }
        let named = CacheImage.nodeEdge(node)
        if !holdsUnit(List<usize>.asSlice(&edges.*), named) { run List<usize>.append(&mut edges.*, named) }
      }
    }
    edge = Graph.nextEdgeOf(&resolver.graph, edge)
  }
  return true
}

// The answer of a module check root that reported nothing: whether it is a sweep (0) or an
// escape check (1), then the concrete bodies it names, then no rejections.
effect fn checkAnswer(kind: u64, concrete: &[DeclarationId]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut answer = run checkHead(kind, concrete)
  run RuntimeEncoding.word(&mut answer, 0)
  return move answer
}

effect fn checkHead(kind: u64, concrete: &[DeclarationId]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut answer = Bytes.make()
  run RuntimeEncoding.word(&mut answer, kind)
  run RuntimeEncoding.word(&mut answer, usize.toU64(concrete.length))
  let mut at = usize.ZERO
  while at < concrete.length {
    run StableKey.declaration(&mut answer, &concrete[at])
    at = at + usize.ONE
  }
  return move answer
}

// The answer of a module check root that reports `rejections`, or none when one of them holds
// what an image does not carry (`RejectionImage.encode`). `sites` gains the module of each site
// they name.
effect fn reportingAnswer(kind: u64, concrete: &[DeclarationId], rejections: &[Shared<Rejection>], sites: &mut List<ModuleId>)
  -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut answer = run checkHead(kind, concrete)
  run RuntimeEncoding.word(&mut answer, usize.toU64(rejections.length))
  let mut at = usize.ZERO
  while at < rejections.length {
    if !run RejectionImage.encode(&mut answer, &rejections[at], &mut sites.*) { return Option<Bytes>.none() }
    at = at + usize.ONE
  }
  return Option<Bytes>.some(move answer)
}

// Writes the root of `unit` with `answer`, or gives `answer` back when the unit is unfit. A root
// that reports rests on the file of each module in `sites` too: its spans are offsets into them.
effect fn imageRoot(resolver: &Resolver, build: &mut ImageBuild, unit: usize, answer: Bytes, sites: &[ModuleId]) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let key = match move run stableUnit(&resolver.*, unit) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Bytes>.none() }
  }
  let unitNode = run imageUnit(&resolver.*, &mut build.*, unit)
  if unitNode >= unfit() { return Option<Bytes>.some(move answer) }
  let node = run sitedNode(&resolver.*, &mut build.*, unitNode, sites)
  if node == usize.MAX { return Option<Bytes>.none() }
  run List<CacheImage.Root>.append(&mut build.image.roots, CacheImage.Root {key: move key, node: node, answer: move answer})
  return Option<Bytes>.none()
}

// `node`, or when `sites` names modules, a node resting on it and on the file of each, which a
// report's spans point into; `usize.MAX` when one of them is not a module of this store.
effect fn sitedNode(resolver: &Resolver, build: &mut ImageBuild, node: usize, sites: &[ModuleId]) -> usize
! OutOfMemoryError ? &mut Allocator {
  if sites.length == usize.ZERO { return node }
  let mut edges = List<usize>.make()
  run List<usize>.append(&mut edges, CacheImage.nodeEdge(node))
  let mut at = usize.ZERO
  while at < sites.length {
    let module = knownModuleOrdinal(&resolver.*, &sites[at])
    if module == usize.MAX { return usize.MAX }
    let edge = CacheImage.leafEdge(run imageLeaf(&resolver.*, &mut build.*, Dependee.SourceFile {module: module}))
    if !holdsUnit(List<usize>.asSlice(&edges), edge) { run List<usize>.append(&mut edges, edge) }
    at = at + usize.ONE
  }
  return run CacheImage.addNode(&mut build.image, List<usize>.asSlice(&edges))
}

// The digest of one module's source bytes, or zero when the module has no source.
// The digest of `module`'s bytes in the held revision, read without parsing them.
effect fn sourceDigest(resolver: &mut Resolver, module: &ModuleId) -> ContentHash ! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run SourceIndex.captureObservation(&resolver.source, module)
  if let Option<ContentHash>.Some {value} = move Observation.contentDigest(&observed) { return value }
  return ContentHash {high: 0, low: 0}
}

// The digest an image records for an input known to read otherwise than its node read it
// (`imageCarriedFiles`). No captured value hashes to it.
fn changedInput() -> ContentHash {
  return ContentHash {high: 0, low: 0}
}

// The current dependee one image leaf names, or `usize.MAX` when what it read changed: a file
// leaf's module ordinal, or an input leaf's input, interned with its value when this store has not
// captured it yet. `fileModule` is the module of the file leaf an input leaf names when that file
// reads the same, or `usize.MAX`.
effect fn placeLeaf(resolver: &mut Resolver, leaf: &CacheImage.Leaf, fileModule: usize) -> usize ! Cycle | OutOfMemoryError ? &mut Allocator {
  let unchangedFile = fileModule != usize.MAX
  let key = Bytes.asSlice(&leaf.key)
  if leaf.input && ContentHash.equals(leaf.digest, changedInput()) { return usize.MAX }
  if !leaf.input {
    let mut reader = StableKey.reader()
    let module = match move run StableKey.readModule(key, &mut reader) {
      Option<ModuleId>.Some {value} => move value
      Option<ModuleId>.None => { return usize.MAX }
    }
    if !StableKey.finished(key, &reader) { return usize.MAX }
    let digest = run sourceDigest(&mut resolver.*, &module)
    if !ContentHash.equals(digest, leaf.digest) { return usize.MAX }
    return run internModule(&mut resolver.*, &module)
  }
  let placed = match move run placeStableInputIn(&mut resolver.*, key, unchangedFile, leaf.position, fileModule) {
    Option<PlacedInput>.Some {value} => move value
    Option<PlacedInput>.None => { return usize.MAX }
  }
  let known = Inputs.find(&resolver.sourceInputs, placed.module, &placed.selector)
  // A read of a file whose bytes are those the image recorded reads what it read then. A resolution
  // reads the manifests instead, which the image does not record.
  let resolution = match &placed.selector { SourceSelector.Resolution {..} => true _ => false }
  if !resolution && unchangedFile {
    if known != usize.MAX { return known }
    return run Inputs.add(&mut resolver.sourceInputs, placed.module, move placed.selector, leaf.digest, leaf.text)
  }
  let module = resolvedModule(&resolver.*, placed.module)
  // A module this build does not load is not read: its inputs count as changed, and a demand of
  // its source would read outside the build's preloaded import graph.
  let observed = run SourceIndex.captureObservation(&resolver.source, &module)
  if !Observation.isPresent(&observed) { return usize.MAX }
  // A resolution is captured again without loading the module, which no-op builds never parse.
  let mut value = Bytes.make()
  let mut text = ContentHash {high: 0, low: 0}
  if let SourceSelector.Resolution {path} = &placed.selector {
    value = run captureResolution(&resolver.*, &module, Bytes.asSlice(&path))
  } else {
    let answer = run demandSource(&mut resolver.*, &module)
    let mut position = usize.MAX
    let handle = Inputs.handle(&placed.selector)
    if handle != usize.MAX { position = DeclarationTable.position(&resolver.declarations, handle) }
    text = Inputs.text(&placed.selector, sourceOf(&resolver.*, &answer, &module), position)
    // A declaration whose own tokens read as they did when the input was captured reads the same.
    if !ContentHash.equals(text, ContentHash {high: 0, low: 0}) && ContentHash.equals(text, leaf.text) {
      if known != usize.MAX { return known }
      return run Inputs.add(&mut resolver.sourceInputs, placed.module, move placed.selector, leaf.digest, text)
    }
    value = run captureInput(&resolver.*, &module, &placed.selector, &answer, position)
  }
  let digest = ContentHash.of(Bytes.asSlice(&value))
  if !ContentHash.equals(digest, leaf.digest) { return usize.MAX }
  if known != usize.MAX { return known }
  return run Inputs.add(&mut resolver.sourceInputs, placed.module, move placed.selector, digest, text)
}

// The module, name and member of a module check's stable key, as `stableUnit` wrote it.
struct CheckKey {
  module: ModuleId,
  name: usize,
  member: usize,
}

effect fn readCheckKey(bytes: &[u8]) -> Option<CheckKey> ! OutOfMemoryError ? &mut Allocator {
  let mut reader = StableKey.reader()
  let family = StableKey.readWord(bytes, &mut reader)
  if family != u8.toU64(Family.value(Family.ModuleCheck)) { return Option<CheckKey>.none() }
  drop StableKey.readWord(bytes, &mut reader)
  if StableKey.readWord(bytes, &mut reader) == 1 {
    drop run StableKey.readModule(bytes, &mut reader)
  }
  let module = match move run StableKey.readModule(bytes, &mut reader) {
    Option<ModuleId>.Some {value} => move value
    Option<ModuleId>.None => { return Option<CheckKey>.none() }
  }
  drop StableKey.readWord(bytes, &mut reader)
  drop StableKey.readWord(bytes, &mut reader)
  let name = StableKey.readWord(bytes, &mut reader)
  let member = StableKey.readWord(bytes, &mut reader)
  drop StableKey.readWord(bytes, &mut reader)
  if !StableKey.finished(bytes, &reader) { return Option<CheckKey>.none() }
  return Option<CheckKey>.some(CheckKey {module: move module, name: u64.toUsize(name), member: u64.toUsize(member)})
}

// The concrete bodies a module check root's answer names, and what it checks: a sweep (0), an
// escape check (1), or one declaration of a sweep, which names that declaration and is a concrete
// body (3) or not (2).
struct CheckAnswer {
  kind: u64,
  concrete: List<DeclarationId>,
  rejections: List<Shared<Rejection>>,
}

effect fn readCheckAnswer(bytes: &[u8]) -> Option<CheckAnswer> ! OutOfMemoryError ? &mut Allocator {
  let mut reader = StableKey.reader()
  let kind = StableKey.readWord(bytes, &mut reader)
  let count = StableKey.readWord(bytes, &mut reader)
  if StableKey.failed(&reader) || kind > 3 || (kind > 1 && count != 1) { return Option<CheckAnswer>.none() }
  let mut concrete = List<DeclarationId>.make()
  let mut at: u64 = 0
  while at < count {
    match move run StableKey.readDeclaration(bytes, &mut reader) {
      Option<DeclarationId>.Some {value} => { run List<DeclarationId>.append(&mut concrete, move value) }
      Option<DeclarationId>.None => { return Option<CheckAnswer>.none() }
    }
    at = at + 1
  }
  // A declaration's answer is written only when it reported nothing.
  let reported = StableKey.readWord(bytes, &mut reader)
  if kind > 1 && reported != 0 { return Option<CheckAnswer>.none() }
  let mut rejections = List<Shared<Rejection>>.make()
  at = 0
  while at < reported {
    match move run RejectionImage.decode(bytes, &mut reader) {
      Option<Rejection>.Some {value} => { run List<Shared<Rejection>>.append(&mut rejections, run Shared<Rejection>.make(move value)) }
      Option<Rejection>.None => { return Option<CheckAnswer>.none() }
    }
    at = at + 1
  }
  if !StableKey.finished(bytes, &reader) { return Option<CheckAnswer>.none() }
  return Option<CheckAnswer>.some(CheckAnswer {kind: kind, concrete: move concrete, rejections: move rejections})
}

effect fn verifyUnit(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, unit: usize) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if Graph.state(&resolver.graph, unit) != UnitState.Outdated { return false }
  // Edges link newest first. Inputs are checked first, since they need no rerun to decide.
  let mut children = List<usize>.make()
  let mut edge = Graph.firstEdgeOf(&resolver.graph, unit)
  while edge != usize.MAX {
    if Graph.edgeChanged(&resolver.graph, unit, edge) {
      if resolver.tracing { run List<StaleCause>.append(&mut resolver.staleCauses, StaleCause {unit: unit, dependee: Graph.dependeeOf(&resolver.graph, edge)}) }
      return false
    }
    let dependee = Graph.dependeeOf(&resolver.graph, edge)
    if let Dependee.UnitResult {unit: child} = &dependee {
      run List<usize>.append(&mut children, child)
    }
    edge = Graph.nextEdgeOf(&resolver.graph, edge)
  }
  let listed = List<usize>.asSlice(&children)
  let mut at = listed.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let current = run bringCurrent(&mut resolver.*, &mut owner.*, listed[at])
    if !current || Graph.resultChanged(&resolver.graph, unit, listed[at]) {
      if resolver.tracing { run List<StaleCause>.append(&mut resolver.staleCauses, StaleCause {unit: unit, dependee: Dependee.UnitResult {unit: listed[at]}}) }
      return false
    }
  }
  return true
}

// Brings one consumed unit up to date for a verification, recording no edge: verifies it when it
// is outdated, and reruns it when that fails. Returns whether it is current afterwards.
effect fn bringCurrent(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, unit: usize) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if Graph.current(&resolver.graph, unit) { return true }
  let active = List<Word>.asSlice(&resolver.active)
  let mut at = usize.ZERO
  while at < active.length {
    if u64.toUsize(active[at].value) == unit { return false }
    at = at + usize.ONE
  }
  let word = Word {value: usize.toU64(unit)}
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {..} = move Query.completed(&mut owner.*, word) {
    if run verifyUnit(&mut resolver.*, &mut owner.*, unit) {
      Graph.markVerified(&mut resolver.graph, unit)
      return true
    }
    Query.forget(&mut owner.*, word)
  }
  let scoped = List<ScopedKey>.get(&resolver.keys, unit)
  // A module check, or a unit adopted from a cache image, is no provider: it cannot rerun here,
  // so the unit that consumed it reruns instead, unless what it read is unchanged. Its result lives
  // in its check's memo, not in the query, so verifying its edges alone brings it current.
  if scoped.key.family == Family.ModuleCheck {
    if run verifyUnit(&mut resolver.*, &mut owner.*, unit) {
      Graph.markVerified(&mut resolver.graph, unit)
      return true
    }
    return false
  }
  drop run demandUnit(&mut resolver.*, &mut owner.*, scoped.key, word, Span {start: usize.ZERO, end: usize.ZERO})
  return Graph.current(&resolver.graph, unit)
}

// Demands the unit `word`, the interned scope of `key`.
effect fn demandUnit(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
  word: Word,
  span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run reconcileSources(&mut resolver.*)
  resolver.demands = resolver.demands + usize.ONE
  let cached = Query.completed(&mut owner.*, word)
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move cached {
    // A one-shot store holds one revision, so every completed answer stays valid. An update
    // marks outdated every unit of a revisable store that consumed a change, and an outdated
    // unit whose dependees kept their answers is verified current without rerunning. A
    // completed unit is never active, so a hit skips the cycle scan.
    let unit = u64.toUsize(word.value)
    let mut hit = Graph.current(&resolver.graph, unit)
    let mut answer = move value
    if !hit && run verifyUnit(&mut resolver.*, &mut owner.*, unit) {
      Graph.markVerified(&mut resolver.graph, unit)
      hit = true
      // Verifying can rerun this very unit: a dependee brought current may demand it back, as
      // when an edit closes a cycle through it. The memo then holds that rerun's answer.
      if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: rerun} = move Query.completed(&mut owner.*, word) {
        answer = move rerun
      }
    }
    if hit {
      resolver.hits = resolver.hits + usize.ONE
      run emit(&mut resolver.*, EventKind.Hit, word)
      return move answer
    }
    Query.forget(&mut owner.*, word)
  }
  let mut at = usize.ZERO
  while at < List<Word>.length(&resolver.active) {
    let active = List<Word>.get(&resolver.active, at)
    if active.value == word.value {
      return run cycleAnswer(&mut resolver.*, key, span)
    }
    at = at + usize.ONE
  }
  let attempted = run Effect.result(Query.demand(
    &mut owner.*,
    word,
    effect fn(query: &mut Query<Answer, NoRejection>, demanded: Word) -> Result<
      Answer,
      NoRejection,
    > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | StaticBudgetRefusal ? &mut Allocator | &mut Types {
      run emit(&mut resolver.*, EventKind.Start, demanded)
      let zone = Profiler.zone(familyZone(key.family))
      static if Profiler.enabled {
        let subject = run zoneSubject(&mut resolver.*, key)
        Profiler.text(&zone, Bytes.asSlice(&subject))
      }
      let resolved = run withRunning(&mut resolver.*, &mut query.*, demanded)
      if isTransientStaticBudgetAnswer(&resolved) {
        fail StaticBudgetRefusal {answer: move resolved}
      }
      return move resolved
    },
  ))
  let answer = match move attempted {
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | StaticBudgetRefusal>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | StaticBudgetRefusal>.Failure {error} => match move error {
      StaticBudgetRefusal {answer: refused} => run Shared<Result<Answer, NoRejection>>.make(move refused)
      Cycle {} => {fail Cycle {}}
      InvalidModulePath {} => {fail InvalidModulePath {}}
      RevisionMismatch {} => {fail RevisionMismatch {}}
      OutOfMemoryError {} => {fail OutOfMemoryError {}}
    }
  }
  run emit(&mut resolver.*, EventKind.Finish, word)
  return move answer
}

fn cycleMember(family: Family) -> bool {
  return family == Family.Alias || family == Family.Import || family == Family.Initializer || family == Family.Condition || family == Family.ParameterDefault
}

fn cycleDiagnostic(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  let found = answerCause(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    if Shared<Rejection>.with<bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.Cycle || diagnostic.code == RejectionCode.CyclicTypeAlias
      },
    ) {
      return Option<Shared<Rejection>>.some(move value)
    }
  }
  return Option<Shared<Rejection>>.none()
}

// The member's position in the cycle, excluding the closing repeat, or `usize.MAX`.
fn cyclePosition(diagnostic: &Rejection, member: &DeclarationId) -> usize {
  let path = List<Shared<DeclarationId>>.asSlice(&diagnostic.path)
  let mut at = usize.ZERO
  while at + usize.ONE < path.length {
    if Shared<DeclarationId>.with<bool>(
      &path[at],
      fn(id: &DeclarationId) -> bool {
        return DeclarationId.equals(id, member)
      },
    ) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn cycleLength(diagnostic: &Rejection) -> usize {
  return List<Shared<DeclarationId>>.length(&diagnostic.path) - usize.ONE
}

fn cycleStep(diagnostic: &Rejection, at: usize) -> Shared<DeclarationId> {
  let path = List<Shared<DeclarationId>>.asSlice(&diagnostic.path)
  return Shared<DeclarationId>.clone(&path[at])
}

// A cycle member answers at its own reference to the next member, with the path rotated to start
// at itself. The seed rejection depends on which member a demand entered first; this answer
// depends only on the member and the cycle, so cached members agree in every demand order.
effect fn memberCycleAnswer(
  resolver: &mut Resolver,
  parent: Key,
  answer: &Shared<Result<Answer, NoRejection>>,
  span: Span,
) -> Option<Shared<Result<Answer, NoRejection>>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !cycleMember(parent.family) {
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    answer,
    cycleDiagnostic,
  )
  let diagnostic = match move found {
    Option<Shared<Rejection>>.Some {value} => move value
    Option<Shared<Rejection>>.None => {
      return Option<Shared<Result<Answer, NoRejection>>>.none()
    }
  }
  let module = resolvedModule(&resolver.*, parent.module)
  let declarationAccess4 = declarationPosition(&resolver.*, parent)
  let owner = run declarationAt(&mut resolver.*, &module, declarationAccess4)
  let member = match move owner {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Option<Shared<Result<Answer, NoRejection>>>.none()
    }
  }
  let start = Shared<Rejection>.with<usize>(
    &diagnostic,
    fn(cycle: &Rejection) -> usize {
      return cyclePosition(cycle, &member)
    },
  )
  if start == usize.MAX {
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }
  let count = Shared<Rejection>.with<usize>(&diagnostic, cycleLength)
  let mut path = List<Shared<DeclarationId>>.make()
  let mut step = usize.ZERO
  while step <= count {
    let mut at = start + step
    if at >= count {
      at = at - count
    }
    let item = Shared<Rejection>.with<Shared<DeclarationId>>(
      &diagnostic,
      fn(cycle: &Rejection) -> Shared<DeclarationId> {
        return cycleStep(cycle, at)
      },
    )
    run List<Shared<DeclarationId>>.append(&mut path, move item)
    step = step + usize.ONE
  }
  let rejection = run Shared<Rejection>.make(
    Rejection {
      code: Shared<Rejection>.with<RejectionCode>(&diagnostic, fn(value: &Rejection) -> RejectionCode { return value.code }),
      module: move module,
      span: span,
      related: Option<RelatedSite>.none(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: List<MessageArgument>.make(), owner: usize.MAX,
    },
  )
  return Option<Shared<Result<Answer, NoRejection>>>.some(
    run Shared<Result<Answer, NoRejection>>.make(
      Result<Answer, NoRejection>.succeed(
        Answer {
          outcome: run rejectedOutcome(move rejection),
          dependencies: List<Dependency>.make(),
        },
      ),
    ),
  )
}

effect fn demandChild(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  key: Key,
  span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let word = run internKey(&mut resolver.*, key)
  let answer = run demandUnit(&mut resolver.*, &mut owner.*, key, word, span)
  let edge = dependency(key)
  if !recording(&resolver.*) {
    // A store that is never revised keeps no evidence about what this answer read.
    run List<Dependency>.append(&mut dependencies.*, move edge)
    let active = List<Word>.asSlice(&resolver.active)
    if active.length == usize.ZERO {
      return move answer
    }
    let parentScope = List<ScopedKey>.get(&resolver.keys, u64.toUsize(active[active.length - usize.ONE].value))
    let own = run memberCycleAnswer(&mut resolver.*, parentScope.key, &answer, span)
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move own {
      return move value
    }
    return move answer
  }
  let module = resolvedModule(&resolver.*, key.module)
  let active = List<Word>.asSlice(&resolver.active)
  if active.length == usize.ZERO {
    if resolver.rootRecorder != usize.MAX {
      run Graph.record(&mut resolver.graph, resolver.rootRecorder, Dependee.UnitResult {unit: u64.toUsize(word.value)})
    }
    run List<Dependency>.append(&mut dependencies.*, move edge)
    return move answer
  }
  let parentScope = List<ScopedKey>.get(
    &resolver.keys,
    u64.toUsize(active[active.length - usize.ONE].value),
  )
  let parent = parentScope.key
  let parentUnit = u64.toUsize(active[active.length - usize.ONE].value)
  run Graph.record(&mut resolver.graph, parentUnit, Dependee.UnitResult {unit: u64.toUsize(word.value)})
  run List<Dependency>.append(&mut dependencies.*, move edge)
  let own = run memberCycleAnswer(&mut resolver.*, parent, &answer, span)
  // A cycle member publishes its own rejection instead of the child's.
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move own {
    return move value
  }
  return move answer
}

// The interned copy of `module` when this store has interned it, so copies share one record.
fn canonicalModule(resolver: &Resolver, module: ModuleId) -> ModuleId {
  let known = knownModuleOrdinal(resolver, &module)
  if known == usize.MAX {
    return move module
  }
  return resolvedModule(resolver, known)
}

// The interned module at `ordinal`; the copy shares the interned record.
// A carried check that runs again is the store's own, and its image's root is left behind.
fn uncarry(units: &mut List<usize>, roots: &mut List<usize>, unit: usize) -> () {
  let held = List<usize>.asSlice(&units.*)
  let mut at = usize.ZERO
  while at < held.length {
    if held[at] == unit {
      drop List<usize>.remove(&mut units.*, at)
      drop List<usize>.remove(&mut roots.*, at)
      return ()
    }
    at = at + usize.ONE
  }
}

fn holdsUnit(units: &[usize], unit: usize) -> bool {
  let mut at = usize.ZERO
  while at < units.length {
    if units[at] == unit { return true }
    at = at + usize.ONE
  }
  return false
}

fn resolvedModule(resolver: &Resolver, ordinal: usize) -> ModuleId {
  let modules = List<ModuleId>.asSlice(&resolver.modules)
  return ModuleId.copy(&modules[ordinal])
}

effect fn resolvedName(resolver: &Resolver, ordinal: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  return run Bytes.copy(StringTable.get(&resolver.names, Symbol {index: ordinal}))
}

effect fn resolveBucket(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = resolvedModule(&resolver.*, key.module)
  let name = run resolvedName(&resolver.*, key.name)
  let sourceAnswer = run observedName(&mut resolver.*, &module, Bytes.asSlice(&name), false)
  let bucket = run SourceIndex.observeName(
    &mut resolver.source,
    &sourceAnswer,
    &module,
    Bytes.asSlice(&name),
  )
  if let Option<Shared<NameObservation>>.Some {value} = move bucket {
    return Answer {
      outcome: Outcome.Success {value: Value.Name {bucket: move value}},
      dependencies: List<Dependency>.make(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.MissingModule,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: run rejectedOutcome(move diagnostic),
    dependencies: List<Dependency>.make(),
  }
}

// One import declaration and how many members it selects.
struct ImportMembers {
  declaration: usize,
  members: usize,
}

// Every import declaration of `module` that selects members, in written order.
effect fn selectedImportMembers(resolver: &mut Resolver, module: &ModuleId) -> List<ImportMembers>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut selections = List<ImportMembers>.make()
  let answer = run observedSource(&mut resolver.*, module, SourceSelector.Imports)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if let Node.ImportHeader {members, ..} = Module.node(hir, declarations[at].header) {
        if members.present && members.range.length > usize.ZERO {
          run List<ImportMembers>.append(&mut selections, ImportMembers {declaration: at, members: members.range.length})
        }
      }
      at = at + usize.ONE
    }
  }
  return move selections
}

effect fn importedMember(resolver: &mut Resolver, module: &ModuleId, ordinal: usize, member: usize) -> Option<
  PathSyntax,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Import)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      if let Node.ImportHeader {members, ..} = Module.node(hir, declarations[ordinal].header) {
        if members.present && member < members.range.length {
          let id = Module.child(hir, members.range, member)
          if let Node.ImportMember {name, ..} = Module.node(hir, id) {
            if let Node.Name {text} = Module.node(hir, name) {
              let mut names = List<Bytes>.make()
              run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text)))
              return Option<PathSyntax>.some(
                PathSyntax {segments: move names, span: Module.span(hir, name), valid: true},
              )
            }
            return Option<PathSyntax>.some(
              PathSyntax {
                segments: List<Bytes>.make(),
                span: Module.span(hir, name),
                valid: false,
              },
            )
          }
        }
      }
    }
  }
  return Option<PathSyntax>.none()
}

effect fn modulePath(syntax: &PathSyntax) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let segments = List<Bytes>.asSlice(&syntax.segments)
  let mut joined = Bytes.make()
  let mut at = usize.ZERO
  while at < segments.length {
    if at > usize.ZERO {
      run Bytes.append(&mut joined, b"/")
    }
    run Bytes.append(&mut joined, Bytes.asSlice(&segments[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut joined, b".silk")
  return move joined
}

fn intrinsicImport(syntax: &PathSyntax) -> bool {
  let segments = List<Bytes>.asSlice(&syntax.segments)
  return segments.length > usize.ZERO && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic")
}

fn applicationImport(syntax: &PathSyntax) -> bool {
  let segments = List<Bytes>.asSlice(&syntax.segments)
  let expected = usize.ONE + usize.ONE
  return segments.length == expected && intrinsicImport(syntax) && same(
    Bytes.asSlice(&segments[usize.ONE]),
    b"application",
  )
}

effect fn resolveImport(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess5 = declarationPosition(&resolver.*, key)
  let written = run observedHeader(&mut resolver.*, &module, declarationAccess5, SourceFacet.Import)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ImportHeader {path: importPath, isPublic, members, ..} = value.header {
      if isPublic && !members.present {
        let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
        return Answer {
          outcome: run rejectedOutcome(move diagnostic),
          dependencies: move dependencies,
        }
      }
      let targetPath = run importPathSyntax(&mut resolver.*, &module, declarationAccess5, importPath)
      if !targetPath.valid {
        let diagnostic = run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          targetPath.span,
        )
        return Answer {
          outcome: run rejectedOutcome(move diagnostic),
          dependencies: move dependencies,
        }
      }
      let mut destination = Option<ModuleId>.none()
      if applicationImport(&targetPath) {
        if resolver.currentApplication != usize.MAX {
          let selected = resolver.currentApplication
          destination = Option<ModuleId>.some(resolvedModule(&resolver.*, selected))
        }
      } else if intrinsicImport(&targetPath) {
        // `Intrinsic` is a reserved module name: only `Intrinsic.application` is importable, and
        // intrinsics are written `Intrinsic.<name>` without an import (MOD0004).
        let diagnostic = run importPathRejection(RejectionCode.ReservedModule, &module, targetPath.span, &targetPath)
        return Answer {
          outcome: run rejectedOutcome(move diagnostic),
          dependencies: move dependencies,
        }
      } else {
        let targetText = run modulePath(&targetPath)
        if SealedOperators.isPath(Bytes.asSlice(&targetText)) {
          return Answer {
            outcome: run rejectedOutcome(run missingModuleRejection(&module, targetPath.span, &targetPath)),
            dependencies: move dependencies,
          }
        }
        // MODULE-007: a directory's barrel file is named by the directory's path alone.
        if PackageGraph.isBarrel(Bytes.asSlice(&targetText)) {
          return Answer {
            outcome: run rejectedOutcome(run importPathRejection(RejectionCode.BarrelSpelling, &module, targetPath.span, &targetPath)),
            dependencies: move dependencies,
          }
        }
        // Which modules the path names, and whether they are exported, follows the manifests'
        // dependency names and exports, which no source read records.
        drop run observedSource(&mut resolver.*, &module, SourceSelector.Resolution {path: run Bytes.copy(Bytes.asSlice(&targetText))})
        let file = canonicalModule(&resolver.*, run PackageGraph.target(&resolver.packages, &module, Bytes.asSlice(&targetText)))
        let barrel = canonicalModule(&resolver.*, run PackageGraph.barrel(&resolver.packages, &module, Bytes.asSlice(&targetText)))
        // Only the presence of each file decides which one the path names, so editing either
        // file's text never reruns the resolution.
        let fileSource = run observedSource(&mut resolver.*, &file, SourceSelector.Presence)
        let filePresent = match move sourceOf(&resolver.*, &fileSource, &file) { Option<&IndexedSource>.Some {..} => true _ => false }
        let barrelSource = run observedSource(&mut resolver.*, &barrel, SourceSelector.Presence)
        let barrelPresent = match move sourceOf(&resolver.*, &barrelSource, &barrel) { Option<&IndexedSource>.Some {..} => true _ => false }
        if filePresent && barrelPresent {
          return Answer {
            outcome: run rejectedOutcome(run ambiguousModuleRejection(&module, targetPath.span, &targetPath, &file, &barrel)),
            dependencies: move dependencies,
          }
        }
        let mut canonical = move file
        if barrelPresent { canonical = move barrel }
        // IMPORT-001: an import never names its own containing module.
        if ModuleId.equals(&canonical, &module) {
          return Answer {
            outcome: run rejectedOutcome(run reject(&resolver.*, &module, RejectionCode.SelfImport, targetPath.span)),
            dependencies: move dependencies,
          }
        }
        destination = Option<ModuleId>.some(move canonical)
      }
      let found = match move destination {
        Option<ModuleId>.Some {value: selectedModule} => move selectedModule
        Option<ModuleId>.None => {
          let diagnostic = run missingModuleRejection(&module, targetPath.span, &targetPath)
          return Answer {
            outcome: run rejectedOutcome(move diagnostic),
            dependencies: move dependencies,
          }
        }
      }
      let targetSource = run observedSource(&mut resolver.*, &found, SourceSelector.Presence)
      if let Option<&IndexedSource>.None = move sourceOf(&resolver.*, &targetSource, &found) {
        let diagnostic = run missingModuleRejection(&module, targetPath.span, &targetPath)
        return Answer {
          outcome: run rejectedOutcome(move diagnostic),
          dependencies: move dependencies,
        }
      }
      // PACKAGE-006: another package's module is importable only when its manifest exports it.
      let visible = run PackageGraph.exported(&resolver.packages, &module, &found)
      if !visible {
        return Answer {
          outcome: run rejectedOutcome(run internalModuleRejection(&module, targetPath.span, &found)),
          dependencies: move dependencies,
        }
      }
      let targetOrdinal = run internModule(&mut resolver.*, &found)
      // Later copies share the interned record, so their comparisons skip the bytes.
      let target = resolvedModule(&resolver.*, targetOrdinal)
      if key.member == usize.MAX {
        return Answer {
          outcome: Outcome.Success {
            value: Value.Namespace {module: move target, ordinal: targetOrdinal},
          },
          dependencies: move dependencies,
        }
      }
      let declarationAccess6 = declarationPosition(&resolver.*, key)
      let selected = run importedMember(&mut resolver.*, &module, declarationAccess6, key.member)
      if let Option<PathSyntax>.Some {value: member} = move selected {
        if !member.valid {
          let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span)
          return Answer {
            outcome: run rejectedOutcome(move diagnostic),
            dependencies: move dependencies,
          }
        }
        let names = List<Bytes>.asSlice(&member.segments)
        let selectedName = Bytes.asSlice(&names[usize.ZERO])
        let nameOrdinal = run internName(&mut resolver.*, selectedName)
        let declarationAccess7Request = Key {
          family: Family.Name,
          module: targetOrdinal,
          name: nameOrdinal,
          declaration: usize.ZERO,
          member: usize.ZERO,
          external: true,
        }
        let declarationAccess7 = run internDeclaration(&mut resolver.*, declarationAccess7Request)
        let lookup = declarationAccess7
        let observed = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies,
          lookup,
          member.span,
        )
        drop observed
        let candidateSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies, &target, selectedName, true)
        let candidate = match move candidateSelection {
          Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
          Result<Selection, Shared<Rejection>>.Failure {error} => {
            return run memberRejected(move error, move dependencies)
          }
        }
        if candidate.count == usize.ZERO || candidate.publicCount == usize.ZERO || candidate.count > usize.ONE {
          let mut code = RejectionCode.Collision
          if candidate.count == usize.ZERO {
            code = RejectionCode.UnknownImportedMember
          } else if candidate.publicCount == usize.ZERO {
            code = RejectionCode.PrivateMember
            let origin = run reimportOrigin(&mut resolver.*, &mut owner.*, &mut dependencies, targetOrdinal, &candidate,
              member.span)
            if let Option<ModuleId>.Some {value: declaring} = move origin {
              let diagnostic = run reimportRejection(&resolver.*, &module, member.span, &target, selectedName, &declaring)
              return Answer {
                outcome: run rejectedOutcome(move diagnostic),
                dependencies: move dependencies,
              }
            }
          }
          let diagnostic = run memberRejection(&resolver.*, &module, code, member.span, &target, selectedName)
          return Answer {
            outcome: run rejectedOutcome(move diagnostic),
            dependencies: move dependencies,
          }
        }
        if candidate.kind == CandidateKind.ImportMember {
          let declarationAccess8Request = Key {
            family: Family.Import,
            module: targetOrdinal,
            name: usize.ZERO,
            declaration: candidate.declaration,
            member: candidate.member,
            external: false,
          }
          let declarationAccess8 = run internDeclaration(&mut resolver.*, declarationAccess8Request)
          let nestedKey = declarationAccess8
          let nested = run demandChild(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies,
            nestedKey,
            member.span,
          )
          let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(
            &nested,
            fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) },
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
            return Answer {
              outcome: run rejectedOutcome(move diagnostic),
              dependencies: move dependencies,
            }
          }
          if let Option<usize>.Some {value: targetModuleOrdinal} = move binding.module {
            if let Option<usize>.Some {value: resolvedDeclaration} = move binding.declaration {
              let canonical = resolvedModule(&resolver.*, targetModuleOrdinal)
              let declaration = run declarationAt(&mut resolver.*, &canonical, resolvedDeclaration)
              if let Option<DeclarationId>.Some {value: id} = move declaration {
                let selectedRequest1 = Key {family: Family.Identity, module: targetModuleOrdinal, name: usize.ZERO,
                  declaration: resolvedDeclaration, member: usize.ZERO, external: false}
                let selectedKey1 = run internDeclaration(&mut resolver.*, selectedRequest1)
                return Answer {
                  outcome: Outcome.Success {
                    value: Value.Selected {
                      declaration: move id,
                      module: targetModuleOrdinal,
                      handle: selectedKey1.declaration,
                    },
                  },
                  dependencies: move dependencies,
                }
              }
            }
          }
        }
        if candidate.kind != CandidateKind.Declaration {
          let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span)
          return Answer {
            outcome: run rejectedOutcome(move diagnostic),
            dependencies: move dependencies,
          }
        }
        let declaration = run declarationAt(&mut resolver.*, &target, candidate.declaration)
        if let Option<DeclarationId>.Some {value: id} = move declaration {
          let selectedRequest2 = Key {family: Family.Identity, module: targetOrdinal, name: usize.ZERO,
            declaration: candidate.declaration, member: usize.ZERO, external: false}
          let selectedKey2 = run internDeclaration(&mut resolver.*, selectedRequest2)
          return Answer {
            outcome: Outcome.Success {
              value: Value.Selected {
                declaration: move id,
                module: targetOrdinal,
                handle: selectedKey2.declaration,
              },
            },
            dependencies: move dependencies,
          }
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: run rejectedOutcome(move diagnostic),
      dependencies: move dependencies,
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: run rejectedOutcome(move diagnostic),
    dependencies: move dependencies,
  }
}

effect fn typeNode(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedSyntax(&mut resolver.*, module, id)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    return Option<HeaderSyntax>.some(
      HeaderSyntax {header: Module.node(hir, id), span: Module.span(hir, id)},
    )
  }
  return Option<HeaderSyntax>.none()
}

effect fn typeChild(resolver: &mut Resolver, module: &ModuleId, range: Range, at: usize) -> Option<
  HirId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedRange(&mut resolver.*, module, range)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    return Option<HirId>.some(Module.child(IndexedSource.authored(value), range, at))
  }
  return Option<HirId>.none()
}

effect fn lifetimeAt(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> Result<
  Shared<Lifetime>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.Lifetime {name} = value.header {
      let named = run typeNode(&mut resolver.*, module, name)
      if let Option<HeaderSyntax>.Some {value: token} = move named {
        if let Node.Name {text} = token.header {
          let source = run observedSyntax(&mut resolver.*, module, id)
          if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
            &resolver.*,
            &source,
            module,
          ) {
            let spelling = Module.text(IndexedSource.authored(indexed), text)
            if same(spelling, b"'static") {
              return Result<Shared<Lifetime>, Shared<Rejection>>.succeed(
                run Shared<Lifetime>.make(Lifetime.Static),
              )
            }
            let mut at = usize.ZERO
            while at < binders.length {
              if let Binder.Lifetime {name: bound, value: lifetime} = &binders[at] {
                if same(Bytes.asSlice(&bound), spelling) {
                  return Result<Shared<Lifetime>, Shared<Rejection>>.succeed(
                    Shared<Lifetime>.clone(&lifetime),
                  )
                }
              }
              at = at + usize.ONE
            }
            return Result<Shared<Lifetime>, Shared<Rejection>>.failResult(
              run reject(&resolver.*, module, RejectionCode.UnknownLifetime, value.span),
            )
          }
        }
      }
    }
    return Result<Shared<Lifetime>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InvalidLifetime, value.span),
    )
  }
  return Result<Shared<Lifetime>, Shared<Rejection>>.failResult(
    run reject(
      &resolver.*,
      module,
      RejectionCode.InvalidLifetime,
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
}

effect fn elidedLifetime(
  resolver: &mut Resolver,
  module: &ModuleId,
  span: Span,
  elision: &mut LifetimeElision,
) -> Result<Shared<Lifetime>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if elision.output {
    if let Option<Shared<Lifetime>>.Some {value} = &elision.resultDefault {
      return Result<Shared<Lifetime>, Shared<Rejection>>.succeed(Shared<Lifetime>.clone(&value))
    }
    return Result<Shared<Lifetime>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.AmbiguousLifetime, span),
    )
  }
  if elision.invocation {
    if elision.nested {
      return Result<Shared<Lifetime>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.NestedQuantifier, span),
      )
    }
    let lifetime = run Shared<Lifetime>.make(
      Lifetime.Invocation {ordinal: renumbered(&elision.renumber, elision.nextOrdinal)},
    )
    elision.nextOrdinal = elision.nextOrdinal + usize.ONE
    run List<Shared<Lifetime>>.append(&mut elision.generated, Shared<Lifetime>.clone(&lifetime))
    return Result<Shared<Lifetime>, Shared<Rejection>>.succeed(move lifetime)
  }
  if let Option<DeclarationId>.Some {value: owner} = &elision.owner {
    let mut lifetime = run Shared<Lifetime>.make(
      Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: elision.nextOrdinal},
    )
    if let Option<List<Argument>>.Some {value: supplied} = &elision.supplied {
      let arguments = List<Argument>.asSlice(&supplied)
      if elision.nextOrdinal < arguments.length {
        if let Argument.Lifetime {value: selected} = &arguments[elision.nextOrdinal] {
          lifetime = Shared<Lifetime>.clone(&selected)
        }
      }
    }
    elision.nextOrdinal = elision.nextOrdinal + usize.ONE
    run List<Shared<Lifetime>>.append(&mut elision.generated, Shared<Lifetime>.clone(&lifetime))
    return Result<Shared<Lifetime>, Shared<Rejection>>.succeed(move lifetime)
  }
  // A body annotation infers its elided lifetimes through an owner from `elidedLifetimeOwner`. A
  // body position without one, such as an explicit call-site generic argument, has none yet.
  return Result<Shared<Lifetime>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span),
  )
}

effect fn writtenOrElidedLifetime(
  resolver: &mut Resolver,
  module: &ModuleId,
  written: HirRef,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Lifetime>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if written.present {
    return run lifetimeAt(&mut resolver.*, module, written.id, binders)
  }
  return run elidedLifetime(&mut resolver.*, module, span, &mut elision.*)
}

// The written generic parameter list of a declaration header; empty when it has none.
fn writtenGenerics(hir: &Module, written: Node) -> Range {
  let mut generics = Range.empty()
  // Bounds are recorded by the declaration's Contract or Signature; a use that needs one proved
  // is rejected where the declaration is applied.
  if let Node.FunctionHeader {contract, ..} = written {
    if let Node.CallableContract {generics: parameters, ..} = Module.node(hir, contract) {
      generics = parameters
    }
  }
  if let Node.OperationHeader {contract, ..} = written {
    if let Node.CallableContract {generics: parameters, ..} = Module.node(hir, contract) {
      generics = parameters
    }
  }
  if let Node.CallableContract {generics: parameters, ..} = written { generics = parameters }
  if let Node.StructHeader {generics: parameters, ..} = written {
    generics = parameters
  }
  if let Node.TupleHeader {generics: parameters, ..} = written {
    generics = parameters
  }
  if let Node.UnionHeader {generics: parameters, ..} = written {
    generics = parameters
  }
  if let Node.ServiceHeader {generics: parameters, ..} = written {
    generics = parameters
  }
  if let Node.InterfaceHeader {generics: parameters, ..} = written {
    generics = parameters
  }
  if let Node.AliasHeader {generics: parameters, ..} = written {
    generics = parameters
  }
  if let Node.ImplHeader {generics: parameters, ..} = written {
    generics = parameters
  }
  return generics
}

effect fn templateBinders(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Result<
  List<Binder>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut binders = List<Binder>.make()
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Binders)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length {
      return Result<List<Binder>, Shared<Rejection>>.succeed(move binders)
    }
    let hir = IndexedSource.authored(value)
    let generics = writtenGenerics(hir, Module.node(hir, declarations[ordinal].header))
    if generics.length == usize.ZERO {
      return Result<List<Binder>, Shared<Rejection>>.succeed(move binders)
    }
    if let Option<DeclarationId>.Some {value: owner} = move identity {
      let mut at = usize.ZERO
      while at < generics.length {
        let parameter = Module.child(hir, generics, at)
        let syntax = Module.node(hir, parameter)
        if let Node.RowParameter {name} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            if hasBinder(List<Binder>.asSlice(&binders), spelling) {
              return Result<List<Binder>, Shared<Rejection>>.failResult(
                run reject(
                  &resolver.*,
                  module,
                  RejectionCode.DuplicateTypeParameter,
                  Module.span(hir, parameter),
                ),
              )
            }
            run List<Binder>.append(
              &mut binders,
              Binder.Row {
                name: run Bytes.copy(spelling),
                value: RowParameter {
                  declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&owner)),
                  ordinal: at,
                },
                bound: Option<Shared<Row>>.none(),
              },
            )
            at = at + usize.ONE
            continue
          }
        }
        if let Node.TypeParameter {name, ..} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            let prior = List<Binder>.asSlice(&binders)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(binderName(&prior[before]), spelling) {
                return Result<List<Binder>, Shared<Rejection>>.failResult(
                  run reject(
                    &resolver.*,
                    module,
                    RejectionCode.DuplicateTypeParameter,
                    Module.span(hir, parameter),
                  ),
                )
              }
              before = before + usize.ONE
            }
            let parameterOwner = DeclarationId.copy(&owner)
            let parameterType = run Types.intern(
              Type.Parameter {declaration: move parameterOwner, ordinal: at},
            )
            run List<Binder>.append(
              &mut binders,
              Binder.Type {name: run Bytes.copy(spelling), value: move parameterType},
            )
            at = at + usize.ONE
            continue
          }
        }
        if let Node.LifetimeParameter {name, ..} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            if same(spelling, b"'static") {
              return Result<List<Binder>, Shared<Rejection>>.failResult(
                run reject(
                  &resolver.*,
                  module,
                  RejectionCode.InvalidLifetime,
                  Module.span(hir, parameter),
                ),
              )
            }
            let prior = List<Binder>.asSlice(&binders)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(binderName(&prior[before]), spelling) {
                return Result<List<Binder>, Shared<Rejection>>.failResult(
                  run reject(
                    &resolver.*,
                    module,
                    RejectionCode.DuplicateLifetimeParameter,
                    Module.span(hir, parameter),
                  ),
                )
              }
              before = before + usize.ONE
            }
            run List<Binder>.append(
              &mut binders,
              Binder.Lifetime {
                name: run Bytes.copy(spelling),
                value: run Shared<Lifetime>.make(
                  Lifetime.Parameter {declaration: DeclarationId.copy(&owner), ordinal: at},
                ),
              },
            )
            at = at + usize.ONE
            continue
          }
        }
        return Result<List<Binder>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.Unsupported, Module.span(hir, parameter)),
        )
      }
      return Result<List<Binder>, Shared<Rejection>>.succeed(move binders)
    }
  }
  return Result<List<Binder>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
  )
}

fn copyBound(bound: &Option<Shared<Row>>) -> Option<Shared<Row>> {
  return match & bound.* {
    Option<Shared<Row>>.Some {value} => Option<Shared<Row>>.some(Shared<Row>.clone(&value))
    Option<Shared<Row>>.None => Option<Shared<Row>>.none()
  }
}

fn binderName(binder: &Binder) -> &[u8] {
  return match & binder.* {
    Binder.Type {name, ..} => Bytes.asSlice(&name)
    Binder.Lifetime {name, ..} => Bytes.asSlice(&name)
    Binder.Row {name, ..} => Bytes.asSlice(&name)
  }
}

fn hasBinder(binders: &[Binder], spelling: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < binders.length {
    if same(binderName(&binders[at]), spelling) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Each binder keeps its own value unless the supplied argument has the matching kind.
fn suppliedType(argument: &Argument, original: &Shared<Type>) -> Shared<Type> {
  return match & argument.* {
    Argument.Type {value} => Shared<Type>.clone(&value)
    _ => Shared<Type>.clone(original)
  }
}

fn suppliedLifetime(argument: &Argument, original: &Shared<Lifetime>) -> Shared<Lifetime> {
  return match & argument.* {
    Argument.Lifetime {value} => Shared<Lifetime>.clone(&value)
    _ => Shared<Lifetime>.clone(original)
  }
}

fn suppliedRow(argument: &Argument, prior: &Option<Shared<Row>>) -> Option<Shared<Row>> {
  return match & argument.* {
    Argument.Row {value: supplied} => Option<Shared<Row>>.some(Shared<Row>.clone(&supplied))
    _ => copyBound(prior)
  }
}

effect fn bindArguments(template: &[Binder], arguments: &[Argument]) -> List<Binder>
! OutOfMemoryError
? &mut Allocator {
  let mut applied = List<Binder>.make()
  let mut at = usize.ZERO
  while at < template.length {
    let bound = match & template[at] {
      Binder.Type {name, value: original} => Binder.Type {
        name: run Bytes.copy(Bytes.asSlice(&name)),
        value: suppliedType(&arguments[at], &original),
      }
      Binder.Lifetime {name, value: original} => Binder.Lifetime {
        name: run Bytes.copy(Bytes.asSlice(&name)),
        value: suppliedLifetime(&arguments[at], &original),
      }
      Binder.Row {name, value, bound: prior} => Binder.Row {
        name: run Bytes.copy(Bytes.asSlice(&name)),
        value: RowParameter {
          declaration: Shared<DeclarationId>.clone(&value.declaration),
          ordinal: value.ordinal,
        },
        bound: suppliedRow(&arguments[at], &prior),
      }
    }
    run List<Binder>.append(&mut applied, move bound)
    at = at + usize.ONE
  }
  return move applied
}

effect fn typeFromAnswer(answer: &Shared<Result<Answer, NoRejection>>) -> TypeSelection {
  return Shared<Result<Answer, NoRejection>>.with<TypeSelection>(answer, selectedType)
}

fn privateArgument(argument: &Argument) -> Option<RejectionCode> {
  return match & argument.* {
    Argument.Type {value} => Shared<Type>.with<Option<RejectionCode>>(&value, privateNominal)
    Argument.Row {value: row} => Shared<Row>.with<Option<RejectionCode>>(&row, privateRow)
    _ => Option<RejectionCode>.none()
  }
}

fn anyPrivateArgument(arguments: &List<Argument>) -> Option<RejectionCode> {
  let values = List<Argument>.asSlice(arguments)
  let mut at = usize.ZERO
  while at < values.length {
    let argumentExposure = privateArgument(&values[at])
    if let Option<RejectionCode>.Some {value} = move argumentExposure {
      return Option<RejectionCode>.some(value)
    }
    at = at + usize.ONE
  }
  return Option<RejectionCode>.none()
}

fn privateCallableApplication(value: &Application) -> Option<RejectionCode> {
  let argumentExposure = anyPrivateArgument(&value.arguments)
  if let Option<RejectionCode>.Some {value: code} = move argumentExposure { return Option<RejectionCode>.some(code) }
  let scopes = List<ScopeBinding>.asSlice(&value.scopes)
  let mut at = usize.ZERO
  while at < scopes.length {
    let scopeExposure = anyPrivateArgument(&scopes[at].arguments)
    if let Option<RejectionCode>.Some {value: code} = move scopeExposure { return Option<RejectionCode>.some(code) }
    at = at + usize.ONE
  }
  return Option<RejectionCode>.none()
}

fn privateNominal(resolved: &Type) -> Option<RejectionCode> {
  return match & resolved.* {
    Type.Nominal {isPublic, arguments, ..} => {
      if !isPublic { return Option<RejectionCode>.some(RejectionCode.PrivateTypeExposure) }
      return anyPrivateArgument(&arguments)
    }
    Type.CallableValue {isPublic, application, contract, captures, ..} => {
      if !isPublic { return Option<RejectionCode>.some(RejectionCode.PrivateExactRepresentationLeak) }
      let captureExposure = anyPrivate(&captures)
      if let Option<RejectionCode>.Some {value: code} = move captureExposure { return Option<RejectionCode>.some(code) }
      let contractExposure = Shared<Type>.with<Option<RejectionCode>>(&contract, privateNominal)
      if let Option<RejectionCode>.Some {value: code} = move contractExposure { return Option<RejectionCode>.some(code) }
      return Shared<Application>.with<Option<RejectionCode>>(&application, privateCallableApplication)
    }
    Type.OpaqueRepresentation {application, contract, ..} => {
      let contractExposure = Shared<Type>.with<Option<RejectionCode>>(&contract, privateNominal)
      if let Option<RejectionCode>.Some {value: code} = move contractExposure { return Option<RejectionCode>.some(code) }
      return Shared<Application>.with<Option<RejectionCode>>(&application, privateCallableApplication)
    }
    Type.Reference {referent, ..} => Shared<Type>.with<Option<RejectionCode>>(&referent, privateNominal)
    Type.Slice {element, ..} => Shared<Type>.with<Option<RejectionCode>>(&element, privateNominal)
    Type.Pointer {pointee, ..} => Shared<Type>.with<Option<RejectionCode>>(&pointee, privateNominal)
    Type.Array {element, ..} => Shared<Type>.with<Option<RejectionCode>>(&element, privateNominal)
    Type.Anonymous {members, ..} => anyPrivate(&members)
    Type.Union {members} => anyPrivate(&members)
    Type.Callable {parameters, result, ..} => {
      let parameterExposure = anyPrivate(&parameters)
      if let Option<RejectionCode>.Some {value: code} = move parameterExposure { return Option<RejectionCode>.some(code) }
      return Shared<Type>.with<Option<RejectionCode>>(&result, privateNominal)
    }
    Type.Effect {success, failure, requirements, ..} => {
      let successExposure = Shared<Type>.with<Option<RejectionCode>>(&success, privateNominal)
      if let Option<RejectionCode>.Some {value: code} = move successExposure { return Option<RejectionCode>.some(code) }
      let failureExposure = Shared<Type>.with<Option<RejectionCode>>(&failure, privateNominal)
      if let Option<RejectionCode>.Some {value: code} = move failureExposure { return Option<RejectionCode>.some(code) }
      return Shared<Row>.with<Option<RejectionCode>>(&requirements, privateRow)
    }
    _ => Option<RejectionCode>.none()
  }
}

// The first private nominal type that `value` names, for SEM0019 to name it.
fn privateNamed(value: &Shared<Type>) -> Option<Shared<Type>> {
  let own = Shared<Type>.with<bool>(value, fn(resolved: &Type) -> bool {
    if let Type.Nominal {isPublic, ..} = &resolved.* { return !isPublic }
    return false
  })
  if own { return Option<Shared<Type>>.some(Shared<Type>.clone(value)) }
  return Shared<Type>.with<Option<Shared<Type>>>(value, privateNamedPart)
}

fn privateNamedIn(types: &List<Shared<Type>>) -> Option<Shared<Type>> {
  let values = List<Shared<Type>>.asSlice(types)
  let mut at = usize.ZERO
  while at < values.length {
    let found = privateNamed(&values[at])
    if let Option<Shared<Type>>.Some {..} = &found { return move found }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

fn privateNamedPart(resolved: &Type) -> Option<Shared<Type>> {
  return match & resolved.* {
    Type.Nominal {arguments, ..} => {
      let values = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < values.length {
        if let Argument.Type {value} = &values[at] {
          let found = privateNamed(&value)
          if let Option<Shared<Type>>.Some {..} = &found { return move found }
        }
        at = at + usize.ONE
      }
      return Option<Shared<Type>>.none()
    }
    Type.Reference {referent, ..} => privateNamed(&referent)
    Type.Slice {element, ..} => privateNamed(&element)
    Type.Pointer {pointee, ..} => privateNamed(&pointee)
    Type.Array {element, ..} => privateNamed(&element)
    Type.Anonymous {members, ..} => privateNamedIn(&members)
    Type.Union {members} => privateNamedIn(&members)
    Type.Callable {parameters, result, ..} => {
      let found = privateNamedIn(&parameters)
      if let Option<Shared<Type>>.Some {..} = &found { return move found }
      return privateNamed(&result)
    }
    Type.Effect {success, failure, ..} => {
      let found = privateNamed(&success)
      if let Option<Shared<Type>>.Some {..} = &found { return move found }
      return privateNamed(&failure)
    }
    _ => Option<Shared<Type>>.none()
  }
}

fn anyPrivate(types: &List<Shared<Type>>) -> Option<RejectionCode> {
  let values = List<Shared<Type>>.asSlice(types)
  let mut at = usize.ZERO
  while at < values.length {
    let typeExposure = Shared<Type>.with<Option<RejectionCode>>(&values[at], privateNominal)
    if let Option<RejectionCode>.Some {value} = move typeExposure {
      return Option<RejectionCode>.some(value)
    }
    at = at + usize.ONE
  }
  return Option<RejectionCode>.none()
}

fn privateRow(row: &Row) -> Option<RejectionCode> {
  let entries = List<Requirement>.asSlice(&row.entries)
  let mut at = usize.ZERO
  while at < entries.length {
    let capabilityExposure = Shared<Type>.with<Option<RejectionCode>>(&entries[at].capability, privateNominal)
    if let Option<RejectionCode>.Some {value} = move capabilityExposure {
      return Option<RejectionCode>.some(value)
    }
    at = at + usize.ONE
  }
  let terms = List<RowSubtraction>.asSlice(&row.subtractions)
  at = usize.ZERO
  while at < terms.length {
    let sourceExposure = Shared<Row>.with<Option<RejectionCode>>(&terms[at].source, privateRow)
    if let Option<RejectionCode>.Some {value: code} = move sourceExposure { return Option<RejectionCode>.some(code) }
    let removedExposure = Shared<Row>.with<Option<RejectionCode>>(&terms[at].removed, privateRow)
    if let Option<RejectionCode>.Some {value: code} = move removedExposure { return Option<RejectionCode>.some(code) }
    at = at + usize.ONE
  }
  return Option<RejectionCode>.none()
}

fn outerLifetime(resolved: &Type) -> Option<Shared<Lifetime>> {
  return match & resolved.* {
    Type.Reference {lifetime, ..} => Option<Shared<Lifetime>>.some(
      Shared<Lifetime>.clone(&lifetime),
    )
    Type.Slice {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    Type.String {lifetime} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    _ => Option<Shared<Lifetime>>.none()
  }
}

effect fn exposedPrivate(
  resolver: &mut Resolver,
  module: &ModuleId,
  typeId: HirId,
  resolved: &Shared<Type>,
  publicContract: bool,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !publicContract {
    return Option<Shared<Rejection>>.none()
  }
  let exposure = Shared<Type>.with<Option<RejectionCode>>(resolved, privateNominal)
  let code = match move exposure {
    Option<RejectionCode>.Some {value} => value
    Option<RejectionCode>.None => { return Option<Shared<Rejection>>.none() }
  }
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let syntax = run typeNode(&mut resolver.*, module, typeId)
  if let Option<HeaderSyntax>.Some {value} = move syntax { span = value.span }
  let error = run reject(&resolver.*, module, code, span)
  if code == RejectionCode.PrivateTypeExposure {
    if let Option<Shared<Type>>.Some {value: named} = move privateNamed(resolved) {
      let text = run writtenTypeName(module, &named)
      if Bytes.length(&text) != usize.ZERO {
        let mut quoted = Bytes.make()
        run appendQuoted(&mut quoted, Bytes.asSlice(&text))
        run appendRejectionArgument(&error, b"type", Bytes.asSlice(&quoted))
        let mut note = run Bytes.copy(b"mark ")
        run Bytes.append(&mut note, Bytes.asSlice(&quoted))
        run Bytes.append(&mut note, b" `pub`, or remove `pub` from the declaration")
        run appendRejectionArgument(&error, b"note", Bytes.asSlice(&note))
      }
    }
  }
  return Option<Shared<Rejection>>.some(move error)
}

fn rowBinderCount(binders: &[Binder]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Row {..} = &binders[at] {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn headerGenerics(header: Node) -> Range {
  return match header {
    Node.StructHeader {generics, ..} => generics
    Node.TupleHeader {generics, ..} => generics
    Node.UnionHeader {generics, ..} => generics
    Node.ServiceHeader {generics, ..} => generics
    Node.InterfaceHeader {generics, ..} => generics
    Node.AliasHeader {generics, ..} => generics
    _ => Range.empty()
  }
}

// Whether a type, alias, interface, or service declaration writes a bound that needs proof: an
// interface, service, or representation bound. Lifetime bounds are recorded without a proof claim.
effect fn declaresBounds(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run scopedHeader(&mut resolver.*, module, ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let generics = headerGenerics(value.header)
    let mut at = usize.ZERO
    while at < generics.length {
      let child = run typeChild(&mut resolver.*, module, generics, at)
      if let Option<HirId>.Some {value: parameterId} = move child {
        let syntax = run typeNode(&mut resolver.*, module, parameterId)
        if let Option<HeaderSyntax>.Some {value: parameter} = move syntax {
          if let Node.TypeParameter {bounds, ..} = parameter.header {
            let mut boundAt = usize.ZERO
            while boundAt < bounds.length {
              let bound = run typeChild(&mut resolver.*, module, bounds, boundAt)
              if let Option<HirId>.Some {value: boundId} = move bound {
                let boundSyntax = run typeNode(&mut resolver.*, module, boundId)
                if let Option<HeaderSyntax>.Some {value: boundNode} = move boundSyntax {
                  let mut lifetimeBound = false
                  if let Node.Lifetime {..} = boundNode.header {
                    lifetimeBound = true
                  }
                  if !lifetimeBound {
                    return true
                  }
                }
              }
              boundAt = boundAt + usize.ONE
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

// The kind a `? Row`-less suffix would have been written as when it has no matching binder.
fn suffixKind(failures: HirRef, requirements: HirRef) -> GenericKind {
  if requirements.present {
    return GenericKind.Requirement
  }
  if failures.present {
    return GenericKind.Failure
  }
  return GenericKind.Lifetime
}

// The positional arguments and optional `? Row` suffix written after a declaration's name.
struct WrittenApplication {
  rowSyntax: HirRef,
  argumentIds: Range,
  argumentSpan: Span,
}

effect fn writtenApplication(
  resolver: &mut Resolver,
  anchor: &ModuleId,
  id: HirId,
  span: Span,
  rowBinders: usize,
) -> Result<WrittenApplication, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut written = WrittenApplication {
    rowSyntax: HirRef.absent(),
    argumentIds: Range.empty(),
    argumentSpan: span,
  }
  let syntax = run typeNode(&mut resolver.*, anchor, id)
  if let Option<HeaderSyntax>.Some {value: argumentSyntax} = move syntax {
    written.argumentSpan = argumentSyntax.span
    if let Node.TypeArguments {arguments, environment, failures, requirements} = argumentSyntax.header {
      // A `? Row` suffix supplies the first row binder that no positional argument fills, as in
      // `Context<A, E, First ? Second>`.
      if requirements.present && rowBinders > usize.ZERO {
        written.rowSyntax = requirements
      }
      // `Option<?i32>` is the `?T` spelling inside a type argument list, where `?` opens a
      // requirement row: with no positional argument and no row binder to fill, report PAR0007.
      if requirements.present && rowBinders == usize.ZERO && !environment.present && !failures.present && arguments.length == usize.ZERO {
        let mut rowSpan = written.argumentSpan
        if let Option<HeaderSyntax>.Some {value: row} = move run typeNode(&mut resolver.*, anchor, requirements.id) {
          rowSpan = row.span
        }
        return Result<WrittenApplication, Shared<Rejection>>.failResult(
          run reject(&resolver.*, anchor, RejectionCode.OptionalTypeSyntax, rowSpan),
        )
      }
      if environment.present || failures.present || (requirements.present && rowBinders == usize.ZERO) {
        return Result<WrittenApplication, Shared<Rejection>>.failResult(
          run rejectKind(
            &resolver.*,
            anchor,
            written.argumentSpan,
            b"",
            GenericKind.Type,
            suffixKind(failures, requirements),
          ),
        )
      }
      written.argumentIds = arguments
    } else {
      return Result<WrittenApplication, Shared<Rejection>>.failResult(
        run reject(&resolver.*, anchor, RejectionCode.Unsupported, written.argumentSpan),
      )
    }
  }
  return Result<WrittenApplication, Shared<Rejection>>.succeed(move written)
}

// The written argument at one position, with the kind its syntax declares.
struct SuppliedArgument {
  id: Option<HirId>,
  kind: GenericKind,
  span: Span,
}

effect fn suppliedArgument(
  resolver: &mut Resolver,
  anchor: &ModuleId,
  argumentIds: Range,
  argumentAt: usize,
  argumentSpan: Span,
) -> SuppliedArgument ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut kind = GenericKind.Type
  let mut span = argumentSpan
  if argumentAt >= argumentIds.length {
    return SuppliedArgument {id: Option<HirId>.none(), kind: kind, span: span}
  }
  let id = run typeChild(&mut resolver.*, anchor, argumentIds, argumentAt)
  if let Option<HirId>.Some {value: argumentId} = &id {
    let source = run typeNode(&mut resolver.*, anchor, argumentId)
    if let Option<HeaderSyntax>.Some {value: argumentNode} = move source {
      span = argumentNode.span
      if let Node.Lifetime {..} = argumentNode.header {
        kind = GenericKind.Lifetime
      }
      if let Node.RequirementSelector {..} = argumentNode.header {
        kind = GenericKind.Requirement
      }
    }
  }
  return SuppliedArgument {id: move id, kind: kind, span: span}
}

// Supplies a lifetime binder from a written lifetime or by elision. The result says whether a
// written argument was consumed.
effect fn lifetimeBinderArgument(
  resolver: &mut Resolver,
  anchor: &ModuleId,
  supplied: SuppliedArgument,
  written: bool,
  callerBinders: &[Binder],
  callerElision: &mut LifetimeElision,
  arguments: &mut List<Argument>,
) -> Result<bool, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let suppliedKind = supplied.kind
  let suppliedSpan = supplied.span
  if suppliedKind == GenericKind.Lifetime && written {
    if let Option<HirId>.Some {value: argumentId} = move supplied.id {
      let resolved = run lifetimeAt(&mut resolver.*, anchor, argumentId, callerBinders)
      let lifetime = match move resolved {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result<bool, Shared<Rejection>>.failResult(move error)
        }
      }
      run List<Argument>.append(&mut arguments.*, Argument.Lifetime {value: move lifetime})
      return Result<bool, Shared<Rejection>>.succeed(true)
    }
    return Result<bool, Shared<Rejection>>.succeed(false)
  }
  let elided = run elidedLifetime(&mut resolver.*, anchor, suppliedSpan, &mut callerElision.*)
  let lifetime = match move elided {
    Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
    Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
      return Result<bool, Shared<Rejection>>.failResult(move error)
    }
  }
  run List<Argument>.append(&mut arguments.*, Argument.Lifetime {value: move lifetime})
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// Supplies a `?R` binder from a positional row argument (GEN-002: arguments are kind-directed, so
// it is a requirement row exactly like the `? Row` suffix) or else from the suffix. The result says
// whether a positional argument was consumed.
effect fn rowBinderArgument(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  callerModule: usize,
  anchor: &ModuleId,
  name: &[u8],
  supplied: SuppliedArgument,
  argumentSpan: Span,
  rowSyntax: HirRef,
  callerBinders: &[Binder],
  callerElision: &mut LifetimeElision,
  arguments: &mut List<Argument>,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let suppliedKind = supplied.kind
  let suppliedSpan = supplied.span
  if let Option<HirId>.Some {value: argumentId} = move supplied.id {
    if suppliedKind == GenericKind.Lifetime {
      return Result<bool, Shared<Rejection>>.failResult(
        run rejectKind(
          &resolver.*,
          anchor,
          suppliedSpan,
          name,
          GenericKind.Requirement,
          suppliedKind,
        ),
      )
    }
    let mut positional = Row.empty()
    let added = run rowArgument(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      callerModule,
      anchor,
      argumentId,
      name,
      callerBinders,
      &mut callerElision.*,
      false,
      &mut positional,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
      return Result<bool, Shared<Rejection>>.failResult(move diagnostic)
    }
    run List<Argument>.append(
      &mut arguments.*,
      Argument.Row {value: run Shared<Row>.make(move positional)},
    )
    return Result<bool, Shared<Rejection>>.succeed(true)
  }
  if !rowSyntax.present {
    // No positional row and no `? Row` suffix: the row argument is omitted. Say so, and how an
    // empty row is spelled, rather than leave a bare kind mismatch.
    let mut omitted = run makeRejection(RejectionCode.TypeArgumentKind, anchor, argumentSpan)
    omitted.parameterName = run Bytes.copy(name)
    omitted.expectedKind = GenericKind.Requirement
    let mut spelling = run Bytes.copy(b"`?")
    run Bytes.append(&mut spelling, name)
    run Bytes.append(&mut spelling, b"`")
    run List<MessageArgument>.append(&mut omitted.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: move spelling})
    run List<MessageArgument>.append(&mut omitted.arguments, MessageArgument {name: run Bytes.copy(b"actual"),
      value: run Bytes.copy(b"none because its row argument is omitted")})
    run List<MessageArgument>.append(&mut omitted.arguments, MessageArgument {name: run Bytes.copy(b"expected"),
      value: run Bytes.copy(b"a requirement row; write `? never` for an empty row")})
    return Result<bool, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move omitted))
  }
  let suppliedRow = run resolveChannels(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    callerModule,
    anchor,
    HirRef.absent(),
    rowSyntax,
    callerBinders,
    &mut callerElision.*,
  )
  let channels = match move suppliedRow {
    Result<Channels, Shared<Rejection>>.Success {value: found} => move found
    Result<Channels, Shared<Rejection>>.Failure {error} => {
      return Result<bool, Shared<Rejection>>.failResult(move error)
    }
  }
  run List<Argument>.append(&mut arguments.*, Argument.Row {value: move channels.requirements})
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// Supplies a type binder from the next positional argument; a missing one is an arity error.
effect fn typeBinderArgument(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  callerModule: usize,
  anchor: &ModuleId,
  name: &[u8],
  supplied: SuppliedArgument,
  /// The written type name, where a missing argument is reported (SEM0051).
  nameSpan: Span,
  expected: usize,
  written: usize,
  callerBinders: &[Binder],
  callerElision: &mut LifetimeElision,
  arguments: &mut List<Argument>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let suppliedKind = supplied.kind
  let suppliedSpan = supplied.span
  let argumentId = match move supplied.id {
    Option<HirId>.Some {value: id} => id
    Option<HirId>.None => {
      return Option<Shared<Rejection>>.some(
        run rejectArity(&resolver.*, anchor, nameSpan, expected, written),
      )
    }
  }
  if suppliedKind != GenericKind.Type {
    return Option<Shared<Rejection>>.some(
      run rejectKind(
        &resolver.*,
        anchor,
        suppliedSpan,
        name,
        GenericKind.Type,
        suppliedKind,
      ),
    )
  }
  let resolved = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    callerModule,
    argumentId,
    callerBinders,
    &mut callerElision.*,
  )
  let ty = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: found} => move found
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Option<Shared<Rejection>>.some(move error)
    }
  }
  run List<Argument>.append(&mut arguments.*, Argument.Type {value: move ty})
  return Option<Shared<Rejection>>.none()
}

// Ordinary applications prove their bounds; an inherent declaration names an entire local
// family and derives that family's bounds only after validating its canonical arguments.
union DeclarationApplicationContext {
  GeneralUse,
  InherentFamily {implementation: DeclarationId, writtenCount: usize},
}

struct DeclarationApplication {
  ty: Shared<Type>,
  ownerPremises: List<Constraint>,
}

effect fn declarationApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  declaration: usize,
  anchor: &ModuleId,
  span: Span,
  /// Where a wrong argument count is reported (SEM0051): the type name, or a call owner's whole application.
  aritySpan: Span,
  application: Option<HirId>,
  callerBinders: &[Binder],
  callerElision: &mut LifetimeElision,
  context: DeclarationApplicationContext,
) -> Result<DeclarationApplication, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let written = run scopedHeader(&mut resolver.*, &module, declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let family = match value.header {
      Node.AliasHeader {..} => Family.Alias
      Node.StructHeader {..} => Family.Identity
      Node.TupleHeader {..} => Family.Identity
      Node.EnumHeader {..} => Family.Identity
      Node.UnionHeader {..} => Family.Identity
      Node.ServiceHeader {..} => Family.Identity
      Node.InterfaceHeader {..} => Family.Identity
      Node.RoleHeader {..} => Family.Identity
      _ => {
        return Result<DeclarationApplication, Shared<Rejection>>.failResult(
          run reject(&resolver.*, anchor, RejectionCode.NotType, span),
        )
      }
    }
    // An unapplied alias (TYPE-004) applies its target declaration to this use's own arguments.
    if family == Family.Alias {
      let declarationAccess9Request = Key {
        family: Family.Alias,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: declaration,
        member: usize.ZERO,
        external: false,
      }
      let declarationAccess9 = run internDeclaration(&mut resolver.*, declarationAccess9Request)
      let aliasKey = declarationAccess9
      let aliasAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, aliasKey, span)
      let forwarded = Shared<Result<Answer, NoRejection>>.with<Option<SelectedDeclaration>>(&aliasAnswer, fn(answer: &Result<Answer, NoRejection>) -> Option<SelectedDeclaration> { return forwardedDeclaration(&resolver.*, answer) })
      if let Option<SelectedDeclaration>.Some {value: target} = move forwarded {
        return run declarationApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*, target.module,
          target.ordinal, anchor, span, aritySpan, move application, callerBinders, &mut callerElision.*, move context)
      }
      // An alias of a sealed property is no value type; the use reports it, as for an interface.
      if let Option<SealedProperty>.Some {..} = move Shared<Result<Answer, NoRejection>>.with<Option<SealedProperty>>(&aliasAnswer, aliasProperty) {
        return Result<DeclarationApplication, Shared<Rejection>>.failResult(
          run reject(&resolver.*, anchor, RejectionCode.NotType, span),
        )
      }
      // A rejected alias reports its own rejection before any use-site arity check.
      let aliasSelection = run typeFromAnswer(&aliasAnswer)
      if let Option<Shared<Rejection>>.Some {value: rejection} = move aliasSelection.rejected {
        return Result<DeclarationApplication, Shared<Rejection>>.failResult(move rejection)
      }
    }
    let template = run templateBinders(&mut resolver.*, &module, declaration)
    let mut binders = match move template {
      Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return Result<DeclarationApplication, Shared<Rejection>>.failResult(move error)
      }
    }
    let incomplete = run completeApplicationBinders(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      &module,
      declaration,
      span,
      &mut binders,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move incomplete {
      return Result<DeclarationApplication, Shared<Rejection>>.failResult(move diagnostic)
    }
    let rowBinders = rowBinderCount(List<Binder>.asSlice(&binders))
    let mut rowSyntax = HirRef.absent()
    let mut argumentIds = Range.empty()
    let mut argumentSpan = span
    let mut hasApplication = false
    if let Option<HirId>.Some {value: id} = move application {
      hasApplication = true
      let parsed = run writtenApplication(&mut resolver.*, anchor, id, span, rowBinders)
      let supplied = match move parsed {
        Result<WrittenApplication, Shared<Rejection>>.Success {value: found} => move found
        Result<WrittenApplication, Shared<Rejection>>.Failure {error} => {
          return Result<DeclarationApplication, Shared<Rejection>>.failResult(move error)
        }
      }
      rowSyntax = supplied.rowSyntax
      argumentIds = supplied.argumentIds
      argumentSpan = supplied.argumentSpan
    }
    let expected = List<Binder>.length(&binders)
    if expected == usize.ZERO && hasApplication {
      return Result<DeclarationApplication, Shared<Rejection>>.failResult(
        run rejectArity(&resolver.*, anchor, aritySpan, expected, argumentIds.length),
      )
    }
    // GEN-002 with LIFE-003: omitted lifetimes elide only when none is written; a partial written
    // list is an arity error. A lifetime written where none is declared keeps its kind rejection.
    let writtenLifetimes = run countWrittenLifetimes(&mut resolver.*, anchor, argumentIds)
    let lifetimeParameters = writtenLifetimeCount(List<Binder>.asSlice(&binders))
    if writtenLifetimes > usize.ZERO && writtenLifetimes < lifetimeParameters {
      return Result<DeclarationApplication, Shared<Rejection>>.failResult(
        run rejectArity(&resolver.*, anchor, aritySpan, expected, argumentIds.length),
      )
    }
    let mut arguments = List<Argument>.make()
    let mut argumentAt = usize.ZERO
    let mut suffixUsed = false
    let callerModule = run internModule(&mut resolver.*, anchor)
    let parameters = List<Binder>.asSlice(&binders)
    let mut binderAt = usize.ZERO
    while binderAt < parameters.length {
      let supplied = run suppliedArgument(
        &mut resolver.*,
        anchor,
        argumentIds,
        argumentAt,
        argumentSpan,
      )
      if let Binder.Lifetime {..} = &parameters[binderAt] {
        let step = run lifetimeBinderArgument(
          &mut resolver.*,
          anchor,
          move supplied,
          argumentAt < argumentIds.length,
          callerBinders,
          &mut callerElision.*,
          &mut arguments,
        )
        let consumed = match move step {
          Result<bool, Shared<Rejection>>.Success {value: taken} => taken
          Result<bool, Shared<Rejection>>.Failure {error} => {
            return Result<DeclarationApplication, Shared<Rejection>>.failResult(move error)
          }
        }
        if consumed {
          argumentAt = argumentAt + usize.ONE
        }
      } else if let Binder.Row {name, ..} = &parameters[binderAt] {
        // The suffix fills one row binder; a later row binder with no positional argument is missing.
        if suffixUsed && argumentAt >= argumentIds.length {
          return Result<DeclarationApplication, Shared<Rejection>>.failResult(
            run rejectArity(&resolver.*, anchor, aritySpan, expected, argumentIds.length + usize.ONE),
          )
        }
        let step = run rowBinderArgument(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          callerModule,
          anchor,
          Bytes.asSlice(&name),
          move supplied,
          argumentSpan,
          rowSyntax,
          callerBinders,
          &mut callerElision.*,
          &mut arguments,
        )
        let consumed = match move step {
          Result<bool, Shared<Rejection>>.Success {value: taken} => taken
          Result<bool, Shared<Rejection>>.Failure {error} => {
            return Result<DeclarationApplication, Shared<Rejection>>.failResult(move error)
          }
        }
        if consumed {
          argumentAt = argumentAt + usize.ONE
        } else {
          suffixUsed = true
        }
      } else if let Binder.Type {name, ..} = &parameters[binderAt] {
        let refusal = run typeBinderArgument(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          callerModule,
          anchor,
          Bytes.asSlice(&name),
          move supplied,
          aritySpan,
          expected,
          argumentIds.length,
          callerBinders,
          &mut callerElision.*,
          &mut arguments,
        )
        if let Option<Shared<Rejection>>.Some {value: refused} = move refusal {
          return Result<DeclarationApplication, Shared<Rejection>>.failResult(move refused)
        }
        argumentAt = argumentAt + usize.ONE
      }
      binderAt = binderAt + usize.ONE
    }
    if argumentAt != argumentIds.length {
      return Result<DeclarationApplication, Shared<Rejection>>.failResult(
        run rejectArity(&resolver.*, anchor, aritySpan, expected, argumentIds.length),
      )
    }
    // A `? Row` suffix supplies the row binder that no positional argument filled; one written after
    // every row binder was supplied positionally is an extra argument.
    if rowSyntax.present && !suffixUsed {
      return Result<DeclarationApplication, Shared<Rejection>>.failResult(
        run rejectArity(&resolver.*, anchor, aritySpan, expected, argumentIds.length + usize.ONE),
      )
    }
    let bounded = run declaresBounds(&mut resolver.*, &module, declaration)
    let declarationAccess10Request = Key {
      family: family,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: declaration,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess10 = run internDeclaration(&mut resolver.*, declarationAccess10Request)
    let key = declarationAccess10
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
    let selected = run typeFromAnswer(&answer)
    if let Option<Shared<Type>>.Some {value: resolved} = move selected.resolved {
      // A declaration head names the owner's domain, not an arbitrary instantiated use. Only
      // a local whole-family owner can acquire its own bounds as premises.
      if let DeclarationApplicationContext.InherentFamily {implementation, writtenCount} = &context {
        let binderCount = writtenCount + List<Shared<Lifetime>>.length(&callerElision.generated)
        let valid = ModuleId.equals(&module, anchor) && family == Family.Identity
          && Shared<Type>.with<bool>(&resolved, fn(ty: &Type) -> bool {
            return inherentOwnerKind(ty) && declaredIn(ty, anchor)
          })
          && wholeFamilyArguments(List<Argument>.asSlice(&arguments), &implementation, writtenCount, binderCount)
        if !valid {
          return Result<DeclarationApplication, Shared<Rejection>>.failResult(
            run reject(&resolver.*, anchor, RejectionCode.InvalidInherentHead, span),
          )
        }
      }
      let mut ownerPremises = List<Constraint>.make()
      let needsBounds = match &context {
        DeclarationApplicationContext.GeneralUse => bounded
        DeclarationApplicationContext.InherentFamily {..} => true
      }
      if needsBounds && expected > usize.ZERO {
        let isPublic = match value.header {
          Node.StructHeader {isPublic, ..} => isPublic
          Node.TupleHeader {isPublic, ..} => isPublic
          Node.EnumHeader {isPublic, ..} => isPublic
          Node.UnionHeader {isPublic, ..} => isPublic
          Node.ServiceHeader {isPublic, ..} => isPublic
          Node.InterfaceHeader {isPublic, ..} => isPublic
          Node.AliasHeader {isPublic, ..} => isPublic
          _ => false
        }
        let applied = run appliedDeclarationBounds(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          declaration,
          headerGenerics(value.header),
          parameters,
          List<Argument>.asSlice(&arguments),
          span,
          isPublic,
        )
        let bounds = match move applied {
          Result<List<Constraint>, Shared<Rejection>>.Success {value: resolvedBounds} => move resolvedBounds
          Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
            return Result<DeclarationApplication, Shared<Rejection>>.failResult(move error)
          }
        }
        match &context {
          DeclarationApplicationContext.GeneralUse => {
            let deferring = match &callerElision.deferred {
              Option<List<DeferredBounds>>.Some {..} => true
              Option<List<DeferredBounds>>.None => false
            }
            if deferring {
              if let Option<List<DeferredBounds>>.Some {value: pending} = &mut callerElision.deferred {
                run List<DeferredBounds>.append(&mut pending, DeferredBounds {
                  bounds: move bounds, module: ModuleId.copy(anchor), span: span,
                })
              }
            } else {
              let mut assumptions = List<Constraint>.make()
              if let Option<List<Constraint>>.Some {value: available} = &callerElision.assumptions {
                assumptions = run copyConstraints(List<Constraint>.asSlice(&available))
              }
              let failure = run proveAppliedBounds(
                &mut resolver.*, &mut owner.*, &mut dependencies.*, &assumptions,
                List<Constraint>.asSlice(&bounds), anchor, span, RegionProof.Typing,
              )
              if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
                return Result<DeclarationApplication, Shared<Rejection>>.failResult(move diagnostic)
              }
            }
          }
          DeclarationApplicationContext.InherentFamily {..} => {
            ownerPremises = move bounds
          }
        }
      }
      // An alias (TYPE-004) instantiates the target its query resolved over its own parameters;
      // substitution renormalizes a union target. A lifetime the target omits is an implicit
      // alias parameter that this use elides, as a struct header's is.
      if family == Family.Alias {
        let found = run declarationAt(&mut resolver.*, &module, declaration)
        if let Option<DeclarationId>.Some {value: aliasId} = move found {
          let mut types = List<usize>.make()
          let mut lifetimes = List<usize>.make()
          let mut rows = List<usize>.make()
          run Type.collectOwned(&resolved, &aliasId, &mut types, &mut lifetimes, &mut rows)
          let mut implicit = expected
          while containsOrdinal(&lifetimes, implicit) {
            let elided = run elidedLifetime(&mut resolver.*, anchor, span, &mut callerElision.*)
            match move elided {
              Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
                run List<Argument>.append(&mut arguments, Argument.Lifetime {value: move lifetime})
              }
              Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
                return Result<DeclarationApplication, Shared<Rejection>>.failResult(move error)
              }
            }
            implicit = implicit + usize.ONE
          }
          let expanded = run Type.instantiate(&resolved, &aliasId, List<Argument>.asSlice(&arguments))
          return Result<DeclarationApplication, Shared<Rejection>>.succeed(
            DeclarationApplication {ty: move expanded, ownerPremises: move ownerPremises},
          )
        }
      }
      if expected > usize.ZERO {
        let found = run declarationAt(&mut resolver.*, &module, declaration)
        if let Option<DeclarationId>.Some {value: id} = move found {
          let isPublic = match value.header {
            Node.StructHeader {isPublic, ..} => isPublic
            Node.TupleHeader {isPublic, ..} => isPublic
            Node.UnionHeader {isPublic, ..} => isPublic
            Node.ServiceHeader {isPublic, ..} => isPublic
            Node.InterfaceHeader {isPublic, ..} => isPublic
            _ => false
          }
          return Result<DeclarationApplication, Shared<Rejection>>.succeed(
            DeclarationApplication {
              ty: run Types.intern(Type.Nominal {declaration: move id, isPublic: isPublic, arguments: move arguments}),
              ownerPremises: move ownerPremises,
            },
          )
        }
      }
      return Result<DeclarationApplication, Shared<Rejection>>.succeed(
        DeclarationApplication {ty: move resolved, ownerPremises: move ownerPremises},
      )
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selected.rejected {
      return Result<DeclarationApplication, Shared<Rejection>>.failResult(move diagnostic)
    }
  }
  return Result<DeclarationApplication, Shared<Rejection>>.failResult(
    run reject(&resolver.*, anchor, RejectionCode.Unsupported, span),
  )
}

// All ordinary type uses, including conformance heads and constructors, require proof.
effect fn declarationType(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, declaration: usize, anchor: &ModuleId, span: Span, aritySpan: Span, application: Option<HirId>,
  callerBinders: &[Binder], callerElision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let applied = run declarationApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, declaration, anchor, span, aritySpan, move application, callerBinders, &mut callerElision.*,
    DeclarationApplicationContext.GeneralUse)
  return match move applied {
    Result<DeclarationApplication, Shared<Rejection>>.Success {value} => Result<Shared<Type>, Shared<Rejection>>.succeed(move value.ty)
    Result<DeclarationApplication, Shared<Rejection>>.Failure {error} => Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
  }
}

effect fn selectDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  anchor: &ModuleId,
  name: &[u8],
  external: bool,
  span: Span,
  missing: RejectionCode,
  wrongKind: RejectionCode,
  exactItem: bool,
) -> Result<SelectedDeclaration, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let nameOrdinal = run internName(&mut resolver.*, name)
  let declarationAccess11Request = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: external,
  }
  let declarationAccess11 = run internDeclaration(&mut resolver.*, declarationAccess11Request)
  let key = declarationAccess11
  let observed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  drop observed
  let selectedSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, &module, name, external)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(move error)
    }
  }
  if selected.count == usize.ZERO {
    let mut code = missing
    if external { code = RejectionCode.UnknownImportedMember }
    if exactItem { code = RejectionCode.UnresolvedExactRepresentation }
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
      run memberRejection(&resolver.*, anchor, code, span, &module, name),
    )
  }
  if external && selected.publicCount == usize.ZERO {
    let origin = run reimportOrigin(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &selected, span)
    if let Option<ModuleId>.Some {value: declaring} = move origin {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
        run reimportRejection(&resolver.*, anchor, span, &module, name, &declaring),
      )
    }
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
      run memberRejection(&resolver.*, anchor, RejectionCode.PrivateMember, span, &module, name),
    )
  }
  if selected.count > usize.ONE {
    if !external && !exactItem && ModuleId.equals(&module, anchor) {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(run bindingCollision(&module, selected, name))
    }
    let mut code = RejectionCode.Collision
    if exactItem { code = RejectionCode.AmbiguousExactRepresentation }
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
      run reject(&resolver.*, anchor, code, span),
    )
  }
  if selected.kind == CandidateKind.ImportMember {
    let declarationAccess12Request = Key {
      family: Family.Import,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: selected.declaration,
      member: selected.member,
      external: false,
    }
    let declarationAccess12 = run internDeclaration(&mut resolver.*, declarationAccess12Request)
    let importKey = declarationAccess12
    let imported = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      importKey,
      span,
    )
    let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(
      &imported,
      fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) },
    )
    if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(move value)
    }
    if let Option<usize>.Some {value: targetModule} = move binding.module {
      if let Option<usize>.Some {value: declaration} = move binding.declaration {
        return Result<SelectedDeclaration, Shared<Rejection>>.succeed(
          SelectedDeclaration {module: targetModule, ordinal: declaration},
        )
      }
    }
  }
  if selected.kind == CandidateKind.Declaration {
    return Result<SelectedDeclaration, Shared<Rejection>>.succeed(
      SelectedDeclaration {module: moduleOrdinal, ordinal: selected.declaration},
    )
  }
  let mut code = wrongKind
  if exactItem { code = RejectionCode.InvalidExactRepresentation }
  return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
    run reject(&resolver.*, anchor, code, span),
  )
}

effect fn namedType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  anchor: &ModuleId,
  name: &[u8],
  external: bool,
  span: Span,
  /// Where a wrong argument count is reported (SEM0051): the type name, or a call owner's whole application.
  aritySpan: Span,
  application: Option<HirId>,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = run selectDeclaration(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    anchor,
    name,
    external,
    span,
    RejectionCode.UnknownType, RejectionCode.NotType, false)
  match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => {
      return run declarationType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        value.module,
        value.ordinal,
        anchor,
        span,
        aritySpan,
        move application,
        binders,
        &mut elision.*,
      )
    }
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
}

fn decimalU64(digits: &[u8]) -> Option<u64> {
  if digits.length == usize.ZERO || !fitsMagnitude(digits, b"18446744073709551615") {
    return Option<u64>.none()
  }
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    if digits[at] < 48 || digits[at] > 57 {
      return Option<u64>.none()
    }
    value = value * 10 + u8.toU64(digits[at] - 48)
    at = at + usize.ONE
  }
  return Option<u64>.some(value)
}

effect fn pointerAlignment(resolver: &mut Resolver, module: &ModuleId, qualifiers: Range) -> Result<
  Option<u64>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut alignment = Option<u64>.none()
  let mut seenAddressSpace = false
  let mut at = usize.ZERO
  while at < qualifiers.length {
    let child = run typeChild(&mut resolver.*, module, qualifiers, at)
    if let Option<HirId>.Some {value: id} = move child {
      let syntax = run typeNode(&mut resolver.*, module, id)
      if let Option<HeaderSyntax>.Some {value: qualifier} = move syntax {
        if let Node.PointerQualifier {name, value} = qualifier.header {
          let named = run typeNode(&mut resolver.*, module, name)
          let digits = run typeNode(&mut resolver.*, module, value)
          if let Option<HeaderSyntax>.Some {value: nameNode} = move named {
            if let Option<HeaderSyntax>.Some {value: numberNode} = move digits {
              if let Node.Name {text} = nameNode.header {
                if let Node.IntegerLiteral {magnitude, ..} = numberNode.header {
                  let sourceAnswer = run observedSyntax(&mut resolver.*, module, id)
                  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
                    &resolver.*,
                    &sourceAnswer,
                    module,
                  ) {
                    let hir = IndexedSource.authored(indexed)
                    let label = Module.text(hir, text)
                    let parsed = decimalU64(Module.text(hir, magnitude))
                    if let Option<u64>.Some {value: count} = move parsed {
                      if same(label, b"align") {
                        let vacant = match & alignment {
                          Option<u64>.None => true
                          Option<u64>.Some {value: _} => false
                        }
                        if vacant && count > 0 && count <= 536870912 && u64.bitAnd(count, count - 1) == 0 {
                          alignment = Option<u64>.some(count)
                          at = at + usize.ONE
                          continue
                        }
                      }
                      if same(label, b"addrspace") && !seenAddressSpace && count == 0 {
                        seenAddressSpace = true
                        at = at + usize.ONE
                        continue
                      }
                    }
                  }
                }
              }
            }
          }
        }
        return Result<Option<u64>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.InvalidPointerQualifier, qualifier.span),
        )
      }
    }
    return Result<Option<u64>, Shared<Rejection>>.failResult(
      run reject(
        &resolver.*,
        module,
        RejectionCode.InvalidPointerQualifier,
        Span.make(usize.ZERO, usize.ZERO),
      ),
    )
  }
  return Result<Option<u64>, Shared<Rejection>>.succeed(move alignment)
}

effect fn qualifiedTypeDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  segments: &[Bytes],
  span: Span,
) -> Result<SelectedDeclaration, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let namespace = Bytes.asSlice(&segments[usize.ZERO])
  // The sealed namespace cannot be shadowed. Its catalog type families resolve before declaration
  // lookup; any other member names a public declaration of the sealed module (INTR-008).
  if same(namespace, b"Intrinsic") {
    let sealed = canonicalModule(&resolver.*, run PackageGraph.target(&resolver.packages, module, SealedOperators.path()))
    let loaded = run source(&mut resolver.*, &sealed)
    if let Option<&IndexedSource>.None = move sourceOf(&resolver.*, &loaded, &sealed) {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    let sealedOrdinal = run internModule(&mut resolver.*, &sealed)
    let member = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, sealedOrdinal, &sealed,
      Bytes.asSlice(&segments[usize.ONE]), true, span, RejectionCode.UnknownType, RejectionCode.Unsupported, false)
    // A member the sealed module does not declare is unknown at the spelling that names it.
    return match move member {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => Result<SelectedDeclaration, Shared<Rejection>>.succeed(move value)
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {..} => Result<SelectedDeclaration, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.UnknownOperation, span))
    }
  }
  let selectedSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(move error)
    }
  }
  let nameOrdinal = run internName(&mut resolver.*, namespace)
  let declarationAccess13Request = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess13 = run internDeclaration(&mut resolver.*, declarationAccess13Request)
  let nameKey = declarationAccess13
  let observed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, nameKey, span)
  drop observed
  if selected.count != usize.ONE || selected.kind != CandidateKind.ImportModule {
    let mut code = RejectionCode.NotType
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownType
    } else if selected.count > usize.ONE {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(run bindingCollision(module, selected, namespace))
    }
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, code, span),
    )
  }
  let declarationAccess14Request = Key {
    family: Family.Import,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: selected.declaration,
    member: usize.MAX,
    external: false,
  }
  let declarationAccess14 = run internDeclaration(&mut resolver.*, declarationAccess14Request)
  let importKey = declarationAccess14
  let imported = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    importKey,
    span,
  )
  let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(&imported, fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) })
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(move diagnostic)
  }
  if let Option<usize>.Some {value: targetModule} = move binding.module {
    return run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, targetModule,
      module, Bytes.asSlice(&segments[usize.ONE]), true, span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  }
  return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

// Resolves one written application of a sealed core: no arguments for `Allocation` and
// `Intrinsic.StorageFailure`, one type for `RawBuffer` and `Intrinsic.SharedCore`, and a lifetime
// then a type for `Slot`. A wrong count points at the first excess argument, or at the list.
effect fn sealedCoreType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  core: SealedKind,
  application: Option<HirId>,
  span: Span,
  /// Where a wrong argument count is reported (SEM0051): the type name, or a call owner's whole application.
  aritySpan: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let expected = SealedCore.arity(core)
  let mut supplied = Range.empty()
  let mut listSpan = span
  if let Option<HirId>.Some {value: arguments} = move application {
    let written = run typeNode(&mut resolver.*, module, arguments)
    if let Option<HeaderSyntax>.Some {value: found} = move written {
      if let Node.TypeArguments {arguments: listed, environment, failures, requirements} = found.header {
        if environment.present || failures.present || requirements.present {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
        }
        supplied = listed
        listSpan = found.span
      }
    }
  }
  // A wrong argument count is reported at the written type name (SEM0051).
  if supplied.length != expected {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, aritySpan, expected, supplied.length))
  }
  let mut arguments = List<Argument>.make()
  let mut at = usize.ZERO
  while at < supplied.length {
    let child = run typeChild(&mut resolver.*, module, supplied, at)
    let argument = match move child {
      Option<HirId>.Some {value} => value
      Option<HirId>.None => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, listSpan))
      }
    }
    if core == SealedKind.Slot && at == usize.ZERO {
      let region = run writtenOrElidedLifetime(&mut resolver.*, module, HirRef.of(argument), span, binders, &mut elision.*)
      match move region {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => {
          run List<Argument>.append(&mut arguments, Argument.Lifetime {value: move value})
        }
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
    } else {
      let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, binders, &mut elision.*)
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
          run List<Argument>.append(&mut arguments, Argument.Type {value: move value})
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run SealedCore.make(core, move arguments))
}

effect fn qualifiedType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  segments: &[Bytes],
  span: Span,
  /// Where a wrong argument count is reported (SEM0051): the type name, or a call owner's whole application.
  aritySpan: Span,
  application: Option<HirId>,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // `Intrinsic.Slot<'s, T>`, `Intrinsic.SharedCore<T>` and the other storage families are sealed.
  if same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") && segments.length == 2 {
    if let Option<SealedKind>.Some {value: core} = move SealedCore.intrinsicFamily(Bytes.asSlice(&segments[usize.ONE])) {
      return run sealedCoreType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, core,
        move application, span, aritySpan, binders, &mut elision.*)
    }
    // A sealed property bounds a type or heads an `impl`; it is never a value type.
    if let Option<SealedProperty>.Some {..} = move propertyNamed(Bytes.asSlice(&segments[usize.ONE])) {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.NotType, span),
      )
    }
  }
  let selected = run qualifiedTypeDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, segments, span)
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  return run declarationType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    declaration.module, declaration.ordinal, module, span, aritySpan, move application, binders, &mut elision.*)
}

fn borrowedOrBare(value: &Type) -> bool {
  return match & value.* {
    Type.Reference {..} => true
    Type.Slice {..} => true
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

effect fn unionMemberRejection(resolver: &mut Resolver, module: &ModuleId, memberId: HirId) -> Shared<
  Rejection,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, memberId)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
  }
  return run reject(&resolver.*, module, RejectionCode.InvalidUnionMember, span)
}

// Whether a written type is a bare name that one of the declaration's own type binders resolves.
effect fn writtenTypeParameter(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: typeName, hasMode, ..} = value.header {
      if hasMode { return false }
      let parsed = run path(&mut resolver.*, module, typeName)
      let segments = List<Bytes>.asSlice(&parsed.segments)
      if !parsed.valid || segments.length != usize.ONE { return false }
      let mut at = usize.ZERO
      while at < binders.length {
        if let Binder.Type {name, ..} = &binders[at] {
          if same(Bytes.asSlice(&name), Bytes.asSlice(&segments[usize.ZERO])) { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Resolves one written union member and joins it into `members`.
effect fn joinUnionMember(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  memberId: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  members: &mut List<Shared<Type>>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let resolved = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    memberId,
    binders,
    &mut elision.*,
  )
  let ty = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: joining} => move joining
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Option<Shared<Rejection>>.some(move error)
    }
  }
  // A written borrow or bare executable contract has no detached storage (UNION-001). A member
  // written as a type parameter is checked by its declaration's unapplied resolution; an applied
  // signature such as `Effect.catchAll`'s `A | B` may substitute a reference for it.
  let parameter = run writtenTypeParameter(&mut resolver.*, module, memberId, binders)
  let written = !parameter && Shared<Type>.with<bool>(&ty, borrowedOrBare)
  // A slot selection, directly or as fixed-array elements, is never a union member.
  if written || Shared<Type>.with<bool>(&ty, SealedCore.storesSelection) {
    return Option<Shared<Rejection>>.some(
      run unionMemberRejection(&mut resolver.*, module, memberId),
    )
  }
  run Type.joinMember(&mut members.*, &ty)
  return Option<Shared<Rejection>>.none()
}

// `simd<T, N>` (an element) or `mask<N>` (no element): a closed lane type and a static lane count
// whose shape SIMD-001 admits on this target (SEM0239).
effect fn resolveVector(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  element: Option<HirId>,
  lanes: HirId,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let evaluated = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, Option<usize>.none(), lanes, StaticRootExpectation.IntegerExtent,
    &[], &[],
  )
  let count = match move evaluated {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  let pointerBits = u32.toUsize(resolver.target.pointerBits())
  let extent = match move run StaticConstant.extent(&count, resolver.target.pointerBits()) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run vectorShapeRejection(module, span),
      )
    }
  }
  let laneCount = match move Type.extentValue(Bytes.asSlice(&extent)) {
    Option<usize>.Some {value} => value
    Option<usize>.None => usize.ZERO
  }
  let mut lane = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  if let Option<HirId>.Some {value: written} = move element {
    let resolved = run resolveType(
      &mut resolver.*, &mut owner.*, &mut dependencies.*,
      moduleOrdinal, written, binders, &mut elision.*,
    )
    lane = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
    // A mask is spelled `mask<N>`, never `simd<bool, N>`.
    if Shared<Type>.with<usize>(&lane, fn(value: &Type) -> usize { return Type.laneBits(value, pointerBits) }) == usize.ONE {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run vectorShapeRejection(module, span),
      )
    }
  }
  let admitted = Shared<Type>.with<bool>(&lane, fn(value: &Type) -> bool { return Type.admitsVector(value, laneCount, pointerBits) })
  if !admitted {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run vectorShapeRejection(module, span),
    )
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Vector {element: move lane, lanes: move extent}))
}

// An unadmitted `simd<T, N>` or `mask<N>` shape (SEM0239, SIMD-001).
effect fn vectorShapeRejection(module: &ModuleId, span: Span) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InvalidVectorShape, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
  return run Shared<Rejection>.make(move diagnostic)
}

// A vector operation's refusal of its type arguments (SEM0239, SIMD-003 through SIMD-006): which
// lanes it takes, or which measure its two vectors must share.
effect fn vectorOperationRejection(module: &ModuleId, span: Span, primitive: IntrinsicPrimitive, typeArguments: &[Shared<Type>],
  refusal: IntrinsicVectorRefusal) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InvalidVectorShape, module, span)
  let mut operation = run Bytes.copy(b"Intrinsic.")
  run Bytes.append(&mut operation, CheckedIntrinsic.spelling(primitive))
  match refusal {
    IntrinsicVectorRefusal.Lane {at} => {
      // The checker counts type arguments first, so only a type argument is refused here.
      if at >= typeArguments.length { return run Shared<Rejection>.make(move diagnostic) }
      let shown = match move run TypeText.display(&typeArguments[at], module) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => { return run Shared<Rejection>.make(move diagnostic) }
      }
      run vectorArgument(&mut diagnostic, b"template", b"1")
      run vectorArgument(&mut diagnostic, b"lanes", CheckedIntrinsic.laneClassText(CheckedIntrinsic.laneClass(primitive)))
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move shown})
    }
    IntrinsicVectorRefusal.Measure {first, second} => {
      run vectorArgument(&mut diagnostic, b"template", b"2")
      if primitive == IntrinsicPrimitive.SimdBitcast {
        run vectorArgument(&mut diagnostic, b"measure", b"width in bits")
      } else {
        run vectorArgument(&mut diagnostic, b"measure", b"lane count")
      }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"firstValue"), value: run decimalText(first)})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"secondValue"), value: run decimalText(second)})
    }
    IntrinsicVectorRefusal.LaneType => {
      run vectorArgument(&mut diagnostic, b"template", b"2")
      run vectorArgument(&mut diagnostic, b"measure", b"lane type")
      run vectorLaneArgument(module, &mut diagnostic, b"firstValue", &typeArguments[usize.ZERO])
      run vectorLaneArgument(module, &mut diagnostic, b"secondValue", &typeArguments[usize.ONE])
    }
    IntrinsicVectorRefusal.Arch => {
      // An architecture operation's one type argument is its first operand (SIMD-007).
      let shown = match move run TypeText.display(&typeArguments[usize.ZERO], module) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => { return run Shared<Rejection>.make(move diagnostic) }
      }
      run vectorArgument(&mut diagnostic, b"template", b"4")
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"shapes"), value: run archOperandsText(primitive)})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move shown})
    }
  }
  if typeArguments.length == 2 {
    if let Option<Bytes>.Some {value: first} = move run TypeText.display(&typeArguments[usize.ZERO], module) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"first"), value: move first})
    }
    if let Option<Bytes>.Some {value: second} = move run TypeText.display(&typeArguments[usize.ONE], module) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"second"), value: move second})
    }
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: move operation})
  return run Shared<Rejection>.make(move diagnostic)
}

// The first-operand shapes of an architecture operation's catalog rows, each once, as
// `simd<u8, 16> or simd<u8, 32>`.
effect fn archOperandsText(primitive: IntrinsicPrimitive) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let mut count = usize.ZERO
  while CheckedIntrinsic.archSignature(primitive, count).arity != usize.ZERO { count = count + usize.ONE }
  let mut written = usize.ZERO
  let mut at = usize.ZERO
  while at < count {
    let shape = CheckedIntrinsic.archSignature(primitive, at).operands[usize.ZERO]
    if !archShapeListed(primitive, at, shape) {
      // The last new shape after the first is joined with `or`; earlier ones with commas.
      let mut later = false
      let mut next = at + usize.ONE
      while next < count {
        if !archShapeListed(primitive, next, CheckedIntrinsic.archSignature(primitive, next).operands[usize.ZERO]) { later = true }
        next = next + usize.ONE
      }
      if written > usize.ZERO {
        if later { run Bytes.append(&mut text, b", ") } else { run Bytes.append(&mut text, b" or ") }
      }
      run Bytes.append(&mut text, b"simd<")
      run Bytes.append(&mut text, ScalarOperation.scalarSpelling(shape.lane))
      run Bytes.append(&mut text, b", ")
      run appendDecimal(&mut text, shape.lanes)
      run Bytes.append(&mut text, b">")
      written = written + usize.ONE
    }
    at = at + usize.ONE
  }
  return move text
}

// Whether a catalog row of `primitive` before `before` has the first-operand `shape`.
fn archShapeListed(primitive: IntrinsicPrimitive, before: usize, shape: CheckedIntrinsic.ArchShape) -> bool {
  let mut at = usize.ZERO
  while at < before {
    let earlier = CheckedIntrinsic.archSignature(primitive, at).operands[usize.ZERO]
    if earlier.lanes == shape.lanes && same(ScalarOperation.scalarSpelling(earlier.lane), ScalarOperation.scalarSpelling(shape.lane)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn vectorArgument(diagnostic: &mut Rejection, name: &[u8], value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(name), value: run Bytes.copy(value)})
}

// The lane type of `vector` as argument `name`, when it prints.
effect fn vectorLaneArgument(viewer: &ModuleId, diagnostic: &mut Rejection, name: &[u8], vector: &Shared<Type>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: lane} = move CheckedIntrinsic.vectorLane(vector) {
    if let Option<Bytes>.Some {value: shown} = move run TypeText.display(&lane, viewer) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(name), value: move shown})
    }
  }
}

effect fn resolveUnion(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  written: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut members = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < written.length {
    let child = run typeChild(&mut resolver.*, module, written, at)
    if let Option<HirId>.Some {value: memberId} = move child {
      let refusal = run joinUnionMember(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        memberId,
        binders,
        &mut elision.*,
        &mut members,
      )
      if let Option<Shared<Rejection>>.Some {value: refused} = move refusal {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(move refused)
      }
    }
    at = at + usize.ONE
  }
  let joined = List<Shared<Type>>.asSlice(&members)
  if joined.length == usize.ONE {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(&joined[usize.ZERO]))
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(
    run Types.intern(Type.Union {members: move members}),
  )
}

// Resolves a written `'a & 'b` environment to its canonical intersection. A written but empty
// environment is invalid rather than a request for elision.
effect fn writtenEnvironment(
  resolver: &mut Resolver,
  module: &ModuleId,
  regions: Range,
  span: Span,
  binders: &[Binder],
) -> Result<Intersection, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if regions.length == usize.ZERO {
    return Result<Intersection, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
    )
  }
  let mut members = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < regions.length {
    let child = run typeChild(&mut resolver.*, module, regions, at)
    if let Option<HirId>.Some {value: id} = move child {
      let resolved = run lifetimeAt(&mut resolver.*, module, id, binders)
      match move resolved {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => {
          run List<Shared<Lifetime>>.append(&mut members, move value)
        }
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result<Intersection, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  return Result<Intersection, Shared<Rejection>>.succeed(
    run Intersection.of(List<Shared<Lifetime>>.asSlice(&members)),
  )
}

// An omitted environment elides to one region.
effect fn elidedEnvironment(
  resolver: &mut Resolver,
  module: &ModuleId,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Intersection, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if elision.staticEnvironment {
    elision.staticEnvironment = false
    let none = List<Shared<Lifetime>>.make()
    return Result<Intersection, Shared<Rejection>>.succeed(
      run Intersection.of(List<Shared<Lifetime>>.asSlice(&none)),
    )
  }
  let elided = run writtenOrElidedLifetime(
    &mut resolver.*,
    module,
    HirRef.absent(),
    span,
    binders,
    &mut elision.*,
  )
  return match move elided {
    Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => {
      let mut regions = List<Shared<Lifetime>>.make()
      run List<Shared<Lifetime>>.append(&mut regions, move value)
      return Result<Intersection, Shared<Rejection>>.succeed(
        run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions)),
      )
    }
    Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => Result<
      Intersection,
      Shared<Rejection>,
    >.failResult(move error)
  }
}

effect fn resolveEffect(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  span: Span,
  /// The written type without its arguments, where a wrong argument count is reported (SEM0051).
  nameSpan: Span,
  application: Option<HirId>,
  mode: CallableMode,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut supplied = Range.empty()
  let mut argumentSpan = span
  let mut declared = Option<Range>.none()
  let mut failures = HirRef.absent()
  let mut requirements = HirRef.absent()
  if let Option<HirId>.Some {value: id} = move application {
    let syntax = run typeNode(&mut resolver.*, module, id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      argumentSpan = value.span
      if let Node.TypeArguments {
        arguments,
        environment: written,
        failures: failure,
        requirements: row,
      } = value.header {
        if written.present {
          declared = Option<Range>.some(written.range)
        }
        supplied = arguments
        failures = failure
        requirements = row
      }
    }
  }
  if supplied.length != usize.ONE {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run rejectArity(&resolver.*, module, nameSpan, usize.ONE, supplied.length),
    )
  }
  let retained = match move declared {
    Option<Range>.Some {value: regions} => run writtenEnvironment(
      &mut resolver.*,
      module,
      regions,
      argumentSpan,
      binders,
    )
    Option<Range>.None => run elidedEnvironment(
      &mut resolver.*,
      module,
      span,
      binders,
      &mut elision.*,
    )
  }
  let region = match move retained {
    Result<Intersection, Shared<Rejection>>.Success {value: found} => run Shared<Intersection>.make(
      move found,
    )
    Result<Intersection, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  // The parameterless default covers only the result's own environment, written or not.
  elision.staticEnvironment = false
  let successId = run typeChild(&mut resolver.*, module, supplied, usize.ZERO)
  let mut success = run Types.intern(Type.Unit)
  if let Option<HirId>.Some {value: id} = move successId {
    let syntax = run typeNode(&mut resolver.*, module, id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      let mut kind = GenericKind.Type
      if let Node.Lifetime {..} = value.header {
        kind = GenericKind.Lifetime
      }
      if let Node.RequirementSelector {..} = value.header {
        kind = GenericKind.Requirement
      }
      if kind != GenericKind.Type {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(
          run rejectKind(&resolver.*, module, value.span, b"", GenericKind.Type, kind),
        )
      }
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      id,
      binders,
      &mut elision.*,
    )
    success = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  let channels = run resolveChannels(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    failures,
    requirements,
    binders,
    &mut elision.*,
  )
  match move channels {
    Result<Channels, Shared<Rejection>>.Success {value} => {
      return Result<Shared<Type>, Shared<Rejection>>.succeed(
        run Types.intern(
          Type.Effect {
            mode: mode,
            environment: move region,
            success: move success,
            failure: move value.failure,
            requirements: move value.requirements,
          },
        ),
      )
    }
    Result<Channels, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
}

// Resolves a written `! E` and `? R`; omission is `never` and the empty row, not inference.
effect fn resolveChannels(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  failures: HirRef,
  requirements: HirRef,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Channels, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut failure = run Types.intern(Type.Union {members: List<Shared<Type>>.make()})
  if failures.present {
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      failures.id,
      binders,
      &mut elision.*,
    )
    failure = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result<Channels, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  let mut row = Row.empty()
  if requirements.present {
    let syntax = run typeNode(&mut resolver.*, module, requirements.id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      if let Node.RequirementRow {members} = value.header {
        let mut at = usize.ZERO
        while at < members.length {
          let child = run typeChild(&mut resolver.*, module, members, at)
          if let Option<HirId>.Some {value: memberId} = move child {
            let added = run requireMember(
              &mut resolver.*,
              &mut owner.*,
              &mut dependencies.*,
              moduleOrdinal,
              module,
              memberId,
              binders,
              &mut elision.*,
              &mut row,
            )
            if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
              return Result<Channels, Shared<Rejection>>.failResult(move diagnostic)
            }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  return Result<Channels, Shared<Rejection>>.succeed(
    Channels {failure: move failure, requirements: run Shared<Row>.make(move row)},
  )
}

// Adds the `?R` binder spelled `name` to `row`, reporting whether such a binder exists.
effect fn spliceRowBinder(binders: &[Binder], name: &[u8], row: &mut Row) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Row {name: spelled, value: parameter, bound} = &binders[at] {
      if same(Bytes.asSlice(&spelled), name) {
        // An applied declaration splices its supplied row in place of the binder.
        if let Option<Shared<Row>>.Some {value: supplied} = &bound {
          run Row.merge(&mut row.*, &supplied)
        } else {
          run Row.include(
            &mut row.*,
            RowParameter {
              declaration: Shared<DeclarationId>.clone(&parameter.declaration),
              ordinal: parameter.ordinal,
            },
          )
        }
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Adds one written row member. `never` adds nothing; a bare name may select a `?R` binder.
effect fn requireMember(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  row: &mut Row,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let syntax = run typeNode(&mut resolver.*, module, id)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.Requirement {access, capability, rolePath, ..} = value.header {
      let resolved = run capabilityType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        capability,
        binders,
        &mut elision.*,
      )
      let capability = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Option<Shared<Rejection>>.some(move error)
        }
      }
      let kind = Shared<Type>.with<OwnerKind>(&capability, nominalKind)
      if kind != OwnerKind.Service {
        let mut code = RejectionCode.InvalidRequirement
        // A generic capability needs conformance evidence, which this wave does not solve.
        if Shared<Type>.with<bool>(&capability, isTypeParameter) {
          code = RejectionCode.Unsupported
        }
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, span))
      }
      let mut roleType = Option<Shared<Type>>.none()
      if rolePath.present {
        let selected = run roleDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          rolePath.id,
          binders,
          &mut elision.*,
        )
        roleType = match move selected {
          Result<Shared<Type>, Shared<Rejection>>.Success {value: declaration} => Option<Shared<Type>>.some(
            move declaration,
          )
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
            return Option<Shared<Rejection>>.some(move error)
          }
        }
      }
      let requirement = Requirement {capability: move capability, roleType: move roleType, access: access}
      // One key is required once: `&S | &mut S` would silently mean only `&mut S`.
      if run Row.accessConflict(&row.*, &requirement) {
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ConflictingRequirementAccess, span))
      }
      run Row.require(&mut row.*, move requirement)
      return Option<Shared<Rejection>>.none()
    }
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      let parsed = run path(&mut resolver.*, module, written)
      let segments = List<Bytes>.asSlice(&parsed.segments)
      if !hasMode && parsed.valid && segments.length == usize.ONE {
        let name = Bytes.asSlice(&segments[usize.ZERO])
        if same(name, b"never") {
          return Option<Shared<Rejection>>.none()
        }
        if run spliceRowBinder(binders, name, &mut row.*) {
          return Option<Shared<Rejection>>.none()
        }
      }
    }
    if let Node.RowWithout {source, removed} = value.header {
      return run subtractRows(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        source,
        removed,
        binders,
        &mut elision.*,
        &mut row.*,
      )
    }
    // `Without<R, S> | Q` parses as one union member; each operand joins the row as written.
    if let Node.UnionType {members} = value.header {
      let mut at = usize.ZERO
      while at < members.length {
        let child = run typeChild(&mut resolver.*, module, members, at)
        if let Option<HirId>.Some {value: memberId} = move child {
          let added = run requireMember(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
            memberId, binders, &mut elision.*, &mut row.*)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
            return Option<Shared<Rejection>>.some(move diagnostic)
          }
        }
        at = at + usize.ONE
      }
      return Option<Shared<Rejection>>.none()
    }
  }
  return Option<Shared<Rejection>>.some(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, span),
  )
}

// Resolves `Without<source, removed>` (SERV-008) into `row`. The second operand names service-role
// keys, so it also admits access-free selectors such as `Clock` and `Clock at Primary`.
effect fn subtractRows(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  source: HirId,
  removed: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  row: &mut Row,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut from = Row.empty()
  let sourceFailed = run rowArgument(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    source,
    b"Without",
    binders,
    &mut elision.*,
    false,
    &mut from,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move sourceFailed {
    return Option<Shared<Rejection>>.some(move diagnostic)
  }
  let mut keys = Row.empty()
  let keysFailed = run rowArgument(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    removed,
    b"Without",
    binders,
    &mut elision.*,
    true,
    &mut keys,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move keysFailed {
    return Option<Shared<Rejection>>.some(move diagnostic)
  }
  let sourceRow = run Shared<Row>.make(move from)
  let keyRow = run Shared<Row>.make(move keys)
  run Row.subtract(&mut row.*, &sourceRow, &keyRow)
  return Option<Shared<Rejection>>.none()
}

// The service that the standard library `Option` union stands for in requirement rows. Only the
// union `Option` of `silk/option.silk` names one, the `OptionService` declared beside it (SERV-011).
effect fn unionService(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, identity: &DeclarationId) -> Option<usize>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let standard = ModuleId.withPath<bool>(&module, fn(path: &[u8]) -> bool { return same(path, b"silk/option.silk") })
  if !standard || DeclarationId.ownerCount(identity) != usize.ONE || !DeclarationId.named(identity, b"Option") {
    return Option<usize>.none()
  }
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module,
    b"OptionService", false, Span {start: usize.ZERO, end: usize.ZERO}, RejectionCode.UnknownType, RejectionCode.NotType, false)
  if let Result<SelectedDeclaration, Shared<Rejection>>.Success {value: found} = move selected {
    if found.module != moduleOrdinal { return Option<usize>.none() }
    if let Option<DeclarationId>.Some {value: candidate} = move run declarationAt(&mut resolver.*, &module, found.ordinal) {
      if DeclarationId.kind(&candidate) == OwnerKind.Service { return Option<usize>.some(found.ordinal) }
    }
  }
  return Option<usize>.none()
}

// Whether the optional service `value` stands for needs exclusive access to its service.
fn lendsExclusively(value: &Type) -> bool {
  if let Type.Nominal {arguments, ..} = &value.* {
    let supplied = List<Argument>.asSlice(&arguments)
    let mut at = usize.ZERO
    while at < supplied.length {
      if let Argument.Row {value: row} = &supplied[at] {
        if Shared<Row>.with<bool>(&row, exclusiveEntry) {
          return true
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

fn exclusiveEntry(row: &Row) -> bool {
  let entries = List<Requirement>.asSlice(&row.entries)
  let mut at = usize.ZERO
  while at < entries.length {
    if entries[at].access == Access.Mutable {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Resolves the capability a requirement names. The standard library `Option` stands for its service
// applied to the same arguments, so `&Option<&Tracer>` is a key (SERV-011).
effect fn capabilityType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let syntax = run typeNode(&mut resolver.*, &module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    let mut selected = value.header
    let mut application = Option<HirId>.none()
    let mut targetSpan = value.span
    if let Node.AppliedType {target, arguments} = selected {
      let writtenTarget = run typeNode(&mut resolver.*, &module, target)
      if let Option<HeaderSyntax>.Some {value: named} = move writtenTarget {
        selected = named.header
        application = Option<HirId>.some(arguments)
        targetSpan = named.span
      }
    }
    let writtenSpan = value.span
    if let Node.NamedType {path: typeName, hasMode, ..} = selected {
      let parsed = run path(&mut resolver.*, &module, typeName)
      let segments = List<Bytes>.asSlice(&parsed.segments)
      if !hasMode && parsed.valid && segments.length == usize.ONE && !hasBinder(binders, Bytes.asSlice(&segments[usize.ZERO])) {
        let found = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module,
          Bytes.asSlice(&segments[usize.ZERO]), false, parsed.span, RejectionCode.UnknownType, RejectionCode.NotType, false)
        if let Result<SelectedDeclaration, Shared<Rejection>>.Success {value: declared} = move found {
          let unionModule = resolvedModule(&resolver.*, declared.module)
          if let Option<DeclarationId>.Some {value: identity} = move run declarationAt(&mut resolver.*, &unionModule, declared.ordinal) {
            if DeclarationId.kind(&identity) == OwnerKind.Union {
              if let Option<usize>.Some {value: named} = move run unionService(&mut resolver.*, &mut owner.*, &mut dependencies.*,
                declared.module, &identity) {
                let lifted = run declarationType(&mut resolver.*, &mut owner.*, &mut dependencies.*, declared.module, named, &module,
                  parsed.span, targetSpan, move application, binders, &mut elision.*)
                // An `Option` provider lends its service through a shared borrow, so nothing can
                // provide `&Option<&mut S>`.
                if let Result<Shared<Type>, Shared<Rejection>>.Success {value: optional} = &lifted {
                  if Shared<Type>.with<bool>(&optional, lendsExclusively) {
                    return Result<Shared<Type>, Shared<Rejection>>.failResult(
                      run reject(&resolver.*, &module, RejectionCode.OptionalExclusiveRequirement, writtenSpan),
                    )
                  }
                }
                return move lifted
              }
            }
          }
        }
      }
    }
  }
  return run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, id, binders, &mut elision.*)
}

// Resolves an access-free service-role key (`Clock` or `Clock at Primary`) into `row`. The entry's
// shared access is a placeholder: keys match independently of access (SERV-007, SERV-008). Returns
// `None` when the operand is not a service, so the caller reports its own kind error.
effect fn requireKey(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  subject: HirId,
  rolePath: HirRef,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  row: &mut Row,
) -> Option<Option<Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let resolved = run capabilityType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    subject,
    binders,
    &mut elision.*,
  )
  let capability = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Option<Option<Shared<Rejection>>>.some(Option<Shared<Rejection>>.some(move error))
    }
  }
  if Shared<Type>.with<OwnerKind>(&capability, nominalKind) != OwnerKind.Service {
    return Option<Option<Shared<Rejection>>>.none()
  }
  let mut roleType = Option<Shared<Type>>.none()
  if rolePath.present {
    let selected = run roleDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      rolePath.id,
      binders,
      &mut elision.*,
    )
    match move selected {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: declaration} => {
        roleType = Option<Shared<Type>>.some(move declaration)
      }
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option<Option<Shared<Rejection>>>.some(Option<Shared<Rejection>>.some(move error))
      }
    }
  }
  run Row.require(
    &mut row.*,
    Requirement {capability: move capability, roleType: move roleType, access: Access.Shared},
  )
  return Option<Option<Shared<Rejection>>>.some(Option<Shared<Rejection>>.none())
}

// Adds one positional requirement-row argument to `row`: `never`, a `?R` binder, a borrowed service
// with an optional `at` role, or a union of those. A value type in a row position is a kind error.
effect fn rowArgument(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  parameterName: &[u8],
  binders: &[Binder],
  elision: &mut LifetimeElision,
  keys: bool,
  row: &mut Row,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let syntax = run typeNode(&mut resolver.*, module, id)
  let written = match move syntax {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Option<Shared<Rejection>>.some(
        run reject(
          &resolver.*,
          module,
          RejectionCode.InvalidRequirement,
          Span.make(usize.ZERO, usize.ZERO),
        ),
      )
    }
  }
  if keys {
    // A key names a service and role only; access belongs to the stored entry (SERV-007, SERV-008).
    if let Node.ReferenceType {..} = written.header {
      return Option<Shared<Rejection>>.some(
        run reject(&resolver.*, module, RejectionCode.InvalidRequirement, written.span),
      )
    }
    if let Node.Requirement {hasAccess, capability, rolePath, ..} = written.header {
      if hasAccess {
        return Option<Shared<Rejection>>.some(
          run reject(&resolver.*, module, RejectionCode.InvalidRequirement, written.span),
        )
      }
      let key = run requireKey(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        capability,
        rolePath,
        binders,
        &mut elision.*,
        &mut row.*,
      )
      if let Option<Option<Shared<Rejection>>>.Some {value: outcome} = move key {
        return move outcome
      }
      return Option<Shared<Rejection>>.some(
        run reject(&resolver.*, module, RejectionCode.InvalidRequirement, written.span),
      )
    }
  }
  if let Node.UnionType {members} = written.header {
    let mut at = usize.ZERO
    while at < members.length {
      let child = run typeChild(&mut resolver.*, module, members, at)
      if let Option<HirId>.Some {value: memberId} = move child {
        let added = run rowArgument(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          memberId,
          parameterName,
          binders,
          &mut elision.*,
          keys,
          &mut row.*,
        )
        if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
          return Option<Shared<Rejection>>.some(move diagnostic)
        }
      }
      at = at + usize.ONE
    }
    return Option<Shared<Rejection>>.none()
  }
  // A written `&Service at Role` row operand, as lowered inside `Without`.
  if let Node.Requirement {..} = written.header {
    return run requireMember(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      id,
      binders,
      &mut elision.*,
      &mut row.*,
    )
  }
  if let Node.RowWithout {source, removed} = written.header {
    return run subtractRows(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      source,
      removed,
      binders,
      &mut elision.*,
      &mut row.*,
    )
  }
  if let Node.ReferenceType {referent, access, lifetime, roleName} = written.header {
    if lifetime.present {
      return Option<Shared<Rejection>>.some(
        run reject(&resolver.*, module, RejectionCode.InvalidRequirement, written.span),
      )
    }
    let resolved = run capabilityType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      referent,
      binders,
      &mut elision.*,
    )
    let capability = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option<Shared<Rejection>>.some(move error)
      }
    }
    if Shared<Type>.with<OwnerKind>(&capability, nominalKind) != OwnerKind.Service {
      let mut code = RejectionCode.InvalidRequirement
      if Shared<Type>.with<bool>(&capability, isTypeParameter) {
        code = RejectionCode.Unsupported
      }
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, code, written.span))
    }
    let mut roleType = Option<Shared<Type>>.none()
    if roleName.present {
      let selected = run roleDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        roleName.id,
        binders,
        &mut elision.*,
      )
      match move selected {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: declaration} => {
          roleType = Option<Shared<Type>>.some(move declaration)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Option<Shared<Rejection>>.some(move error)
        }
      }
    }
    run Row.require(
      &mut row.*,
      Requirement {capability: move capability, roleType: move roleType, access: access},
    )
    return Option<Shared<Rejection>>.none()
  }
  if let Node.NamedType {path: named, hasMode, ..} = written.header {
    let parsed = run path(&mut resolver.*, module, named)
    let segments = List<Bytes>.asSlice(&parsed.segments)
    if !hasMode && parsed.valid && segments.length == usize.ONE {
      let spelled = Bytes.asSlice(&segments[usize.ZERO])
      let mut rowName = same(spelled, b"never")
      let mut at = usize.ZERO
      while at < binders.length {
        if let Binder.Row {name, ..} = &binders[at] {
          if same(Bytes.asSlice(&name), spelled) {
            rowName = true
          }
        }
        at = at + usize.ONE
      }
      if rowName {
        return run requireMember(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          id,
          binders,
          &mut elision.*,
          &mut row.*,
        )
      }
    }
  }
  if keys {
    // A key position (a selector or `Without` operand) names a service and role without access.
    let mut subject = id
    let mut selectedRole = HirRef.absent()
    if let Node.RequirementSelector {subject: selected, rolePath} = written.header {
      subject = selected
      selectedRole = HirRef.of(rolePath)
    }
    let key = run requireKey(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      subject,
      selectedRole,
      binders,
      &mut elision.*,
      &mut row.*,
    )
    if let Option<Option<Shared<Rejection>>>.Some {value: outcome} = move key {
      return move outcome
    }
  }
  // Outside a key position, a role selector without a borrow names no access, so it cannot be a
  // row entry.
  if let Node.RequirementSelector {..} = written.header {
    return Option<Shared<Rejection>>.some(
      run reject(&resolver.*, module, RejectionCode.InvalidRequirement, written.span),
    )
  }
  return Option<Shared<Rejection>>.some(
    run rejectKind(
      &resolver.*,
      module,
      written.span,
      parameterName,
      GenericKind.Requirement,
      GenericKind.Type,
    ),
  )
}

fn executableContract(value: &Type) -> bool {
  return match & value.* {
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

fn nominalKind(value: &Type) -> OwnerKind {
  return match & value.* {
    Type.Nominal {declaration, ..} => DeclarationId.kind(&declaration)
    _ => OwnerKind.Damaged
  }
}

fn isTypeParameter(value: &Type) -> bool {
  return match & value.* {
    Type.Parameter {..} => true
    _ => false
  }
}

// Resolves the `at` path of a requirement through ordinary type lookup, keeping its identity demand.
effect fn roleDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let parsed = run path(&mut resolver.*, module, id)
  let segments = List<Bytes>.asSlice(&parsed.segments)
  let mut resolved = Result<Shared<Type>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, parsed.span),
  )
  if parsed.valid && segments.length == usize.ONE {
    resolved = run namedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&segments[usize.ZERO]),
      false,
      parsed.span,
      parsed.span,
      Option<HirId>.none(),
      binders,
      &mut elision.*,
    )
  } else if parsed.valid && segments.length == 2 {
    resolved = run qualifiedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      segments,
      parsed.span,
      parsed.span,
      Option<HirId>.none(),
      binders,
      &mut elision.*,
    )
  }
  let selected = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  if Shared<Type>.with<OwnerKind>(&selected, nominalKind) == OwnerKind.Role {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(move selected)
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, parsed.span),
  )
}

effect fn copyBinder(binder: &Binder) -> Binder ! OutOfMemoryError ? &mut Allocator {
  return match & binder.* {
    Binder.Type {name, value} => Binder.Type {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: Shared<Type>.clone(&value),
    }
    Binder.Lifetime {name, value} => Binder.Lifetime {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: Shared<Lifetime>.clone(&value),
    }
    Binder.Row {name, value, bound} => Binder.Row {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: RowParameter {
        declaration: Shared<DeclarationId>.clone(&value.declaration),
        ordinal: value.ordinal,
      },
      bound: copyBound(&bound),
    }
  }
}

// Adds the written `for<...>` binders as invocation lifetimes ahead of the surrounding binders, so
// they shadow a surrounding lifetime of the same name inside the contract.
effect fn quantifiedScope(
  resolver: &mut Resolver,
  module: &ModuleId,
  quantified: Range,
  binders: &[Binder],
  renumber: &List<usize>,
) -> Result<List<Binder>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut scope = List<Binder>.make()
  let mut at = usize.ZERO
  while at < quantified.length {
    let child = run typeChild(&mut resolver.*, module, quantified, at)
    let mut accepted = false
    let mut span = Span.make(usize.ZERO, usize.ZERO)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        span = value.span
        if let Node.LifetimeParameter {name, ..} = value.header {
          let named = run typeNode(&mut resolver.*, module, name)
          if let Option<HeaderSyntax>.Some {value: token} = move named {
            if let Node.Name {text} = token.header {
              let sourceAnswer = run observedSyntax(&mut resolver.*, module, parameterId)
              if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
                &resolver.*,
                &sourceAnswer,
                module,
              ) {
                let spelling = run Bytes.copy(Module.text(IndexedSource.authored(indexed), text))
                if same(Bytes.asSlice(&spelling), b"'static") || hasBinder(
                  List<Binder>.asSlice(&scope),
                  Bytes.asSlice(&spelling),
                ) {
                  return Result<List<Binder>, Shared<Rejection>>.failResult(
                    run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
                  )
                }
                run List<Binder>.append(
                  &mut scope,
                  Binder.Lifetime {
                    name: move spelling,
                    value: run Shared<Lifetime>.make(
                      Lifetime.Invocation {ordinal: renumbered(renumber, at)},
                    ),
                  },
                )
                accepted = true
              }
            }
          }
        }
      }
    }
    if !accepted {
      return Result<List<Binder>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
      )
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < binders.length {
    run List<Binder>.append(&mut scope, run copyBinder(&binders[at]))
    at = at + usize.ONE
  }
  return Result<List<Binder>, Shared<Rejection>>.succeed(move scope)
}

// Appends one `'longer: 'shorter` bound for each lifetime written after the colon of the `at`th
// quantified binder.
effect fn writtenOutlives(
  resolver: &mut Resolver,
  module: &ModuleId,
  written: Range,
  at: usize,
  scope: &[Binder],
  renumber: &List<usize>,
  bounds: &mut List<Outlives>,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut boundAt = usize.ZERO
  while boundAt < written.length {
    let bound = run typeChild(&mut resolver.*, module, written, boundAt)
    if let Option<HirId>.Some {value: boundId} = move bound {
      let resolved = run lifetimeAt(&mut resolver.*, module, boundId, scope)
      let shorter = match move resolved {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Option<Shared<Rejection>>.some(move error)
        }
      }
      run List<Outlives>.append(
        &mut bounds.*,
        Outlives {
          longer: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: renumbered(renumber, at)}),
          shorter: move shorter,
        },
      )
    }
    boundAt = boundAt + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// Records the bounds of one quantified binder; a binder that is not a lifetime parameter has none.
effect fn parameterOutlives(
  resolver: &mut Resolver,
  module: &ModuleId,
  parameterId: HirId,
  at: usize,
  scope: &[Binder],
  renumber: &List<usize>,
  bounds: &mut List<Outlives>,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, parameterId)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.LifetimeParameter {bounds: written, ..} = value.header {
      return run writtenOutlives(
        &mut resolver.*,
        module,
        written,
        at,
        scope,
        renumber,
        &mut bounds.*,
      )
    }
  }
  return Option<Shared<Rejection>>.none()
}

// The written position of the one `for<use 'call>` binder, or `usize.MAX` when none is marked.
// The marked binder names the invocation extent itself, so it takes no authored bounds (LIFE-004).
effect fn markedBinder(
  resolver: &mut Resolver,
  module: &ModuleId,
  quantified: Range,
) -> Result<usize, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut marked = usize.MAX
  let mut at = usize.ZERO
  while at < quantified.length {
    let child = run typeChild(&mut resolver.*, module, quantified, at)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        if let Node.LifetimeParameter {bounds, invocationUse, ..} = value.header {
          if invocationUse {
            if marked != usize.MAX || bounds.length != usize.ZERO {
              return Result<usize, Shared<Rejection>>.failResult(
                run reject(&resolver.*, module, RejectionCode.InvalidLifetime, value.span),
              )
            }
            marked = at
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Result<usize, Shared<Rejection>>.succeed(marked)
}

// Records the `'longer: 'shorter` bounds written on `for<...>` binders.
effect fn invocationBounds(
  resolver: &mut Resolver,
  module: &ModuleId,
  quantified: Range,
  scope: &[Binder],
  renumber: &List<usize>,
) -> Result<List<Outlives>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut bounds = List<Outlives>.make()
  let mut at = usize.ZERO
  while at < quantified.length {
    let child = run typeChild(&mut resolver.*, module, quantified, at)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let refusal = run parameterOutlives(
        &mut resolver.*,
        module,
        parameterId,
        at,
        scope,
        renumber,
        &mut bounds,
      )
      if let Option<Shared<Rejection>>.Some {value: refused} = move refusal {
        return Result<List<Outlives>, Shared<Rejection>>.failResult(move refused)
      }
    }
    at = at + usize.ONE
  }
  return Result<List<Outlives>, Shared<Rejection>>.succeed(move bounds)
}

// Resolves `for<'call> once fn<'env>(A) -> B`. Omitted parameter lifetimes are fresh invocation
// binders and an omitted result lifetime uses the sole borrowed parameter; quantified contracts
// do not nest.
struct CallableParts {
  inputs: List<Shared<Type>>,
  output: Shared<Type>,
  outlives: List<Outlives>,
  allocated: usize,
}

// Resolves a callable contract's binder bounds, parameters and result under one numbering of its
// invocation binders.
effect fn callableParts(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: Node,
  binders: &[Binder],
  nested: bool,
  renumber: &List<usize>,
) -> Result<CallableParts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut quantified = Range.empty()
  let mut parameters = Range.empty()
  let mut result = HirId {index: usize.ZERO}
  match &syntax {
    Node.CallableType {binders: written, parameters: inputs, result: output, ..} => {
      quantified = written parameters = inputs result = output
    }
    Node.ForeignFunctionType {binders: written, parameters: inputs, result: output, ..} => {
      quantified = written parameters = inputs result = output
    }
    _ => {}
  }
  let scoped = run quantifiedScope(&mut resolver.*, module, quantified, binders, renumber)
  let scope = match move scoped {
    Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result<CallableParts, Shared<Rejection>>.failResult(move error)
    }
  }
  let declaredBounds = run invocationBounds(
    &mut resolver.*,
    module,
    quantified,
    List<Binder>.asSlice(&scope),
    renumber,
  )
  let outlives = match move declaredBounds {
    Result<List<Outlives>, Shared<Rejection>>.Success {value: found} => move found
    Result<List<Outlives>, Shared<Rejection>>.Failure {error} => {
      return Result<CallableParts, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut copied = List<usize>.make()
  let slots = List<usize>.asSlice(renumber)
  let mut slot = usize.ZERO
  while slot < slots.length {
    run List<usize>.append(&mut copied, slots[slot])
    slot = slot + usize.ONE
  }
  let mut invocation = LifetimeElision {
    owner: Option<DeclarationId>.none(),
    nextOrdinal: quantified.length,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: true,
    nested: nested,
    renumber: move copied,
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let mut inputs = List<Shared<Type>>.make()
  let mut borrowed = usize.ZERO
  let mut candidate = Option<Shared<Lifetime>>.none()
  let mut at = usize.ZERO
  while at < parameters.length {
    let child = run typeChild(&mut resolver.*, module, parameters, at)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        parameterId,
        List<Binder>.asSlice(&scope),
        &mut invocation,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let outer = Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, outerLifetime)
          if let Option<Shared<Lifetime>>.Some {value: lifetime} = move outer {
            borrowed = borrowed + usize.ONE
            candidate = Option<Shared<Lifetime>>.some(move lifetime)
          }
          run List<Shared<Type>>.append(&mut inputs, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<CallableParts, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  invocation.output = true
  if borrowed == usize.ONE {
    invocation.resultDefault = move candidate
  }
  let output = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    result,
    List<Binder>.asSlice(&scope),
    &mut invocation,
  )
  return match move output {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => Result<
      CallableParts,
      Shared<Rejection>,
    >.succeed(
      CallableParts {
        inputs: move inputs,
        output: move ty,
        outlives: move outlives,
        allocated: invocation.nextOrdinal,
      },
    )
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result<
      CallableParts,
      Shared<Rejection>,
    >.failResult(move error)
  }
}

fn renumbered(renumber: &List<usize>, ordinal: usize) -> usize {
  let slots = List<usize>.asSlice(renumber)
  if ordinal < slots.length {
    return slots[ordinal]
  }
  return ordinal
}

// A vector in a C signature crosses the boundary in one vector register, as the target's C
// compilers pass it, so the profile must select that register's CPU feature (SEM0244, SIMD-010).
// A mask or pointer-sized lane has no C vector type at all (SEM0187).
effect fn foreignVectorRejection(resolver: &Resolver, module: &ModuleId, ty: &Shared<Type>, span: Span)
-> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let vector = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool { return match &value.* { Type.Vector {..} => true _ => false } })
  if vector && Shared<Type>.with<usize>(ty, CAbi.vectorLaneBits) == usize.ZERO {
    let mut refused = run makeRejection(RejectionCode.ForeignType, module, span)
    if let Option<Bytes>.Some {value: text} = move run TypeText.display(ty, module) {
      run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move text})
      run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"abi"), value: run Bytes.copy(b"C")})
    }
    return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move refused))
  }
  let bits = Shared<Type>.with<usize>(ty, CAbi.vectorBits)
  if bits == usize.ZERO { return Option<Shared<Rejection>>.none() }
  let mut requirement = Bytes.make()
  match move CAbi.vectorFeature(&resolver.target, bits) {
    Option<&'static [u8]>.Some {value: feature} => {
      if profileFeature(resolver, feature) { return Option<Shared<Rejection>>.none() }
      requirement = run Bytes.copy(b"which needs the CPU feature `")
      run Bytes.append(&mut requirement, feature)
      run Bytes.append(&mut requirement, b"`; select it in the profile's `cpu`")
    }
    Option<&'static [u8]>.None => {
      requirement = run Bytes.copy(b"but ")
      run Bytes.append(&mut requirement, resolver.target.name())
      run Bytes.append(&mut requirement, b" C passes no vector of that width")
    }
  }
  let mut diagnostic = run makeRejection(RejectionCode.ForeignVectorUnavailable, module, span)
  if let Option<Bytes>.Some {value: text} = move run TypeText.display(ty, module) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move text})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"requirement"), value: move requirement})
  }
  return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
}

effect fn resolveForeignFunction(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, moduleOrdinal: usize, module: &ModuleId, syntax: Node,
  span: Span, binders: &[Binder]) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let observed = run source(&mut resolver.*, module)
  let mut behavior = Option<ForeignContract>.none()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &observed, module) {
    let hir = IndexedSource.authored(indexed)
    if let Node.ForeignFunctionType {abi, binders: written, properties, ..} = &syntax {
      let c = match Module.node(hir, abi) { Node.TextLiteral {value: text} => same(Module.text(hir, text), b"C") _ => false }
      if !c {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.UnsupportedForeignAbi, span))
      }
      if written.length != usize.ZERO {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.ForeignDeclarationRestriction, span))
      }
      behavior = NativeForeign.contract(hir, properties)
    }
  }
  let contract = match move behavior {
    Option<ForeignContract>.Some {value: retained} => retained
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.ForeignDeclarationRestriction, span)) }
  }
  let renumber = List<usize>.make()
  let parts = match move run callableParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    module, syntax, binders, false, &renumber) {
    Result<CallableParts, Shared<Rejection>>.Success {value} => move value
    Result<CallableParts, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let regions = List<Shared<Lifetime>>.make()
  let signature = run Types.intern(Type.Callable {mode: CallableMode.Shared, isUnsafe: true,
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: List<Outlives>.make(),
    parameters: move parts.inputs, result: move parts.output})
  let ty = run Types.intern(Type.ForeignFunction {signature: move signature, behavior: contract})
  if !(run foreignAdmitted(&mut resolver.*, &ty)) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.ForeignType, span))
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(move ty)
}

effect fn resolveCallable(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: Node,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Node.CallableType {mode, isUnsafe, binders: quantified, environment, ..} = syntax {
    if elision.invocation && quantified.length > usize.ZERO {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.NestedQuantifier, span),
      )
    }
    let marked = match move run markedBinder(&mut resolver.*, module, quantified) {
      Result<usize, Shared<Rejection>>.Success {value} => value
      Result<usize, Shared<Rejection>>.Failure {error} => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
    let retained = run writtenOrElidedLifetime(
      &mut resolver.*,
      module,
      environment,
      span,
      binders,
      &mut elision.*,
    )
    let mut regions = List<Shared<Lifetime>>.make()
    match move retained {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => {
        run List<Shared<Lifetime>>.append(&mut regions, move found)
      }
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
    let region = run Shared<Intersection>.make(
      run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions)),
    )
    // The first pass numbers written binders by position and elided ones by allocation. Numbering
    // by first use drops unused binders; equality then compares contracts up to a renaming.
    let provisional = List<usize>.make()
    let first = run callableParts(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      syntax,
      binders,
      elision.invocation,
      &provisional,
    )
    let firstParts = match move first {
      Result<CallableParts, Shared<Rejection>>.Success {value} => move value
      Result<CallableParts, Shared<Rejection>>.Failure {error} => {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
    // A contract inside another contract's invocation context cannot quantify, so it owns no
    // binders. Its invocation lifetimes belong to the enclosing contract, which numbers them.
    if elision.invocation {
      return Result<Shared<Type>, Shared<Rejection>>.succeed(
        run Types.intern(
          Type.Callable {
            mode: mode,
            isUnsafe: isUnsafe,
            environment: move region,
            invocationBinders: usize.ZERO, invocationUse: usize.MAX,
            invocationBounds: move firstParts.outlives,
            parameters: move firstParts.inputs,
            result: move firstParts.output,
          },
        ),
      )
    }
    let mut order = List<usize>.make()
    let inputs = List<Shared<Type>>.asSlice(&firstParts.inputs)
    let mut at = usize.ZERO
    while at < inputs.length {
      run Type.collectInvocations(&inputs[at], &mut order)
      at = at + usize.ONE
    }
    run Type.collectInvocations(&firstParts.output, &mut order)
    let bounds = List<Outlives>.asSlice(&firstParts.outlives)
    at = usize.ZERO
    while at < bounds.length {
      run Type.collectLifetime(&bounds[at].longer, &mut order)
      run Type.collectLifetime(&bounds[at].shorter, &mut order)
      at = at + usize.ONE
    }
    let used = List<usize>.asSlice(&order)
    let mut canonical = used.length == firstParts.allocated
    at = usize.ZERO
    while canonical && at < used.length {
      canonical = used[at] == at
      at = at + usize.ONE
    }
    let mut parts = move firstParts
    // An unused marked binder constrains nothing, so canonical numbering drops it with the rest.
    let mut invocationUse = marked
    if !canonical {
      let mut renumber = List<usize>.make()
      at = usize.ZERO
      while at < parts.allocated {
        run List<usize>.append(&mut renumber, usize.MAX)
        at = at + usize.ONE
      }
      let slots = List<usize>.asMutSlice(&mut renumber)
      at = usize.ZERO
      while at < used.length {
        slots[used[at]] = at
        at = at + usize.ONE
      }
      if marked != usize.MAX { invocationUse = slots[marked] }
      let second = run callableParts(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        syntax,
        binders,
        elision.invocation,
        &renumber,
      )
      parts = match move second {
        Result<CallableParts, Shared<Rejection>>.Success {value} => move value
        Result<CallableParts, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    return Result<Shared<Type>, Shared<Rejection>>.succeed(
      run Types.intern(
        Type.Callable {
          mode: mode,
          isUnsafe: isUnsafe,
          environment: move region,
          invocationBinders: List<usize>.length(&order),
          invocationUse: invocationUse,
          invocationBounds: move parts.outlives,
          parameters: move parts.inputs,
          result: move parts.output,
        },
      ),
    )
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

// The argument contributed by one declaration-owned binder, excluding derived Self.
effect fn ownedArgument(producer: &DeclarationId, binder: &Binder) -> Option<Argument>
! OutOfMemoryError
? &mut Allocator {
  let mut argument = Option<Argument>.none()
  match & binder.* {
    Binder.Type {value, ..} => {
      let ordinal = Shared<Type>.with<usize>(
        &value,
        fn(ty: &Type) -> usize {
          return Type.parameterOrdinalOf(ty, producer)
        },
      )
      if ordinal != usize.MAX {
        argument = Option<Argument>.some(Argument.Type {value: Shared<Type>.clone(&value)})
      }
    }
    Binder.Lifetime {value, ..} => {
      let owned = Shared<Lifetime>.with<bool>(
        &value,
        fn(region: &Lifetime) -> bool {
          return match & region.* {
            Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, producer)
            _ => false
          }
        },
      )
      if owned {
        argument = Option<Argument>.some(Argument.Lifetime {value: Shared<Lifetime>.clone(&value)})
      }
    }
    Binder.Row {value, ..} => {
      let owned = Shared<DeclarationId>.with<bool>(
        &value.declaration,
        fn(declaration: &DeclarationId) -> bool {
          return DeclarationId.equals(declaration, producer)
        },
      )
      if owned {
        let mut row = Row.empty()
        run Row.include(
          &mut row,
          RowParameter {
            declaration: Shared<DeclarationId>.clone(&value.declaration),
            ordinal: value.ordinal,
          },
        )
        argument = Option<Argument>.some(Argument.Row {value: run Shared<Row>.make(move row)})
      }
    }
  }
  return move argument
}

effect fn ownedArguments(
  producer: &DeclarationId,
  binders: &[Binder],
  generated: &[Shared<Lifetime>],
) -> List<Argument> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<Argument>.make()
  let mut at = usize.ZERO
  while at < binders.length {
    let owned = run ownedArgument(producer, &binders[at])
    if let Option<Argument>.Some {value: argument} = move owned {
      run List<Argument>.append(&mut arguments, move argument)
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < generated.length {
    run List<Argument>.append(
      &mut arguments,
      Argument.Lifetime {value: Shared<Lifetime>.clone(&generated[at])},
    )
    at = at + usize.ONE
  }
  return move arguments
}

effect fn binderSpelling(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Option<Bytes>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedSyntax(&mut resolver.*, module, id)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(indexed)
    if let Node.Name {text} = Module.node(hir, id) {
      return Option<Bytes>.some(run Bytes.copy(Module.text(hir, text)))
    }
  }
  return Option<Bytes>.none()
}

effect fn opaqueProducerHasBody(
  resolver: &mut Resolver,
  module: &ModuleId,
  producer: &DeclarationId,
) -> bool ! Cycle | OutOfMemoryError ? &mut Allocator {
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(producer))
  let found = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  if let Option<usize>.Some {value: ordinal} = move found {
    let answer = run source(&mut resolver.*, module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &answer,
      module,
    ) {
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      if ordinal < declarations.length {
        let hir = IndexedSource.authored(indexed)
        if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
          if let Node.CallableBody {block} = Module.node(hir, body) {
            return block.present
          }
        }
      }
    }
  }
  return false
}

// The type parameter an opaque result introduces: its spelling and its written bounds.
struct OpaqueBinder {
  name: Bytes,
  bounds: Range,
}

effect fn writtenOpaqueBinder(resolver: &mut Resolver, module: &ModuleId, parameters: Range) -> Option<
  OpaqueBinder,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let binderId = run typeChild(&mut resolver.*, module, parameters, usize.ZERO)
  let parameter = match move binderId {
    Option<HirId>.Some {value: id} => id
    Option<HirId>.None => {
      return Option<OpaqueBinder>.none()
    }
  }
  let syntax = run typeNode(&mut resolver.*, module, parameter)
  let written = match move syntax {
    Option<HeaderSyntax>.Some {value: found} => move found
    Option<HeaderSyntax>.None => {
      return Option<OpaqueBinder>.none()
    }
  }
  if let Node.TypeParameter {name, bounds} = written.header {
    let spelled = run binderSpelling(&mut resolver.*, module, name)
    if let Option<Bytes>.Some {value: binderName} = move spelled {
      return Option<OpaqueBinder>.some(OpaqueBinder {name: move binderName, bounds: bounds})
    }
  }
  return Option<OpaqueBinder>.none()
}

// What an opaque result's bounds declare: at most one executable contract and each marker once.
struct OpaqueBounds {
  contract: Option<Shared<Type>>,
  detached: bool,
  nonParking: bool,
}

// Records a marker, or returns false when it was already written.
fn claimOpaqueProperty(collected: &mut OpaqueBounds, property: IntrinsicProperty) -> bool {
  match property {
    IntrinsicProperty.Detached => {
      if collected.detached {
        return false
      }
      collected.detached = true
    }
    IntrinsicProperty.NonParking => {
      if collected.nonParking {
        return false
      }
      collected.nonParking = true
    }
  }
  return true
}

effect fn invalidOpaqueResult(resolver: &Resolver, module: &ModuleId, span: Span) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run reject(resolver, module, RejectionCode.InvalidOpaqueResult, span)
}

// Adds one written bound: an intrinsic marker, or the single executable contract.
effect fn addOpaqueBound(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  bound: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  span: Span,
  collected: &mut OpaqueBounds,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let property = run intrinsicBound(&mut resolver.*, module, bound)
  if property.named {
    let claimed = match move property.property {
      Option<IntrinsicProperty>.Some {value: foundProperty} => claimOpaqueProperty(
        &mut collected.*,
        foundProperty,
      )
      Option<IntrinsicProperty>.None => false
    }
    if !claimed {
      return Option<Shared<Rejection>>.some(run invalidOpaqueResult(&resolver.*, module, span))
    }
    return Option<Shared<Rejection>>.none()
  }
  if let Option<Shared<Type>>.Some {..} = &collected.contract {
    return Option<Shared<Rejection>>.some(run invalidOpaqueResult(&resolver.*, module, span))
  }
  // The bound is a contract of its own rather than part of the output it sits in, so an omitted
  // lifetime elides like a generic bound's: a fresh producer binder, not the result default.
  let output = elision.output
  elision.output = false
  let resolved = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    bound,
    binders,
    &mut elision.*,
  )
  elision.output = output
  let selected = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: selected} => move selected
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Option<Shared<Rejection>>.some(move error)
    }
  }
  let executable = Shared<Type>.with<bool>(
    &selected,
    fn(ty: &Type) -> bool {
      return match & ty.* {
        Type.Callable {..} => true
        Type.Effect {..} => true
        _ => false
      }
    },
  )
  if !executable {
    return Option<Shared<Rejection>>.some(run invalidOpaqueResult(&resolver.*, module, span))
  }
  collected.contract = Option<Shared<Type>>.some(move selected)
  return Option<Shared<Rejection>>.none()
}

effect fn collectOpaqueBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  bounds: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  span: Span,
) -> Result<OpaqueBounds, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut collected = OpaqueBounds {
    contract: Option<Shared<Type>>.none(),
    detached: false,
    nonParking: false,
  }
  let mut at = usize.ZERO
  while at < bounds.length {
    let bound = run typeChild(&mut resolver.*, module, bounds, at)
    if let Option<HirId>.Some {value: boundId} = move bound {
      let refusal = run addOpaqueBound(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        boundId,
        binders,
        &mut elision.*,
        span,
        &mut collected,
      )
      if let Option<Shared<Rejection>>.Some {value: refused} = move refusal {
        return Result<OpaqueBounds, Shared<Rejection>>.failResult(move refused)
      }
    }
    at = at + usize.ONE
  }
  return Result<OpaqueBounds, Shared<Rejection>>.succeed(move collected)
}

// Resolves the written result with the opaque type bound to its binder, and requires that the
// result mentions the opaque type.
effect fn completeOpaqueResult(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  producer: &DeclarationId,
  binderName: Bytes,
  contract: Shared<Type>,
  detached: bool,
  nonParking: bool,
  result: HirId,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // The result binder starts with its declaration identity. resolveSignatureUnder finishes the
  // application after result elision and hidden callable representation slots are known.
  let prototype = Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(producer)},
    arguments: List<Argument>.make(), argumentOrdinals: List<usize>.make(),
    scopes: List<ScopeBinding>.make(), statics: List<StaticSlot>.make()}
  let opaque = run Types.intern(Type.OpaqueRepresentation {
    application: run Shared<Application>.make(move prototype), contract: move contract,
    detached: detached, nonParking: nonParking})
  let mut scoped = List<Binder>.make()
  let mut at = usize.ZERO
  while at < binders.length {
    run List<Binder>.append(&mut scoped, run copyBinder(&binders[at]))
    at = at + usize.ONE
  }
  run List<Binder>.append(
    &mut scoped,
    Binder.Type {name: move binderName, value: Shared<Type>.clone(&opaque)},
  )
  let resolved = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    result,
    List<Binder>.asSlice(&scoped),
    &mut elision.*,
  )
  let complete = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: completed} => move completed
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  if run Type.containsOpaque(&complete, producer) {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(move complete)
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(
    run invalidOpaqueResult(&resolver.*, module, span),
  )
}

effect fn resolveOpaqueResult(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  parameters: Range,
  result: HirId,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if !elision.output || parameters.length != usize.ONE {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run invalidOpaqueResult(&resolver.*, module, span),
    )
  }
  let producer = match & elision.owner {
    Option<DeclarationId>.Some {value} => DeclarationId.copy(&value)
    Option<DeclarationId>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.BodylessOpaqueResult, span),
      )
    }
  }
  let callable = match DeclarationId.kind(&producer) {
    OwnerKind.Function => true
    _ => false
  }
  if !callable || !run opaqueProducerHasBody(
    &mut resolver.*,
    module,
    &producer,
  ) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.BodylessOpaqueResult, span),
    )
  }
  let declared = run writtenOpaqueBinder(&mut resolver.*, module, parameters)
  let binder = match move declared {
    Option<OpaqueBinder>.Some {value: found} => move found
    Option<OpaqueBinder>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
      )
    }
  }
  if hasBinder(binders, Bytes.asSlice(&binder.name)) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
    )
  }
  let bounded = run collectOpaqueBounds(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    binder.bounds,
    binders,
    &mut elision.*,
    span,
  )
  let collected = match move bounded {
    Result<OpaqueBounds, Shared<Rejection>>.Success {value: gathered} => move gathered
    Result<OpaqueBounds, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  let detached = collected.detached
  let nonParking = collected.nonParking
  let useContract = match move collected.contract {
    Option<Shared<Type>>.Some {value: selected} => move selected
    Option<Shared<Type>>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
      )
    }
  }
  return run completeOpaqueResult(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    &producer,
    move binder.name,
    move useContract,
    detached,
    nonParking,
    result,
    span,
    binders,
    &mut elision.*,
  )
}

// Resolves `Intrinsic.Type<Owner>`: exactly one ordinary type argument and no row clauses.
// The sealed `Intrinsic` families written with exactly one type argument.
enum DescriptorFamily {
  /// `Intrinsic.Type<Owner>`.
  Type,
  /// `Intrinsic.StaticSequence<T>`.
  StaticSequence,
  /// `Intrinsic.Test<F>`.
  Test,
}

effect fn resolveTypeDescriptor(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  span: Span,
  /// The written type without its arguments, where a wrong argument count is reported (SEM0051).
  nameSpan: Span,
  application: Option<HirId>,
  family: DescriptorFamily,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let arguments = match move application {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, nameSpan, usize.ONE, usize.ZERO))
    }
  }
  let written = run typeNode(&mut resolver.*, module, arguments)
  if let Option<HeaderSyntax>.Some {value: found} = move written {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != usize.ONE {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, nameSpan, usize.ONE, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let child = run typeChild(&mut resolver.*, module, supplied, usize.ZERO)
      let argument = match move child {
        Option<HirId>.Some {value} => value
        Option<HirId>.None => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
        }
      }
      let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, binders, &mut elision.*)
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: described} => {
          if family == DescriptorFamily.StaticSequence { return Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.staticSequenceType(&described)) }
          if family == DescriptorFamily.Test { return Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.testType(&described)) }
          return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.TypeDescriptor {owner: move described}))
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

effect fn resolveFieldDescriptor(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  span: Span,
  /// The written type without its arguments, where a wrong argument count is reported (SEM0051).
  nameSpan: Span,
  application: Option<HirId>,
  /// `Field`, `Fields`, `Variant` or `Variants`.
  family: &[u8],
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let field = same(family, b"Field")
  let mut arity = usize.ONE
  if field {arity = 2}
  let arguments = match move application {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, nameSpan, arity, usize.ZERO))
    }
  }
  let written = run typeNode(&mut resolver.*, module, arguments)
  if let Option<HeaderSyntax>.Some {value: found} = move written {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != arity {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, nameSpan, arity, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let child = run typeChild(&mut resolver.*, module, supplied, usize.ZERO)
      let argument = match move child {
        Option<HirId>.Some {value} => value
        Option<HirId>.None => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
        }
      }
      let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, binders, &mut elision.*)
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: described} => {
          if same(family, b"Variant") {return Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.variantType(&described))}
          if same(family, b"Variants") {return Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.variantsType(&described))}
          if !field {return Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.fieldsType(&described))}
          let memberId = match move run typeChild(&mut resolver.*, module, supplied, usize.ONE) {
            Option<HirId>.Some {value} => value
            Option<HirId>.None => {return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))}
          }
          let member = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, memberId, binders, &mut elision.*)
          return match move member {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: exact} => Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.fieldType(&described, &exact))
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
          }
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

effect fn resolveType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  return run resolveTypeAt(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, id, binders, &mut elision.*, false)
}

// Resolves a written type. A call's applied owner, as in `Pair<i32>.make(…)`, reports a wrong
// argument count at its whole application (`callOwner`); every other type reports it at its name
// (SEM0051).
effect fn resolveTypeAt(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  callOwner: bool,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let syntax = run typeNode(&mut resolver.*, &module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    let mut selected = value.header
    let mut application = Option<HirId>.none()
    // The written type without its arguments, where a wrong argument count is reported (SEM0051).
    let mut targetSpan = value.span
    if let Node.AppliedType {target, arguments} = selected {
      let writtenTarget = run typeNode(&mut resolver.*, &module, target)
      if let Option<HeaderSyntax>.Some {value: named} = move writtenTarget {
        selected = named.header
        application = Option<HirId>.some(arguments)
        targetSpan = named.span
      }
    }
    if callOwner { targetSpan = value.span }
    let unitType = match &selected { Node.UnitType => true _ => false }
    if unitType {
      if let Option<HirId>.Some {value: arguments} = move application {
        let written = run typeNode(&mut resolver.*, &module, arguments)
        if let Option<HeaderSyntax>.Some {value: found} = move written {
          if let Node.TypeArguments {arguments: supplied, ..} = found.header {
            return Result<Shared<Type>, Shared<Rejection>>.failResult(
              run rejectArity(&resolver.*, &module, targetSpan, usize.ZERO, supplied.length),
            )
          }
        }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Types.intern(Type.Unit))
    }
    if let Node.ExactRepresentationType {subject} = selected {
      return run resolveNamedRepresentation(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        subject,
        value.span,
        binders,
        &elision.assumptions,
      )
    }
    if let Node.OpaqueResultType {binders: opaqueBinders, result} = selected {
      return run resolveOpaqueResult(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        opaqueBinders,
        result,
        value.span,
        binders,
        &mut elision.*,
      )
    }
    if let Node.NamedType {path: typeName, hasMode, mode} = selected {
      let parsed = run path(&mut resolver.*, &module, typeName)
      if !parsed.valid {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      let segments = List<Bytes>.asSlice(&parsed.segments)
      // The builtin `Effect<A ! E ? R>` needs no import; only a binder can shadow its spelling.
      if segments.length == usize.ONE && same(Bytes.asSlice(&segments[usize.ZERO]), b"Effect") && !hasBinder(
        binders,
        b"Effect",
      ) {
        let mut access = CallableMode.Shared
        if hasMode {
          access = mode
        }
        return run resolveEffect(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          value.span,
          targetSpan,
          move application,
          access,
          binders,
          &mut elision.*,
        )
      }
      if hasMode {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run modeBeforeTypeName(&module, value.span, segments, mode))
      }
      // The sealed `Intrinsic.Type<Owner>` descriptor is the only implemented intrinsic type family.
      if segments.length == 2 && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") && same(Bytes.asSlice(&segments[usize.ONE]), b"Type") {
        return run resolveTypeDescriptor(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module, value.span, targetSpan,
          move application, DescriptorFamily.Type, binders, &mut elision.*,
        )
      }
      if segments.length == 2 && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") && same(Bytes.asSlice(&segments[usize.ONE]), b"StaticSequence") {
        return run resolveTypeDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module, value.span, targetSpan,
          move application, DescriptorFamily.StaticSequence, binders, &mut elision.*)
      }
      if segments.length == 2 && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") && same(Bytes.asSlice(&segments[usize.ONE]), b"Test") {
        return run resolveTypeDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module, value.span, targetSpan,
          move application, DescriptorFamily.Test, binders, &mut elision.*)
      }
      // `Intrinsic.Tests` and `Intrinsic.TestInfo` take no arguments (TEST-004).
      if segments.length == 2 && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") &&
        (same(Bytes.asSlice(&segments[usize.ONE]), b"Tests") || same(Bytes.asSlice(&segments[usize.ONE]), b"TestInfo")) {
        if let Option<HirId>.Some {..} = &application {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, &module, RejectionCode.TypeArity, targetSpan))
        }
        if same(Bytes.asSlice(&segments[usize.ONE]), b"Tests") { return Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.testsType()) }
        return Result<Shared<Type>, Shared<Rejection>>.succeed(run CheckedIntrinsic.testInfoType())
      }
      if segments.length == 2 && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") &&
        (same(Bytes.asSlice(&segments[usize.ONE]), b"Field") || same(Bytes.asSlice(&segments[usize.ONE]), b"Fields") ||
          same(Bytes.asSlice(&segments[usize.ONE]), b"Variant") || same(Bytes.asSlice(&segments[usize.ONE]), b"Variants")) {
        return run resolveFieldDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module, value.span, targetSpan,
          move application, Bytes.asSlice(&segments[usize.ONE]), binders, &mut elision.*)
      }
      if segments.length == usize.ONE {
        let name = Bytes.asSlice(&segments[usize.ZERO])
        let known = binders
        let mut at = usize.ZERO
        while at < known.length {
          if let Binder.Row {name: bound, ..} = &known[at] {
            if same(Bytes.asSlice(&bound), name) {
              return Result<Shared<Type>, Shared<Rejection>>.failResult(
                run kindRejection(
                  &resolver.*,
                  &module,
                  parsed.span,
                  name,
                  GenericKind.Type,
                  GenericKind.Requirement,
                  true,
                ),
              )
            }
          }
          if let Binder.Type {name: bound, value: ty} = &known[at] {
            if same(Bytes.asSlice(&bound), name) {
              if let Option<HirId>.Some {value: arguments} = move application {
                let written = run typeNode(&mut resolver.*, &module, arguments)
                if let Option<HeaderSyntax>.Some {value: found} = move written {
                  if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                    return Result<Shared<Type>, Shared<Rejection>>.failResult(
                      run rejectArity(&resolver.*, &module, targetSpan, usize.ZERO, supplied.length),
                    )
                  }
                }
              }
              return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(&ty))
            }
          }
          at = at + usize.ONE
        }
        if same(name, b"string") {
          let mut writtenLifetime = HirRef.absent()
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
                if environment.present || failures.present || requirements.present || supplied.length != usize.ONE {
                  return Result<Shared<Type>, Shared<Rejection>>.failResult(
                    run rejectArity(&resolver.*, &module, targetSpan, usize.ONE, supplied.length),
                  )
                }
                let child = run typeChild(&mut resolver.*, &module, supplied, usize.ZERO)
                if let Option<HirId>.Some {value: lifetimeId} = move child {
                  writtenLifetime = HirRef.of(lifetimeId)
                }
              }
            }
          }
          let lifetime = run writtenOrElidedLifetime(
            &mut resolver.*,
            &module,
            writtenLifetime,
            value.span,
            binders,
            &mut elision.*,
          )
          match move lifetime {
            Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: valid} => {
              return Result<Shared<Type>, Shared<Rejection>>.succeed(
                run Types.intern(Type.String {lifetime: move valid}),
              )
            }
            Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
              return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
            }
          }
        }
        if primitive(name) {
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                return Result<Shared<Type>, Shared<Rejection>>.failResult(
                  run rejectArity(&resolver.*, &module, targetSpan, usize.ZERO, supplied.length),
                )
              }
            }
          }
          return Result<Shared<Type>, Shared<Rejection>>.succeed(
            run Types.intern(Type.Primitive {name: run Bytes.copy(name)}),
          )
        }
        if same(name, b"never") {
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                return Result<Shared<Type>, Shared<Rejection>>.failResult(
                  run rejectArity(&resolver.*, &module, targetSpan, usize.ZERO, supplied.length),
                )
              }
            }
          }
          return Result<Shared<Type>, Shared<Rejection>>.succeed(
            run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
          )
        }
        return run namedType(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          name,
          false,
          parsed.span,
          targetSpan,
          move application,
          binders,
          &mut elision.*,
        )
      }
      if segments.length == 2 {
        return run qualifiedType(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          segments,
          parsed.span,
          targetSpan,
          move application,
          binders,
          &mut elision.*,
        )
      }
    }
    if let Node.ReferenceType {referent, access, lifetime, roleName} = selected {
      if roleName.present {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      let valid = run writtenOrElidedLifetime(
        &mut resolver.*,
        &module,
        lifetime,
        value.span,
        binders,
        &mut elision.*,
      )
      let region = match move valid {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        referent,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result<Shared<Type>, Shared<Rejection>>.succeed(
            run Types.intern(
              Type.Reference {referent: move ty, access: access, lifetime: move region},
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    if let Node.SliceType {element, access, lifetime} = selected {
      let valid = run writtenOrElidedLifetime(
        &mut resolver.*,
        &module,
        lifetime,
        value.span,
        binders,
        &mut elision.*,
      )
      let region = match move valid {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        element,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result<Shared<Type>, Shared<Rejection>>.succeed(
            run Types.intern(
              Type.Slice {element: move ty, access: access, lifetime: move region},
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    if let Node.PointerType {pointee, access, nullable, multiplicity, qualifiers} = selected {
      let validated = run pointerAlignment(&mut resolver.*, &module, qualifiers)
      let alignment = match move validated {
        Result<Option<u64>, Shared<Rejection>>.Success {value: found} => move found
        Result<Option<u64>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        pointee,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result<Shared<Type>, Shared<Rejection>>.succeed(
            run Types.intern(
              Type.Pointer {
                pointee: move ty,
                access: access,
                nullable: nullable,
                multiplicity: multiplicity,
                alignment: move alignment,
              },
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    if let Node.FixedArrayType {element, length} = selected {
      let lengthSyntax = run typeNode(&mut resolver.*, &module, length)
      if let Option<HeaderSyntax>.Some {value: writtenLength} = move lengthSyntax {
        let mut anchor = writtenLength.span
        if anchor.end <= anchor.start {
          anchor = value.span
        }
        let evaluated = run staticExpression(
          &mut resolver.*, &mut owner.*, &mut dependencies.*,
          &module, Option<usize>.none(), length, StaticRootExpectation.IntegerExtent,
          &[], &[],
        )
        let staticValue = match move evaluated {
          Result<Shared<StaticData>, Shared<Rejection>>.Success {value: evaluatedLength} => move evaluatedLength
          Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
            return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
          }
        }
        // A fixed-array length is at most the i32 maximum on every target (SEM0002).
        if StaticConstant.arrayLengthExceeds(&staticValue) {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(
            run reject(&resolver.*, &module, RejectionCode.IntegerOutOfRange, anchor),
          )
        }
        let selectedExtent = run StaticConstant.extent(&staticValue, resolver.target.pointerBits())
        if let Option<Bytes>.Some {value: extent} = move selectedExtent {
          let resolved = run resolveType(
            &mut resolver.*, &mut owner.*, &mut dependencies.*,
            moduleOrdinal, element, binders, &mut elision.*,
          )
          return match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => Result<
              Shared<Type>,
              Shared<Rejection>,
            >.succeed(run Types.intern(Type.Array {element: move ty, extent: move extent}))
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result<
              Shared<Type>,
              Shared<Rejection>,
            >.failResult(move error)
          }
        }
        return Result<Shared<Type>, Shared<Rejection>>.failResult(
          run constantRejection(&module, anchor, b"an array length must be a non-negative integer known at compile time"),
        )
      }
    }
    if let Node.VectorType {element, lanes} = selected {
      return run resolveVector(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module,
        Option<HirId>.some(element), lanes, value.span, binders, &mut elision.*)
    }
    if let Node.MaskType {lanes} = selected {
      return run resolveVector(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module,
        Option<HirId>.none(), lanes, value.span, binders, &mut elision.*)
    }
    if let Node.UnionType {members} = selected {
      return run resolveUnion(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        members,
        binders,
        &mut elision.*,
      )
    }
    // `Without<source, removed>` in a type position subtracts failure members (FAIL-005).
    if let Node.RowWithout {source, removed} = selected {
      let from = match move run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, source, binders,
        &mut elision.*) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: resolved} => move resolved
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      let keys = match move run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, removed, binders,
        &mut elision.*) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: resolved} => move resolved
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Shared<Type>, Shared<Rejection>>.succeed(run Type.without(&from, &keys))
    }
    if let Node.ForeignFunctionType {..} = selected {
      return run resolveForeignFunction(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
        &module, selected, value.span, binders)
    }
    if let Node.CallableType {..} = selected {
      return run resolveCallable(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        selected,
        value.span,
        binders,
        &mut elision.*,
      )
    }
    if let Node.Lifetime {..} = selected {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, &module, RejectionCode.InvalidLifetime, value.span),
      )
    }
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
    )
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
  )
}

effect fn resolveAlias(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess15 = declarationPosition(&resolver.*, key)
  let written = run scopedHeader(&mut resolver.*, &module, declarationAccess15)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.AliasHeader {target, isPublic, generics, ..} = value.header {
      // TYPE-004: a generic alias resolves its target once over its own parameters; each use
      // instantiates that type with its written arguments.
      if generics.length > usize.ZERO {
        return run resolveGenericAlias(&mut resolver.*, &mut owner.*, move dependencies, key, &module,
          generics, target, isPublic)
      }
      let property = run sealedPropertyName(&mut resolver.*, &module, target)
      if let Option<SealedProperty>.Some {value: sealed} = move property {
        return Answer {
          outcome: Outcome.Success {value: Value.Property {property: sealed}},
          dependencies: move dependencies,
        }
      }
      let forwarded = run unappliedAliasTarget(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, target)
      if let Option<SelectedDeclaration>.Some {value: selected} = move forwarded {
        let targetModule = resolvedModule(&resolver.*, selected.module)
        if isPublic {
          let mut exposed = false
          if let Option<HeaderSyntax>.Some {value: named} = move run scopedHeader(&mut resolver.*, &targetModule, selected.ordinal) {
            exposed = !genericOwnerPublic(named.header)
          }
          if exposed {
            let mut span = value.span
            if let Option<HeaderSyntax>.Some {value: targetSyntax} = move run typeNode(&mut resolver.*, &module, target) {
              span = targetSyntax.span
            }
            return Answer {
              outcome: run rejectedOutcome(run reject(&resolver.*, &module, RejectionCode.PrivateTypeExposure, span)),
              dependencies: move dependencies,
            }
          }
        }
        let identity = run declarationAt(&mut resolver.*, &targetModule, selected.ordinal)
        if let Option<DeclarationId>.Some {value: declaration} = move identity {
          let selectedRequest3 = Key {family: Family.Identity, module: selected.module, name: usize.ZERO,
            declaration: selected.ordinal, member: usize.ZERO, external: false}
          let selectedKey3 = run internDeclaration(&mut resolver.*, selectedRequest3)
          return Answer {
            outcome: Outcome.Success {
              value: Value.Selected {declaration: move declaration, module: selected.module, handle: selectedKey3.declaration},
            },
            dependencies: move dependencies,
          }
        }
      }
      let declarationAccess16 = declarationPosition(&resolver.*, key)
      let mut elision = LifetimeElision {
        owner: run declarationAt(&mut resolver.*, &module, declarationAccess16),
        nextOrdinal: usize.ZERO,
        output: false,
        resultDefault: Option<Shared<Lifetime>>.none(),
        generated: List<Shared<Lifetime>>.make(),
        invocation: false,
        nested: false,
        renumber: List<usize>.make(),
        staticEnvironment: false,
        supplied: Option<List<Argument>>.none(),
        assumptions: Option<List<Constraint>>.some(List<Constraint>.make()),
        deferred: Option<List<DeferredBounds>>.none(),
      }
      let noBinders = List<Binder>.make()
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        target,
        List<Binder>.asSlice(&noBinders),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let exposure = run exposedPrivate(&mut resolver.*, &module, target, &ty, isPublic)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
            return Answer {
              outcome: run rejectedOutcome(move diagnostic),
              dependencies: move dependencies,
            }
          }
          return Answer {
            outcome: Outcome.Success {value: Value.Type {resolved: move ty}},
            dependencies: move dependencies,
          }
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: run rejectedOutcome(move error),
            dependencies: move dependencies,
          }
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: run rejectedOutcome(move diagnostic),
      dependencies: move dependencies,
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: run rejectedOutcome(move diagnostic),
    dependencies: move dependencies,
  }
}

// The span of the first generic alias parameter TYPE-004 refuses: one that is not an unbounded
// type or lifetime parameter.
effect fn refusedAliasParameter(resolver: &mut Resolver, module: &ModuleId, generics: Range) -> Option<Span>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < generics.length {
    if let Option<HirId>.Some {value: parameterId} = move run typeChild(&mut resolver.*, module, generics, at) {
      if let Option<HeaderSyntax>.Some {value: parameter} = move run typeNode(&mut resolver.*, module, parameterId) {
        let accepted = match parameter.header {
          Node.TypeParameter {bounds, ..} => bounds.length == usize.ZERO
          Node.LifetimeParameter {bounds, ..} => bounds.length == usize.ZERO
          _ => false
        }
        if !accepted { return Option<Span>.some(parameter.span) }
      }
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

// The span of generic alias parameter `at`, or `fallback` when its syntax is unavailable.
effect fn aliasParameterSpan(resolver: &mut Resolver, module: &ModuleId, generics: Range, at: usize, fallback: Span) -> Span
! Cycle | OutOfMemoryError ? &mut Allocator {
  if let Option<HirId>.Some {value: parameterId} = move run typeChild(&mut resolver.*, module, generics, at) {
    if let Option<HeaderSyntax>.Some {value: parameter} = move run typeNode(&mut resolver.*, module, parameterId) {
      return parameter.span
    }
  }
  return fallback
}

effect fn resolveGenericAlias(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: List<Dependency>,
  key: Key,
  module: &ModuleId,
  generics: Range,
  target: HirId,
  isPublic: bool,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = move dependencies
  if let Option<Span>.Some {value: span} = move run refusedAliasParameter(&mut resolver.*, module, generics) {
    return Answer {
      outcome: run rejectedOutcome(run reject(&resolver.*, module, RejectionCode.AliasParameters, span)),
      dependencies: move dependencies,
    }
  }
  let declarationAccess17 = declarationPosition(&resolver.*, key)
  let binders = match move run templateBinders(&mut resolver.*, module, declarationAccess17) {
    Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Answer {outcome: run rejectedOutcome(move error), dependencies: move dependencies}
    }
  }
  let declarationAccess18 = declarationPosition(&resolver.*, key)
  let identity = run declarationAt(&mut resolver.*, module, declarationAccess18)
  let declarationAccess19 = declarationPosition(&resolver.*, key)
  let mut elision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, module, declarationAccess19),
    nextOrdinal: List<Binder>.length(&binders),
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.some(List<Constraint>.make()),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, target,
    List<Binder>.asSlice(&binders), &mut elision)
  let ty = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: found} => move found
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Answer {outcome: run rejectedOutcome(move error), dependencies: move dependencies}
    }
  }
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run exposedPrivate(&mut resolver.*, module, target, &ty, isPublic) {
    return Answer {outcome: run rejectedOutcome(move diagnostic), dependencies: move dependencies}
  }
  // Every parameter occurs in the target: an unused one would name distinct spellings of one type.
  if let Option<DeclarationId>.Some {value: aliasId} = &identity {
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    run Type.collectOwned(&ty, &aliasId, &mut types, &mut lifetimes, &mut rows)
    let mut at = usize.ZERO
    while at < List<Binder>.length(&binders) {
      if !containsOrdinal(&types, at) && !containsOrdinal(&lifetimes, at) {
        let span = run aliasParameterSpan(&mut resolver.*, module, generics, at, Span.make(usize.ZERO, usize.ZERO))
        return Answer {
          outcome: run rejectedOutcome(run reject(&resolver.*, module, RejectionCode.AliasParameters, span)),
          dependencies: move dependencies,
        }
      }
      at = at + usize.ONE
    }
  }
  return Answer {outcome: Outcome.Success {value: Value.Type {resolved: move ty}}, dependencies: move dependencies}
}

// The generic declaration an alias names without arguments (`type Pointed = Point`), so each use
// applies the target to its own arguments. An alias of such an alias names the same declaration.
// A target written with arguments, or one that names no generic declaration, resolves as a type.
effect fn unappliedAliasTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  target: HirId,
) -> Option<SelectedDeclaration>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let syntax = run typeNode(&mut resolver.*, &module, target)
  let mut typeName = HirRef.absent()
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      if !hasMode {
        typeName = HirRef.of(written)
      }
    }
  }
  if !typeName.present {
    return Option<SelectedDeclaration>.none()
  }
  let parsed = run path(&mut resolver.*, &module, typeName.id)
  let segments = List<Bytes>.asSlice(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 {
    return Option<SelectedDeclaration>.none()
  }
  let mut selection = Result<SelectedDeclaration, Shared<Rejection>>.failResult(
    run reject(&resolver.*, &module, RejectionCode.NotType, parsed.span),
  )
  if segments.length == usize.ONE {
    selection = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, &module,
      Bytes.asSlice(&segments[usize.ZERO]), false, parsed.span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  } else {
    selection = run qualifiedTypeDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
      &module, segments, parsed.span)
  }
  let selected = match move selection {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {..} => {
      return Option<SelectedDeclaration>.none()
    }
  }
  let targetModule = resolvedModule(&resolver.*, selected.module)
  let written = run scopedHeader(&mut resolver.*, &targetModule, selected.ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.AliasHeader {..} = value.header {
      let declarationAccess20Request = Key {
        family: Family.Alias,
        module: selected.module,
        name: usize.ZERO,
        declaration: selected.ordinal,
        member: usize.ZERO,
        external: false,
      }
      let declarationAccess20 = run internDeclaration(&mut resolver.*, declarationAccess20Request)
      let key = declarationAccess20
      let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, parsed.span)
      return Shared<Result<Answer, NoRejection>>.with<Option<SelectedDeclaration>>(&answer, fn(answer: &Result<Answer, NoRejection>) -> Option<SelectedDeclaration> { return forwardedDeclaration(&resolver.*, answer) })
    }
    if headerGenerics(value.header).length > usize.ZERO {
      return Option<SelectedDeclaration>.some(move selected)
    }
  }
  return Option<SelectedDeclaration>.none()
}

fn genericOwnerPublic(header: Node) -> bool {
  return match header {
    Node.StructHeader {isPublic, ..} => isPublic
    Node.TupleHeader {isPublic, ..} => isPublic
    Node.UnionHeader {isPublic, ..} => isPublic
    Node.ServiceHeader {isPublic, ..} => isPublic
    Node.InterfaceHeader {isPublic, ..} => isPublic
    _ => false
  }
}

// A call qualifier's declaration. A transparent alias qualifier (TYPE-004) names its target's
// declaration, and an alias that fixes the target's arguments also supplies that application.
struct QualifierDeclaration {
  selected: SelectedDeclaration,
  fixed: Option<Shared<Type>>,
  /// The alias that fixed `fixed`, when its own binders are all lifetimes the use leaves to
  /// inference, as `'a` in `type IntRef<'a> = Wrapped<'a, i32>`, with their count.
  lifetimeAlias: Option<DeclarationId>,
  aliasLifetimes: usize,
}

effect fn qualifierDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  name: &[u8],
  span: Span,
) -> Result<QualifierDeclaration, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let chosen = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
    name, false, span, RejectionCode.UnknownActor, RejectionCode.NotCallable, false)
  let selected = match move chosen {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result<QualifierDeclaration, Shared<Rejection>>.failResult(move error)
    }
  }
  let declaredModule = resolvedModule(&resolver.*, selected.module)
  let mut alias = false
  if let Option<HeaderSyntax>.Some {value} = move run scopedHeader(&mut resolver.*, &declaredModule, selected.ordinal) {
    alias = match value.header { Node.AliasHeader {..} => true _ => false }
  }
  if !alias {
    return Result<QualifierDeclaration, Shared<Rejection>>.succeed(
      QualifierDeclaration {selected: move selected, fixed: Option<Shared<Type>>.none(), lifetimeAlias: Option<DeclarationId>.none(), aliasLifetimes: usize.ZERO},
    )
  }
  let declarationAccess21Request = Key {
    family: Family.Alias, module: selected.module, name: usize.ZERO, declaration: selected.ordinal,
    member: usize.ZERO, external: false,
  }
  let declarationAccess21 = run internDeclaration(&mut resolver.*, declarationAccess21Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess21, span)
  if let Option<SelectedDeclaration>.Some {value: target} = move Shared<Result<Answer, NoRejection>>.with<Option<SelectedDeclaration>>(&answer, fn(answer: &Result<Answer, NoRejection>) -> Option<SelectedDeclaration> { return forwardedDeclaration(&resolver.*, answer) }) {
    return Result<QualifierDeclaration, Shared<Rejection>>.succeed(
      QualifierDeclaration {selected: move target, fixed: Option<Shared<Type>>.none(), lifetimeAlias: Option<DeclarationId>.none(), aliasLifetimes: usize.ZERO},
    )
  }
  let aliased = run typeFromAnswer(&answer)
  if let Option<Shared<Rejection>>.Some {value: rejection} = move aliased.rejected {
    return Result<QualifierDeclaration, Shared<Rejection>>.failResult(move rejection)
  }
  if let Option<Shared<Type>>.Some {value: ty} = move aliased.resolved {
    let identity = Shared<Type>.with<Option<DeclarationId>>(&ty, fn(value: &Type) -> Option<DeclarationId> {
      return match & value.* {
        Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
        _ => Option<DeclarationId>.none()
      }
    })
    let applied = Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
      return match & value.* {
        Type.Nominal {arguments, ..} => List<Argument>.length(&arguments) > usize.ZERO
        _ => false
      }
    })
    if let Option<DeclarationId>.Some {value: declaration} = move identity {
      let targetModule = ModuleId.copy(DeclarationId.moduleId(&declaration))
      let targetOrdinal = knownModuleOrdinal(&resolver.*, &targetModule)
      let shared = run Shared<DeclarationId>.make(move declaration)
      let ordinal = run ordinalOfIdentity(&mut resolver.*, &targetModule, &shared)
      if let Option<usize>.Some {value: declarationOrdinal} = move ordinal {
        if targetOrdinal != usize.MAX {
          let mut fixed = Option<Shared<Type>>.none()
          if applied {
            fixed = Option<Shared<Type>>.some(move ty)
          }
          // An alias whose own binders are all lifetimes leaves them to the use, like the regions an
          // owner application omits.
          let mut lifetimeAlias = Option<DeclarationId>.none()
          let mut aliasLifetimes = usize.ZERO
          if let Result<List<Binder>, Shared<Rejection>>.Success {value: binders} = move run templateBinders(&mut resolver.*,
            &declaredModule, selected.ordinal) {
            let listed = List<Binder>.asSlice(&binders)
            if listed.length != usize.ZERO && binderCountOfKind(listed, true) == listed.length {
              if let Option<DeclarationId>.Some {value: aliasIdentity} = move run declarationAt(&mut resolver.*, &declaredModule,
                selected.ordinal) {
                lifetimeAlias = Option<DeclarationId>.some(move aliasIdentity)
                aliasLifetimes = listed.length
              }
            }
          }
          return Result<QualifierDeclaration, Shared<Rejection>>.succeed(QualifierDeclaration {
            selected: SelectedDeclaration {module: targetOrdinal, ordinal: declarationOrdinal},
            fixed: move fixed, lifetimeAlias: move lifetimeAlias, aliasLifetimes: aliasLifetimes,
          })
        }
      }
    }
  }
  return Result<QualifierDeclaration, Shared<Rejection>>.succeed(
    QualifierDeclaration {selected: move selected, fixed: Option<Shared<Type>>.none(), lifetimeAlias: Option<DeclarationId>.none(), aliasLifetimes: usize.ZERO},
  )
}

// Expression qualifiers keep the reserved Intrinsic prefix separate from the declaration name.
// Type and expression positions select the same public declaration through one lookup.
effect fn bodyQualifierDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  written: &QualifiedBodyName,
) -> Result<QualifierDeclaration, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if
    !written.intrinsic {
    return run qualifierDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&written.namespace),
      written.subjectSpan
    )
  }
  let mut segments = List<Bytes>.make()
  run List<Bytes>.append(&mut segments, run Bytes.copy(b"Intrinsic"))
  run List<Bytes>.append(&mut segments, run Bytes.copy(Bytes.asSlice(&written.namespace)))
  let selected = run qualifiedTypeDeclaration(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    List<Bytes>.asSlice(&segments),
    written.subjectSpan
  )
  return match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {
      value
    } => Result<
      QualifierDeclaration,
      Shared<Rejection>
    >.succeed(QualifierDeclaration { selected: move value, fixed: Option<Shared<Type>>.none(), lifetimeAlias: Option<DeclarationId>.none(), aliasLifetimes: usize.ZERO })
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {
      error
    } => Result<QualifierDeclaration, Shared<Rejection>>.failResult(move error)
  }
}

// The declaration an unapplied alias forwards its uses to, when the alias answer names one.
fn forwardedDeclaration(resolver: &Resolver, answer: &Result<Answer, NoRejection>) -> Option<SelectedDeclaration> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Selected {declaration: _, module, handle} => Option<SelectedDeclaration>.some(
          SelectedDeclaration {module: module, ordinal: DeclarationTable.position(&resolver.declarations, handle)},
        )
        _ => Option<SelectedDeclaration>.none()
      }
      _ => Option<SelectedDeclaration>.none()
    }
    Result<Answer, NoRejection>.Failure {..} => Option<SelectedDeclaration>.none()
  }
}

effect fn resolveIdentity(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let declarationAccess22 = declarationPosition(&resolver.*, key)
  let written = run observedHeader(&mut resolver.*, &module, declarationAccess22, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let allowed = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.EnumHeader {..} => true
      Node.UnionHeader {..} => true
      Node.ServiceHeader {..} => true
      Node.InterfaceHeader {..} => true
      Node.RoleHeader {..} => true
      _ => false
    }
    let isPublic = match value.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.RoleHeader {isPublic, ..} => isPublic
      _ => false
    }
    if allowed {
      let declarationAccess23 = declarationPosition(&resolver.*, key)
      let found = run declarationAt(&mut resolver.*, &module, declarationAccess23)
      if let Option<DeclarationId>.Some {value: id} = move found {
        return Answer {
          outcome: Outcome.Success {
            value: Value.Type {
              resolved: run Types.intern(
                Type.Nominal {
                  declaration: move id,
                  isPublic: isPublic,
                  arguments: List<Argument>.make(),
                },
              ),
            },
          },
          dependencies: List<Dependency>.make(),
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: run rejectedOutcome(move diagnostic),
      dependencies: List<Dependency>.make(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: run rejectedOutcome(move diagnostic),
    dependencies: List<Dependency>.make(),
  }
}

fn memberSuccess(value: Value, dependencies: List<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Success {value: move value},
    dependencies: move dependencies,
  }
}

effect fn memberRejected(diagnostic: Shared<Rejection>, dependencies: List<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  return Answer {
    outcome: run rejectedOutcome(move diagnostic),
    dependencies: move dependencies,
  }
}

effect fn writtenMember(hir: &Module, id: HirId, kind: MemberKind) -> Option<Member>
! OutOfMemoryError
? &mut Allocator {
  if kind == MemberKind.Position {
    return Option<Member>.some(
      Member {
        name: Option<Bytes>.none(),
        isPublic: true,
        kind: kind,
        discriminant: Option<EnumCase>.none(),
      },
    )
  }
  let node = Module.node(hir, id)
  let mut name = HirId {index: usize.ZERO}
  let mut isPublic = true
  if let Node.Field {name: field, isPublic: visible, ..} = node {
    name = field
    isPublic = visible
  } else if let Node.EnumMember {name: member, ..} = node {
    name = member
  } else if let Node.Variant {name: variant, ..} = node {
    name = variant
  } else {
    return Option<Member>.none()
  }
  if let Node.Name {text} = Module.node(hir, name) {
    return Option<Member>.some(
      Member {
        name: Option<Bytes>.some(run Bytes.copy(Module.text(hir, text))),
        isPublic: isPublic,
        kind: kind,
        discriminant: Option<EnumCase>.none(),
      },
    )
  }
  return Option<Member>.none()
}

fn memberSameName(left: &Member, right: &Member) -> bool {
  return match & left.name {
    Option<Bytes>.Some {value: first} => match & right.name {
      Option<Bytes>.Some {value: second} => same(Bytes.asSlice(&first), Bytes.asSlice(&second))
      Option<Bytes>.None => false
    }
    Option<Bytes>.None => false
  }
}

fn enumRepresentation(hir: &Module, id: HirId) -> Option<StaticIntegerType> {
  if let Node.NamedType {path: written, hasMode, ..} = Module.node(hir, id) {
    if hasMode {
      return Option<StaticIntegerType>.none()
    }
    if let Node.Path {segments} = Module.node(hir, written) {
      if segments.length == usize.ONE {
        let nameNode = Module.child(hir, segments, usize.ZERO)
        if let Node.Name {text} = Module.node(hir, nameNode) {
          let name = Module.text(hir, text)
          if same(name, b"u8") {
            return Option<StaticIntegerType>.some(StaticIntegerType.U8)
          }
          if same(name, b"u16") {
            return Option<StaticIntegerType>.some(StaticIntegerType.U16)
          }
          if same(name, b"u32") {
            return Option<StaticIntegerType>.some(StaticIntegerType.U32)
          }
          if same(name, b"u64") {
            return Option<StaticIntegerType>.some(StaticIntegerType.U64)
          }
          if same(name, b"i8") {
            return Option<StaticIntegerType>.some(StaticIntegerType.I8)
          }
          if same(name, b"i16") {
            return Option<StaticIntegerType>.some(StaticIntegerType.I16)
          }
          if same(name, b"i32") {
            return Option<StaticIntegerType>.some(StaticIntegerType.I32)
          }
          if same(name, b"i64") {
            return Option<StaticIntegerType>.some(StaticIntegerType.I64)
          }
        }
      }
    }
  }
  return Option<StaticIntegerType>.none()
}

fn enumMemberAnchor(hir: &Module, id: HirId, discriminant: bool) -> Span {
  if let Node.EnumMember {name, value} = Module.node(hir, id) {
    if discriminant && value.present {
      return Module.span(hir, value.id)
    }
    return Module.span(hir, name)
  }
  return Module.span(hir, id)
}

fn enumRejection(reason: EnumReason) -> RejectionCode {
  return match reason {
    EnumReason.Empty => RejectionCode.EmptyEnum
    EnumReason.Representation => RejectionCode.InvalidEnumRepresentation
    EnumReason.DuplicateName => RejectionCode.DuplicateEnumMember
    EnumReason.DuplicateDiscriminant => RejectionCode.DuplicateEnumDiscriminant
    EnumReason.ExplicitOutOfRange => RejectionCode.EnumDiscriminantOutOfRange
    EnumReason.ImplicitOverflow => RejectionCode.EnumImplicitOverflow
    EnumReason.NegativeUnsigned => RejectionCode.UnsignedEnumNegative
    EnumReason.InvalidLiteral => RejectionCode.EnumDiscriminantOutOfRange
  }
}

effect fn writtenEnumRepresentation(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  representation: HirId,
) -> Result<StaticIntegerType, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let selection = enumRepresentation(hir, representation)
  return match move selection {
    Option<StaticIntegerType>.Some {value: chosen} => Result<StaticIntegerType, Shared<Rejection>>.succeed(
      chosen,
    )
    Option<StaticIntegerType>.None => Result<StaticIntegerType, Shared<Rejection>>.failResult(
      run reject(
        resolver,
        module,
        RejectionCode.InvalidEnumRepresentation,
        Module.span(hir, representation),
      ),
    )
  }
}

// A written enum discriminant must be an unsuffixed integer literal in any base; lowering already
// decoded its magnitude to decimal digits.
effect fn discriminantLiteral(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  discriminant: HirId,
) -> Result<Option<EnumLiteral>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if let Node.IntegerLiteral {sign, magnitude, suffix, ..} = Module.node(hir, discriminant) {
    if suffix.present {
      return Result<Option<EnumLiteral>, Shared<Rejection>>.failResult(
        run plainDiscriminantRejection(module, Module.span(hir, discriminant)),
      )
    }
    let mut enumSign = StaticSign.Positive
    if sign == Sign.Negative {
      enumSign = StaticSign.Negative
    }
    return Result<Option<EnumLiteral>, Shared<Rejection>>.succeed(
      Option<EnumLiteral>.some(
        EnumLiteral {sign: enumSign, digits: run Bytes.copy(Module.text(hir, magnitude))},
      ),
    )
  }
  return Result<Option<EnumLiteral>, Shared<Rejection>>.failResult(
    run plainDiscriminantRejection(module, Module.span(hir, discriminant)),
  )
}

// SEM0150 for a discriminant written as anything but a plain integer literal.
effect fn plainDiscriminantRejection(module: &ModuleId, span: Span) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.EnumDiscriminantOutOfRange, module, span)
  run vectorArgument(&mut diagnostic, b"template", b"1")
  return run Shared<Rejection>.make(move diagnostic)
}

// The name and optional written discriminant of one enum member.
effect fn enumInputOf(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  child: HirId,
  member: &Member,
) -> Result<EnumInput, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let name = match & member.name {
    Option<Bytes>.Some {value: writtenName} => run Bytes.copy(Bytes.asSlice(&writtenName))
    Option<Bytes>.None => {
      return Result<EnumInput, Shared<Rejection>>.failResult(
        run reject(resolver, module, RejectionCode.Unsupported, Module.span(hir, child)),
      )
    }
  }
  let mut explicit = Option<EnumLiteral>.none()
  if let Node.EnumMember {value: discriminant, ..} = Module.node(hir, child) {
    if discriminant.present {
      let literal = run discriminantLiteral(resolver, module, hir, discriminant.id)
      explicit = match move literal {
        Result<Option<EnumLiteral>, Shared<Rejection>>.Success {value: written} => move written
        Result<Option<EnumLiteral>, Shared<Rejection>>.Failure {error} => {
          return Result<EnumInput, Shared<Rejection>>.failResult(move error)
        }
      }
    }
  }
  return Result<EnumInput, Shared<Rejection>>.succeed(
    EnumInput {name: move name, explicit: move explicit},
  )
}

fn repeatsMemberName(prior: &[Member], member: &Member) -> bool {
  let mut before = usize.ZERO
  while before < prior.length {
    if memberSameName(&prior[before], member) {
      return true
    }
    before = before + usize.ONE
  }
  return false
}

// Adds one written member, collecting enum members' inputs for the later discriminant check.
effect fn recordMember(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  kind: MemberKind,
  child: HirId,
  members: &mut List<Member>,
  enumInputs: &mut List<EnumInput>,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let candidate = run writtenMember(hir, child, kind)
  let member = match move candidate {
    Option<Member>.Some {value: written} => move written
    Option<Member>.None => {
      return Option<Shared<Rejection>>.some(
        run reject(resolver, module, RejectionCode.Unsupported, Module.span(hir, child)),
      )
    }
  }
  if kind == MemberKind.EnumCase {
    let attempt = run enumInputOf(resolver, module, hir, child, &member)
    let input = match move attempt {
      Result<EnumInput, Shared<Rejection>>.Success {value: entered} => move entered
      Result<EnumInput, Shared<Rejection>>.Failure {error} => {
        return Option<Shared<Rejection>>.some(move error)
      }
    }
    run List<EnumInput>.append(&mut enumInputs.*, move input)
  } else if repeatsMemberName(List<Member>.asSlice(&members.*), &member) {
    let mut code = RejectionCode.DuplicateFieldName
    if kind == MemberKind.Variant { code = RejectionCode.DuplicateUnionVariant }
    return Option<Shared<Rejection>>.some(
      run reject(resolver, module, code, memberNameSpan(hir, child)),
    )
  } else if kind == MemberKind.Variant && emptyVariantBlock(hir, child) {
    return Option<Shared<Rejection>>.some(
      run reject(resolver, module, RejectionCode.EmptyUnionVariant, Module.span(hir, child)),
    )
  }
  run List<Member>.append(&mut members.*, move member)
  return Option<Shared<Rejection>>.none()
}

// The span of a field's or variant's written name; the whole member for any other form.
fn memberNameSpan(hir: &Module, member: HirId) -> Span {
  return match Module.node(hir, member) {
    Node.Field {name, ..} => Module.span(hir, name)
    Node.Variant {name, ..} => Module.span(hir, name)
    _ => Module.span(hir, member)
  }
}

// NUNION-001: written braces with no named field are neither a unit variant nor a field variant.
fn emptyVariantBlock(hir: &Module, variant: HirId) -> bool {
  if let Node.Variant {fields, braces, ..} = Module.node(hir, variant) {
    if !braces { return false }
    let mut at = usize.ZERO
    while at < fields.length {
      if let Node.Field {name, ..} = Module.node(hir, Module.child(hir, fields, at)) {
        if let Node.Name {..} = Module.node(hir, name) { return false }
      }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

// A scalar enum representation with its range, as messages name it: `u8 (0 to 255)`.
fn enumRangeText(representation: StaticIntegerType) -> string<'static> {
  return match representation {
    StaticIntegerType.U8 => "u8 (0 to 255)"
    StaticIntegerType.U16 => "u16 (0 to 65535)"
    StaticIntegerType.U32 => "u32 (0 to 4294967295)"
    StaticIntegerType.U64 => "u64 (0 to 18446744073709551615)"
    StaticIntegerType.Usize => "usize"
    StaticIntegerType.I8 => "i8 (-128 to 127)"
    StaticIntegerType.I16 => "i16 (-32768 to 32767)"
    StaticIntegerType.I32 => "i32 (-2147483648 to 2147483647)"
    StaticIntegerType.I64 => "i64 (-9223372036854775808 to 9223372036854775807)"
    StaticIntegerType.Isize => "isize"
  }
}

// A discriminant in decimal, with its sign.
effect fn enumCaseText(value: &EnumCase) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if value.sign == StaticSign.Negative { run Bytes.append(&mut text, b"-") }
  run appendDecimal(&mut text, u64.toUsize(value.magnitude))
  return move text
}

// The rejection for a failed enum validation, anchored at the offending member and its peer, and
// naming the enum, the members, the discriminant and the representation's range.
effect fn enumFailureRejection(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  range: Range,
  fallback: Span,
  error: &EnumFailure,
  enumName: &[u8],
  enumInputs: &[EnumInput],
  enumType: StaticIntegerType,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut span = fallback
  let mut related = Option<RelatedSite>.none()
  let mut diagnostic = run makeRejection(enumRejection(error.reason), module, span)
  run vectorArgument(&mut diagnostic, b"enumName", enumName)
  run vectorArgument(&mut diagnostic, b"representation", String.utf8Bytes(enumRangeText(enumType)))
  if error.reason != EnumReason.Empty {
    let child = Module.child(hir, range, error.ordinal)
    let onValue = error.reason == EnumReason.DuplicateDiscriminant || error.reason == EnumReason.ExplicitOutOfRange || error.reason == EnumReason.NegativeUnsigned
    span = enumMemberAnchor(hir, child, onValue)
    if let Option<usize>.Some {value: previous} = &error.previous {
      let earlier = Module.child(hir, range, previous)
      related = Option<RelatedSite>.some(
        RelatedSite {module: ModuleId.copy(module), span: enumMemberAnchor(hir, earlier, onValue)},
      )
      if previous < enumInputs.length {
        run vectorArgument(&mut diagnostic, b"previous", Bytes.asSlice(&enumInputs[previous].name))
      }
    }
    if error.ordinal < enumInputs.length {
      let input = &enumInputs[error.ordinal]
      run vectorArgument(&mut diagnostic, b"member", Bytes.asSlice(&input.name))
      if error.reason == EnumReason.ImplicitOverflow && error.ordinal > usize.ZERO {
        run vectorArgument(&mut diagnostic, b"predecessor", Bytes.asSlice(&enumInputs[error.ordinal - usize.ONE].name))
      }
      // A written discriminant that does not even fit in 64 bits keeps its written digits.
      if error.reason == EnumReason.InvalidLiteral {
        if let Option<EnumLiteral>.Some {value: written} = &input.explicit {
          let mut text = Bytes.make()
          if written.sign == StaticSign.Negative { run Bytes.append(&mut text, b"-") }
          run Bytes.append(&mut text, Bytes.asSlice(&written.digits))
          run vectorArgument(&mut diagnostic, b"value", Bytes.asSlice(&text))
        }
      } else {
        let shown = run enumCaseText(&error.value)
        run vectorArgument(&mut diagnostic, b"value", Bytes.asSlice(&shown))
      }
    }
  }
  diagnostic.span = span
  diagnostic.related = move related
  return run Shared<Rejection>.make(move diagnostic)
}

// Checks the enum discriminants and stores each case's value on its member.
effect fn assignDiscriminants(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  range: Range,
  fallback: Span,
  enumName: &[u8],
  enumInputs: &[EnumInput],
  enumType: StaticIntegerType,
  members: &mut List<Member>,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let checked = run ScalarEnum.validate(enumInputs, enumType)
  let cases = match move checked {
    Result<List<EnumCase>, EnumFailure>.Success {value: valid} => move valid
    Result<List<EnumCase>, EnumFailure>.Failure {error} => {
      return Option<Shared<Rejection>>.some(
        run enumFailureRejection(resolver, module, hir, range, fallback, &error, enumName, enumInputs, enumType),
      )
    }
  }
  let values = List<EnumCase>.asSlice(&cases)
  let mut output = List<Member>.asMutSlice(&mut members.*)
  let mut index = usize.ZERO
  while index < values.length {
    output[index].discriminant = Option<EnumCase>.some(
      EnumCase {sign: values[index].sign, magnitude: values[index].magnitude},
    )
    index = index + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

effect fn resolveMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess24 = declarationPosition(&resolver.*, key)
  let written = run scopedHeader(&mut resolver.*, &module, declarationAccess24)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let identityKey = Key {
      family: Family.Identity,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    }
    let identity = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      identityKey,
      value.span,
    )
    let selected = run typeFromAnswer(&identity)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selected.rejected {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let mut range = Range.empty()
    let mut kind = MemberKind.Field
    if let Node.StructHeader {fields, ..} = value.header {
      range = fields
    } else if let Node.TupleHeader {elements, ..} = value.header {
      range = elements
      kind = MemberKind.Position
    } else if let Node.EnumHeader {members, ..} = value.header {
      range = members
      kind = MemberKind.EnumCase
    } else if let Node.UnionHeader {variants, ..} = value.header {
      range = variants
      kind = MemberKind.Variant
      // NUNION-001: a nominal union declares at least one variant.
      if variants.length == usize.ZERO {
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.EmptyUnion, value.span),
          move dependencies,
        )
      }
    } else {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    let sourceAnswer = run observedDeclaration(&mut resolver.*, &module, declarationAccess24, SourceFacet.Members)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let mut members = List<Member>.make()
      let mut enumInputs = List<EnumInput>.make()
      let mut enumType = StaticIntegerType.U8
      if let Node.EnumHeader {representation, ..} = value.header {
        if representation.present {
          let selection = run writtenEnumRepresentation(
            &resolver.*,
            &module,
            hir,
            representation.id,
          )
          enumType = match move selection {
            Result<StaticIntegerType, Shared<Rejection>>.Success {value: chosen} => chosen
            Result<StaticIntegerType, Shared<Rejection>>.Failure {error} => {
              return run memberRejected(move error, move dependencies)
            }
          }
        }
      }
      let mut at = usize.ZERO
      while at < range.length {
        let refusal = run recordMember(
          &resolver.*,
          &module,
          hir,
          kind,
          Module.child(hir, range, at),
          &mut members,
          &mut enumInputs,
        )
        if let Option<Shared<Rejection>>.Some {value: refused} = move refusal {
          return run memberRejected(move refused, move dependencies)
        }
        at = at + usize.ONE
      }
      if kind == MemberKind.EnumCase {
        let mut enumName = Bytes.make()
        if let Node.EnumHeader {name, ..} = value.header {
          if let Node.Name {text} = Module.node(hir, name) { enumName = run Bytes.copy(Module.text(hir, text)) }
        }
        let refusal = run assignDiscriminants(
          &resolver.*,
          &module,
          hir,
          range,
          value.span,
          Bytes.asSlice(&enumName),
          List<EnumInput>.asSlice(&enumInputs),
          enumType,
          &mut members,
        )
        if let Option<Shared<Rejection>>.Some {value: refused} = move refusal {
          return run memberRejected(move refused, move dependencies)
        }
      }
      let declarationAccess25 = declarationPosition(&resolver.*, key)
      let declaration = match move run declarationAt(&mut resolver.*, &module, declarationAccess25) {
        Option<DeclarationId>.Some {value: found} => run Shared<DeclarationId>.make(move found)
        Option<DeclarationId>.None => { return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        ) }
      }
      return memberSuccess(Value.Members {identity: move declaration, members: move members, enumRepresentation: enumType}, move dependencies)
    }
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
      move dependencies,
    )
  }
  return run memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

fn binderKind(binder: &Binder) -> GenericKind {
  return match & binder.* {
    Binder.Type {..} => GenericKind.Type
    Binder.Lifetime {..} => GenericKind.Lifetime
    Binder.Row {..} => GenericKind.Requirement
  }
}

fn argumentKind(argument: &Argument) -> GenericKind {
  return match & argument.* {
    Argument.Type {..} => GenericKind.Type
    Argument.Lifetime {..} => GenericKind.Lifetime
    Argument.Row {..} => GenericKind.Requirement
  }
}

// STRUCT-006: whether `ty` is in the closed C object subset a C-layout record field may hold: a C
// integer or floating scalar, a raw pointer, an admitted C function address, a fixed array of such
// objects, another C-layout record, or a scalar enum with a written representation.
effect fn cObjectField(resolver: &mut Resolver, ty: &Shared<Type>) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let element = Shared<Type>.with<Option<Shared<Type>>>(ty, fn(value: &Type) -> Option<Shared<Type>> {
    return match &value.* {
      Type.Array {element, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&element))
      _ => Option<Shared<Type>>.none()
    }
  })
  if let Option<Shared<Type>>.Some {value: inner} = move element { return run cObjectField(&mut resolver.*, &inner) }
  let nominal = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.Nominal {..} => true _ => false }
  })
  if !nominal {
    return Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
      return match &value.* {
        Type.Unit => false
        _ => CAbi.admit(value)
      }
    })
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return false }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = match move run ordinalOfProvider(&mut resolver.*, &declaredModule, ty) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let written = run header(&mut resolver.*, &declaredModule, ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    return match value.header {
      Node.StructHeader {abi, ..} => abi.present
      Node.EnumHeader {representation, ..} => representation.present
      _ => false
    }
  }
  return false
}

effect fn resolveMemberShape(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess26 = declarationPosition(&resolver.*, key)
  let written = run scopedHeader(&mut resolver.*, &module, declarationAccess26)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let namesKey = Key {
      family: Family.Members,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    }
    let names = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      namesKey,
      value.span,
    )
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &names,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let mut range = Range.empty()
    let mut kind = MemberKind.Field
    if let Node.StructHeader {fields, ..} = value.header {
      range = fields
    } else if let Node.TupleHeader {elements, ..} = value.header {
      range = elements
      kind = MemberKind.Position
    } else if let Node.EnumHeader {members, ..} = value.header {
      range = members
      kind = MemberKind.EnumCase
    } else if let Node.UnionHeader {variants, ..} = value.header {
      range = variants
      kind = MemberKind.Variant
    } else {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    if key.member >= range.length {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.IdentityUnavailable, value.span),
        move dependencies,
      )
    }
    let declarationAccess27 = declarationPosition(&resolver.*, key)
    let found = run declarationAt(&mut resolver.*, &module, declarationAccess27)
    let applications = List<Shared<Type>>.asSlice(&resolver.applications)
    let application = Shared<Type>.clone(&applications[key.name])
    if let Option<DeclarationId>.Some {value: declaration} = move found {
      if !Shared<Type>.with<bool>(
        &application,
        fn(ty: &Type) -> bool {
          return applicationMatches(ty, &declaration)
        },
      ) {
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        )
      }
    } else {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
        move dependencies,
      )
    }
    let declarationAccess28 = declarationPosition(&resolver.*, key)
    let template = run templateBinders(&mut resolver.*, &module, declarationAccess28)
    let mut binders = match move template {
      Result<List<Binder>, Shared<Rejection>>.Success {value: resolvedBinders} => move resolvedBinders
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    // Each omitted lifetime in a field is one of the declaration's implicit field binders, which
    // follow the written ones; the bound-owned binders come after those (LIFE-003).
    let writtenBinders = List<Binder>.length(&binders)
    let declarationAccess29 = declarationPosition(&resolver.*, key)
    let incomplete = run completeAggregateBinders(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      declarationAccess29,
      value.span,
      &mut binders,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move incomplete {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let implicit = List<Binder>.length(&binders) - writtenBinders
    let declarationAccess30 = declarationPosition(&resolver.*, key)
    let bound = run completeBoundBinders(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, &module,
      declarationAccess30, value.span, &mut binders)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move bound {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let mut arguments = List<Argument>.make()
    let count = Shared<Type>.with<usize>(&application, applicationLength)
    if count != List<Binder>.length(&binders) {
      return run memberRejected(
        run rejectArity(&resolver.*, &module, value.span, List<Binder>.length(&binders), count),
        move dependencies,
      )
    }
    let mut at = usize.ZERO
    while at < count {
      let supplied = Shared<Type>.with<Option<Argument>>(
        &application,
        fn(ty: &Type) -> Option<Argument> {
          return applicationArgument(ty, at)
        },
      )
      if let Option<Argument>.Some {value: argument} = move supplied {
        run List<Argument>.append(&mut arguments, move argument)
      }
      at = at + usize.ONE
    }
    let parameters = List<Binder>.asSlice(&binders)
    let supplied = List<Argument>.asSlice(&arguments)
    let mut argumentAt = usize.ZERO
    while argumentAt < count {
      let expectedKind = binderKind(&parameters[argumentAt])
      let suppliedKind = argumentKind(&supplied[argumentAt])
      if expectedKind != suppliedKind {
        return run memberRejected(
          run rejectKind(
            &resolver.*,
            &module,
            value.span,
            binderName(&parameters[argumentAt]),
            expectedKind,
            suppliedKind,
          ),
          move dependencies,
        )
      }
      argumentAt = argumentAt + usize.ONE
    }
    let applied = run bindArguments(
      List<Binder>.asSlice(&binders),
      List<Argument>.asSlice(&arguments),
    )
    // Implicit binders follow the omitted lifetimes in declaration order, so the members before this
    // one are resolved too, only to number its omitted lifetimes; their types are not kept.
    let mut first = key.member
    if implicit > usize.ZERO { first = usize.ZERO }
    let mut annotations = List<HirId>.make()
    let mut fieldName = Bytes.make()
    let mut own = usize.ZERO
    let mut observedAt = first
    while observedAt <= key.member {
      drop run observedMember(&mut resolver.*, &module, declarationAccess26, observedAt)
      observedAt = observedAt + usize.ONE
    }
    let sourceAnswer = run observedDeclaration(&mut resolver.*, &module, declarationAccess26, SourceFacet.Members)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let mut memberAt = first
      while memberAt <= key.member {
        if memberAt == key.member { own = List<HirId>.length(&annotations) }
        let member = Module.child(hir, range, memberAt)
        if kind == MemberKind.Position {
          run List<HirId>.append(&mut annotations, member)
        } else if kind == MemberKind.Field {
          if let Node.Field {name, annotation, ..} = Module.node(hir, member) {
            run List<HirId>.append(&mut annotations, annotation)
            if let Node.Name {text} = Module.node(hir, name) { fieldName = run Bytes.copy(Module.text(hir, text)) }
          }
        } else if kind == MemberKind.Variant {
          if let Node.Variant {fields, ..} = Module.node(hir, member) {
            let mut fieldAt = usize.ZERO
            while fieldAt < fields.length {
              let field = Module.child(hir, fields, fieldAt)
              if let Node.Field {annotation, ..} = Module.node(hir, field) {
                run List<HirId>.append(&mut annotations, annotation)
              } else {
                return run memberRejected(
                  run reject(&resolver.*, &module, RejectionCode.Unsupported, Module.span(hir, field)),
                  move dependencies,
                )
              }
              fieldAt = fieldAt + usize.ONE
            }
          }
        }
        memberAt = memberAt + usize.ONE
      }
    } else {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    drop sourceAnswer
    let isPublic = match value.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      _ => false
    }
    let declarationAccess31 = declarationPosition(&resolver.*, key)
    let resolvedBounds = run appliedDeclarationBounds(
      &mut resolver.*, &mut owner.*, &mut dependencies, key.module, declarationAccess31,
      headerGenerics(value.header), List<Binder>.asSlice(&binders),
      List<Argument>.asSlice(&arguments), value.span, isPublic,
    )
    let assumptions = match move resolvedBounds {
      Result<List<Constraint>, Shared<Rejection>>.Success {value: bounds} => move bounds
      Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    // An omitted field lifetime takes the application's argument for its implicit binder.
    let mut fieldArguments = Option<List<Argument>>.none()
    if implicit > usize.ZERO {
      fieldArguments = Option<List<Argument>>.some(run copyArguments(List<Argument>.asSlice(&arguments)))
    }
    let declarationAccess32 = declarationPosition(&resolver.*, key)
    let mut elision = LifetimeElision {
      owner: run declarationAt(&mut resolver.*, &module, declarationAccess32),
      nextOrdinal: writtenBinders,
      output: false,
      resultDefault: Option<Shared<Lifetime>>.none(),
      generated: List<Shared<Lifetime>>.make(),
      invocation: false,
      nested: false,
      renumber: List<usize>.make(),
      staticEnvironment: false,
      supplied: move fieldArguments,
      assumptions: Option<List<Constraint>>.some(move assumptions),
      deferred: Option<List<DeferredBounds>>.none(),
    }
    let cLayout = match value.header {
      Node.StructHeader {abi, ..} => abi.present
      _ => false
    }
    let mut types = List<Shared<Type>>.make()
    let writtenTypes = List<HirId>.asSlice(&annotations)
    let mut typeAt = usize.ZERO
    while typeAt < writtenTypes.length {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        writtenTypes[typeAt],
        List<Binder>.asSlice(&applied),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if typeAt < own {
            typeAt = typeAt + usize.ONE
            continue
          }
          let existential = run existentialRejection(
            &mut resolver.*,
            &module,
            writtenTypes[typeAt],
            &ty,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
            return run memberRejected(move diagnostic, move dependencies)
          }
          // STRUCT-006: a C-layout record field stays inside the closed C object subset.
          if cLayout && !run cObjectField(&mut resolver.*, &ty) {
            let mut fieldSpan = value.span
            let annotation = run typeNode(&mut resolver.*, &module, writtenTypes[typeAt])
            if let Option<HeaderSyntax>.Some {value: syntax} = move annotation { fieldSpan = syntax.span }
            let mut refused = run makeRejection(RejectionCode.UnsupportedCLayoutField, &module, fieldSpan)
            if let Option<Bytes>.Some {value: record} = move run TypeText.displayElided(&application, &module) {
              if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(&ty, &module) {
                run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"field"), value: run Bytes.copy(Bytes.asSlice(&fieldName))})
                run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"record"), value: move record})
                run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move text})
              }
            }
            return run memberRejected(run Shared<Rejection>.make(move refused), move dependencies)
          }
          run List<Shared<Type>>.append(&mut types, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return run memberRejected(move error, move dependencies)
        }
      }
      typeAt = typeAt + usize.ONE
    }
    // An omitted lifetime beyond the implicit binders, such as one inside a recursive reference to
    // this declaration, has no binder to take.
    if elision.nextOrdinal > writtenBinders + implicit {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    return memberSuccess(Value.MemberShape {types: move types}, move dependencies)
  }
  return run memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// Records one written bound. It checks that the contract is an interface or service application;
// whether any provider conforms is a later question.
// Authored headers reject repeated bounds. Validated applications can make distinct
// formal bounds equal; resolving their proof requirements coalesces equal constraints.
enum BoundPhase {
  Authored,
  Application
}

effect fn declareBound(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  binder: &Binder,
  boundId: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  isPublic: bool,
  phase: BoundPhase,
  constraints: &mut List<Constraint>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let syntax = run typeNode(&mut resolver.*, module, boundId)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut isLifetime = false
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.Lifetime {..} = value.header {
      isLifetime = true
    }
  }
  if isLifetime {
    let resolved = run lifetimeAt(&mut resolver.*, module, boundId, binders)
    let region = match move resolved {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Option<Shared<Rejection>>.some(move error)
      }
    }
    if let Binder.Type {value: subject, ..} = &binder.* {
      run List<Constraint>.append(
        &mut constraints.*,
        Constraint.Contents {subject: Shared<Type>.clone(&subject), region: move region},
      )
      return Option<Shared<Rejection>>.none()
    }
    if let Binder.Lifetime {value: longer, ..} = &binder.* {
      run List<Constraint>.append(
        &mut constraints.*,
        Constraint.Outlives {longer: Shared<Lifetime>.clone(&longer), shorter: move region},
      )
      return Option<Shared<Rejection>>.none()
    }
  }
  if let Binder.Type {value: provider, ..} = &binder.* {
    // A sealed property comes first: `Intrinsic.Copy` is also an Intrinsic member spelling.
    let sealed = run sealedProperty(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, boundId,
      binders)
    if let Option<SealedProperty>.Some {value: property} = move sealed {
      // Drop is requested by an `impl`, never required of a parameter.
      if property == SealedProperty.Drop {
        return Option<Shared<Rejection>>.some(
          run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
        )
      }
      if property != SealedProperty.Copy {
        let written = List<Constraint>.asSlice(&constraints.*)
        let mut each = usize.ZERO
        while each < written.length {
          if let Constraint.ThreadSafe {subject, property: found} = &written[each] {
            if found == property && run Type.equalsShared(&subject, &provider) {
              if phase == BoundPhase.Application {
                return Option<Shared<Rejection>>.none()
              }
              return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.DuplicateBound, span))
            }
          }
          each = each + usize.ONE
        }
        run List<Constraint>.append(
          &mut constraints.*,
          Constraint.ThreadSafe {subject: Shared<Type>.clone(&provider), property: property},
        )
        return Option<Shared<Rejection>>.none()
      }
      let prior = List<Constraint>.asSlice(&constraints.*)
      let mut at = usize.ZERO
      while at < prior.length {
        if let Constraint.Copyable {subject} = &prior[at] {
          if run Type.equalsShared(&subject, &provider) {
            if phase == BoundPhase.Application {
              return Option<Shared<Rejection>>.none()
            }
            return Option<
              Shared<Rejection>
            >.some(run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),)
          }
        }
        at = at + usize.ONE
      }
      run List<Constraint>.append(
        &mut constraints.*,
        Constraint.Copyable {subject: Shared<Type>.clone(&provider)},
      )
      return Option<Shared<Rejection>>.none()
    }
    let intrinsic = run intrinsicBound(&mut resolver.*, module, boundId)
    if intrinsic.named {
      // No other Intrinsic family is implemented as a bound yet; it stays an explicit boundary.
      let found = match move intrinsic.property {
        Option<IntrinsicProperty>.Some {value} => value
        Option<IntrinsicProperty>.None => {
          return Option<Shared<Rejection>>.some(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
      }
      let prior = List<Constraint>.asSlice(&constraints.*)
      let mut at = usize.ZERO
      while at < prior.length {
        if let Constraint.Property {subject, property} = &prior[at] {
          if property == found && run Type.equalsShared(&subject, &provider) {
            if phase == BoundPhase.Application {
              return Option<Shared<Rejection>>.none()
            }
            return Option<
              Shared<Rejection>
            >.some(run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),)
          }
        }
        at = at + usize.ONE
      }
      run List<Constraint>.append(
        &mut constraints.*,
        Constraint.Property {subject: Shared<Type>.clone(&provider), property: found},
      )
      return Option<Shared<Rejection>>.none()
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      boundId,
      binders,
      &mut elision.*,
    )
    let contract = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option<Shared<Rejection>>.some(move error)
      }
    }
    let exposure = run exposedPrivate(&mut resolver.*, module, boundId, &contract, isPublic)
    if let Option<Shared<Rejection>>.Some {value} = move exposure {
      return Option<Shared<Rejection>>.some(move value)
    }
    // A callable or Effect contract makes the parameter a representation parameter.
    if Shared<Type>.with<bool>(&contract, executableContract) {
      run List<Constraint>.append(
        &mut constraints.*,
        Constraint.Represents {parameter: Shared<Type>.clone(&provider), contract: move contract},
      )
      return Option<Shared<Rejection>>.none()
    }
    // A service is an interface with dependency eligibility; both are valid static bounds.
    let kind = Shared<Type>.with<OwnerKind>(&contract, nominalKind)
    if kind != OwnerKind.Interface && kind != OwnerKind.Service {
      return Option<Shared<Rejection>>.some(
        run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
      )
    }
    let prior = List<Constraint>.asSlice(&constraints.*)
    let mut at = usize.ZERO
    while at < prior.length {
      if let Constraint.Conforms {provider: earlier, contract: applied} = &prior[at] {
        let sameProvider = run Type.equalsShared(&earlier, &provider)
        let sameContract = run Type.equalsShared(&applied, &contract)
        if sameProvider && sameContract {
          if phase == BoundPhase.Application {
            return Option<Shared<Rejection>>.none()
          }
          return Option<
            Shared<Rejection>
          >.some(run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),)
        }
      }
      at = at + usize.ONE
    }
    run List<Constraint>.append(
      &mut constraints.*,
      Constraint.Conforms {provider: Shared<Type>.clone(&provider), contract: move contract},
    )
    return Option<Shared<Rejection>>.none()
  }
  return Option<Shared<Rejection>>.some(
    run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
  )
}

// Records each written `where Provider provides S from R` clause. Its selector names service-role
// keys; whether the provider conforms and the key is present is proved where the bound is applied.
// Whether a membership subject is one written `?R` binder, so the clause relates requirement rows.
effect fn namesRowBinder(resolver: &mut Resolver, module: &ModuleId, subject: HirId, binders: &[Binder]) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, subject)
  if let Option<HeaderSyntax>.Some {value: written} = move syntax {
    if let Node.NamedType {path: named, hasMode, ..} = written.header {
      let parsed = run path(&mut resolver.*, module, named)
      let segments = List<Bytes>.asSlice(&parsed.segments)
      if hasMode || !parsed.valid || segments.length != usize.ONE { return false }
      let spelled = Bytes.asSlice(&segments[usize.ZERO])
      let mut at = usize.ZERO
      while at < binders.length {
        if let Binder.Row {name, ..} = &binders[at] {
          if same(Bytes.asSlice(&name), spelled) { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

effect fn declareProviders(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  written: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  constraints: &mut List<Constraint>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < written.length {
    let child = run typeChild(&mut resolver.*, module, written, at)
    if let Option<HirId>.Some {value: clause} = move child {
      let syntax = run typeNode(&mut resolver.*, module, clause)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        if let Node.ProviderConstraint {provider, selected, source} = value.header {
          let resolved = run resolveType(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            moduleOrdinal,
            provider,
            binders,
            &mut elision.*,
          )
          let providerType = match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return Option<Shared<Rejection>>.some(move error)
            }
          }
          let mut selector = Row.empty()
          let mut selectorFailed = Option<Shared<Rejection>>.none()
          // A declared selector may spell its key with the borrow it is drawn from, as in
          // `provides &ByteDuplex from &mut ByteDuplex`. Only the service-role key selects.
          let mut borrowedKey = false
          let selectorSyntax = run typeNode(&mut resolver.*, module, selected)
          if let Option<HeaderSyntax>.Some {value: operand} = move selectorSyntax {
            if let Node.ReferenceType {referent, lifetime, roleName, ..} = operand.header {
              if !lifetime.present {
                let keyed = run requireKey(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
                  referent, roleName, binders, &mut elision.*, &mut selector)
                if let Option<Option<Shared<Rejection>>>.Some {value: outcome} = move keyed {
                  borrowedKey = true
                  selectorFailed = move outcome
                }
              }
            }
          }
          if !borrowedKey {
            selectorFailed = run rowArgument(
              &mut resolver.*,
              &mut owner.*,
              &mut dependencies.*,
              moduleOrdinal,
              module,
              selected,
              b"provides",
              binders,
              &mut elision.*,
              true,
              &mut selector,
            )
          }
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selectorFailed {
            return Option<Shared<Rejection>>.some(move diagnostic)
          }
          let mut from = Row.empty()
          let sourceFailed = run rowArgument(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            moduleOrdinal,
            module,
            source,
            b"provides",
            binders,
            &mut elision.*,
            false,
            &mut from,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move sourceFailed {
            return Option<Shared<Rejection>>.some(move diagnostic)
          }
          run List<Constraint>.append(
            &mut constraints.*,
            Constraint.Provides {
              provider: move providerType,
              selector: run Shared<Row>.make(move selector),
              source: run Shared<Row>.make(move from),
            },
          )
        }
        // `where ?S in R` over a requirement-row binder selects a subset of requirement row `R`.
        if let Node.MembershipConstraint {subject, source} = value.header {
          if run namesRowBinder(&mut resolver.*, module, subject, binders) {
            let mut selectedRow = Row.empty()
            let selectedFailed = run rowArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
              subject, b"in", binders, &mut elision.*, false, &mut selectedRow)
            if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selectedFailed {
              return Option<Shared<Rejection>>.some(move diagnostic)
            }
            let mut sourceRow = Row.empty()
            let sourceRowFailed = run rowArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
              source, b"in", binders, &mut elision.*, false, &mut sourceRow)
            if let Option<Shared<Rejection>>.Some {value: diagnostic} = move sourceRowFailed {
              return Option<Shared<Rejection>>.some(move diagnostic)
            }
            run List<Constraint>.append(&mut constraints.*, Constraint.RequirementSubset {
              selected: run Shared<Row>.make(move selectedRow),
              source: run Shared<Row>.make(move sourceRow),
            })
            at = at + usize.ONE
            continue
          }
        }
        // `where S in E` selects a nonempty subset of a failure type (FAIL-005).
        if let Node.MembershipConstraint {subject, source} = value.header {
          let selected = match move run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, subject,
            binders, &mut elision.*) {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
          }
          let from = match move run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, source,
            binders, &mut elision.*) {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
          }
          run List<Constraint>.append(&mut constraints.*, Constraint.FailureSubset {selected: move selected, source: move from})
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

effect fn resolveConstraints(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  generics: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  isPublic: bool,
  phase: BoundPhase,
) -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut constraints = List<Constraint>.make()
  let mut at = usize.ZERO
  // Template binders are one-to-one with the written generic list.
  while at < generics.length && at < binders.length {
    let child = run typeChild(&mut resolver.*, module, generics, at)
    let mut bounds = Range.empty()
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        if let Node.TypeParameter {bounds: written, ..} = value.header {
          bounds = written
        }
        if let Node.LifetimeParameter {bounds: written, ..} = value.header {
          bounds = written
        }
      }
    }
    let mut boundAt = usize.ZERO
    while boundAt < bounds.length {
      let bound = run typeChild(&mut resolver.*, module, bounds, boundAt)
      if let Option<HirId>.Some {value: boundId} = move bound {
        let failed = run declareBound(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          &binders[at],
          boundId,
          binders,
          &mut elision.*,
          isPublic,
          phase,
          &mut constraints,
        )
        if let Option<Shared<Rejection>>.Some {value} = move failed {
          return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
        }
      }
      boundAt = boundAt + usize.ONE
    }
    at = at + usize.ONE
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move constraints)
}

// Resolve a declaration's written bounds again under one complete application. The abstract
// contract query validates their spelling; this pass gives proof concrete provider and contract
// arguments without building a second type-substitution language.
effect fn appliedDeclarationBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  declaration: usize,
  generics: Range,
  template: &[Binder],
  arguments: &[Argument],
  span: Span,
  isPublic: bool,
) -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let identity = run declarationAt(&mut resolver.*, &module, declaration)
  let declared = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: appliedDeclarationBounds")
    }
  }
  let applied = run bindArguments(template, arguments)
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.some(move declared),
    nextOrdinal: template.length,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.some(run copyArguments(arguments)),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.some(List<DeferredBounds>.make()),
  }
  let resolved = run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    &module,
    generics,
    List<Binder>.asSlice(&applied),
    &mut elision,
    isPublic,
    BoundPhase.Application,
  )
  let constraints = match move resolved {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return Result<List<Constraint>, Shared<Rejection>>.failResult(move error)
    }
  }
  // A bound may apply a declaration whose own bounds a sibling bound states, as `E: Extension<T>`
  // beside `T: Read` where `Extension` requires `T: Read`; the bounds are premises of each other.
  if let Option<Shared<Rejection>>.Some {value} = move run proveDeferredBounds(&mut resolver.*, &mut owner.*,
    &mut dependencies.*, &mut elision, &constraints) {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move constraints)
}

effect fn resolveContract(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess33 = declarationPosition(&resolver.*, key)
  let written = run scopedHeader(&mut resolver.*, &module, declarationAccess33)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let isPublic = match value.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.AliasHeader {isPublic, ..} => isPublic
      Node.RoleHeader {isPublic, ..} => isPublic
      _ => {
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        )
      }
    }
    // STRUCT-006: a C-layout record has one fixed C layout, so it declares no type parameters.
    if let Node.StructHeader {generics, abi, ..} = value.header {
      if abi.present && generics.length > usize.ZERO {
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.GenericCLayoutRecord, value.span),
          move dependencies,
        )
      }
    }
    let declarationAccess34 = declarationPosition(&resolver.*, key)
    let template = run templateBinders(&mut resolver.*, &module, declarationAccess34)
    let mut binders = match move template {
      Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    let declarationAccess35 = declarationPosition(&resolver.*, key)
    let incomplete = run completeAggregateBinders(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      declarationAccess35,
      value.span,
      &mut binders,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move incomplete {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let contractOwner = isContractHeader(value.header)
    if contractOwner {
      let none = List<Binder>.make()
      let conflict = run scopedBinderRejection(
        &mut resolver.*,
        &module,
        headerGenerics(value.header),
        List<Binder>.asSlice(&none),
        true,
        false,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
        return run memberRejected(move diagnostic, move dependencies)
      }
    }
    let mut lists = run parametersOf(List<Binder>.asSlice(&binders))
    let declarationAccess36 = declarationPosition(&resolver.*, key)
    let mut elision = LifetimeElision {
      owner: run declarationAt(&mut resolver.*, &module, declarationAccess36),
      nextOrdinal: List<Binder>.length(&binders),
      output: false,
      resultDefault: Option<Shared<Lifetime>>.none(),
      generated: List<Shared<Lifetime>>.make(),
      invocation: false,
      nested: false,
      renumber: List<usize>.make(),
      staticEnvironment: false,
      supplied: Option<List<Argument>>.none(),
      assumptions: Option<List<Constraint>>.none(),
      deferred: Option<List<DeferredBounds>>.some(List<DeferredBounds>.make()),
    }
    let declared = run resolveConstraints(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      headerGenerics(value.header),
      List<Binder>.asSlice(&binders),
      &mut elision,
      isPublic,
      BoundPhase.Authored,
    )
    let constraints = match move declared {
      Result<List<Constraint>, Shared<Rejection>>.Success {value: found} => move found
      Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    // The declaration's bounds are premises of each other's applied bounds.
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run proveDeferredBounds(&mut resolver.*, &mut owner.*,
      &mut dependencies, &mut elision, &constraints) {
      return run memberRejected(move diagnostic, move dependencies)
    }
    // An omitted lifetime in a bound belongs to this declaration just like an omitted field
    // lifetime. Keep it in the contract so applications can supply or elide it by ordinal.
    let generated = List<Shared<Lifetime>>.asSlice(&elision.generated)
    let mut generatedAt = usize.ZERO
    while generatedAt < generated.length {
      run List<Shared<Lifetime>>.append(
        &mut lists.lifetimes,
        Shared<Lifetime>.clone(&generated[generatedAt]),
      )
      generatedAt = generatedAt + usize.ONE
    }
    let mut provider = Option<Shared<Type>>.none()
    if contractOwner {
      let declarationAccess37 = declarationPosition(&resolver.*, key)
      let identity = run declarationAt(&mut resolver.*, &module, declarationAccess37)
      if let Option<DeclarationId>.Some {value: contract} = move identity {
        provider = Option<Shared<Type>>.some(
          run Types.intern(
            Type.Parameter {declaration: move contract, ordinal: List<Binder>.length(&binders)},
          ),
        )
      }
    }
    return memberSuccess(
      Value.Contract {
        contract: Contract {
          typeParameters: move lists.types,
          lifetimeParameters: move lists.lifetimes,
          rowParameters: move lists.rows,
          constraints: move constraints,
          provider: move provider,
        },
      },
      move dependencies,
    )
  }
  return run memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// The written name node of one generic binder, absent for damaged binder syntax.
fn binderNameId(parameter: Node) -> HirRef {
  return match parameter {
    Node.TypeParameter {name, ..} => HirRef.of(name)
    Node.RowParameter {name} => HirRef.of(name)
    Node.LifetimeParameter {name, ..} => HirRef.of(name)
    _ => HirRef.absent()
  }
}

// The kind of one written generic binder, as its enclosing-scope counterpart would record it.
fn writtenBinderKind(parameter: Node) -> GenericKind {
  return match parameter {
    Node.RowParameter {..} => GenericKind.Requirement
    Node.LifetimeParameter {..} => GenericKind.Lifetime
    _ => GenericKind.Type
  }
}

// Whether an enclosing binder with this spelling has exactly this kind.
fn restatesSameKind(enclosing: &[Binder], spelling: &[u8], kind: GenericKind) -> bool {
  let mut at = usize.ZERO
  while at < enclosing.length {
    if same(binderName(&enclosing[at]), spelling) {
      return binderKind(&enclosing[at]) == kind
    }
    at = at + usize.ONE
  }
  return false
}

// Rejects a written binder that reuses a spelling already bound around it. The implicit `Self`
// provider reserves its name. An inherent member may restate an owner binder of the same kind as a
// refinement; restating it with another kind would silently shadow it, so that is a duplicate.
// Restating an interface, service, or conformance binder has no settled meaning, so that form stays
// `Unsupported` rather than choosing shadowing or refinement.
effect fn scopedBinderRejection(
  resolver: &mut Resolver,
  module: &ModuleId,
  generics: Range,
  enclosing: &[Binder],
  reservesSelf: bool,
  refines: bool,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedRange(&mut resolver.*, module, generics)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < generics.length {
      let parameter = Module.child(hir, generics, at)
      let name = binderNameId(Module.node(hir, parameter))
      if name.present {
        if let Node.Name {text} = Module.node(hir, name.id) {
          let spelling = Module.text(hir, text)
          if reservesSelf && same(spelling, b"Self") {
            return Option<Shared<Rejection>>.some(
              run reject(
                &resolver.*,
                module,
                RejectionCode.DuplicateTypeParameter,
                Module.span(hir, parameter),
              ),
            )
          }
          if hasBinder(enclosing, spelling) {
            let written = writtenBinderKind(Module.node(hir, parameter))
            let mut code = RejectionCode.Unsupported
            if refines {
              code = RejectionCode.DuplicateTypeParameter
            }
            if !refines || !restatesSameKind(enclosing, spelling, written) {
              return Option<Shared<Rejection>>.some(
                run reject(&resolver.*, module, code, Module.span(hir, parameter)),
              )
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return Option<Shared<Rejection>>.none()
}

// The implicit `Self` provider of an interface or service, bound after its written binders.
effect fn selfBinder(owner: DeclarationId, writtenCount: usize) -> Binder
! OutOfMemoryError
? &mut Allocator | &mut Types {
  return Binder.Type {
    name: run Bytes.copy(b"Self"),
    value: run Types.intern(Type.Parameter {declaration: move owner, ordinal: writtenCount}),
  }
}

// The source spans of written binders and, in declaration order, of each written bound, with
// whether any type parameter bound names an interface or callable rather than a lifetime.
struct GenericAnchors {
  binders: List<Span>,
  bounds: List<Span>,
  typeBounded: bool,
}

effect fn genericAnchors(resolver: &mut Resolver, module: &ModuleId, ordinal: usize, generics: Range) -> GenericAnchors
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut anchors = GenericAnchors {binders: List<Span>.make(), bounds: List<Span>.make(), typeBounded: false}
  // `generics` lies in the declaration's written header.
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Written)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < generics.length {
      let parameter = Module.child(hir, generics, at)
      run List<Span>.append(&mut anchors.binders, Module.span(hir, parameter))
      let typeParameter = match Module.node(hir, parameter) { Node.TypeParameter {..} => true _ => false }
      let bounds = match Module.node(hir, parameter) {
        Node.TypeParameter {bounds: written, ..} => written
        Node.LifetimeParameter {bounds: written, ..} => written
        _ => Range.empty()
      }
      let mut boundAt = usize.ZERO
      while boundAt < bounds.length {
        let bound = Module.child(hir, bounds, boundAt)
        run List<Span>.append(&mut anchors.bounds, Module.span(hir, bound))
        if typeParameter {
          if let Node.Lifetime {..} = Module.node(hir, bound) {} else { anchors.typeBounded = true }
        }
        boundAt = boundAt + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return move anchors
}

fn headProvider(head: &ImplementationHead) -> Shared<Type> {
  return Shared<Type>.clone(&head.provider)
}

// `Self` inside an implementation denotes its applied provider.
effect fn providerBinder(provider: Shared<Type>) -> Binder ! OutOfMemoryError ? &mut Allocator {
  return Binder.Type {name: run Bytes.copy(b"Self"), value: move provider}
}

// Whether a nested declaration's enclosing scope is the body scope of `header`'s declaration.
fn bodyScopedHeader(header: Node) -> bool {
  return match header {
    Node.FunctionHeader {..} => true
    Node.CallableContract {..} => true
    Node.EffectExpression {..} => true
    _ => false
  }
}

fn isContractHeader(header: Node) -> bool {
  return match header {
    Node.InterfaceHeader {..} => true
    Node.ServiceHeader {..} => true
    _ => false
  }
}

// The binders visible around a nested declaration's own binders. An interface or service operation
// sees its contract's written binders followed by the implicit `Self` provider. An `impl` member
// sees the implementation's written binders and `Self` as the head's applied provider. A literal
// sees the whole scope of the function, callable or `effect` block it is written in. A top-level
// declaration sees none.
effect fn enclosingScope(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
) -> Result<List<Binder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut parent = usize.MAX
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Parent)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: enclosing} = &declarations[ordinal].parent {
        parent = enclosing
      }
    }
  }
  if parent == usize.MAX {
    return Result<List<Binder>, Shared<Rejection>>.succeed(List<Binder>.make())
  }
  let written = run scopedHeader(&mut resolver.*, module, parent)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ImplHeader {..} = value.header {
      let declarationAccess38Request = Key {
        family: Family.ImplementationHead,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: parent,
        member: usize.ZERO,
        external: false,
      }
      let declarationAccess38 = run internDeclaration(&mut resolver.*, declarationAccess38Request)
      let headKey = declarationAccess38
      let child = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        headKey,
        value.span,
      )
      let head = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
        &child,
        headOf,
      )
      if let Option<Shared<ImplementationHead>>.Some {value: found} = move head {
        let template = run templateBinders(&mut resolver.*, module, parent)
        let mut binders = match move template {
          Result<List<Binder>, Shared<Rejection>>.Success {value: listed} => move listed
          Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
            return Result<List<Binder>, Shared<Rejection>>.failResult(move error)
          }
        }
        // Lifetimes the heads leave unwritten are the implementation's own parameters after the
        // written ones (LIFE-003), such as the field lifetime of `impl Row` for a `Row` whose
        // field elides one.
        let written = writtenLifetimeCount(List<Binder>.asSlice(&binders))
        let lifetimes = Shared<ImplementationHead>.with<usize>(&found, fn(head: &ImplementationHead) -> usize {
          return List<Shared<Lifetime>>.length(&head.binders.lifetimeParameters)
        })
        let mut generatedAt = written
        while generatedAt < lifetimes {
          let generated = Shared<ImplementationHead>.with<Shared<Lifetime>>(&found, fn(head: &ImplementationHead) -> Shared<Lifetime> {
            return Shared<Lifetime>.clone(&List<Shared<Lifetime>>.asSlice(&head.binders.lifetimeParameters)[generatedAt])
          })
          run List<Binder>.append(&mut binders, Binder.Lifetime {name: Bytes.make(), value: move generated})
          generatedAt = generatedAt + usize.ONE
        }
        let provider = Shared<ImplementationHead>.with<Shared<Type>>(&found, headProvider)
        run List<Binder>.append(&mut binders, run providerBinder(move provider))
        return Result<List<Binder>, Shared<Rejection>>.succeed(move binders)
      }
      let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &child,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return Result<List<Binder>, Shared<Rejection>>.failResult(move diagnostic)
      }
      return Result<List<Binder>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, value.span),
      )
    }
    // A function's, callable's or `effect` block's scope is its body's; an `effect` block binds
    // nothing of its own, so a declaration nested in it sees the block's enclosing scope, however
    // deep the blocks nest.
    if bodyScopedHeader(value.header) {
      let scope = run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, parent)
      return match move scope {
        Result<BodyScope, Shared<Rejection>>.Success {value: scoped} => Result<List<Binder>, Shared<Rejection>>.succeed(move scoped.binders)
        Result<BodyScope, Shared<Rejection>>.Failure {error} => Result<List<Binder>, Shared<Rejection>>.failResult(move error)
      }
    }
    if !isContractHeader(value.header) {
      return Result<List<Binder>, Shared<Rejection>>.succeed(List<Binder>.make())
    }
  }
  let template = run templateBinders(&mut resolver.*, module, parent)
  let mut binders = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result<List<Binder>, Shared<Rejection>>.failResult(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, module, parent)
  if let Option<DeclarationId>.Some {value: contract} = move identity {
    let count = List<Binder>.length(&binders)
    run List<Binder>.append(&mut binders, run selfBinder(move contract, count))
  }
  return Result<List<Binder>, Shared<Rejection>>.succeed(move binders)
}

// Whether a declaration is a member of an inherent `impl`, whose owner binders it may refine.
effect fn refinesEnclosing(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Parent)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
        let hir = IndexedSource.authored(value)
        return isImplementationHeader(hir, &declarations[parent]) && !isConformanceHeader(
          hir,
          &declarations[parent],
        )
      }
    }
  }
  return false
}

// The enclosing binder that an own binder restates with the same spelling and kind, if refinable.
effect fn restatedBinder(binders: &List<Binder>, at: usize, visible: &[Binder], refines: bool) -> Option<
  Binder,
> ! OutOfMemoryError ? &mut Allocator {
  if !refines {
    return Option<Binder>.none()
  }
  let current = List<Binder>.asSlice(binders)
  let mut index = usize.ZERO
  while index < visible.length {
    if same(binderName(&visible[index]), binderName(&current[at])) && binderKind(&visible[index]) == binderKind(
      &current[at],
    ) {
      return Option<Binder>.some(run copyBinder(&visible[index]))
    }
    index = index + usize.ONE
  }
  return Option<Binder>.none()
}

effect fn binderAt(binders: &List<Binder>, at: usize) -> Binder
! OutOfMemoryError
? &mut Allocator {
  let current = List<Binder>.asSlice(binders)
  return run copyBinder(&current[at])
}

// The identity of the declaration directly enclosing `ordinal`, if any.
effect fn enclosingIdentity(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  DeclarationId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut parent = usize.MAX
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Parent)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: enclosing} = &declarations[ordinal].parent {
        parent = enclosing
      }
    }
  }
  if parent == usize.MAX {
    return Option<DeclarationId>.none()
  }
  return run declarationAt(&mut resolver.*, module, parent)
}

effect fn collectConstraint(
  constraint: &Constraint,
  owner: &DeclarationId,
  types: &mut List<usize>,
  regions: &mut List<usize>,
  rows: &mut List<usize>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  match & constraint.* {
    Constraint.Conforms {provider, contract} => {
      run Type.collectOwned(&provider, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwned(&contract, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Represents {parameter, contract} => {
      run Type.collectOwned(&parameter, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwned(&contract, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Contents {subject, region} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwnedLifetime(&region, owner, &mut regions.*)
    }
    Constraint.Outlives {longer, shorter} => {
      run Type.collectOwnedLifetime(&longer, owner, &mut regions.*)
      run Type.collectOwnedLifetime(&shorter, owner, &mut regions.*)
    }
    Constraint.Copyable {subject} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.ThreadSafe {subject, ..} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Property {subject, ..} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Provides {provider, selector, source} => {
      run Type.collectOwned(&provider, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwnedRow(&selector, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwnedRow(&source, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.FailureSubset {selected, source} => {
      run Type.collectOwned(&selected, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwned(&source, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.RequirementSubset {selected, source} => {
      run Type.collectOwnedRow(&selected, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwnedRow(&source, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
  }
  return ()
}

// The ordinals in ascending order, so owner binders keep their declaration order.
effect fn sortedOrdinals(values: &List<usize>) -> List<usize>
! OutOfMemoryError
? &mut Allocator {
  let mut sorted = List<usize>.make()
  let source = List<usize>.asSlice(values)
  let mut at = usize.ZERO
  while at < source.length {
    run List<usize>.append(&mut sorted, source[at])
    let mut position = List<usize>.length(&sorted) - usize.ONE
    while position > usize.ZERO && List<usize>.get(&sorted, position - usize.ONE) > List<
      usize,
    >.get(&sorted, position) {
      let earlier = List<usize>.get(&sorted, position - usize.ONE)
      let later = List<usize>.get(&sorted, position)
      List<usize>.set(&mut sorted, position - usize.ONE, later)
      List<usize>.set(&mut sorted, position, earlier)
      position = position - usize.ONE
    }
    at = at + usize.ONE
  }
  return move sorted
}

fn enclosedBy(declaration: &IndexedDeclaration, parent: usize) -> bool {
  return match & declaration.parent {
    Option<usize>.Some {value} => value == parent
    Option<usize>.None => false
  }
}

fn writesBody(hir: &Module, declaration: HirId) -> bool {
  if let Node.Declaration {body, ..} = Module.node(hir, declaration) {
    if let Node.CallableBody {block} = Module.node(hir, body) {
      return block.present
    }
  }
  return false
}

// Whether every parameter of a callable contract is taken by value.
fn allValueParameters(hir: &Module, parameters: Range) -> bool {
  let mut parameterAt = usize.ZERO
  while parameterAt < parameters.length {
    let parameter = Module.child(hir, parameters, parameterAt)
    if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
      if mode != ParameterMode.Value {
        return false
      }
    }
    parameterAt = parameterAt + usize.ONE
  }
  return true
}

// Whether `identity` is spelled as the interface operation `requested` binds to (OP-009).
fn bindsSpelling(requested: &Operator.Spelling, identity: &DeclarationId) -> bool {
  return DeclarationId.withSpelling<bool>(identity, fn(name: &[u8]) -> bool { return Operator.bindsOperation(requested, name) })
}

// Whether the operation an operator binds to (OP-009) takes every parameter by value, so operator
// syntax supplies them without an adaptation; `None` when `operation` is not that operation.
effect fn operationMarks(
  resolver: &mut Resolver,
  siteModule: &ModuleId,
  module: &ModuleId,
  operation: &Shared<DeclarationId>,
  requested: &Operator.Spelling,
) -> Option<bool>
  ! Cycle | InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
  let named = Shared<DeclarationId>.with<bool>(
    operation,
    fn(identity: &DeclarationId) -> bool {
      return bindsSpelling(requested, identity)
    }
  )
  if
    !named {
    return Option<bool>.none()
  }
  let sealedModule = canonicalModule(
    &resolver.*,
    run PackageGraph.target(&resolver.packages, siteModule, SealedOperators.path())
  )
  if
    !ModuleId.equals(module, &sealedModule) {
    return Option<bool>.none()
  }
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {
    value: indexed
  } = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(indexed)
    let found = Shared<
      DeclarationId
    >.with<Option<usize>>(
      operation,
      fn(identity: &DeclarationId) -> Option<usize> {
        return ModuleIndex.ordinalOf(index, identity)
      },
    )
    if let Option<usize>.Some { value: at } = move found {
      let declarations = ModuleIndex.listDeclarations(index)
      let hir = IndexedSource.authored(indexed)
      if let Node.OperationHeader { contract, .. } = Module.node(hir, declarations[at].header) {
        if let Node.CallableContract { parameters, .. } = Module.node(hir, contract) {
          return Option<bool>.some(allValueParameters(hir, parameters))
        }
      }
    }
  }
  return Option<bool>.none()
}

// The public spelling of a contract member that declares an operation, or `None` when the member
// is not an operation without its own visibility modifier. A body is the operation's default.
effect fn writtenOperationName(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  isInterface: bool,
  declaration: &IndexedDeclaration,
) -> Result<Option<Bytes>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if let Node.OperationHeader {name, isPublic, ..} = Module.node(
    hir,
    declaration.header,
  ) {
    if !isPublic {
      if let Node.Name {text} = Module.node(hir, name) {
        return Result<Option<Bytes>, Shared<Rejection>>.succeed(
          Option<Bytes>.some(run Bytes.copy(Module.text(hir, text))),
        )
      }
    }
  }
  return Result<Option<Bytes>, Shared<Rejection>>.succeed(Option<Bytes>.none())
}

fn listsName(names: &[Bytes], candidate: &[u8]) -> bool {
  let mut before = usize.ZERO
  while before < names.length {
    if same(Bytes.asSlice(&names[before]), candidate) {
      return true
    }
    before = before + usize.ONE
  }
  return false
}

// Adds one contract member to the operation list, or reports why it cannot be an operation.
effect fn recordOperation(
  resolver: &Resolver,
  module: &ModuleId,
  hir: &Module,
  isInterface: bool,
  declaration: &IndexedDeclaration,
  names: &mut List<Bytes>,
  operations: &mut List<Shared<DeclarationId>>,
  defaults: &mut List<bool>,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let span = Module.span(hir, declaration.header)
  let attempt = run writtenOperationName(&resolver.*, module, hir, isInterface, declaration)
  let spelling = match move attempt {
    Result<Option<Bytes>, Shared<Rejection>>.Success {value: written} => move written
    Result<Option<Bytes>, Shared<Rejection>>.Failure {error} => {
      return Option<Shared<Rejection>>.some(move error)
    }
  }
  let operation = match move spelling {
    Option<Bytes>.Some {value: written} => move written
    Option<Bytes>.None => {
      return Option<Shared<Rejection>>.some(
        run reject(&resolver.*, module, RejectionCode.InvalidContractMember, span),
      )
    }
  }
  if listsName(List<Bytes>.asSlice(&names.*), Bytes.asSlice(&operation)) {
    return Option<Shared<Rejection>>.some(
      run reject(&resolver.*, module, RejectionCode.DuplicateDeclarationName, span),
    )
  }
  run List<Bytes>.append(&mut names.*, move operation)
  run List<Shared<DeclarationId>>.append(
    &mut operations.*,
    run Shared<DeclarationId>.make(DeclarationId.copy(&declaration.identity)),
  )
  run List<bool>.append(&mut defaults.*, writesBody(hir, declaration.local))
  return Option<Shared<Rejection>>.none()
}

effect fn resolveOperations(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = resolvedModule(&resolver.*, key.module)
  let dependencies = List<Dependency>.make()
  let sourcePosition = declarationPosition(&resolver.*, key)
  let answer = run observedDeclaration(&mut resolver.*, &module, sourcePosition, SourceFacet.Operations)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let declarationAccess39 = declarationPosition(&resolver.*, key)
    if declarationAccess39 < declarations.length {
      let hir = IndexedSource.authored(value)
      let declarationAccess40 = declarationPosition(&resolver.*, key)
      let contractHeader = declarations[declarationAccess40].header
      let enclosing = Module.node(hir, contractHeader)
      if !isContractHeader(enclosing) {
        return run memberRejected(
          run reject(
            &resolver.*,
            &module,
            RejectionCode.Unsupported,
            Module.span(hir, contractHeader),
          ),
          move dependencies,
        )
      }
      let isInterface = match enclosing {
        Node.InterfaceHeader {..} => true
        _ => false
      }
      let mut operations = List<Shared<DeclarationId>>.make()
      let mut defaults = List<bool>.make()
      let mut names = List<Bytes>.make()
      let index = IndexedSource.moduleIndex(value)
      let declarationAccess41 = declarationPosition(&resolver.*, key)
      let mut at = ModuleIndex.firstEnclosed(index, declarationAccess41)
      while at != usize.MAX {
        let declarationAccess42 = declarationPosition(&resolver.*, key)
        if enclosedBy(&declarations[at], declarationAccess42) {
          let refusal = run recordOperation(
            &resolver.*,
            &module,
            hir,
            isInterface,
            &declarations[at],
            &mut names,
            &mut operations,
            &mut defaults,
          )
          if let Option<Shared<Rejection>>.Some {value: refused} = move refusal {
            return run memberRejected(move refused, move dependencies)
          }
        }
        at = ModuleIndex.nextEnclosed(index, at)
      }
      return memberSuccess(Value.Operations {operations: move operations, defaults: move defaults}, move dependencies)
    }
  }
  return run memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// The one operation or function named `name` directly inside the declaration at `parent`; a
// repeated name has no winner and yields the later declaration's span instead.
struct MemberLookup {
  ordinal: Option<usize>,
  repeated: Option<Span>,
}

// Whether the operation or function header of `declaration` is written as `name`.
fn namesMember(hir: &Module, declaration: &IndexedDeclaration, name: &[u8]) -> bool {
  let written = match Module.node(hir, declaration.header) {
    Node.OperationHeader {name: spelled, ..} => HirRef.of(spelled)
    Node.FunctionHeader {name: spelled, ..} => HirRef.of(spelled)
    _ => HirRef.absent()
  }
  if !written.present {
    return false
  }
  if let Node.Name {text} = Module.node(hir, written.id) {
    return same(Module.text(hir, text), name)
  }
  return false
}

effect fn memberOrdinal(resolver: &mut Resolver, module: &ModuleId, parent: usize, name: &[u8]) -> MemberLookup
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut found = Option<usize>.none()
  let answer = run observedDeclaration(&mut resolver.*, module, parent, SourceFacet.Operations)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(value)
    let mut at = ModuleIndex.firstEnclosed(index, parent)
    while at != usize.MAX {
      if enclosedBy(&declarations[at], parent) && namesMember(hir, &declarations[at], name) {
        if let Option<usize>.Some {..} = &found {
          return MemberLookup {
            ordinal: Option<usize>.none(),
            repeated: Option<Span>.some(Module.span(hir, declarations[at].header)),
          }
        }
        found = Option<usize>.some(at)
      }
      at = ModuleIndex.nextEnclosed(index, at)
    }
  }
  return MemberLookup {ordinal: move found, repeated: Option<Span>.none()}
}

// The written name of the member declared at `ordinal`.
effect fn memberNameSite(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<Span>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Header)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      return match Module.node(hir, declarations[ordinal].header) {
        Node.OperationHeader {name, ..} => Option<Span>.some(Module.span(hir, name))
        Node.FunctionHeader {name, ..} => Option<Span>.some(Module.span(hir, name))
        _ => Option<Span>.none()
      }
    }
  }
  return Option<Span>.none()
}

// What an owner's inherent member list says about one member name.
struct InherentLookup {
  published: Option<Shared<DeclarationId>>,
  rejected: Option<Shared<Rejection>>,
}

fn inherentLookup(answer: &Result<Answer, NoRejection>, member: &[u8]) -> InherentLookup {
  let mut lookup = InherentLookup {
    published: Option<Shared<DeclarationId>>.none(),
    rejected: Option<Shared<Rejection>>.none(),
  }
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.InherentMembers {members, rejected}} = &value.outcome {
      let listed = List<Shared<DeclarationId>>.asSlice(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<DeclarationId>.with<bool>(
          &listed[at],
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.named(declaration, member)
          },
        ) {
          lookup.published = Option<Shared<DeclarationId>>.some(
            Shared<DeclarationId>.clone(&listed[at]),
          )
        }
        at = at + usize.ONE
      }
      let refused = List<RejectedMember>.asSlice(&rejected)
      at = usize.ZERO
      while at < refused.length {
        if Shared<DeclarationId>.with<bool>(
          &refused[at].declaration,
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.named(declaration, member)
          },
        ) {
          lookup.rejected = Option<Shared<Rejection>>.some(
            Shared<Rejection>.clone(&refused[at].rejection),
          )
        }
        at = at + usize.ONE
      }
    }
  }
  return move lookup
}

// The index ordinal of a declaration identity in the held source of `module`.
effect fn ordinalOfIdentity(
  resolver: &mut Resolver,
  module: &ModuleId,
  identity: &Shared<DeclarationId>,
) -> Option<usize> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedSource(&mut resolver.*, module, SourceSelector.Identity {identity: DeclarationId.copyShared(identity)})
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    return Shared<DeclarationId>.with<Option<usize>>(
      identity,
      fn(declaration: &DeclarationId) -> Option<usize> {
        return ModuleIndex.ordinalOf(index, declaration)
      },
    )
  }
  return Option<usize>.none()
}

effect fn locationOfInstance(resolver: &mut Resolver, instance: &InstanceKey) -> Option<
  InstanceLocation,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let identity = InstanceKey.identity(instance)
  // Glue owned by a sealed core has no source declaration. Backend keys of glue are identified by
  // their content, so its location only anchors query bookkeeping to an indexed module.
  if let Option<Shared<Type>>.Some {..} = move InstanceKey.glueType(instance) {
    let sealed = Shared<DeclarationId>.with<Option<SealedKind>>(&identity, SealedCore.declarationCore)
    if let Option<SealedKind>.Some {..} = move sealed {
      if List<ModuleId>.length(&resolver.modules) == usize.ZERO { return Option<InstanceLocation>.none() }
      return Option<InstanceLocation>.some(InstanceLocation {module: usize.ZERO, declaration: usize.MAX})
    }
  }
  return run locationOfIdentity(&mut resolver.*, &identity)
}

// The held module and index ordinal of one canonical declaration, if this store has interned it.
effect fn locationOfIdentity(resolver: &mut Resolver, identity: &Shared<DeclarationId>) -> Option<
  InstanceLocation,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let moduleIndex = identityModuleOrdinal(&resolver.*, identity)
  if moduleIndex == usize.MAX {
    return Option<InstanceLocation>.none()
  }
  let module = resolvedModule(&resolver.*, moduleIndex)
  let found = run ordinalOfIdentity(&mut resolver.*, &module, identity)
  if let Option<usize>.Some {value} = move found {
    return Option<InstanceLocation>.some(InstanceLocation {module: moduleIndex, declaration: value})
  }
  return Option<InstanceLocation>.none()
}

// The index ordinal of the nominal declaration a provider type applies, in the held `module`.
effect fn ordinalOfProvider(resolver: &mut Resolver, module: &ModuleId, provider: &Shared<Type>) -> Option<
  usize,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let named = Shared<Type>.with<Option<DeclarationId>>(provider, fn(applied: &Type) -> Option<DeclarationId> {
    return match &applied.* { Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration)) _ => Option<DeclarationId>.none() }
  })
  let identity = match move named { Option<DeclarationId>.Some {value} => move value _ => { return Option<usize>.none() } }
  let answer = run observedSource(&mut resolver.*, module, SourceSelector.Identity {identity: move identity})
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    return Shared<Type>.with<Option<usize>>(
      provider,
      fn(applied: &Type) -> Option<usize> {
        return match & applied.* {
          Type.Nominal {declaration, ..} => ModuleIndex.ordinalOf(index, &declaration)
          _ => Option<usize>.none()
        }
      },
    )
  }
  return Option<usize>.none()
}

// Whether a member identity is published by an owner's inherent member list, or the kept
// rejection that replaces it.
struct MemberVerdict {
  published: bool,
  rejected: Option<Shared<Rejection>>,
}

fn memberVerdict(answer: &Result<Answer, NoRejection>, member: &DeclarationId) -> MemberVerdict {
  let mut verdict = MemberVerdict {published: false, rejected: Option<Shared<Rejection>>.none()}
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.InherentMembers {members, rejected}} = &value.outcome {
      let listed = List<Shared<DeclarationId>>.asSlice(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<DeclarationId>.with<bool>(
          &listed[at],
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.equals(declaration, member)
          },
        ) {
          verdict.published = true
        }
        at = at + usize.ONE
      }
      let refused = List<RejectedMember>.asSlice(&rejected)
      at = usize.ZERO
      while at < refused.length {
        if Shared<DeclarationId>.with<bool>(
          &refused[at].declaration,
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.equals(declaration, member)
          },
        ) {
          verdict.rejected = Option<Shared<Rejection>>.some(
            Shared<Rejection>.clone(&refused[at].rejection),
          )
        }
        at = at + usize.ONE
      }
    }
  }
  return move verdict
}

// Where a declaration sits: its enclosing declaration and, for a member, its written name.
struct MemberPlace {
  parent: usize,
  contract: bool,
  implementation: bool,
  inherent: bool,
  name: Option<Bytes>,
}

effect fn memberPlace(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> MemberPlace
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut place = MemberPlace {
    parent: usize.MAX,
    contract: false,
    implementation: false,
    inherent: false,
    name: Option<Bytes>.none(),
  }
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Parent)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
        place.parent = parent
        place.contract = isContractHeader(Module.node(hir, declarations[parent].header))
        place.implementation = isImplementationHeader(hir, &declarations[parent])
        place.inherent = place.implementation && !isConformanceHeader(hir, &declarations[parent])
      }
      let written = match Module.node(hir, declarations[ordinal].header) {
        Node.OperationHeader {name: spelled, ..} => HirRef.of(spelled)
        Node.FunctionHeader {name: spelled, ..} => HirRef.of(spelled)
        _ => HirRef.absent()
      }
      if written.present {
        if let Node.Name {text} = Module.node(hir, written.id) {
          place.name = Option<Bytes>.some(run Bytes.copy(Module.text(hir, text)))
        }
      }
    }
  }
  return move place
}

// G3: the one path from a function or operation declaration to its Signature answer. It applies
// the same gates as the name lookups: a contract's operation list must resolve, an `impl` member's
// name must be written once in its block, and an inherent member must be published by its owner.
effect fn memberSignature(
  resolver: &mut Resolver,
  query: &mut Query<Answer, NoRejection>,
  module: &ModuleId,
  ordinal: usize,
  anchor: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let place = run memberPlace(&mut resolver.*, module, ordinal)
  if place.contract {
    let declarationAccess43Request = Key {
      family: Family.Operations,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: place.parent,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess43 = run internDeclaration(&mut resolver.*, declarationAccess43Request)
    let operationsKey = declarationAccess43
    let listed = run demandRaw(&mut resolver.*, &mut query.*, operationsKey, anchor)
    if Shared<Result<Answer, NoRejection>>.with<bool>(&listed, hasRejection) {
      return move listed
    }
  }
  if place.implementation {
    if let Option<Bytes>.Some {value: name} = &place.name {
      let lookup = run memberOrdinal(&mut resolver.*, module, place.parent, Bytes.asSlice(&name))
      if let Option<Span>.Some {value: span} = move lookup.repeated {
        // Each declaration of a repeated inherent member name reports SEM0196 at its own name.
        let mut code = RejectionCode.DuplicateConformanceMember
        let mut site = span
        if place.inherent {
          code = RejectionCode.DuplicateInherentMember
          if let Option<Span>.Some {value: named} = move run memberNameSite(&mut resolver.*, module, ordinal) { site = named }
        }
        let mut diagnostic = run makeRejection(code, module, site)
        // A conformance member defined twice names the member, the contract and the provider (SEM0083).
        if !place.inherent {
          let headKey = run internDeclaration(&mut resolver.*, Key {family: Family.ImplementationHead, module: moduleOrdinal,
            name: usize.ZERO, declaration: place.parent, member: usize.ZERO, external: false})
          let head = run demandRaw(&mut resolver.*, &mut query.*, headKey, anchor)
          diagnostic.arguments = run detailArguments(run duplicateMemberDetail(module, &head, Bytes.asSlice(&name)))
        }
        return run rootRejection(&mut resolver.*, module, run Shared<Rejection>.make(move diagnostic))
      }
    }
    if place.inherent {
      let refusal = run inherentMemberRefusal(
        &mut resolver.*,
        &mut query.*,
        module,
        place.parent,
        ordinal,
      )
      if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: refused} = move refusal {
        return move refused
      }
    }
  }
  let declarationAccess44Request = Key {
    family: Family.Signature,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ordinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess44 = run internDeclaration(&mut resolver.*, declarationAccess44Request)
  let key = declarationAccess44
  return run demandRaw(&mut resolver.*, &mut query.*, key, anchor)
}

// Reuses normal arm selection and retains the actual walked condition roots for publication.
// This gate runs on every identity request, before accessing an ordinary cached answer.
effect fn requestAvailability(
  resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, request: &mut Request,
  module: &ModuleId, ordinal: usize, span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let selected = run available(&mut resolver.*, &mut query.*, &mut dependencies, module, ordinal, span)
  let walked = List<Dependency>.asSlice(&dependencies)
  let mut at = usize.ZERO
  while at < walked.length {
    let edge = walked[at]
    if edge.family == Family.Condition {
      let conditionModule = resolvedModule(&resolver.*, edge.module)
      let position = DeclarationTable.position(&resolver.declarations, edge.declaration)
      let found = run declarationAt(&mut resolver.*, &conditionModule, position)
      if let Option<DeclarationId>.Some {value: condition} = move found {
        let conditionKey = Key {
          family: Family.Condition, module: edge.module, name: usize.ZERO,
          declaration: edge.declaration, member: usize.ZERO, external: false,
        }
        let answer = run demandRaw(&mut resolver.*, &mut query.*, conditionKey, span)
        let spelled = run DeclarationId.copySpelling(&condition)
        run recordRoot(&mut request.*, Family.Condition, &conditionModule, Bytes.asSlice(&spelled), &answer)
      }
    }
    at = at + usize.ONE
  }
  return move selected
}

// The canonical request gate shared by identity Signature and ordinary Body requests.
effect fn requestMemberSignature(
  resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, request: &mut Request,
  module: &ModuleId, ordinal: usize, span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let active = run requestAvailability(&mut resolver.*, &mut query.*, &mut request.*, module, ordinal, span)
  match move active {
    Result<bool, Shared<Rejection>>.Failure {error} => {
      return run rootRejection(&mut resolver.*, module, move error)
    }
    Result<bool, Shared<Rejection>>.Success {value} => {
      if !value { return run rejectAbsent(&mut resolver.*, module, span, RejectionCode.IdentityUnavailable) }
    }
  }
  return run memberSignature(&mut resolver.*, &mut query.*, module, ordinal, span)
}

effect fn requestMemberBody(
  resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, request: &mut Request,
  module: &ModuleId, ordinal: usize, span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let signature = run requestMemberSignature(&mut resolver.*, &mut query.*, &mut request.*, module, ordinal, span)
  let typed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult)
  if let Option<Shared<Type>>.Some {value} = move typed {
    drop value
    let moduleOrdinal = run internModule(&mut resolver.*, module)
    let declarationAccess46Request = Key {
      family: Family.Body, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    }
    let declarationAccess46 = run internDeclaration(&mut resolver.*, declarationAccess46Request)
    return run demandRaw(&mut resolver.*, &mut query.*, declarationAccess46, span)
  }
  return move signature
}

// For a member of an inherent `impl`, the rejecting answer that owner-wide uniqueness or the head
// gives instead of its signature; `None` when the owner publishes the member.
effect fn inherentMemberRefusal(
  resolver: &mut Resolver,
  query: &mut Query<Answer, NoRejection>,
  module: &ModuleId,
  implementation: usize,
  member: usize,
) -> Option<Shared<Result<Answer, NoRejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let declarationAccess47Request = Key {
    family: Family.ImplementationHead,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: implementation,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess47 = run internDeclaration(&mut resolver.*, declarationAccess47Request)
  let headKey = declarationAccess47
  let head = run demandRaw(
    &mut resolver.*,
    &mut query.*,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    &head,
    headOf,
  )
  let found = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Option<Shared<Result<Answer, NoRejection>>>.some(move head)
    }
  }
  let provider = Shared<ImplementationHead>.with<Shared<Type>>(&found, headProvider)
  let located = run ordinalOfProvider(&mut resolver.*, module, &provider)
  let ownerOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: inherentMemberRefusal")
    }
  }
  let declarationAccess48Request = Key {
    family: Family.InherentMembers,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ownerOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess48 = run internDeclaration(&mut resolver.*, declarationAccess48Request)
  let membersKey = declarationAccess48
  let listed = run demandRaw(
    &mut resolver.*,
    &mut query.*,
    membersKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  if Shared<Result<Answer, NoRejection>>.with<bool>(&listed, hasRejection) {
    return Option<Shared<Result<Answer, NoRejection>>>.some(move listed)
  }
  let identity = run declarationAt(&mut resolver.*, module, member)
  if let Option<DeclarationId>.Some {value: declared} = move identity {
    let verdict = Shared<Result<Answer, NoRejection>>.with<MemberVerdict>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> MemberVerdict {
        return memberVerdict(answer, &declared)
      },
    )
    if verdict.published {
      return Option<Shared<Result<Answer, NoRejection>>>.none()
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move verdict.rejected {
      return Option<Shared<Result<Answer, NoRejection>>>.some(
        run rootRejection(&mut resolver.*, module, move diagnostic),
      )
    }
  }
  // A member whose name did not parse, as in `fn run(...)` with a reserved word, is no candidate
  // of its owner: the parser reports its header (PAR0001), as for a free function.
  let written = run inherentCandidates(&mut resolver.*, module, implementation)
  let candidates = List<InherentCandidate>.asSlice(&written)
  let mut at = usize.ZERO
  while at < candidates.length {
    if candidates[at].ordinal == member {
      return CompilerBug.panic(b"MissingRetainedFact: inherentMemberRefusal")
    }
    at = at + usize.ONE
  }
  return Option<Shared<Result<Answer, NoRejection>>>.none()
}

// The ordinal of the `occurrence`th top-level `impl` declaration of a module.
effect fn implementationOrdinal(resolver: &mut Resolver, module: &ModuleId, occurrence: usize) -> Option<
  usize,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(value)
    let mut seen = usize.ZERO
    let mut at = ModuleIndex.firstEnclosed(index, usize.MAX)
    while at != usize.MAX {
      if isImplementationHeader(hir, &declarations[at]) && topLevel(&declarations[at]) {
        if seen == occurrence {
          return Option<usize>.some(at)
        }
        seen = seen + usize.ONE
      }
      at = ModuleIndex.nextEnclosed(index, at)
    }
  }
  return Option<usize>.none()
}

// A root answer for a member the held revision does not contain.
effect fn rejectAbsent(resolver: &mut Resolver, module: &ModuleId, span: Span, code: RejectionCode) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let diagnostic = run reject(&resolver.*, module, code, span)
  return run rootRejection(&mut resolver.*, module, move diagnostic)
}

// A root answer that rejects with `diagnostic` while observing the module's current source.
effect fn rootRejection(resolver: &mut Resolver, module: &ModuleId, diagnostic: Shared<Rejection>) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  return run Shared<Result<Answer, NoRejection>>.make(
    Result<Answer, NoRejection>.succeed(
      Answer {
        outcome: run rejectedOutcome(move diagnostic),
        dependencies: List<Dependency>.make(),
      },
    ),
  )
}

// A bound written as `Intrinsic.Member`, and the sealed property it names when it names one.
struct IntrinsicBound {
  named: bool,
  property: Option<IntrinsicProperty>,
}

// INTR-001: `Intrinsic` is the sealed compiler namespace. It needs no import and no module binding
// can shadow it, so a two-segment path starting with it never reaches module lookup.
effect fn intrinsicBound(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> IntrinsicBound
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut found = IntrinsicBound {named: false, property: Option<IntrinsicProperty>.none()}
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: typeName, hasMode, ..} = value.header {
      if !hasMode {
        let parsed = run path(&mut resolver.*, module, typeName)
        let segments = List<Bytes>.asSlice(&parsed.segments)
        if parsed.valid && segments.length == 2 && same(
          Bytes.asSlice(&segments[usize.ZERO]),
          b"Intrinsic",
        ) {
          found.named = true
          let member = Bytes.asSlice(&segments[usize.ONE])
          if same(member, b"Detached") {
            found.property = Option<IntrinsicProperty>.some(IntrinsicProperty.Detached)
          }
          if same(member, b"NonParking") {
            found.property = Option<IntrinsicProperty>.some(IntrinsicProperty.NonParking)
          }
        }
      }
    }
  }
  return move found
}

// The sealed property a written `Intrinsic.Copy`, `Intrinsic.Drop`, `Intrinsic.Transferable` or
// `Intrinsic.Concurrent` names (INTR-006, THREAD-001). The bare names are ordinary, such as the
// `silk.ownership` and `silk.thread` aliases.
effect fn sealedPropertyName(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Option<SealedProperty>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: typeName, hasMode, ..} = value.header {
      if !hasMode {
        let parsed = run path(&mut resolver.*, module, typeName)
        let segments = List<Bytes>.asSlice(&parsed.segments)
        if parsed.valid && segments.length == 2 && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") {
          return propertyNamed(Bytes.asSlice(&segments[usize.ONE]))
        }
      }
    }
  }
  return Option<SealedProperty>.none()
}

fn propertyNamed(name: &[u8]) -> Option<SealedProperty> {
  if same(name, b"Copy") {
    return Option<SealedProperty>.some(SealedProperty.Copy)
  }
  if same(name, b"Drop") {
    return Option<SealedProperty>.some(SealedProperty.Drop)
  }
  if same(name, b"Transferable") {
    return Option<SealedProperty>.some(SealedProperty.Transferable)
  }
  if same(name, b"Concurrent") {
    return Option<SealedProperty>.some(SealedProperty.Concurrent)
  }
  return Option<SealedProperty>.none()
}

// The sealed property a bound or `impl` head names, directly or through a transparent alias whose
// target is one (TYPE-004). A name that selects anything else is left to ordinary type resolution.
effect fn sealedProperty(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  binders: &[Binder],
) -> Option<SealedProperty>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let direct = run sealedPropertyName(&mut resolver.*, module, id)
  if let Option<SealedProperty>.Some {..} = &direct {
    return move direct
  }
  let syntax = run typeNode(&mut resolver.*, module, id)
  let mut typeName = HirRef.absent()
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      if !hasMode {
        typeName = HirRef.of(written)
      }
    }
  }
  if !typeName.present {
    return Option<SealedProperty>.none()
  }
  let parsed = run path(&mut resolver.*, module, typeName.id)
  let segments = List<Bytes>.asSlice(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 || hasBinder(binders, Bytes.asSlice(
    &segments[usize.ZERO],
  )) {
    return Option<SealedProperty>.none()
  }
  // `ownership.Copy` reaches an alias through a module namespace, as any qualified type does.
  if segments.length == 2 {
    let qualified = run qualifiedTypeDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
      module, segments, parsed.span)
    return run selectionProperty(&mut resolver.*, &mut owner.*, &mut dependencies.*, move qualified, parsed.span)
  }
  let selection = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
    Bytes.asSlice(&segments[usize.ZERO]), false, parsed.span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  return run selectionProperty(&mut resolver.*, &mut owner.*, &mut dependencies.*, move selection, parsed.span)
}

// The sealed property one selected declaration names when it is an alias of one.
effect fn selectionProperty(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  selection: Result<SelectedDeclaration, Shared<Rejection>>,
  span: Span,
) -> Option<SealedProperty>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = match move selection {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {..} => {
      return Option<SealedProperty>.none()
    }
  }
  let targetModule = resolvedModule(&resolver.*, selected.module)
  let written = run scopedHeader(&mut resolver.*, &targetModule, selected.ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.AliasHeader {..} = value.header {
      let declarationAccess49Request = Key {
        family: Family.Alias,
        module: selected.module,
        name: usize.ZERO,
        declaration: selected.ordinal,
        member: usize.ZERO,
        external: false,
      }
      let declarationAccess49 = run internDeclaration(&mut resolver.*, declarationAccess49Request)
      let key = declarationAccess49
      let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
      return Shared<Result<Answer, NoRejection>>.with<Option<SealedProperty>>(&answer, aliasProperty)
    }
  }
  return Option<SealedProperty>.none()
}

fn aliasProperty(answer: &Result<Answer, NoRejection>) -> Option<SealedProperty> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Property {property}} = &value.outcome {
      return Option<SealedProperty>.some(property)
    }
  }
  return Option<SealedProperty>.none()
}

// Rejects a value type that applies an interface or service; they are contracts, not existentials.
effect fn existentialRejection(
  resolver: &mut Resolver,
  module: &ModuleId,
  id: HirId,
  value: &Shared<Type>,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !Shared<Type>.with<bool>(value, Type.mentionsContract) {
    return Option<Shared<Rejection>>.none()
  }
  let syntax = run typeNode(&mut resolver.*, module, id)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value: written} = move syntax {
    span = written.span
  }
  return Option<Shared<Rejection>>.some(
    run reject(&resolver.*, module, RejectionCode.NotType, span),
  )
}

// Whether a nominal type is declared in `module`; false for every other type.
// SEM0083 for an impl outside the modules IMPL-004 allows, naming the rule and the modules:
// "`geo.lib.Shape` is declared in `geo.lib` and `i64` is a builtin type, so this impl must be in
// `geo.lib`". A service conformance or a sealed property (no `contract`) belongs to the provider's
// module only.
effect fn conformanceOwnerRejection(module: &ModuleId, span: Span, provider: &Shared<Type>,
  contract: &Option<Shared<Type>>) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.ConformanceOwner, module, span)
  let providerText = match move run TypeText.displayElided(provider, module) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return run Shared<Rejection>.make(move diagnostic) }
  }
  let providerModule = Shared<Type>.with<Option<ModuleId>>(provider, nominalModule)
  let mut detail = Bytes.make()
  let mut interfaceModule = Option<Bytes>.none()
  if let Option<Shared<Type>>.Some {value: applied} = &contract.* {
    let contractText = match move run TypeText.displayElided(&applied, module) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => { return run Shared<Rejection>.make(move diagnostic) }
    }
    let declaring = match move Shared<Type>.with<Option<ModuleId>>(&applied, nominalModule) {
      Option<ModuleId>.Some {value} => run TypeText.importPathFrom(&value, module)
      Option<ModuleId>.None => { return run Shared<Rejection>.make(move diagnostic) }
    }
    run appendQuoted(&mut detail, Bytes.asSlice(&contractText))
    if Shared<Type>.with<OwnerKind>(&applied, nominalKind) == OwnerKind.Service {
      run Bytes.append(&mut detail, b" is a service, so its impl must be in the module that declares the provider; ")
    } else {
      run Bytes.append(&mut detail, b" is declared in ")
      run appendQuoted(&mut detail, Bytes.asSlice(&declaring))
      run Bytes.append(&mut detail, b" and ")
      interfaceModule = Option<Bytes>.some(move declaring)
    }
  } else {
    run Bytes.append(&mut detail, b"this property's impl must be in the module that declares the provider; ")
  }
  run appendQuoted(&mut detail, Bytes.asSlice(&providerText))
  match move providerModule {
    Option<ModuleId>.Some {value} => {
      let declaring = run TypeText.importPathFrom(&value, module)
      run Bytes.append(&mut detail, b" is declared in ")
      run appendQuoted(&mut detail, Bytes.asSlice(&declaring))
      run Bytes.append(&mut detail, b", so this impl must be in ")
      if let Option<Bytes>.Some {value: other} = &interfaceModule {
        if !same(Bytes.asSlice(&other), Bytes.asSlice(&declaring)) {
          run appendQuoted(&mut detail, Bytes.asSlice(&other))
          run Bytes.append(&mut detail, b" or ")
        }
      }
      run appendQuoted(&mut detail, Bytes.asSlice(&declaring))
    }
    Option<ModuleId>.None => {
      run Bytes.append(&mut detail, b" is a builtin type")
      if let Option<Bytes>.Some {value: other} = &interfaceModule {
        run Bytes.append(&mut detail, b", so this impl must be in ")
        run appendQuoted(&mut detail, Bytes.asSlice(&other))
      } else {
        run Bytes.append(&mut detail, b", so no module can declare this impl")
      }
    }
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
  return run Shared<Rejection>.make(move diagnostic)
}

// The module that declares a nominal type.
fn nominalModule(value: &Type) -> Option<ModuleId> {
  return match & value.* {
    Type.Nominal {declaration, ..} => Option<ModuleId>.some(ModuleId.copy(DeclarationId.moduleId(&declaration)))
    _ => Option<ModuleId>.none()
  }
}

fn declaredIn(value: &Type, module: &ModuleId) -> bool {
  return match & value.* {
    Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
    _ => false
  }
}

fn isNominalType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {..} => true
    _ => false
  }
}

// A scalar, borrowed `string`, or slice provider has no declaring module.
fn foundationalProvider(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.String {..} => true
    Type.Slice {..} => true
    _ => false
  }
}

// The implementation-owned ordinal an argument names, or `usize.MAX` for any other argument.
fn argumentOrdinal(argument: &Argument, implementation: &DeclarationId) -> usize {
  return match & argument.* {
    Argument.Type {value} => Shared<Type>.with<usize>(
      &value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, implementation)
      },
    )
    Argument.Lifetime {value} => Shared<Lifetime>.with<usize>(
      &value,
      fn(region: &Lifetime) -> usize {
        return lifetimeOrdinalOf(region, implementation)
      },
    )
    Argument.Row {value} => Shared<Row>.with<usize>(
      &value,
      fn(row: &Row) -> usize {
        return rowParameterOrdinal(row, implementation)
      },
    )
  }
}

// The ordinal of a row that is exactly one requirement-row parameter bound by `implementation`.
fn rowParameterOrdinal(row: &Row, implementation: &DeclarationId) -> usize {
  let parameters = List<RowParameter>.asSlice(&row.parameters)
  if List<Requirement>.length(&row.entries) != usize.ZERO || parameters.length != usize.ONE || List<
    RowSubtraction,
  >.length(&row.subtractions) != usize.ZERO {
    return usize.MAX
  }
  if Shared<DeclarationId>.with<bool>(
    &parameters[usize.ZERO].declaration,
    fn(declaration: &DeclarationId) -> bool {
      return DeclarationId.equals(declaration, implementation)
    },
  ) {
    return parameters[usize.ZERO].ordinal
  }
  return usize.MAX
}

// Whether a nominal owner's arguments are exactly the implementation's binders, each once: the
// written binders in declaration order, and lifetimes elided from the head wherever they occur.
fn wholeFamily(
  value: &Type,
  implementation: &DeclarationId,
  writtenCount: usize,
  binderCount: usize,
) -> bool {
  if let Type.Nominal {arguments, ..} = &value.* {
    return wholeFamilyArguments(List<Argument>.asSlice(&arguments), implementation, writtenCount, binderCount)
  }
  return false
}

// Canonical head arguments can be validated before building a nominal instance, without
// copying the ordinary use site's owned argument list.
fn wholeFamilyArguments(supplied: &[Argument], implementation: &DeclarationId, writtenCount: usize, binderCount: usize) -> bool {
  if supplied.length != binderCount {
    return false
  }
  let mut nextWritten = usize.ZERO
  let mut at = usize.ZERO
  while at < supplied.length {
    let ordinal = argumentOrdinal(&supplied[at], implementation)
    if ordinal < writtenCount {
      if ordinal != nextWritten {
        return false
      }
      nextWritten = nextWritten + usize.ONE
    } else if ordinal >= binderCount {
      return false
    }
    at = at + usize.ONE
  }
  return nextWritten == writtenCount
}

// The written spelling and arguments of an inherent head that names a declaration of its module.
struct InherentOwner {
  name: Bytes,
  application: Option<HirId>,
  span: Span,
}

// An inherent owner is a struct, tuple, union, enum, service, or interface declaration.
fn inherentOwnerKind(value: &Type) -> bool {
  let kind = nominalKind(value)
  return kind == OwnerKind.Struct || kind == OwnerKind.Tuple || kind == OwnerKind.Union || kind == OwnerKind.Enumeration || kind == OwnerKind.Service || kind == OwnerKind.Interface
}

// Checks that an inherent head spells one declaration of its own module; an import, qualified
// path, alias, or foundational spelling is not an owner. An absent name is left to ordinary lookup.
effect fn inherentOwnerSyntax(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  subject: HirId,
) -> Result<InherentOwner, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let syntax = run typeNode(&mut resolver.*, module, subject)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut named = HirRef.absent()
  let mut application = Option<HirId>.none()
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      if !hasMode {
        named = HirRef.of(written)
      }
    }
    if let Node.AppliedType {target, arguments} = value.header {
      let applied = run typeNode(&mut resolver.*, module, target)
      if let Option<HeaderSyntax>.Some {value: found} = move applied {
        if let Node.NamedType {path: written, hasMode, ..} = found.header {
          if !hasMode {
            named = HirRef.of(written)
            application = Option<HirId>.some(arguments)
          }
        }
      }
    }
  }
  if named.present {
    let parsed = run path(&mut resolver.*, module, named.id)
    let segments = List<Bytes>.asSlice(&parsed.segments)
    if parsed.valid && segments.length == usize.ONE {
      let name = Bytes.asSlice(&segments[usize.ZERO])
      // INTR-001: the sealed namespace cannot be reopened or extended; no rejection names that yet.
      if same(name, b"Intrinsic") {
        return Result<InherentOwner, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
      let selectedSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, name, false)
      let selected = match move selectedSelection {
        Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
        Result<Selection, Shared<Rejection>>.Failure {error} => {
          return Result<InherentOwner, Shared<Rejection>>.failResult(move error)
        }
      }
      let mut owned = selected.count != usize.ONE
      if selected.count == usize.ZERO && (primitive(name) || same(name, b"string") || same(
        name,
        b"Effect",
      )) {
        owned = false
      }
      if selected.count == usize.ONE && selected.kind == CandidateKind.Declaration {
        let declared = run header(&mut resolver.*, module, selected.declaration)
        owned = true
        if let Option<HeaderSyntax>.Some {value: found} = move declared {
          if let Node.AliasHeader {..} = found.header {
            owned = false
          }
        }
      }
      if owned {
        return Result<InherentOwner, Shared<Rejection>>.succeed(
          InherentOwner {name: run Bytes.copy(name), application: move application, span: span},
        )
      }
    }
  }
  return Result<InherentOwner, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.InvalidInherentHead, span),
  )
}

fn lifetimeOrdinalOf(region: &Lifetime, owner: &DeclarationId) -> usize {
  if let Lifetime.Parameter {declaration, ordinal} = &region.* {
    if DeclarationId.equals(&declaration, owner) {
      return ordinal
    }
  }
  return usize.MAX
}

// The only caller allowed to resolve a declaration as its own inherent-family domain.
// Canonical local-owner and whole-family validation happens before any bounds become premises.
effect fn inherentProvider(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, module: &ModuleId, name: &[u8], span: Span, application: Option<HirId>,
  binders: &[Binder], elision: &mut LifetimeElision, implementation: &DeclarationId, writtenCount: usize,
) -> Result<DeclarationApplication, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, name, false, span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result<DeclarationApplication, Shared<Rejection>>.failResult(move error)
    }
  }
  return run declarationApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    declaration.module, declaration.ordinal, module, span, span, move application, binders, &mut elision.*,
    DeclarationApplicationContext.InherentFamily {
      implementation: DeclarationId.copy(implementation), writtenCount: writtenCount,
    })
}

// Resolve the shape before proving its applied declaration bounds. Conformance discovery
// can then inspect the complete module's shapes without re-entering this validation query.
// A matching candidate still demands this checked head before it can prove a conformance.
effect fn resolveImplementationHead(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let shapeKey = Key {family: Family.ImplementationShape, module: key.module, name: key.name,
    declaration: key.declaration, member: key.member, external: key.external}
  let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, shapeKey, Span.make(usize.ZERO, usize.ZERO))
  let head = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&shape, headOf) {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shape, answerCause) {
        return run memberRejected(move value, move dependencies)
      }
      fail RevisionMismatch {}
    }
  }
  let mut premises = List<Constraint>.make()
  let count = Shared<ImplementationHead>.with<usize>(&head, headConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    if let Option<Constraint>.Some {value} = move Shared<ImplementationHead>.with<Option<Constraint>>(&head,
      fn(value: &ImplementationHead) -> Option<Constraint> { return headConstraintAt(value, at) }) {
      run List<Constraint>.append(&mut premises, move value)
    }
    at = at + usize.ONE
  }
  let obligations = Shared<ImplementationHead>.with<usize>(&head,
    fn(value: &ImplementationHead) -> usize { return List<HeadObligation>.length(&value.obligations) })
  at = usize.ZERO
  while at < obligations {
    let obligation = Shared<ImplementationHead>.with<HeadObligation>(&head, fn(value: &ImplementationHead) -> HeadObligation {
      let listed = List<HeadObligation>.asSlice(&value.obligations)
      return HeadObligation {bound: copyConstraint(&listed[at].bound), module: ModuleId.copy(&listed[at].module), span: listed[at].span}
    })
    let mut bounds = List<Constraint>.make()
    run List<Constraint>.append(&mut bounds, move obligation.bound)
    if let Option<Shared<Rejection>>.Some {value} = move run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies,
      &premises, List<Constraint>.asSlice(&bounds), &obligation.module, obligation.span, RegionProof.Typing) {
      return run memberRejected(move value, move dependencies)
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.ImplementationHead {head: move head}, move dependencies)
}

effect fn resolveImplementationShape(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess50 = declarationPosition(&resolver.*, key)
  let written = run header(&mut resolver.*, &module, declarationAccess50)
  let declarationAccess51 = declarationPosition(&resolver.*, key)
  let found = run declarationAt(&mut resolver.*, &module, declarationAccess51)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut generics = Range.empty()
  let mut subject = HirId {index: usize.ZERO}
  let mut target = HirRef.absent()
  let mut clauses = Range.empty()
  let mut isImplementation = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {generics: parameters, subject: named, target: provided, constraints: headClauses} = value.header {
      generics = parameters
      subject = named
      target = provided
      clauses = headClauses
      isImplementation = true
    }
  }
  let implementation = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isImplementation {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let declarationAccess52 = declarationPosition(&resolver.*, key)
  let template = run templateBinders(&mut resolver.*, &module, declarationAccess52)
  let binders = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  // `Self` is bound inside every implementation, so no written binder may claim it.
  let none = List<Binder>.make()
  let conflict = run scopedBinderRejection(
    &mut resolver.*,
    &module,
    generics,
    List<Binder>.asSlice(&none),
    true,
    false,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let writtenCount = List<Binder>.length(&binders)
  let anchors = run genericAnchors(&mut resolver.*, &module, declarationAccess50, generics)
  // LIFE-003: lifetimes omitted from the heads become the implementation's own parameters.
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.some(DeclarationId.copy(&implementation)),
    nextOrdinal: writtenCount,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.some(List<DeferredBounds>.make()),
  }
  let mut kind = ImplementationKind.Inherent
  let mut contract = Option<Shared<Type>>.none()
  let mut providerId = subject
  // An inherent owner is looked up in module scope only, so a same-spelled declaration of this
  // module wins over a builtin spelling, and an import or alias is never an owner.
  let mut inherentOwner = Option<InherentOwner>.none()
  if !target.present {
    let checked = run inherentOwnerSyntax(&mut resolver.*, &mut owner.*, &mut dependencies, &module, subject)
    match move checked {
      Result<InherentOwner, Shared<Rejection>>.Success {value} => {
        // Authored inherent impl interface and callable bounds and `where` clauses are forbidden
        // independently of the owner's own domain. An outlives bound is a premise every member may
        // assume.
        if anchors.typeBounded || clauses.length > usize.ZERO {
          return run memberRejected(
            run reject(&resolver.*, &module, RejectionCode.InvalidInherentHead, value.span),
            move dependencies,
          )
        }
        inherentOwner = Option<InherentOwner>.some(move value)
      }
      Result<InherentOwner, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
  }
  // The implementation's bounds are premises of its own heads: an applied contract or provider
  // proves its declarations' bounds from them, as a signature's types do from its constraints.
  let declared = run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    key.module,
    &module,
    generics,
    List<Binder>.asSlice(&binders),
    &mut elision,
    false,
    BoundPhase.Authored,
  )
  let mut constraints = match move declared {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  // A bound's omitted lifetime would add an implementation lifetime no head can determine.
  if List<Shared<Lifetime>>.length(&elision.generated) != usize.ZERO {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  elision.assumptions = Option<List<Constraint>>.some(run copyConstraints(List<Constraint>.asSlice(&constraints)))
  if target.present {
    providerId = target.id
    kind = ImplementationKind.Conformance
    let sealed = run sealedProperty(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      subject,
      List<Binder>.asSlice(&binders),
    )
    if let Option<SealedProperty>.Some {value: property} = move sealed {
      kind = ImplementationKind.Sealed {property: property}
    } else {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        subject,
        List<Binder>.asSlice(&binders),
        &mut elision,
      )
      let applied = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return run memberRejected(move error, move dependencies)
        }
      }
      let contractKind = Shared<Type>.with<OwnerKind>(&applied, nominalKind)
      if contractKind != OwnerKind.Interface && contractKind != OwnerKind.Service {
        let syntax = run typeNode(&mut resolver.*, &module, subject)
        let mut at = span
        if let Option<HeaderSyntax>.Some {value} = move syntax {
          at = value.span
        }
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidBound, at),
          move dependencies,
        )
      }
      contract = Option<Shared<Type>>.some(move applied)
    }
  }
  let mut resolvedProvider = Result<Shared<Type>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
  )
  let mut ownerPremises = List<Constraint>.make()
  if let Option<InherentOwner>.Some {value: named} = move inherentOwner {
    let InherentOwner {name: ownerName, application, span: ownerSpan} = move named
    let resolved = run inherentProvider(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      Bytes.asSlice(&ownerName),
      ownerSpan,
      move application,
      List<Binder>.asSlice(&binders),
      &mut elision,
      &implementation,
      writtenCount,
    )
    match move resolved {
      Result<DeclarationApplication, Shared<Rejection>>.Success {value} => {
        let DeclarationApplication {ty, ownerPremises: premises} = move value
        ownerPremises = move premises
        resolvedProvider = Result<Shared<Type>, Shared<Rejection>>.succeed(move ty)
      }
      Result<DeclarationApplication, Shared<Rejection>>.Failure {error} => {
        resolvedProvider = Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
      }
    }
  } else {
    resolvedProvider = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      providerId,
      List<Binder>.asSlice(&binders),
      &mut elision,
    )
  }
  let provider = match move resolvedProvider {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let providerSyntax = run typeNode(&mut resolver.*, &module, providerId)
  let mut providerSpan = span
  if let Option<HeaderSyntax>.Some {value} = move providerSyntax {
    providerSpan = value.span
  }
  let nominal = Shared<Type>.with<bool>(&provider, isNominalType)
  let foundational = Shared<Type>.with<bool>(&provider, foundationalProvider)
  let inherent = match & kind {
    ImplementationKind.Inherent => true
    _ => false
  }
  if inherent && !Shared<Type>.with<bool>(&provider, inherentOwnerKind) {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidInherentHead, providerSpan),
      move dependencies,
    )
  }
  // IMPL-001: a provider needs one canonical nominal identity, or is a scalar or `string`.
  if !nominal && !foundational {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidProvider, providerSpan),
      move dependencies,
    )
  }
  // A head `where` clause adds premises the same way a signature's clause does. A provider loan's
  // omitted region becomes one more implementation lifetime that nothing needs to determine, since
  // a provides premise holds whatever the loan's region.
  let providers = run declareProviders(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, &module, clauses,
    List<Binder>.asSlice(&binders), &mut elision, &mut constraints)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move providers {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let generatedByHeads = List<Shared<Lifetime>>.length(&elision.generated)
  let providerLocal = Shared<Type>.with<bool>(
    &provider,
    fn(value: &Type) -> bool {
      return declaredIn(value, &module)
    },
  )
  let binderCount = writtenCount + generatedByHeads
  // IMPL-004: an interface conformance belongs to the interface's or the nominal provider's
  // module; a service conformance and a sealed property belong to the provider's module.
  let mut permitted = true
  if let ImplementationKind.Sealed {..} = &kind {
    permitted = providerLocal
  }
  if let Option<Shared<Type>>.Some {value: applied} = &contract {
    let contractLocal = Shared<Type>.with<bool>(
      &applied,
      fn(value: &Type) -> bool {
        return declaredIn(value, &module)
      },
    )
    let serviceContract = Shared<Type>.with<OwnerKind>(&applied, nominalKind) == OwnerKind.Service
    permitted = providerLocal || (!serviceContract && contractLocal)
  }
  if !permitted {
    return run memberRejected(
      run conformanceOwnerRejection(&module, span, &provider, &contract),
      move dependencies,
    )
  }
  // ENUM-003: a scalar enum is always Copy and never admits a Drop hook, so neither is requested.
  if let ImplementationKind.Sealed {property} = &kind {
    if Shared<Type>.with<OwnerKind>(&provider, nominalKind) == OwnerKind.Enumeration {
      // A scalar enum is also always Transferable and Concurrent, so no assertion is needed.
      let code = match property {
        SealedProperty.Copy => RejectionCode.InvalidCopyConformance
        SealedProperty.Drop => RejectionCode.InvalidDropImplementation
        SealedProperty.Transferable => RejectionCode.InvalidThreadPropertyConformance
        SealedProperty.Concurrent => RejectionCode.InvalidThreadPropertyConformance
      }
      return run memberRejected(run reject(&resolver.*, &module, code, span), move dependencies)
    }
  }
  // An inherent head belongs to every instantiation of an owner of this module: its arguments are
  // the implementation's own binders, written ones in declaration order, each once. Only outlives
  // bounds may restrict them, as premises every member assumes.
  if inherent {
    let family = Shared<Type>.with<bool>(
      &provider,
      fn(value: &Type) -> bool {
        return wholeFamily(value, &implementation, writtenCount, binderCount)
      },
    )
    if !providerLocal || !family || !outlivesOnly(List<Constraint>.asSlice(&constraints)) {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidInherentHead, providerSpan),
        move dependencies,
      )
    }
  }
  // REP-001: a written use contract in a conformance head admits every exact representation that
  // satisfies it. Each becomes a hidden binder after the lifetimes, bounded by its contract, so a
  // goal binds its exact representation and the members can name that same binder.
  let mut slots = List<CallableParameter.RepresentationSlot>.make()
  let mut headContract = Option<Shared<Type>>.none()
  let mut headProvider = Shared<Type>.clone(&provider)
  if let Option<Shared<Type>>.Some {value: writtenContract} = &contract {
    headContract = Option<Shared<Type>>.some(run CallableParameter.reifyArguments(&writtenContract, &implementation, binderCount, &mut slots))
    headProvider = run CallableParameter.reifyArguments(&provider, &implementation, binderCount, &mut slots)
  }
  let mut lists = run parametersOf(List<Binder>.asSlice(&binders))
  let reified = List<CallableParameter.RepresentationSlot>.asSlice(&slots)
  let mut slotAt = usize.ZERO
  while slotAt < reified.length {
    run List<Shared<Type>>.append(&mut lists.types, Shared<Type>.clone(&reified[slotAt].representation))
    run List<Constraint>.append(&mut constraints, Constraint.Represents {
      parameter: Shared<Type>.clone(&reified[slotAt].representation), contract: Shared<Type>.clone(&reified[slotAt].contract)})
    slotAt = slotAt + usize.ONE
  }
  let mut lifetimes = move lists.lifetimes
  let generated = List<Shared<Lifetime>>.asSlice(&elision.generated)
  let mut generatedAt = usize.ZERO
  while generatedAt < generated.length {
    run List<Shared<Lifetime>>.append(
      &mut lifetimes,
      Shared<Lifetime>.clone(&generated[generatedAt]),
    )
    generatedAt = generatedAt + usize.ONE
  }
  let subjectSyntax = run typeNode(&mut resolver.*, &module, subject)
  let mut contractSpan = span
  if let Option<HeaderSyntax>.Some {value} = move subjectSyntax {
    contractSpan = value.span
  }
  // IMPL-007: lifetimes never decide which code runs. A sealed Drop or Copy head is selected per
  // type during lowering, with no typing proof behind it, so it may not depend on a region.
  if let ImplementationKind.Sealed {..} = &kind {
    let implied = run providerDeclaredBounds(&mut resolver.*, &mut owner.*, &mut dependencies, &headProvider, span)
    if run regionDependentHead(&headProvider, List<Constraint>.asSlice(&constraints), List<Constraint>.asSlice(&implied)) {
      return run memberRejected(run reject(&resolver.*, &module, RejectionCode.RegionDependentSealedHead, span), move dependencies)
    }
  }
  let mut obligations = List<HeadObligation>.make()
  if let Option<List<DeferredBounds>>.Some {value: pending} = move elision.deferred {
    let waiting = List<DeferredBounds>.asSlice(&pending)
    let mut at = usize.ZERO
    while at < waiting.length {
      let bounds = List<Constraint>.asSlice(&waiting[at].bounds)
      let mut boundAt = usize.ZERO
      while boundAt < bounds.length {
        run List<HeadObligation>.append(&mut obligations, HeadObligation {bound: copyConstraint(&bounds[boundAt]),
          module: ModuleId.copy(&waiting[at].module), span: waiting[at].span})
        boundAt = boundAt + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  let head = ImplementationHead {
    obligations: move obligations,
    declaration: run Shared<DeclarationId>.make(move implementation),
    kind: move kind,
    binders: Contract {
      typeParameters: move lists.types,
      lifetimeParameters: move lifetimes,
      rowParameters: move lists.rows,
      constraints: move constraints,
      provider: Option<Shared<Type>>.none(),
    },
    ownerPremises: move ownerPremises,
    contract: move headContract,
    provider: move headProvider,
    span: span,
    contractSpan: contractSpan,
    providerSpan: providerSpan,
    binderSpans: move anchors.binders,
    boundSpans: move anchors.bounds,
    reified: List<CallableParameter.RepresentationSlot>.length(&slots),
  }
  return memberSuccess(
    Value.ImplementationHead {head: run Shared<ImplementationHead>.make(move head)},
    move dependencies,
  )
}

// Whether every constraint only requires one region or type's contents to outlive another.
fn outlivesOnly(constraints: &[Constraint]) -> bool {
  let mut at = usize.ZERO
  while at < constraints.length {
    let admitted = match &constraints[at] {
      Constraint.Contents {..} => true
      Constraint.Outlives {..} => true
      _ => false
    }
    if !admitted { return false }
    at = at + usize.ONE
  }
  return true
}

fn headOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ImplementationHead {head}} => Option<
        Shared<ImplementationHead>,
      >.some(Shared<ImplementationHead>.clone(&head))
      _ => Option<Shared<ImplementationHead>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<ImplementationHead>>.none()
  }
}

fn isImplementationHeader(hir: &Module, declaration: &IndexedDeclaration) -> bool {
  return match Module.node(hir, declaration.header) {
    Node.ImplHeader {..} => true
    _ => false
  }
}

// An `impl Contract for Provider` header, as opposed to an inherent `impl Owner`.
fn isConformanceHeader(hir: &Module, declaration: &IndexedDeclaration) -> bool {
  return match Module.node(hir, declaration.header) {
    Node.ImplHeader {target, ..} => target.present
    _ => false
  }
}

// The written module-level declarations whose `static if` arms are selected, in written order.
// A failed or cyclic governing condition fails the whole demand with its anchored rejection.
effect fn selectedDeclarations(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  written: &[usize],
) -> Result<List<usize>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut selected = List<usize>.make()
  let mut at = usize.ZERO
  while at < written.length {
    let outcome = run available(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, written[at], Span.make(usize.ZERO, usize.ZERO),
    )
    let admitted = match move outcome {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result<List<usize>, Shared<Rejection>>.failResult(move error)
      }
    }
    if admitted {
      run List<usize>.append(&mut selected, written[at])
    }
    at = at + usize.ONE
  }
  return Result<List<usize>, Shared<Rejection>>.succeed(move selected)
}

fn topLevel(declaration: &IndexedDeclaration) -> bool {
  return match & declaration.parent {
    Option<usize>.Some {..} => false
    Option<usize>.None => true
  }
}

effect fn resolveImplementations(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let mut written = List<usize>.make()
  let answer = run observedSource(&mut resolver.*, &module, SourceSelector.Implementations)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(value)
    let mut at = ModuleIndex.firstEnclosed(index, usize.MAX)
    while at != usize.MAX {
      if isConformanceHeader(hir, &declarations[at]) && topLevel(&declarations[at]) {
        run List<usize>.append(&mut written, at)
      }
      at = ModuleIndex.nextEnclosed(index, at)
    }
  }
  drop answer
  let selectedOrdinals = run selectedDeclarations(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module, List<usize>.asSlice(&written),
  )
  let ordinals = match move selectedOrdinals {
    Result<List<usize>, Shared<Rejection>>.Success {value} => move value
    Result<List<usize>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let mut family = Family.ImplementationHead
  if key.family == Family.ImplementationShapes { family = Family.ImplementationShape }
  let mut heads = List<Shared<ImplementationHead>>.make()
  let listed = List<usize>.asSlice(&ordinals)
  let mut at = usize.ZERO
  while at < listed.length {
    let declarationAccess53Request = Key {
      family: family,
      module: key.module,
      name: usize.ZERO,
      declaration: listed[at],
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess53 = run internDeclaration(&mut resolver.*, declarationAccess53Request)
    let headKey = declarationAccess53
    let child = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      headKey,
      Span.make(usize.ZERO, usize.ZERO),
    )
    let head = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &child,
      headOf,
    )
    if let Option<Shared<ImplementationHead>>.Some {value} = move head {
      run List<Shared<ImplementationHead>>.append(&mut heads, move value)
    } else {
      let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &child,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return run memberRejected(move diagnostic, move dependencies)
      }
    }
    at = at + usize.ONE
  }
  let mut owners = InternIndex.make()
  let recorded = List<Shared<ImplementationHead>>.asSlice(&heads)
  let mut indexed = usize.ZERO
  while indexed < recorded.length {
    let hash = Shared<ImplementationHead>.with<u64>(&recorded[indexed], fn(head: &ImplementationHead) -> u64 {
      return Shared<Type>.with<u64>(&head.provider, providerOwnerHash)
    })
    run InternIndex.record(&mut owners, hash)
    indexed = indexed + usize.ONE
  }
  return memberSuccess(Value.Implementations {heads: move heads, owners: move owners}, move dependencies)
}

// A hash that two providers share whenever `sameProviderOwner` reports them the same owner.
fn providerOwnerHash(value: &Type) -> u64 {
  return match &value.* {
    Type.Nominal {declaration, ..} => DeclarationId.hash(&declaration)
    Type.Primitive {name} => InternIndex.hashBytes(1, Bytes.asSlice(&name))
    Type.String {..} => 2
    Type.Slice {..} => 3
    Type.Unit => 4
    _ => unownedProviderHash
  }
}

// The bucket of providers without an owner, such as a type parameter.
const unownedProviderHash: u64 = 5

// The first head of an implementation catalog recorded under the provider owner `hash`, or
// `usize.MAX`; `after` continues in head order.
fn firstOwnedHead(answer: &Result<Answer, NoRejection>, hash: u64) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Implementations {owners, ..}} = &value.outcome { return InternIndex.first(&owners, hash) }
  }
  return usize.MAX
}

fn nextOwnedHead(answer: &Result<Answer, NoRejection>, after: usize) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Implementations {owners, ..}} = &value.outcome { return InternIndex.after(&owners, after) }
  }
  return usize.MAX
}

// Whether a head's provider is the nominal `owner`.
fn headProvides(head: &ImplementationHead, owner: &DeclarationId) -> bool {
  return Shared<Type>.with<bool>(
    &head.provider,
    fn(provider: &Type) -> bool {
      return match & provider.* {
        Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    },
  )
}

fn membersClaim(listed: &[Member], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if let Option<Bytes>.Some {value: spelled} = &listed[at].name {
      if same(Bytes.asSlice(&spelled), name) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn operationsClaim(listed: &[Shared<DeclarationId>], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if Shared<DeclarationId>.with<bool>(
      &listed[at],
      fn(operation: &DeclarationId) -> bool {
        return DeclarationId.named(operation, name)
      },
    ) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether an owner's own associated items already claim `name`.
fn ownerClaims(answer: &Result<Answer, NoRejection>, name: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => membersClaim(
        List<Member>.asSlice(&members),
        name,
      )
      Outcome.Success {value: Value.Operations {operations, ..}} => operationsClaim(
        List<Shared<DeclarationId>>.asSlice(&operations),
        name,
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// One written member of an inherent `impl`, with whether it can be an associated member at all.
struct InherentCandidate {
  ordinal: usize,
  name: Bytes,
  span: Span,
  /// The written name, where a repeated name is reported (SEM0196).
  nameSpan: Span,
  admissible: bool,
}

effect fn inherentCandidates(resolver: &mut Resolver, module: &ModuleId, implementation: usize) -> List<
  InherentCandidate,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut candidates = List<InherentCandidate>.make()
  let answer = run observedDeclaration(&mut resolver.*, module, implementation, SourceFacet.Enclosed)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(value)
    let mut at = ModuleIndex.firstEnclosed(index, implementation)
    while at != usize.MAX {
      if enclosedBy(&declarations[at], implementation) {
        let written = Module.node(hir, declarations[at].header)
        let mut name = HirRef.absent()
        // A mapping only makes sense in a conformance, and a Drop hook belongs to `impl Drop`.
        let mut admissible = false
        if let Node.FunctionHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
          admissible = true
        }
        if let Node.ImplAliasHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
        }
        if name.present {
          if let Node.Name {text} = Module.node(hir, name.id) {
            let spelling = Module.text(hir, text)
            if same(spelling, b"drop") {
              admissible = false
            }
            run List<InherentCandidate>.append(
              &mut candidates,
              InherentCandidate {
                ordinal: at,
                name: run Bytes.copy(spelling),
                span: Module.span(hir, declarations[at].header),
                nameSpan: Module.span(hir, name.id),
                admissible: admissible,
              },
            )
          }
        }
      }
      at = ModuleIndex.nextEnclosed(index, at)
    }
  }
  return move candidates
}

// An inherent member that cannot be one (SEM0195), naming its owner and which of the catalog's three
// cases it is: a mapping, a `drop` hook, or a name the owner's own `claimKind` already has.
effect fn inherentMemberRejection(module: &ModuleId, span: Span, owner: &DeclarationId, member: &[u8], admissible: bool,
  claimKind: &[u8]) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InvalidInherentMember, module, span)
  let mut choice = b"0"
  if same(member, b"drop") {
    choice = b"1"
  } else if admissible {
    choice = b"2"
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"collidesWith"),
      value: run Bytes.copy(claimKind)})
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"owner"),
    value: run DeclarationId.copySpelling(owner)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: run Bytes.copy(member)})
  return run Shared<Rejection>.make(move diagnostic)
}

effect fn rejectRelated(module: &ModuleId, code: RejectionCode, span: Span, related: Option<DeclarationId>,
  arguments: List<MessageArgument>) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut path = List<Shared<DeclarationId>>.make()
  if let Option<DeclarationId>.Some {value} = move related {
    run List<Shared<DeclarationId>>.append(&mut path, run Shared<DeclarationId>.make(move value))
  }
  return run Shared<Rejection>.make(
    Rejection {
      code: code,
      module: ModuleId.copy(module),
      span: span,
      related: Option<RelatedSite>.none(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: move arguments, owner: usize.MAX,
    },
  )
}

// Whether the inherent head at `implementation` names the owner at `ownerOrdinal`, resolved in
// module scope exactly as the head resolves it. Unresolvable owners name no owner.
effect fn inherentHeadOwner(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, moduleOrdinal: usize, module: &ModuleId, implementation: usize,
  ownerOrdinal: usize) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run header(&mut resolver.*, module, implementation)
  let mut subject = HirId {index: usize.ZERO}
  let mut inherent = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ImplHeader {subject: ownerSyntax, target, ..} = value.header {
      subject = ownerSyntax
      inherent = !target.present
    }
  }
  if !inherent { return false }
  let named = match move run inherentOwnerSyntax(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, subject) {
    Result<InherentOwner, Shared<Rejection>>.Success {value} => move value
    Result<InherentOwner, Shared<Rejection>>.Failure {..} => { return false }
  }
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
    Bytes.asSlice(&named.name), false, named.span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  return match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value.module == moduleOrdinal && value.ordinal == ownerOrdinal
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {..} => false
  }
}

effect fn resolveInherentMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess54 = declarationPosition(&resolver.*, key)
  let written = run header(&mut resolver.*, &module, declarationAccess54)
  let declarationAccess55 = declarationPosition(&resolver.*, key)
  let found = run declarationAt(&mut resolver.*, &module, declarationAccess55)
  let mut claimedBy = Family.Members
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut generatedValue = false
  let mut isOwner = false
  // What an owner's own members are, as SEM0195 names a member an inherent one collides with.
  let mut claimKind = b"field"
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    claimKind = match value.header {
      Node.UnionHeader {..} => b"variant"
      Node.EnumHeader {..} => b"member"
      Node.ServiceHeader {..} => b"operation"
      Node.InterfaceHeader {..} => b"operation"
      _ => b"field"
    }
    isOwner = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.UnionHeader {..} => true
      Node.EnumHeader {..} => true
      Node.ServiceHeader {..} => true
      Node.InterfaceHeader {..} => true
      _ => false
    }
    if isContractHeader(value.header) {
      claimedBy = Family.Operations
    }
    if let Node.EnumHeader {..} = value.header {
      generatedValue = true
    }
  }
  let ownerId = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isOwner {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.NotType, span),
      move dependencies,
    )
  }
  let claimsKey = Key {
    family: claimedBy,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let claims = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, claimsKey, span)
  if Shared<Result<Answer, NoRejection>>.with<bool>(&claims, hasRejection) {
    let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &claims,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return run memberRejected(move diagnostic, move dependencies)
    }
  }
  // Only this module can declare the owner's inherent members; a rejected head publishes none.
  let mut writtenImplementations = List<usize>.make()
  let answer = run observedSource(&mut resolver.*, &module, SourceSelector.Inherents)
  let mut fresh = Option<ModuleScan>.none()
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let index = IndexedSource.moduleIndex(value)
    let revision = ModuleIndex.sourceRevision(index)
    // Every owner of the module asks this; the module's inherent heads are scanned once per revision.
    let known = cachedScan(&resolver.*, key.module, ModuleScanKind.InherentImplementations, revision)
    if known != usize.MAX {
      let found = List<usize>.asSlice(&List<ModuleScan>.asSlice(&resolver.moduleScans)[known].ordinals)
      let mut at = usize.ZERO
      while at < found.length {
        run List<usize>.append(&mut writtenImplementations, found[at])
        at = at + usize.ONE
      }
    } else {
      let declarations = ModuleIndex.listDeclarations(index)
      let hir = IndexedSource.authored(value)
      let mut scanned = List<usize>.make()
      let mut at = ModuleIndex.firstEnclosed(index, usize.MAX)
      while at != usize.MAX {
        if isImplementationHeader(hir, &declarations[at]) && !isConformanceHeader(hir, &declarations[at])
          && topLevel(&declarations[at]) {
          run List<usize>.append(&mut writtenImplementations, at)
          run List<usize>.append(&mut scanned, at)
        }
        at = ModuleIndex.nextEnclosed(index, at)
      }
      fresh = Option<ModuleScan>.some(ModuleScan {module: key.module, kind: ModuleScanKind.InherentImplementations,
        revision: revision, ordinals: move scanned, names: List<Bytes>.make()})
    }
  }
  if let Option<ModuleScan>.Some {value: entry} = move fresh { run recordScan(&mut resolver.*, move entry) }
  drop answer
  let selectedImplementations = run selectedDeclarations(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module, List<usize>.asSlice(&writtenImplementations),
  )
  let implementations = match move selectedImplementations {
    Result<List<usize>, Shared<Rejection>>.Success {value} => move value
    Result<List<usize>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let mut candidates = List<InherentCandidate>.make()
  let listed = List<usize>.asSlice(&implementations)
  let mut at = usize.ZERO
  while at < listed.length {
    let declarationAccess56Request = Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: listed[at],
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess56 = run internDeclaration(&mut resolver.*, declarationAccess56Request)
    let headKey = declarationAccess56
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, headKey, span)
    let head = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &child,
      headOf,
    )
    if let Option<Shared<ImplementationHead>>.Some {value} = move head {
      let owned = Shared<ImplementationHead>.with<bool>(
        &value,
        fn(implementation: &ImplementationHead) -> bool {
          return headProvides(implementation, &ownerId)
        },
      )
      if owned {
        let written = run inherentCandidates(&mut resolver.*, &module, listed[at])
        let entries = List<InherentCandidate>.asSlice(&written)
        let mut entryAt = usize.ZERO
        while entryAt < entries.length {
          run List<InherentCandidate>.append(
            &mut candidates,
            InherentCandidate {
              ordinal: entries[entryAt].ordinal,
              name: run Bytes.copy(Bytes.asSlice(&entries[entryAt].name)),
              span: entries[entryAt].span,
              nameSpan: entries[entryAt].nameSpan,
              admissible: entries[entryAt].admissible,
            },
          )
          entryAt = entryAt + usize.ONE
        }
      }
    } else {
      // A deferred head of this owner leaves its members undecided rather than absent.
      let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refused {
        if Shared<Rejection>.with<bool>(&diagnostic, fn(value: &Rejection) -> bool { return unavailableRejection(value.code) }) {
          let declarationAccess57 = declarationPosition(&resolver.*, key)
          if run inherentHeadOwner(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, &module, listed[at], declarationAccess57) {
            return run memberRejected(move diagnostic, move dependencies)
          }
        }
      }
    }
    at = at + usize.ONE
  }
  let mut members = List<Shared<DeclarationId>>.make()
  let mut rejected = List<RejectedMember>.make()
  let all = List<InherentCandidate>.asSlice(&candidates)
  let mut candidateAt = usize.ZERO
  while candidateAt < all.length {
    let name = Bytes.asSlice(&all[candidateAt].name)
    let claimed = Shared<Result<Answer, NoRejection>>.with<bool>(
      &claims,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return ownerClaims(value, name)
      },
    ) || (generatedValue && same(name, b"value"))
    let mut other = usize.MAX
    let mut otherAt = usize.ZERO
    while otherAt < all.length {
      if otherAt != candidateAt && same(Bytes.asSlice(&all[otherAt].name), name) {
        other = all[otherAt].ordinal
      }
      otherAt = otherAt + usize.ONE
    }
    let identity = run declarationAt(&mut resolver.*, &module, all[candidateAt].ordinal)
    if let Option<DeclarationId>.Some {value: declared} = move identity {
      let member = run Shared<DeclarationId>.make(move declared)
      if !all[candidateAt].admissible || claimed {
        run List<RejectedMember>.append(
          &mut rejected,
          RejectedMember {
            declaration: move member,
            rejection: run inherentMemberRejection(&module, all[candidateAt].span, &ownerId, name, all[candidateAt].admissible,
              claimKind),
          },
        )
      } else if other != usize.MAX {
        let related = run declarationAt(&mut resolver.*, &module, other)
        run List<RejectedMember>.append(
          &mut rejected,
          RejectedMember {
            declaration: move member,
            rejection: run rejectRelated(&module, RejectionCode.DuplicateInherentMember, all[candidateAt].nameSpan, move related,
              List<MessageArgument>.make()),
          },
        )
      } else {
        run List<Shared<DeclarationId>>.append(&mut members, move member)
      }
    }
    candidateAt = candidateAt + usize.ONE
  }
  return memberSuccess(
    Value.InherentMembers {members: move members, rejected: move rejected},
    move dependencies,
  )
}

// Projects the owner's inherent member list onto the key's one name. The list changes whenever
// a member is added or removed; this answer changes only when that name's member does.
effect fn resolveInherentMember(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let listKey = Key {family: Family.InherentMembers, module: key.module, name: usize.ZERO, declaration: key.declaration,
    member: usize.ZERO, external: false}
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, listKey, Span.make(usize.ZERO, usize.ZERO))
  if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause) {
    return run memberRejected(move value, move dependencies)
  }
  let name = run resolvedName(&resolver.*, key.name)
  let lookup = Shared<Result<Answer, NoRejection>>.with<InherentLookup>(&listed,
    fn(answer: &Result<Answer, NoRejection>) -> InherentLookup { return inherentLookup(answer, Bytes.asSlice(&name)) })
  let InherentLookup {published, rejected} = move lookup
  return memberSuccess(Value.InherentMember {published: move published, rejected: move rejected}, move dependencies)
}

// The key of `ownerOrdinal`'s inherent member `name` in module `moduleOrdinal`.
effect fn inherentMemberKey(resolver: &mut Resolver, moduleOrdinal: usize, ownerOrdinal: usize, name: &[u8]) -> Key
! Cycle | OutOfMemoryError ? &mut Allocator {
  let nameOrdinal = run internName(&mut resolver.*, name)
  return run internDeclaration(&mut resolver.*, Key {family: Family.InherentMember, module: moduleOrdinal, name: nameOrdinal,
    declaration: ownerOrdinal, member: usize.ZERO, external: false})
}

// What an `InherentMember` answer says; nothing when it failed.
fn projectedMember(answer: &Result<Answer, NoRejection>) -> InherentLookup {
  let mut lookup = InherentLookup {published: Option<Shared<DeclarationId>>.none(), rejected: Option<Shared<Rejection>>.none()}
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.InherentMember {published, rejected}} = &value.outcome {
      if let Option<Shared<DeclarationId>>.Some {value: member} = &published {
        lookup.published = Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&member))
      }
      if let Option<Shared<Rejection>>.Some {value: rejection} = &rejected {
        lookup.rejected = Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&rejection))
      }
    }
  }
  return move lookup
}

fn sameMemberOption(left: &Option<Shared<DeclarationId>>, right: &Option<Shared<DeclarationId>>) -> bool {
  return match &left.* {
    Option<Shared<DeclarationId>>.Some {value} => match &right.* {
      Option<Shared<DeclarationId>>.Some {value: other} => Shared<DeclarationId>.with<bool>(&value,
        fn(first: &DeclarationId) -> bool { return Shared<DeclarationId>.with<bool>(&other, fn(second: &DeclarationId) -> bool { return DeclarationId.equals(first, second) }) })
      Option<Shared<DeclarationId>>.None => false
    }
    Option<Shared<DeclarationId>>.None => match &right.* { Option<Shared<DeclarationId>>.None => true _ => false }
  }
}

fn optionNone<T>(value: &Option<T>) -> bool {
  return match &value.* { Option<T>.None => true _ => false }
}

// Resolve propagated diagnostic evidence, not the requesting instance's module.
fn rejectionModuleOrdinal(resolver: &Resolver, diagnostic: &Shared<Rejection>) -> usize {
  return Shared<Rejection>.with<usize>(diagnostic, fn(value: &Rejection) -> usize {
    return knownModuleOrdinal(resolver, &value.module)
  })
}

// The interned ordinal of the module that declares a nominal type, if this store knows it.
fn declaringModuleOrdinal(resolver: &Resolver, value: &Shared<Type>) -> usize {
  return Shared<Type>.with<usize>(
    value,
    fn(applied: &Type) -> usize {
      return match & applied.* {
        Type.Nominal {declaration, ..} => knownModuleOrdinal(resolver, DeclarationId.moduleId(&declaration))
        _ => usize.MAX
      }
    },
  )
}

// Whether two providers have the same owner: one nominal declaration, or one foundational spelling.
fn sameProviderOwner(left: &Type, right: &Type) -> bool {
  return match & left.* {
    Type.Nominal {declaration, ..} => match & right.* {
      Type.Nominal {declaration: other, ..} => DeclarationId.equals(&declaration, &other)
      _ => false
    }
    Type.Primitive {name} => match & right.* {
      Type.Primitive {name: other} => same(Bytes.asSlice(&name), Bytes.asSlice(&other))
      _ => false
    }
    Type.String {..} => match & right.* {
      Type.String {..} => true
      _ => false
    }
    // A slice spelling is owned per access mode; its element is an ordinary head argument.
    Type.Slice {access, ..} => match & right.* {
      Type.Slice {access: other, ..} => access == other
      _ => false
    }
    Type.Unit => match & right.* {
      Type.Unit => true
      _ => false
    }
    _ => false
  }
}

fn providerOwnerWith(left: &Type, right: &Shared<Type>) -> bool {
  return Shared<Type>.with<bool>(
    right,
    fn(other: &Type) -> bool {
      return sameProviderOwner(left, other)
    },
  )
}

fn contractIs(applied: &Type, contract: &DeclarationId) -> bool {
  return match & applied.* {
    Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, contract)
    _ => false
  }
}

// Whether a conformance head implements `contract` for a provider with `provider`'s owner.
fn headMatches(head: &ImplementationHead, contract: &DeclarationId, provider: &Shared<Type>) -> bool {
  if let Option<Shared<Type>>.Some {value: applied} = &head.contract {
    if !Shared<Type>.with<bool>(
      &applied,
      fn(found: &Type) -> bool {
        return contractIs(found, contract)
      },
    ) {
      return false
    }
    return sameProviderShared(&head.provider, provider)
  }
  return false
}

fn typeAddress(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

// Owner equality for two type handles. A nominal handle is often the one cached identity answer,
// and a shared handle cannot be borrowed inside its own borrow, so one allocation compares first.
fn sameProviderShared(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared<Type>.with<usize>(left, typeAddress) == Shared<Type>.with<usize>(right, typeAddress) {
    return true
  }
  return Shared<Type>.with<bool>(
    left,
    fn(found: &Type) -> bool {
      return providerOwnerWith(found, right)
    },
  )
}

effect fn resolveConformanceHeads(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let applications = List<Shared<Type>>.asSlice(&resolver.applications)
  let provider = Shared<Type>.clone(&applications[key.name])
  let declarationAccess58 = declarationPosition(&resolver.*, key)
  let written = run header(&mut resolver.*, &module, declarationAccess58)
  let declarationAccess59 = declarationPosition(&resolver.*, key)
  let found = run declarationAt(&mut resolver.*, &module, declarationAccess59)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut isService = false
  let mut isContract = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    isContract = isContractHeader(value.header)
    if let Node.ServiceHeader {..} = value.header {
      isService = true
    }
  }
  let contract = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isContract {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidBound, span),
      move dependencies,
    )
  }
  // IMPL-004: only the contract's module and a nominal provider's module can own the conformance;
  // a service conformance lives with its provider. No other module is read.
  let mut modules = List<usize>.make()
  if !isService {
    run List<usize>.append(&mut modules, key.module)
  }
  let providerModule = declaringModuleOrdinal(&resolver.*, &provider)
  // A nominal provider's module is always read by the store that resolved it; any other provider
  // type did not come from this store and has no observable owner set.
  if providerModule == usize.MAX && Shared<Type>.with<bool>(&provider, isNominalType) {
    fail InvalidModulePath {}
  }
  if providerModule != usize.MAX && (isService || providerModule != key.module) {
    run List<usize>.append(&mut modules, providerModule)
  }
  let mut heads = List<Shared<ImplementationHead>>.make()
  let permitted = List<usize>.asSlice(&modules)
  let mut at = usize.ZERO
  while at < permitted.length {
    let declarationAccess60Request = Key {
      family: Family.ImplementationShapes,
      module: permitted[at],
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess60 = run internDeclaration(&mut resolver.*, declarationAccess60Request)
    let listKey = declarationAccess60
    let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, listKey, span)
    let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &listed,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return run memberRejected(move diagnostic, move dependencies)
    }
    // Only the heads whose provider hashes like this provider's owner can match it.
    let ownerHash = Shared<Type>.with<u64>(&provider, providerOwnerHash)
    let mut headAt = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
      fn(answer: &Result<Answer, NoRejection>) -> usize { return firstOwnedHead(answer, ownerHash) })
    while headAt != usize.MAX {
      let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
          return implementationAt(answer, headAt)
        },
      )
      if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
        let relevant = Shared<ImplementationHead>.with<bool>(
          &head,
          fn(implementation: &ImplementationHead) -> bool {
            return headMatches(implementation, &contract, &provider)
          },
        )
        if relevant {
          let identity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(&head,
            fn(value: &ImplementationHead) -> Shared<DeclarationId> { return Shared<DeclarationId>.clone(&value.declaration) })
          let sourceModule = resolvedModule(&resolver.*, permitted[at])
          let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &sourceModule, &identity) {
            Option<usize>.Some {value} => value
            Option<usize>.None => { fail RevisionMismatch {} }
          }
          let checkedKey = run internDeclaration(&mut resolver.*, Key {family: Family.ImplementationHead,
            module: permitted[at], name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false})
          let checked = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, checkedKey, span)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&checked, answerCause) {
            return run memberRejected(move diagnostic, move dependencies)
          }
          if let Option<Shared<ImplementationHead>>.Some {value: valid} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&checked, headOf) {
            run List<Shared<ImplementationHead>>.append(&mut heads, move valid)
          }
        }
      }
      headAt = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
        fn(answer: &Result<Answer, NoRejection>) -> usize { return nextOwnedHead(answer, headAt) })
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.ConformanceHeads {heads: move heads}, move dependencies)
}

fn implementationCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Implementations {heads, ..}} => List<
        Shared<ImplementationHead>,
      >.length(&heads)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn implementationAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<
  Shared<ImplementationHead>,
> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Implementations {heads, ..}} = &value.outcome {
      let listed = List<Shared<ImplementationHead>>.asSlice(&heads)
      if at < listed.length {
        return Option<Shared<ImplementationHead>>.some(
          Shared<ImplementationHead>.clone(&listed[at]),
        )
      }
    }
  }
  return Option<Shared<ImplementationHead>>.none()
}

// The applied head of one conformance, with what coherence reads from it.
struct HeadTerms {
  declaration: Shared<DeclarationId>,
  contract: Shared<Type>,
  provider: Shared<Type>,
  span: Span,
  bounded: bool,
  typeBinders: usize,
  lifetimeBinders: usize,
  rowBinders: usize,
}

// The head terms of a conformance; absent for an inherent or sealed-property head.
fn headTerms(head: &ImplementationHead) -> Option<HeadTerms> {
  if let Option<Shared<Type>>.Some {value: contract} = &head.contract {
    let constraints = List<Constraint>.asSlice(&head.binders.constraints)
    // Representation bounds reified from the heads are part of the head, not written bounds.
    let bounded = constraints.length > head.reified
    return Option<HeadTerms>.some(
      HeadTerms {
        declaration: Shared<DeclarationId>.clone(&head.declaration),
        contract: Shared<Type>.clone(&contract),
        provider: Shared<Type>.clone(&head.provider),
        span: head.span,
        bounded: bounded,
        typeBinders: List<Shared<Type>>.length(&head.binders.typeParameters),
        lifetimeBinders: List<Shared<Lifetime>>.length(&head.binders.lifetimeParameters),
        rowBinders: List<RowParameter>.length(&head.binders.rowParameters),
      },
    )
  }
  return Option<HeadTerms>.none()
}

// The terms coherence compares. A sealed property is its own contract, so a sealed head compares
// its provider in both positions; an inherent head has no goal to be coherent about.
fn coherenceTerms(head: &ImplementationHead) -> Option<HeadTerms> {
  if let ImplementationKind.Sealed {..} = &head.kind {
    let constraints = List<Constraint>.asSlice(&head.binders.constraints)
    return Option<HeadTerms>.some(
      HeadTerms {
        declaration: Shared<DeclarationId>.clone(&head.declaration),
        contract: Shared<Type>.clone(&head.provider),
        provider: Shared<Type>.clone(&head.provider),
        span: head.span,
        bounded: constraints.length > head.reified,
        typeBinders: List<Shared<Type>>.length(&head.binders.typeParameters),
        lifetimeBinders: List<Shared<Lifetime>>.length(&head.binders.lifetimeParameters),
        rowBinders: List<RowParameter>.length(&head.binders.rowParameters),
      },
    )
  }
  return headTerms(head)
}

// The sealed property a head requests; absent for inherent and conformance heads.
fn sealedPropertyOfHead(head: &ImplementationHead) -> Option<SealedProperty> {
  if let ImplementationKind.Sealed {property} = &head.kind {
    return Option<SealedProperty>.some(property)
  }
  return Option<SealedProperty>.none()
}

fn copyTerms(terms: &HeadTerms) -> HeadTerms {
  return HeadTerms {
    declaration: Shared<DeclarationId>.clone(&terms.declaration),
    contract: Shared<Type>.clone(&terms.contract),
    provider: Shared<Type>.clone(&terms.provider),
    span: terms.span,
    bounded: terms.bounded,
    typeBinders: terms.typeBinders,
    lifetimeBinders: terms.lifetimeBinders,
    rowBinders: terms.rowBinders,
  }
}

fn headSpanOf(head: &ImplementationHead) -> Span {
  return head.span
}

fn headAddress(head: &ImplementationHead) -> usize {
  return Pointer.address<ImplementationHead>(Pointer.fromRef<ImplementationHead>(head))
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn declarationEqualsShared(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared<DeclarationId>.with<bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

// Whether two shared identities are equal; one allocation is never borrowed inside itself.
fn sameDeclarationShared(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared<DeclarationId>.with<usize>(left, declarationAddress) == Shared<
    DeclarationId,
  >.with<
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared<DeclarationId>.with<bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return declarationEqualsShared(first, right)
    },
  )
}

fn termsBeforeBorrowed(
  left: &DeclarationId,
  right: &Shared<DeclarationId>,
  start: usize,
  otherStart: usize,
) -> bool {
  return Shared<DeclarationId>.with<bool>(
    right,
    fn(compared: &DeclarationId) -> bool {
      let order = ModuleId.compare(DeclarationId.moduleId(left), DeclarationId.moduleId(compared))
      return order < 0 || (order == 0 && start < otherStart)
    },
  )
}

// The canonical order of conformance heads: the owning module's identity bytes, then the head's
// source position. Discovery, demand, and allocation order never take part.
fn termsBefore(first: &HeadTerms, second: &HeadTerms) -> bool {
  let start = first.span.start
  let otherStart = second.span.start
  return Shared<DeclarationId>.with<bool>(
    &first.declaration,
    fn(left: &DeclarationId) -> bool {
      return termsBeforeBorrowed(left, &second.declaration, start, otherStart)
    },
  )
}

// The interned ordinal of `module`, or `usize.MAX` when this store has not interned it.
fn knownModuleOrdinal(resolver: &Resolver, module: &ModuleId) -> usize {
  let modules = List<ModuleId>.asSlice(&resolver.modules)
  let mut at = InternIndex.first(&resolver.moduleLookup, ModuleId.hash(module))
  while at != usize.MAX {
    if ModuleId.equals(&modules[at], module) {
      return at
    }
    at = InternIndex.after(&resolver.moduleLookup, at)
  }
  return usize.MAX
}

fn headConstraintCount(head: &ImplementationHead) -> usize {
  return List<Constraint>.length(&head.binders.constraints)
}

fn headWrittenBinders(head: &ImplementationHead) -> usize {
  return List<Span>.length(&head.binderSpans)
}

fn headBinderCount(head: &ImplementationHead) -> usize {
  return List<Shared<Type>>.length(&head.binders.typeParameters) + List<Shared<Lifetime>>.length(
    &head.binders.lifetimeParameters,
  ) + List<RowParameter>.length(&head.binders.rowParameters)
}

fn headBinderSpanAt(head: &ImplementationHead, at: usize) -> Span {
  let spans = List<Span>.asSlice(&head.binderSpans)
  if at < spans.length {
    return spans[at]
  }
  return head.span
}

// One written conformance bound of an implementation, with its anchor.
struct HeadBound {
  provider: Shared<Type>,
  contract: Shared<Type>,
  span: Span,
}

fn headBoundAt(head: &ImplementationHead, at: usize) -> Option<HeadBound> {
  let constraints = List<Constraint>.asSlice(&head.binders.constraints)
  let spans = List<Span>.asSlice(&head.boundSpans)
  if let Constraint.Conforms {provider, contract} = &constraints[at] {
    let mut span = head.span
    if at < spans.length {
      span = spans[at]
    }
    return Option<HeadBound>.some(
      HeadBound {
        provider: Shared<Type>.clone(&provider),
        contract: Shared<Type>.clone(&contract),
        span: span,
      },
    )
  }
  return Option<HeadBound>.none()
}

// Whether two applications apply the same nominal declaration.
fn sameNominalBorrowed(first: &Type, right: &Shared<Type>) -> bool {
  return Shared<Type>.with<bool>(
    right,
    fn(second: &Type) -> bool {
      if let Type.Nominal {declaration, ..} = &first.* {
        if let Type.Nominal {declaration: other, ..} = &second.* {
          return DeclarationId.equals(&declaration, &other)
        }
      }
      return false
    },
  )
}

fn sameNominal(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared<Type>.with<usize>(left, typeAddress) == Shared<Type>.with<usize>(right, typeAddress) {
    return true
  }
  return Shared<Type>.with<bool>(
    left,
    fn(first: &Type) -> bool {
      return sameNominalBorrowed(first, right)
    },
  )
}

// How often a head binder occurs in `value`, counting the parameters of each representation that
// stands in `value` for its contract, as an `Effect` type in a head does (REP-001).
fn headOccurrences(
  value: &Shared<Type>,
  implementation: &DeclarationId,
  ordinal: usize,
  representations: &[Constraint],
) -> usize {
  let mut count = Type.occurrences(value, implementation, ordinal)
  let mut at = usize.ZERO
  while at < representations.length {
    if let Constraint.Represents {parameter, contract} = &representations[at] {
      let standing = Shared<Type>.with<usize>(&parameter, fn(found: &Type) -> usize {
        return Type.parameterOrdinalOf(found, implementation)
      })
      if standing != usize.MAX && standing != ordinal {
        let uses = Type.occurrences(value, implementation, standing)
        if uses > usize.ZERO {
          count = count + uses * Type.occurrences(&contract, implementation, ordinal)
        }
      }
    }
    at = at + usize.ONE
  }
  return count
}

// IMPL-008: a bound's provider must be a strict structural part of the conformance provider, the
// bound may not repeat an open parameter more often than the head does, and a bound on the same
// interface may not rewrite an argument the head fixes. A bound provider is always one of the
// implementation's parameters and every provider is nominal, so a present parameter is a strict
// part. Termination follows from the declaration alone; no proof is attempted.
effect fn terminationStep(
  required: &HeadBound,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  implementation: &DeclarationId,
  binderCount: usize,
  representations: &[Constraint],
) -> Option<TerminationStep> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let subject = Shared<Type>.with<usize>(
    &required.provider,
    fn(value: &Type) -> usize {
      return Type.parameterOrdinalOf(value, implementation)
    },
  )
  if subject == usize.MAX || headOccurrences(provider, implementation, subject, representations) == usize.ZERO {
    return Option<TerminationStep>.some(TerminationStep.Peer)
  }
  let mut ordinal = usize.ZERO
  while ordinal < binderCount {
    let declared = headOccurrences(contract, implementation, ordinal, representations) + headOccurrences(
      provider,
      implementation,
      ordinal,
      representations,
    )
    let demanded = headOccurrences(&required.provider, implementation, ordinal, representations) + headOccurrences(
      &required.contract,
      implementation,
      ordinal,
      representations,
    )
    if demanded > declared {
      return Option<TerminationStep>.some(TerminationStep.DuplicatedParameter)
    }
    ordinal = ordinal + usize.ONE
  }
  if sameNominal(&required.contract, contract) && run Type.changesFixedArgument(
    contract,
    &required.contract,
    implementation,
  ) {
    return Option<TerminationStep>.some(TerminationStep.ChangedFixedArgument)
  }
  return Option<TerminationStep>.none()
}

effect fn rejectTermination(module: &ModuleId, span: Span, step: TerminationStep) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.NonterminatingConformance,
      module: ModuleId.copy(module),
      span: span,
      related: Option<RelatedSite>.none(),
      path: List<Shared<DeclarationId>>.make(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: step,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: List<MessageArgument>.make(), owner: usize.MAX,
    },
  )
}

// A conflict is reported at the primary head, with the primary and then the related declaration.
effect fn rejectConflict(
  module: &ModuleId,
  code: RejectionCode,
  primary: &HeadTerms,
  related: &HeadTerms,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  // A duplicate names its contract and provider (SEM0083); an overlap keeps its own message.
  let mut arguments = List<MessageArgument>.make()
  if code == RejectionCode.DuplicateConformance {
    arguments = run detailArguments(run duplicateImplementationDetail(module, &primary.contract, &primary.provider))
  }
  let mut path = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(
    &mut path,
    Shared<DeclarationId>.clone(&primary.declaration),
  )
  run List<Shared<DeclarationId>>.append(
    &mut path,
    Shared<DeclarationId>.clone(&related.declaration),
  )
  return run Shared<Rejection>.make(
    Rejection {
      code: code,
      module: ModuleId.copy(module),
      span: primary.span,
      related: Option<RelatedSite>.none(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: move arguments, owner: usize.MAX,
    },
  )
}

// Unifies both applications of two heads under one set of bindings. A head's representation
// overlaps a type only where that type admits its contract, and two heads sharing one
// representation overlap only where their contracts unify: selection admits a representation by
// its own contract, so contracts that never unify select disjoint goals.
effect fn headsUnify(
  first: &HeadTerms,
  second: &HeadTerms,
  firstBounds: &[Constraint],
  secondBounds: &[Constraint],
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut lefts = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut lefts, Shared<Type>.clone(&first.contract))
  run List<Shared<Type>>.append(&mut lefts, Shared<Type>.clone(&first.provider))
  let mut rights = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut rights, Shared<Type>.clone(&second.contract))
  run List<Shared<Type>>.append(&mut rights, Shared<Type>.clone(&second.provider))
  let mut bindings = List<Binding>.make()
  let heads = run Type.unifyAll(
    List<Shared<Type>>.asSlice(&lefts),
    List<Shared<Type>>.asSlice(&rights),
    variables,
    comparison,
    &mut bindings,
  )
  if !exactHeadMatched(&heads) { return move heads }
  let fixedFirst = run admitBounds(firstBounds, variables, comparison, &mut bindings)
  if !exactHeadMatched(&fixedFirst) { return move fixedFirst }
  let fixedSecond = run admitBounds(secondBounds, variables, comparison, &mut bindings)
  if !exactHeadMatched(&fixedSecond) { return move fixedSecond }
  let mut firstAt = usize.ZERO
  while firstAt < firstBounds.length {
    if let Constraint.Represents {parameter, contract} = &firstBounds[firstAt] {
      let selected = run Type.applyBindings(&parameter, List<Binding>.asSlice(&bindings), true)
      let mut secondAt = usize.ZERO
      while secondAt < secondBounds.length {
        if let Constraint.Represents {parameter: other, contract: otherContract} = &secondBounds[secondAt] {
          let competing = run Type.applyBindings(&other, List<Binding>.asSlice(&bindings), true)
          if run Type.equalsShared(&selected, &competing) {
            let shared = run Type.unify(&contract, &otherContract, variables, comparison, &mut bindings)
            if !exactHeadMatched(&shared) { return move shared }
          }
        }
        secondAt = secondAt + usize.ONE
      }
    }
    firstAt = firstAt + usize.ONE
  }
  return Unification.Unified
}

// Duplicate identity compares the full head under one positional bijection of the impl binders.
// This is independent of one-sided exact matching, which deliberately leaves open sets undecided.
effect fn exactlyEquivalent(first: &HeadTerms, second: &HeadTerms, firstBounds: &[Constraint],
  secondBounds: &[Constraint]) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if first.typeBinders != second.typeBinders || first.lifetimeBinders != second.lifetimeBinders || first.rowBinders != second.rowBinders {
    return false
  }
  let count = first.typeBinders + first.lifetimeBinders + first.rowBinders
  if !run Type.alphaEquivalent(&first.contract, &first.provider, &second.contract, &second.provider, count) {
    return false
  }
  // Reified representations are equivalent only with equivalent contracts.
  if firstBounds.length != secondBounds.length { return false }
  let mut at = usize.ZERO
  while at < firstBounds.length {
    if let Constraint.Represents {parameter, contract} = &firstBounds[at] {
      if let Constraint.Represents {parameter: other, contract: otherContract} = &secondBounds[at] {
        if !run Type.alphaEquivalent(&parameter, &contract, &other, &otherContract, count) { return false }
      }
    }
    at = at + usize.ONE
  }
  return true
}

fn bucketCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ConformanceHeads {heads}} => List<
        Shared<ImplementationHead>,
      >.length(&heads)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn bucketAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<ImplementationHead>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ConformanceHeads {heads}} = &value.outcome {
      let listed = List<Shared<ImplementationHead>>.asSlice(&heads)
      if at < listed.length {
        return Option<Shared<ImplementationHead>>.some(
          Shared<ImplementationHead>.clone(&listed[at]),
        )
      }
    }
  }
  return Option<Shared<ImplementationHead>>.none()
}

fn containsOrdinal(values: &List<usize>, ordinal: usize) -> bool {
  let listed = List<usize>.asSlice(values)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Coherence of one conformance `impl`, decided before any applicability or bound proof.
//
// IMPL-006: every written parameter occurs in the interface application or the provider. IMPL-008:
// every bound descends structurally. IMPL-007: no other head of the complete owner bucket could
// name the same goal once lifetimes are erased; bounds are never consulted, and no head wins by
// source or demand order. A conflict is one fixed pair: the canonically later head is primary, the
// earliest conflicting other head related, so every head of the pair reports the same rejection.
// Duplicate names only two unbounded heads that are exact renamings of each other. An open set the
// projection cannot decide leaves the head Unsupported, never a conflict or a success.
// The conformance heads sharing one contract and provider application (IMPL-004 owners).
effect fn conformanceCandidates(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  terms: &HeadTerms,
  span: Span,
) -> Result<List<Shared<ImplementationHead>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let contractModule = declaringModuleOrdinal(&resolver.*, &terms.contract)
  if contractModule == usize.MAX {
    return Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    )
  }
  let contractModuleId = resolvedModule(&resolver.*, contractModule)
  let located = run ordinalOfProvider(&mut resolver.*, &contractModuleId, &terms.contract)
  let contractOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let declarationAccess61Request = Key {
    family: Family.ConformanceHeads,
    module: contractModule,
    name: run internApplication(&mut resolver.*, &terms.provider),
    declaration: contractOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess61 = run internDeclaration(&mut resolver.*, declarationAccess61Request)
  let bucketKey = declarationAccess61
  let bucket = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, bucketKey, span)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &bucket,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
    return Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.failResult(move diagnostic)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&bucket, bucketCount)
  let mut heads = List<Shared<ImplementationHead>>.make()
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &bucket,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return bucketAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value} = move candidate {
      run List<Shared<ImplementationHead>>.append(&mut heads, move value)
    }
    at = at + usize.ONE
  }
  return Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.succeed(move heads)
}

// The heads requesting one sealed property, read from the implementing module and the
// provider's declaring module, the only modules that may own a sealed `impl`.
effect fn sealedCandidates(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  implementing: usize,
  provider: &Shared<Type>,
  property: SealedProperty,
  span: Span,
) -> Result<List<Shared<ImplementationHead>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut modules = List<usize>.make()
  run List<usize>.append(&mut modules, implementing)
  let providerModule = declaringModuleOrdinal(&resolver.*, provider)
  if providerModule != usize.MAX && providerModule != implementing {
    run List<usize>.append(&mut modules, providerModule)
  }
  let owners = List<usize>.asSlice(&modules)
  let mut heads = List<Shared<ImplementationHead>>.make()
  let mut moduleAt = usize.ZERO
  while moduleAt < owners.length {
    // Shapes, not proven heads: an implementation head proves its own obligations through this
    // catalog, as `impl Read<Args<Flag, Flag>> for Table` proves `Flag: Copy`, so reading heads
    // here would wait on that same head (SEM0223). Each head's obligations are still proven by
    // its own query.
    let declarationAccess62Request = Key {
      family: Family.ImplementationShapes,
      module: owners[moduleAt],
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess62 = run internDeclaration(&mut resolver.*, declarationAccess62Request)
    let listKey = declarationAccess62
    let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, listKey, span)
    let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &listed,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.failResult(move value)
    }
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, implementationCount)
    let mut at = usize.ZERO
    while at < count {
      let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
          return implementationAt(answer, at)
        },
      )
      if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
        let requested = Shared<ImplementationHead>.with<Option<SealedProperty>>(&head, sealedPropertyOfHead)
        if let Option<SealedProperty>.Some {value: found} = move requested {
          if found == property {
            run List<Shared<ImplementationHead>>.append(&mut heads, move head)
          }
        }
      }
      at = at + usize.ONE
    }
    moduleAt = moduleAt + usize.ONE
  }
  return Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.succeed(move heads)
}

effect fn resolveCoherence(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &headAnswer,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return run memberRejected(move diagnostic, move dependencies)
      }
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let span = Shared<ImplementationHead>.with<Span>(&head, headSpanOf)
  let found = Shared<ImplementationHead>.with<Option<HeadTerms>>(&head, coherenceTerms)
  // An inherent head has no goal to be coherent about.
  let terms = match move found {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  let declarationAccess63 = declarationPosition(&resolver.*, key)
  let identity = run declarationAt(&mut resolver.*, &module, declarationAccess63)
  let implementation = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  let mut types = List<usize>.make()
  let mut regions = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(&terms.contract, &implementation, &mut types, &mut regions, &mut rows)
  run Type.collectOwned(&terms.provider, &implementation, &mut types, &mut regions, &mut rows)
  // A determined representation determines the parameters its contract names (REP-001).
  let ownBounds = run headRepresentations(&head)
  let representations = List<Constraint>.asSlice(&ownBounds)
  let mut boundAt = usize.ZERO
  while boundAt < representations.length {
    if let Constraint.Represents {parameter, contract} = &representations[boundAt] {
      let ordinal = Shared<Type>.with<usize>(&parameter, fn(value: &Type) -> usize {
        return Type.parameterOrdinalOf(value, &implementation)
      })
      if containsOrdinal(&types, ordinal) {
        run Type.collectOwned(&contract, &implementation, &mut types, &mut regions, &mut rows)
      }
    }
    boundAt = boundAt + usize.ONE
  }
  let written = Shared<ImplementationHead>.with<usize>(&head, headWrittenBinders)
  let mut binder = usize.ZERO
  while binder < written {
    if !containsOrdinal(&types, binder) && !containsOrdinal(&regions, binder) && !containsOrdinal(
      &rows,
      binder,
    ) {
      let anchor = Shared<ImplementationHead>.with<Span>(
        &head,
        fn(value: &ImplementationHead) -> Span {
          return headBinderSpanAt(value, binder)
        },
      )
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnconstrainedImplParameter, anchor),
        move dependencies,
      )
    }
    binder = binder + usize.ONE
  }
  let binderCount = Shared<ImplementationHead>.with<usize>(&head, headBinderCount)
  let constraints = Shared<ImplementationHead>.with<usize>(&head, headConstraintCount)
  let mut bound = usize.ZERO
  while bound < constraints {
    let declared = Shared<ImplementationHead>.with<Option<HeadBound>>(
      &head,
      fn(value: &ImplementationHead) -> Option<HeadBound> {
        return headBoundAt(value, bound)
      },
    )
    if let Option<HeadBound>.Some {value: required} = move declared {
      let step = run terminationStep(
        &required,
        &terms.contract,
        &terms.provider,
        &implementation,
        binderCount,
        representations,
      )
      if let Option<TerminationStep>.Some {value: reason} = move step {
        return run memberRejected(
          run rejectTermination(&module, required.span, reason),
          move dependencies,
        )
      }
    }
    bound = bound + usize.ONE
  }
  let property = Shared<ImplementationHead>.with<Option<SealedProperty>>(&head, sealedPropertyOfHead)
  let gathered = match move property {
    Option<SealedProperty>.Some {value: sealed} => run sealedCandidates(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &terms.provider,
      sealed,
      span,
    )
    Option<SealedProperty>.None => run conformanceCandidates(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      &module,
      &terms,
      span,
    )
  }
  let candidates = match move gathered {
    Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<ImplementationHead>>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let listed = List<Shared<ImplementationHead>>.asSlice(&candidates)
  let mut conflicts = List<HeadTerms>.make()
  let mut conflictHeads = List<Shared<ImplementationHead>>.make()
  let mut undecided = false
  let mut at = usize.ZERO
  while at < listed.length {
    let candidate = Option<Shared<ImplementationHead>>.some(
      Shared<ImplementationHead>.clone(&listed[at]),
    )
    if let Option<Shared<ImplementationHead>>.Some {value: other} = move candidate {
      let otherTerms = Shared<ImplementationHead>.with<Option<HeadTerms>>(&other, coherenceTerms)
      if let Option<HeadTerms>.Some {value: competing} = move otherTerms {
        if !sameDeclarationShared(&competing.declaration, &terms.declaration) {
          let mut variables = List<Shared<DeclarationId>>.make()
          run List<Shared<DeclarationId>>.append(
            &mut variables,
            Shared<DeclarationId>.clone(&terms.declaration),
          )
          run List<Shared<DeclarationId>>.append(
            &mut variables,
            Shared<DeclarationId>.clone(&competing.declaration),
          )
          let competingBounds = run headRepresentations(&other)
          let overlap = run headsUnify(
            &terms,
            &competing,
            List<Constraint>.asSlice(&ownBounds),
            List<Constraint>.asSlice(&competingBounds),
            List<Shared<DeclarationId>>.asSlice(&variables),
            Comparison.Projection,
          )
          match & overlap {
            Unification.Unified => {
              run List<HeadTerms>.append(&mut conflicts, move competing)
              run List<Shared<ImplementationHead>>.append(&mut conflictHeads, Shared<ImplementationHead>.clone(&other))
            }
            Unification.Undetermined {..} => {
              undecided = true
            }
            Unification.Distinct => {}
          }
        }
      }
    }
    at = at + usize.ONE
  }
  let others = List<HeadTerms>.asSlice(&conflicts)
  if others.length == usize.ZERO {
    if undecided {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
    return memberSuccess(Value.Coherent, move dependencies)
  }
  let mut least = usize.ZERO
  let mut position = usize.ONE
  while position < others.length {
    if termsBefore(&others[position], &others[least]) {
      least = position
    }
    position = position + usize.ONE
  }
  let leastHeads = List<Shared<ImplementationHead>>.asSlice(&conflictHeads)
  let leastBounds = run headRepresentations(&leastHeads[least])
  let mut primary = copyTerms(&terms)
  let mut related = copyTerms(&others[least])
  if termsBefore(&terms, &others[least]) {
    primary = copyTerms(&others[least])
    related = copyTerms(&terms)
  }
  let mut code = RejectionCode.OverlappingConformance
  if !primary.bounded && !related.bounded && run exactlyEquivalent(&terms, &others[least],
    List<Constraint>.asSlice(&ownBounds), List<Constraint>.asSlice(&leastBounds)) {
    code = RejectionCode.DuplicateConformance
  }
  let primaryModule = Shared<DeclarationId>.with<usize>(
    &primary.declaration,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  let mut anchor = ModuleId.copy(&module)
  if primaryModule != usize.MAX {
    anchor = resolvedModule(&resolver.*, primaryModule)
  }
  return run memberRejected(run rejectConflict(&anchor, code, &primary, &related), move dependencies)
}

// One member written in a conformance `impl`, before any mapped target is resolved.
struct WrittenMember {
  ordinal: usize,
  name: Bytes,
  span: Span,
  mapped: HirRef,
}

effect fn writtenMembers(resolver: &mut Resolver, module: &ModuleId, implementation: usize) -> List<
  WrittenMember,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut members = List<WrittenMember>.make()
  let answer = run observedDeclaration(&mut resolver.*, module, implementation, SourceFacet.Enclosed)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(value)
    let mut at = ModuleIndex.firstEnclosed(index, implementation)
    while at != usize.MAX {
      if enclosedBy(&declarations[at], implementation) {
        let written = Module.node(hir, declarations[at].header)
        let mut name = HirRef.absent()
        let mut mapped = HirRef.absent()
        if let Node.FunctionHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
        }
        if let Node.ImplAliasHeader {name: spelled, target, ..} = written {
          name = HirRef.of(spelled)
          mapped = HirRef.of(target)
        }
        if name.present {
          if let Node.Name {text} = Module.node(hir, name.id) {
            run List<WrittenMember>.append(
              &mut members,
              WrittenMember {
                ordinal: at,
                name: run Bytes.copy(Module.text(hir, text)),
                span: Module.span(hir, declarations[at].header),
                mapped: mapped,
              },
            )
          }
        }
      }
      at = ModuleIndex.nextEnclosed(index, at)
    }
  }
  return move members
}

fn isFunctionHeader(header: Node) -> bool {
  return match header { Node.FunctionHeader {..} => true _ => false }
}

// Whether a declaration header is a named function.
effect fn isFunctionDeclaration(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run observedHeader(&mut resolver.*, module, ordinal, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.FunctionHeader {..} = value.header {
      return true
    }
  }
  return false
}

// The scalar intrinsic a mapping's right side names: `Intrinsic.member` where the member is an
// unchecked, safe scalar operation with no type arguments. Any other intrinsic stays unavailable.
effect fn mappedIntrinsic(resolver: &mut Resolver, module: &ModuleId, written: HirId) -> Option<IntrinsicMember>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let parsed = run path(&mut resolver.*, module, written)
  let segments = List<Bytes>.asSlice(&parsed.segments)
  if !parsed.valid || segments.length != 2 || !same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic") {
    return Option<IntrinsicMember>.none()
  }
  let found = intrinsicLookup(Bytes.asSlice(&segments[usize.ONE]))
  if let Option<IntrinsicMember>.Some {value: member} = move found {
    if let IntrinsicMember.Scalar {operation} = member {
      if !ScalarOperation.checked(operation) && intrinsicTypeArity(member) == usize.ZERO && !intrinsicIsUnsafe(member) {
        return Option<IntrinsicMember>.some(member)
      }
    }
  }
  return Option<IntrinsicMember>.none()
}

// Resolves a mapping's right side from its written path only: a function of this module or of an
// imported namespace, or an inherent member published by a named owner. No body is read.
effect fn mappedTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  written: HirId,
) -> Result<Shared<DeclarationId>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let parsed = run path(&mut resolver.*, module, written)
  let segments = List<Bytes>.asSlice(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 {
    return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, parsed.span),
    )
  }
  let first = Bytes.asSlice(&segments[usize.ZERO])
  // `Intrinsic` is the sealed compiler namespace; no intrinsic operation is mapped in this unit.
  if same(first, b"Intrinsic") {
    return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.IntrinsicWitnessUnavailable, parsed.span),
    )
  }
  let mut functionModule = moduleOrdinal
  let mut functionName = first
  let mut external = false
  if segments.length == 2 {
    let namedSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, first, false)
    let named = match move namedSelection {
      Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(move error)
      }
    }
    functionName = Bytes.asSlice(&segments[usize.ONE])
    if named.count == usize.ONE && named.kind == CandidateKind.ImportModule {
      let declarationAccess64Request = Key {
        family: Family.Import,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: named.declaration,
        member: usize.MAX,
        external: false,
      }
      let declarationAccess64 = run internDeclaration(&mut resolver.*, declarationAccess64Request)
      let importKey = declarationAccess64
      let imported = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        importKey,
        parsed.span,
      )
      let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(
        &imported,
        fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) },
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
        return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(move diagnostic)
      }
      if let Option<usize>.Some {value: targetModule} = move binding.module {
        functionModule = targetModule
        external = true
      }
    } else {
      // A nominal qualifier reaches only the owner's published inherent members.
      let selectedOwner = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        first,
        false,
        parsed.span,
        RejectionCode.UnknownType, RejectionCode.NotType, false)
      let ownerDeclaration = match move selectedOwner {
        Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
        Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(move error)
        }
      }
      let membersKey = run inherentMemberKey(&mut resolver.*, ownerDeclaration.module, ownerDeclaration.ordinal, functionName)
      let listed = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        membersKey,
        parsed.span,
      )
      let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &listed,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(move diagnostic)
      }
      let lookup = Shared<Result<Answer, NoRejection>>.with<InherentLookup>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
          return projectedMember(answer)
        },
      )
      let InherentLookup {published, rejected} = move lookup
      if let Option<Shared<DeclarationId>>.Some {value} = move published {
        return Result<Shared<DeclarationId>, Shared<Rejection>>.succeed(move value)
      }
      // An unpublished member keeps its own rejection; no other member is chosen.
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
        return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(move diagnostic)
      }
      // Otherwise the owner's actor function: an unassociated function of its declaring module
      // (IMPL-002).
      functionModule = ownerDeclaration.module
      external = ownerDeclaration.module != moduleOrdinal
    }
  }
  let selected = run selectDeclaration(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    functionModule,
    module,
    functionName,
    external,
    parsed.span,
    RejectionCode.UnknownFunction, RejectionCode.NotCallable, false)
  let target = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(move error)
    }
  }
  let targetModule = resolvedModule(&resolver.*, target.module)
  if !run isFunctionDeclaration(&mut resolver.*, &targetModule, target.ordinal) {
    return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.NotCallable, parsed.span),
    )
  }
  let identity = run declarationAt(&mut resolver.*, &targetModule, target.ordinal)
  if let Option<DeclarationId>.Some {value} = move identity {
    return Result<Shared<DeclarationId>, Shared<Rejection>>.succeed(
      run Shared<DeclarationId>.make(move value),
    )
  }
  return Result<Shared<DeclarationId>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, parsed.span),
  )
}

// The first earlier member written with the same name as the member at `at`.
fn earlierMemberNamed(entries: &[WrittenMember], at: usize) -> Option<usize> {
  let mut before = usize.ZERO
  while before < at {
    if same(Bytes.asSlice(&entries[before].name), Bytes.asSlice(&entries[at].name)) {
      return Option<usize>.some(before)
    }
    before = before + usize.ONE
  }
  return Option<usize>.none()
}

// Appends one written member of a conformance, resolving its mapped target when it has one.
effect fn appendImplementationMember(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  entry: &WrittenMember,
  members: &mut List<ImplementationMember>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let identity = run declarationAt(&mut resolver.*, module, entry.ordinal)
  let declared = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Option<Shared<Rejection>>.none()
    }
  }
  let declaration = run Shared<DeclarationId>.make(move declared)
  if !entry.mapped.present {
    run List<ImplementationMember>.append(
      &mut members.*,
      ImplementationMember.Inline {declaration: move declaration, span: entry.span},
    )
    return Option<Shared<Rejection>>.none()
  }
  let intrinsic = run mappedIntrinsic(&mut resolver.*, module, entry.mapped.id)
  if let Option<IntrinsicMember>.Some {value: member} = move intrinsic {
    run List<ImplementationMember>.append(
      &mut members.*,
      ImplementationMember.Intrinsic {declaration: move declaration, span: entry.span, member: member},
    )
    return Option<Shared<Rejection>>.none()
  }
  let resolved = run mappedTarget(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    entry.mapped.id,
  )
  match move resolved {
    Result<Shared<DeclarationId>, Shared<Rejection>>.Success {value: target} => {
      run List<ImplementationMember>.append(
        &mut members.*,
        ImplementationMember.Mapped {
          declaration: move declaration,
          span: entry.span,
          target: move target,
        },
      )
    }
    Result<Shared<DeclarationId>, Shared<Rejection>>.Failure {error} => {
      return Option<Shared<Rejection>>.some(move error)
    }
  }
  return Option<Shared<Rejection>>.none()
}

effect fn resolveImplementationMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess66 = declarationPosition(&resolver.*, key)
  let written = run header(&mut resolver.*, &module, declarationAccess66)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut conformance = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {target, ..} = value.header {
      conformance = target.present
    }
  }
  // Inherent members are reached through their owner; this list serves conformances.
  if !conformance {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let head = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, headKey, span)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &head,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let declarationAccess67 = declarationPosition(&resolver.*, key)
  let listed = run writtenMembers(&mut resolver.*, &module, declarationAccess67)
  let entries = List<WrittenMember>.asSlice(&listed)
  let mut members = List<ImplementationMember>.make()
  let mut at = usize.ZERO
  while at < entries.length {
    let duplicate = earlierMemberNamed(entries, at)
    if let Option<usize>.Some {value: before} = move duplicate {
      let earlier = run declarationAt(&mut resolver.*, &module, entries[before].ordinal)
      let detail = run duplicateMemberDetail(&module, &head, Bytes.asSlice(&entries[at].name))
      return run memberRejected(
        run rejectRelated(&module, RejectionCode.DuplicateConformanceMember, entries[at].span, move earlier, run detailArguments(move detail)),
        move dependencies,
      )
    }
    let failed = run appendImplementationMember(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      &entries[at],
      &mut members,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return run memberRejected(move diagnostic, move dependencies)
    }
    at = at + usize.ONE
  }
  // Duplicate names are reported above; a sealed head then checks the shape of its members.
  let sealed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&head, headOf)
  if let Option<Shared<ImplementationHead>>.Some {value: sealedHead} = move sealed {
    let refused = run sealedMemberRejection(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, &module, &sealedHead, entries, span)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refused {
      return run memberRejected(move diagnostic, move dependencies)
    }
  }
  return memberSuccess(Value.ImplementationMembers {members: move members}, move dependencies)
}

// A sealed-property member rejection carrying its `detail` message argument.
effect fn sealedMemberRefusal(module: &ModuleId, code: RejectionCode, span: Span, detail: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: run Bytes.copy(detail)})
  return run Shared<Rejection>.make(move diagnostic)
}

// The parts of a resolved `drop` member signature the sealed hook contract reads.
struct DropSignature {
  // Whether it is an ordinary runtime `fn`: not effect, static, unsafe or variadic, and owns no
  // type or row parameters. Own lifetimes are allowed; the hook instance binds them to `'static`.
  plain: bool,
  // The referent of a sole `&mut` parameter; absent for any other parameter list.
  receiver: Option<Shared<Type>>,
  unit: bool,
}

fn dropSignature(answer: &Result<Answer, NoRejection>) -> Option<DropSignature> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let plain = !signature.isEffect && !signature.isStatic && !signature.isUnsafe && !signature.isVariadic
        && List<Shared<Type>>.length(&signature.typeParameters) == usize.ZERO
        && List<RowParameter>.length(&signature.rowParameters) == usize.ZERO
      let mut receiver = Option<Shared<Type>>.none()
      let parameters = List<Shared<Type>>.asSlice(&signature.parameters)
      if parameters.length == usize.ONE {
        receiver = Shared<Type>.with<Option<Shared<Type>>>(&parameters[usize.ZERO], fn(parameter: &Type) -> Option<Shared<Type>> {
          if let Type.Reference {referent, access, ..} = &parameter.* {
            if access == Access.Mutable { return Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) }
          }
          return Option<Shared<Type>>.none()
        })
      }
      let unit = Shared<Type>.with<bool>(&signature.result, fn(result: &Type) -> bool {
        return match &result.* { Type.Unit => true _ => false }
      })
      return Option<DropSignature>.some(DropSignature {plain: plain, receiver: move receiver, unit: unit})
    }
  }
  return Option<DropSignature>.none()
}

// Whether the function declared at `ordinal` binds its first parameter as `mut`, which no sealed
// hook shape spells: the Drop hook's receiver is exactly `self: &mut Self`.
effect fn mutableFirstParameter(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      if let Node.FunctionHeader {contract, ..} = Module.node(hir, declarations[ordinal].header) {
        if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
          if parameters.length > usize.ZERO {
            if let Node.Parameter {mode, ..} = Module.node(hir, Module.child(hir, parameters, usize.ZERO)) {
              return mode == ParameterMode.Mutable
            }
          }
        }
      }
    }
  }
  return false
}

// DROP-001, INTR-006: a sealed head's members follow the property's own contract, since no
// interface operation list checks them. `impl Copy` declares no members. `impl Drop` declares
// exactly one inline `fn drop(self: &mut Self) -> ()`, which every cleanup of the provider calls
// with the dropped place; any other shape would be called with the wrong arguments or result.
effect fn sealedMemberRejection(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  head: &Shared<ImplementationHead>,
  entries: &[WrittenMember],
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let property = match move Shared<ImplementationHead>.with<Option<SealedProperty>>(head, sealedPropertyOfHead) {
    Option<SealedProperty>.Some {value} => value
    Option<SealedProperty>.None => { return Option<Shared<Rejection>>.none() }
  }
  if property == SealedProperty.Copy {
    if entries.length > usize.ZERO {
      return Option<Shared<Rejection>>.some(run sealedMemberRefusal(module, RejectionCode.InvalidCopyConformance, entries[usize.ZERO].span,
        b"`impl Copy` declares no members; the compiler copies the value"))
    }
    return Option<Shared<Rejection>>.none()
  }
  if property == SealedProperty.Transferable || property == SealedProperty.Concurrent {
    if entries.length > usize.ZERO {
      return Option<Shared<Rejection>>.some(run sealedMemberRefusal(module, RejectionCode.InvalidThreadPropertyConformance,
        entries[usize.ZERO].span, b"a thread property `impl` declares no members; it only asserts the property"))
    }
    return Option<Shared<Rejection>>.none()
  }
  let shape = b"the hook is `fn drop(self: &mut Self) -> ()`"
  let provider = Shared<ImplementationHead>.with<Shared<Type>>(head, fn(value: &ImplementationHead) -> Shared<Type> {
    return Shared<Type>.clone(&value.provider)
  })
  let mut found = false
  let mut at = usize.ZERO
  while at < entries.length {
    let entry = &entries[at]
    at = at + usize.ONE
    if found || entry.mapped.present || !same(Bytes.asSlice(&entry.name), b"drop") {
      return Option<Shared<Rejection>>.some(run sealedMemberRefusal(module, RejectionCode.InvalidDropImplementation, entry.span,
        b"`impl Drop` declares only `fn drop(self: &mut Self) -> ()`"))
    }
    found = true
    if !run isFunctionDeclaration(&mut resolver.*, module, entry.ordinal) {
      return Option<Shared<Rejection>>.some(run sealedMemberRefusal(module, RejectionCode.InvalidDropImplementation, entry.span, shape))
    }
    let signatureKey = run internDeclaration(&mut resolver.*, Key {
      family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: entry.ordinal, member: usize.ZERO, external: false,
    })
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, signatureKey, entry.span)
    // A signature that does not resolve is reported by its own query.
    let resolved = Shared<Result<Answer, NoRejection>>.with<Option<DropSignature>>(&answer, dropSignature)
    if let Option<DropSignature>.Some {value: signature} = move resolved {
      let mut receives = false
      if let Option<Shared<Type>>.Some {value: referent} = &signature.receiver {
        receives = run Type.runtimeEqualsShared(&referent, &provider)
      }
      let mutableReceiver = run mutableFirstParameter(&mut resolver.*, module, entry.ordinal)
      if !signature.plain || !receives || !signature.unit || mutableReceiver {
        return Option<Shared<Rejection>>.some(run sealedMemberRefusal(module, RejectionCode.InvalidDropImplementation, entry.span, shape))
      }
    }
  }
  if !found {
    return Option<Shared<Rejection>>.some(run sealedMemberRefusal(module, RejectionCode.InvalidDropImplementation, span,
      b"`impl Drop` must define `fn drop(self: &mut Self) -> ()`"))
  }
  return Option<Shared<Rejection>>.none()
}

// A nominal or alias name written in a field type. Its application arguments are scanned only once
// the target is known, because each argument's kind follows the target's binder at that position.
// Scans an application's arguments by the target's binder kinds: a type argument is a written type,
// a row argument is a requirement row, and a lifetime argument contributes nothing.
effect fn scanApplicationArguments(
  resolver: &mut Resolver,
  module: &ModuleId,
  declaration: usize,
  arguments: HirId,
  target: &[Binder],
  binders: &[Binder],
) -> FieldScan ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut scan = FieldScan {omitted: usize.ZERO, references: List<FieldReference>.make()}
  let mut scanNames = List<Bytes>.make()
  let mut nameAt = usize.ZERO
  while nameAt < binders.length { run List<Bytes>.append(&mut scanNames, run Bytes.copy(binderName(&binders[nameAt]))) nameAt = nameAt + usize.ONE }
  let names = List<Bytes>.asSlice(&scanNames)
  // Fields retains these complete argument trees; the enclosing annotation is not consumed.
  let answer = run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Fields)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    if let Node.TypeArguments {arguments: supplied, requirements, ..} = Module.node(hir, arguments) {
      // Arguments are consumed exactly as an application binds them: a lifetime binder takes a
      // written lifetime or elides without consuming one, and every other binder takes the next.
      let mut argumentAt = usize.ZERO
      let mut binderAt = usize.ZERO
      while binderAt < target.length && argumentAt < supplied.length {
        let argument = Module.child(hir, supplied, argumentAt)
        let isLifetime = match Module.node(hir, argument) {
          Node.Lifetime {..} => true
          _ => false
        }
        let kind = binderKind(&target[binderAt])
        if kind == GenericKind.Lifetime {
          if isLifetime {
            argumentAt = argumentAt + usize.ONE
          }
        } else {
          if kind == GenericKind.Requirement {
            run FieldSyntax.scanRowSyntax(hir, argument, names, &mut scan)
          } else if !isLifetime {
            run FieldSyntax.scanFieldType(hir, argument, names, &mut scan)
          }
          argumentAt = argumentAt + usize.ONE
        }
        binderAt = binderAt + usize.ONE
      }
      // Excess arguments are an arity error at the application; their types still name nothing here.
      while argumentAt < supplied.length {
        let argument = Module.child(hir, supplied, argumentAt)
        if let Node.Lifetime {..} = Module.node(hir, argument) {} else {
          run FieldSyntax.scanFieldType(hir, argument, names, &mut scan)
        }
        argumentAt = argumentAt + usize.ONE
      }
      if requirements.present {
        run FieldSyntax.scanRowSyntax(hir, requirements.id, names, &mut scan)
      }
    }
  }
  return move scan
}

// Scans a struct's, tuple's, or union's field types, or an alias's target, in written order.
effect fn scanDeclarationFields(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> FieldScan ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Fields)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length { return run FieldSyntax.declaration(IndexedSource.authored(value), declarations[ordinal].header) }
  }
  return FieldScan {omitted: usize.ZERO, references: List<FieldReference>.make()}
}

fn isAggregateHeader(header: Node) -> bool {
  return match header {
    Node.StructHeader {..} => true
    Node.TupleHeader {..} => true
    Node.UnionHeader {..} => true
    _ => false
  }
}

effect fn countWrittenLifetimes(resolver: &mut Resolver, module: &ModuleId, arguments: Range) -> usize
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut count = usize.ZERO
  let answer = run observedRange(&mut resolver.*, module, arguments)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < arguments.length {
      if let Node.Lifetime {..} = Module.node(hir, Module.child(hir, arguments, at)) {
        count = count + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return count
}

fn writtenLifetimeCount(binders: &[Binder]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Lifetime {..} = &binders[at] {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// Selects the declaration a field reference names, through module scope or one imported namespace.
effect fn fieldTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  declaration: usize,
  reference: &FieldReference,
) -> Result<SelectedDeclaration, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // The scan already selects this exact path and its arguments in Fields. Reading its
  // spelling must not additionally depend on the enclosing member annotation.
  let answer = run observedDeclaration(&mut resolver.*, module, declaration, SourceFacet.Fields)
  let parsed = run sourcePath(&resolver.*, module, reference.path, &answer)
  let segments = List<Bytes>.asSlice(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 {
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, reference.span),
    )
  }
  if segments.length == usize.ONE {
    return run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&segments[usize.ZERO]),
      false,
      reference.span,
      RejectionCode.UnknownType, RejectionCode.NotType, false)
  }
  let namespace = Bytes.asSlice(&segments[usize.ZERO])
  // A sealed family's field reference never reaches declaration lookup (see `qualifiedTypeDeclaration`).
  if same(namespace, b"Intrinsic") {
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, reference.span))
  }
  let selectedSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(move error)
    }
  }
  if selected.count != usize.ONE || selected.kind != CandidateKind.ImportModule {
    let mut code = RejectionCode.NotType
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownType
    } else if selected.count > usize.ONE {
      return Result<SelectedDeclaration, Shared<Rejection>>.failResult(run bindingCollision(module, selected, namespace))
    }
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, code, reference.span),
    )
  }
  let declarationAccess68Request = Key {
    family: Family.Import,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: selected.declaration,
    member: usize.MAX,
    external: false,
  }
  let declarationAccess68 = run internDeclaration(&mut resolver.*, declarationAccess68Request)
  let importKey = declarationAccess68
  let imported = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    importKey,
    reference.span,
  )
  let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(&imported, fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) })
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
    return Result<SelectedDeclaration, Shared<Rejection>>.failResult(move diagnostic)
  }
  if let Option<usize>.Some {value: targetModule} = move binding.module {
    // Arity needs only the declaration; whether this module may name it is checked where the
    // member's type is demanded.
    return run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      targetModule,
      module,
      Bytes.asSlice(&segments[usize.ONE]),
      false,
      reference.span,
      RejectionCode.UnknownType, RejectionCode.NotType, false)
  }
  return Result<SelectedDeclaration, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, reference.span),
  )
}

// The graph index of one declaration, appending it when first reached.
effect fn fieldNode(
  modules: &mut List<usize>,
  declarations: &mut List<usize>,
  module: usize,
  declaration: usize,
) -> usize ! OutOfMemoryError ? &mut Allocator {
  let known = List<usize>.length(&modules.*)
  let mut at = usize.ZERO
  while at < known {
    if List<usize>.get(&modules.*, at) == module && List<usize>.get(&declarations.*, at) == declaration {
      return at
    }
    at = at + usize.ONE
  }
  run List<usize>.append(&mut modules.*, module)
  run List<usize>.append(&mut declarations.*, declaration)
  return known
}

// Whether `from` reaches `to` along at least one edge of the field-reference graph.
effect fn reachesNode(
  from: usize,
  to: usize,
  sources: &List<usize>,
  targets: &List<usize>,
  nodes: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut visited = List<bool>.make()
  let mut at = usize.ZERO
  while at < nodes {
    run List<bool>.append(&mut visited, false)
    at = at + usize.ONE
  }
  let mut pending = List<usize>.make()
  run List<usize>.append(&mut pending, from)
  while List<usize>.length(&pending) > usize.ZERO {
    let taken = List<usize>.pop(&mut pending)
    let current = match move taken {
      Option<usize>.Some {value} => value
      Option<usize>.None => usize.MAX
    }
    let mut edge = usize.ZERO
    while edge < List<usize>.length(sources) {
      if List<usize>.get(sources, edge) == current {
        let target = List<usize>.get(targets, edge)
        if target == to {
          return true
        }
        if !List<bool>.get(&visited, target) {
          List<bool>.set(&mut visited, target, true)
          run List<usize>.append(&mut pending, target)
        }
      }
      edge = edge + usize.ONE
    }
  }
  return false
}

// The least generated-lifetime count of node `at`: its own omissions plus, per edge, the target's
// count. Only called once no positive node lies on a cycle, so the recursion is finite.
fn fieldCount(
  at: usize,
  omitted: &List<usize>,
  sources: &List<usize>,
  targets: &List<usize>,
  positive: &List<bool>,
  memo: &mut List<usize>,
) -> usize {
  if !List<bool>.get(positive, at) {
    return usize.ZERO
  }
  let known = List<usize>.get(&memo.*, at)
  if known != usize.MAX {
    return known
  }
  let mut total = List<usize>.get(omitted, at)
  let mut edge = usize.ZERO
  while edge < List<usize>.length(sources) {
    if List<usize>.get(sources, edge) == at {
      total = total + fieldCount(
        List<usize>.get(targets, edge),
        omitted,
        sources,
        targets,
        positive,
        &mut memo.*,
      )
    }
    edge = edge + usize.ONE
  }
  List<usize>.set(&mut memo.*, at, total)
  return total
}

// Scans the arguments written on a field reference: its omitted lifetimes are returned and the
// references nested in them are queued on `pending`.
effect fn scanReferenceArguments(
  resolver: &mut Resolver,
  module: &ModuleId,
  declaration: usize,
  arguments: HirId,
  target: &[Binder],
  binders: &[Binder],
  pending: &mut List<FieldReference>,
) -> usize ! Cycle | OutOfMemoryError ? &mut Allocator {
  let nested = run scanApplicationArguments(&mut resolver.*, module, declaration, arguments, target, binders)
  let FieldScan {omitted: argumentOmissions, references: argumentReferences} = move nested
  let more = List<FieldReference>.asSlice(&argumentReferences)
  let mut moreAt = usize.ZERO
  while moreAt < more.length {
    run List<FieldReference>.append(&mut pending.*, more[moreAt])
    moreAt = moreAt + usize.ONE
  }
  return argumentOmissions
}

// LIFE-003 for declarations: a struct, tuple, or union gains one lifetime parameter per lifetime its
// field types leave unwritten, including every lifetime of a nested nominal or alias used without
// written lifetimes. Only field type names are resolved, never member types, bodies, or layout.
// A cycle that would add lifetimes on every turn has no finite answer and stays unsupported.
effect fn resolveFieldLifetimes(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let root = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let declarationAccess69 = declarationPosition(&resolver.*, key)
  let rootHeader = run observedHeader(&mut resolver.*, &root, declarationAccess69, SourceFacet.Identity)
  let mut rootSpan = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move rootHeader {
    rootSpan = value.span
  }
  let mut modules = List<usize>.make()
  let mut declarations = List<usize>.make()
  let mut omitted = List<usize>.make()
  let mut sources = List<usize>.make()
  let mut targets = List<usize>.make()
  let mut edgeSpans = List<Span>.make()
  run List<usize>.append(&mut modules, key.module)
  let declarationAccess70 = declarationPosition(&resolver.*, key)
  run List<usize>.append(&mut declarations, declarationAccess70)
  let mut at = usize.ZERO
  while at < List<usize>.length(&modules) {
    let nodeModuleOrdinal = List<usize>.get(&modules, at)
    let nodeDeclaration = List<usize>.get(&declarations, at)
    let nodeModule = resolvedModule(&resolver.*, nodeModuleOrdinal)
    let template = run templateBinders(&mut resolver.*, &nodeModule, nodeDeclaration)
    let binders = match move template {
      Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    let scan = run scanDeclarationFields(
      &mut resolver.*,
      &nodeModule,
      nodeDeclaration,
    )
    let FieldScan {omitted: written, references: found} = move scan
    let mut contribution = written
    let mut pending = move found
    let mut referenceAt = usize.ZERO
    while referenceAt < List<FieldReference>.length(&pending) {
      let reference = List<FieldReference>.get(&pending, referenceAt)
      let selected = run fieldTarget(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        nodeModuleOrdinal,
        &nodeModule,
        nodeDeclaration,
        &reference,
      )
      let target = match move selected {
        Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
        Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
          return run memberRejected(move error, move dependencies)
        }
      }
      let targetModule = resolvedModule(&resolver.*, target.module)
      let targetHeader = run observedHeader(&mut resolver.*, &targetModule, target.ordinal, SourceFacet.Identity)
      let mut aggregate = false
      let mut alias = false
      if let Option<HeaderSyntax>.Some {value} = move targetHeader {
        aggregate = isAggregateHeader(value.header)
        if let Node.AliasHeader {..} = value.header {
          alias = true
        }
      }
      let targetTemplate = run templateBinders(&mut resolver.*, &targetModule, target.ordinal)
      let targetBinders = match move targetTemplate {
        Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
        Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
          return run memberRejected(move error, move dependencies)
        }
      }
      let writtenLifetimes = writtenLifetimeCount(List<Binder>.asSlice(&targetBinders))
      if reference.arguments.present {
        contribution = contribution + run scanReferenceArguments(
          &mut resolver.*,
          &nodeModule,
          nodeDeclaration,
          reference.arguments.id,
          List<Binder>.asSlice(&targetBinders),
          List<Binder>.asSlice(&binders),
          &mut pending,
        )
      }
      // A written lifetime list is complete: an application rejects a partial one (GEN-002).
      let unwritten = !reference.writtenLifetimes
      if unwritten {
        contribution = contribution + writtenLifetimes
      }
      // An aggregate used without lifetimes also omits its generated ones; an alias's target
      // elides its own omissions at every use.
      if (aggregate && unwritten) || alias {
        let node = run fieldNode(&mut modules, &mut declarations, target.module, target.ordinal)
        run List<usize>.append(&mut sources, at)
        run List<usize>.append(&mut targets, node)
        run List<Span>.append(&mut edgeSpans, reference.span)
      }
      referenceAt = referenceAt + usize.ONE
    }
    run List<usize>.append(&mut omitted, contribution)
    at = at + usize.ONE
  }
  let nodes = List<usize>.length(&modules)
  // `positive` marks nodes whose count is nonzero: they omit a lifetime or reach one that does.
  let mut positive = List<bool>.make()
  at = usize.ZERO
  while at < nodes {
    run List<bool>.append(&mut positive, List<usize>.get(&omitted, at) > usize.ZERO)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut edge = usize.ZERO
    while edge < List<usize>.length(&sources) {
      let source = List<usize>.get(&sources, edge)
      if !List<bool>.get(&positive, source) && List<bool>.get(
        &positive,
        List<usize>.get(&targets, edge),
      ) {
        List<bool>.set(&mut positive, source, true)
        changed = true
      }
      edge = edge + usize.ONE
    }
  }
  // A positive node on a cycle would add lifetimes on every turn: no finite count exists.
  let mut unbounded = List<bool>.make()
  at = usize.ZERO
  while at < nodes {
    let cyclic = List<bool>.get(&positive, at) && run reachesNode(
      at,
      at,
      &sources,
      &targets,
      nodes,
    )
    run List<bool>.append(&mut unbounded, cyclic)
    at = at + usize.ONE
  }
  let mut reachesUnbounded = false
  at = usize.ZERO
  while at < nodes {
    if List<bool>.get(&unbounded, at) && (at == usize.ZERO || run reachesNode(
      usize.ZERO,
      at,
      &sources,
      &targets,
      nodes,
    )) {
      reachesUnbounded = true
    }
    at = at + usize.ONE
  }
  if reachesUnbounded {
    let mut anchor = rootSpan
    let mut edge = List<usize>.length(&sources)
    // Anchor at the root's first reference that leads into the unbounded cycle.
    while edge > usize.ZERO {
      edge = edge - usize.ONE
      if List<usize>.get(&sources, edge) == usize.ZERO {
        let target = List<usize>.get(&targets, edge)
        let mut leads = List<bool>.get(&unbounded, target)
        let mut other = usize.ZERO
        while other < nodes && !leads {
          if List<bool>.get(&unbounded, other) && run reachesNode(
            target,
            other,
            &sources,
            &targets,
            nodes,
          ) {
            leads = true
          }
          other = other + usize.ONE
        }
        if leads {
          anchor = List<Span>.get(&edgeSpans, edge)
        }
      }
    }
    return run memberRejected(
      run reject(&resolver.*, &root, RejectionCode.Unsupported, anchor),
      move dependencies,
    )
  }
  let mut memo = List<usize>.make()
  at = usize.ZERO
  while at < nodes {
    run List<usize>.append(&mut memo, usize.MAX)
    at = at + usize.ONE
  }
  let count = fieldCount(usize.ZERO, &omitted, &sources, &targets, &positive, &mut memo)
  return memberSuccess(Value.FieldLifetimes {count: count}, move dependencies)
}

// Appends a struct's, tuple's, or union's generated lifetime parameters after its written binders.
// Any other declaration is left unchanged.
effect fn completeAggregateBinders(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
  span: Span,
  binders: &mut List<Binder>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let written = run scopedHeader(&mut resolver.*, module, ordinal)
  let mut aggregate = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    aggregate = isAggregateHeader(value.header)
  }
  if !aggregate {
    return Option<Shared<Rejection>>.none()
  }
  let declarationAccess71Request = Key {
    family: Family.FieldLifetimes,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ordinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess71 = run internDeclaration(&mut resolver.*, declarationAccess71Request)
  let countKey = declarationAccess71
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, countKey, span)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &answer,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
    return Option<Shared<Rejection>>.some(move diagnostic)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&answer, fieldLifetimeCount)
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  if let Option<DeclarationId>.Some {value: declared} = move identity {
    let first = List<Binder>.length(&binders.*)
    let mut index = usize.ZERO
    while index < count {
      run List<Binder>.append(
        &mut binders.*,
        Binder.Lifetime {
          name: Bytes.make(),
          value: run Shared<Lifetime>.make(
            Lifetime.Parameter {
              declaration: DeclarationId.copy(&declared),
              ordinal: first + index,
            },
          ),
        },
      )
      index = index + usize.ONE
    }
  }
  return Option<Shared<Rejection>>.none()
}

fn fieldLifetimeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.FieldLifetimes {count}} => count
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

// The declarations one `Variance` or `DropObservation` answer is computed over: the requested
// struct, tuple, union, or enum and every such declaration its member types reach through an
// application that mentions the reaching declaration's binders. Each node keeps its complete binder
// kinds and its member types under its identity application, so a recursive or mutually recursive
// group reaches one least fixed point inside the query that demanded it, without demanding itself.
struct StoredGroup {
  identities: List<DeclarationId>,
  modules: List<usize>,
  ordinals: List<usize>,
  // Per node, where its binder kinds and member types start; one closing entry follows the last.
  kinds: List<GenericKind>,
  binderStarts: List<usize>,
  parts: List<Shared<Type>>,
  partStarts: List<usize>,
}

// Whether a nominal names a source struct, tuple, union, or enum, whose own members decide its
// variance and cleanup. A sealed core is not one; services and interfaces store nothing.
fn storedDeclaration(declaration: &DeclarationId) -> bool {
  if let Option<SealedKind>.Some {..} = move SealedCore.declarationCore(declaration) { return false }
  let kind = DeclarationId.kind(declaration)
  return kind == OwnerKind.Struct || kind == OwnerKind.Tuple || kind == OwnerKind.Union || kind == OwnerKind.Enumeration
}

// The node of `declaration` in `group`, or `usize.MAX`.
fn groupNode(group: &StoredGroup, declaration: &DeclarationId) -> usize {
  let listed = List<DeclarationId>.asSlice(&group.identities)
  let mut at = usize.ZERO
  while at < listed.length {
    if DeclarationId.equals(&listed[at], declaration) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn listsDeclaration(listed: &[DeclarationId], declaration: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if DeclarationId.equals(&listed[at], declaration) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `value` mentions any binder `subject` owns. A type that mentions none can neither vary
// with nor be observed through them, so neither walk looks into it.
effect fn mentionsBinders(value: &Shared<Type>, subject: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(value, subject, &mut types, &mut lifetimes, &mut rows)
  return List<usize>.length(&types) + List<usize>.length(&lifetimes) + List<usize>.length(&rows) > usize.ZERO
}

// Appends, once, each stored declaration `value` applies with arguments that mention `subject`'s
// binders, along every position the variance and cleanup walks descend into.
effect fn collectStored(value: &Shared<Type>, subject: &DeclarationId, found: &mut List<DeclarationId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match move run Type.copy(value) {
    Type.Reference {referent, ..} => { return run collectStored(&referent, subject, &mut found.*) }
    Type.Slice {element, ..} => { return run collectStored(&element, subject, &mut found.*) }
    Type.Array {element, ..} => { return run collectStored(&element, subject, &mut found.*) }
    Type.Union {members} => { return run collectStoredAll(List<Shared<Type>>.asSlice(&members), subject, &mut found.*) }
    Type.Anonymous {members, ..} => { return run collectStoredAll(List<Shared<Type>>.asSlice(&members), subject, &mut found.*) }
    Type.Callable {parameters, result, ..} => {
      run collectStoredAll(List<Shared<Type>>.asSlice(&parameters), subject, &mut found.*)
      return run collectStored(&result, subject, &mut found.*)
    }
    Type.Effect {success, failure, ..} => {
      run collectStored(&success, subject, &mut found.*)
      return run collectStored(&failure, subject, &mut found.*)
    }
    Type.Nominal {declaration, arguments, ..} => {
      if storedDeclaration(&declaration) && !listsDeclaration(List<DeclarationId>.asSlice(&found.*), &declaration)
        && run mentionsBinders(value, subject) {
        run List<DeclarationId>.append(&mut found.*, DeclarationId.copy(&declaration))
      }
      let listed = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        if let Argument.Type {value: argument} = &listed[at] { run collectStored(&argument, subject, &mut found.*) }
        at = at + usize.ONE
      }
      return ()
    }
    _ => { return () }
  }
}

effect fn collectStoredAll(values: &[Shared<Type>], subject: &DeclarationId, found: &mut List<DeclarationId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run collectStored(&values[at], subject, &mut found.*)
    at = at + usize.ONE
  }
  return ()
}

// The argument that names `binder` itself in its owner's identity application.
effect fn binderArgument(binder: &Binder) -> Argument ! OutOfMemoryError ? &mut Allocator {
  if let Binder.Type {value, ..} = &binder.* { return Argument.Type {value: Shared<Type>.clone(&value)} }
  if let Binder.Lifetime {value, ..} = &binder.* { return Argument.Lifetime {value: Shared<Lifetime>.clone(&value)} }
  let mut row = Row.empty()
  if let Binder.Row {value, ..} = &binder.* {
    run Row.include(&mut row, RowParameter {declaration: Shared<DeclarationId>.clone(&value.declaration), ordinal: value.ordinal})
  }
  return Argument.Row {value: run Shared<Row>.make(move row)}
}

// Collects the group of the declaration at `ordinal` of module `moduleOrdinal`. Only binders and
// member shapes are read: never a body, an implementation, or a layout.
effect fn storedGroup(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  ordinal: usize,
  span: Span,
) -> Result<StoredGroup, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let rootModule = resolvedModule(&resolver.*, moduleOrdinal)
  let root = run declarationAt(&mut resolver.*, &rootModule, ordinal)
  let identity = match move root {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result<StoredGroup, Shared<Rejection>>.failResult(run reject(&resolver.*, &rootModule, RejectionCode.Unsupported, span))
    }
  }
  if !storedDeclaration(&identity) {
    return Result<StoredGroup, Shared<Rejection>>.failResult(run reject(&resolver.*, &rootModule, RejectionCode.Unsupported, span))
  }
  let mut group = StoredGroup {
    identities: List<DeclarationId>.make(),
    modules: List<usize>.make(),
    ordinals: List<usize>.make(),
    kinds: List<GenericKind>.make(),
    binderStarts: List<usize>.make(),
    parts: List<Shared<Type>>.make(),
    partStarts: List<usize>.make(),
  }
  run List<DeclarationId>.append(&mut group.identities, move identity)
  run List<usize>.append(&mut group.modules, moduleOrdinal)
  run List<usize>.append(&mut group.ordinals, ordinal)
  let mut at = usize.ZERO
  while at < List<DeclarationId>.length(&group.identities) {
    let nodeModuleOrdinal = List<usize>.get(&group.modules, at)
    let nodeOrdinal = List<usize>.get(&group.ordinals, at)
    let nodeModule = resolvedModule(&resolver.*, nodeModuleOrdinal)
    let subject = DeclarationId.copy(&List<DeclarationId>.asSlice(&group.identities)[at])
    run List<usize>.append(&mut group.binderStarts, List<GenericKind>.length(&group.kinds))
    run List<usize>.append(&mut group.partStarts, List<Shared<Type>>.length(&group.parts))
    let template = run templateBinders(&mut resolver.*, &nodeModule, nodeOrdinal)
    let mut binders = match move template {
      Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return Result<StoredGroup, Shared<Rejection>>.failResult(move error)
      }
    }
    let incomplete = run completeApplicationBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, nodeModuleOrdinal,
      &nodeModule, nodeOrdinal, span, &mut binders)
    if let Option<Shared<Rejection>>.Some {value} = move incomplete {
      return Result<StoredGroup, Shared<Rejection>>.failResult(move value)
    }
    let listedBinders = List<Binder>.asSlice(&binders)
    let mut arguments = List<Argument>.make()
    let mut binderAt = usize.ZERO
    while binderAt < listedBinders.length {
      run List<GenericKind>.append(&mut group.kinds, binderKind(&listedBinders[binderAt]))
      run List<Argument>.append(&mut arguments, run binderArgument(&listedBinders[binderAt]))
      binderAt = binderAt + usize.ONE
    }
    let application = run Types.intern(Type.Nominal {declaration: DeclarationId.copy(&subject), isPublic: true, arguments: move arguments})
    let stored = run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, span)
    let parts = match move stored {
      Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
      Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => {
        return Result<StoredGroup, Shared<Rejection>>.failResult(move error)
      }
    }
    let mut found = List<DeclarationId>.make()
    let listedParts = List<Shared<Type>>.asSlice(&parts)
    let mut partAt = usize.ZERO
    while partAt < listedParts.length {
      run List<Shared<Type>>.append(&mut group.parts, Shared<Type>.clone(&listedParts[partAt]))
      run collectStored(&listedParts[partAt], &subject, &mut found)
      partAt = partAt + usize.ONE
    }
    let targets = List<DeclarationId>.asSlice(&found)
    let mut targetAt = usize.ZERO
    while targetAt < targets.length {
      let targetModule = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&targets[targetAt]))
      if targetModule != usize.MAX && groupNode(&group, &targets[targetAt]) == usize.MAX {
        let declaredModule = resolvedModule(&resolver.*, targetModule)
        let target = run Shared<DeclarationId>.make(DeclarationId.copy(&targets[targetAt]))
        let located = run ordinalOfIdentity(&mut resolver.*, &declaredModule, &target)
        if let Option<usize>.Some {value: targetOrdinal} = move located {
          run List<DeclarationId>.append(&mut group.identities, DeclarationId.copy(&targets[targetAt]))
          run List<usize>.append(&mut group.modules, targetModule)
          run List<usize>.append(&mut group.ordinals, targetOrdinal)
        }
      }
      targetAt = targetAt + usize.ONE
    }
    at = at + usize.ONE
  }
  run List<usize>.append(&mut group.binderStarts, List<GenericKind>.length(&group.kinds))
  run List<usize>.append(&mut group.partStarts, List<Shared<Type>>.length(&group.parts))
  return Result<StoredGroup, Shared<Rejection>>.succeed(move group)
}

// The variance admitting both uses: bivariance admits anything, opposite uses fix the argument.
fn joinVariance(left: Variance, right: Variance) -> Variance {
  if left == Variance.Bivariant { return right }
  if right == Variance.Bivariant || left == right { return left }
  return Variance.Invariant
}

// The variance of a use at `inner` inside a position at `outer` (bootstrap NominalVariance).
fn composeVariance(outer: Variance, inner: Variance) -> Variance {
  if outer == Variance.Bivariant || inner == Variance.Bivariant { return Variance.Bivariant }
  if outer == Variance.Invariant || inner == Variance.Invariant { return Variance.Invariant }
  if outer == Variance.Covariant { return inner }
  if inner == Variance.Covariant { return Variance.Contravariant }
  return Variance.Covariant
}

fn joinVarianceAt(found: &mut List<Variance>, ordinal: usize, variance: Variance) -> () {
  if ordinal >= List<Variance>.length(&found.*) { return () }
  let joined = joinVariance(List<Variance>.get(&found.*, ordinal), variance)
  List<Variance>.set(&mut found.*, ordinal, joined)
  return ()
}

fn joinVarianceAll(found: &mut List<Variance>, ordinals: &List<usize>, variance: Variance) -> () {
  let listed = List<usize>.asSlice(ordinals)
  let mut at = usize.ZERO
  while at < listed.length {
    joinVarianceAt(&mut found.*, listed[at], variance)
    at = at + usize.ONE
  }
  return ()
}

// Joins `variance` into each `subject` lifetime binder among the atoms of `region`.
fn lifetimeVariance(region: &Shared<Lifetime>, subject: &DeclarationId, variance: Variance, found: &mut List<Variance>) -> () {
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(region, at)
    joinVarianceAt(&mut found.*, ownedLifetimeOrdinal(&atom, subject), variance)
    at = at + usize.ONE
  }
  return ()
}

// Joins `variance` into every `subject` binder `value` mentions.
effect fn markVariance(value: &Shared<Type>, subject: &DeclarationId, variance: Variance, found: &mut List<Variance>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(value, subject, &mut types, &mut lifetimes, &mut rows)
  joinVarianceAll(&mut found.*, &types, variance)
  joinVarianceAll(&mut found.*, &lifetimes, variance)
  joinVarianceAll(&mut found.*, &rows, variance)
  return ()
}

effect fn markRowVariance(row: &Shared<Row>, subject: &DeclarationId, variance: Variance, found: &mut List<Variance>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwnedRow(row, subject, &mut types, &mut lifetimes, &mut rows)
  joinVarianceAll(&mut found.*, &types, variance)
  joinVarianceAll(&mut found.*, &lifetimes, variance)
  joinVarianceAll(&mut found.*, &rows, variance)
  return ()
}

// Joins the variance of each `subject` binder that `value` uses at `context` into `found` (LIFE-002).
// Shared references and slices keep their position in their region and referent; exclusive ones
// keep it in their region only. Strings, fixed arrays, structural unions and anonymous records keep
// it; callable inputs reverse it and callable results, retained environments and Effect outcomes
// keep it. Raw pointees, requirement rows, invocation bounds, sealed cores other than a slot's
// selection region, and every unclassified form are invariant. A group declaration composes the
// variance `table` currently holds for it.
effect fn varianceWithin(
  group: &StoredGroup, table: &[Variance], value: &Shared<Type>, context: Variance, subject: &DeclarationId,
  found: &mut List<Variance>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if context == Variance.Bivariant { return () }
  if context == Variance.Invariant { return run markVariance(value, subject, Variance.Invariant, &mut found.*) }
  let direct = Shared<Type>.with<usize>(value, fn(node: &Type) -> usize { return Type.parameterOrdinalOf(node, subject) })
  if direct != usize.MAX {
    joinVarianceAt(&mut found.*, direct, context)
    return ()
  }
  match move run Type.copy(value) {
    Type.Primitive {..} => { return () }
    Type.Unit => { return () }
    Type.Parameter {..} => { return () }
    Type.String {lifetime} => {
      lifetimeVariance(&lifetime, subject, context, &mut found.*)
      return ()
    }
    Type.Reference {referent, access, lifetime} => {
      lifetimeVariance(&lifetime, subject, context, &mut found.*)
      let mut inner = context
      if access != Access.Shared { inner = Variance.Invariant }
      return run varianceWithin(group, table, &referent, inner, subject, &mut found.*)
    }
    Type.Slice {element, access, lifetime} => {
      lifetimeVariance(&lifetime, subject, context, &mut found.*)
      let mut inner = context
      if access != Access.Shared { inner = Variance.Invariant }
      return run varianceWithin(group, table, &element, inner, subject, &mut found.*)
    }
    Type.Pointer {pointee, ..} => { return run markVariance(&pointee, subject, Variance.Invariant, &mut found.*) }
    Type.Array {element, ..} => { return run varianceWithin(group, table, &element, context, subject, &mut found.*) }
    Type.Union {members} => {
      return run varianceWithinAll(group, table, List<Shared<Type>>.asSlice(&members), context, subject, &mut found.*)
    }
    Type.Anonymous {members, ..} => {
      return run varianceWithinAll(group, table, List<Shared<Type>>.asSlice(&members), context, subject, &mut found.*)
    }
    Type.Nominal {declaration, arguments, ..} => {
      if !run mentionsBinders(value, subject) { return () }
      return run nominalVariance(group, table, &declaration, List<Argument>.asSlice(&arguments), context, subject, &mut found.*)
    }
    Type.Callable {environment, invocationBounds, parameters, result, ..} => {
      let regions = run callableEnvironmentRegions(&environment)
      let held = List<Shared<Lifetime>>.asSlice(&regions)
      let mut at = usize.ZERO
      while at < held.length {
        lifetimeVariance(&held[at], subject, context, &mut found.*)
        at = at + usize.ONE
      }
      let bounds = List<Outlives>.asSlice(&invocationBounds)
      at = usize.ZERO
      while at < bounds.length {
        lifetimeVariance(&bounds[at].longer, subject, Variance.Invariant, &mut found.*)
        lifetimeVariance(&bounds[at].shorter, subject, Variance.Invariant, &mut found.*)
        at = at + usize.ONE
      }
      run varianceWithinAll(group, table, List<Shared<Type>>.asSlice(&parameters),
        composeVariance(context, Variance.Contravariant), subject, &mut found.*)
      return run varianceWithin(group, table, &result, context, subject, &mut found.*)
    }
    Type.Effect {environment, success, failure, requirements, ..} => {
      let regions = run callableEnvironmentRegions(&environment)
      let held = List<Shared<Lifetime>>.asSlice(&regions)
      let mut at = usize.ZERO
      while at < held.length {
        lifetimeVariance(&held[at], subject, context, &mut found.*)
        at = at + usize.ONE
      }
      run markRowVariance(&requirements, subject, Variance.Invariant, &mut found.*)
      run varianceWithin(group, table, &success, context, subject, &mut found.*)
      return run varianceWithin(group, table, &failure, context, subject, &mut found.*)
    }
    _ => { return run markVariance(value, subject, Variance.Invariant, &mut found.*) }
  }
}

effect fn varianceWithinAll(
  group: &StoredGroup, table: &[Variance], values: &[Shared<Type>], context: Variance, subject: &DeclarationId,
  found: &mut List<Variance>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run varianceWithin(group, table, &values[at], context, subject, &mut found.*)
    at = at + usize.ONE
  }
  return ()
}

// Joins the variance an application of `declaration` gives each `subject` binder its `arguments`
// mention: each argument at its position composed with the declaration's own binder variance. A
// sealed slot keeps its selection region covariant and its element invariant, like `&mut T`.
effect fn nominalVariance(
  group: &StoredGroup, table: &[Variance], declaration: &DeclarationId, arguments: &[Argument], context: Variance,
  subject: &DeclarationId, found: &mut List<Variance>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let node = groupNode(group, declaration)
  let mut slot = false
  if let Option<SealedKind>.Some {value: core} = move SealedCore.declarationCore(declaration) { slot = core == SealedKind.Slot }
  let mut start = usize.ZERO
  let mut count = usize.ZERO
  if node != usize.MAX {
    start = List<usize>.get(&group.binderStarts, node)
    count = List<usize>.get(&group.binderStarts, node + usize.ONE) - start
  }
  let mut at = usize.ZERO
  while at < arguments.length {
    let mut declared = Variance.Invariant
    if at < count {
      declared = table[start + at]
    } else if slot && at == usize.ZERO {
      declared = Variance.Covariant
    }
    let inner = composeVariance(context, declared)
    match &arguments[at] {
      Argument.Lifetime {value: argument} => { lifetimeVariance(&argument, subject, inner, &mut found.*) }
      Argument.Type {value: argument} => { run varianceWithin(group, table, &argument, inner, subject, &mut found.*) }
      Argument.Row {value: argument} => {
        if inner != Variance.Bivariant { run markRowVariance(&argument, subject, Variance.Invariant, &mut found.*) }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// A node's binders before any use is seen: bivariant, except that a requirement row is invariant.
effect fn initialVariances(kinds: &[GenericKind], start: usize, end: usize) -> List<Variance> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Variance>.make()
  let mut at = start
  while at < end {
    if kinds[at] == GenericKind.Requirement {
      run List<Variance>.append(&mut found, Variance.Invariant)
    } else {
      run List<Variance>.append(&mut found, Variance.Bivariant)
    }
    at = at + usize.ONE
  }
  return move found
}

// The least variance of every group binder. Each pass recomputes every node from its member types
// against the table so far; the walk is monotone, so the table only rises and then stops changing.
effect fn groupVariance(group: &StoredGroup) -> List<Variance> ! OutOfMemoryError ? &mut Allocator {
  let kinds = List<GenericKind>.asSlice(&group.kinds)
  let starts = List<usize>.asSlice(&group.binderStarts)
  let partStarts = List<usize>.asSlice(&group.partStarts)
  let parts = List<Shared<Type>>.asSlice(&group.parts)
  let identities = List<DeclarationId>.asSlice(&group.identities)
  let mut table = run initialVariances(kinds, usize.ZERO, kinds.length)
  let mut changed = true
  while changed {
    changed = false
    let mut node = usize.ZERO
    while node < identities.length {
      let start = starts[node]
      let mut found = run initialVariances(kinds, start, starts[node + usize.ONE])
      let mut part = partStarts[node]
      while part < partStarts[node + usize.ONE] {
        run varianceWithin(group, List<Variance>.asSlice(&table), &parts[part], Variance.Covariant, &identities[node], &mut found)
        part = part + usize.ONE
      }
      let fresh = List<Variance>.asSlice(&found)
      let mut at = usize.ZERO
      while at < fresh.length {
        if List<Variance>.get(&table, start + at) != fresh[at] {
          List<Variance>.set(&mut table, start + at, fresh[at])
          changed = true
        }
        at = at + usize.ONE
      }
      node = node + usize.ONE
    }
  }
  return move table
}

// LIFE-002 for declarations: the variance of each binder of a struct, tuple, union, or enum follows
// how its member types use it, composing every nominal they apply. The answer is one variance per
// binder in complete binder order, so an edit that leaves every variance in place leaves it equal.
effect fn resolveVariance(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let ordinal = declarationPosition(&resolver.*, key)
  let span = run declarationSpan(&mut resolver.*, &module, ordinal)
  let built = run storedGroup(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, ordinal, span)
  let group = match move built {
    Result<StoredGroup, Shared<Rejection>>.Success {value} => move value
    Result<StoredGroup, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let table = run groupVariance(&group)
  let listed = List<Variance>.asSlice(&table)
  let mut binders = List<Variance>.make()
  let mut at = usize.ZERO
  while at < List<usize>.get(&group.binderStarts, usize.ONE) {
    run List<Variance>.append(&mut binders, listed[at])
    at = at + usize.ONE
  }
  return memberSuccess(Value.Variance {binders: move binders}, move dependencies)
}

// The span that anchors a declaration's own rejections and the demands it makes.
effect fn declarationSpan(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Span ! Cycle | OutOfMemoryError ? &mut Allocator {
  let header = run observedHeader(&mut resolver.*, module, ordinal, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value} = move header { return value.span }
  return Span.make(usize.ZERO, usize.ZERO)
}

// The `Key` of a `Variance` or `DropObservation` answer for a source struct, tuple, union, or enum,
// or none for any other declaration.
effect fn nominalKey(resolver: &mut Resolver, family: Family, declaration: &DeclarationId) -> Option<Key>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if !storedDeclaration(declaration) { return Option<Key>.none() }
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(declaration))
  if moduleOrdinal == usize.MAX { return Option<Key>.none() }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(declaration))
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<Key>.none() }
  }
  let request = Key {family: family, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
  return Option<Key>.some(run internDeclaration(&mut resolver.*, request))
}

// The variance of binder `ordinal` of `declaration`, read from its `Variance` answer. Any other
// declaration, an unavailable answer, and a binder past the answer are invariant.
effect fn binderVariance(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  declaration: &DeclarationId, ordinal: usize, span: Span,
) -> Variance
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let key = match move run nominalKey(&mut resolver.*, Family.Variance, declaration) {
    Option<Key>.Some {value} => value
    Option<Key>.None => { return Variance.Invariant }
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  return Shared<Result<Answer, NoRejection>>.with<Variance>(&answer,
    fn(value: &Result<Answer, NoRejection>) -> Variance { return varianceAt(value, ordinal) })
}

fn varianceAt(answer: &Result<Answer, NoRejection>, at: usize) -> Variance {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Variance {binders}} = &value.outcome {
      let listed = List<Variance>.asSlice(&binders)
      if at < listed.length { return listed[at] }
    }
  }
  return Variance.Invariant
}

// The cleanup use that covers both.
fn joinDropUse(left: DropUse, right: DropUse) -> DropUse {
  if left == DropUse.Observed || right == DropUse.Observed { return DropUse.Observed }
  if left == DropUse.Dropped || right == DropUse.Dropped { return DropUse.Dropped }
  return DropUse.Unobserved
}

fn joinDropUseAt(found: &mut List<DropUse>, ordinal: usize, observation: DropUse) -> () {
  if ordinal >= List<DropUse>.length(&found.*) { return () }
  let joined = joinDropUse(List<DropUse>.get(&found.*, ordinal), observation)
  List<DropUse>.set(&mut found.*, ordinal, joined)
  return ()
}

fn observeLifetime(region: &Shared<Lifetime>, subject: &DeclarationId, found: &mut List<DropUse>) -> () {
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(region, at)
    joinDropUseAt(&mut found.*, ownedLifetimeOrdinal(&atom, subject), DropUse.Observed)
    at = at + usize.ONE
  }
  return ()
}

// Marks every `subject` type and lifetime binder `value` mentions observed.
effect fn observeAll(value: &Shared<Type>, subject: &DeclarationId, found: &mut List<DropUse>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(value, subject, &mut types, &mut lifetimes, &mut rows)
  let typed = List<usize>.asSlice(&types)
  let mut at = usize.ZERO
  while at < typed.length {
    joinDropUseAt(&mut found.*, typed[at], DropUse.Observed)
    at = at + usize.ONE
  }
  let regions = List<usize>.asSlice(&lifetimes)
  at = usize.ZERO
  while at < regions.length {
    joinDropUseAt(&mut found.*, regions[at], DropUse.Observed)
    at = at + usize.ONE
  }
  return ()
}

// Joins what dropping a stored `value` observes of each `subject` binder into `found` (LIFE-005).
// A value of a type binder is dropped. Scalars, references, strings, slices, raw pointers, foreign
// functions and phase-only descriptors have no cleanup. Fixed arrays, structural unions and
// anonymous records drop their members; a nominal drops its arguments as its own observation says,
// and a sealed core that owns cleanup drops its element. Every other form may observe all it names.
effect fn dropWithin(group: &StoredGroup, table: &[DropUse], value: &Shared<Type>, subject: &DeclarationId, found: &mut List<DropUse>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let direct = Shared<Type>.with<usize>(value, fn(node: &Type) -> usize { return Type.parameterOrdinalOf(node, subject) })
  if direct != usize.MAX {
    joinDropUseAt(&mut found.*, direct, DropUse.Dropped)
    return ()
  }
  match move run Type.copy(value) {
    Type.Primitive {..} => { return () }
    Type.Unit => { return () }
    Type.Parameter {..} => { return () }
    Type.String {..} => { return () }
    Type.Reference {..} => { return () }
    Type.Slice {..} => { return () }
    Type.Pointer {..} => { return () }
    Type.ForeignFunction {..} => { return () }
    Type.TypeDescriptor {..} => { return () }
    Type.Array {element, ..} => { return run dropWithin(group, table, &element, subject, &mut found.*) }
    Type.Union {members} => { return run dropWithinAll(group, table, List<Shared<Type>>.asSlice(&members), subject, &mut found.*) }
    Type.Anonymous {members, ..} => {
      return run dropWithinAll(group, table, List<Shared<Type>>.asSlice(&members), subject, &mut found.*)
    }
    Type.Nominal {declaration, arguments, ..} => {
      if !run mentionsBinders(value, subject) { return () }
      return run nominalDrop(group, table, value, &declaration, List<Argument>.asSlice(&arguments), subject, &mut found.*)
    }
    _ => { return run observeAll(value, subject, &mut found.*) }
  }
}

effect fn dropWithinAll(group: &StoredGroup, table: &[DropUse], values: &[Shared<Type>], subject: &DeclarationId, found: &mut List<DropUse>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run dropWithin(group, table, &values[at], subject, &mut found.*)
    at = at + usize.ONE
  }
  return ()
}

// Joins what dropping an application of `declaration` observes through its `arguments`. A group
// declaration drops or observes each argument as `table` currently says; a sealed core that owns
// cleanup drops its element and keeps its regions; any other declaration may observe all it names.
effect fn nominalDrop(
  group: &StoredGroup, table: &[DropUse], value: &Shared<Type>, declaration: &DeclarationId, arguments: &[Argument],
  subject: &DeclarationId, found: &mut List<DropUse>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut start = usize.ZERO
  let mut count = usize.ZERO
  let mut core = false
  if let Option<SealedKind>.Some {value: sealed} = move SealedCore.declarationCore(declaration) {
    if !SealedCore.ownsCleanup(sealed) { return () }
    core = true
  } else {
    let node = groupNode(group, declaration)
    if node == usize.MAX { return run observeAll(value, subject, &mut found.*) }
    start = List<usize>.get(&group.binderStarts, node)
    count = List<usize>.get(&group.binderStarts, node + usize.ONE) - start
  }
  let mut at = usize.ZERO
  while at < arguments.length {
    let mut observation = DropUse.Observed
    if core {
      observation = DropUse.Dropped
    } else if at < count {
      observation = table[start + at]
    }
    if observation != DropUse.Unobserved {
      match &arguments[at] {
        Argument.Lifetime {value: argument} => { observeLifetime(&argument, subject, &mut found.*) }
        Argument.Type {value: argument} => {
          if observation == DropUse.Dropped {
            run dropWithin(group, table, &argument, subject, &mut found.*)
          } else {
            run observeAll(&argument, subject, &mut found.*)
          }
        }
        Argument.Row {..} => {}
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether a user `Drop` hook is written for any application of `identity`, read from the shapes of
// the implementations of the module that may own it (DROP-002). A hook written for particular
// arguments still runs for those instances, so it counts for the whole declaration.
effect fn dropHookWritten(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, identity: &DeclarationId, span: Span,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let request = Key {
    family: Family.ImplementationShapes, module: moduleOrdinal, name: usize.ZERO,
    declaration: usize.ZERO, member: usize.ZERO, external: false,
  }
  let listKey = run internDeclaration(&mut resolver.*, request)
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, listKey, span)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<bool, Shared<Rejection>>.failResult(move value) }
  // Only heads whose provider is `identity` can be its hook.
  let ownerHash = DeclarationId.hash(identity)
  let mut at = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
    fn(answer: &Result<Answer, NoRejection>) -> usize { return firstOwnedHead(answer, ownerHash) })
  while at != usize.MAX {
    let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &listed, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return implementationAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      if Shared<ImplementationHead>.with<bool>(&head, fn(value: &ImplementationHead) -> bool { return dropHookFor(value, identity) }) {
        return Result<bool, Shared<Rejection>>.succeed(true)
      }
    }
    at = Shared<Result<Answer, NoRejection>>.with<usize>(&listed,
      fn(answer: &Result<Answer, NoRejection>) -> usize { return nextOwnedHead(answer, at) })
  }
  return Result<bool, Shared<Rejection>>.succeed(false)
}

// Whether `head` is a sealed `Drop` implementation whose provider applies `identity`.
fn dropHookFor(head: &ImplementationHead, identity: &DeclarationId) -> bool {
  let sealed = match &head.kind {
    ImplementationKind.Sealed {property} => property == SealedProperty.Drop
    _ => false
  }
  if !sealed { return false }
  return Shared<Type>.with<bool>(&head.provider, fn(node: &Type) -> bool {
    if let Type.Nominal {declaration, ..} = &node.* { return DeclarationId.equals(&declaration, identity) }
    return false
  })
}

// The least cleanup use of every group binder. A node with a user `Drop` hook observes every type
// and lifetime binder (LIFE-005); every other node recomputes from its member types until no node
// changes.
effect fn groupDropUse(group: &StoredGroup, hooks: &[bool]) -> List<DropUse> ! OutOfMemoryError ? &mut Allocator {
  let kinds = List<GenericKind>.asSlice(&group.kinds)
  let starts = List<usize>.asSlice(&group.binderStarts)
  let partStarts = List<usize>.asSlice(&group.partStarts)
  let parts = List<Shared<Type>>.asSlice(&group.parts)
  let identities = List<DeclarationId>.asSlice(&group.identities)
  let mut table = List<DropUse>.make()
  let mut node = usize.ZERO
  while node < identities.length {
    let mut at = starts[node]
    while at < starts[node + usize.ONE] {
      if hooks[node] && kinds[at] != GenericKind.Requirement {
        run List<DropUse>.append(&mut table, DropUse.Observed)
      } else {
        run List<DropUse>.append(&mut table, DropUse.Unobserved)
      }
      at = at + usize.ONE
    }
    node = node + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    node = usize.ZERO
    while node < identities.length {
      if !hooks[node] {
        let start = starts[node]
        let mut found = List<DropUse>.make()
        let mut at = start
        while at < starts[node + usize.ONE] {
          run List<DropUse>.append(&mut found, DropUse.Unobserved)
          at = at + usize.ONE
        }
        let mut part = partStarts[node]
        while part < partStarts[node + usize.ONE] {
          run dropWithin(group, List<DropUse>.asSlice(&table), &parts[part], &identities[node], &mut found)
          part = part + usize.ONE
        }
        let fresh = List<DropUse>.asSlice(&found)
        at = usize.ZERO
        while at < fresh.length {
          if List<DropUse>.get(&table, start + at) != fresh[at] {
            List<DropUse>.set(&mut table, start + at, fresh[at])
            changed = true
          }
          at = at + usize.ONE
        }
      }
      node = node + usize.ONE
    }
  }
  return move table
}

// LIFE-005 for declarations: which binders of a struct, tuple, union, or enum its cleanup may
// observe. A user `Drop` hook observes every binder its receiver could; otherwise cleanup observes
// what its members' cleanup observes, composing every nominal they apply. References have no
// cleanup, so a declaration that only borrows observes nothing.
effect fn resolveDropObservation(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let ordinal = declarationPosition(&resolver.*, key)
  let span = run declarationSpan(&mut resolver.*, &module, ordinal)
  let built = run storedGroup(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, ordinal, span)
  let group = match move built {
    Result<StoredGroup, Shared<Rejection>>.Success {value} => move value
    Result<StoredGroup, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
  }
  let mut hooks = List<bool>.make()
  let mut node = usize.ZERO
  while node < List<DeclarationId>.length(&group.identities) {
    let written = run dropHookWritten(&mut resolver.*, &mut owner.*, &mut dependencies, List<usize>.get(&group.modules, node),
      &List<DeclarationId>.asSlice(&group.identities)[node], span)
    match move written {
      Result<bool, Shared<Rejection>>.Success {value} => { run List<bool>.append(&mut hooks, value) }
      Result<bool, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
    }
    node = node + usize.ONE
  }
  let table = run groupDropUse(&group, List<bool>.asSlice(&hooks))
  let listed = List<DropUse>.asSlice(&table)
  let mut binders = List<DropUse>.make()
  let mut at = usize.ZERO
  while at < List<usize>.get(&group.binderStarts, usize.ONE) {
    run List<DropUse>.append(&mut binders, listed[at])
    at = at + usize.ONE
  }
  return memberSuccess(Value.DropObservation {binders: move binders}, move dependencies)
}

fn contractLifetimeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => List<Shared<Lifetime>>.length(
        &contract.lifetimeParameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn contractLifetimeAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Lifetime>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Contract {contract}} = &value.outcome {
      let lifetimes = List<Shared<Lifetime>>.asSlice(&contract.lifetimeParameters)
      if at < lifetimes.length {
        return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetimes[at]))
      }
    }
  }
  return Option<Shared<Lifetime>>.none()
}

// A declaration's contract owns omitted lifetimes in its bounds. Add those binders after its
// written and field-generated binders, preserving the ordinals resolved in the contract query.
effect fn completeBoundBinders(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
  span: Span,
  binders: &mut List<Binder>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if List<Binder>.length(&binders.*) == usize.ZERO {
    return Option<Shared<Rejection>>.none()
  }
  let declarationAccess72Request = Key {
    family: Family.Contract,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ordinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess72 = run internDeclaration(&mut resolver.*, declarationAccess72Request)
  let key = declarationAccess72
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &answer,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Option<Shared<Rejection>>.some(move diagnostic)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&answer, contractLifetimeCount)
  let mut at = writtenLifetimeCount(List<Binder>.asSlice(&binders.*))
  while at < count {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(
      &answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> {
        return contractLifetimeAt(value, at)
      },
    )
    if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
      run List<Binder>.append(
        &mut binders.*,
        Binder.Lifetime {name: Bytes.make(), value: move lifetime},
      )
    }
    at = at + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// An aggregate's application lists its written binders, then the lifetimes its fields leave
// unwritten (LIFE-003), then the lifetimes its contract's bounds leave unwritten, such as the
// environment of `F: fn(i32) -> i32`. Every application of a declaration completes them alike.
effect fn completeApplicationBinders(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
  span: Span,
  binders: &mut List<Binder>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let incomplete = run completeAggregateBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    module, ordinal, span, &mut binders.*)
  if let Option<Shared<Rejection>>.Some {value} = move incomplete { return Option<Shared<Rejection>>.some(move value) }
  return run completeBoundBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, ordinal,
    span, &mut binders.*)
}

struct BinderLists {
  types: List<Shared<Type>>,
  lifetimes: List<Shared<Lifetime>>,
  rows: List<RowParameter>,
}

effect fn parametersOf(binders: &[Binder]) -> BinderLists ! OutOfMemoryError ? &mut Allocator {
  let mut lists = BinderLists {
    types: List<Shared<Type>>.make(),
    lifetimes: List<Shared<Lifetime>>.make(),
    rows: List<RowParameter>.make(),
  }
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Type {value, ..} = &binders[at] {
      run List<Shared<Type>>.append(&mut lists.types, Shared<Type>.clone(&value))
    }
    if let Binder.Lifetime {value, ..} = &binders[at] {
      run List<Shared<Lifetime>>.append(&mut lists.lifetimes, Shared<Lifetime>.clone(&value))
    }
    if let Binder.Row {value, ..} = &binders[at] {
      run List<RowParameter>.append(
        &mut lists.rows,
        RowParameter {
          declaration: Shared<DeclarationId>.clone(&value.declaration),
          ordinal: value.ordinal,
        },
      )
    }
    at = at + usize.ONE
  }
  return move lists
}

// Whether a written result is the builtin `Effect`, as resolved by `resolveType`.
effect fn effectResult(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let mut target = value.header
    if let Node.AppliedType {target: applied, ..} = value.header {
      let named = run typeNode(&mut resolver.*, module, applied)
      if let Option<HeaderSyntax>.Some {value: found} = move named {
        target = found.header
      }
    }
    if let Node.NamedType {path: typeName, ..} = target {
      let parsed = run path(&mut resolver.*, module, typeName)
      let segments = List<Bytes>.asSlice(&parsed.segments)
      return parsed.valid && segments.length == usize.ONE && same(
        Bytes.asSlice(&segments[usize.ZERO]),
        b"Effect",
      ) && !hasBinder(binders, b"Effect")
    }
  }
  return false
}

// The declaration's representation contracts, indexed by the bound parameter's binder ordinal. A
// representation that is also `Intrinsic.Detached` retains no external loan, whatever its contract's
// environment says, so it is recorded as retaining nothing.
effect fn representationsOf(owner: &DeclarationId, binderCount: usize, constraints: &[Constraint]) -> List<
  Option<Shared<Type>>,
> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut table = List<Option<Shared<Type>>>.make()
  let mut at = usize.ZERO
  while at < binderCount {
    run List<Option<Shared<Type>>>.append(&mut table, Option<Shared<Type>>.none())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      let ordinal = Shared<Type>.with<usize>(
        &parameter,
        fn(node: &Type) -> usize {
          return Type.parameterOrdinalOf(node, owner)
        },
      )
      if ordinal < binderCount {
        List<Option<Shared<Type>>>.set(
          &mut table,
          ordinal,
          Option<Shared<Type>>.some(Shared<Type>.clone(&contract)),
        )
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Property {subject, property} = &constraints[at] {
      let detached = match property {
        IntrinsicProperty.Detached => true
        IntrinsicProperty.NonParking => false
      }
      let ordinal = Shared<Type>.with<usize>(
        &subject,
        fn(node: &Type) -> usize {
          return Type.parameterOrdinalOf(node, owner)
        },
      )
      if detached && ordinal < binderCount && representedIn(&table, ordinal) {
        let nothing = run Types.intern(Type.Unit)
        List<Option<Shared<Type>>>.set(
          &mut table,
          ordinal,
          Option<Shared<Type>>.some(move nothing),
        )
      }
    }
    at = at + usize.ONE
  }
  return move table
}

fn representedIn(table: &List<Option<Shared<Type>>>, ordinal: usize) -> bool {
  let entries = List<Option<Shared<Type>>>.asSlice(table)
  return match & entries[ordinal] {
    Option<Shared<Type>>.Some {..} => true
    Option<Shared<Type>>.None => false
  }
}

effect fn resolveSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declaredModule = resolvedModule(&resolver.*, key.module)
  let declarationAccess73 = declarationPosition(&resolver.*, key)
  if run effectBlockHeader(&mut resolver.*, &declaredModule, declarationAccess73) {
    return run resolveBlockSignature(&mut resolver.*, &mut owner.*, key)
  }
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    key,
    List<Dependency>.make(),
    Option<List<Argument>>.none(),
    Option<List<Argument>>.none(),
    &Option<Application>.none(),
    )
}

// An `effect {}` block has no header: its runner takes no parameters, and its channels are the
// ones its checked body derived (EFF-002, EFF-011), read from the body its owner retains.
effect fn resolveBlockSignature(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let bodyAnswer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {
    family: Family.Body, module: key.module, name: usize.ZERO, declaration: key.declaration, member: usize.ZERO, external: false,
  }, Span.make(usize.ZERO, usize.ZERO))
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&bodyAnswer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return run memberRejected(move value, move dependencies) }
  let typed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&bodyAnswer, answerTypedBody)
  let mut parts = Option<EffectParts>.none()
  if let Option<Shared<TypedBody>>.Some {value: body} = move typed {
    parts = Shared<TypedBody>.with<Option<EffectParts>>(&body, fn(value: &TypedBody) -> Option<EffectParts> {
      let retained = TypedBody.environmentOf(value)
      if let Option<BodyEnvironment>.Some {value: environment} = &retained.* {
        return Shared<Type>.with<Option<EffectParts>>(&environment.ty, effectParts)
      }
      return Option<EffectParts>.none()
    })
  }
  let channels = match move parts {
    Option<EffectParts>.Some {value} => move value
    Option<EffectParts>.None => {
      let module = resolvedModule(&resolver.*, key.module)
      return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)), move dependencies)
    }
  }
  let regions = run callableEnvironmentRegions(&channels.environment)
  let environment = run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))
  return memberSuccess(Value.Signature {signature: Signature {typeParameters: List<Shared<Type>>.make(),
    callableParameterStart: usize.MAX, lifetimeParameters: List<Shared<Lifetime>>.make(), rowParameters: List<RowParameter>.make(),
    constraints: List<Constraint>.make(), parameters: List<Shared<Type>>.make(), result: move channels.success,
    failure: move channels.failure, requirements: move channels.requirements, isEffect: true, isVariadic: false, isUnsafe: false, isStatic: false,
    staticSlots: List<usize>.make(), environment: Option<Intersection>.some(move environment), environmentWritten: false, environmentExempt: usize.MAX}}, move dependencies)
}

// The applied parts of one resolved `impl` head.
struct HeadApplication {
  contract: Option<Shared<Type>>,
  provider: Shared<Type>,
  span: Span,
  contractSpan: Span,
}

fn headApplication(head: &ImplementationHead) -> HeadApplication {
  let mut contract = Option<Shared<Type>>.none()
  if let Option<Shared<Type>>.Some {value} = &head.contract {
    contract = Option<Shared<Type>>.some(Shared<Type>.clone(&value))
  }
  return HeadApplication {
    contract: move contract,
    provider: Shared<Type>.clone(&head.provider),
    span: head.span,
    contractSpan: head.contractSpan,
  }
}

// The operation at `position` in a successful operation list.
fn operationAt(answer: &Result<Answer, NoRejection>, position: usize) -> Option<
  Shared<DeclarationId>,
> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations, ..}} = &value.outcome {
      let listed = List<Shared<DeclarationId>>.asSlice(&operations)
      if position < listed.length {
        return Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&listed[position]))
      }
    }
  }
  return Option<Shared<DeclarationId>>.none()
}

// The position of `operation` in the operation list of the contract a conformance head names,
// or the rejection a caller receives: the head's or list's own, or `UnknownMember` when the
// operation belongs to no contract of this head.
effect fn operationPosition(
  resolver: &mut Resolver,
  query: &mut Query<Answer, NoRejection>,
  moduleOrdinal: usize,
  implementation: usize,
  operation: &DeclarationId,
) -> Result<usize, Shared<Result<Answer, NoRejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let declarationAccess74Request = Key {
    family: Family.ImplementationHead,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: implementation,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess74 = run internDeclaration(&mut resolver.*, declarationAccess74Request)
  let headKey = declarationAccess74
  let headAnswer = run demandRaw(
    &mut resolver.*,
    &mut query.*,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Result<usize, Shared<Result<Answer, NoRejection>>>.failResult(move headAnswer)
    }
  }
  let applied = Shared<ImplementationHead>.with<HeadApplication>(&head, headApplication)
  let HeadApplication {contract: written, provider: unused, span, contractSpan} = move applied
  drop unused
  let mut anchor = contractSpan
  let mut contractModuleOrdinal = usize.MAX
  let mut contractOrdinal = Option<usize>.none()
  if let Option<Shared<Type>>.Some {value: contract} = move written {
    contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &contract)
    if contractModuleOrdinal != usize.MAX {
      let contractModule = resolvedModule(&resolver.*, contractModuleOrdinal)
      contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractModule, &contract)
    }
  } else {
    anchor = span
  }
  if let Option<usize>.Some {value: declaration} = move contractOrdinal {
    let declarationAccess75Request = Key {
      family: Family.Operations,
      module: contractModuleOrdinal,
      name: usize.ZERO,
      declaration: declaration,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess75 = run internDeclaration(&mut resolver.*, declarationAccess75Request)
    let operationsKey = declarationAccess75
    let listed = run demandRaw(&mut resolver.*, &mut query.*, operationsKey, contractSpan)
    if Shared<Result<Answer, NoRejection>>.with<bool>(&listed, hasRejection) {
      return Result<usize, Shared<Result<Answer, NoRejection>>>.failResult(move listed)
    }
    let position = Shared<Result<Answer, NoRejection>>.with<usize>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return operationIndex(answer, operation)
      },
    )
    if position != usize.MAX {
      return Result<usize, Shared<Result<Answer, NoRejection>>>.succeed(position)
    }
  }
  return Result<usize, Shared<Result<Answer, NoRejection>>>.failResult(
    run rejectAbsent(&mut resolver.*, &module, anchor, RejectionCode.UnknownOperation),
  )
}

fn operationIndex(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations, ..}} = &value.outcome {
      let listed = List<Shared<DeclarationId>>.asSlice(&operations)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<DeclarationId>.with<bool>(
          &listed[at],
          fn(candidate: &DeclarationId) -> bool {
            return DeclarationId.equals(candidate, operation)
          },
        ) {
          return at
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

// Whether the operation at `position` in a successful operation list writes a default body.
fn defaultedAt(answer: &Result<Answer, NoRejection>, position: usize) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {defaults, ..}} = &value.outcome {
      let listed = List<bool>.asSlice(&defaults)
      if position < listed.length { return listed[position] }
    }
  }
  return false
}

// Whether `operation` writes a default body in its successful operation list.
fn defaultedOperation(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> bool {
  let position = operationIndex(answer, operation)
  if position == usize.MAX { return false }
  return defaultedAt(answer, position)
}

fn listedOperation(answer: &Result<Answer, NoRejection>, ordinal: usize) -> Option<
  Shared<DeclarationId>,
> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations, ..}} = &value.outcome {
      let listed = List<Shared<DeclarationId>>.asSlice(&operations)
      if ordinal < listed.length {
        return Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&listed[ordinal]))
      }
    }
  }
  return Option<Shared<DeclarationId>>.none()
}

fn listedOperationCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations, ..}} = &value.outcome {
      return List<Shared<DeclarationId>>.length(&operations)
    }
  }
  return usize.ZERO
}

// Re-resolves one operation under a known interface application and provider. This is the shared
// call contract for qualified, receiver, and operator spellings. The selected witness is a
// separate proof result: neither arguments nor expected result may choose one here.
effect fn resolveAppliedOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let applications = List<Shared<Type>>.asSlice(&resolver.applications)
  let contract = Shared<Type>.clone(&applications[key.name])
  let provider = Shared<Type>.clone(&applications[key.member])
  let mut dependencies = List<Dependency>.make()
  let declarationAccess76 = declarationPosition(&resolver.*, key)
  let written = run scopedHeader(&mut resolver.*, &module, declarationAccess76)
  let operationSpan = match move written {
    Option<HeaderSyntax>.Some {value} => value.span
    Option<HeaderSyntax>.None => Span.make(usize.ZERO, usize.ZERO)
  }
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, &contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownOperation, operationSpan),
        move dependencies,
      )
    }
  }
  let declarationAccess77Request = Key {
      family: Family.Operations,
      module: key.module,
      name: usize.ZERO,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess77 = run internDeclaration(&mut resolver.*, declarationAccess77Request)
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    declarationAccess77,
    operationSpan,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return run memberRejected(move value, move dependencies)
  }
  let declarationAccess78 = declarationPosition(&resolver.*, key)
  let operation = run declarationAt(&mut resolver.*, &module, declarationAccess78)
  let selected = match move operation {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownOperation, operationSpan),
        move dependencies,
      )
    }
  }
  let position = Shared<Result<Answer, NoRejection>>.with<usize>(
    &listed,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return operationIndex(answer, &selected)
    },
  )
  if position == usize.MAX {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.UnknownOperation, operationSpan),
      move dependencies,
    )
  }
  let mut supplied = List<Argument>.make()
  let mut count = Shared<Type>.with<usize>(&contract, applicationLength)
  if count == usize.MAX {
    count = usize.ZERO
  }
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared<Type>.with<Option<Argument>>(
      &contract,
      fn(value: &Type) -> Option<Argument> {
        return applicationArgument(value, at)
      },
    )
    if let Option<Argument>.Some {value} = move argument {
      run List<Argument>.append(&mut supplied, move value)
    }
    at = at + usize.ONE
  }
  run List<Argument>.append(&mut supplied, Argument.Type {value: move provider})
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let authored = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    operationSpan,
  )
  let invalid = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &authored,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return run memberRejected(move value, move dependencies)
  }
  drop authored
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    signatureKey,
    move dependencies,
    Option<List<Argument>>.some(move supplied),
    Option<List<Argument>>.none(),
    &Option<Application>.none(),
    )
}

// Resolves an inherent receiver call under the exact nominal application. The owner's published
// member list gates the query, so a duplicate or field collision keeps its anchored rejection.
effect fn resolveAppliedInherent(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let applications = List<Shared<Type>>.asSlice(&resolver.applications)
  let provider = Shared<Type>.clone(&applications[key.name])
  let mut dependencies = List<Dependency>.make()
  let ownerOrdinal = run ordinalOfProvider(&mut resolver.*, &module, &provider)
  let position = match move ownerOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownOperation,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let declarationAccess79Request = Key {
      family: Family.InherentMembers,
      module: key.module,
      name: usize.ZERO,
      declaration: position,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess79 = run internDeclaration(&mut resolver.*, declarationAccess79Request)
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    declarationAccess79,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return run memberRejected(move value, move dependencies)
  }
  let declarationAccess80 = declarationPosition(&resolver.*, key)
  let declared = run declarationAt(&mut resolver.*, &module, declarationAccess80)
  let selected = match move declared {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownOperation,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let verdict = Shared<Result<Answer, NoRejection>>.with<MemberVerdict>(
    &listed,
    fn(answer: &Result<Answer, NoRejection>) -> MemberVerdict {
      return memberVerdict(answer, &selected)
    },
  )
  if let Option<Shared<Rejection>>.Some {value} = move verdict.rejected {
    return run memberRejected(move value, move dependencies)
  }
  if !verdict.published {
    return run memberRejected(
      run reject(
        &resolver.*,
        &module,
        RejectionCode.UnknownOperation,
        Span.make(usize.ZERO, usize.ZERO),
      ),
      move dependencies,
    )
  }
  let mut supplied = List<Argument>.make()
  let count = Shared<Type>.with<usize>(&provider, applicationLength)
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared<Type>.with<Option<Argument>>(
      &provider,
      fn(value: &Type) -> Option<Argument> {
        return applicationArgument(value, at)
      },
    )
    if let Option<Argument>.Some {value} = move argument {
      run List<Argument>.append(&mut supplied, move value)
    }
    at = at + usize.ONE
  }
  run List<Argument>.append(&mut supplied, Argument.Type {value: move provider})
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let authored = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let invalid = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &authored,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return run memberRejected(move value, move dependencies)
  }
  drop authored
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    signatureKey,
    move dependencies,
    Option<List<Argument>>.some(move supplied),
    Option<List<Argument>>.none(),
    &Option<Application>.none(),
    )
}

// Re-resolves one contract operation's written header under a conformance head: the contract's
// binders take the head's contract arguments in order and `Self` takes its provider. The head and
// the contract's operation list are child answers of this query, and the operation's enclosing
// scope is resolved as written, so an edit to any of those headers recomputes the answer.
effect fn resolveOperationUnder(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &headAnswer,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return run memberRejected(move diagnostic, move dependencies)
      }
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let applied = Shared<ImplementationHead>.with<HeadApplication>(&head, headApplication)
  let HeadApplication {contract: written, provider, span, contractSpan} = move applied
  // An inherent or sealed-property head has no contract whose operation could be meant.
  let contract = match move written {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownOperation, span),
        move dependencies,
      )
    }
  }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &contract)
  if contractModuleOrdinal == usize.MAX {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.UnknownOperation, contractSpan),
      move dependencies,
    )
  }
  let contractModule = resolvedModule(&resolver.*, contractModuleOrdinal)
  let located = run ordinalOfProvider(&mut resolver.*, &contractModule, &contract)
  let contractOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownOperation, contractSpan),
        move dependencies,
      )
    }
  }
  let declarationAccess81Request = Key {
    family: Family.Operations,
    module: contractModuleOrdinal,
    name: usize.ZERO,
    declaration: contractOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess81 = run internDeclaration(&mut resolver.*, declarationAccess81Request)
  let operationsKey = declarationAccess81
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    operationsKey,
    contractSpan,
  )
  let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refused {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let position = key.member
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
    &listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return operationAt(answer, position)
    },
  )
  let operation = match move selected {
    Option<Shared<DeclarationId>>.Some {value} => move value
    Option<Shared<DeclarationId>>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownOperation, contractSpan),
        move dependencies,
      )
    }
  }
  let found = run ordinalOfIdentity(&mut resolver.*, &contractModule, &operation)
  let operationOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownOperation, contractSpan),
        move dependencies,
      )
    }
  }
  let mut supplied = List<Argument>.make()
  let mut count = Shared<Type>.with<usize>(&contract, applicationLength)
  if count == usize.MAX {
    count = usize.ZERO
  }
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared<Type>.with<Option<Argument>>(
      &contract,
      fn(ty: &Type) -> Option<Argument> {
        return applicationArgument(ty, at)
      },
    )
    if let Option<Argument>.Some {value} = move argument {
      run List<Argument>.append(&mut supplied, move value)
    }
    at = at + usize.ONE
  }
  run List<Argument>.append(&mut supplied, Argument.Type {value: move provider})
  let declarationAccess82Request = Key {
    family: Family.Signature,
    module: contractModuleOrdinal,
    name: usize.ZERO,
    declaration: operationOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess82 = run internDeclaration(&mut resolver.*, declarationAccess82Request)
  let signatureKey = declarationAccess82
  // Check the authored public operation before substituting the provider. A private concrete
  // `Self` is valid here, but a private type written in the public operation is not.
  let authored = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    contractSpan,
  )
  let refusedSignature = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &authored,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedSignature {
    return run memberRejected(move diagnostic, move dependencies)
  }
  drop authored
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    signatureKey,
    move dependencies,
    Option<List<Argument>>.some(move supplied),
    Option<List<Argument>>.none(),
    &Option<Application>.none(),
    )
}

// The first way one implementation fails its substituted operation header. `Unsupported` marks a
// comparison outside the fragment decided here; it never admits a witness.
union Verdict {
  Compatible,
  Incompatible {problem: WitnessProblem},
  Unsupported,
}

fn compatible(verdict: &Verdict) -> bool {
  return match & verdict.* {
    Verdict.Compatible => true
    _ => false
  }
}

// The facts of one signature answer that witness checking compares, with shared handles cloned.
struct SignatureFacts {
  isEffect: bool,
  isVariadic: bool,
  isUnsafe: bool,
  isStatic: bool,
  parameters: usize,
  // The number of `static` parameter slots of a runtime function.
  staticSlots: usize,
  binders: usize,
  callableParameterStart: usize,
  constraints: usize,
  result: Shared<Type>,
  failure: Shared<Type>,
  requirements: Shared<Row>,
  // The environment's region count; `usize.MAX` for an ordinary function.
  environment: usize,
  // Whether that environment was written (`Signature.environmentWritten`).
  environmentWritten: bool,
  // The input it does not cover (`Signature.environmentExempt`).
  environmentExempt: usize,
}

fn copyArgument(argument: &Argument) -> Argument {
  return match & argument.* {
    Argument.Type {value} => Argument.Type {value: Shared<Type>.clone(&value)}
    Argument.Lifetime {value} => Argument.Lifetime {value: Shared<Lifetime>.clone(&value)}
    Argument.Row {value} => Argument.Row {value: Shared<Row>.clone(&value)}
  }
}

effect fn copyArguments(arguments: &[Argument]) -> List<Argument>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = List<Argument>.make()
  let mut at = usize.ZERO
  while at < arguments.length {
    run List<Argument>.append(&mut copied, copyArgument(&arguments[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn appendArguments(target: &mut List<Argument>, source: &[Argument]) -> ()
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < source.length {
    run List<Argument>.append(&mut target.*, copyArgument(&source[at]))
    at = at + usize.ONE
  }
  return ()
}

fn ownedLifetimeOrdinal(region: &Shared<Lifetime>, owner: &DeclarationId) -> usize {
  return Shared<Lifetime>.with<usize>(
    region,
    fn(value: &Lifetime) -> usize {
      if let Lifetime.Parameter {declaration, ordinal} = &value.* {
        if DeclarationId.equals(&declaration, owner) {
          return ordinal
        }
      }
      return usize.MAX
    },
  )
}

effect fn usesOwnedLifetime(value: &Shared<Type>, owner: &DeclarationId, ordinal: usize) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  let used = List<usize>.asSlice(&lifetimes)
  let mut at = usize.ZERO
  while at < used.length {
    if used[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// The arguments `bindings` give `owner`, one per ordinal up to the last it binds. An ordinal they
// leave unbound keeps the owner's own lifetime parameter, which elision then leaves unchanged.
effect fn appliedOwnArguments(bindings: &[Binding], owner: &DeclarationId) -> List<Argument>
! OutOfMemoryError ? &mut Allocator {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < bindings.length {
    let owned = Shared<DeclarationId>.with<bool>(&bindings[at].declaration,
      fn(found: &DeclarationId) -> bool { return DeclarationId.equals(found, owner) })
    if owned && bindings[at].ordinal >= count { count = bindings[at].ordinal + usize.ONE }
    at = at + usize.ONE
  }
  let mut arguments = List<Argument>.make()
  let mut ordinal = usize.ZERO
  while ordinal < count {
    let argument = match move bindingArgument(bindings, owner, ordinal) {
      Option<Argument>.Some {value} => move value
      Option<Argument>.None => Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {
        declaration: DeclarationId.copy(owner), ordinal: ordinal})}
    }
    run List<Argument>.append(&mut arguments, move argument)
    ordinal = ordinal + usize.ONE
  }
  return move arguments
}

fn bindingArgument(bindings: &[Binding], owner: &DeclarationId, ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && Shared<DeclarationId>.with<bool>(
      &bindings[at].declaration,
      fn(found: &DeclarationId) -> bool {
        return DeclarationId.equals(found, owner)
      },
    ) {
      return Option<Argument>.some(copyArgument(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option<Argument>.none()
}

fn lentArgument(lent: &[Shared<Lifetime>], owner: &DeclarationId, ordinal: usize) -> Option<
  Argument,
> {
  let mut at = usize.ZERO
  while at < lent.length {
    if ownedLifetimeOrdinal(&lent[at], owner) == ordinal {
      return Option<Argument>.some(Argument.Lifetime {value: Shared<Lifetime>.clone(&lent[at])})
    }
    at = at + usize.ONE
  }
  return Option<Argument>.none()
}

effect fn matchedArguments(
  count: usize,
  owner: &DeclarationId,
  bindings: &[Binding],
  lent: &[Shared<Lifetime>],
) -> Option<List<Argument>> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<Argument>.make()
  let mut at = usize.ZERO
  while at < count {
    let bound = bindingArgument(bindings, owner, at)
    if let Option<Argument>.Some {value} = move bound {
      run List<Argument>.append(&mut arguments, move value)
    } else {
      let borrowed = lentArgument(lent, owner, at)
      if let Option<Argument>.Some {value} = move borrowed {
        run List<Argument>.append(&mut arguments, move value)
      } else {
        return Option<List<Argument>>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<List<Argument>>.some(move arguments)
}

fn unboundTypeIn(value: &Shared<Type>, owner: &DeclarationId, count: usize, bindings: &[Binding]) -> bool {
  let mut at = usize.ZERO
  while at < count {
    if Type.occurrences(value, owner, at) > usize.ZERO {
      if let Option<Argument>.None = move bindingArgument(bindings, owner, at) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn unboundRowValue(value: &Row, owner: &DeclarationId, bindings: &[Binding]) -> bool {
  let parameters = List<RowParameter>.asSlice(&value.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let owned = Shared<DeclarationId>.with<bool>(
      &parameters[at].declaration,
      fn(declaration: &DeclarationId) -> bool {
        return DeclarationId.equals(declaration, owner)
      },
    )
    if owned {
      if let Option<Argument>.None = move bindingArgument(bindings, owner, parameters[at].ordinal) {
        return true
      }
    }
    at = at + usize.ONE
  }
  let terms = List<RowSubtraction>.asSlice(&value.subtractions)
  at = usize.ZERO
  while at < terms.length {
    if unboundRowIn(&terms[at].source, owner, bindings) || unboundRowIn(&terms[at].removed, owner, bindings) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn unboundRowIn(row: &Shared<Row>, owner: &DeclarationId, bindings: &[Binding]) -> bool {
  return Shared<Row>.with<bool>(
    row,
    fn(value: &Row) -> bool {
      return unboundRowValue(value, owner, bindings)
    },
  )
}

// A carrier lets the public exact type unifier handle a requirement row without a second row
// matcher. Its other fields are identical on both sides and carry no witness information.
effect fn rowCarrier(row: &Shared<Row>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(
    Type.Effect {
      mode: CallableMode.Shared,
      environment: run Shared<Intersection>.make(
        Intersection {members: List<LifetimeMember>.make()},
      ),
      success: run Types.intern(Type.Unit),
      failure: run Types.intern(Type.Unit),
      requirements: Shared<Row>.clone(row),
    },
  )
}

fn signatureFacts(answer: &Result<Answer, NoRejection>) -> Option<SignatureFacts> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let mut environment = usize.MAX
      if let Option<Intersection>.Some {value: retained} = &signature.environment {
        environment = List<LifetimeMember>.length(&retained.members)
      }
      return Option<SignatureFacts>.some(
        SignatureFacts {
          isEffect: signature.isEffect,
          isVariadic: signature.isVariadic,
          isUnsafe: signature.isUnsafe,
          isStatic: signature.isStatic,
          parameters: List<Shared<Type>>.length(&signature.parameters),
          staticSlots: List<usize>.length(&signature.staticSlots),
          binders: List<Shared<Type>>.length(&signature.typeParameters) + List<
            Shared<Lifetime>,
          >.length(&signature.lifetimeParameters) + List<RowParameter>.length(&signature.rowParameters),
          callableParameterStart: signature.callableParameterStart,
          constraints: List<Constraint>.length(&signature.constraints),
          result: Shared<Type>.clone(&signature.result),
          failure: Shared<Type>.clone(&signature.failure),
          requirements: Shared<Row>.clone(&signature.requirements),
          environment: environment,
          environmentWritten: signature.environmentWritten,
          environmentExempt: signature.environmentExempt,
        },
      )
    }
  }
  return Option<SignatureFacts>.none()
}

// The original parameter index of one `static` slot.
effect fn signatureStaticSlots(signature: &Shared<Result<Answer, NoRejection>>, count: usize) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut slots = List<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    let slot = Shared<Result<Answer, NoRejection>>.with<usize>(signature, fn(answer: &Result<Answer, NoRejection>) -> usize {
      return signatureStaticSlot(answer, at)
    })
    run List<usize>.append(&mut slots, slot)
    at = at + usize.ONE
  }
  return move slots
}

fn signatureStaticSlot(answer: &Result<Answer, NoRejection>, at: usize) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let slots = List<usize>.asSlice(&signature.staticSlots)
      if at < slots.length { return slots[at] }
    }
  }
  return usize.MAX
}

fn signatureConstraintAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let listed = List<Constraint>.asSlice(&signature.constraints)
      if at < listed.length {
        return Option<Constraint>.some(copyConstraint(&listed[at]))
      }
    }
  }
  return Option<Constraint>.none()
}

fn contractConstraintCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Contract {contract}} = &value.outcome {
      return List<Constraint>.length(&contract.constraints)
    }
  }
  return usize.ZERO
}

fn contractConstraintAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Contract {contract}} = &value.outcome {
      let listed = List<Constraint>.asSlice(&contract.constraints)
      if at < listed.length {
        return Option<Constraint>.some(copyConstraint(&listed[at]))
      }
    }
  }
  return Option<Constraint>.none()
}

fn headConstraintAt(head: &ImplementationHead, at: usize) -> Option<Constraint> {
  let listed = List<Constraint>.asSlice(&head.binders.constraints)
  if at < listed.length {
    return Option<Constraint>.some(copyConstraint(&listed[at]))
  }
  return Option<Constraint>.none()
}

effect fn sameConstraint(left: &Constraint, right: &Constraint) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Constraint.Conforms {provider, contract} = &left.* {
    if let Constraint.Conforms {provider: otherProvider, contract: otherContract} = &right.* {
      let sameProvider = run Type.equalsShared(&provider, &otherProvider)
      if !sameProvider {
        return false
      }
      return run Type.equalsShared(&contract, &otherContract)
    }
    return false
  }
  if let Constraint.Represents {parameter, contract} = &left.* {
    if let Constraint.Represents {parameter: otherParameter, contract: otherContract} = &right.* {
      let sameParameter = run Type.equalsShared(&parameter, &otherParameter)
      if !sameParameter {
        return false
      }
      return run Type.equalsShared(&contract, &otherContract)
    }
    return false
  }
  if let Constraint.Contents {subject, region} = &left.* {
    if let Constraint.Contents {subject: otherSubject, region: otherRegion} = &right.* {
      let sameSubject = run Type.equalsShared(&subject, &otherSubject)
      return sameSubject && Lifetime.equalsShared(&region, &otherRegion)
    }
    return false
  }
  if let Constraint.Outlives {longer, shorter} = &left.* {
    if let Constraint.Outlives {longer: otherLonger, shorter: otherShorter} = &right.* {
      return Lifetime.equalsShared(&longer, &otherLonger) && Lifetime.equalsShared(
        &shorter,
        &otherShorter,
      )
    }
    return false
  }
  if let Constraint.Copyable {subject} = &left.* {
    if let Constraint.Copyable {subject: otherSubject} = &right.* {
      return run Type.equalsShared(&subject, &otherSubject)
    }
    return false
  }
  if let Constraint.ThreadSafe {subject, property} = &left.* {
    if let Constraint.ThreadSafe {subject: otherSubject, property: otherProperty} = &right.* {
      let sameSubject = run Type.equalsShared(&subject, &otherSubject)
      return sameSubject && property == otherProperty
    }
    return false
  }
  if let Constraint.Property {subject, property} = &left.* {
    if let Constraint.Property {subject: otherSubject, property: otherProperty} = &right.* {
      let sameSubject = run Type.equalsShared(&subject, &otherSubject)
      return sameSubject && property == otherProperty
    }
    return false
  }
  if let Constraint.Provides {provider, selector, source} = &left.* {
    if let Constraint.Provides {provider: otherProvider, selector: otherSelector, source: otherSource} = &right.* {
      if !run Type.equalsShared(&provider, &otherProvider) {
        return false
      }
      if !run Row.equalsShared(&selector, &otherSelector) {
        return false
      }
      return run Row.equalsShared(&source, &otherSource)
    }
    return false
  }
  if let Constraint.FailureSubset {selected, source} = &left.* {
    if let Constraint.FailureSubset {selected: otherSelected, source: otherSource} = &right.* {
      let sameSelected = run Type.equalsShared(&selected, &otherSelected)
      if !sameSelected { return false }
      return run Type.equalsShared(&source, &otherSource)
    }
    return false
  }
  if let Constraint.RequirementSubset {selected, source} = &left.* {
    if let Constraint.RequirementSubset {selected: otherSelected, source: otherSource} = &right.* {
      if !run Row.equalsShared(&selected, &otherSelected) { return false }
      return run Row.equalsShared(&source, &otherSource)
    }
    return false
  }
  return false
}

// The declared `?S in R` premises among `constraints`.
effect fn rowPremises(constraints: &[Constraint]) -> List<RowPremise> ! OutOfMemoryError ? &mut Allocator {
  let mut premises = List<RowPremise>.make()
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.RequirementSubset {selected, source} = &constraints[at] {
      run List<RowPremise>.append(&mut premises, RowPremise {selected: Shared<Row>.clone(&selected), source: Shared<Row>.clone(&source)})
    }
    at = at + usize.ONE
  }
  return move premises
}

effect fn witnessBoundsImplied(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  witness: &Shared<Result<Answer, NoRejection>>,
  count: usize,
  operationCount: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let headCount = Shared<ImplementationHead>.with<usize>(head, headConstraintCount)
  let mut assumptions = List<Constraint>.make()
  let mut source = usize.ZERO
  while source < headCount {
    let bound = Shared<ImplementationHead>.with<Option<Constraint>>(
      head,
      fn(value: &ImplementationHead) -> Option<Constraint> {
        return headConstraintAt(value, source)
      },
    )
    if let Option<Constraint>.Some {value} = move bound {
      run List<Constraint>.append(&mut assumptions, move value)
    }
    source = source + usize.ONE
  }
  source = usize.ZERO
  while source < operationCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(
      operation,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraintAt(answer, source)
      },
    )
    if let Option<Constraint>.Some {value} = move bound {
      run List<Constraint>.append(&mut assumptions, move value)
    }
    source = source + usize.ONE
  }
  let forbidden = Option<Shared<DeclarationId>>.some(
    Shared<ImplementationHead>.with<Shared<DeclarationId>>(
      head,
      fn(value: &ImplementationHead) -> Shared<DeclarationId> {
        return Shared<DeclarationId>.clone(&value.declaration)
      },
    ),
  )
  let mut at = usize.ZERO
  while at < count {
    let needed = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(
      witness,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraintAt(answer, at)
      },
    )
    let bound = match move needed {
      Option<Constraint>.Some {value} => move value
      Option<Constraint>.None => {
        return false
      }
    }
    let mut implied = false
    let available = List<Constraint>.asSlice(&assumptions)
    let mut prior = usize.ZERO
    while prior < available.length && !implied {
      implied = run sameConstraint(&bound, &available[prior])
      prior = prior + usize.ONE
    }
    if !implied {
      if let Constraint.Conforms {provider, contract} = &bound {
        let goal = ConformanceGoal {
          contract: Shared<Type>.clone(&contract),
          provider: Shared<Type>.clone(&provider),
        }
        let mut request = Request.make()
        let mut chain = List<ConformanceGoal>.make()
        let mut steps = List<ConformanceStep>.make()
        let failed = run proveGoal(
          &mut resolver.*,
          &mut owner.*,
          &mut request,
          &mut dependencies.*,
          true,
          &forbidden,
          &goal,
          available,
          siteModule,
          siteSpan,
          &mut chain,
          &mut steps,
        )
        if let Option<Shared<Rejection>>.Some {value: _} = move failed {
          return false
        }
      } else if let Constraint.Provides {provider: wanted, selector: selected, source: from} = &bound {
        // A provides premise is keyed by access and provider type, whatever the loan's region.
        if !run declaredProvidesThroughBorrow(available, &wanted, &selected, &from) { return false }
      } else if let Constraint.RequirementSubset {selected, source: from} = &bound {
        let premises = run rowPremises(available)
        if !run Row.knownSubset(&selected, &from, List<RowPremise>.asSlice(&premises)) { return false }
      } else {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

fn environmentRegion(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Lifetime>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if let Option<Intersection>.Some {value: retained} = &signature.environment {
        let members = List<LifetimeMember>.asSlice(&retained.members)
        if at < members.length {
          return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&members[at].region))
        }
      }
    }
  }
  return Option<Shared<Lifetime>>.none()
}

fn outlivesTarget(constraint: &Constraint, longer: &Shared<Lifetime>) -> Option<Shared<Lifetime>> {
  if let Constraint.Outlives {longer: written, shorter} = &constraint.* {
    if Lifetime.equalsShared(&written, longer) {
      return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&shorter))
    }
  }
  return Option<Shared<Lifetime>>.none()
}

fn containsRegion(regions: &[Shared<Lifetime>], candidate: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if Lifetime.equalsShared(&regions[at], candidate) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn regionAt(regions: &List<Shared<Lifetime>>, at: usize) -> Shared<Lifetime> {
  let listed = List<Shared<Lifetime>>.asSlice(regions)
  return Shared<Lifetime>.clone(&listed[at])
}

// The regions of a signature's environment, or none for an ordinary function.
effect fn environmentRegions(answer: &Shared<Result<Answer, NoRejection>>, count: usize) -> List<
  Shared<Lifetime>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut regions = List<Shared<Lifetime>>.make()
  if count == usize.MAX {
    return move regions
  }
  let mut at = usize.ZERO
  while at < count {
    let region = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(
      answer,
      fn(resolved: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> {
        return environmentRegion(resolved, at)
      },
    )
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      run List<Shared<Lifetime>>.append(&mut regions, move value)
    }
    at = at + usize.ONE
  }
  return move regions
}

// Infer a witness environment as one complete set equation. Operand-lent regions are invocation
// evidence already checked separately and do not become retained environment obligations.
effect fn bindEnvironmentArgument(
  operation: &Shared<Result<Answer, NoRejection>>,
  promisedCount: usize,
  witness: &Shared<Result<Answer, NoRejection>>,
  providedCount: usize,
  witnessOwner: &DeclarationId,
  variables: &[Shared<DeclarationId>],
  bindings: &mut List<Binding>,
  lent: &[Shared<Lifetime>],
  contractResult: &Shared<Type>,
) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  let provided = run environmentRegions(witness, providedCount)
  let providedRegions = List<Shared<Lifetime>>.asSlice(&provided)
  let mut unbound = false
  let mut at = usize.ZERO
  while at < providedRegions.length {
    let ordinal = ownedLifetimeOrdinal(&providedRegions[at], witnessOwner)
    if ordinal != usize.MAX {
      if let Option<Argument>.None = move bindingArgument(
        List<Binding>.asSlice(&bindings.*),
        witnessOwner,
        ordinal,
      ) {
        if let Option<Argument>.None = move lentArgument(lent, witnessOwner, ordinal) {
          unbound = true
        }
      }
    }
    at = at + usize.ONE
  }
  if !unbound {
    return Verdict.Compatible
  }
  let promised = run environmentRegions(operation, promisedCount)
  let mut retained = List<Shared<Lifetime>>.make()
  at = usize.ZERO
  while at < providedRegions.length {
    if !containsRegion(lent, &providedRegions[at]) {
      run List<Shared<Lifetime>>.append(&mut retained, Shared<Lifetime>.clone(&providedRegions[at]))
    }
    at = at + usize.ONE
  }
  let expected = run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&promised)))
  let offered = run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&retained)))
  let matched = run Type.unifyEnvironments(&expected, &offered, contractResult, variables, &mut bindings.*)
  return match move matched {
    Unification.Unified => Verdict.Compatible
    Unification.Distinct => Verdict.Incompatible {problem: WitnessProblem.Environment}
    Unification.Undetermined {..} => Verdict.Unsupported
  }
}

// The regions an Effect capturing these parameters retains, with whether every one is known.
struct Retained {
  regions: List<Shared<Lifetime>>,
  known: bool,
}

effect fn retainedByParameters(
  answer: &Shared<Result<Answer, NoRejection>>,
  count: usize,
  owner: &DeclarationId,
) -> Retained ! OutOfMemoryError ? &mut Allocator {
  let mut retained = Retained {regions: List<Shared<Lifetime>>.make(), known: true}
  let none = List<Option<Shared<Type>>>.make()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      answer,
      fn(resolved: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(resolved, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move parameter {
      if !run Type.retainedRegions(
        &value,
        owner,
        List<Option<Shared<Type>>>.asSlice(&none),
        &mut retained.regions, false,
      ) {
        retained.known = false
      }
    }
    at = at + usize.ONE
  }
  return move retained
}

// 0 for an owned value, 1 for a reference, 2 for a slice.
fn operandShape(value: &Type) -> usize {
  return match & value.* {
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE + usize.ONE
    _ => usize.ZERO
  }
}

fn exclusiveAccess(access: Access) -> bool {
  return match access {
    Access.Shared => false
    Access.Mutable => true
  }
}

fn operandExclusive(value: &Type) -> bool {
  return match & value.* {
    Type.Reference {access, ..} => exclusiveAccess(access)
    Type.Slice {access, ..} => exclusiveAccess(access)
    _ => false
  }
}

fn operandTarget(value: &Shared<Type>) -> Shared<Type> {
  return Shared<Type>.with<Shared<Type>>(
    value,
    fn(node: &Type) -> Shared<Type> {
      return match & node.* {
        Type.Reference {referent, ..} => Shared<Type>.clone(&referent)
        Type.Slice {element, ..} => Shared<Type>.clone(&element)
        _ => Shared<Type>.clone(value)
      }
    },
  )
}

fn operandRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match & value.* {
    Type.Reference {lifetime, ..} => Option<Shared<Lifetime>>.some(
      Shared<Lifetime>.clone(&lifetime),
    )
    Type.Slice {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
    _ => Option<Shared<Lifetime>>.none()
  }
}

// A scalar intrinsic implements an ordinary operation whose header it matches: the same operand
// count, operand shapes, access and targets, and the same result. Regions are not compared: the
// operation runs in place at the call and retains no loan, so every operand passes as written.
effect fn intrinsicWitnessVerdict(promised: &Shared<Result<Answer, NoRejection>>, member: IntrinsicMember,
  operands: &mut List<OperandPass>) -> Verdict ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if Shared<Result<Answer, NoRejection>>.with<bool>(promised, signatureIsEffect) {
    return Verdict.Incompatible {problem: WitnessProblem.Kind}
  }
  if Shared<Result<Answer, NoRejection>>.with<bool>(promised, signatureIsStatic) {
    return Verdict.Incompatible {problem: WitnessProblem.Phase}
  }
  if Shared<Result<Answer, NoRejection>>.with<usize>(promised, signatureNonLifetimeBinderCount) > usize.ZERO {
    return Verdict.Unsupported
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(promised, signatureParameterCount)
  if count != intrinsicArity(member) {
    return Verdict.Incompatible {problem: WitnessProblem.OperandCount}
  }
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(promised,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    let wanted = match move parameter {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Verdict.Unsupported }
    }
    let kind = match move intrinsicParameterKind(member, at) {
      Option<IntrinsicValueKind>.Some {value} => value
      Option<IntrinsicValueKind>.None => { return Verdict.Unsupported }
    }
    let offered = run intrinsicValueType(kind)
    let wantedShape = Shared<Type>.with<usize>(&wanted, operandShape)
    let offeredShape = Shared<Type>.with<usize>(&offered, operandShape)
    if wantedShape != usize.ZERO && offeredShape == usize.ZERO {
      return Verdict.Incompatible {problem: WitnessProblem.OperandAccess {operand: at}}
    }
    if wantedShape != offeredShape {
      return Verdict.Incompatible {problem: WitnessProblem.OperandShape {operand: at}}
    }
    if Shared<Type>.with<bool>(&offered, operandExclusive) && !Shared<Type>.with<bool>(&wanted, operandExclusive) {
      return Verdict.Incompatible {problem: WitnessProblem.OperandAccess {operand: at}}
    }
    let wantedTarget = operandTarget(&wanted)
    let offeredTarget = operandTarget(&offered)
    if !run Type.equalsShared(&wantedTarget, &offeredTarget) {
      return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
    }
    run List<OperandPass>.append(&mut operands.*, OperandPass.Value)
    at = at + usize.ONE
  }
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(promised, signatureResult)
  let written = match move result {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Verdict.Unsupported }
  }
  let produced = match move intrinsicResultKind(member) {
    Option<IntrinsicValueKind>.Some {value} => run intrinsicValueType(value)
    Option<IntrinsicValueKind>.None => { return Verdict.Unsupported }
  }
  if !run Type.equalsShared(&written, &produced) {
    return Verdict.Incompatible {problem: WitnessProblem.ResultType}
  }
  return Verdict.Compatible
}

// Operand modes are literal; their types and regions use the same exact witness bindings as the
// success type. Only an owned contract value may be lent to a witness-owned fresh borrow.
effect fn operandVerdict(
  promised: &Shared<Type>,
  witness: &Shared<Type>,
  at: usize,
  owner: &DeclarationId,
  variables: &[Shared<DeclarationId>],
  bindings: &mut List<Binding>,
  lent: &mut List<Shared<Lifetime>>,
) -> Verdict ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let promisedShape = Shared<Type>.with<usize>(promised, operandShape)
  let witnessShape = Shared<Type>.with<usize>(witness, operandShape)
  if promisedShape != usize.ZERO && witnessShape == usize.ZERO {
    return Verdict.Incompatible {problem: WitnessProblem.OperandAccess {operand: at}}
  }
  if promisedShape == usize.ZERO && witnessShape != usize.ZERO {
    if witnessShape != usize.ONE {
      return Verdict.Incompatible {problem: WitnessProblem.OperandShape {operand: at}}
    }
    let region = Shared<Type>.with<Option<Shared<Lifetime>>>(witness, operandRegion)
    if let Option<Shared<Lifetime>>.Some {value: borrowed} = move region {
      let ordinal = ownedLifetimeOrdinal(&borrowed, owner)
      if ordinal == usize.MAX {
        return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
      }
      if let Option<Argument>.Some {..} = move bindingArgument(
        List<Binding>.asSlice(&bindings.*),
        owner,
        ordinal,
      ) {
        return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
      }
      let target = operandTarget(witness)
      let compared = run Type.unify(promised, &target, variables, Comparison.Exact, &mut bindings.*)
      match move compared {
        Unification.Unified => {
          run List<Shared<Lifetime>>.append(&mut lent.*, move borrowed)
          return Verdict.Compatible
        }
        Unification.Distinct => {
          return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
        }
        Unification.Undetermined {..} => {
          return Verdict.Unsupported
        }
      }
    }
    return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
  }
  let borrowed = List<Shared<Lifetime>>.asSlice(&lent.*)
  let mut previous = usize.ZERO
  while previous < borrowed.length {
    let ordinal = ownedLifetimeOrdinal(&borrowed[previous], owner)
    if run usesOwnedLifetime(witness, owner, ordinal) {
      return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
    }
    previous = previous + usize.ONE
  }
  if promisedShape == usize.ZERO {
    let compared = run Type.unify(promised, witness, variables, Comparison.Exact, &mut bindings.*)
    return match move compared {
      Unification.Unified => Verdict.Compatible
      Unification.Distinct => Verdict.Incompatible {
        problem: WitnessProblem.OperandType {operand: at},
      }
      Unification.Undetermined {..} => Verdict.Unsupported
    }
  }
  if promisedShape != witnessShape {
    return Verdict.Incompatible {problem: WitnessProblem.OperandShape {operand: at}}
  }
  if Shared<Type>.with<bool>(witness, operandExclusive) && !Shared<Type>.with<bool>(
    promised,
    operandExclusive,
  ) {
    return Verdict.Incompatible {problem: WitnessProblem.OperandAccess {operand: at}}
  }
  let promisedRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(promised, operandRegion)
  let witnessRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(witness, operandRegion)
  let promisedTarget = operandTarget(promised)
  let witnessTarget = operandTarget(witness)
  let target = run Type.unify(
    &promisedTarget,
    &witnessTarget,
    variables,
    Comparison.Exact,
    &mut bindings.*,
  )
  match move target {
    Unification.Unified => {}
    Unification.Distinct => {
      return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
    }
    Unification.Undetermined {..} => {
      return Verdict.Unsupported
    }
  }
  if let Option<Shared<Lifetime>>.Some {value: first} = move promisedRegion {
    if let Option<Shared<Lifetime>>.Some {value: second} = move witnessRegion {
      let firstType = run Types.intern(Type.String {lifetime: move first})
      let secondType = run Types.intern(Type.String {lifetime: move second})
      let compared = run Type.unify(
        &firstType,
        &secondType,
        variables,
        Comparison.Exact,
        &mut bindings.*,
      )
      return match move compared {
        Unification.Unified => Verdict.Compatible
        Unification.Distinct => Verdict.Incompatible {
          problem: WitnessProblem.OperandType {operand: at},
        }
        Unification.Undetermined {..} => Verdict.Unsupported
      }
    }
  }
  return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
}

fn outlivesAssumptionAt(
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  headCount: usize,
  at: usize,
) -> Option<Constraint> {
  if at < headCount {
    return Shared<ImplementationHead>.with<Option<Constraint>>(
      head,
      fn(value: &ImplementationHead) -> Option<Constraint> {
        return headConstraintAt(value, at)
      },
    )
  }
  return Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(
    operation,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
      return signatureConstraintAt(answer, at - headCount)
    },
  )
}

// Query-local finite validity proof. Meet edges are logical rules, never added to the caller's
// constraints. A cycle with no reached seed cannot prove itself; ambient bounds do not change
// canonical region identity.
//
// The proof interns each region once by hash and indexes its edges by shorter region and its
// meets by member, so the fixed point visits each region and edge once rather than rescanning
// every region and edge until nothing changes.
struct OutlivesProof {
  regions: List<Shared<Lifetime>>,
  lookup: InternIndex,
  reached: List<bool>,
  queue: List<usize>,
  // For a meet, the members not yet reached; zero for an atom.
  missing: List<usize>,
  // Outlives edges keyed by the shorter region, and meets keyed by each member.
  edgeShorter: List<usize>,
  edgeLonger: List<usize>,
  edges: InternIndex,
  meetMember: List<usize>,
  meetOf: List<usize>,
  meets: InternIndex,
  // Parameter and Supplied regions, the only ones that can enclose a loan.
  enclosers: List<usize>,
}

fn proofRegion(proof: &OutlivesProof, region: &Shared<Lifetime>) -> usize {
  let regions = List<Shared<Lifetime>>.asSlice(&proof.regions)
  let mut at = InternIndex.first(&proof.lookup, Lifetime.hash(region))
  while at != usize.MAX {
    if Lifetime.equalsShared(&regions[at], region) { return at }
    at = InternIndex.after(&proof.lookup, at)
  }
  return usize.MAX
}

effect fn internProofRegion(proof: &mut OutlivesProof, region: &Shared<Lifetime>) -> usize
! OutOfMemoryError ? &mut Allocator {
  let known = proofRegion(&proof.*, region)
  if known != usize.MAX { return known }
  let index = List<Shared<Lifetime>>.length(&proof.regions)
  run List<Shared<Lifetime>>.append(&mut proof.regions, Shared<Lifetime>.clone(region))
  run InternIndex.record(&mut proof.lookup, Lifetime.hash(region))
  run List<bool>.append(&mut proof.reached, false)
  let count = Lifetime.atomCount(region)
  if count > usize.ONE {
    run List<usize>.append(&mut proof.missing, count)
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(region, at)
      let member = run internProofRegion(&mut proof.*, &atom)
      run List<usize>.append(&mut proof.meetMember, member)
      run List<usize>.append(&mut proof.meetOf, index)
      run InternIndex.record(&mut proof.meets, usize.toU64(member))
      at = at + usize.ONE
    }
  } else {
    run List<usize>.append(&mut proof.missing, usize.ZERO)
    if Shared<Lifetime>.with<bool>(region, enclosingKind) { run List<usize>.append(&mut proof.enclosers, index) }
  }
  return index
}

fn enclosingKind(region: &Lifetime) -> bool {
  return match &region.* { Lifetime.Parameter {..} => true Lifetime.Supplied {..} => true _ => false }
}

fn localKind(region: &Lifetime) -> bool {
  return match &region.* { Lifetime.Local {..} => true _ => false }
}

effect fn recordProofEdge(proof: &mut OutlivesProof, longer: usize, shorter: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<usize>.append(&mut proof.edgeShorter, shorter)
  run List<usize>.append(&mut proof.edgeLonger, longer)
  return run InternIndex.record(&mut proof.edges, usize.toU64(shorter))
}

effect fn reachProof(proof: &mut OutlivesProof, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let reached = List<bool>.asMutSlice(&mut proof.reached)
  if reached[index] { return () }
  reached[index] = true
  return run List<usize>.append(&mut proof.queue, index)
}

// Everything a reached region implies: the longer side of each edge it is the shorter side of,
// the members of a reached meet, a meet whose members are all reached, and a Parameter or
// Supplied region that encloses a reached loan.
effect fn solveProof(proof: &mut OutlivesProof) -> () ! OutOfMemoryError ? &mut Allocator {
  while List<usize>.length(&proof.queue) > usize.ZERO {
    let last = List<usize>.length(&proof.queue) - usize.ONE
    let current = List<usize>.asSlice(&proof.queue)[last]
    List<usize>.truncate(&mut proof.queue, last)
    let mut edge = InternIndex.first(&proof.edges, usize.toU64(current))
    while edge != usize.MAX {
      if List<usize>.asSlice(&proof.edgeShorter)[edge] == current {
        let longer = List<usize>.asSlice(&proof.edgeLonger)[edge]
        run reachProof(&mut proof.*, longer)
      }
      edge = InternIndex.after(&proof.edges, edge)
    }
    let region = Shared<Lifetime>.clone(&List<Shared<Lifetime>>.asSlice(&proof.regions)[current])
    let count = Lifetime.atomCount(&region)
    if count > usize.ONE {
      let mut at = usize.ZERO
      while at < count {
        let atom = Lifetime.atomAt(&region, at)
        let member = proofRegion(&proof.*, &atom)
        run reachProof(&mut proof.*, member)
        at = at + usize.ONE
      }
    }
    let mut meet = InternIndex.first(&proof.meets, usize.toU64(current))
    while meet != usize.MAX {
      if List<usize>.asSlice(&proof.meetMember)[meet] == current {
        let whole = List<usize>.asSlice(&proof.meetOf)[meet]
        let missing = List<usize>.asMutSlice(&mut proof.missing)
        missing[whole] = missing[whole] - usize.ONE
        if missing[whole] == usize.ZERO { run reachProof(&mut proof.*, whole) }
      }
      meet = InternIndex.after(&proof.meets, meet)
    }
    if Shared<Lifetime>.with<bool>(&region, localKind) {
      let mut at = usize.ZERO
      while at < List<usize>.length(&proof.enclosers) {
        let candidate = List<usize>.asSlice(&proof.enclosers)[at]
        let owner = Shared<Lifetime>.clone(&List<Shared<Lifetime>>.asSlice(&proof.regions)[candidate])
        if enclosingLifetimeOutlivesLoan(&owner, &region) { run reachProof(&mut proof.*, candidate) }
        at = at + usize.ONE
      }
    }
  }
  return ()
}

// The regions `constraints` prove outlive `shorter`, with each of `queries` interned so a later
// [`provenOutlives`] can ask about it.
effect fn outlivesProof(constraints: &[Constraint], shorter: &Shared<Lifetime>, queries: &[Shared<Lifetime>]) -> OutlivesProof
! OutOfMemoryError ? &mut Allocator {
  let mut proof = OutlivesProof {
    regions: List<Shared<Lifetime>>.make(), lookup: InternIndex.make(), reached: List<bool>.make(), queue: List<usize>.make(),
    missing: List<usize>.make(), edgeShorter: List<usize>.make(), edgeLonger: List<usize>.make(), edges: InternIndex.make(),
    meetMember: List<usize>.make(), meetOf: List<usize>.make(), meets: InternIndex.make(), enclosers: List<usize>.make(),
  }
  let mut at = usize.ZERO
  while at < queries.length {
    drop run internProofRegion(&mut proof, &queries[at])
    at = at + usize.ONE
  }
  let seed = run internProofRegion(&mut proof, shorter)
  let lasting = run Shared<Lifetime>.make(Lifetime.Static)
  let always = run internProofRegion(&mut proof, &lasting)
  at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Outlives {longer: source, shorter: target} = &constraints[at] {
      let longerAt = run internProofRegion(&mut proof, &source)
      let shorterAt = run internProofRegion(&mut proof, &target)
      run recordProofEdge(&mut proof, longerAt, shorterAt)
    }
    at = at + usize.ONE
  }
  run reachProof(&mut proof, seed)
  run reachProof(&mut proof, always)
  run solveProof(&mut proof)
  return move proof
}

// Whether `proof` shows `longer` outlives its shorter region. `longer` must be one of its queries.
fn provenOutlives(proof: &OutlivesProof, longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>) -> bool {
  if Lifetime.equalsShared(longer, shorter) || Shared<Lifetime>.with<bool>(longer, staticLifetime) { return true }
  let index = proofRegion(proof, longer)
  return index != usize.MAX && List<bool>.asSlice(&proof.reached)[index]
}

// Records the premise `longer: shorter` and extends the proof with what it implies. Both regions
// must already be in the proof, as a query and its shorter region are, so no rule misses a region
// interned after solving began.
effect fn assumeOutlives(proof: &mut OutlivesProof, longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let longerAt = proofRegion(&proof.*, longer)
  let shorterAt = proofRegion(&proof.*, shorter)
  run recordProofEdge(&mut proof.*, longerAt, shorterAt)
  if List<bool>.asSlice(&proof.reached)[shorterAt] { run reachProof(&mut proof.*, longerAt) }
  return run solveProof(&mut proof.*)
}

effect fn knownOutlives(constraints: &[Constraint], longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  // An identical region, `'static`, or a written edge is decided before building the proof.
  if Lifetime.equalsShared(longer, shorter) || Shared<Lifetime>.with<bool>(longer, staticLifetime) { return true }
  let mut direct = usize.ZERO
  while direct < constraints.length {
    if let Constraint.Outlives {longer: source, shorter: target} = &constraints[direct] {
      if Lifetime.equalsShared(&source, longer) && Lifetime.equalsShared(&target, shorter) { return true }
    }
    direct = direct + usize.ONE
  }
  let queries: [Shared<Lifetime>; 1] = [Shared<Lifetime>.clone(longer)]
  let proof = run outlivesProof(constraints, shorter, &queries)
  return provenOutlives(&proof, longer, shorter)
}

// A lifetime parameter of the declaration that roots a loan's body, or of one enclosing it such as
// its implementation, is valid for that whole body, so it outlives every loan rooted there.
fn enclosingLifetimeOutlivesLoan(longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>) -> bool {
  // This rule relates a Parameter, or an application's Supplied region, to a Local. An identical
  // allocation cannot satisfy it;
  // reject before nesting Shared.with on the same exclusive runtime borrow.
  if sameAllocation<Lifetime>(longer, shorter) { return false }
  return Shared<Lifetime>.with<bool>(longer, fn(owner: &Lifetime) -> bool { return parameterEnclosesLoan(owner, shorter) })
}

fn parameterEnclosesLoan(owner: &Lifetime, loan: &Shared<Lifetime>) -> bool {
  // A Supplied region numbers one the application's caller lent: it is valid for the whole call,
  // so it encloses every loan of the applied body, as the parameter it binds does.
  if let Lifetime.Supplied {..} = &owner.* {
    return Shared<Lifetime>.with<bool>(loan, fn(region: &Lifetime) -> bool {
      return match &region.* { Lifetime.Local {..} => true _ => false }
    })
  }
  if let Lifetime.Parameter {declaration, ..} = &owner.* {
    return Shared<Lifetime>.with<bool>(loan, fn(region: &Lifetime) -> bool {
      if let Lifetime.Local {declaration: body, ..} = &region.* { return DeclarationId.isPrefixOf(&declaration, &body) }
      return false
    })
  }
  return false
}

// Head and substituted operation bounds are premises; witness results never justify themselves.
effect fn assumedOutlives(
  head: &Shared<ImplementationHead>, operation: &Shared<Result<Answer, NoRejection>>,
  operationCount: usize, longer: &Shared<Lifetime>, shorter: &Shared<Lifetime>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut declared = List<Constraint>.make()
  let headCount = Shared<ImplementationHead>.with<usize>(head, headConstraintCount)
  let mut at = usize.ZERO
  while at < headCount + operationCount {
    let next = outlivesAssumptionAt(head, operation, headCount, at)
    if let Option<Constraint>.Some {value} = move next { run List<Constraint>.append(&mut declared, move value) }
    at = at + usize.ONE
  }
  return run knownOutlives(List<Constraint>.asSlice(&declared), longer, shorter)
}

// An `effect fn` implementation's Effect must stay valid for the promised environment. A region
// covers it when it is a promised region, is retained by the operation's inputs (which LIFE-004
// obliges every caller to keep alive for the promised environment), or has a written bound to a
// promised region through the transitive head and operation bounds. A written implementation
// environment is also an obligation on its stored inputs, which must follow from those facts.
effect fn environmentVerdict(
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  operationOwner: &DeclarationId,
  promisedFacts: &SignatureFacts,
  witness: &Shared<Result<Answer, NoRejection>>,
  witnessOwner: &DeclarationId,
  witnessFacts: &SignatureFacts,
  witnessWritten: bool,
  lent: &[Shared<Lifetime>],
) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  let promised = run environmentRegions(operation, promisedFacts.environment)
  let provided = run environmentRegions(witness, witnessFacts.environment)
  let captured = run retainedByParameters(operation, promisedFacts.parameters, operationOwner)
  let promisedRegions = List<Shared<Lifetime>>.asSlice(&promised)
  let providedRegions = List<Shared<Lifetime>>.asSlice(&provided)
  let capturedRegions = List<Shared<Lifetime>>.asSlice(&captured.regions)
  let mut undecided = false
  let mut at = usize.ZERO
  while at < providedRegions.length {
    let region = &providedRegions[at]
    if containsRegion(lent, region) {
      at = at + usize.ONE
      continue
    }
    let mut covered = containsRegion(promisedRegions, region) || containsRegion(
      capturedRegions,
      region,
    )
    let mut other = usize.ZERO
    while !covered && other < promisedRegions.length {
      covered = run assumedOutlives(
        head,
        operation,
        promisedFacts.constraints,
        region,
        &promisedRegions[other],
      )
      other = other + usize.ONE
    }
    if !covered {
      if captured.known {
        return Verdict.Incompatible {problem: WitnessProblem.Environment}
      }
      undecided = true
    }
    at = at + usize.ONE
  }
  if witnessWritten {
    // Every promised region is also written, so the promised environment covers the written one.
    let mut within = true
    at = usize.ZERO
    while within && at < promisedRegions.length {
      within = containsRegion(providedRegions, &promisedRegions[at])
      at = at + usize.ONE
    }
    let stored = run retainedByParameters(witness, witnessFacts.parameters, witnessOwner)
    if !stored.known && !within {
      undecided = true
    }
    let storedRegions = List<Shared<Lifetime>>.asSlice(&stored.regions)
    at = usize.ZERO
    while at < storedRegions.length {
      let region = &storedRegions[at]
      // A region lent to the witness, such as its receiver loan of the environment provider, is
      // covered by the dispatching loan, as in the provided-region check above.
      let kept = containsRegion(lent, region) || containsRegion(providedRegions, region) || within && (containsRegion(
        promisedRegions,
        region,
      ) || containsRegion(capturedRegions, region))
      if !kept {
        undecided = true
      }
      at = at + usize.ONE
    }
  }
  if undecided {
    return Verdict.Unsupported
  }
  return Verdict.Compatible
}

// Original slots, sorted by complete declaration ordinal across all binder kinds.
fn ownedSlot(types: &[Shared<Type>], lifetimes: &[Shared<Lifetime>], rows: &[RowParameter],
  owner: &DeclarationId, at: usize) -> Option<ApplicationSlot> {
  if at < types.length {
    let ordinal = Shared<Type>.with<usize>(&types[at], fn(value: &Type) -> usize {
      return Type.parameterOrdinalOf(value, owner)
    })
    if ordinal != usize.MAX { return Option<ApplicationSlot>.some(ApplicationSlot {ordinal: ordinal, kind: GenericKind.Type}) }
    return Option<ApplicationSlot>.none()
  }
  let regionAt = at - types.length
  if regionAt < lifetimes.length {
    let ordinal = ownedLifetimeOrdinal(&lifetimes[regionAt], owner)
    if ordinal != usize.MAX { return Option<ApplicationSlot>.some(ApplicationSlot {ordinal: ordinal, kind: GenericKind.Lifetime}) }
    return Option<ApplicationSlot>.none()
  }
  let rowAt = regionAt - lifetimes.length
  if rowAt < rows.length && Shared<DeclarationId>.with<bool>(&rows[rowAt].declaration,
    fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, owner) }) {
    return Option<ApplicationSlot>.some(ApplicationSlot {ordinal: rows[rowAt].ordinal, kind: GenericKind.Requirement})
  }
  return Option<ApplicationSlot>.none()
}

fn signatureOwnedSlot(answer: &Result<Answer, NoRejection>, identity: &DeclarationId, at: usize) -> Option<ApplicationSlot> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      return ownedSlot(List<Shared<Type>>.asSlice(&signature.typeParameters),
        List<Shared<Lifetime>>.asSlice(&signature.lifetimeParameters),
        List<RowParameter>.asSlice(&signature.rowParameters), identity, at)
    }
  }
  return Option<ApplicationSlot>.none()
}

// A signature's retained original identities, rather than every enclosing head parameter, are
// the source-call inference and explicit-prefix authority.
// Whether a signature lists any binder that `identity`, its enclosing impl, declares.
fn signatureNamesEnclosing(answer: &Result<Answer, NoRejection>, identity: &DeclarationId) -> bool {
  let count = signatureBinderCount(answer)
  let mut at = usize.ZERO
  while at < count {
    if let Option<ApplicationSlot>.Some {..} = move signatureOwnedSlot(answer, identity, at) { return true }
    at = at + usize.ONE
  }
  return false
}

fn signatureListsSlot(answer: &Result<Answer, NoRejection>, identity: &DeclarationId, slot: ApplicationSlot) -> bool {
  let count = signatureBinderCount(answer)
  let mut at = usize.ZERO
  while at < count {
    if let Option<ApplicationSlot>.Some {value} = move signatureOwnedSlot(answer, identity, at) {
      if value.ordinal == slot.ordinal && value.kind == slot.kind { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn headOwnedSlot(head: &ImplementationHead, identity: &DeclarationId, at: usize) -> Option<ApplicationSlot> {
  return ownedSlot(List<Shared<Type>>.asSlice(&head.binders.typeParameters),
    List<Shared<Lifetime>>.asSlice(&head.binders.lifetimeParameters),
    List<RowParameter>.asSlice(&head.binders.rowParameters), identity, at)
}

effect fn insertApplicationSlot(slots: &mut List<ApplicationSlot>, slot: ApplicationSlot) -> ()
! OutOfMemoryError ? &mut Allocator {
  let values = List<ApplicationSlot>.asSlice(&slots.*)
  let mut at = usize.ZERO
  while at < values.length && values[at].ordinal < slot.ordinal { at = at + usize.ONE }
  if at < values.length && values[at].ordinal == slot.ordinal { return () }
  run List<ApplicationSlot>.insert(&mut slots.*, at, move slot)
  return ()
}

effect fn applicationOrdinals(slots: &[ApplicationSlot]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<usize>.make()
  let mut at = usize.ZERO
  while at < slots.length {
    run List<usize>.append(&mut values, slots[at].ordinal)
    at = at + usize.ONE
  }
  return move values
}

// Header dependencies follow the same proofDemand path for roots and running nested queries.
effect fn resolveTargetSchema(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>,
  request: &mut Request, dependencies: &mut List<Dependency>, nested: bool,
  identity: &DeclarationId, span: Span) -> Option<TargetSchema>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(identity))
  if moduleOrdinal == usize.MAX { return Option<TargetSchema>.none() }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let shared = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
  let found = run ordinalOfIdentity(&mut resolver.*, &module, &shared)
  let ordinal = match move found { Option<usize>.Some {value} => value _ => { return Option<TargetSchema>.none() } }
  let mut own = List<ApplicationSlot>.make()
  let mut at = usize.ZERO
  // An `effect {}` block has no binders. Its signature is derived from its checked body, so
  // demanding it while the enclosing body is being checked would be a cycle.
  let mut demanded = Option<Shared<Result<Answer, NoRejection>>>.none()
  if !run effectBlockHeader(&mut resolver.*, &module, ordinal) {
    let declarationAccess83Request = Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
    let declarationAccess83 = run internDeclaration(&mut resolver.*, declarationAccess83Request)
    let signature = run proofDemand(&mut resolver.*, &mut query.*, &mut request.*, &mut dependencies.*,
      declarationAccess83, span, nested)
    let facts = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts)
    let count = match move facts { Option<SignatureFacts>.Some {value} => value.binders _ => { return Option<TargetSchema>.none() } }
    while at < count {
      let slot = Shared<Result<Answer, NoRejection>>.with<Option<ApplicationSlot>>(&signature,
        fn(value: &Result<Answer, NoRejection>) -> Option<ApplicationSlot> { return signatureOwnedSlot(value, identity, at) })
      if let Option<ApplicationSlot>.Some {value} = move slot { run insertApplicationSlot(&mut own, value) }
      at = at + usize.ONE
    }
    demanded = Option<Shared<Result<Answer, NoRejection>>>.some(move signature)
  }
  let mut scopes = List<ApplicationScope>.make()
  let parent = run enclosingIdentity(&mut resolver.*, &module, ordinal)
  if let Option<DeclarationId>.Some {value: enclosing} = move parent {
    if DeclarationId.kind(identity) == OwnerKind.Anonymous || DeclarationId.kind(identity) == OwnerKind.EffectBlock {
      let parentSchema = run resolveTargetSchema(&mut resolver.*, &mut query.*, &mut request.*, &mut dependencies.*, nested, &enclosing, span)
      let inheritedSchema = match move parentSchema {
        Option<TargetSchema>.Some {value} => move value
        _ => { return Option<TargetSchema>.none() }
      }
      let TargetSchema {own: parentSlots, scopes: parentScopes, ..} = move inheritedSchema
      scopes = move parentScopes
      if List<ApplicationSlot>.length(&parentSlots) > usize.ZERO {
        run List<ApplicationScope>.append(&mut scopes, ApplicationScope {
          owner: run Shared<DeclarationId>.make(move enclosing),
          requiredOrdinals: run applicationOrdinals(List<ApplicationSlot>.asSlice(&parentSlots)),
          slots: move parentSlots,
        })
      }
      return Option<TargetSchema>.some(TargetSchema {declaration: move shared, own: move own, scopes: move scopes})
    }
    // A service operation is applied under its service's written binders, which select the
    // provider's service-role key; its provider is not a binder. Every slot is required.
    if DeclarationId.kind(&enclosing) == OwnerKind.Service {
      let serviceShared = run Shared<DeclarationId>.make(DeclarationId.copy(&enclosing))
      let serviceFound = run ordinalOfIdentity(&mut resolver.*, &module, &serviceShared)
      let serviceOrdinal = match move serviceFound { Option<usize>.Some {value} => value _ => { return Option<TargetSchema>.none() } }
      let written = match move run templateBinders(&mut resolver.*, &module, serviceOrdinal) {
        Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
        Result<List<Binder>, Shared<Rejection>>.Failure {..} => { return Option<TargetSchema>.none() }
      }
      let binders = List<Binder>.asSlice(&written)
      if binders.length > usize.ZERO {
        let mut slots = List<ApplicationSlot>.make()
        let mut required = List<usize>.make()
        at = usize.ZERO
        while at < binders.length {
          run List<ApplicationSlot>.append(&mut slots, ApplicationSlot {ordinal: at, kind: binderKind(&binders[at])})
          run List<usize>.append(&mut required, at)
          at = at + usize.ONE
        }
        run List<ApplicationScope>.append(&mut scopes, ApplicationScope {
          owner: move serviceShared, slots: move slots, requiredOrdinals: move required,
        })
      }
      return Option<TargetSchema>.some(TargetSchema {declaration: move shared, own: move own, scopes: move scopes})
    }
    // An interface operation's default body is applied under the interface's written binders and
    // the provider as `Self`, bound after them. Every slot is required.
    if DeclarationId.kind(&enclosing) == OwnerKind.Interface {
      let interfaceShared = run Shared<DeclarationId>.make(DeclarationId.copy(&enclosing))
      let interfaceOrdinal = match move run ordinalOfIdentity(&mut resolver.*, &module, &interfaceShared) {
        Option<usize>.Some {value} => value
        _ => { return Option<TargetSchema>.none() }
      }
      let operationsRequest = Key {family: Family.Operations, module: moduleOrdinal, name: usize.ZERO,
        declaration: interfaceOrdinal, member: usize.ZERO, external: false}
      let operationsKey = run internDeclaration(&mut resolver.*, operationsRequest)
      let listed = run proofDemand(&mut resolver.*, &mut query.*, &mut request.*, &mut dependencies.*, operationsKey, span, nested)
      if !Shared<Result<Answer, NoRejection>>.with<bool>(&listed,
        fn(value: &Result<Answer, NoRejection>) -> bool { return defaultedOperation(value, identity) }) {
        return Option<TargetSchema>.none()
      }
      let written = match move run templateBinders(&mut resolver.*, &module, interfaceOrdinal) {
        Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
        Result<List<Binder>, Shared<Rejection>>.Failure {..} => { return Option<TargetSchema>.none() }
      }
      let binders = List<Binder>.asSlice(&written)
      let mut slots = List<ApplicationSlot>.make()
      let mut required = List<usize>.make()
      at = usize.ZERO
      while at <= binders.length {
        let mut kind = GenericKind.Type
        if at < binders.length { kind = binderKind(&binders[at]) }
        run List<ApplicationSlot>.append(&mut slots, ApplicationSlot {ordinal: at, kind: kind})
        run List<usize>.append(&mut required, at)
        at = at + usize.ONE
      }
      run List<ApplicationScope>.append(&mut scopes, ApplicationScope {
        owner: move interfaceShared, slots: move slots, requiredOrdinals: move required,
      })
      return Option<TargetSchema>.some(TargetSchema {declaration: move shared, own: move own, scopes: move scopes})
    }
    if DeclarationId.kind(&enclosing) != OwnerKind.Implementation { return Option<TargetSchema>.none() }
    let signature = match move demanded {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value} => move value
      Option<Shared<Result<Answer, NoRejection>>>.None => { return Option<TargetSchema>.none() }
    }
    let enclosingShared = run Shared<DeclarationId>.make(DeclarationId.copy(&enclosing))
    let parentFound = run ordinalOfIdentity(&mut resolver.*, &module, &enclosingShared)
    let parentOrdinal = match move parentFound { Option<usize>.Some {value} => value _ => { return Option<TargetSchema>.none() } }
    let declarationAccess84Request = Key {family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO, declaration: parentOrdinal, member: usize.ZERO, external: false}
    let declarationAccess84 = run internDeclaration(&mut resolver.*, declarationAccess84Request)
    let answer = run proofDemand(&mut resolver.*, &mut query.*, &mut request.*, &mut dependencies.*,
      declarationAccess84, span, nested)
    let foundHead = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer, headOf)
    let head = match move foundHead { Option<Shared<ImplementationHead>>.Some {value} => move value _ => { return Option<TargetSchema>.none() } }
    let scopeCount = Shared<ImplementationHead>.with<usize>(&head, headBinderCount)
    let mut slots = List<ApplicationSlot>.make()
    at = usize.ZERO
    while at < scopeCount {
      let slot = Shared<ImplementationHead>.with<Option<ApplicationSlot>>(&head,
        fn(value: &ImplementationHead) -> Option<ApplicationSlot> { return headOwnedSlot(value, &enclosing, at) })
      if let Option<ApplicationSlot>.Some {value} = move slot { run insertApplicationSlot(&mut slots, value) }
      at = at + usize.ONE
    }
    if List<ApplicationSlot>.length(&slots) != scopeCount { return Option<TargetSchema>.none() }
    if scopeCount > usize.ZERO {
      let inherent = Shared<ImplementationHead>.with<bool>(&head, fn(value: &ImplementationHead) -> bool {
        return match &value.kind { ImplementationKind.Inherent => true _ => false }
      })
      let mut required = List<usize>.make()
      let listed = List<ApplicationSlot>.asSlice(&slots)
      at = usize.ZERO
      while at < listed.length {
        if !inherent || Shared<Result<Answer, NoRejection>>.with<bool>(&signature,
          fn(value: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(value, &enclosing, listed[at]) }) {
          run List<usize>.append(&mut required, listed[at].ordinal)
        }
        at = at + usize.ONE
      }
      run List<ApplicationScope>.append(&mut scopes, ApplicationScope {
        owner: move enclosingShared, slots: move slots, requiredOrdinals: move required,
      })
    }
  }
  return Option<TargetSchema>.some(TargetSchema {declaration: move shared, own: move own, scopes: move scopes})
}

effect fn scopeArgument(owner: &DeclarationId, ordinal: usize, kind: GenericKind) -> Argument
! OutOfMemoryError ? &mut Allocator | &mut Types {
  match kind {
    GenericKind.Type => { return Argument.Type {value: run Types.intern(Type.Parameter {declaration: DeclarationId.copy(owner), ordinal: ordinal})} }
    GenericKind.Lifetime => { return Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(owner), ordinal: ordinal})} }
    GenericKind.Requirement => {
      let mut row = Row.empty()
      run Row.include(&mut row, RowParameter {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(owner)), ordinal: ordinal})
      return Argument.Row {value: run Shared<Row>.make(move row)}
    }
    _ => { return absurd<Argument>() }
  }
}

// A callable body's application remains abstract until the enclosing declaration is realized.
// Unlike a direct call, its lexical scopes therefore retain their authored parameters.
effect fn formalCallableScopes(schema: &TargetSchema) -> List<ScopeBinding>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let scopes = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut output = List<ScopeBinding>.make()
  let mut at = usize.ZERO
  while at < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[at].owner)
    let slots = List<ApplicationSlot>.asSlice(&scopes[at].slots)
    let mut values = List<Argument>.make()
    let mut index = usize.ZERO
    while index < slots.length {
      run List<Argument>.append(
        &mut values,
        run scopeArgument(&owner, slots[index].ordinal, slots[index].kind),
      )
      index = index + usize.ONE
    }
    run List<ScopeBinding>.append(
      &mut output,
      ScopeBinding {
        owner: Shared<DeclarationId>.clone(&scopes[at].owner),
        arguments: move values,
        argumentOrdinals: run applicationOrdinals(slots),
      },
    )
    at = at + usize.ONE
  }
  return move output
}

effect fn typeApplicationArguments(provider: &Shared<Type>) -> List<Argument>
! OutOfMemoryError
? &mut Allocator {
  let mut output = List<Argument>.make()
  let mut count = Shared<Type>.with<usize>(provider, applicationLength)
  if count == usize.MAX {
    count = usize.ZERO
  }
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared<Type>.with<Option<Argument>>(
      provider,
      fn(value: &Type) -> Option<Argument> {
        return applicationArgument(value, at)
      },
    )
    if let Option<Argument>.Some {value} = move argument {
      run List<Argument>.append(&mut output, move value)
    }
    at = at + usize.ONE
  }
  return move output
}

effect fn checkedDirectApplication(
  resolver: &mut Resolver,
  query: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  declaration: &DeclarationId,
  signature: &Shared<Result<Answer, NoRejection>>,
  arguments: List<Argument>,
  scopeArguments: &List<Argument>,
  module: &ModuleId,
  span: Span,
) -> Result<Application, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let found = run resolveTargetSchema(
    &mut resolver.*,
    &mut query.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    declaration,
    span,
  )
  if let Option<TargetSchema>.Some {value: schema} = move found {
    let ownSlots = List<ApplicationSlot>.asSlice(&schema.own)
    let expectedScopes = List<ApplicationScope>.asSlice(&schema.scopes)
    let supplied = List<Argument>.asSlice(&arguments)
    let suppliedScopes = List<Argument>.asSlice(scopeArguments)
    let mut scopeCount = usize.ZERO
    let mut inferredScopes = usize.ZERO
    let mut at = usize.ZERO
    while at < expectedScopes.length {
      scopeCount = scopeCount + List<ApplicationSlot>.length(&expectedScopes[at].slots)
      let scopeOwner = DeclarationId.copyShared(&expectedScopes[at].owner)
      let slots = List<ApplicationSlot>.asSlice(&expectedScopes[at].slots)
      let mut slotAt = usize.ZERO
      while slotAt < slots.length {
        if Shared<Result<Answer, NoRejection>>.with<bool>(signature,
          fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(answer, &scopeOwner, slots[slotAt]) }) {
          inferredScopes = inferredScopes + usize.ONE
        }
        slotAt = slotAt + usize.ONE
      }
      at = at + usize.ONE
    }
    let preApplied = suppliedScopes.length > usize.ZERO
    let mut expectedArguments = ownSlots.length
    if !preApplied {
      expectedArguments = expectedArguments + inferredScopes
    }
    if supplied.length != expectedArguments || (preApplied && suppliedScopes.length != scopeCount) {
      return Result<Application, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    let mut scopes = List<ScopeBinding>.make()
    let mut scopeAt = usize.ZERO
    let mut argumentAt = usize.ZERO
    at = usize.ZERO
    while at < expectedScopes.length {
      let scopeSlots = List<ApplicationSlot>.asSlice(&expectedScopes[at].slots)
      let mut values = List<Argument>.make()
      let mut ordinals = List<usize>.make()
      let scopeOwner = DeclarationId.copyShared(&expectedScopes[at].owner)
      let mut index = usize.ZERO
      while index < scopeSlots.length {
        if preApplied {
          run List<Argument>.append(&mut values, copyArgument(&suppliedScopes[scopeAt]))
          run List<usize>.append(&mut ordinals, scopeSlots[index].ordinal)
        } else if Shared<Result<Answer, NoRejection>>.with<bool>(signature,
          fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(answer, &scopeOwner, scopeSlots[index]) }) {
          run List<Argument>.append(&mut values, copyArgument(&supplied[argumentAt]))
          run List<usize>.append(&mut ordinals, scopeSlots[index].ordinal)
          argumentAt = argumentAt + usize.ONE
        }
        scopeAt = scopeAt + usize.ONE
        index = index + usize.ONE
      }
      if List<Argument>.length(&values) > usize.ZERO {
        run List<ScopeBinding>.append(
          &mut scopes,
          ScopeBinding {
            owner: Shared<DeclarationId>.clone(&expectedScopes[at].owner),
            arguments: move values,
            argumentOrdinals: move ordinals,
          },
        )
      }
      at = at + usize.ONE
    }
    let mut ownArguments = List<Argument>.make()
    at = usize.ZERO
    while at < ownSlots.length {
      let position = argumentAt + at
      run List<Argument>.append(&mut ownArguments, copyArgument(&supplied[position]))
      at = at + usize.ONE
    }
    let application = Application {
      target: SpecializationTarget.Named {declaration: DeclarationId.copy(declaration)},
      argumentOrdinals: run applicationOrdinals(List<ApplicationSlot>.asSlice(&schema.own)),
      arguments: move ownArguments,
      scopes: move scopes,
      statics: List<StaticSlot>.make(),
    }
    if run TargetSchema.accepts(&schema, &application) {
      return Result<Application, Shared<Rejection>>.succeed(move application)
    }
  }
  return Result<Application, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// Whether a witness's own lifetime appears in its constraints only as the loan region of a
// provides premise. That premise holds whatever the region, so any argument, here 'static, serves.
effect fn providesOnlyLifetime(witness: &Shared<Result<Answer, NoRejection>>, owner: &DeclarationId, ordinal: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(witness, signatureConstraintCount)
  let mut found = false
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(witness,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Provides {provider, ..}} = move bound {
      let loan = run Type.copy(&provider)
      if let Type.Reference {referent, lifetime, ..} = move loan {
        if ownedLifetimeOrdinal(&lifetime, owner) == ordinal && !run usesOwnedLifetime(&referent, owner, ordinal) { found = true }
      }
    }
    at = at + usize.ONE
  }
  return found
}

// Witness scope recipes are actual lexical bindings. Only the selected head's own scope can be
// supplied structurally; another mapped target's scope requires existing exact binding evidence.
effect fn witnessScopeRecipes(schema: &TargetSchema, head: &Shared<ImplementationHead>, bindings: &[Binding]) -> Option<List<ScopeBinding>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let headIdentity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> { return Shared<DeclarationId>.clone(&value.declaration) })
  let headOwner = DeclarationId.copyShared(&headIdentity)
  let expected = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut scopes = List<ScopeBinding>.make()
  let mut at = usize.ZERO
  while at < expected.length {
    let owner = DeclarationId.copyShared(&expected[at].owner)
    let slots = List<ApplicationSlot>.asSlice(&expected[at].slots)
    let mut values = List<Argument>.make()
    let mut ordinals = List<usize>.make()
    let mut index = usize.ZERO
    while index < slots.length {
      let ordinal = slots[index].ordinal
      let found = bindingArgument(bindings, &owner, ordinal)
      if let Option<Argument>.Some {value} = move found {
        run List<Argument>.append(&mut values, move value)
        run List<usize>.append(&mut ordinals, ordinal)
      } else if DeclarationId.equals(&owner, &headOwner) {
        run List<Argument>.append(&mut values, run scopeArgument(&owner, ordinal, slots[index].kind))
        run List<usize>.append(&mut ordinals, ordinal)
      } else if containsOrdinal(&expected[at].requiredOrdinals, ordinal) {
        return Option<List<ScopeBinding>>.none()
      }
      // An inherent owner binder the mapped member never mentions stays unapplied, as at a direct
      // call: no operand determines it and the member's contract does not depend on it.
      index = index + usize.ONE
    }
    if List<Argument>.length(&values) > usize.ZERO {
      run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: Shared<DeclarationId>.clone(&expected[at].owner),
        arguments: move values, argumentOrdinals: move ordinals})
    }
    at = at + usize.ONE
  }
  return Option<List<ScopeBinding>>.some(move scopes)
}

// Compares one implementation's header with its operation's header under the conformance head.
// The witness owns its function and mapped lexical variables; the operation's parameters remain rigid.
fn implementedContract(value: &ImplementationHead) -> Option<Shared<Type>> {
  return match &value.contract {
    Option<Shared<Type>>.Some {value: applied} => Option<Shared<Type>>.some(Shared<Type>.clone(&applied))
    Option<Shared<Type>>.None => Option<Shared<Type>>.none()
  }
}

// The access of an implemented service's own entry in an operation's row, whatever its role.
effect fn ambientReceiver(head: &Shared<ImplementationHead>, requirements: &Shared<Row>) -> Option<Access>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let contract = match move Shared<ImplementationHead>.with<Option<Shared<Type>>>(head, implementedContract) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<Access>.none() }
  }
  if Shared<Type>.with<OwnerKind>(&contract, nominalKind) != OwnerKind.Service { return Option<Access>.none() }
  let entries = run Row.entryList(requirements)
  let listed = List<Requirement>.asSlice(&entries)
  let mut found = Option<Access>.none()
  let mut at = usize.ZERO
  while at < listed.length {
    if run Type.equalsShared(&listed[at].capability, &contract) {
      // Two roles of the operation's own service leave no single receiver; dispatch refuses it too.
      if let Option<Access>.Some {..} = &found { return Option<Access>.none() }
      found = Option<Access>.some(listed[at].access)
    }
    at = at + usize.ONE
  }
  return move found
}

// How many entries of an operation's row name the implemented service itself.
effect fn ownServiceEntries(head: &Shared<ImplementationHead>, requirements: &Shared<Row>) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let contract = match move Shared<ImplementationHead>.with<Option<Shared<Type>>>(head, implementedContract) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return usize.ZERO }
  }
  let entries = run Row.entryList(requirements)
  let listed = List<Requirement>.asSlice(&entries)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length {
    if run Type.equalsShared(&listed[at].capability, &contract) { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

effect fn witnessVerdict(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  operationOwner: &DeclarationId,
  witness: &Shared<Result<Answer, NoRejection>>,
  witnessOwner: &DeclarationId,
  witnessModule: &ModuleId,
  witnessOrdinal: usize,
  witnessKey: Key,
  arguments: &mut List<Argument>,
  argumentOrdinals: &mut List<usize>,
  scopes: &mut List<ScopeBinding>,
  operands: &mut List<OperandPass>,
) -> Verdict ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let promisedFound = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(
    operation,
    signatureFacts,
  )
  let providedFound = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(
    witness,
    signatureFacts,
  )
  let promised = match move promisedFound {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Verdict.Unsupported
    }
  }
  let provided = match move providedFound {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Verdict.Unsupported
    }
  }
  if promised.isEffect != provided.isEffect {
    return Verdict.Incompatible {problem: WitnessProblem.Kind}
  }
  // A witness runs in its operation's phase: a static operation has a static witness, and each
  // static parameter stays static.
  if promised.isStatic != provided.isStatic || promised.staticSlots != provided.staticSlots {
    return Verdict.Incompatible {problem: WitnessProblem.Phase}
  }
  if provided.isUnsafe && !promised.isUnsafe {
    return Verdict.Incompatible {problem: WitnessProblem.Safety}
  }
  // A service operation that requires its own service takes the provider from the Effect
  // environment; its witness receives that provider first (bootstrap `interfaceOperationContract`).
  if (run ownServiceEntries(head, &promised.requirements)) > usize.ONE { return Verdict.Unsupported }
  let receiver = run ambientReceiver(head, &promised.requirements)
  let mut offset = usize.ZERO
  if let Option<Access>.Some {..} = &receiver { offset = usize.ONE }
  if promised.parameters + offset != provided.parameters {
    return Verdict.Incompatible {problem: WitnessProblem.OperandCount}
  }
  let mut schemaRequest = Request.make()
  let foundSchema = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut schemaRequest, &mut dependencies.*, true,
    witnessOwner, Span.make(usize.ZERO, usize.ZERO))
  let schema = match move foundSchema { Option<TargetSchema>.Some {value} => move value _ => { return Verdict.Unsupported } }
  let ownSlots = List<ApplicationSlot>.asSlice(&schema.own)
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(
    &mut variables,
    run Shared<DeclarationId>.make(DeclarationId.copy(witnessOwner)),
  )
  // A mapped inherent member also owns lexical implementation binders. Infer those from the
  // promised operands before recording its scope recipe; the selected conformance head stays
  // rigid, since its parameters are the promise being checked.
  let selectedOwner = Shared<ImplementationHead>.with<Shared<DeclarationId>>(head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> { return Shared<DeclarationId>.clone(&value.declaration) })
  let lexical = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < lexical.length {
    let selected = Shared<DeclarationId>.with<bool>(&lexical[scopeAt].owner,
      fn(value: &DeclarationId) -> bool { return declarationEqualsShared(value, &selectedOwner) })
    if !selected { run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(&lexical[scopeAt].owner)) }
    scopeAt = scopeAt + usize.ONE
  }
  let bindable = List<Shared<DeclarationId>>.asSlice(&variables)
  let mut bindings = List<Binding>.make()
  let mut lent = List<Shared<Lifetime>>.make()
  if let Option<Access>.Some {value: access} = move receiver {
    // The provider value is lent to the witness's receiver borrow, at most at the required access.
    let providedReceiver = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(witness,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, usize.ZERO) })
    let right = match move providedReceiver { Option<Shared<Type>>.Some {value} => move value _ => { return Verdict.Unsupported } }
    if Shared<Type>.with<bool>(&right, operandExclusive) && access == Access.Shared {
      return Verdict.Incompatible {problem: WitnessProblem.OperandAccess {operand: usize.ZERO}}
    }
    let provider = Shared<ImplementationHead>.with<Shared<Type>>(head, fn(value: &ImplementationHead) -> Shared<Type> {
      return Shared<Type>.clone(&value.provider)
    })
    let verdict = run operandVerdict(&provider, &right, usize.ZERO, witnessOwner, bindable, &mut bindings, &mut lent)
    if !compatible(&verdict) { return move verdict }
    let region = Shared<Type>.with<Option<Shared<Lifetime>>>(&right, operandRegion)
    let lentRegion = match move region { Option<Shared<Lifetime>>.Some {value} => move value _ => { return Verdict.Unsupported } }
    let mut witnessAccess = Access.Shared
    if Shared<Type>.with<bool>(&right, operandExclusive) { witnessAccess = Access.Mutable }
    run List<OperandPass>.append(&mut operands.*, OperandPass.Borrow {access: witnessAccess,
      lifetimeOrdinal: ownedLifetimeOrdinal(&lentRegion, witnessOwner)})
  }
  let mut at = usize.ZERO
  while at < promised.parameters {
    let promisedOperand = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      operation,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let providedOperand = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      witness,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at + offset)
      },
    )
    if let Option<Shared<Type>>.Some {value: left} = move promisedOperand {
      if let Option<Shared<Type>>.Some {value: right} = move providedOperand {
        let verdict = run operandVerdict(
          &left,
          &right,
          at + offset,
          witnessOwner,
          bindable,
          &mut bindings,
          &mut lent,
        )
        if !compatible(&verdict) {
          return move verdict
        }
        let mut pass = OperandPass.Value
        if Shared<Type>.with<usize>(&left, operandShape) == usize.ZERO && Shared<Type>.with<usize>(&right, operandShape) == usize.ONE {
          let region = Shared<Type>.with<Option<Shared<Lifetime>>>(&right, operandRegion)
          if let Option<Shared<Lifetime>>.Some {value} = move region {
            let access = Shared<Type>.with<Access>(&right, fn(value: &Type) -> Access {
              if let Type.Reference {access, ..} = &value.* { return access }
              return absurd<Access>()
            })
            pass = OperandPass.Borrow {access: access, lifetimeOrdinal: ownedLifetimeOrdinal(&value, witnessOwner)}
          }
        }
        run List<OperandPass>.append(&mut operands.*, pass)
      }
    }
    at = at + usize.ONE
  }
  let lentRegions = List<Shared<Lifetime>>.asSlice(&lent)
  at = usize.ZERO
  while at < lentRegions.length {
    let ordinal = ownedLifetimeOrdinal(&lentRegions[at], witnessOwner)
    if run usesOwnedLifetime(&provided.result, witnessOwner, ordinal) {
      return Verdict.Incompatible {problem: WitnessProblem.ResultType}
    }
    at = at + usize.ONE
  }
  let result = run Type.unify(
    &promised.result,
    &provided.result,
    bindable,
    Comparison.Exact,
    &mut bindings,
  )
  match move result {
    Unification.Unified => {}
    Unification.Distinct => {
      return Verdict.Incompatible {problem: WitnessProblem.ResultType}
    }
    Unification.Undetermined {..} => {
      return Verdict.Unsupported
    }
  }
  at = usize.ZERO
  while at < lentRegions.length {
    if run usesOwnedLifetime(
      &provided.failure,
      witnessOwner,
      ownedLifetimeOrdinal(&lentRegions[at], witnessOwner),
    ) {
      return Verdict.Incompatible {problem: WitnessProblem.Failure}
    }
    at = at + usize.ONE
  }
  if unboundTypeIn(
    &provided.failure,
    witnessOwner,
    provided.binders,
    List<Binding>.asSlice(&bindings),
  ) {
    let failure = run Type.unify(
      &promised.failure,
      &provided.failure,
      bindable,
      Comparison.Exact,
      &mut bindings,
    )
    match move failure {
      Unification.Unified => {}
      Unification.Distinct => {
        return Verdict.Incompatible {problem: WitnessProblem.Failure}
      }
      Unification.Undetermined {..} => {
        return Verdict.Unsupported
      }
    }
  }
  if unboundRowIn(&provided.requirements, witnessOwner, List<Binding>.asSlice(&bindings)) {
    let promisedRow = run rowCarrier(&promised.requirements)
    let witnessRow = run rowCarrier(&provided.requirements)
    let row = run Type.bindWitnessResidual(&promisedRow, &witnessRow, bindable, &mut bindings)
    match move row {
      Unification.Unified => {}
      Unification.Distinct => {
        return Verdict.Incompatible {problem: WitnessProblem.Requirement}
      }
      Unification.Undetermined {..} => {
        return Verdict.Unsupported
      }
    }
  }
  if promised.isEffect {
    let environment = run bindEnvironmentArgument(
      operation,
      promised.environment,
      witness,
      provided.environment,
      witnessOwner,
      bindable,
      &mut bindings,
      lentRegions,
      &promised.result,
    )
    if !compatible(&environment) {
      return move environment
    }
  }
  let mut found = List<Argument>.make()
  let mut slotAt = usize.ZERO
  while slotAt < ownSlots.length {
    let mut value = bindingArgument(List<Binding>.asSlice(&bindings), witnessOwner, ownSlots[slotAt].ordinal)
    let absent = match &value { Option<Argument>.None => true _ => false }
    if absent { value = lentArgument(lentRegions, witnessOwner, ownSlots[slotAt].ordinal) }
    if let Option<Argument>.Some {value: supplied} = move value { run List<Argument>.append(&mut found, move supplied) }
    else if ownSlots[slotAt].kind == GenericKind.Lifetime && run providesOnlyLifetime(witness, witnessOwner, ownSlots[slotAt].ordinal) {
      run List<Argument>.append(&mut found, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
    }
    else { return Verdict.Unsupported }
    slotAt = slotAt + usize.ONE
  }
  let scopeRecipes = run witnessScopeRecipes(&schema, head, List<Binding>.asSlice(&bindings))
  let recordedScopes = match move scopeRecipes { Option<List<ScopeBinding>>.Some {value} => move value _ => { return Verdict.Unsupported } }
  argumentOrdinals.* = run applicationOrdinals(ownSlots)
  scopes.* = move recordedScopes
  let template = Option<Application>.some(Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(witnessOwner)},
    arguments: run copyArguments(List<Argument>.asSlice(&found)),
    argumentOrdinals: run applicationOrdinals(ownSlots),
    scopes: run copyScopeBindings(List<ScopeBinding>.asSlice(&scopes.*)), statics: List<StaticSlot>.make()})
  let mut providedBound = Shared<Result<Answer, NoRejection>>.clone(witness)
  if ownSlots.length > usize.ZERO || List<ApplicationScope>.length(&schema.scopes) > usize.ZERO {
    let mut rebound = run resolveSignatureUnder(
      &mut resolver.*,
      &mut owner.*,
      witnessKey,
      List<Dependency>.make(),
      Option<List<Argument>>.none(),
      Option<List<Argument>>.none(),
      &template,
    )
    while List<Dependency>.length(&rebound.dependencies) > usize.ZERO {
      run List<Dependency>.append(&mut dependencies.*, List<Dependency>.remove(&mut rebound.dependencies, usize.ZERO))
    }
    providedBound = run Shared<Result<Answer, NoRejection>>.make(
      Result<Answer, NoRejection>.succeed(move rebound),
    )
  }
  let facts = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(
    &providedBound,
    signatureFacts,
  )
  let bound = match move facts {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Verdict.Unsupported
    }
  }
  if !run witnessBoundsImplied(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    head,
    operation,
    &providedBound,
    bound.constraints,
    promised.constraints,
    witnessModule,
    Span.make(usize.ZERO, usize.ZERO),
  ) {
    return Verdict.Unsupported
  }
  if !run Type.coversFailure(&promised.failure, &bound.failure) {
    return Verdict.Incompatible {problem: WitnessProblem.Failure}
  }
  let rows = run Row.covers(&promised.requirements, &bound.requirements)
  let rowProblem = match rows {
    RowCoverage.Covered => Option<WitnessProblem>.none()
    RowCoverage.Entry => Option<WitnessProblem>.some(WitnessProblem.Requirement)
    RowCoverage.Access => Option<WitnessProblem>.some(WitnessProblem.RequirementAccess)
    RowCoverage.Parameter => Option<WitnessProblem>.some(WitnessProblem.RequirementParameter)
  }
  if let Option<WitnessProblem>.Some {value: problem} = move rowProblem {
    return Verdict.Incompatible {problem: problem}
  }
  if !promised.isEffect {
    run appendArguments(&mut arguments.*, List<Argument>.asSlice(&found))
    return Verdict.Compatible
  }
  let syntax = run signatureSyntax(&mut resolver.*, witnessModule, witnessOrdinal)
  let mut written = false
  if let Option<WrittenSignature>.Some {value: header} = move syntax {
    written = header.environment.present
  }
  let environment = run environmentVerdict(
    head,
    operation,
    operationOwner,
    &promised,
    &providedBound,
    witnessOwner,
    &bound,
    written,
    lentRegions,
  )
  if compatible(&environment) {
    run appendArguments(&mut arguments.*, List<Argument>.asSlice(&found))
  }
  return move environment
}

effect fn rejectWitness(
  module: &ModuleId,
  span: Span,
  problem: WitnessProblem,
  path: List<Shared<DeclarationId>>,
  detail: Bytes,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  // SEM0083 `{detail}` names the contract and the member; without a contract spelling the
  // message falls back to the code's meaning.
  let mut arguments = List<MessageArgument>.make()
  if Bytes.length(&detail) != usize.ZERO {
    run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
  }
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.IncompatibleWitness,
      module: ModuleId.copy(module),
      span: span,
      related: Option<RelatedSite>.none(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.some(problem),
      termination: TerminationStep.Peer,
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: List<Application>.make(),
      arguments: move arguments, owner: usize.MAX,
    },
  )
}

// The name of `identity`'s own owner step, as a written member or a contract operation spells it.
effect fn ownName(identity: &Shared<DeclarationId>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let value = DeclarationId.copyShared(identity)
  let count = DeclarationId.ownerCount(&value)
  if count == usize.ZERO { return Bytes.make() }
  return run DeclarationId.copyOwnerName(&value, count - usize.ONE)
}

// The written name of a nominal contract, without its module or arguments; empty for any other type.
effect fn contractName(contract: &Shared<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(contract)
  if let Type.Nominal {declaration, ..} = move copied {
    let count = DeclarationId.ownerCount(&declaration)
    if count != usize.ZERO { return run DeclarationId.copyOwnerName(&declaration, count - usize.ONE) }
  }
  return Bytes.make()
}

effect fn appendQuoted(text: &mut Bytes, name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut text.*, b"`")
  run Bytes.append(&mut text.*, name)
  return run Bytes.append(&mut text.*, b"`")
}

// The SEM0083 detail of a member of an implementation of `contract` (its spelling, empty when it
// has none) that fails `problem`: the member `name` names no operation, or does not match the
// operation of that name. A missing operation is named by `missingWitnessDetail`.
effect fn witnessDetail(problem: WitnessProblem, contract: &[u8], name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if contract.length == usize.ZERO || name.length == usize.ZERO { return move text }
  if let WitnessProblem.Unknown = problem {
    run appendQuoted(&mut text, name)
    run Bytes.append(&mut text, b" is not an operation of ")
    run appendQuoted(&mut text, contract)
    return move text
  }
  run appendWitnessLead(&mut text, contract, name)
  match problem {
    WitnessProblem.ScalarMapping => { run Bytes.append(&mut text, b"a scalar or `string` implementation defines it inline instead of naming a function") }
    WitnessProblem.Kind => { run Bytes.append(&mut text, b"one of them is an `effect fn` and the other is not") }
    WitnessProblem.Safety => { run Bytes.append(&mut text, b"it is `unsafe` but the operation is not") }
    WitnessProblem.OperandCount => { run Bytes.append(&mut text, b"it takes a different number of parameters") }
    WitnessProblem.OperandAccess {operand} => {
      run Bytes.append(&mut text, b"its parameter ")
      run appendDecimal(&mut text, operand + usize.ONE)
      run Bytes.append(&mut text, b" takes stronger access than promised, or consumes a borrowed operand")
    }
    WitnessProblem.OperandShape {operand} => {
      run Bytes.append(&mut text, b"its parameter ")
      run appendDecimal(&mut text, operand + usize.ONE)
      run Bytes.append(&mut text, b" is a slice where a reference is promised, or the reverse")
    }
    WitnessProblem.OperandType {operand} => {
      run Bytes.append(&mut text, b"its parameter ")
      run appendDecimal(&mut text, operand + usize.ONE)
      run Bytes.append(&mut text, b" has a different type or region")
    }
    WitnessProblem.ResultType => { run Bytes.append(&mut text, b"it returns a different type") }
    WitnessProblem.Failure => { run Bytes.append(&mut text, b"it can fail with an error the operation does not promise") }
    WitnessProblem.Requirement => { run Bytes.append(&mut text, b"it requires a service the operation does not promise") }
    WitnessProblem.RequirementAccess => { run Bytes.append(&mut text, b"it requires exclusive access where the operation promises shared access") }
    WitnessProblem.RequirementParameter => { run Bytes.append(&mut text, b"it requires a row parameter the operation does not promise") }
    WitnessProblem.Environment => { run Bytes.append(&mut text, b"its Effect environment is not known to cover the promised one") }
    WitnessProblem.Phase => { run Bytes.append(&mut text, b"one of them is a `static fn` and the other is not, or their `static` parameters differ") }
    _ => {}
  }
  return move text
}

// "member `name` does not match the operation of `contract`: ", which each mismatch detail follows.
effect fn appendWitnessLead(text: &mut Bytes, contract: &[u8], name: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut text.*, b"member ")
  run appendQuoted(&mut text.*, name)
  run Bytes.append(&mut text.*, b" does not match the operation of ")
  run appendQuoted(&mut text.*, contract)
  return run Bytes.append(&mut text.*, b": ")
}

// `witnessDetail`, naming both result types when a member returns another type than the operation
// does and both print exactly: "it returns `i64`, but the operation returns `main.Instant`".
effect fn resultWitnessDetail(viewer: &ModuleId, problem: WitnessProblem, contract: &[u8], name: &[u8],
  provided: &Shared<Result<Answer, NoRejection>>, promised: &Shared<Result<Answer, NoRejection>>) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  if let WitnessProblem.ResultType = problem {
    let returned = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(provided, signatureResult)
    let expected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(promised, signatureResult)
    if let Option<Shared<Type>>.Some {value: returnedType} = move returned {
      if let Option<Shared<Type>>.Some {value: expectedType} = move expected {
        if let Option<Bytes>.Some {value: returnedText} = move run TypeText.displayElided(&returnedType, viewer) {
          if let Option<Bytes>.Some {value: expectedText} = move run TypeText.displayElided(&expectedType, viewer) {
            let mut text = Bytes.make()
            if contract.length == usize.ZERO || name.length == usize.ZERO { return move text }
            run appendWitnessLead(&mut text, contract, name)
            run Bytes.append(&mut text, b"it returns `")
            run Bytes.append(&mut text, Bytes.asSlice(&returnedText))
            run Bytes.append(&mut text, b"`, but the operation returns `")
            run Bytes.append(&mut text, Bytes.asSlice(&expectedText))
            run Bytes.append(&mut text, b"`")
            return move text
          }
        }
      }
    }
  }
  return run witnessDetail(problem, contract, name)
}

// The SEM0083 detail of an implementation of `contract` that defines none of the operations
// `names`, each spelled without quotes.
effect fn missingWitnessDetail(contract: &[u8], names: &[Bytes]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if contract.length == usize.ZERO || names.length == usize.ZERO { return move text }
  run appendQuoted(&mut text, contract)
  run Bytes.append(&mut text, b" requires ")
  let mut at = usize.ZERO
  while at < names.length {
    if at != usize.ZERO {
      if at + usize.ONE == names.length { run Bytes.append(&mut text, b" and ") } else { run Bytes.append(&mut text, b", ") }
    }
    run appendQuoted(&mut text, Bytes.asSlice(&names[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut text, b", which this implementation does not define")
  return move text
}

// The `{detail}` argument of a SEM0083 rejection; none when `detail` is empty, so the message falls
// back to the code's meaning.
effect fn detailArguments(detail: Bytes) -> List<MessageArgument> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<MessageArgument>.make()
  if Bytes.length(&detail) != usize.ZERO {
    run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: move detail})
  }
  return move arguments
}

// The written name of `ty`: a nominal type's own name without its module or arguments, or the
// spelling of any other type that has one; empty otherwise.
effect fn writtenTypeName(viewer: &ModuleId, ty: &Shared<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let nominal = run contractName(ty)
  if Bytes.length(&nominal) != usize.ZERO { return move nominal }
  return match move run TypeText.display(ty, viewer) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => Bytes.make()
  }
}

// The SEM0083 detail of a second implementation of `contract` for `provider`; empty when either
// has no written name.
effect fn duplicateImplementationDetail(viewer: &ModuleId, contract: &Shared<Type>, provider: &Shared<Type>) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let contractText = run writtenTypeName(viewer, contract)
  let providerText = run writtenTypeName(viewer, provider)
  if Bytes.length(&contractText) == usize.ZERO || Bytes.length(&providerText) == usize.ZERO { return move text }
  run appendQuoted(&mut text, Bytes.asSlice(&providerText))
  run Bytes.append(&mut text, b" implements ")
  run appendQuoted(&mut text, Bytes.asSlice(&contractText))
  run Bytes.append(&mut text, b" twice; keep one implementation")
  return move text
}

// The SEM0083 detail of a conformance whose head `head` resolves and which defines member `name`
// twice; empty when the head names no contract or either type has no written name.
effect fn duplicateMemberDetail(viewer: &ModuleId, head: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let resolved = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(head, headOf) {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => { return move text }
  }
  let HeadApplication {contract: applied, provider, ..} = Shared<ImplementationHead>.with<HeadApplication>(&resolved, headApplication)
  let contract = match move applied {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return move text }
  }
  let contractText = run writtenTypeName(viewer, &contract)
  let providerText = run writtenTypeName(viewer, &provider)
  if name.length == usize.ZERO || Bytes.length(&contractText) == usize.ZERO || Bytes.length(&providerText) == usize.ZERO {
    return move text
  }
  run appendQuoted(&mut text, name)
  run Bytes.append(&mut text, b" is defined twice in the implementation of ")
  run appendQuoted(&mut text, Bytes.asSlice(&contractText))
  run Bytes.append(&mut text, b" for ")
  run appendQuoted(&mut text, Bytes.asSlice(&providerText))
  return move text
}

effect fn identityPath(first: &Shared<DeclarationId>, second: Option<Shared<DeclarationId>>) -> List<
  Shared<DeclarationId>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut path = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut path, Shared<DeclarationId>.clone(first))
  if let Option<Shared<DeclarationId>>.Some {value} = move second {
    run List<Shared<DeclarationId>>.append(&mut path, move value)
  }
  return move path
}

fn operationCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations, ..}} = &value.outcome {
      return List<Shared<DeclarationId>>.length(&operations)
    }
  }
  return usize.ZERO
}

fn memberCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ImplementationMembers {members}} = &value.outcome {
      return List<ImplementationMember>.length(&members)
    }
  }
  return usize.ZERO
}

// One written member: the declaration whose name selects an operation, the declaration that
// implements it, the member's span, and whether it maps an existing function.
struct WrittenWitness {
  declaration: Shared<DeclarationId>,
  implementation: Shared<DeclarationId>,
  span: Span,
  mapped: bool,
  /// The scalar intrinsic a member maps to; `implementation` is then the member itself.
  intrinsic: Option<IntrinsicMember>,
}

fn writtenWitness(member: &ImplementationMember) -> WrittenWitness {
  return match & member.* {
    ImplementationMember.Inline {declaration, span} => WrittenWitness {
      declaration: Shared<DeclarationId>.clone(&declaration),
      implementation: Shared<DeclarationId>.clone(&declaration),
      span: span,
      mapped: false,
      intrinsic: Option<IntrinsicMember>.none(),
    }
    ImplementationMember.Mapped {declaration, span, target} => WrittenWitness {
      declaration: Shared<DeclarationId>.clone(&declaration),
      implementation: Shared<DeclarationId>.clone(&target),
      span: span,
      mapped: true,
      intrinsic: Option<IntrinsicMember>.none(),
    }
    // A sealed scalar intrinsic is the provider's own operation, so a scalar provider may map it.
    ImplementationMember.Intrinsic {declaration, span, member: intrinsic} => WrittenWitness {
      declaration: Shared<DeclarationId>.clone(&declaration),
      implementation: Shared<DeclarationId>.clone(&declaration),
      span: span,
      mapped: false,
      intrinsic: Option<IntrinsicMember>.some(intrinsic),
    }
  }
}

fn memberAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<WrittenWitness> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ImplementationMembers {members}} = &value.outcome {
      let listed = List<ImplementationMember>.asSlice(&members)
      if at < listed.length {
        return Option<WrittenWitness>.some(writtenWitness(&listed[at]))
      }
    }
  }
  return Option<WrittenWitness>.none()
}

fn spellingWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared<DeclarationId>.with<bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.sameSpelling(first, second)
    },
  )
}

fn sameSpelling(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  return Shared<DeclarationId>.with<bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return spellingWith(first, right)
    },
  )
}

// The position of the member written for `operation`, or `usize.MAX`.
fn memberFor(answer: &Result<Answer, NoRejection>, operation: &Shared<DeclarationId>) -> usize {
  let count = memberCount(answer)
  let mut at = usize.ZERO
  while at < count {
    if let Option<WrittenWitness>.Some {value: member} = move memberAt(answer, at) {
      if sameSpelling(&member.declaration, operation) {
        return at
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Whether any operation of the contract has this member's name.
fn namesOperation(answer: &Result<Answer, NoRejection>, member: &Shared<DeclarationId>) -> bool {
  let count = operationCount(answer)
  let mut at = usize.ZERO
  while at < count {
    if let Option<Shared<DeclarationId>>.Some {value: operation} = move operationAt(answer, at) {
      if sameSpelling(&operation, member) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// The interned ordinal of the module that declares `identity`, or `usize.MAX`.
fn identityModuleOrdinal(resolver: &Resolver, identity: &Shared<DeclarationId>) -> usize {
  return Shared<DeclarationId>.with<usize>(
    identity,
    fn(declaration: &DeclarationId) -> usize {
      return knownModuleOrdinal(resolver, DeclarationId.moduleId(declaration))
    },
  )
}

// A scalar or `string` provider has no source actor, so its source witnesses are inline.
fn contractOwnedProvider(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {..} => true
    Type.String {..} => true
    _ => false
  }
}

// Pairs each contract operation of one conformance with the member that implements it and checks
// the member's header against the operation's header under the conformance head. The head, the
// member list, the contract's operation list, every operation under the head, and every
// implementation header are child answers; no body is read. The first failure in member order (an
// unknown member) and then operation order (a missing member, then an incompatible one) rejects
// the conformance, so no partial witness set is published.
effect fn resolveWitnesses(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, key.module)
  let mut dependencies = List<Dependency>.make()
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
        &headAnswer,
        answerCause,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return run memberRejected(move diagnostic, move dependencies)
      }
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let applied = Shared<ImplementationHead>.with<HeadApplication>(&head, headApplication)
  let HeadApplication {contract: written, provider, span, contractSpan} = move applied
  // An inherent or sealed-property head implements no contract operation.
  let contract = match move written {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: resolveWitnesses")
    }
  }
  let contractText = run contractName(&contract)
  let membersKey = Key {
    family: Family.ImplementationMembers,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let members = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, membersKey, span)
  let refusedMembers = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &members,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedMembers {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &contract)
  if contractModuleOrdinal == usize.MAX {
    return CompilerBug.panic(b"MissingRetainedFact: resolveWitnesses")
  }
  let contractModule = resolvedModule(&resolver.*, contractModuleOrdinal)
  let located = run ordinalOfProvider(&mut resolver.*, &contractModule, &contract)
  let contractOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: resolveWitnesses")
    }
  }
  let declarationAccess85Request = Key {
    family: Family.Operations,
    module: contractModuleOrdinal,
    name: usize.ZERO,
    declaration: contractOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess85 = run internDeclaration(&mut resolver.*, declarationAccess85Request)
  let operationsKey = declarationAccess85
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    operationsKey,
    contractSpan,
  )
  let refusedOperations = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedOperations {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let memberTotal = Shared<Result<Answer, NoRejection>>.with<usize>(&members, memberCount)
  let mut at = usize.ZERO
  while at < memberTotal {
    let entry = Shared<Result<Answer, NoRejection>>.with<Option<WrittenWitness>>(
      &members,
      fn(answer: &Result<Answer, NoRejection>) -> Option<WrittenWitness> {
        return memberAt(answer, at)
      },
    )
    if let Option<WrittenWitness>.Some {value: member} = move entry {
      let known = Shared<Result<Answer, NoRejection>>.with<bool>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return namesOperation(answer, &member.declaration)
        },
      )
      if !known {
        let name = run ownName(&member.declaration)
        return run memberRejected(
          run rejectWitness(
            &module,
            member.span,
            WitnessProblem.Unknown,
            run identityPath(&member.declaration, Option<Shared<DeclarationId>>.none()),
            run witnessDetail(WitnessProblem.Unknown, Bytes.asSlice(&contractText), Bytes.asSlice(&name)),
          ),
          move dependencies,
        )
      }
    }
    at = at + usize.ONE
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, operationCount)
  // Every missing operation is named, and the rejection's path holds the first.
  let mut missing = List<Bytes>.make()
  let mut firstMissing = Option<Shared<DeclarationId>>.none()
  at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operationAt(answer, at)
      },
    )
    if let Option<Shared<DeclarationId>>.Some {value: operation} = move selected {
      let position = Shared<Result<Answer, NoRejection>>.with<usize>(
        &members,
        fn(answer: &Result<Answer, NoRejection>) -> usize {
          return memberFor(answer, &operation)
        },
      )
      let defaulted = Shared<Result<Answer, NoRejection>>.with<bool>(&listed,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return defaultedAt(answer, at) })
      if position == usize.MAX && !defaulted {
        run List<Bytes>.append(&mut missing, run ownName(&operation))
        if List<Bytes>.length(&missing) == usize.ONE { firstMissing = Option<Shared<DeclarationId>>.some(move operation) }
      }
    }
    at = at + usize.ONE
  }
  if let Option<Shared<DeclarationId>>.Some {value: operation} = move firstMissing {
    return run memberRejected(
      run rejectWitness(
        &module,
        span,
        WitnessProblem.Missing,
        run identityPath(&operation, Option<Shared<DeclarationId>>.none()),
        run missingWitnessDetail(Bytes.asSlice(&contractText), List<Bytes>.asSlice(&missing)),
      ),
      move dependencies,
    )
  }
  let scalar = Shared<Type>.with<bool>(&provider, contractOwnedProvider)
  let mut witnesses = List<Witness>.make()
  at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operationAt(answer, at)
      },
    )
    let operation = match move selected {
      Option<Shared<DeclarationId>>.Some {value} => move value
      Option<Shared<DeclarationId>>.None => {
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, contractSpan),
          move dependencies,
        )
      }
    }
    let entry = Shared<Result<Answer, NoRejection>>.with<Option<WrittenWitness>>(
      &members,
      fn(answer: &Result<Answer, NoRejection>) -> Option<WrittenWitness> {
        return memberAt(answer, memberFor(answer, &operation))
      },
    )
    let member = match move entry {
      Option<WrittenWitness>.Some {value} => move value
      Option<WrittenWitness>.None => {
        // An omitted operation was checked above to write a default body, which implements it.
        let defaulted = run defaultWitness(&mut resolver.*, &mut owner.*, &mut dependencies, &contract, &provider,
          move operation, span)
        match move defaulted {
          Result<Witness, Shared<Rejection>>.Success {value} => { run List<Witness>.append(&mut witnesses, move value) }
          Result<Witness, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
        }
        at = at + usize.ONE
        continue
      }
    }
    if scalar && member.mapped {
      return run memberRejected(
        run rejectWitness(
          &module,
          member.span,
          WitnessProblem.ScalarMapping,
          run identityPath(
            &operation,
            Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&member.implementation)),
          ),
          run witnessDetail(WitnessProblem.ScalarMapping, Bytes.asSlice(&contractText), Bytes.asSlice(&run ownName(&operation))),
        ),
        move dependencies,
      )
    }
    let underKey = Key {
      family: Family.OperationUnder,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: at,
      external: false,
    }
    let promised = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      underKey,
      member.span,
    )
    let refusedOperation = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &promised,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedOperation {
      return run memberRejected(move diagnostic, move dependencies)
    }
    if let Option<IntrinsicMember>.Some {value: intrinsic} = &member.intrinsic {
      let mut intrinsicOperands = List<OperandPass>.make()
      let checked = run intrinsicWitnessVerdict(&promised, intrinsic, &mut intrinsicOperands)
      match move checked {
        Verdict.Compatible => {
          run List<Witness>.append(&mut witnesses, Witness {
            operation: move operation,
            implementation: WitnessImplementation.Intrinsic {member: intrinsic},
            arguments: List<Argument>.make(),
            argumentOrdinals: List<usize>.make(),
            scopes: List<ScopeBinding>.make(),
            operands: move intrinsicOperands,
          })
        }
        Verdict.Incompatible {problem} => {
          return run memberRejected(
            run rejectWitness(&module, member.span, problem, run identityPath(&operation, Option<Shared<DeclarationId>>.none()),
              run witnessDetail(problem, Bytes.asSlice(&contractText), Bytes.asSlice(&run ownName(&operation)))),
            move dependencies,
          )
        }
        Verdict.Unsupported => {
          return run memberRejected(run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span), move dependencies)
        }
      }
      at = at + usize.ONE
      continue
    }
    let witnessModuleOrdinal = identityModuleOrdinal(&resolver.*, &member.implementation)
    if witnessModuleOrdinal == usize.MAX {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span),
        move dependencies,
      )
    }
    let witnessModule = resolvedModule(&resolver.*, witnessModuleOrdinal)
    let witnessFound = run ordinalOfIdentity(
      &mut resolver.*,
      &witnessModule,
      &member.implementation,
    )
    let operationFound = run ordinalOfIdentity(&mut resolver.*, &contractModule, &operation)
    let mut witnessOrdinal = usize.MAX
    let mut witnessOwner = Option<DeclarationId>.none()
    if let Option<usize>.Some {value} = move witnessFound {
      witnessOrdinal = value
      witnessOwner = run declarationAt(&mut resolver.*, &witnessModule, value)
    }
    let mut operationOwner = Option<DeclarationId>.none()
    if let Option<usize>.Some {value} = move operationFound {
      operationOwner = run declarationAt(&mut resolver.*, &contractModule, value)
    }
    let implementationOwner = match move witnessOwner {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => {
        return CompilerBug.panic(b"MissingRetainedFact: resolveWitnesses")
      }
    }
    let contractOperation = match move operationOwner {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => {
        return CompilerBug.panic(b"MissingRetainedFact: resolveWitnesses")
      }
    }
    let declarationAccess86Request = Key {
      family: Family.Signature,
      module: witnessModuleOrdinal,
      name: usize.ZERO,
      declaration: witnessOrdinal,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess86 = run internDeclaration(&mut resolver.*, declarationAccess86Request)
    let signatureKey = declarationAccess86
    let provided = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      signatureKey,
      member.span,
    )
    let refusedWitness = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
      &provided,
      answerCause,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedWitness {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let mut matchedArguments = List<Argument>.make()
    let mut matchedOrdinals = List<usize>.make()
    let mut matchedScopes = List<ScopeBinding>.make()
    let mut matchedOperands = List<OperandPass>.make()
    let verdict = run witnessVerdict(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      &head,
      &promised,
      &contractOperation,
      &provided,
      &implementationOwner,
      &witnessModule,
      witnessOrdinal,
      signatureKey,
      &mut matchedArguments,
      &mut matchedOrdinals,
      &mut matchedScopes,
      &mut matchedOperands,
    )
    match move verdict {
      Verdict.Compatible => {
        run List<Witness>.append(
          &mut witnesses,
          Witness {
            operation: move operation,
            implementation: WitnessImplementation.Declaration {declaration: Shared<DeclarationId>.clone(&member.implementation)},
            arguments: move matchedArguments,
            argumentOrdinals: move matchedOrdinals,
            scopes: move matchedScopes,
            operands: move matchedOperands,
          },
        )
      }
      Verdict.Incompatible {problem} => {
        return run memberRejected(
          run rejectWitness(
            &module,
            member.span,
            problem,
            run identityPath(
              &operation,
              Option<Shared<DeclarationId>>.some(
                Shared<DeclarationId>.clone(&member.implementation),
              ),
            ),
            run resultWitnessDetail(&module, problem, Bytes.asSlice(&contractText), Bytes.asSlice(&run ownName(&operation)),
              &provided, &promised),
          ),
          move dependencies,
        )
      }
      Verdict.Unsupported => {
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span),
          move dependencies,
        )
      }
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.Witnesses {witnesses: move witnesses}, move dependencies)
}

// The witness of an operation a conformance omits: the operation's own default body, applied to
// its own binders and, in its contract's scope, to the conformance's contract arguments and, for an
// interface, its provider as `Self`. A service default reaches its provider through the Effect
// environment its operation requires, so it takes no receiver.
effect fn defaultWitness(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: Shared<DeclarationId>,
  span: Span,
) -> Result<Witness, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let identity = DeclarationId.copyShared(&operation)
  let mut request = Request.make()
  let found = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true, &identity, span)
  let module = DeclarationId.moduleId(&identity)
  let schema = match move found {
    Option<TargetSchema>.Some {value} => move value
    Option<TargetSchema>.None => {
      return Result<Witness, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let mut supplied = List<Argument>.make()
  let mut count = Shared<Type>.with<usize>(contract, applicationLength)
  if count == usize.MAX { count = usize.ZERO }
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared<Type>.with<Option<Argument>>(contract,
      fn(ty: &Type) -> Option<Argument> { return applicationArgument(ty, at) })
    if let Option<Argument>.Some {value} = move argument { run List<Argument>.append(&mut supplied, move value) }
    at = at + usize.ONE
  }
  run List<Argument>.append(&mut supplied, Argument.Type {value: Shared<Type>.clone(provider)})
  let suppliedSlice = List<Argument>.asSlice(&supplied)
  let ownSlots = List<ApplicationSlot>.asSlice(&schema.own)
  let mut arguments = List<Argument>.make()
  at = usize.ZERO
  while at < ownSlots.length {
    run List<Argument>.append(&mut arguments, run scopeArgument(&identity, ownSlots[at].ordinal, ownSlots[at].kind))
    at = at + usize.ONE
  }
  let mut scopes = List<ScopeBinding>.make()
  let expected = List<ApplicationScope>.asSlice(&schema.scopes)
  at = usize.ZERO
  while at < expected.length {
    let slots = List<ApplicationSlot>.asSlice(&expected[at].slots)
    let mut values = List<Argument>.make()
    let mut ordinals = List<usize>.make()
    let mut index = usize.ZERO
    while index < slots.length {
      if slots[index].ordinal >= suppliedSlice.length {
        return Result<Witness, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
      run List<Argument>.append(&mut values, Argument.copy(&suppliedSlice[slots[index].ordinal]))
      run List<usize>.append(&mut ordinals, slots[index].ordinal)
      index = index + usize.ONE
    }
    run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: Shared<DeclarationId>.clone(&expected[at].owner),
      arguments: move values, argumentOrdinals: move ordinals})
    at = at + usize.ONE
  }
  let signatureCount = run defaultParameterCount(&mut resolver.*, &mut owner.*, &mut dependencies.*, &identity, span)
  let mut operands = List<OperandPass>.make()
  at = usize.ZERO
  while at < signatureCount {
    run List<OperandPass>.append(&mut operands, OperandPass.Value)
    at = at + usize.ONE
  }
  return Result<Witness, Shared<Rejection>>.succeed(Witness {
    operation: Shared<DeclarationId>.clone(&operation),
    implementation: WitnessImplementation.Declaration {declaration: move operation},
    arguments: move arguments,
    argumentOrdinals: run applicationOrdinals(ownSlots),
    scopes: move scopes,
    operands: move operands,
  })
}

// The parameter count of a contract operation's own signature.
effect fn defaultParameterCount(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, identity: &DeclarationId, span: Span) -> usize
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(identity))
  if moduleOrdinal == usize.MAX { return usize.ZERO }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let shared = run Shared<DeclarationId>.make(DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &module, &shared) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return usize.ZERO }
  }
  let signatureRequest = Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal,
    member: usize.ZERO, external: false}
  let signatureKey = run internDeclaration(&mut resolver.*, signatureRequest)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, signatureKey, span)
  return Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
}

// Binds an enclosing scope to supplied arguments in order, after checking their count and kinds.
// Supplied arguments are not checked against the scope's bounds; that is conformance checking.
effect fn bindSupplied(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  formal: &[Binder],
  given: &[Argument],
) -> Result<List<Binder>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if given.length != formal.length {
    return Result<List<Binder>, Shared<Rejection>>.failResult(
      run rejectArity(&resolver.*, module, span, formal.length, given.length),
    )
  }
  let mut at = usize.ZERO
  while at < given.length {
    if argumentKind(&given[at]) != binderKind(&formal[at]) {
      return Result<List<Binder>, Shared<Rejection>>.failResult(
        run rejectKind(
          &resolver.*,
          module,
          span,
          binderName(&formal[at]),
          binderKind(&formal[at]),
          argumentKind(&given[at]),
        ),
      )
    }
    at = at + usize.ONE
  }
  return Result<List<Binder>, Shared<Rejection>>.succeed(run bindArguments(formal, given))
}

// Exact application bindings preserve lexical ownership. In particular the impl's Self binder
// already contains the head provider, so applying it derives Self without adding a stored slot.
effect fn applyBinderEnvironment(binder: &Binder, bindings: &[Binding]) -> Binder
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match &binder.* {
    Binder.Type {name, value} => Binder.Type {name: run Bytes.copy(Bytes.asSlice(&name)),
      value: run Type.applyBindings(&value, bindings, true)}
    Binder.Lifetime {name, value} => Binder.Lifetime {name: run Bytes.copy(Bytes.asSlice(&name)),
      value: run Type.applyLifetimeBindings(&value, bindings)}
    Binder.Row {name, value, bound} => {
      let owner = DeclarationId.copyShared(&value.declaration)
      let supplied = bindingArgument(bindings, &owner, value.ordinal)
      let applied = match move supplied {
        Option<Argument>.Some {value: Argument.Row {value: row}} => Option<Shared<Row>>.some(move row)
        _ => copyBound(&bound)
      }
      return Binder.Row {name: run Bytes.copy(Bytes.asSlice(&name)), value: RowParameter {
        declaration: Shared<DeclarationId>.clone(&value.declaration), ordinal: value.ordinal}, bound: move applied}
    }
  }
}

// An inherent member's contract lists the owner binders it mentions, every one when it names
// `Self`, in declaration order, before the member's own binders.
fn ordinalsWithin(values: &List<usize>, mentioned: &List<usize>) -> bool {
  let listed = List<usize>.asSlice(values)
  let mut at = usize.ZERO
  while at < listed.length {
    if !containsOrdinal(mentioned, listed[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn appendOwnerParameters(
  resolver: &mut Resolver,
  module: &ModuleId,
  declaration: usize,
  parameters: &[Shared<Type>],
  result: &Shared<Type>,
  channels: &Channels,
  environment: &Option<Intersection>,
  constraints: &mut List<Constraint>,
  inheritedStart: usize,
  inheritedEnd: usize,
  typeParameters: &mut List<Shared<Type>>,
  allLifetimes: &mut List<Shared<Lifetime>>,
  rowParameters: &mut List<RowParameter>,
) -> ()
! Cycle | OutOfMemoryError
? &mut Allocator | &mut Types {
  let enclosingOwner = run enclosingIdentity(&mut resolver.*, module, declaration)
  let implementation = match move enclosingOwner {
    Option<DeclarationId>.Some {value: found} => move found
    Option<DeclarationId>.None => {
      return ()
    }
  }
  let mut types = List<usize>.make()
  let mut regions = List<usize>.make()
  let mut rows = List<usize>.make()
  let written = parameters
  let mut writtenAt = usize.ZERO
  while writtenAt < written.length {
    run Type.collectOwned(
      &written[writtenAt],
      &implementation,
      &mut types,
      &mut regions,
      &mut rows,
    )
    writtenAt = writtenAt + usize.ONE
  }
  run Type.collectOwned(result, &implementation, &mut types, &mut regions, &mut rows)
  run Type.collectOwned(
    &channels.failure,
    &implementation,
    &mut types,
    &mut regions,
    &mut rows,
  )
  run Type.collectOwnedRow(
    &channels.requirements,
    &implementation,
    &mut types,
    &mut regions,
    &mut rows,
  )
  // A written `effect<'a> fn` environment can mention an owner lifetime nothing else does.
  if let Option<Intersection>.Some {value: declaredEnvironment} = &environment.* {
    let retainedRegions = List<LifetimeMember>.asSlice(&declaredEnvironment.members)
    let mut regionAt = usize.ZERO
    while regionAt < retainedRegions.length {
      run Type.collectOwnedLifetime(
        &retainedRegions[regionAt].region,
        &implementation,
        &mut regions,
      )
      regionAt = regionAt + usize.ONE
    }
  }
  // The member's own bounds mention owner binders; an inherited owner premise does not, so an
  // owner binder only such a premise names never joins the member, which no call could infer.
  let declared = List<Constraint>.asSlice(&constraints.*)
  let mut declaredAt = usize.ZERO
  while declaredAt < declared.length {
    if declaredAt < inheritedStart || declaredAt >= inheritedEnd {
      run collectConstraint(
        &declared[declaredAt],
        &implementation,
        &mut types,
        &mut regions,
        &mut rows,
      )
    }
    declaredAt = declaredAt + usize.ONE
  }
  // An inherited premise over a type or row binder the member never mentions constrains nothing
  // it uses. An owner lifetime the member never mentions is 'static, as in the bootstrap, so a
  // premise naming one stays and each call proves it with 'static in that lifetime's place.
  let sharedImplementation = run Shared<DeclarationId>.make(DeclarationId.copy(&implementation))
  let mut premiseAt = inheritedEnd
  while premiseAt > inheritedStart {
    premiseAt = premiseAt - usize.ONE
    let mut premiseTypes = List<usize>.make()
    let mut premiseRegions = List<usize>.make()
    let mut premiseRows = List<usize>.make()
    let premises = List<Constraint>.asSlice(&constraints.*)
    run collectConstraint(&premises[premiseAt], &implementation, &mut premiseTypes, &mut premiseRegions, &mut premiseRows)
    if !ordinalsWithin(&premiseTypes, &types) || !ordinalsWithin(&premiseRows, &rows) {
      let unused = List<Constraint>.remove(&mut constraints.*, premiseAt)
      drop unused
    } else if !ordinalsWithin(&premiseRegions, &regions) {
      let mut unmentioned = List<Binding>.make()
      let named = List<usize>.asSlice(&premiseRegions)
      let mut namedAt = usize.ZERO
      while namedAt < named.length {
        if !containsOrdinal(&regions, named[namedAt]) {
          run List<Binding>.append(&mut unmentioned, Binding {declaration: Shared<DeclarationId>.clone(&sharedImplementation),
            ordinal: named[namedAt], value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)}})
        }
        namedAt = namedAt + usize.ONE
      }
      let substituted = run applyConstraintBindings(&premises[premiseAt], List<Binding>.asSlice(&unmentioned))
      List<Constraint>.set(&mut constraints.*, premiseAt, move substituted)
    }
  }
  let sharedOwner = run Shared<DeclarationId>.make(DeclarationId.copy(&implementation))
  let sortedTypes = run sortedOrdinals(&types)
  let typeOrdinals = List<usize>.asSlice(&sortedTypes)
  let mut ordinalAt = usize.ZERO
  while ordinalAt < typeOrdinals.length {
    run List<Shared<Type>>.append(
      &mut typeParameters.*,
      run Types.intern(
        Type.Parameter {
          declaration: DeclarationId.copy(&implementation),
          ordinal: typeOrdinals[ordinalAt],
        },
      ),
    )
    ordinalAt = ordinalAt + usize.ONE
  }
  let sortedRegions = run sortedOrdinals(&regions)
  let anchoredNodes = List<usize>.asSlice(&sortedRegions)
  ordinalAt = usize.ZERO
  while ordinalAt < anchoredNodes.length {
    run List<Shared<Lifetime>>.append(
      &mut allLifetimes.*,
      run Shared<Lifetime>.make(
        Lifetime.Parameter {
          declaration: DeclarationId.copy(&implementation),
          ordinal: anchoredNodes[ordinalAt],
        },
      ),
    )
    ordinalAt = ordinalAt + usize.ONE
  }
  let sortedRows = run sortedOrdinals(&rows)
  let rowOrdinals = List<usize>.asSlice(&sortedRows)
  ordinalAt = usize.ZERO
  while ordinalAt < rowOrdinals.length {
    run List<RowParameter>.append(
      &mut rowParameters.*,
      RowParameter {
        declaration: Shared<DeclarationId>.clone(&sharedOwner),
        ordinal: rowOrdinals[ordinalAt],
      },
    )
    ordinalAt = ordinalAt + usize.ONE
  }
  return ()
}

// The span of the written parameter type, or `fallback` when its syntax is unavailable.
effect fn parameterSpanOr(
  resolver: &mut Resolver,
  module: &ModuleId,
  id: HirId,
  fallback: Span,
) -> Span
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value: parameterSyntax} = move written {
    return parameterSyntax.span
  }
  return fallback
}

// Resolves a declaration's written signature, continuing the running query's `inherited`
// dependencies. The enclosing scope is always resolved as written; `supplied` then binds its
// binders in order, `Self` last, by re-resolving the header under those arguments rather than
// substituting types. The declaration's own binders stay its rigid parameters either way.
// The validated inherent head owns its domain premises. Rebind them through the current Self
// application so abstract member headers and selected instances see the same lexical facts.
// The representations a conformance member shares with its head: each use contract written in
// the head is one hidden binder, and a member parameter writing that same contract names it
// (REP-001), so the member receives the head's exact representation. Under an application the
// slots are applied like the member's other inherited types.
effect fn headRepresentationSlots(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, module: &ModuleId, declaration: usize, contextBindings: &[Binding], span: Span,
) -> List<CallableParameter.RepresentationSlot>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut slots = List<CallableParameter.RepresentationSlot>.make()
  let place = run memberPlace(&mut resolver.*, module, declaration)
  if !place.implementation || place.inherent {
    return move slots
  }
  let declarationAccess87Request = Key {
    family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO,
    declaration: place.parent, member: usize.ZERO, external: false,
  }
  let declarationAccess87 = run internDeclaration(&mut resolver.*, declarationAccess87Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess87, span)
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer, headOf)
  let head = match move found {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => { return move slots }
  }
  let first = Shared<ImplementationHead>.with<usize>(&head, fn(value: &ImplementationHead) -> usize {
    return headBinderCount(value) - value.reified
  })
  let sharedIdentity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(&head, fn(value: &ImplementationHead) -> Shared<DeclarationId> {
    return Shared<DeclarationId>.clone(&value.declaration)
  })
  let identity = DeclarationId.copyShared(&sharedIdentity)
  let bounds = run headRepresentations(&head)
  let listed = List<Constraint>.asSlice(&bounds)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Constraint.Represents {parameter, contract} = &listed[at] {
      let ordinal = Shared<Type>.with<usize>(&parameter, fn(value: &Type) -> usize {
        return Type.parameterOrdinalOf(value, &identity)
      })
      if ordinal != usize.MAX && ordinal >= first {
        run List<CallableParameter.RepresentationSlot>.append(&mut slots, CallableParameter.RepresentationSlot {
          representation: run Type.applyBindings(&parameter, contextBindings, true),
          contract: run Type.applyBindings(&contract, contextBindings, true),
        })
      }
    }
    at = at + usize.ONE
  }
  return move slots
}

effect fn inherentMemberPremises(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, module: &ModuleId, declaration: usize, scope: &[Binder], span: Span,
) -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut premises = List<Constraint>.make()
  let place = run memberPlace(&mut resolver.*, module, declaration)
  if !place.inherent {
    return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises)
  }
  let declarationAccess88Request = Key {
    family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO,
    declaration: place.parent, member: usize.ZERO, external: false,
  }
  let declarationAccess88 = run internDeclaration(&mut resolver.*, declarationAccess88Request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess88, span)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer, headOf)
  let head = match move found {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Result<List<Constraint>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let count = Shared<ImplementationHead>.with<usize>(&head, fn(value: &ImplementationHead) -> usize {
    return List<Constraint>.length(&value.ownerPremises)
  })
  let authored = Shared<ImplementationHead>.with<usize>(&head, fn(value: &ImplementationHead) -> usize {
    return List<Constraint>.length(&value.binders.constraints)
  })
  if count == usize.ZERO && authored == usize.ZERO {
    return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises)
  }
  let mut actualSelf = Option<Shared<Type>>.none()
  let mut at = usize.ZERO
  while at < scope.length {
    if let Binder.Type {name, value} = &scope[at] {
      if same(Bytes.asSlice(&name), b"Self") { actualSelf = Option<Shared<Type>>.some(Shared<Type>.clone(&value)) }
    }
    at = at + usize.ONE
  }
  let applied = match move actualSelf {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Result<List<Constraint>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.InvalidInherentHead, span),
      )
    }
  }
  let provider = Shared<ImplementationHead>.with<Shared<Type>>(&head, headProvider)
  if !sameNominal(&provider, &applied) {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InvalidInherentHead, span),
    )
  }
  let patterns = run typeApplicationArguments(&provider)
  let arguments = run typeApplicationArguments(&applied)
  let original = List<Argument>.asSlice(&patterns)
  let supplied = List<Argument>.asSlice(&arguments)
  if original.length != supplied.length {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InvalidInherentHead, span),
    )
  }
  let sharedIdentity = Shared<ImplementationHead>.with<Shared<DeclarationId>>(&head, fn(value: &ImplementationHead) -> Shared<DeclarationId> {
    return Shared<DeclarationId>.clone(&value.declaration)
  })
  let identity = DeclarationId.copyShared(&sharedIdentity)
  let mut bindings = List<Binding>.make()
  at = usize.ZERO
  while at < original.length {
    let ordinal = argumentOrdinal(&original[at], &identity)
    if ordinal == usize.MAX {
      return Result<List<Constraint>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.InvalidInherentHead, span),
      )
    }
    run List<Binding>.append(&mut bindings, Binding {
      declaration: Shared<DeclarationId>.clone(&sharedIdentity), ordinal: ordinal,
      value: copyArgument(&supplied[at]),
    })
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < count {
    let written = Shared<ImplementationHead>.with<Constraint>(&head, fn(value: &ImplementationHead) -> Constraint {
      let constraints = List<Constraint>.asSlice(&value.ownerPremises)
      return copyConstraint(&constraints[at])
    })
    run List<Constraint>.append(&mut premises, run applyConstraintBindings(&written, List<Binding>.asSlice(&bindings)))
    at = at + usize.ONE
  }
  // The impl's own `where` bounds are premises of every member body, so each call proves them
  // under its application, as it proves the member's own bounds.
  at = usize.ZERO
  while at < authored {
    let written = Shared<ImplementationHead>.with<Constraint>(&head, fn(value: &ImplementationHead) -> Constraint {
      let constraints = List<Constraint>.asSlice(&value.binders.constraints)
      return copyConstraint(&constraints[at])
    })
    run List<Constraint>.append(&mut premises, run applyConstraintBindings(&written, List<Binding>.asSlice(&bindings)))
    at = at + usize.ONE
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises)
}

// An anonymous callable uses its enclosing function's type and row parameters (ANON-CALLABLE-001),
// so that function's constraints are premises of every bound its written contract applies, under
// the same application. They stay premises only: the anonymous contract does not restate them.
effect fn enclosingFunctionPremises(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, module: &ModuleId, declaration: usize, contextBindings: &[Binding], span: Span,
) -> Result<List<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut premises = List<Constraint>.make()
  let mut anonymous = false
  let written = run observedHeader(&mut resolver.*, module, declaration, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.CallableContract {..} = value.header { anonymous = true }
  }
  if !anonymous { return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises) }
  let place = run memberPlace(&mut resolver.*, module, declaration)
  if place.parent == usize.MAX { return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises) }
  let mut function = false
  let enclosing = run observedHeader(&mut resolver.*, module, place.parent, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value} = move enclosing {
    if let Node.FunctionHeader {..} = value.header { function = true }
  }
  if !function { return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises) }
  let declarationAccess89Request = Key {
    family: Family.Signature, module: moduleOrdinal, declaration: place.parent, name: usize.ZERO, member: usize.ZERO,
    external: false,
  }
  let declarationAccess89 = run internDeclaration(&mut resolver.*, declarationAccess89Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess89, span)
  let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result<List<Constraint>, Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run List<Constraint>.append(&mut premises, run applyConstraintBindings(&value, contextBindings))
    }
    at = at + usize.ONE
  }
  return Result<List<Constraint>, Shared<Rejection>>.succeed(move premises)
}

effect fn resolveSignatureUnder(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
  inherited: List<Dependency>,
  supplied: Option<List<Argument>>,
  ownSupplied: Option<List<Argument>>,
  application: &Option<Application>,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut boundsPhase = BoundPhase.Authored
  if let Option<List<Argument>>.Some { .. } = &supplied {
    boundsPhase = BoundPhase.Application
  }
  if let Option<List<Argument>>.Some { .. } = &ownSupplied {
    boundsPhase = BoundPhase.Application
  }
  if let Option<Application>.Some { .. } = &application.* {
    boundsPhase = BoundPhase.Application
  }
  let module = resolvedModule(&resolver.*, key.module)
  let declarationAccess90 = declarationPosition(&resolver.*, key)
  let written = run signatureSyntax(&mut resolver.*, &module, declarationAccess90)
  let mut dependencies = move inherited
  let mut context = List<Binding>.make()
  if let Option<Application>.Some {value: applied} = &application.* {
    context = run Application.bindings(&applied)
  }
  let contextBindings = List<Binding>.asSlice(&context)
  let value = match move written {
    Option<WrittenSignature>.Some {value: syntax} => move syntax
    Option<WrittenSignature>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  if let Option<HeaderConflict>.Some {value: conflict} = &value.headerConflict {
    let mut diagnostic = run makeRejection(conflict.code, &module, conflict.span)
    let filled = List<MessageArgument>.asSlice(&conflict.arguments)
    let mut hole = usize.ZERO
    while hole < filled.length {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(Bytes.asSlice(&filled[hole].name)),
        value: run Bytes.copy(Bytes.asSlice(&filled[hole].value))})
      hole = hole + usize.ONE
    }
    return run memberRejected(run Shared<Rejection>.make(move diagnostic), move dependencies)
  }
  // An export's shim is always built, so its target lanes are checked here; an import's are
  // checked where it is called (`targetLane`).
  let mut exportedLanes = false
  let mut foreignLanes = false
  if value.foreign {
    let declarationAccess91 = declarationPosition(&resolver.*, key)
    let foreign = run foreignHeader(&mut resolver.*, &module, declarationAccess91)
    exportedLanes = foreign.exported && !foreign.global
    foreignLanes = !foreign.global
    if let Option<GapCode>.Some {value: reason} = move foreign.gap {
      if reason == GapCode.CAbiCallback {
        // C function-pointer parameters the properties do not name are the author's to name.
        if Bytes.length(&foreign.callbacks) != usize.ZERO {
          let mut named = run makeRejection(RejectionCode.ForeignType, &module, foreign.span)
          run List<MessageArgument>.append(&mut named.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
          run List<MessageArgument>.append(&mut named.arguments, MessageArgument {name: run Bytes.copy(b"clause"), value: run Bytes.copy(Bytes.asSlice(&foreign.callbacks))})
          return run memberRejected(run Shared<Rejection>.make(move named), move dependencies)
        }
        return run memberRejected(
          run reject(&resolver.*, &module, RejectionCode.ForeignCallback, foreign.span),
          move dependencies,
        )
      }
    }
  }
  let mut publicExposure = value.isPublic
  if let Option<Application>.Some {..} = &application.* { publicExposure = false }
  if let Option<List<Argument>>.Some {..} = &supplied {
    publicExposure = false
  }
  // Instantiation is a caller-local use, not a newly published authored contract.
  if let Option<List<Argument>>.Some {..} = &ownSupplied {
    publicExposure = false
  }
  if !value.supported {
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: run rejectedOutcome(move diagnostic),
      dependencies: move dependencies,
    }
  }
  let declarationAccess92 = declarationPosition(&resolver.*, key)
  let template = run templateBinders(&mut resolver.*, &module, declarationAccess92)
  let mut binders = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Answer {
        outcome: run rejectedOutcome(move error),
        dependencies: move dependencies,
      }
    }
  }
  let declarationAccess93 = declarationPosition(&resolver.*, key)
  let identified = run declarationAt(&mut resolver.*, &module, declarationAccess93)
  let signatureOwner = match move identified {
    Option<DeclarationId>.Some {value: found} => move found
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
  }
  // The signature's own binders come first, one-to-one with its written generic list; the
  // enclosing contract's binders and `Self` follow and keep their own declaration identities.
  let ownCount = List<Binder>.length(&binders)
  if let Option<List<Argument>>.Some {value: arguments} = &ownSupplied {
    if List<Argument>.length(&arguments) < ownCount {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    binders = run bindArguments(
      List<Binder>.asSlice(&binders),
      List<Argument>.asSlice(&arguments),
    )
  }
  let declarationAccess94 = declarationPosition(&resolver.*, key)
  let scope = run enclosingScope(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    key.module,
    &module,
    declarationAccess94,
  )
  let mut enclosing = match move scope {
    Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  if let Option<List<Argument>>.Some {value: arguments} = move supplied {
    let bound = run bindSupplied(
      &resolver.*,
      &module,
      value.span,
      List<Binder>.asSlice(&enclosing),
      List<Argument>.asSlice(&arguments),
    )
    match move bound {
      Result<List<Binder>, Shared<Rejection>>.Success {value: applied} => {
        enclosing = move applied
      }
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
  }
  if let Option<Application>.Some {..} = &application.* {
    let values = List<Binder>.asMutSlice(&mut enclosing)
    let mut at = usize.ZERO
    while at < values.length {
      values[at] = run applyBinderEnvironment(&values[at], contextBindings)
      at = at + usize.ONE
    }
  }
  let visible = List<Binder>.asSlice(&enclosing)
  // An inherent member may restate an owner binder to add bounds for that member alone; the
  // restated binder keeps the owner's identity. Elsewhere a restated spelling stays unsupported.
  let declarationAccess95 = declarationPosition(&resolver.*, key)
  let refines = run refinesEnclosing(&mut resolver.*, &module, declarationAccess95)
  let conflict = run scopedBinderRejection(
    &mut resolver.*,
    &module,
    value.generics,
    visible,
    hasBinder(visible, b"Self"),
    refines,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let mut own = List<Binder>.make()
  let mut ownAt = usize.ZERO
  while ownAt < ownCount {
    let restated = run restatedBinder(&binders, ownAt, visible, refines)
    if let Option<Binder>.Some {value: binder} = move restated {
      List<Binder>.set(&mut binders, ownAt, move binder)
    } else {
      if let Option<Application>.Some {..} = &application.* {
        let found = run binderAt(&binders, ownAt)
        List<Binder>.set(&mut binders, ownAt, run applyBinderEnvironment(&found, contextBindings))
      }
      run List<Binder>.append(&mut own, run binderAt(&binders, ownAt))
    }
    ownAt = ownAt + usize.ONE
  }
  let lists = run parametersOf(List<Binder>.asSlice(&own))
  let mut visibleAt = usize.ZERO
  while visibleAt < visible.length {
    run List<Binder>.append(&mut binders, run copyBinder(&visible[visibleAt]))
    visibleAt = visibleAt + usize.ONE
  }
  let mut lifetimeParameters = move lists.lifetimes
  let declarationAccess96 = declarationPosition(&resolver.*, key)
  let ownerBounds = run inherentMemberPremises(&mut resolver.*, &mut owner.*, &mut dependencies,
    key.module, &module, declarationAccess96, visible, value.span)
  let ownerPremises = match move ownerBounds {
    Result<List<Constraint>, Shared<Rejection>>.Success {value: derivedPremises} => move derivedPremises
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let declarationAccess97 = declarationPosition(&resolver.*, key)
  let lexical = run enclosingFunctionPremises(&mut resolver.*, &mut owner.*, &mut dependencies,
    key.module, &module, declarationAccess97, contextBindings, value.span)
  let lexicalPremises = match move lexical {
    Result<List<Constraint>, Shared<Rejection>>.Success {value: found} => move found
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let mut elisionPremises = run copyConstraints(List<Constraint>.asSlice(&ownerPremises))
  run appendConstraints(&mut elisionPremises, List<Constraint>.asSlice(&lexicalPremises))
  // A member's types are well formed under its implementation head's bounds, as its body is, so
  // `impl<T: Read> Read for Wrapper<T>` may spell `Wrapper<T>` in a member signature. An operation
  // of an interface or service may likewise assume `Self` provides it, as in `-> Values<Self>`.
  // These are assumptions of the authored signature only; they are not its constraints.
  let mut memberAssumptions = List<Constraint>.make()
  if boundsPhase == BoundPhase.Authored {
    let declarationAccessHead = declarationPosition(&resolver.*, key)
    let headFailure = run appendHeadBounds(&mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module,
      declarationAccessHead, true, &mut memberAssumptions)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move headFailure {
      return run memberRejected(move diagnostic, move dependencies)
    }
    run appendContractSelfBound(&mut resolver.*, &module, declarationAccessHead, &mut memberAssumptions)
  }
  run appendConstraints(&mut elisionPremises, List<Constraint>.asSlice(&memberAssumptions))
  // Under an application, a lifetime a bound elides takes the application's argument for its
  // ordinal, so a call proves the declaration's bounds exactly as that application instantiates
  // them, such as the inferred environment of `F: once fn(&mut T) -> ()`.
  let mut boundSupplied = Option<List<Argument>>.none()
  if let Option<List<Argument>>.Some {value: arguments} = &ownSupplied {
    boundSupplied = Option<List<Argument>>.some(run copyArguments(List<Argument>.asSlice(&arguments)))
  } else {
    if let Option<Application>.Some {..} = &application.* {
      boundSupplied = Option<List<Argument>>.some(run appliedOwnArguments(contextBindings, &signatureOwner))
    }
  }
  // A `where` clause's requirement-row memberships are premises of the whole signature, so the
  // applied bounds' own head obligations may rely on them; they are read ahead in a scratch
  // elision and the clause is resolved again below in its own order.
  if value.constraints.length > usize.ZERO {
    let mut scratch = LifetimeElision {
      owner: Option<DeclarationId>.some(DeclarationId.copy(&signatureOwner)),
      nextOrdinal: ownCount,
      output: false,
      resultDefault: Option<Shared<Lifetime>>.none(),
      generated: List<Shared<Lifetime>>.make(),
      invocation: false,
      nested: false,
      renumber: List<usize>.make(),
      staticEnvironment: false,
      supplied: Option<List<Argument>>.none(),
      assumptions: Option<List<Constraint>>.some(run copyConstraints(List<Constraint>.asSlice(&ownerPremises))),
      deferred: Option<List<DeferredBounds>>.some(List<DeferredBounds>.make()),
    }
    let mut clauses = List<Constraint>.make()
    let ignored = run declareProviders(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, &module,
      value.constraints, List<Binder>.asSlice(&binders), &mut scratch, &mut clauses)
    drop ignored
    let read = List<Constraint>.asSlice(&clauses)
    let mut readAt = usize.ZERO
    while readAt < read.length {
      if let Constraint.RequirementSubset {..} = &read[readAt] {
        run List<Constraint>.append(&mut elisionPremises, copyConstraint(&read[readAt]))
      }
      readAt = readAt + usize.ONE
    }
  }
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.some(DeclarationId.copy(&signatureOwner)),
    nextOrdinal: ownCount,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: move boundSupplied,
    assumptions: Option<List<Constraint>>.some(move elisionPremises),
    deferred: Option<List<DeferredBounds>>.some(List<DeferredBounds>.make()),
  }
  let declared = run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    key.module,
    &module,
    value.generics,
    List<Binder>.asSlice(&binders),
    &mut elision,
    publicExposure,
    boundsPhase,
  )
  elision.supplied = move ownSupplied
  let mut constraints = match move declared {
    Result<List<Constraint>, Shared<Rejection>>.Success {value: found} => move found
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  let inheritedStart = List<Constraint>.length(&constraints)
  let inherited = List<Constraint>.asSlice(&ownerPremises)
  let mut inheritedAt = usize.ZERO
  while inheritedAt < inherited.length {
    run List<Constraint>.append(&mut constraints, copyConstraint(&inherited[inheritedAt]))
    inheritedAt = inheritedAt + usize.ONE
  }
  let inheritedEnd = List<Constraint>.length(&constraints)
  let providers = run declareProviders(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    key.module,
    &module,
    value.constraints,
    List<Binder>.asSlice(&binders),
    &mut elision,
    &mut constraints,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move providers {
    return run memberRejected(move diagnostic, move dependencies)
  }
  let mut premises = run copyConstraints(List<Constraint>.asSlice(&constraints))
  run appendConstraints(&mut premises, List<Constraint>.asSlice(&lexicalPremises))
  run appendConstraints(&mut premises, List<Constraint>.asSlice(&memberAssumptions))
  let deferredFailure = run proveDeferredBounds(&mut resolver.*, &mut owner.*, &mut dependencies, &mut elision, &premises)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move deferredFailure {
    return run memberRejected(move diagnostic, move dependencies)
  }
  elision.assumptions = Option<List<Constraint>>.some(move premises)
  // Under an application the signature's types are its authored types with the application
  // substituted. The authored signature proved their bounds from its own constraints, and whoever
  // applies it proves those, so a bound a type applies here is not proven again: its premises,
  // such as a caller's `T: Domain` or an implementation head's `T: Read`, live with that consumer.
  if boundsPhase == BoundPhase.Application {
    elision.deferred = Option<List<DeferredBounds>>.some(List<DeferredBounds>.make())
  }
  let representations = run representationsOf(
    &signatureOwner,
    ownCount,
    List<Constraint>.asSlice(&constraints),
  )
  let mut environment = Option<Intersection>.none()
  if value.environment.present {
    let written = run writtenEnvironment(
      &mut resolver.*,
      &module,
      value.environment.range,
      value.span,
      List<Binder>.asSlice(&binders),
    )
    match move written {
      Result<Intersection, Shared<Rejection>>.Success {value: region} => {
        environment = Option<Intersection>.some(move region)
      }
      Result<Intersection, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
  }
  let mut parameters = List<Shared<Type>>.make()
  let mut inputCount = usize.ZERO
  let mut inputLifetime = Option<Shared<Lifetime>>.none()
  let mut receiverLifetime = Option<Shared<Lifetime>>.none()
  // The regions every input would retain if captured, and the first input whose stored contents
  // are unknown because they involve a type parameter without a representation contract.
  let mut retained = List<Shared<Lifetime>>.make()
  let mut hasUnknown = false
  let mut unknownSpan = Span.make(usize.ZERO, usize.ZERO)
  let mut unknownInputs = List<Shared<Type>>.make()
  let entries = List<HirId>.asSlice(&value.parameters)
  let mut at = usize.ZERO
  while at < entries.length {
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      entries[at],
      List<Binder>.asSlice(&binders),
      &mut elision,
    )
    let ty = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: parameter} => move parameter
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    let existential = run existentialRejection(&mut resolver.*, &module, entries[at], &ty)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let exposure = run exposedPrivate(
      &mut resolver.*,
      &module,
      entries[at],
      &ty,
      publicExposure)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
      return run memberRejected(move diagnostic, move dependencies)
    }
    if foreignLanes && (exportedLanes || !Shared<Type>.with<bool>(&ty, targetLane)) {
      let laneSpan = run parameterSpanOr(&mut resolver.*, &module, entries[at], value.span)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run foreignTypeGap(&mut resolver.*, &module, &ty, laneSpan) {
        return run memberRejected(move diagnostic, move dependencies)
      }
    }
    if exportedLanes {
      let laneSpan = run parameterSpanOr(&mut resolver.*, &module, entries[at], value.span)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run foreignVectorRejection(&resolver.*, &module, &ty, laneSpan) {
        return run memberRejected(move diagnostic, move dependencies)
      }
    }
    let outer = Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, outerLifetime)
    if let Option<Shared<Lifetime>>.Some {value: lifetime} = move outer {
      if let Option<usize>.Some {value: receiver} = &value.receiver {
        if at == receiver {
          receiverLifetime = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime))
        }
      }
      inputCount = inputCount + usize.ONE
      inputLifetime = Option<Shared<Lifetime>>.some(move lifetime)
    }
    let known = run Type.retainedRegions(
      &ty,
      &signatureOwner,
      List<Option<Shared<Type>>>.asSlice(&representations),
      &mut retained, false,
    )
    if !known && !hasUnknown {
      hasUnknown = true
      unknownSpan = run parameterSpanOr(&mut resolver.*, &module, entries[at], unknownSpan)
    }
    if !known { run List<Shared<Type>>.append(&mut unknownInputs, Shared<Type>.clone(&ty)) }
    run List<Shared<Type>>.append(&mut parameters, move ty)
    at = at + usize.ONE
  }
  // A named `effect fn` capturing an input whose stored contents involve a type parameter retains
  // them for a region no written lifetime names. It elaborates one more lifetime binder for them,
  // as an elided input lifetime does, bounded by each such input's contents (`A: 'env`): exactly
  // `effect<'env> fn f<A: 'env, 'env>`, except that the environment still meets every other input's
  // regions. The body assumes the bounds and every call proves them.
  let ownerKind = DeclarationId.kind(&signatureOwner)
  if value.isEffect && !value.environment.present && hasUnknown && ownerKind != OwnerKind.EffectBlock
    && ownerKind != OwnerKind.Anonymous {
    let contents = match move run elidedLifetime(&mut resolver.*, &module, unknownSpan, &mut elision) {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: region} => move region
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
    }
    // Bounds are resolved as the application instantiates them (`boundSupplied` above).
    let applied = run Type.applyLifetimeBindings(&contents, contextBindings)
    let inputs = List<Shared<Type>>.asSlice(&unknownInputs)
    let mut inputAt = usize.ZERO
    while inputAt < inputs.length {
      let bound = Constraint.Contents {subject: run Type.applyBindings(&inputs[inputAt], contextBindings, true),
        region: Shared<Lifetime>.clone(&applied)}
      if let Option<List<Constraint>>.Some {value: assumed} = &mut elision.assumptions {
        run List<Constraint>.append(&mut assumed, copyConstraint(&bound))
      }
      run List<Constraint>.append(&mut constraints, move bound)
      inputAt = inputAt + usize.ONE
    }
    run List<Shared<Lifetime>>.append(&mut retained, move contents)
    hasUnknown = false
  }
  let mut result = run Types.intern(Type.Unit)
  elision.output = true
  // An `effect fn` captures every input, so its omitted environment is the intersection of the
  // regions its inputs retain: borrows, nominal lifetime arguments, and callable or Effect
  // environments, including a representation parameter's contract environment; `'static` when
  // they retain none. A callable's or Effect's channels are not stored; stored contents involving
  // any other type parameter retain the binder elaborated for them above. An anonymous `effect fn`
  // has no binder to elaborate, so its environment must be written. An effect block instead
  // derives its intersection from its capture validity and the inputs it retains; generic contents
  // keep their own outlives obligations.
  if value.isEffect && !value.environment.present {
    if hasUnknown && DeclarationId.kind(&signatureOwner) != OwnerKind.EffectBlock {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.AmbiguousLifetime, unknownSpan),
        move dependencies,
      )
    }
    environment = Option<Intersection>.some(
      run Intersection.of(List<Shared<Lifetime>>.asSlice(&retained)),
    )
  }
  // LIFE-003 gives the authored receiver's outer borrow precedence over every other input.
  // Stored regions of a by-value receiver are not an outer borrow and supply no such default.
  if let Option<Shared<Lifetime>>.Some {value: lifetime} = move receiverLifetime {
    elision.resultDefault = Option<Shared<Lifetime>>.some(move lifetime)
  } else {
    if inputCount == usize.ONE { elision.resultDefault = move inputLifetime }
  }
  // Inputs that retain nothing give an ordinary function's omitted `Effect` result environment
  // nothing to retain. An `effect fn` success type gets no such default. Otherwise the
  // established elision applies.
  let closed = !value.isEffect && !hasUnknown && List<Shared<Lifetime>>.length(&retained) == usize.ZERO
  if let Option<HirId>.Some {value: id} = &value.result {
    if closed {
      elision.staticEnvironment = run effectResult(
        &mut resolver.*,
        &module,
        id,
        List<Binder>.asSlice(&binders),
      )
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      id,
      List<Binder>.asSlice(&binders),
      &mut elision,
    )
    let ty = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: resolvedType} => move resolvedType
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        // With no borrowed input at all, the likely fix is `'static`, which SEM0210's second
        // template names, as in `fn noun() -> string { return "task" }`.
        let noInput = inputCount == usize.ZERO && Shared<Rejection>.with<bool>(&error, fn(value: &Rejection) -> bool {
          return value.code == RejectionCode.AmbiguousLifetime
        })
        if noInput {
          let mut diagnostic = run makeRejection(RejectionCode.AmbiguousLifetime, &module, rejectionSpan(&error))
          diagnostic.arguments = List<MessageArgument>.make()
          // A callable result's environment is the borrow; its fix is `fn<'static>`, the third template.
          let mut choice = b"1"
          if let Option<HeaderSyntax>.Some {value: syntax} = move run typeNode(&mut resolver.*, &module, id) {
            if let Node.CallableType {..} = syntax.header { choice = b"2" }
          }
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
          return run memberRejected(run Shared<Rejection>.make(move diagnostic), move dependencies)
        }
        return run memberRejected(move error, move dependencies)
      }
    }
    let existential = run existentialRejection(&mut resolver.*, &module, id, &ty)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
      return run memberRejected(move diagnostic, move dependencies)
    }
    let exposure = run exposedPrivate(&mut resolver.*, &module, id, &ty, publicExposure)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
      return run memberRejected(move diagnostic, move dependencies)
    }
    if foreignLanes && (exportedLanes || !Shared<Type>.with<bool>(&ty, targetLane)) {
      let laneSpan = run parameterSpanOr(&mut resolver.*, &module, id, value.span)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run foreignTypeGap(&mut resolver.*, &module, &ty, laneSpan) {
        return run memberRejected(move diagnostic, move dependencies)
      }
    }
    if exportedLanes {
      let laneSpan = run parameterSpanOr(&mut resolver.*, &module, id, value.span)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run foreignVectorRejection(&resolver.*, &module, &ty, laneSpan) {
        return run memberRejected(move diagnostic, move dependencies)
      }
    }
    result = move ty
  }
  if value.failures.present && !value.isEffect {
    let syntax = run typeNode(&mut resolver.*, &module, value.failures.id)
    if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
      return run memberRejected(
        run channelOnOrdinaryRejection(&module, channel.span, value.isTest, b"failures"),
        move dependencies,
      )
    }
  }
  if value.requirements.present && !value.isEffect {
    let syntax = run typeNode(&mut resolver.*, &module, value.requirements.id)
    if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
      return run memberRejected(
        run channelOnOrdinaryRejection(&module, channel.span, value.isTest, b"requirements"),
        move dependencies,
      )
    }
  }
  let resolvedChannels = run resolveChannels(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    key.module,
    &module,
    value.failures,
    value.requirements,
    List<Binder>.asSlice(&binders),
    &mut elision,
  )
  let channels = match move resolvedChannels {
    Result<Channels, Shared<Rejection>>.Success {value: found} => move found
    Result<Channels, Shared<Rejection>>.Failure {error} => {
      return run memberRejected(move error, move dependencies)
    }
  }
  if value.failures.present {
    let exposure = run exposedPrivate(
      &mut resolver.*,
      &module,
      value.failures.id,
      &channels.failure,
      publicExposure,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
      return run memberRejected(move diagnostic, move dependencies)
    }
  }
  if publicExposure {
    let exposure = Shared<Row>.with<Option<RejectionCode>>(&channels.requirements, privateRow)
    if let Option<RejectionCode>.Some {value: code} = move exposure {
      let syntax = run typeNode(&mut resolver.*, &module, value.requirements.id)
      if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
        return run memberRejected(
          run reject(&resolver.*, &module, code, channel.span),
          move dependencies,
        )
      }
    }
  }
  // Descriptors and sequences exist only during static evaluation; runtime contracts cannot
  // carry either family at any depth in inputs, results, failures or requirements, including
  // through the fields of a struct or tuple that holds one (STATIC-009).
  if !value.isStatic {
    let mut found = false
    let mut phaseSpan = value.span
    let mut operation: &[u8] = b""
    let declared = List<Shared<Type>>.asSlice(&parameters)
    let mut phaseAt = usize.ZERO
    while phaseAt < declared.length {
      if !isStaticIndex(List<usize>.asSlice(&value.staticSlots), phaseAt)
        && run phaseOnlyType(&mut resolver.*, &mut owner.*, &mut dependencies, &declared[phaseAt], value.span) {
        // The bootstrap reports the whole authored `name: Type` parameter.
        phaseSpan = List<Span>.asSlice(&value.parameterSpans)[phaseAt]
        operation = b"runtime parameter with a phase-only type"
        found = true
        break
      }
      phaseAt = phaseAt + usize.ONE
    }
    if !found {
      if run phaseOnlyType(&mut resolver.*, &mut owner.*, &mut dependencies, &result, value.span) {
        let mut site = value.span
        if let Option<HirId>.Some {value: phaseResult} = &value.result {
          let authored = run typeNode(&mut resolver.*, &module, phaseResult)
          if let Option<HeaderSyntax>.Some {value: syntax} = move authored { site = syntax.span }
        }
        phaseSpan = site
        operation = b"runtime return with a phase-only type"
        found = true
      }
    }
    if !found {
      if run phaseOnlyType(&mut resolver.*, &mut owner.*, &mut dependencies, &channels.failure, value.span) {
        let mut site = value.span
        if value.failures.present {
          let authored = run typeNode(&mut resolver.*, &module, value.failures.id)
          if let Option<HeaderSyntax>.Some {value: syntax} = move authored { site = syntax.span }
        }
        phaseSpan = site
        operation = b"runtime failure with a phase-only type"
        found = true
      }
    }
    if !found {
      if Row.mentionsPhaseOnly(&channels.requirements) {
        let mut site = value.span
        if value.requirements.present {
          let authored = run typeNode(&mut resolver.*, &module, value.requirements.id)
          if let Option<HeaderSyntax>.Some {value: syntax} = move authored { site = syntax.span }
        }
        phaseSpan = site
        found = true
      }
    }
    if found {
      // A runtime declaration is checked before any target is selected; requirement rows have
      // no bootstrap wording and stay code-only.
      let mut diagnostic = run makeRejection(RejectionCode.StaticPhaseViolation, &module, phaseSpan)
      if operation.length > usize.ZERO {
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: run Bytes.copy(operation)})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
      }
      return run memberRejected(run Shared<Rejection>.make(move diagnostic), move dependencies)
    }
  }
  // Resolve retention, elision and exposure against the authored contracts first. Runtime
  // callable parameters then become exact, inferred representation slots after every lifetime.
  let mut callableParameters = List<Shared<Type>>.make()
  let mut callableParameterStart = usize.MAX
  if !value.foreign && !value.isStatic && (!value.isEffect || DeclarationId.kind(&signatureOwner) != OwnerKind.Anonymous)
    && DeclarationId.kind(&signatureOwner) != OwnerKind.EffectBlock {
    let declarationAccess98 = declarationPosition(&resolver.*, key)
    let shared = run headRepresentationSlots(&mut resolver.*, &mut owner.*, &mut dependencies, key.module, &module,
      declarationAccess98, contextBindings, value.span)
    let headSlots = List<CallableParameter.RepresentationSlot>.asSlice(&shared)
    let mut headAt = usize.ZERO
    while headAt < headSlots.length {
      run List<Constraint>.append(&mut constraints, Constraint.Represents {
        parameter: Shared<Type>.clone(&headSlots[headAt].representation), contract: Shared<Type>.clone(&headSlots[headAt].contract)})
      headAt = headAt + usize.ONE
    }
    let mut parameterAt = usize.ZERO
    while parameterAt < List<Shared<Type>>.length(&parameters) {
      let written = List<Shared<Type>>.asSlice(&parameters)
      let authored = Shared<Type>.clone(&written[parameterAt])
      if isStaticIndex(List<usize>.asSlice(&value.staticSlots), parameterAt) {
        parameterAt = parameterAt + usize.ONE
        continue
      }
      let reused = run CallableParameter.representationOf(headSlots, &authored)
      if let Option<Shared<Type>>.Some {value: representation} = move reused {
        List<Shared<Type>>.set(&mut parameters, parameterAt, move representation)
        parameterAt = parameterAt + usize.ONE
        continue
      }
      let reified = run CallableParameter.reify(&authored, &signatureOwner, elision.nextOrdinal)
      if let Option<CallableParameter.CallableParameter>.Some {value: represented} = move reified {
        if callableParameterStart == usize.MAX {
          callableParameterStart = elision.nextOrdinal
        }
        let mut exact = Shared<Type>.clone(&represented.ty)
        if let Option<List<Argument>>.Some {value: suppliedArguments} = &elision.supplied {
          exact = run Type.instantiate(
            &exact,
            &signatureOwner,
            List<Argument>.asSlice(&suppliedArguments),
          )
        }
        List<Shared<Type>>.set(&mut parameters, parameterAt, move exact)
        let slots = List<CallableParameter.RepresentationSlot>.asSlice(&represented.slots)
        let mut slotAt = usize.ZERO
        while slotAt < slots.length {
          let mut representation = Shared<Type>.clone(&slots[slotAt].representation)
          if let Option<List<Argument>>.Some {value: suppliedArguments} = &elision.supplied {
            representation = run Type.instantiate(
              &representation,
              &signatureOwner,
              List<Argument>.asSlice(&suppliedArguments),
            )
          }
          run List<Constraint>.append(
            &mut constraints,
            Constraint.Represents {
              parameter: run Type.applyBindings(&representation, contextBindings, true),
              contract: run Type.applyBindings(&slots[slotAt].contract, contextBindings, true),
            },
          )
          run List<Shared<Type>>.append(&mut callableParameters, Shared<Type>.clone(&slots[slotAt].representation))
          elision.nextOrdinal = elision.nextOrdinal + usize.ONE
          slotAt = slotAt + usize.ONE
        }
      }
      parameterAt = parameterAt + usize.ONE
    }
  }
  let generated = List<Shared<Lifetime>>.asSlice(&elision.generated)
  let mut generatedAt = usize.ZERO
  while generatedAt < generated.length {
    run List<Shared<Lifetime>>.append(
      &mut lifetimeParameters,
      Shared<Lifetime>.clone(&generated[generatedAt]),
    )
    generatedAt = generatedAt + usize.ONE
  }
  let mut typeParameters = List<Shared<Type>>.make()
  let mut allLifetimes = List<Shared<Lifetime>>.make()
  let mut rowParameters = List<RowParameter>.make()
  if refines {
    let declarationAccess99 = declarationPosition(&resolver.*, key)
    run appendOwnerParameters(
      &mut resolver.*,
      &module,
      declarationAccess99,
      List<Shared<Type>>.asSlice(&parameters),
      &result,
      &channels,
      &environment,
      &mut constraints,
      inheritedStart,
      inheritedEnd,
      &mut typeParameters,
      &mut allLifetimes,
      &mut rowParameters,
    )
  }
  let ownTypes = List<Shared<Type>>.asSlice(&lists.types)
  let mut listedAt = usize.ZERO
  while listedAt < ownTypes.length {
    run List<Shared<Type>>.append(&mut typeParameters, Shared<Type>.clone(&ownTypes[listedAt]))
    listedAt = listedAt + usize.ONE
  }
  let implicit = List<Shared<Type>>.asSlice(&callableParameters)
  listedAt = usize.ZERO
  while listedAt < implicit.length {
    run List<Shared<Type>>.append(&mut typeParameters, Shared<Type>.clone(&implicit[listedAt]))
    listedAt = listedAt + usize.ONE
  }
  let ownLifetimes = List<Shared<Lifetime>>.asSlice(&lifetimeParameters)
  listedAt = usize.ZERO
  while listedAt < ownLifetimes.length {
    run List<Shared<Lifetime>>.append(
      &mut allLifetimes,
      Shared<Lifetime>.clone(&ownLifetimes[listedAt]),
    )
    listedAt = listedAt + usize.ONE
  }
  let ownRows = List<RowParameter>.asSlice(&lists.rows)
  listedAt = usize.ZERO
  while listedAt < ownRows.length {
    run List<RowParameter>.append(
      &mut rowParameters,
      RowParameter {
        declaration: Shared<DeclarationId>.clone(&ownRows[listedAt].declaration),
        ordinal: ownRows[listedAt].ordinal,
      },
    )
    listedAt = listedAt + usize.ONE
  }
  // A declared `Effect<...>` result names the finite join of the Effects its body returns
  // (EFF-013): a producer-owned family whose storage is realized like an opaque result's.
  if Shared<Type>.with<bool>(&result, bareEffect) && DeclarationId.kind(&signatureOwner) == OwnerKind.Function
    && run opaqueProducerHasBody(&mut resolver.*, &module, &signatureOwner) {
    let declared = move result
    result = run effectFamily(&signatureOwner, &declared)
  }
  if run Type.containsOpaque(&result, &signatureOwner) {
    let declarationAccess100 = declarationPosition(&resolver.*, key)
  let producer = match &application.* {
      Option<Application>.Some {value: actual} => run Application.copy(&actual)
      Option<Application>.None => run formalOpaqueApplication(&mut resolver.*, &module, declarationAccess100, &signatureOwner,
        List<Shared<Type>>.asSlice(&typeParameters), List<Shared<Lifetime>>.asSlice(&allLifetimes),
        List<RowParameter>.asSlice(&rowParameters))
    }
    result = run Type.finishOpaqueApplication(&result, &producer)
  }
  let mut appliedEnvironment = Option<Intersection>.none()
  if let Option<Intersection>.Some {value: retainedEnvironment} = &environment {
    let members = List<LifetimeMember>.asSlice(&retainedEnvironment.members)
    let mut regions = List<Shared<Lifetime>>.make()
    let mut regionAt = usize.ZERO
    while regionAt < members.length {
      run List<Shared<Lifetime>>.append(&mut regions, run Type.applyLifetimeBindings(&members[regionAt].region, contextBindings),
      )
      regionAt = regionAt + usize.ONE
    }
    appliedEnvironment = Option<Intersection>.some(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions)),
    )
  }
  let mut appliedParameters = List<Shared<Type>>.make()
  let writtenParameters = List<Shared<Type>>.asSlice(&parameters)
  let mut appliedAt = usize.ZERO
  while appliedAt < writtenParameters.length {
    run List<Shared<Type>>.append(&mut appliedParameters, run Type.applyBindings(&writtenParameters[appliedAt], contextBindings, true),
    )
    appliedAt = appliedAt + usize.ONE
  }
  // From the uninstantiated signature, as the body's premises see it: an instantiation never
  // exempts an input the body still assumes, such as a generic `T` applied to a reference.
  let mut environmentExempt = usize.MAX
  if value.environment.present {
    if boundsPhase == BoundPhase.Authored {
      environmentExempt = environmentExemptInput(writtenParameters, serviceOperation(&signatureOwner))
    } else {
      let unapplied = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, key, Span.make(usize.ZERO, usize.ZERO))
      if let Option<SignatureFacts>.Some {value: facts} = move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&unapplied, signatureFacts) {
        environmentExempt = facts.environmentExempt
      }
    }
  }
  let appliedAnswer = Answer {
    outcome: Outcome.Success {
      value: Value.Signature {
        signature: Signature {
          typeParameters: move typeParameters,
          callableParameterStart: callableParameterStart,
          lifetimeParameters: move allLifetimes,
          rowParameters: move rowParameters,
          constraints: move constraints,
          parameters: move appliedParameters,
          result: run Type.applyBindings(&result, contextBindings, true),
          failure: run Type.applyBindings(&channels.failure, contextBindings, true),
          requirements: run Row.applyBindings(&channels.requirements, contextBindings, true),
          isEffect: value.isEffect,
          isVariadic: value.isVariadic,
          isUnsafe: value.isUnsafe,
          isStatic: value.isStatic,
          staticSlots: run copySlots(List<usize>.asSlice(&value.staticSlots)),
          environment: move appliedEnvironment,
          environmentWritten: value.environment.present,
          environmentExempt: environmentExempt,
        },
      },
    },
    dependencies: move dependencies,
  }
  return move appliedAnswer
}

fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option<Shared<Type>>.some(
        Shared<Type>.clone(&signature.result),
      )
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

// The declared failure type; `never` when omitted or unavailable.
effect fn signatureFailure(answer: &Shared<Result<Answer, NoRejection>>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let declared = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(answer, fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
    if let Result<Answer, NoRejection>.Success {value: resolved} = &value.* {
      if let Outcome.Success {value: Value.Signature {signature}} = &resolved.outcome {
        return Option<Shared<Type>>.some(Shared<Type>.clone(&signature.failure))
      }
    }
    return Option<Shared<Type>>.none()
  })
  return match move declared {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => run Types.intern(Type.Union {members: List<Shared<Type>>.make()})
  }
}

// The declared requirement row; empty when omitted or unavailable.
effect fn signatureRequirements(answer: &Shared<Result<Answer, NoRejection>>) -> Shared<Row> ! OutOfMemoryError ? &mut Allocator {
  let declared = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Row>>>(answer, fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Row>> {
    if let Result<Answer, NoRejection>.Success {value: resolved} = &value.* {
      if let Outcome.Success {value: Value.Signature {signature}} = &resolved.outcome {
        return Option<Shared<Row>>.some(Shared<Row>.clone(&signature.requirements))
      }
    }
    return Option<Shared<Row>>.none()
  })
  return match move declared {
    Option<Shared<Row>>.Some {value} => move value
    Option<Shared<Row>>.None => run Shared<Row>.make(Row.empty())
  }
}

// Appends the requirement row of each Effect a value of this type is or holds: through an Effect's
// success value or contract, a callable's result, a nominal's type arguments, a union's members or an
// array's elements. A callable holds the Effect its call produces from what it captures.
effect fn heldEffectRequirements(value: &Shared<Type>, rows: &mut List<Shared<Row>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<Shared<Row>>.Some {value: row} = move Shared<Type>.with<Option<Shared<Row>>>(value, ownEffectRequirements) {
    run List<Shared<Row>>.append(&mut rows.*, move row)
  }
  let count = Shared<Type>.with<usize>(value, heldPartCount)
  let mut at = usize.ZERO
  while at < count {
    let part = Shared<Type>.with<Option<Shared<Type>>>(value, fn(node: &Type) -> Option<Shared<Type>> { return heldPartAt(node, at) })
    if let Option<Shared<Type>>.Some {value: held} = &part {
      run heldEffectRequirements(&held, &mut rows.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// Appends the requirement rows of the Effects the members of each nominal in `value` hold, read from
// the member types instantiated for that nominal's application, so a field typed `Effect<'k; …>`
// counts as well as a type argument. Each application is walked once per signature, which bounds
// the walk over shared and recursive member graphs. A declaration met again inside its own walk under
// another application recurses polymorphically and may grow without bound, so it is not walked again.
// What its members name under the new application differs from what the enclosing walk of that
// declaration finds only through the arguments that differ, so those arguments are `reached` instead.
// A nominal without arguments holds only Effects typed at 'static, which no body loan can reach, so it
// is not walked.
effect fn memberEffectRequirements(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  value: &Shared<Type>, rows: &mut List<Shared<Row>>, reached: &mut List<Shared<Type>>, walked: &mut List<usize>,
  active: &mut List<Shared<Type>>, span: Span) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut nominals = List<Shared<Type>>.make()
  run Type.nominalOccurrences(value, &mut nominals)
  let found = List<Shared<Type>>.asSlice(&nominals)
  let mut at = usize.ZERO
  while at < found.length {
    let named = Shared<Type>.with<Option<DeclarationId>>(&found[at], nominalOf)
    if let Option<DeclarationId>.Some {value: declaration} = move named {
      let kind = DeclarationId.kind(&declaration)
      let moduleOrdinal = declaringModuleOrdinal(&resolver.*, &found[at])
      let generic = Shared<Type>.with<usize>(&found[at], nominalArity) != usize.ZERO
      if generic && (kind == OwnerKind.Struct || kind == OwnerKind.Tuple || kind == OwnerKind.Union) && moduleOrdinal != usize.MAX {
        let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
        let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, &found[at])
        if let Option<usize>.Some {value: declarationOrdinal} = move ordinal {
          let written = run scopedHeader(&mut resolver.*, &declaredModule, declarationOrdinal)
          let count = match move written {
            Option<HeaderSyntax>.Some {value: syntax} => match syntax.header {
              Node.StructHeader {fields, ..} => fields.length
              Node.TupleHeader {elements, ..} => elements.length
              Node.UnionHeader {variants, ..} => variants.length
              _ => usize.ZERO
            }
            Option<HeaderSyntax>.None => usize.ZERO
          }
          let application = run internApplication(&mut resolver.*, &found[at])
          let prior = List<usize>.asSlice(&walked.*)
          let mut seen = usize.ZERO
          let mut fresh = true
          while fresh && seen < prior.length {
            if prior[seen] == application { fresh = false }
            seen = seen + usize.ONE
          }
          let ancestors = List<Shared<Type>>.asSlice(&active.*)
          let mut ancestor = ancestors.length
          while fresh && ancestor > usize.ZERO {
            ancestor = ancestor - usize.ONE
            let enclosing = Shared<Type>.with<Option<DeclarationId>>(&ancestors[ancestor], nominalOf)
            if let Option<DeclarationId>.Some {value: walking} = &enclosing {
              if DeclarationId.equals(&walking, &declaration) {
                run reachChangedArguments(&ancestors[ancestor], &found[at], &mut rows.*, &mut reached.*)
                fresh = false
              }
            }
          }
          if fresh {
            run List<usize>.append(&mut walked.*, application)
            run List<Shared<Type>>.append(&mut active.*, Shared<Type>.clone(&found[at]))
          }
          let mut member = usize.ZERO
          while fresh && member < count {
            let request = Key {
              family: Family.MemberShape, module: moduleOrdinal, name: application,
              declaration: declarationOrdinal, member: member, external: false,
            }
            let shapeKey = run internDeclaration(&mut resolver.*, request)
            let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, shapeKey, span)
            let length = Shared<Result<Answer, NoRejection>>.with<usize>(&shape, shapeLength)
            let mut part = usize.ZERO
            while length != usize.MAX && part < length {
              let stored = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shape,
                fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return shapeTypeAt(answer, part) })
              if let Option<Shared<Type>>.Some {value: held} = &stored {
                run heldEffectRequirements(&held, &mut rows.*)
                run memberEffectRequirements(&mut resolver.*, &mut owner.*, &mut dependencies.*, &held, &mut rows.*, &mut reached.*,
                  &mut walked.*, &mut active.*, span)
              }
              part = part + usize.ONE
            }
            member = member + usize.ONE
          }
          if fresh { drop List<Shared<Type>>.pop(&mut active.*) }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Reaches each argument of `current` that differs from the one `enclosing`, an application of the
// same declaration, has at its position: a type as itself, a row through its services, and a lifetime
// through a place that stores at it.
effect fn reachChangedArguments(enclosing: &Shared<Type>, current: &Shared<Type>, rows: &mut List<Shared<Row>>,
  reached: &mut List<Shared<Type>>) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = nominalArgumentCount(current)
  let mut at = usize.ZERO
  while at < count {
    let before = Shared<Type>.with<Option<Argument>>(enclosing, fn(node: &Type) -> Option<Argument> { return nominalArgument(node, at) })
    let after = Shared<Type>.with<Option<Argument>>(current, fn(node: &Type) -> Option<Argument> { return nominalArgument(node, at) })
    if let Option<Argument>.Some {value: changed} = move after {
      match move changed {
        Argument.Type {value} => {
          let mut same = false
          if let Option<Argument>.Some {value: Argument.Type {value: prior}} = &before { same = run Type.equalsShared(&prior, &value) }
          if !same { run List<Shared<Type>>.append(&mut reached.*, move value) }
        }
        Argument.Lifetime {value} => {
          let mut same = false
          if let Option<Argument>.Some {value: Argument.Lifetime {value: prior}} = &before { same = Lifetime.equalsShared(&prior, &value) }
          if !same {
            let unit = run Types.intern(Type.Unit)
            let held = run Types.intern(Type.Reference {referent: move unit, access: Access.Shared, lifetime: Shared<Lifetime>.clone(&value)})
            run List<Shared<Type>>.append(&mut reached.*, run Types.intern(Type.Reference {referent: move held, access: Access.Mutable, lifetime: move value}))
          }
        }
        Argument.Row {value} => {
          let mut same = false
          if let Option<Argument>.Some {value: Argument.Row {value: prior}} = &before { same = run Row.equalsShared(&prior, &value) }
          if !same { run List<Shared<Row>>.append(&mut rows.*, move value) }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// The requirement row of an Effect type itself, not of the contract it is read through.
fn ownEffectRequirements(value: &Type) -> Option<Shared<Row>> {
  if let Type.Effect {requirements, ..} = &value.* { return Option<Shared<Row>>.some(Shared<Row>.clone(&requirements)) }
  return Option<Shared<Row>>.none()
}

// The parts a value of this type holds that can be an Effect: an Effect's success value, the contract
// of an opaque representation, join or composition, a callable's result, a nominal's type arguments, a
// union's members or an array's element.
fn heldPartCount(value: &Type) -> usize {
  return match &value.* {
    Type.Effect {..} => usize.ONE
    Type.Callable {..} => usize.ONE
    Type.OpaqueRepresentation {..} => usize.ONE
    Type.EffectJoin {..} => usize.ONE
    Type.EffectComposite {..} => usize.ONE
    Type.Nominal {arguments, ..} => List<Argument>.length(&arguments)
    Type.Anonymous {members, ..} => List<Shared<Type>>.length(&members)
    Type.Array {..} => usize.ONE
    _ => usize.ZERO
  }
}

fn heldPartAt(value: &Type, at: usize) -> Option<Shared<Type>> {
  return match &value.* {
    Type.Effect {success, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&success))
    Type.Callable {result, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&result))
    Type.OpaqueRepresentation {contract, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&contract))
    Type.EffectJoin {contract, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&contract))
    Type.EffectComposite {contract, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&contract))
    Type.Nominal {arguments, ..} => {
      let listed = List<Argument>.asSlice(&arguments)
      if let Argument.Type {value: argument} = &listed[at] { return Option<Shared<Type>>.some(Shared<Type>.clone(&argument)) }
      return Option<Shared<Type>>.none()
    }
    Type.Anonymous {members, ..} => {
      let listed = List<Shared<Type>>.asSlice(&members)
      return Option<Shared<Type>>.some(Shared<Type>.clone(&listed[at]))
    }
    Type.Array {element, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&element))
    _ => Option<Shared<Type>>.none()
  }
}

// The requirement row of an Effect type, read through the opaque representation, join or
// composition whose contract it is.
fn effectRequirements(value: &Type) -> Option<Shared<Row>> {
  return match &value.* {
    Type.Effect {requirements, ..} => Option<Shared<Row>>.some(Shared<Row>.clone(&requirements))
    Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<Option<Shared<Row>>>(&contract, effectRequirements)
    Type.EffectJoin {contract, ..} => Shared<Type>.with<Option<Shared<Row>>>(&contract, effectRequirements)
    Type.EffectComposite {contract, ..} => Shared<Type>.with<Option<Shared<Row>>>(&contract, effectRequirements)
    _ => Option<Shared<Row>>.none()
  }
}

// Opens the frame of one body: the channels of its `run` and `fail` sites.
effect fn enterBodyFrame(resolver: &mut Resolver, signature: &Shared<Result<Answer, NoRejection>>, root: bool,
  naming: Option<AuthoredCursor>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let failure = run signatureFailure(signature)
  let requirements = run signatureRequirements(signature)
  let isEffect = Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsEffect)
  let mut own = Option<Shared<Result<Answer, NoRejection>>>.none()
  if root { own = Option<Shared<Result<Answer, NoRejection>>>.some(Shared<Result<Answer, NoRejection>>.clone(signature)) }
  return run List<BodyFrame>.append(&mut resolver.*.bodies, BodyFrame {isEffect: isEffect, isTest: false, failure: move failure,
    requirements: move requirements, derived: Option<DerivedChannels>.none(), occurrences: List<StaticIteration>.make(), staticApplication: Option<Application>.none(), staticPrefixes: List<List<StaticPrefixWork>>.make(), recovered: List<Shared<Rejection>>.make(), failedStatements: List<FailedStatement>.make(), shortened: List<Span>.make(), signature: move own, root: root, runOperand: Option<HirId>.none(), naming: move naming})
}

// The complete proof and diagnostic facts retained when a body frame closes.
struct ClosedBody {
  recovered: List<Shared<Rejection>>,
  shortened: List<Span>,
}

// Closes any body frame without discarding its unresolved result-only calls.
fn closeBodyFrame(resolver: &mut Resolver) -> ClosedBody {
  let popped = List<BodyFrame>.pop(&mut resolver.*.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let BodyFrame {recovered, shortened, ..} = move value
    return ClosedBody {recovered: move recovered, shortened: move shortened}
  }
  return ClosedBody {recovered: List<Shared<Rejection>>.make(), shortened: List<Span>.make()}
}

// Result-only shortening requires a finishing path that refuses publication unless the body is
// fully Checked. Named roots and anonymous functions have that guard; Effect blocks keep their
// existing inference until their own finite-result cases are covered. This does not change the
// frame's root flag, which independently controls lexical diagnostics and declaration premises.
fn finiteResultBodyFrame(resolver: &Resolver, caller: &DeclarationId) -> bool {
  let bodies = List<BodyFrame>.asSlice(&resolver.bodies)
  if bodies.length == usize.ZERO { return false }
  return bodies[bodies.length - usize.ONE].root || DeclarationId.kind(caller) == OwnerKind.Anonymous
}

// Records a call whose result-only binder shortened on the innermost body frame.
effect fn recordShortened(resolver: &mut Resolver, span: Span) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = List<BodyFrame>.pop(&mut resolver.*.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    run List<Span>.append(&mut frame.shortened, span)
    run List<BodyFrame>.append(&mut resolver.*.bodies, move frame)
  }
  return ()
}

// A shortened result can only be published after the complete body proof succeeds. A body no proof
// covers keeps every original call-site refusal.
effect fn shortenedBodyRefusals(resolver: &Resolver, module: &ModuleId, sites: &[Span])
  -> List<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let mut refusals = List<Shared<Rejection>>.make()
  let mut at = usize.ZERO
  while at < sites.length {
    run insertByPosition(&mut refusals, run reject(resolver, module, RejectionCode.UnsatisfiedLifetimeBound, sites[at]))
    at = at + usize.ONE
  }
  return move refusals
}

// Records a diagnostic a construct reported before it went on checking. The construct still fails,
// so the diagnostic reaches the body's rejection. Outside every body frame there is no body to
// report it, and the construct's own failure is the body's only diagnostic.
effect fn recordRecovered(resolver: &mut Resolver, diagnostic: Shared<Rejection>) -> () ! OutOfMemoryError ? &mut Allocator {
  // A read of an unavailable binding is the consequence of a failure already recorded.
  if dependentFailure(&diagnostic) { return () }
  let popped = List<BodyFrame>.pop(&mut resolver.*.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    run List<Shared<Rejection>>.append(&mut frame.recovered, move diagnostic)
    run List<BodyFrame>.append(&mut resolver.*.bodies, move frame)
  }
  return ()
}

// Withdraws `diagnostic` when it is the innermost body's latest recovered diagnostic, so the
// construct that recorded it can fail with it instead.
effect fn takeRecovered(resolver: &mut Resolver, diagnostic: &Shared<Rejection>) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = List<BodyFrame>.pop(&mut resolver.*.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    let listed = List<Shared<Rejection>>.asSlice(&frame.recovered)
    let latest = listed.length != usize.ZERO && sameAllocation<Rejection>(&listed[listed.length - usize.ONE], diagnostic)
    if latest { drop List<Shared<Rejection>>.pop(&mut frame.recovered) }
    run List<BodyFrame>.append(&mut resolver.*.bodies, move frame)
  }
  return ()
}

// Records that the statement at `span` failed and was recovered past, in the innermost body.
effect fn recordFailedStatement(resolver: &mut Resolver, module: &ModuleId, span: Span) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO {
    run List<FailedStatement>.append(&mut frames[frames.length - usize.ONE].failedStatements,
      FailedStatement {module: ModuleId.copy(module), span: span})
  }
  return ()
}

// Whether the binder at `span` lies inside a statement the body being checked recovered past: its
// innermost frames back to the root frame that began it.
fn unavailableBinder(resolver: &Resolver, module: &ModuleId, span: Span) -> bool {
  let frames = List<BodyFrame>.asSlice(&resolver.bodies)
  let mut frame = frames.length
  while frame > usize.ZERO {
    frame = frame - usize.ONE
    let failed = List<FailedStatement>.asSlice(&frames[frame].failedStatements)
    let mut at = usize.ZERO
    while at < failed.length {
      if ModuleId.equals(&failed[at].module, module) && failed[at].span.start <= span.start && span.end <= failed[at].span.end {
        return true
      }
      at = at + usize.ONE
    }
    if frames[frame].root { return false }
  }
  return false
}

// Whether `rejection` is a read of an unavailable binding, which no body reports.
fn dependentFailure(rejection: &Shared<Rejection>) -> bool {
  return Shared<Rejection>.with<bool>(rejection, unavailableRead)
}

fn unavailableRead(rejection: &Rejection) -> bool {
  return rejection.code == RejectionCode.UnavailableBinding
}

// How many static iteration facts the innermost body has retained so far.
fn frameOccurrenceCount(resolver: &Resolver) -> usize {
  let frames = List<BodyFrame>.asSlice(&resolver.bodies)
  if frames.length == usize.ZERO { return usize.ZERO }
  return List<StaticIteration>.length(&frames[frames.length - usize.ONE].occurrences)
}

// Drops the static iteration facts the innermost body retained after the first `count`: those of
// a statement whose check failed.
fn truncateFrameOccurrences(resolver: &mut Resolver, count: usize) {
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO { List<StaticIteration>.truncate(&mut frames[frames.length - usize.ONE].occurrences, count) }
}

// Hands the diagnostics a nested block recovered to the body that encloses it.
effect fn forwardRecovered(resolver: &mut Resolver, recovered: List<Shared<Rejection>>) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Shared<Rejection>>.asSlice(&recovered)
  let mut at = usize.ZERO
  while at < listed.length {
    run recordRecovered(&mut resolver.*, Shared<Rejection>.clone(&listed[at]))
    at = at + usize.ONE
  }
  return ()
}

// The rejection of a body whose check failed: what it recovered, in order, then the failure that
// ended it. A failure that only read an unavailable binding adds nothing: the failure that made
// the binding unavailable was recovered first.
effect fn failedBodyDiagnostics(recovered: List<Shared<Rejection>>, failure: Shared<Rejection>) -> List<Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostics = move recovered
  if dependentFailure(&failure) {
    // The failure that made the binding unavailable was recovered first.
    if List<Shared<Rejection>>.length(&diagnostics) == usize.ZERO {
      return CompilerBug.panic(b"a body failed by reading an unavailable binding and recovered nothing")
    }
    return move diagnostics
  }
  run List<Shared<Rejection>>.append(&mut diagnostics, move failure)
  return move diagnostics
}

fn signatureParameterCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => List<Shared<Type>>.length(
        &signature.parameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureParameterAt(answer: &Result<Answer, NoRejection>, index: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = List<Shared<Type>>.asSlice(&signature.parameters)
        if index < parameters.length {
          return Option<Shared<Type>>.some(Shared<Type>.clone(&parameters[index]))
        }
        return Option<Shared<Type>>.none()
      }
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

fn answerTypedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body}} => Option<Shared<TypedBody>>.some(
        Shared<TypedBody>.clone(&body),
      )
      _ => Option<Shared<TypedBody>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<TypedBody>>.none()
  }
}

fn answerCanonicalizationFailure(answer: &Result<Answer, NoRejection>) -> Option<CanonicalizationFailure> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.CanonicalizationFailed {reason}} => Option<CanonicalizationFailure>.some(reason)
      _ => Option<CanonicalizationFailure>.none()
    }
    _ => Option<CanonicalizationFailure>.none()
  }
}

// Public semantic requests turn neutral cached failure into a fresh source diagnostic. The
// cached answer itself remains unchanged, so another requester supplies its own authentic anchor.
effect fn anchorCanonicalAnswer(resolver: &mut Resolver, answer: &Shared<Result<Answer, NoRejection>>,
  sourceOwner: &DeclarationId, span: Span) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(answer, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {..} = move failure {
    return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(
      run canonicalRejection(&mut resolver.*, sourceOwner, span), List<Dependency>.make())))
  }
  return Shared<Result<Answer, NoRejection>>.clone(answer)
}

fn answerMirIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Mir {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<usize>.none()
  }
}

fn answerEmissionInputsIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.EmissionInputs {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<usize>.none()
  }
}

fn answerLlvmTextIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.LlvmText {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    _ => Option<usize>.none()
  }
}

fn answerBackendGap(answer: &Result<Answer, NoRejection>) -> Option<Shared<BackendGap>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Unsupported {gap}} => Option<Shared<BackendGap>>.some(
        Shared<BackendGap>.clone(&gap),
      )
      _ => Option<Shared<BackendGap>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<BackendGap>>.none()
  }
}

fn answerLayoutIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Layout {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    _ => Option<usize>.none()
  }
}

fn answerLayoutUnsupported(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: selected} => match &selected {
        Value.LayoutUnsupported => true
        _ => false
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn signatureBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => List<Shared<Type>>.length(
        &signature.typeParameters,
      ) + List<Shared<Lifetime>>.length(&signature.lifetimeParameters) + List<
        RowParameter,
      >.length(&signature.rowParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureCallableParameterStart(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      return signature.callableParameterStart
    }
  }
  return usize.MAX
}

// Snapshot one binder handle without retaining a borrow of the cached signature.
union InferenceBinder {
  Type {value: Shared<Type>},
  Lifetime {value: Shared<Lifetime>},
  Row {value: RowParameter},
}

fn inferenceBinderAt(answer: &Result<Answer, NoRejection>, ordinal: usize) -> Option<InferenceBinder> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      // Signature lists group kinds; substitution slots follow the written binder ordinal.
      let types = List<Shared<Type>>.asSlice(&signature.typeParameters)
      let mut at = usize.ZERO
      while at < types.length {
        let found = Shared<Type>.with<usize>(&types[at], fn(ty: &Type) -> usize {
          return match &ty.* { Type.Parameter {ordinal: position, ..} => position _ => usize.MAX }
        })
        if found == ordinal { return Option<InferenceBinder>.some(InferenceBinder.Type {value: Shared<Type>.clone(&types[at])}) }
        at = at + usize.ONE
      }
      let regions = List<Shared<Lifetime>>.asSlice(&signature.lifetimeParameters)
      at = usize.ZERO
      while at < regions.length {
        let found = Shared<Lifetime>.with<usize>(&regions[at], fn(region: &Lifetime) -> usize {
          return match &region.* { Lifetime.Parameter {ordinal: position, ..} => position _ => usize.MAX }
        })
        if found == ordinal { return Option<InferenceBinder>.some(InferenceBinder.Lifetime {value: Shared<Lifetime>.clone(&regions[at])}) }
        at = at + usize.ONE
      }
      let rows = List<RowParameter>.asSlice(&signature.rowParameters)
      at = usize.ZERO
      while at < rows.length {
        if rows[at].ordinal == ordinal { return Option<InferenceBinder>.some(InferenceBinder.Row {value: RowParameter {
          declaration: Shared<DeclarationId>.clone(&rows[at].declaration), ordinal: rows[at].ordinal,
        }}) }
        at = at + usize.ONE
      }
    }
  }
  return Option<InferenceBinder>.none()
}

fn signatureRetainedRegion(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Lifetime>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if let Option<Intersection>.Some {value: environment} = &signature.environment {
        let listed = List<LifetimeMember>.asSlice(&environment.members)
        if at < listed.length { return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&listed[at].region)) }
      }
    }
  }
  return Option<Shared<Lifetime>>.none()
}

effect fn applyConstraintBindings(value: &Constraint, bindings: &[Binding]) -> Constraint
! OutOfMemoryError
? &mut Allocator | &mut Types {
  return match & value.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: run Type.applyBindings(&provider, bindings, true),
      contract: run Type.applyBindings(&contract, bindings, true),
    }
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: run Type.applyBindings(&parameter, bindings, true),
      contract: run Type.applyBindings(&contract, bindings, true),
    }
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: run Type.applyBindings(&subject, bindings, true),
      region: run Type.applyLifetimeBindings(&region, bindings),
    }
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: run Type.applyLifetimeBindings(&longer, bindings),
      shorter: run Type.applyLifetimeBindings(&shorter, bindings),
    }
    Constraint.Copyable {subject} => Constraint.Copyable {
      subject: run Type.applyBindings(&subject, bindings, true),
    }
    Constraint.ThreadSafe {subject, property} => Constraint.ThreadSafe {
      subject: run Type.applyBindings(&subject, bindings, true),
      property: property,
    }
    Constraint.Property {subject, property} => Constraint.Property {
      subject: run Type.applyBindings(&subject, bindings, true),
      property: property,
    }
    Constraint.Provides {provider, selector, source} => Constraint.Provides {
      provider: run Type.applyBindings(&provider, bindings, true),
      selector: run Row.applyBindings(&selector, bindings, true),
      source: run Row.applyBindings(&source, bindings, true),
    }
    Constraint.FailureSubset {selected, source} => Constraint.FailureSubset {
      selected: run Type.applyBindings(&selected, bindings, true),
      source: run Type.applyBindings(&source, bindings, true),
    }
    Constraint.RequirementSubset {selected, source} => Constraint.RequirementSubset {
      selected: run Row.applyBindings(&selected, bindings, true),
      source: run Row.applyBindings(&source, bindings, true),
    }
  }
}

effect fn appendInferenceSlot(
  owner: &DeclarationId,
  slot: &ApplicationSlot,
  fresh: &DeclarationId,
  dense: usize,
  types: &mut List<Shared<Type>>,
  lifetimes: &mut List<Shared<Lifetime>>,
  rows: &mut List<RowParameter>,
  bindings: &mut List<Binding>,
) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let argument = run scopeArgument(fresh, dense, slot.kind)
  match & argument {
    Argument.Type {value} => {
      run List<Shared<Type>>.append(&mut types.*, Shared<Type>.clone(&value))
    }
    Argument.Lifetime {value} => {
      run List<Shared<Lifetime>>.append(&mut lifetimes.*, Shared<Lifetime>.clone(&value))
    }
    Argument.Row {..} => {
      run List<RowParameter>.append(
        &mut rows.*,
        RowParameter {
          declaration: run Shared<DeclarationId>.make(DeclarationId.copy(fresh)),
          ordinal: dense,
        },
      )
    }
  }
  run List<Binding>.append(
    &mut bindings.*,
    Binding {
      declaration: run Shared<DeclarationId>.make(DeclarationId.copy(owner)),
      ordinal: slot.ordinal,
      value: move argument,
    },
  )
  return ()
}

// This transformation has no query/resolver calls. Fresh identities exist only in local owned
// handles and unification bindings, never in query interning, caches or backend instance keys.
// A call whose scope arguments are already applied, such as a receiver call or `Owner<'a>.member`,
// opens only the member's own binders. A scope slot its applied signature still lists is the
// caller's own binder, as for a sibling member called inside a generic impl, never a variable.
effect fn callInferenceSignature(
  resolver: &Resolver,
  signature: &Shared<Result<Answer, NoRejection>>,
  schema: &TargetSchema,
  fresh: &DeclarationId,
  scopesApplied: bool,
  module: &ModuleId,
  span: Span,
) -> Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(signature, signatureFacts,
  ) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let mut types = List<Shared<Type>>.make()
  let mut lifetimes = List<Shared<Lifetime>>.make()
  let mut rows = List<RowParameter>.make()
  let mut remappedBindings = List<Binding>.make()
  let mut callableParameterStart = usize.MAX
  let mut at = usize.ZERO
  let scopes = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut scopeAt = usize.ZERO
  if scopesApplied { scopeAt = scopes.length }
  while scopeAt < scopes.length {
    let scopeOwner = DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = List<ApplicationSlot>.asSlice(&scopes[scopeAt].slots)
    let mut slotAt = usize.ZERO
    while slotAt < slots.length {
      if Shared<Result<Answer, NoRejection>>.with<bool>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(answer, &scopeOwner, slots[slotAt]) }) {
        run appendInferenceSlot(
          &scopeOwner,
          &slots[slotAt],
          fresh,
          at,
          &mut types,
          &mut lifetimes,
          &mut rows,
          &mut remappedBindings,
        )
        at = at + usize.ONE
      }
      slotAt = slotAt + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  let ownOwner = DeclarationId.copyShared(&schema.declaration)
  let own = List<ApplicationSlot>.asSlice(&schema.own)
  let mut ownAt = usize.ZERO
  while ownAt < own.length {
    if own[ownAt].ordinal == facts.callableParameterStart {
      callableParameterStart = at
    }
    run appendInferenceSlot(
      &ownOwner,
      &own[ownAt],
      fresh,
      at,
      &mut types,
      &mut lifetimes,
      &mut rows,
      &mut remappedBindings,
    )
    at = at + usize.ONE
    ownAt = ownAt + usize.ONE
  }
  return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.succeed(
    run applyCallInferenceSignature(signature, &facts, move types, move lifetimes, move rows,
      callableParameterStart, List<Binding>.asSlice(&remappedBindings)))
}

// Whether resolving an `effect fn` with an elaborated environment again under `bindings` gives
// the environment and bounds that substituting into `generic` gave in `substituted`. The header's
// elaboration reads each input's stored contents: an input whose contents are generic is bounded
// by the elaborated region, and every other input adds the regions it retains. So both agree when
// each input's contents are generic in the applied signature exactly when they are in the generic
// one, and every other input retains the substituted regions.
effect fn elaboratedEnvironmentHolds(generic: &Shared<Result<Answer, NoRejection>>, facts: &SignatureFacts,
  substituted: &Answer, owner: &DeclarationId, bindings: &[Binding]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let kind = DeclarationId.kind(owner)
  if kind == OwnerKind.EffectBlock || kind == OwnerKind.Anonymous { return false }
  if let Outcome.Success {value: Value.Signature {signature: applied}} = &substituted.outcome {
    // Representations are declared on written binders, which precede the implicit callable ones.
    let mut binders = facts.binders
    if facts.callableParameterStart != usize.MAX { binders = facts.callableParameterStart }
    let mut declared = List<Constraint>.make()
    let mut at = usize.ZERO
    while at < facts.constraints {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(generic,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
      if let Option<Constraint>.Some {value} = move bound { run List<Constraint>.append(&mut declared, move value) }
      at = at + usize.ONE
    }
    let genericRepresentations = run representationsOf(owner, binders, List<Constraint>.asSlice(&declared))
    let appliedRepresentations = run representationsOf(owner, binders, List<Constraint>.asSlice(&applied.constraints))
    let inputs = List<Shared<Type>>.asSlice(&applied.parameters)
    if inputs.length != facts.parameters { return false }
    at = usize.ZERO
    while at < inputs.length {
      let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(generic,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
      let written = match move parameter {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { return false }
      }
      let mut retained = List<Shared<Lifetime>>.make()
      let known = run Type.retainedRegions(&written, owner, List<Option<Shared<Type>>>.asSlice(&genericRepresentations),
        &mut retained, false)
      let mut kept = List<Shared<Lifetime>>.make()
      let keeps = run Type.retainedRegions(&inputs[at], owner, List<Option<Shared<Type>>>.asSlice(&appliedRepresentations),
        &mut kept, false)
      if known != keeps { return false }
      let generics = List<Shared<Lifetime>>.asMutSlice(&mut retained)
      let mut region = usize.ZERO
      while region < generics.length {
        generics[region] = run Type.applyLifetimeBindings(&generics[region], bindings)
        region = region + usize.ONE
      }
      let expected = run Intersection.of(List<Shared<Lifetime>>.asSlice(&retained))
      let found = run Intersection.of(List<Shared<Lifetime>>.asSlice(&kept))
      if !sameRegionMembers(List<LifetimeMember>.asSlice(&expected.members), List<LifetimeMember>.asSlice(&found.members)) {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

// Whether `left` and `right` hold the same regions, in any order.
fn sameRegionMembers(left: &[LifetimeMember], right: &[LifetimeMember]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    let mut other = usize.ZERO
    while other < right.length && !Lifetime.equalsShared(&left[at].region, &right[other].region) { other = other + usize.ONE }
    if other == right.length { return false }
    at = at + usize.ONE
  }
  return true
}

// Rebuild signature contents while retaining the binder lists and their dense coordinates.
effect fn applyCallInferenceSignature(signature: &Shared<Result<Answer, NoRejection>>, facts: &SignatureFacts,
  types: List<Shared<Type>>, lifetimes: List<Shared<Lifetime>>, rows: List<RowParameter>,
  callableParameterStart: usize, mapped: &[Binding]) -> Shared<Result<Answer, NoRejection>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let applied = run substitutedSignature(signature, facts, move types, move lifetimes, move rows, callableParameterStart, mapped)
  return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(move applied))
}

// `signature` with `mapped` substituted into its parameters, bounds, channels and environment,
// under the binder lists given.
effect fn substitutedSignature(signature: &Shared<Result<Answer, NoRejection>>, facts: &SignatureFacts,
  types: List<Shared<Type>>, lifetimes: List<Shared<Lifetime>>, rows: List<RowParameter>,
  callableParameterStart: usize, mapped: &[Binding]) -> Answer
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut parameters = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < facts.parameters {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) },
    )
    if let Option<Shared<Type>>.Some {value} = move parameter {
      run List<Shared<Type>>.append(
        &mut parameters,
        run Type.applyBindings(&value, mapped, true),
      )
    }
    at = at + usize.ONE
  }
  let mut constraints = List<Constraint>.make()
  at = usize.ZERO
  while at < facts.constraints {
    let constraint = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) },
    )
    if let Option<Constraint>.Some {value} = move constraint {
      run List<Constraint>.append(&mut constraints, run applyConstraintBindings(&value, mapped))
    }
    at = at + usize.ONE
  }
  let mut environment = Option<Intersection>.none()
  if facts.environment != usize.MAX {
    let mut regions = List<Shared<Lifetime>>.make()
    at = usize.ZERO
    while at < facts.environment {
      let region = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureRetainedRegion(answer, at) },
      )
      if let Option<Shared<Lifetime>>.Some {value} = move region {
        run List<Shared<Lifetime>>.append(
          &mut regions,
          run Type.applyLifetimeBindings(&value, mapped),
        )
      }
      at = at + usize.ONE
    }
    environment = Option<Intersection>.some(
      run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions)),
    )
  }
  let result = run Type.applyBindings(&facts.result, mapped, true)
  let failure = run Type.applyBindings(&facts.failure, mapped, true)
  let requirements = run Row.applyBindings(&facts.requirements, mapped, true)
  let applied = memberSuccess(
    Value.Signature {
      signature: Signature {
        typeParameters: move types,
        callableParameterStart: callableParameterStart,
        lifetimeParameters: move lifetimes,
        rowParameters: move rows,
        constraints: move constraints,
        parameters: move parameters,
        result: move result,
        failure: move failure,
        requirements: move requirements,
        isEffect: facts.isEffect,
        isVariadic: facts.isVariadic,
        isUnsafe: facts.isUnsafe,
        isStatic: facts.isStatic,
        staticSlots: run signatureStaticSlots(signature, facts.staticSlots),
        environment: move environment,
        environmentWritten: facts.environmentWritten,
        environmentExempt: facts.environmentExempt,
      },
    },
    List<Dependency>.make(),
  )
  return move applied
}

// Explicit types are fixed before operand inference, so their omitted regions are visible even
// behind an ordinary type parameter. Extra binders are private to this call and follow every
// original scope/own slot; they are never coordinates in a target application.
effect fn callPrefixInferenceSignature(original: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  extra: usize, fixed: &[Binding]) -> Shared<Result<Answer, NoRejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(original, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { fail RevisionMismatch {} }
  }
  let mut types = List<Shared<Type>>.make()
  let mut lifetimes = List<Shared<Lifetime>>.make()
  let mut rows = List<RowParameter>.make()
  let mut at = usize.ZERO
  while at < facts.binders {
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<InferenceBinder>>(original,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => { run List<Shared<Type>>.append(&mut types, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {value}} => { run List<Shared<Lifetime>>.append(&mut lifetimes, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => { run List<RowParameter>.append(&mut rows, move value) }
      _ => { fail RevisionMismatch {} }
    }
    at = at + usize.ONE
  }
  let mut generated = usize.ZERO
  while generated < extra {
    run List<Shared<Lifetime>>.append(&mut lifetimes, run Shared<Lifetime>.make(Lifetime.Parameter {
      declaration: DeclarationId.copy(fresh), ordinal: facts.binders + generated}))
    generated = generated + usize.ONE
  }
  return run applyCallInferenceSignature(original, &facts, move types, move lifetimes, move rows,
    facts.callableParameterStart, fixed)
}

effect fn typeMentionsOwner(value: &Shared<Type>, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  return List<usize>.length(&types) > usize.ZERO || List<usize>.length(&lifetimes) > usize.ZERO || List<usize>.length(&rows) > usize.ZERO
}

effect fn argumentMentionsOwner(value: &Argument, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  match &value.* {
    Argument.Type {value: ty} => { run Type.collectOwned(&ty, owner, &mut types, &mut lifetimes, &mut rows) }
    Argument.Lifetime {value: region} => { run Type.collectOwnedLifetime(&region, owner, &mut lifetimes) }
    Argument.Row {value: row} => { run Type.collectOwnedRow(&row, owner, &mut types, &mut lifetimes, &mut rows) }
  }
  return List<usize>.length(&types) > usize.ZERO || List<usize>.length(&lifetimes) > usize.ZERO || List<usize>.length(&rows) > usize.ZERO
}

effect fn constraintMentionsOwner(value: &Constraint, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  return match &value.* {
    Constraint.Conforms {provider, contract} => (run typeMentionsOwner(&provider, owner)) || (run typeMentionsOwner(&contract, owner))
    Constraint.Represents {parameter, contract} => (run typeMentionsOwner(&parameter, owner)) || (run typeMentionsOwner(&contract, owner))
    Constraint.Contents {subject, region} => (run typeMentionsOwner(&subject, owner)) || (run argumentMentionsOwner(&Argument.Lifetime {value: Shared<Lifetime>.clone(&region)}, owner))
    Constraint.Outlives {longer, shorter} => (run argumentMentionsOwner(&Argument.Lifetime {value: Shared<Lifetime>.clone(&longer)}, owner)) || (run argumentMentionsOwner(&Argument.Lifetime {value: Shared<Lifetime>.clone(&shorter)}, owner))
    Constraint.Copyable {subject} => run typeMentionsOwner(&subject, owner)
    Constraint.ThreadSafe {subject, ..} => run typeMentionsOwner(&subject, owner)
    Constraint.Property {subject, ..} => run typeMentionsOwner(&subject, owner)
    Constraint.Provides {provider, selector, source} => (run typeMentionsOwner(&provider, owner)) || (run argumentMentionsOwner(&Argument.Row {value: Shared<Row>.clone(&selector)}, owner)) || (run argumentMentionsOwner(&Argument.Row {value: Shared<Row>.clone(&source)}, owner))
    Constraint.FailureSubset {selected, source} => (run typeMentionsOwner(&selected, owner)) || (run typeMentionsOwner(&source, owner))
    Constraint.RequirementSubset {selected, source} => (run argumentMentionsOwner(&Argument.Row {value: Shared<Row>.clone(&selected)}, owner)) || (run argumentMentionsOwner(&Argument.Row {value: Shared<Row>.clone(&source)}, owner))
  }
}

fn signatureTypeParameterCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => List<Shared<Type>>.length(
        &signature.typeParameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureTypeParameter(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let listed = List<Shared<Type>>.asSlice(&signature.typeParameters)
        if at < listed.length {
          return Option<Shared<Type>>.some(Shared<Type>.clone(&listed[at]))
        }
        return Option<Shared<Type>>.none()
      }
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

fn signatureNonLifetimeBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => List<Shared<Type>>.length(
        &signature.typeParameters,
      ) + List<RowParameter>.length(&signature.rowParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureConstraintCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => List<Constraint>.length(
        &signature.constraints,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

// Canonical signature evidence includes retained environments and bounds as well as result
// types. None of those fields may retain a private prefix or invocation inference owner.
effect fn signatureMentionsOwner(signature: &Signature, owner: &DeclarationId)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  if run typeMentionsOwner(&signature.result, owner) { return true }
  if run typeMentionsOwner(&signature.failure, owner) { return true }
  if run argumentMentionsOwner(&Argument.Row {value: Shared<Row>.clone(&signature.requirements)}, owner) { return true }
  let written = List<Shared<Type>>.asSlice(&signature.parameters)
  let mut at = usize.ZERO
  while at < written.length {
    if run typeMentionsOwner(&written[at], owner) { return true }
    at = at + usize.ONE
  }
  let bounds = List<Constraint>.asSlice(&signature.constraints)
  at = usize.ZERO
  while at < bounds.length {
    if run constraintMentionsOwner(&bounds[at], owner) { return true }
    at = at + usize.ONE
  }
  if let Option<Intersection>.Some {value: retained} = &signature.environment {
    let members = List<LifetimeMember>.asSlice(&retained.members)
    at = usize.ZERO
    while at < members.length {
      if run argumentMentionsOwner(&Argument.Lifetime {value: Shared<Lifetime>.clone(&members[at].region)}, owner) { return true }
      at = at + usize.ONE
    }
  }
  return false
}

// Whether a callee's binder at `ordinal` is one of its lifetime binders.
fn signatureLifetimeBinder(answer: &Result<Answer, NoRejection>, ordinal: usize) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let listed = List<Shared<Lifetime>>.asSlice(&signature.lifetimeParameters)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<Lifetime>.with<bool>(&listed[at], fn(binder: &Lifetime) -> bool {
          return match &binder.* { Lifetime.Parameter {ordinal: declared, ..} => declared == ordinal _ => false }
        }) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Whether a callee's binder at `ordinal` is the lifetime its written Effect environment names.
fn signatureEnvironmentBinder(answer: &Result<Answer, NoRejection>, ordinal: usize) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => match &signature.environment {
        Option<Intersection>.Some {value: retained} => environmentNamesBinder(&retained, ordinal)
        Option<Intersection>.None => false
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn environmentNamesBinder(retained: &Intersection, ordinal: usize) -> bool {
  let members = List<LifetimeMember>.asSlice(&retained.members)
  let mut at = usize.ZERO
  while at < members.length {
    let named = Shared<Lifetime>.with<bool>(&members[at].region, fn(value: &Lifetime) -> bool {
      if let Lifetime.Parameter {ordinal: written, ..} = &value.* { return written == ordinal }
      return false
    })
    if named { return true }
    at = at + usize.ONE
  }
  return false
}

// An environment binder no argument chose is left at 'static, which no input holding a loan of the
// caller's own storage outlives, so such a call owes `input: 'env` unprovably. When nothing else
// observes the binder, the call chooses it shorter instead: the meet of the owned loans
// (`ownedLoanRegion`) its owing inputs hold, which each of them outlives. The Effect it returns is
// then valid only for that region, which the body's borrow check holds it to, as for any shorter
// binder the caller could have written. The binder is the signature's environment binder itself, at
// its ordinal, never one found by the region it holds, so another binder left at 'static is never
// mistaken for it. Every parameter must store it covariantly (`storedCovariantly`), and no declared
// bound (`boundsAdmitShortening`), implied bound (`impliedBoundsAdmitShortening`) or requirement row
// (`rowObservesShortenedBinder`) may observe it. The exempt input (`environmentExemptInput`) owes
// nothing, so its loans do not shorten the environment.
effect fn environmentShortenedBinders(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &mut List<Binding>,
  explicit: &[usize], caller: &DeclarationId, nodes: &[BodyNode], arguments: &[BodyNodeId], span: Span,
) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return () }
  }
  // Collecting the offered loans reads every borrow of the body, so it waits until some binder
  // could take them.
  if !run anyEnvironmentCandidate(signature, fresh, List<Binding>.asSlice(&inferred.*), explicit) { return () }
  let mut offered = List<Shared<Lifetime>>.make()
  let mut argument = usize.ZERO
  while argument < arguments.length {
    if argument != facts.environmentExempt || arguments.length != facts.parameters {
      if let Option<Shared<Type>>.Some {value: ty} = move bodyExpressionType(nodes, &arguments[argument]) {
        run collectOwnedLoans(&ty, caller, nodes, &mut offered)
      }
    }
    argument = argument + usize.ONE
  }
  if List<Shared<Lifetime>>.length(&offered) == usize.ZERO { return () }
  let parameters = run signatureParameterTypes(signature)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let count = List<Binding>.length(&inferred.*)
  let mut at = usize.ZERO
  while at < count {
    let bindings = List<Binding>.asSlice(&inferred.*)
    let ordinal = bindings[at].ordinal
    let own = Shared<DeclarationId>.with<bool>(&bindings[at].declaration, fn(declared: &DeclarationId) -> bool {
      return DeclarationId.equals(declared, fresh)
    })
    let defaulted = match &bindings[at].value {
      Argument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value, staticLifetime)
      _ => false
    }
    let mut admitted = own && defaulted && !fixedOrdinal(explicit, ordinal)
      && Shared<Result<Answer, NoRejection>>.with<bool>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureEnvironmentBinder(answer, ordinal) })
    if admitted { admitted = run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, listed, fresh, ordinal, span) }
    if admitted { admitted = run boundsAdmitShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh, ordinal, span) }
    if admitted { admitted = run impliedBoundsAdmitShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh, ordinal, span) }
    if admitted {
      let met = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&offered))
      let mut shortened = run copyBindings(bindings)
      let replaced = List<Binding>.asMutSlice(&mut shortened)
      replaced[at].value = Argument.Lifetime {value: move met}
      if !run rowObservesShortenedBinder(signature, fresh, bindings, List<Binding>.asSlice(&shortened)) {
        inferred.* = move shortened
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether any inferred binder passes the shape checks `environmentShortenedBinders` makes before
// it consults the body: the call's own binder, defaulted to static, not written, and an
// environment binder of the signature.
effect fn anyEnvironmentCandidate(signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  bindings: &[Binding], explicit: &[usize]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < bindings.length {
    let ordinal = bindings[at].ordinal
    let own = Shared<DeclarationId>.with<bool>(&bindings[at].declaration, fn(declared: &DeclarationId) -> bool {
      return DeclarationId.equals(declared, fresh)
    })
    let defaulted = match &bindings[at].value {
      Argument.Lifetime {value} => Shared<Lifetime>.with<bool>(&value, staticLifetime)
      _ => false
    }
    if own && defaulted && !fixedOrdinal(explicit, ordinal)
      && Shared<Result<Answer, NoRejection>>.with<bool>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureEnvironmentBinder(answer, ordinal) }) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Appends each region of `ty` lent only by borrows of storage the caller's body owns
// (`ownedLoanRegion`) that `regions` does not hold yet, through the positions `carriesRegion` reads.
effect fn collectOwnedLoans(ty: &Shared<Type>, caller: &DeclarationId, nodes: &[BodyNode], regions: &mut List<Shared<Lifetime>>)
-> () ! OutOfMemoryError ? &mut Allocator {
  match move run Type.copy(ty) {
    Type.String {lifetime} => { run appendOwnedLoan(&lifetime, caller, nodes, &mut regions.*) }
    Type.Reference {referent, lifetime, ..} => {
      run appendOwnedLoan(&lifetime, caller, nodes, &mut regions.*)
      run collectOwnedLoans(&referent, caller, nodes, &mut regions.*)
    }
    Type.Slice {element, lifetime, ..} => {
      run appendOwnedLoan(&lifetime, caller, nodes, &mut regions.*)
      run collectOwnedLoans(&element, caller, nodes, &mut regions.*)
    }
    Type.Array {element, ..} => { run collectOwnedLoans(&element, caller, nodes, &mut regions.*) }
    Type.Nominal {arguments, ..} => {
      let listed = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        match &listed[at] {
          Argument.Lifetime {value: region} => { run appendOwnedLoan(&region, caller, nodes, &mut regions.*) }
          Argument.Type {value: argument} => { run collectOwnedLoans(&argument, caller, nodes, &mut regions.*) }
          _ => ()
        }
        at = at + usize.ONE
      }
    }
    _ => {}
  }
  return ()
}

effect fn appendOwnedLoan(region: &Shared<Lifetime>, caller: &DeclarationId, nodes: &[BodyNode],
  regions: &mut List<Shared<Lifetime>>) -> () ! OutOfMemoryError ? &mut Allocator {
  if !callerLocalRegion(region, caller) || !ownedLoanRegion(nodes, region) { return () }
  if containsRegion(List<Shared<Lifetime>>.asSlice(&regions.*), region) { return () }
  run List<Shared<Lifetime>>.append(&mut regions.*, Shared<Lifetime>.clone(region))
  return ()
}

fn capturedRegion(nodes: &[BodyNode], arguments: &[BodyNodeId]) -> Option<Shared<Lifetime>> {
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Option<Shared<Type>>.Some {value: ty} = move bodyExpressionType(nodes, &arguments[at]) {
      let region = Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, fn(value: &Type) -> Option<Shared<Lifetime>> {
        if let Type.Reference {lifetime, ..} = &value.* { return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime)) }
        return Option<Shared<Lifetime>>.none()
      })
      match move region {
        Option<Shared<Lifetime>>.Some {value} => { return Option<Shared<Lifetime>>.some(move value) }
        Option<Shared<Lifetime>>.None => ()
      }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Lifetime>>.none()
}

// A lifetime binder that only the call's outcome mentions, such as an impl lifetime only the
// result names, is chosen by the call's use rather than by an operand (LIFE-003). An ordinary
// call's expected result fixes it; otherwise the outcome retains no operand region through it, so
// it is 'static, and `defaulted` lists it for a bound to shorten (`outlivesShortenedBinders`). A
// lifetime binder that nothing mentions relates no region, so it is 'static too; only type and row
// binders can stay uninferred.
effect fn bindUseLifetimes(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  callOwner: &Shared<DeclarationId>, binderCount: usize, expected: &Option<Shared<Type>>, effectTarget: bool,
  inferred: &mut List<Binding>, defaulted: &mut List<usize>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut types = List<usize>.make()
  let mut mentioned = List<usize>.make()
  let mut rows = List<usize>.make()
  let parameters = run signatureParameterTypes(inference)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    run Type.collectOwned(&listed[at], fresh, &mut types, &mut mentioned, &mut rows)
    at = at + usize.ONE
  }
  let mut outcomeTypes = List<usize>.make()
  let mut produced = List<usize>.make()
  let mut outcomeRows = List<usize>.make()
  let declared = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(inference, signatureResult)
  if let Option<Shared<Type>>.Some {value: written} = &declared {
    run Type.collectOwned(&written, fresh, &mut outcomeTypes, &mut produced, &mut outcomeRows)
  }
  let failure = run signatureFailure(inference)
  run Type.collectOwned(&failure, fresh, &mut outcomeTypes, &mut produced, &mut outcomeRows)
  let requirements = run signatureRequirements(inference)
  run Type.collectOwnedRow(&requirements, fresh, &mut outcomeTypes, &mut produced, &mut outcomeRows)
  let mut evidence = List<Binding>.make()
  if !effectTarget {
    if let Option<Shared<Type>>.Some {value: wanted} = &expected.* {
      if let Option<Shared<Type>>.Some {value: written} = &declared {
        let pattern = run Type.applyBindings(&written, List<Binding>.asSlice(&inferred.*), true)
        let mut variables = List<Shared<DeclarationId>>.make()
        run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(callOwner))
        drop run Type.unify(&pattern, &wanted, List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut evidence)
      }
    }
  }
  at = usize.ZERO
  while at < binderCount {
    let open = match move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), at) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => !containsOrdinal(&mentioned, at) && (containsOrdinal(&produced, at)
        || (Shared<Result<Answer, NoRejection>>.with<bool>(inference,
          fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureLifetimeBinder(answer, at) })
          && !Shared<Result<Answer, NoRejection>>.with<bool>(inference,
            fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureEnvironmentBinder(answer, at) })))
    }
    if open {
      let mut region = run Shared<Lifetime>.make(Lifetime.Static)
      let mut chosen = false
      if let Option<Argument>.Some {value: Argument.Lifetime {value: selected}} = move bindingArgumentAt(List<Binding>.asSlice(&evidence), at) {
        let mut owned = List<usize>.make()
        run Type.collectOwnedLifetime(&selected, fresh, &mut owned)
        if List<usize>.length(&owned) == usize.ZERO {
          region = Shared<Lifetime>.clone(&selected)
          chosen = true
        }
      }
      if !chosen { run List<usize>.append(&mut defaulted.*, at) }
      run List<Binding>.append(&mut inferred.*, Binding {declaration: Shared<DeclarationId>.clone(callOwner), ordinal: at,
        value: Argument.Lifetime {value: move region}})
    }
    at = at + usize.ONE
  }
  return ()
}

// Result context may solve new region holes only. The whole comparison must succeed, and a
// transaction that also learns an unrelated original type, row or lifetime is not committed.
effect fn bindCallPrefixResult(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  originalCount: usize, totalCount: usize, expected: &Option<Shared<Type>>, effectTarget: bool,
  inferred: &mut List<Binding>) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if originalCount == totalCount || effectTarget { return () }
  let wanted = match &expected.* {
    Option<Shared<Type>>.Some {value} => Shared<Type>.clone(&value)
    Option<Shared<Type>>.None => { return () }
  }
  let written = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(inference, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return () }
  }
  let pattern = run Type.applyBindings(&written, List<Binding>.asSlice(&inferred.*), true)
  let mut candidate = List<Binding>.make()
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(fresh)))
  let matched = run Type.unify(&pattern, &wanted, List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut candidate)
  match move matched {
    Unification.Unified => ()
    Unification.Distinct => { return () }
    Unification.Undetermined {..} => { return () }
  }
  let learned = List<Binding>.asSlice(&candidate)
  let mut at = usize.ZERO
  while at < learned.length {
    if learned[at].ordinal < originalCount || learned[at].ordinal >= totalCount { return () }
    if !Shared<DeclarationId>.with<bool>(&learned[at].declaration,
      fn(owner: &DeclarationId) -> bool { return DeclarationId.equals(owner, fresh) }) { return () }
    let selected = match &learned[at].value {
      Argument.Lifetime {value} => Shared<Lifetime>.clone(&value)
      _ => { return () }
    }
    if run argumentMentionsOwner(&learned[at].value, fresh) { return () }
    if let Option<Argument>.Some {value} = move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), learned[at].ordinal) {
      if let Argument.Lifetime {value: previous} = move value {
        if !Lifetime.equalsShared(&previous, &selected) { return () }
      } else { return () }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < learned.length {
    if let Option<Argument>.None = move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), learned[at].ordinal) {
      run List<Binding>.append(&mut inferred.*, Binding {declaration: Shared<DeclarationId>.clone(&learned[at].declaration),
        ordinal: learned[at].ordinal, value: copyArgument(&learned[at].value)})
    }
    at = at + usize.ONE
  }
  return ()
}

// A region the written prefix elides that no parameter mentions, and that neither the operands nor
// the result context chose, is body-scoped (LIFE-003): local type annotations infer their lifetimes
// from later uses. It is the call's own caller-local region, so a later operand meets it like any
// fixed caller-local region, and the region check relates it to every use.
effect fn bindOutcomeCallPrefixRegions(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  caller: &DeclarationId, origin: BodyOrigin, originalCount: usize, totalCount: usize, inferred: &mut List<Binding>)
  -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut types = List<usize>.make()
  let mut mentioned = List<usize>.make()
  let mut rows = List<usize>.make()
  let parameters = run signatureParameterTypes(inference)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    let applied = run Type.applyBindings(&listed[at], List<Binding>.asSlice(&inferred.*), true)
    run Type.collectOwned(&applied, fresh, &mut types, &mut mentioned, &mut rows)
    at = at + usize.ONE
  }
  at = originalCount
  while at < totalCount {
    let open = match move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), at) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => !containsOrdinal(&mentioned, at)
    }
    if open {
      let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: origin.node, binder: at})
      run List<Binding>.append(&mut inferred.*, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(fresh)),
        ordinal: at, value: Argument.Lifetime {value: move region}})
    }
    at = at + usize.ONE
  }
  return ()
}

// A section's pending parameters still receive the invocation's operands. A region its written
// prefix elides that they mention, and that only a 'static operand chose, is the region of the
// section's call site, as for a contextual call argument: the invoking operand must outlive it,
// while the 'static operand already does. A region another operand chose keeps that loan.
effect fn localizeSectionCallPrefixRegions(inference: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, caller: &DeclarationId, expression: HirId, originalCount: usize, open: &[usize],
  inferred: &mut List<Binding>, anchor: &Anchor)
  -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut originals = List<Binding>.make()
  let mut at = usize.ZERO
  let bound = List<Binding>.asSlice(&inferred.*)
  while at < bound.length {
    if bound[at].ordinal < originalCount {
      run List<Binding>.append(&mut originals, Binding {declaration: Shared<DeclarationId>.clone(&bound[at].declaration),
        ordinal: bound[at].ordinal, value: Argument.copy(&bound[at].value)})
    }
    at = at + usize.ONE
  }
  let mut types = List<usize>.make()
  let mut pending = List<usize>.make()
  let mut rows = List<usize>.make()
  at = usize.ZERO
  while at < open.length {
    let ordinal = open[at]
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(inference,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, ordinal) })
    if let Option<Shared<Type>>.Some {value} = move parameter {
      let applied = run Type.applyBindings(&value, List<Binding>.asSlice(&originals), true)
      run Type.collectOwned(&applied, fresh, &mut types, &mut pending, &mut rows)
    }
    at = at + usize.ONE
  }
  let mut localized = List<Binding>.make()
  at = usize.ZERO
  while at < bound.length {
    let mut value = Argument.copy(&bound[at].value)
    if bound[at].ordinal >= originalCount && containsOrdinal(&pending, bound[at].ordinal) {
      if let Argument.Lifetime {value: region} = &bound[at].value {
        if Shared<Lifetime>.with<bool>(&region, staticLifetime) {
          value = Argument.Lifetime {value: run Shared<Lifetime>.make(anchoredRegion(anchor, caller, expression, bound[at].ordinal))}
        }
      }
    }
    run List<Binding>.append(&mut localized, Binding {declaration: Shared<DeclarationId>.clone(&bound[at].declaration),
      ordinal: bound[at].ordinal, value: move value})
    at = at + usize.ONE
  }
  inferred.* = move localized
  return ()
}

// A finite owner-local chain closes one inferred region. Cycles, absent evidence and a binding
// of another kind are unresolved; no distinguished region is supplied to make them disappear.
effect fn closedCallPrefixRegion(inferred: &[Binding], fresh: &DeclarationId, ordinal: usize,
  totalCount: usize) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut current = ordinal
  let mut seen = List<usize>.make()
  while current < totalCount {
    if containsOrdinal(&seen, current) { return Option<Shared<Lifetime>>.none() }
    run List<usize>.append(&mut seen, current)
    let region = match move bindingArgumentAt(inferred, current) {
      Option<Argument>.Some {value: Argument.Lifetime {value}} => move value
      _ => { return Option<Shared<Lifetime>>.none() }
    }
    let next = ownedLifetimeOrdinal(&region, fresh)
    if next == usize.MAX { return Option<Shared<Lifetime>>.some(move region) }
    current = next
  }
  return Option<Shared<Lifetime>>.none()
}

// Close every extra slot first, then rewrite only original argument values. The returned list
// retains the original dense map for section selection; no extra coordinate can be published.
effect fn closeCallPrefixBindings(inferred: &[Binding], fresh: &DeclarationId,
  template: &Option<Shared<DeclarationId>>, originalCount: usize, totalCount: usize)
  -> Option<List<Binding>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let owner = run Shared<DeclarationId>.make(DeclarationId.copy(fresh))
  let mut regions = List<Binding>.make()
  let mut at = originalCount
  while at < totalCount {
    let value = match move run closedCallPrefixRegion(inferred, fresh, at, totalCount) {
      Option<Shared<Lifetime>>.Some {value} => move value
      _ => { return Option<List<Binding>>.none() }
    }
    let argument = Argument.Lifetime {value: move value}
    if let Option<Shared<DeclarationId>>.Some {value: pending} = &template.* {
      let declared = DeclarationId.copyShared(&pending)
      if run argumentMentionsOwner(&argument, &declared) { return Option<List<Binding>>.none() }
    }
    run List<Binding>.append(&mut regions, Binding {declaration: Shared<DeclarationId>.clone(&owner),
      ordinal: at, value: move argument})
    at = at + usize.ONE
  }
  let mut closed = List<Binding>.make()
  at = usize.ZERO
  while at < originalCount {
    if let Option<Argument>.Some {value} = move bindingArgumentAt(inferred, at) {
      let argument = run Argument.applyBindings(&value, List<Binding>.asSlice(&regions), true)
      if let Option<Shared<DeclarationId>>.Some {value: pending} = &template.* {
        let declared = DeclarationId.copyShared(&pending)
        if run argumentMentionsOwner(&argument, &declared) { return Option<List<Binding>>.none() }
      }
      // An original binder may still be deferred; extra holes may not occur in that evidence.
      let mut types = List<usize>.make()
      let mut lifetimes = List<usize>.make()
      let mut rows = List<usize>.make()
      match &argument {
        Argument.Type {value: boundType} => { run Type.collectOwned(&boundType, fresh, &mut types, &mut lifetimes, &mut rows) }
        Argument.Lifetime {value: boundRegion} => { run Type.collectOwnedLifetime(&boundRegion, fresh, &mut lifetimes) }
        Argument.Row {value: boundRow} => { run Type.collectOwnedRow(&boundRow, fresh, &mut types, &mut lifetimes, &mut rows) }
      }
      let used = List<usize>.asSlice(&lifetimes)
      let mut usedAt = usize.ZERO
      while usedAt < used.length {
        if used[usedAt] >= originalCount { return Option<List<Binding>>.none() }
        usedAt = usedAt + usize.ONE
      }
      run List<Binding>.append(&mut closed, Binding {declaration: Shared<DeclarationId>.clone(&owner), ordinal: at, value: move argument})
    }
    at = at + usize.ONE
  }
  return Option<List<Binding>>.some(move closed)
}

fn bindingArgumentAt(bindings: &[Binding], ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal {
      return match & bindings[at].value {
        Argument.Type {value} => Option<Argument>.some(
          Argument.Type {value: Shared<Type>.clone(&value)},
        )
        Argument.Lifetime {value} => Option<Argument>.some(
          Argument.Lifetime {value: Shared<Lifetime>.clone(&value)},
        )
        Argument.Row {value} => Option<Argument>.some(
          Argument.Row {value: Shared<Row>.clone(&value)},
        )
      }
    }
    at = at + usize.ONE
  }
  return Option<Argument>.none()
}

fn signatureParameter(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = List<Shared<Type>>.asSlice(&signature.parameters)
        if at < parameters.length {
          return Option<Shared<Type>>.some(Shared<Type>.clone(&parameters[at]))
        }
        return Option<Shared<Type>>.none()
      }
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

fn signatureConstraint(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let constraints = List<Constraint>.asSlice(&signature.constraints)
        if at < constraints.length {
          return Option<Constraint>.some(copyConstraint(&constraints[at]))
        }
        return Option<Constraint>.none()
      }
      _ => Option<Constraint>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Constraint>.none()
  }
}

fn contractProvider(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => match & contract.provider {
        Option<Shared<Type>>.Some {value: provider} => Option<Shared<Type>>.some(
          Shared<Type>.clone(&provider),
        )
        Option<Shared<Type>>.None => Option<Shared<Type>>.none()
      }
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

// A caller's written bound is itself direct evidence even when its provider is an abstract type
// parameter. It cannot choose a concrete conformance for an unknown provider.
effect fn inferFromDeclaredBound(
  resolver: &Resolver,
  module: &ModuleId,
  provider: &Shared<Type>,
  contract: &Shared<Type>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut List<Binding>,
  span: Span,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut selected = Option<List<Binding>>.none()
  let mut undecided = false
  let mut boundAt = usize.ZERO
  while boundAt < declared.length {
    if let Constraint.Conforms {provider: assumedProvider, contract: assumedContract} = &declared[boundAt] {
      let mut left = List<Shared<Type>>.make()
      run List<Shared<Type>>.append(&mut left, Shared<Type>.clone(provider))
      run List<Shared<Type>>.append(&mut left, Shared<Type>.clone(contract))
      let mut right = List<Shared<Type>>.make()
      run List<Shared<Type>>.append(&mut right, Shared<Type>.clone(&assumedProvider))
      run List<Shared<Type>>.append(&mut right, Shared<Type>.clone(&assumedContract))
      let mut variables = List<Shared<DeclarationId>>.make()
      run List<Shared<DeclarationId>>.append(
        &mut variables,
        Shared<DeclarationId>.clone(callOwner),
      )
      let mut trial = List<Binding>.make()
      let fixed = List<Binding>.asSlice(&inferred.*)
      let mut fixedAt = usize.ZERO
      while fixedAt < fixed.length {
        run List<Binding>.append(
          &mut trial,
          Binding {
            declaration: Shared<DeclarationId>.clone(&fixed[fixedAt].declaration),
            ordinal: fixed[fixedAt].ordinal,
            value: copyArgument(&fixed[fixedAt].value),
          },
        )
        fixedAt = fixedAt + usize.ONE
      }
      let matched = run Type.unifyAll(
        List<Shared<Type>>.asSlice(&left),
        List<Shared<Type>>.asSlice(&right),
        List<Shared<DeclarationId>>.asSlice(&variables),
        Comparison.Exact,
        &mut trial,
      )
      match move matched {
        Unification.Unified => {
          if let Option<List<Binding>>.Some {..} = &selected {
            return Option<Shared<Rejection>>.some(
              run reject(resolver, module, RejectionCode.TypeArgumentInference, span),
            )
          }
          selected = Option<List<Binding>>.some(move trial)
        }
        Unification.Undetermined {at: unresolved} => {
          drop unresolved
          undecided = true
        }
        Unification.Distinct => ()
      }
    }
    boundAt = boundAt + usize.ONE
  }
  if undecided {
    return Option<Shared<Rejection>>.some(
      run reject(resolver, module, RejectionCode.Unsupported, span),
    )
  }
  if let Option<List<Binding>>.Some {value: evidence} = move selected {
    let entries = List<Binding>.asSlice(&evidence)
    let mut at = usize.ZERO
    while at < entries.length {
      if sameDeclarationShared(&entries[at].declaration, callOwner) {
        let prior = bindingArgumentAt(List<Binding>.asSlice(&inferred.*), entries[at].ordinal)
        if let Option<Argument>.None = move prior {
          run List<Binding>.append(
            &mut inferred.*,
            Binding {
              declaration: Shared<DeclarationId>.clone(callOwner),
              ordinal: entries[at].ordinal,
              value: copyArgument(&entries[at].value),
            },
          )
        }
      }
      at = at + usize.ONE
    }
  }
  return Option<Shared<Rejection>>.none()
}

// The ordinal of the call owner's type parameter that `value` names, or `usize.MAX` otherwise.
fn ownerParameterOrdinal(value: &Type, callOwner: &Shared<DeclarationId>) -> usize {
  return match & value.* {
    Type.Parameter {declaration, ordinal} => {
      if declarationEqualsShared(&declaration, callOwner) {
        return ordinal
      }
      return usize.MAX
    }
    _ => usize.MAX
  }
}

// The type argument already inferred for the parameter at `ordinal`, if any.
fn fixedTypeArgument(inferred: &[Binding], ordinal: usize) -> Option<Shared<Type>> {
  let fixed = bindingArgumentAt(inferred, ordinal)
  if let Option<Argument>.Some {value: argument} = move fixed {
    if let Argument.Type {value} = move argument {
      return Option<Shared<Type>>.some(move value)
    }
  }
  return Option<Shared<Type>>.none()
}

// Adopts one binding of the selected evidence for the call owner unless it is already inferred.
effect fn adoptEvidenceEntry(
  resolver: &Resolver,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  inferred: &mut List<Binding>,
  entry: &Binding,
  span: Span,
) -> Option<Shared<Rejection>>
! OutOfMemoryError
? &mut Allocator {
  if !sameDeclarationShared(&entry.declaration, callOwner) {
    return Option<Shared<Rejection>>.none()
  }
  let prior = bindingArgumentAt(List<Binding>.asSlice(&inferred.*), entry.ordinal)
  if let Option<Argument>.None = move prior {
    run List<Binding>.append(
      &mut inferred.*,
      Binding {
        declaration: Shared<DeclarationId>.clone(callOwner),
        ordinal: entry.ordinal,
        value: copyArgument(&entry.value),
      },
    )
  }
  return Option<Shared<Rejection>>.none()
}

// Adopts the call owner's bindings from the evidence of the uniquely selected head.
effect fn adoptEvidence(
  resolver: &Resolver,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  inferred: &mut List<Binding>,
  evidence: List<Binding>,
  span: Span,
) -> Option<Shared<Rejection>>
! OutOfMemoryError
? &mut Allocator {
  let entries = List<Binding>.asSlice(&evidence)
  let mut evidenceAt = usize.ZERO
  while evidenceAt < entries.length {
    let failed = run adoptEvidenceEntry(
      &resolver.*, module, callOwner, &mut inferred.*, &entries[evidenceAt], span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option<Shared<Rejection>>.some(move value)
    }
    evidenceAt = evidenceAt + usize.ONE
  }
  return Option<Shared<Rejection>>.none()
}

// Selected-head assignments may retain rigid caller parameters. Close the acyclic assignment
// graph and reject only owners this comparison opened; no pending impl or call slot may escape.
effect fn closedHeadCallEvidence(evidence: &[Binding], variables: &[Shared<DeclarationId>],
  callOwner: &Shared<DeclarationId>) -> Option<List<Binding>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut closed = run copyBindings(evidence)
  let mut at = usize.ZERO
  while at < evidence.length {
    if sameDeclarationShared(&evidence[at].declaration, callOwner) {
      let mut value = Argument.copy(&evidence[at].value)
      let mut pass = usize.ZERO
      while pass < evidence.length {
        value = run Argument.applyBindings(&value, evidence, true)
        pass = pass + usize.ONE
      }
      let mut ownerAt = usize.ZERO
      while ownerAt < variables.length {
        let opened = DeclarationId.copyShared(&variables[ownerAt])
        if run argumentMentionsOwner(&value, &opened) { return Option<List<Binding>>.none() }
        ownerAt = ownerAt + usize.ONE
      }
      let entries = List<Binding>.asMutSlice(&mut closed)
      entries[at].value = move value
    }
    at = at + usize.ONE
  }
  return Option<List<Binding>>.some(move closed)
}

// Unifies the candidate head at `candidateAt` with the known provider and open contract. A unique
// unifying head is recorded in `selected`; an undetermined head makes the whole selection undecided.
effect fn unifyHeadCandidate(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  fixed: &[Binding],
  knownProvider: &Shared<Type>,
  contract: &Shared<Type>,
  bucket: &Shared<Result<Answer, NoRejection>>,
  candidateAt: usize,
  selected: &mut Option<List<Binding>>,
  undecided: &mut bool,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let candidate = Shared<
    Result<Answer, NoRejection>,
  >.with<
    Option<Shared<ImplementationHead>>,
  >(
    bucket,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return bucketAt(answer, candidateAt)
    },
  )
  let head = match move candidate {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Option<Shared<Rejection>>.none()
    }
  }
  let terms = Shared<ImplementationHead>.with<Option<HeadTerms>>(&head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Option<Shared<Rejection>>.none()
    }
  }
  let headModule = Shared<DeclarationId>.with<usize>(
    &found.declaration,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if headModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let headSource = resolvedModule(&resolver.*, headModule)
  let headOrdinal = run ordinalOfIdentity(
    &mut resolver.*,
    &headSource,
    &found.declaration,
  )
  let headPosition = match move headOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return CompilerBug.panic(b"MissingRetainedFact: unifyHeadCandidate")
    }
  }
  let declarationAccess101Request = Key {
      family: Family.Coherence,
      module: headModule,
      name: usize.ZERO,
      declaration: headPosition,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess101 = run internDeclaration(&mut resolver.*, declarationAccess101Request)
  let coherence = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess101,
    span,
  )
  let invalid = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &coherence,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Option<Shared<Rejection>>.some(move value)
  }
  let mut left = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut left, Shared<Type>.clone(&found.provider))
  run List<Shared<Type>>.append(&mut left, Shared<Type>.clone(contract))
  let mut right = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut right, Shared<Type>.clone(knownProvider))
  run List<Shared<Type>>.append(&mut right, Shared<Type>.clone(&found.contract))
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, move found.declaration)
  run List<Shared<DeclarationId>>.append(
    &mut variables,
    Shared<DeclarationId>.clone(callOwner),
  )
  let mut trial = List<Binding>.make()
  let mut fixedAt = usize.ZERO
  while fixedAt < fixed.length {
    run List<Binding>.append(
      &mut trial,
      Binding {
        declaration: Shared<DeclarationId>.clone(&fixed[fixedAt].declaration),
        ordinal: fixed[fixedAt].ordinal,
        value: copyArgument(&fixed[fixedAt].value),
      },
    )
    fixedAt = fixedAt + usize.ONE
  }
  let mut matched = run Type.unifyAll(
    List<Shared<Type>>.asSlice(&left),
    List<Shared<Type>>.asSlice(&right),
    List<Shared<DeclarationId>>.asSlice(&variables),
    Comparison.Exact,
    &mut trial,
  )
  if exactHeadMatched(&matched) {
    matched = run admitRepresentations(&head, List<Shared<DeclarationId>>.asSlice(&variables), &mut trial)
  }
  match move matched {
    Unification.Unified => {
      if let Option<List<Binding>>.Some {..} = &selected.* {
        return Option<Shared<Rejection>>.some(
          run reject(&resolver.*, module, RejectionCode.TypeArgumentInference, span),
        )
      }
      let closed = run closedHeadCallEvidence(List<Binding>.asSlice(&trial),
        List<Shared<DeclarationId>>.asSlice(&variables), callOwner)
      if let Option<List<Binding>>.Some {value} = move closed {
        selected.* = Option<List<Binding>>.some(move value)
      } else { undecided.* = true }
    }
    Unification.Undetermined {at: unresolved} => {
      drop unresolved
      undecided.* = true
    }
    Unification.Distinct => ()
  }
  return Option<Shared<Rejection>>.none()
}

// A provider constructor stays known when its arguments are rigid caller parameters; a bare type
// parameter still needs a declared bound. Head unification only opens the impl and call owners.
fn providerCanSelectHead(provider: &Shared<Type>) -> bool {
  return !Type.hasOpenRuntimeParameters(provider) || Shared<Type>.with<bool>(provider, isNominalType)
}

// A known provider selects the contract's implementation head by unification. Exactly one coherent
// head may unify, and its evidence supplies the call owner's still-open parameters.
effect fn inferFromKnownProvider(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  inferred: &mut List<Binding>,
  knownProvider: &Shared<Type>,
  contract: &Shared<Type>,
  deferred: &mut bool,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let contractModule = declaringModuleOrdinal(&resolver.*, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let contractSource = resolvedModule(&resolver.*, contractModule)
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractSource, contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option<Shared<Rejection>>.some(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let inferenceOwner = DeclarationId.copyShared(callOwner)
  if run typeMentionsOwner(knownProvider, &inferenceOwner) {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UninferredParameter, span))
  }
  let providerApplication = run internApplication(&mut resolver.*, knownProvider)
  let declarationAccess102Request = Key {
      family: Family.ConformanceHeads,
      module: contractModule,
      name: providerApplication,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess102 = run internDeclaration(&mut resolver.*, declarationAccess102Request)
  let bucket = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess102,
    span,
  )
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &bucket,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Option<Shared<Rejection>>.some(move value)
  }
  let candidates = Shared<Result<Answer, NoRejection>>.with<usize>(&bucket, bucketCount)
  let mut selected = Option<List<Binding>>.none()
  let mut undecided = false
  let mut candidateAt = usize.ZERO
  while candidateAt < candidates {
    let failed = run unifyHeadCandidate(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      callOwner,
      List<Binding>.asSlice(&inferred.*),
      knownProvider,
      contract,
      &bucket,
      candidateAt,
      &mut selected,
      &mut undecided,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option<Shared<Rejection>>.some(move value)
    }
    candidateAt = candidateAt + usize.ONE
  }
  // A head that later bounds may still decide waits for the next inference pass.
  if undecided {
    deferred.* = true
    return Option<Shared<Rejection>>.none()
  }
  if let Option<List<Binding>>.Some {value: evidence} = move selected {
    return run adoptEvidence(&resolver.*, module, callOwner, &mut inferred.*, move evidence, span)
  }
  return Option<Shared<Rejection>>.none()
}

// Infers from one direct `provider: contract` bound, first against the declared bounds when both
// sides are open and then through the implementation heads once the provider is known.
effect fn inferFromConformance(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut List<Binding>,
  provider: &Shared<Type>,
  contract: &Shared<Type>,
  deferred: &mut bool,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let providerOrdinal = Shared<Type>.with<usize>(
    provider,
    fn(value: &Type) -> usize {
      return ownerParameterOrdinal(value, callOwner)
    },
  )
  let mut knownProvider = Shared<Type>.clone(provider)
  if providerOrdinal != usize.MAX {
    let fixed = fixedTypeArgument(List<Binding>.asSlice(&inferred.*), providerOrdinal)
    if let Option<Shared<Type>>.Some {value} = move fixed {
      knownProvider = move value
    }
  }
  // Declared bounds may solve an open goal first. A nominal constructor then selects a head even
  // with rigid caller arguments; head unification binds only the impl's own parameters to them.
  if Type.hasOpenRuntimeParameters(&knownProvider) && Type.hasOpenParameters(contract) {
    let failed = run inferFromDeclaredBound(
      &resolver.*,
      module,
      provider,
      contract,
      callOwner,
      declared,
      &mut inferred.*,
      span,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option<Shared<Rejection>>.some(move value)
    }
  }
  if providerCanSelectHead(&knownProvider) && Type.hasOpenParameters(contract) {
    return run inferFromKnownProvider(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      callOwner,
      &mut inferred.*,
      &knownProvider,
      contract,
      &mut deferred.*,
      span,
    )
  }
  return Option<Shared<Rejection>>.none()
}

// Infers from the signature's bound at `boundAt` when it is a direct conformance.
effect fn inferFromBoundAt(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  signature: &Shared<Result<Answer, NoRejection>>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut List<Binding>,
  boundAt: usize,
  deferred: &mut bool,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(
    signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
      return signatureConstraint(answer, boundAt)
    },
  )
  let direct = match move bound {
    Option<Constraint>.Some {value} => move value
    Option<Constraint>.None => {
      return Option<Shared<Rejection>>.none()
    }
  }
  match move direct {
    Constraint.Represents {parameter, contract} => {
      let fresh = DeclarationId.copyShared(callOwner)
      return run inferCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &fresh, declared,
        &mut inferred.*, &parameter, &contract, span)
    }
    Constraint.Conforms {provider, contract} => { return run inferFromConformance(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      callOwner,
      declared,
      &mut inferred.*,
      &provider,
      &contract,
      &mut deferred.*,
      span,
    ) }
    _ => ()
  }
  return Option<Shared<Rejection>>.none()
}

// Each bound may contribute arguments from its own uniquely selected, coherent direct
// conformance. Match the provider first: this fixes an impl's own parameters before its
// interface arguments are compared with the call's still-open parameters. A bound whose head
// stays undecided waits for later bounds: passes repeat while one adds a binding, so declaration
// order does not decide inference, and a head still undecided after the last pass is refused.
effect fn inferFromProviderBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  signature: &Shared<Result<Answer, NoRejection>>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut List<Binding>,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut progressed = true
  while progressed {
    let before = List<Binding>.length(&inferred.*)
    let mut deferred = false
    let mut boundAt = usize.ZERO
    while boundAt < count {
      let failed = run inferFromBoundAt(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        module,
        signature,
        callOwner,
        declared,
        &mut inferred.*,
        boundAt,
        &mut deferred,
        span,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Option<Shared<Rejection>>.some(move value)
      }
      boundAt = boundAt + usize.ONE
    }
    if !deferred { return Option<Shared<Rejection>>.none() }
    progressed = List<Binding>.length(&inferred.*) > before
  }
  return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// C-layout declarations are the only nominal types admitted as whole C values. Field layout
// validation independently checks nested records, arrays, represented enums and vector fields.
effect fn foreignAdmitted(resolver: &mut Resolver, ty: &Shared<Type>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(ty)
  if let Type.ForeignFunction {signature, ..} = move copied {
    let callable = run Type.copy(&signature)
    if let Type.Callable {parameters, result, ..} = move callable {
      if !(run foreignAdmitted(&mut resolver.*, &result)) { return false }
      let listed = List<Shared<Type>>.asSlice(&parameters)
      let mut at = usize.ZERO
      while at < listed.length {
        if !(run foreignAdmitted(&mut resolver.*, &listed[at])) { return false }
        at = at + usize.ONE
      }
      return Shared<Type>.with<bool>(ty, CAbi.admit)
    }
    return false
  }
  let nominal = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.Nominal {..} => true _ => false }
  })
  if !nominal { return Shared<Type>.with<bool>(ty, CAbi.admit) }
  return match move run structLayout(&mut resolver.*, ty) {
    Option<bool>.Some {value: external} => external
    Option<bool>.None => false
  }
}

// Whether a nominal type is a struct declared `extern "C"`; none when it is not a struct.
effect fn structLayout(resolver: &mut Resolver, ty: &Shared<Type>) -> Option<bool>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Option<bool>.none() }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = match move run ordinalOfProvider(&mut resolver.*, &module, ty) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<bool>.none() }
  }
  if let Option<HeaderSyntax>.Some {value} = move run header(&mut resolver.*, &module, ordinal) {
    return match value.header {
      Node.StructHeader {abi, ..} => Option<bool>.some(abi.present)
      _ => Option<bool>.none()
    }
  }
  return Option<bool>.none()
}

// A C signature lane outside the admitted subset. A callback still waits on the backend; any
// other type is refused for good (SEM0187), and a plain struct is told to declare its C layout.
effect fn foreignTypeGap(resolver: &mut Resolver, module: &ModuleId, ty: &Shared<Type>, span: Span)
-> Option<Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // Vector feature diagnostics retain their precise type and target requirement.
  if Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.Vector {..} => true _ => false }
  }) { return Option<Shared<Rejection>>.none() }
  if run foreignAdmitted(&mut resolver.*, ty) { return Option<Shared<Rejection>>.none() }
  if Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
    return match &value.* { Type.Callable {..} => true _ => false }
  }) { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.ForeignCallback, span)) }
  let mut refused = run makeRejection(RejectionCode.ForeignType, module, span)
  if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(ty, module) {
    let mut choice: &'static [u8] = b"0"
    if let Option<bool>.Some {value: external} = move run structLayout(&mut resolver.*, ty) {
      if !external { choice = b"1" }
    }
    run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
    run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move text})
    run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"abi"), value: run Bytes.copy(b"C")})
  }
  return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move refused))
}

// Primitive and vector lanes depend on the target's C ABI, so an import checks them only where
// it is called; every other lane is refused at the declaration.
fn targetLane(value: &Type) -> bool {
  return match &value.* { Type.Primitive {..} => true Type.Vector {..} => true _ => false }
}

// Effect construction remains outside runtime body lowering; unsafe is checked lexically.
fn signatureUnsafe(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => signature.isUnsafe
      _ => false
    }
    _ => false
  }
}

// Runtime representation admission is independent of the unfinished borrow-safety stage.
fn runtimeType(value: &Type) -> bool {
  return match & value.* {
    Type.Array {..} => true
    Type.Anonymous {..} => true
    Type.CallableValue {..} => true
    Type.CallableSchema {..} => true
    // Semantic storage remains exact and opaque until the runtime projection query proves
    // its finite environment.
    Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<bool>(&contract, callableType) || Shared<Type>.with<bool>(&contract, bareEffect)
    Type.CallableOrigin {..} => true
    Type.CallableWitnessResult {..} => true
    Type.CallableResult {..} => true
    // A staged source recipe is admitted here; its original environment must still be
    // realized by the runtime projection query before MIR can use its storage.
    Type.CallableStage {..} => true
    Type.CallableView {..} => true
    // Ordinary callable contracts need their original returned environment before lowering.
    Type.Callable {..} => true
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    Type.Slice {..} => true
    Type.String {..} => true
    Type.Reference {..} => true
    Type.ForeignFunction {..} => true
    Type.Pointer {..} => true
    Type.Nominal {..} => true
    Type.Vector {..} => true
    Type.Primitive {name} => scalarType(value) || pointerSizedIntegerType(value) || same(Bytes.asSlice(&name), b"f32") || same(Bytes.asSlice(&name), b"f64")
      || same(Bytes.asSlice(&name), b"char")
    // Closed structural unions have a Tagged layout and lowered injection and matching.
    Type.Union {..} => sourceUnion(value)
    _ => scalarType(value)
  }
}

// An Effect contract with no producer body to realize its storage, such as an interface
// operation's declared `Effect<...>` result.
fn effectStorageType(value: &Type) -> bool {
  return match &value.* {
    Type.Effect {..} => true
    Type.Union {members} => {
      let listed = List<Shared<Type>>.asSlice(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared<Type>.with<bool>(&listed[at], effectStorageType) { return true }
        at = at + usize.ONE
      }
      return false
    }
    _ => false
  }
}

fn mutableSlice(value: &Type) -> bool {
  return match &value.* { Type.Slice {access, ..} => access == Access.Mutable _ => false }
}

fn mutablePlace(nodes: &[BodyNode], locals: &[BodyLocal], id: BodyNodeId) -> bool {
  return match & nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => locals[local.index].mutable
    // Only a `match &mut` binding is an exclusive place; copied, moved and shared bindings are not.
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {access, ..}, ..} => access == BodyBindingAccess.Exclusive
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => mutablePlace(nodes, locals, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => {
      if let BodyNodeKind.Expression {ty, ..} = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&ty) {
          return Shared<Type>.with<bool>(&ty, mutableSlice)
        }
      }
      return mutablePlace(nodes, locals, value)
    }
    BodyNodeKind.Expression {form: BodyExpression.Dereference {value}, ..} => match & nodes[value.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared<Type>.with<bool>(
        &ty,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Reference {access, ..} => access == Access.Mutable
            Type.Pointer {access, ..} => access == Access.Mutable
            _ => false
          }
        },
      )
      _ => false
    }
    _ => false
  }
}

// Whether an assignment may write a place: a mutable place, or mutably owned storage, which a
// `match place` binding names in its subject. Exclusive borrows still need a mutable binding.
fn assignablePlace(nodes: &[BodyNode], locals: &[BodyLocal], id: BodyNodeId) -> bool {
  return mutablePlace(nodes, locals, id) || ownedMutablePlace(nodes, locals, id)
}

// Whether a place is mutably owned: a mutable local reached through fields, array elements and
// `match place` bindings of such a subject. A borrowed root, such as a slice or a `match &mut`
// binding, lends its referent but does not own it.
fn ownedMutablePlace(nodes: &[BodyNode], locals: &[BodyLocal], id: BodyNodeId) -> bool {
  return match & nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => locals[local.index].mutable
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => ownedMutablePlace(nodes, locals, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => {
      if let BodyNodeKind.Expression {ty, ..} = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some {..} = move Type.sliceElement(&ty) {
          return false
        }
      }
      return ownedMutablePlace(nodes, locals, value)
    }
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {subject, access, ..}, ..} => access == BodyBindingAccess.Place && ownedMutablePlace(nodes, locals, subject)
    _ => false
  }
}

// Whether a place's projections bottom out in a local or pattern binding rather than in a
// temporary result such as a call.
fn bindingRootedPlace(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match & nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => bindingRootedPlace(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => bindingRootedPlace(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Dereference {value}, ..} => bindingRootedPlace(nodes, value)
    _ => false
  }
}

// Called after mutablePlace refused: owned immutable roots differ from shared views or rvalues.
fn assignmentPlaceCode(nodes: &[BodyNode], id: BodyNodeId) -> RejectionCode {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {
      form: BodyExpression.Local { .. },
      ..
    } => RejectionCode.ImmutableAssignment
    BodyNodeKind.Expression { form: BodyExpression.PatternBinding { access, .. }, .. } => {
      if access == BodyBindingAccess.Shared || access == BodyBindingAccess.Exclusive {
        return RejectionCode.InvalidAssignmentPlace
      }
      return RejectionCode.ImmutableAssignment
    }
    BodyNodeKind.Expression {
      form: BodyExpression.Field { value, .. },
      ..
    } => assignmentPlaceCode(nodes, value)
    BodyNodeKind.Expression { form: BodyExpression.Index { value, .. }, .. } => {
      if let BodyNodeKind.Expression { ty, .. } = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some { .. } = move Type.sliceElement(&ty) {
          return RejectionCode.InvalidAssignmentPlace
        }
      }
      return assignmentPlaceCode(nodes, value)
    }
    _ => RejectionCode.InvalidAssignmentPlace
  }
}

fn checkedPlace(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match & nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => checkedPlace(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => checkedPlace(nodes, value)
    // A pattern binding names a place projected from its matched subject or that subject's copy.
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {..}, ..} => true
    _ => false
  }
}

// A field or element read whose subject is no place, such as a call result or a literal.
fn valueProjection(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => !checkedPlace(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => !checkedPlace(nodes, value)
    _ => false
  }
}

// A binding reached only through fields and literal fixed-array elements, which a `match place`
// refines in place.
fn completeBindingPlace(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => completeBindingPlace(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, element, ..}, ..} => element != usize.MAX && completeBindingPlace(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {..}, ..} => true
    _ => false
  }
}

// STORAGE-001 applies to invocation of an aggregate's executable field, including a field
// introduced by a pattern. An explicit move is checked separately as ordinary extraction.
fn storedExecutableField(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression { form: BodyExpression.Field { .. }, .. } => true
    BodyNodeKind.Expression {
      form: BodyExpression.PatternBinding { path, .. },
      ..
    } => List<BodyPlaceStep>.length(&path) != usize.ZERO
    _ => false
  }
}

// Projections preserve their aggregate receiver's ownership; references and borrowing patterns
// grant access without transferring that owner. An owned temporary still has whole-owner access.
fn ownedExecutableReceiver(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {
      form: BodyExpression.Field { value, .. },
      ..
    } => ownedExecutableReceiver(nodes, value)
    BodyNodeKind.Expression { form: BodyExpression.Index { value, .. }, .. } => {
      if let Option<Shared<Type>>.Some { value: subject } = move bodyExpressionType(nodes, &value) {
        if Shared<Type>.with<bool>(&subject, sliceType) {
          return false
        }
      }
      return ownedExecutableReceiver(nodes, value)
    }
    BodyNodeKind.Expression { form: BodyExpression.Dereference { .. }, .. } => false
    BodyNodeKind.Expression { form: BodyExpression.PatternBinding { subject, access, .. }, .. } => {
      if access == BodyBindingAccess.Place {
        return ownedExecutableReceiver(nodes, subject)
      }
      return access != BodyBindingAccess.Shared && access != BodyBindingAccess.Exclusive
    }
    _ => true
  }
}

// What a consuming site transfers out of its operand: a static owned place, an owned rvalue, a
// complete referent behind a reference, or a projection whose extraction would leave a hole behind
// a reference, at a runtime index or in an owned rvalue (OWN-004). A binding of a borrowing match
// cannot leave its arm, and moving out of a `match place` binding is not lowered yet.
union Consumption {
  Rvalue,
  // `ancestors` are the types of the owners a non-empty path passes through.
  Place {place: BodyConsumedPlace, ancestors: List<Shared<Type>>},
  Borrowed,
  Boundary,
  // `binding` is the type of the borrowing match binding the place is rooted at; `ancestors` are
  // the types of the owners its path passes through.
  Escape {binding: Shared<Type>, ancestors: List<Shared<Type>>},
  PlaceBinding,
}

// The owned place a `move`, `drop`, consuming match or by-value receiver transfers out of.
effect fn consumption(source: &SourceIndex, cursor: &AuthoredCursor, nodes: &[BodyNode], id: BodyNodeId) -> Consumption
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => Consumption.Place {
      place: BodyConsumedPlace {root: BodyPlaceRoot.Local {local: local}, steps: List<BodyPlaceStep>.make()},
      ancestors: List<Shared<Type>>.make(),
    }
    BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {subject, path, access, ..}} => match access {
      // A consuming match's binding owns its part of the evaluated subject (MATCH-002); a bare
      // match's binding is a place of the copied subject.
      BodyBindingAccess.Moved => Consumption.Place {
        place: BodyConsumedPlace {root: BodyPlaceRoot.Subject {subject: subject}, steps: run copySteps(&path)},
        ancestors: List<Shared<Type>>.make(),
      }
      BodyBindingAccess.Copied => Consumption.Place {
        place: BodyConsumedPlace {root: BodyPlaceRoot.Subject {subject: subject}, steps: run copySteps(&path)},
        ancestors: List<Shared<Type>>.make(),
      }
      // A `match place` binding names a projection of the subject's own storage, so moving it
      // leaves a hole in the subject's owner like a written projection (OWN-004).
      BodyBindingAccess.Place => run placeBindingConsumption(source, cursor, nodes, subject, &path)
      BodyBindingAccess.Shared => Consumption.Escape {binding: Shared<Type>.clone(&ty), ancestors: List<Shared<Type>>.make()}
      BodyBindingAccess.Exclusive => Consumption.Escape {binding: Shared<Type>.clone(&ty), ancestors: List<Shared<Type>>.make()}
    }
    BodyNodeKind.Expression {form: BodyExpression.Field {value, index, ..}, ..} => run extendedConsumption(
      run consumption(source, cursor, nodes, value), BodyPlaceStep.Field {index: index}, bodyExpressionType(nodes, &value),
    )
    BodyNodeKind.Expression {form: BodyExpression.Index {value, element, ..}, ..} => run indexedConsumption(source, cursor, nodes, value, element)
    BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => Consumption.Borrowed
    _ => Consumption.Rvalue
  }
}

// The subject's own place extended by a `match place` binding's step. Only a direct field,
// variant field or member of the subject is extracted, so the subject is the one owner the step
// passes through; a deeper pattern path keeps the `match place` binding boundary.
effect fn placeBindingConsumption(source: &SourceIndex, cursor: &AuthoredCursor, nodes: &[BodyNode], subject: BodyNodeId,
  path: &List<BodyPlaceStep>) -> Consumption ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if List<BodyPlaceStep>.length(path) != usize.ONE { return Consumption.PlaceBinding }
  let mut copied = run copySteps(path)
  let step = List<BodyPlaceStep>.remove(&mut copied, usize.ZERO)
  let base = run consumption(source, cursor, nodes, subject)
  return run extendedConsumption(move base, move step, bodyExpressionType(nodes, &subject))
}

// An element leaves a hole only in a fixed array at a literal in-bounds index, the static element
// typing recorded; a slice element is reached through a reference.
effect fn indexedConsumption(source: &SourceIndex, cursor: &AuthoredCursor, nodes: &[BodyNode], subject: BodyNodeId,
  element: usize) -> Consumption ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  // A slice element is behind the slice's reference whatever the slice came from.
  let subjectType = bodyExpressionType(nodes, &subject)
  let sliced = match &subjectType {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, sliceType)
    Option<Shared<Type>>.None => false
  }
  if sliced { return Consumption.Borrowed }
  let base = run consumption(source, cursor, nodes, subject)
  let place = match &base {
    Consumption.Place {..} => true
    _ => false
  }
  if !place { return run extendedConsumption(move base, BodyPlaceStep.Element {index: usize.ZERO}, Option<Shared<Type>>.none()) }
  if element == usize.MAX { return Consumption.Boundary }
  return run extendedConsumption(move base, BodyPlaceStep.Element {index: element}, move subjectType)
}

effect fn extendedConsumption(base: Consumption, step: BodyPlaceStep, parent: Option<Shared<Type>>) -> Consumption ! OutOfMemoryError ? &mut Allocator {
  return match move base {
    Consumption.Place {place, ancestors} => {
      let mut owners = move ancestors
      if let Option<Shared<Type>>.Some {value} = move parent { run List<Shared<Type>>.append(&mut owners, move value) }
      return Consumption.Place {
        place: BodyConsumedPlace {root: move place.root, steps: run extendedPath(&place.steps, move step)}, ancestors: move owners,
      }
    }
    // A projection out of an owned rvalue would leave its remainder without an owner.
    Consumption.Rvalue => Consumption.Boundary
    Consumption.Borrowed => Consumption.Boundary
    Consumption.Boundary => Consumption.Boundary
    Consumption.Escape {binding, ancestors} => {
      let mut owners = move ancestors
      if let Option<Shared<Type>>.Some {value} = move parent { run List<Shared<Type>>.append(&mut owners, move value) }
      return Consumption.Escape {binding: move binding, ancestors: move owners}
    }
    Consumption.PlaceBinding => Consumption.PlaceBinding
  }
}

fn sliceType(value: &Type) -> bool {
  return match &value.* {
    Type.Slice {..} => true
    _ => false
  }
}

// SEM0083 for `impl Copy` on `ty`: it has a Drop hook, or it stores `field`, which is not Copy.
effect fn copyConformanceRejection(module: &ModuleId, span: Span, ty: &Shared<Type>, field: Option<&Shared<Type>>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InvalidCopyConformance, module, span)
  if let Option<Bytes>.Some {value: shown} = move run TypeText.display(ty, module) {
    let mut detail = move shown
    match move field {
      Option<&Shared<Type>>.Some {value: stored} => {
        if let Option<Bytes>.Some {value: part} = move run TypeText.display(stored, module) {
          run Bytes.append(&mut detail, b" cannot be Copy, because its field of type ")
          run Bytes.append(&mut detail, Bytes.asSlice(&part))
          run Bytes.append(&mut detail, b" is not Copy")
          run vectorArgument(&mut diagnostic, b"detail", Bytes.asSlice(&detail))
        }
      }
      Option<&Shared<Type>>.None => {
        run Bytes.append(&mut detail, b" has a Drop hook, so it cannot be Copy: every copy would run the hook again")
        run vectorArgument(&mut diagnostic, b"detail", Bytes.asSlice(&detail))
      }
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The first owner type a consumed path passes through that has, or at some instance may have, a
// `Drop` hook, as its ordinal in `ancestors`; `usize.MAX` when none has.
effect fn hookedAncestor(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  ancestors: &[Shared<Type>], constraints: &[Constraint]) -> Result<usize, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < ancestors.length {
    match move run dropImplementation(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ancestors[at], constraints) {
      Result<Option<SealedMatch>, Shared<Rejection>>.Success {value: hook} => {
        if let Option<SealedMatch>.Some {..} = &hook { return Result<usize, Shared<Rejection>>.succeed(at) }
      }
      Result<Option<SealedMatch>, Shared<Rejection>>.Failure {error} => { return Result<usize, Shared<Rejection>>.failResult(move error) }
    }
    // An instance may run a hook no head matches here.
    match move run specializedDrop(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ancestors[at], Span.make(usize.ZERO, usize.ZERO)) {
      Result<bool, Shared<Rejection>>.Success {value} => { if value { return Result<usize, Shared<Rejection>>.succeed(at) } }
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<usize, Shared<Rejection>>.failResult(move error) }
    }
    at = at + usize.ONE
  }
  return Result<usize, Shared<Rejection>>.succeed(usize.MAX)
}

// OWN0002 for a part moved out from under `hooked`, an owner with a `Drop` hook, named when it
// prints.
effect fn hookedPartialMove(module: &ModuleId, span: Span, hooked: &Shared<Type>) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.ExtractionBoundary, module, span)
  if let Option<Bytes>.Some {value: shown} = move run TypeText.display(hooked, module) {
    run vectorArgument(&mut diagnostic, b"template", b"1")
    run vectorArgument(&mut diagnostic, b"owner", Bytes.asSlice(&shown))
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The consumed place a site records, or the rejection for a place that cannot be extracted. A
// `drop` of a Copy value behind a reference ends no owner, so it records no place (DROP-001). A
// partial move cannot leave a hole beneath an owner with a `Drop` hook (OWN-004), whatever the
// moved value's type; that is reported at `hookSpan`. `copyBinding` marks a `drop`, which a
// borrowing match binding exempts only when the binding itself is Copy; a consuming match of a
// Copy part of that binding copies it out, still checked against the binding's Drop hooks.
effect fn consumedPlace(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, nodes: &[BodyNode],
  operand: BodyNodeId, copyExempt: bool, copyBinding: bool, span: Span, hookSpan: Span, constraints: &[Constraint]) -> Result<Option<BodyConsumedPlace>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut code = RejectionCode.ExtractionBoundary
  let mut exempt = copyExempt
  match move run consumption(&resolver.source, cursor, nodes, operand) {
    Consumption.Place {place, ancestors} => {
      match move run hookedAncestor(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<Shared<Type>>.asSlice(&ancestors), constraints) {
        Result<usize, Shared<Rejection>>.Success {value: hooked} => {
          if hooked != usize.MAX {
            return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.failResult(run hookedPartialMove(module, hookSpan, &List<Shared<Type>>.asSlice(&ancestors)[hooked]))
          }
        }
        Result<usize, Shared<Rejection>>.Failure {error} => { return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.failResult(move error) }
      }
      return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.succeed(Option<BodyConsumedPlace>.some(move place))
    }
    Consumption.Rvalue => { return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.succeed(Option<BodyConsumedPlace>.none()) }
    Consumption.Borrowed => { code = RejectionCode.BorrowedExtraction }
    Consumption.Boundary => {}
    Consumption.Escape {binding, ancestors} => {
      code = RejectionCode.MatchBorrowEscape
      if exempt && copyBinding {
        exempt = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &binding, constraints, span) {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.failResult(move error) }
        }
      } else if exempt {
        match move run hookedAncestor(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<Shared<Type>>.asSlice(&ancestors), constraints) {
          Result<usize, Shared<Rejection>>.Success {value: hooked} => {
            if hooked != usize.MAX {
              return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.failResult(run hookedPartialMove(module, hookSpan, &List<Shared<Type>>.asSlice(&ancestors)[hooked]))
            }
          }
          Result<usize, Shared<Rejection>>.Failure {error} => { return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.failResult(move error) }
        }
      }
    }
    Consumption.PlaceBinding => { code = RejectionCode.Unsupported }
  }
  if exempt { return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.succeed(Option<BodyConsumedPlace>.none()) }
  return Result<Option<BodyConsumedPlace>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, code, span))
}

fn signatureIsEffect(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => signature.isEffect
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// The failure a dependent forwards as its own cause: an owner's first diagnostic, or the cause an
// unavailable answer already forwards. It is never reported; owners report their `diagnostics`.
fn answerCause(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => Outcome.cause(&value.outcome)
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Rejection>>.none()
  }
}

// The cause an unavailable answer forwards.
fn answerUnavailableCause(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Unavailable {cause, ..} => Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&cause))
      _ => Option<Shared<Rejection>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Rejection>>.none()
  }
}

// What collecting `answer` reports: its own diagnostics, or for an unavailable answer, the
// diagnostics of the unit that owns its cause. A forwarded cause is reported only as part of its
// owner's list; the cause alone stands for that list when the owner's answer was never retained,
// as a transient static-budget refusal is not.
effect fn reportedDiagnostics(
  store: &mut Query<Answer, NoRejection>,
  answer: &Shared<Result<Answer, NoRejection>>
) -> List<Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut reported = List<Shared<Rejection>>.make()
  let cause = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, answerUnavailableCause)
  let mut source = Shared<Result<Answer, NoRejection>>.clone(answer)
  if let Option<Shared<Rejection>>.Some {value} = move cause {
    let owner = Shared<Rejection>.with<usize>(&value, fn(rejection: &Rejection) -> usize { return rejection.owner })
    let retained = Query.completed(&mut store.*, Word {value: usize.toU64(owner)})
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: ownerAnswer} = move retained {
      source = move ownerAnswer
    } else {
      run List<Shared<Rejection>>.append(&mut reported, move value)
      return move reported
    }
  }
  let mut at = usize.ZERO
  while true {
    let next = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&source,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> { return answerDiagnostic(value, at) })
    if let Option<Shared<Rejection>>.Some {value} = move next {
      run List<Shared<Rejection>>.append(&mut reported, move value)
      at = at + usize.ONE
    } else {
      return move reported
    }
  }
  return move reported
}

// The diagnostics an owner key reports, by position: its own `Rejected` list, never a forwarded
// cause.
fn answerDiagnostic(answer: &Result<Answer, NoRejection>, index: usize) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostics, ..} => {
        let listed = List<Shared<Rejection>>.asSlice(&diagnostics)
        if index < listed.length {
          return Option<Shared<Rejection>>.some(Shared<Rejection>.clone(&listed[index]))
        }
        return Option<Shared<Rejection>>.none()
      }
      _ => Option<Shared<Rejection>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Rejection>>.none()
  }
}

// The number of parameters of the `silk.string` function `name` that takes a string first, such as
// 2 for `startsWith`; 0 when there is none.
fn stringFunctionArity(name: &[u8]) -> usize {
  if same(name, b"byteLength") || same(name, b"utf8Bytes") || same(name, b"trim") || same(name, b"trimStart")
    || same(name, b"trimEnd") || same(name, b"copy") { return usize.ONE }
  if same(name, b"startsWith") || same(name, b"endsWith") || same(name, b"contains") || same(name, b"find")
    || same(name, b"findLast") || same(name, b"split") || same(name, b"isCharBoundary") || same(name, b"nextScalar") { return 2 }
  if same(name, b"slice") { return 3 }
  return usize.ZERO
}

// `rejected` with `template` chosen when `subject` is a string, whose message points at the
// `silk.string` functions.
effect fn stringHint(rejected: Shared<Rejection>, subject: &Shared<Type>, template: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  if !Shared<Type>.with<bool>(subject, stringType) { return move rejected }
  let code = Shared<Rejection>.with<RejectionCode>(&rejected, fn(value: &Rejection) -> RejectionCode { return value.code })
  let site = Shared<Rejection>.with<Span>(&rejected, fn(value: &Rejection) -> Span { return value.span })
  let module = Shared<Rejection>.with<ModuleId>(&rejected, fn(value: &Rejection) -> ModuleId { return ModuleId.copy(&value.module) })
  let mut diagnostic = run makeRejection(code, &module, site)
  run copySharedArguments(&rejected, &mut diagnostic)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
  return run Shared<Rejection>.make(move diagnostic)
}

// A type with no method or associated function called `member` (SEM0010), naming the type when it
// prints exactly. `method` says whether a value was the receiver, as in `list.push(1)`, rather than
// the type itself, as in `List<i32>.empty()`.
effect fn unknownOperationRejection(module: &ModuleId, span: Span, owner: &Shared<Type>, member: &[u8], method: bool)
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.UnknownOperation, module, span)
  // A string method spelled as in other languages, `text.startsWith("a")`, is a `silk.string`
  // function that takes the string first.
  if method && Shared<Type>.with<bool>(owner, stringType) {
    let arity = stringFunctionArity(member)
    if arity != usize.ZERO {
      let mut call = run Bytes.copy(b"String.")
      run Bytes.append(&mut call, member)
      if arity == usize.ONE { run Bytes.append(&mut call, b"(text)") } else { run Bytes.append(&mut call, b"(text, ...)") }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"call"), value: move call})
      return run Shared<Rejection>.make(move diagnostic)
    }
  }
  // `c.drop()`, as other languages end a value, is the `drop c` statement.
  if method && same(member, b"drop") {
    run vectorArgument(&mut diagnostic, b"template", b"3")
    return run Shared<Rejection>.make(move diagnostic)
  }
  // `Status.Ok.value()`, as other languages read a backing value, is `Status.value(Status.Ok)`.
  if method && same(member, b"value") && Shared<Type>.with<OwnerKind>(owner, nominalKind) == OwnerKind.Enumeration {
    if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(owner, module) {
      let name = run unqualifiedName(Bytes.asSlice(&text))
      run vectorArgument(&mut diagnostic, b"template", b"2")
      run vectorArgument(&mut diagnostic, b"enumName", Bytes.asSlice(&name))
      return run Shared<Rejection>.make(move diagnostic)
    }
  }
  if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(owner, module) {
    let mut named = Bytes.make()
    if method {
      run Bytes.append(&mut named, b"method `")
    } else {
      run Bytes.append(&mut named, b"associated function `")
    }
    run Bytes.append(&mut named, member)
    run Bytes.append(&mut named, b"`")
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actor"), value: move text})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: move named})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The last segment of a displayed type name, `Status` for `main.Status`, as code in a hint writes it.
effect fn unqualifiedName(shown: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut start = shown.length
  while start > usize.ZERO && shown[start - usize.ONE] != 46 { start = start - usize.ONE }
  let mut name = Bytes.make()
  while start < shown.length {
    run Bytes.append(&mut name, &[shown[start]])
    start = start + usize.ONE
  }
  return move name
}

// The unknown type or qualifier `name` as a message names it: with the import a commonly used
// standard-library type needs, such as `List; is `import silk.list { List }` missing?`.
effect fn unknownNameText(name: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(name)
  if let Option<string<'static>>.Some {value: declaring} = move standardTypeModule(name) {
    run Bytes.append(&mut text, b"; is `import silk.")
    run Bytes.append(&mut text, String.utf8Bytes(declaring))
    run Bytes.append(&mut text, b" { ")
    run Bytes.append(&mut text, name)
    run Bytes.append(&mut text, b" }` missing?")
  }
  return move text
}

// The standard-library module that declares the commonly used type or interface `name`, which a
// module must import before naming it.
fn standardTypeModule(name: &[u8]) -> Option<string<'static>> {
  if same(name, b"List") { return Option<string<'static>>.some("list") }
  if same(name, b"Option") { return Option<string<'static>>.some("option") }
  if same(name, b"Result") { return Option<string<'static>>.some("result") }
  if same(name, b"Bytes") { return Option<string<'static>>.some("bytes") }
  if same(name, b"String") { return Option<string<'static>>.some("string") }
  if same(name, b"HashMap") { return Option<string<'static>>.some("hash_map") }
  if same(name, b"HashSet") { return Option<string<'static>>.some("hash_set") }
  if same(name, b"Box") { return Option<string<'static>>.some("box") }
  if same(name, b"Shared") { return Option<string<'static>>.some("shared") }
  if same(name, b"Effect") { return Option<string<'static>>.some("effect") }
  if same(name, b"Testing") { return Option<string<'static>>.some("testing") }
  if same(name, b"Copy") || same(name, b"Drop") { return Option<string<'static>>.some("ownership") }
  if same(name, b"Equal") { return Option<string<'static>>.some("equal") }
  if same(name, b"Order") || same(name, b"Ordering") { return Option<string<'static>>.some("order") }
  if same(name, b"HashKey") { return Option<string<'static>>.some("hash") }
  if same(name, b"Display") || same(name, b"Debug") || same(name, b"Format") { return Option<string<'static>>.some("format") }
  if same(name, b"Reflect") { return Option<string<'static>>.some("reflect") }
  if same(name, b"StdoutWriter") || same(name, b"StderrWriter") { return Option<string<'static>>.some("os_writer") }
  return Option<string<'static>>.none()
}

// An unknown name or actor spelled as a primitive (`code` at `span`), whose message asks whether
// `import silk.<name>`, the module that declares the primitive's operations and constants, is missing.
effect fn primitiveImportRejection(code: RejectionCode, module: &ModuleId, span: Span, name: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  let mut hinted = run Bytes.copy(name)
  run Bytes.append(&mut hinted, b"; is `import silk.")
  run Bytes.append(&mut hinted, name)
  run Bytes.append(&mut hinted, b"` missing?")
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: move hinted})
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether `module`'s syntax has frontend errors. A name the parser recovered past, such as `i32`
// in a misparsed `id<i32>` or `?i32`, is no evidence of a missing primitive import.
effect fn syntaxDamaged(resolver: &mut Resolver, module: &ModuleId) -> bool ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    return List<SyntaxDiagnostic>.length(&IndexedSource.authored(value).diagnostics) > usize.ZERO
  }
  return false
}

// Whether `name` spells a primitive type whose operations a `silk.<name>` module declares.
fn primitiveModuleName(name: &[u8]) -> bool {
  return fixedIntegerName(name) || pointerSizedIntegerName(name) || same(name, b"bool") || same(name, b"char")
    || same(name, b"f32") || same(name, b"f64") || same(name, b"string")
}

fn fixedIntegerName(name: &[u8]) -> bool {
  return same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(name, b"i64") || same(
    name,
    b"u8",
  ) || same(name, b"u16") || same(name, b"u32") || same(name, b"u64")
}

fn pointerSizedIntegerName(name: &[u8]) -> bool {
  return same(name, b"isize") || same(name, b"usize")
}

fn scalarType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Unit => true
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"bool") || fixedIntegerName(
      Bytes.asSlice(&name),
    )
    _ => false
  }
}

fn fixedIntegerType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Primitive {name} => fixedIntegerName(Bytes.asSlice(&name))
    _ => false
  }
}

fn pointerSizedIntegerType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Primitive {name} => pointerSizedIntegerName(Bytes.asSlice(&name))
    _ => false
  }
}

fn neverType(typeValue: &Type) -> bool {
  return Type.isNever(typeValue)
}

fn unitOrNever(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Unit => true
    _ => Type.isNever(typeValue)
  }
}

fn scalarCode(typeValue: &Type) -> usize {
  return match & typeValue.* {
    Type.Unit => 1
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      if same(spelling, b"bool") {
        return 2
      }
      if same(spelling, b"i8") {
        return 3
      }
      if same(spelling, b"i16") {
        return 4
      }
      if same(spelling, b"i32") {
        return 5
      }
      if same(spelling, b"i64") {
        return 6
      }
      if same(spelling, b"u8") {
        return 7
      }
      if same(spelling, b"u16") {
        return 8
      }
      if same(spelling, b"u32") {
        return 9
      }
      if same(spelling, b"u64") {
        return 10
      }
      return usize.ZERO
    }
    _ => usize.ZERO
  }
}

// An enum participates in the closed equality contract only when the canonical nominal type
// resolves to a scalar enum declaration. A struct with the same representation has no privilege.
effect fn operatorFamily(resolver: &mut Resolver, ty: &Shared<Type>) -> Operator.Family
! Cycle | OutOfMemoryError
? &mut Allocator {
  let declaring = declaringModuleOrdinal(&resolver.*, ty)
  let mut isScalarEnum = false
  if declaring != usize.MAX {
    let module = resolvedModule(&resolver.*, declaring)
    let ordinal = run ordinalOfProvider(&mut resolver.*, &module, ty)
    if let Option<usize>.Some {value} = move ordinal {
      let written = run scopedHeader(&mut resolver.*, &module, value)
      if let Option<HeaderSyntax>.Some {value: syntax} = move written {
        if let Node.EnumHeader {..} = syntax.header {
          isScalarEnum = true
        }
      }
    }
  }
  return Shared<Type>.with<Operator.Family>(
    ty,
    fn(value: &Type) -> Operator.Family {
      return Operator.family(value, isScalarEnum)
    },
  )
}

fn fitsMagnitude(magnitude: &[u8], maximum: &[u8]) -> bool {
  if magnitude.length != maximum.length {
    return magnitude.length < maximum.length
  }
  let mut at = usize.ZERO
  while at < magnitude.length {
    if magnitude[at] != maximum[at] {
      return magnitude[at] < maximum[at]
    }
    at = at + usize.ONE
  }
  return true
}

// Negative usize literals have their own contract; other integer range failures share SEM0002.
fn integerRangeCode(name: &[u8], sign: Sign) -> RejectionCode {
  if sign == Sign.Negative && same(name, b"usize") {
    return RejectionCode.UsizeNegative
  }
  return RejectionCode.IntegerOutOfRange
}

// An integer literal outside the range of `name` (SEM0002), naming the literal, the type and its
// range; a negative `usize` literal keeps its own code.
effect fn integerRangeRejection(resolver: &Resolver, module: &ModuleId, name: &[u8], sign: Sign, digits: &[u8], span: Span)
  -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let code = integerRangeCode(name, sign)
  let mut diagnostic = run makeRejection(code, module, span)
  if code == RejectionCode.IntegerOutOfRange {
    let wide = resolver.target.pointerBits() == 64
    let high = integerMaximum(name, wide)
    if high.length > usize.ZERO {
      let mut spelling = Bytes.make()
      if sign == Sign.Negative { run Bytes.append(&mut spelling, b"-") }
      run Bytes.append(&mut spelling, digits)
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: move spelling})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: run Bytes.copy(name)})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"minimum"), value: run Bytes.copy(integerMinimum(name, wide))})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"maximum"), value: run Bytes.copy(high)})
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// The value typing already proves for a runtime integer operand: a literal, an embedded static
// value, a constant of the toolchain or another package, or closed integer arithmetic over those.
// A constant of this package stays unknown, because checking never demands its value (see `constantRead`): an
// edit to the value alone never reruns this body, and an initializer that calls back into this
// body cannot cycle. Absent for every other operand.
effect fn knownInteger(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, nodes: &[BodyNode], node: BodyNodeId) -> Option<Shared<StaticData>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let bits = resolver.target.pointerBits()
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Integer {literal}} = &nodes[node.index].kind {
    if let Option<StaticIntegerType>.Some {value: selected} = move StaticExecution.integerType(sharedIntegerName(&ty)) {
      if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, Anchor.hir(&run cursorAnchor(cursor), literal)) {
        let digits = run bodyText(&resolver.source, cursor, magnitude)
        if let Option<u64>.Some {value: parsed} = move StaticExecution.parseMagnitude(Bytes.asSlice(&digits)) {
          let mut signed = StaticSign.Positive
          if sign == Sign.Negative { signed = StaticSign.Negative }
          if let Option<StaticData>.Some {value} = move StaticValue.integer(selected, signed, parsed, bits) {
            return Option<Shared<StaticData>>.some(run Shared<StaticData>.make(move value))
          }
        }
      }
    }
    return Option<Shared<StaticData>>.none()
  }
  if let BodyNodeKind.Expression {form: BodyExpression.Embedded {value}, ..} = &nodes[node.index].kind {
    if staticInteger(&value) { return Option<Shared<StaticData>>.some(Shared<StaticData>.clone(&value)) }
    return Option<Shared<StaticData>>.none()
  }
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Constant {declaration}} = &nodes[node.index].kind {
    if sharedIntegerName(&ty).length == usize.ZERO { return Option<Shared<StaticData>>.none() }
    let local = Shared<DeclarationId>.with<bool>(&declaration, fn(identity: &DeclarationId) -> bool {
      let home = DeclarationId.moduleId(identity)
      return ModuleId.samePackage(home, module) && toolchainModule(home) == toolchainModule(module)
    })
    if local { return Option<Shared<StaticData>>.none() }
    if let Option<Key>.Some {value: constant} = move run constantKey(&mut resolver.*, &declaration) {
      let published = run constantInitializer(&mut resolver.*, &mut owner.*, &mut dependencies.*, constant, Span.make(usize.ZERO, usize.ZERO))
      if let Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value: Option<Shared<StaticData>>.Some {value}} = move published {
        if staticInteger(&value) { return Option<Shared<StaticData>>.some(move value) }
      }
    }
    return Option<Shared<StaticData>>.none()
  }
  if let BodyNodeKind.Expression {form: BodyExpression.ConcretePrefix {operator, operand}, ..} = &nodes[node.index].kind {
    if let Option<Shared<StaticData>>.Some {value: known} = move run knownInteger(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, nodes, operand) {
      if let Result<StaticData, StaticValueFault>.Success {value} = move StaticValue.prefixShared(operator, &known, bits) {
        return Option<Shared<StaticData>>.some(run Shared<StaticData>.make(move value))
      }
    }
    return Option<Shared<StaticData>>.none()
  }
  if let BodyNodeKind.Expression {form: BodyExpression.ConcreteInfix {operator, left, right}, ..} = &nodes[node.index].kind {
    if !integerArithmetic(operator) { return Option<Shared<StaticData>>.none() }
    if let Option<Shared<StaticData>>.Some {value: first} = move run knownInteger(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, nodes, left) {
      if let Option<Shared<StaticData>>.Some {value: second} = move run knownInteger(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, nodes, right) {
        if let Result<StaticData, StaticValueFault>.Success {value} = move StaticValue.infixShared(operator, &first, &second, bits) {
          return Option<Shared<StaticData>>.some(run Shared<StaticData>.make(move value))
        }
      }
    }
  }
  return Option<Shared<StaticData>>.none()
}

fn sharedIntegerName(ty: &Shared<Type>) -> &'static [u8] {
  return Shared<Type>.with<&'static [u8]>(ty, fn(resolved: &Type) -> &'static [u8] { return integerTypeName(resolved) })
}

fn staticInteger(value: &Shared<StaticData>) -> bool {
  return Shared<StaticData>.with<bool>(value, fn(data: &StaticData) -> bool {
    if let StaticData.Integer {..} = &data.* { return true }
    return false
  })
}

fn integerSign(value: &Shared<StaticData>) -> StaticSign {
  return Shared<StaticData>.with<StaticSign>(value, fn(data: &StaticData) -> StaticSign {
    if let StaticData.Integer {sign, ..} = &data.* { return sign }
    return StaticSign.Positive
  })
}

fn integerMagnitude(value: &Shared<StaticData>) -> u64 {
  return Shared<StaticData>.with<u64>(value, fn(data: &StaticData) -> u64 {
    if let StaticData.Integer {magnitude, ..} = &data.* { return magnitude }
    return 0
  })
}

// The integer operators whose closed result is itself an integer.
fn integerArithmetic(operator: InfixOperator) -> bool {
  return operator == InfixOperator.Add || operator == InfixOperator.Subtract || operator == InfixOperator.Multiply ||
    operator == InfixOperator.Divide || operator == InfixOperator.Remainder || operator == InfixOperator.BitAnd ||
    operator == InfixOperator.BitOr || operator == InfixOperator.BitXor
}

// Whether `node`'s form is one `knownInteger` may know, without reading any value.
fn knownIntegerForm(nodes: &[BodyNode], node: BodyNodeId) -> bool {
  if let BodyNodeKind.Expression {form, ..} = &nodes[node.index].kind {
    return match &form {
      BodyExpression.Integer {..} => true
      BodyExpression.Embedded {..} => true
      BodyExpression.Constant {..} => true
      BodyExpression.ConcretePrefix {..} => true
      BodyExpression.ConcreteInfix {operator, ..} => integerArithmetic(operator)
      _ => false
    }
  }
  return false
}

// Integer `/` or `%` whose right operand is the constant zero (SEM0248), or arithmetic whose
// operands are all constants and whose result is outside the type (SEM0247): each traps every time
// it runs, so it is a compile-time error (OP-004). Only an operator whose operands have a form
// `knownInteger` may know reads a value, so other arithmetic costs one look at each operand.
effect fn constantArithmeticTrap(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, nodes: &[BodyNode], operator: InfixOperator, left: BodyNodeId, right: BodyNodeId,
  ty: &Shared<Type>, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if !integerArithmetic(operator) || !knownIntegerForm(nodes, right) { return Option<Shared<Rejection>>.none() }
  let divisor = operator == InfixOperator.Divide || operator == InfixOperator.Remainder
  let leftKnown = knownIntegerForm(nodes, left)
  if !leftKnown && !divisor { return Option<Shared<Rejection>>.none() }
  let second = match move run knownInteger(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, nodes, right) {
    Option<Shared<StaticData>>.Some {value} => move value
    Option<Shared<StaticData>>.None => { return Option<Shared<Rejection>>.none() }
  }
  let rightSign = integerSign(&second)
  let rightMagnitude = integerMagnitude(&second)
  if divisor && rightMagnitude == 0 {
    let mut diagnostic = run makeRejection(RejectionCode.ConstantDivisionByZero, module, span)
    let mut template = b"0"
    if operator == InfixOperator.Remainder { template = b"1" }
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
    return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
  }
  if !leftKnown { return Option<Shared<Rejection>>.none() }
  let first = match move run knownInteger(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, nodes, left) {
    Option<Shared<StaticData>>.Some {value} => move value
    Option<Shared<StaticData>>.None => { return Option<Shared<Rejection>>.none() }
  }
  let folded = StaticValue.infixShared(operator, &first, &second, resolver.target.pointerBits())
  let overflow = match &folded {
    Result<StaticData, StaticValueFault>.Failure {error} => error == StaticValueFault.Overflow
    Result<StaticData, StaticValueFault>.Success {..} => false
  }
  if !overflow { return Option<Shared<Rejection>>.none() }
  let leftSign = integerSign(&first)
  let leftMagnitude = integerMagnitude(&first)
  let mut operation = Bytes.make()
  run appendSigned(&mut operation, leftSign, leftMagnitude)
  run Bytes.append(&mut operation, b" ")
  run Bytes.append(&mut operation, infixSpelling(operator))
  run Bytes.append(&mut operation, b" ")
  run appendSigned(&mut operation, rightSign, rightMagnitude)
  let mut dividend = Bytes.make()
  run appendSigned(&mut dividend, leftSign, leftMagnitude)
  // The mathematical result, when its magnitude fits `u64`; only `MIN / -1` overflows a quotient.
  let mut exact = Option<u64>.none()
  let mut sign = StaticSign.Positive
  if operator == InfixOperator.Divide {
    exact = Option<u64>.some(leftMagnitude)
  } else if operator == InfixOperator.Multiply {
    exact = u64.checkedMultiply(leftMagnitude, rightMagnitude)
    if leftSign != rightSign { sign = StaticSign.Negative }
  } else if operator != InfixOperator.Remainder {
    let mut addend = rightSign
    if operator == InfixOperator.Subtract && rightMagnitude != 0 {
      addend = StaticSign.Negative
      if rightSign == StaticSign.Negative { addend = StaticSign.Positive }
    }
    if leftSign == addend || rightMagnitude == 0 {
      sign = leftSign
      exact = u64.checkedAdd(leftMagnitude, rightMagnitude)
    } else if leftMagnitude >= rightMagnitude {
      sign = leftSign
      exact = Option<u64>.some(leftMagnitude - rightMagnitude)
    } else {
      sign = addend
      exact = Option<u64>.some(rightMagnitude - leftMagnitude)
    }
  }
  let mut value = Bytes.make()
  let mut template = b"1"
  if operator == InfixOperator.Remainder {
    template = b"2"
  } else if let Option<u64>.Some {value: magnitude} = move exact {
    run appendSigned(&mut value, sign, magnitude)
    template = b"0"
  }
  return Option<Shared<Rejection>>.some(run overflowRejection(&resolver.*, module, ty, span, template, move operation, move value, move dividend))
}

// `-` of a constant operand whose negation is outside the type: the minimum signed value (SEM0247).
effect fn constantNegationTrap(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, nodes: &[BodyNode], operator: PrefixOperator, operand: BodyNodeId,
  ty: &Shared<Type>, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if operator != PrefixOperator.Negate || !knownIntegerForm(nodes, operand) { return Option<Shared<Rejection>>.none() }
  let known = match move run knownInteger(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, nodes, operand) {
    Option<Shared<StaticData>>.Some {value} => move value
    Option<Shared<StaticData>>.None => { return Option<Shared<Rejection>>.none() }
  }
  let folded = StaticValue.prefixShared(operator, &known, resolver.target.pointerBits())
  let overflow = match &folded {
    Result<StaticData, StaticValueFault>.Failure {error} => error == StaticValueFault.Overflow
    Result<StaticData, StaticValueFault>.Success {..} => false
  }
  if !overflow { return Option<Shared<Rejection>>.none() }
  let sign = integerSign(&known)
  let magnitude = integerMagnitude(&known)
  let mut operation = run Bytes.copy(b"-(")
  run appendSigned(&mut operation, sign, magnitude)
  run Bytes.append(&mut operation, b")")
  let mut negated = StaticSign.Negative
  if sign == StaticSign.Negative { negated = StaticSign.Positive }
  let mut value = Bytes.make()
  run appendSigned(&mut value, negated, magnitude)
  return Option<Shared<Rejection>>.some(run overflowRejection(&resolver.*, module, ty, span, b"0", move operation, move value, Bytes.make()))
}

// Appends the decimal spelling of a sign and magnitude; zero has no sign.
effect fn appendSigned(output: &mut Bytes, sign: StaticSign, magnitude: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if sign == StaticSign.Negative && magnitude != 0 { run Bytes.append(&mut output.*, b"-") }
  let mut reversed = Bytes.make()
  let mut remaining = magnitude
  run Bytes.append(&mut reversed, &[u64.toU8(48 + u64.remainder(remaining, 10))])
  remaining = remaining / 10
  while remaining != 0 {
    run Bytes.append(&mut reversed, &[u64.toU8(48 + u64.remainder(remaining, 10))])
    remaining = remaining / 10
  }
  let digits = Bytes.asSlice(&reversed)
  let mut at = digits.length
  while at > usize.ZERO {
    at = at - usize.ONE
    run Bytes.append(&mut output.*, &[digits[at]])
  }
  return ()
}

// Reports a receiver call whose callee has static parameters and whose selection supplied none:
// its Body query selects again with these slots, written-argument positions `receivers` before
// the callee's parameter indices. SEM0249 stands only if no selection can supply them.
effect fn discoverStaticCall(resolver: &mut Resolver, signature: &Shared<Result<Answer, NoRejection>>, call: HirId, receivers: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureStaticCount)
  let parameters = run signatureStaticSlots(signature, count)
  let listed = List<usize>.asSlice(&parameters)
  let mut slots = List<usize>.make()
  let mut types = List<Option<Shared<Type>>>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let index = listed[at]
    if index < receivers { return () }
    run List<usize>.append(&mut slots, index - receivers)
    let declared = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, index) })
    let mut closed = Option<Shared<Type>>.none()
    if let Option<Shared<Type>>.Some {value} = move declared {
      if !Type.hasOpenParameters(&value) { closed = Option<Shared<Type>>.some(move value) }
    }
    run List<Option<Shared<Type>>>.append(&mut types, move closed)
    at = at + usize.ONE
  }
  resolver.discoveredStaticCall = Option<StaticCallHint>.some(StaticCallHint {call: call, slots: move slots, types: move types, offset: receivers})
  return ()
}

// A call whose callee's static arguments cannot be selected where it is written (SEM0249), such
// as in a `static fn`: to an interface operation (template 0) or to an inherent method with
// method-call syntax (template 1). A runtime body selects them once its check reports the call.
effect fn staticArgumentsGap(module: &ModuleId, span: Span, template: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.StaticArgumentsThroughCall, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
  return run Shared<Rejection>.make(move diagnostic)
}

// SEM0247 for `operation` at `ty`, naming its exact `value` when one is known and the type's range.
effect fn overflowRejection(resolver: &Resolver, module: &ModuleId, ty: &Shared<Type>, span: Span, template: &[u8],
  operation: Bytes, value: Bytes, dividend: Bytes) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.ConstantOverflow, module, span)
  let name = sharedIntegerName(ty)
  let wide = resolver.target.pointerBits() == 64
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: move operation})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"value"), value: move value})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"dividend"), value: move dividend})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: run Bytes.copy(name)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"minimum"), value: run Bytes.copy(integerMinimum(name, wide))})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"maximum"), value: run Bytes.copy(integerMaximum(name, wide))})
  return run Shared<Rejection>.make(move diagnostic)
}

// The decimal bounds of the integer type `name` on a target whose pointers are 64 bits wide when
// `wide`; empty for any other name.
fn integerMinimum(name: &[u8], wide: bool) -> &'static [u8] {
  if same(name, b"i8") { return b"-128" }
  if same(name, b"i16") { return b"-32768" }
  if same(name, b"i32") || (same(name, b"isize") && !wide) { return b"-2147483648" }
  if same(name, b"i64") || same(name, b"isize") { return b"-9223372036854775808" }
  return b"0"
}

fn integerMaximum(name: &[u8], wide: bool) -> &'static [u8] {
  if same(name, b"i8") { return b"127" }
  if same(name, b"i16") { return b"32767" }
  if same(name, b"i32") || (same(name, b"isize") && !wide) { return b"2147483647" }
  if same(name, b"i64") || same(name, b"isize") { return b"9223372036854775807" }
  if same(name, b"u8") { return b"255" }
  if same(name, b"u16") { return b"65535" }
  if same(name, b"u32") || (same(name, b"usize") && !wide) { return b"4294967295" }
  if same(name, b"u64") || same(name, b"usize") { return b"18446744073709551615" }
  return b""
}

// The spelling of the integer primitive `ty`, or empty for any other type.
fn integerTypeName(ty: &Type) -> &'static [u8] {
  if let Type.Primitive {name} = &ty.* {
    let written = Bytes.asSlice(&name)
    if same(written, b"i8") { return b"i8" }
    if same(written, b"i16") { return b"i16" }
    if same(written, b"i32") { return b"i32" }
    if same(written, b"i64") { return b"i64" }
    if same(written, b"isize") { return b"isize" }
    if same(written, b"u8") { return b"u8" }
    if same(written, b"u16") { return b"u16" }
    if same(written, b"u32") { return b"u32" }
    if same(written, b"u64") { return b"u64" }
    if same(written, b"usize") { return b"usize" }
  }
  return b""
}

fn fitsInteger(target: &MachineTarget, name: &[u8], sign: Sign, magnitude: &[u8]) -> bool {
  if sign == Sign.Negative && magnitude.length == 1 && magnitude[0] == 48 {
    return true
  }
  if same(name, b"isize") {
    return MachineTarget.fitsIsize(target, sign == Sign.Negative, magnitude)
  }
  if same(name, b"usize") {
    return sign != Sign.Negative && MachineTarget.fitsUsize(target, magnitude)
  }
  if same(name, b"i8") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"128")
    }
    return fitsMagnitude(magnitude, b"127")
  }
  if same(name, b"i16") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"32768")
    }
    return fitsMagnitude(magnitude, b"32767")
  }
  if same(name, b"i32") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"2147483648")
    }
    return fitsMagnitude(magnitude, b"2147483647")
  }
  if same(name, b"i64") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"9223372036854775808")
    }
    return fitsMagnitude(magnitude, b"9223372036854775807")
  }
  if sign == Sign.Negative {
    return false
  }
  if same(name, b"u8") {
    return fitsMagnitude(magnitude, b"255")
  }
  if same(name, b"u16") {
    return fitsMagnitude(magnitude, b"65535")
  }
  if same(name, b"u32") {
    return fitsMagnitude(magnitude, b"4294967295")
  }
  if same(name, b"u64") {
    return fitsMagnitude(magnitude, b"18446744073709551615")
  }
  return false
}

effect fn primitiveType(name: &[u8]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Primitive {name: run Bytes.copy(name)})
}

// Character HIR already retains its decoded scalar. Canonical digits reuse integer admission
// without interpreting the authored UTF-8 or escape spelling again.
effect fn characterDigits(scalar: u32) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut digits = List<u8>.make()
  let mut remaining = u32.toU64(scalar)
  while remaining > 0 {
    run List<u8>.insert(&mut digits, usize.ZERO, u64.toU8(48 + u64.remainder(remaining, 10)))
    remaining = u64.divide(remaining, 10)
  }
  if List<u8>.length(&digits) == usize.ZERO { run List<u8>.append(&mut digits, 48) }
  return run Bytes.copy(List<u8>.asSlice(&digits))
}

effect fn intrinsicValueType(kind: IntrinsicValueKind) -> Shared<Type>
! OutOfMemoryError
? &mut Allocator | &mut Types {
  return match kind {
    IntrinsicValueKind.Scalar {scalar} => run primitiveType(ScalarOperation.scalarSpelling(scalar))
    IntrinsicValueKind.Borrowed {scalar} => run Types.intern(Type.Reference {
      access: Access.Shared,
      lifetime: run Shared<Lifetime>.make(Lifetime.Static),
      referent: run primitiveType(ScalarOperation.scalarSpelling(scalar)),
    })
    IntrinsicValueKind.Text => run Types.intern(
      Type.String {lifetime: run Shared<Lifetime>.make(Lifetime.Static)},
    )
    IntrinsicValueKind.StaticText => run Types.intern(
      Type.String {lifetime: run Shared<Lifetime>.make(Lifetime.Static)},
    )
    IntrinsicValueKind.Never => run Types.intern(Type.Union {members: List<Shared<Type>>.make()})
    IntrinsicValueKind.ByteAddress => run CheckedIntrinsic.byteAddressType()
  }
}

// A runtime call to a `static fn` operation, named as written (SEM0176 template 1).
effect fn staticOperationAtRuntime(module: &ModuleId, span: Span, operation: Bytes) -> Result<BodyNodeId, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.StaticPhaseViolation, module, span)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: move operation})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
}

effect fn bodyRejection(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Result<
  BodyNodeId,
  Shared<Rejection>,
> ! OutOfMemoryError ? &mut Allocator {
  return Result<BodyNodeId, Shared<Rejection>>.failResult(run reject(resolver, module, code, span))
}

// Deferred evidence must not become an inference mismatch or a negative conformance proof.
fn unavailableRejection(code: RejectionCode) -> bool {
  if code == RejectionCode.Unsupported { return true }
  return match move BackendGap.forRejection(code) {
    Option<GapCode>.Some {..} => true
    Option<GapCode>.None => false
  }
}

// Pattern annotations share the body's ordinary type-resolution pass. Record them recursively so
// complete applications such as `Cell<i64> { value }` retain their written arguments.
effect fn collectPatternAnnotations(hir: &Module, pattern: HirId, annotations: &mut List<HirId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match Module.node(hir, pattern) {
    Node.NominalPattern {annotation, fields} => {
      run List<HirId>.append(&mut annotations.*, annotation)
      let mut at = usize.ZERO
      while at < fields.length {
        let field = Module.child(hir, fields, at)
        if let Node.PatternField {pattern: nested, ..} = Module.node(hir, field) {
          run collectPatternAnnotations(hir, nested, &mut annotations.*)
        }
        at = at + usize.ONE
      }
    }
    Node.VariantPattern {selector, fields} => {
      if let Node.MemberSelector {subject, ..} = Module.node(hir, selector) {
        run List<HirId>.append(&mut annotations.*, subject)
      }
      if fields.present {
        let mut at = usize.ZERO
        while at < fields.range.length {
          let field = Module.child(hir, fields.range, at)
          if let Node.PatternField {pattern: nested, ..} = Module.node(hir, field) {
            run collectPatternAnnotations(hir, nested, &mut annotations.*)
          }
          at = at + usize.ONE
        }
      }
    }
    Node.BindingPattern {annotation, ..} => {
      if annotation.present { run List<HirId>.append(&mut annotations.*, annotation.id) }
    }
    _ => ()
  }
  return ()
}

// These targets are values checked through their expression, rather than names selected from
// the call table. Discovery must still visit the expression to retain any calls it contains.
// An operator target, such as the `p != 7` that `x |> p != 7` pipes into, is typed as written, so
// its own operand or callee refusal is reported rather than a missing call target.
fn callableExpressionTarget(node: Node) -> bool {
  return match node {
    Node.IdentifierExpression {binding, ..} => binding.present
    Node.CallableExpression {..} => true
    Node.MoveExpression {..} => true
    Node.BorrowExpression {..} => true
    Node.ReferentExpression {..} => true
    Node.PrefixExpression {..} => true
    Node.InfixExpression {..} => true
    Node.CallExpression {..} => true
    Node.MatchExpression {..} => true
    Node.ConditionalStatement {..} => true
    Node.PatternConditionalStatement {..} => true
    _ => false
  }
}

// Qualified names retain the same declaration selection in calls, value construction and
// applied-owner syntax. Bound fields are runtime places and have no declaration reference.
effect fn qualifiedCallReference(hir: &Module, expression: HirId) -> Option<CallReference>
! OutOfMemoryError ? &mut Allocator {
  if let Node.FieldExpression {subject, field} = Module.node(hir, expression) {
    if let Node.IdentifierExpression {name, binding} = Module.node(hir, subject) {
      if !binding.present {
        if let Node.Name {text: namespace} = Module.node(hir, name) {
          if let Node.Name {text: member} = Module.node(hir, field) {
            return Option<CallReference>.some(CallReference.Qualified {
              namespace: run Bytes.copy(Module.text(hir, namespace)), member: run Bytes.copy(Module.text(hir, member)),
              subjectSpan: Module.span(hir, subject), memberSpan: Module.span(hir, field), application: HirRef.absent(),
            })
          }
        }
      }
    }
  }
  if let Node.MemberExpression {selector, fields} = Module.node(hir, expression) {
    if !fields.present {
      if let Node.MemberSelector {subject, member} = Module.node(hir, selector) {
        if let Node.AppliedType {target, ..} = Module.node(hir, subject) {
          if let Node.NamedType {path, hasMode, ..} = Module.node(hir, target) {
            if !hasMode {
              if let Node.Path {segments} = Module.node(hir, path) {
                if segments.length == usize.ONE {
                  if let Node.Name {text: namespace} = Module.node(hir, Module.child(hir, segments, usize.ZERO)) {
                    if let Node.Name {text: memberName} = Module.node(hir, member) {
                      return Option<CallReference>.some(CallReference.Qualified {
                        namespace: run Bytes.copy(Module.text(hir, namespace)), member: run Bytes.copy(Module.text(hir, memberName)),
                        subjectSpan: Module.span(hir, subject), memberSpan: Module.span(hir, member), application: HirRef.of(subject),
                      })
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return Option<CallReference>.none()
}

// A qualified name used as a value selects its declaration through the call table.
effect fn collectQualifiedValue(hir: &Module, expression: HirId, calls: &mut List<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let qualified = run qualifiedCallReference(hir, expression)
  if let Option<CallReference>.Some {value: reference} = move qualified {
    run List<CallSyntax>.append(&mut calls.*, CallSyntax {
        exactItem: false,
      value: true, id: expression, span: Module.span(hir, expression), reference: move reference,
      generics: HirRef.absent(), pipeline: false,
    })
  }
  return ()
}

effect fn collectElements(hir: &Module, elements: Range, annotations: &mut List<HirId>, calls: &mut List<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < elements.length {
    run collectCall(hir, Module.child(hir, elements, at), &mut annotations.*, &mut calls.*)
    at = at + usize.ONE
  }
  return ()
}

effect fn collectInitializers(hir: &Module, fields: Range, annotations: &mut List<HirId>, calls: &mut List<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < fields.length {
    if let Node.FieldInitializer {value, ..} = Module.node(hir, Module.child(hir, fields, at)) {
      run collectCall(hir, value, &mut annotations.*, &mut calls.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// Body typing finds a call's target only in the table this discovery builds, so every expression
// form that can hold a call or a qualified value is listed here and visits each operand it owns.
effect fn collectCall(hir: &Module, expression: HirId, annotations: &mut List<HirId>, calls: &mut List<CallSyntax>) -> ()
! OutOfMemoryError
? &mut Allocator {
  // Calls and pipelines share one authored input shape and record their target first.
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(Module.node(hir, expression)) {
    return run collectInvocation(hir, expression, input, &mut annotations.*, &mut calls.*)
  }
  match Module.node(hir, expression) {
    Node.BorrowExpression {operand, ..} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.MoveExpression {operand} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.RunExpression {operand} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.UnsafeExpression {operand} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.PrefixExpression {operand, ..} => run collectCall(hir, operand, &mut annotations.*, &mut calls.*)
    Node.CompileErrorExpression {message} => run collectCall(hir, message, &mut annotations.*, &mut calls.*)
    Node.ReferentExpression {subject} => run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
    Node.OrdinalExpression {subject, ..} => run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
    Node.InfixExpression {left, right, ..} => {
      run collectCall(hir, left, &mut annotations.*, &mut calls.*)
      run collectCall(hir, right, &mut annotations.*, &mut calls.*)
    }
    Node.IndexExpression {subject, index} => {
      run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
      run collectCall(hir, index, &mut annotations.*, &mut calls.*)
    }
    Node.TupleExpression {elements} => run collectElements(hir, elements, &mut annotations.*, &mut calls.*)
    Node.ArrayExpression {elements} => run collectElements(hir, elements, &mut annotations.*, &mut calls.*)
    Node.ArrayRepeatExpression {value, count} => {
      run collectCall(hir, value, &mut annotations.*, &mut calls.*)
      run collectCall(hir, count, &mut annotations.*, &mut calls.*)
    }
    Node.StructExpression {fields, ..} => run collectInitializers(hir, fields, &mut annotations.*, &mut calls.*)
    Node.RecordExpression {fields} => run collectInitializers(hir, fields, &mut annotations.*, &mut calls.*)
    Node.MemberExpression {fields, ..} => {
      if fields.present {
        run collectInitializers(hir, fields.range, &mut annotations.*, &mut calls.*)
      } else {
        run collectQualifiedValue(hir, expression, &mut calls.*)
      }
    }
    Node.FieldExpression {subject, ..} => {
      run collectQualifiedValue(hir, expression, &mut calls.*)
      run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
    }
    Node.IdentifierExpression {name, binding} => {
      if !binding.present {
        if let Node.Name {text} = Module.node(hir, name) {
          run List<CallSyntax>.append(&mut calls.*, CallSyntax {
        exactItem: false,
            value: true, id: expression, span: Module.span(hir, name),
            reference: CallReference.Unbound {name: run Bytes.copy(Module.text(hir, text))},
            generics: HirRef.absent(), pipeline: false,
          })
        }
      }
    }
    Node.MatchExpression {subject, arms, ..} => {
      run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
      let mut at = usize.ZERO
      while at < arms.length {
        if let Node.MatchArm {pattern, guard, result} = Module.node(hir, Module.child(hir, arms, at)) {
          run collectPatternAnnotations(hir, pattern, &mut annotations.*)
          if guard.present { run collectCall(hir, guard.id, &mut annotations.*, &mut calls.*) }
          // A block arm holds statements, whose calls and annotations its body check will demand.
          if let Node.Block {statements} = Module.node(hir, result) {
            run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
          } else {
            run collectCall(hir, result, &mut annotations.*, &mut calls.*)
          }
        }
        at = at + usize.ONE
      }
    }
    Node.ConditionalStatement {..} => run collectConditional(hir, expression, &mut annotations.*, &mut calls.*)
    Node.PatternConditionalStatement {..} => run collectConditional(hir, expression, &mut annotations.*, &mut calls.*)
    // A literal's own block resolves its facts when the literal is checked (`literalFacts`).
    Node.CallableExpression {..} => ()
    Node.EffectExpression {..} => ()
    // Literals and non-expression nodes hold no call. A damaged `InvalidExpression` deliberately
    // leaves its retained children unvisited: body typing rejects it as a whole without reading
    // the call table. Calls and pipelines were dispatched above.
    _ => ()
  }
  return ()
}

// A call or pipeline records its target, then visits the callee value and every argument.
effect fn collectInvocation(hir: &Module, expression: HirId, input: CallInput, annotations: &mut List<HirId>, calls: &mut List<CallSyntax>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let CallInput {callee, generics, arguments, pipeline} = input
  let mut reference = CallReference.Unsupported
  let mut receiverCall = false

  match Module.node(hir, callee) {
    Node.IdentifierExpression {name, binding} => {
      if binding.present {
        reference = CallReference.NonCallable
        if pipeline { reference = CallReference.CallableValue }
      } else if let Node.Name {text} = Module.node(hir, name) {
        reference = CallReference.Named {name: run Bytes.copy(Module.text(hir, text))}
      }
    }
    Node.FieldExpression {..} => {
      let qualified = run qualifiedCallReference(hir, callee)
      if let Option<CallReference>.Some {value} = move qualified { reference = move value }
      else { receiverCall = true }
    }
    Node.MemberExpression {..} => {
      let qualified = run qualifiedCallReference(hir, callee)
      if let Option<CallReference>.Some {value} = move qualified { reference = move value }
    }
    Node.IntegerLiteral {..} => {
      reference = CallReference.NonCallable
    }
    Node.BooleanLiteral {..} => {
      reference = CallReference.NonCallable
    }
    Node.UnitLiteral => {
      reference = CallReference.NonCallable
    }
    _ => ()
  }
  if pipeline && receiverCall { reference = CallReference.CallableValue }
  if !receiverCall || pipeline {
    let mut targetSpan = Module.span(hir, callee)
    if pipeline { targetSpan = Module.span(hir, expression) }
    run List<CallSyntax>.append(
      &mut calls.*,
      CallSyntax {
        exactItem: false,
        value: false,
        id: expression,
        span: targetSpan,
        reference: move reference,
        generics: generics,
        pipeline: pipeline,
      },
    )
  } else if let Node.FieldExpression {subject, ..} = Module.node(hir, callee) {
    run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
    // A receiver call's written types bind its member's own binders. The member is known only
    // once the receiver is typed, so they resolve in the caller's binders beside its annotations.
    if generics.present {
      if let Node.TypeArguments {arguments: written, ..} = Module.node(hir, generics.id) {
        let mut writtenAt = usize.ZERO
        while writtenAt < written.length {
          let argument = Module.child(hir, written, writtenAt)
          match Module.node(hir, argument) {
            Node.Lifetime {..} => ()
            Node.RequirementSelector {..} => ()
            _ => run List<HirId>.append(&mut annotations.*, argument)
          }
          writtenAt = writtenAt + usize.ONE
        }
      }
    }
  }

  if callableExpressionTarget(Module.node(hir, callee)) {
    run collectCall(hir, callee, &mut annotations.*, &mut calls.*)
  }
  let mut at = usize.ZERO
  while at < CallArguments.length(arguments) {
    run collectCall(hir, CallArguments.child(arguments, hir, at), &mut annotations.*, &mut calls.*)
    at = at + usize.ONE
  }
  return ()
}

// An `if` or `if let` and its whole `else` chain.
effect fn collectConditional(hir: &Module, statement: HirId, annotations: &mut List<HirId>, calls: &mut List<CallSyntax>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut current = HirRef.of(statement)
  while current.present {
    let mut thenBranch = current.id
    let mut elseBranch = HirRef.absent()
    match Module.node(hir, current.id) {
      Node.Block {statements} => {
        run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        return ()
      }
      Node.ConditionalStatement {condition, thenBranch: selected, elseBranch: otherwise} => {
        run collectCall(hir, condition, &mut annotations.*, &mut calls.*)
        thenBranch = selected
        elseBranch = otherwise
      }
      Node.PatternConditionalStatement {pattern, subject, thenBranch: selected, elseBranch: otherwise} => {
        run collectPatternAnnotations(hir, pattern, &mut annotations.*)
        run collectCall(hir, subject, &mut annotations.*, &mut calls.*)
        thenBranch = selected
        elseBranch = otherwise
      }
      _ => { return () }
    }
    if let Node.Block {statements} = Module.node(hir, thenBranch) {
      run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
    }
    current = elseBranch
  }
  return ()
}

effect fn collectBodySyntax(
  hir: &Module,
  written: Range,
  annotations: &mut List<HirId>,
  calls: &mut List<CallSyntax>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < written.length {
    let statement = Module.child(hir, written, at)
    match Module.node(hir, statement) {
      Node.ReturnStatement {value} => {
        if value.present {
          run collectCall(hir, value.id, &mut annotations.*, &mut calls.*)
        }
      }
      Node.ExpressionStatement {expression} => {
        run collectCall(hir, expression, &mut annotations.*, &mut calls.*)
      }
      Node.DropStatement {value} => {
        run collectCall(hir, value, &mut annotations.*, &mut calls.*)
      }
      Node.FailStatement {value, ..} => {
        run collectCall(hir, value, &mut annotations.*, &mut calls.*)
      }
      Node.BindingStatement {isStatic, annotation, initializer, ..} => {
        if !isStatic && annotation.present {
          run List<HirId>.append(&mut annotations.*, annotation.id)
        }
        run collectCall(hir, initializer, &mut annotations.*, &mut calls.*)
      }
      Node.UnsafeStatement {body} => {
        if let Node.Block {statements} = Module.node(hir, body) {
          run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        }
      }
      Node.AssignmentStatement {target, value} => {
        run collectCall(hir, target, &mut annotations.*, &mut calls.*)
        run collectCall(hir, value, &mut annotations.*, &mut calls.*)
      }
      Node.WhileStatement {condition, body} => {
        run collectCall(hir, condition, &mut annotations.*, &mut calls.*)
        if let Node.Block {statements} = Module.node(hir, body) {
          run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        }
      }
      Node.PatternBindingStatement {pattern, initializer} => {
        run collectPatternAnnotations(hir, pattern, &mut annotations.*)
        run collectCall(hir, initializer, &mut annotations.*, &mut calls.*)
      }
      Node.ConditionalStatement {..} => run collectConditional(hir, statement, &mut annotations.*, &mut calls.*)
      Node.PatternConditionalStatement {..} => run collectConditional(hir, statement, &mut annotations.*, &mut calls.*)
      _ => ()
    }
    at = at + usize.ONE
  }
  return ()
}

// Only binders retained by the resolved contract remain writable or need call-site evidence.
// Member-owned parameters and generated lifetimes are distinct from an impl's owner binders.
fn signatureListsBinder(answer: &Result<Answer, NoRejection>, binder: &Binder) -> bool {
  if let Result<Answer, NoRejection>.Success {value: resolved} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &resolved.outcome {
      match &binder.* {
        Binder.Type {value: parameter, ..} => {
          let listed = List<Shared<Type>>.asSlice(&signature.typeParameters)
          let mut at = usize.ZERO
          while at < listed.length {
            if sameReusableType(&parameter, &listed[at]) { return true }
            at = at + usize.ONE
          }
        }
        Binder.Lifetime {value: region, ..} => {
          let listed = List<Shared<Lifetime>>.asSlice(&signature.lifetimeParameters)
          let mut at = usize.ZERO
          while at < listed.length {
            if Lifetime.equalsShared(&region, &listed[at]) { return true }
            at = at + usize.ONE
          }
        }
        Binder.Row {value: parameter, ..} => {
          let listed = List<RowParameter>.asSlice(&signature.rowParameters)
          let mut at = usize.ZERO
          while at < listed.length {
            if parameter.ordinal == listed[at].ordinal && sameDeclarationShared(&parameter.declaration, &listed[at].declaration) {
              return true
            }
            at = at + usize.ONE
          }
        }
      }
    }
  }
  return false
}

fn callArityRejection(parameters: usize, arguments: usize) -> Option<RejectionCode> {
  if arguments > parameters { return Option<RejectionCode>.some(RejectionCode.CallArity) }
  if arguments == usize.ZERO && parameters > usize.ZERO {
    return Option<RejectionCode>.some(RejectionCode.RedundantCall)
  }
  return Option<RejectionCode>.none()
}

// Lifetime parameters a signature declares, as read from its resolved answer.
fn signatureLifetimeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: resolvedAnswer} => match & resolvedAnswer.outcome {
      Outcome.Success {value: Value.Signature {signature: resolved}} => List<
        Shared<Lifetime>,
      >.length(&resolved.lifetimeParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureLifetimeAt(answer: &Result<Answer, NoRejection>, index: usize) -> Option<Shared<Lifetime>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: resolvedAnswer} => match & resolvedAnswer.outcome {
      Outcome.Success {value: Value.Signature {signature: resolved}} => {
        let lifetimes = List<Shared<Lifetime>>.asSlice(&resolved.lifetimeParameters)
        if index < lifetimes.length {
          return Option<Shared<Lifetime>>.some(
            Shared<Lifetime>.clone(&lifetimes[index]),
          )
        }
        return Option<Shared<Lifetime>>.none()
      }
      _ => Option<Shared<Lifetime>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Lifetime>>.none()
  }
}

// Appends an anonymous binder for each signature lifetime the written binders do not cover.
effect fn appendGeneratedLifetimes(
  signature: &Shared<Result<Answer, NoRejection>>,
  binders: &mut List<Binder>,
) -> ()
! OutOfMemoryError
? &mut Allocator {
  let totalLifetimes = Shared<Result<Answer, NoRejection>>.with<usize>(
    signature,
    signatureLifetimeCount,
  )
  let mut generatedAt = writtenLifetimeCount(List<Binder>.asSlice(&binders.*))
  while generatedAt < totalLifetimes {
    let generated = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> {
        return signatureLifetimeAt(answer, generatedAt)
      },
    )
    if let Option<Shared<Lifetime>>.Some {value: generatedLifetime} = move generated {
      run List<Binder>.append(
        &mut binders.*,
        Binder.Lifetime {name: Bytes.make(), value: move generatedLifetime},
      )
    }
    generatedAt = generatedAt + usize.ONE
  }
}

// The binders a prefix may write for a declaration that refines its enclosing scope: the
// enclosing binders its signature lists, then its own binders the enclosing scope does not name.
effect fn callableBinders(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  target: &ModuleId,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  binders: &List<Binder>,
) -> Result<List<Binder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let targetModule = knownModuleOrdinal(&resolver.*, target)
  if targetModule == usize.MAX { fail InvalidModulePath {} }
  let inherited = run enclosingScope(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, targetModule, target, ordinal,
  )
  let enclosing = match move inherited {
    Result<List<Binder>, Shared<Rejection>>.Success {value: inheritedBinders} => move inheritedBinders
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result<List<Binder>, Shared<Rejection>>.failResult(move error)
    }
  }
  let visible = List<Binder>.asSlice(&enclosing)
  let mut callable = List<Binder>.make()
  let mut at = usize.ZERO
  while at < visible.length {
    if Shared<Result<Answer, NoRejection>>.with<bool>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return signatureListsBinder(answer, &visible[at])
      },
    ) {
      run List<Binder>.append(&mut callable, run copyBinder(&visible[at]))
    }
    at = at + usize.ONE
  }
  let own = List<Binder>.asSlice(&binders.*)
  at = usize.ZERO
  while at < own.length {
    if !hasBinder(visible, binderName(&own[at])) {
      run List<Binder>.append(&mut callable, run copyBinder(&own[at]))
    }
    at = at + usize.ONE
  }
  return Result<List<Binder>, Shared<Rejection>>.succeed(move callable)
}

// The first binder at or after `start` in the lifetime namespace or the ordinary one.
fn nextBinderOfKind(formal: &[Binder], start: usize, lifetime: bool) -> usize {
  let mut at = start
  while at < formal.length {
    let isLifetime = binderKind(&formal[at]) == GenericKind.Lifetime
    if isLifetime == lifetime {
      return at
    }
    at = at + usize.ONE
  }
  return formal.length
}

fn binderCountOfKind(formal: &[Binder], lifetime: bool) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < formal.length {
    let isLifetime = binderKind(&formal[at]) == GenericKind.Lifetime
    if isLifetime == lifetime {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// The binder each written argument fixes (GEN-007). Lifetime arguments and ordinary (type, row,
// static) arguments are separate namespaces: each takes the next binder of its own kind, so an
// unwritten lifetime stays an inference variable wherever it appears. A written `? R` suffix
// continues the ordinary namespace and is the last ordinal when `suffix` is set.
effect fn writtenBinderOrdinals(
  resolver: &mut Resolver,
  module: &ModuleId,
  arguments: Range,
  span: Span,
  formal: &[Binder],
  suffix: bool,
  /// Where a wrong argument count is reported: the whole call, or a constructor's type name (SEM0051).
  aritySpan: Span,
) -> Result<List<usize>, Shared<Rejection>>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut writtenLifetimes = usize.ZERO
  let mut at = usize.ZERO
  while at < arguments.length {
    let supplied = run suppliedArgument(&mut resolver.*, module, arguments, at, span)
    if supplied.kind == GenericKind.Lifetime {
      writtenLifetimes = writtenLifetimes + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut ordinals = List<usize>.make()
  let mut lifetimeAt = usize.ZERO
  let mut ordinaryAt = usize.ZERO
  at = usize.ZERO
  while at < arguments.length {
    let supplied = run suppliedArgument(&mut resolver.*, module, arguments, at, span)
    let lifetime = supplied.kind == GenericKind.Lifetime
    let mut formalAt = usize.ZERO
    if lifetime {
      formalAt = nextBinderOfKind(formal, lifetimeAt, true)
      lifetimeAt = formalAt + usize.ONE
    } else {
      formalAt = nextBinderOfKind(formal, ordinaryAt, false)
      ordinaryAt = formalAt + usize.ONE
    }
    if formalAt == formal.length {
      // A declaration with no binder of the written kind reports the kind of the binder the
      // argument would otherwise reach; an exhausted namespace reports its own arity.
      let other = nextBinderOfKind(formal, usize.ZERO, true)
      if lifetime {
        let ordinary = nextBinderOfKind(formal, ordinaryAt, false)
        if binderCountOfKind(formal, true) == usize.ZERO && ordinary < formal.length {
          return Result<List<usize>, Shared<Rejection>>.failResult(
            run rejectKind(&resolver.*, module, supplied.span, binderName(&formal[ordinary]), binderKind(&formal[ordinary]), supplied.kind),
          )
        }
      } else if binderCountOfKind(formal, false) == usize.ZERO && other < formal.length {
        return Result<List<usize>, Shared<Rejection>>.failResult(
          run rejectKind(&resolver.*, module, supplied.span, binderName(&formal[other]), GenericKind.Lifetime, supplied.kind),
        )
      }
      let mut written = arguments.length - writtenLifetimes
      if lifetime {
        written = writtenLifetimes
      }
      return Result<List<usize>, Shared<Rejection>>.failResult(
        run rejectArity(&resolver.*, module, aritySpan, binderCountOfKind(formal, lifetime), written),
      )
    }
    run List<usize>.append(&mut ordinals, formalAt)
    at = at + usize.ONE
  }
  if suffix {
    run List<usize>.append(&mut ordinals, nextBinderOfKind(formal, ordinaryAt, false))
  }
  return Result<List<usize>, Shared<Rejection>>.succeed(move ordinals)
}

// Whether `binder` is a `?S` that some `provides` bound of the signature uses as its selector, so
// an explicit argument for it names an access-free service-role key (SERV-007).
fn selectsBinder(answer: &Result<Answer, NoRejection>, binder: &Binder) -> bool {
  if let Binder.Row {value: parameter, ..} = &binder.* {
    if let Result<Answer, NoRejection>.Success {value} = &answer.* {
      if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
        let constraints = List<Constraint>.asSlice(&signature.constraints)
        let mut at = usize.ZERO
        while at < constraints.length {
          if let Constraint.Provides {selector, ..} = &constraints[at] {
            let ordinal = Shared<Row>.with<usize>(
              &selector,
              fn(row: &Row) -> usize {
                return selectorOrdinalIn(row, &parameter.declaration)
              },
            )
            if ordinal == parameter.ordinal {
              return true
            }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  return false
}

// Resolves the written generic argument at `at` against its formal binder and appends it.
effect fn appendWrittenArgument(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  callerOrdinal: usize,
  caller: &ModuleId,
  arguments: Range,
  formal: &[Binder],
  at: usize,
  formalAt: usize,
  scope: &[Binder],
  elision: &mut LifetimeElision,
  selector: bool,
  explicit: &mut List<Argument>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let child = run typeChild(&mut resolver.*, caller, arguments, at)
  let argument = match move child {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return Option<Shared<Rejection>>.none()
    }
  }
  let source = run typeNode(&mut resolver.*, caller, argument)
  let found = match move source {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Option<Shared<Rejection>>.none()
    }
  }
  let mut supplied = GenericKind.Type
  if let Node.Lifetime {..} = found.header {
    supplied = GenericKind.Lifetime
  }
  if let Node.RequirementSelector {..} = found.header {
    supplied = GenericKind.Requirement
  }
  let expected = binderKind(&formal[formalAt])
  if (expected == GenericKind.Type && supplied != GenericKind.Type) || (expected == GenericKind.Lifetime && supplied != GenericKind.Lifetime) || (expected == GenericKind.Requirement && supplied == GenericKind.Lifetime) {
    return Option<Shared<Rejection>>.some(
      run rejectKind(
        &resolver.*,
        caller,
        found.span,
        binderName(&formal[formalAt]),
        expected,
        supplied,
      ),
    )
  }
  if expected == GenericKind.Type {
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      callerOrdinal,
      argument,
      scope,
      &mut elision.*,
    )
    match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
        run List<Argument>.append(&mut explicit.*, Argument.Type {value: move ty})
      }
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option<Shared<Rejection>>.some(move error)
      }
    }
  } else if expected == GenericKind.Lifetime {
    let resolved = run lifetimeAt(&mut resolver.*, caller, argument, scope)
    match move resolved {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
        run List<Argument>.append(
          &mut explicit.*,
          Argument.Lifetime {value: move lifetime},
        )
      }
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Option<Shared<Rejection>>.some(move error)
      }
    }
  } else {
    let mut row = Row.empty()
    let added = run rowArgument(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      callerOrdinal,
      caller,
      argument,
      binderName(&formal[formalAt]),
      scope,
      &mut elision.*,
      selector,
      &mut row,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
      return Option<Shared<Rejection>>.some(move diagnostic)
    }
    run List<Argument>.append(
      &mut explicit.*,
      Argument.Row {value: run Shared<Row>.make(move row)},
    )
  }
  return Option<Shared<Rejection>>.none()
}

// Resolves a written requirement suffix into the one writable row binder that follows the
// positional arguments.
effect fn appendRequirementsSuffix(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  callerOrdinal: usize,
  caller: &ModuleId,
  formal: &[Binder],
  argumentCount: usize,
  requirements: HirRef,
  span: Span,
  /// Where a wrong argument count is reported: the whole call, or a constructor's type name (SEM0051).
  aritySpan: Span,
  scope: &[Binder],
  elision: &mut LifetimeElision,
  explicit: &mut List<Argument>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if rowBinderCount(formal) > usize.ONE {
    // The reference does not define a suffix when more than one row remains writable.
    return Option<Shared<Rejection>>.some(
      run reject(&resolver.*, caller, RejectionCode.Unsupported, span),
    )
  }
  if argumentCount == formal.length {
    return Option<Shared<Rejection>>.some(
      run rejectArity(
        &resolver.*,
        caller,
        aritySpan,
        formal.length,
        argumentCount + usize.ONE,
      ),
    )
  }
  if binderKind(&formal[argumentCount]) != GenericKind.Requirement {
    return Option<Shared<Rejection>>.some(
      run rejectKind(
        &resolver.*,
        caller,
        span,
        binderName(&formal[argumentCount]),
        binderKind(&formal[argumentCount]),
        GenericKind.Requirement,
      ),
    )
  }
  let resolved = run resolveChannels(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    callerOrdinal,
    caller,
    HirRef.absent(),
    requirements,
    scope,
    &mut elision.*,
  )
  match move resolved {
    Result<Channels, Shared<Rejection>>.Success {value: channels} => {
      run List<Argument>.append(
        &mut explicit.*,
        Argument.Row {value: move channels.requirements},
      )
    }
    Result<Channels, Shared<Rejection>>.Failure {error} => {
      return Option<Shared<Rejection>>.some(move error)
    }
  }
  return Option<Shared<Rejection>>.none()
}

fn callPrefixSlot(binder: &Binder) -> CallPrefixSlot {
  return match &binder.* {
    Binder.Type {value, ..} => CallPrefixSlot.Type {value: Shared<Type>.clone(&value)}
    Binder.Lifetime {value, ..} => CallPrefixSlot.Lifetime {value: Shared<Lifetime>.clone(&value)}
    Binder.Row {value, ..} => CallPrefixSlot.Row {value: RowParameter {
      declaration: Shared<DeclarationId>.clone(&value.declaration), ordinal: value.ordinal}}
  }
}

fn copyCallPrefixOwner(owner: &Option<Shared<DeclarationId>>) -> Option<Shared<DeclarationId>> {
  return match &owner.* {
    Option<Shared<DeclarationId>>.Some {value} => Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&value))
    Option<Shared<DeclarationId>>.None => Option<Shared<DeclarationId>>.none()
  }
}

effect fn copyCallPrefixSlots(slots: &[CallPrefixSlot]) -> List<CallPrefixSlot>
! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<CallPrefixSlot>.make()
  let mut at = usize.ZERO
  while at < slots.length {
    let value = match &slots[at] {
      CallPrefixSlot.Type {value} => CallPrefixSlot.Type {value: Shared<Type>.clone(&value)}
      CallPrefixSlot.Lifetime {value} => CallPrefixSlot.Lifetime {value: Shared<Lifetime>.clone(&value)}
      CallPrefixSlot.Row {value} => CallPrefixSlot.Row {value: RowParameter {
        declaration: Shared<DeclarationId>.clone(&value.declaration), ordinal: value.ordinal}}
    }
    run List<CallPrefixSlot>.append(&mut copied, move value)
    at = at + usize.ONE
  }
  return move copied
}

fn callPrefixSlotOrdinal(slot: &CallPrefixSlot, owner: &DeclarationId) -> usize {
  return match &slot.* {
    CallPrefixSlot.Type {value} => Shared<Type>.with<usize>(&value,
      fn(parameter: &Type) -> usize { return Type.parameterOrdinalOf(parameter, owner) })
    CallPrefixSlot.Lifetime {value} => ownedLifetimeOrdinal(&value, owner)
    CallPrefixSlot.Row {value} => {
      if Shared<DeclarationId>.with<bool>(&value.declaration, fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, owner) }) { return value.ordinal }
      return usize.MAX
    }
  }
}

effect fn callPrefixInferenceOrdinal(slot: &CallPrefixSlot, schema: &TargetSchema,
  signature: &Shared<Result<Answer, NoRejection>>, opened: &Shared<Result<Answer, NoRejection>>)
  -> usize ! OutOfMemoryError ? &mut Allocator {
  let owner = DeclarationId.copyShared(&schema.declaration)
  let ordinal = callPrefixSlotOrdinal(slot, &owner)
  if ordinal != usize.MAX { return sectionInferenceOrdinal(schema, opened, ordinal) }
  let scopes = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut at = usize.ZERO
  while at < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[at].owner)
    let ordinal = callPrefixSlotOrdinal(slot, &owner)
    if ordinal != usize.MAX { return run sectionScopeInferenceOrdinal(schema, signature, &owner, ordinal) }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A written call prefix fixes binders like an aggregate prefix: lifetime and ordinary arguments
// are mapped in separate namespaces (`writtenBinderOrdinals`), and every unwritten binder is an
// inference variable.
effect fn resolveCallPrefix(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  callerOrdinal: usize,
  caller: &ModuleId,
  target: &ModuleId,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  written: HirRef,
  scope: &[Binder],
  constraints: &[Constraint],
  seed: CallPrefix,
  /// The whole call, where a wrong explicit argument count is reported (SEM0051).
  callSpan: Span,
) -> Result<CallPrefix, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // A written owner application seeds the prefix with the enclosing binders it fixes and the
  // regions it omits; the member's own written list then binds only the member's own binders.
  let CallPrefix {arguments: seeded, slots: seededSlots, owner: seededOwner, lifetimes: seededLifetimes} = move seed
  let ownerApplied = match &seededOwner {
    Option<Shared<DeclarationId>>.Some {..} => true
    Option<Shared<DeclarationId>>.None => false
  }
  let mut explicit = move seeded
  let mut slots = move seededSlots
  if !written.present {
    return Result<CallPrefix, Shared<Rejection>>.succeed(CallPrefix {arguments: move explicit, slots: move slots, owner: move seededOwner, lifetimes: seededLifetimes})
  }
  let source = run typeNode(&mut resolver.*, caller, written.id)
  let value = match move source {
    Option<HeaderSyntax>.Some {value: syntax} => syntax
    Option<HeaderSyntax>.None => {
      return Result<CallPrefix, Shared<Rejection>>.failResult(
        run reject(&resolver.*, caller, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
      )
    }
  }
  if let Node.TypeArguments {arguments, environment, failures, requirements} = value.header {
    let template = run templateBinders(&mut resolver.*, target, ordinal)
    let mut binders = match move template {
      Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return Result<CallPrefix, Shared<Rejection>>.failResult(move error)
      }
    }
    if !ownerApplied && run refinesEnclosing(&mut resolver.*, target, ordinal) {
      let callable = run callableBinders(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, target, ordinal, signature, &binders,
      )
      binders = match move callable {
        Result<List<Binder>, Shared<Rejection>>.Success {value: found} => move found
        Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
          return Result<CallPrefix, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    run appendGeneratedLifetimes(signature, &mut binders)
    let formal = List<Binder>.asSlice(&binders)
    if environment.present || failures.present {
      let mut supplied = GenericKind.Lifetime
      if failures.present {
        supplied = GenericKind.Failure
      }
      return Result<CallPrefix, Shared<Rejection>>.failResult(
        run rejectKind(&resolver.*, caller, value.span, b"", GenericKind.Type, supplied),
      )
    }
    let declaredAnswer = run declarationAt(&mut resolver.*, target, ordinal)
    let declared = match move declaredAnswer {
      Option<DeclarationId>.Some {value: prefixDeclaration} => move prefixDeclaration
      _ => { fail RevisionMismatch {} }
    }
    let mut prefixScope = Bytes.make()
    run Bytes.append(&mut prefixScope, b"\0call-prefix-lifetimes")
    run RuntimeEncoding.word(&mut prefixScope, usize.toU64(callerOrdinal))
    run RuntimeEncoding.word(&mut prefixScope, usize.toU64(written.id.index))
    let prefixOwner = match move seededOwner {
      Option<Shared<DeclarationId>>.Some {value: seededPrefixOwner} => DeclarationId.copyShared(&seededPrefixOwner)
      Option<Shared<DeclarationId>>.None => run DeclarationId.inference(&declared, Bytes.asSlice(&prefixScope))
    }
    let mut elision = LifetimeElision {
      owner: Option<DeclarationId>.some(DeclarationId.copy(&prefixOwner)),
      nextOrdinal: seededLifetimes,
      output: false,
      resultDefault: Option<Shared<Lifetime>>.none(),
      generated: List<Shared<Lifetime>>.make(),
      invocation: false,
      nested: false,
      renumber: List<usize>.make(),
      staticEnvironment: false,
      supplied: Option<List<Argument>>.none(),
      assumptions: Option<List<Constraint>>.some(run copyConstraints(constraints)),
      deferred: Option<List<DeferredBounds>>.none(),
    }
    let mapped = run writtenBinderOrdinals(&mut resolver.*, caller, arguments, value.span, formal, requirements.present, callSpan)
    let positions = match move mapped {
      Result<List<usize>, Shared<Rejection>>.Success {value: found} => move found
      Result<List<usize>, Shared<Rejection>>.Failure {error} => {
        // A list that does not fit an interface or service operation's own binders may name its
        // contract's parameters, the documented unsupported generic interface-operation prefix
        // lane, not a kind or arity mismatch.
        let enclosing = run enclosingIdentity(&mut resolver.*, target, ordinal)
        if let Option<DeclarationId>.Some {value: contract} = move enclosing {
          let contractKind = DeclarationId.kind(&contract)
          if contractKind == OwnerKind.Interface || contractKind == OwnerKind.Service {
            return Result<CallPrefix, Shared<Rejection>>.failResult(run genericOperationRejection(caller, value.span, &declared))
          }
        }
        return Result<CallPrefix, Shared<Rejection>>.failResult(move error)
      }
    }
    let targets = List<usize>.asSlice(&positions)
    let mut at = usize.ZERO
    while at < arguments.length {
      let formalAt = targets[at]
      let selector = Shared<Result<Answer, NoRejection>>.with<bool>(
        signature,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return selectsBinder(answer, &formal[formalAt])
        },
      )
      let failure = run appendWrittenArgument(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, callerOrdinal, caller, arguments,
        formal, at, formalAt, scope, &mut elision, selector, &mut explicit,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result<CallPrefix, Shared<Rejection>>.failResult(move diagnostic)
      }
      run List<CallPrefixSlot>.append(&mut slots, callPrefixSlot(&formal[formalAt]))
      at = at + usize.ONE
    }
    if requirements.present {
      let suffixAt = targets[arguments.length]
      let failure = run appendRequirementsSuffix(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, callerOrdinal, caller, formal,
        suffixAt, requirements, value.span, callSpan, scope, &mut elision, &mut explicit,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result<CallPrefix, Shared<Rejection>>.failResult(move diagnostic)
      }
      run List<CallPrefixSlot>.append(&mut slots, callPrefixSlot(&formal[suffixAt]))
    }
    let mut pending = Option<Shared<DeclarationId>>.none()
    if elision.nextOrdinal != usize.ZERO { pending = Option<Shared<DeclarationId>>.some(run Shared<DeclarationId>.make(move prefixOwner)) }
    return Result<CallPrefix, Shared<Rejection>>.succeed(CallPrefix {arguments: move explicit, slots: move slots,
      owner: move pending, lifetimes: elision.nextOrdinal})
  }
  return Result<CallPrefix, Shared<Rejection>>.failResult(
    run reject(&resolver.*, caller, RejectionCode.Unsupported, value.span),
  )
}

// Static aggregate reflection and raw-pointer primitives take their contracts from exactly
// their written type arguments, resolved in the caller's binders; the sealed contract is
// otherwise closed.
effect fn typedIntrinsicTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  member: IntrinsicMember,
  generics: HirRef,
  span: Span,
  /// The whole call, where a wrong explicit argument count is reported (SEM0051).
  callSpan: Span,
  scope: &[Binder],
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let count = intrinsicTypeArity(member)
  if !generics.present {
    if intrinsicIsPrimitive(member, IntrinsicPrimitive.BorrowField) || intrinsicIsPrimitive(member, IntrinsicPrimitive.BorrowFieldMut) ||
      intrinsicIsPrimitive(member, IntrinsicPrimitive.MakeVariant) || intrinsicIsPrimitive(member, IntrinsicPrimitive.IsVariant) {
      return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Intrinsic {
        member: member, typeArguments: List<Shared<Type>>.make(),
      })
    }
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, callSpan, count, usize.ZERO))
  }
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.none(),
    nextOrdinal: usize.ZERO,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let written = run typeNode(&mut resolver.*, module, generics.id)
  if let Option<HeaderSyntax>.Some {value: found} = move written {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != count {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, callSpan, count, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let mut typeArguments = List<Shared<Type>>.make()
      let mut at = usize.ZERO
      while at < count {
        let child = run typeChild(&mut resolver.*, module, supplied, at)
        let argument = match move child {
          Option<HirId>.Some {value} => value
          Option<HirId>.None => {
            return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
          }
        }
        let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, scope, &mut elision)
        let described = match move resolved {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
            return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
          }
        }
        run List<Shared<Type>>.append(&mut typeArguments, move described)
        at = at + usize.ONE
      }
      return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Intrinsic {member: member, typeArguments: move typeArguments})
    }
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// A storage primitive's contract is instantiated from exactly its written type arguments, resolved
// in the caller's binders. `replace` may omit its one type argument and takes it from its place.
effect fn storageTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, moduleOrdinal: usize, operation: StorageOperation,
  generics: HirRef, scope: &[Binder], span: Span, callSpan: Span) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = StorageOperation.typeArity(operation)
  let mut typeArguments = List<Shared<Type>>.make()
  if !generics.present {
    if count != usize.ZERO && operation != StorageOperation.Replace {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, callSpan, count, usize.ZERO))
    }
    return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Storage {operation: operation,
      typeArguments: move typeArguments})
  }
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.none(), nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option<Shared<Lifetime>>.none(), generated: List<Shared<Lifetime>>.make(), invocation: false,
    nested: false, renumber: List<usize>.make(), staticEnvironment: false,
    supplied: Option<List<Argument>>.none(), assumptions: Option<List<Constraint>>.none(), deferred: Option<List<DeferredBounds>>.none(),
  }
  let syntax = run typeNode(&mut resolver.*, module, generics.id)
  if let Option<HeaderSyntax>.Some {value: found} = move syntax {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != count {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, callSpan, count, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let mut at = usize.ZERO
      while at < count {
        let argument = match move run typeChild(&mut resolver.*, module, supplied, at) {
          Option<HirId>.Some {value} => value
          Option<HirId>.None => { return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span)) }
        }
        match move run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, scope, &mut elision) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => { run List<Shared<Type>>.append(&mut typeArguments, move value) }
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error) }
        }
        at = at + usize.ONE
      }
      return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Storage {operation: operation,
        typeArguments: move typeArguments})
    }
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// A composition intrinsic's written arguments: the caught failure subset of `catchFailure`, the
// service-role key a binding serves, or the optional `<A, E, ?R, ?S>` of a finalizer (preceded by
// `Resource` for `useReleaseNonParking`).
fn bindingComposition(operation: Composition) -> bool {
  return operation == Composition.BindShared || operation == Composition.BindExclusive || operation == Composition.BindOwned
}

effect fn compositionTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, moduleOrdinal: usize, operation: Composition,
  generics: HirRef, scope: &[Binder], span: Span, callSpan: Span) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut arity = usize.ONE
  if operation == Composition.Finalize || operation == Composition.FinalizeNonParking { arity = 4 }
  if operation == Composition.UseRelease { arity = 5 }
  if operation == Composition.Observe { arity = 4 }
  // A suspension infers its channels from the deferred Effect and writes no type arguments.
  if operation == Composition.Suspend { arity = usize.ZERO }
  let mut written = List<Argument>.make()
  if !generics.present {
    // Finalizers, observations and provision selectors infer from their operands.
    if operation == Composition.CatchFailure {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, callSpan, usize.ONE, usize.ZERO))
    }
    return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Composition {operation: operation, written: move written})
  }
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.none(), nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option<Shared<Lifetime>>.none(), generated: List<Shared<Lifetime>>.make(), invocation: false,
    nested: false, renumber: List<usize>.make(), staticEnvironment: false,
    supplied: Option<List<Argument>>.none(), assumptions: Option<List<Constraint>>.none(), deferred: Option<List<DeferredBounds>>.none(),
  }
  let syntax = run typeNode(&mut resolver.*, module, generics.id)
  if let Option<HeaderSyntax>.Some {value: found} = move syntax {
    if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
      if supplied.length != arity {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, callSpan, arity, supplied.length))
      }
      if environment.present || failures.present || requirements.present {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span))
      }
      let mut at = usize.ZERO
      while at < arity {
        let child = run typeChild(&mut resolver.*, module, supplied, at)
        let argument = match move child {
          Option<HirId>.Some {value} => value
          Option<HirId>.None => { return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, found.span)) }
        }
        // A binding selects one service-role key (SERV-007), carried as a row.
        if bindingComposition(operation) {
          let mut keys = Row.empty()
          let failed = run rowArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, argument,
            b"S", scope, &mut elision, true, &mut keys)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<ResolvedTarget, Shared<Rejection>>.failResult(move value) }
          run List<Argument>.append(&mut written, Argument.Row {value: run Shared<Row>.make(move keys)})
        } else if (operation == Composition.Observe && at == 2) || (operation != Composition.CatchFailure &&
          operation != Composition.Observe && at + 2 >= arity) {
          let mut row = Row.empty()
          let failed = run rowArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, argument,
            b"", scope, &mut elision, false, &mut row)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<ResolvedTarget, Shared<Rejection>>.failResult(move value) }
          run List<Argument>.append(&mut written, Argument.Row {value: run Shared<Row>.make(move row)})
        } else {
          let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, argument, scope, &mut elision)
          match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => { run List<Argument>.append(&mut written, Argument.Type {value: move value}) }
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error) }
          }
        }
        at = at + usize.ONE
      }
      return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Composition {operation: operation, written: move written})
    }
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
}

// Reads the single type a tuple element shape answers with.
fn singleMemberShapeType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: shapedAnswer} => match & shapedAnswer.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let fields = List<Shared<Type>>.asSlice(&types)
        if fields.length == usize.ONE {
          return Option<Shared<Type>>.some(Shared<Type>.clone(&fields[usize.ZERO]))
        }
        return Option<Shared<Type>>.none()
      }
      _ => Option<Shared<Type>>.none()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option<Shared<Type>>.none()
  }
}

// The arity rejection for a written call against the signature it selected, if any.
effect fn writtenCallArityRejection(
  resolver: &mut Resolver,
  module: &ModuleId,
  syntax: &CallSyntax,
  signature: &Shared<Result<Answer, NoRejection>>,
) -> Option<RejectionCode>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let writtenCall = run typeNode(&mut resolver.*, module, syntax.id)
  let callSyntax = match move writtenCall {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Option<RejectionCode>.none()
    }
  }
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(callSyntax.header) {
    let arguments = input.arguments
    let parameters = Shared<Result<Answer, NoRejection>>.with<usize>(
      signature, signatureParameterCount,
    )
    return callArityRejection(parameters, CallArguments.length(arguments))
  }
  return Option<RejectionCode>.none()
}

// Resolves a `Type.member(...)` call whose inherent lookup selected `selectedTarget`.
effect fn inherentSelectedCallTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  qualifier: &SelectedDeclaration,
  qualifierModule: &ModuleId,
  selectedTarget: CallTarget,
  ownerPrefix: CallPrefix,
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut target = move selectedTarget
  let targetIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(&target.declaration))
  let targetOrdinal = run ordinalOfIdentity(
    &mut resolver.*, qualifierModule, &targetIdentity)
  let ordinal = match move targetOrdinal {
    Option<usize>.Some {value: selectedOrdinal} => selectedOrdinal
    Option<usize>.None => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, memberSpan),
      )
    }
  }
  let shape = run writtenCallArityRejection(&mut resolver.*, module, syntax, &target.signature)
  if let Option<RejectionCode>.Some {value: reason} = move shape {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, reason, span),
    )
  }
  let callSpan = run staticSpan(&mut resolver.*, module, syntax.id)
  let prefix = run resolveCallPrefix(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    module, qualifierModule, ordinal, &target.signature, syntax.generics, scope, constraints, move ownerPrefix, callSpan,
  )
  target.explicitSyntax = syntax.generics.present || target.explicitSyntax
  let written = match move prefix {
    Result<CallPrefix, Shared<Rejection>>.Success {value: prefixArguments} => move prefixArguments
    Result<CallPrefix, Shared<Rejection>>.Failure {error} => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  target.explicit = move written.arguments
  target.explicitSlots = move written.slots
  target.prefixOwner = move written.owner
  target.prefixLifetimes = written.lifetimes
  return Result<ResolvedTarget, Shared<Rejection>>.succeed(
    ResolvedTarget.Function {target: move target},
  )
}

// A service operation call target. The operation keeps its own signature; the service's binders
// are supplied by the written qualifier application, and the provider is not an argument.
effect fn serviceOperationTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  qualifier: &SelectedDeclaration,
  qualifierModule: &ModuleId,
  operation: usize,
  applied: Option<Shared<Type>>,
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let declarationAccess103Request = Key {
    family: Family.Operations, module: qualifier.module, name: usize.ZERO, declaration: qualifier.ordinal,
    member: usize.ZERO, external: false,
  }
  let declarationAccess103 = run internDeclaration(&mut resolver.*, declarationAccess103Request)
  let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess103, memberSpan)
  let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(move value)
  }
  // A written service application fixes the service's binders in the operation's signature; the
  // provider is not an argument, so the service's own `Self` stays in its place.
  let declarationAccess104Request = Key {
    family: Family.Signature, module: qualifier.module, name: usize.ZERO, declaration: operation,
    member: usize.ZERO, external: false,
  }
  let declarationAccess104 = run internDeclaration(&mut resolver.*, declarationAccess104Request)
  let mut signatureKey = declarationAccess104
  if let Option<Shared<Type>>.Some {value: serviceType} = &applied {
    let serviceIdentity = match move run declarationAt(&mut resolver.*, qualifierModule, qualifier.ordinal) {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan))
      }
    }
    let serviceBinders = Shared<Type>.with<usize>(&serviceType, applicationLength)
    let selfType = run Types.intern(Type.Parameter {declaration: move serviceIdentity, ordinal: serviceBinders})
    let declarationAccess105Request = Key {
      family: Family.AppliedOperation, module: qualifier.module, name: run internApplication(&mut resolver.*, &serviceType),
      declaration: operation, member: run internApplication(&mut resolver.*, &selfType), external: false,
    }
    let declarationAccess105 = run internDeclaration(&mut resolver.*, declarationAccess105Request)
    signatureKey = declarationAccess105
  }
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, signatureKey, memberSpan)
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(move value)
  }
  // An operation that takes its service's `Self` as an operand dispatches on that operand's
  // conformance like an interface operation (SERV-003). It is checked as an interface call in the
  // body and has no call target here.
  if run selfOperandOperation(&mut resolver.*, qualifierModule, qualifier.ordinal, &signature) {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan))
  }
  let shape = run writtenCallArityRejection(&mut resolver.*, module, syntax, &signature)
  if let Option<RejectionCode>.Some {value: reason} = move shape {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, reason, span))
  }
  // Inferring an unapplied generic service's arguments from the operands is not native yet.
  if let Option<Shared<Type>>.None = &applied {
    let generic = match move run templateBinders(&mut resolver.*, qualifierModule, qualifier.ordinal) {
      Result<List<Binder>, Shared<Rejection>>.Success {value} => List<Binder>.length(&value) > usize.ZERO
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
      }
    }
    if generic {
      let unapplied = match move run declarationAt(&mut resolver.*, qualifierModule, operation) {
        Option<DeclarationId>.Some {value} => move value
        Option<DeclarationId>.None => {
          return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan))
        }
      }
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(run genericOperationRejection(module, span, &unapplied))
    }
  }
  let callSpan = run staticSpan(&mut resolver.*, module, syntax.id)
  let prefix = run resolveCallPrefix(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    module, qualifierModule, operation, &signature, syntax.generics, scope, constraints, emptyCallPrefix(), callSpan)
  let written = match move prefix {
    Result<CallPrefix, Shared<Rejection>>.Success {value} => move value
    Result<CallPrefix, Shared<Rejection>>.Failure {error} => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, qualifierModule, operation)
  let declaration = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan))
    }
  }
  let mut scopeArguments = List<Argument>.make()
  let mut inferOwner = true
  if let Option<Shared<Type>>.Some {value: serviceType} = &applied {
    scopeArguments = run typeApplicationArguments(&serviceType)
    inferOwner = false
  }
  return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Function {target: CallTarget {
    foreign: false, declaration: move declaration, isPublic: true, signature: move signature,
    explicit: move written.arguments, explicitSlots: move written.slots, prefixOwner: move written.owner, prefixLifetimes: written.lifetimes, scopeArguments: move scopeArguments,
    inferOwner: inferOwner, explicitSyntax: syntax.generics.present,
  }})
}

// Whether a service operation's parameters mention the service's implicit `Self` provider, which
// is bound after the service's written binders.
effect fn selfOperandOperation(resolver: &mut Resolver, serviceModule: &ModuleId, serviceOrdinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>) -> bool ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let identity = match move run declarationAt(&mut resolver.*, serviceModule, serviceOrdinal) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return false }
  }
  let written = match move run templateBinders(&mut resolver.*, serviceModule, serviceOrdinal) {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => List<Binder>.length(&value)
    Result<List<Binder>, Shared<Rejection>>.Failure {..} => { return false }
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move parameter {
      let mut types = List<usize>.make()
      let mut lifetimes = List<usize>.make()
      let mut rows = List<usize>.make()
      run Type.collectOwned(&value, &identity, &mut types, &mut lifetimes, &mut rows)
      if containsOrdinal(&types, written) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Resolves the authored owner application of a qualifier, if any. Its arguments belong to the
// qualifier, independently of call-site generics. Each lifetime it omits is a region of
// `template`, inferred at the call like an omitted call-prefix region; without a template the
// application cannot omit one.
effect fn qualifierApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  application: HirRef,
  scope: &[Binder],
  constraints: &[Constraint],
  template: Option<DeclarationId>,
  omitted: &mut usize,
) -> Result<Option<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if !application.present {
    return Result<Option<Shared<Type>>, Shared<Rejection>>.succeed(Option<Shared<Type>>.none())
  }
  let mut elision = LifetimeElision {
    owner: move template, nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option<Shared<Lifetime>>.none(), generated: List<Shared<Lifetime>>.make(),
    invocation: false, nested: false, renumber: List<usize>.make(), staticEnvironment: false,
    supplied: Option<List<Argument>>.none(), assumptions: Option<List<Constraint>>.some(run copyConstraints(constraints)), deferred: Option<List<DeferredBounds>>.none(),
  }
  let resolved = run resolveTypeAt(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, application.id, scope, &mut elision, true)
  omitted.* = elision.nextOrdinal
  return match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => Result<
      Option<Shared<Type>>,
      Shared<Rejection>,
    >.succeed(Option<Shared<Type>>.some(move value))
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result<
      Option<Shared<Type>>,
      Shared<Rejection>,
    >.failResult(move error)
  }
}

// The explicit prefix a written owner application gives an opened inherent member. Like an
// applied owner, the application supplies the impl's binders in order. Each one the member's
// signature lists is fixed as written; the regions the application omitted remain `template`
// regions for the call to infer.
effect fn ownerApplicationPrefix(
  resolver: &mut Resolver,
  qualifierModule: &ModuleId,
  provider: &Shared<Type>,
  target: &CallTarget,
  template: DeclarationId,
  omitted: usize,
) -> CallPrefix ! Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run Shared<DeclarationId>.make(DeclarationId.copy(&target.declaration))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, qualifierModule, &selected) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { fail RevisionMismatch {} }
  }
  let implementation = match move run enclosingIdentity(&mut resolver.*, qualifierModule, ordinal) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { fail RevisionMismatch {} }
  }
  let mut arguments = List<Argument>.make()
  let mut slots = List<CallPrefixSlot>.make()
  let count = Shared<Type>.with<usize>(provider, applicationLength)
  let mut at = usize.ZERO
  while at < count {
    let written = Shared<Type>.with<Option<Argument>>(provider,
      fn(value: &Type) -> Option<Argument> { return applicationArgument(value, at) })
    let argument = match move written {
      Option<Argument>.Some {value} => move value
      Option<Argument>.None => { fail RevisionMismatch {} }
    }
    let kind = match &argument {
      Argument.Type {..} => GenericKind.Type
      Argument.Lifetime {..} => GenericKind.Lifetime
      Argument.Row {..} => GenericKind.Requirement
    }
    let slot = ApplicationSlot {ordinal: at, kind: kind}
    if Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature,
      fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureListsSlot(answer, &implementation, slot) }) {
      let binder = match move run scopeArgument(&implementation, at, kind) {
        Argument.Type {value} => CallPrefixSlot.Type {value: move value}
        Argument.Lifetime {value} => CallPrefixSlot.Lifetime {value: move value}
        Argument.Row {..} => CallPrefixSlot.Row {value: RowParameter {
          declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&implementation)), ordinal: at}}
      }
      run List<CallPrefixSlot>.append(&mut slots, move binder)
      run List<Argument>.append(&mut arguments, move argument)
    }
    at = at + usize.ONE
  }
  return CallPrefix {arguments: move arguments, slots: move slots,
    owner: Option<Shared<DeclarationId>>.some(run Shared<DeclarationId>.make(move template)), lifetimes: omitted}
}

// A member list written after an unwritten owner whose parameters the member uses (GEN-008): the
// member's own arguments follow a written owner, so the list is rejected at its span.
effect fn ownerArgumentPlacement(resolver: &mut Resolver, module: &ModuleId, generics: HirRef) -> Shared<Rejection>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = match move run typeNode(&mut resolver.*, module, generics.id) {
    Option<HeaderSyntax>.Some {value} => value.span
    Option<HeaderSyntax>.None => Span.make(usize.ZERO, usize.ZERO)
  }
  return run reject(&resolver.*, module, RejectionCode.OwnerArgumentPlacement, span)
}

// Resolves `Namespace.member(...)` when `Namespace` names a source or imported declaration. Only a
// nominal type can own the member; anything else is not callable.
effect fn qualifiedNominalCallTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  namespaceName: &[u8],
  member: &[u8],
  application: HirRef,
  subjectSpan: Span,
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let chosen = run qualifierDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module,
    namespaceName, subjectSpan)
  let named = match move chosen {
    Result<QualifierDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<QualifierDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  let QualifierDeclaration {selected: qualifier, fixed: fixedApplication, lifetimeAlias, aliasLifetimes} = move named
  let fixed = match &fixedApplication {
    Option<Shared<Type>>.Some {..} => true
    Option<Shared<Type>>.None => false
  }
  // An alias that fixes its target's arguments accepts no further owner arguments.
  if fixed && application.present {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.TypeArity, subjectSpan))
  }
  let qualifierModule = resolvedModule(&resolver.*, qualifier.module)
  let written = run scopedHeader(&mut resolver.*, &qualifierModule, qualifier.ordinal)
  let mut nominal = false
  let mut isService = false
  let mut genericService = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    isService = match value.header { Node.ServiceHeader {..} => true _ => false }
    genericService = match value.header { Node.ServiceHeader {generics, ..} => generics.length != usize.ZERO _ => false }
    // A contract operation is checked as an interface call in the body and has no call target
    // here; an inherent member of the interface resolves below like any owner's.
    if let Node.InterfaceHeader {..} = value.header {
      let lookup = run memberOrdinal(&mut resolver.*, &qualifierModule, qualifier.ordinal, member)
      let mut operation = false
      if let Option<usize>.Some {..} = &lookup.ordinal { operation = true }
      if let Option<Span>.Some {..} = &lookup.repeated { operation = true }
      if operation {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan))
      }
    }
    nominal = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.UnionHeader {..} => true
      Node.EnumHeader {..} => true
      Node.ServiceHeader {..} => true
      Node.InterfaceHeader {..} => true
      _ => false
    }
  }
  if !nominal {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
    )
  }
  // A service operation's provider application cannot omit a lifetime yet.
  let mut template = Option<DeclarationId>.none()
  if !isService {
    let qualifierIdentity = match move run declarationAt(&mut resolver.*, &qualifierModule, qualifier.ordinal) {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => { fail RevisionMismatch {} }
    }
    let mut qualifierScope = Bytes.make()
    run Bytes.append(&mut qualifierScope, b"\0qualifier-lifetimes")
    run RuntimeEncoding.word(&mut qualifierScope, usize.toU64(moduleOrdinal))
    run RuntimeEncoding.word(&mut qualifierScope, usize.toU64(application.id.index))
    // An alias use writes no application; its own lifetimes are scoped by the qualifier's place.
    if !application.present { run RuntimeEncoding.word(&mut qualifierScope, usize.toU64(subjectSpan.start)) }
    template = Option<DeclarationId>.some(run DeclarationId.inference(&qualifierIdentity, Bytes.asSlice(&qualifierScope)))
  }
  let mut omitted = usize.ZERO
  let qualifierTemplate = match &template {
    Option<DeclarationId>.Some {value: pending} => Option<DeclarationId>.some(DeclarationId.copy(&pending))
    Option<DeclarationId>.None => Option<DeclarationId>.none()
  }
  let applied = run qualifierApplication(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, application, scope, constraints,
    move qualifierTemplate, &mut omitted,
  )
  let mut appliedType = match move applied {
    Result<Option<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<Option<Shared<Type>>, Shared<Rejection>>.Failure {error} => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  // An alias's own lifetimes, unwritten at the use, become the call's inferred regions (GEN-003).
  let mut aliasOpened = false
  if let Option<Shared<Type>>.Some {value: aliasApplication} = move fixedApplication {
    let mut fixedType = move aliasApplication
    if let Option<DeclarationId>.Some {value: aliasIdentity} = &lifetimeAlias {
      if let Option<DeclarationId>.Some {value: pending} = &template {
        if !application.present {
          let aliasOwner = run Shared<DeclarationId>.make(DeclarationId.copy(&aliasIdentity))
          let mut regions = List<Binding>.make()
          let mut regionAt = usize.ZERO
          while regionAt < aliasLifetimes {
            run List<Binding>.append(&mut regions, Binding {declaration: Shared<DeclarationId>.clone(&aliasOwner), ordinal: regionAt,
              value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(&pending),
                ordinal: regionAt})}})
            regionAt = regionAt + usize.ONE
          }
          fixedType = run Type.applyBindings(&fixedType, List<Binding>.asSlice(&regions), true)
          omitted = aliasLifetimes
          aliasOpened = true
        }
      }
    }
    appliedType = Option<Shared<Type>>.some(move fixedType)
  }
  // `Svc.op(args)` constructs the operation's Effect; its provider comes from the run site's row.
  if isService {
    let lookup = run memberOrdinal(&mut resolver.*, &qualifierModule, qualifier.ordinal, member)
    if let Option<usize>.Some {value: operation} = move lookup.ordinal {
      // An operation is applied under every binder of its service.
      if genericService && !application.present && syntax.generics.present {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(
          run ownerArgumentPlacement(&mut resolver.*, module, syntax.generics))
      }
      let applied = match &appliedType {
        Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
        Option<Shared<Type>>.None => Option<Shared<Type>>.none()
      }
      return run serviceOperationTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax,
        scope, constraints, &qualifier, &qualifierModule, operation, move applied, memberSpan, span)
    }
  }
  let declarationAccess106Request = Key {
      family: Family.Identity,
      module: qualifier.module,
      name: usize.ZERO,
      declaration: qualifier.ordinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess106 = run internDeclaration(&mut resolver.*, declarationAccess106Request)
  let identity = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess106,
    subjectSpan,
  )
  let mut provider = Shared<Result<Answer, NoRejection>>.with<TypeSelection>(
    &identity,
    selectedType,
  )
  if let Option<Shared<Type>>.Some {value} = move appliedType {
    provider.resolved = Option<Shared<Type>>.some(move value)
  }
  if let Option<Shared<Rejection>>.Some {value} = move provider.rejected {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(move value)
  }
  let ownerType = match move provider.resolved {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
      )
    }
  }
  // An application that omits a lifetime opens the owner like an unapplied qualifier: its
  // written arguments fix the impl binders as an explicit prefix, and the omitted regions are
  // inferred from the call (GEN-003).
  let opened = aliasOpened || (!fixed && (!application.present || omitted != usize.ZERO))
  let mut request = Request.make()
  let found = run selectInherentReceiverCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request,
    &mut dependencies.*,
    true,
    &ownerType,
    member,
    opened,
    false,
    module,
    memberSpan,
  )
  let choice = match move found {
    Result<InherentCallChoice, Shared<Rejection>>.Success {value} => move value
    Result<InherentCallChoice, Shared<Rejection>>.Failure {error} => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  return match move choice {
    InherentCallChoice.Selected {target: selectedTarget, ..} => {
      let mut ownerPrefix = emptyCallPrefix()
      let mut selected = move selectedTarget
      if !application.present && syntax.generics.present {
        let enclosing = run Shared<DeclarationId>.make(DeclarationId.copy(&selected.declaration))
        let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &qualifierModule, &enclosing) {
          Option<usize>.Some {value} => value
          Option<usize>.None => { fail RevisionMismatch {} }
        }
        if let Option<DeclarationId>.Some {value: implementation} = move run enclosingIdentity(&mut resolver.*, &qualifierModule, ordinal) {
          if Shared<Result<Answer, NoRejection>>.with<bool>(&selected.signature,
            fn(answer: &Result<Answer, NoRejection>) -> bool { return signatureNamesEnclosing(answer, &implementation) }) {
            return Result<ResolvedTarget, Shared<Rejection>>.failResult(
              run ownerArgumentPlacement(&mut resolver.*, module, syntax.generics))
          }
        }
      }
      if (application.present || aliasOpened) && omitted != usize.ZERO {
        let pending = match move template {
          Option<DeclarationId>.Some {value} => move value
          Option<DeclarationId>.None => { fail RevisionMismatch {} }
        }
        ownerPrefix = run ownerApplicationPrefix(&mut resolver.*, &qualifierModule, &ownerType, &selected, move pending, omitted)
        selected.explicitSyntax = true
      }
      return run inherentSelectedCallTarget(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax, scope, constraints,
        &qualifier, &qualifierModule, move selected, move ownerPrefix, memberSpan, span,
      )
    }
    InherentCallChoice.Claimed => Result<ResolvedTarget, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan),
    )
    InherentCallChoice.Missing => {
      if syntax.exactItem {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.UnresolvedExactRepresentation, memberSpan))
      }
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run unknownOperationRejection(module, memberSpan, &ownerType, member, false))
    }
  }
}

// Resolves `Intrinsic.member(...)` against the sealed intrinsic catalog.
effect fn intrinsicCallTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  syntax: &CallSyntax,
  scope: &[Binder],
  member: &[u8],
  memberSpan: Span,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // Composition intrinsics build exact Effects that a run site expands (Effect note D4).
  let mut composition = Option<Composition>.none()
  if same(member, b"catchFailure") { composition = Option<Composition>.some(Composition.CatchFailure) }
  if same(member, b"finalizeEffect") { composition = Option<Composition>.some(Composition.Finalize) }
  if same(member, b"finalizeEffectNonParking") { composition = Option<Composition>.some(Composition.FinalizeNonParking) }
  if same(member, b"useReleaseNonParking") { composition = Option<Composition>.some(Composition.UseRelease) }
  if same(member, b"bindRequirement") { composition = Option<Composition>.some(Composition.BindShared) }
  if same(member, b"bindRequirementMut") { composition = Option<Composition>.some(Composition.BindExclusive) }
  if same(member, b"bindRequirementOwned") { composition = Option<Composition>.some(Composition.BindOwned) }
  if same(member, b"observeDiagnostics") { composition = Option<Composition>.some(Composition.Observe) }
  if same(member, b"suspendEffect") { composition = Option<Composition>.some(Composition.Suspend) }
  if let Option<Composition>.Some {value: operation} = move composition {
    let callSpan = run staticSpan(&mut resolver.*, module, syntax.id)
    return run compositionTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal,
      operation, syntax.generics, scope, span, callSpan)
  }
  if let Option<StorageOperation>.Some {value: operation} = move StorageOperation.lookup(member) {
    let callSpan = run staticSpan(&mut resolver.*, module, syntax.id)
    return run storageTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, operation,
      syntax.generics, scope, span, callSpan)
  }
  return match move intrinsicLookup(member) {
    Option<IntrinsicMember>.Some {value} => {
      if intrinsicTypeArity(value) != usize.ZERO {
        let callSpan = run staticSpan(&mut resolver.*, module, syntax.id)
        return run typedIntrinsicTarget(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, value,
          syntax.generics, span, callSpan, scope,
        )
      }
      if syntax.generics.present {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
      return Result<ResolvedTarget, Shared<Rejection>>.succeed(
        ResolvedTarget.Intrinsic {member: value, typeArguments: List<Shared<Type>>.make()},
      )
    }
    Option<IntrinsicMember>.None => {
      let mut code = RejectionCode.UnknownOperation
      if intrinsicRuntimeMember(member) {
        code = RejectionCode.IntrinsicUnavailable
      }
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, code, memberSpan),
      )
    }
  }
}

// Resolves one element type of a tuple constructor from its member shape.
effect fn tupleElementType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  target: &SelectedDeclaration,
  application: usize,
  index: usize,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let declarationAccess107Request = Key {
      family: Family.MemberShape,
      module: target.module,
      name: application,
      declaration: target.ordinal,
      member: index,
      external: false,
    }
  let declarationAccess107 = run internDeclaration(&mut resolver.*, declarationAccess107Request)
  let shape = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    declarationAccess107, span,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &shape, answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(move diagnostic)
  }
  let field = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &shape, singleMemberShapeType,
  )
  if let Option<Shared<Type>>.Some {value: ty} = move field {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(move ty)
  }
  return Result<Shared<Type>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

// Resolves a tuple declaration used as a constructor call.
effect fn callTupleTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  target: &SelectedDeclaration,
  elements: Range,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.none(),
    nextOrdinal: usize.ZERO,
    output: false,
    resultDefault: Option<Shared<Lifetime>>.none(),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let mut applicationSyntax = Option<HirId>.none()
  if syntax.generics.present {
    applicationSyntax = Option<HirId>.some(syntax.generics.id)
  }
  let applied = run declarationType(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, target.module, target.ordinal,
    module, span, span, move applicationSyntax,
    scope, &mut elision,
  )
  let provider = match move applied {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  let application = run internApplication(&mut resolver.*, &provider)
  let mut fields = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < elements.length {
    let field = run tupleElementType(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, target, application, at, span,
    )
    match move field {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
        run List<Shared<Type>>.append(&mut fields, move ty)
      }
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
      }
    }
    at = at + usize.ONE
  }
  return Result<ResolvedTarget, Shared<Rejection>>.succeed(
    ResolvedTarget.Tuple {ty: move provider, elements: move fields},
  )
}

// Resolves a package parameter by canonical identity; its value is read through the static lane.
effect fn callPackageParameterTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  syntax: &CallSyntax,
  target: &SelectedDeclaration,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let declarationAccess108Request = Key {
      family: Family.ParameterSchema,
      module: target.module,
      name: usize.ZERO,
      declaration: target.ordinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess108 = run internDeclaration(&mut resolver.*, declarationAccess108Request)
  let schema = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    declarationAccess108,
    span,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &schema, answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(move diagnostic)
  }
  let written = run typeNode(&mut resolver.*, module, syntax.id)
  if let Option<HeaderSyntax>.Some {value: expression} = move written {
    if let Option<CallInput>.Some {..} = move CallInput.ofNode(expression.header) {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
  }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ParameterSchema>>>(
    &schema, selectedParameterSchema,
  )
  if let Option<Shared<ParameterSchema>>.Some {value} = move selected {
    let ty = Shared<ParameterSchema>.with<Shared<Type>>(&value,
      fn(header: &ParameterSchema) -> Shared<Type> { return Shared<Type>.clone(&header.ty) })
    let targetModule = resolvedModule(&resolver.*, target.module)
    let identity = run declarationAt(&mut resolver.*, &targetModule, target.ordinal)
    if let Option<DeclarationId>.Some {value: declaration} = move identity {
      return Result<ResolvedTarget, Shared<Rejection>>.succeed(
        ResolvedTarget.Constant {declaration: move declaration, ty: move ty},
      )
    }
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.InvalidParameterSchema, span),
  )
}

// Resolves a constant used as a call. A constant is only callable when its checked type resolves.
effect fn callConstantTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  targetModule: &ModuleId,
  target: &SelectedDeclaration,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let declarationAccess109Request = Key {
      family: Family.Constant,
      module: target.module,
      name: usize.ZERO,
      declaration: target.ordinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess109 = run internDeclaration(&mut resolver.*, declarationAccess109Request)
  let checked = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess109,
    span,
  )
  let constantType = Shared<Result<Answer, NoRejection>>.with<TypeSelection>(&checked, selectedType)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move constantType.rejected {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(move diagnostic)
  }
  if let Option<Shared<Type>>.Some {value: ty} = move constantType.resolved {
    let identity = run declarationAt(&mut resolver.*, targetModule, target.ordinal)
    if let Option<DeclarationId>.Some {value: declaration} = move identity {
      return Result<ResolvedTarget, Shared<Rejection>>.succeed(
        ResolvedTarget.Constant {declaration: move declaration, ty: move ty},
      )
    }
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

// The declared type of one C static, imported or exported. Its scalar or pointer type is read by
// copy; a non-C ABI and linkage properties stay deferred.
effect fn foreignStaticType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  ordinal: usize,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let written = run foreignHeader(&mut resolver.*, &module, ordinal)
  let deferred = match &written.gap {
    Option<GapCode>.Some {..} => true
    Option<GapCode>.None => false
  }
  // An exported static's own C object is read through its symbol like an imported one.
  if deferred {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, &module, RejectionCode.ForeignStaticUnavailable, span),
    )
  }
  return run declaredStaticType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    ordinal,
    span
  )
}

// Header checking is independent of whether this storage will be emitted or has supported ABI
// linkage. A loaded foreign static must still have a valid declared scalar or pointer type.
effect fn declaredStaticType(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  ordinal: usize,
  span: Span
) -> Result<Shared<Type>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let mut annotation = Option<HirId>.none()
  let found = run scopedHeader(&mut resolver.*, &module, ordinal)
  if let Option<HeaderSyntax>.Some {value} = move found {
    if let Node.StaticHeader {annotation: declared, ..} = value.header { annotation = Option<HirId>.some(declared) }
  }
  let typeSyntax = match move annotation {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, &module, RejectionCode.NotCallable, span))
    }
  }
  let noBinders = List<Binder>.make()
  // Foreign storage lives for the whole program, so an omitted reference lifetime is `'static`.
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.none(),
    nextOrdinal: usize.ZERO,
    output: true,
    resultDefault: Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Static)),
    generated: List<Shared<Lifetime>>.make(),
    invocation: false,
    nested: false,
    renumber: List<usize>.make(),
    staticEnvironment: false,
    supplied: Option<List<Argument>>.none(),
    assumptions: Option<List<Constraint>>.none(),
    deferred: Option<List<DeferredBounds>>.none(),
  }
  let resolved = run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, typeSyntax,
    List<Binder>.asSlice(&noBinders), &mut elision)
  let ty = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let admitted = Shared<Type>.with<bool>(&ty, foreignStaticAdmitted)
  if !admitted {
    // A C static names its refused type, as a C signature lane does.
    let mut refused = run makeRejection(RejectionCode.ForeignType, &module, span)
    if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(&ty, &module) {
      run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"3")})
      run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move text})
    }
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move refused))
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(move ty)
}

// A foreign static holds one immediate C scalar or pointer; it is never unit.
fn foreignStaticAdmitted(value: &Type) -> bool {
  return match &value.* {
    Type.Nominal {..} => false
    Type.Unit => false
    _ => CAbi.admit(value)
  }
}

// Resolves an imported C static used by name as a value. The use site anchors any deferral.
effect fn foreignStaticTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  targetModule: &ModuleId,
  target: &SelectedDeclaration,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = run foreignStaticType(&mut resolver.*, &mut owner.*, &mut dependencies.*, target.module, target.ordinal, span)
  let ty = match move selected {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      let code = Shared<Rejection>.with<RejectionCode>(&error, fn(rejection: &Rejection) -> RejectionCode {
        return rejection.code
      })
      if code == RejectionCode.ForeignStaticUnavailable || code == RejectionCode.ForeignType {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, code, span))
      }
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, targetModule, target.ordinal)
  if let Option<DeclarationId>.Some {value: declaration} = move identity {
    return Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.ForeignStatic {declaration: move declaration, ty: move ty})
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotCallable, span))
}

// Resolves a source or foreign function used as a call, including its written generic prefix.
effect fn callFunctionTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
  targetModule: &ModuleId,
  target: &SelectedDeclaration,
  foreign: bool,
  isPublic: bool,
  bareValue: bool,
  span: Span,
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let declarationAccess110Request = Key {
    family: Family.Signature,
    module: target.module,
    name: usize.ZERO,
    declaration: target.ordinal,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess110 = run internDeclaration(&mut resolver.*, declarationAccess110Request)
  let signatureKey = declarationAccess110
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    signatureKey,
    span,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(move diagnostic)
  }
  let callSpan = run staticSpan(&mut resolver.*, module, syntax.id)
  let prefix = run resolveCallPrefix(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    targetModule,
    target.ordinal,
    &signature,
    syntax.generics,
    scope,
    constraints,
    emptyCallPrefix(),
    callSpan,
  )
  let explicit = match move prefix {
    Result<CallPrefix, Shared<Rejection>>.Success {value: resolvedArguments} => move resolvedArguments
    Result<CallPrefix, Shared<Rejection>>.Failure {error} => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, targetModule, target.ordinal)
  if let Option<DeclarationId>.Some {value: declaration} = move identity {
    return Result<ResolvedTarget, Shared<Rejection>>.succeed(
      ResolvedTarget.Function {
        target: CallTarget {
          foreign: foreign,
          declaration: move declaration,
          isPublic: isPublic,
          signature: move signature,
          explicit: move explicit.arguments,
          explicitSlots: move explicit.slots, prefixOwner: move explicit.owner, prefixLifetimes: explicit.lifetimes,
          scopeArguments: List<Argument>.make(),
          inferOwner: false,
        explicitSyntax: syntax.generics.present,
        },
      },
    )
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

effect fn callTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  syntax: &CallSyntax,
  scope: &[Binder],
  constraints: &[Constraint],
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let span = syntax.span
  // A reference that selects nothing is unsupported. The rejection is built only then: making it
  // up front allocated one for every call.
  let mut selected = Option<Result<SelectedDeclaration, Shared<Rejection>>>.none()
  let mut missingNamed = RejectionCode.UnknownFunction
  if syntax.value { missingNamed = RejectionCode.UnknownName }
  let mut bareValue = syntax.value
  // The imported module a qualified name reached its member through, as `inflate` in `inflate.Format`.
  let mut throughModule = Option<ModuleId>.none()
  let mut throughMember = Bytes.make()
  match & syntax.reference {
    CallReference.Named {name} => {
      selected = Option<Result<SelectedDeclaration, Shared<Rejection>>>.some(run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        missingNamed, RejectionCode.NotCallable, syntax.exactItem))
    }
    CallReference.Qualified {namespace, member, subjectSpan, memberSpan, application} => {
      let namespaceName = Bytes.asSlice(&namespace)
      // The unbound qualifier names the sealed namespace, never an import or source declaration.
      if same(namespaceName, b"Intrinsic") {
        if application.present {
          return Result<ResolvedTarget, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.NotType, subjectSpan))
        }
        return run intrinsicCallTarget(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, syntax, scope,
          Bytes.asSlice(&member), memberSpan, span,
        )
      }
      let declarationAccess111Request = Key {
        family: Family.Name,
        module: moduleOrdinal,
        name: run internName(&mut resolver.*, namespaceName),
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      }
      let declarationAccess111 = run internDeclaration(&mut resolver.*, declarationAccess111Request)
      let nameKey = declarationAccess111
      let observed = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        nameKey,
        subjectSpan,
      )
      drop observed
      let namespaceBindingSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespaceName, false)
      let namespaceBinding = match move namespaceBindingSelection {
        Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
        Result<Selection, Shared<Rejection>>.Failure {error} => {
          return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
        }
      }
      if namespaceBinding.count == usize.ZERO {
        let mut code = RejectionCode.UnknownActor
        if syntax.exactItem { code = RejectionCode.UnresolvedExactRepresentation }
        // A primitive's operations live in its standard-library module, which must be imported.
        if code == RejectionCode.UnknownActor && primitiveModuleName(namespaceName) && !run syntaxDamaged(&mut resolver.*, module) {
          return Result<ResolvedTarget, Shared<Rejection>>.failResult(run primitiveImportRejection(code, module, subjectSpan, namespaceName))
        }
        let mut diagnostic = run makeRejection(code, module, subjectSpan)
        if code == RejectionCode.UnknownActor {
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"), value: run unknownNameText(namespaceName)})
        }
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
      }
      if namespaceBinding.count > usize.ONE {
        if !syntax.exactItem {
          return Result<ResolvedTarget, Shared<Rejection>>.failResult(run bindingCollision(module, namespaceBinding, namespaceName))
        }
        let mut code = RejectionCode.Collision
        if syntax.exactItem { code = RejectionCode.AmbiguousExactRepresentation }
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, code, subjectSpan),
        )
      }
      if namespaceBinding.kind == CandidateKind.Declaration || namespaceBinding.kind == CandidateKind.ImportMember {
        return run qualifiedNominalCallTarget(
          &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax,
          scope, constraints, namespaceName, Bytes.asSlice(&member), application, subjectSpan, memberSpan, span,
        )
      }
      if namespaceBinding.kind != CandidateKind.ImportModule {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
        )
      }
      if application.present {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.NotType, subjectSpan))
      }
      let declarationAccess112Request = Key {
        family: Family.Import,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: namespaceBinding.declaration,
        member: usize.MAX,
        external: false,
      }
      let declarationAccess112 = run internDeclaration(&mut resolver.*, declarationAccess112Request)
      let importKey = declarationAccess112
      let imported = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        importKey,
        subjectSpan,
      )
      let binding = Shared<Result<Answer, NoRejection>>.with<ImportSelection>(
        &imported,
        fn(answer: &Result<Answer, NoRejection>) -> ImportSelection { return selectedImport(&resolver.*, answer) },
      )
      if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
        return Result<ResolvedTarget, Shared<Rejection>>.failResult(move value)
      }
      if let Option<usize>.Some {value: targetModule} = move binding.module {
        throughModule = Option<ModuleId>.some(resolvedModule(&resolver.*, targetModule))
        throughMember = run Bytes.copy(Bytes.asSlice(&member))
        selected = Option<Result<SelectedDeclaration, Shared<Rejection>>>.some(run selectDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          targetModule,
          module,
          Bytes.asSlice(&member),
          true,
          memberSpan,
          missingNamed, RejectionCode.NotCallable, syntax.exactItem))
      }
    }
    CallReference.Unbound {name} => {
      bareValue = true
      selected = Option<Result<SelectedDeclaration, Shared<Rejection>>>.some(run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.UnknownName, RejectionCode.Unsupported, syntax.exactItem))
    }
    CallReference.NonCallable => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
    CallReference.CallableValue => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    CallReference.Unsupported => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let chosen = match move selected {
    Option<Result<SelectedDeclaration, Shared<Rejection>>>.Some {value} => move value
    Option<Result<SelectedDeclaration, Shared<Rejection>>>.None => Result<SelectedDeclaration, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    )
  }
  let target = match move chosen {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      // An unknown value spelled as a primitive, such as `u32` in `u32.MAX`, names the module
      // that declares the primitive's constants.
      if bareRejection(&error, RejectionCode.UnknownName) {
        let unbound = match &syntax.reference {
          CallReference.Named {name} => Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&name)))
          CallReference.Unbound {name} => Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&name)))
          _ => Option<Bytes>.none()
        }
        if let Option<Bytes>.Some {value: name} = move unbound {
          if primitiveModuleName(Bytes.asSlice(&name)) && !run syntaxDamaged(&mut resolver.*, module) {
            return Result<ResolvedTarget, Shared<Rejection>>.failResult(
              run primitiveImportRejection(RejectionCode.UnknownName, module, rejectionSpan(&error), Bytes.asSlice(&name)))
          }
        }
      }
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(move error)
    }
  }
  let targetModule = resolvedModule(&resolver.*, target.module)
  // A function target reads only its kind, visibility and linkage here; its signature is a unit.
  let written = run observedHeader(&mut resolver.*, &targetModule, target.ordinal, SourceFacet.Identity)
  if let Option<HeaderSyntax>.Some {value} = &written {
    if !isFunctionHeader(value.header) { drop run scopedHeader(&mut resolver.*, &targetModule, target.ordinal) }
  }
  let declared = match move written {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
  }
  if syntax.exactItem {
    let item = match declared.header { Node.FunctionHeader {..} => true _ => false }
    if !item {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.InvalidExactRepresentation, span),
      )
    }
  }
  if let Node.StaticHeader {..} = declared.header {
    // This header is a foreign or exported static, both with required linkage.
    if bareValue {
      return run foreignStaticTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &targetModule, &target, span)
    }
    return Result<ResolvedTarget, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.NotCallable, span),
    )
  }
  if let Node.PackageParameterHeader {..} = declared.header {
    return run callPackageParameterTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, syntax, &target, span,
    )
  }
  if let Node.TupleHeader {elements, ..} = declared.header {
    if bareValue {
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    return run callTupleTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, syntax, scope, &target,
      elements, span,
    )
  }
  if let Node.ConstantHeader {..} = declared.header {
    return run callConstantTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &targetModule, &target, span,
    )
  }
  if let Node.FunctionHeader {isPublic, linkage, ..} = declared.header {
    return run callFunctionTarget(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, syntax, scope, constraints,
      &targetModule, &target, linkage.present, isPublic, bareValue, span,
    )
  }
  // `inflate.Format` names a type through its module: only constants and functions are reached
  // that way, so say how to import the type instead of refusing a non-callable value.
  if let Option<ModuleId>.Some {value: through} = move throughModule {
    if syntax.value && namedTypeHeader(declared.header) {
      let mut diagnostic = run makeRejection(RejectionCode.ModuleQualifiedType, module, span)
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"module"), value: run TypeText.importPath(&through)})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"spelling"),
        value: move throughMember})
      return Result<ResolvedTarget, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
    }
  }
  return Result<ResolvedTarget, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

fn namedTypeHeader(header: Node) -> bool {
  return match header {
    Node.StructHeader {..} => true
    Node.TupleHeader {..} => true
    Node.UnionHeader {..} => true
    Node.EnumHeader {..} => true
    Node.AliasHeader {..} => true
    Node.InterfaceHeader {..} => true
    Node.ServiceHeader {..} => true
    _ => false
  }
}

effect fn invalidExactRepresentation(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  return Result<Shared<Type>, Shared<Rejection>>.failResult(
    run reject(resolver, module, RejectionCode.InvalidExactRepresentation, span),
  )
}

effect fn resolveNamedRepresentation(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  subject: HirId,
  span: Span,
  scope: &[Binder],
  assumptions: &Option<List<Constraint>>,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let source = run typeNode(&mut resolver.*, module, subject)
  let written = match move source {
    Option<HeaderSyntax>.Some {value} => move value
    Option<HeaderSyntax>.None => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
  }
  let mut selected = written.header
  let mut generics = HirRef.absent()
  if let Node.AppliedType {target, arguments} = selected {
    generics = HirRef.of(arguments)
    let named = run typeNode(&mut resolver.*, module, target)
    if let Option<HeaderSyntax>.Some {value: found} = move named {
      selected = found.header
    }
  }
  let mut namedPath = HirRef.absent()
  if let Node.NamedType {path: spelled, hasMode, ..} = selected {
    if !hasMode {
      namedPath = HirRef.of(spelled)
    }
  }
  if !namedPath.present {
    return run invalidExactRepresentation(&resolver.*, module, span)
  }
  let parsed = run path(&mut resolver.*, module, namedPath.id)
  if !parsed.valid {
    return run invalidExactRepresentation(&resolver.*, module, span)
  }
  let segments = List<Bytes>.asSlice(&parsed.segments)
  let mut reference = CallReference.Unsupported
  if segments.length == usize.ONE {
    reference = CallReference.Named {name: run Bytes.copy(Bytes.asSlice(&segments[usize.ZERO]))}
  }
  if segments.length == 2 {
    reference = CallReference.Qualified {
      namespace: run Bytes.copy(Bytes.asSlice(&segments[usize.ZERO])),
      member: run Bytes.copy(Bytes.asSlice(&segments[usize.ONE])),
      subjectSpan: parsed.span,
      memberSpan: parsed.span,
      application: HirRef.absent(),
    }
  }
  let syntax = CallSyntax {
        exactItem: true,
    value: true,
    id: subject,
    span: span,
    reference: move reference,
    generics: generics,
    pipeline: false,
  }
  let mut constraints = List<Constraint>.make()
  if let Option<List<Constraint>>.Some {value} = &assumptions.* {
    constraints = run copyConstraints(List<Constraint>.asSlice(&value))
  }
  let found = run callTarget(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    module,
    moduleOrdinal,
    &syntax,
    scope,
    List<Constraint>.asSlice(&constraints),
  )
  let selectedTarget = match move found {
    Result<ResolvedTarget, Shared<Rejection>>.Success {value} => move value
    Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  let target = match move selectedTarget {
    ResolvedTarget.Function {target} => move target
    ResolvedTarget.Tuple {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Selected {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Constant {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.ForeignStatic {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Intrinsic {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Composition {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
    ResolvedTarget.Storage {..} => {
      return run invalidExactRepresentation(&resolver.*, module, span)
    }
  }
  if target.prefixLifetimes != usize.ZERO {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span))
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(
    &target.signature,
    signatureBinderCount,
  )
  if List<Argument>.length(&target.explicit) != count {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.OpenExactRepresentation, span))
  }
  if target.foreign {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.ForeignFunctionNotFirstClass, span))
  }
  if Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureIsEffect)
    || Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureStaticCount) != usize.ZERO
    || Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureIsStatic) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let mut request = Request.make()
  let selectedApplication = run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, &target.declaration, &target.signature,
    run copyArguments(List<Argument>.asSlice(&target.explicit)), &target.scopeArguments, module, span)
  let application = match move selectedApplication {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
    }
  }
  // typeof names one runtime-concrete construction, not an open generic template.
  if !Application.isRuntimeClosed(&application) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.OpenExactRepresentation, span))
  }
  let bindings = run Application.bindings(&application)
  let countBounds = Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureConstraintCount)
  let mut applied = List<Constraint>.make()
  let mut at = usize.ZERO
  while at < countBounds {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&target.signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run List<Constraint>.append(&mut applied, run bindConstraint(&value, List<Binding>.asSlice(&bindings)))
    }
    at = at + usize.ONE
  }
  let refused = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &constraints,
    List<Constraint>.asSlice(&applied), module, span, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {value} = move refused {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(move value)
  }
  let parameterCount = Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureParameterCount)
  let mut parameters = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < parameterCount {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&target.signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected {
      run List<Shared<Type>>.append(&mut parameters, run Type.applyBindings(&value, List<Binding>.asSlice(&bindings), true))
    } else { return run invalidExactRepresentation(&resolver.*, module, span) }
    at = at + usize.ONE
  }
  let result = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&target.signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => run Type.applyBindings(&value, List<Binding>.asSlice(&bindings), true)
    _ => { return run invalidExactRepresentation(&resolver.*, module, span) }
  }
  let contract = run Types.intern(Type.Callable {mode: CallableMode.Shared,
    isUnsafe: Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureUnsafe),
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&List<Shared<Lifetime>>.make()))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: List<Outlives>.make(), parameters: move parameters, result: move result})
  return Result<Shared<Type>, Shared<Rejection>>.succeed(
    run Type.callableValue(target.isPublic, run Shared<Application>.make(move application), move contract,
      List<Shared<Type>>.make(), List<CallableFieldInput>.make()))
}

// The position in `slots` of the slot at parameter `ordinal`, or `usize.MAX`.
fn staticSlotAt(slots: &[StaticSlot], ordinal: usize) -> usize {
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].ordinal == ordinal { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn isStaticIndex(slots: &[usize], at: usize) -> bool {
  let mut index = usize.ZERO
  while index < slots.length {
    if slots[index] == at { return true }
    index = index + usize.ONE
  }
  return false
}

// Calling shape is read from the same canonical signature retained as a semantic dependency.
fn signatureIsVariadic(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome { return signature.isVariadic }
  }
  return false
}

fn signatureIsStatic(answer: &Result<Answer, NoRejection>) -> bool {
  return match move signatureFacts(answer) {
    Option<SignatureFacts>.Some {value} => value.isStatic
    _ => false
  }
}

// Whether no escape walk starts from a body with this signature: an open template, a static
// body, one with static arguments, or one that requires providers, which lowers only where a
// caller supplies them (`demandMirOf`).
effect fn signatureStartsNoWalk(signature: &Shared<Result<Answer, NoRejection>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureNonLifetimeBinderCount) > usize.ZERO
    || Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsStatic)
    || Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureStaticCount) > usize.ZERO {
    return true
  }
  return run signatureRequiresProviders(signature)
}

// Whether a body with this signature requires providers, so it lowers only where a caller
// supplies them.
effect fn signatureRequiresProviders(signature: &Shared<Result<Answer, NoRejection>>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let requirements = run signatureRequirements(signature)
  return Shared<Row>.with<bool>(&requirements, fn(row: &Row) -> bool {
    return List<Requirement>.length(&row.entries) > usize.ZERO || List<RowParameter>.length(&row.parameters) > usize.ZERO
      || List<RowSubtraction>.length(&row.subtractions) > usize.ZERO
  })
}

fn signatureStaticCount(answer: &Result<Answer, NoRejection>) -> usize {
  let facts = signatureFacts(answer)
  return match move facts {
    Option<SignatureFacts>.Some {value} => value.staticSlots
    Option<SignatureFacts>.None => usize.ZERO
  }
}

// The static values this body's selection pass recorded for one call.
fn staticArgumentsFact(calls: &[ResolvedCall], id: HirId) -> Option<Shared<List<StaticSlot>>> {
  let fact = selectedFact(calls, id)
  return match move fact {
    Option<SelectionFact>.Some {value: SelectionFact.StaticArguments {slots}} => Option<Shared<List<StaticSlot>>>.some(move slots)
    _ => Option<Shared<List<StaticSlot>>>.none()
  }
}

fn staticSlotValue(slots: &List<StaticSlot>, ordinal: usize) -> Option<Shared<StaticData>> {
  let listed = List<StaticSlot>.asSlice(slots)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].ordinal == ordinal { return Option<Shared<StaticData>>.some(StaticValue.copy(&listed[at].value)) }
    at = at + usize.ONE
  }
  return Option<Shared<StaticData>>.none()
}

effect fn copySharedStaticSlots(slots: &Shared<List<StaticSlot>>) -> List<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared<List<StaticSlot>>.with<usize>(slots, slotCount)
  let mut copied = List<StaticSlot>.make()
  let mut at = usize.ZERO
  while at < count {
    let slot = Shared<List<StaticSlot>>.with<StaticSlot>(slots, fn(listed: &List<StaticSlot>) -> StaticSlot { return slotAt(listed, at) })
    run List<StaticSlot>.append(&mut copied, move slot)
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyStaticSlots(slots: &[StaticSlot]) -> List<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<StaticSlot>.make()
  let mut at = usize.ZERO
  while at < slots.length {
    run List<StaticSlot>.append(&mut copied, StaticSlot {ordinal: slots[at].ordinal, value: StaticValue.copy(&slots[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyTypes(types: &[Shared<Type>]) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < types.length {
    run List<Shared<Type>>.append(&mut copied, Shared<Type>.clone(&types[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyTupleTarget(ty: &Shared<Type>, elements: &List<Shared<Type>>) -> ResolvedTarget
! OutOfMemoryError ? &mut Allocator {
  return ResolvedTarget.Tuple {ty: Shared<Type>.clone(ty), elements: run copyTypes(List<Shared<Type>>.asSlice(elements))}
}

effect fn copyResolvedTarget(value: &ResolvedTarget) -> ResolvedTarget
! OutOfMemoryError ? &mut Allocator {
  return match & value.* {
    ResolvedTarget.Intrinsic {member, typeArguments} => ResolvedTarget.Intrinsic {
      member: member, typeArguments: run copyTypes(List<Shared<Type>>.asSlice(&typeArguments)),
    }
    ResolvedTarget.Selected {fact} => ResolvedTarget.Selected {fact: match & fact {
      SelectionFact.Embedded {value: embedded, ty: embeddedType} => SelectionFact.Embedded {
        value: StaticValue.copy(&embedded), ty: Shared<Type>.clone(&embeddedType),
      }
      SelectionFact.Condition {selected} => SelectionFact.Condition {selected: selected}
      SelectionFact.StaticFor {iterations} => SelectionFact.StaticFor {iterations: Shared<List<IterationFacts>>.clone(&iterations)}
      SelectionFact.StaticBinding {value: bound} => SelectionFact.StaticBinding {value: StaticValue.copy(&bound),
        }
      SelectionFact.StaticArguments {slots} => SelectionFact.StaticArguments {slots: Shared<List<StaticSlot>>.clone(&slots),
        }
    },
    }
    ResolvedTarget.Tuple {ty, elements} => run copyTupleTarget(&ty, &elements)
    ResolvedTarget.Composition {operation, written} => ResolvedTarget.Composition {operation: operation,
      written: run copyArguments(List<Argument>.asSlice(&written))}
    ResolvedTarget.Storage {operation, typeArguments} => ResolvedTarget.Storage {operation: operation,
      typeArguments: run copyTypes(List<Shared<Type>>.asSlice(&typeArguments))}
    ResolvedTarget.Constant {declaration, ty} => ResolvedTarget.Constant {
      declaration: DeclarationId.copy(&declaration),
      ty: Shared<Type>.clone(&ty),
    }
    ResolvedTarget.ForeignStatic {declaration, ty} => ResolvedTarget.ForeignStatic {
      declaration: DeclarationId.copy(&declaration),
      ty: Shared<Type>.clone(&ty),
    }
    ResolvedTarget.Function {target} => ResolvedTarget.Function {target: CallTarget {
      foreign: target.foreign,
      declaration: DeclarationId.copy(&target.declaration),
      isPublic: target.isPublic,
      signature: Shared<Result<Answer, NoRejection>>.clone(&target.signature),
      explicit: run copyArguments(List<Argument>.asSlice(&target.explicit)),
      explicitSlots: run copyCallPrefixSlots(List<CallPrefixSlot>.asSlice(&target.explicitSlots)),
      prefixOwner: copyCallPrefixOwner(&target.prefixOwner), prefixLifetimes: target.prefixLifetimes,
      scopeArguments: run copyArguments(List<Argument>.asSlice(&target.scopeArguments)),
      inferOwner: target.inferOwner,
    explicitSyntax: target.explicitSyntax,
    }}
  }
}

fn indexOfResolvedCall(calls: &[ResolvedCall], id: HirId) -> Option<usize> {
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].id.index == id.index {
      // Static operands are selection metadata for this invocation. Its ordinary callee target
      // remains a separate fact at the same authored identity and controls runtime dispatch.
      let operands = match &calls[at].result {
        Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Selected {fact: SelectionFact.StaticArguments {..}}} => true
        _ => false
      }
      if !operands {return Option<usize>.some(at)}
    }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

effect fn resolvedCall(calls: &[ResolvedCall], id: HirId) -> Option<
  Result<ResolvedTarget, Shared<Rejection>>,
> ! OutOfMemoryError ? &mut Allocator {
  let found = indexOfResolvedCall(calls, id)
  let at = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option<Result<ResolvedTarget, Shared<Rejection>>>.none()
    }
  }
  return match & calls[at].result {
    Result<ResolvedTarget, Shared<Rejection>>.Success {value} => Option<
      Result<ResolvedTarget, Shared<Rejection>>,
    >.some(Result<ResolvedTarget, Shared<Rejection>>.succeed(run copyResolvedTarget(&value)))
    Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Option<
      Result<ResolvedTarget, Shared<Rejection>>,
    >.some(Result<ResolvedTarget, Shared<Rejection>>.failResult(Shared<Rejection>.clone(&error)))
  }
}

// A written interface qualifier fixes the contract declaration. Its unique declared bound fixes
// the application and provider; without a bound, the leading operand supplies an open provider
// whose conformance must still be proved rather than assumed from a concrete caller.
struct BodyScope {
  binders: List<Binder>,
  ownCount: usize,
}

// Checked bodies retain lexical declaration owners; only backend realization supplies values.
effect fn bodyScope(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  moduleOrdinal: usize, module: &ModuleId, ordinal: usize,
) -> Result<BodyScope, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let own = run templateBinders(&mut resolver.*, module, ordinal)
  let mut binders = match move own {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => { return Result<BodyScope, Shared<Rejection>>.failResult(move error) }
  }
  let ownCount = List<Binder>.length(&binders)
  let scope = run enclosingScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, ordinal)
  let enclosing = match move scope {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => { return Result<BodyScope, Shared<Rejection>>.failResult(move error) }
  }
  let visible = List<Binder>.asSlice(&enclosing)
  let refines = run refinesEnclosing(&mut resolver.*, module, ordinal)
  let mut at = usize.ZERO
  while at < ownCount {
    let restated = run restatedBinder(&binders, at, visible, refines)
    if let Option<Binder>.Some {value} = move restated { List<Binder>.set(&mut binders, at, move value) }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < visible.length {
    run List<Binder>.append(&mut binders, run copyBinder(&visible[at]))
    at = at + usize.ONE
  }
  return Result<BodyScope, Shared<Rejection>>.succeed(BodyScope {binders: move binders, ownCount: ownCount})
}

// Resolve the authored qualifier in the same lexical binder and constraint scope as its caller.
effect fn qualifiedInterfaceContract(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, caller: &DeclarationId, syntax: HirId, span: Span, constraints: &[Constraint],
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(caller))
  let found = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let ordinal = match move found {
    Option<usize>.Some {value} => value
    _ => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let scope = run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, ordinal)
  let scoped = match move scope {
    Result<BodyScope, Shared<Rejection>>.Success {value} => move value
    Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.some(DeclarationId.copy(caller)), nextOrdinal: scoped.ownCount, output: false,
    resultDefault: Option<Shared<Lifetime>>.none(), generated: List<Shared<Lifetime>>.make(),
    invocation: false, nested: false, renumber: List<usize>.make(), staticEnvironment: false,
    supplied: Option<List<Argument>>.none(), assumptions: Option<List<Constraint>>.some(run copyConstraints(constraints)), deferred: Option<List<DeferredBounds>>.none(),
  }
  return run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, syntax,
    List<Binder>.asSlice(&scoped.binders), &mut elision)
}

// The bindings an interface operation call's written type arguments fix, resolved in the caller's
// scope: `Echo.echo<i32>` binds the operation's own `T`. Written lifetimes are not supported here.
// An interface operation's written type arguments: those that fix a binder, and those with an
// elided region that fix only the shape the operands' inferred argument must have.
struct OperationPrefix {
  bindings: List<Binding>,
  shapes: List<Binding>,
}

effect fn operationPrefixBindings(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, caller: &DeclarationId, contractModule: &ModuleId, operation: &DeclarationId,
  signature: &Shared<Result<Answer, NoRejection>>, written: HirRef, constraints: &[Constraint], span: Span,
) -> Result<OperationPrefix, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let callerIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(caller))
  let callerOrdinal = match move run ordinalOfIdentity(&mut resolver.*, module, &callerIdentity) {
    Option<usize>.Some {value} => value
    _ => { return Result<OperationPrefix, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let operationIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(operation))
  let operationOrdinal = match move run ordinalOfIdentity(&mut resolver.*, contractModule, &operationIdentity) {
    Option<usize>.Some {value} => value
    _ => { return Result<OperationPrefix, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let scoped = match move run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, callerOrdinal) {
    Result<BodyScope, Shared<Rejection>>.Success {value} => move value
    Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result<OperationPrefix, Shared<Rejection>>.failResult(move error) }
  }
  // More written arguments than the operation's own type parameters is an arity error at the call;
  // the list never reaches the contract's parameters, which its qualifier or provider fixes.
  let declared = match move run templateBinders(&mut resolver.*, contractModule, operationOrdinal) {
    Result<List<Binder>, Shared<Rejection>>.Success {value} => binderCountOfKind(List<Binder>.asSlice(&value), false)
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => { return Result<OperationPrefix, Shared<Rejection>>.failResult(move error) }
  }
  if let Option<HeaderSyntax>.Some {value: syntax} = move run typeNode(&mut resolver.*, module, written.id) {
    if let Node.TypeArguments {arguments: supplied, ..} = syntax.header {
      if supplied.length > declared {
        return Result<OperationPrefix, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, declared, supplied.length))
      }
    }
  }
  let prefix = run resolveCallPrefix(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, contractModule,
    operationOrdinal, signature, written, List<Binder>.asSlice(&scoped.binders), constraints, emptyCallPrefix(), span)
  let resolved = match move prefix {
    Result<CallPrefix, Shared<Rejection>>.Success {value} => move value
    Result<CallPrefix, Shared<Rejection>>.Failure {error} => { return Result<OperationPrefix, Shared<Rejection>>.failResult(move error) }
  }
  // A written argument with an elided region, as `string` in `pick<string>(...)`, fixes only the
  // argument's shape: the operands infer it with their regions, and the call checks they agree.
  let pending = match &resolved.owner {
    Option<Shared<DeclarationId>>.Some {value} => Option<DeclarationId>.some(DeclarationId.copyShared(&value))
    Option<Shared<DeclarationId>>.None => Option<DeclarationId>.none()
  }
  let slots = List<CallPrefixSlot>.asSlice(&resolved.slots)
  let values = List<Argument>.asSlice(&resolved.arguments)
  if slots.length != values.length { fail RevisionMismatch {} }
  let shared = run Shared<DeclarationId>.make(DeclarationId.copy(operation))
  let mut bindings = List<Binding>.make()
  let mut shapes = List<Binding>.make()
  let mut at = usize.ZERO
  while at < slots.length {
    let ordinal = callPrefixSlotOrdinal(&slots[at], operation)
    let typed = match &values[at] { Argument.Type {..} => true _ => false }
    if ordinal == usize.MAX || !typed {
      return Result<OperationPrefix, Shared<Rejection>>.failResult(run genericOperationRejection(module, span, operation))
    }
    let elided = match &pending {
      Option<DeclarationId>.Some {value: template} => run argumentMentionsOwner(&values[at], &template)
      Option<DeclarationId>.None => false
    }
    let binding = Binding {declaration: Shared<DeclarationId>.clone(&shared), ordinal: ordinal, value: Argument.copy(&values[at])}
    if elided { run List<Binding>.append(&mut shapes, move binding) } else { run List<Binding>.append(&mut bindings, move binding) }
    at = at + usize.ONE
  }
  return Result<OperationPrefix, Shared<Rejection>>.succeed(OperationPrefix {bindings: move bindings, shapes: move shapes})
}

// An interface operation operand's context. It knows the operation's type arguments fixed so far,
// so a literal after `value: T` takes the type an earlier operand gave `T`; while the parameter
// still names an unfixed type argument, the operand has no context.
effect fn operationOperandContext(source: &SourceIndex, cursor: &AuthoredCursor, expression: HirId,
  parameter: &Shared<Type>, operation: &DeclarationId, caller: &DeclarationId, inferred: &[Binding], operationTypes: bool,
) -> Option<Shared<Type>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !operationTypes {
    return run operationArgumentContext(source, cursor, expression, parameter, operation, caller)
  }
  let known = run typeBindingsOnly(inferred)
  let fixed = run Type.applyBindings(parameter, List<Binding>.asSlice(&known), false)
  if run ownsTypeParameters(&fixed, operation) { return Option<Shared<Type>>.none() }
  return run operationArgumentContext(source, cursor, expression, &fixed, operation, caller)
}

// Every type parameter of an interface operation is bound at its call, and the bounds that name
// them hold for their arguments under the caller's premises. Region bounds stay with the region check.
effect fn proveOperationTypeBounds(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, signature: &Shared<Result<Answer, NoRejection>>, operation: &DeclarationId, inferred: &[Binding],
  constraints: &[Constraint], span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let binderCount = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureBinderCount)
  let mut at = usize.ZERO
  while at < binderCount {
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<InferenceBinder>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    if let Option<InferenceBinder>.Some {value: InferenceBinder.Type {..}} = move binder {
      let bound = match move bindingArgumentAt(inferred, at) {
        Option<Argument>.Some {value} => !run argumentMentionsOwner(&value, operation)
        Option<Argument>.None => false
      }
      if !bound { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.TypeArgumentInference, span)) }
    }
    at = at + usize.ONE
  }
  let mut owed = List<Constraint>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut boundAt = usize.ZERO
  while boundAt < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
    if let Option<Constraint>.Some {value} = move bound {
      if run constraintMentionsOwner(&value, operation) {
        run List<Constraint>.append(&mut owed, run applyConstraintBindings(&value, inferred))
      }
    }
    boundAt = boundAt + usize.ONE
  }
  let premises = run copyConstraints(constraints)
  return run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &premises, List<Constraint>.asSlice(&owed),
    module, span, RegionProof.RegionCheck)
}

// Whether `bound` is a contents bound whose subject holds no region and names no type parameter,
// as `i32: 'env` for a generic `effect fn` operation's argument: it holds for every region.
effect fn regionFreeContents(bound: &Constraint) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Constraint.Contents {subject, ..} = &bound.* {
    if run Type.namesTypeParameter(&subject) { return false }
    let mut atoms = List<Shared<Lifetime>>.make()
    run Type.everyRegionAtom(&subject, &mut atoms)
    return List<Shared<Lifetime>>.length(&atoms) == usize.ZERO
  }
  return false
}

// The type bindings of `bindings`, without its lifetime and row bindings.
effect fn typeBindingsOnly(bindings: &[Binding]) -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut kept = List<Binding>.make()
  let mut at = usize.ZERO
  while at < bindings.length {
    if let Argument.Type {..} = &bindings[at].value {
      run List<Binding>.append(&mut kept, Binding {declaration: Shared<DeclarationId>.clone(&bindings[at].declaration),
        ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value)})
    }
    at = at + usize.ONE
  }
  return move kept
}

// Whether `value` still names one of `owner`'s type parameters.
effect fn ownsTypeParameters(value: &Shared<Type>, owner: &DeclarationId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  return List<usize>.length(&types) > usize.ZERO
}

// Missing operation-owned inputs keep the selected operation in diagnostic evidence, so the
// backend can name this boundary without guessing from qualifier syntax or reading a body.
effect fn genericOperationRejection(module: &ModuleId, span: Span, operation: &DeclarationId) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut path = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut path, run Shared<DeclarationId>.make(DeclarationId.copy(operation)))
  return run Shared<Rejection>.make(Rejection {
    code: RejectionCode.Unsupported, module: ModuleId.copy(module), span: span,
    related: Option<RelatedSite>.none(), path: move path, expected: usize.ZERO, supplied: usize.ZERO,
    parameterName: Bytes.make(), expectedKind: GenericKind.Type, suppliedKind: GenericKind.Type,
    witness: Option<WitnessProblem>.none(), termination: TerminationStep.Peer,
    staticFailure: Option<StaticDiagnostic>.none(), specialization: List<Application>.make(), arguments: List<MessageArgument>.make(), owner: usize.MAX,
  })
}

// INTF-006: an unapplied qualified call of a generic interface takes the one application the
// provider's visible conformances supply. A conformance head contributes when it matches the
// provider and that match fixes every one of its binders; distinct applications, or a head whose
// application the provider leaves open, make the call ambiguous. The expected result never selects.
effect fn inferredInterfaceApplication(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  contractModule: usize,
  contractOrdinal: usize,
  provider: &Shared<Type>,
  module: &ModuleId,
  span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let providerApplication = run internApplication(&mut resolver.*, provider)
  let declarationAccess113Request = Key {
      family: Family.ConformanceHeads,
      module: contractModule,
      name: providerApplication,
      declaration: contractOrdinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess113 = run internDeclaration(&mut resolver.*, declarationAccess113Request)
  let bucket = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess113,
    span,
    true,
  )
  let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&bucket, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&bucket, bucketCount)
  let mut candidates = List<Shared<Type>>.make()
  let mut open = false
  let mut undecided = false
  let mut at = usize.ZERO
  while at < count {
    let listed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(
      &bucket,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return bucketAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move listed {
      let terms = Shared<ImplementationHead>.with<Option<HeadTerms>>(&head, headTerms)
      if let Option<HeadTerms>.Some {value: found} = move terms {
        let headOwner = DeclarationId.copyShared(&found.declaration)
        let mut variables = List<Shared<DeclarationId>>.make()
        run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(&found.declaration))
        let mut bindings = List<Binding>.make()
        let mut matched = run Type.unify(&found.provider, provider, List<Shared<DeclarationId>>.asSlice(&variables),
          Comparison.Exact, &mut bindings)
        if exactHeadMatched(&matched) {
          matched = run admitRepresentations(&head, List<Shared<DeclarationId>>.asSlice(&variables), &mut bindings)
        }
        if exactHeadUndetermined(&matched) {
          undecided = true
        }
        if exactHeadMatched(&matched) {
          let binderCount = Shared<ImplementationHead>.with<usize>(&head, headBinderCount)
          let lent = List<Shared<Lifetime>>.make()
          let fixed = run matchedArguments(binderCount, &headOwner, List<Binding>.asSlice(&bindings),
            List<Shared<Lifetime>>.asSlice(&lent))
          if let Option<List<Argument>>.Some {value: arguments} = move fixed {
            drop arguments
            let candidate = run Type.applyBindings(&found.contract, List<Binding>.asSlice(&bindings), true)
            let known = List<Shared<Type>>.asSlice(&candidates)
            let mut repeated = false
            let mut seen = usize.ZERO
            while seen < known.length {
              if run Type.equalsShared(&known[seen], &candidate) {
                repeated = true
              }
              seen = seen + usize.ONE
            }
            if !repeated {
              run List<Shared<Type>>.append(&mut candidates, move candidate)
            }
          } else {
            open = true
          }
        }
      }
    }
    at = at + usize.ONE
  }
  if undecided {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let distinct = List<Shared<Type>>.length(&candidates)
  if open || distinct > usize.ONE {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.AmbiguousSuppliedOperation, span),
    )
  }
  if distinct == usize.ZERO {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.MissingConformance, span),
    )
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(List<Shared<Type>>.remove(&mut candidates, usize.ZERO))
}

// Checks `&x` as an interface call's first argument. It is the ordinary borrow, except that a
// slice `x` gives a reference to the slice, which the receiver of a slice provider needs.
effect fn checkReceiverBorrow<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  argument: HirId, access: Access, operand: HirId, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, argument)
  let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, argument, access, operand, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
    false, true, run anchoredNode(cursor, argument), usize.MAX, constraints, contractBody, false, unsafeAllowed)
  let borrowed = match move checked {
    Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
    Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    argument, span, move borrowed.ty, BodyExpression.Borrow {access: access, value: borrowed.value},
    false, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, contractBody, false)
}

effect fn checkQualifiedInterfaceCall<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  operationGenerics: HirRef,
  arguments: CallArguments,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  qualifier: &QualifiedBodyName,
  selected: SelectedDeclaration,
  fixedContract: Option<Shared<Type>>,
  isPublic: bool,
  unsafeAllowed: bool,
  callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let contractModule = resolvedModule(&resolver.*, selected.module)
  let identity = run declarationAt(&mut resolver.*, &contractModule, selected.ordinal)
  let interfaceId = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  // An alias qualifier that fixes the interface's arguments is the explicit application (TYPE-004).
  let mut explicitContract = move fixedContract
  if let Option<HirId>.Some {value: syntax} = &qualifier.application {
    if let Option<Shared<Type>>.Some {..} = &explicitContract {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeArity, qualifier.subjectSpan)
    }
    let resolved = run qualifiedInterfaceContract(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, caller, syntax, qualifier.subjectSpan, constraints)
    explicitContract = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => Option<Shared<Type>>.some(move value)
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  let mut chosenContract = Option<Shared<Type>>.none()
  let mut chosenProvider = Option<Shared<Type>>.none()
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Conforms {provider, contract} = &constraints[at] {
      let matches = Shared<Type>.with<bool>(
        &contract,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, &interfaceId)
            _ => false
          }
        },
      )
      let mut selectedGoal = matches
      if let Option<Shared<Type>>.Some {value: requested} = &explicitContract {
        if selectedGoal { selectedGoal = run Type.equalsShared(&contract, &requested) }
      }
      if selectedGoal {
        if let Option<Shared<Type>>.Some {value: unused} = &chosenContract {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        chosenContract = Option<Shared<Type>>.some(Shared<Type>.clone(&contract))
        chosenProvider = Option<Shared<Type>>.some(Shared<Type>.clone(&provider))
      }
    }
    at = at + usize.ONE
  }
  let mut firstArgument = Option<BodyNodeId>.none()
  let needsInference = match & chosenContract {
    Option<Shared<Type>>.Some {..} => false
    Option<Shared<Type>>.None => true
  }
  if needsInference {
    let mut generic = false
    if let Option<Shared<Type>>.None = &explicitContract {
      let template = run templateBinders(&mut resolver.*, &contractModule, selected.ordinal)
      let binders = match move template {
        Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
        Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      generic = List<Binder>.length(&binders) > usize.ZERO
    }
    if CallArguments.length(arguments) == usize.ZERO {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let firstId = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
    // A borrowed receiver borrows its operand itself, so `&slice` selects the slice's conformance
    // through `& &[E]` instead of reborrowing the elements.
    let checked = match run bodyNode(&resolver.source, cursor, firstId) {
      Node.BorrowExpression {access, operand} => run checkReceiverBorrow(&mut resolver.*, &mut owner.*,
        &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, firstId, access, operand, constraints, contractBody, unsafeAllowed)
      _ => run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        firstId,
        &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
        constraints,
        contractBody,
        false,
        unsafeAllowed,
      )
    }
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    let inferred = match & List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared<Type>.clone(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    firstArgument = Option<BodyNodeId>.some(node)
    let provider = Shared<Type>.with<Option<Shared<Type>>>(
      &inferred,
      fn(value: &Type) -> Option<Shared<Type>> {
        return match & value.* {
          Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
          _ => Option<Shared<Type>>.none()
        }
      },
    )
    let operand = match move provider {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => move inferred
    }
    if generic {
      // INTF-006: the operand's provider selects the one application its conformances supply.
      let application = run inferredInterfaceApplication(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, selected.module, selected.ordinal, &operand, module, span)
      chosenContract = match move application {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => Option<Shared<Type>>.some(move value)
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
    } else {
      chosenContract = match &explicitContract {
        Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
        Option<Shared<Type>>.None => Option<Shared<Type>>.some(run Types.intern(Type.Nominal {
          declaration: DeclarationId.copy(&interfaceId), isPublic: isPublic, arguments: List<Argument>.make(),
        }))
      }
    }
    chosenProvider = Option<Shared<Type>>.some(move operand)
  }
  let contract = match move chosenContract {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let provider = match move chosenProvider {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let declarationAccess114Request = Key {
      family: Family.Operations,
      module: selected.module,
      name: usize.ZERO,
      declaration: selected.ordinal,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess114 = run internDeclaration(&mut resolver.*, declarationAccess114Request)
  let listed = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    declarationAccess114,
    span,
    true,
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &listed,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, operationCount)
  let mut operation = Option<DeclarationId>.none()
  at = usize.ZERO
  while at < count {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operationAt(answer, at)
      },
    )
    if let Option<Shared<DeclarationId>>.Some {value: candidate} = move found {
      let named = Shared<DeclarationId>.with<bool>(
        &candidate,
        fn(value: &DeclarationId) -> bool {
          return DeclarationId.named(value, Bytes.asSlice(&qualifier.member))
        },
      )
      if named {
        let ordinal = run ordinalOfIdentity(&mut resolver.*, &contractModule, &candidate)
        if let Option<usize>.Some {value: position} = move ordinal {
          operation = run declarationAt(&mut resolver.*, &contractModule, position)
        }
        break
      }
    }
    at = at + usize.ONE
  }
  let operationId = match move operation {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnknownOperation, span)
    }
  }
  let selectedCall = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &contract,
    &provider,
    &operationId,
    constraints,
    module,
    span,
  )
  let selectedOperation = match move selectedCall {
    Result<OperationCall, Shared<Rejection>>.Success {value} => move value
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let OperationCall {operation: chosenOperation, implementation, signature, proof, receiver: _} = move selectedOperation
  drop proof
  // A `static` operation runs only during static evaluation, which selects its witness then.
  if !staticBody && Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsStatic) {
    let mut operation = run Bytes.copy(b"`")
    run Bytes.append(&mut operation, Bytes.asSlice(&qualifier.namespace))
    run Bytes.append(&mut operation, b".")
    run Bytes.append(&mut operation, Bytes.asSlice(&qualifier.member))
    run Bytes.append(&mut operation, b"`")
    return run staticOperationAtRuntime(module, span, move operation)
  }
  // Static parameters take the values this body's selection pass evaluated for the call. The
  // operation is known only now, so a call the selection has not seen reports itself and the body
  // is selected again; a static body cannot supply them yet.
  let mut suppliedStatics = Option<Shared<List<StaticSlot>>>.none()
  if Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureStaticCount) > usize.ZERO {
    if staticBody { return Result<BodyNodeId, Shared<Rejection>>.failResult(run staticArgumentsGap(module, span, b"0")) }
    suppliedStatics = staticArgumentsFact(calls, expression)
    if let Option<Shared<List<StaticSlot>>>.None = &suppliedStatics {
      run discoverStaticCall(&mut resolver.*, &signature, expression, usize.ZERO)
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run staticArgumentsGap(module, span, b"0"))
    }
  }
  let mut statics = List<StaticSlot>.make()
  let parameterCount = Shared<Result<Answer, NoRejection>>.with<usize>(
    &signature,
    signatureParameterCount,
  )
  if CallArguments.length(arguments) > parameterCount {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if CallArguments.length(arguments) == usize.ZERO && parameterCount > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.RedundantCall, span)
  }
  if CallArguments.length(arguments) < parameterCount {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  // An operation's own type arguments are written after it (`Echo.echo<i32>(...)`) or inferred
  // from its operands, as at a direct call; the witness is specialized with them.
  let mut inferred = List<Binding>.make()
  let mut explicit = List<usize>.make()
  let mut shapes = List<Binding>.make()
  if operationGenerics.present {
    let written = run operationPrefixBindings(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
      &contractModule, &chosenOperation, &signature, operationGenerics, constraints, span)
    let OperationPrefix {bindings, shapes: elided} = match move written {
      Result<OperationPrefix, Shared<Rejection>>.Success {value} => move value
      Result<OperationPrefix, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    shapes = move elided
    let listed = List<Binding>.asSlice(&bindings)
    let mut writtenAt = usize.ZERO
    while writtenAt < listed.length {
      run List<usize>.append(&mut explicit, listed[writtenAt].ordinal)
      writtenAt = writtenAt + usize.ONE
    }
    inferred = move bindings
  }
  let operationTypes = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureNonLifetimeBinderCount) > usize.ZERO
  let unsafeCall = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureUnsafe)
  if unsafeCall && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if callAcknowledged && !unsafeCall {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(
    &mut variables,
    run Shared<DeclarationId>.make(DeclarationId.copy(&chosenOperation)),
  )
  let mut typedArguments = List<BodyNodeId>.make()
  at = usize.ZERO
  while at < CallArguments.length(arguments) {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    if let Option<Shared<List<StaticSlot>>>.Some {value: slots} = &suppliedStatics {
      let selected = Shared<List<StaticSlot>>.with<Option<Shared<StaticData>>>(&slots,
        fn(listed: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(listed, at) })
      if let Option<Shared<StaticData>>.Some {value} = move selected {
        let argumentSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, at))
        let refused = run interfaceStaticOperand(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &parameterType,
          List<Binding>.asSlice(&inferred), &value, argumentSpan)
        if let Option<Shared<Rejection>>.Some {value: reason} = move refused { return Result<BodyNodeId, Shared<Rejection>>.failResult(move reason) }
        run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: at, value: move value})
        at = at + usize.ONE
        continue
      }
    }
    let mut already = false
    let mut argumentNode = BodyNodeId {index: usize.ZERO}
    if at == usize.ZERO {
      if let Option<BodyNodeId>.Some {value} = &firstArgument {
        already = true
        argumentNode = BodyNodeId {index: value.index}
      }
    }
    if !already {
      let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
      let context = run operationOperandContext(&resolver.source, cursor, argumentId, &parameterType,
        &chosenOperation, caller, List<Binding>.asSlice(&inferred), operationTypes)
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        caller,
        &mut statementScope.*,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        argumentId,
        &context, RejectionCode.TypeMismatch,
        constraints,
        contractBody,
        false,
        unsafeAllowed,
      )
      argumentNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
    }
    // As at a direct call, a fresh loan takes the caller's call region, so operands that share an
    // operation lifetime infer one region; a slice reborrow keeps its source region.
    let argumentSyntax = run originSyntax(cursor, List<BodyNode>.asSlice(&nodes.*)[argumentNode.index].origin)
    let sliceParameter = match move Type.sliceElement(&parameterType) { Option<Shared<Type>>.Some {..} => true _ => false }
    if !sliceParameter {
      if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, argumentSyntax) {
        let rejected = run contributeBorrowCallRegion(&mut resolver.*, module, &mut nodes.*, caller, argumentNode, expression, span, &run cursorAnchor(cursor),
          parameterBinder(&parameterType, &chosenOperation))
        if let Option<Shared<Rejection>>.Some {value} = move rejected {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
        }
      }
    }
    let slicedArgument = run sliceArgument(&mut nodes.*, argumentNode, &parameterType)
    let adaptedArgument = run unionArgument(&mut nodes.*, slicedArgument, &parameterType)
    let argumentType = match & List<BodyNode>.asSlice(&nodes.*)[adaptedArgument.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared<Type>.clone(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let pattern = run callArgumentType(
      &parameterType, &signature, &chosenOperation, List<Binding>.asSlice(&inferred),
      caller, expression, false, &run cursorAnchor(cursor),
    )
    let failed = run matchArgumentRegions(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
      &parameterType, &pattern, &argumentType, &signature, &chosenOperation,
      List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred,
      List<usize>.asSlice(&explicit), constraints, List<BodyNode>.asSlice(&nodes.*),
      run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[adaptedArgument.index].origin), span, false,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move diagnostic)
    }
    run List<BodyNodeId>.append(&mut typedArguments, adaptedArgument)
    at = at + usize.ONE
  }
  return run finishInterfaceCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*,
    &mut signatures.*, expression, span, move contract, move provider, move chosenOperation, move implementation,
    &signature, move typedArguments, move inferred, move shapes, Option<BodyReceiverPass>.none(), expected, mismatchCode, constraints,
    contractBody, staticBody, move statics)
}

// An interface operation call once its provider, witness and operands are selected and checked: a
// callable success awaits its witness's original value, and an `effect fn` operation constructs
// the Effect its applied contract promises (INTF-005), for the qualified and receiver spellings alike;
// the enclosing `run` executes it as one call of the selected witness.
effect fn finishInterfaceCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId, nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, expression: HirId, span: Span, contract: Shared<Type>,
  provider: Shared<Type>, operation: DeclarationId, implementation: Option<Shared<DeclarationId>>,
  signature: &Shared<Result<Answer, NoRejection>>, typedArguments: List<BodyNodeId>, matched: List<Binding>, shapes: List<Binding>,
  receiverPass: Option<BodyReceiverPass>, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, statics: List<StaticSlot>,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // As at a direct call, the call's use chooses a binder only its outcome names (`bindUseLifetimes`),
  // and an inferred binder shortens before the bound proof: to the region a `T: 'binder` bound asks
  // for, to the 'longer of a `'longer: 'binder` bound when the use left it 'static, and in a runtime
  // body to its meet with what the operands lend. An interface call writes no operation binder.
  let mut inferred = move matched
  // A written type argument with an elided region is the shape the operands inferred.
  let shaped = List<Binding>.asSlice(&shapes)
  let mut shapeAt = usize.ZERO
  while shapeAt < shaped.length {
    let agrees = match move bindingArgumentAt(List<Binding>.asSlice(&inferred), shaped[shapeAt].ordinal) {
      Option<Argument>.Some {value: Argument.Type {value: found}} => match &shaped[shapeAt].value {
        Argument.Type {value: wanted} => run Type.runtimeEqualsShared(&found, &wanted)
        _ => false
      }
      Option<Argument>.Some {..} => false
      Option<Argument>.None => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.TypeArgumentInference, span))
      }
    }
    if !agrees { return Result<BodyNodeId, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span)) }
    shapeAt = shapeAt + usize.ONE
  }
  let written = List<usize>.make()
  let binderCount = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureBinderCount)
  let callOwner = run Shared<DeclarationId>.make(DeclarationId.copy(&operation))
  let mut defaulted = List<usize>.make()
  let earlier = run operationOrdinals(List<Binding>.asSlice(&inferred), &operation)
  run bindUseLifetimes(signature, &operation, &callOwner, binderCount, expected,
    Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsEffect), &mut inferred, &mut defaulted)
  // A binder the expected type chose is the caller's promise: no shortening may move it.
  let mut chosen = List<usize>.make()
  let bound = run operationOrdinals(List<Binding>.asSlice(&inferred), &operation)
  let mut chosenAt = usize.ZERO
  while chosenAt < List<usize>.length(&bound) {
    let ordinal = List<usize>.asSlice(&bound)[chosenAt]
    if !containsOrdinal(&earlier, ordinal) && !containsOrdinal(&defaulted, ordinal) { run List<usize>.append(&mut chosen, ordinal) }
    chosenAt = chosenAt + usize.ONE
  }
  run boundShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, signature, &operation,
    &mut inferred, List<usize>.asSlice(&written), constraints, caller, expression, span, &run cursorAnchor(cursor))
  let shortening = !staticBody && finiteResultBodyFrame(&resolver.*, caller)
  let mut pinned = List<usize>.make()
  let mut pinnedAt = usize.ZERO
  while pinnedAt < binderCount {
    if !shortening || !containsOrdinal(&defaulted, pinnedAt) {
      run List<usize>.append(&mut pinned, pinnedAt)
    }
    pinnedAt = pinnedAt + usize.ONE
  }
  if run outlivesShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, &operation,
    &mut inferred, List<usize>.asSlice(&pinned), constraints, span) {
    run recordShortened(&mut resolver.*, span)
  }
  if shortening {
    run evidenceShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, &operation, &mut inferred,
      List<usize>.asSlice(&written), constraints, caller, List<BodyNode>.asSlice(&nodes.*), span)
    run environmentShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, &operation, &mut inferred,
      List<usize>.asSlice(&written), caller, List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&typedArguments), span)
  }
  // The contract's operation bounds every conforming witness (EFF-009). The call owes the
  // operation's declared region bounds, which the region check holds from the call's contract; each
  // must name only regions the call inferred.
  let constraintCount = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut boundAt = usize.ZERO
  while boundAt < constraintCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
    let declared = match move bound {
      Option<Constraint>.Some {value} => move value
      Option<Constraint>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    let region = match &declared { Constraint.Outlives {..} => true Constraint.Contents {..} => true _ => false }
    let applied = run applyConstraintBindings(&declared, List<Binding>.asSlice(&inferred))
    let trivial = run regionFreeContents(&applied)
    if region && !trivial && run constraintMentionsOwner(&applied, &operation) {
      return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
    }
    boundAt = boundAt + usize.ONE
  }
  // An operation's own type parameters take the call's written or inferred arguments, which owe
  // the operation's bounds on them, as `pick<T: Copy>` owes `Copy` for its argument.
  if Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureNonLifetimeBinderCount) > usize.ZERO {
    let failure = run proveOperationTypeBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, signature,
      &operation, List<Binding>.asSlice(&inferred), constraints, span)
    if let Option<Shared<Rejection>>.Some {value} = move failure {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
    }
  }
  let isEffect = Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsEffect)
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    signature,
    signatureResult,
  )
  let rawResult = match move result {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut resultType = run Type.applyBindings(&rawResult, List<Binding>.asSlice(&inferred), true)
  if !contractBody && !Shared<Type>.with<bool>(&resultType, runtimeType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  if Shared<Type>.with<bool>(&resultType, rawCallableType) {
    // A callable success would need the witness's original environment through its Effect.
    if isEffect {
      return run bodyRejection(&resolver.*, module, RejectionCode.InterfaceEffectUnavailable, span)
    }
    let recipe = run callableWitnessResult(caller, &operation, &contract, &provider, &resultType, signature,
      List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&typedArguments), List<Binding>.asSlice(&inferred))
    resultType = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &recipe, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  if isEffect {
    // The applied contract's channels bound every conforming witness (EFF-009); the call keeps
    // them even when the selected witness declares smaller ones.
    let declaredFailure = run signatureFailure(signature)
    let declaredRequirements = run signatureRequirements(signature)
    let constructed = run constructEffect(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
      List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&typedArguments), move resultType,
      run Type.applyBindings(&declaredFailure, List<Binding>.asSlice(&inferred), true),
      run Row.applyBindings(&declaredRequirements, List<Binding>.asSlice(&inferred), true),
      constraints, run anchoredNode(cursor, expression), span)
    let built = match move constructed {
      Result<EffectConstruction, Shared<Rejection>>.Success {value} => move value
      Result<EffectConstruction, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    let EffectConstruction {contract: constructedContract, captures, fieldInputs} = move built
    drop fieldInputs
    // The Effect's exact representation is the selected witness's construction over the stored
    // arguments, the same value calling that witness directly constructs (EFF-001).
    let recipe = run effectWitnessResult(caller, &operation, &contract, &provider, move constructedContract,
      move captures, List<BodyNode>.asSlice(&nodes.*), List<BodyNodeId>.asSlice(&typedArguments), List<Binding>.asSlice(&inferred))
    resultType = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &recipe, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  run List<SignatureDependency>.append(
    &mut signatures.*,
    SignatureDependency {declaration: DeclarationId.copy(&operation)},
  )
  // An interface operation's provider stores through its conformance, which the kept analysis does
  // not describe: the call keeps whatever its contract's parameters name.
  let kept = run keptArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, List<Binding>.asSlice(&inferred),
    List<BodyNodeId>.length(&typedArguments), false, caller, span)
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(
    &mut nodes.*,
    BodyNode {
      origin: run originAt(cursor, expression, span),
      kind: BodyNodeKind.Expression {
        ty: move resultType,
        form: BodyExpression.InterfaceCall {
          contract: move contract,
          provider: move provider,
          operation: move operation,
          bindings: run Shared<List<Binding>>.make(move inferred),
          implementation: move implementation,
          receiverPass: move receiverPass,
          isEffect: isEffect,
          arguments: move typedArguments,
          kept: move kept,
          statics: run Shared<List<StaticSlot>>.make(move statics),
        },
      },
    },
  )
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// The ordinals of `fresh`'s binders that `bindings` holds.
effect fn operationOrdinals(bindings: &[Binding], fresh: &DeclarationId) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut ordinals = List<usize>.make()
  let mut at = usize.ZERO
  while at < bindings.length {
    if Shared<DeclarationId>.with<bool>(&bindings[at].declaration, fn(declared: &DeclarationId) -> bool {
      return DeclarationId.equals(declared, fresh)
    }) { run List<usize>.append(&mut ordinals, bindings[at].ordinal) }
    at = at + usize.ONE
  }
  return move ordinals
}

// The Effect an `effect fn` interface operation call constructs, awaiting its concrete witness.
effect fn effectWitnessResult(caller: &DeclarationId, operation: &DeclarationId, contract: &Shared<Type>,
  provider: &Shared<Type>, result: Shared<Type>, captures: List<Shared<Type>>, nodes: &[BodyNode],
  operands: &[BodyNodeId], assignments: &[Binding]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut bindings = List<Binding>.make()
  let mut at = usize.ZERO
  while at < assignments.length {
    run List<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&assignments[at].declaration),
      ordinal: assignments[at].ordinal, value: Argument.copy(&assignments[at].value)})
    at = at + usize.ONE
  }
  let mut loans = List<WitnessLoan>.make()
  at = usize.ZERO
  while at < operands.length {
    run List<WitnessLoan>.append(&mut loans, WitnessLoan {region: Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Local {
      declaration: DeclarationId.copy(caller), ordinal: nodes[operands[at].index].origin.node, binder: usize.MAX}))})
    at = at + usize.ONE
  }
  return run Types.intern(Type.CallableWitnessResult {witness: run Shared<WitnessRecipe>.make(WitnessRecipe {
    operation: run Shared<DeclarationId>.make(DeclarationId.copy(operation)),
    contract: Shared<Type>.clone(contract), provider: Shared<Type>.clone(provider), result: move result,
    bindings: run Shared<List<Binding>>.make(move bindings), arguments: run Shared<List<Shared<Type>>>.make(move captures),
    loans: run Shared<List<WitnessLoan>>.make(move loans), constructs: true,
  })})
}

effect fn callableWitnessResult(caller: &DeclarationId, operation: &DeclarationId, contract: &Shared<Type>,
  provider: &Shared<Type>, result: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  nodes: &[BodyNode], operands: &[BodyNodeId], assignments: &[Binding])
  -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut bindings = List<Binding>.make()
  let mut at = usize.ZERO
  while at < assignments.length {
    run List<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&assignments[at].declaration),
      ordinal: assignments[at].ordinal, value: Argument.copy(&assignments[at].value)})
    at = at + usize.ONE
  }
  let mut arguments = List<Shared<Type>>.make()
  let mut loans = List<WitnessLoan>.make()
  at = usize.ZERO
  while at < operands.length {
    let node = &nodes[operands[at].index]
    if let BodyNodeKind.Expression {ty, ..} = &node.kind {
      run List<Shared<Type>>.append(&mut arguments, Shared<Type>.clone(&ty))
    }
    // Descriptor operands must keep their shape through the header witness. They cannot use
    // owned-value borrowing, so their existing region needs no extra fresh transport slot.
    let publicOperand = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    let mut lent = true
    if let Option<Shared<Type>>.Some {value} = move publicOperand {
      lent = Shared<Type>.with<usize>(&value, operandShape) == usize.ZERO
    }
    let mut loan = Option<Shared<Lifetime>>.none()
    if lent { loan = Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Local {
      declaration: DeclarationId.copy(caller), ordinal: node.origin.node, binder: usize.MAX})) }
    run List<WitnessLoan>.append(&mut loans, WitnessLoan {region: move loan})
    at = at + usize.ONE
  }
  return run Types.intern(Type.CallableWitnessResult {witness: run Shared<WitnessRecipe>.make(WitnessRecipe {
    operation: run Shared<DeclarationId>.make(DeclarationId.copy(operation)),
    contract: Shared<Type>.clone(contract), provider: Shared<Type>.clone(provider), result: Shared<Type>.clone(result),
    bindings: run Shared<List<Binding>>.make(move bindings), arguments: run Shared<List<Shared<Type>>>.make(move arguments),
    loans: run Shared<List<WitnessLoan>>.make(move loans), constructs: false,
  })})
}

fn bodyExpressionType(nodes: &[BodyNode], node: &BodyNodeId) -> Option<Shared<Type>> {
  return match & nodes[node.index].kind {
    BodyNodeKind.Expression {ty, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&ty))
    _ => Option<Shared<Type>>.none()
  }
}

struct CheckedOperand {
  node: BodyNodeId,
  ty: Shared<Type>,
}

struct CheckedOperands {
  leftNode: BodyNodeId,
  leftType: Shared<Type>,
  rightNode: BodyNodeId,
  rightType: Shared<Type>,
}

struct CheckedOperatorCall {
  ty: Shared<Type>,
  form: BodyExpression,
}

fn orderCheckedOperands(swapped: bool, first: CheckedOperand, second: CheckedOperand) -> CheckedOperands {
  let CheckedOperand {node: firstNode, ty: firstType} = move first
  let CheckedOperand {node: secondNode, ty: secondType} = move second
  if swapped {
    return CheckedOperands {
      leftNode: secondNode,
      leftType: move secondType,
      rightNode: firstNode,
      rightType: move firstType,
    }
  }
  return CheckedOperands {
    leftNode: firstNode,
    leftType: move firstType,
    rightNode: secondNode,
    rightType: move secondType,
  }
}

effect fn checkedOperatorCall(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  caller: &DeclarationId,
  nodes: &[BodyNode],
  constraints: &[Constraint],
  selected: SelectedOperator,
  arguments: List<BodyNodeId>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  module: &ModuleId,
  span: Span,
  unsafeAllowed: bool,
) -> Result<CheckedOperatorCall, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let SelectedOperator {contract, provider, call} = move selected
  let OperationCall {
    operation,
    implementation,
    signature,
    proof: unusedProof,
    receiver: unusedReceiver,
  } = move call
  if Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureNonLifetimeBinderCount) > usize.ZERO {
    return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run genericOperationRejection(module, span, &operation))
  }
  if Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureStaticCount) > usize.ZERO
    || Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsStatic) {
    return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  if Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureUnsafe) && !unsafeAllowed {
    return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span))
  }
  // An operator on an `effect fn` operation constructs its Effect (OP-009), which `run (a * b)`
  // could execute; that construction has no representation here yet (named gap).
  if Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsEffect) {
    return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InterfaceEffectUnavailable, span),
    )
  }
  let supplied = List<BodyNodeId>.asSlice(&arguments)
  let mut operands = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < supplied.length {
    let ty = match move bodyExpressionType(nodes, &supplied[at]) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
    run List<Shared<Type>>.append(&mut operands, move ty)
    at = at + usize.ONE
  }
  let inferred = match move run inferOperatorOperands(&mut resolver.*, &signature, &operation, List<Shared<Type>>.asSlice(&operands)) {
    Option<List<Binding>>.Some {value} => move value
    Option<List<Binding>>.None => {
      return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
    }
  }
  // No use context or default region chooses an operand-free operation lifetime here. Keep
  // that unresolved operation application explicit rather than publishing an incomplete recipe.
  let lifetimeCount = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureLifetimeCount)
  at = usize.ZERO
  while at < lifetimeCount {
    let region = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureLifetimeAt(answer, at) })
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      let ordinal = Shared<Lifetime>.with<usize>(&value, fn(lifetime: &Lifetime) -> usize {
        return match &lifetime.* {
          Lifetime.Parameter {declaration, ordinal} => {
            if DeclarationId.equals(&declaration, &operation) { return ordinal }
            return usize.MAX
          }
          _ => usize.MAX
        }
      })
      if ordinal != usize.MAX {
        if let Option<Argument>.None = move bindingArgumentAt(List<Binding>.asSlice(&inferred), ordinal) {
          return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
        }
      }
    }
    at = at + usize.ONE
  }
  let mut bounds = List<Constraint>.make()
  let constraintCount = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  at = usize.ZERO
  while at < constraintCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run List<Constraint>.append(&mut bounds, run applyConstraintBindings(&value, List<Binding>.asSlice(&inferred)))
    } else {
      return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
    at = at + usize.ONE
  }
  let premises = run copyConstraints(constraints)
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &premises,
    List<Constraint>.asSlice(&bounds), module, span, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(move value)
  }
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let mut ty = match move result {
    Option<Shared<Type>>.Some {value} => run Type.applyBindings(&value, List<Binding>.asSlice(&inferred), true)
    Option<Shared<Type>>.None => {
      return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  if Shared<Type>.with<bool>(&ty, rawCallableType) {
    let recipe = run callableWitnessResult(caller, &operation, &contract, &provider, &ty, &signature,
      nodes, List<BodyNodeId>.asSlice(&arguments), List<Binding>.asSlice(&inferred))
    ty = match move run normalizeCallableResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &recipe, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(move error) }
    }
  }
  run List<SignatureDependency>.append(
    &mut signatures.*,
    SignatureDependency {declaration: DeclarationId.copy(&operation)},
  )
  if let Option<Shared<DeclarationId>>.Some {value: witness} = &implementation {
    let moduleOrdinal = Shared<DeclarationId>.with<usize>(
      &witness,
      fn(value: &DeclarationId) -> usize {
        return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
      },
    )
    if moduleOrdinal == usize.MAX {
      return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    let witnessModule = resolvedModule(&resolver.*, moduleOrdinal)
    let found = run ordinalOfIdentity(&mut resolver.*, &witnessModule, &witness)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
    }
    let declaration = run declarationAt(&mut resolver.*, &witnessModule, ordinal)
    if let Option<DeclarationId>.Some {value} = move declaration {
      run List<DeclarationId>.append(&mut requiredBodies.*, move value)
    } else {
      return Result<CheckedOperatorCall, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  // An operator's provider stores through its conformance: the call keeps whatever its contract's
  // parameters name.
  let kept = run keptArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*, &signature, List<Binding>.asSlice(&inferred),
    List<BodyNodeId>.length(&arguments), false, caller, span)
  return Result<CheckedOperatorCall, Shared<Rejection>>.succeed(
    CheckedOperatorCall {
      ty: move ty,
      form: BodyExpression.InterfaceCall {
        contract: move contract,
        provider: move provider,
        operation: move operation,
        bindings: run Shared<List<Binding>>.make(move inferred),
        implementation: move implementation,
        receiverPass: Option<BodyReceiverPass>.none(),
        isEffect: false,
        arguments: move arguments,
        kept: move kept,
        statics: run Shared<List<StaticSlot>>.make(List<StaticSlot>.make()),
      },
    },
  )
}

effect fn checkOperatorOperand<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
) -> Result<CheckedOperand, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    expression,
    expected, mismatchCode,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<CheckedOperand, Shared<Rejection>>.failResult(move error)
    }
  }
  let ty = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Result<CheckedOperand, Shared<Rejection>>.failResult(
        run reject(
          &resolver.*,
          module,
          RejectionCode.Unsupported,
          run bodySpan(&resolver.source, cursor, expression),
        ),
      )
    }
  }
  return Result<CheckedOperand, Shared<Rejection>>.succeed(CheckedOperand {node: node, ty: move ty})
}

effect fn selectInterfaceReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  provider: &Shared<Type>,
  member: &[u8],
  constraints: &[Constraint],
  module: &ModuleId,
  memberSpan: Span,
) -> Result<ReceiverCallChoice, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut selected = Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.succeed(
    Option<SelectedReceiverOperation>.none(),
  )
  if Shared<Type>.with<bool>(provider, isTypeParameter) {
    selected = run selectBoundReceiverCall(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      true,
      provider,
      member,
      constraints,
      module,
      memberSpan,
    )
  } else {
    selected = run selectConcreteReceiverCall(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      true,
      provider,
      member,
      constraints,
      module,
      memberSpan,
    )
  }
  let found = match move selected {
    Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.Success {value} => move value
    Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.Failure {error} => {
      return Result<ReceiverCallChoice, Shared<Rejection>>.failResult(move error)
    }
  }
  let operation = match move found {
    Option<SelectedReceiverOperation>.Some {value} => move value
    Option<SelectedReceiverOperation>.None => {
      return Result<ReceiverCallChoice, Shared<Rejection>>.failResult(
        run unknownOperationRejection(module, memberSpan, provider, member, true),
      )
    }
  }
  return Result<ReceiverCallChoice, Shared<Rejection>>.succeed(
    ReceiverCallChoice.Interface {selected: move operation},
  )
}

// A receiver call's written list binds a prefix of its member's own type binders; more arguments
// than the member declares is an arity error at the call (the receiver supplies the owner's). An
// open owner's `ownerTypes` binders lead the signature's list and are never written here.
effect fn writtenMemberPrefix(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, annotations: &[ResolvedAnnotation], signature: &Shared<Result<Answer, NoRejection>>,
  member: &DeclarationId, generics: HirRef, ownerTypes: usize, span: Span) -> Result<CallPrefix, Shared<Rejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<Argument>.make()
  let mut slots = List<CallPrefixSlot>.make()
  if !generics.present {
    return Result<CallPrefix, Shared<Rejection>>.succeed(CallPrefix {arguments: move arguments, slots: move slots,
      owner: Option<Shared<DeclarationId>>.none(), lifetimes: usize.ZERO})
  }
  let listSpan = run bodySpan(&resolver.source, cursor, generics.id)
  let mut written = Range.empty()
  let mut supported = false
  if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = run bodyNode(&resolver.source, cursor, generics.id) {
    written = supplied
    supported = !environment.present && !failures.present && !requirements.present
  }
  if !supported {
    return Result<CallPrefix, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, listSpan))
  }
  let declared = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureTypeParameterCount) - ownerTypes
  if written.length > declared {
    return Result<CallPrefix, Shared<Rejection>>.failResult(run rejectArity(resolver, module, span, declared, written.length))
  }
  let elided = run elidedLifetimeOwner(caller)
  let mut at = usize.ZERO
  while at < written.length {
    let argument = run bodyChild(&resolver.source, cursor, written, at)
    let argumentSpan = run bodySpan(&resolver.source, cursor, argument)
    // A written lifetime or requirement argument is not collected as a type.
    let resolved = match move indexOfAnnotation(annotations, argument) {
      Option<usize>.Some {value: index} => match &annotations[index].result {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => Shared<Type>.clone(&value)
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<CallPrefix, Shared<Rejection>>.failResult(Shared<Rejection>.clone(&error))
        }
      }
      Option<usize>.None => {
        return Result<CallPrefix, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, argumentSpan))
      }
    }
    // A region elided inside a written argument has no call-site inference lane yet.
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureTypeParameter(answer, ownerTypes + at) })
    let binder = match move parameter {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return Result<CallPrefix, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, argumentSpan))
      }
    }
    let ordinal = Shared<Type>.with<usize>(&binder, fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, member) })
    if ordinal == usize.MAX || run typeMentionsOwner(&resolved, &elided) {
      return Result<CallPrefix, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, argumentSpan))
    }
    run List<Argument>.append(&mut arguments, Argument.Type {value: move resolved})
    run List<CallPrefixSlot>.append(&mut slots, CallPrefixSlot.Type {value: move binder})
    at = at + usize.ONE
  }
  return Result<CallPrefix, Shared<Rejection>>.succeed(CallPrefix {arguments: move arguments, slots: move slots,
    owner: Option<Shared<DeclarationId>>.none(), lifetimes: usize.ZERO})
}

// A receiver meets its parameter by covariant region subtyping like any operand, such as
// `Trailers<'decoder>` borrowed for `self: &'owner Trailers<'owner>`.
effect fn matchReceiverOperand(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, nodes: &[BodyNode],
  operand: &CallReceiver, parameter: &Shared<Type>, fresh: &DeclarationId, caller: &DeclarationId,
  variables: &[Shared<DeclarationId>], explicit: &[usize], inferred: &mut List<Binding>, constraints: &[Constraint])
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = match move bodyExpressionType(nodes, &operand.node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, operand.memberSpan))
    }
  }
  let mut failed = run matchCallArgument(&resolver.*, module, operand.memberSpan, parameter, &actual, variables,
    &mut inferred.*, constraints, RejectionCode.TypeMismatch)
  let mismatch = match &failed {
    Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value,
      fn(rejection: &Rejection) -> bool { return valueMismatchReason(rejection.code) })
    Option<Shared<Rejection>>.None => false
  }
  if mismatch {
    let subtyped = run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, &actual,
      fresh, caller, variables, List<Binding>.asSlice(&inferred.*), explicit, constraints, operand.memberSpan)
    if let Option<RelatedArgument>.Some {value: candidate} = move subtyped {
      let committed = run matchCallArgument(&resolver.*, module, operand.memberSpan, parameter, &candidate.ty, variables,
        &mut inferred.*, constraints, RejectionCode.TypeMismatch)
      if let Option<Shared<Rejection>>.None = move committed {
        if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&candidate.relations)) {
          failed = Option<Shared<Rejection>>.none()
        }
      }
    }
  }
  return move failed
}

// Whether an inherent call's receiver stands for an explicit argument: it borrows a receiver value
// that is not already a reference, as the explicit `&place` or `&mut place` argument would, or it
// takes the receiver by value, as the explicit moved or copied operand would.
fn explicitReceiver(choice: &InherentCallChoice, receiverType: &Shared<Type>) -> bool {
  if let InherentCallChoice.Selected {receiver, ..} = &choice.* {
    if let Option<ReceiverPosition>.Some {value} = &receiver {
      return value.mode == BodyReceiverPass.Take || !Shared<Type>.with<bool>(receiverType, referenceValue)
    }
  }
  return false
}

// The owner's type binders leading an open member signature: those its applied selection, which
// fixes the owner, no longer names. The member's own binders are the same in both.
effect fn ownerTypeCount(open: &Shared<Result<Answer, NoRejection>>, applied: &Shared<Result<Answer, NoRejection>>) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(open, signatureTypeParameterCount)
  let fixedCount = Shared<Result<Answer, NoRejection>>.with<usize>(applied, signatureTypeParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(open,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureTypeParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = &binder {
      let mut each = usize.ZERO
      while each < fixedCount {
        let kept = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(applied,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureTypeParameter(answer, each) })
        if let Option<Shared<Type>>.Some {value: other} = &kept {
          if run Type.equalsShared(&value, &other) { return at }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return count
}

// Whether an open member signature's receiver is `Self`: its referent is the enclosing inherent
// implementation's own applied owner, so the receiver's type supplies every owner binder. A
// receiver of a fixed instance (`&W<u8>` in `impl<T> W<T>`) does not.
effect fn selfReceiverOf(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  provider: &Shared<Type>, member: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, provider)
  if moduleOrdinal == usize.MAX { return false }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(member))
  let position = match move run ordinalOfIdentity(&mut resolver.*, &module, &identity) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let enclosing = match move run enclosingIdentity(&mut resolver.*, &module, position) {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return false }
  }
  if DeclarationId.kind(&enclosing) != OwnerKind.Implementation { return false }
  let implementation = run Shared<DeclarationId>.make(move enclosing)
  let parent = match move run ordinalOfIdentity(&mut resolver.*, &module, &implementation) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let headRequest = Key {family: Family.ImplementationHead,
    module: moduleOrdinal, name: usize.ZERO, declaration: parent, member: usize.ZERO, external: false}
  let headAccess = run internDeclaration(&mut resolver.*, headRequest)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, headAccess, Span.make(usize.ZERO, usize.ZERO))
  let head = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer, headOf) {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => { return false }
  }
  let owned = Shared<ImplementationHead>.with<Shared<Type>>(&head, fn(value: &ImplementationHead) -> Shared<Type> {
    return Shared<Type>.clone(&value.provider)
  })
  let receiver = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, usize.ZERO) }) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return false }
  }
  let referent = match move Shared<Type>.with<Option<Shared<Type>>>(&receiver, referenceReferent) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => move receiver
  }
  return run Type.equalsShared(&referent, &owned)
}

fn referenceReferent(value: &Type) -> Option<Shared<Type>> {
  return match &value.* { Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) _ => Option<Shared<Type>>.none() }
}

fn referenceValue(value: &Type) -> bool {
  return match &value.* { Type.Reference {..} => true _ => false }
}

// Adapts a checked receiver to its selected receiver parameter: a loan of the receiver's place,
// through a dereference when the receiver is a reference to it, or the transfer of a by-value place.
effect fn adaptReceiver<'scope>(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, nodes: &mut List<BodyNode>, constraints: &[Constraint], subject: HirId,
  span: Span, memberSpan: Span, receiverNode: BodyNodeId, receiverType: &Shared<Type>, provider: &Shared<Type>,
  mode: BodyReceiverPass, expectedReceiver: &Shared<Type>, bound: bool, openOwner: bool) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // An open owner's `Self` parameter still names its binders; a value taken for it is the applied
  // owner, which inference then meets with that parameter.
  let mut exactReceiver = run Type.equalsShared(receiverType, expectedReceiver)
  if openOwner && mode == BodyReceiverPass.Take { exactReceiver = run Type.equalsShared(receiverType, provider) }
  let borrowed = Shared<Type>.with<Option<ReferenceReceiver>>(
    receiverType,
    fn(value: &Type) -> Option<ReferenceReceiver> {
      return match & value.* {
        Type.Reference {referent: foundReferent, access, ..} => Option<ReferenceReceiver>.some(
          ReferenceReceiver {
            referent: Shared<Type>.clone(&foundReferent),
            mode: match access {
              Access.Shared => BodyReceiverPass.Shared
              Access.Mutable => BodyReceiverPass.Mutable
            },
          },
        )
        _ => Option<ReferenceReceiver>.none()
      }
    },
  )
  // A receiver holding a reference to the provider reaches its methods through the referent: a
  // reference place is reborrowed for the call under the declared access, and a by-value receiver
  // reads the referent, as the explicit `&mut counter` and `counter.*` spellings would (CALL-003).
  let mut throughReference = false
  let mut sameBorrow = false
  if let Option<ReferenceReceiver>.Some {value} = &borrowed {
    throughReference = run Type.equalsShared(&value.referent, provider)
    sameBorrow = throughReference && (value.mode == mode || mode == BodyReceiverPass.Shared && value.mode == BodyReceiverPass.Mutable)
  }
  let readsReferent = throughReference && mode == BodyReceiverPass.Take
  if !exactReceiver {
    let sameValue = run Type.equalsShared(receiverType, provider)
    let borrowsValue = match mode {
      BodyReceiverPass.Shared => true
      BodyReceiverPass.Mutable => true
      BodyReceiverPass.Take => false
    }
    if !(sameValue && borrowsValue) && !sameBorrow && !readsReferent {
      // An exclusive receiver through a shared reference would strengthen its reborrow, rejected as
      // the explicit `&mut counter` is (BORROW-005).
      if throughReference && mode == BodyReceiverPass.Mutable {
        let receiverSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[receiverNode.index].origin)
        return run bodyRejection(&resolver.*, module, RejectionCode.InvalidReborrow, receiverSpan)
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, memberSpan)
    }
  }
  // An exact reference receiver that names a place is reborrowed rather than passed by value; a
  // reference rvalue has no place to keep and passes through.
  let reborrowsExact = exactReceiver && throughReference && existingStorage(List<BodyNode>.asSlice(&nodes.*), receiverNode)
  let mut adaptedReceiver = receiverNode
  let mut valueNode = receiverNode
  let mut valueType = Shared<Type>.clone(receiverType)
  if readsReferent {
    valueNode = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(
      &mut nodes.*,
      BodyNode {
        origin: run originAt(cursor, subject, span),
        kind: BodyNodeKind.Expression {
          ty: Shared<Type>.clone(provider),
          form: BodyExpression.Dereference {value: receiverNode},
        },
      },
    )
    valueType = Shared<Type>.clone(provider)
    adaptedReceiver = valueNode
  }
  if (!exactReceiver || reborrowsExact) && mode != BodyReceiverPass.Take {
    let access = match mode {
      BodyReceiverPass.Shared => Access.Shared
      BodyReceiverPass.Mutable => Access.Mutable
      BodyReceiverPass.Take => Access.Shared
    }
    let mut receiverPlace = receiverNode
    if !run Type.equalsShared(receiverType, provider) {
      receiverPlace = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
      run List<BodyNode>.append(
        &mut nodes.*,
        BodyNode {
          origin: run originAt(cursor, subject, span),
          kind: BodyNodeKind.Expression {
            ty: Shared<Type>.clone(provider),
            form: BodyExpression.Dereference {value: receiverNode},
          },
        },
      )
    }
    // A receiver that names no existing storage is lent as an owned temporary (BORROW-006). A bound
    // method value would outlive that temporary, so it never borrows one (CALL-003).
    let temporary = !existingStorage(List<BodyNode>.asSlice(&nodes.*), receiverPlace)
    if temporary && bound {
      let receiverSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[receiverNode.index].origin)
      return run bodyRejection(&resolver.*, module, RejectionCode.TemporaryBoundReceiver, receiverSpan)
    }
    if access == Access.Mutable && !temporary && !mutablePlace(
      List<BodyNode>.asSlice(&nodes.*),
      List<BodyLocal>.asSlice(&statementScope.locals.*),
      receiverPlace,
    ) {
      return run bodyRejection(&resolver.*, module, RejectionCode.ExclusiveBorrowRequiresMutable, memberSpan)
    }
    // An open owner's receiver parameter still names its binders; the loan holds the receiver's
    // own type, which inference then meets with that parameter.
    let mut loanShape = Shared<Type>.clone(expectedReceiver)
    if openOwner {
      loanShape = run Types.intern(Type.Reference {referent: Shared<Type>.clone(provider), access: access,
        lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
    }
    let borrowedReceiver = run callerReferenceType(
      &loanShape,
      caller,
      subject, &run cursorAnchor(cursor), usize.MAX,
    )
    let borrowedReceiverType = match move borrowedReceiver {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
      }
    }
    adaptedReceiver = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(
      &mut nodes.*,
      BodyNode {
        origin: run originAt(cursor, subject, span),
        kind: BodyNodeKind.Expression {
          ty: move borrowedReceiverType,
          form: BodyExpression.Borrow {access: access, value: receiverPlace},
        },
      },
    )
  }
  // A by-value receiver transfers an affine place without a written `move`; a Copy receiver is
  // copied, and an owned rvalue receiver has no place to leave.
  if mode == BodyReceiverPass.Take {
    let written = match &List<BodyNode>.asSlice(&nodes.*)[valueNode.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Move {..}, ..} => true
      _ => false
    }
    let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &valueType, constraints, memberSpan) {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    if !written && !copied {
      let receiverSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[receiverNode.index].origin)
      let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, List<BodyNode>.asSlice(&nodes.*), valueNode, false, false, receiverSpan, receiverSpan, constraints) {
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      let owned = match &consumed {
        Option<BodyConsumedPlace>.Some {..} => true
        Option<BodyConsumedPlace>.None => false
      }
      if owned {
        adaptedReceiver = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, subject, span),
          kind: BodyNodeKind.Expression {
            ty: Shared<Type>.clone(&valueType),
            form: BodyExpression.Move {value: valueNode, consumed: move consumed},
          },
        })
      }
    }
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(adaptedReceiver)
}

// Receiver spelling evaluates the subject once, selects its owner name before interfaces, and
// only then checks supplied arguments. The selected signature determines any receiver loan.
effect fn checkReceiverCall<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  callee: HirId,
  subject: HirId,
  field: HirId,
  generics: HirRef,
  arguments: CallArguments,
  pipeline: bool,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let memberSpan = run bodySpan(&resolver.source, cursor, field)
  let memberSymbol = match run bodyNode(&resolver.source, cursor, field) {
    Node.Name {text} => text
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
    }
  }
  let member = run bodyText(&resolver.source, cursor, memberSymbol)
  let checkedReceiver = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    subject,
    &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let receiverNode = match move checkedReceiver {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let receiverType = match & List<BodyNode>.asSlice(&nodes.*)[receiverNode.index].kind {
    BodyNodeKind.Expression {ty, ..} => Shared<Type>.clone(&ty)
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let referent = Shared<Type>.with<Option<Shared<Type>>>(
    &receiverType,
    fn(value: &Type) -> Option<Shared<Type>> {
      return match & value.* {
        Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
        _ => Option<Shared<Type>>.none()
      }
    },
  )
  let provider = match move referent {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => Shared<Type>.clone(&receiverType)
  }
  let fieldSelection = run selectedRecordField(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, &provider, Bytes.asSlice(&member), memberSpan)
  match move fieldSelection {
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Success {value: Option<CheckedRecordMember>.Some {..}} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
      let calleeSpan = run bodySpan(&resolver.source, cursor, callee)
      let projected = run projectFieldValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut signatures.*, &mut requiredBodies.*, constraints,
        &mut nodes.*, callee, subject, field, calleeSpan, receiverNode, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, contractBody, staticBody,
        unsafeAllowed)
      let target = match move projected {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      return run invokeCallableValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, callee, target, generics, arguments, pipeline, expected, mismatchCode, constraints, contractBody,
        unsafeAllowed, callAcknowledged)
    }
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Success {value: Option<CheckedRecordMember>.None} => ()
  }
  if pipeline { return run bodyRejection(&resolver.*, module, RejectionCode.CallTargetUnavailable, span) }
  let inherent = run selectInherentReceiverCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &provider,
    Bytes.asSlice(&member),
    false,
    true,
    module,
    memberSpan,
  )
  let mut own = match move inherent {
    Result<InherentCallChoice, Shared<Rejection>>.Success {value} => move value
    Result<InherentCallChoice, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  // A receiver lent or taken for the call is the `&place` or by-value argument it stands for. As in
  // the unapplied `Owner.member(&place)` or `Owner.member(move value)`, the receiver supplies the
  // owner's binders by inference instead of fixing them, so a covariant owner's regions meet a later
  // operand's, as `NativeHttp.make().baseUrl(url)` needs for a runtime `url`. A written list still
  // binds only the member's own binders, which follow the owner's in the open signature. Only a
  // receiver that is `Self` supplies every owner binder; one of a fixed instance (`&W<u8>` in
  // `impl<T> W<T>`) keeps the applied owner, which no other argument may choose.
  let mut open = explicitReceiver(&own, &receiverType)
  let mut ownerTypes = usize.ZERO
  if open {
    // The open signature still names the owner's binders, so the receiver position comes from the
    // applied selection of the same member.
    let mut applied = Option<ReceiverPosition>.none()
    let mut appliedSignature = Option<Shared<Result<Answer, NoRejection>>>.none()
    if let InherentCallChoice.Selected {target, receiver} = &own {
      appliedSignature = Option<Shared<Result<Answer, NoRejection>>>.some(Shared<Result<Answer, NoRejection>>.clone(&target.signature))
      if let Option<ReceiverPosition>.Some {value} = &receiver {
        applied = Option<ReceiverPosition>.some(ReceiverPosition {ordinal: value.ordinal, mode: value.mode})
      }
    }
    let reopened = run selectInherentReceiverCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      true, &provider, Bytes.asSlice(&member), true, false, module, memberSpan)
    let mut reopenedTarget = Option<CallTarget>.none()
    match move reopened {
      Result<InherentCallChoice, Shared<Rejection>>.Success {value: InherentCallChoice.Selected {target, ..}} => {
        reopenedTarget = Option<CallTarget>.some(move target)
      }
      Result<InherentCallChoice, Shared<Rejection>>.Success {..} => ()
      Result<InherentCallChoice, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    open = false
    if let Option<CallTarget>.Some {value: target} = move reopenedTarget {
      let mut owned = usize.ZERO
      if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: fixed} = &appliedSignature {
        owned = run ownerTypeCount(&target.signature, &fixed)
      }
      if run selfReceiverOf(&mut resolver.*, &mut owner.*, &mut dependencies.*, &provider, &target.declaration, &target.signature) {
        open = true
        ownerTypes = owned
        own = InherentCallChoice.Selected {target: move target, receiver: move applied}
      }
    }
  }
  let mut maybeChoice = Option<ReceiverCallChoice>.none()
  match move own {
    InherentCallChoice.Selected {target, receiver} => match move receiver {
      Option<ReceiverPosition>.Some {value} => {
        maybeChoice = Option<ReceiverCallChoice>.some(
          ReceiverCallChoice.Inherent {target: move target, receiver: value},
        )
      }
      Option<ReceiverPosition>.None => {
        return run bodyRejection(
          &resolver.*,
          module,
          RejectionCode.AssociatedFunctionOnValue,
          memberSpan,
        )
      }
    }
    InherentCallChoice.Claimed => {
      // A claimed non-field owner name does not escape to conformance lookup.
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
    }
    InherentCallChoice.Missing => {
      let selected = run selectInterfaceReceiverCall(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &provider,
        Bytes.asSlice(&member),
        constraints,
        module,
        memberSpan,
      )
      match move selected {
        Result<ReceiverCallChoice, Shared<Rejection>>.Success {value} => {
          maybeChoice = Option<ReceiverCallChoice>.some(move value)
        }
        Result<ReceiverCallChoice, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
    }
  }
  let choice = match move maybeChoice {
    Option<ReceiverCallChoice>.Some {value} => move value
    Option<ReceiverCallChoice>.None => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run unknownOperationRejection(module, memberSpan, &provider, Bytes.asSlice(&member), true))
    }
  }
  let signature = match & choice {
    ReceiverCallChoice.Inherent {target, ..} => Shared<Result<Answer, NoRejection>>.clone(
      &target.signature,
    )
    ReceiverCallChoice.Interface {selected} => Shared<Result<Answer, NoRejection>>.clone(
      &selected.call.signature,
    )
  }
  let receiverPositionValue = match & choice {
    ReceiverCallChoice.Inherent {receiver, ..} => receiver
    ReceiverCallChoice.Interface {selected} => match & selected.call.receiver {
      Option<ReceiverPosition>.Some {value} => value
      Option<ReceiverPosition>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
      }
    }
  }
  if !staticBody && Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsStatic) {
    let mut operation = run Bytes.copy(b"`")
    run Bytes.append(&mut operation, Bytes.asSlice(&member))
    run Bytes.append(&mut operation, b"`")
    return run staticOperationAtRuntime(module, span, move operation)
  }
  // An interface operation's static arguments are selected once this check reports the call, as
  // an inherent method's are (`checkDeclarationCall`); a static body cannot supply them yet.
  let mut suppliedStatics = Option<Shared<List<StaticSlot>>>.none()
  if Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureStaticCount) > usize.ZERO {
    if let ReceiverCallChoice.Interface {..} = &choice {
      if staticBody { return Result<BodyNodeId, Shared<Rejection>>.failResult(run staticArgumentsGap(module, span, b"0")) }
      suppliedStatics = staticArgumentsFact(calls, expression)
      if let Option<Shared<List<StaticSlot>>>.None = &suppliedStatics {
        run discoverStaticCall(&mut resolver.*, &signature, expression, usize.ONE)
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run staticArgumentsGap(module, span, b"0"))
      }
    }
  }
  let parameterCount = Shared<Result<Answer, NoRejection>>.with<usize>(
    &signature,
    signatureParameterCount,
  )
  if receiverPositionValue.ordinal != usize.ZERO || parameterCount != CallArguments.length(arguments) + usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  // An interface operation's own type arguments are written after it (`provider.echo<i32>(...)`)
  // or inferred from its operands, as for the qualified spelling.
  let mut writtenOperation = List<Binding>.make()
  let mut writtenShapes = List<Binding>.make()
  if let ReceiverCallChoice.Interface {selected} = &choice {
    if generics.present {
      let contractModule = ModuleId.copy(DeclarationId.moduleId(&selected.call.operation))
      let written = run operationPrefixBindings(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
        &contractModule, &selected.call.operation, &signature, generics, constraints, span)
      let OperationPrefix {bindings, shapes} = match move written {
        Result<OperationPrefix, Shared<Rejection>>.Success {value} => move value
        Result<OperationPrefix, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      writtenOperation = move bindings
      writtenShapes = move shapes
    }
  }
  let operationTypes = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureNonLifetimeBinderCount) > usize.ZERO
  let unsafeCall = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureUnsafe)
  if unsafeCall && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if callAcknowledged && !unsafeCall {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span)
  }
  let callDeclaration = match & choice {
    ReceiverCallChoice.Inherent {target, ..} => DeclarationId.copy(&target.declaration)
    ReceiverCallChoice.Interface {selected} => DeclarationId.copy(&selected.call.operation)
  }
  let receiverParameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
    &signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return signatureParameter(answer, usize.ZERO)
    },
  )
  let expectedReceiver = match move receiverParameter {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let adapted = run adaptReceiver(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
    &mut statementScope.*, &mut nodes.*, constraints, subject, span, memberSpan, receiverNode, &receiverType, &provider,
    receiverPositionValue.mode, &expectedReceiver, false, open)
  let adaptedReceiver = match move adapted {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let receiverPass = receiverPositionValue.mode
  // An owner's own member is a call of its declaration whose receiver fixes the owner's binders, as
  // for the applied qualified spelling; a written list binds a prefix of the member's own.
  let selected = match move choice {
    ReceiverCallChoice.Inherent {target, ..} => {
      let mut declaration = move target
      let prefix = run writtenMemberPrefix(&resolver.*, module, cursor, caller, statementScope.annotations,
        &signature, &callDeclaration, generics, ownerTypes, span)
      let written = match move prefix {
        Result<CallPrefix, Shared<Rejection>>.Success {value} => move value
        Result<CallPrefix, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      declaration.explicit = move written.arguments
      declaration.explicitSlots = move written.slots
      declaration.prefixOwner = move written.owner
      declaration.prefixLifetimes = written.lifetimes
      declaration.explicitSyntax = generics.present
      let operand = Option<CallReceiver>.some(CallReceiver {node: adaptedReceiver, pass: receiverPass, subject: subject,
        memberSpan: memberSpan, bound: false, open: open})
      return run checkDeclarationCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
        move declaration, arguments, false, &operand, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed,
        callAcknowledged, false, &Option<NamedCallableEvidence>.none())
    }
    ReceiverCallChoice.Interface {selected} => move selected
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(
    &mut variables,
    run Shared<DeclarationId>.make(DeclarationId.copy(&callDeclaration)),
  )
  let mut inferred = move writtenOperation
  let none = List<usize>.make()
  let operand = CallReceiver {node: adaptedReceiver, pass: receiverPass, subject: subject, memberSpan: memberSpan, bound: false,
    open: false}
  let receiverFailure = run matchReceiverOperand(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    List<BodyNode>.asSlice(&nodes.*), &operand, &expectedReceiver, &callDeclaration, caller, List<Shared<DeclarationId>>.asSlice(&variables),
    List<usize>.asSlice(&none), &mut inferred, constraints)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move receiverFailure {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move diagnostic)
  }
  let mut typedArguments = List<BodyNodeId>.make()
  run List<BodyNodeId>.append(&mut typedArguments, adaptedReceiver)
  let mut statics = List<StaticSlot>.make()
  let mut at = usize.ZERO
  while at < CallArguments.length(arguments) {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at + usize.ONE)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    if let Option<Shared<List<StaticSlot>>>.Some {value: slots} = &suppliedStatics {
      let selected = Shared<List<StaticSlot>>.with<Option<Shared<StaticData>>>(&slots,
        fn(listed: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(listed, at + usize.ONE) })
      if let Option<Shared<StaticData>>.Some {value} = move selected {
        let argumentSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, at))
        let refused = run interfaceStaticOperand(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &parameterType,
          List<Binding>.asSlice(&inferred), &value, argumentSpan)
        if let Option<Shared<Rejection>>.Some {value: reason} = move refused { return Result<BodyNodeId, Shared<Rejection>>.failResult(move reason) }
        run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: at + usize.ONE, value: move value})
        at = at + usize.ONE
        continue
      }
    }
    let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
    let context = run operationOperandContext(&resolver.source, cursor, argumentId, &parameterType,
      &callDeclaration, caller, List<Binding>.asSlice(&inferred), operationTypes)
    let checked = run checkExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      caller,
      &mut statementScope.*,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      argumentId,
      &context, RejectionCode.TypeMismatch,
      constraints,
      contractBody,
      false,
      unsafeAllowed,
    )
    let argumentNode = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    // As at a direct call, a fresh loan takes the caller's call region, so operands that share an
    // operation lifetime infer one region; a slice reborrow keeps its source region.
    let argumentSyntax = run originSyntax(cursor, List<BodyNode>.asSlice(&nodes.*)[argumentNode.index].origin)
    let sliceParameter = match move Type.sliceElement(&parameterType) { Option<Shared<Type>>.Some {..} => true _ => false }
    if !sliceParameter {
      if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, argumentSyntax) {
        let rejected = run contributeBorrowCallRegion(&mut resolver.*, module, &mut nodes.*, caller, argumentNode, expression, span, &run cursorAnchor(cursor),
          parameterBinder(&parameterType, &callDeclaration))
        if let Option<Shared<Rejection>>.Some {value} = move rejected {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
        }
      }
    }
    let slicedArgument = run sliceArgument(&mut nodes.*, argumentNode, &parameterType)
    let adaptedArgument = run unionArgument(&mut nodes.*, slicedArgument, &parameterType)
    let argumentType = match & List<BodyNode>.asSlice(&nodes.*)[adaptedArgument.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared<Type>.clone(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let failed = run matchCallArgument(
      &resolver.*,
      module,
      span,
      &parameterType,
      &argumentType,
      List<Shared<DeclarationId>>.asSlice(&variables),
      &mut inferred, constraints, RejectionCode.TypeMismatch)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move diagnostic)
    }
    run List<BodyNodeId>.append(&mut typedArguments, adaptedArgument)
    at = at + usize.ONE
  }
  let OperationCall {
    operation,
    implementation,
    signature: unusedSignature,
    proof,
    receiver: unusedReceiver,
  } = move selected.call
  drop unusedSignature
  drop unusedReceiver
  drop proof
  return run finishInterfaceCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*,
    &mut signatures.*, expression, span, move selected.contract, move provider, move operation, move implementation,
    &signature, move typedArguments, move inferred, move writtenShapes, Option<BodyReceiverPass>.some(receiverPass), expected,
    mismatchCode, constraints, contractBody, staticBody, move statics)
}

// The enclosing declaration owns expression-local regions independently of demanded signatures.
struct RecordMemberSelection {
  index: usize,
  count: usize,
  isPublic: bool,
}

impl Copy for RecordMemberSelection {}

struct CheckedRecordMember {
  index: usize,
  count: usize,
  ty: Shared<Type>,
}

// Field identity and visibility come from the same cached member list used by type queries.
fn selectRecordMember(answer: &Result<Answer, NoRejection>, name: &[u8]) -> Option<RecordMemberSelection> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let fields = List<Member>.asSlice(&members)
      let mut at = usize.ZERO
      while at < fields.length {
        if fields[at].kind == MemberKind.Field {
          if let Option<Bytes>.Some {value: written} = &fields[at].name {
            if same(Bytes.asSlice(&written), name) {
              return Option<RecordMemberSelection>.some(RecordMemberSelection {
                index: at, count: fields.length, isPublic: fields[at].isPublic,
              })
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<RecordMemberSelection>.none()
}

enum FieldLookupPurpose {
  NamedFields,
  Projection,
}

effect fn checkedRecordMember(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId,
  ty: &Shared<Type>, name: &[u8], span: Span, purpose: FieldLookupPurpose,
) -> Result<CheckedRecordMember, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run selectedRecordField(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, ty, name, span)
  match move selected {
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Success {value: Option<CheckedRecordMember>.Some {value}} => {
      return Result<CheckedRecordMember, Shared<Rejection>>.succeed(move value)
    }
    Result<Option<CheckedRecordMember>, Shared<Rejection>>.Failure {error} => {
      return Result<CheckedRecordMember, Shared<Rejection>>.failResult(move error)
    }
    _ => ()
  }
  let anonymous = match move run Type.anonymousParts(ty) { Option<AnonymousParts>.Some {..} => true _ => false }
  let sealedRecord = Shared<Type>.with<bool>(ty, CheckedIntrinsic.isTestInfo)
  let mut code = RejectionCode.UnknownStructField
  if purpose == FieldLookupPurpose.Projection { code = RejectionCode.UnknownProjectedField }
  if !anonymous && !sealedRecord && declaringModuleOrdinal(&resolver.*, ty) == usize.MAX {
    code = RejectionCode.NotType
    if purpose == FieldLookupPurpose.Projection { code = RejectionCode.ProjectionOnNonStruct }
  }
  let mut diagnostic = run makeRejection(code, module, span)
  // A string's length and other facts come from the `silk.string` functions.
  if code == RejectionCode.ProjectionOnNonStruct && Shared<Type>.with<bool>(ty, stringType) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  }
  if code == RejectionCode.UnknownStructField || code == RejectionCode.UnknownProjectedField {
    if let Option<Bytes>.Some {value: typeText} = move run TypeText.display(ty, module) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move typeText})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"field"), value: run Bytes.copy(name)})
    }
  }
  return Result<CheckedRecordMember, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
}

// SEM0172 naming the tuple and both element counts.
effect fn tupleArityRejection(module: &ModuleId, span: Span, ty: &Shared<Type>, expected: usize, actual: usize) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.TupleArityMismatch, module, span)
  if let Option<Bytes>.Some {value: typeText} = move run TypeText.display(ty, module) {
    run vectorArgument(&mut diagnostic, b"type", Bytes.asSlice(&typeText))
    let wanted = run decimalText(expected)
    run vectorArgument(&mut diagnostic, b"expected", Bytes.asSlice(&wanted))
    let given = run decimalText(actual)
    run vectorArgument(&mut diagnostic, b"actual", Bytes.asSlice(&given))
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// SEM0027 for a field other than `length` on a slice or array, as `bytes.len` is written elsewhere.
effect fn lengthFieldRejection(module: &ModuleId, span: Span, ty: &Shared<Type>, name: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.UnknownProjectedField, module, span)
  let mut shown = run TypeText.display(ty, module)
  if let Option<Bytes>.None = &shown { shown = run TypeText.displayElided(ty, module) }
  if let Option<Bytes>.Some {value: typeText} = move shown {
    run vectorArgument(&mut diagnostic, b"template", b"1")
    run vectorArgument(&mut diagnostic, b"type", Bytes.asSlice(&typeText))
    run vectorArgument(&mut diagnostic, b"field", name)
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// SEM0027 for a tuple element `.written` past the tuple's `count` elements.
effect fn tupleElementRejection(module: &ModuleId, span: Span, ty: &Shared<Type>, written: &[u8], count: usize) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.UnknownProjectedField, module, span)
  if let Option<Bytes>.Some {value: typeText} = move run TypeText.display(ty, module) {
    if written.length != usize.ZERO {
      let mut field = run Bytes.copy(b".")
      run Bytes.append(&mut field, written)
      let mut positions = Bytes.make()
      let mut at = usize.ZERO
      while at < count {
        if at > usize.ZERO {
          if at + usize.ONE == count { run Bytes.append(&mut positions, b" and ") } else { run Bytes.append(&mut positions, b", ") }
        }
        run Bytes.append(&mut positions, b"`.")
        run appendDecimal(&mut positions, at)
        run Bytes.append(&mut positions, b"`")
        at = at + usize.ONE
      }
      let mut elements = run decimalText(count)
      if count == usize.ONE { run Bytes.append(&mut elements, b" element") } else { run Bytes.append(&mut elements, b" elements") }
      run vectorArgument(&mut diagnostic, b"template", b"2")
      run vectorArgument(&mut diagnostic, b"type", Bytes.asSlice(&typeText))
      run vectorArgument(&mut diagnostic, b"field", Bytes.asSlice(&field))
      run vectorArgument(&mut diagnostic, b"count", Bytes.asSlice(&elements))
      run vectorArgument(&mut diagnostic, b"positions", Bytes.asSlice(&positions))
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Absence permits method lookup; a claimed field keeps every visibility and type rejection.
// The accessor the module `declaring` offers for the private `field` of its type `typeName`: a
// public inherent function named like the field whose first parameter is `&typeName`, as
// `SystemClock.seconds(self: &Instant)` is, spelled `SystemClock.seconds`. The hint reads the
// whole module, so an edit there refreshes it.
effect fn fieldAccessor(resolver: &mut Resolver, declaring: &ModuleId, typeName: &[u8], field: &[u8]) -> Option<Bytes>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if typeName.length == usize.ZERO { return Option<Bytes>.none() }
  let answer = run source(&mut resolver.*, declaring)
  let mut found = Option<Bytes>.none()
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, declaring) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if let Node.FunctionHeader {name, isPublic, contract, ..} = Module.node(hir, declarations[at].header) {
        if isPublic && nameNodeIs(hir, name, field) && firstParameterBorrows(hir, contract, typeName) {
          if let Option<usize>.Some {value: parent} = &declarations[at].parent {
            if let Node.ImplHeader {subject, target, ..} = Module.node(hir, declarations[parent].header) {
              if !target.present {
                if let Option<Bytes>.Some {value: ownerName} = move run namedTypeText(hir, subject) {
                  let mut call = move ownerName
                  run Bytes.append(&mut call, b".")
                  run Bytes.append(&mut call, field)
                  found = Option<Bytes>.some(move call)
                  at = declarations.length
                }
              }
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  drop answer
  return move found
}

fn nameNodeIs(hir: &Module, node: HirId, name: &[u8]) -> bool {
  if let Node.Name {text} = Module.node(hir, node) { return same(Module.text(hir, text), name) }
  return false
}

// The last segment of the plain named type `node`, as in `SystemClock`; none for any other type.
effect fn namedTypeText(hir: &Module, node: HirId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if let Node.NamedType {path, ..} = Module.node(hir, node) {
    if let Node.Path {segments} = Module.node(hir, path) {
      if segments.length > usize.ZERO {
        if let Node.Name {text} = Module.node(hir, Module.child(hir, segments, segments.length - usize.ONE)) {
          return Option<Bytes>.some(run Bytes.copy(Module.text(hir, text)))
        }
      }
    }
  }
  return Option<Bytes>.none()
}

// Whether the callable `contract`'s first parameter is a shared borrow of the type named `typeName`.
fn firstParameterBorrows(hir: &Module, contract: HirId, typeName: &[u8]) -> bool {
  if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
    if parameters.length == usize.ZERO { return false }
    if let Node.Parameter {annotation, ..} = Module.node(hir, Module.child(hir, parameters, usize.ZERO)) {
      if let Node.ReferenceType {referent, access, ..} = Module.node(hir, annotation) {
        if access != Access.Shared { return false }
        if let Node.NamedType {path, ..} = Module.node(hir, referent) {
          if let Node.Path {segments} = Module.node(hir, path) {
            if segments.length > usize.ZERO {
              return nameNodeIs(hir, Module.child(hir, segments, segments.length - usize.ONE), typeName)
            }
          }
        }
      }
    }
  }
  return false
}

effect fn selectedRecordField(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId,
  ty: &Shared<Type>, name: &[u8], span: Span,
) -> Result<Option<CheckedRecordMember>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // `Intrinsic.TestInfo` is a compiler record of public program-lifetime text.
  if Shared<Type>.with<bool>(ty, CheckedIntrinsic.isTestInfo) {
    let mut index = usize.ZERO
    while index < CheckedIntrinsic.testInfoFieldCount() {
      if same(CheckedIntrinsic.testInfoFieldName(index), name) {
        let fieldType = run Types.intern(Type.String {lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
        return Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(Option<CheckedRecordMember>.some(
          CheckedRecordMember {index: index, count: CheckedIntrinsic.testInfoFieldCount(), ty: move fieldType}))
      }
      index = index + usize.ONE
    }
    return Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(Option<CheckedRecordMember>.none())
  }
  let anonymous = run Type.anonymousParts(ty)
  if let Option<AnonymousParts>.Some {value: parts} = move anonymous {
    let index = AnonymousOccurrence.labelIndex(&parts.occurrence, name)
    let members = List<Shared<Type>>.asSlice(&parts.members)
    if index >= members.length {
      return Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(Option<CheckedRecordMember>.none())
    }
    return Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(
      Option<CheckedRecordMember>.some(CheckedRecordMember {index: index, count: members.length, ty: Shared<Type>.clone(&members[index])}),
    )
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX {
    return Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(Option<CheckedRecordMember>.none())
  }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(Option<CheckedRecordMember>.none()) }
  }
  let declarationAccess115Request = Key {
    family: Family.Members, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess115 = run internDeclaration(&mut resolver.*, declarationAccess115Request)
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess115, span)
  let rejectedNames = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&names, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejectedNames {
    return Result<Option<CheckedRecordMember>, Shared<Rejection>>.failResult(move value)
  }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<RecordMemberSelection>>(&names,
    fn(answer: &Result<Answer, NoRejection>) -> Option<RecordMemberSelection> {
      return selectRecordMember(answer, name)
    },
  )
  let field = match move selected {
    Option<RecordMemberSelection>.Some {value} => value
    Option<RecordMemberSelection>.None => { return Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(Option<CheckedRecordMember>.none()) }
  }
  if !field.isPublic && !ModuleId.equals(module, &declaredModule) {
    let mut diagnostic = run makeRejection(RejectionCode.InaccessibleProjectedField, module, span)
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"field"), value: run Bytes.copy(name)})
    if let Option<Bytes>.Some {value: text} = move run TypeText.display(ty, module) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move text})
      // Another package's field cannot be made `pub` from here: point at the declaring module's
      // own accessor when it has one, and otherwise only say the field is private.
      let mut choice: &'static [u8] = b"0"
      let typeName = match move Shared<Type>.with<Option<DeclarationId>>(ty, nominalOf) {
        Option<DeclarationId>.Some {value: id} => run DeclarationId.copySpelling(&id)
        Option<DeclarationId>.None => Bytes.make()
      }
      let accessor = run fieldAccessor(&mut resolver.*, &declaredModule, Bytes.asSlice(&typeName), name)
      if let Option<Bytes>.Some {value: call} = move accessor {
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"accessor"), value: move call})
        choice = b"1"
      } else if !ModuleId.samePackage(module, &declaredModule) {
        choice = b"2"
      }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
    }
    return Result<Option<CheckedRecordMember>, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
  }
  let application = run internApplication(&mut resolver.*, ty)
  let declarationAccess116Request = Key {
    family: Family.MemberShape, module: moduleOrdinal, name: application,
    declaration: declaration, member: field.index, external: false,
  }
  let declarationAccess116 = run internDeclaration(&mut resolver.*, declarationAccess116Request)
  let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess116, span)
  let rejectedShape = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shaped, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejectedShape {
    return Result<Option<CheckedRecordMember>, Shared<Rejection>>.failResult(move value)
  }
  let fieldType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped, singleMemberType)
  return match move fieldType {
    Option<Shared<Type>>.Some {value} => Result<Option<CheckedRecordMember>, Shared<Rejection>>.succeed(
      Option<CheckedRecordMember>.some(CheckedRecordMember {index: field.index, count: field.count, ty: move value}),
    )
    Option<Shared<Type>>.None => Result<Option<CheckedRecordMember>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    )
  }
}

// Resolve a constructor's written annotation in the actual enclosing declaration's binder scope.
effect fn recordFieldCount(resolver: &mut Resolver, module: &ModuleId, ty: &Shared<Type>, span: Span)
-> Result<usize, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX {
    return Result<usize, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotType, span))
  }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  if let Option<usize>.Some {value: declaration} = move ordinal {
    let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
    if let Option<HeaderSyntax>.Some {value: syntax} = move written {
      if let Node.StructHeader {fields, ..} = syntax.header {
        return Result<usize, Shared<Rejection>>.succeed(fields.length)
      }
    }
  }
  return Result<usize, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotType, span))
}

// The declared field names of the struct `ty` names, in declaration order; empty when its
// declaration cannot be read.
effect fn recordFieldNames(resolver: &mut Resolver, ty: &Shared<Type>) -> List<Bytes> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return move names }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  if let Option<usize>.Some {value: declaration} = move ordinal {
    let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
    if let Option<HeaderSyntax>.Some {value: syntax} = move written {
      if let Node.StructHeader {fields, ..} = syntax.header {
        let sourceAnswer = run observedDeclaration(&mut resolver.*, &declaredModule, declaration, SourceFacet.Members)
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, &declaredModule) {
          let hir = IndexedSource.authored(indexed)
          let mut at = usize.ZERO
          while at < fields.length {
            if let Node.Field {name, ..} = Module.node(hir, Module.child(hir, fields, at)) {
              if let Node.Name {text} = Module.node(hir, name) {
                run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text)))
              }
            }
            at = at + usize.ONE
          }
        }
      }
    }
  }
  return move names
}

// A struct or variant literal that omits declared fields (SEM0024), naming the fields `present`
// leaves out: "`P { ... }` omits fields `y` and `z`". The report spells the type as written.
effect fn missingFieldsRejection(module: &ModuleId, span: Span, names: &[Bytes], present: &[BodyAggregateField])
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.MissingStructInitializer, module, span)
  let mut omitted = List<usize>.make()
  let mut index = usize.ZERO
  while index < names.length {
    let mut given = false
    let mut at = usize.ZERO
    while at < present.length {
      if present[at].index == index { given = true }
      at = at + usize.ONE
    }
    if !given { run List<usize>.append(&mut omitted, index) }
    index = index + usize.ONE
  }
  let missing = List<usize>.asSlice(&omitted)
  if missing.length == usize.ZERO { return run Shared<Rejection>.make(move diagnostic) }
  let mut text = Bytes.make()
  if missing.length == usize.ONE { run Bytes.append(&mut text, b"field ") } else { run Bytes.append(&mut text, b"fields ") }
  let mut at = usize.ZERO
  while at < missing.length {
    if at > usize.ZERO {
      if at + usize.ONE == missing.length { run Bytes.append(&mut text, b" and ") } else { run Bytes.append(&mut text, b", ") }
    }
    run Bytes.append(&mut text, b"`")
    run Bytes.append(&mut text, Bytes.asSlice(&names[missing[at]]))
    run Bytes.append(&mut text, b"`")
    at = at + usize.ONE
  }
  diagnostic.arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"missing"), value: move text})
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether `module` may name every field of a struct declaration: all fields are public, or the
// struct is declared in `module`.
effect fn recordFieldsVisible(resolver: &mut Resolver, module: &ModuleId, ty: &Shared<Type>) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return true }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  if ModuleId.equals(module, &declaredModule) { return true }
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  if let Option<usize>.Some {value: declaration} = move ordinal {
    let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
    if let Option<HeaderSyntax>.Some {value: syntax} = move written {
      if let Node.StructHeader {fields, ..} = syntax.header {
        let sourceAnswer = run observedDeclaration(&mut resolver.*, &declaredModule, declaration, SourceFacet.Members)
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, &declaredModule) {
          let hir = IndexedSource.authored(indexed)
          let mut at = usize.ZERO
          while at < fields.length {
            if let Node.Field {isPublic, ..} = Module.node(hir, Module.child(hir, fields, at)) {
              if !isPublic { return false }
            }
            at = at + usize.ONE
          }
        }
      }
    }
  }
  return true
}

// Deferred generic union representation is reported only after ordinary ownership and member validation.
effect fn deferredUnionVariant(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId,
  namespace: &[u8], member: &[u8], span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let candidateSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let candidate = match move candidateSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Option<Shared<Rejection>>.some(move error)
    }
  }
  if candidate.count != usize.ONE || (candidate.kind != CandidateKind.Declaration && candidate.kind != CandidateKind.ImportMember) {
    return Option<Shared<Rejection>>.none()
  }
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, namespace, false, span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Option<Shared<Rejection>>.none()
    }
  }
  let declaredModule = resolvedModule(&resolver.*, declaration.module)
  let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut relevant = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {generics, ..} = value.header { relevant = generics.length > usize.ZERO }
  }
  if !relevant { return Option<Shared<Rejection>>.none() }
  let declarationAccess117Request = Key {
    family: Family.Members, module: declaration.module, name: usize.ZERO,
    declaration: declaration.ordinal, member: usize.ZERO, external: false,
  }
  let declarationAccess117 = run internDeclaration(&mut resolver.*, declarationAccess117Request)
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess117, span)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&names, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Option<Shared<Rejection>>.some(move value)
  }
  let visibility = Shared<Result<Answer, NoRejection>>.with<Option<bool>>(&names,
    fn(answer: &Result<Answer, NoRejection>) -> Option<bool> {
      if let Result<Answer, NoRejection>.Success {value} = &answer.* {
        if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
          let values = List<Member>.asSlice(&members)
          let mut at = usize.ZERO
          while at < values.length {
            if let Option<Bytes>.Some {value: name} = &values[at].name {
              if same(Bytes.asSlice(&name), member) { return Option<bool>.some(values[at].isPublic) }
            }
            at = at + usize.ONE
          }
        }
      }
      return Option<bool>.none()
    },
  )
  if let Option<bool>.Some {value: isPublic} = move visibility {
    if !isPublic && !ModuleId.equals(module, &declaredModule) {
      return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.PrivateMember, span))
    }
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnionFormUnavailable, span))
  }
  return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnknownUnionVariant, span))
}

// A scalar enum's nominal type and its validated Members answer, which owns every discriminant.
struct SelectedScalarEnum {
  ty: Shared<Type>,
  members: Shared<Result<Answer, NoRejection>>,
  module: usize,
}

struct ScalarEnumMember {
  value: BodyEnumMember,
  isPublic: bool,
}

// A qualified scalar enum use: one member value, or the representation operation `Enum.value`.
union EnumSelection {
  Member {ty: Shared<Type>, member: BodyEnumMember},
  Value {ty: Shared<Type>, representation: Shared<Type>},
}

fn scalarEnumMember(answer: &Result<Answer, NoRejection>, name: &[u8]) -> Option<ScalarEnumMember> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, enumRepresentation, ..}} = &value.outcome {
      let values = List<Member>.asSlice(&members)
      let mut at = usize.ZERO
      while at < values.length {
        if let Option<Bytes>.Some {value: written} = &values[at].name {
          if same(Bytes.asSlice(&written), name) {
            if let Option<EnumCase>.Some {value: discriminant} = &values[at].discriminant {
              return Option<ScalarEnumMember>.some(ScalarEnumMember {
                value: BodyEnumMember {
                  ordinal: at, negative: discriminant.sign == StaticSign.Negative, magnitude: discriminant.magnitude,
                  representation: enumRepresentation,
                },
                isPublic: values[at].isPublic,
              })
            }
            return Option<ScalarEnumMember>.none()
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<ScalarEnumMember>.none()
}

fn scalarEnumCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      return List<Member>.length(&members)
    }
  }
  return usize.ZERO
}

fn scalarEnumRepresentation(answer: &Result<Answer, NoRejection>) -> Option<StaticIntegerType> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {enumRepresentation, ..}} = &value.outcome {
      return Option<StaticIntegerType>.some(enumRepresentation)
    }
  }
  return Option<StaticIntegerType>.none()
}

effect fn scalarEnumMembers(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, declaredModule: usize, declaration: usize, span: Span,
) -> Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declarationAccess118Request = Key {
    family: Family.Members, module: declaredModule, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess118 = run internDeclaration(&mut resolver.*, declarationAccess118Request)
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess118, span)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&names, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(move value)
  }
  return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.succeed(move names)
}

// Select a scalar enum written as a namespace; absence means the name is not one.
effect fn selectScalarEnum(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, namespace: &[u8], span: Span,
) -> Option<Result<SelectedScalarEnum, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let candidateSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let candidate = match move candidateSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Option<Result<SelectedScalarEnum, Shared<Rejection>>>.some(Result<SelectedScalarEnum, Shared<Rejection>>.failResult(move error))
    }
  }
  if candidate.count != usize.ONE || (candidate.kind != CandidateKind.Declaration && candidate.kind != CandidateKind.ImportMember) {
    return Option<Result<SelectedScalarEnum, Shared<Rejection>>>.none()
  }
  // A transparent alias qualifier names its target enum (TYPE-004).
  let selected = run qualifierDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, namespace, span)
  let declaration = match move selected {
    Result<QualifierDeclaration, Shared<Rejection>>.Success {value} => move value.selected
    Result<QualifierDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Option<Result<SelectedScalarEnum, Shared<Rejection>>>.none()
    }
  }
  let declaredModule = resolvedModule(&resolver.*, declaration.module)
  let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut relevant = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.EnumHeader {..} = value.header { relevant = true }
  }
  if !relevant { return Option<Result<SelectedScalarEnum, Shared<Rejection>>>.none() }
  let demanded = run scalarEnumMembers(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    declaration.module, declaration.ordinal, span)
  let members = match move demanded {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
      return Option<Result<SelectedScalarEnum, Shared<Rejection>>>.some(
        Result<SelectedScalarEnum, Shared<Rejection>>.failResult(move error))
    }
  }
  let declarationAccess119Request = Key {
    family: Family.Identity, module: declaration.module, name: usize.ZERO,
    declaration: declaration.ordinal, member: usize.ZERO, external: false,
  }
  let declarationAccess119 = run internDeclaration(&mut resolver.*, declarationAccess119Request)
  let identity = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess119, span)
  let selectedType = run typeFromAnswer(&identity)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selectedType.rejected {
    return Option<Result<SelectedScalarEnum, Shared<Rejection>>>.some(
      Result<SelectedScalarEnum, Shared<Rejection>>.failResult(move diagnostic))
  }
  return match move selectedType.resolved {
    Option<Shared<Type>>.Some {value: ty} => Option<Result<SelectedScalarEnum, Shared<Rejection>>>.some(
      Result<SelectedScalarEnum, Shared<Rejection>>.succeed(
        SelectedScalarEnum {ty: move ty, members: move members, module: declaration.module},
      ),
    )
    Option<Shared<Type>>.None => Option<Result<SelectedScalarEnum, Shared<Rejection>>>.none()
  }
}

// The checked subject's own declaration supplies the members; absence means it is not a scalar enum.
effect fn subjectScalarEnum(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Shared<Type>, span: Span,
) -> Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.none() }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.none() }
  }
  let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
  let mut relevant = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.EnumHeader {..} = value.header { relevant = true }
  }
  if !relevant { return Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.none() }
  return Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.some(
    run scalarEnumMembers(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, declaration, span))
}

// Member visibility is checked before selection; `value` names the representation operation.
effect fn checkedEnumSelection(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId,
  namespace: &[u8], member: &[u8], span: Span, invocation: bool,
) -> Option<Result<EnumSelection, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run selectScalarEnum(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, span)
  let chosen = match move selected {
    Option<Result<SelectedScalarEnum, Shared<Rejection>>>.Some {value: found} => match move found {
      Result<SelectedScalarEnum, Shared<Rejection>>.Success {value} => move value
      Result<SelectedScalarEnum, Shared<Rejection>>.Failure {error} => {
        return Option<Result<EnumSelection, Shared<Rejection>>>.some(Result<EnumSelection, Shared<Rejection>>.failResult(move error))
      }
    }
    Option<Result<SelectedScalarEnum, Shared<Rejection>>>.None => { return Option<Result<EnumSelection, Shared<Rejection>>>.none() }
  }
  let found = Shared<Result<Answer, NoRejection>>.with<Option<ScalarEnumMember>>(&chosen.members,
    fn(answer: &Result<Answer, NoRejection>) -> Option<ScalarEnumMember> { return scalarEnumMember(answer, member) })
  let mut code = RejectionCode.UnknownEnumMember
  if invocation { code = RejectionCode.NotCallable }
  if let Option<ScalarEnumMember>.Some {value} = move found {
    let declaredModule = resolvedModule(&resolver.*, chosen.module)
    if invocation {
      code = RejectionCode.NotCallable
    } else if !value.isPublic && !ModuleId.equals(module, &declaredModule) {
      code = RejectionCode.PrivateMember
    } else {
      return Option<Result<EnumSelection, Shared<Rejection>>>.some(Result<EnumSelection, Shared<Rejection>>.succeed(
        EnumSelection.Member {ty: move chosen.ty, member: value.value},
      ))
    }
  } else if invocation && same(member, b"value") {
    let representation = Shared<Result<Answer, NoRejection>>.with<Option<StaticIntegerType>>(&chosen.members, scalarEnumRepresentation)
    if let Option<StaticIntegerType>.Some {value: integer} = move representation {
      return Option<Result<EnumSelection, Shared<Rejection>>>.some(Result<EnumSelection, Shared<Rejection>>.succeed(
        EnumSelection.Value {ty: move chosen.ty, representation: run primitiveType(StaticConstant.integerName(integer))},
      ))
    }
    code = RejectionCode.Unsupported
  } else if invocation {
    // Any other invoked name is not an enum selection: ordinary qualified resolution owns the
    // enum's inherent members, as it does for every other nominal namespace.
    return Option<Result<EnumSelection, Shared<Rejection>>>.none()
  }
  let mut diagnostic = run makeRejection(code, module, span)
  if code == RejectionCode.UnknownEnumMember {
    run vectorArgument(&mut diagnostic, b"enumName", namespace)
    run vectorArgument(&mut diagnostic, b"member", member)
  }
  return Option<Result<EnumSelection, Shared<Rejection>>>.some(
    Result<EnumSelection, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic)))
}

effect fn deferredRecordAnnotation(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, annotation: HirId, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run typeNode(&mut resolver.*, module, annotation)
  if let Option<HeaderSyntax>.Some {value: annotationSyntax} = move written {
    if let Node.NamedType {path: named, hasMode, ..} = annotationSyntax.header {
      if hasMode { return Option<Shared<Rejection>>.none() }
      let parsed = run path(&mut resolver.*, module, named)
      let segments = List<Bytes>.asSlice(&parsed.segments)
      if parsed.valid && segments.length == 2 {
        return run deferredUnionVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, Bytes.asSlice(&segments[usize.ZERO]), Bytes.asSlice(&segments[usize.ONE]), span)
      }
    }
  }
  return Option<Shared<Rejection>>.none()
}

// A bare generic nominal literal owns one open application while its fields are checked.
// Only the completed application is published to MIR, layout and instance interning.
struct InferredAggregateTarget {
  ty: Shared<Type>,
  // The producer's source shape supplies nested literal context without fixing opaque slots.
  construction: Option<Shared<Type>>,
  owner: Shared<DeclarationId>,
  module: usize,
  declaration: usize,
  generics: Range,
  binders: List<Binder>,
  isPublic: bool,
  // The lifetimes the source wrote in the type's arguments, which are the annotation's rather than
  // inferred.
  written: List<Shared<Lifetime>>,
}

effect fn inferredAggregateDeclaration(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, declaration: &SelectedDeclaration,
  generics: Range, isPublic: bool, span: Span,
) -> Result<Option<InferredAggregateTarget>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declaredModule = resolvedModule(&resolver.*, declaration.module)
  let template = run templateBinders(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut binders = match move template {
    Result<List<Binder>, Shared<Rejection>>.Success {value: resolvedBinders} => move resolvedBinders
    Result<List<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move error)
    }
  }
  let incomplete = run completeApplicationBinders(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declaration.module,
    &declaredModule,
    declaration.ordinal,
    span,
    &mut binders,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move incomplete {
    return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move diagnostic)
  }
  if List<Binder>.length(&binders) > usize.ZERO {
    let identity = run declarationAt(&mut resolver.*, &declaredModule, declaration.ordinal)
    if let Option<DeclarationId>.Some {value: id} = move identity {
      let ownerId = run Shared<DeclarationId>.make(DeclarationId.copy(&id))
      let generated = List<Shared<Lifetime>>.make()
      let arguments = run ownedArguments(
        &id,
        List<Binder>.asSlice(&binders),
        List<Shared<Lifetime>>.asSlice(&generated),
      )
      let ty = run Types.intern(Type.Nominal {
        declaration: move id,
        isPublic: isPublic,
        arguments: move arguments,
      })
      return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(
        Option<InferredAggregateTarget>.some(InferredAggregateTarget {
          ty: move ty,
          construction: Option<Shared<Type>>.none(),
          owner: move ownerId,
          module: declaration.module,
          declaration: declaration.ordinal,
          generics: generics,
          binders: move binders,
          isPublic: isPublic,
          written: List<Shared<Lifetime>>.make(),
        }),
      )
    }
  }
  return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none())
}

// Only this producer's opaque arguments are construction holes. Other arguments, including
// authored caller parameters, lifetimes and foreign opaque families, remain fixed evidence.
effect fn inferredContextualAggregate(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId,
  expected: &Shared<Type>, span: Span) -> Result<Option<InferredAggregateTarget>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !run Type.containsOpaque(expected, caller) {
    return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none())
  }
  let copied = run Type.copy(expected)
  if let Type.Nominal {declaration, arguments, isPublic} = move copied {
  let declaredModule = ModuleId.copy(DeclarationId.moduleId(&declaration))
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(&declaration))
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, &declaredModule, &identity) {
    Option<usize>.Some {value} => value
    _ => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  }
  let syntax = run scopedHeader(&mut resolver.*, &declaredModule, ordinal)
  let mut generics = Range.empty()
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    match value.header {
      Node.StructHeader {generics: written, ..} => { generics = written }
      Node.TupleHeader {generics: written, ..} => { generics = written }
      _ => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none()) }
    }
  } else { fail RevisionMismatch {} }
  let selected = SelectedDeclaration {module: run internModule(&mut resolver.*, &declaredModule), ordinal: ordinal}
  let found = run inferredAggregateDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, generics, isPublic, span)
  let mut target = match move found {
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value: Option<InferredAggregateTarget>.Some {value}} => move value
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move error) }
    _ => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.TypeArgumentInference, span)) }
  }
  let formal = run Type.copy(&target.ty)
  let template = match move formal { Type.Nominal {arguments: formalArguments, ..} => move formalArguments _ => { fail RevisionMismatch {} } }
  let written = List<Argument>.asSlice(&arguments)
  let slots = List<Argument>.asSlice(&template)
  if written.length != slots.length { fail RevisionMismatch {} }
  let mut construction = List<Argument>.make()
  let mut at = usize.ZERO
  while at < written.length {
    let mut open = false
    if let Argument.Type {value} = &written[at] { open = run Type.containsOpaque(&value, caller) }
    if open { run List<Argument>.append(&mut construction, Argument.copy(&slots[at])) }
    else { run List<Argument>.append(&mut construction, Argument.copy(&written[at])) }
    at = at + usize.ONE
  }
  target.ty = run Types.intern(Type.Nominal {declaration: move declaration, arguments: move construction, isPublic: isPublic})
  target.construction = Option<Shared<Type>>.some(Shared<Type>.clone(expected))
  return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.some(move target))
  }
  return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none())
}

// The construction transaction of a written generic struct, or of the union a written variant
// qualifier names (`variantOwner`). Written arguments fix their binders; every lifetime they elide
// is a further slot of the same transaction, numbered after the declaration's binders, that the
// checked operands infer (LIFE-003).
effect fn inferredRecordAnnotation(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId,
  annotation: HirId, constraints: &[Constraint], span: Span, variantOwner: bool,
) -> Result<Option<InferredAggregateTarget>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run typeNode(&mut resolver.*, module, annotation)
  let syntax = match move written {
    Option<HeaderSyntax>.Some {value} => value
    _ => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none()) }
  }
  let mut selectedNode = syntax.header
  let mut application = HirRef.absent()
  if let Node.AppliedType {target, arguments} = selectedNode {
    application = HirRef.of(arguments)
    let targetSyntax = run typeNode(&mut resolver.*, module, target)
    if let Option<HeaderSyntax>.Some {value} = move targetSyntax { selectedNode = value.header }
  }
  let mut named = HirRef.absent()
  if let Node.NamedType {path: spelled, hasMode, ..} = selectedNode {
    if !hasMode { named = HirRef.of(spelled) }
  }
  if !named.present { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none()) }
  let parsed = run path(&mut resolver.*, module, named.id)
  let segments = List<Bytes>.asSlice(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 {
    return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none())
  }
  // A record constructor annotation is a type root.
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let mut selected = Result<SelectedDeclaration, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotType, parsed.span))
  if segments.length == usize.ONE {
    selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      moduleOrdinal, module, Bytes.asSlice(&segments[usize.ZERO]), false, parsed.span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  } else {
    selected = run qualifiedTypeDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      moduleOrdinal, module, segments, parsed.span)
  }
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none())
    }
  }
  let declaredModule = resolvedModule(&resolver.*, declaration.module)
  let headerSyntax = run scopedHeader(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut generics = Range.empty()
  let mut isPublic = false
  let mut record = false
  if let Option<HeaderSyntax>.Some {value} = move headerSyntax {
    match value.header {
      Node.StructHeader {generics: writtenGenerics, isPublic: published, ..} => {
        generics = writtenGenerics
        isPublic = published
        record = !variantOwner
      }
      Node.UnionHeader {generics: writtenGenerics, isPublic: published, ..} => {
        generics = writtenGenerics
        isPublic = published
        record = variantOwner
      }
      _ => ()
    }
  }
  if !record { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none()) }
  let found = run inferredAggregateDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &declaration, generics, isPublic, span)
  let mut target = match move found {
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value: optional} => match move optional {
      Option<InferredAggregateTarget>.Some {value: aggregate} => move aggregate
      _ => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.none()) }
    }
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => {
      return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move error)
    }
  }
  if application.present {
    let callerIdentity = run Shared<DeclarationId>.make(DeclarationId.copy(caller))
    let located = run ordinalOfIdentity(&mut resolver.*, module, &callerIdentity)
    let callerOrdinal = match move located {
      Option<usize>.Some {value} => value
      _ => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let scoped = match move run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, callerOrdinal) {
      Result<BodyScope, Shared<Rejection>>.Success {value} => move value
      Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move error) }
    }
    let prefixSyntax = run typeNode(&mut resolver.*, module, application.id)
    let prefix = match move prefixSyntax {
      Option<HeaderSyntax>.Some {value} => value
      _ => { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    if let Node.TypeArguments {arguments, environment, failures, requirements} = prefix.header {
      let formal = List<Binder>.asSlice(&target.binders)
      let mut elision = LifetimeElision {
        owner: Option<DeclarationId>.some(DeclarationId.copyShared(&target.owner)), nextOrdinal: formal.length, output: false,
        resultDefault: Option<Shared<Lifetime>>.none(), generated: List<Shared<Lifetime>>.make(),
        invocation: false, nested: false, renumber: List<usize>.make(), staticEnvironment: false,
        supplied: Option<List<Argument>>.none(), assumptions: Option<List<Constraint>>.some(run copyConstraints(constraints)), deferred: Option<List<DeferredBounds>>.none(),
      }
      if environment.present || failures.present {
        let mut suppliedKind = GenericKind.Lifetime
        if failures.present { suppliedKind = GenericKind.Failure }
        return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run rejectKind(&resolver.*, module, prefix.span, b"", GenericKind.Type, suppliedKind))
      }
      let mut bindings = List<Binding>.make()
      let mapped = run writtenBinderOrdinals(&mut resolver.*, module, arguments, prefix.span, formal, requirements.present, parsed.span)
      let positions = match move mapped {
        Result<List<usize>, Shared<Rejection>>.Success {value: mappedOrdinals} => move mappedOrdinals
        Result<List<usize>, Shared<Rejection>>.Failure {error} => {
          return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move error)
        }
      }
      let targets = List<usize>.asSlice(&positions)
      let mut at = usize.ZERO
      while at < arguments.length {
        let formalAt = targets[at]
        let mut explicit = List<Argument>.make()
        let refused = run appendWrittenArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          moduleOrdinal, module, arguments, formal, at, formalAt, List<Binder>.asSlice(&scoped.binders), &mut elision, false,
          &mut explicit)
        if let Option<Shared<Rejection>>.Some {value} = move refused {
          return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move value)
        }
        let values = List<Argument>.asSlice(&explicit)
        if values.length != usize.ONE { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, prefix.span)) }
        run List<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&target.owner),
          ordinal: formalAt, value: copyArgument(&values[usize.ZERO])})
        at = at + usize.ONE
      }
      if requirements.present {
        let formalAt = targets[arguments.length]
        let mut explicit = List<Argument>.make()
        let refused = run appendRequirementsSuffix(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          moduleOrdinal, module, formal, formalAt, requirements, prefix.span, parsed.span,
          List<Binder>.asSlice(&scoped.binders), &mut elision, &mut explicit)
        if let Option<Shared<Rejection>>.Some {value} = move refused { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(move value) }
        let values = List<Argument>.asSlice(&explicit)
        if values.length != usize.ONE { return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, prefix.span)) }
        run List<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&target.owner),
          ordinal: formalAt, value: copyArgument(&values[usize.ZERO])})
      }
      target.written = run writtenLifetimes(List<Binding>.asSlice(&bindings), List<Shared<Lifetime>>.asSlice(&elision.generated))
      target.ty = run Type.applyBindings(&target.ty, List<Binding>.asSlice(&bindings), true)
    } else {
      return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, prefix.span))
    }
  }
  return Result<Option<InferredAggregateTarget>, Shared<Rejection>>.succeed(Option<InferredAggregateTarget>.some(move target))
}

// The lifetimes written arguments name, except those their elision generated.
effect fn writtenLifetimes(bindings: &[Binding], generated: &[Shared<Lifetime>]) -> List<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut named = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < bindings.length {
    match &bindings[at].value {
      Argument.Lifetime {value} => { run List<Shared<Lifetime>>.append(&mut named, Shared<Lifetime>.clone(&value)) }
      Argument.Type {value} => { run namedLifetimes(&value, &mut named) }
      Argument.Row {..} => {}
    }
    at = at + usize.ONE
  }
  let listed = List<Shared<Lifetime>>.asSlice(&named)
  let mut written = List<Shared<Lifetime>>.make()
  at = usize.ZERO
  while at < listed.length {
    if !containsLifetime(generated, &listed[at]) { run List<Shared<Lifetime>>.append(&mut written, Shared<Lifetime>.clone(&listed[at])) }
    at = at + usize.ONE
  }
  return move written
}

// A written record or union qualifier in the caller's body. Each lifetime it elides is a variable
// of the caller's elided-lifetime owner, which the qualifier's use must infer (LIFE-003).
effect fn recordAnnotation(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId,
  annotation: HirId, span: Span, constraints: &[Constraint],
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let deferred = run deferredRecordAnnotation(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, annotation, span)
  if let Option<Shared<Rejection>>.Some {value} = move deferred {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(move value)
  }
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(caller))
  let ordinal = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    ) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let scope = run bodyScope(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, module, declaration)
  let scoped = match move scope {
    Result<BodyScope, Shared<Rejection>>.Success {value} => move value
    Result<BodyScope, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.some(run elidedLifetimeOwner(caller)),
    nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option<Shared<Lifetime>>.none(), generated: List<Shared<Lifetime>>.make(),
    invocation: false, nested: false, renumber: List<usize>.make(), staticEnvironment: false,
    supplied: Option<List<Argument>>.none(), assumptions: Option<List<Constraint>>.some(run copyConstraints(constraints)), deferred: Option<List<DeferredBounds>>.none(),
  }
  return run resolveType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal,
    annotation, List<Binder>.asSlice(&scoped.binders), &mut elision)
}

effect fn recordConstructionType(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId,
  annotation: HirId, span: Span, inference: &Option<InferredAggregateTarget>, constraints: &[Constraint],
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    return Result<Shared<Type>, Shared<Rejection>>.succeed(Shared<Type>.clone(&target.ty))
  }
  let resolved = run recordAnnotation(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, annotation, span, constraints,
  )
  // Only a written generic owner infers construction slots; a lifetime elided behind an alias
  // has no slot in this construction.
  let elided = run elidedLifetimeOwner(caller)
  if let Result<Shared<Type>, Shared<Rejection>>.Success {value} = &resolved {
    if run typeMentionsOwner(&value, &elided) {
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.BodyLifetimeElisionUnavailable, span),
      )
    }
  }
  return move resolved
}

// Contextual operands never receive inference identities. Written borrows share a caller-owned
// call region; fixed lifetime evidence stays in the unifier so context cannot manufacture 'static.
effect fn callArgumentType(
  parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], caller: &DeclarationId, expression: HirId,
  contextual: bool, anchor: &Anchor,
) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureBinderCount)
  let mut supplied = List<Argument>.make()
  let mut at = usize.ZERO
  while at < count {
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<InferenceBinder>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    let selected = match move binder {
      Option<InferenceBinder>.Some {value} => move value
      Option<InferenceBinder>.None => { return Shared<Type>.clone(parameter) }
    }
    let isLifetime = match &selected { InferenceBinder.Lifetime {..} => true _ => false }
    let mut value = run contextBinderArgument(&selected, at, caller, expression, contextual, anchor)
    if !contextual || !isLifetime {
      let known = bindingArgumentAt(bindings, at)
      if let Option<Argument>.Some {value: evidence} = move known { value = move evidence }
    }
    run List<Argument>.append(&mut supplied, move value)
    at = at + usize.ONE
  }
  return run Type.instantiate(parameter, fresh, List<Argument>.asSlice(&supplied))
}

effect fn callArgumentContext(
  parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], caller: &DeclarationId, expression: HirId, anchor: &Anchor,
) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let context = run callArgumentType(parameter, signature, fresh, bindings, caller, expression, true, anchor)
  if run typeMentionsOwner(&context, fresh) { return Option<Shared<Type>>.none() }
  if !Shared<Type>.with<bool>(&context, runtimeType) { return Option<Shared<Type>>.none() }
  return Option<Shared<Type>>.some(move context)
}

// The known positions of a representation parameter's callable bound inform a named value.
// Unknown consumer positions retain their private owner; the whole bound is proved separately.
effect fn representationPromise(parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, bindings: &[Binding], caller: &DeclarationId, expression: HirId, anchor: &Anchor, explicitSyntax: bool,
  callSpan: Span) -> Option<NamedCallableEvidence>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract}} = move bound {
      if run Type.equalsShared(parameter, &representation) {
        let promised = run callArgumentType(&contract, signature, fresh, bindings, caller, expression, false, anchor)
        let callable = Shared<Type>.with<bool>(&promised, fn(ty: &Type) -> bool {
          return match &ty.* { Type.Callable {..} => true _ => false }
        })
        if !callable { return Option<NamedCallableEvidence>.none() }
        let mut pending = Option<DeclarationId>.none()
        if run typeMentionsOwner(&promised, fresh) {
          pending = Option<DeclarationId>.some(DeclarationId.copy(fresh))
        }
        // Without written binders, a contract mentioning the call's binders is shaped by its inference.
        let mut call = Option<Span>.none()
        let none = List<Binding>.make()
        let open = run callArgumentType(&contract, signature, fresh, List<Binding>.asSlice(&none), caller, expression, false, anchor)
        if !explicitSyntax && run typeMentionsOwner(&open, fresh) { call = Option<Span>.some(callSpan) }
        return Option<NamedCallableEvidence>.some(NamedCallableEvidence {contract: move promised, pending: move pending, call: move call})
      }
    }
    at = at + usize.ONE
  }
  return Option<NamedCallableEvidence>.none()
}

effect fn contextBinderArgument(binder: &InferenceBinder, ordinal: usize, caller: &DeclarationId, expression: HirId, contextual: bool,
  anchor: &Anchor) -> Argument
! OutOfMemoryError ? &mut Allocator {
  match &binder.* {
    InferenceBinder.Lifetime {value} => {
      if !contextual { return Argument.Lifetime {value: Shared<Lifetime>.clone(&value)} }
      return Argument.Lifetime {
        value: run Shared<Lifetime>.make(anchoredRegion(anchor, caller, expression, ordinal)),
      }
    }
    InferenceBinder.Type {value} => { return Argument.Type {value: Shared<Type>.clone(&value)} }
    InferenceBinder.Row {value} => {
      let mut row = Row.empty()
      run Row.include(&mut row, RowParameter {declaration: Shared<DeclarationId>.clone(&value.declaration), ordinal: value.ordinal})
      return Argument.Row {value: run Shared<Row>.make(move row)}
    }
  }
}

effect fn rootCallBorrowContext(context: &Option<Shared<Type>>, caller: &DeclarationId, expression: HirId, anchor: &Anchor,
  binder: usize) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.Some {value} = &context.* {
    let adjusted = run callerReferenceType(&value, caller, expression, anchor, binder)
    if let Option<Shared<Type>>.Some {value: reference} = move adjusted { return Option<Shared<Type>>.some(move reference) }
    return Option<Shared<Type>>.some(Shared<Type>.clone(&value))
  }
  return Option<Shared<Type>>.none()
}

// Positional fields are authorized by the selected nominal tuple, never by record names.
effect fn checkedTupleElements(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, ty: &Shared<Type>, span: Span,
) -> Result<List<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let anonymous = run Type.anonymousParts(ty)
  if let Option<AnonymousParts>.Some {value: parts} = move anonymous {
    if AnonymousOccurrence.isPositional(&parts.occurrence) {
      return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(move parts.members)
    }
    return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotType, span))
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  }
  let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
  let mut count = usize.MAX
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.TupleHeader {elements, ..} = value.header { count = elements.length }
  }
  if count == usize.MAX { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.NotType, span)) }
  let application = run internApplication(&mut resolver.*, ty)
  let mut fields = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let declarationAccess120Request = Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: at, external: false,
    }
    let declarationAccess120 = run internDeclaration(&mut resolver.*, declarationAccess120Request)
    let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess120, span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shape, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(move value)
    }
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shape, singleMemberType)
    let field = match move selected {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    run List<Shared<Type>>.append(&mut fields, move field)
    at = at + usize.ONE
  }
  return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(move fields)
}

// Projection auto-dereferences references while retaining the original access evidence.
effect fn checkedProjectionSubject<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  subject: HirId, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    subject, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
  let mut node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  while true {
    let evidence = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node)
    let selected = match move evidence {
      Option<Shared<Type>>.Some {value} => Shared<Type>.with<Option<Shared<Type>>>(&value,
        fn(value: &Type) -> Option<Shared<Type>> {
          if let Type.Reference {referent, ..} = &value.* { return Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) }
          return Option<Shared<Type>>.none()
        })
      Option<Shared<Type>>.None => Option<Shared<Type>>.none()
    }
    let referent = match move selected {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { break }
    }
    let next = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(&mut nodes.*, BodyNode {
      origin: run bodyOrigin(&resolver.source, cursor, subject),
      kind: BodyNodeKind.Expression {ty: move referent, form: BodyExpression.Dereference {value: node}},
    })
    node = next
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
}

// Positional construction uses the same aggregate operand/storage representation as records.
effect fn checkPositionalAggregate<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, elements: CallArguments, ty: &Shared<Type>, fields: &[Shared<Type>],
  inference: &Option<InferredAggregateTarget>, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  if CallArguments.length(elements) != fields.length {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run tupleArityRejection(module, span, ty, fields.length, CallArguments.length(elements)))
  }
  let mut operands = List<BodyAggregateField>.make()
  let mut inferred = List<Binding>.make()
  let mut constructionFields = List<Shared<Type>>.make()
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    if let Option<Shared<Type>>.Some {value: blueprint} = &target.construction {
      constructionFields = match move run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &blueprint, span) {
        Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
        Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
    }
  }
  let mut at = usize.ZERO
  while at < fields.length {
    let context = Option<Shared<Type>>.some(Shared<Type>.clone(&fields[at]))
    let argument = run bodyArgument(&resolver.source, cursor, elements, at)
    let mut construction = Option<Shared<Type>>.none()
    let blueprints = List<Shared<Type>>.asSlice(&constructionFields)
    if at < blueprints.length { construction = Option<Shared<Type>>.some(Shared<Type>.clone(&blueprints[at])) }
    let mut checked = Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: usize.ZERO})
    if let Option<InferredAggregateTarget>.Some {..} = &inference.* {
      checked = run checkAggregateInitializer(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        &fields[at], inference, &construction, &mut inferred, argument, run anchoredNode(cursor, expression), constraints, contractBody, false, unsafeAllowed)
    } else {
      checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        argument, &context, RejectionCode.StructFieldTypeMismatch, constraints, contractBody, staticBody, unsafeAllowed)
    }
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    run List<BodyAggregateField>.append(&mut operands, BodyAggregateField {index: at, value: node})
    at = at + usize.ONE
  }
  let completed = match move run completeAggregateInference(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    ty, inference, List<Binding>.asSlice(&inferred), List<BodyNode>.asSlice(&nodes.*),
    List<BodyAggregateField>.asSlice(&operands), constraints, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !Shared<Type>.with<bool>(&value, sourceUnion) {
      let variables = List<Shared<DeclarationId>>.make()
      let mut inferred = List<Binding>.make()
      let failed = run matchCallArgument(&resolver.*, module, span, &value, &completed,
        List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred, constraints, mismatchCode)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move diagnostic)
      }
    }
  }
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move completed, form: BodyExpression.Aggregate {fields: move operands, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// Tuple field patterns are queried under the nominal declaration's authored template. Applying
// call-inference arguments happens only afterwards in owned storage; fresh IDs never form a key.
effect fn callTupleFields(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, parameter: &Shared<Type>, span: Span,
) -> Result<List<Shared<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let shape = run Type.copy(parameter)
  if let Type.Nominal {declaration, isPublic, arguments} = move shape {
    let declaredModule = DeclarationId.moduleId(&declaration)
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, declaredModule)
    let identity = run Shared<DeclarationId>.make(DeclarationId.copy(&declaration))
    let selected = run ordinalOfIdentity(&mut resolver.*, declaredModule, &identity)
    let ordinal = match move selected {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotType, span)) }
    }
    let template = run templateBinders(&mut resolver.*, declaredModule, ordinal)
    let mut binders = match move template {
      Result<List<Binder>, Shared<Rejection>>.Success {value} => move value
      Result<List<Binder>, Shared<Rejection>>.Failure {error} => { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(move error) }
    }
    let failed = run completeApplicationBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      moduleOrdinal, declaredModule, ordinal, span, &mut binders)
    if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(move value) }
    let generated = List<Shared<Lifetime>>.make()
    let authored = run ownedArguments(&declaration, List<Binder>.asSlice(&binders), List<Shared<Lifetime>>.asSlice(&generated))
    let queryType = run Types.intern(Type.Nominal {
      declaration: DeclarationId.copy(&declaration), isPublic: isPublic, arguments: move authored,
    })
    let queried = run checkedTupleElements(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &queryType, span)
    let fields = match move queried {
      Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
      Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(move error) }
    }
    let listed = List<Shared<Type>>.asSlice(&fields)
    let mut applied = List<Shared<Type>>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      run List<Shared<Type>>.append(&mut applied, run Type.instantiate(&listed[at], &declaration, List<Argument>.asSlice(&arguments)))
      at = at + usize.ONE
    }
    return Result<List<Shared<Type>>, Shared<Rejection>>.succeed(move applied)
  }
  return Result<List<Shared<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NotType, span))
}

struct CheckedBorrow {
  ty: Shared<Type>,
  value: BodyNodeId,
}

// The validity of borrowed storage comes from the descriptor crossed by a place projection,
// not the type of the projected value or its expected result. Owned local descriptors themselves
// are local storage; only dereferencing one borrows the storage its lifetime describes.
fn borrowedPlaceRegion(nodes: &[BodyNode], id: BodyNodeId) -> Option<Shared<Lifetime>> {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Dereference {value}, ..} => match &nodes[value.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, operandRegion)
      _ => Option<Shared<Lifetime>>.none()
    }
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => borrowedPlaceRegion(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => {
      if let BodyNodeKind.Expression {ty, ..} = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some {..} = move Type.sliceElement(&ty) {
          return Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, operandRegion)
        }
      }
      return borrowedPlaceRegion(nodes, value)
    }
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {subject, access, ..}, ..} => {
      if access == BodyBindingAccess.Shared || access == BodyBindingAccess.Exclusive {
        return borrowedPlaceRegion(nodes, subject)
      }
      return Option<Shared<Lifetime>>.none()
    }
    _ => Option<Shared<Lifetime>>.none()
  }
}

// Whether `value` is `&T` for a type parameter `T` that the call being inferred owns.
fn freshReferent(value: &Type, fresh: &DeclarationId) -> bool {
  return match &value.* {
    Type.Reference {referent, ..} => Shared<Type>.with<bool>(&referent, fn(target: &Type) -> bool {
      return match &target.* {
        Type.Parameter {declaration, ..} => DeclarationId.equals(&declaration, fresh)
        _ => false
      }
    })
    _ => false
  }
}

fn isReferenceType(value: &Type) -> bool {
  return match &value.* { Type.Reference {..} => true
    _ => false
  }
}

fn exclusiveLoan(value: &Type) -> bool {
  return match &value.* { Type.Reference {access, ..} => access == Access.Mutable _ => false }
}

// The conversion shape is separate from expected element/access/region evidence. Call inference
// requests slice reborrowing here, then validates the actual loan through its persistent unifier.
effect fn checkBorrowOperand<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, access: Access, operand: HirId, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  sliceHint: bool, referenceHint: bool, loanOrdinal: usize, loanBinder: usize, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool,
) -> Result<CheckedBorrow, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  if staticBody {
    return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
  }
  // A borrowed array literal is checked against its loan context, so `&[1, 2]` for `&[u8]`
  // infers u8 elements; an uncontextualized literal keeps ordinary element inference.
  let mut operandContext = run borrowedArrayContext(&resolver.source, cursor, operand, expected)
  if let Node.ArrayRepeatExpression {count, ..} = run bodyNode(&resolver.source, cursor, operand) {
    if let Option<Shared<Type>>.Some {value: context} = &expected.* {
      if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&context) {
        let length = match move run arrayRepeatCount(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, &statementScope.*, calls, count) {
          Result<usize, Shared<Rejection>>.Success {value} => value
          Result<usize, Shared<Rejection>>.Failure {error} => { return Result<CheckedBorrow, Shared<Rejection>>.failResult(move error) }
        }
        operandContext = Option<Shared<Type>>.some(run Types.intern(Type.Array {
          element: move element, extent: run Type.extentText(length),
        }))
      } else {
        operandContext = Shared<Type>.with<Option<Shared<Type>>>(&context, fn(value: &Type) -> Option<Shared<Type>> {
          if let Type.Reference {referent, ..} = &value.* {
            if let Option<ArrayShape>.Some {..} = move Type.arrayShape(&referent) {
              if !Type.hasOpenRuntimeParameters(&referent) { return Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) }
            }
          }
          return Option<Shared<Type>>.none()
        })
      }
    }
  }
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    caller,
    &mut statementScope.*,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    operand,
    &operandContext, mismatchCode,
    constraints,
    contractBody,
    staticBody,
    unsafeAllowed,
  )
  let mut operandNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<CheckedBorrow, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut referent = match move bodyExpressionType(
    List<BodyNode>.asSlice(&nodes.*),
    &operandNode,
  ) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
    }
  }
  let sourceRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(&referent, operandRegion)
  let mut sliceContext = sliceHint
  if let Option<Shared<Type>>.Some {value: context} = &expected.* {
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&context) { sliceContext = true }
  }
  // A slice operand reborrows as a slice, unless the context asks for a reference: then it borrows
  // the slice descriptor itself, as `& &[T]`, which a `self: &Self` receiver whose provider is a
  // slice, or a generic `&T` parameter, needs.
  let descriptorBorrow = match &expected.* {
    Option<Shared<Type>>.Some {value: context} => Shared<Type>.with<bool>(&context, isReferenceType)
    Option<Shared<Type>>.None => referenceHint
  }
  if !descriptorBorrow {
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&referent) {
      if access == Access.Mutable && !Shared<Type>.with<bool>(&referent, mutableSlice) {
        return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.InvalidReborrow, span))
      }
      let ty = run Types.intern(Type.Slice {
        element: move element, access: access,
        lifetime: match move sourceRegion {
          Option<Shared<Lifetime>>.Some {value} => move value
          Option<Shared<Lifetime>>.None => { return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
        },
      })
      return Result<CheckedBorrow, Shared<Rejection>>.succeed(CheckedBorrow {ty: move ty, value: operandNode})
    }
  }
  // A contextual reference borrow reborrows the referent, rather than the stored descriptor.
  let mut reborrow = false
  if sliceContext {
    reborrow = Shared<Type>.with<bool>(&referent, fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {..} => true
        _ => false
      }
    })
  } else if let Option<Shared<Type>>.Some {value: context} = &expected.* {
    reborrow = Shared<Type>.with<bool>(
      &context,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Reference {..} => true
          Type.Slice {..} => true
          _ => false
        }
      },
    ) && Shared<Type>.with<bool>(
      &referent,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Reference {..} => true
          _ => false
        }
      },
    )
  }
  // Without a reference context, `&mut x` still reborrows when `x` is an immutable binding holding
  // an exclusive loan: borrowing the binding itself would need it to be `mut`, so the referent is
  // the only valid place (BORROW-005), as when an inferred `&mut P` parameter supplies no context.
  if !reborrow && access == Access.Mutable && Shared<Type>.with<bool>(&referent, exclusiveLoan) {
    reborrow = !mutablePlace(List<BodyNode>.asSlice(&nodes.*), List<BodyLocal>.asSlice(&statementScope.locals.*),
      operandNode)
  }
  if reborrow {
    // Reborrowing never strengthens access (BORROW-005).
    let sharedParent = Shared<Type>.with<bool>(&referent, fn(value: &Type) -> bool {
      return match &value.* {
        Type.Reference {access: parent, ..} => parent == Access.Shared
        _ => false
      }
    })
    if access == Access.Mutable && sharedParent {
      return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.InvalidReborrow, span))
    }
    let pointee = Shared<Type>.with<Option<Shared<Type>>>(
      &referent,
      fn(value: &Type) -> Option<Shared<Type>> {
        return match & value.* {
          Type.Reference {referent: target, ..} => Option<Shared<Type>>.some(
            Shared<Type>.clone(&target),
          )
          _ => Option<Shared<Type>>.none()
        }
      },
    )
    let target = match move pointee {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
      }
    }
    let descriptor = operandNode
    operandNode = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(
      &mut nodes.*,
      BodyNode {
        origin: run originAt(cursor, expression, span),
        kind: BodyNodeKind.Expression {
          ty: Shared<Type>.clone(&target),
          form: BodyExpression.Dereference {value: descriptor},
        },
      },
    )
    referent = move target
  }
  // An operand that names no existing storage is an owned temporary with a hidden owner
  // (BORROW-006). A mutable loan may change it because no other name observes it.
  let temporary = !existingStorage(List<BodyNode>.asSlice(&nodes.*), operandNode)
  if access == Access.Mutable && !temporary && !mutablePlace(
    List<BodyNode>.asSlice(&nodes.*),
    List<BodyLocal>.asSlice(&statementScope.locals.*),
    operandNode,
  ) {
    // A borrow through a shared reference or slice cannot strengthen its access (BORROW-005); it
    // is reported at the whole borrow. An immutable binding is reported at the borrowed operand.
    if sharedReferent(List<BodyNode>.asSlice(&nodes.*), operandNode) {
      return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.InvalidReborrow, span))
    }
    let operandSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[operandNode.index].origin)
    return Result<CheckedBorrow, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.ExclusiveBorrowRequiresMutable, operandSpan))
  }
  let place = borrowedPlaceRegion(List<BodyNode>.asSlice(&nodes.*), operandNode)
  let described = match &place {
    Option<Shared<Lifetime>>.Some {..} => true
    Option<Shared<Lifetime>>.None => false
  }
  let sourceValidity = match move place {
    Option<Shared<Lifetime>>.Some {value} => move value
    Option<Shared<Lifetime>>.None => run Shared<Lifetime>.make(
      Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: loanOrdinal, binder: loanBinder},
    )
  }
  // A reference reborrow gets its own body-local loan region. The descriptor's validity remains
  // the source of the outlives obligation; it does not fix this new borrow's inferred lifetime.
  // Slices retain their descriptor region as before.
  let mut region = Shared<Lifetime>.clone(&sourceValidity)
  if described && !sliceContext {
    region = run Shared<Lifetime>.make(Lifetime.Local {
      declaration: DeclarationId.copy(caller), ordinal: loanOrdinal, binder: loanBinder,
    })
  }
  if !sliceContext {
    if let Option<Shared<Type>>.Some {value: context} = &expected.* {
      let expectedRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(&context,
        fn(value: &Type) -> Option<Shared<Lifetime>> {
          return match &value.* {
            Type.Reference {lifetime: validity, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&validity))
            _ => Option<Shared<Lifetime>>.none()
          }
        })
      if let Option<Shared<Lifetime>>.Some {value: requested} = move expectedRegion {
        // The loan takes the context's region. The region check proves the borrowed place valid
        // for it: storage owned here cannot escape its validity (BORROW-006, BORROW-008), and a
        // descriptor's region must outlive it (LIFE-002), including a nonlocal relation through a
        // descriptor that typing admits (`admitsRegion`).
        let mut deferred = List<RegionPair>.make()
        if described && !callerLocalRegion(&requested, caller) {
          let admitted = run admitsRegion(&sourceValidity, &requested, caller, constraints, &mut deferred)
          if admitted && !relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&deferred)) {
            return Result<CheckedBorrow, Shared<Rejection>>.failResult(run reject(&resolver.*, module, mismatchCode, span))
          }
        }
        region = move requested
      }
    }
  }
  let ty = run Types.intern(
    Type.Reference {referent: move referent, access: access, lifetime: move region},
  )
  return Result<CheckedBorrow, Shared<Rejection>>.succeed(CheckedBorrow {ty: move ty, value: operandNode})
}

// Whether a place is reached through shared access. Field and array-element projections
// preserve their parent's access; slice elements are governed by the descriptor's access.
fn sharedReferent(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {
      form: BodyExpression.Field { value, .. },
      ..
    } => sharedReferent(nodes, value)
    BodyNodeKind.Expression { form: BodyExpression.Index { value, .. }, .. } => {
      if let BodyNodeKind.Expression { ty, .. } = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some { value: element } = move Type.sliceElement(&ty) {
          return !Shared<Type>.with<bool>(&ty, mutableSlice)
        }
      }
      return sharedReferent(nodes, value)
    }
    BodyNodeKind.Expression {
      form: BodyExpression.Dereference { value },
      ..
    } => match &nodes[value.index].kind {
      BodyNodeKind.Expression { ty, .. } => Shared<Type>.with<bool>(
        &ty,
        fn(value: &Type) -> bool {
          return match &value.* {
            Type.Reference { access, .. } => access == Access.Shared
            _ => false
          }
        }
      )
      _ => false
    }
    _ => false
  }
}

// Whether a loan addresses storage that already has an owner: a local, a match binding, or the
// referent of a reference or slice, reached through field and element projections. Any other
// operand, such as a call result, a literal or a projection of one, is evaluated into a temporary
// that the loan's hidden owner keeps for the full expression or a borrowing binding (BORROW-006).
fn existingStorage(nodes: &[BodyNode], id: BodyNodeId) -> bool {
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.PatternBinding {..}, ..} => true
    BodyNodeKind.Expression {form: BodyExpression.Field {value, ..}, ..} => existingStorage(nodes, value)
    BodyNodeKind.Expression {form: BodyExpression.Index {value, ..}, ..} => {
      // A slice element lives in the slice's referent, however the descriptor was produced.
      if let BodyNodeKind.Expression {ty, ..} = &nodes[value.index].kind {
        if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&ty) { return true }
      }
      return existingStorage(nodes, value)
    }
    _ => false
  }
}

// Whether `expression` is the array literal `[]`.
effect fn emptyArrayLiteral(source: &SourceIndex, cursor: &AuthoredCursor, expression: HirId) -> bool ! RevisionMismatch {
  return match run bodyNode(source, cursor, expression) {
    Node.ArrayExpression {elements} => elements.length == usize.ZERO
    _ => false
  }
}

// `written` with every lifetime that `elided` owns replaced by `'static`.
effect fn staticElided(written: &Shared<Type>, elided: &DeclarationId) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut atoms = List<Shared<Lifetime>>.make()
  run Type.everyRegionAtom(written, &mut atoms)
  let listed = List<Shared<Lifetime>>.asSlice(&atoms)
  let mut bindings = List<Binding>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let ordinal = Shared<Lifetime>.with<usize>(&listed[at], fn(value: &Lifetime) -> usize {
      return match &value.* {
        Lifetime.Parameter {declaration, ordinal} => {
          if DeclarationId.equals(&declaration, elided) { return ordinal }
          return usize.MAX
        }
        _ => usize.MAX
      }
    })
    if ordinal != usize.MAX {
      run List<Binding>.append(&mut bindings, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(elided)),
        ordinal: ordinal, value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)}})
    }
    at = at + usize.ONE
  }
  return run Type.applyBindings(written, List<Binding>.asSlice(&bindings), true)
}

// The array type a borrowed array literal must have under its loan context, if any.
effect fn borrowedArrayContext(
  source: &SourceIndex, cursor: &AuthoredCursor, operand: HirId, expected: &Option<Shared<Type>>,
) -> Option<Shared<Type>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let length = match run bodyNode(source, cursor, operand) {
    Node.ArrayExpression {elements} => elements.length
    _ => { return Option<Shared<Type>>.none() }
  }
  if let Option<Shared<Type>>.Some {value: context} = &expected.* {
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&context) {
      return Option<Shared<Type>>.some(run Types.intern(Type.Array {element: move element, extent: run Type.extentText(length)}))
    }
    return Shared<Type>.with<Option<Shared<Type>>>(&context, fn(value: &Type) -> Option<Shared<Type>> {
      if let Type.Reference {referent, ..} = &value.* {
        if let Option<ArrayShape>.Some {..} = move Type.arrayShape(&referent) {
          // A fixed loan region is useful context even when the aggregate must infer the
          // element type. An open element must not contextually type the literal itself.
          if Type.hasOpenRuntimeParameters(&referent) { return Option<Shared<Type>>.none() }
          return Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
        }
      }
      return Option<Shared<Type>>.none()
    })
  }
  return Option<Shared<Type>>.none()
}

effect fn repeatedTypes(element: &Shared<Type>, count: usize) -> List<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let mut repeated = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<Shared<Type>>.append(&mut repeated, Shared<Type>.clone(element))
    at = at + usize.ONE
  }
  return move repeated
}

// A concrete slice element types a borrowed array literal; an inferred element does not.
effect fn concreteSliceContext(parameter: &Shared<Type>, fresh: &DeclarationId) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let element = match move Type.sliceElement(parameter) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<Shared<Type>>.none() }
  }
  if run typeMentionsOwner(&element, fresh) {
    return Option<Shared<Type>>.none()
  }
  return Option<Shared<Type>>.some(Shared<Type>.clone(parameter))
}

// A reference parameter whose referent has inferred lifetimes, such as `&mut Plan` for
// `Plan<'a>`. Its contextual referent carries call-region stand-ins, so the loan's actual referent
// is matched by the exact unifier instead of the expected-value check.
effect fn inferredReferentLifetimes(parameter: &Shared<Type>, fresh: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let referent = Shared<Type>.with<Option<Shared<Type>>>(parameter, fn(value: &Type) -> Option<Shared<Type>> {
    if let Type.Reference {referent, ..} = &value.* { return Option<Shared<Type>>.some(Shared<Type>.clone(&referent)) }
    return Option<Shared<Type>>.none()
  })
  if let Option<Shared<Type>>.Some {value} = move referent {
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    run Type.collectOwned(&value, fresh, &mut types, &mut lifetimes, &mut rows)
    return List<usize>.length(&lifetimes) > usize.ZERO
  }
  return false
}

// Rewrites the borrow node's reference type to carry the caller call region; a node whose type is
// not a reference is left untouched.
effect fn contributeBorrowCallRegion(
  resolver: &mut Resolver, module: &ModuleId, nodes: &mut List<BodyNode>, caller: &DeclarationId,
  node: BodyNodeId, call: HirId, callSpan: Span, anchor: &Anchor, binder: usize,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let borrowed = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node)
  let value = match move borrowed {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<Shared<Rejection>>.none() }
  }
  let shape = run Type.copy(&value)
  if let Type.Reference {referent, access, lifetime: previousLifetime} = move shape {
    let region = run Shared<Lifetime>.make(anchoredRegion(anchor, caller, call, binder))
    let actual = run Types.intern(Type.Reference {referent: move referent, access: access,
      lifetime: Shared<Lifetime>.clone(&region)})
    let previous = List<BodyNode>.remove(&mut nodes.*, node.index)
    let form = match move previous.kind {
      BodyNodeKind.Expression {form, ty: previousType} => move form
      _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, callSpan)) }
    }
    run List<BodyNode>.insert(&mut nodes.*, node.index, BodyNode {origin: previous.origin,
      kind: BodyNodeKind.Expression {ty: move actual, form: move form}})
  }
  return Option<Shared<Rejection>>.none()
}

// Aggregate argument inference checks each child once, retaining its actual caller evidence.
// The parent is constructed only after those bindings have been solved; contextual placeholder
// lifetimes are never published as the array element or nominal tuple's actual arguments.
// A representation can occur behind a source reference. Match only the type slot named by
// the bound, never the enclosing descriptor or an unrelated lifetime/type argument.
effect fn reachesRepresentation(reached: &[Shared<Type>], representation: &Shared<Type>, fresh: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < reached.length {
    if run parameterUsesRepresentation(&reached[at], representation, fresh) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn parameterUsesRepresentation(
  parameter: &Shared<Type>,
  representation: &Shared<Type>,
  fresh: &DeclarationId,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let ordinal = Shared<Type>.with<usize>(
    representation,
    fn(value: &Type) -> usize {
      return Type.parameterOrdinalOf(value, fresh)
    },
  )
  if ordinal == usize.MAX {
    return false
  }
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(parameter, fresh, &mut types, &mut lifetimes, &mut rows)
  let used = List<usize>.asSlice(&types)
  let mut at = usize.ZERO
  while at < used.length {
    if used[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether a written call argument fixed the binder at `ordinal`.
fn fixedOrdinal(explicit: &[usize], ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < explicit.length {
    if explicit[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Implicit source calls infer their authored binders, including lifetimes. Explicit source
// specialization selects lifetimes before inference; hidden exact slots are never authored binders.
fn sourceCallableInference(
  signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId,
  explicit: &[usize],
  explicitSyntax: bool,
  callableParameterStart: usize,
) -> bool {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureBinderCount)
  let mut at = usize.ZERO
  while at < count && at < callableParameterStart {
    if fixedOrdinal(explicit, at) {
      at = at + usize.ONE
      continue
    }
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<InferenceBinder>>(
      signature,
      fn(value: &Result<Answer, NoRejection>) -> Option<InferenceBinder> {
        return inferenceBinderAt(value, at)
      },
    )
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => {
        if Shared<Type>.with<usize>(
          &value,
          fn(ty: &Type) -> usize {
            return Type.parameterOrdinalOf(ty, fresh)
          },
        ) != usize.MAX {
          return true
        }
      }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => {
        if declarationEqualsShared(fresh, &value.declaration) {
          return true
        }
      }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {..}} => {
        if !explicitSyntax {
          return true
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return false
}

// Hidden representations do not introduce a source generic-inference failure when every
// authored binder was explicitly fixed. Such plain callable mismatches use the argument span.
effect fn callableArgumentFailure(
  resolver: &Resolver,
  module: &ModuleId,
  failure: &Shared<Rejection>,
  source: &Shared<Type>,
  /// The callable type the parameter or bound requires, whose mode the offered value must meet.
  wanted: &Shared<Type>,
  constraints: &[Constraint],
  inferredRepresentation: bool,
  sourceInference: bool,
  span: Span,
  callSpan: Span,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let code = Shared<Rejection>.with<RejectionCode>(
    failure,
    fn(value: &Rejection) -> RejectionCode {
      return value.code
    },
  )
  // A handler that misses a failure of its Effect is already named at the handler (SEM0067).
  if !inferredRepresentation || unavailableRejection(code) || code == RejectionCode.InvalidEffectHandler {
    return Shared<Rejection>.clone(failure)
  }
  // A failing Effect offered for an infallible bound already names its error and the fix.
  if code == RejectionCode.TypeArgumentInference && Shared<Rejection>.with<bool>(failure, failingEffectNamed) {
    return Shared<Rejection>.clone(failure)
  }
  // A plain callable's signature may match while its retained environment is too short.
  // Keep that lifetime proof failure at the supplied operand instead of relabeling its shape.
  if !sourceInference && code == RejectionCode.UnsatisfiedLifetimeBound {
    return run reject(resolver, module, code, span)
  }
  let contract = run valueCallableContract(source, constraints)
  // A `once` value where a `mut` or shared callable is required, or a `mut` one where a shared one
  // is, can never satisfy it, whatever the call infers: that is the argument's mismatch (SEM0076).
  let mut offeredMode = callableModeOf(source)
  let unknownMode = match &offeredMode {
    Option<CallableMode>.None => true
    _ => false
  }
  if unknownMode {
    if let Option<Shared<Type>>.Some {value: offered} = &contract { offeredMode = callableModeOf(&offered) }
  }
  if let Option<CallableMode>.Some {value: given} = move offeredMode {
    if let Option<CallableMode>.Some {value: required} = move callableModeOf(wanted) {
      if modeRank(given) > modeRank(required) {
        return run modeMismatchRejection(module, given, required, span)
      }
    }
  }
  if sourceInference {
    // Inferring a callable bound from a value whose result is an Effect (an `effect fn` value)
    // needs Effect environment and run-mode inference; that remains the named effect-form gap.
    if let Option<Shared<Type>>.Some {value: offered} = &contract {
      if Shared<Type>.with<bool>(&offered, effectProducing) {
        return run reject(resolver, module, RejectionCode.EffectFormUnavailable, callSpan)
      }
    }
    return run reject(resolver, module, RejectionCode.TypeArgumentInference, callSpan)
  }
  // An Effect that needs services the expected contract does not allow, such as a fiber's child
  // that needs a `Logger`, names them and the allowed ones.
  if let Option<EffectBound>.Some {value: effects} = move run effectBound(source, wanted) {
    if (run Row.covers(&effects.wanted.requirements, &effects.offered.requirements)) != RowCoverage.Covered {
      if let Option<Shared<Rejection>>.Some {value: named} = move run effectRequirementsRejection(module, span,
        &effects.offered.requirements, &effects.wanted.requirements) {
        return move named
      }
    }
  }
  if let Option<Shared<Type>>.Some {..} = move contract {
    return run reject(resolver, module, RejectionCode.IncompatibleCallableSignature, span)
  }
  return run reject(resolver, module, code, span)
}

// The invocation mode a callable or Effect type declares; none for any other type.
fn callableModeOf(ty: &Shared<Type>) -> Option<CallableMode> {
  return Shared<Type>.with<Option<CallableMode>>(ty, fn(value: &Type) -> Option<CallableMode> {
    return match &value.* {
      Type.Callable {mode, ..} => Option<CallableMode>.some(mode)
      Type.Effect {mode, ..} => Option<CallableMode>.some(mode)
      _ => Option<CallableMode>.none()
    }
  })
}

// How much a callable's invocation consumes: shared, then exclusive (`mut`), then `once`.
fn modeRank(mode: CallableMode) -> usize {
  return match mode {
    CallableMode.Shared => usize.ZERO
    CallableMode.Mutable => usize.ONE
    CallableMode.Once => 2
  }
}

fn modeWord(mode: CallableMode) -> &'static [u8] {
  return match mode {
    CallableMode.Shared => b"shared (no `mut` or `once`)"
    CallableMode.Mutable => b"`mut`"
    CallableMode.Once => b"`once`"
  }
}

// SEM0076 for an argument whose callable mode is stronger than the parameter admits, naming both.
effect fn modeMismatchRejection(module: &ModuleId, given: CallableMode, required: CallableMode, span: Span) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.IncompatibleCallableSignature, module, span)
  let mut actual = run Bytes.copy(b"value with mode ")
  run Bytes.append(&mut actual, modeWord(given))
  let mut expected = run Bytes.copy(b"a parameter with mode ")
  run Bytes.append(&mut expected, modeWord(required))
  if required == CallableMode.Shared {
    run Bytes.append(&mut expected, b", which may call it through a shared borrow")
  } else {
    run Bytes.append(&mut expected, b", which may call it more than once")
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"actual"), value: move actual})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"expected"), value: move expected})
  return run Shared<Rejection>.make(move diagnostic)
}

fn pendingCallableSelection(value: &Shared<Type>) -> bool {
  return Type.containsCallableOrigin(value) || Type.containsCallableWitness(value)
}

fn pendingOriginContext(value: &Option<Shared<Type>>) -> bool {
  return match &value.* { Option<Shared<Type>>.Some {value: pending} => pendingCallableSelection(&pending) _ => false }
}

// Bindings an operand fixes by moving binders earlier operands fixed, with the relations they owe.
struct ReboundArgument {
  bindings: List<Binding>,
  relations: List<RegionPair>,
}

// An operand whose parameter is the only one observing an inferred lifetime binder invariantly, as
// `out` of `stash<'a>(src: &'a i32, out: &mut Holder<'a>)`, fixes that binder to its own region
// when an earlier operand fixed it differently, so inference does not depend on parameter order.
// Every other parameter stores the binder covariantly, so each earlier operand offered a region the
// old binding is no longer than; the relation `old: new` (`admitsRegion`) then carries each of them
// to the new binding by subtyping, exactly as when this operand comes first. A written binder, a
// call loan still being inferred and a binder a requirement row observes never move; the call
// proves its bounds again on the final bindings.
effect fn reboundInvariantBinders(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  parameter: &Shared<Type>, actual: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, caller: &DeclarationId, variables: &[Shared<DeclarationId>], bindings: &[Binding],
  explicit: &[usize], constraints: &[Constraint], span: Span,
) -> Option<ReboundArgument>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut types = List<usize>.make()
  let mut named = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(parameter, fresh, &mut types, &mut named, &mut rows)
  let parameters = run signatureParameterTypes(signature)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let mut current = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut current, Shared<Type>.clone(parameter))
  let mut moved = List<usize>.make()
  let mut trial = List<Binding>.make()
  let mut at = usize.ZERO
  while at < bindings.length {
    let ordinal = bindings[at].ordinal
    let own = Shared<DeclarationId>.with<bool>(&bindings[at].declaration, fn(declared: &DeclarationId) -> bool {
      return DeclarationId.equals(declared, fresh)
    })
    let mut candidate = own && containsOrdinal(&named, ordinal) && !fixedOrdinal(explicit, ordinal)
    if candidate {
      candidate = match &bindings[at].value {
        Argument.Lifetime {value} => !variableCallLoan(&value, variables)
        _ => false
      }
    }
    if candidate {
      candidate = !run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        List<Shared<Type>>.asSlice(&current), fresh, ordinal, span)
    }
    if candidate {
      let mut invariant = usize.ZERO
      let mut position = usize.ZERO
      while position < listed.length {
        let mut single = List<Shared<Type>>.make()
        run List<Shared<Type>>.append(&mut single, Shared<Type>.clone(&listed[position]))
        if !run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          List<Shared<Type>>.asSlice(&single), fresh, ordinal, span) { invariant = invariant + usize.ONE }
        position = position + usize.ONE
      }
      candidate = invariant == usize.ONE
    }
    if candidate {
      run List<usize>.append(&mut moved, ordinal)
    } else {
      run List<Binding>.append(&mut trial, Binding {declaration: Shared<DeclarationId>.clone(&bindings[at].declaration),
        ordinal: ordinal, value: Argument.copy(&bindings[at].value)})
    }
    at = at + usize.ONE
  }
  if List<usize>.length(&moved) == usize.ZERO { return Option<ReboundArgument>.none() }
  let unified = match move run Type.unify(parameter, actual, variables, Comparison.Exact, &mut trial) {
    Unification.Unified => true
    _ => false
  }
  if !unified { return Option<ReboundArgument>.none() }
  // Keep the original order so `rowObservesShortenedBinder` compares each binder with itself.
  let mut rebound = List<Binding>.make()
  let mut relations = List<RegionPair>.make()
  at = usize.ZERO
  while at < bindings.length {
    let mut value = Argument.copy(&bindings[at].value)
    if containsOrdinal(&moved, bindings[at].ordinal) && Shared<DeclarationId>.with<bool>(&bindings[at].declaration,
      fn(declared: &DeclarationId) -> bool { return DeclarationId.equals(declared, fresh) }) {
      let old = match &bindings[at].value {
        Argument.Lifetime {value: region} => Shared<Lifetime>.clone(&region)
        _ => { return Option<ReboundArgument>.none() }
      }
      let fixed = match move bindingArgument(List<Binding>.asSlice(&trial), fresh, bindings[at].ordinal) {
        Option<Argument>.Some {value: Argument.Lifetime {value: region}} => move region
        _ => { return Option<ReboundArgument>.none() }
      }
      if !Lifetime.equalsShared(&old, &fixed) && !run admitsRegion(&old, &fixed, caller, constraints, &mut relations) {
        return Option<ReboundArgument>.none()
      }
      value = Argument.Lifetime {value: move fixed}
    }
    run List<Binding>.append(&mut rebound, Binding {declaration: Shared<DeclarationId>.clone(&bindings[at].declaration),
      ordinal: bindings[at].ordinal, value: move value})
    at = at + usize.ONE
  }
  let solved = List<Binding>.asSlice(&trial)
  at = usize.ZERO
  while at < solved.length {
    let declared = DeclarationId.copyShared(&solved[at].declaration)
    let known = match move bindingArgument(bindings, &declared, solved[at].ordinal) { Option<Argument>.Some {..} => true _ => false }
    if !known {
      run List<Binding>.append(&mut rebound, Binding {declaration: Shared<DeclarationId>.clone(&solved[at].declaration),
        ordinal: solved[at].ordinal, value: Argument.copy(&solved[at].value)})
    }
    at = at + usize.ONE
  }
  if run rowObservesShortenedBinder(signature, fresh, bindings, List<Binding>.asSlice(&rebound)) {
    return Option<ReboundArgument>.none()
  }
  return Option<ReboundArgument>.some(ReboundArgument {bindings: move rebound, relations: move relations})
}

// Direct calls and qualified operations use the same region inference and proof retention.
effect fn matchArgumentRegions(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, caller: &DeclarationId, parameter: &Shared<Type>, pattern: &Shared<Type>,
  actual: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  variables: &[Shared<DeclarationId>], inferred: &mut List<Binding>, explicit: &[usize],
  constraints: &[Constraint], nodes: &[BodyNode], argumentSpan: Span, callSpan: Span,
  inferredRepresentation: bool,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut failed = run matchCallArgument(&resolver.*, module, callSpan, parameter, actual, variables, &mut inferred.*, constraints, RejectionCode.TypeMismatch)
  let mismatch = match &failed {
    Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value, fn(rejection: &Rejection) -> bool {
      return valueMismatchReason(rejection.code)
    })
    Option<Shared<Rejection>>.None => false
  }
  // An exact mismatch leaves the bindings unchanged, so the shortened loan is matched against the
  // same inference state.
  if mismatch && !inferredRepresentation {
    let shortened = run shortenedLoan(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, actual, callSpan)
    if let Option<Shared<Type>>.Some {value: weaker} = move shortened {
      let again = run matchCallArgument(&resolver.*, module, callSpan, parameter, &weaker, variables, &mut inferred.*, constraints, RejectionCode.TypeMismatch)
      if let Option<Shared<Rejection>>.None = move again { failed = Option<Shared<Rejection>>.none() }
    }
  }
  // A remaining mismatch whose only difference is a region its binder already fixed relates the
  // two regions: the operand meets the binder's region, and each caller-local relation typing
  // cannot prove stays open on the body.
  let mut relatable = false
  if let Option<Shared<Rejection>>.Some {value} = &failed {
    relatable = Shared<Rejection>.with<bool>(&value, fn(rejection: &Rejection) -> bool {
      return valueMismatchReason(rejection.code)
    })
  }
  if relatable && !inferredRepresentation {
    let related = run relatedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      parameter, pattern, actual, fresh, caller, variables, List<Binding>.asSlice(&inferred.*), explicit, constraints,
      callSpan,
    )
    if let Option<RelatedArgument>.Some {value: candidate} = move related {
      // Inferred static evidence is a maximum, not a fixed promise, and a caller lifetime an earlier
      // operand fixed is one too: the binder can meet a later local operand. Try the existing
      // variance-and-bound-checked shortening before an admission could hide the mismatch.
      // Trial bindings keep a failed attempt from changing later admission paths.
      let pairs = List<RegionPair>.asSlice(&candidate.relations)
      if hasInferredStaticRelation(pairs) || relatesLocalToDeclared(pairs, nodes, caller) {
        let mut trial = run copyBindings(List<Binding>.asSlice(&inferred.*))
        let mut shortened = false
        if hasInferredStaticRelation(pairs) {
          let count = run shortenedBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, actual,
            signature, fresh, variables, &mut trial, explicit, callSpan)
          shortened = count != usize.ZERO
        } else {
          shortened = run metBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, pairs, nodes, signature, fresh,
            &mut trial, explicit, caller, callSpan)
        }
        if shortened {
          let admitted = run matchCallArgument(&resolver.*, module, callSpan, parameter, actual, variables,
            &mut trial, constraints, RejectionCode.TypeMismatch)
          // A caller lifetime a requirement row names stays fixed: the row's provider observes it.
          let observed = !hasInferredStaticRelation(pairs) && run rowObservesShortenedBinder(signature, fresh,
            List<Binding>.asSlice(&inferred.*), List<Binding>.asSlice(&trial))
          let fits = match &admitted { Option<Shared<Rejection>>.None => true _ => false }
          if fits && !observed {
            if relationsAdmitted(&resolver.*, pairs) {
              inferred.* = move trial
              return Option<Shared<Rejection>>.none()
            }
          } else if !fits && !observed && !hasInferredStaticRelation(pairs) {
            // The operand's region is one constituent of the new meet and reaches it by subtyping;
            // the relation it needs is to the shortened binder, never to the caller lifetime.
            let met = run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, actual,
              fresh, caller, variables, List<Binding>.asSlice(&trial), explicit, constraints, callSpan)
            if let Option<RelatedArgument>.Some {value: meeting} = move met {
              let committed = run matchCallArgument(&resolver.*, module, callSpan, parameter, &meeting.ty, variables, &mut trial,
                constraints, RejectionCode.TypeMismatch)
              if let Option<Shared<Rejection>>.None = move committed {
                if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&meeting.relations)) {
                  inferred.* = move trial
                  return Option<Shared<Rejection>>.none()
                }
              }
            }
          }
        }
      }
      let again = run matchCallArgument(&resolver.*, module, callSpan, parameter, &candidate.ty, variables, &mut inferred.*, constraints, RejectionCode.TypeMismatch)
      if let Option<Shared<Rejection>>.None = move again {
        if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&candidate.relations)) {
          failed = Option<Shared<Rejection>>.none()
        }
      }
    }
  }
  // A remaining mismatch may be a region meeting a binder that earlier evidence fixed; the binder
  // shortens to the offered region or to the meet of both when nothing observes it invariantly.
  let mut shortenable = false
  if let Option<Shared<Rejection>>.Some {value} = &failed {
    shortenable = !inferredRepresentation && Shared<Rejection>.with<bool>(&value, fn(rejection: &Rejection) -> bool {
      return valueMismatchReason(rejection.code)
    })
  }
  let mut didShorten = false
  if shortenable {
    let count = run shortenedBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, actual,
      signature, fresh, variables, &mut inferred.*, explicit, callSpan)
    didShorten = count != usize.ZERO
  }
  if didShorten {
    let again = run matchCallArgument(&resolver.*, module, callSpan, parameter, actual, variables, &mut inferred.*, constraints, RejectionCode.TypeMismatch)
    if let Option<Shared<Rejection>>.None = move again {
      failed = Option<Shared<Rejection>>.none()
    } else {
      // An operand whose region is one constituent of the new meet reaches it by subtyping.
      let subtyped = run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, actual,
        fresh, caller, variables, List<Binding>.asSlice(&inferred.*), explicit, constraints, callSpan)
      if let Option<RelatedArgument>.Some {value: candidate} = move subtyped {
        let committed = run matchCallArgument(&resolver.*, module, callSpan, parameter, &candidate.ty, variables, &mut inferred.*, constraints, RejectionCode.TypeMismatch)
        if let Option<Shared<Rejection>>.None = move committed {
          if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&candidate.relations)) {
            failed = Option<Shared<Rejection>>.none()
          }
        }
      }
    }
  }
  // A remaining mismatch may be the one invariant position of a binder an earlier operand fixed
  // covariantly; this operand then fixes it, and the earlier operands relate to it.
  let mut reboundable = false
  if let Option<Shared<Rejection>>.Some {value} = &failed {
    reboundable = !inferredRepresentation && Shared<Rejection>.with<bool>(&value, fn(rejection: &Rejection) -> bool {
      return valueMismatchReason(rejection.code)
    })
  }
  if reboundable {
    let rebound = run reboundInvariantBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, actual,
      signature, fresh, caller, variables, List<Binding>.asSlice(&inferred.*), explicit, constraints, callSpan)
    if let Option<ReboundArgument>.Some {value: ReboundArgument {bindings: candidateBindings, relations: candidateRelations}} = move rebound {
      let mut trial = move candidateBindings
      let admitted = run matchCallArgument(&resolver.*, module, callSpan, parameter, actual, variables, &mut trial,
        constraints, RejectionCode.TypeMismatch)
      if let Option<Shared<Rejection>>.None = move admitted {
        if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&candidateRelations)) {
          inferred.* = move trial
          failed = Option<Shared<Rejection>>.none()
        }
      }
    }
  }
  // A failed lifetime requirement belongs to the supplied source boundary (LIFE-002),
  // rather than the whole call's type-mismatch family. Successful inference stays untouched.
  if let Option<Shared<Rejection>>.Some {value} = &failed {
    if !inferredRepresentation && Shared<Rejection>.with<bool>(&value, fn(rejection: &Rejection) -> bool {
      return valueMismatchReason(rejection.code)
    }) {
      let wanted = run Type.applyBindings(parameter, List<Binding>.asSlice(&inferred.*), true)
      // Once all inference and subtyping attempts finish, a rigid static reference
      // parameter owes an actual validity proof, including for an aliased call result.
      let staticReference = Shared<Type>.with<bool>(&wanted, fn(value: &Type) -> bool {
        if let Type.Reference {lifetime, ..} = &value.* { return Shared<Lifetime>.with<bool>(&lifetime, staticLifetime) }
        return false
      })
      let validity = run failedViewValidity(actual, &wanted, constraints, caller, staticReference)
      if let Option<Shared<Lifetime>>.Some {..} = move validity {
        // Inside a body the call's contract relates the view's region to the parameter's, and the
        // body's region check reports the borrow that cannot outlive it.
        if List<BodyFrame>.length(&resolver.bodies) != usize.ZERO { return Option<Shared<Rejection>>.none() }
        return Option<Shared<Rejection>>.some(run reject(&resolver.*, module,
          RejectionCode.UnsatisfiedLifetimeBound, argumentSpan))
      }
    }
  }
  return move failed
}

effect fn checkInferredCallArgument<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  argument: HirId, parameter: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>, captured: &[Shared<Type>],
  fresh: &DeclarationId, variables: &[Shared<DeclarationId>], explicit: &[usize],
  explicitSyntax: bool, inferred: &mut List<Binding>,
  call: HirId, callSpan: Span, constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, argument)
  let sliceParameter = match move Type.sliceElement(parameter) {
    Option<Shared<Type>>.Some {..} => true
    Option<Shared<Type>>.None => false
  }
  let pattern = run callArgumentType(parameter, signature, fresh, List<Binding>.asSlice(&inferred.*), caller, call, false, &run cursorAnchor(cursor),
  )
  let ordinal = Shared<Type>.with<usize>(parameter,
    fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, fresh) },
  )
  let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount,
  )
  let callableParameterStart = Shared<Result<Answer, NoRejection>>.with<usize>(
    signature,
    signatureCallableParameterStart,
  )
  let sourceInference = sourceCallableInference(
    signature,
    fresh,
    explicit,
    explicitSyntax,
    callableParameterStart,
  )
  let mut inferredRepresentation = false
  if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) {
    let mut at = usize.ZERO
    while at < boundCount {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) },
      )
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, ..}} = move bound {
        if run Type.equalsShared(parameter, &representation) { inferredRepresentation = true }
      }
      at = at + usize.ONE
    }
  }
  let mut elements = Range.empty()
  let mut fields = List<Shared<Type>>.make()
  let mut aggregate = false
  let mut array = false
  let mut repeated = Option<BodyNodeId>.none()
  if run typeMentionsOwner(parameter, fresh) {
    match run bodyNode(&resolver.source, cursor, argument) {
      Node.ArrayExpression {elements: values} => {
        if let Option<ArrayShape>.Some {value} = move Type.arrayShape(&pattern) {
          if value.length != values.length { return run bodyRejection(&resolver.*, module, RejectionCode.ArrayLengthMismatch, span) }
          elements = values
          aggregate = true
          array = true
          fields = run repeatedTypes(&value.element, elements.length)
        }
      }
      Node.ArrayRepeatExpression {value: operand, count} => {
        if let Option<ArrayShape>.Some {value: shape} = move Type.arrayShape(&pattern) {
          let length = match move run arrayRepeatCount(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, &statementScope.*, calls, count) {
            Result<usize, Shared<Rejection>>.Success {value} => value
            Result<usize, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
          }
          if shape.length != length { return run bodyRejection(&resolver.*, module, RejectionCode.ArrayLengthMismatch, span) }
          let value = match move run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
            module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
            operand, &shape.element, signature, captured, fresh, variables, explicit, explicitSyntax,
            &mut inferred.*, call, callSpan, constraints, contractBody, staticBody, unsafeAllowed) {
            Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
          }
          let element = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &value) {
            Option<Shared<Type>>.Some {value: element} => move element
            Option<Shared<Type>>.None => { fail RevisionMismatch {} }
          }
          if length > usize.ONE {
            let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, constraints, span) {
              Result<bool, Shared<Rejection>>.Success {value: accepted} => accepted
              Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
            }
            if !copied { return run bodyRejection(&resolver.*, module, RejectionCode.MissingConformance, run bodySpan(&resolver.source, cursor, operand)) }
          }
          let ty = run Types.intern(Type.Array {element: move element, extent: run Type.extentText(length)})
          let id = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
          run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, argument, span),
            kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.ArrayRepeat {value: value, count: length}}})
          repeated = Option<BodyNodeId>.some(id)
        }
      }
      Node.TupleExpression {elements: values} => {
        // Only a named tuple pattern supplies element context; otherwise the literal is anonymous.
        if Shared<Type>.with<OwnerKind>(&pattern, nominalKind) == OwnerKind.Tuple {
          let queried = run callTupleFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &pattern, span,
          )
          fields = match move queried {
            Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
            Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
          }
          if List<Shared<Type>>.length(&fields) != values.length {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(run tupleArityRejection(module, span, &pattern,
              List<Shared<Type>>.length(&fields), values.length))
          }
          elements = values
          aggregate = true
        }
      }
      _ => ()
    }
  }
  let mut node = BodyNodeId {index: usize.ZERO}
  if let Option<BodyNodeId>.Some {value} = move repeated {
    node = value
  } else if aggregate {
    if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    let mut operands = List<BodyAggregateField>.make()
    let mut elementType = Option<Shared<Type>>.none()
    let mut at = usize.ZERO
    while at < elements.length {
      let child = run bodyChild(&resolver.source, cursor, elements, at)
      let patterns = List<Shared<Type>>.asSlice(&fields)
      let field = Shared<Type>.clone(&patterns[at])
      let checked = run checkInferredCallArgument(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        child, &field, signature, captured, fresh, variables, explicit, explicitSyntax,
        &mut inferred.*, call, callSpan, constraints, contractBody, false, unsafeAllowed,
      )
      let operand = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      if at == usize.ZERO { elementType = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand) }
      run List<BodyAggregateField>.append(&mut operands, BodyAggregateField {index: at, value: operand},
      )
      at = at + usize.ONE
    }
    let mut actual = run callArgumentType(parameter, signature, fresh, List<Binding>.asSlice(&inferred.*), caller, call, false, &run cursorAnchor(cursor),
    )
    if array {
      if let Option<Shared<Type>>.Some {value} = move elementType {
        actual = run Types.intern(Type.Array {element: move value, extent: run Type.extentText(elements.length)},
        )
      }
    }
    if run typeMentionsOwner(&actual, fresh) { return run bodyRejection(&resolver.*, module, RejectionCode.TypeArgumentInference, callSpan) }
    node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, argument, span),
      kind: BodyNodeKind.Expression {ty: move actual, form: BodyExpression.Aggregate {fields: move operands, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()},
        },
    },
    )
  } else {
    let mut context = run callArgumentContext(parameter, signature, fresh, List<Binding>.asSlice(&inferred.*), caller, call, &run cursorAnchor(cursor),
    )
    // Each inferred representation is independently inferred from its operand. A prior F
    // binding must not contextualize another closure as that exact declaration before matching.
    // A named function value still learns its open binders from the bound's promised contract
    // from positions already determined; the bound itself is proved after matching.
    let mut promised = Option<NamedCallableEvidence>.none()
    if inferredRepresentation {
      context = Option<Shared<Type>>.none()
      promised = run representationPromise(parameter, signature, fresh, List<Binding>.asSlice(&inferred.*), caller, call, &run cursorAnchor(cursor),
        explicitSyntax, callSpan)
    }
    if privateOriginPhase(&resolver.*).phase == usize.ONE && pendingOriginContext(&context) {
      context = Option<Shared<Type>>.none()
    }
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(parameter) {
      context = Option<Shared<Type>>.none()
    }
    if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, argument) {
      context = run rootCallBorrowContext(&context, caller, call, &run cursorAnchor(cursor), parameterBinder(parameter, fresh))
    } else {
      let mut types = List<usize>.make()
      let mut lifetimes = List<usize>.make()
      let mut rows = List<usize>.make()
      run Type.collectOwned(parameter, fresh, &mut types, &mut lifetimes, &mut rows)
      if List<usize>.length(&lifetimes) > usize.ZERO { context = Option<Shared<Type>>.none() }
      context = run referenceArgumentContext(&resolver.source, cursor, argument, &context, caller)
    }
    let mut sliceBorrow = false
    if sliceParameter || (run inferredReferentLifetimes(parameter, fresh)) {
      if let Node.BorrowExpression {access, operand} = run bodyNode(&resolver.source, cursor, argument,
      ) {
        // A concrete slice element types a borrowed array literal; an inferred element does not.
        // Other loans keep the call-region reference context but not its referent stand-ins.
        let mut elementContext = Option<Shared<Type>>.none()
        if sliceParameter {
          elementContext = run concreteSliceContext(parameter, fresh)
        } else if let Option<Shared<Type>>.Some {value} = &context {
          elementContext = Option<Shared<Type>>.some(Shared<Type>.clone(&value))
        }
        let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
          &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, argument, access, operand, &elementContext, RejectionCode.TypeMismatch, sliceParameter,
          !sliceParameter && Shared<Type>.with<bool>(parameter, isReferenceType), run anchoredNode(cursor, call), parameterBinder(parameter, fresh), constraints, contractBody, staticBody, unsafeAllowed,
        )
        let borrowed = match move checked {
          Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
          Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
          }
        }
        node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, argument, span),
          kind: BodyNodeKind.Expression {ty: move borrowed.ty,
            form: BodyExpression.Borrow {access: access, value: borrowed.value},
            },
        },
        )
        sliceBorrow = true
      }
    }
    // `&x` for a `&T` parameter whose T is still open borrows `x` itself, so a slice `x` gives
    // `& &[E]` and T becomes the slice, as for any other value. The ordinary path would reborrow
    // the slice, which no `&T` accepts.
    let openContext = match &context { Option<Shared<Type>>.None => true _ => false }
    if !sliceBorrow && !sliceParameter && openContext && Shared<Type>.with<bool>(parameter, fn(value: &Type) -> bool {
      return freshReferent(value, fresh)
    }) {
      if let Node.BorrowExpression {access, operand} = run bodyNode(&resolver.source, cursor, argument) {
        let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
          &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, argument, access, operand, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
          false, true, run anchoredNode(cursor, argument), usize.MAX, constraints, contractBody, staticBody, unsafeAllowed,
        )
        let borrowed = match move checked {
          Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
          Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
          }
        }
        let finished = run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
          &mut nodes.*, argument, span, move borrowed.ty, BodyExpression.Borrow {access: access, value: borrowed.value},
          false, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, contractBody, staticBody)
        node = match move finished {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
          }
        }
        sliceBorrow = true
      }
    }
    if !sliceBorrow {
      let mut namedValue = Option<Result<BodyNodeId, Shared<Rejection>>>.none()
      if let Option<NamedCallableEvidence>.Some {..} = &promised {
        namedValue = run checkNamedValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
          argument, &context, RejectionCode.TypeMismatch, &promised, constraints, contractBody, staticBody, unsafeAllowed)
      }
      let checked = match move namedValue {
        Option<Result<BodyNodeId, Shared<Rejection>>>.Some {value: valueResult} => move valueResult
        Option<Result<BodyNodeId, Shared<Rejection>>>.None => run checkExpression(&mut resolver.*, &mut owner.*,
          &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, argument, &context, RejectionCode.TypeMismatch, constraints, contractBody, staticBody, unsafeAllowed)
      }
      node = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
    }
  }
  // Raw `mut fn` and `mut Effect` parameters, and locals holding an exclusive Effect or callable
  // value, lend their environment to a raw mutable or take-once parameter: a once parameter
  // promises at most one use and consumes only the exclusive view (CALLABLE-002,
  // EFFECT-OWN-002). Authored constrained F arguments still transfer ownership normally.
  if inferredRepresentation && ordinal >= callableParameterStart {
    let mut mutableTarget = false
    let mut boundAt = usize.ZERO
    while boundAt < boundCount {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, boundAt) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract}} = move bound {
        if run Type.equalsShared(parameter, &representation) {
          let targetMode = Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
          mutableTarget = targetMode == CallableMode.Mutable || targetMode == CallableMode.Once
        }
      }
      boundAt = boundAt + usize.ONE
    }
    if mutableTarget && run lendableExclusivePlace(&resolver.source, cursor,
      List<BodyLocal>.asSlice(&statementScope.locals.*), List<BodyNode>.asSlice(&nodes.*), node, caller) {
      if !mutablePlace(List<BodyNode>.asSlice(&nodes.*), List<BodyLocal>.asSlice(&statementScope.locals.*), node) {
        return run bodyRejection(&resolver.*, module, RejectionCode.ExclusiveBorrowRequiresMutable, span)
      }
      let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
        Option<Shared<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} }
      }
      let contract = match move run valueCallableContract(&actual, constraints) {
        Option<Shared<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} }
      }
      let reference = run Types.intern(Type.Reference {referent: move actual, access: Access.Mutable,
        lifetime: run Shared<Lifetime>.make(run localRegion(cursor, caller, call, usize.MAX))})
      let borrowed = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
      run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, argument, span),
        kind: BodyNodeKind.Expression {ty: run Type.callableView(move reference, move contract),
          form: BodyExpression.Borrow {access: Access.Mutable, value: node}}})
      node = borrowed
    }
  }
  // Fresh reference loans use the caller's call region for this inference transaction.
  // Slice reborrows already carry their source region and must retain it, including Static.
  if !sliceParameter {
    if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, argument) {
      let rejected = run contributeBorrowCallRegion(&mut resolver.*, module, &mut nodes.*, caller, node, call, callSpan, &run cursorAnchor(cursor),
        parameterBinder(parameter, fresh))
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
      }
    }
  }
  node = run sliceArgument(&mut nodes.*, node, parameter)
  node = run unionArgument(&mut nodes.*, node, parameter)
  node = run pointerArgument(&mut nodes.*, node, parameter, variables, List<Binding>.asSlice(&inferred.*),
  )
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, callSpan) }
  }
  let failed = run matchArgumentRegions(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, parameter, &pattern, &actual,
    signature, fresh, variables, &mut inferred.*, explicit, constraints, List<BodyNode>.asSlice(&nodes.*),
    span, callSpan, inferredRepresentation,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    if inferredRepresentation && Shared<Rejection>.with<bool>(&value, fn(rejection: &Rejection) -> bool {
      return valueMismatchReason(rejection.code)
    }) {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run callableArgumentFailure(&resolver.*, module, &value,
          &actual, parameter,
          constraints,
          true,
          sourceInference,
          span, callSpan,
        ),
      )
    }
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
  }
  // Infer representation signature evidence before later operands. Implicit representations
  // that cannot satisfy their promise fail specialization at the whole call. A representation
  // nested in an earlier reached contract follows it, since that contract's inference binds it.
  let mut reached = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut reached, Shared<Type>.clone(parameter))
  let mut boundAt = usize.ZERO
  while boundAt < boundCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, boundAt) },
    )
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract},
    } = move bound {
      if run reachesRepresentation(List<Shared<Type>>.asSlice(&reached), &representation, fresh) {
        run List<Shared<Type>>.append(&mut reached, Shared<Type>.clone(&contract))
        let representationOrdinal = Shared<Type>.with<usize>(
          &representation,
          fn(value: &Type) -> usize {
            return Type.parameterOrdinalOf(value, fresh)
          },
        )
        let inferRepresentation = representationOrdinal != usize.MAX && !fixedOrdinal(explicit, representationOrdinal)
        let sourceRepresentation = run Type.applyBindings(
          &representation,
          List<Binding>.asSlice(&inferred.*),
          true,
        )
        let rejected = run inferCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, fresh, constraints,
          &mut inferred.*, &representation, &contract, span,
        )
        if let Option<Shared<Rejection>>.Some {value} = move rejected {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(run callableArgumentFailure(
              &resolver.*,
              module,
              &value,
              &sourceRepresentation, &contract,
              constraints,
              inferRepresentation,
              sourceInference,
              span,
              callSpan,
            ),
          )
        }
        let applied = run Type.applyBindings(&contract, List<Binding>.asSlice(&inferred.*), true)
        let mut incompatible = Option<Shared<Rejection>>.none()
        if !Shared<Type>.with<bool>(&sourceRepresentation, genericSectionType) || !run sectionContextUndetermined(&applied, fresh) {
          let mut strict = Option<RegionDeferral>.none()
          incompatible = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints, &sourceRepresentation, &applied, span,
            &mut strict, RegionProof.RegionCheck)
        }
        let inferredEnvironment = Shared<Type>.with<bool>(&contract, fn(value: &Type) -> bool { return environmentBinder(value, fresh) })
        let mismatched = match &incompatible {
          Option<Shared<Rejection>>.Some {..} => true
          Option<Shared<Rejection>>.None => false
        }
        if mismatched && inferredEnvironment {
          let related = run relatedEffectEnvironment(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints,
            &sourceRepresentation, &applied, caller, span)
          if let Option<List<RegionPair>>.Some {value: relations} = move related {
            if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&relations)) {
              incompatible = Option<Shared<Rejection>>.none()
            }
          }
          let unrelated = match &incompatible {
            Option<Shared<Rejection>>.Some {..} => true
            Option<Shared<Rejection>>.None => false
          }
          if unrelated {
            if run shortenedEnvironmentBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, &contract,
              &sourceRepresentation, signature, captured, fresh, variables, &mut inferred.*, explicit, constraints, span) {
              let shortened = run Type.applyBindings(&contract, List<Binding>.asSlice(&inferred.*), true)
              let mut strict = Option<RegionDeferral>.none()
              incompatible = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, constraints,
                &sourceRepresentation, &shortened, span, &mut strict, RegionProof.RegionCheck)
            }
          }
        }
        if let Option<Shared<Rejection>>.Some {value} = move incompatible {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(run callableArgumentFailure(
              &resolver.*,
              module,
              &value,
              &sourceRepresentation, &contract,
              constraints,
              inferRepresentation,
              sourceInference,
              span,
              callSpan,
            ),
          )
        }
      }
    }
    boundAt = boundAt + usize.ONE
  }
  // Exact callable representations own their environment. An affine place cannot be
  // copied into a by-value argument; fresh values and explicit moves are already transfers.
  let callable = run callableArgumentContract(&actual, constraints)
  if let Option<Shared<Type>>.Some {..} = move callable {
    let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &actual, constraints, span)
    let copy = match move copied {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    if !copy {
      if Shared<Type>.with<bool>(&actual, fn(value: &Type) -> bool {
        return match &value.* { Type.Callable {..} => true _ => false }
      }) { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      let transfer = run consumption(&resolver.source, cursor, List<BodyNode>.asSlice(&nodes.*), node)
      let mut code = Option<RejectionCode>.none()
      match move transfer {
        Consumption.Rvalue => ()
        Consumption.Borrowed => { code = Option<RejectionCode>.some(RejectionCode.BorrowedExtraction) }
        Consumption.Boundary => { code = Option<RejectionCode>.some(RejectionCode.ExtractionBoundary) }
        Consumption.Escape {..} => { code = Option<RejectionCode>.some(RejectionCode.MatchBorrowEscape) }
        Consumption.Place {..} => {
          if Shared<Type>.with<bool>(&actual, unconsumedArgument) {
            // The bootstrap does not consume an Effect or callable value whose run access is not
            // `once` when it is passed by value; native has no such non-consuming argument yet.
            code = Option<RejectionCode>.some(RejectionCode.Unsupported)
          } else {
            code = Option<RejectionCode>.some(RejectionCode.ExplicitMoveRequired)
          }
        }
        Consumption.PlaceBinding => { code = Option<RejectionCode>.some(RejectionCode.Unsupported) }
      }
      if let Option<RejectionCode>.Some {value} = move code {
        if value == RejectionCode.ExplicitMoveRequired {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(run explicitMoveRejection(module, span, &actual))
        }
        return run bodyRejection(&resolver.*, module, value, span)
      }
    }
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
}

// An Effect or callable value (not a reference to one) that the bootstrap may pass by value without
// consuming its place: one whose run access is shared or mutable (`argumentConsumes`), or the Effect
// an anonymous `effect fn` value's invocation produced. Native types the latter at its contract's
// promised access, while the bootstrap derives it from the retained environment (COMPOSE-001).
fn unconsumedArgument(value: &Type) -> bool {
  return match &value.* {
    Type.Reference {..} => false
    Type.Effect {..} => true
    _ => callableInvocationMode(value) != CallableMode.Once
  }
}

// A place the bootstrap lends rather than consumes when it is passed by value: a source-written
// `mut fn` or `mut Effect` parameter, or a local holding an exclusive Effect or callable value.
// Forwarding it needs a retained reborrow, not a copy of its exact F. Owned generic values and
// explicit moves are not views.
effect fn lendableExclusivePlace(source: &SourceIndex, cursor: &AuthoredCursor,
  locals: &[BodyLocal], nodes: &[BodyNode], node: BodyNodeId, caller: &DeclarationId) -> bool
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if run plainMutableCallableParameter(source, cursor, locals, nodes, node, caller) { return true }
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Local {..}} = &nodes[node.index].kind {
    let ordinal = Shared<Type>.with<usize>(&ty,
      fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, caller) })
    if ordinal != usize.MAX { return false }
    return Shared<Type>.with<bool>(&ty, exclusiveValue)
  }
  return false
}

fn exclusiveValue(value: &Type) -> bool {
  return match &value.* {
    Type.Reference {..} => false
    _ => callableInvocationMode(value) == CallableMode.Mutable
  }
}

effect fn plainMutableCallableParameter(source: &SourceIndex, cursor: &AuthoredCursor,
  locals: &[BodyLocal], nodes: &[BodyNode], node: BodyNodeId, caller: &DeclarationId) -> bool
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} = &nodes[node.index].kind {
    let ordinal = Shared<Type>.with<usize>(&ty,
      fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, caller) })
    if ordinal == usize.MAX { return false }
    if let Node.Parameter {annotation, ..} = run bodyNode(source, cursor, run originSyntax(cursor, locals[local.index].origin)) {
      match run bodyNode(source, cursor, annotation) {
        Node.CallableType {mode, ..} => { return mode == CallableMode.Mutable }
        Node.AppliedType {target, ..} => {
          if let Node.NamedType {hasMode, mode, ..} = run bodyNode(source, cursor, target) {
            return hasMode && mode == CallableMode.Mutable
          }
        }
        _ => ()
      }
    }
  }
  return false
}

// Generated raw representation slots retain their source role through aliases and captures.
// Authored F slots remain owners even when their callable bounds are nonshared.
effect fn unknownOwnedCallableReturn(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, nodes: &[BodyNode], node: BodyNodeId,
  span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let ty = match move bodyExpressionType(nodes, &node) {
    Option<Shared<Type>>.Some {value} => move value _ => { return Option<Shared<Rejection>>.none() }
  }
  return run unknownOwnedCallableTypeReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ty, span)
}

effect fn unknownOwnedCallableTypeReturn(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, ty: &Shared<Type>, span: Span)
  -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run Type.copy(ty)
  if let Type.CallableView {representation, ..} = &copied {
    return run unknownOwnedCallableTypeReturn(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &representation, span)
  }
  if let Type.Parameter {declaration, ordinal: parameterOrdinal} = move copied {
    // Function and ordinary anonymous headers introduce raw representation slots. Outer
    // authored parameters retain their original owner and never acquire the anonymous role.
    let kind = DeclarationId.kind(&declaration)
    if kind != OwnerKind.Function && kind != OwnerKind.Anonymous { return Option<Shared<Rejection>>.none() }
    let originalModule = DeclarationId.moduleId(&declaration)
    let sharedDeclaration = run Shared<DeclarationId>.make(DeclarationId.copy(&declaration))
    let ordinal = match move run ordinalOfIdentity(&mut resolver.*, originalModule, &sharedDeclaration) {
      Option<usize>.Some {value} => value
      _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span)) }
    }
    let originalModuleOrdinal = knownModuleOrdinal(&resolver.*, originalModule)
    let declarationAccess121Request = Key {
      family: Family.Signature, module: originalModuleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false}
    let declarationAccess121 = run internDeclaration(&mut resolver.*, declarationAccess121Request)
    let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess121, span)
    let failed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move failed {
      return Option<Shared<Rejection>>.some(move value)
    }
    let start = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureCallableParameterStart)
    if parameterOrdinal < start { return Option<Shared<Rejection>>.none() }
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
    let mut at = usize.ZERO
    while at < count {
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
        fn(value: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(value, at) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: slot, contract}} = move selected {
        let originalSlot = Shared<Type>.with<usize>(&slot,
          fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, &declaration) })
        if originalSlot == parameterOrdinal {
          let rawOwnedCallable = Shared<Type>.with<bool>(&contract, fn(value: &Type) -> bool {
            return match &value.* { Type.Callable {mode, ..} => mode != CallableMode.Shared _ => false }
          })
          if rawOwnedCallable {
            return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnknownOwnedCallableReturn, span))
          }
          return Option<Shared<Rejection>>.none()
        }
      }
      at = at + usize.ONE
    }
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Option<Shared<Rejection>>.none()
}

// Whether an unapplied Effect contract's environment is a lifetime binder of the inference owner.
// Only such an environment was fixed by evidence; a written lifetime is a contract.
fn environmentBinder(contract: &Type, fresh: &DeclarationId) -> bool {
  if let Option<Shared<Intersection>>.Some {value: environment} = move Type.retainedEnvironment(contract) {
    return Shared<Intersection>.with<bool>(&environment, fn(value: &Intersection) -> bool { return binderMember(value, fresh) })
  }
  return false
}

fn binderMember(value: &Intersection, fresh: &DeclarationId) -> bool {
  let members = List<LifetimeMember>.asSlice(&value.members)
  let mut at = usize.ZERO
  while at < members.length {
    let ordinal = Shared<Lifetime>.with<usize>(&members[at].region, fn(region: &Lifetime) -> usize { return lifetimeOrdinalOf(region, fresh) })
    if ordinal != usize.MAX { return true }
    at = at + usize.ONE
  }
  return false
}

// An Effect environment binder fixed by earlier evidence, such as a section's captured provider
// loan or a 'static callable, meets an operand retaining a distinct caller-local region. The
// environments relate (`environmentRelations`) when the bound holds once each such relation is a
// premise; None when the environment is not the only mismatch.
effect fn relatedEffectEnvironment(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, constraints: &[Constraint], source: &Shared<Type>,
  wanted: &Shared<Type>, caller: &DeclarationId, span: Span) -> Option<List<RegionPair>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let offered = match move run valueCallableContract(source, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<List<RegionPair>>.none() }
  }
  let retained = match move run Type.copy(&offered) {
    Type.Effect {environment, ..} => move environment
    _ => { return Option<List<RegionPair>>.none() }
  }
  let localRetained = Shared<Intersection>.with<bool>(&retained, fn(value: &Intersection) -> bool {
    let members = List<LifetimeMember>.asSlice(&value.members)
    let mut at = usize.ZERO
    while at < members.length {
      if callerLocalRegion(&members[at].region, caller) { return true }
      at = at + usize.ONE
    }
    return false
  })
  if !localRetained { return Option<List<RegionPair>>.none() }
  let bound = match move run Type.copy(wanted) {
    Type.Effect {environment, ..} => move environment
    _ => { return Option<List<RegionPair>>.none() }
  }
  let mut relations = List<RegionPair>.make()
  run environmentRelations(&retained, &bound, caller, &mut relations)
  let mut premises = run copyConstraints(constraints)
  run appendRegionPremises(List<RegionPair>.asSlice(&relations), &mut premises)
  let mut strict = Option<RegionDeferral>.none()
  let failed = run proveCallableBound(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    List<Constraint>.asSlice(&premises), source, wanted, span, &mut strict, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {..} = move failed { return Option<List<RegionPair>>.none() }
  return Option<List<RegionPair>>.some(move relations)
}

// A callable or Effect environment binder that an earlier operand fixed, such as `'env` of
// `JsonObject.field` fixed by the section's `"x"` before its piped Effect is checked, or `'env` of
// `Execution.drive` fixed by a 'static `onComplete` before a caller's `onSuspend` bound is
// checked, shortens to the meet of that region and the regions the later operand retains: a bound
// is covariant in its environment, and the bootstrap's region inference chooses the shortest
// region (LIFE-002). As in `shortenedBinder`, a written binder or a
// binder holding a call loan never moves and every parameter, including the `captured` ones the
// section already bound, must store the binder covariantly, so each earlier operand still meets
// it; the caller then proves the bound again.
effect fn shortenedEnvironmentBinder(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  contract: &Shared<Type>, source: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  captured: &[Shared<Type>], fresh: &DeclarationId, variables: &[Shared<DeclarationId>], inferred: &mut List<Binding>,
  explicit: &[usize], constraints: &[Constraint], span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let promised = match move Shared<Type>.with<Option<Shared<Intersection>>>(contract, Type.retainedEnvironment) {
    Option<Shared<Intersection>>.Some {value} => move value
    Option<Shared<Intersection>>.None => { return false }
  }
  let promisedRegions = run callableEnvironmentRegions(&promised)
  let listedPromise = List<Shared<Lifetime>>.asSlice(&promisedRegions)
  if listedPromise.length != usize.ONE { return false }
  let ordinal = Shared<Lifetime>.with<usize>(&listedPromise[usize.ZERO],
    fn(region: &Lifetime) -> usize { return lifetimeOrdinalOf(region, fresh) })
  if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) { return false }
  let bindings = List<Binding>.asSlice(&inferred.*)
  let mut chosen = usize.MAX
  let mut at = usize.ZERO
  while at < bindings.length && chosen == usize.MAX {
    if bindings[at].ordinal == ordinal && Shared<DeclarationId>.with<bool>(&bindings[at].declaration,
      fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, fresh) }) {
      chosen = at
    }
    at = at + usize.ONE
  }
  if chosen == usize.MAX { return false }
  let earlier = match &bindings[chosen].value {
    Argument.Lifetime {value} => Shared<Lifetime>.clone(&value)
    _ => { return false }
  }
  drop bindings
  if variableCallLoan(&earlier, variables) { return false }
  let offered = match move run valueCallableContract(source, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return false }
  }
  let retained = match move Shared<Type>.with<Option<Shared<Intersection>>>(&offered, Type.retainedEnvironment) {
    Option<Shared<Intersection>>.Some {value} => move value
    Option<Shared<Intersection>>.None => { return false }
  }
  let mut members = run callableEnvironmentRegions(&retained)
  let offeredRegions = List<Shared<Lifetime>>.asSlice(&members)
  at = usize.ZERO
  while at < offeredRegions.length {
    if variableCallLoan(&offeredRegions[at], variables) { return false }
    at = at + usize.ONE
  }
  drop offeredRegions
  run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&earlier))
  let bounding = run withoutOutlivingParameters(List<Shared<Lifetime>>.asSlice(&members))
  let shorter = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&bounding))
  if Lifetime.equalsShared(&shorter, &earlier) { return false }
  let mut parameters = run signatureParameterTypes(signature)
  at = usize.ZERO
  while at < captured.length {
    run List<Shared<Type>>.append(&mut parameters, Shared<Type>.clone(&captured[at]))
    at = at + usize.ONE
  }
  if !run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<Shared<Type>>.asSlice(&parameters),
    fresh, ordinal, span) { return false }
  let replaced = List<Binding>.asMutSlice(&mut inferred.*)
  replaced[chosen].value = Argument.Lifetime {value: move shorter}
  return true
}

// Each admitted pair as the premise it stands for: the offered region outlives the region its
// boundary fixed. The body's region check proves the pair itself.
effect fn appendRegionPremises(pairs: &[RegionPair], premises: &mut List<Constraint>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < pairs.length {
    run List<Constraint>.append(&mut premises.*, Constraint.Outlives {longer: Shared<Lifetime>.clone(&pairs[at].offered),
      shorter: Shared<Lifetime>.clone(&pairs[at].wanted)})
    at = at + usize.ONE
  }
  return ()
}

// The relations of an operand environment `offered` admitted where `wanted` is bound: each
// caller-local region of `offered` that `wanted` does not name pairs with every region `wanted`
// names, or with 'static when it names none.
effect fn environmentRelations(offered: &Shared<Intersection>, wanted: &Shared<Intersection>, caller: &DeclarationId,
  relations: &mut List<RegionPair>) -> () ! OutOfMemoryError ? &mut Allocator {
  let offeredRegions = run callableEnvironmentRegions(offered)
  let mut wantedRegions = run callableEnvironmentRegions(wanted)
  let listed = List<Shared<Lifetime>>.asSlice(&offeredRegions)
  let mut covered = List<bool>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let bound = List<Shared<Lifetime>>.asSlice(&wantedRegions)
    let mut named = false
    let mut position = usize.ZERO
    while position < bound.length {
      if Lifetime.equalsShared(&listed[at], &bound[position]) { named = true }
      position = position + usize.ONE
    }
    run List<bool>.append(&mut covered, named || !callerLocalRegion(&listed[at], caller))
    at = at + usize.ONE
  }
  if List<Shared<Lifetime>>.length(&wantedRegions) == usize.ZERO {
    run List<Shared<Lifetime>>.append(&mut wantedRegions, run Shared<Lifetime>.make(Lifetime.Static))
  }
  let bound = List<Shared<Lifetime>>.asSlice(&wantedRegions)
  let skipped = List<bool>.asSlice(&covered)
  at = usize.ZERO
  while at < listed.length {
    if !skipped[at] {
      let mut position = usize.ZERO
      while position < bound.length {
        run List<RegionPair>.append(&mut relations.*, RegionPair {offered: Shared<Lifetime>.clone(&listed[at]),
          wanted: Shared<Lifetime>.clone(&bound[position]), inferredStatic: Option<Shared<Lifetime>>.none()})
        position = position + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether every atom of `region` is the inferred binder of a body call or literal, such as the
// element region of `List<Plan>.make()`, rather than a loan's own region.
fn inferredLocalRegion(region: &Shared<Lifetime>) -> bool {
  return Lifetime.allAtoms(region, fn(value: &Lifetime) -> bool {
    if let Lifetime.Local {binder, ..} = &value.* { return binder != usize.MAX }
    return false
  })
}

fn callerLocalRegion(region: &Shared<Lifetime>, caller: &DeclarationId) -> bool {
  return Lifetime.allAtoms(region, fn(value: &Lifetime) -> bool {
    if let Lifetime.Local {declaration, ..} = &value.* {
      return DeclarationId.equals(&declaration, caller)
    }
    return false
  })
}

// A shared loan `&'x T` requires `T: 'x` (LIFE-002). When an exact match fails, each lifetime of
// `T` that the parameter writes as its own loan lifetime, in a covariant position, may shorten to
// `'x`; every other lifetime keeps its evidence. Variance follows the bootstrap NominalVariance.
// An exclusive loan offered to a shared loan parameter is first given up as a shared one
// (BORROW-005 never strengthens it). None means the parameter is not a shared loan of the
// argument's form.
effect fn shortenedLoan(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  pattern: &Shared<Type>, actual: &Shared<Type>, span: Span,
) -> Option<Shared<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let wanted = run Type.copy(pattern)
  match move run Type.copy(actual) {
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: loan} = move wanted {
        if access != writtenAccess || writtenAccess != Access.Shared { return Option<Shared<Type>>.none() }
        let shortened = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &referent, &loan, &lifetime, span)
        return Option<Shared<Type>>.some(run Types.intern(Type.Reference {referent: move shortened, access: Access.Shared, lifetime: move lifetime}))
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: loan} = move wanted {
        if access != writtenAccess || writtenAccess != Access.Shared { return Option<Shared<Type>>.none() }
        let shortened = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &element, &loan, &lifetime, span)
        return Option<Shared<Type>>.some(run Types.intern(Type.Slice {element: move shortened, access: Access.Shared, lifetime: move lifetime}))
      }
    }
    _ => {}
  }
  return Option<Shared<Type>>.none()
}

// Shortens `actual` to `region` exactly where `pattern` writes `loan` in a covariant position of a
// shared referent. Exclusive referents, pointees, type arguments and unclassified forms stay exact.
effect fn shortenAgainst(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  pattern: &Shared<Type>, actual: &Shared<Type>, loan: &Shared<Lifetime>, region: &Shared<Lifetime>,
  span: Span,
) -> Shared<Type>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let wanted = run Type.copy(pattern)
  match move run Type.copy(actual) {
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: writtenLifetime} = move wanted {
        if access == writtenAccess {
          let mut validity = move lifetime
          if Lifetime.equalsShared(&writtenLifetime, loan) { validity = Shared<Lifetime>.clone(region) }
          let mut inner = Shared<Type>.clone(&referent)
          if access == Access.Shared {
            inner = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &referent, loan, region, span)
          }
          return run Types.intern(Type.Reference {referent: move inner, access: access, lifetime: move validity})
        }
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: writtenLifetime} = move wanted {
        if access == writtenAccess {
          let mut validity = move lifetime
          if Lifetime.equalsShared(&writtenLifetime, loan) { validity = Shared<Lifetime>.clone(region) }
          let mut inner = Shared<Type>.clone(&element)
          if access == Access.Shared {
            inner = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &element, loan, region, span)
          }
          return run Types.intern(Type.Slice {element: move inner, access: access, lifetime: move validity})
        }
      }
    }
    Type.String {..} => {
      if let Type.String {lifetime: writtenLifetime} = move wanted {
        if Lifetime.equalsShared(&writtenLifetime, loan) {
          return run Types.intern(Type.String {lifetime: Shared<Lifetime>.clone(region)})
        }
      }
    }
    Type.Array {element, extent} => {
      if let Type.Array {element: written, ..} = move wanted {
        let inner = run shortenAgainst(&mut resolver.*, &mut owner.*, &mut dependencies.*, &written, &element, loan, region, span)
        return run Types.intern(Type.Array {element: move inner, extent: move extent})
      }
    }
    Type.Nominal {declaration, isPublic, arguments} => {
      if let Type.Nominal {declaration: writtenDeclaration, arguments: writtenArguments, ..} = move wanted {
        let listed = List<Argument>.asSlice(&arguments)
        let writtenListed = List<Argument>.asSlice(&writtenArguments)
        if DeclarationId.equals(&declaration, &writtenDeclaration) && listed.length == writtenListed.length {
          let mut shortened = List<Argument>.make()
          let mut at = usize.ZERO
          while at < listed.length {
            let mut next = Argument.copy(&listed[at])
            if let Argument.Lifetime {value: written} = &writtenListed[at] {
              if Lifetime.equalsShared(&written, loan) {
                if run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, at, span) {
                  next = Argument.Lifetime {value: Shared<Lifetime>.clone(region)}
                }
              }
            }
            run List<Argument>.append(&mut shortened, move next)
            at = at + usize.ONE
          }
          return run Types.intern(Type.Nominal {declaration: move declaration, isPublic: isPublic, arguments: move shortened})
        }
      }
    }
    _ => {}
  }
  return Shared<Type>.clone(actual)
}

// Whether binder `ordinal` of a nominal declaration, a lifetime or a type, admits a shorter
// argument: its `Variance` answer is covariant or bivariant. A declaration with no source variance
// (a service, an interface, a sealed core) and an unavailable answer are invariant.
effect fn covariantParameter(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  declaration: &DeclarationId, ordinal: usize, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let variance = run binderVariance(&mut resolver.*, &mut owner.*, &mut dependencies.*, declaration, ordinal, span)
  return variance == Variance.Covariant || variance == Variance.Bivariant
}

// Whether `region` is the lifetime binder `marker` names.
fn markedRegion(region: &Shared<Lifetime>, marker: &Argument) -> bool {
  return match &marker.* {
    Argument.Lifetime {value} => Lifetime.equalsShared(region, &value)
    _ => false
  }
}

// Row arguments stay equal at the boundary. LIFE-002 permits shortening another nominal binder
// only when no requirement key (including either side of a subtraction) mentions that binder.
// An abstract row parameter names its own binder, independently of lifetime and type binders.
effect fn rowAvoidsVarianceMarker(row: &Shared<Row>, marker: &Argument) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let selected = match &marker.* {
    Argument.Lifetime {
      value
    } => Shared<
      Lifetime
    >.with<Option<DeclarationId>>(
      &value,
      fn(lifetime: &Lifetime) -> Option<DeclarationId> {
        return match &lifetime.* {
          Lifetime.Parameter {
            declaration,
            ..
          } => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
          _ => Option<DeclarationId>.none()
        }
      }
    )
    Argument.Type {
      value
    } => Shared<Type>.with<Option<DeclarationId>>(
      &value,
      fn(ty: &Type) -> Option<DeclarationId> {
        return match &ty.* {
          Type.Parameter {
            declaration,
            ..
          } => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
          _ => Option<DeclarationId>.none()
        }
      }
    )
    _ => Option<DeclarationId>.none()
  }
  let declaration = match move selected {
    Option<DeclarationId>.Some { value } => move value
    Option<DeclarationId>.None => {
      return false
    }
  }
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwnedRow(row, &declaration, &mut types, &mut lifetimes, &mut rows)
  return match &marker.* {
    Argument.Lifetime {
      value
    } => Shared<Lifetime>.with<bool>(
      &value,
      fn(lifetime: &Lifetime) -> bool {
        return match &lifetime.* {
          Lifetime.Parameter { ordinal, .. } => !containsOrdinal(&lifetimes, ordinal)
          _ => false
        }
      }
    )
    Argument.Type { value } => Shared<Type>.with<bool>(
      &value,
      fn(ty: &Type) -> bool {
        return match &ty.* {
          Type.Parameter { ordinal, .. } => !containsOrdinal(&types, ordinal)
          _ => false
        }
      }
    )
    _ => false
  }
}

// Whether `marker`, a lifetime or type binder, occurs in `value` only in covariant positions; with
// `covariant` false, whether it does not occur at all. A shared referent, a shared slice element, an
// array element and a covariant nominal argument keep their position's variance; exclusive referents,
// pointees and every unclassified form are conservatively invariant.
effect fn flowsCovariantly(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  value: &Shared<Type>, marker: &Argument, covariant: bool, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Argument.Type {value: binder} = &marker.* {
    if run Type.equalsShared(value, &binder) { return covariant }
  }
  match move run Type.copy(value) {
    Type.Primitive {..} => { return true }
    Type.Unit => { return true }
    Type.Union {members} => {
      let listed = List<Shared<Type>>.asSlice(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], marker,
          covariant, span) { return false }
        at = at + usize.ONE
      }
      return true
    }
    Type.Parameter {..} => { return true }
    Type.String {lifetime} => { return covariant || !markedRegion(&lifetime, marker) }
    Type.Reference {referent, access, lifetime} => {
      if !covariant && markedRegion(&lifetime, marker) { return false }
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &referent, marker,
        covariant && access == Access.Shared, span)
    }
    Type.Slice {element, access, lifetime} => {
      if !covariant && markedRegion(&lifetime, marker) { return false }
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, marker,
        covariant && access == Access.Shared, span)
    }
    Type.Pointer {pointee, ..} => {
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &pointee, marker, false, span)
    }
    Type.Array {element, ..} => {
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, marker, covariant, span)
    }
    Type.Nominal {declaration, arguments, ..} => {
      let listed = List<Argument>.asSlice(&arguments)
      let mut at = usize.ZERO
      while at < listed.length {
        match &listed[at] {
          Argument.Lifetime {value: argument} => {
            if markedRegion(&argument, marker) {
              if !covariant { return false }
              if !run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, at, span) {
                return false
              }
            }
          }
          Argument.Type {value: argument} => {
            let flows = covariant
              && run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, at, span)
            if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &argument, marker, flows, span) {
              return false
            }
          }
          Argument.Row {value: argument} => {
            if !run rowAvoidsVarianceMarker(&argument, marker) { return false }
          }
        }
        at = at + usize.ONE
      }
      return true
    }
    // A callable's retained environment is covariant. Its inputs reverse variance, and written
    // invocation bounds remain fixed; this query conservatively rejects either mentioning marker.
    Type.Callable {environment, parameters, result, invocationBounds, ..} => {
      if !covariant {
        let regions = run callableEnvironmentRegions(&environment)
        let listed = List<Shared<Lifetime>>.asSlice(&regions)
        let mut at = usize.ZERO
        while at < listed.length {
          if markedRegion(&listed[at], marker) { return false }
          at = at + usize.ONE
        }
      }
      let bounds = List<Outlives>.asSlice(&invocationBounds)
      let mut at = usize.ZERO
      while at < bounds.length {
        if markedRegion(&bounds[at].longer, marker) || markedRegion(&bounds[at].shorter, marker) { return false }
        at = at + usize.ONE
      }
      let inputs = List<Shared<Type>>.asSlice(&parameters)
      at = usize.ZERO
      while at < inputs.length {
        if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &inputs[at], marker, false,
          span) { return false }
        at = at + usize.ONE
      }
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &result, marker, covariant,
        span)
    }
    // An Effect contract is covariant in its environment, success and failure: an Effect valid for a
    // longer region also runs within a shorter one. Requirement keys are invariant and may not
    // mention the marker; a row of row parameters alone names no region.
    Type.Effect {environment, success, failure, requirements, ..} => {
      if !covariant {
        let regions = run callableEnvironmentRegions(&environment)
        let listed = List<Shared<Lifetime>>.asSlice(&regions)
        let mut at = usize.ZERO
        while at < listed.length {
          if markedRegion(&listed[at], marker) { return false }
          at = at + usize.ONE
        }
      }
      if Shared<Row>.with<bool>(&requirements,
        fn(row: &Row) -> bool { return List<RowSubtraction>.length(&row.subtractions) != usize.ZERO }) { return false }
      let entries = run Row.entryList(&requirements)
      let listed = List<Requirement>.asSlice(&entries)
      let mut entryAt = usize.ZERO
      while entryAt < listed.length {
        if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[entryAt].capability,
          marker, false, span) { return false }
        if let Option<Shared<Type>>.Some {value: roleType} = &listed[entryAt].roleType {
          if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &roleType,
            marker, false, span) { return false }
        }
        entryAt = entryAt + usize.ONE
      }
      if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &success, marker, covariant, span) {
        return false
      }
      return run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &failure, marker, covariant, span)
    }
    _ => { return false }
  }
}

// A region a boundary admitted where it fixes another region without proof. Typing reads the pairs
// to steer its region inference; the body's region check relates the two regions itself.
struct RegionPair {
  offered: Shared<Lifetime>,
  wanted: Shared<Lifetime>,
  inferredStatic: Option<Shared<Lifetime>>,
}

fn hasInferredStaticRelation(pairs: &[RegionPair]) -> bool {
  let mut at = usize.ZERO
  while at < pairs.length {
    if let Option<Shared<Lifetime>>.Some {..} = &pairs[at].inferredStatic { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a pair relates a loan of storage `caller` owns to a region every atom of which is a
// declared lifetime: a later local operand meeting a binder an earlier operand fixed to a caller
// lifetime.
fn relatesLocalToDeclared(pairs: &[RegionPair], nodes: &[BodyNode], caller: &DeclarationId) -> bool {
  let mut at = usize.ZERO
  while at < pairs.length {
    if let Option<Shared<Lifetime>>.None = &pairs[at].inferredStatic {
      if callerLocalRegion(&pairs[at].offered, caller) && ownedLoanRegion(nodes, &pairs[at].offered) && Lifetime.allAtoms(&pairs[at].wanted, fn(value: &Lifetime) -> bool {
        return match &value.* { Lifetime.Parameter {..} => true _ => false }
      }) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// A call argument admitted at its binder's already fixed region, with the relations it needs.
struct RelatedArgument {
  ty: Shared<Type>,
  relations: List<RegionPair>,
}

// One covariant region pair at a boundary. A pair the body's declared outlives premises prove is
// admitted (`knownOutlives`: equal regions, an offered 'static, an enclosing declaration's lifetime
// offered where a caller-local loan is wanted, or a chain of declared bounds such as `'data: 'view`).
// A caller-local wanted region still retains a source naming an outer region as a pair: the borrow
// checker must know each value entering a local region before it proves that region outlives a
// universal one. A caller-local offered region meeting any other non-static region is a relation
// typing cannot prove yet; it is deferred as a pair. Every other pair, including a fixed 'static
// expectation of a shorter region, is a mismatch.
effect fn admitsRegion(offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>, caller: &DeclarationId,
  constraints: &[Constraint], deferred: &mut List<RegionPair>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if run knownOutlives(constraints, offered, wanted) {
    if callerLocalRegion(wanted, caller) && !callerLocalRegion(offered, caller)
      && !Shared<Lifetime>.with<bool>(offered, staticLifetime) {
      run List<RegionPair>.append(&mut deferred.*, RegionPair {offered: Shared<Lifetime>.clone(offered),
        wanted: Shared<Lifetime>.clone(wanted), inferredStatic: Option<Shared<Lifetime>>.none()})
    }
    return true
  }
  if !callerLocalRegion(offered, caller) || Shared<Lifetime>.with<bool>(wanted, staticLifetime) { return false }
  run List<RegionPair>.append(&mut deferred.*, RegionPair {offered: Shared<Lifetime>.clone(offered),
    wanted: Shared<Lifetime>.clone(wanted), inferredStatic: Option<Shared<Lifetime>>.none()})
  return true
}

// The type a type argument names; none for a lifetime or row argument.
fn argumentType(value: &Argument) -> Option<Shared<Type>> {
  return match &value.* {
    Argument.Type {value: argument} => Option<Shared<Type>>.some(Shared<Type>.clone(&argument))
    _ => Option<Shared<Type>>.none()
  }
}

// The region a lifetime argument names; none for a type or row argument.
fn argumentRegion(value: &Argument) -> Option<Shared<Lifetime>> {
  return match &value.* {
    Argument.Lifetime {value: region} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&region))
    _ => Option<Shared<Lifetime>>.none()
  }
}

// Whether two type or row arguments are exactly equal.
effect fn sameExactArgument(left: &Argument, right: &Argument) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Argument.Type {value} = &left.* {
    if let Argument.Type {value: other} = &right.* { return run Type.equalsShared(&value, &other) }
    return false
  }
  if let Argument.Row {value} = &left.* {
    if let Argument.Row {value: other} = &right.* { return run Row.equalsShared(&value, &other) }
    return false
  }
  return false
}

// Whether `offered` meets `wanted` by covariant region subtyping (LIFE-002). Variance follows the
// bootstrap NominalVariance: reference, slice and `string` regions are covariant, a shared referent
// and an array element keep their position's variance, and a nominal lifetime or type argument is
// covariant only when `covariantParameter` proves it. In an invariant position, under an exclusive
// referent or an invariant nominal argument, a caller-local offered region meets another only by
// relating both ways, left to the region check as equal to it (`admitsRegionAt`). Pointees,
// requirement rows and every other form stay exact. A covariant exclusive loan may be given up as a
// shared one, never the reverse (BORROW-005). `admitsRegionAt` decides each region pair.
effect fn admitsRegions(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  offered: &Shared<Type>, wanted: &Shared<Type>, caller: &DeclarationId, constraints: &[Constraint], covariant: bool,
  deferred: &mut List<RegionPair>, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.equalsShared(offered, wanted) { return true }
  let target = run Type.copy(wanted)
  match move run Type.copy(offered) {
    Type.Reference {referent, access, lifetime} => {
      if let Type.Reference {referent: written, access: writtenAccess, lifetime: writtenLifetime} = move target {
        if access != writtenAccess { return false }
        if !run admitsRegionAt(&lifetime, &writtenLifetime, caller, constraints, covariant, resolver.exactLocalRegions, &mut deferred.*) { return false }
        return run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &referent, &written, caller, constraints,
          covariant && writtenAccess == Access.Shared, &mut deferred.*, span)
      }
    }
    Type.Slice {element, access, lifetime} => {
      if let Type.Slice {element: written, access: writtenAccess, lifetime: writtenLifetime} = move target {
        if access != writtenAccess { return false }
        if !run admitsRegionAt(&lifetime, &writtenLifetime, caller, constraints, covariant, resolver.exactLocalRegions, &mut deferred.*) { return false }
        return run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, &written, caller, constraints,
          covariant && writtenAccess == Access.Shared, &mut deferred.*, span)
      }
    }
    Type.String {lifetime} => {
      if let Type.String {lifetime: writtenLifetime} = move target {
        return run admitsRegionAt(&lifetime, &writtenLifetime, caller, constraints, covariant, resolver.exactLocalRegions, &mut deferred.*)
      }
    }
    Type.Array {element, extent} => {
      if let Type.Array {element: written, extent: writtenExtent} = move target {
        if !same(Bytes.asSlice(&extent), Bytes.asSlice(&writtenExtent)) { return false }
        return run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, &written, caller, constraints,
          covariant, &mut deferred.*, span)
      }
    }
    Type.Nominal {declaration, arguments, ..} => {
      if let Type.Nominal {declaration: writtenDeclaration, arguments: writtenArguments, ..} = move target {
        let listed = List<Argument>.asSlice(&arguments)
        let writtenListed = List<Argument>.asSlice(&writtenArguments)
        if !DeclarationId.equals(&declaration, &writtenDeclaration) || listed.length != writtenListed.length { return false }
        let mut at = usize.ZERO
        while at < listed.length {
          let region = argumentRegion(&listed[at])
          let writtenRegion = argumentRegion(&writtenListed[at])
          if let Option<Shared<Lifetime>>.Some {value: offeredRegion} = move region {
            let boundRegion = match move writtenRegion {
              Option<Shared<Lifetime>>.Some {value} => move value
              Option<Shared<Lifetime>>.None => { return false }
            }
            if !Lifetime.equalsShared(&offeredRegion, &boundRegion) {
              let varies = covariant && run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, at, span)
              if !run admitsRegionAt(&offeredRegion, &boundRegion, caller, constraints, varies, resolver.exactLocalRegions, &mut deferred.*) { return false }
            }
          } else if !run sameExactArgument(&listed[at], &writtenListed[at]) {
            let offeredType = argumentType(&listed[at])
            let writtenType = argumentType(&writtenListed[at])
            if let Option<Shared<Type>>.Some {value: offeredArgument} = move offeredType {
              if let Option<Shared<Type>>.Some {value: writtenArgument} = move writtenType {
                let varies = covariant && run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, at, span)
                if !run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &offeredArgument, &writtenArgument,
                  caller, constraints, varies, &mut deferred.*, span) { return false }
                at = at + usize.ONE
                continue
              }
            }
            return false
          }
          at = at + usize.ONE
        }
        return true
      }
    }
    _ => {}
  }
  return false
}

// One region pair at a boundary: `admitsRegion` in a covariant position. In an invariant one, only
// a caller-local offered region, such as the inferred element region of `List<Name>.make()`, meets a
// region the body does not own, by relating both ways so the region check holds the two equal.
// Every other invariant pair, a caller-local wanted region included, stays exact.
effect fn admitsRegionAt(offered: &Shared<Lifetime>, wanted: &Shared<Lifetime>, caller: &DeclarationId,
  constraints: &[Constraint], covariant: bool, exactLocals: bool, deferred: &mut List<RegionPair>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if Lifetime.equalsShared(offered, wanted) { return true }
  if covariant { return run admitsRegion(offered, wanted, caller, constraints, &mut deferred.*) }
  if !callerLocalRegion(offered, caller) || (callerLocalRegion(wanted, caller) && (exactLocals || !inferredLocalRegion(wanted))) { return false }
  if !run admitsRegion(offered, wanted, caller, constraints, &mut deferred.*) { return false }
  return run admitsRegion(wanted, offered, caller, constraints, &mut deferred.*)
}

// The ordinal of an inference binder `fresh` owns, or usize.MAX for any other region.
fn freshLifetimeOrdinal(region: &Shared<Lifetime>, fresh: &DeclarationId) -> usize {
  return Shared<Lifetime>.with<usize>(region, fn(value: &Lifetime) -> usize {
    if let Lifetime.Parameter {declaration, ordinal} = &value.* {
      if DeclarationId.equals(&declaration, fresh) { return ordinal }
    }
    return usize.MAX
  })
}

// The lifetime binder of `fresh` that `parameter`'s outer reference or slice region is, or
// `usize.MAX`: the binder whose call region a fresh loan passed for `parameter` takes.
fn parameterBinder(parameter: &Shared<Type>, fresh: &DeclarationId) -> usize {
  return match move Shared<Type>.with<Option<Shared<Lifetime>>>(parameter, operandRegion) {
    Option<Shared<Lifetime>>.Some {value} => freshLifetimeOrdinal(&value, fresh)
    Option<Shared<Lifetime>>.None => usize.MAX
  }
}

// Whether a later operand's covariant region `source` meets `bound`, the region an earlier operand
// fixed for the same inferred binder: a caller-local region or inferred 'static. An offered
// 'static, or the caller's own lifetime against a caller-local loan, outlives it, which is proven.
// A caller-local region, or any region where the
// binder holds 'static (inferred 'static evidence never requires 'static), relates to `bound` as a
// pair typing cannot prove yet. A bound declared region, and any other pair, is a mismatch.
effect fn relatesToFixedRegion(bound: &Shared<Lifetime>, source: &Shared<Lifetime>, caller: &DeclarationId,
  fresh: &DeclarationId, ordinal: usize, relations: &mut List<RegionPair>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if Lifetime.equalsShared(bound, source) { return false }
  let staticBound = Shared<Lifetime>.with<bool>(bound, staticLifetime)
  if !staticBound && !callerLocalRegion(bound, caller) { return false }
  if Shared<Lifetime>.with<bool>(source, staticLifetime) { return true }
  // An enclosing lifetime covers the caller-local region, but the region still records it as a
  // source (`admitsRegion`).
  if !staticBound && !enclosingLifetimeOutlivesLoan(source, bound) && !callerLocalRegion(source, caller) { return false }
  let mut pending = Option<Shared<Lifetime>>.none()
  if staticBound {
    pending = Option<Shared<Lifetime>>.some(run Shared<Lifetime>.make(Lifetime.Parameter {
      declaration: DeclarationId.copy(fresh), ordinal: ordinal}))
  }
  run List<RegionPair>.append(&mut relations.*, RegionPair {offered: Shared<Lifetime>.clone(source),
    wanted: Shared<Lifetime>.clone(bound), inferredStatic: move pending})
  return true
}

// The number of arguments a nominal type applies; a binder elided inside one of them is not one.
fn nominalArgumentCount(value: &Shared<Type>) -> usize {
  return Shared<Type>.with<usize>(value, fn(ty: &Type) -> usize {
    return match &ty.* { Type.Nominal {arguments, ..} => List<Argument>.length(&arguments) _ => usize.ZERO }
  })
}

// Whether some atom of `region` is a declaration's lifetime parameter.
fn holdsLifetimeParameter(region: &Shared<Lifetime>) -> bool {
  let count = Lifetime.atomCount(region)
  let mut at = usize.ZERO
  while at < count {
    let atom = Lifetime.atomAt(region, at)
    if Shared<Lifetime>.with<bool>(&atom, fn(value: &Lifetime) -> bool {
      return match &value.* { Lifetime.Parameter {..} => true _ => false }
    }) { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether `region` is a lifetime parameter of the declaration whose body `local` is a region of.
// The parameter is valid for the whole invocation, so it outlives every region local to the body.
fn outlivesLocalRegion(region: &Shared<Lifetime>, local: &Shared<Lifetime>) -> bool {
  let parameterOwner = Shared<Lifetime>.with<Option<DeclarationId>>(region, fn(value: &Lifetime) -> Option<DeclarationId> {
    return match &value.* {
      Lifetime.Parameter {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
      _ => Option<DeclarationId>.none()
    }
  })
  let localOwner = Shared<Lifetime>.with<Option<DeclarationId>>(local, fn(value: &Lifetime) -> Option<DeclarationId> {
    return match &value.* {
      Lifetime.Local {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
      _ => Option<DeclarationId>.none()
    }
  })
  if let Option<DeclarationId>.Some {value: parameterDeclaration} = &parameterOwner {
    if let Option<DeclarationId>.Some {value: localDeclaration} = &localOwner {
      return DeclarationId.equals(&parameterDeclaration, &localDeclaration)
    }
  }
  return false
}

// The atoms of `regions`, each meet taken apart, without each lifetime parameter that outlives a
// local atom among them: it adds nothing to their meet.
effect fn withoutOutlivingParameters(regions: &[Shared<Lifetime>]) -> List<Shared<Lifetime>>
! OutOfMemoryError ? &mut Allocator {
  let mut atoms = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < regions.length {
    let count = Lifetime.atomCount(&regions[at])
    let mut atom = usize.ZERO
    while atom < count {
      run List<Shared<Lifetime>>.append(&mut atoms, Lifetime.atomAt(&regions[at], atom))
      atom = atom + usize.ONE
    }
    at = at + usize.ONE
  }
  let listed = List<Shared<Lifetime>>.asSlice(&atoms)
  let mut kept = List<Shared<Lifetime>>.make()
  at = usize.ZERO
  while at < listed.length {
    let mut outlives = false
    let mut other = usize.ZERO
    while other < listed.length && !outlives {
      outlives = other != at && outlivesLocalRegion(&listed[at], &listed[other])
      other = other + usize.ONE
    }
    if !outlives { run List<Shared<Lifetime>>.append(&mut kept, Shared<Lifetime>.clone(&listed[at])) }
    at = at + usize.ONE
  }
  return move kept
}

// The region an inferred lifetime binder shortens to when a later operand offers it a different
// region, as the bootstrap's region inference chooses the shortest region (LIFE-002): a binder fixed
// to 'static takes the offered region, and any other binder takes the complete meet of both. A
// written binder, a binder holding a call loan and an offered 'static region never move it.
effect fn binderMeet(
  parameter: &Shared<Type>, actual: &Shared<Type>, variables: &[Shared<DeclarationId>], bindings: &[Binding], at: usize,
  explicit: &[usize],
) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let ordinal = bindings[at].ordinal
  let fixed = match &bindings[at].value {
    Argument.Lifetime {value} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&value))
    _ => Option<Shared<Lifetime>>.none()
  }
  let mut held = Option<Shared<Lifetime>>.none()
  if !fixedOrdinal(explicit, ordinal) {
    if let Option<Shared<Lifetime>>.Some {value: region} = move fixed {
      if !variableCallLoan(&region, variables) { held = Option<Shared<Lifetime>>.some(move region) }
    }
  }
  let earlier = match move held {
    Option<Shared<Lifetime>>.Some {value} => move value
    Option<Shared<Lifetime>>.None => { return Option<Shared<Lifetime>>.none() }
  }
  let mut trial = List<Binding>.make()
  let mut copied = usize.ZERO
  while copied < bindings.length {
    if copied != at {
      run List<Binding>.append(&mut trial, Binding {declaration: Shared<DeclarationId>.clone(&bindings[copied].declaration),
        ordinal: bindings[copied].ordinal, value: Argument.copy(&bindings[copied].value)})
    }
    copied = copied + usize.ONE
  }
  let unified = run Type.unify(parameter, actual, variables, Comparison.Exact, &mut trial)
  let mut region = Option<Shared<Lifetime>>.none()
  let matched = match &unified {
    Unification.Unified => true
    _ => false
  }
  if matched {
    if let Option<Argument>.Some {value: Argument.Lifetime {value: offered}} = move bindingArgumentAt(List<Binding>.asSlice(&trial), ordinal) {
      if !Lifetime.equalsShared(&offered, &earlier) && !Shared<Lifetime>.with<bool>(&offered, staticLifetime)
        && !variableCallLoan(&offered, variables) {
        if Shared<Lifetime>.with<bool>(&earlier, staticLifetime) {
          region = Option<Shared<Lifetime>>.some(move offered)
        } else {
          let mut both = List<Shared<Lifetime>>.make()
          run List<Shared<Lifetime>>.append(&mut both, Shared<Lifetime>.clone(&earlier))
          run List<Shared<Lifetime>>.append(&mut both, move offered)
          region = Option<Shared<Lifetime>>.some(run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&both)))
        }
      }
    }
  }
  return move region
}

// An inferred call lifetime binder that earlier operands fixed shortens to its `binderMeet` with a
// later operand, so every earlier operand still meets it by covariant subtyping (LIFE-002). This
// holds only when every parameter stores the binder covariantly (bootstrap NominalVariance) and no
// bound forbids shortening it. An `effect fn` environment binder qualifies too: the Effect it
// returns is only valid for a shorter region. On success the binding is replaced and the caller
// matches the operand again.
// Whether shortening inference binder `ordinal` keeps every bound of a signature provable on the
// final bindings, which the caller proves again. A `provides` bound selects by access and provider
// type, never by its loan's region, and a conformance that never names the binder is unchanged, as is a
// `Copy`, property, failure-subset or requirement-subset bound (`R in Without<R, S>`). A representation bound admits a shorter binder when its
// contract stores the binder only covariantly, as `once Effect<'env; A>` does: the operand's Effect
// environment still outlives the meet.
effect fn boundsAdmitGroupShortening(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId,
  ordinal: usize,
  group: &[usize],
  span: Span,
) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let marker = Argument.Lifetime {
    value: run Shared<
      Lifetime
    >.make(Lifetime.Parameter { declaration: DeclarationId.copy(fresh), ordinal: ordinal })
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<
      Result<Answer, NoRejection>
    >.with<
      Option<Constraint>
    >(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraint(answer, at)
      }
    )
    let mut admitted = false
    match move bound {
      // A provides fact is keyed by access and provider type, and a borrowed provider's own loan
      // region is checked where its argument is borrowed (`proveProvides`), so a binder only that
      // region names, as `'env` of `&'env mut P provides S from R`, is the same goal after it
      // shortens. One the referent or either row names is not.
      Option<Constraint>.Some {value: Constraint.Provides {provider, selector, source}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        let keyed = match move Shared<Type>.with<Option<Shared<Type>>>(&provider, providerTarget) {
          Option<Shared<Type>>.Some {value: referent} => move referent
          Option<Shared<Type>>.None => Shared<Type>.clone(&provider)
        }
        run Type.collectOwned(&keyed, fresh, &mut types, &mut lifetimes, &mut rows)
        run Type.collectOwnedRow(&selector, fresh, &mut types, &mut lifetimes, &mut rows)
        run Type.collectOwnedRow(&source, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      // A conformance whose provider and contract do not name the binder is the same goal after it
      // shortens, as `T: Serialize` is for `JsonObject.field`'s `value: &'env T`.
      Option<Constraint>.Some {value: Constraint.Conforms {provider, contract}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        run Type.collectOwned(&provider, fresh, &mut types, &mut lifetimes, &mut rows)
        run Type.collectOwned(&contract, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      Option<Constraint>.Some {value: Constraint.Outlives {longer, shorter}} => {
        let mut lifetimes = List<usize>.make()
        run Type.collectOwnedLifetime(&longer, fresh, &mut lifetimes)
        admitted = !containsOrdinal(&lifetimes, ordinal)
        if !admitted {
          let shorterOrdinal = freshLifetimeOrdinal(&shorter, fresh)
          let mut member = usize.ZERO
          while member < group.length {
            if group[member] == shorterOrdinal { admitted = true }
            member = member + usize.ONE
          }
        }
      }
      Option<Constraint>.Some {value: Constraint.Contents {subject, ..}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        run Type.collectOwned(&subject, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      Option<Constraint>.Some {value: Constraint.Copyable {subject}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        run Type.collectOwned(&subject, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      Option<Constraint>.Some {value: Constraint.ThreadSafe {subject, ..}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        run Type.collectOwned(&subject, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      Option<Constraint>.Some {value: Constraint.Property {subject, ..}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        run Type.collectOwned(&subject, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      Option<Constraint>.Some {value: Constraint.FailureSubset {selected, source}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        run Type.collectOwned(&selected, fresh, &mut types, &mut lifetimes, &mut rows)
        run Type.collectOwned(&source, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      Option<Constraint>.Some {value: Constraint.RequirementSubset {selected, source}} => {
        let mut types = List<usize>.make()
        let mut lifetimes = List<usize>.make()
        let mut rows = List<usize>.make()
        run Type.collectOwnedRow(&selected, fresh, &mut types, &mut lifetimes, &mut rows)
        run Type.collectOwnedRow(&source, fresh, &mut types, &mut lifetimes, &mut rows)
        admitted = !containsOrdinal(&lifetimes, ordinal)
      }
      Option<Constraint>.Some {value: Constraint.Represents {contract, ..}} => {
        admitted = run flowsCovariantly(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          &contract,
          &marker,
          true,
          span
        )
      }
      _ => ()
    }
    if
      !admitted {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn boundsAdmitShortening(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, ordinal: usize, span: Span,
) -> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let group = List<usize>.make()
  return run boundsAdmitGroupShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh,
    ordinal, List<usize>.asSlice(&group), span)
}

// A covariant inferred binder may shorten together with the inferred binders below it.
// Keep every outlives edge: shortening 'a in 'a: 'b also meets 'b with the new 'a.
// Written, invariant, row-observed and externally fixed regions never join this set.
// The resulting types retain the actual operand regions, including through stored results,
// nested calls and Effect successes; a later static consumer uses ordinary lifetime proof.
// Returns the size of the shortened group, or zero when the proposed group cannot move.
effect fn shortenRelatedBinders(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &mut List<Binding>,
  ordinal: usize, offered: &Shared<Lifetime>, explicit: &[usize], span: Span,
) -> usize ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut group = List<usize>.make()
  run List<usize>.append(&mut group, ordinal)
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut member = usize.ZERO
  while member < List<usize>.length(&group) {
    let selected = List<usize>.asSlice(&group)[member]
    if fixedOrdinal(explicit, selected) { return usize.ZERO }
    let mut boundAt = usize.ZERO
    while boundAt < count {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, boundAt) })
      if let Option<Constraint>.Some {value: Constraint.Outlives {longer, shorter}} = move bound {
        let mut longerBinders = List<usize>.make()
        run Type.collectOwnedLifetime(&longer, fresh, &mut longerBinders)
        if containsOrdinal(&longerBinders, selected) {
          let target = freshLifetimeOrdinal(&shorter, fresh)
          if target == usize.MAX { return usize.ZERO }
          if !containsOrdinal(&group, target) { run List<usize>.append(&mut group, target) }
        }
      }
      boundAt = boundAt + usize.ONE
    }
    member = member + usize.ONE
  }
  let parameters = run signatureParameterTypes(signature)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  member = usize.ZERO
  while member < List<usize>.length(&group) {
    let selected = List<usize>.asSlice(&group)[member]
    // Only a result-only child may await inference here. A child named by a later
    // operand has not supplied its evidence yet; shortening its parent now can leave
    // a mixed local/caller bound that the completed call cannot prove or retain.
    if let Option<Argument>.None = move bindingArgument(List<Binding>.asSlice(&inferred.*), fresh, selected) {
      if run parameterStoresBinder(listed, fresh, selected) { return usize.ZERO }
    }
    if !run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, listed, fresh, selected, span) { return usize.ZERO }
    if !run boundsAdmitGroupShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh,
      selected, List<usize>.asSlice(&group), span) { return usize.ZERO }
    if List<usize>.length(&group) > usize.ONE {
      if !run impliedBoundsAdmitShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh, selected, span) { return usize.ZERO }
    }
    member = member + usize.ONE
  }
  // A result-only outgoing child can still be unbound while operands are matched.
  // Keep it absent: the call's use chooses it, and the signature's
  // original incoming and outgoing bounds are still proved on those final bindings.
  let mut trial = run copyBindings(List<Binding>.asSlice(&inferred.*))
  let mut at = usize.ZERO
  while at < List<Binding>.length(&trial) {
    let entries = List<Binding>.asMutSlice(&mut trial)
    if entries[at].ordinal == ordinal && Shared<DeclarationId>.with<bool>(&entries[at].declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, fresh) }) { entries[at].value = Argument.Lifetime {value: Shared<Lifetime>.clone(offered)} }
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut boundAt = usize.ZERO
    while boundAt < count {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, boundAt) })
      if let Option<Constraint>.Some {value: Constraint.Outlives {longer, shorter}} = move bound {
        let target = freshLifetimeOrdinal(&shorter, fresh)
        let mut sources = List<usize>.make()
        run Type.collectOwnedLifetime(&longer, fresh, &mut sources)
        let mut sourceAt = usize.ZERO
        let mut changedSource = false
        while sourceAt < List<usize>.length(&sources) {
          if containsOrdinal(&group, List<usize>.asSlice(&sources)[sourceAt]) { changedSource = true }
          sourceAt = sourceAt + usize.ONE
        }
        // Only propagate a longer side this group shortens. An incoming bound such as
        // 'long: 'call does not propagate into 'call when only 'call shrinks. Its longer
        // side may be invariant or still awaiting its operand; it is not a new access region.
        // This only controls inference propagation: every incoming bound remains in
        // the signature and is proved on final bindings after all operands are matched.
        if changedSource && containsOrdinal(&group, target) {
          let required = run Type.applyLifetimeBindings(&longer, List<Binding>.asSlice(&trial))
          if let Option<Argument>.Some {value: Argument.Lifetime {value: held}} = move bindingArgument(List<Binding>.asSlice(&trial), fresh, target) {
            let mut parts = List<Shared<Lifetime>>.make()
            run List<Shared<Lifetime>>.append(&mut parts, Shared<Lifetime>.clone(&held))
            run List<Shared<Lifetime>>.append(&mut parts, move required)
            let met = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&parts))
            if !Lifetime.equalsShared(&met, &held) {
              at = usize.ZERO
              while at < List<Binding>.length(&trial) {
                let entries = List<Binding>.asMutSlice(&mut trial)
                if entries[at].ordinal == target && Shared<DeclarationId>.with<bool>(&entries[at].declaration, fn(value: &DeclarationId) -> bool { return DeclarationId.equals(value, fresh) }) { entries[at].value = Argument.Lifetime {value: Shared<Lifetime>.clone(&met)} }
                at = at + usize.ONE
              }
              changed = true
            }
          }
        }
      }
      boundAt = boundAt + usize.ONE
    }
  }
  if run rowObservesShortenedBinder(signature, fresh, List<Binding>.asSlice(&inferred.*), List<Binding>.asSlice(&trial)) { return usize.ZERO }
  inferred.* = move trial
  return List<usize>.length(&group)
}

effect fn shortenedBinder(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  parameter: &Shared<Type>, actual: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, variables: &[Shared<DeclarationId>], inferred: &mut List<Binding>,
  explicit: &[usize], span: Span,
) -> usize
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = List<Binding>.length(&inferred.*)
  let mut at = usize.ZERO
  while at < count {
    let bindings = List<Binding>.asSlice(&inferred.*)
    let ordinal = bindings[at].ordinal
    let region = run binderMeet(parameter, actual, variables, bindings, at, explicit)
    if let Option<Shared<Lifetime>>.Some {value: offered} = move region {
      let changed = run shortenRelatedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh,
        &mut inferred.*, ordinal, &offered, explicit, span)
      if changed != usize.ZERO { return changed }
    }
    at = at + usize.ONE
  }
  return usize.ZERO
}

// Shortens each inferred binder that an earlier operand fixed to a caller lifetime to its meet with
// the loans of owned storage this operand offers wherever the parameter names that binder, as the
// bootstrap's region inference chooses the shortest region (LIFE-002). The candidate's pairs list
// every such position, so a binder named more than once meets every offered region. As in
// `shortenedBinder`, a written binder never moves, every parameter must store the binder
// covariantly. Declared outgoing bounds shorten their inferred children together; implied
// bounds still cannot name the binder on their longer side (`impliedBoundsAdmitShortening`). A
// binder whose region another of the callee's binders that the operand's parameter names also holds
// never shortens: the pairs cannot tell which of them the operand's region met (`soleHolder`).
effect fn metBinders(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  parameter: &Shared<Type>, pairs: &[RegionPair], nodes: &[BodyNode], signature: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, inferred: &mut List<Binding>, explicit: &[usize], caller: &DeclarationId, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = List<Binding>.length(&inferred.*)
  let mut changed = false
  let mut at = usize.ZERO
  while at < count {
    let bindings = List<Binding>.asSlice(&inferred.*)
    let ordinal = bindings[at].ordinal
    let own = Shared<DeclarationId>.with<bool>(&bindings[at].declaration, fn(declared: &DeclarationId) -> bool {
      return DeclarationId.equals(declared, fresh)
    })
    let held = match &bindings[at].value {
      Argument.Lifetime {value} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&value))
      _ => Option<Shared<Lifetime>>.none()
    }
    if let Option<Shared<Lifetime>>.Some {value: earlier} = move held {
      let mut members = List<Shared<Lifetime>>.make()
      run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&earlier))
      let mut pair = usize.ZERO
      while own && !fixedOrdinal(explicit, ordinal) && pair < pairs.length {
        if Lifetime.equalsShared(&pairs[pair].wanted, &earlier) && callerLocalRegion(&pairs[pair].offered, caller) && ownedLoanRegion(nodes, &pairs[pair].offered) {
          run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&pairs[pair].offered))
        }
        pair = pair + usize.ONE
      }
      let mut admitted = List<Shared<Lifetime>>.length(&members) > usize.ONE
      if admitted { admitted = run soleHolder(parameter, List<Binding>.asSlice(&inferred.*), fresh, at, &earlier) }
      if admitted { admitted = run impliedBoundsAdmitShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh, ordinal, span) }
      if admitted {
        let met = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
        let shortened = run shortenRelatedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh,
          &mut inferred.*, ordinal, &met, explicit, span)
        if shortened != usize.ZERO { changed = true }
      }
    }
    at = at + usize.ONE
  }
  return changed
}

// Whether binding `at` is the only one of the callee's own binders holding `region` that the operand's
// `parameter` names. A pair records the region it wanted, not the binder it came from, but an
// operand's pairs come only from the positions of its own parameter, so a binder holding the same
// region that the parameter does not name, as `'x` of `splitDuo<'x, 'y>(p: &'x i32, q: &'y i32, l: &'y i32)`
// at `l`, cannot be the one the operand met. A type or row binder the parameter names may carry the
// region anywhere within, so then every other holder counts.
effect fn soleHolder(parameter: &Shared<Type>, bindings: &[Binding], fresh: &DeclarationId, at: usize, region: &Shared<Lifetime>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(parameter, fresh, &mut types, &mut lifetimes, &mut rows)
  let opaque = List<usize>.length(&types) != usize.ZERO || List<usize>.length(&rows) != usize.ZERO
  let mut other = usize.ZERO
  while other < bindings.length {
    if other != at && Shared<DeclarationId>.with<bool>(&bindings[other].declaration, fn(declared: &DeclarationId) -> bool {
      return DeclarationId.equals(declared, fresh)
    }) {
      if let Argument.Lifetime {value} = &bindings[other].value {
        if Lifetime.equalsShared(&value, region) && (opaque || containsOrdinal(&lifetimes, bindings[other].ordinal)) { return false }
      }
    }
    other = other + usize.ONE
  }
  return true
}

// Whether a requirement row the callee declares or returns names a binder that shortened from
// `before` to `after`. A provider serves exactly the row it is given, so a shorter binder would ask
// the caller for a different provider: the row observes the binder invariantly.
effect fn rowObservesShortenedBinder(signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  before: &[Binding], after: &[Binding]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut rows = List<Shared<Row>>.make()
  run List<Shared<Row>>.append(&mut rows, run signatureRequirements(signature))
  if let Option<Shared<Type>>.Some {value: result} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature, signatureResult) {
    run heldEffectRequirements(&result, &mut rows)
  }
  let mut named = List<usize>.make()
  let listed = List<Shared<Row>>.asSlice(&rows)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut types = List<usize>.make()
    let mut nested = List<usize>.make()
    run Type.collectOwnedRow(&listed[at], fresh, &mut types, &mut named, &mut nested)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < before.length && at < after.length {
    if let Argument.Lifetime {value: earlier} = &before[at].value {
      if let Argument.Lifetime {value: later} = &after[at].value {
        if !Lifetime.equalsShared(&earlier, &later) && containsOrdinal(&named, before[at].ordinal) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether every parameter that mentions inference binder `ordinal` stores it covariantly, so any
// operand that met a longer region still meets a shorter one (bootstrap NominalVariance).
effect fn storedCovariantly(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  listed: &[Shared<Type>], fresh: &DeclarationId, ordinal: usize, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let marker = Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {declaration: DeclarationId.copy(fresh), ordinal: ordinal})}
  let mut position = usize.ZERO
  while position < listed.length {
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    run Type.collectOwned(&listed[position], fresh, &mut types, &mut lifetimes, &mut rows)
    if containsOrdinal(&lifetimes, ordinal) {
      if !run flowsCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[position], &marker, true,
        span) {
        return false
      }
    }
    position = position + usize.ONE
  }
  return true
}

// An inferred lifetime binder that a `T: 'binder` bound names shortens to the meet of the regions T
// retains when the binder's evidence does not already cover them, as the bootstrap's region inference
// chooses the shortest region (LIFE-002). A capture-free callback fixes `'env` of
// `useReleaseNonParking` to 'static, while `Resource: 'env` asks only for the resource's named
// regions; a stored type parameter without a contents premise names none (see `proveAppliedBounds`).
// When T's contents are generic storage with no premise naming a region, as for a bare caller type
// parameter, the shortest region is the call's own: a binder that holds only 'static evidence, such as
// the environment of a capture-free `effect fn` passed as a callback, shortens to this call's local
// region, which every type the caller names outlives (see `proveAppliedBounds`).
// As in `shortenedBinder`, a written binder never moves and every parameter must store the binder
// covariantly; the bound proof then runs on the shortened binding.
effect fn boundShortenedBinders(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  inferred: &mut List<Binding>, explicit: &[usize], constraints: &[Constraint], caller: &DeclarationId,
  expression: HirId, span: Span, anchor: &Anchor,
) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  if count == usize.ZERO { return () }
  let parameters = run signatureParameterTypes(signature)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Contents {subject, region}} = move bound {
      let ordinal = freshLifetimeOrdinal(&region, fresh)
      let mut current = Option<Shared<Lifetime>>.none()
      if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) {
        if let Option<Argument>.Some {value: Argument.Lifetime {value}} = move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), ordinal) {
          current = Option<Shared<Lifetime>>.some(move value)
        }
      }
      if let Option<Shared<Lifetime>>.Some {value: held} = move current {
        let applied = run Type.applyBindings(&subject, List<Binding>.asSlice(&inferred.*), true)
        let moduleRoot = run DeclarationId.fromParts(ModuleId.copy(module), List<OwnerStep>.make())
        let mut retained = List<Shared<Lifetime>>.make()
        let mut unresolved = List<Shared<Type>>.make()
        let open = run typeMentionsOwner(&applied, fresh)
        if !open && run captureContents(&applied, &moduleRoot, constraints, &mut retained, &mut unresolved) {
          let regions = List<Shared<Lifetime>>.asSlice(&retained)
          let mut members = List<Shared<Lifetime>>.make()
          if !Shared<Lifetime>.with<bool>(&held, staticLifetime) { run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&held)) }
          let mut uncovered = false
          let mut regionAt = usize.ZERO
          while regionAt < regions.length {
            if !run knownOutlives(constraints, &regions[regionAt], &held) { uncovered = true }
            run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&regions[regionAt]))
            regionAt = regionAt + usize.ONE
          }
          let staticHeld = Shared<Lifetime>.with<bool>(&held, staticLifetime)
          if regions.length == usize.ZERO && staticHeld && List<Shared<Type>>.length(&unresolved) != usize.ZERO {
            run List<Shared<Lifetime>>.append(&mut members, run Shared<Lifetime>.make(anchoredRegion(anchor, caller, expression, ordinal)))
            uncovered = true
          }
          if uncovered && run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, listed, fresh, ordinal, span) {
            let shorter = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
            let replaced = List<Binding>.asMutSlice(&mut inferred.*)
            let mut bindingAt = usize.ZERO
            while bindingAt < replaced.length {
              if replaced[bindingAt].ordinal == ordinal {
                replaced[bindingAt].value = Argument.Lifetime {value: Shared<Lifetime>.clone(&shorter)}
              }
              bindingAt = bindingAt + usize.ONE
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
}

// An inferred lifetime binder that a `'longer: 'binder` bound names shortens to the meet of its held
// region and 'longer when the premises do not already prove the bound, exactly as a `T: 'binder`
// bound shortens it (`boundShortenedBinders`): the bootstrap's region inference chooses the
// shortest region (LIFE-002). A section of `effect<'held> fn f<'data: 'held, 'held>` whose captures
// are owned holds no region, so 'held starts 'static and shortens to the 'data its remaining operand
// lends; a call's result-only binder under `'b: 'a` shortens to the region its argument lends 'b,
// and under several bounds, as `'a: 'c, 'b: 'c`, to the meet of every region they name.
// A written binder, listed in `explicit`, never moves and every parameter must store the binder covariantly; the
// bound proof then runs on the shortened binding. Reports whether any binder shortened.
effect fn outlivesShortenedBinders(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &mut List<Binding>,
  explicit: &[usize], premises: &[Constraint], span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut shortenedAny = false
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  if count == usize.ZERO { return false }
  let parameters = run signatureParameterTypes(signature)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      let applied = run bindConstraint(&value, List<Binding>.asSlice(&inferred.*))
      if let Constraint.Outlives {shorter, ..} = &value {
        let ordinal = freshLifetimeOrdinal(&shorter, fresh)
        let mut current = Option<Shared<Lifetime>>.none()
        if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) {
          if let Option<Argument>.Some {value: Argument.Lifetime {value: held}} = move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), ordinal) {
            current = Option<Shared<Lifetime>>.some(move held)
          }
        }
        if let Option<Shared<Lifetime>>.Some {value: held} = move current {
          if let Constraint.Outlives {longer: required, ..} = &applied {
            let open = run argumentMentionsOwner(&Argument.Lifetime {value: Shared<Lifetime>.clone(&required)}, fresh)
            let proved = run knownOutlives(premises, &required, &held)
            if !open && !proved && run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, listed, fresh, ordinal, span) {
              let mut members = List<Shared<Lifetime>>.make()
              if !Shared<Lifetime>.with<bool>(&held, staticLifetime) { run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&held)) }
              run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&required))
              let shortened = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
              let replaced = List<Binding>.asMutSlice(&mut inferred.*)
              let mut bindingAt = usize.ZERO
              while bindingAt < replaced.length {
                if replaced[bindingAt].ordinal == ordinal {
                  replaced[bindingAt].value = Argument.Lifetime {value: Shared<Lifetime>.clone(&shortened)}
                }
                bindingAt = bindingAt + usize.ONE
              }
              shortenedAny = true
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return shortenedAny
}

// A binder that argument evidence fixed to one of the caller's own regions, as a moved `&'call mut`
// parameter fixes `'w` of `take<'w, 'v: 'w>(req: &'w mut H, head: &V<'v>)`, shortens to the meet of
// that region and the 'longer of each `'longer: 'binder` bound, when only borrows of storage the body
// owns lend 'longer (`ownedLoanRegion`): such a loan can never outlive the call, so the bound never
// holds unshortened. A borrow of a parameter's place or a reborrow could, and is left to the borrow
// check. Unshortened, the bound leaves the relation `local: 'call`, which no borrow check proves.
// Shortened, the call types as its explicit reborrow `take(&mut request.*, &view)` does: every
// parameter stores the binder covariantly, so each operand still meets it by subtyping, and neither a
// declared bound (`boundsAdmitShortening`) nor a bound its signature's types imply
// (`impliedBoundsAdmitShortening`) names it on its longer side. The declared bounds' proof then runs on
// the shortened binding and refuses the call as before; an implied bound names the binder only on its
// shorter side, which a shorter binding still meets.
//
// Unlike `outlivesShortenedBinders`, this never records the call as shortened (`BodyFrame.shortened`).
// That refusal keeps a result-only binder's unshortened rejection for a body the borrow check does not
// prove, because there shortening turns a rejected call into an accepted one. Here every bound the
// shortened binding could fail is a declared one, which still refuses, and the shortened types are
// strictly tighter: its results carry the local region, so a body still left unchecked is no less
// checked than before.
effect fn evidenceShortenedBinders(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &mut List<Binding>,
  explicit: &[usize], premises: &[Constraint], caller: &DeclarationId, nodes: &[BodyNode], span: Span,
) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  if count == usize.ZERO { return () }
  let parameters = run signatureParameterTypes(signature)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < count {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    let mut ordinal = usize.MAX
    let mut current = Option<Shared<Lifetime>>.none()
    let mut longer = Option<Shared<Lifetime>>.none()
    if let Option<Constraint>.Some {value} = move bound {
      if let Constraint.Outlives {shorter, ..} = &value { ordinal = freshLifetimeOrdinal(&shorter, fresh) }
      if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) {
        if let Option<Argument>.Some {value: Argument.Lifetime {value: held}} = move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), ordinal) {
          current = Option<Shared<Lifetime>>.some(move held)
        }
        let applied = run bindConstraint(&value, List<Binding>.asSlice(&inferred.*))
        if let Constraint.Outlives {longer: required, ..} = &applied {
          longer = Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&required))
        }
      }
    }
    if let Option<Shared<Lifetime>>.Some {value: held} = move current {
      if let Option<Shared<Lifetime>>.Some {value: required} = move longer {
        let mut admitted = declaredBodyRegion(&held, caller) && !Lifetime.anyAtom(&held, staticLifetime)
          && callerLocalRegion(&required, caller) && ownedLoanRegion(nodes, &required)
        if admitted { admitted = run parameterStoresBinder(listed, fresh, ordinal) }
        if admitted { admitted = !run knownOutlives(premises, &required, &held) }
        if admitted { admitted = run storedCovariantly(&mut resolver.*, &mut owner.*, &mut dependencies.*, listed, fresh, ordinal, span) }
        if admitted { admitted = run boundsAdmitShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh, ordinal, span) }
        if admitted { admitted = run impliedBoundsAdmitShortening(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, fresh, ordinal, span) }
        if admitted {
          let mut members = List<Shared<Lifetime>>.make()
          run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&held))
          run List<Shared<Lifetime>>.append(&mut members, Shared<Lifetime>.clone(&required))
          let shortened = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
          let replaced = List<Binding>.asMutSlice(&mut inferred.*)
          let mut bindingAt = usize.ZERO
          while bindingAt < replaced.length {
            if replaced[bindingAt].ordinal == ordinal {
              replaced[bindingAt].value = Argument.Lifetime {value: Shared<Lifetime>.clone(&shortened)}
            }
            bindingAt = bindingAt + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Whether no bound the call owes for its signature's types (`signatureImpliedBounds`) names inference
// binder `ordinal` on its longer side alone: a shortened binder could no longer prove it, and an
// implied bound is proved by the region check (`calleeImplied`), never by refusing the call.
// A bound naming the binder on both sides, as `&'x [Tok<'x>]` implies `Tok<'x>: 'x`, shortens with it
// and still holds.
effect fn impliedBoundsAdmitShortening(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, ordinal: usize, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let implied = run signatureImpliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, true, span)
  let listed = List<Constraint>.asSlice(&implied)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    let mut shorter = List<usize>.make()
    match &listed[at] {
      Constraint.Outlives {longer, shorter: region} => {
        run Type.collectOwnedLifetime(&longer, fresh, &mut lifetimes)
        run Type.collectOwnedLifetime(&region, fresh, &mut shorter)
      }
      Constraint.Contents {subject, region} => {
        run Type.collectOwned(&subject, fresh, &mut types, &mut lifetimes, &mut rows)
        run Type.collectOwnedLifetime(&region, fresh, &mut shorter)
      }
      _ => ()
    }
    if containsOrdinal(&lifetimes, ordinal) && !containsOrdinal(&shorter, ordinal) { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether some parameter names inference binder `ordinal`: only then did argument evidence fix it. A
// result-only binder takes its region from the call's context and shortens as `outlivesShortenedBinders`
// decides.
effect fn parameterStoresBinder(listed: &[Shared<Type>], fresh: &DeclarationId, ordinal: usize) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut position = usize.ZERO
  while position < listed.length {
    let mut types = List<usize>.make()
    let mut lifetimes = List<usize>.make()
    let mut rows = List<usize>.make()
    run Type.collectOwned(&listed[position], fresh, &mut types, &mut lifetimes, &mut rows)
    if containsOrdinal(&lifetimes, ordinal) { return true }
    position = position + usize.ONE
  }
  return false
}

// A call argument whose remaining mismatch is a covariant region relation: a region its inferred
// binder already holds differently (`fixedRegionArgument`), or any argument meeting a parameter its
// bindings fully determine (`subtypedCallArgument`).
effect fn relatedCallArgument(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  parameter: &Shared<Type>, pattern: &Shared<Type>, evidence: &Shared<Type>,
  fresh: &DeclarationId, caller: &DeclarationId, variables: &[Shared<DeclarationId>],
  bindings: &[Binding], explicit: &[usize], constraints: &[Constraint], span: Span,
) -> Option<RelatedArgument>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let fixed = run fixedRegionArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, pattern, evidence,
    fresh, caller, variables, bindings, explicit, span)
  let found = match &fixed {
    Option<RelatedArgument>.Some {..} => true
    Option<RelatedArgument>.None => false
  }
  if found { return move fixed }
  return run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, parameter, evidence,
    fresh, caller, variables, bindings, explicit, constraints, span)
}

// An argument whose only mismatch is a covariant region that its inferred binder already holds
// differently: an earlier operand fixed the binder to a caller-local region or 'static. The
// candidate replaces the argument's region with the bound one, and Exact unification with copied
// bindings proves no other mismatch remains; the caller matches the candidate against its real
// bindings. An explicitly written binder is never related. Variance follows the bootstrap
// NominalVariance.
effect fn fixedRegionArgument(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  parameter: &Shared<Type>, pattern: &Shared<Type>, evidence: &Shared<Type>,
  fresh: &DeclarationId, caller: &DeclarationId, variables: &[Shared<DeclarationId>],
  bindings: &[Binding], explicit: &[usize], span: Span,
) -> Option<RelatedArgument>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut relations = List<RegionPair>.make()
  let authored = run Type.copy(parameter)
  let expected = run Type.copy(pattern)
  let actual = run Type.copy(evidence)
  let mut candidate = Option<Type>.none()
  match move expected {
    // Shared slices and references are covariant in their region, so a later operand meets the
    // region an earlier operand fixed for the same inferred binder (`relatesToFixedRegion`).
    Type.Slice {lifetime: boundRegion, ..} => {
      let mut ordinal = usize.MAX
      if let Type.Slice {access, lifetime: binderRegion, ..} = move authored {
        if access == Access.Shared { ordinal = freshLifetimeOrdinal(&binderRegion, fresh) }
      }
      if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) { return Option<RelatedArgument>.none() }
      if let Type.Slice {element, access, lifetime: sourceRegion} = move actual {
        if access != Access.Shared { return Option<RelatedArgument>.none() }
        if !run relatesToFixedRegion(&boundRegion, &sourceRegion, caller, fresh, ordinal, &mut relations) { return Option<RelatedArgument>.none() }
        candidate = Option<Type>.some(Type.Slice {
          element: move element, access: Access.Shared, lifetime: move boundRegion,
        })
      }
    }
    Type.Reference {lifetime: boundRegion, ..} => {
      let mut ordinal = usize.MAX
      let mut writtenReferent = Option<Shared<Type>>.none()
      if let Type.Reference {referent: binderReferent, lifetime: binderRegion, ..} = move authored {
        ordinal = freshLifetimeOrdinal(&binderRegion, fresh)
        writtenReferent = Option<Shared<Type>>.some(move binderReferent)
      }
      if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) { return Option<RelatedArgument>.none() }
      if let Type.Reference {referent, access, lifetime: sourceRegion} = move actual {
        // A binder no earlier operand fixed takes the region the referent itself fixes, as in
        // `&'a mut Holder<'a>`: the loan's region then meets it like an earlier operand's.
        let mut region = move boundRegion
        if freshLifetimeOrdinal(&region, fresh) == ordinal {
          let written = match move writtenReferent {
            Option<Shared<Type>>.Some {value} => move value
            Option<Shared<Type>>.None => { return Option<RelatedArgument>.none() }
          }
          let mut trial = List<Binding>.make()
          let mut at = usize.ZERO
          while at < bindings.length {
            run List<Binding>.append(&mut trial, Binding {
              declaration: Shared<DeclarationId>.clone(&bindings[at].declaration),
              ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value),
            })
            at = at + usize.ONE
          }
          let unified = match move run Type.unify(&written, &referent, variables, Comparison.Exact, &mut trial) {
            Unification.Unified => true
            _ => false
          }
          if !unified { return Option<RelatedArgument>.none() }
          region = match move bindingArgument(List<Binding>.asSlice(&trial), fresh, ordinal) {
            Option<Argument>.Some {value: Argument.Lifetime {value}} => move value
            _ => { return Option<RelatedArgument>.none() }
          }
        }
        if !run relatesToFixedRegion(&region, &sourceRegion, caller, fresh, ordinal, &mut relations) { return Option<RelatedArgument>.none() }
        candidate = Option<Type>.some(Type.Reference {
          referent: move referent, access: access, lifetime: move region,
        })
      }
    }
    // A naked nominal value has no loan adapter. Only a 'static storage lifetime shortens to an
    // originally inferred callee lifetime already fixed by earlier caller-local evidence.
    Type.Nominal {declaration: wantedOwner, arguments: wantedArguments, ..} => {
      if let Type.Nominal {declaration: writtenOwner, arguments: writtenArguments, ..} = move authored {
        if let Type.Nominal {declaration: actualOwner, isPublic, arguments: actualArguments} = move actual {
          let wanted = List<Argument>.asSlice(&wantedArguments)
          let written = List<Argument>.asSlice(&writtenArguments)
          let offered = List<Argument>.asSlice(&actualArguments)
          if !DeclarationId.equals(&writtenOwner, &wantedOwner) || !DeclarationId.equals(&actualOwner, &wantedOwner)
            || written.length != wanted.length || offered.length != wanted.length { return Option<RelatedArgument>.none() }
          let mut changed = List<usize>.make()
          let mut adjusted = List<Argument>.make()
          let mut at = usize.ZERO
          while at < offered.length {
            let mut next = Argument.copy(&offered[at])
            if let Argument.Lifetime {value: sourceRegion} = &offered[at] {
              if let Argument.Lifetime {value: boundRegion} = &wanted[at] {
                if !Lifetime.equalsShared(&sourceRegion, &boundRegion)
                  && callerLocalRegion(&boundRegion, caller) && Shared<Lifetime>.with<bool>(&sourceRegion, staticLifetime) {
                  let ordinal = match &written[at] {
                    Argument.Lifetime {value: binderRegion} => freshLifetimeOrdinal(&binderRegion, fresh)
                    _ => usize.MAX
                  }
                  if ordinal == usize.MAX || fixedOrdinal(explicit, ordinal) {
                    return Option<RelatedArgument>.none()
                  }
                  next = Argument.Lifetime {value: Shared<Lifetime>.clone(&boundRegion)}
                  run List<usize>.append(&mut changed, at)
                }
              }
            }
            run List<Argument>.append(&mut adjusted, move next)
            at = at + usize.ONE
          }
          let positions = List<usize>.asSlice(&changed)
          if positions.length == usize.ZERO { return Option<RelatedArgument>.none() }
          at = usize.ZERO
          while at < positions.length {
            if !run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &actualOwner, positions[at], span) { return Option<RelatedArgument>.none() }
            at = at + usize.ONE
          }
          candidate = Option<Type>.some(Type.Nominal {declaration: move actualOwner, isPublic: isPublic, arguments: move adjusted})
        }
      }
    }
    _ => ()
  }
  let compared = match move candidate {
    Option<Type>.Some {value} => run Types.intern(move value)
    Option<Type>.None => {
      return Option<RelatedArgument>.none()
    }
  }
  let mut proof = List<Binding>.make()
  let mut at = usize.ZERO
  while at < bindings.length {
    run List<Binding>.append(&mut proof, Binding {
      declaration: Shared<DeclarationId>.clone(&bindings[at].declaration),
      ordinal: bindings[at].ordinal, value: Argument.copy(&bindings[at].value),
    })
    at = at + usize.ONE
  }
  let proved = run Type.unify(parameter, &compared, variables, Comparison.Exact, &mut proof)
  return match move proved {
    Unification.Unified => Option<RelatedArgument>.some(RelatedArgument {ty: move compared, relations: move relations})
    _ => Option<RelatedArgument>.none()
  }
}

// The outer loan of a shared reference; exclusive access never participates in this adapter.
fn sharedCallLoan(value: &Type) -> Option<Shared<Lifetime>> {
  if let Type.Reference {access, lifetime, ..} = &value.* {
    if access == Access.Shared { return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime)) }
  }
  return Option<Shared<Lifetime>>.none()
}

// Whether a loan is still a variable of this call, rather than rigid caller evidence.
fn variableCallLoan(region: &Shared<Lifetime>, variables: &[Shared<DeclarationId>]) -> bool {
  let mut at = usize.ZERO
  while at < variables.length {
    if Shared<DeclarationId>.with<bool>(&variables[at], fn(owner: &DeclarationId) -> bool {
      return freshLifetimeOrdinal(region, owner) != usize.MAX
    }) { return true }
    at = at + usize.ONE
  }
  return false
}

// An argument meets a parameter its bindings determine by covariant region subtyping, as at an
// expected-value boundary, such as `&HeaderPolicy<'static>` where an earlier operand fixed
// `&HeaderPolicy<'call>`, or `b"gzip"` for an explicitly written `&'value [u8]`; each caller-local
// relation it needs stays open on the body. Binders only this operand determines, such as the
// loan's own region, are taken from it first; a parameter that still mentions a free binder is
// never related.
effect fn subtypedCallArgument(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  parameter: &Shared<Type>, evidence: &Shared<Type>, fresh: &DeclarationId, caller: &DeclarationId,
  variables: &[Shared<DeclarationId>], bindings: &[Binding], explicit: &[usize], constraints: &[Constraint], span: Span,
) -> Option<RelatedArgument>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut completed = List<Binding>.make()
  let mut copied = usize.ZERO
  while copied < bindings.length {
    run List<Binding>.append(&mut completed, Binding {declaration: Shared<DeclarationId>.clone(&bindings[copied].declaration),
      ordinal: bindings[copied].ordinal, value: Argument.copy(&bindings[copied].value)})
    copied = copied + usize.ONE
  }
  // Exact composite unification rolls back a fresh outer loan when an inner nominal region
  // differs. Infer only that loan on this private candidate; the full variance proof below must
  // still admit every nested component, and the caller commits the candidate transactionally.
  let determined = run Type.applyBindings(parameter, bindings, true)
  let loan = Shared<Type>.with<Option<Shared<Lifetime>>>(&determined, sharedCallLoan)
  let offered = Shared<Type>.with<Option<Shared<Lifetime>>>(evidence, sharedCallLoan)
  if let Option<Shared<Lifetime>>.Some {value: targetRegion} = move loan {
    let ordinal = freshLifetimeOrdinal(&targetRegion, fresh)
    if ordinal != usize.MAX && !fixedOrdinal(explicit, ordinal) && variableCallLoan(&targetRegion, variables) {
      if let Option<Shared<Lifetime>>.Some {value: sourceRegion} = move offered {
        if !variableCallLoan(&sourceRegion, variables) {
          run List<Binding>.append(&mut completed, Binding {
            declaration: run Shared<DeclarationId>.make(DeclarationId.copy(fresh)), ordinal: ordinal,
            value: Argument.Lifetime {value: move sourceRegion},
          })
        }
      }
    }
  }
  // Binders only this operand determines are taken from it too, such as `T` in
  // `value: &'env T` or the referent lifetime in `&'env mut View<'view>` when an earlier operand
  // fixed `'env`. A trial without lifetime evidence can discover them; it never replaces an
  // already inferred or explicitly supplied lifetime. The variance proof below decides every
  // region, including the outer loan of an exclusive reference.
  let mut trial = List<Binding>.make()
  copied = usize.ZERO
  while copied < bindings.length {
    let lifetime = match &bindings[copied].value { Argument.Lifetime {..} => true _ => false }
    if !lifetime {
      run List<Binding>.append(&mut trial, Binding {declaration: Shared<DeclarationId>.clone(&bindings[copied].declaration),
        ordinal: bindings[copied].ordinal, value: Argument.copy(&bindings[copied].value)})
    }
    copied = copied + usize.ONE
  }
  let unified = run Type.unify(parameter, evidence, variables, Comparison.Exact, &mut trial)
  let determines = match &unified { Unification.Unified => true _ => false }
  if determines {
    let found = List<Binding>.asSlice(&trial)
    let mut at = usize.ZERO
    while at < found.length {
      let lifetime = match &found[at].value { Argument.Lifetime {..} => true _ => false }
      let own = Shared<DeclarationId>.with<bool>(&found[at].declaration, fn(owner: &DeclarationId) -> bool {
        return DeclarationId.equals(owner, fresh)
      })
      let known = match move bindingArgumentAt(List<Binding>.asSlice(&completed), found[at].ordinal) {
        Option<Argument>.Some {..} => true
        Option<Argument>.None => false
      }
      if own && !known && (!lifetime || !fixedOrdinal(explicit, found[at].ordinal)) {
        run List<Binding>.append(&mut completed, Binding {declaration: Shared<DeclarationId>.clone(&found[at].declaration),
          ordinal: found[at].ordinal, value: Argument.copy(&found[at].value)})
      }
      at = at + usize.ONE
    }
  }
  let pattern = run Type.applyBindings(parameter, List<Binding>.asSlice(&completed), true)
  if run typeMentionsOwner(&pattern, fresh) { return Option<RelatedArgument>.none() }
  let mut relations = List<RegionPair>.make()
  if !run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, evidence, &pattern, caller, constraints, true,
    &mut relations, span) { return Option<RelatedArgument>.none() }
  return Option<RelatedArgument>.some(RelatedArgument {ty: move pattern, relations: move relations})
}

// The selection fact recorded for one authored syntax node, if this is a selected body.
fn selectedFact(calls: &[ResolvedCall], id: HirId) -> Option<SelectionFact> {
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].id.index == id.index {
      if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Selected {fact}} = &calls[at].result {
        return Option<SelectionFact>.some(match & fact {
          SelectionFact.Embedded {value, ty} => SelectionFact.Embedded {value: Shared<StaticData>.clone(&value), ty: Shared<Type>.clone(&ty)}
          SelectionFact.Condition {selected} => SelectionFact.Condition {selected: selected}
      SelectionFact.StaticFor {iterations} => SelectionFact.StaticFor {iterations: Shared<List<IterationFacts>>.clone(&iterations)}
          SelectionFact.StaticBinding {value: bound} => SelectionFact.StaticBinding {value: StaticValue.copy(&bound)}
          SelectionFact.StaticArguments {slots} => SelectionFact.StaticArguments {slots: Shared<List<StaticSlot>>.clone(&slots)}
        })
      }
    }
    at = at + usize.ONE
  }
  return Option<SelectionFact>.none()
}

// Whether a selected body's pass evaluated this `let static` statement.
fn staticBindingFact(calls: &[ResolvedCall], id: HirId) -> bool {
  let fact = selectedFact(calls, id)
  return match & fact {
    Option<SelectionFact>.Some {value: found} => match & found {
      SelectionFact.StaticBinding {..} => true
      _ => false
    }
    Option<SelectionFact>.None => false
  }
}

// Publishes one selected static value as a checked constant of its exact type.
effect fn embeddedExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId,
  constraints: &[Constraint],
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  value: Shared<StaticData>,
  ty: Shared<Type>,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let index = List<BodyNode>.length(&nodes.*)
  let mismatch = match &expected.* {
    Option<Shared<Type>>.Some {value: wanted} => !run Type.equalsShared(&ty, &wanted)
    Option<Shared<Type>>.None => false
  }
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Embedded {value: move value}},
  })
  if mismatch {
    return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
      BodyNodeId {index: index}, expected, mismatchCode, span)
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
}

// One read of an imported C static, checked at its declared type.
effect fn foreignFunctionAddress(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, nodes: &mut List<BodyNode>,
  requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span, target: &CallTarget,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let refusal = RejectionCode.ForeignFunctionNotFirstClass
  let ty = match &expected.* {
    Option<Shared<Type>>.Some {value} => Shared<Type>.clone(&value)
    _ => { return run bodyRejection(&resolver.*, module, refusal, span) }
  }
  let node = run Type.copy(&ty)
  let mut signatureOption = Option<Shared<Type>>.none()
  let mut behavior = ForeignContract.conservative()
  if let Type.ForeignFunction {signature: selected, behavior: declared} = move node {
    signatureOption = Option<Shared<Type>>.some(move selected)
    behavior = declared
  }
  let contract = match move signatureOption {
    Option<Shared<Type>>.Some {value: selected} => move selected
    _ => { return run bodyRejection(&resolver.*, module, refusal, span) }
  }
  if Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureBinderCount) != usize.ZERO
    || Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureIsEffect)
    || Shared<Result<Answer, NoRejection>>.with<bool>(&target.signature, signatureIsStatic) {
    return run bodyRejection(&resolver.*, module, refusal, span)
  }
  let identity = run Shared<DeclarationId>.make(DeclarationId.copy(&target.declaration))
  let targetModule = DeclarationId.moduleId(&target.declaration)
  let ordinal = match move run ordinalOfIdentity(&mut resolver.*, targetModule, &identity) {
    Option<usize>.Some {value} => value
    _ => { return run bodyRejection(&resolver.*, module, refusal, span) }
  }
  let written = run foreignHeader(&mut resolver.*, targetModule, ordinal)
  if !written.exported || written.global {
    return run bodyRejection(&resolver.*, module, refusal, span)
  }
  if let Option<GapCode>.Some {..} = &written.gap {
    return run bodyRejection(&resolver.*, module, refusal, span)
  }
  let sourceAnswer = run source(&mut resolver.*, targetModule)
  let mut declaredContract = Option<ForeignContract>.none()
  if let Option<&IndexedSource>.Some {value: source} = move sourceOf(&resolver.*, &sourceAnswer, targetModule) {
    let hir = IndexedSource.authored(source)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(source))
    if let Node.FunctionHeader {properties, ..} = Module.node(hir, declarations[ordinal].header) {
      declaredContract = NativeForeign.contract(hir, properties)
    }
  }
  let validBehavior = match move declaredContract {
    Option<ForeignContract>.Some {value: actual} => ForeignContract.same(behavior, actual)
    _ => false
  }
  if !validBehavior { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
  let signatureNode = run Type.copy(&contract)
  let mut parameters = List<Shared<Type>>.make()
  let mut resultOption = Option<Shared<Type>>.none()
  if let Type.Callable {parameters: listed, result: returned, ..} = move signatureNode {
    parameters = move listed resultOption = Option<Shared<Type>>.some(move returned)
  }
  let result = match move resultOption {
    Option<Shared<Type>>.Some {value: selected} => move selected
    _ => { return run bodyRejection(&resolver.*, module, refusal, span) }
  }
  let wanted = List<Shared<Type>>.asSlice(&parameters)
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature, signatureParameterCount)
  if count != wanted.length { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
  let mut at = usize.ZERO
  while at < count {
    let actual = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&target.signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameterAt(answer, at) })
    if let Option<Shared<Type>>.Some {value: parameter} = move actual {
      if !run Type.equalsShared(&parameter, &wanted[at]) { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
    } else { return run bodyRejection(&resolver.*, module, refusal, span) }
    at = at + usize.ONE
  }
  let actualResult = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&target.signature, signatureResult)
  if let Option<Shared<Type>>.Some {value: actual} = move actualResult {
    if !run Type.equalsShared(&actual, &result) { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
  } else { return run bodyRejection(&resolver.*, module, refusal, span) }
  run List<DeclarationId>.append(&mut requiredBodies.*, DeclarationId.copy(&target.declaration))
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.ForeignAddress {
      declaration: move identity, symbol: run Shared<Bytes>.make(move written.symbol),
    }}})
  return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
}

effect fn foreignStaticExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId,
  constraints: &[Constraint],
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  declaration: DeclarationId,
  ty: Shared<Type>,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
) -> Result<BodyNodeId, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let index = List<BodyNode>.length(&nodes.*)
  let mismatch = match &expected.* {
    Option<Shared<Type>>.Some {value: wanted} => !run Type.equalsShared(&ty, &wanted)
    Option<Shared<Type>>.None => false
  }
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.ForeignStatic {
      declaration: run Shared<DeclarationId>.make(move declaration),
    }},
  })
  if mismatch {
    return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
      BodyNodeId {index: index}, expected, mismatchCode, span)
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
}

struct ReflectedBorrowOwner {
  ty: Shared<Type>,
  lifetime: Shared<Lifetime>,
}

fn reflectedMemberSelection(answer: &Result<Answer, NoRejection>, field: &StaticValue.FieldParts)
  -> Option<RecordMemberSelection> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = List<Member>.asSlice(&members)
      if field.ordinal < listed.length {
        let member = &listed[field.ordinal]
        let mut matches = false
        if member.kind == MemberKind.Position && field.kind == 1 {
          matches = Shared<Bytes>.with<bool>(&field.label,
            fn(label: &Bytes) -> bool { return Bytes.length(label) == usize.ZERO })
        } else if member.kind == MemberKind.Field && field.kind == 0 {
          if let Option<Bytes>.Some {value: name} = &member.name {
            matches = Shared<Bytes>.with<bool>(&field.label,
              fn(label: &Bytes) -> bool { return same(Bytes.asSlice(label), Bytes.asSlice(&name)) })
          }
        }
        if matches {
          return Option<RecordMemberSelection>.some(RecordMemberSelection {
            index: field.ordinal, count: listed.length, isPublic: member.isPublic,
          })
        }
      }
    }
  }
  return Option<RecordMemberSelection>.none()
}

// Re-authenticate the descriptor's original lexical authorization and actual applied member.
// A private member is checked against the reflector, even when an ordinary wrapper projects it.
effect fn checkedReflectedMember(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, ty: &Shared<Type>,
  field: &StaticValue.FieldParts, span: Span,
) -> Result<CheckedRecordMember, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let authorizationOrdinal = Shared<DeclarationId>.with<usize>(&field.authorization,
    fn(identity: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(identity))
    })
  if authorizationOrdinal == usize.MAX {
    return Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.UnknownProjectedField, span))
  }
  let authorizationModule = resolvedModule(&resolver.*, authorizationOrdinal)
  let authorization = run ordinalOfIdentity(&mut resolver.*, &authorizationModule, &field.authorization)
  if let Option<usize>.None = move authorization {
    return Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.UnknownProjectedField, span))
  }
  let anonymous = run Type.anonymousParts(ty)
  if let Option<AnonymousParts>.Some {value: parts} = move anonymous {
    let members = List<Shared<Type>>.asSlice(&parts.members)
    let positional = AnonymousOccurrence.isPositional(&parts.occurrence)
    let mut matches = false
    if positional && field.kind == 1 {
      matches = Shared<Bytes>.with<bool>(&field.label,
        fn(label: &Bytes) -> bool { return Bytes.length(label) == usize.ZERO })
    } else if !positional && field.kind == 0 {
      let ordinal = Shared<Bytes>.with<usize>(&field.label,
        fn(label: &Bytes) -> usize { return AnonymousOccurrence.labelIndex(&parts.occurrence, Bytes.asSlice(label)) })
      matches = ordinal == field.ordinal
    }
    if matches && field.ordinal < members.length {
      return Result<CheckedRecordMember, Shared<Rejection>>.succeed(CheckedRecordMember {
        index: field.ordinal, count: members.length, ty: Shared<Type>.clone(&members[field.ordinal]),
      })
    }
    return Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.UnknownProjectedField, span))
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX {
    return Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.ProjectionOnNonStruct, span))
  }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &declaredModule, ty) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.UnknownProjectedField, span)) }
  }
  let declarationAccess123Request = Key {
    family: Family.Members, module: moduleOrdinal, name: usize.ZERO,
    declaration: declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess123 = run internDeclaration(&mut resolver.*, declarationAccess123Request)
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess123, span)
  let nameRejection = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&names, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move nameRejection {
    return Result<CheckedRecordMember, Shared<Rejection>>.failResult(move value)
  }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<RecordMemberSelection>>(&names,
    fn(answer: &Result<Answer, NoRejection>) -> Option<RecordMemberSelection> {
      return reflectedMemberSelection(answer, field)
    })
  let member = match move selected {
    Option<RecordMemberSelection>.Some {value} => value
    Option<RecordMemberSelection>.None => { return Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.UnknownProjectedField, span)) }
  }
  if !member.isPublic && !ModuleId.equals(&authorizationModule, &declaredModule) {
    return Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.InaccessibleProjectedField, span))
  }
  let application = run internApplication(&mut resolver.*, ty)
  let declarationAccess124Request = Key {
    family: Family.MemberShape, module: moduleOrdinal, name: application,
    declaration: declaration, member: member.index, external: false,
  }
  let declarationAccess124 = run internDeclaration(&mut resolver.*, declarationAccess124Request)
  let shape = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess124, span)
  let shapeRejection = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shape, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move shapeRejection {
    return Result<CheckedRecordMember, Shared<Rejection>>.failResult(move value)
  }
  return match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shape, singleMemberType) {
    Option<Shared<Type>>.Some {value} => Result<CheckedRecordMember, Shared<Rejection>>.succeed(
      CheckedRecordMember {index: member.index, count: member.count, ty: move value})
    Option<Shared<Type>>.None => Result<CheckedRecordMember, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
}

// One atomic memory operation (ATOMIC-002 through ATOMIC-004): runtime operands at their
// instantiated types, then each static ordering, embedded as the text the selection pass
// evaluated. A concrete element and every ordering must be admitted by the operation.
effect fn checkAtomicCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span, member: IntrinsicMember,
  typeArguments: &[Shared<Type>], arguments: CallArguments, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if typeArguments.length != intrinsicTypeArity(member) {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, intrinsicTypeArity(member), typeArguments.length))
  }
  if typeArguments.length == usize.ONE && !Type.hasOpenParameters(&typeArguments[usize.ZERO]) {
    let admitted = Shared<Type>.with<bool>(&typeArguments[usize.ZERO], fn(element: &Type) -> bool {
      return CheckedIntrinsic.admitsElement(member, element)
    })
    if !admitted { return run bodyRejection(&resolver.*, module, RejectionCode.InvalidAtomicOperation, span) }
  }
  let orderings = match move CheckedIntrinsic.orderingStart(member) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return CompilerBug.panic(b"MissingRetainedFact: checkAtomicCall") }
  }
  let mut checkedArguments = List<BodyNodeId>.make()
  let mut at = usize.ZERO
  while at < orderings {
    let parameterType = match move run intrinsicGenericParameter(member, typeArguments, at) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return CompilerBug.panic(b"MissingRetainedFact: checkAtomicCall") }
    }
    let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
    let context = Option<Shared<Type>>.some(Shared<Type>.clone(&parameterType))
    let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argumentId, &context,
      RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
    let mut argumentNode = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    let noVariables = List<Shared<DeclarationId>>.make()
    let noBindings = List<Binding>.make()
    argumentNode = run pointerArgument(&mut nodes.*, argumentNode, &parameterType,
      List<Shared<DeclarationId>>.asSlice(&noVariables), List<Binding>.asSlice(&noBindings))
    let valid = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &argumentNode) {
      Option<Shared<Type>>.Some {value} => run Type.equalsShared(&value, &parameterType)
      Option<Shared<Type>>.None => false
    }
    if !valid { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, run bodySpan(&resolver.source, cursor, argumentId)) }
    run List<BodyNodeId>.append(&mut checkedArguments, argumentNode)
    at = at + usize.ONE
  }
  let slots = match move staticArgumentsFact(calls, expression) {
    Option<Shared<List<StaticSlot>>>.Some {value} => move value
    Option<Shared<List<StaticSlot>>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  }
  let mut orders = List<IntrinsicMemoryOrder>.make()
  while at < intrinsicArity(member) {
    let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
    let argumentSpan = run bodySpan(&resolver.source, cursor, argumentId)
    let ordinal = at
    let value = match move Shared<List<StaticSlot>>.with<Option<Shared<StaticData>>>(&slots,
      fn(listed: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(listed, ordinal) }) {
      Option<Shared<StaticData>>.Some {value} => move value
      Option<Shared<StaticData>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, argumentSpan) }
    }
    let order = Shared<StaticData>.with<Option<IntrinsicMemoryOrder>>(&value, fn(data: &StaticData) -> Option<IntrinsicMemoryOrder> {
      return match &data.* {
        StaticData.Text {bytes} => CheckedIntrinsic.memoryOrder(Bytes.asSlice(&bytes))
        _ => Option<IntrinsicMemoryOrder>.none()
      }
    })
    match move order {
      Option<IntrinsicMemoryOrder>.Some {value: selected} => run List<IntrinsicMemoryOrder>.append(&mut orders, selected)
      Option<IntrinsicMemoryOrder>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.InvalidAtomicOperation, argumentSpan)
      }
    }
    let embedded = List<BodyNode>.length(&nodes.*)
    run List<BodyNode>.append(&mut nodes.*, BodyNode {
      origin: run originAt(cursor, argumentId, argumentSpan),
      kind: BodyNodeKind.Expression {ty: run CheckedIntrinsic.staticTextType(), form: BodyExpression.Embedded {value: move value}},
    })
    run List<BodyNodeId>.append(&mut checkedArguments, BodyNodeId {index: embedded})
    at = at + usize.ONE
  }
  let listed = List<IntrinsicMemoryOrder>.asSlice(&orders)
  let success = listed[usize.ZERO]
  let mut failure = IntrinsicMemoryOrder.Relaxed
  if listed.length == 2 { failure = listed[usize.ONE] }
  if !CheckedIntrinsic.admitsOrders(member, success, failure) {
    // Only a compare-exchange's failure ordering can be refused when it takes two.
    let blamed = run bodyArgument(&resolver.source, cursor, arguments, orderings + listed.length - usize.ONE)
    return run bodyRejection(&resolver.*, module, RejectionCode.InvalidAtomicOperation, run bodySpan(&resolver.source, cursor, blamed))
  }
  let ty = match move run intrinsicGenericResult(member, typeArguments) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => run Types.intern(Type.Unit)
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.IntrinsicCall {member: member, arguments: move checkedArguments}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// The static lane indices of a shuffle, embedded as their checked array: one index per result
// lane, each below twice the operands' lane count (SIMD-006).
effect fn shuffleArgument(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, expression: HirId, arguments: CallArguments, typeArguments: &[Shared<Type>], span: Span)
-> Result<BodyNodeId, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let argumentId = run bodyArgument(&resolver.source, cursor, arguments, 2)
  let argumentSpan = run bodySpan(&resolver.source, cursor, argumentId)
  let slots = match move staticArgumentsFact(calls, expression) {
    Option<Shared<List<StaticSlot>>>.Some {value} => move value
    Option<Shared<List<StaticSlot>>>.None => { return run bodyRejection(resolver, module, RejectionCode.StaticPhaseViolation, span) }
  }
  let value = match move Shared<List<StaticSlot>>.with<Option<Shared<StaticData>>>(&slots,
    fn(listed: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(listed, 2) }) {
    Option<Shared<StaticData>>.Some {value} => move value
    Option<Shared<StaticData>>.None => { return run bodyRejection(resolver, module, RejectionCode.StaticPhaseViolation, argumentSpan) }
  }
  let ty = match move run CheckedIntrinsic.shuffleIndices(&typeArguments[usize.ONE]) {
    Option<Shared<Type>>.Some {value: indices} => move indices
    Option<Shared<Type>>.None => {
      let refusal = IntrinsicVectorRefusal.Lane {at: usize.ONE}
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run vectorOperationRejection(module, span, IntrinsicPrimitive.SimdShuffle, typeArguments, refusal),
      )
    }
  }
  let mut count = usize.ZERO
  if let Option<ArrayShape>.Some {value: shape} = move Type.vectorShape(&typeArguments[usize.ONE]) { count = shape.length }
  let mut bound = usize.ZERO
  if let Option<ArrayShape>.Some {value: shape} = move Type.vectorShape(&typeArguments[usize.ZERO]) { bound = shape.length * 2 }
  let valid = Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool { return shuffleIndicesValid(data, count, bound) })
  if !valid {
    let mut diagnostic = run makeRejection(RejectionCode.InvalidVectorShape, module, argumentSpan)
    run vectorArgument(&mut diagnostic, b"template", b"3")
    run vectorArgument(&mut diagnostic, b"operation", b"Intrinsic.simdShuffle")
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"count"), value: run decimalText(count)})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"bound"), value: run decimalText(bound)})
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, argumentId, argumentSpan),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Embedded {value: move value}},
  })
  return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
}

fn shuffleIndicesValid(data: &StaticData, count: usize, bound: usize) -> bool {
  let fields = match &data.* {
    StaticData.Aggregate {fields, ..} => List<Shared<StaticData>>.asSlice(&fields)
    _ => { return false }
  }
  if fields.length != count { return false }
  let limit = usize.toU64(bound)
  let mut at = usize.ZERO
  while at < fields.length {
    let admitted = Shared<StaticData>.with<bool>(&fields[at], fn(field: &StaticData) -> bool {
      return match &field.* {
        StaticData.Integer {sign, magnitude, ..} => sign == StaticSign.Positive && magnitude < limit
        _ => false
      }
    })
    if !admitted { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn checkBorrowFieldCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span, mutableField: bool,
  typeArguments: &[Shared<Type>], arguments: CallArguments, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  let mut access = Access.Shared
  if mutableField { access = Access.Mutable }
  let specified = typeArguments.length == 2
  if !specified && typeArguments.length != usize.ZERO {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, 2, typeArguments.length))
  }
  if CallArguments.length(arguments) != 2 {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  let ownerSyntax = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, ownerSyntax, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints,
    contractBody, false, unsafeAllowed)
  let ownerNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let ownerType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &ownerNode) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return CompilerBug.panic(b"MissingRetainedFact: checkBorrowFieldCall") }
  }
  let borrowed = match move Shared<Type>.with<Option<ReflectedBorrowOwner>>(&ownerType,
    fn(value: &Type) -> Option<ReflectedBorrowOwner> { return reflectedBorrowOwner(value, access) }) {
    Option<ReflectedBorrowOwner>.Some {value} => move value
    Option<ReflectedBorrowOwner>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch,
      run bodySpan(&resolver.source, cursor, ownerSyntax)) }
  }
  let appliedOwner = run selectedBodyComparedType(&resolver.*, &borrowed.ty)
  if specified {
    let writtenOwner = run selectedBodyComparedType(&resolver.*, &typeArguments[usize.ZERO])
    if !run Type.equalsShared(&appliedOwner, &writtenOwner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch,
        run bodySpan(&resolver.source, cursor, ownerSyntax))
    }
  }
  let fieldSyntax = run bodyArgument(&resolver.source, cursor, arguments, usize.ONE)
  let fieldSpan = run bodySpan(&resolver.source, cursor, fieldSyntax)
  let selected = match move staticArgumentsFact(calls, expression) {
    Option<Shared<List<StaticSlot>>>.Some {value} => move value
    Option<Shared<List<StaticSlot>>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, fieldSpan)
    }
  }
  let descriptorValue = match move Shared<List<StaticSlot>>.with<Option<Shared<StaticData>>>(&selected,
    fn(slots: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(slots, usize.ONE) }) {
    Option<Shared<StaticData>>.Some {value} => move value
    Option<Shared<StaticData>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, fieldSpan) }
  }
  let field = match move Shared<StaticData>.with<Option<StaticValue.FieldParts>>(&descriptorValue, StaticValue.fieldParts) {
    Option<StaticValue.FieldParts>.Some {value} => move value
    Option<StaticValue.FieldParts>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, fieldSpan) }
  }
  // A union variant's field is not a place of the union: only its active variant holds it.
  if field.kind > 1 { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, fieldSpan) }
  let described = match move Shared<Type>.with<Option<CheckedIntrinsic.FieldTypes>>(&field.ty, CheckedIntrinsic.fieldTypes) {
    Option<CheckedIntrinsic.FieldTypes>.Some {value} => move value
    Option<CheckedIntrinsic.FieldTypes>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, fieldSpan) }
  }
  let exactOwner = run Type.equalsShared(&described.owner, &appliedOwner)
  if !exactOwner {
    return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, fieldSpan)
  }
  if specified {
    let writtenValue = run selectedBodyComparedType(&resolver.*, &typeArguments[usize.ONE])
    if !run Type.equalsShared(&described.value, &writtenValue) {
      // Name the field the repetition reached, since one `static for` checks every field.
      let error = run typeMismatchRejection(&resolver.*, module, RejectionCode.TypeMismatch, fieldSpan, &writtenValue,
        &described.value)
      let label = Shared<Bytes>.with<usize>(&field.label, fn(value: &Bytes) -> usize { return Bytes.length(value) })
      if label != usize.ZERO {
        let mut note = run Bytes.copy(b"field ")
        let mut name = Bytes.make()
        let mut at = usize.ZERO
        while at < label {
          let byte = Shared<Bytes>.with<u8>(&field.label, fn(value: &Bytes) -> u8 { return Bytes.asSlice(value)[at] })
          run Bytes.append(&mut name, &[byte])
          at = at + usize.ONE
        }
        run appendQuoted(&mut note, Bytes.asSlice(&name))
        if let Option<Bytes>.Some {value: text} = move run TypeText.display(&described.value, module) {
          run Bytes.append(&mut note, b" has type ")
          run appendQuoted(&mut note, Bytes.asSlice(&text))
        }
        run appendRejectionArgument(&error, b"note", Bytes.asSlice(&note))
      }
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let authenticated = run checkedReflectedMember(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, &appliedOwner, &field, fieldSpan)
  let mut member = match move authenticated {
    Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => move value
    Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  if !run Type.equalsShared(&member.ty, &described.value) {
    return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, fieldSpan)
  }
  // The comparison uses this selection's exact applied types. Keep a written Value symbolic
  // in the residual body, so ordinary result checking and MIR substitute it with its owner.
  if specified { member.ty = Shared<Type>.clone(&typeArguments[usize.ONE]) } else {
    // An inferred intrinsic in a generic wrapper can return the wrapper's symbolic Value.
    // Reuse that spelling only after exact equality in this selected application's domain.
    if let Option<Shared<Type>>.Some {value: wanted} = &expected.* {
      let symbolic = Shared<Type>.with<Option<Shared<Type>>>(&wanted, fn(value: &Type) -> Option<Shared<Type>> {
        return match &value.* {
          Type.Reference {referent, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
          _ => Option<Shared<Type>>.none()
        }
      })
      if let Option<Shared<Type>>.Some {value} = move symbolic {
        let applied = run selectedBodyComparedType(&resolver.*, &value)
        if run Type.equalsShared(&applied, &member.ty) { member.ty = move value }
      }
    }
  }
  return run reflectedFieldBorrow(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    cursor, caller, constraints, &mut nodes.*, expression, span, ownerNode, move borrowed, move member, access, expected, mismatchCode)
}

// Checks `tests()`, `testInfo(descriptor)` and `testFunction(static descriptor)` (TEST-004). The
// first two are static-only and yield the sealed catalog and metadata types. `testFunction` reads
// its descriptor from the selected static slot and is exactly the authenticated test function
// named as a value: its application with no captures.
effect fn checkTestDiscoveryCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span, member: IntrinsicMember,
  typeArguments: &[Shared<Type>], arguments: CallArguments, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let tests = CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.Tests)
  if typeArguments.length > usize.ONE || (tests && typeArguments.length != usize.ZERO) {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, CheckedIntrinsic.typeArity(member), typeArguments.length))
  }
  if CallArguments.length(arguments) != intrinsicArity(member) {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.TestFunction) {
    if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
    let argumentSyntax = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
    let argumentSpan = run bodySpan(&resolver.source, cursor, argumentSyntax)
    let slots = match move staticArgumentsFact(calls, expression) {
      Option<Shared<List<StaticSlot>>>.Some {value} => move value
      Option<Shared<List<StaticSlot>>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, argumentSpan) }
    }
    let descriptor = match move Shared<List<StaticSlot>>.with<Option<Shared<StaticData>>>(&slots,
      fn(listed: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(listed, usize.ZERO) }) {
      Option<Shared<StaticData>>.Some {value} => move value
      Option<Shared<StaticData>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, argumentSpan) }
    }
    let selected = match move run selectedTestEntry(&mut resolver.*, &mut owner.*, &mut dependencies.*, &descriptor, module, argumentSpan) {
      Result<SelectedTest, Shared<Rejection>>.Success {value} => move value
      Result<SelectedTest, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    if typeArguments.length == usize.ONE {
      let written = run selectedBodyComparedType(&resolver.*, &typeArguments[usize.ZERO])
      if !run Type.equalsShared(&written, &selected.callable) { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span) }
    }
    let declaration = Shared<TestCatalog>.with<Shared<DeclarationId>>(&selected.catalog, fn(held: &TestCatalog) -> Shared<DeclarationId> {
      let entries = List<TestEntry>.asSlice(&held.entries)
      return Shared<DeclarationId>.clone(&entries[selected.ordinal].declaration)
    })
    run List<DeclarationId>.append(&mut requiredBodies.*, DeclarationId.copyShared(&declaration))
    run List<SignatureDependency>.append(&mut signatures.*, SignatureDependency {declaration: DeclarationId.copyShared(&declaration)})
    return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
      expression, span, Shared<Type>.clone(&selected.callable), BodyExpression.Aggregate {fields: List<BodyAggregateField>.make(), written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()},
      false, expected, mismatchCode, contractBody, false)
  }
  if !staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  let mut checkedArguments = List<BodyNodeId>.make()
  let mut ty = run CheckedIntrinsic.testsType()
  if !tests {
    let argumentId = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
    let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argumentId, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
      constraints, contractBody, staticBody, unsafeAllowed)
    let argumentNode = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    let argumentType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &argumentNode) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return CompilerBug.panic(b"MissingRetainedFact: checkTestDiscoveryCall") }
    }
    let callable = match move Shared<Type>.with<Option<Shared<Type>>>(&argumentType, CheckedIntrinsic.testCallable) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, run bodySpan(&resolver.source, cursor, argumentId))
      }
    }
    if typeArguments.length == usize.ONE && !run Type.equalsShared(&typeArguments[usize.ZERO], &callable) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    run List<BodyNodeId>.append(&mut checkedArguments, argumentNode)
    ty = run CheckedIntrinsic.testInfoType()
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !run Type.equalsShared(&ty, &value) { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.IntrinsicCall {member: member, arguments: move checkedArguments}},
  })
  return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
}

// Projection authority accepts an actual reference of exactly the projection's access, without
// promoting owned operands or weakening a mutable one. The result retains that descriptor's
// complete validity region.
fn reflectedBorrowOwner(value: &Type, wanted: Access) -> Option<ReflectedBorrowOwner> {
  if let Type.Reference {referent, access, lifetime} = &value.* {
    if access == wanted {
      return Option<ReflectedBorrowOwner>.some(ReflectedBorrowOwner {
        ty: Shared<Type>.clone(&referent), lifetime: Shared<Lifetime>.clone(&lifetime),
      })
    }
  }
  return Option<ReflectedBorrowOwner>.none()
}

// A consumed static descriptor contributes no runtime operand. Its authenticated projection is
// the same ordinary referent place and loan of `access` used by authored field borrowing.
effect fn reflectedFieldBorrow(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  constraints: &[Constraint], nodes: &mut List<BodyNode>, expression: HirId, span: Span,
  ownerNode: BodyNodeId, borrowed: ReflectedBorrowOwner, field: CheckedRecordMember, access: Access,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let origin = run originAt(cursor, expression, span)
  let referentNode = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: move borrowed.ty,
      form: BodyExpression.Dereference {value: ownerNode}}})
  let fieldNode = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&field.ty),
      form: BodyExpression.Field {value: referentNode, index: field.index, declared: Shared<Type>.clone(&field.ty)}}})
  let result = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  let ty = run Types.intern(Type.Reference {referent: move field.ty,
    access: access, lifetime: move borrowed.lifetime})
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: move ty,
      form: BodyExpression.Borrow {access: access, value: fieldNode}}})
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    caller, constraints, &mut nodes.*, result, expected, mismatchCode, span)
}

// The variant a static descriptor argument selects: its union at this selection's applied
// types, its tag, and the declaration whose module decides which of its fields are visible.
struct ReflectedVariant {
  owner: Shared<Type>,
  tag: usize,
  authorization: Shared<DeclarationId>,
}

// Reads the `Intrinsic.Variant<Union>` descriptor a call's static slot `slot` selected.
effect fn reflectedVariantArgument(resolver: &Resolver, module: &ModuleId, calls: &[ResolvedCall], expression: HirId,
  slot: usize, span: Span) -> Result<ReflectedVariant, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let selected = match move staticArgumentsFact(calls, expression) {
    Option<Shared<List<StaticSlot>>>.Some {value} => move value
    Option<Shared<List<StaticSlot>>>.None => {
      return Result<ReflectedVariant, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.Unsupported, span))
    }
  }
  let descriptor = match move Shared<List<StaticSlot>>.with<Option<Shared<StaticData>>>(&selected,
    fn(slots: &List<StaticSlot>) -> Option<Shared<StaticData>> { return staticSlotValue(slots, slot) }) {
    Option<Shared<StaticData>>.Some {value} => move value
    Option<Shared<StaticData>>.None => {
      return Result<ReflectedVariant, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.StaticPhaseViolation, span))
    }
  }
  let parts = match move Shared<StaticData>.with<Option<StaticValue.FieldParts>>(&descriptor, StaticValue.fieldParts) {
    Option<StaticValue.FieldParts>.Some {value} => move value
    Option<StaticValue.FieldParts>.None => {
      return Result<ReflectedVariant, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.TypeMismatch, span))
    }
  }
  let described = match move Shared<Type>.with<Option<Shared<Type>>>(&parts.ty, CheckedIntrinsic.variantOwner) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return Result<ReflectedVariant, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.TypeMismatch, span))
    }
  }
  if parts.kind != StaticValue.variantKind {
    return Result<ReflectedVariant, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.TypeMismatch, span))
  }
  return Result<ReflectedVariant, Shared<Rejection>>.succeed(ReflectedVariant {owner: move described, tag: parts.ordinal,
    authorization: move parts.authorization})
}

// Checks `makeVariant<Union, Fields>(static variant, fields)`. The variant's fields come from a
// tuple of them in declaration order, or `()` for a unit variant. A tuple literal supplies each
// field as its own operand; a local tuple, as `Reflect.makeVariant` passes its parameter, is
// moved out of field by field. Either way the call is exactly the written variant construction.
effect fn checkMakeVariantCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span,
  typeArguments: &[Shared<Type>], arguments: CallArguments, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  let specified = typeArguments.length == 2
  if !specified && typeArguments.length != usize.ZERO {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, 2, typeArguments.length))
  }
  if CallArguments.length(arguments) != 2 { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  let variantSyntax = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
  let variantSpan = run bodySpan(&resolver.source, cursor, variantSyntax)
  let variant = match move run reflectedVariantArgument(&resolver.*, module, calls, expression, usize.ZERO, variantSpan) {
    Result<ReflectedVariant, Shared<Rejection>>.Success {value} => move value
    Result<ReflectedVariant, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  // The construction has the union's written spelling when the call writes it, so a generic
  // wrapper's residual body keeps its symbolic `Union`.
  let mut resultType = Shared<Type>.clone(&variant.owner)
  if specified {
    let written = run selectedBodyComparedType(&resolver.*, &typeArguments[usize.ZERO])
    if !run Type.equalsShared(&written, &variant.owner) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, variantSpan)
    }
    resultType = Shared<Type>.clone(&typeArguments[usize.ZERO])
  } else if let Option<Shared<Type>>.Some {value: wanted} = &expected.* {
    let applied = run selectedBodyComparedType(&resolver.*, &wanted)
    if run Type.equalsShared(&applied, &variant.owner) { resultType = Shared<Type>.clone(&wanted) }
  }
  let nominal = match move run nominalUnionOf(&mut resolver.*, &variant.owner) {
    Option<NominalUnion>.Some {value} => value
    Option<NominalUnion>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, variantSpan) }
  }
  let shape = match move run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &variant.owner, &nominal,
    variant.tag, span) {
    Result<VariantShape, Shared<Rejection>>.Success {value} => move value
    Result<VariantShape, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  // Construction needs every field, so each must be visible where the descriptor was reflected.
  let authorityModule = Shared<DeclarationId>.with<ModuleId>(&variant.authorization, fn(identity: &DeclarationId) -> ModuleId {
    return ModuleId.copy(DeclarationId.moduleId(identity))
  })
  let types = List<Shared<Type>>.asSlice(&shape.types)
  let mut field = usize.ZERO
  while field < types.length {
    if !variantFieldVisible(&resolver.*, &authorityModule, &shape, field) {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run inaccessibleConstructionRejection(module, span, &variant.owner, Bytes.asSlice(&shape.variant)))
    }
    field = field + usize.ONE
  }
  let fieldsSyntax = run bodyArgument(&resolver.source, cursor, arguments, usize.ONE)
  let fieldsSpan = run bodySpan(&resolver.source, cursor, fieldsSyntax)
  let mut operands = List<BodyAggregateField>.make()
  match run bodyNode(&resolver.source, cursor, fieldsSyntax) {
    Node.TupleExpression {elements} => {
      if elements.length != types.length {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run variantFieldCountRejection(&resolver.*, module, fieldsSpan, &shape))
      }
      let mut at = usize.ZERO
      while at < types.length {
        let element = run bodyChild(&resolver.source, cursor, elements, at)
        let context = Option<Shared<Type>>.some(Shared<Type>.clone(&types[at]))
        let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
          element, &context, RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
        let operand = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            let names = List<Bytes>.asSlice(&shape.names)
            return Result<BodyNodeId, Shared<Rejection>>.failResult(run namedFieldRejection(move error, Bytes.asSlice(&names[at])))
          }
        }
        run List<BodyAggregateField>.append(&mut operands, BodyAggregateField {index: at, value: operand})
        at = at + usize.ONE
      }
    }
    Node.UnitLiteral => {
      if types.length != usize.ZERO {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run variantFieldCountRejection(&resolver.*, module, fieldsSpan, &shape))
      }
    }
    _ => {
      let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
        module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        fieldsSyntax, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
      let tupleNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      let tupleType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &tupleNode) {
        Option<Shared<Type>>.Some {value} => move value
        Option<Shared<Type>>.None => { return CompilerBug.panic(b"MissingRetainedFact: checkMakeVariantCall") }
      }
      let applied = run selectedBodyComparedType(&resolver.*, &tupleType)
      if !run variantFieldsMatch(&applied, types) {
        let error = run typeMismatchRejection(&resolver.*, module, RejectionCode.TypeMismatch, fieldsSpan,
          &run variantFieldsTuple(&shape), &applied)
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
      let local = match &List<BodyNode>.asSlice(&nodes.*)[tupleNode.index].kind {
        BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => Option<BodyLocalId>.some(local)
        _ => Option<BodyLocalId>.none()
      }
      let mut held = BodyLocalId {index: usize.ZERO}
      if let Option<BodyLocalId>.Some {value} = move local { held = value } else if types.length != usize.ZERO {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, fieldsSpan)
      }
      let origin = run originAt(cursor, fieldsSyntax, fieldsSpan)
      let mut at = usize.ZERO
      while at < types.length {
        // The checked local is the first field's subject; each later field reads the local again.
        let mut subject = tupleNode
        if at != usize.ZERO {
          subject = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
          run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
            kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&tupleType), form: BodyExpression.Local {local: held}}})
        }
        let fieldNode = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
          kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&types[at]),
            form: BodyExpression.Field {value: subject, index: at, declared: Shared<Type>.clone(&types[at])}}})
        let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &types[at], constraints, fieldsSpan) {
          Result<bool, Shared<Rejection>>.Success {value} => value
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        let mut operand = fieldNode
        if !copied {
          let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
            List<BodyNode>.asSlice(&nodes.*), fieldNode, false, false, fieldsSpan, fieldsSpan, constraints) {
            Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
            Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
          }
          operand = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
          run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
            kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&types[at]), form: BodyExpression.Move {value: fieldNode, consumed: move consumed}}})
        }
        run List<BodyAggregateField>.append(&mut operands, BodyAggregateField {index: at, value: operand})
        at = at + usize.ONE
      }
    }
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move resultType, form: BodyExpression.VariantConstruct {tag: variant.tag, fields: move operands}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// Whether `supplied` is the tuple of a variant's field types in declaration order, or `()` for a
// variant without fields.
effect fn variantFieldsMatch(supplied: &Shared<Type>, types: &[Shared<Type>]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let parts = run Type.anonymousParts(supplied)
  if let Option<AnonymousParts>.Some {value: written} = move parts {
    if !AnonymousOccurrence.isPositional(&written.occurrence) { return false }
    let members = List<Shared<Type>>.asSlice(&written.members)
    if members.length != types.length { return false }
    let mut at = usize.ZERO
    while at < members.length {
      if !run Type.equalsShared(&members[at], &types[at]) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return types.length == usize.ZERO && Shared<Type>.with<bool>(supplied, unitShape)
}

// The tuple a variant's fields form, for a mismatch diagnostic.
effect fn variantFieldsTuple(shape: &VariantShape) -> Shared<Type> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<Shared<Type>>.length(&shape.types) == usize.ZERO { return run Types.intern(Type.Unit) }
  let identity = run DeclarationId.fromParts(run ModuleId.make(b"compiler-sealed-intrinsic", b"silk", b"Intrinsic"), List<OwnerStep>.make())
  let occurrence = run Shared<AnonymousOccurrence>.make(AnonymousOccurrence {
    declaration: run Shared<DeclarationId>.make(move identity), syntax: usize.ZERO, positional: true, labels: List<Bytes>.make(),
  })
  return run Types.intern(Type.Anonymous {occurrence: move occurrence, members: run copyTypes(List<Shared<Type>>.asSlice(&shape.types))})
}

// A tuple with the wrong number of fields for its variant (SEM0012), naming the fields.
effect fn variantFieldCountRejection(resolver: &Resolver, module: &ModuleId, span: Span, shape: &VariantShape) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let error = run reject(resolver, module, RejectionCode.TypeMismatch, span)
  let names = List<Bytes>.asSlice(&shape.names)
  let mut note = run Bytes.copy(b"variant ")
  run appendQuoted(&mut note, Bytes.asSlice(&shape.variant))
  if names.length == usize.ZERO { run Bytes.append(&mut note, b" has no fields, so it takes `()`") } else {
    run Bytes.append(&mut note, b" takes a tuple of its fields in order: ")
    let mut at = usize.ZERO
    while at < names.length {
      if at != usize.ZERO { run Bytes.append(&mut note, b", ") }
      run appendQuoted(&mut note, Bytes.asSlice(&names[at]))
      at = at + usize.ONE
    }
  }
  run appendRejectionArgument(&error, b"note", Bytes.asSlice(&note))
  return move error
}

// Checks `isVariant<Union>(owner, static variant)`: exactly `match &owner.* { the variant => true,
// _ => false }`.
effect fn checkIsVariantCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, expression: HirId, span: Span,
  typeArguments: &[Shared<Type>], arguments: CallArguments, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  if typeArguments.length > usize.ONE {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, usize.ONE, typeArguments.length))
  }
  if CallArguments.length(arguments) != 2 { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  let ownerSyntax = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
  let ownerSpan = run bodySpan(&resolver.source, cursor, ownerSyntax)
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, ownerSyntax, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints,
    contractBody, false, unsafeAllowed)
  let ownerNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let ownerType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &ownerNode) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return CompilerBug.panic(b"MissingRetainedFact: checkIsVariantCall") }
  }
  let borrowed = match move Shared<Type>.with<Option<ReflectedBorrowOwner>>(&ownerType,
    fn(value: &Type) -> Option<ReflectedBorrowOwner> { return reflectedBorrowOwner(value, Access.Shared) }) {
    Option<ReflectedBorrowOwner>.Some {value} => move value
    Option<ReflectedBorrowOwner>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, ownerSpan) }
  }
  let appliedOwner = run selectedBodyComparedType(&resolver.*, &borrowed.ty)
  if typeArguments.length == usize.ONE {
    let written = run selectedBodyComparedType(&resolver.*, &typeArguments[usize.ZERO])
    if !run Type.equalsShared(&appliedOwner, &written) { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, ownerSpan) }
  }
  let variantSyntax = run bodyArgument(&resolver.source, cursor, arguments, usize.ONE)
  let variantSpan = run bodySpan(&resolver.source, cursor, variantSyntax)
  let variant = match move run reflectedVariantArgument(&resolver.*, module, calls, expression, usize.ONE, variantSpan) {
    Result<ReflectedVariant, Shared<Rejection>>.Success {value} => move value
    Result<ReflectedVariant, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  if !run Type.equalsShared(&variant.owner, &appliedOwner) { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, variantSpan) }
  let nominal = match move run nominalUnionOf(&mut resolver.*, &variant.owner) {
    Option<NominalUnion>.Some {value} => value
    Option<NominalUnion>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, variantSpan) }
  }
  let origin = run originAt(cursor, expression, span)
  let boolean = run primitiveType(b"bool")
  let subject = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, ownerSyntax, ownerSpan),
    kind: BodyNodeKind.Expression {ty: move borrowed.ty, form: BodyExpression.Dereference {value: ownerNode}}})
  let selected = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&boolean), form: BodyExpression.Boolean {value: true}}})
  let mut arms = List<BodyMatchArm>.make()
  run List<BodyMatchArm>.append(&mut arms, BodyMatchArm {origin: origin, pattern: BodyPattern.Variant {tag: variant.tag},
    tests: List<BodyPatternTest>.make(), guard: Option<BodyNodeId>.none(), result: selected, bindings: List<BodyNodeId>.make()})
  // A union with one variant always holds it; any other has an arm for the rest.
  if nominal.count != usize.ONE {
    let other = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
      kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&boolean), form: BodyExpression.Boolean {value: false}}})
    run List<BodyMatchArm>.append(&mut arms, BodyMatchArm {origin: origin, pattern: BodyPattern.Universal,
      tests: List<BodyPatternTest>.make(), guard: Option<BodyNodeId>.none(), result: other, bindings: List<BodyNodeId>.make()})
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: move boolean, form: BodyExpression.Match {subject: subject,
      access: BodySubjectAccess.Place {access: BodyBindingAccess.Shared}, tags: nominal.count, domain: nominal.count,
      arms: move arms, syntax: BodyMatchSyntax.Match}}})
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// Checks one static reflection call. The owner is the call's single resolved type argument:
// `reflectType<Owner>()` yields `Intrinsic.Type<Owner>`, and `reflectTypeKind<Owner>` accepts
// exactly that descriptor and yields `u8`.
effect fn checkReflectionCall<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  member: IntrinsicMember,
  typeArguments: &[Shared<Type>],
  arguments: CallArguments,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if typeArguments.length != CheckedIntrinsic.typeArity(member) {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run rejectArity(&resolver.*, module, span, CheckedIntrinsic.typeArity(member), typeArguments.length))
  }
  let mut descriptor = run Types.intern(Type.TypeDescriptor {owner: Shared<Type>.clone(&typeArguments[usize.ZERO])})
  let field = CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectFieldKind) ||
    CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectFieldLabel) || CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectFieldOrdinal)
  if field {descriptor = run CheckedIntrinsic.fieldType(&typeArguments[usize.ZERO], &typeArguments[usize.ONE])}
  if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectFields) {descriptor = run CheckedIntrinsic.fieldsType(&typeArguments[usize.ZERO])}
  let variantLabel = CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectVariantLabel)
  let variantFields = CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectVariantFields)
  if variantLabel || variantFields {descriptor = run CheckedIntrinsic.variantType(&typeArguments[usize.ZERO])}
  if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectVariants) {descriptor = run CheckedIntrinsic.variantsType(&typeArguments[usize.ZERO])}
  let mut checkedArguments = List<BodyNodeId>.make()
  let mut ty = Shared<Type>.clone(&descriptor)
  if CallArguments.length(arguments) == usize.ONE {
    let context = Option<Shared<Type>>.some(Shared<Type>.clone(&descriptor))
    let argumentId = run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)
    let checked = run checkExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argumentId, &context, RejectionCode.TypeMismatch,
      constraints, contractBody, staticBody, unsafeAllowed,
    )
    let argumentNode = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    let evidence = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &argumentNode)
    let valid = match move evidence {
      Option<Shared<Type>>.Some {value} => run Type.equalsShared(&value, &descriptor)
      Option<Shared<Type>>.None => false
    }
    if !valid {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    run List<BodyNodeId>.append(&mut checkedArguments, argumentNode)
    ty = run primitiveType(b"u8")
    if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectFieldOrdinal) {ty = run primitiveType(b"usize")}
    if CheckedIntrinsic.isPrimitive(member, IntrinsicPrimitive.ReflectFieldLabel) || variantLabel {
      ty = run Types.intern(Type.String {lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
    }
    if variantFields {ty = run CheckedIntrinsic.fieldsType(&typeArguments[usize.ZERO])}
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !run Type.equalsShared(&ty, &value) {
      return run bodyRejection(&resolver.*, module, mismatchCode, span)
    }
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(
    &mut nodes.*,
    BodyNode {
      origin: run originAt(cursor, expression, span),
      kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.IntrinsicCall {member: member, arguments: move checkedArguments}},
    },
  )
  return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
}

struct PatternBindingUse {
  ty: Shared<Type>,
  form: BodyExpression,
}

effect fn copyUnionMember(member: &Option<BodyUnionMember>) -> Option<BodyUnionMember> ! OutOfMemoryError ? &mut Allocator {
  return match &member.* {
    Option<BodyUnionMember>.Some {value} => Option<BodyUnionMember>.some(BodyUnionMember {tag: value.tag, ty: Shared<Type>.clone(&value.ty), source: Shared<Type>.clone(&value.source)})
    Option<BodyUnionMember>.None => Option<BodyUnionMember>.none()
  }
}

effect fn copySteps(path: &List<BodyPlaceStep>) -> List<BodyPlaceStep> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<BodyPlaceStep>.make()
  let listed = List<BodyPlaceStep>.asSlice(path)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut step = BodyPlaceStep.Field {index: usize.ZERO}
    if let BodyPlaceStep.Member {tag, ty, source} = &listed[at] { step = BodyPlaceStep.Member {tag: tag, ty: Shared<Type>.clone(&ty), source: Shared<Type>.clone(&source)} }
    if let BodyPlaceStep.VariantField {tag, field} = &listed[at] { step = BodyPlaceStep.VariantField {tag: tag, field: field} }
    if let BodyPlaceStep.Field {index} = &listed[at] { step = BodyPlaceStep.Field {index: index} }
    if let BodyPlaceStep.Element {index} = &listed[at] { step = BodyPlaceStep.Element {index: index} }
    run List<BodyPlaceStep>.append(&mut copied, move step)
    at = at + usize.ONE
  }
  return move copied
}

effect fn extendedPath(path: &List<BodyPlaceStep>, step: BodyPlaceStep) -> List<BodyPlaceStep> ! OutOfMemoryError ? &mut Allocator {
  let mut extended = run copySteps(path)
  run List<BodyPlaceStep>.append(&mut extended, move step)
  return move extended
}

// Coverage mirrors the bootstrap row model: the uncovered values are rows, each a top-level member
// plus the tags its nested union paths may still hold; an absent path may hold any tag.
struct CoverageConstraint {
  path: List<BodyPlaceStep>,
  allowed: List<bool>,
}

struct CoverageRow {
  member: usize,
  constraints: List<CoverageConstraint>,
}

fn sameStep(left: &BodyPlaceStep, right: &BodyPlaceStep) -> bool {
  if let BodyPlaceStep.Member {tag, ..} = &left.* {
    if let BodyPlaceStep.Member {tag: other, ..} = &right.* { return tag == other }
  }
  if let BodyPlaceStep.VariantField {tag, field} = &left.* {
    if let BodyPlaceStep.VariantField {tag: otherTag, field: otherField} = &right.* { return tag == otherTag && field == otherField }
  }
  if let BodyPlaceStep.Field {index} = &left.* {
    if let BodyPlaceStep.Field {index: other} = &right.* { return index == other }
  }
  return false
}

fn samePath(left: &List<BodyPlaceStep>, right: &List<BodyPlaceStep>) -> bool {
  let first = List<BodyPlaceStep>.asSlice(left)
  let second = List<BodyPlaceStep>.asSlice(right)
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if !sameStep(&first[at], &second[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

// The tags `test.path` may still hold in `row`.
effect fn allowedTags(row: &CoverageRow, test: &BodyPatternTest) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut tags = List<bool>.make()
  let constraints = List<CoverageConstraint>.asSlice(&row.constraints)
  let mut at = usize.ZERO
  while at < constraints.length {
    if samePath(&constraints[at].path, &test.path) {
      let listed = List<bool>.asSlice(&constraints[at].allowed)
      let mut tag = usize.ZERO
      while tag < listed.length {
        run List<bool>.append(&mut tags, listed[tag])
        tag = tag + usize.ONE
      }
      return move tags
    }
    at = at + usize.ONE
  }
  while List<bool>.length(&tags) < test.tags { run List<bool>.append(&mut tags, true) }
  return move tags
}

// `row` with `test.path` restricted to exactly `allowed`.
effect fn constrainedRow(row: &CoverageRow, test: &BodyPatternTest, allowed: List<bool>) -> CoverageRow ! OutOfMemoryError ? &mut Allocator {
  let mut constraints = List<CoverageConstraint>.make()
  let prior = List<CoverageConstraint>.asSlice(&row.constraints)
  let mut at = usize.ZERO
  while at < prior.length {
    if !samePath(&prior[at].path, &test.path) {
      let mut kept = List<bool>.make()
      let listed = List<bool>.asSlice(&prior[at].allowed)
      let mut tag = usize.ZERO
      while tag < listed.length {
        run List<bool>.append(&mut kept, listed[tag])
        tag = tag + usize.ONE
      }
      run List<CoverageConstraint>.append(&mut constraints, CoverageConstraint {path: run copySteps(&prior[at].path), allowed: move kept})
    }
    at = at + usize.ONE
  }
  run List<CoverageConstraint>.append(&mut constraints, CoverageConstraint {path: run copySteps(&test.path), allowed: move allowed})
  return CoverageRow {member: row.member, constraints: move constraints}
}

// Whether an arm with these nested tests can select some value of `row`.
effect fn rowIntersects(row: &CoverageRow, tests: &List<BodyPatternTest>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let listed = List<BodyPatternTest>.asSlice(tests)
  let mut at = usize.ZERO
  while at < listed.length {
    let allowed = run allowedTags(row, &listed[at])
    let flags = List<bool>.asSlice(&allowed)
    if !flags[listed[at].tag] { return false }
    at = at + usize.ONE
  }
  return true
}

// Appends the values of `row` that an unguarded arm with these nested tests does not select.
effect fn subtractRow(row: &CoverageRow, tests: &List<BodyPatternTest>, residual: &mut List<CoverageRow>) ! OutOfMemoryError ? &mut Allocator {
  let listed = List<BodyPatternTest>.asSlice(tests)
  let mut matched = run copiedRow(row)
  let mut at = usize.ZERO
  while at < listed.length {
    let test = &listed[at]
    let values = run allowedTags(&matched, test)
    let flags = List<bool>.asSlice(&values)
    let mut other = List<bool>.make()
    let mut only = List<bool>.make()
    let mut remains = false
    let mut tag = usize.ZERO
    while tag < flags.length {
      let kept = flags[tag] && tag != test.tag
      if kept { remains = true }
      run List<bool>.append(&mut other, kept)
      run List<bool>.append(&mut only, tag == test.tag)
      tag = tag + usize.ONE
    }
    if remains { run List<CoverageRow>.append(&mut residual.*, run constrainedRow(&matched, test, move other)) }
    if !flags[test.tag] { return }
    matched = run constrainedRow(&matched, test, move only)
    at = at + usize.ONE
  }
}

effect fn copiedRow(row: &CoverageRow) -> CoverageRow ! OutOfMemoryError ? &mut Allocator {
  let mut constraints = List<CoverageConstraint>.make()
  let prior = List<CoverageConstraint>.asSlice(&row.constraints)
  let mut at = usize.ZERO
  while at < prior.length {
    let mut kept = List<bool>.make()
    let listed = List<bool>.asSlice(&prior[at].allowed)
    let mut tag = usize.ZERO
    while tag < listed.length {
      run List<bool>.append(&mut kept, listed[tag])
      tag = tag + usize.ONE
    }
    run List<CoverageConstraint>.append(&mut constraints, CoverageConstraint {path: run copySteps(&prior[at].path), allowed: move kept})
    at = at + usize.ONE
  }
  return CoverageRow {member: row.member, constraints: move constraints}
}

fn memberUncovered(rows: &List<CoverageRow>, member: usize) -> bool {
  let listed = List<CoverageRow>.asSlice(rows)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].member == member { return true }
    at = at + usize.ONE
  }
  return false
}

// A pattern binder resolves to the binding place declared by its arm; every use is a fresh place node.
effect fn patternBindingUse(resolver: &Resolver, nodes: &[BodyNode], binder: HirId, anchor: &Anchor) -> Option<PatternBindingUse> ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < nodes.length {
    if BodyOrigin.syntax(nodes[at].origin, anchor).index == binder.index && !completedOccurrenceContains(resolver, at, false) {
      if let BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {subject, path, access, declared}} = &nodes[at].kind {
        return Option<PatternBindingUse>.some(PatternBindingUse {
          ty: Shared<Type>.clone(&ty),
          form: BodyExpression.PatternBinding {subject: subject, path: run copySteps(&path), access: access,
            declared: Shared<Type>.clone(&declared)},
        })
      }
    }
    at = at + usize.ONE
  }
  return Option<PatternBindingUse>.none()
}

// A runtime-complete nominal union declaration: tags are variant positions in declaration order,
// the same order the Members query, static values and runtime identities use.
struct NominalUnion {
  module: usize,
  declaration: usize,
  count: usize,
}

impl Copy for NominalUnion {}

effect fn nominalUnionOf(resolver: &mut Resolver, ty: &Shared<Type>) -> Option<NominalUnion>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if !Shared<Type>.with<bool>(ty, isNominalType) { return Option<NominalUnion>.none() }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return Option<NominalUnion>.none() }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<NominalUnion>.none() }
  }
  let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {variants, ..} = value.header {
      return Option<NominalUnion>.some(NominalUnion {module: moduleOrdinal, declaration: declaration, count: variants.length})
    }
  }
  return Option<NominalUnion>.none()
}

fn variantPosition(answer: &Result<Answer, NoRejection>, name: &[u8]) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let values = List<Member>.asSlice(&members)
      let mut at = usize.ZERO
      while at < values.length {
        if let Option<Bytes>.Some {value: written} = &values[at].name {
          if same(Bytes.asSlice(&written), name) { return at }
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

// The declaration-order tag of a written variant name. Variants have no visibility of their own:
// access is the union declaration's, enforced when its name is selected.
effect fn variantTag(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, nominal: &NominalUnion, unionType: &Shared<Type>, name: &[u8],
  span: Span,
) -> Result<usize, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declarationAccess125Request = Key {
    family: Family.Members, module: nominal.module, name: usize.ZERO,
    declaration: nominal.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess125 = run internDeclaration(&mut resolver.*, declarationAccess125Request)
  let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess125, span)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&names, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Result<usize, Shared<Rejection>>.failResult(move value) }
  let tag = Shared<Result<Answer, NoRejection>>.with<usize>(&names, fn(answer: &Result<Answer, NoRejection>) -> usize {
    return variantPosition(answer, name)
  })
  if tag == usize.MAX {
    let error = run reject(&resolver.*, module, RejectionCode.UnknownUnionVariant, span)
    run unknownVariantArguments(module, &error, unionType, name, &names)
    return Result<usize, Shared<Rejection>>.failResult(move error)
  }
  return Result<usize, Shared<Rejection>>.succeed(tag)
}

// The variant names of a union's Members answer, in declaration order.
effect fn writtenVariantNames(answer: &Shared<Result<Answer, NoRejection>>) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(answer, fn(found: &Result<Answer, NoRejection>) -> usize {
    if let Result<Answer, NoRejection>.Success {value} = &found.* {
      if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome { return List<Member>.length(&members) }
    }
    return usize.ZERO
  })
  let mut at = usize.ZERO
  while at < count {
    let written = Shared<Result<Answer, NoRejection>>.with<usize>(answer, fn(found: &Result<Answer, NoRejection>) -> usize {
      if let Result<Answer, NoRejection>.Success {value} = &found.* {
        if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
          if let Option<Bytes>.Some {value: spelled} = &List<Member>.asSlice(&members)[at].name { return Bytes.length(&spelled) }
        }
      }
      return usize.MAX
    })
    if written != usize.MAX {
      let mut name = Bytes.make()
      let mut offset = usize.ZERO
      while offset < written {
        let byte = Shared<Result<Answer, NoRejection>>.with<u8>(answer, fn(found: &Result<Answer, NoRejection>) -> u8 {
          if let Result<Answer, NoRejection>.Success {value} = &found.* {
            if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
              if let Option<Bytes>.Some {value: spelled} = &List<Member>.asSlice(&members)[at].name { return Bytes.asSlice(&spelled)[offset] }
            }
          }
          return 0
        })
        run Bytes.append(&mut name, &[byte])
        offset = offset + usize.ONE
      }
      run List<Bytes>.append(&mut names, move name)
    }
    at = at + usize.ONE
  }
  return move names
}

// SEM0167 names the union and the written variant, and lists the union's variants in a note.
effect fn unknownVariantArguments(
  viewer: &ModuleId,
  error: &Shared<Rejection>,
  unionType: &Shared<Type>,
  name: &[u8],
  members: &Shared<Result<Answer, NoRejection>>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let unionText = run writtenTypeName(viewer, unionType)
  if Bytes.length(&unionText) == usize.ZERO { return () }
  let mut quotedUnion = Bytes.make()
  run appendQuoted(&mut quotedUnion, Bytes.asSlice(&unionText))
  run appendRejectionArgument(error, b"unionName", Bytes.asSlice(&quotedUnion))
  let mut quotedVariant = Bytes.make()
  run appendQuoted(&mut quotedVariant, name)
  run appendRejectionArgument(error, b"variantName", Bytes.asSlice(&quotedVariant))
  let names = run writtenVariantNames(members)
  let listed = List<Bytes>.asSlice(&names)
  if listed.length == usize.ZERO { return () }
  let mut note = Bytes.make()
  run Bytes.append(&mut note, Bytes.asSlice(&quotedUnion))
  if listed.length == usize.ONE {
    run Bytes.append(&mut note, b" has one variant: ")
  } else {
    run Bytes.append(&mut note, b" has the variants ")
  }
  let mut at = usize.ZERO
  while at < listed.length {
    if at > usize.ZERO {
      if at + usize.ONE == listed.length { run Bytes.append(&mut note, b" and ") } else { run Bytes.append(&mut note, b", ") }
    }
    run appendQuoted(&mut note, Bytes.asSlice(&listed[at]))
    at = at + usize.ONE
  }
  return run appendRejectionArgument(error, b"note", Bytes.asSlice(&note))
}

// One variant's written field names (declaration order), whether braces were written, the
// payload field types from the variant's member shape, and each field's visibility outside the
// union's declaring module.
struct VariantShape {
  braces: bool,
  /// The variant's written name, for diagnostics.
  variant: Bytes,
  names: List<Bytes>,
  types: List<Shared<Type>>,
  publics: List<bool>,
  module: usize,
}

fn shapeLength(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.MemberShape {types}} = &value.outcome { return List<Shared<Type>>.length(&types) }
  }
  return usize.MAX
}

fn shapeTypeAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.MemberShape {types}} = &value.outcome {
      let listed = List<Shared<Type>>.asSlice(&types)
      if at < listed.length { return Option<Shared<Type>>.some(Shared<Type>.clone(&listed[at])) }
    }
  }
  return Option<Shared<Type>>.none()
}

// Whether `module` may name the variant field at `index`: a public field, or any field inside the
// union's declaring module.
fn variantFieldVisible(resolver: &Resolver, module: &ModuleId, shape: &VariantShape, index: usize) -> bool {
  let publics = List<bool>.asSlice(&shape.publics)
  if index < publics.length && publics[index] { return true }
  let declaring = resolvedModule(resolver, shape.module)
  return ModuleId.equals(module, &declaring)
}

effect fn variantShape(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, unionType: &Shared<Type>, nominal: &NominalUnion,
  tag: usize, span: Span,
) -> Result<VariantShape, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declaredModule = resolvedModule(&resolver.*, nominal.module)
  let written = run scopedHeader(&mut resolver.*, &declaredModule, nominal.declaration)
  let mut variants = Range.empty()
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {variants: listed, ..} = value.header { variants = listed }
  }
  if tag >= variants.length { return Result<VariantShape, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.UnknownUnionVariant, span)) }
  let mut names = List<Bytes>.make()
  let mut publics = List<bool>.make()
  let mut braces = false
  let mut variant = Bytes.make()
  let sourceAnswer = run observedMember(&mut resolver.*, &declaredModule, nominal.declaration, tag)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, &declaredModule) {
    let hir = IndexedSource.authored(indexed)
    if let Node.Variant {name: variantName, fields, braces: writtenBraces} = Module.node(hir, Module.child(hir, variants, tag)) {
      braces = writtenBraces
      if let Node.Name {text} = Module.node(hir, variantName) { variant = run Bytes.copy(Module.text(hir, text)) }
      let mut at = usize.ZERO
      while at < fields.length {
        if let Node.Field {name, isPublic, ..} = Module.node(hir, Module.child(hir, fields, at)) {
          if let Node.Name {text} = Module.node(hir, name) {
            run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text)))
            run List<bool>.append(&mut publics, isPublic)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  drop sourceAnswer
  let application = run internApplication(&mut resolver.*, unionType)
  let declarationAccess126Request = Key {
    family: Family.MemberShape, module: nominal.module, name: application,
    declaration: nominal.declaration, member: tag, external: false,
  }
  let declarationAccess126 = run internDeclaration(&mut resolver.*, declarationAccess126Request)
  let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess126, span)
  let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shaped, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move rejected { return Result<VariantShape, Shared<Rejection>>.failResult(move value) }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&shaped, shapeLength)
  if count != List<Bytes>.length(&names) {
    return Result<VariantShape, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let mut types = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&shaped, fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return shapeTypeAt(answer, at)
    })
    if let Option<Shared<Type>>.Some {value} = move selected { run List<Shared<Type>>.append(&mut types, move value) }
    at = at + usize.ONE
  }
  return Result<VariantShape, Shared<Rejection>>.succeed(VariantShape {
    braces: braces, variant: move variant, names: move names, types: move types, publics: move publics, module: nominal.module,
  })
}

// One selected nominal-union variant, optionally awaiting ordinary payload inference.
struct SelectedVariant {
  ty: Shared<Type>,
  nominal: NominalUnion,
  tag: usize,
  /// The variant's name, as `Square` in `Shape.Square`.
  member: Bytes,
  shape: VariantShape,
  inference: Option<InferredAggregateTarget>,
}

effect fn selectedVariant(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, ty: &Shared<Type>,
  nominal: NominalUnion, member: &[u8], span: Span,
) -> Result<SelectedVariant, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let tagged = run variantTag(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &nominal, ty, member, span)
  let tag = match move tagged {
    Result<usize, Shared<Rejection>>.Success {value} => value
    Result<usize, Shared<Rejection>>.Failure {error} => {
      return Result<SelectedVariant, Shared<Rejection>>.failResult(move error)
    }
  }
  let shaped = run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, ty, &nominal, tag, span)
  return match move shaped {
    Result<VariantShape, Shared<Rejection>>.Success {value} =>
      Result<SelectedVariant, Shared<Rejection>>.succeed(SelectedVariant {
        ty: Shared<Type>.clone(ty), nominal: nominal, tag: tag, member: run Bytes.copy(member), shape: move value,
        inference: Option<InferredAggregateTarget>.none(),
      })
    Result<VariantShape, Shared<Rejection>>.Failure {error} =>
      Result<SelectedVariant, Shared<Rejection>>.failResult(move error)
  }
}

effect fn selectAppliedVariant(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, ty: &Shared<Type>, member: &[u8], span: Span,
) -> Option<Result<SelectedVariant, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run nominalUnionOf(&mut resolver.*, ty)
  return match move selected {
    Option<NominalUnion>.Some {value} => Option<Result<SelectedVariant, Shared<Rejection>>>.some(
      run selectedVariant(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, module, ty, value, member, span,
      ),
    )
    Option<NominalUnion>.None => Option<Result<SelectedVariant, Shared<Rejection>>>.none()
  }
}

// A written `Union.Variant` qualifier: immediate nominal context fixes its arguments; otherwise
// generic payload fields infer them through the same aggregate lane as a bare struct literal.
effect fn selectVariant(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, namespace: &[u8], member: &[u8],
  expected: &Option<Shared<Type>>, span: Span,
) -> Option<Result<SelectedVariant, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let candidateSelection = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, namespace, false)
  let candidate = match move candidateSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      return Option<Result<SelectedVariant, Shared<Rejection>>>.some(Result<SelectedVariant, Shared<Rejection>>.failResult(move error))
    }
  }
  if candidate.count != usize.ONE || (candidate.kind != CandidateKind.Declaration && candidate.kind != CandidateKind.ImportMember) {
    return Option<Result<SelectedVariant, Shared<Rejection>>>.none()
  }
  let selected = run selectDeclaration(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    moduleOrdinal, module, namespace, false, span, RejectionCode.UnknownType, RejectionCode.NotType, false)
  let declaration = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => move value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      drop error
      return Option<Result<SelectedVariant, Shared<Rejection>>>.none()
    }
  }
  let declaredModule = resolvedModule(&resolver.*, declaration.module)
  let written = run scopedHeader(&mut resolver.*, &declaredModule, declaration.ordinal)
  let mut count = usize.MAX
  let mut genericParameters = Range.empty()
  let mut isPublic = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.UnionHeader {generics, variants, isPublic: published, ..} = value.header {
      count = variants.length
      genericParameters = generics
      isPublic = published
    }
  }
  if count == usize.MAX { return Option<Result<SelectedVariant, Shared<Rejection>>>.none() }
  let nominal = NominalUnion {module: declaration.module, declaration: declaration.ordinal, count: count}
  // A union without written parameters can still have the lifetimes its fields leave unwritten
  // (LIFE-003), which are inferred like written ones.
  let inferredTarget = match move run inferredAggregateDeclaration(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration,
    genericParameters, isPublic, span,
  ) {
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Success {value: inferred} => move inferred
    Result<Option<InferredAggregateTarget>, Shared<Rejection>>.Failure {error} => {
      return Option<Result<SelectedVariant, Shared<Rejection>>>.some(Result<SelectedVariant, Shared<Rejection>>.failResult(move error))
    }
  }
  if let Option<InferredAggregateTarget>.Some {value: target} = move inferredTarget {
    if let Option<Shared<Type>>.Some {value: context} = &expected.* {
      let contextModule = declaringModuleOrdinal(&resolver.*, &context)
      if contextModule == declaration.module {
        let contextOrdinal = run ordinalOfProvider(&mut resolver.*, &declaredModule, &context)
        if let Option<usize>.Some {value} = move contextOrdinal {
          if value == declaration.ordinal {
            return Option<Result<SelectedVariant, Shared<Rejection>>>.some(run selectedVariant(
              &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &context, nominal, member, span,
            ))
          }
        }
      }
    }
    let selected = run selectedVariant(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &target.ty, nominal, member, span,
    )
    match move selected {
      Result<SelectedVariant, Shared<Rejection>>.Success {value} => {
        let mut variant = move value
        variant.inference = Option<InferredAggregateTarget>.some(move target)
        return Option<Result<SelectedVariant, Shared<Rejection>>>.some(
          Result<SelectedVariant, Shared<Rejection>>.succeed(move variant),
        )
      }
      Result<SelectedVariant, Shared<Rejection>>.Failure {error} => {
        return Option<Result<SelectedVariant, Shared<Rejection>>>.some(
          Result<SelectedVariant, Shared<Rejection>>.failResult(move error),
        )
      }
    }
  }
  let declarationAccess127Request = Key {
    family: Family.Identity, module: declaration.module, name: usize.ZERO,
    declaration: declaration.ordinal, member: usize.ZERO, external: false,
  }
  let declarationAccess127 = run internDeclaration(&mut resolver.*, declarationAccess127Request)
  let identity = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess127, span)
  let selectedType = run typeFromAnswer(&identity)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selectedType.rejected {
    return Option<Result<SelectedVariant, Shared<Rejection>>>.some(Result<SelectedVariant, Shared<Rejection>>.failResult(move diagnostic))
  }
  let ty = match move selectedType.resolved {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<Result<SelectedVariant, Shared<Rejection>>>.none() }
  }
  return Option<Result<SelectedVariant, Shared<Rejection>>>.some(run selectedVariant(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ty, nominal, member, span,
  ))
}

// A two-segment written path in a type or pattern position.
effect fn namedPathPair(source: &SourceIndex, cursor: &AuthoredCursor, annotation: HirId) -> Option<QualifiedBodyName>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.NamedType {path, hasMode, ..} = run bodyNode(source, cursor, annotation) {
    if !hasMode { return run bodyPathPair(source, cursor, path) }
  }
  return Option<QualifiedBodyName>.none()
}

// The fields a record or variant pattern can name.
union FieldSource {
  Record {ty: Shared<Type>},
  Variant {tag: usize, shape: VariantShape},
}

// A pattern's written member type, resolved once with every other reached body annotation. Any
// exact member can be named (PATT-015): selection decides whether the scrutinee has it, and only a
// struct member admits `{ }` destructuring.
effect fn patternMemberType(
  resolver: &mut Resolver, module: &ModuleId, annotations: &[ResolvedAnnotation], annotation: HirId, span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut resolved = Option<Shared<Type>>.none()
  let mut at = usize.ZERO
  while at < annotations.length {
    if annotations[at].id.index == annotation.index {
      match &annotations[at].result {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
          resolved = Option<Shared<Type>>.some(Shared<Type>.clone(&value))
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(Shared<Rejection>.clone(&error))
        }
      }
      break
    }
    at = at + usize.ONE
  }
  return match move resolved {
    Option<Shared<Type>>.Some {value} => Result<Shared<Type>, Shared<Rejection>>.succeed(move value)
    Option<Shared<Type>>.None => Result<Shared<Type>, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    )
  }
}

// LIFE-003: an omitted lifetime in a body annotation is a variable of this body-local owner. The
// annotation describes a value the body types itself, such as a pattern's scrutinee or a binding's
// initializer, and unifying with that value's type supplies each such lifetime. No variable of
// this owner reaches a checked type, a signature, or a published fact.
effect fn elidedLifetimeOwner(caller: &DeclarationId) -> DeclarationId ! OutOfMemoryError ? &mut Allocator {
  return run DeclarationId.inference(caller, b"\0elided-lifetime")
}

// The value type a written body annotation describes, once each lifetime it elides is taken from
// `actual`. Every written part must agree exactly; an annotation that elides nothing must equal it.
effect fn inferredAnnotation(written: &Shared<Type>, actual: &Shared<Type>, elided: &DeclarationId)
-> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !run typeMentionsOwner(written, elided) {
    if run Type.equalsShared(written, actual) { return Option<Shared<Type>>.some(Shared<Type>.clone(actual)) }
    return Option<Shared<Type>>.none()
  }
  let mut variables = List<Shared<DeclarationId>>.make()
  run List<Shared<DeclarationId>>.append(&mut variables, run Shared<DeclarationId>.make(DeclarationId.copy(elided)))
  let mut bindings = List<Binding>.make()
  let unified = run Type.unify(written, actual, List<Shared<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut bindings)
  let described = match &unified {
    Unification.Unified => true
    _ => false
  }
  if described {
    let filled = run Type.applyBindings(written, List<Binding>.asSlice(&bindings), true)
    if !run typeMentionsOwner(&filled, elided) { return Option<Shared<Type>>.some(Shared<Type>.clone(actual)) }
  }
  return Option<Shared<Type>>.none()
}

// The candidate a written pattern annotation names, with its elided lifetimes taken from that
// candidate. Candidates that differ only where the annotation elides leave the choice ambiguous.
union PatternMember {
  Selected {tag: usize, ty: Shared<Type>},
  Missing,
  Ambiguous,
}

effect fn patternMember(written: &Shared<Type>, candidates: &[Shared<Type>], elided: &DeclarationId) -> PatternMember
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut selected = PatternMember.Missing
  let mut at = usize.ZERO
  while at < candidates.length {
    let inferred = run inferredAnnotation(written, &candidates[at], elided)
    if let Option<Shared<Type>>.Some {value} = move inferred {
      if let PatternMember.Selected {..} = &selected { return PatternMember.Ambiguous }
      selected = PatternMember.Selected {tag: at, ty: move value}
    }
    at = at + usize.ONE
  }
  return move selected
}

// An annotation naming no candidate is a type mismatch; one whose elided lifetimes fit several
// candidates cannot choose among them (SEM0210).
effect fn rejectPatternMember(resolver: &Resolver, module: &ModuleId, member: &PatternMember, span: Span, written: &Shared<Type>,
  scrutinee: &Shared<Type>) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let ambiguous = match &member.* { PatternMember.Ambiguous => true _ => false }
  if ambiguous { return run reject(resolver, module, RejectionCode.AmbiguousLifetime, span) }
  // The message names the written type and the type it is not a member of; a structural union,
  // which has no printed form, by its members.
  let mut diagnostic = run makeRejection(RejectionCode.MatchMemberNotInScrutinee, module, span)
  if let Option<Bytes>.Some {value: memberText} = move run TypeText.display(written, module) {
    if Shared<Type>.with<bool>(scrutinee, unionType) {
      if let Option<Bytes>.Some {value: members} = move run memberList(scrutinee, module) {
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: move memberText})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"members"), value: move members})
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
      }
    } else if let Option<Bytes>.Some {value: scrutineeText} = move run TypeText.display(scrutinee, module) {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: move memberText})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"scrutinee"), value: move scrutineeText})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// What one arm's pattern selects: its checked pattern, the member it covers (`usize.MAX` for a
// universal arm), and the integer value an integer pattern selects.
struct ArmPattern {
  pattern: BodyPattern,
  ordinal: usize,
  integerCase: Option<Bytes>,
}

effect fn armPatternRejection(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span)
-> Result<ArmPattern, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  return Result<ArmPattern, Shared<Rejection>>.failResult(run reject(resolver, module, code, span))
}

// A pattern binding at `span` whose name is already declared in scope (SEM0048). A binding of the
// record field `field` suggests binding that field to another name; an empty `field` asks for
// another name.
effect fn bindingConflictRejection(module: &ModuleId, span: Span, field: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.PatternBindingConflict, module, span)
  if field.length == usize.ZERO {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
  } else {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"field"), value: run Bytes.copy(field)})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Checks one arm's pattern against the subject and the arms before it, appending the nodes that
// declare its bindings and the tests that select it. An unreachable arm is reported at
// `unreachableSpan`. The arm's guard and result are checked only
// when its pattern is.
effect fn checkArmPattern(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId, constraints: &[Constraint],
  annotations: &[ResolvedAnnotation], elided: &DeclarationId, nodes: &mut List<BodyNode>,
  subjectNode: BodyNodeId, subjectType: &Shared<Type>, access: MatchAccess, members: &[Shared<Type>],
  rows: &List<CoverageRow>, integerCases: &[Bytes], integerSubject: bool, isNominal: bool, isUnion: bool,
  open: bool, universal: bool, fallback: bool, writtenPattern: Node, pattern: HirId, patternSpan: Span, unreachableSpan: Span,
  armTests: &mut List<BodyPatternTest>,
) -> Result<ArmPattern, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !fallback && (universal || (!open && List<CoverageRow>.length(rows) == usize.ZERO)) {
    return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan)
  }
  let mut checkedPattern = BodyPattern.Universal
  let mut ordinal = usize.MAX
  let mut integerCase = Option<Bytes>.none()
  match writtenPattern {
    // An integer literal selects one value of an integer scrutinee at the scrutinee's type.
    Node.IntegerPattern {value} => {
      // A bool scrutinee has no integer values, so the arm can never select one (SEM0043).
      if !integerSubject { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
      if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, value) {
        let digits = run bodyText(&resolver.source, cursor, magnitude)
        let fits = Shared<Type>.with<bool>(subjectType, fn(resolved: &Type) -> bool {
          return match &resolved.* {
            Type.Primitive {name} => fitsInteger(&resolver.target, Bytes.asSlice(&name), sign, Bytes.asSlice(&digits))
            _ => false
          }
        })
        if !fits {
          let name = Shared<Type>.with<&'static [u8]>(subjectType, fn(resolved: &Type) -> &'static [u8] {
            return integerTypeName(resolved)
          })
          return Result<ArmPattern, Shared<Rejection>>.failResult(
            run integerRangeRejection(&resolver.*, module, name, sign, Bytes.asSlice(&digits), patternSpan))
        }
        let negative = sign == Sign.Negative && !zeroDigits(Bytes.asSlice(&digits))
        let mut key = Bytes.make()
        if negative { run Bytes.append(&mut key, b"-") }
        run Bytes.append(&mut key, Bytes.asSlice(&digits))
        let seen = integerCases
        let mut scan = usize.ZERO
        while scan < seen.length {
          if same(Bytes.asSlice(&seen[scan]), Bytes.asSlice(&key)) { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
          scan = scan + usize.ONE
        }
        let magnitude = match move decimalU64(Bytes.asSlice(&digits)) {
          Option<u64>.Some {value: parsed} => parsed
          Option<u64>.None => { return run armPatternRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, patternSpan) }
        }
        integerCase = Option<Bytes>.some(move key)
        checkedPattern = BodyPattern.Integer {magnitude: magnitude, negative: negative}
      } else {
        return run armPatternRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan)
      }
    }
    Node.UniversalPattern {name} => {
      if name.present { return run armPatternRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
    }
    // `T name` selects one exact record member and binds the complete selected value; `T _`
    // selects it without a usable name. Neither is a wildcard (PATT-015).
    Node.BindingPattern {annotation, name, shadowsLocal} => {
      if shadowsLocal {
        return Result<ArmPattern, Shared<Rejection>>.failResult(
          run bindingConflictRejection(module, run bodySpan(&resolver.source, cursor, name), b""))
      }
      if !annotation.present || isNominal { return run armPatternRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
      let written = run patternMemberType(&mut resolver.*, module, annotations, annotation.id, patternSpan)
      let writtenType = match move written {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<ArmPattern, Shared<Rejection>>.failResult(move error) }
      }
      // A scalar subject has one member, its own type: `i32 x` binds the whole subject and, like
      // `_`, covers every value.
      if open {
        if !run Type.equalsShared(&writtenType, subjectType) {
          return run armPatternRejection(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, patternSpan)
        }
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, pattern, patternSpan),
          kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(subjectType),
            form: BodyExpression.PatternBinding {subject: subjectNode, path: List<BodyPlaceStep>.make(), access: bindingAccess(access),
              declared: Shared<Type>.clone(subjectType)}},
        })
        return Result<ArmPattern, Shared<Rejection>>.succeed(ArmPattern {pattern: BodyPattern.Universal, ordinal: usize.MAX,
          integerCase: Option<Bytes>.none()})
      }
      let chosen = run patternMember(&writtenType, members, elided)
      let mut tag = usize.ZERO
      let mut patternType = Shared<Type>.clone(&writtenType)
      match &chosen {
        PatternMember.Selected {tag: found, ty: selectedType} => {
          tag = found
          patternType = Shared<Type>.clone(&selectedType)
        }
        _ => { return Result<ArmPattern, Shared<Rejection>>.failResult(run rejectPatternMember(&resolver.*, module, &chosen, patternSpan, &writtenType, subjectType)) }
      }
      if !memberUncovered(rows, tag) { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
      ordinal = tag
      let mut member = Option<BodyUnionMember>.none()
      let mut path = List<BodyPlaceStep>.make()
      if isUnion {
        member = Option<BodyUnionMember>.some(BodyUnionMember {tag: tag, ty: Shared<Type>.clone(&patternType), source: Shared<Type>.clone(subjectType)})
        run List<BodyPlaceStep>.append(&mut path, BodyPlaceStep.Member {tag: tag, ty: Shared<Type>.clone(&patternType), source: Shared<Type>.clone(subjectType)})
      }
      run List<BodyNode>.append(&mut nodes.*, BodyNode {
        origin: run originAt(cursor, pattern, patternSpan),
        kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&patternType),
          form: BodyExpression.PatternBinding {subject: subjectNode, path: move path, access: bindingAccess(access),
            declared: Shared<Type>.clone(&patternType)}},
      })
      checkedPattern = BodyPattern.Record {member: move member}
    }
    Node.VariantPattern {selector, fields} => {
      if !isNominal { return run armPatternRejection(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, patternSpan) }
      let checkedSelection = run appliedPatternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
        caller, constraints, elided, subjectType, selector, patternSpan)
      let variant = match move checkedSelection {
        Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
        Result<SelectedVariant, Shared<Rejection>>.Failure {error} => {
          return Result<ArmPattern, Shared<Rejection>>.failResult(move error)
        }
      }
      if variant.shape.braces && !fields.present {
        return run armPatternRejection(&resolver.*, module, RejectionCode.MissingPatternField, patternSpan)
      }
      if fields.present && !variant.shape.braces {
        return run armPatternRejection(&resolver.*, module, RejectionCode.UnitVariantPayloadPattern, patternSpan)
      }
      if !memberUncovered(rows, variant.tag) {
        return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan)
      }
      ordinal = variant.tag
      let origin = FieldSource.Variant {tag: variant.tag, shape: move variant.shape}
      let root = List<BodyPlaceStep>.make()
      let mut writtenFields = Range.empty()
      if fields.present { writtenFields = fields.range }
      let failed = run checkRecordPatternFields(
        &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
        annotations, elided, &mut nodes.*, subjectNode, &origin, writtenFields,
        &root, bindingAccess(access), &mut armTests.*, patternSpan,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Result<ArmPattern, Shared<Rejection>>.failResult(move value)
      }
      checkedPattern = BodyPattern.Variant {tag: ordinal}
    }
    Node.NominalPattern {annotation, fields} => {
      if isNominal {
        let selected = run patternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
          subjectType, annotation, patternSpan)
        let variant = match move selected {
          Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
          Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result<ArmPattern, Shared<Rejection>>.failResult(move error) }
        }
        if !variant.shape.braces { return run armPatternRejection(&resolver.*, module, RejectionCode.UnitVariantPayloadPattern, patternSpan) }
        if !memberUncovered(rows, variant.tag) { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
        ordinal = variant.tag
        let origin = FieldSource.Variant {tag: variant.tag, shape: move variant.shape}
        let root = List<BodyPlaceStep>.make()
        let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
          annotations, elided, &mut nodes.*, subjectNode, &origin, fields, &root, bindingAccess(access), &mut armTests.*, patternSpan)
        if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<ArmPattern, Shared<Rejection>>.failResult(move value) }
        checkedPattern = BodyPattern.Variant {tag: ordinal}
      } else {
        // `Member.Variant { .. }` names a variant of a nominal union member of a structural union.
        let mut nested = Option<NestedVariant>.none()
        if isUnion {
          let writtenPair = run namedPathPair(&resolver.source, cursor, annotation)
          if let Option<QualifiedBodyName>.Some {value: pair} = &writtenPair {
            nested = run nestedVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
              members, &pair, patternSpan)
          }
        }
        if let Option<NestedVariant>.Some {value: selected} = move nested {
          if !selected.variant.shape.braces { return run armPatternRejection(&resolver.*, module, RejectionCode.UnitVariantPayloadPattern, patternSpan) }
          if !memberUncovered(rows, selected.tag) { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
          ordinal = selected.tag
          let member = BodyUnionMember {tag: selected.tag, ty: Shared<Type>.clone(&selected.ty), source: Shared<Type>.clone(subjectType)}
          let failed = run checkNestedVariantPattern(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
            constraints, annotations, elided, &mut nodes.*, subjectNode, subjectType, move selected, fields,
            bindingAccess(access), &mut armTests.*, patternSpan)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<ArmPattern, Shared<Rejection>>.failResult(move value) }
          checkedPattern = BodyPattern.Record {member: Option<BodyUnionMember>.some(move member)}
        } else {
          let written = run patternMemberType(&mut resolver.*, module, annotations, annotation, patternSpan)
          let writtenType = match move written {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return Result<ArmPattern, Shared<Rejection>>.failResult(move error)
            }
          }
          let chosen = run patternMember(&writtenType, members, elided)
          let mut tag = usize.ZERO
          let mut patternType = Shared<Type>.clone(&writtenType)
          match &chosen {
            PatternMember.Selected {tag: found, ty: selectedType} => {
              tag = found
              patternType = Shared<Type>.clone(&selectedType)
            }
            _ => { return Result<ArmPattern, Shared<Rejection>>.failResult(run rejectPatternMember(&resolver.*, module, &chosen, patternSpan, &writtenType, subjectType)) }
          }
          // `{ }` destructures a record; a scalar member has no fields to name.
          if !run declaredRecord(&mut resolver.*, &patternType) {
            return run armPatternRejection(&resolver.*, module, RejectionCode.NotType, patternSpan)
          }
          if !memberUncovered(rows, tag) { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
          ordinal = tag
          let mut member = Option<BodyUnionMember>.none()
          let mut root = List<BodyPlaceStep>.make()
          if isUnion {
            member = Option<BodyUnionMember>.some(BodyUnionMember {tag: tag, ty: Shared<Type>.clone(&patternType), source: Shared<Type>.clone(subjectType)})
            run List<BodyPlaceStep>.append(&mut root, BodyPlaceStep.Member {tag: tag, ty: Shared<Type>.clone(&patternType), source: Shared<Type>.clone(subjectType)})
          }
          let origin = FieldSource.Record {ty: Shared<Type>.clone(&patternType)}
          let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
            annotations, elided, &mut nodes.*, subjectNode, &origin, fields, &root, bindingAccess(access), &mut armTests.*, patternSpan)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<ArmPattern, Shared<Rejection>>.failResult(move value) }
          checkedPattern = BodyPattern.Record {member: move member}
        }
      }
    }
    Node.EnumPattern {path} => {
      let writtenPair = run bodyPathPair(&resolver.source, cursor, path)
      if !isNominal {
        // `Member.Variant` names a unit variant of a nominal union member of a structural union.
        let mut nested = Option<NestedVariant>.none()
        if isUnion {
          if let Option<QualifiedBodyName>.Some {value: pair} = &writtenPair {
            nested = run nestedVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
              members, &pair, patternSpan)
          }
        }
        let selected = match move nested {
          Option<NestedVariant>.Some {value} => move value
          Option<NestedVariant>.None => { return run armPatternRejection(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, patternSpan) }
        }
        if selected.variant.shape.braces { return run armPatternRejection(&resolver.*, module, RejectionCode.MissingPatternField, patternSpan) }
        if !memberUncovered(rows, selected.tag) { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
        ordinal = selected.tag
        let member = BodyUnionMember {tag: selected.tag, ty: Shared<Type>.clone(&selected.ty), source: Shared<Type>.clone(subjectType)}
        let failed = run checkNestedVariantPattern(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
          constraints, annotations, elided, &mut nodes.*, subjectNode, subjectType, move selected, Range.empty(),
          bindingAccess(access), &mut armTests.*, patternSpan)
        if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<ArmPattern, Shared<Rejection>>.failResult(move value) }
        checkedPattern = BodyPattern.Record {member: Option<BodyUnionMember>.some(move member)}
      } else {
        let pair = match move writtenPair {
          Option<QualifiedBodyName>.Some {value} => move value
          Option<QualifiedBodyName>.None => { return run armPatternRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
        }
        let context = Option<Shared<Type>>.some(Shared<Type>.clone(subjectType))
        let selected = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
          Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), &context, patternSpan)
        let checkedSelection = run checkedVariant(&resolver.*, module, move selected, subjectType, patternSpan)
        let variant = match move checkedSelection {
          Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
          Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result<ArmPattern, Shared<Rejection>>.failResult(move error) }
        }
        if variant.shape.braces { return run armPatternRejection(&resolver.*, module, RejectionCode.MissingPatternField, patternSpan) }
        if !memberUncovered(rows, variant.tag) { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
        ordinal = variant.tag
        checkedPattern = BodyPattern.Variant {tag: ordinal}
      }
    }
    _ => { return run armPatternRejection(&resolver.*, module, RejectionCode.Unsupported, patternSpan) }
  }
  // A nested arm whose every value an earlier unguarded arm already selected is unreachable (SEM0043).
  if ordinal != usize.MAX && List<BodyPatternTest>.length(&armTests.*) != usize.ZERO {
    let uncovered = List<CoverageRow>.asSlice(rows)
    let mut reachable = false
    let mut scan = usize.ZERO
    while scan < uncovered.length && !reachable {
      reachable = uncovered[scan].member == ordinal && run rowIntersects(&uncovered[scan], &armTests.*)
      scan = scan + usize.ONE
    }
    if !reachable { return run armPatternRejection(&resolver.*, module, RejectionCode.UnreachableMatchArm, unreachableSpan) }
  }
  return Result<ArmPattern, Shared<Rejection>>.succeed(ArmPattern {pattern: move checkedPattern, ordinal: ordinal, integerCase: move integerCase})
}

// A selected variant must belong to the matched subject's own union.
effect fn checkedVariant(
  resolver: &Resolver, module: &ModuleId, selected: Option<Result<SelectedVariant, Shared<Rejection>>>,
  subjectType: &Shared<Type>, span: Span,
) -> Result<SelectedVariant, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let chosen = match move selected {
    Option<Result<SelectedVariant, Shared<Rejection>>>.Some {value} => move value
    Option<Result<SelectedVariant, Shared<Rejection>>>.None => {
      return Result<SelectedVariant, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.MatchMemberNotInScrutinee, span))
    }
  }
  let variant = match move chosen {
    Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
    Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result<SelectedVariant, Shared<Rejection>>.failResult(move error) }
  }
  if !run Type.equalsShared(&variant.ty, subjectType) {
    return Result<SelectedVariant, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.MatchMemberNotInScrutinee, span))
  }
  return Result<SelectedVariant, Shared<Rejection>>.succeed(move variant)
}

effect fn patternVariant(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  subjectType: &Shared<Type>, annotation: HirId, span: Span,
) -> Result<SelectedVariant, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let writtenPair = run namedPathPair(&resolver.source, cursor, annotation)
  let pair = match move writtenPair {
    Option<QualifiedBodyName>.Some {value} => move value
    Option<QualifiedBodyName>.None => {
      return Result<SelectedVariant, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, span))
    }
  }
  let context = Option<Shared<Type>>.some(Shared<Type>.clone(subjectType))
  let selected = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), &context, span)
  // A qualifier the module never declares or imports, such as `Result` without
  // `import silk.result { Result }`, is an unknown name rather than a member the subject lacks.
  if let Option<Result<SelectedVariant, Shared<Rejection>>>.None = &selected {
    let found = run select(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, Bytes.asSlice(&pair.namespace), false)
    let unknown = match &found {
      Result<Selection, Shared<Rejection>>.Success {value} => value.count == usize.ZERO
      Result<Selection, Shared<Rejection>>.Failure {..} => false
    }
    if unknown {
      return Result<SelectedVariant, Shared<Rejection>>.failResult(
        run memberRejection(&resolver.*, module, RejectionCode.UnknownActor, span, module, Bytes.asSlice(&pair.namespace)),
      )
    }
  }
  return run checkedVariant(&resolver.*, module, move selected, subjectType, span)
}

// The variant an applied selector such as `Option<T>.Some` names in a nominal union subject.
effect fn appliedPatternVariant(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  constraints: &[Constraint], elided: &DeclarationId, subjectType: &Shared<Type>, selector: HirId, span: Span,
) -> Result<SelectedVariant, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut writtenSubject = HirId {index: usize.ZERO}
  let mut writtenMember = HirId {index: usize.ZERO}
  match run bodyNode(&resolver.source, cursor, selector) {
    Node.MemberSelector {subject, member} => {
      writtenSubject = subject
      writtenMember = member
    }
    _ => { return Result<SelectedVariant, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, span)) }
  }
  let resolved = run recordAnnotation(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, writtenSubject, span, constraints,
  )
  let writtenOwner = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<SelectedVariant, Shared<Rejection>>.failResult(move error) }
  }
  let memberName = match run bodyNode(&resolver.source, cursor, writtenMember) {
    Node.Name {text} => run bodyText(&resolver.source, cursor, text)
    _ => { return Result<SelectedVariant, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.UnknownUnionVariant, span)) }
  }
  // The written union names its member before the qualifier meets the subject, so an unknown
  // variant keeps its own diagnostic. The qualifier's elided lifetimes come from the subject.
  let writtenUnion = run nominalUnionOf(&mut resolver.*, &writtenOwner)
  if let Option<NominalUnion>.Some {value: named} = &writtenUnion {
    let tagged = run variantTag(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &named,
      &writtenOwner, Bytes.asSlice(&memberName), span)
    if let Result<usize, Shared<Rejection>>.Failure {error} = move tagged {
      return Result<SelectedVariant, Shared<Rejection>>.failResult(move error)
    }
  }
  let inferred = run inferredAnnotation(&writtenOwner, subjectType, elided)
  let mut ownerType = Shared<Type>.clone(subjectType)
  match move inferred {
    Option<Shared<Type>>.Some {value} => { ownerType = move value }
    Option<Shared<Type>>.None => {
      // A qualifier that writes every region admits the subject by covariant region subtyping, as
      // at an expected-value boundary (LIFE-002): a 'static subject meets `'a`, and a caller-local
      // subject region stays open on the body as a relation. The arm selects the subject's own
      // variant.
      let mut deferred = List<RegionPair>.make()
      if run typeMentionsOwner(&writtenOwner, elided) {
        return Result<SelectedVariant, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, span))
      }
      let admitted = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, subjectType, &writtenOwner,
        caller, constraints, true, &mut deferred, span)
      if !admitted || !relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&deferred)) {
        return Result<SelectedVariant, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, span))
      }
    }
  }
  let selected = run selectAppliedVariant(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ownerType, Bytes.asSlice(&memberName), span,
  )
  return run checkedVariant(&resolver.*, module, move selected, subjectType, span)
}

// The structural union member whose nominal union declares a written `Union.Variant` path, and
// that variant.
struct NestedVariant {
  tag: usize,
  ty: Shared<Type>,
  variant: SelectedVariant,
}

// Selects the variant a two-segment path names in one nominal union member of a structural union.
effect fn nestedVariant(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, members: &[Shared<Type>], pair: &QualifiedBodyName,
  span: Span,
) -> Option<NestedVariant>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < members.length {
    let nominal = run nominalUnionOf(&mut resolver.*, &members[at])
    if let Option<NominalUnion>.Some {..} = &nominal {
      let context = Option<Shared<Type>>.some(Shared<Type>.clone(&members[at]))
      let selected = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
        Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), &context, span)
      let checked = run checkedVariant(&resolver.*, module, move selected, &members[at], span)
      if let Result<SelectedVariant, Shared<Rejection>>.Success {value} = move checked {
        return Option<NestedVariant>.some(NestedVariant {tag: at, ty: Shared<Type>.clone(&members[at]), variant: move value})
      }
    }
    at = at + usize.ONE
  }
  return Option<NestedVariant>.none()
}

// Checks `Union.Variant { .. }` or `Union.Variant` against the nominal union member of a structural
// union subject: the arm selects that member, tests the variant tag inside it, then binds the
// variant's fields below the member.
effect fn checkNestedVariantPattern(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  constraints: &[Constraint], annotations: &[ResolvedAnnotation], elided: &DeclarationId, nodes: &mut List<BodyNode>,
  subject: BodyNodeId, subjectType: &Shared<Type>, nested: NestedVariant, fields: Range, access: BodyBindingAccess,
  tests: &mut List<BodyPatternTest>, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let NestedVariant {tag, ty, variant} = move nested
  let mut path = List<BodyPlaceStep>.make()
  run List<BodyPlaceStep>.append(&mut path, BodyPlaceStep.Member {tag: tag, ty: Shared<Type>.clone(&ty), source: Shared<Type>.clone(subjectType)})
  run List<BodyPatternTest>.append(&mut tests.*, BodyPatternTest {path: run copySteps(&path), tag: variant.tag,
    tags: variant.nominal.count, source: Option<Shared<Type>>.none(), scalar: Option<BodyScalarTest>.none()})
  let origin = FieldSource.Variant {tag: variant.tag, shape: move variant.shape}
  return run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
    annotations, elided, &mut nodes.*, subject, &origin, fields, &path, access, &mut tests.*, span)
}

// Binds the fields of one record pattern as places below `path` in the selected member. Every field
// is named once unless `..` acknowledges the rest; a nested union subpattern appends its tag test.
// A nested annotation takes the lifetimes it elides from the field it matches.
effect fn checkRecordPatternFields(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  constraints: &[Constraint], annotations: &[ResolvedAnnotation], elided: &DeclarationId, nodes: &mut List<BodyNode>,
  subject: BodyNodeId, origin: &FieldSource, fields: Range, path: &List<BodyPlaceStep>, access: BodyBindingAccess,
  tests: &mut List<BodyPatternTest>, span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut seen = List<usize>.make()
  let mut rest = false
  let mut at = usize.ZERO
  while at < fields.length {
    let entry = run bodyChild(&resolver.source, cursor, fields, at)
    let entrySpan = run bodySpan(&resolver.source, cursor, entry)
    let mut fieldName = entry
    let mut subpattern = entry
    let mut named = false
    match run bodyNode(&resolver.source, cursor, entry) {
      Node.RestPattern => { rest = true }
      Node.PatternField {name, pattern} => {
        fieldName = name
        subpattern = pattern
        named = true
      }
      _ => { return CompilerBug.panic(b"MissingRetainedFact: checkRecordPatternFields") }
    }
    if named {
      let text = match run bodyNode(&resolver.source, cursor, fieldName) {
        Node.Name {text} => run bodyText(&resolver.source, cursor, text)
        _ => { return CompilerBug.panic(b"MissingRetainedFact: checkRecordPatternFields") }
      }
      let fieldSpan = run bodySpan(&resolver.source, cursor, fieldName)
      let mut field = CheckedRecordMember {index: usize.MAX, count: usize.ZERO, ty: run Types.intern(Type.Unit)}
      let mut step = BodyPlaceStep.Field {index: usize.ZERO}
      match &origin.* {
        FieldSource.Record {ty} => {
          let selected = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &ty, Bytes.asSlice(&text), fieldSpan, FieldLookupPurpose.NamedFields)
          field = match move selected {
            Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => move value
            Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
          }
          step = BodyPlaceStep.Field {index: field.index}
        }
        FieldSource.Variant {tag, shape} => {
          let written = List<Bytes>.asSlice(&shape.names)
          let listed = List<Shared<Type>>.asSlice(&shape.types)
          let mut index = usize.ZERO
          while index < written.length {
            if same(Bytes.asSlice(&written[index]), Bytes.asSlice(&text)) { break }
            index = index + usize.ONE
          }
          if index == written.length { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnknownStructField, fieldSpan)) }
          // A pattern names a variant field only where a projection of it would be allowed.
          if !variantFieldVisible(&resolver.*, module, &shape, index) {
            let mut diagnostic = run makeRejection(RejectionCode.InaccessibleProjectedField, module, fieldSpan)
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"field"), value: run Bytes.copy(Bytes.asSlice(&text))})
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"variant"), value: run Bytes.copy(Bytes.asSlice(&shape.variant))})
            // Another package's variant cannot be edited from here, so only `..` is offered.
            let mut choice: &'static [u8] = b"3"
            if !ModuleId.samePackage(module, &resolvedModule(&resolver.*, shape.module)) { choice = b"4" }
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
            return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
          }
          field = CheckedRecordMember {index: index, count: written.length, ty: Shared<Type>.clone(&listed[index])}
          step = BodyPlaceStep.VariantField {tag: tag, field: index}
        }
      }
      let prior = List<usize>.asSlice(&seen)
      let mut repeated = false
      let mut scan = usize.ZERO
      while scan < prior.length {
        if prior[scan] == field.index { repeated = true }
        scan = scan + usize.ONE
      }
      if repeated { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.DuplicatePatternField, fieldSpan)) }
      run List<usize>.append(&mut seen, field.index)
      let fieldPath = run extendedPath(path, move step)
      let subpatternSpan = run bodySpan(&resolver.source, cursor, subpattern)
      match run bodyNode(&resolver.source, cursor, subpattern) {
        Node.BindingPattern {annotation, name, shadowsLocal} => {
          if shadowsLocal {
            return Option<Shared<Rejection>>.some(
              run bindingConflictRejection(module, run bodySpan(&resolver.source, cursor, name), Bytes.asSlice(&text)))
          }
          if annotation.present { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
          run List<BodyNode>.append(&mut nodes.*, BodyNode {
            origin: run originAt(cursor, subpattern, subpatternSpan),
            kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&field.ty),
              form: BodyExpression.PatternBinding {subject: subject, path: move fieldPath, access: access,
                declared: Shared<Type>.clone(&field.ty)}},
          })
        }
        Node.UniversalPattern {name} => {
          if name.present { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
        }
        Node.EnumPattern {path: selector} => {
          // A scalar enum field compares its value with one member's representation; its members
          // cover the field like the variants of a union field.
          let scalarMembers = run subjectScalarEnum(&mut resolver.*, &mut owner.*, &mut dependencies.*, &field.ty, subpatternSpan)
          if let Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.Some {value: selected} = move scalarMembers {
            let members = match move selected {
              Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
              Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
            }
            let count = Shared<Result<Answer, NoRejection>>.with<usize>(&members, scalarEnumCount)
            let mut covering = List<Option<Span>>.make()
            while List<Option<Span>>.length(&covering) < count { run List<Option<Span>>.append(&mut covering, Option<Span>.none()) }
            let scalar = run checkScalarEnumPattern(&mut resolver.*, &mut owner.*, &mut dependencies.*,
              module, cursor, subpattern, subpatternSpan, &field.ty, List<Option<Span>>.asSlice(&covering))
            let checkedScalar = match move scalar {
              Result<CheckedScalarPattern, Shared<Rejection>>.Success {value} => move value
              Result<CheckedScalarPattern, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
            }
            if let BodyPattern.EnumMember {member} = &checkedScalar.pattern {
              run List<BodyPatternTest>.append(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath), tag: member.ordinal,
                tags: count, source: Option<Shared<Type>>.none(),
                scalar: Option<BodyScalarTest>.some(BodyScalarTest {member: member, ty: Shared<Type>.clone(&field.ty)})})
            }
            at = at + usize.ONE
            continue
          }
          let fieldUnion = match move run nominalUnionOf(&mut resolver.*, &field.ty) {
            Option<NominalUnion>.Some {value} => value
            Option<NominalUnion>.None => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, subpatternSpan)) }
          }
          let written = run bodyPathPair(&resolver.source, cursor, selector)
          let pair = match move written {
            Option<QualifiedBodyName>.Some {value} => move value
            Option<QualifiedBodyName>.None => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, subpatternSpan)) }
          }
          let context = Option<Shared<Type>>.some(Shared<Type>.clone(&field.ty))
          let selected = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
            Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), &context, subpatternSpan)
          let checked = run checkedVariant(&resolver.*, module, move selected, &field.ty, subpatternSpan)
          let variant = match move checked {
            Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
            Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
          }
          if variant.shape.braces {
            return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.MissingPatternField, subpatternSpan))
          }
          run List<BodyPatternTest>.append(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath),
            tag: variant.tag, tags: fieldUnion.count, source: Option<Shared<Type>>.none(), scalar: Option<BodyScalarTest>.none()})
        }
        Node.NominalPattern {annotation, fields: nested} => {
          let nominalField = run nominalUnionOf(&mut resolver.*, &field.ty)
          if let Option<NominalUnion>.Some {value: fieldUnion} = &nominalField {
            // A nested variant pattern tests the field's variant tag, then destructures its payload.
            let selected = run patternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
              &field.ty, annotation, subpatternSpan)
            let variant = match move selected {
              Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
              Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
            }
            if !variant.shape.braces {
              return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnitVariantPayloadPattern, subpatternSpan))
            }
            run List<BodyPatternTest>.append(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath), tag: variant.tag, tags: fieldUnion.count, source: Option<Shared<Type>>.none(), scalar: Option<BodyScalarTest>.none()})
            let nestedOrigin = FieldSource.Variant {tag: variant.tag, shape: move variant.shape}
            let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
              annotations, elided, &mut nodes.*, subject, &nestedOrigin, nested, &fieldPath, access, &mut tests.*, subpatternSpan)
            if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
          } else {
            let written = run patternMemberType(&mut resolver.*, module, annotations, annotation, subpatternSpan)
            let writtenType = match move written {
              Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
              Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
            }
            let mut nestedPath = run copySteps(&fieldPath)
            let unionField = Shared<Type>.with<bool>(&field.ty, sourceUnion)
            let mut candidates = List<Shared<Type>>.make()
            if unionField {
              // A nested member pattern tests the field's canonical member tag, then destructures it.
              let ordered = run UnionProjection.members(&field.ty)
              candidates = match move ordered {
                Option<List<Shared<Type>>>.Some {value} => move value
                Option<List<Shared<Type>>>.None => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
              }
            } else {
              run List<Shared<Type>>.append(&mut candidates, Shared<Type>.clone(&field.ty))
            }
            let chosen = run patternMember(&writtenType, List<Shared<Type>>.asSlice(&candidates), elided)
            let mut tag = usize.ZERO
            let mut nestedType = Shared<Type>.clone(&field.ty)
            match &chosen {
              PatternMember.Selected {tag: found, ty: selectedType} => {
                tag = found
                nestedType = Shared<Type>.clone(&selectedType)
              }
              _ => { return Option<Shared<Rejection>>.some(run rejectPatternMember(&resolver.*, module, &chosen, subpatternSpan, &writtenType, &field.ty)) }
            }
            if unionField {
              run List<BodyPatternTest>.append(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath), tag: tag,
                tags: List<Shared<Type>>.length(&candidates), source: Option<Shared<Type>>.some(Shared<Type>.clone(&field.ty)), scalar: Option<BodyScalarTest>.none()})
              nestedPath = run extendedPath(&fieldPath, BodyPlaceStep.Member {tag: tag, ty: Shared<Type>.clone(&nestedType), source: Shared<Type>.clone(&field.ty)})
            }
            let nestedOrigin = FieldSource.Record {ty: move nestedType}
            let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints,
              annotations, elided, &mut nodes.*, subject, &nestedOrigin, nested, &nestedPath, access, &mut tests.*, subpatternSpan)
            if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
          }
        }
        // An applied variant of a nominal union field, such as `Option<T>.None`, tests its tag like a
        // nested nominal pattern, then destructures any written payload.
        Node.VariantPattern {selector, fields: nested} => {
          let fieldUnion = match move run nominalUnionOf(&mut resolver.*, &field.ty) {
            Option<NominalUnion>.Some {value} => value
            Option<NominalUnion>.None => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.MatchMemberNotInScrutinee, subpatternSpan)) }
          }
          let selected = run appliedPatternVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
            constraints, elided, &field.ty, selector, subpatternSpan)
          let variant = match move selected {
            Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
            Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
          }
          if variant.shape.braces && !nested.present {
            return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.MissingPatternField, subpatternSpan))
          }
          if nested.present && !variant.shape.braces {
            return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.UnitVariantPayloadPattern, subpatternSpan))
          }
          run List<BodyPatternTest>.append(&mut tests.*, BodyPatternTest {path: run copySteps(&fieldPath), tag: variant.tag, tags: fieldUnion.count, source: Option<Shared<Type>>.none(), scalar: Option<BodyScalarTest>.none()})
          let nestedOrigin = FieldSource.Variant {tag: variant.tag, shape: move variant.shape}
          let mut nestedFields = Range.empty()
          if nested.present { nestedFields = nested.range }
          let failed = run checkRecordPatternFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
            constraints, annotations, elided, &mut nodes.*, subject, &nestedOrigin, nestedFields, &fieldPath, access, &mut tests.*, subpatternSpan)
          if let Option<Shared<Rejection>>.Some {value} = move failed { return Option<Shared<Rejection>>.some(move value) }
        }
        _ => { return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.Unsupported, subpatternSpan)) }
      }
    }
    at = at + usize.ONE
  }
  if !rest {
    let mut total = usize.ZERO
    match &origin.* {
      FieldSource.Record {ty} => {
        let counted = run recordFieldCount(&mut resolver.*, module, &ty, span)
        total = match move counted {
          Result<usize, Shared<Rejection>>.Success {value} => value
          Result<usize, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
        }
      }
      FieldSource.Variant {shape, ..} => { total = List<Bytes>.length(&shape.names) }
    }
    if List<usize>.length(&seen) != total {
      // The message names the first field the pattern leaves out.
      let mut names = List<Bytes>.make()
      match &origin.* {
        FieldSource.Record {ty} => { names = run recordFieldNames(&mut resolver.*, &ty) }
        FieldSource.Variant {shape, ..} => {
          let listed = List<Bytes>.asSlice(&shape.names)
          let mut each = usize.ZERO
          while each < listed.length {
            run List<Bytes>.append(&mut names, run Bytes.copy(Bytes.asSlice(&listed[each])))
            each = each + usize.ONE
          }
        }
      }
      let mut diagnostic = run makeRejection(RejectionCode.MissingPatternField, module, span)
      let named = List<Bytes>.asSlice(&names)
      let mut field = usize.ZERO
      let written = List<usize>.asSlice(&seen)
      while field < named.length {
        let mut present = false
        let mut each = usize.ZERO
        while each < written.length {
          if written[each] == field { present = true }
          each = each + usize.ONE
        }
        if !present {
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"field"), value: run Bytes.copy(Bytes.asSlice(&named[field]))})
          run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
          break
        }
        field = field + usize.ONE
      }
      return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
    }
  }
  return Option<Shared<Rejection>>.none()
}

// A struct or union variant literal outside the module that can see all of its fields (SEM0021),
// naming the type, and the variant as in `Shape.Square` when `variant` is not empty. STRUCT-002
// keeps the hidden fields' names and types out of the message.
effect fn inaccessibleConstructionRejection(module: &ModuleId, span: Span, ty: &Shared<Type>, variant: &[u8])
-> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.InaccessibleConstruction, module, span)
  if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(ty, module) {
    let mut named = move text
    if variant.length != usize.ZERO {
      run Bytes.append(&mut named, b".")
      run Bytes.append(&mut named, variant)
    }
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move named})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Every variant field is initialized exactly once with its declared type; the value stores the
// declaration-order tag and the written operand order.
effect fn checkVariantConstruct<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, chosen: Result<SelectedVariant, Shared<Rejection>>, fields: Range,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let variant = match move chosen {
    Result<SelectedVariant, Shared<Rejection>>.Success {value} => move value
    Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  // STRUCT-002: outside the declaring module, a variant with a private field has no source
  // constructor; the literal is rejected without naming the hidden field.
  let mut field = usize.ZERO
  while field < List<Bytes>.length(&variant.shape.names) {
    if !variantFieldVisible(&resolver.*, module, &variant.shape, field) {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run inaccessibleConstructionRejection(module, span, &variant.ty, Bytes.asSlice(&variant.member)))
    }
    field = field + usize.ONE
  }
  let names = List<Bytes>.asSlice(&variant.shape.names)
  let types = List<Shared<Type>>.asSlice(&variant.shape.types)
  let mut operands = List<BodyAggregateField>.make()
  let mut inferred = List<Binding>.make()
  // An expectation of the same union fixes the slots it determines before any operand, so a
  // variant without fields still receives the lifetimes its written qualifier elides.
  if let Option<InferredAggregateTarget>.Some {value: target} = &variant.inference {
    if let Option<Shared<Type>>.Some {value: context} = &expected.* {
      let sameUnion = Shared<Type>.with<bool>(&variant.ty, fn(value: &Type) -> bool { return providerOwnerWith(value, &context) })
      if sameUnion {
        let mut variables = List<Shared<DeclarationId>>.make()
        run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(&target.owner))
        let seeded = run Type.unify(&variant.ty, &context, List<Shared<DeclarationId>>.asSlice(&variables),
          Comparison.Exact, &mut inferred)
        drop seeded
      }
    }
  }
  let mut at = usize.ZERO
  while at < fields.length {
    let initializer = run bodyChild(&resolver.source, cursor, fields, at)
    let mut name = HirId {index: usize.ZERO}
    let mut initializerValue = HirId {index: usize.ZERO}
    if let Node.FieldInitializer {name: fieldNameId, value: fieldValueId} = run bodyNode(&resolver.source, cursor, initializer) {
      name = fieldNameId
      initializerValue = fieldValueId
    } else {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let fieldSpan = run bodySpan(&resolver.source, cursor, name)
    let fieldName = match run bodyNode(&resolver.source, cursor, name) {
      Node.Name {text} => run bodyText(&resolver.source, cursor, text)
      _ => { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownStructField, fieldSpan) }
    }
    let mut index = usize.ZERO
    while index < names.length {
      if same(Bytes.asSlice(&names[index]), Bytes.asSlice(&fieldName)) { break }
      index = index + usize.ONE
    }
    if index == names.length { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownStructField, fieldSpan) }
    let known = List<BodyAggregateField>.asSlice(&operands)
    let mut prior = usize.ZERO
    while prior < known.length {
      if known[prior].index == index { return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateStructInitializer, fieldSpan) }
      prior = prior + usize.ONE
    }
    let checked = run checkAggregateInitializer(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      &types[index], &variant.inference, &Option<Shared<Type>>.none(), &mut inferred, initializerValue, run anchoredNode(cursor, expression),
      constraints, contractBody, staticBody, unsafeAllowed,
    )
    let operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(run namedFieldRejection(move error, Bytes.asSlice(&fieldName))) }
    }
    run List<BodyAggregateField>.append(&mut operands, BodyAggregateField {index: index, value: operand})
    at = at + usize.ONE
  }
  if fields.length != names.length {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run missingFieldsRejection(module, span, names,
      List<BodyAggregateField>.asSlice(&operands)))
  }
  let completed = match move run completeAggregateInference(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, &variant.ty, &variant.inference,
    List<Binding>.asSlice(&inferred), List<BodyNode>.asSlice(&nodes.*), List<BodyAggregateField>.asSlice(&operands),
    constraints, span,
  ) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move completed, form: BodyExpression.VariantConstruct {tag: variant.tag, fields: move operands}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// A record or closed structural-union subject: arms select a member by its canonical tag, bind
// field places, then test their guard. Borrowed and place matches address the subject's storage.
// Checks one expression a statement owns, with that statement's scope; the scope's loans end here.
effect fn checkStatementExpression(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, locals: &mut List<BodyLocal>, annotations: &[ResolvedAnnotation],
  resultType: &Shared<Type>, loopDepth: usize, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool, opaqueConstruction: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut statementScope = StatementScope {locals: &mut locals.*, annotations: annotations, resultType: resultType, loopDepth: loopDepth,
    staticBinders: &[], staticValues: &[], discarded: HirRef.absent()}
  return run checkExpressionUnder(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, opaqueConstruction)
}

// Checks the expression of an expression statement, whose value the statement discards.
effect fn checkDiscardedExpression(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, locals: &mut List<BodyLocal>, annotations: &[ResolvedAnnotation],
  resultType: &Shared<Type>, loopDepth: usize, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut statementScope = StatementScope {locals: &mut locals.*, annotations: annotations, resultType: resultType, loopDepth: loopDepth,
    staticBinders: &[], staticValues: &[], discarded: HirRef.of(expression)}
  return run checkExpressionUnder(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module,
    cursor, caller, &mut statementScope, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, staticBody, unsafeAllowed, false)
}

// Whether the arms of the match at `expression` yield values: they do unless the match is an
// expression statement, whose arm blocks are statement blocks (STMT-001).
fn yieldsArms<'scope>(scope: &StatementScope<'scope>, expression: HirId) -> bool {
  return !scope.discarded.present || scope.discarded.id.index != expression.index
}

// SEM0087 on the last statement of an arm block of a statement `match`, or of a branch block of a
// statement `if`, whose blocks yield nothing, says that the match or `if` is a statement (`template`
// 2 or 4); any other rejection stays as it is.
// SEM0049 on an `if` names its branches rather than match arms (template 1).
effect fn ifBranchRejection(error: Shared<Rejection>) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  if Shared<Rejection>.with<bool>(&error, fn(value: &Rejection) -> bool { return value.code == RejectionCode.IncompatibleMatchResults }) {
    run appendRejectionArgument(&error, b"template", b"1")
  }
  return move error
}

effect fn blockArmValueRejection(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, block: HirId,
  error: Shared<Rejection>, template: &[u8]) -> Shared<Rejection> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let span = Shared<Rejection>.with<Option<Span>>(&error, fn(value: &Rejection) -> Option<Span> {
    if value.code != RejectionCode.ExplicitDiscard { return Option<Span>.none() }
    // An Effect that is never run keeps its own advice to `run` it.
    let arguments = List<MessageArgument>.asSlice(&value.arguments)
    let mut at = usize.ZERO
    while at < arguments.length {
      if same(Bytes.asSlice(&arguments[at].name), b"actual") && endsWithBytes(Bytes.asSlice(&arguments[at].value), b"to discard it)") {
        return Option<Span>.none()
      }
      at = at + usize.ONE
    }
    return Option<Span>.some(value.span)
  })
  let discarded = match move span {
    Option<Span>.Some {value} => value
    Option<Span>.None => { return move error }
  }
  let statements = match run bodyNode(&resolver.source, cursor, block) {
    Node.Block {statements} => statements
    _ => { return move error }
  }
  if statements.length == usize.ZERO { return move error }
  let last = run bodyChild(&resolver.source, cursor, statements, statements.length - usize.ONE)
  let expression = match run bodyNode(&resolver.source, cursor, last) {
    Node.ExpressionStatement {expression} => expression
    _ => { return move error }
  }
  if !sameSpan(run bodySpan(&resolver.source, cursor, expression), discarded) { return move error }
  drop error
  let mut diagnostic = run makeRejection(RejectionCode.ExplicitDiscard, module, discarded)
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
  return run Shared<Rejection>.make(move diagnostic)
}

// One checked match arm result. Immediately after `=>`, braces introduce a statement block of type
// `()` when it can complete; a block whose paths all transfer contributes no result type.
struct CheckedArmResult {
  node: BodyNodeId,
  ty: Option<Shared<Type>>,
  block: bool,
}

effect fn checkArmResult<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, written: HirRef, arm: HirId, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, yields: bool,
) -> Result<CheckedArmResult, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // An `if let` without `else`, or a destructuring `let`, selects an empty statement block.
  if !written.present {
    let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(&mut nodes.*, BodyNode {
      origin: run bodyOrigin(&resolver.source, cursor, arm),
      kind: BodyNodeKind.Block {statements: List<BodyNodeId>.make(), value: Option<BodyNodeId>.none(), canComplete: true},
    })
    return Result<CheckedArmResult, Shared<Rejection>>.succeed(
      CheckedArmResult {node: node, ty: Option<Shared<Type>>.some(run Types.intern(Type.Unit)), block: true},
    )
  }
  let result = written.id
  let mut block = false
  let mut statement = false
  match run bodyNode(&resolver.source, cursor, result) {
    Node.Block {..} => {
      block = true
      statement = true
    }
    Node.ConditionalStatement {..} => { statement = true }
    Node.PatternConditionalStatement {..} => { statement = true }
    _ => ()
  }
  // A block whose value is used yields its last expression (BLOCK-001); a chained `else if`
  // whose value is used is an `if` expression.
  if yields && block {
    return run checkValueBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, result, expected,
      mismatchCode, constraints, contractBody, unsafeAllowed)
  }
  if yields { statement = false }
  if statement {
    let annotations = statementScope.annotations
    let resultType = statementScope.resultType
    let loopDepth = statementScope.loopDepth
    let checked = run checkControl(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.locals.*, annotations, calls,
      &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, result, resultType,
      constraints, contractBody, false, loopDepth, unsafeAllowed)
    let mut control = match move checked {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
        if block {
          return Result<CheckedArmResult, Shared<Rejection>>.failResult(
            run blockArmValueRejection(&resolver.*, module, cursor, result, move error, b"2"),
          )
        }
        return Result<CheckedArmResult, Shared<Rejection>>.failResult(move error)
      }
    }
    // An `else if` mismatch path runs as a one-statement block.
    if !block {
      let mut statements = List<BodyNodeId>.make()
      run List<BodyNodeId>.append(&mut statements, control.node)
      control.node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
      run List<BodyNode>.append(&mut nodes.*, BodyNode {
        origin: run bodyOrigin(&resolver.source, cursor, result),
        kind: BodyNodeKind.Block {statements: move statements, value: Option<BodyNodeId>.none(), canComplete: control.canComplete},
      })
    }
    let mut completed = Option<Shared<Type>>.none()
    if control.canComplete { completed = Option<Shared<Type>>.some(run Types.intern(Type.Unit)) }
    return Result<CheckedArmResult, Shared<Rejection>>.succeed(
      CheckedArmResult {node: control.node, ty: move completed, block: true},
    )
  }
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, result, expected, mismatchCode,
    constraints, contractBody, false, unsafeAllowed)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<CheckedArmResult, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut produced = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node)
  let diverges = match &produced {
    Option<Shared<Type>>.Some {value} => Shared<Type>.with<bool>(&value, neverType)
    Option<Shared<Type>>.None => false
  }
  if diverges { produced = Option<Shared<Type>>.none() }
  return Result<CheckedArmResult, Shared<Rejection>>.succeed(
    CheckedArmResult {node: node, ty: move produced, block: false},
  )
}

// A block in value position: its statements run in order, and a last expression whose type is
// not `()` or `never` is the block's value (BLOCK-001). A block without one produces `()` when it
// can complete, like a statement block.
effect fn checkValueBlock<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, block: HirId, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<CheckedArmResult, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let annotations = statementScope.annotations
  let resultType = statementScope.resultType
  let loopDepth = statementScope.loopDepth
  let tail = BlockTail.Yielded {expected: copyExpected(expected), mismatchCode: mismatchCode}
  let listed = run checkBlockList(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.locals.*, annotations, calls, &mut nodes.*, &mut signatures.*,
    &mut requiredBodies.*, block, resultType, constraints, contractBody, false, loopDepth, unsafeAllowed, &tail)
  let control = match move listed {
    BlockList.Checked {control} => move control
    BlockList.Recovered {failure, ..} => { return Result<CheckedArmResult, Shared<Rejection>>.failResult(move failure) }
    BlockList.Failed {error} => { return Result<CheckedArmResult, Shared<Rejection>>.failResult(move error) }
  }
  let yielded = match &List<BodyNode>.asSlice(&nodes.*)[control.node.index].kind {
    BodyNodeKind.Block {value, ..} => match &value {
      Option<BodyNodeId>.Some {value: produced} => bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &produced)
      Option<BodyNodeId>.None => Option<Shared<Type>>.none()
    }
    _ => Option<Shared<Type>>.none()
  }
  if let Option<Shared<Type>>.Some {..} = &yielded {
    return Result<CheckedArmResult, Shared<Rejection>>.succeed(CheckedArmResult {node: control.node, ty: move yielded, block: false})
  }
  let mut completed = Option<Shared<Type>>.none()
  if control.canComplete { completed = Option<Shared<Type>>.some(run Types.intern(Type.Unit)) }
  return Result<CheckedArmResult, Shared<Rejection>>.succeed(CheckedArmResult {node: control.node, ty: move completed, block: true})
}

fn copyExpected(expected: &Option<Shared<Type>>) -> Option<Shared<Type>> {
  return match &expected.* {
    Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
    Option<Shared<Type>>.None => Option<Shared<Type>>.none()
  }
}

// The node whose value an arm's result produces: the value its block yields, or the result.
fn armValueNode(nodes: &[BodyNode], result: BodyNodeId) -> BodyNodeId {
  if let BodyNodeKind.Block {value: Option<BodyNodeId>.Some {value}, ..} = &nodes[result.index].kind { return value }
  return result
}

// Makes `value` the value arm `arm` produces, inside its block when the block yields one.
effect fn replaceArmValue(nodes: &mut List<BodyNode>, arms: &mut List<BodyMatchArm>, arm: usize, value: BodyNodeId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let result = List<BodyMatchArm>.asSlice(&arms.*)[arm].result
  let yielding = match &List<BodyNode>.asSlice(&nodes.*)[result.index].kind {
    BodyNodeKind.Block {value: Option<BodyNodeId>.Some {..}, ..} => true
    _ => false
  }
  if yielding {
    let mut listed = List<BodyNode>.asMutSlice(&mut nodes.*)
    let kind = Intrinsic.replace(listed[result.index].kind, BodyNodeKind.Break)
    if let BodyNodeKind.Block {statements, canComplete, ..} = move kind {
      listed[result.index].kind = BodyNodeKind.Block {statements: move statements, value: Option<BodyNodeId>.some(value), canComplete: canComplete}
    }
    return ()
  }
  let mut written = List<BodyMatchArm>.asMutSlice(&mut arms.*)
  written[arm].result = value
  return ()
}

// The joined result of the checked arms: equal results keep their type, no result is `never`,
// distinct exact Effects join (EFF-013), and other distinct results join into the union of their
// members. Results that form no valid union are `IncompatibleMatchResults` on the whole match.
struct ArmJoin {
  joined: Option<Shared<Type>>,
  incompatible: bool,
  // Whether a statement block arm completes, producing unit.
  completingBlock: bool,
  // Each arm that produced a value, by its position among the checked arms.
  produced: List<ArmResult>,
}

struct ArmResult {
  arm: usize,
  ty: Shared<Type>,
}

fn emptyArmJoin() -> ArmJoin {
  return ArmJoin {joined: Option<Shared<Type>>.none(), incompatible: false, completingBlock: false,
    produced: List<ArmResult>.make()}
}

effect fn joinArm(join: &mut ArmJoin, arm: usize, produced: &Option<Shared<Type>>, block: bool) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.Some {value} = &produced.* {
    if block { join.completingBlock = true }
    run List<ArmResult>.append(&mut join.produced, ArmResult {arm: arm, ty: Shared<Type>.clone(&value)})
    let prior = match &join.joined {
      Option<Shared<Type>>.Some {value: earlier} => Option<Shared<Type>>.some(Shared<Type>.clone(&earlier))
      Option<Shared<Type>>.None => Option<Shared<Type>>.none()
    }
    match move prior {
      Option<Shared<Type>>.Some {value: earlier} => {
        if !run Type.equalsShared(&earlier, &value) { join.incompatible = true }
      }
      Option<Shared<Type>>.None => { join.joined = Option<Shared<Type>>.some(Shared<Type>.clone(&value)) }
    }
  }
  return ()
}

// Unsuffixed integer literal arms adopt the integer type every other arm produces, as a literal
// operand of an infix expression does, instead of joining a union with the literal's default
// `i32`. Nothing changes unless every literal fits that type.
effect fn adoptLiteralArms(resolver: &Resolver, cursor: &AuthoredCursor, nodes: &mut List<BodyNode>,
  arms: &[BodyMatchArm], join: &mut ArmJoin) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !join.incompatible { return () }
  let results = List<ArmResult>.asSlice(&join.produced)
  let mut literals = List<usize>.make()
  let mut literalNodes = List<BodyNodeId>.make()
  let mut target = Option<Shared<Type>>.none()
  let mut at = usize.ZERO
  while at < results.length {
    let node = armValueNode(List<BodyNode>.asSlice(&nodes.*), arms[results[at].arm].result)
    let mut literal = usize.MAX
    if let BodyNodeKind.Expression {form: BodyExpression.Integer {literal: anchored}, ..} = &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
      if let Node.IntegerLiteral {suffix, ..} = run bodyNode(&resolver.source, cursor, Anchor.hir(&run cursorAnchor(cursor), anchored)) {
        if !suffix.present { literal = anchored }
      }
    }
    if literal != usize.MAX {
      run List<usize>.append(&mut literals, at)
      run List<BodyNodeId>.append(&mut literalNodes, node)
    } else {
      match &target {
        Option<Shared<Type>>.Some {value} => {
          if !run Type.equalsShared(&value, &results[at].ty) { return () }
        }
        Option<Shared<Type>>.None => { target = Option<Shared<Type>>.some(Shared<Type>.clone(&results[at].ty)) }
      }
    }
    at = at + usize.ONE
  }
  let wanted = match move target {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return () }
  }
  let adopted = List<usize>.asSlice(&literals)
  let adoptedNodes = List<BodyNodeId>.asSlice(&literalNodes)
  if adopted.length == usize.ZERO { return () }
  at = usize.ZERO
  while at < adopted.length {
    let node = adoptedNodes[at]
    let mut fits = false
    if let BodyNodeKind.Expression {form: BodyExpression.Integer {literal}, ..} = &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
      if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, Anchor.hir(&run cursorAnchor(cursor), literal)) {
        let digits = run bodyText(&resolver.source, cursor, magnitude)
        fits = Shared<Type>.with<bool>(&wanted, fn(resolved: &Type) -> bool {
          return match &resolved.* {
            Type.Primitive {name} => (fixedIntegerName(Bytes.asSlice(&name)) || pointerSizedIntegerName(Bytes.asSlice(&name))) &&
              fitsInteger(&resolver.target, Bytes.asSlice(&name), sign, Bytes.asSlice(&digits))
            _ => false
          }
        })
      }
    }
    if !fits { return () }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < adopted.length {
    let node = adoptedNodes[at]
    let mut anchored = usize.MAX
    if let BodyNodeKind.Expression {form: BodyExpression.Integer {literal}, ..} = &List<BodyNode>.asSlice(&nodes.*)[node.index].kind {
      anchored = literal
    }
    let mut listed = List<BodyNode>.asMutSlice(&mut nodes.*)
    listed[node.index].kind = BodyNodeKind.Expression {ty: Shared<Type>.clone(&wanted), form: BodyExpression.Integer {literal: anchored}}
    let mut produced = List<ArmResult>.asMutSlice(&mut join.produced)
    produced[adopted[at]].ty = Shared<Type>.clone(&wanted)
    at = at + usize.ONE
  }
  join.joined = Option<Shared<Type>>.some(move wanted)
  join.incompatible = false
  return ()
}

// The match's type. Results that differ only in regions join at the meet of those regions, which
// every result outlives by covariant subtyping (LIFE-002). Arms producing distinct exact Effects
// store the selected one in their finite join: each arm result is injected under its
// alternative's tag (EFF-013).
effect fn joinedMatchType(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, caller: &DeclarationId, constraints: &[Constraint],
  nodes: &mut List<BodyNode>, arms: &mut List<BodyMatchArm>, join: ArmJoin, span: Span)
-> Result<Shared<Type>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !join.incompatible {
    let single = match move join.joined {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => run Types.intern(Type.Union {members: List<Shared<Type>>.make()})
    }
    return Result<Shared<Type>, Shared<Rejection>>.succeed(move single)
  }
  let results = List<ArmResult>.asSlice(&join.produced)
  let met = run regionJoin(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, constraints, results, span)
  if let Option<Shared<Type>>.Some {value: shared} = move met {
    let wanted = Option<Shared<Type>>.some(Shared<Type>.clone(&shared))
    let mut at = usize.ZERO
    while at < results.length {
      let previous = armValueNode(List<BodyNode>.asSlice(&nodes.*), List<BodyMatchArm>.asSlice(&arms.*)[results[at].arm].result)
      let admitted = run admitExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller,
        constraints, &mut nodes.*, previous, &wanted, RejectionCode.IncompatibleMatchResults, span, false, false)
      let accepted = match move admitted {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
      }
      run replaceArmValue(&mut nodes.*, &mut arms.*, results[at].arm, accepted)
      at = at + usize.ONE
    }
    return Result<Shared<Type>, Shared<Rejection>>.succeed(move shared)
  }
  let mut types = List<Shared<Type>>.make()
  let mut effects = true
  let mut at = usize.ZERO
  while at < results.length {
    run List<Shared<Type>>.append(&mut types, Shared<Type>.clone(&results[at].ty))
    if !Shared<Type>.with<bool>(&results[at].ty, joinableEffect) { effects = false }
    at = at + usize.ONE
  }
  if !effects {
    return run unionMatchType(&resolver.*, module, &mut nodes.*, &mut arms.*, results, move types, join.completingBlock, span)
  }
  let joined = match move run effectJoinType(List<Shared<Type>>.asSlice(&types)) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleMatchResults, span)) }
  }
  at = usize.ZERO
  while at < results.length {
    let previous = armValueNode(List<BodyNode>.asSlice(&nodes.*), List<BodyMatchArm>.asSlice(&arms.*)[results[at].arm].result)
    let injected = match move run injectJoined(&mut nodes.*, previous, &joined) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.NestedEffectJoinUnavailable, span)) }
    }
    run replaceArmValue(&mut nodes.*, &mut arms.*, results[at].arm, injected)
    at = at + usize.ONE
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(move joined)
}

// The type every arm result meets when the results differ only in regions: each region where they
// differ becomes the meet of their regions. Absent when they differ in anything else, or when a
// result does not outlive the meet by covariant subtyping without a relation left to the region check.
effect fn regionJoin(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &DeclarationId, constraints: &[Constraint], results: &[ArmResult], span: Span)
-> Option<Shared<Type>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if results.length == usize.ZERO { return Option<Shared<Type>>.none() }
  let mut met = Shared<Type>.clone(&results[usize.ZERO].ty)
  let mut at = usize.ONE
  while at < results.length {
    let next = run meetRegions(&met, &results[at].ty)
    match move next {
      Option<Shared<Type>>.Some {value} => { met = move value }
      Option<Shared<Type>>.None => { return Option<Shared<Type>>.none() }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < results.length {
    let mut deferred = List<RegionPair>.make()
    let admitted = run admitsRegions(&mut resolver.*, &mut owner.*, &mut dependencies.*, &results[at].ty, &met, caller,
      constraints, true, &mut deferred, span)
    if !admitted || List<RegionPair>.length(&deferred) != usize.ZERO { return Option<Shared<Type>>.none() }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.some(move met)
}

// A string, reference or slice, whose region a later arm may shorten to the first one's.
fn borrowedView(value: &Type) -> bool {
  return match &value.* {
    Type.String {..} => true
    Type.Reference {..} => true
    Type.Slice {..} => true
    _ => false
  }
}

// The union of distinct non-Effect arm results, with each arm's value stored as its member. A
// completing statement block contributes unit, which never joins a value. A result that is itself
// a union has no member injection into a wider union, and members that form no source union
// (such as borrowed views) are incompatible.
effect fn unionMatchType(resolver: &Resolver, module: &ModuleId, nodes: &mut List<BodyNode>, arms: &mut List<BodyMatchArm>,
  results: &[ArmResult], types: List<Shared<Type>>, completingBlock: bool, span: Span)
-> Result<Shared<Type>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = List<Shared<Type>>.asSlice(&types)
  let mut holdsEffect = false
  let mut at = usize.ZERO
  while at < listed.length {
    if Shared<Type>.with<bool>(&listed[at], joinableEffect) { holdsEffect = true }
    at = at + usize.ONE
  }
  // An exact Effect joins only other Effects (EFF-013); it is never a union member.
  if completingBlock || holdsEffect {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.IncompatibleMatchResults, span))
  }
  let joined = run joinedType(move types)
  if !Shared<Type>.with<bool>(&joined, sourceUnion) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.IncompatibleMatchResults, span))
  }
  at = usize.ZERO
  while at < results.length {
    if !run Type.equalsShared(&results[at].ty, &joined) {
      let previous = armValueNode(List<BodyNode>.asSlice(&nodes.*), List<BodyMatchArm>.asSlice(&arms.*)[results[at].arm].result)
      let nested = Shared<Type>.with<bool>(&results[at].ty, fn(ty: &Type) -> bool {
        return match &ty.* { Type.Union {..} => true _ => false }
      })
      let injected = run unionArgument(&mut nodes.*, previous, &joined)
      if nested || injected.index == previous.index {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.IncompatibleMatchResults, span))
      }
      run replaceArmValue(&mut nodes.*, &mut arms.*, results[at].arm, injected)
    }
    at = at + usize.ONE
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(move joined)
}

// The finite join of exact Effects behind one contract (EFF-013): their distinct alternatives in
// first-seen order. Joins that share a contract keep it; otherwise the contract joins successes
// and failures, unites requirement rows, takes the strongest run access, and retains the
// intersection of every environment, which each alternative outlives. Absent when a value is not
// an exact Effect.
effect fn effectJoinType(types: &[Shared<Type>]) -> Option<Shared<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut alternatives = List<Shared<Type>>.make()
  let mut shared = Option<Shared<Type>>.none()
  let mut sameContract = true
  let mut successes = List<Shared<Type>>.make()
  let mut failures = List<Shared<Type>>.make()
  let mut requirements = Row.empty()
  let mut mode = CallableMode.Shared
  let mut regions = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < types.length {
    if !Shared<Type>.with<bool>(&types[at], joinableEffect) { return Option<Shared<Type>>.none() }
    let parts = match move Shared<Type>.with<Option<EffectParts>>(&types[at], effectParts) {
      Option<EffectParts>.Some {value} => move value
      Option<EffectParts>.None => { return Option<Shared<Type>>.none() }
    }
    let retained = run callableEnvironmentRegions(&parts.environment)
    let listedRegions = List<Shared<Lifetime>>.asSlice(&retained)
    let mut region = usize.ZERO
    while region < listedRegions.length {
      run List<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(&listedRegions[region]))
      region = region + usize.ONE
    }
    run List<Shared<Type>>.append(&mut successes, Shared<Type>.clone(&parts.success))
    run List<Shared<Type>>.append(&mut failures, Shared<Type>.clone(&parts.failure))
    run Row.merge(&mut requirements, &parts.requirements)
    if runStrength(parts.mode) > runStrength(mode) { mode = parts.mode }
    let copied = run Type.copy(&types[at])
    if let Type.EffectJoin {contract, ..} = move copied {
      let mut unset = false
      match &shared {
        Option<Shared<Type>>.Some {value: previous} => { if !run Type.equalsShared(&previous, &contract) { sameContract = false } }
        Option<Shared<Type>>.None => { unset = true }
      }
      if unset { shared = Option<Shared<Type>>.some(move contract) }
    } else { sameContract = false }
    let stored = run joinAlternatives(&types[at])
    let listed = List<Shared<Type>>.asSlice(&stored)
    let mut item = usize.ZERO
    while item < listed.length {
      if (run joinAlternative(List<Shared<Type>>.asSlice(&alternatives), &listed[item])) == usize.MAX {
        run List<Shared<Type>>.append(&mut alternatives, Shared<Type>.clone(&listed[item]))
      }
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  let retained = run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions)))
  if sameContract {
    if let Option<Shared<Type>>.Some {value: contract} = move shared {
      return Option<Shared<Type>>.some(run Types.intern(Type.EffectJoin {contract: move contract, alternatives: move alternatives}))
    }
  }
  let contract = run Types.intern(Type.Effect {mode: mode, environment: move retained, success: run joinedType(move successes),
    failure: run joinedType(move failures), requirements: run Shared<Row>.make(move requirements)})
  return Option<Shared<Type>>.some(run Types.intern(Type.EffectJoin {contract: move contract, alternatives: move alternatives}))
}

// The position of an exact Effect among a join's alternatives, or `usize.MAX`.
effect fn joinAlternative(alternatives: &[Shared<Type>], value: &Shared<Type>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < alternatives.length {
    if run Type.equalsShared(&alternatives[at], value) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Stores a value holding one alternative of `joined` as that join: a union injection under the
// alternative's tag, or the value itself when it already has the join's type. Absent for a value
// that already holds several alternatives of a different join.
effect fn injectJoined(nodes: &mut List<BodyNode>, node: BodyNodeId, joined: &Shared<Type>) -> Option<BodyNodeId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<BodyNodeId>.none() }
  }
  if run Type.equalsShared(&actual, joined) { return Option<BodyNodeId>.some(node) }
  let held = run joinAlternatives(&actual)
  if List<Shared<Type>>.length(&held) != usize.ONE { return Option<BodyNodeId>.none() }
  let all = run joinAlternatives(joined)
  let single = List<Shared<Type>>.asSlice(&held)
  let tag = run joinAlternative(List<Shared<Type>>.asSlice(&all), &single[usize.ZERO])
  if tag == usize.MAX { return Option<BodyNodeId>.none() }
  let origin = List<BodyNode>.asSlice(&nodes.*)[node.index].origin
  let injected = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: origin, kind: BodyNodeKind.Expression {
    ty: Shared<Type>.clone(joined), form: BodyExpression.UnionInject {tag: tag, value: node}}})
  return Option<BodyNodeId>.some(injected)
}

// The arms one pattern selection checks: the written arms of a `match`, the selected body and
// mismatch path of `if let` (PATT-007), or the single irrefutable arm of a destructuring `let`
// (PATT-006), whose bindings stay visible to the statements after it.
union MatchArms {
  Written {arms: Range},
  Conditional {pattern: HirId, thenBranch: HirId, elseBranch: HirRef},
  Binding {pattern: HirId},
}

impl Copy for MatchArms {}

fn matchArmCount(arms: MatchArms) -> usize {
  return match arms {
    MatchArms.Written {arms: written} => written.length
    MatchArms.Conditional {..} => usize.ONE + usize.ONE
    MatchArms.Binding {..} => usize.ONE
  }
}

// How a binding of a match with `access` reaches its subject.
fn bindingAccess(access: MatchAccess) -> BodyBindingAccess {
  return match access {
    MatchAccess.Default => BodyBindingAccess.Copied
    MatchAccess.Move => BodyBindingAccess.Moved
    MatchAccess.Place => BodyBindingAccess.Place
    MatchAccess.Shared => BodyBindingAccess.Shared
    MatchAccess.Mutable => BodyBindingAccess.Exclusive
  }
}

// The bindings one arm's pattern declared: the `PatternBinding` nodes of `subject` appended from
// node `from` on, before any guard or result uses them.
effect fn declaredBindings(nodes: &[BodyNode], from: usize, subject: BodyNodeId) -> List<BodyNodeId>
! OutOfMemoryError ? &mut Allocator {
  let mut declared = List<BodyNodeId>.make()
  let mut at = from
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {subject: bound, ..}, ..} = &nodes[at].kind {
      if bound.index == subject.index { run List<BodyNodeId>.append(&mut declared, BodyNodeId {index: at}) }
    }
    at = at + usize.ONE
  }
  return move declared
}

// A consuming match records its subject's owned place. Copy values still cannot be extracted
// through a Drop-hooked ancestor. Invalid extraction is anchored at the subject; a hook at the match.
effect fn consumingMatchAccess(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &[BodyNode], subject: BodyNodeId, subjectType: &Shared<Type>, constraints: &[Constraint], span: Span)
  -> Result<BodySubjectAccess, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, subjectType, constraints, span) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodySubjectAccess, Shared<Rejection>>.failResult(move error) }
  }
  let subjectSpan = run originSpan(cursor, nodes[subject.index].origin)
  let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
    nodes, subject, copied, false, subjectSpan, span, constraints) {
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => {
      return Result<BodySubjectAccess, Shared<Rejection>>.failResult(move error)
    }
  }
  return Result<BodySubjectAccess, Shared<Rejection>>.succeed(BodySubjectAccess.Consume {consumed: move consumed})
}

effect fn checkRecordMatch<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, subjectNode: BodyNodeId, subjectType: &Shared<Type>, writtenAccess: MatchAccess, arms: MatchArms,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut access = writtenAccess
  // A bare `match` over a non-Copy place, already recorded; the match fails with it once checked.
  let mut bareMatch = Option<Shared<Rejection>>.none()
  // A reference matches only through its referent: `match &status.*`, not `match status`.
  let reference = Shared<Type>.with<bool>(subjectType, fn(value: &Type) -> bool {
    return match &value.* {
      Type.Reference {..} => true
      _ => false
    }
  })
  let writtenArms = match arms {
    MatchArms.Binding {..} => false
    _ => true
  }
  if reference && writtenArms {
    let subjectSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[subjectNode.index].origin)
    return run bodyRejection(&resolver.*, module, RejectionCode.ReferenceMatchSubject, subjectSpan)
  }
  // A bare match reads one copy, so it is valid only for a Copy scrutinee (MATCH-001). A match,
  // pattern `let` or `if let` over a temporary already owns it, so it consumes the temporary as `move`
  // would.
  if access == MatchAccess.Default {
    let copied = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, subjectType, constraints, span)
    match move copied {
      Result<bool, Shared<Rejection>>.Success {value} => {
        if !value {
          let mut temporary = false
          let mut borrowed = false
          match move run consumption(&resolver.source, cursor, List<BodyNode>.asSlice(&nodes.*), subjectNode) {
            Consumption.Rvalue => { temporary = true }
            Consumption.Borrowed => { borrowed = true }
            _ => {}
          }
          if !temporary {
            let written = match arms {
              MatchArms.Written {..} => true
              _ => false
            }
            if !written { return run bodyRejection(&resolver.*, module, RejectionCode.ExplicitMoveRequired, span) }
            // A written `match` names its subject and both fixes, then goes on checking as `match move`
            // would, so a missing arm is reported too. A subject read through a borrow cannot be moved
            // out at all, so its message names only `&` and checking goes on as that shared match.
            let subjectSpan = run originSpan(cursor, List<BodyNode>.asSlice(&nodes.*)[subjectNode.index].origin)
            let mut diagnostic = run makeRejection(RejectionCode.ExplicitMoveRequired, module, subjectSpan)
            diagnostic.arguments = List<MessageArgument>.make()
            let mut template = b"2"
            if borrowed { template = b"3" }
            run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
            let rejection = run Shared<Rejection>.make(move diagnostic)
            run recordRecovered(&mut resolver.*, Shared<Rejection>.clone(&rejection))
            bareMatch = Option<Shared<Rejection>>.some(move rejection)
          }
          access = MatchAccess.Move
          if borrowed { access = MatchAccess.Shared }
        }
      }
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  // A place, shared or exclusive match addresses its subject's storage. A shared subject that names
  // no existing storage is evaluated into a temporary, like a borrowed operand (BORROW-006); an
  // exclusive or place match must name an existing place (MATCH-001).
  let place = access != MatchAccess.Move && access != MatchAccess.Default
  if (access == MatchAccess.Mutable || access == MatchAccess.Place) && !checkedPlace(List<BodyNode>.asSlice(&nodes.*), subjectNode) {
    return run bodyRejection(&resolver.*, module, RejectionCode.InvalidMatchScrutineePlace, span)
  }
  // A place match refines its subject's own storage, so the subject is a complete binding place:
  // fields and literal fixed-array elements of a binding, never a runtime index or a referent
  // (MATCH-001, the bootstrap's `OWN0009`).
  if access == MatchAccess.Place && !completeBindingPlace(List<BodyNode>.asSlice(&nodes.*), subjectNode) {
    return run bodyRejection(&resolver.*, module, RejectionCode.InvalidMatchScrutineePlace, span)
  }
  // An exclusive match lends its subject's place to its bindings, so like `&mut` it needs a mutable
  // place (MATCH-001).
  if access == MatchAccess.Mutable && !mutablePlace(List<BodyNode>.asSlice(&nodes.*),
    List<BodyLocal>.asSlice(&statementScope.locals.*), subjectNode) {
    return run bodyRejection(&resolver.*, module, RejectionCode.ExclusiveMatchRequiresMutable, span)
  }
  // A consuming match transfers the subject's place into the selected arm (MATCH-002).
  let mut subjectAccess = BodySubjectAccess.Copy
  if place { subjectAccess = BodySubjectAccess.Place {access: bindingAccess(access)} }
  if access == MatchAccess.Move {
    subjectAccess = match move run consumingMatchAccess(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      cursor, List<BodyNode>.asSlice(&nodes.*), subjectNode, subjectType, constraints, span) {
      Result<BodySubjectAccess, Shared<Rejection>>.Success {value} => move value
      Result<BodySubjectAccess, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  // Pattern annotations take every lifetime they elide from the subject they match (LIFE-003).
  let elided = run elidedLifetimeOwner(caller)
  let isUnion = Shared<Type>.with<bool>(subjectType, sourceUnion)
  let nominal = run nominalUnionOf(&mut resolver.*, subjectType)
  let isNominal = match &nominal {
    Option<NominalUnion>.Some {..} => true
    Option<NominalUnion>.None => false
  }
  let mut members = List<Shared<Type>>.make()
  let mut count = usize.ZERO
  if let Option<NominalUnion>.Some {value} = &nominal {
    count = value.count
  } else if isUnion {
    let canonical = run UnionProjection.members(subjectType)
    members = match move canonical {
      Option<List<Shared<Type>>>.Some {value} => move value
      Option<List<Shared<Type>>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
  } else if run declaredRecord(&mut resolver.*, subjectType) {
    run List<Shared<Type>>.append(&mut members, Shared<Type>.clone(subjectType))
  } else if !Shared<Type>.with<bool>(subjectType, matchScalarSubject) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  // A scalar subject has no finite member set here, so only an unguarded `_` arm covers it.
  let open = Shared<Type>.with<bool>(subjectType, matchScalarSubject)
  if !isNominal { count = List<Shared<Type>>.length(&members) }
  let mut rows = List<CoverageRow>.make()
  while List<CoverageRow>.length(&rows) < count {
    let member = List<CoverageRow>.length(&rows)
    run List<CoverageRow>.append(&mut rows, CoverageRow {member: member, constraints: List<CoverageConstraint>.make()})
  }
  let mut universal = false
  let mut resultType = match &expected.* {
    Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
    Option<Shared<Type>>.None => Option<Shared<Type>>.none()
  }
  let mut join = emptyArmJoin()
  // Integer values an unguarded earlier arm already selected; a repeat is a duplicate pattern.
  let mut integerCases = List<Bytes>.make()
  let integerSubject = Shared<Type>.with<bool>(subjectType, fn(value: &Type) -> bool {
    return fixedIntegerType(value) || pointerSizedIntegerType(value)
  })
  let mut checkedArms = List<BodyMatchArm>.make()
  let mut failedArms = List<Shared<Rejection>>.make()
  let armCount = matchArmCount(arms)
  let mut at = usize.ZERO
  while at < armCount {
    let mut armId = expression
    let mut pattern = expression
    let mut guard = HirRef.absent()
    let mut result = HirRef.absent()
    // The `if let` mismatch path is an unwritten `_` arm; a redundant one stays valid (PATT-010).
    let mut fallback = false
    match arms {
      MatchArms.Written {arms: written} => {
        armId = run bodyChild(&resolver.source, cursor, written, at)
        if let Node.MatchArm {pattern: writtenPattern, guard: writtenGuard, result: writtenResult} = run bodyNode(&resolver.source, cursor, armId) {
          pattern = writtenPattern
          guard = writtenGuard
          result = HirRef.of(writtenResult)
        } else {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, armId))
        }
      }
      MatchArms.Conditional {pattern: selected, thenBranch, elseBranch} => {
        if at == usize.ZERO {
          armId = thenBranch
          pattern = selected
          result = HirRef.of(thenBranch)
        } else {
          fallback = true
          if elseBranch.present { armId = elseBranch.id }
          result = elseBranch
        }
      }
      MatchArms.Binding {pattern: selected} => { pattern = selected }
    }
    let armSpan = run bodySpan(&resolver.source, cursor, armId)
    let patternSpan = run bodySpan(&resolver.source, cursor, pattern)
    // A written arm is unreachable as a whole, from its pattern to its result (SEM0043).
    let unreachableSpan = match arms {
      MatchArms.Written {..} => armSpan
      _ => patternSpan
    }
    let mut writtenPattern = Node.UniversalPattern {name: HirRef.absent()}
    if !fallback { writtenPattern = run bodyNode(&resolver.source, cursor, pattern) }
    let mut armTests = List<BodyPatternTest>.make()
    // Pattern checking appends exactly the nodes that declare this arm's bindings.
    let bindingsFrom = List<BodyNode>.length(&nodes.*)
    let checkedArm = run checkArmPattern(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
      constraints, statementScope.annotations, &elided, &mut nodes.*, subjectNode, subjectType, access,
      List<Shared<Type>>.asSlice(&members), &rows, List<Bytes>.asSlice(&integerCases), integerSubject, isNominal,
      isUnion, open, universal, fallback, writtenPattern, pattern, patternSpan, unreachableSpan, &mut armTests)
    // An arm whose pattern fails covers nothing and joins no result; the arms after it are still
    // checked, and the match fails once they are (MATCH-001).
    let selection = match move checkedArm {
      Result<ArmPattern, Shared<Rejection>>.Success {value} => move value
      Result<ArmPattern, Shared<Rejection>>.Failure {error} => {
        run List<Shared<Rejection>>.append(&mut failedArms, move error)
        at = at + usize.ONE
        continue
      }
    }
    let ArmPattern {pattern: checkedPattern, ordinal, integerCase} = move selection
    let armBindings = run declaredBindings(List<BodyNode>.asSlice(&nodes.*), bindingsFrom, subjectNode)
    let mut checkedGuard = Option<BodyNodeId>.none()
    if guard.present {
      let tested = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
        &mut signatures.*, &mut requiredBodies.*, guard.id, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
        constraints, contractBody, false, unsafeAllowed)
      let guardNode = match move tested {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      let guardType = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &guardNode)
      let boolean = run primitiveType(b"bool")
      // A guard that always exits, such as a match whose arms return, is `never` (any type).
      let isBoolean = match &guardType {
        Option<Shared<Type>>.Some {value} => (run Type.equalsShared(&value, &boolean)) || Shared<Type>.with<bool>(&value, neverType)
        Option<Shared<Type>>.None => false
      }
      if !isBoolean {
        return run guardTypeRejection(&resolver.*, module, run bodySpan(&resolver.source, cursor, guard.id), &guardType)
      }
      checkedGuard = Option<BodyNodeId>.some(guardNode)
    } else if let Option<Bytes>.Some {value: selectedCase} = move integerCase {
      run List<Bytes>.append(&mut integerCases, move selectedCase)
    } else {
      if ordinal == usize.MAX {
        universal = true
        rows = List<CoverageRow>.make()
      } else {
        let mut remaining = List<CoverageRow>.make()
        let uncovered = List<CoverageRow>.asSlice(&rows)
        let mut scan = usize.ZERO
        while scan < uncovered.length {
          if uncovered[scan].member == ordinal {
            run subtractRow(&uncovered[scan], &armTests, &mut remaining)
          } else {
            run List<CoverageRow>.append(&mut remaining, run copiedRow(&uncovered[scan]))
          }
          scan = scan + usize.ONE
        }
        rows = move remaining
      }
    }
    let yields = yieldsArms(&statementScope.*, expression)
    let checkedResult = run checkArmResult(&mut resolver.*, &mut owner.*, &mut request.*,
      &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
      &mut signatures.*, &mut requiredBodies.*, result, armId, &resultType, match &expected.* { Option<Shared<Type>>.Some {..} => mismatchCode Option<Shared<Type>>.None => RejectionCode.IncompatibleMatchResults }, constraints, contractBody, unsafeAllowed,
      yields)
    let armResult = match move checkedResult {
      Result<CheckedArmResult, Shared<Rejection>>.Success {value} => move value
      Result<CheckedArmResult, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
    let resultNode = armResult.node
    // Without a context type, arms check independently and their results join. Only a borrowed
    // view supplies the expected type of later expression arms, so a later view can take the
    // shorter region the first one already names; a block never does.
    let unset = match &resultType {
      Option<Shared<Type>>.Some {..} => false
      Option<Shared<Type>>.None => true
    }
    if unset && !armResult.block {
      if let Option<Shared<Type>>.Some {value: produced} = &armResult.ty {
        if Shared<Type>.with<bool>(&produced, borrowedView) { resultType = Option<Shared<Type>>.some(Shared<Type>.clone(&produced)) }
      }
    }
    run joinArm(&mut join, List<BodyMatchArm>.length(&checkedArms), &armResult.ty, armResult.block)
    run List<BodyMatchArm>.append(&mut checkedArms, BodyMatchArm {
      origin: run originAt(cursor, armId, armSpan),
      pattern: move checkedPattern, tests: move armTests, guard: move checkedGuard, result: resultNode,
      bindings: move armBindings,
    })
    at = at + usize.ONE
  }
  // A match with a failed arm fails with each arm's diagnostic in order. Its coverage is unknown,
  // so it reports no missing member.
  let failedCount = List<Shared<Rejection>>.length(&failedArms)
  if failedCount != usize.ZERO {
    let failed = List<Shared<Rejection>>.asSlice(&failedArms)
    let mut reported = usize.ZERO
    while reported + usize.ONE < failedCount {
      run recordRecovered(&mut resolver.*, Shared<Rejection>.clone(&failed[reported]))
      reported = reported + usize.ONE
    }
    return Result<BodyNodeId, Shared<Rejection>>.failResult(Shared<Rejection>.clone(&failed[reported]))
  }
  // An unconditional `let` must prove its pattern matches every value (PATT-006, SEM0133).
  if let MatchArms.Binding {pattern} = arms {
    if (open && !universal) || List<CoverageRow>.length(&rows) != usize.ZERO {
      return run bodyRejection(&resolver.*, module, RejectionCode.RefutableBinding, run bodySpan(&resolver.source, cursor, pattern))
    }
  }
  // A scalar scrutinee's values are not enumerated, so it needs an unguarded `_` (SEM0044).
  if !universal && open {
    let mut diagnostic = run makeRejection(RejectionCode.IncompleteMatch, module, span)
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"missing"),
      value: run Bytes.copy(b"every value; add a `_` arm")})
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
  }
  if List<CoverageRow>.length(&rows) != usize.ZERO {
    let mut uncovered = List<usize>.make()
    let remaining = List<CoverageRow>.asSlice(&rows)
    let mut row = usize.ZERO
    while row < remaining.length {
      if !holdsIndex(List<usize>.asSlice(&uncovered), remaining[row].member) { run List<usize>.append(&mut uncovered, remaining[row].member) }
      row = row + usize.ONE
    }
    if let Option<NominalUnion>.Some {value: declared} = &nominal {
      let declarationAccessMissingRequest = Key {
        family: Family.Members, module: declared.module, name: usize.ZERO,
        declaration: declared.declaration, member: usize.ZERO, external: false,
      }
      let declarationAccessMissing = run internDeclaration(&mut resolver.*, declarationAccessMissingRequest)
      let names = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccessMissing, span)
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run missingMembersRejection(module, RejectionCode.MissingUnionMember, span, &names, List<usize>.asSlice(&uncovered)))
    }
    return Result<BodyNodeId, Shared<Rejection>>.failResult(
      run missingTypesRejection(module, span, List<Shared<Type>>.asSlice(&members), List<usize>.asSlice(&uncovered)))
  }
  if let Option<Shared<Rejection>>.Some {value: bare} = move bareMatch {
    run takeRecovered(&mut resolver.*, &bare)
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move bare)
  }
  let mut tags = usize.ZERO
  if isUnion || isNominal { tags = count }
  let mut domain = count
  if open { domain = usize.MAX }
  drop resultType
  run adoptLiteralArms(&resolver.*, cursor, &mut nodes.*, List<BodyMatchArm>.asSlice(&checkedArms), &mut join)
  let conditional = match arms {
    MatchArms.Conditional {..} => true
    _ => false
  }
  let matchType = match move run joinedMatchType(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints,
    &mut nodes.*, &mut checkedArms, move join, span) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      if !conditional { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run ifBranchRejection(move error))
    }
  }
  let diverges = Shared<Type>.with<bool>(&matchType, neverType)
  // The written form fixes where consuming bindings and the subject's untaken parts end.
  let syntax = match arms {
    MatchArms.Written {..} => BodyMatchSyntax.Match
    MatchArms.Conditional {..} => BodyMatchSyntax.IfLet
    MatchArms.Binding {..} => BodyMatchSyntax.Let
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move matchType, form: BodyExpression.Match {subject: subjectNode, access: move subjectAccess,
      tags: tags, domain: domain, arms: move checkedArms, syntax: syntax}},
  })
  // A match whose arms all transfer is `never`, which every context accepts.
  if diverges { return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index}) }
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

struct CheckedRecordFields {
  ty: Shared<Type>,
  fields: List<BodyAggregateField>,
}

// Record and nominal-variant payload inference share one operand, borrow-region and unifier lane.
effect fn checkAggregateInitializer<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>, signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>, memberType: &Shared<Type>,
  inference: &Option<InferredAggregateTarget>, construction: &Option<Shared<Type>>, inferred: &mut List<Binding>,
  initializerValue: HirId, loanOrdinal: usize, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut appliedMember = Shared<Type>.clone(memberType)
  let mut context = Option<Shared<Type>>.some(Shared<Type>.clone(memberType))
  let mut nestedConstruction = false
  let mut inferredBorrowRegion = false
  let mut fixedBorrowContext = false
  // The literal's binder the field's own loan fills: a fresh loan there takes the literal's region
  // for that binder, so loans that fill distinct binders stay distinct regions.
  let mut loanBinder = usize.MAX
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    appliedMember = run Type.applyBindings(memberType, List<Binding>.asSlice(&inferred.*), true)
    let targetOwner = Shared<DeclarationId>.clone(&target.owner)
    let ownerId = DeclarationId.copyShared(&targetOwner)
    let memberRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(&appliedMember, operandRegion)
    if let Option<Shared<Lifetime>>.Some {value: region} = move memberRegion {
      // A region an earlier field fixed for the literal's own binder still leaves this borrow its
      // own region, which the binder then meets.
      let declaredRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(memberType, operandRegion)
      let mut inferredBinder = false
      if let Option<Shared<Lifetime>>.Some {value: declared} = move declaredRegion {
        let ordinal = ownedLifetimeOrdinal(&declared, &ownerId)
        inferredBinder = ordinal < nominalArgumentCount(&target.ty)
        if inferredBinder { loanBinder = ordinal }
      }
      if !inferredBinder { loanBinder = ownedLifetimeOrdinal(&region, &ownerId) }
      inferredBorrowRegion = inferredBinder || loanBinder != usize.MAX
      fixedBorrowContext = !inferredBorrowRegion
    }
    // A region an earlier field fixed for an inferred binder is evidence, not an expectation: a
    // later field that reads an existing value meets it through binder shortening below. A field
    // that constructs its value, such as a borrow or a call with elided regions, still takes it as
    // its context unless it holds a lifetime parameter, which would make a construction from a
    // local outlive the caller's region; that field meets it instead, so the literal infers the
    // meet of its fields' regions in any order.
    let mut typeBindings = List<Binding>.make()
    let held = List<Binding>.asSlice(&inferred.*)
    let mut at = usize.ZERO
    while at < held.length {
      if let Argument.Lifetime {..} = &held[at].value {} else {
        run List<Binding>.append(&mut typeBindings, Binding {declaration: Shared<DeclarationId>.clone(&held[at].declaration),
          ordinal: held[at].ordinal, value: Argument.copy(&held[at].value)})
      }
      at = at + usize.ONE
    }
    let typed = run Type.applyBindings(memberType, List<Binding>.asSlice(&typeBindings), true)
    let readSyntax = match run bodyNode(&resolver.source, cursor, initializerValue) {
      Node.IdentifierExpression {..} => true
      Node.FieldExpression {..} => true
      Node.MemberExpression {..} => true
      Node.ReferentExpression {..} => true
      _ => false
    }
    let open = run typeMentionsOwner(&appliedMember, &ownerId)
    let fieldFixed = run typeMentionsOwner(&typed, &ownerId)
    // Only a field whose declared region is the literal's own binder can meet it; a region inside a
    // written type argument cannot shorten, so that field keeps its context.
    let fixedRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(&appliedMember, operandRegion)
    let declaredOwn = Shared<Type>.with<Option<Shared<Lifetime>>>(memberType, operandRegion)
    let mut parameterFixed = false
    if let Option<Shared<Lifetime>>.Some {value: declared} = &declaredOwn {
      if ownedLifetimeOrdinal(&declared, &ownerId) < nominalArgumentCount(&target.ty) {
        if let Option<Shared<Lifetime>>.Some {value: fixed} = &fixedRegion {
          parameterFixed = holdsLifetimeParameter(&fixed)
        }
      }
    }
    if open || (fieldFixed && (readSyntax || parameterFixed)) {
      context = Option<Shared<Type>>.none()
    } else {
      context = Option<Shared<Type>>.some(Shared<Type>.clone(&appliedMember))
    }
  }
  // A nested literal keeps the original nominal shell even when the parent infers its whole
  // argument. This is construction context, not permission to fix an opaque representation.
  if let Option<Shared<Type>>.Some {value: blueprint} = &construction.* {
    if run Type.containsOpaque(&blueprint, caller) {
      let kind = Shared<Type>.with<OwnerKind>(&blueprint, nominalKind)
      let literal = run bodyNode(&resolver.source, cursor, initializerValue)
      nestedConstruction = match literal {
        Node.RecordExpression {..} => kind == OwnerKind.Struct
        Node.TupleExpression {..} => kind == OwnerKind.Tuple
        _ => false
      }
      if nestedConstruction {
        context = Option<Shared<Type>>.some(Shared<Type>.clone(&blueprint))
      }
    }
  }
  let mut operand = BodyNodeId {index: usize.ZERO}
  let mut checkedAggregateBorrow = false
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&appliedMember) {
      if let Node.BorrowExpression {access, operand: borrowedOperand} = run bodyNode(
        &resolver.source,
        cursor,
        initializerValue,
      ) {
        let mut elementContext = Option<Shared<Type>>.none()
        let targetOwner = Shared<DeclarationId>.clone(&target.owner)
        let ownerId = DeclarationId.copyShared(&targetOwner)
        if !run typeMentionsOwner(&element, &ownerId) {
          elementContext = Option<Shared<Type>>.some(Shared<Type>.clone(&appliedMember))
        }
        let checked = run checkBorrowOperand(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          caller,
          &mut statementScope.*,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          initializerValue,
          access,
          borrowedOperand,
          &elementContext, RejectionCode.StructFieldTypeMismatch,
          true,
          false,
          loanOrdinal,
          loanBinder,
          constraints,
          contractBody,
          false,
          unsafeAllowed,
        )
        let borrowed = match move checked {
          Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
          Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
          }
        }
        operand = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run bodyOrigin(&resolver.source, cursor, initializerValue),
          kind: BodyNodeKind.Expression {
            ty: move borrowed.ty,
            form: BodyExpression.Borrow {access: access, value: borrowed.value},
          },
        })
        operand = run sliceArgument(&mut nodes.*, operand, &appliedMember)
        checkedAggregateBorrow = true
      }
    }
  }
  // A fixed reference lifetime still supplies the reborrow context when its referent type is
  // inferred. Check that borrow without the ordinary exact-type boundary; the aggregate unifier
  // below checks the inferred referent and every written binding together.
  if !checkedAggregateBorrow && fixedBorrowContext {
    if let Option<Shared<Type>>.None = &context {
      if let Node.BorrowExpression {access, operand: borrowedOperand} = run bodyNode(&resolver.source, cursor, initializerValue) {
        let borrowContext = Option<Shared<Type>>.some(Shared<Type>.clone(&appliedMember))
        let checked = run checkBorrowOperand(&mut resolver.*, &mut owner.*, &mut request.*,
          &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, initializerValue, access, borrowedOperand,
          &borrowContext, RejectionCode.StructFieldTypeMismatch, false, false, loanOrdinal, loanBinder, constraints, contractBody, false, unsafeAllowed)
        let borrowed = match move checked {
          Result<CheckedBorrow, Shared<Rejection>>.Success {value} => move value
          Result<CheckedBorrow, Shared<Rejection>>.Failure {error} => {
            return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
          }
        }
        operand = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run bodyOrigin(&resolver.source, cursor, initializerValue),
          kind: BodyNodeKind.Expression {ty: move borrowed.ty,
            form: BodyExpression.Borrow {access: access, value: borrowed.value}},
        })
        checkedAggregateBorrow = true
      }
    }
  }
  if !checkedAggregateBorrow {
    let checked = run checkExpressionUnder(&mut resolver.*, &mut owner.*, &mut request.*,
      &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
      &mut signatures.*, &mut requiredBodies.*, initializerValue, &context, RejectionCode.StructFieldTypeMismatch,
      constraints, contractBody, staticBody, unsafeAllowed, nestedConstruction)
    operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
      }
    }
  }
  if inferredBorrowRegion {
    if !checkedAggregateBorrow {
      if let Node.BorrowExpression {..} = run bodyNode(&resolver.source, cursor, initializerValue) {
        run setBorrowRegion(&mut nodes.*, operand, caller, loanOrdinal, loanBinder)
      }
    }
  }
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    let actual = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, initializerValue)),
      ) }
    }
    let mut variables = List<Shared<DeclarationId>>.make()
    run List<Shared<DeclarationId>>.append(&mut variables, Shared<DeclarationId>.clone(&target.owner))
    let initializerSpan = run bodySpan(&resolver.source, cursor, initializerValue)
    let mut failed = run matchCallArgument(&resolver.*, module, initializerSpan, memberType, &actual,
      List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred.*, constraints, RejectionCode.StructFieldTypeMismatch)
    let mut mismatch = false
    if let Option<Shared<Rejection>>.Some {value} = &failed {
      mismatch = Shared<Rejection>.with<bool>(&value, fn(rejection: &Rejection) -> bool { return valueMismatchReason(rejection.code) })
    }
    // A field region meeting a binder that an earlier field fixed shortens the binder; a field whose
    // region is one constituent of the new meet reaches it by covariant subtyping (LIFE-002).
    if mismatch && run shortenedAggregateBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target.ty, memberType,
      &actual, List<Shared<DeclarationId>>.asSlice(&variables), List<BodyNode>.asSlice(&nodes.*), &mut inferred.*, initializerSpan) {
      failed = run matchCallArgument(&resolver.*, module, initializerSpan, memberType, &actual,
        List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred.*, constraints, RejectionCode.StructFieldTypeMismatch)
      let pending = match &failed { Option<Shared<Rejection>>.Some {..} => true Option<Shared<Rejection>>.None => false }
      if pending {
        let fresh = DeclarationId.copyShared(&target.owner)
        let explicit = List<usize>.make()
        let subtyped = run subtypedCallArgument(&mut resolver.*, &mut owner.*, &mut dependencies.*, memberType, &actual,
          &fresh, caller, List<Shared<DeclarationId>>.asSlice(&variables), List<Binding>.asSlice(&inferred.*),
          List<usize>.asSlice(&explicit), constraints, initializerSpan)
        if let Option<RelatedArgument>.Some {value: candidate} = move subtyped {
          let committed = run matchCallArgument(&resolver.*, module, initializerSpan, memberType, &candidate.ty,
            List<Shared<DeclarationId>>.asSlice(&variables), &mut inferred.*, constraints, RejectionCode.StructFieldTypeMismatch)
          if let Option<Shared<Rejection>>.None = move committed {
            if relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&candidate.relations)) {
              failed = Option<Shared<Rejection>>.none()
            }
          }
        }
      }
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move diagnostic)
    }
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(operand)
}

// An inferred aggregate lifetime binder that an earlier field fixed shortens to its `binderMeet`
// with a later field. The declaration must store the binder only covariantly (bootstrap
// NominalVariance), so every earlier field still meets the shorter region.
effect fn shortenedAggregateBinder(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  aggregate: &Shared<Type>, memberType: &Shared<Type>, actual: &Shared<Type>, variables: &[Shared<DeclarationId>],
  nodes: &[BodyNode], inferred: &mut List<Binding>, span: Span,
) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let shape = run Type.copy(aggregate)
  let mut nominal = Option<DeclarationId>.none()
  let mut arguments = List<Argument>.make()
  if let Type.Nominal {declaration: written, arguments: applied, ..} = move shape {
    nominal = Option<DeclarationId>.some(move written)
    arguments = move applied
  }
  let declaration = match move nominal {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return false }
  }
  let explicit = List<usize>.make()
  let count = List<Binding>.length(&inferred.*)
  let mut chosen = usize.MAX
  let mut shorter = Option<Shared<Lifetime>>.none()
  let mut at = usize.ZERO
  while at < count && chosen == usize.MAX {
    let bindings = List<Binding>.asSlice(&inferred.*)
    let ordinal = bindings[at].ordinal
    let region = run binderMeet(memberType, actual, variables, bindings, at, List<usize>.asSlice(&explicit))
    if let Option<Shared<Lifetime>>.Some {value: candidate} = move region {
      if run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, ordinal, span) {
        chosen = at
        // A lifetime parameter of the body adds nothing to a meet with one of its local regions:
        // it outlives every such region, so `meet('s, local)` is `local`. When no atom is lent by a
        // borrow of storage the body owns, such as `List<u32>.asSlice(&plan.values)` through
        // `plan: &'s Plan`, the literal takes that local region, and the boundary it reaches, such
        // as a return as `Context<'s>`, leaves its relation to 's to the region check (#2491). A
        // meet holding a loan of body storage keeps the parameter, so an expectation that fixes the
        // caller's region still rejects it at that boundary.
        if ownsBodyLoan(nodes, &candidate) {
          shorter = Option<Shared<Lifetime>>.some(move candidate)
        } else {
          let mut met = List<Shared<Lifetime>>.make()
          run List<Shared<Lifetime>>.append(&mut met, move candidate)
          let atoms = run withoutOutlivingParameters(List<Shared<Lifetime>>.asSlice(&met))
          shorter = Option<Shared<Lifetime>>.some(run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&atoms)))
        }
      }
    }
    at = at + usize.ONE
  }
  if let Option<Shared<Lifetime>>.Some {value} = move shorter {
    let replaced = List<Binding>.asMutSlice(&mut inferred.*)
    replaced[chosen].value = Argument.Lifetime {value: move value}
    return true
  }
  return false
}

// Whether some atom of `region` is lent by a direct borrow of storage the body owns (`ownedStorage`).
fn ownsBodyLoan(nodes: &[BodyNode], region: &Shared<Lifetime>) -> bool {
  let count = Lifetime.atomCount(region)
  let mut atom = usize.ZERO
  while atom < count {
    let wanted = Lifetime.atomAt(region, atom)
    let mut at = usize.ZERO
    while at < nodes.length {
      if let BodyNodeKind.Expression {ty, form: BodyExpression.Borrow {value: borrowed, ..}, ..} = &nodes[at].kind {
        if let Option<Shared<Lifetime>>.Some {value: loan} = move Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, operandRegion) {
          if Lifetime.equalsShared(&loan, &wanted) && ownedStorage(nodes, borrowed) { return true }
        }
      }
      at = at + usize.ONE
    }
    atom = atom + usize.ONE
  }
  return false
}

// Whether `region` is lent only by direct borrows of storage the body owns (`ownedStorage`). A call's
// argument borrows share one loan region, so every borrow typed with an atom of `region` must be such
// a borrow, and each atom must have one. A borrow of a parameter's place, such as `&src.u` through
// `src: &'s Src`, may live as long as its referent.
fn ownedLoanRegion(nodes: &[BodyNode], region: &Shared<Lifetime>) -> bool {
  let count = Lifetime.atomCount(region)
  let mut atom = usize.ZERO
  while atom < count {
    let wanted = Lifetime.atomAt(region, atom)
    let mut found = false
    let mut at = usize.ZERO
    while at < nodes.length {
      if let BodyNodeKind.Expression {ty, form: BodyExpression.Borrow {value: borrowed, ..}, ..} = &nodes[at].kind {
        if let Option<Shared<Lifetime>>.Some {value: loan} = move Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, operandRegion) {
          if Lifetime.equalsShared(&loan, &wanted) {
            if !ownedStorage(nodes, borrowed) { return false }
            found = true
          }
        }
      }
      at = at + usize.ONE
    }
    if !found { return false }
    atom = atom + usize.ONE
  }
  return true
}

// Whether a borrowed place is storage the body owns: it is reached through no reference or slice,
// and is not itself a reference or slice, whose loan the bootstrap ties to its referent's region.
// A by-value `T` is owned even when T is instantiated with a reference: the loan is of its slot.
fn ownedStorage(nodes: &[BodyNode], place: BodyNodeId) -> bool {
  if let Option<Shared<Lifetime>>.Some {..} = move borrowedPlaceRegion(nodes, place) { return false }
  if let BodyNodeKind.Expression {ty, ..} = &nodes[place.index].kind {
    if let Option<Shared<Lifetime>>.Some {..} = move Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, operandRegion) { return false }
    return true
  }
  return false
}

// The same complete nominal application and bound proof completes structs and union payloads.
effect fn completeAggregateInference(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, recordType: &Shared<Type>,
  inference: &Option<InferredAggregateTarget>, inferred: &[Binding], nodes: &[BodyNode],
  operands: &[BodyAggregateField], constraints: &[Constraint], span: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut completed = Shared<Type>.clone(recordType)
  if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
    completed = run Type.applyBindings(recordType, inferred, true)
    let targetOwner = Shared<DeclarationId>.clone(&target.owner)
    let ownerId = DeclarationId.copyShared(&targetOwner)
    let declaredModule = resolvedModule(&resolver.*, target.module)
    let bounded = run declaresBounds(&mut resolver.*, &declaredModule, target.declaration)
    let anchors = run genericAnchors(&mut resolver.*, &declaredModule, target.declaration, target.generics)
    let written = List<Span>.asSlice(&anchors.binders)
    if run typeMentionsOwner(&completed, &ownerId) {
      // A lifetime the fields leave open, such as the environment of a bound `F: fn<'env>(i32) -> i32`
      // or its omitted form, retains the region a borrowed operand holds, else 'static, as a call's
      // environment-only binder does. A written binder and its elided form relate the same regions
      // (LIFE-003), and only type and row binders stay uninferred (GEN-007); the applied bounds
      // below still prove the result.
      let mut closed = run copyBindings(inferred)
      let mut operandNodes = List<BodyNodeId>.make()
      let mut operandAt = usize.ZERO
      while operandAt < operands.length {
        run List<BodyNodeId>.append(&mut operandNodes, operands[operandAt].value)
        operandAt = operandAt + usize.ONE
      }
      let count = Shared<Type>.with<usize>(&completed, applicationLength)
      let mut argumentAt = usize.ZERO
      while argumentAt < count {
        let argument = Shared<Type>.with<Option<Argument>>(&completed,
          fn(value: &Type) -> Option<Argument> { return applicationArgument(value, argumentAt) })
        if let Option<Argument>.Some {value: Argument.Lifetime {value: region}} = move argument {
          let ordinal = ownedLifetimeOrdinal(&region, &ownerId)
          if ordinal != usize.MAX {
            let retained = match move capturedRegion(nodes, List<BodyNodeId>.asSlice(&operandNodes)) {
              Option<Shared<Lifetime>>.Some {value} => move value
              Option<Shared<Lifetime>>.None => run Shared<Lifetime>.make(Lifetime.Static)
            }
            run List<Binding>.append(&mut closed, Binding {declaration: Shared<DeclarationId>.clone(&targetOwner),
              ordinal: ordinal, value: Argument.Lifetime {value: move retained}})
          }
        }
        argumentAt = argumentAt + usize.ONE
      }
      completed = run Type.applyBindings(recordType, List<Binding>.asSlice(&closed), true)
    }
    if run typeMentionsOwner(&completed, &ownerId) {
      let count = Shared<Type>.with<usize>(&completed, applicationLength)
      let mut at = usize.ZERO
      while at < count && at < written.length {
        let argument = Shared<Type>.with<Option<Argument>>(&completed,
          fn(value: &Type) -> Option<Argument> { return applicationArgument(value, at) })
        if let Option<Argument>.Some {value} = move argument {
          if run argumentMentionsOwner(&value, &ownerId) {
            return Result<Shared<Type>, Shared<Rejection>>.failResult(
              run reject(&resolver.*, &declaredModule, RejectionCode.UninferredParameter, written[at]),
            )
          }
        }
        at = at + usize.ONE
      }
      return Result<Shared<Type>, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.TypeArgumentInference, span),
      )
    }
    if bounded {
      let arguments = run typeApplicationArguments(&completed)
      let resolvedBounds = run appliedDeclarationBounds(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        target.module,
        target.declaration,
        target.generics,
        List<Binder>.asSlice(&target.binders),
        List<Argument>.asSlice(&arguments),
        span,
        target.isPublic,
      )
      let bounds = match move resolvedBounds {
        Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
        Result<List<Constraint>, Shared<Rejection>>.Failure {error} => {
          return Result<Shared<Type>, Shared<Rejection>>.failResult(move error)
        }
      }
      let assumptions = run copyConstraints(constraints)
      let failure = run proveAppliedBounds(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &assumptions,
        List<Constraint>.asSlice(&bounds),
        module,
        span,
        RegionProof.Typing,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result<Shared<Type>, Shared<Rejection>>.failResult(move diagnostic)
      }
    }
  }
  // A value of the completed type is where its declaration's region bounds start to hold: every
  // body that reads it assumes them (`appendStoredFieldPremises`, IMPL-007's implied set), so its
  // construction owes them (LIFE-002). The region check holds them between the construction's regions
  // (`constructionShapes`).
  return Result<Shared<Type>, Shared<Rejection>>.succeed(move completed)
}

// Field authority, completeness and written evaluation order of a record literal (STRUCT-002).
// A bare generic owner is inferred transactionally from its checked operands; `.{ ... }` reaches
// this path only through an immediate complete struct expectation.
effect fn checkRecordFields<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  recordType: &Shared<Type>, inference: &Option<InferredAggregateTarget>, fields: Range, expression: HirId,
  constraints: &[Constraint], contractBody: bool, staticBody: bool,
  unsafeAllowed: bool, span: Span,
) -> Result<CheckedRecordFields, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let counted = run recordFieldCount(&mut resolver.*, module, recordType, span)
  let count = match move counted {
    Result<usize, Shared<Rejection>>.Success {value} => value
    Result<usize, Shared<Rejection>>.Failure {error} => {
      return Result<CheckedRecordFields, Shared<Rejection>>.failResult(move error)
    }
  }
  // STRUCT-002: outside the declaring module, a struct with a private field has no source
  // constructor; the literal is rejected without naming the hidden field.
  if !run recordFieldsVisible(&mut resolver.*, module, recordType) {
    return Result<CheckedRecordFields, Shared<Rejection>>.failResult(
      run inaccessibleConstructionRejection(module, span, recordType, b""))
  }
  let mut inferred = List<Binding>.make()
  let mut operands = List<BodyAggregateField>.make()
  let mut at = usize.ZERO
  while at < fields.length {
    let initializer = run bodyChild(&resolver.source, cursor, fields, at)
    let syntax = run bodyNode(&resolver.source, cursor, initializer)
    let mut name = HirId {index: usize.ZERO}
    let mut initializerValue = HirId {index: usize.ZERO}
    if let Node.FieldInitializer {name: fieldNameId, value: fieldValueId} = syntax {
      name = fieldNameId
      initializerValue = fieldValueId
    } else {
      return Result<CheckedRecordFields, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    let fieldName = match run bodyNode(&resolver.source, cursor, name) {
      Node.Name {text} => run bodyText(&resolver.source, cursor, text)
      _ => { return Result<CheckedRecordFields, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.UnknownStructField, span),
      ) }
    }
    let fieldSpan = run bodySpan(&resolver.source, cursor, name)
    let selected = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, recordType, Bytes.asSlice(&fieldName), fieldSpan, FieldLookupPurpose.NamedFields)
    let member = match move selected {
      Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => move value
      Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => {
        return Result<CheckedRecordFields, Shared<Rejection>>.failResult(move error)
      }
    }
    let known = List<BodyAggregateField>.asSlice(&operands)
    let mut prior = usize.ZERO
    while prior < known.length {
      if known[prior].index == member.index {
        return Result<CheckedRecordFields, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.DuplicateStructInitializer, run bodySpan(&resolver.source, cursor, name)),
        )
      }
      prior = prior + usize.ONE
    }
    let mut construction = Option<Shared<Type>>.none()
    if let Option<InferredAggregateTarget>.Some {value: target} = &inference.* {
      if let Option<Shared<Type>>.Some {value: blueprint} = &target.construction {
        let original = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*,
          module, &blueprint, Bytes.asSlice(&fieldName), fieldSpan, FieldLookupPurpose.NamedFields)
        match move original {
          Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => { construction = Option<Shared<Type>>.some(move value.ty) }
          Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => { return Result<CheckedRecordFields, Shared<Rejection>>.failResult(move error) }
        }
      }
    }
    let checked = run checkAggregateInitializer(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      &member.ty, inference, &construction, &mut inferred, initializerValue, run anchoredNode(cursor, expression),
      constraints, contractBody, staticBody, unsafeAllowed,
    )
    let operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result<CheckedRecordFields, Shared<Rejection>>.failResult(run namedFieldRejection(move error, Bytes.asSlice(&fieldName)))
      }
    }
    run List<BodyAggregateField>.append(&mut operands,
      BodyAggregateField {index: member.index, value: operand})
    at = at + usize.ONE
  }
  if count != fields.length {
    let names = run recordFieldNames(&mut resolver.*, recordType)
    return Result<CheckedRecordFields, Shared<Rejection>>.failResult(run missingFieldsRejection(module, span,
      List<Bytes>.asSlice(&names), List<BodyAggregateField>.asSlice(&operands)))
  }
  let completed = match move run completeAggregateInference(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, recordType, inference,
    List<Binding>.asSlice(&inferred), List<BodyNode>.asSlice(&nodes.*), List<BodyAggregateField>.asSlice(&operands),
    constraints, span,
  ) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<CheckedRecordFields, Shared<Rejection>>.failResult(move error)
    }
  }
  return Result<CheckedRecordFields, Shared<Rejection>>.succeed(
    CheckedRecordFields {ty: move completed, fields: move operands},
  )
}

// A contextual aggregate literal constructs its expectation only when that is exactly a named
// declaration of the literal's kind (TUPLE-002, RECORD-001); otherwise it is anonymous.
fn namedAggregateExpectation(expected: &Option<Shared<Type>>, kind: OwnerKind) -> Option<Shared<Type>> {
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if Shared<Type>.with<OwnerKind>(&value, nominalKind) == kind { return Option<Shared<Type>>.some(Shared<Type>.clone(&value)) }
  }
  return Option<Shared<Type>>.none()
}

// An uncontextualized tuple or record literal finalizes one occurrence-nominal type (RECORD-002).
// Members are checked without context in written order; the literal's syntax names the type.
effect fn checkAnonymousAggregate<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, children: Range, positional: bool, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    let kind = Shared<Type>.with<OwnerKind>(&value, nominalKind)
    if (positional && kind == OwnerKind.Struct) || (!positional && kind == OwnerKind.Tuple) {
      return run bodyRejection(&resolver.*, module, RejectionCode.ContextualAggregateKindMismatch, span)
    }
  }
  let mut labels = List<Bytes>.make()
  let mut members = List<Shared<Type>>.make()
  let mut operands = List<BodyAggregateField>.make()
  let mut at = usize.ZERO
  while at < children.length {
    let mut value = run bodyChild(&resolver.source, cursor, children, at)
    if !positional {
      let mut name = HirId {index: usize.ZERO}
      if let Node.FieldInitializer {name: fieldNameId, value: fieldValueId} = run bodyNode(&resolver.source, cursor, value) {
        name = fieldNameId
        value = fieldValueId
      } else {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let label = match run bodyNode(&resolver.source, cursor, name) {
        Node.Name {text} => run bodyText(&resolver.source, cursor, text)
        _ => { return CompilerBug.panic(b"MissingRetainedFact: checkAnonymousAggregate") }
      }
      let known = List<Bytes>.asSlice(&labels)
      let mut prior = usize.ZERO
      while prior < known.length {
        if same(Bytes.asSlice(&known[prior]), Bytes.asSlice(&label)) {
          return run bodyRejection(&resolver.*, module, RejectionCode.DuplicateFieldName, run bodySpan(&resolver.source, cursor, name))
        }
        prior = prior + usize.ONE
      }
      run List<Bytes>.append(&mut labels, move label)
    }
    let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      value, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
    let operand = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: checkedValue} => checkedValue
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    let member = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &operand) {
      Option<Shared<Type>>.Some {value: memberType} => move memberType
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, cursor, value)) }
    }
    run List<Shared<Type>>.append(&mut members, move member)
    run List<BodyAggregateField>.append(&mut operands, BodyAggregateField {index: at, value: operand})
    at = at + usize.ONE
  }
  let generator = DeclarationId.copy(caller)
  // The literal is named relative to its declaration's anchor, so an edit to another declaration
  // of the module, which renumbers the module's syntax, keeps the type it generates.
  let relative = Anchor.node(&run cursorAnchor(cursor), expression)
  let occurrence = run Shared<AnonymousOccurrence>.make(AnonymousOccurrence {
    declaration: run Shared<DeclarationId>.make(move generator),
    syntax: relative, positional: positional, labels: move labels,
  })
  let ty = run Types.intern(Type.Anonymous {occurrence: move occurrence, members: move members})
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Aggregate {fields: move operands, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

// A literal's declaration comes from the syntax-only abstract-body walk, never from body checking.
effect fn literalOrdinal(resolver: &mut Resolver, module: &ModuleId, expression: HirId) -> Option<usize>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedSyntax(&mut resolver.*, module, expression)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    return ModuleIndex.ordinalAtLocal(IndexedSource.moduleIndex(indexed), expression)
  }
  return Option<usize>.none()
}

effect fn lexicalLocals(locals: &[BodyLocal]) -> List<BodyLocal> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<BodyLocal>.make()
  let mut at = usize.ZERO
  while at < locals.length {
    run List<BodyLocal>.append(&mut copied, BodyLocal {origin: locals[at].origin, ty: Shared<Type>.clone(&locals[at].ty), mutable: locals[at].mutable,
      meetDepth: Option<usize>.none(), written: locals[at].written})
    at = at + usize.ONE
  }
  return move copied
}

effect fn localCopyFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>, locals: &[BodyLocal], count: usize, constraints: &[Constraint], anchor: &Anchor) -> Result<List<bool>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut copies = List<bool>.make()
  let mut at = usize.ZERO
  while at < count {
    let selected = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &locals[at].ty, constraints, BodyOrigin.span(locals[at].origin, anchor))
    match move selected {
      Result<bool, Shared<Rejection>>.Success {value} => run List<bool>.append(&mut copies, value && !Type.containsViewBorrow(&locals[at].ty))
      Result<bool, Shared<Rejection>>.Failure {error} => { return Result<List<bool>, Shared<Rejection>>.failResult(move error) }
    }
    at = at + usize.ONE
  }
  return Result<List<bool>, Shared<Rejection>>.succeed(move copies)
}

effect fn expressionCopyFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>, nodes: &[BodyNode], constraints: &[Constraint], anchor: &Anchor) -> Result<List<bool>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut copies = List<bool>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    let mut copied = false
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let selected = run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, BodyOrigin.span(nodes[at].origin, anchor))
      match move selected {
        Result<bool, Shared<Rejection>>.Success {value} => { copied = value }
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<List<bool>, Shared<Rejection>>.failResult(move error) }
      }
    }
    run List<bool>.append(&mut copies, copied)
    at = at + usize.ONE
  }
  return Result<List<bool>, Shared<Rejection>>.succeed(move copies)
}

effect fn anonymousInvocationSlots(signature: &Shared<Result<Answer, NoRejection>>, identity: &DeclarationId) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected { run Type.collectOwned(&value, identity, &mut types, &mut lifetimes, &mut rows) }
    at = at + usize.ONE
  }
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature, signatureResult)
  if let Option<Shared<Type>>.Some {value} = move result { run Type.collectOwned(&value, identity, &mut types, &mut lifetimes, &mut rows) }
  let bounds = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value} = move selected {
      run collectConstraint(&value, identity, &mut types, &mut lifetimes, &mut rows)
    }
    at = at + usize.ONE
  }
  return move lifetimes
}

// `delayed` is the run access of the Effect an anonymous `effect fn` constructs when invoked.
effect fn anonymousUseContract(signature: &Shared<Result<Answer, NoRejection>>, identity: &DeclarationId, mode: CallableMode,
  regions: &[Shared<Lifetime>], delayed: Option<CallableMode>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut parameters = List<Shared<Type>>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected { run List<Shared<Type>>.append(&mut parameters, move value) }
    at = at + usize.ONE
  }
  let mut result = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => absurd<Shared<Type>>()
  }
  // Invocation representation slots implement authored raw contracts, not capture fields.
  let firstRepresentation = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureCallableParameterStart)
  let countBounds = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut representations = List<Binding>.make()
  at = usize.ZERO
  while at < countBounds {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter, contract}} = move bound {
      let slot = Shared<Type>.with<usize>(&parameter, fn(value: &Type) -> usize { return Type.parameterOrdinalOf(value, identity) })
      if slot != usize.MAX && slot >= firstRepresentation {
        run List<Binding>.append(&mut representations, Binding {
          declaration: run Shared<DeclarationId>.make(DeclarationId.copy(identity)), ordinal: slot,
          value: Argument.Type {value: move contract}})
      }
    }
    at = at + usize.ONE
  }
  let original = List<Shared<Type>>.asSlice(&parameters)
  let mut authored = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < original.length {
    run List<Shared<Type>>.append(&mut authored, run Type.applyBindings(&original[at], List<Binding>.asSlice(&representations), true))
    at = at + usize.ONE
  }
  parameters = move authored
  result = run Type.applyBindings(&result, List<Binding>.asSlice(&representations), true)
  let lifetimes = run anonymousInvocationSlots(signature, identity)
  let declared = List<Shared<Type>>.asSlice(&parameters)
  let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut bounds = List<Outlives>.make()
  at = usize.ZERO
  while at < boundCount {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraint(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Outlives {longer, shorter}} = move selected {
      run List<Outlives>.append(&mut bounds, Outlives {longer: move longer, shorter: move shorter})
    }
    at = at + usize.ONE
  }
  let slots = List<usize>.asSlice(&lifetimes)
  let mut bindings = List<Binding>.make()
  at = usize.ZERO
  while at < slots.length {
    run List<Binding>.append(&mut bindings, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(identity)),
      ordinal: slots[at], value: Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: at})}})
    at = at + usize.ONE
  }
  let assigned = List<Binding>.asSlice(&bindings)
  let mut quantified = List<Shared<Type>>.make()
  at = usize.ZERO
  while at < declared.length {
    run List<Shared<Type>>.append(&mut quantified, run Type.applyBindings(&declared[at], assigned, true))
    at = at + usize.ONE
  }
  let originalBounds = List<Outlives>.asSlice(&bounds)
  let mut quantifiedBounds = List<Outlives>.make()
  at = usize.ZERO
  while at < originalBounds.length {
    run List<Outlives>.append(&mut quantifiedBounds, Outlives {
      longer: run Type.applyLifetimeBindings(&originalBounds[at].longer, assigned),
      shorter: run Type.applyLifetimeBindings(&originalBounds[at].shorter, assigned),
    })
    at = at + usize.ONE
  }
  let returned = run Type.applyBindings(&result, assigned, true)
  let mut produced = Shared<Type>.clone(&returned)
  if let Option<CallableMode>.Some {value: runMode} = move delayed {
    // The constructed Effect retains the closure's environment and every region its stored
    // arguments retain (LIFE-004).
    let mut retained = run copyRegions(regions)
    let none = List<Option<Shared<Type>>>.make()
    let mut parameterAt = usize.ZERO
    while parameterAt < List<Shared<Type>>.length(&quantified) {
      let stored = List<Shared<Type>>.asSlice(&quantified)
      drop run Type.retainedRegions(&stored[parameterAt], identity, List<Option<Shared<Type>>>.asSlice(&none), &mut retained, false)
      parameterAt = parameterAt + usize.ONE
    }
    let declaredFailure = run signatureFailure(signature)
    let declaredRequirements = run signatureRequirements(signature)
    produced = run Types.intern(Type.Effect {mode: runMode,
      environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&retained))),
      success: move returned, failure: run Type.applyBindings(&declaredFailure, assigned, true),
      requirements: run Row.applyBindings(&declaredRequirements, assigned, true)})
  }
  return run Types.intern(Type.Callable {mode: mode,
    isUnsafe: Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureUnsafe),
    environment: run Shared<Intersection>.make(run Intersection.of(regions)),
    invocationBinders: slots.length, invocationUse: usize.MAX, invocationBounds: move quantifiedBounds, parameters: move quantified, result: move produced})
}


effect fn copyRegions(regions: &[Shared<Lifetime>]) -> List<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < regions.length {
    run List<Shared<Lifetime>>.append(&mut copied, Shared<Lifetime>.clone(&regions[at]))
    at = at + usize.ONE
  }
  return move copied
}

// What a callee can keep of each argument under one call's bindings, for borrow checking. A
// callable parameter's representation is kept as its use contract, which is all the callee can
// store it as. A callee that is not `describable`, an interface operation or operator, stores
// through its provider's conformance; so can one whose parameter types name a lifetime of an
// enclosing declaration whose bounds its signature does not carry. A requirement row reaches only
// services the caller provides, which can hold only what their own regions name.
effect fn keptArguments(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, bindings: &[Binding], arguments: usize, describable: bool, caller: &DeclarationId, span: Span)
-> Shared<List<KeptRegions>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run signatureParameterTypes(signature)
  let contracts = run representedContracts(signature)
  let mut declared = List<Shared<Type>>.make()
  let listed = List<Shared<Type>>.asSlice(&written)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Shared<Type>>.append(&mut declared, run Type.applyBindings(&listed[at], List<Binding>.asSlice(&contracts), true))
    at = at + usize.ONE
  }
  let own = run signatureLifetimeList(signature)
  let conforming = !describable || run Type.namesForeignLifetime(List<Shared<Type>>.asSlice(&declared), List<Shared<Lifetime>>.asSlice(&own), caller)
  // Covariance is read for the nominals the parameters name and those their instantiations name.
  let mut variant = List<Shared<Type>>.make()
  let typed = List<Shared<Type>>.asSlice(&declared)
  at = usize.ZERO
  while at < typed.length {
    run List<Shared<Type>>.append(&mut variant, Shared<Type>.clone(&typed[at]))
    run List<Shared<Type>>.append(&mut variant, run Type.applyBindings(&typed[at], bindings, true))
    at = at + usize.ONE
  }
  let covariant = run covariantSlots(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<Shared<Type>>.asSlice(&variant), span)
  // The requirement rows of the Effects the result is or holds, in its types or its members.
  let mut rows = List<Shared<Row>>.make()
  let mut reached = List<Shared<Type>>.make()
  let result = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature, signatureResult)
  if let Option<Shared<Type>>.Some {value: returned} = &result {
    run heldEffectRequirements(&returned, &mut rows)
    let mut walked = List<usize>.make()
    let mut active = List<Shared<Type>>.make()
    run memberEffectRequirements(&mut resolver.*, &mut owner.*, &mut dependencies.*, &returned, &mut rows, &mut reached, &mut walked, &mut active, span)
  }
  let premises = run calleeKeptBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, List<Shared<Type>>.asSlice(&declared), span)
  let mut places = List<List<KeptPlace>>.make()
  at = usize.ZERO
  while at < typed.length {
    run List<List<KeptPlace>>.append(&mut places, run keptPlaces(&mut resolver.*, &mut owner.*, &mut dependencies.*, &typed[at], span))
    at = at + usize.ONE
  }
  let mut kept = run describedKept(signature, List<Shared<Type>>.asSlice(&declared), bindings, conforming, List<Shared<Lifetime>>.asSlice(&own),
    List<CovariantSlot>.asSlice(&covariant), List<Shared<Row>>.asSlice(&rows), List<Shared<Type>>.asSlice(&reached),
    List<KeptBound>.asSlice(&premises), List<List<KeptPlace>>.asSlice(&places))
  // A call's operands are its runtime arguments: a static parameter's argument is evaluated during
  // static evaluation and has no operand. Any other mismatch records nothing.
  let recordedCount = List<KeptRegions>.length(&kept)
  if arguments != recordedCount {
    let slots = run signatureStaticSlotList(signature)
    let statics = List<usize>.asSlice(&slots)
    if statics.length == usize.ZERO || recordedCount < statics.length || arguments != recordedCount - statics.length {
      return run Shared<List<KeptRegions>>.make(List<KeptRegions>.make())
    }
    let mut runtime = List<KeptRegions>.make()
    let entries = List<KeptRegions>.asSlice(&kept)
    at = usize.ZERO
    while at < entries.length {
      if !isStaticIndex(statics, at) {
        run List<KeptRegions>.append(&mut runtime, KeptRegions {outer: run copyRegions(List<Shared<Lifetime>>.asSlice(&entries[at].outer)),
          whole: run copyRegions(List<Shared<Lifetime>>.asSlice(&entries[at].whole)),
          outerApproximate: run copyRegions(List<Shared<Lifetime>>.asSlice(&entries[at].outerApproximate)),
          wholeApproximate: run copyRegions(List<Shared<Lifetime>>.asSlice(&entries[at].wholeApproximate)), undescribed: entries[at].undescribed,
          slots: run copyKeptSlots(List<KeptSlot>.asSlice(&entries[at].slots))})
      }
      at = at + usize.ONE
    }
    kept = move runtime
  }
  return run Shared<List<KeptRegions>>.make(move kept)
}

// The binders of the structs, tuples, unions and enums `declared` names that occur only covariantly
// in their fields (bootstrap NominalVariance).
effect fn covariantSlots(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  declared: &[Shared<Type>], span: Span) -> List<CovariantSlot>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut nominals = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < declared.length {
    run Type.nominalOccurrences(&declared[at], &mut nominals)
    at = at + usize.ONE
  }
  let mut slots = List<CovariantSlot>.make()
  let found = List<Shared<Type>>.asSlice(&nominals)
  at = usize.ZERO
  while at < found.length {
    let named = Shared<Type>.with<Option<DeclarationId>>(&found[at], nominalOf)
    if let Option<DeclarationId>.Some {value: declaration} = move named {
      let count = Shared<Type>.with<usize>(&found[at], nominalArity)
      let mut arguments = List<Argument>.make()
      let mut item = usize.ZERO
      while item < count {
        let argument = Shared<Type>.with<Option<Argument>>(&found[at], fn(node: &Type) -> Option<Argument> { return nominalArgument(node, item) })
        if let Option<Argument>.Some {value} = move argument { run List<Argument>.append(&mut arguments, move value) }
        item = item + usize.ONE
      }
      let mut ordinal = usize.ZERO
      while ordinal < List<Argument>.length(&arguments) {
        let listed = List<CovariantSlot>.asSlice(&slots)
        let mut known = false
        let mut each = usize.ZERO
        while each < listed.length {
          if listed[each].ordinal == ordinal && DeclarationId.equals(&listed[each].declaration, &declaration) { known = true }
          each = each + usize.ONE
        }
        if !known {
          if run covariantParameter(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declaration, ordinal, span) {
            run List<CovariantSlot>.append(&mut slots, CovariantSlot {declaration: DeclarationId.copy(&declaration), ordinal: ordinal})
          }
        }
        ordinal = ordinal + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move slots
}

fn nominalOf(value: &Type) -> Option<DeclarationId> {
  if let Type.Nominal {declaration, ..} = &value.* { return Option<DeclarationId>.some(DeclarationId.copy(&declaration)) }
  return Option<DeclarationId>.none()
}

fn nominalArity(value: &Type) -> usize {
  if let Type.Nominal {arguments, ..} = &value.* { return List<Argument>.length(&arguments) }
  return usize.ZERO
}

fn nominalArgument(value: &Type, at: usize) -> Option<Argument> {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = List<Argument>.asSlice(&arguments)
    if at < listed.length { return Option<Argument>.some(Argument.copy(&listed[at])) }
  }
  return Option<Argument>.none()
}

// The lifetime parameters a signature declares.
effect fn signatureLifetimeList(signature: &Shared<Result<Answer, NoRejection>>) -> List<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  let mut own = List<Shared<Lifetime>>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureLifetimeCount)
  let mut at = usize.ZERO
  while at < count {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureLifetimeAt(answer, at) })
    if let Option<Shared<Lifetime>>.Some {value} = move found { run List<Shared<Lifetime>>.append(&mut own, move value) }
    at = at + usize.ONE
  }
  return move own
}

// What a callee keeps of each argument, from its `declared` parameter types, constraints,
// environment and requirements; a `conforming` one also through what its signature does not carry.
effect fn describedKept(signature: &Shared<Result<Answer, NoRejection>>, declared: &[Shared<Type>], bindings: &[Binding],
  conforming: bool, own: &[Shared<Lifetime>], covariant: &[CovariantSlot], rows: &[Shared<Row>], reached: &[Shared<Type>],
  premises: &[KeptBound], places: &[List<KeptPlace>])
-> List<KeptRegions> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut bounds = List<KeptBound>.make()
  let mut at = usize.ZERO
  while at < premises.length {
    run List<KeptBound>.append(&mut bounds, KeptBound.copy(&premises[at]))
    at = at + usize.ONE
  }
  // A required service is reached exclusively or shared like a parameter, so the callee can store
  // wherever its capability reaches.
  let requirements = run signatureRequirements(signature)
  let entries = Shared<Row>.with<usize>(&requirements, fn(row: &Row) -> usize { return List<Requirement>.length(&row.entries) })
  at = usize.ZERO
  while at < entries {
    let capability = Shared<Row>.with<Shared<Type>>(&requirements, fn(row: &Row) -> Shared<Type> {
      let listed = List<Requirement>.asSlice(&row.entries)
      return Shared<Type>.clone(&listed[at].capability)
    })
    run List<KeptBound>.append(&mut bounds, KeptBound.Reaching {value: move capability})
    at = at + usize.ONE
  }
  // A returned Effect, or one the result holds, carries what it holds until it runs, and its run
  // reaches every service its requirement row names, so the callee can store an argument wherever
  // that row reaches.
  let mut row = usize.ZERO
  while row < rows.length {
    let returned = Shared<Row>.clone(&rows[row])
    let listed = Shared<Row>.with<usize>(&returned, fn(entries: &Row) -> usize { return List<Requirement>.length(&entries.entries) })
    at = usize.ZERO
    while at < listed {
      let capability = Shared<Row>.with<Shared<Type>>(&returned, fn(entries: &Row) -> Shared<Type> {
        let listedEntries = List<Requirement>.asSlice(&entries.entries)
        return Shared<Type>.clone(&listedEntries[at].capability)
      })
      run List<KeptBound>.append(&mut bounds, KeptBound.Reaching {value: move capability})
      at = at + usize.ONE
    }
    row = row + usize.ONE
  }
  // A member walk cut short at a growing application reaches the arguments that changed.
  at = usize.ZERO
  while at < reached.length {
    run List<KeptBound>.append(&mut bounds, KeptBound.Reaching {value: Shared<Type>.clone(&reached[at])})
    at = at + usize.ONE
  }
  let outliving = List<Shared<Lifetime>>.make()
  return run Type.keptRegions(declared, List<KeptBound>.asSlice(&bounds), bindings, conforming, own, covariant, places,
    List<Shared<Lifetime>>.asSlice(&outliving))
}

// The bounds a callee is checked under, as kept bounds: its signature's (`keptBounds`), those its
// parameter and result types imply by being well formed, including their stored members', which a
// call owes it and its body assumes (`signatureImpliedBounds`), and an Effect's environment, which
// outlives nothing its inputs retain (LIFE-004): every `declared` input outlives it.
effect fn calleeKeptBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  signature: &Shared<Result<Answer, NoRejection>>, declared: &[Shared<Type>], span: Span) -> List<KeptBound>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut bounds = run keptBounds(signature)
  let environmentCount = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureEnvironmentCount)
  let mut members = List<Shared<Lifetime>>.make()
  let mut at = usize.ZERO
  while at < environmentCount {
    let member = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Lifetime>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> { return signatureEnvironmentAt(answer, at) })
    if let Option<Shared<Lifetime>>.Some {value: region} = move member { run List<Shared<Lifetime>>.append(&mut members, move region) }
    at = at + usize.ONE
  }
  // The environment is the meet of its members: an input outlives it, not each member.
  if List<Shared<Lifetime>>.length(&members) != usize.ZERO {
    let environment = run Lifetime.meet(List<Shared<Lifetime>>.asSlice(&members))
    let mut each = usize.ZERO
    while each < declared.length {
      run List<KeptBound>.append(&mut bounds, KeptBound.Contents {subject: Shared<Type>.clone(&declared[each]), region: Shared<Lifetime>.clone(&environment)})
      each = each + usize.ONE
    }
  }
  let implied = run signatureImpliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature, false, span)
  let listed = List<Constraint>.asSlice(&implied)
  at = usize.ZERO
  while at < listed.length {
    match &listed[at] {
      Constraint.Outlives {longer, shorter} => run List<KeptBound>.append(&mut bounds,
        KeptBound.Outlives {longer: Shared<Lifetime>.clone(&longer), shorter: Shared<Lifetime>.clone(&shorter)})
      Constraint.Contents {subject, region} => run List<KeptBound>.append(&mut bounds,
        KeptBound.Contents {subject: Shared<Type>.clone(&subject), region: Shared<Lifetime>.clone(&region)})
      _ => ()
    }
    at = at + usize.ONE
  }
  return move bounds
}

// Where a loan an argument of `value`'s type carries can lie (`KeptPlace`): its own structure's
// views (`Type.keptStructure`), and those of every stored member of the nominals it holds. A nominal
// whose members are not read here, sealed or past the walk's bound, is opaque storage.
effect fn keptPlaces(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  value: &Shared<Type>, span: Span) -> List<KeptPlace>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut places = List<KeptPlace>.make()
  let mut pending = List<KeptNominal>.make()
  let empty = List<KeptStep>.make()
  run Type.keptStructure(value, List<KeptStep>.asSlice(&empty), &mut places, &mut pending)
  let mut expanded = List<KeptNominal>.make()
  while List<KeptNominal>.length(&pending) > usize.ZERO {
    let last = List<KeptNominal>.length(&pending) - usize.ONE
    let nested = List<KeptNominal>.remove(&mut pending, last)
    let current = move nested.value
    let path = move nested.path
    let seen = List<KeptNominal>.asSlice(&expanded)
    let mut repeated = false
    let mut at = usize.ZERO
    while !repeated && at < seen.length {
      repeated = Type.keptPathContains(List<KeptStep>.asSlice(&seen[at].path), List<KeptStep>.asSlice(&path))
        && run Type.equalsShared(&seen[at].value, &current)
      at = at + usize.ONE
    }
    // The walk reads at most 64 nominal applications of one argument; the rest are opaque.
    let mut readable = declaringModuleOrdinal(&resolver.*, &current) != usize.MAX && !repeated && seen.length < 64
    let named = Shared<Type>.with<Option<DeclarationId>>(&current, fn(node: &Type) -> Option<DeclarationId> {
      if let Type.Nominal {declaration, ..} = &node.* { return Option<DeclarationId>.some(DeclarationId.copy(&declaration)) }
      return Option<DeclarationId>.none()
    })
    if let Option<DeclarationId>.Some {value: identity} = &named {
      if ModuleId.withOrigin<bool>(DeclarationId.moduleId(&identity), sealedOrigin) { readable = false }
    }
    let mut members = List<Shared<Type>>.make()
    if readable { members = run storedMemberTypes(&mut resolver.*, &mut owner.*, &mut dependencies.*, &current, span) }
    // A nominal that names a region or type parameter but shows no stored member is not read here.
    if List<Shared<Type>>.length(&members) == usize.ZERO {
      let mut atoms = List<Shared<Lifetime>>.make()
      run Type.regionAtoms(&current, &mut atoms)
      if List<Shared<Lifetime>>.length(&atoms) != usize.ZERO || run Type.namesTypeParameter(&current) {
        run List<KeptPlace>.append(&mut places, KeptPlace.Opaque {value: Shared<Type>.clone(&current), path: run Type.copyKeptPath(List<KeptStep>.asSlice(&path))})
      }
      continue
    }
    run List<KeptNominal>.append(&mut expanded, KeptNominal {value: Shared<Type>.clone(&current), path: run Type.copyKeptPath(List<KeptStep>.asSlice(&path))})
    let mut kind = KeptStepKind.Unknown
    if let Option<DeclarationId>.Some {value: identity} = &named {
      if DeclarationId.kind(&identity) == OwnerKind.Struct || DeclarationId.kind(&identity) == OwnerKind.Tuple { kind = KeptStepKind.Field }
    }
    let stored = List<Shared<Type>>.asSlice(&members)
    at = usize.ZERO
    while at < stored.length {
      let field = run Type.extendKeptPath(List<KeptStep>.asSlice(&path), kind, at)
      run Type.keptStructure(&stored[at], List<KeptStep>.asSlice(&field), &mut places, &mut pending)
      at = at + usize.ONE
    }
  }
  return move places
}

effect fn copyKeptSlots(slots: &[KeptSlot]) -> List<KeptSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<KeptSlot>.make()
  let mut at = usize.ZERO
  while at < slots.length {
    run List<KeptSlot>.append(&mut copied, KeptSlot {path: run Type.copyKeptPath(List<KeptStep>.asSlice(&slots[at].path)), source: run copyRegions(List<Shared<Lifetime>>.asSlice(&slots[at].source)), view: slots[at].view, referent: Shared<Type>.clone(&slots[at].referent),
      exclusive: slots[at].exclusive, kept: run copyRegions(List<Shared<Lifetime>>.asSlice(&slots[at].kept)),
      keptApproximate: run copyRegions(List<Shared<Lifetime>>.asSlice(&slots[at].keptApproximate))})
    at = at + usize.ONE
  }
  return move copied
}

// The bound on how deep a structural walk expands a type's members. Reaching it answers
// conservatively.
fn holdDepth() -> usize { return 24 }

// The static parameter positions of a signature.
effect fn signatureStaticSlotList(signature: &Shared<Result<Answer, NoRejection>>) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut slots = List<usize>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, fn(answer: &Result<Answer, NoRejection>) -> usize {
    if let Result<Answer, NoRejection>.Success {value} = &answer.* {
      if let Outcome.Success {value: Value.Signature {signature: declared}} = &value.outcome { return List<usize>.length(&declared.staticSlots) }
    }
    return usize.ZERO
  })
  let mut at = usize.ZERO
  while at < count {
    let slot = Shared<Result<Answer, NoRejection>>.with<usize>(signature, fn(answer: &Result<Answer, NoRejection>) -> usize {
      if let Result<Answer, NoRejection>.Success {value} = &answer.* {
        if let Outcome.Success {value: Value.Signature {signature: declared}} = &value.outcome { return List<usize>.asSlice(&declared.staticSlots)[at] }
      }
      return usize.MAX
    })
    run List<usize>.append(&mut slots, slot)
    at = at + usize.ONE
  }
  return move slots
}

fn signatureEnvironmentCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if let Option<Intersection>.Some {value: environment} = &signature.environment { return List<LifetimeMember>.length(&environment.members) }
    }
  }
  return usize.ZERO
}

fn signatureEnvironmentAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Lifetime>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if let Option<Intersection>.Some {value: environment} = &signature.environment {
        let members = List<LifetimeMember>.asSlice(&environment.members)
        if at < members.length { return Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&members[at].region)) }
      }
    }
  }
  return Option<Shared<Lifetime>>.none()
}

// The constraints of a signature through which its body can store an argument beyond its parameter
// positions: outlives bounds, conformances whose witnesses can store what they name into their
// provider, and provided services, which store where they reach.
effect fn keptBounds(signature: &Shared<Result<Answer, NoRejection>>) -> List<KeptBound> ! OutOfMemoryError ? &mut Allocator {
  let mut bounds = List<KeptBound>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move found {
      match move value {
        Constraint.Outlives {longer, shorter} => run List<KeptBound>.append(&mut bounds, KeptBound.Outlives {longer: move longer, shorter: move shorter})
        Constraint.Contents {subject, region} => run List<KeptBound>.append(&mut bounds, KeptBound.Contents {subject: move subject, region: move region})
        Constraint.Conforms {provider, contract} => {
          run List<KeptBound>.append(&mut bounds, KeptBound.Storing {value: Shared<Type>.clone(&provider)})
          run List<KeptBound>.append(&mut bounds, KeptBound.Witness {provider: move provider, contract: move contract})
        }
        // The provider reaches the service it selects, so the callee can store wherever either reaches.
        Constraint.Provides {provider, selector, ..} => {
          run List<KeptBound>.append(&mut bounds, KeptBound.Reaching {value: move provider})
          let listed = Shared<Row>.with<usize>(&selector, fn(row: &Row) -> usize { return List<Requirement>.length(&row.entries) })
          let mut entry = usize.ZERO
          while entry < listed {
            let capability = Shared<Row>.with<Shared<Type>>(&selector, fn(row: &Row) -> Shared<Type> {
              let entries = List<Requirement>.asSlice(&row.entries)
              return Shared<Type>.clone(&entries[entry].capability)
            })
            run List<KeptBound>.append(&mut bounds, KeptBound.Reaching {value: move capability})
            entry = entry + usize.ONE
          }
        }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return move bounds
}

// Binds each callable parameter representation of a signature to its use contract.
effect fn representedContracts(signature: &Shared<Result<Answer, NoRejection>>) -> List<Binding> ! OutOfMemoryError ? &mut Allocator {
  let mut contracts = List<Binding>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter, contract}} = &found {
      let slot = Shared<Type>.with<Option<DeclarationId>>(&parameter, fn(value: &Type) -> Option<DeclarationId> {
        if let Type.Parameter {declaration, ..} = &value.* { return Option<DeclarationId>.some(DeclarationId.copy(&declaration)) }
        return Option<DeclarationId>.none()
      })
      let ordinal = Shared<Type>.with<usize>(&parameter, fn(value: &Type) -> usize {
        if let Type.Parameter {ordinal, ..} = &value.* { return ordinal }
        return usize.MAX
      })
      if let Option<DeclarationId>.Some {value: owner} = move slot {
        run List<Binding>.append(&mut contracts, Binding {declaration: run Shared<DeclarationId>.make(move owner), ordinal: ordinal,
          value: Argument.Type {value: Shared<Type>.clone(&contract)}})
      }
    }
    at = at + usize.ONE
  }
  return move contracts
}

// The written parameter types of a signature.
effect fn signatureParameterTypes(signature: &Shared<Result<Answer, NoRejection>>) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let mut parameters = List<Shared<Type>>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, at) })
    if let Option<Shared<Type>>.Some {value} = move selected { run List<Shared<Type>>.append(&mut parameters, move value) }
    at = at + usize.ONE
  }
  return move parameters
}

// The parameter types of a signature a call supplies operands for: every one but its static
// parameters, whose arguments static evaluation consumes (they have no operand).
effect fn runtimeParameterTypes(signature: &Shared<Result<Answer, NoRejection>>) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  let slots = run signatureStaticSlotList(signature)
  let statics = List<usize>.asSlice(&slots)
  let all = run signatureParameterTypes(signature)
  let listed = List<Shared<Type>>.asSlice(&all)
  let mut runtime = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if !isStaticIndex(statics, at) { run List<Shared<Type>>.append(&mut runtime, Shared<Type>.clone(&listed[at])) }
    at = at + usize.ONE
  }
  return move runtime
}

// The run access of an Effect that stores arguments of these types (EFFECT-OWN-002): shared when
// every one is Copy, exclusive when one is an exclusive view, otherwise once.
effect fn storedRunMode(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, stored: &[Shared<Type>], constraints: &[Constraint], span: Span)
  -> Result<CallableMode, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut runMode = CallableMode.Shared
  let mut at = usize.ZERO
  while at < stored.length {
    let exclusive = Shared<Type>.with<bool>(&stored[at], fn(value: &Type) -> bool {
      return match &value.* { Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable _ => false }
    })
    if exclusive {
      runMode = strongerMode(runMode, CallableMode.Mutable)
    } else {
      let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[at], constraints, span) {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<CallableMode, Shared<Rejection>>.failResult(move error) }
      }
      if !copied { runMode = CallableMode.Once }
    }
    at = at + usize.ONE
  }
  return Result<CallableMode, Shared<Rejection>>.succeed(runMode)
}

fn strongerMode(first: CallableMode, second: CallableMode) -> CallableMode {
  if first == CallableMode.Once || second == CallableMode.Once { return CallableMode.Once }
  if first == CallableMode.Mutable || second == CallableMode.Mutable { return CallableMode.Mutable }
  return CallableMode.Shared
}

// Pattern binders are checked places rather than ordinary body locals. Give each visible binder
// an environment alias while retaining its parent place as the construction operand.
effect fn capturePatternLocals(source: &SourceIndex, cursor: &AuthoredCursor, nodes: &[BodyNode],
  locals: &mut List<BodyLocal>, parents: &mut List<BodyNodeId>) -> ()
! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.PatternBinding {access, ..}} = &nodes[at].kind {
      if let Node.BindingPattern {..} = run bodyNode(source, cursor, run originSyntax(cursor, nodes[at].origin)) {
        run List<BodyLocal>.append(&mut locals.*, BodyLocal {origin: nodes[at].origin,
          ty: Shared<Type>.clone(&ty), mutable: access == BodyBindingAccess.Exclusive, meetDepth: Option<usize>.none(), written: false})
        run List<BodyNodeId>.append(&mut parents.*, BodyNodeId {index: at})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn callableType(ty: &Type) -> bool {
  return match &ty.* { Type.Callable {..} => true Type.CallableSchema {..} => true Type.CallableValue {..} => true Type.CallableStage {..} => true _ => false }
}

fn sharedCallableType(ty: &Type) -> bool {
  return match &ty.* { Type.Callable {mode, ..} => mode == CallableMode.Shared _ => false }
}

effect fn capturePatternOperand(nodes: &[BodyNode], parent: BodyNodeId) -> Option<BodyExpression>
! OutOfMemoryError ? &mut Allocator {
  if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {subject, path, access, declared}, ..} = &nodes[parent.index].kind {
    return Option<BodyExpression>.some(BodyExpression.PatternBinding {subject: subject, path: run copySteps(&path), access: access,
      declared: Shared<Type>.clone(&declared)})
  }
  return Option<BodyExpression>.none()
}

// Declared contents contracts prove public validity. Otherwise a stored parameter remains an
// explicit local obligation; it is not added to the declaration's universally usable premises.
effect fn captureContents(ty: &Shared<Type>, caller: &DeclarationId, constraints: &[Constraint],
  regions: &mut List<Shared<Lifetime>>, unresolved: &mut List<Shared<Type>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let representations = List<Option<Shared<Type>>>.make()
  if run Type.retainedRegions(ty, caller, List<Option<Shared<Type>>>.asSlice(&representations), &mut regions.*, false) { return true }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Contents {subject, region} = &constraints[at] {
      if run Type.equalsShared(ty, &subject) {
        run List<Shared<Lifetime>>.append(&mut regions.*, Shared<Lifetime>.clone(&region))
        return true
      }
    }
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      if run Type.equalsShared(ty, &parameter) {
        return run Type.retainedRegions(&contract, caller, List<Option<Shared<Type>>>.asSlice(&representations), &mut regions.*, false)
      }
    }
    at = at + usize.ONE
  }
  let mut parameters = List<Shared<Type>>.make()
  run Type.storedParameters(ty, &mut parameters)
  let listed = List<Shared<Type>>.asSlice(&parameters)
  if listed.length == usize.ZERO { return false }
  at = usize.ZERO
  while at < listed.length {
    // This recursion reaches individual parameters, not the original aggregate again.
    let parameter = Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool {
      return match &value.* { Type.Parameter {..} => true _ => false }
    })
    if parameter {
      run List<Shared<Type>>.append(&mut unresolved.*, Shared<Type>.clone(&listed[at]))
    } else {
      if !run captureContents(&listed[at], caller, constraints, &mut regions.*, &mut unresolved.*) { return false }
    }
    at = at + usize.ONE
  }
  return true
}

effect fn captureRetainedRegions(ty: &Shared<Type>, caller: &DeclarationId, ordinal: usize,
  constraints: &[Constraint], regions: &mut List<Shared<Lifetime>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut unresolved = List<Shared<Type>>.make()
  if !run captureContents(ty, caller, constraints, &mut regions.*, &mut unresolved) { return false }
  if List<Shared<Type>>.length(&unresolved) != usize.ZERO {
    run List<Shared<Lifetime>>.append(&mut regions.*, run Shared<Lifetime>.make(Lifetime.Local {
      declaration: DeclarationId.copy(caller), ordinal: ordinal, binder: usize.MAX}))
  }
  return true
}

// Numeric facts come from the same authored literals that indexed consumption checks. The
// source proof receives typed-node ordinals, never reparses source or backend projections.
effect fn callableMovement(nodes: &[BodyNode], constraints: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Move {..}} = &nodes[at].kind {
      let callable = run callableArgumentContract(&ty, constraints)
      if let Option<Shared<Type>>.Some {..} = move callable { return true }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn captureAvailability(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor,
  nodes: &[BodyNode], root: BodyNodeId, parameters: usize, constraints: &[Constraint]) -> Option<Shared<Rejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !CaptureAvailability.applies(nodes) {
    if !run callableMovement(nodes, constraints) { return Option<Shared<Rejection>>.none() }
  }
  let mut indices = List<Option<usize>>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    let mut known = Option<usize>.none()
    if let BodyNodeKind.Expression {form: BodyExpression.Integer {literal}, ..} = &nodes[at].kind {
      if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, Anchor.hir(&run cursorAnchor(cursor), literal)) {
        if sign == Sign.Positive {
          let digits = run bodyText(&resolver.source, cursor, magnitude)
          known = Type.extentValue(Bytes.asSlice(&digits))
        }
      }
    }
    run List<Option<usize>>.append(&mut indices, move known)
    at = at + usize.ONE
  }
  let checked = run CaptureAvailability.check(nodes, List<Option<usize>>.asSlice(&indices), root, parameters)
  if let Option<CaptureAvailability.Failure>.Some {value} = move checked {
    let code = match value.kind {
      CaptureFailureKind.Unavailable => RejectionCode.UseAfterMove
      CaptureFailureKind.LoopChanged => RejectionCode.IncompatibleLoopHeader
      CaptureFailureKind.OverlappingWrite => RejectionCode.OverlappingAssignment
      CaptureFailureKind.GuardConsumed => RejectionCode.GuardConsumesPattern
      CaptureFailureKind.Unproved => RejectionCode.CaptureAvailabilityUnavailable
    }
    let mut related = Option<RelatedSite>.none()
    if let Option<BodyOrigin>.Some {value: previous} = &value.previous {
      related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: run originSpan(cursor, previous)})
    }
    return Option<Shared<Rejection>>.some(run rejectWithRelated(resolver, module, code, run originSpan(cursor, value.origin), move related))
  }
  return Option<Shared<Rejection>>.none()
}

// How a checked literal body becomes its use contract.
union LiteralContract {
  // An anonymous `fn` or `effect fn` with a written header. Invoking an `effect fn` constructs the
  // Effect it promises (EFF-001).
  Callable {signature: Shared<Result<Answer, NoRejection>>},
  // An `effect {}` block: running it runs its body, whose channels it derives (EFF-002, EFF-011).
  Block {success: Shared<Type>, failure: Shared<Type>, requirements: Shared<Row>},
}

// The enclosing locals a literal body sees, before its own parameters.
struct LiteralLocals {
  locals: List<BodyLocal>,
  // Pattern binders get environment aliases after the ordinary locals; their parent places are the
  // construction operands.
  patternParents: List<BodyNodeId>,
  ordinaryCount: usize,
}

effect fn literalLocals<'scope>(source: &SourceIndex, cursor: &AuthoredCursor, statementScope: &StatementScope<'scope>,
  nodes: &[BodyNode]) -> LiteralLocals ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let ordinaryCount = List<BodyLocal>.length(&statementScope.locals.*)
  let mut locals = run lexicalLocals(List<BodyLocal>.asSlice(&statementScope.locals.*))
  let mut patternParents = List<BodyNodeId>.make()
  run capturePatternLocals(source, cursor, nodes, &mut locals, &mut patternParents)
  return LiteralLocals {locals: move locals, patternParents: move patternParents, ordinaryCount: ordinaryCount}
}

// The annotation and call facts of a literal's own block.
effect fn literalFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, moduleOrdinal: usize, ordinal: usize, block: HirId)
  -> Result<BodyFacts, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let sourceAnswer = run observedSyntax(&mut resolver.*, module, block)
  let mut annotations = List<HirId>.make()
  let mut writtenCalls = List<CallSyntax>.make()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let hir = IndexedSource.authored(indexed)
    if let Node.Block {statements} = Module.node(hir, block) { run collectBodySyntax(hir, statements, &mut annotations, &mut writtenCalls) }
  }
  return run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal, &annotations, &writtenCalls)
}

effect fn checkAnonymous<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, nodes: &mut List<BodyNode>, expression: HirId,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let position = run literalOrdinal(&mut resolver.*, module, expression)
  let ordinal = match move position {
    Option<usize>.Some {value} => value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let declarationAccess128Request = Key {
    family: Family.Signature, module: moduleOrdinal, declaration: ordinal, name: usize.ZERO, member: usize.ZERO, external: false,
  }
  let declarationAccess128 = run internDeclaration(&mut resolver.*, declarationAccess128Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess128, span)
  let refused = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause)
  if let Option<Shared<Rejection>>.Some {value: rejected} = move refused {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move rejected)
  }
  let sourceAnswer = run observedSyntax(&mut resolver.*, module, expression)
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  let prepared = match move sourceOf(&resolver.*, &sourceAnswer, module) {
    Option<&IndexedSource>.Some {value: indexed} => run prepareBody(&resolver.*, module, indexed, ordinal, &signature, count, true, false)
    _ => Result<PreparedBody, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let preparedBody = match move prepared {
    Result<PreparedBody, Shared<Rejection>>.Success {value} => move value
    Result<PreparedBody, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let PreparedBody {block, identity, locals: parameters, ..} = move preparedBody
  let facts = run literalFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal, block)
  let resolvedFacts = match move facts {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let BodyFacts {annotations: resolvedAnnotations, calls} = move resolvedFacts
  let lexical = run literalLocals(&resolver.source, cursor, &statementScope.*, List<BodyNode>.asSlice(&nodes.*))
  let LiteralLocals {locals: outer, patternParents, ordinaryCount} = move lexical
  let mut locals = move outer
  let outerCount = List<BodyLocal>.length(&locals)
  let writtenParameters = List<BodyLocal>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < writtenParameters.length {
    run List<BodyLocal>.append(&mut locals, BodyLocal {origin: writtenParameters[at].origin,
      ty: Shared<Type>.clone(&writtenParameters[at].ty), mutable: writtenParameters[at].mutable, meetDepth: Option<usize>.none(),
      written: writtenParameters[at].written})
    at = at + usize.ONE
  }
  let resultType = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult) {
    Option<Shared<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  // A literal's parameters are inputs like a declaration's (LIFE-002), inside its enclosing body.
  let lexicalConstraints = match move run bodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, ordinal) {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<List<Constraint>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let bodyConstraints = List<Constraint>.asSlice(&lexicalConstraints)
  let mut checkedNodes = List<BodyNode>.make()
  let mut signatures = List<SignatureDependency>.make()
  let mut required = List<DeclarationId>.make()
  run enterBodyFrame(&mut resolver.*, &signature, false, Option<AuthoredCursor>.none())
  let checked = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
    &mut locals, List<ResolvedAnnotation>.asSlice(&resolvedAnnotations), List<ResolvedCall>.asSlice(&calls),
    &mut checkedNodes, &mut signatures, &mut required, block, &resultType, bodyConstraints, true, false, usize.ZERO, false)
  let ClosedBody {recovered, ..} = move closeBodyFrame(&mut resolver.*)
  run forwardRecovered(&mut resolver.*, move recovered)
  let control = match move checked {
    Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
    Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  if control.canComplete && Shared<Type>.with<usize>(&resultType, scalarCode) != usize.ONE {
    let closing = run bodySpan(&resolver.source, cursor, block)
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run typeHoleRejection(module, RejectionCode.MissingReturn,
      Span.make(closing.end - usize.ONE, closing.end), b"expected", &resultType))
  }
  let checkedBody = CheckedLiteral {ordinal: ordinal, identity: move identity, locals: move locals, outerCount: outerCount,
    ordinaryCount: ordinaryCount, patternParents: move patternParents, parameters: count, nodes: move checkedNodes,
    root: control.node, signatures: move signatures, required: move required}
  return run finishLiteral(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut nodes.*, expression, span, expected, mismatchCode, constraints, bodyConstraints, move checkedBody, LiteralContract.Callable {signature: move signature})
}

// An `effect {}` block is checked like an anonymous body with no parameters. Without a header, its
// channels are the join of what its body returns, fails with and runs (EFF-002, EFF-011). Sites
// whose type differs from that join are checked again against it, so each converts exactly as in
// a declared body.
effect fn checkEffectBlock<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, nodes: &mut List<BodyNode>, expression: HirId, block: HirId,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let position = run literalOrdinal(&mut resolver.*, module, expression)
  let ordinal = match move position {
    Option<usize>.Some {value} => value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let identity = match move run declarationAt(&mut resolver.*, module, ordinal) {
    Option<DeclarationId>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let facts = run literalFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, moduleOrdinal, ordinal, block)
  let resolvedFacts = match move facts {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let BodyFacts {annotations: resolvedAnnotations, calls} = move resolvedFacts
  let lexical = run literalLocals(&resolver.source, cursor, &statementScope.*, List<BodyNode>.asSlice(&nodes.*))
  let LiteralLocals {locals: outer, patternParents, ordinaryCount} = move lexical
  let outerCount = List<BodyLocal>.length(&outer)
  let unit = run Types.intern(Type.Unit)
  let mut locals = run lexicalLocals(List<BodyLocal>.asSlice(&outer))
  let mut checkedNodes = List<BodyNode>.make()
  let mut signatures = List<SignatureDependency>.make()
  let mut required = List<DeclarationId>.make()
  // A closed expected Effect supplies the block's channels (EFF-011): its body is checked against
  // them directly, so returns convert to the expected success and undeclared failures or
  // requirements are reported where they occur.
  let expectedChannels = run expectedBlockChannels(expected)
  if let Option<EffectChannels>.Some {value: declared} = move expectedChannels {
    run List<BodyFrame>.append(&mut resolver.*.bodies, BodyFrame {isEffect: true, isTest: false, failure: Shared<Type>.clone(&declared.failure),
      requirements: Shared<Row>.clone(&declared.requirements), derived: Option<DerivedChannels>.none(),
      occurrences: List<StaticIteration>.make(), staticApplication: Option<Application>.none(), staticPrefixes: List<List<StaticPrefixWork>>.make(), recovered: List<Shared<Rejection>>.make(), failedStatements: List<FailedStatement>.make(), shortened: List<Span>.make(), signature: Option<Shared<Result<Answer, NoRejection>>>.none(), root: false, runOperand: Option<HirId>.none(), naming: Option<AuthoredCursor>.none()})
    let declaredCheck = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
      &mut locals, List<ResolvedAnnotation>.asSlice(&resolvedAnnotations), List<ResolvedCall>.asSlice(&calls),
      &mut checkedNodes, &mut signatures, &mut required, block, &declared.success, constraints, true, false, usize.ZERO, false)
    let ClosedBody {recovered, ..} = move closeBodyFrame(&mut resolver.*)
    run forwardRecovered(&mut resolver.*, move recovered)
    let checked = match move declaredCheck {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    if checked.canComplete && Shared<Type>.with<usize>(&declared.success, scalarCode) != usize.ONE {
      let closing = run bodySpan(&resolver.source, cursor, block)
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run typeHoleRejection(module, RejectionCode.MissingReturn,
        Span.make(closing.end - usize.ONE, closing.end), b"expected", &declared.success))
    }
    let checkedBody = CheckedLiteral {ordinal: ordinal, identity: move identity, locals: move locals, outerCount: outerCount,
      ordinaryCount: ordinaryCount, patternParents: move patternParents, parameters: usize.ZERO, nodes: move checkedNodes,
      root: checked.node, signatures: move signatures, required: move required}
    return run finishLiteral(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut nodes.*, expression, span, expected, mismatchCode, constraints, constraints, move checkedBody,
      LiteralContract.Block {success: move declared.success, failure: move declared.failure, requirements: move declared.requirements})
  }
  run List<BodyFrame>.append(&mut resolver.*.bodies, BodyFrame {isEffect: true, isTest: false,
    failure: run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
    requirements: run Shared<Row>.make(Row.empty()), derived: Option<DerivedChannels>.some(DerivedChannels {
      returns: List<Shared<Type>>.make(), failed: List<Shared<Type>>.make(), failures: List<Shared<Type>>.make(),
      requirements: Row.empty()}), occurrences: List<StaticIteration>.make(), staticApplication: Option<Application>.none(), staticPrefixes: List<List<StaticPrefixWork>>.make(), recovered: List<Shared<Rejection>>.make(), failedStatements: List<FailedStatement>.make(), shortened: List<Span>.make(), signature: Option<Shared<Result<Answer, NoRejection>>>.none(), root: false, runOperand: Option<HirId>.none(), naming: Option<AuthoredCursor>.none()})
  let derivedCheck = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
    &mut locals, List<ResolvedAnnotation>.asSlice(&resolvedAnnotations), List<ResolvedCall>.asSlice(&calls),
    &mut checkedNodes, &mut signatures, &mut required, block, &unit, constraints, true, false, usize.ZERO, false)
  let frame = List<BodyFrame>.pop(&mut resolver.*.bodies)
  let popped = match move frame {
    Option<BodyFrame>.Some {value} => move value
    Option<BodyFrame>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let BodyFrame {derived: derivedFacts, recovered: derivedRecovered, ..} = move popped
  run forwardRecovered(&mut resolver.*, move derivedRecovered)
  let mut control = match move derivedCheck {
    Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
    Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let derived = match move derivedFacts {
    Option<DerivedChannels>.Some {value} => move value
    Option<DerivedChannels>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let DerivedChannels {returns, failed, failures, requirements: ran} = move derived
  let returned = List<Shared<Type>>.asSlice(&returns)
  let mut successes = run copyTypes(returned)
  // Falling off the end returns `()` only when nothing else is returned (EFF-002).
  if control.canComplete && returned.length == usize.ZERO { run List<Shared<Type>>.append(&mut successes, Shared<Type>.clone(&unit)) }
  let success = run joinedType(move successes)
  let failure = run joinedType(move failures)
  let requirements = run Shared<Row>.make(move ran)
  let mut exact = true
  let mut at = usize.ZERO
  while at < returned.length {
    if !run Type.equalsShared(&returned[at], &success) { exact = false }
    at = at + usize.ONE
  }
  let failedSites = List<Shared<Type>>.asSlice(&failed)
  at = usize.ZERO
  while at < failedSites.length {
    if !run Type.equalsShared(&failedSites[at], &failure) { exact = false }
    at = at + usize.ONE
  }
  if !exact {
    locals = run lexicalLocals(List<BodyLocal>.asSlice(&outer))
    checkedNodes = List<BodyNode>.make()
    signatures = List<SignatureDependency>.make()
    required = List<DeclarationId>.make()
    run List<BodyFrame>.append(&mut resolver.*.bodies, BodyFrame {isEffect: true, isTest: false, failure: Shared<Type>.clone(&failure),
      requirements: Shared<Row>.clone(&requirements), derived: Option<DerivedChannels>.none(),
      occurrences: List<StaticIteration>.make(), staticApplication: Option<Application>.none(), staticPrefixes: List<List<StaticPrefixWork>>.make(), recovered: List<Shared<Rejection>>.make(), failedStatements: List<FailedStatement>.make(), shortened: List<Span>.make(), signature: Option<Shared<Result<Answer, NoRejection>>>.none(), root: false, runOperand: Option<HirId>.none(), naming: Option<AuthoredCursor>.none()})
    let declaredCheck = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, &identity,
      &mut locals, List<ResolvedAnnotation>.asSlice(&resolvedAnnotations), List<ResolvedCall>.asSlice(&calls),
      &mut checkedNodes, &mut signatures, &mut required, block, &success, constraints, true, false, usize.ZERO, false)
    let ClosedBody {recovered: checkedRecovered, ..} = move closeBodyFrame(&mut resolver.*)
    run forwardRecovered(&mut resolver.*, move checkedRecovered)
    control = match move declaredCheck {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
  }
  if control.canComplete && Shared<Type>.with<usize>(&success, scalarCode) != usize.ONE {
    let closing = run bodySpan(&resolver.source, cursor, block)
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run typeHoleRejection(module, RejectionCode.MissingReturn,
      Span.make(closing.end - usize.ONE, closing.end), b"expected", &success))
  }
  let checkedBody = CheckedLiteral {ordinal: ordinal, identity: move identity, locals: move locals, outerCount: outerCount,
    ordinaryCount: ordinaryCount, patternParents: move patternParents, parameters: usize.ZERO, nodes: move checkedNodes,
    root: control.node, signatures: move signatures, required: move required}
  return run finishLiteral(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut nodes.*, expression, span, expected, mismatchCode, constraints, constraints, move checkedBody,
    LiteralContract.Block {success: move success, failure: move failure, requirements: move requirements})
}

// The channels of a closed written Effect the block is expected to be; an open or absent
// expectation leaves the block to derive its own.
effect fn expectedBlockChannels(expected: &Option<Shared<Type>>) -> Option<EffectChannels> ! OutOfMemoryError ? &mut Allocator {
  let ty = match &expected.* {
    Option<Shared<Type>>.Some {value} => Shared<Type>.clone(&value)
    _ => { return Option<EffectChannels>.none() }
  }
  if Type.hasOpenParameters(&ty) { return Option<EffectChannels>.none() }
  return Shared<Type>.with<Option<EffectChannels>>(&ty, fn(value: &Type) -> Option<EffectChannels> {
    return match &value.* { Type.Effect {..} => effectChannels(value) _ => Option<EffectChannels>.none() }
  })
}

// One literal body after checking, before its environment is built.
struct CheckedLiteral {
  ordinal: usize,
  identity: DeclarationId,
  locals: List<BodyLocal>,
  outerCount: usize,
  ordinaryCount: usize,
  patternParents: List<BodyNodeId>,
  parameters: usize,
  nodes: List<BodyNode>,
  root: BodyNodeId,
  signatures: List<SignatureDependency>,
  required: List<DeclarationId>,
}

// Builds a checked literal's environment from its captures and appends the construction: the
// literal's exact representation, whose runner is its own instance (MIR note §7, Effect note D1).
effect fn finishLiteral(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  nodes: &mut List<BodyNode>, expression: HirId, span: Span, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint],
  bodyConstraints: &[Constraint], literal: CheckedLiteral, literalContract: LiteralContract,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let CheckedLiteral {ordinal, identity, locals, outerCount, ordinaryCount, patternParents, parameters: count,
    nodes: checkedNodes, root, signatures, required} = move literal
  let availability = run captureAvailability(&resolver.*, module, cursor, List<BodyNode>.asSlice(&checkedNodes), root, outerCount + count, bodyConstraints)
  if let Option<Shared<Rejection>>.Some {value} = move availability {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move value)
  }
  let localCopies = match move run localCopyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<BodyLocal>.asSlice(&locals), outerCount, bodyConstraints, &run cursorAnchor(cursor)) {
    Result<List<bool>, Shared<Rejection>>.Success {value} => move value
    Result<List<bool>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let expressionCopies = match move run expressionCopyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, List<BodyNode>.asSlice(&checkedNodes), bodyConstraints, &run cursorAnchor(cursor)) {
    Result<List<bool>, Shared<Rejection>>.Success {value} => move value
    Result<List<bool>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let captures = run Capture.collect(List<BodyNode>.asSlice(&checkedNodes), List<BodyLocal>.asSlice(&locals), outerCount,
    List<bool>.asSlice(&localCopies), List<bool>.asSlice(&expressionCopies))
  let captured = List<Capture.Capture>.asSlice(&captures)
  let mode = Capture.invocation(captured)
  let mut fieldTypes = List<Shared<Type>>.make()
  let mut fields = List<BodyAggregateField>.make()
  let mut aliases = List<BodyEnvironmentCapture>.make()
  let mut referents = List<BodyReferentCapture>.make()
  let mut regions = List<Shared<Lifetime>>.make()
  let mut environmentAliases = List<EnvironmentAlias>.make()
  let mut at = usize.ZERO
  while at < captured.length {
    let capture = &captured[at]
    let mut local = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    if capture.local.index < ordinaryCount {
      run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
        ty: Shared<Type>.clone(&capture.ty), form: BodyExpression.Local {local: capture.local}}})
    } else {
      let parent = List<BodyNodeId>.get(&patternParents, capture.local.index - ordinaryCount)
      let copied = run capturePatternOperand(List<BodyNode>.asSlice(&nodes.*), parent)
      if let Option<BodyExpression>.Some {value: binding} = move copied {
        run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
          ty: Shared<Type>.clone(&capture.ty), form: move binding}})
      }
    }
    let mut operand = local
    let mut fieldType = Shared<Type>.clone(&capture.ty)
    let view = Shared<Type>.with<bool>(&capture.ty, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Reference {..} => true
        Type.Slice {..} => true
        Type.String {..} => true
        Type.Callable {..} => true
        _ => false
      }
    })
    // Descriptors carry their existing source loan. Exact callable values and opaque returned
    // representations own their environment; shared/exclusive access borrows that owner.
    let borrowed = !view && (capture.access == CaptureAccess.Shared || capture.access == CaptureAccess.Mutable)
    if borrowed {
      let mut access = Access.Shared
      if capture.access == CaptureAccess.Mutable { access = Access.Mutable }
      // Each by-reference capture has its own region, opened at its first use.
      let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: capture.firstUse.node,
        binder: usize.MAX})
      run List<EnvironmentAlias>.append(&mut environmentAliases, EnvironmentAlias {local: capture.local.index,
        region: Shared<Lifetime>.clone(&region), held: false})
      fieldType = run Types.intern(Type.Reference {access: access, referent: Shared<Type>.clone(&capture.ty), lifetime: move region})
      operand = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
      run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
        ty: Shared<Type>.clone(&fieldType), form: BodyExpression.Borrow {access: access, value: local}}})
    }
    // A captured exclusive descriptor the body reads or writes through stays in its field, and its
    // referent is reborrowed with that access for as long as the callable lives (CAPTURE-002). The
    // body reaches the referent only through that loan, whose region its creator chooses.
    let exclusiveView = Shared<Type>.with<bool>(&capture.ty, fn(ty: &Type) -> bool {
      return match &ty.* {
        Type.Reference {access, ..} => access == Access.Mutable
        Type.Slice {access, ..} => access == Access.Mutable
        _ => false
      }
    })
    if exclusiveView && (capture.access == CaptureAccess.Shared || capture.access == CaptureAccess.Mutable) {
      let mut access = Access.Shared
      if capture.access == CaptureAccess.Mutable { access = Access.Mutable }
      let region = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(caller), ordinal: capture.firstUse.node,
        binder: usize.MAX})
      run List<EnvironmentAlias>.append(&mut environmentAliases, EnvironmentAlias {local: capture.local.index,
        region: Shared<Lifetime>.clone(&region), held: true})
      run List<BodyReferentCapture>.append(&mut referents, BodyReferentCapture {field: at, access: access, region: move region})
    }
    if capture.access == CaptureAccess.Move {
      let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
        List<BodyNode>.asSlice(&nodes.*), local, false, false, run originSpan(cursor, capture.accessOrigin), run originSpan(cursor, capture.accessOrigin), constraints) {
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value} => move value
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      operand = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
      run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: capture.firstUse, kind: BodyNodeKind.Expression {
        ty: Shared<Type>.clone(&capture.ty), form: BodyExpression.Move {value: local, consumed: move consumed}}})
    }
    let known = run captureRetainedRegions(&fieldType, caller, run anchoredNode(cursor, expression), bodyConstraints, &mut regions)
    if !known { return run bodyRejection(&resolver.*, module, RejectionCode.AmbiguousLifetime, run originSpan(cursor, capture.firstUse)) }
    run List<Shared<Type>>.append(&mut fieldTypes, move fieldType)
    run List<BodyAggregateField>.append(&mut fields, BodyAggregateField {index: at, value: operand})
    run List<BodyEnvironmentCapture>.append(&mut aliases, BodyEnvironmentCapture {local: capture.local, field: at, dereference: borrowed})
    at = at + usize.ONE
  }
  let schemaAnswer = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, true, &identity, span)
  let schema = match move schemaAnswer {
    Option<TargetSchema>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let ownSlots = List<ApplicationSlot>.asSlice(&schema.own)
  let mut ownArguments = List<Argument>.make()
  at = usize.ZERO
  while at < ownSlots.length {
    run List<Argument>.append(&mut ownArguments, run scopeArgument(&identity, ownSlots[at].ordinal, ownSlots[at].kind))
    at = at + usize.ONE
  }
  let application = run Shared<Application>.make(Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(&identity)},
    arguments: move ownArguments, argumentOrdinals: run applicationOrdinals(ownSlots), scopes: run formalCallableScopes(&schema), statics: List<StaticSlot>.make()})
  // The signatures whose implied bounds the body assumes, and its declared result and failure.
  let mut regionSignatures = List<Shared<Result<Answer, NoRejection>>>.make()
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: enclosing} = move rootBodySignature(&resolver.*) {
    run List<Shared<Result<Answer, NoRejection>>>.append(&mut regionSignatures, move enclosing)
  }
  let mut regionResult = run Types.intern(Type.Unit)
  let mut regionFailure = run Types.intern(Type.Unit)
  match &literalContract {
    LiteralContract.Callable {signature} => {
      run List<Shared<Result<Answer, NoRejection>>>.append(&mut regionSignatures, Shared<Result<Answer, NoRejection>>.clone(&signature))
      if let Option<Shared<Type>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult) {
        regionResult = move value
      }
      regionFailure = run signatureFailure(&signature)
    }
    LiteralContract.Block {success, failure, ..} => {
      regionResult = Shared<Type>.clone(&success)
      regionFailure = Shared<Type>.clone(&failure)
    }
  }
  let environment = List<Shared<Lifetime>>.asSlice(&regions)
  let mut useContract = Option<Shared<Type>>.none()
  let mut representationSignature = Option<Shared<Result<Answer, NoRejection>>>.none()
  if let LiteralContract.Callable {signature} = &literalContract {
    representationSignature = Option<Shared<Result<Answer, NoRejection>>>.some(Shared<Result<Answer, NoRejection>>.clone(&signature))
    // Invoking an anonymous `effect fn` constructs an Effect whose run access follows its stored
    // arguments, as a named `effect fn` value's does (EFFECT-OWN-002), and no weaker than the
    // closure's own access to its environment.
    let mut delayed = Option<CallableMode>.none()
    if Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsEffect) {
      let written = run signatureParameterTypes(&signature)
      let stored = match move run storedRunMode(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        List<Shared<Type>>.asSlice(&written), bodyConstraints, span) {
        Result<CallableMode, Shared<Rejection>>.Success {value} => value
        Result<CallableMode, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      delayed = Option<CallableMode>.some(strongerMode(stored, mode))
    }
    useContract = Option<Shared<Type>>.some(run anonymousUseContract(&signature, &identity, mode, environment, move delayed))
  }
  if let LiteralContract.Block {success, failure, requirements} = move literalContract {
    useContract = Option<Shared<Type>>.some(run Types.intern(Type.Effect {mode: mode,
      environment: run Shared<Intersection>.make(run Intersection.of(environment)), success: move success, failure: move failure,
      requirements: move requirements}))
  }
  let selectedContract = match move useContract {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let exact = match move representationSignature {
    Option<Shared<Result<Answer, NoRejection>>>.Some {value: signature} => run anonymousEnvironmentType(&identity, &signature, move application, move selectedContract, move fieldTypes, ownSlots)
    Option<Shared<Result<Answer, NoRejection>>>.None => run Type.callableValue(false, move application, move selectedContract, move fieldTypes, List<CallableFieldInput>.make())
  }
  // The anonymous body is checked like any body: its outer locals are the captured places, and
  // its own implicit moves, loans and moves are proved before it is published (ANON-OWN-001).
  let implicit = run implicitAffineUse(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
    List<BodyNode>.asSlice(&checkedNodes), bodyConstraints, &run cursorAnchor(cursor))
  if let Option<Shared<Rejection>>.Some {value: rejection} = move implicit {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move rejection)
  }
  let cleanupAnchor = run cursorAnchor(cursor)
  let mut facts = match move run regionFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &identity,
    List<Shared<Result<Answer, NoRejection>>>.asSlice(&regionSignatures), &regionResult, &regionFailure, outerCount + count,
    List<BodyLocal>.asSlice(&locals), List<BodyNode>.asSlice(&checkedNodes), root, bodyConstraints, &cleanupAnchor) {
    Result<RegionFacts, Shared<Rejection>>.Success {value} => move value
    Result<RegionFacts, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  facts.anonymous = true
  facts.environment = move environmentAliases
  if run Progress.due(&resolver.progress) {
    let shown = run shownName(&mut resolver.*, &identity)
    run Progress.show(&mut resolver.progress, Bytes.asSlice(&shown))
  }
  run Progress.enterBorrowCheck(&mut resolver.progress)
  let verdict = run checkRegions(&regionInput(&facts, &identity, List<BodyLocal>.asSlice(&locals), List<BodyNode>.asSlice(&checkedNodes), root))
  run Progress.leaveBorrowCheck(&mut resolver.progress)
  if Progress.timing(&resolver.progress) {
    let timed = run shownName(&mut resolver.*, &identity)
    run Progress.timeBorrowCheck(&mut resolver.progress, Bytes.asSlice(&timed))
  }
  if verdict.outcome == RegionOutcome.Conflict {
    let mut related = Option<RelatedSite>.none()
    if let Option<Location>.Some {value: earlier} = &verdict.earlier {
      let earlier = Anchor.span(&cleanupAnchor, earlier)
      related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: earlier})
    }
    return Result<BodyNodeId, Shared<Rejection>>.failResult(run rejectWithRelated(&resolver.*, module, verdict.code, Anchor.span(&cleanupAnchor, verdict.access), move related))
  }
  let requirements = run copyRequirements(List<BodyRegionRequirement>.asSlice(&verdict.requirements))
  let body = run TypedBody.make(&identity, move locals, move checkedNodes, root, move signatures,
    move required, BodyStage.FullyChecked, List<StaticIteration>.make())
  let preparedEnvironment = run TypedBody.materializeEnvironment(move body, BodyEnvironment {ty: Shared<Type>.clone(&exact), outerCount: outerCount, captures: move aliases})
  let ready = match move preparedEnvironment {
    Option<TypedBody>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let id = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, expression, span), kind: BodyNodeKind.Expression {
    ty: move exact, form: BodyExpression.Callable {fields: move fields, referents: move referents,
      requirements: move requirements,
      body: run Shared<TypedBody>.make(move ready)}}})
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    id, expected, mismatchCode, span)
}

// Deferred invocation arguments select code; only captured lexical values form storage.
effect fn anonymousEnvironmentType(identity: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>,
  application: Shared<Application>, contract: Shared<Type>, fields: List<Shared<Type>>, ownSlots: &[ApplicationSlot]) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureCallableParameterStart) == usize.MAX {
    return run Type.callableValue(false, move application, move contract, move fields, List<CallableFieldInput>.make())
  }
  let formal = run Application.copyShared(&application)
  let bindings = run Application.bindings(&formal)
  let allBindings = List<Binding>.asSlice(&bindings)
  let mut selected = List<Binding>.make()
  let mut at = usize.ZERO
  while at < allBindings.length {
    if !declarationEqualsShared(identity, &allBindings[at].declaration) {
      run List<Binding>.append(&mut selected, Binding {declaration: Shared<DeclarationId>.clone(&allBindings[at].declaration),
        ordinal: allBindings[at].ordinal, value: Argument.copy(&allBindings[at].value)})
    }
    at = at + usize.ONE
  }
  let recipe = run Shared<SectionSchema>.make(SectionSchema {
    target: run Shared<DeclarationId>.make(DeclarationId.copy(identity)), contract: move contract,
    selected: move selected, deferred: run applicationOrdinals(ownSlots)})
  return run Type.callableSchema(move recipe, move fields, List<CallableFieldInput>.make())
}

// Original HIR binders are shared by generated iterations; a finished iteration's actual
// local/node ranges have left lexical scope. Lookup retains the outer body's bindings and
// the currently checked occurrence, which is recorded only after its body succeeds.
fn completedOccurrenceContains(resolver: &Resolver, index: usize, local: bool) -> bool {
  let frames = List<BodyFrame>.asSlice(&resolver.bodies)
  if frames.length == usize.ZERO { return false }
  let facts = List<StaticIteration>.asSlice(&frames[frames.length - usize.ONE].occurrences)
  let mut at = usize.ZERO
  while at < facts.length {
    let StaticIteration {nodeStart, nodeEnd, localStart, localEnd, ..} = &facts[at]
    let mut start = nodeStart
    let mut end = nodeEnd
    if local {
      start = localStart
      end = localEnd
    }
    if start <= index && index < end { return true }

    at = at + usize.ONE
  }
  return false
}

fn bodyLocalIndex(resolver: &Resolver, locals: &[BodyLocal], syntax: usize, anchor: &Anchor) -> Option<usize> {
  let mut at = usize.ZERO
  while at < locals.length {
    if BodyOrigin.syntax(locals[at].origin, anchor).index == syntax && !completedOccurrenceContains(resolver, at, true) {
      return Option<usize>.some(at)
    }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

fn contextualArrayShape(expected: &Option<Shared<Type>>) -> Option<ArrayShape> {
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    return Type.arrayShape(&value)
  }
  return Option<ArrayShape>.none()
}

struct CheckedIdentifier {
  ty: Shared<Type>,
  form: BodyExpression,
}

// Function values are handled by the construction path before this helper. An unbound identifier
// here names a constant; a bound one names a local or runtime pattern binder.
effect fn checkedIdentifier(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &[BodyLocal],
  calls: &[ResolvedCall],
  nodes: &[BodyNode],
  expression: HirId,
  name: HirId,
  bound: bool,
  binder: HirId,
  span: Span,
  staticBody: bool,
) -> Result<CheckedIdentifier, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if !bound {
    let found = run resolvedCall(calls, expression)
    let resolved = match move found {
      Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} => move value
      Option<Result<ResolvedTarget, Shared<Rejection>>>.None => {
        return Result<CheckedIdentifier, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.UnknownName, run bodySpan(&resolver.source, cursor, name)),
        )
      }
    }
    return match move resolved {
      Result<ResolvedTarget, Shared<Rejection>>.Success {
        value: ResolvedTarget.Constant {declaration, ty: constantType},
      } => {
        let read = run constantRead(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, move declaration, span, staticBody)
        return match move read {
          Result<BodyExpression, Shared<Rejection>>.Success {value: form} => Result<CheckedIdentifier, Shared<Rejection>>.succeed(
            CheckedIdentifier {ty: move constantType, form: move form},
          )
          Result<BodyExpression, Shared<Rejection>>.Failure {error} => Result<CheckedIdentifier, Shared<Rejection>>.failResult(move error)
        }
      }
      Result<ResolvedTarget, Shared<Rejection>>.Success {value: _} => Result<CheckedIdentifier, Shared<Rejection>>.failResult(
        run reject(&resolver.*, module, RejectionCode.UnknownName, run bodySpan(&resolver.source, cursor, name)),
      )
      Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Result<CheckedIdentifier, Shared<Rejection>>.failResult(move error)
    }
  }
  if let Option<usize>.Some {value: at} = move bodyLocalIndex(&resolver.*, locals, binder.index, &run cursorAnchor(cursor)) {
    return Result<CheckedIdentifier, Shared<Rejection>>.succeed(CheckedIdentifier {
      ty: Shared<Type>.clone(&locals[at].ty),
      form: BodyExpression.Local {local: BodyLocalId {index: at}},
    })
  }
  if !staticBody {
    let used = run patternBindingUse(&resolver.*, nodes, binder, &run cursorAnchor(cursor))
    if let Option<PatternBindingUse>.Some {value: use} = move used {
      return Result<CheckedIdentifier, Shared<Rejection>>.succeed(CheckedIdentifier {
        ty: move use.ty,
        form: move use.form,
      })
    }
  }
  if staticBody {
    // A runtime binding read where a static value is needed, such as a `let` local passed to a
    // static parameter, names the binding (SEM0176 `{operation}`).
    let mut diagnostic = run makeRejection(RejectionCode.StaticPhaseViolation, module, run bodySpan(&resolver.source, cursor, name))
    if let Node.Name {text} = run bodyNode(&resolver.source, cursor, name) {
      let mut operation = run Bytes.copy(b"reading the runtime value `")
      run Bytes.append(&mut operation, Bytes.asSlice(&run bodyText(&resolver.source, cursor, text)))
      run Bytes.append(&mut operation, b"`")
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: move operation})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"target"),
        value: run Bytes.copy(resolver.target.name())})
    }
    return Result<CheckedIdentifier, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
  }
  // A binder of a statement this body recovered past has no local; reading it is the failed
  // statement's consequence, not a failure of its own.
  if unavailableBinder(&resolver.*, module, run bodySpan(&resolver.source, cursor, binder)) {
    return Result<CheckedIdentifier, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.UnavailableBinding, span),
    )
  }
  return Result<CheckedIdentifier, Shared<Rejection>>.failResult(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

// An element rejected with a mismatch at its own span is reported as an array element mismatch.
effect fn checkArrayElement<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  child: HirId,
  elementType: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    child, elementType, RejectionCode.ArrayElementMismatch, constraints, contractBody, staticBody, unsafeAllowed)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
}

// None means no overload was selected, leaving only the closed scalar form to apply.
effect fn checkedSelectedOperator(
  resolver: &mut Resolver,
  caller: &DeclarationId,
  nodes: &[BodyNode],
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  constraints: &[Constraint],
  closed: bool,
  module: &ModuleId,
  operatorAnchor: Span,
  firstArgument: BodyNodeId,
  secondArgument: Option<BodyNodeId>,
  unsafeAllowed: bool,
) -> Result<Option<CheckedOperatorCall>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let selected = run selectOperator(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    requested,
    operands,
    constraints,
    closed,
    module,
    operatorAnchor,
  )
  let available = match move selected {
    Result<Option<SelectedOperator>, Shared<Rejection>>.Success {value} => move value
    Result<Option<SelectedOperator>, Shared<Rejection>>.Failure {error} => {
      return Result<Option<CheckedOperatorCall>, Shared<Rejection>>.failResult(move error)
    }
  }
  let chosen = match move available {
    Option<SelectedOperator>.Some {value} => move value
    Option<SelectedOperator>.None => {
      return Result<Option<CheckedOperatorCall>, Shared<Rejection>>.succeed(
        Option<CheckedOperatorCall>.none(),
      )
    }
  }
  let mut arguments = List<BodyNodeId>.make()
  run List<BodyNodeId>.append(&mut arguments, firstArgument)
  if let Option<BodyNodeId>.Some {value: second} = move secondArgument {
    run List<BodyNodeId>.append(&mut arguments, second)
  }
  let typed = run checkedOperatorCall(
    &mut resolver.*,
    &mut owner.*, &mut dependencies.*, caller, nodes, constraints,
    move chosen,
    move arguments,
    &mut signatures.*,
    &mut requiredBodies.*,
    module,
    operatorAnchor,
    unsafeAllowed,
  )
  let accepted = match move typed {
    Result<CheckedOperatorCall, Shared<Rejection>>.Success {value} => move value
    Result<CheckedOperatorCall, Shared<Rejection>>.Failure {error} => {
      return Result<Option<CheckedOperatorCall>, Shared<Rejection>>.failResult(move error)
    }
  }
  return Result<Option<CheckedOperatorCall>, Shared<Rejection>>.succeed(
    Option<CheckedOperatorCall>.some(move accepted),
  )
}

// A receiver method named without a call, through a value with no field of that name, is a bound
// method value (CALL-003): the section of its declaration whose only capture is the receiver,
// taken under the declared mode, awaiting the parameters after it. An associated function has no
// receiver to bind; any other missing member keeps its rejection.
effect fn checkBoundMethod<'scope>(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  request: &mut Request, dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, expression: HirId,
  subject: HirId, span: Span, memberSpan: Span, receiverNode: BodyNodeId, receiverType: &Shared<Type>, name: &[u8],
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool, staticBody: bool, unsafeAllowed: bool,
  error: Shared<Rejection>) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Shared<Rejection>.with<bool>(&error, fn(value: &Rejection) -> bool {
    return value.code == RejectionCode.UnknownProjectedField
  }) {
    return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
  }
  let method = run selectInherentReceiverCall(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, true, receiverType, name, false, true, module, memberSpan)
  let mut position = ReceiverPosition {ordinal: usize.ZERO, mode: BodyReceiverPass.Shared}
  let mut selectedTarget = Option<CallTarget>.none()
  match move method {
    Result<InherentCallChoice, Shared<Rejection>>.Success {value: InherentCallChoice.Selected {target: selected, receiver}} => {
      match move receiver {
        Option<ReceiverPosition>.Some {value} => { position = value }
        Option<ReceiverPosition>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.AssociatedFunctionOnValue, memberSpan)
        }
      }
      selectedTarget = Option<CallTarget>.some(move selected)
    }
    Result<InherentCallChoice, Shared<Rejection>>.Failure {error: diagnostic} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move diagnostic)
    }
    _ => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let mut target = match move selectedTarget {
    Option<CallTarget>.Some {value} => move value
    Option<CallTarget>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  // As for a receiver call, a static parameter has no runtime capture yet: an explicit gap.
  if position.ordinal != usize.ZERO || Shared<Result<Answer, NoRejection>>.with<usize>(&target.signature,
    signatureStaticCount) > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let declared = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&target.signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> { return signatureParameter(answer, usize.ZERO) })
  let expectedReceiver = match move declared {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let adapted = run adaptReceiver(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
    &mut statementScope.*, &mut nodes.*, constraints, subject, span, memberSpan, receiverNode, receiverType, receiverType,
    position.mode, &expectedReceiver, true, false)
  let receiver = match move adapted {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error: diagnostic} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move diagnostic)
    }
  }
  // Nothing is written in front of the member, so the receiver alone fixes the owner's binders.
  target.explicit = List<Argument>.make()
  target.explicitSlots = List<CallPrefixSlot>.make()
  target.prefixOwner = Option<Shared<DeclarationId>>.none()
  target.prefixLifetimes = usize.ZERO
  target.explicitSyntax = false
  let operand = Option<CallReceiver>.some(CallReceiver {node: receiver, pass: position.mode, subject: subject,
    memberSpan: memberSpan, bound: true, open: false})
  return run checkDeclarationCall(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
    caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span,
    move target, CallArguments.Written {range: Range.empty()}, false, &operand, expected, mismatchCode, constraints, contractBody, staticBody,
    unsafeAllowed, false, false, &Option<NamedCallableEvidence>.none())
}

// A field read outside a static body: enum members and unit variants answer first, then the
// subject is dereferenced through references before the field is selected.
effect fn checkFieldAccess<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  subject: HirId,
  field: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let qualified = run bodyQualifiedName(&resolver.source, cursor, expression)
  if let Option<QualifiedBodyName>.Some {value} = move qualified {
    let selection = run checkedEnumSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, Bytes.asSlice(&value.namespace), Bytes.asSlice(&value.member), span, false)
    if let Option<Result<EnumSelection, Shared<Rejection>>>.Some {value: selected} = move selection {
      let chosen = match move selected {
        Result<EnumSelection, Shared<Rejection>>.Success {value: choice} => move choice
        Result<EnumSelection, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      if let EnumSelection.Member {ty: enumType, member} = move chosen {
        let index = List<BodyNode>.length(&nodes.*)
        run List<BodyNode>.append(&mut nodes.*, BodyNode {
          origin: run originAt(cursor, expression, span),
          kind: BodyNodeKind.Expression {ty: move enumType, form: BodyExpression.EnumMember {member: member}},
        })
        return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
          BodyNodeId {index: index}, expected, mismatchCode, span)
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let unitSelection = run selectVariant(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      Bytes.asSlice(&value.namespace), Bytes.asSlice(&value.member), expected, span)
    if let Option<Result<SelectedVariant, Shared<Rejection>>>.Some {value: chosen} = move unitSelection {
      let variant = match move chosen {
        Result<SelectedVariant, Shared<Rejection>>.Success {value: selectedVariant} => move selectedVariant
        Result<SelectedVariant, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      if variant.shape.braces { return run bodyRejection(&resolver.*, module, RejectionCode.MissingStructInitializer, span) }
      return run checkVariantConstruct(
        &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
        expression, Result<SelectedVariant, Shared<Rejection>>.succeed(move variant), Range.empty(),
        expected, mismatchCode, constraints, contractBody, false, unsafeAllowed, span,
      )
    }
  }
  // A qualified constant is a declaration selection, not a runtime namespace value. Preserve
  // enum and unit-variant construction above, then read the constant at its declared type.
  let constantSelection = run resolvedCall(calls, expression)
  if let Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} = move constantSelection {
    if let Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Constant {declaration, ty: constantType}} = move value {
      let read = run constantRead(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, move declaration, span, false)
      let form = match move read {
        Result<BodyExpression, Shared<Rejection>>.Success {value: selected} => move selected
        Result<BodyExpression, Shared<Rejection>>.Failure {error} => {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
        }
      }
      let index = List<BodyNode>.length(&nodes.*)
      run List<BodyNode>.append(&mut nodes.*, BodyNode {
        origin: run originAt(cursor, expression, span),
        kind: BodyNodeKind.Expression {ty: move constantType, form: move form},
      })
      return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
        BodyNodeId {index: index}, expected, mismatchCode, span)
    }
  }
  // A type reached through a module name (`inflate.Format`) has no value; its subject is the
  // module, so report the qualified name's own refusal rather than check the module as a value.
  if let Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value: Result<ResolvedTarget, Shared<Rejection>>.Failure {error}} = move run resolvedCall(calls, expression) {
    if Shared<Rejection>.with<bool>(&error, fn(found: &Rejection) -> bool { return found.code == RejectionCode.ModuleQualifiedType }) {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, subject, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
    constraints, contractBody, false, unsafeAllowed)
  let subjectNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  return run projectFieldValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut signatures.*, &mut requiredBodies.*, constraints,
    &mut nodes.*, expression, subject, field, span, subjectNode, expected, mismatchCode, contractBody, false, unsafeAllowed)
}

// Field expressions and field invocation share privacy, reference dereference and applied
// member typing, while retaining the subject node supplied by the owning expression checker. A
// missing field may name a receiver method, which binds the dereferenced subject.
effect fn projectFieldValue<'scope>(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  request: &mut Request, dependencies: &mut List<Dependency>, module: &ModuleId,
  cursor: &AuthoredCursor, caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall],
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, constraints: &[Constraint],
  nodes: &mut List<BodyNode>, expression: HirId, subject: HirId, field: HirId, span: Span, checkedSubject: BodyNodeId,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, contractBody: bool, staticBody: bool, unsafeAllowed: bool)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut subjectNode = checkedSubject
  let subjectEvidence = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &subjectNode)
  let mut subjectType = match move subjectEvidence {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  }
  let mut referent = Shared<Type>.with<Option<Shared<Type>>>(&subjectType,
    fn(value: &Type) -> Option<Shared<Type>> {
      return match &value.* {
        Type.Reference {referent: pointee, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&pointee))
        _ => Option<Shared<Type>>.none()
      }
    },
  )
  while true {
    let value = match move referent {
      Option<Shared<Type>>.Some {value: selected} => move selected
      Option<Shared<Type>>.None => { break }
    }
    let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
    run List<BodyNode>.append(&mut nodes.*, BodyNode {
      origin: run bodyOrigin(&resolver.source, cursor, subject),
      kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&value),
        form: BodyExpression.Dereference {value: subjectNode}},
    })
    subjectNode = node
    subjectType = move value
    referent = Shared<Type>.with<Option<Shared<Type>>>(&subjectType,
      fn(value: &Type) -> Option<Shared<Type>> {
        return match &value.* {
          Type.Reference {referent: pointee, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&pointee))
          _ => Option<Shared<Type>>.none()
        }
      },
    )
  }
  if Shared<Type>.with<bool>(&subjectType, fn(value: &Type) -> bool {
    return match &value.* { Type.Parameter {..} => true
      _ => false
    }
  }) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let name = match run bodyNode(&resolver.source, cursor, field) {
    Node.Name {text} => run bodyText(&resolver.source, cursor, text)
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.UnknownProjectedField, span) }
  }
  let fieldSpan = run bodySpan(&resolver.source, cursor, field)
  if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&subjectType) {
    if !same(Bytes.asSlice(&name), b"length") {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run lengthFieldRejection(module, fieldSpan, &subjectType, Bytes.asSlice(&name)))
    }
    let lengthType = run primitiveType(b"usize")
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if !run Type.equalsShared(&lengthType, &value) { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
    }
    let index = List<BodyNode>.length(&nodes.*)
    run List<BodyNode>.append(&mut nodes.*, BodyNode {
      origin: run originAt(cursor, expression, span),
      kind: BodyNodeKind.Expression {ty: move lengthType, form: BodyExpression.ArrayLength {value: subjectNode, count: array.length}},
    })
    return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
  }
  if let Option<Shared<Type>>.Some {value: element} = move Type.sliceElement(&subjectType) {
    if !same(Bytes.asSlice(&name), b"length") {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(run lengthFieldRejection(module, fieldSpan, &subjectType, Bytes.asSlice(&name)))
    }
    let lengthType = run primitiveType(b"usize")
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if !run Type.equalsShared(&lengthType, &value) { return run bodyRejection(&resolver.*, module, mismatchCode, span) }
    }
    let index = List<BodyNode>.length(&nodes.*)
    run List<BodyNode>.append(&mut nodes.*, BodyNode {
      origin: run originAt(cursor, expression, span),
      kind: BodyNodeKind.Expression {ty: move lengthType, form: BodyExpression.SliceLength {value: subjectNode}},
    })
    return Result<BodyNodeId, Shared<Rejection>>.succeed(BodyNodeId {index: index})
  }
  let selected = run checkedRecordMember(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, &subjectType, Bytes.asSlice(&name), fieldSpan, FieldLookupPurpose.Projection)
  let member = match move selected {
    Result<CheckedRecordMember, Shared<Rejection>>.Success {value} => move value
    Result<CheckedRecordMember, Shared<Rejection>>.Failure {error} => {
      return run checkBoundMethod(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
        caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, subject,
        span, fieldSpan, subjectNode, &subjectType, Bytes.asSlice(&name), expected, mismatchCode, constraints, contractBody, staticBody,
        unsafeAllowed, move error)
    }
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&member.ty),
      form: BodyExpression.Field {value: subjectNode, index: member.index, declared: move member.ty}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*,
    BodyNodeId {index: index}, expected, mismatchCode, span)
}

struct CheckedScalarPattern {
  pattern: BodyPattern,
  ordinal: usize,
}

// SEM0161 names the pattern's own type `owner` and the subject's enum; SEM0162 names the integer
// pattern `owner` and the enum.
effect fn enumPatternRejection(
  resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span, subjectType: &Shared<Type>,
  owner: &[u8], member: &[u8],
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(code, module, span)
  if let Option<Bytes>.Some {value: subject} = move run TypeText.display(subjectType, module) {
    if code == RejectionCode.ForeignEnumPattern {
      run vectorArgument(&mut diagnostic, b"expected", Bytes.asSlice(&subject))
      run vectorArgument(&mut diagnostic, b"actual", owner)
      run vectorArgument(&mut diagnostic, b"member", member)
    } else if owner.length != usize.ZERO {
      let name = run unqualifiedName(Bytes.asSlice(&subject))
      run vectorArgument(&mut diagnostic, b"enum_", Bytes.asSlice(&name))
      run vectorArgument(&mut diagnostic, b"value", owner)
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// A scalar-enum match pattern is the universal pattern or one not yet covered member of the subject.
effect fn checkScalarEnumPattern(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  pattern: HirId,
  patternSpan: Span,
  subjectType: &Shared<Type>,
  covering: &[Option<Span>],
) -> Result<CheckedScalarPattern, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  return match run bodyNode(&resolver.source, cursor, pattern) {
    Node.UniversalPattern {name} => {
      if name.present {
        return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(
          run reject(&resolver.*, module, RejectionCode.Unsupported, patternSpan),
        )
      }
      return Result<CheckedScalarPattern, Shared<Rejection>>.succeed(
        CheckedScalarPattern {pattern: BodyPattern.Universal, ordinal: usize.MAX},
      )
    }
    Node.EnumPattern {path} => {
      let written = run bodyPathPair(&resolver.source, cursor, path)
      let pair = match move written {
        Option<QualifiedBodyName>.Some {value} => move value
        Option<QualifiedBodyName>.None => {
          return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(
            run reject(&resolver.*, module, RejectionCode.Unsupported, patternSpan),
          )
        }
      }
      let selection = run checkedEnumSelection(&mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member), patternSpan, false)
      let selected = match move selection {
        Option<Result<EnumSelection, Shared<Rejection>>>.Some {value} => move value
        Option<Result<EnumSelection, Shared<Rejection>>>.None => {
          return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(
            run enumPatternRejection(&resolver.*, module, RejectionCode.ForeignEnumPattern, patternSpan, subjectType,
              Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member)),
          )
        }
      }
      let chosen = match move selected {
        Result<EnumSelection, Shared<Rejection>>.Success {value} => move value
        Result<EnumSelection, Shared<Rejection>>.Failure {error} => {
          return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(move error)
        }
      }
      if let EnumSelection.Member {ty: patternType, member} = move chosen {
        if !run Type.equalsShared(&patternType, subjectType) {
          let mut owner = run Bytes.copy(Bytes.asSlice(&pair.namespace))
          if let Option<Bytes>.Some {value: shown} = move run TypeText.display(&patternType, module) { owner = move shown }
          return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(
            run enumPatternRejection(&resolver.*, module, RejectionCode.ForeignEnumPattern, patternSpan, subjectType,
              Bytes.asSlice(&owner), Bytes.asSlice(&pair.member)),
          )
        }
        // A repeated unguarded member is reported at the later pattern, related to the first arm
        // that covered it (SEM0159).
        if let Option<Span>.Some {value: first} = &covering[member.ordinal] {
          let mut diagnostic = run makeRejection(RejectionCode.DuplicateEnumMatchArm, module, patternSpan)
          diagnostic.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: first})
          let mut written = run Bytes.copy(Bytes.asSlice(&pair.namespace))
          run Bytes.append(&mut written, b".")
          run Bytes.append(&mut written, Bytes.asSlice(&pair.member))
          run vectorArgument(&mut diagnostic, b"member", Bytes.asSlice(&written))
          return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
        }
        let ordinal = member.ordinal
        return Result<CheckedScalarPattern, Shared<Rejection>>.succeed(
          CheckedScalarPattern {pattern: BodyPattern.EnumMember {member: member}, ordinal: ordinal},
        )
      }
      return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(
        run enumPatternRejection(&resolver.*, module, RejectionCode.ForeignEnumPattern, patternSpan, subjectType,
          Bytes.asSlice(&pair.namespace), Bytes.asSlice(&pair.member)),
      )
    }
    Node.IntegerPattern {value} => {
      let mut written = Bytes.make()
      if let Node.IntegerLiteral {sign, magnitude, ..} = run bodyNode(&resolver.source, cursor, value) {
        if sign == Sign.Negative { run Bytes.append(&mut written, b"-") }
        let digits = run bodyText(&resolver.source, cursor, magnitude)
        run Bytes.append(&mut written, Bytes.asSlice(&digits))
      }
      return Result<CheckedScalarPattern, Shared<Rejection>>.failResult(
        run enumPatternRejection(&resolver.*, module, RejectionCode.IntegerPatternOnEnum, patternSpan, subjectType,
          Bytes.asSlice(&written), b""),
      )
    }
    _ => Result<CheckedScalarPattern, Shared<Rejection>>.failResult(
      run reject(&resolver.*, module, RejectionCode.Unsupported, patternSpan),
    )
  }
}

// A match guard must be a bool expression.
effect fn checkMatchGuard<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  guard: HirId,
  constraints: &[Constraint],
  contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let tested = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*,
    &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, guard, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch,
    constraints, contractBody, false, unsafeAllowed)
  let guardNode = match move tested {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(move error)
    }
  }
  let guardType = bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &guardNode)
  let boolean = run primitiveType(b"bool")
  // A guard that always exits, such as a match whose arms return, is `never` (any type).
  let isBoolean = match &guardType {
    Option<Shared<Type>>.Some {value} => (run Type.equalsShared(&value, &boolean)) || Shared<Type>.with<bool>(&value, neverType)
    Option<Shared<Type>>.None => false
  }
  if !isBoolean {
    return run guardTypeRejection(&resolver.*, module, run bodySpan(&resolver.source, cursor, guard), &guardType)
  }
  return Result<BodyNodeId, Shared<Rejection>>.succeed(guardNode)
}

// The success, failure and requirement channels of a runnable operand, or absence for a value
// that is not an Effect (EFF-003).
struct EffectChannels {
  success: Shared<Type>,
  failure: Shared<Type>,
  requirements: Shared<Row>,
}

fn effectChannels(value: &Type) -> Option<EffectChannels> {
  return match &value.* {
    Type.Effect {success, failure, requirements, ..} => Option<EffectChannels>.some(EffectChannels {
      success: Shared<Type>.clone(&success), failure: Shared<Type>.clone(&failure), requirements: Shared<Row>.clone(&requirements),
    })
    Type.CallableValue {contract, ..} => Shared<Type>.with<Option<EffectChannels>>(&contract, effectChannels)
    // An `effect fn` interface construction promises its operation's applied contract.
    Type.CallableWitnessResult {witness} => Shared<WitnessRecipe>.with<Option<EffectChannels>>(&witness,
      fn(recipe: &WitnessRecipe) -> Option<EffectChannels> { return Shared<Type>.with<Option<EffectChannels>>(&recipe.result, effectChannels) })
    Type.EffectComposite {contract, ..} => Shared<Type>.with<Option<EffectChannels>>(&contract, effectChannels)
    Type.EffectJoin {contract, ..} => Shared<Type>.with<Option<EffectChannels>>(&contract, effectChannels)
    // A producer's Effect family runs through its contract; its storage is realized at layout.
    Type.OpaqueRepresentation {contract, ..} => Shared<Type>.with<Option<EffectChannels>>(&contract, effectChannels)
    _ => Option<EffectChannels>.none()
  }
}

// A representation parameter runs through the Effect use contract its bound names.
effect fn runnableChannels(ty: &Shared<Type>, constraints: &[Constraint]) -> Option<EffectChannels>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let direct = Shared<Type>.with<Option<EffectChannels>>(ty, effectChannels)
  if let Option<EffectChannels>.Some {value} = move direct {
    return Option<EffectChannels>.some(move value)
  }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      if run Type.equalsShared(ty, &parameter) {
        let bound = Shared<Type>.with<Option<EffectChannels>>(&contract, effectChannels)
        if let Option<EffectChannels>.Some {value} = move bound {
          return Option<EffectChannels>.some(move value)
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<EffectChannels>.none()
}

// A copy of the channels of the innermost body being checked; a body outside every Effect has
// none.
effect fn currentBodyChannels(resolver: &Resolver) -> BodyFrame ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let bodies = List<BodyFrame>.asSlice(&resolver.bodies)
  if bodies.length == usize.ZERO {
    return BodyFrame {isEffect: false, isTest: false, failure: run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
      requirements: run Shared<Row>.make(Row.empty()), derived: Option<DerivedChannels>.none(),
      occurrences: List<StaticIteration>.make(), staticApplication: Option<Application>.none(), staticPrefixes: List<List<StaticPrefixWork>>.make(), recovered: List<Shared<Rejection>>.make(), failedStatements: List<FailedStatement>.make(), shortened: List<Span>.make(), signature: Option<Shared<Result<Answer, NoRejection>>>.none(), root: false, runOperand: Option<HirId>.none(), naming: Option<AuthoredCursor>.none()}
  }
  let current = &bodies[bodies.length - usize.ONE]
  return BodyFrame {isEffect: current.isEffect, isTest: current.isTest, failure: Shared<Type>.clone(&current.failure),
    requirements: Shared<Row>.clone(&current.requirements), derived: Option<DerivedChannels>.none(),
    occurrences: List<StaticIteration>.make(), staticApplication: Option<Application>.none(), staticPrefixes: List<List<StaticPrefixWork>>.make(), recovered: List<Shared<Rejection>>.make(), failedStatements: List<FailedStatement>.make(), shortened: List<Span>.make(), signature: Option<Shared<Result<Answer, NoRejection>>>.none(), root: false, runOperand: Option<HirId>.none(), naming: Option<AuthoredCursor>.none()}
}

// Whether the innermost body derives its channels from its `return`, `fail` and `run` sites.
fn derivingBody(resolver: &Resolver) -> bool {
  let bodies = List<BodyFrame>.asSlice(&resolver.bodies)
  if bodies.length == usize.ZERO { return false }
  return match &bodies[bodies.length - usize.ONE].derived { Option<DerivedChannels>.Some {..} => true _ => false }
}

// A failure or requirement row on a function that is not an `effect fn` (SEM0062), saying which
// qualifier lets it declare one.
effect fn channelOnOrdinaryRejection(module: &ModuleId, span: Span, isTest: bool, channel: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.EffectChannelOnOrdinary, module, span)
  let mut written: &'static [u8] = b"fn"
  let mut qualifier: &'static [u8] = b"effect fn"
  if isTest {
    written = b"test fn"
    qualifier = b"test effect fn"
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"channel"), value: run Bytes.copy(channel)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"qualifier"), value: run Bytes.copy(qualifier)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"written"), value: run Bytes.copy(written)})
  return run Shared<Rejection>.make(move diagnostic)
}

// Whether the function `key` names is written `test fn`.
fn declaredTest(resolver: &Resolver, sourceAnswer: &Shared<Result<SourceResult, NoRejection>>, module: &ModuleId, key: Key) -> bool {
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(resolver, sourceAnswer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let position = declarationPosition(resolver, key)
    if position >= declarations.length { return false }
    let hir = IndexedSource.authored(indexed)
    if let Node.FunctionHeader {contract, ..} = Module.node(hir, declarations[position].header) {
      if let Node.CallableContract {isTest, ..} = Module.node(hir, contract) { return isTest }
    }
  }
  return false
}

// Marks the innermost frame as the body of a `test fn`.
effect fn markTestBody(resolver: &mut Resolver) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = List<BodyFrame>.pop(&mut resolver.*.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut current = move value
    current.isTest = true
    run List<BodyFrame>.append(&mut resolver.*.bodies, move current)
  }
  return ()
}

// Makes `operand` the innermost frame's `run` operand, returning the one it replaces.
effect fn replaceRunOperand(resolver: &mut Resolver, operand: Option<HirId>) -> Option<HirId> ! OutOfMemoryError ? &mut Allocator {
  let popped = List<BodyFrame>.pop(&mut resolver.*.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut current = move value
    let previous = match &current.runOperand {
      Option<HirId>.Some {value: written} => Option<HirId>.some(HirId {index: written.index})
      Option<HirId>.None => Option<HirId>.none()
    }
    current.runOperand = move operand
    run List<BodyFrame>.append(&mut resolver.*.bodies, move current)
    return move previous
  }
  return Option<HirId>.none()
}

// Whether the innermost frame's `run` consumes the expression at `expression` in place.
fn runsInPlace(resolver: &Resolver, expression: HirId) -> bool {
  let bodies = List<BodyFrame>.asSlice(&resolver.bodies)
  if bodies.length == usize.ZERO { return false }
  return match &bodies[bodies.length - usize.ONE].runOperand {
    Option<HirId>.Some {value} => value.index == expression.index
    Option<HirId>.None => false
  }
}

// Whether typing may admit `pairs`, the region relations it could not prove. Inside a body it may:
// that body's region check relates the regions itself. Outside a body nothing would.
fn relationsAdmitted(resolver: &Resolver, pairs: &[RegionPair]) -> bool {
  return pairs.length == usize.ZERO || List<BodyFrame>.length(&resolver.bodies) != usize.ZERO
}

// Records one site of a deriving body: a returned type, a `fail` operand's type, or a run's
// failure and requirements.
effect fn deriveChannels(resolver: &mut Resolver, returned: Option<Shared<Type>>, failed: Option<Shared<Type>>,
  ranFailure: Option<Shared<Type>>, ranRequirements: Option<Shared<Row>>) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let popped = List<BodyFrame>.pop(&mut resolver.*.bodies)
  let mut current = match move popped {
    Option<BodyFrame>.Some {value} => move value
    Option<BodyFrame>.None => { return () }
  }
  if let Option<DerivedChannels>.Some {value: derived} = &mut current.derived {
    if let Option<Shared<Type>>.Some {value} = move returned { run List<Shared<Type>>.append(&mut derived.returns, move value) }
    if let Option<Shared<Type>>.Some {value} = move failed {
      run appendMembers(&mut derived.failures, &value)
      run List<Shared<Type>>.append(&mut derived.failed, move value)
    }
    if let Option<Shared<Type>>.Some {value} = move ranFailure { run appendMembers(&mut derived.failures, &value) }
    if let Option<Shared<Row>>.Some {value} = move ranRequirements { run Row.merge(&mut derived.requirements, &value) }
  }
  return run List<BodyFrame>.append(&mut resolver.*.bodies, move current)
}

// The members of a failure type: a structural union's, none for `never`, otherwise itself.
effect fn failureMembers(value: &Shared<Type>) -> List<Shared<Type>> ! OutOfMemoryError ? &mut Allocator {
  if Shared<Type>.with<bool>(value, neverType) { return List<Shared<Type>>.make() }
  let listed = run Type.canonicalUnionMembers(value)
  if let Option<List<Shared<Type>>>.Some {value: members} = move listed { return move members }
  let mut single = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut single, Shared<Type>.clone(value))
  return move single
}

// The canonical join of member sets: `never` when empty, the member when single, else a union.
effect fn joinedType(members: List<Shared<Type>>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut joined = List<Shared<Type>>.make()
  let listed = List<Shared<Type>>.asSlice(&members)
  let mut at = usize.ZERO
  while at < listed.length {
    run Type.joinMember(&mut joined, &listed[at])
    at = at + usize.ONE
  }
  if List<Shared<Type>>.length(&joined) == usize.ONE {
    let single = List<Shared<Type>>.asSlice(&joined)
    return Shared<Type>.clone(&single[usize.ZERO])
  }
  return run Types.intern(Type.Union {members: move joined})
}

effect fn appendMembers(output: &mut List<Shared<Type>>, value: &Shared<Type>) -> () ! OutOfMemoryError ? &mut Allocator {
  let members = run failureMembers(value)
  let listed = List<Shared<Type>>.asSlice(&members)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Shared<Type>>.append(&mut output.*, Shared<Type>.clone(&listed[at]))
    at = at + usize.ONE
  }
  return ()
}

effect fn channelRejection(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span)
-> Result<EffectChannels, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  return Result<EffectChannels, Shared<Rejection>>.failResult(run reject(resolver, module, code, span))
}

fn unitShape(value: &Type) -> bool {
  return match &value.* { Type.Unit => true _ => false }
}

// The channels of the Effect a callable returns when it is lent `&mut resource`.
effect fn lentChannels(callable: &Shared<Type>, resource: &Shared<Type>, constraints: &[Constraint]) -> Option<EffectChannels>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let contract = match move run valueCallableContract(callable, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return Option<EffectChannels>.none() }
  }
  let shape = run Type.copy(&contract)
  if let Type.Callable {parameters, result, ..} = move shape {
    let accepted = List<Shared<Type>>.asSlice(&parameters)
    if accepted.length != usize.ONE { return Option<EffectChannels>.none() }
    let lent = run Type.copy(&accepted[usize.ZERO])
    // The loan is quantified per invocation (`for<'scope>`), never a fixed or caller region.
    if let Type.Reference {referent, access, lifetime} = move lent {
      let quantified = Shared<Lifetime>.with<bool>(&lifetime, fn(value: &Lifetime) -> bool {
        return match &value.* { Lifetime.Invocation {..} => true _ => false }
      })
      if access == Access.Mutable && quantified && run Type.equalsShared(&referent, resource) { return Shared<Type>.with<Option<EffectChannels>>(&result, effectChannels) }
    }
  }
  return Option<EffectChannels>.none()
}

// The channels of a finalizer composition: the protected Effect's success and failure, and both
// requirement rows. The finalizer is `() ! never`; written arguments, when present, name exactly
// `[Resource,] A, E, R, S` (D4).
effect fn finalizedChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operation: Composition, operands: &[Shared<Type>], written: &[Argument], constraints: &[Constraint], span: Span)
-> Result<EffectChannels, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let lends = operation == Composition.UseRelease
  let mut protectedAt = usize.ZERO
  if lends { protectedAt = usize.ONE }
  let finalizerAt = protectedAt + usize.ONE
  let protectedSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, protectedAt))
  let finalizerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, finalizerAt))
  let mut protected = Option<EffectChannels>.none()
  let mut finalizer = Option<EffectChannels>.none()
  let mut code = RejectionCode.RunNonEffect
  if lends {
    protected = run lentChannels(&operands[protectedAt], &operands[usize.ZERO], constraints)
    finalizer = run lentChannels(&operands[finalizerAt], &operands[usize.ZERO], constraints)
    code = RejectionCode.TypeMismatch
  } else {
    protected = run runnableChannels(&operands[protectedAt], constraints)
    finalizer = run runnableChannels(&operands[finalizerAt], constraints)
  }
  let kept = match move protected {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, code, protectedSpan) }
  }
  let cleanup = match move finalizer {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, code, finalizerSpan) }
  }
  if !Shared<Type>.with<bool>(&cleanup.success, unitShape) || !Shared<Type>.with<bool>(&cleanup.failure, neverType) {
    return run channelRejection(resolver, module, RejectionCode.TypeMismatch, finalizerSpan)
  }
  if written.length != usize.ZERO {
    let mut derived = List<Argument>.make()
    if lends { run List<Argument>.append(&mut derived, Argument.Type {value: Shared<Type>.clone(&operands[usize.ZERO])}) }
    run List<Argument>.append(&mut derived, Argument.Type {value: Shared<Type>.clone(&kept.success)})
    run List<Argument>.append(&mut derived, Argument.Type {value: Shared<Type>.clone(&kept.failure)})
    run List<Argument>.append(&mut derived, Argument.Row {value: Shared<Row>.clone(&kept.requirements)})
    run List<Argument>.append(&mut derived, Argument.Row {value: Shared<Row>.clone(&cleanup.requirements)})
    if !sameArguments(written, List<Argument>.asSlice(&derived)) {
      return run channelRejection(resolver, module, RejectionCode.TypeMismatch, span)
    }
  }
  let mut requirements = Row.empty()
  run Row.merge(&mut requirements, &kept.requirements)
  run Row.merge(&mut requirements, &cleanup.requirements)
  return Result<EffectChannels, Shared<Rejection>>.succeed(EffectChannels {success: move kept.success, failure: move kept.failure,
    requirements: run Shared<Row>.make(move requirements)})
}

effect fn compositionChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operation: Composition, operands: &[Shared<Type>], written: &[Argument], selector: &Shared<Type>, constraints: &[Constraint],
  span: Span) -> Result<EffectChannels, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if operation == Composition.CatchFailure {
    return run caughtChannels(resolver, module, cursor, arguments, operands, selector, constraints)
  }
  if operation == Composition.Suspend {
    // Suspension keeps the deferred child's channels exactly (SUSP-005).
    return match move run runnableChannels(&operands[usize.ZERO], constraints) {
      Option<EffectChannels>.Some {value} => Result<EffectChannels, Shared<Rejection>>.succeed(move value)
      Option<EffectChannels>.None => run channelRejection(resolver, module, RejectionCode.RunNonEffect,
        run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO)))
    }
  }
  if operation == Composition.Observe {
    return run observedChannels(resolver, module, cursor, arguments, operands, written, constraints, span)
  }
  return run finalizedChannels(resolver, module, cursor, arguments, operation, operands, written, constraints, span)
}

// Whether `value` is the primitive named `name`.
fn primitiveNamed(value: &Type, name: &[u8]) -> bool {
  return match &value.* { Type.Primitive {name: spelled} => same(Bytes.asSlice(&spelled), name) _ => false }
}

fn stringType(value: &Type) -> bool {
  return match &value.* { Type.String {..} => true _ => false }
}

// The observer callback's contract `fn(&mut S, u8, usize, usize, string, string) -> usize`.
effect fn observerCallback(callback: &Shared<Type>, state: &Shared<Type>, constraints: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let contract = match move run valueCallableContract(callback, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return false }
  }
  let parts = run Type.copy(&contract)
  if let Type.Callable {parameters, result, ..} = move parts {
    let listed = List<Shared<Type>>.asSlice(&parameters)
    if listed.length != 6 || !Shared<Type>.with<bool>(&result, fn(value: &Type) -> bool { return primitiveNamed(value, b"usize") }) {
      return false
    }
    let receiver = Shared<Type>.with<Option<Shared<Type>>>(&listed[usize.ZERO], fn(value: &Type) -> Option<Shared<Type>> {
      return match &value.* {
        Type.Reference {referent, access, ..} => {
          if access != Access.Mutable { return Option<Shared<Type>>.none() }
          return Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
        }
        _ => Option<Shared<Type>>.none()
      }
    })
    let lent = match move receiver { Option<Shared<Type>>.Some {value} => move value Option<Shared<Type>>.None => { return false } }
    let same = run Type.equalsShared(&lent, state)
    return same &&
      Shared<Type>.with<bool>(&listed[usize.ONE], fn(value: &Type) -> bool { return primitiveNamed(value, b"u8") }) &&
      Shared<Type>.with<bool>(&listed[2], fn(value: &Type) -> bool { return primitiveNamed(value, b"usize") }) &&
      Shared<Type>.with<bool>(&listed[3], fn(value: &Type) -> bool { return primitiveNamed(value, b"usize") }) &&
      Shared<Type>.with<bool>(&listed[4], stringType) && Shared<Type>.with<bool>(&listed[5], stringType)
  }
  return false
}

// The channels of `observeDiagnostics<S, A, R, F>(state, callback, body)`: the body's, whose
// failure row is empty, so no failure leaves an observation (failure observer note N1).
effect fn observedChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operands: &[Shared<Type>], written: &[Argument], constraints: &[Constraint], span: Span)
-> Result<EffectChannels, Shared<Rejection>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let callbackSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ONE))
  let bodySpanned = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, 2))
  let observed = match move run runnableChannels(&operands[2], constraints) {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, RejectionCode.RunNonEffect, bodySpanned) }
  }
  if !Shared<Type>.with<bool>(&observed.failure, neverType) {
    return run channelRejection(resolver, module, RejectionCode.TypeMismatch, bodySpanned)
  }
  if !run observerCallback(&operands[usize.ONE], &operands[usize.ZERO], constraints) {
    return run channelRejection(resolver, module, RejectionCode.TypeMismatch, callbackSpan)
  }
  if written.length != usize.ZERO {
    let mut derived = List<Argument>.make()
    run List<Argument>.append(&mut derived, Argument.Type {value: Shared<Type>.clone(&operands[usize.ZERO])})
    run List<Argument>.append(&mut derived, Argument.Type {value: Shared<Type>.clone(&observed.success)})
    run List<Argument>.append(&mut derived, Argument.Row {value: Shared<Row>.clone(&observed.requirements)})
    run List<Argument>.append(&mut derived, Argument.Type {value: Shared<Type>.clone(&operands[usize.ONE])})
    if !sameArguments(written, List<Argument>.asSlice(&derived)) {
      return run channelRejection(resolver, module, RejectionCode.TypeMismatch, span)
    }
  }
  return Result<EffectChannels, Shared<Rejection>>.succeed(move observed)
}

// The channels of `catchFailure<S>`: the protected or handler success, the residual and handler
// failures, and both requirement rows.
effect fn caughtChannels(resolver: &Resolver, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operands: &[Shared<Type>], selector: &Shared<Type>, constraints: &[Constraint]) -> Result<EffectChannels, Shared<Rejection>>
! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let protectedSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO))
  let handlerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ONE))
  let protected = match move run runnableChannels(&operands[usize.ZERO], constraints) {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, RejectionCode.RunNonEffect, protectedSpan) }
  }
  // The handler is invoked with one selected failure and returns the Effect that recovers it.
  let handlerContract = match move run valueCallableContract(&operands[usize.ONE], constraints) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return run channelRejection(resolver, module, RejectionCode.InvalidEffectHandler, handlerSpan) }
  }
  let chosen = run invokedSchemaContract(&operands[usize.ONE], &handlerContract, selector)
  let handlerParts = run Type.copy(&chosen)
  let mut recovered = Option<EffectChannels>.none()
  let mut accepts = false
  if let Type.Callable {parameters, result, ..} = move handlerParts {
    let accepted = List<Shared<Type>>.asSlice(&parameters)
    if accepted.length == usize.ONE { accepts = run Type.equalsShared(&accepted[usize.ZERO], selector) }
    recovered = Shared<Type>.with<Option<EffectChannels>>(&result, effectChannels)
  }
  let recovery = match move recovered {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return run channelRejection(resolver, module, RejectionCode.InvalidEffectHandler, handlerSpan) }
  }
  // `S` must be a nonempty subset of the protected failure members, known directly or through a
  // declared `S in E` premise; the nonselected members propagate as `Without<E, S>` (FAIL-005).
  let selected = run failureMembers(selector)
  let mut covered = run Type.coversFailure(&protected.failure, selector)
  if !covered { covered = run declaredFailureSubset(constraints, selector, &protected.failure) }
  if List<Shared<Type>>.length(&selected) == usize.ZERO || !covered {
    return Result<EffectChannels, Shared<Rejection>>.failResult(
      run selectedFailureRejection(module, handlerSpan, selector, &protected.failure))
  }
  if !accepts {
    return run channelRejection(resolver, module, RejectionCode.InvalidEffectHandler, handlerSpan)
  }
  let mut residual = List<Shared<Type>>.make()
  let propagated = run Type.without(&protected.failure, selector)
  run appendMembers(&mut residual, &propagated)
  run appendMembers(&mut residual, &recovery.failure)
  let mut successes = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut successes, Shared<Type>.clone(&protected.success))
  run List<Shared<Type>>.append(&mut successes, Shared<Type>.clone(&recovery.success))
  let mut requirements = Row.empty()
  run Row.merge(&mut requirements, &protected.requirements)
  run Row.merge(&mut requirements, &recovery.requirements)
  return Result<EffectChannels, Shared<Rejection>>.succeed(EffectChannels {success: run joinedType(move successes),
    failure: run joinedType(move residual), requirements: run Shared<Row>.make(move requirements)})
}

// Whether a declared `where selected in source` premise names exactly these failure types.
effect fn declaredFailureSubset(constraints: &[Constraint], selected: &Shared<Type>, source: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.FailureSubset {selected: declared, source: declaredSource} = &constraints[at] {
      let sameSelected = run Type.equalsShared(&declared, selected)
      if sameSelected {
        if run Type.equalsShared(&declaredSource, source) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// `Intrinsic.catchFailure<S>(protected, handler)` builds the exact Effect that runs `protected`
// and recovers its failures in `S` through `handler`; other failures stay residual (FAIL-005, D4).
// A finalizer composition keeps the protected outcome and runs a `() ! never` finalizer on every
// exit; `useReleaseNonParking(resource, use, release)` lends the owned resource to both callables.
effect fn checkComposition<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, expression: HirId,
  span: Span, operation: Composition, written: List<Argument>, arguments: CallArguments, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut count = usize.ONE + usize.ONE
  if operation == Composition.UseRelease || operation == Composition.Observe { count = count + usize.ONE }
  if operation == Composition.Suspend { count = usize.ONE }
  if CallArguments.length(arguments) != count { return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span) }
  let mut parts = List<BodyNodeId>.make()
  let mut types = List<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < count {
    let argument = run bodyArgument(&resolver.source, cursor, arguments, at)
    let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argument,
      &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    let ty = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    }
    // A stored part is moved into the composite unless it is Copy, like a closure capture.
    let mut part = node
    if checkedPlace(List<BodyNode>.asSlice(&nodes.*), node) && !movedBodyValue(List<BodyNode>.asSlice(&nodes.*), node) {
      let argumentSpan = run bodySpan(&resolver.source, cursor, argument)
      let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, argumentSpan) {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      if !copied {
        let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
          List<BodyNode>.asSlice(&nodes.*), node, false, false, argumentSpan, argumentSpan, constraints) {
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
          Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        part = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
        run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, argument, argumentSpan),
          kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&ty), form: BodyExpression.Move {value: node, consumed: move consumed}}})
      }
    }
    run List<BodyNodeId>.append(&mut parts, part)
    run List<Shared<Type>>.append(&mut types, move ty)
    at = at + usize.ONE
  }
  let operands = List<Shared<Type>>.asSlice(&types)
  // A finalizer composition selects no failure: its selector is `never`.
  let mut selector = run Types.intern(Type.Union {members: List<Shared<Type>>.make()})
  let listed = List<Argument>.asSlice(&written)
  if operation == Composition.CatchFailure {
    if let Argument.Type {value} = &listed[usize.ZERO] { selector = Shared<Type>.clone(&value) }
  }
  let mut composed = Result<EffectChannels, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  if bindingComposition(operation) {
    if listed.length != usize.ZERO {
      if let Argument.Row {value: keys} = &listed[usize.ZERO] { selector = run selectorCarrier(&keys) }
    }
    composed = run bindingChannels(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, arguments, operation,
      &mut selector, listed.length == usize.ZERO, operands, constraints)
  } else {
    composed = run compositionChannels(&resolver.*, module, cursor, arguments, operation, operands, listed, &selector,
      constraints, span)
  }
  let channels = match move composed {
    Result<EffectChannels, Shared<Rejection>>.Success {value} => move value
    Result<EffectChannels, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let mut regions = List<Shared<Lifetime>>.make()
  at = usize.ZERO
  while at < count {
    if !run captureRetainedRegions(&operands[at], caller, run anchoredNode(cursor, expression), constraints, &mut regions) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    at = at + usize.ONE
  }
  let contract = run Types.intern(Type.Effect {mode: CallableMode.Once,
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&regions))),
    success: move channels.success, failure: move channels.failure, requirements: move channels.requirements})
  let ty = run Types.intern(Type.EffectComposite {operation: operation, selector: move selector, parts: move types,
    contract: move contract})
  let ordered = List<BodyNodeId>.asSlice(&parts)
  let mut fields = List<BodyAggregateField>.make()
  at = usize.ZERO
  while at < count {
    run List<BodyAggregateField>.append(&mut fields, BodyAggregateField {index: at, value: ordered[at]})
    at = at + usize.ONE
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty,
    BodyExpression.Aggregate {fields: move fields, written: List<Shared<Lifetime>>.make(), section: Option<SectionRetention>.none()}, false, expected, mismatchCode, contractBody, false)
}

// A checked scalar operation's carrier offers its expected contract's exact parameters and result
// in any invocation mode. Like a stored composition part, it is moved into the call unless it is Copy.
effect fn carrierArgument(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, nodes: &mut List<BodyNode>,
  node: BodyNodeId, argument: HirId, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint]) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let argumentSpan = run bodySpan(&resolver.source, cursor, argument)
  let ty = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return CompilerBug.panic(b"MissingRetainedFact: carrierArgument") }
  }
  let contract = run valueCallableContract(&ty, constraints)
  let mut accepted = false
  if let Option<Shared<Type>>.Some {value: offered} = &contract {
    if let Option<Shared<Type>>.Some {value: wanted} = &expected.* { accepted = run carrierAccepts(&offered, &wanted) }
  }
  if !accepted { return run bodyRejection(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, argumentSpan) }
  if !checkedPlace(List<BodyNode>.asSlice(&nodes.*), node) || movedBodyValue(List<BodyNode>.asSlice(&nodes.*), node) {
    return Result<BodyNodeId, Shared<Rejection>>.succeed(node)
  }
  let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, argumentSpan) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  if copied { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
  let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
    List<BodyNode>.asSlice(&nodes.*), node, false, false, argumentSpan, argumentSpan, constraints) {
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
    Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let moved = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, argument, argumentSpan),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.Move {value: node, consumed: move consumed}}})
  return Result<BodyNodeId, Shared<Rejection>>.succeed(moved)
}

// Whether an offered callable contract serves a carrier: a safe invocation with the same
// parameters and result. Any invocation mode can be invoked once by the call that owns it.
effect fn carrierAccepts(offered: &Shared<Type>, wanted: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let left = run Type.copy(offered)
  let right = run Type.copy(wanted)
  if let Type.Callable {parameters, result, isUnsafe, ..} = move left {
    if let Type.Callable {parameters: expected, result: produced, ..} = move right {
      let given = List<Shared<Type>>.asSlice(&parameters)
      let required = List<Shared<Type>>.asSlice(&expected)
      if isUnsafe || given.length != required.length || !run Type.equalsShared(&result, &produced) { return false }
      let mut at = usize.ZERO
      while at < given.length {
        if !run Type.equalsShared(&given[at], &required[at]) { return false }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

// A binding's selected key travels as the requirement row of a unit Effect, so substitution and
// runtime encoding treat it like any other row (`Type.EffectComposite.selector`).
effect fn selectorCarrier(row: &Shared<Row>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let none = List<Shared<Lifetime>>.make()
  return run Types.intern(Type.Effect {mode: CallableMode.Once,
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&none))),
    success: run Types.intern(Type.Unit), failure: run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
    requirements: Shared<Row>.clone(row)})
}

fn carriedRow(value: &Type) -> Option<Shared<Row>> {
  return match &value.* { Type.Effect {requirements, ..} => Option<Shared<Row>>.some(Shared<Row>.clone(&requirements)) _ => Option<Shared<Row>>.none() }
}

// The one service-role key a binding's selector carries.
effect fn carriedKey(selector: &Shared<Type>) -> Option<Requirement> ! OutOfMemoryError ? &mut Allocator {
  return match move Shared<Type>.with<Option<Shared<Row>>>(selector, carriedRow) {
    Option<Shared<Row>>.Some {value} => run selectorKey(&value)
    Option<Shared<Row>>.None => Option<Requirement>.none()
  }
}

// Whether a binding's provider part has the shape its intrinsic takes: a shared or exclusive
// borrow, or an owned value.
fn bindingProviderShape(operation: Composition, provider: &Type) -> bool {
  return match &provider.* {
    Type.Reference {access, ..} => operation == Composition.BindOwned || (operation == Composition.BindShared) == (access == Access.Shared)
    _ => operation == Composition.BindOwned
  }
}

// `Intrinsic.bindRequirement*<S>(inner, provider)` builds the exact Effect that runs `inner` with
// key `S` served by `provider` for that execution only (SERV-009, D2 rule 2). The provider must
// provide `S` from the inner row, which then loses the selected entry (SERV-008).
effect fn bindingChannels(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, arguments: CallArguments,
  operation: Composition, selector: &mut Shared<Type>, inferSelector: bool, operands: &[Shared<Type>], constraints: &[Constraint])
  -> Result<EffectChannels, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let innerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ZERO))
  let providerSpan = run bodySpan(&resolver.source, cursor, run bodyArgument(&resolver.source, cursor, arguments, usize.ONE))
  let inner = match move run runnableChannels(&operands[usize.ZERO], constraints) {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return run channelRejection(&resolver.*, module, RejectionCode.RunNonEffect, innerSpan) }
  }
  if !Shared<Type>.with<bool>(&operands[usize.ONE], fn(value: &Type) -> bool { return bindingProviderShape(operation, value) }) {
    return run channelRejection(&resolver.*, module, RejectionCode.TypeMismatch, providerSpan)
  }
  if inferSelector {
    // A partial source row or unresolved provider cannot decide the complete candidate set.
    // A written key remains available when the caller's provides premise proves it.
    if Row.hasOpenRuntimeParameters(&inner.requirements) || Type.hasOpenRuntimeParameters(&operands[usize.ONE]) {
      return run channelRejection(&resolver.*, module, RejectionCode.TypeArgumentInference, providerSpan)
    }
    let selected = run selectProvided(&mut resolver.*, &mut owner.*, &mut dependencies.*, &operands[usize.ONE],
      &Option<Requirement>.none(), &inner.requirements, constraints, module, providerSpan)
    let key = match move selected {
      Result<Requirement, Shared<Rejection>>.Success {value} => move value
      Result<Requirement, Shared<Rejection>>.Failure {error} => {
        return Result<EffectChannels, Shared<Rejection>>.failResult(move error)
      }
    }
    let mut inferred = Row.empty()
    run Row.require(&mut inferred, move key)
    let keys = run Shared<Row>.make(move inferred)
    selector.* = run selectorCarrier(&keys)
  }
  let keys = match move Shared<Type>.with<Option<Shared<Row>>>(&selector.*, carriedRow) {
    Option<Shared<Row>>.Some {value} => move value
    Option<Shared<Row>>.None => { return run channelRejection(&resolver.*, module, RejectionCode.Unsupported, providerSpan) }
  }
  let mut bounds = List<Constraint>.make()
  run List<Constraint>.append(&mut bounds, Constraint.Provides {provider: Shared<Type>.clone(&operands[usize.ONE]),
    selector: Shared<Row>.clone(&keys), source: Shared<Row>.clone(&inner.requirements)})
  let declared = run copyConstraints(constraints)
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    List<Constraint>.asSlice(&bounds), module, providerSpan, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<EffectChannels, Shared<Rejection>>.failResult(move value) }
  let mut residual = Row.empty()
  run Row.subtract(&mut residual, &inner.requirements, &keys)
  return Result<EffectChannels, Shared<Rejection>>.succeed(EffectChannels {success: move inner.success,
    failure: move inner.failure, requirements: run Shared<Row>.make(move residual)})
}

// `run` executes one Effect layer. Its residual failures and requirements must fit the enclosing
// body's channels (EFF-003, EFF-006, FAIL-003).
// The referent or element a storage operand borrows, with its access and region.
struct StorageView {
  target: Shared<Type>,
  access: Access,
  region: Shared<Lifetime>,
}

// The referent of a reference operand, or the element of a slice operand when `slice` is set.
effect fn storageView(value: &Shared<Type>, slice: bool) -> Option<StorageView> ! OutOfMemoryError ? &mut Allocator {
  return match move run Type.copy(value) {
    Type.Reference {referent, access, lifetime} => {
      if slice { return Option<StorageView>.none() }
      return Option<StorageView>.some(StorageView {target: move referent, access: access, region: move lifetime})
    }
    Type.Slice {element, access, lifetime} => {
      if !slice { return Option<StorageView>.none() }
      return Option<StorageView>.some(StorageView {target: move element, access: access, region: move lifetime})
    }
    _ => Option<StorageView>.none()
  }
}

// The region of a `string` operand.
effect fn storageText(value: &Shared<Type>) -> Option<Shared<Lifetime>> ! OutOfMemoryError ? &mut Allocator {
  return match move run Type.copy(value) {
    Type.String {lifetime} => Option<Shared<Lifetime>>.some(move lifetime)
    _ => Option<Shared<Lifetime>>.none()
  }
}

// Checks one storage primitive operand. An exact parameter type is the operand's context and is
// then required with the ordinary argument adaptations; a structural parameter has no context.
effect fn storageOperand<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  arguments: CallArguments, at: usize, context: Option<Shared<Type>>, constraints: &[Constraint], contractBody: bool,
  unsafeAllowed: bool, span: Span,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let argumentId = run bodyArgument(&resolver.source, cursor, arguments, at)
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, argumentId, &context, RejectionCode.TypeMismatch, constraints,
    contractBody, false, unsafeAllowed)
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  if let Option<Shared<Type>>.None = &context { return Result<BodyNodeId, Shared<Rejection>>.succeed(node) }
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*, node, &context, RejectionCode.TypeMismatch, span)
}

// The checked type of one operand node.
effect fn storageOperandType(resolver: &Resolver, module: &ModuleId, nodes: &List<BodyNode>, node: BodyNodeId, span: Span)
-> Result<Shared<Type>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  return match move bodyExpressionType(List<BodyNode>.asSlice(nodes), &node) {
    Option<Shared<Type>>.Some {value} => Result<Shared<Type>, Shared<Rejection>>.succeed(move value)
    Option<Shared<Type>>.None => CompilerBug.panic(b"MissingRetainedFact: storageOperandType")
  }
}

// The standard library's `Layout` record, which `layoutOf`, `sharedLayout` and
// `systemAllocationAcquire` exchange as the bootstrap's intrinsic contracts name it. Its storage must
// be exactly the byte count and then the alignment, both `usize`.
effect fn layoutDescriptor(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, span: Span) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let path = canonicalModule(&resolver.*, run PackageGraph.target(&resolver.packages, module, b"silk/layout.silk"))
  let loaded = run source(&mut resolver.*, &path)
  if let Option<&IndexedSource>.None = move sourceOf(&resolver.*, &loaded, &path) {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.MissingModule, span))
  }
  let ordinal = run internModule(&mut resolver.*, &path)
  let none = List<Binder>.make()
  let mut elision = LifetimeElision {
    owner: Option<DeclarationId>.none(), nextOrdinal: usize.ZERO, output: false,
    resultDefault: Option<Shared<Lifetime>>.none(), generated: List<Shared<Lifetime>>.make(), invocation: false,
    nested: false, renumber: List<usize>.make(), staticEnvironment: false,
    supplied: Option<List<Argument>>.none(), assumptions: Option<List<Constraint>>.none(), deferred: Option<List<DeferredBounds>>.none(),
  }
  let ty = match move run namedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, ordinal, module, b"Layout", true, span, span,
    Option<HirId>.none(), List<Binder>.asSlice(&none), &mut elision) {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let parts = match move run nominalParts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, span) {
    Result<List<Shared<Type>>, Shared<Rejection>>.Success {value} => move value
    Result<List<Shared<Type>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Type>, Shared<Rejection>>.failResult(move error) }
  }
  let word = run primitiveType(b"usize")
  let listed = List<Shared<Type>>.asSlice(&parts)
  if listed.length != 2 {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  let counted = run Type.equalsShared(&listed[usize.ZERO], &word)
  let aligned = run Type.equalsShared(&listed[usize.ONE], &word)
  if !counted || !aligned {
    return Result<Shared<Type>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Unsupported, span))
  }
  return Result<Shared<Type>, Shared<Rejection>>.succeed(move ty)
}

// The contract of `sharedWithMut`'s selected callback: `once fn(&mut T) -> A`, its exclusive input
// bound by the one invocation binder.
effect fn sharedAccessContract(element: &Shared<Type>, result: &Shared<Type>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let input = run Types.intern(Type.Reference {referent: Shared<Type>.clone(element), access: Access.Mutable,
    lifetime: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: usize.ZERO})})
  let mut parameters = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut parameters, move input)
  let none = List<Shared<Lifetime>>.make()
  return run Types.intern(Type.Callable {mode: CallableMode.Once, isUnsafe: false,
    environment: run Shared<Intersection>.make(run Intersection.of(List<Shared<Lifetime>>.asSlice(&none))),
    invocationBinders: usize.ONE, invocationUse: usize.MAX, invocationBounds: List<Outlives>.make(),
    parameters: move parameters, result: Shared<Type>.clone(result)})
}

// Checks one callable operand of `sharedWithMut`: a safe callable taking exactly `parameter` as
// `&mut T` (or nothing), and producing `result` or, for the conflict policy, `never`. An affine
// callable place must be moved into the call.
effect fn storageCallable(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, nodes: &List<BodyNode>, node: BodyNodeId,
  parameter: Option<Shared<Type>>, result: &Shared<Type>, divergent: bool, constraints: &[Constraint], span: Span)
-> Option<Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mismatch = Option<Shared<Rejection>>.some(run reject(&resolver.*, module, RejectionCode.TypeMismatch, span))
  let ty = match move bodyExpressionType(List<BodyNode>.asSlice(nodes), &node) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return move mismatch }
  }
  let contract = match move run valueCallableContract(&ty, constraints) {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => { return move mismatch }
  }
  let facts = match move run CallableContract.ofType(&contract) {
    Option<CallableFacts>.Some {value} => move value
    Option<CallableFacts>.None => { return move mismatch }
  }
  if facts.isUnsafe { return move mismatch }
  let listed = List<Shared<Type>>.asSlice(&facts.parameters)
  match move parameter {
    Option<Shared<Type>>.Some {value: element} => {
      if listed.length != usize.ONE { return move mismatch }
      let accepted = match move run storageView(&listed[usize.ZERO], false) {
        Option<StorageView>.Some {value: view} => view.access == Access.Mutable && run Type.equalsShared(&view.target, &element)
        Option<StorageView>.None => false
      }
      if !accepted { return move mismatch }
    }
    Option<Shared<Type>>.None => { if listed.length != usize.ZERO { return move mismatch } }
  }
  let exact = run Type.equalsShared(&facts.result, result)
  let diverges = divergent && Shared<Type>.with<bool>(&facts.result, neverType)
  if !exact && !diverges { return move mismatch }
  let entries = List<BodyNode>.asSlice(nodes)
  if checkedPlace(entries, node) && !movedBodyValue(entries, node) {
    let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, constraints, span) {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => { return Option<Shared<Rejection>>.some(move error) }
    }
    if !copied { return Option<Shared<Rejection>>.some(run explicitMoveRejection(module, span, &ty)) }
  }
  return Option<Shared<Rejection>>.none()
}

// Whether a storage operand borrows an `Intrinsic.ExecutionRef`.
effect fn executionRefView(subject: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run storageView(subject, false) {
    Option<StorageView>.Some {value: view} => SealedCore.isCore(&view.target, SealedKind.ExecutionRef)
    Option<StorageView>.None => false
  }
}

// Checks one sealed storage primitive against its contract, instantiated from its type arguments.
// Raw-buffer and slot contents stay owned by library code; only the operands' own types are checked.
effect fn checkStorageCall<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, span: Span, operation: StorageOperation, typeArguments: List<Shared<Type>>, arguments: CallArguments,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool, unsafeAllowed: bool, callAcknowledged: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let unsafeOperation = StorageOperation.isUnsafe(operation)
  if callAcknowledged && !unsafeOperation { return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeInvocation, span) }
  if unsafeOperation && !unsafeAllowed && !callAcknowledged {
    return run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span)
  }
  if CallArguments.length(arguments) != StorageOperation.arity(operation) {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  let mut instantiation = move typeArguments
  let word = run primitiveType(b"usize")
  let mut checked = List<BodyNodeId>.make()
  let mut ty = run Types.intern(Type.Unit)
  // The one element type every element-generic primitive is instantiated with.
  let mut element = run Types.intern(Type.Unit)
  if List<Shared<Type>>.length(&instantiation) > usize.ZERO {
    let written = List<Shared<Type>>.asSlice(&instantiation)
    element = Shared<Type>.clone(&written[usize.ZERO])
  }
  if operation == StorageOperation.Replace {
    let place = match move run storageOperand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, arguments, usize.ZERO,
      Option<Shared<Type>>.none(), constraints, contractBody, unsafeAllowed, span) {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    // The displaced place is written like an assignment target.
    if !assignablePlace(List<BodyNode>.asSlice(&nodes.*), List<BodyLocal>.asSlice(&statementScope.locals.*), place) {
      // `Intrinsic.replace(&mut slot, value)`, as `std::mem::replace` is written, borrows the place.
      if let BodyNodeKind.Expression {form: BodyExpression.Borrow {..}, ..} = &List<BodyNode>.asSlice(&nodes.*)[place.index].kind {
        let mut refused = run makeRejection(RejectionCode.InvalidAssignmentPlace, module, span)
        run vectorArgument(&mut refused, b"template", b"2")
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run Shared<Rejection>.make(move refused))
      }
      return run bodyRejection(&resolver.*, module, assignmentPlaceCode(List<BodyNode>.asSlice(&nodes.*), place), span)
    }
    let placeType = match move run storageOperandType(&resolver.*, module, &nodes.*, place, span) {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    if List<Shared<Type>>.length(&instantiation) == usize.ONE && !run Type.equalsShared(&element, &placeType) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    let value = match move run storageOperand(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
      caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, arguments, usize.ONE,
      Option<Shared<Type>>.some(Shared<Type>.clone(&placeType)), constraints, contractBody, unsafeAllowed, span) {
      Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    run List<BodyNodeId>.append(&mut checked, place)
    run List<BodyNodeId>.append(&mut checked, value)
    instantiation = List<Shared<Type>>.make()
    run List<Shared<Type>>.append(&mut instantiation, Shared<Type>.clone(&placeType))
    ty = move placeType
  } else {
    // Exact operand contexts in parameter order; absence marks a structural parameter checked below.
    let mut contexts = List<Option<Shared<Type>>>.make()
    let allocation = run SealedCore.allocation()
    match operation {
      StorageOperation.RawBufferFrom => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&allocation)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.RawBufferSlot => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.RawBufferRead => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.RawBufferCopy => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.RawBufferFill => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(run primitiveType(b"u8")))
      }
      StorageOperation.RawBufferView => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.RawBufferViewMut => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.SlotWrite => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&element)))
      }
      StorageOperation.SharedFromAllocation => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&allocation)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&element)))
      }
      // The package takes the allocation, then the body, readiness state and endpoint as written.
      StorageOperation.ExecutionFromAllocation => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&allocation)))
        let written = List<Shared<Type>>.asSlice(&instantiation)
        let mut at = usize.ONE
        while at < written.length {
          run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&written[at])))
          at = at + usize.ONE
        }
      }
      // A control word is addressed and written as a word.
      StorageOperation.ExecutionLoad => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.ExecutionStore => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      StorageOperation.ExecutionCompareExchange => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&word)))
      }
      // One activation takes the handle, then the branch state and both outcome callbacks as written.
      StorageOperation.ExecutionDrive => {
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(run SealedCore.applied(SealedKind.Execution, &element)))
        let written = List<Shared<Type>>.asSlice(&instantiation)
        let mut at = usize.ONE
        while at < written.length {
          run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(Shared<Type>.clone(&written[at])))
          at = at + usize.ONE
        }
      }
      StorageOperation.SystemAllocationAcquire => {
        let layout = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(move layout))
      }
      // The reclaim address is checked structurally below.
      StorageOperation.AllocationAdopt => {
        let layout = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(run byteAddress(false)))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(move layout))
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
        run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.some(run byteAddress(true)))
      }
      _ => {
        let mut at = usize.ZERO
        while at < StorageOperation.arity(operation) {
          run List<Option<Shared<Type>>>.append(&mut contexts, Option<Shared<Type>>.none())
          at = at + usize.ONE
        }
      }
    }
    let mut at = usize.ZERO
    while at < StorageOperation.arity(operation) {
      let listedContexts = List<Option<Shared<Type>>>.asSlice(&contexts)
      let context = match &listedContexts[at] {
        Option<Shared<Type>>.Some {value} => Option<Shared<Type>>.some(Shared<Type>.clone(&value))
        Option<Shared<Type>>.None => Option<Shared<Type>>.none()
      }
      // A named callback is selected against `once fn(&mut T) -> A`, whose input lives only for
      // its invocation (SHARED-003, LIFE-004); any other operand is checked as written.
      let mut selected = Option<Result<BodyNodeId, Shared<Rejection>>>.none()
      let written = List<Shared<Type>>.asSlice(&instantiation)
      if operation == StorageOperation.SharedWithMut && at == usize.ONE && written.length == 2 {
        let promised = Option<NamedCallableEvidence>.some(NamedCallableEvidence {
          contract: run sharedAccessContract(&written[usize.ZERO], &written[usize.ONE]), pending: Option<DeclarationId>.none(),
          call: Option<Span>.none()})
        let argument = run bodyArgument(&resolver.source, cursor, arguments, at)
        selected = run checkNamedValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
          caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
          argument, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, &promised, constraints,
          contractBody, false, unsafeAllowed)
      }
      let operand = match move selected {
        Option<Result<BodyNodeId, Shared<Rejection>>>.Some {value} => move value
        Option<Result<BodyNodeId, Shared<Rejection>>>.None => run storageOperand(&mut resolver.*, &mut owner.*, &mut request.*,
          &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
          &mut requiredBodies.*, arguments, at, move context, constraints, contractBody, unsafeAllowed, span)
      }
      let node = match move operand {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      run List<BodyNodeId>.append(&mut checked, node)
      at = at + usize.ONE
    }
    // A package accepts only a detached body, readiness state and endpoint, so it retains no loan
    // of its constructor (EXEC-004); the borrow walk relies on that contract.
    if operation == StorageOperation.ExecutionFromAllocation {
      let written = List<Shared<Type>>.asSlice(&instantiation)
      let mut stored = usize.ONE
      while stored < written.length {
        if !run provesDetached(constraints, &written[stored], module) {
          return run bodyRejection(&resolver.*, module, RejectionCode.UnsatisfiedExecutableProperty, span)
        }
        stored = stored + usize.ONE
      }
    }
    let operands = List<BodyNodeId>.asSlice(&checked)
    // The first operand's type, which every structural parameter reads.
    let mut subject = run Types.intern(Type.Unit)
    if operands.length > usize.ZERO {
      subject = match move run storageOperandType(&resolver.*, module, &nodes.*, operands[usize.ZERO], span) {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
    }
    let buffer = run SealedCore.applied(SealedKind.RawBuffer, &element)
    let shared = run SealedCore.applied(SealedKind.SharedCore, &element)
    let mismatch = run reject(&resolver.*, module, RejectionCode.TypeMismatch, span)
    match operation {
      StorageOperation.RawBufferFrom => { ty = move buffer }
      StorageOperation.RawBufferEmpty => { ty = move buffer }
      StorageOperation.RawBufferSlot => {
        let view = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value} => move value
          Option<StorageView>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        }
        if view.access != Access.Mutable || !run Type.equalsShared(&view.target, &buffer) {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch)
        }
        ty = run SealedCore.slot(&view.region, &element)
      }
      StorageOperation.RawBufferCount => {
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &buffer)
          Option<StorageView>.None => false
        }
        if !accepted { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = Shared<Type>.clone(&word)
      }
      StorageOperation.RawBufferRead => {
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &buffer)
          Option<StorageView>.None => false
        }
        if !accepted { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = Shared<Type>.clone(&element)
      }
      StorageOperation.RawBufferCopy => {
        let destination = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => view.access == Access.Mutable && run Type.equalsShared(&view.target, &buffer)
          Option<StorageView>.None => false
        }
        let sourceType = match move run storageOperandType(&resolver.*, module, &nodes.*, operands[2], span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        let source = match move run storageView(&sourceType, true) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &element)
          Option<StorageView>.None => false
        }
        if !destination || !source { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
      }
      StorageOperation.RawBufferFill => {
        let octet = run primitiveType(b"u8")
        let bytes = run SealedCore.applied(SealedKind.RawBuffer, &octet)
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => view.access == Access.Mutable && run Type.equalsShared(&view.target, &bytes)
          Option<StorageView>.None => false
        }
        if !accepted { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
      }
      StorageOperation.RawBufferView => {
        let view = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value} => move value
          Option<StorageView>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        }
        if !run Type.equalsShared(&view.target, &buffer) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = run Types.intern(Type.Slice {element: Shared<Type>.clone(&element), access: Access.Shared, lifetime: move view.region})
      }
      StorageOperation.RawBufferViewMut => {
        let view = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value} => move value
          Option<StorageView>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        }
        if view.access != Access.Mutable || !run Type.equalsShared(&view.target, &buffer) {
          return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch)
        }
        ty = run Types.intern(Type.Slice {element: Shared<Type>.clone(&element), access: Access.Mutable, lifetime: move view.region})
      }
      StorageOperation.SharedLayout => {
        ty = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
      }
      StorageOperation.LayoutOf => {
        ty = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
      }
      StorageOperation.SharedFromAllocation => { ty = move shared }
      StorageOperation.ExecutionLayout => {
        ty = match move run layoutDescriptor(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
      }
      StorageOperation.ExecutionFromAllocation => { ty = run SealedCore.applied(SealedKind.Execution, &element) }
      StorageOperation.ExecutionRefOf => {
        let execution = run SealedCore.applied(SealedKind.Execution, &element)
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &execution)
          Option<StorageView>.None => false
        }
        if !accepted { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = run SealedCore.make(SealedKind.ExecutionRef, List<Argument>.make())
      }
      // Every other reference operation reads its package through a borrowed ExecutionRef.
      StorageOperation.ExecutionLoad => {
        if !run executionRefView(&subject) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = Shared<Type>.clone(&word)
      }
      StorageOperation.ExecutionStore => {
        if !run executionRefView(&subject) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
      }
      StorageOperation.ExecutionCompareExchange => {
        if !run executionRefView(&subject) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = Shared<Type>.clone(&word)
      }
      StorageOperation.ExecutionNotify => {
        if !run executionRefView(&subject) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
      }
      StorageOperation.ExecutionLive => {
        if !run executionRefView(&subject) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = run primitiveType(b"bool")
      }
      // Relinquishing and naming the running package are Effects their run executes in place.
      StorageOperation.Relinquish => {
        ty = run Types.intern(Type.Effect {mode: CallableMode.Once,
          environment: run Shared<Intersection>.make(Intersection {members: List<LifetimeMember>.make()}),
          success: run Types.intern(Type.Unit), failure: run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
          requirements: run Shared<Row>.make(Row.empty())})
      }
      StorageOperation.ExecutionCurrent => {
        ty = run Types.intern(Type.Effect {mode: CallableMode.Once,
          environment: run Shared<Intersection>.make(Intersection {members: List<LifetimeMember>.make()}),
          success: run SealedCore.make(SealedKind.ExecutionRef, List<Argument>.make()),
          failure: run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
          requirements: run Shared<Row>.make(Row.empty())})
      }
      StorageOperation.SharedClone => {
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &shared)
          Option<StorageView>.None => false
        }
        if !accepted { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = move shared
      }
      StorageOperation.SharedWithMut => {
        let arguments = List<Shared<Type>>.asSlice(&instantiation)
        let result = Shared<Type>.clone(&arguments[usize.ONE])
        let accepted = match move run storageView(&subject, false) {
          Option<StorageView>.Some {value: view} => run Type.equalsShared(&view.target, &shared)
          Option<StorageView>.None => false
        }
        if !accepted { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        let selected = run storageCallable(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &nodes.*, operands[usize.ONE],
          Option<Shared<Type>>.some(Shared<Type>.clone(&element)), &result, false, constraints, span)
        if let Option<Shared<Rejection>>.Some {value} = move selected { return Result<BodyNodeId, Shared<Rejection>>.failResult(move value) }
        let conflict = run storageCallable(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, &nodes.*, operands[2],
          Option<Shared<Type>>.none(), &result, true, constraints, span)
        if let Option<Shared<Rejection>>.Some {value} = move conflict { return Result<BodyNodeId, Shared<Rejection>>.failResult(move value) }
        ty = move result
      }
      // The activation runs in place, so its Effect retains nothing beyond the run.
      StorageOperation.ExecutionDrive => {
        ty = run Types.intern(Type.Effect {mode: CallableMode.Once,
          environment: run Shared<Intersection>.make(Intersection {members: List<LifetimeMember>.make()}),
          success: run Types.intern(Type.Unit), failure: run Types.intern(Type.Union {members: List<Shared<Type>>.make()}),
          requirements: run Shared<Row>.make(Row.empty())})
      }
      StorageOperation.SystemAllocationAcquire => {
        ty = run Types.intern(Type.Effect {mode: CallableMode.Once,
          environment: run Shared<Intersection>.make(Intersection {members: List<LifetimeMember>.make()}),
          success: Shared<Type>.clone(&allocation), failure: run SealedCore.make(SealedKind.StorageFailure, List<Argument>.make()),
          requirements: run Shared<Row>.make(Row.empty())})
      }
      StorageOperation.AllocationAdopt => {
        let reclaim = match move run storageOperandType(&resolver.*, module, &nodes.*, operands[2], span) {
          Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
        }
        if !run reclaimAddress(&reclaim) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = Shared<Type>.clone(&allocation)
      }
      StorageOperation.StringUtf8Bytes => {
        let region = match move run storageText(&subject) {
          Option<Shared<Lifetime>>.Some {value} => move value
          Option<Shared<Lifetime>>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        }
        ty = run Types.intern(Type.Slice {element: run primitiveType(b"u8"), access: Access.Shared, lifetime: move region})
      }
      StorageOperation.StringFromUtf8Unchecked => {
        let view = match move run storageView(&subject, true) {
          Option<StorageView>.Some {value} => move value
          Option<StorageView>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        }
        let octet = run primitiveType(b"u8")
        if !run Type.equalsShared(&view.target, &octet) { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = run Types.intern(Type.String {lifetime: move view.region})
      }
      StorageOperation.StringByteLength => {
        let region = run storageText(&subject)
        if let Option<Shared<Lifetime>>.None = move region { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        ty = Shared<Type>.clone(&word)
      }
      _ => {
        // The slot primitives consume one selection of exactly the instantiated element.
        let mut selection = false
        if SealedCore.isCore(&subject, SealedKind.Slot) {
          if let Option<Shared<Type>>.Some {value: stored} = move SealedCore.element(&subject) {
            selection = run Type.equalsShared(&stored, &element)
          }
        }
        if !selection { return Result<BodyNodeId, Shared<Rejection>>.failResult(move mismatch) }
        if operation == StorageOperation.SlotTake || operation == StorageOperation.SlotCopy { ty = Shared<Type>.clone(&element) }
        if operation == StorageOperation.SlotAddress { ty = run SealedCore.address(&element) }
      }
    }
    // A read that leaves its storage initialized copies the element.
    if operation == StorageOperation.RawBufferRead || operation == StorageOperation.SlotCopy {
      let copied = match move run copyType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, constraints, span) {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      if !copied { return run bodyRejection(&resolver.*, module, RejectionCode.MissingConformance, span) }
    }
  }
  let index = List<BodyNode>.length(&nodes.*)
  run List<BodyNode>.append(&mut nodes.*, BodyNode {
    origin: run originAt(cursor, expression, span),
    kind: BodyNodeKind.Expression {ty: move ty, form: BodyExpression.StorageCall {operation: operation,
      typeArguments: move instantiation, arguments: move checked}},
  })
  return run checkExpectedValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, caller, constraints, &mut nodes.*, BodyNodeId {index: index}, expected, mismatchCode, span)
}

effect fn checkRun<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, expression: HirId,
  operand: HirId, span: Span, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let enclosingOperand = run replaceRunOperand(&mut resolver.*, Option<HirId>.some(HirId {index: operand.index}))
  let checked = run checkExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    operand, &Option<Shared<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, false, unsafeAllowed)
  drop run replaceRunOperand(&mut resolver.*, move enclosingOperand)
  let mut value = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => node
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  // `move` of a call's own result leaves no place without an owner (OWN-003), so `run move f(x)`
  // executes that call in place exactly as `run f(x)` does.
  if let Option<BodyNodeId>.Some {value: call} = move movedImmediateCall(List<BodyNode>.asSlice(&nodes.*), value) {
    List<BodyNode>.truncate(&mut nodes.*, value.index)
    value = call
  }
  let operandSpan = run bodySpan(&resolver.source, cursor, operand)
  let operandType = match move bodyExpressionType(List<BodyNode>.asSlice(&nodes.*), &value) {
    Option<Shared<Type>>.Some {value: selected} => move selected
    Option<Shared<Type>>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.RunNonEffect, operandSpan) }
  }
  let channels = match move run runnableChannels(&operandType, constraints) {
    Option<EffectChannels>.Some {value: selected} => move selected
    Option<EffectChannels>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.RunNonEffect, operandSpan) }
  }
  // A stored Effect is run with the access its contract grants: a once Effect is consumed and an
  // exclusive one needs a mutable place, as a callable invocation is (CALLABLE-002).
  // The operand is the call to run only when it calls an `effect fn` (its result is that call's
  // own construction) or invokes an `effect fn` value; any other call produced a stored Effect.
  let mut access = RunAccess.Immediate
  if !immediateOperand(List<BodyNode>.asSlice(&nodes.*), value) {
    let mut mode = CallableMode.Once
    let runContract = run valueCallableContract(&operandType, constraints)
    if let Option<Shared<Type>>.Some {value: contract} = move runContract {
      mode = Shared<Type>.with<CallableMode>(&contract, callableInvocationMode)
    }
    access = runAccessOf(mode)
    let stored = storedExecutableField(List<BodyNode>.asSlice(&nodes.*), value)
    let exclusiveDenied = mode == CallableMode.Mutable && checkedPlace(List<BodyNode>.asSlice(&nodes.*), value) &&
      !mutablePlace(List<BodyNode>.asSlice(&nodes.*), List<BodyLocal>.asSlice(&statementScope.locals.*), value)
    let takeDenied = mode == CallableMode.Once && !ownedExecutableReceiver(List<BodyNode>.asSlice(&nodes.*), value)
    if stored && (exclusiveDenied || takeDenied) {
      return run bodyRejection(&resolver.*, module, RejectionCode.StoredEffectRunAccess, span)
    }
    if mode == CallableMode.Mutable && checkedPlace(List<BodyNode>.asSlice(&nodes.*), value) &&
      !mutablePlace(List<BodyNode>.asSlice(&nodes.*), List<BodyLocal>.asSlice(&statementScope.locals.*), value) {
      return run bodyRejection(&resolver.*, module, RejectionCode.InvalidCallableInvocationAccess, operandSpan)
    }
    if mode == CallableMode.Once && !movedBodyValue(List<BodyNode>.asSlice(&nodes.*), value) {
      let consumed = match move run consumedPlace(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor,
        List<BodyNode>.asSlice(&nodes.*), value, false, false, operandSpan, operandSpan, constraints) {
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Success {value: place} => move place
        Result<Option<BodyConsumedPlace>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
      }
      // The run itself consumes a take-once Effect, so a later run is reported at the whole run
      // (EFFECT-OWN-002).
      let moved = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
      run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run originAt(cursor, operand, span),
        kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&operandType), form: BodyExpression.Move {value: value, consumed: move consumed}}})
      value = moved
    }
  }
  if derivingBody(&resolver.*) {
    run deriveChannels(&mut resolver.*, Option<Shared<Type>>.none(), Option<Shared<Type>>.none(),
      Option<Shared<Type>>.some(Shared<Type>.clone(&channels.failure)), Option<Shared<Row>>.some(Shared<Row>.clone(&channels.requirements)))
  } else {
    let enclosing = run currentBodyChannels(&resolver.*)
    // A run failure member the enclosing channel does not name exactly is covered by the one
    // declared member it meets by covariant region subtyping, as a `fail` payload is.
    let uncovered = run Type.uncoveredFailures(&enclosing.failure, &channels.failure)
    let declared = run Type.failureMembers(&enclosing.failure)
    let pending = List<Shared<Type>>.asSlice(&uncovered)
    let mut at = usize.ZERO
    while at < pending.length {
      let member = run regionAdmittedMember(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, constraints,
        &pending[at], List<Shared<Type>>.asSlice(&declared), true, span)
      let admitted = match move member {
        Option<AdmittedMember>.Some {value: found} => move found
        Option<AdmittedMember>.None => { return Result<BodyNodeId, Shared<Rejection>>.failResult(run unhandledFailureRejection(module, span, &pending[at], &enclosing)) }
      }
      if !relationsAdmitted(&resolver.*, List<RegionPair>.asSlice(&admitted.deferred)) {
        return Result<BodyNodeId, Shared<Rejection>>.failResult(run unhandledFailureRejection(module, span, &pending[at], &enclosing))
      }
      at = at + usize.ONE
    }
    // A declared `?S in R` premise covers what it bounds, as at a call that proves it.
    let premises = run rowPremises(constraints)
    if !run Row.knownSubset(&channels.requirements, &enclosing.requirements, List<RowPremise>.asSlice(&premises)) {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run unhandledRequirementRejection(module, span, &channels.requirements, &enclosing.requirements,
          enclosing.isTest))
    }
  }
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move channels.success,
    BodyExpression.Run {value: value, access: access}, false, expected, mismatchCode, contractBody, false)
}

// `text` with each type name written without its module, as the importing code names it: `E`
// rather than `main.E`, `LogError` rather than `silk/logger.LogError`.
effect fn unqualified(text: Bytes) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let written = Bytes.asSlice(&text)
  let mut spelled = Bytes.make()
  let mut start = usize.ZERO
  while start < written.length {
    let mut end = start
    let mut last = start
    // A module path may hold `-`, as in `my-tool/main.E`; the `-` of a `->` is not part of a name.
    while end < written.length && (pathByte(written[end]) || (written[end] == 45 && !(end + usize.ONE < written.length && written[end + usize.ONE] == 62))) {
      if written[end] == 46 { last = end + usize.ONE }
      end = end + usize.ONE
    }
    if end == start {
      run Bytes.append(&mut spelled, &[written[start]])
      start = start + usize.ONE
    } else {
      let mut at = last
      while at < end {
        run Bytes.append(&mut spelled, &[written[at]])
        at = at + usize.ONE
      }
      start = end
    }
  }
  return move spelled
}

// Whether `byte` belongs to a qualified type name: a letter, digit, `_`, `/` or `.`.
fn pathByte(byte: u8) -> bool {
  return byte == 46 || byte == 47 || byte == 95 || (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

// A `run` whose failure `member` the enclosing signature does not declare (SEM0066), naming it.
// A body that is not an `effect fn` cannot declare the failure, so the advice is to make it one.
effect fn unhandledFailureRejection(module: &ModuleId, span: Span, member: &Shared<Type>, enclosing: &BodyFrame) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut diagnostic = run makeRejection(RejectionCode.UnhandledFailure, module, span)
  if !enclosing.isEffect {
    diagnostic.arguments = List<MessageArgument>.make()
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
    let mut qualifier: &'static [u8] = b"effect fn"
    if enclosing.isTest { qualifier = b"test effect fn" }
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"qualifier"), value: run Bytes.copy(qualifier)})
  }
  if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(member, module) {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"failures"), value: run unqualified(move text)})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// A `run` whose requirements the enclosing signature does not provide (SEM0071), naming the
// services `required` holds that `provided` lacks, as a requirement row spells them: `&mut Logger`.
// Nothing is named when a role or a row parameter makes the difference. A test cannot declare a
// requirement row (SEM0218), so its message only offers a provider (template 1).
effect fn unhandledRequirementRejection(module: &ModuleId, span: Span, required: &Shared<Row>, provided: &Shared<Row>,
  test: bool) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut diagnostic = run makeRejection(RejectionCode.UnhandledRequirement, module, span)
  if let Option<Bytes>.Some {value: text} = move run requirementsText(module, required, &Option<Shared<Row>>.some(Shared<Row>.clone(provided))) {
    if Bytes.length(&text) > usize.ZERO {
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"requirements"), value: move text})
      let mut choice: &'static [u8] = b"0"
      if test { choice = b"1" }
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
    }
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// SEM0076 for an Effect whose requirements `offered` include services that the expected Effect
// contract's `wanted` does not allow, such as a child for `Fiber.forkChild` that needs a `Logger`,
// naming those services and the allowed ones. None when the requirements are not the difference.
effect fn effectRequirementsRejection(module: &ModuleId, span: Span, offered: &Shared<Row>, wanted: &Shared<Row>)
-> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let extra = match move run requirementsText(module, offered, &Option<Shared<Row>>.some(Shared<Row>.clone(wanted))) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Shared<Rejection>>.none() }
  }
  if Bytes.length(&extra) == usize.ZERO { return Option<Shared<Rejection>>.none() }
  let allowed = match move run requirementsText(module, wanted, &Option<Shared<Row>>.none()) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return Option<Shared<Rejection>>.none() }
  }
  let mut diagnostic = run makeRejection(RejectionCode.IncompatibleCallableSignature, module, span)
  diagnostic.arguments = List<MessageArgument>.make()
  let mut choice = b"1"
  if Bytes.length(&allowed) == usize.ZERO { choice = b"2" }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(choice)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"extra"), value: move extra})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"allowed"), value: move allowed})
  return Option<Shared<Rejection>>.some(run Shared<Rejection>.make(move diagnostic))
}

// The services of `required` that `provided` lacks, or all of them when `provided` is none, as a
// requirement row spells them: `&mut Logger | &MonotonicClock`. Empty when nothing is lacking; none
// when a role makes the difference, which has no plain spelling.
effect fn requirementsText(viewer: &ModuleId, required: &Shared<Row>, provided: &Option<Shared<Row>>) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut text = Bytes.make()
  let wantedCount = Shared<Row>.with<usize>(required, fn(row: &Row) -> usize { return List<Requirement>.length(&row.entries) })
  let mut at = usize.ZERO
  while at < wantedCount {
    let wanted = Shared<Row>.with<Shared<Type>>(required, fn(row: &Row) -> Shared<Type> {
      return Shared<Type>.clone(&List<Requirement>.asSlice(&row.entries)[at].capability)
    })
    let exclusive = Shared<Row>.with<bool>(required, fn(row: &Row) -> bool { return List<Requirement>.asSlice(&row.entries)[at].access == Access.Mutable })
    let roled = Shared<Row>.with<bool>(required, fn(row: &Row) -> bool {
      return match &List<Requirement>.asSlice(&row.entries)[at].roleType { Option<Shared<Type>>.Some {..} => true Option<Shared<Type>>.None => false }
    })
    let mut covered = false
    if let Option<Shared<Row>>.Some {value: held} = &provided.* {
      let haveCount = Shared<Row>.with<usize>(&held, fn(row: &Row) -> usize { return List<Requirement>.length(&row.entries) })
      let mut each = usize.ZERO
      while each < haveCount {
        let capability = Shared<Row>.with<Shared<Type>>(&held, fn(row: &Row) -> Shared<Type> {
          return Shared<Type>.clone(&List<Requirement>.asSlice(&row.entries)[each].capability)
        })
        let lends = Shared<Row>.with<bool>(&held, fn(row: &Row) -> bool { return List<Requirement>.asSlice(&row.entries)[each].access == Access.Mutable })
        let matching = run Type.equalsShared(&wanted, &capability)
        if matching && (lends || !exclusive) { covered = true }
        each = each + usize.ONE
      }
    }
    if !covered {
      if roled { return Option<Bytes>.none() }
      match move run TypeText.displayElided(&wanted, viewer) {
        Option<Bytes>.Some {value: spelled} => {
          if Bytes.length(&text) > usize.ZERO { run Bytes.append(&mut text, b" | ") }
          if exclusive { run Bytes.append(&mut text, b"&mut ") } else { run Bytes.append(&mut text, b"&") }
          run Bytes.append(&mut text, Bytes.asSlice(&spelled))
        }
        Option<Bytes>.None => { return Option<Bytes>.none() }
      }
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.some(run unqualified(move text))
}

// How a stored Effect with this run contract is run (EFFECT-OWN-002).
fn runAccessOf(mode: CallableMode) -> RunAccess {
  if mode == CallableMode.Mutable { return RunAccess.Exclusive }
  if mode == CallableMode.Once { return RunAccess.Once }
  return RunAccess.Shared
}

// The call a just-checked `move` transfers when that call is itself the run's immediate operand
// and the move consumes no place.
fn movedImmediateCall(nodes: &[BodyNode], value: BodyNodeId) -> Option<BodyNodeId> {
  if value.index + usize.ONE != nodes.length { return Option<BodyNodeId>.none() }
  if let BodyNodeKind.Expression {form: BodyExpression.Move {value: moved, consumed: Option<BodyConsumedPlace>.None}, ..} = &nodes[value.index].kind {
    if immediateOperand(nodes, moved) { return Option<BodyNodeId>.some(moved) }
  }
  return Option<BodyNodeId>.none()
}

// `*mut u8`, or `?*mut u8` when `nullable`: the base and context addresses of an adopted allocation.
effect fn byteAddress(nullable: bool) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run Types.intern(Type.Pointer {pointee: run primitiveType(b"u8"), access: Access.Mutable, nullable: nullable,
    multiplicity: Multiplicity.Single, alignment: Option<u64>.none()})
}

// Whether `value` is `extern "C" fn(?*mut u8) -> ()`, the one reclaim signature an adopted
// allocation records.
effect fn reclaimAddress(value: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let signature = match move run Type.copy(value) {
    Type.ForeignFunction {signature, ..} => move signature
    _ => { return false }
  }
  let word = run byteAddress(true)
  let unit = run Types.intern(Type.Unit)
  if let Type.Callable {parameters, result, ..} = move run Type.copy(&signature) {
    let listed = List<Shared<Type>>.asSlice(&parameters)
    if listed.length != usize.ONE { return false }
    if !run Type.equalsShared(&listed[usize.ZERO], &word) { return false }
    return run Type.equalsShared(&result, &unit)
  }
  return false
}

fn immediateOperand(nodes: &[BodyNode], value: BodyNodeId) -> bool {
  if let BodyNodeKind.Expression {form, ty} = &nodes[value.index].kind {
    if let BodyExpression.DirectCall {declaration, ..} = &form {
      return Shared<Type>.with<bool>(&ty, fn(result: &Type) -> bool { return constructs(result, &declaration) })
    }
    if let BodyExpression.CallableCall {constructs: invoked, ..} = &form { return invoked }
    // The primitive allocation boundary and one execution activation are Effects their run executes
    // in place.
    if let BodyExpression.StorageCall {operation, ..} = &form {
      return operation == StorageOperation.SystemAllocationAcquire || operation == StorageOperation.ExecutionDrive
        || operation == StorageOperation.Relinquish || operation == StorageOperation.ExecutionCurrent
    }
    // An `effect fn` interface operation runs as one call of its selected witness.
    if let BodyExpression.InterfaceCall {isEffect, ..} = &form { return isEffect }
  }
  return false
}

// Whether a `run` executes the call at `call` in place, as its immediate operand.
fn ranInPlace(nodes: &[BodyNode], call: usize) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Run {value, access}, ..} = &nodes[at].kind {
      if access == RunAccess.Immediate && value.index == call { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `result` is the exact Effect constructed by calling `declaration` itself.
fn constructs(result: &Type, declaration: &DeclarationId) -> bool {
  if let Type.CallableValue {application, contract, ..} = &result.* {
    if !Shared<Type>.with<bool>(&contract, bareEffect) { return false }
    return Shared<Application>.with<bool>(&application, fn(selected: &Application) -> bool {
      return DeclarationId.equals(Application.bodyDeclaration(selected), declaration)
    })
  }
  return false
}

fn effectProducing(value: &Type) -> bool {
  return match &value.* { Type.Callable {result, ..} => Shared<Type>.with<bool>(&result, bareEffect) _ => false }
}

// The Effect contract of an `effect fn` construction or a producer's Effect family; none for any
// other value.
fn delayedEffectContract(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.CallableValue {contract, ..} => {
      if Shared<Type>.with<bool>(&contract, bareEffect) { return Option<Shared<Type>>.some(Shared<Type>.clone(&contract)) }
      return Option<Shared<Type>>.none()
    }
    Type.OpaqueRepresentation {contract, ..} => {
      if Shared<Type>.with<bool>(&contract, bareEffect) { return Option<Shared<Type>>.some(Shared<Type>.clone(&contract)) }
      return Option<Shared<Type>>.none()
    }
    _ => Option<Shared<Type>>.none()
  }
}

fn bareEffect(value: &Type) -> bool {
  return match &value.* { Type.Effect {..} => true _ => false }
}

// The producer-owned family of a declared `Effect<...>` result (EFF-013). A declared Effect
// success is itself held and run, so it is a family of its own, realized from the success of
// each returned Effect; the outer contract names it.
effect fn effectFamily(producer: &DeclarationId, declared: &Shared<Type>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut contract = Shared<Type>.clone(declared)
  let copied = run Type.copy(declared)
  if let Type.Effect {mode, environment, success, failure, requirements} = move copied {
    if Shared<Type>.with<bool>(&success, bareEffect) {
      contract = run Types.intern(Type.Effect {mode: mode, environment: move environment,
        success: run effectFamily(producer, &success), failure: move failure, requirements: move requirements})
    }
  }
  let prototype = Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(producer)},
    arguments: List<Argument>.make(), argumentOrdinals: List<usize>.make(),
    scopes: List<ScopeBinding>.make(), statics: List<StaticSlot>.make()}
  return run Types.intern(Type.OpaqueRepresentation {application: run Shared<Application>.make(move prototype),
    contract: move contract, detached: false, nonParking: false})
}

// A named function or foreign static used as a value, or none when `expression` names neither.
// `promised` is the callable contract the use site already knows: a function value takes the type
// binders its target leaves open from it, and the consumer still proves the whole contract.
effect fn checkNamedValue<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, promised: &Option<NamedCallableEvidence>, constraints: &[Constraint],
  contractBody: bool, staticBody: bool, unsafeAllowed: bool,
) -> Option<Result<BodyNodeId, Shared<Rejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let namedValue = match run bodyNode(&resolver.source, cursor, expression) {
    Node.IdentifierExpression {binding, ..} => !binding.present
    Node.FieldExpression {..} => true
    Node.MemberExpression {fields, ..} => !fields.present
    _ => false
  }
  if !namedValue { return Option<Result<BodyNodeId, Shared<Rejection>>>.none() }
  let span = run bodySpan(&resolver.source, cursor, expression)
  let selected = run resolvedCall(calls, expression)
  match move selected {
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {
      value: Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Function {target}},
    } => {
      if staticBody {
        return Option<Result<BodyNodeId, Shared<Rejection>>>.some(run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
      }
      if target.foreign {
        return Option<Result<BodyNodeId, Shared<Rejection>>>.some(run foreignFunctionAddress(&mut resolver.*, &mut owner.*,
          &mut dependencies.*, module, cursor, &mut nodes.*, &mut requiredBodies.*, expression, span, &target, expected, mismatchCode))
      }
      return Option<Result<BodyNodeId, Shared<Rejection>>>.some(run checkInvocation(&mut resolver.*, &mut owner.*, &mut request.*,
        &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*,
        &mut requiredBodies.*, expression, CallInput {callee: expression, generics: HirRef.absent(),
          arguments: CallArguments.Written {range: Range.empty()}, pipeline: false},
        expected, mismatchCode, constraints, contractBody, false, unsafeAllowed, false, true, promised))
    }
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {
      value: Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.ForeignStatic {declaration, ty}},
    } => {
      if staticBody {
        return Option<Result<BodyNodeId, Shared<Rejection>>>.some(run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span))
      }
      // Reading foreign storage observes memory outside Silk's ownership, so it needs `unsafe`.
      if !unsafeAllowed {
        return Option<Result<BodyNodeId, Shared<Rejection>>>.some(run bodyRejection(&resolver.*, module, RejectionCode.UnsafeAcknowledgement, span))
      }
      return Option<Result<BodyNodeId, Shared<Rejection>>>.some(run foreignStaticExpression(&mut resolver.*, &mut owner.*,
        &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*, expression, span, move declaration, move ty, expected, mismatchCode))
    }
    Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value: Result<ResolvedTarget, Shared<Rejection>>.Failure {error}} => {
      let rejectedValue = Shared<Rejection>.with<bool>(&error, fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.ForeignFunctionNotFirstClass || value.code == RejectionCode.ForeignStaticUnavailable
          || value.code == RejectionCode.PrivateMember
      })
      if rejectedValue {
        return Option<Result<BodyNodeId, Shared<Rejection>>>.some(Result<BodyNodeId, Shared<Rejection>>.failResult(move error))
      }
    }
    _ => ()
  }
  return Option<Result<BodyNodeId, Shared<Rejection>>>.none()
}

effect fn checkExpression<'scope>(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, statementScope: &mut StatementScope<'scope>, calls: &[ResolvedCall], nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>,
  expression: HirId, expected: &Option<Shared<Type>>, mismatchCode: RejectionCode, constraints: &[Constraint], contractBody: bool,
  staticBody: bool, unsafeAllowed: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  return run checkExpressionUnder(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor,
    caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, false)
}

// Classify large HIR unions before effectful dispatch so omitted variants share one refusal.
union HotSourceExpression {
  PrefixExpression {operator: PrefixOperator, operatorAnchor: Span, operand: HirId},
  InfixExpression {operator: InfixOperator, operatorAnchor: Span, left: HirId, right: HirId},
}

union OtherSourceExpressionInput {
  RunExpression {operand: HirId},
  EffectExpression {body: HirId},
  IntegerLiteral {sign: Sign, magnitude: Symbol, suffix: SymbolRef},
  CharacterLiteral {scalar: u32},
  DurationLiteral {components: Range},
  FloatingLiteral {suffix: SymbolRef},
  TextLiteral,
  BytesLiteral,
  BooleanLiteral {value: bool},
  UnitLiteral,
  CompileErrorExpression {message: HirId},
  IdentifierExpression {name: HirId, binding: HirRef},
  ArrayExpression {elements: Range},
  ArrayRepeatExpression {value: HirId, count: HirId},
  TupleExpression {elements: Range},
  OrdinalExpression {subject: HirId, ordinal: HirId},
  IndexExpression {subject: HirId, index: HirId},
  RecordExpression {fields: Range},
  MemberExpression {selector: HirId, fields: RangeRef},
  StructExpression {annotation: HirId, fields: Range},
  FieldExpression {subject: HirId, field: HirId},
  MatchExpression {access: MatchAccess, subject: HirId, arms: Range},
  ConditionalExpression {condition: HirId, thenBranch: HirId, elseBranch: HirRef},
  PatternConditionalExpression {pattern: HirId, subject: HirId, thenBranch: HirId, elseBranch: HirRef},
  BorrowExpression {access: Access, operand: HirId},
  ReferentExpression {subject: HirId},
  UnsafeExpression,
  MoveExpression {operand: HirId},
  Unavailable,
}

union SourceExpressionRoute {
  Hot {input: HotSourceExpression},
  Other {input: OtherSourceExpressionInput},
}

fn checkedSourceExpressionInput(node: Node) -> SourceExpressionRoute {
  return match node {
    Node.RunExpression {operand} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.RunExpression {operand: operand}}
    Node.EffectExpression {body} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.EffectExpression {body: body}}
    Node.IntegerLiteral {sign, magnitude, suffix, ..} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.IntegerLiteral {sign: sign, magnitude: magnitude, suffix: suffix}}
    Node.CharacterLiteral {scalar} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.CharacterLiteral {scalar: scalar}}
    Node.DurationLiteral {components} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.DurationLiteral {components: components}}
    Node.FloatingLiteral {suffix, ..} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.FloatingLiteral {suffix: suffix}}
    Node.TextLiteral {..} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.TextLiteral}
    Node.BytesLiteral {..} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.BytesLiteral}
    Node.BooleanLiteral {value} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.BooleanLiteral {value: value}}
    Node.UnitLiteral => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.UnitLiteral}
    Node.CompileErrorExpression {message} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.CompileErrorExpression {message: message}}
    Node.IdentifierExpression {name, binding} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.IdentifierExpression {name: name, binding: binding}}
    Node.ArrayExpression {elements} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.ArrayExpression {elements: elements}}
    Node.ArrayRepeatExpression {value, count} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.ArrayRepeatExpression {value: value, count: count}}
    Node.TupleExpression {elements} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.TupleExpression {elements: elements}}
    Node.OrdinalExpression {subject, ordinal} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.OrdinalExpression {subject: subject, ordinal: ordinal}}
    Node.IndexExpression {subject, index} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.IndexExpression {subject: subject, index: index}}
    Node.RecordExpression {fields} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.RecordExpression {fields: fields}}
    Node.MemberExpression {selector, fields} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.MemberExpression {selector: selector, fields: fields}}
    Node.StructExpression {annotation, fields} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.StructExpression {annotation: annotation, fields: fields}}
    Node.FieldExpression {subject, field} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.FieldExpression {subject: subject, field: field}}
    Node.MatchExpression {access, subject, arms} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.MatchExpression {access: access, subject: subject, arms: arms}}
    Node.ConditionalStatement {condition, thenBranch, elseBranch} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.ConditionalExpression {condition: condition, thenBranch: thenBranch, elseBranch: elseBranch}}
    Node.PatternConditionalStatement {pattern, subject, thenBranch, elseBranch} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.PatternConditionalExpression {pattern: pattern, subject: subject, thenBranch: thenBranch, elseBranch: elseBranch}}
    Node.BorrowExpression {access, operand} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.BorrowExpression {access: access, operand: operand}}
    Node.ReferentExpression {subject} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.ReferentExpression {subject: subject}}
    Node.UnsafeExpression {..} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.UnsafeExpression}
    Node.MoveExpression {operand} => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.MoveExpression {operand: operand}}
    Node.PrefixExpression {operator, operatorAnchor, operand} => SourceExpressionRoute.Hot {input: HotSourceExpression.PrefixExpression {operator: operator, operatorAnchor: operatorAnchor, operand: operand}}
    Node.InfixExpression {operator, operatorAnchor, left, right} => SourceExpressionRoute.Hot {input: HotSourceExpression.InfixExpression {operator: operator, operatorAnchor: operatorAnchor, left: left, right: right}}
    _ => SourceExpressionRoute.Other {input: OtherSourceExpressionInput.Unavailable}
  }
}


struct CheckedMemberSelector {
  subject: HirId,
  member: HirId,
}

fn checkedMemberSelector(node: Node) -> Option<CheckedMemberSelector> {
  return match node {
    Node.MemberSelector {subject, member} => Option<CheckedMemberSelector>.some(CheckedMemberSelector {subject: subject, member: member})
    _ => Option<CheckedMemberSelector>.none()
  }
}

fn checkedMemberName(node: Node) -> Option<Symbol> {
  return match node {
    Node.Name {text} => Option<Symbol>.some(text)
    _ => Option<Symbol>.none()
  }
}

// Exact value admission is the default. Only an opaque return literal and its matching nested
// literals receive construction authority; ordinary assignments and arguments never inherit it.
effect fn checkExpressionUnder<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  authoredExpression: HirId,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  opaqueConstruction: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // Prefix acknowledgement selects one invocation. Child checks retain only block permission.
  let mut expression = authoredExpression
  let mut callAcknowledged = false
  if let Node.UnsafeExpression {operand} = run bodyNode(
    &resolver.source,
    cursor,
    authoredExpression,
  ) {
    if let Option<CallInput>.Some {..} = move CallInput.ofNode(run bodyNode(&resolver.source, cursor, operand)) {
      expression = operand
      callAcknowledged = true
    } else {
      return run bodyRejection(
        &resolver.*,
        module,
        RejectionCode.UnsafeInvocation,
        run bodySpan(&resolver.source, cursor, authoredExpression),
      )
    }
  }
  let span = run bodySpan(&resolver.source, cursor, expression)
  let pendingFact = selectedFact(calls, expression)
  if let Option<SelectionFact>.Some {value: SelectionFact.Embedded {value: embedded, ty: embeddedType}} = move pendingFact {
    return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
      expression, span, move embedded, move embeddedType, expected, mismatchCode)
  }
  let authored = run bodyNode(&resolver.source, cursor, expression)
  if let Option<CallInput>.Some {value: input} = move CallInput.ofNode(authored) {
    return run checkInvocation(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      expression, input, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, callAcknowledged, false,
      &Option<NamedCallableEvidence>.none())
  }
  let namedValue = run checkNamedValue(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, expected, mismatchCode, &Option<NamedCallableEvidence>.none(), constraints, contractBody, staticBody, unsafeAllowed)
  if let Option<Result<BodyNodeId, Shared<Rejection>>>.Some {value: checkedValue} = move namedValue {
    return move checkedValue
  }
  if let Node.CallableExpression {..} = authored {
    if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
    return run checkAnonymous(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut statementScope.*, &mut nodes.*, expression, expected, mismatchCode, constraints)
  }
  return run checkSourceExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    expression, span, authored, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, opaqueConstruction)
}

effect fn checkSourceExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  authored: Node,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  opaqueConstruction: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = run Types.intern(Type.Unit)
  let mut form = BodyExpression.Unit
  let mut diverges = false
  let route = checkedSourceExpressionInput(authored)
  return match move route {
    SourceExpressionRoute.Hot {input: selected} => match move selected {
    HotSourceExpression.PrefixExpression {operator, operatorAnchor, operand} => run checkSourcePrefixExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, operator, operatorAnchor, operand,
    )
    HotSourceExpression.InfixExpression {operator, operatorAnchor, left, right} => run checkSourceInfixExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, operator, operatorAnchor, left, right,
    )
    }
    SourceExpressionRoute.Other {input} => run checkOtherSourceExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      expression, span, move input, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, opaqueConstruction,
      move ty, move form, diverges)
  }
}

effect fn checkOtherSourceExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  input: OtherSourceExpressionInput,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  opaqueConstruction: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  return match move input {
    OtherSourceExpressionInput.RunExpression {operand} => run checkSourceRunExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, operand,
    )
    OtherSourceExpressionInput.EffectExpression {body} => run checkSourceEffectExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, &mut nodes.*, expression, span, expected, mismatchCode, constraints, staticBody, move ty, move form, diverges, body,
    )
    OtherSourceExpressionInput.IntegerLiteral {sign, magnitude, suffix} => run checkSourceIntegerLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, move ty, move form, diverges, sign, magnitude, suffix,
    )
    OtherSourceExpressionInput.CharacterLiteral {scalar} => run checkSourceCharacterLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, move ty, move form, diverges, scalar,
    )
    OtherSourceExpressionInput.DurationLiteral {components} => run checkSourceDurationLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, move ty, move form, diverges, components,
    )
    OtherSourceExpressionInput.FloatingLiteral {suffix} => run checkSourceFloatingLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, move ty, move form, diverges, suffix,
    )
    OtherSourceExpressionInput.TextLiteral => run checkSourceTextLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, move ty, move form, diverges,
    )
    OtherSourceExpressionInput.BytesLiteral => run checkSourceBytesLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, move ty, move form, diverges,
    )
    OtherSourceExpressionInput.BooleanLiteral {value} => run checkSourceBooleanLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, move ty, move form, diverges, value,
    )
    OtherSourceExpressionInput.UnitLiteral => run checkSourceUnitLiteral(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, move ty, move form, diverges,
    )
    OtherSourceExpressionInput.CompileErrorExpression {message} => run checkSourceCompileErrorExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, message,
    )
    OtherSourceExpressionInput.IdentifierExpression {name, binding} => run checkSourceIdentifierExpression(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, move ty, move form, diverges, name, binding,
    )
    OtherSourceExpressionInput.ArrayExpression {elements} => run checkSourceArrayExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, elements,
    )
    OtherSourceExpressionInput.ArrayRepeatExpression {value, count} => run checkSourceArrayRepeatExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, value, count,
    )
    OtherSourceExpressionInput.TupleExpression {elements} => run checkSourceTupleExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, opaqueConstruction, move ty, move form, diverges, elements,
    )
    OtherSourceExpressionInput.OrdinalExpression {subject, ordinal} => run checkSourceOrdinalExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, subject, ordinal,
    )
    OtherSourceExpressionInput.IndexExpression {subject, index} => run checkSourceIndexExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, subject, index,
    )
    OtherSourceExpressionInput.RecordExpression {fields} => run checkSourceRecordExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, opaqueConstruction, move ty, move form, diverges, fields,
    )
    OtherSourceExpressionInput.MemberExpression {selector, fields} => run checkSourceMemberExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, selector, fields,
    )
    OtherSourceExpressionInput.StructExpression {annotation, fields} => run checkSourceStructExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, annotation, fields,
    )
    OtherSourceExpressionInput.FieldExpression {subject, field} => run checkSourceFieldExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, subject, field,
    )
    OtherSourceExpressionInput.MatchExpression {access, subject, arms} => run checkSourceMatchExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, access, subject, arms,
    )
    OtherSourceExpressionInput.ConditionalExpression {condition, thenBranch, elseBranch} => run checkSourceConditionalExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, condition, thenBranch, elseBranch,
    )
    OtherSourceExpressionInput.PatternConditionalExpression {pattern, subject, thenBranch, elseBranch} => {
      if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
      return run checkPatternMatch(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
        &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, subject,
        MatchArms.Conditional {pattern: pattern, thenBranch: thenBranch, elseBranch: elseBranch}, expected, mismatchCode,
        constraints, contractBody, unsafeAllowed)
    }
    OtherSourceExpressionInput.BorrowExpression {access, operand} => run checkSourceBorrowExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, access, operand,
    )
    OtherSourceExpressionInput.ReferentExpression {subject} => run checkSourceReferentExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, subject,
    )
    OtherSourceExpressionInput.UnsafeExpression => run checkSourceUnsafeExpression(
      &mut resolver.*, module, span, move ty, move form, diverges,
    )
    OtherSourceExpressionInput.MoveExpression {operand} => run checkSourceMoveExpression(
      &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller, &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, span, expected, mismatchCode, constraints, contractBody, staticBody, unsafeAllowed, move ty, move form, diverges, operand,
    )
    OtherSourceExpressionInput.Unavailable => {
      // TEXT-001: a literal that lexes but does not decode is the one damage no parser diagnostic reports.
      if SourceIndex.authoredHasCause(&resolver.source, cursor, expression, CauseCode.InvalidStaticLiteral) {
        return run bodyRejection(&resolver.*, module, RejectionCode.InvalidStaticLiteral, span)
      }
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
}

effect fn checkSourceRunExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  calls: &[ResolvedCall],
  nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>,
  requiredBodies: &mut List<DeclarationId>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  unsafeAllowed: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  operand: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  return run checkRun(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut statementScope.*, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, expression, operand, span,
    expected, mismatchCode, constraints, contractBody, unsafeAllowed)

}

effect fn checkSourceEffectExpression<'scope>(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  statementScope: &mut StatementScope<'scope>,
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  body: HirId,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span) }
  return run checkEffectBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
    &mut statementScope.*, &mut nodes.*, expression, body, expected, mismatchCode, constraints)

}

effect fn checkSourceIntegerLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  sign: Sign,
  magnitude: Symbol,
  suffix: SymbolRef,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let digits = run bodyText(&resolver.source, cursor, magnitude)
  let mut written = run Bytes.copy(b"i32")
  let mut contextual = false
  if suffix.present {
    written = run bodyText(&resolver.source, cursor, suffix.symbol)
  } else if let Option<Shared<Type>>.Some {value} = &expected.* {
    if Shared<Type>.with<bool>(
      &value,
      fn(ty: &Type) -> bool {
        return fixedIntegerType(ty) || pointerSizedIntegerType(ty)
      },
    ) {
      contextual = true
    }
  }
  let selected = Bytes.asSlice(&written)
  if contextual {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      let fits = Shared<Type>.with<bool>(
        &value,
        fn(resolved: &Type) -> bool {
          return match & resolved.* {
            Type.Primitive {name} => fitsInteger(
              &resolver.target,
              Bytes.asSlice(&name),
              sign,
              Bytes.asSlice(&digits),
            )
            _ => false
          }
        },
      )
      if !fits {
        let name = Shared<Type>.with<&'static [u8]>(&value, fn(resolved: &Type) -> &'static [u8] {
          return integerTypeName(resolved)
        })
        return Result<BodyNodeId, Shared<Rejection>>.failResult(
          run integerRangeRejection(&resolver.*, module, name, sign, Bytes.asSlice(&digits), span))
      }
      ty = Shared<Type>.clone(&value)
    }
  } else {
    if !fixedIntegerName(selected) && !pointerSizedIntegerName(selected) {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    if !fitsInteger(&resolver.target, selected, sign, Bytes.asSlice(&digits)) {
      return Result<BodyNodeId, Shared<Rejection>>.failResult(
        run integerRangeRejection(&resolver.*, module, selected, sign, Bytes.asSlice(&digits), span))
    }
    ty = run primitiveType(selected)
  }
  form = BodyExpression.Integer {literal: run anchoredNode(cursor, expression)}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceCharacterLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  scalar: u32,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    let integer = Shared<Type>.with<Option<StaticIntegerType>>(&value, fn(ty: &Type) -> Option<StaticIntegerType> {
      if let Type.Primitive {name} = &ty.* { return StaticExecution.integerType(Bytes.asSlice(&name)) }
      return Option<StaticIntegerType>.none()
    })
    if let Option<StaticIntegerType>.Some {value: selected} = move integer {
      let digits = run characterDigits(scalar)
      let fits = Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
        if let Type.Primitive {name} = &ty.* { return fitsInteger(&resolver.target, Bytes.asSlice(&name), Sign.Positive, Bytes.asSlice(&digits)) }
        return false
      })
      if !fits { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span) }
      let actual = match move StaticValue.integer(selected, StaticSign.Positive, u32.toU64(scalar), resolver.target.pointerBits()) {
        Option<StaticData>.Some {value: actual} => move actual
        Option<StaticData>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span) }
      }
      return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
        expression, span,
        run Shared<StaticData>.make(move actual), Shared<Type>.clone(&value), expected, mismatchCode)
    }
  }
  let actual = match move StaticValue.character(scalar) {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => { fail RevisionMismatch {} }
  }
  return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span,
    run Shared<StaticData>.make(move actual), run primitiveType(b"char"), expected, mismatchCode)

}

// DURATION-001: a duration literal is its exact `u64` nanosecond total, independent of context.
effect fn checkSourceDurationLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  components: Range,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let mut total: u64 = 0
  let mut at = usize.ZERO
  while at < components.length {
    let component = run bodyChild(&resolver.source, cursor, components, at)
    let sum = match run bodyNode(&resolver.source, cursor, component) {
      Node.DurationComponent {magnitude, unit} => DurationUnit.accumulate(unit, total, magnitude)
      _ => { fail RevisionMismatch {} }
    }
    total = match move sum {
      Option<u64>.Some {value} => value
      Option<u64>.None => { return run bodyRejection(&resolver.*, module, RejectionCode.DurationOutOfRange, span) }
    }
    at = at + usize.ONE
  }
  let actual = match move StaticValue.integer(StaticIntegerType.U64, StaticSign.Positive, total, resolver.target.pointerBits()) {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => { fail RevisionMismatch {} }
  }
  return run embeddedExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span,
    run Shared<StaticData>.make(move actual), run primitiveType(b"u64"), expected, mismatchCode)

}

effect fn checkSourceFloatingLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
  suffix: SymbolRef,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  let mut contextual = false
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    contextual = Shared<Type>.with<bool>(
      &value,
      fn(checked: &Type) -> bool {
        if let Type.Primitive {name} = &checked.* {
          let written = Bytes.asSlice(&name)
          return same(written, b"f32") || same(written, b"f64")
        }
        return false
      },
    )
  }
  if suffix.present { contextual = false }
  if contextual {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      ty = Shared<Type>.clone(&value)
    }
  } else {
    let mut spelling = run Bytes.copy(b"f64")
    if suffix.present { spelling = run bodyText(&resolver.source, cursor, suffix.symbol) }
    if !same(Bytes.asSlice(&spelling), b"f32") && !same(Bytes.asSlice(&spelling), b"f64") { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
    ty = run primitiveType(Bytes.asSlice(&spelling))
  }
  form = BodyExpression.Float {literal: run anchoredNode(cursor, expression)}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

effect fn checkSourceTextLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  ty = run intrinsicValueType(IntrinsicValueKind.StaticText)
  form = BodyExpression.Text {literal: run anchoredNode(cursor, expression)}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

// A byte-string literal is a shared `&'static [u8]` view of its exact bytes (TEXT-001).
effect fn checkSourceBytesLiteral(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId,
  nodes: &mut List<BodyNode>,
  expression: HirId,
  span: Span,
  expected: &Option<Shared<Type>>, mismatchCode: RejectionCode,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  initialType: Shared<Type>,
  initialForm: BodyExpression,
  initialDiverges: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut ty = move initialType
  let mut form = move initialForm
  let mut diverges = initialDiverges
  if staticBody { return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span) }
  ty = run Types.intern(Type.Slice {
    element: run primitiveType(b"u8"), access: Access.Shared, lifetime: run Shared<Lifetime>.make(Lifetime.Static),
  })
  form = BodyExpression.Text {literal: run anchoredNode(cursor, expression)}
  return run finishExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, constraints, &mut nodes.*,
    expression, span, move ty, move form,
    diverges, expected, mismatchCode, contractBody, staticBody)
}

