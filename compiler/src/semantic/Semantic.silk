/// The semantic fact selected by a query key.
pub enum Family {
  /// All candidates for one written name.
  Name,
  /// One imported namespace or selected member.
  Import,
  /// The target of a type alias.
  Alias,
  /// A nominal declaration's identity.
  Identity,
  /// The ordered names or positions declared by one nominal aggregate.
  Members,
  /// The written types of one requested field, position, or variant payload.
  MemberShape,
  /// The binders and declared bounds of a type, alias, interface, or service declaration.
  Contract,
  /// The ordered operation declarations of an interface or service.
  Operations,
  /// The resolved heads of every `impl` declaration in one module.
  Implementations,
  /// The resolved head of one `impl` declaration.
  ImplementationHead,
  /// The published inherent members of one nominal owner across its module's inherent `impl`s.
  InherentMembers,
  /// Every conformance head for one interface or service and one provider owner, read from only
  /// the modules permitted to own such a conformance.
  ConformanceHeads,
  /// The written members of one conformance or sealed-property `impl`, with mapped targets resolved.
  ImplementationMembers,
  /// Whether one conformance `impl` is coherent: every parameter is determined by its head, every
  /// bound descends through the provider, and no other head of its complete owner bucket could
  /// name the same goal.
  Coherence,
  /// The conditional bounds of one exact conformance head applied to a requested goal.
  ProofBounds,
  /// How many lifetimes a struct, tuple, or union generates for lifetimes its fields leave unwritten.
  FieldLifetimes,
  /// The types written on a function header.
  Signature,
  /// A contract operation's signature under one conformance `impl`: the contract's binders take
  /// the head's contract arguments and `Self` takes its provider. The key is the implementation's
  /// module and ordinal; `member` is the operation's position in its contract's operation list.
  OperationUnder,
  /// A contract operation's signature with applied interface arguments and `Self`, independent
  /// of which declared bound or concrete witness proves the application.
  AppliedOperation,
  /// An inherent member's signature under its nominal owner's applied arguments and `Self`.
  AppliedInherent,
  /// Which member implements each contract operation of one conformance `impl`, each checked
  /// against its operation's header under the conformance head. No member body is read.
  Witnesses,
  /// The written type of a constant declaration, independent of its initializer.
  Constant,
  /// The concrete header of one explicitly registered package parameter.
  ParameterSchema,
  /// One registered parameter's evaluated source default.
  ParameterDefault,
  /// The complete selected value of a constant initializer.
  Initializer,
  /// The explicitly supplied, content-interned build profile.
  ProfileInput,
  /// One checked ordinary function body.
  Body,
  /// A backend-neutral control-flow graph for one closed runtime instance.
  Mir,
  /// Scalar storage and ABI facts for one type on this store's target.
  Layout,
  /// LLVM text emitted from MIR and demanded layouts for one instance.
  Instance,
}

/// A function contract resolved from its written header, including binders, bounds, and channels.
///
/// # Details
///
/// The contract describes what callers may rely on. Bounds are recorded, not proved; channels are
/// declared upper bounds, not facts derived from the body.
pub struct Signature {
  /// The declaration-owned ordinary type parameters in written order.
  pub typeParameters: Vector<Shared<Type>>
  /// The declaration-owned written and elided lifetime parameters.
  pub lifetimeParameters: Vector<Shared<Lifetime>>
  /// The declaration-owned `?R` requirement-row parameters in written order.
  pub rowParameters: Vector<RowParameter>
  /// The declared binder bounds in written order.
  pub constraints: Vector<Constraint>
  /// The parameter types in written order.
  pub parameters: Vector<Shared<Type>>
  /// The written result type, or unit when omitted. For `effect fn`, the Effect's success type.
  pub result: Shared<Type>
  /// The declared failure type; `never` when omitted.
  pub failure: Shared<Type>
  /// The declared requirement row; empty when omitted.
  pub requirements: Shared<Row>
  /// Whether `effect` was written, so calling constructs an Effect with these channels.
  pub isEffect: bool
  /// Whether `unsafe` was written, so a complete invocation needs an `unsafe` acknowledgement.
  pub isUnsafe: bool
  /// The environment of the Effect constructed by calling an `effect fn`. It is either written, or
  /// elaborated from the captured inputs as the intersection of the regions they retain (`'static`
  /// when they retain none). An `effect fn` whose omitted environment would retain generic stored
  /// contents is rejected, so an `effect fn` always has one. `None` means an ordinary function.
  pub environment: Option<Intersection>
}

/// The binders and bounds declared by a type, alias, interface, or service declaration.
///
/// # Details
///
/// The contract records what every application must satisfy. It proves nothing about a particular
/// application; applying a bounded declaration proves its instantiated constraints.
pub struct Contract {
  /// The declaration-owned ordinary type parameters in written order.
  pub typeParameters: Vector<Shared<Type>>
  /// The declaration-owned written and elided lifetime parameters.
  pub lifetimeParameters: Vector<Shared<Lifetime>>
  /// The declaration-owned `?R` requirement-row parameters in written order.
  pub rowParameters: Vector<RowParameter>
  /// The declared binder bounds in written order.
  pub constraints: Vector<Constraint>
  /// The implicit `Self` provider of an interface or service, bound after the written binders;
  /// absent for every other declaration.
  pub provider: Option<Shared<Type>>
}

/// One declared generic bound. It states a requirement; it does not select or prove a conformance.
pub union Constraint {
  /// `T: Contract<Arguments>` requires the provider to conform to an interface or service.
  Conforms {pub provider: Shared<Type>, pub contract: Shared<Type>},
  /// `F: fn(A) -> B` or `F: once Effect<A>` binds one exact executable representation that
  /// satisfies the callable or Effect use contract.
  Represents {pub parameter: Shared<Type>, pub contract: Shared<Type>},
  /// `T: 'region` requires the borrowed contents of `T` to remain valid for the region.
  Contents {pub subject: Shared<Type>, pub region: Shared<Lifetime>},
  /// `'longer: 'shorter` requires the first lifetime to cover the second.
  Outlives {pub longer: Shared<Lifetime>, pub shorter: Shared<Lifetime>},
  /// `T: Copy` requires the compiler-sealed Copy property, which no ordinary interface supplies.
  Copyable {pub subject: Shared<Type>},
  /// `F: Intrinsic.Detached` or `F: Intrinsic.NonParking` requires one sealed compiler property of
  /// an executable. It is a witness-free static obligation, not an interface or service.
  Property {pub subject: Shared<Type>, pub property: IntrinsicProperty},
}

/// One normalized compile-time conformance goal.
pub struct ConformanceGoal {
  pub contract: Shared<Type>
  pub provider: Shared<Type>
}

/// The exact evidence used at one step of a conformance proof.
pub union ConformanceEvidence {
  /// A bound written on the declaration being checked.
  Declared {pub bound: Constraint},
  /// A coherent concrete implementation, with its head binders matched to the goal.
  Concrete {pub head: Shared<ImplementationHead>, pub bindings: Vector<Binding>},
}

/// One goal and the evidence that discharged it.
pub struct ConformanceStep {
  pub goal: ConformanceGoal
  pub evidence: ConformanceEvidence
}

/// Complete compile-time evidence for a requested goal and all its conditional requirements.
pub struct ConformanceProof {
  pub steps: Vector<ConformanceStep>
}

/// The result of proving a goal without selecting a runtime provider.
pub union ConformanceDecision {
  Proven {pub proof: ConformanceProof},
  /// The chain starts at the requested goal and ends at the failed requirement.
  Rejected {pub diagnostic: Shared<Rejection>, pub chain: Vector<ConformanceGoal>},
}

/// A sealed compiler property that refines an executable representation bound.
pub enum IntrinsicProperty {
  /// The executable retains no external lexical or provider loan.
  Detached,
  /// The specialized transitive graph cannot reach external parking.
  NonParking,
}

/// A compiler-sealed language property an `impl` may request. It is not an ordinary interface:
/// eligibility is checked by the language, and users cannot supply its behavior.
pub enum SealedProperty {
  /// Duplication without running user code.
  Copy,
  /// One restricted automatic cleanup hook.
  Drop,
}

/// What one `impl` declaration implements.
pub union ImplementationKind {
  /// `impl Owner { ... }` declares inherent members of one nominal owner.
  Inherent,
  /// `impl Contract for Provider` conforms the provider to the head's interface or service.
  Conformance,
  /// `impl Copy for Provider` or `impl Drop for Provider` requests a sealed property.
  Sealed {pub property: SealedProperty},
}

/// One written member of a conformance or sealed-property `impl`.
///
/// # Details
///
/// The member's name is its declaration's name. Matching members to contract operations and
/// checking their contracts is witness validation, not part of this list.
pub union ImplementationMember {
  /// An operation defined inline by a function declared in the `impl`.
  Inline {pub declaration: Shared<DeclarationId>, pub span: Span},
  /// `name: Path` maps an operation to one existing function, resolved from its header path only.
  Mapped {pub declaration: Shared<DeclarationId>, pub span: Span, pub target: Shared<DeclarationId>},
}

/// The member that implements one contract operation in a conformance.
///
/// # Details
///
/// A witness is compile-time evidence that the implementation's header satisfies the operation's
/// header under the conformance head. It proves no conformance, and its implementation's body is
/// not read.
pub struct Witness {
  /// The contract operation.
  pub operation: Shared<DeclarationId>
  /// The inline function or mapped target that implements it.
  pub implementation: Shared<DeclarationId>
  /// The matched arguments for the implementation's written and elided binders.
  pub arguments: Vector<Argument>
}

/// An inherent member that is not published, with the anchored reason.
pub struct RejectedMember {
  /// The rejected member declaration.
  pub declaration: Shared<DeclarationId>
  /// Why the member is not an associated item of its owner.
  pub rejection: Shared<Rejection>
}

/// The resolved head of one `impl` declaration, without its members.
///
/// # Details
///
/// The binders are the written `impl` binders followed by lifetimes elided from its heads, with
/// the written bounds recorded, not proved. The provider is what `Self` denotes inside the
/// implementation; its nominal declaration, or its foundational scalar or `string` spelling, is
/// the provider owner. A head claims only that its declaration is well formed and permitted in its
/// module; it proves no conformance and checks no member.
pub struct ImplementationHead {
  /// The `impl` declaration.
  pub declaration: Shared<DeclarationId>
  /// Whether it is inherent, a conformance, or a sealed property.
  pub kind: ImplementationKind
  /// The implementation's binders and bounds.
  pub binders: Contract
  /// The applied interface or service of a conformance; absent otherwise.
  pub contract: Option<Shared<Type>>
  /// The applied provider or inherent owner.
  pub provider: Shared<Type>
  /// The whole `impl` header.
  pub span: Span
  /// The written contract, or the inherent owner for an inherent `impl`.
  pub contractSpan: Span
  /// The written provider after `for`, or the inherent owner.
  pub providerSpan: Span
  /// Each written binder, in written order; generated lifetimes have no span.
  pub binderSpans: Vector<Span>
  /// Each written bound, parallel to `binders.constraints`.
  pub boundSpans: Vector<Span>
}

/// One declared nominal member; tuple positions have no written name.
pub struct Member {
  pub name: Option<Bytes>
  pub isPublic: bool
  pub kind: MemberKind
  /// Validated scalar enum value; absent for every other member kind.
  pub discriminant: Option<EnumCase>
}

/// The source form of a nominal member.
pub enum MemberKind {
  Field,
  Position,
  EnumCase,
  Variant,
}

/// The declared header of a package parameter, independent of its default's execution.
pub struct ParameterSchema {
  /// Alias-independent declaration identity.
  pub declaration: DeclarationId
  /// The written, resolved type.
  pub ty: Shared<Type>
  /// Only public parameters can receive an external binding.
  pub isPublic: bool
  /// Whether an initializer is written; a private parameter must have one.
  pub hasDefault: bool
  /// Whether final-profile validation is written.
  pub hasValidation: bool
  /// The retained source location of the header.
  pub span: Span
}

/// One explicitly registered parameter and its demandable header answer.
pub struct RegisteredParameter {
  pub module: ModuleId
  pub name: Bytes
  pub identity: DeclarationId
  pub answer: Shared<Result<Answer, NoRejection>>
}

struct RegisteredName {
  name: Bytes
  identity: DeclarationId
}

/// A statically known local visible to one reached expression in a mixed body.
/// Parameter types come from the written signature; prior checked roots must agree with a binding's annotation.
pub union StaticRootBinder {
  Parameter {pub syntax: HirId},
  Binding {pub syntax: HirId, pub checked: Shared<Result<Answer, NoRejection>>},
}

/// The context that selects the type of a reached static expression.
pub union StaticRootExpectation {
  Inferred,
  Boolean,
  /// Widen bare integer arithmetic for value admission without changing declared types.
  IntegerExtent,
  Resolved {pub ty: Shared<Type>},
  Annotation {pub syntax: HirId},
}

/// One completed semantic query value.
pub union Value {
  /// The complete syntactic name bucket, including an empty bucket.
  Name {pub bucket: Shared<NameObservation>},
  /// A namespace import's target module.
  Namespace {pub module: ModuleId, pub ordinal: usize},
  /// A selected import's canonical target declaration.
  Selected {pub declaration: DeclarationId, pub module: usize, pub ordinal: usize},
  /// An alias target or nominal type identity.
  Type {pub resolved: Shared<Type>},
  /// Ordered member names without resolving any member's type.
  Members {pub identity: Shared<DeclarationId>, pub members: Vector<Member>, pub enumRepresentation: StaticIntegerType},
  /// Resolved types of only the selected member; zero for a scalar enum case.
  MemberShape {pub types: Vector<Shared<Type>>},
  /// A declaration's binders and bounds.
  Contract {pub contract: Contract},
  /// An interface's or service's operation declarations in written order.
  Operations {pub operations: Vector<Shared<DeclarationId>>},
  /// Every `impl` head of one module in written order; empty when the module has none.
  Implementations {pub heads: Vector<Shared<ImplementationHead>>},
  /// One `impl` declaration's head.
  ImplementationHead {pub head: Shared<ImplementationHead>},
  /// An owner's inherent members. A member that duplicates another or claims an owner item's name
  /// is not published; its anchored rejection is kept instead, and no winner is chosen.
  InherentMembers {pub members: Vector<Shared<DeclarationId>>, pub rejected: Vector<RejectedMember>},
  /// The conformance heads relevant to one contract and provider owner; empty observes absence.
  ConformanceHeads {pub heads: Vector<Shared<ImplementationHead>>},
  /// A conformance `impl` is coherent. It proves no bound and admits no witness by itself.
  Coherent,
  /// Conditional bounds after the selected head's exact bindings have been applied.
  ProofBounds {pub constraints: Vector<Constraint>},
  /// A conformance's members in written order; empty observes that it writes none.
  ImplementationMembers {pub members: Vector<ImplementationMember>},
  /// The generated lifetime count of one struct, tuple, or union.
  FieldLifetimes {pub count: usize},
  /// A function's written signature.
  Signature {pub signature: Signature},
  /// A conformance's implementations in its contract's operation order.
  Witnesses {pub witnesses: Vector<Witness>},
  /// A constant's initializer value at the type published by its `Constant` fact.
  Initializer {pub value: Shared<StaticData>},
  /// A package parameter's checked declaration header.
  ParameterSchema {pub schema: Shared<ParameterSchema>},
  /// A reached registered default, checked at the declaration's resolved type.
  ParameterDefault {pub value: Shared<StaticData>, pub span: Span},
  /// The content-interned profile slot observed by a sealed static query.
  ProfileInput {pub slot: usize},
  /// A complete checked ordinary function body with source ownership for its syntax positions.
  Body {
    /// The checked payload, whose local syntax positions match `source`.
    pub body: Shared<TypedBody>,
    /// The current source observation that owns every syntax position in `body`.
    pub source: Shared<Observation>,
  },
  /// The position of a MIR answer in this store's immutable answer arena.
  Mir {pub index: usize},
  /// The position of a target layout answer in this store's immutable answer arena.
  Layout {pub index: usize},
  /// This target-neutral type has no layout in the current backend subset.
  LayoutUnsupported,
  /// The position of LLVM text in this store's immutable answer arena.
  Instance {pub index: usize},
  /// A reached backend form outside the current implementation.
  Unsupported {pub gap: Shared<BackendGap>},
}

/// Whole-program assembly of demanded instance text, with reached unsupported forms preserved.
pub union BackendBuild {
  Module {pub text: Bytes},
  Unsupported {pub gaps: Vector<Shared<BackendGap>>},
  Rejected {pub diagnostic: Shared<Rejection>},
}

/// A direct query dependency retained with a completed semantic answer.
pub struct Dependency {
  /// The demanded query family.
  pub family: Family
  /// The module whose namespace or declaration was demanded.
  pub module: ModuleId
  /// The demanded name for a name query, if any.
  pub name: Option<Bytes>
  /// The canonical declaration for a declaration query, if any.
  pub declaration: Option<DeclarationId>
  /// The selected import-member ordinal, absent for namespace imports and other families.
  pub member: Option<usize>
  /// Whether a name query used the importing module's public-member view.
  pub external: bool
}

struct DemandFootprint {
  dependency: Dependency
}

/// A successful fact or anchored semantic rejection.
pub union Outcome {
  /// A resolved fact.
  Success {pub value: Value},
  /// A completed semantic rejection.
  Rejected {pub diagnostic: Shared<Rejection>},
}

/// One completed outcome, direct nested demands, and exact source observations.
pub struct Answer {
  /// The resolved fact or semantic rejection.
  pub outcome: Outcome
  /// Every direct nested query demanded to produce the fact, including memo hits.
  pub dependencies: Vector<Dependency>
  /// Every transitive present or absent source path for revision validation.
  pub sources: Vector<Shared<Observation>>
  footprint: Vector<Shared<DemandFootprint>>
  answerId: usize
  identity: Option<Shared<Value>>
  // A completed body answer owns its direct-result evidence with the Query entry.
  bodyEvidence: Option<Shared<BodyEvidence>>
}

struct Root {
  family: Family
  module: ModuleId
  name: Bytes
  answer: Shared<Result<Answer, NoRejection>>
}

/// The roots and discovered facts of one semantic request.
///
/// # Details
///
/// A request retains only its own roots. A completed answer keeps its transitive demand and source
/// observations, so a cache hit supplies the same discovery evidence to a new request.
pub struct Request {
  roots: Vector<Root>
  application: Option<ModuleId>
  schemaModules: Vector<ModuleId>
}

/// Registration cannot change after this request starts demanding facts.
pub struct RegistrationClosed {}

/// Two source origins claim the same logical package in one request.
pub struct ConflictingPackageSource {}

/// One query event in demand order.
pub struct Event {
  /// Whether the query started, reused, or completed.
  pub kind: EventKind
  /// The family of the queried fact.
  pub family: Family
  /// The key ordinal within this held semantic store.
  pub key: usize
}

/// The lifecycle stage of an observable semantic query event.
pub enum EventKind {
  /// The query provider began work on a missing or invalid answer.
  Start,
  /// The query reused a completed answer.
  Hit,
  /// A checked body kept its typed payload after current inputs and child results validated.
  Reuse,
  /// The query provider completed and stored an answer.
  Finish,
}

struct Key {
  family: Family
  module: usize
  name: usize
  declaration: usize
  member: usize
  external: bool
}

impl Copy for Key {}

struct ScopedKey {
  key: Key
  application: usize
  profile: usize
}

impl Copy for ScopedKey {}

struct InstanceLocation {
  module: usize
  declaration: usize
}

impl Copy for InstanceLocation {}

struct Selection {
  count: usize
  publicCount: usize
  declaration: usize
  member: usize
  kind: CandidateKind
  span: Span
  isPublic: bool
}

impl Copy for Selection {}

struct HeaderSyntax {
  header: Node
  span: Span
}

impl Copy for HeaderSyntax {}

struct PathSyntax {
  segments: Vector<Bytes>
  span: Span
  valid: bool
}

struct WrittenSignature {
  generics: Range
  parameters: Vector<HirId>
  result: Option<HirId>
  failures: HirRef
  requirements: HirRef
  environment: RangeRef
  isEffect: bool
  isUnsafe: bool
  isStatic: bool
  isPublic: bool
  supported: bool
  span: Span
}

union Binder {
  Type {name: Bytes, value: Shared<Type>},
  Lifetime {name: Bytes, value: Shared<Lifetime>},
  // `bound` is the row supplied by an application; an unapplied binder stays a row parameter.
  Row {name: Bytes, value: RowParameter, bound: Option<Shared<Row>>},
}

struct LifetimeElision {
  owner: Option<DeclarationId>
  nextOrdinal: usize
  output: bool
  resultDefault: Option<Shared<Lifetime>>
  generated: Vector<Shared<Lifetime>>
  // Inside a callable contract, an omitted input lifetime is a fresh invocation binder.
  invocation: bool
  // Inside an invocation-quantified contract, a further quantifier is outside the language.
  nested: bool
  // Maps a provisional invocation ordinal to its canonical first-occurrence ordinal; empty when
  // the provisional numbering is already canonical.
  renumber: Vector<usize>
  // Set only while resolving the `Effect` result of a function with no parameters, whose omitted
  // environment is `'static`. The first environment elided under it consumes it.
  staticEnvironment: bool
  // Arguments for declaration-owned elided lifetimes in an instantiated signature.
  supplied: Option<Vector<Argument>>
  // Bounds already declared by the enclosing generic declaration while resolving its body.
  assumptions: Option<Vector<Constraint>>
}

struct Channels {
  failure: Shared<Type>
  requirements: Shared<Row>
}

struct TypeSelection {
  resolved: Option<Shared<Type>>
  rejected: Option<Shared<Rejection>>
}

struct ResolvedAnnotation {
  id: HirId
  result: Result<Shared<Type>, Shared<Rejection>>
}

struct ImportSelection {
  module: Option<usize>
  declaration: Option<usize>
  rejected: Option<Shared<Rejection>>
}

struct SelectedDeclaration {
  module: usize
  ordinal: usize
}

struct CallTarget {
  declaration: DeclarationId
  isPublic: bool
  signature: Shared<Result<Answer, NoRejection>>
  explicit: Vector<Argument>
}

// An authored name resolves to a source function, a constant, or a sealed primitive.
union ResolvedTarget {
  Function {target: CallTarget},
  Constant {declaration: DeclarationId, ty: Shared<Type>},
  Intrinsic {member: IntrinsicMember},
}

// A selected static operation. The caller uses the contract signature, while `implementation`
// names the concrete body required at runtime; a declared bound has no concrete body yet.
struct OperationCall {
  operation: DeclarationId
  implementation: Option<Shared<DeclarationId>>
  signature: Shared<Result<Answer, NoRejection>>
  proof: ConformanceProof
  receiver: Option<ReceiverPosition>
}

struct OperatorCandidate {
  contract: Shared<Type>
  provider: Shared<Type>
  operationModule: usize
  operationOrdinal: usize
}

struct SelectedOperator {
  contract: Shared<Type>
  provider: Shared<Type>
  call: OperationCall
}

// Duplicate bound spellings or the same head observed from two permitted owner buckets still
// name one supplier. Coherence of that exact goal is checked by the common proof after selection.
effect fn addOperatorCandidate(
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operationModule: usize,
  operationOrdinal: usize,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = Vector.asSlice<OperatorCandidate>(&suppliers.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].operationModule == operationModule && listed[at].operationOrdinal == operationOrdinal {
      let sameContract = run Type.equalsShared(&listed[at].contract, contract)
      let sameProvider = run Type.equalsShared(&listed[at].provider, provider)
      if sameContract && sameProvider {
        return ()
      }
    }
    at = at + usize.ONE
  }
  let ordinal = Vector.length<OperatorCandidate>(&suppliers.*)
  run Vector.append<OperatorCandidate>(
    &mut suppliers.*,
    OperatorCandidate {
      contract: Shared.clone<Type>(contract),
      provider: Shared.clone<Type>(provider),
      operationModule: operationModule,
      operationOrdinal: operationOrdinal,
    },
  )
  CallSelection.add(&mut choice.*, ordinal)
  return ()
}

struct ReceiverPosition {
  ordinal: usize
  mode: BodyReceiverPass
}

struct MethodSupplier {
  contract: Shared<Type>
  operationModule: usize
  operationOrdinal: usize
  receiver: ReceiverPosition
}

struct SelectedReceiverOperation {
  contract: Shared<Type>
  call: OperationCall
}

union ReceiverCallChoice {
  Inherent {target: CallTarget, receiver: ReceiverPosition},
  Interface {selected: SelectedReceiverOperation},
}

struct VisibleName {
  module: usize
  name: Bytes
  external: bool
}

struct VisibleInterface {
  module: usize
  ordinal: usize
}

union InherentCallChoice {
  Missing,
  Claimed,
  Selected {target: CallTarget, receiver: Option<ReceiverPosition>},
}

impl Copy for ReceiverPosition {}

union CallReference {
  Named {name: Bytes},
  // A value read with no local binding. It selects a module declaration only to reject it: reading
  // a constant, function, or other declaration is outside the scalar body subset.
  Unbound {name: Bytes},
  Qualified {namespace: Bytes, member: Bytes, subjectSpan: Span, memberSpan: Span},
  NonCallable,
  Unsupported,
}

struct CallSyntax {
  id: HirId
  span: Span
  reference: CallReference
  generics: HirRef
}

struct ResolvedCall {
  id: HirId
  result: Result<ResolvedTarget, Shared<Rejection>>
}

struct PreparedBody {
  block: HirId
  identity: DeclarationId
  locals: Vector<BodyLocal>
  contractBody: bool
  staticBody: bool
}

struct QualifiedBodyName {
  namespace: Bytes
  member: Bytes
  subjectSpan: Span
}

struct CheckedControl {
  node: BodyNodeId
  canComplete: bool
}

struct Resolver {
  source: SourceIndex
  baseTarget: MachineTarget
  target: MachineTarget
  initialProfile: Option<FinalProfile>
  profiles: Vector<FinalProfile>
  profileSlot: usize
  mirValues: Vector<MirFunction>
  layoutValues: Vector<BackendLayout>
  instanceTexts: Vector<Bytes>
  instanceSymbols: Vector<Bytes>
  modules: Vector<ModuleId>
  names: Vector<Bytes>
  applications: Vector<Shared<Type>>
  backendInstances: Vector<InstanceKey>
  keys: Vector<ScopedKey>
  // The request-selected application module ordinal, or MAX when no binding was supplied.
  currentApplication: usize
  active: Vector<Word>
  frames: Vector<SourceFrame>
  events: Vector<Event>
  nextAnswerId: usize
}

fn selectedProfile<'a>(resolver: &'a Resolver) -> Option<&'a FinalProfile> {
  if resolver.profileSlot == usize.ZERO {
    return Option.none<&FinalProfile>()
  }
  if resolver.profileSlot == usize.ONE {
    return match &resolver.initialProfile {
      Option<FinalProfile>.Some {value} => Option.some<&FinalProfile>(&value)
      Option<FinalProfile>.None => Option.none<&FinalProfile>()
    }
  }
  let profiles = Vector.asSlice<FinalProfile>(&resolver.profiles)
  let index = resolver.profileSlot - 2
  if index < profiles.length {
    return Option.some<&FinalProfile>(&profiles[index])
  }
  return Option.none<&FinalProfile>()
}

struct SourceFrame {
  observations: Vector<Shared<Observation>>
  footprint: Vector<Shared<DemandFootprint>>
  direct: Vector<BodyDependency>
}

struct BodyDependency {
  key: Key
  declaration: Option<Shared<DeclarationId>>
  answerId: usize
  identity: Option<Shared<Value>>
}

struct BodyEvidence {
  direct: Vector<BodyDependency>
}

struct BodyCandidate {
  body: Shared<TypedBody>
  evidence: Shared<BodyEvidence>
  directCount: usize
}

struct Running<'a, 'b> {
  resolver: &'a mut Resolver
  query: &'b mut Query<Word, Answer, NoRejection>
  key: Word
  base: usize
}

/// A serial semantic store for one immutable in-memory revision.
///
/// # Details
///
/// Semantic rejections are completed answers. Provider failures leave a key available for retry.
/// This actor keeps query events and direct dependencies for later request replay.
pub struct Semantic {
  resolver: Resolver
  query: Query<Word, Answer, NoRejection>
}

/// A short loan of an active semantic query for static call resolution.
/// Its dependency ledger is the caller's ledger, including an in-flight initializer.
pub struct StaticPort<'source> {
  resolver: &'source mut Resolver
  query: &'source mut Query<Word, Answer, NoRejection>
  dependencies: &'source mut Vector<Dependency>
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn bytesLess(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] < right[at] {
      return true
    }
    if left[at] > right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return left.length < right.length
}

fn validAnswer(answer: &Result<Answer, NoRejection>, source: &SourceIndex) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let observations = Vector.asSlice<Shared<Observation>>(&value.sources)
      let mut at = usize.ZERO
      while at < observations.length {
        if !Shared.with<Observation, bool>(
          &observations[at],
          fn(observed: &Observation) -> bool {
            return SourceIndex.matchesObservation(source, observed)
          },
        ) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// Shared.with takes an exclusive runtime borrow, including for inspection. Compare aliases
// before entering the other handle in the structural comparators below.
fn sameAllocation<T>(left: &Shared<T>, right: &Shared<T>) -> bool {
  let first = Shared.with<T, usize>(
    left,
    fn(value: &T) -> usize {
      return Pointer.address<T>(Pointer.fromRef<T>(value))
    },
  )
  let second = Shared.with<T, usize>(
    right,
    fn(value: &T) -> usize {
      return Pointer.address<T>(Pointer.fromRef<T>(value))
    },
  )
  return first == second
}

fn sameBucketWith(first: &NameObservation, other: &Shared<NameObservation>) -> bool {
  return Shared.with<NameObservation, bool>(
    other,
    fn(second: &NameObservation) -> bool {
      return NameObservation.equals(first, second)
    },
  )
}

fn sameBuckets(left: &Shared<NameObservation>, right: &Shared<NameObservation>) -> bool {
  if sameAllocation<NameObservation>(left, right) {
    return true
  }
  return Shared.with<NameObservation, bool>(
    left,
    fn(first: &NameObservation) -> bool {
      return sameBucketWith(first, right)
    },
  )
}

fn reusableTypeKind(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {..} => usize.ONE
    Type.Unit => 2
    Type.Nominal {..} => 3
    Type.NamedRepresentation {..} => 13
    Type.OpaqueRepresentation {..} => 14
    Type.Parameter {..} => 4
    Type.String {..} => 5
    Type.Reference {..} => 6
    Type.Slice {..} => 7
    Type.Pointer {..} => 8
    Type.Array {..} => 9
    Type.Union {..} => 10
    Type.Callable {..} => 11
    Type.Effect {..} => 12
  }
}

fn primitiveLength(value: &Type) -> usize {
  return match & value.* {
    Type.Primitive {name} => Bytes.asSlice(&name).length
    _ => usize.ZERO
  }
}

fn primitiveByte(value: &Type, at: usize) -> u8 {
  return match & value.* {
    Type.Primitive {name} => Bytes.asSlice(&name)[at]
    _ => 0
  }
}

fn sameOptionalAlignment(left: &Option<u64>, right: &Option<u64>) -> bool {
  return match & left.* {
    Option<u64>.Some {value} => match & right.* {
      Option<u64>.Some {value: other} => value == other
      Option<u64>.None => false
    }
    Option<u64>.None => match & right.* {
      Option<u64>.Some {value: _} => false
      Option<u64>.None => true
    }
  }
}

fn sameIntersectionWith(first: &Intersection, right: &Shared<Intersection>) -> bool {
  return Shared.with<Intersection, bool>(
    right,
    fn(second: &Intersection) -> bool {
      return Intersection.equals(first, second)
    },
  )
}

fn sameIntersection(left: &Shared<Intersection>, right: &Shared<Intersection>) -> bool {
  if sameAllocation<Intersection>(left, right) {
    return true
  }
  return Shared.with<Intersection, bool>(
    left,
    fn(first: &Intersection) -> bool {
      return sameIntersectionWith(first, right)
    },
  )
}

fn sameOutlives(left: &[Outlives], right: &[Outlives]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !Lifetime.equalsShared(&left[at].longer, &right[at].longer) || !Lifetime.equalsShared(
      &left[at].shorter,
      &right[at].shorter,
    ) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameReusableType(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if sameAllocation<Type>(left, right) {
    return true
  }
  let first = Shared.with<Type, usize>(left, reusableTypeKind)
  let second = Shared.with<Type, usize>(right, reusableTypeKind)
  if first != second {
    return false
  }
  if first == 2 {
    return true
  }
  if first == usize.ONE {
    let length = Shared.with<Type, usize>(left, primitiveLength)
    if length != Shared.with<Type, usize>(right, primitiveLength) {
      return false
    }
    let mut at = usize.ZERO
    while at < length {
      let from = Shared.with<Type, u8>(
        left,
        fn(value: &Type) -> u8 {
          return primitiveByte(value, at)
        },
      )
      let to = Shared.with<Type, u8>(
        right,
        fn(value: &Type) -> u8 {
          return primitiveByte(value, at)
        },
      )
      if from != to {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
  return Shared.with<Type, bool>(
    left,
    fn(value: &Type) -> bool {
      return sameReusableTypeWith(value, right)
    },
  )
}

fn sameReusableTypeWith(value: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(other: &Type) -> bool {
      return match & value.* {
        Type.Nominal {declaration, arguments, ..} => match & other.* {
          Type.Nominal {declaration: selected, arguments: supplied, ..} => DeclarationId.equals(
            &declaration,
            &selected,
          ) && sameArguments(
            Vector.asSlice<Argument>(&arguments),
            Vector.asSlice<Argument>(&supplied),
          )
          _ => false
        }
        Type.NamedRepresentation {declaration, arguments, ..} => match & other.* {
          Type.NamedRepresentation {declaration: selected, arguments: supplied, ..} => DeclarationId.equals(
            &declaration,
            &selected,
          ) && sameArguments(
            Vector.asSlice<Argument>(&arguments),
            Vector.asSlice<Argument>(&supplied),
          )
          _ => false
        }
        Type.Parameter {declaration, ordinal} => match & other.* {
          Type.Parameter {declaration: selected, ordinal: position} => DeclarationId.equals(
            &declaration,
            &selected,
          ) && ordinal == position
          _ => false
        }
        Type.String {lifetime} => match & other.* {
          Type.String {lifetime: validity} => Lifetime.equalsShared(&lifetime, &validity)
          _ => false
        }
        Type.Reference {referent, access, lifetime} => match & other.* {
          Type.Reference {referent: target, access: selected, lifetime: validity} => access == selected && Lifetime.equalsShared(
            &lifetime,
            &validity,
          ) && sameReusableType(&referent, &target)
          _ => false
        }
        Type.Slice {element, access, lifetime} => match & other.* {
          Type.Slice {element: target, access: selected, lifetime: validity} => access == selected && Lifetime.equalsShared(
            &lifetime,
            &validity,
          ) && sameReusableType(&element, &target)
          _ => false
        }
        Type.Pointer {pointee, access, nullable, multiplicity, alignment} => match & other.* {
          Type.Pointer {
            pointee: target,
            access: selected,
            nullable: otherNullable,
            multiplicity: otherMultiplicity,
            alignment: otherAlignment,
          } => access == selected && nullable == otherNullable && multiplicity == otherMultiplicity && sameOptionalAlignment(
            &alignment,
            &otherAlignment,
          ) && sameReusableType(&pointee, &target)
          _ => false
        }
        Type.Array {element, extent} => match & other.* {
          Type.Array {element: target, extent: length} => same(
            Bytes.asSlice(&extent),
            Bytes.asSlice(&length),
          ) && sameReusableType(&element, &target)
          _ => false
        }
        Type.Union {members} => match & other.* {
          Type.Union {members: otherMembers} => sameTypeList(
            Vector.asSlice<Shared<Type>>(&members),
            Vector.asSlice<Shared<Type>>(&otherMembers),
          )
          _ => false
        }
        Type.OpaqueRepresentation {producer, arguments, contract, detached, nonParking} => match & other.* {
          Type.OpaqueRepresentation {
            producer: otherProducer,
            arguments: supplied,
            contract: useContract,
            detached: otherDetached,
            nonParking: otherNonParking,
          } => DeclarationId.equals(&producer, &otherProducer) && sameArguments(
            Vector.asSlice<Argument>(&arguments),
            Vector.asSlice<Argument>(&supplied),
          ) && sameReusableType(&contract, &useContract) && detached == otherDetached && nonParking == otherNonParking
          _ => false
        }
        Type.Callable {
          mode,
          isUnsafe,
          environment,
          invocationBinders,
          invocationBounds,
          parameters,
          result,
        } => match & other.* {
          Type.Callable {
            mode: otherMode,
            isUnsafe: otherUnsafe,
            environment: otherEnvironment,
            invocationBinders: otherBinders,
            invocationBounds: otherBounds,
            parameters: otherParameters,
            result: otherResult,
          } => mode == otherMode && isUnsafe == otherUnsafe && sameIntersection(
            &environment,
            &otherEnvironment,
          ) && invocationBinders == otherBinders && sameOutlives(
            Vector.asSlice<Outlives>(&invocationBounds),
            Vector.asSlice<Outlives>(&otherBounds),
          ) && sameTypeList(
            Vector.asSlice<Shared<Type>>(&parameters),
            Vector.asSlice<Shared<Type>>(&otherParameters),
          ) && sameReusableType(&result, &otherResult)
          _ => false
        }
        Type.Effect {mode, environment, success, failure, requirements} => match & other.* {
          Type.Effect {
            mode: otherMode,
            environment: otherEnvironment,
            success: otherSuccess,
            failure: otherFailure,
            requirements: otherRequirements,
          } => mode == otherMode && sameIntersection(&environment, &otherEnvironment) && sameReusableType(
            &success,
            &otherSuccess,
          ) && sameReusableType(&failure, &otherFailure) && sameRow(
            &requirements,
            &otherRequirements,
          )
          _ => false
        }
        _ => false
      }
    },
  )
}

fn sameTypeOption(left: &Option<Shared<Type>>, right: &Option<Shared<Type>>) -> bool {
  return match & left.* {
    Option<Shared<Type>>.Some {value} => match & right.* {
      Option<Shared<Type>>.Some {value: other} => sameReusableType(&value, &other)
      Option<Shared<Type>>.None => false
    }
    Option<Shared<Type>>.None => match & right.* {
      Option<Shared<Type>>.Some {value: _} => false
      Option<Shared<Type>>.None => true
    }
  }
}

fn sameTypeList(left: &[Shared<Type>], right: &[Shared<Type>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameReusableType(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameDeclarationList(left: &[Shared<DeclarationId>], right: &[Shared<DeclarationId>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameDeclarationShared(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameReuseConstraint(left: &Constraint, right: &Constraint) -> bool {
  return match & left.* {
    Constraint.Conforms {provider, contract} => match & right.* {
      Constraint.Conforms {provider: otherProvider, contract: otherContract} => sameReusableType(
        &provider,
        &otherProvider,
      ) && sameReusableType(&contract, &otherContract)
      _ => false
    }
    Constraint.Represents {parameter, contract} => match & right.* {
      Constraint.Represents {parameter: otherParameter, contract: otherContract} => sameReusableType(
        &parameter,
        &otherParameter,
      ) && sameReusableType(&contract, &otherContract)
      _ => false
    }
    Constraint.Contents {subject, region} => match & right.* {
      Constraint.Contents {subject: otherSubject, region: otherRegion} => sameReusableType(
        &subject,
        &otherSubject,
      ) && Lifetime.equalsShared(&region, &otherRegion)
      _ => false
    }
    Constraint.Outlives {longer, shorter} => match & right.* {
      Constraint.Outlives {longer: otherLonger, shorter: otherShorter} => Lifetime.equalsShared(
        &longer,
        &otherLonger,
      ) && Lifetime.equalsShared(&shorter, &otherShorter)
      _ => false
    }
    Constraint.Copyable {subject} => match & right.* {
      Constraint.Copyable {subject: other} => sameReusableType(&subject, &other)
      _ => false
    }
    Constraint.Property {subject, property} => match & right.* {
      Constraint.Property {subject: other, property: otherProperty} => property == otherProperty && sameReusableType(
        &subject,
        &other,
      )
      _ => false
    }
  }
}

fn sameConstraints(left: &[Constraint], right: &[Constraint]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameReuseConstraint(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameRowParameters(left: &[RowParameter], right: &[RowParameter]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at].ordinal != right[at].ordinal || !sameDeclarationShared(
      &left[at].declaration,
      &right[at].declaration,
    ) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameRow(left: &Shared<Row>, right: &Shared<Row>) -> bool {
  if sameAllocation<Row>(left, right) {
    return true
  }
  return Shared.with<Row, bool>(
    left,
    fn(first: &Row) -> bool {
      return sameRowWith(first, right)
    },
  )
}

fn sameRowWith(first: &Row, right: &Shared<Row>) -> bool {
  return Shared.with<Row, bool>(
    right,
    fn(second: &Row) -> bool {
      let entries = Vector.asSlice<Requirement>(&first.entries)
      let otherEntries = Vector.asSlice<Requirement>(&second.entries)
      if entries.length != otherEntries.length || !sameRowParameters(
        Vector.asSlice<RowParameter>(&first.parameters),
        Vector.asSlice<RowParameter>(&second.parameters),
      ) {
        return false
      }
      let mut at = usize.ZERO
      while at < entries.length {
        if entries[at].access != otherEntries[at].access || !sameReusableType(
          &entries[at].capability,
          &otherEntries[at].capability,
        ) || !sameTypeOption(&entries[at].roleType, &otherEntries[at].roleType) {
          return false
        }
        at = at + usize.ONE
      }
      return true
    },
  )
}

fn sameEnvironment(left: &Option<Intersection>, right: &Option<Intersection>) -> bool {
  return match & left.* {
    Option<Intersection>.Some {value} => match & right.* {
      Option<Intersection>.Some {value: other} => Intersection.equals(&value, &other)
      Option<Intersection>.None => false
    }
    Option<Intersection>.None => match & right.* {
      Option<Intersection>.Some {value: _} => false
      Option<Intersection>.None => true
    }
  }
}

fn sameSignature(left: &Signature, right: &Signature) -> bool {
  return left.isEffect == right.isEffect && left.isUnsafe == right.isUnsafe && sameEnvironment(
    &left.environment,
    &right.environment,
  ) && sameTypeList(
    Vector.asSlice<Shared<Type>>(&left.typeParameters),
    Vector.asSlice<Shared<Type>>(&right.typeParameters),
  ) && sameLifetimes(
    Vector.asSlice<Shared<Lifetime>>(&left.lifetimeParameters),
    Vector.asSlice<Shared<Lifetime>>(&right.lifetimeParameters),
  ) && sameRowParameters(
    Vector.asSlice<RowParameter>(&left.rowParameters),
    Vector.asSlice<RowParameter>(&right.rowParameters),
  ) && sameConstraints(
    Vector.asSlice<Constraint>(&left.constraints),
    Vector.asSlice<Constraint>(&right.constraints),
  ) && sameTypeList(
    Vector.asSlice<Shared<Type>>(&left.parameters),
    Vector.asSlice<Shared<Type>>(&right.parameters),
  ) && sameReusableType(&left.result, &right.result) && sameReusableType(
    &left.failure,
    &right.failure,
  ) && sameRow(&left.requirements, &right.requirements)
}

fn sameLifetimes(left: &[Shared<Lifetime>], right: &[Shared<Lifetime>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !Lifetime.equalsShared(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameContract(left: &Contract, right: &Contract) -> bool {
  return sameTypeList(
    Vector.asSlice<Shared<Type>>(&left.typeParameters),
    Vector.asSlice<Shared<Type>>(&right.typeParameters),
  ) && sameLifetimes(
    Vector.asSlice<Shared<Lifetime>>(&left.lifetimeParameters),
    Vector.asSlice<Shared<Lifetime>>(&right.lifetimeParameters),
  ) && sameRowParameters(
    Vector.asSlice<RowParameter>(&left.rowParameters),
    Vector.asSlice<RowParameter>(&right.rowParameters),
  ) && sameConstraints(
    Vector.asSlice<Constraint>(&left.constraints),
    Vector.asSlice<Constraint>(&right.constraints),
  ) && sameTypeOption(&left.provider, &right.provider)
}

fn sameImplementationKind(left: &ImplementationKind, right: &ImplementationKind) -> bool {
  return match & left.* {
    ImplementationKind.Inherent => match & right.* {
      ImplementationKind.Inherent => true
      _ => false
    }
    ImplementationKind.Conformance => match & right.* {
      ImplementationKind.Conformance => true
      _ => false
    }
    ImplementationKind.Sealed {property} => match & right.* {
      ImplementationKind.Sealed {property: other} => property == other
      _ => false
    }
  }
}

fn sameHead(left: &Shared<ImplementationHead>, right: &Shared<ImplementationHead>) -> bool {
  if sameAllocation<ImplementationHead>(left, right) {
    return true
  }
  return Shared.with<ImplementationHead, bool>(
    left,
    fn(first: &ImplementationHead) -> bool {
      return sameHeadWith(first, right)
    },
  )
}

fn sameHeadWith(first: &ImplementationHead, right: &Shared<ImplementationHead>) -> bool {
  return Shared.with<ImplementationHead, bool>(
    right,
    fn(second: &ImplementationHead) -> bool {
      return sameDeclarationShared(&first.declaration, &second.declaration) && sameImplementationKind(
        &first.kind,
        &second.kind,
      ) && sameContract(&first.binders, &second.binders) && sameTypeOption(
        &first.contract,
        &second.contract,
      ) && sameReusableType(&first.provider, &second.provider)
    },
  )
}

fn sameHeads(left: &[Shared<ImplementationHead>], right: &[Shared<ImplementationHead>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameHead(&left[at], &right[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameArguments(left: &[Argument], right: &[Argument]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    let equal = match & left[at] {
      Argument.Type {value} => match & right[at] {
        Argument.Type {value: other} => sameReusableType(&value, &other)
        _ => false
      }
      Argument.Lifetime {value} => match & right[at] {
        Argument.Lifetime {value: other} => Lifetime.equalsShared(&value, &other)
        _ => false
      }
      Argument.Row {value} => match & right[at] {
        Argument.Row {value: other} => sameRow(&value, &other)
        _ => false
      }
    }
    if !equal {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameWitnesses(left: &[Witness], right: &[Witness]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameDeclarationShared(&left[at].operation, &right[at].operation) || !sameDeclarationShared(
      &left[at].implementation,
      &right[at].implementation,
    ) || !sameArguments(
      Vector.asSlice<Argument>(&left[at].arguments),
      Vector.asSlice<Argument>(&right[at].arguments),
    ) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameImplementationMembers(left: &[ImplementationMember], right: &[ImplementationMember]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    let equal = match & left[at] {
      ImplementationMember.Inline {declaration, ..} => match & right[at] {
        ImplementationMember.Inline {declaration: other, ..} => sameDeclarationShared(
          &declaration,
          &other,
        )
        _ => false
      }
      ImplementationMember.Mapped {declaration, target, ..} => match & right[at] {
        ImplementationMember.Mapped {declaration: other, target: otherTarget, ..} => sameDeclarationShared(
          &declaration,
          &other,
        ) && sameDeclarationShared(&target, &otherTarget)
        _ => false
      }
    }
    if !equal {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameMemberName(left: &Option<Bytes>, right: &Option<Bytes>) -> bool {
  return match & left.* {
    Option<Bytes>.Some {value} => match & right.* {
      Option<Bytes>.Some {value: other} => same(Bytes.asSlice(&value), Bytes.asSlice(&other))
      Option<Bytes>.None => false
    }
    Option<Bytes>.None => match & right.* {
      Option<Bytes>.Some {..} => false
      Option<Bytes>.None => true
    }
  }
}

fn sameMembers(left: &[Member], right: &[Member]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if !sameMemberName(&left[at].name, &right[at].name) || left[at].isPublic != right[at].isPublic || left[at].kind != right[at].kind || !sameEnumCase(
      &left[at].discriminant,
      &right[at].discriminant,
    ) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameEnumCase(left: &Option<EnumCase>, right: &Option<EnumCase>) -> bool {
  return match & left.* {
    Option<EnumCase>.Some {value} => match & right.* {
      Option<EnumCase>.Some {value: other} => value.sign == other.sign && value.magnitude == other.magnitude
      Option<EnumCase>.None => false
    }
    Option<EnumCase>.None => match & right.* {
      Option<EnumCase>.Some {..} => false
      Option<EnumCase>.None => true
    }
  }
}

fn sameValue(left: &Value, right: &Value) -> bool {
  return match & left.* {
    Value.Name {bucket} => match & right.* {
      Value.Name {bucket: other} => sameBuckets(&bucket, &other)
      _ => false
    }
    Value.Namespace {module, ordinal} => match & right.* {
      Value.Namespace {module: other, ordinal: position} => ModuleId.equals(&module, &other) && ordinal == position
      _ => false
    }
    Value.Selected {declaration, module, ordinal} => match & right.* {
      Value.Selected {declaration: other, module: selected, ordinal: position} => DeclarationId.equals(
        &declaration,
        &other,
      ) && module == selected && ordinal == position
      _ => false
    }
    Value.Type {resolved} => match & right.* {
      Value.Type {resolved: other} => sameReusableType(&resolved, &other)
      _ => false
    }
    // U9 owns cross-revision replay of registration and source origins. A schema has no
    // reusable identity payload until those observations are validated together.
    Value.ParameterSchema {..} => false
    Value.ParameterDefault {..} => false
    Value.Members {identity, members, enumRepresentation} => match & right.* {
      Value.Members {identity: otherIdentity, members: other, enumRepresentation: otherRepresentation} => sameDeclarationShared(&identity, &otherIdentity) && enumRepresentation == otherRepresentation && sameMembers(
        Vector.asSlice<Member>(&members),
        Vector.asSlice<Member>(&other),
      )
      _ => false
    }
    Value.Contract {contract} => match & right.* {
      Value.Contract {contract: other} => sameContract(&contract, &other)
      _ => false
    }
    Value.Operations {operations} => match & right.* {
      Value.Operations {operations: other} => sameDeclarationList(
        Vector.asSlice<Shared<DeclarationId>>(&operations),
        Vector.asSlice<Shared<DeclarationId>>(&other),
      )
      _ => false
    }
    Value.Implementations {heads} => match & right.* {
      Value.Implementations {heads: other} => sameHeads(
        Vector.asSlice<Shared<ImplementationHead>>(&heads),
        Vector.asSlice<Shared<ImplementationHead>>(&other),
      )
      _ => false
    }
    Value.ImplementationHead {head} => match & right.* {
      Value.ImplementationHead {head: other} => sameHead(&head, &other)
      _ => false
    }
    Value.InherentMembers {members, rejected} => match & right.* {
      Value.InherentMembers {members: other, rejected: otherRejected} => Vector.length<
        RejectedMember,
      >(&rejected) == usize.ZERO && Vector.length<RejectedMember>(&otherRejected) == usize.ZERO && sameDeclarationList(
        Vector.asSlice<Shared<DeclarationId>>(&members),
        Vector.asSlice<Shared<DeclarationId>>(&other),
      )
      _ => false
    }
    Value.ConformanceHeads {heads} => match & right.* {
      Value.ConformanceHeads {heads: other} => sameHeads(
        Vector.asSlice<Shared<ImplementationHead>>(&heads),
        Vector.asSlice<Shared<ImplementationHead>>(&other),
      )
      _ => false
    }
    Value.Coherent => match & right.* {
      Value.Coherent => true
      _ => false
    }
    Value.ProofBounds {constraints} => match & right.* {
      Value.ProofBounds {constraints: other} => sameConstraints(
        Vector.asSlice<Constraint>(&constraints),
        Vector.asSlice<Constraint>(&other),
      )
      _ => false
    }
    Value.ImplementationMembers {members} => match & right.* {
      Value.ImplementationMembers {members: other} => sameImplementationMembers(
        Vector.asSlice<ImplementationMember>(&members),
        Vector.asSlice<ImplementationMember>(&other),
      )
      _ => false
    }
    Value.FieldLifetimes {count} => match & right.* {
      Value.FieldLifetimes {count: other} => count == other
      _ => false
    }
    Value.Witnesses {witnesses} => match & right.* {
      Value.Witnesses {witnesses: other} => sameWitnesses(
        Vector.asSlice<Witness>(&witnesses),
        Vector.asSlice<Witness>(&other),
      )
      _ => false
    }
    Value.MemberShape {types} => match & right.* {
      Value.MemberShape {types: other} => sameTypeList(
        Vector.asSlice<Shared<Type>>(&types),
        Vector.asSlice<Shared<Type>>(&other),
      )
      _ => false
    }
    Value.Signature {signature} => match & right.* {
      Value.Signature {signature: other} => sameSignature(&signature, &other)
      _ => false
    }
    Value.Initializer {..} => false
    Value.ProfileInput {slot} => match & right.* {
      Value.ProfileInput {slot: other} => slot == other
      _ => false
    }
    Value.Body {..} => false
    Value.Mir {..} => false
    Value.Layout {..} => false
    Value.LayoutUnsupported => false
    Value.Instance {..} => false
    Value.Unsupported {..} => false
  }
}

fn sameValueWith(first: &Value, other: &Shared<Value>) -> bool {
  return Shared.with<Value, bool>(
    other,
    fn(second: &Value) -> bool {
      return sameValue(first, second)
    },
  )
}

fn sameSharedValue(left: &Shared<Value>, right: &Shared<Value>) -> bool {
  if sameAllocation<Value>(left, right) {
    return true
  }
  return Shared.with<Value, bool>(
    left,
    fn(first: &Value) -> bool {
      return sameValueWith(first, right)
    },
  )
}

fn copyConstraint(constraint: &Constraint) -> Constraint {
  return match & constraint.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: Shared.clone<Type>(&provider),
      contract: Shared.clone<Type>(&contract),
    }
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: Shared.clone<Type>(&parameter),
      contract: Shared.clone<Type>(&contract),
    }
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: Shared.clone<Type>(&subject),
      region: Shared.clone<Lifetime>(&region),
    }
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: Shared.clone<Lifetime>(&longer),
      shorter: Shared.clone<Lifetime>(&shorter),
    }
    Constraint.Copyable {subject} => Constraint.Copyable {subject: Shared.clone<Type>(&subject)}
    Constraint.Property {subject, property} => Constraint.Property {
      subject: Shared.clone<Type>(&subject),
      property: property,
    }
  }
}

effect fn copyConstraints(values: &[Constraint]) -> Vector<Constraint>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = Vector.make<Constraint>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Constraint>(&mut copied, copyConstraint(&values[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copySignature(signature: &Signature) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut environment = Option.none<Intersection>()
  if let Option<Intersection>.Some {value} = &signature.environment {
    environment = Option.some<Intersection>(run Intersection.copy(&value))
  }
  let mut rowParameters = Vector.make<RowParameter>()
  let rows = Vector.asSlice<RowParameter>(&signature.rowParameters)
  let mut rowAt = usize.ZERO
  while rowAt < rows.length {
    run Vector.append<RowParameter>(
      &mut rowParameters,
      RowParameter {
        declaration: Shared.clone<DeclarationId>(&rows[rowAt].declaration),
        ordinal: rows[rowAt].ordinal,
      },
    )
    rowAt = rowAt + usize.ONE
  }
  let mut constraints = Vector.make<Constraint>()
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  let mut constraintAt = usize.ZERO
  while constraintAt < declared.length {
    run Vector.append<Constraint>(&mut constraints, copyConstraint(&declared[constraintAt]))
    constraintAt = constraintAt + usize.ONE
  }
  let mut typeParameters = Vector.make<Shared<Type>>()
  let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
  let mut binderAt = usize.ZERO
  while binderAt < binders.length {
    run Vector.append<Shared<Type>>(&mut typeParameters, Shared.clone<Type>(&binders[binderAt]))
    binderAt = binderAt + usize.ONE
  }
  let mut lifetimeParameters = Vector.make<Shared<Lifetime>>()
  let lifetimes = Vector.asSlice<Shared<Lifetime>>(&signature.lifetimeParameters)
  let mut lifetimeAt = usize.ZERO
  while lifetimeAt < lifetimes.length {
    run Vector.append<Shared<Lifetime>>(
      &mut lifetimeParameters,
      Shared.clone<Lifetime>(&lifetimes[lifetimeAt]),
    )
    lifetimeAt = lifetimeAt + usize.ONE
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let written = Vector.asSlice<Shared<Type>>(&signature.parameters)
  let mut at = usize.ZERO
  while at < written.length {
    run Vector.append<Shared<Type>>(&mut parameters, Shared.clone<Type>(&written[at]))
    at = at + usize.ONE
  }
  return Value.Signature {
    signature: Signature {
      typeParameters: move typeParameters,
      lifetimeParameters: move lifetimeParameters,
      rowParameters: move rowParameters,
      constraints: move constraints,
      parameters: move parameters,
      result: Shared.clone<Type>(&signature.result),
      failure: Shared.clone<Type>(&signature.failure),
      requirements: Shared.clone<Row>(&signature.requirements),
      isEffect: signature.isEffect,
      isUnsafe: signature.isUnsafe,
      environment: move environment,
    },
  }
}

effect fn copyContract(contract: &Contract) -> Contract ! OutOfMemoryError ? &mut Allocator {
  let mut typeParameters = Vector.make<Shared<Type>>()
  let types = Vector.asSlice<Shared<Type>>(&contract.typeParameters)
  let mut at = usize.ZERO
  while at < types.length {
    run Vector.append<Shared<Type>>(&mut typeParameters, Shared.clone<Type>(&types[at]))
    at = at + usize.ONE
  }
  let mut lifetimeParameters = Vector.make<Shared<Lifetime>>()
  let lifetimes = Vector.asSlice<Shared<Lifetime>>(&contract.lifetimeParameters)
  at = usize.ZERO
  while at < lifetimes.length {
    run Vector.append<Shared<Lifetime>>(
      &mut lifetimeParameters,
      Shared.clone<Lifetime>(&lifetimes[at]),
    )
    at = at + usize.ONE
  }
  let mut rowParameters = Vector.make<RowParameter>()
  let rows = Vector.asSlice<RowParameter>(&contract.rowParameters)
  at = usize.ZERO
  while at < rows.length {
    run Vector.append<RowParameter>(
      &mut rowParameters,
      RowParameter {
        declaration: Shared.clone<DeclarationId>(&rows[at].declaration),
        ordinal: rows[at].ordinal,
      },
    )
    at = at + usize.ONE
  }
  let provider = match & contract.provider {
    Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(Shared.clone<Type>(&value))
    Option<Shared<Type>>.None => Option.none<Shared<Type>>()
  }
  return Contract {
    typeParameters: move typeParameters,
    lifetimeParameters: move lifetimeParameters,
    rowParameters: move rowParameters,
    constraints: run copyConstraints(Vector.asSlice<Constraint>(&contract.constraints)),
    provider: move provider,
  }
}

effect fn copyDeclarations(values: &[Shared<DeclarationId>]) -> Vector<Shared<DeclarationId>>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = Vector.make<Shared<DeclarationId>>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Shared<DeclarationId>>(&mut copied, Shared.clone<DeclarationId>(&values[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyHeads(values: &[Shared<ImplementationHead>]) -> Vector<Shared<ImplementationHead>>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = Vector.make<Shared<ImplementationHead>>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Shared<ImplementationHead>>(
      &mut copied,
      Shared.clone<ImplementationHead>(&values[at]),
    )
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyWitnesses(values: &[Witness]) -> Vector<Witness> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Witness>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Witness>(
      &mut copied,
      Witness {
        operation: Shared.clone<DeclarationId>(&values[at].operation),
        implementation: Shared.clone<DeclarationId>(&values[at].implementation),
        arguments: run copyArguments(Vector.asSlice<Argument>(&values[at].arguments)),
      },
    )
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyInherentMembers(members: &[Shared<DeclarationId>], rejected: &[RejectedMember]) -> Value
! OutOfMemoryError
? &mut Allocator {
  let mut copiedRejected = Vector.make<RejectedMember>()
  let mut at = usize.ZERO
  while at < rejected.length {
    run Vector.append<RejectedMember>(
      &mut copiedRejected,
      RejectedMember {
        declaration: Shared.clone<DeclarationId>(&rejected[at].declaration),
        rejection: Shared.clone<Rejection>(&rejected[at].rejection),
      },
    )
    at = at + usize.ONE
  }
  return Value.InherentMembers {
    members: run copyDeclarations(members),
    rejected: move copiedRejected,
  }
}

effect fn copyImplementationMembers(members: &[ImplementationMember]) -> Value
! OutOfMemoryError
? &mut Allocator {
  let mut copied = Vector.make<ImplementationMember>()
  let mut at = usize.ZERO
  while at < members.length {
    let member = match & members[at] {
      ImplementationMember.Inline {declaration, span} => ImplementationMember.Inline {
        declaration: Shared.clone<DeclarationId>(&declaration),
        span: span,
      }
      ImplementationMember.Mapped {declaration, span, target} => ImplementationMember.Mapped {
        declaration: Shared.clone<DeclarationId>(&declaration),
        span: span,
        target: Shared.clone<DeclarationId>(&target),
      }
    }
    run Vector.append<ImplementationMember>(&mut copied, move member)
    at = at + usize.ONE
  }
  return Value.ImplementationMembers {members: move copied}
}

effect fn copyMembers(identity: &Shared<DeclarationId>, members: &[Member], enumRepresentation: StaticIntegerType) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Member>()
  let mut at = usize.ZERO
  while at < members.length {
    let name = match & members[at].name {
      Option<Bytes>.Some {value} => Option.some<Bytes>(run Bytes.copy(Bytes.asSlice(&value)))
      Option<Bytes>.None => Option.none<Bytes>()
    }
    run Vector.append<Member>(
      &mut copied,
      Member {
        name: move name,
        isPublic: members[at].isPublic,
        kind: members[at].kind,
        discriminant: match & members[at].discriminant {
          Option<EnumCase>.Some {value} => Option.some<EnumCase>(
            EnumCase {sign: value.sign, magnitude: value.magnitude},
          )
          Option<EnumCase>.None => Option.none<EnumCase>()
        },
      },
    )
    at = at + usize.ONE
  }
  return Value.Members {identity: Shared.clone<DeclarationId>(identity), members: move copied, enumRepresentation: enumRepresentation}
}

effect fn copyMemberShape(types: &[Shared<Type>]) -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < types.length {
    run Vector.append<Shared<Type>>(&mut copied, Shared.clone<Type>(&types[at]))
    at = at + usize.ONE
  }
  return Value.MemberShape {types: move copied}
}

effect fn identityOf(outcome: &Outcome) -> Option<Shared<Value>> ! OutOfMemoryError ? &mut Allocator {
  return match & outcome.* {
    Outcome.Rejected {diagnostic: _} => Option.none<Shared<Value>>()
    Outcome.Success {value} => {
      let copied = match & value {
        Value.Name {bucket} => Value.Name {bucket: Shared.clone<NameObservation>(&bucket)}
        Value.Namespace {module, ordinal} => Value.Namespace {
          module: run ModuleId.copy(&module),
          ordinal: ordinal,
        }
        Value.Selected {declaration, module, ordinal} => Value.Selected {
          declaration: run DeclarationId.copy(&declaration),
          module: module,
          ordinal: ordinal,
        }
        Value.Type {resolved} => Value.Type {resolved: Shared.clone<Type>(&resolved)}
        Value.ParameterSchema {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.ParameterDefault {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Contract {contract} => Value.Contract {contract: run copyContract(&contract)}
        Value.Operations {operations} => Value.Operations {
          operations: run copyDeclarations(Vector.asSlice<Shared<DeclarationId>>(&operations)),
        }
        Value.Implementations {heads} => Value.Implementations {
          heads: run copyHeads(Vector.asSlice<Shared<ImplementationHead>>(&heads)),
        }
        Value.ImplementationHead {head} => Value.ImplementationHead {
          head: Shared.clone<ImplementationHead>(&head),
        }
        Value.InherentMembers {members, rejected} => run copyInherentMembers(
          Vector.asSlice<Shared<DeclarationId>>(&members),
          Vector.asSlice<RejectedMember>(&rejected),
        )
        Value.ConformanceHeads {heads} => Value.ConformanceHeads {
          heads: run copyHeads(Vector.asSlice<Shared<ImplementationHead>>(&heads)),
        }
        Value.Coherent => Value.Coherent
        Value.ProofBounds {constraints} => Value.ProofBounds {
          constraints: run copyConstraints(Vector.asSlice<Constraint>(&constraints)),
        }
        Value.ImplementationMembers {members} => run copyImplementationMembers(
          Vector.asSlice<ImplementationMember>(&members),
        )
        Value.FieldLifetimes {count} => Value.FieldLifetimes {count: count}
        Value.Witnesses {witnesses} => Value.Witnesses {
          witnesses: run copyWitnesses(Vector.asSlice<Witness>(&witnesses)),
        }
        Value.Members {identity, members, enumRepresentation} => run copyMembers(&identity, Vector.asSlice<Member>(&members), enumRepresentation)
        Value.MemberShape {types} => run copyMemberShape(Vector.asSlice<Shared<Type>>(&types))
        Value.Signature {signature} => run copySignature(&signature)
        Value.Initializer {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.ProfileInput {slot} => Value.ProfileInput {slot: slot}
        Value.Body {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Mir {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Layout {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.LayoutUnsupported => {
          return Option.none<Shared<Value>>()
        }
        Value.Instance {..} => {
          return Option.none<Shared<Value>>()
        }
        Value.Unsupported {..} => {
          return Option.none<Shared<Value>>()
        }
      }
      return Option.some<Shared<Value>>(run Shared.make<Value>(move copied))
    }
  }
}

fn answerIdentity(answer: &Result<Answer, NoRejection>) -> Option<Shared<Value>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.identity {
      Option<Shared<Value>>.Some {value: observed} => Option.some<Shared<Value>>(
        Shared.clone<Value>(&observed),
      )
      Option<Shared<Value>>.None => Option.none<Shared<Value>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Value>>()
  }
}

fn priorAnswerId(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => value.answerId
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn discoveredBy(answer: &Result<Answer, NoRejection>, module: &ModuleId) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let observations = Vector.asSlice<Shared<Observation>>(&value.sources)
      let mut at = usize.ZERO
      while at < observations.length {
        if Shared.with<Observation, bool>(
          &observations[at],
          fn(observed: &Observation) -> bool {
            return Observation.isPresent(observed) && ModuleId.equals(
              Observation.moduleId(observed),
              module,
            )
          },
        ) {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn demandedBy(answer: &Result<Answer, NoRejection>, family: Family, module: &ModuleId) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let demands = Vector.asSlice<Shared<DemandFootprint>>(&value.footprint)
      let mut at = usize.ZERO
      while at < demands.length {
        if Shared.with<DemandFootprint, bool>(
          &demands[at],
          fn(demanded: &DemandFootprint) -> bool {
            return demanded.dependency.family == family && ModuleId.equals(
              &demanded.dependency.module,
              module,
            )
          },
        ) {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn footprintCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => Vector.length<Shared<DemandFootprint>>(
      &value.footprint,
    )
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn footprintAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<DemandFootprint>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let demands = Vector.asSlice<Shared<DemandFootprint>>(&value.footprint)
      if at < demands.length {
        return Option.some<Shared<DemandFootprint>>(Shared.clone<DemandFootprint>(&demands[at]))
      }
      return Option.none<Shared<DemandFootprint>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<DemandFootprint>>()
  }
}

fn observationCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => Vector.length<Shared<Observation>>(
      &value.sources,
    )
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn observationAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Observation>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let observations = Vector.asSlice<Shared<Observation>>(&value.sources)
      if at < observations.length {
        return Option.some<Shared<Observation>>(Shared.clone<Observation>(&observations[at]))
      }
      return Option.none<Shared<Observation>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Observation>>()
  }
}

fn priorCandidate(answer: &Result<Answer, NoRejection>) -> Option<BodyCandidate> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value: previous} => match & previous.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => match & previous.bodyEvidence {
        Option<Shared<BodyEvidence>>.Some {value: evidence} => Option.some<BodyCandidate>(
          BodyCandidate {
            body: Shared.clone<TypedBody>(&body),
            evidence: Shared.clone<BodyEvidence>(&evidence),
            directCount: Vector.length<Dependency>(&previous.dependencies),
          },
        )
        Option<Shared<BodyEvidence>>.None => Option.none<BodyCandidate>()
      }
      _ => Option.none<BodyCandidate>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<BodyCandidate>()
  }
}

fn bodyDependencyAt(evidence: &BodyEvidence, at: usize) -> BodyDependency {
  let direct = Vector.asSlice<BodyDependency>(&evidence.direct)
  let prior = &direct[at]
  let declaration = match & prior.declaration {
    Option<Shared<DeclarationId>>.Some {value} => Option.some<Shared<DeclarationId>>(
      Shared.clone<DeclarationId>(&value),
    )
    Option<Shared<DeclarationId>>.None => Option.none<Shared<DeclarationId>>()
  }
  let identity = match & prior.identity {
    Option<Shared<Value>>.Some {value} => Option.some<Shared<Value>>(Shared.clone<Value>(&value))
    Option<Shared<Value>>.None => Option.none<Shared<Value>>()
  }
  return BodyDependency {
    key: prior.key,
    declaration: move declaration,
    answerId: prior.answerId,
    identity: move identity,
  }
}

fn isSuccessfulBody(outcome: &Outcome) -> bool {
  return match & outcome.* {
    Outcome.Success {value: Value.Body {..}} => true
    _ => false
  }
}

effect fn recordRoot(
  request: &mut Request,
  family: Family,
  module: &ModuleId,
  name: &[u8],
  answer: &Shared<Result<Answer, NoRejection>>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run Vector.append<Root>(
    &mut request.roots,
    Root {
      family: family,
      module: run ModuleId.copy(module),
      name: run Bytes.copy(name),
      answer: Shared.clone<Result<Answer, NoRejection>>(answer),
    },
  )
  return ()
}

impl Request {
  /// Creates an empty ledger for one independent semantic request.
  pub fn make() -> Request {
    return Request {
      roots: Vector.make<Root>(),
      application: Option.none<ModuleId>(),
      schemaModules: Vector.make<ModuleId>(),
    }
  }
  /// Creates a request whose sealed application import selects this canonical module.
  pub fn forApplication(application: ModuleId) -> Request {
    return Request {
      roots: Vector.make<Root>(),
      application: Option.some<ModuleId>(move application),
      schemaModules: Vector.make<ModuleId>(),
    }
  }
  /// Registers one canonical module whose package parameter headers must enter this request.
  /// Imports and their local aliases do not register a module.
  pub effect fn registerSchemaModule(self: &mut Self, id: &ModuleId) -> ()
  ! RegistrationClosed | ConflictingPackageSource | OutOfMemoryError
  ? &mut Allocator {
    if Vector.length<Root>(&self.roots) != usize.ZERO {
      fail RegistrationClosed {}
    }
    let registered = Vector.asSlice<ModuleId>(&self.schemaModules)
    let mut at = usize.ZERO
    let mut position = registered.length
    while at < registered.length {
      if ModuleId.equals(&registered[at], id) {
        return ()
      }
      if same(ModuleId.packageIdentity(&registered[at]), ModuleId.packageIdentity(id)) && !same(
        ModuleId.sourceOrigin(&registered[at]),
        ModuleId.sourceOrigin(id),
      ) {
        fail ConflictingPackageSource {}
      }
      if position == registered.length && ModuleId.compare(id, &registered[at]) < 0 {
        position = at
      }
      at = at + usize.ONE
    }
    run Vector.insert<ModuleId>(&mut self.schemaModules, position, run ModuleId.copy(id))
    return ()
  }
  /// Borrows the modules explicitly registered before the request's first demand.
  pub fn registeredSchemaModules(self: &Self) -> &[ModuleId] {
    return Vector.asSlice<ModuleId>(&self.schemaModules)
  }
  /// Reports whether this exact canonical module has been registered.
  pub fn hasRegisteredSchemaModule(self: &Self, id: &ModuleId) -> bool {
    let registered = Vector.asSlice<ModuleId>(&self.schemaModules)
    let mut at = usize.ZERO
    while at < registered.length {
      if ModuleId.equals(&registered[at], id) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Returns the number of roots demanded through this request.
  pub fn rootCount(self: &Self) -> usize {
    return Vector.length<Root>(&self.roots)
  }
  /// Reports whether this request demanded the named root.
  pub fn hasRoot(self: &Self, family: Family, module: &ModuleId, name: &[u8]) -> bool {
    let roots = Vector.asSlice<Root>(&self.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if roots[at].family == family && ModuleId.equals(&roots[at].module, module) && same(
        Bytes.asSlice(&roots[at].name),
        name,
      ) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Reports whether a completed root in this request discovered a present module.
  ///
  /// # Details
  ///
  /// A memoized root replays its nested source observations into this request. An absent module
  /// is evidence for validation, but it is not a discovered present module.
  pub fn hasDiscovered(self: &Self, module: &ModuleId) -> bool {
    let roots = Vector.asSlice<Root>(&self.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if Shared.with<Result<Answer, NoRejection>, bool>(
        &roots[at].answer,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return discoveredBy(answer, module)
        },
      ) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
  /// Reports whether a completed root demanded a nested fact in this request.
  pub fn hasDemand(self: &Self, family: Family, module: &ModuleId) -> bool {
    let roots = Vector.asSlice<Root>(&self.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      if roots[at].family == family && ModuleId.equals(&roots[at].module, module) {
        return true
      }
      if Shared.with<Result<Answer, NoRejection>, bool>(
        &roots[at].answer,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return demandedBy(answer, family, module)
        },
      ) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }
}

fn primitive(name: &[u8]) -> bool {
  return same(name, b"bool") || same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(
    name,
    b"i64",
  ) || same(name, b"isize") || same(name, b"u8") || same(name, b"u16") || same(name, b"u32") || same(
    name,
    b"u64",
  ) || same(name, b"usize") || same(name, b"f32") || same(name, b"f64") || same(name, b"char")
}

fn sameKey(left: Key, right: Key) -> bool {
  if left.family == Family.Layout || right.family == Family.Layout {
    return left.family == Family.Layout && right.family == Family.Layout && left.name == right.name
  }
  if left.family == Family.Mir || left.family == Family.Instance || right.family == Family.Mir || right.family == Family.Instance {
    return left.family == right.family && left.name == right.name
  }
  return left.family == right.family && left.module == right.module && left.name == right.name && left.declaration == right.declaration && left.member == right.member && left.external == right.external
}

effect fn internApplication(resolver: &mut Resolver, application: &Shared<Type>) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let mut at = usize.ZERO
  while at < known.length {
    if run Type.equalsShared(&known[at], application) {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Type>>(&mut resolver.applications, Shared.clone<Type>(application))
  return at
}

effect fn internBackendInstance(resolver: &mut Resolver, instance: &InstanceKey) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<InstanceKey>(&resolver.backendInstances)
  let mut at = usize.ZERO
  while at < known.length {
    if InstanceKey.equals(&known[at], instance) {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<InstanceKey>(&mut resolver.*.backendInstances, InstanceKey.copy(instance))
  return at
}

fn applicationLength(value: &Type) -> usize {
  return match & value.* {
    Type.Nominal {arguments, ..} => Vector.length<Argument>(&arguments)
    _ => usize.MAX
  }
}

fn applicationArgument(value: &Type, at: usize) -> Option<Argument> {
  return match & value.* {
    Type.Nominal {arguments, ..} => {
      let entries = Vector.asSlice<Argument>(&arguments)
      if at >= entries.length {
        return Option.none<Argument>()
      }
      return match & entries[at] {
        Argument.Type {value: ty} => Option.some<Argument>(
          Argument.Type {value: Shared.clone<Type>(&ty)},
        )
        Argument.Lifetime {value: lifetime} => Option.some<Argument>(
          Argument.Lifetime {value: Shared.clone<Lifetime>(&lifetime)},
        )
        Argument.Row {value: row} => Option.some<Argument>(
          Argument.Row {value: Shared.clone<Row>(&row)},
        )
      }
    }
    _ => Option.none<Argument>()
  }
}

fn applicationMatches(value: &Type, declaration: &DeclarationId) -> bool {
  return match & value.* {
    Type.Nominal {declaration: owner, ..} => DeclarationId.equals(&owner, declaration)
    _ => false
  }
}

effect fn internModule(resolver: &mut Resolver, module: &ModuleId) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<ModuleId>(&resolver.modules)
  let mut at = usize.ZERO
  while at < known.length {
    if ModuleId.equals(&known[at], module) {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<ModuleId>(&mut resolver.modules, run ModuleId.copy(module))
  return at
}

effect fn selectRequest(resolver: &mut Resolver, request: &Request) -> ()
! OutOfMemoryError
? &mut Allocator {
  resolver.currentApplication = usize.MAX
  if let Option<ModuleId>.Some {value: application} = &request.application {
    resolver.currentApplication = run internModule(&mut resolver.*, &application)
  }
  return ()
}

effect fn internName(resolver: &mut Resolver, name: &[u8]) -> usize
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<Bytes>(&resolver.names)
  let mut at = usize.ZERO
  while at < known.length {
    if same(Bytes.asSlice(&known[at]), name) {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<Bytes>(&mut resolver.names, run Bytes.copy(name))
  return at
}

effect fn internKey(resolver: &mut Resolver, key: Key) -> Word ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < Vector.length<ScopedKey>(&resolver.keys) {
    let known = Vector.get<ScopedKey>(&resolver.keys, at)
    let sameApplication = key.family == Family.Layout || known.application == resolver.currentApplication
    if sameApplication && known.profile == resolver.profileSlot && sameKey(known.key, key) {
      if key.family == Family.Mir || key.family == Family.Instance {
        let mut keys = Vector.asMutSlice<ScopedKey>(&mut resolver.*.keys)
        keys[at].key = key
      }
      return Hash.word(usize.toU64(at))
    }
    at = at + usize.ONE
  }
  run Vector.append<ScopedKey>(
    &mut resolver.keys,
    ScopedKey {key: key, application: resolver.currentApplication, profile: resolver.profileSlot},
  )
  return Hash.word(usize.toU64(at))
}

effect fn rejectWithRelated(
  resolver: &Resolver,
  module: &ModuleId,
  code: RejectionCode,
  span: Span,
  related: Option<Span>,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: code,
      module: run ModuleId.copy(module),
      span: span,
      related: move related,
      path: Vector.make<Shared<DeclarationId>>(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
}

effect fn reject(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run rejectWithRelated(resolver, module, code, span, Option.none<Span>())
}

fn staticRejectionCode(fault: StaticFault) -> RejectionCode {
  return match fault {
    StaticFault.CompileError => RejectionCode.SelectedCompileError
    StaticFault.Cycle => RejectionCode.StaticEvaluationCycle
    StaticFault.StepLimit => RejectionCode.StaticStepLimit
    StaticFault.DepthLimit => RejectionCode.StaticDepthLimit
    StaticFault.ValueLimit => RejectionCode.StaticValueLimit
    _ => RejectionCode.StaticViolation
  }
}

effect fn rejectStatic(resolver: &Resolver, module: &ModuleId, diagnostic: StaticDiagnostic) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  let code = staticRejectionCode(diagnostic.fault)
  let span = diagnostic.span
  return run Shared.make<Rejection>(
    Rejection {
      code: code,
      module: run ModuleId.copy(module),
      span: span,
      related: Option.none<Span>(),
      path: Vector.make<Shared<DeclarationId>>(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.some<StaticDiagnostic>(move diagnostic),
    },
  )
}

effect fn rejectArity(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  expected: usize,
  supplied: usize,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.TypeArity,
      module: run ModuleId.copy(module),
      span: span,
      related: Option.none<Span>(),
      path: Vector.make<Shared<DeclarationId>>(),
      expected: expected,
      supplied: supplied,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
}

effect fn rejectKind(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  parameter: &[u8],
  expectedKind: GenericKind,
  supplied: GenericKind,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let name = run Bytes.copy(parameter)
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.TypeArgumentKind,
      module: run ModuleId.copy(module),
      span: span,
      related: Option.none<Span>(),
      path: Vector.make<Shared<DeclarationId>>(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: move name,
      expectedKind: expectedKind,
      suppliedKind: supplied,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
}

effect fn emit(resolver: &mut Resolver, kind: EventKind, key: Word) -> ()
! OutOfMemoryError
? &mut Allocator {
  let stored = Vector.get<ScopedKey>(&resolver.keys, u64.toUsize(key.value))
  let selected = stored.key
  run Vector.append<Event>(
    &mut resolver.events,
    Event {kind: kind, family: selected.family, key: u64.toUsize(key.value)},
  )
  return ()
}

fn observationAddress(value: &Observation) -> usize {
  return Pointer.address<Observation>(Pointer.fromRef<Observation>(value))
}

fn observationWith(first: &Observation, right: &Shared<Observation>) -> bool {
  return Shared.with<Observation, bool>(
    right,
    fn(second: &Observation) -> bool {
      return Observation.equals(first, second)
    },
  )
}

fn sameObservation(left: &Shared<Observation>, right: &Shared<Observation>) -> bool {
  // A repeated child answer merges the handle it already contributed. Avoid reentrant access.
  if Shared.with<Observation, usize>(left, observationAddress) == Shared.with<Observation, usize>(
    right,
    observationAddress,
  ) {
    return true
  }
  return Shared.with<Observation, bool>(
    left,
    fn(first: &Observation) -> bool {
      return observationWith(first, right)
    },
  )
}

effect fn appendObservation(frame: &mut SourceFrame, observed: &Shared<Observation>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let known = Vector.asSlice<Shared<Observation>>(&frame.observations)
  let mut at = usize.ZERO
  while at < known.length {
    if sameObservation(&known[at], observed) {
      return ()
    }
    at = at + usize.ONE
  }
  run Vector.append<Shared<Observation>>(
    &mut frame.observations,
    Shared.clone<Observation>(observed),
  )
  return ()
}

effect fn mergeEvidence(frame: &mut SourceFrame, answer: &Shared<Result<Answer, NoRejection>>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let sources = Shared.with<Result<Answer, NoRejection>, usize>(answer, observationCount)
  let mut at = usize.ZERO
  while at < sources {
    let observed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Observation>>>(
      answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Observation>> {
        return observationAt(value, at)
      },
    )
    if let Option<Shared<Observation>>.Some {value} = move observed {
      run appendObservation(&mut frame.*, &value)
    }
    at = at + usize.ONE
  }
  let demands = Shared.with<Result<Answer, NoRejection>, usize>(answer, footprintCount)
  at = usize.ZERO
  while at < demands {
    let nested = Shared.with<Result<Answer, NoRejection>, Option<Shared<DemandFootprint>>>(
      answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<DemandFootprint>> {
        return footprintAt(value, at)
      },
    )
    if let Option<Shared<DemandFootprint>>.Some {value} = move nested {
      run Vector.append<Shared<DemandFootprint>>(&mut frame.footprint, move value)
    }
    at = at + usize.ONE
  }
  return ()
}

fn sourceOf<'a>(
  resolver: &'a Resolver,
  answer: &Shared<Result<SourceResult, NoRejection>>,
  module: &ModuleId,
) -> Option<&'a IndexedSource> {
  return SourceIndex.source(&resolver.source, answer, module)
}

effect fn source(resolver: &mut Resolver, module: &ModuleId) -> Shared<
  Result<SourceResult, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run SourceIndex.demand(&mut resolver.source, module)
  let count = Vector.length<SourceFrame>(&resolver.frames)
  if count > usize.ZERO {
    let frames = Vector.asSlice<SourceFrame>(&resolver.frames)
    let observed = Vector.asSlice<Shared<Observation>>(&frames[count - usize.ONE].observations)
    let mut found = false
    let mut at = usize.ZERO
    while at < observed.length {
      if Shared.with<Observation, bool>(
        &observed[at],
        fn(value: &Observation) -> bool {
          return ModuleId.equals(Observation.moduleId(value), module)
        },
      ) {
        found = true
      }
      at = at + usize.ONE
    }
    if !found {
      let evidence = run Shared.make<Observation>(
        run SourceIndex.captureObservation(&resolver.source, module),
      )
      let mut frames = Vector.asMutSlice<SourceFrame>(&mut resolver.frames)
      run appendObservation(&mut frames[count - usize.ONE], &evidence)
    }
  }
  return move answer
}

effect fn declarationAt(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  DeclarationId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      return Option.some<DeclarationId>(run DeclarationId.copy(&declarations[ordinal].identity))
    }
  }
  return Option.none<DeclarationId>()
}

fn pathText(hir: &Module, path: HirId, other: HirId) -> bool {
  if let Node.Path {segments} = Module.node(hir, path) {
    if let Node.Path {segments: compared} = Module.node(hir, other) {
      if segments.length != compared.length {
        return false
      }
      let mut at = usize.ZERO
      while at < segments.length {
        let left = Module.node(hir, Module.child(hir, segments, at))
        let right = Module.node(hir, Module.child(hir, compared, at))
        if let Node.Name {text} = left {
          if let Node.Name {text: otherText} = right {
            if !same(Module.text(hir, text), Module.text(hir, otherText)) {
              return false
            }
          } else {
            return false
          }
        } else {
          return false
        }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

// The selected member name of one import-member candidate, as written before any alias.
fn importedMemberName(hir: &Module, header: HirId, ordinal: usize) -> HirRef {
  if let Node.ImportHeader {members, ..} = Module.node(hir, header) {
    if members.present && ordinal < members.range.length {
      if let Node.ImportMember {name, ..} = Module.node(
        hir,
        Module.child(hir, members.range, ordinal),
      ) {
        return HirRef.of(name)
      }
    }
  }
  return HirRef.absent()
}

fn sameWrittenName(hir: &Module, left: HirRef, right: HirRef) -> bool {
  if !left.present || !right.present {
    return false
  }
  if let Node.Name {text} = Module.node(hir, left.id) {
    if let Node.Name {text: otherText} = Module.node(hir, right.id) {
      return same(Module.text(hir, text), Module.text(hir, otherText))
    }
  }
  return false
}

// IMPORT-006: importing an identical binding twice is one binding. A candidate repeats an earlier
// one with the same spelling when both are imports of the same kind and visibility, naming the same
// module path and, for a member import, the same selected member.
fn repeatsImport(
  hir: &Module,
  declarations: &[IndexedDeclaration],
  candidates: &[Candidate],
  at: usize,
) -> bool {
  let current = &candidates[at]
  if current.kind == CandidateKind.Declaration {
    return false
  }
  let mut before = usize.ZERO
  while before < at {
    let earlier = &candidates[before]
    if same(Bytes.asSlice(&earlier.name), Bytes.asSlice(&current.name)) && earlier.kind == current.kind && earlier.isPublic == current.isPublic {
      let earlierHeader = declarations[earlier.declaration].header
      let currentHeader = declarations[current.declaration].header
      if let Node.ImportHeader {path: earlierPath, ..} = Module.node(hir, earlierHeader) {
        if let Node.ImportHeader {path: currentPath, ..} = Module.node(hir, currentHeader) {
          let samePath = pathText(hir, earlierPath, currentPath)
          let sameMember = current.kind == CandidateKind.ImportModule || sameWrittenName(
            hir,
            importedMemberName(hir, earlierHeader, earlier.ordinal),
            importedMemberName(hir, currentHeader, current.ordinal),
          )
          if samePath && sameMember {
            return true
          }
        }
      }
    }
    before = before + usize.ONE
  }
  return false
}

effect fn select(resolver: &mut Resolver, module: &ModuleId, name: &[u8], external: bool) -> Selection
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut count = usize.ZERO
    let mut publicCount = usize.ZERO
    let mut chosen = Selection {
      count: usize.ZERO,
      publicCount: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      kind: CandidateKind.Declaration,
      span: Span {start: usize.ZERO, end: usize.ZERO},
      isPublic: false,
    }
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut at = usize.ZERO
    while at < candidates.length {
      if same(Bytes.asSlice(&candidates[at].name), name) && !repeatsImport(
        hir,
        declarations,
        candidates,
        at,
      ) {
        count = count + usize.ONE
        if candidates[at].isPublic {
          publicCount = publicCount + usize.ONE
        }
        if count == usize.ONE || (external && candidates[at].isPublic && !chosen.isPublic) {
          chosen.declaration = candidates[at].declaration
          chosen.member = candidates[at].ordinal
          chosen.kind = candidates[at].kind
          chosen.span = Module.span(hir, candidates[at].local)
          chosen.isPublic = candidates[at].isPublic
        }
      }
      at = at + usize.ONE
    }
    // INTR-001: the sealed `Intrinsic` namespace is bound in every module, so a declaration or
    // import binding that name always collides with it.
    if count > usize.ZERO && same(name, b"Intrinsic") {
      count = count + usize.ONE
    }
    chosen.count = count
    chosen.publicCount = publicCount
    return chosen
  }
  return Selection {
    count: usize.ZERO,
    publicCount: usize.ZERO,
    declaration: usize.ZERO,
    member: usize.ZERO,
    kind: CandidateKind.Declaration,
    span: Span {start: usize.ZERO, end: usize.ZERO},
    isPublic: false,
  }
}

effect fn header(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      let id = declarations[ordinal].header
      return Option.some<HeaderSyntax>(
        HeaderSyntax {header: Module.node(hir, id), span: Module.span(hir, id)},
      )
    }
  }
  return Option.none<HeaderSyntax>()
}

effect fn path(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> PathSyntax
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let span = Module.span(hir, id)
    if let Node.Path {segments} = Module.node(hir, id) {
      let mut names = Vector.make<Bytes>()
      let mut at = usize.ZERO
      while at < segments.length {
        let child = Module.child(hir, segments, at)
        if let Node.Name {text} = Module.node(hir, child) {
          run Vector.append<Bytes>(&mut names, run Bytes.copy(Module.text(hir, text)))
        } else {
          return PathSyntax {segments: move names, span: span, valid: false}
        }
        at = at + usize.ONE
      }
      return PathSyntax {segments: move names, span: span, valid: segments.length > usize.ZERO}
    }
    return PathSyntax {segments: Vector.make<Bytes>(), span: span, valid: false}
  }
  return PathSyntax {
    segments: Vector.make<Bytes>(),
    span: Span.make(usize.ZERO, usize.ZERO),
    valid: false,
  }
}

// Whether the interface or service directly enclosing `ordinal` is public.
fn contractPublic(hir: &Module, declarations: &[IndexedDeclaration], ordinal: usize) -> bool {
  if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
    return match Module.node(hir, declarations[parent].header) {
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      _ => false
    }
  }
  return false
}

effect fn signatureSyntax(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  WrittenSignature,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length {
      return Option.none<WrittenSignature>()
    }
    let hir = IndexedSource.authored(value)
    let declarationSpan = Module.span(hir, declarations[ordinal].header)
    let mut staticPosition = match & declarations[ordinal].parent {
      Option<usize>.None => true
      Option<usize>.Some {..} => false
    }
    if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
      if parent < declarations.length {
        if let Node.ImplHeader {target, ..} = Module.node(hir, declarations[parent].header) {
          staticPosition = !target.present
        }
      }
    }
    let written = Module.node(hir, declarations[ordinal].header)
    let mut callable = Option.none<HirId>()
    let mut isPublic = false
    // Linkage and property clauses are outside the supported header subset.
    let mut plain = true
    if let Node.FunctionHeader {contract, linkage, properties, isPublic: visible, ..} = written {
      callable = Option.some<HirId>(contract)
      isPublic = visible
      plain = !linkage.present && properties.length == usize.ZERO
    }
    if let Node.OperationHeader {contract, properties, ..} = written {
      callable = Option.some<HirId>(contract)
      // An operation has no visibility of its own; it shares its interface's or service's.
      isPublic = contractPublic(hir, declarations, ordinal)
      plain = properties.length == usize.ZERO
    }
    if let Option<HirId>.Some {value: contract} = move callable {
      if let Node.CallableContract {
        generics,
        parameters,
        variadic,
        result,
        failures,
        requirements,
        constraints,
        isEffect,
        isTest,
        environment,
        isUnsafe,
        isStatic,
        ..,
      } = Module.node(hir, contract) {
        let mut params = Vector.make<HirId>()
        let mut at = usize.ZERO
        while at < parameters.length {
          let parameterId = Module.child(hir, parameters, at)
          let mut accepted = false
          if let Node.Parameter {annotation, mode, ..} = Module.node(hir, parameterId) {
            // Parameter mode changes the calling phase or local storage, not its declared type.
            if !isStatic || mode == ParameterMode.Value {
              run Vector.append<HirId>(&mut params, annotation)
              accepted = true
            }
          }
          if !accepted {
            return Option.some<WrittenSignature>(
              WrittenSignature {
                generics: generics,
                parameters: move params,
                result: Option.none<HirId>(),
                failures: failures,
                requirements: requirements,
                environment: environment,
                isEffect: isEffect,
                isUnsafe: isUnsafe,
                isStatic: isStatic,
                isPublic: isPublic,
                supported: false,
                span: Module.span(hir, parameterId),
              },
            )
          }
          at = at + usize.ONE
        }
        let mut written = Option.none<HirId>()
        if result.present {
          written = Option.some<HirId>(result.id)
        }
        return Option.some<WrittenSignature>(
          WrittenSignature {
            generics: generics,
            parameters: move params,
            result: move written,
            failures: failures,
            requirements: requirements,
            environment: environment,
            isEffect: isEffect,
            isUnsafe: isUnsafe,
            isStatic: isStatic,
            isPublic: isPublic,
            supported: !variadic && constraints.length == usize.ZERO && !isTest && plain && (!isStatic || (!isEffect && !isUnsafe && !failures.present && !requirements.present && !environment.present && staticPosition)),
            span: Module.span(hir, contract),
          },
        )
      }
      return Option.some<WrittenSignature>(
        WrittenSignature {
          generics: Range.empty(),
          parameters: Vector.make<HirId>(),
          result: Option.none<HirId>(),
          failures: HirRef.absent(),
          requirements: HirRef.absent(),
          environment: RangeRef.absent(),
          isEffect: false,
          isUnsafe: false,
          isStatic: false,
          isPublic: isPublic,
          supported: false,
          span: Module.span(hir, contract),
        },
      )
    }
    return Option.some<WrittenSignature>(
      WrittenSignature {
        generics: Range.empty(),
        parameters: Vector.make<HirId>(),
        result: Option.none<HirId>(),
        failures: HirRef.absent(),
        requirements: HirRef.absent(),
        environment: RangeRef.absent(),
        isEffect: false,
        isUnsafe: false,
        isStatic: false,
        isPublic: false,
        supported: false,
        span: declarationSpan,
      },
    )
  }
  return Option.none<WrittenSignature>()
}

fn selectedType(answer: &Result<Answer, NoRejection>) -> TypeSelection {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Type {resolved} => TypeSelection {
          resolved: Option.some<Shared<Type>>(Shared.clone<Type>(&resolved)),
          rejected: Option.none<Shared<Rejection>>(),
        }
        _ => TypeSelection {
          resolved: Option.none<Shared<Type>>(),
          rejected: Option.none<Shared<Rejection>>(),
        }
      }
      Outcome.Rejected {diagnostic} => TypeSelection {
        resolved: Option.none<Shared<Type>>(),
        rejected: Option.some<Shared<Rejection>>(Shared.clone<Rejection>(&diagnostic)),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => TypeSelection {
      resolved: Option.none<Shared<Type>>(),
      rejected: Option.none<Shared<Rejection>>(),
    }
  }
}

fn selectedImport(answer: &Result<Answer, NoRejection>) -> ImportSelection {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Namespace {module: _, ordinal} => ImportSelection {
          module: Option.some<usize>(ordinal),
          declaration: Option.none<usize>(),
          rejected: Option.none<Shared<Rejection>>(),
        }
        Value.Selected {declaration: _, module, ordinal} => ImportSelection {
          module: Option.some<usize>(module),
          declaration: Option.some<usize>(ordinal),
          rejected: Option.none<Shared<Rejection>>(),
        }
        _ => ImportSelection {
          module: Option.none<usize>(),
          declaration: Option.none<usize>(),
          rejected: Option.none<Shared<Rejection>>(),
        }
      }
      Outcome.Rejected {diagnostic} => ImportSelection {
        module: Option.none<usize>(),
        declaration: Option.none<usize>(),
        rejected: Option.some<Shared<Rejection>>(Shared.clone<Rejection>(&diagnostic)),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => ImportSelection {
      module: Option.none<usize>(),
      declaration: Option.none<usize>(),
      rejected: Option.none<Shared<Rejection>>(),
    }
  }
}

effect fn dependency(resolver: &mut Resolver, key: Key) -> Dependency
! Cycle | OutOfMemoryError
? &mut Allocator {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  let module = run ModuleId.copy(&modules[key.module])
  let mut name = Option.none<Bytes>()
  if key.family == Family.Name {
    let names = Vector.asSlice<Bytes>(&resolver.names)
    name = Option.some<Bytes>(run Bytes.copy(Bytes.asSlice(&names[key.name])))
  }
  let mut declaration = Option.none<DeclarationId>()
  let mut member = Option.none<usize>()
  if key.family == Family.Import || key.family == Family.Alias || key.family == Family.Identity || key.family == Family.Members || key.family == Family.MemberShape || key.family == Family.Contract || key.family == Family.Operations || key.family == Family.ImplementationHead || key.family == Family.InherentMembers || key.family == Family.ConformanceHeads || key.family == Family.ImplementationMembers || key.family == Family.FieldLifetimes || key.family == Family.Signature || key.family == Family.OperationUnder || key.family == Family.AppliedOperation || key.family == Family.AppliedInherent || key.family == Family.Coherence || key.family == Family.ProofBounds || key.family == Family.Witnesses || key.family == Family.Constant || key.family == Family.Initializer || key.family == Family.ParameterSchema || key.family == Family.ParameterDefault || key.family == Family.Body || key.family == Family.Mir || key.family == Family.Instance {
    declaration = run declarationAt(&mut resolver.*, &module, key.declaration)
  }
  if (key.family == Family.Import || key.family == Family.MemberShape || key.family == Family.OperationUnder) && key.member != usize.MAX {
    member = Option.some<usize>(key.member)
  }
  return Dependency {
    family: key.family,
    module: move module,
    name: move name,
    declaration: move declaration,
    member: move member,
    external: key.external,
  }
}

effect fn cycleAnswer(resolver: &mut Resolver, key: Key, span: Span) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  let activeKeys = Vector.asSlice<Word>(&resolver.active)
  let currentScope = Vector.get<ScopedKey>(
    &resolver.keys,
    u64.toUsize(activeKeys[activeKeys.length - usize.ONE].value),
  )
  let current = currentScope.key
  let module = run ModuleId.copy(&modules[current.module])
  let repeated = run ModuleId.copy(&modules[key.module])
  let mut path = Vector.make<Shared<DeclarationId>>()
  let mut withinCycle = false
  let mut at = usize.ZERO
  while at < Vector.length<Word>(&resolver.active) {
    let active = Vector.get<Word>(&resolver.active, at)
    let existingScope = Vector.get<ScopedKey>(&resolver.keys, u64.toUsize(active.value))
    let existing = existingScope.key
    if sameKey(existing, key) {
      withinCycle = true
    }
    if withinCycle && (existing.family == Family.Alias || existing.family == Family.Import || existing.family == Family.Initializer || existing.family == Family.ParameterDefault) {
      let ownerModule = Vector.asSlice<ModuleId>(&resolver.modules)
      let owner = run ModuleId.copy(&ownerModule[existing.module])
      let found = run declarationAt(&mut resolver.*, &owner, existing.declaration)
      if let Option<DeclarationId>.Some {value} = move found {
        run Vector.append<Shared<DeclarationId>>(
          &mut path,
          run Shared.make<DeclarationId>(move value),
        )
      }
    }
    at = at + usize.ONE
  }
  let found = run declarationAt(&mut resolver.*, &repeated, key.declaration)
  if let Option<DeclarationId>.Some {value} = move found {
    run Vector.append<Shared<DeclarationId>>(&mut path, run Shared.make<DeclarationId>(move value))
  }
  let rejection = run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.Cycle,
      module: move module,
      span: span,
      related: Option.none<Span>(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
  return run Shared.make<Result<Answer, NoRejection>>(
    Result.succeed<Answer, NoRejection>(
      Answer {
        outcome: Outcome.Rejected {diagnostic: move rejection},
        dependencies: Vector.make<Dependency>(),
        sources: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      },
    ),
  )
}

effect fn resolve(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: Option<BodyCandidate>,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return match key.family {
    Family.Name => run resolveBucket(&mut resolver.*, &mut owner.*, key)
    Family.Import => run resolveImport(&mut resolver.*, &mut owner.*, key)
    Family.Alias => run resolveAlias(&mut resolver.*, &mut owner.*, key)
    Family.Identity => run resolveIdentity(&mut resolver.*, &mut owner.*, key)
    Family.Members => run resolveMembers(&mut resolver.*, &mut owner.*, key)
    Family.MemberShape => run resolveMemberShape(&mut resolver.*, &mut owner.*, key)
    Family.Contract => run resolveContract(&mut resolver.*, &mut owner.*, key)
    Family.Operations => run resolveOperations(&mut resolver.*, &mut owner.*, key)
    Family.Implementations => run resolveImplementations(&mut resolver.*, &mut owner.*, key)
    Family.ImplementationHead => run resolveImplementationHead(&mut resolver.*, &mut owner.*, key)
    Family.InherentMembers => run resolveInherentMembers(&mut resolver.*, &mut owner.*, key)
    Family.ConformanceHeads => run resolveConformanceHeads(&mut resolver.*, &mut owner.*, key)
    Family.ImplementationMembers => run resolveImplementationMembers(
      &mut resolver.*,
      &mut owner.*,
      key,
    )
    Family.FieldLifetimes => run resolveFieldLifetimes(&mut resolver.*, &mut owner.*, key)
    Family.Signature => run resolveSignature(&mut resolver.*, &mut owner.*, key)
    Family.OperationUnder => run resolveOperationUnder(&mut resolver.*, &mut owner.*, key)
    Family.AppliedOperation => run resolveAppliedOperation(&mut resolver.*, &mut owner.*, key)
    Family.AppliedInherent => run resolveAppliedInherent(&mut resolver.*, &mut owner.*, key)
    Family.Witnesses => run resolveWitnesses(&mut resolver.*, &mut owner.*, key)
    Family.Coherence => run resolveCoherence(&mut resolver.*, &mut owner.*, key)
    Family.ProofBounds => run resolveProofBounds(&mut resolver.*, &mut owner.*, key)
    Family.Constant => run resolveConstant(&mut resolver.*, &mut owner.*, key)
    Family.Initializer => run resolveInitializer(&mut resolver.*, &mut owner.*, key)
    Family.ParameterSchema => run resolveParameterSchema(&mut resolver.*, &mut owner.*, key)
    Family.ParameterDefault => run resolveParameterDefault(&mut resolver.*, &mut owner.*, key)
    Family.ProfileInput => memberSuccess(
      Value.ProfileInput {slot: resolver.profileSlot},
      Vector.make<Dependency>(),
    )
    Family.Body => run resolveBody(&mut resolver.*, &mut owner.*, key, move candidate)
    Family.Mir => run resolveMir(&mut resolver.*, &mut owner.*, key)
    Family.Layout => run resolveLayout(&mut resolver.*, key)
    Family.Instance => run resolveInstance(&mut resolver.*, &mut owner.*, key)
  }
}

effect fn withRunning<'a, 'b>(
  resolver: &'a mut Resolver,
  query: &'b mut Query<Word, Answer, NoRejection>,
  key: Word,
  candidate: Option<BodyCandidate>,
) -> Result<Answer, NoRejection>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let base = Vector.length<Word>(&resolver.active)
  let running = Running {resolver: move resolver, query: move query, key: key, base: base}
  let use = effect fn(resource: &mut Running<'a, 'b>) -> Result<Answer, NoRejection>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run Vector.append<Word>(&mut resource.resolver.*.active, resource.key)
    run Vector.append<SourceFrame>(
      &mut resource.resolver.*.frames,
      SourceFrame {
        observations: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        direct: Vector.make<BodyDependency>(),
      },
    )
    let selectedScope = Vector.get<ScopedKey>(
      &resource.resolver.keys,
      u64.toUsize(resource.key.value),
    )
    let selected = selectedScope.key
    let mut value = run resolve(
      &mut resource.resolver.*,
      &mut resource.query.*,
      selected,
      move candidate,
    )
    value.identity = run identityOf(&value.outcome)
    let frame = Vector.remove<SourceFrame>(&mut resource.resolver.*.frames, resource.base)
    let SourceFrame {observations, footprint, direct} = move frame
    value.sources = move observations
    value.footprint = move footprint
    let id = resource.resolver.nextAnswerId
    resource.resolver.nextAnswerId = id + usize.ONE
    value.answerId = id
    if selected.family == Family.Body && isSuccessfulBody(&value.outcome) {
      value.bodyEvidence = Option.some<Shared<BodyEvidence>>(
        run Shared.make<BodyEvidence>(BodyEvidence {direct: move direct}),
      )
    } else {
      drop direct
    }
    return Result.succeed<Answer, NoRejection>(move value)
  }
  let release = effect fn(resource: &mut Running<'a, 'b>) -> () {
    Vector.truncate<SourceFrame>(&mut resource.resolver.*.frames, resource.base)
    Vector.truncate<Word>(&mut resource.resolver.*.active, resource.base)
    return ()
  }
  return run Effect.useReleaseNonParking(move running, move use, move release)
}

effect fn demandRaw(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let word = run internKey(&mut resolver.*, key)
  let mut at = usize.ZERO
  while at < Vector.length<Word>(&resolver.active) {
    let active = Vector.get<Word>(&resolver.active, at)
    if active.value == word.value {
      return run cycleAnswer(&mut resolver.*, key, span)
    }
    at = at + usize.ONE
  }
  let cached = Query.completed(&mut owner.*, word)
  let mut hit = false
  let mut candidate = Option.none<BodyCandidate>()
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move cached {
    if Shared.with<Result<Answer, NoRejection>, bool>(
      &value,
      fn(completed: &Result<Answer, NoRejection>) -> bool {
        return validAnswer(completed, &resolver.source)
      },
    ) {
      hit = true
    } else {
      if key.family == Family.Body {
        candidate = Shared.with<Result<Answer, NoRejection>, Option<BodyCandidate>>(
          &value,
          priorCandidate,
        )
      }
      Query.forget(&mut owner.*, word)
    }
  }
  let answer = run Query.demand(
    &mut owner.*,
    word,
    effect fn(query: &mut Query<Word, Answer, NoRejection>, demanded: Word) -> Result<
      Answer,
      NoRejection,
    > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
      run emit(&mut resolver.*, EventKind.Start, demanded)
      return run withRunning(&mut resolver.*, &mut query.*, demanded, move candidate)
    },
  )
  if hit {
    run emit(&mut resolver.*, EventKind.Hit, word)
  } else {
    run emit(&mut resolver.*, EventKind.Finish, word)
  }
  return move answer
}

fn cycleMember(family: Family) -> bool {
  return family == Family.Alias || family == Family.Import || family == Family.Initializer || family == Family.ParameterDefault
}

fn cycleDiagnostic(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  let found = answerRejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    if Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.Cycle
      },
    ) {
      return Option.some<Shared<Rejection>>(move value)
    }
  }
  return Option.none<Shared<Rejection>>()
}

// The member's position in the cycle, excluding the closing repeat, or `usize.MAX`.
fn cyclePosition(diagnostic: &Rejection, member: &DeclarationId) -> usize {
  let path = Vector.asSlice<Shared<DeclarationId>>(&diagnostic.path)
  let mut at = usize.ZERO
  while at + usize.ONE < path.length {
    if Shared.with<DeclarationId, bool>(
      &path[at],
      fn(id: &DeclarationId) -> bool {
        return DeclarationId.equals(id, member)
      },
    ) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn cycleLength(diagnostic: &Rejection) -> usize {
  return Vector.length<Shared<DeclarationId>>(&diagnostic.path) - usize.ONE
}

fn cycleStep(diagnostic: &Rejection, at: usize) -> Shared<DeclarationId> {
  let path = Vector.asSlice<Shared<DeclarationId>>(&diagnostic.path)
  return Shared.clone<DeclarationId>(&path[at])
}

// A cycle member answers at its own reference to the next member, with the path rotated to start
// at itself. The seed rejection depends on which member a demand entered first; this answer
// depends only on the member and the cycle, so cached members agree in every demand order.
effect fn memberCycleAnswer(
  resolver: &mut Resolver,
  parent: Key,
  answer: &Shared<Result<Answer, NoRejection>>,
  span: Span,
) -> Option<Shared<Result<Answer, NoRejection>>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !cycleMember(parent.family) {
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    answer,
    cycleDiagnostic,
  )
  let diagnostic = match move found {
    Option<Shared<Rejection>>.Some {value} => move value
    Option<Shared<Rejection>>.None => {
      return Option.none<Shared<Result<Answer, NoRejection>>>()
    }
  }
  let module = run resolvedModule(&resolver.*, parent.module)
  let owner = run declarationAt(&mut resolver.*, &module, parent.declaration)
  let member = match move owner {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Option.none<Shared<Result<Answer, NoRejection>>>()
    }
  }
  let start = Shared.with<Rejection, usize>(
    &diagnostic,
    fn(cycle: &Rejection) -> usize {
      return cyclePosition(cycle, &member)
    },
  )
  if start == usize.MAX {
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }
  let count = Shared.with<Rejection, usize>(&diagnostic, cycleLength)
  let mut path = Vector.make<Shared<DeclarationId>>()
  let mut step = usize.ZERO
  while step <= count {
    let mut at = start + step
    if at >= count {
      at = at - count
    }
    let item = Shared.with<Rejection, Shared<DeclarationId>>(
      &diagnostic,
      fn(cycle: &Rejection) -> Shared<DeclarationId> {
        return cycleStep(cycle, at)
      },
    )
    run Vector.append<Shared<DeclarationId>>(&mut path, move item)
    step = step + usize.ONE
  }
  let rejection = run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.Cycle,
      module: move module,
      span: span,
      related: Option.none<Span>(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
  return Option.some<Shared<Result<Answer, NoRejection>>>(
    run Shared.make<Result<Answer, NoRejection>>(
      Result.succeed<Answer, NoRejection>(
        Answer {
          outcome: Outcome.Rejected {diagnostic: move rejection},
          dependencies: Vector.make<Dependency>(),
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        },
      ),
    ),
  )
}

effect fn demandChild(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  key: Key,
  span: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let answer = run demandRaw(&mut resolver.*, &mut owner.*, key, span)
  let edge = run dependency(&mut resolver.*, key)
  let active = Vector.asSlice<Word>(&resolver.active)
  if active.length == usize.ZERO {
    run Vector.append<Dependency>(&mut dependencies.*, move edge)
    return move answer
  }
  let parentScope = Vector.get<ScopedKey>(
    &resolver.keys,
    u64.toUsize(active[active.length - usize.ONE].value),
  )
  let parent = parentScope.key
  let mut bodyDependency = Option.none<BodyDependency>()
  if parent.family == Family.Body {
    let declaration = match & edge.declaration {
      Option<DeclarationId>.Some {value} => Option.some<Shared<DeclarationId>>(
        run Shared.make<DeclarationId>(run DeclarationId.copy(&value)),
      )
      Option<DeclarationId>.None => Option.none<Shared<DeclarationId>>()
    }
    bodyDependency = Option.some<BodyDependency>(
      BodyDependency {
        key: key,
        declaration: move declaration,
        answerId: Shared.with<Result<Answer, NoRejection>, usize>(&answer, priorAnswerId),
        identity: Shared.with<Result<Answer, NoRejection>, Option<Shared<Value>>>(
          &answer,
          answerIdentity,
        ),
      },
    )
  }
  let footprint = run Shared.make<DemandFootprint>(
    DemandFootprint {dependency: run dependency(&mut resolver.*, key)},
  )
  run Vector.append<Dependency>(&mut dependencies.*, move edge)
  let own = run memberCycleAnswer(&mut resolver.*, parent, &answer, span)
  let count = Vector.length<SourceFrame>(&resolver.frames)
  let mut frames = Vector.asMutSlice<SourceFrame>(&mut resolver.frames)
  run Vector.append<Shared<DemandFootprint>>(
    &mut frames[count - usize.ONE].footprint,
    move footprint,
  )
  if let Option<BodyDependency>.Some {value} = move bodyDependency {
    run Vector.append<BodyDependency>(&mut frames[count - usize.ONE].direct, move value)
  }
  run mergeEvidence(&mut frames[count - usize.ONE], &answer)
  // The frame keeps the child's evidence; a cycle member publishes its own rejection instead.
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value} = move own {
    return move value
  }
  return move answer
}

effect fn resolvedModule(resolver: &Resolver, ordinal: usize) -> ModuleId
! OutOfMemoryError
? &mut Allocator {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  return run ModuleId.copy(&modules[ordinal])
}

effect fn resolvedName(resolver: &Resolver, ordinal: usize) -> Bytes
! OutOfMemoryError
? &mut Allocator {
  let names = Vector.asSlice<Bytes>(&resolver.names)
  return run Bytes.copy(Bytes.asSlice(&names[ordinal]))
}

effect fn resolveBucket(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let name = run resolvedName(&resolver.*, key.name)
  let sourceAnswer = run source(&mut resolver.*, &module)
  let bucket = run SourceIndex.observeName(
    &mut resolver.source,
    &sourceAnswer,
    &module,
    Bytes.asSlice(&name),
  )
  if let Option<Shared<NameObservation>>.Some {value} = move bucket {
    return Answer {
      outcome: Outcome.Success {value: Value.Name {bucket: move value}},
      dependencies: Vector.make<Dependency>(),
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.MissingModule,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: Vector.make<Dependency>(),
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn importedMember(resolver: &mut Resolver, module: &ModuleId, ordinal: usize, member: usize) -> Option<
  PathSyntax,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      if let Node.ImportHeader {members, ..} = Module.node(hir, declarations[ordinal].header) {
        if members.present && member < members.range.length {
          let id = Module.child(hir, members.range, member)
          if let Node.ImportMember {name, ..} = Module.node(hir, id) {
            if let Node.Name {text} = Module.node(hir, name) {
              let mut names = Vector.make<Bytes>()
              run Vector.append<Bytes>(&mut names, run Bytes.copy(Module.text(hir, text)))
              return Option.some<PathSyntax>(
                PathSyntax {segments: move names, span: Module.span(hir, name), valid: true},
              )
            }
            return Option.some<PathSyntax>(
              PathSyntax {
                segments: Vector.make<Bytes>(),
                span: Module.span(hir, name),
                valid: false,
              },
            )
          }
        }
      }
    }
  }
  return Option.none<PathSyntax>()
}

effect fn modulePath(syntax: &PathSyntax) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let segments = Vector.asSlice<Bytes>(&syntax.segments)
  let mut joined = Bytes.make()
  let mut at = usize.ZERO
  while at < segments.length {
    if at > usize.ZERO {
      run Bytes.append(&mut joined, b"/")
    }
    run Bytes.append(&mut joined, Bytes.asSlice(&segments[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut joined, b".silk")
  return move joined
}

fn intrinsicImport(syntax: &PathSyntax) -> bool {
  let segments = Vector.asSlice<Bytes>(&syntax.segments)
  return segments.length > usize.ZERO && same(Bytes.asSlice(&segments[usize.ZERO]), b"Intrinsic")
}

fn applicationImport(syntax: &PathSyntax) -> bool {
  let segments = Vector.asSlice<Bytes>(&syntax.segments)
  let expected = usize.ONE + usize.ONE
  return segments.length == expected && intrinsicImport(syntax) && same(
    Bytes.asSlice(&segments[usize.ONE]),
    b"application",
  )
}

effect fn resolveImport(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ImportHeader {path: importPath, isPublic, members, ..} = value.header {
      if isPublic && !members.present {
        let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move diagnostic},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let targetPath = run path(&mut resolver.*, &module, importPath)
      if !targetPath.valid {
        let diagnostic = run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          targetPath.span,
        )
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move diagnostic},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let mut destination = Option.none<ModuleId>()
      if applicationImport(&targetPath) {
        if resolver.currentApplication != usize.MAX {
          let selected = resolver.currentApplication
          destination = Option.some<ModuleId>(run resolvedModule(&resolver.*, selected))
        }
      } else if intrinsicImport(&targetPath) {
        let diagnostic = run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          targetPath.span,
        )
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move diagnostic},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      } else {
        let targetText = run modulePath(&targetPath)
        destination = Option.some<ModuleId>(
          run ModuleId.make(
            ModuleId.sourceOrigin(&module),
            ModuleId.packageIdentity(&module),
            Bytes.asSlice(&targetText),
          ),
        )
      }
      let target = match move destination {
        Option<ModuleId>.Some {value: selectedModule} => move selectedModule
        Option<ModuleId>.None => {
          let diagnostic = run reject(
            &resolver.*,
            &module,
            RejectionCode.MissingModule,
            targetPath.span,
          )
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move diagnostic},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
      let targetSource = run source(&mut resolver.*, &target)
      if let Option<&IndexedSource>.None = move sourceOf(&resolver.*, &targetSource, &target) {
        let diagnostic = run reject(
          &resolver.*,
          &module,
          RejectionCode.MissingModule,
          targetPath.span,
        )
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move diagnostic},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let targetOrdinal = run internModule(&mut resolver.*, &target)
      if key.member == usize.MAX {
        return Answer {
          outcome: Outcome.Success {
            value: Value.Namespace {module: move target, ordinal: targetOrdinal},
          },
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
      let selected = run importedMember(&mut resolver.*, &module, key.declaration, key.member)
      if let Option<PathSyntax>.Some {value: member} = move selected {
        if !member.valid {
          let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span)
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move diagnostic},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        let names = Vector.asSlice<Bytes>(&member.segments)
        let selectedName = Bytes.asSlice(&names[usize.ZERO])
        let nameOrdinal = run internName(&mut resolver.*, selectedName)
        let lookup = Key {
          family: Family.Name,
          module: targetOrdinal,
          name: nameOrdinal,
          declaration: usize.ZERO,
          member: usize.ZERO,
          external: true,
        }
        let observed = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies,
          lookup,
          member.span,
        )
        drop observed
        let candidate = run select(&mut resolver.*, &target, selectedName, true)
        if candidate.count == usize.ZERO || candidate.publicCount == usize.ZERO || candidate.count > usize.ONE {
          let mut code = RejectionCode.Collision
          if candidate.count == usize.ZERO {
            code = RejectionCode.UnknownMember
          } else if candidate.publicCount == usize.ZERO {
            code = RejectionCode.PrivateMember
          }
          let diagnostic = run reject(&resolver.*, &module, code, member.span)
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move diagnostic},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        if candidate.kind == CandidateKind.ImportMember {
          let nestedKey = Key {
            family: Family.Import,
            module: targetOrdinal,
            name: usize.ZERO,
            declaration: candidate.declaration,
            member: candidate.member,
            external: false,
          }
          let nested = run demandChild(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies,
            nestedKey,
            member.span,
          )
          let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
            &nested,
            selectedImport,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          if let Option<usize>.Some {value: targetModuleOrdinal} = move binding.module {
            if let Option<usize>.Some {value: resolvedDeclaration} = move binding.declaration {
              let canonical = run resolvedModule(&resolver.*, targetModuleOrdinal)
              let declaration = run declarationAt(&mut resolver.*, &canonical, resolvedDeclaration)
              if let Option<DeclarationId>.Some {value: id} = move declaration {
                return Answer {
                  outcome: Outcome.Success {
                    value: Value.Selected {
                      declaration: move id,
                      module: targetModuleOrdinal,
                      ordinal: resolvedDeclaration,
                    },
                  },
                  dependencies: move dependencies,
                  sources: Vector.make<Shared<Observation>>(),
                  footprint: Vector.make<Shared<DemandFootprint>>(),
                  answerId: usize.ZERO,
                  identity: Option.none<Shared<Value>>(),
                  bodyEvidence: Option.none<Shared<BodyEvidence>>(),
                }
              }
            }
          }
        }
        if candidate.kind != CandidateKind.Declaration {
          let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span)
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move diagnostic},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        let declaration = run declarationAt(&mut resolver.*, &target, candidate.declaration)
        if let Option<DeclarationId>.Some {value: id} = move declaration {
          return Answer {
            outcome: Outcome.Success {
              value: Value.Selected {
                declaration: move id,
                module: targetOrdinal,
                ordinal: candidate.declaration,
              },
            },
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: Outcome.Rejected {diagnostic: move diagnostic},
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn typeNode(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Option<HeaderSyntax>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    return Option.some<HeaderSyntax>(
      HeaderSyntax {header: Module.node(hir, id), span: Module.span(hir, id)},
    )
  }
  return Option.none<HeaderSyntax>()
}

effect fn typeChild(resolver: &mut Resolver, module: &ModuleId, range: Range, at: usize) -> Option<
  HirId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    return Option.some<HirId>(Module.child(IndexedSource.authored(value), range, at))
  }
  return Option.none<HirId>()
}

effect fn lifetimeAt(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> Result<
  Shared<Lifetime>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.Lifetime {name} = value.header {
      let named = run typeNode(&mut resolver.*, module, name)
      if let Option<HeaderSyntax>.Some {value: token} = move named {
        if let Node.Name {text} = token.header {
          let source = run source(&mut resolver.*, module)
          if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
            &resolver.*,
            &source,
            module,
          ) {
            let spelling = Module.text(IndexedSource.authored(indexed), text)
            if same(spelling, b"'static") {
              return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(
                run Shared.make<Lifetime>(Lifetime.Static),
              )
            }
            let mut at = usize.ZERO
            while at < binders.length {
              if let Binder.Lifetime {name: bound, value: lifetime} = &binders[at] {
                if same(Bytes.asSlice(&bound), spelling) {
                  return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(
                    Shared.clone<Lifetime>(&lifetime),
                  )
                }
              }
              at = at + usize.ONE
            }
            return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.UnknownLifetime, value.span),
            )
          }
        }
      }
    }
    return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InvalidLifetime, value.span),
    )
  }
  return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.InvalidLifetime,
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
}

effect fn elidedLifetime(
  resolver: &mut Resolver,
  module: &ModuleId,
  span: Span,
  elision: &mut LifetimeElision,
) -> Result<Shared<Lifetime>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if elision.output {
    if let Option<Shared<Lifetime>>.Some {value} = &elision.resultDefault {
      return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(Shared.clone<Lifetime>(&value))
    }
    return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.AmbiguousLifetime, span),
    )
  }
  if elision.invocation {
    if elision.nested {
      return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NestedQuantifier, span),
      )
    }
    let lifetime = run Shared.make<Lifetime>(
      Lifetime.Invocation {ordinal: renumbered(&elision.renumber, elision.nextOrdinal)},
    )
    elision.nextOrdinal = elision.nextOrdinal + usize.ONE
    run Vector.append<Shared<Lifetime>>(&mut elision.generated, Shared.clone<Lifetime>(&lifetime))
    return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(move lifetime)
  }
  if let Option<DeclarationId>.Some {value: owner} = &elision.owner {
    let mut lifetime = run Shared.make<Lifetime>(
      Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: elision.nextOrdinal},
    )
    if let Option<Vector<Argument>>.Some {value: supplied} = &elision.supplied {
      let arguments = Vector.asSlice<Argument>(&supplied)
      if elision.nextOrdinal < arguments.length {
        if let Argument.Lifetime {value: selected} = &arguments[elision.nextOrdinal] {
          lifetime = Shared.clone<Lifetime>(&selected)
        }
      }
    }
    elision.nextOrdinal = elision.nextOrdinal + usize.ONE
    run Vector.append<Shared<Lifetime>>(&mut elision.generated, Shared.clone<Lifetime>(&lifetime))
    return Result.succeed<Shared<Lifetime>, Shared<Rejection>>(move lifetime)
  }
  // Body-local elided lifetimes have no represented owner yet.
  return Result.failResult<Shared<Lifetime>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

effect fn writtenOrElidedLifetime(
  resolver: &mut Resolver,
  module: &ModuleId,
  written: HirRef,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Lifetime>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if written.present {
    return run lifetimeAt(&mut resolver.*, module, written.id, binders)
  }
  return run elidedLifetime(&mut resolver.*, module, span, &mut elision.*)
}

effect fn templateBinders(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Result<
  Vector<Binder>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut binders = Vector.make<Binder>()
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length {
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
    }
    let hir = IndexedSource.authored(value)
    let written = Module.node(hir, declarations[ordinal].header)
    let mut generics = Range.empty()
    // Bounds are recorded by the declaration's Contract or Signature; a use that needs one proved
    // is rejected where the declaration is applied.
    if let Node.FunctionHeader {contract, ..} = written {
      if let Node.CallableContract {generics: parameters, ..} = Module.node(hir, contract) {
        generics = parameters
      }
    }
    if let Node.OperationHeader {contract, ..} = written {
      if let Node.CallableContract {generics: parameters, ..} = Module.node(hir, contract) {
        generics = parameters
      }
    }
    if let Node.StructHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.TupleHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.UnionHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.ServiceHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.InterfaceHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.AliasHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if let Node.ImplHeader {generics: parameters, ..} = written {
      generics = parameters
    }
    if generics.length == usize.ZERO {
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
    }
    if let Option<DeclarationId>.Some {value: owner} = move identity {
      let mut at = usize.ZERO
      while at < generics.length {
        let parameter = Module.child(hir, generics, at)
        let syntax = Module.node(hir, parameter)
        if let Node.RowParameter {name} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            if hasBinder(Vector.asSlice<Binder>(&binders), spelling) {
              return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                run reject(
                  &resolver.*,
                  module,
                  RejectionCode.DuplicateTypeParameter,
                  Module.span(hir, parameter),
                ),
              )
            }
            run Vector.append<Binder>(
              &mut binders,
              Binder.Row {
                name: run Bytes.copy(spelling),
                value: RowParameter {
                  declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
                  ordinal: at,
                },
                bound: Option.none<Shared<Row>>(),
              },
            )
            at = at + usize.ONE
            continue
          }
        }
        if let Node.TypeParameter {name, ..} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            let prior = Vector.asSlice<Binder>(&binders)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(binderName(&prior[before]), spelling) {
                return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                  run reject(
                    &resolver.*,
                    module,
                    RejectionCode.DuplicateTypeParameter,
                    Module.span(hir, parameter),
                  ),
                )
              }
              before = before + usize.ONE
            }
            let parameterOwner = run DeclarationId.copy(&owner)
            let parameterType = run Shared.make<Type>(
              Type.Parameter {declaration: move parameterOwner, ordinal: at},
            )
            run Vector.append<Binder>(
              &mut binders,
              Binder.Type {name: run Bytes.copy(spelling), value: move parameterType},
            )
            at = at + usize.ONE
            continue
          }
        }
        if let Node.LifetimeParameter {name, ..} = syntax {
          if let Node.Name {text} = Module.node(hir, name) {
            let spelling = Module.text(hir, text)
            if same(spelling, b"'static") {
              return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                run reject(
                  &resolver.*,
                  module,
                  RejectionCode.InvalidLifetime,
                  Module.span(hir, parameter),
                ),
              )
            }
            let prior = Vector.asSlice<Binder>(&binders)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(binderName(&prior[before]), spelling) {
                return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                  run reject(
                    &resolver.*,
                    module,
                    RejectionCode.DuplicateLifetimeParameter,
                    Module.span(hir, parameter),
                  ),
                )
              }
              before = before + usize.ONE
            }
            run Vector.append<Binder>(
              &mut binders,
              Binder.Lifetime {
                name: run Bytes.copy(spelling),
                value: run Shared.make<Lifetime>(
                  Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: at},
                ),
              },
            )
            at = at + usize.ONE
            continue
          }
        }
        return Result.failResult<Vector<Binder>, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, Module.span(hir, parameter)),
        )
      }
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
    }
  }
  return Result.failResult<Vector<Binder>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
  )
}

fn copyBound(bound: &Option<Shared<Row>>) -> Option<Shared<Row>> {
  return match & bound.* {
    Option<Shared<Row>>.Some {value} => Option.some<Shared<Row>>(Shared.clone<Row>(&value))
    Option<Shared<Row>>.None => Option.none<Shared<Row>>()
  }
}

fn binderName(binder: &Binder) -> &[u8] {
  return match & binder.* {
    Binder.Type {name, ..} => Bytes.asSlice(&name)
    Binder.Lifetime {name, ..} => Bytes.asSlice(&name)
    Binder.Row {name, ..} => Bytes.asSlice(&name)
  }
}

fn hasBinder(binders: &[Binder], spelling: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < binders.length {
    if same(binderName(&binders[at]), spelling) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn bindArguments(template: &[Binder], arguments: &[Argument]) -> Vector<Binder>
! OutOfMemoryError
? &mut Allocator {
  let mut applied = Vector.make<Binder>()
  let mut at = usize.ZERO
  while at < template.length {
    let bound = match & template[at] {
      Binder.Type {name, value: original} => match & arguments[at] {
        Argument.Type {value} => Binder.Type {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Type>(&value),
        }
        _ => Binder.Type {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Type>(&original),
        }
      }
      Binder.Lifetime {name, value: original} => match & arguments[at] {
        Argument.Lifetime {value} => Binder.Lifetime {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Lifetime>(&value),
        }
        _ => Binder.Lifetime {
          name: run Bytes.copy(Bytes.asSlice(&name)),
          value: Shared.clone<Lifetime>(&original),
        }
      }
      Binder.Row {name, value, bound: prior} => Binder.Row {
        name: run Bytes.copy(Bytes.asSlice(&name)),
        value: RowParameter {
          declaration: Shared.clone<DeclarationId>(&value.declaration),
          ordinal: value.ordinal,
        },
        bound: match & arguments[at] {
          Argument.Row {value: supplied} => Option.some<Shared<Row>>(Shared.clone<Row>(&supplied))
          _ => copyBound(&prior)
        },
      }
    }
    run Vector.append<Binder>(&mut applied, move bound)
    at = at + usize.ONE
  }
  return move applied
}

effect fn typeFromAnswer(answer: &Shared<Result<Answer, NoRejection>>) -> TypeSelection {
  return Shared.with<Result<Answer, NoRejection>, TypeSelection>(answer, selectedType)
}

fn privateNominal(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Nominal {isPublic, arguments, ..} => {
      if !isPublic {
        return true
      }
      let values = Vector.asSlice<Argument>(&arguments)
      let mut at = usize.ZERO
      while at < values.length {
        if let Argument.Type {value} = &values[at] {
          if Shared.with<Type, bool>(&value, privateNominal) {
            return true
          }
        }
        if let Argument.Row {value: row} = &values[at] {
          if Shared.with<Row, bool>(&row, privateRow) {
            return true
          }
        }
        at = at + usize.ONE
      }
      return false
    }
    Type.NamedRepresentation {isPublic, arguments, ..} => {
      if !isPublic {
        return true
      }
      let values = Vector.asSlice<Argument>(&arguments)
      let mut at = usize.ZERO
      while at < values.length {
        if let Argument.Type {value} = &values[at] {
          if Shared.with<Type, bool>(&value, privateNominal) {
            return true
          }
        }
        if let Argument.Row {value: row} = &values[at] {
          if Shared.with<Row, bool>(&row, privateRow) {
            return true
          }
        }
        at = at + usize.ONE
      }
      return false
    }
    Type.OpaqueRepresentation {arguments, contract, ..} => {
      if Shared.with<Type, bool>(&contract, privateNominal) {
        return true
      }
      let values = Vector.asSlice<Argument>(&arguments)
      let mut at = usize.ZERO
      while at < values.length {
        if let Argument.Type {value} = &values[at] {
          if Shared.with<Type, bool>(&value, privateNominal) {
            return true
          }
        }
        if let Argument.Row {value: row} = &values[at] {
          if Shared.with<Row, bool>(&row, privateRow) {
            return true
          }
        }
        at = at + usize.ONE
      }
      return false
    }
    Type.Reference {referent, ..} => Shared.with<Type, bool>(&referent, privateNominal)
    Type.Slice {element, ..} => Shared.with<Type, bool>(&element, privateNominal)
    Type.Pointer {pointee, ..} => Shared.with<Type, bool>(&pointee, privateNominal)
    Type.Array {element, ..} => Shared.with<Type, bool>(&element, privateNominal)
    Type.Union {members} => anyPrivate(&members)
    Type.Callable {parameters, result, ..} => anyPrivate(&parameters) || Shared.with<Type, bool>(
      &result,
      privateNominal,
    )
    Type.Effect {success, failure, requirements, ..} => Shared.with<Type, bool>(
      &success,
      privateNominal,
    ) || Shared.with<Type, bool>(&failure, privateNominal) || Shared.with<Row, bool>(
      &requirements,
      privateRow,
    )
    _ => false
  }
}

fn anyPrivate(types: &Vector<Shared<Type>>) -> bool {
  let values = Vector.asSlice<Shared<Type>>(types)
  let mut at = usize.ZERO
  while at < values.length {
    if Shared.with<Type, bool>(&values[at], privateNominal) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn privateRow(row: &Row) -> bool {
  let entries = Vector.asSlice<Requirement>(&row.entries)
  let mut at = usize.ZERO
  while at < entries.length {
    if Shared.with<Type, bool>(&entries[at].capability, privateNominal) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn outerLifetime(resolved: &Type) -> Option<Shared<Lifetime>> {
  return match & resolved.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(
      Shared.clone<Lifetime>(&lifetime),
    )
    Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.String {lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    _ => Option.none<Shared<Lifetime>>()
  }
}

effect fn exposedPrivate(
  resolver: &mut Resolver,
  module: &ModuleId,
  typeId: HirId,
  resolved: &Shared<Type>,
  publicContract: bool,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !publicContract || !Shared.with<Type, bool>(resolved, privateNominal) {
    return Option.none<Shared<Rejection>>()
  }
  let syntax = run typeNode(&mut resolver.*, module, typeId)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    return Option.some<Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.PrivateTypeExposure, value.span),
    )
  }
  return Option.some<Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.PrivateTypeExposure,
      Span.make(usize.ZERO, usize.ZERO),
    ),
  )
}

fn rowBinderCount(binders: &[Binder]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Row {..} = &binders[at] {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn headerGenerics(header: Node) -> Range {
  return match header {
    Node.StructHeader {generics, ..} => generics
    Node.TupleHeader {generics, ..} => generics
    Node.UnionHeader {generics, ..} => generics
    Node.ServiceHeader {generics, ..} => generics
    Node.InterfaceHeader {generics, ..} => generics
    Node.AliasHeader {generics, ..} => generics
    _ => Range.empty()
  }
}

// Whether a type, alias, interface, or service declaration writes a bound that needs proof: an
// interface, service, or representation bound. Lifetime bounds are recorded without a proof claim.
effect fn declaresBounds(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run header(&mut resolver.*, module, ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let generics = headerGenerics(value.header)
    let mut at = usize.ZERO
    while at < generics.length {
      let child = run typeChild(&mut resolver.*, module, generics, at)
      if let Option<HirId>.Some {value: parameterId} = move child {
        let syntax = run typeNode(&mut resolver.*, module, parameterId)
        if let Option<HeaderSyntax>.Some {value: parameter} = move syntax {
          if let Node.TypeParameter {bounds, ..} = parameter.header {
            let mut boundAt = usize.ZERO
            while boundAt < bounds.length {
              let bound = run typeChild(&mut resolver.*, module, bounds, boundAt)
              if let Option<HirId>.Some {value: boundId} = move bound {
                let boundSyntax = run typeNode(&mut resolver.*, module, boundId)
                if let Option<HeaderSyntax>.Some {value: boundNode} = move boundSyntax {
                  let mut lifetimeBound = false
                  if let Node.Lifetime {..} = boundNode.header {
                    lifetimeBound = true
                  }
                  if !lifetimeBound {
                    return true
                  }
                }
              }
              boundAt = boundAt + usize.ONE
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

effect fn declarationType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  declaration: usize,
  anchor: &ModuleId,
  span: Span,
  application: Option<HirId>,
  callerBinders: &[Binder],
  callerElision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let written = run header(&mut resolver.*, &module, declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let family = match value.header {
      Node.AliasHeader {..} => Family.Alias
      Node.StructHeader {..} => Family.Identity
      Node.TupleHeader {..} => Family.Identity
      Node.EnumHeader {..} => Family.Identity
      Node.UnionHeader {..} => Family.Identity
      Node.ServiceHeader {..} => Family.Identity
      Node.InterfaceHeader {..} => Family.Identity
      Node.RoleHeader {..} => Family.Identity
      _ => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, anchor, RejectionCode.NotType, span),
        )
      }
    }
    let template = run templateBinders(&mut resolver.*, &module, declaration)
    let mut binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
    let incomplete = run completeAggregateBinders(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      &module,
      declaration,
      span,
      &mut binders,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move incomplete {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
    }
    let boundLifetimes = run completeBoundBinders(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      &module,
      declaration,
      span,
      &mut binders,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move boundLifetimes {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
    }
    let rowBinders = rowBinderCount(Vector.asSlice<Binder>(&binders))
    let mut rowSyntax = HirRef.absent()
    let mut argumentIds = Range.empty()
    let mut argumentSpan = span
    let mut hasApplication = false
    if let Option<HirId>.Some {value: id} = move application {
      hasApplication = true
      let syntax = run typeNode(&mut resolver.*, anchor, id)
      if let Option<HeaderSyntax>.Some {value: argumentSyntax} = move syntax {
        argumentSpan = argumentSyntax.span
        if let Node.TypeArguments {arguments, environment, failures, requirements} = argumentSyntax.header {
          // One `? Row` suffix supplies the sole row binder; several row binders cannot be written.
          if requirements.present && rowBinders > usize.ONE {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, anchor, RejectionCode.Unsupported, argumentSpan),
            )
          }
          if requirements.present && rowBinders == usize.ONE {
            rowSyntax = requirements
          }
          if environment.present || failures.present || (requirements.present && rowBinders == usize.ZERO) {
            let mut suppliedKind = GenericKind.Lifetime
            if failures.present {
              suppliedKind = GenericKind.Failure
            }
            if requirements.present {
              suppliedKind = GenericKind.Requirement
            }
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run rejectKind(&resolver.*, anchor, argumentSpan, b"", GenericKind.Type, suppliedKind),
            )
          }
          argumentIds = arguments
        } else {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(
            run reject(&resolver.*, anchor, RejectionCode.Unsupported, argumentSpan),
          )
        }
      }
    }
    let expected = Vector.length<Binder>(&binders)
    if expected == usize.ZERO && hasApplication {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length),
      )
    }
    // GEN-002 with LIFE-003: omitted lifetimes elide only when none is written; a partial written
    // list is an arity error. A lifetime written where none is declared keeps its kind rejection.
    let writtenLifetimes = run countWrittenLifetimes(&mut resolver.*, anchor, argumentIds)
    let lifetimeParameters = writtenLifetimeCount(Vector.asSlice<Binder>(&binders))
    if writtenLifetimes > usize.ZERO && writtenLifetimes < lifetimeParameters {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length),
      )
    }
    let mut arguments = Vector.make<Argument>()
    let mut argumentAt = usize.ZERO
    let mut suffixUsed = false
    let callerModule = run internModule(&mut resolver.*, anchor)
    let parameters = Vector.asSlice<Binder>(&binders)
    let mut binderAt = usize.ZERO
    while binderAt < parameters.length {
      let mut supplied = Option.none<HirId>()
      let mut suppliedKind = GenericKind.Type
      let mut suppliedSpan = argumentSpan
      if argumentAt < argumentIds.length {
        supplied = run typeChild(&mut resolver.*, anchor, argumentIds, argumentAt)
        if let Option<HirId>.Some {value: argumentId} = &supplied {
          let source = run typeNode(&mut resolver.*, anchor, argumentId)
          if let Option<HeaderSyntax>.Some {value: argumentNode} = move source {
            suppliedSpan = argumentNode.span
            if let Node.Lifetime {..} = argumentNode.header {
              suppliedKind = GenericKind.Lifetime
            }
            if let Node.RequirementSelector {..} = argumentNode.header {
              suppliedKind = GenericKind.Requirement
            }
          }
        }
      }
      if let Binder.Lifetime {name, ..} = &parameters[binderAt] {
        if suppliedKind == GenericKind.Lifetime && argumentAt < argumentIds.length {
          if let Option<HirId>.Some {value: argumentId} = move supplied {
            let resolved = run lifetimeAt(&mut resolver.*, anchor, argumentId, callerBinders)
            match move resolved {
              Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
                run Vector.append<Argument>(
                  &mut arguments,
                  Argument.Lifetime {value: move lifetime},
                )
              }
              Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
              }
            }
            argumentAt = argumentAt + usize.ONE
          }
        } else {
          let elided = run elidedLifetime(
            &mut resolver.*,
            anchor,
            suppliedSpan,
            &mut callerElision.*,
          )
          match move elided {
            Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
              run Vector.append<Argument>(&mut arguments, Argument.Lifetime {value: move lifetime})
            }
            Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
            }
          }
        }
      } else if let Binder.Row {name, ..} = &parameters[binderAt] {
        // GEN-002: arguments are kind-directed, so a positional argument in a `?R` position is a
        // requirement row, exactly like the `? Row` suffix.
        if let Option<HirId>.Some {value: argumentId} = move supplied {
          if suppliedKind == GenericKind.Lifetime {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run rejectKind(
                &resolver.*,
                anchor,
                suppliedSpan,
                Bytes.asSlice(&name),
                GenericKind.Requirement,
                suppliedKind,
              ),
            )
          }
          let mut positional = Row.empty()
          let added = run rowArgument(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            callerModule,
            anchor,
            argumentId,
            Bytes.asSlice(&name),
            callerBinders,
            &mut callerElision.*,
            &mut positional,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
          }
          run Vector.append<Argument>(
            &mut arguments,
            Argument.Row {value: run Shared.make<Row>(move positional)},
          )
          argumentAt = argumentAt + usize.ONE
          binderAt = binderAt + usize.ONE
          continue
        }
        if !rowSyntax.present {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(
            run rejectKind(
              &resolver.*,
              anchor,
              argumentSpan,
              Bytes.asSlice(&name),
              GenericKind.Requirement,
              GenericKind.Type,
            ),
          )
        }
        suffixUsed = true
        let suppliedRow = run resolveChannels(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          callerModule,
          anchor,
          HirRef.absent(),
          rowSyntax,
          callerBinders,
          &mut callerElision.*,
        )
        match move suppliedRow {
          Result<Channels, Shared<Rejection>>.Success {value: channels} => {
            run Vector.append<Argument>(
              &mut arguments,
              Argument.Row {value: move channels.requirements},
            )
          }
          Result<Channels, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
          }
        }
      } else if let Binder.Type {name, ..} = &parameters[binderAt] {
        if let Option<HirId>.Some {value: argumentId} = move supplied {
          if suppliedKind != GenericKind.Type {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run rejectKind(
                &resolver.*,
                anchor,
                suppliedSpan,
                Bytes.asSlice(&name),
                GenericKind.Type,
                suppliedKind,
              ),
            )
          }
          let resolved = run resolveType(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            callerModule,
            argumentId,
            callerBinders,
            &mut callerElision.*,
          )
          match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
              run Vector.append<Argument>(&mut arguments, Argument.Type {value: move ty})
            }
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
            }
          }
          argumentAt = argumentAt + usize.ONE
        } else {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(
            run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length),
          )
        }
      }
      binderAt = binderAt + usize.ONE
    }
    if argumentAt != argumentIds.length {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length),
      )
    }
    // A `? Row` suffix supplies the row binder that no positional argument filled; one written after
    // every row binder was supplied positionally is an extra argument.
    if rowSyntax.present && !suffixUsed {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run rejectArity(&resolver.*, anchor, argumentSpan, expected, argumentIds.length + usize.ONE),
      )
    }
    let bounded = run declaresBounds(&mut resolver.*, &module, declaration)
    let key = Key {
      family: family,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: declaration,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
    let selected = run typeFromAnswer(&answer)
    if let Option<Shared<Type>>.Some {value: resolved} = move selected.resolved {
      if bounded && expected > usize.ZERO {
        let isPublic = match value.header {
          Node.StructHeader {isPublic, ..} => isPublic
          Node.TupleHeader {isPublic, ..} => isPublic
          Node.EnumHeader {isPublic, ..} => isPublic
          Node.UnionHeader {isPublic, ..} => isPublic
          Node.ServiceHeader {isPublic, ..} => isPublic
          Node.InterfaceHeader {isPublic, ..} => isPublic
          Node.AliasHeader {isPublic, ..} => isPublic
          _ => false
        }
        let applied = run appliedDeclarationBounds(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          declaration,
          headerGenerics(value.header),
          parameters,
          Vector.asSlice<Argument>(&arguments),
          span,
          isPublic,
        )
        let bounds = match move applied {
          Result<Vector<Constraint>, Shared<Rejection>>.Success {value: resolvedBounds} => move resolvedBounds
          Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
          }
        }
        let mut assumptions = Vector.make<Constraint>()
        if let Option<Vector<Constraint>>.Some {value: available} = &callerElision.assumptions {
          assumptions = run copyConstraints(Vector.asSlice<Constraint>(&available))
        }
        let failure = run proveAppliedBounds(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          &assumptions,
          Vector.asSlice<Constraint>(&bounds),
          anchor,
          span,
        )
        if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
        }
      }
      if family == Family.Alias {
        if let Node.AliasHeader {target, ..} = value.header {
          let applied = run bindArguments(
            Vector.asSlice<Binder>(&binders),
            Vector.asSlice<Argument>(&arguments),
          )
          // The alias query validates the declaration. A use expands under the caller's
          // elision context, so an omitted alias lifetime remains fresh per use.
          return run resolveType(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            moduleOrdinal,
            target,
            Vector.asSlice<Binder>(&applied),
            &mut callerElision.*,
          )
        }
      }
      if expected > usize.ZERO {
        let found = run declarationAt(&mut resolver.*, &module, declaration)
        if let Option<DeclarationId>.Some {value: id} = move found {
          let isPublic = match value.header {
            Node.StructHeader {isPublic, ..} => isPublic
            Node.TupleHeader {isPublic, ..} => isPublic
            Node.UnionHeader {isPublic, ..} => isPublic
            Node.ServiceHeader {isPublic, ..} => isPublic
            Node.InterfaceHeader {isPublic, ..} => isPublic
            _ => false
          }
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Nominal {declaration: move id, isPublic: isPublic, arguments: move arguments},
            ),
          )
        }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(move resolved)
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selected.rejected {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
    }
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, anchor, RejectionCode.Unsupported, span),
  )
}

effect fn selectDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  anchor: &ModuleId,
  name: &[u8],
  external: bool,
  span: Span,
  wrongKind: RejectionCode,
) -> Result<SelectedDeclaration, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let nameOrdinal = run internName(&mut resolver.*, name)
  let key = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: external,
  }
  let observed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  drop observed
  let selected = run select(&mut resolver.*, &module, name, external)
  if selected.count == usize.ZERO {
    let mut code = RejectionCode.UnknownName
    if external {
      code = RejectionCode.UnknownMember
    }
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, anchor, code, span),
    )
  }
  if external && selected.publicCount == usize.ZERO {
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, anchor, RejectionCode.PrivateMember, span),
    )
  }
  if selected.count > usize.ONE {
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, anchor, RejectionCode.Collision, span),
    )
  }
  if selected.kind == CandidateKind.ImportMember {
    let importKey = Key {
      family: Family.Import,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: selected.declaration,
      member: selected.member,
      external: false,
    }
    let imported = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      importKey,
      span,
    )
    let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
      &imported,
      selectedImport,
    )
    if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
      return Result.failResult<SelectedDeclaration, Shared<Rejection>>(move value)
    }
    if let Option<usize>.Some {value: targetModule} = move binding.module {
      if let Option<usize>.Some {value: declaration} = move binding.declaration {
        return Result.succeed<SelectedDeclaration, Shared<Rejection>>(
          SelectedDeclaration {module: targetModule, ordinal: declaration},
        )
      }
    }
  }
  if selected.kind == CandidateKind.Declaration {
    return Result.succeed<SelectedDeclaration, Shared<Rejection>>(
      SelectedDeclaration {module: moduleOrdinal, ordinal: selected.declaration},
    )
  }
  return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
    run reject(&resolver.*, anchor, wrongKind, span),
  )
}

effect fn namedType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  anchor: &ModuleId,
  name: &[u8],
  external: bool,
  span: Span,
  application: Option<HirId>,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let selected = run selectDeclaration(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    anchor,
    name,
    external,
    span,
    RejectionCode.NotType,
  )
  match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => {
      return run declarationType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        value.module,
        value.ordinal,
        anchor,
        span,
        move application,
        binders,
        &mut elision.*,
      )
    }
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
}

fn decimalU64(digits: &[u8]) -> Option<u64> {
  if digits.length == usize.ZERO || !fitsMagnitude(digits, b"18446744073709551615") {
    return Option.none<u64>()
  }
  let mut value: u64 = 0
  let mut at = usize.ZERO
  while at < digits.length {
    if digits[at] < 48 || digits[at] > 57 {
      return Option.none<u64>()
    }
    value = value * 10 + u8.toU64(digits[at] - 48)
    at = at + usize.ONE
  }
  return Option.some<u64>(value)
}

effect fn pointerAlignment(resolver: &mut Resolver, module: &ModuleId, qualifiers: Range) -> Result<
  Option<u64>,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut alignment = Option.none<u64>()
  let mut seenAddressSpace = false
  let mut at = usize.ZERO
  while at < qualifiers.length {
    let child = run typeChild(&mut resolver.*, module, qualifiers, at)
    if let Option<HirId>.Some {value: id} = move child {
      let syntax = run typeNode(&mut resolver.*, module, id)
      if let Option<HeaderSyntax>.Some {value: qualifier} = move syntax {
        if let Node.PointerQualifier {name, value} = qualifier.header {
          let named = run typeNode(&mut resolver.*, module, name)
          let digits = run typeNode(&mut resolver.*, module, value)
          if let Option<HeaderSyntax>.Some {value: nameNode} = move named {
            if let Option<HeaderSyntax>.Some {value: numberNode} = move digits {
              if let Node.Name {text} = nameNode.header {
                if let Node.IntegerLiteral {magnitude, ..} = numberNode.header {
                  let sourceAnswer = run source(&mut resolver.*, module)
                  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
                    &resolver.*,
                    &sourceAnswer,
                    module,
                  ) {
                    let hir = IndexedSource.authored(indexed)
                    let label = Module.text(hir, text)
                    let parsed = decimalU64(Module.text(hir, magnitude))
                    if let Option<u64>.Some {value: count} = move parsed {
                      if same(label, b"align") {
                        let vacant = match & alignment {
                          Option<u64>.None => true
                          Option<u64>.Some {value: _} => false
                        }
                        if vacant && count > 0 && count <= 536870912 && u64.bitAnd(count, count - 1) == 0 {
                          alignment = Option.some<u64>(count)
                          at = at + usize.ONE
                          continue
                        }
                      }
                      if same(label, b"addrspace") && !seenAddressSpace && count == 0 {
                        seenAddressSpace = true
                        at = at + usize.ONE
                        continue
                      }
                    }
                  }
                }
              }
            }
          }
        }
        return Result.failResult<Option<u64>, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.InvalidPointerQualifier, qualifier.span),
        )
      }
    }
    return Result.failResult<Option<u64>, Shared<Rejection>>(
      run reject(
        &resolver.*,
        module,
        RejectionCode.InvalidPointerQualifier,
        Span.make(usize.ZERO, usize.ZERO),
      ),
    )
  }
  return Result.succeed<Option<u64>, Shared<Rejection>>(move alignment)
}

effect fn qualifiedType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  segments: &[Bytes],
  span: Span,
  application: Option<HirId>,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let namespace = Bytes.asSlice(&segments[usize.ZERO])
  // The sealed namespace cannot be shadowed; its type families are not implemented yet.
  if same(namespace, b"Intrinsic") {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
    )
  }
  let selected = run select(&mut resolver.*, module, namespace, false)
  let nameOrdinal = run internName(&mut resolver.*, namespace)
  let nameKey = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let observed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, nameKey, span)
  drop observed
  if selected.count != usize.ONE || selected.kind != CandidateKind.ImportModule {
    let mut code = RejectionCode.NotType
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownName
    } else if selected.count > usize.ONE {
      code = RejectionCode.Collision
    }
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, code, span),
    )
  }
  let importKey = Key {
    family: Family.Import,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: selected.declaration,
    member: usize.MAX,
    external: false,
  }
  let imported = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    importKey,
    span,
  )
  let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(&imported, selectedImport)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(move diagnostic)
  }
  if let Option<usize>.Some {value: targetModule} = move binding.module {
    return run namedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      targetModule,
      module,
      Bytes.asSlice(&segments[usize.ONE]),
      true,
      span,
      move application,
      binders,
      &mut elision.*,
    )
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

fn borrowedOrBare(value: &Type) -> bool {
  return match & value.* {
    Type.Reference {..} => true
    Type.Slice {..} => true
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

effect fn resolveUnion(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  written: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut members = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < written.length {
    let child = run typeChild(&mut resolver.*, module, written, at)
    if let Option<HirId>.Some {value: memberId} = move child {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        memberId,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Shared.with<Type, bool>(&ty, borrowedOrBare) {
            let syntax = run typeNode(&mut resolver.*, module, memberId)
            let mut span = Span.make(usize.ZERO, usize.ZERO)
            if let Option<HeaderSyntax>.Some {value} = move syntax {
              span = value.span
            }
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.InvalidUnionMember, span),
            )
          }
          run Type.joinMember(&mut members, &ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  let joined = Vector.asSlice<Shared<Type>>(&members)
  if joined.length == usize.ONE {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(&joined[usize.ZERO]))
  }
  return Result.succeed<Shared<Type>, Shared<Rejection>>(
    run Shared.make<Type>(Type.Union {members: move members}),
  )
}

// Resolves a written `'a & 'b` environment to its canonical intersection. A written but empty
// environment is invalid rather than a request for elision.
effect fn writtenEnvironment(
  resolver: &mut Resolver,
  module: &ModuleId,
  regions: Range,
  span: Span,
  binders: &[Binder],
) -> Result<Intersection, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if regions.length == usize.ZERO {
    return Result.failResult<Intersection, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
    )
  }
  let mut members = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < regions.length {
    let child = run typeChild(&mut resolver.*, module, regions, at)
    if let Option<HirId>.Some {value: id} = move child {
      let resolved = run lifetimeAt(&mut resolver.*, module, id, binders)
      match move resolved {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => {
          run Vector.append<Shared<Lifetime>>(&mut members, move value)
        }
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Intersection, Shared<Rejection>>(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<Intersection, Shared<Rejection>>(
    run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&members)),
  )
}

// An omitted environment elides to one region.
effect fn elidedEnvironment(
  resolver: &mut Resolver,
  module: &ModuleId,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Intersection, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if elision.staticEnvironment {
    elision.staticEnvironment = false
    let none = Vector.make<Shared<Lifetime>>()
    return Result.succeed<Intersection, Shared<Rejection>>(
      run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&none)),
    )
  }
  let elided = run writtenOrElidedLifetime(
    &mut resolver.*,
    module,
    HirRef.absent(),
    span,
    binders,
    &mut elision.*,
  )
  return match move elided {
    Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => {
      let mut regions = Vector.make<Shared<Lifetime>>()
      run Vector.append<Shared<Lifetime>>(&mut regions, move value)
      return Result.succeed<Intersection, Shared<Rejection>>(
        run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)),
      )
    }
    Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => Result.failResult<
      Intersection,
      Shared<Rejection>,
    >(move error)
  }
}

effect fn resolveEffect(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  span: Span,
  application: Option<HirId>,
  mode: CallableMode,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut supplied = Range.empty()
  let mut argumentSpan = span
  let mut declared = Option.none<Range>()
  let mut failures = HirRef.absent()
  let mut requirements = HirRef.absent()
  if let Option<HirId>.Some {value: id} = move application {
    let syntax = run typeNode(&mut resolver.*, module, id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      argumentSpan = value.span
      if let Node.TypeArguments {
        arguments,
        environment: written,
        failures: failure,
        requirements: row,
      } = value.header {
        if written.present {
          declared = Option.some<Range>(written.range)
        }
        supplied = arguments
        failures = failure
        requirements = row
      }
    }
  }
  if supplied.length != usize.ONE {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run rejectArity(&resolver.*, module, argumentSpan, usize.ONE, supplied.length),
    )
  }
  let retained = match move declared {
    Option<Range>.Some {value: regions} => run writtenEnvironment(
      &mut resolver.*,
      module,
      regions,
      argumentSpan,
      binders,
    )
    Option<Range>.None => run elidedEnvironment(
      &mut resolver.*,
      module,
      span,
      binders,
      &mut elision.*,
    )
  }
  let region = match move retained {
    Result<Intersection, Shared<Rejection>>.Success {value: found} => run Shared.make<Intersection>(
      move found,
    )
    Result<Intersection, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  // The parameterless default covers only the result's own environment, written or not.
  elision.staticEnvironment = false
  let successId = run typeChild(&mut resolver.*, module, supplied, usize.ZERO)
  let mut success = run Shared.make<Type>(Type.Unit)
  if let Option<HirId>.Some {value: id} = move successId {
    let syntax = run typeNode(&mut resolver.*, module, id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      let mut kind = GenericKind.Type
      if let Node.Lifetime {..} = value.header {
        kind = GenericKind.Lifetime
      }
      if let Node.RequirementSelector {..} = value.header {
        kind = GenericKind.Requirement
      }
      if kind != GenericKind.Type {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run rejectKind(&resolver.*, module, value.span, b"", GenericKind.Type, kind),
        )
      }
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      id,
      binders,
      &mut elision.*,
    )
    success = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
  }
  let channels = run resolveChannels(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    module,
    failures,
    requirements,
    binders,
    &mut elision.*,
  )
  match move channels {
    Result<Channels, Shared<Rejection>>.Success {value} => {
      return Result.succeed<Shared<Type>, Shared<Rejection>>(
        run Shared.make<Type>(
          Type.Effect {
            mode: mode,
            environment: move region,
            success: move success,
            failure: move value.failure,
            requirements: move value.requirements,
          },
        ),
      )
    }
    Result<Channels, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
}

// Resolves a written `! E` and `? R`; omission is `never` and the empty row, not inference.
effect fn resolveChannels(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  failures: HirRef,
  requirements: HirRef,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Channels, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut failure = run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()})
  if failures.present {
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      failures.id,
      binders,
      &mut elision.*,
    )
    failure = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Channels, Shared<Rejection>>(move error)
      }
    }
  }
  let mut row = Row.empty()
  if requirements.present {
    let syntax = run typeNode(&mut resolver.*, module, requirements.id)
    if let Option<HeaderSyntax>.Some {value} = move syntax {
      if let Node.RequirementRow {members} = value.header {
        let mut at = usize.ZERO
        while at < members.length {
          let child = run typeChild(&mut resolver.*, module, members, at)
          if let Option<HirId>.Some {value: memberId} = move child {
            let added = run requireMember(
              &mut resolver.*,
              &mut owner.*,
              &mut dependencies.*,
              moduleOrdinal,
              module,
              memberId,
              binders,
              &mut elision.*,
              &mut row,
            )
            if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
              return Result.failResult<Channels, Shared<Rejection>>(move diagnostic)
            }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  return Result.succeed<Channels, Shared<Rejection>>(
    Channels {failure: move failure, requirements: run Shared.make<Row>(move row)},
  )
}

// Adds one written row member. `never` adds nothing; a bare name may select a `?R` binder.
effect fn requireMember(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  row: &mut Row,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.Requirement {access, capability, rolePath, ..} = value.header {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        capability,
        binders,
        &mut elision.*,
      )
      let capability = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Option.some<Shared<Rejection>>(move error)
        }
      }
      let kind = Shared.with<Type, OwnerKind>(&capability, nominalKind)
      if kind != OwnerKind.Service {
        let mut code = RejectionCode.InvalidRequirement
        // A generic capability needs conformance evidence, which this wave does not solve.
        if Shared.with<Type, bool>(&capability, isTypeParameter) {
          code = RejectionCode.Unsupported
        }
        return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, code, span))
      }
      let mut roleType = Option.none<Shared<Type>>()
      if rolePath.present {
        let selected = run roleDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          rolePath.id,
          binders,
          &mut elision.*,
        )
        match move selected {
          Result<Shared<Type>, Shared<Rejection>>.Success {value: declaration} => {
            roleType = Option.some<Shared<Type>>(move declaration)
          }
          Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
            return Option.some<Shared<Rejection>>(move error)
          }
        }
      }
      run Row.require(
        &mut row.*,
        Requirement {capability: move capability, roleType: move roleType, access: access},
      )
      return Option.none<Shared<Rejection>>()
    }
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      let parsed = run path(&mut resolver.*, module, written)
      let segments = Vector.asSlice<Bytes>(&parsed.segments)
      if !hasMode && parsed.valid && segments.length == usize.ONE {
        let name = Bytes.asSlice(&segments[usize.ZERO])
        if same(name, b"never") {
          return Option.none<Shared<Rejection>>()
        }
        let mut at = usize.ZERO
        while at < binders.length {
          if let Binder.Row {name: spelled, value: parameter, bound} = &binders[at] {
            if same(Bytes.asSlice(&spelled), name) {
              // An applied declaration splices its supplied row in place of the binder.
              if let Option<Shared<Row>>.Some {value: supplied} = &bound {
                run Row.merge(&mut row.*, &supplied)
              } else {
                run Row.include(
                  &mut row.*,
                  RowParameter {
                    declaration: Shared.clone<DeclarationId>(&parameter.declaration),
                    ordinal: parameter.ordinal,
                  },
                )
              }
              return Option.none<Shared<Rejection>>()
            }
          }
          at = at + usize.ONE
        }
      }
    }
    if let Node.RowWithout {..} = value.header {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  return Option.some<Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, span),
  )
}

// Adds one positional requirement-row argument to `row`: `never`, a `?R` binder, a borrowed service
// with an optional `at` role, or a union of those. A value type in a row position is a kind error.
effect fn rowArgument(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  parameterName: &[u8],
  binders: &[Binder],
  elision: &mut LifetimeElision,
  row: &mut Row,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  let written = match move syntax {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => {
      return Option.some<Shared<Rejection>>(
        run reject(
          &resolver.*,
          module,
          RejectionCode.InvalidRequirement,
          Span.make(usize.ZERO, usize.ZERO),
        ),
      )
    }
  }
  if let Node.UnionType {members} = written.header {
    let mut at = usize.ZERO
    while at < members.length {
      let child = run typeChild(&mut resolver.*, module, members, at)
      if let Option<HirId>.Some {value: memberId} = move child {
        let added = run rowArgument(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          memberId,
          parameterName,
          binders,
          &mut elision.*,
          &mut row.*,
        )
        if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
          return Option.some<Shared<Rejection>>(move diagnostic)
        }
      }
      at = at + usize.ONE
    }
    return Option.none<Shared<Rejection>>()
  }
  if let Node.ReferenceType {referent, access, lifetime, roleName} = written.header {
    if lifetime.present {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidRequirement, written.span),
      )
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      referent,
      binders,
      &mut elision.*,
    )
    let capability = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => move ty
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Shared<Rejection>>(move error)
      }
    }
    if Shared.with<Type, OwnerKind>(&capability, nominalKind) != OwnerKind.Service {
      let mut code = RejectionCode.InvalidRequirement
      if Shared.with<Type, bool>(&capability, isTypeParameter) {
        code = RejectionCode.Unsupported
      }
      return Option.some<Shared<Rejection>>(run reject(&resolver.*, module, code, written.span))
    }
    let mut roleType = Option.none<Shared<Type>>()
    if roleName.present {
      let selected = run roleDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        roleName.id,
        binders,
        &mut elision.*,
      )
      match move selected {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: declaration} => {
          roleType = Option.some<Shared<Type>>(move declaration)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Option.some<Shared<Rejection>>(move error)
        }
      }
    }
    run Row.require(
      &mut row.*,
      Requirement {capability: move capability, roleType: move roleType, access: access},
    )
    return Option.none<Shared<Rejection>>()
  }
  if let Node.NamedType {path: named, hasMode, ..} = written.header {
    let parsed = run path(&mut resolver.*, module, named)
    let segments = Vector.asSlice<Bytes>(&parsed.segments)
    if !hasMode && parsed.valid && segments.length == usize.ONE {
      let spelled = Bytes.asSlice(&segments[usize.ZERO])
      let mut rowName = same(spelled, b"never")
      let mut at = usize.ZERO
      while at < binders.length {
        if let Binder.Row {name, ..} = &binders[at] {
          if same(Bytes.asSlice(&name), spelled) {
            rowName = true
          }
        }
        at = at + usize.ONE
      }
      if rowName {
        return run requireMember(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          id,
          binders,
          &mut elision.*,
          &mut row.*,
        )
      }
    }
  }
  if let Node.RowWithout {..} = written.header {
    return Option.some<Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, written.span),
    )
  }
  // A role selector without a borrow names no access, so it cannot be a row entry.
  if let Node.RequirementSelector {..} = written.header {
    return Option.some<Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InvalidRequirement, written.span),
    )
  }
  return Option.some<Shared<Rejection>>(
    run rejectKind(
      &resolver.*,
      module,
      written.span,
      parameterName,
      GenericKind.Requirement,
      GenericKind.Type,
    ),
  )
}

fn executableContract(value: &Type) -> bool {
  return match & value.* {
    Type.Callable {..} => true
    Type.Effect {..} => true
    _ => false
  }
}

fn nominalKind(value: &Type) -> OwnerKind {
  return match & value.* {
    Type.Nominal {declaration, ..} => DeclarationId.kind(&declaration)
    _ => OwnerKind.Damaged
  }
}

fn isTypeParameter(value: &Type) -> bool {
  return match & value.* {
    Type.Parameter {..} => true
    _ => false
  }
}

// Resolves the `at` path of a requirement through ordinary type lookup, keeping its identity demand.
effect fn roleDeclaration(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let parsed = run path(&mut resolver.*, module, id)
  let segments = Vector.asSlice<Bytes>(&parsed.segments)
  let mut resolved = Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, parsed.span),
  )
  if parsed.valid && segments.length == usize.ONE {
    resolved = run namedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&segments[usize.ZERO]),
      false,
      parsed.span,
      Option.none<HirId>(),
      binders,
      &mut elision.*,
    )
  } else if parsed.valid && segments.length == 2 {
    resolved = run qualifiedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      segments,
      parsed.span,
      Option.none<HirId>(),
      binders,
      &mut elision.*,
    )
  }
  let selected = match move resolved {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  if Shared.with<Type, OwnerKind>(&selected, nominalKind) == OwnerKind.Role {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move selected)
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidRequirement, parsed.span),
  )
}

effect fn copyBinder(binder: &Binder) -> Binder ! OutOfMemoryError ? &mut Allocator {
  return match & binder.* {
    Binder.Type {name, value} => Binder.Type {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: Shared.clone<Type>(&value),
    }
    Binder.Lifetime {name, value} => Binder.Lifetime {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: Shared.clone<Lifetime>(&value),
    }
    Binder.Row {name, value, bound} => Binder.Row {
      name: run Bytes.copy(Bytes.asSlice(&name)),
      value: RowParameter {
        declaration: Shared.clone<DeclarationId>(&value.declaration),
        ordinal: value.ordinal,
      },
      bound: copyBound(&bound),
    }
  }
}

// Adds the written `for<...>` binders as invocation lifetimes ahead of the surrounding binders, so
// they shadow a surrounding lifetime of the same name inside the contract.
effect fn quantifiedScope(
  resolver: &mut Resolver,
  module: &ModuleId,
  quantified: Range,
  binders: &[Binder],
  renumber: &Vector<usize>,
) -> Result<Vector<Binder>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut scope = Vector.make<Binder>()
  let mut at = usize.ZERO
  while at < quantified.length {
    let child = run typeChild(&mut resolver.*, module, quantified, at)
    let mut accepted = false
    let mut span = Span.make(usize.ZERO, usize.ZERO)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        span = value.span
        if let Node.LifetimeParameter {name, ..} = value.header {
          let named = run typeNode(&mut resolver.*, module, name)
          if let Option<HeaderSyntax>.Some {value: token} = move named {
            if let Node.Name {text} = token.header {
              let sourceAnswer = run source(&mut resolver.*, module)
              if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
                &resolver.*,
                &sourceAnswer,
                module,
              ) {
                let spelling = run Bytes.copy(Module.text(IndexedSource.authored(indexed), text))
                if same(Bytes.asSlice(&spelling), b"'static") || hasBinder(
                  Vector.asSlice<Binder>(&scope),
                  Bytes.asSlice(&spelling),
                ) {
                  return Result.failResult<Vector<Binder>, Shared<Rejection>>(
                    run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
                  )
                }
                run Vector.append<Binder>(
                  &mut scope,
                  Binder.Lifetime {
                    name: move spelling,
                    value: run Shared.make<Lifetime>(
                      Lifetime.Invocation {ordinal: renumbered(renumber, at)},
                    ),
                  },
                )
                accepted = true
              }
            }
          }
        }
      }
    }
    if !accepted {
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidLifetime, span),
      )
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < binders.length {
    run Vector.append<Binder>(&mut scope, run copyBinder(&binders[at]))
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Binder>, Shared<Rejection>>(move scope)
}

// Records the `'longer: 'shorter` bounds written on `for<...>` binders.
effect fn invocationBounds(
  resolver: &mut Resolver,
  module: &ModuleId,
  quantified: Range,
  scope: &[Binder],
  renumber: &Vector<usize>,
) -> Result<Vector<Outlives>, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut bounds = Vector.make<Outlives>()
  let mut at = usize.ZERO
  while at < quantified.length {
    let child = run typeChild(&mut resolver.*, module, quantified, at)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        if let Node.LifetimeParameter {bounds: written, ..} = value.header {
          let mut boundAt = usize.ZERO
          while boundAt < written.length {
            let bound = run typeChild(&mut resolver.*, module, written, boundAt)
            if let Option<HirId>.Some {value: boundId} = move bound {
              let resolved = run lifetimeAt(&mut resolver.*, module, boundId, scope)
              match move resolved {
                Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: shorter} => {
                  run Vector.append<Outlives>(
                    &mut bounds,
                    Outlives {
                      longer: run Shared.make<Lifetime>(
                        Lifetime.Invocation {ordinal: renumbered(renumber, at)},
                      ),
                      shorter: move shorter,
                    },
                  )
                }
                Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<Vector<Outlives>, Shared<Rejection>>(move error)
                }
              }
            }
            boundAt = boundAt + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Outlives>, Shared<Rejection>>(move bounds)
}

// Resolves `for<'call> once fn<'env>(A) -> B`. Omitted parameter lifetimes are fresh invocation
// binders and an omitted result lifetime uses the sole borrowed parameter; quantified contracts
// do not nest.
struct CallableParts {
  inputs: Vector<Shared<Type>>
  output: Shared<Type>
  outlives: Vector<Outlives>
  allocated: usize
}

// Resolves a callable contract's binder bounds, parameters and result under one numbering of its
// invocation binders.
effect fn callableParts(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: Node,
  binders: &[Binder],
  nested: bool,
  renumber: &Vector<usize>,
) -> Result<CallableParts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut quantified = Range.empty()
  let mut parameters = Range.empty()
  let mut result = HirId {index: usize.ZERO}
  if let Node.CallableType {binders: written, parameters: inputs, result: output, ..} = syntax {
    quantified = written
    parameters = inputs
    result = output
  }
  let scoped = run quantifiedScope(&mut resolver.*, module, quantified, binders, renumber)
  let scope = match move scoped {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CallableParts, Shared<Rejection>>(move error)
    }
  }
  let declaredBounds = run invocationBounds(
    &mut resolver.*,
    module,
    quantified,
    Vector.asSlice<Binder>(&scope),
    renumber,
  )
  let outlives = match move declaredBounds {
    Result<Vector<Outlives>, Shared<Rejection>>.Success {value: found} => move found
    Result<Vector<Outlives>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CallableParts, Shared<Rejection>>(move error)
    }
  }
  let mut copied = Vector.make<usize>()
  let slots = Vector.asSlice<usize>(renumber)
  let mut slot = usize.ZERO
  while slot < slots.length {
    run Vector.append<usize>(&mut copied, slots[slot])
    slot = slot + usize.ONE
  }
  let mut invocation = LifetimeElision {
    owner: Option.none<DeclarationId>(),
    nextOrdinal: quantified.length,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: true,
    nested: nested,
    renumber: move copied,
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let mut inputs = Vector.make<Shared<Type>>()
  let mut borrowed = usize.ZERO
  let mut candidate = Option.none<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < parameters.length {
    let child = run typeChild(&mut resolver.*, module, parameters, at)
    if let Option<HirId>.Some {value: parameterId} = move child {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        parameterId,
        Vector.asSlice<Binder>(&scope),
        &mut invocation,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let outer = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, outerLifetime)
          if let Option<Shared<Lifetime>>.Some {value: lifetime} = move outer {
            borrowed = borrowed + usize.ONE
            candidate = Option.some<Shared<Lifetime>>(move lifetime)
          }
          run Vector.append<Shared<Type>>(&mut inputs, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CallableParts, Shared<Rejection>>(move error)
        }
      }
    }
    at = at + usize.ONE
  }
  invocation.output = true
  if borrowed == usize.ONE {
    invocation.resultDefault = move candidate
  }
  let output = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    result,
    Vector.asSlice<Binder>(&scope),
    &mut invocation,
  )
  return match move output {
    Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => Result.succeed<
      CallableParts,
      Shared<Rejection>,
    >(
      CallableParts {
        inputs: move inputs,
        output: move ty,
        outlives: move outlives,
        allocated: invocation.nextOrdinal,
      },
    )
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result.failResult<
      CallableParts,
      Shared<Rejection>,
    >(move error)
  }
}

fn renumbered(renumber: &Vector<usize>, ordinal: usize) -> usize {
  let slots = Vector.asSlice<usize>(renumber)
  if ordinal < slots.length {
    return slots[ordinal]
  }
  return ordinal
}

effect fn resolveCallable(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  syntax: Node,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.CallableType {mode, isUnsafe, binders: quantified, environment, ..} = syntax {
    if elision.invocation && quantified.length > usize.ZERO {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NestedQuantifier, span),
      )
    }
    let retained = run writtenOrElidedLifetime(
      &mut resolver.*,
      module,
      environment,
      span,
      binders,
      &mut elision.*,
    )
    let mut regions = Vector.make<Shared<Lifetime>>()
    match move retained {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => {
        run Vector.append<Shared<Lifetime>>(&mut regions, move found)
      }
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
    let region = run Shared.make<Intersection>(
      run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions)),
    )
    // The first pass numbers written binders by position and elided ones by allocation. Numbering
    // by first use drops unused binders; equality then compares contracts up to a renaming.
    let provisional = Vector.make<usize>()
    let first = run callableParts(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      syntax,
      binders,
      elision.invocation,
      &provisional,
    )
    let firstParts = match move first {
      Result<CallableParts, Shared<Rejection>>.Success {value} => move value
      Result<CallableParts, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
      }
    }
    // A contract inside another contract's invocation context cannot quantify, so it owns no
    // binders. Its invocation lifetimes belong to the enclosing contract, which numbers them.
    if elision.invocation {
      return Result.succeed<Shared<Type>, Shared<Rejection>>(
        run Shared.make<Type>(
          Type.Callable {
            mode: mode,
            isUnsafe: isUnsafe,
            environment: move region,
            invocationBinders: usize.ZERO,
            invocationBounds: move firstParts.outlives,
            parameters: move firstParts.inputs,
            result: move firstParts.output,
          },
        ),
      )
    }
    let mut order = Vector.make<usize>()
    let inputs = Vector.asSlice<Shared<Type>>(&firstParts.inputs)
    let mut at = usize.ZERO
    while at < inputs.length {
      run Type.collectInvocations(&inputs[at], &mut order)
      at = at + usize.ONE
    }
    run Type.collectInvocations(&firstParts.output, &mut order)
    let bounds = Vector.asSlice<Outlives>(&firstParts.outlives)
    at = usize.ZERO
    while at < bounds.length {
      run Type.collectLifetime(&bounds[at].longer, &mut order)
      run Type.collectLifetime(&bounds[at].shorter, &mut order)
      at = at + usize.ONE
    }
    let used = Vector.asSlice<usize>(&order)
    let mut canonical = used.length == firstParts.allocated
    at = usize.ZERO
    while canonical && at < used.length {
      canonical = used[at] == at
      at = at + usize.ONE
    }
    let mut parts = move firstParts
    if !canonical {
      let mut renumber = Vector.make<usize>()
      at = usize.ZERO
      while at < parts.allocated {
        run Vector.append<usize>(&mut renumber, usize.MAX)
        at = at + usize.ONE
      }
      let slots = Vector.asMutSlice<usize>(&mut renumber)
      at = usize.ZERO
      while at < used.length {
        slots[used[at]] = at
        at = at + usize.ONE
      }
      let second = run callableParts(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        syntax,
        binders,
        elision.invocation,
        &renumber,
      )
      parts = match move second {
        Result<CallableParts, Shared<Rejection>>.Success {value} => move value
        Result<CallableParts, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    return Result.succeed<Shared<Type>, Shared<Rejection>>(
      run Shared.make<Type>(
        Type.Callable {
          mode: mode,
          isUnsafe: isUnsafe,
          environment: move region,
          invocationBinders: Vector.length<usize>(&order),
          invocationBounds: move parts.outlives,
          parameters: move parts.inputs,
          result: move parts.output,
        },
      ),
    )
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
}

effect fn opaqueArguments(
  producer: &DeclarationId,
  binders: &[Binder],
  generated: &[Shared<Lifetime>],
) -> Vector<Argument> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < binders.length {
    match & binders[at] {
      Binder.Type {value, ..} => {
        let ordinal = Shared.with<Type, usize>(
          &value,
          fn(ty: &Type) -> usize {
            return Type.parameterOrdinalOf(ty, producer)
          },
        )
        if ordinal != usize.MAX {
          run Vector.append<Argument>(
            &mut arguments,
            Argument.Type {value: Shared.clone<Type>(&value)},
          )
        }
      }
      Binder.Lifetime {value, ..} => {
        let owned = Shared.with<Lifetime, bool>(
          &value,
          fn(region: &Lifetime) -> bool {
            return match & region.* {
              Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, producer)
              _ => false
            }
          },
        )
        if owned {
          run Vector.append<Argument>(
            &mut arguments,
            Argument.Lifetime {value: Shared.clone<Lifetime>(&value)},
          )
        }
      }
      Binder.Row {value, ..} => {
        let owned = Shared.with<DeclarationId, bool>(
          &value.declaration,
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.equals(declaration, producer)
          },
        )
        if owned {
          let mut row = Row.empty()
          run Row.include(
            &mut row,
            RowParameter {
              declaration: Shared.clone<DeclarationId>(&value.declaration),
              ordinal: value.ordinal,
            },
          )
          run Vector.append<Argument>(
            &mut arguments,
            Argument.Row {value: run Shared.make<Row>(move row)},
          )
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < generated.length {
    run Vector.append<Argument>(
      &mut arguments,
      Argument.Lifetime {value: Shared.clone<Lifetime>(&generated[at])},
    )
    at = at + usize.ONE
  }
  return move arguments
}

effect fn binderSpelling(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Option<Bytes>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(indexed)
    if let Node.Name {text} = Module.node(hir, id) {
      return Option.some<Bytes>(run Bytes.copy(Module.text(hir, text)))
    }
  }
  return Option.none<Bytes>()
}

effect fn opaqueProducerHasBody(
  resolver: &mut Resolver,
  module: &ModuleId,
  producer: &DeclarationId,
) -> bool ! Cycle | OutOfMemoryError ? &mut Allocator {
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(producer))
  let found = run ordinalOfIdentity(&mut resolver.*, module, &identity)
  if let Option<usize>.Some {value: ordinal} = move found {
    let answer = run source(&mut resolver.*, module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &answer,
      module,
    ) {
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      if ordinal < declarations.length {
        let hir = IndexedSource.authored(indexed)
        if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
          if let Node.CallableBody {block} = Module.node(hir, body) {
            return block.present
          }
        }
      }
    }
  }
  return false
}

effect fn resolveOpaqueResult(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  parameters: Range,
  result: HirId,
  span: Span,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let producer = match & elision.owner {
    Option<DeclarationId>.Some {value} => run DeclarationId.copy(&value)
    Option<DeclarationId>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
      )
    }
  }
  let callable = match DeclarationId.kind(&producer) {
    OwnerKind.Function => true
    _ => false
  }
  if !elision.output || !callable || parameters.length != usize.ONE || !run opaqueProducerHasBody(
    &mut resolver.*,
    module,
    &producer,
  ) {
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
    )
  }
  let binderId = run typeChild(&mut resolver.*, module, parameters, usize.ZERO)
  if let Option<HirId>.Some {value: parameter} = move binderId {
    let syntax = run typeNode(&mut resolver.*, module, parameter)
    if let Option<HeaderSyntax>.Some {value: written} = move syntax {
      if let Node.TypeParameter {name, bounds} = written.header {
        let spelled = run binderSpelling(&mut resolver.*, module, name)
        if let Option<Bytes>.Some {value: binderName} = move spelled {
          if hasBinder(binders, Bytes.asSlice(&binderName)) {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
            )
          }
          let mut contract = Option.none<Shared<Type>>()
          let mut detached = false
          let mut nonParking = false
          let mut at = usize.ZERO
          while at < bounds.length {
            let bound = run typeChild(&mut resolver.*, module, bounds, at)
            if let Option<HirId>.Some {value: boundId} = move bound {
              let property = run intrinsicBound(&mut resolver.*, module, boundId)
              if property.named {
                match move property.property {
                  Option<IntrinsicProperty>.Some {value: foundProperty} => match foundProperty {
                    IntrinsicProperty.Detached => {
                      if detached {
                        return Result.failResult<Shared<Type>, Shared<Rejection>>(
                          run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
                        )
                      }
                      detached = true
                    }
                    IntrinsicProperty.NonParking => {
                      if nonParking {
                        return Result.failResult<Shared<Type>, Shared<Rejection>>(
                          run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
                        )
                      }
                      nonParking = true
                    }
                  }
                  Option<IntrinsicProperty>.None => {
                    return Result.failResult<Shared<Type>, Shared<Rejection>>(
                      run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
                    )
                  }
                }
              } else {
                if let Option<Shared<Type>>.Some {value: prior} = &contract {
                  return Result.failResult<Shared<Type>, Shared<Rejection>>(
                    run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
                  )
                }
                let resolved = run resolveType(
                  &mut resolver.*,
                  &mut owner.*,
                  &mut dependencies.*,
                  moduleOrdinal,
                  boundId,
                  binders,
                  &mut elision.*,
                )
                let selected = match move resolved {
                  Result<Shared<Type>, Shared<Rejection>>.Success {value: selected} => move selected
                  Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                    return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
                  }
                }
                let executable = Shared.with<Type, bool>(
                  &selected,
                  fn(ty: &Type) -> bool {
                    return match & ty.* {
                      Type.Callable {..} => true
                      Type.Effect {..} => true
                      _ => false
                    }
                  },
                )
                if !executable {
                  return Result.failResult<Shared<Type>, Shared<Rejection>>(
                    run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
                  )
                }
                contract = Option.some<Shared<Type>>(move selected)
              }
            }
            at = at + usize.ONE
          }
          if let Option<Shared<Type>>.Some {value: useContract} = move contract {
            let application = run opaqueArguments(
              &producer,
              binders,
              Vector.asSlice<Shared<Lifetime>>(&elision.generated),
            )
            let opaque = run Shared.make<Type>(
              Type.OpaqueRepresentation {
                producer: run DeclarationId.copy(&producer),
                arguments: move application,
                contract: move useContract,
                detached: detached,
                nonParking: nonParking,
              },
            )
            let mut scoped = Vector.make<Binder>()
            at = usize.ZERO
            while at < binders.length {
              run Vector.append<Binder>(&mut scoped, run copyBinder(&binders[at]))
              at = at + usize.ONE
            }
            run Vector.append<Binder>(
              &mut scoped,
              Binder.Type {name: move binderName, value: Shared.clone<Type>(&opaque)},
            )
            let resolved = run resolveType(
              &mut resolver.*,
              &mut owner.*,
              &mut dependencies.*,
              moduleOrdinal,
              result,
              Vector.asSlice<Binder>(&scoped),
              &mut elision.*,
            )
            let complete = match move resolved {
              Result<Shared<Type>, Shared<Rejection>>.Success {value: completed} => move completed
              Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
              }
            }
            if run Type.containsOpaque(&complete, &producer) {
              return Result.succeed<Shared<Type>, Shared<Rejection>>(move complete)
            }
          }
        }
      }
    }
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidOpaqueResult, span),
  )
}

effect fn resolveType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  id: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let syntax = run typeNode(&mut resolver.*, &module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    let mut selected = value.header
    let mut application = Option.none<HirId>()
    if let Node.AppliedType {target, arguments} = selected {
      let writtenTarget = run typeNode(&mut resolver.*, &module, target)
      if let Option<HeaderSyntax>.Some {value: named} = move writtenTarget {
        selected = named.header
        application = Option.some<HirId>(arguments)
      }
    }
    if let Node.UnitType {} = selected {
      if let Option<HirId>.Some {value: arguments} = move application {
        let written = run typeNode(&mut resolver.*, &module, arguments)
        if let Option<HeaderSyntax>.Some {value: found} = move written {
          if let Node.TypeArguments {arguments: supplied, ..} = found.header {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
            )
          }
        }
      }
      return Result.succeed<Shared<Type>, Shared<Rejection>>(run Shared.make<Type>(Type.Unit))
    }
    if let Node.ExactRepresentationType {subject} = selected {
      return run resolveNamedRepresentation(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        subject,
        value.span,
        binders,
      )
    }
    if let Node.OpaqueResultType {binders: opaqueBinders, result} = selected {
      return run resolveOpaqueResult(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        opaqueBinders,
        result,
        value.span,
        binders,
        &mut elision.*,
      )
    }
    if let Node.NamedType {path: typeName, hasMode, mode} = selected {
      let parsed = run path(&mut resolver.*, &module, typeName)
      if !parsed.valid {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      let segments = Vector.asSlice<Bytes>(&parsed.segments)
      // The builtin `Effect<A ! E ? R>` needs no import; only a binder can shadow its spelling.
      if segments.length == usize.ONE && same(Bytes.asSlice(&segments[usize.ZERO]), b"Effect") && !hasBinder(
        binders,
        b"Effect",
      ) {
        let mut access = CallableMode.Shared
        if hasMode {
          access = mode
        }
        return run resolveEffect(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          value.span,
          move application,
          access,
          binders,
          &mut elision.*,
        )
      }
      if hasMode {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      if segments.length == usize.ONE {
        let name = Bytes.asSlice(&segments[usize.ZERO])
        let known = binders
        let mut at = usize.ZERO
        while at < known.length {
          if let Binder.Row {name: bound, ..} = &known[at] {
            if same(Bytes.asSlice(&bound), name) {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(
                run rejectKind(
                  &resolver.*,
                  &module,
                  parsed.span,
                  name,
                  GenericKind.Type,
                  GenericKind.Requirement,
                ),
              )
            }
          }
          if let Binder.Type {name: bound, value: ty} = &known[at] {
            if same(Bytes.asSlice(&bound), name) {
              if let Option<HirId>.Some {value: arguments} = move application {
                let written = run typeNode(&mut resolver.*, &module, arguments)
                if let Option<HeaderSyntax>.Some {value: found} = move written {
                  if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                    return Result.failResult<Shared<Type>, Shared<Rejection>>(
                      run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
                    )
                  }
                }
              }
              return Result.succeed<Shared<Type>, Shared<Rejection>>(Shared.clone<Type>(&ty))
            }
          }
          at = at + usize.ONE
        }
        if same(name, b"string") {
          let mut writtenLifetime = HirRef.absent()
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = found.header {
                if environment.present || failures.present || requirements.present || supplied.length != usize.ONE {
                  return Result.failResult<Shared<Type>, Shared<Rejection>>(
                    run rejectArity(&resolver.*, &module, found.span, usize.ONE, supplied.length),
                  )
                }
                let child = run typeChild(&mut resolver.*, &module, supplied, usize.ZERO)
                if let Option<HirId>.Some {value: lifetimeId} = move child {
                  writtenLifetime = HirRef.of(lifetimeId)
                }
              }
            }
          }
          let lifetime = run writtenOrElidedLifetime(
            &mut resolver.*,
            &module,
            writtenLifetime,
            value.span,
            binders,
            &mut elision.*,
          )
          match move lifetime {
            Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: valid} => {
              return Result.succeed<Shared<Type>, Shared<Rejection>>(
                run Shared.make<Type>(Type.String {lifetime: move valid}),
              )
            }
            Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
            }
          }
        }
        if primitive(name) {
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                return Result.failResult<Shared<Type>, Shared<Rejection>>(
                  run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
                )
              }
            }
          }
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)}),
          )
        }
        if same(name, b"never") {
          if let Option<HirId>.Some {value: arguments} = move application {
            let written = run typeNode(&mut resolver.*, &module, arguments)
            if let Option<HeaderSyntax>.Some {value: found} = move written {
              if let Node.TypeArguments {arguments: supplied, ..} = found.header {
                return Result.failResult<Shared<Type>, Shared<Rejection>>(
                  run rejectArity(&resolver.*, &module, found.span, usize.ZERO, supplied.length),
                )
              }
            }
          }
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()}),
          )
        }
        return run namedType(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          name,
          false,
          parsed.span,
          move application,
          binders,
          &mut elision.*,
        )
      }
      if segments.length == 2 {
        return run qualifiedType(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          &module,
          segments,
          parsed.span,
          move application,
          binders,
          &mut elision.*,
        )
      }
    }
    if let Node.ReferenceType {referent, access, lifetime, roleName} = selected {
      if roleName.present {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        )
      }
      let valid = run writtenOrElidedLifetime(
        &mut resolver.*,
        &module,
        lifetime,
        value.span,
        binders,
        &mut elision.*,
      )
      let region = match move valid {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        referent,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Reference {referent: move ty, access: access, lifetime: move region},
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    if let Node.SliceType {element, access, lifetime} = selected {
      let valid = run writtenOrElidedLifetime(
        &mut resolver.*,
        &module,
        lifetime,
        value.span,
        binders,
        &mut elision.*,
      )
      let region = match move valid {
        Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: found} => move found
        Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        element,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Slice {element: move ty, access: access, lifetime: move region},
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    if let Node.PointerType {pointee, access, nullable, multiplicity, qualifiers} = selected {
      let validated = run pointerAlignment(&mut resolver.*, &module, qualifiers)
      let alignment = match move validated {
        Result<Option<u64>, Shared<Rejection>>.Success {value: found} => move found
        Result<Option<u64>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        pointee,
        binders,
        &mut elision.*,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.Pointer {
                pointee: move ty,
                access: access,
                nullable: nullable,
                multiplicity: multiplicity,
                alignment: move alignment,
              },
            ),
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
        }
      }
    }
    if let Node.FixedArrayType {element, length} = selected {
      let lengthSyntax = run typeNode(&mut resolver.*, &module, length)
      if let Option<HeaderSyntax>.Some {value: writtenLength} = move lengthSyntax {
        let evaluated = run staticExpression(
          &mut resolver.*, &mut owner.*, &mut dependencies.*,
          &module, Option.none<usize>(), length, StaticRootExpectation.IntegerExtent,
        )
        let selectedExtent = match move evaluated {
          Result<Shared<StaticData>, Shared<Rejection>>.Success {value: staticValue} => run StaticConstant.extent(&staticValue, resolver.target.pointerBits())
          Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
          }
        }
        if let Option<Bytes>.Some {value: extent} = move selectedExtent {
          let resolved = run resolveType(
            &mut resolver.*, &mut owner.*, &mut dependencies.*,
            moduleOrdinal, element, binders, &mut elision.*,
          )
          return match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => Result.succeed<
              Shared<Type>, Shared<Rejection>,
            >(run Shared.make<Type>(Type.Array {element: move ty, extent: move extent}))
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => Result.failResult<
              Shared<Type>, Shared<Rejection>,
            >(move error)
          }
        }
        let mut anchor = writtenLength.span
        if anchor.end <= anchor.start {
          anchor = value.span
        }
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.InvalidConstant, anchor),
        )
      }
    }
    if let Node.UnionType {members} = selected {
      return run resolveUnion(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        members,
        binders,
        &mut elision.*,
      )
    }
    if let Node.CallableType {..} = selected {
      return run resolveCallable(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        &module,
        selected,
        value.span,
        binders,
        &mut elision.*,
      )
    }
    if let Node.Lifetime {..} = selected {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, &module, RejectionCode.InvalidLifetime, value.span),
      )
    }
    return Result.failResult<Shared<Type>, Shared<Rejection>>(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
    )
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
  )
}

effect fn resolveAlias(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.AliasHeader {target, isPublic, ..} = value.header {
      let template = run templateBinders(&mut resolver.*, &module, key.declaration)
      let binders = match move template {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
      let contractAnswer = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        Key {
          family: Family.Contract,
          module: key.module,
          name: usize.ZERO,
          declaration: key.declaration,
          member: usize.ZERO,
          external: false,
        },
        value.span,
      )
      let contractFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &contractAnswer,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move contractFailure {
        return memberRejected(move diagnostic, move dependencies)
      }
      let mut assumptions = Vector.make<Constraint>()
      let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(
        &contractAnswer,
        contractConstraintCount,
      )
      let mut boundAt = usize.ZERO
      while boundAt < boundCount {
        let found = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
          &contractAnswer,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
            return contractConstraintAt(answer, boundAt)
          },
        )
        if let Option<Constraint>.Some {value: bound} = move found {
          run Vector.append<Constraint>(&mut assumptions, move bound)
        }
        boundAt = boundAt + usize.ONE
      }
      let mut elision = LifetimeElision {
        owner: run declarationAt(&mut resolver.*, &module, key.declaration),
        nextOrdinal: Vector.length<Binder>(&binders),
        output: false,
        resultDefault: Option.none<Shared<Lifetime>>(),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
        supplied: Option.none<Vector<Argument>>(),
        assumptions: Option.some<Vector<Constraint>>(move assumptions),
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        target,
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let exposure = run exposedPrivate(&mut resolver.*, &module, target, &ty, isPublic)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          return Answer {
            outcome: Outcome.Success {value: Value.Type {resolved: move ty}},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: Outcome.Rejected {diagnostic: move diagnostic},
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn resolveIdentity(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let allowed = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.EnumHeader {..} => true
      Node.UnionHeader {..} => true
      Node.ServiceHeader {..} => true
      Node.InterfaceHeader {..} => true
      Node.RoleHeader {..} => true
      _ => false
    }
    let isPublic = match value.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.RoleHeader {isPublic, ..} => isPublic
      _ => false
    }
    if allowed {
      let found = run declarationAt(&mut resolver.*, &module, key.declaration)
      if let Option<DeclarationId>.Some {value: id} = move found {
        return Answer {
          outcome: Outcome.Success {
            value: Value.Type {
              resolved: run Shared.make<Type>(
                Type.Nominal {
                  declaration: move id,
                  isPublic: isPublic,
                  arguments: Vector.make<Argument>(),
                },
              ),
            },
          },
          dependencies: Vector.make<Dependency>(),
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
    }
    let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
    return Answer {
      outcome: Outcome.Rejected {diagnostic: move diagnostic},
      dependencies: Vector.make<Dependency>(),
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: Vector.make<Dependency>(),
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn memberSuccess(value: Value, dependencies: Vector<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Success {value: move value},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn memberRejected(diagnostic: Shared<Rejection>, dependencies: Vector<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

effect fn writtenMember(hir: &Module, id: HirId, kind: MemberKind) -> Option<Member>
! OutOfMemoryError
? &mut Allocator {
  if kind == MemberKind.Position {
    return Option.some<Member>(
      Member {
        name: Option.none<Bytes>(),
        isPublic: true,
        kind: kind,
        discriminant: Option.none<EnumCase>(),
      },
    )
  }
  let node = Module.node(hir, id)
  let mut name = HirId {index: usize.ZERO}
  let mut isPublic = true
  if let Node.Field {name: field, isPublic: visible, ..} = node {
    name = field
    isPublic = visible
  } else if let Node.EnumMember {name: member, ..} = node {
    name = member
  } else if let Node.Variant {name: variant, ..} = node {
    name = variant
  } else {
    return Option.none<Member>()
  }
  if let Node.Name {text} = Module.node(hir, name) {
    return Option.some<Member>(
      Member {
        name: Option.some<Bytes>(run Bytes.copy(Module.text(hir, text))),
        isPublic: isPublic,
        kind: kind,
        discriminant: Option.none<EnumCase>(),
      },
    )
  }
  return Option.none<Member>()
}

fn memberSameName(left: &Member, right: &Member) -> bool {
  return match & left.name {
    Option<Bytes>.Some {value: first} => match & right.name {
      Option<Bytes>.Some {value: second} => same(Bytes.asSlice(&first), Bytes.asSlice(&second))
      Option<Bytes>.None => false
    }
    Option<Bytes>.None => false
  }
}

fn enumRepresentation(hir: &Module, id: HirId) -> Option<StaticIntegerType> {
  if let Node.NamedType {path: written, hasMode, ..} = Module.node(hir, id) {
    if hasMode {
      return Option.none<StaticIntegerType>()
    }
    if let Node.Path {segments} = Module.node(hir, written) {
      if segments.length == usize.ONE {
        let nameNode = Module.child(hir, segments, usize.ZERO)
        if let Node.Name {text} = Module.node(hir, nameNode) {
          let name = Module.text(hir, text)
          if same(name, b"u8") {
            return Option.some<StaticIntegerType>(StaticIntegerType.U8)
          }
          if same(name, b"u16") {
            return Option.some<StaticIntegerType>(StaticIntegerType.U16)
          }
          if same(name, b"u32") {
            return Option.some<StaticIntegerType>(StaticIntegerType.U32)
          }
          if same(name, b"u64") {
            return Option.some<StaticIntegerType>(StaticIntegerType.U64)
          }
          if same(name, b"i8") {
            return Option.some<StaticIntegerType>(StaticIntegerType.I8)
          }
          if same(name, b"i16") {
            return Option.some<StaticIntegerType>(StaticIntegerType.I16)
          }
          if same(name, b"i32") {
            return Option.some<StaticIntegerType>(StaticIntegerType.I32)
          }
          if same(name, b"i64") {
            return Option.some<StaticIntegerType>(StaticIntegerType.I64)
          }
        }
      }
    }
  }
  return Option.none<StaticIntegerType>()
}

fn enumMemberAnchor(hir: &Module, id: HirId, discriminant: bool) -> Span {
  if let Node.EnumMember {name, value} = Module.node(hir, id) {
    if discriminant && value.present {
      return Module.span(hir, value.id)
    }
    return Module.span(hir, name)
  }
  return Module.span(hir, id)
}

fn enumRejection(reason: EnumReason) -> RejectionCode {
  return match reason {
    EnumReason.Empty => RejectionCode.EmptyEnum
    EnumReason.Representation => RejectionCode.InvalidEnumRepresentation
    EnumReason.DuplicateName => RejectionCode.DuplicateEnumMember
    EnumReason.DuplicateDiscriminant => RejectionCode.DuplicateEnumDiscriminant
    EnumReason.ExplicitOutOfRange => RejectionCode.EnumDiscriminantOutOfRange
    EnumReason.ImplicitOverflow => RejectionCode.EnumImplicitOverflow
    EnumReason.NegativeUnsigned => RejectionCode.UnsignedEnumNegative
    EnumReason.InvalidLiteral => RejectionCode.EnumDiscriminantOutOfRange
  }
}

effect fn resolveMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let identityKey = Key {
      family: Family.Identity,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    }
    let identity = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      identityKey,
      value.span,
    )
    let selected = run typeFromAnswer(&identity)
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move selected.rejected {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut range = Range.empty()
    let mut kind = MemberKind.Field
    if let Node.StructHeader {fields, ..} = value.header {
      range = fields
    } else if let Node.TupleHeader {elements, ..} = value.header {
      range = elements
      kind = MemberKind.Position
    } else if let Node.EnumHeader {members, ..} = value.header {
      range = members
      kind = MemberKind.EnumCase
    } else if let Node.UnionHeader {variants, ..} = value.header {
      range = variants
      kind = MemberKind.Variant
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    let sourceAnswer = run source(&mut resolver.*, &module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let mut members = Vector.make<Member>()
      let mut enumInputs = Vector.make<EnumInput>()
      let mut enumType = StaticIntegerType.U8
      if let Node.EnumHeader {representation, ..} = value.header {
        if representation.present {
          let enumSelection = enumRepresentation(hir, representation.id)
          enumType = match move enumSelection {
            Option<StaticIntegerType>.Some {value: enumChosen} => enumChosen
            Option<StaticIntegerType>.None => {
              return memberRejected(
                run reject(
                  &resolver.*,
                  &module,
                  RejectionCode.InvalidEnumRepresentation,
                  Module.span(hir, representation.id),
                ),
                move dependencies,
              )
            }
          }
        }
      }
      let mut at = usize.ZERO
      while at < range.length {
        let child = Module.child(hir, range, at)
        let candidate = run writtenMember(hir, child, kind)
        if let Option<Member>.Some {value: member} = move candidate {
          if kind == MemberKind.EnumCase {
            let name = match & member.name {
              Option<Bytes>.Some {value: writtenName} => run Bytes.copy(Bytes.asSlice(&writtenName))
              Option<Bytes>.None => {
                return memberRejected(
                  run reject(
                    &resolver.*,
                    &module,
                    RejectionCode.Unsupported,
                    Module.span(hir, child),
                  ),
                  move dependencies,
                )
              }
            }
            let mut explicit = Option.none<EnumLiteral>()
            if let Node.EnumMember {value: discriminant, ..} = Module.node(hir, child) {
              if discriminant.present {
                if let Node.IntegerLiteral {sign, magnitude, radix, suffix} = Module.node(
                  hir,
                  discriminant.id,
                ) {
                  if radix != Radix.Decimal || suffix.present {
                    return memberRejected(
                      run reject(
                        &resolver.*,
                        &module,
                        RejectionCode.EnumDiscriminantOutOfRange,
                        Module.span(hir, discriminant.id),
                      ),
                      move dependencies,
                    )
                  }
                  let mut enumSign = StaticSign.Positive
                  if sign == Sign.Negative {
                    enumSign = StaticSign.Negative
                  }
                  explicit = Option.some<EnumLiteral>(
                    EnumLiteral {
                      sign: enumSign,
                      digits: run Bytes.copy(Module.text(hir, magnitude)),
                    },
                  )
                } else {
                  return memberRejected(
                    run reject(
                      &resolver.*,
                      &module,
                      RejectionCode.EnumDiscriminantOutOfRange,
                      Module.span(hir, discriminant.id),
                    ),
                    move dependencies,
                  )
                }
              }
            }
            run Vector.append<EnumInput>(
              &mut enumInputs,
              EnumInput {name: move name, explicit: move explicit},
            )
          } else {
            let prior = Vector.asSlice<Member>(&members)
            let mut before = usize.ZERO
            while before < prior.length {
              if memberSameName(&prior[before], &member) {
                return memberRejected(
                  run reject(&resolver.*, &module, RejectionCode.Collision, Module.span(hir, child)),
                  move dependencies,
                )
              }
              before = before + usize.ONE
            }
          }
          run Vector.append<Member>(&mut members, move member)
        } else {
          return memberRejected(
            run reject(&resolver.*, &module, RejectionCode.Unsupported, Module.span(hir, child)),
            move dependencies,
          )
        }
        at = at + usize.ONE
      }
      if kind == MemberKind.EnumCase {
        let checked = run ScalarEnum.validate(Vector.asSlice<EnumInput>(&enumInputs), enumType)
        match move checked {
          Result<Vector<EnumCase>, EnumFailure>.Success {value: cases} => {
            let values = Vector.asSlice<EnumCase>(&cases)
            let mut output = Vector.asMutSlice<Member>(&mut members)
            let mut index = usize.ZERO
            while index < values.length {
              output[index].discriminant = Option.some<EnumCase>(
                EnumCase {sign: values[index].sign, magnitude: values[index].magnitude},
              )
              index = index + usize.ONE
            }
          }
          Result<Vector<EnumCase>, EnumFailure>.Failure {error} => {
            let mut span = value.span
            let mut related = Option.none<Span>()
            if error.reason != EnumReason.Empty {
              let child = Module.child(hir, range, error.ordinal)
              let onValue = error.reason == EnumReason.DuplicateDiscriminant || error.reason == EnumReason.ExplicitOutOfRange || error.reason == EnumReason.NegativeUnsigned
              span = enumMemberAnchor(hir, child, onValue)
              if let Option<usize>.Some {value: previous} = &error.previous {
                let earlier = Module.child(hir, range, previous)
                related = Option.some<Span>(enumMemberAnchor(hir, earlier, onValue))
              }
            }
            return memberRejected(
              run rejectWithRelated(
                &resolver.*,
                &module,
                enumRejection(error.reason),
                span,
                move related,
              ),
              move dependencies,
            )
          }
        }
      }
      let declaration = match move run declarationAt(&mut resolver.*, &module, key.declaration) {
        Option<DeclarationId>.Some {value: found} => run Shared.make<DeclarationId>(move found)
        Option<DeclarationId>.None => { return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        ) }
      }
      return memberSuccess(Value.Members {identity: move declaration, members: move members, enumRepresentation: enumType}, move dependencies)
    }
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
      move dependencies,
    )
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

fn binderKind(binder: &Binder) -> GenericKind {
  return match & binder.* {
    Binder.Type {..} => GenericKind.Type
    Binder.Lifetime {..} => GenericKind.Lifetime
    Binder.Row {..} => GenericKind.Requirement
  }
}

fn argumentKind(argument: &Argument) -> GenericKind {
  return match & argument.* {
    Argument.Type {..} => GenericKind.Type
    Argument.Lifetime {..} => GenericKind.Lifetime
    Argument.Row {..} => GenericKind.Requirement
  }
}

effect fn resolveMemberShape(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let namesKey = Key {
      family: Family.Members,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    }
    let names = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      namesKey,
      value.span,
    )
    let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &names,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut range = Range.empty()
    let mut kind = MemberKind.Field
    if let Node.StructHeader {fields, ..} = value.header {
      range = fields
    } else if let Node.TupleHeader {elements, ..} = value.header {
      range = elements
      kind = MemberKind.Position
    } else if let Node.EnumHeader {members, ..} = value.header {
      range = members
      kind = MemberKind.EnumCase
    } else if let Node.UnionHeader {variants, ..} = value.header {
      range = variants
      kind = MemberKind.Variant
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    if key.member >= range.length {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, value.span),
        move dependencies,
      )
    }
    let found = run declarationAt(&mut resolver.*, &module, key.declaration)
    let applications = Vector.asSlice<Shared<Type>>(&resolver.applications)
    let application = Shared.clone<Type>(&applications[key.name])
    if let Option<DeclarationId>.Some {value: declaration} = move found {
      if !Shared.with<Type, bool>(
        &application,
        fn(ty: &Type) -> bool {
          return applicationMatches(ty, &declaration)
        },
      ) {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        )
      }
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
        move dependencies,
      )
    }
    let template = run templateBinders(&mut resolver.*, &module, key.declaration)
    let mut binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: resolvedBinders} => move resolvedBinders
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let incomplete = run completeAggregateBinders(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      key.declaration,
      value.span,
      &mut binders,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move incomplete {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut arguments = Vector.make<Argument>()
    let count = Shared.with<Type, usize>(&application, applicationLength)
    if count != Vector.length<Binder>(&binders) {
      return memberRejected(
        run rejectArity(&resolver.*, &module, value.span, Vector.length<Binder>(&binders), count),
        move dependencies,
      )
    }
    let mut at = usize.ZERO
    while at < count {
      let supplied = Shared.with<Type, Option<Argument>>(
        &application,
        fn(ty: &Type) -> Option<Argument> {
          return applicationArgument(ty, at)
        },
      )
      if let Option<Argument>.Some {value: argument} = move supplied {
        run Vector.append<Argument>(&mut arguments, move argument)
      }
      at = at + usize.ONE
    }
    let parameters = Vector.asSlice<Binder>(&binders)
    let supplied = Vector.asSlice<Argument>(&arguments)
    let mut argumentAt = usize.ZERO
    while argumentAt < count {
      let expectedKind = binderKind(&parameters[argumentAt])
      let suppliedKind = argumentKind(&supplied[argumentAt])
      if expectedKind != suppliedKind {
        return memberRejected(
          run rejectKind(
            &resolver.*,
            &module,
            value.span,
            binderName(&parameters[argumentAt]),
            expectedKind,
            suppliedKind,
          ),
          move dependencies,
        )
      }
      argumentAt = argumentAt + usize.ONE
    }
    let applied = run bindArguments(
      Vector.asSlice<Binder>(&binders),
      Vector.asSlice<Argument>(&arguments),
    )
    let mut annotations = Vector.make<HirId>()
    let sourceAnswer = run source(&mut resolver.*, &module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let member = Module.child(hir, range, key.member)
      if kind == MemberKind.Position {
        run Vector.append<HirId>(&mut annotations, member)
      } else if kind == MemberKind.Field {
        if let Node.Field {annotation, ..} = Module.node(hir, member) {
          run Vector.append<HirId>(&mut annotations, annotation)
        }
      } else if kind == MemberKind.Variant {
        if let Node.Variant {fields, ..} = Module.node(hir, member) {
          let mut fieldAt = usize.ZERO
          while fieldAt < fields.length {
            let field = Module.child(hir, fields, fieldAt)
            if let Node.Field {annotation, ..} = Module.node(hir, field) {
              run Vector.append<HirId>(&mut annotations, annotation)
            } else {
              return memberRejected(
                run reject(&resolver.*, &module, RejectionCode.Unsupported, Module.span(hir, field)),
                move dependencies,
              )
            }
            fieldAt = fieldAt + usize.ONE
          }
        }
      }
    } else {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    drop sourceAnswer
    let mut elision = LifetimeElision {
      owner: run declarationAt(&mut resolver.*, &module, key.declaration),
      nextOrdinal: Vector.length<Binder>(&binders),
      output: false,
      resultDefault: Option.none<Shared<Lifetime>>(),
      generated: Vector.make<Shared<Lifetime>>(),
      invocation: false,
      nested: false,
      renumber: Vector.make<usize>(),
      staticEnvironment: false,
      supplied: Option.none<Vector<Argument>>(),
      assumptions: Option.none<Vector<Constraint>>(),
    }
    let mut types = Vector.make<Shared<Type>>()
    let writtenTypes = Vector.asSlice<HirId>(&annotations)
    let mut typeAt = usize.ZERO
    while typeAt < writtenTypes.length {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        writtenTypes[typeAt],
        Vector.asSlice<Binder>(&applied),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let existential = run existentialRejection(
            &mut resolver.*,
            &module,
            writtenTypes[typeAt],
            &ty,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
            return memberRejected(move diagnostic, move dependencies)
          }
          run Vector.append<Shared<Type>>(&mut types, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
      typeAt = typeAt + usize.ONE
    }
    let generatedCount = Vector.length<Shared<Lifetime>>(&elision.generated)
    if generatedCount > usize.ZERO {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
        move dependencies,
      )
    }
    return memberSuccess(Value.MemberShape {types: move types}, move dependencies)
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// Records one written bound. It checks that the contract is an interface or service application;
// whether any provider conforms is a later question.
effect fn declareBound(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  binder: &Binder,
  boundId: HirId,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  isPublic: bool,
  constraints: &mut Vector<Constraint>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, boundId)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut isLifetime = false
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.Lifetime {..} = value.header {
      isLifetime = true
    }
  }
  if isLifetime {
    let resolved = run lifetimeAt(&mut resolver.*, module, boundId, binders)
    let region = match move resolved {
      Result<Shared<Lifetime>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Shared<Rejection>>(move error)
      }
    }
    if let Binder.Type {value: subject, ..} = &binder.* {
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Contents {subject: Shared.clone<Type>(&subject), region: move region},
      )
      return Option.none<Shared<Rejection>>()
    }
    if let Binder.Lifetime {value: longer, ..} = &binder.* {
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Outlives {longer: Shared.clone<Lifetime>(&longer), shorter: move region},
      )
      return Option.none<Shared<Rejection>>()
    }
  }
  if let Binder.Type {value: provider, ..} = &binder.* {
    let intrinsic = run intrinsicBound(&mut resolver.*, module, boundId)
    if intrinsic.named {
      // No other Intrinsic family is implemented as a bound yet; it stays an explicit boundary.
      let found = match move intrinsic.property {
        Option<IntrinsicProperty>.Some {value} => value
        Option<IntrinsicProperty>.None => {
          return Option.some<Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
      }
      let prior = Vector.asSlice<Constraint>(&constraints.*)
      let mut at = usize.ZERO
      while at < prior.length {
        if let Constraint.Property {subject, property} = &prior[at] {
          if property == found && run Type.equalsShared(&subject, &provider) {
            return Option.some<Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),
            )
          }
        }
        at = at + usize.ONE
      }
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Property {subject: Shared.clone<Type>(&provider), property: found},
      )
      return Option.none<Shared<Rejection>>()
    }
    let sealed = run sealedProperty(&mut resolver.*, module, boundId, binders)
    if let Option<SealedProperty>.Some {value: property} = move sealed {
      // Only Copy is a bound; Drop is requested by an `impl`, never required of a parameter.
      let copyable = match property {
        SealedProperty.Copy => true
        SealedProperty.Drop => false
      }
      if !copyable {
        return Option.some<Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
        )
      }
      let prior = Vector.asSlice<Constraint>(&constraints.*)
      let mut at = usize.ZERO
      while at < prior.length {
        if let Constraint.Copyable {subject} = &prior[at] {
          if run Type.equalsShared(&subject, &provider) {
            return Option.some<Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),
            )
          }
        }
        at = at + usize.ONE
      }
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Copyable {subject: Shared.clone<Type>(&provider)},
      )
      return Option.none<Shared<Rejection>>()
    }
    let resolved = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      boundId,
      binders,
      &mut elision.*,
    )
    let contract = match move resolved {
      Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
        return Option.some<Shared<Rejection>>(move error)
      }
    }
    let exposure = run exposedPrivate(&mut resolver.*, module, boundId, &contract, isPublic)
    if let Option<Shared<Rejection>>.Some {value} = move exposure {
      return Option.some<Shared<Rejection>>(move value)
    }
    // A callable or Effect contract makes the parameter a representation parameter.
    if Shared.with<Type, bool>(&contract, executableContract) {
      run Vector.append<Constraint>(
        &mut constraints.*,
        Constraint.Represents {parameter: Shared.clone<Type>(&provider), contract: move contract},
      )
      return Option.none<Shared<Rejection>>()
    }
    // A service is an interface with dependency eligibility; both are valid static bounds.
    let kind = Shared.with<Type, OwnerKind>(&contract, nominalKind)
    if kind != OwnerKind.Interface && kind != OwnerKind.Service {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
      )
    }
    let prior = Vector.asSlice<Constraint>(&constraints.*)
    let mut at = usize.ZERO
    while at < prior.length {
      if let Constraint.Conforms {provider: earlier, contract: applied} = &prior[at] {
        let sameProvider = run Type.equalsShared(&earlier, &provider)
        let sameContract = run Type.equalsShared(&applied, &contract)
        if sameProvider && sameContract {
          return Option.some<Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.DuplicateBound, span),
          )
        }
      }
      at = at + usize.ONE
    }
    run Vector.append<Constraint>(
      &mut constraints.*,
      Constraint.Conforms {provider: Shared.clone<Type>(&provider), contract: move contract},
    )
    return Option.none<Shared<Rejection>>()
  }
  return Option.some<Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidBound, span),
  )
}

effect fn resolveConstraints(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  generics: Range,
  binders: &[Binder],
  elision: &mut LifetimeElision,
  isPublic: bool,
) -> Result<Vector<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut constraints = Vector.make<Constraint>()
  let mut at = usize.ZERO
  // Template binders are one-to-one with the written generic list.
  while at < generics.length && at < binders.length {
    let child = run typeChild(&mut resolver.*, module, generics, at)
    let mut bounds = Range.empty()
    if let Option<HirId>.Some {value: parameterId} = move child {
      let syntax = run typeNode(&mut resolver.*, module, parameterId)
      if let Option<HeaderSyntax>.Some {value} = move syntax {
        if let Node.TypeParameter {bounds: written, ..} = value.header {
          bounds = written
        }
        if let Node.LifetimeParameter {bounds: written, ..} = value.header {
          bounds = written
        }
      }
    }
    let mut boundAt = usize.ZERO
    while boundAt < bounds.length {
      let bound = run typeChild(&mut resolver.*, module, bounds, boundAt)
      if let Option<HirId>.Some {value: boundId} = move bound {
        let failed = run declareBound(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          &binders[at],
          boundId,
          binders,
          &mut elision.*,
          isPublic,
          &mut constraints,
        )
        if let Option<Shared<Rejection>>.Some {value} = move failed {
          return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move value)
        }
      }
      boundAt = boundAt + usize.ONE
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Constraint>, Shared<Rejection>>(move constraints)
}

// Resolve a declaration's written bounds again under one complete application. The abstract
// contract query validates their spelling; this pass gives proof concrete provider and contract
// arguments without building a second type-substitution language.
effect fn appliedDeclarationBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  declaration: usize,
  generics: Range,
  template: &[Binder],
  arguments: &[Argument],
  span: Span,
  isPublic: bool,
) -> Result<Vector<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let identity = run declarationAt(&mut resolver.*, &module, declaration)
  let declared = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, span),
      )
    }
  }
  let applied = run bindArguments(template, arguments)
  let mut elision = LifetimeElision {
    owner: Option.some<DeclarationId>(move declared),
    nextOrdinal: template.length,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.some<Vector<Argument>>(run copyArguments(arguments)),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  return run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    &module,
    generics,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
    isPublic,
  )
}

effect fn resolveContract(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let isPublic = match value.header {
      Node.StructHeader {isPublic, ..} => isPublic
      Node.TupleHeader {isPublic, ..} => isPublic
      Node.EnumHeader {isPublic, ..} => isPublic
      Node.UnionHeader {isPublic, ..} => isPublic
      Node.ServiceHeader {isPublic, ..} => isPublic
      Node.InterfaceHeader {isPublic, ..} => isPublic
      Node.AliasHeader {isPublic, ..} => isPublic
      Node.RoleHeader {isPublic, ..} => isPublic
      _ => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.NotType, value.span),
          move dependencies,
        )
      }
    }
    let template = run templateBinders(&mut resolver.*, &module, key.declaration)
    let mut binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let incomplete = run completeAggregateBinders(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      key.declaration,
      value.span,
      &mut binders,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move incomplete {
      return memberRejected(move diagnostic, move dependencies)
    }
    let contractOwner = isContractHeader(value.header)
    if contractOwner {
      let none = Vector.make<Binder>()
      let conflict = run scopedBinderRejection(
        &mut resolver.*,
        &module,
        headerGenerics(value.header),
        Vector.asSlice<Binder>(&none),
        true,
        false,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
        return memberRejected(move diagnostic, move dependencies)
      }
    }
    let mut lists = run parametersOf(Vector.asSlice<Binder>(&binders))
    let mut elision = LifetimeElision {
      owner: run declarationAt(&mut resolver.*, &module, key.declaration),
      nextOrdinal: Vector.length<Binder>(&binders),
      output: false,
      resultDefault: Option.none<Shared<Lifetime>>(),
      generated: Vector.make<Shared<Lifetime>>(),
      invocation: false,
      nested: false,
      renumber: Vector.make<usize>(),
      staticEnvironment: false,
      supplied: Option.none<Vector<Argument>>(),
      assumptions: Option.none<Vector<Constraint>>(),
    }
    let declared = run resolveConstraints(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      headerGenerics(value.header),
      Vector.asSlice<Binder>(&binders),
      &mut elision,
      isPublic,
    )
    let constraints = match move declared {
      Result<Vector<Constraint>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    // An omitted lifetime in a bound belongs to this declaration just like an omitted field
    // lifetime. Keep it in the contract so applications can supply or elide it by ordinal.
    let generated = Vector.asSlice<Shared<Lifetime>>(&elision.generated)
    let mut generatedAt = usize.ZERO
    while generatedAt < generated.length {
      run Vector.append<Shared<Lifetime>>(
        &mut lists.lifetimes,
        Shared.clone<Lifetime>(&generated[generatedAt]),
      )
      generatedAt = generatedAt + usize.ONE
    }
    let mut provider = Option.none<Shared<Type>>()
    if contractOwner {
      let identity = run declarationAt(&mut resolver.*, &module, key.declaration)
      if let Option<DeclarationId>.Some {value: contract} = move identity {
        provider = Option.some<Shared<Type>>(
          run Shared.make<Type>(
            Type.Parameter {declaration: move contract, ordinal: Vector.length<Binder>(&binders)},
          ),
        )
      }
    }
    return memberSuccess(
      Value.Contract {
        contract: Contract {
          typeParameters: move lists.types,
          lifetimeParameters: move lists.lifetimes,
          rowParameters: move lists.rows,
          constraints: move constraints,
          provider: move provider,
        },
      },
      move dependencies,
    )
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// The written name node of one generic binder, absent for damaged binder syntax.
fn binderNameId(parameter: Node) -> HirRef {
  return match parameter {
    Node.TypeParameter {name, ..} => HirRef.of(name)
    Node.RowParameter {name} => HirRef.of(name)
    Node.LifetimeParameter {name, ..} => HirRef.of(name)
    _ => HirRef.absent()
  }
}

// The kind of one written generic binder, as its enclosing-scope counterpart would record it.
fn writtenBinderKind(parameter: Node) -> GenericKind {
  return match parameter {
    Node.RowParameter {..} => GenericKind.Requirement
    Node.LifetimeParameter {..} => GenericKind.Lifetime
    _ => GenericKind.Type
  }
}

// Whether an enclosing binder with this spelling has exactly this kind.
fn restatesSameKind(enclosing: &[Binder], spelling: &[u8], kind: GenericKind) -> bool {
  let mut at = usize.ZERO
  while at < enclosing.length {
    if same(binderName(&enclosing[at]), spelling) {
      return binderKind(&enclosing[at]) == kind
    }
    at = at + usize.ONE
  }
  return false
}

// Rejects a written binder that reuses a spelling already bound around it. The implicit `Self`
// provider reserves its name. An inherent member may restate an owner binder of the same kind as a
// refinement; restating it with another kind would silently shadow it, so that is a duplicate.
// Restating an interface, service, or conformance binder has no settled meaning, so that form stays
// `Unsupported` rather than choosing shadowing or refinement.
effect fn scopedBinderRejection(
  resolver: &mut Resolver,
  module: &ModuleId,
  generics: Range,
  enclosing: &[Binder],
  reservesSelf: bool,
  refines: bool,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < generics.length {
      let parameter = Module.child(hir, generics, at)
      let name = binderNameId(Module.node(hir, parameter))
      if name.present {
        if let Node.Name {text} = Module.node(hir, name.id) {
          let spelling = Module.text(hir, text)
          if reservesSelf && same(spelling, b"Self") {
            return Option.some<Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.DuplicateTypeParameter,
                Module.span(hir, parameter),
              ),
            )
          }
          if hasBinder(enclosing, spelling) {
            let written = writtenBinderKind(Module.node(hir, parameter))
            let mut code = RejectionCode.Unsupported
            if refines {
              code = RejectionCode.DuplicateTypeParameter
            }
            if !refines || !restatesSameKind(enclosing, spelling, written) {
              return Option.some<Shared<Rejection>>(
                run reject(&resolver.*, module, code, Module.span(hir, parameter)),
              )
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return Option.none<Shared<Rejection>>()
}

// The implicit `Self` provider of an interface or service, bound after its written binders.
effect fn selfBinder(owner: DeclarationId, writtenCount: usize) -> Binder
! OutOfMemoryError
? &mut Allocator {
  return Binder.Type {
    name: run Bytes.copy(b"Self"),
    value: run Shared.make<Type>(Type.Parameter {declaration: move owner, ordinal: writtenCount}),
  }
}

// The source spans of written binders and, in declaration order, of each written bound.
struct GenericAnchors {
  binders: Vector<Span>
  bounds: Vector<Span>
}

effect fn genericAnchors(resolver: &mut Resolver, module: &ModuleId, generics: Range) -> GenericAnchors
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut anchors = GenericAnchors {binders: Vector.make<Span>(), bounds: Vector.make<Span>()}
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < generics.length {
      let parameter = Module.child(hir, generics, at)
      run Vector.append<Span>(&mut anchors.binders, Module.span(hir, parameter))
      let bounds = match Module.node(hir, parameter) {
        Node.TypeParameter {bounds: written, ..} => written
        Node.LifetimeParameter {bounds: written, ..} => written
        _ => Range.empty()
      }
      let mut boundAt = usize.ZERO
      while boundAt < bounds.length {
        run Vector.append<Span>(
          &mut anchors.bounds,
          Module.span(hir, Module.child(hir, bounds, boundAt)),
        )
        boundAt = boundAt + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return move anchors
}

fn headProvider(head: &ImplementationHead) -> Shared<Type> {
  return Shared.clone<Type>(&head.provider)
}

// `Self` inside an implementation denotes its applied provider.
effect fn providerBinder(provider: Shared<Type>) -> Binder ! OutOfMemoryError ? &mut Allocator {
  return Binder.Type {name: run Bytes.copy(b"Self"), value: move provider}
}

fn isContractHeader(header: Node) -> bool {
  return match header {
    Node.InterfaceHeader {..} => true
    Node.ServiceHeader {..} => true
    _ => false
  }
}

// The binders visible around a nested declaration's own binders. An interface or service operation
// sees its contract's written binders followed by the implicit `Self` provider. An `impl` member
// sees the implementation's written binders and `Self` as the head's applied provider. A top-level
// declaration sees none.
effect fn enclosingScope(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
) -> Result<Vector<Binder>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut parent = usize.MAX
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: enclosing} = &declarations[ordinal].parent {
        parent = enclosing
      }
    }
  }
  if parent == usize.MAX {
    return Result.succeed<Vector<Binder>, Shared<Rejection>>(Vector.make<Binder>())
  }
  let written = run header(&mut resolver.*, module, parent)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ImplHeader {..} = value.header {
      let headKey = Key {
        family: Family.ImplementationHead,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: parent,
        member: usize.ZERO,
        external: false,
      }
      let child = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        headKey,
        value.span,
      )
      let head = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
        &child,
        headOf,
      )
      if let Option<Shared<ImplementationHead>>.Some {value: found} = move head {
        let template = run templateBinders(&mut resolver.*, module, parent)
        let mut binders = match move template {
          Result<Vector<Binder>, Shared<Rejection>>.Success {value: listed} => move listed
          Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Vector<Binder>, Shared<Rejection>>(move error)
          }
        }
        let provider = Shared.with<ImplementationHead, Shared<Type>>(&found, headProvider)
        run Vector.append<Binder>(&mut binders, run providerBinder(move provider))
        return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
      }
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &child,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return Result.failResult<Vector<Binder>, Shared<Rejection>>(move diagnostic)
      }
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, value.span),
      )
    }
    if !isContractHeader(value.header) {
      return Result.succeed<Vector<Binder>, Shared<Rejection>>(Vector.make<Binder>())
    }
  }
  let template = run templateBinders(&mut resolver.*, module, parent)
  let mut binders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(move error)
    }
  }
  let identity = run declarationAt(&mut resolver.*, module, parent)
  if let Option<DeclarationId>.Some {value: contract} = move identity {
    let count = Vector.length<Binder>(&binders)
    run Vector.append<Binder>(&mut binders, run selfBinder(move contract, count))
  }
  return Result.succeed<Vector<Binder>, Shared<Rejection>>(move binders)
}

// Whether a declaration is a member of an inherent `impl`, whose owner binders it may refine.
effect fn refinesEnclosing(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
        let hir = IndexedSource.authored(value)
        return isImplementationHeader(hir, &declarations[parent]) && !isConformanceHeader(
          hir,
          &declarations[parent],
        )
      }
    }
  }
  return false
}

// The enclosing binder that an own binder restates with the same spelling and kind, if refinable.
effect fn restatedBinder(binders: &Vector<Binder>, at: usize, visible: &[Binder], refines: bool) -> Option<
  Binder,
> ! OutOfMemoryError ? &mut Allocator {
  if !refines {
    return Option.none<Binder>()
  }
  let current = Vector.asSlice<Binder>(binders)
  let mut index = usize.ZERO
  while index < visible.length {
    if same(binderName(&visible[index]), binderName(&current[at])) && binderKind(&visible[index]) == binderKind(
      &current[at],
    ) {
      return Option.some<Binder>(run copyBinder(&visible[index]))
    }
    index = index + usize.ONE
  }
  return Option.none<Binder>()
}

effect fn binderAt(binders: &Vector<Binder>, at: usize) -> Binder
! OutOfMemoryError
? &mut Allocator {
  let current = Vector.asSlice<Binder>(binders)
  return run copyBinder(&current[at])
}

// The identity of the declaration directly enclosing `ordinal`, if any.
effect fn enclosingIdentity(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<
  DeclarationId,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut parent = usize.MAX
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: enclosing} = &declarations[ordinal].parent {
        parent = enclosing
      }
    }
  }
  if parent == usize.MAX {
    return Option.none<DeclarationId>()
  }
  return run declarationAt(&mut resolver.*, module, parent)
}

effect fn collectConstraint(
  constraint: &Constraint,
  owner: &DeclarationId,
  types: &mut Vector<usize>,
  regions: &mut Vector<usize>,
  rows: &mut Vector<usize>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  match & constraint.* {
    Constraint.Conforms {provider, contract} => {
      run Type.collectOwned(&provider, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwned(&contract, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Represents {parameter, contract} => {
      run Type.collectOwned(&parameter, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwned(&contract, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Contents {subject, region} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
      run Type.collectOwnedLifetime(&region, owner, &mut regions.*)
    }
    Constraint.Outlives {longer, shorter} => {
      run Type.collectOwnedLifetime(&longer, owner, &mut regions.*)
      run Type.collectOwnedLifetime(&shorter, owner, &mut regions.*)
    }
    Constraint.Copyable {subject} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
    Constraint.Property {subject, ..} => {
      run Type.collectOwned(&subject, owner, &mut types.*, &mut regions.*, &mut rows.*)
    }
  }
  return ()
}

// The ordinals in ascending order, so owner binders keep their declaration order.
effect fn sortedOrdinals(values: &Vector<usize>) -> Vector<usize>
! OutOfMemoryError
? &mut Allocator {
  let mut sorted = Vector.make<usize>()
  let source = Vector.asSlice<usize>(values)
  let mut at = usize.ZERO
  while at < source.length {
    run Vector.append<usize>(&mut sorted, source[at])
    let mut position = Vector.length<usize>(&sorted) - usize.ONE
    while position > usize.ZERO && Vector.get<usize>(&sorted, position - usize.ONE) > Vector.get<
      usize,
    >(&sorted, position) {
      let earlier = Vector.get<usize>(&sorted, position - usize.ONE)
      let later = Vector.get<usize>(&sorted, position)
      Vector.set<usize>(&mut sorted, position - usize.ONE, later)
      Vector.set<usize>(&mut sorted, position, earlier)
      position = position - usize.ONE
    }
    at = at + usize.ONE
  }
  return move sorted
}

fn enclosedBy(declaration: &IndexedDeclaration, parent: usize) -> bool {
  return match & declaration.parent {
    Option<usize>.Some {value} => value == parent
    Option<usize>.None => false
  }
}

fn writesBody(hir: &Module, declaration: HirId) -> bool {
  if let Node.Declaration {body, ..} = Module.node(hir, declaration) {
    if let Node.CallableBody {block} = Module.node(hir, body) {
      return block.present
    }
  }
  return false
}

// Services are dependency contracts and cannot publish operator markers.
fn validOperatorMarker(hir: &Module, marker: HirId, contract: HirId, isInterface: bool) -> bool {
  if !isInterface {
    return false
  }
  if let Node.Name {text} = Module.node(hir, marker) {
    let spelling = Module.text(hir, text)
    if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
      return Operator.validMarker(spelling, parameters.length)
    }
  }
  return false
}

// A marker is checked as part of the contract's Operations answer. A matched operation also
// reports whether operator syntax can supply its parameter modes without an adaptation.
effect fn operationMarks(
  resolver: &mut Resolver,
  module: &ModuleId,
  operation: &Shared<DeclarationId>,
  requested: &Operator.Spelling,
) -> Option<bool> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let hir = IndexedSource.authored(indexed)
    let mut at = usize.ZERO
    while at < declarations.length {
      if Shared.with<DeclarationId, bool>(
        operation,
        fn(identity: &DeclarationId) -> bool {
          return DeclarationId.equals(&declarations[at].identity, identity)
        },
      ) {
        if let Node.OperationHeader {operator, contract, ..} = Module.node(
          hir,
          declarations[at].header,
        ) {
          if operator.present {
            if let Node.Name {text} = Module.node(hir, operator.id) {
              if Operator.matches(Module.text(hir, text), requested) {
                if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
                  let mut parameterAt = usize.ZERO
                  while parameterAt < parameters.length {
                    let parameter = Module.child(hir, parameters, parameterAt)
                    if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
                      if mode != ParameterMode.Value {
                        return Option.some<bool>(false)
                      }
                    }
                    parameterAt = parameterAt + usize.ONE
                  }
                  return Option.some<bool>(true)
                }
              }
            }
          }
        }
        return Option.none<bool>()
      }
      at = at + usize.ONE
    }
  }
  return Option.none<bool>()
}

effect fn resolveOperations(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let dependencies = Vector.make<Dependency>()
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if key.declaration < declarations.length {
      let hir = IndexedSource.authored(value)
      let contractHeader = declarations[key.declaration].header
      let enclosing = Module.node(hir, contractHeader)
      if !isContractHeader(enclosing) {
        return memberRejected(
          run reject(
            &resolver.*,
            &module,
            RejectionCode.Unsupported,
            Module.span(hir, contractHeader),
          ),
          move dependencies,
        )
      }
      let mut operations = Vector.make<Shared<DeclarationId>>()
      let mut names = Vector.make<Bytes>()
      let mut at = usize.ZERO
      while at < declarations.length {
        if enclosedBy(&declarations[at], key.declaration) {
          let memberHeader = declarations[at].header
          let span = Module.span(hir, memberHeader)
          let mut spelling = Option.none<Bytes>()
          if let Node.OperationHeader {name, isPublic, contract, operator, ..} = Module.node(
            hir,
            memberHeader,
          ) {
            if !isPublic && !writesBody(hir, declarations[at].local) {
              if operator.present {
                let isInterface = match enclosing {
                  Node.InterfaceHeader {..} => true
                  _ => false
                }
                if !validOperatorMarker(hir, operator.id, contract, isInterface) {
                  return memberRejected(
                    run reject(
                      &resolver.*,
                      &module,
                      RejectionCode.InvalidOperatorContract,
                      Module.span(hir, operator.id),
                    ),
                    move dependencies,
                  )
                }
              }
              if let Node.Name {text} = Module.node(hir, name) {
                spelling = Option.some<Bytes>(run Bytes.copy(Module.text(hir, text)))
              }
            }
          }
          if let Option<Bytes>.Some {value: operation} = move spelling {
            let prior = Vector.asSlice<Bytes>(&names)
            let mut before = usize.ZERO
            while before < prior.length {
              if same(Bytes.asSlice(&prior[before]), Bytes.asSlice(&operation)) {
                return memberRejected(
                  run reject(&resolver.*, &module, RejectionCode.Collision, span),
                  move dependencies,
                )
              }
              before = before + usize.ONE
            }
            run Vector.append<Bytes>(&mut names, move operation)
            run Vector.append<Shared<DeclarationId>>(
              &mut operations,
              run Shared.make<DeclarationId>(run DeclarationId.copy(&declarations[at].identity)),
            )
          } else {
            return memberRejected(
              run reject(&resolver.*, &module, RejectionCode.InvalidContractMember, span),
              move dependencies,
            )
          }
        }
        at = at + usize.ONE
      }
      return memberSuccess(Value.Operations {operations: move operations}, move dependencies)
    }
  }
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

// The one operation or function named `name` directly inside the declaration at `parent`; a
// repeated name has no winner and yields the later declaration's span instead.
struct MemberLookup {
  ordinal: Option<usize>
  repeated: Option<Span>
}

effect fn memberOrdinal(resolver: &mut Resolver, module: &ModuleId, parent: usize, name: &[u8]) -> MemberLookup
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut found = Option.none<usize>()
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if enclosedBy(&declarations[at], parent) {
        let written = match Module.node(hir, declarations[at].header) {
          Node.OperationHeader {name: spelled, ..} => HirRef.of(spelled)
          Node.FunctionHeader {name: spelled, ..} => HirRef.of(spelled)
          _ => HirRef.absent()
        }
        if written.present {
          if let Node.Name {text} = Module.node(hir, written.id) {
            if same(Module.text(hir, text), name) {
              if let Option<usize>.Some {..} = &found {
                return MemberLookup {
                  ordinal: Option.none<usize>(),
                  repeated: Option.some<Span>(Module.span(hir, declarations[at].header)),
                }
              }
              found = Option.some<usize>(at)
            }
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return MemberLookup {ordinal: move found, repeated: Option.none<Span>()}
}

// What an owner's inherent member list says about one member name.
struct InherentLookup {
  published: Option<Shared<DeclarationId>>
  rejected: Option<Shared<Rejection>>
}

fn inherentLookup(answer: &Result<Answer, NoRejection>, member: &[u8]) -> InherentLookup {
  let mut lookup = InherentLookup {
    published: Option.none<Shared<DeclarationId>>(),
    rejected: Option.none<Shared<Rejection>>(),
  }
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.InherentMembers {members, rejected}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(
          &listed[at],
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.named(declaration, member)
          },
        ) {
          lookup.published = Option.some<Shared<DeclarationId>>(
            Shared.clone<DeclarationId>(&listed[at]),
          )
        }
        at = at + usize.ONE
      }
      let refused = Vector.asSlice<RejectedMember>(&rejected)
      at = usize.ZERO
      while at < refused.length {
        if Shared.with<DeclarationId, bool>(
          &refused[at].declaration,
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.named(declaration, member)
          },
        ) {
          lookup.rejected = Option.some<Shared<Rejection>>(
            Shared.clone<Rejection>(&refused[at].rejection),
          )
        }
        at = at + usize.ONE
      }
    }
  }
  return move lookup
}

// The index ordinal of a declaration identity in the held source of `module`.
effect fn ordinalOfIdentity(
  resolver: &mut Resolver,
  module: &ModuleId,
  identity: &Shared<DeclarationId>,
) -> Option<usize> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut at = usize.ZERO
    while at < declarations.length {
      let candidate = &declarations[at].identity
      if Shared.with<DeclarationId, bool>(
        identity,
        fn(declaration: &DeclarationId) -> bool {
          return DeclarationId.equals(candidate, declaration)
        },
      ) {
        return Option.some<usize>(at)
      }
      at = at + usize.ONE
    }
  }
  return Option.none<usize>()
}

effect fn locationOfInstance(resolver: &mut Resolver, instance: &InstanceKey) -> Option<
  InstanceLocation,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let identity = InstanceKey.identity(instance)
  let count = Vector.length<ModuleId>(&resolver.modules)
  let mut moduleIndex = usize.ZERO
  while moduleIndex < count {
    let known = Vector.asSlice<ModuleId>(&resolver.modules)
    let sameModule = Shared.with<DeclarationId, bool>(
      &identity,
      fn(id: &DeclarationId) -> bool {
        return ModuleId.equals(&known[moduleIndex], DeclarationId.moduleId(id))
      },
    )
    if sameModule {
      let module = run resolvedModule(&resolver.*, moduleIndex)
      let found = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
      if let Option<usize>.Some {value} = move found {
        return Option.some<InstanceLocation>(
          InstanceLocation {module: moduleIndex, declaration: value},
        )
      }
    }
    moduleIndex = moduleIndex + usize.ONE
  }
  return Option.none<InstanceLocation>()
}

// The index ordinal of the nominal declaration a provider type applies, in the held `module`.
effect fn ordinalOfProvider(resolver: &mut Resolver, module: &ModuleId, provider: &Shared<Type>) -> Option<
  usize,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut at = usize.ZERO
    while at < declarations.length {
      let candidate = &declarations[at].identity
      if Shared.with<Type, bool>(
        provider,
        fn(applied: &Type) -> bool {
          return match & applied.* {
            Type.Nominal {declaration, ..} => DeclarationId.equals(candidate, &declaration)
            _ => false
          }
        },
      ) {
        return Option.some<usize>(at)
      }
      at = at + usize.ONE
    }
  }
  return Option.none<usize>()
}

// Whether a member identity is published by an owner's inherent member list, or the kept
// rejection that replaces it.
struct MemberVerdict {
  published: bool
  rejected: Option<Shared<Rejection>>
}

fn memberVerdict(answer: &Result<Answer, NoRejection>, member: &DeclarationId) -> MemberVerdict {
  let mut verdict = MemberVerdict {published: false, rejected: Option.none<Shared<Rejection>>()}
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.InherentMembers {members, rejected}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&members)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(
          &listed[at],
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.equals(declaration, member)
          },
        ) {
          verdict.published = true
        }
        at = at + usize.ONE
      }
      let refused = Vector.asSlice<RejectedMember>(&rejected)
      at = usize.ZERO
      while at < refused.length {
        if Shared.with<DeclarationId, bool>(
          &refused[at].declaration,
          fn(declaration: &DeclarationId) -> bool {
            return DeclarationId.equals(declaration, member)
          },
        ) {
          verdict.rejected = Option.some<Shared<Rejection>>(
            Shared.clone<Rejection>(&refused[at].rejection),
          )
        }
        at = at + usize.ONE
      }
    }
  }
  return move verdict
}

// Where a declaration sits: its enclosing declaration and, for a member, its written name.
struct MemberPlace {
  parent: usize
  contract: bool
  implementation: bool
  inherent: bool
  name: Option<Bytes>
}

effect fn memberPlace(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> MemberPlace
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut place = MemberPlace {
    parent: usize.MAX,
    contract: false,
    implementation: false,
    inherent: false,
    name: Option.none<Bytes>(),
  }
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      if let Option<usize>.Some {value: parent} = &declarations[ordinal].parent {
        place.parent = parent
        place.contract = isContractHeader(Module.node(hir, declarations[parent].header))
        place.implementation = isImplementationHeader(hir, &declarations[parent])
        place.inherent = place.implementation && !isConformanceHeader(hir, &declarations[parent])
      }
      let written = match Module.node(hir, declarations[ordinal].header) {
        Node.OperationHeader {name: spelled, ..} => HirRef.of(spelled)
        Node.FunctionHeader {name: spelled, ..} => HirRef.of(spelled)
        _ => HirRef.absent()
      }
      if written.present {
        if let Node.Name {text} = Module.node(hir, written.id) {
          place.name = Option.some<Bytes>(run Bytes.copy(Module.text(hir, text)))
        }
      }
    }
  }
  return move place
}

// G3: the one path from a function or operation declaration to its Signature answer. It applies
// the same gates as the name lookups: a contract's operation list must resolve, an `impl` member's
// name must be written once in its block, and an inherent member must be published by its owner.
effect fn memberSignature(
  resolver: &mut Resolver,
  query: &mut Query<Word, Answer, NoRejection>,
  module: &ModuleId,
  ordinal: usize,
  anchor: Span,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let place = run memberPlace(&mut resolver.*, module, ordinal)
  if place.contract {
    let operationsKey = Key {
      family: Family.Operations,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: place.parent,
      member: usize.ZERO,
      external: false,
    }
    let listed = run demandRaw(&mut resolver.*, &mut query.*, operationsKey, anchor)
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      return move listed
    }
  }
  if place.implementation {
    if let Option<Bytes>.Some {value: name} = &place.name {
      let lookup = run memberOrdinal(&mut resolver.*, module, place.parent, Bytes.asSlice(&name))
      if let Option<Span>.Some {value: span} = move lookup.repeated {
        let diagnostic = run reject(&resolver.*, module, RejectionCode.Collision, span)
        return run rootRejection(&mut resolver.*, module, move diagnostic)
      }
    }
    if place.inherent {
      let refusal = run inherentMemberRefusal(
        &mut resolver.*,
        &mut query.*,
        module,
        place.parent,
        ordinal,
      )
      if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: refused} = move refusal {
        return move refused
      }
    }
  }
  let key = Key {
    family: Family.Signature,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ordinal,
    member: usize.ZERO,
    external: false,
  }
  return run demandRaw(&mut resolver.*, &mut query.*, key, anchor)
}

// For a member of an inherent `impl`, the rejecting answer that owner-wide uniqueness or the head
// gives instead of its signature; `None` when the owner publishes the member.
effect fn inherentMemberRefusal(
  resolver: &mut Resolver,
  query: &mut Query<Word, Answer, NoRejection>,
  module: &ModuleId,
  implementation: usize,
  member: usize,
) -> Option<Shared<Result<Answer, NoRejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let headKey = Key {
    family: Family.ImplementationHead,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: implementation,
    member: usize.ZERO,
    external: false,
  }
  let head = run demandRaw(
    &mut resolver.*,
    &mut query.*,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    &head,
    headOf,
  )
  let found = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Option.some<Shared<Result<Answer, NoRejection>>>(move head)
    }
  }
  let provider = Shared.with<ImplementationHead, Shared<Type>>(&found, headProvider)
  let located = run ordinalOfProvider(&mut resolver.*, module, &provider)
  let ownerOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option.some<Shared<Result<Answer, NoRejection>>>(
        run rejectAbsent(&mut resolver.*, module, Span.make(usize.ZERO, usize.ZERO)),
      )
    }
  }
  let membersKey = Key {
    family: Family.InherentMembers,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ownerOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let listed = run demandRaw(
    &mut resolver.*,
    &mut query.*,
    membersKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
    return Option.some<Shared<Result<Answer, NoRejection>>>(move listed)
  }
  let identity = run declarationAt(&mut resolver.*, module, member)
  if let Option<DeclarationId>.Some {value: declared} = move identity {
    let verdict = Shared.with<Result<Answer, NoRejection>, MemberVerdict>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> MemberVerdict {
        return memberVerdict(answer, &declared)
      },
    )
    if verdict.published {
      return Option.none<Shared<Result<Answer, NoRejection>>>()
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move verdict.rejected {
      return Option.some<Shared<Result<Answer, NoRejection>>>(
        run rootRejection(&mut resolver.*, module, move diagnostic),
      )
    }
  }
  return Option.some<Shared<Result<Answer, NoRejection>>>(
    run rejectAbsent(&mut resolver.*, module, Span.make(usize.ZERO, usize.ZERO)),
  )
}

// The ordinal of the `occurrence`th top-level `impl` declaration of a module.
effect fn implementationOrdinal(resolver: &mut Resolver, module: &ModuleId, occurrence: usize) -> Option<
  usize,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut seen = usize.ZERO
    let mut at = usize.ZERO
    while at < declarations.length {
      if isImplementationHeader(hir, &declarations[at]) && topLevel(&declarations[at]) {
        if seen == occurrence {
          return Option.some<usize>(at)
        }
        seen = seen + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return Option.none<usize>()
}

// A root answer for a member the held revision does not contain.
effect fn rejectAbsent(resolver: &mut Resolver, module: &ModuleId, span: Span) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let diagnostic = run reject(&resolver.*, module, RejectionCode.UnknownMember, span)
  return run rootRejection(&mut resolver.*, module, move diagnostic)
}

// A root answer that rejects with `diagnostic` while observing the module's current source.
effect fn rootRejection(resolver: &mut Resolver, module: &ModuleId, diagnostic: Shared<Rejection>) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut sources = Vector.make<Shared<Observation>>()
  run Vector.append<Shared<Observation>>(
    &mut sources,
    run Shared.make<Observation>(run SourceIndex.captureObservation(&resolver.source, module)),
  )
  return run Shared.make<Result<Answer, NoRejection>>(
    Result.succeed<Answer, NoRejection>(
      Answer {
        outcome: Outcome.Rejected {diagnostic: move diagnostic},
        dependencies: Vector.make<Dependency>(),
        sources: move sources,
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      },
    ),
  )
}

// A bound written as `Intrinsic.Member`, and the sealed property it names when it names one.
struct IntrinsicBound {
  named: bool
  property: Option<IntrinsicProperty>
}

// INTR-001: `Intrinsic` is the sealed compiler namespace. It needs no import and no module binding
// can shadow it, so a two-segment path starting with it never reaches module lookup.
effect fn intrinsicBound(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> IntrinsicBound
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut found = IntrinsicBound {named: false, property: Option.none<IntrinsicProperty>()}
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: typeName, hasMode, ..} = value.header {
      if !hasMode {
        let parsed = run path(&mut resolver.*, module, typeName)
        let segments = Vector.asSlice<Bytes>(&parsed.segments)
        if parsed.valid && segments.length == 2 && same(
          Bytes.asSlice(&segments[usize.ZERO]),
          b"Intrinsic",
        ) {
          found.named = true
          let member = Bytes.asSlice(&segments[usize.ONE])
          if same(member, b"Detached") {
            found.property = Option.some<IntrinsicProperty>(IntrinsicProperty.Detached)
          }
          if same(member, b"NonParking") {
            found.property = Option.some<IntrinsicProperty>(IntrinsicProperty.NonParking)
          }
        }
      }
    }
  }
  return move found
}

// The sealed property a bare `Copy` or `Drop` spelling names. Like `Effect`, these are language
// bindings that need no import, so module lookup never selects them; only a binder shadows them.
effect fn sealedProperty(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> Option<
  SealedProperty,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    if let Node.NamedType {path: typeName, hasMode, ..} = value.header {
      if !hasMode {
        let parsed = run path(&mut resolver.*, module, typeName)
        let segments = Vector.asSlice<Bytes>(&parsed.segments)
        if parsed.valid && segments.length == usize.ONE {
          let name = Bytes.asSlice(&segments[usize.ZERO])
          if !hasBinder(binders, name) {
            if same(name, b"Copy") {
              return Option.some<SealedProperty>(SealedProperty.Copy)
            }
            if same(name, b"Drop") {
              return Option.some<SealedProperty>(SealedProperty.Drop)
            }
          }
        }
      }
    }
  }
  return Option.none<SealedProperty>()
}

// Rejects a value type that applies an interface or service; they are contracts, not existentials.
effect fn existentialRejection(
  resolver: &mut Resolver,
  module: &ModuleId,
  id: HirId,
  value: &Shared<Type>,
) -> Option<Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  if !Shared.with<Type, bool>(value, Type.mentionsContract) {
    return Option.none<Shared<Rejection>>()
  }
  let syntax = run typeNode(&mut resolver.*, module, id)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value: written} = move syntax {
    span = written.span
  }
  return Option.some<Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotType, span),
  )
}

// Whether a nominal type is declared in `module`; false for every other type.
fn declaredIn(value: &Type, module: &ModuleId) -> bool {
  return match & value.* {
    Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
    _ => false
  }
}

fn isNominalType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {..} => true
    _ => false
  }
}

// A scalar or borrowed `string` provider has no declaring module.
fn foundationalProvider(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {..} => true
    Type.Unit => true
    Type.String {..} => true
    _ => false
  }
}

// The implementation-owned ordinal an argument names, or `usize.MAX` for any other argument.
fn argumentOrdinal(argument: &Argument, implementation: &DeclarationId) -> usize {
  return match & argument.* {
    Argument.Type {value} => Shared.with<Type, usize>(
      &value,
      fn(node: &Type) -> usize {
        return Type.parameterOrdinalOf(node, implementation)
      },
    )
    Argument.Lifetime {value} => Shared.with<Lifetime, usize>(
      &value,
      fn(region: &Lifetime) -> usize {
        return lifetimeOrdinalOf(region, implementation)
      },
    )
    Argument.Row {value} => Shared.with<Row, usize>(
      &value,
      fn(row: &Row) -> usize {
        return rowParameterOrdinal(row, implementation)
      },
    )
  }
}

// The ordinal of a row that is exactly one requirement-row parameter bound by `implementation`.
fn rowParameterOrdinal(row: &Row, implementation: &DeclarationId) -> usize {
  let parameters = Vector.asSlice<RowParameter>(&row.parameters)
  if Vector.length<Requirement>(&row.entries) != usize.ZERO || parameters.length != usize.ONE {
    return usize.MAX
  }
  if Shared.with<DeclarationId, bool>(
    &parameters[usize.ZERO].declaration,
    fn(declaration: &DeclarationId) -> bool {
      return DeclarationId.equals(declaration, implementation)
    },
  ) {
    return parameters[usize.ZERO].ordinal
  }
  return usize.MAX
}

// Whether a nominal owner's arguments are exactly the implementation's binders, each once: the
// written binders in declaration order, and lifetimes elided from the head wherever they occur.
fn wholeFamily(
  value: &Type,
  implementation: &DeclarationId,
  writtenCount: usize,
  binderCount: usize,
) -> bool {
  if let Type.Nominal {arguments, ..} = &value.* {
    let supplied = Vector.asSlice<Argument>(&arguments)
    if supplied.length != binderCount {
      return false
    }
    let mut nextWritten = usize.ZERO
    let mut at = usize.ZERO
    while at < supplied.length {
      let ordinal = argumentOrdinal(&supplied[at], implementation)
      if ordinal < writtenCount {
        if ordinal != nextWritten {
          return false
        }
        nextWritten = nextWritten + usize.ONE
      } else if ordinal >= binderCount {
        return false
      }
      at = at + usize.ONE
    }
    return nextWritten == writtenCount
  }
  return false
}

// The written spelling and arguments of an inherent head that names a declaration of its module.
struct InherentOwner {
  name: Bytes
  application: Option<HirId>
  span: Span
}

// An inherent owner is a struct, tuple, union, enum, service, or interface declaration.
fn inherentOwnerKind(value: &Type) -> bool {
  let kind = nominalKind(value)
  return kind == OwnerKind.Struct || kind == OwnerKind.Tuple || kind == OwnerKind.Union || kind == OwnerKind.Enumeration || kind == OwnerKind.Service || kind == OwnerKind.Interface
}

// Checks that an inherent head spells one declaration of its own module; an import, qualified
// path, alias, or foundational spelling is not an owner. An absent name is left to ordinary lookup.
effect fn inherentOwnerSyntax(resolver: &mut Resolver, module: &ModuleId, subject: HirId) -> Result<
  InherentOwner,
  Shared<Rejection>,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let syntax = run typeNode(&mut resolver.*, module, subject)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut named = HirRef.absent()
  let mut application = Option.none<HirId>()
  if let Option<HeaderSyntax>.Some {value} = move syntax {
    span = value.span
    if let Node.NamedType {path: written, hasMode, ..} = value.header {
      if !hasMode {
        named = HirRef.of(written)
      }
    }
    if let Node.AppliedType {target, arguments} = value.header {
      let applied = run typeNode(&mut resolver.*, module, target)
      if let Option<HeaderSyntax>.Some {value: found} = move applied {
        if let Node.NamedType {path: written, hasMode, ..} = found.header {
          if !hasMode {
            named = HirRef.of(written)
            application = Option.some<HirId>(arguments)
          }
        }
      }
    }
  }
  if named.present {
    let parsed = run path(&mut resolver.*, module, named.id)
    let segments = Vector.asSlice<Bytes>(&parsed.segments)
    if parsed.valid && segments.length == usize.ONE {
      let name = Bytes.asSlice(&segments[usize.ZERO])
      // INTR-001: the sealed namespace cannot be reopened or extended; no rejection names that yet.
      if same(name, b"Intrinsic") {
        return Result.failResult<InherentOwner, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
      let selected = run select(&mut resolver.*, module, name, false)
      let mut owned = selected.count != usize.ONE
      if selected.count == usize.ZERO && (primitive(name) || same(name, b"string") || same(
        name,
        b"Effect",
      )) {
        owned = false
      }
      if selected.count == usize.ONE && selected.kind == CandidateKind.Declaration {
        let declared = run header(&mut resolver.*, module, selected.declaration)
        owned = true
        if let Option<HeaderSyntax>.Some {value: found} = move declared {
          if let Node.AliasHeader {..} = found.header {
            owned = false
          }
        }
      }
      if owned {
        return Result.succeed<InherentOwner, Shared<Rejection>>(
          InherentOwner {name: run Bytes.copy(name), application: move application, span: span},
        )
      }
    }
  }
  return Result.failResult<InherentOwner, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidInherentHead, span),
  )
}

fn lifetimeOrdinalOf(region: &Lifetime, owner: &DeclarationId) -> usize {
  if let Lifetime.Parameter {declaration, ordinal} = &region.* {
    if DeclarationId.equals(&declaration, owner) {
      return ordinal
    }
  }
  return usize.MAX
}

effect fn resolveImplementationHead(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let found = run declarationAt(&mut resolver.*, &module, key.declaration)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut generics = Range.empty()
  let mut subject = HirId {index: usize.ZERO}
  let mut target = HirRef.absent()
  let mut isImplementation = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {generics: parameters, subject: named, target: provided} = value.header {
      generics = parameters
      subject = named
      target = provided
      isImplementation = true
    }
  }
  let implementation = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isImplementation {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let template = run templateBinders(&mut resolver.*, &module, key.declaration)
  let binders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  // `Self` is bound inside every implementation, so no written binder may claim it.
  let none = Vector.make<Binder>()
  let conflict = run scopedBinderRejection(
    &mut resolver.*,
    &module,
    generics,
    Vector.asSlice<Binder>(&none),
    true,
    false,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
    return memberRejected(move diagnostic, move dependencies)
  }
  let writtenCount = Vector.length<Binder>(&binders)
  // LIFE-003: lifetimes omitted from the heads become the implementation's own parameters.
  let mut elision = LifetimeElision {
    owner: Option.some<DeclarationId>(run DeclarationId.copy(&implementation)),
    nextOrdinal: writtenCount,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let mut kind = ImplementationKind.Inherent
  let mut contract = Option.none<Shared<Type>>()
  let mut providerId = subject
  // An inherent owner is looked up in module scope only, so a same-spelled declaration of this
  // module wins over a builtin spelling, and an import or alias is never an owner.
  let mut inherentOwner = Option.none<InherentOwner>()
  if !target.present {
    let checked = run inherentOwnerSyntax(&mut resolver.*, &module, subject)
    match move checked {
      Result<InherentOwner, Shared<Rejection>>.Success {value} => {
        inherentOwner = Option.some<InherentOwner>(move value)
      }
      Result<InherentOwner, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
  }
  if target.present {
    providerId = target.id
    kind = ImplementationKind.Conformance
    let sealed = run sealedProperty(
      &mut resolver.*,
      &module,
      subject,
      Vector.asSlice<Binder>(&binders),
    )
    if let Option<SealedProperty>.Some {value: property} = move sealed {
      kind = ImplementationKind.Sealed {property: property}
    } else {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        subject,
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      let applied = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
      let contractKind = Shared.with<Type, OwnerKind>(&applied, nominalKind)
      if contractKind != OwnerKind.Interface && contractKind != OwnerKind.Service {
        let syntax = run typeNode(&mut resolver.*, &module, subject)
        let mut at = span
        if let Option<HeaderSyntax>.Some {value} = move syntax {
          at = value.span
        }
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidBound, at),
          move dependencies,
        )
      }
      contract = Option.some<Shared<Type>>(move applied)
    }
  }
  let mut resolvedProvider = Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
  )
  if let Option<InherentOwner>.Some {value: named} = move inherentOwner {
    let InherentOwner {name: ownerName, application, span: ownerSpan} = move named
    resolvedProvider = run namedType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      Bytes.asSlice(&ownerName),
      false,
      ownerSpan,
      move application,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
    )
  } else {
    resolvedProvider = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      providerId,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
    )
  }
  let provider = match move resolvedProvider {
    Result<Shared<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  let providerSyntax = run typeNode(&mut resolver.*, &module, providerId)
  let mut providerSpan = span
  if let Option<HeaderSyntax>.Some {value} = move providerSyntax {
    providerSpan = value.span
  }
  let nominal = Shared.with<Type, bool>(&provider, isNominalType)
  let foundational = Shared.with<Type, bool>(&provider, foundationalProvider)
  let inherent = match & kind {
    ImplementationKind.Inherent => true
    _ => false
  }
  if inherent && !Shared.with<Type, bool>(&provider, inherentOwnerKind) {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidInherentHead, providerSpan),
      move dependencies,
    )
  }
  // IMPL-001: a provider needs one canonical nominal identity, or is a scalar or `string`.
  if !nominal && !foundational {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidProvider, providerSpan),
      move dependencies,
    )
  }
  let generatedByHeads = Vector.length<Shared<Lifetime>>(&elision.generated)
  let declared = run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    key.module,
    &module,
    generics,
    Vector.asSlice<Binder>(&binders),
    &mut elision,
    false,
  )
  let constraints = match move declared {
    Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
  // A bound's omitted lifetime would add an implementation lifetime no head can determine.
  if Vector.length<Shared<Lifetime>>(&elision.generated) != generatedByHeads {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let providerLocal = Shared.with<Type, bool>(
    &provider,
    fn(value: &Type) -> bool {
      return declaredIn(value, &module)
    },
  )
  let binderCount = writtenCount + generatedByHeads
  // IMPL-004: an interface conformance belongs to the interface's or the nominal provider's
  // module; a service conformance and a sealed property belong to the provider's module.
  let mut permitted = true
  if let ImplementationKind.Sealed {..} = &kind {
    permitted = providerLocal
  }
  if let Option<Shared<Type>>.Some {value: applied} = &contract {
    let contractLocal = Shared.with<Type, bool>(
      &applied,
      fn(value: &Type) -> bool {
        return declaredIn(value, &module)
      },
    )
    let serviceContract = Shared.with<Type, OwnerKind>(&applied, nominalKind) == OwnerKind.Service
    permitted = providerLocal || (!serviceContract && contractLocal)
  }
  if !permitted {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.ConformanceOwner, span),
      move dependencies,
    )
  }
  // ENUM-003: a scalar enum is always Copy and never admits a Drop hook, so neither is requested.
  if let ImplementationKind.Sealed {property} = &kind {
    if Shared.with<Type, OwnerKind>(&provider, nominalKind) == OwnerKind.Enumeration {
      let code = match property {
        SealedProperty.Copy => RejectionCode.InvalidCopyConformance
        SealedProperty.Drop => RejectionCode.InvalidDropImplementation
      }
      return memberRejected(run reject(&resolver.*, &module, code, span), move dependencies)
    }
  }
  // An inherent head belongs to every instantiation of an owner of this module: its arguments are
  // the implementation's own unbounded binders, written ones in declaration order, each once.
  if inherent {
    let family = Shared.with<Type, bool>(
      &provider,
      fn(value: &Type) -> bool {
        return wholeFamily(value, &implementation, writtenCount, binderCount)
      },
    )
    if !providerLocal || !family || Vector.length<Constraint>(&constraints) > usize.ZERO {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidInherentHead, providerSpan),
        move dependencies,
      )
    }
  }
  let lists = run parametersOf(Vector.asSlice<Binder>(&binders))
  let mut lifetimes = move lists.lifetimes
  let generated = Vector.asSlice<Shared<Lifetime>>(&elision.generated)
  let mut generatedAt = usize.ZERO
  while generatedAt < generated.length {
    run Vector.append<Shared<Lifetime>>(
      &mut lifetimes,
      Shared.clone<Lifetime>(&generated[generatedAt]),
    )
    generatedAt = generatedAt + usize.ONE
  }
  let subjectSyntax = run typeNode(&mut resolver.*, &module, subject)
  let mut contractSpan = span
  if let Option<HeaderSyntax>.Some {value} = move subjectSyntax {
    contractSpan = value.span
  }
  let anchors = run genericAnchors(&mut resolver.*, &module, generics)
  let head = ImplementationHead {
    declaration: run Shared.make<DeclarationId>(move implementation),
    kind: move kind,
    binders: Contract {
      typeParameters: move lists.types,
      lifetimeParameters: move lifetimes,
      rowParameters: move lists.rows,
      constraints: move constraints,
      provider: Option.none<Shared<Type>>(),
    },
    contract: move contract,
    provider: move provider,
    span: span,
    contractSpan: contractSpan,
    providerSpan: providerSpan,
    binderSpans: move anchors.binders,
    boundSpans: move anchors.bounds,
  }
  return memberSuccess(
    Value.ImplementationHead {head: run Shared.make<ImplementationHead>(move head)},
    move dependencies,
  )
}

fn headOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ImplementationHead {head}} => Option.some<
        Shared<ImplementationHead>,
      >(Shared.clone<ImplementationHead>(&head))
      _ => Option.none<Shared<ImplementationHead>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ImplementationHead>>()
  }
}

fn isImplementationHeader(hir: &Module, declaration: &IndexedDeclaration) -> bool {
  return match Module.node(hir, declaration.header) {
    Node.ImplHeader {..} => true
    _ => false
  }
}

// An `impl Contract for Provider` header, as opposed to an inherent `impl Owner`.
fn isConformanceHeader(hir: &Module, declaration: &IndexedDeclaration) -> bool {
  return match Module.node(hir, declaration.header) {
    Node.ImplHeader {target, ..} => target.present
    _ => false
  }
}

fn topLevel(declaration: &IndexedDeclaration) -> bool {
  return match & declaration.parent {
    Option<usize>.Some {..} => false
    Option<usize>.None => true
  }
}

effect fn resolveImplementations(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let mut ordinals = Vector.make<usize>()
  let mut nested = Option.none<Span>()
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if isConformanceHeader(hir, &declarations[at]) {
        if topLevel(&declarations[at]) {
          run Vector.append<usize>(&mut ordinals, at)
        } else {
          nested = Option.some<Span>(Module.span(hir, declarations[at].header))
        }
      }
      at = at + usize.ONE
    }
  }
  drop answer
  // A module-level conditional group is being removed from the language; until then an `impl`
  // inside one cannot be counted as present or absent.
  if let Option<Span>.Some {value: grouped} = move nested {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, grouped),
      move dependencies,
    )
  }
  let mut heads = Vector.make<Shared<ImplementationHead>>()
  let listed = Vector.asSlice<usize>(&ordinals)
  let mut at = usize.ZERO
  while at < listed.length {
    let headKey = Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: listed[at],
      member: usize.ZERO,
      external: false,
    }
    let child = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      headKey,
      Span.make(usize.ZERO, usize.ZERO),
    )
    let head = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &child,
      headOf,
    )
    if let Option<Shared<ImplementationHead>>.Some {value} = move head {
      run Vector.append<Shared<ImplementationHead>>(&mut heads, move value)
    } else {
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &child,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return memberRejected(move diagnostic, move dependencies)
      }
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.Implementations {heads: move heads}, move dependencies)
}

// Whether a head's provider is the nominal `owner`.
fn headProvides(head: &ImplementationHead, owner: &DeclarationId) -> bool {
  return Shared.with<Type, bool>(
    &head.provider,
    fn(provider: &Type) -> bool {
      return match & provider.* {
        Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, owner)
        _ => false
      }
    },
  )
}

// Whether an owner's own associated items already claim `name`.
fn ownerClaims(answer: &Result<Answer, NoRejection>, name: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let listed = Vector.asSlice<Member>(&members)
        let mut at = usize.ZERO
        while at < listed.length {
          if let Option<Bytes>.Some {value: spelled} = &listed[at].name {
            if same(Bytes.asSlice(&spelled), name) {
              return true
            }
          }
          at = at + usize.ONE
        }
        return false
      }
      Outcome.Success {value: Value.Operations {operations}} => {
        let listed = Vector.asSlice<Shared<DeclarationId>>(&operations)
        let mut at = usize.ZERO
        while at < listed.length {
          if Shared.with<DeclarationId, bool>(
            &listed[at],
            fn(operation: &DeclarationId) -> bool {
              return DeclarationId.named(operation, name)
            },
          ) {
            return true
          }
          at = at + usize.ONE
        }
        return false
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// One written member of an inherent `impl`, with whether it can be an associated member at all.
struct InherentCandidate {
  ordinal: usize
  name: Bytes
  span: Span
  admissible: bool
}

effect fn inherentCandidates(resolver: &mut Resolver, module: &ModuleId, implementation: usize) -> Vector<
  InherentCandidate,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut candidates = Vector.make<InherentCandidate>()
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if enclosedBy(&declarations[at], implementation) {
        let written = Module.node(hir, declarations[at].header)
        let mut name = HirRef.absent()
        // A mapping only makes sense in a conformance, and a Drop hook belongs to `impl Drop`.
        let mut admissible = false
        if let Node.FunctionHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
          admissible = true
        }
        if let Node.ImplAliasHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
        }
        if name.present {
          if let Node.Name {text} = Module.node(hir, name.id) {
            let spelling = Module.text(hir, text)
            if same(spelling, b"drop") {
              admissible = false
            }
            run Vector.append<InherentCandidate>(
              &mut candidates,
              InherentCandidate {
                ordinal: at,
                name: run Bytes.copy(spelling),
                span: Module.span(hir, declarations[at].header),
                admissible: admissible,
              },
            )
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return move candidates
}

effect fn rejectRelated(module: &ModuleId, span: Span, related: Option<DeclarationId>) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  let mut path = Vector.make<Shared<DeclarationId>>()
  if let Option<DeclarationId>.Some {value} = move related {
    run Vector.append<Shared<DeclarationId>>(&mut path, run Shared.make<DeclarationId>(move value))
  }
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.Collision,
      module: run ModuleId.copy(module),
      span: span,
      related: Option.none<Span>(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
}

effect fn resolveInherentMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let found = run declarationAt(&mut resolver.*, &module, key.declaration)
  let mut claimedBy = Family.Members
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut generatedValue = false
  let mut isOwner = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    isOwner = match value.header {
      Node.StructHeader {..} => true
      Node.TupleHeader {..} => true
      Node.UnionHeader {..} => true
      Node.EnumHeader {..} => true
      Node.ServiceHeader {..} => true
      Node.InterfaceHeader {..} => true
      _ => false
    }
    if isContractHeader(value.header) {
      claimedBy = Family.Operations
    }
    if let Node.EnumHeader {..} = value.header {
      generatedValue = true
    }
  }
  let ownerId = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isOwner {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.NotType, span),
      move dependencies,
    )
  }
  let claimsKey = Key {
    family: claimedBy,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let claims = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, claimsKey, span)
  if Shared.with<Result<Answer, NoRejection>, bool>(&claims, hasRejection) {
    let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &claims,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return memberRejected(move diagnostic, move dependencies)
    }
  }
  // Only this module can declare the owner's inherent members; a rejected head publishes none.
  let mut implementations = Vector.make<usize>()
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if isImplementationHeader(hir, &declarations[at]) && !isConformanceHeader(
        hir,
        &declarations[at],
      ) && topLevel(&declarations[at]) {
        run Vector.append<usize>(&mut implementations, at)
      }
      at = at + usize.ONE
    }
  }
  drop answer
  let mut candidates = Vector.make<InherentCandidate>()
  let listed = Vector.asSlice<usize>(&implementations)
  let mut at = usize.ZERO
  while at < listed.length {
    let headKey = Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: listed[at],
      member: usize.ZERO,
      external: false,
    }
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, headKey, span)
    let head = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &child,
      headOf,
    )
    if let Option<Shared<ImplementationHead>>.Some {value} = move head {
      let owned = Shared.with<ImplementationHead, bool>(
        &value,
        fn(implementation: &ImplementationHead) -> bool {
          return headProvides(implementation, &ownerId)
        },
      )
      if owned {
        let written = run inherentCandidates(&mut resolver.*, &module, listed[at])
        let entries = Vector.asSlice<InherentCandidate>(&written)
        let mut entryAt = usize.ZERO
        while entryAt < entries.length {
          run Vector.append<InherentCandidate>(
            &mut candidates,
            InherentCandidate {
              ordinal: entries[entryAt].ordinal,
              name: run Bytes.copy(Bytes.asSlice(&entries[entryAt].name)),
              span: entries[entryAt].span,
              admissible: entries[entryAt].admissible,
            },
          )
          entryAt = entryAt + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  let mut members = Vector.make<Shared<DeclarationId>>()
  let mut rejected = Vector.make<RejectedMember>()
  let all = Vector.asSlice<InherentCandidate>(&candidates)
  let mut candidateAt = usize.ZERO
  while candidateAt < all.length {
    let name = Bytes.asSlice(&all[candidateAt].name)
    let claimed = Shared.with<Result<Answer, NoRejection>, bool>(
      &claims,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return ownerClaims(value, name)
      },
    ) || (generatedValue && same(name, b"value"))
    let mut other = usize.MAX
    let mut otherAt = usize.ZERO
    while otherAt < all.length {
      if otherAt != candidateAt && same(Bytes.asSlice(&all[otherAt].name), name) {
        other = all[otherAt].ordinal
      }
      otherAt = otherAt + usize.ONE
    }
    let identity = run declarationAt(&mut resolver.*, &module, all[candidateAt].ordinal)
    if let Option<DeclarationId>.Some {value: declared} = move identity {
      let member = run Shared.make<DeclarationId>(move declared)
      if !all[candidateAt].admissible || claimed {
        run Vector.append<RejectedMember>(
          &mut rejected,
          RejectedMember {
            declaration: move member,
            rejection: run reject(
              &resolver.*,
              &module,
              RejectionCode.InvalidInherentMember,
              all[candidateAt].span,
            ),
          },
        )
      } else if other != usize.MAX {
        let related = run declarationAt(&mut resolver.*, &module, other)
        run Vector.append<RejectedMember>(
          &mut rejected,
          RejectedMember {
            declaration: move member,
            rejection: run rejectRelated(&module, all[candidateAt].span, move related),
          },
        )
      } else {
        run Vector.append<Shared<DeclarationId>>(&mut members, move member)
      }
    }
    candidateAt = candidateAt + usize.ONE
  }
  return memberSuccess(
    Value.InherentMembers {members: move members, rejected: move rejected},
    move dependencies,
  )
}

// The interned ordinal of the module that declares a nominal type, if this store knows it.
fn declaringModuleOrdinal(resolver: &Resolver, value: &Shared<Type>) -> usize {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  let mut at = usize.ZERO
  while at < modules.length {
    let candidate = &modules[at]
    if Shared.with<Type, bool>(
      value,
      fn(applied: &Type) -> bool {
        return match & applied.* {
          Type.Nominal {declaration, ..} => ModuleId.equals(
            DeclarationId.moduleId(&declaration),
            candidate,
          )
          _ => false
        }
      },
    ) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Whether two providers have the same owner: one nominal declaration, or one foundational spelling.
fn sameProviderOwner(left: &Type, right: &Type) -> bool {
  return match & left.* {
    Type.Nominal {declaration, ..} => match & right.* {
      Type.Nominal {declaration: other, ..} => DeclarationId.equals(&declaration, &other)
      _ => false
    }
    Type.Primitive {name} => match & right.* {
      Type.Primitive {name: other} => same(Bytes.asSlice(&name), Bytes.asSlice(&other))
      _ => false
    }
    Type.String {..} => match & right.* {
      Type.String {..} => true
      _ => false
    }
    Type.Unit => match & right.* {
      Type.Unit => true
      _ => false
    }
    _ => false
  }
}

fn providerOwnerWith(left: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(other: &Type) -> bool {
      return sameProviderOwner(left, other)
    },
  )
}

fn contractIs(applied: &Type, contract: &DeclarationId) -> bool {
  return match & applied.* {
    Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, contract)
    _ => false
  }
}

// Whether a conformance head implements `contract` for a provider with `provider`'s owner.
fn headMatches(head: &ImplementationHead, contract: &DeclarationId, provider: &Shared<Type>) -> bool {
  if let Option<Shared<Type>>.Some {value: applied} = &head.contract {
    if !Shared.with<Type, bool>(
      &applied,
      fn(found: &Type) -> bool {
        return contractIs(found, contract)
      },
    ) {
      return false
    }
    return sameProviderShared(&head.provider, provider)
  }
  return false
}

fn typeAddress(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

// Owner equality for two type handles. A nominal handle is often the one cached identity answer,
// and a shared handle cannot be borrowed inside its own borrow, so one allocation compares first.
fn sameProviderShared(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared.with<Type, usize>(left, typeAddress) == Shared.with<Type, usize>(right, typeAddress) {
    return true
  }
  return Shared.with<Type, bool>(
    left,
    fn(found: &Type) -> bool {
      return providerOwnerWith(found, right)
    },
  )
}

effect fn resolveConformanceHeads(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let applications = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let provider = Shared.clone<Type>(&applications[key.name])
  let written = run header(&mut resolver.*, &module, key.declaration)
  let found = run declarationAt(&mut resolver.*, &module, key.declaration)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut isService = false
  let mut isContract = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    isContract = isContractHeader(value.header)
    if let Node.ServiceHeader {..} = value.header {
      isService = true
    }
  }
  let contract = match move found {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  if !isContract {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidBound, span),
      move dependencies,
    )
  }
  // IMPL-004: only the contract's module and a nominal provider's module can own the conformance;
  // a service conformance lives with its provider. No other module is read.
  let mut modules = Vector.make<usize>()
  if !isService {
    run Vector.append<usize>(&mut modules, key.module)
  }
  let providerModule = declaringModuleOrdinal(&resolver.*, &provider)
  // A nominal provider's module is always read by the store that resolved it; any other provider
  // type did not come from this store and has no observable owner set.
  if providerModule == usize.MAX && Shared.with<Type, bool>(&provider, isNominalType) {
    fail InvalidModulePath {}
  }
  if providerModule != usize.MAX && (isService || providerModule != key.module) {
    run Vector.append<usize>(&mut modules, providerModule)
  }
  let mut heads = Vector.make<Shared<ImplementationHead>>()
  let permitted = Vector.asSlice<usize>(&modules)
  let mut at = usize.ZERO
  while at < permitted.length {
    let listKey = Key {
      family: Family.Implementations,
      module: permitted[at],
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let listed = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, listKey, span)
    let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &listed,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
      return memberRejected(move diagnostic, move dependencies)
    }
    let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, implementationCount)
    let mut headAt = usize.ZERO
    while headAt < count {
      let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
          return implementationAt(answer, headAt)
        },
      )
      if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
        let relevant = Shared.with<ImplementationHead, bool>(
          &head,
          fn(implementation: &ImplementationHead) -> bool {
            return headMatches(implementation, &contract, &provider)
          },
        )
        if relevant {
          run Vector.append<Shared<ImplementationHead>>(&mut heads, move head)
        }
      }
      headAt = headAt + usize.ONE
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.ConformanceHeads {heads: move heads}, move dependencies)
}

fn implementationCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Implementations {heads}} => Vector.length<
        Shared<ImplementationHead>,
      >(&heads)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn implementationAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<
  Shared<ImplementationHead>,
> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Implementations {heads}} = &value.outcome {
      let listed = Vector.asSlice<Shared<ImplementationHead>>(&heads)
      if at < listed.length {
        return Option.some<Shared<ImplementationHead>>(
          Shared.clone<ImplementationHead>(&listed[at]),
        )
      }
    }
  }
  return Option.none<Shared<ImplementationHead>>()
}

// The applied head of one conformance, with what coherence reads from it.
struct HeadTerms {
  declaration: Shared<DeclarationId>
  contract: Shared<Type>
  provider: Shared<Type>
  span: Span
  bounded: bool
  typeBinders: usize
  lifetimeBinders: usize
  rowBinders: usize
}

// The head terms of a conformance; absent for an inherent or sealed-property head.
fn headTerms(head: &ImplementationHead) -> Option<HeadTerms> {
  if let Option<Shared<Type>>.Some {value: contract} = &head.contract {
    let constraints = Vector.asSlice<Constraint>(&head.binders.constraints)
    let bounded = constraints.length > usize.ZERO
    return Option.some<HeadTerms>(
      HeadTerms {
        declaration: Shared.clone<DeclarationId>(&head.declaration),
        contract: Shared.clone<Type>(&contract),
        provider: Shared.clone<Type>(&head.provider),
        span: head.span,
        bounded: bounded,
        typeBinders: Vector.length<Shared<Type>>(&head.binders.typeParameters),
        lifetimeBinders: Vector.length<Shared<Lifetime>>(&head.binders.lifetimeParameters),
        rowBinders: Vector.length<RowParameter>(&head.binders.rowParameters),
      },
    )
  }
  return Option.none<HeadTerms>()
}

fn copyTerms(terms: &HeadTerms) -> HeadTerms {
  return HeadTerms {
    declaration: Shared.clone<DeclarationId>(&terms.declaration),
    contract: Shared.clone<Type>(&terms.contract),
    provider: Shared.clone<Type>(&terms.provider),
    span: terms.span,
    bounded: terms.bounded,
    typeBinders: terms.typeBinders,
    lifetimeBinders: terms.lifetimeBinders,
    rowBinders: terms.rowBinders,
  }
}

fn headSpanOf(head: &ImplementationHead) -> Span {
  return head.span
}

fn headAddress(head: &ImplementationHead) -> usize {
  return Pointer.address<ImplementationHead>(Pointer.fromRef<ImplementationHead>(head))
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn declarationEqualsShared(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

// Whether two shared identities are equal; one allocation is never borrowed inside itself.
fn sameDeclarationShared(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return declarationEqualsShared(first, right)
    },
  )
}

fn termsBeforeBorrowed(
  left: &DeclarationId,
  right: &Shared<DeclarationId>,
  start: usize,
  otherStart: usize,
) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(compared: &DeclarationId) -> bool {
      let order = ModuleId.compare(DeclarationId.moduleId(left), DeclarationId.moduleId(compared))
      return order < 0 || (order == 0 && start < otherStart)
    },
  )
}

// The canonical order of conformance heads: the owning module's identity bytes, then the head's
// source position. Discovery, demand, and allocation order never take part.
fn termsBefore(first: &HeadTerms, second: &HeadTerms) -> bool {
  let start = first.span.start
  let otherStart = second.span.start
  return Shared.with<DeclarationId, bool>(
    &first.declaration,
    fn(left: &DeclarationId) -> bool {
      return termsBeforeBorrowed(left, &second.declaration, start, otherStart)
    },
  )
}

fn knownModuleOrdinal(resolver: &Resolver, module: &ModuleId) -> usize {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn headConstraintCount(head: &ImplementationHead) -> usize {
  return Vector.length<Constraint>(&head.binders.constraints)
}

fn headWrittenBinders(head: &ImplementationHead) -> usize {
  return Vector.length<Span>(&head.binderSpans)
}

fn headBinderCount(head: &ImplementationHead) -> usize {
  return Vector.length<Shared<Type>>(&head.binders.typeParameters) + Vector.length<Shared<Lifetime>>(
    &head.binders.lifetimeParameters,
  ) + Vector.length<RowParameter>(&head.binders.rowParameters)
}

fn headBinderSpanAt(head: &ImplementationHead, at: usize) -> Span {
  let spans = Vector.asSlice<Span>(&head.binderSpans)
  if at < spans.length {
    return spans[at]
  }
  return head.span
}

// One written conformance bound of an implementation, with its anchor.
struct HeadBound {
  provider: Shared<Type>
  contract: Shared<Type>
  span: Span
}

fn headBoundAt(head: &ImplementationHead, at: usize) -> Option<HeadBound> {
  let constraints = Vector.asSlice<Constraint>(&head.binders.constraints)
  let spans = Vector.asSlice<Span>(&head.boundSpans)
  if let Constraint.Conforms {provider, contract} = &constraints[at] {
    let mut span = head.span
    if at < spans.length {
      span = spans[at]
    }
    return Option.some<HeadBound>(
      HeadBound {
        provider: Shared.clone<Type>(&provider),
        contract: Shared.clone<Type>(&contract),
        span: span,
      },
    )
  }
  return Option.none<HeadBound>()
}

// Whether two applications apply the same nominal declaration.
fn sameNominalBorrowed(first: &Type, right: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(
    right,
    fn(second: &Type) -> bool {
      if let Type.Nominal {declaration, ..} = &first.* {
        if let Type.Nominal {declaration: other, ..} = &second.* {
          return DeclarationId.equals(&declaration, &other)
        }
      }
      return false
    },
  )
}

fn sameNominal(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared.with<Type, usize>(left, typeAddress) == Shared.with<Type, usize>(right, typeAddress) {
    return true
  }
  return Shared.with<Type, bool>(
    left,
    fn(first: &Type) -> bool {
      return sameNominalBorrowed(first, right)
    },
  )
}

// IMPL-008: a bound's provider must be a strict structural part of the conformance provider, the
// bound may not repeat an open parameter more often than the head does, and a bound on the same
// interface may not rewrite an argument the head fixes. A bound provider is always one of the
// implementation's parameters and every provider is nominal, so a present parameter is a strict
// part. Termination follows from the declaration alone; no proof is attempted.
effect fn terminationStep(
  required: &HeadBound,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  implementation: &DeclarationId,
  binderCount: usize,
) -> Option<TerminationStep> ! OutOfMemoryError ? &mut Allocator {
  let subject = Shared.with<Type, usize>(
    &required.provider,
    fn(value: &Type) -> usize {
      return Type.parameterOrdinalOf(value, implementation)
    },
  )
  if subject == usize.MAX || Type.occurrences(provider, implementation, subject) == usize.ZERO {
    return Option.some<TerminationStep>(TerminationStep.Peer)
  }
  let mut ordinal = usize.ZERO
  while ordinal < binderCount {
    let declared = Type.occurrences(contract, implementation, ordinal) + Type.occurrences(
      provider,
      implementation,
      ordinal,
    )
    let demanded = Type.occurrences(&required.provider, implementation, ordinal) + Type.occurrences(
      &required.contract,
      implementation,
      ordinal,
    )
    if demanded > declared {
      return Option.some<TerminationStep>(TerminationStep.DuplicatedParameter)
    }
    ordinal = ordinal + usize.ONE
  }
  if sameNominal(&required.contract, contract) && run Type.changesFixedArgument(
    contract,
    &required.contract,
    implementation,
  ) {
    return Option.some<TerminationStep>(TerminationStep.ChangedFixedArgument)
  }
  return Option.none<TerminationStep>()
}

effect fn rejectTermination(module: &ModuleId, span: Span, step: TerminationStep) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.NonterminatingConformance,
      module: run ModuleId.copy(module),
      span: span,
      related: Option.none<Span>(),
      path: Vector.make<Shared<DeclarationId>>(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: step,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
}

// A conflict is reported at the primary head, with the primary and then the related declaration.
effect fn rejectConflict(
  module: &ModuleId,
  code: RejectionCode,
  primary: &HeadTerms,
  related: &HeadTerms,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut path = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(
    &mut path,
    Shared.clone<DeclarationId>(&primary.declaration),
  )
  run Vector.append<Shared<DeclarationId>>(
    &mut path,
    Shared.clone<DeclarationId>(&related.declaration),
  )
  return run Shared.make<Rejection>(
    Rejection {
      code: code,
      module: run ModuleId.copy(module),
      span: primary.span,
      related: Option.none<Span>(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.none<WitnessProblem>(),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
}

// Unifies both applications of two heads under one set of bindings.
effect fn headsUnify(
  first: &HeadTerms,
  second: &HeadTerms,
  variables: &[Shared<DeclarationId>],
  comparison: Comparison,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let mut lefts = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut lefts, Shared.clone<Type>(&first.contract))
  run Vector.append<Shared<Type>>(&mut lefts, Shared.clone<Type>(&first.provider))
  let mut rights = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut rights, Shared.clone<Type>(&second.contract))
  run Vector.append<Shared<Type>>(&mut rights, Shared.clone<Type>(&second.provider))
  let mut bindings = Vector.make<Binding>()
  return run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&lefts),
    Vector.asSlice<Shared<Type>>(&rights),
    variables,
    comparison,
    &mut bindings,
  )
}

// Duplicate identity compares the full head under one positional bijection of the impl binders.
// This is independent of one-sided exact matching, which deliberately leaves open sets undecided.
effect fn exactlyEquivalent(first: &HeadTerms, second: &HeadTerms) -> bool
! OutOfMemoryError
? &mut Allocator {
  if first.typeBinders != second.typeBinders || first.lifetimeBinders != second.lifetimeBinders || first.rowBinders != second.rowBinders {
    return false
  }
  let count = first.typeBinders + first.lifetimeBinders + first.rowBinders
  return run Type.alphaEquivalent(
    &first.contract,
    &first.provider,
    &second.contract,
    &second.provider,
    count,
  )
}

fn bucketCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ConformanceHeads {heads}} => Vector.length<
        Shared<ImplementationHead>,
      >(&heads)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn bucketAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<ImplementationHead>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ConformanceHeads {heads}} = &value.outcome {
      let listed = Vector.asSlice<Shared<ImplementationHead>>(&heads)
      if at < listed.length {
        return Option.some<Shared<ImplementationHead>>(
          Shared.clone<ImplementationHead>(&listed[at]),
        )
      }
    }
  }
  return Option.none<Shared<ImplementationHead>>()
}

fn containsOrdinal(values: &Vector<usize>, ordinal: usize) -> bool {
  let listed = Vector.asSlice<usize>(values)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Coherence of one conformance `impl`, decided before any applicability or bound proof.
//
// IMPL-006: every written parameter occurs in the interface application or the provider. IMPL-008:
// every bound descends structurally. IMPL-007: no other head of the complete owner bucket could
// name the same goal once lifetimes are erased; bounds are never consulted, and no head wins by
// source or demand order. A conflict is one fixed pair: the canonically later head is primary, the
// earliest conflicting other head related, so every head of the pair reports the same rejection.
// Duplicate names only two unbounded heads that are exact renamings of each other. An open set the
// projection cannot decide leaves the head Unsupported, never a conflict or a success.
effect fn resolveCoherence(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &headAnswer,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return memberRejected(move diagnostic, move dependencies)
      }
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let span = Shared.with<ImplementationHead, Span>(&head, headSpanOf)
  let found = Shared.with<ImplementationHead, Option<HeadTerms>>(&head, headTerms)
  // Inherent and sealed-property heads have no conformance goal to be coherent about.
  let terms = match move found {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  let identity = run declarationAt(&mut resolver.*, &module, key.declaration)
  let implementation = match move identity {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  let mut types = Vector.make<usize>()
  let mut regions = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(&terms.contract, &implementation, &mut types, &mut regions, &mut rows)
  run Type.collectOwned(&terms.provider, &implementation, &mut types, &mut regions, &mut rows)
  let written = Shared.with<ImplementationHead, usize>(&head, headWrittenBinders)
  let mut binder = usize.ZERO
  while binder < written {
    if !containsOrdinal(&types, binder) && !containsOrdinal(&regions, binder) && !containsOrdinal(
      &rows,
      binder,
    ) {
      let anchor = Shared.with<ImplementationHead, Span>(
        &head,
        fn(value: &ImplementationHead) -> Span {
          return headBinderSpanAt(value, binder)
        },
      )
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnconstrainedImplParameter, anchor),
        move dependencies,
      )
    }
    binder = binder + usize.ONE
  }
  let binderCount = Shared.with<ImplementationHead, usize>(&head, headBinderCount)
  let constraints = Shared.with<ImplementationHead, usize>(&head, headConstraintCount)
  let mut bound = usize.ZERO
  while bound < constraints {
    let declared = Shared.with<ImplementationHead, Option<HeadBound>>(
      &head,
      fn(value: &ImplementationHead) -> Option<HeadBound> {
        return headBoundAt(value, bound)
      },
    )
    if let Option<HeadBound>.Some {value: required} = move declared {
      let step = run terminationStep(
        &required,
        &terms.contract,
        &terms.provider,
        &implementation,
        binderCount,
      )
      if let Option<TerminationStep>.Some {value: reason} = move step {
        return memberRejected(
          run rejectTermination(&module, required.span, reason),
          move dependencies,
        )
      }
    }
    bound = bound + usize.ONE
  }
  let contractModule = declaringModuleOrdinal(&resolver.*, &terms.contract)
  if contractModule == usize.MAX {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let contractModuleId = run resolvedModule(&resolver.*, contractModule)
  let located = run ordinalOfProvider(&mut resolver.*, &contractModuleId, &terms.contract)
  let contractOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
  }
  let bucketKey = Key {
    family: Family.ConformanceHeads,
    module: contractModule,
    name: run internApplication(&mut resolver.*, &terms.provider),
    declaration: contractOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let bucket = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, bucketKey, span)
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bucket,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
    return memberRejected(move diagnostic, move dependencies)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
  let mut conflicts = Vector.make<HeadTerms>()
  let mut undecided = false
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &bucket,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return bucketAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: other} = move candidate {
      let otherTerms = Shared.with<ImplementationHead, Option<HeadTerms>>(&other, headTerms)
      if let Option<HeadTerms>.Some {value: competing} = move otherTerms {
        if !sameDeclarationShared(&competing.declaration, &terms.declaration) {
          let mut variables = Vector.make<Shared<DeclarationId>>()
          run Vector.append<Shared<DeclarationId>>(
            &mut variables,
            Shared.clone<DeclarationId>(&terms.declaration),
          )
          run Vector.append<Shared<DeclarationId>>(
            &mut variables,
            Shared.clone<DeclarationId>(&competing.declaration),
          )
          let overlap = run headsUnify(
            &terms,
            &competing,
            Vector.asSlice<Shared<DeclarationId>>(&variables),
            Comparison.Projection,
          )
          match & overlap {
            Unification.Unified => {
              run Vector.append<HeadTerms>(&mut conflicts, move competing)
            }
            Unification.Undetermined {..} => {
              undecided = true
            }
            Unification.Distinct => {}
          }
        }
      }
    }
    at = at + usize.ONE
  }
  let others = Vector.asSlice<HeadTerms>(&conflicts)
  if others.length == usize.ZERO {
    if undecided {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        move dependencies,
      )
    }
    return memberSuccess(Value.Coherent, move dependencies)
  }
  let mut least = usize.ZERO
  let mut position = usize.ONE
  while position < others.length {
    if termsBefore(&others[position], &others[least]) {
      least = position
    }
    position = position + usize.ONE
  }
  let mut primary = copyTerms(&terms)
  let mut related = copyTerms(&others[least])
  if termsBefore(&terms, &others[least]) {
    primary = copyTerms(&others[least])
    related = copyTerms(&terms)
  }
  let mut code = RejectionCode.OverlappingConformance
  if !primary.bounded && !related.bounded && run exactlyEquivalent(&primary, &related) {
    code = RejectionCode.DuplicateConformance
  }
  let primaryModule = Shared.with<DeclarationId, usize>(
    &primary.declaration,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  let mut anchor = run ModuleId.copy(&module)
  if primaryModule != usize.MAX {
    anchor = run resolvedModule(&resolver.*, primaryModule)
  }
  return memberRejected(run rejectConflict(&anchor, code, &primary, &related), move dependencies)
}

// One member written in a conformance `impl`, before any mapped target is resolved.
struct WrittenMember {
  ordinal: usize
  name: Bytes
  span: Span
  mapped: HirRef
}

effect fn writtenMembers(resolver: &mut Resolver, module: &ModuleId, implementation: usize) -> Vector<
  WrittenMember,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut members = Vector.make<WrittenMember>()
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      if enclosedBy(&declarations[at], implementation) {
        let written = Module.node(hir, declarations[at].header)
        let mut name = HirRef.absent()
        let mut mapped = HirRef.absent()
        if let Node.FunctionHeader {name: spelled, ..} = written {
          name = HirRef.of(spelled)
        }
        if let Node.ImplAliasHeader {name: spelled, target, ..} = written {
          name = HirRef.of(spelled)
          mapped = HirRef.of(target)
        }
        if name.present {
          if let Node.Name {text} = Module.node(hir, name.id) {
            run Vector.append<WrittenMember>(
              &mut members,
              WrittenMember {
                ordinal: at,
                name: run Bytes.copy(Module.text(hir, text)),
                span: Module.span(hir, declarations[at].header),
                mapped: mapped,
              },
            )
          }
        }
      }
      at = at + usize.ONE
    }
  }
  return move members
}

// Whether a declaration header is a named function.
effect fn isFunctionDeclaration(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run header(&mut resolver.*, module, ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.FunctionHeader {..} = value.header {
      return true
    }
  }
  return false
}

// Resolves a mapping's right side from its written path only: a function of this module or of an
// imported namespace, or an inherent member published by a named owner. No body is read.
effect fn mappedTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  written: HirId,
) -> Result<Shared<DeclarationId>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let parsed = run path(&mut resolver.*, module, written)
  let segments = Vector.asSlice<Bytes>(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 {
    return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, parsed.span),
    )
  }
  let first = Bytes.asSlice(&segments[usize.ZERO])
  // `Intrinsic` is the sealed compiler namespace; no intrinsic operation is mapped in this unit.
  if same(first, b"Intrinsic") {
    return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, parsed.span),
    )
  }
  let mut functionModule = moduleOrdinal
  let mut functionName = first
  let mut external = false
  if segments.length == 2 {
    let named = run select(&mut resolver.*, module, first, false)
    functionName = Bytes.asSlice(&segments[usize.ONE])
    if named.count == usize.ONE && named.kind == CandidateKind.ImportModule {
      let importKey = Key {
        family: Family.Import,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: named.declaration,
        member: usize.MAX,
        external: false,
      }
      let imported = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        importKey,
        parsed.span,
      )
      let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
        &imported,
        selectedImport,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
        return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(move diagnostic)
      }
      if let Option<usize>.Some {value: targetModule} = move binding.module {
        functionModule = targetModule
        external = true
      }
    } else {
      // A nominal qualifier reaches only the owner's published inherent members.
      let selectedOwner = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        first,
        false,
        parsed.span,
        RejectionCode.NotType,
      )
      let ownerDeclaration = match move selectedOwner {
        Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
        Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(move error)
        }
      }
      let membersKey = Key {
        family: Family.InherentMembers,
        module: ownerDeclaration.module,
        name: usize.ZERO,
        declaration: ownerDeclaration.ordinal,
        member: usize.ZERO,
        external: false,
      }
      let listed = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        membersKey,
        parsed.span,
      )
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &listed,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(move diagnostic)
      }
      let lookup = Shared.with<Result<Answer, NoRejection>, InherentLookup>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
          return inherentLookup(answer, functionName)
        },
      )
      let InherentLookup {published, rejected} = move lookup
      if let Option<Shared<DeclarationId>>.Some {value} = move published {
        return Result.succeed<Shared<DeclarationId>, Shared<Rejection>>(move value)
      }
      // An unpublished member keeps its own rejection; no other member is chosen.
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
        return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(move diagnostic)
      }
      return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.UnknownMember, parsed.span),
      )
    }
  }
  let selected = run selectDeclaration(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    functionModule,
    module,
    functionName,
    external,
    parsed.span,
    RejectionCode.NotCallable,
  )
  let target = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(move error)
    }
  }
  let targetModule = run resolvedModule(&resolver.*, target.module)
  if !run isFunctionDeclaration(&mut resolver.*, &targetModule, target.ordinal) {
    return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.NotCallable, parsed.span),
    )
  }
  let identity = run declarationAt(&mut resolver.*, &targetModule, target.ordinal)
  if let Option<DeclarationId>.Some {value} = move identity {
    return Result.succeed<Shared<DeclarationId>, Shared<Rejection>>(
      run Shared.make<DeclarationId>(move value),
    )
  }
  return Result.failResult<Shared<DeclarationId>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, parsed.span),
  )
}

effect fn resolveImplementationMembers(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  let mut conformance = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {target, ..} = value.header {
      conformance = target.present
    }
  }
  // Inherent members are reached through their owner; this list serves conformances.
  if !conformance {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let head = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, headKey, span)
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &head,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
    return memberRejected(move diagnostic, move dependencies)
  }
  let listed = run writtenMembers(&mut resolver.*, &module, key.declaration)
  let entries = Vector.asSlice<WrittenMember>(&listed)
  let mut members = Vector.make<ImplementationMember>()
  let mut at = usize.ZERO
  while at < entries.length {
    let mut before = usize.ZERO
    while before < at {
      if same(Bytes.asSlice(&entries[before].name), Bytes.asSlice(&entries[at].name)) {
        let earlier = run declarationAt(&mut resolver.*, &module, entries[before].ordinal)
        return memberRejected(
          run rejectRelated(&module, entries[at].span, move earlier),
          move dependencies,
        )
      }
      before = before + usize.ONE
    }
    let identity = run declarationAt(&mut resolver.*, &module, entries[at].ordinal)
    if let Option<DeclarationId>.Some {value: declared} = move identity {
      let declaration = run Shared.make<DeclarationId>(move declared)
      if entries[at].mapped.present {
        let resolved = run mappedTarget(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies,
          key.module,
          &module,
          entries[at].mapped.id,
        )
        match move resolved {
          Result<Shared<DeclarationId>, Shared<Rejection>>.Success {value: target} => {
            run Vector.append<ImplementationMember>(
              &mut members,
              ImplementationMember.Mapped {
                declaration: move declaration,
                span: entries[at].span,
                target: move target,
              },
            )
          }
          Result<Shared<DeclarationId>, Shared<Rejection>>.Failure {error} => {
            return memberRejected(move error, move dependencies)
          }
        }
      } else {
        run Vector.append<ImplementationMember>(
          &mut members,
          ImplementationMember.Inline {declaration: move declaration, span: entries[at].span},
        )
      }
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.ImplementationMembers {members: move members}, move dependencies)
}

// A nominal or alias name written in a field type. Its application arguments are scanned only once
// the target is known, because each argument's kind follows the target's binder at that position.
struct FieldReference {
  path: HirId
  span: Span
  arguments: HirRef
  writtenLifetimes: bool
}

impl Copy for FieldReference {}

// What one declaration's written field types (or an alias's target) contribute before any name
// is resolved: omitted borrow, slice, and `string` lifetimes, and named references.
struct FieldScan {
  omitted: usize
  references: Vector<FieldReference>
}

fn writesLifetime(hir: &Module, arguments: Range) -> bool {
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Node.Lifetime {..} = Module.node(hir, Module.child(hir, arguments, at)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Scans one written type. Borrowed positions, `string`, omitted callable and Effect environments,
// the success and failure types of an Effect, and named references can generate lifetimes. Own
// binders and primitives contribute none, and a callable's parameters and result are quantified per
// invocation. Nothing here resolves a name.
effect fn scanFieldType(hir: &Module, id: HirId, binders: &[Binder], scan: &mut FieldScan) -> ()
! OutOfMemoryError
? &mut Allocator {
  let node = Module.node(hir, id)
  if let Node.ReferenceType {referent, lifetime, ..} = node {
    if !lifetime.present {
      scan.omitted = scan.omitted + usize.ONE
    }
    return run scanFieldType(hir, referent, binders, &mut scan.*)
  }
  if let Node.SliceType {element, lifetime, ..} = node {
    if !lifetime.present {
      scan.omitted = scan.omitted + usize.ONE
    }
    return run scanFieldType(hir, element, binders, &mut scan.*)
  }
  if let Node.PointerType {pointee, ..} = node {
    return run scanFieldType(hir, pointee, binders, &mut scan.*)
  }
  if let Node.FixedArrayType {element, ..} = node {
    return run scanFieldType(hir, element, binders, &mut scan.*)
  }
  if let Node.UnionType {members} = node {
    let mut at = usize.ZERO
    while at < members.length {
      run scanFieldType(hir, Module.child(hir, members, at), binders, &mut scan.*)
      at = at + usize.ONE
    }
    return ()
  }
  if let Node.CallableType {environment, ..} = node {
    if !environment.present {
      scan.omitted = scan.omitted + usize.ONE
    }
    return ()
  }
  let mut named = HirRef.absent()
  let mut hasMode = false
  let mut typeArguments = HirRef.absent()
  if let Node.NamedType {path, hasMode: moded, ..} = node {
    named = HirRef.of(path)
    hasMode = moded
  }
  if let Node.AppliedType {target, arguments: written} = node {
    if let Node.NamedType {path, hasMode: moded, ..} = Module.node(hir, target) {
      named = HirRef.of(path)
      hasMode = moded
    }
    if let Node.TypeArguments {..} = Module.node(hir, written) {
      typeArguments = HirRef.of(written)
    }
  }
  if !named.present {
    return ()
  }
  let mut effectType = false
  if let Node.Path {segments} = Module.node(hir, named.id) {
    if segments.length == usize.ONE {
      if let Node.Name {text} = Module.node(hir, Module.child(hir, segments, usize.ZERO)) {
        let spelling = Module.text(hir, text)
        if hasBinder(binders, spelling) || same(spelling, b"never") || primitive(spelling) {
          return ()
        }
        if same(spelling, b"string") {
          if !typeArguments.present || !argumentsWriteLifetime(hir, typeArguments.id) {
            scan.omitted = scan.omitted + usize.ONE
          }
          return ()
        }
        effectType = same(spelling, b"Effect")
      }
    }
  }
  // Only `Effect` takes a run mode; any other moded name is invalid where its member is demanded.
  if effectType {
    if typeArguments.present {
      if let Node.TypeArguments {arguments: supplied, environment, failures, requirements} = Module.node(
        hir,
        typeArguments.id,
      ) {
        if !environment.present {
          scan.omitted = scan.omitted + usize.ONE
        }
        let mut at = usize.ZERO
        while at < supplied.length {
          run scanFieldType(hir, Module.child(hir, supplied, at), binders, &mut scan.*)
          at = at + usize.ONE
        }
        if failures.present {
          run scanFieldType(hir, failures.id, binders, &mut scan.*)
        }
        if requirements.present {
          run scanRowSyntax(hir, requirements.id, binders, &mut scan.*)
        }
      }
    }
    return ()
  }
  if hasMode {
    return ()
  }
  run Vector.append<FieldReference>(
    &mut scan.references,
    FieldReference {
      path: named.id,
      span: Module.span(hir, id),
      arguments: typeArguments,
      writtenLifetimes: typeArguments.present && argumentsWriteLifetime(hir, typeArguments.id),
    },
  )
  return ()
}

fn argumentsWriteLifetime(hir: &Module, arguments: HirId) -> bool {
  if let Node.TypeArguments {arguments: supplied, ..} = Module.node(hir, arguments) {
    return writesLifetime(hir, supplied)
  }
  return false
}

// Scans a requirement row: only its capability types can carry lifetimes. A borrow in a row is an
// access marker, not a borrowed value; a row binder or `never` contributes nothing.
effect fn scanRowSyntax(hir: &Module, id: HirId, binders: &[Binder], scan: &mut FieldScan) -> ()
! OutOfMemoryError
? &mut Allocator {
  let node = Module.node(hir, id)
  if let Node.RequirementRow {members} = node {
    let mut at = usize.ZERO
    while at < members.length {
      run scanRowSyntax(hir, Module.child(hir, members, at), binders, &mut scan.*)
      at = at + usize.ONE
    }
    return ()
  }
  if let Node.UnionType {members} = node {
    let mut at = usize.ZERO
    while at < members.length {
      run scanRowSyntax(hir, Module.child(hir, members, at), binders, &mut scan.*)
      at = at + usize.ONE
    }
    return ()
  }
  if let Node.Requirement {capability, ..} = node {
    return run scanFieldType(hir, capability, binders, &mut scan.*)
  }
  if let Node.ReferenceType {referent, ..} = node {
    return run scanFieldType(hir, referent, binders, &mut scan.*)
  }
  if let Node.RequirementSelector {subject, ..} = node {
    return run scanFieldType(hir, subject, binders, &mut scan.*)
  }
  return ()
}

// Scans an application's arguments by the target's binder kinds: a type argument is a written type,
// a row argument is a requirement row, and a lifetime argument contributes nothing.
effect fn scanApplicationArguments(
  resolver: &mut Resolver,
  module: &ModuleId,
  arguments: HirId,
  target: &[Binder],
  binders: &[Binder],
) -> FieldScan ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut scan = FieldScan {omitted: usize.ZERO, references: Vector.make<FieldReference>()}
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    if let Node.TypeArguments {arguments: supplied, requirements, ..} = Module.node(hir, arguments) {
      // Arguments are consumed exactly as an application binds them: a lifetime binder takes a
      // written lifetime or elides without consuming one, and every other binder takes the next.
      let mut argumentAt = usize.ZERO
      let mut binderAt = usize.ZERO
      while binderAt < target.length && argumentAt < supplied.length {
        let argument = Module.child(hir, supplied, argumentAt)
        let isLifetime = match Module.node(hir, argument) {
          Node.Lifetime {..} => true
          _ => false
        }
        let kind = binderKind(&target[binderAt])
        if kind == GenericKind.Lifetime {
          if isLifetime {
            argumentAt = argumentAt + usize.ONE
          }
        } else {
          if kind == GenericKind.Requirement {
            run scanRowSyntax(hir, argument, binders, &mut scan)
          } else if !isLifetime {
            run scanFieldType(hir, argument, binders, &mut scan)
          }
          argumentAt = argumentAt + usize.ONE
        }
        binderAt = binderAt + usize.ONE
      }
      // Excess arguments are an arity error at the application; their types still name nothing here.
      while argumentAt < supplied.length {
        let argument = Module.child(hir, supplied, argumentAt)
        if let Node.Lifetime {..} = Module.node(hir, argument) {} else {
          run scanFieldType(hir, argument, binders, &mut scan)
        }
        argumentAt = argumentAt + usize.ONE
      }
      if requirements.present {
        run scanRowSyntax(hir, requirements.id, binders, &mut scan)
      }
    }
  }
  return move scan
}

// Scans a struct's, tuple's, or union's field types, or an alias's target, in written order.
effect fn scanDeclarationFields(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  binders: &[Binder],
) -> FieldScan ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut scan = FieldScan {omitted: usize.ZERO, references: Vector.make<FieldReference>()}
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      let written = Module.node(hir, declarations[ordinal].header)
      if let Node.StructHeader {fields, ..} = written {
        let mut at = usize.ZERO
        while at < fields.length {
          if let Node.Field {annotation, ..} = Module.node(hir, Module.child(hir, fields, at)) {
            run scanFieldType(hir, annotation, binders, &mut scan)
          }
          at = at + usize.ONE
        }
      }
      if let Node.TupleHeader {elements, ..} = written {
        let mut at = usize.ZERO
        while at < elements.length {
          run scanFieldType(hir, Module.child(hir, elements, at), binders, &mut scan)
          at = at + usize.ONE
        }
      }
      if let Node.UnionHeader {variants, ..} = written {
        let mut at = usize.ZERO
        while at < variants.length {
          if let Node.Variant {fields, ..} = Module.node(hir, Module.child(hir, variants, at)) {
            let mut fieldAt = usize.ZERO
            while fieldAt < fields.length {
              if let Node.Field {annotation, ..} = Module.node(
                hir,
                Module.child(hir, fields, fieldAt),
              ) {
                run scanFieldType(hir, annotation, binders, &mut scan)
              }
              fieldAt = fieldAt + usize.ONE
            }
          }
          at = at + usize.ONE
        }
      }
      if let Node.AliasHeader {target, ..} = written {
        run scanFieldType(hir, target, binders, &mut scan)
      }
    }
  }
  return move scan
}

fn isAggregateHeader(header: Node) -> bool {
  return match header {
    Node.StructHeader {..} => true
    Node.TupleHeader {..} => true
    Node.UnionHeader {..} => true
    _ => false
  }
}

effect fn countWrittenLifetimes(resolver: &mut Resolver, module: &ModuleId, arguments: Range) -> usize
! Cycle | OutOfMemoryError
? &mut Allocator {
  let mut count = usize.ZERO
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < arguments.length {
      if let Node.Lifetime {..} = Module.node(hir, Module.child(hir, arguments, at)) {
        count = count + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return count
}

fn writtenLifetimeCount(binders: &[Binder]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Lifetime {..} = &binders[at] {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

// Selects the declaration a field reference names, through module scope or one imported namespace.
effect fn fieldTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  reference: &FieldReference,
) -> Result<SelectedDeclaration, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let parsed = run path(&mut resolver.*, module, reference.path)
  let segments = Vector.asSlice<Bytes>(&parsed.segments)
  if !parsed.valid || segments.length == usize.ZERO || segments.length > 2 {
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, reference.span),
    )
  }
  if segments.length == usize.ONE {
    return run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&segments[usize.ZERO]),
      false,
      reference.span,
      RejectionCode.NotType,
    )
  }
  let namespace = Bytes.asSlice(&segments[usize.ZERO])
  // The sealed namespace's type families are not implemented yet, as in `qualifiedType`.
  if same(namespace, b"Intrinsic") {
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, reference.span),
    )
  }
  let selected = run select(&mut resolver.*, module, namespace, false)
  if selected.count != usize.ONE || selected.kind != CandidateKind.ImportModule {
    let mut code = RejectionCode.NotType
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownName
    } else if selected.count > usize.ONE {
      code = RejectionCode.Collision
    }
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
      run reject(&resolver.*, module, code, reference.span),
    )
  }
  let importKey = Key {
    family: Family.Import,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: selected.declaration,
    member: usize.MAX,
    external: false,
  }
  let imported = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    importKey,
    reference.span,
  )
  let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(&imported, selectedImport)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move binding.rejected {
    return Result.failResult<SelectedDeclaration, Shared<Rejection>>(move diagnostic)
  }
  if let Option<usize>.Some {value: targetModule} = move binding.module {
    // Arity needs only the declaration; whether this module may name it is checked where the
    // member's type is demanded.
    return run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      targetModule,
      module,
      Bytes.asSlice(&segments[usize.ONE]),
      false,
      reference.span,
      RejectionCode.NotType,
    )
  }
  return Result.failResult<SelectedDeclaration, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, reference.span),
  )
}

// The graph index of one declaration, appending it when first reached.
effect fn fieldNode(
  modules: &mut Vector<usize>,
  declarations: &mut Vector<usize>,
  module: usize,
  declaration: usize,
) -> usize ! OutOfMemoryError ? &mut Allocator {
  let known = Vector.length<usize>(&modules.*)
  let mut at = usize.ZERO
  while at < known {
    if Vector.get<usize>(&modules.*, at) == module && Vector.get<usize>(&declarations.*, at) == declaration {
      return at
    }
    at = at + usize.ONE
  }
  run Vector.append<usize>(&mut modules.*, module)
  run Vector.append<usize>(&mut declarations.*, declaration)
  return known
}

// Whether `from` reaches `to` along at least one edge of the field-reference graph.
effect fn reachesNode(
  from: usize,
  to: usize,
  sources: &Vector<usize>,
  targets: &Vector<usize>,
  nodes: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut visited = Vector.make<bool>()
  let mut at = usize.ZERO
  while at < nodes {
    run Vector.append<bool>(&mut visited, false)
    at = at + usize.ONE
  }
  let mut pending = Vector.make<usize>()
  run Vector.append<usize>(&mut pending, from)
  while Vector.length<usize>(&pending) > usize.ZERO {
    let taken = Vector.pop<usize>(&mut pending)
    let current = match move taken {
      Option<usize>.Some {value} => value
      Option<usize>.None => usize.MAX
    }
    let mut edge = usize.ZERO
    while edge < Vector.length<usize>(sources) {
      if Vector.get<usize>(sources, edge) == current {
        let target = Vector.get<usize>(targets, edge)
        if target == to {
          return true
        }
        if !Vector.get<bool>(&visited, target) {
          Vector.set<bool>(&mut visited, target, true)
          run Vector.append<usize>(&mut pending, target)
        }
      }
      edge = edge + usize.ONE
    }
  }
  return false
}

// The least generated-lifetime count of node `at`: its own omissions plus, per edge, the target's
// count. Only called once no positive node lies on a cycle, so the recursion is finite.
fn fieldCount(
  at: usize,
  omitted: &Vector<usize>,
  sources: &Vector<usize>,
  targets: &Vector<usize>,
  positive: &Vector<bool>,
  memo: &mut Vector<usize>,
) -> usize {
  if !Vector.get<bool>(positive, at) {
    return usize.ZERO
  }
  let known = Vector.get<usize>(&memo.*, at)
  if known != usize.MAX {
    return known
  }
  let mut total = Vector.get<usize>(omitted, at)
  let mut edge = usize.ZERO
  while edge < Vector.length<usize>(sources) {
    if Vector.get<usize>(sources, edge) == at {
      total = total + fieldCount(
        Vector.get<usize>(targets, edge),
        omitted,
        sources,
        targets,
        positive,
        &mut memo.*,
      )
    }
    edge = edge + usize.ONE
  }
  Vector.set<usize>(&mut memo.*, at, total)
  return total
}

// LIFE-003 for declarations: a struct, tuple, or union gains one lifetime parameter per lifetime its
// field types leave unwritten, including every lifetime of a nested nominal or alias used without
// written lifetimes. Only field type names are resolved, never member types, bodies, or layout.
// A cycle that would add lifetimes on every turn has no finite answer and stays unsupported.
effect fn resolveFieldLifetimes(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let root = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let rootHeader = run header(&mut resolver.*, &root, key.declaration)
  let mut rootSpan = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move rootHeader {
    rootSpan = value.span
  }
  let mut modules = Vector.make<usize>()
  let mut declarations = Vector.make<usize>()
  let mut omitted = Vector.make<usize>()
  let mut sources = Vector.make<usize>()
  let mut targets = Vector.make<usize>()
  let mut edgeSpans = Vector.make<Span>()
  run Vector.append<usize>(&mut modules, key.module)
  run Vector.append<usize>(&mut declarations, key.declaration)
  let mut at = usize.ZERO
  while at < Vector.length<usize>(&modules) {
    let nodeModuleOrdinal = Vector.get<usize>(&modules, at)
    let nodeDeclaration = Vector.get<usize>(&declarations, at)
    let nodeModule = run resolvedModule(&resolver.*, nodeModuleOrdinal)
    let template = run templateBinders(&mut resolver.*, &nodeModule, nodeDeclaration)
    let binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    let scan = run scanDeclarationFields(
      &mut resolver.*,
      &nodeModule,
      nodeDeclaration,
      Vector.asSlice<Binder>(&binders),
    )
    let FieldScan {omitted: written, references: found} = move scan
    let mut contribution = written
    let mut pending = move found
    let mut referenceAt = usize.ZERO
    while referenceAt < Vector.length<FieldReference>(&pending) {
      let reference = Vector.get<FieldReference>(&pending, referenceAt)
      let selected = run fieldTarget(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        nodeModuleOrdinal,
        &nodeModule,
        &reference,
      )
      let target = match move selected {
        Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
        Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
      let targetModule = run resolvedModule(&resolver.*, target.module)
      let targetHeader = run header(&mut resolver.*, &targetModule, target.ordinal)
      let mut aggregate = false
      let mut alias = false
      if let Option<HeaderSyntax>.Some {value} = move targetHeader {
        aggregate = isAggregateHeader(value.header)
        if let Node.AliasHeader {..} = value.header {
          alias = true
        }
      }
      let targetTemplate = run templateBinders(&mut resolver.*, &targetModule, target.ordinal)
      let targetBinders = match move targetTemplate {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
      let writtenLifetimes = writtenLifetimeCount(Vector.asSlice<Binder>(&targetBinders))
      if reference.arguments.present {
        let nested = run scanApplicationArguments(
          &mut resolver.*,
          &nodeModule,
          reference.arguments.id,
          Vector.asSlice<Binder>(&targetBinders),
          Vector.asSlice<Binder>(&binders),
        )
        let FieldScan {omitted: argumentOmissions, references: argumentReferences} = move nested
        contribution = contribution + argumentOmissions
        let more = Vector.asSlice<FieldReference>(&argumentReferences)
        let mut moreAt = usize.ZERO
        while moreAt < more.length {
          run Vector.append<FieldReference>(&mut pending, more[moreAt])
          moreAt = moreAt + usize.ONE
        }
      }
      // A written lifetime list is complete: an application rejects a partial one (GEN-002).
      let unwritten = !reference.writtenLifetimes
      if unwritten {
        contribution = contribution + writtenLifetimes
      }
      // An aggregate used without lifetimes also omits its generated ones; an alias's target
      // elides its own omissions at every use.
      if (aggregate && unwritten) || alias {
        let node = run fieldNode(&mut modules, &mut declarations, target.module, target.ordinal)
        run Vector.append<usize>(&mut sources, at)
        run Vector.append<usize>(&mut targets, node)
        run Vector.append<Span>(&mut edgeSpans, reference.span)
      }
      referenceAt = referenceAt + usize.ONE
    }
    run Vector.append<usize>(&mut omitted, contribution)
    at = at + usize.ONE
  }
  let nodes = Vector.length<usize>(&modules)
  // `positive` marks nodes whose count is nonzero: they omit a lifetime or reach one that does.
  let mut positive = Vector.make<bool>()
  at = usize.ZERO
  while at < nodes {
    run Vector.append<bool>(&mut positive, Vector.get<usize>(&omitted, at) > usize.ZERO)
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    let mut edge = usize.ZERO
    while edge < Vector.length<usize>(&sources) {
      let source = Vector.get<usize>(&sources, edge)
      if !Vector.get<bool>(&positive, source) && Vector.get<bool>(
        &positive,
        Vector.get<usize>(&targets, edge),
      ) {
        Vector.set<bool>(&mut positive, source, true)
        changed = true
      }
      edge = edge + usize.ONE
    }
  }
  // A positive node on a cycle would add lifetimes on every turn: no finite count exists.
  let mut unbounded = Vector.make<bool>()
  at = usize.ZERO
  while at < nodes {
    let cyclic = Vector.get<bool>(&positive, at) && run reachesNode(
      at,
      at,
      &sources,
      &targets,
      nodes,
    )
    run Vector.append<bool>(&mut unbounded, cyclic)
    at = at + usize.ONE
  }
  let mut reachesUnbounded = false
  at = usize.ZERO
  while at < nodes {
    if Vector.get<bool>(&unbounded, at) && (at == usize.ZERO || run reachesNode(
      usize.ZERO,
      at,
      &sources,
      &targets,
      nodes,
    )) {
      reachesUnbounded = true
    }
    at = at + usize.ONE
  }
  if reachesUnbounded {
    let mut anchor = rootSpan
    let mut edge = Vector.length<usize>(&sources)
    // Anchor at the root's first reference that leads into the unbounded cycle.
    while edge > usize.ZERO {
      edge = edge - usize.ONE
      if Vector.get<usize>(&sources, edge) == usize.ZERO {
        let target = Vector.get<usize>(&targets, edge)
        let mut leads = Vector.get<bool>(&unbounded, target)
        let mut other = usize.ZERO
        while other < nodes && !leads {
          if Vector.get<bool>(&unbounded, other) && run reachesNode(
            target,
            other,
            &sources,
            &targets,
            nodes,
          ) {
            leads = true
          }
          other = other + usize.ONE
        }
        if leads {
          anchor = Vector.get<Span>(&edgeSpans, edge)
        }
      }
    }
    return memberRejected(
      run reject(&resolver.*, &root, RejectionCode.Unsupported, anchor),
      move dependencies,
    )
  }
  let mut memo = Vector.make<usize>()
  at = usize.ZERO
  while at < nodes {
    run Vector.append<usize>(&mut memo, usize.MAX)
    at = at + usize.ONE
  }
  let count = fieldCount(usize.ZERO, &omitted, &sources, &targets, &positive, &mut memo)
  return memberSuccess(Value.FieldLifetimes {count: count}, move dependencies)
}

// Appends a struct's, tuple's, or union's generated lifetime parameters after its written binders.
// Any other declaration is left unchanged.
effect fn completeAggregateBinders(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
  span: Span,
  binders: &mut Vector<Binder>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let written = run header(&mut resolver.*, module, ordinal)
  let mut aggregate = false
  if let Option<HeaderSyntax>.Some {value} = move written {
    aggregate = isAggregateHeader(value.header)
  }
  if !aggregate {
    return Option.none<Shared<Rejection>>()
  }
  let countKey = Key {
    family: Family.FieldLifetimes,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ordinal,
    member: usize.ZERO,
    external: false,
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, countKey, span)
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &answer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
    return Option.some<Shared<Rejection>>(move diagnostic)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&answer, fieldLifetimeCount)
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  if let Option<DeclarationId>.Some {value: declared} = move identity {
    let first = Vector.length<Binder>(&binders.*)
    let mut index = usize.ZERO
    while index < count {
      run Vector.append<Binder>(
        &mut binders.*,
        Binder.Lifetime {
          name: Bytes.make(),
          value: run Shared.make<Lifetime>(
            Lifetime.Parameter {
              declaration: run DeclarationId.copy(&declared),
              ordinal: first + index,
            },
          ),
        },
      )
      index = index + usize.ONE
    }
  }
  return Option.none<Shared<Rejection>>()
}

fn fieldLifetimeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.FieldLifetimes {count}} => count
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn contractLifetimeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => Vector.length<Shared<Lifetime>>(
        &contract.lifetimeParameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn contractLifetimeAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Lifetime>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Contract {contract}} = &value.outcome {
      let lifetimes = Vector.asSlice<Shared<Lifetime>>(&contract.lifetimeParameters)
      if at < lifetimes.length {
        return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetimes[at]))
      }
    }
  }
  return Option.none<Shared<Lifetime>>()
}

// A declaration's contract owns omitted lifetimes in its bounds. Add those binders after its
// written and field-generated binders, preserving the ordinals resolved in the contract query.
effect fn completeBoundBinders(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  ordinal: usize,
  span: Span,
  binders: &mut Vector<Binder>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if Vector.length<Binder>(&binders.*) == usize.ZERO {
    return Option.none<Shared<Rejection>>()
  }
  let key = Key {
    family: Family.Contract,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ordinal,
    member: usize.ZERO,
    external: false,
  }
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &answer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return Option.some<Shared<Rejection>>(move diagnostic)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&answer, contractLifetimeCount)
  let mut at = writtenLifetimeCount(Vector.asSlice<Binder>(&binders.*))
  while at < count {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Lifetime>>>(
      &answer,
      fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> {
        return contractLifetimeAt(value, at)
      },
    )
    if let Option<Shared<Lifetime>>.Some {value: lifetime} = move found {
      run Vector.append<Binder>(
        &mut binders.*,
        Binder.Lifetime {name: Bytes.make(), value: move lifetime},
      )
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

struct BinderLists {
  types: Vector<Shared<Type>>
  lifetimes: Vector<Shared<Lifetime>>
  rows: Vector<RowParameter>
}

effect fn parametersOf(binders: &[Binder]) -> BinderLists ! OutOfMemoryError ? &mut Allocator {
  let mut lists = BinderLists {
    types: Vector.make<Shared<Type>>(),
    lifetimes: Vector.make<Shared<Lifetime>>(),
    rows: Vector.make<RowParameter>(),
  }
  let mut at = usize.ZERO
  while at < binders.length {
    if let Binder.Type {value, ..} = &binders[at] {
      run Vector.append<Shared<Type>>(&mut lists.types, Shared.clone<Type>(&value))
    }
    if let Binder.Lifetime {value, ..} = &binders[at] {
      run Vector.append<Shared<Lifetime>>(&mut lists.lifetimes, Shared.clone<Lifetime>(&value))
    }
    if let Binder.Row {value, ..} = &binders[at] {
      run Vector.append<RowParameter>(
        &mut lists.rows,
        RowParameter {
          declaration: Shared.clone<DeclarationId>(&value.declaration),
          ordinal: value.ordinal,
        },
      )
    }
    at = at + usize.ONE
  }
  return move lists
}

// Whether a written result is the builtin `Effect`, as resolved by `resolveType`.
effect fn effectResult(resolver: &mut Resolver, module: &ModuleId, id: HirId, binders: &[Binder]) -> bool
! Cycle | OutOfMemoryError
? &mut Allocator {
  let written = run typeNode(&mut resolver.*, module, id)
  if let Option<HeaderSyntax>.Some {value} = move written {
    let mut target = value.header
    if let Node.AppliedType {target: applied, ..} = value.header {
      let named = run typeNode(&mut resolver.*, module, applied)
      if let Option<HeaderSyntax>.Some {value: found} = move named {
        target = found.header
      }
    }
    if let Node.NamedType {path: typeName, ..} = target {
      let parsed = run path(&mut resolver.*, module, typeName)
      let segments = Vector.asSlice<Bytes>(&parsed.segments)
      return parsed.valid && segments.length == usize.ONE && same(
        Bytes.asSlice(&segments[usize.ZERO]),
        b"Effect",
      ) && !hasBinder(binders, b"Effect")
    }
  }
  return false
}

// The declaration's representation contracts, indexed by the bound parameter's binder ordinal. A
// representation that is also `Intrinsic.Detached` retains no external loan, whatever its contract's
// environment says, so it is recorded as retaining nothing.
effect fn representationsOf(owner: &DeclarationId, binderCount: usize, constraints: &[Constraint]) -> Vector<
  Option<Shared<Type>>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut table = Vector.make<Option<Shared<Type>>>()
  let mut at = usize.ZERO
  while at < binderCount {
    run Vector.append<Option<Shared<Type>>>(&mut table, Option.none<Shared<Type>>())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Represents {parameter, contract} = &constraints[at] {
      let ordinal = Shared.with<Type, usize>(
        &parameter,
        fn(node: &Type) -> usize {
          return Type.parameterOrdinalOf(node, owner)
        },
      )
      if ordinal < binderCount {
        Vector.set<Option<Shared<Type>>>(
          &mut table,
          ordinal,
          Option.some<Shared<Type>>(Shared.clone<Type>(&contract)),
        )
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Property {subject, property} = &constraints[at] {
      let detached = match property {
        IntrinsicProperty.Detached => true
        IntrinsicProperty.NonParking => false
      }
      let ordinal = Shared.with<Type, usize>(
        &subject,
        fn(node: &Type) -> usize {
          return Type.parameterOrdinalOf(node, owner)
        },
      )
      if detached && ordinal < binderCount && representedIn(&table, ordinal) {
        let nothing = run Shared.make<Type>(Type.Unit)
        Vector.set<Option<Shared<Type>>>(
          &mut table,
          ordinal,
          Option.some<Shared<Type>>(move nothing),
        )
      }
    }
    at = at + usize.ONE
  }
  return move table
}

fn representedIn(table: &Vector<Option<Shared<Type>>>, ordinal: usize) -> bool {
  let entries = Vector.asSlice<Option<Shared<Type>>>(table)
  return match & entries[ordinal] {
    Option<Shared<Type>>.Some {..} => true
    Option<Shared<Type>>.None => false
  }
}

effect fn resolveSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    key,
    Vector.make<Dependency>(),
    Option.none<Vector<Argument>>(),
    Option.none<Vector<Argument>>(),
  )
}

// The applied parts of one resolved `impl` head.
struct HeadApplication {
  contract: Option<Shared<Type>>
  provider: Shared<Type>
  span: Span
  contractSpan: Span
}

fn headApplication(head: &ImplementationHead) -> HeadApplication {
  let mut contract = Option.none<Shared<Type>>()
  if let Option<Shared<Type>>.Some {value} = &head.contract {
    contract = Option.some<Shared<Type>>(Shared.clone<Type>(&value))
  }
  return HeadApplication {
    contract: move contract,
    provider: Shared.clone<Type>(&head.provider),
    span: head.span,
    contractSpan: head.contractSpan,
  }
}

// The operation at `position` in a successful operation list.
fn operationAt(answer: &Result<Answer, NoRejection>, position: usize) -> Option<
  Shared<DeclarationId>,
> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&operations)
      if position < listed.length {
        return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&listed[position]))
      }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

// The position of `operation` in the operation list of the contract a conformance head names,
// or the rejection a caller receives: the head's or list's own, or `UnknownMember` when the
// operation belongs to no contract of this head.
effect fn operationPosition(
  resolver: &mut Resolver,
  query: &mut Query<Word, Answer, NoRejection>,
  moduleOrdinal: usize,
  implementation: usize,
  operation: &DeclarationId,
) -> Result<usize, Shared<Result<Answer, NoRejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let headKey = Key {
    family: Family.ImplementationHead,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: implementation,
    member: usize.ZERO,
    external: false,
  }
  let headAnswer = run demandRaw(
    &mut resolver.*,
    &mut query.*,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      return Result.failResult<usize, Shared<Result<Answer, NoRejection>>>(move headAnswer)
    }
  }
  let applied = Shared.with<ImplementationHead, HeadApplication>(&head, headApplication)
  let HeadApplication {contract: written, provider: unused, span, contractSpan} = move applied
  drop unused
  let mut anchor = contractSpan
  let mut contractModuleOrdinal = usize.MAX
  let mut contractOrdinal = Option.none<usize>()
  if let Option<Shared<Type>>.Some {value: contract} = move written {
    contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &contract)
    if contractModuleOrdinal != usize.MAX {
      let contractModule = run resolvedModule(&resolver.*, contractModuleOrdinal)
      contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractModule, &contract)
    }
  } else {
    anchor = span
  }
  if let Option<usize>.Some {value: declaration} = move contractOrdinal {
    let operationsKey = Key {
      family: Family.Operations,
      module: contractModuleOrdinal,
      name: usize.ZERO,
      declaration: declaration,
      member: usize.ZERO,
      external: false,
    }
    let listed = run demandRaw(&mut resolver.*, &mut query.*, operationsKey, contractSpan)
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      return Result.failResult<usize, Shared<Result<Answer, NoRejection>>>(move listed)
    }
    let position = Shared.with<Result<Answer, NoRejection>, usize>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return operationIndex(answer, operation)
      },
    )
    if position != usize.MAX {
      return Result.succeed<usize, Shared<Result<Answer, NoRejection>>>(position)
    }
  }
  return Result.failResult<usize, Shared<Result<Answer, NoRejection>>>(
    run rejectAbsent(&mut resolver.*, &module, anchor),
  )
}

fn operationIndex(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&operations)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(
          &listed[at],
          fn(candidate: &DeclarationId) -> bool {
            return DeclarationId.equals(candidate, operation)
          },
        ) {
          return at
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

fn listedOperation(answer: &Result<Answer, NoRejection>, ordinal: usize) -> Option<
  Shared<DeclarationId>,
> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&operations)
      if ordinal < listed.length {
        return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&listed[ordinal]))
      }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

fn listedOperationCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      return Vector.length<Shared<DeclarationId>>(&operations)
    }
  }
  return usize.ZERO
}

// Re-resolves one operation under a known interface application and provider. This is the shared
// call contract for qualified, receiver, and operator spellings. The selected witness is a
// separate proof result: neither arguments nor expected result may choose one here.
effect fn resolveAppliedOperation(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let applications = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let contract = Shared.clone<Type>(&applications[key.name])
  let provider = Shared.clone<Type>(&applications[key.member])
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let operationSpan = match move written {
    Option<HeaderSyntax>.Some {value} => value.span
    Option<HeaderSyntax>.None => Span.make(usize.ZERO, usize.ZERO)
  }
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, &contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, operationSpan),
        move dependencies,
      )
    }
  }
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Operations,
      module: key.module,
      name: usize.ZERO,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    },
    operationSpan,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return memberRejected(move value, move dependencies)
  }
  let operation = run declarationAt(&mut resolver.*, &module, key.declaration)
  let selected = match move operation {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, operationSpan),
        move dependencies,
      )
    }
  }
  let position = Shared.with<Result<Answer, NoRejection>, usize>(
    &listed,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return operationIndex(answer, &selected)
    },
  )
  if position == usize.MAX {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.UnknownMember, operationSpan),
      move dependencies,
    )
  }
  let mut supplied = Vector.make<Argument>()
  let mut count = Shared.with<Type, usize>(&contract, applicationLength)
  if count == usize.MAX {
    count = usize.ZERO
  }
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared.with<Type, Option<Argument>>(
      &contract,
      fn(value: &Type) -> Option<Argument> {
        return applicationArgument(value, at)
      },
    )
    if let Option<Argument>.Some {value} = move argument {
      run Vector.append<Argument>(&mut supplied, move value)
    }
    at = at + usize.ONE
  }
  run Vector.append<Argument>(&mut supplied, Argument.Type {value: move provider})
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let authored = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    operationSpan,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &authored,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return memberRejected(move value, move dependencies)
  }
  drop authored
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    signatureKey,
    move dependencies,
    Option.some<Vector<Argument>>(move supplied),
    Option.none<Vector<Argument>>(),
  )
}

// Resolves an inherent receiver call under the exact nominal application. The owner's published
// member list gates the query, so a duplicate or field collision keeps its anchored rejection.
effect fn resolveAppliedInherent(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let applications = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let provider = Shared.clone<Type>(&applications[key.name])
  let mut dependencies = Vector.make<Dependency>()
  let ownerOrdinal = run ordinalOfProvider(&mut resolver.*, &module, &provider)
  let position = match move ownerOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownMember,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.InherentMembers,
      module: key.module,
      name: usize.ZERO,
      declaration: position,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return memberRejected(move value, move dependencies)
  }
  let declared = run declarationAt(&mut resolver.*, &module, key.declaration)
  let selected = match move declared {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownMember,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let verdict = Shared.with<Result<Answer, NoRejection>, MemberVerdict>(
    &listed,
    fn(answer: &Result<Answer, NoRejection>) -> MemberVerdict {
      return memberVerdict(answer, &selected)
    },
  )
  if let Option<Shared<Rejection>>.Some {value} = move verdict.rejected {
    return memberRejected(move value, move dependencies)
  }
  if !verdict.published {
    return memberRejected(
      run reject(
        &resolver.*,
        &module,
        RejectionCode.UnknownMember,
        Span.make(usize.ZERO, usize.ZERO),
      ),
      move dependencies,
    )
  }
  let mut supplied = Vector.make<Argument>()
  let count = Shared.with<Type, usize>(&provider, applicationLength)
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared.with<Type, Option<Argument>>(
      &provider,
      fn(value: &Type) -> Option<Argument> {
        return applicationArgument(value, at)
      },
    )
    if let Option<Argument>.Some {value} = move argument {
      run Vector.append<Argument>(&mut supplied, move value)
    }
    at = at + usize.ONE
  }
  run Vector.append<Argument>(&mut supplied, Argument.Type {value: move provider})
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let authored = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &authored,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return memberRejected(move value, move dependencies)
  }
  drop authored
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    signatureKey,
    move dependencies,
    Option.some<Vector<Argument>>(move supplied),
    Option.none<Vector<Argument>>(),
  )
}

// Re-resolves one contract operation's written header under a conformance head: the contract's
// binders take the head's contract arguments in order and `Self` takes its provider. The head and
// the contract's operation list are child answers of this query, and the operation's enclosing
// scope is resolved as written, so an edit to any of those headers recomputes the answer.
effect fn resolveOperationUnder(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &headAnswer,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return memberRejected(move diagnostic, move dependencies)
      }
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let applied = Shared.with<ImplementationHead, HeadApplication>(&head, headApplication)
  let HeadApplication {contract: written, provider, span, contractSpan} = move applied
  // An inherent or sealed-property head has no contract whose operation could be meant.
  let contract = match move written {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, span),
        move dependencies,
      )
    }
  }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &contract)
  if contractModuleOrdinal == usize.MAX {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.UnknownMember, contractSpan),
      move dependencies,
    )
  }
  let contractModule = run resolvedModule(&resolver.*, contractModuleOrdinal)
  let located = run ordinalOfProvider(&mut resolver.*, &contractModule, &contract)
  let contractOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, contractSpan),
        move dependencies,
      )
    }
  }
  let operationsKey = Key {
    family: Family.Operations,
    module: contractModuleOrdinal,
    name: usize.ZERO,
    declaration: contractOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    operationsKey,
    contractSpan,
  )
  let refused = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refused {
    return memberRejected(move diagnostic, move dependencies)
  }
  let position = key.member
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
    &listed,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
      return operationAt(answer, position)
    },
  )
  let operation = match move selected {
    Option<Shared<DeclarationId>>.Some {value} => move value
    Option<Shared<DeclarationId>>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, contractSpan),
        move dependencies,
      )
    }
  }
  let found = run ordinalOfIdentity(&mut resolver.*, &contractModule, &operation)
  let operationOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, contractSpan),
        move dependencies,
      )
    }
  }
  let mut supplied = Vector.make<Argument>()
  let mut count = Shared.with<Type, usize>(&contract, applicationLength)
  if count == usize.MAX {
    count = usize.ZERO
  }
  let mut at = usize.ZERO
  while at < count {
    let argument = Shared.with<Type, Option<Argument>>(
      &contract,
      fn(ty: &Type) -> Option<Argument> {
        return applicationArgument(ty, at)
      },
    )
    if let Option<Argument>.Some {value} = move argument {
      run Vector.append<Argument>(&mut supplied, move value)
    }
    at = at + usize.ONE
  }
  run Vector.append<Argument>(&mut supplied, Argument.Type {value: move provider})
  let signatureKey = Key {
    family: Family.Signature,
    module: contractModuleOrdinal,
    name: usize.ZERO,
    declaration: operationOrdinal,
    member: usize.ZERO,
    external: false,
  }
  // Check the authored public operation before substituting the provider. A private concrete
  // `Self` is valid here, but a private type written in the public operation is not.
  let authored = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    contractSpan,
  )
  let refusedSignature = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &authored,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedSignature {
    return memberRejected(move diagnostic, move dependencies)
  }
  drop authored
  return run resolveSignatureUnder(
    &mut resolver.*,
    &mut owner.*,
    signatureKey,
    move dependencies,
    Option.some<Vector<Argument>>(move supplied),
    Option.none<Vector<Argument>>(),
  )
}

// The first way one implementation fails its substituted operation header. `Unsupported` marks a
// comparison outside the fragment decided here; it never admits a witness.
union Verdict {
  Compatible,
  Incompatible {problem: WitnessProblem},
  Unsupported,
}

fn compatible(verdict: &Verdict) -> bool {
  return match & verdict.* {
    Verdict.Compatible => true
    _ => false
  }
}

// The facts of one signature answer that witness checking compares, with shared handles cloned.
struct SignatureFacts {
  isEffect: bool
  isUnsafe: bool
  parameters: usize
  binders: usize
  constraints: usize
  result: Shared<Type>
  failure: Shared<Type>
  requirements: Shared<Row>
  // The environment's region count; `usize.MAX` for an ordinary function.
  environment: usize
}

fn copyArgument(argument: &Argument) -> Argument {
  return match & argument.* {
    Argument.Type {value} => Argument.Type {value: Shared.clone<Type>(&value)}
    Argument.Lifetime {value} => Argument.Lifetime {value: Shared.clone<Lifetime>(&value)}
    Argument.Row {value} => Argument.Row {value: Shared.clone<Row>(&value)}
  }
}

effect fn copyArguments(arguments: &[Argument]) -> Vector<Argument>
! OutOfMemoryError
? &mut Allocator {
  let mut copied = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < arguments.length {
    run Vector.append<Argument>(&mut copied, copyArgument(&arguments[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn appendArguments(target: &mut Vector<Argument>, source: &[Argument]) -> ()
! OutOfMemoryError
? &mut Allocator {
  let mut at = usize.ZERO
  while at < source.length {
    run Vector.append<Argument>(&mut target.*, copyArgument(&source[at]))
    at = at + usize.ONE
  }
  return ()
}

fn ownedLifetimeOrdinal(region: &Shared<Lifetime>, owner: &DeclarationId) -> usize {
  return Shared.with<Lifetime, usize>(
    region,
    fn(value: &Lifetime) -> usize {
      if let Lifetime.Parameter {declaration, ordinal} = &value.* {
        if DeclarationId.equals(&declaration, owner) {
          return ordinal
        }
      }
      return usize.MAX
    },
  )
}

effect fn usesOwnedLifetime(value: &Shared<Type>, owner: &DeclarationId, ordinal: usize) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  let used = Vector.asSlice<usize>(&lifetimes)
  let mut at = usize.ZERO
  while at < used.length {
    if used[at] == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn bindingArgument(bindings: &[Binding], owner: &DeclarationId, ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && Shared.with<DeclarationId, bool>(
      &bindings[at].declaration,
      fn(found: &DeclarationId) -> bool {
        return DeclarationId.equals(found, owner)
      },
    ) {
      return Option.some<Argument>(copyArgument(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

fn lentArgument(lent: &[Shared<Lifetime>], owner: &DeclarationId, ordinal: usize) -> Option<
  Argument,
> {
  let mut at = usize.ZERO
  while at < lent.length {
    if ownedLifetimeOrdinal(&lent[at], owner) == ordinal {
      return Option.some<Argument>(Argument.Lifetime {value: Shared.clone<Lifetime>(&lent[at])})
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

effect fn matchedArguments(
  count: usize,
  owner: &DeclarationId,
  bindings: &[Binding],
  lent: &[Shared<Lifetime>],
) -> Option<Vector<Argument>> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < count {
    let bound = bindingArgument(bindings, owner, at)
    if let Option<Argument>.Some {value} = move bound {
      run Vector.append<Argument>(&mut arguments, move value)
    } else {
      let borrowed = lentArgument(lent, owner, at)
      if let Option<Argument>.Some {value} = move borrowed {
        run Vector.append<Argument>(&mut arguments, move value)
      } else {
        return Option.none<Vector<Argument>>()
      }
    }
    at = at + usize.ONE
  }
  return Option.some<Vector<Argument>>(move arguments)
}

fn unboundTypeIn(value: &Shared<Type>, owner: &DeclarationId, count: usize, bindings: &[Binding]) -> bool {
  let mut at = usize.ZERO
  while at < count {
    if Type.occurrences(value, owner, at) > usize.ZERO {
      if let Option<Argument>.None = move bindingArgument(bindings, owner, at) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn unboundRowValue(value: &Row, owner: &DeclarationId, bindings: &[Binding]) -> bool {
  let parameters = Vector.asSlice<RowParameter>(&value.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    let owned = Shared.with<DeclarationId, bool>(
      &parameters[at].declaration,
      fn(declaration: &DeclarationId) -> bool {
        return DeclarationId.equals(declaration, owner)
      },
    )
    if owned {
      if let Option<Argument>.None = move bindingArgument(bindings, owner, parameters[at].ordinal) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn unboundRowIn(row: &Shared<Row>, owner: &DeclarationId, bindings: &[Binding]) -> bool {
  return Shared.with<Row, bool>(
    row,
    fn(value: &Row) -> bool {
      return unboundRowValue(value, owner, bindings)
    },
  )
}

// A carrier lets the public exact type unifier handle a requirement row without a second row
// matcher. Its other fields are identical on both sides and carry no witness information.
effect fn rowCarrier(row: &Shared<Row>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(
    Type.Effect {
      mode: CallableMode.Shared,
      environment: run Shared.make<Intersection>(
        Intersection {members: Vector.make<LifetimeMember>()},
      ),
      success: run Shared.make<Type>(Type.Unit),
      failure: run Shared.make<Type>(Type.Unit),
      requirements: Shared.clone<Row>(row),
    },
  )
}

fn signatureFacts(answer: &Result<Answer, NoRejection>) -> Option<SignatureFacts> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let mut environment = usize.MAX
      if let Option<Intersection>.Some {value: retained} = &signature.environment {
        environment = Vector.length<LifetimeMember>(&retained.members)
      }
      return Option.some<SignatureFacts>(
        SignatureFacts {
          isEffect: signature.isEffect,
          isUnsafe: signature.isUnsafe,
          parameters: Vector.length<Shared<Type>>(&signature.parameters),
          binders: Vector.length<Shared<Type>>(&signature.typeParameters) + Vector.length<
            Shared<Lifetime>,
          >(&signature.lifetimeParameters) + Vector.length<RowParameter>(&signature.rowParameters),
          constraints: Vector.length<Constraint>(&signature.constraints),
          result: Shared.clone<Type>(&signature.result),
          failure: Shared.clone<Type>(&signature.failure),
          requirements: Shared.clone<Row>(&signature.requirements),
          environment: environment,
        },
      )
    }
  }
  return Option.none<SignatureFacts>()
}

fn signatureConstraintAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let listed = Vector.asSlice<Constraint>(&signature.constraints)
      if at < listed.length {
        return Option.some<Constraint>(copyConstraint(&listed[at]))
      }
    }
  }
  return Option.none<Constraint>()
}

fn contractConstraintCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Contract {contract}} = &value.outcome {
      return Vector.length<Constraint>(&contract.constraints)
    }
  }
  return usize.ZERO
}

fn contractConstraintAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Contract {contract}} = &value.outcome {
      let listed = Vector.asSlice<Constraint>(&contract.constraints)
      if at < listed.length {
        return Option.some<Constraint>(copyConstraint(&listed[at]))
      }
    }
  }
  return Option.none<Constraint>()
}

fn headConstraintAt(head: &ImplementationHead, at: usize) -> Option<Constraint> {
  let listed = Vector.asSlice<Constraint>(&head.binders.constraints)
  if at < listed.length {
    return Option.some<Constraint>(copyConstraint(&listed[at]))
  }
  return Option.none<Constraint>()
}

effect fn sameConstraint(left: &Constraint, right: &Constraint) -> bool
! OutOfMemoryError
? &mut Allocator {
  if let Constraint.Conforms {provider, contract} = &left.* {
    if let Constraint.Conforms {provider: otherProvider, contract: otherContract} = &right.* {
      let sameProvider = run Type.equalsShared(&provider, &otherProvider)
      if !sameProvider {
        return false
      }
      return run Type.equalsShared(&contract, &otherContract)
    }
    return false
  }
  if let Constraint.Represents {parameter, contract} = &left.* {
    if let Constraint.Represents {parameter: otherParameter, contract: otherContract} = &right.* {
      let sameParameter = run Type.equalsShared(&parameter, &otherParameter)
      if !sameParameter {
        return false
      }
      return run Type.equalsShared(&contract, &otherContract)
    }
    return false
  }
  if let Constraint.Contents {subject, region} = &left.* {
    if let Constraint.Contents {subject: otherSubject, region: otherRegion} = &right.* {
      let sameSubject = run Type.equalsShared(&subject, &otherSubject)
      return sameSubject && Lifetime.equalsShared(&region, &otherRegion)
    }
    return false
  }
  if let Constraint.Outlives {longer, shorter} = &left.* {
    if let Constraint.Outlives {longer: otherLonger, shorter: otherShorter} = &right.* {
      return Lifetime.equalsShared(&longer, &otherLonger) && Lifetime.equalsShared(
        &shorter,
        &otherShorter,
      )
    }
    return false
  }
  if let Constraint.Copyable {subject} = &left.* {
    if let Constraint.Copyable {subject: otherSubject} = &right.* {
      return run Type.equalsShared(&subject, &otherSubject)
    }
    return false
  }
  if let Constraint.Property {subject, property} = &left.* {
    if let Constraint.Property {subject: otherSubject, property: otherProperty} = &right.* {
      let sameSubject = run Type.equalsShared(&subject, &otherSubject)
      return sameSubject && property == otherProperty
    }
    return false
  }
  return false
}

effect fn witnessBoundsImplied(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  witness: &Shared<Result<Answer, NoRejection>>,
  count: usize,
  operationCount: usize,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let headCount = Shared.with<ImplementationHead, usize>(head, headConstraintCount)
  let mut assumptions = Vector.make<Constraint>()
  let mut source = usize.ZERO
  while source < headCount {
    let bound = Shared.with<ImplementationHead, Option<Constraint>>(
      head,
      fn(value: &ImplementationHead) -> Option<Constraint> {
        return headConstraintAt(value, source)
      },
    )
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut assumptions, move value)
    }
    source = source + usize.ONE
  }
  source = usize.ZERO
  while source < operationCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      operation,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraintAt(answer, source)
      },
    )
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut assumptions, move value)
    }
    source = source + usize.ONE
  }
  let forbidden = Option.some<Shared<DeclarationId>>(
    Shared.with<ImplementationHead, Shared<DeclarationId>>(
      head,
      fn(value: &ImplementationHead) -> Shared<DeclarationId> {
        return Shared.clone<DeclarationId>(&value.declaration)
      },
    ),
  )
  let mut at = usize.ZERO
  while at < count {
    let needed = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      witness,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraintAt(answer, at)
      },
    )
    let bound = match move needed {
      Option<Constraint>.Some {value} => move value
      Option<Constraint>.None => {
        return false
      }
    }
    let mut implied = false
    let available = Vector.asSlice<Constraint>(&assumptions)
    let mut prior = usize.ZERO
    while prior < available.length && !implied {
      implied = run sameConstraint(&bound, &available[prior])
      prior = prior + usize.ONE
    }
    if !implied {
      if let Constraint.Conforms {provider, contract} = &bound {
        let goal = ConformanceGoal {
          contract: Shared.clone<Type>(&contract),
          provider: Shared.clone<Type>(&provider),
        }
        let mut request = Request.make()
        let mut chain = Vector.make<ConformanceGoal>()
        let mut steps = Vector.make<ConformanceStep>()
        let failed = run proveGoal(
          &mut resolver.*,
          &mut owner.*,
          &mut request,
          &mut dependencies.*,
          true,
          &forbidden,
          &goal,
          available,
          siteModule,
          siteSpan,
          &mut chain,
          &mut steps,
        )
        if let Option<Shared<Rejection>>.Some {value: _} = move failed {
          return false
        }
      } else {
        return false
      }
    }
    at = at + usize.ONE
  }
  return true
}

fn environmentRegion(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Lifetime>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      if let Option<Intersection>.Some {value: retained} = &signature.environment {
        let members = Vector.asSlice<LifetimeMember>(&retained.members)
        if at < members.length {
          return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&members[at].region))
        }
      }
    }
  }
  return Option.none<Shared<Lifetime>>()
}

fn outlivesTarget(constraint: &Constraint, longer: &Shared<Lifetime>) -> Option<Shared<Lifetime>> {
  if let Constraint.Outlives {longer: written, shorter} = &constraint.* {
    if Lifetime.equalsShared(&written, longer) {
      return Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&shorter))
    }
  }
  return Option.none<Shared<Lifetime>>()
}

fn containsRegion(regions: &[Shared<Lifetime>], candidate: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if Lifetime.equalsShared(&regions[at], candidate) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn regionAt(regions: &Vector<Shared<Lifetime>>, at: usize) -> Shared<Lifetime> {
  let listed = Vector.asSlice<Shared<Lifetime>>(regions)
  return Shared.clone<Lifetime>(&listed[at])
}

// The regions of a signature's environment, or none for an ordinary function.
effect fn environmentRegions(answer: &Shared<Result<Answer, NoRejection>>, count: usize) -> Vector<
  Shared<Lifetime>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut regions = Vector.make<Shared<Lifetime>>()
  if count == usize.MAX {
    return move regions
  }
  let mut at = usize.ZERO
  while at < count {
    let region = Shared.with<Result<Answer, NoRejection>, Option<Shared<Lifetime>>>(
      answer,
      fn(resolved: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> {
        return environmentRegion(resolved, at)
      },
    )
    if let Option<Shared<Lifetime>>.Some {value} = move region {
      run Vector.append<Shared<Lifetime>>(&mut regions, move value)
    }
    at = at + usize.ONE
  }
  return move regions
}

// A sole written environment region can bind a still-free witness lifetime to the sole promised
// region. Intersections are unordered sets, so a free binder among several members needs set
// matching rather than a positional guess.
effect fn bindEnvironmentArgument(
  operation: &Shared<Result<Answer, NoRejection>>,
  promisedCount: usize,
  witness: &Shared<Result<Answer, NoRejection>>,
  providedCount: usize,
  witnessOwner: &DeclarationId,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
  lent: &[Shared<Lifetime>],
) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  let provided = run environmentRegions(witness, providedCount)
  let providedRegions = Vector.asSlice<Shared<Lifetime>>(&provided)
  let mut unbound = false
  let mut at = usize.ZERO
  while at < providedRegions.length {
    let ordinal = ownedLifetimeOrdinal(&providedRegions[at], witnessOwner)
    if ordinal != usize.MAX {
      if let Option<Argument>.None = move bindingArgument(
        Vector.asSlice<Binding>(&bindings.*),
        witnessOwner,
        ordinal,
      ) {
        if let Option<Argument>.None = move lentArgument(lent, witnessOwner, ordinal) {
          unbound = true
        }
      }
    }
    at = at + usize.ONE
  }
  if !unbound {
    return Verdict.Compatible
  }
  let promised = run environmentRegions(operation, promisedCount)
  let promisedRegions = Vector.asSlice<Shared<Lifetime>>(&promised)
  if providedRegions.length != usize.ONE || promisedRegions.length != usize.ONE {
    return Verdict.Unsupported
  }
  let expected = run Shared.make<Type>(
    Type.String {lifetime: Shared.clone<Lifetime>(&promisedRegions[usize.ZERO])},
  )
  let offered = run Shared.make<Type>(
    Type.String {lifetime: Shared.clone<Lifetime>(&providedRegions[usize.ZERO])},
  )
  let matched = run Type.unify(&expected, &offered, variables, Comparison.Exact, &mut bindings.*)
  return match move matched {
    Unification.Unified => Verdict.Compatible
    Unification.Distinct => Verdict.Incompatible {problem: WitnessProblem.Environment}
    Unification.Undetermined {..} => Verdict.Unsupported
  }
}

// The regions an Effect capturing these parameters retains, with whether every one is known.
struct Retained {
  regions: Vector<Shared<Lifetime>>
  known: bool
}

effect fn retainedByParameters(
  answer: &Shared<Result<Answer, NoRejection>>,
  count: usize,
  owner: &DeclarationId,
) -> Retained ! OutOfMemoryError ? &mut Allocator {
  let mut retained = Retained {regions: Vector.make<Shared<Lifetime>>(), known: true}
  let none = Vector.make<Option<Shared<Type>>>()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      answer,
      fn(resolved: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(resolved, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move parameter {
      if !run Type.retainedRegions(
        &value,
        owner,
        Vector.asSlice<Option<Shared<Type>>>(&none),
        &mut retained.regions,
      ) {
        retained.known = false
      }
    }
    at = at + usize.ONE
  }
  return move retained
}

// 0 for an owned value, 1 for a reference, 2 for a slice.
fn operandShape(value: &Type) -> usize {
  return match & value.* {
    Type.Reference {..} => usize.ONE
    Type.Slice {..} => usize.ONE + usize.ONE
    _ => usize.ZERO
  }
}

fn exclusiveAccess(access: Access) -> bool {
  return match access {
    Access.Shared => false
    Access.Mutable => true
  }
}

fn operandExclusive(value: &Type) -> bool {
  return match & value.* {
    Type.Reference {access, ..} => exclusiveAccess(access)
    Type.Slice {access, ..} => exclusiveAccess(access)
    _ => false
  }
}

fn operandTarget(value: &Shared<Type>) -> Shared<Type> {
  return Shared.with<Type, Shared<Type>>(
    value,
    fn(node: &Type) -> Shared<Type> {
      return match & node.* {
        Type.Reference {referent, ..} => Shared.clone<Type>(&referent)
        Type.Slice {element, ..} => Shared.clone<Type>(&element)
        _ => Shared.clone<Type>(value)
      }
    },
  )
}

fn operandRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match & value.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(
      Shared.clone<Lifetime>(&lifetime),
    )
    Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    _ => Option.none<Shared<Lifetime>>()
  }
}

// Operand modes are literal; their types and regions use the same exact witness bindings as the
// success type. Only an owned contract value may be lent to a witness-owned fresh borrow.
effect fn operandVerdict(
  promised: &Shared<Type>,
  witness: &Shared<Type>,
  at: usize,
  owner: &DeclarationId,
  variables: &[Shared<DeclarationId>],
  bindings: &mut Vector<Binding>,
  lent: &mut Vector<Shared<Lifetime>>,
) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  let promisedShape = Shared.with<Type, usize>(promised, operandShape)
  let witnessShape = Shared.with<Type, usize>(witness, operandShape)
  if promisedShape != usize.ZERO && witnessShape == usize.ZERO {
    return Verdict.Incompatible {problem: WitnessProblem.OperandAccess {operand: at}}
  }
  if promisedShape == usize.ZERO && witnessShape != usize.ZERO {
    if witnessShape != usize.ONE {
      return Verdict.Incompatible {problem: WitnessProblem.OperandShape {operand: at}}
    }
    let region = Shared.with<Type, Option<Shared<Lifetime>>>(witness, operandRegion)
    if let Option<Shared<Lifetime>>.Some {value: borrowed} = move region {
      let ordinal = ownedLifetimeOrdinal(&borrowed, owner)
      if ordinal == usize.MAX {
        return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
      }
      if let Option<Argument>.Some {..} = move bindingArgument(
        Vector.asSlice<Binding>(&bindings.*),
        owner,
        ordinal,
      ) {
        return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
      }
      let target = operandTarget(witness)
      let compared = run Type.unify(promised, &target, variables, Comparison.Exact, &mut bindings.*)
      match move compared {
        Unification.Unified => {
          run Vector.append<Shared<Lifetime>>(&mut lent.*, move borrowed)
          return Verdict.Compatible
        }
        Unification.Distinct => {
          return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
        }
        Unification.Undetermined {..} => {
          return Verdict.Unsupported
        }
      }
    }
    return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
  }
  let borrowed = Vector.asSlice<Shared<Lifetime>>(&lent.*)
  let mut previous = usize.ZERO
  while previous < borrowed.length {
    let ordinal = ownedLifetimeOrdinal(&borrowed[previous], owner)
    if run usesOwnedLifetime(witness, owner, ordinal) {
      return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
    }
    previous = previous + usize.ONE
  }
  if promisedShape == usize.ZERO {
    let compared = run Type.unify(promised, witness, variables, Comparison.Exact, &mut bindings.*)
    return match move compared {
      Unification.Unified => Verdict.Compatible
      Unification.Distinct => Verdict.Incompatible {
        problem: WitnessProblem.OperandType {operand: at},
      }
      Unification.Undetermined {..} => Verdict.Unsupported
    }
  }
  if promisedShape != witnessShape {
    return Verdict.Incompatible {problem: WitnessProblem.OperandShape {operand: at}}
  }
  if Shared.with<Type, bool>(witness, operandExclusive) && !Shared.with<Type, bool>(
    promised,
    operandExclusive,
  ) {
    return Verdict.Incompatible {problem: WitnessProblem.OperandAccess {operand: at}}
  }
  let promisedRegion = Shared.with<Type, Option<Shared<Lifetime>>>(promised, operandRegion)
  let witnessRegion = Shared.with<Type, Option<Shared<Lifetime>>>(witness, operandRegion)
  let promisedTarget = operandTarget(promised)
  let witnessTarget = operandTarget(witness)
  let target = run Type.unify(
    &promisedTarget,
    &witnessTarget,
    variables,
    Comparison.Exact,
    &mut bindings.*,
  )
  match move target {
    Unification.Unified => {}
    Unification.Distinct => {
      return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
    }
    Unification.Undetermined {..} => {
      return Verdict.Unsupported
    }
  }
  if let Option<Shared<Lifetime>>.Some {value: first} = move promisedRegion {
    if let Option<Shared<Lifetime>>.Some {value: second} = move witnessRegion {
      let firstType = run Shared.make<Type>(Type.String {lifetime: move first})
      let secondType = run Shared.make<Type>(Type.String {lifetime: move second})
      let compared = run Type.unify(
        &firstType,
        &secondType,
        variables,
        Comparison.Exact,
        &mut bindings.*,
      )
      return match move compared {
        Unification.Unified => Verdict.Compatible
        Unification.Distinct => Verdict.Incompatible {
          problem: WitnessProblem.OperandType {operand: at},
        }
        Unification.Undetermined {..} => Verdict.Unsupported
      }
    }
  }
  return Verdict.Incompatible {problem: WitnessProblem.OperandType {operand: at}}
}

fn outlivesAssumptionAt(
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  headCount: usize,
  at: usize,
) -> Option<Constraint> {
  if at < headCount {
    return Shared.with<ImplementationHead, Option<Constraint>>(
      head,
      fn(value: &ImplementationHead) -> Option<Constraint> {
        return headConstraintAt(value, at)
      },
    )
  }
  return Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
    operation,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
      return signatureConstraintAt(answer, at - headCount)
    },
  )
}

// Reachability in the finite graph of head and substituted operation lifetime bounds. Neither
// source requires a witness answer, so this cannot justify a witness with its own result.
effect fn assumedOutlives(
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  operationCount: usize,
  longer: &Shared<Lifetime>,
  shorter: &Shared<Lifetime>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  if Lifetime.equalsShared(longer, shorter) {
    return true
  }
  let staticRegion = Shared.with<Lifetime, bool>(
    longer,
    fn(value: &Lifetime) -> bool {
      return match & value.* {
        Lifetime.Static => true
        _ => false
      }
    },
  )
  if staticRegion {
    return true
  }
  let headCount = Shared.with<ImplementationHead, usize>(head, headConstraintCount)
  let mut reached = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut reached, Shared.clone<Lifetime>(longer))
  let mut at = usize.ZERO
  while at < Vector.length<Shared<Lifetime>>(&reached) {
    let current = regionAt(&reached, at)
    let mut edge = usize.ZERO
    while edge < headCount + operationCount {
      let assumption = outlivesAssumptionAt(head, operation, headCount, edge)
      if let Option<Constraint>.Some {value} = move assumption {
        let next = outlivesTarget(&value, &current)
        if let Option<Shared<Lifetime>>.Some {value: region} = move next {
          if Lifetime.equalsShared(&region, shorter) {
            return true
          }
          if !containsRegion(Vector.asSlice<Shared<Lifetime>>(&reached), &region) {
            run Vector.append<Shared<Lifetime>>(&mut reached, move region)
          }
        }
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// An `effect fn` implementation's Effect must stay valid for the promised environment. A region
// covers it when it is a promised region, is retained by the operation's inputs (which LIFE-004
// obliges every caller to keep alive for the promised environment), or has a written bound to a
// promised region through the transitive head and operation bounds. A written implementation
// environment is also an obligation on its stored inputs, which must follow from those facts.
effect fn environmentVerdict(
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  operationOwner: &DeclarationId,
  promisedFacts: &SignatureFacts,
  witness: &Shared<Result<Answer, NoRejection>>,
  witnessOwner: &DeclarationId,
  witnessFacts: &SignatureFacts,
  witnessWritten: bool,
  lent: &[Shared<Lifetime>],
) -> Verdict ! OutOfMemoryError ? &mut Allocator {
  let promised = run environmentRegions(operation, promisedFacts.environment)
  let provided = run environmentRegions(witness, witnessFacts.environment)
  let captured = run retainedByParameters(operation, promisedFacts.parameters, operationOwner)
  let promisedRegions = Vector.asSlice<Shared<Lifetime>>(&promised)
  let providedRegions = Vector.asSlice<Shared<Lifetime>>(&provided)
  let capturedRegions = Vector.asSlice<Shared<Lifetime>>(&captured.regions)
  let mut undecided = false
  let mut at = usize.ZERO
  while at < providedRegions.length {
    let region = &providedRegions[at]
    if containsRegion(lent, region) {
      at = at + usize.ONE
      continue
    }
    let mut covered = containsRegion(promisedRegions, region) || containsRegion(
      capturedRegions,
      region,
    )
    let mut other = usize.ZERO
    while !covered && other < promisedRegions.length {
      covered = run assumedOutlives(
        head,
        operation,
        promisedFacts.constraints,
        region,
        &promisedRegions[other],
      )
      other = other + usize.ONE
    }
    if !covered {
      if captured.known {
        return Verdict.Incompatible {problem: WitnessProblem.Environment}
      }
      undecided = true
    }
    at = at + usize.ONE
  }
  if witnessWritten {
    // Every promised region is also written, so the promised environment covers the written one.
    let mut within = true
    at = usize.ZERO
    while within && at < promisedRegions.length {
      within = containsRegion(providedRegions, &promisedRegions[at])
      at = at + usize.ONE
    }
    let stored = run retainedByParameters(witness, witnessFacts.parameters, witnessOwner)
    if !stored.known && !within {
      undecided = true
    }
    let storedRegions = Vector.asSlice<Shared<Lifetime>>(&stored.regions)
    at = usize.ZERO
    while at < storedRegions.length {
      let region = &storedRegions[at]
      let kept = containsRegion(providedRegions, region) || within && (containsRegion(
        promisedRegions,
        region,
      ) || containsRegion(capturedRegions, region))
      if !kept {
        undecided = true
      }
      at = at + usize.ONE
    }
  }
  if undecided {
    return Verdict.Unsupported
  }
  return Verdict.Compatible
}

// Compares one implementation's header with its operation's header under the conformance head.
// Only the implementation declaration owns variables; the operation's parameters remain rigid.
effect fn witnessVerdict(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  head: &Shared<ImplementationHead>,
  operation: &Shared<Result<Answer, NoRejection>>,
  operationOwner: &DeclarationId,
  witness: &Shared<Result<Answer, NoRejection>>,
  witnessOwner: &DeclarationId,
  witnessModule: &ModuleId,
  witnessOrdinal: usize,
  witnessKey: Key,
  arguments: &mut Vector<Argument>,
) -> Verdict ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let promisedFound = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(
    operation,
    signatureFacts,
  )
  let providedFound = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(
    witness,
    signatureFacts,
  )
  let promised = match move promisedFound {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Verdict.Unsupported
    }
  }
  let provided = match move providedFound {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Verdict.Unsupported
    }
  }
  if promised.isEffect != provided.isEffect {
    return Verdict.Incompatible {problem: WitnessProblem.Kind}
  }
  if provided.isUnsafe && !promised.isUnsafe {
    return Verdict.Incompatible {problem: WitnessProblem.Safety}
  }
  if promised.parameters != provided.parameters {
    return Verdict.Incompatible {problem: WitnessProblem.OperandCount}
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(
    &mut variables,
    run Shared.make<DeclarationId>(run DeclarationId.copy(witnessOwner)),
  )
  let bindable = Vector.asSlice<Shared<DeclarationId>>(&variables)
  let mut bindings = Vector.make<Binding>()
  let mut lent = Vector.make<Shared<Lifetime>>()
  let mut at = usize.ZERO
  while at < promised.parameters {
    let promisedOperand = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      operation,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let providedOperand = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      witness,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value: left} = move promisedOperand {
      if let Option<Shared<Type>>.Some {value: right} = move providedOperand {
        let verdict = run operandVerdict(
          &left,
          &right,
          at,
          witnessOwner,
          bindable,
          &mut bindings,
          &mut lent,
        )
        if !compatible(&verdict) {
          return move verdict
        }
      }
    }
    at = at + usize.ONE
  }
  let lentRegions = Vector.asSlice<Shared<Lifetime>>(&lent)
  at = usize.ZERO
  while at < lentRegions.length {
    let ordinal = ownedLifetimeOrdinal(&lentRegions[at], witnessOwner)
    if run usesOwnedLifetime(&provided.result, witnessOwner, ordinal) {
      return Verdict.Incompatible {problem: WitnessProblem.ResultType}
    }
    at = at + usize.ONE
  }
  let result = run Type.unify(
    &promised.result,
    &provided.result,
    bindable,
    Comparison.Exact,
    &mut bindings,
  )
  match move result {
    Unification.Unified => {}
    Unification.Distinct => {
      return Verdict.Incompatible {problem: WitnessProblem.ResultType}
    }
    Unification.Undetermined {..} => {
      return Verdict.Unsupported
    }
  }
  at = usize.ZERO
  while at < lentRegions.length {
    if run usesOwnedLifetime(
      &provided.failure,
      witnessOwner,
      ownedLifetimeOrdinal(&lentRegions[at], witnessOwner),
    ) {
      return Verdict.Incompatible {problem: WitnessProblem.Failure}
    }
    at = at + usize.ONE
  }
  if unboundTypeIn(
    &provided.failure,
    witnessOwner,
    provided.binders,
    Vector.asSlice<Binding>(&bindings),
  ) {
    let failure = run Type.unify(
      &promised.failure,
      &provided.failure,
      bindable,
      Comparison.Exact,
      &mut bindings,
    )
    match move failure {
      Unification.Unified => {}
      Unification.Distinct => {
        return Verdict.Incompatible {problem: WitnessProblem.Failure}
      }
      Unification.Undetermined {..} => {
        return Verdict.Unsupported
      }
    }
  }
  if unboundRowIn(&provided.requirements, witnessOwner, Vector.asSlice<Binding>(&bindings)) {
    let promisedRow = run rowCarrier(&promised.requirements)
    let witnessRow = run rowCarrier(&provided.requirements)
    let row = run Type.bindWitnessResidual(&promisedRow, &witnessRow, bindable, &mut bindings)
    match move row {
      Unification.Unified => {}
      Unification.Distinct => {
        return Verdict.Incompatible {problem: WitnessProblem.Requirement}
      }
      Unification.Undetermined {..} => {
        return Verdict.Unsupported
      }
    }
  }
  if promised.isEffect {
    let environment = run bindEnvironmentArgument(
      operation,
      promised.environment,
      witness,
      provided.environment,
      witnessOwner,
      bindable,
      &mut bindings,
      lentRegions,
    )
    if !compatible(&environment) {
      return move environment
    }
  }
  let matched = run matchedArguments(
    provided.binders,
    witnessOwner,
    Vector.asSlice<Binding>(&bindings),
    lentRegions,
  )
  let found = match move matched {
    Option<Vector<Argument>>.Some {value} => move value
    Option<Vector<Argument>>.None => {
      return Verdict.Unsupported
    }
  }
  let mut providedBound = Shared.clone<Result<Answer, NoRejection>>(witness)
  if provided.binders > usize.ZERO {
    let rebound = run resolveSignatureUnder(
      &mut resolver.*,
      &mut owner.*,
      witnessKey,
      Vector.make<Dependency>(),
      Option.none<Vector<Argument>>(),
      Option.some<Vector<Argument>>(run copyArguments(Vector.asSlice<Argument>(&found))),
    )
    providedBound = run Shared.make<Result<Answer, NoRejection>>(
      Result.succeed<Answer, NoRejection>(move rebound),
    )
  }
  let facts = Shared.with<Result<Answer, NoRejection>, Option<SignatureFacts>>(
    &providedBound,
    signatureFacts,
  )
  let bound = match move facts {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => {
      return Verdict.Unsupported
    }
  }
  if !run witnessBoundsImplied(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    head,
    operation,
    &providedBound,
    bound.constraints,
    promised.constraints,
    witnessModule,
    Span.make(usize.ZERO, usize.ZERO),
  ) {
    return Verdict.Unsupported
  }
  if !run Type.coversFailure(&promised.failure, &bound.failure) {
    return Verdict.Incompatible {problem: WitnessProblem.Failure}
  }
  let rows = run Row.covers(&promised.requirements, &bound.requirements)
  let rowProblem = match rows {
    RowCoverage.Covered => Option.none<WitnessProblem>()
    RowCoverage.Entry => Option.some<WitnessProblem>(WitnessProblem.Requirement)
    RowCoverage.Access => Option.some<WitnessProblem>(WitnessProblem.RequirementAccess)
    RowCoverage.Parameter => Option.some<WitnessProblem>(WitnessProblem.RequirementParameter)
  }
  if let Option<WitnessProblem>.Some {value: problem} = move rowProblem {
    return Verdict.Incompatible {problem: problem}
  }
  if !promised.isEffect {
    run appendArguments(&mut arguments.*, Vector.asSlice<Argument>(&found))
    return Verdict.Compatible
  }
  let syntax = run signatureSyntax(&mut resolver.*, witnessModule, witnessOrdinal)
  let mut written = false
  if let Option<WrittenSignature>.Some {value: header} = move syntax {
    written = header.environment.present
  }
  let environment = run environmentVerdict(
    head,
    operation,
    operationOwner,
    &promised,
    &providedBound,
    witnessOwner,
    &bound,
    written,
    lentRegions,
  )
  if compatible(&environment) {
    run appendArguments(&mut arguments.*, Vector.asSlice<Argument>(&found))
  }
  return move environment
}

effect fn rejectWitness(
  module: &ModuleId,
  span: Span,
  problem: WitnessProblem,
  path: Vector<Shared<DeclarationId>>,
) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Rejection>(
    Rejection {
      code: RejectionCode.IncompatibleWitness,
      module: run ModuleId.copy(module),
      span: span,
      related: Option.none<Span>(),
      path: move path,
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option.some<WitnessProblem>(problem),
      termination: TerminationStep.Peer,
      staticFailure: Option.none<StaticDiagnostic>(),
    },
  )
}

effect fn identityPath(first: &Shared<DeclarationId>, second: Option<Shared<DeclarationId>>) -> Vector<
  Shared<DeclarationId>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut path = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut path, Shared.clone<DeclarationId>(first))
  if let Option<Shared<DeclarationId>>.Some {value} = move second {
    run Vector.append<Shared<DeclarationId>>(&mut path, move value)
  }
  return move path
}

fn operationCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      return Vector.length<Shared<DeclarationId>>(&operations)
    }
  }
  return usize.ZERO
}

fn memberCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ImplementationMembers {members}} = &value.outcome {
      return Vector.length<ImplementationMember>(&members)
    }
  }
  return usize.ZERO
}

// One written member: the declaration whose name selects an operation, the declaration that
// implements it, the member's span, and whether it maps an existing function.
struct WrittenWitness {
  declaration: Shared<DeclarationId>
  implementation: Shared<DeclarationId>
  span: Span
  mapped: bool
}

fn writtenWitness(member: &ImplementationMember) -> WrittenWitness {
  return match & member.* {
    ImplementationMember.Inline {declaration, span} => WrittenWitness {
      declaration: Shared.clone<DeclarationId>(&declaration),
      implementation: Shared.clone<DeclarationId>(&declaration),
      span: span,
      mapped: false,
    }
    ImplementationMember.Mapped {declaration, span, target} => WrittenWitness {
      declaration: Shared.clone<DeclarationId>(&declaration),
      implementation: Shared.clone<DeclarationId>(&target),
      span: span,
      mapped: true,
    }
  }
}

fn memberAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<WrittenWitness> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ImplementationMembers {members}} = &value.outcome {
      let listed = Vector.asSlice<ImplementationMember>(&members)
      if at < listed.length {
        return Option.some<WrittenWitness>(writtenWitness(&listed[at]))
      }
    }
  }
  return Option.none<WrittenWitness>()
}

fn spellingWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return same(DeclarationId.spelling(first), DeclarationId.spelling(second))
    },
  )
}

fn sameSpelling(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return spellingWith(first, right)
    },
  )
}

// The position of the member written for `operation`, or `usize.MAX`.
fn memberFor(answer: &Result<Answer, NoRejection>, operation: &Shared<DeclarationId>) -> usize {
  let count = memberCount(answer)
  let mut at = usize.ZERO
  while at < count {
    if let Option<WrittenWitness>.Some {value: member} = move memberAt(answer, at) {
      if sameSpelling(&member.declaration, operation) {
        return at
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Whether any operation of the contract has this member's name.
fn namesOperation(answer: &Result<Answer, NoRejection>, member: &Shared<DeclarationId>) -> bool {
  let count = operationCount(answer)
  let mut at = usize.ZERO
  while at < count {
    if let Option<Shared<DeclarationId>>.Some {value: operation} = move operationAt(answer, at) {
      if sameSpelling(&operation, member) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// The interned ordinal of the module that declares `identity`, or `usize.MAX`.
fn identityModuleOrdinal(resolver: &Resolver, identity: &Shared<DeclarationId>) -> usize {
  let modules = Vector.asSlice<ModuleId>(&resolver.modules)
  let mut at = usize.ZERO
  while at < modules.length {
    let candidate = &modules[at]
    if Shared.with<DeclarationId, bool>(
      identity,
      fn(declaration: &DeclarationId) -> bool {
        return ModuleId.equals(DeclarationId.moduleId(declaration), candidate)
      },
    ) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A scalar or `string` provider has no source actor, so its source witnesses are inline.
fn contractOwnedProvider(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {..} => true
    Type.String {..} => true
    _ => false
  }
}

// Pairs each contract operation of one conformance with the member that implements it and checks
// the member's header against the operation's header under the conformance head. The head, the
// member list, the contract's operation list, every operation under the head, and every
// implementation header are child answers; no body is read. The first failure in member order (an
// unknown member) and then operation order (a missing member, then an incompatible one) rejects
// the conformance, so no partial witness set is published.
effect fn resolveWitnesses(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let headKey = Key {
    family: Family.ImplementationHead,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    headKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let resolved = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move resolved {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &headAnswer,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failed {
        return memberRejected(move diagnostic, move dependencies)
      }
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let applied = Shared.with<ImplementationHead, HeadApplication>(&head, headApplication)
  let HeadApplication {contract: written, provider, span, contractSpan} = move applied
  // An inherent or sealed-property head implements no contract operation.
  let contract = match move written {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, span),
        move dependencies,
      )
    }
  }
  let membersKey = Key {
    family: Family.ImplementationMembers,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let members = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, membersKey, span)
  let refusedMembers = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &members,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedMembers {
    return memberRejected(move diagnostic, move dependencies)
  }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &contract)
  if contractModuleOrdinal == usize.MAX {
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.UnknownMember, contractSpan),
      move dependencies,
    )
  }
  let contractModule = run resolvedModule(&resolver.*, contractModuleOrdinal)
  let located = run ordinalOfProvider(&mut resolver.*, &contractModule, &contract)
  let contractOrdinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, contractSpan),
        move dependencies,
      )
    }
  }
  let operationsKey = Key {
    family: Family.Operations,
    module: contractModuleOrdinal,
    name: usize.ZERO,
    declaration: contractOrdinal,
    member: usize.ZERO,
    external: false,
  }
  let listed = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    operationsKey,
    contractSpan,
  )
  let refusedOperations = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedOperations {
    return memberRejected(move diagnostic, move dependencies)
  }
  let memberTotal = Shared.with<Result<Answer, NoRejection>, usize>(&members, memberCount)
  let mut at = usize.ZERO
  while at < memberTotal {
    let entry = Shared.with<Result<Answer, NoRejection>, Option<WrittenWitness>>(
      &members,
      fn(answer: &Result<Answer, NoRejection>) -> Option<WrittenWitness> {
        return memberAt(answer, at)
      },
    )
    if let Option<WrittenWitness>.Some {value: member} = move entry {
      let known = Shared.with<Result<Answer, NoRejection>, bool>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return namesOperation(answer, &member.declaration)
        },
      )
      if !known {
        return memberRejected(
          run rejectWitness(
            &module,
            member.span,
            WitnessProblem.Unknown,
            run identityPath(&member.declaration, Option.none<Shared<DeclarationId>>()),
          ),
          move dependencies,
        )
      }
    }
    at = at + usize.ONE
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, operationCount)
  at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operationAt(answer, at)
      },
    )
    if let Option<Shared<DeclarationId>>.Some {value: operation} = move selected {
      let position = Shared.with<Result<Answer, NoRejection>, usize>(
        &members,
        fn(answer: &Result<Answer, NoRejection>) -> usize {
          return memberFor(answer, &operation)
        },
      )
      if position == usize.MAX {
        return memberRejected(
          run rejectWitness(
            &module,
            span,
            WitnessProblem.Missing,
            run identityPath(&operation, Option.none<Shared<DeclarationId>>()),
          ),
          move dependencies,
        )
      }
    }
    at = at + usize.ONE
  }
  let scalar = Shared.with<Type, bool>(&provider, contractOwnedProvider)
  let mut witnesses = Vector.make<Witness>()
  at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operationAt(answer, at)
      },
    )
    let operation = match move selected {
      Option<Shared<DeclarationId>>.Some {value} => move value
      Option<Shared<DeclarationId>>.None => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, contractSpan),
          move dependencies,
        )
      }
    }
    let entry = Shared.with<Result<Answer, NoRejection>, Option<WrittenWitness>>(
      &members,
      fn(answer: &Result<Answer, NoRejection>) -> Option<WrittenWitness> {
        return memberAt(answer, memberFor(answer, &operation))
      },
    )
    let member = match move entry {
      Option<WrittenWitness>.Some {value} => move value
      Option<WrittenWitness>.None => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
          move dependencies,
        )
      }
    }
    if scalar && member.mapped {
      return memberRejected(
        run rejectWitness(
          &module,
          member.span,
          WitnessProblem.ScalarMapping,
          run identityPath(
            &operation,
            Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&member.implementation)),
          ),
        ),
        move dependencies,
      )
    }
    let underKey = Key {
      family: Family.OperationUnder,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: at,
      external: false,
    }
    let promised = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      underKey,
      member.span,
    )
    let refusedOperation = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &promised,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedOperation {
      return memberRejected(move diagnostic, move dependencies)
    }
    let witnessModuleOrdinal = identityModuleOrdinal(&resolver.*, &member.implementation)
    if witnessModuleOrdinal == usize.MAX {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span),
        move dependencies,
      )
    }
    let witnessModule = run resolvedModule(&resolver.*, witnessModuleOrdinal)
    let witnessFound = run ordinalOfIdentity(
      &mut resolver.*,
      &witnessModule,
      &member.implementation,
    )
    let operationFound = run ordinalOfIdentity(&mut resolver.*, &contractModule, &operation)
    let mut witnessOrdinal = usize.MAX
    let mut witnessOwner = Option.none<DeclarationId>()
    if let Option<usize>.Some {value} = move witnessFound {
      witnessOrdinal = value
      witnessOwner = run declarationAt(&mut resolver.*, &witnessModule, value)
    }
    let mut operationOwner = Option.none<DeclarationId>()
    if let Option<usize>.Some {value} = move operationFound {
      operationOwner = run declarationAt(&mut resolver.*, &contractModule, value)
    }
    let implementationOwner = match move witnessOwner {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.UnknownMember, member.span),
          move dependencies,
        )
      }
    }
    let contractOperation = match move operationOwner {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.UnknownMember, contractSpan),
          move dependencies,
        )
      }
    }
    let signatureKey = Key {
      family: Family.Signature,
      module: witnessModuleOrdinal,
      name: usize.ZERO,
      declaration: witnessOrdinal,
      member: usize.ZERO,
      external: false,
    }
    let provided = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      signatureKey,
      member.span,
    )
    let refusedWitness = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &provided,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refusedWitness {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut matchedArguments = Vector.make<Argument>()
    let verdict = run witnessVerdict(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      &head,
      &promised,
      &contractOperation,
      &provided,
      &implementationOwner,
      &witnessModule,
      witnessOrdinal,
      signatureKey,
      &mut matchedArguments,
    )
    match move verdict {
      Verdict.Compatible => {
        run Vector.append<Witness>(
          &mut witnesses,
          Witness {
            operation: move operation,
            implementation: Shared.clone<DeclarationId>(&member.implementation),
            arguments: move matchedArguments,
          },
        )
      }
      Verdict.Incompatible {problem} => {
        return memberRejected(
          run rejectWitness(
            &module,
            member.span,
            problem,
            run identityPath(
              &operation,
              Option.some<Shared<DeclarationId>>(
                Shared.clone<DeclarationId>(&member.implementation),
              ),
            ),
          ),
          move dependencies,
        )
      }
      Verdict.Unsupported => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, member.span),
          move dependencies,
        )
      }
    }
    at = at + usize.ONE
  }
  return memberSuccess(Value.Witnesses {witnesses: move witnesses}, move dependencies)
}

// Binds an enclosing scope to supplied arguments in order, after checking their count and kinds.
// Supplied arguments are not checked against the scope's bounds; that is conformance checking.
effect fn bindSupplied(
  resolver: &Resolver,
  module: &ModuleId,
  span: Span,
  formal: &[Binder],
  given: &[Argument],
) -> Result<Vector<Binder>, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  if given.length != formal.length {
    return Result.failResult<Vector<Binder>, Shared<Rejection>>(
      run rejectArity(&resolver.*, module, span, formal.length, given.length),
    )
  }
  let mut at = usize.ZERO
  while at < given.length {
    if argumentKind(&given[at]) != binderKind(&formal[at]) {
      return Result.failResult<Vector<Binder>, Shared<Rejection>>(
        run rejectKind(
          &resolver.*,
          module,
          span,
          binderName(&formal[at]),
          binderKind(&formal[at]),
          argumentKind(&given[at]),
        ),
      )
    }
    at = at + usize.ONE
  }
  return Result.succeed<Vector<Binder>, Shared<Rejection>>(run bindArguments(formal, given))
}

// Resolves a declaration's written signature, continuing the running query's `inherited`
// dependencies. The enclosing scope is always resolved as written; `supplied` then binds its
// binders in order, `Self` last, by re-resolving the header under those arguments rather than
// substituting types. The declaration's own binders stay its rigid parameters either way.
effect fn resolveSignatureUnder(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  inherited: Vector<Dependency>,
  supplied: Option<Vector<Argument>>,
  ownSupplied: Option<Vector<Argument>>,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let written = run signatureSyntax(&mut resolver.*, &module, key.declaration)
  let mut dependencies = move inherited
  if let Option<WrittenSignature>.Some {value} = move written {
    let mut publicExposure = value.isPublic
    if let Option<Vector<Argument>>.Some {..} = &supplied {
      publicExposure = false
    }
    if !value.supported {
      let diagnostic = run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span)
      return Answer {
        outcome: Outcome.Rejected {diagnostic: move diagnostic},
        dependencies: move dependencies,
        sources: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      }
    }
    let template = run templateBinders(&mut resolver.*, &module, key.declaration)
    let mut binders = match move template {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return Answer {
          outcome: Outcome.Rejected {diagnostic: move error},
          dependencies: move dependencies,
          sources: Vector.make<Shared<Observation>>(),
          footprint: Vector.make<Shared<DemandFootprint>>(),
          answerId: usize.ZERO,
          identity: Option.none<Shared<Value>>(),
          bodyEvidence: Option.none<Shared<BodyEvidence>>(),
        }
      }
    }
    let identified = run declarationAt(&mut resolver.*, &module, key.declaration)
    let signatureOwner = match move identified {
      Option<DeclarationId>.Some {value: found} => move found
      Option<DeclarationId>.None => {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
          move dependencies,
        )
      }
    }
    // The signature's own binders come first, one-to-one with its written generic list; the
    // enclosing contract's binders and `Self` follow and keep their own declaration identities.
    let ownCount = Vector.length<Binder>(&binders)
    if let Option<Vector<Argument>>.Some {value: arguments} = &ownSupplied {
      if Vector.length<Argument>(&arguments) < ownCount {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, value.span),
          move dependencies,
        )
      }
      binders = run bindArguments(
        Vector.asSlice<Binder>(&binders),
        Vector.asSlice<Argument>(&arguments),
      )
    }
    let scope = run enclosingScope(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      key.declaration,
    )
    let mut enclosing = match move scope {
      Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    if let Option<Vector<Argument>>.Some {value: arguments} = move supplied {
      let bound = run bindSupplied(
        &resolver.*,
        &module,
        value.span,
        Vector.asSlice<Binder>(&enclosing),
        Vector.asSlice<Argument>(&arguments),
      )
      match move bound {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value: applied} => {
          enclosing = move applied
        }
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
    }
    let visible = Vector.asSlice<Binder>(&enclosing)
    // An inherent member may restate an owner binder to add bounds for that member alone; the
    // restated binder keeps the owner's identity. Elsewhere a restated spelling stays unsupported.
    let refines = run refinesEnclosing(&mut resolver.*, &module, key.declaration)
    let conflict = run scopedBinderRejection(
      &mut resolver.*,
      &module,
      value.generics,
      visible,
      hasBinder(visible, b"Self"),
      refines,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move conflict {
      return memberRejected(move diagnostic, move dependencies)
    }
    let mut own = Vector.make<Binder>()
    let mut ownAt = usize.ZERO
    while ownAt < ownCount {
      let restated = run restatedBinder(&binders, ownAt, visible, refines)
      if let Option<Binder>.Some {value: binder} = move restated {
        Vector.set<Binder>(&mut binders, ownAt, move binder)
      } else {
        run Vector.append<Binder>(&mut own, run binderAt(&binders, ownAt))
      }
      ownAt = ownAt + usize.ONE
    }
    let lists = run parametersOf(Vector.asSlice<Binder>(&own))
    let mut visibleAt = usize.ZERO
    while visibleAt < visible.length {
      run Vector.append<Binder>(&mut binders, run copyBinder(&visible[visibleAt]))
      visibleAt = visibleAt + usize.ONE
    }
    let mut lifetimeParameters = move lists.lifetimes
    let mut elision = LifetimeElision {
      owner: Option.some<DeclarationId>(run DeclarationId.copy(&signatureOwner)),
      nextOrdinal: ownCount,
      output: false,
      resultDefault: Option.none<Shared<Lifetime>>(),
      generated: Vector.make<Shared<Lifetime>>(),
      invocation: false,
      nested: false,
      renumber: Vector.make<usize>(),
      staticEnvironment: false,
      supplied: move ownSupplied,
      assumptions: Option.none<Vector<Constraint>>(),
    }
    let declared = run resolveConstraints(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      value.generics,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
      value.isPublic,
    )
    let constraints = match move declared {
      Result<Vector<Constraint>, Shared<Rejection>>.Success {value: found} => move found
      Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    elision.assumptions = Option.some<Vector<Constraint>>(
      run copyConstraints(Vector.asSlice<Constraint>(&constraints)),
    )
    let representations = run representationsOf(
      &signatureOwner,
      ownCount,
      Vector.asSlice<Constraint>(&constraints),
    )
    let mut environment = Option.none<Intersection>()
    if value.environment.present {
      let written = run writtenEnvironment(
        &mut resolver.*,
        &module,
        value.environment.range,
        value.span,
        Vector.asSlice<Binder>(&binders),
      )
      match move written {
        Result<Intersection, Shared<Rejection>>.Success {value: region} => {
          environment = Option.some<Intersection>(move region)
        }
        Result<Intersection, Shared<Rejection>>.Failure {error} => {
          return memberRejected(move error, move dependencies)
        }
      }
    }
    let mut parameters = Vector.make<Shared<Type>>()
    let mut inputCount = usize.ZERO
    let mut inputLifetime = Option.none<Shared<Lifetime>>()
    // The regions every input would retain if captured, and the first input whose stored contents
    // are unknown because they involve a type parameter without a representation contract.
    let mut retained = Vector.make<Shared<Lifetime>>()
    let mut hasUnknown = false
    let mut unknownSpan = Span.make(usize.ZERO, usize.ZERO)
    let entries = Vector.asSlice<HirId>(&value.parameters)
    let mut at = usize.ZERO
    while at < entries.length {
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        entries[at],
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let existential = run existentialRejection(&mut resolver.*, &module, entries[at], &ty)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
            return memberRejected(move diagnostic, move dependencies)
          }
          let exposure = run exposedPrivate(
            &mut resolver.*,
            &module,
            entries[at],
            &ty,
            publicExposure,
          )
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          let outer = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, outerLifetime)
          if let Option<Shared<Lifetime>>.Some {value: lifetime} = move outer {
            inputCount = inputCount + usize.ONE
            inputLifetime = Option.some<Shared<Lifetime>>(move lifetime)
          }
          let known = run Type.retainedRegions(
            &ty,
            &signatureOwner,
            Vector.asSlice<Option<Shared<Type>>>(&representations),
            &mut retained,
          )
          if !known && !hasUnknown {
            hasUnknown = true
            let written = run typeNode(&mut resolver.*, &module, entries[at])
            if let Option<HeaderSyntax>.Some {value: parameterSyntax} = move written {
              unknownSpan = parameterSyntax.span
            }
          }
          run Vector.append<Shared<Type>>(&mut parameters, move ty)
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
      at = at + usize.ONE
    }
    let mut result = run Shared.make<Type>(Type.Unit)
    elision.output = true
    // An `effect fn` captures every input, so its omitted environment is the intersection of the
    // regions its inputs retain: borrows, nominal lifetime arguments, and callable or Effect
    // environments, including a representation parameter's contract environment; `'static` when
    // they retain none. A callable's or Effect's channels are not stored, but stored contents
    // involving any other type parameter have no nameable region, so the environment must be
    // written.
    if value.isEffect && !value.environment.present {
      if hasUnknown {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.AmbiguousLifetime, unknownSpan),
          move dependencies,
        )
      }
      environment = Option.some<Intersection>(
        run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&retained)),
      )
    }
    if inputCount == usize.ONE {
      elision.resultDefault = move inputLifetime
    }
    // Inputs that retain nothing give an ordinary function's omitted `Effect` result environment
    // nothing to retain. An `effect fn` success type gets no such default. Otherwise the
    // established elision applies.
    let closed = !value.isEffect && !hasUnknown && Vector.length<Shared<Lifetime>>(&retained) == usize.ZERO
    if let Option<HirId>.Some {value: id} = move value.result {
      if closed {
        elision.staticEnvironment = run effectResult(
          &mut resolver.*,
          &module,
          id,
          Vector.asSlice<Binder>(&binders),
        )
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        id,
        Vector.asSlice<Binder>(&binders),
        &mut elision,
      )
      match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          let existential = run existentialRejection(&mut resolver.*, &module, id, &ty)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move existential {
            return memberRejected(move diagnostic, move dependencies)
          }
          let exposure = run exposedPrivate(&mut resolver.*, &module, id, &ty, publicExposure)
          if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
            return Answer {
              outcome: Outcome.Rejected {diagnostic: move diagnostic},
              dependencies: move dependencies,
              sources: Vector.make<Shared<Observation>>(),
              footprint: Vector.make<Shared<DemandFootprint>>(),
              answerId: usize.ZERO,
              identity: Option.none<Shared<Value>>(),
              bodyEvidence: Option.none<Shared<BodyEvidence>>(),
            }
          }
          result = move ty
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return Answer {
            outcome: Outcome.Rejected {diagnostic: move error},
            dependencies: move dependencies,
            sources: Vector.make<Shared<Observation>>(),
            footprint: Vector.make<Shared<DemandFootprint>>(),
            answerId: usize.ZERO,
            identity: Option.none<Shared<Value>>(),
            bodyEvidence: Option.none<Shared<BodyEvidence>>(),
          }
        }
      }
    }
    if value.failures.present && !value.isEffect {
      let syntax = run typeNode(&mut resolver.*, &module, value.failures.id)
      if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.EffectChannelOnOrdinary, channel.span),
          move dependencies,
        )
      }
    }
    if value.requirements.present && !value.isEffect {
      let syntax = run typeNode(&mut resolver.*, &module, value.requirements.id)
      if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.EffectChannelOnOrdinary, channel.span),
          move dependencies,
        )
      }
    }
    let resolvedChannels = run resolveChannels(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      &module,
      value.failures,
      value.requirements,
      Vector.asSlice<Binder>(&binders),
      &mut elision,
    )
    let channels = match move resolvedChannels {
      Result<Channels, Shared<Rejection>>.Success {value: found} => move found
      Result<Channels, Shared<Rejection>>.Failure {error} => {
        return memberRejected(move error, move dependencies)
      }
    }
    if value.failures.present {
      let exposure = run exposedPrivate(
        &mut resolver.*,
        &module,
        value.failures.id,
        &channels.failure,
        publicExposure,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move exposure {
        return memberRejected(move diagnostic, move dependencies)
      }
    }
    if publicExposure && Shared.with<Row, bool>(&channels.requirements, privateRow) {
      let syntax = run typeNode(&mut resolver.*, &module, value.requirements.id)
      if let Option<HeaderSyntax>.Some {value: channel} = move syntax {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.PrivateTypeExposure, channel.span),
          move dependencies,
        )
      }
    }
    let generated = Vector.asSlice<Shared<Lifetime>>(&elision.generated)
    let mut generatedAt = usize.ZERO
    while generatedAt < generated.length {
      run Vector.append<Shared<Lifetime>>(
        &mut lifetimeParameters,
        Shared.clone<Lifetime>(&generated[generatedAt]),
      )
      generatedAt = generatedAt + usize.ONE
    }
    // An inherent member's contract lists the owner binders it mentions, every one when it names
    // `Self`, in declaration order, before the member's own binders.
    let mut typeParameters = Vector.make<Shared<Type>>()
    let mut allLifetimes = Vector.make<Shared<Lifetime>>()
    let mut rowParameters = Vector.make<RowParameter>()
    if refines {
      let enclosingOwner = run enclosingIdentity(&mut resolver.*, &module, key.declaration)
      if let Option<DeclarationId>.Some {value: implementation} = move enclosingOwner {
        let mut types = Vector.make<usize>()
        let mut regions = Vector.make<usize>()
        let mut rows = Vector.make<usize>()
        let written = Vector.asSlice<Shared<Type>>(&parameters)
        let mut writtenAt = usize.ZERO
        while writtenAt < written.length {
          run Type.collectOwned(
            &written[writtenAt],
            &implementation,
            &mut types,
            &mut regions,
            &mut rows,
          )
          writtenAt = writtenAt + usize.ONE
        }
        run Type.collectOwned(&result, &implementation, &mut types, &mut regions, &mut rows)
        run Type.collectOwned(
          &channels.failure,
          &implementation,
          &mut types,
          &mut regions,
          &mut rows,
        )
        run Type.collectOwnedRow(
          &channels.requirements,
          &implementation,
          &mut types,
          &mut regions,
          &mut rows,
        )
        // A written `effect<'a> fn` environment can mention an owner lifetime nothing else does.
        if let Option<Intersection>.Some {value: declaredEnvironment} = &environment {
          let retainedRegions = Vector.asSlice<LifetimeMember>(&declaredEnvironment.members)
          let mut regionAt = usize.ZERO
          while regionAt < retainedRegions.length {
            run Type.collectOwnedLifetime(
              &retainedRegions[regionAt].region,
              &implementation,
              &mut regions,
            )
            regionAt = regionAt + usize.ONE
          }
        }
        let declared = Vector.asSlice<Constraint>(&constraints)
        let mut declaredAt = usize.ZERO
        while declaredAt < declared.length {
          run collectConstraint(
            &declared[declaredAt],
            &implementation,
            &mut types,
            &mut regions,
            &mut rows,
          )
          declaredAt = declaredAt + usize.ONE
        }
        let sharedOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(&implementation))
        let sortedTypes = run sortedOrdinals(&types)
        let typeOrdinals = Vector.asSlice<usize>(&sortedTypes)
        let mut ordinalAt = usize.ZERO
        while ordinalAt < typeOrdinals.length {
          run Vector.append<Shared<Type>>(
            &mut typeParameters,
            run Shared.make<Type>(
              Type.Parameter {
                declaration: run DeclarationId.copy(&implementation),
                ordinal: typeOrdinals[ordinalAt],
              },
            ),
          )
          ordinalAt = ordinalAt + usize.ONE
        }
        let sortedRegions = run sortedOrdinals(&regions)
        let regionOrdinals = Vector.asSlice<usize>(&sortedRegions)
        ordinalAt = usize.ZERO
        while ordinalAt < regionOrdinals.length {
          run Vector.append<Shared<Lifetime>>(
            &mut allLifetimes,
            run Shared.make<Lifetime>(
              Lifetime.Parameter {
                declaration: run DeclarationId.copy(&implementation),
                ordinal: regionOrdinals[ordinalAt],
              },
            ),
          )
          ordinalAt = ordinalAt + usize.ONE
        }
        let sortedRows = run sortedOrdinals(&rows)
        let rowOrdinals = Vector.asSlice<usize>(&sortedRows)
        ordinalAt = usize.ZERO
        while ordinalAt < rowOrdinals.length {
          run Vector.append<RowParameter>(
            &mut rowParameters,
            RowParameter {
              declaration: Shared.clone<DeclarationId>(&sharedOwner),
              ordinal: rowOrdinals[ordinalAt],
            },
          )
          ordinalAt = ordinalAt + usize.ONE
        }
      }
    }
    let ownTypes = Vector.asSlice<Shared<Type>>(&lists.types)
    let mut listedAt = usize.ZERO
    while listedAt < ownTypes.length {
      run Vector.append<Shared<Type>>(&mut typeParameters, Shared.clone<Type>(&ownTypes[listedAt]))
      listedAt = listedAt + usize.ONE
    }
    let ownLifetimes = Vector.asSlice<Shared<Lifetime>>(&lifetimeParameters)
    listedAt = usize.ZERO
    while listedAt < ownLifetimes.length {
      run Vector.append<Shared<Lifetime>>(
        &mut allLifetimes,
        Shared.clone<Lifetime>(&ownLifetimes[listedAt]),
      )
      listedAt = listedAt + usize.ONE
    }
    let ownRows = Vector.asSlice<RowParameter>(&lists.rows)
    listedAt = usize.ZERO
    while listedAt < ownRows.length {
      run Vector.append<RowParameter>(
        &mut rowParameters,
        RowParameter {
          declaration: Shared.clone<DeclarationId>(&ownRows[listedAt].declaration),
          ordinal: ownRows[listedAt].ordinal,
        },
      )
      listedAt = listedAt + usize.ONE
    }
    return Answer {
      outcome: Outcome.Success {
        value: Value.Signature {
          signature: Signature {
            typeParameters: move typeParameters,
            lifetimeParameters: move allLifetimes,
            rowParameters: move rowParameters,
            constraints: move constraints,
            parameters: move parameters,
            result: move result,
            failure: move channels.failure,
            requirements: move channels.requirements,
            isEffect: value.isEffect,
            isUnsafe: value.isUnsafe,
            environment: move environment,
          },
        },
      },
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  let diagnostic = run reject(
    &resolver.*,
    &module,
    RejectionCode.Unsupported,
    Span.make(usize.ZERO, usize.ZERO),
  )
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&signature.result),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn signatureParameterCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.parameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureParameterAt(answer: &Result<Answer, NoRejection>, index: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        if index < parameters.length {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[index]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn answerTypedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => Option.some<Shared<TypedBody>>(
        Shared.clone<TypedBody>(&body),
      )
      _ => Option.none<Shared<TypedBody>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<TypedBody>>()
  }
}

fn answerMirIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Mir {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<usize>()
  }
}

fn answerInstanceIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Instance {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<usize>()
  }
}

fn answerBackendGap(answer: &Result<Answer, NoRejection>) -> Option<Shared<BackendGap>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Unsupported {gap}} => Option.some<Shared<BackendGap>>(
        Shared.clone<BackendGap>(&gap),
      )
      _ => Option.none<Shared<BackendGap>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<BackendGap>>()
  }
}

fn answerLayoutUnsupported(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: selected} => match move selected {
        Value.LayoutUnsupported => true
        _ => false
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn signatureBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.typeParameters,
      ) + Vector.length<Shared<Lifetime>>(&signature.lifetimeParameters) + Vector.length<
        RowParameter,
      >(&signature.rowParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureTypeParameterCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.typeParameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureNonLifetimeBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Shared<Type>>(
        &signature.typeParameters,
      ) + Vector.length<RowParameter>(&signature.rowParameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureConstraintCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length<Constraint>(
        &signature.constraints,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn bindingArgumentAt(bindings: &[Binding], ordinal: usize) -> Option<Argument> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal {
      return match & bindings[at].value {
        Argument.Type {value} => Option.some<Argument>(
          Argument.Type {value: Shared.clone<Type>(&value)},
        )
        Argument.Lifetime {value} => Option.some<Argument>(
          Argument.Lifetime {value: Shared.clone<Lifetime>(&value)},
        )
        Argument.Row {value} => Option.some<Argument>(
          Argument.Row {value: Shared.clone<Row>(&value)},
        )
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

fn signatureParameter(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        if at < parameters.length {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[at]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn signatureConstraint(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let constraints = Vector.asSlice<Constraint>(&signature.constraints)
        if at < constraints.length {
          return Option.some<Constraint>(copyConstraint(&constraints[at]))
        }
        return Option.none<Constraint>()
      }
      _ => Option.none<Constraint>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Constraint>()
  }
}

fn contractProvider(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => match & contract.provider {
        Option<Shared<Type>>.Some {value: provider} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&provider),
        )
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

effect fn inferenceArgumentOpen(argument: &Argument) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match & argument.* {
    Argument.Type {value} => Type.hasOpenParameters(&value)
    Argument.Lifetime {value} => Shared.with<Lifetime, bool>(
      &value,
      fn(region: &Lifetime) -> bool {
        return match & region.* {
          Lifetime.Parameter {..} => true
          _ => false
        }
      },
    )
    Argument.Row {value} => {
      let carrier = run rowCarrier(&value)
      return Type.hasOpenParameters(&carrier)
    }
  }
}

// A caller's written bound is itself direct evidence even when its provider is an abstract type
// parameter. It cannot choose a concrete conformance for an unknown provider.
effect fn inferFromDeclaredBound(
  resolver: &Resolver,
  module: &ModuleId,
  provider: &Shared<Type>,
  contract: &Shared<Type>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut Vector<Binding>,
  span: Span,
) -> Option<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = Option.none<Vector<Binding>>()
  let mut undecided = false
  let mut boundAt = usize.ZERO
  while boundAt < declared.length {
    if let Constraint.Conforms {provider: assumedProvider, contract: assumedContract} = &declared[boundAt] {
      let mut left = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(provider))
      run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(contract))
      let mut right = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&assumedProvider))
      run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&assumedContract))
      let mut variables = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(
        &mut variables,
        Shared.clone<DeclarationId>(callOwner),
      )
      let mut trial = Vector.make<Binding>()
      let fixed = Vector.asSlice<Binding>(&inferred.*)
      let mut fixedAt = usize.ZERO
      while fixedAt < fixed.length {
        run Vector.append<Binding>(
          &mut trial,
          Binding {
            declaration: Shared.clone<DeclarationId>(&fixed[fixedAt].declaration),
            ordinal: fixed[fixedAt].ordinal,
            value: copyArgument(&fixed[fixedAt].value),
          },
        )
        fixedAt = fixedAt + usize.ONE
      }
      let matched = run Type.unifyAll(
        Vector.asSlice<Shared<Type>>(&left),
        Vector.asSlice<Shared<Type>>(&right),
        Vector.asSlice<Shared<DeclarationId>>(&variables),
        Comparison.Exact,
        &mut trial,
      )
      match move matched {
        Unification.Unified => {
          if let Option<Vector<Binding>>.Some {..} = &selected {
            return Option.some<Shared<Rejection>>(
              run reject(resolver, module, RejectionCode.UninferredParameter, span),
            )
          }
          selected = Option.some<Vector<Binding>>(move trial)
        }
        Unification.Undetermined {at: unresolved} => {
          drop unresolved
          undecided = true
        }
        Unification.Distinct => ()
      }
    }
    boundAt = boundAt + usize.ONE
  }
  if undecided {
    return Option.some<Shared<Rejection>>(
      run reject(resolver, module, RejectionCode.Unsupported, span),
    )
  }
  if let Option<Vector<Binding>>.Some {value: evidence} = move selected {
    let entries = Vector.asSlice<Binding>(&evidence)
    let mut at = usize.ZERO
    while at < entries.length {
      if sameDeclarationShared(&entries[at].declaration, callOwner) {
        let prior = bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), entries[at].ordinal)
        if let Option<Argument>.None = move prior {
          run Vector.append<Binding>(
            &mut inferred.*,
            Binding {
              declaration: Shared.clone<DeclarationId>(callOwner),
              ordinal: entries[at].ordinal,
              value: copyArgument(&entries[at].value),
            },
          )
        }
      }
      at = at + usize.ONE
    }
  }
  return Option.none<Shared<Rejection>>()
}

// Each bound may contribute arguments from its own uniquely selected, coherent direct
// conformance. Match the provider first: this fixes an impl's own parameters before its
// interface arguments are compared with the call's still-open parameters.
effect fn inferFromProviderBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  signature: &Shared<Result<Answer, NoRejection>>,
  callOwner: &Shared<DeclarationId>,
  declared: &[Constraint],
  inferred: &mut Vector<Binding>,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureConstraintCount)
  let mut boundAt = usize.ZERO
  while boundAt < count {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraint(answer, boundAt)
      },
    )
    if let Option<Constraint>.Some {value: direct} = move bound {
      if let Constraint.Conforms {provider, contract} = move direct {
        let providerOrdinal = Shared.with<Type, usize>(
          &provider,
          fn(value: &Type) -> usize {
            return match & value.* {
              Type.Parameter {declaration, ordinal} => {
                if declarationEqualsShared(&declaration, callOwner) {
                  return ordinal
                }
                return usize.MAX
              }
              _ => usize.MAX
            }
          },
        )
        let mut knownProvider = Shared.clone<Type>(&provider)
        if providerOrdinal != usize.MAX {
          let fixed = bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), providerOrdinal)
          if let Option<Argument>.Some {value: argument} = move fixed {
            if let Argument.Type {value} = move argument {
              knownProvider = move value
            }
          }
        }
        if Type.hasOpenParameters(&knownProvider) && Type.hasOpenParameters(&contract) {
          let failed = run inferFromDeclaredBound(
            &resolver.*,
            module,
            &provider,
            &contract,
            callOwner,
            declared,
            &mut inferred.*,
            span,
          )
          if let Option<Shared<Rejection>>.Some {value} = move failed {
            return Option.some<Shared<Rejection>>(move value)
          }
        }
        if !Type.hasOpenParameters(&knownProvider) && Type.hasOpenParameters(&contract) {
          let contractModule = declaringModuleOrdinal(&resolver.*, &contract)
          if contractModule == usize.MAX {
            fail InvalidModulePath {}
          }
          let contractSource = run resolvedModule(&resolver.*, contractModule)
          let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractSource, &contract)
          let contractPosition = match move contractOrdinal {
            Option<usize>.Some {value} => value
            Option<usize>.None => {
              return Option.some<Shared<Rejection>>(
                run reject(&resolver.*, module, RejectionCode.Unsupported, span),
              )
            }
          }
          let providerApplication = run internApplication(&mut resolver.*, &knownProvider)
          let bucket = run demandChild(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            Key {
              family: Family.ConformanceHeads,
              module: contractModule,
              name: providerApplication,
              declaration: contractPosition,
              member: usize.ZERO,
              external: false,
            },
            span,
          )
          let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
            &bucket,
            answerRejection,
          )
          if let Option<Shared<Rejection>>.Some {value} = move rejected {
            return Option.some<Shared<Rejection>>(move value)
          }
          let candidates = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
          let mut selected = Option.none<Vector<Binding>>()
          let mut undecided = false
          let mut candidateAt = usize.ZERO
          while candidateAt < candidates {
            let candidate = Shared.with<
              Result<Answer, NoRejection>,
              Option<Shared<ImplementationHead>>,
            >(
              &bucket,
              fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
                return bucketAt(answer, candidateAt)
              },
            )
            if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
              let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(&head, headTerms)
              if let Option<HeadTerms>.Some {value: found} = move terms {
                let headModule = Shared.with<DeclarationId, usize>(
                  &found.declaration,
                  fn(value: &DeclarationId) -> usize {
                    return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
                  },
                )
                if headModule == usize.MAX {
                  fail InvalidModulePath {}
                }
                let headSource = run resolvedModule(&resolver.*, headModule)
                let headOrdinal = run ordinalOfIdentity(
                  &mut resolver.*,
                  &headSource,
                  &found.declaration,
                )
                let headPosition = match move headOrdinal {
                  Option<usize>.Some {value} => value
                  Option<usize>.None => {
                    return Option.some<Shared<Rejection>>(
                      run reject(&resolver.*, module, RejectionCode.UnknownMember, span),
                    )
                  }
                }
                let coherence = run demandChild(
                  &mut resolver.*,
                  &mut owner.*,
                  &mut dependencies.*,
                  Key {
                    family: Family.Coherence,
                    module: headModule,
                    name: usize.ZERO,
                    declaration: headPosition,
                    member: usize.ZERO,
                    external: false,
                  },
                  span,
                )
                let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
                  &coherence,
                  answerRejection,
                )
                if let Option<Shared<Rejection>>.Some {value} = move invalid {
                  return Option.some<Shared<Rejection>>(move value)
                }
                let mut left = Vector.make<Shared<Type>>()
                run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(&found.provider))
                run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(&contract))
                let mut right = Vector.make<Shared<Type>>()
                run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&knownProvider))
                run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&found.contract))
                let mut variables = Vector.make<Shared<DeclarationId>>()
                run Vector.append<Shared<DeclarationId>>(&mut variables, move found.declaration)
                run Vector.append<Shared<DeclarationId>>(
                  &mut variables,
                  Shared.clone<DeclarationId>(&callOwner),
                )
                let mut trial = Vector.make<Binding>()
                let fixed = Vector.asSlice<Binding>(&inferred.*)
                let mut fixedAt = usize.ZERO
                while fixedAt < fixed.length {
                  run Vector.append<Binding>(
                    &mut trial,
                    Binding {
                      declaration: Shared.clone<DeclarationId>(&fixed[fixedAt].declaration),
                      ordinal: fixed[fixedAt].ordinal,
                      value: copyArgument(&fixed[fixedAt].value),
                    },
                  )
                  fixedAt = fixedAt + usize.ONE
                }
                let matched = run Type.unifyAll(
                  Vector.asSlice<Shared<Type>>(&left),
                  Vector.asSlice<Shared<Type>>(&right),
                  Vector.asSlice<Shared<DeclarationId>>(&variables),
                  Comparison.Exact,
                  &mut trial,
                )
                match move matched {
                  Unification.Unified => {
                    if let Option<Vector<Binding>>.Some {..} = &selected {
                      return Option.some<Shared<Rejection>>(
                        run reject(&resolver.*, module, RejectionCode.UninferredParameter, span),
                      )
                    }
                    selected = Option.some<Vector<Binding>>(move trial)
                  }
                  Unification.Undetermined {at: unresolved} => {
                    drop unresolved
                    undecided = true
                  }
                  Unification.Distinct => ()
                }
              }
            }
            candidateAt = candidateAt + usize.ONE
          }
          if undecided {
            return Option.some<Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Unsupported, span),
            )
          }
          if let Option<Vector<Binding>>.Some {value: evidence} = move selected {
            let entries = Vector.asSlice<Binding>(&evidence)
            let mut evidenceAt = usize.ZERO
            while evidenceAt < entries.length {
              let entry = &entries[evidenceAt]
              if sameDeclarationShared(&entry.declaration, callOwner) {
                let prior = bindingArgumentAt(Vector.asSlice<Binding>(&inferred.*), entry.ordinal)
                if let Option<Argument>.None = move prior {
                  if run inferenceArgumentOpen(&entry.value) {
                    return Option.some<Shared<Rejection>>(
                      run reject(&resolver.*, module, RejectionCode.Unsupported, span),
                    )
                  }
                  run Vector.append<Binding>(
                    &mut inferred.*,
                    Binding {
                      declaration: Shared.clone<DeclarationId>(callOwner),
                      ordinal: entry.ordinal,
                      value: copyArgument(&entry.value),
                    },
                  )
                }
              }
              evidenceAt = evidenceAt + usize.ONE
            }
          }
        }
      }
    }
    boundAt = boundAt + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

// Effect construction and unsafe acknowledgement are outside the scalar body subset.
fn signatureOutsideScalarBodies(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => signature.isEffect || signature.isUnsafe
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn answerRejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      _ => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn fixedIntegerName(name: &[u8]) -> bool {
  return same(name, b"i8") || same(name, b"i16") || same(name, b"i32") || same(name, b"i64") || same(
    name,
    b"u8",
  ) || same(name, b"u16") || same(name, b"u32") || same(name, b"u64")
}

fn pointerSizedIntegerName(name: &[u8]) -> bool {
  return same(name, b"isize") || same(name, b"usize")
}

fn scalarType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Unit => true
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"bool") || fixedIntegerName(
      Bytes.asSlice(&name),
    )
    _ => false
  }
}

fn fixedIntegerType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Primitive {name} => fixedIntegerName(Bytes.asSlice(&name))
    _ => false
  }
}

fn pointerSizedIntegerType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Primitive {name} => pointerSizedIntegerName(Bytes.asSlice(&name))
    _ => false
  }
}

fn neverType(typeValue: &Type) -> bool {
  return match & typeValue.* {
    Type.Union {members} => Vector.length<Shared<Type>>(&members) == usize.ZERO
    _ => false
  }
}

fn scalarCode(typeValue: &Type) -> usize {
  return match & typeValue.* {
    Type.Unit => 1
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      if same(spelling, b"bool") {
        return 2
      }
      if same(spelling, b"i8") {
        return 3
      }
      if same(spelling, b"i16") {
        return 4
      }
      if same(spelling, b"i32") {
        return 5
      }
      if same(spelling, b"i64") {
        return 6
      }
      if same(spelling, b"u8") {
        return 7
      }
      if same(spelling, b"u16") {
        return 8
      }
      if same(spelling, b"u32") {
        return 9
      }
      if same(spelling, b"u64") {
        return 10
      }
      return usize.ZERO
    }
    _ => usize.ZERO
  }
}

// An enum participates in the closed equality contract only when the canonical nominal type
// resolves to a scalar enum declaration. A struct with the same representation has no privilege.
effect fn operatorFamily(resolver: &mut Resolver, ty: &Shared<Type>) -> Operator.Family
! Cycle | OutOfMemoryError
? &mut Allocator {
  let declaring = declaringModuleOrdinal(&resolver.*, ty)
  let mut isScalarEnum = false
  if declaring != usize.MAX {
    let module = run resolvedModule(&resolver.*, declaring)
    let ordinal = run ordinalOfProvider(&mut resolver.*, &module, ty)
    if let Option<usize>.Some {value} = move ordinal {
      let written = run header(&mut resolver.*, &module, value)
      if let Option<HeaderSyntax>.Some {value: syntax} = move written {
        if let Node.EnumHeader {..} = syntax.header {
          isScalarEnum = true
        }
      }
    }
  }
  return Shared.with<Type, Operator.Family>(
    ty,
    fn(value: &Type) -> Operator.Family {
      return Operator.family(value, isScalarEnum)
    },
  )
}

fn fitsMagnitude(magnitude: &[u8], maximum: &[u8]) -> bool {
  if magnitude.length != maximum.length {
    return magnitude.length < maximum.length
  }
  let mut at = usize.ZERO
  while at < magnitude.length {
    if magnitude[at] != maximum[at] {
      return magnitude[at] < maximum[at]
    }
    at = at + usize.ONE
  }
  return true
}

fn fitsInteger(target: &MachineTarget, name: &[u8], sign: Sign, magnitude: &[u8]) -> bool {
  if sign == Sign.Negative && magnitude.length == 1 && magnitude[0] == 48 {
    return true
  }
  if same(name, b"isize") {
    return MachineTarget.fitsIsize(target, sign == Sign.Negative, magnitude)
  }
  if same(name, b"usize") {
    return sign != Sign.Negative && MachineTarget.fitsUsize(target, magnitude)
  }
  if same(name, b"i8") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"128")
    }
    return fitsMagnitude(magnitude, b"127")
  }
  if same(name, b"i16") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"32768")
    }
    return fitsMagnitude(magnitude, b"32767")
  }
  if same(name, b"i32") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"2147483648")
    }
    return fitsMagnitude(magnitude, b"2147483647")
  }
  if same(name, b"i64") {
    if sign == Sign.Negative {
      return fitsMagnitude(magnitude, b"9223372036854775808")
    }
    return fitsMagnitude(magnitude, b"9223372036854775807")
  }
  if sign == Sign.Negative {
    return false
  }
  if same(name, b"u8") {
    return fitsMagnitude(magnitude, b"255")
  }
  if same(name, b"u16") {
    return fitsMagnitude(magnitude, b"65535")
  }
  if same(name, b"u32") {
    return fitsMagnitude(magnitude, b"4294967295")
  }
  if same(name, b"u64") {
    return fitsMagnitude(magnitude, b"18446744073709551615")
  }
  return false
}

effect fn primitiveType(name: &[u8]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)})
}

effect fn intrinsicValueType(kind: IntrinsicValueKind) -> Shared<Type>
! OutOfMemoryError
? &mut Allocator {
  return match kind {
    IntrinsicValueKind.U8 => run primitiveType(b"u8")
    IntrinsicValueKind.U32 => run primitiveType(b"u32")
    IntrinsicValueKind.Usize => run primitiveType(b"usize")
    IntrinsicValueKind.Bool => run primitiveType(b"bool")
    IntrinsicValueKind.Text => run Shared.make<Type>(
      Type.String {lifetime: run Shared.make<Lifetime>(Lifetime.Static)},
    )
    IntrinsicValueKind.StaticText => run Shared.make<Type>(
      Type.String {lifetime: run Shared.make<Lifetime>(Lifetime.Static)},
    )
  }
}

effect fn bodyRejection(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Result<
  BodyNodeId,
  Shared<Rejection>,
> ! OutOfMemoryError ? &mut Allocator {
  return Result.failResult<BodyNodeId, Shared<Rejection>>(run reject(resolver, module, code, span))
}

effect fn collectCall(hir: &Module, expression: HirId, calls: &mut Vector<CallSyntax>) -> ()
! OutOfMemoryError
? &mut Allocator {
  if let Node.MoveExpression {operand} = Module.node(hir, expression) {
    run collectCall(hir, operand, &mut calls.*)
    return ()
  }
  if let Node.PrefixExpression {operand, ..} = Module.node(hir, expression) {
    run collectCall(hir, operand, &mut calls.*)
    return ()
  }
  if let Node.InfixExpression {left, right, ..} = Module.node(hir, expression) {
    run collectCall(hir, left, &mut calls.*)
    run collectCall(hir, right, &mut calls.*)
    return ()
  }
  if let Node.IdentifierExpression {name, binding} = Module.node(hir, expression) {
    if !binding.present {
      if let Node.Name {text} = Module.node(hir, name) {
        run Vector.append<CallSyntax>(
          &mut calls.*,
          CallSyntax {
            id: expression,
            span: Module.span(hir, name),
            reference: CallReference.Unbound {name: run Bytes.copy(Module.text(hir, text))},
            generics: HirRef.absent(),
          },
        )
      }
    }
    return ()
  }
  if let Node.FieldExpression {subject, field} = Module.node(hir, expression) {
    if let Node.IdentifierExpression {name, binding} = Module.node(hir, subject) {
      if !binding.present {
        if let Node.Name {text: namespace} = Module.node(hir, name) {
          if let Node.Name {text: member} = Module.node(hir, field) {
            run Vector.append<CallSyntax>(
              &mut calls.*,
              CallSyntax {
                id: expression,
                span: Module.span(hir, expression),
                reference: CallReference.Qualified {
                  namespace: run Bytes.copy(Module.text(hir, namespace)),
                  member: run Bytes.copy(Module.text(hir, member)),
                  subjectSpan: Module.span(hir, subject),
                  memberSpan: Module.span(hir, field),
                },
                generics: HirRef.absent(),
              },
            )
          }
        }
      }
    }
    return ()
  }
  if let Node.CallExpression {callee, generics, arguments} = Module.node(hir, expression) {
    let mut reference = CallReference.Unsupported
    let mut receiverCall = false

    match Module.node(hir, callee) {
      Node.IdentifierExpression {name, binding} => {
        if binding.present {
          reference = CallReference.NonCallable
        } else if let Node.Name {text} = Module.node(hir, name) {
          reference = CallReference.Named {name: run Bytes.copy(Module.text(hir, text))}
        }
      }
      Node.FieldExpression {subject, field} => {
        if let Node.IdentifierExpression {name, binding} = Module.node(hir, subject) {
          if !binding.present {
            if let Node.Name {text: namespace} = Module.node(hir, name) {
              if let Node.Name {text: member} = Module.node(hir, field) {
                reference = CallReference.Qualified {
                  namespace: run Bytes.copy(Module.text(hir, namespace)),
                  member: run Bytes.copy(Module.text(hir, member)),
                  subjectSpan: Module.span(hir, subject),
                  memberSpan: Module.span(hir, field),
                }
              }
            }
          } else {
            receiverCall = true
          }
        } else {
          receiverCall = true
        }
      }
      Node.IntegerLiteral {..} => {
        reference = CallReference.NonCallable
      }
      Node.BooleanLiteral {..} => {
        reference = CallReference.NonCallable
      }
      Node.UnitLiteral => {
        reference = CallReference.NonCallable
      }
      _ => ()
    }
    if !receiverCall {
      run Vector.append<CallSyntax>(
        &mut calls.*,
        CallSyntax {
          id: expression,
          span: Module.span(hir, callee),
          reference: move reference,
          generics: generics,
        },
      )
    } else if let Node.FieldExpression {subject, ..} = Module.node(hir, callee) {
      run collectCall(hir, subject, &mut calls.*)
    }

    let mut at = usize.ZERO
    while at < arguments.length {
      run collectCall(hir, Module.child(hir, arguments, at), &mut calls.*)
      at = at + usize.ONE
    }
  }
  return ()
}

effect fn collectBodySyntax(
  hir: &Module,
  written: Range,
  annotations: &mut Vector<HirId>,
  calls: &mut Vector<CallSyntax>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < written.length {
    let statement = Module.child(hir, written, at)
    match Module.node(hir, statement) {
      Node.ReturnStatement {value} => {
        if value.present {
          run collectCall(hir, value.id, &mut calls.*)
        }
      }
      Node.ExpressionStatement {expression} => {
        run collectCall(hir, expression, &mut calls.*)
      }
      Node.BindingStatement {isStatic, annotation, initializer, ..} => {
        if !isStatic && annotation.present {
          run Vector.append<HirId>(&mut annotations.*, annotation.id)
        }
        run collectCall(hir, initializer, &mut calls.*)
      }
      Node.AssignmentStatement {target, value} => {
        run collectCall(hir, target, &mut calls.*)
        run collectCall(hir, value, &mut calls.*)
      }
      Node.WhileStatement {condition, body} => {
        run collectCall(hir, condition, &mut calls.*)
        if let Node.Block {statements} = Module.node(hir, body) {
          run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        }
      }
      Node.ConditionalStatement {condition, thenBranch, elseBranch} => {
        run collectCall(hir, condition, &mut calls.*)
        if let Node.Block {statements} = Module.node(hir, thenBranch) {
          run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
        }
        let mut otherwise = elseBranch
        while otherwise.present {
          match Module.node(hir, otherwise.id) {
            Node.Block {statements} => {
              run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
              otherwise = HirRef.absent()
            }
            Node.ConditionalStatement {
              condition: nextCondition,
              thenBranch: nextThen,
              elseBranch: nextElse,
            } => {
              run collectCall(hir, nextCondition, &mut calls.*)
              if let Node.Block {statements} = Module.node(hir, nextThen) {
                run collectBodySyntax(hir, statements, &mut annotations.*, &mut calls.*)
              }
              otherwise = nextElse
            }
            _ => {
              otherwise = HirRef.absent()
            }
          }
        }
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  return ()
}

// A written call prefix fixes the first binders in declaration order. The remaining binders are
// inference variables, never gaps that a later written argument may skip.
effect fn resolveCallPrefix(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  callerOrdinal: usize,
  caller: &ModuleId,
  target: &ModuleId,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  written: HirRef,
  scope: &[Binder],
) -> Result<Vector<Argument>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut explicit = Vector.make<Argument>()
  if !written.present {
    return Result.succeed<Vector<Argument>, Shared<Rejection>>(move explicit)
  }
  let source = run typeNode(&mut resolver.*, caller, written.id)
  if let Option<HeaderSyntax>.Some {value} = move source {
    if let Node.TypeArguments {arguments, environment, failures, requirements} = value.header {
      let template = run templateBinders(&mut resolver.*, target, ordinal)
      let mut binders = match move template {
        Result<Vector<Binder>, Shared<Rejection>>.Success {value: found} => move found
        Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Vector<Argument>, Shared<Rejection>>(move error)
        }
      }
      let totalLifetimes = Shared.with<Result<Answer, NoRejection>, usize>(
        signature,
        fn(answer: &Result<Answer, NoRejection>) -> usize {
          return match & answer.* {
            Result<Answer, NoRejection>.Success {value: resolvedAnswer} => match & resolvedAnswer.outcome {
              Outcome.Success {value: Value.Signature {signature: resolved}} => Vector.length<
                Shared<Lifetime>,
              >(&resolved.lifetimeParameters)
              _ => usize.ZERO
            }
            Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
          }
        },
      )
      let mut generatedAt = writtenLifetimeCount(Vector.asSlice<Binder>(&binders))
      while generatedAt < totalLifetimes {
        let generated = Shared.with<Result<Answer, NoRejection>, Option<Shared<Lifetime>>>(
          signature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Lifetime>> {
            return match & answer.* {
              Result<Answer, NoRejection>.Success {value: resolvedAnswer} => match & resolvedAnswer.outcome {
                Outcome.Success {value: Value.Signature {signature: resolved}} => {
                  let lifetimes = Vector.asSlice<Shared<Lifetime>>(&resolved.lifetimeParameters)
                  if generatedAt < lifetimes.length {
                    return Option.some<Shared<Lifetime>>(
                      Shared.clone<Lifetime>(&lifetimes[generatedAt]),
                    )
                  }
                  return Option.none<Shared<Lifetime>>()
                }
                _ => Option.none<Shared<Lifetime>>()
              }
              Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Lifetime>>()
            }
          },
        )
        if let Option<Shared<Lifetime>>.Some {value: generatedLifetime} = move generated {
          run Vector.append<Binder>(
            &mut binders,
            Binder.Lifetime {name: Bytes.make(), value: move generatedLifetime},
          )
        }
        generatedAt = generatedAt + usize.ONE
      }
      let formal = Vector.asSlice<Binder>(&binders)
      if arguments.length > formal.length {
        let firstExcess = run typeChild(&mut resolver.*, caller, arguments, formal.length)
        let mut excessSpan = value.span
        if let Option<HirId>.Some {value: argument} = move firstExcess {
          let excess = run typeNode(&mut resolver.*, caller, argument)
          if let Option<HeaderSyntax>.Some {value: found} = move excess {
            excessSpan = found.span
          }
        }
        return Result.failResult<Vector<Argument>, Shared<Rejection>>(
          run rejectArity(&resolver.*, caller, excessSpan, formal.length, arguments.length),
        )
      }
      if environment.present || failures.present {
        let mut supplied = GenericKind.Lifetime
        if failures.present {
          supplied = GenericKind.Failure
        }
        return Result.failResult<Vector<Argument>, Shared<Rejection>>(
          run rejectKind(&resolver.*, caller, value.span, b"", GenericKind.Type, supplied),
        )
      }
      let mut elision = LifetimeElision {
        owner: Option.none<DeclarationId>(),
        nextOrdinal: usize.ZERO,
        output: false,
        resultDefault: Option.none<Shared<Lifetime>>(),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
        supplied: Option.none<Vector<Argument>>(),
        assumptions: Option.none<Vector<Constraint>>(),
      }
      let mut at = usize.ZERO
      while at < arguments.length {
        let child = run typeChild(&mut resolver.*, caller, arguments, at)
        if let Option<HirId>.Some {value: argument} = move child {
          let source = run typeNode(&mut resolver.*, caller, argument)
          if let Option<HeaderSyntax>.Some {value: found} = move source {
            let mut supplied = GenericKind.Type
            if let Node.Lifetime {..} = found.header {
              supplied = GenericKind.Lifetime
            }
            if let Node.RequirementSelector {..} = found.header {
              supplied = GenericKind.Requirement
            }
            let expected = binderKind(&formal[at])
            if (expected == GenericKind.Type && supplied != GenericKind.Type) || (expected == GenericKind.Lifetime && supplied != GenericKind.Lifetime) || (expected == GenericKind.Requirement && supplied == GenericKind.Lifetime) {
              return Result.failResult<Vector<Argument>, Shared<Rejection>>(
                run rejectKind(
                  &resolver.*,
                  caller,
                  found.span,
                  binderName(&formal[at]),
                  expected,
                  supplied,
                ),
              )
            }
            if expected == GenericKind.Type {
              let resolved = run resolveType(
                &mut resolver.*,
                &mut owner.*,
                &mut dependencies.*,
                callerOrdinal,
                argument,
                scope,
                &mut elision,
              )
              match move resolved {
                Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
                  run Vector.append<Argument>(&mut explicit, Argument.Type {value: move ty})
                }
                Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<Vector<Argument>, Shared<Rejection>>(move error)
                }
              }
            } else if expected == GenericKind.Lifetime {
              let resolved = run lifetimeAt(&mut resolver.*, caller, argument, scope)
              match move resolved {
                Result<Shared<Lifetime>, Shared<Rejection>>.Success {value: lifetime} => {
                  run Vector.append<Argument>(
                    &mut explicit,
                    Argument.Lifetime {value: move lifetime},
                  )
                }
                Result<Shared<Lifetime>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<Vector<Argument>, Shared<Rejection>>(move error)
                }
              }
            } else {
              let mut row = Row.empty()
              let added = run rowArgument(
                &mut resolver.*,
                &mut owner.*,
                &mut dependencies.*,
                callerOrdinal,
                caller,
                argument,
                binderName(&formal[at]),
                scope,
                &mut elision,
                &mut row,
              )
              if let Option<Shared<Rejection>>.Some {value: diagnostic} = move added {
                return Result.failResult<Vector<Argument>, Shared<Rejection>>(move diagnostic)
              }
              run Vector.append<Argument>(
                &mut explicit,
                Argument.Row {value: run Shared.make<Row>(move row)},
              )
            }
          }
        }
        at = at + usize.ONE
      }
      if requirements.present {
        if rowBinderCount(formal) > usize.ONE {
          // The reference does not define a suffix when more than one row remains writable.
          return Result.failResult<Vector<Argument>, Shared<Rejection>>(
            run reject(&resolver.*, caller, RejectionCode.Unsupported, value.span),
          )
        }
        if arguments.length == formal.length {
          return Result.failResult<Vector<Argument>, Shared<Rejection>>(
            run rejectArity(
              &resolver.*,
              caller,
              value.span,
              formal.length,
              arguments.length + usize.ONE,
            ),
          )
        }
        if binderKind(&formal[arguments.length]) != GenericKind.Requirement {
          return Result.failResult<Vector<Argument>, Shared<Rejection>>(
            run rejectKind(
              &resolver.*,
              caller,
              value.span,
              binderName(&formal[arguments.length]),
              binderKind(&formal[arguments.length]),
              GenericKind.Requirement,
            ),
          )
        }
        let resolved = run resolveChannels(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          callerOrdinal,
          caller,
          HirRef.absent(),
          requirements,
          scope,
          &mut elision,
        )
        match move resolved {
          Result<Channels, Shared<Rejection>>.Success {value: channels} => {
            run Vector.append<Argument>(
              &mut explicit,
              Argument.Row {value: move channels.requirements},
            )
          }
          Result<Channels, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Vector<Argument>, Shared<Rejection>>(move error)
          }
        }
      }
      return Result.succeed<Vector<Argument>, Shared<Rejection>>(move explicit)
    }
    return Result.failResult<Vector<Argument>, Shared<Rejection>>(
      run reject(&resolver.*, caller, RejectionCode.Unsupported, value.span),
    )
  }
  return Result.failResult<Vector<Argument>, Shared<Rejection>>(
    run reject(&resolver.*, caller, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
  )
}

effect fn callTarget(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  syntax: &CallSyntax,
  scope: &[Binder],
) -> Result<ResolvedTarget, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = syntax.span
  let mut selected = Result.failResult<SelectedDeclaration, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.Unsupported, span),
  )
  let mut bareValue = false
  match & syntax.reference {
    CallReference.Named {name} => {
      selected = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.NotCallable,
      )
    }
    CallReference.Qualified {namespace, member, subjectSpan, memberSpan} => {
      let namespaceName = Bytes.asSlice(&namespace)
      // The unbound qualifier names the sealed namespace, never an import or source declaration.
      if same(namespaceName, b"Intrinsic") {
        if syntax.generics.present {
          return Result.failResult<ResolvedTarget, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
        return match move intrinsicLookup(Bytes.asSlice(&member)) {
          Option<IntrinsicMember>.Some {value} => Result.succeed<ResolvedTarget, Shared<Rejection>>(
            ResolvedTarget.Intrinsic {member: value},
          )
          Option<IntrinsicMember>.None => Result.failResult<ResolvedTarget, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.UnknownMember, memberSpan),
          )
        }
      }
      let nameKey = Key {
        family: Family.Name,
        module: moduleOrdinal,
        name: run internName(&mut resolver.*, namespaceName),
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      }
      let observed = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        nameKey,
        subjectSpan,
      )
      drop observed
      let namespaceBinding = run select(&mut resolver.*, module, namespaceName, false)
      if namespaceBinding.count == usize.ZERO {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.UnknownName, subjectSpan),
        )
      }
      if namespaceBinding.count > usize.ONE {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Collision, subjectSpan),
        )
      }
      if namespaceBinding.kind == CandidateKind.Declaration {
        let written = run header(&mut resolver.*, module, namespaceBinding.declaration)
        let mut nominal = false
        if let Option<HeaderSyntax>.Some {value} = move written {
          nominal = match value.header {
            Node.StructHeader {..} => true
            Node.TupleHeader {..} => true
            Node.UnionHeader {..} => true
            Node.EnumHeader {..} => true
            _ => false
          }
        }
        if nominal {
          let identity = run demandChild(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            Key {
              family: Family.Identity,
              module: moduleOrdinal,
              name: usize.ZERO,
              declaration: namespaceBinding.declaration,
              member: usize.ZERO,
              external: false,
            },
            subjectSpan,
          )
          let provider = Shared.with<Result<Answer, NoRejection>, TypeSelection>(
            &identity,
            selectedType,
          )
          if let Option<Shared<Rejection>>.Some {value} = move provider.rejected {
            return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value)
          }
          if let Option<Shared<Type>>.Some {value: ownerType} = move provider.resolved {
            let mut request = Request.make()
            let found = run selectInherentReceiverCall(
              &mut resolver.*,
              &mut owner.*,
              &mut request,
              &mut dependencies.*,
              true,
              &ownerType,
              Bytes.asSlice(&member),
              false,
              module,
              memberSpan,
            )
            match move found {
              Result<InherentCallChoice, Shared<Rejection>>.Success {value} => match move value {
                InherentCallChoice.Selected {target, ..} => {
                  return Result.succeed<ResolvedTarget, Shared<Rejection>>(
                    ResolvedTarget.Function {target: move target},
                  )
                }
                InherentCallChoice.Claimed => {
                  return Result.failResult<ResolvedTarget, Shared<Rejection>>(
                    run reject(&resolver.*, module, RejectionCode.NotCallable, memberSpan),
                  )
                }
                InherentCallChoice.Missing => {
                  return Result.failResult<ResolvedTarget, Shared<Rejection>>(
                    run reject(&resolver.*, module, RejectionCode.UnknownMember, memberSpan),
                  )
                }
              }
              Result<InherentCallChoice, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
              }
            }
          }
        }
      }
      if namespaceBinding.kind != CandidateKind.ImportModule {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.NotCallable, subjectSpan),
        )
      }
      let importKey = Key {
        family: Family.Import,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: namespaceBinding.declaration,
        member: usize.MAX,
        external: false,
      }
      let imported = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        importKey,
        subjectSpan,
      )
      let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
        &imported,
        selectedImport,
      )
      if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(move value)
      }
      if let Option<usize>.Some {value: targetModule} = move binding.module {
        selected = run selectDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          targetModule,
          module,
          Bytes.asSlice(&member),
          true,
          memberSpan,
          RejectionCode.NotCallable,
        )
      }
    }
    CallReference.Unbound {name} => {
      bareValue = true
      selected = run selectDeclaration(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        Bytes.asSlice(&name),
        false,
        span,
        RejectionCode.Unsupported,
      )
    }
    CallReference.NonCallable => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.NotCallable, span),
      )
    }
    CallReference.Unsupported => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  let target = match move selected {
    Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
    Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
    }
  }
  let targetModule = run resolvedModule(&resolver.*, target.module)
  let written = run header(&mut resolver.*, &targetModule, target.ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.ConstantHeader {..} = value.header {
      let checked = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        Key {
          family: Family.Constant,
          module: target.module,
          name: usize.ZERO,
          declaration: target.ordinal,
          member: usize.ZERO,
          external: false,
        },
        span,
      )
      let constantType = Shared.with<Result<Answer, NoRejection>, TypeSelection>(&checked, selectedType)
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move constantType.rejected {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(move diagnostic)
      }
      if let Option<Shared<Type>>.Some {value: ty} = move constantType.resolved {
        let identity = run declarationAt(&mut resolver.*, &targetModule, target.ordinal)
        if let Option<DeclarationId>.Some {value: declaration} = move identity {
          return Result.succeed<ResolvedTarget, Shared<Rejection>>(
            ResolvedTarget.Constant {declaration: move declaration, ty: move ty},
          )
        }
      }
    }
    if let Node.FunctionHeader {isPublic, ..} = value.header {
      if bareValue {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
      let signatureKey = Key {
        family: Family.Signature,
        module: target.module,
        name: usize.ZERO,
        declaration: target.ordinal,
        member: usize.ZERO,
        external: false,
      }
      let signature = run demandChild(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        signatureKey,
        span,
      )
      let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &signature,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
        return Result.failResult<ResolvedTarget, Shared<Rejection>>(move diagnostic)
      }
      let prefix = run resolveCallPrefix(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        moduleOrdinal,
        module,
        &targetModule,
        target.ordinal,
        &signature,
        syntax.generics,
        scope,
      )
      let explicit = match move prefix {
        Result<Vector<Argument>, Shared<Rejection>>.Success {value: resolvedArguments} => move resolvedArguments
        Result<Vector<Argument>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<ResolvedTarget, Shared<Rejection>>(move error)
        }
      }
      let identity = run declarationAt(&mut resolver.*, &targetModule, target.ordinal)
      if let Option<DeclarationId>.Some {value: declaration} = move identity {
        return Result.succeed<ResolvedTarget, Shared<Rejection>>(
          ResolvedTarget.Function {
            target: CallTarget {
              declaration: move declaration,
              isPublic: isPublic,
              signature: move signature,
              explicit: move explicit,
            },
          },
        )
      }
    }
  }
  return Result.failResult<ResolvedTarget, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.NotCallable, span),
  )
}

effect fn resolveNamedRepresentation(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  moduleOrdinal: usize,
  module: &ModuleId,
  subject: HirId,
  span: Span,
  scope: &[Binder],
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let source = run typeNode(&mut resolver.*, module, subject)
  if let Option<HeaderSyntax>.Some {value: written} = move source {
    let mut selected = written.header
    let mut generics = HirRef.absent()
    if let Node.AppliedType {target, arguments} = selected {
      generics = HirRef.of(arguments)
      let named = run typeNode(&mut resolver.*, module, target)
      if let Option<HeaderSyntax>.Some {value: found} = move named {
        selected = found.header
      }
    }
    if let Node.NamedType {path: subjectPath, hasMode, ..} = selected {
      if !hasMode {
        let parsed = run path(&mut resolver.*, module, subjectPath)
        if parsed.valid {
          let segments = Vector.asSlice<Bytes>(&parsed.segments)
          let mut reference = CallReference.Unsupported
          if segments.length == usize.ONE {
            reference = CallReference.Named {
              name: run Bytes.copy(Bytes.asSlice(&segments[usize.ZERO])),
            }
          }
          if segments.length == 2 {
            reference = CallReference.Qualified {
              namespace: run Bytes.copy(Bytes.asSlice(&segments[usize.ZERO])),
              member: run Bytes.copy(Bytes.asSlice(&segments[usize.ONE])),
              subjectSpan: parsed.span,
              memberSpan: parsed.span,
            }
          }
          let syntax = CallSyntax {
            id: subject,
            span: span,
            reference: move reference,
            generics: generics,
          }
          let found = run callTarget(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            module,
            moduleOrdinal,
            &syntax,
            scope,
          )
          let selected = match move found {
            Result<ResolvedTarget, Shared<Rejection>>.Success {value} => value
            Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
            }
          }
          let target = match move selected {
            ResolvedTarget.Function {target} => target
            ResolvedTarget.Constant {..} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(
                run reject(&resolver.*, module, RejectionCode.InvalidExactRepresentation, span),
              )
            }
            ResolvedTarget.Intrinsic {..} => {
              return Result.failResult<Shared<Type>, Shared<Rejection>>(
                run reject(&resolver.*, module, RejectionCode.InvalidExactRepresentation, span),
              )
            }
          }
          let count = Shared.with<Result<Answer, NoRejection>, usize>(
            &target.signature,
            signatureBinderCount,
          )
          if Vector.length<Argument>(&target.explicit) != count {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.InvalidExactRepresentation, span),
            )
          }
          if Shared.with<Result<Answer, NoRejection>, usize>(
            &target.signature,
            signatureConstraintCount,
          ) > usize.ZERO {
            return Result.failResult<Shared<Type>, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Unsupported, span),
            )
          }
          return Result.succeed<Shared<Type>, Shared<Rejection>>(
            run Shared.make<Type>(
              Type.NamedRepresentation {
                declaration: move target.declaration,
                isPublic: target.isPublic,
                arguments: move target.explicit,
              },
            ),
          )
        }
      }
    }
  }
  return Result.failResult<Shared<Type>, Shared<Rejection>>(
    run reject(&resolver.*, module, RejectionCode.InvalidExactRepresentation, span),
  )
}

effect fn resolvedCall(calls: &[ResolvedCall], id: HirId) -> Option<
  Result<ResolvedTarget, Shared<Rejection>>,
> ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < calls.length {
    if calls[at].id.index == id.index {
      return match & calls[at].result {
        Result<ResolvedTarget, Shared<Rejection>>.Success {value} => Option.some<
          Result<ResolvedTarget, Shared<Rejection>>,
        >(
          Result.succeed<ResolvedTarget, Shared<Rejection>>(
            match & value {
              ResolvedTarget.Intrinsic {member} => ResolvedTarget.Intrinsic {member: member}
              ResolvedTarget.Constant {declaration, ty} => ResolvedTarget.Constant {
                declaration: run DeclarationId.copy(&declaration),
                ty: Shared.clone<Type>(&ty),
              }
              ResolvedTarget.Function {target} => ResolvedTarget.Function {target: CallTarget {
                declaration: run DeclarationId.copy(&target.declaration),
                isPublic: target.isPublic,
                signature: Shared.clone<Result<Answer, NoRejection>>(&target.signature),
                explicit: run copyArguments(Vector.asSlice<Argument>(&target.explicit)),
              }}
            },
          ),
        )
        Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Option.some<
          Result<ResolvedTarget, Shared<Rejection>>,
        >(Result.failResult<ResolvedTarget, Shared<Rejection>>(Shared.clone<Rejection>(&error)))
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Result<ResolvedTarget, Shared<Rejection>>>()
}

// A written interface qualifier fixes the contract declaration. Its unique declared bound fixes
// the application and provider; without a bound, the leading operand supplies an open provider
// whose conformance must still be proved rather than assumed from a concrete caller.
effect fn checkQualifiedInterfaceCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &[BodyLocal],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  arguments: Range,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  qualifier: &QualifiedBodyName,
  selected: SelectedDeclaration,
  isPublic: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let contractModule = run resolvedModule(&resolver.*, selected.module)
  let identity = run declarationAt(&mut resolver.*, &contractModule, selected.ordinal)
  let interfaceId = match move identity {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let mut chosenContract = Option.none<Shared<Type>>()
  let mut chosenProvider = Option.none<Shared<Type>>()
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Conforms {provider, contract} = &constraints[at] {
      let matches = Shared.with<Type, bool>(
        &contract,
        fn(value: &Type) -> bool {
          return match & value.* {
            Type.Nominal {declaration, ..} => DeclarationId.equals(&declaration, &interfaceId)
            _ => false
          }
        },
      )
      if matches {
        if let Option<Shared<Type>>.Some {value: unused} = &chosenContract {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        chosenContract = Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
        chosenProvider = Option.some<Shared<Type>>(Shared.clone<Type>(&provider))
      }
    }
    at = at + usize.ONE
  }
  let mut firstArgument = Option.none<BodyNodeId>()
  let needsInference = match & chosenContract {
    Option<Shared<Type>>.Some {..} => false
    Option<Shared<Type>>.None => true
  }
  if needsInference {
    if arguments.length == usize.ZERO {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
    let firstId = run bodyChild(&resolver.source, cursor, arguments, usize.ZERO)
    let checked = run checkExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      locals,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      firstId,
      &Option.none<Shared<Type>>(),
      constraints,
      contractBody,
      false,
    )
    let node = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    let inferred = match & Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    firstArgument = Option.some<BodyNodeId>(node)
    let provider = Shared.with<Type, Option<Shared<Type>>>(
      &inferred,
      fn(value: &Type) -> Option<Shared<Type>> {
        return match & value.* {
          Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
          _ => Option.none<Shared<Type>>()
        }
      },
    )
    chosenProvider = match move provider {
      Option<Shared<Type>>.Some {value} => Option.some<Shared<Type>>(move value)
      Option<Shared<Type>>.None => Option.some<Shared<Type>>(move inferred)
    }
    chosenContract = Option.some<Shared<Type>>(
      run Shared.make<Type>(
        Type.Nominal {
          declaration: run DeclarationId.copy(&interfaceId),
          isPublic: isPublic,
          arguments: Vector.make<Argument>(),
        },
      ),
    )
  }
  let contract = match move chosenContract {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let provider = match move chosenProvider {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let listed = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: selected.module,
      name: usize.ZERO,
      declaration: selected.ordinal,
      member: usize.ZERO,
      external: false,
    },
    span,
    true,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &listed,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, operationCount)
  let mut operation = Option.none<DeclarationId>()
  at = usize.ZERO
  while at < count {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
        return operationAt(answer, at)
      },
    )
    if let Option<Shared<DeclarationId>>.Some {value: candidate} = move found {
      let named = Shared.with<DeclarationId, bool>(
        &candidate,
        fn(value: &DeclarationId) -> bool {
          return DeclarationId.named(value, Bytes.asSlice(&qualifier.member))
        },
      )
      if named {
        let ordinal = run ordinalOfIdentity(&mut resolver.*, &contractModule, &candidate)
        if let Option<usize>.Some {value: position} = move ordinal {
          operation = run declarationAt(&mut resolver.*, &contractModule, position)
        }
        break
      }
    }
    at = at + usize.ONE
  }
  let operationId = match move operation {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, span)
    }
  }
  let selectedCall = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &contract,
    &provider,
    &operationId,
    constraints,
    module,
    span,
  )
  let selectedOperation = match move selectedCall {
    Result<OperationCall, Shared<Rejection>>.Success {value} => value
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let OperationCall {operation: chosenOperation, implementation, signature, proof, receiver: _} = move selectedOperation
  drop proof
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signature,
    signatureParameterCount,
  )
  if arguments.length > parameterCount {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if arguments.length == usize.ZERO && parameterCount > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.RedundantCall, span)
  }
  if arguments.length < parameterCount || Shared.with<Result<Answer, NoRejection>, bool>(
    &signature,
    signatureOutsideScalarBodies,
  ) || Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureNonLifetimeBinderCount) > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let mut typedArguments = Vector.make<BodyNodeId>()
  at = usize.ZERO
  while at < arguments.length {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let mut already = false
    let mut argumentNode = BodyNodeId {index: usize.ZERO}
    if at == usize.ZERO {
      if let Option<BodyNodeId>.Some {value} = &firstArgument {
        already = true
        argumentNode = BodyNodeId {index: value.index}
      }
    }
    if !already {
      let mut context = Option.none<Shared<Type>>()
      if Shared.with<Type, bool>(&parameterType, scalarType) {
        context = Option.some<Shared<Type>>(Shared.clone<Type>(&parameterType))
      }
      let argumentId = run bodyChild(&resolver.source, cursor, arguments, at)
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        locals,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        argumentId,
        &context,
        constraints,
        contractBody,
        false,
      )
      argumentNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    }
    let argumentType = match & Vector.asSlice<BodyNode>(&nodes.*)[argumentNode.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let mut matchesParameter = run Type.equalsShared(&argumentType, &parameterType)
    if !matchesParameter && at == usize.ZERO {
      let receiver = run receiverPosition(&signature, &provider)
      if let Option<ReceiverPosition>.Some {..} = move receiver {
        matchesParameter = run sameReferenceReceiver(&argumentType, &parameterType)
      }
    }
    if !matchesParameter {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    run Vector.append<BodyNodeId>(&mut typedArguments, argumentNode)
    at = at + usize.ONE
  }
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let ty = match move result {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  if !contractBody && !Shared.with<Type, bool>(&ty, scalarType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !run Type.equalsShared(&ty, &value) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
  }
  run Vector.append<SignatureDependency>(
    &mut signatures.*,
    SignatureDependency {declaration: run DeclarationId.copy(&chosenOperation)},
  )
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {
        ty: move ty,
        form: BodyExpression.InterfaceCall {
          contract: move contract,
          provider: move provider,
          operation: move chosenOperation,
          implementation: move implementation,
          receiverPass: Option.none<BodyReceiverPass>(),
          arguments: move typedArguments,
        },
      },
    },
  )
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

fn bodyExpressionType(nodes: &[BodyNode], node: &BodyNodeId) -> Option<Shared<Type>> {
  return match & nodes[node.index].kind {
    BodyNodeKind.Expression {ty, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    _ => Option.none<Shared<Type>>()
  }
}

struct CheckedOperand {
  node: BodyNodeId
  ty: Shared<Type>
}

struct CheckedOperands {
  leftNode: BodyNodeId
  leftType: Shared<Type>
  rightNode: BodyNodeId
  rightType: Shared<Type>
}

struct CheckedOperatorCall {
  ty: Shared<Type>
  form: BodyExpression
}

fn orderCheckedOperands(leftLiteral: bool, first: CheckedOperand, second: CheckedOperand) -> CheckedOperands {
  let CheckedOperand {node: firstNode, ty: firstType} = move first
  let CheckedOperand {node: secondNode, ty: secondType} = move second
  if leftLiteral {
    return CheckedOperands {
      leftNode: secondNode,
      leftType: move secondType,
      rightNode: firstNode,
      rightType: move firstType,
    }
  }
  return CheckedOperands {
    leftNode: firstNode,
    leftType: move firstType,
    rightNode: secondNode,
    rightType: move secondType,
  }
}

effect fn checkedOperatorCall(
  resolver: &mut Resolver,
  selected: SelectedOperator,
  arguments: Vector<BodyNodeId>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  module: &ModuleId,
  span: Span,
) -> Result<CheckedOperatorCall, Shared<Rejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let SelectedOperator {contract, provider, call} = move selected
  let OperationCall {
    operation,
    implementation,
    signature,
    proof: unusedProof,
    receiver: unusedReceiver,
  } = move call
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let ty = match move result {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  run Vector.append<SignatureDependency>(
    &mut signatures.*,
    SignatureDependency {declaration: run DeclarationId.copy(&operation)},
  )
  if let Option<Shared<DeclarationId>>.Some {value: witness} = &implementation {
    let moduleOrdinal = Shared.with<DeclarationId, usize>(
      &witness,
      fn(value: &DeclarationId) -> usize {
        return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
      },
    )
    if moduleOrdinal == usize.MAX {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    let witnessModule = run resolvedModule(&resolver.*, moduleOrdinal)
    let found = run ordinalOfIdentity(&mut resolver.*, &witnessModule, &witness)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
    }
    let declaration = run declarationAt(&mut resolver.*, &witnessModule, ordinal)
    if let Option<DeclarationId>.Some {value} = move declaration {
      run Vector.append<DeclarationId>(&mut requiredBodies.*, move value)
    } else {
      return Result.failResult<CheckedOperatorCall, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
  }
  return Result.succeed<CheckedOperatorCall, Shared<Rejection>>(
    CheckedOperatorCall {
      ty: move ty,
      form: BodyExpression.InterfaceCall {
        contract: move contract,
        provider: move provider,
        operation: move operation,
        implementation: move implementation,
        receiverPass: Option.none<BodyReceiverPass>(),
        arguments: move arguments,
      },
    },
  )
}

effect fn checkOperatorOperand(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &[BodyLocal],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
) -> Result<CheckedOperand, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    locals,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    expression,
    expected,
    constraints,
    contractBody,
    staticBody,
  )
  let node = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<CheckedOperand, Shared<Rejection>>(move error)
    }
  }
  let ty = match move bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &node) {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return Result.failResult<CheckedOperand, Shared<Rejection>>(
        run reject(
          &resolver.*,
          module,
          RejectionCode.Unsupported,
          run bodySpan(&resolver.source, cursor, expression),
        ),
      )
    }
  }
  return Result.succeed<CheckedOperand, Shared<Rejection>>(CheckedOperand {node: node, ty: move ty})
}

// Receiver spelling evaluates the subject once, selects its owner name before interfaces, and
// only then checks supplied arguments. The selected signature determines any receiver loan.
effect fn checkReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &[BodyLocal],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  subject: HirId,
  field: HirId,
  generics: HirRef,
  arguments: Range,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let memberSpan = run bodySpan(&resolver.source, cursor, field)
  if generics.present {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let memberSymbol = match run bodyNode(&resolver.source, cursor, field) {
    Node.Name {text} => text
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
    }
  }
  let member = run bodyText(&resolver.source, cursor, memberSymbol)
  let checkedReceiver = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    module,
    cursor,
    locals,
    calls,
    &mut nodes.*,
    &mut signatures.*,
    &mut requiredBodies.*,
    subject,
    &Option.none<Shared<Type>>(),
    constraints,
    contractBody,
    false,
  )
  let receiverNode = match move checkedReceiver {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let receiverType = match & Vector.asSlice<BodyNode>(&nodes.*)[receiverNode.index].kind {
    BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let referent = Shared.with<Type, Option<Shared<Type>>>(
    &receiverType,
    fn(value: &Type) -> Option<Shared<Type>> {
      return match & value.* {
        Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
        _ => Option.none<Shared<Type>>()
      }
    },
  )
  let provider = match move referent {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => Shared.clone<Type>(&receiverType)
  }
  let inherent = run selectInherentReceiverCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &provider,
    Bytes.asSlice(&member),
    true,
    module,
    memberSpan,
  )
  let own = match move inherent {
    Result<InherentCallChoice, Shared<Rejection>>.Success {value} => value
    Result<InherentCallChoice, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
    }
  }
  let mut maybeChoice = Option.none<ReceiverCallChoice>()
  match move own {
    InherentCallChoice.Selected {target, receiver} => match move receiver {
      Option<ReceiverPosition>.Some {value} => {
        maybeChoice = Option.some<ReceiverCallChoice>(
          ReceiverCallChoice.Inherent {target: move target, receiver: value},
        )
      }
      Option<ReceiverPosition>.None => {
        return run bodyRejection(
          &resolver.*,
          module,
          RejectionCode.AssociatedFunctionOnValue,
          memberSpan,
        )
      }
    }
    InherentCallChoice.Claimed => {
      // Callable-field invocation awaits the field-value checker; a claimed owner name never
      // escapes to conformance lookup.
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
    }
    InherentCallChoice.Missing => {
      let mut selected = Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
        Option.none<SelectedReceiverOperation>(),
      )
      if Shared.with<Type, bool>(&provider, isTypeParameter) {
        selected = run selectBoundReceiverCall(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          true,
          &provider,
          Bytes.asSlice(&member),
          constraints,
          module,
          memberSpan,
        )
      } else {
        selected = run selectConcreteReceiverCall(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          true,
          &provider,
          Bytes.asSlice(&member),
          constraints,
          module,
          memberSpan,
        )
      }
      match move selected {
        Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.Success {value} => match move value {
          Option<SelectedReceiverOperation>.Some {value: operation} => {
            maybeChoice = Option.some<ReceiverCallChoice>(
              ReceiverCallChoice.Interface {selected: move operation},
            )
          }
          Option<SelectedReceiverOperation>.None => {
            return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, memberSpan)
          }
        }
        Result<Option<SelectedReceiverOperation>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    }
  }
  let choice = match move maybeChoice {
    Option<ReceiverCallChoice>.Some {value} => value
    Option<ReceiverCallChoice>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.UnknownMember, memberSpan)
    }
  }
  let signature = match & choice {
    ReceiverCallChoice.Inherent {target, ..} => Shared.clone<Result<Answer, NoRejection>>(
      &target.signature,
    )
    ReceiverCallChoice.Interface {selected} => Shared.clone<Result<Answer, NoRejection>>(
      &selected.call.signature,
    )
  }
  let receiverPositionValue = match & choice {
    ReceiverCallChoice.Inherent {receiver, ..} => receiver
    ReceiverCallChoice.Interface {selected} => match & selected.call.receiver {
      Option<ReceiverPosition>.Some {value} => value
      Option<ReceiverPosition>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, memberSpan)
      }
    }
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signature,
    signatureParameterCount,
  )
  if receiverPositionValue.ordinal != usize.ZERO || parameterCount != arguments.length + usize.ONE {
    return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
  }
  if Shared.with<Result<Answer, NoRejection>, bool>(&signature, signatureOutsideScalarBodies) || Shared.with<
    Result<Answer, NoRejection>,
    usize,
  >(&signature, signatureNonLifetimeBinderCount) > usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  let receiverParameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return signatureParameter(answer, usize.ZERO)
    },
  )
  let expectedReceiver = match move receiverParameter {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  let exactReceiver = run Type.equalsShared(&receiverType, &expectedReceiver)
  if !exactReceiver {
    let sameValue = run Type.equalsShared(&receiverType, &provider)
    let borrowsValue = match receiverPositionValue.mode {
      BodyReceiverPass.Shared => true
      BodyReceiverPass.Mutable => true
      BodyReceiverPass.Take => false
    }
    let borrowed = Shared.with<Type, Option<ReferenceReceiver>>(
      &receiverType,
      fn(value: &Type) -> Option<ReferenceReceiver> {
        return match & value.* {
          Type.Reference {referent: foundReferent, access, ..} => Option.some<ReferenceReceiver>(
            ReferenceReceiver {
              referent: Shared.clone<Type>(&foundReferent),
              mode: match access {
                Access.Shared => BodyReceiverPass.Shared
                Access.Mutable => BodyReceiverPass.Mutable
              },
            },
          )
          _ => Option.none<ReferenceReceiver>()
        }
      },
    )
    let mut sameBorrow = false
    if let Option<ReferenceReceiver>.Some {value} = move borrowed {
      if value.mode == receiverPositionValue.mode {
        sameBorrow = run Type.equalsShared(&value.referent, &provider)
      }
    }
    if !(sameValue && borrowsValue) && !sameBorrow {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, memberSpan)
    }
  }
  let mut typedArguments = Vector.make<BodyNodeId>()
  run Vector.append<BodyNodeId>(&mut typedArguments, receiverNode)
  let mut at = usize.ZERO
  while at < arguments.length {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at + usize.ONE)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    let mut context = Option.none<Shared<Type>>()
    if Shared.with<Type, bool>(&parameterType, scalarType) {
      context = Option.some<Shared<Type>>(Shared.clone<Type>(&parameterType))
    }
    let argumentId = run bodyChild(&resolver.source, cursor, arguments, at)
    let checked = run checkExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      locals,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      argumentId,
      &context,
      constraints,
      contractBody,
      false,
    )
    let argumentNode = match move checked {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
      }
    }
    let argumentType = match & Vector.asSlice<BodyNode>(&nodes.*)[argumentNode.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
    }
    if !run Type.equalsShared(&argumentType, &parameterType) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
    run Vector.append<BodyNodeId>(&mut typedArguments, argumentNode)
    at = at + usize.ONE
  }
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let ty = match move result {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  if !contractBody && !Shared.with<Type, bool>(&ty, scalarType) {
    return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
  }
  if let Option<Shared<Type>>.Some {value} = &expected.* {
    if !run Type.equalsShared(&ty, &value) {
      return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
    }
  }
  let mut form = BodyExpression.Unit
  let receiverPass = receiverPositionValue.mode
  match move choice {
    ReceiverCallChoice.Inherent {target, ..} => {
      run Vector.append<SignatureDependency>(
        &mut signatures.*,
        SignatureDependency {declaration: run DeclarationId.copy(&target.declaration)},
      )
      run Vector.append<DeclarationId>(
        &mut requiredBodies.*,
        run DeclarationId.copy(&target.declaration),
      )
      form = BodyExpression.DirectCall {
        declaration: move target.declaration,
        genericArguments: move target.explicit,
        receiverPass: Option.some<BodyReceiverPass>(receiverPass),
        arguments: move typedArguments,
      }
    }
    ReceiverCallChoice.Interface {selected} => {
      let OperationCall {
        operation,
        implementation,
        signature: unusedSignature,
        proof,
        receiver: unusedReceiver,
      } = move selected.call
      drop unusedSignature
      drop unusedReceiver
      drop proof
      run Vector.append<SignatureDependency>(
        &mut signatures.*,
        SignatureDependency {declaration: run DeclarationId.copy(&operation)},
      )
      form = BodyExpression.InterfaceCall {
        contract: move selected.contract,
        provider: move provider,
        operation: move operation,
        implementation: move implementation,
        receiverPass: Option.some<BodyReceiverPass>(receiverPass),
        arguments: move typedArguments,
      }
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move ty, form: move form},
    },
  )
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

effect fn checkExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &[BodyLocal],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  expression: HirId,
  expected: &Option<Shared<Type>>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
) -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = run bodySpan(&resolver.source, cursor, expression)
  let mut ty = run Shared.make<Type>(Type.Unit)
  let mut form = BodyExpression.Unit
  let mut diverges = false
  match run bodyNode(&resolver.source, cursor, expression) {
    Node.IntegerLiteral {sign, magnitude, suffix, ..} => {
      let digits = run bodyText(&resolver.source, cursor, magnitude)
      let mut writtenSuffix = Option.none<Bytes>()
      let mut selected = b"i32"
      let mut contextual = false
      if suffix.present {
        writtenSuffix = Option.some<Bytes>(run bodyText(&resolver.source, cursor, suffix.symbol))
      } else if let Option<Shared<Type>>.Some {value} = &expected.* {
        if Shared.with<Type, bool>(
          &value,
          fn(ty: &Type) -> bool {
            return fixedIntegerType(ty) || pointerSizedIntegerType(ty)
          },
        ) {
          contextual = true
        }
      }
      if let Option<Bytes>.Some {value} = &writtenSuffix {
        selected = Bytes.asSlice(&value)
      }
      if contextual {
        if let Option<Shared<Type>>.Some {value} = &expected.* {
          let fits = Shared.with<Type, bool>(
            &value,
            fn(resolved: &Type) -> bool {
              return match & resolved.* {
                Type.Primitive {name} => fitsInteger(
                  &resolver.target,
                  Bytes.asSlice(&name),
                  sign,
                  Bytes.asSlice(&digits),
                )
                _ => false
              }
            },
          )
          if !fits {
            return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span)
          }
          ty = Shared.clone<Type>(&value)
        }
      } else {
        if !fixedIntegerName(selected) {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        if !fitsInteger(&resolver.target, selected, sign, Bytes.asSlice(&digits)) {
          return run bodyRejection(&resolver.*, module, RejectionCode.IntegerOutOfRange, span)
        }
        ty = run primitiveType(selected)
      }
      form = BodyExpression.Integer {literal: expression}
    }
    Node.FloatingLiteral {..} => {
      if !staticBody {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let mut contextual = false
      if let Option<Shared<Type>>.Some {value} = &expected.* {
        contextual = Shared.with<Type, bool>(&value, fn(checked: &Type) -> bool {
          if let Type.Primitive {name} = &checked.* {
            let written = Bytes.asSlice(&name)
            return same(written, b"f32") || same(written, b"f64")
          }
          return false
        })
      }
      if contextual {
        if let Option<Shared<Type>>.Some {value} = &expected.* {
          ty = Shared.clone<Type>(&value)
        }
      } else {
        ty = run primitiveType(b"f64")
      }
      form = BodyExpression.Float {literal: expression}
    }
    Node.TextLiteral {..} => {
      if !staticBody {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      ty = run intrinsicValueType(IntrinsicValueKind.StaticText)
      form = BodyExpression.Text {literal: expression}
    }
    Node.BooleanLiteral {value} => {
      ty = run primitiveType(b"bool")
      form = BodyExpression.Boolean {value: value}
    }
    Node.UnitLiteral => {
      form = BodyExpression.Unit
    }
    Node.CompileErrorExpression {message} => {
      if !staticBody {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let textType = Option.some<Shared<Type>>(run intrinsicValueType(IntrinsicValueKind.StaticText))
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        locals,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        message,
        &textType,
        constraints,
        contractBody,
        staticBody,
      )
      let messageNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      ty = run Shared.make<Type>(Type.Union {members: Vector.make<Shared<Type>>()})
      form = BodyExpression.CompileError {message: messageNode}
      diverges = true
    }
    Node.IdentifierExpression {name, binding} => {
      if !binding.present {
        let found = run resolvedCall(calls, expression)
        if let Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} = move found {
          match move value {
            Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Constant {declaration, ty: constantType}} => {
              if !staticBody {
                return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
              }
              ty = move constantType
              form = BodyExpression.Constant {
                declaration: run Shared.make<DeclarationId>(move declaration),
              }
            }
            Result<ResolvedTarget, Shared<Rejection>>.Success {value: _} => {
              return run bodyRejection(&resolver.*, module, RejectionCode.UnknownName, run bodySpan(&resolver.source, cursor, name))
            }
            Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
            }
          }
        } else {
          return run bodyRejection(
            &resolver.*,
            module,
            RejectionCode.UnknownName,
            run bodySpan(&resolver.source, cursor, name),
          )
        }
      } else {
        let mut at = usize.ZERO
        let mut found = false
        while at < locals.length {
          if locals[at].origin.syntax.index == binding.id.index {
            ty = Shared.clone<Type>(&locals[at].ty)
            form = BodyExpression.Local {local: BodyLocalId {index: at}}
            found = true
            break
          }
          at = at + usize.ONE
        }
        if found == false {
          if staticBody {
            return run bodyRejection(
              &resolver.*,
              module,
              RejectionCode.StaticPhaseViolation,
              run bodySpan(&resolver.source, cursor, name),
            )
          }
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
    }
    Node.FieldExpression {field, ..} => {
      if !staticBody {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let found = run resolvedCall(calls, expression)
      let resolved = match move found {
        Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} => value
        Option<Result<ResolvedTarget, Shared<Rejection>>>.None => {
          return run bodyRejection(
            &resolver.*,
            module,
            RejectionCode.UnknownMember,
            run bodySpan(&resolver.source, cursor, field),
          )
        }
      }
      match move resolved {
        Result<ResolvedTarget, Shared<Rejection>>.Success {
          value: ResolvedTarget.Constant {declaration, ty: constantType},
        } => {
          ty = move constantType
          form = BodyExpression.Constant {
            declaration: run Shared.make<DeclarationId>(move declaration),
          }
        }
        Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
        _ => {
          return run bodyRejection(
            &resolver.*,
            module,
            RejectionCode.UnknownMember,
            run bodySpan(&resolver.source, cursor, field),
          )
        }
      }
    }
    Node.MoveExpression {operand} => {
      // The first abstract-body subset moves a named local as a whole. A later safety stage
      // checks that it is still owned here and that cleanup follows the resulting control flow.
      if let Node.IdentifierExpression {binding, ..} = run bodyNode(
        &resolver.source,
        cursor,
        operand,
      ) {
        if !binding.present {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      } else {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        locals,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        operand,
        expected,
        constraints,
        contractBody,
        staticBody,
      )
      let operandNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      ty = match & Vector.asSlice<BodyNode>(&nodes.*)[operandNode.index].kind {
        BodyNodeKind.Expression {ty: operandType, ..} => Shared.clone<Type>(&operandType)
        _ => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
      form = BodyExpression.Move {value: operandNode}
    }
    Node.PrefixExpression {operator, operatorAnchor, operand} => {
      let checked = run checkExpression(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        locals,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        operand,
        expected,
        constraints,
        contractBody,
        staticBody,
      )
      let operandNode = match move checked {
        Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
        Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let operandType = match move bodyExpressionType(
        Vector.asSlice<BodyNode>(&nodes.*),
        &operandNode,
      ) {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, operatorAnchor)
        }
      }
      let family = run operatorFamily(&mut resolver.*, &operandType)
      let concrete = Operator.prefix(operator, family)
      let closed = match & concrete {
        Option<Operator.ResultType>.Some {value: _} => true
        Option<Operator.ResultType>.None => false
      }
      let mut operands = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut operands, Shared.clone<Type>(&operandType))
      let spelling = OperatorSpelling.Prefix {operator: operator}
      let operandSlice = Vector.asSlice<Shared<Type>>(&operands)
      let selected = run selectOperator(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &spelling,
        operandSlice,
        constraints,
        closed,
        module,
        operatorAnchor,
      )
      match move selected {
        Result<Option<SelectedOperator>, Shared<Rejection>>.Success {value: available} => match move available {
          Option<SelectedOperator>.Some {value: chosen} => {
            let mut arguments = Vector.make<BodyNodeId>()
            run Vector.append<BodyNodeId>(&mut arguments, operandNode)
            let typed = run checkedOperatorCall(
              &mut resolver.*,
              move chosen,
              move arguments,
              &mut signatures.*,
              &mut requiredBodies.*,
              module,
              operatorAnchor,
            )
            match move typed {
              Result<CheckedOperatorCall, Shared<Rejection>>.Success {value: accepted} => {
                let CheckedOperatorCall {ty: resultType, form: selectedForm} = move accepted
                ty = move resultType
                form = move selectedForm
              }
              Result<CheckedOperatorCall, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
              }
            }
          }
          Option<SelectedOperator>.None => match move concrete {
            Option<Operator.ResultType>.Some {value: result} => {
              ty = match result {
                OperatorResultType.Operand => Shared.clone<Type>(&operandType)
                OperatorResultType.Boolean => run primitiveType(b"bool")
              }
              form = BodyExpression.ConcretePrefix {operator: operator, operand: operandNode}
            }
            Option<Operator.ResultType>.None => {
              return run bodyRejection(
                &resolver.*,
                module,
                RejectionCode.MissingOperator,
                operatorAnchor,
              )
            }
          }
        }
        Result<Option<SelectedOperator>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    }
    Node.InfixExpression {operator, operatorAnchor, left, right} => {
      let leftLiteral = match run bodyNode(&resolver.source, cursor, left) {
        Node.IntegerLiteral {suffix, ..} => !suffix.present
        _ => false
      }
      // A bare literal has no fixed type before its other operand is known. Checking that
      // operand first only selects a literal type; the retained pair preserves runtime order.
      let mut firstExpression = left
      let mut secondExpression = right
      if leftLiteral {
        firstExpression = right
        secondExpression = left
      }
      let firstContextual = match run bodyNode(&resolver.source, cursor, firstExpression) {
        Node.IntegerLiteral {suffix, ..} => !suffix.present
        Node.InfixExpression {..} => true
        Node.PrefixExpression {..} => true
        _ => false
      }
      let secondContextual = match run bodyNode(&resolver.source, cursor, secondExpression) {
        Node.IntegerLiteral {suffix, ..} => !suffix.present
        Node.InfixExpression {..} => true
        Node.PrefixExpression {..} => true
        _ => false
      }
      let mut firstExpected = Option.none<Shared<Type>>()
      if firstContextual {
        if let Option<Shared<Type>>.Some {value} = &expected.* {
          if Shared.with<Type, bool>(
            &value,
            fn(ty: &Type) -> bool {
              return fixedIntegerType(ty) || pointerSizedIntegerType(ty)
            },
          ) {
            firstExpected = Option.some<Shared<Type>>(Shared.clone<Type>(&value))
          }
        }
      }
      let first = run checkOperatorOperand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        locals,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        firstExpression,
        &firstExpected,
        constraints,
        contractBody,
        staticBody,
      )
      let firstOperand = match move first {
        Result<CheckedOperand, Shared<Rejection>>.Success {value} => value
        Result<CheckedOperand, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let CheckedOperand {node: firstNode, ty: firstType} = move firstOperand
      let mut secondExpected = Option.none<Shared<Type>>()
      if secondContextual && Shared.with<Type, bool>(
        &firstType,
        fn(ty: &Type) -> bool {
          return fixedIntegerType(ty) || pointerSizedIntegerType(ty)
        },
      ) {
        secondExpected = Option.some<Shared<Type>>(Shared.clone<Type>(&firstType))
      }
      let second = run checkOperatorOperand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        module,
        cursor,
        locals,
        calls,
        &mut nodes.*,
        &mut signatures.*,
        &mut requiredBodies.*,
        secondExpression,
        &secondExpected,
        constraints,
        contractBody,
        staticBody,
      )
      let secondOperand = match move second {
        Result<CheckedOperand, Shared<Rejection>>.Success {value} => value
        Result<CheckedOperand, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
      let pair = orderCheckedOperands(
        leftLiteral,
        CheckedOperand {node: firstNode, ty: move firstType},
        move secondOperand,
      )
      let CheckedOperands {leftNode, leftType, rightNode, rightType} = move pair
      let leftFamily = run operatorFamily(&mut resolver.*, &leftType)
      let rightFamily = run operatorFamily(&mut resolver.*, &rightType)
      let sameType = run Type.equalsShared(&leftType, &rightType)
      let mut concrete = Operator.infix(operator, leftFamily, rightFamily, sameType)
      if staticBody && (operator == InfixOperator.And || operator == InfixOperator.Or) && sameType && leftFamily == OperatorFamily.Boolean && rightFamily == OperatorFamily.Boolean {
        concrete = Option.some<OperatorResultType>(OperatorResultType.Boolean)
      }
      let closed = match & concrete {
        Option<Operator.ResultType>.Some {value: _} => true
        Option<Operator.ResultType>.None => false
      }
      let mut operands = Vector.make<Shared<Type>>()
      run Vector.append<Shared<Type>>(&mut operands, Shared.clone<Type>(&leftType))
      run Vector.append<Shared<Type>>(&mut operands, Shared.clone<Type>(&rightType))
      let spelling = OperatorSpelling.Infix {operator: operator}
      let operandSlice = Vector.asSlice<Shared<Type>>(&operands)
      let selected = run selectOperator(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        &spelling,
        operandSlice,
        constraints,
        closed,
        module,
        operatorAnchor,
      )
      match move selected {
        Result<Option<SelectedOperator>, Shared<Rejection>>.Success {value: available} => match move available {
          Option<SelectedOperator>.Some {value: chosen} => {
            let mut arguments = Vector.make<BodyNodeId>()
            run Vector.append<BodyNodeId>(&mut arguments, leftNode)
            run Vector.append<BodyNodeId>(&mut arguments, rightNode)
            let typed = run checkedOperatorCall(
              &mut resolver.*,
              move chosen,
              move arguments,
              &mut signatures.*,
              &mut requiredBodies.*,
              module,
              operatorAnchor,
            )
            match move typed {
              Result<CheckedOperatorCall, Shared<Rejection>>.Success {value: accepted} => {
                let CheckedOperatorCall {ty: resultType, form: selectedForm} = move accepted
                ty = move resultType
                form = move selectedForm
              }
              Result<CheckedOperatorCall, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
              }
            }
          }
          Option<SelectedOperator>.None => match move concrete {
            Option<Operator.ResultType>.Some {value: result} => {
              ty = match result {
                OperatorResultType.Operand => Shared.clone<Type>(&leftType)
                OperatorResultType.Boolean => run primitiveType(b"bool")
              }
              form = BodyExpression.ConcreteInfix {
                operator: operator,
                left: leftNode,
                right: rightNode,
              }
            }
            Option<Operator.ResultType>.None => {
              return run bodyRejection(
                &resolver.*,
                module,
                RejectionCode.MissingOperator,
                operatorAnchor,
              )
            }
          }
        }
        Result<Option<SelectedOperator>, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
        }
      }
    }
    Node.CallExpression {callee, generics, arguments} => {
      let qualified = run bodyQualifiedName(&resolver.source, cursor, callee)
      let receiverSpelling = match & qualified {
        Option<QualifiedBodyName>.Some {..} => false
        Option<QualifiedBodyName>.None => true
      }
      if let Option<QualifiedBodyName>.Some {value: name} = move qualified {
        let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
        if moduleOrdinal == usize.MAX {
          fail InvalidModulePath {}
        }
        let selection = run selectDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          moduleOrdinal,
          module,
          Bytes.asSlice(&name.namespace),
          false,
          name.subjectSpan,
          RejectionCode.NotCallable,
        )
        if let Result<SelectedDeclaration, Shared<Rejection>>.Success {value: target} = move selection {
          let declaredModule = run resolvedModule(&resolver.*, target.module)
          let written = run header(&mut resolver.*, &declaredModule, target.ordinal)
          if let Option<HeaderSyntax>.Some {value: named} = move written {
            if let Node.InterfaceHeader {isPublic, ..} = named.header {
              return run checkQualifiedInterfaceCall(
                &mut resolver.*,
                &mut owner.*,
                &mut request.*,
                &mut dependencies.*,
                module,
                cursor,
                locals,
                calls,
                &mut nodes.*,
                &mut signatures.*,
                &mut requiredBodies.*,
                expression,
                arguments,
                expected,
                constraints,
                contractBody,
                &name,
                move target,
                isPublic,
              )
            }
          }
        }
      }
      if receiverSpelling {
        if let Node.FieldExpression {subject, field} = run bodyNode(
          &resolver.source,
          cursor,
          callee,
        ) {
          return run checkReceiverCall(
            &mut resolver.*,
            &mut owner.*,
            &mut request.*,
            &mut dependencies.*,
            module,
            cursor,
            locals,
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            expression,
            subject,
            field,
            generics,
            arguments,
            expected,
            constraints,
            contractBody,
          )
        }
      }
      let found = run resolvedCall(calls, expression)
      let resolved = match move found {
        Option<Result<ResolvedTarget, Shared<Rejection>>>.Some {value} => match move value {
          Result<ResolvedTarget, Shared<Rejection>>.Success {value: target} => target
          Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
          }
        }
        Option<Result<ResolvedTarget, Shared<Rejection>>>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
      let target = match move resolved {
        ResolvedTarget.Function {target} => target
        ResolvedTarget.Constant {..} => {
          return run bodyRejection(&resolver.*, module, RejectionCode.NotCallable, span)
        }
        ResolvedTarget.Intrinsic {member} => {
          if !staticBody {
            return run bodyRejection(&resolver.*, module, RejectionCode.StaticPhaseViolation, span)
          }
          if arguments.length != intrinsicArity(member) {
            return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
          }
          let mut checkedArguments = Vector.make<BodyNodeId>()
          let mut at = usize.ZERO
          while at < arguments.length {
            let kind = match move intrinsicParameterKind(member, at) {
              Option<IntrinsicValueKind>.Some {value} => value
              Option<IntrinsicValueKind>.None => {
                return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
              }
            }
            let mut context = Option.none<Shared<Type>>()
            if kind != IntrinsicValueKind.Text {
              context = Option.some<Shared<Type>>(run intrinsicValueType(kind))
            }
            let argumentId = run bodyChild(&resolver.source, cursor, arguments, at)
            let checked = run checkExpression(
              &mut resolver.*,
              &mut owner.*,
              &mut request.*,
              &mut dependencies.*,
              module,
              cursor,
              locals,
              calls,
              &mut nodes.*,
              &mut signatures.*,
              &mut requiredBodies.*,
              argumentId,
              &context,
              constraints,
              contractBody,
              staticBody,
            )
            let argumentNode = match move checked {
              Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
              Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
                return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
              }
            }
            let evidence = bodyExpressionType(Vector.asSlice<BodyNode>(&nodes.*), &argumentNode)
            let valid = match move evidence {
              Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(
                &value,
                fn(resolved: &Type) -> bool {
                  return intrinsicMatches(kind, resolved)
                },
              )
              Option<Shared<Type>>.None => false
            }
            if !valid {
              return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
            }
            run Vector.append<BodyNodeId>(&mut checkedArguments, argumentNode)
            at = at + usize.ONE
          }
          ty = run intrinsicValueType(intrinsicResultKind(member))
          if let Option<Shared<Type>>.Some {value} = &expected.* {
            if !run Type.equalsShared(&ty, &value) {
              return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
            }
          }
          let index = Vector.length<BodyNode>(&nodes.*)
          run Vector.append<BodyNode>(
            &mut nodes.*,
            BodyNode {
              origin: BodyOrigin {syntax: expression, span: span},
              kind: BodyNodeKind.Expression {
                ty: move ty,
                form: BodyExpression.IntrinsicCall {
                  member: member,
                  arguments: move checkedArguments,
                },
              },
            },
          )
          return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
        }
      }
      let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
        &target.signature,
        signatureParameterCount,
      )
      if arguments.length > parameterCount {
        return run bodyRejection(&resolver.*, module, RejectionCode.CallArity, span)
      }
      if arguments.length == usize.ZERO && parameterCount > usize.ZERO {
        return run bodyRejection(&resolver.*, module, RejectionCode.RedundantCall, span)
      }
      if Shared.with<Result<Answer, NoRejection>, bool>(
        &target.signature,
        signatureOutsideScalarBodies,
      ) {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      let binderCount = Shared.with<Result<Answer, NoRejection>, usize>(
        &target.signature,
        signatureBinderCount,
      )
      let callOwner = run Shared.make<DeclarationId>(run DeclarationId.copy(&target.declaration))
      let mut variables = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(
        &mut variables,
        Shared.clone<DeclarationId>(&callOwner),
      )
      let mut inferred = Vector.make<Binding>()
      let explicit = Vector.asSlice<Argument>(&target.explicit)
      let mut binderAt = usize.ZERO
      while binderAt < explicit.length {
        let value = match & explicit[binderAt] {
          Argument.Type {value} => Argument.Type {value: Shared.clone<Type>(&value)}
          Argument.Lifetime {value} => Argument.Lifetime {value: Shared.clone<Lifetime>(&value)}
          Argument.Row {value} => Argument.Row {value: Shared.clone<Row>(&value)}
        }
        run Vector.append<Binding>(
          &mut inferred,
          Binding {
            declaration: Shared.clone<DeclarationId>(&callOwner),
            ordinal: binderAt,
            value: move value,
          },
        )
        binderAt = binderAt + usize.ONE
      }
      let mut typedArguments = Vector.make<BodyNodeId>()
      let parameterOffset = parameterCount - arguments.length
      let mut at = usize.ZERO
      while at < arguments.length {
        let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
          &target.signature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
            return signatureParameter(answer, at + parameterOffset)
          },
        )
        if let Option<Shared<Type>>.Some {value: parameterType} = move parameter {
          let ordinal = Shared.with<Type, usize>(
            &parameterType,
            fn(value: &Type) -> usize {
              return Type.parameterOrdinalOf(value, &target.declaration)
            },
          )
          if ordinal != usize.MAX && ordinal >= binderCount {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
          let mut argumentContext = Option.none<Shared<Type>>()
          if Shared.with<Type, bool>(
            &parameterType,
            fn(value: &Type) -> bool {
              return scalarType(value) || pointerSizedIntegerType(value)
            },
          ) {
            argumentContext = Option.some<Shared<Type>>(Shared.clone<Type>(&parameterType))
          }
          if ordinal != usize.MAX {
            let fixed = bindingArgumentAt(Vector.asSlice<Binding>(&inferred), ordinal)
            if let Option<Argument>.Some {value: supplied} = move fixed {
              if let Argument.Type {value: fixedType} = move supplied {
                if Shared.with<Type, bool>(
                  &fixedType,
                  fn(value: &Type) -> bool {
                    return scalarType(value) || pointerSizedIntegerType(value)
                  },
                ) {
                  argumentContext = Option.some<Shared<Type>>(move fixedType)
                }
              }
            }
          }
          let argumentId = run bodyChild(&resolver.source, cursor, arguments, at)
          let argument = run checkExpression(
            &mut resolver.*,
            &mut owner.*,
            &mut request.*,
            &mut dependencies.*,
            module,
            cursor,
            locals,
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            argumentId,
            &argumentContext,
            constraints,
            contractBody,
            staticBody,
          )
          match move argument {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              let checked = Vector.asSlice<BodyNode>(&nodes.*)
              let evidence = match & checked[node.index].kind {
                BodyNodeKind.Expression {ty: argumentType, ..} => Shared.clone<Type>(&argumentType)
                _ => {
                  return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
                }
              }
              if !contractBody && !staticBody && !Shared.with<Type, bool>(&evidence, scalarType) {
                return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
              }
              let matched = run Type.unify(
                &parameterType,
                &evidence,
                Vector.asSlice<Shared<DeclarationId>>(&variables),
                Comparison.Exact,
                &mut inferred,
              )
              match move matched {
                Unification.Unified => ()
                Unification.Distinct => {
                  return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
                }
                Unification.Undetermined {at: undecided} => {
                  drop undecided
                  return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
                }
              }
              run Vector.append<BodyNodeId>(&mut typedArguments, node)
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
            }
          }
        } else {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
        at = at + usize.ONE
      }
      if arguments.length < parameterCount {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      if Vector.length<Binding>(&inferred) < binderCount {
        let inferredFromProvider = run inferFromProviderBounds(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          module,
          &target.signature,
          &callOwner,
          constraints,
          &mut inferred,
          span,
        )
        if let Option<Shared<Rejection>>.Some {value} = move inferredFromProvider {
          return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
        }
      }
      let mut unresolvedAt = usize.ZERO
      while unresolvedAt < binderCount {
        let evidence = bindingArgumentAt(Vector.asSlice<Binding>(&inferred), unresolvedAt)
        if let Option<Argument>.None = move evidence {
          return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
        }
        unresolvedAt = unresolvedAt + usize.ONE
      }
      let mut specialized = run copyArguments(Vector.asSlice<Argument>(&target.explicit))
      let mut specializeAt = Vector.length<Argument>(&specialized)
      while specializeAt < binderCount {
        let evidence = bindingArgumentAt(Vector.asSlice<Binding>(&inferred), specializeAt)
        match move evidence {
          Option<Argument>.Some {value} => run Vector.append<Argument>(&mut specialized, move value)
          Option<Argument>.None => {
            return run bodyRejection(&resolver.*, module, RejectionCode.UninferredParameter, span)
          }
        }
        specializeAt = specializeAt + usize.ONE
      }
      let mut result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
        &target.signature,
        signatureResult,
      )
      let mut appliedBounds = Vector.make<Constraint>()
      if binderCount == usize.ZERO {
        let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(
          &target.signature,
          signatureConstraintCount,
        )
        let mut boundAt = usize.ZERO
        while boundAt < boundCount {
          let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
            &target.signature,
            fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
              return signatureConstraint(answer, boundAt)
            },
          )
          if let Option<Constraint>.Some {value} = move bound {
            run Vector.append<Constraint>(&mut appliedBounds, move value)
          }
          boundAt = boundAt + usize.ONE
        }
      }
      if binderCount > usize.ZERO {
        let targetModuleOrdinal = knownModuleOrdinal(
          &resolver.*,
          DeclarationId.moduleId(&target.declaration),
        )
        if targetModuleOrdinal == usize.MAX {
          fail InvalidModulePath {}
        }
        let targetModule = run resolvedModule(&resolver.*, targetModuleOrdinal)
        let declaration = run ordinalOfIdentity(&mut resolver.*, &targetModule, &callOwner)
        let targetOrdinal = match move declaration {
          Option<usize>.Some {value} => value
          Option<usize>.None => {
            return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
          }
        }
        let mut applied = run resolveSignatureUnder(
          &mut resolver.*,
          &mut owner.*,
          Key {
            family: Family.Signature,
            module: targetModuleOrdinal,
            name: usize.ZERO,
            declaration: targetOrdinal,
            member: usize.ZERO,
            external: false,
          },
          Vector.make<Dependency>(),
          Option.none<Vector<Argument>>(),
          Option.some<Vector<Argument>>(run copyArguments(Vector.asSlice<Argument>(&specialized))),
        )
        while Vector.length<Dependency>(&applied.dependencies) > usize.ZERO {
          let edge = Vector.remove<Dependency>(&mut applied.dependencies, usize.ZERO)
          run Vector.append<Dependency>(&mut dependencies.*, move edge)
        }
        match & applied.outcome {
          Outcome.Success {value: Value.Signature {signature}} => {
            appliedBounds = run copyConstraints(Vector.asSlice<Constraint>(&signature.constraints))
            result = Option.some<Shared<Type>>(Shared.clone<Type>(&signature.result))
          }
          Outcome.Rejected {diagnostic} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(
              Shared.clone<Rejection>(&diagnostic),
            )
          }
          _ => {
            result = Option.none<Shared<Type>>()
          }
        }
      }
      let declaredBounds = run copyConstraints(constraints)
      let failed = run proveAppliedBounds(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &declaredBounds,
        Vector.asSlice<Constraint>(&appliedBounds),
        module,
        span,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Result.failResult<BodyNodeId, Shared<Rejection>>(move value)
      }
      let callResult = match move result {
        Option<Shared<Type>>.Some {value} => value
        Option<Shared<Type>>.None => {
          return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
        }
      }
      let mut ownedTypes = Vector.make<usize>()
      let mut ownedLifetimes = Vector.make<usize>()
      let mut ownedRows = Vector.make<usize>()
      run Type.collectOwned(
        &callResult,
        &target.declaration,
        &mut ownedTypes,
        &mut ownedLifetimes,
        &mut ownedRows,
      )
      if Vector.length<usize>(&ownedTypes) > usize.ZERO || Vector.length<usize>(&ownedLifetimes) > usize.ZERO || Vector.length<
        usize,
      >(&ownedRows) > usize.ZERO {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      ty = move callResult
      if !contractBody && !staticBody && !Shared.with<Type, bool>(&ty, scalarType) {
        return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
      }
      run Vector.append<SignatureDependency>(
        &mut signatures.*,
        SignatureDependency {declaration: run DeclarationId.copy(&target.declaration)},
      )
      run Vector.append<DeclarationId>(
        &mut requiredBodies.*,
        run DeclarationId.copy(&target.declaration),
      )
      form = BodyExpression.DirectCall {
        declaration: run DeclarationId.copy(&target.declaration),
        genericArguments: move specialized,
        receiverPass: Option.none<BodyReceiverPass>(),
        arguments: move typedArguments,
      }
    }
    _ => {
      return run bodyRejection(&resolver.*, module, RejectionCode.Unsupported, span)
    }
  }
  if !diverges {
    if let Option<Shared<Type>>.Some {value} = &expected.* {
      if !run Type.equalsShared(&ty, &value) {
        return run bodyRejection(&resolver.*, module, RejectionCode.TypeMismatch, span)
      }
    }
  }
  let index = Vector.length<BodyNode>(&nodes.*)
  run Vector.append<BodyNode>(
    &mut nodes.*,
    BodyNode {
      origin: BodyOrigin {syntax: expression, span: span},
      kind: BodyNodeKind.Expression {ty: move ty, form: move form},
    },
  )
  return Result.succeed<BodyNodeId, Shared<Rejection>>(BodyNodeId {index: index})
}

fn bodyHasReceiverPass(nodes: &[BodyNode]) -> bool {
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form, ..} = &nodes[at].kind {
      match & form {
        BodyExpression.DirectCall {receiverPass, ..} => {
          if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
            return true
          }
        }
        BodyExpression.InterfaceCall {receiverPass, ..} => {
          if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
            return true
          }
        }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn retainReceiverPass(
  node: &BodyNode,
  receiverPass: &Option<BodyReceiverPass>,
  arguments: &Vector<BodyNodeId>,
  obligations: &mut Vector<BodySafetyObligation>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<BodyReceiverPass>.Some {value: mode} = &receiverPass.* {
    let supplied = Vector.asSlice<BodyNodeId>(arguments)
    if supplied.length > usize.ZERO {
      run Vector.append<BodySafetyObligation>(
        &mut obligations.*,
        BodySafetyObligation.ReceiverPass {
          origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
          receiver: BodyNodeId {index: supplied[usize.ZERO].index},
          mode: mode,
        },
      )
    }
  }
  return ()
}

// Contract typing retains the source places whose ownership, lifetime, and cleanup safety must
// be discharged later. A successful contract-typed body is not a full safety result.
effect fn bodySafetyObligations(locals: &[BodyLocal], nodes: &[BodyNode]) -> Vector<
  BodySafetyObligation,
> ! OutOfMemoryError ? &mut Allocator {
  let mut obligations = Vector.make<BodySafetyObligation>()
  let mut localAt = usize.ZERO
  while localAt < locals.length {
    let local = &locals[localAt]
    if !Shared.with<Type, bool>(&local.ty, scalarType) {
      run Vector.append<BodySafetyObligation>(
        &mut obligations,
        BodySafetyObligation.WholeValue {
          origin: BodyOrigin {syntax: local.origin.syntax, span: local.origin.span},
          ty: Shared.clone<Type>(&local.ty),
        },
      )
    }
    localAt = localAt + usize.ONE
  }
  let mut at = usize.ZERO
  while at < nodes.length {
    let node = &nodes[at]
    if let BodyNodeKind.Expression {ty, form} = &node.kind {
      match & form {
        BodyExpression.Local {..} => {
          if !Shared.with<Type, bool>(&ty, scalarType) {
            run Vector.append<BodySafetyObligation>(
              &mut obligations,
              BodySafetyObligation.WholeValue {
                origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
                ty: Shared.clone<Type>(&ty),
              },
            )
          }
        }
        BodyExpression.DirectCall {declaration, receiverPass, arguments, ..} => {
          run Vector.append<BodySafetyObligation>(
            &mut obligations,
            BodySafetyObligation.Invocation {
              origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
              declaration: run DeclarationId.copy(&declaration),
            },
          )
          run retainReceiverPass(node, &receiverPass, &arguments, &mut obligations)
        }
        BodyExpression.InterfaceCall {operation, receiverPass, arguments, ..} => {
          run Vector.append<BodySafetyObligation>(
            &mut obligations,
            BodySafetyObligation.Invocation {
              origin: BodyOrigin {syntax: node.origin.syntax, span: node.origin.span},
              declaration: run DeclarationId.copy(&operation),
            },
          )
          run retainReceiverPass(node, &receiverPass, &arguments, &mut obligations)
        }
        _ => ()
      }
    }
    at = at + usize.ONE
  }
  return move obligations
}

fn rejectedBody(diagnostic: Shared<Rejection>, dependencies: Vector<Dependency>) -> Answer {
  return Answer {
    outcome: Outcome.Rejected {diagnostic: move diagnostic},
    dependencies: move dependencies,
    sources: Vector.make<Shared<Observation>>(),
    footprint: Vector.make<Shared<DemandFootprint>>(),
    answerId: usize.ZERO,
    identity: Option.none<Shared<Value>>(),
    bodyEvidence: Option.none<Shared<BodyEvidence>>(),
  }
}

fn sameBinderName(hir: &Module, left: HirId, right: HirId) -> bool {
  if let Node.Name {text: leftName} = Module.node(hir, left) {
    if let Node.Name {text: rightName} = Module.node(hir, right) {
      return same(Module.text(hir, leftName), Module.text(hir, rightName))
    }
  }
  return false
}

effect fn bodyNode(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> Node
! RevisionMismatch {
  if let Option<Node>.Some {value} = move SourceIndex.authoredNode(source, cursor, id) {
    return value
  }
  fail RevisionMismatch {}
}

effect fn bodySpan(source: &SourceIndex, cursor: &AuthoredCursor, id: HirId) -> Span
! RevisionMismatch {
  if let Option<Span>.Some {value} = move SourceIndex.authoredSpan(source, cursor, id) {
    return value
  }
  fail RevisionMismatch {}
}

effect fn bodyChild(source: &SourceIndex, cursor: &AuthoredCursor, range: Range, at: usize) -> HirId
! RevisionMismatch {
  if let Option<HirId>.Some {value} = move SourceIndex.authoredChild(source, cursor, range, at) {
    return value
  }
  fail RevisionMismatch {}
}

effect fn bodyText(source: &SourceIndex, cursor: &AuthoredCursor, symbol: Symbol) -> Bytes
! RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Option<&[u8]>.Some {value} = move SourceIndex.authoredText(source, cursor, symbol) {
    return run Bytes.copy(value)
  }
  fail RevisionMismatch {}
}

effect fn bodySameBinderName(
  source: &SourceIndex,
  cursor: &AuthoredCursor,
  left: HirId,
  right: HirId,
) -> bool ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.Name {text: leftName} = run bodyNode(source, cursor, left) {
    if let Node.Name {text: rightName} = run bodyNode(source, cursor, right) {
      let first = run bodyText(source, cursor, leftName)
      let second = run bodyText(source, cursor, rightName)
      return same(Bytes.asSlice(&first), Bytes.asSlice(&second))
    }
  }
  return false
}

effect fn bodyQualifiedName(source: &SourceIndex, cursor: &AuthoredCursor, callee: HirId) -> Option<
  QualifiedBodyName,
> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Node.FieldExpression {subject, field} = run bodyNode(source, cursor, callee) {
    if let Node.IdentifierExpression {name, binding} = run bodyNode(source, cursor, subject) {
      if !binding.present {
        if let Node.Name {text: namespaceSymbol} = run bodyNode(source, cursor, name) {
          if let Node.Name {text: memberSymbol} = run bodyNode(source, cursor, field) {
            return Option.some<QualifiedBodyName>(
              QualifiedBodyName {
                namespace: run bodyText(source, cursor, namespaceSymbol),
                member: run bodyText(source, cursor, memberSymbol),
                subjectSpan: run bodySpan(source, cursor, subject),
              },
            )
          }
        }
      }
    }
  }
  return Option.none<QualifiedBodyName>()
}

// Copy only the declaration-owned facts needed by the effectful checker. The source-index HIR
// loan ends with this preparation, so later semantic demands can borrow the resolver mutably.
effect fn prepareBody(
  resolver: &Resolver,
  module: &ModuleId,
  indexed: &IndexedSource,
  ordinal: usize,
  signature: &Shared<Result<Answer, NoRejection>>,
  parameterCount: usize,
  restricted: bool,
  contractBody: bool,
) -> Result<PreparedBody, Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
  if ordinal >= declarations.length {
    return Result.failResult<PreparedBody, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    )
  }
  let declaration = &declarations[ordinal]
  let hir = IndexedSource.authored(indexed)
  let headerSpan = Module.span(hir, declaration.header)
  let mut staticBody = false
  if restricted {
    return Result.failResult<PreparedBody, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
    )
  }
  let mut writtenParameters = Range.empty()
  match Module.node(hir, declaration.header) {
    Node.FunctionHeader {contract, ..} => match Module.node(hir, contract) {
      Node.CallableContract {parameters, isStatic, ..} => {
        staticBody = isStatic
        writtenParameters = parameters
      }
      _ => {
        return Result.failResult<PreparedBody, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
        )
      }
    }
    _ => {
      return Result.failResult<PreparedBody, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
      )
    }
  }
  if writtenParameters.length != parameterCount {
    return Result.failResult<PreparedBody, Shared<Rejection>>(
      run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
    )
  }
  let mut locals = Vector.make<BodyLocal>()
  let mut abstractBody = contractBody
  let mut at = usize.ZERO
  while at < parameterCount {
    let parameterId = Module.child(hir, writtenParameters, at)
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move selected {
      Option<Shared<Type>>.Some {value} => move value
      Option<Shared<Type>>.None => {
        return Result.failResult<PreparedBody, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
        )
      }
    }
    if !Shared.with<Type, bool>(&parameterType, scalarType) {
      abstractBody = true
    }
    let mut name = parameterId
    match Module.node(hir, parameterId) {
      Node.Parameter {name: writtenName, mode, ..} => {
        if mode != ParameterMode.Value {
          return Result.failResult<PreparedBody, Shared<Rejection>>(
            run reject(
              &resolver.*,
              module,
              RejectionCode.Unsupported,
              Module.span(hir, parameterId),
            ),
          )
        }
        name = writtenName
      }
      _ => {
        return Result.failResult<PreparedBody, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, Module.span(hir, parameterId)),
        )
      }
    }
    let mut prior = usize.ZERO
    while prior < Vector.length<BodyLocal>(&locals) {
      let earlierId = Vector.asSlice<BodyLocal>(&locals)[prior].origin.syntax
      if let Node.Parameter {name: earlier, ..} = Module.node(hir, earlierId) {
        if sameBinderName(hir, name, earlier) {
          return Result.failResult<PreparedBody, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Collision, Module.span(hir, name)),
          )
        }
      }
      prior = prior + usize.ONE
    }
    run Vector.append<BodyLocal>(
      &mut locals,
      BodyLocal {
        origin: BodyOrigin {syntax: parameterId, span: Module.span(hir, name)},
        ty: move parameterType,
        mutable: false,
      },
    )
    at = at + usize.ONE
  }
  let mut block = declaration.local
  match Module.node(hir, declaration.local) {
    Node.Declaration {body, ..} => match Module.node(hir, body) {
      Node.CallableBody {block: writtenBlock} => {
        if writtenBlock.present {
          if let Node.Block {..} = Module.node(hir, writtenBlock.id) {
            block = writtenBlock.id
          } else {
            return Result.failResult<PreparedBody, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
            )
          }
        } else {
          return Result.failResult<PreparedBody, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
          )
        }
      }
      _ => {
        return Result.failResult<PreparedBody, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
        )
      }
    }
    _ => {
      return Result.failResult<PreparedBody, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, headerSpan),
      )
    }
  }
  return Result.succeed<PreparedBody, Shared<Rejection>>(
    PreparedBody {
      block: block,
      identity: run DeclarationId.copy(&declaration.identity),
      locals: move locals,
      contractBody: abstractBody,
      staticBody: staticBody,
    },
  )
}

effect fn checkBlock(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  block: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.Block {statements: written} = run bodyNode(&resolver.source, cursor, block) {
    let mut bindings = Vector.make<HirId>()
    let mut statements = Vector.make<BodyNodeId>()
    let checked = run checkStatements(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      &mut locals.*,
      &mut bindings,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      &mut statements,
      written,
      resultType,
      constraints,
      contractBody,
      staticBody,
      loopDepth,
    )
    let canComplete = match move checked {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: block, span: run bodySpan(&resolver.source, cursor, block)},
        kind: BodyNodeKind.Block {statements: move statements, canComplete: canComplete},
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, block),
    ),
  )
}

effect fn checkConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statement: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.ConditionalStatement {condition, thenBranch, elseBranch} = run bodyNode(
    &resolver.source,
    cursor,
    statement,
  ) {
    let checkedCondition = run checkExpression(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      Vector.asSlice<BodyLocal>(&locals.*),
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      condition,
      &Option.none<Shared<Type>>(),
      constraints,
      contractBody,
      staticBody,
    )
    let conditionNode = match move checkedCondition {
      Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
      Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let boolType = run primitiveType(b"bool")
    let conditionType = match & Vector.asSlice<BodyNode>(&nodes.*)[conditionNode.index].kind {
      BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
      _ => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(
            &resolver.*,
            module,
            RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, condition),
          ),
        )
      }
    }
    if !run Type.equalsShared(&conditionType, &boolType) {
      return Result.failResult<CheckedControl, Shared<Rejection>>(
        run reject(
          &resolver.*,
          module,
          RejectionCode.ConditionNotBool,
          run bodySpan(&resolver.source, cursor, condition),
        ),
      )
    }
    let checkedThen = run checkBlock(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      module,
      cursor,
      &mut locals.*,
      annotations,
      calls,
      &mut nodes.*,
      &mut signatures.*,
      &mut requiredBodies.*,
      thenBranch,
      resultType,
      constraints,
      contractBody,
      staticBody,
      loopDepth,
    )
    let thenControl = match move checkedThen {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let mut checkedElse = Option.none<BodyNodeId>()
    let mut elseCanComplete = true
    if elseBranch.present {
      let otherwise = match run bodyNode(&resolver.source, cursor, elseBranch.id) {
        Node.Block {..} => run checkBlock(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          elseBranch.id,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth,
        )
        Node.ConditionalStatement {..} => run checkConditional(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          elseBranch.id,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth,
        )
        _ => Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(
            &resolver.*,
            module,
            RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, elseBranch.id),
          ),
        )
      }
      match move otherwise {
        Result<CheckedControl, Shared<Rejection>>.Success {value} => {
          checkedElse = Option.some<BodyNodeId>(value.node)
          elseCanComplete = value.canComplete
        }
        Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
        }
      }
    }
    let canComplete = thenControl.canComplete || elseCanComplete
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {
          syntax: statement,
          span: run bodySpan(&resolver.source, cursor, statement),
        },
        kind: BodyNodeKind.Branch {
          condition: conditionNode,
          thenBranch: thenControl.node,
          elseBranch: move checkedElse,
          canComplete: canComplete,
        },
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(
      &resolver.*,
      module,
      RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, statement),
    ),
  )
}

effect fn checkStaticConditional(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &mut Vector<BodyLocal>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statement: HirId,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
) -> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if let Node.StaticConditionalStatement {condition, thenBranch, elseBranch} = run bodyNode(
    &resolver.source, cursor, statement,
  ) {
    // The inactive arm contributes no body facts or diagnostics to this specialization.
    let evaluated = run staticExpression(
      &mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, Option.none<usize>(), condition, StaticRootExpectation.Boolean,
    )
    let value = match move evaluated {
      Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => value
      Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
      }
    }
    let selected = Shared.with<StaticData, Option<bool>>(
      &value,
      fn(fact: &StaticData) -> Option<bool> {
        return match &fact.* {
          StaticData.Boolean {value: flag} => Option.some<bool>(flag)
          _ => Option.none<bool>()
        }
      },
    )
    let chooseThen = match move selected {
      Option<bool>.Some {value: flag} => flag
      Option<bool>.None => {
        return Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(
            &resolver.*, module, RejectionCode.ConditionNotBool,
            run bodySpan(&resolver.source, cursor, condition),
          ),
        )
      }
    }
    let mut selectedArm = HirRef.absent()
    if chooseThen { selectedArm = HirRef.of(thenBranch) } else { selectedArm = elseBranch }
    let mut retained = Vector.make<BodyNodeId>()
    let mut canComplete = true
    if selectedArm.present {
      let checked = match run bodyNode(&resolver.source, cursor, selectedArm.id) {
        Node.Block {..} => run checkBlock(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, &mut locals.*, annotations, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, selectedArm.id, resultType,
          constraints, contractBody, staticBody, loopDepth,
        )
        Node.StaticConditionalStatement {..} => run checkStaticConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, &mut locals.*, annotations, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, selectedArm.id, resultType,
          constraints, contractBody, staticBody, loopDepth,
        )
        _ => Result.failResult<CheckedControl, Shared<Rejection>>(
          run reject(
            &resolver.*, module, RejectionCode.Unsupported,
            run bodySpan(&resolver.source, cursor, selectedArm.id),
          ),
        )
      }
      match move checked {
        Result<CheckedControl, Shared<Rejection>>.Success {value} => {
          run Vector.append<BodyNodeId>(&mut retained, value.node)
          canComplete = value.canComplete
        }
        Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<CheckedControl, Shared<Rejection>>(move error)
        }
      }
    }
    let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
    run Vector.append<BodyNode>(
      &mut nodes.*,
      BodyNode {
        origin: BodyOrigin {syntax: statement, span: run bodySpan(&resolver.source, cursor, statement)},
        kind: BodyNodeKind.Block {statements: move retained, canComplete: canComplete},
      },
    )
    return Result.succeed<CheckedControl, Shared<Rejection>>(
      CheckedControl {node: node, canComplete: canComplete},
    )
  }
  return Result.failResult<CheckedControl, Shared<Rejection>>(
    run reject(
      &resolver.*, module, RejectionCode.Unsupported,
      run bodySpan(&resolver.source, cursor, statement),
    ),
  )
}

effect fn checkStatements(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  cursor: &AuthoredCursor,
  locals: &mut Vector<BodyLocal>,
  bindings: &mut Vector<HirId>,
  annotations: &[ResolvedAnnotation],
  calls: &[ResolvedCall],
  nodes: &mut Vector<BodyNode>,
  signatures: &mut Vector<SignatureDependency>,
  requiredBodies: &mut Vector<DeclarationId>,
  statements: &mut Vector<BodyNodeId>,
  written: Range,
  resultType: &Shared<Type>,
  constraints: &[Constraint],
  contractBody: bool,
  staticBody: bool,
  loopDepth: usize,
) -> Result<bool, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut reachable = true
  let mut at = usize.ZERO
  while at < written.length {
    let statement = run bodyChild(&resolver.source, cursor, written, at)
    let span = run bodySpan(&resolver.source, cursor, statement)
    match run bodyNode(&resolver.source, cursor, statement) {
      Node.StaticConditionalStatement {..} => {
        let checked = run checkStaticConditional(
          &mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
          module, cursor, &mut locals.*, annotations, calls, &mut nodes.*,
          &mut signatures.*, &mut requiredBodies.*, statement, resultType,
          constraints, contractBody, staticBody, loopDepth,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.ConditionalStatement {..} => {
        let checked = run checkConditional(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          statement,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth,
        )
        match move checked {
          Result<CheckedControl, Shared<Rejection>>.Success {value} => {
            run Vector.append<BodyNodeId>(&mut statements.*, value.node)
            reachable = reachable && value.canComplete
          }
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.ReturnStatement {value: returned} => {
        if span.start == span.end && returned.present {
          match run bodyNode(&resolver.source, cursor, returned.id) {
            Node.UnitLiteral => {
              at = at + usize.ONE
              continue
            }
            _ => ()
          }
        }
        let mut checked = Option.none<BodyNodeId>()
        if returned.present {
          let expected = Option.some<Shared<Type>>(Shared.clone<Type>(resultType))
          let expression = run checkExpression(
            &mut resolver.*,
            &mut owner.*,
            &mut request.*,
            &mut dependencies.*,
            module,
            cursor,
            Vector.asSlice<BodyLocal>(&locals.*),
            calls,
            &mut nodes.*,
            &mut signatures.*,
            &mut requiredBodies.*,
            returned.id,
            &expected,
            constraints,
            contractBody,
            staticBody,
          )
          match move expression {
            Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
              checked = Option.some<BodyNodeId>(node)
            }
            Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
              return Result.failResult<bool, Shared<Rejection>>(move error)
            }
          }
        } else if Shared.with<Type, usize>(resultType, scalarCode) != 1 {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.TypeMismatch, span),
          )
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.Return {value: move checked},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      Node.ExpressionStatement {expression} => {
        let checked = run checkExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          Vector.asSlice<BodyLocal>(&locals.*),
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          expression,
          &Option.none<Shared<Type>>(),
          constraints,
          contractBody,
          staticBody,
        )
        match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: node} => {
            let diverges = match &Vector.asSlice<BodyNode>(&nodes.*)[node.index].kind {
              BodyNodeKind.Expression {ty, ..} => Shared.with<Type, bool>(&ty, neverType)
              _ => false
            }
            run Vector.append<BodyNodeId>(&mut statements.*, node)
            if diverges {
              reachable = false
            }
          }
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
      }
      Node.BindingStatement {name, mutable, isStatic, annotation, initializer} => {
        if isStatic {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
        let known = Vector.asSlice<HirId>(&bindings.*)
        let mut prior = usize.ZERO
        while prior < known.length {
          if run bodySameBinderName(&resolver.source, cursor, name, known[prior]) {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.Collision,
                run bodySpan(&resolver.source, cursor, name),
              ),
            )
          }
          prior = prior + usize.ONE
        }
        let mut expected = Option.none<Shared<Type>>()
        if annotation.present {
          let mut found = false
          let mut selected = usize.ZERO
          while selected < annotations.length {
            if annotations[selected].id.index == annotation.id.index {
              found = true
              match & annotations[selected].result {
                Result<Shared<Type>, Shared<Rejection>>.Success {value} => {
                  if !contractBody && !staticBody && !Shared.with<Type, bool>(&value, scalarType) {
                    return Result.failResult<bool, Shared<Rejection>>(
                      run reject(
                        &resolver.*,
                        module,
                        RejectionCode.Unsupported,
                        run bodySpan(&resolver.source, cursor, annotation.id),
                      ),
                    )
                  }
                  expected = Option.some<Shared<Type>>(Shared.clone<Type>(&value))
                }
                Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<bool, Shared<Rejection>>(Shared.clone<Rejection>(&error))
                }
              }
              break
            }
            selected = selected + usize.ONE
          }
          if !found {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.Unsupported,
                run bodySpan(&resolver.source, cursor, annotation.id),
              ),
            )
          }
        }
        let checked = run checkExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          Vector.asSlice<BodyLocal>(&locals.*),
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          initializer,
          &expected,
          constraints,
          contractBody,
          staticBody,
        )
        let initializerNode = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let checkedNodes = Vector.asSlice<BodyNode>(&nodes.*)
        let ty = match & checkedNodes[initializerNode.index].kind {
          BodyNodeKind.Expression {ty, ..} => Shared.clone<Type>(&ty)
          _ => {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(&resolver.*, module, RejectionCode.Unsupported, span),
            )
          }
        }
        let local = BodyLocalId {index: Vector.length<BodyLocal>(&locals.*)}
        run Vector.append<BodyLocal>(
          &mut locals.*,
          BodyLocal {
            origin: BodyOrigin {
              syntax: statement,
              span: run bodySpan(&resolver.source, cursor, name),
            },
            ty: move ty,
            mutable: mutable,
          },
        )
        run Vector.append<HirId>(&mut bindings.*, name)
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        let mut bindingKind = BodyNodeKind.LocalBinding {local: local, initializer: initializerNode}
        if mutable {
          bindingKind = BodyNodeKind.MutableBinding {local: local, initializer: initializerNode}
        }
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {origin: BodyOrigin {syntax: statement, span: span}, kind: move bindingKind},
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      Node.AssignmentStatement {target, value} => {
        let mut selected = Option.none<BodyLocalId>()
        if let Node.IdentifierExpression {binding, ..} = run bodyNode(
          &resolver.source,
          cursor,
          target,
        ) {
          if binding.present {
            let available = Vector.asSlice<BodyLocal>(&locals.*)
            let mut localAt = usize.ZERO
            while localAt < available.length {
              if available[localAt].origin.syntax.index == binding.id.index && available[localAt].mutable {
                selected = Option.some<BodyLocalId>(BodyLocalId {index: localAt})
                break
              }
              localAt = localAt + usize.ONE
            }
          }
        }
        let local = match move selected {
          Option<BodyLocalId>.Some {value: found} => found
          Option<BodyLocalId>.None => {
            return Result.failResult<bool, Shared<Rejection>>(
              run reject(
                &resolver.*,
                module,
                RejectionCode.StaticPhaseViolation,
                run bodySpan(&resolver.source, cursor, target),
              ),
            )
          }
        }
        let available = Vector.asSlice<BodyLocal>(&locals.*)
        let expected = Option.some<Shared<Type>>(Shared.clone<Type>(&available[local.index].ty))
        let checked = run checkExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          Vector.asSlice<BodyLocal>(&locals.*),
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          value,
          &expected,
          constraints,
          contractBody,
          staticBody,
        )
        let replacement = match move checked {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: found} => found
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.Assignment {local: local, value: replacement},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      Node.WhileStatement {condition, body} => {
        let boolType = Option.some<Shared<Type>>(run primitiveType(b"bool"))
        let checkedCondition = run checkExpression(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          Vector.asSlice<BodyLocal>(&locals.*),
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          condition,
          &boolType,
          constraints,
          contractBody,
          staticBody,
        )
        let conditionNode = match move checkedCondition {
          Result<BodyNodeId, Shared<Rejection>>.Success {value: found} => found
          Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let checkedBody = run checkBlock(
          &mut resolver.*,
          &mut owner.*,
          &mut request.*,
          &mut dependencies.*,
          module,
          cursor,
          &mut locals.*,
          annotations,
          calls,
          &mut nodes.*,
          &mut signatures.*,
          &mut requiredBodies.*,
          body,
          resultType,
          constraints,
          contractBody,
          staticBody,
          loopDepth + usize.ONE,
        )
        let bodyNode = match move checkedBody {
          Result<CheckedControl, Shared<Rejection>>.Success {value: found} => found.node
          Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<bool, Shared<Rejection>>(move error)
          }
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {
            origin: BodyOrigin {syntax: statement, span: span},
            kind: BodyNodeKind.While {condition: conditionNode, body: bodyNode},
          },
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
      }
      Node.BreakStatement => {
        if loopDepth == usize.ZERO {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span),
          )
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {origin: BodyOrigin {syntax: statement, span: span}, kind: BodyNodeKind.Break},
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      Node.ContinueStatement => {
        if loopDepth == usize.ZERO {
          return Result.failResult<bool, Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, span),
          )
        }
        let node = BodyNodeId {index: Vector.length<BodyNode>(&nodes.*)}
        run Vector.append<BodyNode>(
          &mut nodes.*,
          BodyNode {origin: BodyOrigin {syntax: statement, span: span}, kind: BodyNodeKind.Continue},
        )
        run Vector.append<BodyNodeId>(&mut statements.*, node)
        reachable = false
      }
      _ => {
        return Result.failResult<bool, Shared<Rejection>>(
          run reject(&resolver.*, module, RejectionCode.Unsupported, span),
        )
      }
    }
    at = at + usize.ONE
  }
  return Result.succeed<bool, Shared<Rejection>>(reachable)
}

effect fn currentKey(resolver: &mut Resolver, prior: &BodyDependency) -> Option<Key>
! Cycle | OutOfMemoryError
? &mut Allocator {
  let previous = prior.key
  if previous.family == Family.Name {
    return Option.some<Key>(previous)
  }
  let module = run resolvedModule(&resolver.*, previous.module)
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut found = Option.none<usize>()
    let mut at = usize.ZERO
    while at < declarations.length {
      let matches = match & prior.declaration {
        Option<Shared<DeclarationId>>.Some {value: old} => Shared.with<DeclarationId, bool>(
          &old,
          fn(previous: &DeclarationId) -> bool {
            return DeclarationId.equals(previous, &declarations[at].identity)
          },
        )
        Option<Shared<DeclarationId>>.None => false
      }
      if !declarations[at].ambiguous && matches {
        if let Option<usize>.Some {value: _} = &found {
          return Option.none<Key>()
        }
        found = Option.some<usize>(at)
      }
      at = at + usize.ONE
    }
    if let Option<usize>.Some {value} = move found {
      return Option.some<Key>(
        Key {
          family: previous.family,
          module: previous.module,
          name: previous.name,
          declaration: value,
          member: previous.member,
          external: previous.external,
        },
      )
    }
  }
  return Option.none<Key>()
}

effect fn reuseBody(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: BodyCandidate,
) -> Option<Answer>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let BodyCandidate {body, evidence, directCount} = move candidate
  let module = run resolvedModule(&resolver.*, key.module)
  let sourceAnswer = run source(&mut resolver.*, &module)
  let mut validInput = false
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if key.declaration < declarations.length && !declarations[key.declaration].ambiguous {
      let hir = IndexedSource.authored(indexed)
      let header = run Fingerprint.header(hir, declarations[key.declaration].local)
      let implementation = run Fingerprint.body(hir, declarations[key.declaration].local)
      validInput = Shared.with<TypedBody, bool>(
        &body,
        fn(checked: &TypedBody) -> bool {
          return TypedBody.matchesInput(
            checked,
            indexed,
            key.declaration,
            Vector.asSlice<u8>(&header),
            Vector.asSlice<u8>(&implementation),
          )
        },
      )
    }
  }
  if !validInput {
    return Option.none<Answer>()
  }
  let count = Shared.with<BodyEvidence, usize>(
    &evidence,
    fn(owned: &BodyEvidence) -> usize {
      return Vector.length<BodyDependency>(&owned.direct)
    },
  )
  if count != directCount {
    return Option.none<Answer>()
  }
  let mut dependencies = Vector.make<Dependency>()
  let mut at = usize.ZERO
  while at < count {
    let prior = Shared.with<BodyEvidence, BodyDependency>(
      &evidence,
      fn(owned: &BodyEvidence) -> BodyDependency {
        return bodyDependencyAt(owned, at)
      },
    )
    let current = run currentKey(&mut resolver.*, &prior)
    let selected = match move current {
      Option<Key>.Some {value} => value
      Option<Key>.None => {
        return Option.none<Answer>()
      }
    }
    let now = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      selected,
      Span.make(usize.ZERO, usize.ZERO),
    )
    if prior.answerId == Shared.with<Result<Answer, NoRejection>, usize>(&now, priorAnswerId) && prior.answerId != usize.ZERO {
      at = at + usize.ONE
      continue
    }
    let previousIdentity = match & prior.identity {
      Option<Shared<Value>>.Some {value} => Option.some<Shared<Value>>(Shared.clone<Value>(&value))
      Option<Shared<Value>>.None => Option.none<Shared<Value>>()
    }
    let currentIdentity = Shared.with<Result<Answer, NoRejection>, Option<Shared<Value>>>(
      &now,
      answerIdentity,
    )
    let matching = match move previousIdentity {
      Option<Shared<Value>>.Some {value: first} => match move currentIdentity {
        Option<Shared<Value>>.Some {value: second} => sameSharedValue(&first, &second)
        Option<Shared<Value>>.None => false
      }
      Option<Shared<Value>>.None => false
    }
    if !matching {
      return Option.none<Answer>()
    }
    at = at + usize.ONE
  }
  return Option.some<Answer>(
    Answer {
      outcome: Outcome.Success {
        value: Value.Body {
          body: move body,
          source: run Shared.make<Observation>(
            run SourceIndex.captureObservation(&resolver.source, &module),
          ),
        },
      },
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    },
  )
}

struct WrittenInitializer {
  expression: Option<HirId>
  span: Span
}

// A schema header must start with an admitted value constructor. Nominal member shapes are
// checked when the concrete schema is assembled, after forward declarations become available.
fn parameterTypeHead(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {name} => {
      let spelling = Bytes.asSlice(&name)
      return same(spelling, b"bool") || fixedIntegerName(spelling) || pointerSizedIntegerName(
        spelling,
      )
    }
    Type.String {..} => true
    Type.Array {element, ..} => Shared.with<Type, bool>(&element, parameterTypeHead)
    Type.Nominal {declaration, ..} => {
      let kind = DeclarationId.kind(&declaration)
      return kind == OwnerKind.Struct || kind == OwnerKind.Enumeration || kind == OwnerKind.Union
    }
    _ => false
  }
}

fn pointerSized(value: &Type) -> bool {
  return match & value.* {
    Type.Primitive {name} => same(Bytes.asSlice(&name), b"usize") || same(
      Bytes.asSlice(&name),
      b"isize",
    )
    _ => false
  }
}

fn initializerValue(answer: &Result<Answer, NoRejection>) -> Option<Shared<StaticData>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Option.some<
        Shared<StaticData>,
      >(Shared.clone<StaticData>(&found))
      _ => Option.none<Shared<StaticData>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<StaticData>>()
  }
}

effect fn resolveParameterSchema(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.PackageParameterHeader {isPublic, annotation, ..} = value.header {
      let source = run source(&mut resolver.*, &module)
      let mut hasDefault = false
      let mut hasValidation = false
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
        &resolver.*,
        &source,
        &module,
      ) {
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        if key.declaration < declarations.length {
          let hir = IndexedSource.authored(indexed)
          if let Node.Declaration {body, ..} = Module.node(hir, declarations[key.declaration].local) {
            if let Node.PackageParameterBody {default, validation} = Module.node(hir, body) {
              hasDefault = default.present
              hasValidation = validation.present
            }
          }
        }
      }
      if !isPublic && !hasDefault {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
          move dependencies,
        )
      }
      let noBinders = Vector.make<Binder>()
      let mut elision = LifetimeElision {
        owner: Option.none<DeclarationId>(),
        nextOrdinal: usize.ZERO,
        output: true,
        resultDefault: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Static)),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
        supplied: Option.none<Vector<Argument>>(),
        assumptions: Option.none<Vector<Constraint>>(),
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        annotation,
        Vector.asSlice<Binder>(&noBinders),
        &mut elision,
      )
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Type.hasOpenParameters(&ty) || !Shared.with<Type, bool>(&ty, parameterTypeHead) {
            return memberRejected(
              run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
              move dependencies,
            )
          }
          let identity = run declarationAt(&mut resolver.*, &module, key.declaration)
          if let Option<DeclarationId>.Some {value: declaration} = move identity {
            return memberSuccess(
              Value.ParameterSchema {
                schema: run Shared.make<ParameterSchema>(
                  ParameterSchema {
                    declaration: move declaration,
                    ty: move ty,
                    isPublic: isPublic,
                    hasDefault: hasDefault,
                    hasValidation: hasValidation,
                    span: value.span,
                  },
                ),
              },
              move dependencies,
            )
          }
          return memberRejected(
            run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
            move dependencies,
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => memberRejected(
          move error,
          move dependencies,
        )
      }
    }
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, value.span),
      move dependencies,
    )
  }
  return memberRejected(
    run reject(
      &resolver.*,
      &module,
      RejectionCode.InvalidParameterSchema,
      Span.make(usize.ZERO, usize.ZERO),
    ),
    move dependencies,
  )
}

fn selectedParameterSchema(answer: &Result<Answer, NoRejection>) -> Option<Shared<ParameterSchema>> {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.ParameterSchema {schema}} => Option.some<Shared<ParameterSchema>>(
        Shared.clone<ParameterSchema>(&schema),
      )
      _ => Option.none<Shared<ParameterSchema>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ParameterSchema>>()
  }
}

struct WrittenDefault {
  expression: Option<HirId>
  span: Span
}

effect fn parameterDefaultSyntax(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  fallback: Span,
) -> WrittenDefault ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.PackageParameterBody {default, ..} = Module.node(hir, body) {
          if default.present {
            return WrittenDefault {
              expression: Option.some<HirId>(default.id),
              span: Module.span(hir, default.id),
            }
          }
        }
      }
    }
  }
  return WrittenDefault {expression: Option.none<HirId>(), span: fallback}
}

effect fn resolveParameterDefault(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let declared = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    Key {
      family: Family.ParameterSchema, module: key.module, name: usize.ZERO,
      declaration: key.declaration, member: usize.ZERO, external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<ParameterSchema>>>(
    &declared, selectedParameterSchema,
  )
  let schema = match move selected {
    Option<Shared<ParameterSchema>>.Some {value} => value
    Option<Shared<ParameterSchema>>.None => {
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &declared, answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return memberRejected(move value, move dependencies)
      }
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, Span.make(usize.ZERO, usize.ZERO)),
        move dependencies,
      )
    }
  }
  let declaredType = Shared.with<ParameterSchema, Shared<Type>>(
    &schema,
    fn(header: &ParameterSchema) -> Shared<Type> { return Shared.clone<Type>(&header.ty) },
  )
  let fallback = Shared.with<ParameterSchema, Span>(
    &schema,
    fn(header: &ParameterSchema) -> Span { return header.span },
  )
  let written = run parameterDefaultSyntax(&mut resolver.*, &module, key.declaration, fallback)
  let expression = match move written.expression {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidParameterSchema, written.span),
        move dependencies,
      )
    }
  }
  let evaluated = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option.some<usize>(key.declaration), expression,
    StaticRootExpectation.Resolved {ty: Shared.clone<Type>(&declaredType)},
  )
  return match move evaluated {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => {
      if run StaticValue.matchesType(&value, &declaredType) {
        return memberSuccess(
          Value.ParameterDefault {value: move value, span: written.span},
          move dependencies,
        )
      }
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.TypeMismatch, written.span),
        move dependencies,
      )
    }
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => memberRejected(move error, move dependencies)
  }
}

effect fn resolveConstant(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let written = run header(&mut resolver.*, &module, key.declaration)
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ConstantHeader {annotation, ..} = value.header {
      if !annotation.present {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.InvalidConstant, value.span),
          move dependencies,
        )
      }
      let noBinders = Vector.make<Binder>()
      // A constant is static data, so an omitted `string` lifetime is `'static`.
      let mut elision = LifetimeElision {
        owner: Option.none<DeclarationId>(),
        nextOrdinal: usize.ZERO,
        output: true,
        resultDefault: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Static)),
        generated: Vector.make<Shared<Lifetime>>(),
        invocation: false,
        nested: false,
        renumber: Vector.make<usize>(),
        staticEnvironment: false,
        supplied: Option.none<Vector<Argument>>(),
        assumptions: Option.none<Vector<Constraint>>(),
      }
      let resolved = run resolveType(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies,
        key.module,
        annotation.id,
        Vector.asSlice<Binder>(&noBinders),
        &mut elision,
      )
      return match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value: ty} => {
          if Shared.with<Type, bool>(&ty, StaticConstant.typeAllowed) {
            return memberSuccess(Value.Type {resolved: move ty}, move dependencies)
          }
          let mut annotationSpan = value.span
          let annotationSyntax = run typeNode(&mut resolver.*, &module, annotation.id)
          if let Option<HeaderSyntax>.Some {value: typeSyntax} = move annotationSyntax {
            annotationSpan = typeSyntax.span
          }
          return memberRejected(
            run reject(&resolver.*, &module, RejectionCode.InvalidConstant, annotationSpan),
            move dependencies,
          )
        }
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => memberRejected(
          move error,
          move dependencies,
        )
      }
    }
  }
  // Foreign statics and package parameters are not constants; they stay outside this family.
  return memberRejected(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
    move dependencies,
  )
}

effect fn initializerSyntax(
  resolver: &mut Resolver,
  module: &ModuleId,
  ordinal: usize,
  fallback: Span,
) -> WrittenInitializer ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.InitializerBody {value} = Module.node(hir, body) {
          if value.present {
            return WrittenInitializer {
              expression: Option.some<HirId>(value.id),
              span: Module.span(hir, value.id),
            }
          }
        }
      }
    }
  }
  return WrittenInitializer {expression: Option.none<HirId>(), span: fallback}
}

effect fn staticSpan(resolver: &mut Resolver, module: &ModuleId, id: HirId) -> Span
! Cycle | OutOfMemoryError
? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    return Module.span(IndexedSource.authored(indexed), id)
  }
  return Span.make(usize.ZERO, usize.ZERO)
}

// This loan is short: the machine resumes only after the reached constant's query facts
// have been recorded on the same active provider dependency ledger.
effect fn staticResolveNeeded<'source>(
  port: &mut StaticPort<'source>,
  module: &ModuleId,
  declaration: &Shared<DeclarationId>,
  span: Span,
) -> Result<Option<Shared<StaticData>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = Shared.with<DeclarationId, usize>(declaration, fn(identity: &DeclarationId) -> usize {
    return knownModuleOrdinal(&port.resolver.*, DeclarationId.moduleId(identity))
  })
  if moduleOrdinal == usize.MAX {
    return Result.failResult<Option<Shared<StaticData>>, Shared<Rejection>>(
      run reject(&port.resolver.*, module, RejectionCode.InvalidConstant, span),
    )
  }
  let targetModule = run resolvedModule(&port.resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut port.resolver.*, &targetModule, declaration)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<Option<Shared<StaticData>>, Shared<Rejection>>(
        run reject(&port.resolver.*, module, RejectionCode.InvalidConstant, span),
      )
    }
  }
  let declared = run demandChild(
    &mut port.resolver.*, &mut port.query.*, &mut port.dependencies.*,
    Key {
      family: Family.Constant, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    },
    span,
  )
  let referencedType = Shared.with<Result<Answer, NoRejection>, TypeSelection>(&declared, selectedType)
  if let Option<Shared<Rejection>>.Some {value} = move referencedType.rejected {
    return Result.failResult<Option<Shared<StaticData>>, Shared<Rejection>>(move value)
  }
  let referenced = run demandChild(
    &mut port.resolver.*, &mut port.query.*, &mut port.dependencies.*,
    Key {
      family: Family.Initializer, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    },
    span,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &referenced, answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<Option<Shared<StaticData>>, Shared<Rejection>>(move value)
  }
  let value = Shared.with<Result<Answer, NoRejection>, Option<Shared<StaticData>>>(
    &referenced, initializerValue,
  )
  return Result.succeed<Option<Shared<StaticData>>, Shared<Rejection>>(move value)
}

effect fn staticExpression(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  declaration: Option<usize>,
  id: HirId,
  expectation: StaticRootExpectation,
) -> Result<Shared<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let span = run staticSpan(&mut resolver.*, module, id)
  let binders = Vector.make<StaticRootBinder>()
  let checkedAnswer = Result.succeed<Answer, NoRejection>(run checkedStaticRoot(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, move declaration, id, move expectation,
    Vector.asSlice<StaticRootBinder>(&binders),
  ))
  let checked = match move StaticExecution.checkedRoot(&checkedAnswer) {
    Option<StaticExecution.CheckedRoot>.Some {value} => value
    Option<StaticExecution.CheckedRoot>.None => {
      if let Option<Shared<Rejection>>.Some {value} = move answerRejection(&checkedAnswer) {
        return Result.failResult<Shared<StaticData>, Shared<Rejection>>(move value)
      }
      return Result.failResult<Shared<StaticData>, Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.InvalidConstant, span),
      )
    }
  }
  let target = resolver.target
  let mut machine = run StaticExecution.make(
    inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*),
    module,
    StaticExecution.Limits {steps: 10000, depth: 64, valueBytes: 1048576},
  )
  let mut bindings = Vector.make<StaticBinding>()
  while StaticExecution.steps(&machine) < 10000 {
    let supplied = Vector.asSlice<StaticBinding>(&bindings)
    let outcome = run Effect.result(StaticExecution.evaluate(
      &mut machine, &checked, supplied, id,
    ))
    match move outcome {
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Success {value} => {
        return Result.succeed<Shared<StaticData>, Shared<Rejection>>(move value)
      }
      Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error: evaluationFailure} => {
        match move evaluationFailure {
          StaticDiagnostic {fault, code, span: failedSpan, target: diagnosticTarget, message, origin, byteOffset, rejection, needed, missing, trace} => {
            if let Option<Shared<Rejection>>.Some {value: rejected} = move rejection {
              return Result.failResult<Shared<StaticData>, Shared<Rejection>>(move rejected)
            }
            if let Option<StaticNeeded>.Some {value: reached} = move needed {
              if StaticExecution.steps(&machine) >= 10000 {
                let port = StaticExecution.port(&mut machine)
                return Result.failResult<Shared<StaticData>, Shared<Rejection>>(
                  run rejectStatic(
                    &port.resolver.*, module,
                    StaticDiagnostic {
                      fault: StaticFault.StepLimit, code: b"SEM0179", span: failedSpan,
                      target: diagnosticTarget, message: Option.none<Bytes>(), origin: Option.none<Span>(),
                      byteOffset: Option.none<u64>(),
                      rejection: Option.none<Shared<Rejection>>(),
                      needed: Option.none<StaticNeeded>(), missing: Option.none<StaticExecution.MissingFact>(),
                      trace: move trace,
                    },
                  ),
                )
              }
              let resolved = run staticResolveNeeded(
                StaticExecution.port(&mut machine), &reached.module, &reached.declaration, failedSpan,
              )
              match move resolved {
                Result<Option<Shared<StaticData>>, Shared<Rejection>>.Success {value} => {
                  if let Option<Shared<StaticData>>.Some {value: constant} = move value {
                    run Vector.append<StaticBinding>(
                      &mut bindings, StaticBinding {
                        module: move reached.module, binder: reached.expression, value: move constant,
                      },
                    )
                    continue
                  }
                }
                Result<Option<Shared<StaticData>>, Shared<Rejection>>.Failure {error} => {
                  return Result.failResult<Shared<StaticData>, Shared<Rejection>>(move error)
                }
              }
            }
            let port = StaticExecution.port(&mut machine)
            return Result.failResult<Shared<StaticData>, Shared<Rejection>>(
              run rejectStatic(
                &port.resolver.*, module,
                StaticDiagnostic {
                  fault: fault, code: code, span: failedSpan, target: diagnosticTarget,
                  message: move message, origin: origin, byteOffset: byteOffset,
                  rejection: Option.none<Shared<Rejection>>(),
                  needed: Option.none<StaticNeeded>(), missing: move missing, trace: move trace,
                },
              ),
            )
          }
          OutOfMemoryError {} => { fail OutOfMemoryError {} }
        }
      }
    }
  }
  let port = StaticExecution.port(&mut machine)
  return Result.failResult<Shared<StaticData>, Shared<Rejection>>(
    run rejectStatic(
      &port.resolver.*, module,
      StaticDiagnostic {
        fault: StaticFault.StepLimit, code: b"SEM0179", span: span,
        target: target, message: Option.none<Bytes>(), origin: Option.none<Span>(),
        byteOffset: Option.none<u64>(),
        rejection: Option.none<Shared<Rejection>>(),
        needed: Option.none<StaticNeeded>(), missing: Option.none<StaticExecution.MissingFact>(),
        trace: Vector.make<StaticExecution.TraceStep>(),
      },
    ),
  )
}

effect fn resolveInitializer(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let declared = run demandChild(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    Key {
      family: Family.Constant, module: key.module, name: usize.ZERO,
      declaration: key.declaration, member: usize.ZERO, external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let selected = Shared.with<Result<Answer, NoRejection>, TypeSelection>(&declared, selectedType)
  if let Option<Shared<Rejection>>.Some {value} = move selected.rejected {
    return memberRejected(move value, move dependencies)
  }
  let ty = match move selected.resolved {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidConstant, Span.make(usize.ZERO, usize.ZERO)),
        move dependencies,
      )
    }
  }
  let mut fallback = Span.make(usize.ZERO, usize.ZERO)
  let declaredHeader = run header(&mut resolver.*, &module, key.declaration)
  if let Option<HeaderSyntax>.Some {value} = move declaredHeader { fallback = value.span }
  let written = run initializerSyntax(&mut resolver.*, &module, key.declaration, fallback)
  let expression = match move written.expression {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.InvalidConstant, written.span),
        move dependencies,
      )
    }
  }
  let attempted = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies,
    &module, Option.some<usize>(key.declaration), expression,
    StaticRootExpectation.Resolved {ty: Shared.clone<Type>(&ty)},
  )
  match move attempted {
    Result<Shared<StaticData>, Shared<Rejection>>.Success {value} => {
      if StaticConstant.matchesShared(&ty, &value) {
        return memberSuccess(Value.Initializer {value: move value}, move dependencies)
      }
      return memberRejected(
        run reject(&resolver.*, &module, RejectionCode.TypeMismatch, written.span),
        move dependencies,
      )
    }
    Result<Shared<StaticData>, Shared<Rejection>>.Failure {error} => {
      return memberRejected(move error, move dependencies)
    }
  }
}

fn checkedRootType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, ..}} => Shared.with<TypedBody, Option<Shared<Type>>>(
        &body,
        fn(checked: &TypedBody) -> Option<Shared<Type>> {
          let root = TypedBody.rootNode(checked)
          let nodes = TypedBody.nodeSlice(checked)
          if root.index < nodes.length {
            if let BodyNodeKind.Expression {ty, ..} = &nodes[root.index].kind {
              return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
            }
          }
          return Option.none<Shared<Type>>()
        },
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn checkedRootMatches(
  answer: &Result<Answer, NoRejection>,
  observed: &Observation,
  declaration: &DeclarationId,
  syntax: HirId,
) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, source}} => {
        let sameSource = Shared.with<Observation, bool>(
          &source,
          fn(saved: &Observation) -> bool { return Observation.equals(saved, observed) },
        )
        if !sameSource {
          return false
        }
        return Shared.with<TypedBody, bool>(&body, fn(checked: &TypedBody) -> bool {
          let root = TypedBody.rootNode(checked)
          let nodes = TypedBody.nodeSlice(checked)
          return DeclarationId.equals(TypedBody.declarationId(checked), declaration) &&
            root.index < nodes.length && nodes[root.index].origin.syntax.index == syntax.index
        })
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn staticParameterPosition(hir: &Module, header: HirId, syntax: HirId) -> Option<usize> {
  if let Node.FunctionHeader {contract, ..} = Module.node(hir, header) {
    if let Node.CallableContract {parameters, ..} = Module.node(hir, contract) {
      let mut at = usize.ZERO
      while at < parameters.length {
        let parameter = Module.child(hir, parameters, at)
        if parameter.index == syntax.index {
          if let Node.Parameter {mode, ..} = Module.node(hir, parameter) {
            if mode == ParameterMode.Static {
              return Option.some<usize>(at)
            }
          }
          return Option.none<usize>()
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<usize>()
}

fn bareExtentTree(hir: &Module, expression: HirId) -> bool {
  return match Module.node(hir, expression) {
    Node.IntegerLiteral {suffix, ..} => !suffix.present
    Node.InfixExpression {operator, left, right, ..} => {
      if operator != InfixOperator.Add && operator != InfixOperator.Subtract &&
        operator != InfixOperator.Multiply && operator != InfixOperator.Divide &&
        operator != InfixOperator.Remainder && operator != InfixOperator.BitAnd &&
        operator != InfixOperator.BitOr && operator != InfixOperator.BitXor {
        return false
      }
      return bareExtentTree(hir, left) && bareExtentTree(hir, right)
    }
    _ => false
  }
}

effect fn staticRootAnnotationType(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  moduleOrdinal: usize,
  declarationOrdinal: usize,
  syntax: HirId,
  genericBinders: &[Binder],
) -> Result<Shared<Type>, Shared<Rejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let mut elision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, module, declarationOrdinal),
    nextOrdinal: genericBinders.length,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  return run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    syntax,
    genericBinders,
    &mut elision,
  )
}

/// Checks only the expression selected for static evaluation. Inactive arms of a mixed body
/// never enter this checker, so they retain static-if selection silence.
effect fn checkedStaticRoot(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  declaration: Option<usize>,
  root: HirId,
  expectation: StaticRootExpectation,
  binders: &[StaticRootBinder],
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut writtenCalls = Vector.make<CallSyntax>()
  let mut rootSpan = Span.make(usize.ZERO, usize.ZERO)
  let mut ordinal = usize.MAX
  let mut extentLiteralTree = false
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
    let hir = IndexedSource.authored(indexed)
    extentLiteralTree = bareExtentTree(hir, root)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if let Option<usize>.Some {value} = &declaration {
      ordinal = value
    } else {
      // Array extents can be checked while their written type is being resolved. The nearest
      // enclosing declaration owns the retained HIR IDs and source observation.
      let candidateSpan = Module.span(hir, root)
      let mut at = usize.ZERO
      let mut width = usize.MAX
      while at < declarations.length {
        let span = Module.span(hir, declarations[at].local)
        if span.start <= candidateSpan.start && candidateSpan.end <= span.end && span.end - span.start < width {
          ordinal = at
          width = span.end - span.start
        }
        at = at + usize.ONE
      }
    }
    if ordinal >= declarations.length {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
        Vector.make<Dependency>(),
      )
    }
    let declarationSpan = Module.span(hir, declarations[ordinal].local)
    rootSpan = Module.span(hir, root)
    if rootSpan.start < declarationSpan.start || rootSpan.end > declarationSpan.end {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
    run collectCall(hir, root, &mut writtenCalls)
  } else {
    return rejectedBody(
      run reject(&resolver.*, module, RejectionCode.MissingModule, Span.make(usize.ZERO, usize.ZERO)),
      Vector.make<Dependency>(),
    )
  }
  let template = run templateBinders(&mut resolver.*, module, ordinal)
  let genericBinders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, Vector.make<Dependency>())
    }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let mut expected = Option.none<Shared<Type>>()
  match move expectation {
    StaticRootExpectation.Inferred => {}
    StaticRootExpectation.Boolean => {
      expected = Option.some<Shared<Type>>(run primitiveType(b"bool"))
    }
    StaticRootExpectation.IntegerExtent => {
      if extentLiteralTree {
        expected = Option.some<Shared<Type>>(run primitiveType(b"u64"))
      }
    }
    StaticRootExpectation.Resolved {ty} => {
      expected = Option.some<Shared<Type>>(move ty)
    }
    StaticRootExpectation.Annotation {syntax} => {
      let resolved = run staticRootAnnotationType(
        &mut resolver.*, &mut owner.*, &mut dependencies.*,
        module, moduleOrdinal, ordinal, syntax, Vector.asSlice<Binder>(&genericBinders),
      )
      expected = match move resolved {
        Result<Shared<Type>, Shared<Rejection>>.Success {value} => Option.some<Shared<Type>>(move value)
        Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
          return rejectedBody(move error, Vector.make<Dependency>())
        }
      }
    }
  }
  let mut resolvedCalls = Vector.make<ResolvedCall>()
  let calls = Vector.asSlice<CallSyntax>(&writtenCalls)
  let mut callAt = usize.ZERO
  while callAt < calls.length {
    let result = run callTarget(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      module,
      moduleOrdinal,
      &calls[callAt],
      Vector.asSlice<Binder>(&genericBinders),
    )
    run Vector.append<ResolvedCall>(
      &mut resolvedCalls,
      ResolvedCall {id: calls[callAt].id, result: move result},
    )
    callAt = callAt + usize.ONE
  }
  let available = run SourceIndex.authoredCursor(&mut resolver.source, &sourceAnswer, module)
  let cursor = match move available {
    Option<AuthoredCursor>.Some {value} => value
    Option<AuthoredCursor>.None => {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
  }
  let mut locals = Vector.make<BodyLocal>()
  let observed = run SourceIndex.captureObservation(&resolver.source, module)
  let identity = run declarationAt(&mut resolver.*, module, ordinal)
  let ownerIdentity = match move identity {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
  }
  let mut binderAt = usize.ZERO
  while binderAt < binders.length {
    let mut syntax = HirId {index: usize.ZERO}
    let mut selectedType = Option.none<Shared<Type>>()
    match &binders[binderAt] {
      StaticRootBinder.Parameter {syntax: parameter} => {
        syntax = parameter
        let mut position = Option.none<usize>()
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
          let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
          position = staticParameterPosition(IndexedSource.authored(indexed), declarations[ordinal].header, syntax)
        }
        let parameterAt = match move position {
          Option<usize>.Some {value} => value
          Option<usize>.None => {
            return rejectedBody(
              run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, &cursor, syntax)),
              Vector.make<Dependency>(),
            )
          }
        }
        let signature = run demandChild(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          Key {
            family: Family.Signature,
            module: moduleOrdinal,
            name: usize.ZERO,
            declaration: ordinal,
            member: usize.ZERO,
            external: false,
          },
          rootSpan,
        )
        let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
          &signature,
          answerRejection,
        )
        if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
          return rejectedBody(move diagnostic, Vector.make<Dependency>())
        }
        selectedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
          &signature,
          fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
            return signatureParameter(answer, parameterAt)
          },
        )
      }
      StaticRootBinder.Binding {syntax: binding, checked} => {
        syntax = binding
        let mut initializer = HirId {index: usize.MAX}
        let mut annotation = HirId {index: usize.MAX}
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, module) {
          let hir = IndexedSource.authored(indexed)
          if syntax.index < Vector.length<Node>(&hir.nodes) {
            if let Node.BindingStatement {isStatic, initializer: written, annotation: declared, ..} = Module.node(hir, syntax) {
              if isStatic && Module.span(hir, syntax).end <= rootSpan.start {
                initializer = written
                if declared.present {
                  annotation = declared.id
                }
              }
            }
          }
        }
        if initializer.index == usize.MAX {
          return rejectedBody(
            run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, rootSpan),
            Vector.make<Dependency>(),
          )
        }
        let matches = Shared.with<Result<Answer, NoRejection>, bool>(
          &checked,
          fn(answer: &Result<Answer, NoRejection>) -> bool {
            return checkedRootMatches(answer, &observed, &ownerIdentity, initializer)
          },
        )
        if !matches {
          return rejectedBody(
            run reject(&resolver.*, module, RejectionCode.Unsupported, run bodySpan(&resolver.source, &cursor, syntax)),
            Vector.make<Dependency>(),
          )
        }
        selectedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
          &checked,
          checkedRootType,
        )
        if annotation.index != usize.MAX {
          let resolved = run staticRootAnnotationType(
            &mut resolver.*, &mut owner.*, &mut dependencies.*,
            module, moduleOrdinal, ordinal, annotation, Vector.asSlice<Binder>(&genericBinders),
          )
          let declaredType = match move resolved {
            Result<Shared<Type>, Shared<Rejection>>.Success {value} => value
            Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
              return rejectedBody(move error, Vector.make<Dependency>())
            }
          }
          let matching = match & selectedType {
            Option<Shared<Type>>.Some {value} => run Type.equalsShared(&value, &declaredType)
            Option<Shared<Type>>.None => false
          }
          if !matching {
            return rejectedBody(
              run reject(&resolver.*, module, RejectionCode.TypeMismatch, run bodySpan(&resolver.source, &cursor, annotation)),
              Vector.make<Dependency>(),
            )
          }
        }
      }
    }
    let ty = match move selectedType {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return rejectedBody(
          run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
          Vector.make<Dependency>(),
        )
      }
    }
    run Vector.append<BodyLocal>(&mut locals, BodyLocal {
      origin: BodyOrigin {
        syntax: syntax,
        span: run bodySpan(&resolver.source, &cursor, syntax),
      },
      ty: move ty,
      mutable: false,
    })
    binderAt = binderAt + usize.ONE
  }
  let mut nodes = Vector.make<BodyNode>()
  let mut signatureDependencies = Vector.make<SignatureDependency>()
  let mut requiredBodies = Vector.make<DeclarationId>()
  let constraints = Vector.make<Constraint>()
  let mut request = Request.make()
  let checked = run checkExpression(
    &mut resolver.*,
    &mut owner.*,
    &mut request,
    &mut dependencies.*,
    module,
    &cursor,
    Vector.asSlice<BodyLocal>(&locals),
    Vector.asSlice<ResolvedCall>(&resolvedCalls),
    &mut nodes,
    &mut signatureDependencies,
    &mut requiredBodies,
    root,
    &expected,
    Vector.asSlice<Constraint>(&constraints),
    false,
    true,
  )
  let rootNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, Vector.make<Dependency>())
    }
  }
  let checkedNodes = Vector.asSlice<BodyNode>(&nodes)
  let mut at = usize.ZERO
  while at < checkedNodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &checkedNodes[at].kind {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, checkedNodes[at].origin.span),
        Vector.make<Dependency>(),
      )
    }
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration: calledDeclaration, ..}, ..} = &checkedNodes[at].kind {
      let called = run DeclarationId.copy(&calledDeclaration)
      let targetModuleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(&called))
      if targetModuleOrdinal == usize.MAX {
        return rejectedBody(
          run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, checkedNodes[at].origin.span),
          Vector.make<Dependency>(),
        )
      }
      let targetModule = run resolvedModule(&resolver.*, targetModuleOrdinal)
      let sharedCalled = run Shared.make<DeclarationId>(move called)
      let selected = run ordinalOfIdentity(&mut resolver.*, &targetModule, &sharedCalled)
      let mut allowed = false
      if let Option<usize>.Some {value: position} = move selected {
        let written = run signatureSyntax(&mut resolver.*, &targetModule, position)
        if let Option<WrittenSignature>.Some {value} = move written {
          allowed = value.isStatic
        }
      }
      if !allowed {
        return rejectedBody(
          run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, checkedNodes[at].origin.span),
          Vector.make<Dependency>(),
        )
      }
    }
    at = at + usize.ONE
  }
  let indexed = match move sourceOf(&resolver.*, &sourceAnswer, module) {
    Option<&IndexedSource>.Some {value} => value
    Option<&IndexedSource>.None => {
      return rejectedBody(
        run reject(&resolver.*, module, RejectionCode.Unsupported, rootSpan),
        Vector.make<Dependency>(),
      )
    }
  }
  let body = run TypedBody.make(
    indexed,
    ordinal,
    move locals,
    move nodes,
    rootNode,
    move signatureDependencies,
    Vector.make<DeclarationId>(),
    BodyStage.FullyChecked,
  )
  return memberSuccess(Value.Body {
    body: run Shared.make<TypedBody>(move body),
    source: run Shared.make<Observation>(
      run Observation.copy(IndexedSource.sourceObservation(indexed)),
    ),
  }, Vector.make<Dependency>())
}

effect fn storeMir(resolver: &mut Resolver, function: MirFunction, dependencies: Vector<Dependency>) -> Answer
! OutOfMemoryError
? &mut Allocator {
  let index = Vector.length<MirFunction>(&resolver.mirValues)
  run Vector.append<MirFunction>(&mut resolver.*.mirValues, move function)
  return memberSuccess(Value.Mir {index: index}, move dependencies)
}

effect fn resolveMir(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let declared = run declarationAt(&mut resolver.*, &module, key.declaration)
  let identity = match move declared {
    Option<DeclarationId>.Some {value} => run Shared.make<DeclarationId>(move value)
    Option<DeclarationId>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        Vector.make<Dependency>(),
      )
    }
  }
  let mut dependencies = Vector.make<Dependency>()
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Signature,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    let code = Shared.with<Rejection, RejectionCode>(&value, fn(rejection: &Rejection) -> RejectionCode {
      return rejection.code
    })
    if code == RejectionCode.MissingModule || code == RejectionCode.Unsupported {
      let span = Shared.with<Rejection, Span>(&value, fn(rejection: &Rejection) -> Span {
        return rejection.span
      })
      let mut gapCode = GapCode.ModuleSource
      if code == RejectionCode.Unsupported {
        gapCode = GapCode.SignatureForm
      }
      return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
        BackendGap.make(gapCode, &identity, span),
      )}, move dependencies)
    }
    return memberRejected(move value, move dependencies)
  }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  let result = match move selected {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
        BackendGap.make(GapCode.SignatureForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
      )}, move dependencies)
    }
  }
  let written = run signatureSyntax(&mut resolver.*, &module, key.declaration)
  if let Option<WrittenSignature>.Some {value} = move written {
    if value.isStatic {
      if key.member == usize.MAX {
        return memberRejected(
          run reject(&resolver.*, &module, RejectionCode.StaticPhaseViolation, value.span),
          move dependencies,
        )
      }
      return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
        BackendGap.make(GapCode.StaticResidualization, &identity, value.span),
      )}, move dependencies)
    }
  }
  if key.member == usize.MAX {
    let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
      &signature,
      signatureParameterCount,
    )
    let binderCount = Shared.with<Result<Answer, NoRejection>, usize>(
      &signature,
      signatureBinderCount,
    )
    let returnsExitCode = Shared.with<Type, bool>(
      &result,
      fn(ty: &Type) -> bool {
        return match & ty.* {
          Type.Primitive {name} => same(Bytes.asSlice(&name), b"i32")
          _ => false
        }
      },
    )
    if parameterCount != usize.ZERO || binderCount != usize.ZERO || !returnsExitCode {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(
            BackendGap.make(GapCode.EntrySignature, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
    let entry = run MirFunction.entry(&identity, &result)
    return run storeMir(&mut resolver.*, move entry, move dependencies)
  }
  let bodyAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Body,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let bodyFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bodyAnswer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move bodyFailure {
    let missingModule = Shared.with<Rejection, bool>(&value, fn(rejection: &Rejection) -> bool {
      return rejection.code == RejectionCode.MissingModule
    })
    if missingModule {
      let span = Shared.with<Rejection, Span>(&value, fn(rejection: &Rejection) -> Span {
        return rejection.span
      })
      return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
        BackendGap.make(GapCode.ModuleSource, &identity, span),
      )}, move dependencies)
    }
    let unsupported = Shared.with<Rejection, bool>(&value, fn(rejection: &Rejection) -> bool {
      return rejection.code == RejectionCode.Unsupported
    })
    if unsupported {
      let span = Shared.with<Rejection, Span>(&value, fn(rejection: &Rejection) -> Span {
        return rejection.span
      })
      return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
        BackendGap.make(GapCode.TypedForm, &identity, span),
      )}, move dependencies)
    }
    return memberRejected(move value, move dependencies)
  }
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &bodyAnswer,
    answerTypedBody,
  )
  let typed = match move body {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => {
      return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
        BackendGap.make(GapCode.TypedForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
      )}, move dependencies)
    }
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameterAt(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move selected {
      run Vector.append<Shared<Type>>(&mut parameters, move value)
    }
    at = at + usize.ONE
  }
  let sourceAnswer = run source(&mut resolver.*, &module)
  let lowered = match move sourceOf(&resolver.*, &sourceAnswer, &module) {
    Option<&IndexedSource>.Some {value: indexed} => run Effect.result(
      MirFunction.lower(
        InstanceKey.Function {declaration: move identity},
        &typed,
        IndexedSource.authored(indexed),
        &result,
        Vector.asSlice<Shared<Type>>(&parameters),
      ),
    )
    Option<&IndexedSource>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  return match move lowered {
    Result<MirFunction, BackendGap | OutOfMemoryError>.Success {value} => run storeMir(
      &mut resolver.*,
      move value,
      move dependencies,
    )
    Result<MirFunction, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner: gapOwner, span} => memberSuccess(
        Value.Unsupported {
          gap: run Shared.make<BackendGap>(
            BackendGap {code: code, owner: move gapOwner, span: span},
          ),
        },
        move dependencies,
      )
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

effect fn resolveLayout(resolver: &mut Resolver, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let types = Vector.asSlice<Shared<Type>>(&resolver.applications)
  if key.name >= types.length {
    return memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>())
  }
  let computed = BackendLayout.scalar(&types[key.name], &resolver.target)
  return match move computed {
    Option<BackendLayout>.Some {value} => {
      let index = Vector.length<BackendLayout>(&resolver.layoutValues)
      run Vector.append<BackendLayout>(&mut resolver.*.layoutValues, move value)
      return memberSuccess(Value.Layout {index: index}, Vector.make<Dependency>())
    }
    Option<BackendLayout>.None => memberSuccess(Value.LayoutUnsupported, Vector.make<Dependency>())
  }
}

struct LayoutDemand {
  ty: Shared<Type>
  span: Span
}

effect fn copyMirLocalTypes(resolver: &Resolver, index: usize) -> Vector<LayoutDemand>
! OutOfMemoryError
? &mut Allocator {
  let functions = Vector.asSlice<MirFunction>(&resolver.mirValues)
  let locals = Vector.asSlice<MirLocal>(&functions[index].locals)
  let mut copied = Vector.make<LayoutDemand>()
  let mut at = usize.ZERO
  while at < locals.length {
    run Vector.append<LayoutDemand>(&mut copied, LayoutDemand {
      ty: Shared.clone<Type>(&locals[at].ty),
      span: locals[at].origin.span,
    })
    at = at + usize.ONE
  }
  return move copied
}

struct EmittedInstance {
  text: Bytes
  symbol: Bytes
}

effect fn emitMirInstance(resolver: &Resolver, index: usize) -> EmittedInstance
! BackendGap | OutOfMemoryError
? &mut Allocator {
  let functions = Vector.asSlice<MirFunction>(&resolver.mirValues)
  return EmittedInstance {
    text: run LlvmText.emit(&functions[index], &resolver.target),
    symbol: run InstanceKey.symbol(&functions[index].key),
  }
}

effect fn resolveInstance(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let mir = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Mir,
      module: key.module,
      name: key.name,
      declaration: key.declaration,
      member: key.member,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &mir,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return memberRejected(move value, move dependencies)
  }
  let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(
    &mir,
    answerBackendGap,
  )
  if let Option<Shared<BackendGap>>.Some {value} = move gap {
    return memberSuccess(Value.Unsupported {gap: move value}, move dependencies)
  }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, answerMirIndex)
  let mirIndex = match move selected {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let types = run copyMirLocalTypes(&resolver.*, mirIndex)
  let needed = Vector.asSlice<LayoutDemand>(&types)
  let mut at = usize.ZERO
  while at < needed.length {
    let application = run internApplication(&mut resolver.*, &needed[at].ty)
    let layout = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      Key {
        family: Family.Layout,
        module: key.module,
        name: application,
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      },
      needed[at].span,
    )
    let layoutUnsupported = Shared.with<Result<Answer, NoRejection>, bool>(
      &layout,
      answerLayoutUnsupported,
    )
    if layoutUnsupported {
      let functions = Vector.asSlice<MirFunction>(&resolver.mirValues)
      let identity = InstanceKey.identity(&functions[mirIndex].key)
      return memberSuccess(Value.Unsupported {gap: run Shared.make<BackendGap>(
        BackendGap.make(GapCode.ScalarLayout, &identity, needed[at].span),
      )}, move dependencies)
    }
    let layoutFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &layout,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move layoutFailure {
      return memberRejected(move value, move dependencies)
    }
    at = at + usize.ONE
  }
  let emitted = run Effect.result(emitMirInstance(&resolver.*, mirIndex))
  return match move emitted {
    Result<EmittedInstance, BackendGap | OutOfMemoryError>.Success {value} => {
      let index = Vector.length<Bytes>(&resolver.instanceTexts)
      run Vector.append<Bytes>(&mut resolver.*.instanceTexts, move value.text)
      run Vector.append<Bytes>(&mut resolver.*.instanceSymbols, move value.symbol)
      return memberSuccess(Value.Instance {index: index}, move dependencies)
    }
    Result<EmittedInstance, BackendGap | OutOfMemoryError>.Failure {error} => match move error {
      BackendGap {code, owner: gapOwner, span} => memberSuccess(
        Value.Unsupported {gap: run Shared.make<BackendGap>(BackendGap {code: code, owner: move gapOwner, span: span})},
        move dependencies,
      )
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

effect fn resolveBody(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
  candidate: Option<BodyCandidate>,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  if let Option<BodyCandidate>.Some {value} = move candidate {
    let reused = run reuseBody(&mut resolver.*, &mut owner.*, key, move value)
    if let Option<Answer>.Some {value: answer} = move reused {
      let word = run internKey(&mut resolver.*, key)
      run emit(&mut resolver.*, EventKind.Reuse, word)
      return move answer
    }
    let count = Vector.length<SourceFrame>(&resolver.frames)
    let stale = Vector.remove<SourceFrame>(&mut resolver.frames, count - usize.ONE)
    drop stale
    run Vector.append<SourceFrame>(
      &mut resolver.frames,
      SourceFrame {
        observations: Vector.make<Shared<Observation>>(),
        footprint: Vector.make<Shared<DemandFootprint>>(),
        direct: Vector.make<BodyDependency>(),
      },
    )
  }
  let module = run resolvedModule(&resolver.*, key.module)
  let signatureKey = Key {
    family: Family.Signature,
    module: key.module,
    name: usize.ZERO,
    declaration: key.declaration,
    member: usize.ZERO,
    external: false,
  }
  let mut dependencies = Vector.make<Dependency>()
  let signatureAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    signatureKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let signatureFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signatureAnswer,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move signatureFailure {
    return rejectedBody(move value, move dependencies)
  }
  let selectedResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signatureAnswer,
    signatureResult,
  )
  let resultType = match move selectedResult {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      return rejectedBody(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let parameterCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureParameterCount,
  )
  let binderCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureBinderCount,
  )
  let mut contractBody = binderCount > usize.ZERO || !Shared.with<Type, bool>(
    &resultType,
    scalarType,
  )
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(
    &signatureAnswer,
    signatureConstraintCount,
  )
  let mut constraints = Vector.make<Constraint>()
  let mut boundAt = usize.ZERO
  while boundAt < boundCount {
    let bound = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      &signatureAnswer,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return signatureConstraint(answer, boundAt)
      },
    )
    if let Option<Constraint>.Some {value} = move bound {
      run Vector.append<Constraint>(&mut constraints, move value)
    }
    boundAt = boundAt + usize.ONE
  }
  let restricted = Shared.with<Result<Answer, NoRejection>, bool>(
    &signatureAnswer,
    signatureOutsideScalarBodies,
  )
  let sourceAnswer = run source(&mut resolver.*, &module)
  let mut annotationIds = Vector.make<HirId>()
  let mut writtenCalls = Vector.make<CallSyntax>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if key.declaration < declarations.length {
      let hir = IndexedSource.authored(indexed)
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[key.declaration].local) {
        if let Node.CallableBody {block} = Module.node(hir, body) {
          if block.present {
            if let Node.Block {statements} = Module.node(hir, block.id) {
              run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
            }
          }
        }
      }
    }
  }
  let mut annotations = Vector.make<ResolvedAnnotation>()
  let template = run templateBinders(&mut resolver.*, &module, key.declaration)
  let binders = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, move dependencies)
    }
  }
  let mut noElision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, &module, key.declaration),
    nextOrdinal: Vector.length<Binder>(&binders),
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let writtenAnnotations = Vector.asSlice<HirId>(&annotationIds)
  let mut annotationAt = usize.ZERO
  while annotationAt < writtenAnnotations.length {
    let id = writtenAnnotations[annotationAt]
    let result = run resolveType(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      key.module,
      id,
      Vector.asSlice<Binder>(&binders),
      &mut noElision,
    )
    run Vector.append<ResolvedAnnotation>(
      &mut annotations,
      ResolvedAnnotation {id: id, result: move result},
    )
    annotationAt = annotationAt + usize.ONE
  }
  let mut resolvedCalls = Vector.make<ResolvedCall>()
  let callSyntax = Vector.asSlice<CallSyntax>(&writtenCalls)
  let mut callAt = usize.ZERO
  while callAt < callSyntax.length {
    let result = run callTarget(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies,
      &module,
      key.module,
      &callSyntax[callAt],
      Vector.asSlice<Binder>(&binders),
    )
    run Vector.append<ResolvedCall>(
      &mut resolvedCalls,
      ResolvedCall {id: callSyntax[callAt].id, result: move result},
    )
    callAt = callAt + usize.ONE
  }
  let prepared = match move sourceOf(&resolver.*, &sourceAnswer, &module) {
    Option<&IndexedSource>.Some {value: indexed} => run prepareBody(
      &resolver.*,
      &module,
      indexed,
      key.declaration,
      &signatureAnswer,
      parameterCount,
      restricted,
      contractBody,
    )
    Option<&IndexedSource>.None => Result.failResult<PreparedBody, Shared<Rejection>>(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    )
  }
  let preparedBody = match move prepared {
    Result<PreparedBody, Shared<Rejection>>.Success {value} => value
    Result<PreparedBody, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, move dependencies)
    }
  }
  let PreparedBody {block, identity, locals: preparedLocals, contractBody: abstractBody, staticBody} = move preparedBody
  let mut locals = move preparedLocals
  let mut nodes = Vector.make<BodyNode>()
  let mut signatureDependencies = Vector.make<SignatureDependency>()
  run Vector.append<SignatureDependency>(
    &mut signatureDependencies,
    SignatureDependency {declaration: move identity},
  )
  let mut requiredBodies = Vector.make<DeclarationId>()
  let available = run SourceIndex.authoredCursor(&mut resolver.source, &sourceAnswer, &module)
  let cursor = match move available {
    Option<AuthoredCursor>.Some {value} => value
    Option<AuthoredCursor>.None => {
      return rejectedBody(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Unsupported,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let mut operationRequest = Request.make()
  let checked = run checkBlock(
    &mut resolver.*,
    &mut owner.*,
    &mut operationRequest,
    &mut dependencies,
    &module,
    &cursor,
    &mut locals,
    Vector.asSlice<ResolvedAnnotation>(&annotations),
    Vector.asSlice<ResolvedCall>(&resolvedCalls),
    &mut nodes,
    &mut signatureDependencies,
    &mut requiredBodies,
    block,
    &resultType,
    Vector.asSlice<Constraint>(&constraints),
    abstractBody,
    staticBody,
    usize.ZERO,
  )
  let control = match move checked {
    Result<CheckedControl, Shared<Rejection>>.Success {value} => value
    Result<CheckedControl, Shared<Rejection>>.Failure {error} => {
      return rejectedBody(move error, move dependencies)
    }
  }
  if staticBody {
    let checkedNodes = Vector.asSlice<BodyNode>(&nodes)
    let mut at = usize.ZERO
    while at < checkedNodes.length {
      if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &checkedNodes[at].kind {
        return rejectedBody(
          run reject(
            &resolver.*,
            &module,
            RejectionCode.StaticPhaseViolation,
            checkedNodes[at].origin.span,
          ),
          move dependencies,
        )
      }
      if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, ..}, ..} = &checkedNodes[at].kind {
        let called = run DeclarationId.copy(&declaration)
        let calledModule = DeclarationId.moduleId(&called)
        let targetModuleOrdinal = knownModuleOrdinal(&resolver.*, calledModule)
        if targetModuleOrdinal == usize.MAX {
          return rejectedBody(
            run reject(
              &resolver.*,
              &module,
              RejectionCode.StaticPhaseViolation,
              checkedNodes[at].origin.span,
            ),
            move dependencies,
          )
        }
        let targetModule = run resolvedModule(&resolver.*, targetModuleOrdinal)
        let sharedCalled = run Shared.make<DeclarationId>(move called)
        let ordinal = run ordinalOfIdentity(&mut resolver.*, &targetModule, &sharedCalled)
        let mut allowed = false
        if let Option<usize>.Some {value: position} = move ordinal {
          let written = run signatureSyntax(&mut resolver.*, &targetModule, position)
          if let Option<WrittenSignature>.Some {value} = move written {
            allowed = value.isStatic
          }
        }
        if !allowed {
          return rejectedBody(
            run reject(
              &resolver.*,
              &module,
              RejectionCode.StaticPhaseViolation,
              checkedNodes[at].origin.span,
            ),
            move dependencies,
          )
        }
      }
      at = at + usize.ONE
    }
    requiredBodies = Vector.make<DeclarationId>()
  }
  if control.canComplete && Shared.with<Type, usize>(&resultType, scalarCode) != 1 {
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &resolver.*,
      &sourceAnswer,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let mut returnSpan = Module.span(hir, block)
      if Module.causeRange(hir, block).length == usize.ZERO && returnSpan.end > returnSpan.start {
        returnSpan = Span.make(returnSpan.end - usize.ONE, returnSpan.end)
      }
      return rejectedBody(
        run reject(&resolver.*, &module, RejectionCode.MissingReturn, returnSpan),
        move dependencies,
      )
    }
    return rejectedBody(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
      move dependencies,
    )
  }
  let mut stage = BodyStage.FullyChecked
  if abstractBody || bodyHasReceiverPass(Vector.asSlice<BodyNode>(&nodes)) {
    stage = BodyStage.ContractTyped {
      obligations: run bodySafetyObligations(
        Vector.asSlice<BodyLocal>(&locals),
        Vector.asSlice<BodyNode>(&nodes),
      ),
    }
  }
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    &module,
  ) {
    let body = run TypedBody.make(
      indexed,
      key.declaration,
      move locals,
      move nodes,
      control.node,
      move signatureDependencies,
      move requiredBodies,
      move stage,
    )
    return Answer {
      outcome: Outcome.Success {
        value: Value.Body {
          body: run Shared.make<TypedBody>(move body),
          source: run Shared.make<Observation>(
            run Observation.copy(IndexedSource.sourceObservation(indexed)),
          ),
        },
      },
      dependencies: move dependencies,
      sources: Vector.make<Shared<Observation>>(),
      footprint: Vector.make<Shared<DemandFootprint>>(),
      answerId: usize.ZERO,
      identity: Option.none<Shared<Value>>(),
      bodyEvidence: Option.none<Shared<BodyEvidence>>(),
    }
  }
  return rejectedBody(
    run reject(&resolver.*, &module, RejectionCode.Unsupported, Span.make(usize.ZERO, usize.ZERO)),
    move dependencies,
  )
}

fn hasRejection(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic: _} => true
      Outcome.Success {value: _} => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn rejectRoot(
  resolver: &mut Resolver,
  module: &ModuleId,
  bucket: Key,
  code: RejectionCode,
  span: Span,
) -> Shared<Result<Answer, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut dependencies = Vector.make<Dependency>()
  run Vector.append<Dependency>(&mut dependencies, run dependency(&mut resolver.*, bucket))
  let mut sources = Vector.make<Shared<Observation>>()
  run Vector.append<Shared<Observation>>(
    &mut sources,
    run Shared.make<Observation>(run SourceIndex.captureObservation(&resolver.source, module)),
  )
  let diagnostic = run reject(&resolver.*, module, code, span)
  return run Shared.make<Result<Answer, NoRejection>>(
    Result.succeed<Answer, NoRejection>(
      Answer {
        outcome: Outcome.Rejected {diagnostic: move diagnostic},
        dependencies: move dependencies,
        sources: move sources,
        footprint: Vector.make<Shared<DemandFootprint>>(),
        answerId: usize.ZERO,
        identity: Option.none<Shared<Value>>(),
        bodyEvidence: Option.none<Shared<BodyEvidence>>(),
      },
    ),
  )
}

effect fn demandNamed(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  module: &ModuleId,
  name: &[u8],
  family: Family,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let nameOrdinal = run internName(&mut resolver.*, name)
  let bucketKey = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let observed = run demandRaw(
    &mut resolver.*,
    &mut owner.*,
    bucketKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  if Shared.with<Result<Answer, NoRejection>, bool>(&observed, hasRejection) {
    return move observed
  }
  drop observed
  let selected = run select(&mut resolver.*, module, name, false)
  if selected.count != usize.ONE {
    let mut code = RejectionCode.Collision
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownName
    }
    return run rejectRoot(&mut resolver.*, module, bucketKey, code, selected.span)
  }
  if selected.kind != CandidateKind.Declaration {
    return run rejectRoot(
      &mut resolver.*,
      module,
      bucketKey,
      RejectionCode.Unsupported,
      selected.span,
    )
  }
  let mut backendName = usize.ZERO
  if family == Family.Mir {
    let declared = run declarationAt(&mut resolver.*, module, selected.declaration)
    let identity = match move declared {
      Option<DeclarationId>.Some {value} => run Shared.make<DeclarationId>(move value)
      Option<DeclarationId>.None => {
        return run rejectRoot(&mut resolver.*, module, bucketKey, RejectionCode.UnknownName, selected.span)
      }
    }
    backendName = run internBackendInstance(
      &mut resolver.*,
      &InstanceKey.Function {declaration: move identity},
    )
  }
  let key = Key {
    family: family,
    module: moduleOrdinal,
    name: backendName,
    declaration: selected.declaration,
    member: usize.ZERO,
    external: false,
  }
  return run demandRaw(&mut resolver.*, &mut owner.*, key, selected.span)
}

fn copyGoal(goal: &ConformanceGoal) -> ConformanceGoal {
  return ConformanceGoal {
    contract: Shared.clone<Type>(&goal.contract),
    provider: Shared.clone<Type>(&goal.provider),
  }
}

effect fn declaredGoal(constraints: &[Constraint], goal: &ConformanceGoal) -> Option<Constraint>
! OutOfMemoryError
? &mut Allocator {
  // A concrete application must establish real evidence even if its caller supplied a copied
  // constraint. Declared bounds are assumptions only for goals that still contain open binders.
  if !Type.hasOpenParameters(&goal.provider) && !Type.hasOpenParameters(&goal.contract) {
    return Option.none<Constraint>()
  }
  let mut at = usize.ZERO
  while at < constraints.length {
    if let Constraint.Conforms {provider, contract} = &constraints[at] {
      // Exact identity, including lifetimes and all interface arguments, is declared evidence.
      let sameProvider = run Type.equalsShared(&provider, &goal.provider)
      let sameContract = run Type.equalsShared(&contract, &goal.contract)
      if sameProvider && sameContract {
        return Option.some<Constraint>(
          Constraint.Conforms {
            provider: Shared.clone<Type>(&provider),
            contract: Shared.clone<Type>(&contract),
          },
        )
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Constraint>()
}

fn matchedArgument(bindings: &[Binding], owner: &Shared<DeclarationId>, ordinal: usize) -> Option<
  Argument,
> {
  let mut at = usize.ZERO
  while at < bindings.length {
    if bindings[at].ordinal == ordinal && sameDeclarationShared(&bindings[at].declaration, owner) {
      return Option.some<Argument>(copyArgument(&bindings[at].value))
    }
    at = at + usize.ONE
  }
  return Option.none<Argument>()
}

// Re-resolve the written bounds under the exact head bindings. This uses the same canonical type
// resolver as declaration checking, including nested type, lifetime, and requirement-row arguments.
// No second type matcher or partial type substitution is introduced for proof.
effect fn appliedConstraints(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  head: &Shared<ImplementationHead>,
  bindings: &[Binding],
) -> Result<Vector<Constraint>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
    head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared.clone<DeclarationId>(&value.declaration)
    },
  )
  let moduleOrdinal = Shared.with<DeclarationId, usize>(
    &identity,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownMember,
          Span.make(usize.ZERO, usize.ZERO),
        ),
      )
    }
  }
  let written = run header(&mut resolver.*, &module, ordinal)
  let mut generics = Range.empty()
  let mut subject = HirId {index: usize.ZERO}
  let mut target = HirRef.absent()
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<HeaderSyntax>.Some {value} = move written {
    span = value.span
    if let Node.ImplHeader {generics: parameters, subject: named, target: provided} = value.header {
      generics = parameters
      subject = named
      target = provided
    }
  }
  if !target.present {
    return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
    )
  }
  let template = run templateBinders(&mut resolver.*, &module, ordinal)
  let formal = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move error)
    }
  }
  let mut arguments = Vector.make<Argument>()
  let writtenCount = Vector.length<Binder>(&formal)
  let mut at = usize.ZERO
  while at < writtenCount {
    let found = matchedArgument(bindings, &identity, at)
    let argument = match move found {
      Option<Argument>.Some {value} => move value
      Option<Argument>.None => {
        return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
          run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
        )
      }
    }
    run Vector.append<Argument>(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let applied = run bindArguments(
    Vector.asSlice<Binder>(&formal),
    Vector.asSlice<Argument>(&arguments),
  )
  let declared = run declarationAt(&mut resolver.*, &module, ordinal)
  let implementation = match move declared {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => {
      return Result.failResult<Vector<Constraint>, Shared<Rejection>>(
        run reject(&resolver.*, &module, RejectionCode.UnknownMember, span),
      )
    }
  }
  let mut elision = LifetimeElision {
    owner: Option.some<DeclarationId>(move implementation),
    nextOrdinal: writtenCount,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  let contract = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    subject,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
  )
  if let Result<Shared<Type>, Shared<Rejection>>.Failure {error} = move contract {
    return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move error)
  }
  let provider = run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    target.id,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
  )
  if let Result<Shared<Type>, Shared<Rejection>>.Failure {error} = move provider {
    return Result.failResult<Vector<Constraint>, Shared<Rejection>>(move error)
  }
  return run resolveConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    &module,
    generics,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
    false,
  )
}

// Bound application is a query so named types and aliases in the written header are resolved
// under an active dependency owner. The key includes both normalized goal applications.
effect fn resolveProofBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let module = run resolvedModule(&resolver.*, key.module)
  let mut dependencies = Vector.make<Dependency>()
  let headAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.ImplementationHead,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    &headAnswer,
    headOf,
  )
  let head = match move found {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &headAnswer,
        answerRejection,
      )
      let diagnostic = match move rejected {
        Option<Shared<Rejection>>.Some {value} => move value
        Option<Shared<Rejection>>.None => run reject(
          &resolver.*,
          &module,
          RejectionCode.UnknownMember,
          Span.make(usize.ZERO, usize.ZERO),
        )
      }
      return memberRejected(move diagnostic, move dependencies)
    }
  }
  let applications = Vector.asSlice<Shared<Type>>(&resolver.applications)
  let goal = ConformanceGoal {
    contract: Shared.clone<Type>(&applications[key.name]),
    provider: Shared.clone<Type>(&applications[key.member]),
  }
  let mut bindings = Vector.make<Binding>()
  let matched = run matchConformanceHead(&head, &goal, &mut bindings)
  if !exactHeadMatched(&matched) {
    let span = Shared.with<ImplementationHead, Span>(
      &head,
      fn(value: &ImplementationHead) -> Span {
        return value.span
      },
    )
    return memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Unsupported, span),
      move dependencies,
    )
  }
  let applied = run appliedConstraints(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    &head,
    Vector.asSlice<Binding>(&bindings),
  )
  return match move applied {
    Result<Vector<Constraint>, Shared<Rejection>>.Success {value} => memberSuccess(
      Value.ProofBounds {constraints: move value},
      move dependencies,
    )
    Result<Vector<Constraint>, Shared<Rejection>>.Failure {error} => memberRejected(
      move error,
      move dependencies,
    )
  }
}

fn proofBoundCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ProofBounds {constraints}} = &value.outcome {
      return Vector.length<Constraint>(&constraints)
    }
  }
  return usize.MAX
}

fn proofBoundAt(answer: &Result<Answer, NoRejection>, at: usize) -> Option<Constraint> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.ProofBounds {constraints}} = &value.outcome {
      let written = Vector.asSlice<Constraint>(&constraints)
      if at < written.length {
        return Option.some<Constraint>(copyConstraint(&written[at]))
      }
    }
  }
  return Option.none<Constraint>()
}

effect fn matchConformanceHead(
  head: &Shared<ImplementationHead>,
  goal: &ConformanceGoal,
  bindings: &mut Vector<Binding>,
) -> Unification ! OutOfMemoryError ? &mut Allocator {
  let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Unification.Distinct
    }
  }
  let mut left = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(&found.contract))
  run Vector.append<Shared<Type>>(&mut left, Shared.clone<Type>(&found.provider))
  let mut right = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&goal.contract))
  run Vector.append<Shared<Type>>(&mut right, Shared.clone<Type>(&goal.provider))
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, move found.declaration)
  return run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&left),
    Vector.asSlice<Shared<Type>>(&right),
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut bindings.*,
  )
}

fn exactHeadMatched(answer: &Unification) -> bool {
  return match & answer.* {
    Unification.Unified => true
    _ => false
  }
}

fn exactHeadUndetermined(answer: &Unification) -> bool {
  return match & answer.* {
    Unification.Undetermined {..} => true
    _ => false
  }
}

effect fn proofFailure(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span) -> Shared<
  Rejection,
> ! OutOfMemoryError ? &mut Allocator {
  return run reject(resolver, &module, code, span)
}

// Root proofs record the demanded fact on their request. A proof made while validating a
// witness instead records each fact as a child of that witness, so edits invalidate the answer.
effect fn proofDemand(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  key: Key,
  span: Span,
  nested: bool,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  if nested {
    return run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  }
  let family = key.family
  let moduleOrdinal = key.module
  let answer = run demandRaw(&mut resolver.*, &mut owner.*, key, span)
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  run recordRoot(&mut request.*, family, &module, b"", &answer)
  return move answer
}

effect fn proveGoal(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  avoid: &Option<Shared<DeclarationId>>,
  goal: &ConformanceGoal,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
  chain: &mut Vector<ConformanceGoal>,
  steps: &mut Vector<ConformanceStep>,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mark = Vector.length<ConformanceGoal>(&chain.*)
  run Vector.append<ConformanceGoal>(&mut chain.*, copyGoal(goal))
  let assumed = run declaredGoal(declared, goal)
  if let Option<Constraint>.Some {value: bound} = move assumed {
    run Vector.append<ConformanceStep>(
      &mut steps.*,
      ConformanceStep {
        goal: copyGoal(goal),
        evidence: ConformanceEvidence.Declared {bound: move bound},
      },
    )
    Vector.truncate<ConformanceGoal>(&mut chain.*, mark)
    return Option.none<Shared<Rejection>>()
  }
  let contractModuleOrdinal = declaringModuleOrdinal(&resolver.*, &goal.contract)
  if contractModuleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let contractModule = run resolvedModule(&resolver.*, contractModuleOrdinal)
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &contractModule, &goal.contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      fail InvalidModulePath {}
    }
  }
  let providerApplication = run internApplication(&mut resolver.*, &goal.provider)
  let bucket = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.ConformanceHeads,
      module: contractModuleOrdinal,
      name: providerApplication,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bucket,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Option.some<Shared<Rejection>>(move value)
  }
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
  let mut heads = Vector.make<Shared<ImplementationHead>>()
  let mut at = usize.ZERO
  while at < count {
    let candidate = Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
      &bucket,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
        return bucketAt(answer, at)
      },
    )
    if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
      let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
        &head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&value.declaration)
        },
      )
      let moduleOrdinal = Shared.with<DeclarationId, usize>(
        &identity,
        fn(value: &DeclarationId) -> usize {
          return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
        },
      )
      if moduleOrdinal == usize.MAX {
        fail InvalidModulePath {}
      }
      let module = run resolvedModule(&resolver.*, moduleOrdinal)
      let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
      let position = match move ordinal {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return Option.some<Shared<Rejection>>(
            run proofFailure(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
          )
        }
      }
      let implementation = run declarationAt(&mut resolver.*, &module, position)
      if let Option<DeclarationId>.None = move implementation {
        return Option.some<Shared<Rejection>>(
          run proofFailure(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
        )
      }
      // The entire owner bucket must be coherent before a candidate may become applicable.
      let coherence = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: Family.Coherence,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: position,
          member: usize.ZERO,
          external: false,
        },
        siteSpan,
        nested,
      )
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &coherence,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return Option.some<Shared<Rejection>>(move value)
      }
      run Vector.append<Shared<ImplementationHead>>(&mut heads, move head)
    }
    at = at + usize.ONE
  }
  let mut selected = Option.none<Shared<ImplementationHead>>()
  let mut selectedBindings = Vector.make<Binding>()
  let mut undecided = false
  let coherent = Vector.asSlice<Shared<ImplementationHead>>(&heads)
  at = usize.ZERO
  while at < coherent.length {
    let mut bindings = Vector.make<Binding>()
    let answer = run matchConformanceHead(&coherent[at], goal, &mut bindings)
    if exactHeadMatched(&answer) {
      if let Option<Shared<ImplementationHead>>.Some {value: _} = &selected {
        return Option.some<Shared<Rejection>>(
          run proofFailure(&resolver.*, siteModule, RejectionCode.OverlappingConformance, siteSpan),
        )
      }
      selected = Option.some<Shared<ImplementationHead>>(
        Shared.clone<ImplementationHead>(&coherent[at]),
      )
      selectedBindings = move bindings
    }
    if exactHeadUndetermined(&answer) {
      undecided = true
    }
    at = at + usize.ONE
  }
  let head = match move selected {
    Option<Shared<ImplementationHead>>.Some {value} => move value
    Option<Shared<ImplementationHead>>.None => {
      let mut code = RejectionCode.MissingConformance
      if undecided {
        code = RejectionCode.Unsupported
      }
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, code, siteSpan),
      )
    }
  }
  if undecided {
    return Option.some<Shared<Rejection>>(
      run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
    &head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared.clone<DeclarationId>(&value.declaration)
    },
  )
  let moduleOrdinal = Shared.with<DeclarationId, usize>(
    &identity,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let contractApplication = run internApplication(&mut resolver.*, &goal.contract)
  let boundProviderApplication = run internApplication(&mut resolver.*, &goal.provider)
  let bounds = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.ProofBounds,
      module: moduleOrdinal,
      name: contractApplication,
      declaration: ordinal,
      member: boundProviderApplication,
      external: false,
    },
    siteSpan,
    nested,
  )
  let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &bounds,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move rejected {
    return Option.some<Shared<Rejection>>(move value)
  }
  let boundCount = Shared.with<Result<Answer, NoRejection>, usize>(&bounds, proofBoundCount)
  if boundCount == usize.MAX {
    return Option.some<Shared<Rejection>>(
      run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  let mut required = Vector.make<Constraint>()
  let mut bound = usize.ZERO
  while bound < boundCount {
    let found = Shared.with<Result<Answer, NoRejection>, Option<Constraint>>(
      &bounds,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Constraint> {
        return proofBoundAt(answer, bound)
      },
    )
    if let Option<Constraint>.Some {value} = move found {
      run Vector.append<Constraint>(&mut required, move value)
    }
    bound = bound + usize.ONE
  }
  let all = Vector.asSlice<Constraint>(&required)
  at = usize.ZERO
  while at < all.length {
    if let Constraint.Conforms {provider, contract} = &all[at] {
      let requirement = ConformanceGoal {
        contract: Shared.clone<Type>(&contract),
        provider: Shared.clone<Type>(&provider),
      }
      let failed = run proveGoal(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        nested,
        avoid,
        &requirement,
        declared,
        siteModule,
        siteSpan,
        &mut chain.*,
        &mut steps.*,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failed {
        return Option.some<Shared<Rejection>>(move value)
      }
    } else {
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
    at = at + usize.ONE
  }
  // A coherent head and satisfied bounds still do not prove that its operations implement the
  // contract. Demand the deterministic static witnesses before admitting concrete evidence.
  if let Option<Shared<DeclarationId>>.Some {value: forbidden} = &avoid.* {
    if sameDeclarationShared(&identity, &forbidden) {
      return Option.some<Shared<Rejection>>(
        run proofFailure(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let witnesses = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Witnesses,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ordinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &witnesses,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Option.some<Shared<Rejection>>(move value)
  }
  run Vector.append<ConformanceStep>(
    &mut steps.*,
    ConformanceStep {
      goal: copyGoal(goal),
      evidence: ConformanceEvidence.Concrete {head: move head, bindings: move selectedBindings},
    },
  )
  Vector.truncate<ConformanceGoal>(&mut chain.*, mark)
  return Option.none<Shared<Rejection>>()
}

struct ReferenceReceiver {
  referent: Shared<Type>
  mode: BodyReceiverPass
}

fn referenceReceiver(typeValue: &Shared<Type>) -> Option<ReferenceReceiver> {
  return Shared.with<Type, Option<ReferenceReceiver>>(
    typeValue,
    fn(value: &Type) -> Option<ReferenceReceiver> {
      return match & value.* {
        Type.Reference {referent, access, ..} => Option.some<ReferenceReceiver>(
          ReferenceReceiver {
            referent: Shared.clone<Type>(&referent),
            mode: match access {
              Access.Shared => BodyReceiverPass.Shared
              Access.Mutable => BodyReceiverPass.Mutable
            },
          },
        )
        _ => Option.none<ReferenceReceiver>()
      }
    },
  )
}

effect fn sameReferenceReceiver(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let actual = referenceReceiver(left)
  let expected = referenceReceiver(right)
  if let Option<ReferenceReceiver>.Some {value: actualBorrow} = move actual {
    if let Option<ReferenceReceiver>.Some {value: expectedBorrow} = move expected {
      return actualBorrow.mode == expectedBorrow.mode && run Type.equalsShared(
        &actualBorrow.referent,
        &expectedBorrow.referent,
      )
    }
  }
  return false
}

// A receiver operand is the first parameter taking `Self` by value or by either borrow mode.
// Call arguments and the expected result do not participate in this eligibility check.
effect fn receiverPosition(signature: &Shared<Result<Answer, NoRejection>>, provider: &Shared<Type>) -> Option<
  ReceiverPosition,
> ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(signature, signatureParameterCount)
  if count == usize.ZERO {
    return Option.none<ReceiverPosition>()
  }
  let at = usize.ZERO
  let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    signature,
    fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return signatureParameter(answer, at)
    },
  )
  if let Option<Shared<Type>>.Some {value} = move parameter {
    if run Type.equalsShared(&value, provider) {
      return Option.some<ReceiverPosition>(
        ReceiverPosition {ordinal: at, mode: BodyReceiverPass.Take},
      )
    }
    let reference = Shared.with<Type, Option<ReferenceReceiver>>(
      &value,
      fn(parameterType: &Type) -> Option<ReferenceReceiver> {
        return match & parameterType.* {
          Type.Reference {referent, access, ..} => Option.some<ReferenceReceiver>(
            ReferenceReceiver {
              referent: Shared.clone<Type>(&referent),
              mode: match access {
                Access.Shared => BodyReceiverPass.Shared
                Access.Mutable => BodyReceiverPass.Mutable
              },
            },
          )
          _ => Option.none<ReferenceReceiver>()
        }
      },
    )
    if let Option<ReferenceReceiver>.Some {value: borrowed} = move reference {
      if run Type.equalsShared(&borrowed.referent, provider) {
        return Option.some<ReceiverPosition>(ReceiverPosition {ordinal: at, mode: borrowed.mode})
      }
    }
  }
  return Option.none<ReceiverPosition>()
}

// An owner's own names answer before any conformance lookup. A rejected or private inherent
// member, field, or receiver-less associated function is never rescued by an interface operation.
effect fn selectInherentReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  requireReceiver: bool,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<InherentCallChoice, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, provider)
  if moduleOrdinal == usize.MAX {
    return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Missing)
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let found = run ordinalOfProvider(&mut resolver.*, &module, provider)
  let ownerOrdinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Missing)
    }
  }
  let own = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.InherentMembers,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ownerOrdinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &own,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    return Result.failResult<InherentCallChoice, Shared<Rejection>>(move value)
  }
  let lookup = Shared.with<Result<Answer, NoRejection>, InherentLookup>(
    &own,
    fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
      return inherentLookup(answer, member)
    },
  )
  if let Option<Shared<Rejection>>.Some {value} = move lookup.rejected {
    return Result.failResult<InherentCallChoice, Shared<Rejection>>(move value)
  }
  if let Option<Shared<DeclarationId>>.Some {value: declaration} = move lookup.published {
    let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &declaration)
    if let Option<usize>.Some {value: position} = move ordinal {
      let written = run header(&mut resolver.*, &module, position)
      let mut published = true
      if let Option<HeaderSyntax>.Some {value} = move written {
        if let Node.FunctionHeader {isPublic, ..} = value.header {
          published = isPublic
          if !isPublic && !ModuleId.equals(siteModule, &module) {
            return Result.failResult<InherentCallChoice, Shared<Rejection>>(
              run reject(&resolver.*, siteModule, RejectionCode.PrivateMember, siteSpan),
            )
          }
        }
      }
      let providerKey = run internApplication(&mut resolver.*, provider)
      let signature = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: Family.AppliedInherent,
          module: moduleOrdinal,
          name: providerKey,
          declaration: position,
          member: usize.ZERO,
          external: false,
        },
        siteSpan,
        nested,
      )
      let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &signature,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        return Result.failResult<InherentCallChoice, Shared<Rejection>>(move value)
      }
      let receiver = run receiverPosition(&signature, provider)
      let mut validReceiver = !requireReceiver
      if let Option<ReceiverPosition>.Some {value} = &receiver {
        validReceiver = validReceiver || value.ordinal == usize.ZERO
      }
      if validReceiver {
        let identity = run declarationAt(&mut resolver.*, &module, position)
        if let Option<DeclarationId>.Some {value: selected} = move identity {
          return Result.succeed<InherentCallChoice, Shared<Rejection>>(
            InherentCallChoice.Selected {
              target: CallTarget {
                declaration: move selected,
                isPublic: published,
                signature: move signature,
                explicit: Vector.make<Argument>(),
              },
              receiver: move receiver,
            },
          )
        }
      }
      return Result.failResult<InherentCallChoice, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.AssociatedFunctionOnValue, siteSpan),
      )
    }
  }
  let claims = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Members,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ownerOrdinal,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  if Shared.with<Result<Answer, NoRejection>, bool>(
    &claims,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return ownerClaims(answer, member)
    },
  ) {
    return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Claimed)
  }
  return Result.succeed<InherentCallChoice, Shared<Rejection>>(InherentCallChoice.Missing)
}

// For an abstract provider, only its written interface bounds can supply receiver methods.
// Choose the supplier by name and receiver contract before considering call arguments.
effect fn selectBoundReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut candidates = Vector.make<MethodSupplier>()
  let mut selection = CallSelection.make()
  let mut at = usize.ZERO
  while at < declared.length {
    if let Constraint.Conforms {provider: bounded, contract} = &declared[at] {
      if run Type.equalsShared(provider, &bounded) {
        let contractModule = declaringModuleOrdinal(&resolver.*, &contract)
        if contractModule == usize.MAX {
          fail InvalidModulePath {}
        }
        let module = run resolvedModule(&resolver.*, contractModule)
        let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, &contract)
        if let Option<usize>.Some {value: position} = move contractOrdinal {
          let written = run header(&mut resolver.*, &module, position)
          let mut isInterface = false
          if let Option<HeaderSyntax>.Some {value} = move written {
            if let Node.InterfaceHeader {..} = value.header {
              isInterface = true
            }
          }
          if isInterface {
            let listed = run proofDemand(
              &mut resolver.*,
              &mut owner.*,
              &mut request.*,
              &mut dependencies.*,
              Key {
                family: Family.Operations,
                module: contractModule,
                name: usize.ZERO,
                declaration: position,
                member: usize.ZERO,
                external: false,
              },
              siteSpan,
              nested,
            )
            let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
              &listed,
              answerRejection,
            )
            if let Option<Shared<Rejection>>.Some {value} = move failure {
              return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
                move value,
              )
            }
            let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, operationCount)
            let mut operationAtIndex = usize.ZERO
            while operationAtIndex < count {
              let operation = Shared.with<
                Result<Answer, NoRejection>,
                Option<Shared<DeclarationId>>,
              >(
                &listed,
                fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
                  return operationAt(answer, operationAtIndex)
                },
              )
              if let Option<Shared<DeclarationId>>.Some {value: identity} = move operation {
                let named = Shared.with<DeclarationId, bool>(
                  &identity,
                  fn(value: &DeclarationId) -> bool {
                    return DeclarationId.named(value, member)
                  },
                )
                if named {
                  let sourceOrdinal = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
                  if let Option<usize>.Some {value: operationOrdinal} = move sourceOrdinal {
                    let contractKey = run internApplication(&mut resolver.*, &contract)
                    let providerKey = run internApplication(&mut resolver.*, provider)
                    let signature = run proofDemand(
                      &mut resolver.*,
                      &mut owner.*,
                      &mut request.*,
                      &mut dependencies.*,
                      Key {
                        family: Family.AppliedOperation,
                        module: contractModule,
                        name: contractKey,
                        declaration: operationOrdinal,
                        member: providerKey,
                        external: false,
                      },
                      siteSpan,
                      nested,
                    )
                    let failure = Shared.with<
                      Result<Answer, NoRejection>,
                      Option<Shared<Rejection>>,
                    >(&signature, answerRejection)
                    if let Option<Shared<Rejection>>.Some {value} = move failure {
                      return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
                        move value,
                      )
                    }
                    if Shared.with<Result<Answer, NoRejection>, usize>(
                      &signature,
                      signatureTypeParameterCount,
                    ) == usize.ZERO {
                      let receiver = run receiverPosition(&signature, provider)
                      if let Option<ReceiverPosition>.Some {value: receiverPositionValue} = move receiver {
                        let index = Vector.length<MethodSupplier>(&candidates)
                        run Vector.append<MethodSupplier>(
                          &mut candidates,
                          MethodSupplier {
                            contract: Shared.clone<Type>(&contract),
                            operationModule: contractModule,
                            operationOrdinal: operationOrdinal,
                            receiver: receiverPositionValue,
                          },
                        )
                        CallSelection.add(&mut selection, index)
                      }
                    }
                  }
                }
              }
              operationAtIndex = operationAtIndex + usize.ONE
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  if CallSelection.ambiguous(&selection) {
    return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousBoundMethod, siteSpan),
    )
  }
  let selected = CallSelection.unique(&selection)
  if let Option<usize>.Some {value: index} = move selected {
    let listed = Vector.asSlice<MethodSupplier>(&candidates)
    let chosen = &listed[index]
    let module = run resolvedModule(&resolver.*, chosen.operationModule)
    let operation = run declarationAt(&mut resolver.*, &module, chosen.operationOrdinal)
    if let Option<DeclarationId>.Some {value: identity} = move operation {
      let found = run selectOperationCall(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        nested,
        &chosen.contract,
        provider,
        &identity,
        declared,
        siteModule,
        siteSpan,
      )
      match move found {
        Result<OperationCall, Shared<Rejection>>.Success {value: operationCall} => {
          let mut selectedCall = move operationCall
          selectedCall.receiver = Option.some<ReceiverPosition>(chosen.receiver)
          return Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
            Option.some<SelectedReceiverOperation>(
              SelectedReceiverOperation {
                contract: Shared.clone<Type>(&chosen.contract),
                call: move selectedCall,
              },
            ),
          )
        }
        Result<OperationCall, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(move error)
        }
      }
    }
  }
  return Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
    Option.none<SelectedReceiverOperation>(),
  )
}

fn alreadyVisible(interfaces: &[VisibleInterface], module: usize, ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < interfaces.length {
    if interfaces[at].module == module && interfaces[at].ordinal == ordinal {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Only declarations the caller can name contribute method suppliers. A namespace import opens
// the imported module's public namespace; it does not activate or hide any conformance head.
effect fn appendInterfaceNames(
  resolver: &mut Resolver,
  module: &ModuleId,
  moduleOrdinal: usize,
  external: bool,
  names: &mut Vector<VisibleName>,
) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(indexed)
    let candidates = ModuleIndex.listCandidates(index)
    let declarations = ModuleIndex.listDeclarations(index)
    let hir = IndexedSource.authored(indexed)
    let mut at = usize.ZERO
    while at < candidates.length {
      let candidate = &candidates[at]
      if (!external || candidate.isPublic) && candidate.kind != CandidateKind.ImportModule {
        let mut possible = candidate.kind == CandidateKind.ImportMember
        if candidate.kind == CandidateKind.Declaration && candidate.declaration < declarations.length {
          if let Node.InterfaceHeader {..} = Module.node(
            hir,
            declarations[candidate.declaration].header,
          ) {
            possible = true
          }
        }
        if possible {
          run Vector.append<VisibleName>(
            &mut names.*,
            VisibleName {
              module: moduleOrdinal,
              name: run Bytes.copy(Bytes.asSlice(&candidate.name)),
              external: external,
            },
          )
        }
      }
      at = at + usize.ONE
    }
  }
  return ()
}

effect fn visibleInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Vector<VisibleInterface>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let siteOrdinal = run internModule(&mut resolver.*, siteModule)
  let mut names = Vector.make<VisibleName>()
  run appendInterfaceNames(&mut resolver.*, siteModule, siteOrdinal, false, &mut names)
  let mut namespaces = Vector.make<Bytes>()
  let answer = run source(&mut resolver.*, siteModule)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &answer,
    siteModule,
  ) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < candidates.length {
      if candidates[at].kind == CandidateKind.ImportModule {
        run Vector.append<Bytes>(
          &mut namespaces,
          run Bytes.copy(Bytes.asSlice(&candidates[at].name)),
        )
      }
      at = at + usize.ONE
    }
  }
  let imported = Vector.asSlice<Bytes>(&namespaces)
  let mut namespaceAt = usize.ZERO
  while namespaceAt < imported.length {
    let selected = run select(
      &mut resolver.*,
      siteModule,
      Bytes.asSlice(&imported[namespaceAt]),
      false,
    )
    if selected.count == usize.ONE && selected.kind == CandidateKind.ImportModule {
      let answer = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: Family.Import,
          module: siteOrdinal,
          name: usize.ZERO,
          declaration: selected.declaration,
          member: usize.MAX,
          external: false,
        },
        siteSpan,
        true,
      )
      let binding = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
        &answer,
        selectedImport,
      )
      if let Option<usize>.Some {value: targetOrdinal} = move binding.module {
        let target = run resolvedModule(&resolver.*, targetOrdinal)
        run appendInterfaceNames(&mut resolver.*, &target, targetOrdinal, true, &mut names)
      }
    }
    namespaceAt = namespaceAt + usize.ONE
  }
  let mut interfaces = Vector.make<VisibleInterface>()
  let candidates = Vector.asSlice<VisibleName>(&names)
  let mut at = usize.ZERO
  while at < candidates.length {
    let selected = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      candidates[at].module,
      siteModule,
      Bytes.asSlice(&candidates[at].name),
      candidates[at].external,
      siteSpan,
      RejectionCode.NotType,
    )
    if let Result<SelectedDeclaration, Shared<Rejection>>.Success {value: declaration} = move selected {
      if !alreadyVisible(
        Vector.asSlice<VisibleInterface>(&interfaces),
        declaration.module,
        declaration.ordinal,
      ) {
        let module = run resolvedModule(&resolver.*, declaration.module)
        let written = run header(&mut resolver.*, &module, declaration.ordinal)
        if let Option<HeaderSyntax>.Some {value} = move written {
          if let Node.InterfaceHeader {..} = value.header {
            run Vector.append<VisibleInterface>(
              &mut interfaces,
              VisibleInterface {module: declaration.module, ordinal: declaration.ordinal},
            )
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return move interfaces
}

// The provider fixes an impl head before its interface arguments are considered. Re-resolve an
// open contract under those exact bindings; call arguments and expected results never infer them.
effect fn appliedHeadContract(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  head: &Shared<ImplementationHead>,
  bindings: &[Binding],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Shared<Type>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(head, headTerms)
  let found = match move terms {
    Option<HeadTerms>.Some {value} => move value
    Option<HeadTerms>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  if !Type.hasOpenParameters(&found.contract) {
    return Result.succeed<Shared<Type>, Shared<Rejection>>(move found.contract)
  }
  let moduleOrdinal = Shared.with<DeclarationId, usize>(
    &found.declaration,
    fn(value: &DeclarationId) -> usize {
      return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
    },
  )
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, moduleOrdinal)
  let located = run ordinalOfIdentity(&mut resolver.*, &module, &found.declaration)
  let ordinal = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let written = run header(&mut resolver.*, &module, ordinal)
  let subject = match move written {
    Option<HeaderSyntax>.Some {value} => match value.header {
      Node.ImplHeader {subject, ..} => subject
      _ => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
    }
    Option<HeaderSyntax>.None => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
      )
    }
  }
  let template = run templateBinders(&mut resolver.*, &module, ordinal)
  let formal = match move template {
    Result<Vector<Binder>, Shared<Rejection>>.Success {value} => move value
    Result<Vector<Binder>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Shared<Type>, Shared<Rejection>>(move error)
    }
  }
  let mut arguments = Vector.make<Argument>()
  let count = Vector.length<Binder>(&formal)
  let mut at = usize.ZERO
  while at < count {
    let found = matchedArgument(bindings, &found.declaration, at)
    let argument = match move found {
      Option<Argument>.Some {value} => move value
      Option<Argument>.None => {
        return Result.failResult<Shared<Type>, Shared<Rejection>>(
          run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
        )
      }
    }
    run Vector.append<Argument>(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let applied = run bindArguments(
    Vector.asSlice<Binder>(&formal),
    Vector.asSlice<Argument>(&arguments),
  )
  let mut elision = LifetimeElision {
    owner: run declarationAt(&mut resolver.*, &module, ordinal),
    nextOrdinal: count,
    output: false,
    resultDefault: Option.none<Shared<Lifetime>>(),
    generated: Vector.make<Shared<Lifetime>>(),
    invocation: false,
    nested: false,
    renumber: Vector.make<usize>(),
    staticEnvironment: false,
    supplied: Option.none<Vector<Argument>>(),
    assumptions: Option.none<Vector<Constraint>>(),
  }
  return run resolveType(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    moduleOrdinal,
    subject,
    Vector.asSlice<Binder>(&applied),
    &mut elision,
  )
}

// Concrete receiver syntax sees only interfaces nameable at this call site. Heads come from each
// interface/provider owner bucket; the receiver type alone must determine an applicable head.
effect fn selectConcreteReceiverCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  provider: &Shared<Type>,
  member: &[u8],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedReceiverOperation>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let visible = run visibleInterfaces(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    siteModule,
    siteSpan,
  )
  let interfaces = Vector.asSlice<VisibleInterface>(&visible)
  let mut candidates = Vector.make<MethodSupplier>()
  let mut selection = CallSelection.make()
  let providerKey = run internApplication(&mut resolver.*, provider)
  let mut at = usize.ZERO
  while at < interfaces.length {
    let visibleInterface = &interfaces[at]
    let module = run resolvedModule(&resolver.*, visibleInterface.module)
    let listed = run proofDemand(
      &mut resolver.*,
      &mut owner.*,
      &mut request.*,
      &mut dependencies.*,
      Key {
        family: Family.Operations,
        module: visibleInterface.module,
        name: usize.ZERO,
        declaration: visibleInterface.ordinal,
        member: usize.ZERO,
        external: false,
      },
      siteSpan,
      nested,
    )
    let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &listed,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failure {
      return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(move value)
    }
    let operationCountValue = Shared.with<Result<Answer, NoRejection>, usize>(
      &listed,
      operationCount,
    )
    let mut operationAtIndex = usize.ZERO
    while operationAtIndex < operationCountValue {
      let operation = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
          return operationAt(answer, operationAtIndex)
        },
      )
      if let Option<Shared<DeclarationId>>.Some {value: identity} = move operation {
        if Shared.with<DeclarationId, bool>(
          &identity,
          fn(value: &DeclarationId) -> bool {
            return DeclarationId.named(value, member)
          },
        ) {
          let located = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
          if let Option<usize>.Some {value: operationOrdinal} = move located {
            let bucket = run proofDemand(
              &mut resolver.*,
              &mut owner.*,
              &mut request.*,
              &mut dependencies.*,
              Key {
                family: Family.ConformanceHeads,
                module: visibleInterface.module,
                name: providerKey,
                declaration: visibleInterface.ordinal,
                member: usize.ZERO,
                external: false,
              },
              siteSpan,
              nested,
            )
            let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
              &bucket,
              answerRejection,
            )
            if let Option<Shared<Rejection>>.Some {value} = move failure {
              return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
                move value,
              )
            }
            let count = Shared.with<Result<Answer, NoRejection>, usize>(&bucket, bucketCount)
            let mut headAt = usize.ZERO
            while headAt < count {
              let candidate = Shared.with<
                Result<Answer, NoRejection>,
                Option<Shared<ImplementationHead>>,
              >(
                &bucket,
                fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
                  return bucketAt(answer, headAt)
                },
              )
              if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
                let terms = Shared.with<ImplementationHead, Option<HeadTerms>>(&head, headTerms)
                if let Option<HeadTerms>.Some {value: termsValue} = move terms {
                  let mut variables = Vector.make<Shared<DeclarationId>>()
                  run Vector.append<Shared<DeclarationId>>(
                    &mut variables,
                    Shared.clone<DeclarationId>(&termsValue.declaration),
                  )
                  let mut bindings = Vector.make<Binding>()
                  let matched = run Type.unify(
                    &termsValue.provider,
                    provider,
                    Vector.asSlice<Shared<DeclarationId>>(&variables),
                    Comparison.Exact,
                    &mut bindings,
                  )
                  if exactHeadUndetermined(&matched) {
                    return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
                      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
                    )
                  }
                  if exactHeadMatched(&matched) {
                    let applied = run appliedHeadContract(
                      &mut resolver.*,
                      &mut owner.*,
                      &mut dependencies.*,
                      &head,
                      Vector.asSlice<Binding>(&bindings),
                      siteModule,
                      siteSpan,
                    )
                    let contract = match move applied {
                      Result<Shared<Type>, Shared<Rejection>>.Success {value: appliedContract} => move appliedContract
                      Result<Shared<Type>, Shared<Rejection>>.Failure {error} => {
                        return Result.failResult<
                          Option<SelectedReceiverOperation>,
                          Shared<Rejection>,
                        >(move error)
                      }
                    }
                    let contractKey = run internApplication(&mut resolver.*, &contract)
                    let signature = run proofDemand(
                      &mut resolver.*,
                      &mut owner.*,
                      &mut request.*,
                      &mut dependencies.*,
                      Key {
                        family: Family.AppliedOperation,
                        module: visibleInterface.module,
                        name: contractKey,
                        declaration: operationOrdinal,
                        member: providerKey,
                        external: false,
                      },
                      siteSpan,
                      nested,
                    )
                    let failure = Shared.with<
                      Result<Answer, NoRejection>,
                      Option<Shared<Rejection>>,
                    >(&signature, answerRejection)
                    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
                      return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
                        move diagnostic,
                      )
                    }
                    if Shared.with<Result<Answer, NoRejection>, usize>(
                      &signature,
                      signatureTypeParameterCount,
                    ) == usize.ZERO {
                      let receiver = run receiverPosition(&signature, provider)
                      if let Option<ReceiverPosition>.Some {value: receiverPositionValue} = move receiver {
                        let mut duplicate = false
                        let existing = Vector.asSlice<MethodSupplier>(&candidates)
                        let mut prior = usize.ZERO
                        while prior < existing.length {
                          if existing[prior].operationModule == visibleInterface.module && existing[prior].operationOrdinal == operationOrdinal && run Type.equalsShared(
                            &existing[prior].contract,
                            &contract,
                          ) {
                            duplicate = true
                            break
                          }
                          prior = prior + usize.ONE
                        }
                        if !duplicate {
                          let index = Vector.length<MethodSupplier>(&candidates)
                          run Vector.append<MethodSupplier>(
                            &mut candidates,
                            MethodSupplier {
                              contract: move contract,
                              operationModule: visibleInterface.module,
                              operationOrdinal: operationOrdinal,
                              receiver: receiverPositionValue,
                            },
                          )
                          CallSelection.add(&mut selection, index)
                        }
                      }
                    }
                  }
                }
              }
              headAt = headAt + usize.ONE
            }
          }
        }
      }
      operationAtIndex = operationAtIndex + usize.ONE
    }
    at = at + usize.ONE
  }
  if CallSelection.ambiguous(&selection) {
    return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousConformanceMethod, siteSpan),
    )
  }
  let selected = CallSelection.unique(&selection)
  if let Option<usize>.Some {value: index} = move selected {
    let listed = Vector.asSlice<MethodSupplier>(&candidates)
    let chosen = &listed[index]
    let module = run resolvedModule(&resolver.*, chosen.operationModule)
    let operation = run declarationAt(&mut resolver.*, &module, chosen.operationOrdinal)
    if let Option<DeclarationId>.Some {value: identity} = move operation {
      let found = run selectOperationCall(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        nested,
        &chosen.contract,
        provider,
        &identity,
        declared,
        siteModule,
        siteSpan,
      )
      match move found {
        Result<OperationCall, Shared<Rejection>>.Success {value: operationCall} => {
          let mut selectedCall = move operationCall
          selectedCall.receiver = Option.some<ReceiverPosition>(chosen.receiver)
          return Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
            Option.some<SelectedReceiverOperation>(
              SelectedReceiverOperation {
                contract: Shared.clone<Type>(&chosen.contract),
                call: move selectedCall,
              },
            ),
          )
        }
        Result<OperationCall, Shared<Rejection>>.Failure {error} => {
          return Result.failResult<Option<SelectedReceiverOperation>, Shared<Rejection>>(move error)
        }
      }
    }
  }
  return Result.succeed<Option<SelectedReceiverOperation>, Shared<Rejection>>(
    Option.none<SelectedReceiverOperation>(),
  )
}

fn witnessFor(answer: &Result<Answer, NoRejection>, operation: &DeclarationId) -> Option<
  Shared<DeclarationId>,
> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      let mut at = usize.ZERO
      while at < listed.length {
        if Shared.with<DeclarationId, bool>(
          &listed[at].operation,
          fn(found: &DeclarationId) -> bool {
            return DeclarationId.equals(found, operation)
          },
        ) {
          return Option.some<Shared<DeclarationId>>(
            Shared.clone<DeclarationId>(&listed[at].implementation),
          )
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

// Eligibility reads only written operand slots. In particular the result, witness, and expected
// expression type cannot narrow this comparison after two suppliers accept identical operands.
effect fn matchesOperatorOperands(
  signature: &Shared<Result<Answer, NoRejection>>,
  operands: &[Shared<Type>],
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature.*, signatureParameterCount)
  if count != operands.length {
    return false
  }
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return false
      }
    }
    if !run Type.equalsShared(&parameterType, &operands[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// An open implementation head is outside this concrete candidate path. Only retain an
// Unsupported boundary if its operand pattern can actually accept the written operands.
effect fn openOperatorCouldMatch(
  signature: &Shared<Result<Answer, NoRejection>>,
  operands: &[Shared<Type>],
  head: &Shared<ImplementationHead>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature.*, signatureParameterCount)
  if count != operands.length {
    return false
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    if let Option<Shared<Type>>.Some {value} = move parameter {
      run Vector.append<Shared<Type>>(&mut parameters, move value)
    } else {
      return false
    }
    at = at + usize.ONE
  }
  let identity = Shared.with<ImplementationHead, Shared<DeclarationId>>(
    head,
    fn(value: &ImplementationHead) -> Shared<DeclarationId> {
      return Shared.clone<DeclarationId>(&value.declaration)
    },
  )
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, move identity)
  let mut bindings = Vector.make<Binding>()
  let compared = run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&parameters),
    operands,
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  return match move compared {
    Unification.Distinct => false
    _ => true
  }
}

// Without a provider-owned operand, a provider-only implementation module cannot be found from
// an unqualified expression. Keep that unsettled shape explicit when its operand pattern fits.
effect fn unanchoredOperatorCouldMatch(
  signature: &Shared<Result<Answer, NoRejection>>,
  operands: &[Shared<Type>],
  contract: &Shared<DeclarationId>,
  operation: &Shared<DeclarationId>,
  selfOrdinal: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let count = Shared.with<Result<Answer, NoRejection>, usize>(&signature.*, signatureParameterCount)
  if count != operands.length {
    return false
  }
  let mut parameters = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < count {
    let parameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &signature.*,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        return signatureParameter(answer, at)
      },
    )
    let parameterType = match move parameter {
      Option<Shared<Type>>.Some {value} => value
      Option<Shared<Type>>.None => {
        return false
      }
    }
    let owns = Shared.with<DeclarationId, bool>(
      contract,
      fn(identity: &DeclarationId) -> bool {
        return Type.occurrences(&parameterType, identity, selfOrdinal) > usize.ZERO
      },
    )
    if owns {
      return false
    }
    run Vector.append<Shared<Type>>(&mut parameters, move parameterType)
    at = at + usize.ONE
  }
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(contract))
  run Vector.append<Shared<DeclarationId>>(&mut variables, Shared.clone<DeclarationId>(operation))
  let mut bindings = Vector.make<Binding>()
  let compared = run Type.unifyAll(
    Vector.asSlice<Shared<Type>>(&parameters),
    operands,
    Vector.asSlice<Shared<DeclarationId>>(&variables),
    Comparison.Exact,
    &mut bindings,
  )
  return match move compared {
    Unification.Distinct => false
    _ => true
  }
}

// The supplier is already fixed before this call. Prove its exact application, then demand the
// same substituted operation signature for qualified, receiver, and operator syntax. A concrete
// proof names the checked witness body; a declared proof leaves that choice to specialization.
effect fn selectOperationCall(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  nested: bool,
  contract: &Shared<Type>,
  provider: &Shared<Type>,
  operation: &DeclarationId,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<OperationCall, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let contractModule = declaringModuleOrdinal(&resolver.*, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = run resolvedModule(&resolver.*, contractModule)
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(operation))
  let ordinal = run ordinalOfIdentity(&mut resolver.*, &module, &identity)
  let position = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<OperationCall, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let contractOrdinal = run ordinalOfProvider(&mut resolver.*, &module, contract)
  let contractPosition = match move contractOrdinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.failResult<OperationCall, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
      )
    }
  }
  let operations = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.Operations,
      module: contractModule,
      name: usize.ZERO,
      declaration: contractPosition,
      member: usize.ZERO,
      external: false,
    },
    siteSpan,
    nested,
  )
  let invalidOperations = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &operations,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalidOperations {
    return Result.failResult<OperationCall, Shared<Rejection>>(move value)
  }
  if Shared.with<Result<Answer, NoRejection>, usize>(
    &operations,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return operationIndex(answer, operation)
    },
  ) == usize.MAX {
    return Result.failResult<OperationCall, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
    )
  }
  let goal = ConformanceGoal {
    contract: Shared.clone<Type>(contract),
    provider: Shared.clone<Type>(provider),
  }
  let mut chain = Vector.make<ConformanceGoal>()
  let mut steps = Vector.make<ConformanceStep>()
  let avoid = Option.none<Shared<DeclarationId>>()
  let failed = run proveGoal(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    nested,
    &avoid,
    &goal,
    declared,
    siteModule,
    siteSpan,
    &mut chain,
    &mut steps,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failed {
    return Result.failResult<OperationCall, Shared<Rejection>>(move value)
  }
  let contractKey = run internApplication(&mut resolver.*, contract)
  let providerKey = run internApplication(&mut resolver.*, provider)
  let signature = run proofDemand(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    Key {
      family: Family.AppliedOperation,
      module: contractModule,
      name: contractKey,
      declaration: position,
      member: providerKey,
      external: false,
    },
    siteSpan,
    nested,
  )
  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    answerRejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move invalid {
    return Result.failResult<OperationCall, Shared<Rejection>>(move value)
  }
  let mut implementation = Option.none<Shared<DeclarationId>>()
  let complete = Vector.asSlice<ConformanceStep>(&steps)
  if complete.length > usize.ZERO {
    if let ConformanceEvidence.Concrete {head, ..} = &complete[complete.length - usize.ONE].evidence {
      let witnessOwner = Shared.with<ImplementationHead, Shared<DeclarationId>>(
        &head,
        fn(value: &ImplementationHead) -> Shared<DeclarationId> {
          return Shared.clone<DeclarationId>(&value.declaration)
        },
      )
      let witnessModule = Shared.with<DeclarationId, usize>(
        &witnessOwner,
        fn(value: &DeclarationId) -> usize {
          return knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(value))
        },
      )
      if witnessModule == usize.MAX {
        fail InvalidModulePath {}
      }
      let witnessSource = run resolvedModule(&resolver.*, witnessModule)
      let found = run ordinalOfIdentity(&mut resolver.*, &witnessSource, &witnessOwner)
      let witnessOrdinal = match move found {
        Option<usize>.Some {value} => value
        Option<usize>.None => {
          return Result.failResult<OperationCall, Shared<Rejection>>(
            run reject(&resolver.*, siteModule, RejectionCode.UnknownMember, siteSpan),
          )
        }
      }
      let witnesses = run proofDemand(
        &mut resolver.*,
        &mut owner.*,
        &mut request.*,
        &mut dependencies.*,
        Key {
          family: Family.Witnesses,
          module: witnessModule,
          name: usize.ZERO,
          declaration: witnessOrdinal,
          member: usize.ZERO,
          external: false,
        },
        siteSpan,
        nested,
      )
      let mapped = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
        &witnesses,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
          return witnessFor(answer, operation)
        },
      )
      if let Option<Shared<DeclarationId>>.Some {value} = move mapped {
        implementation = Option.some<Shared<DeclarationId>>(move value)
      } else {
        return Result.failResult<OperationCall, Shared<Rejection>>(
          run reject(&resolver.*, siteModule, RejectionCode.IncompatibleWitness, siteSpan),
        )
      }
    }
  }
  return Result.succeed<OperationCall, Shared<Rejection>>(
    OperationCall {
      operation: run DeclarationId.copy(operation),
      implementation: move implementation,
      signature: move signature,
      proof: ConformanceProof {steps: move steps},
      receiver: Option.none<ReceiverPosition>(),
    },
  )
}

effect fn appendVisibleOperatorInterface(
  resolver: &mut Resolver,
  location: SelectedDeclaration,
  visible: &mut Vector<DeclarationId>,
) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
  let target = run resolvedModule(&resolver.*, location.module)
  let written = run header(&mut resolver.*, &target, location.ordinal)
  if let Option<HeaderSyntax>.Some {value} = move written {
    if let Node.InterfaceHeader {..} = value.header {
      let found = run declarationAt(&mut resolver.*, &target, location.ordinal)
      if let Option<DeclarationId>.Some {value: identity} = move found {
        let prior = Vector.asSlice<DeclarationId>(&visible.*)
        let mut before = usize.ZERO
        while before < prior.length {
          if DeclarationId.equals(&prior[before], &identity) {
            return ()
          }
          before = before + usize.ONE
        }
        run Vector.append<DeclarationId>(&mut visible.*, move identity)
      }
    }
  }
  return ()
}

// Operator syntax has no written interface name. Local interfaces, selected imports, and public
// interfaces reachable through an imported module namespace are all statically nameable.
effect fn visibleOperatorInterfaces(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  module: &ModuleId,
  span: Span,
) -> Result<Vector<DeclarationId>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut names = Vector.make<Bytes>()
  let mut namespaces = Vector.make<Bytes>()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
    &resolver.*,
    &sourceAnswer,
    module,
  ) {
    let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(indexed))
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let hir = IndexedSource.authored(indexed)
    let mut at = usize.ZERO
    while at < candidates.length {
      let candidate = &candidates[at]
      if candidate.kind == CandidateKind.ImportMember {
        run Vector.append<Bytes>(&mut names, run Bytes.copy(Bytes.asSlice(&candidate.name)))
      } else if candidate.kind == CandidateKind.ImportModule {
        run Vector.append<Bytes>(&mut namespaces, run Bytes.copy(Bytes.asSlice(&candidate.name)))
      } else if candidate.kind == CandidateKind.Declaration && candidate.declaration < declarations.length {
        if let Node.InterfaceHeader {..} = Module.node(
          hir,
          declarations[candidate.declaration].header,
        ) {
          run Vector.append<Bytes>(&mut names, run Bytes.copy(Bytes.asSlice(&candidate.name)))
        }
      }
      at = at + usize.ONE
    }
  }
  let moduleOrdinal = run internModule(&mut resolver.*, module)
  let mut visible = Vector.make<DeclarationId>()
  let listed = Vector.asSlice<Bytes>(&names)
  let mut at = usize.ZERO
  while at < listed.length {
    let selected = run selectDeclaration(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      moduleOrdinal,
      module,
      Bytes.asSlice(&listed[at]),
      false,
      span,
      RejectionCode.NotType,
    )
    let location = match move selected {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
        return Result.failResult<Vector<DeclarationId>, Shared<Rejection>>(move error)
      }
    }
    run appendVisibleOperatorInterface(&mut resolver.*, move location, &mut visible)
    at = at + usize.ONE
  }
  let imported = Vector.asSlice<Bytes>(&namespaces)
  let mut namespaceAt = usize.ZERO
  while namespaceAt < imported.length {
    let selected = run select(&mut resolver.*, module, Bytes.asSlice(&imported[namespaceAt]), false)
    if selected.count != usize.ONE || selected.kind != CandidateKind.ImportModule {
      namespaceAt = namespaceAt + usize.ONE
      continue
    }
    let binding = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      Key {
        family: Family.Import,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: selected.declaration,
        member: usize.MAX,
        external: false,
      },
      span,
    )
    let importSelection = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
      &binding,
      selectedImport,
    )
    if let Option<Shared<Rejection>>.Some {value} = move importSelection.rejected {
      return Result.failResult<Vector<DeclarationId>, Shared<Rejection>>(move value)
    }
    if let Option<usize>.Some {value: targetOrdinal} = move importSelection.module {
      let target = run resolvedModule(&resolver.*, targetOrdinal)
      let targetSource = run source(&mut resolver.*, &target)
      let mut publicNames = Vector.make<Bytes>()
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
        &resolver.*,
        &targetSource,
        &target,
      ) {
        let candidates = ModuleIndex.listCandidates(IndexedSource.moduleIndex(indexed))
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        let hir = IndexedSource.authored(indexed)
        let mut candidateAt = usize.ZERO
        while candidateAt < candidates.length {
          let candidate = &candidates[candidateAt]
          if candidate.isPublic {
            if candidate.kind == CandidateKind.ImportMember {
              run Vector.append<Bytes>(
                &mut publicNames,
                run Bytes.copy(Bytes.asSlice(&candidate.name)),
              )
            } else if candidate.kind == CandidateKind.Declaration && candidate.declaration < declarations.length {
              if let Node.InterfaceHeader {..} = Module.node(
                hir,
                declarations[candidate.declaration].header,
              ) {
                run Vector.append<Bytes>(
                  &mut publicNames,
                  run Bytes.copy(Bytes.asSlice(&candidate.name)),
                )
              }
            }
          }
          candidateAt = candidateAt + usize.ONE
        }
      }
      let public = Vector.asSlice<Bytes>(&publicNames)
      let mut publicAt = usize.ZERO
      while publicAt < public.length {
        let found = run selectDeclaration(
          &mut resolver.*,
          &mut owner.*,
          &mut dependencies.*,
          targetOrdinal,
          &target,
          Bytes.asSlice(&public[publicAt]),
          true,
          span,
          RejectionCode.NotType,
        )
        let location = match move found {
          Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => value
          Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<Vector<DeclarationId>, Shared<Rejection>>(move error)
          }
        }
        run appendVisibleOperatorInterface(&mut resolver.*, move location, &mut visible)
        publicAt = publicAt + usize.ONE
      }
    }
    namespaceAt = namespaceAt + usize.ONE
  }
  return Result.succeed<Vector<DeclarationId>, Shared<Rejection>>(move visible)
}

fn concreteOperatorGoal(head: &ImplementationHead, contractIdentity: &DeclarationId) -> Option<
  ConformanceGoal,
> {
  return match & head.kind {
    ImplementationKind.Conformance => {
      if let Option<Shared<Type>>.Some {value: contract} = &head.contract {
        if Shared.with<Type, bool>(
          &contract,
          fn(value: &Type) -> bool {
            return applicationMatches(value, contractIdentity)
          },
        ) {
          return Option.some<ConformanceGoal>(
            ConformanceGoal {
              contract: Shared.clone<Type>(&contract),
              provider: Shared.clone<Type>(&head.provider),
            },
          )
        }
      }
      return Option.none<ConformanceGoal>()
    }
    _ => Option.none<ConformanceGoal>()
  }
}

effect fn appendOperatorModule(modules: &mut Vector<usize>, ordinal: usize) -> ()
! OutOfMemoryError
? &mut Allocator {
  if ordinal == usize.MAX {
    return ()
  }
  let listed = Vector.asSlice<usize>(&modules.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == ordinal {
      return ()
    }
    at = at + usize.ONE
  }
  run Vector.append<usize>(&mut modules.*, ordinal)
  return ()
}

effect fn gatherBoundOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut boundAt = usize.ZERO
  while boundAt < declared.length {
    if let Constraint.Conforms {provider, contract} = &declared[boundAt] {
      if !Type.hasOpenParameters(&provider) && !Type.hasOpenParameters(&contract) {
        boundAt = boundAt + usize.ONE
        continue
      }
      let moduleOrdinal = declaringModuleOrdinal(&resolver.*, &contract)
      if moduleOrdinal != usize.MAX {
        let contractModule = run resolvedModule(&resolver.*, moduleOrdinal)
        let found = run ordinalOfProvider(&mut resolver.*, &contractModule, &contract)
        if let Option<usize>.Some {value: contractOrdinal} = move found {
          let listed = run demandChild(
            &mut resolver.*,
            &mut owner.*,
            &mut dependencies.*,
            Key {
              family: Family.Operations,
              module: moduleOrdinal,
              name: usize.ZERO,
              declaration: contractOrdinal,
              member: usize.ZERO,
              external: false,
            },
            siteSpan,
          )
          let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
            &listed,
            answerRejection,
          )
          if let Option<Shared<Rejection>>.Some {value} = move rejected {
            return Result.failResult<(), Shared<Rejection>>(move value)
          }
          let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, listedOperationCount)
          let mut at = usize.ZERO
          while at < count {
            let supplied = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
              &listed,
              fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
                return listedOperation(answer, at)
              },
            )
            if let Option<Shared<DeclarationId>>.Some {value: operation} = move supplied {
              let marker = run operationMarks(
                &mut resolver.*,
                &contractModule,
                &operation,
                requested,
              )
              if let Option<bool>.Some {value: valueOnly} = move marker {
                let foundOrdinal = run ordinalOfIdentity(
                  &mut resolver.*,
                  &contractModule,
                  &operation,
                )
                if let Option<usize>.Some {value: operationOrdinal} = move foundOrdinal {
                  let contractKey = run internApplication(&mut resolver.*, &contract)
                  let providerKey = run internApplication(&mut resolver.*, &provider)
                  let signature = run demandChild(
                    &mut resolver.*,
                    &mut owner.*,
                    &mut dependencies.*,
                    Key {
                      family: Family.AppliedOperation,
                      module: moduleOrdinal,
                      name: contractKey,
                      declaration: operationOrdinal,
                      member: providerKey,
                      external: false,
                    },
                    siteSpan,
                  )
                  let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
                    &signature,
                    answerRejection,
                  )
                  if let Option<Shared<Rejection>>.Some {value} = move invalid {
                    return Result.failResult<(), Shared<Rejection>>(move value)
                  }
                  if run matchesOperatorOperands(&signature, operands) {
                    if !valueOnly {
                      return Result.failResult<(), Shared<Rejection>>(
                        run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
                      )
                    }
                    run addOperatorCandidate(
                      &mut suppliers.*,
                      &mut choice.*,
                      &contract,
                      &provider,
                      moduleOrdinal,
                      operationOrdinal,
                    )
                  }
                }
              }
            }
            at = at + usize.ONE
          }
        }
      }
    }
    boundAt = boundAt + usize.ONE
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// Concrete candidates come only from the operator interface's own bucket and the operands'
// owner buckets. Their complete conformance proof still runs after one supplier is selected.
effect fn gatherConcreteOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  suppliers: &mut Vector<OperatorCandidate>,
  choice: &mut CallSelection,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let discovered = run visibleOperatorInterfaces(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    siteModule,
    siteSpan,
  )
  let visible = match move discovered {
    Result<Vector<DeclarationId>, Shared<Rejection>>.Success {value} => value
    Result<Vector<DeclarationId>, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<(), Shared<Rejection>>(move error)
    }
  }
  let mut openCandidate = false
  let interfaces = Vector.asSlice<DeclarationId>(&visible)
  let mut interfaceAt = usize.ZERO
  while interfaceAt < interfaces.length {
    let contractIdentity = &interfaces[interfaceAt]
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(contractIdentity))
    if moduleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let contractModule = run resolvedModule(&resolver.*, moduleOrdinal)
    let sharedIdentity = run Shared.make<DeclarationId>(run DeclarationId.copy(contractIdentity))
    let position = run ordinalOfIdentity(&mut resolver.*, &contractModule, &sharedIdentity)
    let interfaceOrdinal = match move position {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        fail InvalidModulePath {}
      }
    }
    let contractAnswer = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      Key {
        family: Family.Contract,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: interfaceOrdinal,
        member: usize.ZERO,
        external: false,
      },
      siteSpan,
    )
    let contractFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &contractAnswer,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move contractFailure {
      return Result.failResult<(), Shared<Rejection>>(move value)
    }
    let providerParameter = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &contractAnswer,
      contractProvider,
    )
    let selfOrdinal = match move providerParameter {
      Option<Shared<Type>>.Some {value} => Shared.with<Type, usize>(
        &value,
        fn(ty: &Type) -> usize {
          return Type.parameterOrdinalOf(ty, contractIdentity)
        },
      )
      Option<Shared<Type>>.None => usize.MAX
    }
    let listed = run demandChild(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      Key {
        family: Family.Operations,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: interfaceOrdinal,
        member: usize.ZERO,
        external: false,
      },
      siteSpan,
    )
    let invalid = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &listed,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move invalid {
      return Result.failResult<(), Shared<Rejection>>(move value)
    }
    let mut modules = Vector.make<usize>()
    run appendOperatorModule(&mut modules, moduleOrdinal)
    let mut operandAt = usize.ZERO
    while operandAt < operands.length {
      run appendOperatorModule(
        &mut modules,
        declaringModuleOrdinal(&resolver.*, &operands[operandAt]),
      )
      operandAt = operandAt + usize.ONE
    }
    let count = Shared.with<Result<Answer, NoRejection>, usize>(&listed, listedOperationCount)
    let mut operationAt = usize.ZERO
    while operationAt < count {
      let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(
        &listed,
        fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
          return listedOperation(answer, operationAt)
        },
      )
      if let Option<Shared<DeclarationId>>.Some {value: operation} = move found {
        let marker = run operationMarks(&mut resolver.*, &contractModule, &operation, requested)
        if let Option<bool>.Some {value: valueOnly} = move marker {
          let operationPosition = run ordinalOfIdentity(
            &mut resolver.*,
            &contractModule,
            &operation,
          )
          if let Option<usize>.Some {value: operationOrdinal} = move operationPosition {
            if selfOrdinal != usize.MAX {
              let rawSignature = run demandChild(
                &mut resolver.*,
                &mut owner.*,
                &mut dependencies.*,
                Key {
                  family: Family.Signature,
                  module: moduleOrdinal,
                  name: usize.ZERO,
                  declaration: operationOrdinal,
                  member: usize.ZERO,
                  external: false,
                },
                siteSpan,
              )
              let rawFailure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
                &rawSignature,
                answerRejection,
              )
              if let Option<Shared<Rejection>>.Some {value} = move rawFailure {
                return Result.failResult<(), Shared<Rejection>>(move value)
              }
              if run unanchoredOperatorCouldMatch(
                &rawSignature,
                operands,
                &sharedIdentity,
                &operation,
                selfOrdinal,
              ) {
                return Result.failResult<(), Shared<Rejection>>(
                  run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
                )
              }
            }
            let owners = Vector.asSlice<usize>(&modules)
            let mut ownerAt = usize.ZERO
            while ownerAt < owners.length {
              let heads = run demandChild(
                &mut resolver.*,
                &mut owner.*,
                &mut dependencies.*,
                Key {
                  family: Family.Implementations,
                  module: owners[ownerAt],
                  name: usize.ZERO,
                  declaration: usize.ZERO,
                  member: usize.ZERO,
                  external: false,
                },
                siteSpan,
              )
              let failed = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
                &heads,
                answerRejection,
              )
              if let Option<Shared<Rejection>>.Some {value} = move failed {
                return Result.failResult<(), Shared<Rejection>>(move value)
              }
              let headCount = Shared.with<Result<Answer, NoRejection>, usize>(
                &heads,
                implementationCount,
              )
              let mut headAt = usize.ZERO
              while headAt < headCount {
                let candidate = Shared.with<
                  Result<Answer, NoRejection>,
                  Option<Shared<ImplementationHead>>,
                >(
                  &heads,
                  fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
                    return implementationAt(answer, headAt)
                  },
                )
                if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
                  let goal = Shared.with<ImplementationHead, Option<ConformanceGoal>>(
                    &head,
                    fn(value: &ImplementationHead) -> Option<ConformanceGoal> {
                      return concreteOperatorGoal(value, contractIdentity)
                    },
                  )
                  if let Option<ConformanceGoal>.Some {value: applied} = move goal {
                    let contractKey = run internApplication(&mut resolver.*, &applied.contract)
                    let providerKey = run internApplication(&mut resolver.*, &applied.provider)
                    let signature = run demandChild(
                      &mut resolver.*,
                      &mut owner.*,
                      &mut dependencies.*,
                      Key {
                        family: Family.AppliedOperation,
                        module: moduleOrdinal,
                        name: contractKey,
                        declaration: operationOrdinal,
                        member: providerKey,
                        external: false,
                      },
                      siteSpan,
                    )
                    let rejected = Shared.with<
                      Result<Answer, NoRejection>,
                      Option<Shared<Rejection>>,
                    >(&signature, answerRejection)
                    if let Option<Shared<Rejection>>.Some {value} = move rejected {
                      return Result.failResult<(), Shared<Rejection>>(move value)
                    }
                    if Type.hasOpenParameters(&applied.contract) || Type.hasOpenParameters(
                      &applied.provider,
                    ) {
                      if run openOperatorCouldMatch(&signature, operands, &head) {
                        openCandidate = true
                      }
                    } else if run matchesOperatorOperands(&signature, operands) {
                      if !valueOnly {
                        return Result.failResult<(), Shared<Rejection>>(
                          run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
                        )
                      }
                      run addOperatorCandidate(
                        &mut suppliers.*,
                        &mut choice.*,
                        &applied.contract,
                        &applied.provider,
                        moduleOrdinal,
                        operationOrdinal,
                      )
                    }
                  }
                }
                headAt = headAt + usize.ONE
              }
              ownerAt = ownerAt + usize.ONE
            }
          }
        }
      }
      operationAt = operationAt + usize.ONE
    }
    interfaceAt = interfaceAt + usize.ONE
  }
  if openCandidate {
    // Generic heads need operand-derived application before candidate comparison (unit 5).
    return Result.failResult<(), Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.Unsupported, siteSpan),
    )
  }
  return Result.succeed<(), Shared<Rejection>>(())
}

// All interface suppliers are collected before proof. The closed scalar table is another
// supplier, so an identical marked operation is ambiguous rather than silently shadowed.
effect fn selectOperator(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  request: &mut Request,
  dependencies: &mut Vector<Dependency>,
  requested: &Operator.Spelling,
  operands: &[Shared<Type>],
  declared: &[Constraint],
  closed: bool,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Option<SelectedOperator>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut suppliers = Vector.make<OperatorCandidate>()
  let mut choice = CallSelection.make()
  let bound = run gatherBoundOperator(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &mut suppliers,
    &mut choice,
    requested,
    operands,
    declared,
    siteModule,
    siteSpan,
  )
  if let Result<(), Shared<Rejection>>.Failure {error} = move bound {
    return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(move error)
  }
  let mut concreteOperands = true
  let mut operandAt = usize.ZERO
  while operandAt < operands.length {
    if Type.hasOpenParameters(&operands[operandAt]) {
      concreteOperands = false
      break
    }
    operandAt = operandAt + usize.ONE
  }
  if concreteOperands {
    let concrete = run gatherConcreteOperator(
      &mut resolver.*,
      &mut owner.*,
      &mut dependencies.*,
      &mut suppliers,
      &mut choice,
      requested,
      operands,
      siteModule,
      siteSpan,
    )
    if let Result<(), Shared<Rejection>>.Failure {error} = move concrete {
      return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(move error)
    }
  }
  if closed && Vector.length<OperatorCandidate>(&suppliers) > usize.ZERO {
    return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousOperator, siteSpan),
    )
  }
  if CallSelection.ambiguous(&choice) {
    return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(
      run reject(&resolver.*, siteModule, RejectionCode.AmbiguousOperator, siteSpan),
    )
  }
  let selected = match move CallSelection.unique(&choice) {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result.succeed<Option<SelectedOperator>, Shared<Rejection>>(
        Option.none<SelectedOperator>(),
      )
    }
  }
  let candidate = Vector.remove<OperatorCandidate>(&mut suppliers, selected)
  let module = run resolvedModule(&resolver.*, candidate.operationModule)
  let operation = run declarationAt(&mut resolver.*, &module, candidate.operationOrdinal)
  let identity = match move operation {
    Option<DeclarationId>.Some {value} => value
    Option<DeclarationId>.None => {
      return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(
        run reject(&resolver.*, siteModule, RejectionCode.MissingOperator, siteSpan),
      )
    }
  }
  let chosen = run selectOperationCall(
    &mut resolver.*,
    &mut owner.*,
    &mut request.*,
    &mut dependencies.*,
    true,
    &candidate.contract,
    &candidate.provider,
    &identity,
    declared,
    siteModule,
    siteSpan,
  )
  match move chosen {
    Result<OperationCall, Shared<Rejection>>.Success {value} => {
      return Result.succeed<Option<SelectedOperator>, Shared<Rejection>>(
        Option.some<SelectedOperator>(
          SelectedOperator {
            contract: move candidate.contract,
            provider: move candidate.provider,
            call: move value,
          },
        ),
      )
    }
    Result<OperationCall, Shared<Rejection>>.Failure {error} => {
      return Result.failResult<Option<SelectedOperator>, Shared<Rejection>>(move error)
    }
  }
}

// A type application or checked call is already inside a semantic query. Proof facts must be
// children of that query so an edited conformance invalidates the completed application.
effect fn proveAppliedBounds(
  resolver: &mut Resolver,
  owner: &mut Query<Word, Answer, NoRejection>,
  dependencies: &mut Vector<Dependency>,
  declared: &Vector<Constraint>,
  bounds: &[Constraint],
  module: &ModuleId,
  span: Span,
) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut request = Request.make()
  let mut chain = Vector.make<ConformanceGoal>()
  let mut steps = Vector.make<ConformanceStep>()
  let avoid = Option.none<Shared<DeclarationId>>()
  let mut at = usize.ZERO
  while at < bounds.length {
    if let Constraint.Conforms {provider, contract} = &bounds[at] {
      let goal = ConformanceGoal {
        contract: Shared.clone<Type>(&contract),
        provider: Shared.clone<Type>(&provider),
      }
      if Type.hasOpenParameters(&provider) || Type.hasOpenParameters(&contract) {
        let assumed = run declaredGoal(Vector.asSlice<Constraint>(declared), &goal)
        if let Option<Constraint>.None = move assumed {
          return Option.some<Shared<Rejection>>(
            run reject(&resolver.*, module, RejectionCode.Unsupported, span),
          )
        }
      }
      let failure = run proveGoal(
        &mut resolver.*,
        &mut owner.*,
        &mut request,
        &mut dependencies.*,
        true,
        &avoid,
        &goal,
        Vector.asSlice<Constraint>(declared),
        module,
        span,
        &mut chain,
        &mut steps,
      )
      if let Option<Shared<Rejection>>.Some {value} = move failure {
        return Option.some<Shared<Rejection>>(move value)
      }
    } else {
      return Option.some<Shared<Rejection>>(
        run reject(&resolver.*, module, RejectionCode.Unsupported, span),
      )
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Rejection>>()
}

/// Constructs a short loan from an active semantic provider's split state.
fn inFlightStaticPort<'source>(
  resolver: &'source mut Resolver,
  query: &'source mut Query<Word, Answer, NoRejection>,
  dependencies: &'source mut Vector<Dependency>,
) -> StaticPort<'source> {
  return StaticPort {resolver: move resolver, query: move query, dependencies: move dependencies}
}

impl<'source> StaticPort<'source> {
  /// Borrows one exact parsed source from this query port.
  pub fn sourceAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
    return SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
  }
  /// Checks that a checked body observed the exact source addressed by this authenticated cursor.
  pub fn matchesObservationAtCursor(self: &Self, cursor: &AuthoredCursor, observed: &Observation) -> bool {
    let indexed = SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
    if let Option<&IndexedSource>.Some {value} = move indexed {
      return Observation.equals(IndexedSource.sourceObservation(value), observed)
    }
    return false
  }
  /// Borrows authored HIR from one authenticated source for the duration of this port loan.
  pub fn authoredAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&Module> {
    let indexed = SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
    if let Option<&IndexedSource>.Some {value} = move indexed {
      return Option.some<&Module>(IndexedSource.authored(value))
    }
    return Option.none<&Module>()
  }
  /// The target of the held semantic revision.
  pub fn target(self: &Self) -> MachineTarget {
    return self.resolver.target
  }
  /// The explicit frozen build profile, absent while its defaults are being resolved.
  pub fn profile<'a>(self: &'a Self) -> Option<&'a FinalProfile> {
    return selectedProfile(&self.resolver.*)
  }

  /// Records the active profile input as a logical dependency of the reached static query.
  pub effect fn demandProfile(self: &mut Self, module: &ModuleId, span: Span) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let observed = run demandChild(
      &mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*,
      Key {
        family: Family.ProfileInput, module: moduleOrdinal, name: usize.ZERO,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      },
      span,
    )
    drop observed
    return ()
  }

  /// Demands one exact authored source on the port's held revision.
  pub effect fn authoredCursor(self: &mut Self, module: &ModuleId) -> Option<AuthoredCursor>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let answer = run source(&mut self.resolver.*, module)
    return run SourceIndex.authoredCursor(&mut self.resolver.*.source, &answer, module)
  }
  /// Demands the exact reached body through the active query and records its dependency edge.
  pub effect fn demandBody(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<
    Shared<Result<Answer, NoRejection>>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        Key {
          family: Family.Body,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        },
        span,
      )
      return Option.some<Shared<Result<Answer, NoRejection>>>(move answer)
    }
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }

  /// Demands the selected declaration's written signature in the active query.
  /// The answer retains any semantic rejection alongside canonical parameter types.
  pub effect fn demandSignature(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        Key {
          family: Family.Signature,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        },
        span,
      )
      return Option.some<Shared<Result<Answer, NoRejection>>>(move answer)
    }
    return Option.none<Shared<Result<Answer, NoRejection>>>()
  }

  /// Checks one reached static expression through the active query, preserving its source IDs.
  /// A mixed body's inactive static arms are never checked by this demand.
  pub effect fn demandCheckedRoot(
    self: &mut Self,
    module: &ModuleId,
    declaration: Option<usize>,
    root: HirId,
    expectation: StaticRootExpectation,
    binders: &[StaticRootBinder],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let answer = run checkedStaticRoot(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      module,
      move declaration,
      root,
      move expectation,
      binders,
    )
    return run Shared.make<Result<Answer, NoRejection>>(
      Result.succeed<Answer, NoRejection>(move answer),
    )
  }

/// Resolves a written call through the query facts in the active port.
pub effect fn resolveDeclaration(
    self: &mut Self,
    module: &ModuleId,
    namespace: Option<&[u8]>,
    name: &[u8],
    span: Span,
  ) -> Result<DeclarationId, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    let caller = run internModule(&mut self.resolver.*, module)
    let mut selectedModule = caller
    let mut external = false

    if let Option<&[u8]>.Some {value: namespaceName} = move namespace {
      let nameKey = Key {
        family: Family.Name,
        module: caller,
        name: run internName(&mut self.resolver.*, namespaceName),
        declaration: usize.ZERO,
        member: usize.ZERO,
        external: false,
      }
      let observed = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        nameKey,
        span,
      )
      drop observed
      let binding = run select(&mut self.resolver.*, module, namespaceName, false)
      if binding.count != usize.ONE || binding.kind != CandidateKind.ImportModule {
        let mut code = RejectionCode.NotCallable
        if binding.count == usize.ZERO {
          code = RejectionCode.UnknownName
        } else if binding.count > usize.ONE {
          code = RejectionCode.Collision
        }
        return Result.failResult<DeclarationId, Shared<Rejection>>(
          run reject(&self.resolver.*, module, code, span),
        )
      }
      let imported = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        Key {
          family: Family.Import,
          module: caller,
          name: usize.ZERO,
          declaration: binding.declaration,
          member: usize.MAX,
          external: false,
        },
        span,
      )
      let target = Shared.with<Result<Answer, NoRejection>, ImportSelection>(
        &imported,
        selectedImport,
      )
      if let Option<Shared<Rejection>>.Some {value} = move target.rejected {
        return Result.failResult<DeclarationId, Shared<Rejection>>(move value)
      }
      if let Option<usize>.Some {value} = move target.module {
        selectedModule = value
        external = true
      } else {
        return Result.failResult<DeclarationId, Shared<Rejection>>(
          run reject(&self.resolver.*, module, RejectionCode.UnknownMember, span),
        )
      }
    }
    let chosen = run selectDeclaration(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      selectedModule,
      module,
      name,
      external,
      span,
      RejectionCode.NotCallable,
    )
    return match move chosen {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => {
        let selected = run resolvedModule(&self.resolver.*, value.module)
        let declaration = run declarationAt(&mut self.resolver.*, &selected, value.ordinal)
        return match move declaration {
          Option<DeclarationId>.Some {value: identity} => Result.succeed<
            DeclarationId,
            Shared<Rejection>,
          >(move identity)
          Option<DeclarationId>.None => Result.failResult<DeclarationId, Shared<Rejection>>(
            run reject(&self.resolver.*, module, RejectionCode.NotCallable, span),
          )
        }
      }
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => Result.failResult<
        DeclarationId,
        Shared<Rejection>,
      >(move error)
    }
  }
}

impl Semantic {
  /// Borrows the held resolver and query for a static demand outside a running provider.
  pub fn staticPort<'source>(self: &'source mut Self, dependencies: &'source mut Vector<Dependency>) -> StaticPort<
    'source,
  > {
    return StaticPort {
      resolver: &mut self.resolver,
      query: &mut self.query,
      dependencies: move dependencies,
    }
  }
  /// Creates a lazy semantic store for one held revision and explicitly selected target.
  pub fn make(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    let profileSlot = match &profile {
      Option<FinalProfile>.Some {..} => usize.ONE
      Option<FinalProfile>.None => usize.ZERO
    }
    let selectedTarget = match &profile {
      Option<FinalProfile>.Some {value} => FinalProfile.target(&value)
      Option<FinalProfile>.None => target
    }
    return Semantic {
      resolver: Resolver {
        source: SourceIndex.make(move revision),
        baseTarget: target,
        target: selectedTarget,
        initialProfile: move profile,
        profiles: Vector.make<FinalProfile>(),
        profileSlot: profileSlot,
        mirValues: Vector.make<MirFunction>(),
        layoutValues: Vector.make<BackendLayout>(),
        instanceTexts: Vector.make<Bytes>(),
        instanceSymbols: Vector.make<Bytes>(),
        modules: Vector.make<ModuleId>(),
        names: Vector.make<Bytes>(),
        applications: Vector.make<Shared<Type>>(),
        backendInstances: Vector.make<InstanceKey>(),
        keys: Vector.make<ScopedKey>(),
        currentApplication: usize.MAX,
        active: Vector.make<Word>(),
        frames: Vector.make<SourceFrame>(),
        events: Vector.make<Event>(),
        nextAnswerId: usize.ONE,
      },
      query: Query.make<Word, Answer, NoRejection>(),
    }
  }
  /// Selects a new immutable source revision and validates completed facts on their next demand.
  ///
  /// # Details
  ///
  /// Exact source observations keep unchanged answers reusable. A checked body can keep its typed
  /// payload across another declaration's edit after its own inputs and child results validate.
  /// Changed source positions or incomplete evidence force a new body check.
  pub fn revise(self: &mut Self, revision: Revision) -> () {
    SourceIndex.revise(&mut self.resolver.source, move revision)
    return ()
  }
  /// Selects a complete profile by structural content; equal values reuse the same query scope.
  pub effect fn reviseProfile(self: &mut Self, profile: Option<FinalProfile>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let candidate = match move profile {
      Option<FinalProfile>.Some {value} => value
      Option<FinalProfile>.None => {
        self.resolver.profileSlot = usize.ZERO
        self.resolver.target = self.resolver.baseTarget
        return ()
      }
    }
    let selectedTarget = FinalProfile.target(&candidate)
    if let Option<FinalProfile>.Some {value: initial} = &self.resolver.initialProfile {
      if run FinalProfile.sameIdentity(&initial, &candidate) {
        self.resolver.profileSlot = usize.ONE
        self.resolver.target = selectedTarget
        return ()
      }
    }
    let known = Vector.asSlice<FinalProfile>(&self.resolver.profiles)
    let mut at = usize.ZERO
    while at < known.length {
      if run FinalProfile.sameIdentity(&known[at], &candidate) {
        self.resolver.profileSlot = at + 2
        self.resolver.target = selectedTarget
        return ()
      }
      at = at + usize.ONE
    }
    let slot = known.length + 2
    run Vector.append<FinalProfile>(&mut self.resolver.profiles, move candidate)
    self.resolver.profileSlot = slot
    self.resolver.target = selectedTarget
    return ()
  }
  /// Borrows the semantic query lifecycle events in demand order.
  pub fn eventLog(self: &Self) -> &[Event] {
    return Vector.asSlice<Event>(&self.resolver.events)
  }
  /// Borrows source reads and complete positive or negative name observations.
  pub fn sourceEvents(self: &Self) -> &[SourceEvent] {
    return SourceIndex.eventLog(&self.resolver.source)
  }
  /// Returns a complete name bucket, including an empty bucket, without resolving imports or types.
  /// Returns an anchored `MissingModule` rejection if the source path is absent.
  pub effect fn demandName(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let nameOrdinal = run internName(&mut self.resolver, name)
    let key = Key {
      family: Family.Name,
      module: moduleOrdinal,
      name: nameOrdinal,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.Name, module, name, &answer)
    return move answer
  }
  /// Resolves a nongeneric type alias only when the caller requests its target.
  /// Returns an anchored rejection for an absent name, unsupported target, or alias cycle.
  pub effect fn demandAlias(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Alias)
    run recordRoot(&mut request.*, Family.Alias, module, name, &answer)
    return move answer
  }
  /// Returns a nongeneric nominal identity without resolving fields, members, or layout.
  /// Returns an anchored rejection if the name does not identify a supported nominal declaration.
  pub effect fn demandIdentity(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Identity)
    run recordRoot(&mut request.*, Family.Identity, module, name, &answer)
    return move answer
  }
  /// Enumerates the written fields, tuple positions, enum cases, or union variants of a nominal.
  /// Member types and target layout remain undemanded.
  pub effect fn demandMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Members)
    run recordRoot(&mut request.*, Family.Members, module, name, &answer)
    return move answer
  }
  /// Resolves only one member's written types under a canonical nominal application.
  /// A struct field or tuple position has one type; a union variant has its ordered payload
  /// types; a scalar enum case has none. The member is selected by its enumeration ordinal.
  pub effect fn demandMemberShape(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
    member: usize,
    application: &Shared<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let nameOrdinal = run internName(&mut self.resolver, name)
    let bucketKey = Key {
      family: Family.Name,
      module: moduleOrdinal,
      name: nameOrdinal,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let observed = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      bucketKey,
      Span.make(usize.ZERO, usize.ZERO),
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&observed, hasRejection) {
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &observed)
      return move observed
    }
    drop observed
    let selected = run select(&mut self.resolver, module, name, false)
    if selected.count != usize.ONE || selected.kind != CandidateKind.Declaration {
      let mut code = RejectionCode.Collision
      if selected.count == usize.ZERO {
        code = RejectionCode.UnknownName
      } else if selected.kind != CandidateKind.Declaration {
        code = RejectionCode.NotType
      }
      let rejected = run rejectRoot(&mut self.resolver, module, bucketKey, code, selected.span)
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &rejected)
      return move rejected
    }
    let applicationOrdinal = run internApplication(&mut self.resolver, application)
    let key = Key {
      family: Family.MemberShape,
      module: moduleOrdinal,
      name: applicationOrdinal,
      declaration: selected.declaration,
      member: member,
      external: false,
    }
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, selected.span)
    run recordRoot(&mut request.*, Family.MemberShape, module, name, &answer)
    return move answer
  }
  /// Resolves the binders and declared bounds of a type, alias, interface, or service declaration.
  ///
  /// # Details
  ///
  /// This does not demand the declaration's identity or members, and it proves no bound; an
  /// application of a bounded declaration is rejected as unsupported where it is written.
  pub effect fn demandContract(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Contract)
    run recordRoot(&mut request.*, Family.Contract, module, name, &answer)
    return move answer
  }
  /// Enumerates an interface's or service's operation declarations in written order.
  ///
  /// # Details
  ///
  /// Only member headers are read; no operation signature is resolved. A field, an operation body,
  /// a visibility modifier on an operation, or another non-operation member rejects with
  /// `InvalidContractMember`, and a repeated operation name rejects at the later operation.
  pub effect fn demandOperations(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Operations,
    )
    run recordRoot(&mut request.*, Family.Operations, module, name, &answer)
    return move answer
  }
  /// Resolves the written signature of one interface or service operation without reading a body.
  ///
  /// # Details
  ///
  /// The operation resolves under its contract's binders and implicit `Self` provider, while its
  /// own binders keep the operation's identity. The contract's operation list is demanded first,
  /// so an invalid member list rejects here too. An absent operation rejects with `UnknownMember`.
  pub effect fn demandOperation(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    contract: &[u8],
    operation: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let listed = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      contract,
      Family.Operations,
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      run recordRoot(&mut request.*, Family.Signature, module, operation, &listed)
      return move listed
    }
    drop listed
    let selected = run select(&mut self.resolver, module, contract, false)
    let lookup = run memberOrdinal(&mut self.resolver, module, selected.declaration, operation)
    if let Option<Span>.Some {value: span} = move lookup.repeated {
      let diagnostic = run reject(&self.resolver, module, RejectionCode.Collision, span)
      let repeated = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.Signature, module, operation, &repeated)
      return move repeated
    }
    if let Option<usize>.Some {value: ordinal} = move lookup.ordinal {
      let answer = run memberSignature(
        &mut self.resolver,
        &mut self.query,
        module,
        ordinal,
        selected.span,
      )
      run recordRoot(&mut request.*, Family.Signature, module, operation, &answer)
      return move answer
    }
    // The contract's name is the nearest written anchor for an absent operation.
    let absent = run rejectAbsent(&mut self.resolver, module, selected.span)
    run recordRoot(&mut request.*, Family.Signature, module, operation, &absent)
    return move absent
  }
  /// Resolves the heads of every top-level conformance and sealed-property `impl` in one module, in
  /// written order.
  ///
  /// # Details
  ///
  /// Each head is the implementation's binders, including lifetimes elided from its heads, with
  /// its applied contract and provider. Only header names and applications are resolved; no member
  /// or body is read. An empty list observes that the module declares none. One rejected head
  /// rejects the list, because the module's membership is then unknown. Inherent `impl`s are
  /// reached through their owner with `demandInherentMembers`.
  pub effect fn demandImplementations(self: &mut Self, request: &mut Request, module: &ModuleId) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let key = Key {
      family: Family.Implementations,
      module: run internModule(&mut self.resolver, module),
      name: usize.ZERO,
      declaration: usize.ZERO,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.Implementations, module, b"", &answer)
    return move answer
  }
  /// Lists the conformance heads that implement an applied interface or service for a provider.
  ///
  /// # Details
  ///
  /// Heads are read only from the modules permitted to own them: the contract's module and the
  /// nominal provider's module for an interface, the provider's module for a service. A facade or
  /// alias spelling of either endpoint converges on the same canonical owners. An empty list
  /// observes absence; bodies, members, and applicability are not examined.
  ///
  /// # Gotchas
  ///
  /// Both types must come from answers of this store. A contract whose declaring module this store
  /// has never read fails with `InvalidModulePath`.
  pub effect fn demandConformanceHeads(
    self: &mut Self,
    request: &mut Request,
    contract: &Shared<Type>,
    provider: &Shared<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let contractModule = declaringModuleOrdinal(&self.resolver, contract)
    if contractModule == usize.MAX {
      fail InvalidModulePath {}
    }
    let module = run resolvedModule(&self.resolver, contractModule)
    let located = run ordinalOfProvider(&mut self.resolver, &module, contract)
    let declaration = match move located {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        fail InvalidModulePath {}
      }
    }
    let key = Key {
      family: Family.ConformanceHeads,
      module: contractModule,
      name: run internApplication(&mut self.resolver, provider),
      declaration: declaration,
      member: usize.ZERO,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.ConformanceHeads, &module, b"", &answer)
    return move answer
  }
  /// Proves one interface or service application using exact concrete heads and the caller's
  /// declared abstract bounds. Every conditional requirement must finish before proof succeeds.
  /// `siteModule` and `siteSpan` anchor a missing or undecidable goal at the use; declaration-level
  /// coherence and witness failures keep their own source anchors. This selects no runtime provider
  /// and adds no Effect requirement.
  pub effect fn proveConformance(
    self: &mut Self,
    request: &mut Request,
    contract: &Shared<Type>,
    provider: &Shared<Type>,
    declared: &[Constraint],
    siteModule: &ModuleId,
    siteSpan: Span,
  ) -> ConformanceDecision
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let goal = ConformanceGoal {
      contract: Shared.clone<Type>(contract),
      provider: Shared.clone<Type>(provider),
    }
    let mut chain = Vector.make<ConformanceGoal>()
    let mut steps = Vector.make<ConformanceStep>()
    let mut dependencies = Vector.make<Dependency>()
    let avoid = Option.none<Shared<DeclarationId>>()
    let failure = run proveGoal(
      &mut self.resolver,
      &mut self.query,
      &mut request.*,
      &mut dependencies,
      false,
      &avoid,
      &goal,
      declared,
      siteModule,
      siteSpan,
      &mut chain,
      &mut steps,
    )
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
      return ConformanceDecision.Rejected {diagnostic: move diagnostic, chain: move chain}
    }
    return ConformanceDecision.Proven {proof: ConformanceProof {steps: move steps}}
  }
  /// Decides whether one conformance `impl` is coherent before any applicability or bound proof.
  ///
  /// # Details
  ///
  /// Every written parameter must occur in the interface application or the provider, and every
  /// bound must descend through the provider without repeating an open parameter or rewriting a
  /// fixed interface argument (`NonterminatingConformance` with its step). The complete owner
  /// bucket is then read, and no other head may name the same goal once lifetimes are erased:
  /// bounds never make heads distinct and no head wins by source or demand order. Both heads of a
  /// conflict reject with the same diagnostic, anchored at the canonically later head, with `path`
  /// holding that head and then the earliest other conflicting head. `DuplicateConformance` names
  /// two unbounded heads that rename each other exactly; any other conflict is
  /// `OverlappingConformance`. A head the lifetime-erased comparison cannot decide, such as one
  /// whose union member nests a parameter, is `Unsupported`. A success proves no bound and admits
  /// no witness. An identity absent from the current revision rejects with `UnknownMember`.
  pub effect fn demandCoherence(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(implementation)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(implementation))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let answer = match move found {
      Option<usize>.Some {value: ordinal} => run demandRaw(
        &mut self.resolver,
        &mut self.query,
        Key {
          family: Family.Coherence,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        },
        Span.make(usize.ZERO, usize.ZERO),
      )
      Option<usize>.None => run rejectAbsent(
        &mut self.resolver,
        module,
        Span.make(usize.ZERO, usize.ZERO),
      )
    }
    run recordRoot(&mut request.*, Family.Coherence, module, b"", &answer)
    return move answer
  }
  /// Lists the written members of a module's `occurrence`th top-level `impl`, which must be a
  /// conformance or sealed-property implementation.
  ///
  /// # Details
  ///
  /// An inline member is its function declaration. A mapped member's path is resolved from headers
  /// only: a function of this module or of an imported namespace, or an inherent member its owner
  /// publishes. A repeated member name rejects with `Collision`; a rejected head publishes no
  /// member. Members are not matched against contract operations here.
  pub effect fn demandImplementationMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    occurrence: usize,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let implementation = run implementationOrdinal(&mut self.resolver, module, occurrence)
    if let Option<usize>.Some {value: ordinal} = move implementation {
      let key = Key {
        family: Family.ImplementationMembers,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: ordinal,
        member: usize.ZERO,
        external: false,
      }
      let answer = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        key,
        Span.make(usize.ZERO, usize.ZERO),
      )
      run recordRoot(&mut request.*, Family.ImplementationMembers, module, b"", &answer)
      return move answer
    }
    let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.ImplementationMembers, module, b"", &absent)
    return move absent
  }
  /// Enumerates the inherent members an owner publishes across its module's inherent `impl`s.
  ///
  /// # Details
  ///
  /// Only the owner's module is read; a rejected head publishes no member. A member whose name
  /// repeats another member, or an owner field, variant, enum member, generated operation, or
  /// contract operation, is not published, and its anchored rejection is kept; no winner is chosen
  /// by source order. Member signatures are not resolved.
  pub effect fn demandInherentMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.InherentMembers,
    )
    run recordRoot(&mut request.*, Family.InherentMembers, module, name, &answer)
    return move answer
  }
  /// Resolves the signature of `member`, an inherent member of the owner declaration `owner`.
  ///
  /// # Details
  ///
  /// The owner's published members decide the answer. A member that repeats another member's name
  /// or claims an owner item's name returns its kept rejection; no winner is chosen by source
  /// order. A member of a rejected inherent head is not published. An absent member rejects with
  /// `UnknownMember`.
  pub effect fn demandInherentMember(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    owner: &[u8],
    member: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let listed = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      owner,
      Family.InherentMembers,
    )
    if Shared.with<Result<Answer, NoRejection>, bool>(&listed, hasRejection) {
      run recordRoot(&mut request.*, Family.Signature, module, member, &listed)
      return move listed
    }
    let lookup = Shared.with<Result<Answer, NoRejection>, InherentLookup>(
      &listed,
      fn(answer: &Result<Answer, NoRejection>) -> InherentLookup {
        return inherentLookup(answer, member)
      },
    )
    drop listed
    let InherentLookup {published, rejected} = move lookup
    if let Option<Shared<DeclarationId>>.Some {value: declaration} = move published {
      let found = run ordinalOfIdentity(&mut self.resolver, module, &declaration)
      if let Option<usize>.Some {value: ordinal} = move found {
        let answer = run memberSignature(
          &mut self.resolver,
          &mut self.query,
          module,
          ordinal,
          Span.make(usize.ZERO, usize.ZERO),
        )
        run recordRoot(&mut request.*, Family.Signature, module, member, &answer)
        return move answer
      }
    }
    if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
      let kept = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.Signature, module, member, &kept)
      return move kept
    }
    // The owner's name is the nearest written anchor for an absent member.
    let selected = run select(&mut self.resolver, module, owner, false)
    let absent = run rejectAbsent(&mut self.resolver, module, selected.span)
    run recordRoot(&mut request.*, Family.Signature, module, member, &absent)
    return move absent
  }
  /// Resolves the signature of one function or operation addressed by its declaration identity.
  ///
  /// # Details
  ///
  /// This is the answer the name lookups return for the same declaration, under the same gates: a
  /// contract operation needs its contract's operation list, an `impl` member whose name is written
  /// twice in its block rejects with `Collision`, and an inherent member returns its owner's kept
  /// rejection unless the owner publishes it. An identity absent from the current revision
  /// rejects with `UnknownMember`.
  pub effect fn demandSignatureOf(
    self: &mut Self,
    request: &mut Request,
    declaration: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(declaration)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(declaration))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let answer = match move found {
      Option<usize>.Some {value: ordinal} => run memberSignature(
        &mut self.resolver,
        &mut self.query,
        module,
        ordinal,
        Span.make(usize.ZERO, usize.ZERO),
      )
      Option<usize>.None => run rejectAbsent(
        &mut self.resolver,
        module,
        Span.make(usize.ZERO, usize.ZERO),
      )
    }
    run recordRoot(
      &mut request.*,
      Family.Signature,
      module,
      DeclarationId.spelling(declaration),
      &answer,
    )
    return move answer
  }
  /// Resolves a contract operation's written call signature under an applied interface and
  /// provider, without choosing evidence for the application. Qualified calls, method calls, and
  /// operators use this same `Self` substitution after their supplier has been selected. The
  /// caller must separately prove the application or supply a declared bound.
  pub effect fn demandAppliedOperation(
    self: &mut Self,
    request: &mut Request,
    contract: &Shared<Type>,
    provider: &Shared<Type>,
    operation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = declaringModuleOrdinal(&self.resolver, contract)
    if moduleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let module = run resolvedModule(&self.resolver, moduleOrdinal)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(operation))
    let found = run ordinalOfIdentity(&mut self.resolver, &module, &identity)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(
          &mut self.resolver,
          &module,
          Span.make(usize.ZERO, usize.ZERO),
        )
        run recordRoot(
          &mut request.*,
          Family.AppliedOperation,
          &module,
          DeclarationId.spelling(operation),
          &absent,
        )
        return move absent
      }
    }
    let key = Key {
      family: Family.AppliedOperation,
      module: moduleOrdinal,
      name: run internApplication(&mut self.resolver, contract),
      declaration: ordinal,
      member: run internApplication(&mut self.resolver, provider),
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(
      &mut request.*,
      Family.AppliedOperation,
      &module,
      DeclarationId.spelling(operation),
      &answer,
    )
    return move answer
  }
  /// Resolves an inherent member's call signature under an applied nominal owner. The owner must
  /// publish the member; a rejected or inaccessible name is not redirected to a conformance.
  pub effect fn demandAppliedInherent(
    self: &mut Self,
    request: &mut Request,
    provider: &Shared<Type>,
    member: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let moduleOrdinal = declaringModuleOrdinal(&self.resolver, provider)
    if moduleOrdinal == usize.MAX {
      fail InvalidModulePath {}
    }
    let module = run resolvedModule(&self.resolver, moduleOrdinal)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(member))
    let found = run ordinalOfIdentity(&mut self.resolver, &module, &identity)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(
          &mut self.resolver,
          &module,
          Span.make(usize.ZERO, usize.ZERO),
        )
        run recordRoot(
          &mut request.*,
          Family.AppliedInherent,
          &module,
          DeclarationId.spelling(member),
          &absent,
        )
        return move absent
      }
    }
    let providerKey = run internApplication(&mut self.resolver, provider)
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      Key {
        family: Family.AppliedInherent,
        module: moduleOrdinal,
        name: providerKey,
        declaration: ordinal,
        member: usize.ZERO,
        external: false,
      },
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(
      &mut request.*,
      Family.AppliedInherent,
      &module,
      DeclarationId.spelling(member),
      &answer,
    )
    return move answer
  }
  /// Resolves a contract operation's signature under one conformance `impl`, with the contract's
  /// binders bound to the head's contract arguments and `Self` to its provider.
  ///
  /// # Details
  ///
  /// The operation keeps its own binders as its parameters. The supplied arguments are not checked
  /// against the contract's bounds. An operation that is not in the head's contract, or a head with
  /// no contract, rejects with `UnknownMember`; a rejected head or operation list rejects with its
  /// diagnostic. No member or body of the implementation is read.
  pub effect fn demandOperationUnder(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
    operation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(implementation)
    let name = DeclarationId.spelling(operation)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(implementation))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
        run recordRoot(&mut request.*, Family.OperationUnder, module, name, &absent)
        return move absent
      }
    }
    let position = run operationPosition(
      &mut self.resolver,
      &mut self.query,
      moduleOrdinal,
      ordinal,
      operation,
    )
    let member = match move position {
      Result<usize, Shared<Result<Answer, NoRejection>>>.Success {value} => value
      Result<usize, Shared<Result<Answer, NoRejection>>>.Failure {error} => {
        run recordRoot(&mut request.*, Family.OperationUnder, module, name, &error)
        return move error
      }
    }
    let key = Key {
      family: Family.OperationUnder,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ordinal,
      member: member,
      external: false,
    }
    let answer = run demandRaw(
      &mut self.resolver,
      &mut self.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.OperationUnder, module, name, &answer)
    return move answer
  }
  /// Pairs every contract operation of one conformance `impl` with the member that implements it,
  /// and checks each member's header against the operation's header under the conformance head.
  ///
  /// # Details
  ///
  /// The witnesses follow the contract's operation order. A missing, unknown, or incompatible
  /// member rejects with `IncompatibleWitness`, which names the failing component, at the member
  /// or, for a missing one, at the `impl`. A narrower implementation keeps the operation's header
  /// as the contract callers see. No member body is read, and a successful answer proves no
  /// conformance: the head's bounds and coherence are separate facts. An inherent or sealed head
  /// rejects with `UnknownMember`.
  pub effect fn demandWitnesses(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(implementation)
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(implementation))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move found {
      let key = Key {
        family: Family.Witnesses,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: ordinal,
        member: usize.ZERO,
        external: false,
      }
      let answer = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        key,
        Span.make(usize.ZERO, usize.ZERO),
      )
      run recordRoot(&mut request.*, Family.Witnesses, module, b"", &answer)
      return move answer
    }
    let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.Witnesses, module, b"", &absent)
    return move absent
  }
  /// Resolves a function's written parameter and result types without reading its body.
  /// Returns an anchored rejection for an unsupported header or referenced type.
  pub effect fn demandSignature(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Signature,
    )
    run recordRoot(&mut request.*, Family.Signature, module, name, &answer)
    return move answer
  }
  /// Resolves a constant's written type without reading its initializer.
  ///
  /// # Details
  ///
  /// The type is one primitive scalar or `string`, whose omitted lifetime is `'static`. Any other
  /// type is an anchored `InvalidConstant` rejection.
  pub effect fn demandConstant(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Constant)
    run recordRoot(&mut request.*, Family.Constant, module, name, &answer)
    return move answer
  }
  /// Resolves one registered package parameter's header without evaluating its default.
  pub effect fn demandParameterSchema(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    if !Request.hasRegisteredSchemaModule(&request.*, module) {
      let diagnostic = run reject(
        &self.resolver,
        module,
        RejectionCode.UnregisteredParameter,
        Span.make(usize.ZERO, usize.ZERO),
      )
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
      return move answer
    }
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.ParameterSchema,
    )
    run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
    return move answer
  }
  /// Evaluates one registered parameter's exact source default through the held static machine.
  pub effect fn demandParameterDefault(
    self: &mut Self,
    request: &mut Request,
    identity: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let module = DeclarationId.moduleId(identity)
    let name = DeclarationId.spelling(identity)
    if !Request.hasRegisteredSchemaModule(&request.*, module) {
      let diagnostic = run reject(&self.resolver, module, RejectionCode.UnregisteredParameter, Span.make(usize.ZERO, usize.ZERO))
      let answer = run rootRejection(&mut self.resolver, module, move diagnostic)
      run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
      return move answer
    }
    let moduleOrdinal = run internModule(&mut self.resolver, module)
    let owned = run Shared.make<DeclarationId>(run DeclarationId.copy(identity))
    let found = run ordinalOfIdentity(&mut self.resolver, module, &owned)
    let ordinal = match move found {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        let absent = run rejectAbsent(&mut self.resolver, module, Span.make(usize.ZERO, usize.ZERO))
        run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &absent)
        return move absent
      }
    }
    let key = Key {
      family: Family.ParameterDefault, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    }
    let answer = run demandRaw(&mut self.resolver, &mut self.query, key, Span.make(usize.ZERO, usize.ZERO))
    run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
    return move answer
  }
  /// Demands every parameter header in each explicitly registered source module.
  /// Imports alone never add schemas. Registered modules are visited in canonical order.
  pub effect fn demandRegisteredParameters(self: &mut Self, request: &mut Request) -> Result<
    Vector<RegisteredParameter>,
    Shared<Rejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let mut results = Vector.make<RegisteredParameter>()
    let mut moduleAt = usize.ZERO
    while moduleAt < Request.registeredSchemaModules(&request.*).length {
      let selected = Request.registeredSchemaModules(&request.*)
      let module = run ModuleId.copy(&selected[moduleAt])
      let loaded = run source(&mut self.resolver, &module)
      let mut names = Vector.make<RegisteredName>()
      if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
        &self.resolver,
        &loaded,
        &module,
      ) {
        let hir = IndexedSource.authored(indexed)
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        let mut at = usize.ZERO
        while at < declarations.length {
          let topLevel = match & declarations[at].parent {
            Option<usize>.None => true
            Option<usize>.Some {value: _} => false
          }
          if topLevel && DeclarationId.kind(&declarations[at].identity) == OwnerKind.PackageParameter {
            if let Node.PackageParameterHeader {name, ..} = Module.node(
              hir,
              declarations[at].header,
            ) {
              if let Node.Name {text} = Module.node(hir, name) {
                run Vector.append<RegisteredName>(&mut names, RegisteredName {
                  name: run Bytes.copy(Module.text(hir, text)),
                  identity: run DeclarationId.copy(&declarations[at].identity),
                })
              }
            }
          }
          at = at + usize.ONE
        }
      } else {
        return Result.failResult<Vector<RegisteredParameter>, Shared<Rejection>>(
          run reject(
            &self.resolver,
            &module,
            RejectionCode.MissingModule,
            Span.make(usize.ZERO, usize.ZERO),
          ),
        )
      }
      while Vector.length<RegisteredName>(&names) > usize.ZERO {
        let listed = Vector.remove<RegisteredName>(&mut names, usize.ZERO)
        let answer = run Semantic.demandParameterSchema(
          &mut self.*, &mut request.*, &module, Bytes.asSlice(&listed.name),
        )
        run Vector.append<RegisteredParameter>(&mut results, RegisteredParameter {
          module: run ModuleId.copy(&module),
          name: move listed.name,
          identity: move listed.identity,
          answer: move answer,
        })
      }
      moduleAt = moduleAt + usize.ONE
    }
    return Result.succeed<Vector<RegisteredParameter>, Shared<Rejection>>(move results)
  }
  /// Publishes a constant's value when its initializer needs no static execution.
  ///
  /// # Details
  ///
  /// The value demand first demands the constant's type. An exact Boolean or integer literal
  /// within its selected target range is the value. A bare name of another constant demands that
  /// constant's type, then its value, so a repeated initializer path is a `Cycle` rejection while
  /// both types stay available.
  ///
  /// # Gotchas
  ///
  /// Every other initializer, including floating-point, text, call, or operator, is an anchored
  /// `Unsupported` rejection rather than a provisional value.
  pub effect fn demandInitializer(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      name,
      Family.Initializer,
    )
    run recordRoot(&mut request.*, Family.Initializer, module, name, &answer)
    return move answer
  }
  /// Types one demanded ordinary function body against its written signature.
  ///
  /// # Details
  ///
  /// Scalar bodies retain the existing fully checked result. A generic body is typed once with
  /// symbolic parameters; its `TypedBody.Stage.ContractTyped` result retains safety obligations
  /// for later ownership, lifetime, cleanup, and Effect checking. A direct ordinary call reads
  /// the callee signature and records its required runtime body without checking that body.
  /// Completed answers replay current source and signature evidence into each request. Validated
  /// reuse records a `Reuse` event after the query starts rather than a cache hit.
  ///
  /// # Gotchas
  ///
  /// An unsupported expression or statement produces an anchored rejection. Contract typing does
  /// not establish executable readiness or full body safety.
  pub effect fn demandBody(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Body)
    run recordRoot(&mut request.*, Family.Body, module, name, &answer)
    return move answer
  }
  /// Demands the backend-neutral body graph for one named function.
  pub effect fn demandMir(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Mir)
    run recordRoot(&mut request.*, Family.Mir, module, name, &answer)
    return move answer
  }
  /// Borrows a MIR graph named by a `Value.Mir` answer from this store.
  pub fn mirAt(self: &Self, index: usize) -> Option<&MirFunction> {
    let functions = Vector.asSlice<MirFunction>(&self.resolver.mirValues)
    if index >= functions.length {
      return Option.none<&MirFunction>()
    }
    return Option.some<&MirFunction>(&functions[index])
  }
  /// Demands only reached instances, then joins their definitions in content-symbol order.
  pub effect fn buildMain(self: &mut Self, request: &mut Request, module: &ModuleId) -> BackendBuild
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    run selectRequest(&mut self.resolver, &request.*)
    let selected = run select(&mut self.resolver, module, b"main", false)
    if selected.count != usize.ONE || selected.kind != CandidateKind.Declaration {
      return BackendBuild.Rejected {
        diagnostic: run reject(&self.resolver, module, RejectionCode.UnknownName, selected.span),
      }
    }
    let declared = run declarationAt(&mut self.resolver, module, selected.declaration)
    let main = match move declared {
      Option<DeclarationId>.Some {value} => run Shared.make<DeclarationId>(move value)
      Option<DeclarationId>.None => {
        return BackendBuild.Rejected {
          diagnostic: run reject(&self.resolver, module, RejectionCode.UnknownName, selected.span),
        }
      }
    }
    let signature = run demandNamed(
      &mut self.resolver,
      &mut self.query,
      module,
      b"main",
      Family.Signature,
    )
    run recordRoot(&mut request.*, Family.Signature, module, b"main", &signature)
    let failure = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
      &signature,
      answerRejection,
    )
    if let Option<Shared<Rejection>>.Some {value} = move failure {
      let code = Shared.with<Rejection, RejectionCode>(&value, fn(rejection: &Rejection) -> RejectionCode {
        return rejection.code
      })
      if code == RejectionCode.MissingModule || code == RejectionCode.Unsupported {
        let span = Shared.with<Rejection, Span>(&value, fn(rejection: &Rejection) -> Span {
          return rejection.span
        })
        let mut gapCode = GapCode.ModuleSource
        if code == RejectionCode.Unsupported {
          gapCode = GapCode.SignatureForm
        }
        let mut gaps = Vector.make<Shared<BackendGap>>()
        run Vector.append<Shared<BackendGap>>(
          &mut gaps,
          run Shared.make<BackendGap>(BackendGap.make(gapCode, &main, span)),
        )
        return BackendBuild.Unsupported {gaps: move gaps}
      }
      return BackendBuild.Rejected {diagnostic: move value}
    }
    let mut pending = Vector.make<InstanceKey>()
    run Vector.append<InstanceKey>(&mut pending, InstanceKey.Entry {main: move main})
    let mut visited = Vector.make<InstanceKey>()
    let mut emitted = Vector.make<usize>()
    let mut gaps = Vector.make<Shared<BackendGap>>()
    while Vector.length<InstanceKey>(&pending) > usize.ZERO {
      let selected = Vector.pop<InstanceKey>(&mut pending)
      let instance = match move selected {
        Option<InstanceKey>.Some {value} => move value
        Option<InstanceKey>.None => {
          break
        }
      }
      let already = Vector.asSlice<InstanceKey>(&visited)
      let mut seen = false
      let mut at = usize.ZERO
      while at < already.length {
        if InstanceKey.equals(&already[at], &instance) {
          seen = true
          break
        }
        at = at + usize.ONE
      }
      if seen {
        continue
      }
      run Vector.append<InstanceKey>(&mut visited, InstanceKey.copy(&instance))
      let found = run locationOfInstance(&mut self.resolver, &instance)
      let location = match move found {
        Option<InstanceLocation>.Some {value} => value
        Option<InstanceLocation>.None => {
          let identity = InstanceKey.identity(&instance)
          run Vector.append<Shared<BackendGap>>(
            &mut gaps,
            run Shared.make<BackendGap>(
              BackendGap.make(GapCode.CalleeModule, &identity, Span.make(usize.ZERO, usize.ZERO)),
            ),
          )
          continue
        }
      }
      let mut member = usize.ZERO
      if InstanceKey.isEntry(&instance) {
        member = usize.MAX
      }
      let backendName = run internBackendInstance(&mut self.resolver, &instance)
      let key = Key {
        family: Family.Instance,
        module: location.module,
        name: backendName,
        declaration: location.declaration,
        member: member,
        external: false,
      }
      let answer = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        key,
        Span.make(usize.ZERO, usize.ZERO),
      )
      let rejected = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
        &answer,
        answerRejection,
      )
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return BackendBuild.Rejected {diagnostic: move value}
      }
      let gap = Shared.with<Result<Answer, NoRejection>, Option<Shared<BackendGap>>>(
        &answer,
        answerBackendGap,
      )
      if let Option<Shared<BackendGap>>.Some {value} = move gap {
        run Vector.append<Shared<BackendGap>>(&mut gaps, move value)
        continue
      }
      let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(
        &answer,
        answerInstanceIndex,
      )
      if let Option<usize>.Some {value} = move index {
        run Vector.append<usize>(&mut emitted, value)
      }
      let mir = run demandRaw(
        &mut self.resolver,
        &mut self.query,
        Key {
          family: Family.Mir,
          module: location.module,
          name: backendName,
          declaration: location.declaration,
          member: member,
          external: false,
        },
        Span.make(usize.ZERO, usize.ZERO),
      )
      let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, answerMirIndex)
      if let Option<usize>.Some {value: selectedMir} = move mirIndex {
        let functions = Vector.asSlice<MirFunction>(&self.resolver.mirValues)
        let references = Vector.asSlice<InstanceKey>(&functions[selectedMir].references)
        let mut edge = usize.ZERO
        while edge < references.length {
          run Vector.append<InstanceKey>(&mut pending, InstanceKey.copy(&references[edge]))
          edge = edge + usize.ONE
        }
      }
    }
    if Vector.length<Shared<BackendGap>>(&gaps) > usize.ZERO {
      return BackendBuild.Unsupported {gaps: move gaps}
    }
    let mut order = Vector.asMutSlice<usize>(&mut emitted)
    let symbols = Vector.asSlice<Bytes>(&self.resolver.instanceSymbols)
    let mut at = usize.ONE
    while at < order.length {
      let mut next = at
      while next > usize.ZERO && bytesLess(
        Bytes.asSlice(&symbols[order[next]]),
        Bytes.asSlice(&symbols[order[next - usize.ONE]]),
      ) {
        let prior = order[next - usize.ONE]
        order[next - usize.ONE] = order[next]
        order[next] = prior
        next = next - usize.ONE
      }
      at = at + usize.ONE
    }
    let mut text = run LlvmText.declarations()
    let pieces = Vector.asSlice<Bytes>(&self.resolver.instanceTexts)
    at = usize.ZERO
    while at < order.length {
      run Bytes.append(&mut text, Bytes.asSlice(&pieces[order[at]]))
      run Bytes.append(&mut text, b"\n")
      at = at + usize.ONE
    }
    return BackendBuild.Module {text: move text}
  }
}
