          module, cursor, pattern, patternSpan, &subjectType, Vector.asSlice<bool>(&covered))
        let checkedScalar = match move scalar {
          Result<CheckedScalarPattern, Shared<Rejection>>.Success {value} => value
          Result<CheckedScalarPattern, Shared<Rejection>>.Failure {error} => {
            return Result.failResult<BodyNodeId, Shared<Rejection>>(move error)
