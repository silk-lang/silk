/// A serial semantic store for one immutable in-memory revision.
///
/// # Details
///
/// Semantic rejections are completed answers. Provider failures leave a key available for retry.
/// This actor keeps query events and direct dependencies for later request replay.
pub struct Semantic {
  pub resolver: Resolver,
  pub query: Query<Answer, NoRejection>,
  pub deferredTemplates: List<DeferredStaticTemplate>,
  // The rejections the last `checkDeclarations` walk from the runtime's roots located in the runtime.
  pub runtimeRefused: List<Shared<Rejection>>,
  pub uncheckedRoot: List<UncheckedBody>,
  // The warnings the last build's declaration check found; they do not refuse the build.
  pub buildWarnings: List<Shared<Rejection>>,
  // The last completed sweep of each module and the last escape checks in a revisable store, by
  // their `ModuleCheck` units.
  pub moduleMemos: List<ModuleCheckMemo>,
  pub escapeMemos: List<EscapeMemo>,
  pub declarationMemos: List<DeclarationMemo>,
  // The memo of each declaration check unit, by unit.
  pub declarationSlots: List<usize>,
  pub pendingImage: Option<PendingImage>,
  // What `cacheImage` wrote for each replayed escape check that reports, for `imageReplayedChecks`.
  pub replayReports: List<ReplayReport>,
  // The module check units an unlinked cache adoption made current, which `cacheImage` leaves to
  // the image they came from, and the index of each one's root in that image.
  pub carriedUnits: List<usize>,
  pub carriedRoots: List<usize>,
  // The image the store adopted, which the image it writes next carries checks from.
  pub heldImage: Option<CacheImage.Image>,
  // The declaration check roots of the adopted image an unlinked store reused without reading
  // them yet, by the hash of their module's stable key, read when a sweep of their module runs
  // (`readPendingDeclarations`); `usize.MAX` once read.
  pub pendingLookup: InternIndex,
  pub pendingRoots: List<usize>,
  // How many module sweeps and escape checks this store ran rather than reused.
  pub checkRuns: usize,
  // The record of this store's last successful build walk, which `cacheImage` writes, and
  // whether it holds anything the image this store read does not.
  pub capturedBuild: Option<CapturedBuild>,
  pub freshBuild: bool,
  // The packs the last build's assembly described and reused.
  pub packedBuild: PackedBuild,
  // The build record an adoption read, until a build replays it (see `BuildRecord`).
  pub replay: Option<ReplayState>,
  // The build roots of the image an adoption read that the image `cacheImage` wrote last
  // carries over, by their index in that image.
  pub carriedBuild: List<usize>,
  // The escape walk records and green entries an unlinked adoption read, until a check replays or
  // replaces a record (see `replayEscapes`), and whether a replay lowered anything they lack.
  pub escapeImage: EscapeImage,
  pub freshEscapes: bool,
  // How many copies of the process a cold build's walk is shared between (`SharedWalk`), and how
  // many instances the walk enters before it starts them; fewer than two copies share nothing.
  pub walkWorkers: usize,
  pub walkFrontier: usize,
  // Whether this process is a copy a shared walk started, which ends with the walk.
  pub walkCopy: bool,
  // The last build when copies of the process lowered it: what `recordSharedBuild` walks again
  // for the record that build could not keep.
  pub unrecorded: Option<UnrecordedBuild>,
}

impl Semantic {
  /// Borrows the held resolver and query for a static demand outside a running provider.
  pub fn staticPort<'source>(self: &'source mut Self, dependencies: &'source mut List<Dependency>) -> StaticPort<
    'source,
  > {
    return StaticPort {
      resolver: &mut self.resolver,
      query: &mut self.query,
      dependencies: move dependencies,
    }
  }

  /// Frees every answer, body and table the store holds and leaves an empty store for the same
  /// target, for a build whose remaining work, such as the native compile and link, reads none of
  /// them.
  pub fn release(self: &mut Self) -> () {
    let target = self.resolver.baseTarget
    let spent = Intrinsic.replace(self.*, Semantic.oneShot(Revision.make(), target, Option<FinalProfile>.none()))
    drop spent
    return ()
  }

  /// Creates a lazy semantic store for one held revision and explicitly selected target.
  pub fn make(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(SourceIndex.make(move revision), target, move profile, false, true)
  }

  /// Creates a store that records source and query dependencies for a persistent cache.
  /// It retains no answer fingerprints for later in-process edits; calling [`update`] traps.
  /// Authored source observations are fingerprinted when [`cacheImage`] writes their evidence;
  /// request and package-resolution facts are captured when read.
  pub fn cached(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(SourceIndex.make(move revision), target, move profile, false, false)
  }

  /// Creates a store for a one-shot build whose revision holds the whole program.
  ///
  /// # Details
  ///
  /// It computes the same semantic results as [`make`] but records nothing for revision: no
  /// dependency ledger or graph and no emission content digests. Condition edges still publish
  /// a request's selected condition roots, and no completed answer is ever outdated.
  ///
  /// # Gotchas
  ///
  /// Revising a one-shot store traps.
  pub fn oneShot(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(SourceIndex.oneShot(move revision), target, move profile, false, false)
  }

  /// Opens a store that also records every query lifecycle event for `eventLog`.
  pub fn traced(revision: Revision, target: MachineTarget, profile: Option<FinalProfile>) -> Semantic {
    return openStore(SourceIndex.make(move revision), target, move profile, true, true)
  }

  /// Hands the store the units a driver parsed while loading the program, so each module's first
  /// demand reuses its parse when the bytes are the same.
  pub effect fn offerParsed(self: &mut Self, units: List<SourceUnit>) -> () ! OutOfMemoryError ? &mut Allocator {
    return run SourceIndex.offerParsed(&mut self.resolver.source, move units)
  }

  /// Whether a module whose syntax lowers to `hir`, indexed as `index`, declares a function with a
  /// foreign linkage or a static: the headers a check of foreign symbols reads. Without one, the
  /// module claims no symbol, and a loader that read its source can say so (`offerClaimFree`).
  pub fn claimsForeignSymbols(hir: &Module, index: &ModuleIndex) -> bool {
    return CheckAndEscapes.claimsForeignSymbols(hir, index)
  }

  /// Takes `modules`, whose current source the loader read, as declaring no foreign claim: a check
  /// of foreign symbols does not read them (see [`claimsForeignSymbols`]).
  /// Records whether a module the store's load read writes an erased type, as its summary or
  /// parse says, so the store closes erased member sets before it reads an erased dispatcher even
  /// when it reuses every answer that read that module.
  pub fn offerErasure(self: &mut Self, erased: bool) -> () {
    if erased { self.resolver.loadedErasure = true }
  }

  pub effect fn offerClaimFree(self: &mut Self, modules: &[ModuleId]) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut at = usize.ZERO
    while at < modules.length {
      let ordinal = run internModule(&mut self.resolver, &modules[at])
      while List<bool>.length(&self.resolver.claimFree) <= ordinal { run List<bool>.append(&mut self.resolver.claimFree, false) }
      List<bool>.set(&mut self.resolver.claimFree, ordinal, true)
      at = at + usize.ONE
    }
  }

  /// Selects the execution-storage component a build binds when a reached instance suspends.
  pub fn selectExecutionStorage(self: &mut Self, storage: ExecutionStorage) -> () {
    self.resolver.executionStorage = Option<ExecutionStorage>.some(move storage)
  }

  /// Installs the four source bindings selected for trace lowering.
  pub fn selectTraceDirective(self: &mut Self, hooks: TraceDirective) -> () {
    self.resolver.traceDirective = Option<TraceDirective>.some(move hooks)
  }

  /// Adds one of the target's support modules, such as the standard library's C library for a
  /// target without one, whose C exports an executable roots beside its runtime's, whatever that
  /// runtime is. Unless `hosted`, those exports are link symbols the module does not export.
  pub effect fn selectSupport(self: &mut Self, module: ModuleId, hosted: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    if !hosted { run List<ModuleId>.append(&mut self.resolver.linkOnlySupport, ModuleId.copy(&module)) }
    return run List<ModuleId>.append(&mut self.resolver.support, move module)
  }

  /// Selects the composition's explicit retention roots, which an artifact build keeps beside its
  /// exports (ARTIFACT-003).
  pub fn selectRetention(self: &mut Self, roots: List<RetentionRoot>) -> () {
    self.resolver.retention = move roots
  }

  /// Selects whether checked bodies keep the names they resolve, which an editor reads to answer
  /// hover and go to definition. A build leaves it off and keeps no table.
  pub fn selectEditorTables(self: &mut Self, enabled: bool) -> () {
    self.resolver.editorTables = enabled
  }

  /// Hands the store the reporter that checking and emission advance; `takeProgress` returns it.
  pub fn selectProgress(self: &mut Self, progress: Progress) -> () {
    self.resolver.progress = move progress
  }

  /// Checks every lowered MIR function for uses after drop before it is stored, panicking with a
  /// compiler bug on one. Call it before the first demand, so every MIR answer records the same
  /// dependencies.
  pub fn selectMirVerification(self: &mut Self) -> () {
    self.resolver.verifyMir = true
  }

  /// Returns the reporter `selectProgress` handed over, leaving an off one in its place.
  pub fn takeProgress(self: &mut Self) -> Progress {
    return Intrinsic.replace(self.resolver.progress, Progress.off())
  }

  /// Selects the discovery root of a test build: its tests and their package-relative paths
  /// below `directory`, such as `src`, answer `Intrinsic.tests()` (TEST-003). Without a selection
  /// test discovery is a static-phase rejection.
  /// Selects the package graph of a build that spans several packages (PACKAGE-002). Without a
  /// selection every import path names a module of its importer's own package.
  pub fn selectPackages(self: &mut Self, packages: PackageGraph) -> () {
    self.resolver.packages = move packages
  }

  pub fn selectDiscovery(self: &mut Self, root: ModuleId, directory: Bytes) -> () {
    self.resolver.discovery = Option<Discovery>.some(Discovery {root: move root, directory: move directory,
      exports: List<ModuleId>.make()})
  }

  /// Adds the package's exported modules to the selected discovery root, so their tests are
  /// discovered even when the root imports none of them (TEST-003).
  pub fn selectDiscoveryExports(self: &mut Self, exports: List<ModuleId>) -> () {
    match &mut self.resolver.discovery {
      Option<Discovery>.Some {value} => { value.exports = move exports }
      Option<Discovery>.None => { drop exports }
    }
  }

  /// The identities of a catalog's tests, in catalog order: what the runner's catalog digest binds.
  pub effect fn testIdentities(catalog: &Shared<TestCatalog>) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let count = Shared<TestCatalog>.with<usize>(catalog, |held: &TestCatalog| -> usize { return List<TestEntry>.length(&held.entries) })
    let mut identities = List<Bytes>.make()
    let mut ordinal = usize.ZERO
    while ordinal < count {
      run List<Bytes>.append(&mut identities, run entryIdentity(catalog, ordinal))
      ordinal = ordinal + usize.ONE
    }
    return move identities
  }

  /// The selected discovery root's test catalog, in catalog order, or the rejection that stopped
  /// discovery, such as an invalid test declaration (TEST-001).
  pub effect fn demandTests(self: &mut Self, request: &mut Request) -> Result<Shared<TestCatalog>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run demandCatalog(&mut self.*, &mut request.*, false)
  }

  /// The selected discovery root's benchmark catalog, in catalog order, or the rejection that
  /// stopped discovery, such as an invalid benchmark declaration (BENCH-001).
  pub effect fn demandBenchmarks(self: &mut Self, request: &mut Request) -> Result<Shared<TestCatalog>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run demandCatalog(&mut self.*, &mut request.*, true)
  }

  /// Updates this revisable store to `revision`.
  ///
  /// # Details
  ///
  /// Before any key/cache/location access, all pending observed modules are reconciled.
  /// Surviving identities retain handles; intermediate deletion or absence ends them.
  /// Changed consumed source inputs and raw source readers invalidate their result dependers.
  /// Publication reserves history before mutation; failed reconciliation remains retryable.
  pub effect fn update(self: &mut Self, revision: Revision) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run QueryEngine.update(&mut self.*, move revision)
  }

  /// Reports whether a completed root of `request` demanded a fact of `family` in `module`, itself
  /// or through any unit it consumed. Only a revisable store records what its units consumed.
  pub fn requestDemanded(self: &mut Self, request: &Request, family: Family, module: &ModuleId) -> bool {
    return QueryEngine.requestDemanded(&mut self.*, request, family, module)
  }

  /// The exact hash of a completed answer, absent when the answer has a part with no exact
  /// encoding. Equal answers hash equal in every store and revision.
  pub fn fingerprint(answer: &Answer) -> Option<ContentHash> {
    return answerFingerprint(answer)
  }

  /// How many module sweeps and escape checks this store ran rather than reused, so a caller can
  /// tell whether the cache image it read still holds everything this store would write.
  pub fn moduleCheckRuns(self: &Self) -> usize {
    return self.checkRuns
  }

  /// The roots of the image an unlinked `adoptCache` read that this store still holds as they
  /// were: they rest on nothing here, so the image this store writes next carries them over
  /// (`CacheImage.carry`).
  pub fn carried(self: &Self) -> &[usize] {
    return List<usize>.asSlice(&self.carriedRoots)
  }

  /// The build roots of the image an adoption read that the image `cacheImage` wrote last
  /// carries over (`CacheImage.carry`): the definitions a replayed build took from that image,
  /// and the inline summary roots they reach, whose fingerprints a later adoption compares.
  pub fn carriedDefinitions(self: &Self) -> &[usize] {
    return List<usize>.asSlice(&self.carriedBuild)
  }

  /// DEBUG
  // DEBUG
  /// Whether the last build walked or replayed anything the image this store read does not hold.
  pub fn buildChanged(self: &Self) -> bool {
    return self.freshBuild || self.freshEscapes
  }

  /// Logs the store's query work since the last call for the trace: the demand counters, the runs
  /// and time of each query family, and of the queries about each module's declarations that
  /// took a millisecond or more of their own. Does nothing when the process is not traced.
  pub effect fn traceQueries(self: &Self) -> () ! OutOfMemoryError ? &mut Allocator {
    run QueryEngine.traceQueries(self)
  }

  /// Copies the store's demand counters, and its graph's when it records dependencies.
  pub fn statistics(self: &Self) -> Statistics {
    let mut graph = Option<GraphCounters>.none()
    if Graph.recording(&self.resolver.graph) {
      graph = Option<GraphCounters>.some(Graph.counters(&self.resolver.graph))
    }
    return Statistics {demands: self.resolver.demands, hits: self.resolver.hits, runs: self.resolver.runs,
      answers: Query<Answer, NoRejection>.length(&self.query),
      mirFunctions: List<MirFunction>.length(&self.resolver.mirValues) - self.resolver.mirReleasedCount,
      graph: move graph}
  }

  /// Empties every lowered MIR function that no completed answer of the store or root of
  /// `request` names, with the helpers lowered after it, and returns how many it emptied. A unit
  /// that reruns lowers its function again, so the old one is garbage once nothing names it. An
  /// answer held anywhere else must not be read for its MIR afterwards.
  pub effect fn releaseStaleMir(self: &mut Self, request: &Request) -> usize ! OutOfMemoryError ? &mut Allocator {
    return run QueryEngine.releaseStaleMir(&mut self.*, request)
  }

  /// Reports whether the unit that completed `answer` read the source of `module`, itself or
  /// through any unit it consumed. Only a revisable store records what its units read.
  pub fn answerRead(self: &mut Self, answer: &Shared<Result<Answer, NoRejection>>, module: &ModuleId) -> bool {
    let ordinal = knownModuleOrdinal(&self.resolver, module)
    let unit = rootUnit(&mut self.*, answer)
    if ordinal == usize.MAX || unit == usize.MAX {
      return false
    }
    Graph.beginTraversal(&mut self.resolver.graph)
    return reachesSource(&mut self.resolver, unit, ordinal)
  }

  /// Counts the modules whose source the unit that completed `answer` read, itself or through any
  /// unit it consumed. Only a revisable store records what its units read.
  pub fn sourcesRead(self: &mut Self, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
    return QueryEngine.sourcesRead(&mut self.*, answer)
  }

  /// Reports whether a completed root of `request` read a module that is present, itself or through
  /// any unit it consumed. An absent module is not discovered. Only a revisable store records what
  /// its units read; a root that is no unit reads only its own module.
  pub fn requestDiscovered(self: &mut Self, request: &Request, module: &ModuleId) -> bool {
    return QueryEngine.requestDiscovered(&mut self.*, request, module)
  }

  /// Freezes one assembly's facts before any registered source default is demanded.
  /// A semantic store accepts only the facts for which its target and cached answers were opened.
  pub effect fn bindAssemblyFacts(self: &mut Self, facts: &InitialProfile) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    return run QueryEngine.bindAssemblyFacts(&mut self.*, facts)
  }

  /// Opens one fresh effective-default graph. The caller closes it through a release provider.
  pub fn beginParameterAssembly(self: &mut Self, parameters: List<DeclarationId>, bindings: List<ProfileEntry>) -> usize {
    let previous = self.resolver.profileSlot
    self.resolver.nextAssembly = self.resolver.nextAssembly + usize.ONE
    self.resolver.profileSlot = usize.MAX - self.resolver.nextAssembly
    self.resolver.parameterAssembly = Option<ParameterAssembly>.some(ParameterAssembly {
      parameters: move parameters, bindings: move bindings,
    })
    return previous
  }

  /// Restores the previous complete-profile scope after success, rejection, or cancellation.
  pub fn endParameterAssembly(self: &mut Self, previous: usize) -> () {
    self.resolver.parameterAssembly = Option<ParameterAssembly>.none()
    self.resolver.profileSlot = previous
    return ()
  }

  /// Replaces effective bindings with the complete map before any final predicates execute.
  pub fn selectAssemblyValues(self: &mut Self, values: List<ProfileEntry>) -> () {
    if let Option<ParameterAssembly>.Some {value} = &mut self.resolver.parameterAssembly {
      replaceAssemblyValues(&mut value, move values)
    }
    return ()
  }

  /// Evaluates the written predicate at bool against the current complete assembly map.
  /// A package parameter problem found while assembling the profile (SEM0214), reported at the
  /// parameter's declaration: `before`, the parameter's name, then `after`.
  pub effect fn parameterProblem(self: &mut Self, identity: &DeclarationId, before: &[u8], after: &[u8]) -> Shared<Rejection>
  ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.parameterProblem(&mut self.*, identity, before, after)
  }

  pub effect fn validateParameter(self: &mut Self, request: &mut Request, identity: &DeclarationId) -> Result<(), Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.validateParameter(&mut self.*, &mut request.*, identity)
  }

  /// Borrows the current request's profile, including its current value origins.
  pub fn profile<'a>(self: &'a Self) -> Option<&'a FinalProfile> {
    return selectedProfile(&self.resolver)
  }

  /// Selects a complete profile by structural content; equal values reuse the same query scope.
  pub effect fn reviseProfile(self: &mut Self, profile: Option<FinalProfile>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run QueryEngine.reviseProfile(&mut self.*, move profile)
  }

  /// Borrows the semantic query lifecycle events in demand order; empty unless the store is traced.
  pub fn eventLog(self: &Self) -> &[Event] {
    return List<Event>.asSlice(&self.resolver.events)
  }

  /// Starts or stops recording query lifecycle events, and forgets those already recorded.
  pub fn trace(self: &mut Self, on: bool) -> () {
    self.resolver.tracing = on
    List<Event>.truncate(&mut self.resolver.events, usize.ZERO)
    List<StaleCause>.truncate(&mut self.resolver.staleCauses, usize.ZERO)
  }

  /// Why each outdated unit a traced store reran failed verification, in order.
  pub fn staleCauses(self: &Self) -> &[StaleCause] {
    return List<StaleCause>.asSlice(&self.resolver.staleCauses)
  }

  /// A dependee as a traced replay reports it: a unit's name, or a source input's module and selector.
  pub effect fn dependeeName(self: &mut Self, dependee: Dependee) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run QueryEngine.dependeeName(&mut self.*, dependee)
  }

  /// A unit's family and, for a declaration family, the declaration's name: `Body foo.bar`.
  pub effect fn unitName(self: &mut Self, unit: usize) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
    let selected = List<ScopedKey>.get(&self.resolver.keys, unit).key
    let mut name = run Bytes.copy(String.utf8Bytes(familyName(selected.family)))
    let subject = run zoneSubject(&mut self.resolver, selected)
    if Bytes.length(&subject) > usize.ZERO {
      run Bytes.append(&mut name, b" ")
      run Bytes.append(&mut name, Bytes.asSlice(&subject))
    }
    return move name
  }

  /// Borrows the source index provider starts, source reads and completions in demand order.
  pub fn sourceEvents(self: &Self) -> &[SourceEvent] {
    return SourceIndex.eventLog(&self.resolver.source)
  }

  /// The stable bytes of every current unit whose key has a stable form, in unit order: what a
  /// cache written to disk names a unit by, equal in every store that holds the same unit.
  pub effect fn stableUnits(self: &Self) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    return run QueryEngine.stableUnits(self)
  }

  /// The stable bytes of every source input this store captured, in capture order.
  pub effect fn stableInputs(self: &Self) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
    return run QueryEngine.stableInputs(self)
  }

  /// The source input of this store that stable bytes from [`stableInputs`] name, possibly written
  /// by another store, or `usize.MAX` when this store has not captured it.
  pub effect fn findStableInput(self: &mut Self, bytes: &[u8]) -> usize ! Cycle | OutOfMemoryError ? &mut Allocator {
    return match move run placeStableInput(&mut self.resolver, bytes, false, usize.MAX) {
      Option<PlacedInput>.Some {value} => Inputs.find(&self.resolver.sourceInputs, value.module, &value.selector)
      Option<PlacedInput>.None => usize.MAX
    }
  }

  /// Reuses what a cache image from an earlier process still holds. Each leaf is compared with the
  /// current sources, and each node whose leaves all read the same becomes a unit of this store,
  /// current, with the same edges, so a later revision invalidates it as it would a unit this store
  /// ran. Each root resting on such a node becomes its module check's memo, so checking that
  /// module verifies it instead of sweeping it again.
  ///
  /// # Details
  /// An adopted node has no answer and cannot rerun: when an edit makes one outdated, the module
  /// check resting on it sweeps again. Call this once, on a fresh store, after its request and
  /// profile are selected, since a root is reused only when its key under them is the key it was
  /// written with.
  ///
  /// A store that is never revised passes `linked` false: its reused checks then rest on nothing,
  /// and no node becomes a unit, which spares recording the image's edges again.
  pub effect fn adoptCache(self: &mut Self, request: &Request, image: &CacheImage.Image, linked: bool) -> Adopted
    ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run Semantic.adoptImage(&mut self.*, request, run CacheImage.copy(image), linked)
  }

  /// As [`adoptCache`], keeping `image`, which [`adoptedImage`] gives back for the image this
  /// store writes next to carry its reused checks from.
  pub effect fn adoptImage(self: &mut Self, request: &Request, image: CacheImage.Image, linked: bool) -> Adopted
    ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run CacheAdoption.adoptImage(&mut self.*, request, move image, linked)
  }

  /// Reads the leaves and nodes of the image the store adopted, then expands their keys, so a
  /// carry can copy its leaves and nodes (`CacheImage.readLeaves`, `CacheImage.readNodes`,
  /// `CacheImage.expandKeys`). An image whose leaves or nodes do not read is let go, and nothing is
  /// carried from it.
  pub effect fn unpackAdoptedImage(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut read = true
    if let Option<CacheImage.Image>.Some {value: image} = &mut self.heldImage {
      read = run CacheImage.readLeaves(&mut image)
      if read { read = run CacheImage.readNodes(&mut image) }
      if read { run CacheImage.expandKeys(&mut image) }
    }
    if !read { self.heldImage = Option<CacheImage.Image>.none() }
  }

  /// The image the store adopted ([`adoptImage`]), if any.
  pub fn adoptedImage<'a>(self: &'a Self) -> Option<&'a CacheImage.Image> {
    return match &self.heldImage {
      Option<CacheImage.Image>.Some {value} => Option<&CacheImage.Image>.some(&value)
      Option<CacheImage.Image>.None => Option<&CacheImage.Image>.none()
    }
  }

  /// Releases the cache image the store adopted, if any, freeing its decoded leaves, keys, nodes
  /// and roots once nothing further will read or carry from it.
  pub fn releaseAdoptedImage(self: &mut Self) -> () {
    self.heldImage = Option<CacheImage.Image>.none()
  }

  /// Identifies a standalone declaration check or build before its cache opens. An unchanged
  /// check or build can reuse its erasure membership snapshots and check-scope discovery proofs
  /// once the image's ordinary source and request anchors agree.
  pub effect fn selectCheckImage(self: &mut Self, application: &ModuleId, runtime: &Option<ModuleId>, checked: &[ModuleId],
    rootPackage: &[ModuleId]) -> () ! OutOfMemoryError ? &mut Allocator {
    run CacheAdoption.selectCheckImage(&mut self.*, application, runtime, checked, rootPackage)
  }

  /// What decides this store's answers besides its sources, for a cache stamp: the target and,
  /// when one is selected, the profile's identity.
  pub effect fn stampIdentity(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut output = run Semantic.stampTarget(self)
    if let Option<&FinalProfile>.Some {value} = move selectedProfile(&self.resolver) {
      run RuntimeEncoding.field(&mut output, b"profile")
      run FinalProfile.appendIdentity(value, &mut output)
    } else {
      run RuntimeEncoding.field(&mut output, b"no-profile")
    }
    return move output
  }

  /// The part of [`stampIdentity`] that names the target, which it leads with. A check root of an
  /// image written under another profile reads every profile fact it rests on as a source input,
  /// so a store of the same compiler and target reuses it whatever the profile (`checkRoots`).
  pub effect fn stampTarget(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut output = Bytes.make()
    run RuntimeEncoding.field(&mut output, MachineTarget.name(&self.resolver.target))
    return move output
  }

  /// The roots of `image` that hold module checks and escape walks, which rest only on sources and
  /// the source inputs they record, not its build records, definitions or packs, which also rest
  /// on the profile that wrote them.
  pub effect fn checkRoots(image: &CacheImage.Image) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    return run rootsOfKinds(image, true)
  }

  /// The roots of `image` that hold escape walks: each walk's record and the entries it reached,
  /// which a check that walks the same module again rewalks from (`rewalkEscapes`).
  pub effect fn escapeRoots(image: &CacheImage.Image) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    return run rootsOfKinds(image, false)
  }

  /// The roots of `image` a build replays from: its build record, the definitions and packs it
  /// names, and the inline summaries.
  pub effect fn buildRoots(image: &CacheImage.Image) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    return run CacheAdoption.buildRoots(image)
  }

  /// Whether `image` holds a build record.
  pub fn holdsBuildRecord(image: &CacheImage.Image) -> bool {
    let roots = List<CacheImage.Root>.asSlice(&image.roots)
    let mut at = usize.ZERO
    while at < roots.length {
      let mut exact = Span.make(usize.ZERO, usize.ZERO)
      if buildRootKind(Bytes.asSlice(&roots[at].key), &mut exact) == 1 { return true }
      at = at + usize.ONE
    }
    return false
  }

  /// The image of this store's module checks for a cache on disk: each current module sweep and
  /// escape check, as a root, with every unit and source read it rests on and the rejections it
  /// reports, which also rest on the files their spans point into. A check that left a gap or an
  /// unchecked body, or reported what an image does not carry (`RejectionImage.encode`), is left
  /// out and runs again in the next process. So is a check an unlinked `adoptCache` reused: it
  /// rests on nothing here, and its image carries it (`CacheImage.carry` with `Adopted.carried`).
  pub effect fn cacheImage(self: &mut Self) -> CacheImage.Image ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run CacheAdoption.cacheImage(&mut self.*)
  }

  /// Adds to `image`, once `CacheImage.carry` has copied into it what this store reused and given
  /// `nodes`, the node of each check in `carried` order, the checks `cacheImage` could not write
  /// because they rest on a reused check: such a check rests on that check's carried node, so a
  /// module swept again after an edit keeps its root although it reused its other declarations.
  pub effect fn imageCarriedChecks(self: &mut Self, image: &mut CacheImage.Image, nodes: &[usize]) -> ()
    ! Cycle | OutOfMemoryError ? &mut Allocator {
    run CacheAdoption.imageCarriedChecks(&mut self.*, &mut image.*, nodes)
  }

  /// Adds to `image`, once `CacheImage.carry` has copied into it what this store reused, the root of
  /// each escape check a replay made current (`replayEscapes`). The root rests on the walk's record
  /// and on the root of every entry the record names, so it stays green while a replay would
  /// agree again, and the next check takes it without replaying. The root of a replay that reports
  /// rests instead on the root of each entry the replay entered or kept, and on what it demanded
  /// and the files its reports point into, which `cacheImage` wrote: a broken body that lowers to
  /// nothing has no entry root, but its MIR is among what the replay demanded. A check whose
  /// record or entries `image` lacks is left out, and replays again.
  pub effect fn imageReplayedChecks(self: &Self, image: &mut CacheImage.Image) -> () ! OutOfMemoryError ? &mut Allocator {
    run CacheAdoption.imageReplayedChecks(self, &mut image.*)
  }

  /// Points each input `image` carries at its module's file as it reads now, once `CacheImage.carry`
  /// has copied into it what this store reused. A carried input names the file leaf of the image it
  /// came from. When that file changed since and this store holds the input with the same digest,
  /// the input takes its declaration's position now and the file leaf of the bytes now, so the next
  /// adoption places it without indexing the module again. Otherwise it keeps its old file, which
  /// no longer reads the same, and the next adoption captures it again.
  pub effect fn imageCarriedFiles(self: &mut Self, image: &mut CacheImage.Image) -> () ! Cycle | OutOfMemoryError ? &mut Allocator {
    run CacheAdoption.imageCarriedFiles(&mut self.*, &mut image.*)
  }

  /// How many emitted LLVM input subjects carry a content digest. A revisable store names every
  /// subject by its digest so a revision can re-find equal content; a one-shot store names none.
  pub fn digestedLlvmInputs(self: &Self) -> usize {
    return EmissionAndAssembly.digestedLlvmInputs(self)
  }

  /// Whether copies of the process lowered the last build (`shareWalks`) and its record has not
  /// been walked for yet (`recordSharedBuild`), so `cacheImage` would write no record of it.
  pub fn sharedBuildUnrecorded(self: &Self) -> bool {
    return match &self.unrecorded {
      Option<UnrecordedBuild>.Some {..} => true
      Option<UnrecordedBuild>.None => false
    }
  }

  /// Walks the last build again in this process when copies of the process lowered it
  /// (`shareWalks`), so the store holds the build's record and every unit it rests on, as a build
  /// that shared nothing does, and `cacheImage` writes them. It lowers each instance a copy
  /// lowered, which the shared build saved the caller from waiting for; a cache writer that runs
  /// after the build returned calls it. Does nothing after any other build, and leaves the store
  /// without a record when the walk fails where the build did not.
  pub effect fn recordSharedBuild(self: &mut Self) -> ()
  ! Cycle | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    run EmissionAndAssembly.recordSharedBuild(&mut self.*)
  }

  /// Shares the walk of each later cold `buildArtifact` between `workers` copies of the process,
  /// the calling one among them, started once the walk has entered `frontier` instances. The
  /// copies lower the instances side by side, and the build emits what one process would. Fewer
  /// than two workers, the default, share nothing, and so does a build that replays a record.
  ///
  /// # Gotchas
  /// Set it only where the process has one thread and may start copies of itself: a copy has no
  /// other thread, and exits once its part of the walk is done.
  pub fn shareWalks(self: &mut Self, workers: usize, frontier: usize) -> () {
    self.walkWorkers = workers
    self.walkFrontier = frontier
  }

  /// The syntax errors of every source this store has loaded, as rejections in load order and
  /// then source order. A loaded module is parsed whole, so its syntax errors reject the program
  /// even where no declaration of it is demanded (MODULE-004).
  @trace(name: "check.syntax")
  pub effect fn syntaxRejections(self: &Self) -> List<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
    return run CheckAndEscapes.syntaxRejections(self)
  }

  /// Checks every active declaration loaded from the root package, independently of emission
  /// reachability (MODULE-004). The source provider supplies the exact ownership list; imports
  /// still demand their normal semantic facts but do not enroll dependency modules in the sweep.
  /// Abstract templates retain their obligations until a complete application exists.
  pub effect fn checkDeclarations(
    self: &mut Self,
    request: &mut Request,
    rootPackage: &[ModuleId],
    runtime: &Option<ModuleId>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run checkModules(&mut self.*, &mut request.*, rootPackage, runtime, true)
  }

  /// Checks every active declaration loaded from the root package as the source writes it, like
  /// `checkDeclarations`, but walks into no instance: no concrete application of a generic, static
  /// or provider-taking function is selected or lowered, so what only such an instance refuses is
  /// not reported. `buildArtifact` runs this before its own walk, which lowers and checks exactly
  /// the instances its artifact reaches. An instance no root of the artifact reaches is therefore
  /// left to `checkDeclarations`.
  pub effect fn checkWrittenDeclarations(
    self: &mut Self,
    request: &mut Request,
    rootPackage: &[ModuleId],
    runtime: &Option<ModuleId>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run checkModules(&mut self.*, &mut request.*, rootPackage, runtime, false)
  }

  /// Checks the declarations of the selected `runtime` module alone, as `silk check` runs it to
  /// report what the runtime refuses of the application's `main`: a missing, private or ill-shaped
  /// `main` is refused where the runtime's own bodies name and start it. Nothing is walked from
  /// those bodies here. `checkDeclarations` walks from the runtime's roots into the runtime, the
  /// toolchain bodies that start `main`, the entry module and instances with static arguments,
  /// and keeps what that walk refuses inside the runtime as `runtimeRefusals`, so this check's
  /// cost does not grow with what an open `main` reaches.
  @trace(name: "check.runtime")
  pub effect fn checkRuntime(self: &mut Self, request: &mut Request, runtime: &ModuleId)
  -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.checkRuntime(&mut self.*, &mut request.*, runtime)
  }

  /// Selects whether `buildArtifact` also splits its module into codegen units
  /// (`BackendBuild.Module.units`), so the driver can compile and cache each unit's object apart.
  pub fn selectPackageCodegen(self: &mut Self, packages: List<PackageSettings>, debug: bool) -> () {
    self.resolver.packageCodegen = move packages
    self.resolver.programDebug = debug
  }

  pub fn selectCodegenUnits(self: &mut Self, split: bool) -> () {
    self.resolver.codegenUnits = split
  }

  /// Selects whether lowering inlines callees into their callers before code generation, as an
  /// optimized build does: a build for the direct backend inlines small callees, and an LLVM
  /// build only the calls of suspendable frames that LLVM inlines too late. A build with line
  /// tables inlines nothing whatever this says.
  /// The cache keeps one image per profile, so MIR lowered under one choice is never adopted under
  /// the other.
  pub fn selectInlining(self: &mut Self, inlining: bool) -> () {
    self.resolver.inlining = inlining
  }

  /// Selects whether a direct build's walk empties each spliced copy it emitted down to what the
  /// later whole-program checks read (`MirInline.residue`). Such copies hold most of the MIR an
  /// optimized build lowers, and only the walk reads them after their code is written. A build
  /// that lists or inspects its MIR afterwards, such as `silk dump mir`, keeps them whole.
  pub fn selectTrimmedEmission(self: &mut Self, trims: bool) -> () {
    self.resolver.trimsEmitted = trims
  }

  /// Selects whether emitted LLVM text is shaped for Clang's unoptimized `-O0` compile, whose fast
  /// instruction selector it then stays on, and whether the run sites of one lowered function
  /// share the slot they catch each failure type in, which only a frame without stack coloring
  /// gains from. The cache keeps one image per profile, so text emitted under one choice is never
  /// adopted under the other.
  pub fn selectFastPathIr(self: &mut Self, unoptimized: bool) -> () {
    self.resolver.fastPathIr = unoptimized
  }

  /// Selects whether each emitted function records that it ran, for a test runner build: its
  /// entry sets the flag of its own record in the table of executed functions, which holds its
  /// content digest (`LlvmCode.seenRecord`). A build that records no content digests, such as a
  /// one-shot build, gives every record a zero digest. The content digest covers the choice, so
  /// code emitted under one choice is never adopted under the other.
  pub fn selectCoverage(self: &mut Self, coverage: bool) -> () {
    self.resolver.coverage = coverage
  }

  /// Selects whether instances lower to wasm fragments for the direct backend (`WasmLower`)
  /// instead of LLVM text, whether that module's memory is shared between threads (`threads`),
  /// and whether a build that is not unoptimized (`selectFastPathIr`) optimizes them for size
  /// (`size`) rather than speed (`SsaPipeline.Level`). The cache keeps one image per profile, as
  /// for `selectFastPathIr`.
  pub fn selectDirect(self: &mut Self, direct: bool, threads: bool, size: bool) -> () {
    self.resolver.direct = direct
    self.resolver.threads = direct && threads
    self.resolver.directSize = direct && size
  }

  /// Selects whether lowered functions carry the line and column of each position their location
  /// markers name (`MirFunction.lines`), which a debug build's line tables are made from. Only
  /// such a build pays for them. A function's lines are counted from its declaration's first
  /// token, so its content changes when a line inside the declaration moves and not when the
  /// declaration does; the assembled plan says where each declaration starts
  /// (`EmissionPlan.identityOrigin`).
  pub fn selectLineTables(self: &mut Self, lines: bool) -> () {
    self.resolver.lineTables = lines
  }

  /// Selects whether each build walk charges every function instance it lowers to the call in the
  /// root package that led to it, for [`costReport`]. Select it before the build, without sharing
  /// the walk between copies of the process (`shareWalks`) and without a cache, whose answers and
  /// record would leave instances unlowered.
  pub fn selectCosts(self: &mut Self, costs: bool) -> () {
    self.resolver.costs.enabled = costs
  }

  /// The calls the last build walk charged (`selectCosts`), in the order it first charged them.
  pub fn costSites(self: &Self) -> &[CostSite] {
    return CostTable.charged(&self.resolver.costs)
  }

  /// The `--costs` report of the last build walk: the `limit` calls in the root package whose
  /// generated functions cost the most, by LLVM text, then functions, then static evaluation steps,
  /// one row each, and a line of totals. Each row names its call's module as `prefix` and the
  /// module's path, as `src/` and `main.silk`. Empty unless [`selectCosts`] chose it and the walk
  /// lowered a function.
  pub effect fn costReport(self: &mut Self, limit: usize, prefix: &[u8]) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run EmissionAndAssembly.costReport(&mut self.*, limit, prefix)
  }

  /// Offers the declaration origins a cache kept from an earlier build (`takeOrigins`), before a
  /// build with line tables. A module whose bytes read as they did then is asked about without
  /// being parsed. Bytes that are not origins offer nothing.
  pub effect fn offerOrigins(self: &mut Self, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.resolver.declarationOrigins = run Origins.decode(bytes)
    return ()
  }

  /// The declaration origins for a cache to keep, when a build made or replaced a module's since
  /// `offerOrigins`; none when what the cache holds still reads the same.
  pub effect fn takeOrigins(self: &Self) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    if !Origins.changed(&self.resolver.declarationOrigins) { return Option<Bytes>.none() }
    return Option<Bytes>.some(run Origins.encode(&self.resolver.declarationOrigins))
  }

  /// Offers the pack bodies a cache keeps beside its image, before `adoptCache` reads the image,
  /// and has each assembled module split into packs (`BackendBuild.Module.units`) for the cache to
  /// store. A replay takes the text of a definition the image holds from its pack.
  /// Says that the build record of the image adopted last is another program's: the build of a
  /// sibling package that loads many of the packages this one does. A build then walks from that
  /// record instead of replaying it, taking each definition the record holds that this program
  /// reaches too and lowering the rest (`rewalkBuild`).
  pub fn borrowBuildRecord(self: &mut Self) -> () {
    if let Option<ReplayState>.Some {value: state} = &mut self.replay { state.borrowed = true }
  }

  pub fn offerPacks(self: &mut Self, bodies: List<BuildRecord.PackBody>) -> () {
    self.resolver.offeredBodies = move bodies
    self.resolver.packing = true
  }

  /// The body of the pack named `digest` among those `offerPacks` gave, as a build that left a unit
  /// `stored` holds it; none when the store holds no such body.
  pub fn packBody(self: &Self, digest: ContentHash) -> Option<&[u8]> {
    let offered = List<BuildRecord.PackBody>.asSlice(&self.resolver.offeredBodies)
    let mut at = usize.ZERO
    while at < offered.length {
      if ContentHash.equals(offered[at].digest, digest) { return Option<&[u8]>.some(Bytes.asSlice(&offered[at].bytes)) }
      at = at + usize.ONE
    }
    let held = List<HeldPack>.asSlice(&self.resolver.packs)
    at = usize.ZERO
    while at < held.length {
      if ContentHash.equals(held[at].pack.digest, digest) { return Option<&[u8]>.some(Bytes.asSlice(&held[at].body)) }
      at = at + usize.ONE
    }
    return Option<&[u8]>.none()
  }

  /// Takes back every pack body `offerPacks` gave, including those of the units a build left
  /// `stored`.
  @trace(name: "codegen.packs")
  pub effect fn takePacks(self: &mut Self) -> List<BuildRecord.PackBody> ! OutOfMemoryError ? &mut Allocator {
    let mut bodies = Intrinsic.replace(self.resolver.offeredBodies, List<BuildRecord.PackBody>.make())
    let mut held = Intrinsic.replace(self.resolver.packs, List<HeldPack>.make())
    while List<HeldPack>.length(&held) > usize.ZERO {
      let last = List<HeldPack>.length(&held) - usize.ONE
      let taken = List<HeldPack>.remove(&mut held, last)
      run List<BuildRecord.PackBody>.append(&mut bodies, BuildRecord.PackBody {digest: taken.pack.digest, bytes: move taken.body})
    }
    return move bodies
  }

  /// The rejections `checkDeclarations` would report from one escape walk over every concrete body
  /// of `rootPackage`, instead of each module's own walk, which stops at the plain bodies of the
  /// package's other modules. `silk check --roots` compares the two; nothing is kept.
  pub effect fn wholePackageCheck(
    self: &mut Self,
    request: &mut Request,
    rootPackage: &[ModuleId],
    runtime: &Option<ModuleId>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.wholePackageCheck(&mut self.*, &mut request.*, rootPackage, runtime)
  }

  /// Checks one module of the root package as `checkDeclarations` checks each of its modules: its
  /// name collisions, each active declaration as `checkDeclaration` does, its foreign symbol
  /// claims and the escapes of its concrete bodies. Over a package's modules, these results and
  /// `checkForeignConflicts` hold exactly the rejections `checkDeclarations` reports, so an edit
  /// to one module refreshes that module's entry alone.
  ///
  /// Like `checkDeclarations`, it replaces `deferredStaticTemplates` and `uncheckedRootBodies`
  /// with what this check found.
  pub effect fn checkModule(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    runtime: &Option<ModuleId>,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.checkModule(&mut self.*, &mut request.*, module, runtime)
  }

  /// Checks one active declaration: the facets its kind declares, its body, and the escapes of
  /// that body. Name collisions and foreign symbol claims belong to its module's check, so a body
  /// edit reruns no more than this declaration's own units. An inactive declaration, or one its
  /// module no longer holds, reports nothing.
  ///
  /// Like `checkDeclarations`, it replaces `deferredStaticTemplates` and `uncheckedRootBodies`
  /// with what this check found.
  pub effect fn checkDeclaration(
    self: &mut Self,
    request: &mut Request,
    declaration: &DeclarationId,
  ) -> DeclarationCheckResult
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.checkDeclaration(&mut self.*, &mut request.*, declaration)
  }

  /// Whether `module`'s kept sweep reflects the current revision, verifying it when it is
  /// outdated, so `checkModule` would reuse it rather than sweep the module again. Only a
  /// revisable store keeps sweeps.
  pub effect fn moduleSweepCurrent(self: &mut Self, module: &ModuleId) -> bool
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.moduleSweepCurrent(&mut self.*, module)
  }

  /// The declarations a check of `module` sweeps, in the order it sweeps them.
  pub effect fn moduleDeclarations(self: &mut Self, module: &ModuleId) -> List<DeclarationId>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.moduleDeclarations(&mut self.*, module)
  }

  /// Answers the queries a check of `declaration` demands, without the escape check and without
  /// reporting, so a later `checkModule` of its module finds them answered. The language server
  /// runs it one declaration per step to answer requests between them.
  pub effect fn prepareDeclaration(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> ()
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    run CheckAndEscapes.prepareDeclaration(&mut self.*, &mut request.*, declaration)
  }

  /// The foreign symbol conflicts between modules of the root package, which no one module's
  /// check can see. It may repeat a rejection a module's check reports.
  pub effect fn checkForeignConflicts(
    self: &mut Self,
    request: &mut Request,
    rootPackage: &[ModuleId],
    runtime: &Option<ModuleId>,
  ) -> List<Shared<Rejection>>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
    ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.checkForeignConflicts(&mut self.*, &mut request.*, rootPackage, runtime)
  }

  /// The bodies structurally deferred by the last loaded-declaration sweep. This is coverage
  /// evidence, never a checked Body answer. Selected applications still demand their exact Body.
  pub fn deferredStaticTemplates(self: &Self) -> &[DeferredStaticTemplate] {
    return List<DeferredStaticTemplate>.asSlice(&self.deferredTemplates)
  }

  /// What the selected runtime refuses of the application's `main` where it starts it, as the
  /// last `checkDeclarations` found by walking from the runtime's roots, in walk order. Each is
  /// located in the runtime module; `checkDeclarations` leaves them out of its own result, because
  /// the driver reports them at the entry's `main`. Empty when no runtime was selected or the
  /// runtime is itself one of the checked modules.
  pub fn runtimeRefusals(self: &Self) -> &[Shared<Rejection>] {
    return List<Shared<Rejection>>.asSlice(&self.runtimeRefused)
  }

  /// The concrete root-package bodies the last loaded-declaration sweep left without borrow
  /// checking, reached or not, in sweep order. Open and deferred templates are not listed: the
  /// instances a build reaches are checked separately. The emitted count covers only the reached
  /// instances, so an unreached unchecked body is visible here alone.
  pub fn uncheckedRootBodies(self: &Self) -> &[UncheckedBody] {
    return List<UncheckedBody>.asSlice(&self.uncheckedRoot)
  }

  /// The warnings the last build's declaration check found, in check order. A build refused for
  /// an error reports that error instead.
  pub fn checkedBuildWarnings(self: &Self) -> &[Shared<Rejection>] {
    return List<Shared<Rejection>>.asSlice(&self.buildWarnings)
  }

  /// The selected import members that IMPORT-003 rejects (unknown, private, or claimed twice) in
  /// every loaded module, checked when the module is reached rather than when a use demands the
  /// member. Checking a member can load the module it names, whose imports are checked in turn.
  @trace(name: "check.imports")
  pub effect fn importRejections(self: &mut Self, request: &mut Request) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.importRejections(&mut self.*, &mut request.*)
  }

  /// The selected members of `module`'s active imports that IMPORT-003 rejects, in written order.
  /// A revisable store keeps the check as a module check unit, so a cache image holds a module
  /// whose imports were clean and the next process takes it without reading the module.
  pub effect fn moduleImportRejections(self: &mut Self, request: &mut Request, module: &ModuleId) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.moduleImportRejections(&mut self.*, &mut request.*, module)
  }

  /// Borrows the module whose namespace or declaration a recorded dependency demanded.
  pub fn dependencyModule(self: &Self, dependency: &Dependency) -> &ModuleId {
    let modules = List<ModuleId>.asSlice(&self.resolver.modules)
    return &modules[widened(dependency.module)]
  }

  /// Borrows the demanded spelling of a name dependency, absent for other families.
  pub fn dependencyName(self: &Self, dependency: &Dependency) -> Option<&[u8]> {
    if dependency.family != Family.Name {
      return Option<&[u8]>.none()
    }
    return Option<&[u8]>.some(StringTable.get(&self.resolver.names, Symbol {index: widened(dependency.name)}))
  }

  /// Copies the canonical declaration a declaration dependency demanded, in the held source
  /// revision. Other families and lost declaration handles return `None`.
  pub effect fn dependencyDeclaration(
    self: &mut Self,
    dependency: &Dependency
  ) -> Option<DeclarationId>
    ! Cycle | OutOfMemoryError
    ? &mut Allocator {
    return run QueryEngine.dependencyDeclaration(&mut self.*, dependency)
  }

  /// Copies named authored addresses and actual import namespaces from one canonical source.
  /// Syntax does not admit bodies. Absent source and condition/import refusals retain observations.
  pub effect fn demandSourceInventory(self: &mut Self, request: &mut Request, module: &ModuleId) -> SourceInventory
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandSourceInventory(&mut self.*, &mut request.*, module)
  }

  /// Resolves a nongeneric type alias only when the caller requests its target.
  /// Returns an anchored rejection for an absent name, unsupported target, or alias cycle.
  pub effect fn demandAlias(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Alias)
    run recordRoot(&mut request.*, Family.Alias, module, name, &answer)
    return move answer
  }

  /// Returns a nongeneric nominal identity without resolving fields, members, or layout.
  /// Returns an anchored rejection if the name does not identify a supported nominal declaration.
  pub effect fn demandIdentity(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandIdentity(&mut self.*, &mut request.*, module, name)
  }

  /// Enumerates the written fields, tuple positions, enum cases, or union variants of a nominal.
  /// Member types and target layout remain undemanded.
  pub effect fn demandMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandMembers(&mut self.*, &mut request.*, module, name)
  }

  /// Resolves only one member's written types under a canonical nominal application.
  /// A struct field or tuple position has one type; a union variant has its ordered payload
  /// types; a scalar enum case has none. The member is selected by its enumeration ordinal.
  pub effect fn demandMemberShape(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
    member: usize,
    application: &Interned<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandMemberShape(&mut self.*, &mut request.*, module, name, member, application)
  }

  /// Resolves the binders and declared bounds of a type, alias, interface, or service declaration.
  ///
  /// # Details
  ///
  /// This does not demand the declaration's identity or members, and it proves no bound; an
  /// application of a bounded declaration is rejected as unsupported where it is written.
  pub effect fn demandContract(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandContract(&mut self.*, &mut request.*, module, name)
  }

  /// Resolves the variance of each binder of a struct, tuple, union, or enum (LIFE-002), as
  /// `Value.Variance` in complete binder order.
  ///
  /// # Details
  ///
  /// Only binders and member shapes are read, never a body or a layout. A recursive or mutually
  /// recursive declaration reaches its least fixed point inside the one query, so ordinary
  /// recursion is not a cycle. Any other declaration rejects as unsupported.
  pub effect fn demandVariance(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandVariance(&mut self.*, &mut request.*, module, name)
  }

  /// Resolves what cleanup of a struct, tuple, union, or enum observes of each binder (LIFE-005),
  /// as `Value.DropObservation` in complete binder order.
  ///
  /// # Details
  ///
  /// Only binders, member shapes and the implementation shapes that may hold a `Drop` hook are
  /// read. Recursion is resolved inside the one query, as for `demandVariance`.
  pub effect fn demandDropObservation(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandDropObservation(&mut self.*, &mut request.*, module, name)
  }

  /// Enumerates an interface's or service's operation declarations in written order.
  ///
  /// # Details
  ///
  /// Only member headers are read; no operation signature is resolved. A field, a visibility
  /// modifier on an operation, or another non-operation member rejects with
  /// `InvalidContractMember`, and a repeated operation name rejects at the later operation. An
  /// operation with a body is listed as one with a default.
  pub effect fn demandOperations(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandOperations(&mut self.*, &mut request.*, module, name)
  }

  /// Resolves the written signature of one interface or service operation without reading a body.
  ///
  /// # Details
  ///
  /// The operation resolves under its contract's binders and implicit `Self` provider, while its
  /// own binders keep the operation's identity. The contract's operation list is demanded first,
  /// so an invalid member list rejects here too. An absent operation rejects with `UnknownMember`.
  pub effect fn demandOperation(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    contract: &[u8],
    operation: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandOperation(&mut self.*, &mut request.*, module, contract, operation)
  }

  /// Resolves the heads of every top-level conformance and sealed-property `impl` in one module, in
  /// written order.
  ///
  /// # Details
  ///
  /// Each head is the implementation's binders, including lifetimes elided from its heads, with
  /// its applied contract and provider. Only header names and applications are resolved; no member
  /// or body is read. An empty list observes that the module declares none. One rejected head
  /// rejects the list, because the module's membership is then unknown. Inherent `impl`s are
  /// reached through their owner with `demandInherentMembers`.
  pub effect fn demandImplementations(self: &mut Self, request: &mut Request, module: &ModuleId) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandImplementations(&mut self.*, &mut request.*, module)
  }

  /// Lists the conformance heads that implement an applied interface or service for a provider.
  ///
  /// # Details
  ///
  /// Heads are read only from the modules permitted to own them: the contract's module and the
  /// nominal provider's module for an interface, the provider's module for a service. A facade or
  /// alias spelling of either endpoint converges on the same canonical owners. An empty list
  /// observes absence; bodies, members, and applicability are not examined.
  ///
  /// # Gotchas
  ///
  /// Both types must come from answers of this store. A contract whose declaring module this store
  /// has never read fails with `InvalidModulePath`.
  pub effect fn demandConformanceHeads(
    self: &mut Self,
    request: &mut Request,
    contract: &Interned<Type>,
    provider: &Interned<Type>,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandConformanceHeads(&mut self.*, &mut request.*, contract, provider)
  }

  /// Proves one interface or service application using exact concrete heads and the caller's
  /// declared abstract bounds. Every conditional requirement must finish before proof succeeds.
  /// `siteModule` and `siteSpan` anchor a missing or undecidable goal at the use; declaration-level
  /// coherence and witness failures keep their own source anchors. This selects no runtime provider
  /// and adds no Effect requirement.
  pub effect fn proveConformance(
    self: &mut Self,
    request: &mut Request,
    contract: &Interned<Type>,
    provider: &Interned<Type>,
    declared: &[Constraint],
    siteModule: &ModuleId,
    siteSpan: Span,
  ) -> ConformanceDecision
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.proveConformance(&mut self.*, &mut request.*, contract, provider, declared, siteModule, siteSpan)
  }

  /// Validates a complete application against its target and lexical scope headers.
  /// No body is demanded, and a rejected environment retains the caller's diagnostic site.
  pub effect fn validateApplication(self: &mut Self, request: &mut Request, application: &Application,
    siteModule: &ModuleId, siteSpan: Span) -> Result<Application, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.validateApplication(&mut self.*, &mut request.*, application, siteModule, siteSpan)
  }

  /// Resolves a target signature under its complete validated own and enclosing environment.
  /// The lexical Self provider is derived from the head, never stored as an extra argument.
  pub effect fn specializeSignature(self: &mut Self, request: &mut Request, application: &Application,
    siteModule: &ModuleId, siteSpan: Span) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.specializeSignature(&mut self.*, &mut request.*, application, siteModule, siteSpan)
  }

  /// Resolves an interface call under its caller's concrete type and row arguments.
  ///
  /// # Details
  /// Substitutes both contract and provider, proves the concrete goal without declared bounds,
  /// and composes the selected witness's argument mapping in target binder order. The returned
  /// Named application has the same canonical identity as a direct call to that target.
  /// Proof and witness headers are demanded; the target body is never read. Operation-owned
  /// arguments absent from the checked call remain unresolved for the backend to classify.
  pub effect fn specializeInterfaceCall(
    self: &mut Self,
    request: &mut Request,
    contract: &Interned<Type>,
    provider: &Interned<Type>,
    operation: &DeclarationId,
    caller: &Application,
    siteModule: &ModuleId,
    siteSpan: Span,
  ) -> Result<Application, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.specializeInterfaceCall(&mut self.*, &mut request.*, contract, provider, operation, caller, siteModule, siteSpan)
  }

  /// Decides whether one conformance `impl` is coherent before any applicability or bound proof.
  ///
  /// # Details
  ///
  /// Every written parameter must occur in the interface application or the provider, and every
  /// bound must descend through the provider without repeating an open parameter or rewriting a
  /// fixed interface argument (`NonterminatingConformance` with its step). The complete owner
  /// bucket is then read, and no other head may name the same goal once lifetimes are erased:
  /// bounds never make heads distinct and no head wins by source or demand order. Both heads of a
  /// conflict reject with the same diagnostic, anchored at the canonically later head, with `path`
  /// holding that head and then the earliest other conflicting head. `DuplicateConformance` names
  /// two unbounded heads that rename each other exactly; any other conflict is
  /// `OverlappingConformance`. A head the lifetime-erased comparison cannot decide, such as one
  /// whose union member nests a parameter, is `Unsupported`. A success proves no bound and admits
  /// no witness. An identity absent from the current revision rejects with `UnknownMember`.
  pub effect fn demandCoherence(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandCoherence(&mut self.*, &mut request.*, implementation)
  }

  /// Lists the written members of a module's `occurrence`th top-level `impl`, which must be a
  /// conformance or sealed-property implementation.
  ///
  /// # Details
  ///
  /// An inline member is its function declaration. A mapped member's path is resolved from headers
  /// only: a function of this module or of an imported namespace, or an inherent member its owner
  /// publishes. A repeated member name rejects with `Collision`; a rejected head publishes no
  /// member. Members are not matched against contract operations here.
  pub effect fn demandImplementationMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    occurrence: usize,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandImplementationMembers(&mut self.*, &mut request.*, module, occurrence)
  }

  /// Enumerates the inherent members an owner publishes across its module's inherent `impl`s.
  ///
  /// # Details
  ///
  /// Only the owner's module is read; a rejected head publishes no member, and a deferred head
  /// defers the whole enumeration with its own rejection. A member whose name
  /// repeats another member, or an owner field, variant, enum member, generated operation, or
  /// contract operation, is not published, and its anchored rejection is kept; no winner is chosen
  /// by source order. Member signatures are not resolved.
  pub effect fn demandInherentMembers(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandInherentMembers(&mut self.*, &mut request.*, module, name)
  }

  /// Resolves the signature of `member`, an inherent member of the owner declaration `owner`.
  ///
  /// # Details
  ///
  /// The owner's published members decide the answer. A member that repeats another member's name
  /// or claims an owner item's name returns its kept rejection; no winner is chosen by source
  /// order. A member of a rejected inherent head is not published. An absent member rejects with
  /// `UnknownMember`.
  pub effect fn demandInherentMember(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    owner: &[u8],
    member: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandInherentMember(&mut self.*, &mut request.*, module, owner, member)
  }

  /// Resolves the signature of one function or operation addressed by its declaration identity.
  ///
  /// # Details
  ///
  /// This is the answer the name lookups return for the same declaration, under the same gates: a
  /// contract operation needs its contract's operation list, an `impl` member whose name is written
  /// twice in its block rejects with `Collision`, and an inherent member returns its owner's kept
  /// rejection unless the owner publishes it. An identity absent from the current revision
  /// rejects with `UnknownMember`.
  pub effect fn demandSignatureOf(
    self: &mut Self,
    request: &mut Request,
    declaration: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandSignatureOf(&mut self.*, &mut request.*, declaration)
  }

  /// Resolves a contract operation's written call signature under an applied interface and
  /// provider, without choosing evidence for the application. Qualified calls, method calls, and
  /// operators use this same `Self` substitution after their supplier has been selected. The
  /// caller must separately prove the application or supply a declared bound.
  pub effect fn demandAppliedOperation(
    self: &mut Self,
    request: &mut Request,
    contract: &Interned<Type>,
    provider: &Interned<Type>,
    operation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandAppliedOperation(&mut self.*, &mut request.*, contract, provider, operation)
  }

  /// Resolves a contract operation's signature under one conformance `impl`, with the contract's
  /// binders bound to the head's contract arguments and `Self` to its provider.
  ///
  /// # Details
  ///
  /// The operation keeps its own binders as its parameters. The supplied arguments are not checked
  /// against the contract's bounds. An operation that is not in the head's contract, or a head with
  /// no contract, rejects with `UnknownMember`; a rejected head or operation list rejects with its
  /// diagnostic. No member or body of the implementation is read.
  pub effect fn demandOperationUnder(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
    operation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandOperationUnder(&mut self.*, &mut request.*, implementation, operation)
  }

  /// Pairs every contract operation of one conformance `impl` with the member that implements it,
  /// and checks each member's header against the operation's header under the conformance head.
  ///
  /// # Details
  ///
  /// The witnesses follow the contract's operation order. A missing, unknown, or incompatible
  /// member rejects with `IncompatibleWitness`, which names the failing component, at the member
  /// or, for a missing one, at the `impl`. A narrower implementation keeps the operation's header
  /// as the contract callers see. No member body is read, and a successful answer proves no
  /// conformance: the head's bounds and coherence are separate facts. An inherent or sealed head
  /// rejects with `UnknownMember`.
  pub effect fn demandWitnesses(
    self: &mut Self,
    request: &mut Request,
    implementation: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandWitnesses(&mut self.*, &mut request.*, implementation)
  }

  /// Resolves a function's written parameter and result types without reading its body.
  /// Returns an anchored rejection for an unsupported header or referenced type.
  pub effect fn demandSignature(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandSignature(&mut self.*, &mut request.*, module, name)
  }

  /// Resolves a constant's written type without reading its initializer.
  ///
  /// # Details
  ///
  /// The type is one primitive scalar or `string`, whose omitted lifetime is `'static`. Any other
  /// type is an anchored `InvalidConstant` rejection.
  pub effect fn demandConstant(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandConstant(&mut self.*, &mut request.*, module, name)
  }

  /// Resolves one registered package parameter's header without evaluating its default.
  pub effect fn demandParameterSchema(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandParameterSchema(&mut self.*, &mut request.*, module, name)
  }

  /// Evaluates one registered parameter's exact source default through the held static machine.
  pub effect fn demandParameterDefault(
    self: &mut Self,
    request: &mut Request,
    identity: &DeclarationId,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandParameterDefault(&mut self.*, &mut request.*, identity)
  }

  /// Demands every parameter header in each explicitly registered source module.
  /// Imports alone never add schemas. Registered modules are visited in canonical order.
  pub effect fn demandRegisteredParameters(self: &mut Self, request: &mut Request) -> Result<
    List<RegisteredParameter>,
    Shared<Rejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandRegisteredParameters(&mut self.*, &mut request.*)
  }

  /// Publishes a constant's value when its initializer needs no static execution.
  ///
  /// # Details
  ///
  /// The value demand first demands the constant's type. An exact Boolean or integer literal
  /// within its selected target range is the value. A bare name of another constant demands that
  /// constant's type, then its value, so a repeated initializer path is a `Cycle` rejection while
  /// both types stay available.
  ///
  /// # Gotchas
  ///
  /// Every other initializer, including floating-point, text, call, or operator, is an anchored
  /// `Unsupported` rejection rather than a provisional value.
  pub effect fn demandInitializer(
    self: &mut Self,
    request: &mut Request,
    module: &ModuleId,
    name: &[u8],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandInitializer(&mut self.*, &mut request.*, module, name)
  }

  /// Types one demanded ordinary function body against its written signature.
  ///
  /// # Details
  ///
  /// Scalar bodies retain the existing fully checked result. A generic body is typed once with
  /// symbolic parameters; its `TypedBody.Stage.ContractTyped` result leaves ownership, lifetime,
  /// cleanup, and Effect checking to later. A direct ordinary call reads
  /// the callee signature and records its required runtime body without checking that body.
  /// Completed answers replay current source and signature evidence into each request.
  ///
  /// # Gotchas
  ///
  /// An unsupported expression or statement produces an anchored rejection. Contract typing does
  /// not establish executable readiness or full body safety.
  pub effect fn demandBody(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Body)
    run recordRoot(&mut request.*, Family.Body, module, name, &answer)
    return move answer
  }

  /// The resolved annotations and call targets of one function body (`Family.BodyFacts`), which
  /// its checking takes. Their answer's dependencies are the name reads behind them.
  pub effect fn demandBodyFacts(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    return run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.BodyFacts)
  }

  /// The anchor a typed body's origins count from in the store's current source; absent when the
  /// body's declaration is gone. A body and its MIR keep positions relative to it, so reading
  /// one back as source text depends on where the declaration is now (incremental v2 §3.5).
  pub effect fn bodyAnchor(self: &mut Self, body: &Shared<TypedBody>) -> Option<Anchor> ! Cycle | OutOfMemoryError ? &mut Allocator {
    let declaration = Shared<TypedBody>.with<DeclarationId>(body, |checked: &TypedBody| -> DeclarationId {
      return DeclarationId.copy(TypedBody.declarationId(checked))
    })
    return run declarationAnchor(&mut self.resolver, &declaration)
  }

  /// The anchor an instance's MIR origins count from; drop glue has none.
  pub effect fn mirAnchor(self: &mut Self, instance: &InstanceKey) -> Option<Anchor> ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run instanceAnchor(&mut self.resolver, instance)
  }

  /// Types one exact authored function/operation through the same identity gates as SignatureOf.
  /// Unsupported and rejection answers remain their actual discriminants; no-body syntax never
  /// gains a fabricated checked body. This is ordinary abstract Body, not selected executable MIR.
  pub effect fn demandBodyOf(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandBodyOf(&mut self.*, &mut request.*, declaration)
  }

  /// Demands the drop glue MIR of one type through the `Family.Mir` key the instance worklist
  /// interns for it. A type that mentions no declaration has no glue and answers `LayoutUnsupported`.
  pub effect fn demandGlueMir(self: &mut Self, request: &mut Request, ty: &Interned<Type>, sourceOwner: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandGlueMir(&mut self.*, &mut request.*, ty, sourceOwner)
  }

  /// Demands the MIR of one declaration's named instance for diagnostic sweeps. A declaration
  /// with open binders answers its open-instance gap. A declaration with requirements is lowered
  /// only under the providers its callers bind, so a sweep has no instance to demand: none.
  pub effect fn demandMirOf(self: &mut Self, request: &mut Request, declaration: &DeclarationId) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let signature = run Semantic.demandSignatureOf(&mut self.*, &mut request.*, declaration)
    if run signatureRequiresProviders(&signature) { return Option<Shared<Result<Answer, NoRejection>>>.none() }
    return run namedCheckMir(&mut self.*, &mut request.*, declaration)
  }

  /// Demands MIR for one complete semantic environment before runtime identity can be reused.
  /// Header validation and admission precede the exact-application query cache; target callees
  /// remain body-lazy. The instance key numbers the application's caller regions canonically;
  /// `'static` and region sharing remain exact evidence even when emitted instructions coincide.
  pub effect fn demandApplicationMir(self: &mut Self, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandApplicationMir(&mut self.*, &mut request.*, application)
  }

  /// Demands MIR for one exact reached instance, such as a call's callee key with its providers, for
  /// a program that does or does not observe diagnostics (failure observer note N1).
  /// `sourceOwner` and `span` identify the authentic requester, independently of a generated key.
  /// A zero span requests that actual owner's original header; it is never a published refusal.
  pub effect fn demandInstanceMir(self: &mut Self, request: &mut Request, instance: &InstanceKey, sourceOwner: &DeclarationId, span: Span, observing: bool) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandInstanceMir(&mut self.*, &mut request.*, instance, sourceOwner, span, observing)
  }

  /// Source-validates one instance and returns its immutable content-keyed LLVM answer.
  /// The source owner/span belong to its requester; generated instance identity is not source.
  /// A zero span asks for the actual requesting owner's authored header.
  pub effect fn demandInstanceText(
    self: &mut Self,
    request: &mut Request,
    instance: &InstanceKey,
    sourceOwner: &DeclarationId,
    span: Span,
    observing: bool,
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run QueryEngine.demandInstanceText(&mut self.*, &mut request.*, instance, sourceOwner, span, observing)
  }

  /// Immutable definition arena; positions are published only by completed LLVM text queries.
  pub fn instanceTexts(self: &Self) -> &[InstanceDefinition] {
    return List<InstanceDefinition>.asSlice(&self.resolver.llvmValues)
  }

  /// Demands the selected residual body of one function under its complete semantic application.
  ///
  /// # Details
  /// The answer types only the residual its selection pass chose, with static results embedded.
  /// Equal semantic applications share one selected body; the declaration's abstract body is a
  /// different query and is never used for a function with static work.
  pub effect fn demandSelectedBody(self: &mut Self, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandSelectedBody(&mut self.*, &mut request.*, application)
  }

  /// Demands the backend-neutral body graph for one named function.
  pub effect fn demandMir(self: &mut Self, request: &mut Request, module: &ModuleId, name: &[u8]) -> Shared<
    Result<Answer, NoRejection>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let answer = run demandNamed(&mut self.resolver, &mut self.query, module, name, Family.Mir)
    run recordRoot(&mut request.*, Family.Mir, module, name, &answer)
    return move answer
  }

  /// The uses after drop in `function` that the lowering verifier rejects, with the call flows
  /// and excuses it reads in this request.
  pub effect fn useAfterDrop(self: &mut Self, request: &mut Request, function: &MirFunction) -> List<UseAfterDrop>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    run selectRequest(&mut self.resolver, &request.*)
    let mut read = List<Dependency>.make()
    return run unexcusedUses(&mut self.resolver, &mut self.query, &mut read, function)
  }

  /// Demands backend-neutral target layout facts for one runtime type.
  pub effect fn demandLayout(self: &mut Self, request: &mut Request, module: &ModuleId, ty: &Interned<Type>) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    return run QueryEngine.demandLayout(&mut self.*, &mut request.*, module, ty)
  }

  /// Returns an owned handle to one cached layout answer.
  pub fn layoutAt(self: &Self, index: usize) -> Option<Shared<BackendLayout>> {
    let layouts = List<Shared<BackendLayout>>.asSlice(&self.resolver.layoutValues)
    if index >= layouts.length { return Option<Shared<BackendLayout>>.none() }
    return Option<Shared<BackendLayout>>.some(Shared<BackendLayout>.clone(&layouts[index]))
  }

  /// Borrows a MIR graph named by a `Value.Mir` answer from this store.
  pub fn mirAt(self: &Self, index: usize) -> Option<&MirFunction> {
    let functions = List<MirFunction>.asSlice(&self.resolver.mirValues)
    if index >= functions.length {
      return Option<&MirFunction>.none()
    }
    return Option<&MirFunction>.some(&functions[index])
  }

  /// The [`mirAt`] index of each function the last [`buildArtifact`] walk emitted, in the order
  /// the walk reached them. A build that replayed its record from a cache lists only the functions
  /// it lowered again.
  pub fn emittedMir(self: &Self) -> &[usize] {
    return List<usize>.asSlice(&self.resolver.emittedMir)
  }

  /// Builds a finite reachable-key closure rooted at one application, as a build does at a
  /// changing-static edge. Only certified evidence admits such a chain; `limit` bounds its nodes.
  /// The root is validated like any demanded application; its incoming edge is Direct in the
  /// root's module at the authentic original header, with no caller or ancestors.
  pub effect fn closeStaticChain(self: &mut Self, request: &mut Request, root: &Application, limit: usize) -> StaticClosure
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run CheckAndEscapes.closeStaticChain(&mut self.*, &mut request.*, root, limit)
  }

  /// Builds an artifact whose roots are the active C exports of the selected runtime source, when
  /// one is selected, and of the request's application module, which is what `import
  /// Intrinsic.application` binds inside the runtime. A library or object form selects no runtime,
  /// so its application's exports are its only roots and it may have none (ARTIFACT-003). Checks
  /// the `checked` declarations as written (`checkWrittenDeclarations`: the root package's, then
  /// its dependencies'), then walks from the roots, where it checks and emits only reached
  /// instances, and joins their definitions in content-symbol order.
  pub effect fn buildArtifact(self: &mut Self, request: &mut Request, runtime: Option<&ModuleId>,
    rootPackage: &[ModuleId], checked: &[ModuleId], closureNodes: usize) -> BackendBuild
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run EmissionAndAssembly.buildArtifact(&mut self.*, &mut request.*, move runtime, rootPackage, checked, closureNodes)
  }
}
