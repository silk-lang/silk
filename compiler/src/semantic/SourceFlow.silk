//! Structural reaching definitions in the complete source rule program.
//!
//! Definitions name whole values or authenticated storage components, never a loan. Every
//! assignment therefore participates, including caller and loan-free replacements. This module
//! emits rules into the same Program as source transfers and operation policies; it does not
//! run a second fixed point or choose sources before policy closure.

import semantic.SourceRules {Atom, Program, Solution, Truth}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.testing {AssertionError, Testing}
import silk.ownership {Copy}
import silk.usize
import silk.vector {Vector}
import CompilerBug

pub struct PointId { pub index: usize }
impl Copy for PointId {}
pub struct DefinitionId { pub index: usize }
impl Copy for DefinitionId {}
pub struct ReadId { pub index: usize }
impl Copy for ReadId {}
pub struct ComponentId { pub index: usize }
impl Copy for ComponentId {}

pub enum Write { Strong, Weak }

pub struct Point {
  pub reachable: Atom
}
impl Copy for Point {}

pub struct Edge {
  pub from: PointId
  pub to: PointId
  pub active: Atom
}
impl Copy for Edge {}

pub struct Definition {
  pub point: PointId
  pub component: ComponentId
  pub active: Atom
  pub write: Write
}
impl Copy for Definition {}

pub struct Read {
  pub point: PointId
  pub component: ComponentId
}
impl Copy for Read {}

/// A concrete candidate definition/read pair. Its applicability is grounded by runtime CFG
/// reachability and exact kills. It never combines one definition with another read's proof.
pub struct Pair {
  pub definition: DefinitionId
  pub read: ReadId
  pub active: Atom
}
impl Copy for Pair {}

/// Structural reservation is independent of solved input/output presence. A checker refusal
/// never removes runtime edges; actual return/noncompletion simply has no successor edge.
pub struct Flow {
  points: Vector<Point>
  edges: Vector<Edge>
  definitions: Vector<Definition>
  reads: Vector<Read>
  pairs: Vector<Pair>
  pairRows: Vector<Vector<usize>>
}

/// The one emitted reaching relation, referenced by source transfers and ownership projection.
pub struct Reaching {
  pub points: Vector<Point>
  /// The exact runtime edges used by the source equations. Ownership projects this graph;
  /// it must not reconstruct a second CFG from checker traversal or source visitation order.
  pub edges: Vector<Edge>
  pub definitions: Vector<Definition>
  pub reads: Vector<Read>
  pub pairs: Vector<Pair>
  entering: Vector<Atom>
  leaving: Vector<Atom>
}

impl Flow {
  pub fn make() -> Self {
    return Flow {points: Vector<Point>.make(), edges: Vector<Edge>.make(),
      definitions: Vector<Definition>.make(), reads: Vector<Read>.make(), pairs: Vector<Pair>.make(), pairRows: Vector<Vector<usize>>.make()}
  }

  pub effect fn point(self: &mut Self, rules: &mut Program) -> PointId
  ! OutOfMemoryError ? &mut Allocator {
    let id = PointId {index: Vector<Point>.length(&self.points)}
    run Vector<Point>.append(&mut self.points, Point {reachable: Program.atom(&mut rules.*)})
    return id
  }

  pub fn reachable(self: &Self, point: PointId) -> Atom {
    requirePoint(&self.*, point)
    return Vector<Point>.asSlice(&self.points)[point.index].reachable
  }

  /// Immutable identities for source-product reservation before terminal equation emission.
  /// These gates remain stable when later boundary reads/definitions extend the same graph.
  pub fn reservedPoints(self: &Self) -> &[Point] { return Vector<Point>.asSlice(&self.points) }
  pub fn reservedPairs(self: &Self) -> &[Pair] { return Vector<Pair>.asSlice(&self.pairs) }

  pub effect fn edge(self: &mut Self, from: PointId, to: PointId, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    requirePoint(&self.*, from)
    requirePoint(&self.*, to)
    run Vector<Edge>.append(&mut self.edges, Edge {from: from, to: to, active: active})
    return ()
  }

  pub effect fn define(self: &mut Self, point: PointId, component: ComponentId, active: Atom, write: Write) -> DefinitionId
  ! OutOfMemoryError ? &mut Allocator {
    requirePoint(&self.*, point)
    let id = DefinitionId {index: Vector<Definition>.length(&self.definitions)}
    run Vector<Definition>.append(&mut self.definitions,
      Definition {point: point, component: component, active: active, write: write})
    return id
  }

  /// Reads observe entering storage. An expression with both a read and a write uses separate
  /// points in the authored evaluation order, so it cannot see its own later replacement.
  pub effect fn read(self: &mut Self, point: PointId, component: ComponentId) -> ReadId
  ! OutOfMemoryError ? &mut Allocator {
    requirePoint(&self.*, point)
    let id = ReadId {index: Vector<Read>.length(&self.reads)}
    run Vector<Read>.append(&mut self.reads, Read {point: point, component: component})
    return id
  }

  /// Candidate address discovery can reveal a weak route after the definition was reserved.
  /// Before terminal emission this only removes a kill; it never changes identity, generates
  /// a source or upgrades a weak destination. Reaching equations have not been emitted yet.
  pub fn weaken(self: &mut Self, definition: DefinitionId) -> () {
    let definitions = Vector<Definition>.asMutSlice(&mut self.definitions)
    if definition.index >= definitions.length { CompilerBug.panic(b"source weakening names an absent definition") }
    definitions[definition.index].write = Write.Weak
    return ()
  }

  /// Reserve stable gates for the actual definition/read identities seen so far. This is
  /// topology only: no reaching fact, kill decision or selected source is evaluated here.
  /// Later boundary reads/definitions add pairs without replacing earlier gates. The one
  /// terminal emit binds every gate after the full source/operation reservation is closed.
  pub effect fn reservePairs<'flow>(self: &'flow mut Self, rules: &mut Program) -> &'flow [Pair]
  ! OutOfMemoryError ? &mut Allocator {
    let definitions = Vector<Definition>.asSlice(&self.definitions)
    let reads = Vector<Read>.asSlice(&self.reads)
    while Vector<Vector<usize>>.length(&self.pairRows) < reads.length {
      run Vector<Vector<usize>>.append(&mut self.pairRows, Vector<usize>.make())
    }
    let mut read = usize.ZERO
    while read < reads.length {
      let rows = Vector<Vector<usize>>.asMutSlice(&mut self.pairRows)
      // The row's length is the first definition not yet considered for this read.
      // Extending the universe needs no search through previously allocated pair gates.
      let mut definition = Vector<usize>.length(&rows[read])
      while definition < definitions.length {
        let mut pair = usize.MAX
        if reads[read].component.index == definitions[definition].component.index {
          pair = Vector<Pair>.length(&self.pairs)
          let active = Program.atom(&mut rules.*)
          run Vector<Pair>.append(&mut self.pairs, Pair {definition: DefinitionId {index: definition},
            read: ReadId {index: read}, active: active})
        }
        run Vector<usize>.append(&mut rows[read], pair)
        definition = definition + usize.ONE
      }
      read = read + usize.ONE
    }
    return Vector<Pair>.asSlice(&self.pairs)
  }

  /// Emits finite reaching rules without evaluating them. Each strong write kills exactly its
  /// supplied component; the structural producer must supply only authenticated covered slots.
  /// Weak call stores generate received definitions and preserve all previous definitions.
  pub effect fn emit(self: Self, rules: &mut Program) -> Reaching
  ! OutOfMemoryError ? &mut Allocator {
    let mut closed = move self
    drop run Flow.reservePairs(&mut closed, &mut rules.*)
    let points = Vector<Point>.asSlice(&closed.points)
    let definitions = Vector<Definition>.asSlice(&closed.definitions)
    let edges = Vector<Edge>.asSlice(&closed.edges)
    let reads = Vector<Read>.asSlice(&closed.reads)
    let width = definitions.length
    let mut entering = Vector<Atom>.make()
    let mut leaving = Vector<Atom>.make()
    let mut killed = Vector<Atom>.make()
    let mut writes = Vector<Vector<usize>>.make()
    let mut point = usize.ZERO
    while point < points.length {
      run Vector<Vector<usize>>.append(&mut writes, Vector<usize>.make())
      let mut definition = usize.ZERO
      while definition < width {
        run Vector<Atom>.append(&mut entering, Program.atom(&mut rules.*))
        run Vector<Atom>.append(&mut leaving, Program.atom(&mut rules.*))
        run Vector<Atom>.append(&mut killed, Program.atom(&mut rules.*))
        definition = definition + usize.ONE
      }
      point = point + usize.ONE
    }
    let mut definition = usize.ZERO
    while definition < definitions.length {
      let byPoint = Vector<Vector<usize>>.asMutSlice(&mut writes)
      run Vector<usize>.append(&mut byPoint[definitions[definition].point.index], definition)
      definition = definition + usize.ONE
    }
    let empty = Vector<Atom>.make()
    let none = Vector<Atom>.asSlice(&empty)
    let ins = Vector<Atom>.asSlice(&entering)
    let outs = Vector<Atom>.asSlice(&leaving)
    let kills = Vector<Atom>.asSlice(&killed)
    let mut each = usize.ZERO
    while each < edges.length {
      let edge = edges[each]
      let reach: [Atom; 2] = [points[edge.from.index].reachable, edge.active]
      run Program.rule(&mut rules.*, points[edge.to.index].reachable, &reach, none)
      let mut definition = usize.ZERO
      while definition < width {
        let input: [Atom; 2] = [outs[edge.from.index * width + definition], edge.active]
        run Program.rule(&mut rules.*, ins[edge.to.index * width + definition], &input, none)
        definition = definition + usize.ONE
      }
      each = each + usize.ONE
    }
    point = usize.ZERO
    while point < points.length {
      let mut definition = usize.ZERO
      while definition < width {
        let offset = point * width + definition
        let input: [Atom; 2] = [ins[offset], points[point].reachable]
        let omitted: [Atom; 1] = [kills[offset]]
        run Program.rule(&mut rules.*, outs[offset], &input, &omitted)
        let atPoint = Vector<usize>.asSlice(&Vector<Vector<usize>>.asSlice(&writes)[point])
        let mut write = usize.ZERO
        while write < atPoint.length {
          let next = definitions[atPoint[write]]
          if next.component.index == definitions[definition].component.index
            && next.write == Write.Strong && atPoint[write] != definition {
            let gate: [Atom; 2] = [next.active, points[point].reachable]
            run Program.rule(&mut rules.*, kills[offset], &gate, none)
          }
          write = write + usize.ONE
        }
        if definitions[definition].point.index == point {
          let generated: [Atom; 2] = [definitions[definition].active, points[point].reachable]
          run Program.rule(&mut rules.*, outs[offset], &generated, none)
        }
        definition = definition + usize.ONE
      }
      point = point + usize.ONE
    }
    let mut read = usize.ZERO
    while read < reads.length {
      let mut definition = usize.ZERO
      while definition < width {
        if reads[read].component.index == definitions[definition].component.index {
          let reserved = Vector<Pair>.asSlice(&closed.pairs)
          let rows = Vector<Vector<usize>>.asSlice(&closed.pairRows)
          let found = Vector<usize>.asSlice(&rows[read])[definition]
          if found == usize.MAX || found >= reserved.length {
            CompilerBug.panic(b"source reaching emission omitted a reserved pair")
          }
          let active = reserved[found].active
          let input: [Atom; 2] = [ins[reads[read].point.index * width + definition], points[reads[read].point.index].reachable]
          run Program.rule(&mut rules.*, active, &input, none)
        }
        definition = definition + usize.ONE
      }
      read = read + usize.ONE
    }
    return Reaching {points: move closed.points, edges: move closed.edges, definitions: move closed.definitions,
      reads: move closed.reads, pairs: move closed.pairs, entering: move entering, leaving: move leaving}
  }
}

fn requirePoint(flow: &Flow, point: PointId) -> () {
  if point.index >= Vector<Point>.length(&flow.points) {
    CompilerBug.panic(b"source flow references an unreserved point")
  }
  return ()
}

impl Reaching {
  pub fn enters(self: &Self, point: PointId, definition: DefinitionId) -> Atom {
    return Vector<Atom>.asSlice(&self.entering)[point.index * Vector<Definition>.length(&self.definitions) + definition.index]
  }
  pub fn leaves(self: &Self, point: PointId, definition: DefinitionId) -> Atom {
    return Vector<Atom>.asSlice(&self.leaving)[point.index * Vector<Definition>.length(&self.definitions) + definition.index]
  }
}

test effect fn sourceDefinitionsRespectKillsBackedgesAndEarlierReads() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run definitionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn definitionClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = Program.make()
  let enabled = Program.atom(&mut rules)
  run Program.fact(&mut rules, enabled)
  let mut flow = Flow.make()
  let entry = run Flow.point(&mut flow, &mut rules)
  let before = run Flow.point(&mut flow, &mut rules)
  let header = run Flow.point(&mut flow, &mut rules)
  let replace = run Flow.point(&mut flow, &mut rules)
  let exit = run Flow.point(&mut flow, &mut rules)
  let reset = run Flow.point(&mut flow, &mut rules)
  let after = run Flow.point(&mut flow, &mut rules)
  run Program.fact(&mut rules, Flow.reachable(&flow, entry))
  run Flow.edge(&mut flow, entry, before, enabled)
  run Flow.edge(&mut flow, before, header, enabled)
  run Flow.edge(&mut flow, header, replace, enabled)
  run Flow.edge(&mut flow, replace, header, enabled)
  run Flow.edge(&mut flow, header, exit, enabled)
  run Flow.edge(&mut flow, exit, reset, enabled)
  run Flow.edge(&mut flow, reset, after, enabled)
  let slot = ComponentId {index: usize.ZERO}
  let caller = run Flow.define(&mut flow, entry, slot, enabled, Write.Strong)
  let earlierRead = run Flow.read(&mut flow, before, slot)
  let loopRead = run Flow.read(&mut flow, header, slot)
  // A consumer can reserve its input gate before a later source/read is discovered.
  // Use that gate as a real subsequent write guard, rather than only comparing IDs.
  let initial = run Flow.reservePairs(&mut flow, &mut rules)
  let loopPair = usize.ONE
  let observedCaller = initial[loopPair].active
  let local = run Flow.define(&mut flow, replace, slot, enabled, Write.Strong)
  let replacement = run Flow.define(&mut flow, reset, slot, observedCaller, Write.Strong)
  let finalRead = run Flow.read(&mut flow, after, slot)
  let relation = run Flow.emit(move flow, &mut rules)
  let solved = run Program.solve(&rules)
  let retained = Vector<Pair>.asSlice(&relation.pairs)[loopPair]
  run Testing.expect(retained.read.index == loopRead.index && retained.definition.index == caller.index,
    "late definitions and terminal emission preserve the identity of an already reserved pair")
  run Testing.expect(pairTruth(&relation, &solved, earlierRead, caller) == Truth.True,
    "the read before the loop observes its actual entry definition")
  run Testing.expect(pairTruth(&relation, &solved, earlierRead, local) == Truth.False,
    "a later assignment cannot reach backward without a CFG edge")
  run Testing.expect(pairTruth(&relation, &solved, loopRead, caller) == Truth.True
    && pairTruth(&relation, &solved, loopRead, local) == Truth.True,
    "header reads enumerate both the zero-iteration source and the later backedge replacement")
  run Testing.expect(pairTruth(&relation, &solved, finalRead, caller) == Truth.False
    && pairTruth(&relation, &solved, finalRead, local) == Truth.False
    && pairTruth(&relation, &solved, finalRead, replacement) == Truth.True,
    "an unconditional whole-value replacement kills both historical definitions independently of loans")
  return ()
}

test effect fn sourceWeakStoresPreserveOldAndReceivedDefinitions() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run weakStoreClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn weakStoreClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = Program.make()
  let enabled = Program.atom(&mut rules)
  let never = Program.atom(&mut rules)
  run Program.fact(&mut rules, enabled)
  let mut flow = Flow.make()
  let entry = run Flow.point(&mut flow, &mut rules)
  let store = run Flow.point(&mut flow, &mut rules)
  let done = run Flow.point(&mut flow, &mut rules)
  let disconnected = run Flow.point(&mut flow, &mut rules)
  run Program.fact(&mut rules, Flow.reachable(&flow, entry))
  run Flow.edge(&mut flow, entry, store, enabled)
  run Flow.edge(&mut flow, store, done, enabled)
  run Flow.edge(&mut flow, done, disconnected, never)
  let field = ComponentId {index: usize.ZERO}
  let sibling = ComponentId {index: usize.ONE}
  let old = run Flow.define(&mut flow, entry, field, enabled, Write.Strong)
  let untouched = run Flow.define(&mut flow, entry, sibling, enabled, Write.Strong)
  let received = run Flow.define(&mut flow, store, field, enabled, Write.Strong)
  let inactive = run Flow.define(&mut flow, store, field, never, Write.Strong)
  let read = run Flow.read(&mut flow, done, field)
  let siblingRead = run Flow.read(&mut flow, done, sibling)
  let absentRead = run Flow.read(&mut flow, disconnected, field)
  // A later-discovered weak address keeps the original definition and pair identities,
  // but removes the premature strong kill before the one terminal equation emission.
  drop run Flow.reservePairs(&mut flow, &mut rules)
  Flow.weaken(&mut flow, received)
  let relation = run Flow.emit(move flow, &mut rules)
  let solved = run Program.solve(&rules)
  run Testing.expect(pairTruth(&relation, &solved, read, old) == Truth.True
    && pairTruth(&relation, &solved, read, received) == Truth.True,
    "a completing weak store preserves both old and received alternatives")
  run Testing.expect(pairTruth(&relation, &solved, read, inactive) == Truth.False,
    "an inactive conditional strong write neither generates nor kills")
  run Testing.expect(pairTruth(&relation, &solved, siblingRead, untouched) == Truth.True,
    "a component write does not overwrite a distinct authenticated sibling")
  run Testing.expect(pairTruth(&relation, &solved, absentRead, old) == Truth.False
    && pairTruth(&relation, &solved, absentRead, received) == Truth.False,
    "a genuinely infeasible edge does not fabricate a read occurrence")
  return ()
}

fn pairTruth(relation: &Reaching, solved: &Solution, read: ReadId, definition: DefinitionId) -> Truth {
  let pairs = Vector<Pair>.asSlice(&relation.pairs)
  let mut at = usize.ZERO
  while at < pairs.length {
    if pairs[at].definition.index == definition.index && pairs[at].read.index == read.index {
      return Solution.truth(solved, pairs[at].active)
    }
    at = at + usize.ONE
  }
  return Truth.False
}
