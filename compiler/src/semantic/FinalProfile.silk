//! One complete, immutable build profile assembled from explicit logical inputs.
//!
//! # When to use
//! Resolve every registered parameter before calling [`publish`]. A failed publication yields no
//! profile. The profile retains value origins for diagnostics while identity uses only logical facts.

import semantic.Types {Types}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.InitialProfile {InitialProfile}
import semantic.ProfileBinding
import semantic.ProfileBinding {Provenance, RegisteredShape, Shape}
import semantic.StaticValue
import semantic.StaticValue {Value as StaticData}
import semantic.Target {Target as MachineTarget}
import semantic.ParameterSchema {ParameterSchema}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.box {Box}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// The source or request that supplied one final value. Origins are excluded from profile identity.
pub union Origin {
  /// The registered declaration's evaluated default.
  Default {pub span: Span},
  /// A selected external binding, retaining its current request position.
  Binding {pub ordinal: usize, pub provenance: Provenance},
}

/// One resolved parameter awaiting complete-profile publication.
pub struct Entry {
  /// The canonical source declaration, independent of import aliases.
  pub declaration: DeclarationId
  /// The concrete value after default or override selection.
  pub value: Shared<StaticData>
  /// The current source or request origin.
  pub origin: Origin
}

/// Why a complete profile could not be published.
pub enum Problem {
  MissingParameter,
  DuplicateParameter,
  UnknownParameter,
  WrongType,
  InvalidShape,
  /// No checked predicate evidence was supplied for a registered validation expression.
  PredicateNotChecked,
  /// Nominal resource and Drop freedom awaits M2.5; no unproved value enters a final profile.
  ResourceSafetyNotChecked,
}

/// Approved behavior outside this fixed-profile slice that callers must not assume was checked.
pub enum DeferredGap {
  BootstrapDomain,
}

/// Named status of an intentionally deferred profile guarantee.
pub enum DeferredStatus {
  BootstrapDomainNotChecked,
}

/// One frozen build profile. Entries follow registered schema order, independent of input order.
pub struct FinalProfile {
  initial: InitialProfile
  parameters: Vector<Entry>
}

fn selected<'a>(values: &'a [Entry], identity: &DeclarationId) -> Option<&'a Entry> {
  let mut at = usize.ZERO
  while at < values.length {
    if DeclarationId.equals(&values[at].declaration, identity) {
      return Option<&Entry>.some(&values[at])
    }
    at = at + usize.ONE
  }
  return Option<&Entry>.none()
}

fn selectedForSchema<'a>(values: &'a [Entry], schema: &Shared<ParameterSchema>) -> Option<&'a Entry> {
  let mut at = usize.ZERO
  while at < values.length {
    let matched = Shared<ParameterSchema>.with<bool>(
      schema,
      fn(header: &ParameterSchema) -> bool {
        return DeclarationId.equals(&header.declaration, &values[at].declaration)
      },
    )
    if matched {
      return Option<&Entry>.some(&values[at])
    }
    at = at + usize.ONE
  }
  return Option<&Entry>.none()
}

fn hasUncheckedNominal(shape: &Shape) -> bool {
  return match & shape.* {
    Shape.Enum {..} => true
    Shape.Record {..} => true
    Shape.Optional {..} => true
    Shape.Array {element, ..} => {
      let inner = Box<Shape>.get(&element)
      return hasUncheckedNominal(&inner[usize.ZERO])
    }
    _ => false
  }
}

impl FinalProfile {
  /// Constructs a binding origin with owned public provenance.
  pub effect fn bindingOrigin(ordinal: usize, provenance: &Provenance) -> Origin
  ! OutOfMemoryError ? &mut Allocator {
    return Origin.Binding {ordinal: ordinal, provenance: run copyProvenance(provenance)}
  }
  /// Copies an entry without changing its current diagnostic origin.
  pub effect fn copyEntry(entry: &Entry) -> Entry ! OutOfMemoryError ? &mut Allocator {
    return Entry {declaration: DeclarationId.copy(&entry.declaration),
      value: Shared<StaticData>.clone(&entry.value), origin: run copyOrigin(&entry.origin)}
  }
  /// Publishes only if each registered schema has exactly one correctly typed final value.
  /// Schema order is supplied by registration, which visits canonical modules in sorted order.
  pub effect fn publish(
    initial: InitialProfile,
    schemas: &[RegisteredShape],
    entries: Vector<Entry>,
    checkedPredicates: &[DeclarationId],
  ) -> Result<FinalProfile, Problem> ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let values = Vector<Entry>.asSlice(&entries)
    if values.length != schemas.length {
      return Result<FinalProfile, Problem>.failResult(Problem.MissingParameter)
    }
    let mut ordered = Vector<Entry>.make()
    let mut schemaAt = usize.ZERO
    while schemaAt < schemas.length {
      let schema = &schemas[schemaAt]
      let hasValidation = Shared<ParameterSchema>.with<bool>(
        &schema.schema,
        fn(header: &ParameterSchema) -> bool {
          return header.hasValidation
        },
      )
      if hasValidation {
        let mut checked = false
        let mut at = usize.ZERO
        while at < checkedPredicates.length {
          if Shared<ParameterSchema>.with<bool>(&schema.schema, fn(header: &ParameterSchema) -> bool {
            return DeclarationId.equals(&header.declaration, &checkedPredicates[at])
          }) { checked = true }
          at = at + usize.ONE
        }
        if !checked { return Result<FinalProfile, Problem>.failResult(Problem.PredicateNotChecked) }
      }
      if hasUncheckedNominal(&schema.shape) {
        return Result<FinalProfile, Problem>.failResult(Problem.ResourceSafetyNotChecked)
      }
      let declared = Shared<ParameterSchema>.with<Shared<Type>>(
        &schema.schema,
        fn(header: &ParameterSchema) -> Shared<Type> {
          return Shared<Type>.clone(&header.ty)
        },
      )
      if !run ProfileBinding.correspondsToType(&declared, &schema.shape) {
        return Result<FinalProfile, Problem>.failResult(Problem.InvalidShape)
      }
      let found = match move selectedForSchema(values, &schema.schema) {
        Option<&Entry>.Some {value} => value
        Option<&Entry>.None => {
          return Result<FinalProfile, Problem>.failResult(Problem.MissingParameter)
        }
      }
      let valid = run StaticValue.matchesType(&found.value, &declared)
      if !valid {
        return Result<FinalProfile, Problem>.failResult(Problem.WrongType)
      }
      let mut previous = usize.ZERO
      while previous < schemaAt {
        let other = Shared<ParameterSchema>.with<bool>(
          &schemas[previous].schema,
          fn(header: &ParameterSchema) -> bool {
            return DeclarationId.equals(&header.declaration, &found.declaration)
          },
        )
        if other {
          return Result<FinalProfile, Problem>.failResult(Problem.DuplicateParameter)
        }
        previous = previous + usize.ONE
      }
      run Vector<Entry>.append(
        &mut ordered,
        Entry {
          declaration: DeclarationId.copy(&found.declaration),
          value: Shared<StaticData>.clone(&found.value),
          origin: run copyOrigin(&found.origin),
        },
      )
      schemaAt = schemaAt + usize.ONE
    }
    let mut at = usize.ZERO
    while at < values.length {
      let mut count = usize.ZERO
      let listed = Vector<Entry>.asSlice(&ordered)
      let mut expected = usize.ZERO
      while expected < listed.length {
        if DeclarationId.equals(&values[at].declaration, &listed[expected].declaration) {
          count = count + usize.ONE
        }
        expected = expected + usize.ONE
      }
      if count == usize.ZERO {
        return Result<FinalProfile, Problem>.failResult(Problem.UnknownParameter)
      }
      let mut earlier = usize.ZERO
      while earlier < at {
        if DeclarationId.equals(&values[at].declaration, &values[earlier].declaration) {
          return Result<FinalProfile, Problem>.failResult(Problem.DuplicateParameter)
        }
        earlier = earlier + usize.ONE
      }
      at = at + usize.ONE
    }
    return Result<FinalProfile, Problem>.succeed(
      FinalProfile {initial: move initial, parameters: move ordered},
    )
  }
}

effect fn copyProvenance(value: &Provenance) -> Provenance ! OutOfMemoryError ? &mut Allocator {
  return match & value.* {
    Provenance.Literal => Provenance.Literal
    Provenance.TranslatedPublic {translator} => Provenance.TranslatedPublic {
      translator: run Bytes.copy(Bytes.asSlice(&translator)),
    }
    Provenance.Secret => Provenance.Secret
    Provenance.PhysicalSupply => Provenance.PhysicalSupply
    Provenance.Runtime => Provenance.Runtime
  }
}

effect fn copyOrigin(origin: &Origin) -> Origin ! OutOfMemoryError ? &mut Allocator {
  return match & origin.* {
    Origin.Default {span} => Origin.Default {span: span}
    Origin.Binding {ordinal, provenance} => Origin.Binding {
      ordinal: ordinal,
      provenance: run copyProvenance(&provenance),
    }
  }
}

impl FinalProfile {
  /// Names a deferred guarantee without claiming it ran during publication.
  pub fn deferredStatus(_profile: &FinalProfile, gap: DeferredGap) -> DeferredStatus {
    return match gap {
      DeferredGap.BootstrapDomain => DeferredStatus.BootstrapDomainNotChecked
    }
  }
  /// Returns the machine target frozen into this profile's logical facts.
  pub fn target(profile: &FinalProfile) -> MachineTarget {
    let selected = InitialProfile.target(&profile.initial)
    return MachineTarget.forId(MachineTarget.id(selected))
  }
  /// Borrows the explicit frozen logical facts used by closed `Intrinsic.profile*` queries.
  pub fn facts(profile: &FinalProfile) -> &InitialProfile {
    return &profile.initial
  }
  /// Answers one closed logical text key, with absence reserved for an invalid key.
  pub fn text<'a>(profile: &'a FinalProfile, key: &[u8]) -> Option<&'a [u8]> {
    return InitialProfile.text(&profile.initial, key)
  }
  /// Answers one closed logical flag key, with absence reserved for an invalid key.
  pub fn flag(profile: &FinalProfile, key: &[u8]) -> Option<bool> {
    return InitialProfile.flag(&profile.initial, key)
  }
  /// Answers membership in a closed logical set key.
  pub fn contains(profile: &FinalProfile, key: &[u8], member: &[u8]) -> Option<bool> {
    return InitialProfile.contains(&profile.initial, key, member)
  }
  /// Borrows all resolved parameters in canonical registration order.
  pub fn entries(profile: &FinalProfile) -> &[Entry] {
    return Vector<Entry>.asSlice(&profile.parameters)
  }
  /// Returns a resolved parameter by canonical declaration identity.
  pub fn parameter<'a>(profile: &'a FinalProfile, identity: &DeclarationId) -> Option<&'a Entry> {
    return selected(Vector<Entry>.asSlice(&profile.parameters), identity)
  }
  /// Equal logical facts and typed values share identity even when current origins differ.
  pub effect fn sameIdentity(first: &FinalProfile, second: &FinalProfile) -> bool
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
    if !InitialProfile.sameIdentity(&first.initial, &second.initial) {
      return false
    }
    let left = Vector<Entry>.asSlice(&first.parameters)
    let right = Vector<Entry>.asSlice(&second.parameters)
    if left.length != right.length {
      return false
    }
    let mut at = usize.ZERO
    while at < left.length {
      if !DeclarationId.equals(&left[at].declaration, &right[at].declaration) || !run StaticValue.equals(
        &left[at].value,
        &right[at].value,
      ) {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
}
