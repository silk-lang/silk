/// A short loan of an active semantic query for static call resolution.
/// Its dependency ledger is the caller's ledger, including an in-flight initializer.
pub struct StaticPort<'source> {
  pub resolver: &'source mut Resolver,
  pub query: &'source mut Query<Answer, NoRejection>,
  pub dependencies: &'source mut List<Dependency>,
}

/// Constructs a short loan from an active semantic provider's split state.
pub fn inFlightStaticPort<'source>(
  resolver: &'source mut Resolver,
  query: &'source mut Query<Answer, NoRejection>,
  dependencies: &'source mut List<Dependency>,
) -> StaticPort<'source> {
  return StaticPort {resolver: move resolver, query: move query, dependencies: move dependencies}
}

// The provider of a sealed `impl Drop` head; absent for every other implementation kind.
fn sealedDropProvider(head: &ImplementationHead) -> Option<Interned<Type>> {
  return match &head.kind {
    ImplementationKind.Sealed {property} => {
      if property != SealedProperty.Drop { return Option<Interned<Type>>.none() }
      return Option<Interned<Type>>.some(Interned<Type>.clone(&head.provider))
    }
    _ => Option<Interned<Type>>.none()
  }
}

// Whether `value` is the nominal `declaration` under any type and lifetime arguments.
fn nominalDeclares(value: &Type, declaration: &DeclarationId) -> bool {
  return match &value.* { Type.Nominal {declaration: owner, ..} => DeclarationId.equals(&owner, declaration) _ => false }
}

/// A header-only documentation lookup. Namespace aliases retain their actual module; selected
/// imports retain their canonical declaration rather than the alias's authored identity.
pub union DocumentationBinding {
  Declaration {pub identity: DeclarationId, pub isPublic: bool},
  Namespace {pub module: ModuleId, pub isPublic: bool},
}

impl<'source> StaticPort<'source> {
  /// Counts one step of a static evaluation running through this port (`CostLedger.step`).
  pub fn countStep(self: &mut Self) -> () {
    CostTable.step(&mut self.resolver.costs)
  }
  /// Borrows one exact parsed source from this query port.
  pub fn sourceAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
    return SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
  }
  /// Borrows authored HIR from one authenticated source for the duration of this port loan.
  pub fn authoredAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&Module> {
    let indexed = SourceIndex.sourceAtCursor(&self.resolver.source, cursor)
    if let Option<&IndexedSource>.Some {value} = move indexed {
      return Option<&Module>.some(IndexedSource.authored(value))
    }
    return Option<&Module>.none()
  }
  /// The target of the held semantic revision.
  pub fn target(self: &Self) -> MachineTarget {
    return self.resolver.target
  }
  /// Logical facts are frozen before defaults, then retained by the published profile.
  pub fn profileFacts<'a>(self: &'a Self) -> Option<&'a InitialProfile> {
    if let Option<&FinalProfile>.Some {value} = move selectedProfile(&self.resolver.*) {
      return Option<&InitialProfile>.some(FinalProfile.facts(value))
    }
    return match &self.resolver.assemblyFacts {
      Option<InitialProfile>.Some {value} => Option<&InitialProfile>.some(&value)
      Option<InitialProfile>.None => Option<&InitialProfile>.none()
    }
  }
  /// The bytes of the embedded file `file`, a module identity of origin `embed`, as the held
  /// revision publishes it, or `None` when the build published no such file. The read is a
  /// source-file dependency of the running unit, so a changed file reruns only what read it.
  pub effect fn embeddedFile(self: &mut Self, file: &ModuleId) -> Option<Bytes>
  ! OutOfMemoryError ? &mut Allocator {
    let unit = recordingUnit(&self.resolver.*)
    if unit != usize.MAX {
      let ordinal = run internModule(&mut self.resolver.*, file)
      run Graph.record(&mut self.resolver.graph, unit, Dependee.SourceFile {module: ordinal})
    }
    let observed = run SourceIndex.captureObservation(&self.resolver.source, file)
    return run Observation.copyContent(&observed)
  }
  /// The registered service count, restricted to one contract when the static call names it.
  pub effect fn ambientServiceCount(self: &mut Self, module: &ModuleId, contract: &Option<Interned<Type>>) -> usize ! OutOfMemoryError ? &mut Allocator | &mut Types {
    if let Option<Interned<Type>>.Some {value} = &contract.* {
      run observeAmbientServices(&mut self.resolver.*, module)
      if run ErasureIndex.containsAmbient(currentErasures(&self.resolver.*), &value) { return usize.ONE }
      return usize.ZERO
    }
    return run ambientCount(&mut self.resolver.*, module)
  }

  /// Records the active profile input as a logical dependency of the reached static query.

  pub effect fn demandProfile(self: &mut Self, module: &ModuleId, span: Span) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let declarationAccess245Request = Key {
        family: Family.ProfileInput, module: moduleOrdinal, name: usize.ZERO,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }
    let declarationAccess245 = run internDeclaration(&mut self.resolver, declarationAccess245Request)
    let observed = run demandChild(
      &mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*,
      declarationAccess245,
      span,
    )
    drop observed
    return ()
  }
  /// Records that the running unit, checking `module`, reads the profile fact `key` of kind
  /// `kind` (`text:`, `flag:` or `set:`), so a cache reuses the unit only under a profile whose
  /// fact reads the same.
  pub effect fn observeProfile(self: &mut Self, module: &ModuleId, kind: &[u8], key: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
    return run recordProfileRead(&mut self.resolver.*, module, kind, key)
  }
  /// Demands one exact authored source on the port's held revision.
  pub effect fn authoredCursor(self: &mut Self, module: &ModuleId) -> Option<AuthoredCursor>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let answer = run source(&mut self.resolver.*, module)
    return run SourceIndex.authoredCursor(&mut self.resolver.*.source, &answer, module)
  }
  /// `authoredCursor` for reading one declaration: it observes only that declaration's written
  /// header and body, so an edit elsewhere in its module leaves the reader alone.
  pub effect fn declarationCursor(self: &mut Self, declaration: &DeclarationId) -> Option<AuthoredCursor>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let module = DeclarationId.moduleId(declaration)
    let answer = run observedWholeDeclaration(&mut self.resolver.*, module, declaration)
    return run SourceIndex.authoredCursor(&mut self.resolver.*.source, &answer, module)
  }
  /// The module a standard-library `path`, such as `silk/num/i32.silk`, names when `module` writes it.
  pub effect fn standardModule(self: &Self, module: &ModuleId, path: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
    return canonicalModule(&self.resolver.*, run PackageGraph.target(&self.resolver.*.packages, module, path))
  }
  /// Copies a source call's checked identity and arguments without resolving its spelling again.
  pub effect fn copyDirectCall(self: &mut Self, body: &Shared<TypedBody>, syntax: HirId, window: Range) -> Option<StaticCall>
  ! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
    let declaration = Shared<TypedBody>.with<DeclarationId>(body, |checked: &TypedBody| -> DeclarationId {
      return DeclarationId.copy(TypedBody.declarationId(checked))
    })
    let anchor = match move run declarationAnchor(&mut self.resolver.*, &declaration) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => { return Option<StaticCall>.none() }
    }
    let mut receiver = false
    let selected = Shared<TypedBody>.with<Option<Interned<Application>>>(body, |checked: &TypedBody| -> Option<Interned<Application>> {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if at >= window.start && at - window.start < window.length && Anchor.hir(&anchor, nodes[at].origin.node).index == syntax.index {
          if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {data: _bx}, ..} = &nodes[at].kind {
  let DirectCallData {application, receiverPass, ..} = &_bx.get().*

            if let Option<BodyReceiverPass>.Some {..} = &receiverPass { receiver = true }
            return Option<Interned<Application>>.some(Interned<Application>.clone(&application))
          }
        }
        at = at + usize.ONE
      }
      return Option<Interned<Application>>.none()
    })
    if let Option<Interned<Application>>.Some {value} = move selected {
      return Option<StaticCall>.some(StaticCall {application: run Application.copyShared(&value), receiver: receiver})
    }
    return Option<StaticCall>.none()
  }

  pub effect fn forwardsAmbient(self: &mut Self, application: &Application, span: Span) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let id = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(application)))
    let location = match move run locationOfIdentity(&mut self.resolver.*, &id) {
      Option<InstanceLocation>.Some {value} => value
      _ => { return false }
    }
    let chosen = run internSelectedApplication(&mut self.resolver.*, application)
    let key = run internDeclaration(&mut self.resolver.*, Key {family: Family.Body, module: location.module,
      name: usize.ZERO, declaration: location.declaration, member: chosen + usize.ONE, external: false})
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    let checked = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, answerBody)
    if let Option<Shared<TypedBody>>.Some {value} = move checked {
      return Shared<TypedBody>.with<bool>(&value, forwardsObservation)
    }
    return false
  }

  /// The function value form the checker gave `syntax` in `window`, if any: a named section, or a
  /// call or staging through a function value. Static evaluation makes the value from it.
  pub effect fn copyStaticCallable(self: &mut Self, body: &Shared<TypedBody>, syntax: HirId, window: Range) -> Option<StaticCallable>
  ! Cycle | InvalidModulePath | OutOfMemoryError ? &mut Allocator {
    let declaration = Shared<TypedBody>.with<DeclarationId>(body, |checked: &TypedBody| -> DeclarationId {
      return DeclarationId.copy(TypedBody.declarationId(checked))
    })
    let anchor = match move run declarationAnchor(&mut self.resolver.*, &declaration) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => { return Option<StaticCallable>.none() }
    }
    return Shared<TypedBody>.with<Option<StaticCallable>>(body, |checked: &TypedBody| -> Option<StaticCallable> {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if at >= window.start && at - window.start < window.length && Anchor.hir(&anchor, nodes[at].origin.node).index == syntax.index {
          match &nodes[at].kind {
            BodyNodeKind.Expression {ty, form: BodyExpression.Aggregate {data: _bx}} => {
              if let AggregateData {section: Option<SectionRetention>.Some {value: retained}, ..} = &_bx.get().* {
                return Option<StaticCallable>.some(StaticCallable.Section {ty: Interned<Type>.clone(&ty), first: retained.first})
              }
            }
            BodyNodeKind.Expression {form: BodyExpression.CallableCall {..}, ..} => { return Option<StaticCallable>.some(StaticCallable.Through) }
            BodyNodeKind.Expression {form: BodyExpression.StagedCallable {..}, ..} => { return Option<StaticCallable>.some(StaticCallable.Through) }
            _ => ()
          }
        }
        at = at + usize.ONE
      }
      return Option<StaticCallable>.none()
    })
  }

  /// The witness application of a checked interface operation call once `bindings`, the
  /// executing frame's, close its contract and provider: what static evaluation runs for a
  /// `static` operation. Absent when `syntax` is no interface call in `window`.
  pub effect fn copyInterfaceCall(self: &mut Self, body: &Shared<TypedBody>, syntax: HirId, window: Range,
    bindings: &[Binding], span: Span) -> Option<Application>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let declaration = Shared<TypedBody>.with<DeclarationId>(body, |checked: &TypedBody| -> DeclarationId {
      return DeclarationId.copy(TypedBody.declarationId(checked))
    })
    let anchor = match move run declarationAnchor(&mut self.resolver.*, &declaration) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => { return Option<Application>.none() }
    }
    let found = Shared<TypedBody>.with<Option<BodyNodeId>>(body, |checked: &TypedBody| -> Option<BodyNodeId> {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if at >= window.start && at - window.start < window.length && Anchor.hir(&anchor, nodes[at].origin.node).index == syntax.index {
          if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &nodes[at].kind {
            return Option<BodyNodeId>.some(BodyNodeId {index: at})
          }
        }
        at = at + usize.ONE
      }
      return Option<BodyNodeId>.none()
    })
    let node = match move found {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { return Option<Application>.none() }
    }
    let inputs = match move TypedBody.interfaceCall(body, node) {
      Option<InterfaceCallInputs>.Some {value} => move value
      Option<InterfaceCallInputs>.None => { return Option<Application>.none() }
    }
    let count = Shared<List<Binding>>.with<usize>(&inputs.bindings, |values: &List<Binding>| -> usize { return List<Binding>.length(values) })
    let mut invocation = List<Binding>.make()
    let mut at = usize.ZERO
    while at < count {
      let recorded = Shared<List<Binding>>.with<Binding>(&inputs.bindings, |values: &List<Binding>| -> Binding {
        let entries = List<Binding>.asSlice(values)
        return Binding {declaration: Interned<DeclarationId>.clone(&entries[at].declaration),
          ordinal: entries[at].ordinal, value: Argument.copy(&entries[at].value)}
      })
      run List<Binding>.append(&mut invocation, Binding {declaration: move recorded.declaration, ordinal: recorded.ordinal,
        value: run Argument.applyBindings(&recorded.value, bindings, true)})
      at = at + usize.ONE
    }
    // Static operands are values, not loans: a borrowed one lends for the whole evaluation.
    let mut arguments = List<Interned<Type>>.make()
    let mut loans = List<WitnessLoan>.make()
    at = usize.ZERO
    while at < inputs.count {
      let argument = match move TypedBody.callArgument(body, node, at) {
        Option<CallArgument>.Some {value} => move value
        Option<CallArgument>.None => { return Option<Application>.none() }
      }
      run List<Interned<Type>>.append(&mut arguments, run Type.applyBindings(&argument.ty, bindings, true))
      run List<WitnessLoan>.append(&mut loans, WitnessLoan {region: Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Static))})
      at = at + usize.ONE
    }
    let recipe = WitnessRecipe {operation: Interned<DeclarationId>.clone(&inputs.operation),
      contract: run Type.applyBindings(&inputs.contract, bindings, true), provider: run Type.applyBindings(&inputs.provider, bindings, true),
      result: Interned<Type>.clone(&inputs.result), bindings: run Shared<List<Binding>>.make(move invocation),
      arguments: run Shared<List<Interned<Type>>>.make(move arguments), loans: run Shared<List<WitnessLoan>>.make(move loans), constructs: false}
    let module = ModuleId.copy(DeclarationId.moduleId(&declaration))
    let mut request = Request.make()
    let resolved = run completedWitnessApplication(&mut self.resolver.*, &mut self.query.*, &mut request,
      &mut self.dependencies.*, &recipe, &module, span)
    return match move resolved {
      Result<ResolvedWitness, Shared<Rejection>>.Success {value} => Option<Application>.some(move value.application)
      Result<ResolvedWitness, Shared<Rejection>>.Failure {..} => Option<Application>.none()
    }
  }

  /// Whether a sealed `impl Drop` head in the nominal's declaring module names it at any
  /// instantiation. An unreadable implementation list
  /// counts as Drop, so static admission refuses rather than guessing cleanup freedom.
  pub effect fn declaresDrop(self: &mut Self, declaration: &DeclarationId, span: Span) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, DeclarationId.moduleId(declaration))
    let declarationAccess246Request = Key {
      family: Family.Implementations, module: moduleOrdinal, name: usize.ZERO, declaration: usize.ZERO, member: usize.ZERO,
      external: false,
    }
    let declarationAccess246 = run internDeclaration(&mut self.resolver, declarationAccess246Request)
    let listed = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess246, span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&listed, answerCause)
    if let Option<Shared<Rejection>>.Some {..} = move rejected { return true }
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&listed, implementationCount)
    let mut at = usize.ZERO
    while at < count {
      let candidate = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&listed,
        |answer: &Result<Answer, NoRejection>| -> Option<Shared<ImplementationHead>> { return implementationAt(answer, at) })
      if let Option<Shared<ImplementationHead>>.Some {value: head} = move candidate {
        let provider = Shared<ImplementationHead>.with<Option<Interned<Type>>>(&head, sealedDropProvider)
        if let Option<Interned<Type>>.Some {value: owner} = move provider {
          if Interned<Type>.with<bool>(&owner, |value: &Type| -> bool { return nominalDeclares(value, declaration) }) { return true }
        }
      }
      at = at + usize.ONE
    }
    return false
  }

  /// A static function's checked body is selected by every evaluator argument (STATIC-001).
  /// Shares the caller's depth budget with static selections reached while checking its body.
  /// The transient counter is restored on every completion, including a typed failed query.
  pub effect fn demandStaticBody<'request>(self: &'request mut Self, application: &Application, arguments: &[Interned<StaticData>], span: Span, depthLimit: usize)
  -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | StaticDiagnostic ? &mut Allocator | &mut Types {
    let previousDepth = self.resolver.staticDemandDepth
    let previousLimit = self.resolver.staticDemandLimit
    let mut limit = previousLimit
    if depthLimit < limit {limit = depthLimit}
    if previousDepth >= limit {
      fail StaticDiagnostic {fault: StaticFault.DepthLimit, code: b"SEM0180", span: span, target: self.resolver.target,
        message: Option<Bytes>.none(), origin: Option<Span>.none(), byteOffset: Option<u64>.none(),
        rejection: Option<Shared<Rejection>>.none(), needed: Option<StaticNeeded>.none(),
        missing: Option<StaticExecution.MissingFact>.none(), trace: List<StaticExecution.TraceStep>.make()}
    }
    self.resolver.staticDemandDepth = previousDepth + usize.ONE
    self.resolver.staticDemandLimit = limit
    let reservation = StaticDemandReservation<'source, 'request> {
      port: move self, depth: previousDepth, limit: previousLimit,
    }
    let use = effect |resource: &mut StaticDemandReservation<'source, 'request>| -> Option<Shared<Result<Answer, NoRejection>>>
    ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
      return run StaticPort.demandStaticBodyUnchecked(&mut resource.port.*, application, arguments, span)
    }
    let release = effect |resource: &mut StaticDemandReservation<'source, 'request>| -> () {
      resource.port.resolver.staticDemandDepth = resource.depth
      resource.port.resolver.staticDemandLimit = resource.limit
      return ()
    }
    return run Effect.useReleaseNonParking(move reservation, move use, move release)
  }

  /// The shared value of a closed static application that takes no value arguments, evaluated
  /// once per store as its own unit. None when the call must run in the caller's machine instead:
  /// the function is being evaluated already, the evaluation failed, so the caller reports the
  /// failure with its own trace, or a constant initializer is collecting editor links.
  pub effect fn demandStaticResult(self: &mut Self, application: &Application, span: Span)
  -> Option<StaticExecution.SharedResult>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    if let Option<List<StaticExecution.EditorLink>>.Some {..} = &self.resolver.staticLinks {
      return Option<StaticExecution.SharedResult>.none()
    }
    let declaration = Application.bodyDeclaration(application)
    let module = DeclarationId.moduleId(declaration)
    let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
    let ordinal = match move run ordinalOfIdentity(&mut self.resolver.*, module, &identity) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Option<StaticExecution.SharedResult>.none() }
    }
    let mut selectedApplication = run Application.copy(application)
    selectedApplication.statics = List<StaticSlot>.make()
    let member = run internSelectedApplication(&mut self.resolver.*, &selectedApplication)
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let inFlight = List<usize>.asSlice(&self.resolver.staticResultsInFlight)
    if inFlight.length >= 96 { return Option<StaticExecution.SharedResult>.none() }
    let mut at = usize.ZERO
    while at < inFlight.length {
      if inFlight[at] == moduleOrdinal && inFlight[at + usize.ONE] == ordinal && inFlight[at + 2] == member {
        return Option<StaticExecution.SharedResult>.none()
      }
      at = at + 3
    }
    let request = Key {
      family: Family.StaticResult, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal,
      member: member + usize.ONE, external: false}
    let key = run internDeclaration(&mut self.resolver, request)
    run List<usize>.append(&mut self.resolver.staticResultsInFlight, moduleOrdinal)
    run List<usize>.append(&mut self.resolver.staticResultsInFlight, ordinal)
    run List<usize>.append(&mut self.resolver.staticResultsInFlight, member)
    let demanded = run Effect.result(demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span))
    let mut popped = usize.ZERO
    while popped < 3 {
      let last = List<usize>.length(&self.resolver.staticResultsInFlight) - usize.ONE
      drop List<usize>.remove(&mut self.resolver.staticResultsInFlight, last)
      popped = popped + usize.ONE
    }
    let answer = match move demanded {
      Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
    }
    return Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.SharedResult>>(&answer, sharedStaticResult)
  }

  pub effect fn demandStaticBodyUnchecked(self: &mut Self, application: &Application, arguments: &[Interned<StaticData>], span: Span)
  -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let declaration = Application.bodyDeclaration(application)
    let module = DeclarationId.moduleId(declaration)
    let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let mut selectedApplication = run Application.copy(application)
      let mut statics = List<StaticSlot>.make()
      // A body whose checking never reads its argument values is checked once for all of them.
      let reads = run staticBodyReadsValues(&mut self.resolver.*, module, ordinal)
      if reads {
        let mut at = usize.ZERO
        while at < arguments.length {
          run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: at, value: StaticValue.copy(&arguments[at])})
          at = at + usize.ONE
        }
      }
      // An ordinary function with static work is selected for runtime by its static parameters
      // alone. Static evaluation knows every argument, so its body is checked as a static
      // function's is, under its own key.
      let mut name = usize.ZERO
      if reads && !run declaredStaticFunction(&mut self.resolver.*, module, ordinal) { name = staticEvaluationBody() }
      selectedApplication.statics = move statics
      let member = run internSelectedApplication(&mut self.resolver.*, &selectedApplication)
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let declarationAccess247Request = Key {
        family: Family.Body, module: moduleOrdinal, name: name, declaration: ordinal,
        member: member + usize.ONE, external: false}
      let declarationAccess247 = run internDeclaration(&mut self.resolver, declarationAccess247Request)
      let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess247, span)
      return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
    }
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }

  /// The selected discovery root's catalog as one `Intrinsic.Tests` sequence of descriptors, in
  /// catalog order (TEST-004). Without a discovery root this is a static-phase rejection at `span`.
  pub effect fn tests(self: &mut Self, module: &ModuleId, span: Span, benchmarks: bool) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let catalog = match move run selectedTests(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, span, benchmarks) {
      Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<TestCatalog>, Shared<Rejection>>.Failure {error} => { return Result<StaticData, Shared<Rejection>>.failResult(move error) }
    }
    let count = Shared<TestCatalog>.with<usize>(&catalog, |held: &TestCatalog| -> usize { return List<TestEntry>.length(&held.entries) })
    let mut elements = List<Interned<StaticData>>.make()
    let mut at = usize.ZERO
    while at < count {
      let callable = Shared<TestCatalog>.with<Interned<Type>>(&catalog, |held: &TestCatalog| -> Interned<Type> {
        let entries = List<TestEntry>.asSlice(&held.entries)
        return Interned<Type>.clone(&entries[at].callable)
      })
      let descriptor = match move StaticValue.testDescriptor(run CheckedIntrinsic.testType(&callable)) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => { return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.StaticPhaseViolation, span)) }
      }
      run List<Interned<StaticData>>.append(&mut elements, run Interned<StaticData>.make(move descriptor))
      at = at + usize.ONE
    }
    return match move StaticValue.testCatalog(run CheckedIntrinsic.testsType(), move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// One descriptor's `Intrinsic.TestInfo` (TEST-004). It follows from the test's declaration, so
  /// reading it depends on no other test.
  pub effect fn testInfo(self: &mut Self, descriptor: &Interned<StaticData>, module: &ModuleId, span: Span) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let entry = match move run describedTest(&self.resolver.*, descriptor, module, span) {
      Result<DescribedTest, Shared<Rejection>>.Success {value} => move value
      Result<DescribedTest, Shared<Rejection>>.Failure {error} => { return Result<StaticData, Shared<Rejection>>.failResult(move error) }
    }
    let texts = run testInfoTexts(&self.resolver.*, &entry.declaration)
    return match move run StaticValue.testInfo(run CheckedIntrinsic.testInfoType(), move texts) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.StaticPhaseViolation, span))
    }
  }

  /// The `///` text of the field `label` of the struct `ty`, without its slashes, or empty when
  /// the field wrote none. Reading it depends on the struct's module, so only programs that ask
  /// for documentation see a comment edit.
  pub effect fn fieldDocumentation(self: &mut Self, ty: &Interned<Type>, label: &[u8]) -> Bytes
  ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run documentationOf(&mut self.resolver.*, ty, DocumentedPart.Field, label, usize.ZERO)
  }

  /// The `///` text of the field `label` at position `ordinal` of a variant of the union `ty`, as
  /// `fieldDocumentation` reads a struct field's. A variant field's descriptor does not name its
  /// variant, so the first variant with that field at that position owns the text.
  pub effect fn variantFieldDocumentation(self: &mut Self, ty: &Interned<Type>, label: &[u8], ordinal: usize) -> Bytes
  ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run documentationOf(&mut self.resolver.*, ty, DocumentedPart.VariantField, label, ordinal)
  }

  /// The `///` text of the nominal type `ty`'s own declaration, as `fieldDocumentation` reads a
  /// field's.
  pub effect fn typeDocumentation(self: &mut Self, ty: &Interned<Type>) -> Bytes
  ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run documentationOf(&mut self.resolver.*, ty, DocumentedPart.Type, b"", usize.ZERO)
  }

  /// The name of the first field of the struct `ty` that is not `pub`, empty when every field is
  /// or `ty` is no struct.
  pub effect fn privateField(self: &mut Self, ty: &Interned<Type>) -> Bytes
  ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run privateFieldOf(&mut self.resolver.*, ty)
  }

  /// The `///` text of the variant `label` of the union `ty`, as `fieldDocumentation` reads a
  /// field's.
  pub effect fn variantDocumentation(self: &mut Self, ty: &Interned<Type>, label: &[u8]) -> Bytes
  ! Cycle | OutOfMemoryError ? &mut Allocator {
    return run documentationOf(&mut self.resolver.*, ty, DocumentedPart.Variant, label, usize.ZERO)
  }

  /// The visible scalar enum values, obtained from the same checked discriminants as source member access.
  pub effect fn reflectedEnumMembers(self: &mut Self, ty: &Interned<Type>, site: &ModuleId, span: Span) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let members = match move run subjectScalarEnum(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, ty, span) {
      Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.Some {value} => match move value {
        Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value: listed} => move listed
        Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<StaticData, Shared<Rejection>>.failResult(move error) }
      }
      Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.None => { return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.TypeMismatch, span)) }
    }
    let declaration = match move run Type.copy(ty) {
      Type.Nominal {declaration, ..} => run Types.internDeclaration(move declaration)
      _ => { return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.TypeMismatch, span)) }
    }
    let local = ModuleId.equals(site, DeclarationId.moduleId(Interned<DeclarationId>.get(&declaration)))
    let empty = match move StaticValue.sequenceEmpty(run CheckedIntrinsic.staticSequenceType(ty)) {
      Option<StaticData>.Some {value} => move value
      Option<StaticData>.None => { return CompilerBug.panic(b"invalid reflected enum sequence type") }
    }
    let mut sequence = move empty
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&members, scalarEnumCount)
    let mut at: usize = 0
    while at < count {
      let label = run reflectedMemberLabel(&members, at)
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<ScalarEnumMember>>(&members,
        |answer: &Result<Answer, NoRejection>| -> Option<ScalarEnumMember> { return scalarEnumMember(answer, label.asSlice()) })
      if let Option<ScalarEnumMember>.Some {value} = move selected {
        if local || value.isPublic {
          let sign = if value.value.negative { StaticSign.Negative } else { StaticSign.Positive }
          let member = match move StaticValue.enumeration(Interned<DeclarationId>.clone(&declaration), value.value.ordinal, value.value.representation, sign, value.value.magnitude) {
            Option<StaticData>.Some {value: member} => run Interned<StaticData>.make(move member)
            Option<StaticData>.None => { return CompilerBug.panic(b"checked enum discriminant was invalid") }
          }
          let previous = run Interned<StaticData>.make(move sequence)
          let appended = match move run StaticValue.sequenceAppend(&previous, &member) {
            Option<StaticData>.Some {value: appended} => move appended
            Option<StaticData>.None => { return CompilerBug.panic(b"reflected enum value did not meet its sequence type") }
          }
          sequence = move appended
        }
      }
      at = at + 1
    }
    return Result<StaticData, Shared<Rejection>>.succeed(move sequence)
  }

  /// The label of a scalar enum's checked declaration ordinal.
  pub effect fn reflectedEnumLabel(self: &mut Self, ty: &Interned<Type>, ordinal: usize, site: &ModuleId, span: Span) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let members = match move run subjectScalarEnum(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, ty, span) {
      Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.Some {value} => match move value {
        Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value: listed} => move listed
        Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<StaticData, Shared<Rejection>>.failResult(move error) }
      }
      Option<Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>>.None => { return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.TypeMismatch, span)) }
    }
    let label = run reflectedMemberLabel(&members, ordinal)
    return match move StaticValue.text(move label) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.TypeMismatch, span))
    }
  }

  /// Names the defining declaration, independent of the module viewing it.
  pub effect fn declarationName(ty: &Interned<Type>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let declaration = Interned<Type>.with<Option<DeclarationId>>(ty, |value: &Type| -> Option<DeclarationId> {
      return match &value.* { Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration)) _ => Option<DeclarationId>.none() }
    })
    let mut name = Bytes.make()
    if let Option<DeclarationId>.Some {value} = move declaration {
      let module = DeclarationId.moduleId(&value)
      run ModuleId.appendPackage(module, &mut name)
      run name.append(b"/")
      run ModuleId.appendPath(module, &mut name)
      let mut at: usize = 0
      while at < DeclarationId.ownerCount(&value) {
        run name.append(b"/")
        let owner = run DeclarationId.copyOwnerName(&value, at)
        run name.append(owner.asSlice())
        at = at + 1
      }
    }
    return move name
  }

  /// The name of `ty` as a program writes it, without module paths and with lifetimes other than
  /// `'static` elided, such as `Page<String>` for `app.main.Page<silk.text.string.String>`, `&u32`,
  /// or `fn(&u32) -> bool` for a named function's value; none when the type has no spelling.
  pub effect fn typeName(ty: &Interned<Type>, viewer: &ModuleId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let written = match move run TypeText.displayElided(ty, viewer) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => { return Option<Bytes>.none() }
    }
    // A path segment is a name followed by `.`; the last name of each path stays.
    let bytes = Bytes.asSlice(&written)
    let mut short = Bytes.make()
    let mut segment = usize.ZERO
    let mut at = usize.ZERO
    while at <= bytes.length {
      let boundary = at == bytes.length || !nameByte(bytes[at])
      if boundary {
        if at < bytes.length && bytes[at] == 46 {
          segment = at + usize.ONE
        } else {
          run Bytes.append(&mut short, Slice.view<u8>(bytes, segment, at - segment))
          if at < bytes.length { run Bytes.append(&mut short, Slice.view<u8>(bytes, at, usize.ONE)) }
          segment = at + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    return Option<Bytes>.some(move short)
  }

  /// Where bytes `start..end` of the declared name of field `label` of struct `ty` are, in its
  /// module; none for a field the standard library declares, or a label that is not the name.
  pub effect fn fieldNameSite(self: &mut Self, ty: &Interned<Type>, label: &[u8], start: usize, end: usize)
  -> Option<StaticExecution.LocatedSite> ! Cycle | OutOfMemoryError ? &mut Allocator {
    let named = Interned<Type>.with<Option<DeclarationId>>(ty, |value: &Type| -> Option<DeclarationId> {
      return match &value.* {
        Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
        _ => Option<DeclarationId>.none()
      }
    })
    let owner = match move named {
      Option<DeclarationId>.Some {value} => move value
      Option<DeclarationId>.None => { return Option<StaticExecution.LocatedSite>.none() }
    }
    let module = ModuleId.copy(DeclarationId.moduleId(&owner))
    if toolchainModule(&module) { return Option<StaticExecution.LocatedSite>.none() }
    let answer = run source(&mut self.resolver.*, &module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&self.resolver.*, &answer, &module) {
      let hir = IndexedSource.authored(indexed)
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let mut at = usize.ZERO
      while at < declarations.length {
        if DeclarationId.equals(&declarations[at].identity, &owner) {
          if let Node.Declaration {header, ..} = Module.node(hir, declarations[at].local) {
            if let Node.StructHeader {fields, ..} = Module.node(hir, header) {
              let mut index = usize.ZERO
              while index < fields.length {
                let field = Module.child(hir, fields, index)
                if let Node.Field {name, ..} = Module.node(hir, field) {
                  if let Node.Name {text} = Module.node(hir, name) {
                    let written = Module.span(hir, name)
                    if same(Module.text(hir, text), label) && written.end - written.start == label.length && end <= label.length {
                      return Option<StaticExecution.LocatedSite>.some(StaticExecution.LocatedSite {module: move module,
                        span: Span.make(written.start + start, written.start + end)})
                    }
                  }
                }
                index = index + usize.ONE
              }
            }
          }
          return Option<StaticExecution.LocatedSite>.none()
        }
        at = at + usize.ONE
      }
    }
    return Option<StaticExecution.LocatedSite>.none()
  }

  /// Whether this resolution keeps editor facts, such as linked literal ranges.
  pub fn editorTables(self: &Self) -> bool {
    return self.resolver.editorTables
  }

  /// Where bytes `start..end` of the text that the literal at `literal` of `module` decodes to are
  /// written, escapes included; none when the literal does not decode to `length` bytes, such as
  /// for a text built from it, or when the standard library writes it.
  pub effect fn literalSite(self: &mut Self, module: &ModuleId, literal: Span, start: usize, end: usize, length: usize)
  -> Option<StaticExecution.LocatedSite> ! Cycle | OutOfMemoryError ? &mut Allocator {
    if toolchainModule(module) { return Option<StaticExecution.LocatedSite>.none() }
    let answer = run source(&mut self.resolver.*, module)
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&self.resolver.*, &answer, module) {
      let bytes = SourceUnit.bytes(IndexedSource.sourceUnit(indexed))
      if let Option<Span>.Some {value: span} = move literalRange(bytes, literal, start, end, length) {
        return Option<StaticExecution.LocatedSite>.some(StaticExecution.LocatedSite {module: ModuleId.copy(module), span: span})
      }
    }
    return Option<StaticExecution.LocatedSite>.none()
  }

  /// A selected `compileError` reported at `located`, relating the call that reached it.
  pub effect fn locatedCompileError(self: &mut Self, located: StaticExecution.LocatedSite,
    related: Option<StaticExecution.LocatedSite>, message: &[u8]) -> Shared<Rejection>
  ! OutOfMemoryError ? &mut Allocator {
    let mut diagnostic = run makeRejection(RejectionCode.SelectedCompileError, &located.module, located.span)
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"detail"), value: run Bytes.copy(message)})
    if let Option<StaticExecution.LocatedSite>.Some {value: call} = move related {
      diagnostic.related = Option<RelatedSite>.some(RelatedSite {module: move call.module, span: call.span})
    }
    return run Shared<Rejection>.make(move diagnostic)
  }

  /// Reflects one closed aggregate through tracked members and exact applied member shapes.
  /// The original reflecting declaration travels with each capability through all source helpers.
  /// `authorization` decides which fields are visible; a rejection reports in `site`, the module
  /// whose code `span` points into.
  pub effect fn reflectedFields(self: &mut Self, ty: &Interned<Type>, authorization: &DeclarationId, site: &ModuleId, span: Span)
  -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let described = run Type.copy(ty)
    let mut elements = List<Interned<StaticData>>.make()
    let declaredModule = DeclarationId.moduleId(authorization)
    let authority = run Types.internDeclaration(DeclarationId.copy(authorization))
    if let Type.Anonymous {occurrence, members} = &described {
      let listed = List<Interned<Type>>.asSlice(&members)
      let positional = AnonymousOccurrence.isPositional(&occurrence)
      let mut ordinal = usize.ZERO
      while ordinal < listed.length {
        let mut kind: u8 = 0
        let mut label = Bytes.make()
        if positional {kind = 1} else {
          label = run reflectedAnonymousLabel(&occurrence, ordinal)
        }
        let descriptor = run CheckedIntrinsic.fieldType(ty, &listed[ordinal])
        let field = match move StaticValue.reflectedField(move descriptor, ordinal, kind, run Shared<Bytes>.make(move label), Interned<DeclarationId>.clone(&authority)) {
          Option<StaticData>.Some {value} => move value
          Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
        }
        run List<Interned<StaticData>>.append(&mut elements, run Interned<StaticData>.make(move field))
        ordinal = ordinal + usize.ONE
      }
    } else if let Type.Nominal {declaration, ..} = &described {
      let kind = DeclarationId.kind(&declaration)
      if kind != OwnerKind.Struct && kind != OwnerKind.Tuple {
        return Result<StaticData, Shared<Rejection>>.failResult(run reflectionOwnerRejection(site, span, ty, false))
      }
      let ownerModule = DeclarationId.moduleId(&declaration)
      let ordinal = match move run ordinalOfIdentity(&mut self.resolver.*, ownerModule, &run Types.internDeclaration(DeclarationId.copy(&declaration))) {
        Option<usize>.Some {value} => value
        Option<usize>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
      }
      let module = run internModule(&mut self.resolver.*, ownerModule)
      let application = run internApplication(&mut self.resolver.*, ty)
      let declarationAccess248Request = Key {
        family: Family.Members, module: module, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
      let declarationAccess248 = run internDeclaration(&mut self.resolver, declarationAccess248Request)
      let members = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess248, span)
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&members, answerCause)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {return Result<StaticData, Shared<Rejection>>.failResult(move value)}
      let count = Shared<Result<Answer, NoRejection>>.with<usize>(&members, reflectedMemberCount)
      let mut at = usize.ZERO
      while at < count {
        let visible = Shared<Result<Answer, NoRejection>>.with<bool>(&members, |answer: &Result<Answer, NoRejection>| -> bool {
          return reflectedMemberVisible(answer, at)
        })
        if visible || ModuleId.equals(declaredModule, ownerModule) {
          let declarationAccess249Request = Key {
            family: Family.MemberShape, module: module, name: application, declaration: ordinal, member: at, external: false}
          let declarationAccess249 = run internDeclaration(&mut self.resolver, declarationAccess249Request)
          let shaped = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, declarationAccess249, span)
          let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shaped, answerCause)
          if let Option<Shared<Rejection>>.Some {value} = move failure {return Result<StaticData, Shared<Rejection>>.failResult(move value)}
          let valueType = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&shaped, singleMemberShapeType) {
            Option<Interned<Type>>.Some {value} => move value
            Option<Interned<Type>>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
          }
          let descriptor = run CheckedIntrinsic.fieldType(ty, &valueType)
          let mut fieldKind: u8 = 0
          let mut label = Bytes.make()
          if kind == OwnerKind.Tuple {fieldKind = 1} else {label = run reflectedMemberLabel(&members, at)}
          let field = match move StaticValue.reflectedField(move descriptor, at, fieldKind, run Shared<Bytes>.make(move label), Interned<DeclarationId>.clone(&authority)) {
            Option<StaticData>.Some {value} => move value
            Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
          }
          run List<Interned<StaticData>>.append(&mut elements, run Interned<StaticData>.make(move field))
        }
        at = at + usize.ONE
      }
    } else {return Result<StaticData, Shared<Rejection>>.failResult(run reflectionOwnerRejection(site, span, ty, false))}
    let collection = run CheckedIntrinsic.fieldsType(ty)
    return match move run StaticValue.reflectedFields(move collection, move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// The target size, alignment and field offsets of the closed type `ty`, for a static layout
  /// query (`Intrinsic.layoutOf`, `Intrinsic.fieldOffset`). The layout is a dependency of the
  /// evaluating query, so an edit to the type, or another target, evaluates it again.
  pub effect fn typeLayout(self: &mut Self, ty: &Interned<Type>, site: &ModuleId, span: Span) -> Result<StaticLayout, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let application = run internErasedType(&mut self.resolver.*, ty)
    let request = Key {family: Family.Layout, module: usize.ZERO, name: application, declaration: usize.ZERO, member: usize.ZERO, external: false}
    let key = run internDeclaration(&mut self.resolver.*, request)
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, layoutIndex) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        if let Option<Shared<Rejection>>.Some {value: cause} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
          return Result<StaticLayout, Shared<Rejection>>.failResult(move cause)
        }
        return Result<StaticLayout, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
      }
    }
    let layouts = List<Shared<BackendLayout>>.asSlice(&self.resolver.layoutValues)
    let layout = Shared<BackendLayout>.clone(&layouts[index])
    let metrics = Shared<BackendLayout>.with<LayoutMetrics>(&layout, BackendLayout.metrics)
    let count = Shared<BackendLayout>.with<usize>(&layout, BackendLayout.fieldCount)
    let mut offsets = run List<usize>.makeWithCapacity(count)
    let mut at = usize.ZERO
    while at < count {
      let offset = Shared<BackendLayout>.with<usize>(&layout, |value: &BackendLayout| -> usize {
        return match move BackendLayout.fieldAt(value, at) {
          Option<LayoutField>.Some {value: field} => field.offset
          Option<LayoutField>.None => usize.MAX
        }
      })
      run List<usize>.append(&mut offsets, offset)
      at = at + usize.ONE
    }
    return Result<StaticLayout, Shared<Rejection>>.succeed(StaticLayout {bytes: metrics.size, alignment: metrics.alignment, offsets: move offsets})
  }

  /// The byte offset of the field `label` in the closed struct `ty` on the checked target, for a
  /// static `Intrinsic.fieldOffset`. The struct's members and its layout are dependencies of the
  /// evaluating query.
  pub effect fn fieldOffset(self: &mut Self, ty: &Interned<Type>, label: &[u8], site: &ModuleId, span: Span) -> Result<usize, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let described = run Type.copy(ty)
    let declaration = match move described {
      Type.Nominal {declaration, ..} => move declaration
      _ => { return Result<usize, Shared<Rejection>>.failResult(run reflectionOwnerRejection(site, span, ty, false)) }
    }
    if DeclarationId.kind(&declaration) != OwnerKind.Struct {
      return Result<usize, Shared<Rejection>>.failResult(run reflectionOwnerRejection(site, span, ty, false))
    }
    let ownerModule = DeclarationId.moduleId(&declaration)
    let ordinal = match move run ordinalOfIdentity(&mut self.resolver.*, ownerModule, &run Types.internDeclaration(DeclarationId.copy(&declaration))) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Result<usize, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span)) }
    }
    let module = run internModule(&mut self.resolver.*, ownerModule)
    let request = Key {family: Family.Members, module: module, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
    let key = run internDeclaration(&mut self.resolver, request)
    let members = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&members, answerCause) {
      return Result<usize, Shared<Rejection>>.failResult(move value)
    }
    let count = Shared<Result<Answer, NoRejection>>.with<usize>(&members, reflectedMemberCount)
    let mut found = usize.MAX
    let mut at = usize.ZERO
    while at < count && found == usize.MAX {
      let name = run reflectedMemberLabel(&members, at)
      if same(Bytes.asSlice(&name), label) { found = at }
      at = at + usize.ONE
    }
    if found == usize.MAX {
      return Result<usize, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
    let layout = match move run StaticPort.typeLayout(&mut self.*, ty, site, span) {
      Result<StaticLayout, Shared<Rejection>>.Success {value} => move value
      Result<StaticLayout, Shared<Rejection>>.Failure {error} => { return Result<usize, Shared<Rejection>>.failResult(move error) }
    }
    let offsets = List<usize>.asSlice(&layout.offsets)
    if found >= offsets.length || offsets[found] == usize.MAX {
      return Result<usize, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
    return Result<usize, Shared<Rejection>>.succeed(offsets[found])
  }
  /// Reflects the variants of one closed nominal union in declaration order, each named by its
  /// tag. Variants have no visibility of their own; `authorization` travels with each descriptor
  /// and decides which of its fields `reflectedVariantFields` lists.
  pub effect fn reflectedVariants(self: &mut Self, ty: &Interned<Type>, authorization: &DeclarationId, site: &ModuleId, span: Span)
  -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let nominal = match move run nominalUnionOf(&mut self.resolver.*, ty) {
      Option<NominalUnion>.Some {value} => value
      Option<NominalUnion>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reflectionOwnerRejection(site, span, ty, true))}
    }
    let authority = run Types.internDeclaration(DeclarationId.copy(authorization))
    let membersRequest = Key {
      family: Family.Members, module: nominal.module, name: usize.ZERO, declaration: nominal.declaration, member: usize.ZERO, external: false}
    let membersKey = run internDeclaration(&mut self.resolver, membersRequest)
    let members = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, membersKey, span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&members, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {return Result<StaticData, Shared<Rejection>>.failResult(move value)}
    let descriptor = run CheckedIntrinsic.variantType(ty)
    let mut elements = List<Interned<StaticData>>.make()
    let mut tag = usize.ZERO
    while tag < nominal.count {
      let label = run reflectedMemberLabel(&members, tag)
      let variant = match move StaticValue.reflectedVariant(Interned<Type>.clone(&descriptor), tag, run Shared<Bytes>.make(move label),
        Interned<DeclarationId>.clone(&authority)) {
        Option<StaticData>.Some {value} => move value
        Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
      }
      run List<Interned<StaticData>>.append(&mut elements, run Interned<StaticData>.make(move variant))
      tag = tag + usize.ONE
    }
    let collection = run CheckedIntrinsic.variantsType(ty)
    return match move run StaticValue.reflectedVariants(move collection, move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// Reflects the fields of the variant `tag` of one closed nominal union at their applied types,
  /// as `Field<Union, Value>` descriptors of kind 2. Only the fields visible from the module of
  /// `authorization` are listed.
  pub effect fn reflectedVariantFields(self: &mut Self, ty: &Interned<Type>, tag: usize, authorization: &Interned<DeclarationId>, site: &ModuleId,
    span: Span) -> Result<StaticData, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let nominal = match move run nominalUnionOf(&mut self.resolver.*, ty) {
      Option<NominalUnion>.Some {value} => value
      Option<NominalUnion>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
    }
    let shape = match move run variantShape(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, site, ty, &nominal, tag, span) {
      Result<VariantShape, Shared<Rejection>>.Success {value} => move value
      Result<VariantShape, Shared<Rejection>>.Failure {error} => {return Result<StaticData, Shared<Rejection>>.failResult(move error)}
    }
    let declaredModule = Interned<DeclarationId>.with<ModuleId>(authorization, |identity: &DeclarationId| -> ModuleId {
      return ModuleId.copy(DeclarationId.moduleId(identity))
    })
    let names = List<Bytes>.asSlice(&shape.names)
    let types = List<Interned<Type>>.asSlice(&shape.types)
    let mut elements = List<Interned<StaticData>>.make()
    let mut at = usize.ZERO
    while at < types.length {
      if variantFieldVisible(&self.resolver.*, &declaredModule, &shape, at) {
        let descriptor = run CheckedIntrinsic.fieldType(ty, &types[at])
        let label = run Shared<Bytes>.make(run Bytes.copy(Bytes.asSlice(&names[at])))
        let field = match move StaticValue.reflectedField(move descriptor, at, 2, move label, Interned<DeclarationId>.clone(authorization)) {
          Option<StaticData>.Some {value} => move value
          Option<StaticData>.None => {return Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))}
        }
        run List<Interned<StaticData>>.append(&mut elements, run Interned<StaticData>.make(move field))
      }
      at = at + usize.ONE
    }
    let collection = run CheckedIntrinsic.fieldsType(ty)
    return match move run StaticValue.reflectedFields(move collection, move elements) {
      Option<StaticData>.Some {value} => Result<StaticData, Shared<Rejection>>.succeed(move value)
      Option<StaticData>.None => Result<StaticData, Shared<Rejection>>.failResult(run reject(&self.resolver.*, site, RejectionCode.StaticPhaseViolation, span))
    }
  }
  /// Demands the exact reached body through the active query and records its dependency edge.
  pub effect fn demandBody(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<
    Shared<Result<Answer, NoRejection>>,
  > ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      // A runtime body with static work, such as a call that takes a static template, is checked
      // as its selected application, as the declaration sweep checks it; its unselected body
      // answer holds no table of the names it resolves.
      let mut member = usize.ZERO
      let routing = run needsStaticResidualization(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, moduleOrdinal, ordinal)
      let residual = match move routing {
        Result<bool, Shared<Rejection>>.Success {value} => value
        Result<bool, Shared<Rejection>>.Failure {..} => false
      }
      if residual {
        let signatureRequest = Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
        let signatureKey = run internDeclaration(&mut self.resolver, signatureRequest)
        let signature = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, signatureKey, span)
        if !Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsStatic) {
          let instance = run InstanceKey.named(&identity)
          let application = run InstanceKey.selected(&instance)
          let interned = run internSelectedApplication(&mut self.resolver, &application)
          member = interned + usize.ONE
        }
      }
      let declarationAccess250Request = Key {
          family: Family.Body,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: member,
          external: false,
        }
      let declarationAccess250 = run internDeclaration(&mut self.resolver, declarationAccess250Request)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        declarationAccess250,
        span,
      )
      return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
    }
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }
  /// Demands the selected declaration's written signature in the active query.
  /// The answer retains any semantic rejection alongside canonical parameter types.
  pub effect fn demandSignature(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let declarationAccess251Request = Key {
          family: Family.Signature,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: ordinal,
          member: usize.ZERO,
          external: false,
        }
      let declarationAccess251 = run internDeclaration(&mut self.resolver, declarationAccess251Request)
      let answer = run demandChild(
        &mut self.resolver.*,
        &mut self.query.*,
        &mut self.dependencies.*,
        declarationAccess251,
        span,
      )
      return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
    }
    return Option<Shared<Result<Answer, NoRejection>>>.none()
  }
  /// The literal ranges a constant's initializer linked to fields, read from its `Initializer`
  /// answer in the active query; empty for a store without editor tables or a refused value.
  pub effect fn constantLinks(self: &mut Self, declaration: &DeclarationId, span: Span) -> Option<Shared<List<LinkedName>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let module = DeclarationId.moduleId(declaration)
    let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
    let selected = run ordinalOfIdentity(&mut self.resolver.*, module, &identity)
    if let Option<usize>.Some {value: ordinal} = move selected {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let request = Key {family: Family.Initializer, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
      let key = run internDeclaration(&mut self.resolver, request)
      let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
      return Shared<Result<Answer, NoRejection>>.with<Option<Shared<List<LinkedName>>>>(&answer, |held: &Result<Answer, NoRejection>| -> Option<Shared<List<LinkedName>>> {
        if let Result<Answer, NoRejection>.Success {value} = &held.* {
          if let Outcome.Success {value: Value.Initializer {links: Option<Shared<List<LinkedName>>>.Some {value: listed}, ..}} = &value.outcome {
            return Option<Shared<List<LinkedName>>>.some(Shared<List<LinkedName>>.clone(&listed))
          }
        }
        return Option<Shared<List<LinkedName>>>.none()
      })
    }
    return Option<Shared<List<LinkedName>>>.none()
  }
  /// The module-level ordinal of one declaration in its own module, if it is still indexed.
  pub effect fn declarationOrdinal(self: &mut Self, declaration: &DeclarationId) -> Option<usize>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
    return run ordinalOfIdentity(&mut self.resolver.*, DeclarationId.moduleId(declaration), &identity)
  }
  /// MODULE-STATIC-002: whether one indexed declaration is present, demanding each enclosing
  /// module-level arm's condition as a dependency of the active query.
  pub effect fn declarationAvailable(self: &mut Self, module: &ModuleId, declaration: usize, span: Span) -> Result<bool, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run available(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, declaration, span)
  }
  /// Resolves one documentation name with the same profile admission, collisions, import aliases
  /// and external visibility as language lookup. This never requests a callable signature/body.
  pub effect fn documentationBinding(self: &mut Self, module: &ModuleId, name: &[u8], external: bool)
  -> Result<Option<DocumentationBinding>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let selected = match move run select(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, name, external) {
      Result<Selection, Shared<Rejection>>.Success {value} => value
      Result<Selection, Shared<Rejection>>.Failure {error} => {
        return Result<Option<DocumentationBinding>, Shared<Rejection>>.failResult(move error)
      }
    }
    if selected.count == usize.ZERO || (external && selected.publicCount == usize.ZERO) {
      return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(Option<DocumentationBinding>.none())
    }
    if selected.count != usize.ONE {
      return Result<Option<DocumentationBinding>, Shared<Rejection>>.failResult(
        run nameCollision(&self.resolver.*, module, selected, name))
    }
    if selected.kind == CandidateKind.Declaration {
      if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut self.resolver.*, module, selected.declaration) {
        return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(
          Option<DocumentationBinding>.some(DocumentationBinding.Declaration {identity: move value, isPublic: selected.isPublic}))
      }
    } else {
      let moduleOrdinal = run internModule(&mut self.resolver.*, module)
      let mut member = selected.member
      if selected.kind == CandidateKind.ImportModule { member = usize.MAX }
      let key = run internDeclaration(&mut self.resolver.*, Key {
        family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
        declaration: selected.declaration, member: member, external: false,
      })
      let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, selected.span)
      let binding = documentationImportSelection(&self.resolver.*, &answer)
      if let Option<Shared<Rejection>>.Some {value} = move binding.rejected {
        return Result<Option<DocumentationBinding>, Shared<Rejection>>.failResult(move value)
      }
      if let Option<usize>.Some {value: destination} = move binding.module {
        let target = resolvedModule(&self.resolver.*, destination)
        if let Option<usize>.Some {value: ordinal} = move binding.declaration {
          if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut self.resolver.*, &target, ordinal) {
            return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(
              Option<DocumentationBinding>.some(DocumentationBinding.Declaration {identity: move value, isPublic: selected.isPublic}))
          }
        } else {
          return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(
            Option<DocumentationBinding>.some(DocumentationBinding.Namespace {module: move target, isPublic: selected.isPublic}))
        }
      }
    }
    return Result<Option<DocumentationBinding>, Shared<Rejection>>.succeed(Option<DocumentationBinding>.none())
  }

  /// What the import declared at `declaration` of `module` names: its module, or with `member`
  /// the selected member at that ordinal; none when the import is rejected.
  pub effect fn documentationImport(self: &mut Self, module: &ModuleId, declaration: usize, member: Option<usize>, span: Span)
  -> Option<DocumentationBinding>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let mut selected = usize.MAX
    if let Option<usize>.Some {value} = move member { selected = value }
    let key = run internDeclaration(&mut self.resolver.*, Key {
      family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
      declaration: declaration, member: selected, external: false,
    })
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    let binding = documentationImportSelection(&self.resolver.*, &answer)
    if let Option<Shared<Rejection>>.Some {..} = &binding.rejected {
      return Option<DocumentationBinding>.none()
    }
    if let Option<usize>.Some {value: destination} = move binding.module {
      let target = resolvedModule(&self.resolver.*, destination)
      if let Option<usize>.Some {value: ordinal} = move binding.declaration {
        if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut self.resolver.*, &target, ordinal) {
          return Option<DocumentationBinding>.some(DocumentationBinding.Declaration {identity: move value, isPublic: false})
        }
        return Option<DocumentationBinding>.none()
      }
      return Option<DocumentationBinding>.some(DocumentationBinding.Namespace {module: move target, isPublic: false})
    }
    return Option<DocumentationBinding>.none()
  }

  /// Whether the module-private import binding `name` of `module` can serve calls that never
  /// spell it: an interface, whose operations method syntax and `Type.operation` calls find
  /// through the import, or a namespace whose module publishes an interface. The unused-import
  /// warning (MOD0007) leaves such a binding unreported; a refused import reports its error.
  pub effect fn importServesCalls(self: &mut Self, module: &ModuleId, name: &[u8]) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let bound = match move run StaticPort.documentationBinding(&mut self.*, module, name, false) {
      Result<Option<DocumentationBinding>, Shared<Rejection>>.Success {value} => move value
      Result<Option<DocumentationBinding>, Shared<Rejection>>.Failure {..} => { return false }
    }
    let binding = match move bound {
      Option<DocumentationBinding>.Some {value} => move value
      Option<DocumentationBinding>.None => { return false }
    }
    return match move binding {
      DocumentationBinding.Declaration {identity, ..} => {
        let interned = run Types.internDeclaration(DeclarationId.copy(&identity))
        let owner = DeclarationId.moduleId(&identity)
        match move run ordinalOfIdentity(&mut self.resolver.*, owner, &interned) {
          Option<usize>.Some {value: ordinal} => match move run scopedHeader(&mut self.resolver.*, owner, ordinal) {
            Option<HeaderSyntax>.Some {value: written} => match written.header {
              Node.InterfaceHeader {..} => true
              _ => false
            }
            Option<HeaderSyntax>.None => false
          }
          Option<usize>.None => false
        }
      }
      DocumentationBinding.Namespace {module: target, ..} => {
        let ordinal = run internModule(&mut self.resolver.*, &target)
        let mut names = List<VisibleName>.make()
        run appendInterfaceNames(&mut self.resolver.*, &target, ordinal, true, &mut names)
        List<VisibleName>.length(&names) > usize.ZERO
      }
    }
  }

  /// Resolves an inherent member through publication, without demanding its signature. Invalid
  /// heads and duplicate members remain semantic rejections, never guessed source winners.
  pub effect fn documentationMember(self: &mut Self, module: &ModuleId, owner: &[u8], name: &[u8])
  -> Result<Option<DeclarationId>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let answer = run demandNamed(&mut self.resolver.*, &mut self.query.*, module, owner, Family.InherentMembers)
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
      return Result<Option<DeclarationId>, Shared<Rejection>>.failResult(move value)
    }
    let found = Shared<Result<Answer, NoRejection>>.with<InherentLookup>(&answer,
      |value: &Result<Answer, NoRejection>| -> InherentLookup { return inherentLookup(value, name) })
    if let Option<Shared<Rejection>>.Some {value} = move found.rejected {
      return Result<Option<DeclarationId>, Shared<Rejection>>.failResult(move value)
    }
    if let Option<Interned<DeclarationId>>.Some {value} = move found.published {
      return Result<Option<DeclarationId>, Shared<Rejection>>.succeed(
        Option<DeclarationId>.some(DeclarationId.copyShared(&value)))
    }
    return Result<Option<DeclarationId>, Shared<Rejection>>.succeed(Option<DeclarationId>.none())
  }

  /// Validates one implementation head without checking members or callable bodies, and reports
  /// whether its nominal provider and contract are both externally published.
  pub effect fn documentationImplementationPublic(self: &mut Self, module: &ModuleId, ordinal: usize, span: Span)
  -> Result<bool, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let key = run internDeclaration(&mut self.resolver.*, Key {
      family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    })
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
      return Result<bool, Shared<Rejection>>.failResult(move value)
    }
    let head = Shared<Result<Answer, NoRejection>>.with<Option<Shared<ImplementationHead>>>(&answer,
      |result: &Result<Answer, NoRejection>| -> Option<Shared<ImplementationHead>> {
        if let Result<Answer, NoRejection>.Success {value} = &result.* {
          if let Outcome.Success {value: Value.ImplementationHead {head}} = &value.outcome {
            return Option<Shared<ImplementationHead>>.some(Shared<ImplementationHead>.clone(&head))
          }
        }
        return Option<Shared<ImplementationHead>>.none()
      })
    if let Option<Shared<ImplementationHead>>.Some {value: resolvedHead} = move head {
      let provider = Shared<ImplementationHead>.with<Option<DeclarationId>>(&resolvedHead,
        |head: &ImplementationHead| -> Option<DeclarationId> { return Interned<Type>.with<Option<DeclarationId>>(&head.provider, nominalOf) })
      let contract = Shared<ImplementationHead>.with<Option<DeclarationId>>(&resolvedHead,
        |head: &ImplementationHead| -> Option<DeclarationId> {
          if let Option<Interned<Type>>.Some {value: contractType} = &head.contract { return Interned<Type>.with<Option<DeclarationId>>(&contractType, nominalOf) }
          return Option<DeclarationId>.none()
        })
      let mut declarations = List<DeclarationId>.make()
      if let Option<DeclarationId>.Some {value: identity} = move provider { run List<DeclarationId>.append(&mut declarations, move identity) }
      if let Option<DeclarationId>.Some {value: identity} = move contract { run List<DeclarationId>.append(&mut declarations, move identity) }
      let listed = List<DeclarationId>.asSlice(&declarations)
      let mut at = usize.ZERO
      while at < listed.length {
        let spelling = run DeclarationId.copySpelling(&listed[at])
        let selected = run StaticPort.documentationBinding(&mut self.*, DeclarationId.moduleId(&listed[at]), Bytes.asSlice(&spelling), true)
        match move selected {
          Result<Option<DocumentationBinding>, Shared<Rejection>>.Failure {error} => { return Result<bool, Shared<Rejection>>.failResult(move error) }
          Result<Option<DocumentationBinding>, Shared<Rejection>>.Success {value} => {
            if let Option<DocumentationBinding>.None = move value { return Result<bool, Shared<Rejection>>.succeed(false) }
          }
        }
        at = at + usize.ONE
      }
      return Result<bool, Shared<Rejection>>.succeed(true)
    }
    return Result<bool, Shared<Rejection>>.failResult(run reject(&self.resolver.*, module, RejectionCode.Undetermined, span))
  }

  /// Returns an implementation's nominal provider for documentation owner scope. Structural
  /// providers have no nominal owner. The shared implementation-head query authenticates it.
  pub effect fn documentationProvider(self: &mut Self, module: &ModuleId, ordinal: usize, span: Span)
  -> Result<Option<DeclarationId>, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let moduleOrdinal = run internModule(&mut self.resolver.*, module)
    let key = run internDeclaration(&mut self.resolver.*, Key {
      family: Family.ImplementationHead, module: moduleOrdinal, name: usize.ZERO,
      declaration: ordinal, member: usize.ZERO, external: false,
    })
    let answer = run demandChild(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, key, span)
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
      return Result<Option<DeclarationId>, Shared<Rejection>>.failResult(move value)
    }
    let provider = Shared<Result<Answer, NoRejection>>.with<Option<DeclarationId>>(&answer,
      |result: &Result<Answer, NoRejection>| -> Option<DeclarationId> {
        if let Result<Answer, NoRejection>.Success {value} = &result.* {
          if let Outcome.Success {value: Value.ImplementationHead {head}} = &value.outcome {
            return Shared<ImplementationHead>.with<Option<DeclarationId>>(&head,
              |providerHead: &ImplementationHead| -> Option<DeclarationId> { return Interned<Type>.with<Option<DeclarationId>>(&providerHead.provider, nominalOf) })
          }
        }
        return Option<DeclarationId>.none()
      })
    return Result<Option<DeclarationId>, Shared<Rejection>>.succeed(move provider)
  }
  /// Whether one reached call in a declaration's body names a static function, read from the
  /// callee's tracked header exactly as body routing reads it.
  pub effect fn callPhase(self: &mut Self, module: &ModuleId, declaration: usize, call: HirId) -> Result<CallPhase, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run writtenCallPhase(&mut self.resolver.*, &mut self.query.*, &mut self.dependencies.*, module, declaration, call)
  }
  /// Checks one reached static expression through the active query, preserving its source IDs.
  /// A mixed body's inactive static arms are never checked by this demand.
  /// Supplies evaluated bindings to nested compile-time counts without re-evaluating their initializers.
  pub effect fn demandCheckedRoot(
    self: &mut Self,
    module: &ModuleId,
    declaration: Option<usize>,
    root: HirId,
    expectation: StaticRootExpectation,
    binders: &[StaticRootBinder],
    bindings: &[StaticBinding],
  ) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let answer = run checkedStaticRoot(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      module,
      move declaration,
      root,
      move expectation,
      binders,
      bindings,
    )
    return run Shared<Result<Answer, NoRejection>>.make(
      Result<Answer, NoRejection>.succeed(move answer),
    )
  }

  /// Selects an unqualified static demand root through the shared declaration query.
  pub effect fn resolveRootDeclaration(
    self: &mut Self,
    module: &ModuleId,
    name: &[u8],
    span: Span,
  ) -> Result<DeclarationId, Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    let caller = run internModule(&mut self.resolver.*, module)
    let chosen = run selectDeclaration(
      &mut self.resolver.*,
      &mut self.query.*,
      &mut self.dependencies.*,
      caller,
      module,
      name,
      false,
      span,
      RejectionCode.UnknownFunction, RejectionCode.NotCallable, false)
    return match move chosen {
      Result<SelectedDeclaration, Shared<Rejection>>.Success {value} => {
        let selected = resolvedModule(&self.resolver.*, value.module)
        let declaration = run declarationAt(&mut self.resolver.*, &selected, value.ordinal)
        return match move declaration {
          Option<DeclarationId>.Some {value: identity} => Result<
            DeclarationId,
            Shared<Rejection>,
          >.succeed(move identity)
          Option<DeclarationId>.None => Result<DeclarationId, Shared<Rejection>>.failResult(
            run reject(&self.resolver.*, module, RejectionCode.NotCallable, span),
          )
        }
      }
      Result<SelectedDeclaration, Shared<Rejection>>.Failure {error} => Result<
        DeclarationId,
        Shared<Rejection>,
      >.failResult(move error)
    }
  }
}

pub fn absurd<T>() -> T {
  return Intrinsic.trap("an internal invariant failed")
}

pub fn callableInvocationMode(value: &Type) -> CallableMode {
  return match &value.* {
    Type.Callable {mode, ..} => mode
    Type.Effect {mode, ..} => mode
    Type.CallableValue {contract, ..} => Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.CallableWitnessResult {witness} => {
      let recipe = Frozen<WitnessRecipe>.with<WitnessRecipe>(&witness, CallableWitness.copy)
      return Interned<Type>.with<CallableMode>(&recipe.result, callableInvocationMode)
    }
    Type.CallableResult {contract, ..} => Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.CallableStage {contract, ..} => Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.CallableSchema {schema, ..} => Interned<Type>.with<CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode)
    Type.EffectComposite {contract, ..} => Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.EffectJoin {contract, ..} => Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
    Type.OpaqueRepresentation {contract, ..} => Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
    _ => CallableMode.Once
  }
}

// A section blueprint binds target variables; selected values remain separate free evidence.
pub effect fn sectionContextUndetermined(contract: &Interned<Type>, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = match move run CallableContract.ofType(contract) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return false }
  }
  let parameters = List<Interned<Type>>.asSlice(&facts.parameters)
  let mut at = usize.ZERO
  while at < parameters.length {
    if run typeMentionsOwner(&parameters[at], owner) { return true }
    at = at + usize.ONE
  }
  return run typeMentionsOwner(&facts.result, owner)
}

// Admission specializes a comparison contract, never the immutable value or its runtime key.
// Target binders are opened before the context is introduced, including recursive owner uses.
// With a pending call owner, positions mentioning its still-open variables are not evidence, and
// a contract those positions leave undetermined is absent rather than rejected.
pub effect fn contextualCallableContract(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, declared: &[Constraint], actual: &Interned<Type>,
  promised: &Interned<Type>, pending: &Option<DeclarationId>, span: Span) -> Result<Option<Interned<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let schema = match move Interned<Type>.with<Option<Frozen<SectionSchema>>>(actual, sectionSchemaOf) {
    Option<Frozen<SectionSchema>>.Some {value} => move value
    _ => { return Result<Option<Interned<Type>>, Shared<Rejection>>.succeed(run valueCallableContract(actual, declared)) }
  }
  let wanted = match move run CallableContract.ofType(promised) {
    Option<CallableFacts>.Some {value} => move value
    _ => { return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
  }
  let savedInfer = resolver.nextInferenceId
  let freshShared = run freshInferOwner(&mut resolver.*)
  let rigidShared = run freshInferOwner(&mut resolver.*)
  let result = run contextualCallableContractWithOwners(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, declared, actual, &schema,
    move wanted, pending, &freshShared, &rigidShared, span,
  )
  if resolver.nextInferenceId == savedInfer + 2 {
    resolver.nextInferenceId = savedInfer
  }
  return move result
}

effect fn contextualCallableContractWithOwners(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, declared: &[Constraint], actual: &Interned<Type>,
  schema: &Frozen<SectionSchema>, wantedInput: CallableFacts, pending: &Option<DeclarationId>,
  freshShared: &Interned<DeclarationId>, rigidShared: &Interned<DeclarationId>, span: Span)
  -> Result<Option<Interned<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut wanted = move wantedInput
  let copied = run CallableSchema.copy(schema)
  let target = DeclarationId.copyShared(&copied.target)
  let fresh = DeclarationId.copyShared(freshShared)
  // Only the offered owner is inferable. A promise's invocation regions remain rigid and
  // cannot acquire the enclosing body's local-loan premises.
  let rigid = DeclarationId.copyShared(rigidShared)
  let quantified = wanted.invocationBinders != usize.ZERO
  let mut premises = run copyConstraints(declared)
  if quantified {
    let original = List<Interned<Type>>.asSlice(&wanted.parameters)
    let mut parameters = List<Interned<Type>>.make()
    let mut at = usize.ZERO
    while at < original.length {
      if Type.containsInvocationQuantifier(&original[at]) {
        return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
      }
      run List<Interned<Type>>.append(&mut parameters, run Type.openInvocation(&original[at], &rigid))
      at = at + usize.ONE
    }
    if Type.containsInvocationQuantifier(&wanted.result) {
      return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
    }
    wanted.parameters = move parameters
    wanted.result = run Type.openInvocation(&wanted.result, &rigid)
    let bounds = List<Outlives>.asSlice(&wanted.invocationBounds)
    at = usize.ZERO
    while at < bounds.length {
      run List<Constraint>.append(&mut premises, Constraint.Outlives {
        longer: run Type.openInvocationLifetime(&bounds[at].longer, &rigid),
        shorter: run Type.openInvocationLifetime(&bounds[at].shorter, &rigid)})
      at = at + usize.ONE
    }
    // A marked `for<use 'call>` promise lends every input for the whole invocation extent.
    run invocationUseConstraints(List<Interned<Type>>.asSlice(&wanted.parameters), wanted.invocationUse,
      &Option<DeclarationId>.some(DeclarationId.copy(&rigid)), &mut premises)
  }
  // The section's own lifetimes stay open, held as evidence, so a bound below can shorten an
  // environment binder its captures fixed (`outlivesShortenedBinders`), as an invocation does.
  let mut held = List<Binding>.make()
  let actualInputs = run sectionFieldInputs(actual)
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, schema,
    List<CallableFieldInput>.asSlice(&actualInputs), &fresh, module, span, true, &mut held) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(move error) }
  }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&opened, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
  }
  if quantified && (Type.containsInvocationQuantifier(&facts.result) || Type.containsInvocationQuantifier(&facts.failure)) {
    return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
  }
  let parameters = List<Interned<Type>>.asSlice(&wanted.parameters)
  if parameters.length != facts.parameters {
    return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
  }
  let mut variables = List<Interned<DeclarationId>>.make()
  run List<Interned<DeclarationId>>.append(&mut variables, Interned<DeclarationId>.clone(freshShared))
  let mut inferred = move held
  let mut at = usize.ZERO
  while at < parameters.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&opened,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, at) }) {
      Option<Interned<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    if quantified && Type.containsInvocationQuantifier(&pattern) {
      return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
    }
    if !run mentionsPending(&parameters[at], pending) {
      run inferSectionCallableShape(&pattern, &parameters[at], List<Interned<DeclarationId>>.asSlice(&variables), &mut inferred)
    }
    at = at + usize.ONE
  }
  // Invoking an `effect fn` target constructs its Effect, whose channels carry the written result.
  let mut wantedResult = Interned<Type>.clone(&wanted.result)
  if facts.isEffect {
    let delayed = Interned<Type>.with<Option<EffectChannels>>(&wanted.result, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move delayed {
      if !run mentionsPending(&channels.failure, pending) {
        run inferSectionCallableShape(&facts.failure, &channels.failure, List<Interned<DeclarationId>>.asSlice(&variables), &mut inferred)
      }
      wantedResult = move channels.success
    }
  }
  if !run mentionsPending(&wantedResult, pending) {
    run inferSectionCallableShape(&facts.result, &wantedResult, List<Interned<DeclarationId>>.asSlice(&variables), &mut inferred)
  }
  let freshIdentity = Interned<DeclarationId>.clone(freshShared)
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, List<Constraint>.asSlice(&premises), &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {value} = move inferenceFailure {
    return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(move value)
  }
  let undetermined = match &pending.* { Option<DeclarationId>.Some {..} => true _ => false }
  let mut closing = List<Binding>.make()
  if quantified {
    let mut request = Request.make()
    let source = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
      &mut dependencies.*, true, &target, span) {
      Option<TargetSchema>.Some {value} => move value
      _ => { return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
    }
    let mapped = run quantifiedSectionSlots(&copied, &source, &opened, &fresh, &rigid,
      List<Binding>.asSlice(&inferred), wanted.invocationBinders)
    let slots = match move mapped {
      Option<List<QuantifiedSectionSlot>>.Some {value} => move value
      // Deferred type/row evidence containing invocation regions needs its own recipe proof.
      _ => { return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
    }
    let retained = List<QuantifiedSectionSlot>.asSlice(&slots)
    let mut at = usize.ZERO
    while at < retained.length {
      if sectionInferenceOrdinal(&source, &opened, retained[at].original) != retained[at].dense {
        fail RevisionMismatch {}
      }
      run List<Binding>.append(&mut closing, Binding {
        declaration: Interned<DeclarationId>.clone(rigidShared), ordinal: retained[at].invocation,
        value: Argument.Lifetime {value: run Types.internLifetime(Lifetime.Invocation {ordinal: retained[at].invocation})}})
      at = at + usize.ONE
    }
  }
  let unwritten = List<usize>.make()
  drop run outlivesShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh, &mut inferred,
    List<usize>.asSlice(&unwritten), List<Constraint>.asSlice(&premises), span)
  let mut bounds = List<Constraint>.make()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&opened,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      let applied = run bindConstraint(&value, List<Binding>.asSlice(&inferred))
      if run constraintMentionsOwner(&applied, &fresh) {
        if undetermined { return Result<Option<Interned<Type>>, Shared<Rejection>>.succeed(Option<Interned<Type>>.none()) }
        return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
      }
      run List<Constraint>.append(&mut bounds, move applied)
    }
    at = at + usize.ONE
  }
  let failed = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &premises,
    List<Constraint>.asSlice(&bounds), module, span, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {value} = move failed { return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(move value) }
  let assigned = List<Binding>.asSlice(&inferred)
  let mut result = run Type.applyBindings(&facts.result, assigned, true)
  if facts.isEffect {
    let constructed = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, assigned,
      Interned<Type>.clone(&result), run Type.applyBindings(&facts.failure, assigned, true),
      run Row.applyBindings(&facts.requirements, assigned, true), declared, span) {
      Result<Interned<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Interned<Type>, Shared<Rejection>>.Failure {error} => { return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(move error) }
    }
    result = move constructed
  }
  let mut invocationBounds = List<Outlives>.make()
  let obligations = List<Constraint>.asSlice(&bounds)
  at = usize.ZERO
  while at < obligations.length {
    if let Constraint.Outlives {longer, shorter} = &obligations[at] {
      run List<Outlives>.append(&mut invocationBounds, Outlives {
        longer: run Type.applyLifetimeBindings(&longer, List<Binding>.asSlice(&closing)),
        shorter: run Type.applyLifetimeBindings(&shorter, List<Binding>.asSlice(&closing))})
    }
    at = at + usize.ONE
  }
  let mut invocationBinders = wanted.invocationBinders
  let mut invocationUse = wanted.invocationUse
  if !quantified {
    let source = match move run CallableContract.ofType(&copied.contract) {
      Option<CallableFacts>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    invocationBinders = source.invocationBinders
    invocationUse = source.invocationUse
  }
  let contract = run sectionInstantiatedContract(&opened, &copied.contract, assigned, move result,
    invocationBinders, invocationUse, move invocationBounds)
  if run typeMentionsOwner(&contract, &fresh) {
    if undetermined { return Result<Option<Interned<Type>>, Shared<Rejection>>.succeed(Option<Interned<Type>>.none()) }
    return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.IncompatibleCallableSignature, span))
  }
  if quantified {
    if run quantifiedSectionEnvironment(&contract, &fresh, &rigid) {
      return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
    }
  }
  let closed = run Type.applyBindings(&contract, List<Binding>.asSlice(&closing), true)
  let retainsRigid = run typeMentionsOwner(&closed, &rigid)
  let retainsFresh = run typeMentionsOwner(&closed, &fresh)
  if retainsRigid || retainsFresh {
    return Result<Option<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
  }
  return Result<Option<Interned<Type>>, Shared<Rejection>>.succeed(Option<Interned<Type>>.some(move closed))
}

// All three coordinates are proof-local. The immutable schema keeps its original ordinals.
struct QuantifiedSectionSlot {
  original: usize,
  dense: usize,
  invocation: usize,
}

effect fn quantifiedSectionSlots(recipe: &SectionSchema, source: &TargetSchema,
  opened: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, rigid: &DeclarationId,
  inferred: &[Binding], count: usize) -> Option<List<QuantifiedSectionSlot>>
! OutOfMemoryError ? &mut Allocator {
  let own = List<ApplicationSlot>.asSlice(&source.own)
  let mut mapped = List<QuantifiedSectionSlot>.make()
  let mut at = usize.ZERO
  while at < inferred.length {
    if run argumentMentionsOwner(&inferred[at].value, rigid) {
      let identity = DeclarationId.copyShared(&inferred[at].declaration)
      if !DeclarationId.equals(&identity, fresh) { return Option<List<QuantifiedSectionSlot>>.none() }
      let invocation = match &inferred[at].value {
        Argument.Lifetime {value} => ownedLifetimeOrdinal(&value, rigid)
        _ => usize.MAX
      }
      if invocation >= count { return Option<List<QuantifiedSectionSlot>>.none() }
      let mut found = false
      let mut slot = usize.ZERO
      while slot < own.length {
        if own[slot].kind == GenericKind.Lifetime && containsOrdinal(&recipe.deferred, own[slot].ordinal)
          && sectionInferenceOrdinal(source, opened, own[slot].ordinal) == inferred[at].ordinal {
          run List<QuantifiedSectionSlot>.append(&mut mapped, QuantifiedSectionSlot {
            original: own[slot].ordinal, dense: inferred[at].ordinal, invocation: invocation})
          found = true
        }
        slot = slot + usize.ONE
      }
      if !found { return Option<List<QuantifiedSectionSlot>>.none() }
    }
    at = at + usize.ONE
  }
  return Option<List<QuantifiedSectionSlot>>.some(move mapped)
}

// Retained storage cannot depend on one invocation's private proof or quantifier.
effect fn quantifiedSectionEnvironment(contract: &Interned<Type>, fresh: &DeclarationId, rigid: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let facts = match move run CallableContract.ofType(contract) {
    Option<CallableFacts>.Some {value} => move value _ => { return true }
  }
  let regions = run callableEnvironmentRegions(&facts.environment)
  let listed = List<Interned<Lifetime>>.asSlice(&regions)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut owned = List<usize>.make()
    run Type.collectOwnedLifetime(&listed[at], fresh, &mut owned)
    run Type.collectOwnedLifetime(&listed[at], rigid, &mut owned)
    run Type.collectLifetime(&listed[at], &mut owned)
    if List<usize>.length(&owned) != usize.ZERO { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether a contextual position still mentions the calling inference's open variables.
effect fn mentionsPending(value: &Interned<Type>, pending: &Option<DeclarationId>) -> bool
! OutOfMemoryError ? &mut Allocator {
  return match &pending.* {
    Option<DeclarationId>.Some {value: caller} => run typeMentionsOwner(value, &caller)
    Option<DeclarationId>.None => false
  }
}

// Learn referent variables even when reference access or validity differs. This is inference
// only: CallableContract.compare proves the direction of access and lifetime conversion.
pub effect fn inferSectionCallableShape(pattern: &Interned<Type>, actual: &Interned<Type>,
  variables: &[Interned<DeclarationId>], inferred: &mut List<Binding>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  drop run Type.unify(pattern, actual, variables, Comparison.Exact, &mut inferred.*)
  let left = run Type.copy(pattern)
  let right = run Type.copy(actual)
  match move left {
    Type.Reference {referent, ..} => {
      if let Type.Reference {referent: other, ..} = move right {
        run inferSectionCallableShape(&referent, &other, variables, &mut inferred.*)
      }
    }
    Type.Slice {element, ..} => {
      if let Type.Slice {element: other, ..} = move right {
        run inferSectionCallableShape(&element, &other, variables, &mut inferred.*)
      }
    }
    _ => ()
  }
}

// The section's invocation contract under one use's bindings. The use supplies the instantiated
// result; like the blueprint's, it retains the regions the section captured.
effect fn sectionInstantiatedContract(signature: &Shared<Result<Answer, NoRejection>>, visible: &Interned<Type>, bindings: &[Binding],
  result: Interned<Type>, invocationBinders: usize, invocationUse: usize, invocationBounds: List<Outlives>) -> Interned<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value _ => { return absurd<Interned<Type>>() }
  }
  let shape = match move run CallableContract.ofType(visible) {
    Option<CallableFacts>.Some {value} => move value _ => { return absurd<Interned<Type>>() }
  }
  let mut parameters = List<Interned<Type>>.make()
  let mut at = usize.ZERO
  while at < facts.parameters {
    let parameter = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, at) }) {
      Option<Interned<Type>>.Some {value} => move value _ => { return absurd<Interned<Type>>() }
    }
    run List<Interned<Type>>.append(&mut parameters, run Type.applyBindings(&parameter, bindings, true))
    at = at + usize.ONE
  }
  let regions = run callableEnvironmentRegions(&shape.environment)
  return run Types.intern(Type.Callable {mode: shape.mode, isUnsafe: shape.isUnsafe, environment: move shape.environment,
    invocationBinders: invocationBinders, invocationUse: invocationUse, invocationBounds: move invocationBounds,
    parameters: move parameters, result: run capturedEffectResult(move result, List<Interned<Lifetime>>.asSlice(&regions))})
}

pub union NamedSectionTarget {
  Application {pub value: Application, pub isPublic: bool},
  Schema {pub target: Interned<DeclarationId>, pub selected: List<Binding>, pub deferred: List<usize>},
}

pub fn genericSectionType(value: &Type) -> bool {
  return match &value.* { Type.CallableSchema {..} => true _ => false }
}

// Lifetime evidence is supplied by the remaining invocation operands, not stored as a capture. An
// `effect fn` target constructs its Effect at that invocation, so it defers the same way. A result
// that is itself an Effect value still needs the separate staging recipe: inspect the selected
// source result contract so a generic representation cannot hide an Effect after substitution.
pub effect fn sectionLifetimeDeferral(target: &DeclarationId, signature: &Shared<Result<Answer, NoRejection>>,
  inferred: &[Binding], declared: &[Constraint]) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if DeclarationId.kind(target) == OwnerKind.Literal { return true }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value _ => { return false }
  }
  let result = run Type.applyBindings(&facts.result, inferred, true)
  let mut constraints = run copyConstraints(declared)
  let mut at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run List<Constraint>.append(&mut constraints, run bindConstraint(&value, inferred))
    }
    at = at + usize.ONE
  }
  return !(run sectionResultEffect(&result, List<Constraint>.asSlice(&constraints)))
}

// A promised union can select an exact Effect representation in one member. Check each
// selected member's exposed contract, including contracts supplied by caller premises.
effect fn sectionResultEffect(result: &Interned<Type>, constraints: &[Constraint]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if Interned<Type>.with<bool>(result, effectStorageType) { return true }
  let selected = run Type.copy(result)
  if let Type.Union {members} = move selected {
    let listed = List<Interned<Type>>.asSlice(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      if run sectionResultEffect(&listed[at], constraints) { return true }
      at = at + usize.ONE
    }
    return false
  }
  let exposed = run valueCallableContract(result, constraints)
  if let Option<Interned<Type>>.Some {value} = move exposed {
    return Interned<Type>.with<bool>(&value, effectStorageType)
  }
  return false
}

pub fn anonymousSectionType(value: &Type) -> bool {
  return match &value.* {
    Type.CallableSchema {schema, ..} => Frozen<SectionSchema>.with<bool>(&schema, anonymousSectionRecipe)
    _ => false
  }
}

fn anonymousSectionRecipe(recipe: &SectionSchema) -> bool {
  return Interned<DeclarationId>.with<bool>(&recipe.target,
    |identity: &DeclarationId| -> bool { return DeclarationId.kind(identity) == OwnerKind.Literal })
}

pub fn sectionSchemaOf(value: &Type) -> Option<Frozen<SectionSchema>> {
  return match &value.* { Type.CallableSchema {schema, ..} => Option<Frozen<SectionSchema>>.some(Frozen<SectionSchema>.clone(&schema)) _ => Option<Frozen<SectionSchema>>.none() }
}

// The field inputs of a generic named section's capture record; empty for any other type.
pub effect fn sectionFieldInputs(value: &Interned<Type>) -> List<CallableFieldInput> ! OutOfMemoryError ? &mut Allocator {
  return match move run Type.copy(value) {
    Type.CallableSchema {fieldInputs, ..} => move fieldInputs
    _ => List<CallableFieldInput>.make()
  }
}

pub fn sectionSchemaContract(value: &Frozen<SectionSchema>) -> Interned<Type> {
  return Frozen<SectionSchema>.with<Interned<Type>>(value, |schema: &SectionSchema| -> Interned<Type> {
    return Interned<Type>.clone(&schema.contract)
  })
}

pub effect fn bindConstraint(value: &Constraint, bindings: &[Binding]) -> Constraint
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return match &value.* {
    Constraint.Conforms {provider, contract} => Constraint.Conforms {
      provider: run Type.applyBindings(&provider, bindings, true), contract: run Type.applyBindings(&contract, bindings, true)}
    Constraint.Represents {parameter, contract} => Constraint.Represents {
      parameter: run Type.applyBindings(&parameter, bindings, true), contract: run Type.applyBindings(&contract, bindings, true)}
    Constraint.Contents {subject, region} => Constraint.Contents {
      subject: run Type.applyBindings(&subject, bindings, true), region: run Type.applyLifetimeBindings(&region, bindings)}
    Constraint.Outlives {longer, shorter} => Constraint.Outlives {
      longer: run Type.applyLifetimeBindings(&longer, bindings), shorter: run Type.applyLifetimeBindings(&shorter, bindings)}
    Constraint.Copyable {subject} => Constraint.Copyable {subject: run Type.applyBindings(&subject, bindings, true)}
    Constraint.ThreadSafe {subject, property} => Constraint.ThreadSafe {subject: run Type.applyBindings(&subject, bindings, true), property: property}
    Constraint.Property {subject, property} => Constraint.Property {subject: run Type.applyBindings(&subject, bindings, true), property: property}
    Constraint.Provides {provider, selector, source} => Constraint.Provides {provider: run Type.applyBindings(&provider, bindings, true),
      selector: run Row.applyBindings(&selector, bindings, true), source: run Row.applyBindings(&source, bindings, true)}
    Constraint.FailureSubset {selected, source} => Constraint.FailureSubset {selected: run Type.applyBindings(&selected, bindings, true),
      source: run Type.applyBindings(&source, bindings, true)}
    Constraint.RequirementSubset {selected, source} => Constraint.RequirementSubset {selected: run Row.applyBindings(&selected, bindings, true),
      source: run Row.applyBindings(&source, bindings, true)}
  }
}

pub struct SectionSelection {
  pub selected: List<Binding>,
  pub deferred: List<usize>,
}

// The parameters of a `count`-parameter signature a section leaves open when its `supplied`
// arguments fill the ordinals from `first`: a section supplies a suffix, a bound method value its
// receiver, parameter zero (CALL-003).
pub effect fn openParameters(count: usize, first: usize, supplied: usize) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut open = List<usize>.make()
  let mut at = usize.ZERO
  while at < count {
    if at < first || at >= first + supplied { run List<usize>.append(&mut open, at) }
    at = at + usize.ONE
  }
  return move open
}

// Collects the binders a section's still-unsupplied `open` parameters mention, including the
// invocation contracts of representation parameters they name. Only these are evidence a later
// invocation supplies; false when the signature lacks one of those parameters.
pub effect fn sectionEvidence(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, inferred: &[Binding],
  open: &[usize], types: &mut List<usize>, lifetimes: &mut List<usize>, rows: &mut List<usize>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < open.length {
    let ordinal = open[at]
    let parameter = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(inference,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, ordinal) }) {
      Option<Interned<Type>>.Some {value} => move value
      _ => { return false }
    }
    let applied = run Type.applyBindings(&parameter, inferred, true)
    run Type.collectOwned(&applied, fresh, &mut types.*, &mut lifetimes.*, &mut rows.*)
    at = at + usize.ONE
  }
  // Both written callable parameters and authored F: fn bounds expose their invocation
  // contract as part of the remaining parameter's source shape.
  let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  let mut expanded = true
  while expanded {
    let before = List<usize>.length(&types.*) + List<usize>.length(&lifetimes.*) + List<usize>.length(&rows.*)
    at = usize.ZERO
    while at < boundCount {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
        |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter, contract}} = move bound {
        let applied = run Type.applyBindings(&parameter, inferred, true)
        if run sectionEligibleRepresentation(&applied, fresh, &types.*) {
          let shape = run Type.applyBindings(&contract, inferred, true)
          run Type.collectOwned(&shape, fresh, &mut types.*, &mut lifetimes.*, &mut rows.*)
        }
      }
      at = at + usize.ONE
    }
    expanded = before != List<usize>.length(&types.*) + List<usize>.length(&lifetimes.*) + List<usize>.length(&rows.*)
  }
  return true
}

// Whether any parameter of the call mentions `fresh`'s binder at `ordinal`, supplied or not.
effect fn sectionParameterMentions(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId, ordinal: usize)
  -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  let parameters = run signatureParameterTypes(inference)
  let listed = List<Interned<Type>>.asSlice(&parameters)
  let mut at = usize.ZERO
  while at < listed.length {
    run Type.collectOwned(&listed[at], fresh, &mut types, &mut lifetimes, &mut rows)
    at = at + usize.ONE
  }
  return containsOrdinal(&lifetimes, ordinal)
}

// SEM0099 for a section or function value with a binder that nothing determines: no supplied
// operand, no later invocation and no expected type. It names the binder of `target` at `ordinal`
// when it has a spelling, and the two ways to write it.
effect fn sectionInferenceRejection(resolver: &mut Resolver, module: &ModuleId, target: &DeclarationId, ordinal: usize, span: Span)
  -> Shared<Rejection> ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut diagnostic = run makeRejection(RejectionCode.UninferredParameter, module, span)
  let declared = DeclarationId.moduleId(target)
  let identity = run Types.internDeclaration(DeclarationId.copy(target))
  let mut binder = Option<Bytes>.none()
  if let Option<usize>.Some {value: declaration} = move run ordinalOfIdentity(&mut resolver.*, declared, &identity) {
    if let Result<List<Binder>, Shared<Rejection>>.Success {value: binders} = move run templateBinders(&mut resolver.*, declared, declaration) {
      let listed = List<Binder>.asSlice(&binders)
      if ordinal < listed.length {
        let spelled = match &listed[ordinal] {
          Binder.Type {name: written, ..} => Bytes.asSlice(&written)
          Binder.Lifetime {name: written, ..} => Bytes.asSlice(&written)
          Binder.Row {name: written, ..} => Bytes.asSlice(&written)
        }
        if spelled.length != usize.ZERO { binder = Option<Bytes>.some(run Bytes.copy(spelled)) }
      }
    }
  }
  if let Option<Bytes>.Some {value} = move binder {
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"parameter"), value: move value})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"target"), value: run DeclarationId.copySpelling(target)})
  }
  return run Shared<Rejection>.make(move diagnostic)
}

// Construction and later staging share the same bound-versus-free binder selection rule.
pub effect fn sectionSelection(resolver: &mut Resolver, module: &ModuleId, target: &DeclarationId,
  schema: &TargetSchema, inference: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, inferred: &[Binding], open: &[usize], constraints: &[Constraint], span: Span)
  -> Result<SectionSelection, Shared<Rejection>>
! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  // Only variables mentioned by still-unsupplied parameters may be deferred. Result-only or
  // unused variables are not evidence available at a later invocation.
  let mut eligibleTypes = List<usize>.make()
  let mut eligibleLifetimes = List<usize>.make()
  let mut eligibleRows = List<usize>.make()
  if !run sectionEvidence(inference, fresh, inferred, open, &mut eligibleTypes, &mut eligibleLifetimes, &mut eligibleRows) {
    return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
  }
  let boundCount = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  // An omitted provision selector `?S` whose provider or source row waits for a deferred operand
  // is inferred at the invocation (`inferProvidedSelectors`), so it defers with that operand. Any
  // other open selector has no later evidence and stays a named deferral. A written selector is
  // proved once the invocation infers the row.
  let freshIdentity = run Types.internDeclaration(DeclarationId.copy(fresh))
  let mut at = usize.ZERO
  while at < boundCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Provides {provider, selector, source}} = move bound {
      let applied = run Row.applyBindings(&selector, inferred, true)
      if run argumentMentionsOwner(&Argument.Row {value: Interned<Row>.clone(&applied)}, fresh) {
        let ordinal = Interned<Row>.with<usize>(&selector, |row: &Row| -> usize { return selectorOrdinalIn(row, &freshIdentity) })
        let appliedProvider = run Type.applyBindings(&provider, inferred, true)
        let appliedSource = run Row.applyBindings(&source, inferred, true)
        let providerPending = run typeMentionsOwner(&appliedProvider, fresh)
        let sourcePending = run argumentMentionsOwner(&Argument.Row {value: move appliedSource}, fresh)
        // No later invocation supplies evidence for this selector, so nothing determines it.
        if ordinal == usize.MAX || !(providerPending || sourcePending) {
          return Result<SectionSelection, Shared<Rejection>>.failResult(
            run sectionInferenceRejection(&mut resolver.*, module, target, ordinal, span))
        }
        if !containsOrdinal(&eligibleRows, ordinal) { run List<usize>.append(&mut eligibleRows, ordinal) }
      }
    }
    at = at + usize.ONE
  }
  let ownSlots = List<ApplicationSlot>.asSlice(&schema.own)
  let count = ownSlots.length
  let mut selected = List<Binding>.make()
  let mut deferred = List<usize>.make()
  at = usize.ZERO
  while at < count {
    let dense = sectionInferenceOrdinal(schema, inference, ownSlots[at].ordinal)
    if dense == usize.MAX { return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
    let supplied = bindingArgument(inferred, fresh, dense)
    if let Option<Argument>.Some {value} = move supplied {
      if run argumentMentionsOwner(&value, fresh) { return Result<SectionSelection, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.UninferredParameter, span)) }
      run List<Binding>.append(&mut selected, Binding {declaration: run Types.internDeclaration(DeclarationId.copy(target)),
        ordinal: ownSlots[at].ordinal, value: move value})
    } else {
      // A lifetime binder no parameter mentions is chosen by each invocation's use, as at any call
      // (`bindUseLifetimes`), so it waits for the invocation like operand evidence.
      if !containsOrdinal(&eligibleLifetimes, dense) && Shared<Result<Answer, NoRejection>>.with<bool>(inference,
        |answer: &Result<Answer, NoRejection>| -> bool {
          return signatureLifetimeBinder(answer, dense) && !signatureEnvironmentBinder(answer, dense)
        }) && !run sectionParameterMentions(inference, fresh, dense) {
        run List<usize>.append(&mut eligibleLifetimes, dense)
      }
      if !containsOrdinal(&eligibleTypes, dense) && !containsOrdinal(&eligibleLifetimes, dense) && !containsOrdinal(&eligibleRows, dense) {
        // A binder no open parameter mentions has no evidence at a later invocation either; only
        // an expected type or a written type argument determines it.
        return Result<SectionSelection, Shared<Rejection>>.failResult(
          run sectionInferenceRejection(&mut resolver.*, module, target, ownSlots[at].ordinal, span))
      }
      // Types and rows are inferred at the invocation. A lifetime takes its evidence from the
      // remaining operands too, not from a capture, so it reopens under its original schema
      // identity whatever the result is: an Effect result takes its environment from the
      // invocation's regions like any other borrowed result.
      run List<usize>.append(&mut deferred, ownSlots[at].ordinal)
    }
    at = at + usize.ONE
  }
  return Result<SectionSelection, Shared<Rejection>>.succeed(SectionSelection {
    selected: move selected, deferred: move deferred})
}

pub fn copySpan(value: &Option<Span>) -> Option<Span> {
  return match &value.* { Option<Span>.Some {value: span} => Option<Span>.some(span) Option<Span>.None => Option<Span>.none() }
}

effect fn copyNamedCallableEvidence(value: &NamedCallableEvidence) -> NamedCallableEvidence
! OutOfMemoryError ? &mut Allocator {
  let pending = match &value.pending {
    Option<DeclarationId>.Some {value: owner} => Option<DeclarationId>.some(DeclarationId.copy(&owner))
    Option<DeclarationId>.None => Option<DeclarationId>.none()
  }
  return NamedCallableEvidence {contract: Interned<Type>.clone(&value.contract), pending: move pending, call: copySpan(&value.call)}
}

// One invocation of a quantified promise binds a fresh region. An offered function whose result
// depends on a lifetime that region binds would let it outlive the invocation, so the selection is
// an incompatible callable rather than a deferral (CALLABLE-001, LIFE-004).
pub effect fn promisedInvocationEscape(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  inferred: &[Binding], promised: &Option<NamedCallableEvidence>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let evidence = match &promised.* {
    Option<NamedCallableEvidence>.Some {value} => run copyNamedCallableEvidence(&value)
    Option<NamedCallableEvidence>.None => { return false }
  }
  let contract = match move run CallableContract.ofType(&evidence.contract) {
    Option<CallableFacts>.Some {value} => move value
    Option<CallableFacts>.None => { return false }
  }
  // Only a promised result independent of the invocation is judged here; a result the promise
  // relates to its invocation regions is the contract comparison's, and one the enclosing call
  // still infers is that call's inference.
  if contract.invocationBinders == usize.ZERO || Type.mentionsInvocation(&contract.result)
    || run mentionsPending(&contract.result, &evidence.pending) { return false }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(inference, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return false }
  }
  let parameters = List<Interned<Type>>.asSlice(&contract.parameters)
  if parameters.length != facts.parameters { return false }
  let mut bound = List<usize>.make()
  let mut at = usize.ZERO
  while at < parameters.length {
    let pattern = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(inference,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, at) })
    if let Option<Interned<Type>>.Some {value} = move pattern {
      run Type.collectInvocationBound(&run Type.applyBindings(&value, inferred, true), &parameters[at], fresh, &mut bound)
    }
    at = at + usize.ONE
  }
  if List<usize>.length(&bound) == usize.ZERO { return false }
  // Invoking an `effect fn` stores its arguments in the Effect it constructs (EFF-001), so that
  // Effect retains every region an invocation binds in them.
  if facts.isEffect { return true }
  let mut lifetimes = List<usize>.make()
  run Type.collectExposedLifetimes(&run Type.applyBindings(&facts.result, inferred, true), fresh, &mut lifetimes)
  let escaping = List<usize>.asSlice(&lifetimes)
  at = usize.ZERO
  while at < escaping.length {
    if containsOrdinal(&bound, escaping[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

// A named function used as a value takes the type and row binders no supplied argument fixed
// from the callable contract its use site promises: the offered parameters accept the promised
// ones and the offered result is the promised result (CALLABLE-001). This includes the binders of
// an enclosing generic impl, as in `Option.some` passed as a `once fn(u8) -> Option<u8>`.
// Lifetime binders stay open, so the invocation's operands supply them as for any section.
pub effect fn inferFromPromisedContract(inference: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  promised: &Option<NamedCallableEvidence>, inferred: &mut List<Binding>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let evidence = match &promised.* {
    Option<NamedCallableEvidence>.Some {value} => run copyNamedCallableEvidence(&value)
    Option<NamedCallableEvidence>.None => { return () }
  }
  let wanted = match move run CallableContract.ofType(&evidence.contract) {
    Option<CallableFacts>.Some {value} => move value
    Option<CallableFacts>.None => { return () }
  }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(inference, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return () }
  }
  let parameters = List<Interned<Type>>.asSlice(&wanted.parameters)
  if parameters.length != facts.parameters { return () }
  let mut variables = List<Interned<DeclarationId>>.make()
  run List<Interned<DeclarationId>>.append(&mut variables, run Types.internDeclaration(DeclarationId.copy(fresh)))
  let mut learned = List<Binding>.make()
  let known = List<Binding>.asSlice(&inferred.*)
  let mut at = usize.ZERO
  while at < known.length {
    run List<Binding>.append(&mut learned, Binding {declaration: Interned<DeclarationId>.clone(&known[at].declaration),
      ordinal: known[at].ordinal, value: Argument.copy(&known[at].value)})
    at = at + usize.ONE
  }
  let start = known.length
  at = usize.ZERO
  while at < parameters.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(inference,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, at) }) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return () }
    }
    if !run mentionsPending(&parameters[at], &evidence.pending) {
      run inferSectionCallableShape(&pattern, &parameters[at], List<Interned<DeclarationId>>.asSlice(&variables), &mut learned)
    }
    at = at + usize.ONE
  }
  // Invoking an `effect fn` constructs an Effect; its written result is the success channel.
  let mut wantedResult = Interned<Type>.clone(&wanted.result)
  if facts.isEffect {
    let delayed = Interned<Type>.with<Option<EffectChannels>>(&wanted.result, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move delayed {
      if !run mentionsPending(&channels.failure, &evidence.pending) {
        run inferSectionCallableShape(&facts.failure, &channels.failure,
          List<Interned<DeclarationId>>.asSlice(&variables), &mut learned)
      }
      wantedResult = move channels.success
    }
  }
  if !run mentionsPending(&wantedResult, &evidence.pending) {
    run inferSectionCallableShape(&facts.result, &wantedResult,
      List<Interned<DeclarationId>>.asSlice(&variables), &mut learned)
  }
  // A representation binder needs an exact callable or Effect, which a promised contract is not.
  let mut representations = List<usize>.make()
  let bounds = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  at = usize.ZERO
  while at < bounds {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Represents {parameter, ..}} = move bound {
      let ordinal = Interned<Type>.with<usize>(&parameter, |value: &Type| -> usize { return Type.parameterOrdinalOf(value, fresh) })
      if ordinal != usize.MAX { run List<usize>.append(&mut representations, ordinal) }
    }
    at = at + usize.ONE
  }
  // A promised region stands for the use site's call, not for this value's invocations, so a
  // binding that lends one is left to the invocation as well, as is a callable or Effect contract.
  let found = List<Binding>.asSlice(&learned)
  at = start
  while at < found.length {
    let deferred = match &found[at].value {
      Argument.Lifetime {..} => true
      Argument.Type {value} => Type.containsViewBorrow(&value) || Interned<Type>.with<bool>(&value, |ty: &Type| -> bool {
        return match &ty.* { Type.Callable {..} => true Type.Effect {..} => true _ => false }
      })
      Argument.Row {..} => false
    }
    let open = match move bindingArgumentAt(List<Binding>.asSlice(&inferred.*), found[at].ordinal) {
      Option<Argument>.Some {..} => false
      Option<Argument>.None => true
    }
    let pending = match &evidence.pending {
      Option<DeclarationId>.Some {value} => run argumentMentionsOwner(&found[at].value, &value)
      Option<DeclarationId>.None => false
    }
    if !deferred && !pending && open && !containsOrdinal(&representations, found[at].ordinal) {
      run List<Binding>.append(&mut inferred.*, Binding {declaration: Interned<DeclarationId>.clone(&found[at].declaration),
        ordinal: found[at].ordinal, value: Argument.copy(&found[at].value)})
    }
    at = at + usize.ONE
  }
  return ()
}

// Binds each binder of `target` that an expected exact function type `typeof(f<...>)` names, when
// that type is the capture-free value of the same function `f` and lists its binders densely.
pub effect fn bindExpectedApplication(expected: &Option<Interned<Type>>, target: &DeclarationId, owner: &Interned<DeclarationId>,
  count: usize, inferred: &mut List<Binding>) -> () ! OutOfMemoryError ? &mut Allocator {
  let named = match &expected.* {
    Option<Interned<Type>>.Some {value} => Interned<Type>.with<Option<Interned<Application>>>(&value, |ty: &Type| -> Option<Interned<Application>> {
      return match &ty.* {
        Type.CallableValue {application, captures, ..} => {
          if List<Interned<Type>>.length(&captures) != usize.ZERO { return Option<Interned<Application>>.none() }
          return Option<Interned<Application>>.some(Interned<Application>.clone(&application))
        }
        _ => Option<Interned<Application>>.none()
      }
    })
    Option<Interned<Type>>.None => Option<Interned<Application>>.none()
  }
  let selected = match move named {
    Option<Interned<Application>>.Some {value} => move value
    Option<Interned<Application>>.None => { return () }
  }
  let dense = Interned<Application>.with<bool>(&selected, |value: &Application| -> bool {
    if let SpecializationTarget.Named {declaration} = &value.target {
      if !DeclarationId.equals(&declaration, target) { return false }
    } else { return false }
    let ordinals = List<usize>.asSlice(&value.argumentOrdinals)
    if ordinals.length != count || List<Argument>.length(&value.arguments) != count { return false }
    let mut at = usize.ZERO
    while at < ordinals.length {
      if ordinals[at] != at { return false }
      at = at + usize.ONE
    }
    return true
  })
  if !dense { return () }
  let mut at = usize.ZERO
  while at < count {
    let argument = Interned<Application>.with<Argument>(&selected, |value: &Application| -> Argument {
      return Argument.copy(&List<Argument>.asSlice(&value.arguments)[at])
    })
    run List<Binding>.append(&mut inferred.*, Binding {declaration: Interned<DeclarationId>.clone(owner), ordinal: at, value: move argument})
    at = at + usize.ONE
  }
}

// A result-only section binder has inference evidence when an expected callable contract is
// present, or when a whole function is used as a value: its consumer proves a contract. A value
// whose use site already knows that contract takes such binders from it before any deferral.
pub fn sectionContext(expected: &Option<Interned<Type>>, valueConstruction: bool) -> bool {
  return valueConstruction || match &expected.* {
    Option<Interned<Type>>.Some {value} => Interned<Type>.with<bool>(&value, callableType)
    _ => false
  }
}

pub effect fn finishDeferredNamedSection(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  request: &mut Request, dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  nodes: &mut List<BodyNode>, expression: HirId, span: Span, target: &DeclarationId,
  signature: &Shared<Result<Answer, NoRejection>>, applied: &[Argument], inference: &Shared<Result<Answer, NoRejection>>,
  fresh: &DeclarationId, inferred: &[Binding], open: &[usize], first: usize, arguments: List<BodyNodeId>, written: List<usize>,
  constraints: &[Constraint], expected: &Option<Interned<Type>>, mismatchCode: RejectionCode, contractBody: bool, contextual: bool)
  -> Result<BodyNodeId, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let resolved = run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, true, target, span)
  let schema = match move resolved {
    Option<TargetSchema>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Undetermined, span) }
  }
  if Shared<Result<Answer, NoRejection>>.with<usize>(signature, signatureStaticCount) != usize.ZERO {
    return run bodyRejection(&resolver.*, module, RejectionCode.Undetermined, span)
  }

  let mut choice = match move run sectionSelection(&mut resolver.*, module, target, &schema, inference,
    fresh, inferred, open, constraints, span) {
    Result<SectionSelection, Shared<Rejection>>.Success {value} => move value
    Result<SectionSelection, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let scoped = match move run sectionScopeSelection(&resolver.*, module, &schema, signature, applied, fresh, inferred, span) {
    Result<List<Binding>, Shared<Rejection>>.Success {value} => move value
    Result<List<Binding>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
  }
  let enclosing = List<Binding>.asSlice(&scoped)
  let mut scopeAt = usize.ZERO
  while scopeAt < enclosing.length {
    run List<Binding>.append(&mut choice.selected, Binding {declaration: Interned<DeclarationId>.clone(&enclosing[scopeAt].declaration),
      ordinal: enclosing[scopeAt].ordinal, value: Argument.copy(&enclosing[scopeAt].value)})
    scopeAt = scopeAt + usize.ONE
  }
  let mut fixedBounds = List<Constraint>.make()
  let bounds = Shared<Result<Answer, NoRejection>>.with<usize>(inference, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < bounds {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(inference,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move found {
      let applied = run bindConstraint(&value, inferred)
      if !run constraintMentionsOwner(&applied, fresh) { run List<Constraint>.append(&mut fixedBounds, move applied) }
    }
    at = at + usize.ONE
  }
  let declared = run copyConstraints(constraints)
  let refused = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &declared,
    List<Constraint>.asSlice(&fixedBounds), module, span, RegionProof.Typing)
  if let Option<Shared<Rejection>>.Some {value} = move refused { return Result<BodyNodeId, Shared<Rejection>>.failResult(move value) }
  let mut result = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(signature, signatureResult) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { return run bodyRejection(&resolver.*, module, RejectionCode.Undetermined, span) }
  }
  let noBindings = List<Binding>.make()
  if Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsEffect) {
    // Run access is proved with the caller's bounds over the target's open parameters; a Copy
    // proof that needs the target's own bounds fails, which only makes the access stricter.
    let promised = match move run effectValueResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, signature,
      List<Binding>.asSlice(&noBindings), Interned<Type>.clone(&result), run signatureFailure(signature), run signatureRequirements(signature),
      constraints, span) {
      Result<Interned<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Interned<Type>, Shared<Rejection>>.Failure {error} => { return Result<BodyNodeId, Shared<Rejection>>.failResult(move error) }
    }
    result = move promised
  }
  // Retention is checked under the bindings established by these captures. The runtime
  // recipe above deliberately keeps its remaining invocation binders open; those open names
  // are not evidence that a capture stays local to this body.
  let parameterTypes = run signatureParameterTypes(inference)
  let kept = run keptArguments(&mut resolver.*, &mut owner.*, &mut dependencies.*, inference, inferred,
    List<Interned<Type>>.length(&parameterTypes), true, caller, span)
  return run finishNamedSection(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller, &mut nodes.*,
    expression, span, signature, List<Binding>.asSlice(&noBindings), move kept, run sectionBindingsClosed(inference, inferred, fresh),
    NamedSectionTarget.Schema {target: run Types.internDeclaration(DeclarationId.copy(target)),
      selected: move choice.selected, deferred: move choice.deferred}, open, first, move arguments, move result, move written, constraints, expected,
    mismatchCode, contractBody)
}

effect fn sectionEligibleRepresentation(value: &Interned<Type>, owner: &DeclarationId, eligible: &List<usize>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut types = List<usize>.make()
  let mut lifetimes = List<usize>.make()
  let mut rows = List<usize>.make()
  run Type.collectOwned(value, owner, &mut types, &mut lifetimes, &mut rows)
  let found = List<usize>.asSlice(&types)
  let mut at = usize.ZERO
  while at < found.length {
    if containsOrdinal(eligible, found[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

// Open target variables before inserting selected caller evidence. In a recursive owner the
// selected evidence may have the very same declaration/ordinal as a bound blueprint variable.
pub effect fn sectionOriginalSignature(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, target: &DeclarationId, span: Span) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let targetModuleAt = knownModuleOrdinal(&resolver.*, DeclarationId.moduleId(target))
  if targetModuleAt == usize.MAX { fail InvalidModulePath {} }
  let targetModule = resolvedModule(&resolver.*, targetModuleAt)
  let identity = run Types.internDeclaration(DeclarationId.copy(target))
  let targetAt = match move run ordinalOfIdentity(&mut resolver.*, &targetModule, &identity) {
    Option<usize>.Some {value} => value _ => { fail RevisionMismatch {} }
  }
  let declarationAccess279Request = Key {
    family: Family.Signature, module: targetModuleAt, name: usize.ZERO, declaration: targetAt,
    member: usize.ZERO, external: false}
  let declarationAccess279 = run internDeclaration(&mut resolver.*, declarationAccess279Request)
  return run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess279, span)
}

// Opening a signature lists participating scope slots first, then every own slot. Selection
// retains original owner/ordinal pairs; the fresh dense ordinal exists only for inference.
pub fn sectionInferenceOrdinal(schema: &TargetSchema, opened: &Shared<Result<Answer, NoRejection>>, original: usize) -> usize {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(opened, signatureBinderCount)
  let slots = List<ApplicationSlot>.asSlice(&schema.own)
  if count < slots.length { return usize.MAX }
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].ordinal == original { return count - slots.length + at }
    at = at + usize.ONE
  }
  return usize.MAX
}

pub effect fn sectionScopeInferenceOrdinal(schema: &TargetSchema, original: &Shared<Result<Answer, NoRejection>>,
  identity: &DeclarationId, ordinal: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let scopes = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut dense = usize.ZERO
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = List<ApplicationSlot>.asSlice(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      if Shared<Result<Answer, NoRejection>>.with<bool>(original,
        |answer: &Result<Answer, NoRejection>| -> bool { return signatureListsSlot(answer, &owner, slots[at]) }) {
        if DeclarationId.equals(identity, &owner) && slots[at].ordinal == ordinal { return dense }
        dense = dense + usize.ONE
      }
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return usize.MAX
}

// An enclosing impl's binders are fixed when a section is constructed, by written arguments, the
// supplied suffix, an applied owner or a function value's promised contract, and travel as
// selected owner evidence. Only the target's own binders may wait for the invocation; a schema
// cannot defer an impl binder. An applied owner's signature lists none of the impl's slots: its
// application supplies each of them in order, as `resolveAppliedInherent` does. Otherwise an impl
// slot the signature does not list has no evidence at construction.
effect fn sectionScopeSelection(resolver: &Resolver, module: &ModuleId, schema: &TargetSchema,
  original: &Shared<Result<Answer, NoRejection>>, applied: &[Argument], fresh: &DeclarationId, inferred: &[Binding], span: Span)
  -> Result<List<Binding>, Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<Binding>.make()
  let scopes = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = List<ApplicationSlot>.asSlice(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      let dense = run sectionScopeInferenceOrdinal(schema, original, &owner, slots[at].ordinal)
      let mut supplied = Option<Argument>.none()
      if dense != usize.MAX { supplied = bindingArgument(inferred, fresh, dense) }
      else if slots[at].ordinal < applied.length { supplied = Option<Argument>.some(Argument.copy(&applied[slots[at].ordinal])) }
      let value = match move supplied {
        Option<Argument>.Some {value} => move value
        Option<Argument>.None => { return Result<List<Binding>, Shared<Rejection>>.failResult(run unfixedArgumentsRejection(module, span)) }
      }
      if run argumentMentionsOwner(&value, fresh) {
        return Result<List<Binding>, Shared<Rejection>>.failResult(run reject(resolver, module, RejectionCode.UninferredParameter, span))
      }
      run List<Binding>.append(&mut selected, Binding {declaration: Interned<DeclarationId>.clone(&scopes[scopeAt].owner),
        ordinal: slots[at].ordinal, value: move value})
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return Result<List<Binding>, Shared<Rejection>>.succeed(move selected)
}

// Every retained enclosing slot remains free construction evidence, including phantom slots.
pub effect fn sectionScopeArguments(schema: &TargetSchema, selected: &[Binding]) -> Option<List<Argument>>
! OutOfMemoryError ? &mut Allocator {
  let mut output = List<Argument>.make()
  let scopes = List<ApplicationScope>.asSlice(&schema.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = DeclarationId.copyShared(&scopes[scopeAt].owner)
    let slots = List<ApplicationSlot>.asSlice(&scopes[scopeAt].slots)
    let mut at = usize.ZERO
    while at < slots.length {
      let argument = bindingArgument(selected, &owner, slots[at].ordinal)
      if let Option<Argument>.Some {value} = move argument { run List<Argument>.append(&mut output, move value) }
      else { return Option<List<Argument>>.none() }
      at = at + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  return Option<List<Argument>>.some(move output)
}

// The target parameters a section already bound, in capture order, opened onto `fresh` like its
// invocation signature, so a held binder's variance in them is known when the invocation would
// move it.
pub effect fn sectionCapturedParameters(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, schema: &Frozen<SectionSchema>, inputs: &[CallableFieldInput],
  fresh: &DeclarationId, module: &ModuleId, span: Span) -> Result<List<Interned<Type>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run CallableSchema.copy(schema)
  let target = DeclarationId.copyShared(&copied.target)
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let mut request = Request.make()
  let resolved = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result<List<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
  }
  let opened = match move run callInferenceSignature(&resolver.*, &original, &resolved, fresh, false, module, span) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<List<Interned<Type>>, Shared<Rejection>>.failResult(move error) }
  }
  let all = run signatureParameterTypes(&opened)
  let listed = List<Interned<Type>>.asSlice(&all)
  let mut captured = List<Interned<Type>>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    if let Option<usize>.Some {value: ordinal} = move CallableFieldInput.parameter(&inputs[at]) {
      if ordinal >= listed.length {
        return Result<List<Interned<Type>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span))
      }
      run List<Interned<Type>>.append(&mut captured, Interned<Type>.clone(&listed[ordinal]))
    }
    at = at + usize.ONE
  }
  return Result<List<Interned<Type>>, Shared<Rejection>>.succeed(move captured)
}

// The section's invocation signature: the target parameters its `inputs` leave open, in order.
// With `holdLifetimes`, selected target lifetimes stay open binders and are appended to `held` as
// inference evidence, so an invocation can tell a lifetime its section bound from a written one.
pub effect fn sectionSchemaSignature(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, schema: &Frozen<SectionSchema>, inputs: &[CallableFieldInput], fresh: &DeclarationId,
  module: &ModuleId, span: Span, holdLifetimes: bool, held: &mut List<Binding>)
  -> Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run CallableSchema.copy(schema)
  let target = DeclarationId.copyShared(&copied.target)
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let mut request = Request.make()
  let resolved = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
  }
  let opened = match move run callInferenceSignature(&resolver.*, &original, &resolved, fresh, false, module, span) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(move error) }
  }
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&opened, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
  }
  let mut seed = List<Binding>.make()
  let chosen = List<Binding>.asSlice(&copied.selected)
  let mut at = usize.ZERO
  while at < chosen.length {
    let identity = DeclarationId.copyShared(&chosen[at].declaration)
    let own = DeclarationId.equals(&target, &identity)
    let mut dense = run sectionScopeInferenceOrdinal(&resolved, &original, &identity, chosen[at].ordinal)
    if own { dense = sectionInferenceOrdinal(&resolved, &opened, chosen[at].ordinal) }
    if dense != usize.MAX {
      let selected = Binding {declaration: run Types.internDeclaration(DeclarationId.copy(fresh)),
        ordinal: dense, value: Argument.copy(&chosen[at].value)}
      let lifetime = match &chosen[at].value { Argument.Lifetime {..} => true _ => false }
      if own && lifetime && holdLifetimes {
        run List<Binding>.append(&mut held.*, move selected)
      } else {
        run List<Binding>.append(&mut seed, move selected)
      }
    }
    at = at + usize.ONE
  }
  let remaining = match move run CallableContract.ofType(&copied.contract) {
    Option<CallableFacts>.Some {value} => List<Interned<Type>>.length(&value.parameters)
    _ => { return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, span)) }
  }
  let mut parameters = List<Interned<Type>>.make()
  // The exempt input keeps its exemption at its open position; captured, it is owed by no invocation.
  let mut exempt = usize.MAX
  at = usize.ZERO
  while at < remaining {
    let ordinal = CallableFieldInput.openOrdinal(inputs, at)
    if ordinal == facts.environmentExempt { exempt = at }
    let parameter = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&opened,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, ordinal) }) {
      Option<Interned<Type>>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    run List<Interned<Type>>.append(&mut parameters, run Type.applyBindings(&parameter, List<Binding>.asSlice(&seed), true))
    at = at + usize.ONE
  }
  let mut types = List<Interned<Type>>.make()
  let mut lifetimes = List<Interned<Lifetime>>.make()
  let mut rows = List<RowParameter>.make()
  at = usize.ZERO
  while at < facts.binders {
    let binder = Shared<Result<Answer, NoRejection>>.with<Option<InferenceBinder>>(&opened,
      |answer: &Result<Answer, NoRejection>| -> Option<InferenceBinder> { return inferenceBinderAt(answer, at) })
    match move binder {
      Option<InferenceBinder>.Some {value: InferenceBinder.Type {value}} => { run List<Interned<Type>>.append(&mut types, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Lifetime {value}} => { run List<Interned<Lifetime>>.append(&mut lifetimes, move value) }
      Option<InferenceBinder>.Some {value: InferenceBinder.Row {value}} => { run List<RowParameter>.append(&mut rows, move value) }
      _ => { fail RevisionMismatch {} }
    }
    at = at + usize.ONE
  }
  let mut constraints = List<Constraint>.make()
  at = usize.ZERO
  while at < facts.constraints {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&opened,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value} = move bound {
      run List<Constraint>.append(&mut constraints, run bindConstraint(&value, List<Binding>.asSlice(&seed)))
    }
    at = at + usize.ONE
  }
  // A written environment stays the section's, so its invocation owes the inputs it supplies
  // (`impliedSignatureBounds`); construction owed the ones it captured.
  let mut environment = Option<Intersection>.none()
  if facts.environmentWritten && facts.environment != usize.MAX {
    let mut regions = List<Interned<Lifetime>>.make()
    at = usize.ZERO
    while at < facts.environment {
      let region = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Lifetime>>>(&opened,
        |answer: &Result<Answer, NoRejection>| -> Option<Interned<Lifetime>> { return signatureRetainedRegion(answer, at) })
      if let Option<Interned<Lifetime>>.Some {value} = move region {
        run List<Interned<Lifetime>>.append(&mut regions, run Type.applyLifetimeBindings(&value, List<Binding>.asSlice(&seed)))
      }
      at = at + usize.ONE
    }
    environment = Option<Intersection>.some(run Intersection.of(List<Interned<Lifetime>>.asSlice(&regions)))
  }
  let value = memberSuccess(Value.Signature {signature: run Box<Signature>.make(Signature {
    typeParameters: move types, callableParameterStart: facts.callableParameterStart,
    lifetimeParameters: move lifetimes, rowParameters: move rows, parameters: move parameters,
    constraints: move constraints, result: run Type.applyBindings(&facts.result, List<Binding>.asSlice(&seed), true),
    failure: run Type.applyBindings(&facts.failure, List<Binding>.asSlice(&seed), true),
    requirements: run Row.applyBindings(&facts.requirements, List<Binding>.asSlice(&seed), true),
    isEffect: facts.isEffect, isVariadic: facts.isVariadic, isUnsafe: facts.isUnsafe, isStatic: false,
    staticSlots: List<usize>.make(), environment: move environment, environmentWritten: facts.environmentWritten,
    environmentExempt: exempt})}, List<Dependency>.make())
  return Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.succeed(
    run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(move value)))
}

// Complete immutable construction evidence with this invocation's fresh inference result.
// No application or function key is published while any deferred target slot is absent.
pub effect fn schemaCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, schema: Frozen<SectionSchema>,
  captures: List<Interned<Type>>, fieldInputs: List<CallableFieldInput>, written: &[Interned<Type>], anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
  let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    caller, callerBindings, BodyOrigin.span(inputs.origin, anchor)) {
    Option<List<Constraint>>.Some {value} => move value _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let application = match move run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, callerBindings, List<Constraint>.asSlice(&premises), &schema, List<CallableFieldInput>.asSlice(&fieldInputs),
    written, BodyOrigin.span(inputs.origin, anchor)) {
    Result<Application, PreparationFailure>.Success {value} => move value
    Result<Application, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  let mode = Interned<Type>.with<CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode)
  let mut retainedInputs = List<CallableFieldInput>.make()
  let listed = List<CallableFieldInput>.asSlice(&fieldInputs)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<CallableFieldInput>.append(&mut retainedInputs, listed[at])
    at = at + usize.ONE
  }
  let receiver = run Type.callableSchema(move schema, run copyTypes(List<Interned<Type>>.asSlice(&captures)), move retainedInputs)
  return run callableValueCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, mode, move receiver, run Types.internApplication(move application), move captures,
    move fieldInputs, written, false, anchor)
}

// Whether a section's bounds hold under its inferred bindings and the caller's premises; a bound
// still naming an unbound binder of the section does not.
effect fn sectionApplicationBounds(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, opened: &Shared<Result<Answer, NoRejection>>, fresh: &DeclarationId,
  inferred: &[Binding], declared: &List<Constraint>, module: &ModuleId, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let boundsCount = Shared<Result<Answer, NoRejection>>.with<usize>(opened, signatureConstraintCount)
  let mut appliedBounds = List<Constraint>.make()
  let mut boundAt = usize.ZERO
  while boundAt < boundsCount {
    let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(opened,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
    if let Option<Constraint>.Some {value} = move bound {
      let selected = run bindConstraint(&value, inferred)
      if run constraintMentionsOwner(&selected, fresh) { return false }
      run List<Constraint>.append(&mut appliedBounds, move selected)
    }
    boundAt = boundAt + usize.ONE
  }
  let failure = run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, declared,
    List<Constraint>.asSlice(&appliedBounds), module, span, RegionProof.RegionCheck)
  if let Option<Shared<Rejection>>.Some {..} = move failure { return false }
  return true
}

// Selects the original schema application from checked operand types, without replaying transfers.
pub effect fn schemaCallableApplication(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, callerBindings: &[Binding], premises: &[Constraint],
  schema: &Frozen<SectionSchema>, inputs: &[CallableFieldInput], supplied: &[Interned<Type>], span: Span)
  -> Result<Application, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let savedInfer = resolver.nextInferenceId
  let freshShared = run freshInferOwner(&mut resolver.*)
  let result = run schemaCallableApplicationWithOwner(
    &mut resolver.*, &mut owner.*, &mut dependencies.*, module, callerBindings, premises,
    schema, inputs, supplied, &freshShared, span,
  )
  if resolver.nextInferenceId == savedInfer + 1 {
    resolver.nextInferenceId = savedInfer
  }
  return move result
}

effect fn schemaCallableApplicationWithOwner(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, callerBindings: &[Binding], premises: &[Constraint],
  schema: &Frozen<SectionSchema>, inputs: &[CallableFieldInput], supplied: &[Interned<Type>],
  freshShared: &Interned<DeclarationId>, span: Span)
  -> Result<Application, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let copied = run CallableSchema.copy(schema)
  let target = DeclarationId.copyShared(&copied.target)
  let mut request = Request.make()
  let sourceSchema = match move run resolveTargetSchema(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, true, &target, span) {
    Option<TargetSchema>.Some {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let fresh = DeclarationId.copyShared(freshShared)
  // The section's own lifetimes stay open, held as evidence, so the bounds below can shorten an
  // environment binder exactly as the invocation's checking did (`shortenedEnvironmentBinder`).
  let mut held = List<Binding>.make()
  let opened = match move run sectionSchemaSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, schema, inputs, &fresh,
    module, span, true, &mut held) {
    Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let mut variables = List<Interned<DeclarationId>>.make()
  run List<Interned<DeclarationId>>.append(&mut variables, Interned<DeclarationId>.clone(freshShared))
  let mut inferred = List<Binding>.make()
  let evidence = List<Binding>.asSlice(&held)
  let mut heldAt = usize.ZERO
  while heldAt < evidence.length {
    run List<Binding>.append(&mut inferred, Binding {declaration: Interned<DeclarationId>.clone(&evidence[heldAt].declaration),
      ordinal: evidence[heldAt].ordinal, value: run Argument.applyBindings(&evidence[heldAt].value, callerBindings, true)})
    heldAt = heldAt + usize.ONE
  }
  let mut operandAt = usize.ZERO
  while operandAt < supplied.length {
    let pattern = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&opened,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, operandAt) }) {
      Option<Interned<Type>>.Some {value} => move value
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let actual = run Type.applyBindings(&supplied[operandAt], callerBindings, true)
    run inferSectionCallableShape(&pattern, &actual, List<Interned<DeclarationId>>.asSlice(&variables), &mut inferred)
    operandAt = operandAt + usize.ONE
  }
  let freshIdentity = Interned<DeclarationId>.clone(freshShared)
  // A binder no operand mentions is chosen by the use, as at the invocation's checking
  // (`bindUseLifetimes`); a bound it fails shortens it below.
  let mut defaulted = List<usize>.make()
  run bindUseLifetimes(&opened, &fresh, &freshIdentity, Shared<Result<Answer, NoRejection>>.with<usize>(&opened, signatureBinderCount),
    &Option<Interned<Type>>.none(), Shared<Result<Answer, NoRejection>>.with<bool>(&opened, signatureIsEffect), &mut inferred, &mut defaulted)
  let inferenceFailure = run inferFromProviderBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {..} = move inferenceFailure {
    return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let selectorFailure = run inferProvidedSelectors(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    &opened, &freshIdentity, &fresh, premises, &mut inferred, span)
  if let Option<Shared<Rejection>>.Some {..} = move selectorFailure {
    return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
  }
  let declared = run copyConstraints(premises)
  let mut shortened = false
  let mut proved = run sectionApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh,
    List<Binding>.asSlice(&inferred), &declared, module, span)
  if !proved {
    // A piped Effect may retain a region the held environment binder does not cover, and a
    // `'longer: 'binder` bound may name a region the held binder outlives; each shortens to the meet
    // exactly as the invocation's checking did, then the bounds are proved again.
    let captured = match move run sectionCapturedParameters(&mut resolver.*, &mut owner.*, &mut dependencies.*, schema,
      inputs, &fresh, module, span) {
      Result<List<Interned<Type>>, Shared<Rejection>>.Success {value} => move value
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let noExplicit = List<usize>.make()
    let boundsCount = Shared<Result<Answer, NoRejection>>.with<usize>(&opened, signatureConstraintCount)
    let mut boundAt = usize.ZERO
    while boundAt < boundsCount {
      let bound = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&opened,
        |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, boundAt) })
      if let Option<Constraint>.Some {value: Constraint.Represents {parameter: representation, contract}} = move bound {
        let source = run Type.applyBindings(&representation, List<Binding>.asSlice(&inferred), true)
        if run shortenedEnvironmentBinder(&mut resolver.*, &mut owner.*, &mut dependencies.*, &contract, &source, &opened,
          List<Interned<Type>>.asSlice(&captured), &fresh, List<Interned<DeclarationId>>.asSlice(&variables), &mut inferred,
          List<usize>.asSlice(&noExplicit), premises, span) {
          shortened = true
        }
      }
      boundAt = boundAt + usize.ONE
    }
    let unwritten = List<usize>.make()
    if run outlivesShortenedBinders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh, &mut inferred,
      List<usize>.asSlice(&unwritten), premises, span) {
      shortened = true
    }
    if shortened {
      proved = run sectionApplicationBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &opened, &fresh,
        List<Binding>.asSlice(&inferred), &declared, module, span)
    }
  }
  if !proved { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  let mut bindings = List<Binding>.make()
  let selected = List<Binding>.asSlice(&copied.selected)
  let mut at = usize.ZERO
  while at < selected.length {
    // A held lifetime that the bounds shortened takes that region; every other selection is as bound.
    let mut value = Argument.copy(&selected[at].value)
    let own = Interned<DeclarationId>.with<bool>(&selected[at].declaration,
      |declaration: &DeclarationId| -> bool { return DeclarationId.equals(declaration, &target) })
    let lifetime = match &selected[at].value { Argument.Lifetime {..} => true _ => false }
    if shortened && own && lifetime {
      let dense = sectionInferenceOrdinal(&sourceSchema, &opened, selected[at].ordinal)
      if let Option<Argument>.Some {value: settled} = move bindingArgument(List<Binding>.asSlice(&inferred), &fresh, dense) {
        value = move settled
      }
    }
    run List<Binding>.append(&mut bindings, Binding {declaration: Interned<DeclarationId>.clone(&selected[at].declaration),
      ordinal: selected[at].ordinal, value: move value})
    at = at + usize.ONE
  }
  let deferred = List<usize>.asSlice(&copied.deferred)
  at = usize.ZERO
  while at < deferred.length {
    let found = bindingArgument(List<Binding>.asSlice(&inferred), &fresh, sectionInferenceOrdinal(&sourceSchema, &opened, deferred[at]))
    let argument = match move found {
      Option<Argument>.Some {value} => run Argument.applyBindings(&value, callerBindings, true)
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    if run argumentMentionsOwner(&argument, &fresh) { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    run List<Binding>.append(&mut bindings, Binding {declaration: Interned<DeclarationId>.clone(&copied.target),
      ordinal: deferred[at], value: move argument})
    at = at + usize.ONE
  }
  let slots = List<ApplicationSlot>.asSlice(&sourceSchema.own)
  let mut arguments = List<Argument>.make()
  at = usize.ZERO
  while at < slots.length {
    let argument = match move bindingArgument(List<Binding>.asSlice(&bindings), &target, slots[at].ordinal) {
      Option<Argument>.Some {value} => move value
      _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    if run argumentMentionsOwner(&argument, &fresh) { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    run List<Argument>.append(&mut arguments, move argument)
    at = at + usize.ONE
  }
  let original = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, span)
  let scopes = match move run sectionScopeArguments(&sourceSchema, List<Binding>.asSlice(&bindings)) {
    Option<List<Argument>>.Some {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let application = match move run checkedDirectApplication(&mut resolver.*, &mut owner.*, &mut request,
    &mut dependencies.*, &target, &original, move arguments, &scopes, module, span) {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    _ => { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  return Result<Application, PreparationFailure>.succeed(move application)
}

// The first conformance bound a complete root application fails to prove. Region relations are
// checked by the caller's typing; only a conformance can select code by region.
pub effect fn rootConformanceRefusal(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  application: &Application, module: &ModuleId, span: Span) -> Option<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let bindings = run Application.bindings(application)
  let declared = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies, application,
    List<Binding>.asSlice(&bindings), span) {
    Option<List<Constraint>>.Some {value} => move value
    Option<List<Constraint>>.None => { return Option<Shared<Rejection>>.none() }
  }
  let mut conformances = List<Constraint>.make()
  let listed = List<Constraint>.asSlice(&declared)
  let mut at = usize.ZERO
  while at < listed.length {
    if let Constraint.Conforms {provider, contract} = &listed[at] {
      run List<Constraint>.append(&mut conformances, Constraint.Conforms {provider: Interned<Type>.clone(&provider),
        contract: Interned<Type>.clone(&contract)})
    }
    at = at + usize.ONE
  }
  let assumptions = List<Constraint>.make()
  return run proveAppliedBounds(&mut resolver.*, &mut owner.*, &mut dependencies, &assumptions,
    List<Constraint>.asSlice(&conformances), module, span, RegionProof.Typing)
}

// The caller body's premises (`bodyPremises`) under the application's bindings: what lowering may
// assume while it proves a call again, exactly as typing assumed it.
pub effect fn closedApplicationPremises(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, bindings: &[Binding], span: Span) -> Option<List<Constraint>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let bodyOwner = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(caller)))
  let location = match move run locationOfIdentity(&mut resolver.*, &bodyOwner) {
    Option<InstanceLocation>.Some {value} => value _ => { return Option<List<Constraint>>.none() }
  }
  let premises = match move run bodyPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, location.module,
    location.declaration) {
    Result<List<Constraint>, Shared<Rejection>>.Success {value} => move value
    _ => { return Option<List<Constraint>>.none() }
  }
  let listed = List<Constraint>.asSlice(&premises)
  let mut output = run List<Constraint>.makeWithCapacity(listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Constraint>.append(&mut output, run bindConstraint(&listed[at], bindings))
    at = at + usize.ONE
  }
  return Option<List<Constraint>>.some(move output)
}

// The finalized header retains only listed original slots. Optional phantom impl parameters
// remain absent, matching ordinary application admission, while hidden representations are own slots.
pub effect fn formalOpaqueApplication(resolver: &mut Resolver, module: &ModuleId, declaration: usize,
  producer: &DeclarationId, types: &[Interned<Type>], lifetimes: &[Interned<Lifetime>], rows: &[RowParameter]) -> Application
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut own = List<Argument>.make()
  let mut ownOrdinals = List<usize>.make()
  let mut scopes = List<ScopeBinding>.make()
  let mut identity = DeclarationId.copy(producer)
  let mut ordinal = declaration
  while true {
    let mut selected = List<ApplicationSlot>.make()
    let mut at = usize.ZERO
    while at < types.length + lifetimes.length + rows.length {
      if let Option<ApplicationSlot>.Some {value} = move ownedSlot(types, lifetimes, rows, &identity, at) {
        run insertApplicationSlot(&mut selected, value)
      }
      at = at + usize.ONE
    }
    let slots = List<ApplicationSlot>.asSlice(&selected)
    let mut arguments = run List<Argument>.makeWithCapacity(slots.length)
    at = usize.ZERO
    while at < slots.length {
      run List<Argument>.append(&mut arguments, run scopeArgument(&identity, slots[at].ordinal, slots[at].kind))
      at = at + usize.ONE
    }
    let ordinals = run applicationOrdinals(slots)
    if DeclarationId.equals(&identity, producer) { own = move arguments ownOrdinals = move ordinals }
    else if slots.length > usize.ZERO {
      run List<ScopeBinding>.insert(&mut scopes, usize.ZERO, ScopeBinding {
        owner: run Types.internDeclaration(DeclarationId.copy(&identity)),
        arguments: move arguments, argumentOrdinals: move ordinals, statics: List<StaticSlot>.make()})
    }
    let parent = run enclosingIdentity(&mut resolver.*, module, ordinal)
    if let Option<DeclarationId>.Some {value} = move parent {
      identity = move value
      let shared = run Types.internDeclaration(DeclarationId.copy(&identity))
      let found = run ordinalOfIdentity(&mut resolver.*, module, &shared)
      ordinal = match move found { Option<usize>.Some {value: next} => next _ => { fail RevisionMismatch {} } }
    } else { break }
  }
  return Application {target: SpecializationTarget.Named {declaration: DeclarationId.copy(producer)},
    arguments: move own, argumentOrdinals: move ownOrdinals, scopes: move scopes, statics: List<StaticSlot>.make()}
}

fn nominalTestReferenceRegion(value: &Type) -> Option<Interned<Lifetime>> {
  if let Type.Reference {access, lifetime, ..} = &value.* {
    if access == Access.Shared { return Option<Interned<Lifetime>>.some(Interned<Lifetime>.clone(&lifetime)) }
  }
  return Option<Interned<Lifetime>>.none()
}

fn nominalTestBodyRegion(checked: &TypedBody) -> Option<Interned<Lifetime>> {
  let nodes = TypedBody.nodeSlice(checked)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      let borrowed = Interned<Type>.with<Option<Interned<Lifetime>>>(&ty, nominalTestReferenceRegion)
      if let Option<Interned<Lifetime>>.Some {value} = move borrowed { return Option<Interned<Lifetime>>.some(move value) }
    }
    at = at + usize.ONE
  }
  return Option<Interned<Lifetime>>.none()
}

fn nominalTestParameterRegion(value: &Type) -> Option<Interned<Lifetime>> {
  if let Type.Nominal {arguments, ..} = &value.* {
    let listed = List<Argument>.asSlice(&arguments)
    if listed.length == usize.ONE {
      if let Argument.Lifetime {value: validity} = &listed[usize.ZERO] {
        return Option<Interned<Lifetime>>.some(Interned<Lifetime>.clone(&validity))
      }
    }
  }
  return Option<Interned<Lifetime>>.none()
}

// A caller-owned Local cannot be written as a source generic argument. This private actor test
// uses the real checked loan and source signatures, differing only in explicit-ordinal metadata.
effect fn nominalRegionExplicitOrdinalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run ModuleId.make(b"memory", b"example", b"nominal-explicit-local.silk")
  let authored = Option<Bytes>.some(run Bytes.copy(b"struct Request<'a> { value: string<'a> }\nfn caller() -> i32 { let value = 1 let loan = &value return 0 }\nfn target<'a>(client: &'a i32, value: Request<'a>) -> i32 { return 42 }\nfn staticValue(value: Request<'static>) -> i32 { return 0 }\n"))
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let inventory = run Semantic.demandSourceInventory(&mut store, &mut request, &id)
  let syntax = match move inventory {
    SourceInventory.Present {syntax, ..} => move syntax
    _ => { run Testing.expect(false, "the actual source census must be present") return () }
  }
  let functions = List<NamedFunction>.asSlice(&syntax.functions)
  run Testing.expect(functions.length == 3, "the source supplies exactly the caller and two real signatures")
  let caller = DeclarationId.copy(&functions[usize.ZERO].declaration.identity)
  let declared = DeclarationId.copy(&functions[usize.ONE].declaration.identity)
  run Testing.expect(DeclarationId.named(&caller, b"caller") && DeclarationId.named(&declared, b"target"),
    "caller and callee are full source-derived canonical identities")
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, b"caller")
  let body = match move Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, answerTypedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value
    _ => { run Testing.expect(false, "the loan comes from a genuinely successful checked body") return () }
  }
  let observed = Shared<TypedBody>.with<Option<Interned<Lifetime>>>(&body, nominalTestBodyRegion)
  let region = match move observed {
    Option<Interned<Lifetime>>.Some {value} => move value
    _ => { run Testing.expect(false, "the checked caller retains its actual reference lifetime") return () }
  }
  run Testing.expect(callerLocalRegion(&region, &caller), "this is the actual caller's Local, not a foreign loan")
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"target")
  let original = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&signature,
    |value: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(value, usize.ONE) }) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the original parameter comes from the checked target header") return () }
  }
  let staticSignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"staticValue")
  let evidence = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&staticSignature,
    |value: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(value, usize.ZERO) }) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the Static nominal is actual source signature evidence") return () }
  }
  let writtenRegion = match move Interned<Type>.with<Option<Interned<Lifetime>>>(&original, nominalTestParameterRegion) {
    Option<Interned<Lifetime>>.Some {value} => move value
    _ => { run Testing.expect(false, "the original nominal has one actual lifetime slot") return () }
  }
  let ordinal = Interned<Lifetime>.with<usize>(&writtenRegion,
    |value: &Lifetime| -> usize { return lifetimeOrdinalOf(value, &declared) })
  run Testing.expect(ordinal != usize.MAX, "the explicit slot is the original source callee's actual lifetime ordinal")
  let fresh = run DeclarationId.inferVar(2)
  let parameter = run Type.renameParameters(&original, &declared, &fresh)
  let mut variables = List<Interned<DeclarationId>>.make()
  let variable = run Types.internDeclaration(DeclarationId.copy(&fresh))
  run List<Interned<DeclarationId>>.append(&mut variables, Interned<DeclarationId>.clone(&variable))
  let mut bindings = List<Binding>.make()
  run List<Binding>.append(&mut bindings, Binding {declaration: Interned<DeclarationId>.clone(&variable),
    ordinal: ordinal, value: Argument.Lifetime {value: Interned<Lifetime>.clone(&region)}})
  let pattern = run Type.applyBindings(&parameter, List<Binding>.asSlice(&bindings), true)
  let initialSlice = List<Binding>.asSlice(&bindings)
  let initialBinding = &initialSlice[usize.ZERO]
  let mut originalProof = List<Binding>.make()
  run List<Binding>.append(&mut originalProof, Binding {declaration: Interned<DeclarationId>.clone(&initialBinding.declaration),
    ordinal: initialBinding.ordinal, value: Argument.copy(&initialBinding.value)})
  let originalFailure = run Type.unify(&parameter, &evidence, List<Interned<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut originalProof)
  run Testing.expect(match &originalFailure { Unification.Unified => false _ => true }, "the implicit operand starts with a real exact mismatch")
  let mut dependencies = List<Dependency>.make()
  let mut explicit = List<usize>.make()
  let premises = List<Constraint>.make()
  let implicit = run relatedCallArgument(&mut store.resolver, &mut store.query, &mut dependencies,
    &parameter, &pattern, &evidence, &fresh, &caller, List<Interned<DeclarationId>>.asSlice(&variables),
    List<Binding>.asSlice(&bindings), List<usize>.asSlice(&explicit), List<Constraint>.asSlice(&premises), Span.make(usize.ZERO, usize.ONE))
  let mut implicitProven = false
  if let Option<RelatedArgument>.Some {value} = &implicit {
    implicitProven = List<RegionPair>.length(&value.relations) == usize.ZERO
  }
  run Testing.expect(implicitProven,
    "the implicit slot has a real tracked covariant member proof, and Static storage needs no open relation")
  run Testing.expect(List<Dependency>.length(&dependencies) > usize.ZERO, "the proof retains actual member-query dependencies")
  run List<usize>.append(&mut explicit, ordinal)
  let fixed = run relatedCallArgument(&mut store.resolver, &mut store.query, &mut dependencies,
    &parameter, &pattern, &evidence, &fresh, &caller, List<Interned<DeclarationId>>.asSlice(&variables),
    List<Binding>.asSlice(&bindings), List<usize>.asSlice(&explicit), List<Constraint>.asSlice(&premises), Span.make(usize.ZERO, usize.ONE))
  // A written slot never moves, but Static storage still meets it by proven covariant subtyping.
  let mut fixedProven = false
  if let Option<RelatedArgument>.Some {value} = &fixed {
    fixedProven = List<RegionPair>.length(&value.relations) == usize.ZERO && run Type.equalsShared(&value.ty, &pattern)
  }
  run Testing.expect(fixedProven,
    "an explicitly fixed caller-local slot admits Static storage at exactly that slot with no open relation")
  run Testing.expect(List<Binding>.length(&bindings) == usize.ONE, "candidate proofs never append real inference bindings")
  let retainedSlice = List<Binding>.asSlice(&bindings)
  let retained = &retainedSlice[usize.ZERO]
  let unchanged = match &retained.value {
    Argument.Lifetime {value} => Lifetime.equalsShared(&value, &region)
    _ => false
  }
  run Testing.expect(unchanged, "candidate proofs never replace the real caller-local binding")
  let mut proof = List<Binding>.make()
  run List<Binding>.append(&mut proof, Binding {declaration: Interned<DeclarationId>.clone(&retained.declaration), ordinal: retained.ordinal,
    value: Argument.copy(&retained.value)})
  let rejected = run Type.unify(&parameter, &evidence, List<Interned<DeclarationId>>.asSlice(&variables), Comparison.Exact, &mut proof)
  run Testing.expect(match &rejected { Unification.Unified => false _ => true }, "the original Static operand still fails exact inference")
  return ()
}

test effect fn nominalRegionRelationExcludesExplicitCallerLocal() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  run nominalRegionExplicitOrdinalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  return ()
}

pub fn iterationFactCount(iterations: &List<IterationFacts>) -> usize { return List<IterationFacts>.length(iterations) }

pub effect fn iterationCalls(iterations: &Shared<List<IterationFacts>>, ordinal: usize) -> List<ResolvedCall>
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<List<IterationFacts>>.with<usize>(iterations, |value: &List<IterationFacts>| -> usize {
    let entries = List<IterationFacts>.asSlice(value)
    return List<ResolvedCall>.length(&entries[ordinal].calls)
  })
  let mut copied = List<ResolvedCall>.make()
  run List<ResolvedCall>.reserve(&mut copied, count)
  let mut at = usize.ZERO
  while at < count {
    // The callback only borrows one stored fact; its owned copy is made directly in O(1).
    let entry = Shared<List<IterationFacts>>.with<Option<ResolvedCall>>(iterations, |value: &List<IterationFacts>| -> Option<ResolvedCall> {
      let entries = List<IterationFacts>.asSlice(value)
      let calls = List<ResolvedCall>.asSlice(&entries[ordinal].calls)
      return match &calls[at].result {
        Result<ResolvedTarget, Shared<Rejection>>.Success {value: ResolvedTarget.Selected {fact}} => Option<ResolvedCall>.some(ResolvedCall {
          id: calls[at].id,
          result: Result<ResolvedTarget, Shared<Rejection>>.succeed(ResolvedTarget.Selected {fact: cloneSelectionFact(&fact)}),
        })
        _ => Option<ResolvedCall>.none()
      }
    })
    if let Option<ResolvedCall>.Some {value} = move entry {
      run List<ResolvedCall>.append(&mut copied, move value)
    }
    at = at + usize.ONE
  }
  return move copied
}

// Scope identity is the original for plus ordinal; node/local ranges authenticate all generated
// ordinary operations. No HIR cloning, source-span perturbation, or runtime iteration survives.
pub effect fn checkStaticFor(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut List<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &ResolvedCalls, nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, statement: HirId, body: HirId,
  resultType: &Interned<Type>, constraints: &[Constraint], contractBody: bool, staticBody: bool, loopDepth: usize, unsafeAllowed: bool)
-> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if staticBody { return run checkStaticFunctionFor(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut locals.*, annotations, calls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
    statement, body, resultType, constraints, contractBody, loopDepth, unsafeAllowed) }
  let selected = selectedFact(calls, statement)
  let iterations = match move selected {
    Option<SelectionFact>.Some {value: SelectionFact.StaticFor {iterations}} => move iterations
    _ => { return Result<CheckedControl, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.Undetermined, run bodySpan(&resolver.source, cursor, statement))) }
  }
  let length = Shared<List<IterationFacts>>.with<usize>(&iterations, iterationFactCount)
  let mut retained = List<BodyNodeId>.make()
  // The expansion completes only when every occurrence can; an occurrence that always returns or
  // fails ends the generated block like any other diverging statement.
  let mut completes = true
  let mut ordinal = usize.ZERO
  while ordinal < length {
    let mut annotationIds = List<HirId>.make()
    let mut writtenCalls = List<CallSyntax>.make()
    let mut declaration = usize.MAX
    if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, cursor) {
      let hir = IndexedSource.authored(indexed)
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let mut at = usize.ZERO
      while at < declarations.length {
        if DeclarationId.equals(&declarations[at].identity, caller) { declaration = at }
        at = at + usize.ONE
      }
      if let Node.Block {statements} = Module.node(hir, body) { run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls) }
    }
    if declaration == usize.MAX { fail InvalidModulePath {} }
    let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
    let resolved = run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
      moduleOrdinal, declaration, &annotationIds, &writtenCalls)
    let facts = match move resolved {
      Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
      Result<BodyFacts, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let BodyFacts {annotations: selectedAnnotations, calls: ordinaryCalls} = move facts
    let mut scopedCalls = run iterationCalls(&iterations, ordinal)
    // Copy ordinary targets after the occurrence's selected facts, so selection always wins.
    let targets = List<ResolvedCall>.asSlice(&ordinaryCalls)
    let mut at = usize.ZERO
    while at < targets.length {
      let target = match &targets[at].result {
        Result<ResolvedTarget, Shared<Rejection>>.Success {value} => Result<ResolvedTarget, Shared<Rejection>>.succeed(run copyResolvedTarget(&value))
        Result<ResolvedTarget, Shared<Rejection>>.Failure {error} => Result<ResolvedTarget, Shared<Rejection>>.failResult(Shared<Rejection>.clone(&error))
      }
      run List<ResolvedCall>.append(&mut scopedCalls, ResolvedCall {id: targets[at].id, result: move target})
      at = at + usize.ONE
    }
    let indexedCalls = run indexResolvedCalls(move scopedCalls)
    let nodeStart = List<BodyNode>.length(&nodes.*)
    let localStart = List<BodyLocal>.length(&locals.*)
    let savedStatic = run pushIterationStaticContext(&mut resolver.*, &iterations, ordinal, statement)
    let checked = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*, module, cursor, caller,
      &mut locals.*, List<ResolvedAnnotation>.asSlice(&selectedAnnotations), &indexedCalls,
      &mut nodes.*, &mut signatures.*, &mut requiredBodies.*, body, resultType, constraints, contractBody, staticBody, loopDepth, unsafeAllowed)
    popIterationStaticContext(&mut resolver.*, move savedStatic)
    let control = match move checked {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let end = List<BodyNode>.length(&nodes.*)
    let refusal = run generatedLoan(&nodes.*, nodeStart, end, localStart, caller, &run cursorAnchor(cursor))
    if let Option<Span>.Some {value} = move refusal {
      return Result<CheckedControl, Shared<Rejection>>.failResult(run rejectIteration(&resolver.*, module, RejectionCode.Undetermined, value, run bodySpan(&resolver.source, cursor, statement), ordinal))
    }
    run recordOccurrence(&mut resolver.*, StaticIteration {syntax: run anchoredNode(cursor, statement), ordinal: ordinal,
      nodeStart: nodeStart, nodeEnd: end, localStart: localStart, localEnd: List<BodyLocal>.length(&locals.*)})
    run List<BodyNodeId>.append(&mut retained, control.node)
    if !control.canComplete { completes = false }
    ordinal = ordinal + usize.ONE
  }
  let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run bodyOrigin(&resolver.source, cursor, statement),
    kind: BodyNodeKind.Block {statements: move retained, value: Option<BodyNodeId>.none(), canComplete: completes}})
  return Result<CheckedControl, Shared<Rejection>>.succeed(CheckedControl {node: node, canComplete: completes})
}

pub effect fn recordOccurrence(resolver: &mut Resolver, fact: StaticIteration) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = List<BodyFrame>.pop(&mut resolver.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    run List<StaticIteration>.append(&mut frame.occurrences, move fact)
    run List<BodyFrame>.append(&mut resolver.bodies, move frame)
  }
  return ()
}

pub effect fn takeOccurrenceFacts(resolver: &mut Resolver, output: &mut List<StaticIteration>) -> () ! OutOfMemoryError ? &mut Allocator {
  let popped = List<BodyFrame>.pop(&mut resolver.bodies)
  if let Option<BodyFrame>.Some {value} = move popped {
    let mut frame = move value
    let facts = List<StaticIteration>.asSlice(&frame.occurrences)
    let mut at = usize.ZERO
    while at < facts.length {
      let StaticIteration {syntax, ordinal, nodeStart, nodeEnd, localStart, localEnd} = &facts[at]
      run List<StaticIteration>.append(&mut output.*, StaticIteration {syntax: syntax, ordinal: ordinal,
        nodeStart: nodeStart, nodeEnd: nodeEnd, localStart: localStart, localEnd: localEnd})

      at = at + usize.ONE
    }
    run List<BodyFrame>.append(&mut resolver.bodies, move frame)
  }
  return ()
}

// A loan minted inside one static-for occurrence keeps its syntax-keyed region, which every
// occurrence of that syntax shares. That is sound while the loan stays inside its occurrence:
// each occurrence is checked over its own nodes, regions select no code, and a place declared
// outside the iteration keeps the region its declaration gave it. A value written to such a place
// therefore must not retain a region minted here, borrow storage the occurrence declares, or copy
// a reference held by a local the occurrence declares. A written value checks against the
// place's type, so its own type names the outside region; the operands show what it retains.
effect fn generatedLoan(nodes: &List<BodyNode>, start: usize, end: usize, localStart: usize, caller: &DeclarationId, anchor: &Anchor) -> Option<Span>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = List<BodyNode>.asSlice(nodes)
  let mut at = start
  while at < end {
    let mut escaping = Option<BodyNodeId>.none()
    match &written[at].kind {
      BodyNodeKind.Assignment {local, value} => { if local.index < localStart { escaping = Option<BodyNodeId>.some(value) } }
      BodyNodeKind.PlaceAssignment {target, value} => {
        if outsideIterationPlace(written, target, localStart) { escaping = Option<BodyNodeId>.some(value) }
      }
      _ => ()
    }
    if let Option<BodyNodeId>.Some {value: stored} = move escaping {
      if let BodyNodeKind.Expression {ty, ..} = &written[stored.index].kind {
        let mut regions = List<Interned<Lifetime>>.make()
        let representations = List<Option<Interned<Type>>>.make()
        let known = run Type.retainedRegions(&ty, caller, List<Option<Interned<Type>>>.asSlice(&representations), &mut regions, false)
        drop known
        if List<Interned<Lifetime>>.length(&regions) > usize.ZERO {
          let operand = run generatedOperand(written, stored, localStart, caller, anchor)
          if let Option<Span>.Some {value: retained} = move operand {
            return Option<Span>.some(retained)
          }
        }
        let captured = List<Interned<Lifetime>>.asSlice(&regions)
        let mut regionAt = usize.ZERO
        while regionAt < captured.length {
          let ordinal = Interned<Lifetime>.with<usize>(&captured[regionAt], |region: &Lifetime| -> usize {
            return match &region.* {
              Lifetime.Local {declaration, ordinal: localOrdinal, ..} => {
                if DeclarationId.equals(&declaration, caller) { return localOrdinal }
                return usize.MAX
              }
              _ => usize.MAX
            }
          })
          if ordinal != usize.MAX {
            let mut generated = start
            while generated < end {
              if written[generated].origin.node == ordinal { return Option<Span>.some(BodyOrigin.span(written[generated].origin, anchor)) }
              generated = generated + usize.ONE
            }
          }
          regionAt = regionAt + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<Span>.none()
}

// The first operand of a written value that borrows storage the occurrence declares, or reads a
// reference-retaining local the occurrence declares. Operands are visited through every child,
// including nested blocks, branches and match arms, so no retained path is skipped.
effect fn generatedOperand(nodes: &[BodyNode], value: BodyNodeId, localStart: usize, caller: &DeclarationId, anchor: &Anchor) -> Option<Span>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut pending = List<BodyNodeId>.make()
  run List<BodyNodeId>.append(&mut pending, value)
  while List<BodyNodeId>.length(&pending) > usize.ZERO {
    let popped = List<BodyNodeId>.pop(&mut pending)
    let next = match move popped {
      Option<BodyNodeId>.Some {value: found} => found
      Option<BodyNodeId>.None => { return Option<Span>.none() }
    }
    if next.index >= nodes.length { continue }
    match &nodes[next.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Borrow {value: borrowed, ..}, ..} => {
        if insideIterationPlace(nodes, borrowed, localStart) { return Option<Span>.some(BodyOrigin.span(nodes[next.index].origin, anchor)) }
      }
      BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} => {
        if local.index >= localStart {
          let mut regions = List<Interned<Lifetime>>.make()
          let representations = List<Option<Interned<Type>>>.make()
          let known = run Type.retainedRegions(&ty, caller, List<Option<Interned<Type>>>.asSlice(&representations), &mut regions, false)
          drop known
          if List<Interned<Lifetime>>.length(&regions) > usize.ZERO { return Option<Span>.some(BodyOrigin.span(nodes[next.index].origin, anchor)) }
        }
      }
      _ => ()
    }
    run appendOperands(nodes, next, &mut pending)
  }
  return Option<Span>.none()
}

// Appends every child of one checked node.
effect fn appendOperands(nodes: &[BodyNode], id: BodyNodeId, pending: &mut List<BodyNodeId>) -> () ! OutOfMemoryError ? &mut Allocator {
  match &nodes[id.index].kind {
    BodyNodeKind.Block {statements, ..} => { run appendAll(List<BodyNodeId>.asSlice(&statements), &mut pending.*) }
    BodyNodeKind.LocalBinding {initializer, ..} => { run List<BodyNodeId>.append(&mut pending.*, initializer) }
    BodyNodeKind.MutableBinding {initializer, ..} => { run List<BodyNodeId>.append(&mut pending.*, initializer) }
    BodyNodeKind.Assignment {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
    BodyNodeKind.PlaceAssignment {target, value} => {
      run List<BodyNodeId>.append(&mut pending.*, target)
      run List<BodyNodeId>.append(&mut pending.*, value)
    }
    BodyNodeKind.Drop {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
    BodyNodeKind.Return {value} => {
      if let Option<BodyNodeId>.Some {value: returned} = &value { run List<BodyNodeId>.append(&mut pending.*, returned) }
    }
    BodyNodeKind.Fail {value} => { run List<BodyNodeId>.append(&mut pending.*, value) }
    BodyNodeKind.Branch {condition, thenBranch, elseBranch, ..} => {
      run List<BodyNodeId>.append(&mut pending.*, condition)
      run List<BodyNodeId>.append(&mut pending.*, thenBranch)
      if let Option<BodyNodeId>.Some {value: other} = &elseBranch { run List<BodyNodeId>.append(&mut pending.*, other) }
    }
    BodyNodeKind.While {condition, body} => {
      run List<BodyNodeId>.append(&mut pending.*, condition)
      run List<BodyNodeId>.append(&mut pending.*, body)
    }
    BodyNodeKind.Expression {form, ..} => {
      match &form {
        BodyExpression.Aggregate {data: _bx} => {
  let AggregateData {fields, ..} = &_bx.get().*
 run appendFields(List<BodyAggregateField>.asSlice(&fields), &mut pending.*) }
        BodyExpression.Callable {data: _bx} => {
  let CallableData {fields, ..} = &_bx.get().*
 run appendFields(List<BodyAggregateField>.asSlice(&fields), &mut pending.*) }
        BodyExpression.VariantConstruct {fields, ..} => { run appendFields(List<BodyAggregateField>.asSlice(&fields), &mut pending.*) }
        BodyExpression.DirectCall {data: _bx} => {
  let DirectCallData {arguments, ..} = &_bx.get().*
 run appendAll(List<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.ForeignCall {data: _bx} => {
  let ForeignCallData {arguments, ..} = &_bx.get().*
 run appendAll(List<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.IntrinsicCall {arguments, ..} => { run appendAll(List<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.StorageCall {arguments, ..} => { run appendAll(List<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.InterfaceCall {data: _bx} => {
  let InterfaceCallData {arguments, ..} = &_bx.get().*
 run appendAll(List<BodyNodeId>.asSlice(&arguments), &mut pending.*) }
        BodyExpression.CallableCall {data: _bx} => {
  let CallableCallData {callee, arguments, ..} = &_bx.get().*

          run List<BodyNodeId>.append(&mut pending.*, callee)
          run appendAll(List<BodyNodeId>.asSlice(&arguments), &mut pending.*)
        }
        BodyExpression.StagedCallable {data: _bx} => {
  let StagedCallableData {callee, arguments, ..} = &_bx.get().*

          run List<BodyNodeId>.append(&mut pending.*, callee)
          run appendAll(List<BodyNodeId>.asSlice(&arguments), &mut pending.*)
        }
        BodyExpression.Match {subject, arms, ..} => {
          run List<BodyNodeId>.append(&mut pending.*, subject)
          let listed = List<BodyMatchArm>.asSlice(&arms)
          let mut arm = usize.ZERO
          while arm < listed.length {
            if let Option<BodyNodeId>.Some {value: guard} = &listed[arm].guard { run List<BodyNodeId>.append(&mut pending.*, guard) }
            run List<BodyNodeId>.append(&mut pending.*, listed[arm].result)
            arm = arm + usize.ONE
          }
        }
        BodyExpression.Index {value, index, ..} => {
          run List<BodyNodeId>.append(&mut pending.*, value)
          run List<BodyNodeId>.append(&mut pending.*, index)
        }
        BodyExpression.ConcreteInfix {left, right, ..} => {
          run List<BodyNodeId>.append(&mut pending.*, left)
          run List<BodyNodeId>.append(&mut pending.*, right)
        }
        BodyExpression.ConcretePrefix {operand, ..} => { run List<BodyNodeId>.append(&mut pending.*, operand) }
        BodyExpression.Borrow {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.PointerWeaken {value} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Dereference {value} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.RowField {call, ..} => { run List<BodyNodeId>.append(&mut pending.*, call) }
        BodyExpression.RowsColumn {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Field {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.ArraySlice {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.SliceLength {value} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.ArrayLength {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.ArrayRepeat {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.EnumValue {value} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.UnionInject {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.EraseReference {value} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.UnionWiden {value} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Move {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        BodyExpression.Run {value, ..} => { run List<BodyNodeId>.append(&mut pending.*, value) }
        _ => ()
      }
    }
    _ => ()
  }
  return ()
}

// Whether a checked loop body holds a `break` of that loop: one outside every nested loop.
pub effect fn breaksLoop(nodes: &[BodyNode], body: BodyNodeId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut pending = List<BodyNodeId>.make()
  run List<BodyNodeId>.append(&mut pending, body)
  while List<BodyNodeId>.length(&pending) > usize.ZERO {
    let popped = List<BodyNodeId>.pop(&mut pending)
    let next = match move popped {
      Option<BodyNodeId>.Some {value: found} => found
      Option<BodyNodeId>.None => { return false }
    }
    if next.index < nodes.length {
      let mut nested = false
      match &nodes[next.index].kind {
        BodyNodeKind.Break => { return true }
        BodyNodeKind.While {..} => { nested = true }
        _ => ()
      }
      if !nested { run appendOperands(nodes, next, &mut pending) }
    }
  }
  return false
}

pub effect fn appendAll(values: &[BodyNodeId], pending: &mut List<BodyNodeId>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < values.length {
    run List<BodyNodeId>.append(&mut pending.*, values[at])
    at = at + usize.ONE
  }
  return ()
}

effect fn appendFields(fields: &[BodyAggregateField], pending: &mut List<BodyNodeId>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < fields.length {
    run List<BodyNodeId>.append(&mut pending.*, fields[at].value)
    at = at + usize.ONE
  }
  return ()
}

// Whether a checked place is storage the occurrence declares: it is rooted in a local declared
// inside the iteration. A dereference reaches a referent the place does not own.
fn insideIterationPlace(nodes: &[BodyNode], value: BodyNodeId, localStart: usize) -> bool {
  let mut selected = value
  while selected.index < nodes.length {
    let mut parent = selected
    match &nodes[selected.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => {return local.index >= localStart}
      BodyNodeKind.Expression {form: BodyExpression.Field {value: subject, ..}, ..} => {parent = subject}
      BodyNodeKind.Expression {form: BodyExpression.Index {value: subject, ..}, ..} => {parent = subject}
      _ => {return false}
    }
    if parent.index >= selected.index {return false}
    selected = parent
  }
  return false
}

// Whether a checked place may lie outside the occurrence: it is rooted in a local declared before
// the iteration, or it is reached through a dereference, whose referent may be anywhere.
fn outsideIterationPlace(nodes: &[BodyNode], value: BodyNodeId, localStart: usize) -> bool {
  let mut selected = value
  while selected.index < nodes.length {
    let mut parent = selected
    match &nodes[selected.index].kind {
      BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => {return local.index < localStart}
      BodyNodeKind.Expression {form: BodyExpression.Field {value: subject, ..}, ..} => {parent = subject}
      BodyNodeKind.Expression {form: BodyExpression.Index {value: subject, ..}, ..} => {parent = subject}
      BodyNodeKind.Expression {form: BodyExpression.Dereference {..}, ..} => {return true}
      BodyNodeKind.Expression {form: BodyExpression.RowField {subject, ..}, ..} => {parent = subject}
      _ => {return false}
    }
    // A checked place only points to its already checked subject, never a temporary or a cycle.
    if parent.index >= selected.index {return false}
    selected = parent
  }
  return false
}

// The diagnostic keeps the authored failure span and original static-for ordinal; generated
// identities are never synthesized as source declarations or encoded by changing byte spans.
pub effect fn rejectIteration(resolver: &Resolver, module: &ModuleId, code: RejectionCode, span: Span,
  forSpan: Span, ordinal: usize) -> Shared<Rejection> ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<Interned<StaticData>>.make()
  run List<Interned<StaticData>>.append(&mut arguments, run Interned<StaticData>.make(StaticData.Integer {
    ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: usize.toU64(ordinal),
  }))
  let mut trace = List<StaticExecution.TraceStep>.make()
  // The original HIR id is source identity, while the primary diagnostic span stays authored.
  // Static selection owns the for's source observation; it cannot be a synthetic binder.
  run List<StaticExecution.TraceStep>.append(&mut trace, StaticExecution.TraceStep {
    name: run Bytes.copy(b"static for"), arguments: move arguments, span: forSpan, module: Option<ModuleId>.none(),
  })
  let failure = StaticDiagnostic {fault: StaticFault.Unsupported, code: b"", span: span, target: resolver.target,
    message: Option<Bytes>.none(), origin: Option<Span>.none(), byteOffset: Option<u64>.none(),
    rejection: Option<Shared<Rejection>>.none(), needed: Option<StaticNeeded>.none(),
    missing: Option<StaticExecution.MissingFact>.none(), trace: move trace}
  return run Shared<Rejection>.make(Rejection {
    code: code, module: ModuleId.copy(module), span: span, related: Option<RelatedSite>.none(),
    path: List<Interned<DeclarationId>>.make(), expected: usize.ZERO, supplied: usize.ZERO,
    parameterName: Bytes.make(), expectedKind: GenericKind.Type, suppliedKind: GenericKind.Type,
    witness: Option<WitnessProblem>.none(),
    staticFailure: Option<StaticDiagnostic>.some(move failure), specialization: List<Application>.make(), arguments: List<MessageArgument>.make(), owner: usize.MAX,
  })
}

// The lexical blocks under checking retain only their completed checked statement roots. A
// nested arm replays its parent's prefix and its own prefix from the application's arguments;
// sibling arm checking therefore cannot mutate the evaluator state another arm observes.
pub effect fn pushStaticPrefix(resolver: &mut Resolver) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO { run List<List<StaticPrefixWork>>.append(&mut frames[frames.length - usize.ONE].staticPrefixes, List<StaticPrefixWork>.make()) }
  return ()
}

pub fn popStaticPrefix(resolver: &mut Resolver) {
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO { drop List<List<StaticPrefixWork>>.pop(&mut frames[frames.length - usize.ONE].staticPrefixes) }
}

pub effect fn rememberStaticPrefix(resolver: &mut Resolver, statements: &[BodyNodeId], nodes: &[BodyNode], anchor: &Anchor) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut syntax = List<StaticPrefixWork>.make()
  let mut at = usize.ZERO
  while at < statements.length {
    let node = &nodes[statements[at].index]
    let mut work = StaticPrefixWork.Statement {syntax: BodyOrigin.syntax(node.origin, anchor)}
    if let BodyNodeKind.Expression {..} = &node.kind {work = StaticPrefixWork.Expression {syntax: BodyOrigin.syntax(node.origin, anchor)}}
    run List<StaticPrefixWork>.append(&mut syntax, move work)
    at = at + usize.ONE
  }
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  if frames.length > usize.ZERO {
    let mut prefixes = List<List<StaticPrefixWork>>.asMutSlice(&mut frames[frames.length - usize.ONE].staticPrefixes)
    if prefixes.length > usize.ZERO { prefixes[prefixes.length - usize.ONE] = move syntax }
  }
  return ()
}

struct PreparedStaticPrefix {
  prefix: List<StaticPrefixWork>,
  instance: Application,
  sourceAnswer: Shared<Result<SourceResult, NoRejection>>,
  checked: StaticExecution.CheckedRoot,
  arguments: List<StaticBinding>,
  target: MachineTarget,
  expressionSpan: Span,
}

pub effect fn staticPrefixExpression(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &[BodyLocal], nodes: &[BodyNode], root: BodyNodeId, expression: HirId)
-> Result<Interned<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let prepared = run prepareStaticPrefix(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, cursor, caller, locals, nodes, root, expression)
  return match move prepared {
    Result<PreparedStaticPrefix, Shared<Rejection>>.Success {value} => run evaluatePreparedStaticPrefix(
      &mut resolver.*, &mut owner.*, &mut dependencies.*, module, expression, move value)
    Result<PreparedStaticPrefix, Shared<Rejection>>.Failure {error} => Result<Interned<StaticData>, Shared<Rejection>>.failResult(move error)
  }
}

effect fn prepareStaticPrefix(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &[BodyLocal], nodes: &[BodyNode], root: BodyNodeId, expression: HirId)
-> Result<PreparedStaticPrefix, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut application = Option<Application>.none()
  let mut prefix = List<StaticPrefixWork>.make()
  let frames = List<BodyFrame>.asSlice(&resolver.bodies)
  if frames.length > usize.ZERO {
    let frame = &frames[frames.length - usize.ONE]
    if let Option<Application>.Some {value} = &frame.staticApplication { application = Option<Application>.some(run Application.copy(&value)) }
    let blocks = List<List<StaticPrefixWork>>.asSlice(&frame.staticPrefixes)
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = List<StaticPrefixWork>.asSlice(&blocks[block])
      let mut at = usize.ZERO
      while at < statements.length { run List<StaticPrefixWork>.append(&mut prefix, StaticExecution.copyPrefix(&statements[at]))
        at = at + usize.ONE }
      block = block + usize.ONE
    }
  }
  let instance = match move application {
    Option<Application>.Some {value} => move value
    Option<Application>.None => { return Result<PreparedStaticPrefix, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, cursor, expression))) }
  }
  let sourceAnswer = run source(&mut resolver.*, module)
  let mut occurrenceFacts = List<StaticIteration>.make()
  run takeOccurrenceFacts(&mut resolver.*, &mut occurrenceFacts)
  let copied = run TypedBody.checkpoint(caller, locals, nodes, root, move occurrenceFacts)
  let body = run Shared<TypedBody>.make(move copied)
  let checked = StaticExecution.checkedCheckpoint(move body)
  let mut arguments = List<StaticBinding>.make()
  let values = List<StaticSlot>.asSlice(&instance.statics)
  let mut at = usize.ZERO
  while at < values.length {
    if values[at].ordinal >= locals.length { fail InvalidModulePath {} }
    run List<StaticBinding>.append(&mut arguments, StaticBinding {module: ModuleId.copy(module),
      binder: run originSyntax(cursor, locals[values[at].ordinal].origin), value: StaticValue.copy(&values[at].value)})
    at = at + usize.ONE
  }
  let target = resolver.target
  let expressionSpan = run bodySpan(&resolver.source, cursor, expression)
  return Result<PreparedStaticPrefix, Shared<Rejection>>.succeed(PreparedStaticPrefix {
    prefix: move prefix,
    instance: move instance,
    sourceAnswer: move sourceAnswer,
    checked: move checked,
    arguments: move arguments,
    target: target,
    expressionSpan: expressionSpan,
  })
}

effect fn evaluatePreparedStaticPrefix(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, expression: HirId, prepared: PreparedStaticPrefix)
-> Result<Interned<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let PreparedStaticPrefix {prefix, instance, sourceAnswer: _, checked, arguments, target, expressionSpan} = move prepared
  let port = inFlightStaticPort(&mut resolver.*, &mut owner.*, &mut dependencies.*)
  let mut machine = run StaticExecution.make(move port, module, StaticExecution.defaultLimits())
  run StaticExecution.useInstance(&mut machine, &instance)
  let bound = List<StaticBinding>.asSlice(&arguments)
  let completed = List<StaticPrefixWork>.asSlice(&prefix)
  let mut bindings = List<StaticBinding>.make()
  while StaticExecution.steps(&machine) < StaticExecution.stepLimit(&machine) {
    let supplied = List<StaticBinding>.asSlice(&bindings)
    let attempted = run Effect.result(StaticExecution.evaluatePrefix(&mut machine, &checked, bound, supplied, completed, expression))
    match move attempted {
      Result<Interned<StaticData>, StaticDiagnostic | OutOfMemoryError>.Success {value} => {
        return Result<Interned<StaticData>, Shared<Rejection>>.succeed(move value)
      }
      Result<Interned<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => {
        let ended = run staticEvaluationRejection(&mut machine, &mut bindings, module, move error)
        if let Option<Shared<Rejection>>.Some {value: rejected} = move ended {
          return Result<Interned<StaticData>, Shared<Rejection>>.failResult(move rejected)
        }
      }
    }
  }
  let failedPort = StaticExecution.port(&mut machine)
  return Result<Interned<StaticData>, Shared<Rejection>>.failResult(run rejectStatic(&failedPort.resolver.*, module,
    StaticDiagnostic {fault: StaticFault.StepLimit, code: b"SEM0179", span: expressionSpan, target: target,
      message: Option<Bytes>.none(), origin: Option<Span>.none(), byteOffset: Option<u64>.none(),
      rejection: Option<Shared<Rejection>>.none(), needed: Option<StaticNeeded>.none(),
      missing: Option<StaticExecution.MissingFact>.none(), trace: List<StaticExecution.TraceStep>.make()}))
}

// A static function expands the iterable inside the current evaluator-local context. Each
// generated scope receives its exact element type, and later iterations replay earlier checked
// iterations before reading outer mutable slots (STATIC-005, STATIC-010).
effect fn checkStaticFunctionFor(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, request: &mut Request,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor, caller: &DeclarationId,
  locals: &mut List<BodyLocal>, annotations: &[ResolvedAnnotation], calls: &ResolvedCalls, nodes: &mut List<BodyNode>,
  signatures: &mut List<SignatureDependency>, requiredBodies: &mut List<DeclarationId>, statement: HirId, body: HirId,
  resultType: &Interned<Type>, constraints: &[Constraint], contractBody: bool, loopDepth: usize, unsafeAllowed: bool)
-> Result<CheckedControl, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = run bodyNode(&resolver.source, cursor, statement)
  let mut binding = HirId {index: usize.MAX}
  let mut iterable = HirId {index: usize.MAX}
  if let Node.StaticForStatement {binding: binder, iterable: expression, ..} = written { binding = binder
    iterable = expression }
  if binding.index == usize.MAX { fail InvalidModulePath {} }
  // Like a reached static condition, the iterable has no enclosing body call facts. Its helper
  // calls are resolved here while an empty collection still leaves the iteration body silent.
  let resolvedIterable = run staticReachedFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    module, cursor, caller, iterable)
  let iterableFacts = match move resolvedIterable {
    Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
    Result<BodyFacts, Shared<Rejection>>.Failure {error} => {return Result<CheckedControl, Shared<Rejection>>.failResult(move error)}
  }
  let BodyFacts {annotations: iterableAnnotations, calls: iterableTargets} = move iterableFacts
  let mut iterableCalls = move iterableTargets
  run carrySelectionFacts(calls, &mut iterableCalls)
  let indexedIterableCalls = run indexResolvedCalls(move iterableCalls)
  let checked = run checkStatementExpression(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
    module, cursor, caller, &mut locals.*, List<ResolvedAnnotation>.asSlice(&iterableAnnotations), resultType,
    loopDepth, &indexedIterableCalls, &mut nodes.*,
    &mut signatures.*, &mut requiredBodies.*, iterable, &Option<Interned<Type>>.none(), RejectionCode.TypeMismatch, constraints, contractBody, true, unsafeAllowed, false)
  let iterableNode = match move checked {
    Result<BodyNodeId, Shared<Rejection>>.Success {value} => value
    Result<BodyNodeId, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
  }
  let evaluated = run staticPrefixExpression(&mut resolver.*, &mut owner.*, &mut dependencies.*, module, cursor, caller,
    List<BodyLocal>.asSlice(&locals.*), List<BodyNode>.asSlice(&nodes.*), iterableNode, iterable)
  let sequence = match move evaluated {
    Result<Interned<StaticData>, Shared<Rejection>>.Success {value} => move value
    Result<Interned<StaticData>, Shared<Rejection>>.Failure {error} => { return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
  }
  let length = Interned<StaticData>.with<usize>(&sequence, StaticValue.sequenceLength)
  if length == usize.MAX { return Result<CheckedControl, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, cursor, iterable))) }
  let declaredElement = match &List<BodyNode>.asSlice(&nodes.*)[iterableNode.index].kind {
    BodyNodeKind.Expression {ty, ..} => Interned<Type>.with<Option<Interned<Type>>>(&ty, CheckedIntrinsic.staticSequenceElement)
    _ => Option<Interned<Type>>.none()
  }
  let mut retained = List<BodyNodeId>.make()
  run pushStaticPrefix(&mut resolver.*)
  let mut ordinal = usize.ZERO
  while ordinal < length {
    let element = match move Interned<StaticData>.with<Option<Interned<StaticData>>>(&sequence,
      |data: &StaticData| -> Option<Interned<StaticData>> { return StaticValue.sequenceElement(data, ordinal) }) {
      Option<Interned<StaticData>>.Some {value} => move value
      Option<Interned<StaticData>>.None => { fail InvalidModulePath {} }
    }
    let iterableSpan = run bodySpan(&resolver.source, cursor, iterable)
    let exact = Interned<StaticData>.with<Option<Interned<Type>>>(&element, |data: &StaticData| -> Option<Interned<Type>> {
      return match &data.* {
        StaticData.Field {ty, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
        StaticData.Aggregate {ty, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
        StaticData.Sequence {ty, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
        StaticData.Text {..} => match &declaredElement {
          Option<Interned<Type>>.Some {value: textType} => Option<Interned<Type>>.some(Interned<Type>.clone(&textType))
          Option<Interned<Type>>.None => Option<Interned<Type>>.none()
        }
        _ => Option<Interned<Type>>.none()
      }
    })
    let elementType = match move exact {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => match move run embeddedType(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, iterableSpan) {
        Option<Interned<Type>>.Some {value} => move value
        Option<Interned<Type>>.None => { popStaticPrefix(&mut resolver.*)
          return Result<CheckedControl, Shared<Rejection>>.failResult(run reject(&resolver.*, module, RejectionCode.StaticPhaseViolation, run bodySpan(&resolver.source, cursor, iterable))) }
      }
    }
    let localStart = List<BodyLocal>.length(&locals.*)
    run List<BodyLocal>.append(&mut locals.*, BodyLocal {origin: run bodyOrigin(&resolver.source, cursor, binding),
      ty: move elementType, mutable: false, meetDepth: Option<usize>.none(), written: false})
    run appendStaticPrefix(&mut resolver.*, StaticPrefixWork.Binding {binder: binding, start: List<BodyNode>.length(&nodes.*), value: StaticValue.copy(&element)})
    let nodeStart = List<BodyNode>.length(&nodes.*)
    let selectedFacts = run staticReachedFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, cursor, caller, body)
    let facts = match move selectedFacts {
      Result<BodyFacts, Shared<Rejection>>.Success {value} => move value
      Result<BodyFacts, Shared<Rejection>>.Failure {error} => { removeStaticPrefixTail(&mut resolver.*)
        popStaticPrefix(&mut resolver.*)
        return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let BodyFacts {annotations: scopedAnnotations, calls: scopedCalls} = move facts
    let indexedScopedCalls = run indexResolvedCalls(move scopedCalls)
    let checkedBody = run checkBlock(&mut resolver.*, &mut owner.*, &mut request.*, &mut dependencies.*,
      module, cursor, caller, &mut locals.*, List<ResolvedAnnotation>.asSlice(&scopedAnnotations),
      &indexedScopedCalls, &mut nodes.*, &mut signatures.*, &mut requiredBodies.*,
      body, resultType, constraints, contractBody, true, loopDepth, unsafeAllowed)
    removeStaticPrefixTail(&mut resolver.*)
    let control = match move checkedBody {
      Result<CheckedControl, Shared<Rejection>>.Success {value} => move value
      Result<CheckedControl, Shared<Rejection>>.Failure {error} => { popStaticPrefix(&mut resolver.*)
          return Result<CheckedControl, Shared<Rejection>>.failResult(move error) }
    }
    let end = List<BodyNode>.length(&nodes.*)
    run recordOccurrence(&mut resolver.*, StaticIteration {syntax: run anchoredNode(cursor, statement), ordinal: ordinal,
      nodeStart: nodeStart, nodeEnd: end, localStart: localStart, localEnd: List<BodyLocal>.length(&locals.*)})
    run List<BodyNodeId>.append(&mut retained, control.node)
    run appendStaticPrefix(&mut resolver.*, StaticPrefixWork.Iteration {syntax: body, start: nodeStart,
      end: end, binder: binding, value: StaticValue.copy(&element)})
    ordinal = ordinal + usize.ONE
  }
  popStaticPrefix(&mut resolver.*)
  let node = BodyNodeId {index: List<BodyNode>.length(&nodes.*)}
  run List<BodyNode>.append(&mut nodes.*, BodyNode {origin: run bodyOrigin(&resolver.source, cursor, statement),
    kind: BodyNodeKind.Block {statements: move retained, value: Option<BodyNodeId>.none(), canComplete: true}})
  return Result<CheckedControl, Shared<Rejection>>.succeed(CheckedControl {node: node, canComplete: true})
}

effect fn appendStaticPrefix(resolver: &mut Resolver, work: StaticPrefixWork) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  let mut prefixes = List<List<StaticPrefixWork>>.asMutSlice(&mut frames[frames.length - usize.ONE].staticPrefixes)
  return run List<StaticPrefixWork>.append(&mut prefixes[prefixes.length - usize.ONE], move work)
}

fn removeStaticPrefixTail(resolver: &mut Resolver) {
  let mut frames = List<BodyFrame>.asMutSlice(&mut resolver.bodies)
  let mut prefixes = List<List<StaticPrefixWork>>.asMutSlice(&mut frames[frames.length - usize.ONE].staticPrefixes)
  drop List<StaticPrefixWork>.pop(&mut prefixes[prefixes.length - usize.ONE])
}

// Ordinary routing for the selected static iteration scope. An empty sequence never reaches
// this demand, so its body names and signatures contribute no diagnostics or dependencies.
pub effect fn staticReachedFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, module: &ModuleId, cursor: &AuthoredCursor,
  caller: &DeclarationId, body: HirId) -> Result<BodyFacts, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut annotationIds = List<HirId>.make()
  let mut writtenCalls = List<CallSyntax>.make()
  let mut declaration = usize.MAX
  if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(&resolver.source, cursor) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < declarations.length {
      if DeclarationId.equals(&declarations[at].identity, caller) { declaration = at }
      at = at + usize.ONE
    }
    if let Node.Block {statements} = Module.node(hir, body) {
      run collectBodySyntax(hir, statements, &mut annotationIds, &mut writtenCalls)
    } else {run collectCall(hir, body, &mut annotationIds, &mut writtenCalls)}
  }
  if declaration == usize.MAX { fail InvalidModulePath {} }
  let moduleOrdinal = knownModuleOrdinal(&resolver.*, module)
  return run resolveBodyFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, module,
    moduleOrdinal, declaration, &annotationIds, &writtenCalls)
}

fn reflectedMemberCount(answer: &Result<Answer, NoRejection>) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {return List<Member>.length(&members)}
  }
  return usize.ZERO
}

fn reflectedMemberVisible(answer: &Result<Answer, NoRejection>, at: usize) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = List<Member>.asSlice(&members)
      if at < listed.length {return listed[at].isPublic}
    }
  }
  return false
}

effect fn reflectedMemberLabel(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(answer, |found: &Result<Answer, NoRejection>| -> usize {
    return reflectedLabelLength(found, at)
  })
  let mut label = run Bytes.zeroed(count)
  let copied = Shared<Result<Answer, NoRejection>>.with<bool>(answer, |found: &Result<Answer, NoRejection>| -> bool {
    return copyReflectedLabel(found, at, &mut label)
  })
  drop copied
  return move label
}

fn reflectedLabelLength(answer: &Result<Answer, NoRejection>, at: usize) -> usize {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = List<Member>.asSlice(&members)
      if at < listed.length {if let Option<Bytes>.Some {value: name} = &listed[at].name {return Bytes.length(&name)}}
    }
  }
  return usize.ZERO
}

fn copyReflectedLabel(answer: &Result<Answer, NoRejection>, at: usize, output: &mut Bytes) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Members {members, ..}} = &value.outcome {
      let listed = List<Member>.asSlice(&members)
      if at < listed.length {if let Option<Bytes>.Some {value: name} = &listed[at].name {return copyReflectionBytes(&name, &mut output.*)}}
    }
  }
  return false
}

fn copyReflectionBytes(input: &Bytes, output: &mut Bytes) -> bool {
  let source = Bytes.asSlice(input)
  let mut target = Bytes.asMutSlice(&mut output.*)
  if source.length != target.length {return false}
  let mut at = usize.ZERO
  while at < source.length {target[at] = source[at] at = at + usize.ONE}
  return true
}

effect fn reflectedAnonymousLabel(occurrence: &Frozen<AnonymousOccurrence>, ordinal: usize) -> Bytes
! OutOfMemoryError ? &mut Allocator {
  let count = Frozen<AnonymousOccurrence>.with<usize>(occurrence, |found: &AnonymousOccurrence| -> usize {
    let labels = List<Bytes>.asSlice(&found.labels)
    if ordinal < labels.length {return Bytes.length(&labels[ordinal])}
    return usize.ZERO
  })
  let mut label = run Bytes.zeroed(count)
  let copied = Frozen<AnonymousOccurrence>.with<bool>(occurrence, |found: &AnonymousOccurrence| -> bool {
    let labels = List<Bytes>.asSlice(&found.labels)
    if ordinal < labels.length {return copyReflectionBytes(&labels[ordinal], &mut label)}
    return false
  })
  drop copied
  return move label
}

effect fn inferenceGoalOwner(namespace: &[u8]) -> DeclarationId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"memory", namespace, b"inference-goals.silk")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"sameSpelling")), occurrence: 0})
  return run DeclarationId.fromParts(move module, move owners)
}

test effect fn callableFutureContentsPremises() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callableContentsPremiseClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableContentsPremiseClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let caller = run inferenceGoalOwner(b"contents")
  let target = run Types.internLifetime(Lifetime.Parameter {declaration: DeclarationId.copy(&caller), ordinal: 0})
  let input = run Types.internLifetime(Lifetime.Parameter {declaration: DeclarationId.copy(&caller), ordinal: 1})
  let output = run Types.internLifetime(Lifetime.Parameter {declaration: DeclarationId.copy(&caller), ordinal: 2})
  let environment = run Types.internLifetime(Lifetime.Parameter {declaration: DeclarationId.copy(&caller), ordinal: 3})
  let outer = run Types.internLifetime(Lifetime.Parameter {declaration: DeclarationId.copy(&caller), ordinal: 4})
  let unit = run Types.intern(Type.Unit)
  let argument = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&unit), access: Access.Shared, lifetime: Interned<Lifetime>.clone(&input)})
  let result = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&unit), access: Access.Shared, lifetime: Interned<Lifetime>.clone(&output)})
  let mut parameters = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&argument))
  let mut environments = List<Interned<Lifetime>>.make()
  run List<Interned<Lifetime>>.append(&mut environments, Interned<Lifetime>.clone(&environment))
  let callable = run Types.intern(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: run Frozen<Intersection>.make(run Intersection.of(List<Interned<Lifetime>>.asSlice(&environments))),
    invocationBinders: 0, invocationUse: usize.MAX, invocationBounds: List<Outlives>.make(),
    parameters: move parameters, result: move result})
  let mut declared = List<Constraint>.make()
  run List<Constraint>.append(&mut declared, Constraint.Contents {subject: Interned<Type>.clone(&callable), region: Interned<Lifetime>.clone(&target)})
  let callableEdges = run contentsOutlives(List<Constraint>.asSlice(&declared), &caller)
  run Testing.expect(run knownOutlives(List<Constraint>.asSlice(&callableEdges), &environment, &target), "a callable contents premise implies its stored environment")
  run Testing.expect(!run knownOutlives(List<Constraint>.asSlice(&callableEdges), &input, &target), "a callable contents premise does not imply its future input region")
  run Testing.expect(!run knownOutlives(List<Constraint>.asSlice(&callableEdges), &output, &target), "a callable contents premise does not imply its future result region")
  List<Constraint>.truncate(&mut declared, 0)
  let computation = run Types.intern(Type.Effect {mode: CallableMode.Shared,
    environment: run Frozen<Intersection>.make(run Intersection.of(List<Interned<Lifetime>>.asSlice(&environments))),
    success: Interned<Type>.clone(&argument), failure: run Types.intern(Type.Reference {
      referent: Interned<Type>.clone(&unit), access: Access.Shared, lifetime: Interned<Lifetime>.clone(&output)}),
    requirements: run Types.internRow(Row.empty())})
  run List<Constraint>.append(&mut declared, Constraint.Contents {subject: move computation, region: Interned<Lifetime>.clone(&target)})
  let effectEdges = run contentsOutlives(List<Constraint>.asSlice(&declared), &caller)
  run Testing.expect(run knownOutlives(List<Constraint>.asSlice(&effectEdges), &environment, &target), "an Effect contents premise implies its retained environment")
  let successOutlives = run knownOutlives(List<Constraint>.asSlice(&effectEdges), &input, &target)
  let failureOutlives = run knownOutlives(List<Constraint>.asSlice(&effectEdges), &output, &target)
  run Testing.expect(!successOutlives && !failureOutlives, "an Effect's future success and failure types are not stored contents")
  List<Constraint>.truncate(&mut declared, 0)
  let borrowed = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&callable), access: Access.Shared, lifetime: Interned<Lifetime>.clone(&outer)})
  run List<Constraint>.append(&mut declared, Constraint.Contents {subject: move borrowed, region: Interned<Lifetime>.clone(&target)})
  let borrowedEdges = run contentsOutlives(List<Constraint>.asSlice(&declared), &caller)
  run Testing.expect(run knownOutlives(List<Constraint>.asSlice(&borrowedEdges), &outer, &target), "stored reference contents imply the reference region")
  run Testing.expect(!run knownOutlives(List<Constraint>.asSlice(&borrowedEdges), &environment, &target), "a contents expansion does not descend through a stored reference")
  List<Constraint>.truncate(&mut declared, 0)
  let generic = run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&caller), ordinal: 5})
  let mut members = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut members, move generic)
  run List<Interned<Type>>.append(&mut members, move argument)
  let mixed = run Types.intern(Type.Union {members: move members})
  run List<Constraint>.append(&mut declared, Constraint.Contents {subject: move mixed, region: Interned<Lifetime>.clone(&target)})
  let mixedEdges = run contentsOutlives(List<Constraint>.asSlice(&declared), &caller)
  run Testing.expect(run knownOutlives(List<Constraint>.asSlice(&mixedEdges), &input, &target), "unknown stored parameters do not discard later known stored regions")
  return ()
}

// A recursive component receives a fact only from a reached callee; fixed-linkage barriers
// stop suspension propagation while the same edges propagate parking through those callers.
effect fn callGraphClosureClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut callers = List<List<CallEdge>>.make()
  let mut marked = List<bool>.make()
  let mut blocked = List<bool>.make()
  let mut at = usize.ZERO
  while at < 7 {
    run List<List<CallEdge>>.append(&mut callers, List<CallEdge>.make())
    run List<bool>.append(&mut marked, at == usize.ZERO)
    run List<bool>.append(&mut blocked, at == 3)
    at = at + usize.ONE
  }
  let incoming = List<List<CallEdge>>.asMutSlice(&mut callers)
  run List<CallEdge>.append(&mut incoming[0], CallEdge {target: 1, call: 0})
  run List<CallEdge>.append(&mut incoming[1], CallEdge {target: 2, call: 0})
  run List<CallEdge>.append(&mut incoming[2], CallEdge {target: 1, call: 0})
  run List<CallEdge>.append(&mut incoming[2], CallEdge {target: 3, call: 0})
  run List<CallEdge>.append(&mut incoming[3], CallEdge {target: 4, call: 0})
  run List<CallEdge>.append(&mut incoming[5], CallEdge {target: 6, call: 0})
  run List<CallEdge>.append(&mut incoming[6], CallEdge {target: 5, call: 0})
  run closeCallers(&mut marked, List<List<CallEdge>>.asSlice(&callers), List<bool>.asSlice(&blocked))
  at = usize.ZERO
  while at < 7 {
    run Testing.expect(List<bool>.get(&marked, at) == (at < 3), "suspension crosses recursive callers but stops at a fixed-linkage shim")
    at = at + usize.ONE
  }
  run closeCallers(&mut marked, List<List<CallEdge>>.asSlice(&callers), &[])
  at = usize.ZERO
  while at < 7 {
    run Testing.expect(List<bool>.get(&marked, at) == (at < 5), "parking crosses a shim without marking an unreachable recursive component")
    at = at + usize.ONE
  }
}

test effect fn callGraphClosureCrossesCyclesAndHonorsBarriers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run callGraphClosureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn bodySourceChecked(answer: &Result<Answer, NoRejection>) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {..} => true
      _ => false
    }
    _ => false
  }
}

// Repeated source reads belong to nested captures even after the current query has recorded
// that body. A later revision must also authenticate its new body rather than retain the view.
effect fn bodySourceSnapshotClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let module = run ModuleId.make(b"memory", b"snapshot", b"body.silk")
  let original = Option<Bytes>.some(run Bytes.copy(b"fn value() -> i32 { return 1 + 2 }\n"))
  let revision = run Revision.publish(&Revision.make(), &module, &original)
  let mut store = Semantic.make(run Revision.copy(&revision), MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option<FinalProfile>.none())
  let ordinal = run internModule(&mut store.resolver, &module)
  let answer = run demandSource(&mut store.resolver, &module)
  let id = match move sourceOf(&store.resolver, &answer, &module) {
    Option<&IndexedSource>.Some {value} => HirId {index: ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))[0].header.index + usize.ONE}
    Option<&IndexedSource>.None => { run Testing.expect(false, "source snapshot fixture is present") return () }
  }
  let word = run internKey(&mut store.resolver, Key {family: Family.ModuleCheck, module: ordinal, name: 99,
    declaration: usize.MAX, member: usize.ZERO, external: false})
  let unit = u64.toUsize(word.value)
  run Graph.startRun(&mut store.resolver.graph, unit)
  run List<Word>.append(&mut store.resolver.active, word)
  store.resolver.currentRun = usize.ONE
  drop run observedSyntax(&mut store.resolver, &module, id)
  drop run observedSyntax(&mut store.resolver, &module, id)
  let outer = Graph.beginCapture(&mut store.resolver.graph, unit)
  drop run observedSyntax(&mut store.resolver, &module, id)
  let inner = Graph.beginCapture(&mut store.resolver.graph, unit)
  drop run observedSyntax(&mut store.resolver, &module, id)
  let nested = run Graph.endCapture(&mut store.resolver.graph, inner)
  let captured = run Graph.endCapture(&mut store.resolver.graph, outer)
  run Testing.expect(List<Dependee>.length(&nested) == usize.ONE && List<Dependee>.length(&captured) == 2,
    "nested dependency captures keep repeated reads of an already observed body")
  List<Word>.truncate(&mut store.resolver.active, usize.ZERO)
  store.resolver.currentRun = usize.ZERO
  store.resolver.bodySource = Option<BodySourceSnapshot>.none()
  drop run Graph.finishRun(&mut store.resolver.graph, unit, Option<ContentHash>.none())
  let mut request = Request.make()
  let before = run Semantic.demandBody(&mut store, &mut request, &module, b"value")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&before, bodySourceChecked), "the original body checks")
  let changed = run Revision.publish(&revision, &module, &Option<Bytes>.some(run Bytes.copy(b"fn value() -> i32 { return true }\n")))
  run Semantic.update(&mut store, move changed)
  let after = run Semantic.demandBody(&mut store, &mut request, &module, b"value")
  run Testing.expect(!Shared<Result<Answer, NoRejection>>.with<bool>(&after, bodySourceChecked), "a new query authenticates the edited source body")
}

test effect fn bodySourceSnapshotsRespectCapturesAndRevisions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run bodySourceSnapshotClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Which declaration's `///` block a documentation read wants.
enum DocumentedPart {
  Type,
  Field,
  Variant,
  VariantField,
}

// Whether `byte` can be part of a name in a written type.
fn nameByte(byte: u8) -> bool {
  return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

// The name of the first field of the struct `ty` that is not `pub`, empty when there is none.
effect fn privateFieldOf(resolver: &mut Resolver, ty: &Interned<Type>) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
  let named = Interned<Type>.with<Option<DeclarationId>>(ty, |value: &Type| -> Option<DeclarationId> {
    return match &value.* {
      Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
      _ => Option<DeclarationId>.none()
    }
  })
  let owner = match move named {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return Bytes.make() }
  }
  let module = ModuleId.copy(DeclarationId.moduleId(&owner))
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &module) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < declarations.length {
      if DeclarationId.equals(&declarations[at].identity, &owner) {
        if let Node.Declaration {header, ..} = Module.node(hir, declarations[at].local) {
          if let Node.StructHeader {fields, ..} = Module.node(hir, header) {
            let mut index = usize.ZERO
            while index < fields.length {
              if let Node.Field {name, isPublic, ..} = Module.node(hir, Module.child(hir, fields, index)) {
                if !isPublic {
                  if let Node.Name {text} = Module.node(hir, name) { return run Bytes.copy(Module.text(hir, text)) }
                }
              }
              index = index + usize.ONE
            }
          }
        }
        return Bytes.make()
      }
      at = at + usize.ONE
    }
  }
  return Bytes.make()
}

// The `///` text of `ty`'s declaration, or of its field or variant `label`, without slashes;
// empty when none was written. The reference generator's own attachment rule decides which
// comment a declaration owns, so reflection and the generated reference agree.
effect fn documentationOf(resolver: &mut Resolver, ty: &Interned<Type>, part: DocumentedPart, label: &[u8], ordinal: usize) -> Bytes
! Cycle | OutOfMemoryError ? &mut Allocator {
  let named = Interned<Type>.with<Option<DeclarationId>>(ty, |value: &Type| -> Option<DeclarationId> {
    return match &value.* {
      Type.Nominal {declaration, ..} => Option<DeclarationId>.some(DeclarationId.copy(&declaration))
      _ => Option<DeclarationId>.none()
    }
  })
  let owner = match move named {
    Option<DeclarationId>.Some {value} => move value
    Option<DeclarationId>.None => { return Bytes.make() }
  }
  let module = ModuleId.copy(DeclarationId.moduleId(&owner))
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, &module) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let mut at = usize.ZERO
    while at < declarations.length {
      if DeclarationId.equals(&declarations[at].identity, &owner) {
        let mut documented = Option<usize>.none()
        if part == DocumentedPart.Type { documented = Option<usize>.some(Module.span(hir, declarations[at].local).start) }
        if let Node.Declaration {header, ..} = Module.node(hir, declarations[at].local) {
          let mut members = Option<Range>.none()
          if part == DocumentedPart.Field {
            if let Node.StructHeader {fields, ..} = Module.node(hir, header) { members = Option<Range>.some(fields) }
          }
          if part == DocumentedPart.Variant {
            if let Node.UnionHeader {variants, ..} = Module.node(hir, header) { members = Option<Range>.some(variants) }
          }
          if part == DocumentedPart.VariantField {
            if let Node.UnionHeader {variants, ..} = Module.node(hir, header) {
              let mut variant = usize.ZERO
              while variant < variants.length && documented.isNone() {
                if let Node.Variant {fields, ..} = Module.node(hir, Module.child(hir, variants, variant)) {
                  if ordinal < fields.length {
                    let field = Module.child(hir, fields, ordinal)
                    if let Node.Field {name, ..} = Module.node(hir, field) {
                      if let Node.Name {text} = Module.node(hir, name) {
                        if same(Module.text(hir, text), label) { documented = Option<usize>.some(Module.span(hir, field).start) }
                      }
                    }
                  }
                }
                variant = variant + usize.ONE
              }
            }
          }
          if let Option<Range>.Some {value: range} = members {
            let mut index = usize.ZERO
            while index < range.length {
              let member = Module.child(hir, range, index)
              let mut nameNode = Option<HirId>.none()
              if let Node.Field {name, ..} = Module.node(hir, member) { nameNode = Option<HirId>.some(name) }
              if let Node.Variant {name, ..} = Module.node(hir, member) { nameNode = Option<HirId>.some(name) }
              if let Option<HirId>.Some {value: name} = nameNode {
                if let Node.Name {text} = Module.node(hir, name) {
                  if same(Module.text(hir, text), label) { documented = Option<usize>.some(Module.span(hir, member).start) }
                }
              }
              index = index + usize.ONE
            }
          }
        }
        if let Option<usize>.Some {value: start} = documented {
          let tree = run SourceUnit.syntaxTree(IndexedSource.sourceUnit(indexed))
          let lines = run Attached.lines(Bytes.asSlice(&tree.source))
          return match move run Attached.declaration(&tree, start, List<usize>.asSlice(&lines)) {
            Option<Document>.Some {value} => move value.markdown
            Option<Document>.None => Bytes.make()
          }
        }
        return Bytes.make()
      }
      at = at + usize.ONE
    }
  }
  return Bytes.make()
}
