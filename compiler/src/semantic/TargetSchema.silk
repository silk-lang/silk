//! Original declaration slots for a selected function and its enclosing implementation scopes.

import semantic.DeclarationId {DeclarationId}
import semantic.Rejection {GenericKind}
import semantic.Specialization {Application, ScopeBinding}
import semantic.Type {Argument}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One original binder ordinal and its required argument kind.
pub struct BinderSlot {
  pub ordinal: usize
  pub kind: GenericKind
}

impl Copy for BinderSlot {}

/// The complete binder list of an actual enclosing declaration, excluding derived Self.
pub struct Scope {
  pub owner: Shared<DeclarationId>
  pub slots: Vector<BinderSlot>
}

/// A header-derived application contract. Building it never demands the target body.
pub struct TargetSchema {
  pub declaration: Shared<DeclarationId>
  pub own: Vector<BinderSlot>
  pub scopes: Vector<Scope>
}

fn kind(argument: &Argument) -> GenericKind {
  return match &argument.* {
    Argument.Type {..} => GenericKind.Type
    Argument.Lifetime {..} => GenericKind.Lifetime
    Argument.Row {..} => GenericKind.Requirement
  }
}

fn matches(slots: &[BinderSlot], arguments: &[Argument], ordinals: &[usize]) -> bool {
  if slots.length != arguments.length || slots.length != ordinals.length { return false }
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].ordinal != ordinals[at] || slots[at].kind != kind(&arguments[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

impl TargetSchema {
  /// Checks target, owner, ordinal, arity and kind against the actual declaration headers.
  pub effect fn accepts(self: &Self, application: &Application) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    if !Shared.with<DeclarationId, bool>(&self.declaration, fn(id: &DeclarationId) -> bool {
      return DeclarationId.equals(id, Application.bodyDeclaration(application))
    }) { return false }
    if !matches(Vector.asSlice<BinderSlot>(&self.own), Vector.asSlice<Argument>(&application.arguments),
      Vector.asSlice<usize>(&application.argumentOrdinals)) { return false }
    let expected = Vector.asSlice<Scope>(&self.scopes)
    let given = Vector.asSlice<ScopeBinding>(&application.scopes)
    if expected.length != given.length { return false }
    let mut at = usize.ZERO
    while at < expected.length {
      let owner = run DeclarationId.copyShared(&expected[at].owner)
      if !Shared.with<DeclarationId, bool>(&given[at].owner, fn(id: &DeclarationId) -> bool {
        return DeclarationId.equals(id, &owner)
      }) || !matches(Vector.asSlice<BinderSlot>(&expected[at].slots), Vector.asSlice<Argument>(&given[at].arguments),
        Vector.asSlice<usize>(&given[at].argumentOrdinals)) { return false }
      at = at + usize.ONE
    }
    return true
  }
}
