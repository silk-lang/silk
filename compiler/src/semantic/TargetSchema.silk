//! Original declaration slots for a selected function and its enclosing implementation scopes.

import semantic.DeclarationId {DeclarationId}
import semantic.Rejection {GenericKind}
import semantic.Specialization {Application, ScopeBinding}
import semantic.Type {Argument}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One original binder ordinal and its required argument kind.
pub struct BinderSlot {
  pub ordinal: usize
  pub kind: GenericKind
}

impl Copy for BinderSlot {}

/// Original slots of an actual enclosing declaration, excluding derived Self. An inherent
/// contract requires only the slots it mentions; an applied owner may additionally supply every
/// lexical slot for uses appearing only in the body.
pub struct Scope {
  pub owner: Shared<DeclarationId>
  pub slots: Vector<BinderSlot>
  pub requiredOrdinals: Vector<usize>
}

/// A header-derived application contract. Building it never demands the target body.
pub struct TargetSchema {
  pub declaration: Shared<DeclarationId>
  pub own: Vector<BinderSlot>
  pub scopes: Vector<Scope>
}

fn kind(argument: &Argument) -> GenericKind {
  return match &argument.* {
    Argument.Type {..} => GenericKind.Type
    Argument.Lifetime {..} => GenericKind.Lifetime
    Argument.Row {..} => GenericKind.Requirement
  }
}

fn matches(slots: &[BinderSlot], arguments: &[Argument], ordinals: &[usize]) -> bool {
  if slots.length != arguments.length || slots.length != ordinals.length { return false }
  let mut at = usize.ZERO
  while at < slots.length {
    if slots[at].ordinal != ordinals[at] || slots[at].kind != kind(&arguments[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

fn matchesScope(scope: &Scope, arguments: &[Argument], ordinals: &[usize]) -> bool {
  if arguments.length == usize.ZERO || arguments.length != ordinals.length { return false }
  let slots = Vector.asSlice<BinderSlot>(&scope.slots)
  let mut at = usize.ZERO
  let mut slotAt = usize.ZERO
  while at < ordinals.length {
    if at > usize.ZERO && ordinals[at - usize.ONE] >= ordinals[at] { return false }
    while slotAt < slots.length && slots[slotAt].ordinal < ordinals[at] { slotAt = slotAt + usize.ONE }
    if slotAt == slots.length || slots[slotAt].ordinal != ordinals[at]
      || slots[slotAt].kind != kind(&arguments[at]) { return false }
    at = at + usize.ONE
  }
  let required = Vector.asSlice<usize>(&scope.requiredOrdinals)
  at = usize.ZERO
  let mut givenAt = usize.ZERO
  while at < required.length {
    while givenAt < ordinals.length && ordinals[givenAt] < required[at] { givenAt = givenAt + usize.ONE }
    if givenAt == ordinals.length || ordinals[givenAt] != required[at] { return false }
    at = at + usize.ONE
  }
  return true
}

impl TargetSchema {
  /// Checks target, owner, ordinal, arity and kind against the actual declaration headers.
  pub effect fn accepts(self: &Self, application: &Application) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    if !Shared.with<DeclarationId, bool>(&self.declaration, fn(id: &DeclarationId) -> bool {
      return DeclarationId.equals(id, Application.bodyDeclaration(application))
    }) { return false }
    if !matches(Vector.asSlice<BinderSlot>(&self.own), Vector.asSlice<Argument>(&application.arguments),
      Vector.asSlice<usize>(&application.argumentOrdinals)) { return false }
    let expected = Vector.asSlice<Scope>(&self.scopes)
    let given = Vector.asSlice<ScopeBinding>(&application.scopes)
    let mut at = usize.ZERO
    let mut givenAt = usize.ZERO
    while at < expected.length {
      let owner = run DeclarationId.copyShared(&expected[at].owner)
      let mut present = false
      if givenAt < given.length {
        present = Shared.with<DeclarationId, bool>(&given[givenAt].owner, fn(id: &DeclarationId) -> bool {
          return DeclarationId.equals(id, &owner)
        })
      }
      if present {
        if !matchesScope(&expected[at], Vector.asSlice<Argument>(&given[givenAt].arguments),
          Vector.asSlice<usize>(&given[givenAt].argumentOrdinals)) { return false }
        givenAt = givenAt + usize.ONE
      } else if Vector.length<usize>(&expected[at].requiredOrdinals) > usize.ZERO { return false }
      at = at + usize.ONE
    }
    return givenAt == given.length
  }
}
