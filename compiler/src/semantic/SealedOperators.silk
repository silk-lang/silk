//! The compiler-owned source of the sealed Intrinsic operator declarations (INTR-007).

import Stream { Stream }
import lexer.Lexer { Lexer }
import lexer.Token as Tokens { Token, TokenKind }
import parser.SyntaxTree { SyntaxTree }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.slice { Slice }
import silk.usize
import silk.vector { Vector }

/// The source path relative to the compiler's standard-library distribution, never an import.
pub fn path() -> &'static [u8] {
  return b"intrinsic/operators.silk"
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether a logical path is reserved for the compiler-owned source.
pub fn isPath(candidate: &[u8]) -> bool {
  return same(candidate, path())
}

/// Collects public top-level interface and enum names from the shared source itself.
pub effect fn members(source: &[u8]) -> Vector<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut names = Vector<Bytes>.make()
  let mut lexer = Lexer.make(source)
  let mut depth = usize.ZERO
  let mut state = usize.ZERO
  while true {
    let token = match move run Stream.take(&mut lexer) {
      Option<Token>.Some { value } => value
      Option<Token>.None => {
        break
      }
    }
    let kind = Tokens.kind(token)
    if trivia(kind) {
      continue
    }
    if depth == usize.ZERO {
      if state == 2 && kind == TokenKind.Identifier {
        let span = Tokens.span(token)
        run Vector<
          Bytes
        >.append(
          &mut names,
          run Bytes.copy(Slice.view<u8>(source, span.start, span.end - span.start))
        )
      }
      if state == usize.ONE
        && (kind == TokenKind.InterfaceKeyword || kind == TokenKind.EnumKeyword) {
        state = 2
      } else if kind == TokenKind.PubKeyword {
        state = usize.ONE
      } else {
        state = usize.ZERO
      }
    }
    if kind == TokenKind.LeftBrace {
      depth = depth + usize.ONE
    } else if kind == TokenKind.RightBrace && depth > usize.ZERO {
      depth = depth - usize.ONE
    }
  }
  return move names
}

fn member(names: &[Bytes], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < names.length {
    if same(Bytes.asSlice(&names[at]), name) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn trivia(kind: TokenKind) -> bool {
  return kind == TokenKind.Whitespace || kind == TokenKind.LineComment
    || kind == TokenKind.DocComment
    || kind == TokenKind.ModuleDocComment
}

/// Finds a significant-token spelling `Intrinsic.<member>`, excluding comments and literals.
pub fn referenced(syntax: &SyntaxTree, names: &[Bytes]) -> bool {
  let tokens = Vector<Token>.asSlice(&syntax.tokens)
  let bytes = Bytes.asSlice(&syntax.source)
  let mut state = usize.ZERO
  let mut at = usize.ZERO
  while at < tokens.length {
    let token = tokens[at]
    let kind = Tokens.kind(token)
    if
      !trivia(kind) {
      let span = Tokens.span(token)
      let text = Slice.view<u8>(bytes, span.start, span.end - span.start)
      if state == 2 && kind == TokenKind.Identifier && member(names, text) {
        return true
      }
      if state == usize.ONE && kind == TokenKind.Dot {
        state = 2
      } else if kind == TokenKind.Identifier && same(text, b"Intrinsic") {
        state = usize.ONE
      } else {
        state = usize.ZERO
      }
    }
    at = at + usize.ONE
  }
  return false
}
