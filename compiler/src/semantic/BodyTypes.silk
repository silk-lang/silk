    BodyWire.leaveRead(&mut input.*)
    if input.failed || at >= List<Interned<Row>>.length(&state.rows) { return reject<Interned<Row>>(&mut input.*) }
    return Option<Interned<Row>>.some(Interned<Row>.clone(&List<Interned<Row>>.asSlice(&state.rows)[at]))
  }
  if tag != 0 || !admittedRead(&state.*, &mut input.*) { BodyWire.leaveRead(&mut input.*)
    return reject<Interned<Row>>(&mut input.*) }
  let decoded = run readRowNode(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  if let Option<Interned<Row>>.Some {value} = move decoded {
    if !admittedRead(&state.*, &mut input.*) { return Option<Interned<Row>>.none() }
    run List<Interned<Row>>.append(&mut state.rows, Interned<Row>.clone(&value))
    state.total = state.total + usize.ONE
    return Option<Interned<Row>>.some(move value)
  }
  return reject<Interned<Row>>(&mut input.*)
}
/// Encodes all stable module/owner-chain components, never a local HIR index.
pub effect fn writeDeclaration(state: &mut Encoder, output: &mut Writer, value: &DeclarationId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let entries = List<DeclarationId>.asSlice(&state.declarations)
  let hash = DeclarationId.hash(value)
  let mut at = InternIndex.first(&state.declarationsIndex, hash)
  while at != usize.MAX && chargeProbe(&mut output.*) {
    if DeclarationId.equals(&entries[at], value) { run BodyWire.word(&mut output.*, 1)
      run writeSize(&mut output.*, at)
      return () }
    at = InternIndex.after(&state.declarationsIndex, at)
  }
  if !admittedWrite(&state.*, &mut output.*) { return () }
  let length = DeclarationId.withContent<usize>(value, fn(bytes: &[u8]) -> usize { return bytes.length })
  // The temporary stable-content copy must fit the caller's capsule limit before allocation.
  // Reserve both the new-definition tag and field-length word in addition to its payload.
  if DeclarationId.ownerCount(value) > BodyWire.ENTRY_LIMIT { BodyWire.refuse(&mut output.*, BodyWire.RESOURCE) return () }
  if output.limit < 16 || length > output.limit - 16 || Bytes.length(&output.bytes) > output.limit - 16 - length { BodyWire.refuse(&mut output.*, BodyWire.SIZE)
    return () }
  let mut content = Bytes.make()
  run DeclarationId.appendContent(value, &mut content)
  run BodyWire.word(&mut output.*, 0)
  run BodyWire.field(&mut output.*, Bytes.asSlice(&content))
  if !output.failed { run List<DeclarationId>.reserve(&mut state.declarations, usize.ONE)
    run InternIndex.reserveNext(&mut state.declarationsIndex)
    run List<DeclarationId>.append(&mut state.declarations, DeclarationId.copy(value))
    run InternIndex.record(&mut state.declarationsIndex, hash)
    state.total = state.total + usize.ONE }
}
/// Decodes a stable declaration only after its complete identity content validates.
pub effect fn readDeclaration(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<DeclarationId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 1 {
    let at = readSize(bytes, &mut input.*)
    if input.failed || at >= List<DeclarationId>.length(&state.declarations) { return reject<DeclarationId>(&mut input.*) }
    return Option<DeclarationId>.some(DeclarationId.copy(&List<DeclarationId>.asSlice(&state.declarations)[at]))
  }
  if tag != 0 || !admittedRead(&state.*, &mut input.*) { return reject<DeclarationId>(&mut input.*) }
  let field = BodyWire.readField(bytes, &mut input.*)
  if input.failed { return Option<DeclarationId>.none() }
  let content = StableKey.view(bytes, field)
  let mut header = BodyWire.reader(content)
  let _origin = BodyWire.readField(content, &mut header)
  let _package = BodyWire.readField(content, &mut header)
  let _path = BodyWire.readField(content, &mut header)
  let owners = BodyWire.readWord(content, &mut header)
  if header.failed || owners > usize.toU64(BodyWire.ENTRY_LIMIT) { return reject<DeclarationId>(&mut input.*) }
  let decoded = run StableKey.declarationIn(bytes, field)
  if let Option<DeclarationId>.Some {value} = move decoded {
    if DeclarationId.ownerCount(&value) > BodyWire.ENTRY_LIMIT { return reject<DeclarationId>(&mut input.*) }
    run List<DeclarationId>.append(&mut state.declarations, DeclarationId.copy(&value))
    state.total = state.total + usize.ONE
    return Option<DeclarationId>.some(move value)
  }
  return reject<DeclarationId>(&mut input.*)
}
