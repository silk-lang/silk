  let declaration = run Types.internDeclaration(move declarationOwned)
  let ordinal = readSize(bytes, &mut input.*)
  let value = match move run readArgument(&mut state.*, bytes, &mut input.*) { Option<Argument>.Some {value} => move value _ => { return reject<Binding>(&mut input.*) } }
