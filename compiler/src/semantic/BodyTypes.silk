//! Portable structural dictionaries for one guarded typed-body capsule.
//!
//! Wire ids refer only to completed earlier definitions in this capsule. Encoder addresses are
//! private lookup accelerators and retained handles prevent reuse; no address is serialized.
//! Decoder interning is private draft work until the caller validates the entire capsule/guard.
//! Unsupported private admissions, callable schemas and witness recipes refuse the whole capsule.

import semantic.BodyWire
import semantic.InternIndex {InternIndex}
import semantic.BodyWire {Writer, Reader}
import semantic.StableKey
import semantic.Types {Types}
import semantic.Type {Type, Argument, Binding, Row, Requirement, RowParameter, RowSubtraction, Outlives, AnonymousOccurrence, CallableFieldInput, Composition}
import semantic.Lifetime {Lifetime, Intersection, Member}
import semantic.Specialization {Application, Target, ScopeBinding, StaticSlot}
import semantic.StaticValue
import semantic.StaticValue {Value as StaticData, IntegerType, FloatType, Sign}
import semantic.DeclarationId {DeclarationId}
import semantic.ForeignContract {ForeignContract, Memory, Locality}
import hir.Hir {Access, CallableMode, Multiplicity}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.mem.frozen {Frozen}
import silk.mem.pointer {Pointer}
import silk.num.usize
import silk.num.u64
import silk.num.u32

/// Capsule-local encoder tables; entries are never resolver indexes.
pub struct Encoder {
  typesIndex: InternIndex,
  types: List<Interned<Type>>,
  lifetimesIndex: InternIndex,
  lifetimes: List<Interned<Lifetime>>,
  applicationsIndex: InternIndex,
  applications: List<Interned<Application>>,
  staticsIndex: InternIndex,
  statics: List<Interned<StaticData>>,
  rowsIndex: InternIndex,
  rows: List<Interned<Row>>,
  declarationsIndex: InternIndex,
  declarations: List<DeclarationId>,
  total: usize,
}
/// Starts a fresh encoder dictionary for exactly one capsule.
pub fn encoder() -> Encoder {
  return Encoder {typesIndex: InternIndex.make(), types: List<Interned<Type>>.make(), lifetimesIndex: InternIndex.make(), lifetimes: List<Interned<Lifetime>>.make(), applicationsIndex: InternIndex.make(), applications: List<Interned<Application>>.make(), staticsIndex: InternIndex.make(), statics: List<Interned<StaticData>>.make(), rowsIndex: InternIndex.make(), rows: List<Interned<Row>>.make(), declarationsIndex: InternIndex.make(), declarations: List<DeclarationId>.make(), total: usize.ZERO}
}
/// Capsule-local decoder tables; entries are never resolver indexes.
pub struct Decoder {
  types: List<Interned<Type>>,
  lifetimes: List<Interned<Lifetime>>,
  applications: List<Interned<Application>>,
  statics: List<Interned<StaticData>>,
  rows: List<Interned<Row>>,
  declarations: List<DeclarationId>,
  total: usize,
}
/// Starts a fresh decoder dictionary for exactly one capsule.
pub fn decoder() -> Decoder {
  return Decoder {types: List<Interned<Type>>.make(), lifetimes: List<Interned<Lifetime>>.make(), applications: List<Interned<Application>>.make(), statics: List<Interned<StaticData>>.make(), rows: List<Interned<Row>>.make(), declarations: List<DeclarationId>.make(), total: usize.ZERO}
}

fn reject<T>(input: &mut Reader) -> Option<T> { input.failed = true
  return Option<T>.none() }
fn chargeProbe(output: &mut Writer) -> bool {
  if output.failed || output.steps >= BodyWire.STEP_LIMIT { BodyWire.refuse(&mut output.*, BodyWire.RESOURCE)
    return false }
  output.steps = output.steps + usize.ONE
  return true
}
fn admittedWrite(state: &Encoder, output: &mut Writer) -> bool {
  if output.failed || state.total >= BodyWire.ENTRY_LIMIT { BodyWire.refuse(&mut output.*, BodyWire.RESOURCE)
    return false }
  return true
}
fn admittedRead(state: &Decoder, input: &mut Reader) -> bool {
  if input.failed || state.total >= BodyWire.ENTRY_LIMIT { input.failed = true
    return false }
  return true
}
effect fn writeSize(output: &mut Writer, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run BodyWire.word(&mut output.*, usize.toU64(value))
}
fn readSize(bytes: &[u8], input: &mut Reader) -> usize {
  let value = BodyWire.readWord(bytes, &mut input.*)
  if value > usize.toU64(usize.MAX) { input.failed = true
    return usize.ZERO }
  return u64.toUsize(value)
}
effect fn writeCount(output: &mut Writer, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if count > BodyWire.ENTRY_LIMIT { BodyWire.refuse(&mut output.*, BodyWire.RESOURCE)
    return () }
  run writeSize(&mut output.*, count)
}
effect fn writeBool(output: &mut Writer, value: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if value { run BodyWire.word(&mut output.*, 1) } else { run BodyWire.word(&mut output.*, 0) }
}
fn readBool(bytes: &[u8], input: &mut Reader) -> bool {
  let value = BodyWire.readWord(bytes, &mut input.*)
  if value > 1 { input.failed = true }
  return value == 1
}
effect fn readBytes(bytes: &[u8], input: &mut Reader) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let field = BodyWire.readField(bytes, &mut input.*)
  if input.failed { return Bytes.make() }
  return run Bytes.copy(StableKey.view(bytes, field))
}
effect fn writeAccess(output: &mut Writer, value: Access) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { Access.Shared => 0 Access.Mutable => 1 }
  run BodyWire.word(&mut output.*, tag)
}
fn readAccess(bytes: &[u8], input: &mut Reader) -> Access {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Access.Shared }
  if tag == 1 { return Access.Mutable }
  input.failed = true
  return Access.Shared
}
effect fn writeCallableMode(output: &mut Writer, value: CallableMode) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { CallableMode.Shared => 0 CallableMode.Mutable => 1 CallableMode.Once => 2 }
  run BodyWire.word(&mut output.*, tag)
}
fn readCallableMode(bytes: &[u8], input: &mut Reader) -> CallableMode {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return CallableMode.Shared }
  if tag == 1 { return CallableMode.Mutable }
  if tag == 2 { return CallableMode.Once }
  input.failed = true
  return CallableMode.Shared
}
effect fn writeMultiplicity(output: &mut Writer, value: Multiplicity) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { Multiplicity.Single => 0 Multiplicity.Many => 1 }
  run BodyWire.word(&mut output.*, tag)
}
fn readMultiplicity(bytes: &[u8], input: &mut Reader) -> Multiplicity {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Multiplicity.Single }
  if tag == 1 { return Multiplicity.Many }
  input.failed = true
  return Multiplicity.Single
}
effect fn writeMemory(output: &mut Writer, value: Memory) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { Memory.None => 0 Memory.Read => 1 Memory.Write => 2 Memory.ReadWrite => 3 }
  run BodyWire.word(&mut output.*, tag)
}
fn readMemory(bytes: &[u8], input: &mut Reader) -> Memory {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Memory.None }
  if tag == 1 { return Memory.Read }
  if tag == 2 { return Memory.Write }
  if tag == 3 { return Memory.ReadWrite }
  input.failed = true
  return Memory.None
}
effect fn writeLocality(output: &mut Writer, value: Locality) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { Locality.External => 0 Locality.Arguments => 1 }
  run BodyWire.word(&mut output.*, tag)
}
fn readLocality(bytes: &[u8], input: &mut Reader) -> Locality {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Locality.External }
  if tag == 1 { return Locality.Arguments }
  input.failed = true
  return Locality.External
}
effect fn writeIntegerType(output: &mut Writer, value: IntegerType) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { IntegerType.U8 => 0 IntegerType.U16 => 1 IntegerType.U32 => 2 IntegerType.U64 => 3 IntegerType.Usize => 4 IntegerType.I8 => 5 IntegerType.I16 => 6 IntegerType.I32 => 7 IntegerType.I64 => 8 IntegerType.Isize => 9 }
  run BodyWire.word(&mut output.*, tag)
}
fn readIntegerType(bytes: &[u8], input: &mut Reader) -> IntegerType {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return IntegerType.U8 }
  if tag == 1 { return IntegerType.U16 }
  if tag == 2 { return IntegerType.U32 }
  if tag == 3 { return IntegerType.U64 }
  if tag == 4 { return IntegerType.Usize }
  if tag == 5 { return IntegerType.I8 }
  if tag == 6 { return IntegerType.I16 }
  if tag == 7 { return IntegerType.I32 }
  if tag == 8 { return IntegerType.I64 }
  if tag == 9 { return IntegerType.Isize }
  input.failed = true
  return IntegerType.U8
}
effect fn writeFloatType(output: &mut Writer, value: FloatType) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { FloatType.F32 => 0 FloatType.F64 => 1 }
  run BodyWire.word(&mut output.*, tag)
}
fn readFloatType(bytes: &[u8], input: &mut Reader) -> FloatType {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return FloatType.F32 }
  if tag == 1 { return FloatType.F64 }
  input.failed = true
  return FloatType.F32
}
effect fn writeSign(output: &mut Writer, value: Sign) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { Sign.Positive => 0 Sign.Negative => 1 }
  run BodyWire.word(&mut output.*, tag)
}
fn readSign(bytes: &[u8], input: &mut Reader) -> Sign {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Sign.Positive }
  if tag == 1 { return Sign.Negative }
  input.failed = true
  return Sign.Positive
}
effect fn writeComposition(output: &mut Writer, value: Composition) -> () ! OutOfMemoryError ? &mut Allocator {
  let tag: u64 = match value { Composition.CatchFailure => 0 Composition.BindShared => 1 Composition.BindExclusive => 2 Composition.BindOwned => 3 Composition.Finalize => 4 Composition.FinalizeNonParking => 5 Composition.UseRelease => 6 Composition.Observe => 7 Composition.Suspend => 8 Composition.Interrupt => 9 }
  run BodyWire.word(&mut output.*, tag)
}
fn readComposition(bytes: &[u8], input: &mut Reader) -> Composition {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Composition.CatchFailure }
  if tag == 1 { return Composition.BindShared }
  if tag == 2 { return Composition.BindExclusive }
  if tag == 3 { return Composition.BindOwned }
  if tag == 4 { return Composition.Finalize }
  if tag == 5 { return Composition.FinalizeNonParking }
  if tag == 6 { return Composition.UseRelease }
  if tag == 7 { return Composition.Observe }
  if tag == 8 { return Composition.Suspend }
  if tag == 9 { return Composition.Interrupt }
  input.failed = true
  return Composition.CatchFailure
}
fn addressType(value: &Type) -> usize { return Pointer.address<Type>(Pointer.fromRef<Type>(value)) }
/// Encodes an exact Type with capsule-local backward dictionary references.
pub effect fn writeType(state: &mut Encoder, output: &mut Writer, value: &Interned<Type>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if !BodyWire.enterWrite(&mut output.*) { return () }
  let address = Interned<Type>.with<usize>(value, addressType)
  let existing = List<Interned<Type>>.asSlice(&state.types)
  let mut at = InternIndex.first(&state.typesIndex, usize.toU64(address))
  while at != usize.MAX && chargeProbe(&mut output.*) {
    if Interned<Type>.with<usize>(&existing[at], addressType) == address {
      run BodyWire.word(&mut output.*, 1)
      run writeSize(&mut output.*, at)
      BodyWire.leaveWrite(&mut output.*)
      return ()
    }
    at = InternIndex.after(&state.typesIndex, at)
  }
  if admittedWrite(&state.*, &mut output.*) {
    run BodyWire.word(&mut output.*, 0)
    run writeTypeNode(&mut state.*, &mut output.*, value)
    if admittedWrite(&state.*, &mut output.*) {
      run List<Interned<Type>>.reserve(&mut state.types, usize.ONE)
      run InternIndex.reserveNext(&mut state.typesIndex)
      run List<Interned<Type>>.append(&mut state.types, Interned<Type>.clone(value))
      run InternIndex.record(&mut state.typesIndex, usize.toU64(address))
      state.total = state.total + usize.ONE
    }
  }
  BodyWire.leaveWrite(&mut output.*)
}
/// Decodes an exact Type; malformed, forward, cyclic or unsupported entries fail transactionally.
pub effect fn readType(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Interned<Type>>.none() }
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 1 {
    let at = readSize(bytes, &mut input.*)
    BodyWire.leaveRead(&mut input.*)
    if input.failed || at >= List<Interned<Type>>.length(&state.types) { return reject<Interned<Type>>(&mut input.*) }
    return Option<Interned<Type>>.some(Interned<Type>.clone(&List<Interned<Type>>.asSlice(&state.types)[at]))
  }
  if tag != 0 || !admittedRead(&state.*, &mut input.*) { BodyWire.leaveRead(&mut input.*)
    return reject<Interned<Type>>(&mut input.*) }
  let decoded = run readTypeNode(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  if let Option<Interned<Type>>.Some {value} = move decoded {
    if !admittedRead(&state.*, &mut input.*) { return Option<Interned<Type>>.none() }
    run List<Interned<Type>>.append(&mut state.types, Interned<Type>.clone(&value))
    state.total = state.total + usize.ONE
    return Option<Interned<Type>>.some(move value)
  }
  return reject<Interned<Type>>(&mut input.*)
}
