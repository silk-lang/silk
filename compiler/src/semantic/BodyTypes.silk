      run writeSign(&mut output.*, sign)
      run BodyWire.word(&mut output.*, magnitude)
    }
    StaticData.Text {bytes} => { run BodyWire.word(&mut output.*, 6)
      run BodyWire.field(&mut output.*, Bytes.asSlice(&bytes)) }
