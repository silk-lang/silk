/// Encodes exact Outlives fields in declaration order.
pub effect fn writeOutlives(state: &mut Encoder, output: &mut Writer, value: &Outlives) -> () ! OutOfMemoryError ? &mut Allocator {
  run writeLifetime(&mut state.*, &mut output.*, &value.longer)
  run writeLifetime(&mut state.*, &mut output.*, &value.shorter)
}
/// Decodes exact Outlives fields, refusing incomplete values.
pub effect fn readOutlives(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Outlives> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let longer = match move run readLifetime(&mut state.*, bytes, &mut input.*) { Option<Interned<Lifetime>>.Some {value} => move value _ => { return reject<Outlives>(&mut input.*) } }
  let shorter = match move run readLifetime(&mut state.*, bytes, &mut input.*) { Option<Interned<Lifetime>>.Some {value} => move value _ => { return reject<Outlives>(&mut input.*) } }
  if input.failed { return Option<Outlives>.none() }
  return Option<Outlives>.some(Outlives {longer: move longer, shorter: move shorter})
}
/// Encodes exact Requirement fields in declaration order.
pub effect fn writeRequirement(state: &mut Encoder, output: &mut Writer, value: &Requirement) -> () ! OutOfMemoryError ? &mut Allocator {
  run writeType(&mut state.*, &mut output.*, &value.capability)
  run writeOptionType(&mut state.*, &mut output.*, &value.roleType)
  run writeAccess(&mut output.*, value.access)
}
/// Decodes exact Requirement fields, refusing incomplete values.
pub effect fn readRequirement(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Requirement> ! OutOfMemoryError ? &mut Allocator | &mut Types {
