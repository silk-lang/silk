  if tag == 2 { let scalar = BodyWire.readWord(bytes, &mut input.*)
    if scalar > 0x10ffff { return reject<StaticData>(&mut input.*) }
    return StaticValue.character(u64.toU32(scalar)) }
  if tag == 3 {
    let ty = readIntegerType(bytes, &mut input.*)
    let sign = readSign(bytes, &mut input.*)
    let magnitude = BodyWire.readWord(bytes, &mut input.*)
    if magnitude == 0 && sign == Sign.Negative { return reject<StaticData>(&mut input.*) }
    return StaticValue.integer(ty, sign, magnitude, 64)
  }
  if tag == 4 { let ty = readFloatType(bytes, &mut input.*)
    let bits = BodyWire.readWord(bytes, &mut input.*)
    return StaticValue.floating(ty, bits) }
  if tag == 5 {
    let declaration = match move run readDeclaration(&mut state.*, bytes, &mut input.*) {
      Option<DeclarationId>.Some {value} => run Types.internDeclaration(move value)
      _ => { return reject<StaticData>(&mut input.*) }
    }
    let member = readSize(bytes, &mut input.*)
    let representation = readIntegerType(bytes, &mut input.*)
    let sign = readSign(bytes, &mut input.*)
    let magnitude = BodyWire.readWord(bytes, &mut input.*)
    if magnitude == 0 && sign == Sign.Negative { return reject<StaticData>(&mut input.*) }
    return StaticValue.enumeration(move declaration, member, representation, sign, magnitude)
  }
  if tag == 6 { let value = run readBytes(bytes, &mut input.*)
    return StaticValue.text(move value) }
  if tag == 7 { let value = run readBytes(bytes, &mut input.*)
    return Option<StaticData>.some(StaticData.Bytes {bytes: move value}) }
  if tag == 8 {
    let ty = match move run readType(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value} => move value _ => { return reject<StaticData>(&mut input.*) } }
    let target = match move run readStaticData(&mut state.*, bytes, &mut input.*) { Option<Interned<StaticData>>.Some {value} => move value _ => { return reject<StaticData>(&mut input.*) } }
    return Option<StaticData>.some(StaticData.Borrow {ty: move ty, target: move target})
  }
  return reject<StaticData>(&mut input.*)
}

effect fn writeFieldInputs(output: &mut Writer, values: &[CallableFieldInput]) -> () ! OutOfMemoryError ? &mut Allocator {
  run writeCount(&mut output.*, values.length)
  let mut at = usize.ZERO
  while !output.failed && at < values.length {
    match &values[at] {
      CallableFieldInput.Environment => { run BodyWire.word(&mut output.*, 0) }
      CallableFieldInput.Argument {parameter} => { run BodyWire.word(&mut output.*, 1)
        run writeSize(&mut output.*, parameter) }
      CallableFieldInput.Represented {parameter, slot} => { run BodyWire.word(&mut output.*, 2)
        run writeSize(&mut output.*, parameter)
        run writeSize(&mut output.*, slot) }
    }
    at = at + usize.ONE
  }
}
effect fn readFieldInputs(bytes: &[u8], input: &mut Reader) -> Option<List<CallableFieldInput>> ! OutOfMemoryError ? &mut Allocator {
  let count = BodyWire.count(bytes, &mut input.*, BodyWire.ENTRY_LIMIT)
  let mut values = List<CallableFieldInput>.make()
  let mut at = usize.ZERO
  while !input.failed && at < count {
    let tag = BodyWire.readWord(bytes, &mut input.*)
    if tag == 0 { run List<CallableFieldInput>.append(&mut values, CallableFieldInput.Environment) }
    else if tag == 1 { let parameter = readSize(bytes, &mut input.*)
      run List<CallableFieldInput>.append(&mut values, CallableFieldInput.Argument {parameter: parameter}) }
    else if tag == 2 { let parameter = readSize(bytes, &mut input.*)
      let slot = readSize(bytes, &mut input.*)
      run List<CallableFieldInput>.append(&mut values, CallableFieldInput.Represented {parameter: parameter, slot: slot}) }
    else { return reject<List<CallableFieldInput>>(&mut input.*) }
    at = at + usize.ONE
  }
  if input.failed { return Option<List<CallableFieldInput>>.none() }
  return Option<List<CallableFieldInput>>.some(move values)
}
effect fn readCallableValue(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let isPublic = readBool(bytes, &mut input.*)
  let application = match move run readApplication(&mut state.*, bytes, &mut input.*) { Option<Interned<Application>>.Some {value} => move value _ => { return reject<Interned<Type>>(&mut input.*) } }
  let contract = match move run readType(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value} => move value _ => { return reject<Interned<Type>>(&mut input.*) } }
  let captures = match move run readListType(&mut state.*, bytes, &mut input.*) { Option<List<Interned<Type>>>.Some {value} => move value _ => { return reject<Interned<Type>>(&mut input.*) } }
  let fieldInputs = match move run readFieldInputs(bytes, &mut input.*) { Option<List<CallableFieldInput>>.Some {value} => move value _ => { return reject<Interned<Type>>(&mut input.*) } }
  if input.failed { return Option<Interned<Type>>.none() }
  let mut copiedInputs = List<CallableFieldInput>.make()
  let inputs = List<CallableFieldInput>.asSlice(&fieldInputs)
  let mut at = usize.ZERO
  while at < inputs.length { run List<CallableFieldInput>.append(&mut copiedInputs, inputs[at])
    at = at + usize.ONE }
  let made = run Type.callableValue(isPublic, move application, Interned<Type>.clone(&contract), move captures, move copiedInputs)
  // This factory owns a private runtime-key cache and may normalize contracts/field inputs.
  // Accept only identity-preserving reconstruction of already canonical producer evidence.
  let held = Interned<Type>.get(&made)
  if let Type.CallableValue {contract: actual, fieldInputs: actualInputs, ..} = &held.* {
    if !(run Type.equalsShared(&actual, &contract)) || !CallableFieldInput.allEqual(List<CallableFieldInput>.asSlice(&actualInputs), List<CallableFieldInput>.asSlice(&fieldInputs)) {
      return reject<Interned<Type>>(&mut input.*)
    }
    return Option<Interned<Type>>.some(move made)
  }
  return reject<Interned<Type>>(&mut input.*)
}
