  let roleType = match move run readOptionType(&mut state.*, bytes, &mut input.*) { Option<Option<Interned<Type>>>.Some {value} => move value _ => { return reject<Requirement>(&mut input.*) } }
  let access = readAccess(bytes, &mut input.*)
  if input.failed { return Option<Requirement>.none() }
  return Option<Requirement>.some(Requirement {capability: move capability, roleType: move roleType, access: access})
}
