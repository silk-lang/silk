/// Decodes exact ScopeBinding fields, refusing incomplete values.
pub effect fn readScopeBinding(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<ScopeBinding> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let ownerOwned = match move run readDeclaration(&mut state.*, bytes, &mut input.*) { Option<DeclarationId>.Some {value} => move value _ => { return reject<ScopeBinding>(&mut input.*) } }
  let owner = run Types.internDeclaration(move ownerOwned)
  let arguments = match move run readListArgument(&mut state.*, bytes, &mut input.*) { Option<List<Argument>>.Some {value} => move value _ => { return reject<ScopeBinding>(&mut input.*) } }
  let argumentOrdinals = match move run readListSize(&mut state.*, bytes, &mut input.*) { Option<List<usize>>.Some {value} => move value _ => { return reject<ScopeBinding>(&mut input.*) } }
  let statics = match move run readListStaticSlot(&mut state.*, bytes, &mut input.*) { Option<List<StaticSlot>>.Some {value} => move value _ => { return reject<ScopeBinding>(&mut input.*) } }
  if List<Argument>.length(&arguments) != List<usize>.length(&argumentOrdinals) { return reject<ScopeBinding>(&mut input.*) }
  if input.failed { return Option<ScopeBinding>.none() }
  return Option<ScopeBinding>.some(ScopeBinding {owner: move owner, arguments: move arguments, argumentOrdinals: move argumentOrdinals, statics: move statics})
}
effect fn writeOptionType(state: &mut Encoder, output: &mut Writer, given: &Option<Interned<Type>>) -> () ! OutOfMemoryError ? &mut Allocator {
  match &given.* {
    Option<Interned<Type>>.Some {value} => { run BodyWire.word(&mut output.*, 1)
      run writeType(&mut state.*, &mut output.*, &value) }
    _ => { run BodyWire.word(&mut output.*, 0) }
  }
}
effect fn readOptionType(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Option<Interned<Type>>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 && !input.failed { return Option<Option<Interned<Type>>>.some(Option<Interned<Type>>.none()) }
  if tag == 1 { let value = run readType(&mut state.*, bytes, &mut input.*)
    if !input.failed { return Option<Option<Interned<Type>>>.some(move value) } }
  return reject<Option<Interned<Type>>>(&mut input.*)
}
effect fn writeOptionWord(output: &mut Writer, given: &Option<u64>) -> () ! OutOfMemoryError ? &mut Allocator {
  match &given.* { Option<u64>.Some {value} => { run BodyWire.word(&mut output.*, 1)
    run BodyWire.word(&mut output.*, value) } _ => { run BodyWire.word(&mut output.*, 0) } }
}
fn readOptionWord(bytes: &[u8], input: &mut Reader) -> Option<Option<u64>> {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 && !input.failed { return Option<Option<u64>>.some(Option<u64>.none()) }
  if tag == 1 { let value = BodyWire.readWord(bytes, &mut input.*)
    if !input.failed { return Option<Option<u64>>.some(Option<u64>.some(value)) } }
  return reject<Option<u64>>(&mut input.*)
}

/// Writes the exact kind of a declaration argument.
pub effect fn writeArgument(state: &mut Encoder, output: &mut Writer, given: &Argument) -> () ! OutOfMemoryError ? &mut Allocator {
  match &given.* {
    Argument.Type {value} => { run BodyWire.word(&mut output.*, 0)
      run writeType(&mut state.*, &mut output.*, &value) }
    Argument.Lifetime {value} => { run BodyWire.word(&mut output.*, 1)
      run writeLifetime(&mut state.*, &mut output.*, &value) }
    Argument.Row {value} => { run BodyWire.word(&mut output.*, 2)
      run writeRow(&mut state.*, &mut output.*, &value) }
  }
}
/// Reads a kind-preserving generic argument, including complete lifetime/row identity.
pub effect fn readArgument(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Argument>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { if let Option<Interned<Type>>.Some {value} = move run readType(&mut state.*, bytes, &mut input.*) {
    return Option<Argument>.some(Argument.Type {value: move value}) } }
  if tag == 1 { if let Option<Interned<Lifetime>>.Some {value} = move run readLifetime(&mut state.*, bytes, &mut input.*) {
    return Option<Argument>.some(Argument.Lifetime {value: move value}) } }
  if tag == 2 { if let Option<Interned<Row>>.Some {value} = move run readRow(&mut state.*, bytes, &mut input.*) {
    return Option<Argument>.some(Argument.Row {value: move value}) } }
  return reject<Argument>(&mut input.*)
}

effect fn writeIntersection(state: &mut Encoder, output: &mut Writer, value: &Frozen<Intersection>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let count = Frozen<Intersection>.with<usize>(value, fn(found: &Intersection) -> usize { return List<Member>.length(&found.members) })
  run writeCount(&mut output.*, count)
  let mut at = usize.ZERO
  while !output.failed && at < count {
    let region = Frozen<Intersection>.with<Interned<Lifetime>>(value, fn(found: &Intersection) -> Interned<Lifetime> {
      return Interned<Lifetime>.clone(&List<Member>.asSlice(&found.members)[at].region) })
    run writeLifetime(&mut state.*, &mut output.*, &region)
    at = at + usize.ONE
  }
}
effect fn readIntersection(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Frozen<Intersection>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = BodyWire.count(bytes, &mut input.*, BodyWire.ENTRY_LIMIT)
  let mut members = List<Member>.make()
  let mut at = usize.ZERO
  while !input.failed && at < count {
    let region = match move run readLifetime(&mut state.*, bytes, &mut input.*) {
      Option<Interned<Lifetime>>.Some {value} => move value
      _ => { return reject<Frozen<Intersection>>(&mut input.*) }
    }
    let atom = Interned<Lifetime>.with<bool>(&region, fn(value: &Lifetime) -> bool {
      return match &value.* { Lifetime.Static => false Lifetime.Meet {..} => false _ => true } })
    if !atom { return reject<Frozen<Intersection>>(&mut input.*) }
    let mut previous = usize.ZERO
    while previous < List<Member>.length(&members) {
      if input.steps >= BodyWire.STEP_LIMIT { return reject<Frozen<Intersection>>(&mut input.*) }
      input.steps = input.steps + usize.ONE
      if Lifetime.equalsShared(&region, &List<Member>.asSlice(&members)[previous].region) { return reject<Frozen<Intersection>>(&mut input.*) }
      previous = previous + usize.ONE
    }
    run List<Member>.append(&mut members, Member {region: move region})
    at = at + usize.ONE
  }
  if input.failed { return Option<Frozen<Intersection>>.none() }
  return Option<Frozen<Intersection>>.some(run Frozen<Intersection>.make(Intersection {members: move members}))
}
effect fn writeLifetimeNode(state: &mut Encoder, output: &mut Writer, source: &Interned<Lifetime>) -> () ! OutOfMemoryError ? &mut Allocator {
  let node = Interned<Lifetime>.get(source)
  match &node.* {
    Lifetime.Static => { run BodyWire.word(&mut output.*, 0)
    }
    Lifetime.Parameter {declaration, ordinal} => { run BodyWire.word(&mut output.*, 1)
      run writeDeclaration(&mut state.*, &mut output.*, &declaration)
      run writeSize(&mut output.*, ordinal)
    }
    Lifetime.Local {declaration, ordinal, binder} => { run BodyWire.word(&mut output.*, 2)
      run writeDeclaration(&mut state.*, &mut output.*, &declaration)
      run writeSize(&mut output.*, ordinal)
      run writeSize(&mut output.*, binder)
    }
    Lifetime.Invocation {ordinal} => { run BodyWire.word(&mut output.*, 3)
      run writeSize(&mut output.*, ordinal)
    }
    Lifetime.Supplied {ordinal} => { run BodyWire.word(&mut output.*, 4)
      run writeSize(&mut output.*, ordinal)
    }
    Lifetime.Meet {..} => { run BodyWire.word(&mut output.*, 5)
      let count = Lifetime.atomCount(source)
      run writeCount(&mut output.*, count)
      let mut at = usize.ZERO
      while !output.failed && at < count {
        let atom = Lifetime.atomAt(source, at)
        run writeLifetime(&mut state.*, &mut output.*, &atom)
        at = at + usize.ONE
      }
    }
  }
}
effect fn readLifetimeNode(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Interned<Lifetime>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 {
    if input.failed { return Option<Interned<Lifetime>>.none() }
    return Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Static))
  }
  if tag == 1 {
    let declaration = match move run readDeclaration(&mut state.*, bytes, &mut input.*) { Option<DeclarationId>.Some {value} => move value _ => { return reject<Interned<Lifetime>>(&mut input.*) } }
    let ordinal = readSize(bytes, &mut input.*)
    if input.failed { return Option<Interned<Lifetime>>.none() }
    return Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Parameter {declaration: move declaration, ordinal: ordinal}))
  }
  if tag == 2 {
    let declaration = match move run readDeclaration(&mut state.*, bytes, &mut input.*) { Option<DeclarationId>.Some {value} => move value _ => { return reject<Interned<Lifetime>>(&mut input.*) } }
    let ordinal = readSize(bytes, &mut input.*)
    let binder = readSize(bytes, &mut input.*)
    if input.failed { return Option<Interned<Lifetime>>.none() }
    return Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Local {declaration: move declaration, ordinal: ordinal, binder: binder}))
  }
  if tag == 3 {
    let ordinal = readSize(bytes, &mut input.*)
    if input.failed { return Option<Interned<Lifetime>>.none() }
    return Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Invocation {ordinal: ordinal}))
  }
  if tag == 4 {
    let ordinal = readSize(bytes, &mut input.*)
    if input.failed { return Option<Interned<Lifetime>>.none() }
    return Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Supplied {ordinal: ordinal}))
  }
  if tag == 5 {
    let members = match move run readIntersection(&mut state.*, bytes, &mut input.*) { Option<Frozen<Intersection>>.Some {value} => move value _ => { return reject<Interned<Lifetime>>(&mut input.*) } }
    if Frozen<Intersection>.with<usize>(&members, fn(value: &Intersection) -> usize { return List<Member>.length(&value.members) }) < 2 { return reject<Interned<Lifetime>>(&mut input.*) }
    if input.failed { return Option<Interned<Lifetime>>.none() }
    let listed = List<Member>.asSlice(&Frozen<Intersection>.get(&members).members)
    let mut regions = List<Interned<Lifetime>>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      run List<Interned<Lifetime>>.append(&mut regions, Interned<Lifetime>.clone(&listed[at].region))
      at = at + usize.ONE
    }
    return Option<Interned<Lifetime>>.some(run Lifetime.meet(List<Interned<Lifetime>>.asSlice(&regions)))
  }
  return reject<Interned<Lifetime>>(&mut input.*)
}
effect fn writeRowNode(state: &mut Encoder, output: &mut Writer, source: &Interned<Row>) -> () ! OutOfMemoryError ? &mut Allocator {
  let entriesCount = Interned<Row>.with<usize>(source, fn(value: &Row) -> usize { return List<Requirement>.length(&value.entries) })
  run writeCount(&mut output.*, entriesCount)
  let mut entriesAt = usize.ZERO
  while !output.failed && entriesAt < entriesCount {
    let value = Interned<Row>.with<Requirement>(source, fn(value: &Row) -> Requirement {
      let entry = &List<Requirement>.asSlice(&value.entries)[entriesAt]
      return Requirement.copy(entry)
    })
    run writeRequirement(&mut state.*, &mut output.*, &value)
    entriesAt = entriesAt + usize.ONE
  }
  let parametersCount = Interned<Row>.with<usize>(source, fn(value: &Row) -> usize { return List<RowParameter>.length(&value.parameters) })
  run writeCount(&mut output.*, parametersCount)
  let mut parametersAt = usize.ZERO
  while !output.failed && parametersAt < parametersCount {
    let value = Interned<Row>.with<RowParameter>(source, fn(value: &Row) -> RowParameter {
      let entry = &List<RowParameter>.asSlice(&value.parameters)[parametersAt]
      return RowParameter {declaration: Interned<DeclarationId>.clone(&entry.declaration), ordinal: entry.ordinal}
    })
    run writeRowParameter(&mut state.*, &mut output.*, &value)
    parametersAt = parametersAt + usize.ONE
  }
  let subtractionsCount = Interned<Row>.with<usize>(source, fn(value: &Row) -> usize { return List<RowSubtraction>.length(&value.subtractions) })
  run writeCount(&mut output.*, subtractionsCount)
  let mut subtractionsAt = usize.ZERO
  while !output.failed && subtractionsAt < subtractionsCount {
    let value = Interned<Row>.with<RowSubtraction>(source, fn(value: &Row) -> RowSubtraction {
      let entry = &List<RowSubtraction>.asSlice(&value.subtractions)[subtractionsAt]
      return RowSubtraction {source: Interned<Row>.clone(&entry.source), removed: Interned<Row>.clone(&entry.removed)}
    })
    run writeRowSubtraction(&mut state.*, &mut output.*, &value)
    subtractionsAt = subtractionsAt + usize.ONE
  }
}
effect fn readRowNode(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Interned<Row>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let entries = match move run readListRequirement(&mut state.*, bytes, &mut input.*) { Option<List<Requirement>>.Some {value} => move value _ => { return reject<Interned<Row>>(&mut input.*) } }
  let parameters = match move run readListRowParameter(&mut state.*, bytes, &mut input.*) { Option<List<RowParameter>>.Some {value} => move value _ => { return reject<Interned<Row>>(&mut input.*) } }
  let subtractions = match move run readListRowSubtraction(&mut state.*, bytes, &mut input.*) { Option<List<RowSubtraction>>.Some {value} => move value _ => { return reject<Interned<Row>>(&mut input.*) } }
  if input.failed { return Option<Interned<Row>>.none() }
  return Option<Interned<Row>>.some(run Types.internRow(Row {entries: move entries, parameters: move parameters, subtractions: move subtractions}))
}
effect fn writeApplicationNode(state: &mut Encoder, output: &mut Writer, source: &Interned<Application>) -> () ! OutOfMemoryError ? &mut Allocator {
  let counts = Interned<Application>.with<bool>(source, fn(value: &Application) -> bool {
    return List<Argument>.length(&value.arguments) <= BodyWire.ENTRY_LIMIT && List<ScopeBinding>.length(&value.scopes) <= BodyWire.ENTRY_LIMIT
      && List<StaticSlot>.length(&value.statics) <= BodyWire.ENTRY_LIMIT && List<usize>.length(&value.argumentOrdinals) <= BodyWire.ENTRY_LIMIT })
  if !counts { BodyWire.refuse(&mut output.*, BodyWire.RESOURCE)
    return () }
  let value = Interned<Application>.get(source)
  match &value.target {
    Target.Named {declaration} => { run BodyWire.word(&mut output.*, 0)
      run writeDeclaration(&mut state.*, &mut output.*, &declaration) }
    Target.Operation {contract, provider, operation, implementation} => { run BodyWire.word(&mut output.*, 1)
      run writeType(&mut state.*, &mut output.*, &contract)
      run writeType(&mut state.*, &mut output.*, &provider)
      run writeDeclaration(&mut state.*, &mut output.*, &operation)
      run writeDeclaration(&mut state.*, &mut output.*, &implementation) }
  }
  run writeListArgument(&mut state.*, &mut output.*, List<Argument>.asSlice(&value.arguments))
  run writeListSize(&mut state.*, &mut output.*, List<usize>.asSlice(&value.argumentOrdinals))
  run writeListScopeBinding(&mut state.*, &mut output.*, List<ScopeBinding>.asSlice(&value.scopes))
  run writeListStaticSlot(&mut state.*, &mut output.*, List<StaticSlot>.asSlice(&value.statics))
}
effect fn readTarget(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Target> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 {
    let declaration = match move run readDeclaration(&mut state.*, bytes, &mut input.*) { Option<DeclarationId>.Some {value} => move value _ => { return reject<Target>(&mut input.*) } }
    return Option<Target>.some(Target.Named {declaration: move declaration})
  }
  if tag == 1 {
    let contract = match move run readType(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value} => move value _ => { return reject<Target>(&mut input.*) } }
    let provider = match move run readType(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value} => move value _ => { return reject<Target>(&mut input.*) } }
    let operation = match move run readDeclaration(&mut state.*, bytes, &mut input.*) { Option<DeclarationId>.Some {value} => move value _ => { return reject<Target>(&mut input.*) } }
    let implementation = match move run readDeclaration(&mut state.*, bytes, &mut input.*) { Option<DeclarationId>.Some {value} => move value _ => { return reject<Target>(&mut input.*) } }
    return Option<Target>.some(Target.Operation {contract: move contract, provider: move provider, operation: move operation, implementation: move implementation})
  }
  return reject<Target>(&mut input.*)
}
effect fn readApplicationNode(state: &mut Decoder, bytes: &[u8], input: &mut Reader) -> Option<Interned<Application>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let target = match move run readTarget(&mut state.*, bytes, &mut input.*) { Option<Target>.Some {value} => move value _ => { return reject<Interned<Application>>(&mut input.*) } }
  let arguments = match move run readListArgument(&mut state.*, bytes, &mut input.*) { Option<List<Argument>>.Some {value} => move value _ => { return reject<Interned<Application>>(&mut input.*) } }
  let argumentOrdinals = match move run readListSize(&mut state.*, bytes, &mut input.*) { Option<List<usize>>.Some {value} => move value _ => { return reject<Interned<Application>>(&mut input.*) } }
  let scopes = match move run readListScopeBinding(&mut state.*, bytes, &mut input.*) { Option<List<ScopeBinding>>.Some {value} => move value _ => { return reject<Interned<Application>>(&mut input.*) } }
  let statics = match move run readListStaticSlot(&mut state.*, bytes, &mut input.*) { Option<List<StaticSlot>>.Some {value} => move value _ => { return reject<Interned<Application>>(&mut input.*) } }
  if input.failed || List<Argument>.length(&arguments) != List<usize>.length(&argumentOrdinals) { return reject<Interned<Application>>(&mut input.*) }
  return Option<Interned<Application>>.some(run Types.internApplication(Application {target: move target, arguments: move arguments, argumentOrdinals: move argumentOrdinals, scopes: move scopes, statics: move statics}))
}
effect fn writeForeignContract(output: &mut Writer, value: ForeignContract) -> () ! OutOfMemoryError ? &mut Allocator {
  run writeMemory(&mut output.*, value.memory)
  run writeLocality(&mut output.*, value.locality)
  run writeBool(&mut output.*, value.synchronousCallbacks)
  run writeBool(&mut output.*, value.threadCallbacks)
  run writeBool(&mut output.*, value.deferredCallbacks)
  run writeBool(&mut output.*, value.invokesDeferredCallbacks)
}
fn readForeignContract(bytes: &[u8], input: &mut Reader) -> ForeignContract {
  let memory = readMemory(bytes, &mut input.*)
  let locality = readLocality(bytes, &mut input.*)
  let synchronousCallbacks = readBool(bytes, &mut input.*)
  let threadCallbacks = readBool(bytes, &mut input.*)
  let deferredCallbacks = readBool(bytes, &mut input.*)
  let invokesDeferredCallbacks = readBool(bytes, &mut input.*)
  return ForeignContract {memory: memory, locality: locality, synchronousCallbacks: synchronousCallbacks, threadCallbacks: threadCallbacks, deferredCallbacks: deferredCallbacks, invokesDeferredCallbacks: invokesDeferredCallbacks}
}
fn boundedType(value: &Type) -> bool {
  return match &value.* {
    Type.Primitive {name, ..} => Bytes.length(&name) <= BodyWire.BYTE_LIMIT
    Type.Nominal {arguments, ..} => List<Argument>.length(&arguments) <= BodyWire.ENTRY_LIMIT
    Type.Array {extent, ..} => Bytes.length(&extent) <= BodyWire.BYTE_LIMIT
    Type.Vector {lanes, ..} => Bytes.length(&lanes) <= BodyWire.BYTE_LIMIT
    Type.Union {members, ..} => List<Interned<Type>>.length(&members) <= BodyWire.ENTRY_LIMIT
    Type.CallableStage {captures, ..} => List<Interned<Type>>.length(&captures) <= BodyWire.ENTRY_LIMIT
    Type.CallableResult {arguments, selected, selectedOrdinals, ..} => List<Interned<Type>>.length(&arguments) <= BodyWire.ENTRY_LIMIT && List<Argument>.length(&selected) <= BodyWire.ENTRY_LIMIT && List<usize>.length(&selectedOrdinals) <= BodyWire.ENTRY_LIMIT
    Type.Callable {invocationBounds, parameters, ..} => List<Outlives>.length(&invocationBounds) <= BodyWire.ENTRY_LIMIT && List<Interned<Type>>.length(&parameters) <= BodyWire.ENTRY_LIMIT
    Type.EffectComposite {parts, ..} => List<Interned<Type>>.length(&parts) <= BodyWire.ENTRY_LIMIT
    Type.EffectJoin {alternatives, ..} => List<Interned<Type>>.length(&alternatives) <= BodyWire.ENTRY_LIMIT
    Type.Anonymous {members, ..} => List<Interned<Type>>.length(&members) <= BodyWire.ENTRY_LIMIT
    Type.CallableValue {captures, fieldInputs, ..} => List<Interned<Type>>.length(&captures) <= BodyWire.ENTRY_LIMIT && List<CallableFieldInput>.length(&fieldInputs) <= BodyWire.ENTRY_LIMIT
    Type.CallableSchema {..} => false
    Type.CallableWitnessResult {..} => false
    _ => true
  }
}
effect fn writeTypeNode(state: &mut Encoder, output: &mut Writer, subject: &Interned<Type>) -> () ! OutOfMemoryError ? &mut Allocator {
  let bounded = Interned<Type>.with<bool>(subject, boundedType)
  let node = Interned<Type>.get(subject)
  if !bounded {
    let reason = match &node.* {
      Type.CallableSchema {..} => BodyWire.TYPE_SCHEMA
      Type.CallableWitnessResult {..} => BodyWire.TYPE_WITNESS
      _ => BodyWire.RESOURCE
    }
    BodyWire.refuse(&mut output.*, reason)
    return () }
  match &node.* {
    Type.Primitive {name} => { run BodyWire.word(&mut output.*, 0)
      run BodyWire.field(&mut output.*, Bytes.asSlice(&name))
    }
    Type.Unit => { run BodyWire.word(&mut output.*, 1)
    }
    Type.Nominal {declaration, isPublic, arguments} => { run BodyWire.word(&mut output.*, 2)
      run writeDeclaration(&mut state.*, &mut output.*, &declaration)
      run writeBool(&mut output.*, isPublic)
      run writeListArgument(&mut state.*, &mut output.*, List<Argument>.asSlice(&arguments))
    }
    Type.OpaqueRepresentation {application, contract, detached, nonParking} => { run BodyWire.word(&mut output.*, 3)
      run writeApplication(&mut state.*, &mut output.*, &application)
      run writeType(&mut state.*, &mut output.*, &contract)
      run writeBool(&mut output.*, detached)
      run writeBool(&mut output.*, nonParking)
    }
    Type.Parameter {declaration, ordinal} => { run BodyWire.word(&mut output.*, 4)
      run writeDeclaration(&mut state.*, &mut output.*, &declaration)
      run writeSize(&mut output.*, ordinal)
    }
    Type.String {lifetime} => { run BodyWire.word(&mut output.*, 5)
      run writeLifetime(&mut state.*, &mut output.*, &lifetime)
    }
    Type.Reference {referent, access, lifetime} => { run BodyWire.word(&mut output.*, 6)
      run writeType(&mut state.*, &mut output.*, &referent)
      run writeAccess(&mut output.*, access)
      run writeLifetime(&mut state.*, &mut output.*, &lifetime)
    }
    Type.Slice {element, access, lifetime} => { run BodyWire.word(&mut output.*, 7)
      run writeType(&mut state.*, &mut output.*, &element)
      run writeAccess(&mut output.*, access)
      run writeLifetime(&mut state.*, &mut output.*, &lifetime)
    }
    Type.Pointer {pointee, access, nullable, multiplicity, alignment} => { run BodyWire.word(&mut output.*, 8)
      run writeType(&mut state.*, &mut output.*, &pointee)
      run writeAccess(&mut output.*, access)
      run writeBool(&mut output.*, nullable)
      run writeMultiplicity(&mut output.*, multiplicity)
      run writeOptionWord(&mut output.*, &alignment)
    }
    Type.ForeignFunction {signature, behavior, nullable} => { run BodyWire.word(&mut output.*, 9)
      run writeType(&mut state.*, &mut output.*, &signature)
      run writeForeignContract(&mut output.*, behavior)
      run writeBool(&mut output.*, nullable)
    }
    Type.Array {element, extent} => { run BodyWire.word(&mut output.*, 10)
      run writeType(&mut state.*, &mut output.*, &element)
      run BodyWire.field(&mut output.*, Bytes.asSlice(&extent))
    }
    Type.Vector {element, lanes} => { run BodyWire.word(&mut output.*, 11)
      run writeType(&mut state.*, &mut output.*, &element)
      run BodyWire.field(&mut output.*, Bytes.asSlice(&lanes))
    }
    Type.TypeDescriptor {owner} => { run BodyWire.word(&mut output.*, 12)
      run writeType(&mut state.*, &mut output.*, &owner)
    }
    Type.Union {members} => { run BodyWire.word(&mut output.*, 13)
      run writeListType(&mut state.*, &mut output.*, List<Interned<Type>>.asSlice(&members))
    }
    Type.Without {source, removed} => { run BodyWire.word(&mut output.*, 14)
      run writeType(&mut state.*, &mut output.*, &source)
      run writeType(&mut state.*, &mut output.*, &removed)
    }
    Type.CallableStage {base, contract, captures, remaining, suffixMode} => { run BodyWire.word(&mut output.*, 15)
      run writeType(&mut state.*, &mut output.*, &base)
      run writeType(&mut state.*, &mut output.*, &contract)
      run writeListType(&mut state.*, &mut output.*, List<Interned<Type>>.asSlice(&captures))
      run writeSize(&mut output.*, remaining)
      run writeCallableMode(&mut output.*, suffixMode)
    }
    Type.CallableResult {producer, contract, arguments, selected, selectedOrdinals} => { run BodyWire.word(&mut output.*, 16)
      run writeType(&mut state.*, &mut output.*, &producer)
      run writeType(&mut state.*, &mut output.*, &contract)
      run writeListType(&mut state.*, &mut output.*, List<Interned<Type>>.asSlice(&arguments))
      run writeListArgument(&mut state.*, &mut output.*, List<Argument>.asSlice(&selected))
      run writeListSize(&mut state.*, &mut output.*, List<usize>.asSlice(&selectedOrdinals))
    }
    Type.CallableOrigin {application, contract} => { run BodyWire.word(&mut output.*, 17)
      run writeApplication(&mut state.*, &mut output.*, &application)
      run writeType(&mut state.*, &mut output.*, &contract)
    }
    Type.CallableView {representation, contract} => { run BodyWire.word(&mut output.*, 18)
      run writeType(&mut state.*, &mut output.*, &representation)
      run writeType(&mut state.*, &mut output.*, &contract)
    }
    Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} => { run BodyWire.word(&mut output.*, 19)
      run writeCallableMode(&mut output.*, mode)
      run writeBool(&mut output.*, isUnsafe)
      run writeIntersection(&mut state.*, &mut output.*, &environment)
      run writeSize(&mut output.*, invocationBinders)
      run writeSize(&mut output.*, invocationUse)
      run writeListOutlives(&mut state.*, &mut output.*, List<Outlives>.asSlice(&invocationBounds))
      run writeListType(&mut state.*, &mut output.*, List<Interned<Type>>.asSlice(&parameters))
      run writeType(&mut state.*, &mut output.*, &result)
    }
    Type.EffectComposite {operation, selector, parts, contract} => { run BodyWire.word(&mut output.*, 20)
      run writeComposition(&mut output.*, operation)
      run writeType(&mut state.*, &mut output.*, &selector)
      run writeListType(&mut state.*, &mut output.*, List<Interned<Type>>.asSlice(&parts))
      run writeType(&mut state.*, &mut output.*, &contract)
    }
    Type.EffectJoin {contract, alternatives} => { run BodyWire.word(&mut output.*, 21)
      run writeType(&mut state.*, &mut output.*, &contract)
      run writeListType(&mut state.*, &mut output.*, List<Interned<Type>>.asSlice(&alternatives))
    }
    Type.Effect {mode, environment, success, failure, requirements} => { run BodyWire.word(&mut output.*, 22)
      run writeCallableMode(&mut output.*, mode)
      run writeIntersection(&mut state.*, &mut output.*, &environment)
      run writeType(&mut state.*, &mut output.*, &success)
      run writeType(&mut state.*, &mut output.*, &failure)
      run writeRow(&mut state.*, &mut output.*, &requirements)
    }
    Type.CallableValue {isPublic, application, contract, captures, fieldInputs, ..} => {
      run BodyWire.word(&mut output.*, 23)
      run writeBool(&mut output.*, isPublic)
      run writeApplication(&mut state.*, &mut output.*, &application)
      run writeType(&mut state.*, &mut output.*, &contract)
      run writeListType(&mut state.*, &mut output.*, List<Interned<Type>>.asSlice(&captures))
