/// Encodes exact ScopeBinding fields in declaration order.
pub effect fn writeScopeBinding(state: &mut Encoder, output: &mut Writer, value: &ScopeBinding) -> () ! OutOfMemoryError ? &mut Allocator {
  let owner = DeclarationId.copyShared(&value.owner)
  run writeDeclaration(&mut state.*, &mut output.*, &owner)
  run writeListArgument(&mut state.*, &mut output.*, List<Argument>.asSlice(&value.arguments))
  run writeListSize(&mut state.*, &mut output.*, List<usize>.asSlice(&value.argumentOrdinals))
  run writeListStaticSlot(&mut state.*, &mut output.*, List<StaticSlot>.asSlice(&value.statics))
