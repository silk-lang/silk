//! Context-local sparse guard validation, imported sharing and fail-closed lazy topology.
import CompilerBug
import semantic.CacheGuard as Guard {Disposition, Step, Walker}
import semantic.CacheView as CacheView {Handle, View}
import semantic.CacheGeneration {Generation as GenerationData, Selection, Placement, Certificate}
import semantic.CacheSegments as Segments {Descriptor, Edge, Node, Observation, Reference, Root, Segment, SealedSegment}
import semantic.ContentHash {ContentHash}
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.core.effect {Effect}
import silk.mem.frozen {Frozen}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize
import silk.num.u32
import silk.num.u64

fn handle(segment: usize, index: usize) -> Handle { return Handle {segment: segment, index: index} }
fn edge(node: bool, segment: usize, index: usize) -> Edge { return Edge {node: node, target: Reference {segment: segment, index: index}} }
effect fn leaf(builder: &mut Segment, key: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Observation>.append(&mut builder.leaves, Observation {key: run Bytes.copy(key), digest: ContentHash.of(key),
    text: ContentHash.of(b""), position: usize.MAX, file: Option<Reference>.none(), selector: u32.MAX, input: false})
}
effect fn node(builder: &mut Segment, edges: &[Edge]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<Edge>.make()
  let mut at = usize.ZERO
  while at < edges.length { run List<Edge>.append(&mut values, edges[at]) at = at + usize.ONE }
  run List<Node>.append(&mut builder.nodes, Node {edges: move values})
}
effect fn root(builder: &mut Segment, key: &[u8], index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Root>.append(&mut builder.roots, Root {key: run Bytes.copy(key), node: Reference {segment: 0, index: index},
    answer: run Bytes.copy(b"answer"), packs: List<ContentHash>.make()})
}
effect fn seal(builder: Segment, owners: &[Frozen<SealedSegment>]) -> Frozen<SealedSegment>
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let held = match move run Segments.seal(move builder, owners) {
    Option<SealedSegment>.Some {value} => move value
    Option<SealedSegment>.None => { run Testing.expect(false, "valid DAG fixture seals") return CompilerBug.panic(b"invalid guard fixture") }
  }
  return run Frozen<SealedSegment>.make(move held)
}
effect fn first() -> Frozen<SealedSegment> ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut builder = run Segments.make(1, b"guard-test")
  run leaf(&mut builder, b"a")
  run leaf(&mut builder, b"b")
  run node(&mut builder, &[edge(false, 0, 0)])
  run node(&mut builder, &[edge(false, 0, 1)])
  run node(&mut builder, &[edge(true, 0, 0), edge(true, 0, 1), edge(true, 0, 0)])
  run root(&mut builder, b"combined", 2)
  return run seal(move builder, &[])
}
effect fn view(owners: List<Frozen<SealedSegment>>) -> View ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut catalog = List<Descriptor>.make()
  let mut selections = List<Selection>.make()
  let held = List<Frozen<SealedSegment>>.asSlice(&owners)
  let mut at = usize.ZERO
  while at < held.length {
    let descriptor = Segments.descriptor(Frozen<SealedSegment>.get(&held[at]))
    run List<Descriptor>.append(&mut catalog, descriptor)
    run List<Selection>.append(&mut selections, Selection {segment: descriptor.digest, roots: run Bytes.copy(&[1])})
    at = at + usize.ONE
  }
  let generation = GenerationData {stamp: run Bytes.copy(b"guard-test"), catalog: move catalog, selections: move selections,
    placements: List<Placement>.make(), certificate: Option<Certificate>.none()}
  return match move run CacheView.make(move generation, move owners) {
    Option<View>.Some {value} => move value
    Option<View>.None => { run Testing.expect(false, "guard fixture generation admits") return CompilerBug.panic(b"invalid guard view") }
  }
}
effect fn need(walker: &mut Walker, expected: Handle, result: Disposition) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  match move run Guard.step(&mut walker.*) {
    Step.NeedLeaf {handle: found} => {
      run Testing.expect(found.segment == expected.segment && found.index == expected.index, "leaf request preserves full imported identity")
      run Testing.expect(run Guard.supplyLeaf(&mut walker.*, found, result), "matching result is accepted once")
    }
    _ => { run Testing.expect(false, "exactly the expected leaf needs validation") }
  }
}
effect fn done(walker: &mut Walker, expected: Disposition) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  match move run Guard.step(&mut walker.*) {
    Step.Done {disposition} => {
      let equal = match expected {
        Disposition.Exact => match disposition { Disposition.Exact => true _ => false }
        Disposition.PositionOnly => match disposition { Disposition.PositionOnly => true _ => false }
        Disposition.Stale => match disposition { Disposition.Stale => true _ => false }
      }
      run Testing.expect(equal, "all dependency dispositions join without upgrading positional evidence")
    }
    _ => { run Testing.expect(false, "completed shared dependencies require no repeated leaf work") }
  }
}
effect fn sharingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut owners = List<Frozen<SealedSegment>>.make()
  run List<Frozen<SealedSegment>>.append(&mut owners, run first())
  let mut builder = run Segments.make(2, b"guard-test")
  run List<Descriptor>.append(&mut builder.imports, Segments.descriptor(Frozen<SealedSegment>.get(&List<Frozen<SealedSegment>>.asSlice(&owners)[0])))
  run leaf(&mut builder, b"distinct-local-zero")
  run node(&mut builder, &[edge(true, 1, 0), edge(true, 1, 1)])
  run node(&mut builder, &[edge(true, 1, 0), edge(false, 0, 0)])
  run root(&mut builder, b"imported", 0)
  let second = run seal(move builder, List<Frozen<SealedSegment>>.asSlice(&owners))
  run List<Frozen<SealedSegment>>.append(&mut owners, move second)
  let held = run view(move owners)
  let mut walker = Guard.make(&held)
  run Testing.expect(run Guard.begin(&mut walker, handle(0, 2)), "first root begins")
  run need(&mut walker, handle(0, 0), Disposition.Exact)
  run need(&mut walker, handle(0, 1), Disposition.PositionOnly)
  run done(&mut walker, Disposition.PositionOnly)
  run Testing.expect(run Guard.begin(&mut walker, handle(1, 0)), "imported DAG reuses completed nodes")
  run done(&mut walker, Disposition.PositionOnly)
  run Testing.expect(run Guard.begin(&mut walker, handle(0, 0)), "shared exact child retains its own exact disposition")
  run done(&mut walker, Disposition.Exact)
  run Testing.expect(run Guard.begin(&mut walker, handle(1, 1)), "equal local index in another segment stays distinct")
  run need(&mut walker, handle(1, 0), Disposition.Stale)
  run done(&mut walker, Disposition.Stale)
  let mut positional = Guard.make(&held)
  run Testing.expect(run Guard.begin(&mut positional, handle(0, 2)), "positional context begins")
  run need(&mut positional, handle(0, 0), Disposition.PositionOnly)
  run need(&mut positional, handle(0, 1), Disposition.Stale)
  run done(&mut positional, Disposition.Stale)
  let mut fresh = Guard.make(&held)
  run Testing.expect(run Guard.begin(&mut fresh, handle(0, 2)), "a new validation context has no inherited answers")
  run need(&mut fresh, handle(0, 0), Disposition.Stale)
  run done(&mut fresh, Disposition.Stale)
  run Testing.expect(run Guard.begin(&mut fresh, handle(0, 1)), "short-circuited children remain unexamined")
  run need(&mut fresh, handle(0, 1), Disposition.Exact)
  run done(&mut fresh, Disposition.Exact)
}

effect fn protocolClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut owners = List<Frozen<SealedSegment>>.make()
  run List<Frozen<SealedSegment>>.append(&mut owners, run first())
  let held = run view(move owners)
  let mut walker = Guard.make(&held)
  run Testing.expect(run Guard.begin(&mut walker, handle(0, 0)), "protocol fixture begins")
  match move run Guard.step(&mut walker) {
    Step.NeedLeaf {..} => {}
    _ => { run Testing.expect(false, "leaf requested before response") }
  }
  run Testing.expect(!run Guard.supplyLeaf(&mut walker, handle(0, 1), Disposition.Exact), "wrong response cannot validate another leaf")
  match move run Guard.step(&mut walker) { Step.Refused => {} _ => { run Testing.expect(false, "wrong response is sticky refusal") } }
  run Testing.expect(!run Guard.begin(&mut walker, handle(0, 1)), "refused context cannot resume")
  let mut overlap = Guard.make(&held)
  run Testing.expect(run Guard.begin(&mut overlap, handle(0, 0)), "overlap fixture begins")
  run Testing.expect(!run Guard.begin(&mut overlap, handle(0, 1)), "overlapping root cannot replace active DFS")
  let mut noResponse = Guard.make(&held)
  run Testing.expect(run Guard.begin(&mut noResponse, handle(0, 0)), "missing-response fixture begins")
  drop run Guard.step(&mut noResponse)
  match move run Guard.step(&mut noResponse) { Step.Refused => {} _ => { run Testing.expect(false, "a requested leaf must be supplied before advancing") } }
  let mut duplicate = Guard.make(&held)
  run Testing.expect(run Guard.begin(&mut duplicate, handle(0, 0)), "duplicate-response fixture begins")
  run need(&mut duplicate, handle(0, 0), Disposition.Exact)
  run Testing.expect(!run Guard.supplyLeaf(&mut duplicate, handle(0, 0), Disposition.Exact), "one request cannot accept two responses")
  let mut idle = Guard.make(&held)
  match move run Guard.step(&mut idle) { Step.Refused => {} _ => { run Testing.expect(false, "step before begin refuses") } }
  let mut badRoot = Guard.make(&held)
  run Testing.expect(!run Guard.begin(&mut badRoot, handle(99, 0)), "out-of-catalog root refuses")
}

fn overwrite(bytes: &mut [u8], at: usize, value: u64) -> () {
  let mut offset = usize.ZERO
  while offset < 8 {
    bytes[at + offset] = u64.toU8(u64.bitAnd(u64.shiftRight(value, usize.toU64((7 - offset) * 8)), 255))
    offset = offset + usize.ONE
  }
}
effect fn malformedClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let original = run first()
  let raw = Segments.encoded(Frozen<SealedSegment>.get(&original))
  let mut footer = StableKey.reader()
  let index = u64.toUsize(StableKey.readWord(Slice.view<u8>(raw, raw.length - 24, 8), &mut footer))
  let directory = Slice.view<u8>(raw, index, raw.length - 24 - index)
  let mut reader = StableKey.reader()
  drop StableKey.readWord(directory, &mut reader)
  let leaves = StableKey.readWord(directory, &mut reader)
  let mut at: u64 = 0
  while at < leaves { drop StableKey.readWord(directory, &mut reader) at = at + 1 }
  drop StableKey.readWord(directory, &mut reader)
  let firstNode = u64.toUsize(StableKey.readWord(directory, &mut reader))
  let mut variant = usize.ZERO
  while variant < 2 {
    let mut bytes = run Bytes.copy(raw)
    if variant == 0 { overwrite(Bytes.asMutSlice(&mut bytes), firstNode + 24, 131072) }
    else {
      overwrite(Bytes.asMutSlice(&mut bytes), firstNode + 8, 1)
      overwrite(Bytes.asMutSlice(&mut bytes), firstNode + 24, 0)
    }
    let length = Bytes.length(&bytes)
    let digest = ContentHash.of(Slice.view<u8>(Bytes.asSlice(&bytes), 0, length - 16))
    overwrite(Bytes.asMutSlice(&mut bytes), length - 16, digest.high)
    overwrite(Bytes.asMutSlice(&mut bytes), length - 8, digest.low)
    let broken = match move run Segments.open(move bytes, b"guard-test") {
      Option<SealedSegment>.Some {value} => move value
      Option<SealedSegment>.None => { run Testing.expect(false, "checksum-correct malformed edges remain lazily indexed") return () }
    }
    let mut owners = List<Frozen<SealedSegment>>.make()
    run List<Frozen<SealedSegment>>.append(&mut owners, run Frozen<SealedSegment>.make(move broken))
    let held = run view(move owners)
    let mut walker = Guard.make(&held)
    run Testing.expect(run Guard.begin(&mut walker, handle(0, 2)), "lazy root can begin before its edges are examined")
    match move run Guard.step(&mut walker) {
      Step.Refused => {}
      _ => { run Testing.expect(false, "malformed leaf edge or self-cycle cannot become valid evidence") }
    }
    variant = variant + usize.ONE
  }
}

test effect fn cacheGuardReusesImportedDagAndPreservesPositionalEvidence() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sharingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheGuardRefusesWrongResponsesAndProtocolReuse() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run protocolClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
test effect fn cacheGuardRefusesLazyMalformedEdgesAndCycles() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run malformedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
