//! Native ownership, source-epoch, guarded body reuse and worker lifecycle proofs.
import semantic.ThreadFrontierCases
import semantic.SourceEpochCases
import semantic.Semantic {Semantic, Request, Answer, Outcome, Value}
import semantic.Query {Cycle}
import semantic.SourceIndex {NoRejection, RevisionMismatch}
import semantic.FinalProfile {FinalProfile}
import semantic.SourceRevision {Revision}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Type {Type}
import semantic.Types {Types, SharedTypePool}
import semantic.TypedBody {TypedBody, NodeKind, Stage}
import semantic.Published {Published}
import semantic.RuntimeBytes {RuntimeBytes}
import semantic.Target {Target as MachineTarget, Id as TargetId}
import silk.concurrency.thread_native {NativeThread, SpawnError}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.shared {Shared}
import silk.mem.interned {Interned}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.core.effect {Effect}
import silk.num.usize
import silk.testing.testing {Testing, AssertionError}

// Source bytes are fixed by the retained immutable epoch. Each query store is constructed on
// the thread that uses it; only the completed immutable body crosses the thread boundary.
effect fn produce(epoch: &Revision, module: &ModuleId) -> Option<Published<TypedBody>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut store = Semantic.cached(run Revision.copy(epoch), MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option<FinalProfile>.none())
  let mut request = Request.make()
  let answer = run Semantic.demandBody(&mut store, &mut request, module, b"value")
  return Shared<Result<Answer, NoRejection>>.with<Option<Published<TypedBody>>>(&answer,
    fn(held: &Result<Answer, NoRejection>) -> Option<Published<TypedBody>> {
      if let Result<Answer, NoRejection>.Success {value} = &held.* {
        if let Outcome.Success {value: Value.Body {body}} = &value.outcome {
          return Option<Published<TypedBody>>.some(Published<TypedBody>.clone(&body))
        }
      }
      return Option<Published<TypedBody>>.none()
    })
}

fn threadBody(pool: SharedTypePool, epoch: Published<Revision>, module: ModuleId) -> Option<Published<TypedBody>> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = SharedTypePool.provider(&pool)
  let attempted = run Effect.result(produce(Published<Revision>.get(&epoch), &module))
    |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move attempted {
    Result<Option<Published<TypedBody>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    _ => Option<Published<TypedBody>>.none()
  }
}

fn firstBoolean(body: &TypedBody) -> Option<Interned<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {ty, ..} = &nodes[at].kind {
      let boolean = Interned<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        if let Type.Primitive {name} = &value.* {
          return Bytes.length(&name) == 4 && Bytes.asSlice(&name)[0] == 98 && Bytes.asSlice(&name)[1] == 111
            && Bytes.asSlice(&name)[2] == 111 && Bytes.asSlice(&name)[3] == 108
        }
        return false
      })
      if boolean { return Option<Interned<Type>>.some(Interned<Type>.clone(&ty)) }
    }
    at = at + usize.ONE
  }
  return Option<Interned<Type>>.none()
}

effect fn threadClaims() -> () ! OutOfMemoryError | InvalidModulePath | SpawnError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"memory", b"thread-body", b"value.silk")
  let source = Option<Bytes>.some(run Bytes.copy(b"fn value() -> bool { let get = fn() -> bool { return true } return get() }\n"))
  let revision = run Revision.publish(&Revision.make(), &module, &source)
  let epoch = run Published<Revision>.make(move revision)
  let pool = run SharedTypePool.make()
  let firstPool = SharedTypePool.clone(&pool)
  let secondPool = SharedTypePool.clone(&pool)
  let firstEpoch = Published<Revision>.clone(&epoch)
  let secondEpoch = Published<Revision>.clone(&epoch)
  let firstModule = ModuleId.copy(&module)
  let secondModule = ModuleId.copy(&module)
  let first = run NativeThread.spawn(fn() -> Option<Published<TypedBody>> {
    return threadBody(move firstPool, move firstEpoch, move firstModule)
  })
  let second = run NativeThread.spawn(fn() -> Option<Published<TypedBody>> {
    return threadBody(move secondPool, move secondEpoch, move secondModule)
  })
  let firstBody = match move first.join() {
    Option<Published<TypedBody>>.Some {value} => move value
    _ => { run Testing.expect(false, "first worker publishes an actual checked body") return () }
  }
  let secondBody = match move second.join() {
    Option<Published<TypedBody>>.Some {value} => move value
    _ => { run Testing.expect(false, "second worker publishes an actual checked body") return () }
  }
  let firstType = match move Published<TypedBody>.with<Option<Interned<Type>>>(&firstBody, firstBoolean) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "published body retains its boolean result") return () }
  }
  let secondType = match move Published<TypedBody>.with<Option<Interned<Type>>>(&secondBody, firstBoolean) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "both bodies retain their exact result type") return () }
  }
  run Testing.expect(Interned<Type>.same(&firstType, &secondType), "independent worker queries use one canonical type universe")
  run Testing.expect(Published<TypedBody>.with<bool>(&firstBody, fn(value: &TypedBody) -> bool {
    return match &TypedBody.checkingStage(value).* { Stage.FullyChecked => true _ => false }
  }), "thread transfer does not strengthen the producer's checked stage")
  // Retain the epoch through use/export. Dropping the worker's local query store before join did
  // not destroy any shared body, nested callable, source identity or canonical type payload.
  run Testing.expect(Published<Revision>.count(&epoch) == usize.ONE,
    "both joined workers released their source epoch handles")
}

test effect fn nativeThreadsShareCompletedBodiesAndCanonicalTypes() -> ()
! OutOfMemoryError | InvalidModulePath | SpawnError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run threadClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runtimeBytesClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let cell = run RuntimeBytes.make(Bytes.make())
  let before = RuntimeBytes.snapshot(&cell)
  run RuntimeBytes.keep(&cell, run Bytes.copy(b"body"))
  let after = RuntimeBytes.snapshot(&cell)
  run Testing.expect(Bytes.length(Published<Bytes>.get(&before)) == usize.ZERO,
    "installing a runtime encoding leaves retained prior snapshots valid")
  run Testing.expect(Bytes.length(Published<Bytes>.get(&after)) == 4,
    "a later runtime snapshot observes the complete encoding")
  run RuntimeBytes.keep(&cell, run Bytes.copy(b"body"))
  let repeated = RuntimeBytes.snapshot(&cell)
  run Testing.expect(Published<Bytes>.address(&after) == Published<Bytes>.address(&repeated),
    "duplicate completed publication retains the first immutable value")
  let nested = RuntimeBytes.with<usize>(&cell, fn(outer: &Bytes) -> usize {
    return Bytes.length(outer) + RuntimeBytes.with<usize>(&cell, Bytes.length)
  })
  run Testing.expect(nested == 8, "runtime cache callbacks execute after releasing the publication lock")
}

test effect fn runtimeSnapshotsSurvivePublicationAndAllowNestedReads() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run runtimeBytesClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
