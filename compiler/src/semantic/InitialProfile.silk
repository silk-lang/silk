//! Frozen target and logical build inputs for static evaluation.
//!
//! # When to use
//!
//! Use `freeze` before source specialization. It validates one explicit target and all logical
//! choices. The resulting facts have a stable identity independent of set input order.

import semantic.Target {Id as TargetId, Target}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.vector {Vector}
import silk.usize

/// Whether an input is malformed or requests an unsupported combination.
pub enum ProblemKind {
  /// The supplied value is absent or outside its domain.
  InvalidInput,
  /// The value is in its domain but this target cannot use it.
  UnsupportedCombination,
}

/// The logical input whose validation failed.
pub enum Field {
  /// The target identity.
  Target,
  /// The CPU model.
  Cpu,
  /// The CPU feature set.
  CpuFeatures,
  /// The minimum deployment version.
  Deployment,
  /// The C library request.
  Libc,
  /// The output artifact kind.
  Artifact,
  /// The entry request.
  Entry,
  /// The link mode.
  Link,
  /// The code model.
  CodeModel,
  /// The relocation model.
  Relocation,
  /// The optimization mode.
  Optimization,
  /// The library safety policy.
  Safety,
  /// The library threading policy.
  Threading,
  /// The sanitizer set.
  Sanitizers,
  /// The unwind mode.
  Unwind,
  /// The logical runtime request.
  Runtime,
}

/// An input rejection with a stable reason and field.
pub struct Problem {
  /// The validation reason.
  pub kind: ProblemKind
  /// The input that caused the rejection.
  pub field: Field
}

/// A default, absent, or named logical entry or runtime request.
pub union Selection {
  /// Select the platform's default.
  Default,
  /// Select no entry or runtime composition.
  None,
  /// Select a logical name without a physical path.
  Named {
    /// The selected logical name.
    pub name: Bytes,
  },
}

/// Explicit logical inputs supplied by an application edge.
pub struct Input {
  /// A canonical target name. This field is required by `freeze`.
  pub target: Option<Bytes>
  /// An optional CPU model. The selected target supplies the default.
  pub cpu: Option<Bytes>
  /// CPU features treated as an unordered set.
  pub cpuFeatures: Vector<Bytes>
  /// An optional logical platform version.
  pub deployment: Option<Bytes>
  /// The optional C library choice.
  pub libc: Option<Bytes>
  /// The optional artifact kind.
  pub artifact: Option<Bytes>
  /// The entry selection.
  pub entry: Selection
  /// The optional link mode.
  pub link: Option<Bytes>
  /// The optional code model.
  pub codeModel: Option<Bytes>
  /// The optional relocation model.
  pub relocation: Option<Bytes>
  /// The optional optimization mode.
  pub optimization: Option<Bytes>
  /// Whether debug information is requested. The default is enabled.
  pub debug: Option<bool>
  /// The optional library safety policy.
  pub safety: Option<Bytes>
  /// The optional library threading policy.
  pub threading: Option<Bytes>
  /// Sanitizers treated as an unordered set.
  pub sanitizers: Vector<Bytes>
  /// The optional unwind choice.
  pub unwind: Option<Bytes>
  /// The runtime selection.
  pub runtime: Selection
}

/// Validated, normalized inputs before package parameters resolve.
pub struct InitialProfile {
  machine: Target
  cpu: Bytes
  cpuFeatures: Vector<Bytes>
  deployment: Bytes
  libc: Bytes
  artifact: Bytes
  entry: Selection
  link: Bytes
  codeModel: Bytes
  relocation: Bytes
  optimization: Bytes
  debug: bool
  safety: Bytes
  threading: Bytes
  sanitizers: Vector<Bytes>
  unwind: Bytes
  runtime: Selection
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn contains(values: &[Bytes], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if same(Bytes.asSlice(&values[at]), name) { return true }
    at = at + usize.ONE
  }
  return false
}

fn validName(name: &[u8]) -> bool {
  if name.length == usize.ZERO || name[usize.ZERO] == 47 { return false }
  let mut at = usize.ZERO
  while at < name.length {
    let char = name[at]
    let letter = char >= 65 && char <= 90 || char >= 97 && char <= 122
    let digit = char >= 48 && char <= 57
    let base = letter || digit || char == 95
    let tail = base || char == 64 || char == 46 || char == 43 || char == 58 || char == 47 || char == 45
    if at == usize.ZERO && !base || at > usize.ZERO && !tail { return false }
    if at + usize.ONE < name.length && char == 46 && name[at + usize.ONE] == 46 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn validChoice(field: Field, name: &[u8]) -> bool {
  return match field {
    Field.Libc => same(name, b"none") || same(name, b"system") || same(name, b"gnu")
    Field.Artifact => same(name, b"executable") || same(name, b"loadable-module") || same(
      name,
      b"static-archive",
    ) || same(name, b"object")
    Field.Link => same(name, b"static") || same(name, b"dynamic")
    Field.CodeModel => same(name, b"small") || same(name, b"large")
    Field.Relocation => same(name, b"static") || same(name, b"pic")
    Field.Optimization => same(name, b"none") || same(name, b"speed")
    Field.Safety => same(name, b"checked") || same(name, b"unchecked")
    Field.Threading => same(name, b"single") || same(name, b"multi")
    Field.Unwind => same(name, b"none") || same(name, b"native")
    Field.Target => false
    Field.Cpu => false
    Field.CpuFeatures => false
    Field.Deployment => false
    Field.Entry => false
    Field.Sanitizers => false
    Field.Runtime => false
  }
}

effect fn choice(value: &Option<Bytes>, field: Field, fallback: &[u8]) -> Bytes
! Problem | OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Option<Bytes>.Some {value: written} => {
      let selected = Bytes.asSlice(&written)
      if !validChoice(field, selected) {
        fail Problem {kind: ProblemKind.InvalidInput, field: field}
      }
      return run Bytes.copy(selected)
    }
    Option<Bytes>.None => { return run Bytes.copy(fallback) }
  }
}

effect fn copySelection(value: &Selection, field: Field) -> Selection
! Problem | OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Selection.Default => { return Selection.Default }
    Selection.None => { return Selection.None }
    Selection.Named {name} => {
      let spelling = Bytes.asSlice(&name)
      if !validName(spelling) {
        fail Problem {kind: ProblemKind.InvalidInput, field: field}
      }
      return Selection.Named {name: run Bytes.copy(spelling)}
    }
  }
}

fn sameSelection(left: &Selection, right: &Selection) -> bool {
  return match &left.* {
    Selection.Default => match &right.* {
      Selection.Default => true
      Selection.None => false
      Selection.Named {..} => false
    }
    Selection.None => match &right.* {
      Selection.None => true
      Selection.Default => false
      Selection.Named {..} => false
    }
    Selection.Named {name} => match &right.* {
      Selection.Named {name: other} => same(Bytes.asSlice(&name), Bytes.asSlice(&other))
      Selection.Default => false
      Selection.None => false
    }
  }
}

fn validDeployment(value: &[u8]) -> bool {
  if value.length == usize.ZERO { return false }
  let mut component = usize.ZERO
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= value.length {
    if at == value.length || value[at] == 46 {
      if at == start || at - start > usize.ONE && value[start] == 48 { return false }
      component = component + usize.ONE
      if component > 3 { return false }
      start = at + usize.ONE
    } else if value[at] < 48 || value[at] > 57 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn deployment(value: &Option<Bytes>) -> Bytes
! Problem | OutOfMemoryError ? &mut Allocator {
  let raw = match &value.* {
    Option<Bytes>.Some {value: written} => Bytes.asSlice(&written)
    Option<Bytes>.None => { return run Bytes.copy(b"") }
  }
  if !validDeployment(raw) { fail Problem {kind: ProblemKind.InvalidInput, field: Field.Deployment} }
  let mut normalized = run Bytes.copy(raw)
  let mut dots = usize.ZERO
  let mut at = usize.ZERO
  while at < raw.length {
    if raw[at] == 46 { dots = dots + usize.ONE }
    at = at + usize.ONE
  }
  while dots < 2 {
    run Bytes.append(&mut normalized, b".0")
    dots = dots + usize.ONE
  }
  return move normalized
}

effect fn cpuFeatures(input: &[Bytes], target: &Target) -> Vector<Bytes>
! Problem | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < input.length {
    if !Target.supportsFeature(target, Bytes.asSlice(&input[at])) {
      fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.CpuFeatures}
    }
    at = at + usize.ONE
  }
  let mut values = Vector.make<Bytes>()
  at = usize.ZERO
  while at < Target.featureCount(target) {
    let feature = Target.feature(target, at)
    let selected = contains(input, feature) || (
      Target.id(target) == TargetId.Aarch64AppleDarwin ||
      Target.id(target) == TargetId.Aarch64UnknownLinuxGnu
    ) && (same(feature, b"fp-armv8") || same(feature, b"neon")) ||
      Target.id(target) == TargetId.X8664UnknownLinuxGnu && (
        same(feature, b"sse2") || same(feature, b"avx") && contains(input, b"avx2")
      )
    if selected { run Vector.append<Bytes>(&mut values, run Bytes.copy(feature)) }
    at = at + usize.ONE
  }
  return move values
}

effect fn sanitizers(input: &[Bytes]) -> Vector<Bytes>
! Problem | OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < input.length {
    let spelling = Bytes.asSlice(&input[at])
    if !same(spelling, b"address") && !same(spelling, b"thread") && !same(spelling, b"undefined") {
      fail Problem {kind: ProblemKind.InvalidInput, field: Field.Sanitizers}
    }
    at = at + usize.ONE
  }
  let mut values = Vector.make<Bytes>()
  if contains(input, b"address") { run Vector.append<Bytes>(&mut values, run Bytes.copy(b"address")) }
  if contains(input, b"thread") { run Vector.append<Bytes>(&mut values, run Bytes.copy(b"thread")) }
  if contains(input, b"undefined") { run Vector.append<Bytes>(&mut values, run Bytes.copy(b"undefined")) }
  return move values
}

fn sameSet(left: &[Bytes], right: &[Bytes]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if !same(Bytes.asSlice(&left[at]), Bytes.asSlice(&right[at])) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn copyFrozenSet(values: &[Bytes]) -> Vector<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<Bytes>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Bytes>(&mut copied, run Bytes.copy(Bytes.asSlice(&values[at])))
    at = at + usize.ONE
  }
  return move copied
}

effect fn copyFrozenSelection(value: &Selection) -> Selection ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Selection.Default => { return Selection.Default }
    Selection.None => { return Selection.None }
    Selection.Named {name} => {
      return Selection.Named {name: run Bytes.copy(Bytes.asSlice(&name))}
    }
  }
}

impl Input {
  /// Creates a request with no target and deterministic defaults for other fields.
  pub fn make() -> Input {
    return Input {
      target: Option.none<Bytes>(), cpu: Option.none<Bytes>(), cpuFeatures: Vector.make<Bytes>(),
      deployment: Option.none<Bytes>(), libc: Option.none<Bytes>(), artifact: Option.none<Bytes>(),
      entry: Selection.Default, link: Option.none<Bytes>(), codeModel: Option.none<Bytes>(),
      relocation: Option.none<Bytes>(), optimization: Option.none<Bytes>(), debug: Option.none<bool>(),
      safety: Option.none<Bytes>(), threading: Option.none<Bytes>(), sanitizers: Vector.make<Bytes>(),
      unwind: Option.none<Bytes>(), runtime: Selection.Default,
    }
  }
}

impl InitialProfile {
  /// Copies frozen facts for a semantic store's fixed assembly input.
  pub effect fn copy(self: &Self) -> InitialProfile ! OutOfMemoryError ? &mut Allocator {
    return InitialProfile {
      machine: self.machine,
      cpu: run Bytes.copy(Bytes.asSlice(&self.cpu)),
      cpuFeatures: run copyFrozenSet(Vector.asSlice<Bytes>(&self.cpuFeatures)),
      deployment: run Bytes.copy(Bytes.asSlice(&self.deployment)),
      libc: run Bytes.copy(Bytes.asSlice(&self.libc)),
      artifact: run Bytes.copy(Bytes.asSlice(&self.artifact)),
      entry: run copyFrozenSelection(&self.entry),
      link: run Bytes.copy(Bytes.asSlice(&self.link)),
      codeModel: run Bytes.copy(Bytes.asSlice(&self.codeModel)),
      relocation: run Bytes.copy(Bytes.asSlice(&self.relocation)),
      optimization: run Bytes.copy(Bytes.asSlice(&self.optimization)),
      debug: self.debug,
      safety: run Bytes.copy(Bytes.asSlice(&self.safety)),
      threading: run Bytes.copy(Bytes.asSlice(&self.threading)),
      sanitizers: run copyFrozenSet(Vector.asSlice<Bytes>(&self.sanitizers)),
      unwind: run Bytes.copy(Bytes.asSlice(&self.unwind)),
      runtime: run copyFrozenSelection(&self.runtime),
    }
  }
  /// Validates explicit inputs and returns immutable normalized facts without reading host state.
  pub effect fn freeze(input: &Input) -> InitialProfile
  ! Problem | OutOfMemoryError ? &mut Allocator {
  let selected = match &input.target {
    Option<Bytes>.Some {value} => Target.resolve(Bytes.asSlice(&value))
    Option<Bytes>.None => { fail Problem {kind: ProblemKind.InvalidInput, field: Field.Target} }
  }
  let target = match move selected {
    Option<Target>.Some {value} => value
    Option<Target>.None => { fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.Target} }
  }
  let mut cpu = run Bytes.copy(Target.defaultCpu(&target))
  if let Option<Bytes>.Some {value} = &input.cpu {
    let spelling = Bytes.asSlice(&value)
    if !Target.supportsCpu(&target, spelling) {
      fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.Cpu}
    }
    cpu = run Bytes.copy(spelling)
  }
  let features = run cpuFeatures(Vector.asSlice<Bytes>(&input.cpuFeatures), &target)
  let version = run deployment(&input.deployment)
  let defaultLibc = match Target.id(&target) {
    TargetId.Aarch64AppleDarwin => b"system"
    TargetId.Aarch64UnknownLinuxGnu => b"gnu"
    TargetId.X8664UnknownLinuxGnu => b"gnu"
    TargetId.Wasm32UnknownUnknown => b"none"
  }
  let libc = run choice(&input.libc, Field.Libc, defaultLibc)
  let artifact = run choice(&input.artifact, Field.Artifact, b"executable")
  let entry = run copySelection(&input.entry, Field.Entry)
  let wasm = Target.id(&target) == TargetId.Wasm32UnknownUnknown
  let mut linkDefault: &[u8] = b"dynamic"
  if wasm { linkDefault = b"static" }
  let link = run choice(&input.link, Field.Link, linkDefault)
  let codeModel = run choice(&input.codeModel, Field.CodeModel, b"small")
  let mut relocationDefault: &[u8] = b"pic"
  if wasm { relocationDefault = b"static" }
  let relocation = run choice(&input.relocation, Field.Relocation, relocationDefault)
  let optimization = run choice(&input.optimization, Field.Optimization, b"none")
  let debug = match &input.debug {
    Option<bool>.Some {value} => value
    Option<bool>.None => true
  }
  let safety = run choice(&input.safety, Field.Safety, b"checked")
  let threading = run choice(&input.threading, Field.Threading, b"single")
  let sanitizerSet = run sanitizers(Vector.asSlice<Bytes>(&input.sanitizers))
  let unwind = run choice(&input.unwind, Field.Unwind, b"none")
  let runtime = run copySelection(&input.runtime, Field.Runtime)
  let libcName = Bytes.asSlice(&libc)
  let artifactName = Bytes.asSlice(&artifact)
  let linkName = Bytes.asSlice(&link)
  let versionName = Bytes.asSlice(&version)
  let codeModelName = Bytes.asSlice(&codeModel)
  let relocationName = Bytes.asSlice(&relocation)
  let unwindName = Bytes.asSlice(&unwind)
  if Target.id(&target) == TargetId.Aarch64AppleDarwin && (
    same(libcName, b"gnu") || same(libcName, b"none") && !same(artifactName, b"object") && !same(artifactName, b"static-archive")
  ) || Target.id(&target) == TargetId.Aarch64UnknownLinuxGnu && same(libcName, b"system") ||
    Target.id(&target) == TargetId.X8664UnknownLinuxGnu && same(libcName, b"system") ||
    wasm && !same(libcName, b"none") {
    fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.Libc}
  }
  if wasm && (versionName.length > usize.ZERO || !same(linkName, b"static") ||
    !same(codeModelName, b"small") || !same(relocationName, b"static") ||
    Vector.length<Bytes>(&sanitizerSet) > usize.ZERO || !same(unwindName, b"none")) {
    fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.Target}
  }
  if contains(Vector.asSlice<Bytes>(&sanitizerSet), b"address") && contains(Vector.asSlice<Bytes>(&sanitizerSet), b"thread") {
    fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.Sanitizers}
  }
  if contains(Vector.asSlice<Bytes>(&sanitizerSet), b"thread") && !same(Bytes.asSlice(&threading), b"multi") {
    fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.Threading}
  }
  if Target.id(&target) == TargetId.Aarch64AppleDarwin && same(linkName, b"static") && same(artifactName, b"executable") {
    fail Problem {kind: ProblemKind.UnsupportedCombination, field: Field.Link}
  }
  return InitialProfile {
    machine: target, cpu: move cpu, cpuFeatures: move features, deployment: move version,
    libc: move libc, artifact: move artifact, entry: move entry, link: move link,
    codeModel: move codeModel, relocation: move relocation, optimization: move optimization,
    debug: debug, safety: move safety, threading: move threading, sanitizers: move sanitizerSet,
    unwind: move unwind, runtime: move runtime,
  }
  }
  /// Returns the initial-facts schema revision.
  pub fn revision(self: &Self) -> u32 { return 1 }
  /// Borrows the selected machine description.
  pub fn target(self: &Self) -> &Target { return &self.machine }
  /// Returns one closed static text fact, or `None` for an invalid key.
  pub fn text(self: &Self, key: &[u8]) -> Option<&[u8]> {
    if same(key, b"cpu") { return Option.some<&[u8]>(Bytes.asSlice(&self.cpu)) }
    if same(key, b"deployment") { return Option.some<&[u8]>(Bytes.asSlice(&self.deployment)) }
    if same(key, b"libc") { return Option.some<&[u8]>(Bytes.asSlice(&self.libc)) }
    if same(key, b"artifact") { return Option.some<&[u8]>(Bytes.asSlice(&self.artifact)) }
    if same(key, b"entry-kind") { return Option.some<&[u8]>(selectionKind(&self.entry)) }
    if same(key, b"entry-name") { return Option.some<&[u8]>(selectionName(&self.entry)) }
    if same(key, b"link") { return Option.some<&[u8]>(Bytes.asSlice(&self.link)) }
    if same(key, b"code-model") { return Option.some<&[u8]>(Bytes.asSlice(&self.codeModel)) }
    if same(key, b"relocation") { return Option.some<&[u8]>(Bytes.asSlice(&self.relocation)) }
    if same(key, b"optimization") { return Option.some<&[u8]>(Bytes.asSlice(&self.optimization)) }
    if same(key, b"safety") { return Option.some<&[u8]>(Bytes.asSlice(&self.safety)) }
    if same(key, b"threading") { return Option.some<&[u8]>(Bytes.asSlice(&self.threading)) }
    if same(key, b"unwind") { return Option.some<&[u8]>(Bytes.asSlice(&self.unwind)) }
    if same(key, b"runtime-kind") { return Option.some<&[u8]>(selectionKind(&self.runtime)) }
    if same(key, b"runtime-name") { return Option.some<&[u8]>(selectionName(&self.runtime)) }
    return Option.none<&[u8]>()
  }
  /// Returns the debug flag, or `None` for an invalid key.
  pub fn flag(self: &Self, key: &[u8]) -> Option<bool> {
    if same(key, b"debug") { return Option.some<bool>(self.debug) }
    return Option.none<bool>()
  }
  /// Reports set membership, or `None` for an invalid set key.
  pub fn contains(self: &Self, key: &[u8], member: &[u8]) -> Option<bool> {
    if same(key, b"cpu-features") {
      return Option.some<bool>(contains(Vector.asSlice<Bytes>(&self.cpuFeatures), member))
    }
    if same(key, b"sanitizers") {
      return Option.some<bool>(contains(Vector.asSlice<Bytes>(&self.sanitizers), member))
    }
    return Option.none<bool>()
  }
  /// Reports whether two profiles have the same normalized initial-facts identity.
  pub fn sameIdentity(self: &Self, other: &InitialProfile) -> bool {
    return Target.revision(&self.machine) == Target.revision(&other.machine) &&
      Target.id(&self.machine) == Target.id(&other.machine) &&
      same(Bytes.asSlice(&self.cpu), Bytes.asSlice(&other.cpu)) &&
      sameSet(Vector.asSlice<Bytes>(&self.cpuFeatures), Vector.asSlice<Bytes>(&other.cpuFeatures)) &&
      same(Bytes.asSlice(&self.deployment), Bytes.asSlice(&other.deployment)) &&
      same(Bytes.asSlice(&self.libc), Bytes.asSlice(&other.libc)) &&
      same(Bytes.asSlice(&self.artifact), Bytes.asSlice(&other.artifact)) &&
      sameSelection(&self.entry, &other.entry) &&
      same(Bytes.asSlice(&self.link), Bytes.asSlice(&other.link)) &&
      same(Bytes.asSlice(&self.codeModel), Bytes.asSlice(&other.codeModel)) &&
      same(Bytes.asSlice(&self.relocation), Bytes.asSlice(&other.relocation)) &&
      same(Bytes.asSlice(&self.optimization), Bytes.asSlice(&other.optimization)) &&
      self.debug == other.debug &&
      same(Bytes.asSlice(&self.safety), Bytes.asSlice(&other.safety)) &&
      same(Bytes.asSlice(&self.threading), Bytes.asSlice(&other.threading)) &&
      sameSet(Vector.asSlice<Bytes>(&self.sanitizers), Vector.asSlice<Bytes>(&other.sanitizers)) &&
      same(Bytes.asSlice(&self.unwind), Bytes.asSlice(&other.unwind)) &&
      sameSelection(&self.runtime, &other.runtime)
  }
}

fn selectionKind(value: &Selection) -> &[u8] {
  return match &value.* {
    Selection.Default => b"default"
    Selection.None => b"none"
    Selection.Named {..} => b"named"
  }
}

fn selectionName(value: &Selection) -> &[u8] {
  return match &value.* {
    Selection.Named {name} => Bytes.asSlice(&name)
    Selection.Default => b""
    Selection.None => b""
  }
}
