//! One experimental switch shared by semantic cache producers, readers and driver identity.
import semantic.FrontierHost {FrontierHost}
import silk.mem.pointer {Pointer}

/// Whether this compiler invocation uses immutable segmented cache generations.
/// Presence enables the isolated experiment; unsupported hosts expose no environment switch.
pub fn enabled() -> bool {
  return !Pointer.isNullMany<u8>(unsafe FrontierHost.environment(Pointer.fromSlice<u8>(b"SILK_CACHE_SEGMENTS\0")))
}
