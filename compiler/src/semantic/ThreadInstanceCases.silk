//! Native transfer of canonical instance tasks with fresh receiver-local key caches.
import backend.InstanceKey {InstanceKey, InstanceSeed, ProviderEntry, HelperRole, StorageRole}
import semantic.ThreadFrontier
import semantic.Published {Published}
import semantic.Type {Type, Argument, Requirement}
import semantic.Types {Types, TypeTable}
import semantic.Specialization {Application, Target, ScopeBinding, StaticSlot}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Target {Target as MachineTarget, Id as TargetId}
import semantic.Lifetime {CanonicalizationFailure}
import semantic.ContentHash {ContentHash}
import semantic.RuntimeEncoding
import hir.Hir {OwnerKind, Access}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.shared {Shared}
import silk.mem.interned {Interned}
import silk.collections.list {List}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.core.effect {Effect}
import silk.concurrency.thread_native {NativeThread, SpawnError}
import silk.num.usize
import silk.testing.testing {Testing, AssertionError}

effect fn identity(name: &[u8], kind: OwnerKind) -> DeclarationId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"memory", b"thread-seed", b"tasks.silk")
  let mut owners = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut owners, OwnerStep {kind: kind, name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: 0})
  return run DeclarationId.fromParts(move module, move owners)
}

effect fn consume(seeds: &[InstanceSeed], exact: &[Bytes]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < seeds.length {
    let first = run InstanceSeed.instantiate(&seeds[at])
    let second = run InstanceSeed.instantiate(&seeds[at])
    let encoded = run InstanceKey.exactIdentity(&first)
    if !RuntimeEncoding.equals(Bytes.asSlice(&encoded), Bytes.asSlice(&exact[at])) { return false }
    if !run InstanceKey.sameApplication(&first, &second) { return false }
    InstanceKey.keepBare(&first, ContentHash {high: 7, low: 9})
    if let Option<ContentHash>.Some {..} = move InstanceKey.keptBare(&second) { return false }
    at = at + usize.ONE
  }
  return true
}
fn receive(seeds: List<InstanceSeed>, exact: List<Bytes>) -> bool {
  let mut allocator = Allocator.systemAllocatorProvider()
  return match move run Effect.result(consume(List<InstanceSeed>.asSlice(&seeds), List<Bytes>.asSlice(&exact)))
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Result<bool, OutOfMemoryError>.Success {value} => value
    _ => false
  }
}

effect fn claims() -> ()
! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | SpawnError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let owner = run Types.internDeclaration(run identity(b"work", OwnerKind.Function))
  let nominal = run Types.intern(Type.Nominal {declaration: run identity(b"Payload", OwnerKind.Struct),
    isPublic: true, arguments: List<Argument>.make()})
  let mut served = List<ProviderEntry>.make()
  run List<ProviderEntry>.append(&mut served, ProviderEntry {key: Requirement {
    capability: Interned<Type>.clone(&nominal), roleType: Option<Interned<Type>>.some(Interned<Type>.clone(&nominal)), access: Access.Shared},
    provider: Interned<Type>.clone(&nominal)})
  let application = Application {target: Target.Named {declaration: DeclarationId.copyShared(&owner)},
    arguments: List<Argument>.make(), argumentOrdinals: List<usize>.make(), scopes: List<ScopeBinding>.make(), statics: List<StaticSlot>.make()}
  let ordinary = match move run InstanceKey.canonical(move application, move served) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value} => move value
    Result<InstanceKey, CanonicalizationFailure>.Failure {error} => { fail error }
  }
  let mut keys = List<InstanceKey>.make()
  run List<InstanceKey>.append(&mut keys, InstanceKey.Helper {creator: run Shared<InstanceKey>.make(InstanceKey.copy(&ordinary)),
    node: 17, ordinal: 3, purpose: HelperRole.Observe})
  run List<InstanceKey>.append(&mut keys, move ordinary)
  run List<InstanceKey>.append(&mut keys, InstanceKey.Export {function: Interned<DeclarationId>.clone(&owner),
    symbol: run Published<Bytes>.make(run Bytes.copy(b"fixed_export"))})
  let glue = match move run InstanceKey.dropGlue(&nominal, Interned<DeclarationId>.get(&owner)) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value} => move value
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {error} => { fail error }
  }
  if let Option<InstanceKey>.Some {value} = move glue { run List<InstanceKey>.append(&mut keys, move value) }
  else { run Testing.expect(false, "the nominal fixture supplies a glue owner") }
  run List<InstanceKey>.append(&mut keys, run InstanceKey.storage(&owner, StorageRole.Resize,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), 24, 8, &[Interned<DeclarationId>.clone(&owner)]))
  let mut seeds = List<InstanceSeed>.make()
  let mut exact = List<Bytes>.make()
  let held = List<InstanceKey>.asSlice(&keys)
  let mut at = usize.ZERO
  while at < held.length {
    run List<Bytes>.append(&mut exact, run InstanceKey.exactIdentity(&held[at]))
    let seed = match move run InstanceSeed.make(&held[at]) {
      Option<InstanceSeed>.Some {value} => move value
      _ => { run Testing.expect(false, "bounded canonical task must snapshot") return () }
    }
    run List<InstanceSeed>.append(&mut seeds, move seed)
    at = at + usize.ONE
  }
  drop keys
  let worker = run NativeThread.spawn(fn() -> bool { return receive(move seeds, move exact) })
  run Testing.expect(worker.join(), "all canonical task kinds survive source-key drop and own independent receiver caches")
}

test effect fn threadInstanceSeedsPreserveCanonicalTasksAndPrivateCaches() -> ()
! InvalidModulePath | CanonicalizationFailure | OutOfMemoryError | SpawnError | AssertionError<'static> {
  if !ThreadFrontier.available() { return () }
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  run claims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
