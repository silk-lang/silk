//! Source selection evidence for a callable returned by an interface operation.
//! The selected implementation remains an ordinary application; this recipe has no storage.

import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import semantic.Type {Argument, Binding, Type}
import silk.core.option {Option}
import silk.mem.shared {Shared}
import silk.mem.frozen {Frozen}
import silk.mem.interned {Interned}
import silk.num.usize
import silk.collections.list {List}

/// One operand position, retaining whether witness selection may borrow its owned value.
// A nominal element keeps recursive metadata drop discovery distinct from Type lists.
pub struct OperandLoan {
  pub region: Option<Frozen<Lifetime>>,
}

/// An immutable checked invocation awaiting its concrete conformance witness.
pub struct CallableWitness {
  pub operation: Frozen<DeclarationId>,
  pub contract: Interned<Type>,
  pub provider: Interned<Type>,
  pub result: Interned<Type>,
  pub bindings: Shared<List<Binding>>,
  pub arguments: Shared<List<Interned<Type>>>,
  pub loans: Shared<List<OperandLoan>>,
  /// The operation is an `effect fn`: `result` is the Effect contract its witness call constructs,
  /// whose exact representation stores `arguments` (EFF-001).
  pub constructs: bool,
}

/// Copies immutable handles before traversing children, releasing the outer shared borrow.
pub fn copy(value: &CallableWitness) -> CallableWitness {
  return CallableWitness {
    operation: Frozen<DeclarationId>.clone(&value.operation), contract: Interned<Type>.clone(&value.contract),
    provider: Interned<Type>.clone(&value.provider), result: Interned<Type>.clone(&value.result),
    bindings: Shared<List<Binding>>.clone(&value.bindings),
    arguments: Shared<List<Interned<Type>>>.clone(&value.arguments),
    loans: Shared<List<OperandLoan>>.clone(&value.loans),
    constructs: value.constructs,
  }
}

/// Number of original-owner invocation assignments.
pub fn bindingCount(value: &CallableWitness) -> usize {
  return Shared<List<Binding>>.with<usize>(&value.bindings, fn(entries: &List<Binding>) -> usize { return List<Binding>.length(entries) })
}

/// One original-owner assignment, retaining its sparse ordinal.
pub fn bindingAt(value: &CallableWitness, index: usize) -> Binding {
  return Shared<List<Binding>>.with<Binding>(&value.bindings, fn(entries: &List<Binding>) -> Binding {
    let listed = List<Binding>.asSlice(entries)
    return Binding {declaration: Frozen<DeclarationId>.clone(&listed[index].declaration),
      ordinal: listed[index].ordinal, value: Argument.copy(&listed[index].value)}
  })
}

/// Number of checked operands, including an explicit or synthesized receiver.
pub fn argumentCount(value: &CallableWitness) -> usize {
  return Shared<List<Interned<Type>>>.with<usize>(&value.arguments, fn(entries: &List<Interned<Type>>) -> usize { return List<Interned<Type>>.length(entries) })
}

/// The actual type of one checked operand.
pub fn argumentAt(value: &CallableWitness, index: usize) -> Interned<Type> {
  return Shared<List<Interned<Type>>>.with<Interned<Type>>(&value.arguments, fn(entries: &List<Interned<Type>>) -> Interned<Type> {
    let listed = List<Interned<Type>>.asSlice(entries)
    return Interned<Type>.clone(&listed[index])
  })
}

/// Number of caller-owned operand regions available to witness loan transport.
pub fn loanCount(value: &CallableWitness) -> usize {
  return Shared<List<OperandLoan>>.with<usize>(&value.loans, fn(entries: &List<OperandLoan>) -> usize { return List<OperandLoan>.length(entries) })
}

/// The caller region belonging to an actual written operand, before target-owned remapping.
pub fn loanAt(value: &CallableWitness, index: usize) -> Option<Frozen<Lifetime>> {
  return Shared<List<OperandLoan>>.with<Option<Frozen<Lifetime>>>(&value.loans, fn(entries: &List<OperandLoan>) -> Option<Frozen<Lifetime>> {
    let listed = List<OperandLoan>.asSlice(entries)
    return match &listed[index].region {
      Option<Frozen<Lifetime>>.Some {value: region} => Option<Frozen<Lifetime>>.some(Frozen<Lifetime>.clone(&region))
      _ => Option<Frozen<Lifetime>>.none()
    }
  })
}

/// Ordered free type channels; assignment rows and lifetimes have separate walkers.
pub fn childCount(value: &CallableWitness) -> usize {
  return 3 + argumentCount(value) + bindingCount(value)
}

/// One free type channel, retaining empty positions for row/lifetime assignments.
pub fn childAt(value: &CallableWitness, index: usize) -> Option<Interned<Type>> {
  if index == usize.ZERO { return Option<Interned<Type>>.some(Interned<Type>.clone(&value.contract)) }
  if index == usize.ONE { return Option<Interned<Type>>.some(Interned<Type>.clone(&value.provider)) }
  if index == 2 { return Option<Interned<Type>>.some(Interned<Type>.clone(&value.result)) }
  let count = argumentCount(value)
  if index - 3 < count { return Option<Interned<Type>>.some(argumentAt(value, index - 3)) }
  let selected = bindingAt(value, index - 3 - count)
  if let Argument.Type {value: ty} = move selected.value { return Option<Interned<Type>>.some(move ty) }
  return Option<Interned<Type>>.none()
}

/// The invocation permission retained by this source recipe.
pub fn resultType(value: &CallableWitness) -> Interned<Type> { return Interned<Type>.clone(&value.result) }
