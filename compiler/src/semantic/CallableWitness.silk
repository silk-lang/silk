//! Source selection evidence for a callable returned by an interface operation.
//! The selected implementation remains an ordinary application; this recipe has no storage.

import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import semantic.Type {Argument, Binding, Type}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One operand position, retaining whether witness selection may borrow its owned value.
// A nominal element keeps recursive metadata drop discovery distinct from Type vectors.
pub struct OperandLoan {
  pub region: Option<Shared<Lifetime>>
}

/// An immutable checked invocation awaiting its concrete conformance witness.
pub struct CallableWitness {
  pub operation: Shared<DeclarationId>
  pub contract: Shared<Type>
  pub provider: Shared<Type>
  pub result: Shared<Type>
  pub bindings: Shared<Vector<Binding>>
  pub arguments: Shared<Vector<Shared<Type>>>
  pub loans: Shared<Vector<OperandLoan>>
  /// The operation is an `effect fn`: `result` is the Effect contract its witness call constructs,
  /// whose exact representation stores `arguments` (EFF-001).
  pub constructs: bool
}

/// Copies immutable handles before traversing children, releasing the outer shared borrow.
pub fn copy(value: &CallableWitness) -> CallableWitness {
  return CallableWitness {
    operation: Shared.clone<DeclarationId>(&value.operation), contract: Shared.clone<Type>(&value.contract),
    provider: Shared.clone<Type>(&value.provider), result: Shared.clone<Type>(&value.result),
    bindings: Shared.clone<Vector<Binding>>(&value.bindings),
    arguments: Shared.clone<Vector<Shared<Type>>>(&value.arguments),
    loans: Shared.clone<Vector<OperandLoan>>(&value.loans),
    constructs: value.constructs,
  }
}

/// Number of original-owner invocation assignments.
pub fn bindingCount(value: &CallableWitness) -> usize {
  return Shared.with<Vector<Binding>, usize>(&value.bindings, fn(entries: &Vector<Binding>) -> usize { return Vector.length<Binding>(entries) })
}

/// One original-owner assignment, retaining its sparse ordinal.
pub fn bindingAt(value: &CallableWitness, index: usize) -> Binding {
  return Shared.with<Vector<Binding>, Binding>(&value.bindings, fn(entries: &Vector<Binding>) -> Binding {
    let listed = Vector.asSlice<Binding>(entries)
    return Binding {declaration: Shared.clone<DeclarationId>(&listed[index].declaration),
      ordinal: listed[index].ordinal, value: Argument.copy(&listed[index].value)}
  })
}

/// Number of checked operands, including an explicit or synthesized receiver.
pub fn argumentCount(value: &CallableWitness) -> usize {
  return Shared.with<Vector<Shared<Type>>, usize>(&value.arguments, fn(entries: &Vector<Shared<Type>>) -> usize { return Vector.length<Shared<Type>>(entries) })
}

/// The actual type of one checked operand.
pub fn argumentAt(value: &CallableWitness, index: usize) -> Shared<Type> {
  return Shared.with<Vector<Shared<Type>>, Shared<Type>>(&value.arguments, fn(entries: &Vector<Shared<Type>>) -> Shared<Type> {
    let listed = Vector.asSlice<Shared<Type>>(entries)
    return Shared.clone<Type>(&listed[index])
  })
}

/// Number of caller-owned operand regions available to witness loan transport.
pub fn loanCount(value: &CallableWitness) -> usize {
  return Shared.with<Vector<OperandLoan>, usize>(&value.loans, fn(entries: &Vector<OperandLoan>) -> usize { return Vector.length<OperandLoan>(entries) })
}

/// The caller region belonging to an actual written operand, before target-owned remapping.
pub fn loanAt(value: &CallableWitness, index: usize) -> Option<Shared<Lifetime>> {
  return Shared.with<Vector<OperandLoan>, Option<Shared<Lifetime>>>(&value.loans, fn(entries: &Vector<OperandLoan>) -> Option<Shared<Lifetime>> {
    let listed = Vector.asSlice<OperandLoan>(entries)
    return match &listed[index].region {
      Option<Shared<Lifetime>>.Some {value: region} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&region))
      _ => Option.none<Shared<Lifetime>>()
    }
  })
}

/// Ordered free type channels; assignment rows and lifetimes have separate walkers.
pub fn childCount(value: &CallableWitness) -> usize {
  return 3 + argumentCount(value) + bindingCount(value)
}

/// One free type channel, retaining empty positions for row/lifetime assignments.
pub fn childAt(value: &CallableWitness, index: usize) -> Option<Shared<Type>> {
  if index == usize.ZERO { return Option.some<Shared<Type>>(Shared.clone<Type>(&value.contract)) }
  if index == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&value.provider)) }
  if index == 2 { return Option.some<Shared<Type>>(Shared.clone<Type>(&value.result)) }
  let count = argumentCount(value)
  if index - 3 < count { return Option.some<Shared<Type>>(argumentAt(value, index - 3)) }
  let selected = bindingAt(value, index - 3 - count)
  if let Argument.Type {value: ty} = move selected.value { return Option.some<Shared<Type>>(move ty) }
  return Option.none<Shared<Type>>()
}

/// The invocation permission retained by this source recipe.
pub fn resultType(value: &CallableWitness) -> Shared<Type> { return Shared.clone<Type>(&value.result) }
