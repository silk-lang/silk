//! Executable selection preserves logical proof graphs and their identity mode.
import semantic.BuildRecord
import semantic.ContentHash {ContentHash}
import semantic.ExecutableClosure
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {Testing, AssertionError}

fn digest(value: u64) -> ContentHash { return ContentHash {high: 17, low: value} }

fn entry(id: u64, known: bool) -> BuildRecord.Entry {
  let mut facts = BuildRecord.unknownFacts()
  facts.flags = BuildRecord.FACT_KNOWN
  if known { facts.flags = facts.flags + BuildRecord.FACT_EXECUTABLES }
  return BuildRecord.Entry {exact: digest(id), hash: id, family: 0, declaration: Bytes.make(),
    parent: usize.MAX, position: usize.ZERO, requested: false, alias: usize.MAX, leaf: 0,
    references: List<BuildRecord.Reference>.make(), summary: digest(id), facts: move facts}
}

effect fn proof(value: &mut BuildRecord.Entry, target: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  return run List<BuildRecord.Reference>.append(&mut value.references,
    BuildRecord.Reference {target: target, edge: digest(0)})
}

effect fn executable(value: &mut BuildRecord.Entry, exact: u64, definition: u64) -> ()
! OutOfMemoryError ? &mut Allocator {
  return run List<BuildRecord.Callee>.append(&mut value.facts.executables,
    BuildRecord.Callee {exact: digest(exact), definition: digest(definition)})
}

fn selected(value: &Option<List<bool>>, expected: &[bool]) -> bool {
  return match &value.* {
    Option<List<bool>>.Some {value: mask} => {
      let actual = List<bool>.asSlice(&mask)
      if actual.length != expected.length { return false }
      let mut at = usize.ZERO
      while at < actual.length {
        if actual[at] != expected[at] { return false }
        at = at + usize.ONE
      }
      true
    }
    _ => false
  }
}

fn refused(value: &Option<List<bool>>) -> bool {
  return match &value.* { Option<List<bool>>.None => true _ => false }
}

test effect fn executableClosureKeepsCyclesAliasesAndExtraRoots() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run reachableClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reachableClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut graph = BuildRecord.make(false, true)
  run List<ContentHash>.append(&mut graph.roots, digest(10))
  let mut root = entry(10, true)
  run proof(&mut root, usize.ONE)
  run proof(&mut root, 2)
  run executable(&mut root, 12, 112)
  run executable(&mut root, 12, 112)
  run List<BuildRecord.Entry>.append(&mut graph.entries, move root)
  run List<BuildRecord.Entry>.append(&mut graph.entries, entry(11, true))
  let mut cycle = entry(12, false)
  run proof(&mut cycle, usize.ZERO)
  run List<BuildRecord.Entry>.append(&mut graph.entries, move cycle)
  let mut alias = entry(13, false)
  alias.alias = 2
  run List<BuildRecord.Entry>.append(&mut graph.entries, move alias)
  let mut foreign = entry(14, false)
  foreign.leaf = BuildRecord.FOREIGN
  run List<BuildRecord.Entry>.append(&mut graph.entries, move foreign)
  let roots = [digest(13), digest(14), digest(13)]
  let result = run ExecutableClosure.select(&graph, &roots)
  run Testing.expect(selected(&result, &[true, false, true, true, true]),
    "exact instruction edges exclude a proof-only body while conservative cycles, alias owners and explicit roots survive")
  let proofEdges = List<BuildRecord.Reference>.asSlice(&List<BuildRecord.Entry>.asSlice(&graph.entries)[0].references)
  run Testing.expect(proofEdges[0].target == usize.ONE && proofEdges[1].target == 2,
    "selection leaves the complete logical proof edges intact")
  return ()
}

test effect fn executableClosureDistinguishesExactAndDefinitionTargets() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run modeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn modeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut exact = BuildRecord.make(false, true)
  run List<ContentHash>.append(&mut exact.roots, digest(1))
  let mut exactRoot = entry(1, true)
  run executable(&mut exactRoot, 2, 99)
  run List<BuildRecord.Entry>.append(&mut exact.entries, move exactRoot)
  run List<BuildRecord.Entry>.append(&mut exact.entries, entry(2, true))
  run Testing.expect(selected(&run ExecutableClosure.select(&exact, &[]), &[true, true]),
    "an exact-pattern record resolves the exact member of each target pair")
  let mut definitions = BuildRecord.make(false, false)
  run List<ContentHash>.append(&mut definitions.roots, digest(10))
  let mut definitionRoot = entry(10, true)
  run executable(&mut definitionRoot, 2, 99)
  run List<BuildRecord.Entry>.append(&mut definitions.entries, move definitionRoot)
  run List<BuildRecord.Entry>.append(&mut definitions.entries, entry(99, true))
  run Testing.expect(selected(&run ExecutableClosure.select(&definitions, &[]), &[true, true]),
    "a definition record resolves the provider-sensitive definition member without falling back to exact identity")
  exact.patterns = false
  run Testing.expect(refused(&run ExecutableClosure.select(&exact, &[])),
    "changing a record mode does not silently reinterpret unprojected target identities")
  return ()
}

test effect fn executableClosureRefusesMissingOrAmbiguousEvidence() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run refusalClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn refusalClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut graph = BuildRecord.make(false, true)
  run List<ContentHash>.append(&mut graph.roots, digest(1))
  let mut root = entry(1, true)
  run proof(&mut root, usize.ONE)
  run List<BuildRecord.Entry>.append(&mut graph.entries, move root)
  let mut unfinished = entry(2, false)
  unfinished.leaf = BuildRecord.LEFT
  run List<BuildRecord.Entry>.append(&mut graph.entries, move unfinished)
  run Testing.expect(selected(&run ExecutableClosure.select(&graph, &[]), &[true, false]),
    "known empty executable adjacency is distinct from absent evidence")
  let mut entries1 = List<BuildRecord.Entry>.asMutSlice(&mut graph.entries)
  entries1[0].facts.flags = BuildRecord.FACT_KNOWN
  run Testing.expect(refused(&run ExecutableClosure.select(&graph, &[])),
    "conservative logical traversal cannot select an unfinished body")
  let mut entries2 = List<BuildRecord.Entry>.asMutSlice(&mut graph.entries)
  entries2[1].leaf = 0
  entries2[1].alias = usize.ONE
  run Testing.expect(refused(&run ExecutableClosure.select(&graph, &[])),
    "a selected self-alias cannot masquerade as a complete definition")
  let mut entries3 = List<BuildRecord.Entry>.asMutSlice(&mut graph.entries)
  entries3[1].alias = usize.MAX
  entries3[0].references = List<BuildRecord.Reference>.make()
  run proof(&mut entries3[0], 9)
  run Testing.expect(refused(&run ExecutableClosure.select(&graph, &[])),
    "conservative adjacency refuses out-of-range references")
  let mut entries4 = List<BuildRecord.Entry>.asMutSlice(&mut graph.entries)
  entries4[0].facts.flags = BuildRecord.FACT_KNOWN + BuildRecord.FACT_EXECUTABLES
  run executable(&mut entries4[0], 3, 33)
  run Testing.expect(refused(&run ExecutableClosure.select(&graph, &[])),
    "a known executable target must exist in the admitted graph")
  let mut entries5 = List<BuildRecord.Entry>.asMutSlice(&mut graph.entries)
  entries5[0].facts.executables = List<BuildRecord.Callee>.make()
  run Testing.expect(refused(&run ExecutableClosure.select(&graph, &[digest(3)])),
    "an explicit backend root must exist too")
  run List<BuildRecord.Entry>.append(&mut graph.entries, entry(1, true))
  run Testing.expect(refused(&run ExecutableClosure.select(&graph, &[])),
    "duplicate record identities cannot choose an arbitrary representative")
  return ()
}
