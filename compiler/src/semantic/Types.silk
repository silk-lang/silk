//! The service every compiler type is built through.
//!
//! # Details
//! A build provides one [`TypeTable`] for its whole lifetime, and every type node is made with
//! [`Types.intern`] rather than allocated directly. Routing construction through one table is what
//! lets the table give each distinct type a single shared handle (incremental v2, §3.4).
//!
//! The table also remembers the canonical instance key of each application it has canonicalized
//! ([`Types.canonical`]), so the many call sites that rebuild one callee's application from
//! equal inputs canonicalize it once.

import backend.InstanceKey {InstanceKey, ProviderEntry}
import semantic.InternIndex {InternIndex}
import semantic.Type {Type, Row}
import semantic.Specialization {Application}
import semantic.DeclarationId {DeclarationId}
import semantic.Lifetime {Lifetime}
import silk.collections.list {List}
import silk.collections.hash {Hash}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.num.u64
import silk.num.u32
import silk.num.usize
import silk.core.effect {Effect}

/// Builds the shared handles of compiler types.
pub service Types {
  /// The shared handle of the type `node`.
  effect fn intern(node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the declaration id `value`.
  effect fn internDeclaration(value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the lifetime `value`.
  effect fn internLifetime(value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the row `value`, whose parts are interned.
  effect fn internRow(value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the application `value`.
  effect fn internApplication(value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The canonical key kept for these exact interned application and provider handles.
  effect fn canonical(input: &Interned<Application>, providers: &[ProviderEntry]) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// Keeps `key` for these exact interned inputs. Handle identity is private to the memo;
  /// canonical keys and their published content identities never contain allocation addresses.
  effect fn keepCanonical(input: &Interned<Application>, providers: &[ProviderEntry], key: InstanceKey) -> () ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// A retained snapshot of canonical keys for cross-instance diagnostic proof requests.
  effect fn canonicalKeys() -> List<InstanceKey> ! OutOfMemoryError ? &mut Types | &mut Allocator
}

/// The provider of [`Types`] for one build.
pub struct TypeTable {
  // Exact interned inputs of each canonicalized application, and the key each gave.
  inputs: List<CanonicalInput>,
  keys: List<InstanceKey>,
  lookup: InternIndex,
  // Every distinct type node of the check, which lives as long as the check, and an
  // open-addressed table over them. A slot is empty (0) or holds the high half of the node's intern
  // hash above its position plus one, so a probe reads one array.
  nodes: List<Interned<Type>>,
  slots: List<u64>,
  declarations: InternSet<DeclarationId>,
  lifetimes: InternSet<Lifetime>,
  rows: InternSet<Row>,
  applications: InternSet<Application>,
}

impl TypeTable {
  /// An empty table.
  pub fn make() -> TypeTable {
    return TypeTable {inputs: List<CanonicalInput>.make(), keys: List<InstanceKey>.make(), lookup: InternIndex.make(),
      nodes: List<Interned<Type>>.make(), slots: List<u64>.make(),
      declarations: InternSet<DeclarationId>.make(), lifetimes: InternSet<Lifetime>.make(), rows: InternSet<Row>.make(), applications: InternSet<Application>.make()}
  }

  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Type.internHash(&node)
    let tag = u64.shiftRight(hashed, 32)
    let width = List<u64>.length(&self.slots)
    let mut crowded = false
    if width != usize.ZERO {
      let mask = width - usize.ONE
      let mut at = u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
      let mut scratch = PlainTypes {}
      // Comparisons stop after a few nodes that share the tag, so a crowded run costs a missed
      // share and never a scan of all of them.
      let mut tries = usize.ZERO
      let mut slot = List<u64>.get(&self.slots, at)
      while slot != 0 && tries < 4 {
        if u64.shiftRight(slot, 32) == tag {
          tries = tries + usize.ONE
          let known = &List<Interned<Type>>.asSlice(&self.nodes)[u64.toUsize(u64.bitAnd(slot, 0xFFFFFFFF)) - usize.ONE]
          if run Type.internEquals(&node, known) |> Effect.provideMut<Types>(&mut scratch) { return Interned<Type>.clone(known) }
        }
        at = (at + usize.ONE) & mask
        slot = List<u64>.get(&self.slots, at)
      }
      crowded = tries == 4
    }
    let made = run Interned<Type>.make(move node)
    // Nodes that hash alike but never compare equal would otherwise pile into one run of slots
    // that every probe through it walks, so a node is not recorded once its run already holds
    // enough of them.
    if crowded { return move made }
    run List<Interned<Type>>.append(&mut self.nodes, Interned<Type>.clone(&made))
    run TypeTable.place(&mut self.*, tag, hashed)
    return move made
  }

  // Records the last node, whose intern hash is `hashed`, growing the table to keep it at most
  // half full.
  effect fn place(self: &mut Self, tag: u64, hashed: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = List<Interned<Type>>.length(&self.nodes)
    if count + count > List<u64>.length(&self.slots) { run TypeTable.rebuild(&mut self.*, count) }
    else { TypeTable.put(&mut self.*, tag, hashed, count) }
  }

  fn put(self: &mut Self, tag: u64, hashed: u64, position: usize) -> () {
    let mask = List<u64>.length(&self.slots) - usize.ONE
    let mut at = u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
    while List<u64>.get(&self.slots, at) != 0 { at = (at + usize.ONE) & mask }
    List<u64>.set(&mut self.slots, at, u64.bitOr(u64.shiftLeft(tag, 32), usize.toU64(position)))
  }

  // Sizes the table for `count` nodes and puts every node back.
  effect fn rebuild(self: &mut Self, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut width = usize.ONE
    while width < count * 4 { width = width + width }
    let mut slots = run List<u64>.makeWithCapacity(width)
    run List<u64>.appendRepeated(&mut slots, 0, width)
    self.slots = move slots
    let mut at = usize.ZERO
    while at < List<Interned<Type>>.length(&self.nodes) {
      let hashed = Type.internHash(Interned<Type>.get(&List<Interned<Type>>.asSlice(&self.nodes)[at]))
      TypeTable.put(&mut self.*, u64.shiftRight(hashed, 32), hashed, at + usize.ONE)
      at = at + usize.ONE
    }
  }

  effect fn internDeclaration(self: &mut Self, value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    let hashed = DeclarationId.hash(&value)
    let mut at = InternSet<DeclarationId>.first(&self.declarations, hashed)
    while at != usize.MAX {
      let known = InternSet<DeclarationId>.at(&self.declarations, at)
      if DeclarationId.equals(&value, Interned<DeclarationId>.get(known)) { return Interned<DeclarationId>.clone(known) }
      at = InternSet<DeclarationId>.next(&self.declarations, hashed, at)
    }
    let made = run Interned<DeclarationId>.make(move value)
    run InternSet<DeclarationId>.add(&mut self.declarations, hashed, Interned<DeclarationId>.clone(&made))
    return move made
  }

  effect fn internLifetime(self: &mut Self, value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Lifetime.internHash(&value)
    let mut at = InternSet<Lifetime>.first(&self.lifetimes, hashed)
    while at != usize.MAX {
      let known = InternSet<Lifetime>.at(&self.lifetimes, at)
      if Lifetime.internEquals(&value, known) { return Interned<Lifetime>.clone(known) }
      at = InternSet<Lifetime>.next(&self.lifetimes, hashed, at)
    }
    let made = run Interned<Lifetime>.make(move value)
    run InternSet<Lifetime>.add(&mut self.lifetimes, hashed, Interned<Lifetime>.clone(&made))
    return move made
  }

  effect fn internRow(self: &mut Self, value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Row.internHash(&value)
    let mut at = InternSet<Row>.first(&self.rows, hashed)
    while at != usize.MAX {
      let known = InternSet<Row>.at(&self.rows, at)
      if Row.internEquals(&value, Interned<Row>.get(known)) { return Interned<Row>.clone(known) }
      at = InternSet<Row>.next(&self.rows, hashed, at)
    }
    let made = run Interned<Row>.make(move value)
    run InternSet<Row>.add(&mut self.rows, hashed, Interned<Row>.clone(&made))
    return move made
  }

  effect fn internApplication(self: &mut Self, value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Application.internHash(&value)
    let mut at = InternSet<Application>.first(&self.applications, hashed)
    let mut scratch = PlainTypes {}
    // As for types, a few candidates that share the hash but never match stop the search.
    let mut tries = usize.ZERO
    while at != usize.MAX && tries < 4 {
      tries = tries + usize.ONE
      let known = InternSet<Application>.at(&self.applications, at)
      if Application.sameArgumentHandles(&value, Interned<Application>.get(known)) {
        if run Application.equals(&value, Interned<Application>.get(known)) |> Effect.provideMut<Types>(&mut scratch) {
          if run Application.sameStaticInputs(&value, Interned<Application>.get(known)) { return Interned<Application>.clone(known) }
        }
      }
      at = InternSet<Application>.next(&self.applications, hashed, at)
    }
    if tries == 4 { return run Interned<Application>.make(move value) }
    let made = run Interned<Application>.make(move value)
    run InternSet<Application>.add(&mut self.applications, hashed, Interned<Application>.clone(&made))
    return move made
  }

  effect fn canonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry]) -> Option<InstanceKey>
  ! OutOfMemoryError ? &mut Allocator {
    let mut at = InternIndex.first(&self.lookup, canonicalHash(input, providers))
    while at != usize.MAX {
      if sameCanonicalInput(&List<CanonicalInput>.asSlice(&self.inputs)[at], input, providers) {
        return Option<InstanceKey>.some(InstanceKey.copy(&List<InstanceKey>.asSlice(&self.keys)[at]))
      }
      at = InternIndex.after(&self.lookup, at)
    }
    return Option<InstanceKey>.none()
  }

  effect fn canonicalKeys(self: &mut Self) -> List<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    let mut copied = List<InstanceKey>.make()
    let keys = List<InstanceKey>.asSlice(&self.keys)
    let mut at = usize.ZERO
    while at < keys.length {
      run List<InstanceKey>.append(&mut copied, InstanceKey.copy(&keys[at]))
      at = at + usize.ONE
    }
    return move copied
  }

  effect fn keepCanonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry], key: InstanceKey) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let mut copied = List<ProviderEntry>.make()
    let mut at = usize.ZERO
    while at < providers.length {
      run List<ProviderEntry>.append(&mut copied, ProviderEntry.copy(&providers[at]))
      at = at + usize.ONE
    }
    run List<CanonicalInput>.append(&mut self.inputs, CanonicalInput {application: Interned<Application>.clone(input), providers: move copied})
    run List<InstanceKey>.append(&mut self.keys, move key)
    return run InternIndex.record(&mut self.lookup, canonicalHash(input, providers))
  }
}

// The exact input handles identify one canonicalization request. A missed sharing opportunity
// only canonicalizes again; no structural hash or digest collision can return another input's key.
struct CanonicalInput {
  application: Interned<Application>,
  providers: List<ProviderEntry>,
}

fn canonicalHash(input: &Interned<Application>, providers: &[ProviderEntry]) -> u64 {
  let mut hash = Hash.combine(Hash.mix(&Hash.seed(0), usize.toU64(Interned<Application>.address(input))), usize.toU64(providers.length))
  let mut at = usize.ZERO
  while at < providers.length {
    hash = Hash.combine(hash, usize.toU64(Interned<Type>.address(&providers[at].key.capability)))
    hash = Hash.combine(hash, usize.toU64(Interned<Type>.address(&providers[at].provider)))
    let mut roleAddress = usize.ZERO
    if let Option<Interned<Type>>.Some {value} = &providers[at].key.roleType { roleAddress = Interned<Type>.address(&value) }
    hash = Hash.combine(hash, usize.toU64(roleAddress))
    at = at + usize.ONE
  }
  return hash
}

fn sameCanonicalInput(known: &CanonicalInput, input: &Interned<Application>, providers: &[ProviderEntry]) -> bool {
  if !Interned<Application>.same(&known.application, input) { return false }
  let held = List<ProviderEntry>.asSlice(&known.providers)
  if held.length != providers.length { return false }
  let mut at = usize.ZERO
  while at < providers.length {
    if held[at].key.access != providers[at].key.access
      || !Interned<Type>.same(&held[at].key.capability, &providers[at].key.capability)
      || !Interned<Type>.same(&held[at].provider, &providers[at].provider) { return false }
    match &held[at].key.roleType {
      Option<Interned<Type>>.Some {value} => {
        if let Option<Interned<Type>>.Some {value: other} = &providers[at].key.roleType {
          if !Interned<Type>.same(&value, &other) { return false }
        } else { return false }
      }
      Option<Interned<Type>>.None => { if let Option<Interned<Type>>.Some {..} = &providers[at].key.roleType { return false } }
    }
    at = at + usize.ONE
  }
  return true
}

// The types an intern comparison builds while it runs: never shared, and with no canonical keys,
// as an empty table would give, but with nothing to make or drop.
struct PlainTypes {}

impl PlainTypes {
  effect fn canonicalKeys(self: &mut Self) -> List<InstanceKey> ! OutOfMemoryError ? &mut Allocator { return List<InstanceKey>.make() }

  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Type>.make(move node)
  }

  effect fn canonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry]) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    return Option<InstanceKey>.none()
  }

  effect fn keepCanonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry], key: InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    return ()
  }
}

impl PlainTypes {
  effect fn internDeclaration(self: &mut Self, value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<DeclarationId>.make(move value)
  }

  effect fn internLifetime(self: &mut Self, value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Lifetime>.make(move value)
  }

  effect fn internRow(self: &mut Self, value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Row>.make(move value)
  }

  effect fn internApplication(self: &mut Self, value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Application>.make(move value)
  }
}

impl Types for PlainTypes {
  internDeclaration: PlainTypes.internDeclaration
  internLifetime: PlainTypes.internLifetime
  internRow: PlainTypes.internRow
  internApplication: PlainTypes.internApplication
  intern: PlainTypes.intern
  canonical: PlainTypes.canonical
  keepCanonical: PlainTypes.keepCanonical
  canonicalKeys: PlainTypes.canonicalKeys
}

impl Types for TypeTable {
  internDeclaration: TypeTable.internDeclaration
  internLifetime: TypeTable.internLifetime
  internRow: TypeTable.internRow
  internApplication: TypeTable.internApplication
  intern: TypeTable.intern
  canonical: TypeTable.canonical
  keepCanonical: TypeTable.keepCanonical
  canonicalKeys: TypeTable.canonicalKeys
}


// An open-addressed set of permanent handles keyed by a 64-bit hash, kept at most half full.
struct InternSet<T> {
  handles: List<Interned<T>>,
  hashes: List<u64>,
  slots: List<u32>,
}

impl<T> InternSet<T> {
  fn make() -> InternSet<T> {
    return InternSet<T> {handles: List<Interned<T>>.make(), hashes: List<u64>.make(), slots: List<u32>.make()}
  }

  fn bucket(hashed: u64, mask: usize) -> usize {
    return u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
  }

  // The position of the first handle whose hash is `hashed`, or usize.MAX. The probe position is
  // returned through `next`, so a caller walks every candidate with `first` then `next`.
  fn first(self: &Self, hashed: u64) -> usize {
    let width = List<u32>.length(&self.slots)
    if width == usize.ZERO { return usize.MAX }
    return InternSet<T>.scan(self, hashed, InternSet<T>.bucket(hashed, width - usize.ONE))
  }

  fn next(self: &Self, hashed: u64, slot: usize) -> usize {
    let mask = List<u32>.length(&self.slots) - usize.ONE
    return InternSet<T>.scan(self, hashed, (slot + usize.ONE) & mask)
  }

  // From slot `start`, the first slot holding a handle with hash `hashed`, or usize.MAX at an empty one.
  fn scan(self: &Self, hashed: u64, start: usize) -> usize {
    let mask = List<u32>.length(&self.slots) - usize.ONE
    let mut slot = start
    let mut entry = List<u32>.get(&self.slots, slot)
    while entry != 0 {
      if List<u64>.get(&self.hashes, u32.toUsize(entry) - usize.ONE) == hashed { return slot }
      slot = (slot + usize.ONE) & mask
      entry = List<u32>.get(&self.slots, slot)
    }
    return usize.MAX
  }

  fn at(self: &Self, slot: usize) -> &Interned<T> {
    let entry = List<u32>.get(&self.slots, slot)
    return &List<Interned<T>>.asSlice(&self.handles)[u32.toUsize(entry) - usize.ONE]
  }

  effect fn add(self: &mut Self, hashed: u64, handle: Interned<T>) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Interned<T>>.append(&mut self.handles, move handle)
    run List<u64>.append(&mut self.hashes, hashed)
    let count = List<Interned<T>>.length(&self.handles)
    if count + count > List<u32>.length(&self.slots) {
      let mut width = usize.ONE
      while width < count * 4 { width = width + width }
      let mut slots = run List<u32>.makeWithCapacity(width)
      run List<u32>.appendRepeated(&mut slots, 0, width)
      self.slots = move slots
      let mut at = usize.ZERO
      while at < count {
        let stored = List<u64>.get(&self.hashes, at)
        InternSet<T>.put(&mut self.*, stored, at + usize.ONE)
        at = at + usize.ONE
      }
    } else {
      InternSet<T>.put(&mut self.*, hashed, count)
    }
  }

  fn put(self: &mut Self, hashed: u64, position: usize) -> () {
    let mask = List<u32>.length(&self.slots) - usize.ONE
    let mut slot = InternSet<T>.bucket(hashed, mask)
    while List<u32>.get(&self.slots, slot) != 0 { slot = (slot + usize.ONE) & mask }
    List<u32>.set(&mut self.slots, slot, usize.toU32(position))
  }
}
