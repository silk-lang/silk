//! The service every compiler type is built through.
//!
//! # Details
//! A build provides one [`TypeTable`] for its whole lifetime, and every type node is made with
//! [`Types.intern`] rather than allocated directly. Routing construction through one table is what
//! lets the table give each distinct type a single shared handle (incremental v2, §3.4).
//!
//! The table also remembers the canonical instance key of each application it has canonicalized
//! ([`Types.canonical`]), so the many call sites that rebuild one callee's application from
//! equal inputs canonicalize it once.

import backend.InstanceKey {InstanceKey}
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.Type {Type}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.num.u64
import silk.num.usize
import silk.core.effect {Effect}

/// Builds the shared handles of compiler types.
pub service Types {
  /// The shared handle of the type `node`.
  effect fn intern(node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The canonical key kept for the application whose exact input encoding has digest `input`.
  effect fn canonical(input: ContentHash) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// Keeps `key` as the canonical key of the application whose exact input encoding has digest
  /// `input`.
  effect fn keepCanonical(input: ContentHash, key: InstanceKey) -> () ! OutOfMemoryError ? &mut Types | &mut Allocator
}

/// The provider of [`Types`] for one build.
pub struct TypeTable {
  // Digests of canonicalized applications' exact input encodings, and the key each gave.
  inputs: List<ContentHash>,
  keys: List<InstanceKey>,
  lookup: InternIndex,
  // Every distinct type node of the check, which lives as long as the check, and an
  // open-addressed table over them. A slot is empty (0) or holds the high half of the node's intern
  // hash above its position plus one, so a probe reads one array.
  nodes: List<Interned<Type>>,
  slots: List<u64>,
}

impl TypeTable {
  /// An empty table.
  pub fn make() -> TypeTable {
    return TypeTable {inputs: List<ContentHash>.make(), keys: List<InstanceKey>.make(), lookup: InternIndex.make(),
      nodes: List<Interned<Type>>.make(), slots: List<u64>.make()}
  }

  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Type.internHash(&node)
    let tag = u64.shiftRight(hashed, 32)
    let width = List<u64>.length(&self.slots)
    let mut crowded = false
    if width != usize.ZERO {
      let mask = width - usize.ONE
      let mut at = u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
      let mut scratch = PlainTypes {}
      // Comparisons stop after a few nodes that share the tag, so a crowded run costs a missed
      // share and never a scan of all of them.
      let mut tries = usize.ZERO
      let mut slot = List<u64>.get(&self.slots, at)
      while slot != 0 && tries < 4 {
        if u64.shiftRight(slot, 32) == tag {
          tries = tries + usize.ONE
          let known = &List<Interned<Type>>.asSlice(&self.nodes)[u64.toUsize(u64.bitAnd(slot, 0xFFFFFFFF)) - usize.ONE]
          if run Type.internEquals(&node, known) |> Effect.provideMut<Types>(&mut scratch) { return Interned<Type>.clone(known) }
        }
        at = (at + usize.ONE) & mask
        slot = List<u64>.get(&self.slots, at)
      }
      crowded = tries == 4
    }
    let made = run Interned<Type>.make(move node)
    // Nodes that hash alike but never compare equal would otherwise pile into one run of slots
    // that every probe through it walks, so a node is not recorded once its run already holds
    // enough of them.
    if crowded { return move made }
    run List<Interned<Type>>.append(&mut self.nodes, Interned<Type>.clone(&made))
    run TypeTable.place(&mut self.*, tag, hashed)
    return move made
  }

  // Records the last node, whose intern hash is `hashed`, growing the table to keep it at most
  // half full.
  effect fn place(self: &mut Self, tag: u64, hashed: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = List<Interned<Type>>.length(&self.nodes)
    if count + count > List<u64>.length(&self.slots) { run TypeTable.rebuild(&mut self.*, count) }
    else { TypeTable.put(&mut self.*, tag, hashed, count) }
  }

  fn put(self: &mut Self, tag: u64, hashed: u64, position: usize) -> () {
    let mask = List<u64>.length(&self.slots) - usize.ONE
    let mut at = u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
    while List<u64>.get(&self.slots, at) != 0 { at = (at + usize.ONE) & mask }
    List<u64>.set(&mut self.slots, at, u64.bitOr(u64.shiftLeft(tag, 32), usize.toU64(position)))
  }

  // Sizes the table for `count` nodes and puts every node back.
  effect fn rebuild(self: &mut Self, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut width = usize.ONE
    while width < count * 4 { width = width + width }
    let mut slots = run List<u64>.makeWithCapacity(width)
    run List<u64>.appendRepeated(&mut slots, 0, width)
    self.slots = move slots
    let mut at = usize.ZERO
    while at < List<Interned<Type>>.length(&self.nodes) {
      let hashed = Type.internHash(Interned<Type>.get(&List<Interned<Type>>.asSlice(&self.nodes)[at]))
      TypeTable.put(&mut self.*, u64.shiftRight(hashed, 32), hashed, at + usize.ONE)
      at = at + usize.ONE
    }
  }

  effect fn canonical(self: &mut Self, input: ContentHash) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    let mut at = InternIndex.first(&self.lookup, input.high)
    while at != usize.MAX {
      if ContentHash.equals(List<ContentHash>.get(&self.inputs, at), input) {
        return Option<InstanceKey>.some(InstanceKey.copy(&List<InstanceKey>.asSlice(&self.keys)[at]))
      }
      at = InternIndex.after(&self.lookup, at)
    }
    return Option<InstanceKey>.none()
  }

  effect fn keepCanonical(self: &mut Self, input: ContentHash, key: InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<ContentHash>.append(&mut self.inputs, input)
    run List<InstanceKey>.append(&mut self.keys, move key)
    return run InternIndex.record(&mut self.lookup, input.high)
  }
}

// The types an intern comparison builds while it runs: never shared, and with no canonical keys,
// as an empty table would give, but with nothing to make or drop.
struct PlainTypes {}

impl PlainTypes {
  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Type>.make(move node)
  }

  effect fn canonical(self: &mut Self, input: ContentHash) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    return Option<InstanceKey>.none()
  }

  effect fn keepCanonical(self: &mut Self, input: ContentHash, key: InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    return ()
  }
}

impl Types for PlainTypes {
  intern: PlainTypes.intern
  canonical: PlainTypes.canonical
  keepCanonical: PlainTypes.keepCanonical
}

impl Types for TypeTable {
  intern: TypeTable.intern
  canonical: TypeTable.canonical
  keepCanonical: TypeTable.keepCanonical
}

