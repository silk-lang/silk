//! The service every compiler type is built through.
//!
//! # Details
//! A build provides one [`TypeTable`] for its whole lifetime, and every type node is made with
//! [`Types.intern`] rather than allocated directly. Routing construction through one table is what
//! lets the table give each distinct type a single shared handle (incremental v2, §3.4).
//!
//! The table also remembers the canonical instance key of each application it has canonicalized
//! ([`Types.canonical`]), so the many call sites that rebuild one callee's application from
//! equal inputs canonicalize it once.

import backend.InstanceKey {InstanceKey}
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.Type {Type}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.frozen {Frozen}
import silk.num.usize
import silk.core.effect {Effect}

/// Builds the shared handles of compiler types.
pub service Types {
  /// The shared handle of the type `node`.
  effect fn intern(node: Type) -> Frozen<Type> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The canonical key kept for the application whose exact input encoding has digest `input`.
  effect fn canonical(input: ContentHash) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// Keeps `key` as the canonical key of the application whose exact input encoding has digest
  /// `input`.
  effect fn keepCanonical(input: ContentHash, key: InstanceKey) -> () ! OutOfMemoryError ? &mut Types | &mut Allocator
}

/// The provider of [`Types`] for one build.
pub struct TypeTable {
  // Digests of canonicalized applications' exact input encodings, and the key each gave.
  inputs: List<ContentHash>,
  keys: List<InstanceKey>,
  lookup: InternIndex,
  // The distinct type nodes alive, their intern hashes in the same order, and the length at
  // which the next sweep drops the nodes only this table still holds.
  nodes: List<Frozen<Type>>,
  hashes: List<u64>,
  nodeLookup: InternIndex,
  sweepAt: usize,
}

// The fewest nodes a table holds before its first sweep.
const FIRST_SWEEP: usize = 65536

impl TypeTable {
  /// An empty table.
  pub fn make() -> TypeTable {
    return TypeTable {inputs: List<ContentHash>.make(), keys: List<InstanceKey>.make(), lookup: InternIndex.make(),
      nodes: List<Frozen<Type>>.make(), hashes: List<u64>.make(), nodeLookup: InternIndex.make(), sweepAt: FIRST_SWEEP}
  }

  effect fn intern(self: &mut Self, node: Type) -> Frozen<Type> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Type.internHash(&node)
    let mut at = InternIndex.first(&self.nodeLookup, hashed)
    if at != usize.MAX {
      let mut scratch = TypeTable.make()
      // A chain longer than this holds nodes that share a hash but rarely an identity, so a miss
      // there costs a share and never a scan of all of them.
      let mut tries = usize.ZERO
      while at != usize.MAX && tries < 4 {
        tries = tries + usize.ONE
        let known = &List<Frozen<Type>>.asSlice(&self.nodes)[at]
        if run Type.internEquals(&node, known) |> Effect.provideMut<Types>(&mut scratch) { return Frozen<Type>.clone(known) }
        at = InternIndex.after(&self.nodeLookup, at)
      }
    }
    let made = run Frozen<Type>.make(move node)
    if List<Frozen<Type>>.length(&self.nodes) >= self.sweepAt { run TypeTable.sweep(&mut self.*) }
    run List<Frozen<Type>>.append(&mut self.nodes, Frozen<Type>.clone(&made))
    run List<u64>.append(&mut self.hashes, hashed)
    run InternIndex.record(&mut self.nodeLookup, hashed)
    return move made
  }

  // Drops the nodes no handle outside the table holds, so the table never keeps a type alive. A
  // node a live type contains is held by that type, so the hashes of live nodes stay valid. The
  // next sweep waits until the table has doubled, so sweeping costs a constant share per node.
  effect fn sweep(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut nodes = Intrinsic.replace(self.nodes, List<Frozen<Type>>.make())
    let mut hashes = Intrinsic.replace(self.hashes, List<u64>.make())
    self.nodeLookup = InternIndex.make()
    // Taken from the end and then put back, so the kept nodes keep their order.
    let mut keptNodes = List<Frozen<Type>>.make()
    let mut keptHashes = List<u64>.make()
    while let Option<Frozen<Type>>.Some {value: node} = List<Frozen<Type>>.pop(&mut nodes) {
      let hashed = match List<u64>.pop(&mut hashes) {
        Option<u64>.Some {value} => value
        Option<u64>.None => usize.toU64(usize.ZERO)
      }
      if Frozen<Type>.count(&node) > usize.ONE {
        run List<Frozen<Type>>.append(&mut keptNodes, move node)
        run List<u64>.append(&mut keptHashes, hashed)
      }
    }
    while let Option<Frozen<Type>>.Some {value: node} = List<Frozen<Type>>.pop(&mut keptNodes) {
      let hashed = match List<u64>.pop(&mut keptHashes) {
        Option<u64>.Some {value} => value
        Option<u64>.None => usize.toU64(usize.ZERO)
      }
      run List<Frozen<Type>>.append(&mut self.nodes, move node)
      run List<u64>.append(&mut self.hashes, hashed)
      run InternIndex.record(&mut self.nodeLookup, hashed)
    }
    let kept = List<Frozen<Type>>.length(&self.nodes)
    self.sweepAt = kept + kept
    if self.sweepAt < FIRST_SWEEP { self.sweepAt = FIRST_SWEEP }
  }

  effect fn canonical(self: &mut Self, input: ContentHash) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    let mut at = InternIndex.first(&self.lookup, input.high)
    while at != usize.MAX {
      if ContentHash.equals(List<ContentHash>.get(&self.inputs, at), input) {
        return Option<InstanceKey>.some(InstanceKey.copy(&List<InstanceKey>.asSlice(&self.keys)[at]))
      }
      at = InternIndex.after(&self.lookup, at)
    }
    return Option<InstanceKey>.none()
  }

  effect fn keepCanonical(self: &mut Self, input: ContentHash, key: InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<ContentHash>.append(&mut self.inputs, input)
    run List<InstanceKey>.append(&mut self.keys, move key)
    return run InternIndex.record(&mut self.lookup, input.high)
  }
}

impl Types for TypeTable {
  intern: TypeTable.intern
  canonical: TypeTable.canonical
  keepCanonical: TypeTable.keepCanonical
}

