//! The service every compiler type is built through.
//!
//! # Details
//! A build provides one [`TypeTable`] for its whole lifetime, and every type node is made with
//! [`Types.intern`] rather than allocated directly. Routing construction through one table is what
//! lets the table give each distinct type a single shared handle (incremental v2, §3.4).
//!
//! The table also remembers the canonical instance key of each application it has canonicalized
//! ([`Types.canonical`]), so the many call sites that rebuild one callee's application from
//! equal inputs canonicalize it once.

import backend.InstanceKey {InstanceKey, ProviderEntry}
import semantic.Published {Published}
import silk.concurrency.sync {Mutex}
import semantic.InternIndex {InternIndex}
import semantic.Type {Type, Row, Argument}
import semantic.Specialization {Application, Target, ScopeBinding, StaticSlot}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Lifetime {Lifetime}
import silk.collections.list {List}
import silk.collections.bytes {Bytes}
import silk.testing.testing {Testing, AssertionError}
import silk.collections.hash {Hash}
import silk.core.option {Option}
import silk.core.ownership {Drop}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.interned {Interned}
import silk.num.u64
import silk.num.u32
import silk.num.usize
import silk.core.effect {Effect}

/// Builds the shared handles of compiler types.
pub service Types {
  /// The shared handle of the type `node`.
  effect fn intern(node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the declaration id `value`.
  effect fn internDeclaration(value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the lifetime `value`.
  effect fn internLifetime(value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the row `value`, whose parts are interned.
  effect fn internRow(value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The shared handle of the application `value`.
  effect fn internApplication(value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// The canonical key kept for these exact interned application and provider handles.
  effect fn canonical(input: &Interned<Application>, providers: &[ProviderEntry]) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// Keeps `key` for these exact interned inputs. Handle identity is private to the memo;
  /// canonical keys and their published content identities never contain allocation addresses.
  effect fn keepCanonical(input: &Interned<Application>, providers: &[ProviderEntry], key: InstanceKey) -> () ! OutOfMemoryError ? &mut Types | &mut Allocator
  /// A retained snapshot of canonical keys for cross-instance diagnostic proof requests.
  effect fn canonicalKeys() -> List<InstanceKey> ! OutOfMemoryError ? &mut Types | &mut Allocator
}

/// The provider of [`Types`] for one build.
pub struct TypeTable {
  // Exact interned inputs of each canonicalized application, and the key each gave.
  inputs: List<CanonicalInput>,
  keys: List<InstanceKey>,
  lookup: InternIndex,
  pool: InternPool,
}

// Structural immutable values only. Mutable backend canonicalization caches stay local.
struct InternPool {
  // Every distinct type node of the check, which lives as long as the check, and an
  // open-addressed table over them. A slot is empty (0) or holds the high half of the node's intern
  // hash above its position plus one, so a probe reads one array.
  nodes: List<Interned<Type>>,
  slots: List<u64>,
  declarations: InternSet<DeclarationId>,
  lifetimes: InternSet<Lifetime>,
  rows: InternSet<Row>,
  applications: InternSet<Application>,
}

impl TypeTable {
  /// An empty table.
  pub fn make() -> TypeTable {
    return TypeTable {inputs: List<CanonicalInput>.make(), keys: List<InstanceKey>.make(), lookup: InternIndex.make(),
      pool: InternPool.make()}
  }

  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    return run InternPool.intern(&mut self.pool, move node)
  }
  effect fn internDeclaration(self: &mut Self, value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    return run InternPool.internDeclaration(&mut self.pool, move value)
  }
  effect fn internLifetime(self: &mut Self, value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Allocator {
    return run InternPool.internLifetime(&mut self.pool, move value)
  }
  effect fn internRow(self: &mut Self, value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Allocator {
    return run InternPool.internRow(&mut self.pool, move value)
  }
  effect fn internApplication(self: &mut Self, value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Allocator {
    return run InternPool.internApplication(&mut self.pool, move value)
  }

  effect fn canonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry]) -> Option<InstanceKey>
  ! OutOfMemoryError ? &mut Allocator {
    let mut at = InternIndex.first(&self.lookup, canonicalHash(input, providers))
    while at != usize.MAX {
      if sameCanonicalInput(&List<CanonicalInput>.asSlice(&self.inputs)[at], input, providers) {
        return Option<InstanceKey>.some(InstanceKey.copy(&List<InstanceKey>.asSlice(&self.keys)[at]))
      }
      at = InternIndex.after(&self.lookup, at)
    }
    return Option<InstanceKey>.none()
  }

  effect fn canonicalKeys(self: &mut Self) -> List<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    let mut copied = List<InstanceKey>.make()
    let keys = List<InstanceKey>.asSlice(&self.keys)
    let mut at = usize.ZERO
    while at < keys.length {
      run List<InstanceKey>.append(&mut copied, InstanceKey.copy(&keys[at]))
      at = at + usize.ONE
    }
    return move copied
  }

  effect fn keepCanonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry], key: InstanceKey) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let mut copied = List<ProviderEntry>.make()
    let mut at = usize.ZERO
    while at < providers.length {
      run List<ProviderEntry>.append(&mut copied, ProviderEntry.copy(&providers[at]))
      at = at + usize.ONE
    }
    run List<CanonicalInput>.append(&mut self.inputs, CanonicalInput {application: Interned<Application>.clone(input), providers: move copied})
    run List<InstanceKey>.append(&mut self.keys, move key)
    return run InternIndex.record(&mut self.lookup, canonicalHash(input, providers))
  }
}

impl InternPool {
  fn make() -> Self {
    return Self {nodes: List<Interned<Type>>.make(), slots: List<u64>.make(),
      declarations: InternSet<DeclarationId>.make(), lifetimes: InternSet<Lifetime>.make(),
      rows: InternSet<Row>.make(), applications: InternSet<Application>.make()}
  }
  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Type.internHash(&node)
    let tag = u64.shiftRight(hashed, 32)
    let width = List<u64>.length(&self.slots)
    let mut crowded = false
    if width != usize.ZERO {
      let mask = width - usize.ONE
      let mut at = u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
      let mut scratch = PlainTypes {}
      // Comparisons stop after a few nodes that share the tag, so a crowded run costs a missed
      // share and never a scan of all of them.
      let mut tries = usize.ZERO
      let mut slot = List<u64>.get(&self.slots, at)
      while slot != 0 && tries < 4 {
        if u64.shiftRight(slot, 32) == tag {
          tries = tries + usize.ONE
          let known = &List<Interned<Type>>.asSlice(&self.nodes)[u64.toUsize(u64.bitAnd(slot, 0xFFFFFFFF)) - usize.ONE]
          if run Type.internEquals(&node, known) |> Effect.provideMut<Types>(&mut scratch) { return Interned<Type>.clone(known) }
        }
        at = (at + usize.ONE) & mask
        slot = List<u64>.get(&self.slots, at)
      }
      crowded = tries == 4
    }
    let made = run Interned<Type>.make(move node)
    // Nodes that hash alike but never compare equal would otherwise pile into one run of slots
    // that every probe through it walks, so a node is not recorded once its run already holds
    // enough of them.
    if crowded { return move made }
    run List<Interned<Type>>.append(&mut self.nodes, Interned<Type>.clone(&made))
    run InternPool.place(&mut self.*, tag, hashed)
    return move made
  }

  // Records the last node, whose intern hash is `hashed`, growing the table to keep it at most
  // half full.
  effect fn place(self: &mut Self, tag: u64, hashed: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = List<Interned<Type>>.length(&self.nodes)
    if count + count > List<u64>.length(&self.slots) { run InternPool.rebuild(&mut self.*, count) }
    else { InternPool.put(&mut self.*, tag, hashed, count) }
  }

  fn put(self: &mut Self, tag: u64, hashed: u64, position: usize) -> () {
    let mask = List<u64>.length(&self.slots) - usize.ONE
    let mut at = u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
    while List<u64>.get(&self.slots, at) != 0 { at = (at + usize.ONE) & mask }
    List<u64>.set(&mut self.slots, at, u64.bitOr(u64.shiftLeft(tag, 32), usize.toU64(position)))
  }

  // Sizes the table for `count` nodes and puts every node back.
  effect fn rebuild(self: &mut Self, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut width = usize.ONE
    while width < count * 4 { width = width + width }
    let mut slots = run List<u64>.makeWithCapacity(width)
    run List<u64>.appendRepeated(&mut slots, 0, width)
    self.slots = move slots
    let mut at = usize.ZERO
    while at < List<Interned<Type>>.length(&self.nodes) {
      let hashed = Type.internHash(Interned<Type>.get(&List<Interned<Type>>.asSlice(&self.nodes)[at]))
      InternPool.put(&mut self.*, u64.shiftRight(hashed, 32), hashed, at + usize.ONE)
      at = at + usize.ONE
    }
  }

  effect fn internDeclaration(self: &mut Self, value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    let hashed = DeclarationId.hash(&value)
    let mut at = InternSet<DeclarationId>.first(&self.declarations, hashed)
    while at != usize.MAX {
      let known = InternSet<DeclarationId>.at(&self.declarations, at)
      if DeclarationId.equals(&value, Interned<DeclarationId>.get(known)) { return Interned<DeclarationId>.clone(known) }
      at = InternSet<DeclarationId>.next(&self.declarations, hashed, at)
    }
    let made = run Interned<DeclarationId>.make(move value)
    run InternSet<DeclarationId>.add(&mut self.declarations, hashed, Interned<DeclarationId>.clone(&made))
    return move made
  }

  effect fn internLifetime(self: &mut Self, value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Lifetime.internHash(&value)
    let mut at = InternSet<Lifetime>.first(&self.lifetimes, hashed)
    while at != usize.MAX {
      let known = InternSet<Lifetime>.at(&self.lifetimes, at)
      if Lifetime.internEquals(&value, known) { return Interned<Lifetime>.clone(known) }
      at = InternSet<Lifetime>.next(&self.lifetimes, hashed, at)
    }
    let made = run Interned<Lifetime>.make(move value)
    run InternSet<Lifetime>.add(&mut self.lifetimes, hashed, Interned<Lifetime>.clone(&made))
    return move made
  }

  effect fn internRow(self: &mut Self, value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Row.internHash(&value)
    let mut at = InternSet<Row>.first(&self.rows, hashed)
    while at != usize.MAX {
      let known = InternSet<Row>.at(&self.rows, at)
      if Row.internEquals(&value, Interned<Row>.get(known)) { return Interned<Row>.clone(known) }
      at = InternSet<Row>.next(&self.rows, hashed, at)
    }
    let made = run Interned<Row>.make(move value)
    run InternSet<Row>.add(&mut self.rows, hashed, Interned<Row>.clone(&made))
    return move made
  }

  effect fn internApplication(self: &mut Self, value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Application.internHash(&value)
    let mut at = InternSet<Application>.first(&self.applications, hashed)
    let mut scratch = PlainTypes {}
    // As for types, a few candidates that share the hash but never match stop the search.
    let mut tries = usize.ZERO
    while at != usize.MAX && tries < 4 {
      tries = tries + usize.ONE
      let known = InternSet<Application>.at(&self.applications, at)
      if Application.sameArgumentHandles(&value, Interned<Application>.get(known)) {
        if run Application.equals(&value, Interned<Application>.get(known)) |> Effect.provideMut<Types>(&mut scratch) {
          if run Application.sameStaticInputs(&value, Interned<Application>.get(known)) { return Interned<Application>.clone(known) }
        }
      }
      at = InternSet<Application>.next(&self.applications, hashed, at)
    }
    if tries == 4 { return run Interned<Application>.make(move value) }
    let made = run Interned<Application>.make(move value)
    run InternSet<Application>.add(&mut self.applications, hashed, Interned<Application>.clone(&made))
    return move made
  }

}

// The exact input handles identify one canonicalization request. A missed sharing opportunity
// only canonicalizes again; no structural hash or digest collision can return another input's key.
struct CanonicalInput {
  application: Interned<Application>,
  providers: List<ProviderEntry>,
}

fn canonicalHash(input: &Interned<Application>, providers: &[ProviderEntry]) -> u64 {
  let mut hash = Hash.combine(Hash.mix(&Hash.seed(0), usize.toU64(Interned<Application>.address(input))), usize.toU64(providers.length))
  let mut at = usize.ZERO
  while at < providers.length {
    hash = Hash.combine(hash, usize.toU64(Interned<Type>.address(&providers[at].key.capability)))
    hash = Hash.combine(hash, usize.toU64(Interned<Type>.address(&providers[at].provider)))
    let mut roleAddress = usize.ZERO
    if let Option<Interned<Type>>.Some {value} = &providers[at].key.roleType { roleAddress = Interned<Type>.address(&value) }
    hash = Hash.combine(hash, usize.toU64(roleAddress))
    at = at + usize.ONE
  }
  return hash
}

fn sameCanonicalInput(known: &CanonicalInput, input: &Interned<Application>, providers: &[ProviderEntry]) -> bool {
  if !Interned<Application>.same(&known.application, input) { return false }
  let held = List<ProviderEntry>.asSlice(&known.providers)
  if held.length != providers.length { return false }
  let mut at = usize.ZERO
  while at < providers.length {
    if held[at].key.access != providers[at].key.access
      || !Interned<Type>.same(&held[at].key.capability, &providers[at].key.capability)
      || !Interned<Type>.same(&held[at].provider, &providers[at].provider) { return false }
    match &held[at].key.roleType {
      Option<Interned<Type>>.Some {value} => {
        if let Option<Interned<Type>>.Some {value: other} = &providers[at].key.roleType {
          if !Interned<Type>.same(&value, &other) { return false }
        } else { return false }
      }
      Option<Interned<Type>>.None => { if let Option<Interned<Type>>.Some {..} = &providers[at].key.roleType { return false } }
    }
    at = at + usize.ONE
  }
  return true
}

// The types an intern comparison builds while it runs: never shared, and with no canonical keys,
// as an empty table would give, but with nothing to make or drop.
struct PlainTypes {}

impl PlainTypes {
  effect fn canonicalKeys(self: &mut Self) -> List<InstanceKey> ! OutOfMemoryError ? &mut Allocator { return List<InstanceKey>.make() }

  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Type>.make(move node)
  }

  effect fn canonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry]) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
    return Option<InstanceKey>.none()
  }

  effect fn keepCanonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry], key: InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    return ()
  }
}

impl PlainTypes {
  effect fn internDeclaration(self: &mut Self, value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<DeclarationId>.make(move value)
  }

  effect fn internLifetime(self: &mut Self, value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Lifetime>.make(move value)
  }

  effect fn internRow(self: &mut Self, value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Row>.make(move value)
  }

  effect fn internApplication(self: &mut Self, value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Allocator {
    return run Interned<Application>.make(move value)
  }
}

impl Types for PlainTypes {
  internDeclaration: PlainTypes.internDeclaration
  internLifetime: PlainTypes.internLifetime
  internRow: PlainTypes.internRow
  internApplication: PlainTypes.internApplication
  intern: PlainTypes.intern
  canonical: PlainTypes.canonical
  keepCanonical: PlainTypes.keepCanonical
  canonicalKeys: PlainTypes.canonicalKeys
}

impl Types for TypeTable {
  internDeclaration: TypeTable.internDeclaration
  internLifetime: TypeTable.internLifetime
  internRow: TypeTable.internRow
  internApplication: TypeTable.internApplication
  intern: TypeTable.intern
  canonical: TypeTable.canonical
  keepCanonical: TypeTable.keepCanonical
  canonicalKeys: TypeTable.canonicalKeys
}


// An open-addressed set of permanent handles keyed by a 64-bit hash, kept at most half full.
struct InternSet<T> {
  handles: List<Interned<T>>,
  hashes: List<u64>,
  slots: List<u32>,
}

impl<T> InternSet<T> {
  fn make() -> InternSet<T> {
    return InternSet<T> {handles: List<Interned<T>>.make(), hashes: List<u64>.make(), slots: List<u32>.make()}
  }

  fn bucket(hashed: u64, mask: usize) -> usize {
    return u64.toUsize(u64.bitAnd(u64.shiftRight(u64.wrappingMultiply(hashed, 0x9E3779B97F4A7C15), 29), usize.toU64(mask)))
  }

  // The position of the first handle whose hash is `hashed`, or usize.MAX. The probe position is
  // returned through `next`, so a caller walks every candidate with `first` then `next`.
  fn first(self: &Self, hashed: u64) -> usize {
    let width = List<u32>.length(&self.slots)
    if width == usize.ZERO { return usize.MAX }
    return InternSet<T>.scan(self, hashed, InternSet<T>.bucket(hashed, width - usize.ONE))
  }

  fn next(self: &Self, hashed: u64, slot: usize) -> usize {
    let mask = List<u32>.length(&self.slots) - usize.ONE
    return InternSet<T>.scan(self, hashed, (slot + usize.ONE) & mask)
  }

  // From slot `start`, the first slot holding a handle with hash `hashed`, or usize.MAX at an empty one.
  fn scan(self: &Self, hashed: u64, start: usize) -> usize {
    let mask = List<u32>.length(&self.slots) - usize.ONE
    let mut slot = start
    let mut entry = List<u32>.get(&self.slots, slot)
    while entry != 0 {
      if List<u64>.get(&self.hashes, u32.toUsize(entry) - usize.ONE) == hashed { return slot }
      slot = (slot + usize.ONE) & mask
      entry = List<u32>.get(&self.slots, slot)
    }
    return usize.MAX
  }

  fn at(self: &Self, slot: usize) -> &Interned<T> {
    let entry = List<u32>.get(&self.slots, slot)
    return &List<Interned<T>>.asSlice(&self.handles)[u32.toUsize(entry) - usize.ONE]
  }

  effect fn add(self: &mut Self, hashed: u64, handle: Interned<T>) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Interned<T>>.append(&mut self.handles, move handle)
    run List<u64>.append(&mut self.hashes, hashed)
    let count = List<Interned<T>>.length(&self.handles)
    if count + count > List<u32>.length(&self.slots) {
      let mut width = usize.ONE
      while width < count * 4 { width = width + width }
      let mut slots = run List<u32>.makeWithCapacity(width)
      run List<u32>.appendRepeated(&mut slots, 0, width)
      self.slots = move slots
      let mut at = usize.ZERO
      while at < count {
        let stored = List<u64>.get(&self.hashes, at)
        InternSet<T>.put(&mut self.*, stored, at + usize.ONE)
        at = at + usize.ONE
      }
    } else {
      InternSet<T>.put(&mut self.*, hashed, count)
    }
  }

  fn put(self: &mut Self, hashed: u64, position: usize) -> () {
    let mask = List<u32>.length(&self.slots) - usize.ONE
    let mut slot = InternSet<T>.bucket(hashed, mask)
    while List<u32>.get(&self.slots, slot) != 0 { slot = (slot + usize.ONE) & mask }
    List<u32>.set(&mut self.slots, slot, usize.toU32(position))
  }
}

// A candidate allocation remains unpublished until a table entry is installed. A racing loser
// or an allocation failure destroys it only after all table guards have been dropped.
struct InternCandidate<T> { value: Option<Interned<T>> }
impl<T> InternCandidate<T> {
  effect fn make(value: T) -> Self ! OutOfMemoryError ? &mut Allocator {
    return Self {value: Option<Interned<T>>.some(run Interned<T>.make(move value))}
  }
  fn get(self: &Self) -> &Interned<T> {
    return match &self.value {
      Option<Interned<T>>.Some {value} => &value
      _ => Intrinsic.trap("an intern candidate is consumed once")
    }
  }
  fn release(self: &mut Self) -> Interned<T> {
    return match move Intrinsic.replace(self.value, Option<Interned<T>>.none()) {
      Option<Interned<T>>.Some {value} => move value
      _ => Intrinsic.trap("an intern candidate is consumed once")
    }
  }
}
impl<T> Drop for InternCandidate<T> {
  fn drop(self: &mut Self) -> () {
    if let Option<Interned<T>>.Some {value} = move Intrinsic.replace(self.value, Option<Interned<T>>.none()) {
      // No handle was published or cloned unless release immediately disarmed this owner.
      unsafe Interned<T>.discard(move value)
    }
  }
}

// Type/Application equality may allocate scratch values or recursively encode statics. The
// bounded candidate snapshot moves that work outside every structural table lock. A full four
// candidate collision run deliberately misses sharing, as the serial interner already does.
struct InternCandidates<T> {
  values: [Option<Interned<T>>; 4],
  count: usize,
}
impl<T> InternCandidates<T> {
  fn get(self: &Self, at: usize) -> &Interned<T> {
    return match &self.values[at] {
      Option<Interned<T>>.Some {value} => &value
      _ => Intrinsic.trap("an intern candidate ordinal is populated")
    }
  }
  fn same(left: &Self, right: &Self) -> bool {
    if left.count != right.count { return false }
    let mut at: usize = 0
    while at < left.count {
      if !Interned<T>.same(InternCandidates<T>.get(left, at), InternCandidates<T>.get(right, at)) { return false }
      at = at + 1
    }
    return true
  }
}

enum InternPublication { Added, Changed, Full }

impl<T> InternSet<T> {
  fn room(self: &Self) -> bool {
    let next = List<Interned<T>>.length(&self.handles) + 1
    return next <= List<Interned<T>>.capacity(&self.handles)
      && next <= List<u64>.capacity(&self.hashes)
      && next + next <= List<u32>.length(&self.slots)
  }
  // Called only after room(), under the category mutex; no allocation or callback occurs.
  fn addReady(self: &mut Self, hashed: u64, handle: Interned<T>) -> () {
    if !InternSet<T>.room(&self.*) { Intrinsic.trap("intern publication has reserved table space") }
    let _handle = List<Interned<T>>.appendWithinCapacity(&mut self.handles, move handle)
    let _hash = List<u64>.appendWithinCapacity(&mut self.hashes, hashed)
    let count = List<Interned<T>>.length(&self.handles)
    InternSet<T>.put(&mut self.*, hashed, count)
  }
  effect fn spare(count: usize) -> Self ! OutOfMemoryError ? &mut Allocator {
    let mut width: usize = 16
    while width < count * 4 { width = width + width }
    let handles = run List<Interned<T>>.makeWithCapacity(width / 2)
    let hashes = run List<u64>.makeWithCapacity(width / 2)
    let mut slots = run List<u32>.makeWithCapacity(width)
    run List<u32>.appendRepeated(&mut slots, 0, width)
    return Self {handles: move handles, hashes: move hashes, slots: move slots}
  }
  fn candidates(self: &Self, hashed: u64) -> InternCandidates<T> {
    let mut output = InternCandidates<T> {values: [Option<Interned<T>>.none(), Option<Interned<T>>.none(),
      Option<Interned<T>>.none(), Option<Interned<T>>.none()], count: 0}
    let mut at = InternSet<T>.first(self, hashed)
    while at != usize.MAX && output.count < 4 {
      output.values[output.count] = Option<Interned<T>>.some(Interned<T>.clone(InternSet<T>.at(self, at)))
      output.count = output.count + 1
      at = InternSet<T>.next(self, hashed, at)
    }
    return move output
  }
  fn find(self: &Self, value: &T, hashed: u64, same: fn(&T, &Interned<T>) -> bool) -> Option<Interned<T>> {
    let mut at = InternSet<T>.first(self, hashed)
    while at != usize.MAX {
      let known = InternSet<T>.at(self, at)
      if same(value, known) { return Option<Interned<T>>.some(Interned<T>.clone(known)) }
      at = InternSet<T>.next(self, hashed, at)
    }
    return Option<Interned<T>>.none()
  }
}

// Growth allocates all replacement storage before acquiring the table lock. Once locked it
// copies only immutable handles and already computed hashes, then releases old buffers outside.
effect fn sharedInternRoom<T>(table: &Mutex<InternSet<T>>) -> () ! OutOfMemoryError ? &mut Allocator {
  while true {
    let observed = Mutex<InternSet<T>>.lock(table)
    if InternSet<T>.room(observed.get()) { return () }
    let expected = List<Interned<T>>.length(&observed.get().handles) + 1
    drop observed
    let mut ready = run InternSet<T>.spare(expected)
    let mut guard = Mutex<InternSet<T>>.lock(table)
    if InternSet<T>.room(guard.get()) { drop guard return () }
    let count = List<Interned<T>>.length(&guard.get().handles)
    if count + 1 > List<Interned<T>>.capacity(&ready.handles) {
      drop guard
      continue
    }
    let old = guard.get()
    let mut at: usize = 0
    while at < count {
      InternSet<T>.addReady(&mut ready, List<u64>.get(&old.hashes, at),
        Interned<T>.clone(&List<Interned<T>>.asSlice(&old.handles)[at]))
      at = at + 1
    }
    let held = guard.getMut()
    let previous = Intrinsic.replace(held.*, move ready)
    drop guard
    drop previous
    return ()
  }
}

fn sharedInternCandidates<T>(table: &Mutex<InternSet<T>>, hashed: u64) -> InternCandidates<T> {
  let guard = Mutex<InternSet<T>>.lock(table)
  return InternSet<T>.candidates(guard.get(), hashed)
}

fn publishInternCandidate<T>(table: &Mutex<InternSet<T>>, hashed: u64,
  expected: &InternCandidates<T>, candidate: &Interned<T>) -> InternPublication {
  let mut guard = Mutex<InternSet<T>>.lock(table)
  let current = InternSet<T>.candidates(guard.get(), hashed)
  if !InternCandidates<T>.same(expected, &current) { return InternPublication.Changed }
  if !InternSet<T>.room(guard.get()) { return InternPublication.Full }
  InternSet<T>.addReady(guard.getMut(), hashed, Interned<T>.clone(candidate))
  return InternPublication.Added
}

// These three identity predicates inspect immutable declarations, lifetime atoms or child
// addresses only. They cannot call a provider, encode a type, or allocate under the lock.
fn sameDeclaration(value: &DeclarationId, known: &Interned<DeclarationId>) -> bool {
  return DeclarationId.equals(value, Interned<DeclarationId>.get(known))
}
fn sameLifetime(value: &Lifetime, known: &Interned<Lifetime>) -> bool { return Lifetime.internEquals(value, known) }
fn sameRow(value: &Row, known: &Interned<Row>) -> bool { return Row.internEquals(value, Interned<Row>.get(known)) }

effect fn sharedSimpleIntern<T>(table: &Mutex<InternSet<T>>, value: T, hashed: u64,
  same: fn(&T, &Interned<T>) -> bool) -> Interned<T> ! OutOfMemoryError ? &mut Allocator {
  let first = Mutex<InternSet<T>>.lock(table)
  let known = InternSet<T>.find(first.get(), &value, hashed, same)
  drop first
  if let Option<Interned<T>>.Some {value: held} = move known { return move held }
  let mut candidate = run InternCandidate<T>.make(move value)
  while true {
    let mut guard = Mutex<InternSet<T>>.lock(table)
    let found = InternSet<T>.find(guard.get(), Interned<T>.get(InternCandidate<T>.get(&candidate)), hashed, same)
    if let Option<Interned<T>>.Some {value: held} = move found {
      drop guard
      return move held
    }
    if InternSet<T>.room(guard.get()) {
      InternSet<T>.addReady(guard.getMut(), hashed, Interned<T>.clone(InternCandidate<T>.get(&candidate)))
      drop guard
      return InternCandidate<T>.release(&mut candidate)
    }
    drop guard
    run sharedInternRoom<T>(table)
  }
}

struct SharedInternPool {
  nodes: Mutex<InternSet<Type>>,
  declarations: Mutex<InternSet<DeclarationId>>,
  lifetimes: Mutex<InternSet<Lifetime>>,
  rows: Mutex<InternSet<Row>>,
  applications: Mutex<InternSet<Application>>,
}

/// A common immutable-value universe with independent structural category locks. Each worker
/// creates its own provider and mutable canonical InstanceKey memo. Bounded collision fallback
/// may miss sharing; equality is never inferred from a hash or a raced lookup.
pub struct SharedTypePool { pool: Published<SharedInternPool> }
pub struct ThreadTypes { pool: Published<SharedInternPool>, local: TypeTable }
impl SharedTypePool {
  pub effect fn make() -> Self ! OutOfMemoryError ? &mut Allocator {
    let pool = SharedInternPool {
      nodes: run Mutex<InternSet<Type>>.make(InternSet<Type>.make()),
      declarations: run Mutex<InternSet<DeclarationId>>.make(InternSet<DeclarationId>.make()),
      lifetimes: run Mutex<InternSet<Lifetime>>.make(InternSet<Lifetime>.make()),
      rows: run Mutex<InternSet<Row>>.make(InternSet<Row>.make()),
      applications: run Mutex<InternSet<Application>>.make(InternSet<Application>.make()),
    }
    return Self {pool: run Published<SharedInternPool>.make(move pool)}
  }
  pub fn clone(self: &Self) -> Self { return Self {pool: Published<SharedInternPool>.clone(&self.pool)} }
  pub fn provider(self: &Self) -> ThreadTypes {
    return ThreadTypes {pool: Published<SharedInternPool>.clone(&self.pool), local: TypeTable.make()}
  }
}
impl ThreadTypes {
  effect fn intern(self: &mut Self, node: Type) -> Interned<Type> ! OutOfMemoryError ? &mut Allocator {
    let table = &Published<SharedInternPool>.get(&self.pool).nodes
    let hashed = Type.internHash(&node)
    let mut candidates = sharedInternCandidates<Type>(table, hashed)
    let mut scratch = PlainTypes {}
    let mut at: usize = 0
    while at < candidates.count {
      let known = InternCandidates<Type>.get(&candidates, at)
      if run Type.internEquals(&node, known) |> Effect.provideMut<Types>(&mut scratch) { return Interned<Type>.clone(known) }
      at = at + 1
    }
    if candidates.count == 4 { return run Interned<Type>.make(move node) }
    let mut candidate = run InternCandidate<Type>.make(move node)
    while true {
      match publishInternCandidate<Type>(table, hashed, &candidates, InternCandidate<Type>.get(&candidate)) {
        InternPublication.Added => { return InternCandidate<Type>.release(&mut candidate) }
        InternPublication.Full => run sharedInternRoom<Type>(table)
        InternPublication.Changed => {
          candidates = sharedInternCandidates<Type>(table, hashed)
          at = 0
          while at < candidates.count {
            let known = InternCandidates<Type>.get(&candidates, at)
            if run Type.internEquals(Interned<Type>.get(InternCandidate<Type>.get(&candidate)), known)
              |> Effect.provideMut<Types>(&mut scratch) { return Interned<Type>.clone(known) }
            at = at + 1
          }
          if candidates.count == 4 { return InternCandidate<Type>.release(&mut candidate) }
        }
      }
    }
  }
  effect fn internDeclaration(self: &mut Self, value: DeclarationId) -> Interned<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
    let hashed = DeclarationId.hash(&value)
    return run sharedSimpleIntern<DeclarationId>(&Published<SharedInternPool>.get(&self.pool).declarations, move value, hashed, sameDeclaration)
  }
  effect fn internLifetime(self: &mut Self, value: Lifetime) -> Interned<Lifetime> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Lifetime.internHash(&value)
    return run sharedSimpleIntern<Lifetime>(&Published<SharedInternPool>.get(&self.pool).lifetimes, move value, hashed, sameLifetime)
  }
  effect fn internRow(self: &mut Self, value: Row) -> Interned<Row> ! OutOfMemoryError ? &mut Allocator {
    let hashed = Row.internHash(&value)
    return run sharedSimpleIntern<Row>(&Published<SharedInternPool>.get(&self.pool).rows, move value, hashed, sameRow)
  }
  effect fn internApplication(self: &mut Self, value: Application) -> Interned<Application> ! OutOfMemoryError ? &mut Allocator {
    let table = &Published<SharedInternPool>.get(&self.pool).applications
    let hashed = Application.internHash(&value)
    let mut candidates = sharedInternCandidates<Application>(table, hashed)
    let mut scratch = PlainTypes {}
    let mut at: usize = 0
    while at < candidates.count {
      let known = InternCandidates<Application>.get(&candidates, at)
      if Application.sameArgumentHandles(&value, Interned<Application>.get(known)) {
        if run Application.equals(&value, Interned<Application>.get(known)) |> Effect.provideMut<Types>(&mut scratch) {
          if run Application.sameStaticInputs(&value, Interned<Application>.get(known)) { return Interned<Application>.clone(known) }
        }
      }
      at = at + 1
    }
    if candidates.count == 4 { return run Interned<Application>.make(move value) }
    let mut candidate = run InternCandidate<Application>.make(move value)
    while true {
      match publishInternCandidate<Application>(table, hashed, &candidates, InternCandidate<Application>.get(&candidate)) {
        InternPublication.Added => { return InternCandidate<Application>.release(&mut candidate) }
        InternPublication.Full => run sharedInternRoom<Application>(table)
        InternPublication.Changed => {
          candidates = sharedInternCandidates<Application>(table, hashed)
          at = 0
          while at < candidates.count {
            let value = Interned<Application>.get(InternCandidate<Application>.get(&candidate))
            let known = Interned<Application>.get(InternCandidates<Application>.get(&candidates, at))
            if Application.sameArgumentHandles(value, known) {
              if run Application.equals(value, known) |> Effect.provideMut<Types>(&mut scratch) {
                if run Application.sameStaticInputs(value, known) { return Interned<Application>.clone(InternCandidates<Application>.get(&candidates, at)) }
              }
            }
            at = at + 1
          }
          if candidates.count == 4 { return InternCandidate<Application>.release(&mut candidate) }
        }
      }
    }
  }
  effect fn canonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry]) -> Option<InstanceKey>
  ! OutOfMemoryError ? &mut Allocator { return run TypeTable.canonical(&mut self.local, input, providers) }
  effect fn keepCanonical(self: &mut Self, input: &Interned<Application>, providers: &[ProviderEntry], key: InstanceKey) -> ()
  ! OutOfMemoryError ? &mut Allocator { return run TypeTable.keepCanonical(&mut self.local, input, providers, move key) }
  effect fn canonicalKeys(self: &mut Self) -> List<InstanceKey>
  ! OutOfMemoryError ? &mut Allocator { return run TypeTable.canonicalKeys(&mut self.local) }
}
impl Types for ThreadTypes {
  intern: ThreadTypes.intern
  internDeclaration: ThreadTypes.internDeclaration
  internLifetime: ThreadTypes.internLifetime
  internRow: ThreadTypes.internRow
  internApplication: ThreadTypes.internApplication
  canonical: ThreadTypes.canonical
  keepCanonical: ThreadTypes.keepCanonical
  canonicalKeys: ThreadTypes.canonicalKeys
}

// A racing candidate must be destroyed rather than become an unreachable immortal allocation.
struct InternDropProbe { dropped: Published<Mutex<usize>> }
impl Drop for InternDropProbe {
  fn drop(self: &mut Self) -> () {
    let mut guard = Mutex<usize>.lock(Published<Mutex<usize>>.get(&self.dropped))
    let next = guard.get().* + 1
    let held = guard.getMut()
    held.* = next
  }
}

effect fn concurrentInternPublicationClaims() -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let drops = run Published<Mutex<usize>>.make(run Mutex<usize>.make(0))
  let table = run Mutex<InternSet<InternDropProbe>>.make(InternSet<InternDropProbe>.make())
  let firstSeen = sharedInternCandidates<InternDropProbe>(&table, 7)
  let secondSeen = sharedInternCandidates<InternDropProbe>(&table, 7)
  let mut first = run InternCandidate<InternDropProbe>.make(InternDropProbe {dropped: Published<Mutex<usize>>.clone(&drops)})
  let second = run InternCandidate<InternDropProbe>.make(InternDropProbe {dropped: Published<Mutex<usize>>.clone(&drops)})
  run sharedInternRoom<InternDropProbe>(&table)
  let added = publishInternCandidate<InternDropProbe>(&table, 7, &firstSeen, InternCandidate<InternDropProbe>.get(&first))
  run Testing.expect(match added { InternPublication.Added => true _ => false }, "first checked candidate publishes")
  let winner = InternCandidate<InternDropProbe>.release(&mut first)
  let raced = publishInternCandidate<InternDropProbe>(&table, 7, &secondSeen, InternCandidate<InternDropProbe>.get(&second))
  run Testing.expect(match raced { InternPublication.Changed => true _ => false },
    "a concurrent same-hash publication forces equality to be checked again outside the lock")
  drop second
  let held = sharedInternCandidates<InternDropProbe>(&table, 7)
  run Testing.expect(Interned<InternDropProbe>.same(&winner, InternCandidates<InternDropProbe>.get(&held, 0)),
    "a rejected race does not replace the published immutable handle")
  let dropped = Mutex<usize>.lock(Published<Mutex<usize>>.get(&drops))
  run Testing.expect(dropped.get().* == 1, "the unpublished racing allocation is reclaimed exactly once")
  drop dropped
  // Deliberately identical hashes are not identity, including after a table growth.
  let lifetimes = run Mutex<InternSet<Lifetime>>.make(InternSet<Lifetime>.make())
  let mut values = List<Interned<Lifetime>>.make()
  let mut at: usize = 0
  while at < 32 {
    let value = run sharedSimpleIntern<Lifetime>(&lifetimes, Lifetime.Invocation {ordinal: at}, 11, sameLifetime)
    run List<Interned<Lifetime>>.append(&mut values, move value)
    at = at + 1
  }
  at = 0
  while at < 32 {
    let value = run sharedSimpleIntern<Lifetime>(&lifetimes, Lifetime.Invocation {ordinal: at}, 11, sameLifetime)
    run Testing.expect(Interned<Lifetime>.same(&value, &List<Interned<Lifetime>>.asSlice(&values)[at]),
      "pure exact lifetime equality distinguishes colliding binder ordinals and preserves each identity")
    at = at + 1
  }
}

effect fn concurrentInternMemoClaims() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> ? &mut Allocator {
  let pool = run SharedTypePool.make()
  let mut first = SharedTypePool.provider(&pool)
  let mut second = SharedTypePool.provider(&pool)
  let scalar = run ThreadTypes.intern(&mut first, Type.Primitive {name: run Bytes.copy(b"bool")})
  let copied = run ThreadTypes.intern(&mut second, Type.Primitive {name: run Bytes.copy(b"bool")})
  run Testing.expect(Interned<Type>.same(&scalar, &copied), "worker providers reuse a structural immutable type")
  let firstBinder = run ThreadTypes.internLifetime(&mut first, Lifetime.Invocation {ordinal: 0})
  let secondBinder = run ThreadTypes.internLifetime(&mut second, Lifetime.Invocation {ordinal: 1})
  run Testing.expect(!Lifetime.equalsShared(&firstBinder, &secondBinder), "sharing never merges distinct invocation binders")
  let declaration = run ThreadTypes.internDeclaration(&mut first,
    run DeclarationId.fromParts(run ModuleId.make(b"memory", b"thread-types", b"value.silk"), List<OwnerStep>.make()))
  let mut arguments = List<Argument>.make()
  run List<Argument>.append(&mut arguments, Argument.Type {value: Interned<Type>.clone(&scalar)})
  let mut ordinals = List<usize>.make()
  run List<usize>.append(&mut ordinals, 0)
  let application = run ThreadTypes.internApplication(&mut first, Application {
    target: Target.Named {declaration: DeclarationId.copyShared(&declaration)},
    arguments: move arguments, argumentOrdinals: move ordinals,
    scopes: List<ScopeBinding>.make(), statics: List<StaticSlot>.make(),
  })
  let again = run ThreadTypes.internApplication(&mut second, run Application.copy(Interned<Application>.get(&application)))
  run Testing.expect(Interned<Application>.same(&application, &again), "immutable applications share independently of local canonical memos")
  let key = run InstanceKey.named(&declaration) |> Effect.provideMut<Types>(&mut first)
  run ThreadTypes.keepCanonical(&mut first, &application, &[], move key)
  let own = run ThreadTypes.canonical(&mut first, &again, &[])
  let other = run ThreadTypes.canonical(&mut second, &again, &[])
  run Testing.expect(match &own { Option<InstanceKey>.Some {..} => true _ => false }, "the writing worker retains its canonicalization result")
  run Testing.expect(match &other { Option<InstanceKey>.None => true _ => false }, "another worker never observes mutable canonicalization state")
}

test effect fn concurrentInternPublicationRejectsRacesAndHashCollisions() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run concurrentInternPublicationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn concurrentInterningKeepsCanonicalMemosWorkerLocal() -> ()
! OutOfMemoryError | InvalidModulePath | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run concurrentInternMemoClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
