//! Selected text and Unicode characters use their existing runtime materialization lanes.

import backend.Mir {AggregateField, Block, MirFunction, Operand, Rvalue, Statement}
import semantic.ModuleId {InvalidModulePath}
import semantic.Query {Cycle}
import semantic.Rejection {RejectionCode}
import semantic.Semantic {Answer, Request, Semantic}
import semantic.SemanticCaseSupport {integerOperand, makeSemantic, mirReferenceCount, module, present, rejectsSpan, sameBytes, selectedApplicationOf, selectedMirIndex, succeeded}
import semantic.SourceIndex {NoRejection, RevisionMismatch, SourceIndex}
import semantic.SourceRevision {Revision}
import semantic.Type {Type}
import semantic.Lifetime {Lifetime}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}

test effect fn selectedTextAndUnicodeCharactersMaterializeExactly() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run embeddedTextClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn embeddedTextClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("embedded-text.silk")
  let text = """
static fn word() -> string<'static> {return "éλ!"}
static fn scalar() -> char {return 'λ'}
static fn words() -> [string<'static>; 2] {return ["éλ!", "éλ!"]}
static fn scalars() -> [char; 2] {return ['λ', 'λ']}
fn textUse() -> string<'static> {return word()}
fn charUse() -> char {return scalar()}
fn textArrayUse() -> [string<'static>; 2] {return words()}
fn charArrayUse() -> [char; 2] {return scalars()}
struct Packet {value: i32}
static fn packet() -> Packet {return Packet {value: 42}}
static fn packets() -> [Packet; 1] {return [Packet {value: 42}]}
fn nominalUse() -> Packet {return packet()}
fn nominalArrayUse() -> [Packet; 1] {return packets()}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let textMir = run Semantic.demandMir(&mut store, &mut request, &id, b"textUse")
  let character = run Semantic.demandMir(&mut store, &mut request, &id, b"charUse")
  let texts = run Semantic.demandMir(&mut store, &mut request, &id, b"textArrayUse")
  let characters = run Semantic.demandMir(&mut store, &mut request, &id, b"charArrayUse")
  run Testing.expect(succeeded(&textMir) && embeddedMirShape(&store, &textMir, usize.ONE, usize.ZERO, false),
    "selected text has exact static string type and UTF-8 bytes/count without a runtime static-helper edge")
  run Testing.expect(succeeded(&character) && embeddedMirShape(&store, &character, usize.ZERO, usize.ONE, false),
    "a selected Unicode character retains char type and scalar 955 rather than its UTF-8 encoding")
  run Testing.expect(succeeded(&texts) && embeddedMirShape(&store, &texts, 2, usize.ZERO, true),
    "a fixed text array materializes each static string descriptor into its aggregate")
  run Testing.expect(succeeded(&characters) && embeddedMirShape(&store, &characters, usize.ZERO, 2, true),
    "a fixed character array materializes each Unicode scalar into its aggregate")
  let nominalApplication = run selectedApplicationOf(&mut index, &id, b"nominalUse")
  let nominalArrayApplication = run selectedApplicationOf(&mut index, &id, b"nominalArrayUse")
  let nominal = run Semantic.demandSelectedBody(&mut store, &mut request, &nominalApplication)
  let nominals = run Semantic.demandSelectedBody(&mut store, &mut request, &nominalArrayApplication)
  run Testing.expect(rejectsSpan(&nominal, RejectionCode.Unsupported, text, "packet()", usize.ONE),
    "text and character embedding does not admit a nominal aggregate")
  run Testing.expect(rejectsSpan(&nominals, RejectionCode.StaticViolation, text, "[Packet {value: 42}]", usize.ZERO),
    "the static value domain refuses an array of nominal elements before runtime embedding")
}

fn embeddedMirShape(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  texts: usize, characters: usize, array: bool) -> bool {
  if mirReferenceCount(store, answer) != usize.ZERO {return false}
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if !embeddedResultType(&function.result, texts != usize.ZERO, array) {return false}
      let mut textCount = usize.ZERO
      let mut characterCount = usize.ZERO
      let mut aggregates = usize.ZERO
      let blocks = Vector.asSlice<Block>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<Statement>(&blocks[at].statements)
        let mut step = usize.ZERO
        while step < statements.length {
          if let Statement.Assign {value, ..} = &statements[step] {
            if let Rvalue.Slice {data, count} = &value {
              if let Operand.StaticBytes {bytes} = &data {
                if sameBytes(Bytes.asSlice(&bytes), b"éλ!") && integerOperand(&count, b"5") {textCount = textCount + usize.ONE}
              }
            } else if let Rvalue.Use {value: operand} = &value {
              if integerOperand(&operand, b"955") {characterCount = characterCount + usize.ONE}
            } else if let Rvalue.Aggregate {fields} = &value {
              let children = Vector.asSlice<AggregateField>(&fields)
              if children.length != 2 {return false}
              let mut child = usize.ZERO
              while child < children.length {
                if children[child].index != child {return false}
                if integerOperand(&children[child].value, b"955") {characterCount = characterCount + usize.ONE}
                child = child + usize.ONE
              }
              aggregates = aggregates + usize.ONE
            }
          }
          step = step + usize.ONE
        }
        at = at + usize.ONE
      }
      let mut expectedAggregates = usize.ZERO
      if array {expectedAggregates = usize.ONE}
      return textCount == texts && characterCount == characters && aggregates == expectedAggregates
    }
  }
  return false
}

fn embeddedResultType(value: &Shared<Type>, text: bool, array: bool) -> bool {
  return Shared.with<Type, bool>(value, fn(shape: &Type) -> bool {
    if array {
      if let Type.Array {element, extent} = &shape.* {return sameBytes(Bytes.asSlice(&extent), b"2") && embeddedResultType(&element, text, false)}
      return false
    }
    if text {
      if let Type.String {lifetime} = &shape.* {
        return Shared.with<Lifetime, bool>(&lifetime, embeddedProgramLifetime)
      }
      return false
    }
    if let Type.Primitive {name} = &shape.* {return sameBytes(Bytes.asSlice(&name), b"char")}
    return false
  })
}

fn embeddedProgramLifetime(region: &Lifetime) -> bool {
  return match &region.* {Lifetime.Static => true _ => false}
}
