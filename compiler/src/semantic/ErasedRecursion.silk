//! Detects a recursive call to a closed Effect dispatcher before an explicit suspension boundary.

import backend.InstanceKey {InstanceKey}
import backend.Mir {Block, Callee, ErasureFact, FailureEdge, MirFunction, SwitchCase, Terminator}
import semantic.InternIndex {InternIndex}
import semantic.RuntimeEncoding
import silk.collections.bytes {Bytes}
import semantic.TypedBody {Origin}
import silk.collections.list {List}
import silk.core.ownership {Copy}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

/// One exact implementation selected by a dynamic Effect call and the conversion that admits it.
pub struct Witness {
  pub key: InstanceKey,
  pub site: ErasureFact,
}

/// The witnesses of a reached operation, including its selected static arguments and provider row.
pub struct Operation {
  pub key: InstanceKey,
  pub witnesses: List<Witness>,
}

/// The operation and witness positions of a cycle and the call that re-enters its dispatcher.
pub struct Reentry {
  pub operation: usize,
  pub witness: usize,
  pub caller: usize,
  pub origin: Origin,
}

struct Point { function: usize, block: usize }
impl Copy for Point {}

// A caller's continuation is reachable only if its callee can leave without suspending, and
// only by the corresponding normal or failure exit.
// A reachable call to this function before suspension, indexed by its caller in the reached walk.
struct Caller { from: usize, origin: Origin }
impl Copy for Caller {}

struct Returns {
  callers: List<Caller>,
  visited: List<bool>,
  normal: bool,
  failed: bool,
  onReturn: List<Point>,
  onFailure: List<Point>,
}

fn empty() -> Returns {
  return Returns {callers: List<Caller>.make(), visited: List<bool>.make(), normal: false, failed: false,
    onReturn: List<Point>.make(), onFailure: List<Point>.make()}
}

/// Indexes just the instances reached by the last walk of this artifact.
effect fn index(functions: &[MirFunction], reached: &[usize]) -> InternIndex ! OutOfMemoryError ? &mut Allocator {
  let mut result = InternIndex.make()
  let mut at = usize.ZERO
  while at < reached.length {
    run InternIndex.record(&mut result, InstanceKey.runtimeHash(&functions[reached[at]].key))
    at = at + usize.ONE
  }
  return move result
}

effect fn position(lookup: &InternIndex, functions: &[MirFunction], reached: &[usize], key: &InstanceKey) -> usize
  ! OutOfMemoryError ? &mut Allocator {
  let mut found = InternIndex.first(lookup, InstanceKey.runtimeHash(key))
  while found != usize.MAX {
    if run InstanceKey.sameInstance(&functions[reached[found]].key, key) { return found }
    found = InternIndex.after(lookup, found)
  }
  return usize.MAX
}

/// Computes the callable blocks before suspension once for all witnesses. Normal and failure
/// continuations wait for their own callee's matching return. Every recorded caller is therefore
/// reachable from its function entry without crossing a suspension. Reverse paths through those
/// calls identify the witnesses that re-enter each exact dispatcher.
pub effect fn reentries(functions: &[MirFunction], reached: &[usize], operations: &[Operation])
  -> List<Reentry> ! OutOfMemoryError ? &mut Allocator {
  let lookup = run index(functions, reached)
  let mut states = run List<Returns>.makeWithCapacity(reached.length)
  while List<Returns>.length(&states) < reached.length { run List<Returns>.append(&mut states, empty()) }
  let mut work = List<Point>.make()
  let mut i = usize.ZERO
  while i < operations.length {
    let witnesses = List<Witness>.asSlice(&operations[i].witnesses)
    let mut j = usize.ZERO
    while j < witnesses.length {
      let start = run position(&lookup, functions, reached, &witnesses[j].key)
      if start != usize.MAX { run List<Point>.append(&mut work, Point {function: start, block: usize.ZERO}) }
      j = j + usize.ONE
    }
    i = i + usize.ONE
  }
  while let Option<Point>.Some {value: point} = move List<Point>.pop(&mut work) {
    let blocks = List<Block>.asSlice(&functions[reached[point.function]].blocks)
    let state = &mut List<Returns>.asMutSlice(&mut states)[point.function]
    if List<bool>.length(&state.visited) == usize.ZERO { run List<bool>.appendRepeated(&mut state.visited, false, blocks.length) }
    if List<bool>.get(&state.visited, point.block) { continue }
    List<bool>.set(&mut state.visited, point.block, true)
    let block = &blocks[point.block]
    if block.suspends { continue }
    match &block.terminator {
      Terminator.Goto {target, ..} => run List<Point>.append(&mut work, Point {function: point.function, block: target})
      Terminator.Branch {thenBlock, elseBlock, ..} => {
        run List<Point>.append(&mut work, Point {function: point.function, block: elseBlock})
        run List<Point>.append(&mut work, Point {function: point.function, block: thenBlock})
      }
      Terminator.Switch {cases, otherwise, ..} => {
        run List<Point>.append(&mut work, Point {function: point.function, block: otherwise})
        let choices = List<SwitchCase>.asSlice(&cases)
        let mut i = usize.ZERO
        while i < choices.length {
          run List<Point>.append(&mut work, Point {function: point.function, block: choices[i].target})
          i = i + usize.ONE
        }
      }
      Terminator.Return {..} => {
        if !state.normal {
          state.normal = true
          run List<Point>.appendSlice(&mut work, List<Point>.asSlice(&state.onReturn))
        }
      }
      Terminator.Fail {..} => {
        if !state.failed {
          state.failed = true
          run List<Point>.appendSlice(&mut work, List<Point>.asSlice(&state.onFailure))
        }
      }
      Terminator.Call {callee, normal, failure, origin, ..} => {
        let child = match &callee {
          Callee.Instance {key} => run position(&lookup, functions, reached, &key)
          _ => usize.MAX
        }
        let continuation = Point {function: point.function, block: normal}
        if child == usize.MAX {
          run List<Point>.append(&mut work, continuation)
          if let Option<FailureEdge>.Some {value} = &failure { run List<Point>.append(&mut work, Point {function: point.function, block: value.target}) }
        } else {
          let target = &mut List<Returns>.asMutSlice(&mut states)[child]
          run List<Caller>.append(&mut target.callers, Caller {from: point.function, origin: origin})
          if target.normal { run List<Point>.append(&mut work, continuation) }
          else { run List<Point>.append(&mut target.onReturn, continuation) }
          if let Option<FailureEdge>.Some {value} = &failure {
            let escape = Point {function: point.function, block: value.target}
            if target.failed { run List<Point>.append(&mut work, escape) }
            else { run List<Point>.append(&mut target.onFailure, escape) }
          }
          run List<Point>.append(&mut work, Point {function: child, block: usize.ZERO})
        }
      }
      _ => ()
    }
  }
  let mut reports = List<Reentry>.make()
  let mut marked = List<usize>.make()
  run List<usize>.appendRepeated(&mut marked, usize.MAX, reached.length)
  let mut lastCall = List<usize>.make()
  run List<usize>.appendRepeated(&mut lastCall, usize.MAX, reached.length)
  let mut pending = List<usize>.make()
  let rows = List<Returns>.asSlice(&states)
  i = usize.ZERO
  while i < operations.length {
    let goal = run position(&lookup, functions, reached, &operations[i].key)
    if goal != usize.MAX {
      let incoming = List<Caller>.asSlice(&rows[goal].callers)
      let mut k = usize.ZERO
      while k < incoming.length {
        let from = incoming[k].from
        if List<usize>.get(&marked, from) != i {
          List<usize>.set(&mut marked, from, i)
          List<usize>.set(&mut lastCall, from, k)
          run List<usize>.append(&mut pending, from)
        }
        k = k + usize.ONE
      }
      while let Option<usize>.Some {value: node} = move List<usize>.pop(&mut pending) {
        let parents = List<Caller>.asSlice(&rows[node].callers)
        let last = List<usize>.get(&lastCall, node)
        k = usize.ZERO
        while k < parents.length {
          let from = parents[k].from
          if List<usize>.get(&marked, from) != i {
            List<usize>.set(&mut marked, from, i)
            List<usize>.set(&mut lastCall, from, last)
            run List<usize>.append(&mut pending, from)
          }
          k = k + usize.ONE
        }
      }
      let witnesses = List<Witness>.asSlice(&operations[i].witnesses)
      let mut j = usize.ZERO
      while j < witnesses.length {
        let start = run position(&lookup, functions, reached, &witnesses[j].key)
        if start != usize.MAX && List<usize>.get(&marked, start) == i {
          let call = incoming[List<usize>.get(&lastCall, start)]
          run List<Reentry>.append(&mut reports, Reentry {operation: i, witness: j, caller: reached[call.from], origin: call.origin})
        }
        j = j + usize.ONE
      }
    }
    i = i + usize.ONE
  }
  return move reports
}


/// Records the control-flow distinctions the pre-suspension reachability analysis consumes.
/// Store-local MIR temporaries and data operands cannot change any of these paths.
pub effect fn appendControlFlow(bytes: &mut Bytes, function: &MirFunction) -> () ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<Block>.asSlice(&function.blocks)
  run RuntimeEncoding.word(&mut bytes.*, usize.toU64(blocks.length))
  let mut at = usize.ZERO
  while at < blocks.length {
    let block = &blocks[at]
    at = at + usize.ONE
    if block.suspends { run Bytes.append(&mut bytes.*, b"S") continue }
    match &block.terminator {
      Terminator.Goto {target, ..} => { run Bytes.append(&mut bytes.*, b"G") run RuntimeEncoding.word(&mut bytes.*, usize.toU64(target)) }
      Terminator.Branch {thenBlock, elseBlock, ..} => {
        run Bytes.append(&mut bytes.*, b"B")
        run RuntimeEncoding.word(&mut bytes.*, usize.toU64(thenBlock))
        run RuntimeEncoding.word(&mut bytes.*, usize.toU64(elseBlock))
      }
      Terminator.Switch {otherwise, cases, ..} => {
        run Bytes.append(&mut bytes.*, b"W")
        run RuntimeEncoding.word(&mut bytes.*, usize.toU64(otherwise))
        let choices = List<SwitchCase>.asSlice(&cases)
        run RuntimeEncoding.word(&mut bytes.*, usize.toU64(choices.length))
        let mut j = usize.ZERO
        while j < choices.length { run RuntimeEncoding.word(&mut bytes.*, usize.toU64(choices[j].target)) j = j + usize.ONE }
      }
      Terminator.Return {..} => run Bytes.append(&mut bytes.*, b"R")
      Terminator.Fail {..} => run Bytes.append(&mut bytes.*, b"F")
      Terminator.Call {callee, normal, failure, ..} => {
        if let Callee.Instance {key} = &callee {
          run Bytes.append(&mut bytes.*, b"C")
          run RuntimeEncoding.field(&mut bytes.*, Bytes.asSlice(&run InstanceKey.exactIdentity(&key)))
        } else { run Bytes.append(&mut bytes.*, b"X") }
        run RuntimeEncoding.word(&mut bytes.*, usize.toU64(normal))
        let failed = match &failure { Option<FailureEdge>.Some {value} => value.target _ => usize.MAX }
        run RuntimeEncoding.word(&mut bytes.*, usize.toU64(failed))
      }
      _ => run Bytes.append(&mut bytes.*, b"T")
    }
  }
  return ()
}
