//! An authoritative selection of roots in immutable cache segments.
//! A generation names its complete segment catalog and selected roots directly; reading it
//! never follows older generations. Unselected stored answers confer no reuse authority.

import semantic.CacheSegments as Segments {Descriptor, SealedSegment}
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.RuntimeEncoding as Encoding
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.frozen {Frozen}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u8
import silk.num.u64
import silk.num.usize

/// Roots authorized from one exact segment. Bits are low-bit first; unused high bits are zero.
pub struct Selection {pub segment: ContentHash, pub roots: Bytes}

/// One immutable observation, addressed independently of a reader's local catalog ordinals.
pub struct LeafHandle {pub segment: ContentHash, pub index: usize}
impl Copy for LeafHandle {}

/// New placement evidence for an unchanged input digest. The original dependency stays intact.
pub struct Placement {pub source: LeafHandle, pub target: LeafHandle}
impl Copy for Placement {}

/// Guard dispositions verified under one exact source/request context. These never authorize
/// an answer's family, key or payload: normal adoption checks still apply after anchor validation.
pub struct Certificate {
  pub context: Bytes,
  pub exact: List<Selection>,
  pub positionOnly: List<Selection>,
  pub anchors: List<LeafHandle>,
}

/// The complete state published atomically after its immutable segments and packs exist.
/// Catalog serials strictly increase, so every imported segment must precede its consumer.
pub struct Generation {
  pub stamp: Bytes,
  pub catalog: List<Descriptor>,
  pub selections: List<Selection>,
  /// Canonical source order: catalog ordinal first, then leaf index. Targets never chain.
  pub placements: List<Placement>,
  /// Absent for roots without a current verification ledger. Publication alone proves nothing.
  pub certificate: Option<Certificate>,
}

/// Pack digests required by selected answers after catalog and root validation.
/// The filesystem owner must keep these resources alive; this value holds no reader lock.
pub struct Requirements {pub packs: List<ContentHash>, pub roots: usize}

const FORMAT: u64 = 3
const MAX_SEGMENTS: usize = 256
const MAX_ROOTS: usize = 4194304
const MAX_BYTES: usize = 16777216
const MAX_STAMP: usize = 65536
const MAX_PLACEMENTS: usize = 131072
const MAX_CONTEXT: usize = 1048576
const MAX_ANCHORS: usize = 131072

fn sameDescriptor(a: &Descriptor, b: &Descriptor) -> bool {
  return ContentHash.equals(a.digest, b.digest) && a.serial == b.serial
    && a.leaves == b.leaves && a.nodes == b.nodes && a.roots == b.roots
}

fn catalogPosition(catalog: &[Descriptor], digest: ContentHash) -> usize {
  let mut at = usize.ZERO
  while at < catalog.length {
    if ContentHash.equals(catalog[at].digest, digest) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn placementIndex(value: &Generation, source: LeafHandle) -> usize {
  let catalog = List<Descriptor>.asSlice(&value.catalog)
  let segment = catalogPosition(catalog, source.segment)
  if segment == usize.MAX { return usize.MAX }
  let entries = List<Placement>.asSlice(&value.placements)
  let mut start = usize.ZERO
  let mut end = entries.length
  while start < end {
    let middle = start + (end - start) / 2
    let found = catalogPosition(catalog, entries[middle].source.segment)
    if found < segment || (found == segment && entries[middle].source.index < source.index) { start = middle + usize.ONE }
    else { end = middle }
  }
  if start < entries.length && ContentHash.equals(entries[start].source.segment, source.segment)
    && entries[start].source.index == source.index { return start }
  return usize.MAX
}

/// Returns one already-admitted placement override. Whole-file dependency reads never use it.
pub fn placement(value: &Generation, source: LeafHandle) -> Option<LeafHandle> {
  let index = placementIndex(value, source)
  if index == usize.MAX { return Option<LeafHandle>.none() }
  return Option<LeafHandle>.some(List<Placement>.get(&value.placements, index).target)
}

/// Whether the exact root ordinal is selected; an out-of-range ordinal is never selected.
pub fn selected(selection: &Selection, root: usize) -> bool {
  let bytes = Bytes.asSlice(&selection.roots)
  let byte = root / 8
  if byte >= bytes.length { return false }
  return u64.bitAnd(u8.toU64(bytes[byte]), u64.shiftLeft(1, usize.toU64(root % 8))) != 0
}

/// Makes an empty root selection for a bounded segment descriptor.
pub effect fn selection(descriptor: &Descriptor) -> Option<Selection>
! OutOfMemoryError ? &mut Allocator {
  if descriptor.roots > MAX_ROOTS { return Option<Selection>.none() }
  let mut roots = Bytes.make()
  let length = descriptor.roots / 8 + if descriptor.roots % 8 == 0 { usize.ZERO } else { usize.ONE }
  let mut at = usize.ZERO
  while at < length { run Bytes.append(&mut roots, &[0]) at = at + usize.ONE }
  return Option<Selection>.some(Selection {segment: descriptor.digest, roots: move roots})
}

/// Changes one authorized root bit without changing segment content or source observations.
pub fn setSelected(selection: &mut Selection, descriptor: &Descriptor, root: usize, value: bool) -> bool {
  if !ContentHash.equals(selection.segment, descriptor.digest) || root >= descriptor.roots { return false }
  let bytes = Bytes.asMutSlice(&mut selection.roots)
  let byte = root / 8
  if byte >= bytes.length { return false }
  let mask = u64.shiftLeft(1, usize.toU64(root % 8))
  bytes[byte] = u64.toU8(if value { u64.bitOr(u8.toU64(bytes[byte]), mask) }
    else { u64.bitAnd(u8.toU64(bytes[byte]), u64.bitNot(mask)) })
  return true
}

fn selectionIndex(values: &[Selection], segment: ContentHash) -> usize {
  let mut at = usize.ZERO
  while at < values.length {
    if ContentHash.equals(values[at].segment, segment) { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn certificateSubset(catalog: &[Descriptor], selected: &[Selection], certified: &[Selection]) -> bool {
  if certified.length > selected.length { return false }
  let mut previous = usize.ZERO
  let mut at = usize.ZERO
  while at < certified.length {
    let position = catalogPosition(catalog, certified[at].segment)
    let parent = selectionIndex(selected, certified[at].segment)
    if position == usize.MAX || parent == usize.MAX || (at > usize.ZERO && position <= previous) { return false }
    let allowed = Bytes.asSlice(&selected[parent].roots)
    let bits = Bytes.asSlice(&certified[at].roots)
    if bits.length != allowed.length { return false }
    let mut byte = usize.ZERO
    while byte < bits.length {
      if u64.bitAnd(u8.toU64(bits[byte]), u64.bitNot(u8.toU64(allowed[byte]))) != 0 { return false }
      byte = byte + usize.ONE
    }
    previous = position
    at = at + usize.ONE
  }
  return true
}

fn certificateShape(value: &Generation) -> bool {
  let proof = match &value.certificate {
    Option<Certificate>.Some {value: held} => &held
    _ => { return true }
  }
  if Bytes.length(&proof.context) == usize.ZERO || Bytes.length(&proof.context) > MAX_CONTEXT { return false }
  let catalog = List<Descriptor>.asSlice(&value.catalog)
  let selected = List<Selection>.asSlice(&value.selections)
  let exact = List<Selection>.asSlice(&proof.exact)
  let positioned = List<Selection>.asSlice(&proof.positionOnly)
  if !certificateSubset(catalog, selected, exact) || !certificateSubset(catalog, selected, positioned) { return false }
  let mut at = usize.ZERO
  while at < exact.length {
    let other = selectionIndex(positioned, exact[at].segment)
    if other != usize.MAX {
      let left = Bytes.asSlice(&exact[at].roots)
      let right = Bytes.asSlice(&positioned[other].roots)
      let mut byte = usize.ZERO
      while byte < left.length {
        if u64.bitAnd(u8.toU64(left[byte]), u8.toU64(right[byte])) != 0 { return false }
        byte = byte + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let anchors = List<LeafHandle>.asSlice(&proof.anchors)
  if anchors.length > MAX_ANCHORS { return false }
  let mut previousSegment = usize.ZERO
  let mut previousLeaf = usize.ZERO
  at = usize.ZERO
  while at < anchors.length {
    let segment = catalogPosition(catalog, anchors[at].segment)
    if segment == usize.MAX || anchors[at].index >= catalog[segment].leaves { return false }
    if at > usize.ZERO && (segment < previousSegment || (segment == previousSegment && anchors[at].index <= previousLeaf)) { return false }
    previousSegment = segment
    previousLeaf = anchors[at].index
    at = at + usize.ONE
  }
  return true
}

/// Validates descriptor and selection shape only. Import and key authority require `admit`.
pub fn validShape(value: &Generation) -> bool {
  let catalog = List<Descriptor>.asSlice(&value.catalog)
  let selections = List<Selection>.asSlice(&value.selections)
  if catalog.length > MAX_SEGMENTS || selections.length > catalog.length
    || Bytes.length(&value.stamp) > MAX_STAMP { return false }
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < catalog.length {
    if catalog[at].roots > MAX_ROOTS - total { return false }
    total = total + catalog[at].roots
    if at > usize.ZERO && catalog[at - usize.ONE].serial >= catalog[at].serial { return false }
    let mut earlier = usize.ZERO
    while earlier < at {
      if ContentHash.equals(catalog[earlier].digest, catalog[at].digest) { return false }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < selections.length {
    let position = catalogPosition(catalog, selections[at].segment)
    if position == usize.MAX { return false }
    let count = catalog[position].roots
    let bytes = Bytes.asSlice(&selections[at].roots)
    let length = count / 8 + if count % 8 == 0 { usize.ZERO } else { usize.ONE }
    if bytes.length != length { return false }
    if count % 8 != 0 && u64.shiftRight(u8.toU64(bytes[length - usize.ONE]), usize.toU64(count % 8)) != 0 { return false }
    let mut earlier = usize.ZERO
    while earlier < at {
      if ContentHash.equals(selections[earlier].segment, selections[at].segment) { return false }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  let placements = List<Placement>.asSlice(&value.placements)
  if placements.length > MAX_PLACEMENTS { return false }
  let mut previousSegment = usize.ZERO
  let mut previousLeaf = usize.ZERO
  at = usize.ZERO
  while at < placements.length {
    let item = &placements[at]
    let source = catalogPosition(catalog, item.source.segment)
    let target = catalogPosition(catalog, item.target.segment)
    if source == usize.MAX || target == usize.MAX
      || item.source.index >= catalog[source].leaves || item.target.index >= catalog[target].leaves { return false }
    if source == target && item.source.index == item.target.index { return false }
    if at > usize.ZERO && (source < previousSegment || (source == previousSegment && item.source.index <= previousLeaf)) { return false }
    previousSegment = source
    previousLeaf = item.source.index
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < placements.length {
    if placementIndex(value, placements[at].target) != usize.MAX { return false }
    at = at + usize.ONE
  }
  return certificateShape(value)
}

effect fn digest(output: &mut Bytes, value: ContentHash) -> () ! OutOfMemoryError ? &mut Allocator {
  run Encoding.word(&mut output.*, value.high)
  return run Encoding.word(&mut output.*, value.low)
}
fn readDigest(bytes: &[u8], reader: &mut StableKey.Reader) -> ContentHash {
  let high = StableKey.readWord(bytes, &mut reader.*)
  let low = StableKey.readWord(bytes, &mut reader.*)
  return ContentHash {high: high, low: low}
}

effect fn writeSelections(output: &mut Bytes, values: &[Selection]) -> () ! OutOfMemoryError ? &mut Allocator {
  run Encoding.word(&mut output.*, usize.toU64(values.length))
  let mut at = usize.ZERO
  while at < values.length {
    run digest(&mut output.*, values[at].segment)
    run Encoding.field(&mut output.*, Bytes.asSlice(&values[at].roots))
    at = at + usize.ONE
  }
}

effect fn readSelections(bytes: &[u8], reader: &mut StableKey.Reader, limit: usize) -> Option<List<Selection>>
! OutOfMemoryError ? &mut Allocator {
  let count = StableKey.readWord(bytes, &mut reader.*)
  if count > usize.toU64(limit) || StableKey.failed(&reader.*) { return Option<List<Selection>>.none() }
  let mut values = List<Selection>.make()
  let mut at: u64 = 0
  while at < count {
    let hash = readDigest(bytes, &mut reader.*)
    let field = StableKey.readField(bytes, &mut reader.*)
    let bits = StableKey.view(bytes, field)
    if bits.length > MAX_ROOTS / 8 || StableKey.failed(&reader.*) { return Option<List<Selection>>.none() }
    run List<Selection>.append(&mut values, Selection {segment: hash, roots: run Bytes.copy(bits)})
    at = at + 1
  }
  return Option<List<Selection>>.some(move values)
}

/// Encodes one complete generation with a content seal; malformed selections are refused.
pub effect fn encode(value: &Generation) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if !validShape(value) { return Option<Bytes>.none() }
  let mut bytes = Bytes.make()
  run Encoding.field(&mut bytes, b"silk-cache-generation")
  run Encoding.word(&mut bytes, FORMAT)
  run Encoding.field(&mut bytes, Bytes.asSlice(&value.stamp))
  let catalog = List<Descriptor>.asSlice(&value.catalog)
  run Encoding.word(&mut bytes, usize.toU64(catalog.length))
  let mut at = usize.ZERO
  while at < catalog.length {
    let entry = &catalog[at]
    run digest(&mut bytes, entry.digest)
    run Encoding.word(&mut bytes, entry.serial)
    run Encoding.word(&mut bytes, usize.toU64(entry.leaves))
    run Encoding.word(&mut bytes, usize.toU64(entry.nodes))
    run Encoding.word(&mut bytes, usize.toU64(entry.roots))
    at = at + usize.ONE
  }
  let selections = List<Selection>.asSlice(&value.selections)
  run Encoding.word(&mut bytes, usize.toU64(selections.length))
  at = usize.ZERO
  while at < selections.length {
    run digest(&mut bytes, selections[at].segment)
    run Encoding.field(&mut bytes, Bytes.asSlice(&selections[at].roots))
    at = at + usize.ONE
  }
  let placements = List<Placement>.asSlice(&value.placements)
  run Encoding.word(&mut bytes, usize.toU64(placements.length))
  at = usize.ZERO
  while at < placements.length {
    run digest(&mut bytes, placements[at].source.segment)
    run Encoding.word(&mut bytes, usize.toU64(placements[at].source.index))
    run digest(&mut bytes, placements[at].target.segment)
    run Encoding.word(&mut bytes, usize.toU64(placements[at].target.index))
    at = at + usize.ONE
  }
  match &value.certificate {
    Option<Certificate>.None => { run Encoding.word(&mut bytes, 0) }
    Option<Certificate>.Some {value: proof} => {
      run Encoding.word(&mut bytes, 1)
      run Encoding.field(&mut bytes, Bytes.asSlice(&proof.context))
      run writeSelections(&mut bytes, List<Selection>.asSlice(&proof.exact))
      run writeSelections(&mut bytes, List<Selection>.asSlice(&proof.positionOnly))
      let anchors = List<LeafHandle>.asSlice(&proof.anchors)
      run Encoding.word(&mut bytes, usize.toU64(anchors.length))
      at = usize.ZERO
      while at < anchors.length {
        run digest(&mut bytes, anchors[at].segment)
        run Encoding.word(&mut bytes, usize.toU64(anchors[at].index))
        at = at + usize.ONE
      }
    }
  }
  let seal = ContentHash.of(Bytes.asSlice(&bytes))
  run digest(&mut bytes, seal)
  if Bytes.length(&bytes) > MAX_BYTES { return Option<Bytes>.none() }
  return Option<Bytes>.some(move bytes)
}

/// Reads a bounded sealed descriptor. Successful decoding alone does not admit its segments.
pub effect fn decode(bytes: &[u8], expectedStamp: &[u8]) -> Option<Generation>
! OutOfMemoryError ? &mut Allocator {
  if bytes.length < 16 || bytes.length > MAX_BYTES { return Option<Generation>.none() }
  let payload = Slice.view<u8>(bytes, usize.ZERO, bytes.length - 16)
  let mut sealReader = StableKey.reader()
  let stored = readDigest(Slice.view<u8>(bytes, bytes.length - 16, 16), &mut sealReader)
  if !ContentHash.equals(stored, ContentHash.of(payload)) { return Option<Generation>.none() }
  let mut reader = StableKey.reader()
  let magic = StableKey.readField(payload, &mut reader)
  if !Encoding.equals(StableKey.view(payload, magic), b"silk-cache-generation")
    || StableKey.readWord(payload, &mut reader) != FORMAT { return Option<Generation>.none() }
  let stamp = StableKey.readField(payload, &mut reader)
  let stampBytes = StableKey.view(payload, stamp)
  if stampBytes.length > MAX_STAMP || !Encoding.equals(stampBytes, expectedStamp) { return Option<Generation>.none() }
  let count = StableKey.readWord(payload, &mut reader)
  if count > usize.toU64(MAX_SEGMENTS) || StableKey.failed(&reader) { return Option<Generation>.none() }
  let mut catalog = List<Descriptor>.make()
  let mut at: u64 = 0
  while at < count {
    let hash = readDigest(payload, &mut reader)
    let serial = StableKey.readWord(payload, &mut reader)
    let leaves = StableKey.readWord(payload, &mut reader)
    let nodes = StableKey.readWord(payload, &mut reader)
    let roots = StableKey.readWord(payload, &mut reader)
    if leaves > usize.toU64(usize.MAX) || nodes > usize.toU64(usize.MAX)
      || roots > usize.toU64(MAX_ROOTS) || StableKey.failed(&reader) { return Option<Generation>.none() }
    run List<Descriptor>.append(&mut catalog, Descriptor {digest: hash, serial: serial,
      leaves: u64.toUsize(leaves), nodes: u64.toUsize(nodes), roots: u64.toUsize(roots)})
    at = at + 1
  }
  let selectionCount = StableKey.readWord(payload, &mut reader)
  if selectionCount > usize.toU64(List<Descriptor>.length(&catalog)) || StableKey.failed(&reader) { return Option<Generation>.none() }
  let mut selections = List<Selection>.make()
  at = 0
  while at < selectionCount {
    let hash = readDigest(payload, &mut reader)
    let field = StableKey.readField(payload, &mut reader)
    let bits = StableKey.view(payload, field)
    if bits.length > MAX_ROOTS / 8 || StableKey.failed(&reader) { return Option<Generation>.none() }
    run List<Selection>.append(&mut selections, Selection {segment: hash, roots: run Bytes.copy(bits)})
    at = at + 1
  }
  let placementCount = StableKey.readWord(payload, &mut reader)
  if placementCount > usize.toU64(MAX_PLACEMENTS) || StableKey.failed(&reader) { return Option<Generation>.none() }
  let mut placements = List<Placement>.make()
  at = 0
  while at < placementCount {
    let source = readDigest(payload, &mut reader)
    let sourceIndex = StableKey.readWord(payload, &mut reader)
    let target = readDigest(payload, &mut reader)
    let targetIndex = StableKey.readWord(payload, &mut reader)
    if sourceIndex > usize.toU64(usize.MAX) || targetIndex > usize.toU64(usize.MAX)
      || StableKey.failed(&reader) { return Option<Generation>.none() }
    run List<Placement>.append(&mut placements, Placement {
      source: LeafHandle {segment: source, index: u64.toUsize(sourceIndex)},
      target: LeafHandle {segment: target, index: u64.toUsize(targetIndex)}})
    at = at + 1
  }
  let hasCertificate = StableKey.readWord(payload, &mut reader)
  if hasCertificate > 1 || StableKey.failed(&reader) { return Option<Generation>.none() }
  let mut certificate = Option<Certificate>.none()
  if hasCertificate == 1 {
    let contextSpan = StableKey.readField(payload, &mut reader)
    let context = StableKey.view(payload, contextSpan)
    if context.length > MAX_CONTEXT || StableKey.failed(&reader) { return Option<Generation>.none() }
    let exact = match move run readSelections(payload, &mut reader, List<Descriptor>.length(&catalog)) {
      Option<List<Selection>>.Some {value} => move value _ => { return Option<Generation>.none() }
    }
    let positioned = match move run readSelections(payload, &mut reader, List<Descriptor>.length(&catalog)) {
      Option<List<Selection>>.Some {value} => move value _ => { return Option<Generation>.none() }
    }
    let anchorCount = StableKey.readWord(payload, &mut reader)
    if anchorCount > usize.toU64(MAX_ANCHORS) || StableKey.failed(&reader) { return Option<Generation>.none() }
    let mut anchors = List<LeafHandle>.make()
    at = 0
    while at < anchorCount {
      let segment = readDigest(payload, &mut reader)
      let index = StableKey.readWord(payload, &mut reader)
      if index > usize.toU64(usize.MAX) || StableKey.failed(&reader) { return Option<Generation>.none() }
      run List<LeafHandle>.append(&mut anchors, LeafHandle {segment: segment, index: u64.toUsize(index)})
      at = at + 1
    }
    certificate = Option<Certificate>.some(Certificate {context: run Bytes.copy(context), exact: move exact,
      positionOnly: move positioned, anchors: move anchors})
  }
  if !StableKey.finished(payload, &reader) { return Option<Generation>.none() }
  let result = Generation {stamp: run Bytes.copy(stampBytes), catalog: move catalog, selections: move selections,
    placements: move placements, certificate: move certificate}
  if !validShape(&result) { return Option<Generation>.none() }
  return Option<Generation>.some(move result)
}

struct RootPosition {segment: usize, root: usize}

fn fileObservation<'a>(segments: &'a [Frozen<SealedSegment>], owner: usize, reference: Segments.Reference) -> Option<Segments.ObservationView<'a>> {
  let mut selected = owner
  if reference.segment != usize.ZERO {
    let imported = Segments.imports(Frozen<SealedSegment>.get(&segments[owner]))
    if reference.segment > imported.length { return Option<Segments.ObservationView<'a>>.none() }
    let expected = imported[reference.segment - usize.ONE]
    selected = usize.MAX
    let mut at = usize.ZERO
    while at < segments.length {
      let actual = Segments.descriptor(Frozen<SealedSegment>.get(&segments[at]))
      if sameDescriptor(&actual, &expected) { selected = at break }
      at = at + usize.ONE
    }
  }
  if selected == usize.MAX { return Option<Segments.ObservationView<'a>>.none() }
  return Segments.observation(Frozen<SealedSegment>.get(&segments[selected]), reference.index)
}

fn validPlacements(value: &Generation, segments: &[Frozen<SealedSegment>]) -> bool {
  let catalog = List<Descriptor>.asSlice(&value.catalog)
  let entries = List<Placement>.asSlice(&value.placements)
  let mut at = usize.ZERO
  while at < entries.length {
    let sourceOwner = catalogPosition(catalog, entries[at].source.segment)
    let targetOwner = catalogPosition(catalog, entries[at].target.segment)
    let source = match move Segments.observation(Frozen<SealedSegment>.get(&segments[sourceOwner]), entries[at].source.index) {
      Option<Segments.ObservationView>.Some {value: held} => move held _ => { return false }
    }
    let target = match move Segments.observation(Frozen<SealedSegment>.get(&segments[targetOwner]), entries[at].target.index) {
      Option<Segments.ObservationView>.Some {value: held} => move held _ => { return false }
    }
    if !source.input || !target.input || source.selector != target.selector
      || !ContentHash.equals(source.digest, target.digest) || !Encoding.equals(source.key, target.key) { return false }
    let sourceFile = match move source.file {
      Option<Segments.Reference>.Some {value: held} => held _ => { return false }
    }
    let targetFile = match move target.file {
      Option<Segments.Reference>.Some {value: held} => held _ => { return false }
    }
    let old = match move fileObservation(segments, sourceOwner, sourceFile) {
      Option<Segments.ObservationView>.Some {value: held} => move held _ => { return false }
    }
    let fresh = match move fileObservation(segments, targetOwner, targetFile) {
      Option<Segments.ObservationView>.Some {value: held} => move held _ => { return false }
    }
    if old.input || fresh.input || !Encoding.equals(old.key, fresh.key) { return false }
    at = at + usize.ONE
  }
  return true
}

fn validCertificateAnchors(value: &Generation, segments: &[Frozen<SealedSegment>]) -> bool {
  let proof = match &value.certificate {
    Option<Certificate>.Some {value: held} => &held _ => { return true }
  }
  let catalog = List<Descriptor>.asSlice(&value.catalog)
  let anchors = List<LeafHandle>.asSlice(&proof.anchors)
  let mut at = usize.ZERO
  while at < anchors.length {
    let owner = catalogPosition(catalog, anchors[at].segment)
    let observed = match move Segments.observation(Frozen<SealedSegment>.get(&segments[owner]), anchors[at].index) {
      Option<Segments.ObservationView>.Some {value: held} => move held _ => { return false }
    }
    // Input digest zero is CacheImage's changed-input sentinel, never successful evidence.
    if observed.input && observed.digest.high == 0 && observed.digest.low == 0 { return false }
    at = at + usize.ONE
  }
  return true
}

/// Authenticates the exact sealed owners of a catalog, then checks selected key uniqueness.
/// Only the returned requirements may retain packs; an unselected physical answer has no authority.
pub effect fn admit(value: &Generation, segments: &[Frozen<SealedSegment>]) -> Option<Requirements>
! OutOfMemoryError ? &mut Allocator {
  if !validShape(value) { return Option<Requirements>.none() }
  let catalog = List<Descriptor>.asSlice(&value.catalog)
  if segments.length != catalog.length { return Option<Requirements>.none() }
  let mut at = usize.ZERO
  while at < catalog.length {
    let segment = Frozen<SealedSegment>.get(&segments[at])
    let actual = Segments.descriptor(segment)
    if !sameDescriptor(&catalog[at], &actual)
      || !Encoding.equals(Bytes.asSlice(&value.stamp), Segments.stamp(segment))
      || !Segments.authenticateImports(segment, Slice.view<Frozen<SealedSegment>>(segments, usize.ZERO, at)) { return Option<Requirements>.none() }
    at = at + usize.ONE
  }
  if !validPlacements(value, segments) { return Option<Requirements>.none() }
  if !validCertificateAnchors(value, segments) { return Option<Requirements>.none() }
  let mut keys = InternIndex.make()
  let mut roots = List<RootPosition>.make()
  let mut packIndex = InternIndex.make()
  let mut packs = List<ContentHash>.make()
  let selections = List<Selection>.asSlice(&value.selections)
  at = usize.ZERO
  while at < selections.length {
    let segment = catalogPosition(catalog, selections[at].segment)
    let mut root = usize.ZERO
    while root < catalog[segment].roots {
      if selected(&selections[at], root) {
        let key = match move Segments.rootKey(Frozen<SealedSegment>.get(&segments[segment]), root) {
          Option<&[u8]>.Some {value: bytes} => bytes
          _ => { return Option<Requirements>.none() }
        }
        let hash = ContentHash.of(key)
        let mut known = InternIndex.first(&keys, hash.low)
        while known != usize.MAX {
          let previous = &List<RootPosition>.asSlice(&roots)[known]
          let old = match move Segments.rootKey(Frozen<SealedSegment>.get(&segments[previous.segment]), previous.root) {
            Option<&[u8]>.Some {value: bytes} => bytes
            _ => { return Option<Requirements>.none() }
          }
          if Encoding.equals(key, old) { return Option<Requirements>.none() }
          known = InternIndex.after(&keys, known)
        }
        run InternIndex.record(&mut keys, hash.low)
        run List<RootPosition>.append(&mut roots, RootPosition {segment: segment, root: root})
        let packCount = Segments.rootPackCount(Frozen<SealedSegment>.get(&segments[segment]), root)
        let mut pack = usize.ZERO
        while pack < packCount {
          let hash = match move Segments.rootPack(Frozen<SealedSegment>.get(&segments[segment]), root, pack) {
            Option<ContentHash>.Some {value: held} => held
            _ => { return Option<Requirements>.none() }
          }
          let mut known = InternIndex.first(&packIndex, hash.low)
          let mut found = false
          while known != usize.MAX {
            if ContentHash.equals(List<ContentHash>.get(&packs, known), hash) { found = true break }
            known = InternIndex.after(&packIndex, known)
          }
          if !found {
            run InternIndex.record(&mut packIndex, hash.low)
            run List<ContentHash>.append(&mut packs, hash)
          }
          pack = pack + usize.ONE
        }
      }
      root = root + usize.ONE
    }
    at = at + usize.ONE
  }
  return Option<Requirements>.some(Requirements {packs: move packs, roots: List<RootPosition>.length(&roots)})
}
