  return listed(members, name)
}

/// Whether the canonical language catalog defines an `Intrinsic` type family by this spelling.
pub fn typeFamily(name: &[u8]) -> bool {
  let families = b"|SharedCore|Execution|ExecutionRef|StorageFailure|Type|Fields|Field|StaticSequence|Test|Tests|TestInfo|"
  return listed(families, name)
}

// Whether `name` is one `|`-delimited entry of `members`.
fn listed(members: &[u8], name: &[u8]) -> bool {
  let mut start = usize.ONE
  let mut end = usize.ONE
  while end < members.length {
    if members[end] == 124 {
      if end - start == name.length {
        let mut at = usize.ZERO
        while at < name.length && members[start + at] == name[at] {
          at = at + usize.ONE
        }
        if at == name.length {
          return true
        }
      }
      start = end + usize.ONE
    }
    end = end + usize.ONE
  }
  return false
}
