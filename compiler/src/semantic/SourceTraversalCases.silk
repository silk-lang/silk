//! Structural occurrence/selection controls for the complete-source visitor. These use the
//! public prepared-body boundary once; they do not assert source-policy or language acceptance.

import hir.Hir {Access as ReferenceAccess}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.Lifetime {Lifetime}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Semantic {Constraint}
import semantic.SourceAnalysis {EvalId, Evaluation, EvaluationRole, EvaluationSite, SelectionUse}
import semantic.SourceFlow {Flow, Point, PointId, Write}
import semantic.SourceLocations {Location}
import semantic.SourcePreparation as Prepared
import semantic.SourcePreparation {EndpointId, EndpointRole, MapId, MapKind, Root, Selector, ShapeId}
import semantic.SourceRules {Program, Solution, Truth}
import semantic.SourceTraversal as Traversal
import semantic.SourceTraversal {Access, ArmResult, Input, Loop, Owner, OwnerAction, OwnerExit, Subject, Visit}
import semantic.Type {Type}
import semantic.TypedBody {BindingAccess, Expression, Local, LocalId, MatchArm, MatchSyntax, Node,
  NodeId, NodeKind, Origin, Pattern, PatternTest, PlaceRoot, PlaceStep, ConsumedPlace, SafetyObligation, SubjectAccess}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.shared {Shared}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.list {List}
import CompilerBug

// Gate: exact occurrence/map selection and feasible CFG edges are observable outputs of reserve.
// Regressions include last-same-node lookup, omitted Dereference, strong unknown-index writes,
// subject reevaluation, local entry initialization, and a literal loop's invented exit edge.
// Existing SourceFlow tests supply a CFG themselves and cannot catch these visitor mistakes.
// No export, query hook, alternate evaluator, or second fixture session is needed.
test effect fn traversalRetainsActualProjectionOccurrencesAndLoopFlow() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run traversalClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct Code { nodes: List<Node>, shapes: List<usize> }

effect fn traversalClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"source", b"traversal.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let unit = run Shared<Type>.make(Type.Unit)
  let lifetime = run Shared<Lifetime>.make(Lifetime.Static)
  let reference = run Shared<Type>.make(Type.Reference {referent: Shared<Type>.clone(&unit),
    access: ReferenceAccess.Shared, lifetime: Shared<Lifetime>.clone(&lifetime)})
  let slice = run Shared<Type>.make(Type.Slice {element: Shared<Type>.clone(&unit),
    access: ReferenceAccess.Shared, lifetime: Shared<Lifetime>.clone(&lifetime)})
  let indexType = run Shared<Type>.make(Type.Primitive {name: run Bytes.copy(b"usize")})
  let boolean = run Shared<Type>.make(Type.Primitive {name: run Bytes.copy(b"bool")})
  let mut shapes = List<Prepared.Shape>.make()
  run shape(&mut shapes, &unit, Prepared.ShapeState.KnownEmpty, Option<Selector>.none())
  run shape(&mut shapes, &reference, Prepared.ShapeState.Reference, Option<Selector>.some(Selector.Referent))
  run shape(&mut shapes, &slice, Prepared.ShapeState.Slice,
    Option<Selector>.some(Selector.Index {class: Prepared.IndexClass.Remainder}))
  run shape(&mut shapes, &indexType, Prepared.ShapeState.KnownEmpty, Option<Selector>.none())
  run shape(&mut shapes, &boolean, Prepared.ShapeState.KnownEmpty, Option<Selector>.none())
  let mut locals = List<Local>.make()
  run local(&mut locals, &reference)
  run local(&mut locals, &slice)
  run local(&mut locals, &indexType)
  run local(&mut locals, &boolean)
  run local(&mut locals, &boolean)
  let mut code = Code {nodes: List<Node>.make(), shapes: List<usize>.make()}
  let base = run expression(&mut code, &reference, 1, Expression.Local {local: LocalId {index: 0}})
  let dereference = run expression(&mut code, &unit, 0, Expression.Dereference {value: base})
  let view = run expression(&mut code, &slice, 2, Expression.Local {local: LocalId {index: 1}})
  let index = run expression(&mut code, &indexType, 3, Expression.Local {local: LocalId {index: 2}})
  let indexed = run expression(&mut code, &unit, 0, Expression.Index {value: view, index: index, element: usize.MAX})
  let no = run expression(&mut code, &boolean, 4, Expression.Boolean {value: false})
  let yes = run expression(&mut code, &boolean, 4, Expression.Boolean {value: true})
  let initialized = run statement(&mut code, NodeKind.LocalBinding {local: LocalId {index: 4}, initializer: yes})
  let binding = run expression(&mut code, &reference, 1, Expression.PatternBinding {subject: base,
    path: List<PlaceStep>.make(), access: BindingAccess.Place, declared: Shared<Type>.clone(&reference)})
  let bindingUse = run expression(&mut code, &reference, 1, Expression.PatternBinding {subject: base,
    path: List<PlaceStep>.make(), access: BindingAccess.Place, declared: Shared<Type>.clone(&reference)})
  let arm = run block(&mut code, &[bindingUse], true)
  let mut arms = List<MatchArm>.make()
  let mut bindings = List<NodeId>.make()
  run List<NodeId>.append(&mut bindings, binding)
  run List<MatchArm>.append(&mut arms, MatchArm {origin: origin(binding.index), pattern: Pattern.Universal,
    tests: List<PatternTest>.make(), guard: Option<NodeId>.none(), result: arm, bindings: move bindings})
  let matched = run expression(&mut code, &unit, 0, Expression.Match {subject: base,
    access: SubjectAccess.Place {access: BindingAccess.Place}, tags: usize.ZERO, domain: usize.ONE,
    arms: move arms, syntax: MatchSyntax.Match})
  let skippedBody = run block(&mut code, &[dereference], true)
  let skipped = run statement(&mut code, NodeKind.While {condition: no, body: skippedBody})
  let stop = run statement(&mut code, NodeKind.Break)
  let stoppedBody = run block(&mut code, &[stop], false)
  let stopped = run statement(&mut code, NodeKind.While {condition: yes, body: stoppedBody})
  let condition = run expression(&mut code, &boolean, 4, Expression.Local {local: LocalId {index: 3}})
  // Reuse both typed guard and result nodes: only the arm's actual input coordinates may
  // identify their occurrences. A consumed place is addressed once, without an extra Read.
  let consumedResult = run block(&mut code, &[], true)
  let mut consumedArms = List<MatchArm>.make()
  let mut consumedArm = usize.ZERO
  while consumedArm < 2 {
    run List<MatchArm>.append(&mut consumedArms, MatchArm {origin: origin(condition.index), pattern: Pattern.Universal,
      tests: List<PatternTest>.make(), guard: Option<NodeId>.some(yes), result: consumedResult, bindings: List<NodeId>.make()})
    consumedArm = consumedArm + usize.ONE
  }
  let consumedMatch = run expression(&mut code, &unit, 0, Expression.Match {subject: condition,
    access: SubjectAccess.Consume {consumed: Option<ConsumedPlace>.some(ConsumedPlace {
      root: PlaceRoot.Local {local: LocalId {index: 3}}, steps: List<PlaceStep>.make()})},
    tags: usize.ZERO, domain: usize.ONE, arms: move consumedArms, syntax: MatchSyntax.Match})
  let again = run statement(&mut code, NodeKind.Continue)
  let repeatedBody = run block(&mut code, &[again], false)
  let repeated = run statement(&mut code, NodeKind.While {condition: condition, body: repeatedBody})
  let forever = run statement(&mut code, NodeKind.While {condition: yes, body: repeatedBody})
  let initializedScope = run block(&mut code, &[initialized], true)
  let root = run block(&mut code, &[initializedScope, dereference, dereference, indexed, matched, consumedMatch,
    skipped, stopped, repeated, forever, dereference], false)
  let supplied = List<Shared<Lifetime>>.make()
  let obligations = List<SafetyObligation>.make()
  let premises = List<Prepared.RegionBound>.make()
  let constraints = List<Constraint>.make()
  let body = Prepared.Body {owner: &owner, supplied: List<Shared<Lifetime>>.asSlice(&supplied),
    locals: List<Local>.asSlice(&locals), nodes: List<Node>.asSlice(&code.nodes), root: root, pending: false,
    obligations: List<SafetyObligation>.asSlice(&obligations), premises: List<Prepared.RegionBound>.asSlice(&premises),
    constraints: List<Constraint>.asSlice(&constraints), coverage: Prepared.Coverage.Complete}
  let mut prepared = package(move body, move shapes)
  let localShapes: [usize; 5] = [1, 2, 3, 4, 4]
  let mut localRoots = List<EndpointId>.make()
  let mut at = usize.ZERO
  while at < localShapes.length {
    let root = run endpoint(&mut prepared, Root.Local {local: LocalId {index: at}, role: EndpointRole.Storage},
      usize.MAX, Selector.Identity, localShapes[at])
    run List<EndpointId>.append(&mut localRoots, root)
    at = at + usize.ONE
  }
  let mut values = List<EndpointId>.make()
  let mut storage = List<EndpointId>.make()
  let selectedShapes = List<usize>.asSlice(&code.shapes)
  at = usize.ZERO
  while at < selectedShapes.length {
    let mut value = EndpointId {index: usize.MAX}
    let mut place = EndpointId {index: usize.MAX}
    if selectedShapes[at] != usize.MAX {
      value = run endpoint(&mut prepared, Root.Node {node: NodeId {index: at}, role: EndpointRole.Value},
        usize.MAX, Selector.Identity, selectedShapes[at])
      place = run endpoint(&mut prepared, Root.Node {node: NodeId {index: at}, role: EndpointRole.Storage},
        usize.MAX, Selector.Identity, selectedShapes[at])
    }
    run List<EndpointId>.append(&mut values, value)
    run List<EndpointId>.append(&mut storage, place)
    at = at + usize.ONE
  }
  let values = List<EndpointId>.asSlice(&values)
  let storage = List<EndpointId>.asSlice(&storage)
  let localRoots = List<EndpointId>.asSlice(&localRoots)
  let localNodes: [NodeId; 4] = [base, view, index, condition]
  at = usize.ZERO
  while at < localNodes.length {
    drop run map(&mut prepared, localNodes[at], localRoots[at], values[localNodes[at].index], MapKind.Copy, Selector.Identity)
    drop run map(&mut prepared, localNodes[at], localRoots[at], storage[localNodes[at].index], MapKind.Select, Selector.Identity)
    at = at + usize.ONE
  }
  drop run map(&mut prepared, initialized, values[yes.index], localRoots[4], MapKind.Place, Selector.Identity)
  drop run map(&mut prepared, condition, values[condition.index], storage[condition.index], MapKind.Place, Selector.Identity)
  let referent = run endpoint(&mut prepared, Root.Node {node: base, role: EndpointRole.Value},
    values[base.index].index, Selector.Referent, 0)
  let dereferenceSelector = run projectionMaps(&mut prepared, dereference, values[base.index], referent,
    values[dereference.index], storage[dereference.index], Option<Selector>.some(Selector.Referent))
  let element = run endpoint(&mut prepared, Root.Node {node: view, role: EndpointRole.Value},
    values[view.index].index, Selector.Index {class: Prepared.IndexClass.Remainder}, 0)
  let indexSelector = run projectionMaps(&mut prepared, indexed, values[view.index], element,
    values[indexed.index], storage[indexed.index], Option<Selector>.some(Selector.Index {class: Prepared.IndexClass.Remainder}))
  drop run projectionMaps(&mut prepared, binding, storage[base.index], storage[base.index],
    values[binding.index], storage[binding.index], Option<Selector>.none())
  drop run projectionMaps(&mut prepared, bindingUse, storage[base.index], storage[base.index],
    values[bindingUse.index], storage[bindingUse.index], Option<Selector>.none())
  let mut reserved = run Traversal.reserve(&prepared)
  let visits = List<Visit>.asSlice(&reserved.visits)
  let selections = List<SelectionUse>.asSlice(&reserved.skeleton.selections)
  let evaluations = List<Evaluation>.asSlice(&reserved.skeleton.evaluations)
  let mut dereferences = List<EvalId>.make()
  let mut dereferencePoints = List<usize>.make()
  let mut indices = usize.ZERO
  let mut patterns = usize.ZERO
  let mut matchControls = usize.ZERO
  let mut patternSelections = List<usize>.make()
  at = usize.ZERO
  while at < visits.length {
    let visit = &visits[at]
    if visit.node.index == matched.index || visit.node.index == consumedMatch.index {
      let arms = List<ArmResult>.asSlice(&visit.armInputs)
      let inputs = List<Input>.asSlice(&visit.inputs)
      if visit.node.index == matched.index {
        let noGuard = match arms[0].guard { Option<usize>.None => true _ => false }
        run Testing.expect(arms.length == usize.ONE && noGuard && inputs[0].access == Access.Place
          && arms[0].entry.index < evaluations[inputs[arms[0].input].evaluation.index].point.index,
          "unguarded place matches retain the real arm entry and no guard operand")
      } else {
        run Testing.expect(arms.length == 2 && inputs[0].access == Access.Place
          && inputs[0].node.index == condition.index && inputs.length == 5,
          "consuming a typed place addresses one subject without an extra value access")
        let mut arm = usize.ZERO
        let mut priorGuard = usize.MAX
        while arm < arms.length {
          let guard = match arms[arm].guard {
            Option<usize>.Some {value} => value
            _ => { return CompilerBug.panic(b"test lost its actual guarded arm coordinate") }
          }
          run Testing.expect(guard < arms[arm].input && inputs[guard].node.index == yes.index
            && inputs[arms[arm].input].node.index == consumedResult.index
            && inputs[guard].evaluation.index != priorGuard
            && arms[arm].entry.index < evaluations[inputs[guard].evaluation.index].point.index
            && inputs[guard].usePoint.index < evaluations[inputs[arms[arm].input].evaluation.index].point.index
            && evaluations[inputs[arms[arm].input].evaluation.index].point.index <= arms[arm].completed.index,
            "repeated guard/result nodes retain distinct occurrences inside their own arm intervals")
          priorGuard = inputs[guard].evaluation.index
          arm = arm + usize.ONE
        }
      }
      matchControls = matchControls + usize.ONE
    }
    if visit.node.index == dereference.index || visit.node.index == indexed.index || (visit.node.index == binding.index || visit.node.index == bindingUse.index) {
      let request = selectionFor(selections, visit.evaluation)
      let inputs = List<Input>.asSlice(&visit.inputs)
      run Testing.expect(request.operand.index == inputs[0].evaluation.index
        && request.result.index == visit.evaluation.index, "selection uses its actual operand and result occurrences")
      let selectors = List<MapId>.asSlice(&request.selectors)
      if visit.node.index == dereference.index {
        run Testing.expect(selectors.length == usize.ONE && selectors[0].index == dereferenceSelector.index
          && request.strength == Write.Strong, "dereference retains its exact Referent selector")
        run List<EvalId>.append(&mut dereferences, visit.evaluation)
        run List<usize>.append(&mut dereferencePoints, evaluations[visit.evaluation.index].point.index)
      }
      if visit.node.index == indexed.index {
        run Testing.expect(inputs.length == 2 && inputs[0].node.index == view.index && inputs[1].node.index == index.index
          && selectors.length == usize.ONE && selectors[0].index == indexSelector.index && request.strength == Write.Weak,
          "slice indexing evaluates base then index and preserves weak writes")
        indices = indices + usize.ONE
      }
      if visit.node.index == binding.index || visit.node.index == bindingUse.index {
        let subject = List<Subject>.asSlice(&reserved.subjects)[0]
        run Testing.expect(request.operand.index == subject.evaluation.index && selectors.length == usize.ZERO,
          "empty pattern paths reuse the retained subject rather than reevaluating it")
        run List<usize>.append(&mut patternSelections, request.selection.index)
        patterns = patterns + usize.ONE
      }
      let copy = match request.value { Option<MapId>.Some {value} => value _ => { return CompilerBug.panic(b"test lost value family") } }
      let alias = match request.place { Option<MapId>.Some {value} => value _ => { return CompilerBug.panic(b"test lost place family") } }
      let maps = List<Prepared.SelectionMap>.asSlice(&prepared.maps)
      run Testing.expect(maps[copy.index].target.index == values[visit.node.index].index
        && maps[alias.index].target.index == storage[visit.node.index].index
        && maps[copy.index].source.index == maps[alias.index].source.index,
        "value and place families share the exact selected component")
    }
    at = at + usize.ONE
  }
  let selectedPatterns = List<usize>.asSlice(&patternSelections)
  run Testing.expect(matchControls == 2, "both original place and consuming guarded matches were checked")
  run Testing.expect(selectedPatterns.length == 2 && selectedPatterns[0] != selectedPatterns[1],
    "distinct empty pattern uses retain their own prepared selection identities")
  let actual = List<EvalId>.asSlice(&dereferences)
  run Testing.expect(actual.length == 4 && actual[0].index != actual[1].index && indices == usize.ONE && patterns == 2,
    "repeated nodes remain distinct even in false-loop and noncompleting suffix occurrences")
  let mut entries = usize.ZERO
  at = usize.ZERO
  while at < evaluations.length {
    if let EvaluationSite.Entry {local} = evaluations[at].site {
      run Testing.expect(local.index < 4, "an authored binding is not initialized at body entry")
      entries = entries + usize.ONE
    }
    at = at + usize.ONE
  }
  run Testing.expect(entries == 4, "all and only actual parameter locals initialize at entry")
  let ownerExits = List<OwnerExit>.asSlice(&reserved.ownerExits)
  let owners = List<Owner>.asSlice(&reserved.owners)
  let mut cleanupReads = usize.ZERO
  at = usize.ZERO
  while at < ownerExits.length {
    let action = &ownerExits[at]
    match action.read {
      Option<EvalId>.Some {value} => {
        run Testing.expect((action.action == OwnerAction.Use || action.action == OwnerAction.Cleanup)
          && evaluations[value.index].role == EvaluationRole.Cleanup
          && evaluations[value.index].point.index == action.point.index
          && owners[action.owner.index].initialized.index != action.point.index,
          "owner observations read current storage at the actual action, not its acquisition")
        cleanupReads = cleanupReads + usize.ONE
      }
      Option<EvalId>.None => {
        run Testing.expect(action.action == OwnerAction.End || action.action == OwnerAction.Expire,
          "ending or expiring storage creates no synthetic value observation")
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(cleanupReads > usize.ZERO, "the fixture reserves owner cleanup observations")
  // One terminal emission of the same reserved flow; no hand-built second CFG or source solve.
  let reaching = run Flow.emit(move reserved.skeleton.flow, &mut reserved.skeleton.rules)
  let solved = run Program.solve(&reserved.skeleton.rules)
  let points = List<Point>.asSlice(&reaching.points)
  let mut reachedCleanup = false
  at = usize.ZERO
  while at < ownerExits.length {
    if ownerExits[at].action == OwnerAction.Cleanup
      && Solution.truth(&solved, points[ownerExits[at].point.index].reachable) == Truth.True { reachedCleanup = true }
    at = at + usize.ONE
  }
  run Testing.expect(reachedCleanup, "the initialized inner binding has an actual completing cleanup path")
  let reads = List<usize>.asSlice(&dereferencePoints)
  run Testing.expect(Solution.truth(&solved, points[reads[0]].reachable) == Truth.True
    && Solution.truth(&solved, points[reads[1]].reachable) == Truth.True
    && Solution.truth(&solved, points[reads[2]].reachable) == Truth.False
    && Solution.truth(&solved, points[reads[3]].reachable) == Truth.False,
    "false-loop bodies and the suffix after while true remain structurally present but unreachable")
  let loops = List<Loop>.asSlice(&reserved.loops)
  run Testing.expect(loops.length == 4
    && Solution.truth(&solved, points[loops[0].exit.index].reachable) == Truth.True
    && Solution.truth(&solved, points[loops[1].exit.index].reachable) == Truth.True
    && Solution.truth(&solved, points[loops[2].exit.index].reachable) == Truth.True
    && Solution.truth(&solved, points[loops[3].exit.index].reachable) == Truth.False,
    "false skips, true breaks, unknown zero iterations, and true noncompletion stay distinct")
  run Testing.expect(!reachableBackedge(&loops[0], points, &solved) && !reachableBackedge(&loops[1], points, &solved)
    && reachableBackedge(&loops[2], points, &solved) && reachableBackedge(&loops[3], points, &solved),
    "false bodies and breaks do not repeat; both actual continue occurrences reach their own headers")
  return ()
}

fn origin(index: usize) -> Origin { return Origin {node: index, location: Location.make(index, index + usize.ONE)} }

effect fn local(locals: &mut List<Local>, ty: &Shared<Type>) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Local>.append(&mut locals.*, Local {origin: origin(List<Local>.length(&locals.*)),
    ty: Shared<Type>.clone(ty), mutable: false, meetDepth: Option<usize>.none(), written: true})
  return ()
}

effect fn shape(shapes: &mut List<Prepared.Shape>, ty: &Shared<Type>, state: Prepared.ShapeState,
  selector: Option<Selector>) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut components = List<Prepared.Component>.make()
  if let Option<Selector>.Some {value} = move selector {
    let unit = run Shared<Type>.make(Type.Unit)
    run List<Prepared.Component>.append(&mut components, Prepared.Component {selector: move value,
      ty: move unit, inline: false, representation: Option<Prepared.RepresentationId>.none()})
  }
  run List<Prepared.Shape>.append(&mut shapes.*, Prepared.Shape {context: Prepared.ShapeContext.Body,
    ty: Shared<Type>.clone(ty), state: move state, components: move components})
  return ()
}

effect fn expression(code: &mut Code, ty: &Shared<Type>, shape: usize, form: Expression) -> NodeId
! OutOfMemoryError ? &mut Allocator {
  let id = NodeId {index: List<Node>.length(&code.nodes)}
  run List<Node>.append(&mut code.nodes, Node {origin: origin(id.index), kind: NodeKind.Expression {ty: Shared<Type>.clone(ty), form: move form}})
  run List<usize>.append(&mut code.shapes, shape)
  return id
}

effect fn statement(code: &mut Code, kind: NodeKind) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let id = NodeId {index: List<Node>.length(&code.nodes)}
  run List<Node>.append(&mut code.nodes, Node {origin: origin(id.index), kind: move kind})
  run List<usize>.append(&mut code.shapes, usize.MAX)
  return id
}

effect fn block(code: &mut Code, nodes: &[NodeId], completes: bool) -> NodeId ! OutOfMemoryError ? &mut Allocator {
  let mut statements = List<NodeId>.make()
  let mut at = usize.ZERO
  while at < nodes.length { run List<NodeId>.append(&mut statements, nodes[at]) at = at + usize.ONE }
  return run statement(&mut code.*, NodeKind.Block {statements: move statements, canComplete: completes})
}

effect fn endpoint<'body>(prepared: &mut Prepared.SourcePreparation<'body>, root: Root, parent: usize,
  selector: Selector, shape: usize) -> EndpointId ! OutOfMemoryError ? &mut Allocator {
  let id = EndpointId {index: List<Prepared.Endpoint>.length(&prepared.endpoints)}
  let mut ancestor = Option<EndpointId>.none()
  if parent != usize.MAX { ancestor = Option<EndpointId>.some(EndpointId {index: parent}) }
  run List<Prepared.Endpoint>.append(&mut prepared.endpoints, Prepared.Endpoint {root: move root, parent: move ancestor,
    selector: move selector, shape: ShapeId {index: shape}, origin: origin(id.index)})
  return id
}

effect fn map<'body>(prepared: &mut Prepared.SourcePreparation<'body>, site: NodeId, source: EndpointId,
  target: EndpointId, kind: MapKind, selector: Selector) -> MapId ! OutOfMemoryError ? &mut Allocator {
  let id = MapId {index: List<Prepared.SelectionMap>.length(&prepared.maps)}
  let identity = match &selector { Selector.Identity => true _ => false }
  let endpoints = List<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  let sourceStorage = match &endpoints[source.index].root {
    Root.Local {role, ..} => role == EndpointRole.Storage
    Root.Node {role, ..} => role == EndpointRole.Storage
    _ => false
  }
  let targetStorage = match &endpoints[target.index].root {
    Root.Local {role, ..} => role == EndpointRole.Storage
    Root.Node {role, ..} => role == EndpointRole.Storage
    _ => false
  }
  run List<Prepared.SelectionMap>.append(&mut prepared.maps, Prepared.SelectionMap {site: site, origin: origin(site.index),
    source: source, target: target, selector: move selector, kind: kind, application: Option<Prepared.ApplicationId>.none(),
    children: List<MapId>.make(), componentTransport: identity && kind != MapKind.Select, addressTransport: identity && kind == MapKind.Select && sourceStorage && targetStorage,
    boundaries: List<Prepared.BoundaryTransitionId>.make()})
  return id
}

effect fn projectionMaps<'body>(prepared: &mut Prepared.SourcePreparation<'body>, site: NodeId,
  root: EndpointId, selected: EndpointId, value: EndpointId, storage: EndpointId, selector: Option<Selector>) -> MapId
! OutOfMemoryError ? &mut Allocator {
  let mut maps = List<MapId>.make()
  let mut step = MapId {index: usize.MAX}
  if let Option<Selector>.Some {value: selector} = move selector {
    step = run map(&mut prepared.*, site, root, selected, MapKind.Select, move selector)
    run List<MapId>.append(&mut maps, step)
  }
  let mut accepts = List<EndpointId>.make()
  run List<EndpointId>.append(&mut accepts, selected)
  run List<Prepared.Selection>.append(&mut prepared.selections, Prepared.Selection {site: site, root: root, maps: move maps, accepts: move accepts})
  drop run map(&mut prepared.*, site, selected, value, MapKind.Copy, Selector.Identity)
  drop run map(&mut prepared.*, site, selected, storage, MapKind.Select, Selector.Identity)
  return step
}

fn selectionFor(selections: &[SelectionUse], result: EvalId) -> &SelectionUse {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < selections.length {
    if selections[at].result.index == result.index {
      if found != usize.MAX { return CompilerBug.panic(b"test found duplicate projection requests") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"test projection request is missing") }
  return &selections[found]
}

fn package<'body>(body: Prepared.Body<'body>, shapes: List<Prepared.Shape>) -> Prepared.SourcePreparation<'body> {
  return Prepared.SourcePreparation {body: move body, shapes: move shapes, endpoints: List<Prepared.Endpoint>.make(),
    representations: List<Prepared.Representation>.make(), applications: List<Prepared.Application>.make(),
    maps: List<Prepared.SelectionMap>.make(), selections: List<Prepared.Selection>.make(),
    residuals: List<Prepared.ResidualState>.make(), boundarySubstitutions: List<Prepared.BoundarySubstitution>.make(),
    boundaryTransitions: List<Prepared.BoundaryTransition>.make(), routes: List<Prepared.ContractRoute>.make(),
    contractSelections: List<Prepared.ContractSelection>.make(), contractProjections: List<Prepared.ContractProjection>.make(),
    contractContinuations: List<Prepared.ContractContinuation>.make(), replacements: List<Prepared.Replacement>.make(),
    arraySlices: List<Prepared.ArraySlice>.make(), borrows: List<Prepared.Borrow>.make(),
    constructions: List<Prepared.Construction>.make(), operations: List<Prepared.Operation>.make(),
    predicates: List<Prepared.Predicate>.make(), premises: List<Prepared.PredicateId>.make(), obligations: List<Prepared.Obligation>.make()}
}

fn reachableBackedge(repeat: &Loop, points: &[Point], solved: &Solution) -> bool {
  let backedges = List<PointId>.asSlice(&repeat.backedges)
  let mut at = usize.ZERO
  while at < backedges.length {
    if Solution.truth(solved, points[backedges[at].index].reachable) == Truth.True { return true }
    at = at + usize.ONE
  }
  return false
}
