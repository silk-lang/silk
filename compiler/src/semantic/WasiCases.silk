//! Named WebAssembly imports and WIT-compatible export linkage.
import semantic.Semantic {BackendBuild, Request, staticClosureNodes}
import semantic.SemanticCaseSupport {module, applicationSemantic, buildApplication, containsIr, foreignContractGapAt}
import semantic.Types {TypeTable, Types}
import semantic.Target {Id as TargetId, Target as MachineTarget}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.SourceIndex {RevisionMismatch}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.testing {AssertionError, Testing}


test effect fn wasmImportsPreserveModuleAndMemberNames() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  let id = run module("wasm-imports.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """unsafe extern "C" fn left(value: i32) -> i32 as "example:left/api@1.0.0#[method]item.read"
unsafe extern "C" fn right(value: i32) -> i32 as "example:right/api@1.0.0#[method]item.read"
export "C" fn exported(value: i32) -> i32 as "example:exports/api@1.0.0#read" { return value }
pub fn main() -> i32 { return unsafe left(1) + unsafe right(2) }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.Wasm32Wasip2)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut correct = false
  if let BackendBuild.Module {text, ..} = &built {
    let ir = Bytes.asSlice(&text)
    correct = containsIr(ir, b"\"wasm-import-module\"=\"example:left/api@1.0.0\"")
      && containsIr(ir, b"\"wasm-import-module\"=\"example:right/api@1.0.0\"")
      && containsIr(ir, b"\"wasm-import-name\"=\"[method]item.read\"")
      && containsIr(ir, b"\"wasm-export-name\"=\"example:exports/api@1.0.0#read\"")
  }
  run Testing.expect(correct, "Wasm import modules and members and punctuated export names survive LLVM lowering")
}

test effect fn wasmImportPropertiesRejectNativeTargetsAndEmptyModules() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  let id = run module("wasm-import-refusals.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let sources = [
    "unsafe extern \"C\" fn host() -> i32 as \"host#\"\npub fn main() -> i32 { return unsafe host() }\n",
    "unsafe extern \"C\" fn host() -> i32 as \"#\"\npub fn main() -> i32 { return unsafe host() }\n"
  ]
  let targets = [TargetId.X8664UnknownLinuxGnu, TargetId.Wasm32Wasip2]
  let mut at: usize = 0
  while at < sources.length {
    let mut store = run applicationSemantic(&id, sources[at], MachineTarget.forId(targets[at])) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut request = Request.forApplication(ModuleId.copy(&id))
    let built = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(foreignContractGapAt(&built, 0), "invalid named-module contracts report the foreign declaration span")
    at = at + 1
  }
}

test effect fn wasmShorthandImportsClaimTheirOwnNames() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  let id = run module("wasm-shorthand-imports.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """unsafe extern "C" fn read() -> i32 as "env#"
unsafe extern "C" fn write() -> i32 as "env#"
unsafe extern "C" fn legacy() -> i32 as "sym" with Intrinsic.foreign(module: "old")
pub fn main() -> i32 { return unsafe read() + unsafe write() + unsafe legacy() }
"""
  let mut store = run applicationSemantic(&id, source, MachineTarget.forId(TargetId.Wasm32Wasip2)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut correct = false
  if let BackendBuild.Module {text, ..} = &built {
    let ir = Bytes.asSlice(&text)
    correct = containsIr(ir, b"\"wasm-import-name\"=\"read\"") && containsIr(ir, b"\"wasm-import-name\"=\"write\"")
      && containsIr(ir, b"__silk_import_env_23read") && containsIr(ir, b"__silk_import_env_23write")
      && containsIr(ir, b"\"wasm-import-module\"=\"old\"") && containsIr(ir, b"\"wasm-import-name\"=\"sym\"")
  }
  run Testing.expect(correct, "`\"env#\"` imports each function's own name, and a clause without `name` imports its `as` name")
}

test effect fn wasmImportFieldsOutsideAnImportAreRefused() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  let id = run module("wasm-import-misplaced.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let sources = [
    "fn plain() -> i32 with Intrinsic.foreign(module: \"m\", name: \"n\") { return 0 }\npub fn main() -> i32 { return plain() }\n",
    "export \"C\" fn exported() -> i32 with Intrinsic.foreign(module: \"m\", name: \"n\") { return 0 }\npub fn main() -> i32 { return exported() }\n",
    "unsafe extern \"C\" fn twice() -> i32 with Intrinsic.foreign(module: \"a\", module: \"b\")\npub fn main() -> i32 { return unsafe twice() }\n",
    "unsafe extern \"C\" fn hashed() -> i32 with Intrinsic.foreign(module: \"a#b\", name: \"c\")\npub fn main() -> i32 { return unsafe hashed() }\n",
    "unsafe extern \"C\" static pair: i32 as \"a#b\"\npub fn main() -> i32 { return unsafe pair }\n"
  ]
  let targets = [TargetId.Wasm32Wasip2, TargetId.Wasm32Wasip2, TargetId.Wasm32Wasip2, TargetId.Wasm32Wasip2, TargetId.X8664UnknownLinuxGnu]
  let mut at: usize = 0
  while at < sources.length {
    let mut store = run applicationSemantic(&id, sources[at], MachineTarget.forId(targets[at])) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut request = Request.forApplication(ModuleId.copy(&id))
    let built = run buildApplication(&mut store, &mut request, staticClosureNodes) |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
    let refused = match &built {
      BackendBuild.Module {..} => false
      _ => true
    }
    run Testing.expect(refused, "`module` and `name` fold only into a function import's pair, and only a function claims one")
    at = at + 1
  }
}
