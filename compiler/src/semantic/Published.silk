//! Retained immutable compiler payloads, safe to read concurrently when their entire contents are.
//! Thread properties derive through Arc; this wrapper makes no unchecked property assertion.
//! Builders remain owned until publication. No mutable accessor or callback is exposed.
import silk.concurrency.sync {Arc}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.num.usize

/// Owns one immutable payload through an atomic reference count.
/// Thread transfer requires the complete payload to be transferable and concurrently readable.
pub struct Published<T> { value: Arc<T> }

impl<T> Published<T> {
  /// Consumes a finished payload and allocates its shared ownership cell.
  pub effect fn make(value: T) -> Self ! OutOfMemoryError ? &mut Allocator {
    return Self {value: run Arc<T>.make(move value)}
  }
  /// Retains the same payload without copying its contents.
  pub fn clone(self: &Self) -> Self { return Self {value: Arc<T>.clone(&self.value)} }
  /// Borrows the payload while this handle remains borrowed.
  pub fn get<'a>(self: &'a Self) -> &'a T { return Arc<T>.get(&self.value) }
  /// Invokes a callback with a shared borrow; concurrent readers do not exclude each other.
  pub fn with<A>(self: &Self, use: once fn(&T) -> A) -> A { return use(Arc<T>.get(&self.value)) }
  /// Returns an instantaneous handle count, which other threads may immediately change.
  pub fn count(self: &Self) -> usize { return Arc<T>.count(&self.value) }
  /// Whether two retained handles own the same immutable allocation.
  pub fn same(left: &Self, right: &Self) -> bool { return Self.address(left) == Self.address(right) }
  /// Returns a process-local identity valid only while a handle retains this payload.
  pub fn address(self: &Self) -> usize { return Pointer.address<T>(Pointer.fromRef<T>(Arc<T>.get(&self.value))) }
}
