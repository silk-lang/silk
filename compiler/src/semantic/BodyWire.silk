//! Bounded fields for portable typed-body capsules.
//!
//! Every failed read or exhausted resource budget is sticky. A caller publishes decoded semantic
//! values only after the complete capsule and its independent dependency guard validate.

import semantic.RuntimeEncoding
import semantic.StableKey
import lexer.Span {Span}
import silk.collections.bytes {Bytes}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.num.u64

/// The maximum encoded capsule size, including dictionaries and exact context.
pub const BYTE_LIMIT: usize = 16777216
/// The maximum number of dictionary entries or body locals in one capsule.
pub const ENTRY_LIMIT: usize = 16384
/// The maximum number of body nodes across a capsule.
pub const NODE_LIMIT: usize = 65536
/// The maximum recursive structural depth.
pub const DEPTH_LIMIT: usize = 128
/// The maximum number of primitive or structural operations.
pub const STEP_LIMIT: usize = 1048576

/// Stable, bounded encoder refusal counters. Zero means successful encoding.
pub const NONE: usize = 0
pub const TYPE_SCHEMA: usize = 1
pub const TYPE_WITNESS: usize = 2
pub const STATIC_UNSUPPORTED: usize = 3
pub const RESOURCE: usize = 4
pub const DEPTH: usize = 5
pub const SIZE: usize = 6
pub const MALFORMED_PLAN: usize = 7
pub const OTHER: usize = 8
pub const REASON_COUNT: usize = 9

/// A bounded output transaction. Its bytes are private until every field succeeds.
pub struct Writer {
  pub reason: usize,
  pub bytes: Bytes,
  /// The caller may narrow the hard byte budget before emitting any fields.
  pub limit: usize,
  pub failed: bool,
  pub steps: usize,
  pub depth: usize,
}

/// A bounded input transaction. Local intern-table additions never publish a query answer.
pub struct Reader {
  pub cursor: StableKey.Reader,
  /// Cumulative allocation-bearing counts, charged before reserving containers.
  pub items: usize,
  pub failed: bool,
  pub steps: usize,
  pub depth: usize,
}

/// Starts an empty bounded capsule output.
pub fn writer() -> Writer {
  return Writer {reason: NONE, bytes: Bytes.make(), limit: BYTE_LIMIT, failed: false, steps: usize.ZERO, depth: usize.ZERO}
}

/// Starts a bounded capsule input, refusing oversized bytes before allocation.
pub fn reader(bytes: &[u8]) -> Reader {
  return Reader {cursor: StableKey.reader(), items: usize.ZERO, failed: bytes.length > BYTE_LIMIT,
    steps: usize.ZERO, depth: usize.ZERO}
}

/// Refuses output without replacing an earlier, more specific cause.
pub fn refuse(output: &mut Writer, reason: usize) -> () {
  if !output.failed { output.reason = reason }
  output.failed = true
}

fn charge(output: &mut Writer, count: usize) -> bool {
  if output.failed { return false }
  if output.steps >= STEP_LIMIT { refuse(&mut output.*, RESOURCE) return false }
  if count > output.limit || output.limit > BYTE_LIMIT || Bytes.length(&output.bytes) > output.limit - count {
    refuse(&mut output.*, SIZE)
    return false
  }
  output.steps = output.steps + usize.ONE
  return true
}

/// Appends an unsigned field without exceeding the shared output budget.
pub effect fn word(output: &mut Writer, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  if charge(&mut output.*, 8) { run RuntimeEncoding.word(&mut output.bytes, value) }
}

/// Appends an exact byte field without allocating beyond the shared output budget.
pub effect fn field(output: &mut Writer, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  if value.length > BYTE_LIMIT { refuse(&mut output.*, SIZE)
    return () }
  if charge(&mut output.*, 8 + value.length) { run RuntimeEncoding.field(&mut output.bytes, value) }
}

/// Reads one unsigned field, retaining malformed input as sticky failure.
pub fn readWord(bytes: &[u8], input: &mut Reader) -> u64 {
  if input.failed { return 0 }
  if input.steps >= STEP_LIMIT { input.failed = true
    return 0 }
  input.steps = input.steps + usize.ONE
  let value = StableKey.readWord(bytes, &mut input.cursor)
  if StableKey.failed(&input.cursor) { input.failed = true }
  return value
}

/// Reads one byte-field span whose bounds were validated against the immutable input.
pub fn readField(bytes: &[u8], input: &mut Reader) -> Span {
  if input.failed || input.steps >= STEP_LIMIT {
    input.failed = true
    return Span.make(usize.ZERO, usize.ZERO)
  }
  input.steps = input.steps + usize.ONE
  let span = StableKey.readField(bytes, &mut input.cursor)
  if StableKey.failed(&input.cursor) { input.failed = true }
  return span
}

/// Reads an allocation count bounded by the caller's structural limit.
pub fn count(bytes: &[u8], input: &mut Reader, limit: usize) -> usize {
  let value = readWord(bytes, &mut input.*)
  if input.failed || value > usize.toU64(limit) || value > usize.toU64(STEP_LIMIT - input.items) {
    input.failed = true
    return usize.ZERO
  }
  let count = u64.toUsize(value)
  // Every structural entry has at least one word; reject truncated giant reservations early.
  if count > (bytes.length - StableKey.offset(&input.cursor)) / 8 {
    input.failed = true
    return usize.ZERO
  }
  input.items = input.items + count
  return count
}

/// Enters a bounded recursive encoding scope.
pub fn enterWrite(output: &mut Writer) -> bool {
  if output.failed || output.depth >= DEPTH_LIMIT { refuse(&mut output.*, DEPTH)
    return false }
  output.depth = output.depth + usize.ONE
  return true
}

/// Ends a previously entered recursive encoding scope.
pub fn leaveWrite(output: &mut Writer) -> () {
  if output.depth != usize.ZERO { output.depth = output.depth - usize.ONE }
}

/// Enters a bounded recursive decoding scope.
pub fn enterRead(input: &mut Reader) -> bool {
  if input.failed || input.depth >= DEPTH_LIMIT { input.failed = true
    return false }
  input.depth = input.depth + usize.ONE
  return true
}

/// Ends a previously entered recursive decoding scope.
pub fn leaveRead(input: &mut Reader) -> () {
  if input.depth != usize.ZERO { input.depth = input.depth - usize.ONE }
}

/// True only after a complete successful input with no trailing bytes.
pub fn finished(bytes: &[u8], input: &Reader) -> bool {
  return !input.failed && input.depth == usize.ZERO && StableKey.finished(bytes, &input.cursor)
}

import silk.testing.testing {Testing, AssertionError}
import silk.core.effect {Effect}

effect fn wireClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut output = writer()
  output.steps = STEP_LIMIT
  run word(&mut output, 7)
  run Testing.expect(output.failed && output.reason == RESOURCE && Bytes.length(&output.bytes) == usize.ZERO,
    "an exhausted write budget never appends another field")
  refuse(&mut output, TYPE_SCHEMA)
  run Testing.expect(output.reason == RESOURCE, "later failures preserve the first refusal reason")
  let mut sized = writer()
  sized.limit = 7
  run word(&mut sized, 0)
  run Testing.expect(sized.failed && sized.reason == SIZE, "byte limits have a distinct bounded refusal counter")
  let mut nested = writer()
  nested.depth = DEPTH_LIMIT
  run Testing.expect(!enterWrite(&mut nested) && nested.reason == DEPTH, "structural depth refusal is distinct from output size")
  let mut encoded = writer()
  run word(&mut encoded, usize.toU64(NODE_LIMIT))
  let mut input = reader(Bytes.asSlice(&encoded.bytes))
  let count = count(Bytes.asSlice(&encoded.bytes), &mut input, NODE_LIMIT)
  run Testing.expect(count == usize.ZERO && input.failed,
    "a truncated large container refuses before reserving storage")
  let mut depth = reader(b"")
  let mut at = usize.ZERO
  while at < DEPTH_LIMIT { run Testing.expect(enterRead(&mut depth), "each permitted nesting level enters")
    at = at + usize.ONE }
  run Testing.expect(!enterRead(&mut depth) && depth.failed,
    "recursive input beyond the fixed depth limit fails without recursion")
}

test effect fn typedBodyWireRefusesWorkBeforeAllocation() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run wireClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
