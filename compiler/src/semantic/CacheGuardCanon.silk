//! Publication-only normalization of explicitly marked source-guard conjunctions.
//!
//! Ordinary query DAGs remain opaque shared operands. Their immediate structure is interned
//! once only to recognize equivalent freshly exported guards; it is never transitively flattened.
//! Equality includes complete source evidence after the producer has refreshed its overlays.

import semantic.CacheBundle
import semantic.CacheBundleTrace
import semantic.CacheBundleLive
import semantic.CacheImage
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import silk.collections.bytes {Bytes}
import silk.collections.hash {Hash}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.num.u64
import silk.num.u32

const edgeLimit: usize = 16000000
struct Evidence { key: Bytes, value: CacheImage.Leaf, representative: usize }
struct EvidenceTable { rows: List<Evidence>, index: InternIndex }
struct Shape { node: usize, joined: bool, edges: List<usize> }
struct Shapes { rows: List<Shape>, index: InternIndex }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}
fn sameEvidence(left: &CacheImage.Leaf, right: &CacheImage.Leaf) -> bool {
  return left.input == right.input && left.selector == right.selector && left.position == right.position
    && left.file == right.file && ContentHash.equals(left.digest, right.digest) && ContentHash.equals(left.text, right.text)
}
fn evidenceHash(key: &[u8], value: &CacheImage.Leaf) -> u64 {
  let mut hash = InternIndex.hashBytes(value.digest.low, key)
  hash = Hash.combine(hash, value.digest.high)
  hash = Hash.combine(Hash.combine(hash, value.text.high), value.text.low)
  hash = Hash.combine(Hash.combine(hash, usize.toU64(value.position)), usize.toU64(value.file))
  hash = Hash.combine(hash, u32.toU64(value.selector))
  return Hash.combine(hash, if value.input { 1 } else { 0 })
}
effect fn internEvidence(table: &mut EvidenceTable, key: &[u8], value: CacheImage.Leaf, representative: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let hash = evidenceHash(key, &value)
  let rows = List<Evidence>.asSlice(&table.rows)
  let mut prior = InternIndex.first(&table.index, hash)
  while prior != usize.MAX {
    if sameEvidence(&rows[prior].value, &value) && same(Bytes.asSlice(&rows[prior].key), key) { return prior }
    prior = InternIndex.after(&table.index, prior)
  }
  let result = rows.length
  run List<Evidence>.append(&mut table.rows, Evidence {key: run Bytes.copy(key), value: value, representative: representative})
  run InternIndex.record(&mut table.index, hash)
  return result
}
effect fn canonicalLeaf(bundle: &CacheBundle.Bundle, leaf: usize, leaves: &mut EvidenceTable, files: &mut EvidenceTable,
  memo: &mut List<usize>, keys: &mut CacheBundle.KeyCursor, fileKeys: &mut CacheBundle.KeyCursor) -> usize ! OutOfMemoryError ? &mut Allocator {
  let previous = List<usize>.get(&memo.*, leaf)
  if previous != usize.MAX { return previous }
  let mut value = CacheBundle.leaf(bundle, leaf)
  if value.file != usize.MAX {
    let recorded = CacheBundle.leaf(bundle, value.file)
    let key = run CacheBundle.keyAt(bundle, &mut fileKeys.*, value.file)
    // A nonstandard file's own reference remains an exact identity discriminator. Ordinary
    // recorded files have file=MAX. No potentially distinct nested file evidence is merged.
    value.file = run internEvidence(&mut files.*, key, recorded, value.file)
  }
  let key = run CacheBundle.keyAt(bundle, &mut keys.*, leaf)
  let row = run internEvidence(&mut leaves.*, key, value, leaf)
  let result = List<Evidence>.asSlice(&leaves.rows)[row].representative
  List<usize>.set(&mut memo.*, leaf, result)
  return result
}
fn sift(edges: &mut List<usize>, start: usize, count: usize) -> () {
  let mut at = start
  while at < count / 2 {
    let mut child = at * 2 + usize.ONE
    if child + usize.ONE < count && List<usize>.get(&edges.*, child) < List<usize>.get(&edges.*, child + usize.ONE) { child = child + usize.ONE }
    let parent = List<usize>.get(&edges.*, at)
    let value = List<usize>.get(&edges.*, child)
    if parent >= value { return () }
    List<usize>.set(&mut edges.*, at, value)
    List<usize>.set(&mut edges.*, child, parent)
    at = child
  }
}
effect fn orderedSet(edges: List<usize>) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut values = move edges
  let count = List<usize>.length(&values)
  let mut at = count / 2
  while at > usize.ZERO { at = at - usize.ONE sift(&mut values, at, count) }
  at = count
  while at > usize.ONE {
    at = at - usize.ONE
    let top = List<usize>.get(&values, usize.ZERO)
    let last = List<usize>.get(&values, at)
    List<usize>.set(&mut values, usize.ZERO, last)
    List<usize>.set(&mut values, at, top)
    sift(&mut values, usize.ZERO, at)
  }
  let mut result = List<usize>.make()
  at = usize.ZERO
  while at < count {
    let value = List<usize>.get(&values, at)
    if at == usize.ZERO || value != List<usize>.get(&values, at - usize.ONE) { run List<usize>.append(&mut result, value) }
    at = at + usize.ONE
  }
  return move result
}
fn sameEdges(left: &[usize], right: &[usize]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}
effect fn internShape(shapes: &mut Shapes, node: usize, joined: bool, edges: List<usize>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let values = List<usize>.asSlice(&edges)
  let mut hash: u64 = if joined { 1 } else { 0 }
  let mut at = usize.ZERO
  while at < values.length { hash = Hash.combine(hash, usize.toU64(values[at])) at = at + usize.ONE }
  let mut prior = InternIndex.first(&shapes.index, hash)
  let rows = List<Shape>.asSlice(&shapes.rows)
  while prior != usize.MAX {
    if rows[prior].joined == joined && sameEdges(List<usize>.asSlice(&rows[prior].edges), values) { return prior }
    prior = InternIndex.after(&shapes.index, prior)
  }
  let result = rows.length
  run List<Shape>.append(&mut shapes.rows, Shape {node: node, joined: joined, edges: move edges})
  run InternIndex.record(&mut shapes.index, hash)
  return result
}

/// Produces bounded edge substitutions for live coordinator conjunctions only. Cache publication
/// is refused on malformed structure or normalization resource exhaustion; semantic checking is
/// unaffected. Representatives are chosen in topological order, preserving earlier-node edges.
pub effect fn normalize(bundle: &CacheBundle.Bundle) -> Option<CacheBundle.EdgeView> ! OutOfMemoryError ? &mut Allocator {
  let mut view = CacheBundle.edgeView()
  let guards = CacheBundle.conjunctions(bundle)
  if guards.length == usize.ZERO { return Option<CacheBundle.EdgeView>.some(move view) }
  let beganPrelive = run CacheBundleTrace.start()
  let live = match move run CacheBundleLive.compute(bundle) {
    Option<CacheBundleLive.Live>.Some {value} => move value
    _ => { return Option<CacheBundle.EdgeView>.none() }
  }
  run CacheBundleTrace.finish(b"normalize prelive", beganPrelive, CacheBundle.nodeCount(bundle), CacheBundle.leafCount(bundle))
  let beganCone = run CacheBundleTrace.start()
  let count = CacheBundle.nodeCount(bundle)
  let mut needed = List<bool>.make()
  run List<bool>.appendRepeated(&mut needed, false, count)
  let mut at = usize.ZERO
  while at < guards.length {
    if guards[at] >= count { return Option<CacheBundle.EdgeView>.none() }
    if CacheBundleLive.node(&live, guards[at]) { List<bool>.set(&mut needed, guards[at], true) }
    at = at + usize.ONE
  }
  let mut coneNodes = usize.ZERO
  let mut coneEdges = usize.ZERO
  at = count
  while at > usize.ZERO {
    at = at - usize.ONE
    if !List<bool>.get(&needed, at) { continue }
    coneNodes = coneNodes + usize.ONE
    let mut cursor = CacheBundle.edgeCursor(bundle, at)
    while let Option<usize>.Some {value: edge} = move CacheBundle.nextEdge(bundle, &mut cursor) {
      coneEdges = coneEdges + usize.ONE
      if CacheImage.namesNode(edge) {
        let child = CacheImage.target(edge)
        if child >= at { return Option<CacheBundle.EdgeView>.none() }
        List<bool>.set(&mut needed, child, true)
      }
    }
  }
  run CacheBundleTrace.finish(b"normalize cone", beganCone, coneNodes, coneEdges)
  let beganCanonical = run CacheBundleTrace.start()
  let mut representatives = List<usize>.make()
  let mut shapeFor = List<usize>.make()
  let mut leafMemo = List<usize>.make()
  run List<usize>.appendRepeated(&mut representatives, usize.MAX, count)
  run List<usize>.appendRepeated(&mut shapeFor, usize.MAX, count)
  run List<usize>.appendRepeated(&mut leafMemo, usize.MAX, CacheBundle.leafCount(bundle))
  let mut shapes = Shapes {rows: List<Shape>.make(), index: InternIndex.make()}
  let mut leaves = EvidenceTable {rows: List<Evidence>.make(), index: InternIndex.make()}
  let mut files = EvidenceTable {rows: List<Evidence>.make(), index: InternIndex.make()}
  let mut keys = CacheBundle.keyCursor()
  let mut fileKeys = CacheBundle.keyCursor()
  let mut work = usize.ZERO
  let mut maximumWidth = usize.ZERO
  at = usize.ZERO
  while at < count {
    if List<bool>.get(&needed, at) {
      let joined = CacheBundle.isConjunction(bundle, at)
      let mut edges = List<usize>.make()
      let mut cursor = CacheBundle.edgeCursor(bundle, at)
      while let Option<usize>.Some {value: edge} = move CacheBundle.nextEdge(bundle, &mut cursor) {
        let target = CacheImage.target(edge)
        if CacheImage.namesNode(edge) {
          if joined && CacheBundle.isConjunction(bundle, target) {
            let terms = List<usize>.asSlice(&List<Shape>.asSlice(&shapes.rows)[List<usize>.get(&shapeFor, target)].edges)
            if terms.length > edgeLimit - work { return Option<CacheBundle.EdgeView>.none() }
            work = work + terms.length
            run List<usize>.appendSlice(&mut edges, terms)
          } else {
            if work == edgeLimit { return Option<CacheBundle.EdgeView>.none() }
            work = work + usize.ONE
            run List<usize>.append(&mut edges, CacheImage.nodeEdge(List<usize>.get(&representatives, target)))
          }
        } else {
          if target >= CacheBundle.leafCount(bundle) || work == edgeLimit { return Option<CacheBundle.EdgeView>.none() }
          work = work + usize.ONE
          let leaf = run canonicalLeaf(bundle, target, &mut leaves, &mut files, &mut leafMemo, &mut keys, &mut fileKeys)
          run List<usize>.append(&mut edges, CacheImage.leafEdge(leaf))
        }
      }
      if joined && List<usize>.length(&edges) > maximumWidth { maximumWidth = List<usize>.length(&edges) }
      if joined { let current = move edges edges = run orderedSet(move current) }
      let shape = run internShape(&mut shapes, at, joined, move edges)
      let row = &List<Shape>.asSlice(&shapes.rows)[shape]
      let terms = List<usize>.asSlice(&row.edges)
      let representative = if joined && terms.length == usize.ONE && CacheImage.namesNode(terms[0]) { CacheImage.target(terms[0]) } else { row.node }
      List<usize>.set(&mut representatives, at, representative)
      List<usize>.set(&mut shapeFor, at, shape)
      if joined && CacheBundle.coordinatorNode(bundle, at) {
        let mut replacement = List<usize>.make()
        run List<usize>.appendSlice(&mut replacement, terms)
        run CacheBundle.addViewEdges(&mut view, at, move replacement)
      }
    }
    at = at + usize.ONE
  }
  run CacheBundleTrace.finish(b"normalize canonical", beganCanonical, work, maximumWidth)
  run CacheBundleTrace.report(b"normalize shapes", 0, List<Shape>.length(&shapes.rows), List<Evidence>.length(&leaves.rows))
  return Option<CacheBundle.EdgeView>.some(move view)
}
