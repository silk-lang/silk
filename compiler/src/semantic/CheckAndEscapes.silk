// One escape site of a reached instance's own body (SHARED-003).
pub struct SummaryEscape {
  pub kind: MirAccessEscape,
  pub span: Span,
}

// One `Intrinsic.NonParking` obligation of a reached instance: the instances that run the obligated
// value, whether each value has an exact target, and the site that owes the proof. An entry
// obligation is owed by the call that first reached the instance.
pub struct ParkObligation {
  pub ambient: bool,
  pub trace: Option<Interned<Type>>,
  pub conversion: Option<ErasureFact>,
  pub callees: List<InstanceKey>,
  pub glues: List<Interned<Type>>,
  pub declarations: List<Interned<DeclarationId>>,
  pub exact: bool,
  pub module: ModuleId,
  pub span: Span,
}

// One reached instance's suspension summary: the boundary it runs, if any, the external park it
// runs, if any, its NonParking obligations, its direct Silk callees and each call's span, and the
// local-shared accesses it holds with their callbacks. Every park is also a boundary; a nested
// transfer is a boundary only.
pub struct SuspensionSummary {
  // A named conformance witness has the same instance key as an ordinary source call.
  // Its caller retains the witness edge, and its signature supplies the concrete receiver.
  pub witnesses: List<InstanceKey>,
  pub receiver: Option<Interned<Type>>,
  // The authored caller whose arguments selected an ambient dispatcher specialization.
  pub ambientCall: Option<RelatedSite>,
  pub key: InstanceKey,
  pub module: ModuleId,
  pub boundary: Option<Span>,
  pub park: Option<Span>,
  pub nonParking: List<ParkObligation>,
  // Instances this body runs without a direct call: the drop glue of each drop and each Silk
  // function whose address it forms, such as an observer adapter. An Execution's start helper is
  // left out: driving runs a package's body, which may park without parking its driver.
  pub indirect: List<InstanceKey>,
  // Whether this body notifies an Execution, which runs the reached readiness endpoints.
  pub notifies: bool,
  // The package glue whose address this body stores in a new Execution's header.
  pub packages: List<InstanceKey>,
  // Whether this body releases an Execution package, which runs the glue of any package formed.
  pub releases: bool,
  pub callees: List<InstanceKey>,
  pub calls: List<Span>,
  pub callbacks: List<CallbackBoundary>,
  pub accesses: List<CallbackBoundary>,
  pub escapes: List<SummaryEscape>,
  // The instances whose bodies this one inlined at a suspension point or as a value forwarder;
  // their code runs, and parks, as part of this one.
  pub inlined: List<InstanceKey>,
  // The instances whose quiet bodies this one inlined (`MirFunction.quiet`): they run as part of
  // this one and cannot park.
  pub quiet: List<InstanceKey>,
}

// Where a module's escape walk stops: at the plain instance of a declaration in another module of
// `package`'s package or of `checked`, which that module's own escape check walks from its
// concrete bodies.
pub struct WalkBoundary {
  // A module of the package whose modules check their own bodies: the application's, else `own`.
  pub package: ModuleId,
  // The module whose concrete bodies the walk starts from.
  pub own: ModuleId,
  // The other modules this check walks from their own bodies, by `ModuleId.hash` in `lookup`.
  pub checked: List<ModuleId>,
  pub lookup: InternIndex,
  // A walk from the runtime's roots enters `own`, the toolchain bodies that start `main`, the
  // application's entry module and instances with static arguments only: those are what no
  // module's own check reaches through an open `main`, and the rest of the program is left to the
  // modules' checks.
  pub staticsOnly: bool,
}

// Whether a walk bounded by `walk` leaves `instance` to another module's escape check.
effect fn walkedElsewhere(walk: &WalkBoundary, instance: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
  let identity = match &instance.* {
    InstanceKey.Function {..} => InstanceKey.identity(instance)
    _ => { return false }
  }
  let declaration = DeclarationId.copyShared(&identity)
  let module = DeclarationId.moduleId(&declaration)
  if ModuleId.equals(module, &walk.own) { return false }
  // A package's check sweeps only its own modules, so a toolchain body it reaches is walked here,
  // where its selected `compileError` and its escapes are found, as a build finds them.
  if toolchainModule(module) && !toolchainModule(&walk.own) { return false }
  if walk.staticsOnly {
    if ModuleId.equals(module, &walk.package) || toolchainModule(module) { return false }
    return match InstanceKey.application(instance) {
      Option<Interned<Application>>.Some {value} => Interned<Application>.with<bool>(&value, |application: &Application| -> bool {
        return !Application.hasStatics(application)
      })
      Option<Interned<Application>>.None => true
    }
  }
  if !ModuleId.samePackage(module, &walk.package) {
    let listed = List<ModuleId>.asSlice(&walk.checked)
    let mut at = InternIndex.first(&walk.lookup, ModuleId.hash(module))
    while at != usize.MAX && !ModuleId.equals(&listed[at], module) { at = InternIndex.after(&walk.lookup, at) }
    if at == usize.MAX { return false }
  }
  // Only the declaration's own plain instance is a body its module walks; an instance with type,
  // static or provider arguments is walked here. Lifetime arguments and a method's owner scopes
  // that bind none leave it plain.
  if let Option<Shared<List<ProviderEntry>>>.Some {value: providers} = InstanceKey.providers(instance) {
    let provided = Shared<List<ProviderEntry>>.with<bool>(&providers, |value: &List<ProviderEntry>| -> bool {
      return List<ProviderEntry>.length(value) > usize.ZERO
    })
    if provided { return false }
  }
  return match InstanceKey.application(instance) {
    Option<Interned<Application>>.Some {value} => Interned<Application>.with<bool>(&value, |application: &Application| -> bool {
      return plainApplication(application)
    })
    Option<Interned<Application>>.None => false
  }
}

// Whether `application` supplies only lifetimes, which leave the body its module walks unchanged.
fn plainApplication(application: &Application) -> bool {
  if Application.hasStatics(application) || !onlyLifetimes(List<Argument>.asSlice(&application.arguments)) {
    return false
  }
  let scopes = List<ScopeBinding>.asSlice(&application.scopes)
  let mut at = usize.ZERO
  while at < scopes.length {
    if !onlyLifetimes(List<Argument>.asSlice(&scopes[at].arguments)) { return false }
    at = at + usize.ONE
  }
  return true
}

fn onlyLifetimes(arguments: &[Argument]) -> bool {
  let mut at = usize.ZERO
  while at < arguments.length {
    match &arguments[at] {
      Argument.Lifetime {..} => {}
      _ => { return false }
    }
    at = at + usize.ONE
  }
  return true
}

// Whether any reached body hands a local shared access to a callback, whose escapes
// `localSharedEscapes` finds by walking every body the callback reaches.
fn anyCallbackAccess(summaries: &[SuspensionSummary]) -> bool {
  let mut at = usize.ZERO
  while at < summaries.length {
    if List<CallbackBoundary>.length(&summaries[at].accesses) > usize.ZERO { return true }
    at = at + usize.ONE
  }
  return false
}

// The last of `origins`, which holds one beside each visit popped with it.
fn popOrigin(origins: &mut List<VisitOrigin>) -> VisitOrigin {
  return match move List<VisitOrigin>.pop(&mut origins.*) {
    Option<VisitOrigin>.Some {value} => value
    Option<VisitOrigin>.None => VisitOrigin {parent: usize.MAX, position: usize.ZERO, requested: false}
  }
}

// Takes from `left` the visits of every body a callback reaches through direct calls that the walk
// left unsummarized: the callback itself, or a callee of a summary the callback reaches. The
// origin of each visit moves from `leftOrigins` to `origins` beside it.
effect fn belowCallbacks(summaries: &[SuspensionSummary], left: &mut List<BackendVisit>, leftOrigins: &mut List<VisitOrigin>,
  origins: &mut List<VisitOrigin>) -> List<BackendVisit>
! OutOfMemoryError ? &mut Allocator {
  let lookup = run summaryLookup(summaries)
  let mut reached = List<bool>.make()
  while List<bool>.length(&reached) < summaries.length { run List<bool>.append(&mut reached, false) }
  let mut needed = List<InstanceKey>.make()
  let mut neededLookup = InternIndex.make()
  let mut queue = List<usize>.make()
  let mut holder = usize.ZERO
  while holder < summaries.length {
    let accesses = List<CallbackBoundary>.asSlice(&summaries[holder].accesses)
    holder = holder + usize.ONE
    let mut access = usize.ZERO
    while access < accesses.length {
      let callback = run summaryPosition(summaries, &lookup, &accesses[access].key)
      if callback == usize.MAX {
        run InternIndex.record(&mut neededLookup, InstanceKey.runtimeHash(&accesses[access].key))
        run List<InstanceKey>.append(&mut needed, InstanceKey.copy(&accesses[access].key))
      } else if !List<bool>.get(&reached, callback) {
        List<bool>.set(&mut reached, callback, true)
        run List<usize>.append(&mut queue, callback)
      }
      access = access + usize.ONE
    }
  }
  let mut head = usize.ZERO
  while head < List<usize>.length(&queue) {
    let at = List<usize>.get(&queue, head)
    head = head + usize.ONE
    // Only the reached summaries' callees are looked up. A callee with no summary is one the walk
    // left, never entered, or will enter below.
    let callees = List<InstanceKey>.asSlice(&summaries[at].callees)
    let mut callee = usize.ZERO
    while callee < callees.length {
      let summarized = run summaryPosition(summaries, &lookup, &callees[callee])
      if summarized == usize.MAX {
        run InternIndex.record(&mut neededLookup, InstanceKey.runtimeHash(&callees[callee]))
        run List<InstanceKey>.append(&mut needed, InstanceKey.copy(&callees[callee]))
      } else if !List<bool>.get(&reached, summarized) {
        List<bool>.set(&mut reached, summarized, true)
        run List<usize>.append(&mut queue, summarized)
      }
      callee = callee + usize.ONE
    }
  }
  // Popping reverses the left visits, and popping again restores their order in each part.
  let mut taken = List<BackendVisit>.make()
  let mut kept = List<BackendVisit>.make()
  let mut takenOrigins = List<VisitOrigin>.make()
  let mut keptOrigins = List<VisitOrigin>.make()
  let wanted = List<InstanceKey>.asSlice(&needed)
  while true {
    let visit = match move List<BackendVisit>.pop(&mut left.*) {
      Option<BackendVisit>.Some {value} => move value
      Option<BackendVisit>.None => { break }
    }
    let origin = popOrigin(&mut leftOrigins.*)
    let mut below = false
    if let BackendVisit.Enter {key, ..} = &visit {
      let mut found = InternIndex.first(&neededLookup, InstanceKey.runtimeHash(&key))
      while found != usize.MAX && !below {
        below = run InstanceKey.sameInstance(&wanted[found], &key)
        found = InternIndex.after(&neededLookup, found)
      }
    }
    if below {
      run List<BackendVisit>.append(&mut taken, move visit)
      run List<VisitOrigin>.append(&mut takenOrigins, origin)
    } else {
      run List<BackendVisit>.append(&mut kept, move visit)
      run List<VisitOrigin>.append(&mut keptOrigins, origin)
    }
  }
  while true {
    match move List<BackendVisit>.pop(&mut kept) {
      Option<BackendVisit>.Some {value} => { run List<BackendVisit>.append(&mut left.*, move value) }
      Option<BackendVisit>.None => { break }
    }
    run List<VisitOrigin>.append(&mut leftOrigins.*, popOrigin(&mut keptOrigins))
  }
  let mut ordered = List<BackendVisit>.make()
  while true {
    match move List<BackendVisit>.pop(&mut taken) {
      Option<BackendVisit>.Some {value} => { run List<BackendVisit>.append(&mut ordered, move value) }
      Option<BackendVisit>.None => { break }
    }
    run List<VisitOrigin>.append(&mut origins.*, popOrigin(&mut takenOrigins))
  }
  return move ordered
}

impl SuspensionSummary {
  pub fn recordAmbientCall(self: &mut Self, requester: &Option<RelatedSite>, module: &ModuleId, span: Span) -> () {
    if List<ParkObligation>.length(&self.nonParking) == usize.ZERO || operationDispatch(&self.key) != OperationDispatch.Erased { return () }
    self.ambientCall = Option<RelatedSite>.some(requestSite(requester, module, span))
  }

  pub effect fn make(function: &MirFunction, instance: &InstanceKey, module: &ModuleId, anchor: &Option<Anchor>,
    enteredModule: &ModuleId, entered: Span) -> SuspensionSummary
  ! OutOfMemoryError ? &mut Allocator {
    let mut witnesses = List<InstanceKey>.make()
    let references = List<MirReference>.asSlice(&function.references)
    let mut reference = usize.ZERO
    while reference < references.length {
      let witnessed = match &references[reference].edge { Edge.Witness => true Edge.FieldWitness {..} => true _ => false }
      if witnessed { run List<InstanceKey>.append(&mut witnesses, InstanceKey.copy(&references[reference].key)) }
      reference = reference + usize.ONE
    }
    let parameters = List<Interned<Type>>.asSlice(&function.parameters)
    let receiver = if parameters.length > usize.ZERO {
      Interned<Type>.with<Option<Interned<Type>>>(&parameters[usize.ZERO], referenceReferent)
    } else { Option<Interned<Type>>.none() }
    let mut callees = List<InstanceKey>.make()
    let mut calls = List<Span>.make()
    let mut callbacks = List<CallbackBoundary>.make()
    let mut indirect = List<InstanceKey>.make()
    let mut packages = List<InstanceKey>.make()
    let blocks = List<MirBlock>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      if let MirTerminator.Call {callee: MirCallee.Instance {key}, origin, ..} = &blocks[at].terminator {
        run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&key))
        run List<Span>.append(&mut calls, anchoredSpan(anchor, origin))
      }
      let statements = List<MirStatement>.asSlice(&blocks[at].statements)
      let mut statement = usize.ZERO
      while statement < statements.length {
        if let MirStatement.Assign {value: MirRvalue.FunctionAddress {key}, origin, ..} = &statements[statement] {
          if InstanceKey.cEntry(&key) {
            run List<CallbackBoundary>.append(&mut callbacks, CallbackBoundary {key: InstanceKey.copy(&key), span: anchoredSpan(anchor, origin)})
          }
          if !startHelper(&key) { run List<InstanceKey>.append(&mut indirect, InstanceKey.copy(&key)) }
          if let Option<Interned<Type>>.Some {..} = move InstanceKey.glueType(&key) {
            run List<InstanceKey>.append(&mut packages, InstanceKey.copy(&key))
          }
        }
        if let MirStatement.Drop {glue, ..} = &statements[statement] {
          run List<InstanceKey>.append(&mut indirect, InstanceKey.copy(&glue))
        }
        statement = statement + usize.ONE
      }
      at = at + usize.ONE
    }
    let mut boundary = Option<Span>.none()
    if let Option<BodyOrigin>.Some {value: origin} = &function.suspension { boundary = Option<Span>.some(anchoredSpan(anchor, origin)) }
    let mut park = Option<Span>.none()
    if let Option<BodyOrigin>.Some {value: origin} = &function.parks { park = Option<Span>.some(anchoredSpan(anchor, origin)) }
    let mut nonParking = List<ParkObligation>.make()
    let owed = List<MirNonParkingRun>.asSlice(&function.nonParking)
    at = usize.ZERO
    while at < owed.length {
      let mut callees = List<InstanceKey>.make()
      let listed = List<InstanceKey>.asSlice(&owed[at].callees)
      let mut callee = usize.ZERO
      while callee < listed.length {
        run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&listed[callee]))
        callee = callee + usize.ONE
      }
      let mut declarations = List<Interned<DeclarationId>>.make()
      let named = List<Interned<DeclarationId>>.asSlice(&owed[at].declarations)
      callee = usize.ZERO
      while callee < named.length {
        run List<Interned<DeclarationId>>.append(&mut declarations, Interned<DeclarationId>.clone(&named[callee]))
        callee = callee + usize.ONE
      }
      let mut glues = List<Interned<Type>>.make()
      let dropped = List<Interned<Type>>.asSlice(&owed[at].glues)
      callee = usize.ZERO
      while callee < dropped.length {
        run List<Interned<Type>>.append(&mut glues, Interned<Type>.clone(&dropped[callee]))
        callee = callee + usize.ONE
      }
      // A proof a toolchain body owes for its caller's value, as `Effect.provideMut` running a
      // `@nonParking` operation, is reported at the authored call that entered it.
      let reentered = toolchainModule(module) && !toolchainModule(enteredModule) && entered.end != usize.ZERO
      let mut span = entered
      let mut site = ModuleId.copy(enteredModule)
      let mut conversion = Option<ErasureFact>.none()
      let mut trace = Option<Interned<Type>>.none()
      let mut ambient = false
      match &owed[at].origin {
        ParkOrigin.Trace {module: declaring, span: declared, args} => {
          ambient = true
          site = ModuleId.copy(&declaring)
          span = declared
          trace = Option<Interned<Type>>.some(Interned<Type>.clone(&args))
        }
        ParkOrigin.Ambient {module: declaring, span: declared} => {
          ambient = true
          site = ModuleId.copy(&declaring)
          span = declared
        }
        ParkOrigin.Body {site: origin} => {
          if !reentered {
            span = anchoredSpan(anchor, origin)
            site = ModuleId.copy(module)
          }
        }
        ParkOrigin.Conversion {fact} => { conversion = Option<ErasureFact>.some(ErasureFact.copy(&fact)) }
        ParkOrigin.Entry => ()
      }
      let obligation = ParkObligation {ambient: ambient, trace: move trace, conversion: move conversion, callees: move callees, glues: move glues,
        declarations: move declarations, exact: owed[at].exact, module: move site, span: span}
      run List<ParkObligation>.append(&mut nonParking, move obligation)
      at = at + usize.ONE
    }
    let mut accesses = List<CallbackBoundary>.make()
    let held = List<MirSharedAccess>.asSlice(&function.accesses)
    at = usize.ZERO
    while at < held.length {
      run List<CallbackBoundary>.append(&mut accesses, CallbackBoundary {key: InstanceKey.copy(&held[at].callback), span: anchoredSpan(anchor, held[at].origin)})
      at = at + usize.ONE
    }
    let mut escapes = List<SummaryEscape>.make()
    let mut notifies = false
    let sites = List<MirEscapeSite>.asSlice(&function.escapes)
    at = usize.ZERO
    while at < sites.length {
      if sites[at].kind == MirAccessEscape.Callback { notifies = true }
      run List<SummaryEscape>.append(&mut escapes, SummaryEscape {kind: sites[at].kind, span: anchoredSpan(anchor, sites[at].origin)})
      at = at + usize.ONE
    }
    return SuspensionSummary {
      witnesses: move witnesses, receiver: move receiver,
      ambientCall: Option<RelatedSite>.none(),
      key: InstanceKey.copy(instance),
      module: ModuleId.copy(module),
      boundary: move boundary,
      park: move park,
      nonParking: move nonParking,
      indirect: move indirect,
      notifies: notifies,
      packages: move packages,
      releases: function.releasesPackages,
      callees: move callees,
      calls: move calls,
      callbacks: move callbacks,
      accesses: move accesses,
      escapes: move escapes,
      inlined: run copyKeys(&function.inlined),
      quiet: run copyKeys(&function.quiet),
    }
  }
}

effect fn copyKeys(keys: &List<InstanceKey>) -> List<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
  let listed = List<InstanceKey>.asSlice(keys)
  let mut copied = run List<InstanceKey>.makeWithCapacity(listed.length)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<InstanceKey>.append(&mut copied, InstanceKey.copy(&listed[at]))
    at = at + usize.ONE
  }
  return move copied
}

// Rejects each `export "C"` function that can park externally (SEM0201), at its declaration. C
// code calls an export with no running Execution, so a park would wait for a scheduler its caller
// does not have. The proof is `closeParking` over every reached instance: an export's shim is
// marked when the function it calls, or anything that function runs directly or through drops,
// formed addresses, readiness notifications or package releases, parks. A body that only suspends
// is driven to completion by the shim and stays synchronous for its caller, and driving another
// Execution does not park the driver. Standard-library exports are the runtime's own entries.
pub effect fn exportsThatPark(resolver: &Resolver, summaries: &[SuspensionSummary], roots: &[BuildRoot], entrySpan: Span,
  runtime: &ModuleId, runtimeSelected: bool) -> List<Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut violations = List<Shared<Rejection>>.make()
  let mut exported = false
  let mut at = usize.ZERO
  while at < summaries.length {
    if InstanceKey.fixedLinkage(&summaries[at].key) && !runtimeExport(&summaries[at].module, runtime, runtimeSelected) { exported = true }
    at = at + usize.ONE
  }
  if !exported { return move violations }
  let parks = run closeParking(summaries)
  let marked = List<bool>.asSlice(&parks)
  at = usize.ZERO
  while at < summaries.length {
    if marked[at] && !runtimeExport(&summaries[at].module, runtime, runtimeSelected) {
      if let Option<Shared<Bytes>>.Some {value: symbol} = move InstanceKey.exportSymbol(&summaries[at].key) {
        let mut span = entrySpan
        let mut root = usize.ZERO
        while root < roots.length {
          if run InstanceKey.sameInstance(&roots[root].key, &summaries[at].key) { span = roots[root].span }
          root = root + usize.ONE
        }
        let mut diagnostic = run makeRejection(RejectionCode.ExportSuspends, &summaries[at].module, span)
        let spelled = Shared<Bytes>.with<usize>(&symbol, |value: &Bytes| -> usize { return Bytes.length(value) })
        let mut text = run Bytes.zeroed(spelled)
        Shared<Bytes>.with<()>(&symbol, |value: &Bytes| -> () {
          let written = Bytes.asSlice(value)
          let output = Bytes.asMutSlice(&mut text)
          let mut copied = usize.ZERO
          while copied < written.length {
            output[copied] = written[copied]
            copied = copied + usize.ONE
          }
          return ()
        })
        run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"symbol"), value: move text})
        run List<Shared<Rejection>>.append(&mut violations, run Shared<Rejection>.make(move diagnostic))
      }
    }
    at = at + usize.ONE
  }
  return move violations
}

// Whether an export of `module` is a runtime entry: a standard-library export, or one of the
// selected runtime source, whose entry may park as the runtime's scheduler allows (SEM0225).
fn runtimeExport(module: &ModuleId, runtime: &ModuleId, runtimeSelected: bool) -> bool {
  if ModuleId.withPath<bool>(module, libraryPath) { return true }
  return runtimeSelected && ModuleId.equals(module, runtime)
}

// An address may select only a synchronous C export. Runtime roots may still drive frames;
// the restriction belongs to the function pointer formation, after its transitive graph closes.
pub effect fn callbackSuspends(summaries: &[SuspensionSummary], marked: &[bool], key: &InstanceKey) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < summaries.length {
    if run InstanceKey.sameApplication(&summaries[at].key, key) {
      let callees = List<InstanceKey>.asSlice(&summaries[at].callees)
      let mut callee = usize.ZERO
      while callee < callees.length {
        let mut target = usize.ZERO
        while target < summaries.length {
          if marked[target] && run InstanceKey.sameApplication(&summaries[target].key, &callees[callee]) { return true }
          target = target + usize.ONE
        }
        callee = callee + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

// One resolved call of a summary: the callee's summary position and the call's index.
pub struct CallEdge {
  pub target: usize,
  pub call: usize,
}

// Each summary's direct callees as summary positions, in call order.
effect fn summaryEdges(summaries: &[SuspensionSummary]) -> List<List<CallEdge>> ! OutOfMemoryError ? &mut Allocator {
  let lookup = run summaryLookup(summaries)
  return run summaryEdgesIn(summaries, &lookup)
}

// A `runtimeHash` index of `summaries`, by position.
effect fn summaryLookup(summaries: &[SuspensionSummary]) -> InternIndex ! OutOfMemoryError ? &mut Allocator {
  let mut lookup = InternIndex.make()
  let mut at = usize.ZERO
  while at < summaries.length {
    run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&summaries[at].key))
    at = at + usize.ONE
  }
  return move lookup
}

// [`summaryEdges`] through an index [`summaryLookup`] built.
effect fn summaryEdgesIn(summaries: &[SuspensionSummary], lookup: &InternIndex) -> List<List<CallEdge>>
! OutOfMemoryError ? &mut Allocator {
  let mut edges = run List<List<CallEdge>>.makeWithCapacity(summaries.length)
  let mut at = usize.ZERO
  while at < summaries.length {
    run List<List<CallEdge>>.append(&mut edges, run summaryEdgesOf(summaries, lookup, at))
    at = at + usize.ONE
  }
  return move edges
}

// The direct callees of summary `at` that have summaries, as positions, in call order.
effect fn summaryEdgesOf(summaries: &[SuspensionSummary], lookup: &InternIndex, at: usize) -> List<CallEdge>
! OutOfMemoryError ? &mut Allocator {
  let mut targets = List<CallEdge>.make()
  let callees = List<InstanceKey>.asSlice(&summaries[at].callees)
  let mut callee = usize.ZERO
  while callee < callees.length {
    let found = run summaryPosition(summaries, lookup, &callees[callee])
    if found != usize.MAX { run List<CallEdge>.append(&mut targets, CallEdge {target: found, call: callee}) }
    callee = callee + usize.ONE
  }
  return move targets
}

// Marks the reached instances that can suspend: each one that runs a boundary, then each one
// that calls a marked instance directly, to a fixed point. Fixed-linkage shims are never marked;
// they call a suspendable instance's ordinary symbol, which drives its frames.
pub effect fn closeSuspendable(summaries: &[SuspensionSummary]) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut marked = List<bool>.make()
  let mut blocked = List<bool>.make()
  let mut any = false
  let mut at = usize.ZERO
  while at < summaries.length {
    let shim = InstanceKey.cEntry(&summaries[at].key)
    let origin = match &summaries[at].boundary {
      Option<Span>.Some {..} => !shim
      Option<Span>.None => false
    }
    run List<bool>.append(&mut marked, origin)
    run List<bool>.append(&mut blocked, shim)
    any = any || origin
    at = at + usize.ONE
  }
  if !any { return move marked }
  let edges = run summaryEdges(summaries)
  let callers = run summaryCallers(summaries, List<List<CallEdge>>.asSlice(&edges))
  run closeCallers(&mut marked, List<List<CallEdge>>.asSlice(&callers), List<bool>.asSlice(&blocked))
  return move marked
}

// Propagates a fact from each marked callee to its callers, visiting every reached edge once.
// A blocked caller neither acquires the fact nor propagates it; an empty list blocks none.
pub effect fn closeCallers(marked: &mut List<bool>, callers: &[List<CallEdge>], blocked: &[bool]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut pending = List<usize>.make()
  let mut at = usize.ZERO
  while at < List<bool>.length(&marked.*) {
    if List<bool>.get(&marked.*, at) { run List<usize>.append(&mut pending, at) }
    at = at + usize.ONE
  }
  let mut head = usize.ZERO
  while head < List<usize>.length(&pending) {
    let reached = List<usize>.get(&pending, head)
    head = head + usize.ONE
    let incoming = List<CallEdge>.asSlice(&callers[reached])
    let mut edge = usize.ZERO
    while edge < incoming.length {
      let caller = incoming[edge].target
      if !List<bool>.get(&marked.*, caller) && (blocked.length == usize.ZERO || !blocked[caller]) {
        List<bool>.set(&mut marked.*, caller, true)
        run List<usize>.append(&mut pending, caller)
      }
      edge = edge + usize.ONE
    }
  }
}

// The strongly connected component of each summary `marked` selects, in the call graph between
// selected summaries, or `usize.MAX` for an unselected one (iterative Tarjan). A call between two
// members of one component is part of a recursive cycle, so it transfers through the driver
// (SUSP-003).
pub effect fn suspendableComponents(summaries: &[SuspensionSummary], marked: &[bool]) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let edges = run summaryEdges(summaries)
  let following = List<List<CallEdge>>.asSlice(&edges)
  let count = summaries.length
  let mut order = run List<usize>.makeWithCapacity(count)
  run List<usize>.appendRepeated(&mut order, usize.MAX, count)
  let mut low = run List<usize>.makeWithCapacity(count)
  run List<usize>.appendRepeated(&mut low, usize.MAX, count)
  let mut stacked = run List<bool>.makeWithCapacity(count)
  run List<bool>.appendRepeated(&mut stacked, false, count)
  let mut component = run List<usize>.makeWithCapacity(count)
  run List<usize>.appendRepeated(&mut component, usize.MAX, count)
  let mut stack = List<usize>.make()
  // The depth-first path: each node and the next of its edges to follow.
  let mut path = List<usize>.make()
  let mut next = List<usize>.make()
  let mut counter = usize.ZERO
  let mut components = usize.ZERO
  let mut root = usize.ZERO
  while root < count {
    if marked[root] && List<usize>.asSlice(&order)[root] == usize.MAX {
      List<usize>.set(&mut order, root, counter)
      List<usize>.set(&mut low, root, counter)
      counter = counter + usize.ONE
      run List<usize>.append(&mut stack, root)
      List<bool>.set(&mut stacked, root, true)
      run List<usize>.append(&mut path, root)
      run List<usize>.append(&mut next, usize.ZERO)
      while List<usize>.length(&path) != usize.ZERO {
        let depth = List<usize>.length(&path) - usize.ONE
        let node = List<usize>.asSlice(&path)[depth]
        let edge = List<usize>.asSlice(&next)[depth]
        let targets = List<CallEdge>.asSlice(&following[node])
        if edge < targets.length {
          List<usize>.set(&mut next, depth, edge + usize.ONE)
          let callee = targets[edge].target
          if !marked[callee] { continue }
          if List<usize>.asSlice(&order)[callee] == usize.MAX {
            List<usize>.set(&mut order, callee, counter)
            List<usize>.set(&mut low, callee, counter)
            counter = counter + usize.ONE
            run List<usize>.append(&mut stack, callee)
            List<bool>.set(&mut stacked, callee, true)
            run List<usize>.append(&mut path, callee)
            run List<usize>.append(&mut next, usize.ZERO)
          } else if List<bool>.asSlice(&stacked)[callee] {
            let reached = List<usize>.asSlice(&order)[callee]
            if reached < List<usize>.asSlice(&low)[node] { List<usize>.set(&mut low, node, reached) }
          }
          continue
        }
        drop List<usize>.pop(&mut path)
        drop List<usize>.pop(&mut next)
        let nodeLow = List<usize>.asSlice(&low)[node]
        if nodeLow == List<usize>.asSlice(&order)[node] {
          let mut member = usize.MAX
          while member != node {
            member = List<usize>.asSlice(&stack)[List<usize>.length(&stack) - usize.ONE]
            drop List<usize>.pop(&mut stack)
            List<bool>.set(&mut stacked, member, false)
            List<usize>.set(&mut component, member, components)
          }
          components = components + usize.ONE
        }
        if depth > usize.ZERO {
          let parent = List<usize>.asSlice(&path)[depth - usize.ONE]
          if nodeLow < List<usize>.asSlice(&low)[parent] { List<usize>.set(&mut low, parent, nodeLow) }
        }
      }
    }
    root = root + usize.ONE
  }
  return move component
}

// An Execution's start helper runs its body, which may park without parking whoever forms it.
fn startHelper(key: &InstanceKey) -> bool {
  return match &key.* { InstanceKey.Helper {purpose, ..} => purpose == HelperRole.Start _ => false }
}

fn readinessHelper(key: &InstanceKey) -> bool {
  return match &key.* { InstanceKey.Helper {purpose, ..} => purpose == HelperRole.Notify _ => false }
}

// Each summary's indirect runs as summary positions: every reached instance its drops, formed
// addresses, readiness notifications and package releases run (the bootstrap's cleanup and
// readiness edges).
effect fn indirectEdges(summaries: &[SuspensionSummary]) -> List<List<usize>> ! OutOfMemoryError ? &mut Allocator {
  let mut lookup = InternIndex.make()
  let mut readiness = List<usize>.make()
  let mut at = usize.ZERO
  while at < summaries.length {
    run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&summaries[at].key))
    if readinessHelper(&summaries[at].key) { run List<usize>.append(&mut readiness, at) }
    at = at + usize.ONE
  }
  let endpoints = List<usize>.asSlice(&readiness)
  // Releasing a package runs its glue, which may be the glue of any package the program forms.
  let mut glues = List<usize>.make()
  at = usize.ZERO
  while at < summaries.length {
    let formed = List<InstanceKey>.asSlice(&summaries[at].packages)
    let mut package = usize.ZERO
    while package < formed.length {
      let mut found = InternIndex.first(&lookup, InstanceKey.runtimeHash(&formed[package]))
      while found != usize.MAX {
        if run InstanceKey.sameInstance(&summaries[found].key, &formed[package]) { run List<usize>.append(&mut glues, found) }
        found = InternIndex.after(&lookup, found)
      }
      package = package + usize.ONE
    }
    at = at + usize.ONE
  }
  let packageGlues = List<usize>.asSlice(&glues)
  let mut edges = List<List<usize>>.make()
  at = usize.ZERO
  while at < summaries.length {
    let mut targets = List<usize>.make()
    let keys = List<InstanceKey>.asSlice(&summaries[at].indirect)
    let mut key = usize.ZERO
    while key < keys.length {
      let mut found = InternIndex.first(&lookup, InstanceKey.runtimeHash(&keys[key]))
      while found != usize.MAX {
        if run InstanceKey.sameInstance(&summaries[found].key, &keys[key]) { run List<usize>.append(&mut targets, found) }
        found = InternIndex.after(&lookup, found)
      }
      key = key + usize.ONE
    }
    if summaries[at].notifies {
      let mut endpoint = usize.ZERO
      while endpoint < endpoints.length {
        run List<usize>.append(&mut targets, endpoints[endpoint])
        endpoint = endpoint + usize.ONE
      }
    }
    if summaries[at].releases {
      let mut glue = usize.ZERO
      while glue < packageGlues.length {
        run List<usize>.append(&mut targets, packageGlues[glue])
        glue = glue + usize.ONE
      }
    }
    run List<List<usize>>.append(&mut edges, move targets)
    at = at + usize.ONE
  }
  return move edges
}

// Marks the reached instances that can park externally: each one that runs a park, then each one
// that calls a marked instance directly or runs one indirectly, to a fixed point. Unlike [`closeSuspendable`], a
// fixed-linkage shim is marked too: the instance it calls parks whoever invokes it. Driving an
// Execution resumes its body through the package's erased start, not a direct call, so a driver
// does not park when its body does.
effect fn closeParking(summaries: &[SuspensionSummary]) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  return run closeParkingThrough(summaries, &[])
}

// Closed ambient dispatchers have their own, stronger proof. A failing implementation
// is reported by that proof; entry-point and other caller proofs can rely on the contract.
effect fn closeParkingThrough(summaries: &[SuspensionSummary], boundaries: &[bool]) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut marked = List<bool>.make()
  let mut any = false
  let mut at = usize.ZERO
  while at < summaries.length {
    let origin = match &summaries[at].park {
      Option<Span>.Some {..} => boundaries.length == usize.ZERO || !boundaries[at]
      Option<Span>.None => false
    }
    run List<bool>.append(&mut marked, origin)
    any = any || origin
    at = at + usize.ONE
  }
  if !any { return move marked }
  let edges = run summaryEdges(summaries)
  let mut callers = run summaryCallers(summaries, List<List<CallEdge>>.asSlice(&edges))
  let runs = run indirectEdges(summaries)
  let indirect = List<List<usize>>.asSlice(&runs)
  let incoming = List<List<CallEdge>>.asMutSlice(&mut callers)
  at = usize.ZERO
  while at < indirect.length {
    let targets = List<usize>.asSlice(&indirect[at])
    let mut edge = usize.ZERO
    while edge < targets.length {
      run List<CallEdge>.append(&mut incoming[targets[edge]], CallEdge {target: at, call: usize.MAX})
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  run closeCallers(&mut marked, List<List<CallEdge>>.asSlice(&callers), boundaries)
  return move marked
}

// Adds the definition digest of each of `summaries` that can park externally to `parking`.
pub effect fn parkingDefinitions(summaries: &[SuspensionSummary], parking: &mut DigestSet) -> () ! OutOfMemoryError ? &mut Allocator {
  let parks = run closeParking(summaries)
  let marked = List<bool>.asSlice(&parks)
  let mut at = usize.ZERO
  while at < marked.length {
    if marked[at] { drop run DigestSet.add(&mut parking.*, run InstanceKey.definitionDigest(&summaries[at].key)) }
    at = at + usize.ONE
  }
  return ()
}

// A stored NonParking value names its target before a run supplies that target's providers.
effect fn providerFreeKey(key: &InstanceKey) -> Option<InstanceKey> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if providedKey(key) {
    if let Result<InstanceKey, CanonicalizationFailure>.Success {value} = move run InstanceKey.function(run InstanceKey.selected(key)) {
      return Option<InstanceKey>.some(move value)
    }
  }
  return Option<InstanceKey>.none()
}

effect fn bareKeys(summaries: &[SuspensionSummary]) -> List<Option<InstanceKey>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut bare = run List<Option<InstanceKey>>.makeWithCapacity(summaries.length)
  let mut at = usize.ZERO
  while at < summaries.length {
    run List<Option<InstanceKey>>.append(&mut bare, run providerFreeKey(&summaries[at].key))
    at = at + usize.ONE
  }
  return move bare
}

struct InlinedProofTarget {
  plain: InstanceKey,
  summary: usize,
  inlineIndex: usize,
  position: usize,
}

// Queue the exact application once, preserving the edge that will reconstruct it during replay.
effect fn requestProof(key: &InstanceKey, site: &ParkObligation, origin: VisitOrigin, requested: &mut List<InstanceKey>,
  pending: &mut List<BackendVisit>, origins: &mut List<VisitOrigin>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let earlier = List<InstanceKey>.asSlice(&requested.*)
  let mut at = usize.ZERO
  while at < earlier.length {
    if run InstanceKey.sameInstance(&earlier[at], key) { return false }
    at = at + usize.ONE
  }
  run List<InstanceKey>.append(&mut requested.*, InstanceKey.copy(key))
  run List<BackendVisit>.append(&mut pending.*, BackendVisit.Enter {key: InstanceKey.copy(key), edge: Edge.Direct,
    span: site.span, module: ModuleId.copy(&site.module), cleanup: Option<Interned<Type>>.none(), requester: Option<RelatedSite>.none()})
  run List<VisitOrigin>.append(&mut origins.*, origin)
  return true
}

// Enters each exact NonParking target that no reached body runs and that was not requested before, at
// its obligation's site. Answers whether any was entered.
// Each target entered is reached as `requestedTarget` of the capture entry in `summarized` beside
// its summary, which `origins` records beside `pending`.
pub effect fn requestUnreached(summaries: &[SuspensionSummary], summarized: &[usize], functions: &[MirFunction], reached: &[usize], requested: &mut List<InstanceKey>,
  pending: &mut List<BackendVisit>, origins: &mut List<VisitOrigin>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut owing = false
  let mut at = usize.ZERO
  while at < summaries.length {
    if List<ParkObligation>.length(&summaries[at].nonParking) > usize.ZERO { owing = true }
    at = at + usize.ONE
  }
  if !owing { return false }
  // Discovery records obligations only for bodies that introduce them. A provider-specialized
  // callee can satisfy an obligation even when its own body introduces none.
  let mut keys = run List<InstanceKey>.makeWithCapacity(reached.length)
  let mut lookup = InternIndex.make()
  at = usize.ZERO
  while at < reached.length {
    let key = &functions[reached[at]].key
    run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(key))
    run List<InstanceKey>.append(&mut keys, InstanceKey.copy(key))
    if let Option<InstanceKey>.Some {value: plain} = move run providerFreeKey(key) {
      run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&plain))
      run List<InstanceKey>.append(&mut keys, move plain)
    }
    at = at + usize.ONE
  }
  // An inlined finalizer can have no standalone body, whether it was spliced at a suspension
  // point or as a quiet body. Its actual provider is still part of the inline key. Several calls
  // of a stored finalizer can select different providers.
  let mut inlined = List<InlinedProofTarget>.make()
  let mut inlineLookup = InternIndex.make()
  at = usize.ZERO
  while at < summaries.length {
    let count = List<InstanceKey>.length(&summaries[at].inlined) + List<InstanceKey>.length(&summaries[at].quiet)
    if count != usize.ZERO {
      let owed = List<ParkObligation>.asSlice(&summaries[at].nonParking)
      let mut base = usize.ZERO
      let mut obligation = usize.ZERO
      while obligation < owed.length {
        base = base + List<InstanceKey>.length(&owed[obligation].callees)
        obligation = obligation + usize.ONE
      }
      let mut each = usize.ZERO
      while each < count {
        if let Option<&InstanceKey>.Some {value: spliced} = move splicedAt(&summaries[at], each) {
          if let Option<InstanceKey>.Some {value: plain} = move run providerFreeKey(spliced) {
            run InternIndex.record(&mut inlineLookup, InstanceKey.runtimeHash(&plain))
            run List<InlinedProofTarget>.append(&mut inlined, InlinedProofTarget {plain: move plain, summary: at, inlineIndex: each, position: base + each})
          }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let targets = List<InlinedProofTarget>.asSlice(&inlined)
  let mut entered = false
  at = usize.ZERO
  while at < summaries.length {
    let owed = List<ParkObligation>.asSlice(&summaries[at].nonParking)
    let mut obligation = usize.ZERO
    // The position of each callee among every obligation's callees, as `requestedTarget` counts.
    let mut position = usize.ZERO
    while obligation < owed.length {
      let callees = List<InstanceKey>.asSlice(&owed[obligation].callees)
      let mut callee = usize.ZERO
      if !owed[obligation].exact { position = position + callees.length }
      while owed[obligation].exact && callee < callees.length {
        let target = &callees[callee]
        let mut specialized = false
        let mut found = InternIndex.first(&inlineLookup, InstanceKey.runtimeHash(target))
        while found != usize.MAX {
          let candidate = &targets[found]
          if run InstanceKey.sameInstance(&candidate.plain, target) {
            specialized = true
            if let Option<&InstanceKey>.Some {value: full} = move splicedAt(&summaries[candidate.summary], candidate.inlineIndex) {
              if !run definitionVisited(List<InstanceKey>.asSlice(&keys), &lookup, full) {
                if run requestProof(full, &owed[obligation], VisitOrigin {parent: summarized[candidate.summary], position: candidate.position, requested: true},
                  &mut requested.*, &mut pending.*, &mut origins.*) { entered = true }
              }
            }
          }
          found = InternIndex.after(&inlineLookup, found)
        }
        if !specialized && !run definitionVisited(List<InstanceKey>.asSlice(&keys), &lookup, target) {
          if run requestProof(target, &owed[obligation], VisitOrigin {parent: summarized[at], position: position, requested: true},
            &mut requested.*, &mut pending.*, &mut origins.*) { entered = true }
        }
        callee = callee + usize.ONE
        position = position + usize.ONE
      }
      obligation = obligation + usize.ONE
    }
    at = at + usize.ONE
  }
  return entered
}

struct UncoveredCycle { site: ErasureFact, operation: DeclarationId, caller: DeclarationId, origin: BodyOrigin }

// The raw walk checks these paths before inlining, frame selection or cache replay. Each
// report identifies the conversion and the authored call inside the cycle that closes it.
effect fn uncoveredDispatchCycles(resolver: &mut Resolver) -> List<Shared<Rejection>>
  ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut reports = List<Shared<Rejection>>.make()
  let operations = List<ErasedRecursion.Operation>.asSlice(&resolver.effectDispatchers)
  if operations.length == usize.ZERO { return move reports }
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  let reached = List<usize>.asSlice(&resolver.emittedMir)
  let mut cycles = List<UncoveredCycle>.make()
  let paths = run ErasedRecursion.reentries(functions, reached, operations)
  let found = List<ErasedRecursion.Reentry>.asSlice(&paths)
  let mut i = usize.ZERO
  while i < found.length {
    let reentry = &found[i]
    let operation = &operations[reentry.operation]
    let witness = &List<ErasedRecursion.Witness>.asSlice(&operation.witnesses)[reentry.witness]
    run List<UncoveredCycle>.append(&mut cycles, UncoveredCycle {site: ErasureFact.copy(&witness.site),
      operation: DeclarationId.copyShared(&InstanceKey.identity(&operation.key)), caller: DeclarationId.copyShared(&InstanceKey.identity(&functions[reentry.caller].key)), origin: reentry.origin})
    i = i + usize.ONE
  }
  let issues = List<UncoveredCycle>.asSlice(&cycles)
  i = usize.ZERO
  while i < issues.length {
    let cycle = &issues[i]
    let owner = DeclarationId.copyShared(&cycle.site.owner)
    let module = DeclarationId.moduleId(&owner)
    let anchor = run declarationAnchor(&mut resolver.*, &owner)
    let mut diagnostic = run makeRejection(RejectionCode.ErasedRecursion, module, anchoredSpan(&anchor, cycle.site.origin))
    let from = run declarationAnchor(&mut resolver.*, &cycle.caller)
    diagnostic.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(DeclarationId.moduleId(&cycle.caller)), span: anchoredSpan(&from, cycle.origin)})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: run writtenTypeName(module, &cycle.site.source)})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: run shownName(&mut resolver.*, &cycle.operation)})
    run List<Shared<Rejection>>.append(&mut reports, run Shared<Rejection>.make(move diagnostic))
    i = i + usize.ONE
  }
  return move reports
}

// SEM0139 for a value owed `Intrinsic.NonParking` that can park, naming the function it runs when
// it has one exact target.
// A provider-free proof request is attributed to the bound that requested it. Its related site
// identifies the operation whose provider the stored Effect would need when run.
pub effect fn proofProviderRejection(rejected: Shared<Rejection>, key: &InstanceKey, module: &ModuleId, span: Span) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let missing = Shared<Rejection>.with<bool>(&rejected, |value: &Rejection| -> bool {
    let args = List<MessageArgument>.asSlice(&value.arguments)
    return value.code == RejectionCode.UnhandledRequirement && args.length != usize.ZERO && same(Bytes.asSlice(&args[0].name), b"provider")
  })
  if !missing { return move rejected }
  let mut diagnostic = run makeRejection(RejectionCode.UnsatisfiedExecutableProperty, module, span)
  diagnostic.related = Option<RelatedSite>.some(Shared<Rejection>.with<RelatedSite>(&rejected, |value: &Rejection| -> RelatedSite {
    return RelatedSite {module: ModuleId.copy(&value.module), span: value.span}
  }))
  let id = DeclarationId.copyShared(&InstanceKey.identity(key))
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"4")})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"value"), value: run DeclarationId.copySpelling(&id)})
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"provider"), value: run sharedArgumentBytes(&rejected, usize.ZERO, false)})
  return run Shared<Rejection>.make(move diagnostic)
}

// Check an erased operation's NonParking promise over every reached provider specialization.
// A module's escape walk may leave a plain body to its own module's check. The closed
// discovery graph still holds that body's parking and calls, including proof-only witnesses.
effect fn checkedErasedPromises(resolver: &mut Resolver, root: &ModuleId) -> List<Shared<Rejection>>
  ! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let reached = List<usize>.asSlice(&resolver.emittedMir)
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  let mut promised = false
  let mut at = usize.ZERO
  while at < reached.length && !promised {
    let owed = List<MirNonParkingRun>.asSlice(&functions[reached[at]].nonParking)
    let mut obligation = usize.ZERO
    while obligation < owed.length {
      if let ParkOrigin.Conversion {..} = &owed[obligation].origin { promised = true break }
      obligation = obligation + usize.ONE
    }
    at = at + usize.ONE
  }
  if !promised { return List<Shared<Rejection>>.make() }
  let mut summaries = run List<SuspensionSummary>.makeWithCapacity(reached.length)
  at = usize.ZERO
  while at < List<usize>.length(&resolver.emittedMir) {
    let body = List<usize>.get(&resolver.emittedMir, at)
    let instance = InstanceKey.copy(&List<MirFunction>.asSlice(&resolver.mirValues)[body].key)
    let owner = DeclarationId.copyShared(&InstanceKey.identity(&instance))
    let anchor = run instanceAnchor(&mut resolver.*, &instance)
    let module = DeclarationId.moduleId(&owner)
    let definition = &List<MirFunction>.asSlice(&resolver.mirValues)[body]
    let checked = List<MirNonParkingRun>.length(&definition.nonParking) != usize.ZERO && operationDispatch(&instance) == OperationDispatch.Erased
    let mut caller = RelatedSite {module: ModuleId.copy(module), span: Span.make(usize.ZERO, usize.ZERO)}
    if checked {
      let calls = List<DiscoveryDispatch>.asSlice(&resolver.erasureDispatchers)
      let mut call = usize.ZERO
      while call < calls.length && !run InstanceKey.sameInstance(&calls[call].instance, &instance) { call = call + usize.ONE }
      if call == calls.length { return CompilerBug.panic(b"a reached erased promise has no dispatcher call") }
      caller = RelatedSite {module: ModuleId.copy(&calls[call].call.module), span: calls[call].call.span}
    }
    let mut summary = run SuspensionSummary.make(definition, &instance, module, &anchor, &caller.module, caller.span)
    if !checked { summary.nonParking = List<ParkObligation>.make() }
    run List<SuspensionSummary>.append(&mut summaries, move summary)
    at = at + usize.ONE
  }
  return run nonParkingViolations(&mut resolver.*, List<SuspensionSummary>.asSlice(&summaries), root)
}

// The receiver whose witness this call selected. Some dispatchers retain the provider on
// the specialization. A resolved source witness instead has an ordinary named instance.
effect fn calledWitnessReceiver(caller: &SuspensionSummary, callee: &SuspensionSummary) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run InstanceKey.selected(&callee.key)
  if let SpecializationTarget.Operation {provider, ..} = &application.target {
    return Option<Interned<Type>>.some(Interned<Type>.clone(&provider))
  }
  if let Option<Interned<Type>>.Some {value} = &callee.receiver {
    let witnesses = List<InstanceKey>.asSlice(&caller.witnesses)
    let mut at = usize.ZERO
    while at < witnesses.length {
      if run InstanceKey.sameInstance(&witnesses[at], &callee.key) { return Option<Interned<Type>>.some(Interned<Type>.clone(&value)) }
      at = at + usize.ONE
    }
  }
  return Option<Interned<Type>>.none()
}

// A generic ambient operation can reach an implementation selected for a value supplied
// by its caller. Follow only edges that can suspend, starting below each provider arm:
// a provider's own suspension is still reported at the provider's introduction.
effect fn ambientArgumentWitness(summaries: &[SuspensionSummary], lookup: &InternIndex, marked: &[bool],
  obligation: &ParkObligation, dispatcher: &InstanceKey) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = run InstanceKey.selected(dispatcher)
  let arguments = List<Argument>.asSlice(&selected.arguments)
  let mut supplied = List<Interned<Type>>.make()
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {value} = &arguments[at] {
      run List<Interned<Type>>.append(&mut supplied, Interned<Type>.clone(&value))
      // Formatting an argument record selects each field's witness. Generated trace
      // records borrow the arguments so recording them does not consume their values.
      if let Option<AnonymousParts>.Some {value: record} = move run Type.anonymousParts(&value) {
        let members = List<Interned<Type>>.asSlice(&record.members)
        let mut field = usize.ZERO
        while field < members.length {
          let ty = match move Interned<Type>.with<Option<Interned<Type>>>(&members[field], referenceReferent) {
            Option<Interned<Type>>.Some {value: referent} => move referent
            Option<Interned<Type>>.None => Interned<Type>.clone(&members[field])
          }
          run List<Interned<Type>>.append(&mut supplied, move ty)
          field = field + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  let types = List<Interned<Type>>.asSlice(&supplied)
  if types.length == usize.ZERO { return Option<Interned<Type>>.none() }
  let mut pending = List<usize>.make()
  let mut seen = List<bool>.make()
  run List<bool>.appendRepeated(&mut seen, false, summaries.length)
  let roots = List<InstanceKey>.asSlice(&obligation.callees)
  at = usize.ZERO
  while at < roots.length {
    let root = run summaryPosition(summaries, lookup, &roots[at])
    if root != usize.MAX && marked[root] {
      run List<usize>.append(&mut pending, root)
      List<bool>.set(&mut seen, root, true)
    }
    at = at + usize.ONE
  }
  let mut head = usize.ZERO
  while head < List<usize>.length(&pending) {
    let current = List<usize>.get(&pending, head)
    head = head + usize.ONE
    let callees = List<InstanceKey>.asSlice(&summaries[current].callees)
    let mut edge = usize.ZERO
    while edge < callees.length {
      let child = run summaryPosition(summaries, lookup, &callees[edge])
      edge = edge + usize.ONE
      if child == usize.MAX || !marked[child] { continue }
      if let Option<Interned<Type>>.Some {value: receiver} = move run calledWitnessReceiver(&summaries[current], &summaries[child]) {
        at = usize.ZERO
        while at < types.length {
          if run Type.runtimeEqualsShared(&types[at], &receiver) { return Option<Interned<Type>>.some(move receiver) }
          at = at + usize.ONE
        }
      }
      if List<bool>.get(&seen, child) { continue }
      List<bool>.set(&mut seen, child, true)
      run List<usize>.append(&mut pending, child)
    }
  }
  return Option<Interned<Type>>.none()
}

// A directive's argument record retains the generating syntax, even after an ambient
// operation specializes on it. Ordinary source record literals retain their own syntax.
effect fn traceArgumentSite(resolver: &mut Resolver, dispatcher: &InstanceKey) -> Option<RelatedSite>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let application = run InstanceKey.selected(dispatcher)
  let arguments = List<Argument>.asSlice(&application.arguments)
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {value} = &arguments[at] {
      if let Option<AnonymousParts>.Some {value: record} = move run Type.anonymousParts(&value) {
        let owner = Frozen<AnonymousOccurrence>.with<DeclarationId>(&record.occurrence, |item: &AnonymousOccurrence| -> DeclarationId {
          return DeclarationId.copyShared(&item.declaration)
        })
        let syntax = Frozen<AnonymousOccurrence>.with<usize>(&record.occurrence, |item: &AnonymousOccurrence| -> usize { return item.syntax })
        let module = DeclarationId.moduleId(&owner)
        let answer = run observedSource(&mut resolver.*, module, SourceSelector.Identity {identity: DeclarationId.copy(&owner)})
        if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &answer, module) {
          if let Option<usize>.Some {value: ordinal} = move ModuleIndex.ordinalOf(IndexedSource.moduleIndex(indexed), &owner) {
            if let Option<Anchor>.Some {value: anchor} = move IndexedSource.anchorOf(indexed, ordinal) {
              let id = Anchor.hir(&anchor, syntax)
              let hir = IndexedSource.authored(indexed)
              if let Option<DirectiveKind>.Some {value: DirectiveKind.Trace} = Directives.kindOf(hir, id) {
                return Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(module), span: Module.span(hir, id)})
              }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<RelatedSite>.none()
}

effect fn parkingRejection(resolver: &mut Resolver, owed: &ParkObligation, summary: &SuspensionSummary,
  argument: &Option<Interned<Type>>) -> Shared<Rejection>
! Cycle | OutOfMemoryError ? &mut Allocator {
  if let Option<Interned<Type>>.Some {value: args} = &owed.trace {
    let mut names = Bytes.make()
    if let Option<AnonymousParts>.Some {value: record} = move run Type.anonymousParts(&args) {
      let members = List<Interned<Type>>.asSlice(&record.members)
      let mut at = usize.ZERO
      while at < members.length {
        if let Option<Interned<Type>>.Some {value: ty} = move Interned<Type>.with<Option<Interned<Type>>>(&members[at], referenceReferent) {
          if at > usize.ZERO { run Bytes.append(&mut names, b", ") }
          run Bytes.append(&mut names, Bytes.asSlice(&run writtenTypeName(&owed.module, &ty)))
        }
        at = at + usize.ONE
      }
    }
    let mut diagnostic = run makeRejection(RejectionCode.TraceSuspension, &owed.module, owed.span)
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"types"), value: move names})
    return run Shared<Rejection>.make(move diagnostic)
  }
  if let Option<Interned<Type>>.Some {value: ty} = &argument.* {
    if let Option<RelatedSite>.Some {value: site} = move run traceArgumentSite(&mut resolver.*, &summary.key) {
      let mut diagnostic = run makeRejection(RejectionCode.TraceSuspension, &site.module, site.span)
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"types"), value: run writtenTypeName(&site.module, &ty)})
      return run Shared<Rejection>.make(move diagnostic)
    }
    if let Option<RelatedSite>.Some {value: call} = &summary.ambientCall {
      let mut diagnostic = run makeRejection(RejectionCode.AmbientSuspension, &call.module, call.span)
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: run writtenTypeName(&call.module, &ty)})
      return run Shared<Rejection>.make(move diagnostic)
    }
  }
  if owed.ambient { return run reject(&resolver.*, &owed.module, RejectionCode.AmbientSuspension, owed.span) }
  if let Option<ErasureFact>.Some {value: fact} = &owed.conversion {
    let owner = DeclarationId.copyShared(&fact.owner)
    let module = DeclarationId.moduleId(&owner)
    let anchor = run declarationAnchor(&mut resolver.*, &owner)
    let mut diagnostic = run makeRejection(RejectionCode.UnsatisfiedExecutableProperty, module, anchoredSpan(&anchor, fact.origin))
    diagnostic.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&owed.module), span: owed.span})
    let operation = DeclarationId.copyShared(&InstanceKey.identity(&summary.key))
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"3")})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"member"), value: run writtenTypeName(module, &fact.source)})
    run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: run shownName(&mut resolver.*, &operation)})
    return run Shared<Rejection>.make(move diagnostic)
  }
  let mut diagnostic = run makeRejection(RejectionCode.UnsatisfiedExecutableProperty, &owed.module, owed.span)
  let mut template: &[u8] = b"2"
  let callees = List<InstanceKey>.asSlice(&owed.callees)
  if owed.exact && callees.length == usize.ONE {
    let identity = InstanceKey.identity(&callees[usize.ZERO])
    let owners = Interned<DeclarationId>.with<usize>(&identity, DeclarationId.ownerCount)
    if owners != usize.ZERO && Interned<DeclarationId>.with<bool>(&identity, |id: &DeclarationId| -> bool {
      return DeclarationId.ownerNamed(id, owners - usize.ONE)
    }) {
      let named = DeclarationId.copyShared(&identity)
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"value"),
        value: run DeclarationId.copyOwnerName(&named, owners - usize.ONE)})
      template = b"1"
    }
  }
  run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
  return run Shared<Rejection>.make(move diagnostic)
}

// Rejects each reached `Intrinsic.NonParking` obligation that is not proved (SEM0139): a value with
// no exact executable target, or one an instance it runs can park externally. The walk enters
// every exact target the program never runs (`requestUnreached`), so a target still unreached
// here has no body to prove it: a callable schema whose declaration has no reached instance, or a
// target whose lowering stopped. The application module's sites are reported first and the
// runtime module's last, so the first diagnostic is the application's own call, as in the bootstrap.
pub effect fn nonParkingViolations(resolver: &mut Resolver, summaries: &[SuspensionSummary], runtime: &ModuleId) -> List<Shared<Rejection>>
! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut violations = List<Shared<Rejection>>.make()
  let mut owing = false
  let mut at = usize.ZERO
  while at < summaries.length {
    if List<ParkObligation>.length(&summaries[at].nonParking) > usize.ZERO { owing = true }
    at = at + usize.ONE
  }
  if !owing { return move violations }
  let mut boundaries = List<bool>.make()
  at = usize.ZERO
  while at < summaries.length {
    let dispatcher = !summaries[at].ambientCall.isNone()
    run List<bool>.append(&mut boundaries, dispatcher)
    at = at + usize.ONE
  }
  let parks = run closeParkingThrough(summaries, List<bool>.asSlice(&boundaries))
  let mut suspendable = List<bool>.make()
  let bare = run bareKeys(summaries)
  let plain = List<Option<InstanceKey>>.asSlice(&bare)
  let mut lookup = InternIndex.make()
  let mut plainLookup = InternIndex.make()
  at = usize.ZERO
  while at < summaries.length {
    run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&summaries[at].key))
    let hash = match &plain[at] {
      Option<InstanceKey>.Some {value} => InstanceKey.runtimeHash(&value)
      Option<InstanceKey>.None => InstanceKey.runtimeHash(&summaries[at].key)
    }
    run InternIndex.record(&mut plainLookup, hash)
    at = at + usize.ONE
  }
  // The application's own sites come first, then other modules', then the runtime's.
  let mut application = Option<ModuleId>.none()
  if resolver.currentApplication != usize.MAX {
    application = Option<ModuleId>.some(resolvedModule(&resolver.*, resolver.currentApplication))
  }
  let mut middle = List<Shared<Rejection>>.make()
  let mut later = List<Shared<Rejection>>.make()
  let mut reported = List<ParkSite>.make()
  at = usize.ZERO
  while at < summaries.length {
    let owed = List<ParkObligation>.asSlice(&summaries[at].nonParking)
    let mut obligation = usize.ZERO
    while obligation < owed.length {
      if owed[obligation].ambient && List<bool>.length(&suspendable) == usize.ZERO {
        suspendable = run closeSuspendable(summaries)
      }
      let marked = if owed[obligation].ambient { List<bool>.asSlice(&suspendable) } else { List<bool>.asSlice(&parks) }
      let mut proved = owed[obligation].exact
      let callees = List<InstanceKey>.asSlice(&owed[obligation].callees)
      let mut callee = usize.ZERO
      while proved && callee < callees.length {
        let mut reached = false
        let hash = InstanceKey.runtimeHash(&callees[callee])
        let mut target = InternIndex.first(&lookup, hash)
        while target != usize.MAX {
          if run InstanceKey.sameInstance(&summaries[target].key, &callees[callee]) {
            reached = true
            if marked[target] { proved = false }
          }
          target = InternIndex.after(&lookup, target)
        }
        target = InternIndex.first(&plainLookup, hash)
        while target != usize.MAX {
          if let Option<InstanceKey>.Some {value: stripped} = &plain[target] {
            if run InstanceKey.sameInstance(&stripped, &callees[callee]) {
              reached = true
              if marked[target] { proved = false }
            }
          }
          target = InternIndex.after(&plainLookup, target)
        }
        if !reached { proved = false }
        callee = callee + usize.ONE
      }
      let named = List<Interned<DeclarationId>>.asSlice(&owed[obligation].declarations)
      let mut declaration = usize.ZERO
      while proved && declaration < named.length {
        let mut reached = false
        let mut target = usize.ZERO
        while target < summaries.length {
          let identity = InstanceKey.identity(&summaries[target].key)
          if sameDeclaration(&identity, &named[declaration]) {
            reached = true
            if marked[target] { proved = false }
          }
          // An instance inlined everywhere has no summary of its own; it runs, and so may park,
          // only as part of a function that inlined it. `requestUnreached` enters an exact callee
          // of an obligation that no summary runs, so only a declaration's instances need this.
          // An inlined instance that is also reached has a summary, which answers for it above:
          // what the function that inlined it does besides is not the instance's doing.
          let spliced = List<InstanceKey>.asSlice(&summaries[target].inlined)
          let mut each = usize.ZERO
          while each < spliced.length {
            let inlined = InstanceKey.identity(&spliced[each])
            if sameDeclaration(&inlined, &named[declaration]) {
              let mut summarized = false
              let mut own = InternIndex.first(&lookup, InstanceKey.runtimeHash(&spliced[each]))
              while own != usize.MAX && !summarized {
                summarized = run InstanceKey.sameInstance(&summaries[own].key, &spliced[each])
                own = InternIndex.after(&lookup, own)
              }
              if !summarized {
                reached = true
                if marked[target] { proved = false }
              }
            }
            each = each + usize.ONE
          }
          // A quiet body spliced here is reached and cannot park, whatever this function does.
          let settled = List<InstanceKey>.asSlice(&summaries[target].quiet)
          each = usize.ZERO
          while each < settled.length {
            let inlined = InstanceKey.identity(&settled[each])
            if sameDeclaration(&inlined, &named[declaration]) { reached = true }
            each = each + usize.ONE
          }
          target = target + usize.ONE
        }
        if !reached { proved = false }
        declaration = declaration + usize.ONE
      }
      let dropped = List<Interned<Type>>.asSlice(&owed[obligation].glues)
      let mut glue = usize.ZERO
      while proved && glue < dropped.length {
        let identity = InstanceKey.identity(&summaries[at].key)
        let owner = DeclarationId.copyShared(&identity)
        if run parkingGlue(summaries, marked, &dropped[glue], &owner) { proved = false }
        glue = glue + usize.ONE
      }
      if !proved && (!summaries[at].ambientCall.isNone() || !Option<ErasureFact>.isNone(&owed[obligation].conversion) || !reportedSite(List<ParkSite>.asSlice(&reported), &owed[obligation])) {
        run List<ParkSite>.append(&mut reported, ParkSite {module: ModuleId.copy(&owed[obligation].module), span: owed[obligation].span})
        let argument = if owed[obligation].ambient && !summaries[at].ambientCall.isNone() {
          run ambientArgumentWitness(summaries, &lookup, marked, &owed[obligation], &summaries[at].key)
        } else { Option<Interned<Type>>.none() }
        let diagnostic = run parkingRejection(&mut resolver.*, &owed[obligation], &summaries[at], &argument)
        let site = Shared<Rejection>.with<DeclarationRejectionSite>(&diagnostic, declarationRejectionSite)
        let own = match &application {
          Option<ModuleId>.Some {value} => ModuleId.equals(&site.module, &value)
          Option<ModuleId>.None => false
        }
        if own {
          run appendDeclarationRejection(&mut violations, move diagnostic)
        } else if ModuleId.equals(&site.module, runtime) {
          run appendDeclarationRejection(&mut later, move diagnostic)
        } else {
          run appendDeclarationRejection(&mut middle, move diagnostic)
        }
      }
      obligation = obligation + usize.ONE
    }
    at = at + usize.ONE
  }
  while List<Shared<Rejection>>.length(&middle) > usize.ZERO {
    run List<Shared<Rejection>>.append(&mut violations, List<Shared<Rejection>>.remove(&mut middle, usize.ZERO))
  }
  while List<Shared<Rejection>>.length(&later) > usize.ZERO {
    run List<Shared<Rejection>>.append(&mut violations, List<Shared<Rejection>>.remove(&mut later, usize.ZERO))
  }
  return move violations
}

fn sameDeclaration(left: &Interned<DeclarationId>, right: &Interned<DeclarationId>) -> bool {
  return Interned<DeclarationId>.with<bool>(left, |first: &DeclarationId| -> bool { return declarationIs(first, right) })
}

fn declarationIs(first: &DeclarationId, right: &Interned<DeclarationId>) -> bool {
  return Interned<DeclarationId>.with<bool>(right, |second: &DeclarationId| -> bool { return DeclarationId.equals(first, second) })
}

// Whether the drop glue of `ty` may park: its key, built as every drop site builds it, names a
// reached park-marked instance, or no key can be built (fail closed). A type without cleanup has no
// glue, and a glue the build never reaches never runs.
effect fn parkingGlue(summaries: &[SuspensionSummary], marked: &[bool], ty: &Interned<Type>, owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let glue = match move run InstanceKey.dropGlue(ty, owner) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value} => match move value {
      Option<InstanceKey>.Some {value: key} => move key
      Option<InstanceKey>.None => { return false }
    }
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {..} => { return true }
  }
  let mut at = usize.ZERO
  while at < summaries.length {
    if marked[at] {
      if run InstanceKey.sameInstance(&summaries[at].key, &glue) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// One reported NonParking site; each site is reported once.
struct ParkSite {
  module: ModuleId,
  span: Span,
}

fn reportedSite(reported: &[ParkSite], obligation: &ParkObligation) -> bool {
  let mut at = usize.ZERO
  while at < reported.length {
    if ModuleId.equals(&reported[at].module, &obligation.module) && sameSpan(reported[at].span, obligation.span) { return true }
    at = at + usize.ONE
  }
  return false
}

// One reported local-shared access escape: the escape's own site and the call it relates to.
struct EscapeReport {
  module: ModuleId,
  span: Span,
  relatedModule: ModuleId,
  related: Span,
}

fn runCall(escapes: &[SummaryEscape], span: Span) -> bool {
  let mut at = usize.ZERO
  while at < escapes.length {
    if escapes[at].kind == MirAccessEscape.Suspension && sameSpan(escapes[at].span, span) { return true }
    at = at + usize.ONE
  }
  return false
}

pub fn sameSpan(left: Span, right: Span) -> bool {
  return left.start == right.start && left.end == right.end
}

fn reportedEscape(reports: &[EscapeReport], module: &ModuleId, span: Span, site: &RelatedSite) -> bool {
  let mut at = usize.ZERO
  while at < reports.length {
    if sameSpan(reports[at].span, span) && sameSpan(reports[at].related, site.span) && ModuleId.equals(&reports[at].module, module)
      && ModuleId.equals(&reports[at].relatedModule, &site.module) { return true }
    at = at + usize.ONE
  }
  return false
}

fn sharesDeclaration(left: &[DeclarationId], right: &[DeclarationId]) -> bool {
  let mut at = usize.ZERO
  while at < left.length {
    let mut other = usize.ZERO
    while other < right.length {
      if DeclarationId.equals(&left[at], &right[other]) { return true }
      other = other + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// The callable declarations an instance's application carries: what its callable parameters were
// specialized over.
effect fn carriedCallables(key: &InstanceKey) -> List<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
  let mut carried = List<DeclarationId>.make()
  if let Option<Interned<Application>>.Some {value: application} = move InstanceKey.application(key) {
    let count = Interned<Application>.with<usize>(&application, Application.typeCount)
    let mut at = usize.ZERO
    while at < count {
      let argument = Interned<Application>.with<Option<Interned<Type>>>(&application, |selected: &Application| -> Option<Interned<Type>> {
        return Application.typeAt(selected, at)
      })
      if let Option<Interned<Type>>.Some {value} = move argument { run Type.appendCallableTargets(&value, &mut carried) }
      at = at + usize.ONE
    }
  }
  return move carried
}

// The calls where a held access's callback entered its access wrappers (SHARED-003). A wrapper
// instance is specialized over the callable it forwards, so callers are walked upward while they
// carry a callable the instance they call carries; the first caller that carries none of them named
// the callback itself. An access holder that carries no callable names its callback at the access.
effect fn accessEntries(summaries: &[SuspensionSummary], callers: &[List<CallEdge>], carried: &[List<DeclarationId>],
  holder: usize, access: Span) -> List<RelatedSite> ! OutOfMemoryError ? &mut Allocator {
  let mut sites = List<RelatedSite>.make()
  let mut pending = List<usize>.make()
  let mut visited = List<bool>.make()
  while List<bool>.length(&visited) < summaries.length { run List<bool>.append(&mut visited, false) }
  if List<DeclarationId>.length(&carried[holder]) > usize.ZERO { run List<usize>.append(&mut pending, holder) }
  else { run List<RelatedSite>.append(&mut sites, RelatedSite {module: ModuleId.copy(&summaries[holder].module), span: access}) }
  let mut head = usize.ZERO
  while head < List<usize>.length(&pending) {
    let current = List<usize>.get(&pending, head)
    head = head + usize.ONE
    // `callers[current]` lists every edge into `current` in caller order, then call order.
    let incoming = List<CallEdge>.asSlice(&callers[current])
    let mut edge = usize.ZERO
    while edge < incoming.length {
      let caller = incoming[edge].target
      if sharesDeclaration(List<DeclarationId>.asSlice(&carried[caller]), List<DeclarationId>.asSlice(&carried[current])) {
        let marks = List<bool>.asMutSlice(&mut visited)
        if !marks[caller] {
          marks[caller] = true
          run List<usize>.append(&mut pending, caller)
        }
      } else {
        let span = List<Span>.get(&summaries[caller].calls, incoming[edge].call)
        run List<RelatedSite>.append(&mut sites, RelatedSite {module: ModuleId.copy(&summaries[caller].module), span: span})
      }
      edge = edge + usize.ONE
    }
    if incoming.length == usize.ZERO && current == holder {
      run List<RelatedSite>.append(&mut sites, RelatedSite {module: ModuleId.copy(&summaries[holder].module), span: access})
    }
  }
  return move sites
}

// The edges into each summary, in caller order and then call order: each entry's `target` is the
// calling summary and its `call` the call's position in the caller.
effect fn summaryCallers(summaries: &[SuspensionSummary], calls: &[List<CallEdge>]) -> List<List<CallEdge>>
! OutOfMemoryError ? &mut Allocator {
  let mut callers = List<List<CallEdge>>.make()
  while List<List<CallEdge>>.length(&callers) < summaries.length { run List<List<CallEdge>>.append(&mut callers, List<CallEdge>.make()) }
  let incoming = List<List<CallEdge>>.asMutSlice(&mut callers)
  let mut caller = usize.ZERO
  while caller < calls.length {
    let edges = List<CallEdge>.asSlice(&calls[caller])
    let mut edge = usize.ZERO
    while edge < edges.length {
      run List<CallEdge>.append(&mut incoming[edges[edge].target], CallEdge {target: caller, call: edges[edge].call})
      edge = edge + usize.ONE
    }
    caller = caller + usize.ONE
  }
  return move callers
}

// The summary whose instance is `key`, or `usize.MAX`, through a `runtimeHash` index of `summaries`.
effect fn summaryPosition(summaries: &[SuspensionSummary], lookup: &InternIndex, key: &InstanceKey) -> usize
! OutOfMemoryError ? &mut Allocator {
  let mut found = InternIndex.first(lookup, InstanceKey.runtimeHash(key))
  while found != usize.MAX {
    if run InstanceKey.sameInstance(&summaries[found].key, key) { return found }
    found = InternIndex.after(lookup, found)
  }
  return usize.MAX
}

// Every local-shared access escape of the reached instances (SHARED-003). From each held access,
// its callback and every instance the callback reaches through direct calls are walked
// breadth-first in call order. Each escape site found is reported at its own span and related to
// the call where the callback entered its access wrappers, once per pair.
pub effect fn localSharedEscapes(resolver: &Resolver, summaries: &[SuspensionSummary]) -> List<Shared<Rejection>>
! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Shared<Rejection>>.make()
  let mut reports = List<EscapeReport>.make()
  // Escapes are rare: without one, no access can report, so nothing below needs to run.
  let mut anyEscape = false
  let mut at = usize.ZERO
  while at < summaries.length && !anyEscape {
    anyEscape = List<SummaryEscape>.length(&summaries[at].escapes) > usize.ZERO
    at = at + usize.ONE
  }
  if !anyEscape { return move found }
  let lookup = run summaryLookup(summaries)
  // Each summary's call edges, looked up when a walk first reaches it, and the whole call graph's
  // callers with each instance's carried callables, built once a walk first reaches an escape.
  let mut reachedEdges = List<List<CallEdge>>.make()
  let mut edgesKnown = List<bool>.make()
  while List<bool>.length(&edgesKnown) < summaries.length {
    run List<List<CallEdge>>.append(&mut reachedEdges, List<CallEdge>.make())
    run List<bool>.append(&mut edgesKnown, false)
  }
  let mut incoming = List<List<CallEdge>>.make()
  let mut carriedBy = List<List<DeclarationId>>.make()
  let mut graphed = false
  // Each walk stamps the summaries it queued with its own number, so no walk clears marks.
  let mut queued = List<usize>.make()
  while List<usize>.length(&queued) < summaries.length { run List<usize>.append(&mut queued, usize.ZERO) }
  let mut walk = usize.ZERO
  let mut queue = List<usize>.make()
  let mut holder = usize.ZERO
  while holder < summaries.length {
    let accesses = List<CallbackBoundary>.asSlice(&summaries[holder].accesses)
    let mut access = usize.ZERO
    while access < accesses.length {
      let callback = run summaryPosition(summaries, &lookup, &accesses[access].key)
      if callback != usize.MAX {
        // The entry sites are computed once this walk reaches its first escape.
        let mut entries = Option<List<RelatedSite>>.none()
        walk = walk + usize.ONE
        List<usize>.truncate(&mut queue, usize.ZERO)
        run List<usize>.append(&mut queue, callback)
        let start = List<usize>.asMutSlice(&mut queued)
        start[callback] = walk
        let mut head = usize.ZERO
        while head < List<usize>.length(&queue) {
          let reached = List<usize>.get(&queue, head)
          head = head + usize.ONE
          let escapes = List<SummaryEscape>.asSlice(&summaries[reached].escapes)
          if escapes.length > usize.ZERO {
            if !graphed {
              let edges = run summaryEdgesIn(summaries, &lookup)
              incoming = run summaryCallers(summaries, List<List<CallEdge>>.asSlice(&edges))
              at = usize.ZERO
              while at < summaries.length {
                run List<List<DeclarationId>>.append(&mut carriedBy, run carriedCallables(&summaries[at].key))
                at = at + usize.ONE
              }
              graphed = true
            }
            if let Option<List<RelatedSite>>.None = &entries {
              entries = Option<List<RelatedSite>>.some(run accessEntries(summaries, List<List<CallEdge>>.asSlice(&incoming),
                List<List<DeclarationId>>.asSlice(&carriedBy), holder, accesses[access].span))
            }
          }
          if let Option<List<RelatedSite>>.Some {value: computed} = &entries {
            let sites = List<RelatedSite>.asSlice(&computed)
            let mut escape = usize.ZERO
            while escape < escapes.length {
              let mut site = usize.ZERO
              while site < sites.length {
                if !reportedEscape(List<EscapeReport>.asSlice(&reports), &summaries[reached].module, escapes[escape].span, &sites[site]) {
                  run List<EscapeReport>.append(&mut reports, EscapeReport {module: ModuleId.copy(&summaries[reached].module),
                    span: escapes[escape].span, relatedModule: ModuleId.copy(&sites[site].module), related: sites[site].span})
                  // A held access names the Effect run inside it; a readiness callback keeps its own wording.
                  let mut rejected = run makeRejection(RejectionCode.LocalSharedAccessEscape, &summaries[reached].module, escapes[escape].span)
                  rejected.related = Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&sites[site].module), span: sites[site].span})
                  let mut template: &[u8] = b"2"
                  if escapes[escape].kind == MirAccessEscape.Callback { template = b"1" }
                  run List<MessageArgument>.append(&mut rejected.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
                  run List<Shared<Rejection>>.append(&mut found, run Shared<Rejection>.make(move rejected))
                }
                site = site + usize.ONE
              }
              escape = escape + usize.ONE
            }
          }
          // A run's own calls are the escape already reported at the run, so they are not walked.
          if !List<bool>.get(&edgesKnown, reached) {
            let found = run summaryEdgesOf(summaries, &lookup, reached)
            let known = List<List<CallEdge>>.asMutSlice(&mut reachedEdges)
            known[reached] = move found
            List<bool>.set(&mut edgesKnown, reached, true)
          }
          let listed = List<List<CallEdge>>.asSlice(&reachedEdges)
          let next = List<CallEdge>.asSlice(&listed[reached])
          let mut edge = usize.ZERO
          while edge < next.length {
            let marks = List<usize>.asMutSlice(&mut queued)
            let span = List<Span>.get(&summaries[reached].calls, next[edge].call)
            if marks[next[edge].target] != walk && !runCall(escapes, span) {
              marks[next[edge].target] = walk
              run List<usize>.append(&mut queue, next[edge].target)
            }
            edge = edge + usize.ONE
          }
        }
      }
      access = access + usize.ONE
    }
    holder = holder + usize.ONE
  }
  return move found
}

// The closed suspendable set of one build, the recursive cycle each member belongs to, and the
// storage export symbols its frames use.
pub struct FrameSelection {
  // Each member's definition digest, which every region pattern of its application shares, so a
  // replay selects from a build record's entries what the walk selected from keys.
  pub suspendable: List<ContentHash>,
  /// Per member, its strongly connected component in the suspendable call graph: two members
  /// share one exactly when each can call the other.
  pub components: List<usize>,
  pub lookup: InternIndex,
  pub symbols: List<Bytes>,
  // Per member, the MIR outside any frame of a body a suspendable caller may run in its own frame
  // at a suspension point, or `usize.MAX`.
  pub bodies: List<usize>,
  // The definition digest of each instance the walk that selected the frames found able to park
  // externally (`closeParking`).
  pub parking: DigestSet,
  // The definition digest of each instance that walk summarized.
  pub reached: DigestSet,
}

impl FrameSelection {
  pub fn make() -> FrameSelection {
    return FrameSelection {suspendable: List<ContentHash>.make(), components: List<usize>.make(), lookup: InternIndex.make(),
      symbols: List<Bytes>.make(), bodies: List<usize>.make(), parking: DigestSet.make(), reached: DigestSet.make()}
  }

  // Adds the member whose definition digest is `definition`.
  pub effect fn include(self: &mut Self, definition: ContentHash, component: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<ContentHash>.append(&mut self.suspendable, definition)
    run List<usize>.append(&mut self.components, component)
    run List<usize>.append(&mut self.bodies, usize.MAX)
    run InternIndex.record(&mut self.lookup, digestHash(definition))
  }

  // Binds the next operation in create, acquire, release, destroy order.
  pub effect fn bind(self: &mut Self, symbol: Bytes) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<Bytes>.append(&mut self.symbols, move symbol)
  }

  pub effect fn contains(self: &Self, key: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
    let entry = run FrameSelection.position(self, key)
    return entry != usize.MAX
  }

  // The suspendable entry that is `key`'s backend instance, or `usize.MAX`.
  pub effect fn position(self: &Self, key: &InstanceKey) -> usize ! OutOfMemoryError ? &mut Allocator {
    let definition = run definitionDigest(key)
    let listed = List<ContentHash>.asSlice(&self.suspendable)
    let mut at = InternIndex.first(&self.lookup, digestHash(definition))
    while at != usize.MAX {
      if ContentHash.equals(listed[at], definition) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  // The emission facts of one suspendable instance: its suspendable callees in discovery order,
  // which can call back into it, eligible forwarding bodies, and the storage symbols.
  pub effect fn facts(self: &Self, function: &MirFunction, functions: &[MirFunction]) -> CoroutineFacts ! OutOfMemoryError ? &mut Allocator {
    let mut callees = List<InstanceKey>.make()
    let mut cyclic = List<bool>.make()
    let components = List<usize>.asSlice(&self.components)
    let own = run FrameSelection.position(self, &function.key)
    let blocks = List<MirBlock>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
        let entry = run FrameSelection.position(self, &key)
        if entry != usize.MAX {
          let listed = List<InstanceKey>.asSlice(&callees)
          let mut seen = false
          let mut prior = usize.ZERO
          while prior < listed.length && !seen {
            seen = run InstanceKey.sameInstance(&listed[prior], &key)
            prior = prior + usize.ONE
          }
          if !seen {
            run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&key))
            run List<bool>.append(&mut cyclic, own != usize.MAX && components[own] == components[entry])
          }
        }
      }
      at = at + usize.ONE
    }
    let mut inline = List<InstanceKey>.make()
    // Discover only forwarding bodies reachable through other forwarding bodies. The candidate
    // graph excludes every recursive SCC, so each splice strictly advances through that graph.
    let mut expandedBlocks = usize.ZERO
    let mut next = usize.ZERO
    while next < List<InstanceKey>.length(&callees) {
      let target = InstanceKey.copy(&List<InstanceKey>.asSlice(&callees)[next])
      let entry = run FrameSelection.position(self, &target)
      let body = List<usize>.get(&self.bodies, entry)
      let allowed = !List<bool>.get(&cyclic, next) && body != usize.MAX &&
        List<u64>.length(&function.lines) == usize.ZERO
      next = next + usize.ONE
      if !allowed { continue }
      let nested = List<MirBlock>.asSlice(&functions[body].blocks)
      let mut recursive = false
      let mut block = usize.ZERO
      while block < nested.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &nested[block].terminator {
          let child = run FrameSelection.position(self, &key)
          if child != usize.MAX && components[entry] == components[child] { recursive = true }
        }
        block = block + usize.ONE
      }
      if recursive || expandedBlocks + nested.length > 256 { continue }
      expandedBlocks = expandedBlocks + nested.length
      run List<InstanceKey>.append(&mut inline, InstanceKey.copy(&target))
      block = usize.ZERO
      while block < nested.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &nested[block].terminator {
          let child = run FrameSelection.position(self, &key)
          if child != usize.MAX {
            let listed = List<InstanceKey>.asSlice(&callees)
            let mut prior = usize.ZERO
            let mut seen = false
            while prior < listed.length && !seen {
              seen = run InstanceKey.sameInstance(&listed[prior], &key)
              prior = prior + usize.ONE
            }
            if !seen {
              run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&key))
              run List<bool>.append(&mut cyclic, own != usize.MAX && components[own] == components[child])
            }
          }
        }
        block = block + usize.ONE
      }
    }
    let symbols = List<Bytes>.asSlice(&self.symbols)
    return CoroutineFacts {
      inline: move inline,
      callees: move callees,
      cyclic: move cyclic,
      create: run Bytes.copy(Bytes.asSlice(&symbols[usize.ZERO])),
      acquire: run Bytes.copy(Bytes.asSlice(&symbols[usize.ONE])),
      release: run Bytes.copy(Bytes.asSlice(&symbols[2])),
      destroy: run Bytes.copy(Bytes.asSlice(&symbols[3])),
    }
  }
}

// Whether a suspendable caller may run `function`, a suspendable instance's MIR outside any
// frame, in its own frame at a suspension point (`FrameSelection.bodies`).
pub fn frameForwards(resolver: &Resolver, function: &MirFunction) -> bool {
  return instanceInlining(resolver, &function.key) && !instanceLines(resolver, &function.key) && MirInline.eligible(function, resolver.direct)
}

// The roots of a frame walk: `roots`, then the four storage `exports`, whose symbols `selection`
// binds in their order.
pub effect fn frameRoots(selection: &mut FrameSelection, roots: &[BuildRoot], exports: &[StorageExport]) -> List<BuildRoot>
! OutOfMemoryError ? &mut Allocator {
  let mut extended = run List<BuildRoot>.makeWithCapacity(roots.length + exports.length)
  let mut at = usize.ZERO
  while at < roots.length {
    run List<BuildRoot>.append(&mut extended, BuildRoot {key: InstanceKey.copy(&roots[at].key), span: roots[at].span, retained: roots[at].retained})
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < exports.length {
    run FrameSelection.bind(&mut selection.*, run Bytes.copy(Bytes.asSlice(&exports[at].symbol)))
    run List<BuildRoot>.append(&mut extended, BuildRoot {key: InstanceKey.copy(&exports[at].key), span: exports[at].span, retained: false})
    at = at + usize.ONE
  }
  return move extended
}

// The digest of what the walk that selects a build's frames reads of `function`, the MIR outside
// any frame of suspendable `instance`: its references and its summary, which decide what that
// walk reaches and which instances it selects; whether a caller's frame may run its body
// (`forwards`); and the calls, size and line table `FrameSelection.facts` reads of it, for its own
// frame or a caller's. While it reads the same, the selection and every frame it names do.
pub effect fn selectingDigest(function: &MirFunction, instance: &InstanceKey, forwards: bool, entrySpan: Span) -> ContentHash
! OutOfMemoryError ? &mut Allocator {
  let owner = DeclarationId.copyShared(&InstanceKey.identity(instance))
  let module = DeclarationId.moduleId(&owner)
  let summary = run SuspensionSummary.make(function, instance, module, &Option<Anchor>.none(), module, entrySpan)
  let summarized = run summaryDigest(&summary, function.observes, true)
  let mut bytes = Bytes.make()
  run RuntimeEncoding.word(&mut bytes, summarized.high)
  run RuntimeEncoding.word(&mut bytes, summarized.low)
  run RuntimeEncoding.word(&mut bytes, presence(forwards))
  run RuntimeEncoding.word(&mut bytes, presence(List<u64>.length(&function.lines) == usize.ZERO))
  let references = List<MirReference>.asSlice(&function.references)
  run RuntimeEncoding.word(&mut bytes, usize.toU64(references.length))
  let mut at = usize.ZERO
  while at < references.length {
    let exact = run instanceDigest(&references[at].key)
    let edge = recordDigest(Bytes.asSlice(&run Edge.recordBytes(&references[at].edge, &owner)))
    run RuntimeEncoding.word(&mut bytes, exact.high)
    run RuntimeEncoding.word(&mut bytes, exact.low)
    run RuntimeEncoding.word(&mut bytes, edge.high)
    run RuntimeEncoding.word(&mut bytes, edge.low)
    at = at + usize.ONE
  }
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  run RuntimeEncoding.word(&mut bytes, usize.toU64(blocks.length))
  at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
      let called = run definitionDigest(&key)
      run RuntimeEncoding.word(&mut bytes, usize.toU64(at))
      run RuntimeEncoding.word(&mut bytes, called.high)
      run RuntimeEncoding.word(&mut bytes, called.low)
    }
    at = at + usize.ONE
  }
  return ContentHash.of(Bytes.asSlice(&bytes))
}

// One selected storage operation's export root and its symbol.
pub struct StorageExport {
  pub key: InstanceKey,
  pub symbol: Bytes,
  /// The export's declaration in the storage source.
  pub span: Span,
}

// The exports of the four storage operations in create, acquire, release, destroy order, stopping
// at the first binding that names no active C export.
pub effect fn storageExports(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, storage: &ExecutionStorage)
  -> List<StorageExport>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut found = List<StorageExport>.make()
  let created = run storageExport(&mut resolver.*, &mut query.*, &storage.create)
  if let Option<StorageExport>.Some {value} = move created { run List<StorageExport>.append(&mut found, move value) }
  else { return move found }
  let acquired = run storageExport(&mut resolver.*, &mut query.*, &storage.acquire)
  if let Option<StorageExport>.Some {value} = move acquired { run List<StorageExport>.append(&mut found, move value) }
  else { return move found }
  let released = run storageExport(&mut resolver.*, &mut query.*, &storage.release)
  if let Option<StorageExport>.Some {value} = move released { run List<StorageExport>.append(&mut found, move value) }
  else { return move found }
  let destroyed = run storageExport(&mut resolver.*, &mut query.*, &storage.destroy)
  if let Option<StorageExport>.Some {value} = move destroyed { run List<StorageExport>.append(&mut found, move value) }
  return move found
}

// Finds the active C export a storage binding names, without recognizing its module or name.
effect fn storageExport(resolver: &mut Resolver, query: &mut Query<Answer, NoRejection>, binding: &StorageBinding)
  -> Option<StorageExport>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let exported = run exportCandidates(&mut resolver.*, &binding.module)
  let listed = match move exported {
    Option<List<ExportCandidate>>.Some {value} => move value
    Option<List<ExportCandidate>>.None => { return Option<StorageExport>.none() }
  }
  let candidates = List<ExportCandidate>.asSlice(&listed)
  let mut conditions = List<Dependency>.make()
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = &candidates[at]
    at = at + usize.ONE
    if !same(Bytes.asSlice(&candidate.name), Bytes.asSlice(&binding.declaration)) { continue }
    let active = run available(&mut resolver.*, &mut query.*, &mut conditions, &binding.module, candidate.declaration, candidate.span)
    let present = match move active {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {..} => false
    }
    if !present { continue }
    let declared = run declarationAt(&mut resolver.*, &binding.module, candidate.declaration)
    if let Option<DeclarationId>.Some {value} = move declared {
      let function = run Types.internDeclaration(move value)
      let symbol = run Shared<Bytes>.make(run Bytes.copy(Bytes.asSlice(&candidate.symbol)))
      return Option<StorageExport>.some(StorageExport {
        key: InstanceKey.Export {function: move function, symbol: move symbol},
        symbol: run Bytes.copy(Bytes.asSlice(&candidate.symbol)),
        span: candidate.span,
      })
    }
  }
  return Option<StorageExport>.none()
}

// One module-level C export a runtime source declares, before its arms are evaluated.
pub struct ExportCandidate {
  pub declaration: usize,
  pub name: Bytes,
  pub symbol: Bytes,
  pub span: Span,
}

// Lists every module-level `export "C" fn` of one source, or absence when the source is missing.
pub effect fn exportCandidates(resolver: &mut Resolver, module: &ModuleId) -> Option<List<ExportCandidate>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  // An export is a foreign claim, so a claim-free module has none and its source stays unread.
  let ordinal = run internModule(&mut resolver.*, module)
  if ordinal < List<bool>.length(&resolver.claimFree) && List<bool>.get(&resolver.claimFree, ordinal) {
    return Option<List<ExportCandidate>>.some(List<ExportCandidate>.make())
  }
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut found = List<ExportCandidate>.make()
    let mut at = usize.ZERO
    while at < declarations.length {
      let topLevel = match &declarations[at].parent {
        Option<usize>.None => true
        Option<usize>.Some {..} => false
      }
      if topLevel {
        if let Node.FunctionHeader {name, linkage, ..} = Module.node(hir, declarations[at].header) {
          if linkage.present {
            if let Node.Linkage {direction, symbol, ..} = Module.node(hir, linkage.id) {
              // A generic export publishes no symbol and roots nothing: an address taken at an
              // instantiation reaches that instantiation's thunk.
              if direction == LinkageDirection.Export && !genericExportHeader(hir, declarations[at].header) {
                let mut written = Bytes.make()
                if let Node.Name {text} = Module.node(hir, name) { written = run Bytes.copy(Module.text(hir, text)) }
                let mut linked = run Bytes.copy(Bytes.asSlice(&written))
                if symbol.present {
                  if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { linked = run Bytes.copy(Module.text(hir, text)) }
                }
                run List<ExportCandidate>.append(&mut found, ExportCandidate {
                  declaration: at, name: move written, symbol: move linked, span: Module.span(hir, declarations[at].header),
                })
              }
            }
          }
        }
      }
      at = at + usize.ONE
    }
    return Option<List<ExportCandidate>>.some(move found)
  }
  return Option<List<ExportCandidate>>.none()
}

// One authored native symbol claim: a linked C function or object, imported or exported (FFI-005).
pub struct ForeignClaim {
  pub module: usize,
  pub declaration: usize,
  pub symbol: Bytes,
  /// The written symbol literal, or the declaration's name when the symbol is implied.
  pub span: Span,
  pub header: Span,
  pub exported: bool,
  pub global: bool,
  /// Whether the declaration is a generic export, which claims no symbol: each instantiation's
  /// thunk has a private symbol derived from it. Its C signature is still classified as written.
  pub generic: bool,
  /// Whether the module's syntax is damaged, so recovery may have invented this spelling.
  pub damaged: bool,
}

// The C object an exported static defines, and the import declaration that binds to it.
pub struct ExportedObject {
  pub symbol: Bytes,
  pub definition: Bytes,
  pub external: Bytes,
}

effect fn appendForeignClaim(found: &mut List<ForeignClaim>, hir: &Module, module: usize, declaration: usize,
  owner: HirId, header: Span, name: HirId, clause: HirId, global: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  if let Node.Linkage {direction, symbol, ..} = Module.node(hir, clause) {
    let mut spelled = Bytes.make()
    let mut span = Module.span(hir, name)
    if let Node.Name {text} = Module.node(hir, name) { spelled = run Bytes.copy(Module.text(hir, text)) }
    let mut damaged = Module.causeRange(hir, owner).length > usize.ZERO || Module.causeRange(hir, name).length > usize.ZERO
      || Module.causeRange(hir, clause).length > usize.ZERO
    if symbol.present {
      if Module.causeRange(hir, symbol.id).length > usize.ZERO { damaged = true }
      if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) {
        spelled = run Bytes.copy(Module.text(hir, text))
        span = Module.span(hir, symbol.id)
      }
    }
    // A declaration name is never empty unless recovery stood in for a missing one.
    if !symbol.present && Bytes.asSlice(&spelled).length == usize.ZERO { damaged = true }
    // A function import's `"module#"` imports its own name, so it claims the pair it fills in.
    let split = wasmPairSplit(Bytes.asSlice(&spelled))
    if !global && direction == LinkageDirection.Import && split != usize.MAX && split + usize.ONE == Bytes.length(&spelled) {
      if let Node.Name {text} = Module.node(hir, name) { run Bytes.append(&mut spelled, Module.text(hir, text)) }
    }
    run List<ForeignClaim>.append(&mut found.*, ForeignClaim {
      module: module, declaration: declaration, symbol: move spelled, span: span, header: header,
      exported: direction == LinkageDirection.Export, global: global, generic: !global && genericExportHeader(hir, owner),
      damaged: damaged,
    })
  }
  return ()
}

// Lists every linked function and static one module declares, in declaration order, including
// those inside `static if` arms.
pub effect fn foreignClaims(resolver: &mut Resolver, moduleOrdinal: usize) -> List<ForeignClaim>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut found = List<ForeignClaim>.make()
  if moduleOrdinal < List<bool>.length(&resolver.claimFree) && List<bool>.get(&resolver.claimFree, moduleOrdinal) { return move found }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let answer = run source(&mut resolver.*, &module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    let mut at = usize.ZERO
    while at < declarations.length {
      let header = Module.span(hir, declarations[at].header)
      let written = Module.node(hir, declarations[at].header)
      if let Node.FunctionHeader {name, linkage, ..} = written {
        if linkage.present { run appendForeignClaim(&mut found, hir, moduleOrdinal, at, declarations[at].header, header, name, linkage.id, false) }
      } else if let Node.StaticHeader {name, linkage, ..} = written {
        run appendForeignClaim(&mut found, hir, moduleOrdinal, at, declarations[at].header, header, name, linkage, true)
      }
      at = at + usize.ONE
    }
  }
  return move found
}

pub effect fn appendDistinctModule(modules: &mut List<ModuleId>, module: &ModuleId) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<ModuleId>.asSlice(&modules.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if ModuleId.equals(&listed[at], module) { return () }
    at = at + usize.ONE
  }
  run List<ModuleId>.append(&mut modules.*, ModuleId.copy(module))
  return ()
}

// Whether `ordinal` is one of `modules`.
pub fn listedOrdinal(modules: &[usize], ordinal: usize) -> bool {
  let mut at = usize.ZERO
  while at < modules.length {
    if modules[at] == ordinal { return true }
    at = at + usize.ONE
  }
  return false
}

// Whether one of the first `count` claims names `symbol`.
pub fn claimsSymbol(claims: &[ForeignClaim], count: usize, symbol: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < count && at < claims.length {
    if same(Bytes.asSlice(&claims[at].symbol), symbol) { return true }
    at = at + usize.ONE
  }
  return false
}

pub fn libraryPath(path: &[u8]) -> bool {
  let prefix = b"silk/"
  if path.length <= prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if path[at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether a runtime is selected to supply the process entry.
pub fn hostedStart(runtime: &Option<ModuleId>) -> bool {
  if let Option<ModuleId>.Some {..} = &runtime.* { return true }
  return false
}

// Whether `module` owns the compiler's runtime and entry symbols: the selected runtime, or a
// standard-library module that defines the entry, raw start or execution-storage hooks.
pub fn runtimeOwned(module: &ModuleId, runtime: &Option<ModuleId>) -> bool {
  if let Option<ModuleId>.Some {value} = &runtime.* {
    if ModuleId.equals(&value, module) { return true }
  }
  return ModuleId.withPath<bool>(module, libraryPath)
}

// The C scalar of one statically evaluated exported-object initializer.
pub fn objectConstant(value: &StaticData) -> Option<ObjectConstant> {
  return match &value.* {
    StaticData.Integer {sign, magnitude, ..} => Option<ObjectConstant>.some(
      ObjectConstant.Integer {negative: sign == StaticSign.Negative, magnitude: magnitude})
    StaticData.Float {ty, bits} => Option<ObjectConstant>.some(
      ObjectConstant.Float {bits: bits, single: ty == StaticFloatType.F32})
    _ => Option<ObjectConstant>.none()
  }
}

// The value an exported static's initializer evaluates to at its declared C object type.
pub effect fn exportedStaticValue(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  moduleOrdinal: usize,
  ordinal: usize,
  span: Span,
) -> Result<Interned<StaticData>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let declared = run declaredStaticType(&mut resolver.*, &mut owner.*, &mut dependencies.*, moduleOrdinal, ordinal, span)
  let ty = match move declared {
    Result<Interned<Type>, Shared<Rejection>>.Success {value} => move value
    Result<Interned<Type>, Shared<Rejection>>.Failure {error} => {
      return Result<Interned<StaticData>, Shared<Rejection>>.failResult(move error)
    }
  }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let written = run initializerSyntax(&mut resolver.*, &module, ordinal, span)
  let initializerSpan = written.span
  let expression = match move written.expression {
    Option<HirId>.Some {value} => value
    Option<HirId>.None => {
      return Result<Interned<StaticData>, Shared<Rejection>>.failResult(
        run constantRejection(&module, initializerSpan, b"an exported static requires an initializer"))
    }
  }
  let detail = run constantValueDetail(&module, &ty)
  let evaluated = run staticExpression(
    &mut resolver.*, &mut owner.*, &mut dependencies.*,
    &module, Option<usize>.some(ordinal), expression,
    StaticRootExpectation.Resolved {ty: move ty, mismatchCode: RejectionCode.InvalidConstant},
    &[], &[],
  )
  let value = match move evaluated {
    Result<Interned<StaticData>, Shared<Rejection>>.Success {value} => move value
    Result<Interned<StaticData>, Shared<Rejection>>.Failure {error} => {
      return Result<Interned<StaticData>, Shared<Rejection>>.failResult(run detailedConstantRejection(move error, Bytes.asSlice(&detail)))
    }
  }
  // The C object is emitted as one integer or float constant (`rootObjects`).
  let constant = Interned<StaticData>.with<Option<ObjectConstant>>(&value, objectConstant)
  if let Option<ObjectConstant>.None = &constant {
    return Result<Interned<StaticData>, Shared<Rejection>>.failResult(run constantRejection(&module, initializerSpan,
      b"an exported C static holds one integer or float constant; import a pointer from C instead"))
  }
  return Result<Interned<StaticData>, Shared<Rejection>>.succeed(move value)
}

// The C parameter and result types one foreign function or object claims: an object's value type,
// or a function's result followed by its parameters, with `variadic` set for a C variadic tail. Absent
// when its signature is itself rejected.
effect fn claimShape(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, claim: &ForeignClaim,
  variadic: &mut bool) -> Option<List<Interned<Type>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut shape = List<Interned<Type>>.make()
  let mut dependencies = List<Dependency>.make()
  if claim.global {
    let declared = run declaredStaticType(&mut resolver.*, &mut owner.*, &mut dependencies, claim.module, claim.declaration, claim.header)
    if let Result<Interned<Type>, Shared<Rejection>>.Success {value} = move declared {
      run List<Interned<Type>>.append(&mut shape, move value)
      return Option<List<Interned<Type>>>.some(move shape)
    }
    return Option<List<Interned<Type>>>.none()
  }
  let request = Key {family: Family.Signature, module: claim.module, name: usize.ZERO, declaration: claim.declaration,
    member: usize.ZERO, external: false}
  let key = run internDeclaration(&mut resolver.*, request)
  let signature = run demandRaw(&mut resolver.*, &mut owner.*, key, claim.header)
  let facts = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts)
  let summary = match move facts {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return Option<List<Interned<Type>>>.none() }
  }
  // A variadic import never shares its symbol with a fixed export; the caller compares this.
  variadic.* = summary.isVariadic
  run List<Interned<Type>>.append(&mut shape, Interned<Type>.clone(&summary.result))
  let mut at = usize.ZERO
  while at < summary.parameters {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameterAt(answer, at) })
    match move parameter {
      Option<Interned<Type>>.Some {value} => { run List<Interned<Type>>.append(&mut shape, move value) }
      Option<Interned<Type>>.None => { return Option<List<Interned<Type>>>.none() }
    }
    at = at + usize.ONE
  }
  return Option<List<Interned<Type>>>.some(move shape)
}

// Whether a definition and another active claim of its native symbol may coexist: only an import
// may share a symbol with a definition, and then only as the same kind of claim with the
// definition's C types. A C static's declared type must match exactly; a function's C types are
// compared as the declarations emission prints (`Semantic.definitionConflict`), as two imports
// are (`Semantic.importConflict`). A claim whose own types are rejected is reported there.
pub effect fn claimsAgree(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, first: &ForeignClaim,
  second: &ForeignClaim) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if same(MachineTarget.objectFormat(&resolver.target), b"wasm") {
    let leftModule = resolvedModule(&resolver.*, first.module)
    let rightModule = resolvedModule(&resolver.*, second.module)
    let leftHeader = run foreignHeader(&mut resolver.*, &leftModule, first.declaration)
    let rightHeader = run foreignHeader(&mut resolver.*, &rightModule, second.declaration)
    if !same(Bytes.asSlice(&leftHeader.importModule), Bytes.asSlice(&rightHeader.importModule)) ||
      !same(Bytes.asSlice(&leftHeader.importName), Bytes.asSlice(&rightHeader.importName)) { return false }
  }
  if first.exported && second.exported { return false }
  if first.global != second.global { return false }
  let mut firstVariadic = false
  let mut secondVariadic = false
  let left = match move run claimShape(&mut resolver.*, &mut owner.*, first, &mut firstVariadic) {
    Option<List<Interned<Type>>>.Some {value} => move value
    Option<List<Interned<Type>>>.None => { return true }
  }
  let right = match move run claimShape(&mut resolver.*, &mut owner.*, second, &mut secondVariadic) {
    Option<List<Interned<Type>>>.Some {value} => move value
    Option<List<Interned<Type>>>.None => { return true }
  }
  if firstVariadic != secondVariadic { return false }
  // A function's C types are compared as emission prints them (`definitionConflict`); a C static's
  // declared type must match exactly.
  if !first.global { return true }
  let lefts = List<Interned<Type>>.asSlice(&left)
  let rights = List<Interned<Type>>.asSlice(&right)
  if lefts.length != rights.length { return false }
  let mut at = usize.ZERO
  while at < lefts.length {
    if !run Type.equalsShared(&lefts[at], &rights[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

pub struct BackendRequest {
  pub key: InstanceKey,
  pub edge: Edge,
  pub span: Span,
  pub module: ModuleId,
  pub cleanup: Option<Interned<Type>>,
  pub requester: Option<RelatedSite>,
}

// The requester of the instances a body of `module` reaches when `entered` at `span` of
// `enteredModule`: the first authored call outside the toolchain that led into the toolchain or
// into another package, inherited through every body of the toolchain or of a package other than
// the requester's, and none for a body of the requester's own package, whose own references are
// the requests. A `compileError` that a library selects for its caller's static arguments, several
// library calls deep, is then reported at the caller's call.
pub fn successorRequester(requester: &Option<RelatedSite>, enteredModule: &ModuleId, span: Span, module: &ModuleId)
-> Option<RelatedSite> {
  if let Option<RelatedSite>.Some {value} = &requester.* {
    if toolchainModule(module) || !ModuleId.samePackage(&value.module, module) {
      return Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&value.module), span: value.span})
    }
    return Option<RelatedSite>.none()
  }
  if toolchainModule(enteredModule) || span.end == usize.ZERO { return Option<RelatedSite>.none() }
  if !toolchainModule(module) && ModuleId.samePackage(enteredModule, module) { return Option<RelatedSite>.none() }
  return Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(enteredModule), span: span})
}

// The authored site a refusal in an entered instance's body is located at: its requester when
// one led into the toolchain, otherwise the request itself.
pub fn requestSite(requester: &Option<RelatedSite>, enteredModule: &ModuleId, span: Span) -> RelatedSite {
  if let Option<RelatedSite>.Some {value} = &requester.* {
    return RelatedSite {module: ModuleId.copy(&value.module), span: value.span}
  }
  return RelatedSite {module: ModuleId.copy(enteredModule), span: span}
}

// One demand-local finite-closure transaction rooted at a changing-static edge. It follows every
// lowered successor of every reached node, applies the non-static growth guard from the build's
// own ancestors, and certifies only a complete closed node set. Per-node answers are ordinary
// cached queries and never authorize closure on their own.
pub effect<'owner & 'env> fn closeChain<'owner, 'env>(semantic: &'owner mut Semantic, ancestors: &'env Admission, root: &'env Application, incoming: ClosureIncoming, limit: usize) -> StaticClosure
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let rootKey = match move run InstanceKey.function(run Application.copy(root)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {..} => {
      return StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
        &incoming.module, RejectionCode.Undetermined, incoming.span)}
    }
  }
  let mut pending = List<ClosureVisit>.make()
  run List<ClosureVisit>.append(&mut pending, ClosureVisit.Enter {
    key: move rootKey, from: usize.MAX, edge: Edge.copy(&incoming.edge), module: ModuleId.copy(&incoming.module), span: incoming.span,
  })
  let ancestorPath = run Admission.path(ancestors)
  let draft = ClosureDraft {
    pending: move pending,
    nodes: List<Application>.make(),
    edges: List<ClosureEdge>.make(),
    admission: run Admission.copy(ancestors),
  }
  // Semantic stays outside the resource: the transaction owns only its drafts.
  let use = effect |resource: &mut ClosureDraft| -> StaticClosure
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
    return run walkChain(&mut semantic.*, &mut resource.*, limit, &incoming, List<Application>.asSlice(&ancestorPath))
  }
  // Drafts never outlive the transaction: success copies the evidence out first.
  let release = effect |resource: &mut ClosureDraft| -> () {
    List<ClosureVisit>.clear(&mut resource.pending)
    List<Application>.clear(&mut resource.nodes)
    List<ClosureEdge>.clear(&mut resource.edges)
    return ()
  }
  return run Effect.useReleaseNonParking(move draft, move use, move release)
}

effect fn copyClosureIncoming(incoming: &ClosureIncoming) -> ClosureIncoming ! OutOfMemoryError ? &mut Allocator {
  let mut caller = Option<Application>.none()
  if let Option<Application>.Some {value} = &incoming.caller { caller = Option<Application>.some(run Application.copy(&value)) }
  return ClosureIncoming {caller: move caller, edge: Edge.copy(&incoming.edge), module: ModuleId.copy(&incoming.module), span: incoming.span}
}

effect fn closureGap(code: GapCode, application: &Application, span: Span) -> StaticClosure ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let identity = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(application)))
  let mut gaps = List<Shared<BackendGap>>.make()
  run List<Shared<BackendGap>>.append(&mut gaps, run Shared<BackendGap>.make(BackendGap.make(code, &identity, span)))
  return StaticClosure.Unsupported {gaps: move gaps}
}

// Admits one reached node of a closure transaction: the growth guard, deduplication, the node
// budget, and its complete lowered successors. A returned outcome ends the transaction.
effect fn enterChainNode(semantic: &mut Semantic, draft: &mut ClosureDraft, key: InstanceKey, from: usize, edge: Edge, module: ModuleId, span: Span, incoming: &ClosureIncoming, limit: usize) -> Option<StaticClosure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // Drop glue carries no static arguments, so it never extends a changing-static chain; the build
  // worklist reaches it and the hooks it calls.
  if let Option<Interned<Type>>.Some {..} = move InstanceKey.glueType(&key) { return Option<StaticClosure>.none() }
  let application = run InstanceKey.selected(&key)
  let root = RelatedSite {module: ModuleId.copy(&incoming.module), span: incoming.span}
  let refused = run Admission.enter(&mut draft.admission, &application, Edge.copy(&edge))
  let decision = run admitOwnedDescent(&mut semantic.*.resolver, &mut semantic.*.query, &mut draft.admission, &application, &edge, move refused)
  let mut leave = false
  match move decision {
    Decision.Entered => { leave = true }
    Decision.ChangingStatic {..} => {
      run Admission.enterChain(&mut draft.admission, &application, Edge.copy(&edge))
      leave = true
    }
    Decision.Reused {..} => {}
    Decision.Open => { return Option<StaticClosure>.some(run closureGap(GapCode.OpenInstance, &application, span)) }
    Decision.Rejected {path} => {
      return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: run rejectSpecialization(&mut semantic.*.resolver, span, Option<RelatedSite>.some(move root), move path)})
    }
  }
  let known = List<Application>.asSlice(&draft.nodes)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < known.length {
    if run Application.equals(&known[at], &application) {
      found = at
      break
    }
    at = at + usize.ONE
  }
  if found != usize.MAX {
    if from != usize.MAX {
      run List<ClosureEdge>.append(&mut draft.edges, ClosureEdge {from: from, to: found, edge: Edge.copy(&edge), module: ModuleId.copy(&module), span: span})
    }
    if leave { Admission.leave(&mut draft.admission) }
    return Option<StaticClosure>.none()
  }
  if List<Application>.length(&draft.nodes) >= limit {
    let mut path = run Admission.path(&draft.admission)
    if !leave { run List<Application>.append(&mut path, run Application.copy(&application)) }
    return Option<StaticClosure>.some(StaticClosure.NotProven {diagnostic: run rejectNotProven(&module, span, Option<RelatedSite>.some(move root), move path, limit)})
  }
  let node = List<Application>.length(&draft.nodes)
  run List<Application>.append(&mut draft.nodes, run Application.copy(&application))
  if from != usize.MAX {
    run List<ClosureEdge>.append(&mut draft.edges, ClosureEdge {from: from, to: node, edge: Edge.copy(&edge), module: ModuleId.copy(&module), span: span})
  }
  let located = run locationOfInstance(&mut semantic.resolver, &key)
  let location = match move located {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option<StaticClosure>.some(run closureGap(GapCode.CalleeModule, &application, span)) }
  }
  let backendName = run internBackendInstance(&mut semantic.resolver, &key, false)
  let declarationAccess277Request = Key {
    family: Family.EmissionInputs, module: location.module, name: backendName, declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess277 = run internDeclaration(&mut semantic.resolver, declarationAccess277Request)
  let instanceAnswer = run demandRaw(&mut semantic.resolver, &mut semantic.query, declarationAccess277, Span.make(usize.ZERO, usize.ZERO))
  let instanceCanonicalFailure = Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(&instanceAnswer, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {..} = move instanceCanonicalFailure {
    return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
      &module, RejectionCode.Undetermined, span)})
  }
  let instanceRejection = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&instanceAnswer, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move instanceRejection { return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: move value}) }
  let instanceGap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&instanceAnswer, answerBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move instanceGap {
    let mut gaps = List<Shared<BackendGap>>.make()
    run List<Shared<BackendGap>>.append(&mut gaps, move value)
    return Option<StaticClosure>.some(StaticClosure.Unsupported {gaps: move gaps})
  }
  let declarationAccess278Request = Key {
    family: Family.Mir, module: location.module, name: backendName, declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess278 = run internDeclaration(&mut semantic.resolver, declarationAccess278Request)
  let mir = run demandRaw(&mut semantic.resolver, &mut semantic.query, declarationAccess278, Span.make(usize.ZERO, usize.ZERO))
  let canonicalFailure = Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(&mir, answerCanonicalizationFailure)
  if let Option<CanonicalizationFailure>.Some {..} = move canonicalFailure {
    return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: run reject(&semantic.resolver,
      &module, RejectionCode.Undetermined, span)})
  }
  let mirRejection = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&mir, answerCause)
  if let Option<Shared<Rejection>>.Some {value} = move mirRejection { return Option<StaticClosure>.some(StaticClosure.Rejected {diagnostic: move value}) }
  let mirGap = Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&mir, answerBackendGap)
  if let Option<Shared<BackendGap>>.Some {value} = move mirGap {
    let mut gaps = List<Shared<BackendGap>>.make()
    run List<Shared<BackendGap>>.append(&mut gaps, move value)
    return Option<StaticClosure>.some(StaticClosure.Unsupported {gaps: move gaps})
  }
  let mirIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, answerMirIndex)
  let lowered = match move mirIndex {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<StaticClosure>.some(run closureGap(GapCode.TypedForm, &application, span)) }
  }
  if leave { run List<ClosureVisit>.append(&mut draft.pending, ClosureVisit.Leave) }
  let callerModule = resolvedModule(&semantic.resolver, location.module)
  let anchor = run instanceAnchor(&mut semantic.resolver, &key)
  let functions = List<MirFunction>.asSlice(&semantic.resolver.mirValues)
  let references = List<MirReference>.asSlice(&functions[lowered].references)
  let mut reference = usize.ZERO
  while reference < references.length {
    run List<ClosureVisit>.append(&mut draft.pending, ClosureVisit.Enter {
      key: InstanceKey.copy(&references[reference].key), from: node, edge: Edge.copy(&references[reference].edge),
      module: ModuleId.copy(&callerModule), span: anchoredSpan(&anchor, references[reference].origin),
    })
    reference = reference + usize.ONE
  }
  return Option<StaticClosure>.none()
}

effect fn walkChain(semantic: &mut Semantic, draft: &mut ClosureDraft, limit: usize, incoming: &ClosureIncoming, ancestors: &[Application]) -> StaticClosure
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  while List<ClosureVisit>.length(&draft.pending) > usize.ZERO {
    let last = List<ClosureVisit>.length(&draft.pending) - usize.ONE
    let visit = List<ClosureVisit>.remove(&mut draft.pending, last)
    match move visit {
      ClosureVisit.Leave => { Admission.leave(&mut draft.admission) }
      ClosureVisit.Enter {key, from, edge, module, span} => {
        let outcome = run enterChainNode(&mut semantic.*, &mut draft.*, move key, from, move edge, move module, span, incoming, limit)
        if let Option<StaticClosure>.Some {value} = move outcome { return move value }
      }
    }
  }
  let mut nodes = List<Application>.make()
  let listed = List<Application>.asSlice(&draft.nodes)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Application>.append(&mut nodes, run Application.copy(&listed[at]))
    at = at + usize.ONE
  }
  let mut edges = List<ClosureEdge>.make()
  let recorded = List<ClosureEdge>.asSlice(&draft.edges)
  at = usize.ZERO
  while at < recorded.length {
    run List<ClosureEdge>.append(&mut edges, ClosureEdge {
      from: recorded[at].from, to: recorded[at].to, edge: Edge.copy(&recorded[at].edge), module: ModuleId.copy(&recorded[at].module), span: recorded[at].span,
    })
    at = at + usize.ONE
  }
  let mut path = run List<Application>.makeWithCapacity(ancestors.length)
  at = usize.ZERO
  while at < ancestors.length {
    run List<Application>.append(&mut path, run Application.copy(&ancestors[at]))
    at = at + usize.ONE
  }
  return StaticClosure.Certified {evidence: FiniteClosureEvidence {
    incoming: run copyClosureIncoming(incoming), ancestors: move path, nodes: move nodes, edges: move edges,
  }}
}

// A closure that the node budget ended before it closed (SEM0053): the pending path, the budget
// reached, and the module and span of the changing-static edge that opened the transaction. The
// message names the call cycle, the functions from the last one's previous occurrence on the path.
effect fn rejectNotProven(module: &ModuleId, span: Span, related: Option<RelatedSite>, path: List<Application>, limit: usize) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
  let applications = List<Application>.asSlice(&path)
  let mut first = usize.ZERO
  if applications.length > usize.ONE {
    let last = Application.bodyDeclaration(&applications[applications.length - usize.ONE])
    let mut at = applications.length - usize.ONE
    while at > usize.ZERO {
      at = at - usize.ONE
      if DeclarationId.equals(Application.bodyDeclaration(&applications[at]), last) {
        first = at
        break
      }
    }
  }
  let mut cycle = Bytes.make()
  let mut at = first
  while at < applications.length {
    if at != first { run Bytes.append(&mut cycle, b" -> ") }
    let name = run DeclarationId.copySpelling(Application.bodyDeclaration(&applications[at]))
    run Bytes.append(&mut cycle, b"`")
    run Bytes.append(&mut cycle, Bytes.asSlice(&name))
    run Bytes.append(&mut cycle, b"`")
    at = at + usize.ONE
  }
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"cycle"), value: move cycle})
  let mut budget = run decimalText(limit)
  run Bytes.append(&mut budget, b" specializations")
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"limit"), value: move budget})
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.StaticRecursionNotProven,
      module: ModuleId.copy(module),
      span: span,
      related: move related,
      path: List<Interned<DeclarationId>>.make(),
      expected: limit,
      supplied: limit,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: move path,
      arguments: move arguments, owner: usize.MAX,
    },
  )
}

// The whole authored declaration `declaration` names, or none for a declaration without one.
effect fn declarationSite(resolver: &mut Resolver, declaration: &DeclarationId) -> Option<Span>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let module = DeclarationId.moduleId(declaration)
  let answer = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let index = IndexedSource.moduleIndex(value)
    if let Option<usize>.Some {value: ordinal} = move ModuleIndex.ordinalOf(index, declaration) {
      let local = ModuleIndex.listDeclarations(index)[ordinal].local
      return Option<Span>.some(Module.span(IndexedSource.authored(value), local))
    }
  }
  return Option<Span>.none()
}

// Reflecting the fields of a type that is not a struct or tuple, or, when `variants`, the variants
// of a type that is not a union (SEM0176): names the type, its kind, and the reflection that fits.
pub effect fn reflectionOwnerRejection(site: &ModuleId, span: Span, ty: &Interned<Type>, variants: bool) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut diagnostic = run makeRejection(RejectionCode.StaticPhaseViolation, site, span)
  let shown = match move run TypeText.display(ty, site) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return run Shared<Rejection>.make(move diagnostic) }
  }
  let kind = Interned<Type>.with<OwnerKind>(ty, |value: &Type| -> OwnerKind {
    if let Type.Nominal {declaration, ..} = &value.* { return DeclarationId.kind(&declaration) }
    return OwnerKind.Damaged
  })
  let mut form = run Bytes.copy(if variants { b"the variants of `" } else { b"the fields of `" })
  run Bytes.append(&mut form, Bytes.asSlice(&shown))
  run Bytes.append(&mut form, match kind {
    OwnerKind.Struct => b"`, a struct"
    OwnerKind.Tuple => b"`, a tuple"
    OwnerKind.Union => b"`, a union"
    OwnerKind.Enumeration => b"`, an enum"
    _ => b"`"
  })
  let guard: &[u8] = b"guard the loop with a `static if` on `Reflect.typeKind`, since an ordinary `if` does not stop a `static for` from expanding"
  let mut fix = run Bytes.copy(if variants { b"`Reflect.variants` lists the variants of a union; " } else {
    b"`Reflect.fields` lists the fields of a struct or tuple; " })
  if !variants && kind == OwnerKind.Union {
    run Bytes.append(&mut fix, b"list a union's variants with `Reflect.variants` and each variant's fields with `Reflect.variantFields`, or ")
  }
  run Bytes.append(&mut fix, guard)
  run vectorArgument(&mut diagnostic, b"template", b"7")
  run vectorArgument(&mut diagnostic, b"form", Bytes.asSlice(&form))
  run vectorArgument(&mut diagnostic, b"fix", Bytes.asSlice(&fix))
  return run Shared<Rejection>.make(move diagnostic)
}

// The most types one owned-structure search visits. A resource control, not a proof: owned
// structure is finite, and a search that reaches this many types admits nothing.
const ownedStructureTypes: usize = 256

// A recursive call that `Admission.enter` refused is still admitted when every type argument it
// moves lies within the owned structure of the nearest active application of its function, and
// no active frame already has its type arguments (GEN-006). Owned structure is finite and the path
// never repeats a type shape, so the path stays finite.
pub effect fn admitOwnedDescent(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, admission: &mut Admission,
  application: &Application, edge: &Edge, decision: Decision) -> Decision
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut admitted = false
  if let Decision.Rejected {path} = &decision {
    let listed = List<Application>.asSlice(&path)
    let bound = run boundSlots(&mut resolver.*, &mut owner.*, Application.bodyDeclaration(application))
    if let Option<OwnedDescent>.Some {value: descent} = move run Admission.ownedSteps(&listed[usize.ZERO], application, List<BoundSlot>.asSlice(&bound)) {
      admitted = !run Admission.activeUpToStatics(&admission.*, application, List<usize>.asSlice(&descent.fixed))
      if admitted { admitted = run movesDescend(&mut resolver.*, &mut owner.*, List<OwnedMove>.asSlice(&descent.moves), usize.ZERO) }
    }
  }
  if !admitted { return move decision }
  run Admission.enterChain(&mut admission.*, application, Edge.copy(edge))
  return Decision.Entered
}

// How deeply exact callable representations nest within each other's applications before a
// descent through them stops being proved.
const callableDescentDepth: usize = 8

// Whether each moved argument lies within the owned structure of the ancestor's: part by part
// inside a type constructor both share, or as a whole. An exact callable representation, such as
// the Effect value of `fieldRead<R, Owner, V>(...)` that `Effect.result` receives, is fixed by the
// function application it holds, so it descends when that application descends.
effect fn movesDescend(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, moved: &[OwnedMove], depth: usize) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < moved.length {
    let parts = List<OwnedStep>.asSlice(&moved[at].parts)
    let mut within = true
    let mut part = usize.ZERO
    while within && part < parts.length {
      within = run withinOwned(&mut resolver.*, &mut owner.*, &parts[part].outer, &parts[part].inner)
      part = part + usize.ONE
    }
    if !within { within = run withinOwned(&mut resolver.*, &mut owner.*, &moved[at].outer, &moved[at].inner) }
    if !within && depth < callableDescentDepth {
      within = run callableDescends(&mut resolver.*, &mut owner.*, &moved[at].outer, &moved[at].inner, depth)
    }
    if !within { return false }
    at = at + usize.ONE
  }
  return true
}

// Whether `inner`, an exact callable representation, holds an application of the same function
// as `outer`'s that is an owned descent of it.
effect fn callableDescends(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, outer: &Interned<Type>, inner: &Interned<Type>,
  depth: usize) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let older = match &outer.get().* {
    Type.CallableValue {application, ..} => Interned<Application>.clone(&application)
    _ => { return false }
  }
  let newer = match &inner.get().* {
    Type.CallableValue {application, ..} => Interned<Application>.clone(&application)
    _ => { return false }
  }
  if !DeclarationId.equals(Application.bodyDeclaration(older.get()), Application.bodyDeclaration(newer.get())) { return false }
  let bound = run boundSlots(&mut resolver.*, &mut owner.*, Application.bodyDeclaration(newer.get()))
  if let Option<OwnedDescent>.Some {value: descent} = move run Admission.ownedSteps(older.get(), newer.get(), List<BoundSlot>.asSlice(&bound)) {
    return run movesDescend(&mut resolver.*, &mut owner.*, List<OwnedMove>.asSlice(&descent.moves), depth + usize.ONE)
  }
  return false
}

// The type parameters of `declaration` that a conformance bound on another of its type parameters
// names, such as `M` in `B: Block<M>`, each with the parameter whose bound names it.
effect fn boundSlots(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, declaration: &DeclarationId) -> List<BoundSlot>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut slots = List<BoundSlot>.make()
  let key = match move run signatureKey(&mut resolver.*, declaration) {
    Option<Key>.Some {value} => value
    Option<Key>.None => { return move slots }
  }
  let signature = run demandRaw(&mut resolver.*, &mut owner.*, key, Span.make(usize.ZERO, usize.ZERO))
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  let mut at = usize.ZERO
  while at < count {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraintAt(answer, at) })
    if let Option<Constraint>.Some {value: Constraint.Conforms {provider, contract}} = move found {
      let by = Interned<Type>.with<usize>(&provider, |value: &Type| -> usize { return Type.parameterOrdinalOf(value, declaration) })
      if by != usize.MAX {
        let mut pending = List<Interned<Type>>.make()
        run Type.structuralChildren(&contract, &mut pending)
        run fixedSlots(&mut slots, move pending, declaration, by)
      }
    }
    at = at + usize.ONE
  }
  // A field descriptor `Intrinsic.Field<Owner, V>` names a field of `Owner`, so the argument for
  // `Owner` fixes `V` as a bound fixes the parameters its contract names.
  let parameters = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  at = usize.ZERO
  while at < parameters {
    let parameter = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameterAt(answer, at) })
    if let Option<Interned<Type>>.Some {value: ty} = move parameter {
      if let Option<CheckedIntrinsic.FieldTypes>.Some {value: described} = move Interned<Type>.with<Option<CheckedIntrinsic.FieldTypes>>(&ty, CheckedIntrinsic.fieldTypes) {
        let by = Interned<Type>.with<usize>(&described.owner, |value: &Type| -> usize { return Type.parameterOrdinalOf(value, declaration) })
        if by != usize.MAX {
          let mut pending = List<Interned<Type>>.make()
          run List<Interned<Type>>.append(&mut pending, Interned<Type>.clone(&described.value))
          run fixedSlots(&mut slots, move pending, declaration, by)
        }
      }
    }
    at = at + usize.ONE
  }
  return move slots
}

// Appends a slot fixed by the parameter `by` for each parameter of `declaration` that `pending`
// names, structurally.
effect fn fixedSlots(slots: &mut List<BoundSlot>, pending: List<Interned<Type>>, declaration: &DeclarationId, by: usize) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut pending = move pending
  while List<Interned<Type>>.length(&pending) != usize.ZERO {
    let part = match move List<Interned<Type>>.pop(&mut pending) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { break }
    }
    let ordinal = Interned<Type>.with<usize>(&part, |value: &Type| -> usize { return Type.parameterOrdinalOf(value, declaration) })
    if ordinal != usize.MAX && ordinal != by {
      run List<BoundSlot>.append(&mut slots.*, BoundSlot {ordinal: ordinal, by: by})
    }
    run Type.structuralChildren(&part, &mut pending)
  }
  return ()
}

// Whether `inner` lies within the owned structure of `outer`: a part of it, a member type of a
// struct, tuple or union it names, or, transitively, a part or member of one of those.
effect fn withinOwned(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, outer: &Interned<Type>, inner: &Interned<Type>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut seen = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut seen, Interned<Type>.clone(outer))
  let mut next = usize.ZERO
  while next < List<Interned<Type>>.length(&seen) && next < ownedStructureTypes {
    let current = Interned<Type>.clone(&List<Interned<Type>>.asSlice(&seen)[next])
    next = next + usize.ONE
    let mut parts = List<Interned<Type>>.make()
    run Type.structuralChildren(&current, &mut parts)
    run ownedMemberTypes(&mut resolver.*, &mut owner.*, &current, &mut parts)
    let found = List<Interned<Type>>.asSlice(&parts)
    let mut at = usize.ZERO
    while at < found.length {
      if run Type.runtimeEqualsShared(inner, &found[at]) { return true }
      let mut known = false
      let visited = List<Interned<Type>>.asSlice(&seen)
      let mut index = usize.ZERO
      while index < visited.length && !known {
        known = run Type.runtimeEqualsShared(&visited[index], &found[at])
        index = index + usize.ONE
      }
      if !known { run List<Interned<Type>>.append(&mut seen, Interned<Type>.clone(&found[at])) }
      at = at + usize.ONE
    }
  }
  return false
}

// Appends the member types of the nominal application `ty` to `types`: each field of a struct or
// tuple and each payload type of a union variant. Any other type has none.
effect fn ownedMemberTypes(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, ty: &Interned<Type>, types: &mut List<Interned<Type>>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, ty)
  if moduleOrdinal == usize.MAX { return () }
  let declaredModule = resolvedModule(&resolver.*, moduleOrdinal)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &declaredModule, ty) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return () }
  }
  let membersKey = run internDeclaration(&mut resolver.*, Key {
    family: Family.Members, module: moduleOrdinal, name: usize.ZERO, declaration: declaration, member: usize.ZERO, external: false,
  })
  let members = run demandRaw(&mut resolver.*, &mut owner.*, membersKey, Span.make(usize.ZERO, usize.ZERO))
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&members, declarationMemberCount)
  let application = run internApplication(&mut resolver.*, ty)
  let mut member = usize.ZERO
  while member < count {
    let shapeKey = run internDeclaration(&mut resolver.*, Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application, declaration: declaration, member: member, external: false,
    })
    let shape = run demandRaw(&mut resolver.*, &mut owner.*, shapeKey, Span.make(usize.ZERO, usize.ZERO))
    let length = Shared<Result<Answer, NoRejection>>.with<usize>(&shape, shapeLength)
    let mut at = usize.ZERO
    while length != usize.MAX && at < length {
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&shape,
        |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return shapeTypeAt(answer, at) })
      if let Option<Interned<Type>>.Some {value} = move selected { run List<Interned<Type>>.append(&mut types.*, move value) }
      at = at + usize.ONE
    }
    member = member + usize.ONE
  }
  return ()
}

// A recursive specialization whose arguments grow (SEM0053), reported at the whole declaration of
// the function whose call grows them: the last application on `path` before the growing one.
// `call` is the growing edge's site, reported only when that function has no authored declaration.
// `related` is the site of the changing-static edge whose closure transaction reached the growth.
pub effect fn rejectSpecialization(resolver: &mut Resolver, call: Span, related: Option<RelatedSite>, path: List<Application>) -> Shared<
  Rejection,
> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let applications = List<Application>.asSlice(&path)
  if applications.length < 2 { return CompilerBug.panic(b"a rejected specialization path names its growing call") }
  let caller = DeclarationId.copy(Application.bodyDeclaration(&applications[applications.length - 2]))
  let module = ModuleId.copy(DeclarationId.moduleId(&caller))
  let span = match move run declarationSite(&mut resolver.*, &caller) {
    Option<Span>.Some {value} => value
    Option<Span>.None => call
  }
  // The message names the earlier application of the growing function and the one it requests.
  let mut arguments = List<MessageArgument>.make()
  let target = &applications[applications.length - usize.ONE]
  let mut earlier = applications.length - usize.ONE
  while earlier > usize.ZERO {
    earlier = earlier - usize.ONE
    if DeclarationId.equals(Application.bodyDeclaration(&applications[earlier]), Application.bodyDeclaration(target)) { break }
  }
  let callerText = run applicationText(&applications[earlier], &module)
  let targetText = run applicationText(target, &module)
  if let Option<Bytes>.Some {value: shownCaller} = move callerText {
    if let Option<Bytes>.Some {value: shownTarget} = move targetText {
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"caller"), value: move shownCaller})
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"target"), value: move shownTarget})
    }
  }
  return run Shared<Rejection>.make(
    Rejection {
      code: RejectionCode.ExpandingSpecialization,
      module: move module,
      span: span,
      related: move related,
      path: List<Interned<DeclarationId>>.make(),
      expected: usize.ZERO,
      supplied: usize.ZERO,
      parameterName: Bytes.make(),
      expectedKind: GenericKind.Type,
      suppliedKind: GenericKind.Type,
      witness: Option<WitnessProblem>.none(),
      staticFailure: Option<StaticDiagnostic>.none(),
      specialization: move path,
      arguments: move arguments, owner: usize.MAX,
    },
  )
}

// `application` as `name<A, B>` in backticks, its type arguments spelled as `viewer` sees them;
// none when a type argument has no exact spelling.
effect fn applicationText(application: &Application, viewer: &ModuleId) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(b"`")
  let name = run DeclarationId.copySpelling(Application.bodyDeclaration(application))
  run Bytes.append(&mut text, Bytes.asSlice(&name))
  let arguments = List<Argument>.asSlice(&application.arguments)
  let mut first = true
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {value} = &arguments[at] {
      let shown = match move run TypeText.display(&value, viewer) {
        Option<Bytes>.Some {value: spelled} => move spelled
        Option<Bytes>.None => { return Option<Bytes>.none() }
      }
      run Bytes.append(&mut text, if first { b"<" } else { b", " })
      run Bytes.append(&mut text, Bytes.asSlice(&shown))
      first = false
    }
    at = at + usize.ONE
  }
  if !first { run Bytes.append(&mut text, b">") }
  run Bytes.append(&mut text, b"`")
  return Option<Bytes>.some(move text)
}

/// Whether a module whose syntax lowers to `hir`, indexed as `index`, declares a function with a
/// foreign linkage or a static: the headers a check of foreign symbols reads. Without one, the
/// module claims no symbol, and a loader that read its source can say so (`offerClaimFree`).
pub fn claimsForeignSymbols(hir: &Module, index: &ModuleIndex) -> bool {
  let declarations = ModuleIndex.listDeclarations(index)
  let mut at = usize.ZERO
  while at < declarations.length {
    let written = Module.node(hir, declarations[at].header)
    if let Node.FunctionHeader {linkage, ..} = written {
      if linkage.present { return true }
    } else if let Node.StaticHeader {..} = written {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// The syntax errors of every source this store has loaded, as rejections in load order and
/// then source order. A loaded module is parsed whole, so its syntax errors reject the program
/// even where no declaration of it is demanded (MODULE-004).
pub effect fn syntaxRejections(thisStore: &Semantic) -> List<Shared<Rejection>> ! OutOfMemoryError ? &mut Allocator {
  let problems = run SourceIndex.syntaxProblems(&thisStore.resolver.source)
  let listed = List<SyntaxProblem>.asSlice(&problems)
  let mut rejections = List<Shared<Rejection>>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Shared<Rejection>>.append(&mut rejections, run syntaxRejection(&listed[at].module, listed[at].code, listed[at].span, listed[at].detail,
      List<Bytes>.asSlice(&listed[at].holes)))
    at = at + usize.ONE
  }
  return move rejections
}

// `checkDeclarations`, or with `instances` false `checkWrittenDeclarations`.
pub effect fn checkModules(
  thisStore: &mut Semantic,
  request: &mut Request,
  rootPackage: &[ModuleId],
  runtime: &Option<ModuleId>,
  instances: bool,
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let _traced = Trace.span("check")
  run selectRequest(&mut thisStore.resolver, &request.*)
  thisStore.deferredTemplates = List<DeferredStaticTemplate>.make()
  thisStore.runtimeRefused = List<Shared<Rejection>>.make()
  thisStore.uncheckedRoot = List<UncheckedBody>.make()
  let mut modules = List<usize>.make()
  let mut rootAt = usize.ZERO
  while rootAt < rootPackage.length {
    run appendCheckedModule(&mut modules, run internModule(&mut thisStore.resolver, &rootPackage[rootAt]))
    rootAt = rootAt + usize.ONE
  }
  if Graph.recording(&thisStore.resolver.graph) {
    return run checkEachModule(&mut thisStore.*, &mut request.*, List<usize>.asSlice(&modules), runtime, instances)
  }
  let mut sweep = Sweep.make()
  let mut moduleAt = usize.ZERO
  while moduleAt < List<usize>.length(&modules) {
    let moduleOrdinal = List<usize>.get(&modules, moduleAt)
    let module = resolvedModule(&thisStore.resolver, moduleOrdinal)
    moduleAt = moduleAt + usize.ONE
    run showProgress(&mut thisStore.*, &module)
    run sweepModule(&mut thisStore.*, &mut request.*, &module, moduleOrdinal, &Option<DeclarationId>.none(), &mut sweep)
  }
  // The sweep's closing work is no one module's or package's.
  run Progress.endItem(&mut thisStore.resolver.progress)
  return run finishSweep(&mut thisStore.*, &mut request.*, List<usize>.asSlice(&modules), runtime, move sweep, instances)
}

/// Checks the declarations of the selected `runtime` module alone, as `silk check` runs it to
/// report what the runtime refuses of the application's `main`: a missing, private or ill-shaped
/// `main` is refused where the runtime's own bodies name and start it. Nothing is walked from
/// those bodies here. `checkDeclarations` walks from the runtime's roots into the runtime, the
/// toolchain bodies that start `main`, the entry module and instances with static arguments,
/// and keeps what that walk refuses inside the runtime as `runtimeRefusals`, so this check's
/// cost does not grow with what an open `main` reaches.
pub effect fn checkRuntime(thisStore: &mut Semantic, request: &mut Request, runtime: &ModuleId)
-> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let clock = run Progress.enterQuery(&mut thisStore.resolver.progress, u8.toUsize(Family.value(Family.CleanupFree)) + 3, "RuntimeCheck")
  let traced = run Tracing.enterQuery(u8.toUsize(Family.value(Family.CleanupFree)) + 3, "RuntimeCheck", usize.MAX)
  let attempted = run Effect.result(checkRuntimeTimed(&mut thisStore.*, &mut request.*, runtime))
  Tracing.leaveQuery(traced)
  run Progress.leaveQuery(&mut thisStore.resolver.progress, clock)
  return match move attempted {
    Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
  }
}

pub effect fn checkRuntimeTimed(thisStore: &mut Semantic, request: &mut Request, runtime: &ModuleId)
-> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let selected = Option<ModuleId>.some(ModuleId.copy(runtime))
  run selectRequest(&mut thisStore.resolver, &request.*)
  thisStore.deferredTemplates = List<DeferredStaticTemplate>.make()
  thisStore.uncheckedRoot = List<UncheckedBody>.make()
  let ordinal = run internModule(&mut thisStore.resolver, runtime)
  run showProgress(&mut thisStore.*, runtime)
  let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()}
  if Graph.recording(&thisStore.resolver.graph) {
    let found = run keptSweep(&mut thisStore.*, &mut request.*, runtime, ordinal)
    let mut concrete = List<DeclarationId>.make()
    let memos = List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos)
    run mergeSweep(&mut result, &mut concrete, &memos[found].sweep)
  } else {
    let mut sweep = Sweep.make()
    run sweepModule(&mut thisStore.*, &mut request.*, runtime, ordinal, &Option<DeclarationId>.none(), &mut sweep)
    result.rejections = move sweep.rejections
    result.gaps = move sweep.gaps
    result.unchecked = move sweep.unchecked
  }
  run Progress.endItem(&mut thisStore.resolver.progress)
  let mut claims = List<Shared<Rejection>>.make()
  run checkForeignClaims(&mut thisStore.*, &[ordinal], &selected, &mut claims)
  run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&claims))
  return move result
}

// A revisable store's `checkDeclarations`: each module's kept sweep, which an unaffected module
// only verifies, then the foreign symbol claims of every module and the kept escape check of
// every concrete body. It reports the same rejections as one sweep of every module.
pub effect fn checkEachModule(thisStore: &mut Semantic, request: &mut Request, modules: &[usize], runtime: &Option<ModuleId>, instances: bool)
-> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()}
  let mut deferred = List<DeferredStaticTemplate>.make()
  let mut uncheckedBodies = List<UncheckedBody>.make()
  let mut at = usize.ZERO
  while at < modules.length {
    let module = resolvedModule(&thisStore.resolver, modules[at])
    run showProgress(&mut thisStore.*, &module)
    let found = run keptSweep(&mut thisStore.*, &mut request.*, &module, modules[at])
    at = at + usize.ONE
    let memos = List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos)
    let mut concrete = List<DeclarationId>.make()
    run mergeSweep(&mut result, &mut concrete, &memos[found].sweep)
    run appendDeferred(&mut deferred, List<DeferredStaticTemplate>.asSlice(&memos[found].deferred))
    run appendUnchecked(&mut uncheckedBodies, List<UncheckedBody>.asSlice(&memos[found].unchecked))
    if instances {
      // Each module keeps the escapes of its own bodies, so an edit reruns its module's walk alone.
      let escapes = run keptEscapes(&mut thisStore.*, &mut request.*, modules[at - usize.ONE], modules, List<DeclarationId>.asSlice(&concrete), false)
      run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&escapes.rejections))
      run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
    }
  }
  // The runtime's walk is the runtime module's time; the claims of every module are no one module's.
  run Progress.endItem(&mut thisStore.resolver.progress)
  let mut entries = List<DeclarationId>.make()
  if instances { entries = run runtimeRoots(&mut thisStore.*, runtime, modules) }
  if List<DeclarationId>.length(&entries) > usize.ZERO {
    if let Option<ModuleId>.Some {value: selected} = &runtime.* {
      run sharePackage(&mut thisStore.*, &selected, false)
      if Progress.timing(&thisStore.resolver.progress) {
        let shown = run ModuleId.copyPath(&selected)
        run Progress.timeItem(&mut thisStore.resolver.progress, Bytes.asSlice(&shown))
      }
      let runtimeOrdinal = run internModule(&mut thisStore.resolver, &selected)
      let escapes = run keptEscapes(&mut thisStore.*, &mut request.*, runtimeOrdinal, modules, List<DeclarationId>.asSlice(&entries), true)
      run splitRuntimeRejections(&mut result.rejections, &mut thisStore.runtimeRefused, List<Shared<Rejection>>.asSlice(&escapes.rejections), runtime)
      run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
      run Progress.endItem(&mut thisStore.resolver.progress)
    }
  }
  let mut conflicts = List<Shared<Rejection>>.make()
  run checkForeignClaims(&mut thisStore.*, modules, runtime, &mut conflicts)
  run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&conflicts))
  thisStore.deferredTemplates = move deferred
  thisStore.uncheckedRoot = move uncheckedBodies
  return move result
}

// The bound of a walk from the runtime's roots, as `keptEscapes` sets it for the runtime module.
pub effect fn runtimeBoundary(thisStore: &mut Semantic, runtime: &Option<ModuleId>) -> Option<WalkBoundary> ! OutOfMemoryError ? &mut Allocator {
  let own = match &runtime.* {
    Option<ModuleId>.Some {value} => ModuleId.copy(&value)
    Option<ModuleId>.None => { return Option<WalkBoundary>.none() }
  }
  let mut package = ModuleId.copy(&own)
  run recordApplicationRead(&mut thisStore.resolver, &own)
  if thisStore.resolver.currentApplication != usize.MAX { package = resolvedModule(&thisStore.resolver, thisStore.resolver.currentApplication) }
  return Option<WalkBoundary>.some(WalkBoundary {package: move package, own: move own, checked: List<ModuleId>.make(),
    lookup: InternIndex.make(), staticsOnly: true})
}

// The C exports of the selected runtime, which a build walks the program from, unless the
// runtime is itself a checked module. An effect `main` that requires a provider is open, so no
// concrete body of the package reaches it; walking these roots too, bounded to the entry module
// and instances with static arguments (`WalkBoundary.staticsOnly`), reaches a library body that
// a static argument of `main` selects, and `silk check` reports what `silk build` would.
pub effect fn runtimeRoots(thisStore: &mut Semantic, runtime: &Option<ModuleId>, modules: &[usize]) -> List<DeclarationId>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut roots = List<DeclarationId>.make()
  let selected = match &runtime.* {
    Option<ModuleId>.Some {value} => ModuleId.copy(&value)
    Option<ModuleId>.None => { return move roots }
  }
  let ordinal = run internModule(&mut thisStore.resolver, &selected)
  let mut at = usize.ZERO
  while at < modules.length {
    if modules[at] == ordinal { return move roots }
    at = at + usize.ONE
  }
  let listed = match move run exportCandidates(&mut thisStore.resolver, &selected) {
    Option<List<ExportCandidate>>.Some {value} => move value
    Option<List<ExportCandidate>>.None => { return move roots }
  }
  let mut conditions = List<Dependency>.make()
  let candidates = List<ExportCandidate>.asSlice(&listed)
  at = usize.ZERO
  while at < candidates.length {
    let candidate = &candidates[at]
    at = at + usize.ONE
    let active = run available(&mut thisStore.resolver, &mut thisStore.query, &mut conditions, &selected, candidate.declaration, candidate.span)
    let present = match &active {
      Result<bool, Shared<Rejection>>.Success {value} => value
      Result<bool, Shared<Rejection>>.Failure {..} => false
    }
    if !present { continue }
    if let Option<DeclarationId>.Some {value} = move run declarationAt(&mut thisStore.resolver, &selected, candidate.declaration) {
      run List<DeclarationId>.append(&mut roots, move value)
    }
  }
  return move roots
}

/// The rejections `checkDeclarations` would report from one escape walk over every concrete body
/// of `rootPackage`, instead of each module's own walk, which stops at the plain bodies of the
/// package's other modules. `silk check --roots` compares the two; nothing is kept.
pub effect fn wholePackageCheck(
  thisStore: &mut Semantic,
  request: &mut Request,
  rootPackage: &[ModuleId],
  runtime: &Option<ModuleId>,
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let mut modules = List<usize>.make()
  let mut rootAt = usize.ZERO
  while rootAt < rootPackage.length {
    run appendCheckedModule(&mut modules, run internModule(&mut thisStore.resolver, &rootPackage[rootAt]))
    rootAt = rootAt + usize.ONE
  }
  if !Graph.recording(&thisStore.resolver.graph) {
    return run Semantic.checkDeclarations(&mut thisStore.*, &mut request.*, rootPackage, runtime)
  }
  let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()}
  let mut concrete = List<DeclarationId>.make()
  let listed = List<usize>.asSlice(&modules)
  let mut at = usize.ZERO
  while at < listed.length {
    let module = resolvedModule(&thisStore.resolver, listed[at])
    let found = run keptSweep(&mut thisStore.*, &mut request.*, &module, listed[at])
    let memos = List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos)
    run mergeSweep(&mut result, &mut concrete, &memos[found].sweep)
    at = at + usize.ONE
  }
  let mut conflicts = List<Shared<Rejection>>.make()
  run checkForeignClaims(&mut thisStore.*, listed, runtime, &mut conflicts)
  run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&conflicts))
  let escapes = run declarationEscapes(&mut thisStore.*, &mut request.*, List<DeclarationId>.asSlice(&concrete),
    &Option<WalkBoundary>.none())
  run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&escapes.rejections))
  run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
  return move result
}

/// Checks one module of the root package as `checkDeclarations` checks each of its modules: its
/// name collisions, each active declaration as `checkDeclaration` does, its foreign symbol
/// claims and the escapes of its concrete bodies. Over a package's modules, these results and
/// `checkForeignConflicts` hold exactly the rejections `checkDeclarations` reports, so an edit
/// to one module refreshes that module's entry alone.
///
/// Like `checkDeclarations`, it replaces `deferredStaticTemplates` and `uncheckedRootBodies`
/// with what this check found.
pub effect fn checkModule(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  runtime: &Option<ModuleId>,
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let _traced = Trace.span("check")
  run selectRequest(&mut thisStore.resolver, &request.*)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  if !Graph.recording(&thisStore.resolver.graph) {
    thisStore.deferredTemplates = List<DeferredStaticTemplate>.make()
    thisStore.uncheckedRoot = List<UncheckedBody>.make()
    let mut sweep = Sweep.make()
    run sweepModule(&mut thisStore.*, &mut request.*, module, moduleOrdinal, &Option<DeclarationId>.none(), &mut sweep)
    return run finishSweep(&mut thisStore.*, &mut request.*, &[moduleOrdinal], runtime, move sweep, true)
  }
  // A revisable store keeps the sweep and the escape check as units, verified when unaffected.
  let found = run keptSweep(&mut thisStore.*, &mut request.*, module, moduleOrdinal)
  let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()}
  let mut concrete = List<DeclarationId>.make()
  let memos = List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos)
  run mergeSweep(&mut result, &mut concrete, &memos[found].sweep)
  thisStore.deferredTemplates = run copyDeferred(List<DeferredStaticTemplate>.asSlice(&memos[found].deferred))
  thisStore.uncheckedRoot = run copyUnchecked(List<UncheckedBody>.asSlice(&memos[found].unchecked))
  let mut claims = List<Shared<Rejection>>.make()
  run checkForeignClaims(&mut thisStore.*, &[moduleOrdinal], runtime, &mut claims)
  run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&claims))
  let escapes = run keptEscapes(&mut thisStore.*, &mut request.*, moduleOrdinal, &[], List<DeclarationId>.asSlice(&concrete), false)
  run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&escapes.rejections))
  run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&escapes.gaps))
  return move result
}

// The memo of `module`'s sweep, run again unless its unit is current or verifies. Its root
// demands and source reads are recorded against its unit.
@trace(name: "check.module")
pub effect fn keptSweep(thisStore: &mut Semantic, request: &mut Request, module: &ModuleId, moduleOrdinal: usize) -> usize
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  run traceModule(module)
  let word = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: usize.ZERO,
    declaration: usize.MAX, member: usize.ZERO, external: false})
  let unit = u64.toUsize(word.value)
  let found = memoOf(List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos), unit)
  if found != usize.MAX {
    if run unitCurrent(&mut thisStore.*, unit) { return found }
    drop List<ModuleCheckMemo>.remove(&mut thisStore.moduleMemos, found)
    uncarry(&mut thisStore.carriedUnits, &mut thisStore.carriedRoots, unit)
  }
  run Graph.startRun(&mut thisStore.resolver.graph, unit)
  thisStore.resolver.runs = thisStore.resolver.runs + usize.ONE
  thisStore.checkRuns = thisStore.checkRuns + usize.ONE
  thisStore.resolver.rootRecorder = unit
  let attempted = run Effect.result(sweepOnly(&mut thisStore.*, &mut request.*, module, moduleOrdinal))
  thisStore.resolver.rootRecorder = usize.MAX
  // A failed sweep keeps no memo, so the next check sweeps again whatever its unit's edges say.
  let sweep = match move attempted {
    Result<Sweep, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Sweep, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
  }
  drop run Graph.finishRun(&mut thisStore.resolver.graph, unit, Option<ContentHash>.none())
  run List<ModuleCheckMemo>.append(&mut thisStore.moduleMemos, ModuleCheckMemo {unit: unit, sweep: move sweep,
    deferred: run copyDeferred(List<DeferredStaticTemplate>.asSlice(&thisStore.deferredTemplates)),
    unchecked: run copyUnchecked(List<UncheckedBody>.asSlice(&thisStore.uncheckedRoot))})
  return List<ModuleCheckMemo>.length(&thisStore.moduleMemos) - usize.ONE
}

pub effect fn sweepOnly(thisStore: &mut Semantic, request: &mut Request, module: &ModuleId, moduleOrdinal: usize) -> Sweep
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  thisStore.deferredTemplates = List<DeferredStaticTemplate>.make()
  thisStore.uncheckedRoot = List<UncheckedBody>.make()
  let mut sweep = Sweep.make()
  run sweepModule(&mut thisStore.*, &mut request.*, module, moduleOrdinal, &Option<DeclarationId>.none(), &mut sweep)
  return move sweep
}

// Whether this store holds the source of the module the adopted record `record` names.
pub effect fn recordLoaded(thisStore: &Semantic, record: &EscapeRecordRoot) -> bool ! OutOfMemoryError ? &mut Allocator {
  let adopted = match &thisStore.heldImage {
    Option<CacheImage.Image>.Some {value} => &value
    Option<CacheImage.Image>.None => { return true }
  }
  let roots = List<CacheImage.Root>.asSlice(&adopted.roots)
  let key = StableKey.view(Bytes.asSlice(&roots[record.root].key), record.unit)
  let mut reader = StableKey.reader()
  drop StableKey.readWord(key, &mut reader)
  drop StableKey.readWord(key, &mut reader)
  return match move run StableKey.readModule(key, &mut reader) {
    Option<ModuleId>.Some {value} => SourceIndex.presents(&thisStore.resolver.source, &value)
    Option<ModuleId>.None => true
  }
}

// The escapes of `concrete`, the concrete bodies of `module`, kept for its check. They run again
// when the bodies differ or the unit neither is current nor verifies. The walk leaves the plain
// bodies of the other modules `checked` lists, and of the application's package, to their own
// checks (`WalkBoundary`), so it rests on this module's bodies and what they instantiate, not
// on the whole program. Its key names the `checked` modules, since a module that leaves them is
// walked here again.
pub effect fn keptEscapes(thisStore: &mut Semantic, request: &mut Request, module: usize, checked: &[usize], concrete: &[DeclarationId], staticsOnly: bool)
-> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let own = resolvedModule(&thisStore.resolver, module)
  // The application's own modules are always left to their own checks, and so are the checked
  // modules of other packages. A walk that leaves every checked module to its own check needs
  // no application: its own package's modules are checked too.
  let mut package = ModuleId.copy(&own)
  if staticsOnly || checked.length == usize.ZERO {
    run recordApplicationRead(&mut thisStore.resolver, &own)
    if thisStore.resolver.currentApplication != usize.MAX { package = resolvedModule(&thisStore.resolver, thisStore.resolver.currentApplication) }
  }
  let mut others = List<ModuleId>.make()
  let mut lookup = InternIndex.make()
  let mut at = usize.ZERO
  while at < checked.length {
    let listed = resolvedModule(&thisStore.resolver, checked[at])
    at = at + usize.ONE
    if ModuleId.samePackage(&listed, &package) { continue }
    run InternIndex.record(&mut lookup, ModuleId.hash(&listed))
    run List<ModuleId>.append(&mut others, move listed)
  }
  // A check sweeps every module of every package it loads, and a walk reaches only modules its
  // own module imports, directly or not, so whether a module the walk reaches is checked does
  // not depend on which package roots the build. The unit therefore names only whether the walk
  // leaves checked modules to their own checks, and a dependency's walk is the same unit in
  // every package that depends on it, which a cache image written for one serves to the others.
  // A walk of statics only, as the runtime's from its roots, is another check of the same
  // module than its whole walk, so it keeps a unit of its own: sharing one, each would find the
  // other's memo and record, and replay or walk again on every check.
  let mut member = usize.ZERO
  if staticsOnly { member = 2 }
  else if checked.length > usize.ZERO { member = usize.ONE }
  let word = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: module, name: usize.ONE,
    declaration: usize.MAX, member: member, external: false})
  let unit = u64.toUsize(word.value)
  let boundary = Option<WalkBoundary>.some(WalkBoundary {package: move package, own: move own, checked: move others,
    lookup: move lookup, staticsOnly: staticsOnly})
  let needsDiscovery = concrete.length > usize.ZERO && needsCheckDiscovery(&thisStore.resolver, module)
  let found = escapeMemoOf(List<EscapeMemo>.asSlice(&thisStore.escapeMemos), unit)
  // The record of this check's last walk in this process, which an edit since may leave true.
  let mut previous = Option<CapturedBuild>.none()
  let mut discovery = usize.MAX
  let mut savedScope = usize.MAX
  if found != usize.MAX {
    let memos = List<EscapeMemo>.asSlice(&thisStore.escapeMemos)
    let proof = memos[found].discovery
    let sameRoots = sameDeclarations(List<DeclarationId>.asSlice(&memos[found].concrete), concrete)
    let proven = sameRoots && (!needsDiscovery || (proof != usize.MAX && run unitCurrent(&mut thisStore.*, proof)))
    if proven && run unitCurrent(&mut thisStore.*, unit) {
      let kept = List<EscapeMemo>.asSlice(&thisStore.escapeMemos)
      return run copyCheckResult(&kept[found].result)
    }
    if proven && needsDiscovery { discovery = proof savedScope = checkScopeOf(&thisStore.resolver, proof) }
    let EscapeMemo {unit: _, discovery: _, concrete: _, result: _, captured: last, reads: _} = List<EscapeMemo>.remove(&mut thisStore.escapeMemos, found)
    previous = move last
    uncarry(&mut thisStore.carriedUnits, &mut thisStore.carriedRoots, unit)
  }
  if savedScope != usize.MAX {
    thisStore.resolver.activeCheckScope = savedScope
    thisStore.resolver.checkingMembers = List<CheckedDispatch>.length(&List<CheckScope>.asSlice(&thisStore.resolver.checkScopes)[savedScope].dispatchers) != usize.ZERO
    thisStore.resolver.closedErasures = true
  } else if needsDiscovery {
    let proof = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: module, name: 8,
      declaration: usize.MAX, member: member, external: false})
    discovery = u64.toUsize(proof.value)
    run Graph.startObservation(&mut thisStore.resolver.graph, discovery)
    let recorder = thisStore.resolver.rootRecorder
    // Immutable disk-cache stores check the closure once. Only a revisable store needs
    // evidence to verify that successful proof after a later source edit.
    thisStore.resolver.rootRecorder = if thisStore.resolver.revisable { discovery } else { usize.MAX }
    thisStore.resolver.recordingDiscovery = thisStore.resolver.revisable
    let attempted = run Effect.result(closeCheckErasures(&mut thisStore.*, &mut request.*, concrete, staticsOnly))
    thisStore.resolver.recordingDiscovery = false
    thisStore.resolver.rootRecorder = recorder
    drop run Graph.finishRun(&mut thisStore.resolver.graph, discovery, Option<ContentHash>.none())
    let closed = match move attempted {
      Result<Option<DeclarationCheckResult>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<Option<DeclarationCheckResult>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
    }
    if let Option<DeclarationCheckResult>.Some {value} = move closed { return move value }
    if thisStore.resolver.revisable { run retainCheckScope(&mut thisStore.resolver, discovery) }
  }
  // The walk an adopted image recorded for this check is replayed when it still describes the
  // check; a walk run here replaces it either way.
  let mut adopted = Option<EscapeRecordRoot>.none()
  let mut sibling = usize.MAX
  if let Option<Bytes>.Some {value: stable} = move run stableUnit(&thisStore.resolver, unit) {
    adopted = EscapeImage.take(&mut thisStore.escapeImage, &thisStore.heldImage, Bytes.asSlice(&stable))
    // A check the image holds no record for, as a program's first, starts from the record a
    // sibling program's walk of its own module left: the entries that walk lowered are green
    // here too, so only what this one reaches and that one did not is lowered.
    if found == usize.MAX {
      if let Option<EscapeRecordRoot>.None = &adopted {
        let named = resolvedModule(&thisStore.resolver, module)
        sibling = run siblingRecord(&thisStore.resolver, &thisStore.escapeImage, &thisStore.heldImage, Bytes.asSlice(&stable), &named)
      }
    }
  }
  if sibling != usize.MAX {
    let recorded = run adoptedAnswer(&thisStore.heldImage, sibling)
    let replayed = run replayKept(&mut thisStore.*, &mut request.*, module, member, unit, discovery, concrete, &boundary,
      Bytes.asSlice(&recorded), sibling, &[], usize.MAX, false, true)
    if let Option<DeclarationCheckResult>.Some {value: result} = move replayed { return move result }
  }
  let mut kept = Option<EscapeRecordRoot>.none()
  if let Option<EscapeRecordRoot>.Some {value: held} = move adopted {
    let recorded = run adoptedAnswer(&thisStore.heldImage, held.root)
    let replayed = run replayKept(&mut thisStore.*, &mut request.*, module, member, unit, discovery, concrete, &boundary,
      Bytes.asSlice(&recorded), held.root, &[], usize.MAX, false, false)
    if let Option<DeclarationCheckResult>.Some {value: result} = move replayed { return move result }
    kept = Option<EscapeRecordRoot>.some(move held)
  } else if let Option<CapturedBuild>.Some {value: last} = move previous {
    // In one process, as the language server's, the last walk's own record is replayed as an
    // adopted one is, while the reads of its growth guards hold: an entry is green when its MIR
    // unit is current.
    if last.guard == usize.MAX || run unitCurrent(&mut thisStore.*, last.guard) {
      let recorded = run BuildRecord.encode(&last.record)
      let replayed = run replayKept(&mut thisStore.*, &mut request.*, module, member, unit, discovery, concrete, &boundary,
        Bytes.asSlice(&recorded), last.carriedRecord, List<CapturedEntry>.asSlice(&last.entries), last.guard, true, false)
      if let Option<DeclarationCheckResult>.Some {value: result} = move replayed { return move result }
    }
  }
  run Graph.startRun(&mut thisStore.resolver.graph, unit)
  thisStore.resolver.runs = thisStore.resolver.runs + usize.ONE
  thisStore.checkRuns = thisStore.checkRuns + usize.ONE
  // The walk's growth guards and static closures read what no MIR reference shows; those reads
  // go to a guard unit, which the check and its record rest on.
  let mut guard = usize.MAX
  if Graph.recording(&thisStore.resolver.graph) {
    let guardWord = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: module, name: 4,
      declaration: usize.MAX, member: member, external: false})
    guard = u64.toUsize(guardWord.value)
    run Graph.startRun(&mut thisStore.resolver.graph, guard)
  }
  thisStore.resolver.rootRecorder = unit
  let mut capture = BuildCapture.walk()
  let attempted = run Effect.result(capturedEscapes(&mut thisStore.*, &mut request.*, concrete, &boundary, &mut capture, guard))
  thisStore.resolver.rootRecorder = usize.MAX
  let result = match move attempted {
    Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
  }
  let mut captured = Option<CapturedBuild>.none()
  if guard != usize.MAX {
    drop run Graph.finishRun(&mut thisStore.resolver.graph, guard, Option<ContentHash>.none())
    run Graph.record(&mut thisStore.resolver.graph, unit, Dependee.UnitResult {unit: guard})
    // What a body that lowers to nothing reports, a replay of the record reports again.
    if !capture.unreplayable && List<UncheckedDeclaration>.length(&result.unchecked) == usize.ZERO {
      let mut resting = usize.MAX
      if capture.guarded { resting = guard }
      captured = run BuildCapture.finish(move capture, resting)
    }
  }
  drop run Graph.finishRun(&mut thisStore.resolver.graph, unit, Option<ContentHash>.none())
  // A walk that records nothing, as one that reports does, leaves the adopted record to the next
  // check, which replays it once the walk is back to what the record describes, as after a fix.
  if let Option<CapturedBuild>.None = &captured {
    if let Option<EscapeRecordRoot>.Some {value: held} = move kept {
      run List<EscapeRecordRoot>.append(&mut thisStore.escapeImage.records, move held)
    }
  }
  run List<EscapeMemo>.append(&mut thisStore.escapeMemos, EscapeMemo {unit: unit, discovery: discovery, concrete: run copyDeclarations(concrete),
    result: run copyCheckResult(&result), captured: move captured, reads: usize.MAX})
  return move result
}

// Replays the escape walk record `recorded` for the check `unit` of `module` (`replayEscapes`),
// or walks it again from the record (`rewalkEscapes`) within `boundary`, and keeps what it found
// as the check's memo; none when neither can tell what the walk finds.
pub effect fn replayKept(thisStore: &mut Semantic, request: &mut Request, module: usize, member: usize, unit: usize, discovery: usize, concrete: &[DeclarationId],
  boundary: &Option<WalkBoundary>, recorded: &[u8], recordRoot: usize, previous: &[CapturedEntry], guard: usize, inProcess: bool, rewalkOnly: bool)
  -> Option<DeclarationCheckResult>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  // What the replay demands goes to a unit of its own: the units that decide what a replay
  // that reports finds besides the record's entries, as a broken body's MIR.
  let readsWord = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: module, name: 7,
    declaration: usize.MAX, member: member, external: false})
  let reads = u64.toUsize(readsWord.value)
  run Graph.startRun(&mut thisStore.resolver.graph, reads)
  let recorder = thisStore.resolver.rootRecorder
  thisStore.resolver.rootRecorder = reads
  let attempted = run Effect.result(keptReplay(&mut thisStore.*, &mut request.*, concrete, boundary, recorded, recordRoot,
    previous, guard, inProcess, rewalkOnly))
  thisStore.resolver.rootRecorder = recorder
  drop run Graph.finishRun(&mut thisStore.resolver.graph, reads, Option<ContentHash>.none())
  let replayed = match move attempted {
    Result<Option<EscapeReplay>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<Option<EscapeReplay>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
  }
  if let Option<EscapeReplay>.Some {value: replay} = move replayed {
    let EscapeReplay {captured, result} = move replay
    run List<EscapeMemo>.append(&mut thisStore.escapeMemos, EscapeMemo {unit: unit, discovery: discovery, concrete: run copyDeclarations(concrete),
      result: run copyCheckResult(&result), captured: Option<CapturedBuild>.some(move captured), reads: reads})
    return Option<DeclarationCheckResult>.some(move result)
  }
  return Option<DeclarationCheckResult>.none()
}

// `replayEscapes`, or `rewalkEscapes` when the record no longer describes the walk as it is.
pub effect fn keptReplay(thisStore: &mut Semantic, request: &mut Request, concrete: &[DeclarationId], boundary: &Option<WalkBoundary>, recorded: &[u8],
  recordRoot: usize, previous: &[CapturedEntry], guard: usize, inProcess: bool, rewalkOnly: bool) -> Option<EscapeReplay>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  // Both read the record decoded once; a replay that succeeds takes it.
  let mut record = match move run BuildRecord.decode(recorded) {
    Option<BuildRecord.Record>.Some {value} => move value
    Option<BuildRecord.Record>.None => { return Option<EscapeReplay>.none() }
  }
  // Another check's record describes another walk: it is only ever walked again from.
  if !rewalkOnly {
    let replayed = run replayEscapes(&mut thisStore.*, &mut request.*, concrete, &mut record, recordRoot, previous, guard, inProcess)
    if let Option<EscapeReplay>.Some {..} = &replayed { return move replayed }
    drop replayed
  }
  if let Option<WalkBoundary>.Some {value: walk} = &boundary.* {
    return run rewalkEscapes(&mut thisStore.*, &mut request.*, concrete, &walk, &record, previous, inProcess)
  }
  return Option<EscapeReplay>.none()
}

// Whether a kept unit reflects the current revision, verifying it when it is outdated.
pub effect fn unitCurrent(thisStore: &mut Semantic, unit: usize) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  // An update marks units outdated only once the store reconciles its sources.
  run reconcileSources(&mut thisStore.resolver)
  let current = Graph.current(&thisStore.resolver.graph, unit)
  if current && !Graph.dispatchPending(&thisStore.resolver.graph, unit) && !Graph.inputsPending(&thisStore.resolver.graph, unit) {
    thisStore.resolver.hits = thisStore.resolver.hits + usize.ONE
    return true
  }
  if run verifyUnit(&mut thisStore.resolver, &mut thisStore.query, unit) {
    Graph.markVerified(&mut thisStore.resolver.graph, unit)
    thisStore.resolver.hits = thisStore.resolver.hits + usize.ONE
    return true
  }
  // Only surviving declaration roots verify old projections. A retired root never
  // forces the old, now unreachable producer to be lowered merely to discard its proof.
  if current { Graph.observationChanged(&mut thisStore.resolver.graph, unit) }
  return false
}

/// Checks one active declaration: the facets its kind declares, its body, and the escapes of
/// that body. Name collisions and foreign symbol claims belong to its module's check, so a body
/// edit reruns no more than this declaration's own units. An inactive declaration, or one its
/// module no longer holds, reports nothing.
///
/// Like `checkDeclarations`, it replaces `deferredStaticTemplates` and `uncheckedRootBodies`
/// with what this check found.
pub effect fn checkDeclaration(
  thisStore: &mut Semantic,
  request: &mut Request,
  declaration: &DeclarationId,
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let _traced = Trace.span("check.declaration")
  run selectRequest(&mut thisStore.resolver, &request.*)
  thisStore.deferredTemplates = List<DeferredStaticTemplate>.make()
  thisStore.uncheckedRoot = List<UncheckedBody>.make()
  let module = DeclarationId.moduleId(declaration)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let only = Option<DeclarationId>.some(DeclarationId.copy(declaration))
  let mut sweep = Sweep.make()
  run sweepModule(&mut thisStore.*, &mut request.*, module, moduleOrdinal, &only, &mut sweep)
  return run finishSweep(&mut thisStore.*, &mut request.*, &[], &Option<ModuleId>.none(), move sweep, true)
}

/// Whether `module`'s kept sweep reflects the current revision, verifying it when it is
/// outdated, so `checkModule` would reuse it rather than sweep the module again. Only a
/// revisable store keeps sweeps.
pub effect fn moduleSweepCurrent(thisStore: &mut Semantic, module: &ModuleId) -> bool
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if !Graph.recording(&thisStore.resolver.graph) { return false }
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let word = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: usize.ZERO,
    declaration: usize.MAX, member: usize.ZERO, external: false})
  let unit = u64.toUsize(word.value)
  if memoOf(List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos), unit) == usize.MAX { return false }
  return run unitCurrent(&mut thisStore.*, unit)
}

/// The declarations a check of `module` sweeps, in the order it sweeps them.
pub effect fn moduleDeclarations(thisStore: &mut Semantic, module: &ModuleId) -> List<DeclarationId>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let listed = run moduleChecks(&mut thisStore.*, module, &Option<DeclarationId>.none())
  let written = List<DeclarationCheck>.asSlice(&listed.declarations)
  let mut declarations = run List<DeclarationId>.makeWithCapacity(written.length)
  let mut at = usize.ZERO
  while at < written.length {
    run List<DeclarationId>.append(&mut declarations, DeclarationId.copy(&written[at].identity))
    at = at + usize.ONE
  }
  return move declarations
}

/// Answers the queries a check of `declaration` demands, without the escape check and without
/// reporting, so a later `checkModule` of its module finds them answered. The language server
/// runs it one declaration per step to answer requests between them.
pub effect fn prepareDeclaration(thisStore: &mut Semantic, request: &mut Request, declaration: &DeclarationId) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let deferred = Intrinsic.replace(thisStore.deferredTemplates, List<DeferredStaticTemplate>.make())
  let unchecked = Intrinsic.replace(thisStore.uncheckedRoot, List<UncheckedBody>.make())
  let module = DeclarationId.moduleId(declaration)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let only = Option<DeclarationId>.some(DeclarationId.copy(declaration))
  let mut sweep = Sweep.make()
  let attempted = run Effect.result(sweepModule(&mut thisStore.*, &mut request.*, module, moduleOrdinal, &only, &mut sweep))
  thisStore.deferredTemplates = move deferred
  thisStore.uncheckedRoot = move unchecked
  if let Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} = move attempted {
    fail move error
  }
  return ()
}

/// The foreign symbol conflicts between modules of the root package, which no one module's
/// check can see. It may repeat a rejection a module's check reports.
pub effect fn checkForeignConflicts(
  thisStore: &mut Semantic,
  request: &mut Request,
  rootPackage: &[ModuleId],
  runtime: &Option<ModuleId>,
) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let mut modules = List<usize>.make()
  let mut rootAt = usize.ZERO
  while rootAt < rootPackage.length {
    run appendCheckedModule(&mut modules, run internModule(&mut thisStore.resolver, &rootPackage[rootAt]))
    rootAt = rootAt + usize.ONE
  }
  let mut rejections = List<Shared<Rejection>>.make()
  run checkForeignClaims(&mut thisStore.*, List<usize>.asSlice(&modules), runtime, &mut rejections)
  return move rejections
}

// Checks a module's name collisions and its declarations, or only the declaration `only` names.
// Reads the declaration check roots of `module` an unlinked adoption left unread
// (`pendingRoots`), so a sweep of it finds their memos.
pub effect fn readPendingDeclarations(thisStore: &mut Semantic, module: &ModuleId) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<usize>.length(&thisStore.pendingRoots) == usize.ZERO { return () }
  let mut named = Bytes.make()
  run StableKey.module(&mut named, module)
  let hash = InternIndex.hashBytes(0, Bytes.asSlice(&named))
  let mut found = List<usize>.make()
  let mut entry = InternIndex.first(&thisStore.pendingLookup, hash)
  while entry != usize.MAX {
    if List<usize>.get(&thisStore.pendingRoots, entry) != usize.MAX { run List<usize>.append(&mut found, entry) }
    entry = InternIndex.after(&thisStore.pendingLookup, entry)
  }
  if List<usize>.length(&found) == usize.ZERO { return () }
  let held = Intrinsic.replace(thisStore.heldImage, Option<CacheImage.Image>.none())
  if let Option<CacheImage.Image>.Some {value: image} = &held {
    let roots = List<CacheImage.Root>.asSlice(&image.roots)
    let listed = List<usize>.asSlice(&found)
    let mut at = usize.ZERO
    while at < listed.length {
      let root = List<usize>.get(&thisStore.pendingRoots, listed[at])
      at = at + usize.ONE
      let key = Bytes.asSlice(&roots[root].key)
      let module = declarationRootModule(key)
      if !same(StableKey.view(key, module), Bytes.asSlice(&named)) { continue }
      List<usize>.set(&mut thisStore.pendingRoots, listed[at - usize.ONE], usize.MAX)
      // Its placeholder leaves the carried lists; a root this store reuses rejoins them.
      let carried = List<usize>.asSlice(&thisStore.carriedRoots)
      let mut slot = usize.ZERO
      while slot < carried.length && !(carried[slot] == root && List<usize>.get(&thisStore.carriedUnits, slot) == usize.MAX) {
        slot = slot + usize.ONE
      }
      if slot < carried.length {
        drop List<usize>.remove(&mut thisStore.carriedUnits, slot)
        drop List<usize>.remove(&mut thisStore.carriedRoots, slot)
      }
      let check = match move run readCheckKey(key) {
        Option<CheckKey>.Some {value} => move value
        Option<CheckKey>.None => { continue }
      }
      let answer = match move run readCheckAnswer(Bytes.asSlice(&roots[root].answer), Option<&ModuleId>.some(&check.module)) {
        Option<CheckAnswer>.Some {value} => move value
        Option<CheckAnswer>.None => { continue }
      }
      if run adoptCheck(&mut thisStore.*, usize.MAX, key, move check, move answer) {
        run List<usize>.append(&mut thisStore.carriedRoots, root)
      }
    }
  }
  thisStore.heldImage = move held
}

@trace(name: "check.sweep")
pub effect fn sweepModule(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  moduleOrdinal: usize,
  only: &Option<DeclarationId>,
  sweep: &mut Sweep
) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  run traceModule(module)
  run readPendingDeclarations(&mut thisStore.*, module)
  let listed = run moduleChecks(&mut thisStore.*, module, only)
  run checkNames(&mut thisStore.*, module, List<CheckedName>.asSlice(&listed.names), &mut sweep.rejections)
  let written = List<DeclarationCheck>.asSlice(&listed.declarations)
  let mut at = usize.ZERO
  while at < written.length {
    run sweptDeclaration(&mut thisStore.*, &mut request.*, module, moduleOrdinal, &written[at], &mut sweep.*)
    at = at + usize.ONE
  }
  return ()
}

// Checks one declaration of a sweep that records its reads in a unit of its own, so a later
// sweep of the module, after an edit elsewhere in it, reuses a check that found nothing while
// what it read stands, as an image the next process adopts does too.
pub effect fn sweptDeclaration(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  moduleOrdinal: usize,
  declaration: &DeclarationCheck,
  sweep: &mut Sweep
) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let recorder = thisStore.resolver.rootRecorder
  if recorder == usize.MAX || !Graph.recording(&thisStore.resolver.graph) {
    return run checkListedDeclaration(&mut thisStore.*, &mut request.*, module, moduleOrdinal, declaration, &mut sweep.*)
  }
  // The identity names the unit, so a declaration written above another keeps both units. Its
  // hash leaves out the kind, which tells a struct from the `impl` block of the same name.
  let named = Hash.combine(DeclarationId.hash(&declaration.identity), contentKind(DeclarationId.kind(&declaration.identity)))
  let member = hashMember(named)
  let word = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: 6,
    declaration: usize.MAX, member: member, external: false})
  let unit = u64.toUsize(word.value)
  let found = declarationMemoOf(List<usize>.asSlice(&thisStore.declarationSlots), unit)
  if found != usize.MAX {
    let memos = List<DeclarationMemo>.asSlice(&thisStore.declarationMemos)
    let concrete = memos[found].concrete
    let same = DeclarationId.equals(&memos[found].identity, &declaration.identity)
    if same && run unitCurrent(&mut thisStore.*, unit) {
      if concrete { run List<DeclarationId>.append(&mut sweep.concrete, DeclarationId.copy(&declaration.identity)) }
      run Graph.record(&mut thisStore.resolver.graph, recorder, Dependee.UnitResult {unit: unit})
      return ()
    }
    forgetDeclaration(&mut thisStore.*, found)
  }
  let rejections = List<Shared<Rejection>>.length(&sweep.rejections)
  let gaps = List<Shared<BackendGap>>.length(&sweep.gaps)
  let unchecked = List<UncheckedDeclaration>.length(&sweep.unchecked)
  let concrete = List<DeclarationId>.length(&sweep.concrete)
  let deferred = List<DeferredStaticTemplate>.length(&thisStore.deferredTemplates)
  let uncheckedBodies = List<UncheckedBody>.length(&thisStore.uncheckedRoot)
  run Graph.startRun(&mut thisStore.resolver.graph, unit)
  thisStore.resolver.rootRecorder = unit
  let attempted = run Effect.result(checkListedDeclaration(&mut thisStore.*, &mut request.*, module, moduleOrdinal, declaration, &mut sweep.*))
  thisStore.resolver.rootRecorder = recorder
  if let Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} = move attempted {
    fail move error
  }
  drop run Graph.finishRun(&mut thisStore.resolver.graph, unit, Option<ContentHash>.none())
  run Graph.record(&mut thisStore.resolver.graph, recorder, Dependee.UnitResult {unit: unit})
  if List<Shared<Rejection>>.length(&sweep.rejections) == rejections && List<Shared<BackendGap>>.length(&sweep.gaps) == gaps
    && List<UncheckedDeclaration>.length(&sweep.unchecked) == unchecked
    && List<DeferredStaticTemplate>.length(&thisStore.deferredTemplates) == deferred
    && List<UncheckedBody>.length(&thisStore.uncheckedRoot) == uncheckedBodies {
    run keepDeclaration(&mut thisStore.*, unit, DeclarationId.copy(&declaration.identity),
      List<DeclarationId>.length(&sweep.concrete) > concrete, false)
  }
  return ()
}

// Keeps the clean check of one declaration, the unit `unit` names.
pub effect fn keepDeclaration(thisStore: &mut Semantic, unit: usize, identity: DeclarationId, concrete: bool, carried: bool) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  while List<usize>.length(&thisStore.declarationSlots) <= unit { run List<usize>.append(&mut thisStore.declarationSlots, usize.MAX) }
  List<usize>.set(&mut thisStore.declarationSlots, unit, List<DeclarationMemo>.length(&thisStore.declarationMemos))
  run List<DeclarationMemo>.append(&mut thisStore.declarationMemos, DeclarationMemo {unit: unit, identity: move identity,
    concrete: concrete, carried: carried})
}

// Drops the declaration check memo `found`, which no longer describes its declaration.
pub fn forgetDeclaration(thisStore: &mut Semantic, found: usize) -> () {
  let held = List<DeclarationMemo>.asSlice(&thisStore.declarationMemos)
  let unit = held[found].unit
  let carried = held[found].carried
  if carried { uncarry(&mut thisStore.carriedUnits, &mut thisStore.carriedRoots, unit) }
  let mut memos = List<DeclarationMemo>.asMutSlice(&mut thisStore.declarationMemos)
  memos[found].unit = usize.MAX
  memos[found].carried = false
  List<usize>.set(&mut thisStore.declarationSlots, unit, usize.MAX)
}

// Ends a sweep with the foreign symbol claims of `modules` and, with `instances`, the escapes of
// its concrete bodies.
pub effect fn finishSweep(
  thisStore: &mut Semantic,
  request: &mut Request,
  modules: &[usize],
  runtime: &Option<ModuleId>,
  sweep: Sweep,
  instances: bool
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut rejections = move sweep.rejections
  let mut gaps = move sweep.gaps
  run checkForeignClaims(&mut thisStore.*, modules, runtime, &mut rejections)
  if !instances {
    return DeclarationCheckResult { rejections: move rejections, gaps: move gaps, unchecked: move sweep.unchecked }
  }
  let mut safety = run declarationEscapes(
    &mut thisStore.*,
    &mut request.*,
    List<DeclarationId>.asSlice(&sweep.concrete),
    &Option<WalkBoundary>.none()
  )
  let entries = run runtimeRoots(&mut thisStore.*, runtime, modules)
  if List<DeclarationId>.length(&entries) > usize.ZERO {
    let bound = run runtimeBoundary(&mut thisStore.*, runtime)
    let entered = run declarationEscapes(&mut thisStore.*, &mut request.*, List<DeclarationId>.asSlice(&entries), &bound)
    run splitRuntimeRejections(&mut safety.rejections, &mut thisStore.runtimeRefused, List<Shared<Rejection>>.asSlice(&entered.rejections), runtime)
    run mergeGaps(&mut safety.gaps, List<Shared<BackendGap>>.asSlice(&entered.gaps))
  }
  let found = List<Shared<Rejection>>.asSlice(&safety.rejections)
  let mut at = usize.ZERO
  while at < found.length {
    run appendDeclarationRejection(&mut rejections, Shared<Rejection>.clone(&found[at]))
    at = at + usize.ONE
  }
  let missing = List<Shared<BackendGap>>.asSlice(&safety.gaps)
  at = usize.ZERO
  while at < missing.length {
    run appendDeclarationGap(&mut gaps, Shared<BackendGap>.clone(&missing[at]))
    at = at + usize.ONE
  }
  return DeclarationCheckResult { rejections: move rejections, gaps: move gaps, unchecked: move sweep.unchecked }
}

// The checkable facts of a module's declarations, or of the one declaration `only` names, and
// for the whole module the first spelling of each candidate name.
pub effect fn moduleChecks(thisStore: &mut Semantic, module: &ModuleId, only: &Option<DeclarationId>) -> ModuleChecks
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut whole = true
  if let Option<DeclarationId>.Some { .. } = &only.* {
    whole = false
  }
  let mut listed = ModuleChecks { declarations: List<DeclarationCheck>.make(), names: List<CheckedName>.make() }
  let indexed = run source(&mut thisStore.resolver, module)
  if let Option<&IndexedSource>.Some {
    value
  } = move sourceOf(&thisStore.resolver, &indexed, module) {
    let hir = IndexedSource.authored(value)
    let index = IndexedSource.moduleIndex(value)
    let authored = ModuleIndex.listDeclarations(index)
    let candidates = ModuleIndex.listCandidates(index)
    let mut candidateAt = usize.ZERO
    while whole && candidateAt < candidates.length {
      let candidate = &candidates[candidateAt]
      if ModuleIndex.firstCandidateNamed(index, Bytes.asSlice(&candidate.name)) == candidateAt {
        run List<
          CheckedName
        >.append(
          &mut listed.names,
          CheckedName { name: run Bytes.copy(Bytes.asSlice(&candidate.name)), }
        )
      }
      candidateAt = candidateAt + usize.ONE
    }
    let mut ordinal = usize.ZERO
    while ordinal < authored.length {
      let mut wanted = true
      if let Option<DeclarationId>.Some { value: chosen } = &only.* {
        wanted = DeclarationId.equals(&authored[ordinal].identity, &chosen)
      }
      if wanted {
        let declaration = &authored[ordinal]
        let mut body = false
        let mut staticWork = false
        let callable = match Module.node(hir, declaration.header) {
          Node.FunctionHeader { .. } => true
          Node.OperationHeader { .. } => true
          _ => false
        }
        let conditional = match Module.node(hir, declaration.header) {
          Node.ConditionalHeader { .. } => true
          _ => false
        }
        let alias = match Module.node(hir, declaration.header) {
          Node.AliasHeader { .. } => true
          _ => false
        }
        let mut default = false
        let mut blockSpan = Span.make(usize.ZERO, usize.ZERO)
        let conformance = match Module.node(hir, declaration.header) {
          Node.ImplHeader { target, .. } => target.present
          _ => false
        }
        let mut inherentMapping = Option<usize>.none()
        if let Node.ImplAliasHeader { .. } = Module.node(hir, declaration.header) {
          if let Option<usize>.Some { value: parent } = &declaration.parent {
            if let Node.ImplHeader { target, .. } = Module.node(hir, authored[parent].header) {
              if !target.present { inherentMapping = Option<usize>.some(parent) }
            }
          }
        }
        if let Node.Declaration { body: syntax, .. } = Module.node(hir, declaration.local) {
          match Module.node(hir, syntax) {
            Node.CallableBody { block } => {
              body = block.present
              if block.present {
                staticWork = run bodyHasStaticWork(hir, block.id)
                blockSpan = Module.span(hir, block.id)
              }
            }
            Node.PackageParameterBody { default: written, .. } => {
              default = written.present
            }
            _ => ()
          }
        }
        run List<
          DeclarationCheck
        >.append(
          &mut listed.declarations,
          DeclarationCheck {
            identity: DeclarationId.copy(&declaration.identity),
            ordinal: ordinal,
            span: Module.span(hir, declaration.header),
            block: blockSpan,
            body: body,
            callable: callable,
            conditional: conditional,
            alias: alias,
            open: declarationOpen(hir, authored, ordinal),
            staticWork: staticWork,
            default: default,
            conformance: conformance,
            deferred: run StaticTemplate.reason(hir, authored, ordinal),
            inherentMapping: move inherentMapping,
          }
        )
      }
      ordinal = ordinal + usize.ONE
    }
  }
  drop indexed
  return move listed
}

// Name collisions are static errors even when no use selects a winner (NAME-003).
// Inactive arms can leave a bucket empty; their names do not reject the compilation.
pub effect fn checkNames(thisStore: &mut Semantic, module: &ModuleId, named: &[CheckedName], rejections: &mut List<Shared<Rejection>>) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let mut nameAt = usize.ZERO
  while nameAt < named.length {
    let mut conditions = List<Dependency>.make()
    let selection = run select(
      &mut thisStore.resolver,
      &mut thisStore.query,
      &mut conditions,
      module,
      Bytes.asSlice(&named[nameAt].name),
      false
    )
    match move selection {
      Result<Selection, Shared<Rejection>>.Failure { error } => {
        run appendDeclarationRejection(&mut rejections.*, move error)
      }
      Result<Selection, Shared<Rejection>>.Success { value } => {
        if value.count > usize.ONE {
          run appendDeclarationRejection(&mut rejections.*, run nameCollision(&thisStore.resolver, module, value, Bytes.asSlice(&named[nameAt].name)))
        }
      }
    }
    nameAt = nameAt + usize.ONE
  }
  return ()
}

// Checks one declaration of a module sweep, adding what it finds to `sweep`.
pub effect fn checkListedDeclaration(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  moduleOrdinal: usize,
  declaration: &DeclarationCheck,
  sweep: &mut Sweep
) -> ()
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let selected = run requestAvailability(
    &mut thisStore.resolver,
    &mut thisStore.query,
    &mut request.*,
    module,
    declaration.ordinal,
    declaration.span
  )
  match move selected {
    Result<bool, Shared<Rejection>>.Failure { error } => {
      run appendDeclarationRejection(&mut sweep.rejections, move error)
      return ()
    }
    Result<bool, Shared<Rejection>>.Success { value } => {
      if
        !value {
        return ()
      }
    }
  }
  let kind = DeclarationId.kind(&declaration.identity)
  // A damaged declaration's directives describe nothing, and the parser already reported them.
  if kind != OwnerKind.Function && kind != OwnerKind.Damaged {
    if let Option<Shared<Rejection>>.Some { value } = move run directiveRejection(&mut thisStore.resolver, module, declaration.ordinal) {
      run appendDeclarationRejection(&mut sweep.rejections, move value)
    }
  }
  let mut families = List<Family>.make()
  match kind {
    OwnerKind.Function => {
      // Authored callables are typed here; damaged header syntax is reported separately.
      if
        !declaration.callable {
        return ()
      }
      let signature = run Semantic.demandSignatureOf(
        &mut thisStore.*,
        &mut request.*,
        &declaration.identity
      )
      run appendCheckedAnswer(&mut sweep.rejections, &mut sweep.gaps, &mut thisStore.query, &declaration.identity, &signature)
      if declaration.body {
        let mut deferred = declaration.deferred
        if deferred.isNone() && declaration.open {
          // A static call that depends on the template's binders defers it as written dependent
          // static work does.
          let mut dependencies = List<Dependency>.make()
          if run dependentStaticRouting(&mut thisStore.resolver, &mut thisStore.query, &mut dependencies, module, moduleOrdinal,
            declaration.ordinal) {
            deferred = Option<StaticTemplate.Reason>.some(StaticTemplate.dependentExpansion())
          }
        }
        if let Option<StaticTemplate.Reason>.Some { value } = &deferred {
          run List<
            DeferredStaticTemplate
          >.append(
            &mut thisStore.deferredTemplates,
            DeferredStaticTemplate {
              declaration: DeclarationId.copy(&declaration.identity),
              reason: value,
            }
          )
          return ()
        }
        let body = run checkedDeclarationBody(
          &mut thisStore.*,
          &mut request.*,
          declaration,
          &signature
        )
        run appendCheckedAnswer(&mut sweep.rejections, &mut sweep.gaps, &mut thisStore.query, &declaration.identity, &body)
        run unneededMutableRequirements(&mut thisStore.resolver, module, declaration, &signature, &body, &mut sweep.rejections)
        // Only a concrete body's sweep status is the status of the instance a build reaches.
        // An open template is checked abstractly and a deferred one not at all here, while
        // the instances a build reaches are checked in their own right. An open template no
        // reached instance emits still counts by its abstract status, so the gap receipt does
        // not pass over a template nothing instantiates. A static function's body runs only in
        // static evaluation over static values, which the runtime borrow check does not cover
        // (`values = StaticSequence.append(move values, x)` is valid there), so it is not an
        // unchecked runtime body.
        let staticFunction = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsStatic)
        if !declaration.open && !staticFunction {
          run recordUnchecked(&mut thisStore.uncheckedRoot, module, declaration.block,
            Shared<Result<Answer, NoRejection>>.with<usize>(&body, bodyUnchecked))
        }
        if Shared<Result<Answer, NoRejection>>.with<bool>(&body, bodyAnswerPresent) {
          // A body no escape walk starts from is left out, so a later escape check, which may
          // run in another process, does not resolve its signature again to learn that.
          if !declaration.open && !run signatureStartsNoWalk(&signature) {
            run List<
              DeclarationId
            >.append(&mut sweep.concrete, DeclarationId.copy(&declaration.identity))
          }
          let borrow = Shared<Result<Answer, NoRejection>>.with<BodyBorrowStatus>(&body, bodyAnswerBorrowStatus)
          if borrow != BodyBorrowStatus.Checked && !staticFunction {
            run List<UncheckedDeclaration>.append(
              &mut sweep.unchecked,
              UncheckedDeclaration { identity: DeclarationId.copy(&declaration.identity), borrow: borrow }
            )
          }
        }
      }
    }
    OwnerKind.Static => {
      let mut dependencies = List<Dependency>.make()
      let checked = run declaredStaticType(
        &mut thisStore.resolver,
        &mut thisStore.query,
        &mut dependencies,
        moduleOrdinal,
        declaration.ordinal,
        declaration.span
      )
      if let Result<Interned<Type>, Shared<Rejection>>.Failure { error } = move checked {
        run appendDeclarationRejection(&mut sweep.rejections, move error)
      } else {
        // An exported static defines its C object from a statically evaluated initializer.
        let linked = run foreignHeader(&mut thisStore.resolver, module, declaration.ordinal)
        if linked.exported {
          let valued = run exportedStaticValue(
            &mut thisStore.resolver,
            &mut thisStore.query,
            &mut dependencies,
            moduleOrdinal,
            declaration.ordinal,
            declaration.span
          )
          if let Result<Interned<StaticData>, Shared<Rejection>>.Failure { error } = move valued {
            run appendDeclarationRejection(&mut sweep.rejections, move error)
          }
        }
      }
    }
    OwnerKind.Import => {
      run List<Family>.append(&mut families, Family.Import)
    }
    OwnerKind.Alias => {
      // An ImplAliasHeader maps an operation and is checked by its parent's witness
      // queries; it is not an AliasHeader defining a type alias. An inherent impl has no
      // operation to map, so its owner's member list rejects the mapping (SEM0195).
      if declaration.alias {
        run List<Family>.append(&mut families, Family.Alias)
      }
      if let Option<usize>.Some { value: implementation } = &declaration.inherentMapping {
        let refusal = run inherentMemberRefusal(&mut thisStore.resolver, &mut thisStore.query, module, implementation, declaration.ordinal)
        if let Option<Shared<Result<Answer, NoRejection>>>.Some { value: refused } = move refusal {
          run appendDeclarationAnswer(&mut sweep.rejections, &mut thisStore.query, &refused)
        }
      }
    }
    OwnerKind.Constant => {
      run List<Family>.append(&mut families, Family.Initializer)
    }
    OwnerKind.Conditional => {
      // Static arm groups are transparent scopes, not a second condition declaration.
      if declaration.conditional {
        run List<Family>.append(&mut families, Family.Condition)
      }
    }
    OwnerKind.PackageParameter => {
      run List<Family>.append(&mut families, Family.ParameterSchema)
      if declaration.default {
        run List<Family>.append(&mut families, Family.ParameterDefault)
      }
    }
    OwnerKind.Struct => {
      run List<Family>.append(&mut families, Family.Contract)
      run List<Family>.append(&mut families, Family.Members)
    }
    OwnerKind.Tuple => {
      run List<Family>.append(&mut families, Family.Contract)
      run List<Family>.append(&mut families, Family.Members)
    }
    OwnerKind.Enumeration => {
      run List<Family>.append(&mut families, Family.Contract)
      run List<Family>.append(&mut families, Family.Members)
    }
    OwnerKind.Union => {
      run List<Family>.append(&mut families, Family.Contract)
      run List<Family>.append(&mut families, Family.Members)
    }
    OwnerKind.Service => {
      run List<Family>.append(&mut families, Family.Contract)
      run List<Family>.append(&mut families, Family.Operations)
    }
    OwnerKind.AmbientService => {
      run List<Family>.append(&mut families, Family.Contract)
      run List<Family>.append(&mut families, Family.Operations)
    }
    OwnerKind.Interface => {
      run List<Family>.append(&mut families, Family.Contract)
      run List<Family>.append(&mut families, Family.Operations)
    }
    OwnerKind.Role => {
      run List<Family>.append(&mut families, Family.Contract)
    }
    OwnerKind.Implementation => {
      let implementationKey = run internDeclaration(
        &mut thisStore.resolver,
        Key {
          family: Family.ImplementationHead,
          module: moduleOrdinal,
          name: usize.ZERO,
          declaration: declaration.ordinal,
          member: usize.ZERO,
          external: false,
        }
      )
      let head = run demandRaw(
        &mut thisStore.resolver,
        &mut thisStore.query,
        implementationKey,
        declaration.span
      )
      run appendDeclarationAnswer(&mut sweep.rejections, &mut thisStore.query, &head)
      if declaration.conformance {
        run List<Family>.append(&mut families, Family.ImplementationMembers)
        run List<Family>.append(&mut families, Family.Coherence)
        if Shared<Result<Answer, NoRejection>>.with<bool>(&head, checkedConformanceHead) {
          run List<Family>.append(&mut families, Family.Witnesses)
        }
      }
    }

    // Literal bodies are checked by their owning Body query. Damaged syntax is reported
    // by syntaxRejections; module properties are consumed when the profile is assembled.
    _ => ()
  }
  let demanded = List<Family>.asSlice(&families)
  let mut familyAt = usize.ZERO
  while familyAt < demanded.length {
    let family = demanded[familyAt]
    familyAt = familyAt + usize.ONE
    let mut member = usize.ZERO
    if family == Family.Import {
      member = usize.MAX
    }
    let declarationKey = run internDeclaration(
      &mut thisStore.resolver,
      Key {
        family: family,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: declaration.ordinal,
        member: member,
        external: false,
      }
    )
    let answer = run demandRaw(
      &mut thisStore.resolver,
      &mut thisStore.query,
      declarationKey,
      declaration.span
    )
    run appendDeclarationAnswer(&mut sweep.rejections, &mut thisStore.query, &answer)
    if family == Family.Members {
      let count = Shared<
        Result<Answer, NoRejection>
      >.with<usize>(&answer, declarationMemberCount)
      if count > usize.ZERO {
        let application = run checkedAggregateApplication(
          &mut thisStore.resolver,
          &mut thisStore.query,
          moduleOrdinal,
          declaration.ordinal,
          declaration.span
        )
        match move application {
          Result<usize, Shared<Rejection>>.Failure { error } => {
            run appendDeclarationRejection(&mut sweep.rejections, move error)
          }
          Result<usize, Shared<Rejection>>.Success { value: applied } => {
            let mut memberAt = usize.ZERO
            while memberAt < count {
              let memberKey = run internDeclaration(
                &mut thisStore.resolver,
                Key {
                  family: Family.MemberShape,
                  module: moduleOrdinal,
                  name: applied,
                  declaration: declaration.ordinal,
                  member: memberAt,
                  external: false,
                }
              )
              let shape = run demandRaw(
                &mut thisStore.resolver,
                &mut thisStore.query,
                memberKey,
                declaration.span
              )
              run appendDeclarationAnswer(&mut sweep.rejections, &mut thisStore.query, &shape)
              memberAt = memberAt + usize.ONE
            }
            // An aggregate that stores itself inline has no finite layout (SEM0020), whether or
            // not any body uses it.
            let owner = Interned<Type>.clone(&List<Interned<Type>>.asSlice(&thisStore.resolver.applications)[applied])
            let mut visiting = List<Interned<Type>>.make()
            let mut layoutDependencies = List<Dependency>.make()
            let recursion = run inlineRecursion(&mut thisStore.resolver, &mut thisStore.query, &mut layoutDependencies, &owner, &owner,
              &mut visiting, declaration.span)
            let recursive = match move recursion {
              Result<bool, Shared<Rejection>>.Success { value } => value
              Result<bool, Shared<Rejection>>.Failure { .. } => false
            }
            if recursive {
              run appendDeclarationRejection(&mut sweep.rejections, run inlineRecursionRejection(module, declaration.span, &owner))
            }
          }
        }
      }
    }
  }
  return ()
}

// A runtime declaration needs no invented arguments or providers to select its closed static
// work. Use the same Body selection as a reached named instance, so closed static-for expansions
// and static call arguments receive authentic facts before checking. An open template selects
// over its own unbound binders; work that depends on them was deferred before this sweep.
pub effect fn checkedDeclarationBody(
  thisStore: &mut Semantic,
  request: &mut Request,
  declaration: &DeclarationCheck,
  signature: &Shared<Result<Answer, NoRejection>>
) -> Shared<Result<Answer, NoRejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if !Shared<Result<Answer, NoRejection>>.with<bool>(signature, signatureIsStatic) {
    let mut selected = declaration.staticWork
    if
      !selected {
      // Static callees also require real selection even without a written static marker.
      let module = DeclarationId.moduleId(&declaration.identity)
      let moduleOrdinal = knownModuleOrdinal(&thisStore.resolver, module)
      let mut dependencies = List<Dependency>.make()
      let routing = run needsStaticResidualization(
        &mut thisStore.resolver,
        &mut thisStore.query,
        &mut dependencies,
        module,
        moduleOrdinal,
        declaration.ordinal
      )
      match move routing {
        Result<bool, Shared<Rejection>>.Success { value } => {
          selected = value
        }
        Result<bool, Shared<Rejection>>.Failure { error } => {
          return run Shared<
            Result<Answer, NoRejection>
          >.make(
            Result<Answer, NoRejection>.succeed(run memberRejected(move error, move dependencies))
          )
        }
      }
    }
    if selected {
      let identity = run Types.internDeclaration(DeclarationId.copy(&declaration.identity))
      let instance = run InstanceKey.named(&identity)
      let application = run InstanceKey.selected(&instance)
      return run Semantic.demandSelectedBody(&mut thisStore.*, &mut request.*, &application)
    }
  }
  return run Semantic.demandBodyOf(&mut thisStore.*, &mut request.*, &declaration.identity)
}

pub fn forgetAmbientReaders(thisStore: &mut Semantic) -> () {
  let readers = List<Word>.asSlice(&thisStore.resolver.ambientQueries)
  let mut reader = usize.ZERO
  while reader < readers.length {
    Query.forget(&mut thisStore.query, readers[reader])
    // Declaration-only discovery can reuse a retained MIR without demanding its query.
    let retained = InternIndex.first(&thisStore.resolver.proofMirUnits, readers[reader].value)
    if retained != usize.MAX {
      let mut proofs = List<ProofMir>.asMutSlice(&mut thisStore.resolver.proofMirs)
      proofs[retained].index = usize.MAX
    }
    reader = reader + usize.ONE
  }
  thisStore.resolver.ambientConsumers = InternIndex.make()
  thisStore.resolver.ambientQueries = List<Word>.make()
  return ()
}

// Close exactly the instances reached by these roots. Declaration checks and artifact
// builds supply their own roots. Only the final, frozen member sets enter ordinary queries.
@trace(name: "codegen.erasures")
pub effect fn closeErasures(thisStore: &mut Semantic, module: &ModuleId, runtimeSelected: bool, roots: &[BuildRoot], origin: Span,
  closureNodes: usize, declarationCheck: bool) -> Option<BackendBuild> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  thisStore.resolver.activeCheckScope = usize.MAX
  thisStore.resolver.checkedDispatchers = List<CheckedDispatch>.make()
  thisStore.resolver.checkingMembers = false
  thisStore.resolver.erasures = ErasureIndex.make()
  thisStore.resolver.closedErasures = false
  thisStore.resolver.erasureDispatchers = List<DiscoveryDispatch>.make()
  thisStore.resolver.effectDispatchers = List<ErasedRecursion.Operation>.make()
  // A retained declaration proof observes every raw MIR dependency in this store.
  let mut workers = if declarationCheck { usize.ZERO } else { thisStore.walkWorkers }
  while true {
    let before = ErasureIndex.ambientExtent(&thisStore.resolver.erasures)
    thisStore.resolver.erasureRound = ErasureRound.make()
    let mut sharing = unshared()
    sharing.workers = workers
    sharing.frontier = thisStore.walkFrontier
    let walked = run Effect.result(buildFromTimed(&mut thisStore.*, module, runtimeSelected, roots,
      origin, closureNodes, false, &Option<FrameSelection>.none(), &mut sharing, true))
    if thisStore.walkCopy { WalkShared.abandon() }
    let round = match move walked {
      Result<BackendBuild, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
      Result<BackendBuild, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
    }
    let failed = match &round {
      BackendBuild.Unsupported {gaps: foundGaps} => List<Shared<BackendGap>>.length(&foundGaps) != usize.ZERO
      _ => true
    }
    if failed { return Option<BackendBuild>.some(move round) }
    let parts = List<Bytes>.asSlice(&sharing.parts)
    let mut part = usize.ZERO
    while !sharing.failed && part < parts.length {
      if !run ErasureRound.receive(&mut thisStore.resolver.erasureRound, Bytes.asSlice(&parts[part])) { sharing.failed = true }
      part = part + usize.ONE
    }
    if sharing.failed { workers = usize.ZERO continue }
    let stable = run ErasureRound.close(&thisStore.resolver.erasureRound, &mut thisStore.resolver.erasures)
    // A first registration can expose a statically guarded operation whose MIR contributes
    // dispatcher arms of its own. Walk that newly reached branch before freezing the sets.
    if before != ErasureIndex.ambientExtent(&thisStore.resolver.erasures) {
      forgetAmbientReaders(&mut thisStore.*)
      continue
    }
    if stable {
      let mut cycles = run uncoveredDispatchCycles(&mut thisStore.resolver)
      if List<Shared<Rejection>>.length(&cycles) > usize.ZERO {
        let first = List<Shared<Rejection>>.remove(&mut cycles, usize.ZERO)
        return Option<BackendBuild>.some(BackendBuild.Rejected {first: move first, further: move cycles, gaps: List<Shared<BackendGap>>.make()})
      }
      break
    }
  }
  if declarationCheck {
    let mut promises = run checkedErasedPromises(&mut thisStore.resolver, module)
    if List<Shared<Rejection>>.length(&promises) != usize.ZERO {
      let first = List<Shared<Rejection>>.remove(&mut promises, usize.ZERO)
      return Option<BackendBuild>.some(BackendBuild.Rejected {first: move first, further: move promises, gaps: List<Shared<BackendGap>>.make()})
    }
  }
  thisStore.resolver.erasureRound = ErasureRound.make()
  thisStore.resolver.effectDispatchers = List<ErasedRecursion.Operation>.make()
  run ErasureIndex.freeze(&mut thisStore.resolver.erasures)
  thisStore.resolver.closedErasures = true
  forgetAmbientReaders(&mut thisStore.*)
  if declarationCheck {
    let sites = List<DiscoveryDispatch>.asSlice(&thisStore.resolver.erasureDispatchers)
    let mut at = usize.ZERO
    while at < sites.length {
      let set = run internCheckMembers(&mut thisStore.resolver.checkMemberSets, ErasureIndex.factsAt(&thisStore.resolver.erasures, sites[at].contract))
      run List<CheckedDispatch>.append(&mut thisStore.resolver.checkedDispatchers, CheckedDispatch {instance: InstanceKey.copy(&sites[at].instance), checkSet: set})
      at = at + usize.ONE
    }
    thisStore.resolver.checkingMembers = sites.length != usize.ZERO
    thisStore.resolver.erasureDispatchers = List<DiscoveryDispatch>.make()
  } else {
    thisStore.resolver.erasureDispatchers = List<DiscoveryDispatch>.make()
    run reconcileMembership(&mut thisStore.resolver)
  }
  return Option<BackendBuild>.none()
}

// A declaration-only program has no executable entry. Its concrete declaration roots still
// reach conversions and witness calls. Close them before the escape walk reads dispatcher MIR
// or replays a previously checked module. Templates and unsupplied providers have no root MIR.
pub effect fn closeCheckErasures(thisStore: &mut Semantic, request: &mut Request, declarations: &[DeclarationId], runtimeRoots: bool) -> Option<DeclarationCheckResult>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if declarations.length == usize.ZERO { return Option<DeclarationCheckResult>.none() }
  let module = knownModuleOrdinal(&thisStore.resolver, DeclarationId.moduleId(&declarations[0]))
  if !needsCheckDiscovery(&thisStore.resolver, module) { return Option<DeclarationCheckResult>.none() }
  let mut roots = List<BuildRoot>.make()
  let mut at = usize.ZERO
  while at < declarations.length {
    let declaration = &declarations[at]
    // Swept declarations already passed signatureStartsNoWalk. Runtime exports come from
    // their export list and still need the signature check here.
    let lowered = if runtimeRoots { run escapeRootMir(&mut thisStore.*, &mut request.*, declaration) }
      else { run namedCheckMir(&mut thisStore.*, &mut request.*, declaration) }
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: answer} = move lowered {
      if let Option<usize>.Some {..} = move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex) {
        let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
        let span = run authoredRequestSpan(&mut thisStore.resolver, declaration, Span.make(usize.ZERO, usize.ZERO))
        run List<BuildRoot>.append(&mut roots, BuildRoot {key: run InstanceKey.named(&identity), span: span, retained: false})
      }
    }
    at = at + usize.ONE
  }
  if List<BuildRoot>.length(&roots) == usize.ZERO {
    thisStore.resolver.activeCheckScope = usize.MAX
    thisStore.resolver.erasures = ErasureIndex.make()
    thisStore.resolver.checkedDispatchers = List<CheckedDispatch>.make()
    thisStore.resolver.checkingMembers = false
    thisStore.resolver.closedErasures = true
    return Option<DeclarationCheckResult>.none()
  }
  let closed = run closeErasures(&mut thisStore.*, DeclarationId.moduleId(&declarations[0]), false, List<BuildRoot>.asSlice(&roots),
    Span.make(usize.ZERO, usize.ZERO), staticClosureNodes, true)
  if let Option<BackendBuild>.Some {value} = move closed {
    let mut refused = List<Shared<Rejection>>.make()
    let missing = match move value {
      BackendBuild.Rejected {first, further, gaps} => {
        run List<Shared<Rejection>>.append(&mut refused, move first)
        run mergeRejections(&mut refused, List<Shared<Rejection>>.asSlice(&further))
        move gaps
      }
      BackendBuild.Unsupported {gaps} => move gaps
      BackendBuild.Module {..} => { return CompilerBug.panic(b"erasure discovery emitted an artifact") }
    }
    return Option<DeclarationCheckResult>.some(DeclarationCheckResult {rejections: move refused, gaps: move missing, unchecked: List<UncheckedDeclaration>.make()})
  }
  return Option<DeclarationCheckResult>.none()
}

// Checks OWN0016 using a MIR-only closure. No declaration added here becomes an emission root.
// Open templates and provider-dependent declarations keep their Body obligations; they do not
// acquire fabricated runtime instances merely because the module is loaded.
pub effect fn declarationEscapes(
  thisStore: &mut Semantic,
  request: &mut Request,
  declarations: &[DeclarationId],
  boundary: &Option<WalkBoundary>,
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if !mayWriteErasure(&thisStore.resolver) && List<usize>.length(&thisStore.resolver.nonParkingCallers) == usize.ZERO {
    let mut capture = BuildCapture.walk()
    return run capturedEscapes(&mut thisStore.*, &mut request.*, declarations, boundary, &mut capture, usize.MAX)
  }
  // A package sweep appends each module's declarations together. An import alone does not
  // make an unrelated module's conversions reachable from this module's declaration roots.
  // Its calls still reach instances in other modules during discovery.
  let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()}
  let runtimeRoots = match &boundary.* {
    Option<WalkBoundary>.Some {value} => value.staticsOnly
    _ => false
  }
  let mut at = usize.ZERO
  while at < declarations.length {
    let start = at
    let module = DeclarationId.moduleId(&declarations[start])
    at = at + usize.ONE
    while at < declarations.length && ModuleId.equals(module, DeclarationId.moduleId(&declarations[at])) { at = at + usize.ONE }
    let roots = Slice.view<DeclarationId>(declarations, start, at - start)
    let closed = run closeCheckErasures(&mut thisStore.*, &mut request.*, roots, runtimeRoots)
    let checked = match move closed {
      Option<DeclarationCheckResult>.Some {value} => move value
      Option<DeclarationCheckResult>.None => {
        let mut capture = BuildCapture.walk()
        run capturedEscapes(&mut thisStore.*, &mut request.*, roots, boundary, &mut capture, usize.MAX)
      }
    }
    run mergeRejections(&mut result.rejections, List<Shared<Rejection>>.asSlice(&checked.rejections))
    run mergeGaps(&mut result.gaps, List<Shared<BackendGap>>.asSlice(&checked.gaps))
  }
  return move result
}

// The MIR answer of `declaration`'s plain body when an escape walk starts from it: none for an
// open template, a static body or one with static arguments, and for a body that lowers to none.
pub effect fn escapeRootMir(thisStore: &mut Semantic, request: &mut Request, declaration: &DeclarationId) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let signature = run Semantic.demandSignatureOf(&mut thisStore.*, &mut request.*, declaration)
  if run signatureStartsNoWalk(&signature) { return Option<Shared<Result<Answer, NoRejection>>>.none() }
  return run namedCheckMir(&mut thisStore.*, &mut request.*, declaration)
}

// `declarationEscapes`, captured into `capture` as a record of the walk (`BuildRecord`) when
// `guard` is a unit, which then holds the reads of the walk's growth guards and static closures.
@trace(name: "check.escapes")
pub effect fn capturedEscapes(
  thisStore: &mut Semantic,
  request: &mut Request,
  declarations: &[DeclarationId],
  boundary: &Option<WalkBoundary>,
  capture: &mut BuildCapture,
  guard: usize,
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  Trace.set("declarations", &declarations.length)
  let clock = run Progress.enterQuery(&mut thisStore.resolver.progress, u8.toUsize(Family.value(Family.CleanupFree)) + 1, "EscapeWalk")
  let traced = run Tracing.enterQuery(u8.toUsize(Family.value(Family.CleanupFree)) + 1, "EscapeWalk", usize.MAX)
  let attempted = run Effect.result(capturedEscapesTimed(&mut thisStore.*, &mut request.*, declarations, boundary, &mut capture.*, guard))
  Tracing.leaveQuery(traced)
  run Progress.leaveQuery(&mut thisStore.resolver.progress, clock)
  return match move attempted {
    Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<DeclarationCheckResult, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
  }
}

pub effect fn capturedEscapesTimed(
  thisStore: &mut Semantic,
  request: &mut Request,
  declarations: &[DeclarationId],
  boundary: &Option<WalkBoundary>,
  capture: &mut BuildCapture,
  guard: usize,
) -> DeclarationCheckResult
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let capturing = guard != usize.MAX
  let mut pending = List<BackendVisit>.make()
  // How each pending visit was reached, as in a build walk.
  let mut origins = List<VisitOrigin>.make()
  let mut summaries = List<SuspensionSummary>.make()
  let mut result = DeclarationCheckResult {
    rejections: List<Shared<Rejection>>.make(),
    gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()
  }
  let mut visited = List<InstanceKey>.make()
  let mut lookup = InternIndex.make()
  let mut admission = Admission.make()
  let mut certified = List<Application>.make()
  let mut certifiedLookup = InternIndex.make()
  let mut cleanupAnswers = List<CleanupAnswer>.make()
  // Plain bodies a bounded walk left to their own module's check, walked after all only when a
  // callback boundary needs the call graph below it (`localSharedEscapes`).
  let mut left = List<BackendVisit>.make()
  let mut leftOrigins = List<VisitOrigin>.make()
  let mut foreign = ForeignDeclarations {seen: List<ForeignDeclaration>.make(), lookup: InternIndex.make()}
  let mut bounded = false
  if let Option<WalkBoundary>.Some {..} = &boundary.* { bounded = true }
  let mut at = usize.ZERO
  while at < declarations.length {
    let declaration = &declarations[at]
    at = at + usize.ONE
    let lowered = run escapeRootMir(&mut thisStore.*, &mut request.*, declaration)
    if let Option<Shared<Result<Answer, NoRejection>>>.Some { value: rawAnswer } = move lowered {
      let span = run authoredRequestSpan(
        &mut thisStore.resolver,
        declaration,
        Span.make(usize.ZERO, usize.ZERO)
      )
      let answer = run anchorCanonicalAnswer(&mut thisStore.resolver, &rawAnswer, declaration, span)
      let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
      let instance = run InstanceKey.named(&identity)
      let reportsBefore = List<Shared<Rejection>>.length(&result.rejections) + List<Shared<BackendGap>>.length(&result.gaps)
      run appendCheckedAnswer(&mut result.rejections, &mut result.gaps, &mut thisStore.query, declaration, &answer)
      let reports = List<Shared<Rejection>>.length(&result.rejections) + List<Shared<BackendGap>>.length(&result.gaps) != reportsBefore
      let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex)
      if let Option<usize>.Some { .. } = move index {
        if reports { capture.unreplayable = true }
        let module = DeclarationId.moduleId(declaration)
        run List<VisitOrigin>.append(&mut origins, VisitOrigin {parent: usize.MAX, position: List<ContentHash>.length(&capture.roots),
          requested: false})
        if capturing { run List<ContentHash>.append(&mut capture.roots, run keyDigest(&instance, capture.patterns)) }
        run List<
          BackendVisit
        >.append(
          &mut pending,
          BackendVisit.Enter {
            key: move instance,
            edge: Edge.Direct,
            span: span,
            module: ModuleId.copy(module),
            cleanup: Option<Interned<Type>>.none(),
            requester: Option<RelatedSite>.none()
          }
        )
      }
    }
  }
  // Whether the walk already looked for local-shared escapes in the summaries it ends with.
  let mut escapesChecked = false
  while true {
    // A bounded walk that reached a callback access walks the left bodies the callback's calls
    // reach after all, and everything they reach, until no call below a callback is left. Only
    // an escape found then walks every left body, so it is reported as a whole walk reports it.
    if List<BackendVisit>.length(&pending) == usize.ZERO {
      if List<BackendVisit>.length(&left) == usize.ZERO || !anyCallbackAccess(List<SuspensionSummary>.asSlice(&summaries)) {
        break
      }
      pending = run belowCallbacks(List<SuspensionSummary>.asSlice(&summaries), &mut left, &mut leftOrigins, &mut origins)
      if List<BackendVisit>.length(&pending) == usize.ZERO {
        let found = run localSharedEscapes(&thisStore.resolver, List<SuspensionSummary>.asSlice(&summaries))
        if List<Shared<Rejection>>.length(&found) == usize.ZERO {
          escapesChecked = true
          break
        }
        pending = Intrinsic.replace(left, List<BackendVisit>.make())
        origins = Intrinsic.replace(leftOrigins, List<VisitOrigin>.make())
      }
      bounded = false
    }
    let visit = match move List<BackendVisit>.pop(&mut pending) {
      Option<BackendVisit>.Some { value } => move value
      _ => {
        break
      }
    }
    let origin = match move List<VisitOrigin>.pop(&mut origins) {
      Option<VisitOrigin>.Some {value} => value
      Option<VisitOrigin>.None => { return CompilerBug.panic(b"a pending escape visit has no origin") }
    }
    let entered = match move visit {
      BackendVisit.Leave => {
        Admission.leave(&mut admission)
        continue
      }
      BackendVisit.Enter {
        key,
        edge,
        span,
        module,
        cleanup,
        requester
      } => BackendRequest {
        key: move key,
        edge: move edge,
        span: span,
        module: move module,
        cleanup: move cleanup,
        requester: move requester,
      }
    }
    let instance = move entered.key

    // Imported C declarations have checked headers and no authored body to summarize. They
    // remain foreign edges, exactly as in the executable walk; no MIR body is fabricated.
    if run walkedForeign(&mut thisStore.resolver, &mut foreign, &instance) {
      if capturing { run BuildCapture.reached(&mut capture.*, &instance, origin, BuildRecord.FOREIGN) }
      continue
    }
    if bounded {
      if let Option<WalkBoundary>.Some {value: walk} = &boundary.* {
        if run walkedElsewhere(&walk, &instance) {
          if capturing {
            run BuildCapture.reached(&mut capture.*, &instance, origin, BuildRecord.LEFT)
            let reached = List<CaptureEntry>.length(&capture.entries) - usize.ONE
            BuildCapture.flag(&mut capture.*, reached, BuildRecord.FACT_ELSEWHERE)
          }
          run List<BackendVisit>.append(&mut left, BackendVisit.Enter {key: move instance, edge: move entered.edge,
            span: entered.span, module: move entered.module, cleanup: move entered.cleanup, requester: move entered.requester})
          run List<VisitOrigin>.append(&mut leftOrigins, origin)
          continue
        }
      }
    }
    let mut leave = false
    if let Option<Interned<Application>>.Some { .. } = move InstanceKey.application(&instance) {
      let application = run InstanceKey.selected(&instance)

      // A Drop hook drop glue reaches is selected by the cleanup of the value its run started from.
      let mut reaching = move entered.edge
      if let Option<Interned<Type>>.Some { value: owner } = &entered.cleanup {
        reaching = Edge.Cleanup { owner: Interned<Type>.clone(&owner) }
      }
      let enteredEdge = Edge.copy(&reaching)
      let refused = run Admission.enter(&mut admission, &application, move reaching)
      let decision = run admitOwnedDescent(&mut thisStore.resolver, &mut thisStore.query, &mut admission, &application, &enteredEdge, move refused)
      match move decision {
        Decision.Entered => {
          leave = true
        }
        Decision.ChangingStatic { .. } => {
          let mut admitted = false
          let known = List<Application>.asSlice(&certified)
          let mut knownAt = InternIndex.first(&certifiedLookup, Application.hash(&application))
          while knownAt != usize.MAX {
            if run Application.equals(&known[knownAt], &application) {
              admitted = true
              break
            }
            knownAt = InternIndex.after(&certifiedLookup, knownAt)
          }
          if
            !admitted {
            let ancestorPath = run Admission.path(&admission)
            let ancestorSlice = List<Application>.asSlice(&ancestorPath)
            let mut caller = Option<Application>.none()
            if ancestorSlice.length > usize.ZERO {
              caller = Option<
                Application
              >.some(run Application.copy(&ancestorSlice[ancestorSlice.length - usize.ONE]))
            }
            let incoming = ClosureIncoming {
              caller: move caller,
              edge: Edge.copy(&enteredEdge),
              module: ModuleId.copy(&entered.module),
              span: entered.span
            }
            let recorder = thisStore.resolver.rootRecorder
            if capturing {
              thisStore.resolver.rootRecorder = guard
              capture.guarded = true
            }
            let closure = run closeChain(
              &mut thisStore.*,
              &admission,
              &application,
              move incoming,
              staticClosureNodes
            )
            thisStore.resolver.rootRecorder = recorder
            match move closure {
              StaticClosure.Certified { evidence } => {
                let reached = List<Application>.asSlice(&evidence.nodes)
                let mut reachedAt = usize.ZERO
                while reachedAt < reached.length {
                  run List<
                    Application
                  >.append(&mut certified, run Application.copy(&reached[reachedAt]))
                  run InternIndex.record(
                    &mut certifiedLookup,
                    Application.hash(&reached[reachedAt])
                  )
                  reachedAt = reachedAt + usize.ONE
                }
              }
              StaticClosure.NotProven { diagnostic } => {
                capture.unreplayable = true
                run List<Shared<Rejection>>.append(&mut result.rejections, move diagnostic)
                continue
              }
              StaticClosure.Rejected { diagnostic } => {
                capture.unreplayable = true
                run List<Shared<Rejection>>.append(&mut result.rejections, move diagnostic)
                continue
              }
              StaticClosure.Unsupported { gaps: found } => {
                capture.unreplayable = true
                let reached = List<Shared<BackendGap>>.asSlice(&found)
                let mut reachedAt = usize.ZERO
                while reachedAt < reached.length {
                  run List<
                    Shared<BackendGap>
                  >.append(&mut result.gaps, Shared<BackendGap>.clone(&reached[reachedAt]))
                  reachedAt = reachedAt + usize.ONE
                }
                continue
              }
            }
          }
          run Admission.enterChain(&mut admission, &application, move enteredEdge)
          leave = true
        }
        Decision.Reused { .. } => {}
        Decision.Open => {
          capture.unreplayable = true
          let identity = InstanceKey.identity(&instance)
          let diagnostic = run reject(
            &thisStore.resolver,
            &entered.module,
            RejectionCode.Undetermined,
            entered.span
          )
          run List<
            Shared<BackendGap>
          >.append(
            &mut result.gaps,
            run Shared<
              BackendGap
            >.make(BackendGap.fromRejection(GapCode.OpenInstance, &identity, &diagnostic),),
          )
          continue
        }
        Decision.Rejected { path } => {
          let recorder = thisStore.resolver.rootRecorder
          if capturing {
            thisStore.resolver.rootRecorder = guard
            capture.guarded = true
          }
          let mut admitted = run cleanupAdmits(
            &mut thisStore.resolver,
            &mut thisStore.query,
            &mut cleanupAnswers,
            &admission,
            &application,
            &enteredEdge,
            List<Application>.asSlice(&path)
          )
          if !admitted {
            admitted = run ownedDescentAdmits(
              &mut thisStore.resolver,
              &mut thisStore.query,
              &mut cleanupAnswers,
              &admission,
              &application,
              List<Application>.asSlice(&path)
            )
          }
          thisStore.resolver.rootRecorder = recorder
          if !admitted {
            capture.unreplayable = true
            run List<
              Shared<Rejection>
            >.append(
              &mut result.rejections,
              run rejectSpecialization(
                &mut thisStore.resolver,
                entered.span,
                Option<RelatedSite>.none(),
                move path
              )
            )
            continue
          }
          run Admission.enterChain(&mut admission, &application, move enteredEdge)
          leave = true
        }
      }
    }
    // Every region pattern of an application runs one definition, whose MIR is one body
    // (`internBackendInstance`), so a pattern after the first adds nothing to walk; the record
    // names each instance by that definition, and a rewalk visits by it too.
    if run definitionVisited(List<InstanceKey>.asSlice(&visited), &lookup, &instance) {
      if leave {
        Admission.leave(&mut admission)
      }
      continue
    }
    if leave {
      run List<BackendVisit>.append(&mut pending, BackendVisit.Leave)
      run List<VisitOrigin>.append(&mut origins, VisitOrigin {parent: usize.MAX, position: usize.ZERO, requested: false})
    }
    let entry = List<CaptureEntry>.length(&capture.entries)
    if capturing {
      run BuildCapture.enter(&mut capture.*, &instance, origin)
      // A rewalk decides from the record whether a bounded walk would leave the instance.
      if let Option<WalkBoundary>.Some {value: walk} = &boundary.* {
        if run walkedElsewhere(&walk, &instance) { BuildCapture.flag(&mut capture.*, entry, BuildRecord.FACT_ELSEWHERE) }
      }
    }
    run InternIndex.record(&mut lookup, InstanceKey.runtimeHash(&instance))
    run List<InstanceKey>.append(&mut visited, InstanceKey.copy(&instance))
    let identity = DeclarationId.copyShared(&InstanceKey.identity(&instance))
    let answer = run Semantic.demandInstanceMir(
      &mut thisStore.*,
      &mut request.*,
      &instance,
      &identity,
      entered.span,
      false
    )
    let reportedBefore = List<Shared<Rejection>>.length(&result.rejections)
    let gapsBefore = List<Shared<BackendGap>>.length(&result.gaps)
    run appendCheckedAnswer(&mut result.rejections, &mut result.gaps, &mut thisStore.query, &identity, &answer)
    let entryReports = List<Shared<Rejection>>.length(&result.rejections) != reportedBefore
      || List<Shared<BackendGap>>.length(&result.gaps) != gapsBefore
    // A refusal inside a toolchain body reached from user code belongs at the user's call,
    // unless the body is the same for every caller.
    let site = requestSite(&entered.requester, &entered.module, entered.span)
    let own = run instanceExtent(&mut thisStore.resolver, &instance)
    run relocateRequested(&mut result.rejections, reportedBefore, &site.module, site.span, callerIndependent(&instance), &own)
    let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex)
    if let Option<usize>.Some { value } = move index {
      if entryReports { capture.unreplayable = true }
      let anchor = run instanceAnchor(&mut thisStore.resolver, &instance)
      if capturing { BuildCapture.lowered(&mut capture.*, entry, run instanceMirUnit(&mut thisStore.resolver, &instance, false)) }
      let module = DeclarationId.moduleId(&identity)
      let functions = List<MirFunction>.asSlice(&thisStore.resolver.mirValues)
      let function = &functions[value]
      let mut summary = run SuspensionSummary.make(function, &instance, module, &anchor, &entered.module, entered.span)
      SuspensionSummary.recordAmbientCall(&mut summary, &entered.requester, &entered.module, entered.span)
      if capturing {
        let digest = run summaryDigest(&summary, function.observes, capture.patterns)
        run BuildCapture.references(&mut capture.*, entry, &instance, List<MirReference>.asSlice(&function.references), digest)
        run BuildCapture.walked(&mut capture.*, entry, &summary)
        if thisStore.resolver.closedErasures {
          run recordErasedFacts(&mut List<CaptureEntry>.asMutSlice(&mut capture.entries)[entry].facts, function, currentErasures(&thisStore.resolver))
        }
      }
      run List<SuspensionSummary>.append(&mut summaries, move summary)
      let mut cleanup = copyCleanupRoot(&entered.cleanup)
      if let Option<Interned<Type>>.Some { value: root } = move InstanceKey.glueType(&instance) {
        if let Option<Interned<Type>>.None = &cleanup {
          cleanup = Option<Interned<Type>>.some(move root)
        }
      }
      let references = List<MirReference>.asSlice(&function.references)
      at = references.length
      while at > usize.ZERO {
        at = at - usize.ONE
        run List<
          BackendVisit
        >.append(
          &mut pending,
          BackendVisit.Enter {
            key: InstanceKey.copy(&references[at].key),
            edge: Edge.copy(&references[at].edge),
            span: anchoredSpan(&anchor, references[at].origin),
            module: ModuleId.copy(module),
            cleanup: copyCleanupRoot(&cleanup),
            requester: successorRequester(&entered.requester, &entered.module, entered.span, module)
          }
        )
        run List<VisitOrigin>.append(&mut origins, VisitOrigin {parent: entry, position: at, requested: false})
      }
    }
  }
  let mut escapes = List<Shared<Rejection>>.make()
  if !escapesChecked { escapes = run localSharedEscapes(&thisStore.resolver, List<SuspensionSummary>.asSlice(&summaries)) }
  let found = List<Shared<Rejection>>.asSlice(&escapes)
  if found.length > usize.ZERO { capture.unreplayable = true }
  at = usize.ZERO
  while at < found.length {
    run appendDeclarationRejection(&mut result.rejections, Shared<Rejection>.clone(&found[at]))
    at = at + usize.ONE
  }
  return move result
}

/// The selected import members that IMPORT-003 rejects (unknown, private, or claimed twice) in
/// every loaded module, checked when the module is reached rather than when a use demands the
/// member. Checking a member can load the module it names, whose imports are checked in turn.
pub effect fn importRejections(thisStore: &mut Semantic, request: &mut Request) -> List<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut rejections = List<Shared<Rejection>>.make()
  let mut visited = List<usize>.make()
  let mut at = usize.ZERO
  while at < SourceIndex.slotCount(&thisStore.resolver.source) {
    let present = match move SourceIndex.presentModule(&thisStore.resolver.source, at) {
      Option<&ModuleId>.Some {value} => Option<ModuleId>.some(ModuleId.copy(value))
      Option<&ModuleId>.None => Option<ModuleId>.none()
    }
    if let Option<ModuleId>.Some {value: module} = move present {
      run List<usize>.append(&mut visited, run internModule(&mut thisStore.resolver, &module))
      let mut found = run Semantic.moduleImportRejections(&mut thisStore.*, &mut request.*, &module)
      while List<Shared<Rejection>>.length(&found) > usize.ZERO {
        run List<Shared<Rejection>>.append(&mut rejections, List<Shared<Rejection>>.remove(&mut found, usize.ZERO))
      }
    }
    at = at + usize.ONE
  }
  // A cache image's import check of a module this process never read still answers for it: a
  // module whose declarations were all reused is not read, and its refused imports are not gone.
  let mut unread = List<ModuleId>.make()
  let memos = List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos)
  at = usize.ZERO
  while at < memos.length {
    let scoped = List<ScopedKey>.get(&thisStore.resolver.keys, memos[at].unit)
    at = at + usize.ONE
    if scoped.key.family != Family.ModuleCheck || scoped.key.name != 5 { continue }
    if holdsUnit(List<usize>.asSlice(&visited), scoped.key.module) { continue }
    run List<usize>.append(&mut visited, scoped.key.module)
    run List<ModuleId>.append(&mut unread, ModuleId.copy(&List<ModuleId>.asSlice(&thisStore.resolver.modules)[scoped.key.module]))
  }
  let listed = List<ModuleId>.asSlice(&unread)
  at = usize.ZERO
  while at < listed.length {
    let mut found = run Semantic.moduleImportRejections(&mut thisStore.*, &mut request.*, &listed[at])
    while List<Shared<Rejection>>.length(&found) > usize.ZERO {
      run List<Shared<Rejection>>.append(&mut rejections, List<Shared<Rejection>>.remove(&mut found, usize.ZERO))
    }
    at = at + usize.ONE
  }
  return move rejections
}

/// The selected members of `module`'s active imports that IMPORT-003 rejects, in written order.
/// A revisable store keeps the check as a module check unit, so a cache image holds a module
/// whose imports were clean and the next process takes it without reading the module.
pub effect fn moduleImportRejections(thisStore: &mut Semantic, request: &mut Request, module: &ModuleId) -> List<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  if !Graph.recording(&thisStore.resolver.graph) { return run importChecks(&mut thisStore.*, module, moduleOrdinal) }
  let word = run internKey(&mut thisStore.resolver, Key {family: Family.ModuleCheck, module: moduleOrdinal, name: 5,
    declaration: usize.MAX, member: usize.ZERO, external: false})
  let unit = u64.toUsize(word.value)
  let found = memoOf(List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos), unit)
  if found != usize.MAX {
    if run unitCurrent(&mut thisStore.*, unit) {
      let memos = List<ModuleCheckMemo>.asSlice(&thisStore.moduleMemos)
      return run copyRejections(List<Shared<Rejection>>.asSlice(&memos[found].sweep.rejections))
    }
    drop List<ModuleCheckMemo>.remove(&mut thisStore.moduleMemos, found)
    uncarry(&mut thisStore.carriedUnits, &mut thisStore.carriedRoots, unit)
  }
  run Graph.startRun(&mut thisStore.resolver.graph, unit)
  thisStore.resolver.runs = thisStore.resolver.runs + usize.ONE
  thisStore.resolver.rootRecorder = unit
  let attempted = run Effect.result(importChecks(&mut thisStore.*, module, moduleOrdinal))
  thisStore.resolver.rootRecorder = usize.MAX
  // A failed check keeps no memo, so the next one runs again whatever its unit's edges say.
  let rejections = match move attempted {
    Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => { fail move error }
  }
  drop run Graph.finishRun(&mut thisStore.resolver.graph, unit, Option<ContentHash>.none())
  let mut sweep = Sweep.make()
  sweep.rejections = run copyRejections(List<Shared<Rejection>>.asSlice(&rejections))
  run List<ModuleCheckMemo>.append(&mut thisStore.moduleMemos, ModuleCheckMemo {unit: unit, sweep: move sweep,
    deferred: List<DeferredStaticTemplate>.make(), unchecked: List<UncheckedBody>.make()})
  return move rejections
}

pub effect fn importChecks(thisStore: &mut Semantic, module: &ModuleId, moduleOrdinal: usize) -> List<Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut rejections = List<Shared<Rejection>>.make()
  let selections = run selectedImportMembers(&mut thisStore.resolver, module)
  let listed = List<ImportMembers>.asSlice(&selections)
  let span = Span.make(usize.ZERO, usize.ZERO)
  // Governing conditions are observed without a dependent answer, as for build roots.
  let mut conditions = List<Dependency>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let active = run available(&mut thisStore.resolver, &mut thisStore.query, &mut conditions, module, listed[at].declaration, span)
    let mut selected = false
    match move active {
      Result<bool, Shared<Rejection>>.Success {value} => { selected = value }
      Result<bool, Shared<Rejection>>.Failure {error} => { run List<Shared<Rejection>>.append(&mut rejections, move error) }
    }
    let mut member = usize.ZERO
    while selected && member < listed[at].members {
      let declarationAccess253Request = Key {
        family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
        declaration: listed[at].declaration, member: member, external: false,
      }
      let declarationAccess253 = run internDeclaration(&mut thisStore.resolver, declarationAccess253Request)
      let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess253, span)
      let reported = run reportedDiagnostics(&mut thisStore.query, &answer)
      let listed = List<Shared<Rejection>>.asSlice(&reported)
      let mut reportedAt = usize.ZERO
      while reportedAt < listed.length {
        run List<Shared<Rejection>>.append(&mut rejections, Shared<Rejection>.clone(&listed[reportedAt]))
        reportedAt = reportedAt + usize.ONE
      }
      member = member + usize.ONE
    }
    at = at + usize.ONE
  }
  return move rejections
}

/// Builds a finite reachable-key closure rooted at one application, as a build does at a
/// changing-static edge. Only certified evidence admits such a chain; `limit` bounds its nodes.
/// The root is validated like any demanded application; its incoming edge is Direct in the
/// root's module at the authentic original header, with no caller or ancestors.
pub effect fn closeStaticChain(thisStore: &mut Semantic, request: &mut Request, root: &Application, limit: usize) -> StaticClosure
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = ModuleId.copy(DeclarationId.moduleId(Application.bodyDeclaration(root)))
  let span = run authoredRequestSpan(&mut thisStore.resolver, Application.bodyDeclaration(root), Span.make(usize.ZERO, usize.ZERO))
  let checked = run Semantic.validateApplication(&mut thisStore.*, &mut request.*, root, &module, span)
  let validated = match move checked {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => { return StaticClosure.Rejected {diagnostic: move error} }
  }
  let incoming = ClosureIncoming {caller: Option<Application>.none(), edge: Edge.Direct, module: move module, span: span}
  let ancestors = Admission.make()
  return run closeChain(&mut thisStore.*, &ancestors, &validated, move incoming, limit)
}

// Replays the escape walk record `recorded`, root `recordRoot` of the adopted image, for an
// escape check of `concrete` instead of walking again, when the record still describes the
// walk: the same bodies start it, and every entry whose MIR is not green lowers without a report
// to the references the record names and summarizes as it did, so the walk would reach the
// same instances, leave the same bodies to other checks and find nothing, as it did. Keys are
// found again through parents' MIR, as `replayBuild` finds them. None when it does not hold.
//
// A body that now lowers to nothing, as one an edit broke, is replayed as the walk meets it: what
// it reports is the replay's, located as the walk locates it, and nothing below it is entered. So
// is a root that no longer starts the walk. Such a replay holds when every entry it still needs
// lies outside what those bodies reach: the walk then reaches a part of what the record names,
// and its summaries are a part of the ones the record found no escape in, so it finds none
// either. Its record is still the one read, and the MIR it lowered is kept for the next check,
// but no check root rests on it while the walk reports (`imageReplayedChecks`), and none can
// while a pruned body lowers to nothing, which leaves its entry without a root.
//
// A stale entry that names a plain instance is found by its own declaration first, so the bodies
// above it are not lowered again; only a report needs where the walk entered it, and then the
// replay runs again through parents' MIR.
//
// When `inProcess`, the record is this store's own last walk, `previous` its entries, and an entry
// is green when its MIR unit is current; otherwise green entries are the adopted image's.
pub effect fn replayEscapes(thisStore: &mut Semantic, request: &mut Request, concrete: &[DeclarationId], record: &mut BuildRecord.Record, recordRoot: usize,
  previous: &[CapturedEntry], guard: usize, inProcess: bool) -> Option<EscapeReplay>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut sited = false
  let plain = run replayEscapesWith(&mut thisStore.*, &mut request.*, concrete, &mut record.*, recordRoot, previous, guard, inProcess,
    true, &mut sited)
  if !sited { return move plain }
  drop plain
  return run replayEscapesWith(&mut thisStore.*, &mut request.*, concrete, &mut record.*, recordRoot, previous, guard, inProcess,
    false, &mut sited)
}

// `replayEscapes`, finding a stale plain entry by its declaration when `plain`; sets `sited` when
// that left a report without the site the walk entered its body at. A replay that succeeds takes
// `record`, leaving an empty one.
pub effect fn replayEscapesWith(thisStore: &mut Semantic, request: &mut Request, concrete: &[DeclarationId], record: &mut BuildRecord.Record,
  recordRoot: usize, previous: &[CapturedEntry], guard: usize, inProcess: bool, plain: bool, sited: &mut bool) -> Option<EscapeReplay>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // A walk follows the one definition every region pattern of an application shares, so its
  // record names what it reached by that; every digest below is `definitionDigest`.
  if record.observing || record.patterns { return Option<EscapeReplay>.none() }
  let mut result = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
    unchecked: List<UncheckedDeclaration>.make()}
  let recordedRoots = List<ContentHash>.asSlice(&record.roots)
  let entries = List<BuildRecord.Entry>.asSlice(&record.entries)
  if inProcess && previous.length != entries.length { return Option<EscapeReplay>.none() }
  // An entered entry whose MIR is not green is stale; it needs its key, and so does every entry
  // its parent path passes through, and a foreign leaf a stale parent reaches, which must still be
  // foreign.
  let mut stale = List<bool>.make()
  let mut needed = List<bool>.make()
  let mut mirs = List<usize>.make()
  let mut rested = List<CapturedEntry>.make()
  // Whether the walk no longer enters an entry, because it or an entry its parent path passes
  // through now lowers to nothing or starts no walk; and where the walk entered each entry found.
  let mut pruned = List<bool>.make()
  let mut sites = List<Option<EntrySite>>.make()
  let mut keys = List<Option<InstanceKey>>.make()
  let mut referrers = RecordReferrers {built: false, starts: List<usize>.make(), from: List<usize>.make(),
    positions: List<usize>.make()}
  // The entry of each recorded root: its own, or the one the walk reached it as first, before
  // the root's turn came.
  let mut rootSet = DigestSet.make()
  let mut rootEntries = List<usize>.make()
  let mut at = usize.ZERO
  while at < recordedRoots.length {
    if !run DigestSet.add(&mut rootSet, recordedRoots[at]) { return Option<EscapeReplay>.none() }
    run List<usize>.append(&mut rootEntries, usize.MAX)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < entries.length {
    let mut held = usize.MAX
    let mut keptUnit = usize.MAX
    let mut green = false
    if entries[at].leaf == 0 {
      if inProcess {
        keptUnit = previous[at].mirUnit
        green = keptUnit != usize.MAX && run unitCurrent(&mut thisStore.*, keptUnit)
        if !green { keptUnit = usize.MAX }
      } else {
        held = EscapeImage.entryRoot(&thisStore.escapeImage, entries[at].exact)
        green = held != usize.MAX
      }
      let mut root = DigestSet.find(&rootSet, entries[at].exact)
      if entries[at].parent == usize.MAX { root = entries[at].position }
      if root < recordedRoots.length && List<usize>.get(&rootEntries, root) == usize.MAX { List<usize>.set(&mut rootEntries, root, at) }
    }
    let outdated = entries[at].leaf == 0 && !green
    run List<bool>.append(&mut stale, outdated)
    run List<bool>.append(&mut needed, outdated)
    run List<usize>.append(&mut mirs, usize.MAX)
    run List<CapturedEntry>.append(&mut rested, CapturedEntry {value: usize.MAX, mirUnit: keptUnit, emissionUnit: usize.MAX, frameUnit: usize.MAX, carried: held})
    run List<bool>.append(&mut pruned, false)
    run List<Option<EntrySite>>.append(&mut sites, Option<EntrySite>.none())
    run List<Option<InstanceKey>>.append(&mut keys, Option<InstanceKey>.none())
    at = at + usize.ONE
  }
  // The roots are the concrete bodies that start a walk, in their order; any other one must
  // still start none. A stale root is lowered again, as `capturedEscapes` lowers every concrete
  // body first, and one that no longer starts the walk, or is no longer concrete, is left out. A
  // stale root the walk reached as an entry first is lowered as a root as well; if it still
  // starts, that entry must still be entered.
  let mut roots = List<Option<InstanceKey>>.make()
  let mut restarted = List<usize>.make()
  at = usize.ZERO
  while at < concrete.length {
    let identity = run Types.internDeclaration(DeclarationId.copy(&concrete[at]))
    let instance = run InstanceKey.named(&identity)
    let exact = run definitionDigest(&instance)
    let mut matched = List<Option<InstanceKey>>.length(&roots)
    while matched < recordedRoots.length && !ContentHash.equals(exact, recordedRoots[matched]) {
      matched = matched + usize.ONE
    }
    if matched < recordedRoots.length {
      let entry = List<usize>.get(&rootEntries, matched)
      if entry == usize.MAX { return Option<EscapeReplay>.none() }
      let mut starts = true
      if List<bool>.get(&stale, entry) {
        let reported = List<Shared<Rejection>>.length(&result.rejections) + List<Shared<BackendGap>>.length(&result.gaps)
        starts = run replayRoot(&mut thisStore.*, &mut request.*, &concrete[at], &mut result)
        let reports = List<Shared<Rejection>>.length(&result.rejections) + List<Shared<BackendGap>>.length(&result.gaps) != reported
        if starts && reports { return Option<EscapeReplay>.none() }
        if starts && entries[entry].parent != usize.MAX { run List<usize>.append(&mut restarted, entry) }
      }
      while List<Option<InstanceKey>>.length(&roots) < matched { run List<Option<InstanceKey>>.append(&mut roots, Option<InstanceKey>.none()) }
      if starts || entries[entry].parent != usize.MAX {
        run List<Option<InstanceKey>>.append(&mut roots, Option<InstanceKey>.some(move instance))
      } else {
        run List<Option<InstanceKey>>.append(&mut roots, Option<InstanceKey>.none())
      }
    } else if run replayRoot(&mut thisStore.*, &mut request.*, &concrete[at], &mut result) {
      return Option<EscapeReplay>.none()
    }
    at = at + usize.ONE
  }
  while List<Option<InstanceKey>>.length(&roots) < recordedRoots.length { run List<Option<InstanceKey>>.append(&mut roots, Option<InstanceKey>.none()) }
  let mut entryRoots = List<usize>.make()
  while List<usize>.length(&entryRoots) < entries.length { run List<usize>.append(&mut entryRoots, usize.MAX) }
  at = usize.ZERO
  while at < recordedRoots.length {
    let entry = List<usize>.get(&rootEntries, at)
    if entry < entries.length { List<usize>.set(&mut entryRoots, entry, at) }
    at = at + usize.ONE
  }
  at = entries.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let parent = entries[at].parent
    if entries[at].leaf == BuildRecord.FOREIGN && parent != usize.MAX && List<bool>.get(&stale, parent) {
      List<bool>.set(&mut needed, at, true)
    }
    if List<bool>.get(&needed, at) && parent != usize.MAX {
      let mut keyed = false
      if plain && entries[at].leaf == 0 {
        if let Option<InstanceKey>.Some {value} = move run plainWalkKey(&entries[at]) {
          List<Option<InstanceKey>>.set(&mut keys, at, Option<InstanceKey>.some(move value))
          keyed = true
        }
      }
      if !keyed { List<bool>.set(&mut needed, parent, true) }
    }
  }
  at = usize.ZERO
  while at < entries.length {
    let entry = &entries[at]
    let index = at
    at = at + usize.ONE
    // An entry is listed after its parent, so a pruned parent is known by now.
    if entry.parent == usize.MAX {
      if entry.position >= recordedRoots.length { return Option<EscapeReplay>.none() }
      if let Option<InstanceKey>.None = &List<Option<InstanceKey>>.asSlice(&roots)[entry.position] {
        List<bool>.set(&mut pruned, index, true)
        continue
      }
    } else if List<bool>.get(&pruned, entry.parent) {
      List<bool>.set(&mut pruned, index, true)
      // A foreign leaf of a pruned body is not reached through it. Any other needed entry may
      // still be reached by another path, so it is lowered through another body that names it
      // and must summarize as it did, as when an edit broke one caller of a changed function.
      if List<bool>.get(&needed, index) && entry.leaf != BuildRecord.FOREIGN {
        let held = List<Option<InstanceKey>>.asSlice(&roots)
        if !run replayOrphan(&mut thisStore.*, entries, held, List<usize>.asSlice(&entryRoots), index,
          List<bool>.asSlice(&stale), &mut mirs, &mut rested, &mut referrers) {
          return Option<EscapeReplay>.none()
        }
      }
      continue
    }
    if !List<bool>.get(&needed, index) { continue }
    let mut found = Option<InstanceKey>.none()
    let mut parentMir = usize.MAX
    if entry.parent == usize.MAX {
      if let Option<InstanceKey>.Some {value: root} = &List<Option<InstanceKey>>.asSlice(&roots)[entry.position] {
        found = Option<InstanceKey>.some(InstanceKey.copy(&root))
      }
    } else if let Option<InstanceKey>.Some {value: own} = &List<Option<InstanceKey>>.asSlice(&keys)[index] {
      found = Option<InstanceKey>.some(InstanceKey.copy(&own))
      parentMir = List<usize>.get(&mirs, entry.parent)
    } else {
      parentMir = List<usize>.get(&mirs, entry.parent)
      if parentMir == usize.MAX { return Option<EscapeReplay>.none() }
      let functions = List<MirFunction>.asSlice(&thisStore.resolver.mirValues)
      let references = List<MirReference>.asSlice(&functions[parentMir].references)
      if entry.position >= references.length { return Option<EscapeReplay>.none() }
      found = Option<InstanceKey>.some(InstanceKey.copy(&references[entry.position].key))
    }
    let instance = match move found {
      Option<InstanceKey>.Some {value} => move value
      Option<InstanceKey>.None => { return Option<EscapeReplay>.none() }
    }
    let exact = run definitionDigest(&instance)
    if !ContentHash.equals(exact, entry.exact) { return Option<EscapeReplay>.none() }
    let foreign = run foreignDeclaration(&mut thisStore.resolver, &instance)
    if entry.leaf == BuildRecord.FOREIGN {
      if !foreign { return Option<EscapeReplay>.none() }
      continue
    }
    if foreign || entry.leaf != 0 { return Option<EscapeReplay>.none() }
    let declaration = DeclarationId.copyShared(&InstanceKey.identity(&instance))
    // A root is entered from its own module with no requester; an entry, from its parent's
    // body at the reference that names it, as `capturedEscapes` enters it.
    let module = ModuleId.copy(DeclarationId.moduleId(&declaration))
    let mut site = EntrySite {module: ModuleId.copy(&module), entered: ModuleId.copy(&module), span: Span.make(usize.ZERO, usize.ZERO),
      requester: Option<RelatedSite>.none(), anchor: Option<Anchor>.none()}
    // An entry found without its parent's MIR, or below one, has no site until a replay through
    // parents finds it.
    let mut placed = true
    if entry.parent == usize.MAX {
      site.span = run authoredRequestSpan(&mut thisStore.resolver, &declaration, Span.make(usize.ZERO, usize.ZERO))
    } else if parentMir == usize.MAX {
      placed = false
    } else {
      let mut reached = false
      if let Option<EntrySite>.Some {value: from} = &List<Option<EntrySite>>.asSlice(&sites)[entry.parent] {
        let functions = List<MirFunction>.asSlice(&thisStore.resolver.mirValues)
        let references = List<MirReference>.asSlice(&functions[parentMir].references)
        site.entered = ModuleId.copy(&from.module)
        site.span = anchoredSpan(&from.anchor, references[entry.position].origin)
        site.requester = successorRequester(&from.requester, &from.entered, from.span, &from.module)
        reached = true
      }
      if !reached {
        if !plain { return Option<EscapeReplay>.none() }
        placed = false
      }
    }
    site.anchor = run instanceAnchor(&mut thisStore.resolver, &instance)
    let lowered = match move run escapeReplayMir(&mut thisStore.*, &instance) {
      Option<ReplayMir>.Some {value} => value
      Option<ReplayMir>.None => {
        if !placed {
          sited.* = true
          return Option<EscapeReplay>.none()
        }
        if entry.parent == usize.MAX || !run replayBroken(&mut thisStore.*, &instance, &site, &mut result) {
          return Option<EscapeReplay>.none()
        }
        List<bool>.set(&mut pruned, index, true)
        continue
      }
    }
    List<usize>.set(&mut mirs, index, lowered.mir)
    if placed { List<Option<EntrySite>>.set(&mut sites, index, Option<EntrySite>.some(move site)) }
    if List<bool>.get(&stale, index) {
      if !run replayAgrees(&mut thisStore.*, &instance, lowered.mir, entries, index, false, Span.make(usize.ZERO, usize.ZERO)) {
        return Option<EscapeReplay>.none()
      }
      List<CapturedEntry>.set(&mut rested, index, CapturedEntry {value: usize.MAX, mirUnit: lowered.mirUnit, emissionUnit: usize.MAX, frameUnit: usize.MAX,
        carried: usize.MAX})
    }
  }
  at = usize.ZERO
  while at < List<usize>.length(&restarted) {
    // A restarted root under a pruned body is entered at its turn: `replayOrphan` lowered it.
    let entry = List<usize>.get(&restarted, at)
    if List<bool>.get(&pruned, entry) && List<usize>.get(&mirs, entry) == usize.MAX { return Option<EscapeReplay>.none() }
    at = at + usize.ONE
  }
  // The check this replay makes current has no root in the image read (`imageReplayedChecks`).
  thisStore.freshEscapes = true
  let taken = Intrinsic.replace(record.*, BuildRecord.make(false, false))
  return Option<EscapeReplay>.some(EscapeReplay {captured: CapturedBuild {record: move taken, entries: move rested, guard: guard,
    carriedRecord: recordRoot}, result: move result})
}

// Walks an escape check again as `capturedEscapes` would, from the record of its last walk, when
// an edit changed what the walk reaches, as `rewalkBuild` walks a build again. Every green entry's
// references, admission facts and summary are read from the record (`BuildRecord.Facts`), and
// only the bodies whose MIR is stale, and the ones the walk now reaches first, are lowered, so the
// walk visits instances in the order a cold walk would and records what it would record.
//
// What the walk leaves to another module's check, and what is foreign, is read from the record
// where a green body reaches it, and found again where a lowered one does. The bodies callbacks
// reach are taken from the left ones as `belowCallbacks` takes them, from each summary's direct
// callees, and the local-shared escape check follows the same callees from each callback
// (`localSharedEscapes`), so the walk ends where a cold one would.
//
// An admission is taken from the record where the record's walk decided the same edge from the
// same admission path and cleanup root (`escapeDecision`), so a body the edit makes the walk
// reach earlier keeps the record's decisions below it while the applications above it are the
// same. Any other is decided by `rewalkAdmits`, or, where only the applications can decide it,
// by `Admission` itself from keys found again along the path (`rewalkDecide`).
//
// Gives none whenever a cold walk could find anything, or decide what this one cannot: a body
// that reports or lowers to nothing, an admission that is not a plain entry or reuse, an escape
// a callback reaches, a record resting on growth guards. The check then walks.
pub effect fn rewalkEscapes(thisStore: &mut Semantic, request: &mut Request, concrete: &[DeclarationId], boundary: &WalkBoundary,
  record: &BuildRecord.Record, previous: &[CapturedEntry], inProcess: bool) -> Option<EscapeReplay>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if record.observing || record.patterns || record.guarded { return Option<EscapeReplay>.none() }
  let entries = List<BuildRecord.Entry>.asSlice(&record.entries)
  if inProcess && previous.length != entries.length { return Option<EscapeReplay>.none() }
  // Every entry by its digest and by the edge that reached it, the entry that entered each
  // instance, and which of those the walk can take as they are.
  let mut anyLookup = InternIndex.make()
  let mut edgeLookup = InternIndex.make()
  let mut enteredLookup = InternIndex.make()
  // The foreign leaves alone: a popular instance's entries would make every miss walk them all.
  let mut foreignLookup = InternIndex.make()
  let mut foreignAt = List<usize>.make()
  let mut entered = List<usize>.make()
  let mut green = List<bool>.make()
  let mut carried = List<usize>.make()
  let reusable = BuildRecord.FACT_SUMMARIZED + BuildRecord.FACT_CALLEES
  let mut at = usize.ZERO
  while at < entries.length {
    let flags = entries[at].facts.flags
    if u64.bitAnd(flags, BuildRecord.FACT_KNOWN) == 0 { return Option<EscapeReplay>.none() }
    let exact = entries[at].exact
    run InternIndex.record(&mut anyLookup, digestHash(exact))
    run InternIndex.record(&mut edgeLookup, escapeEdgeHash(entries[at].parent, entries[at].position))
    if entries[at].leaf == BuildRecord.FOREIGN {
      run InternIndex.record(&mut foreignLookup, digestHash(exact))
      run List<usize>.append(&mut foreignAt, at)
    }
    let mut held = false
    let mut root = usize.MAX
    if entries[at].leaf == 0 {
      run InternIndex.record(&mut enteredLookup, digestHash(exact))
      run List<usize>.append(&mut entered, at)
      if inProcess {
        let unit = previous[at].mirUnit
        held = unit != usize.MAX && run unitCurrent(&mut thisStore.*, unit)
      } else {
        root = EscapeImage.entryRoot(&thisStore.escapeImage, exact)
        held = root != usize.MAX
      }
      if u64.bitAnd(flags, reusable) != reusable { held = false }
    }
    run List<bool>.append(&mut green, held)
    run List<usize>.append(&mut carried, root)
    at = at + usize.ONE
  }
  let enteredAt = List<usize>.asSlice(&entered)
  let held = List<bool>.asSlice(&green)
  // The admission path each entered entry's references were decided on and the cleanup root
  // they inherit, and every decision the record's walk made: an edge it followed from a body,
  // from that body's path, and a left edge it followed again, from no path.
  let none = ContentHash {high: 0, low: 0}
  let rootEdge = none
  let mut decided = DigestSet.make()
  let mut paths = List<ContentHash>.make()
  let mut cleanups = List<ContentHash>.make()
  at = usize.ZERO
  while at < entries.length {
    let mut path = none
    let mut cleanup = none
    if entries[at].leaf == 0 {
      let parent = entries[at].parent
      let mut pathIn = none
      let mut cleanupIn = none
      let mut edgeIn = rootEdge
      if parent != usize.MAX {
        if parent >= at || entries[at].position >= List<BuildRecord.Reference>.length(&entries[parent].references) {
          return Option<EscapeReplay>.none()
        }
        if escapeEdge(entries, &edgeLookup, parent, entries[at].position) != ESCAPE_AGAIN { pathIn = List<ContentHash>.get(&paths, parent) }
        cleanupIn = List<ContentHash>.get(&cleanups, parent)
        edgeIn = List<BuildRecord.Reference>.asSlice(&entries[parent].references)[entries[at].position].edge
      }
      let flags = entries[at].facts.flags
      path = escapePath(pathIn, cleanupIn, entries[at].exact, edgeIn, flags)
      cleanup = escapeCleanup(cleanupIn, entries[at].exact, flags)
      let references = List<BuildRecord.Reference>.asSlice(&entries[at].references)
      let mut reference = usize.ZERO
      while reference < references.length {
        let status = escapeEdge(entries, &edgeLookup, at, reference)
        let target = entries[references[reference].target].exact
        let edge = references[reference].edge
        if status == ESCAPE_DECIDED {
          drop run DigestSet.add(&mut decided, escapeDecision(path, cleanup, target, edge))
        } else if status == ESCAPE_AGAIN {
          drop run DigestSet.add(&mut decided, escapeDecision(none, cleanup, target, edge))
        }
        reference = reference + usize.ONE
      }
    }
    run List<ContentHash>.append(&mut paths, path)
    run List<ContentHash>.append(&mut cleanups, cleanup)
    at = at + usize.ONE
  }
  // The roots start the walk as `capturedEscapes` starts it: each concrete body that lowers to
  // MIR, in order, popped last first. A green root the record started the same way is taken as
  // it is; any other is lowered again, and must report nothing.
  let recordedRoots = List<ContentHash>.asSlice(&record.roots)
  at = usize.ZERO
  while at < recordedRoots.length {
    drop run DigestSet.add(&mut decided, escapeDecision(none, none, recordedRoots[at], rootEdge))
    at = at + usize.ONE
  }
  let mut started = List<ContentHash>.make()
  let mut pending = List<EscapeVisit>.make()
  at = usize.ZERO
  while at < concrete.length {
    let identity = run Types.internDeclaration(DeclarationId.copy(&concrete[at]))
    let instance = run InstanceKey.named(&identity)
    let exact = run definitionDigest(&instance)
    let position = List<ContentHash>.length(&started)
    let entry = escapeEntered(entries, enteredAt, &enteredLookup, exact)
    // A green root the record's walk entered as this root starts it again.
    let mut starts = position < recordedRoots.length && ContentHash.equals(exact, recordedRoots[position])
      && entry != usize.MAX && entries[entry].parent == usize.MAX && entries[entry].position == position && held[entry]
    if !starts {
      let mut reported = DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(), gaps: List<Shared<BackendGap>>.make(),
        unchecked: List<UncheckedDeclaration>.make()}
      starts = run replayRoot(&mut thisStore.*, &mut request.*, &concrete[at], &mut reported)
      if List<Shared<Rejection>>.length(&reported.rejections) > usize.ZERO || List<Shared<BackendGap>>.length(&reported.gaps) > usize.ZERO {
        return Option<EscapeReplay>.none()
      }
    }
    if starts {
      run List<ContentHash>.append(&mut started, exact)
      run List<EscapeVisit>.append(&mut pending, EscapeVisit {leave: false, entry: entry, key: Option<InstanceKey>.some(move instance),
        exact: exact, parent: usize.MAX, position: position, path: none, cleanup: none, cleanupNode: usize.MAX,
        edge: rootEdge})
    }
    at = at + usize.ONE
  }
  let mut nodes = List<EscapeNode>.make()
  // The entered nodes in order, which are the walk's summaries, by digest.
  let mut summarized = List<usize>.make()
  let mut visitedLookup = InternIndex.make()
  let mut frames = List<RewalkFrame>.make()
  let mut left = List<EscapeVisit>.make()
  let mut foreign = ForeignDeclarations {seen: List<ForeignDeclaration>.make(), lookup: InternIndex.make()}
  let mut bounded = true
  let mut checked = false
  while true {
    if List<EscapeVisit>.length(&pending) == usize.ZERO {
      let walkedNodes = List<EscapeNode>.asSlice(&nodes)
      let summaries = List<usize>.asSlice(&summarized)
      if List<EscapeVisit>.length(&left) == usize.ZERO || !escapeAccesses(walkedNodes, summaries) { break }
      pending = run escapeBelowCallbacks(walkedNodes, summaries, &visitedLookup, &mut left)
      if List<EscapeVisit>.length(&pending) == usize.ZERO {
        if run escapeFound(walkedNodes, summaries, &visitedLookup) { return Option<EscapeReplay>.none() }
        checked = true
        break
      }
      bounded = false
    }
    let visit = match move List<EscapeVisit>.pop(&mut pending) {
      Option<EscapeVisit>.Some {value} => move value
      Option<EscapeVisit>.None => { break }
    }
    let EscapeVisit {leave, entry, key: reachedKey, exact: reachedExact, parent, position, path, cleanup, cleanupNode, edge} = move visit
    if leave {
      drop List<RewalkFrame>.pop(&mut frames)
      continue
    }
    // Any entry of the instance holds its declaration and the facts its key gives.
    let any = rewalkEntry(entries, &anyLookup, reachedExact)
    let mut isForeign = false
    let mut elsewhere = false
    if let Option<InstanceKey>.Some {value: known} = &reachedKey {
      isForeign = run walkedForeign(&mut thisStore.resolver, &mut foreign, &known)
      if !isForeign && bounded { elsewhere = run walkedElsewhere(boundary, &known) }
    } else {
      if any == usize.MAX { return Option<EscapeReplay>.none() }
      isForeign = escapeForeign(entries, &foreignLookup, List<usize>.asSlice(&foreignAt), reachedExact)
      if !isForeign && bounded { elsewhere = u64.bitAnd(entries[any].facts.flags, BuildRecord.FACT_ELSEWHERE) != 0 }
    }
    let mut facts = BuildRecord.unknownFacts()
    if entry != usize.MAX {
      facts = run BuildRecord.copyFacts(&entries[entry].facts)
    } else if any != usize.MAX {
      facts = run BuildRecord.copyFacts(&entries[any].facts)
    } else if let Option<InstanceKey>.Some {value: known} = &reachedKey {
      facts = run keyFacts(&known)
    } else {
      return Option<EscapeReplay>.none()
    }
    if isForeign || elsewhere {
      let mut leaf = BuildRecord.FOREIGN
      let mut kept = run aliasFacts(&facts)
      if !isForeign {
        leaf = BuildRecord.LEFT
        kept.flags = u64.bitOr(kept.flags, BuildRecord.FACT_ELSEWHERE)
      }
      let mut leafKey = Option<InstanceKey>.none()
      if let Option<InstanceKey>.Some {value: known} = &reachedKey { leafKey = Option<InstanceKey>.some(InstanceKey.copy(&known)) }
      run List<EscapeNode>.append(&mut nodes, EscapeNode {entry: any, key: move leafKey, exact: reachedExact,
        parent: parent, position: position, leaf: leaf, live: false, facts: move kept, targets: List<ContentHash>.make(),
        edges: List<ContentHash>.make(), callees: List<ContentHash>.make(), callbacks: List<ContentHash>.make(), summary: ContentHash {high: 0, low: 0},
        captured: CapturedEntry {value: usize.MAX, mirUnit: usize.MAX, emissionUnit: usize.MAX, frameUnit: usize.MAX, carried: usize.MAX}, mir: usize.MAX,
        cleanupNode: cleanupNode})
      if !isForeign {
        run List<EscapeVisit>.append(&mut left, EscapeVisit {leave: false, entry: entry, key: move reachedKey, exact: reachedExact,
          parent: parent, position: position, path: path, cleanup: cleanup, cleanupNode: cleanupNode, edge: edge})
      }
      continue
    }
    let ordinal = escapeOrdinal(List<EscapeNode>.asSlice(&nodes), List<usize>.asSlice(&summarized), &visitedLookup, reachedExact)
    let mut visited = usize.MAX
    if ordinal != usize.MAX { visited = List<usize>.get(&summarized, ordinal) }
    let mut admitted = false
    if u64.bitAnd(facts.flags, BuildRecord.FACT_APPLICATION) != 0 {
      if DigestSet.find(&decided, escapeDecision(path, cleanup, reachedExact, edge)) != usize.MAX {
        // Only an entered application is reached for the first time: a reused one is on the
        // path, and the record holds no other decision (`record.guarded`).
        admitted = visited == usize.MAX
      } else {
        if entry == usize.MAX {
          let closed = match &reachedKey {
            Option<InstanceKey>.Some {value: known} => run rewalkClosed(&known)
            Option<InstanceKey>.None => false
          }
          if !closed { return Option<EscapeReplay>.none() }
        }
        let mut decision = rewalkAdmits(List<RewalkFrame>.asSlice(&frames), facts.body, visited)
        if decision == REWALK_REFUSED {
          decision = run rewalkDecide(&mut thisStore.*, entries, &mut nodes, List<RewalkFrame>.asSlice(&frames), parent, position,
            reachedExact, cleanupNode)
        }
        if decision == REWALK_REFUSED { return Option<EscapeReplay>.none() }
        admitted = decision == REWALK_ENTERED
      }
    }
    if visited != usize.MAX { continue }
    // The path and cleanup root this body's references are decided on.
    let pathOut = escapePath(path, cleanup, reachedExact, edge, facts.flags)
    let cleanupOut = escapeCleanup(cleanup, reachedExact, facts.flags)
    let node = List<EscapeNode>.length(&nodes)
    let mut cleanupOutNode = cleanupNode
    if cleanupOutNode == usize.MAX && u64.bitAnd(facts.flags, BuildRecord.FACT_GLUE) != 0 { cleanupOutNode = node }
    if admitted {
      run List<RewalkFrame>.append(&mut frames, RewalkFrame {node: node, body: facts.body,
        free: u64.bitAnd(facts.flags, BuildRecord.FACT_ARGUMENT_FREE) != 0})
      run List<EscapeVisit>.append(&mut pending, EscapeVisit {leave: true, entry: usize.MAX, key: Option<InstanceKey>.none(),
        exact: none, parent: usize.MAX, position: usize.ZERO, path: none, cleanup: none, cleanupNode: usize.MAX, edge: none})
    }
    run InternIndex.record(&mut visitedLookup, digestHash(reachedExact))
    run List<usize>.append(&mut summarized, node)
    if entry != usize.MAX && held[entry] {
      // The MIR reads as the record says: its references, callees and callbacks are the entry's.
      let references = List<BuildRecord.Reference>.asSlice(&entries[entry].references)
      let mut callees = List<ContentHash>.make()
      let positions = List<usize>.asSlice(&entries[entry].facts.callees)
      let mut callee = usize.ZERO
      while callee < positions.length {
        if positions[callee] >= references.length { return Option<EscapeReplay>.none() }
        run List<ContentHash>.append(&mut callees, entries[references[positions[callee]].target].exact)
        callee = callee + usize.ONE
      }
      let callbacks = run escapeCallbacks(&facts)
      let mut captured = CapturedEntry {value: usize.MAX, mirUnit: usize.MAX, emissionUnit: usize.MAX, frameUnit: usize.MAX, carried: List<usize>.get(&carried, entry)}
      if inProcess { captured.mirUnit = previous[entry].mirUnit }
      run List<EscapeNode>.append(&mut nodes, EscapeNode {entry: entry, key: move reachedKey, exact: reachedExact, parent: parent,
        position: position, leaf: 0, live: false, facts: move facts, targets: List<ContentHash>.make(), edges: List<ContentHash>.make(),
        callees: move callees, callbacks: move callbacks, summary: entries[entry].summary, captured: captured, mir: usize.MAX,
        cleanupNode: cleanupNode})
      let mut reference = references.length
      while reference > usize.ZERO {
        reference = reference - usize.ONE
        let target = entries[references[reference].target].exact
        run List<EscapeVisit>.append(&mut pending, EscapeVisit {leave: false, entry: escapeEntered(entries, enteredAt, &enteredLookup, target),
          key: Option<InstanceKey>.none(), exact: target, parent: node, position: reference, path: pathOut,
          cleanup: cleanupOut, cleanupNode: cleanupOutNode, edge: references[reference].edge})
      }
      continue
    }
    // Lowered again here: a stale entry, or an instance the record never entered. Its key is the
    // plain instance its entry names, or the reference the body above it names.
    let mut key = move reachedKey
    if let Option<InstanceKey>.None = &key {
      if entry != usize.MAX { key = run plainWalkKey(&entries[entry]) }
    }
    if let Option<InstanceKey>.None = &key {
      if parent == usize.MAX { return Option<EscapeReplay>.none() }
      if let Option<InstanceKey>.None = move run rewalkNodeKey(&mut thisStore.*, entries, &mut nodes, parent) {
        return Option<EscapeReplay>.none()
      }
      if let Option<EscapeReference>.Some {value} = move run rewalkReference(&mut thisStore.*, &mut nodes, parent, position,
        reachedExact) {
        key = Option<InstanceKey>.some(move value.key)
      }
    }
    let instance = match move key {
      Option<InstanceKey>.Some {value} => move value
      Option<InstanceKey>.None => { return Option<EscapeReplay>.none() }
    }
    let lowered = match move run escapeReplayMir(&mut thisStore.*, &instance) {
      Option<ReplayMir>.Some {value} => value
      Option<ReplayMir>.None => { return Option<EscapeReplay>.none() }
    }
    let anchor = run instanceAnchor(&mut thisStore.resolver, &instance)
    let identity = DeclarationId.copyShared(&InstanceKey.identity(&instance))
    let functions = List<MirFunction>.asSlice(&thisStore.resolver.mirValues)
    let declared = DeclarationId.moduleId(&identity)
    let summary = run SuspensionSummary.make(&functions[lowered.mir], &instance, declared, &anchor, declared, Span.make(usize.ZERO, usize.ZERO))
    let digest = run summaryDigest(&summary, functions[lowered.mir].observes, false)
    let mut fresh = run keyFacts(&instance)
    if run walkedElsewhere(boundary, &instance) { fresh.flags = u64.bitOr(fresh.flags, BuildRecord.FACT_ELSEWHERE) }
    run summaryFacts(&mut fresh, &summary, false)
    if thisStore.resolver.closedErasures { run recordErasedFacts(&mut fresh, &functions[lowered.mir], currentErasures(&thisStore.resolver)) }
    let references = List<MirReference>.asSlice(&functions[lowered.mir].references)
    let mut targets = List<ContentHash>.make()
    let mut edges = List<ContentHash>.make()
    let mut reference = usize.ZERO
    while reference < references.length {
      run List<ContentHash>.append(&mut targets, run definitionDigest(&references[reference].key))
      run List<ContentHash>.append(&mut edges, recordDigest(Bytes.asSlice(&run Edge.recordBytes(&references[reference].edge, &identity))))
      reference = reference + usize.ONE
    }
    // Each direct call by its digest, and by the reference it names when every call names one.
    let named = List<ContentHash>.asSlice(&targets)
    let mut callees = List<ContentHash>.make()
    let mut positions = List<usize>.make()
    let mut complete = true
    let called = List<InstanceKey>.asSlice(&summary.callees)
    let mut callee = usize.ZERO
    while callee < called.length {
      let calleeExact = run definitionDigest(&called[callee])
      let mut found = usize.ZERO
      while found < named.length && !ContentHash.equals(named[found], calleeExact) { found = found + usize.ONE }
      if found == named.length { complete = false } else { run List<usize>.append(&mut positions, found) }
      run List<ContentHash>.append(&mut callees, calleeExact)
      callee = callee + usize.ONE
    }
    if complete {
      fresh.callees = move positions
      fresh.flags = u64.bitOr(fresh.flags, BuildRecord.FACT_CALLEES)
    }
    let callbacks = run escapeCallbacks(&fresh)
    reference = references.length
    while reference > usize.ZERO {
      reference = reference - usize.ONE
      let target = named[reference]
      run List<EscapeVisit>.append(&mut pending, EscapeVisit {leave: false, entry: escapeEntered(entries, enteredAt, &enteredLookup, target),
        key: Option<InstanceKey>.some(InstanceKey.copy(&references[reference].key)), exact: target, parent: node,
        position: reference, path: pathOut, cleanup: cleanupOut, cleanupNode: cleanupOutNode,
        edge: List<ContentHash>.asSlice(&edges)[reference]})
    }
    run List<EscapeNode>.append(&mut nodes, EscapeNode {entry: entry, key: Option<InstanceKey>.some(move instance), exact: reachedExact,
      parent: parent, position: position, leaf: 0, live: true, facts: move fresh, targets: move targets, edges: move edges,
      callees: move callees, callbacks: move callbacks, summary: digest,
      captured: CapturedEntry {value: usize.MAX, mirUnit: lowered.mirUnit, emissionUnit: usize.MAX, frameUnit: usize.MAX, carried: usize.MAX}, mir: lowered.mir,
      cleanupNode: cleanupNode})
  }
  if !checked && run escapeFound(List<EscapeNode>.asSlice(&nodes), List<usize>.asSlice(&summarized), &visitedLookup) {
    return Option<EscapeReplay>.none()
  }
  // The record of this walk, as `BuildCapture.finish` writes it: a reference names the first
  // entry of its target.
  let listed = List<EscapeNode>.asSlice(&nodes)
  let mut firstLookup = InternIndex.make()
  at = usize.ZERO
  while at < listed.length {
    run InternIndex.record(&mut firstLookup, digestHash(listed[at].exact))
    at = at + usize.ONE
  }
  let mut rewritten = BuildRecord.make(false, false)
  let mut rested = List<CapturedEntry>.make()
  at = usize.ZERO
  while at < listed.length {
    let walked = &listed[at]
    at = at + usize.ONE
    let mut entry = BuildRecord.Entry {exact: walked.exact, hash: 0, family: 0, declaration: Bytes.make(),
      parent: walked.parent, position: walked.position, requested: false, alias: usize.MAX, leaf: walked.leaf,
      references: List<BuildRecord.Reference>.make(), summary: walked.summary, facts: run BuildRecord.copyFacts(&walked.facts)}
    // The declaration names the region pattern that reached the entry, as `BuildCapture.enter`
    // writes it: the key a lowered body reached, or the one the record's entry for the same
    // edge of a green body named.
    let mut source = usize.MAX
    if walked.parent != usize.MAX && !listed[walked.parent].live {
      source = escapeAtEdge(entries, &edgeLookup, listed[walked.parent].entry, walked.position, walked.exact)
    } else if walked.parent == usize.MAX && walked.entry != usize.MAX && entries[walked.entry].parent == usize.MAX {
      source = walked.entry
    }
    if source == usize.MAX {
      if let Option<InstanceKey>.Some {value: instance} = &walked.key {
        entry.hash = InstanceKey.runtimeHash(&instance)
        entry.family = EmissionPlan.familyName(&instance)
        run StableKey.declaration(&mut entry.declaration, &DeclarationId.copyShared(&InstanceKey.identity(&instance)))
        run appendRecordedShape(&mut entry.declaration, &instance)
      } else {
        source = walked.entry
        if source == usize.MAX { source = rewalkEntry(entries, &anyLookup, walked.exact) }
        if source == usize.MAX { return Option<EscapeReplay>.none() }
      }
    }
    if source != usize.MAX {
      entry.hash = entries[source].hash
      entry.family = entries[source].family
      entry.declaration = run Bytes.copy(Bytes.asSlice(&entries[source].declaration))
    }
    if walked.leaf == 0 {
      if walked.live {
        let targets = List<ContentHash>.asSlice(&walked.targets)
        let edges = List<ContentHash>.asSlice(&walked.edges)
        let mut reference = usize.ZERO
        while reference < targets.length {
          let target = escapeFirst(listed, &firstLookup, targets[reference])
          if target == usize.MAX { return Option<EscapeReplay>.none() }
          run List<BuildRecord.Reference>.append(&mut entry.references, BuildRecord.Reference {target: target,
            edge: edges[reference]})
          reference = reference + usize.ONE
        }
      } else {
        let references = List<BuildRecord.Reference>.asSlice(&entries[walked.entry].references)
        let mut reference = usize.ZERO
        while reference < references.length {
          let target = escapeFirst(listed, &firstLookup, entries[references[reference].target].exact)
          if target == usize.MAX { return Option<EscapeReplay>.none() }
          run List<BuildRecord.Reference>.append(&mut entry.references, BuildRecord.Reference {target: target,
            edge: references[reference].edge})
          reference = reference + usize.ONE
        }
      }
    }
    run List<BuildRecord.Entry>.append(&mut rewritten.entries, move entry)
    run List<CapturedEntry>.append(&mut rested, walked.captured)
  }
  rewritten.roots = move started
  // The check this walk makes current has no root in the image read (`imageReplayedChecks`).
  thisStore.freshEscapes = true
  return Option<EscapeReplay>.some(EscapeReplay {captured: CapturedBuild {record: move rewritten, entries: move rested, guard: usize.MAX,
    carriedRecord: usize.MAX}, result: DeclarationCheckResult {rejections: List<Shared<Rejection>>.make(),
    gaps: List<Shared<BackendGap>>.make(), unchecked: List<UncheckedDeclaration>.make()}})
}

// Decides the admission of reference `position` of rewalk node `parent`, which names `exact`,
// as `capturedEscapes` decides it where `rewalkAdmits` cannot: the applications of the active
// `frames` and of the reached instance are found again through their keys (`rewalkNodeKey`),
// the frames entered into an `Admission`, and the instance admitted through `Admission.enter` and
// `admitOwnedDescent`, under the cleanup root `cleanupNode` names. Gives `REWALK_REFUSED` for
// any other decision, or when a key is not found.
pub effect fn rewalkDecide(thisStore: &mut Semantic, entries: &[BuildRecord.Entry], nodes: &mut List<EscapeNode>, frames: &[RewalkFrame],
  parent: usize, position: usize, exact: ContentHash, cleanupNode: usize) -> u64
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if parent == usize.MAX { return REWALK_REFUSED }
  let mut admission = Admission.make()
  let mut at = usize.ZERO
  while at < frames.length {
    let node = frames[at].node
    at = at + usize.ONE
    let key = match move run rewalkNodeKey(&mut thisStore.*, entries, &mut nodes.*, node) {
      Option<InstanceKey>.Some {value} => move value
      Option<InstanceKey>.None => { return REWALK_REFUSED }
    }
    let listed = List<EscapeNode>.asSlice(&nodes.*)
    let mut edge = Edge.Direct
    if listed[node].parent != usize.MAX {
      let above = listed[node].parent
      let place = listed[node].position
      let named = listed[node].exact
      let root = listed[node].cleanupNode
      edge = match move run rewalkEdge(&mut thisStore.*, entries, &mut nodes.*, above, place, named, root) {
        Option<Edge>.Some {value} => move value
        Option<Edge>.None => { return REWALK_REFUSED }
      }
    }
    run Admission.enterChain(&mut admission, &run InstanceKey.selected(&key), move edge)
  }
  if let Option<InstanceKey>.None = move run rewalkNodeKey(&mut thisStore.*, entries, &mut nodes.*, parent) { return REWALK_REFUSED }
  let reached = match move run rewalkReference(&mut thisStore.*, &mut nodes.*, parent, position, exact) {
    Option<EscapeReference>.Some {value} => move value
    Option<EscapeReference>.None => { return REWALK_REFUSED }
  }
  let edge = match move run rewalkEdge(&mut thisStore.*, entries, &mut nodes.*, parent, position, exact, cleanupNode) {
    Option<Edge>.Some {value} => move value
    Option<Edge>.None => { return REWALK_REFUSED }
  }
  if !run rewalkClosed(&reached.key) { return REWALK_REFUSED }
  let application = run InstanceKey.selected(&reached.key)
  let refused = run Admission.enter(&mut admission, &application, Edge.copy(&edge))
  let decision = run admitOwnedDescent(&mut thisStore.resolver, &mut thisStore.query, &mut admission, &application, &edge, move refused)
  return match &decision {
    Decision.Entered => REWALK_ENTERED
    Decision.Reused {..} => REWALK_REUSED
    _ => REWALK_REFUSED
  }
}

// The key of rewalk node `node`: the one a lowered body reached it by, or the plain instance its
// record entry names, or else the reference its parent's MIR names at its position, found the
// same way up the walk's path (`rewalkReference`). None when a body on the way no longer names
// the instance the walk reached.
pub effect fn rewalkNodeKey(thisStore: &mut Semantic, entries: &[BuildRecord.Entry], nodes: &mut List<EscapeNode>, node: usize) -> Option<InstanceKey>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // The nodes from `node` up to the first whose key is known, nearest first.
  let mut chain = List<usize>.make()
  let mut at = node
  while true {
    let listed = List<EscapeNode>.asSlice(&nodes.*)
    if let Option<InstanceKey>.Some {..} = &listed[at].key { break }
    let entry = listed[at].entry
    if entry != usize.MAX {
      if let Option<InstanceKey>.Some {value} = move run plainWalkKey(&entries[entry]) {
        let slots = List<EscapeNode>.asMutSlice(&mut nodes.*)
        slots[at].key = Option<InstanceKey>.some(move value)
        break
      }
    }
    if listed[at].parent == usize.MAX { return Option<InstanceKey>.none() }
    run List<usize>.append(&mut chain, at)
    at = listed[at].parent
  }
  while List<usize>.length(&chain) > usize.ZERO {
    let child = match move List<usize>.pop(&mut chain) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { break }
    }
    let listed = List<EscapeNode>.asSlice(&nodes.*)
    let parent = listed[child].parent
    let position = listed[child].position
    let named = listed[child].exact
    let reached = match move run rewalkReference(&mut thisStore.*, &mut nodes.*, parent, position, named) {
      Option<EscapeReference>.Some {value} => move value
      Option<EscapeReference>.None => { return Option<InstanceKey>.none() }
    }
    let slots = List<EscapeNode>.asMutSlice(&mut nodes.*)
    slots[child].key = Option<InstanceKey>.some(move reached.key)
  }
  return match &List<EscapeNode>.asSlice(&nodes.*)[node].key {
    Option<InstanceKey>.Some {value} => Option<InstanceKey>.some(InstanceKey.copy(&value))
    Option<InstanceKey>.None => Option<InstanceKey>.none()
  }
}

// The key and edge reference `position` of rewalk node `parent`'s MIR names, when the key's
// digest is `exact`. The parent's key is known; its MIR is lowered once.
pub effect fn rewalkReference(thisStore: &mut Semantic, nodes: &mut List<EscapeNode>, parent: usize, position: usize, exact: ContentHash)
  -> Option<EscapeReference>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut mir = List<EscapeNode>.asSlice(&nodes.*)[parent].mir
  if mir == usize.MAX {
    let owner = match &List<EscapeNode>.asSlice(&nodes.*)[parent].key {
      Option<InstanceKey>.Some {value} => InstanceKey.copy(&value)
      Option<InstanceKey>.None => { return Option<EscapeReference>.none() }
    }
    mir = match move run escapeReplayMir(&mut thisStore.*, &owner) {
      Option<ReplayMir>.Some {value} => value.mir
      Option<ReplayMir>.None => { return Option<EscapeReference>.none() }
    }
    let slots = List<EscapeNode>.asMutSlice(&mut nodes.*)
    slots[parent].mir = mir
  }
  let functions = List<MirFunction>.asSlice(&thisStore.resolver.mirValues)
  let references = List<MirReference>.asSlice(&functions[mir].references)
  if position >= references.length { return Option<EscapeReference>.none() }
  if !ContentHash.equals(run definitionDigest(&references[position].key), exact) { return Option<EscapeReference>.none() }
  return Option<EscapeReference>.some(EscapeReference {key: InstanceKey.copy(&references[position].key),
    edge: Edge.copy(&references[position].edge)})
}

// The edge `capturedEscapes` admits reference `position` of rewalk node `parent` through: a
// cleanup edge of the cleanup root's type when `cleanupNode` names one, else the reference's own.
pub effect fn rewalkEdge(thisStore: &mut Semantic, entries: &[BuildRecord.Entry], nodes: &mut List<EscapeNode>, parent: usize, position: usize,
  exact: ContentHash, cleanupNode: usize) -> Option<Edge>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if cleanupNode != usize.MAX {
    let glued = match move run rewalkNodeKey(&mut thisStore.*, entries, &mut nodes.*, cleanupNode) {
      Option<InstanceKey>.Some {value} => move value
      Option<InstanceKey>.None => { return Option<Edge>.none() }
    }
    return match move InstanceKey.glueType(&glued) {
      Option<Interned<Type>>.Some {value: owner} => Option<Edge>.some(Edge.Cleanup {owner: move owner})
      Option<Interned<Type>>.None => Option<Edge>.none()
    }
  }
  if let Option<InstanceKey>.None = move run rewalkNodeKey(&mut thisStore.*, entries, &mut nodes.*, parent) { return Option<Edge>.none() }
  return match move run rewalkReference(&mut thisStore.*, &mut nodes.*, parent, position, exact) {
    Option<EscapeReference>.Some {value} => Option<Edge>.some(move value.edge)
    Option<EscapeReference>.None => Option<Edge>.none()
  }
}

// Lowers needed entry `index` of a replayed record whose parent no longer enters it, because a
// body above it lowers to nothing now. Its key comes through another chain of bodies the record
// names as reaching it, from a root or a body already lowered, and a stale one must lower without
// a report and summarize as it did: then it adds nothing the record did not find. An entry no
// such chain reaches is no longer entered and needs nothing. A generic instance is left out,
// since what admits it depends on the path the walk takes to it.
pub effect fn replayOrphan(thisStore: &mut Semantic, entries: &[BuildRecord.Entry], roots: &[Option<InstanceKey>], entryRoots: &[usize],
  index: usize, stale: &[bool], mirs: &mut List<usize>, rested: &mut List<CapturedEntry>, referrers: &mut RecordReferrers) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if List<usize>.get(&mirs.*, index) != usize.MAX { return true }
  // A root that still starts the walk is entered at its turn whatever reached it first before.
  if let Option<InstanceKey>.Some {value: own} = move replayRootKey(roots, entryRoots, index) {
    if specializedInstance(&own) { return false }
    return run replayChainStep(&mut thisStore.*, entries, index, &own, stale, &mut mirs.*, &mut rested.*)
  }
  if !referrers.built { referrers.* = run recordReferrers(entries) }
  let starts = List<usize>.asSlice(&referrers.starts)
  let from = List<usize>.asSlice(&referrers.from)
  let positions = List<usize>.asSlice(&referrers.positions)
  // Entries that lower to nothing, or not as the record says, carry no chain.
  let mut dead = List<bool>.make()
  while List<bool>.length(&dead) < entries.length { run List<bool>.append(&mut dead, false) }
  while true {
    // Search back from `index` for the nearest entry with a key in hand, remembering the
    // reference each one names the next by.
    let mut seen = List<bool>.make()
    let mut toward = List<usize>.make()
    let mut through = List<usize>.make()
    while List<bool>.length(&seen) < entries.length {
      run List<bool>.append(&mut seen, false)
      run List<usize>.append(&mut toward, usize.MAX)
      run List<usize>.append(&mut through, usize.MAX)
    }
    List<bool>.set(&mut seen, index, true)
    let mut queue = List<usize>.make()
    run List<usize>.append(&mut queue, index)
    let mut head = usize.ZERO
    let mut start = usize.MAX
    while head < List<usize>.length(&queue) && start == usize.MAX {
      let reached = List<usize>.get(&queue, head)
      head = head + usize.ONE
      let mut slot = starts[reached]
      while slot < starts[reached + usize.ONE] {
        let referrer = from[slot]
        if !List<bool>.get(&seen, referrer) && !List<bool>.get(&dead, referrer) {
          List<bool>.set(&mut seen, referrer, true)
          List<usize>.set(&mut toward, referrer, reached)
          List<usize>.set(&mut through, referrer, positions[slot])
          let mut keyed = List<usize>.get(&mirs.*, referrer) != usize.MAX
          if let Option<InstanceKey>.Some {..} = move replayRootKey(roots, entryRoots, referrer) { keyed = true }
          if keyed {
            start = referrer
            break
          }
          run List<usize>.append(&mut queue, referrer)
        }
        slot = slot + usize.ONE
      }
    }
    // Every body the walk still enters lowers to the references the record names, so when no
    // chain of them reaches the entry, the walk no longer enters it and it adds nothing.
    if start == usize.MAX { return true }
    let mut current = start
    let mut failed = false
    if List<usize>.get(&mirs.*, start) == usize.MAX {
      if let Option<InstanceKey>.Some {value: instance} = move replayRootKey(roots, entryRoots, start) {
        failed = !run replayChainStep(&mut thisStore.*, entries, start, &instance, stale, &mut mirs.*, &mut rested.*)
      }
      if failed { List<bool>.set(&mut dead, start, true) }
    }
    while current != index && !failed {
      let next = List<usize>.get(&toward, current)
      let position = List<usize>.get(&through, current)
      let functions = List<MirFunction>.asSlice(&thisStore.resolver.mirValues)
      let named = List<MirReference>.asSlice(&functions[List<usize>.get(&mirs.*, current)].references)
      if position >= named.length { return false }
      let instance = InstanceKey.copy(&named[position].key)
      if next == index {
        if specializedInstance(&instance) { return false }
        return run replayChainStep(&mut thisStore.*, entries, next, &instance, stale, &mut mirs.*, &mut rested.*)
      }
      if run replayChainStep(&mut thisStore.*, entries, next, &instance, stale, &mut mirs.*, &mut rested.*) {
        current = next
      } else {
        List<bool>.set(&mut dead, next, true)
        failed = true
      }
    }
  }
  return false
}

// Lowers entry `index` of a replayed record by `instance`, as the walk would, and keeps its MIR.
// A stale entry must summarize as the record says; then its MIR rests in the record again.
pub effect fn replayChainStep(thisStore: &mut Semantic, entries: &[BuildRecord.Entry], index: usize, instance: &InstanceKey,
  stale: &[bool], mirs: &mut List<usize>, rested: &mut List<CapturedEntry>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let lowered = match move run replayEntryLowered(&mut thisStore.*, entries, index, instance) {
    Option<ReplayMir>.Some {value} => value
    Option<ReplayMir>.None => { return false }
  }
  if stale[index] {
    if !run replayAgrees(&mut thisStore.*, instance, lowered.mir, entries, index, false, Span.make(usize.ZERO, usize.ZERO)) {
      return false
    }
    List<CapturedEntry>.set(&mut rested.*, index, CapturedEntry {value: usize.MAX, mirUnit: lowered.mirUnit, emissionUnit: usize.MAX, frameUnit: usize.MAX,
      carried: usize.MAX})
  }
  List<usize>.set(&mut mirs.*, index, lowered.mir)
  return true
}

// Lowers `instance` as entry `index` of a replayed record: the key the record names, a body of
// this program, that lowers without a report, and for a stale entry summarizes as it did.
pub effect fn replayEntryLowered(thisStore: &mut Semantic, entries: &[BuildRecord.Entry], index: usize, instance: &InstanceKey)
  -> Option<ReplayMir>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let exact = run definitionDigest(instance)
  if !ContentHash.equals(exact, entries[index].exact) { return Option<ReplayMir>.none() }
  if entries[index].leaf != 0 || run foreignDeclaration(&mut thisStore.resolver, instance) { return Option<ReplayMir>.none() }
  return run escapeReplayMir(&mut thisStore.*, instance)
}

// What `capturedEscapes` does with a concrete body that starts no walk the record names: adds
// what its root lowering reports to `result`, and whether it starts a walk after all.
pub effect fn replayRoot(thisStore: &mut Semantic, request: &mut Request, declaration: &DeclarationId, result: &mut DeclarationCheckResult) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: rawAnswer} = move run escapeRootMir(&mut thisStore.*, &mut request.*, declaration) {
    let span = run authoredRequestSpan(&mut thisStore.resolver, declaration, Span.make(usize.ZERO, usize.ZERO))
    let answer = run anchorCanonicalAnswer(&mut thisStore.resolver, &rawAnswer, declaration, span)
    run appendCheckedAnswer(&mut result.rejections, &mut result.gaps, &mut thisStore.query, declaration, &answer)
    let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex)
    if let Option<usize>.Some {..} = move index { return true }
  }
  return false
}

// Adds to `result` what the MIR of `instance` reports, at the sites a walk entering it at `site`
// reports it, and whether it lowers to nothing, so the walk enters nothing below it. A body whose
// typing failed lowers to nothing and leaves the report to its typing's check.
pub effect fn replayBroken(thisStore: &mut Semantic, instance: &InstanceKey, site: &EntrySite, result: &mut DeclarationCheckResult) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let location = match move run locationOfInstance(&mut thisStore.resolver, instance) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return false }
  }
  let lowered = run internBackendInstance(&mut thisStore.resolver, instance, false)
  let mirKey = run internDeclaration(&mut thisStore.resolver, Key {family: Family.Mir, module: location.module, name: lowered,
    declaration: location.declaration, member: instanceMember(instance), external: false})
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, mirKey, Span.make(usize.ZERO, usize.ZERO))
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex)
  if let Option<usize>.Some {..} = move index { return false }
  let reportedBefore = List<Shared<Rejection>>.length(&result.rejections)
  let identity = DeclarationId.copyShared(&InstanceKey.identity(instance))
  run appendCheckedAnswer(&mut result.rejections, &mut result.gaps, &mut thisStore.query, &identity, &answer)
  let requested = requestSite(&site.requester, &site.entered, site.span)
  let own = run instanceExtent(&mut thisStore.resolver, instance)
  run relocateRequested(&mut result.rejections, reportedBefore, &requested.module, requested.span, callerIndependent(instance), &own)
  return true
}

// Lowers the MIR an escape walk lowers for `instance`; none when it reports anything or lowers to
// none.
pub effect fn escapeReplayMir(thisStore: &mut Semantic, instance: &InstanceKey) -> Option<ReplayMir>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let location = match move run locationOfInstance(&mut thisStore.resolver, instance) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option<ReplayMir>.none() }
  }
  let member = instanceMember(instance)
  let lowered = run internBackendInstance(&mut thisStore.resolver, instance, false)
  let mirKey = run internDeclaration(&mut thisStore.resolver, Key {family: Family.Mir, module: location.module, name: lowered,
    declaration: location.declaration, member: member, external: false})
  // A replay is first to lower a body only when it changed, which is its own module's work.
  let started = run Progress.clock(&mut thisStore.resolver.progress)
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, mirKey, Span.make(usize.ZERO, usize.ZERO))
  if started != 0 {
    let owner = resolvedModule(&thisStore.resolver, location.module)
    let shown = run ModuleId.copyPath(&owner)
    run Progress.bill(&mut thisStore.resolver.progress, Bytes.asSlice(&shown), started)
  }
  let mut reported = List<Shared<Rejection>>.make()
  let mut gaps = List<Shared<BackendGap>>.make()
  let identity = DeclarationId.copyShared(&InstanceKey.identity(instance))
  run appendCheckedAnswer(&mut reported, &mut gaps, &mut thisStore.query, &identity, &answer)
  if List<Shared<Rejection>>.length(&reported) > usize.ZERO || List<Shared<BackendGap>>.length(&gaps) > usize.ZERO {
    return Option<ReplayMir>.none()
  }
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex)
  let mir = match move index {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<ReplayMir>.none() }
  }
  let mirWord = run internKey(&mut thisStore.resolver, mirKey)
  return Option<ReplayMir>.some(ReplayMir {mir: mir, mirUnit: u64.toUsize(mirWord.value), frameUnit: usize.MAX, location: location, member: member})
}
