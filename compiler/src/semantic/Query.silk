//! Typed storage and scoped execution for one family of semantic queries.
//!
//! # When to use
//! Use [`Query`] when a semantic fact can depend on another fact from the same family.
//! Call [`demand`] to reuse a completed answer or to run its provider once.
//!
//! # Details
//! A completed answer owns a success or semantic rejection. A provider failure does not
//! complete the key. A later demand can run that provider again.
//!
//! # Gotchas
//! A recursive demand for an active key reports [`Cycle`]. Fatal traps stop the process;
//! they do not run reservation cleanup. Keys are dense interned ordinals: the store holds one
//! slot for every word up to the largest it has seen.

import silk.allocator {Allocator, OutOfMemoryError}
import CompilerBug
import silk.effect {Effect}
import silk.hash {Word}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.u64
import silk.usize
import silk.vector {Vector}

/// A recursive demand for a key whose provider is still active.
pub struct Cycle {}

/// One absent, reserved or completed query entry.
union Entry<A, R> {
  Absent,
  Active,
  Complete {answer: Shared<Result<A, R>>},
}

/// A reservation whose release removes only an unpublished active entry.
struct Reservation<'a, A, R> {
  owner: &'a mut Query<A, R>
  key: Word
  published: bool
}

/// A serial query store with owned keys and move-only completed answers.
///
/// # Details
///
/// The store retains a completed semantic rejection like a completed success.
/// Typed provider failures and structured cancellation remove the active key. Entries are
/// indexed directly by their word, so a lookup neither hashes nor probes.
pub struct Query<A, R> {
  entries: Vector<Entry<A, R>>
  present: usize
}

// The slot of one key.
fn slotOf(key: Word) -> usize {
  return u64.toUsize(key.value)
}

impl<A, R> Query<A, R> {
  /// Creates an empty query store.
  pub fn make() -> Query<A, R> {
    return Query<A, R> {entries: Vector<Entry<A, R>>.make(), present: usize.ZERO}
  }
  /// Returns the number of active and completed keys in the store.
  pub fn length(self: &Self) -> usize {
    return self.present
  }
  /// Reports whether `key` has a published success or semantic rejection.
  pub fn isComplete(self: &mut Self, key: Word) -> bool {
    let slot = slotOf(key)
    let listed = Vector<Entry<A, R>>.asSlice(&self.entries)
    if slot >= listed.length { return false }
    return match & listed[slot] {
      Entry<A, R>.Complete {..} => true
      _ => false
    }
  }
  /// Returns a completed answer without running its provider, or `None` for an absent or active key.
  pub fn completed(self: &mut Self, key: Word) -> Option<Shared<Result<A, R>>> {
    let slot = slotOf(key)
    let listed = Vector<Entry<A, R>>.asSlice(&self.entries)
    if slot >= listed.length { return Option<Shared<Result<A, R>>>.none() }
    return match & listed[slot] {
      Entry<A, R>.Complete {answer} => Option<Shared<Result<A, R>>>.some(Shared<Result<A, R>>.clone(&answer))
      _ => Option<Shared<Result<A, R>>>.none()
    }
  }
  /// Removes one completed key so its provider can run against a later revision.
  pub fn forget(self: &mut Self, key: Word) -> () {
    if !Query.isComplete(&mut self.*, key) {
      return ()
    }
    vacate<A, R>(&mut self.*, key)
    return ()
  }
  /// Replaces an already completed answer after its successor has been prepared.
  /// The key must remain complete throughout revision publication; this operation allocates
  /// nothing and preserves the query's key count.
  pub fn replaceCompleted(self: &mut Self, key: Word, answer: Shared<Result<A, R>>) -> () {
    if !Query.isComplete(&mut self.*, key) {
      return CompilerBug.panic(b"MissingRetainedFact: Query.replaceCompleted")
    }
    Vector<Entry<A, R>>.set(
      &mut self.entries,
      slotOf(key),
      Entry<A, R>.Complete {answer: move answer},
    )
    return ()
  }
  /// Runs the provider for an absent key and returns an owned handle to its completed answer.
  ///
  /// # Details
  ///
  /// A completed success or semantic rejection is reused without running `provide`.
  /// An active key reports `Cycle`. Provider failure and structured cancellation
  /// remove the reservation, so a later demand can retry the key.
  ///
  /// # Gotchas
  ///
  /// The caller must keep the returned `Shared` handle while it reads the answer.
  /// Fatal traps stop the process and do not run cleanup.
  pub effect<'owner & 'env> fn demand<'owner, 'env, E, ?Requirements>(
    self: &'owner mut Self,
    key: Word,
    provide: for<'scope> once fn<'env>(&'scope mut Self, Word) -> once Effect<'scope & 'env; Result<
      A,
      R,
    > ! E ? Requirements>,
  ) -> Shared<Result<A, R>> ! Cycle | E | OutOfMemoryError ? Requirements | &mut Allocator {
    let slot = slotOf(key)
    let mut active = false
    let listed = Vector<Entry<A, R>>.asSlice(&self.entries)
    if slot < listed.length {
      match & listed[slot] {
        Entry<A, R>.Absent => {}
        Entry<A, R>.Active => { active = true }
        Entry<A, R>.Complete {answer} => {
          let completed = Shared<Result<A, R>>.clone(&answer)
          drop move provide
          return move completed
        }
      }
    }
    if active {
      drop move provide
      fail Cycle {}
    }
    run occupy<A, R>(&mut self.*, key, Entry<A, R>.Active)
    let reservation = Reservation<'owner, A, R> {owner: move self, key: key, published: false}
    let use = effect fn(resource: &mut Reservation<'owner, A, R>) -> Shared<Result<A, R>>
    ! E | OutOfMemoryError
    ? Requirements | &mut Allocator {
      let selected = resource.key
      let answer = run provide(&mut resource.*.owner.*, selected)
      let shared = run Shared<Result<A, R>>.make(move answer)
      run occupy<A, R>(&mut resource.*.owner.*, selected, Entry<A, R>.Complete {answer: Shared<Result<A, R>>.clone(&shared)})
      resource.*.published = true
      return move shared
    }
    let release = effect fn(resource: &mut Reservation<'owner, A, R>) -> () {
      if !resource.published {
        let reserved = resource.key
        vacate<A, R>(&mut resource.*.owner.*, reserved)
      }
      return ()
    }
    return run Effect.useReleaseNonParking(move reservation, move use, move release)
  }
}

// Stores `entry` in the key's slot, growing the store with absent slots up to it.
effect<'store> fn occupy<'store, A: 'store, R: 'store>(query: &'store mut Query<A, R>, key: Word, entry: Entry<A, R>) -> ()
! OutOfMemoryError
? &mut Allocator {
  let slot = slotOf(key)
  while Vector<Entry<A, R>>.length(&query.entries) <= slot {
    run Vector<Entry<A, R>>.append(&mut query.entries, Entry<A, R>.Absent)
  }
  let listed = Vector<Entry<A, R>>.asSlice(&query.entries)
  let vacant = match & listed[slot] {
    Entry<A, R>.Absent => true
    _ => false
  }
  if vacant {
    query.present = query.present + usize.ONE
  }
  Vector<Entry<A, R>>.set(&mut query.entries, slot, move entry)
  return ()
}

// Empties the key's slot when it holds an entry.
fn vacate<A, R>(query: &mut Query<A, R>, key: Word) -> () {
  let slot = slotOf(key)
  let listed = Vector<Entry<A, R>>.asSlice(&query.entries)
  if slot >= listed.length { return () }
  let vacant = match & listed[slot] {
    Entry<A, R>.Absent => true
    _ => false
  }
  if vacant { return () }
  query.present = query.present - usize.ONE
  Vector<Entry<A, R>>.set(&mut query.entries, slot, Entry<A, R>.Absent)
  return ()
}
