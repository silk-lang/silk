fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Looks up a closed member after the caller authenticates the sealed namespace.
pub fn lookup(name: &[u8]) -> Option<Member> {
  let table = primitives()
  let named: &[Primitive] = &table
  let mut at = usize.ZERO
  while at < named.length {
    if same(name, spelling(named[at])) {
      return Option<Member>.some(Member.Primitive {primitive: named[at]})
    }
    at = at + usize.ONE
  }
  return match move ScalarOperation.lookup(name) {
    Option<ScalarOperation>.Some {value} => Option<Member>.some(Member.Scalar {operation: value})
    Option<ScalarOperation>.None => Option<Member>.none()
  }
}

/// Whether a selected member is the named primitive `wanted`.
pub fn isPrimitive(selected: Member, wanted: Primitive) -> bool {
  return match selected {
    Member.Primitive {primitive} => primitive == wanted
    Member.Scalar {..} => false
  }
}

/// Whether the selected primitive belongs to residual runtime code.
pub fn isRuntime(selected: Member) -> bool {
  return match selected {
    Member.Scalar {..} => true
    Member.Primitive {primitive} => (isGeneric(selected) && !isSequence(selected)) || primitive == Primitive.ObserveUnhandled || primitive == Primitive.ObserveHandled ||
      primitive == Primitive.AtomicFence || primitive == Primitive.BorrowField || primitive == Primitive.BorrowFieldMut || primitive == Primitive.MakeVariant ||
      primitive == Primitive.IsVariant || primitive == Primitive.StringEqualsExact || primitive == Primitive.Trap ||
      primitive == Primitive.TestFunction || primitive == Primitive.FrameAddress
  }
}

/// Whether a member contract takes ordinary type arguments. Runtime pointer/view primitives
/// and phase-only sequence constructors share this instantiation rule; reflection is separate.
pub fn isGeneric(selected: Member) -> bool {
  return match selected {
    Member.Scalar {..} => false
    Member.Primitive {primitive} => match primitive {
      Primitive.PointerFromSlice => true
      Primitive.PointerFromMutSlice => true
      Primitive.PointerFromRef => true
      Primitive.PointerFromMutRef => true
      Primitive.PointerAt => true
      Primitive.PointerAtMut => true
      Primitive.PointerRead => true
      Primitive.PointerWrite => true
      Primitive.PointerTake => true
      Primitive.PointerBorrow => true
      Primitive.PointerBorrowMut => true
      Primitive.PointerBorrowMany => true
      Primitive.PointerBorrowManyMut => true
      Primitive.PointerReadUnaligned => true
      Primitive.PointerWriteUnaligned => true
      Primitive.PointerRequalify => true
      Primitive.PointerReinterpret => true
      Primitive.PointerBytes => true
      Primitive.PointerAddress => true
      Primitive.PointerIsNull => true
      Primitive.PointerNull => true
      Primitive.PointerNullFunction => true
      Primitive.StackAllocate => true
      Primitive.SliceView => true
      Primitive.StaticSequenceEmpty => true
      Primitive.StaticSequenceAppend => true
      Primitive.StaticSequenceConcat => true
      Primitive.StaticSequenceLength => true
      Primitive.StaticSequenceAt => true
      Primitive.Assembly => true
      _ => (isAtomic(selected) && primitive != Primitive.AtomicFence) || isVector(selected)
    }
  }
}

// The number of arguments of a vector form.
fn vectorArity(form: VectorForm) -> usize {
  return match form {
    VectorForm.Extract => 2
    VectorForm.Compare => 2
    VectorForm.Binary => 2
    VectorForm.Load => 2
    VectorForm.PointerStore => 2
    VectorForm.Insert => 3
    VectorForm.Select => 3
    VectorForm.Shuffle => 3
    VectorForm.Ternary => 3
    VectorForm.Store => 3
    _ => usize.ONE
  }
}

/// The parameters and result of a SIMD vector operation over its vector `V`, whose lane type is
/// `L` and lane count `N`.
pub enum VectorForm {
  /// `(L) -> V`
  Splat,
  /// `(V, usize) -> L`
  Extract,
  /// `(V, usize, L) -> V`
  Insert,
  /// `([L; N]) -> V`
  FromArray,
  /// `(V) -> [L; N]`
  ToArray,
  /// `(V, V) -> mask<N>`
  Compare,
  /// `(mask<N>, V, V) -> V`
  Select,
  /// `(V) -> V`
  Unary,
  /// `(V, V) -> V`
  Binary,
  /// `(V, V, V) -> V`
  Ternary,
  /// `(V) -> L`
  Reduce,
  /// `(V) -> bool` over a mask.
  MaskTest,
  /// `(V) -> usize` over a mask.
  MaskCount,
  /// `(V) -> u64` over a mask.
  MaskToBits,
  /// `(u64) -> V` for a mask.
  MaskFromBits,
  /// `(&[L], usize) -> V`
  Load,
  /// `(&mut [L], usize, V) -> ()`
  Store,
  /// `([*]const L) -> V`
  PointerLoad,
  /// `([*]mut L, V) -> ()`
  PointerStore,
  /// `<From, To>(From) -> To`
  Convert,
  /// `<V, R>(V, V, static [usize; M]) -> R`
  Shuffle,  /// `<V>(V[, A[, A]]) -> R`: an architecture operation, whose operand and result shapes come
  /// from its catalog row for `V` (SIMD-007).
  Arch,
}

/// The lanes a vector operation admits.
pub enum LaneClass {
  Any,
  Numeric,
  Integer,
  Floating,
  Mask,
}

/// The form of a SIMD vector primitive, or none for any other primitive.
pub fn vectorForm(primitive: Primitive) -> Option<VectorForm> {
  let form = match primitive {
    Primitive.SimdSplat => VectorForm.Splat
    Primitive.SimdExtract => VectorForm.Extract
    Primitive.SimdInsert => VectorForm.Insert
    Primitive.SimdFromArray => VectorForm.FromArray
    Primitive.SimdToArray => VectorForm.ToArray
    Primitive.SimdLanesEqual => VectorForm.Compare
    Primitive.SimdLanesNotEqual => VectorForm.Compare
    Primitive.SimdLanesLess => VectorForm.Compare
    Primitive.SimdLanesLessOrEqual => VectorForm.Compare
    Primitive.SimdLanesGreater => VectorForm.Compare
    Primitive.SimdLanesGreaterOrEqual => VectorForm.Compare
    Primitive.SimdSelect => VectorForm.Select
    Primitive.SimdWrappingAdd => VectorForm.Binary
    Primitive.SimdWrappingSubtract => VectorForm.Binary
    Primitive.SimdWrappingMultiply => VectorForm.Binary
    Primitive.SimdSaturatingAdd => VectorForm.Binary
    Primitive.SimdSaturatingSubtract => VectorForm.Binary
    Primitive.SimdShiftLeft => VectorForm.Binary
    Primitive.SimdShiftRight => VectorForm.Binary
    Primitive.SimdRotateLeft => VectorForm.Binary
    Primitive.SimdRotateRight => VectorForm.Binary
    Primitive.SimdMinimum => VectorForm.Binary
    Primitive.SimdMaximum => VectorForm.Binary
    Primitive.SimdSqrt => VectorForm.Unary
    Primitive.SimdMulAdd => VectorForm.Ternary
    Primitive.SimdReduceAdd => VectorForm.Reduce
    Primitive.SimdReduceWrappingAdd => VectorForm.Reduce
    Primitive.SimdReduceAddUnordered => VectorForm.Reduce
    Primitive.SimdReduceMinimum => VectorForm.Reduce
    Primitive.SimdReduceMaximum => VectorForm.Reduce
    Primitive.SimdReduceBitAnd => VectorForm.Reduce
    Primitive.SimdReduceBitOr => VectorForm.Reduce
    Primitive.SimdReduceBitXor => VectorForm.Reduce
    Primitive.SimdMaskAny => VectorForm.MaskTest
    Primitive.SimdMaskAll => VectorForm.MaskTest
    Primitive.SimdMaskCount => VectorForm.MaskCount
    Primitive.SimdMaskFirstSet => VectorForm.MaskCount
    Primitive.SimdMaskToBits => VectorForm.MaskToBits
    Primitive.SimdMaskFromBits => VectorForm.MaskFromBits
    Primitive.SimdLoad => VectorForm.Load
    Primitive.SimdStore => VectorForm.Store
    Primitive.SimdPointerLoad => VectorForm.PointerLoad
    Primitive.SimdPointerStore => VectorForm.PointerStore
    Primitive.SimdConvert => VectorForm.Convert
    Primitive.SimdBitcast => VectorForm.Convert
    Primitive.SimdShuffle => VectorForm.Shuffle
    _ => {
      if archSignature(primitive, usize.ZERO).arity == usize.ZERO { return Option<VectorForm>.none() }
      return Option<VectorForm>.some(VectorForm.Arch)
    }
  }
  return Option<VectorForm>.some(form)
}

/// One lane type and lane count of an architecture operation's operand or result.
pub struct ArchShape {
  /// The lane type.
  pub lane: Scalar,
  /// The lane count.
  pub lanes: usize,
}

impl Copy for ArchShape {}

/// One admitted signature of an architecture operation (SIMD-007): its operand and result
/// shapes, the target architecture and CPU feature it needs, and the LLVM intrinsic it calls.
/// An `arity` of zero is no signature.
pub struct ArchSignature {
  /// The target architecture, as `Target.architecture` spells it.
  pub architecture: &'static [u8],
  /// The CPU feature the operation needs, as the target's feature catalog spells it.
  pub feature: &'static [u8],
  /// The LLVM intrinsic.
  pub llvm: &'static [u8],
  /// The first `arity` entries are the operand shapes.
  pub operands: [ArchShape; 3],
  /// The number of operands.
  pub arity: usize,
  /// The result shape.
  pub result: ArchShape,
  /// A constant `i8` operand the LLVM intrinsic takes after the operands, or `usize.MAX` for none.
  pub immediate: usize,
}

impl Copy for ArchSignature {}

fn archRow(
  architecture: &'static [u8], feature: &'static [u8], llvm: &'static [u8], operands: [ArchShape; 3], arity: usize,
  result: ArchShape,
) -> ArchSignature {
  return ArchSignature {architecture: architecture, feature: feature, llvm: llvm, operands: operands, arity: arity, result: result,
    immediate: usize.MAX}
}

fn archRowImmediate(
  architecture: &'static [u8], feature: &'static [u8], llvm: &'static [u8], operands: [ArchShape; 3], arity: usize,
  result: ArchShape, immediate: usize,
) -> ArchSignature {
  let mut row = archRow(architecture, feature, llvm, operands, arity, result)
  row.immediate = immediate
  return row
}

fn noArch() -> ArchSignature {
  let none = ArchShape {lane: Scalar.U8, lanes: usize.ZERO}
  return archRow(b"", b"", b"", [none, none, none], usize.ZERO, none)
}

/// The signature at `index` in the catalog row list of `primitive`, or one with arity zero past
/// the last row and for any primitive that is not an architecture operation.
pub fn archSignature(primitive: Primitive, index: usize) -> ArchSignature {
  return match primitive {
    Primitive.X86ShuffleBytes => {
      if index == 0 { return archRow(b"x86_64", b"ssse3", b"llvm.x86.ssse3.pshuf.b.128", [ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 2, ArchShape {lane: Scalar.U8, lanes: 16}) }
      if index == 1 { return archRow(b"x86_64", b"avx2", b"llvm.x86.avx2.pshuf.b", [ArchShape {lane: Scalar.U8, lanes: 32}, ArchShape {lane: Scalar.U8, lanes: 32}, ArchShape {lane: Scalar.U8, lanes: 32}], 2, ArchShape {lane: Scalar.U8, lanes: 32}) }
      return noArch()
    }
    Primitive.X86MultiplyAddBytes => {
      if index == 0 { return archRow(b"x86_64", b"ssse3", b"llvm.x86.ssse3.pmadd.ub.sw.128", [ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.I8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 2, ArchShape {lane: Scalar.I16, lanes: 8}) }
      if index == 1 { return archRow(b"x86_64", b"avx2", b"llvm.x86.avx2.pmadd.ub.sw", [ArchShape {lane: Scalar.U8, lanes: 32}, ArchShape {lane: Scalar.I8, lanes: 32}, ArchShape {lane: Scalar.U8, lanes: 32}], 2, ArchShape {lane: Scalar.I16, lanes: 16}) }
      return noArch()
    }
    Primitive.X86MultiplyAddWords => {
      if index == 0 { return archRow(b"x86_64", b"sse2", b"llvm.x86.sse2.pmadd.wd", [ArchShape {lane: Scalar.I16, lanes: 8}, ArchShape {lane: Scalar.I16, lanes: 8}, ArchShape {lane: Scalar.I16, lanes: 8}], 2, ArchShape {lane: Scalar.I32, lanes: 4}) }
      if index == 1 { return archRow(b"x86_64", b"avx2", b"llvm.x86.avx2.pmadd.wd", [ArchShape {lane: Scalar.I16, lanes: 16}, ArchShape {lane: Scalar.I16, lanes: 16}, ArchShape {lane: Scalar.I16, lanes: 16}], 2, ArchShape {lane: Scalar.I32, lanes: 8}) }
      return noArch()
    }
    Primitive.X86PackUnsignedSaturate => {
      if index == 0 { return archRow(b"x86_64", b"sse2", b"llvm.x86.sse2.packuswb.128", [ArchShape {lane: Scalar.I16, lanes: 8}, ArchShape {lane: Scalar.I16, lanes: 8}, ArchShape {lane: Scalar.I16, lanes: 8}], 2, ArchShape {lane: Scalar.U8, lanes: 16}) }
      if index == 1 { return archRow(b"x86_64", b"avx2", b"llvm.x86.avx2.packuswb", [ArchShape {lane: Scalar.I16, lanes: 16}, ArchShape {lane: Scalar.I16, lanes: 16}, ArchShape {lane: Scalar.I16, lanes: 16}], 2, ArchShape {lane: Scalar.U8, lanes: 32}) }
      if index == 2 { return archRow(b"x86_64", b"sse4.1", b"llvm.x86.sse41.packusdw", [ArchShape {lane: Scalar.I32, lanes: 4}, ArchShape {lane: Scalar.I32, lanes: 4}, ArchShape {lane: Scalar.I32, lanes: 4}], 2, ArchShape {lane: Scalar.U16, lanes: 8}) }
      return noArch()
    }
    Primitive.X86PackSignedSaturate => {
      if index == 0 { return archRow(b"x86_64", b"sse2", b"llvm.x86.sse2.packsswb.128", [ArchShape {lane: Scalar.I16, lanes: 8}, ArchShape {lane: Scalar.I16, lanes: 8}, ArchShape {lane: Scalar.I16, lanes: 8}], 2, ArchShape {lane: Scalar.I8, lanes: 16}) }
      if index == 1 { return archRow(b"x86_64", b"sse2", b"llvm.x86.sse2.packssdw.128", [ArchShape {lane: Scalar.I32, lanes: 4}, ArchShape {lane: Scalar.I32, lanes: 4}, ArchShape {lane: Scalar.I32, lanes: 4}], 2, ArchShape {lane: Scalar.I16, lanes: 8}) }
      return noArch()
    }
    Primitive.X86SumAbsoluteDifferences => {
      if index == 0 { return archRow(b"x86_64", b"sse2", b"llvm.x86.sse2.psad.bw", [ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 2, ArchShape {lane: Scalar.U64, lanes: 2}) }
      if index == 1 { return archRow(b"x86_64", b"avx2", b"llvm.x86.avx2.psad.bw", [ArchShape {lane: Scalar.U8, lanes: 32}, ArchShape {lane: Scalar.U8, lanes: 32}, ArchShape {lane: Scalar.U8, lanes: 32}], 2, ArchShape {lane: Scalar.U64, lanes: 4}) }
      return noArch()
    }
    Primitive.Aarch64TableLookup => {
      if index == 0 { return archRow(b"aarch64", b"neon", b"llvm.aarch64.neon.tbl1.v16i8", [ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 2, ArchShape {lane: Scalar.U8, lanes: 16}) }
      return noArch()
    }
    Primitive.Aarch64DotProduct => {
      if index == 0 { return archRow(b"aarch64", b"dotprod", b"llvm.aarch64.neon.udot.v4i32.v16i8", [ArchShape {lane: Scalar.U32, lanes: 4}, ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 3, ArchShape {lane: Scalar.U32, lanes: 4}) }
      if index == 1 { return archRow(b"aarch64", b"dotprod", b"llvm.aarch64.neon.sdot.v4i32.v16i8", [ArchShape {lane: Scalar.I32, lanes: 4}, ArchShape {lane: Scalar.I8, lanes: 16}, ArchShape {lane: Scalar.I8, lanes: 16}], 3, ArchShape {lane: Scalar.I32, lanes: 4}) }
      return noArch()
    }
    Primitive.Aarch64PairwiseAdd => {
      if index == 0 { return archRow(b"aarch64", b"neon", b"llvm.aarch64.neon.addp.v16i8", [ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 2, ArchShape {lane: Scalar.U8, lanes: 16}) }
      if index == 1 { return archRow(b"aarch64", b"neon", b"llvm.aarch64.neon.addp.v8i16", [ArchShape {lane: Scalar.U16, lanes: 8}, ArchShape {lane: Scalar.U16, lanes: 8}, ArchShape {lane: Scalar.U16, lanes: 8}], 2, ArchShape {lane: Scalar.U16, lanes: 8}) }
      if index == 2 { return archRow(b"aarch64", b"neon", b"llvm.aarch64.neon.addp.v4i32", [ArchShape {lane: Scalar.U32, lanes: 4}, ArchShape {lane: Scalar.U32, lanes: 4}, ArchShape {lane: Scalar.U32, lanes: 4}], 2, ArchShape {lane: Scalar.U32, lanes: 4}) }
      return noArch()
    }
    Primitive.WasmSwizzle => {
      if index == 0 { return archRow(b"wasm32", b"simd128", b"llvm.wasm.swizzle", [ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 2, ArchShape {lane: Scalar.U8, lanes: 16}) }
      return noArch()
    }
    Primitive.WasmRelaxedSwizzle => {
      if index == 0 { return archRow(b"wasm32", b"relaxed-simd", b"llvm.wasm.relaxed.swizzle", [ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}, ArchShape {lane: Scalar.U8, lanes: 16}], 2, ArchShape {lane: Scalar.U8, lanes: 16}) }
