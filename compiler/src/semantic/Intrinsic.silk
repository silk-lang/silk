//! Checked identity for the sealed source-callable compiler primitives.
//!
//! # Details
//! The semantic resolver authenticates the sealed `Intrinsic` namespace before asking this actor
//! to select a closed member. Ordinary library declarations never acquire an intrinsic identity.

import hir.Hir {Access, InfixOperator, PrefixOperator}
import semantic.Lifetime {Lifetime}
import semantic.Type {Type}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize

/// One compiler primitive after sealed namespace and type-contract selection.
pub enum Member {
  TargetPointerBits,
  TargetPointerAlignment,
  TargetArchitecture,
  TargetOperatingSystem,
  TargetAbi,
  TargetObjectFormat,
  TargetEndianness,
  ProfileText,
  ProfileFlag,
  ProfileContains,
  StaticTextByteLength,
  StaticTextByteAt,
  StaticTextConcat,
  StaticTextSlice,
  UsizeAdd,
  I32Add,
  I32Subtract,
  I32Multiply,
  I32Divide,
  I32Remainder,
  I32Equals,
  I32NotEquals,
  I32LessThan,
  I32LessOrEqual,
  I32GreaterThan,
  I32GreaterOrEqual,
  I32BitAnd,
  I32BitOr,
  I32BitXor,
  I32Negate,
  I32BitNot,
  BoolEquals,
  BoolNotEquals,
  BoolNot,
  F32ToBits,
  F32FromBits,
  F64ToBits,
  F64FromBits,
  /// `reflectType<Owner>()`: the phase-only descriptor of one aggregate type.
  ReflectType,
  /// `reflectTypeKind<Owner>(descriptor)`: the stable aggregate-kind code of a descriptor.
  ReflectTypeKind,
}

/// A primitive parameter or result in the closed compiler contract.
pub enum ValueKind {
  U8,
  U32,
  Usize,
  I32,
  I32Ref,
  U64,
  Bool,
  F32,
  F64,
  Text,
  StaticText,
}

/// Whether the selected primitive belongs to residual runtime code.
pub fn isRuntime(selected: Member) -> bool {
  return match selected {
    Member.UsizeAdd => true
    Member.I32Add => true
    Member.I32Subtract => true
    Member.I32Multiply => true
    Member.I32Divide => true
    Member.I32Remainder => true
    Member.I32Equals => true
    Member.I32NotEquals => true
    Member.I32LessThan => true
    Member.I32LessOrEqual => true
    Member.I32GreaterThan => true
    Member.I32GreaterOrEqual => true
    Member.I32BitAnd => true
    Member.I32BitOr => true
    Member.I32BitXor => true
    Member.I32Negate => true
    Member.I32BitNot => true
    Member.BoolEquals => true
    Member.BoolNotEquals => true
    Member.BoolNot => true
    Member.F32ToBits => true
    Member.F32FromBits => true
    Member.F64ToBits => true
    Member.F64FromBits => true
    _ => false
  }
}

/// Whether a member is static aggregate reflection. Reflection takes its owner from the call's one
/// type argument, so its contract is not a closed primitive [`ValueKind`] signature.
pub fn isReflection(selected: Member) -> bool {
  return selected == Member.ReflectType || selected == Member.ReflectTypeKind
}

/// The exact number of arguments accepted by one sealed primitive.
pub fn arity(selected: Member) -> usize {
  if selected == Member.ReflectTypeKind { return usize.ONE }
  if isRuntime(selected) {
    if selected == Member.I32Negate || selected == Member.I32BitNot || selected == Member.BoolNot || selected == Member.F32ToBits || selected == Member.F32FromBits || selected == Member.F64ToBits || selected == Member.F64FromBits { return usize.ONE }
    return 2
  }
  if selected == Member.ProfileText || selected == Member.ProfileFlag { return usize.ONE }
  if selected == Member.ProfileContains { return 2 }
  if selected == Member.StaticTextByteLength { return usize.ONE }
  if selected == Member.StaticTextByteAt || selected == Member.StaticTextConcat { return 2 }
  if selected == Member.StaticTextSlice { return 3 }
  return usize.ZERO
}

/// The expected parameter at `index`, or absence past the primitive's arity.
pub fn parameterKind(selected: Member, index: usize) -> Option<ValueKind> {
  if index >= arity(selected) || isReflection(selected) { return Option.none<ValueKind>() }
  if isRuntime(selected) {
    if selected == Member.UsizeAdd { return Option.some<ValueKind>(ValueKind.Usize) }
    if selected == Member.BoolEquals || selected == Member.BoolNotEquals || selected == Member.BoolNot { return Option.some<ValueKind>(ValueKind.Bool) }
    if selected == Member.F32ToBits { return Option.some<ValueKind>(ValueKind.F32) }
    if selected == Member.F32FromBits { return Option.some<ValueKind>(ValueKind.U32) }
    if selected == Member.F64ToBits { return Option.some<ValueKind>(ValueKind.F64) }
    if selected == Member.F64FromBits { return Option.some<ValueKind>(ValueKind.U64) }
    if selected == Member.I32LessThan { return Option.some<ValueKind>(ValueKind.I32Ref) }
    return Option.some<ValueKind>(ValueKind.I32)
  }
  if selected == Member.ProfileText || selected == Member.ProfileFlag || selected == Member.ProfileContains {
    return Option.some<ValueKind>(ValueKind.Text)
  }
  if selected == Member.StaticTextByteLength || selected == Member.StaticTextConcat || index == usize.ZERO {
    return Option.some<ValueKind>(ValueKind.Text)
  }
  return Option.some<ValueKind>(ValueKind.Usize)
}

/// The result that body checking can synthesize without a contextual expected type. A reflected
/// descriptor's type depends on the call's type argument, so it has no closed kind.
pub fn resultKind(selected: Member) -> Option<ValueKind> {
  if selected == Member.ReflectType { return Option.none<ValueKind>() }
  if selected == Member.ReflectTypeKind { return Option.some<ValueKind>(ValueKind.U8) }
  if isRuntime(selected) {
    if selected == Member.UsizeAdd { return Option.some<ValueKind>(ValueKind.Usize) }
    if selected == Member.BoolEquals || selected == Member.BoolNotEquals || selected == Member.BoolNot || selected == Member.I32Equals || selected == Member.I32NotEquals || selected == Member.I32LessThan || selected == Member.I32LessOrEqual || selected == Member.I32GreaterThan || selected == Member.I32GreaterOrEqual { return Option.some<ValueKind>(ValueKind.Bool) }
    if selected == Member.F32ToBits { return Option.some<ValueKind>(ValueKind.U32) }
    if selected == Member.F32FromBits { return Option.some<ValueKind>(ValueKind.F32) }
    if selected == Member.F64ToBits { return Option.some<ValueKind>(ValueKind.U64) }
    if selected == Member.F64FromBits { return Option.some<ValueKind>(ValueKind.F64) }
    return Option.some<ValueKind>(ValueKind.I32)
  }
  if selected == Member.ProfileFlag || selected == Member.ProfileContains { return Option.some<ValueKind>(ValueKind.Bool) }
  if selected == Member.TargetPointerBits || selected == Member.TargetPointerAlignment {
    return Option.some<ValueKind>(ValueKind.U32)
  }
  if selected == Member.StaticTextByteLength {
    return Option.some<ValueKind>(ValueKind.Usize)
  }
  if selected == Member.StaticTextByteAt {
    return Option.some<ValueKind>(ValueKind.U8)
  }
  return Option.some<ValueKind>(ValueKind.StaticText)
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Looks up a closed member after the caller authenticates the sealed namespace.
pub fn lookup(name: &[u8]) -> Option<Member> {
  if same(name, b"targetPointerBits") {
    return Option.some<Member>(Member.TargetPointerBits)
  }
  if same(name, b"targetPointerAlignment") {
    return Option.some<Member>(Member.TargetPointerAlignment)
  }
  if same(name, b"targetArchitecture") {
    return Option.some<Member>(Member.TargetArchitecture)
  }
  if same(name, b"targetOperatingSystem") {
    return Option.some<Member>(Member.TargetOperatingSystem)
  }
  if same(name, b"targetAbi") {
    return Option.some<Member>(Member.TargetAbi)
  }
  if same(name, b"targetObjectFormat") {
    return Option.some<Member>(Member.TargetObjectFormat)
  }
  if same(name, b"targetEndianness") {
    return Option.some<Member>(Member.TargetEndianness)
  }
  if same(name, b"profileText") {
    return Option.some<Member>(Member.ProfileText)
  }
  if same(name, b"profileFlag") {
    return Option.some<Member>(Member.ProfileFlag)
  }
  if same(name, b"profileContains") {
    return Option.some<Member>(Member.ProfileContains)
  }
  if same(name, b"staticTextByteLength") {
    return Option.some<Member>(Member.StaticTextByteLength)
  }
  if same(name, b"staticTextByteAt") {
    return Option.some<Member>(Member.StaticTextByteAt)
  }
  if same(name, b"staticTextConcat") {
    return Option.some<Member>(Member.StaticTextConcat)
  }
  if same(name, b"staticTextSlice") {
    return Option.some<Member>(Member.StaticTextSlice)
  }
  if same(name, b"usizeAdd") { return Option.some<Member>(Member.UsizeAdd) }
  if same(name, b"i32Add") { return Option.some<Member>(Member.I32Add) }
  if same(name, b"i32Subtract") { return Option.some<Member>(Member.I32Subtract) }
  if same(name, b"i32Multiply") { return Option.some<Member>(Member.I32Multiply) }
  if same(name, b"i32Divide") { return Option.some<Member>(Member.I32Divide) }
  if same(name, b"i32Remainder") { return Option.some<Member>(Member.I32Remainder) }
  if same(name, b"i32Equals") { return Option.some<Member>(Member.I32Equals) }
  if same(name, b"i32NotEquals") { return Option.some<Member>(Member.I32NotEquals) }
  if same(name, b"i32LessThan") { return Option.some<Member>(Member.I32LessThan) }
  if same(name, b"i32LessOrEqual") { return Option.some<Member>(Member.I32LessOrEqual) }
  if same(name, b"i32GreaterThan") { return Option.some<Member>(Member.I32GreaterThan) }
  if same(name, b"i32GreaterOrEqual") { return Option.some<Member>(Member.I32GreaterOrEqual) }
  if same(name, b"i32BitAnd") { return Option.some<Member>(Member.I32BitAnd) }
  if same(name, b"i32BitOr") { return Option.some<Member>(Member.I32BitOr) }
  if same(name, b"i32BitXor") { return Option.some<Member>(Member.I32BitXor) }
  if same(name, b"i32Negate") { return Option.some<Member>(Member.I32Negate) }
  if same(name, b"i32BitNot") { return Option.some<Member>(Member.I32BitNot) }
  if same(name, b"boolEquals") { return Option.some<Member>(Member.BoolEquals) }
  if same(name, b"boolNotEquals") { return Option.some<Member>(Member.BoolNotEquals) }
  if same(name, b"boolNot") { return Option.some<Member>(Member.BoolNot) }
  if same(name, b"f32ToBits") { return Option.some<Member>(Member.F32ToBits) }
  if same(name, b"f32FromBits") { return Option.some<Member>(Member.F32FromBits) }
  if same(name, b"f64ToBits") { return Option.some<Member>(Member.F64ToBits) }
  if same(name, b"f64FromBits") { return Option.some<Member>(Member.F64FromBits) }
  if same(name, b"reflectType") { return Option.some<Member>(Member.ReflectType) }
  if same(name, b"reflectTypeKind") { return Option.some<Member>(Member.ReflectTypeKind) }
  return Option.none<Member>()
}

fn primitive(value: &Type, name: &[u8]) -> bool {
  return match & value.* {
    Type.Primitive {name: selected} => same(Bytes.asSlice(&selected), name)
    _ => false
  }
}

fn isU8(value: &Type) -> bool {
  return primitive(value, b"u8")
}

fn isU32(value: &Type) -> bool {
  return primitive(value, b"u32")
}

fn isUsize(value: &Type) -> bool {
  return primitive(value, b"usize")
}

fn isBool(value: &Type) -> bool {
  return primitive(value, b"bool")
}

fn isText(value: &Type) -> bool {
  return match & value.* {
    Type.String {..} => true
    _ => false
  }
}

fn isStaticLifetime(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Static => true
    _ => false
  }
}

fn isStaticText(value: &Type) -> bool {
  return match & value.* {
    Type.String {lifetime} => Shared.with<Lifetime, bool>(&lifetime, isStaticLifetime)
    _ => false
  }
}

/// Checks one resolved semantic type against a primitive contract entry.
pub fn matches(kind: ValueKind, value: &Type) -> bool {
  return match kind {
    ValueKind.U8 => isU8(value)
    ValueKind.U32 => isU32(value)
    ValueKind.Usize => isUsize(value)
    ValueKind.I32 => primitive(value, b"i32")
    ValueKind.I32Ref => match &value.* {
      Type.Reference {access, referent, ..} => access == Access.Shared && Shared.with<Type, bool>(&referent, fn(inner: &Type) -> bool { return primitive(inner, b"i32") })
      _ => false
    }
    ValueKind.U64 => primitive(value, b"u64")
    ValueKind.Bool => isBool(value)
    ValueKind.F32 => primitive(value, b"f32")
    ValueKind.F64 => primitive(value, b"f64")
    ValueKind.Text => isText(value)
    ValueKind.StaticText => isStaticText(value)
  }
}

pub fn accepts(selected: Member, arguments: &[Shared<Type>], result: &Type) -> bool {
  let kind = resultKind(selected)
  let closed = match move kind {
    Option<ValueKind>.Some {value} => matches(value, result)
    Option<ValueKind>.None => false
  }
  if arguments.length != arity(selected) || !closed {
    return false
  }
  let mut at = usize.ZERO
  while at < arguments.length {
    let expected = match move parameterKind(selected, at) {
      Option<ValueKind>.Some {value} => value
      Option<ValueKind>.None => {
        return false
      }
    }
    let correct = Shared.with<Type, bool>(
      &arguments[at],
      fn(value: &Type) -> bool {
        return matches(expected, value)
      },
    )
    if !correct {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// The canonical member spelling for an already selected identity.
pub fn spelling(selected: Member) -> &'static [u8] {
  return match selected {
    Member.TargetPointerBits => b"targetPointerBits"
    Member.TargetPointerAlignment => b"targetPointerAlignment"
    Member.TargetArchitecture => b"targetArchitecture"
    Member.TargetOperatingSystem => b"targetOperatingSystem"
    Member.TargetAbi => b"targetAbi"
    Member.TargetObjectFormat => b"targetObjectFormat"
    Member.TargetEndianness => b"targetEndianness"
    Member.ProfileText => b"profileText"
    Member.ProfileFlag => b"profileFlag"
    Member.ProfileContains => b"profileContains"
    Member.StaticTextByteLength => b"staticTextByteLength"
    Member.StaticTextByteAt => b"staticTextByteAt"
    Member.StaticTextConcat => b"staticTextConcat"
    Member.StaticTextSlice => b"staticTextSlice"
    Member.UsizeAdd => b"usizeAdd"
    Member.I32Add => b"i32Add"
    Member.I32Subtract => b"i32Subtract"
    Member.I32Multiply => b"i32Multiply"
    Member.I32Divide => b"i32Divide"
    Member.I32Remainder => b"i32Remainder"
    Member.I32Equals => b"i32Equals"
    Member.I32NotEquals => b"i32NotEquals"
    Member.I32LessThan => b"i32LessThan"
    Member.I32LessOrEqual => b"i32LessOrEqual"
    Member.I32GreaterThan => b"i32GreaterThan"
    Member.I32GreaterOrEqual => b"i32GreaterOrEqual"
    Member.I32BitAnd => b"i32BitAnd"
    Member.I32BitOr => b"i32BitOr"
    Member.I32BitXor => b"i32BitXor"
    Member.I32Negate => b"i32Negate"
    Member.I32BitNot => b"i32BitNot"
    Member.BoolEquals => b"boolEquals"
    Member.BoolNotEquals => b"boolNotEquals"
    Member.BoolNot => b"boolNot"
    Member.F32ToBits => b"f32ToBits"
    Member.F32FromBits => b"f32FromBits"
    Member.F64ToBits => b"f64ToBits"
    Member.F64FromBits => b"f64FromBits"
    Member.ReflectType => b"reflectType"
    Member.ReflectTypeKind => b"reflectTypeKind"
  }
}

/// The eager binary MIR operation for a selected scalar primitive.
pub fn binary(selected: Member) -> Option<InfixOperator> {
  return match selected {
    Member.UsizeAdd => Option.some<InfixOperator>(InfixOperator.Add)
    Member.I32Add => Option.some<InfixOperator>(InfixOperator.Add)
    Member.I32Subtract => Option.some<InfixOperator>(InfixOperator.Subtract)
    Member.I32Multiply => Option.some<InfixOperator>(InfixOperator.Multiply)
    Member.I32Divide => Option.some<InfixOperator>(InfixOperator.Divide)
    Member.I32Remainder => Option.some<InfixOperator>(InfixOperator.Remainder)
    Member.I32Equals => Option.some<InfixOperator>(InfixOperator.Equals)
    Member.I32NotEquals => Option.some<InfixOperator>(InfixOperator.NotEquals)
    Member.I32LessThan => Option.some<InfixOperator>(InfixOperator.LessThan)
    Member.I32LessOrEqual => Option.some<InfixOperator>(InfixOperator.LessOrEqual)
    Member.I32GreaterThan => Option.some<InfixOperator>(InfixOperator.GreaterThan)
    Member.I32GreaterOrEqual => Option.some<InfixOperator>(InfixOperator.GreaterOrEqual)
    Member.I32BitAnd => Option.some<InfixOperator>(InfixOperator.BitAnd)
    Member.I32BitOr => Option.some<InfixOperator>(InfixOperator.BitOr)
    Member.I32BitXor => Option.some<InfixOperator>(InfixOperator.BitXor)
    Member.BoolEquals => Option.some<InfixOperator>(InfixOperator.Equals)
    Member.BoolNotEquals => Option.some<InfixOperator>(InfixOperator.NotEquals)
    _ => Option.none<InfixOperator>()
  }
}

/// The eager unary MIR operation for a selected scalar primitive.
pub fn unary(selected: Member) -> Option<PrefixOperator> {
  return match selected {
    Member.I32Negate => Option.some<PrefixOperator>(PrefixOperator.Negate)
    Member.I32BitNot => Option.some<PrefixOperator>(PrefixOperator.BitwiseNot)
    Member.BoolNot => Option.some<PrefixOperator>(PrefixOperator.Not)
    _ => Option.none<PrefixOperator>()
  }
}

/// Whether lowering reinterprets equal-width floating-point and integer representations.
pub fn isBitcast(selected: Member) -> bool {
  return selected == Member.F32ToBits || selected == Member.F32FromBits || selected == Member.F64ToBits || selected == Member.F64FromBits
}

/// The canonical less-than primitive takes shared scalar references.
pub fn borrowsOperands(selected: Member) -> bool {
  return selected == Member.I32LessThan
}
