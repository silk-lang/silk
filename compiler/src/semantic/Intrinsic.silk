//! Checked identity for the sealed source-callable compiler primitives.
//!
//! # Details
//! The semantic resolver authenticates the sealed `Intrinsic` namespace before asking this actor
//! to select a closed member. Ordinary library declarations never acquire an intrinsic identity.
//! Scalar operations come from the product catalog in [`ScalarOperation`]; every other member is
//! one named [`Primitive`].

import hir.Hir {Access, CallableMode, Multiplicity, OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Lifetime {Intersection, Lifetime}
import semantic.ScalarOperation {Scalar, ScalarOperation}
import semantic.Type {Argument, Outlives, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One named compiler primitive with a dedicated contract.
pub enum Primitive {
  TargetPointerBits,
  TargetPointerAlignment,
  TargetArchitecture,
  TargetOperatingSystem,
  TargetAbi,
  TargetObjectFormat,
  TargetEndianness,
  ProfileText,
  ProfileFlag,
  ProfileContains,
  StaticTextByteLength,
  StaticTextByteAt,
  StaticTextConcat,
  StaticTextSlice,
  /// `pointerFromSlice<T>(values: &[T]) -> ?[*]const T`: the address of a shared slice.
  PointerFromSlice,
  /// `pointerFromMutSlice<T>(values: &mut [T]) -> ?[*]mut T`: the address of an exclusive slice.
  PointerFromMutSlice,
  /// `pointerFromRef<T>(value: &T) -> *const T`: the address of a shared referent.
  PointerFromRef,
  /// `pointerFromMutRef<T>(value: &mut T) -> *mut T`: the address of an exclusive referent.
  PointerFromMutRef,
  /// `pointerAt<T>(pointer: [*]const T, index: usize) -> *const T`.
  PointerAt,
  /// `pointerAtMut<T>(pointer: [*]mut T, index: usize) -> *mut T`.
  PointerAtMut,
  /// `pointerRead<T>(pointer: *const T) -> T`: one naturally aligned `Copy` value.
  PointerRead,
  /// `pointerWrite<T>(pointer: *mut T, value: T) -> ()`: one naturally aligned store.
  PointerWrite,
  /// `pointerReadUnaligned<T>(pointer: *const align(1) T) -> T`: one byte-aligned `Copy` value.
  PointerReadUnaligned,
  /// `pointerWriteUnaligned<T>(pointer: *mut align(1) T, value: T) -> ()`: one byte-aligned store.
  PointerWriteUnaligned,
  /// `pointerRequalify<From, To>(pointer: From) -> To`: the same pointee under other qualifiers.
  PointerRequalify,
  /// `pointerReinterpret<From, To>(pointer: From) -> To`: another pointee under equal qualifiers.
  PointerReinterpret,
  /// `pointerBytes<T>(pointer: ?*const T) -> ?[*]const u8`: the same address as readonly bytes.
  PointerBytes,
  /// `pointerAddress<P>(pointer: P) -> usize`: the numeric address of a data pointer.
  PointerAddress,
  /// `pointerIsNull<P>(pointer: P) -> bool`: whether a data pointer is null.
  PointerIsNull,
  /// `pointerNull<T>() -> ?*mut T`: the null single-element pointer.
  PointerNull,
  /// `sliceView<T>(values: &[T], offset: usize, length: usize) -> &[T]`: a bounds-checked
  /// subrange with the same loan; an out-of-range offset or length traps.
  SliceView,
  /// `observeUnhandled()`: reports the selected failure's context to the lexical observer and
  /// returns its policy, or `0` without a selected failure (failure observer note N4).
  ObserveUnhandled,
  /// `reflectType<Owner>()`: the phase-only descriptor of one aggregate type.
  ReflectType,
  /// `reflectTypeKind<Owner>(descriptor)`: the stable aggregate-kind code of a descriptor.
  ReflectTypeKind,
  ReflectFields,
  ReflectFieldKind,
  ReflectFieldLabel,
  ReflectFieldOrdinal,
  BorrowField,
  /// Immutable, phase-only homogeneous sequence construction.
  StaticSequenceEmpty,
  StaticSequenceAppend,
  StaticSequenceConcat,
  StaticSequenceLength,
  StaticSequenceAt,
  /// `assembly<Result>(template, constraints, clobbers, memory, sideEffects, noReturn, inputs)`:
  /// one function-local machine fragment with literal metadata (ASSEMBLY-001).
  Assembly,
  /// `stringEqualsExact(left: string, right: string) -> bool`: exact UTF-8 byte equality (TEXT-001).
  StringEqualsExact,
  /// `tests() -> Tests`: the static catalog of the request's discovery root (TEST-004).
  Tests,
  /// `testInfo<F>(descriptor: Test<F>) -> TestInfo`: one test's static metadata.
  TestInfo,
  /// `testFunction<F>(static descriptor: Test<F>) -> F`: one test's exact runtime callable.
  TestFunction,
}

/// One compiler primitive after sealed namespace and type-contract selection.
pub union Member {
  /// One named primitive.
  Primitive {pub primitive: Primitive},
  /// One operation of the closed scalar catalog.
  Scalar {pub operation: ScalarOperation},
}

impl Copy for Member {}

/// A closed parameter or result in a compiler contract that takes no type arguments.
pub union ValueKind {
  /// One scalar passed or returned by value.
  Scalar {pub scalar: Scalar},
  /// A shared reference to one scalar.
  Borrowed {pub scalar: Scalar},
  /// Text of any lifetime.
  Text,
  /// Program-lifetime text.
  StaticText,
}

impl Copy for ValueKind {}

// Every named primitive in declaration order.
fn primitives() -> [Primitive; 49] {
  return [
    Primitive.TargetPointerBits, Primitive.TargetPointerAlignment, Primitive.TargetArchitecture,
    Primitive.TargetOperatingSystem, Primitive.TargetAbi, Primitive.TargetObjectFormat,
    Primitive.TargetEndianness, Primitive.ProfileText, Primitive.ProfileFlag, Primitive.ProfileContains,
    Primitive.StaticTextByteLength, Primitive.StaticTextByteAt, Primitive.StaticTextConcat,
    Primitive.StaticTextSlice, Primitive.PointerFromSlice, Primitive.PointerFromMutSlice,
    Primitive.PointerFromRef, Primitive.PointerFromMutRef, Primitive.PointerAt, Primitive.PointerAtMut,
    Primitive.PointerRead, Primitive.PointerWrite, Primitive.PointerReadUnaligned,
    Primitive.PointerWriteUnaligned, Primitive.PointerRequalify, Primitive.PointerReinterpret,
    Primitive.PointerBytes, Primitive.PointerAddress, Primitive.PointerIsNull, Primitive.PointerNull,
    Primitive.SliceView, Primitive.ObserveUnhandled, Primitive.ReflectType, Primitive.ReflectTypeKind, Primitive.ReflectFields, Primitive.ReflectFieldKind, Primitive.ReflectFieldLabel, Primitive.ReflectFieldOrdinal, Primitive.BorrowField, Primitive.StaticSequenceEmpty, Primitive.StaticSequenceAppend, Primitive.StaticSequenceConcat, Primitive.StaticSequenceLength, Primitive.StaticSequenceAt,
    Primitive.Assembly, Primitive.StringEqualsExact, Primitive.Tests, Primitive.TestInfo, Primitive.TestFunction,
  ]
}

/// The canonical member spelling of a named primitive.
pub fn spelling(primitive: Primitive) -> &'static [u8] {
  return match primitive {
    Primitive.TargetPointerBits => b"targetPointerBits"
    Primitive.TargetPointerAlignment => b"targetPointerAlignment"
    Primitive.TargetArchitecture => b"targetArchitecture"
    Primitive.TargetOperatingSystem => b"targetOperatingSystem"
    Primitive.TargetAbi => b"targetAbi"
    Primitive.TargetObjectFormat => b"targetObjectFormat"
    Primitive.TargetEndianness => b"targetEndianness"
    Primitive.ProfileText => b"profileText"
    Primitive.ProfileFlag => b"profileFlag"
    Primitive.ProfileContains => b"profileContains"
    Primitive.StaticTextByteLength => b"staticTextByteLength"
    Primitive.StaticTextByteAt => b"staticTextByteAt"
    Primitive.StaticTextConcat => b"staticTextConcat"
    Primitive.StaticTextSlice => b"staticTextSlice"
    Primitive.PointerFromSlice => b"pointerFromSlice"
    Primitive.PointerFromMutSlice => b"pointerFromMutSlice"
    Primitive.PointerFromRef => b"pointerFromRef"
    Primitive.PointerFromMutRef => b"pointerFromMutRef"
    Primitive.PointerAt => b"pointerAt"
    Primitive.PointerAtMut => b"pointerAtMut"
    Primitive.PointerRead => b"pointerRead"
    Primitive.PointerWrite => b"pointerWrite"
    Primitive.PointerReadUnaligned => b"pointerReadUnaligned"
    Primitive.PointerWriteUnaligned => b"pointerWriteUnaligned"
    Primitive.PointerRequalify => b"pointerRequalify"
    Primitive.PointerReinterpret => b"pointerReinterpret"
    Primitive.PointerBytes => b"pointerBytes"
    Primitive.PointerAddress => b"pointerAddress"
    Primitive.PointerIsNull => b"pointerIsNull"
    Primitive.PointerNull => b"pointerNull"
    Primitive.SliceView => b"sliceView"
    Primitive.ObserveUnhandled => b"observeUnhandled"
    Primitive.ReflectType => b"reflectType"
    Primitive.ReflectTypeKind => b"reflectTypeKind"
    Primitive.ReflectFields => b"reflectFields"
    Primitive.ReflectFieldKind => b"reflectFieldKind"
    Primitive.ReflectFieldLabel => b"reflectFieldLabel"
    Primitive.ReflectFieldOrdinal => b"reflectFieldOrdinal"
    Primitive.BorrowField => b"borrowField"
    Primitive.StaticSequenceEmpty => b"staticSequenceEmpty"
    Primitive.StaticSequenceAppend => b"staticSequenceAppend"
    Primitive.StaticSequenceConcat => b"staticSequenceConcat"
    Primitive.StaticSequenceLength => b"staticSequenceLength"
    Primitive.StaticSequenceAt => b"staticSequenceAt"
    Primitive.Assembly => b"assembly"
    Primitive.StringEqualsExact => b"stringEqualsExact"
    Primitive.Tests => b"tests"
    Primitive.TestInfo => b"testInfo"
    Primitive.TestFunction => b"testFunction"
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Looks up a closed member after the caller authenticates the sealed namespace.
pub fn lookup(name: &[u8]) -> Option<Member> {
  let table = primitives()
  let named: &[Primitive] = &table
  let mut at = usize.ZERO
  while at < named.length {
    if same(name, spelling(named[at])) {
      return Option<Member>.some(Member.Primitive {primitive: named[at]})
    }
    at = at + usize.ONE
  }
  return match move ScalarOperation.lookup(name) {
    Option<ScalarOperation>.Some {value} => Option<Member>.some(Member.Scalar {operation: value})
    Option<ScalarOperation>.None => Option<Member>.none()
  }
}

/// Whether a selected member is the named primitive `wanted`.
pub fn isPrimitive(selected: Member, wanted: Primitive) -> bool {
  return match selected {
    Member.Primitive {primitive} => primitive == wanted
    Member.Scalar {..} => false
  }
}

/// Whether the selected primitive belongs to residual runtime code.
pub fn isRuntime(selected: Member) -> bool {
  return match selected {
    Member.Scalar {..} => true
    Member.Primitive {primitive} => (isGeneric(selected) && !isSequence(selected)) || primitive == Primitive.ObserveUnhandled ||
      primitive == Primitive.BorrowField || primitive == Primitive.StringEqualsExact || primitive == Primitive.TestFunction
  }
}

/// Whether a member contract takes ordinary type arguments. Runtime pointer/view primitives
/// and phase-only sequence constructors share this instantiation rule; reflection is separate.
pub fn isGeneric(selected: Member) -> bool {
  return match selected {
    Member.Scalar {..} => false
    Member.Primitive {primitive} => match primitive {
      Primitive.PointerFromSlice => true
      Primitive.PointerFromMutSlice => true
      Primitive.PointerFromRef => true
      Primitive.PointerFromMutRef => true
      Primitive.PointerAt => true
      Primitive.PointerAtMut => true
      Primitive.PointerRead => true
      Primitive.PointerWrite => true
      Primitive.PointerReadUnaligned => true
      Primitive.PointerWriteUnaligned => true
      Primitive.PointerRequalify => true
      Primitive.PointerReinterpret => true
      Primitive.PointerBytes => true
      Primitive.PointerAddress => true
      Primitive.PointerIsNull => true
      Primitive.PointerNull => true
      Primitive.SliceView => true
      Primitive.StaticSequenceEmpty => true
      Primitive.StaticSequenceAppend => true
      Primitive.StaticSequenceConcat => true
      Primitive.StaticSequenceLength => true
      Primitive.StaticSequenceAt => true
      Primitive.Assembly => true
      _ => false
    }
  }
}

/// Whether a member is one of the test-discovery operations, whose contracts name the sealed test
/// families rather than closed [`ValueKind`]s (TEST-004).
pub fn isTestDiscovery(selected: Member) -> bool {
  return isPrimitive(selected, Primitive.Tests) || isPrimitive(selected, Primitive.TestInfo) ||
    isPrimitive(selected, Primitive.TestFunction)
}

/// Whether a member is static aggregate reflection. Reflection takes its owner from the call's one
/// type argument, so its contract is not a closed [`ValueKind`] signature.
pub fn isReflection(selected: Member) -> bool {
  return isPrimitive(selected, Primitive.ReflectType) || isPrimitive(selected, Primitive.ReflectTypeKind) ||
    isPrimitive(selected, Primitive.ReflectFields) || isPrimitive(selected, Primitive.ReflectFieldKind) ||
    isPrimitive(selected, Primitive.ReflectFieldLabel) || isPrimitive(selected, Primitive.ReflectFieldOrdinal)
}

/// The exact number of type arguments a member requires. A checked scalar operation takes the
/// result type `R` of its carriers.
pub fn typeArity(selected: Member) -> usize {
  return match selected {
    Member.Scalar {operation} => {
      if ScalarOperation.checked(operation) { return usize.ONE }
      return usize.ZERO
    }
    Member.Primitive {primitive} => {
      if primitive == Primitive.PointerRequalify || primitive == Primitive.PointerReinterpret || primitive == Primitive.BorrowField ||
        primitive == Primitive.ReflectFieldKind || primitive == Primitive.ReflectFieldLabel || primitive == Primitive.ReflectFieldOrdinal { return 2 }
      if isGeneric(selected) || isReflection(selected) { return usize.ONE }
      return usize.ZERO
    }
  }
}

/// Whether invoking the member requires an unsafe context or acknowledgement.
pub fn isUnsafe(selected: Member) -> bool {
  return match selected {
    Member.Scalar {..} => false
    Member.Primitive {primitive} => match primitive {
      Primitive.PointerAt => true
      Primitive.PointerAtMut => true
      Primitive.PointerRead => true
      Primitive.PointerWrite => true
      Primitive.PointerReadUnaligned => true
      Primitive.PointerWriteUnaligned => true
      Primitive.PointerRequalify => true
      Primitive.PointerReinterpret => true
      Primitive.PointerBytes => true
      Primitive.Assembly => true
      _ => false
    }
  }
}

/// The exact number of arguments accepted by one sealed member.
pub fn arity(selected: Member) -> usize {
  return match selected {
    Member.Scalar {operation} => {
      if ScalarOperation.checked(operation) { return ScalarOperation.arity(operation) + 2 }
      return ScalarOperation.arity(operation)
    }
    Member.Primitive {primitive} => match primitive {
      Primitive.ProfileText => usize.ONE
      Primitive.ProfileFlag => usize.ONE
      Primitive.ProfileContains => 2
      Primitive.StaticTextByteLength => usize.ONE
      Primitive.StaticTextByteAt => 2
      Primitive.StaticTextConcat => 2
      Primitive.StaticTextSlice => 3
      Primitive.PointerFromSlice => usize.ONE
      Primitive.PointerFromMutSlice => usize.ONE
      Primitive.PointerFromRef => usize.ONE
      Primitive.PointerFromMutRef => usize.ONE
      Primitive.PointerAt => 2
      Primitive.PointerAtMut => 2
      Primitive.PointerRead => usize.ONE
      Primitive.PointerWrite => 2
      Primitive.PointerReadUnaligned => usize.ONE
      Primitive.PointerWriteUnaligned => 2
      Primitive.PointerRequalify => usize.ONE
      Primitive.PointerReinterpret => usize.ONE
      Primitive.PointerBytes => usize.ONE
      Primitive.PointerAddress => usize.ONE
      Primitive.PointerIsNull => usize.ONE
      Primitive.SliceView => 3
      Primitive.ReflectTypeKind => usize.ONE
      Primitive.ReflectFieldKind => usize.ONE
      Primitive.ReflectFieldLabel => usize.ONE
      Primitive.ReflectFieldOrdinal => usize.ONE
      Primitive.BorrowField => 2
      Primitive.StaticSequenceAppend => 2
      Primitive.StaticSequenceConcat => 2
      Primitive.StaticSequenceLength => usize.ONE
      Primitive.StaticSequenceAt => 2
      Primitive.Assembly => 7
      Primitive.StringEqualsExact => 2
      Primitive.TestInfo => usize.ONE
      Primitive.TestFunction => usize.ONE
      _ => usize.ZERO
    }
  }
}

fn scalarKind(scalar: Scalar) -> Option<ValueKind> {
  return Option<ValueKind>.some(ValueKind.Scalar {scalar: scalar})
}

/// The argument index of a checked scalar operation's `present` carrier; `absent` follows it.
pub fn carrierStart(selected: Member) -> Option<usize> {
  return match selected {
    Member.Scalar {operation} => {
      if ScalarOperation.checked(operation) { return Option<usize>.some(ScalarOperation.arity(operation)) }
      return Option<usize>.none()
    }
    Member.Primitive {..} => Option<usize>.none()
  }
}

/// The contract of a checked operation's carrier at `index`. `present` is `once fn(V) -> R` for
/// the produced scalar `V`, and `absent` is `once fn() -> R`; `R` is the call's type argument.
/// The carriers retain no loan of the call.
pub effect fn carrierContract(selected: Member, typeArguments: &[Shared<Type>], index: usize) -> Option<Shared<Type>>
! OutOfMemoryError
? &mut Allocator {
  let start = match move carrierStart(selected) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<Shared<Type>>.none() }
  }
  if typeArguments.length != usize.ONE || index < start || index > start + usize.ONE { return Option<Shared<Type>>.none() }
  let mut parameters = Vector<Shared<Type>>.make()
  if index == start {
    if let Member.Scalar {operation} = selected {
      run Vector<Shared<Type>>.append(&mut parameters, run scalarType(ScalarOperation.result(operation)))
    }
  }
  let none = Vector<Shared<Lifetime>>.make()
  return Option<Shared<Type>>.some(run Shared<Type>.make(Type.Callable {
    mode: CallableMode.Once,
    isUnsafe: false,
    environment: run Shared<Intersection>.make(run Intersection.of(Vector<Shared<Lifetime>>.asSlice(&none))),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX,
    invocationBounds: Vector<Outlives>.make(),
    parameters: move parameters,
    result: Shared<Type>.clone(&typeArguments[usize.ZERO]),
  }))
}

/// The expected closed parameter at `index`, or absence past the arity, for a carrier of a checked
/// scalar operation, and for a member whose contract depends on type arguments.
pub fn parameterKind(selected: Member, index: usize) -> Option<ValueKind> {
  if isReflection(selected) || isGeneric(selected) || isTestDiscovery(selected) { return Option<ValueKind>.none() }
  return match selected {
    Member.Scalar {operation} => {
      if index >= ScalarOperation.arity(operation) { return Option<ValueKind>.none() }
      if ScalarOperation.borrows(operation) {
        return Option<ValueKind>.some(ValueKind.Borrowed {scalar: ScalarOperation.operand(operation)})
      }
      return scalarKind(ScalarOperation.operand(operation))
    }
    Member.Primitive {primitive} => {
      if index >= arity(selected) { return Option<ValueKind>.none() }
      if primitive == Primitive.StaticTextByteAt || primitive == Primitive.StaticTextSlice {
        if index == usize.ZERO { return Option<ValueKind>.some(ValueKind.Text) }
        return scalarKind(Scalar.Usize)
      }
      return Option<ValueKind>.some(ValueKind.Text)
    }
  }
}

/// The result that body checking can synthesize without a contextual expected type. A reflected
/// descriptor, a generic primitive, and a checked scalar operation's carrier result depend on the
/// call's type arguments, so they have no closed kind.
pub fn resultKind(selected: Member) -> Option<ValueKind> {
  if isGeneric(selected) || isPrimitive(selected, Primitive.ReflectType) || isPrimitive(selected, Primitive.ReflectFields) ||
    isPrimitive(selected, Primitive.BorrowField) || isTestDiscovery(selected) { return Option<ValueKind>.none() }
  return match selected {
    Member.Scalar {operation} => {
      if ScalarOperation.checked(operation) { return Option<ValueKind>.none() }
      return scalarKind(ScalarOperation.result(operation))
    }
    Member.Primitive {primitive} => match primitive {
      Primitive.ReflectTypeKind => scalarKind(Scalar.U8)
      Primitive.ReflectFieldKind => scalarKind(Scalar.U8)
      Primitive.ReflectFieldOrdinal => scalarKind(Scalar.Usize)
      Primitive.ObserveUnhandled => scalarKind(Scalar.Usize)
      Primitive.ProfileFlag => scalarKind(Scalar.Bool)
      Primitive.ProfileContains => scalarKind(Scalar.Bool)
      Primitive.TargetPointerBits => scalarKind(Scalar.U32)
      Primitive.TargetPointerAlignment => scalarKind(Scalar.U32)
      Primitive.StaticTextByteLength => scalarKind(Scalar.Usize)
      Primitive.StaticTextByteAt => scalarKind(Scalar.U8)
      Primitive.StringEqualsExact => scalarKind(Scalar.Bool)
      _ => Option<ValueKind>.some(ValueKind.StaticText)
    }
  }
}

/// Whether an argument must be checked with its parameter type as context: a by-value scalar
/// gives an integer or floating literal its type, while text and borrowed scalars carry their own.
pub fn contextual(kind: ValueKind) -> bool {
  return match kind {
    ValueKind.Scalar {..} => true
    _ => false
  }
}

fn primitiveNamed(value: &Type, name: &[u8]) -> bool {
  return match & value.* {
    Type.Primitive {name: selected} => same(Bytes.asSlice(&selected), name)
    _ => false
  }
}

fn isText(value: &Type) -> bool {
  return match & value.* {
    Type.String {..} => true
    _ => false
  }
}

fn isStaticLifetime(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Static => true
    _ => false
  }
}

fn isStaticText(value: &Type) -> bool {
  return match & value.* {
    Type.String {lifetime} => Shared<Lifetime>.with<bool>(&lifetime, isStaticLifetime)
    _ => false
  }
}

/// Checks one resolved semantic type against a closed contract entry.
pub fn matches(kind: ValueKind, value: &Type) -> bool {
  return match kind {
    ValueKind.Scalar {scalar} => primitiveNamed(value, ScalarOperation.scalarSpelling(scalar))
    ValueKind.Borrowed {scalar} => match &value.* {
      Type.Reference {access, referent, ..} => access == Access.Shared && Shared<Type>.with<bool>(&referent,
        fn(inner: &Type) -> bool { return primitiveNamed(inner, ScalarOperation.scalarSpelling(scalar)) })
      _ => false
    }
    ValueKind.Text => isText(value)
    ValueKind.StaticText => isStaticText(value)
  }
}

/// Whether a closed member accepts exactly these argument types and result.
pub fn accepts(selected: Member, arguments: &[Shared<Type>], result: &Type) -> bool {
  let kind = resultKind(selected)
  let closed = match move kind {
    Option<ValueKind>.Some {value} => matches(value, result)
    Option<ValueKind>.None => false
  }
  if arguments.length != arity(selected) || !closed {
    return false
  }
  let mut at = usize.ZERO
  while at < arguments.length {
    let expected = match move parameterKind(selected, at) {
      Option<ValueKind>.Some {value} => value
      Option<ValueKind>.None => {
        return false
      }
    }
    let correct = Shared<Type>.with<bool>(
      &arguments[at],
      fn(value: &Type) -> bool {
        return matches(expected, value)
      },
    )
    if !correct {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn pointerType(pointee: &Shared<Type>, access: Access, nullable: bool, multiplicity: Multiplicity,
  alignment: Option<u64>) -> Shared<Type>
! OutOfMemoryError
? &mut Allocator {
  return run Shared<Type>.make(Type.Pointer {
    pointee: Shared<Type>.clone(pointee),
    access: access,
    nullable: nullable,
    multiplicity: multiplicity,
    alignment: move alignment,
  })
}

effect fn natural(pointee: &Shared<Type>, access: Access, nullable: bool, multiplicity: Multiplicity) -> Shared<Type>
! OutOfMemoryError
? &mut Allocator {
  return run pointerType(pointee, access, nullable, multiplicity, Option<u64>.none())
}

effect fn byteAligned(pointee: &Shared<Type>, access: Access) -> Shared<Type>
! OutOfMemoryError
? &mut Allocator {
  return run pointerType(pointee, access, false, Multiplicity.Single, Option<u64>.some(1))
}

/// The primitive type of one compiler-known scalar.
pub effect fn scalarType(scalar: Scalar) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared<Type>.make(Type.Primitive {name: run Bytes.copy(ScalarOperation.scalarSpelling(scalar))})
}

/// The instantiated type of a generic member's argument at `index`. An argument that is a
/// reference or slice of the type argument has no single expected type, since its loan belongs
/// to the caller, and answers `None`; [`genericArgument`] checks it structurally.
pub effect fn genericParameter(selected: Member, typeArguments: &[Shared<Type>], index: usize) -> Option<Shared<Type>>
! InvalidModulePath | OutOfMemoryError
? &mut Allocator {
  if !isGeneric(selected) || typeArguments.length != typeArity(selected) || index >= arity(selected) {
    return Option<Shared<Type>>.none()
  }
  let first = &typeArguments[usize.ZERO]
  let primitive = match selected {
    Member.Primitive {primitive: named} => named
    Member.Scalar {..} => { return Option<Shared<Type>>.none() }
  }
  if primitive == Primitive.StaticSequenceAppend {
    if index == usize.ZERO { return Option<Shared<Type>>.some(run staticSequenceType(first)) }
    return Option<Shared<Type>>.some(Shared<Type>.clone(first))
  }
  if (primitive == Primitive.PointerAt || primitive == Primitive.PointerAtMut || primitive == Primitive.SliceView) && index != usize.ZERO {
    return Option<Shared<Type>>.some(run scalarType(Scalar.Usize))
  }
  if (primitive == Primitive.PointerWrite || primitive == Primitive.PointerWriteUnaligned) && index == usize.ONE {
    return Option<Shared<Type>>.some(Shared<Type>.clone(first))
  }
  // Four literal metadata strings, two literal flags, then the operand tuple checked by
  // [`genericArgument`].
  if primitive == Primitive.Assembly {
    if index < 4 { return Option<Shared<Type>>.some(run Shared<Type>.make(Type.String {lifetime: run Shared<Lifetime>.make(Lifetime.Static)})) }
    if index < 6 { return Option<Shared<Type>>.some(run scalarType(Scalar.Bool)) }
    return Option<Shared<Type>>.none()
  }
  return match primitive {
    Primitive.PointerAt => Option<Shared<Type>>.some(run natural(first, Access.Shared, false, Multiplicity.Many))
    Primitive.PointerAtMut => Option<Shared<Type>>.some(run natural(first, Access.Mutable, false, Multiplicity.Many))
    Primitive.PointerRead => Option<Shared<Type>>.some(run natural(first, Access.Shared, false, Multiplicity.Single))
    Primitive.PointerWrite => Option<Shared<Type>>.some(run natural(first, Access.Mutable, false, Multiplicity.Single))
    Primitive.PointerReadUnaligned => Option<Shared<Type>>.some(run byteAligned(first, Access.Shared))
    Primitive.PointerWriteUnaligned => Option<Shared<Type>>.some(run byteAligned(first, Access.Mutable))
    Primitive.PointerBytes => Option<Shared<Type>>.some(run natural(first, Access.Shared, true, Multiplicity.Single))
    Primitive.PointerRequalify => Option<Shared<Type>>.some(Shared<Type>.clone(first))
    Primitive.PointerReinterpret => Option<Shared<Type>>.some(Shared<Type>.clone(first))
    Primitive.PointerAddress => Option<Shared<Type>>.some(Shared<Type>.clone(first))
    Primitive.PointerIsNull => Option<Shared<Type>>.some(Shared<Type>.clone(first))
    _ => Option<Shared<Type>>.none()
  }
}

/// Checks an argument without a single expected type: a slice or reference of exactly the type
/// argument, with the access the member requires. An exclusive view does not weaken implicitly.
pub effect fn genericArgument(selected: Member, typeArguments: &[Shared<Type>], index: usize, argument: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if typeArguments.length != typeArity(selected) || typeArguments.length == usize.ZERO { return false }
  // The operand tuple: unit or one positional anonymous tuple; lanes are the assembly contract's.
  if isPrimitive(selected, Primitive.Assembly) {
    return index == 6 && Shared<Type>.with<bool>(argument, fn(value: &Type) -> bool {
      return match &value.* {
        Type.Unit => true
        Type.Anonymous {..} => true
        _ => false
      }
    })
  }
  if index != usize.ZERO { return false }
  let element = &typeArguments[usize.ZERO]
  if isPrimitive(selected, Primitive.PointerFromSlice) || isPrimitive(selected, Primitive.SliceView) {
    return run views(argument, element, Access.Shared, true)
  }
  if isPrimitive(selected, Primitive.PointerFromMutSlice) { return run views(argument, element, Access.Mutable, true) }
  if isPrimitive(selected, Primitive.PointerFromRef) { return run views(argument, element, Access.Shared, false) }
  if isPrimitive(selected, Primitive.PointerFromMutRef) { return run views(argument, element, Access.Mutable, false) }
  return false
}

// Whether `argument` is a slice (or reference) of exactly `element` with exactly `access`.
effect fn views(argument: &Shared<Type>, element: &Shared<Type>, access: Access, slice: bool) -> bool
! OutOfMemoryError
? &mut Allocator {
  let viewed = Shared<Type>.with<Option<Shared<Type>>>(argument, fn(value: &Type) -> Option<Shared<Type>> {
    return match &value.* {
      Type.Slice {element: selected, access: written, ..} => {
        if !slice || written != access { return Option<Shared<Type>>.none() }
        return Option<Shared<Type>>.some(Shared<Type>.clone(&selected))
      }
      Type.Reference {referent, access: written, ..} => {
        if slice || written != access { return Option<Shared<Type>>.none() }
        return Option<Shared<Type>>.some(Shared<Type>.clone(&referent))
      }
      _ => Option<Shared<Type>>.none()
    }
  })
  if let Option<Shared<Type>>.Some {value} = move viewed {
    return run Type.equalsShared(&value, element)
  }
  return false
}

/// The instantiated result type of a generic member. `sliceView` returns its argument's own
/// slice type, so the caller supplies it from the checked argument instead.
pub effect fn genericResult(selected: Member, typeArguments: &[Shared<Type>]) -> Option<Shared<Type>>
! InvalidModulePath | OutOfMemoryError
? &mut Allocator {
  if !isGeneric(selected) || typeArguments.length != typeArity(selected) {
    return Option<Shared<Type>>.none()
  }
  let first = &typeArguments[usize.ZERO]
  let primitive = match selected {
    Member.Primitive {primitive: named} => named
    Member.Scalar {..} => { return Option<Shared<Type>>.none() }
  }
  if primitive == Primitive.StaticSequenceEmpty || primitive == Primitive.StaticSequenceAppend {
    return Option<Shared<Type>>.some(run staticSequenceType(first))
  }
  return match primitive {
    Primitive.PointerFromSlice => Option<Shared<Type>>.some(run natural(first, Access.Shared, true, Multiplicity.Many))
    Primitive.PointerFromMutSlice => Option<Shared<Type>>.some(run natural(first, Access.Mutable, true, Multiplicity.Many))
    Primitive.PointerFromRef => Option<Shared<Type>>.some(run natural(first, Access.Shared, false, Multiplicity.Single))
    Primitive.PointerFromMutRef => Option<Shared<Type>>.some(run natural(first, Access.Mutable, false, Multiplicity.Single))
    Primitive.PointerAt => Option<Shared<Type>>.some(run natural(first, Access.Shared, false, Multiplicity.Single))
    Primitive.PointerAtMut => Option<Shared<Type>>.some(run natural(first, Access.Mutable, false, Multiplicity.Single))
    Primitive.PointerRead => Option<Shared<Type>>.some(Shared<Type>.clone(first))
    Primitive.PointerReadUnaligned => Option<Shared<Type>>.some(Shared<Type>.clone(first))
    Primitive.PointerWrite => Option<Shared<Type>>.some(run Shared<Type>.make(Type.Unit))
    Primitive.PointerWriteUnaligned => Option<Shared<Type>>.some(run Shared<Type>.make(Type.Unit))
    Primitive.PointerRequalify => Option<Shared<Type>>.some(Shared<Type>.clone(&typeArguments[usize.ONE]))
    Primitive.PointerReinterpret => Option<Shared<Type>>.some(Shared<Type>.clone(&typeArguments[usize.ONE]))
    Primitive.PointerBytes => {
      let byte = run scalarType(Scalar.U8)
      return Option<Shared<Type>>.some(run natural(&byte, Access.Shared, true, Multiplicity.Many))
    }
    Primitive.PointerAddress => Option<Shared<Type>>.some(run scalarType(Scalar.Usize))
    Primitive.PointerIsNull => Option<Shared<Type>>.some(run scalarType(Scalar.Bool))
    Primitive.PointerNull => Option<Shared<Type>>.some(run natural(first, Access.Mutable, true, Multiplicity.Single))
    Primitive.Assembly => Option<Shared<Type>>.some(Shared<Type>.clone(first))
    _ => Option<Shared<Type>>.none()
  }
}

/// Whether the member's pointer type arguments satisfy its qualifier rule: requalification keeps
/// one invariant pointee, reinterpretation keeps every qualifier, and address observation and the
/// null test take a data pointer. Other members have no qualifier rule.
pub effect fn qualifies(selected: Member, typeArguments: &[Shared<Type>]) -> bool
! OutOfMemoryError
? &mut Allocator {
  if typeArguments.length != typeArity(selected) { return false }
  if isPrimitive(selected, Primitive.PointerAddress) || isPrimitive(selected, Primitive.PointerIsNull) {
    return Shared<Type>.with<bool>(&typeArguments[usize.ZERO], fn(value: &Type) -> bool {
      return match &value.* {
        Type.Pointer {..} => true
        _ => false
      }
    })
  }
  if isPrimitive(selected, Primitive.PointerRequalify) {
    let source = Shared<Type>.with<Option<Shared<Type>>>(&typeArguments[usize.ZERO], pointee)
    let destination = Shared<Type>.with<Option<Shared<Type>>>(&typeArguments[usize.ONE], pointee)
    if let Option<Shared<Type>>.Some {value: left} = move source {
      if let Option<Shared<Type>>.Some {value: right} = move destination {
        return run Type.equalsShared(&left, &right)
      }
    }
    return false
  }
  if isPrimitive(selected, Primitive.PointerReinterpret) {
    let from = Shared<Type>.with<Option<Qualifiers>>(&typeArguments[usize.ZERO], qualifiers)
    let to = Shared<Type>.with<Option<Qualifiers>>(&typeArguments[usize.ONE], qualifiers)
    if let Option<Qualifiers>.Some {value: left} = move from {
      if let Option<Qualifiers>.Some {value: right} = move to {
        return left.access == right.access && left.nullable == right.nullable && left.multiplicity == right.multiplicity
      }
    }
    return false
  }
  return true
}

struct Qualifiers {
  access: Access
  nullable: bool
  multiplicity: Multiplicity
}

fn qualifiers(value: &Type) -> Option<Qualifiers> {
  return match &value.* {
    Type.Pointer {access, nullable, multiplicity, ..} => Option<Qualifiers>.some(Qualifiers {
      access: access, nullable: nullable, multiplicity: multiplicity,
    })
    _ => Option<Qualifiers>.none()
  }
}

fn pointee(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.Pointer {pointee: target, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&target))
    _ => Option<Shared<Type>>.none()
  }
}

/// Whether a sealed primitive is phase-only sequence construction.
pub fn isSequence(member: Member) -> bool {
  return isPrimitive(member, Primitive.StaticSequenceEmpty) || isPrimitive(member, Primitive.StaticSequenceAppend) || sequencePending(member)
}

/// The canonical identity of the sealed, layout-free StaticSequence family.
pub effect fn staticSequenceType(element: &Shared<Type>) -> Shared<Type>
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"compiler-sealed-intrinsic", b"silk", b"Intrinsic")
  let mut steps = Vector<OwnerStep>.make()
  run Vector<OwnerStep>.append(&mut steps, OwnerStep {
    kind: OwnerKind.Struct, name: Option<Bytes>.some(run Bytes.copy(b"StaticSequence")), occurrence: usize.ZERO,
  })
  let mut arguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut arguments, Argument.Type {value: Shared<Type>.clone(element)})
  return run Shared<Type>.make(Type.Nominal {
    declaration: run DeclarationId.fromParts(move module, move steps), isPublic: true, arguments: move arguments,
  })
}

/// The exact element of a genuine sealed StaticSequence; authored nominal lookalikes never match.
pub fn staticSequenceElement(value: &Type) -> Option<Shared<Type>> {
  if let Type.Nominal {declaration, arguments, ..} = &value.* {
    let module = DeclarationId.moduleId(&declaration)
    if !ModuleId.matches(module, b"compiler-sealed-intrinsic", b"silk", b"Intrinsic") || DeclarationId.ownerCount(&declaration) != usize.ONE {
      return Option<Shared<Type>>.none()
    }
    if DeclarationId.ownerKind(&declaration, usize.ZERO) != OwnerKind.Struct
      || DeclarationId.ownerOccurrence(&declaration, usize.ZERO) != usize.ZERO || !DeclarationId.ownerNamed(&declaration, usize.ZERO)
      || !DeclarationId.ownerNamedAs(&declaration, usize.ZERO, b"StaticSequence") { return Option<Shared<Type>>.none() }
    let supplied = Vector<Argument>.asSlice(&arguments)
    if supplied.length == usize.ONE {
      if let Argument.Type {value: element} = &supplied[usize.ZERO] {
        return Option<Shared<Type>>.some(Shared<Type>.clone(&element))
      }
    }
  }
  return Option<Shared<Type>>.none()
}


/// Valid sequence members whose checked evaluation contracts remain an explicit native gap.
pub fn sequencePending(member: Member) -> bool {
  return isPrimitive(member, Primitive.StaticSequenceConcat) || isPrimitive(member, Primitive.StaticSequenceLength) ||
    isPrimitive(member, Primitive.StaticSequenceAt)
}

/// The owner and exact substituted value type retained by one genuine sealed field type.
pub struct FieldTypes { pub owner: Shared<Type> pub value: Shared<Type> }

fn sealedFamily(value: &Type, name: &[u8]) -> bool {
  if let Type.Nominal {declaration, ..} = &value.* {
    let module = DeclarationId.moduleId(&declaration)
    return ModuleId.matches(module, b"compiler-sealed-intrinsic", b"silk", b"Intrinsic") && DeclarationId.ownerCount(&declaration) == usize.ONE &&
      DeclarationId.ownerKind(&declaration, usize.ZERO) == OwnerKind.Struct && DeclarationId.ownerOccurrence(&declaration, usize.ZERO) == usize.ZERO &&
      DeclarationId.ownerNamedAs(&declaration, usize.ZERO, name)
  }
  return false
}

effect fn reflectionFamily(name: &[u8], supplied: &[Shared<Type>]) -> Shared<Type>
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(b"compiler-sealed-intrinsic", b"silk", b"Intrinsic")
  let mut steps = Vector<OwnerStep>.make()
  run Vector<OwnerStep>.append(&mut steps, OwnerStep {kind: OwnerKind.Struct,
    name: Option<Bytes>.some(run Bytes.copy(name)), occurrence: usize.ZERO})
  let mut arguments = Vector<Argument>.make()
  let mut at = usize.ZERO
  while at < supplied.length {
    run Vector<Argument>.append(&mut arguments, Argument.Type {value: Shared<Type>.clone(&supplied[at])})
    at = at + usize.ONE
  }
  return run Shared<Type>.make(Type.Nominal {declaration: run DeclarationId.fromParts(move module, move steps),
    isPublic: true, arguments: move arguments})
}

pub effect fn fieldType(owner: &Shared<Type>, value: &Shared<Type>) -> Shared<Type>
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let arguments = [Shared<Type>.clone(owner), Shared<Type>.clone(value)]
  return run reflectionFamily(b"Field", &arguments)
}

pub effect fn fieldsType(owner: &Shared<Type>) -> Shared<Type>
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let arguments = [Shared<Type>.clone(owner)]
  return run reflectionFamily(b"Fields", &arguments)
}

pub fn fieldTypes(value: &Type) -> Option<FieldTypes> {
  if !sealedFamily(value, b"Field") { return Option<FieldTypes>.none() }
  if let Type.Nominal {arguments, ..} = &value.* {
    let supplied = Vector<Argument>.asSlice(&arguments)
    if supplied.length == 2 {
      if let Argument.Type {value: owner} = &supplied[usize.ZERO] {
        if let Argument.Type {value: field} = &supplied[usize.ONE] {
          return Option<FieldTypes>.some(FieldTypes {owner: Shared<Type>.clone(&owner), value: Shared<Type>.clone(&field)})
        }
      }
    }
  }
  return Option<FieldTypes>.none()
}

pub fn fieldsOwner(value: &Type) -> Option<Shared<Type>> {
  if !sealedFamily(value, b"Fields") { return Option<Shared<Type>>.none() }
  if let Type.Nominal {arguments, ..} = &value.* {
    let supplied = Vector<Argument>.asSlice(&arguments)
    if supplied.length == usize.ONE {
      if let Argument.Type {value: owner} = &supplied[usize.ZERO] { return Option<Shared<Type>>.some(Shared<Type>.clone(&owner)) }
    }
  }
  return Option<Shared<Type>>.none()
}

pub fn phaseOnlyFamily(value: &Type) -> bool {
  return sealedFamily(value, b"StaticSequence") || sealedFamily(value, b"Field") || sealedFamily(value, b"Fields") ||
    sealedFamily(value, b"Tests") || sealedFamily(value, b"Test")
}

/// The sealed `Intrinsic.Tests` catalog type (TEST-004).
pub effect fn testsType() -> Shared<Type> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let none = Vector<Shared<Type>>.make()
  return run reflectionFamily(b"Tests", Vector<Shared<Type>>.asSlice(&none))
}

/// The sealed `Intrinsic.Test<F>` descriptor of one test whose exact callable type is `callable`.
pub effect fn testType(callable: &Shared<Type>) -> Shared<Type> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let arguments = [Shared<Type>.clone(callable)]
  return run reflectionFamily(b"Test", &arguments)
}

/// The sealed `Intrinsic.TestInfo` metadata record.
pub effect fn testInfoType() -> Shared<Type> ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let none = Vector<Shared<Type>>.make()
  return run reflectionFamily(b"TestInfo", Vector<Shared<Type>>.asSlice(&none))
}

/// Whether a type is the genuine sealed `Intrinsic.Tests` catalog.
pub fn isTests(value: &Type) -> bool { return sealedFamily(value, b"Tests") }

/// Whether a type is the genuine sealed `Intrinsic.TestInfo` record.
pub fn isTestInfo(value: &Type) -> bool { return sealedFamily(value, b"TestInfo") }

/// The exact callable type retained by one genuine sealed `Intrinsic.Test<F>`.
pub fn testCallable(value: &Type) -> Option<Shared<Type>> {
  if !sealedFamily(value, b"Test") { return Option<Shared<Type>>.none() }
  if let Type.Nominal {arguments, ..} = &value.* {
    let supplied = Vector<Argument>.asSlice(&arguments)
    if supplied.length == usize.ONE {
      if let Argument.Type {value: callable} = &supplied[usize.ZERO] { return Option<Shared<Type>>.some(Shared<Type>.clone(&callable)) }
    }
  }
  return Option<Shared<Type>>.none()
}

/// The fields of `Intrinsic.TestInfo` in declaration order, matching the bootstrap's record. Every
/// field is program-lifetime text; no field is a source position (TEST-004).
pub fn testInfoFieldCount() -> usize { return 5 }

/// The name of `TestInfo` field `index`.
pub fn testInfoFieldName(index: usize) -> &'static [u8] {
  if index == usize.ZERO { return b"identity" }
  if index == usize.ONE { return b"name" }
  if index == 2 { return b"module" }
  if index == 3 { return b"path" }
  return b"fingerprint"
}
