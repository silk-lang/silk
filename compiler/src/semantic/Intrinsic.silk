//! Checked identity for the sealed source-callable compiler primitives.
//!
//! # Details
//! Selection requires the reserved, lexically unbound `Intrinsic` namespace and the complete
//! primitive contract. Ordinary library declarations never acquire an intrinsic identity.

import hir.Hir {HirId, Module, Node}
import semantic.Lifetime {Lifetime}
import semantic.Type {Type}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize

/// One compiler primitive after sealed namespace and type-contract selection.
pub enum Member {
  TargetPointerBits,
  TargetPointerAlignment,
  TargetArchitecture,
  TargetOperatingSystem,
  TargetAbi,
  TargetObjectFormat,
  TargetEndianness,
  StaticTextByteLength,
  StaticTextByteAt,
  StaticTextConcat,
  StaticTextSlice,
}

impl Copy for Member {}

/// A primitive parameter or result in the closed compiler contract.
pub enum ValueKind {
  U8,
  U32,
  Usize,
  Text,
  StaticText,
}

impl Copy for ValueKind {}

/// The exact number of arguments accepted by one sealed primitive.
pub fn arity(selected: Member) -> usize {
  if selected == Member.StaticTextByteLength { return usize.ONE }
  if selected == Member.StaticTextByteAt || selected == Member.StaticTextConcat { return 2 }
  if selected == Member.StaticTextSlice { return 3 }
  return usize.ZERO
}

/// The expected parameter at `index`, or absence past the primitive's arity.
pub fn parameterKind(selected: Member, index: usize) -> Option<ValueKind> {
  if index >= arity(selected) { return Option.none<ValueKind>() }
  if selected == Member.StaticTextByteLength || selected == Member.StaticTextConcat || index == usize.ZERO {
    return Option.some<ValueKind>(ValueKind.Text)
  }
  return Option.some<ValueKind>(ValueKind.Usize)
}

/// The result that body checking can synthesize without a contextual expected type.
pub fn resultKind(selected: Member) -> ValueKind {
  if selected == Member.TargetPointerBits || selected == Member.TargetPointerAlignment {
    return ValueKind.U32
  }
  if selected == Member.StaticTextByteLength { return ValueKind.Usize }
  if selected == Member.StaticTextByteAt { return ValueKind.U8 }
  return ValueKind.StaticText
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn name(module: &Module, id: HirId) -> Option<&[u8]> {
  return match Module.node(module, id) {
    Node.Name {text} => Option.some<&[u8]>(Module.text(module, text))
    _ => Option.none<&[u8]>()
  }
}

fn member(name: &[u8]) -> Option<Member> {
  if same(name, b"targetPointerBits") { return Option.some<Member>(Member.TargetPointerBits) }
  if same(name, b"targetPointerAlignment") { return Option.some<Member>(Member.TargetPointerAlignment) }
  if same(name, b"targetArchitecture") { return Option.some<Member>(Member.TargetArchitecture) }
  if same(name, b"targetOperatingSystem") { return Option.some<Member>(Member.TargetOperatingSystem) }
  if same(name, b"targetAbi") { return Option.some<Member>(Member.TargetAbi) }
  if same(name, b"targetObjectFormat") { return Option.some<Member>(Member.TargetObjectFormat) }
  if same(name, b"targetEndianness") { return Option.some<Member>(Member.TargetEndianness) }
  if same(name, b"staticTextByteLength") { return Option.some<Member>(Member.StaticTextByteLength) }
  if same(name, b"staticTextByteAt") { return Option.some<Member>(Member.StaticTextByteAt) }
  if same(name, b"staticTextConcat") { return Option.some<Member>(Member.StaticTextConcat) }
  if same(name, b"staticTextSlice") { return Option.some<Member>(Member.StaticTextSlice) }
  return Option.none<Member>()
}

fn primitive(value: &Type, name: &[u8]) -> bool {
  return match & value.* {
    Type.Primitive {name: selected} => same(Bytes.asSlice(&selected), name)
    _ => false
  }
}

fn isU8(value: &Type) -> bool { return primitive(value, b"u8") }
fn isU32(value: &Type) -> bool { return primitive(value, b"u32") }
fn isUsize(value: &Type) -> bool { return primitive(value, b"usize") }

fn isText(value: &Type) -> bool {
  return match & value.* {
    Type.String {..} => true
    _ => false
  }
}

fn isStaticLifetime(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Static => true
    _ => false
  }
}

fn isStaticText(value: &Type) -> bool {
  return match & value.* {
    Type.String {lifetime} => Shared.with<Lifetime, bool>(&lifetime, isStaticLifetime)
    _ => false
  }
}

/// Checks one resolved semantic type against a primitive contract entry.
pub fn matches(kind: ValueKind, value: &Type) -> bool {
  return match kind {
    ValueKind.U8 => isU8(value)
    ValueKind.U32 => isU32(value)
    ValueKind.Usize => isUsize(value)
    ValueKind.Text => isText(value)
    ValueKind.StaticText => isStaticText(value)
  }
}

pub fn accepts(selected: Member, arguments: &[Shared<Type>], result: &Type) -> bool {
  if arguments.length != arity(selected) || !matches(resultKind(selected), result) {
    return false
  }
  let mut at = usize.ZERO
  while at < arguments.length {
    let expected = match move parameterKind(selected, at) {
      Option<ValueKind>.Some {value} => value
      Option<ValueKind>.None => { return false }
    }
    let correct = Shared.with<Type, bool>(&arguments[at], fn(value: &Type) -> bool {
      return matches(expected, value)
    })
    if !correct { return false }
    at = at + usize.ONE
  }
  return true
}

/// Identifies the reserved, unbound Intrinsic namespace and one closed member before type checking.
/// The caller must also reject any unresolved ordinary name before admitting this field form.
pub fn identify(module: &Module, callee: HirId) -> Option<Member> {
  if let Node.FieldExpression {subject, field} = Module.node(module, callee) {
    if let Node.IdentifierExpression {name: namespace, binding} = Module.node(module, subject) {
      if binding.present { return Option.none<Member>() }
      let namespaceName = match move name(module, namespace) {
        Option<&[u8]>.Some {value} => value
        Option<&[u8]>.None => { return Option.none<Member>() }
      }
      if !same(namespaceName, b"Intrinsic") { return Option.none<Member>() }
      let memberName = match move name(module, field) {
        Option<&[u8]>.Some {value} => value
        Option<&[u8]>.None => { return Option.none<Member>() }
      }
      let selected = match move member(memberName) {
        Option<Member>.Some {value} => value
        Option<Member>.None => { return Option.none<Member>() }
      }
      return Option.some<Member>(selected)
    }
  }
  return Option.none<Member>()
}

/// Selects a complete checked contract when the caller already has argument and result types.
pub fn select(
  module: &Module,
  callee: HirId,
  arguments: &[Shared<Type>],
  result: &Type,
) -> Option<Member> {
  match move identify(module, callee) {
    Option<Member>.Some {value} => {
      if accepts(value, arguments, result) { return Option.some<Member>(value) }
    }
    Option<Member>.None => {}
  }
  return Option.none<Member>()
}

/// The canonical source spelling consumed only after checked selection.
pub fn spelling(selected: Member) -> &'static [u8] {
  return match selected {
    Member.TargetPointerBits => b"targetPointerBits"
    Member.TargetPointerAlignment => b"targetPointerAlignment"
    Member.TargetArchitecture => b"targetArchitecture"
    Member.TargetOperatingSystem => b"targetOperatingSystem"
    Member.TargetAbi => b"targetAbi"
    Member.TargetObjectFormat => b"targetObjectFormat"
    Member.TargetEndianness => b"targetEndianness"
    Member.StaticTextByteLength => b"staticTextByteLength"
    Member.StaticTextByteAt => b"staticTextByteAt"
    Member.StaticTextConcat => b"staticTextConcat"
    Member.StaticTextSlice => b"staticTextSlice"
  }
}
