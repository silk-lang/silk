//! Checked identity for the sealed source-callable compiler primitives.
//!
//! # Details
//! The semantic resolver authenticates the sealed `Intrinsic` namespace before asking this actor
//! to select a closed member. Ordinary library declarations never acquire an intrinsic identity.
//! Scalar operations come from the product catalog in [`ScalarOperation`]; every other member is
//! one named [`Primitive`].

import semantic.Types {Types}
import hir.Hir {Access, CallableMode, Multiplicity, OwnerKind}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.Lifetime {Intersection, Lifetime}
import semantic.ScalarOperation {Scalar, ScalarOperation}
import semantic.Type {Argument, ArrayShape, Outlives, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.ownership {Copy}
import silk.shared {Shared}
import silk.usize
import silk.list {List}

/// One named compiler primitive with a dedicated contract.
pub enum Primitive {
  TargetPointerBits,
  TargetPointerAlignment,
  TargetArchitecture,
  TargetOperatingSystem,
  TargetAbi,
  TargetObjectFormat,
  TargetEndianness,
  ProfileText,
  ProfileFlag,
  ProfileContains,
  StaticTextByteLength,
  StaticTextByteAt,
  StaticTextConcat,
  StaticTextSlice,
  /// `pointerFromSlice<T>(values: &[T]) -> ?[*]const T`: the address of a shared slice.
  PointerFromSlice,
  /// `pointerFromMutSlice<T>(values: &mut [T]) -> ?[*]mut T`: the address of an exclusive slice.
  PointerFromMutSlice,
  /// `pointerFromRef<T>(value: &T) -> *const T`: the address of a shared referent.
  PointerFromRef,
  /// `pointerFromMutRef<T>(value: &mut T) -> *mut T`: the address of an exclusive referent.
  PointerFromMutRef,
  /// `pointerAt<T>(pointer: [*]const T, index: usize) -> *const T`.
  PointerAt,
  /// `pointerAtMut<T>(pointer: [*]mut T, index: usize) -> *mut T`.
  PointerAtMut,
  /// `pointerRead<T>(pointer: *const T) -> T`: one naturally aligned `Copy` value.
  PointerRead,
  /// `pointerWrite<T>(pointer: *mut T, value: T) -> ()`: one naturally aligned store.
  PointerWrite,
  /// `pointerTake<T>(pointer: *mut T) -> T`: moves one naturally aligned value out, leaving the
  /// storage logically uninitialized.
  PointerTake,
  /// `pointerBorrow<A, T>(anchor: &'a A, pointer: *const T) -> &'a T`: a shared reference to the
  /// referent, valid for as long as the anchor's loan.
  PointerBorrow,
  /// `pointerBorrowMut<A, T>(anchor: &'a mut A, pointer: *mut T) -> &'a mut T`: an exclusive
  /// reference to the referent, valid for as long as the anchor's exclusive loan.
  PointerBorrowMut,
  /// `pointerReadUnaligned<T>(pointer: *const align(1) T) -> T`: one byte-aligned `Copy` value.
  PointerReadUnaligned,
  /// `pointerWriteUnaligned<T>(pointer: *mut align(1) T, value: T) -> ()`: one byte-aligned store.
  PointerWriteUnaligned,
  /// `pointerRequalify<From, To>(pointer: From) -> To`: the same pointee under other qualifiers.
  PointerRequalify,
  /// `pointerReinterpret<From, To>(pointer: From) -> To`: another pointee under equal qualifiers.
  PointerReinterpret,
  /// `pointerBytes<T>(pointer: ?*const T) -> ?[*]const u8`: the same address as readonly bytes.
  PointerBytes,
  /// `pointerAddress<P>(pointer: P) -> usize`: the numeric address of a data pointer.
  PointerAddress,
  /// `pointerIsNull<P>(pointer: P) -> bool`: whether a data pointer is null.
  PointerIsNull,
  /// `pointerNull<T>() -> ?*mut T`: the null single-element pointer.
  PointerNull,
  /// `sliceView<T>(values: &[T], offset: usize, length: usize) -> &[T]`: a bounds-checked
  /// subrange with the same loan; an out-of-range offset or length traps.
  SliceView,
  /// `observeUnhandled()`: reports the selected failure's context to the lexical observer and
  /// returns its policy, or `0` without a selected failure (failure observer note N4).
  ObserveUnhandled,
  /// `reflectType<Owner>()`: the phase-only descriptor of one aggregate type.
  ReflectType,
  /// `reflectTypeKind<Owner>(descriptor)`: the stable aggregate-kind code of a descriptor.
  ReflectTypeKind,
  ReflectFields,
  ReflectFieldKind,
  ReflectFieldLabel,
  ReflectFieldOrdinal,
  BorrowField,
  /// Immutable, phase-only homogeneous sequence construction.
  StaticSequenceEmpty,
  StaticSequenceAppend,
  StaticSequenceConcat,
  StaticSequenceLength,
  StaticSequenceAt,
  /// `assembly<Result>(template, constraints, clobbers, memory, sideEffects, noReturn, inputs)`:
  /// one function-local machine fragment with literal metadata (ASSEMBLY-001).
  Assembly,
  /// `stringEqualsExact(left: string, right: string) -> bool`: exact UTF-8 byte equality (TEXT-001).
  StringEqualsExact,
  /// `tests() -> Tests`: the static catalog of the request's discovery root (TEST-004).
  Tests,
  /// `testInfo<F>(descriptor: Test<F>) -> TestInfo`: one test's static metadata.
  TestInfo,
  /// `testFunction<F>(static descriptor: Test<F>) -> F`: one test's exact runtime callable.
  TestFunction,
  /// `atomicLoad<T>(pointer: *const T, static order: string<'static>) -> T` (ATOMIC-002).
  AtomicLoad,
  /// `atomicStore<T>(pointer: *mut T, value: T, static order: string<'static>) -> ()`.
  AtomicStore,
  /// `atomicSwap<T>(pointer: *mut T, value: T, static order: string<'static>) -> T`.
  AtomicSwap,
  /// `atomicCompareExchange<T>(pointer: *mut T, expected: *mut T, desired: T, static success:
  /// string<'static>, static failure: string<'static>) -> bool`: stores `desired` when the
  /// pointee equals `*expected`; otherwise writes the observed value to `expected` (ATOMIC-003).
  AtomicCompareExchange,
  /// The weak form of [`Primitive.AtomicCompareExchange`], which may fail spuriously.
  AtomicCompareExchangeWeak,
  /// `atomicFetchAdd<T>(pointer: *mut T, value: T, static order: string<'static>) -> T`: wrapping.
  AtomicFetchAdd,
  /// Wrapping subtraction; returns the previous value.
  AtomicFetchSubtract,
  AtomicFetchBitAnd,
  AtomicFetchBitOr,
  AtomicFetchBitXor,
  /// The smaller of the pointee and `value` under `T`'s signedness; returns the previous value.
  AtomicFetchMinimum,
  AtomicFetchMaximum,
  /// `atomicFence(static order: string<'static>) -> ()` (ATOMIC-004).
  AtomicFence,
  /// `simdSplat<V>(lane: L) -> V`: every lane of the vector `V` set to `lane` (SIMD-003).
  SimdSplat,
  /// `simdExtract<V>(vector: V, index: usize) -> L`: one lane; an index past the last lane traps.
  SimdExtract,
  /// `simdInsert<V>(vector: V, index: usize, lane: L) -> V`: one lane replaced; an index past the last lane traps.
  SimdInsert,
  /// `simdFromArray<V>(lanes: [L; N]) -> V`: the vector whose lane `i` is element `i`.
  SimdFromArray,
  /// `simdToArray<V>(vector: V) -> [L; N]`: the array whose element `i` is lane `i`.
  SimdToArray,
  /// `simdLanesEqual<V>(left: V, right: V) -> mask<N>`: lane-wise `==`; a NaN lane is unequal.
  SimdLanesEqual,
  /// Lane-wise `!=`; a NaN lane differs.
  SimdLanesNotEqual,
  /// Lane-wise `<` of a numeric vector, under its lane's signedness.
  SimdLanesLess,
  SimdLanesLessOrEqual,
  SimdLanesGreater,
  SimdLanesGreaterOrEqual,
  /// `simdSelect<V>(mask: mask<N>, chosen: V, other: V) -> V`: lane `i` of `chosen` where mask lane `i` is set, and of `other` elsewhere.
  SimdSelect,
  /// `simdWrappingAdd<V>(left: V, right: V) -> V`: lane-wise integer sum modulo 2^width (SIMD-004).
  SimdWrappingAdd,
  SimdWrappingSubtract,
  SimdWrappingMultiply,
  /// Lane-wise integer sum clamped to the lane type's range.
  SimdSaturatingAdd,
  SimdSaturatingSubtract,
  /// Lane-wise shift by the matching lane of `right`; a count of the lane width or more traps.
  SimdShiftLeft,
  /// Logical for unsigned and arithmetic for signed lanes; a count of the lane width or more traps.
  SimdShiftRight,
  /// Lane-wise rotation by the matching count modulo the lane width.
  SimdRotateLeft,
  SimdRotateRight,
  /// Lane-wise lesser value; a float lane follows `f32.min` except that a NaN lane's payload is unspecified.
  SimdMinimum,
  SimdMaximum,
  /// `simdSqrt<V>(vector: V) -> V`: each float lane's correctly rounded square root.
  SimdSqrt,
  /// `simdMulAdd<V>(left: V, right: V, addend: V) -> V`: each float lane's fused `left * right + addend`.
  SimdMulAdd,
  /// `simdReduceAdd<V>(vector: V) -> L`: the sum of every lane. An integer sum traps when the exact sum leaves `L`; a float sum adds lanes in order from lane 0 (SIMD-005).
  SimdReduceAdd,
  /// The integer sum of every lane modulo 2^width.
  SimdReduceWrappingAdd,
  /// The float sum of every lane in an order the target chooses.
  SimdReduceAddUnordered,
  /// The least lane, under the lane-wise minimum's rules.
  SimdReduceMinimum,
  SimdReduceMaximum,
  /// The bitwise combination of every integer lane.
  SimdReduceBitAnd,
  SimdReduceBitOr,
  SimdReduceBitXor,
  /// `simdMaskAny<M>(mask: M) -> bool`: whether any lane is set.
  SimdMaskAny,
  /// Whether every lane is set.
  SimdMaskAll,
  /// `simdMaskCount<M>(mask: M) -> usize`: the number of set lanes.
  SimdMaskCount,
  /// The lowest set lane, or the lane count when none is set.
  SimdMaskFirstSet,
  /// `simdMaskToBits<M>(mask: M) -> u64`: lane `i` as bit `i`; higher bits are zero.
  SimdMaskToBits,
  /// `simdMaskFromBits<M>(bits: u64) -> M`: lane `i` set from bit `i`; bits past the last lane are ignored.
  SimdMaskFromBits,
  /// `simdLoad<V>(values: &[L], offset: usize) -> V`: lanes from `values[offset..offset + N]`; a range past the slice traps.
  SimdLoad,
  /// `simdStore<V>(values: &mut [L], offset: usize, vector: V) -> ()`: the lanes into `values[offset..offset + N]`.
  SimdStore,
  /// `simdPointerLoad<V>(pointer: *const L) -> V`: N lanes from consecutive elements at element alignment.
  SimdPointerLoad,
  /// `simdPointerStore<V>(pointer: *mut L, vector: V) -> ()`.
  SimdPointerStore,
  /// `simdConvert<From, To>(vector: From) -> To`: each lane converted as the scalar `Convert` does, trapping per lane.
  SimdConvert,
  /// `simdBitcast<From, To>(vector: From) -> To`: the same bits as another vector of equal width.
  SimdBitcast,
}

/// The memory ordering of one atomic operation (ATOMIC-001).
pub enum MemoryOrder {
  Relaxed,
  Acquire,
  Release,
  AcquireRelease,
  SequentiallyConsistent,
}

/// The static text that names each [`MemoryOrder`] at an intrinsic call.
pub fn memoryOrderSpelling(order: MemoryOrder) -> &'static [u8] {
  return match order {
    MemoryOrder.Relaxed => b"relaxed"
    MemoryOrder.Acquire => b"acquire"
    MemoryOrder.Release => b"release"
    MemoryOrder.AcquireRelease => b"acquireRelease"
    MemoryOrder.SequentiallyConsistent => b"sequentiallyConsistent"
  }
}

/// The ordering spelled by static text, or absence for any other text.
pub fn memoryOrder(text: &[u8]) -> Option<MemoryOrder> {
  let orders = [MemoryOrder.Relaxed, MemoryOrder.Acquire, MemoryOrder.Release, MemoryOrder.AcquireRelease,
    MemoryOrder.SequentiallyConsistent]
  let listed: &[MemoryOrder] = &orders
  let mut at = usize.ZERO
  while at < listed.length {
    if same(text, memoryOrderSpelling(listed[at])) { return Option<MemoryOrder>.some(listed[at]) }
    at = at + usize.ONE
  }
  return Option<MemoryOrder>.none()
}

/// Whether a member is one atomic memory operation or the fence.
pub fn isAtomic(selected: Member) -> bool {
  return match selected {
    Member.Scalar {..} => false
    Member.Primitive {primitive} => match primitive {
      Primitive.AtomicLoad => true
      Primitive.AtomicStore => true
      Primitive.AtomicSwap => true
      Primitive.AtomicCompareExchange => true
      Primitive.AtomicCompareExchangeWeak => true
      Primitive.AtomicFetchAdd => true
      Primitive.AtomicFetchSubtract => true
      Primitive.AtomicFetchBitAnd => true
      Primitive.AtomicFetchBitOr => true
      Primitive.AtomicFetchBitXor => true
      Primitive.AtomicFetchMinimum => true
      Primitive.AtomicFetchMaximum => true
      Primitive.AtomicFence => true
      _ => false
    }
  }
}

/// The argument index of an atomic member's first static ordering; a compare-exchange's failure
/// ordering follows it.
pub fn orderingStart(selected: Member) -> Option<usize> {
  if !isAtomic(selected) { return Option<usize>.none() }
  return Option<usize>.some(arity(selected) - orderingCount(selected))
}

/// The number of static orderings an atomic member takes.
pub fn orderingCount(selected: Member) -> usize {
  if isPrimitive(selected, Primitive.AtomicCompareExchange) || isPrimitive(selected, Primitive.AtomicCompareExchangeWeak) { return 2 }
  if isAtomic(selected) { return usize.ONE }
  return usize.ZERO
}

/// Whether an atomic member admits these orderings: a load never releases, a store never
/// acquires, a compare-exchange failure is a load, and a fence orders something (ATOMIC-001).
pub fn admitsOrders(selected: Member, success: MemoryOrder, failure: MemoryOrder) -> bool {
  let releasing = success == MemoryOrder.Release || success == MemoryOrder.AcquireRelease
  let acquiring = success == MemoryOrder.Acquire || success == MemoryOrder.AcquireRelease
  if isPrimitive(selected, Primitive.AtomicLoad) { return !releasing }
  if isPrimitive(selected, Primitive.AtomicStore) { return !acquiring }
  if isPrimitive(selected, Primitive.AtomicFence) { return success != MemoryOrder.Relaxed }
  if isPrimitive(selected, Primitive.AtomicCompareExchange) || isPrimitive(selected, Primitive.AtomicCompareExchangeWeak) {
    return failure != MemoryOrder.Release && failure != MemoryOrder.AcquireRelease
  }
  return true
}

/// The element types an atomic member admits: integers and data pointers for load, store, swap
/// and compare-exchange, and integers alone for the arithmetic and bitwise operations.
pub fn admitsElement(selected: Member, element: &Type) -> bool {
  let pointer = match &element.* {
    Type.Pointer {..} => true
    _ => false
  }
  if pointer {
    return isPrimitive(selected, Primitive.AtomicLoad) || isPrimitive(selected, Primitive.AtomicStore) ||
      isPrimitive(selected, Primitive.AtomicSwap) || isPrimitive(selected, Primitive.AtomicCompareExchange) ||
      isPrimitive(selected, Primitive.AtomicCompareExchangeWeak)
  }
  let integers = [b"u8", b"u16", b"u32", b"u64", b"usize", b"i8", b"i16", b"i32", b"i64", b"isize"]
  let listed: &[&'static [u8]] = &integers
  let mut at = usize.ZERO
  while at < listed.length {
    if primitiveNamed(element, listed[at]) { return true }
    at = at + usize.ONE
  }
  return false
}

/// One compiler primitive after sealed namespace and type-contract selection.
pub union Member {
  /// One named primitive.
  Primitive {pub primitive: Primitive},
  /// One operation of the closed scalar catalog.
  Scalar {pub operation: ScalarOperation},
}

impl Copy for Member {}

/// A closed parameter or result in a compiler contract that takes no type arguments.
pub union ValueKind {
  /// One scalar passed or returned by value.
  Scalar {pub scalar: Scalar},
  /// A shared reference to one scalar.
  Borrowed {pub scalar: Scalar},
  /// Text of any lifetime.
  Text,
  /// Program-lifetime text.
  StaticText,
}

impl Copy for ValueKind {}

// Every named primitive in declaration order.
fn primitives() -> [Primitive; 110] {
  return [
    Primitive.TargetPointerBits, Primitive.TargetPointerAlignment, Primitive.TargetArchitecture,
    Primitive.TargetOperatingSystem, Primitive.TargetAbi, Primitive.TargetObjectFormat,
    Primitive.TargetEndianness, Primitive.ProfileText, Primitive.ProfileFlag, Primitive.ProfileContains,
    Primitive.StaticTextByteLength, Primitive.StaticTextByteAt, Primitive.StaticTextConcat,
    Primitive.StaticTextSlice, Primitive.PointerFromSlice, Primitive.PointerFromMutSlice,
    Primitive.PointerFromRef, Primitive.PointerFromMutRef, Primitive.PointerAt, Primitive.PointerAtMut,
    Primitive.PointerRead, Primitive.PointerWrite, Primitive.PointerTake, Primitive.PointerBorrow, Primitive.PointerBorrowMut,
    Primitive.PointerReadUnaligned,
    Primitive.PointerWriteUnaligned, Primitive.PointerRequalify, Primitive.PointerReinterpret,
    Primitive.PointerBytes, Primitive.PointerAddress, Primitive.PointerIsNull, Primitive.PointerNull,
    Primitive.SliceView, Primitive.ObserveUnhandled, Primitive.ReflectType, Primitive.ReflectTypeKind, Primitive.ReflectFields, Primitive.ReflectFieldKind, Primitive.ReflectFieldLabel, Primitive.ReflectFieldOrdinal, Primitive.BorrowField, Primitive.StaticSequenceEmpty, Primitive.StaticSequenceAppend, Primitive.StaticSequenceConcat, Primitive.StaticSequenceLength, Primitive.StaticSequenceAt,
    Primitive.Assembly, Primitive.StringEqualsExact, Primitive.Tests, Primitive.TestInfo, Primitive.TestFunction,
    Primitive.AtomicLoad, Primitive.AtomicStore, Primitive.AtomicSwap, Primitive.AtomicCompareExchange,
    Primitive.AtomicCompareExchangeWeak, Primitive.AtomicFetchAdd, Primitive.AtomicFetchSubtract,
    Primitive.AtomicFetchBitAnd, Primitive.AtomicFetchBitOr, Primitive.AtomicFetchBitXor,
    Primitive.AtomicFetchMinimum, Primitive.AtomicFetchMaximum, Primitive.AtomicFence,
    Primitive.SimdSplat, Primitive.SimdExtract, Primitive.SimdInsert, Primitive.SimdFromArray, Primitive.SimdToArray,
    Primitive.SimdLanesEqual, Primitive.SimdLanesNotEqual, Primitive.SimdLanesLess, Primitive.SimdLanesLessOrEqual,
    Primitive.SimdLanesGreater, Primitive.SimdLanesGreaterOrEqual, Primitive.SimdSelect,
    Primitive.SimdWrappingAdd, Primitive.SimdWrappingSubtract, Primitive.SimdWrappingMultiply,
    Primitive.SimdSaturatingAdd, Primitive.SimdSaturatingSubtract, Primitive.SimdShiftLeft,
    Primitive.SimdShiftRight, Primitive.SimdRotateLeft, Primitive.SimdRotateRight, Primitive.SimdMinimum,
    Primitive.SimdMaximum, Primitive.SimdSqrt, Primitive.SimdMulAdd, Primitive.SimdReduceAdd,
    Primitive.SimdReduceWrappingAdd, Primitive.SimdReduceAddUnordered, Primitive.SimdReduceMinimum,
    Primitive.SimdReduceMaximum, Primitive.SimdReduceBitAnd, Primitive.SimdReduceBitOr,
    Primitive.SimdReduceBitXor, Primitive.SimdMaskAny, Primitive.SimdMaskAll, Primitive.SimdMaskCount,
    Primitive.SimdMaskFirstSet, Primitive.SimdMaskToBits, Primitive.SimdMaskFromBits, Primitive.SimdLoad,
    Primitive.SimdStore, Primitive.SimdPointerLoad, Primitive.SimdPointerStore, Primitive.SimdConvert,
    Primitive.SimdBitcast,
  ]
}

