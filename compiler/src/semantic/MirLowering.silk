// One shape per construction whose operands are stored at declared field types, in the lifetimes of
// the constructed node's own type: a callable's or named section's captures (CALLABLE-001), a staged
// callable's callee and stored operands, and a nominal record's or variant's fields with its type's
// declared outlives and contents bounds, which the region check holds at the construction (LIFE-002).
pub effect fn constructionShapes(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  nodes: &[BodyNode], anchor: &Anchor) -> List<ConstructionShape>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut shapes = List<ConstructionShape>.make()
  let mut at = usize.ZERO
  while at < nodes.length {
    let mut fields = Option<List<Interned<Type>>>.none()
    let mut bounds = List<RegionPremise>.make()
    let mut contents = List<ContentsBound>.make()
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      let span = BodyOrigin.span(nodes[at].origin, anchor)
      let mut nominal = false
      if let BodyExpression.Callable {data: _bx} = &form {
  let CallableData {fields: written, ..} = &_bx.get().*

        fields = run capturedFields(&ty, List<BodyAggregateField>.asSlice(&written))
      }
      if let BodyExpression.Aggregate {data: _bx} = &form {
  let AggregateData {fields: written, ..} = &_bx.get().*

        fields = run capturedFields(&ty, List<BodyAggregateField>.asSlice(&written))
        if let Option<List<Interned<Type>>>.None = &fields {
          fields = run memberFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, usize.MAX,
            List<BodyAggregateField>.asSlice(&written), span)
          nominal = true
        }
      }
      if let BodyExpression.VariantConstruct {tag, fields: written} = &form {
        fields = run memberFields(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, tag,
          List<BodyAggregateField>.asSlice(&written), span)
        nominal = true
      }
      if let BodyExpression.StagedCallable {data: _bx} = &form {
  let StagedCallableData {arguments, ..} = &_bx.get().*

        fields = run stagedFields(&ty, List<BodyNodeId>.length(&arguments))
      }
      if nominal {
        let declared = run providerDeclaredBounds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &ty, span)
        let listed = List<Constraint>.asSlice(&declared)
        let mut boundAt = usize.ZERO
        while boundAt < listed.length {
          run appendRegionBound(&listed[boundAt], &mut bounds, &mut contents)
          boundAt = boundAt + usize.ONE
        }
      }
    }
    if let Option<List<Interned<Type>>>.Some {value} = move fields {
      run List<ConstructionShape>.append(&mut shapes, ConstructionShape {node: BodyNodeId {index: at}, fields: move value,
        bounds: move bounds, contents: move contents})
    }
    at = at + usize.ONE
  }
  return move shapes
}

// A callable environment's capture types in operand order: each operand's field names its capture.
effect fn capturedFields(value: &Interned<Type>, written: &[BodyAggregateField]) -> Option<List<Interned<Type>>>
! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  let captures = match move copied {
    Type.CallableValue {captures, ..} => move captures
    Type.CallableSchema {captures, ..} => move captures
    _ => { return Option<List<Interned<Type>>>.none() }
  }
  let listed = List<Interned<Type>>.asSlice(&captures)
  let mut fields = List<Interned<Type>>.make()
  let mut at = usize.ZERO
  while at < written.length {
    if written[at].index >= listed.length { return Option<List<Interned<Type>>>.none() }
    run List<Interned<Type>>.append(&mut fields, Interned<Type>.clone(&listed[written[at].index]))
    at = at + usize.ONE
  }
  return Option<List<Interned<Type>>>.some(move fields)
}

// A staged callable stores its callee as its base and each supplied operand as the next capture.
// A flattened environment no longer separates the callee from its captures, so it has no shape.
effect fn stagedFields(value: &Interned<Type>, supplied: usize) -> Option<List<Interned<Type>>> ! OutOfMemoryError ? &mut Allocator {
  let copied = run Type.copy(value)
  if let Type.CallableStage {base, captures, ..} = move copied {
    let listed = List<Interned<Type>>.asSlice(&captures)
    if listed.length != supplied { return Option<List<Interned<Type>>>.none() }
    let mut fields = List<Interned<Type>>.make()
    run List<Interned<Type>>.append(&mut fields, move base)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<Interned<Type>>.append(&mut fields, Interned<Type>.clone(&listed[at]))
      at = at + usize.ONE
    }
    return Option<List<Interned<Type>>>.some(move fields)
  }
  return Option<List<Interned<Type>>>.none()
}

// The declared type of each written field of a nominal record (`tag` is `usize.MAX`) or of variant
// `tag`, instantiated for the constructed type itself, as its MemberShape answers state them.
effect fn memberFields(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  value: &Interned<Type>, tag: usize, written: &[BodyAggregateField], span: Span) -> Option<List<Interned<Type>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let moduleAt = declaringModuleOrdinal(&resolver.*, value)
  if moduleAt == usize.MAX { return Option<List<Interned<Type>>>.none() }
  let module = resolvedModule(&resolver.*, moduleAt)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &module, value) {
    Option<usize>.Some {value: position} => position
    Option<usize>.None => { return Option<List<Interned<Type>>>.none() }
  }
  let application = run internApplication(&mut resolver.*, value)
  let mut variant = Option<Shared<Result<Answer, NoRejection>>>.none()
  if tag != usize.MAX {
    let key = run internDeclaration(&mut resolver.*, Key {family: Family.MemberShape, module: moduleAt, name: application,
      declaration: declaration, member: tag, external: false})
    variant = Option<Shared<Result<Answer, NoRejection>>>.some(run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span))
  }
  let mut fields = List<Interned<Type>>.make()
  let mut at = usize.ZERO
  while at < written.length {
    let part = written[at].index
    let mut field = Option<Interned<Type>>.none()
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: shaped} = &variant {
      field = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&shaped,
        |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return shapeTypeAt(answer, part) })
    } else {
      let key = run internDeclaration(&mut resolver.*, Key {family: Family.MemberShape, module: moduleAt, name: application,
        declaration: declaration, member: part, external: false})
      let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
      field = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&shaped, singleMemberType)
    }
    match move field {
      Option<Interned<Type>>.Some {value: declared} => { run List<Interned<Type>>.append(&mut fields, move declared) }
      Option<Interned<Type>>.None => { return Option<List<Interned<Type>>>.none() }
    }
    at = at + usize.ONE
  }
  return Option<List<Interned<Type>>>.some(move fields)
}

fn localPlace(nodes: &[BodyNode], at: usize) -> bool {
  return match &nodes[at].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {..}, ..} => true
    _ => false
  }
}

// The position of a type equal to `value` among `listed`, whose hashes `lookup` records in order,
// or `listed.length` when none is.
// The index of the type in `listed` with `value`'s runtime representation. Both users ask questions
// of the representation only, and comparing lifetimes would keep every borrow's own reference type
// apart: those types share one hash, so a body with many borrows would scan them all each time.
effect fn knownTypeAt(listed: &[Interned<Type>], lookup: &InternIndex, value: &Interned<Type>, hashed: u64) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = InternIndex.first(lookup, hashed)
  while at != usize.MAX {
    if run Type.runtimeEqualsShared(&listed[at], value) { return at }
    at = InternIndex.after(lookup, at)
  }
  return listed.length
}

effect fn knownType(listed: &[Interned<Type>], lookup: &InternIndex, value: &Interned<Type>, hashed: u64) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let at = run knownTypeAt(listed, lookup, value, hashed)
  return at < listed.length
}

// `knownTypeAt` by exact semantic identity rather than runtime layout.
pub effect fn exactTypeAt(listed: &[Interned<Type>], lookup: &InternIndex, value: &Interned<Type>, hashed: u64) -> usize
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = InternIndex.first(lookup, hashed)
  while at != usize.MAX {
    if run Type.equalsShared(&listed[at], value) { return at }
    at = InternIndex.after(lookup, at)
  }
  return listed.length
}

effect fn cleanupNeeds(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, bindings: &[Binding], projections: &[RuntimeProjection],
  constraints: &[Constraint], anchor: &Anchor,
) -> Result<CleanupNeeds, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let span = Shared<TypedBody>.with<Span>(body, |value: &TypedBody| -> Span {
    let nodes = TypedBody.nodeSlice(value)
    return BodyOrigin.span(nodes[TypedBody.rootNode(value).index].origin, anchor)
  })
  let localCount = Shared<TypedBody>.with<usize>(body, |value: &TypedBody| -> usize { return TypedBody.localSlice(value).length })
  let nodeCount = Shared<TypedBody>.with<usize>(body, |value: &TypedBody| -> usize { return TypedBody.nodeSlice(value).length })
  let mut known = List<Interned<Type>>.make()
  let mut knownLookup = InternIndex.make()
  let mut verdicts = List<bool>.make()
  let mut localNeeds = List<bool>.make()
  let mut nodeNeeds = List<bool>.make()
  let mut at = usize.ZERO
  while at < localCount + nodeCount {
    let written = Shared<TypedBody>.with<Option<Interned<Type>>>(body, |value: &TypedBody| -> Option<Interned<Type>> {
      let locals = TypedBody.localSlice(value)
      if at < localCount { return Option<Interned<Type>>.some(Interned<Type>.clone(&locals[at].ty)) }
      let nodes = TypedBody.nodeSlice(value)
      if let BodyNodeKind.Expression {ty, ..} = &nodes[at - localCount].kind {
        return Option<Interned<Type>>.some(Interned<Type>.clone(&ty))
      }
      return Option<Interned<Type>>.none()
    })
    let mut needs = false
    if let Option<Interned<Type>>.Some {value: ty} = move written {
      // Keyed by the exact written type: equal written types close to equal types, so a repeat
      // skips the substitution as well as the verdict.
      let listed = List<Interned<Type>>.asSlice(&known)
      let hashed = Type.hashExact(&ty)
      let scan = run exactTypeAt(listed, &knownLookup, &ty, hashed)
      if scan < listed.length {
        needs = List<bool>.asSlice(&verdicts)[scan]
      } else {
        let closed = run RuntimeType.applyBindings(&ty, bindings, projections)
        let free = run sharedCleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, constraints, span)
        needs = match move free {
          Result<bool, Shared<Rejection>>.Success {value} => !value
          Result<bool, Shared<Rejection>>.Failure {error} => { return Result<CleanupNeeds, Shared<Rejection>>.failResult(move error) }
        }
        run List<Interned<Type>>.append(&mut known, move ty)
        run InternIndex.record(&mut knownLookup, hashed)
        run List<bool>.append(&mut verdicts, needs)
      }
    }
    if at < localCount {
      run List<bool>.append(&mut localNeeds, needs)
    } else {
      run List<bool>.append(&mut nodeNeeds, needs)
    }
    at = at + usize.ONE
  }
  return Result<CleanupNeeds, Shared<Rejection>>.succeed(CleanupNeeds {locals: move localNeeds, nodes: move nodeNeeds})
}

// A callable retains an ordinary function application. Its hidden environment parameter is
// passed directly; there is no code pointer, adapter declaration, or separate closure key.
effect fn concreteCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, written: &[Interned<Type>], anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut receiver = run RuntimeType.applyBindings(&inputs.receiver, callerBindings, projections)
  let mut dereferences = usize.ZERO
  while true {
    let copied = run Type.copy(&receiver)
    if let Type.Reference {referent, ..} = move copied {
      receiver = move referent
      dereferences = dereferences + usize.ONE
    } else { break }
  }
  let selected = run originalCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node,
    caller, callerBindings, projections, move inputs, move receiver, dereferences, written, anchor)
  return match move selected {
    Result<MirCallTarget, PreparationFailure>.Success {value} => {
      let mut target = move value
      if dereferences != usize.ZERO {
        if let Option<MirStoredArguments>.Some {value: stored} = &target.stored {
          if stored.consumes { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
        }
      }
      target.receiverDereferences = dereferences
      return Result<MirCallTarget, PreparationFailure>.succeed(move target)
    }
    Result<MirCallTarget, PreparationFailure>.Failure {error} => Result<MirCallTarget, PreparationFailure>.failResult(move error)
  }
}

effect fn originalCallableCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs,
  receiver: Interned<Type>, dereferences: usize, written: &[Interned<Type>], anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let exact = run Type.copy(&receiver)
  match move exact {
    Type.CallableSchema {schema, captures, fieldInputs, ..} => {
      if dereferences != usize.ZERO && Interned<Type>.with<CallableMode>(&sectionSchemaContract(&schema), callableInvocationMode) == CallableMode.Once {
        return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
      }
      return run schemaCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node,
        caller, callerBindings, projections, move inputs, move schema, move captures, move fieldInputs, written, anchor)
    }
    Type.CallableValue {application, contract, captures, fieldInputs, ..} => {
      let invocationMode = Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
      if dereferences != usize.ZERO && invocationMode == CallableMode.Once {
        return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm})
      }
      return run callableValueCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, move inputs, invocationMode, move receiver, move application, move captures, move fieldInputs,
        written, true, anchor)
    }
    _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
}

// ABI admission uses the same tracked original-result evidence as source calls and definitions.
effect fn callableInvocationResult(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, application: &Application, written: &Interned<Type>, bindings: &[Binding],
  projections: &[RuntimeProjection], span: Span) -> Result<Interned<Type>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut result = run Type.applyBindings(written, bindings, true)
  if Interned<Type>.with<bool>(&result, rawCallableType) {
    let declared = List<Constraint>.make()
    result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      application, List<Constraint>.asSlice(&declared), span) {
      Result<Interned<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Interned<Type>, Shared<Rejection>>.Failure {..} => { return Result<Interned<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
  }
  return Result<Interned<Type>, PreparationFailure>.succeed(run RuntimeType.project(&result, projections))
}

// Whether a section call stores no argument, so every operand is written.
// Whether a target's callable reaches its environment through a shared loan, or has none.
fn sharedEnvironment(target: &MirCallTarget) -> bool {
  if let Option<MirStoredArguments>.Some {value: stored} = &target.stored {
    if stored.consumes { return false }
    return match &stored.environment {
      Option<MirStoredEnvironment>.None => true
      Option<MirStoredEnvironment>.Some {value: input} => sharedLoan(&input.borrow)
    }
  }
  // An anonymous body receives its whole environment first.
  let operands = List<MirCallOperand>.asSlice(&target.operands)
  return operands.length != usize.ZERO && sharedLoan(&operands[usize.ZERO].borrow)
}

fn sharedLoan(borrow: &Option<Access>) -> bool {
  return match &borrow.* {
    Option<Access>.Some {value} => value == Access.Shared
    Option<Access>.None => false
  }
}

pub fn callableInputParameter(input: &CallableFieldInput, at: usize) -> bool {
  return match move CallableFieldInput.parameter(input) { Option<usize>.Some {value} => value == at _ => false }
}

// The Effect an ordinary callee returns from an invocation whose contract promises an Effect. The
// checker cannot tell an abstract callee's kind, so such an invocation may construct (EFF-001): only
// an `effect fn` target constructs its Effect, which a run executes as one call of it. An ordinary
// target runs when called and returns an Effect, which a run of the call then executes as any
// returned Effect (EFF-005). Absent for an `effect fn` callee or a call that constructs nothing.
effect fn returnedByOrdinaryCallee(body: &Shared<TypedBody>, node: BodyNodeId, calleeIsEffect: bool, result: &Interned<Type>)
  -> Option<Interned<Type>> ! OutOfMemoryError ? &mut Allocator {
  if calleeIsEffect { return Option<Interned<Type>>.none() }
  let constructs = Shared<TypedBody>.with<bool>(body, |value: &TypedBody| -> bool {
    let nodes = TypedBody.nodeSlice(value)
    if let BodyNodeKind.Expression {form: BodyExpression.CallableCall {data: _bx}, ..} = &nodes[node.index].kind {
  let CallableCallData {constructs: invoked, ..} = &_bx.get().*
 return invoked }
    return false
  })
  if !constructs { return Option<Interned<Type>>.none() }
  return Option<Interned<Type>>.some(Interned<Type>.clone(result))
}

// Calls the original target of a callable value with no adapter. Its operands are the literal
// environment when the target has one (`CallableEnvironment`), then each original parameter in
// order: a stored field where an input supplies it, the next written operand otherwise. A
// literal's own value carries no stored fields; its invocation regions are its header's, so
// `selectInvocation` binds them from the checked call.
pub effect fn callableValueCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], inputs: CallableCallInputs, mode: CallableMode,
  receiver: Interned<Type>, recorded: Interned<Application>, captures: List<Interned<Type>>, fieldInputs: List<CallableFieldInput>,
  written: &[Interned<Type>], selectInvocation: bool, anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let recipe = run Application.copyShared(&recorded)
  let mut application = run Application.substitute(&recipe, caller)
  let environmentSource = CallableEnvironment.of(&application, List<CallableFieldInput>.asSlice(&fieldInputs))
  let ownValue = CallableEnvironment.isValue(&environmentSource)
  let signatureOwner = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(&application)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let signatureRequest = Key {
    family: Family.Signature, module: location.module, name: usize.ZERO,
    declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let signatureKey = run internDeclaration(&mut resolver.*, signatureRequest)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, signatureKey, BodyOrigin.span(inputs.origin, anchor))
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  if ownValue && selectInvocation {
    let count = Shared<List<Binding>>.with<usize>(&inputs.bindings, |value: &List<Binding>| -> usize { return List<Binding>.length(value) })
    let mut invocationValues = List<Argument>.make()
    let mut selectedOrdinals = List<usize>.make()
    let mut at = usize.ZERO
    while at < count {
      let recordedBinding = Shared<List<Binding>>.with<Binding>(&inputs.bindings, |value: &List<Binding>| -> Binding {
        let current = List<Binding>.asSlice(value)
        return Binding {declaration: Interned<DeclarationId>.clone(&current[at].declaration), ordinal: current[at].ordinal, value: Argument.copy(&current[at].value)}
      })
      let freshIdentity = DeclarationId.copyShared(&inputs.inference)
      if !Interned<DeclarationId>.with<bool>(&recordedBinding.declaration, |value: &DeclarationId| -> bool { return DeclarationId.equals(value, &freshIdentity) }) {
        return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
      }
      run List<Argument>.append(&mut invocationValues, run Argument.applyBindings(&recordedBinding.value, callerBindings, true))
      run List<usize>.append(&mut selectedOrdinals, recordedBinding.ordinal)
      at = at + usize.ONE
    }
    application = match move run anonymousInvocationApplication(&application, &signature,
      List<Argument>.asSlice(&invocationValues), List<usize>.asSlice(&selectedOrdinals)) {
      Result<Application, PreparationFailure>.Success {value} => move value
      Result<Application, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
    }
  }
  let key = match move run InstanceKey.function(run Application.copy(&application)) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  // A literal's own value is its environment, not a record of stored fields.
  let mut stored = List<Interned<Type>>.make()
  let mut storedInputs = List<CallableFieldInput>.make()
  if !ownValue {
    stored = move captures
    storedInputs = move fieldInputs
  }
  let fields = List<Interned<Type>>.asSlice(&stored)
  let slots = List<CallableFieldInput>.asSlice(&storedInputs)
  let mut environmentField = usize.MAX
  if let CallableEnvironment.Field {index} = environmentSource { environmentField = index }
  let mut hidden = usize.ZERO
  if environmentField != usize.MAX { hidden = usize.ONE }
  // A static parameter's value is part of the application; it has no runtime lane or field.
  let staticSlots = run signatureStaticSlots(&signature, facts.staticSlots)
  let statics = List<usize>.asSlice(&staticSlots)
  if fields.length != slots.length || facts.parameters - statics.length + hidden != inputs.count + fields.length {
    return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand})
  }
  let bindings = run Application.bindings(&application)
  let assigned = List<Binding>.asSlice(&bindings)
  let result = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*,
    &application, &facts.result, assigned, projections, BodyOrigin.span(inputs.origin, anchor)) {
    Result<Interned<Type>, PreparationFailure>.Success {value} => move value
    Result<Interned<Type>, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  let mut wanted = run RuntimeType.applyBindings(&inputs.result, callerBindings, projections)
  // Invoking an `effect fn` value constructs its Effect; only its run calls the instance (D4). A
  // run already has the instance's result type, which may itself be an Effect, so only a
  // constructed Effect is unwrapped to its success.
  if facts.isEffect && !run Type.runtimeEqualsShared(&wanted, &result) {
    let promised = Interned<Type>.with<Option<EffectChannels>>(&wanted, effectChannels)
    if let Option<EffectChannels>.Some {value: channels} = move promised { wanted = move channels.success }
  }
  // An ordinary callee of a contract that promises an Effect returns that Effect (EFF-005).
  let returned = run returnedByOrdinaryCallee(body, node, facts.isEffect, &result)
  let returnsEffect = match &returned { Option<Interned<Type>>.Some {..} => true _ => false }
  if !returnsEffect && !run Type.runtimeEqualsShared(&wanted, &result) { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let mut operands = List<MirCallOperand>.make()
  let mut environment = Option<MirStoredEnvironment>.none()
  if ownValue || environmentField != usize.MAX {
    let mut actual = Interned<Type>.clone(&receiver)
    let mut environmentMode = mode
    let mut site = Shared<TypedBody>.with<BodyOrigin>(body, |value: &TypedBody| -> BodyOrigin { return TypedBody.nodeSlice(value)[inputs.callee.index].origin }).node
    if environmentField != usize.MAX {
      actual = Interned<Type>.clone(&fields[environmentField])
      environmentMode = Interned<Type>.with<CallableMode>(&actual, callableInvocationMode)
      site = inputs.origin.node
    }
    let mut parameter = Interned<Type>.clone(&actual)
    let mut borrow = Option<Access>.none()
    if environmentMode != CallableMode.Once {
      let access = match environmentMode { CallableMode.Mutable => Access.Mutable _ => Access.Shared }
      borrow = Option<Access>.some(access)
      parameter = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&actual), access: access,
        lifetime: run Types.internLifetime(Lifetime.Local {
          declaration: DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: site, binder: usize.MAX,
        })})
    }
    if environmentField != usize.MAX {
      environment = Option<MirStoredEnvironment>.some(MirStoredEnvironment {field: environmentField,
        parameter: Interned<Type>.clone(&parameter), borrow: match &borrow { Option<Access>.Some {value} => Option<Access>.some(value) _ => Option<Access>.none() }})
    }
    run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: move borrow})
  }
  // A stored argument keeps its original parameter ordinal; the written operands fill the rest.
  let mut lanes = List<MirStoredLane>.make()
  let mut at = usize.ZERO
  let mut lane = usize.ZERO
  while at < facts.parameters {
    if isStaticIndex(statics, at) {
      at = at + usize.ONE
      continue
    }
    let raw = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, at) }) {
      Option<Interned<Type>>.Some {value} => move value
      _ => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    }
    let parameter = run RuntimeType.applyBindings(&raw, assigned, projections)
    let mut actual = Interned<Type>.clone(&parameter)
    let mut lentAccess = Option<Access>.none()
    let mut selected = usize.ZERO
    while selected < slots.length && !callableInputParameter(&slots[selected], at) { selected = selected + usize.ONE }
    if selected < slots.length {
      actual = Interned<Type>.clone(&fields[selected])
      // A stored value the parameter borrows stays in the environment and is lent to the call:
      // an interface operation's Effect owns the operand its witness takes borrowed.
      lentAccess = run lentField(&actual, &parameter)
      if let Option<Access>.Some {value: access} = &lentAccess {
        let cleanup = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &actual, inputs.origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => match &value { Option<Interned<Type>>.Some {..} => true _ => false }
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
        }
        run List<MirStoredLane>.append(&mut lanes, MirStoredLane.Lent {index: selected, access: access, cleanup: cleanup})
      } else {
        run List<MirStoredLane>.append(&mut lanes, MirStoredLane.Field {index: selected})
      }
    } else {
      if lane >= inputs.count { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
      if lane >= written.length { fail RevisionMismatch {} }
      actual = run RuntimeType.applyBindings(&written[lane], callerBindings, projections)
      run List<MirStoredLane>.append(&mut lanes, MirStoredLane.Written)
      lane = lane + usize.ONE
    }
    if let Option<Access>.None = &lentAccess {
      if !run sectionOperandRuntimeCompatible(&actual, &parameter) { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    }
    run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: move lentAccess})
    at = at + usize.ONE
  }
  // The literal's own value is passed whole as its first operand; it stores nothing to place.
  let mut placed = Option<MirStoredArguments>.none()
  if !ownValue {
    placed = Option<MirStoredArguments>.some(MirStoredArguments {environment: move environment, lanes: move lanes, consumes: mode == CallableMode.Once})
  }
  // A stored interface Effect keeps the operation's promised channels, but runs the selected
  // witness. Catch its declared failure before widening into the operation's failure sink.
  let mut failure = Option<Interned<Type>>.none()
  if facts.isEffect {
    failure = Option<Interned<Type>>.some(run RuntimeType.applyBindings(&facts.failure, assigned, projections))
  }
  return Result<MirCallTarget, PreparationFailure>.succeed(MirCallTarget {node: node, receiverDereferences: usize.ZERO, key: move key,
    application: move application, edge: Edge.Direct, operands: move operands, stored: move placed,
    providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(), witnessFailure: move failure, promise: CallPromise.Unrestricted, vacuous: false, returned: move returned})
}

// The access at which `parameter` borrows a stored `field` it does not store itself: a reference
// whose referent is the field's own runtime type.
effect fn lentField(field: &Interned<Type>, parameter: &Interned<Type>) -> Option<Access> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.runtimeEqualsShared(field, parameter) { return Option<Access>.none() }
  if let Type.Reference {referent, access, ..} = move run Type.copy(parameter) {
    if run Type.runtimeEqualsShared(&referent, field) { return Option<Access>.some(access) }
  }
  return Option<Access>.none()
}

// Typed invocation already proves access and lifetime obligations. Weakening one exclusive
// reference or slice descriptor to shared access preserves its ABI and its exact referent.
effect fn sectionOperandRuntimeCompatible(actual: &Interned<Type>, parameter: &Interned<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.runtimeEqualsShared(actual, parameter) { return true }
  if run widenedOperand(actual, parameter) { return true }
  let source = run Type.copy(actual)
  let target = run Type.copy(parameter)
  return match move source {
    Type.Reference {referent, access, ..} => match move target {
      Type.Reference {referent: wanted, access: other, ..} => {
        if access != Access.Mutable || other != Access.Shared { return false }
        return run Type.runtimeEqualsShared(&referent, &wanted)
      }
      _ => false
    }
    Type.Slice {element, access, ..} => match move target {
      Type.Slice {element: wanted, access: other, ..} => {
        if access != Access.Mutable || other != Access.Shared { return false }
        return run Type.runtimeEqualsShared(&element, &wanted)
      }
      _ => false
    }
    _ => false
  }
}

// Whether an operand at a member of its parameter's wider structural union is widened into it at
// the call, as the `Frozen` a handler `fn(error: Overdrawn | Frozen)` receives (MIR
// `widenCallOperands`).
effect fn widenedOperand(actual: &Interned<Type>, parameter: &Interned<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !Interned<Type>.with<bool>(parameter, unionType) { return false }
  let wider = match move run Type.canonicalUnionMembers(parameter) {
    Option<List<Interned<Type>>>.Some {value} => move value
    Option<List<Interned<Type>>>.None => { return false }
  }
  let members = List<Interned<Type>>.asSlice(&wider)
  let mut narrower = List<Interned<Type>>.make()
  match move run Type.canonicalUnionMembers(actual) {
    Option<List<Interned<Type>>>.Some {value} => { narrower = move value }
    Option<List<Interned<Type>>>.None => { run List<Interned<Type>>.append(&mut narrower, Interned<Type>.clone(actual)) }
  }
  let listed = List<Interned<Type>>.asSlice(&narrower)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut found = false
    let mut other = usize.ZERO
    while !found && other < members.length {
      found = run Type.runtimeEqualsShared(&listed[at], &members[other])
      other = other + usize.ONE
    }
    if !found { return false }
    at = at + usize.ONE
  }
  return true
}

// Public invocation regions are numbered independently of the original anonymous header slots.
// The checked ordinal/value evidence maps through that same original header for both uses.
pub effect fn anonymousInvocationApplication(recorded: &Application, signature: &Shared<Result<Answer, NoRejection>>,
  selected: &[Argument], selectedOrdinals: &[usize]) -> Result<Application, PreparationFailure>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let slots = run anonymousInvocationSlots(signature, Application.bodyDeclaration(recorded))
  let ordinals = List<usize>.asSlice(&slots)
  if selected.length != selectedOrdinals.length { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  // CallableContract.compare admits a binder-free offer for every quantified invocation.
  // Those public regions constrain the caller's loans, not the concrete target's header;
  // retain its enclosing application without inventing invocation slots for them.
  if ordinals.length == usize.ZERO {
    return Result<Application, PreparationFailure>.succeed(run Application.copy(recorded))
  }
  let mut invocation = List<Binding>.make()
  let mut at = usize.ZERO
  while at < selected.length {
    if selectedOrdinals[at] >= ordinals.length { return Result<Application, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
    run List<Binding>.append(&mut invocation, Binding {declaration: run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(recorded))),
      ordinal: ordinals[selectedOrdinals[at]], value: Argument.copy(&selected[at])})
    at = at + usize.ONE
  }
  return Result<Application, PreparationFailure>.succeed(run Application.applyBindings(recorded, List<Binding>.asSlice(&invocation)))
}

// A `run` that executes one call at once.
struct ImmediateRun {
  node: BodyNodeId,
  operand: RunOperand,
}

// The `run` that executes call `node` at once, with the Effect that call returns as its operand.
fn immediateRunOf(typed: &Shared<TypedBody>, node: BodyNodeId) -> Option<ImmediateRun> {
  return Shared<TypedBody>.with<Option<ImmediateRun>>(typed, |value: &TypedBody| -> Option<ImmediateRun> {
    let nodes = TypedBody.nodeSlice(value)
    let mut at = usize.ZERO
    while at < nodes.length {
      if let BodyNodeKind.Expression {form: BodyExpression.Run {value: operand, access}, ty} = &nodes[at].kind {
        if operand.index == node.index && access == RunAccess.Immediate {
          if let BodyNodeKind.Expression {ty: receiver, ..} = &nodes[node.index].kind {
            return Option<ImmediateRun>.some(ImmediateRun {node: BodyNodeId {index: at}, operand: RunOperand {receiver: Interned<Type>.clone(&receiver),
              result: Interned<Type>.clone(&ty), callee: node, origin: nodes[at].origin}})
          }
        }
      }
      at = at + usize.ONE
    }
    return Option<ImmediateRun>.none()
  })
}

// Whether a run expands through a prepared plan: a composition, a finite join, or a producer's
// Effect family realized as either (D4, EFF-013).
fn compositeType(value: &Type) -> bool {
  return match &value.* {
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    Type.OpaqueRepresentation {..} => true
    _ => false
  }
}

// One alternative a stored join holds: the Effect to run, and its tag and payload type in the
// join's union storage.
struct StoredAlternative {
  alternative: Interned<Type>,
  tag: usize,
  storage: Interned<Type>,
}

// The alternatives of a finite join, or of the union storage a producer's join realizes, each
// under its tag in the storage's canonical members (UNION-001); absent for any other Effect.
// Nested joins, written or realized, contribute their own alternatives. Alternatives that the
// storage normalized to one member share it, and its first alternative runs it.
effect fn storedAlternatives(ty: &Interned<Type>, projections: &[RuntimeProjection]) -> Option<List<StoredAlternative>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let joined = Interned<Type>.with<bool>(ty, |value: &Type| -> bool {
    return match &value.* { Type.EffectJoin {..} => true Type.Union {..} => true _ => false }
  })
  if !joined { return Option<List<StoredAlternative>>.none() }
  let storage = run RuntimeType.project(ty, projections)
  let mut leaves = List<Interned<Type>>.make()
  run joinLeaves(ty, projections, &mut leaves)
  let listed = List<Interned<Type>>.asSlice(&leaves)
  let mut output = List<StoredAlternative>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let placed = run UnionProjection.within(&storage, &run RuntimeType.project(&listed[at], projections))
    let mut tag = usize.ZERO
    let mut stored = Interned<Type>.clone(&storage)
    match move placed {
      Option<UnionPlacement>.Some {value: UnionPlacement.Whole} => {}
      Option<UnionPlacement>.Some {value: UnionPlacement.Tagged {tag: physical, ty: member}} => {
        tag = physical
        stored = move member
      }
      _ => CompilerBug.panic(b"a stored Effect alternative has no single tag in its join's storage")
    }
    let previous = List<StoredAlternative>.asSlice(&output)
    let mut shared = false
    let mut scan = usize.ZERO
    while scan < previous.length {
      if previous[scan].tag == tag { shared = true }
      scan = scan + usize.ONE
    }
    if !shared {
      run List<StoredAlternative>.append(&mut output, StoredAlternative {alternative: Interned<Type>.clone(&listed[at]),
        tag: tag, storage: move stored})
    }
    at = at + usize.ONE
  }
  return Option<List<StoredAlternative>>.some(move output)
}

// The non-join alternatives a join stores, in order: a nested join, or an Effect family realized
// as one, contributes its own alternatives; a union storage contributes its canonical members.
effect fn joinLeaves(ty: &Interned<Type>, projections: &[RuntimeProjection], leaves: &mut List<Interned<Type>>) -> ()
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut nested = Option<List<Interned<Type>>>.none()
  match move run Type.copy(ty) {
    Type.EffectJoin {alternatives, ..} => { nested = Option<List<Interned<Type>>>.some(move alternatives) }
    Type.Union {..} => { nested = run Type.canonicalUnionMembers(ty) }
    Type.OpaqueRepresentation {..} => {
      if let Option<Interned<Type>>.Some {value: realized} = move run RuntimeType.resolved(ty, projections) {
        if Interned<Type>.with<bool>(&realized, |value: &Type| -> bool {
          return match &value.* { Type.EffectJoin {..} => true _ => false }
        }) { return run joinLeaves(&realized, projections, &mut leaves.*) }
      }
    }
    _ => {}
  }
  match move nested {
    Option<List<Interned<Type>>>.Some {value} => {
      let listed = List<Interned<Type>>.asSlice(&value)
      let mut at = usize.ZERO
      while at < listed.length {
        run joinLeaves(&listed[at], projections, &mut leaves.*)
        at = at + usize.ONE
      }
    }
    Option<List<Interned<Type>>>.None => run List<Interned<Type>>.append(&mut leaves.*, Interned<Type>.clone(ty))
  }
  return ()
}

// Prepares the run of one exact Effect: a construction's or block's runner, or a composition whose
// parts are prepared first. Returns the step's index; the root is the last step (D4).
effect fn compositePlan(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Interned<DeclarationId>, ty: &Interned<Type>,
  origin: BodyOrigin, own: &[ProviderEntry], bound: &mut List<BoundProvider>, module: &ModuleId,
  steps: &mut List<MirRunPlan>, anchor: &Anchor) -> Result<usize, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A producer's Effect family runs through the storage its returns realize (EFF-013), and an
  // interface operation's Effect through the storage its selected witness realizes (EFF-001).
  if Interned<Type>.with<bool>(ty, |value: &Type| -> bool {
    return match &value.* { Type.OpaqueRepresentation {..} => true Type.CallableWitnessResult {..} => true _ => false }
  }) {
    let realized = match move run RuntimeType.resolved(ty, projections) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return CompilerBug.panic(b"a run's opaque or witness Effect has no realized storage") }
    }
    return run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
      projections, identity, &realized, origin, own, &mut bound.*, module, &mut steps.*, anchor)
  }
  // A finite join runs only the selected alternative's own plan (EFF-013, D1).
  let stored = run storedAlternatives(ty, projections)
  if let Option<List<StoredAlternative>>.Some {value: alternatives} = move stored {
    let listed = List<StoredAlternative>.asSlice(&alternatives)
    let mut arms = List<MirJoinArm>.make()
    let mut at = usize.ZERO
    while at < listed.length {
      let step = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
        projections, identity, &listed[at].alternative, origin, own, &mut bound.*, module, &mut steps.*, anchor) {
        Result<usize, PreparationFailure>.Success {value} => value
        Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      run List<MirJoinArm>.append(&mut arms, MirJoinArm {step: step, tag: listed[at].tag, ty: Interned<Type>.clone(&listed[at].storage)})
      at = at + usize.ONE
    }
    run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Join {arms: move arms, tagged: listed.length > usize.ONE})
    return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
  }
  // An exclusive view lent to a `mut` or `once` parameter, or the bare reference it normalizes
  // to, runs the lender's own plan through that reference (EFFECT-OWN-002).
  let lender = Interned<Type>.with<Option<Interned<Type>>>(ty, lentStorage)
  if let Option<Interned<Type>>.Some {value: referent} = move lender {
    let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
      callerBindings, projections, identity, &referent, origin, own, &mut bound.*, module, &mut steps.*, anchor) {
      Result<usize, PreparationFailure>.Success {value} => value
      Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
    }
    run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Lent {inner: inner})
    return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
  }
  let channels = match move Interned<Type>.with<Option<EffectChannels>>(ty, effectChannels) {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return CompilerBug.panic(b"a run Effect has no channels") }
  }
  let shape = run Type.copy(ty)
  match move shape {
    Type.EffectComposite {operation, selector, parts, ..} => {
      let stored = List<Interned<Type>>.asSlice(&parts)
      // A binding serves its selected key with the stored provider for part 0's run only (D2 rule 2).
      if bindingComposition(operation) {
        let owned = operation == Composition.BindOwned
        // An owned provider that needs cleanup is dropped on both exits of the inner run.
        let mut providerDrop = Option<MirProviderDrop>.none()
        if owned {
          let cleanup = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
            Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
            Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
          }
          if let Option<Interned<Type>>.Some {value: dropped} = move cleanup {
            let protected = match move partChannels(&stored[usize.ZERO]) {
              Option<EffectChannels>.Some {value} => move value
              Option<EffectChannels>.None => { return CompilerBug.panic(b"a binding composition's protected part has no channels") }
            }
            providerDrop = Option<MirProviderDrop>.some(MirProviderDrop {provider: move dropped, innerFailure: move protected.failure})
          }
        }
        let mut access = Access.Mutable
        if operation == Composition.BindShared { access = Access.Shared }
        let provider = match move Interned<Type>.with<Option<Interned<Type>>>(&stored[usize.ONE], |value: &Type| -> Option<Interned<Type>> {
          if owned { return Option<Interned<Type>>.none() }
          return match &value.* { Type.Reference {referent, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&referent)) _ => Option<Interned<Type>>.none() }
        }) {
          Option<Interned<Type>>.Some {value} => move value
          Option<Interned<Type>>.None => Interned<Type>.clone(&stored[usize.ONE])
        }
        let address = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&provider), access: access,
          lifetime: run Types.internLifetime(Lifetime.Static)})
        let key = match move run carriedKey(&selector) {
          Option<Requirement>.Some {value} => move value
          Option<Requirement>.None => { return CompilerBug.panic(b"a binding composition carries no requirement key") }
        }
        run List<BoundProvider>.append(&mut bound.*, BoundProvider {key: move key, owned: owned, access: access,
          provider: move provider, address: move address})
        let inner = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
          projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*, anchor)
        drop List<BoundProvider>.pop(&mut bound.*)
        let innerStep = match move inner {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Bind {inner: innerStep, providerDrop: move providerDrop})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      if operation == Composition.Observe {
        // The body runs under this observer; its callback is reached through the observer record (N1).
        let callback = match move run observerTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ONE], &stored[usize.ZERO], origin, anchor) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => move value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let stateDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ZERO], origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let callbackDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[2], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let address = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&stored[usize.ZERO]), access: Access.Mutable,
          lifetime: run Types.internLifetime(Lifetime.Static)})
        // Every diagnostic the body reports invokes the callback, so it owes the NonParking proof
        // the observation intrinsic declares, unless a premise of the caller carries it or this whole
        // composite.
        let carriedPart = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, &stored[usize.ONE], BodyOrigin.span(origin, anchor))
        let carriedWhole = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, ty, BodyOrigin.span(origin, anchor))
        let owed = !carriedPart && !carriedWhole
        let lent = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&stored[usize.ONE]), access: Access.Shared,
          lifetime: run Types.internLifetime(Lifetime.Static)})
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Observe {inner: inner, state: move address, stateDrop: move stateDrop,
          callable: move lent, callbackDrop: move callbackDrop, callback: move callback, owed: owed})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      if operation == Composition.UseRelease {
        // Both callables receive a fresh exclusive loan of the owned resource (D4).
        let lent = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&stored[usize.ZERO]), access: Access.Mutable,
          lifetime: run Types.internLifetime(Lifetime.Local {
            declaration: DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: origin.node, binder: usize.MAX})})
        let use = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
          projections, identity, &stored[usize.ONE], &lent, origin, anchor) {
          Result<InvokedTarget, PreparationFailure>.Success {value} => move value
          Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let release = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[2], &lent, origin, anchor) {
          Result<InvokedTarget, PreparationFailure>.Success {value} => move value
          Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        // A loaned invocation leaves its callable in place, so the run drops an owning one after it.
        let mut useDrop = Option<Interned<Type>>.none()
        if use.mode != CallableMode.Once {
          useDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
            Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
            Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
          }
        }
        let mut releaseDrop = Option<Interned<Type>>.none()
        if release.mode != CallableMode.Once {
          releaseDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[2], origin, anchor) {
            Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
            Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
          }
        }
        let resourceDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ZERO], origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let InvokedTarget {target: useCall, channels: useChannels, ..} = move use
        // A failure waits for the release; a frame cancelled meanwhile drops it.
        let useFailureDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &useChannels.failure, origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let InvokedTarget {target: releaseCall, channels: releaseChannels, ..} = move release
        // A release that fails on a cancelled frame has its failure dropped.
        let releaseFailureDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &releaseChannels.failure, origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let useServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move useCall, own,
          List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => move value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let releaseServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move releaseCall, own,
          List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
          Result<MirCallTarget, PreparationFailure>.Success {value} => move value
          Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        // A release's NonParking proof is owed here unless a premise of the caller carries it, or
        // carries this whole composite, whose entry obligation covers every part and drop. A
        // carried release does not cover the resource the run drops after it.
        let carriedPart = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, &stored[2], BodyOrigin.span(origin, anchor))
        let carriedWhole = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, ty, BodyOrigin.span(origin, anchor))
        let owed = !carriedPart && !carriedWhole
        let resourceOwed = !carriedWhole
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.UseRelease {lent: move lent, use: move useServed,
          useSuccess: move useChannels.success, useFailure: move useChannels.failure, useFailureDrop: move useFailureDrop,
          useDrop: move useDrop, release: move releaseServed, releaseDrop: move releaseDrop,
          releaseSuccess: move releaseChannels.success, releaseFailure: move releaseChannels.failure,
          releaseFailureDrop: move releaseFailureDrop, resourceDrop: move resourceDrop,
          owed: owed, resourceOwed: resourceOwed})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      // A suspension runs its deferred child at an explicit boundary (SUSP-001).
      if operation == Composition.Suspend {
        let deferred = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Suspend {inner: deferred})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      // An interruptible boundary runs its body, part 1; the token, part 0, is data.
      if operation == Composition.Interrupt {
        let body = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ONE], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Interrupt {inner: body})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      if operation != Composition.CatchFailure && operation != Composition.Finalize && operation != Composition.FinalizeNonParking {
        return CompilerBug.panic(b"a run composition has no plan")
      }
      let inner = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
        projections, identity, &stored[usize.ZERO], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
        Result<usize, PreparationFailure>.Success {value} => value
        Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      let protected = match move partChannels(&stored[usize.ZERO]) {
        Option<EffectChannels>.Some {value} => move value
        Option<EffectChannels>.None => { return CompilerBug.panic(b"a composition's protected part has no channels") }
      }
      if operation != Composition.CatchFailure {
        // The finalizer is itself an exact Effect. NonParking is a compile-time bound (D4): the run owes
        // its proof unless a premise of the caller carries it, or carries this whole composite.
        let finalizer = match move run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
          callerBindings, projections, identity, &stored[usize.ONE], origin, own, &mut bound.*, module, &mut steps.*, anchor) {
          Result<usize, PreparationFailure>.Success {value} => value
          Result<usize, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let cleanup = match move partChannels(&stored[usize.ONE]) {
          Option<EffectChannels>.Some {value} => move value
          Option<EffectChannels>.None => { return CompilerBug.panic(b"a finalizer has no channels") }
        }
        // Cancelling the protected part drops a parking finalizer unrun.
        let finalizerDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        // A failure waits for the finalizer; a frame cancelled meanwhile drops it.
        let innerFailureDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &protected.failure, origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
        let nonParking = operation == Composition.FinalizeNonParking
        let carriedPart = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, &stored[usize.ONE], BodyOrigin.span(origin, anchor))
        let carriedWhole = run carriesNonParking(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
          projections, ty, BodyOrigin.span(origin, anchor))
        let owed = nonParking && !carriedPart && !carriedWhole
        run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Finalize {inner: inner, innerFailure: move protected.failure,
          innerFailureDrop: move innerFailureDrop, finalizer: finalizer, finalizerSuccess: move cleanup.success, nonParking: nonParking,
          finalizerDrop: move finalizerDrop, owed: owed})
        return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
      }
      let handler = match move run invokedTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, identity, &stored[usize.ONE], &selector, origin, anchor) {
        Result<InvokedTarget, PreparationFailure>.Success {value} => move value
        Result<InvokedTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      let InvokedTarget {target: handlerCall, channels: handlerChannels, mode: handlerMode} = move handler
      let handlerServed = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move handlerCall, own,
        List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => move value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      // Only the selected path consumes the handler; every other exit drops an owning one.
      let handlerDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &stored[usize.ONE], origin, anchor) {
        Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
        Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      // A loaned handler stays in place after the selected path invokes it, which then drops it too.
      let handlerKept = handlerMode != CallableMode.Once
      run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Catch {selector: move selector, inner: inner,
        innerFailure: move protected.failure, handler: move handlerServed, handlerSuccess: move handlerChannels.success,
        handlerFailure: move handlerChannels.failure, handlerDrop: move handlerDrop, handlerKept: handlerKept})
    }
    Type.CallableValue {contract, ..} => {
      let mode = Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
      // A loaned run never consumes the stored callable, so the run drops an owning one after it.
      let mut partDrop = Option<Interned<Type>>.none()
      if mode != CallableMode.Once {
        partDrop = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, origin, anchor) {
          Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
          Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
        }
      }
      let inputs = CallableCallInputs {receiver: Interned<Type>.clone(ty), inference: Interned<DeclarationId>.clone(identity),
        bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: mode, callee: node,
        result: Interned<Type>.clone(&channels.success), count: usize.ZERO, origin: origin}
      let written = List<Interned<Type>>.make()
      let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
        callerBindings, projections, move inputs, List<Interned<Type>>.asSlice(&written), anchor) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => move value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
        List<BoundProvider>.asSlice(&bound.*), projections, module, BodyOrigin.span(origin, anchor)) {
        Result<MirCallTarget, PreparationFailure>.Success {value} => move value
        Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<usize, PreparationFailure>.failResult(move error) }
      }
      run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Runner {target: move target, success: move channels.success,
        failure: move channels.failure, partDrop: move partDrop})
    }
    _ => { return CompilerBug.panic(b"a run value is not an exact Effect") }
  }
  return Result<usize, PreparationFailure>.succeed(List<MirRunPlan>.length(&steps.*) - usize.ONE)
}

// The runtime storage types an instance's own `Intrinsic.NonParking` premises bind, or none when its
// premises are unavailable.
effect fn nonParkingSubjects(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection],
  span: Span) -> Option<List<Interned<Type>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
    callerBindings, span) {
    Option<List<Constraint>>.Some {value} => move value
    Option<List<Constraint>>.None => { return Option<List<Interned<Type>>>.none() }
  }
  let listed = List<Constraint>.asSlice(&premises)
  let mut subjects = List<Interned<Type>>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if let Constraint.Property {subject, property} = &listed[at] {
      if property == IntrinsicProperty.NonParking {
        run List<Interned<Type>>.append(&mut subjects, run RuntimeType.project(&subject, projections))
      }
    }
    at = at + usize.ONE
  }
  return Option<List<Interned<Type>>>.some(move subjects)
}

// Whether an `Intrinsic.NonParking` premise of the caller binds the stored part `part`. Such a
// part's proof is the caller instance's own entry obligation, checked against the same type, so
// the site owes none (the bootstrap's `carriesNonParkingProof`).
effect fn carriesNonParking(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection],
  part: &Interned<Type>, span: Span) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let subjects = match move run nonParkingSubjects(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
    projections, span) {
    Option<List<Interned<Type>>>.Some {value} => move value
    Option<List<Interned<Type>>>.None => { return false }
  }
  let stored = run RuntimeType.project(part, projections)
  let listed = List<Interned<Type>>.asSlice(&subjects)
  let mut at = usize.ZERO
  while at < listed.length {
    if run Type.runtimeEqualsShared(&listed[at], &stored) { return true }
    at = at + usize.ONE
  }
  return false
}

// Appends the instances that run a value of the closed runtime type `ty` to `targets`, the
// declaration of a callable schema, each of whose uses opens its own instance, to `declarations`,
// and the types whose drop glue running or dropping the value executes in place to `glues`.
// Answers
// false when some part of it has no exact executable target: the bootstrap's
// `Unavailable:exact execution target`, which leaves the NonParking proof unproved (SEM0139).
effect fn executableTargets(ty: &Interned<Type>, targets: &mut List<InstanceKey>, declarations: &mut List<Interned<DeclarationId>>,
  glues: &mut List<Interned<Type>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  // The value may be dropped unrun, such as a cancelled finalizer, which runs its glue in place.
  run List<Interned<Type>>.append(&mut glues.*, Interned<Type>.clone(ty))
  let shape = run Type.copy(ty)
  match move shape {
    Type.CallableValue {application, ..} => {
      let key = match move run InstanceKey.function(run Application.copyShared(&application)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value} => move value
        Result<InstanceKey, CanonicalizationFailure>.Failure {..} => { return false }
      }
      run List<InstanceKey>.append(&mut targets.*, move key)
      return true
    }
    Type.EffectComposite {operation, parts, ..} => {
      let stored = List<Interned<Type>>.asSlice(&parts)
      // The executable parts of each composition: a binding's provider, a bracket's resource and
      // an observer's state are data, reached only through the instances that run the others.
      let mut first = usize.ZERO
      let mut last = usize.ZERO
      if operation == Composition.CatchFailure || operation == Composition.Finalize || operation == Composition.FinalizeNonParking {
        last = usize.ONE
      } else if operation == Composition.UseRelease || operation == Composition.Observe {
        first = usize.ONE
        last = 2
      } else if operation == Composition.Interrupt {
        first = usize.ONE
        last = usize.ONE
      }
      if last >= stored.length { return false }
      // The runner drops its data parts in place: a bracket's resource, a binding's provider and
      // an observer's state.
      let mut part = usize.ZERO
      while part < stored.length {
        run List<Interned<Type>>.append(&mut glues.*, Interned<Type>.clone(&stored[part]))
        part = part + usize.ONE
      }
      let mut at = first
      while at <= last {
        if !run executableTargets(&stored[at], &mut targets.*, &mut declarations.*, &mut glues.*) { return false }
        at = at + usize.ONE
      }
      return true
    }
    Type.EffectJoin {alternatives, ..} => {
      let listed = List<Interned<Type>>.asSlice(&alternatives)
      let mut at = usize.ZERO
      while at < listed.length {
        if !run executableTargets(&listed[at], &mut targets.*, &mut declarations.*, &mut glues.*) { return false }
        at = at + usize.ONE
      }
      return listed.length > usize.ZERO
    }
    Type.CallableSchema {schema, ..} => {
      let target = Frozen<SectionSchema>.with<Interned<DeclarationId>>(&schema, |value: &SectionSchema| -> Interned<DeclarationId> {
        return Interned<DeclarationId>.clone(&value.target)
      })
      run List<Interned<DeclarationId>>.append(&mut declarations.*, move target)
      return true
    }
    Type.CallableView {representation, ..} => { return run executableTargets(&representation, &mut targets.*, &mut declarations.*, &mut glues.*) }
    Type.Reference {referent, ..} => { return run executableTargets(&referent, &mut targets.*, &mut declarations.*, &mut glues.*) }
    _ => { return false }
  }
}

// Whether `key` is a plain function whose result is an Effect value, which its caller runs. A
// function whose signature is unavailable answers true.
effect fn returnsEffectValue(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, key: &InstanceKey) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Interned<Application>>.None = move InstanceKey.application(key) { return false }
  let identity = InstanceKey.identity(key)
  let location = match move run locationOfIdentity(&mut resolver.*, &identity) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return true }
  }
  let request = Key {family: Family.Signature, module: location.module, name: usize.ZERO, declaration: location.declaration,
    member: usize.ZERO, external: false}
  let interned = run internDeclaration(&mut resolver.*, request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, interned, Span.make(usize.ZERO, usize.ZERO))
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return true }
  }
  if facts.isEffect { return false }
  let channels = Interned<Type>.with<Option<EffectChannels>>(&facts.result, effectChannels)
  return match &channels { Option<EffectChannels>.Some {..} => true Option<EffectChannels>.None => false }
}

// An instance's entry NonParking obligations: each of its own `Intrinsic.NonParking` premises,
// owed by the call that reaches the instance, against the instances that run the bound value.
effect fn entryNonParking(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection])
  -> List<MirNonParkingRun>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut obligations = List<MirNonParkingRun>.make()
  let subjects = match move run nonParkingSubjects(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller, callerBindings,
    projections, Span.make(usize.ZERO, usize.ZERO)) {
    Option<List<Interned<Type>>>.Some {value} => move value
    Option<List<Interned<Type>>>.None => {
      run List<MirNonParkingRun>.append(&mut obligations, MirNonParkingRun {callees: List<InstanceKey>.make(),
        glues: List<Interned<Type>>.make(), declarations: List<Interned<DeclarationId>>.make(), exact: false,
        origin: ParkOrigin.Entry})
      return move obligations
    }
  }
  let listed = List<Interned<Type>>.asSlice(&subjects)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut callees = List<InstanceKey>.make()
    let mut declarations = List<Interned<DeclarationId>>.make()
    let mut glues = List<Interned<Type>>.make()
    let mut exact = run executableTargets(&listed[at], &mut callees, &mut declarations, &mut glues)
    // A plain function that returns an Effect value hands it to its caller to run, so the instance
    // alone does not run everything the bound value starts. Such a target is not exact until a
    // returned composite's parts can be targeted.
    let reached = List<InstanceKey>.asSlice(&callees)
    let mut callee = usize.ZERO
    while exact && callee < reached.length {
      if run returnsEffectValue(&mut resolver.*, &mut owner.*, &mut dependencies.*, &reached[callee]) { exact = false }
      callee = callee + usize.ONE
    }
    run List<MirNonParkingRun>.append(&mut obligations, MirNonParkingRun {callees: move callees, glues: move glues,
      declarations: move declarations, exact: exact, origin: ParkOrigin.Entry})
    at = at + usize.ONE
  }
  return move obligations
}

// The channels of a stored Effect part, read through a lent view or reference to its lender.
fn partChannels(value: &Interned<Type>) -> Option<EffectChannels> {
  let lender = Interned<Type>.with<Option<Interned<Type>>>(value, lentStorage)
  if let Option<Interned<Type>>.Some {value: referent} = move lender {
    return Interned<Type>.with<Option<EffectChannels>>(&referent, effectChannels)
  }
  return Interned<Type>.with<Option<EffectChannels>>(value, effectChannels)
}

// Whether `value` is an Effect or callable value an exclusive view may lend.
pub fn lendableValue(value: &Type) -> bool {
  return match &value.* {
    Type.Reference {..} => false
    Type.CallableValue {..} => true
    Type.EffectComposite {..} => true
    Type.EffectJoin {..} => true
    _ => callableInvocationMode(value) != CallableMode.Once
  }
}

// The lender storage an exclusive Effect view or reference runs through, if `value` is one.
pub fn lentStorage(value: &Type) -> Option<Interned<Type>> {
  return match &value.* {
    Type.CallableView {representation, ..} => Interned<Type>.with<Option<Interned<Type>>>(&representation, lentStorage)
    Type.Reference {referent, access, ..} => {
      if access != Access.Mutable { return Option<Interned<Type>>.none() }
      return Option<Interned<Type>>.some(Interned<Type>.clone(&referent))
    }
    _ => Option<Interned<Type>>.none()
  }
}

// The target size, alignment and stride of one closed runtime type, demanded through the layout
// query.
effect fn measuredLayout(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Interned<Type>, span: Span) -> Option<LayoutMetrics>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run internErasedType(&mut resolver.*, ty)
  let declarationAccess178Request = Key {family: Family.Layout, module: usize.ZERO,
    name: application, declaration: usize.ZERO, member: usize.ZERO, external: false}
  let declarationAccess178 = run internDeclaration(&mut resolver.*, declarationAccess178Request)
  let layout = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess178, span)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layout, layoutIndex)
  if let Option<usize>.Some {value} = move selected {
    let layouts = List<Interned<BackendLayout>>.asSlice(&resolver.layoutValues)
    return Option<LayoutMetrics>.some(Interned<BackendLayout>.with<LayoutMetrics>(&layouts[value], BackendLayout.metrics))
  }
  return Option<LayoutMetrics>.none()
}

// One closed written type argument of a storage call.
effect fn storageInstanceType(body: &Shared<TypedBody>, node: BodyNodeId, at: usize, callerBindings: &[Binding],
  projections: &[RuntimeProjection]) -> Interned<Type> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let written = TypedBody.storageTypeArgument(body, node, at)
  return match move written {
    Option<Interned<Type>>.Some {value} => run RuntimeType.applyBindings(&value, callerBindings, projections)
    Option<Interned<Type>>.None => { fail RevisionMismatch {} }
  }
}

// A schema's contract is an original bound blueprint, not its selected invocation result.
// Select from the actual operands and caller premises before checking the storage promise.
effect fn storageInvocationResult(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], receiver: &Interned<Type>, contract: &Interned<Type>,
  written: &[Interned<Type>], span: Span) -> Result<Interned<Type>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut callable = Interned<Type>.clone(receiver)
  while true {
    let copied = run Type.copy(&callable)
    if let Type.Reference {referent, ..} = move copied { callable = move referent } else { break }
  }
  let schema = Interned<Type>.with<Option<Frozen<SectionSchema>>>(&callable, sectionSchemaOf)
  if let Option<Frozen<SectionSchema>>.Some {value: recipe} = move schema {
    let module = DeclarationId.moduleId(Application.bodyDeclaration(caller))
    let premises = match move run closedApplicationPremises(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      caller, callerBindings, span) {
      Option<List<Constraint>>.Some {value} => move value
      _ => { return Result<Interned<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let callableInputs = run sectionFieldInputs(&callable)
    let selected = match move run schemaCallableApplication(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      module, callerBindings, List<Constraint>.asSlice(&premises), &recipe, List<CallableFieldInput>.asSlice(&callableInputs),
      written, span) {
      Result<Application, PreparationFailure>.Success {value} => move value
      Result<Application, PreparationFailure>.Failure {error} => { return Result<Interned<Type>, PreparationFailure>.failResult(move error) }
    }
    let application = run Application.substitute(&selected, caller)
    let signature = run sectionOriginalSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*,
      Application.bodyDeclaration(&application), span)
    let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
      Option<SignatureFacts>.Some {value} => move value
      _ => { return Result<Interned<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
    }
    // An effect fn invocation constructs an Effect rather than returning its runner's success.
    // Storage does not yet prepare that construction; do not admit the success as its result.
    if facts.isEffect { return Result<Interned<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    let bindings = run Application.bindings(&application)
    return run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application,
      &facts.result, List<Binding>.asSlice(&bindings), projections, span)
  }
  let result = match move Interned<Type>.with<Option<Interned<Type>>>(contract, callableResult) {
    Option<Interned<Type>>.Some {value} => move value
    _ => { return Result<Interned<Type>, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  return Result<Interned<Type>, PreparationFailure>.succeed(run RuntimeType.applyBindings(&result, callerBindings, projections))
}

// The prepared invocation and actual result of one storage callback, independently checked
// against the primitive's promise. Only its conflict policy may diverge instead of producing it.
effect fn storageCallableTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, argument: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Interned<DeclarationId>, own: &[ProviderEntry],
  module: &ModuleId, written: List<Interned<Type>>, promised: &Interned<Type>, divergent: bool,
  targets: &mut List<MirCallTarget>, results: &mut List<Interned<Type>>, anchor: &Anchor)
-> Option<PreparationFailure> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let callable = Shared<TypedBody>.with<Option<Interned<Type>>>(body, |value: &TypedBody| -> Option<Interned<Type>> {
    return nodeTypeAt(value, argument.index)
  })
  let receiver = match move callable {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let origin = Shared<TypedBody>.with<BodyOrigin>(body, |value: &TypedBody| -> BodyOrigin { return TypedBody.nodeSlice(value)[argument.index].origin })
  let closed = run RuntimeType.applyBindings(&receiver, callerBindings, projections)
  let none = List<Constraint>.make()
  let contract = match move run valueCallableContract(&closed, List<Constraint>.asSlice(&none)) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let result = match move run storageInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies.*, caller,
    callerBindings, projections, &closed, &contract, List<Interned<Type>>.asSlice(&written), BodyOrigin.span(origin, anchor)) {
    Result<Interned<Type>, PreparationFailure>.Success {value} => move value
    Result<Interned<Type>, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
  }
  let exact = run Type.runtimeEqualsShared(&result, promised)
  let diverges = divergent && Interned<Type>.with<bool>(&result, neverType)
  if !exact && !diverges { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.WitnessOperand}) }
  let inputs = CallableCallInputs {receiver: move receiver, inference: Interned<DeclarationId>.clone(identity),
    bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Interned<Type>.with<CallableMode>(&contract, callableInvocationMode),
    callee: argument, result: Interned<Type>.clone(&result), count: List<Interned<Type>>.length(&written), origin: origin}
  let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, List<Interned<Type>>.asSlice(&written), anchor) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => move value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
  }
  let unbound = List<BoundProvider>.make()
  let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
    List<BoundProvider>.asSlice(&unbound), projections, module, BodyOrigin.span(origin, anchor)) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => move value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
  }
  run List<MirCallTarget>.append(&mut targets.*, move target)
  run List<Interned<Type>>.append(&mut results.*, move result)
  return Option<PreparationFailure>.none()
}

// What one storage primitive's expansion needs from this instance: the measured layout of its
// element or control block, the sealed C allocator declarations, the element's cleanup verdict
// and `sharedWithMut`'s prepared invocations.
effect fn storagePlan(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, operation: StorageOperation,
  caller: &Application, callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Interned<DeclarationId>,
  own: &[ProviderEntry], module: &ModuleId, span: Span, anchor: &Anchor) -> Result<MirStoragePlan, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let allocation = run SealedCore.identity(SealedKind.Allocation)
  let mut externs = List<Interned<DeclarationId>>.make()
  run List<Interned<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Malloc))
  run List<Interned<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Free))
  run List<Interned<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Memmove))
  run List<Interned<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Memset))
  run List<Interned<DeclarationId>>.append(&mut externs, run SealedCore.cFunction(&allocation, SealedFunction.Realloc))
  let mut element = run Types.intern(Type.Unit)
  if StorageOperation.typeArity(operation) > usize.ZERO || operation == StorageOperation.Replace {
    element = run storageInstanceType(body, node, usize.ZERO, callerBindings, projections)
  }
  let mut size = usize.ZERO
  let mut alignment = usize.ONE
  if StorageOperation.measures(operation) {
    let mut measured = Interned<Type>.clone(&element)
    if operation == StorageOperation.SharedLayout || operation == StorageOperation.SharedFromAllocation {
      measured = run SealedCore.applied(SealedKind.SharedBlock, &element)
    }
    // An execution package is measured whole: its header, body, readiness endpoint and allocation.
    if operation == StorageOperation.ExecutionLayout || operation == StorageOperation.ExecutionFromAllocation {
      let mut packaged = List<Interned<Type>>.make()
      let mut argument = usize.ZERO
      while argument < StorageOperation.typeArity(operation) {
        run List<Interned<Type>>.append(&mut packaged, run storageInstanceType(body, node, argument, callerBindings, projections))
        argument = argument + usize.ONE
      }
      measured = run SealedCore.packageBeside(&allocation, List<Interned<Type>>.asSlice(&packaged))
    }
    let facts = match move run measuredLayout(&mut resolver.*, &mut owner.*, &mut dependencies.*, &measured, span) {
      Option<LayoutMetrics>.Some {value} => value
      Option<LayoutMetrics>.None => { return Result<MirStoragePlan, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.ScalarLayout}) }
    }
    size = facts.size
    alignment = facts.alignment
    // Raw-buffer storage holds consecutive elements one stride apart.
    if operation == StorageOperation.RawBufferFrom || operation == StorageOperation.RawBufferCopy
      || operation == StorageOperation.SliceCopy {
      size = match move LayoutMetrics.stride(&facts) {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return Result<MirStoragePlan, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.ScalarLayout}) }
      }
    }
  }
  let mut cleanup = false
  if operation == StorageOperation.SlotDrop {
    cleanup = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element) {
      Result<bool, PreparationFailure>.Success {value} => value
      Result<bool, PreparationFailure>.Failure {error} => { return Result<MirStoragePlan, PreparationFailure>.failResult(move error) }
    }
  }
  let mut targets = List<MirCallTarget>.make()
  let mut results = List<Interned<Type>>.make()
  if operation == StorageOperation.SharedWithMut {
    let promised = run storageInstanceType(body, node, usize.ONE, callerBindings, projections)
    let useArgument = match move TypedBody.storageArgument(body, node, usize.ONE) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    let conflictArgument = match move TypedBody.storageArgument(body, node, 2) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    // The value is lent exclusively for the invocation alone.
    let site = Shared<TypedBody>.with<BodyOrigin>(body, |value: &TypedBody| -> BodyOrigin { return TypedBody.nodeSlice(value)[node.index].origin })
    let mut lent = List<Interned<Type>>.make()
    run List<Interned<Type>>.append(&mut lent, run Types.intern(Type.Reference {referent: Interned<Type>.clone(&element),
      access: Access.Mutable, lifetime: run Types.internLifetime(Lifetime.Local {
        declaration: DeclarationId.copy(Application.bodyDeclaration(caller)), ordinal: site.node, binder: usize.MAX})}))
    let selected = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, useArgument, caller,
      callerBindings, projections, identity, own, module, move lent, &promised, false, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move selected { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
    let policy = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, conflictArgument, caller,
      callerBindings, projections, identity, own, module, List<Interned<Type>>.make(), &promised, true, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move policy { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
  }
  // A completed activation passes the branch state and the result to its completion callback.
  if operation == StorageOperation.ExecutionDrive {
    let completion = match move TypedBody.storageArgument(body, node, 2) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    let mut passed = List<Interned<Type>>.make()
    run List<Interned<Type>>.append(&mut passed, run storageInstanceType(body, node, usize.ONE, callerBindings, projections))
    run List<Interned<Type>>.append(&mut passed, Interned<Type>.clone(&element))
    let unit = run Types.intern(Type.Unit)
    let completed = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, completion, caller,
      callerBindings, projections, identity, own, module, move passed, &unit, false, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move completed { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }    // A relinquished activation hands the branch state and the Execution back to `onSuspend`.
    let suspension = match move TypedBody.storageArgument(body, node, 3) {
      Option<BodyNodeId>.Some {value} => value
      Option<BodyNodeId>.None => { fail RevisionMismatch {} }
    }
    let mut returned = List<Interned<Type>>.make()
    run List<Interned<Type>>.append(&mut returned, run storageInstanceType(body, node, usize.ONE, callerBindings, projections))
    run List<Interned<Type>>.append(&mut returned, run SealedCore.applied(SealedKind.Execution, &element))
    let suspended = run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, suspension, caller,
      callerBindings, projections, identity, own, module, move returned, &unit, false, &mut targets, &mut results, anchor)
    if let Option<PreparationFailure>.Some {value} = move suspended { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
  }
  let mut steps = List<MirRunPlan>.make()
  if operation == StorageOperation.ExecutionFromAllocation {
    let prepared = run executionHelperPlans(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller, callerBindings,
      projections, identity, own, module, &mut targets, &mut results, &mut steps, anchor)
    if let Option<PreparationFailure>.Some {value} = move prepared { return Result<MirStoragePlan, PreparationFailure>.failResult(move value) }
  }
  return Result<MirStoragePlan, PreparationFailure>.succeed(MirStoragePlan {node: node, size: size, alignment: alignment, externs: move externs,
    cleanup: cleanup, targets: move targets, results: move results, steps: move steps})
}

// What a package's erased helpers run, prepared at the site that adopts it: the body as one run
// into its result, and the readiness endpoint invoked with a shared loan of its readiness state.
effect fn executionHelperPlans(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Interned<DeclarationId>, own: &[ProviderEntry],
  module: &ModuleId, targets: &mut List<MirCallTarget>, results: &mut List<Interned<Type>>, steps: &mut List<MirRunPlan>, anchor: &Anchor)
  -> Option<PreparationFailure> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let bodyArgument = match move TypedBody.storageArgument(body, node, usize.ONE) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { fail RevisionMismatch {} }
  }
  let endpointArgument = match move TypedBody.storageArgument(body, node, 3) {
    Option<BodyNodeId>.Some {value} => value
    Option<BodyNodeId>.None => { fail RevisionMismatch {} }
  }
  let origin = Shared<TypedBody>.with<BodyOrigin>(body, |value: &TypedBody| -> BodyOrigin { return TypedBody.nodeSlice(value)[bodyArgument.index].origin })
  let written = match move Shared<TypedBody>.with<Option<Interned<Type>>>(body, |value: &TypedBody| -> Option<Interned<Type>> {
    return nodeTypeAt(value, bodyArgument.index)
  }) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return Option<PreparationFailure>.some(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
  }
  let closed = run Type.applyBindings(&written, callerBindings, true)
  if Interned<Type>.with<bool>(&closed, compositeType) {
    let mut bound = List<BoundProvider>.make()
    let prepared = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, bodyArgument, caller, callerBindings,
      projections, identity, &closed, origin, own, &mut bound, module, &mut steps.*, anchor)
    if let Result<usize, PreparationFailure>.Failure {error} = move prepared { return Option<PreparationFailure>.some(move error) }
  } else {
    let channels = match move Interned<Type>.with<Option<EffectChannels>>(&closed, effectChannels) {
      Option<EffectChannels>.Some {value} => move value
      Option<EffectChannels>.None => { return CompilerBug.panic(b"an execution helper body has no channels") }
    }
    let inputs = CallableCallInputs {receiver: move written, inference: Interned<DeclarationId>.clone(identity),
      bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Interned<Type>.with<CallableMode>(&closed, callableInvocationMode),
      callee: bodyArgument, result: Interned<Type>.clone(&channels.success), count: usize.ZERO, origin: origin}
    let none = List<Interned<Type>>.make()
    let constructed = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, bodyArgument, caller,
      callerBindings, projections, move inputs, List<Interned<Type>>.asSlice(&none), anchor) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
    }
    let unbound = List<BoundProvider>.make()
    let target = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move constructed, own,
      List<BoundProvider>.asSlice(&unbound), projections, module, BodyOrigin.span(origin, anchor)) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Option<PreparationFailure>.some(move error) }
    }
    run List<MirRunPlan>.append(&mut steps.*, MirRunPlan.Runner {target: move target, success: move channels.success,
      failure: move channels.failure, partDrop: Option<Interned<Type>>.none()})
  }
  let state = run storageInstanceType(body, node, 2, callerBindings, projections)
  let mut lent = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut lent, run Types.intern(Type.Reference {referent: move state, access: Access.Shared,
    lifetime: run Types.internLifetime(Lifetime.Static)}))
  let unit = run Types.intern(Type.Unit)
  return run storageCallableTarget(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, endpointArgument, caller,
    callerBindings, projections, identity, own, module, move lent, &unit, false, &mut targets.*, &mut results.*, anchor)
}

// A stored callable invoked with one argument, and the channels of the Effect its invocation runs.
struct InvokedTarget {
  target: MirCallTarget,
  channels: EffectChannels,
  mode: CallableMode,
}

// The observer callback's call `callback(&mut state, event, first, second, identity, origin) ->
// usize` (failure observer note N1). The observation's adapter invokes it repeatedly through a
// shared loan of the stored callable. The check admitted only a shared callable value, and a plain
// callable needs no providers, so every admitted callback has that call.
effect fn observerTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Interned<DeclarationId>, callable: &Interned<Type>,
  state: &Interned<Type>, origin: BodyOrigin, anchor: &Anchor) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let none = List<Constraint>.make()
  let contract = match move run valueCallableContract(callable, List<Constraint>.asSlice(&none)) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => CompilerBug.panic(b"an admitted observer callback has no callable contract")
  }
  let word = run Types.intern(Type.Primitive {name: run Bytes.copy(b"usize")})
  let text = run Types.intern(Type.String {lifetime: run Types.internLifetime(Lifetime.Static)})
  let mut written = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut written, run Types.intern(Type.Reference {referent: Interned<Type>.clone(state),
    access: Access.Mutable, lifetime: run Types.internLifetime(Lifetime.Static)}))
  run List<Interned<Type>>.append(&mut written, run Types.intern(Type.Primitive {name: run Bytes.copy(b"u8")}))
  run List<Interned<Type>>.append(&mut written, Interned<Type>.clone(&word))
  run List<Interned<Type>>.append(&mut written, Interned<Type>.clone(&word))
  run List<Interned<Type>>.append(&mut written, Interned<Type>.clone(&text))
  run List<Interned<Type>>.append(&mut written, move text)
  let inputs = CallableCallInputs {receiver: Interned<Type>.clone(callable), inference: Interned<DeclarationId>.clone(identity),
    bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Interned<Type>.with<CallableMode>(&contract, callableInvocationMode),
    callee: node, result: move word, count: 6, origin: origin}
  let target = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, List<Interned<Type>>.asSlice(&written), anchor) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => move value
    Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  let shared = sharedEnvironment(&target)
  let served = List<MirProviderSource>.length(&target.providers) == usize.ZERO && match &target.dispatch {
    Option<MirProviderSource>.None => true
    _ => false
  }
  if !shared || !served || target.receiverDereferences != usize.ZERO {
    return CompilerBug.panic(b"an admitted observer callback is not invocable through a shared loan")
  }
  return Result<MirCallTarget, PreparationFailure>.succeed(move target)
}

effect fn invokedTarget(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Interned<DeclarationId>, callable: &Interned<Type>,
  argument: &Interned<Type>, origin: BodyOrigin, anchor: &Anchor) -> Result<InvokedTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let none = List<Constraint>.make()
  let contract = match move run valueCallableContract(callable, List<Constraint>.asSlice(&none)) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return CompilerBug.panic(b"a catch handler has no callable contract") }
  }
  let chosen = run invokedSchemaContract(callable, &contract, argument)
  let invoked = match move Interned<Type>.with<Option<Interned<Type>>>(&chosen, callableResult) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return CompilerBug.panic(b"a catch handler does not return an Effect") }
  }
  let channels = match move Interned<Type>.with<Option<EffectChannels>>(&invoked, effectChannels) {
    Option<EffectChannels>.Some {value} => move value
    Option<EffectChannels>.None => { return CompilerBug.panic(b"a catch handler's result has no channels") }
  }
  let mode = Interned<Type>.with<CallableMode>(&contract, callableInvocationMode)
  let mut written = List<Interned<Type>>.make()
  run List<Interned<Type>>.append(&mut written, Interned<Type>.clone(argument))
  let inputs = CallableCallInputs {receiver: Interned<Type>.clone(callable), inference: Interned<DeclarationId>.clone(identity),
    bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: mode, callee: node,
    result: Interned<Type>.clone(&channels.success), count: usize.ONE, origin: origin}
  return match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
    callerBindings, projections, move inputs, List<Interned<Type>>.asSlice(&written), anchor) {
    Result<MirCallTarget, PreparationFailure>.Success {value} => Result<InvokedTarget, PreparationFailure>.succeed(InvokedTarget {target: move value,
      channels: move channels, mode: mode})
    Result<MirCallTarget, PreparationFailure>.Failure {error} => Result<InvokedTarget, PreparationFailure>.failResult(move error)
  }
}

// A generic function value invoked with one argument, such as the handler `caught` for
// `effect fn caught<E>(error: E)`, is selected by that argument: its one parameter binds the
// target's variables, and the bound contract gives the invocation's result.
pub effect fn invokedSchemaContract(callable: &Interned<Type>, contract: &Interned<Type>, argument: &Interned<Type>) -> Interned<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let schema = match move Interned<Type>.with<Option<Frozen<SectionSchema>>>(callable, sectionSchemaOf) {
    Option<Frozen<SectionSchema>>.Some {value} => move value
    _ => { return Interned<Type>.clone(contract) }
  }
  let target = Frozen<SectionSchema>.with<Interned<DeclarationId>>(&schema, |value: &SectionSchema| -> Interned<DeclarationId> {
    return Interned<DeclarationId>.clone(&value.target)
  })
  let parts = run Type.copy(contract)
  if let Type.Callable {parameters, ..} = move parts {
    let accepted = List<Interned<Type>>.asSlice(&parameters)
    if accepted.length != usize.ONE { return Interned<Type>.clone(contract) }
    let mut variables = List<Interned<DeclarationId>>.make()
    run List<Interned<DeclarationId>>.append(&mut variables, move target)
    let mut bindings = List<Binding>.make()
    drop run Type.unify(&accepted[usize.ZERO], argument, List<Interned<DeclarationId>>.asSlice(&variables), Comparison.Exact,
      &mut bindings)
    return run Type.applyBindings(contract, List<Binding>.asSlice(&bindings), true)
  }
  return Interned<Type>.clone(contract)
}

// The prepared invocations of a checked scalar operation's carriers: `present` with the produced
// scalar and `absent` with nothing, both producing the call's result. A carrier that owns cleanup
// records its type so the path that does not invoke it drops it.
effect fn carrierPlan(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, body: &Shared<TypedBody>, node: BodyNodeId, caller: &Application,
  callerBindings: &[Binding], projections: &[RuntimeProjection], identity: &Interned<DeclarationId>,
  operation: ScalarOperation, result: &Interned<Type>, own: &[ProviderEntry], module: &ModuleId, anchor: &Anchor) -> Result<MirCarrierPlan, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let start = ScalarOperation.arity(operation)
  let produced = run primitiveType(ScalarOperation.scalarSpelling(ScalarOperation.result(operation)))
  let mut targets = List<MirCallTarget>.make()
  let mut drops = List<Option<Interned<Type>>>.make()
  let mut at = usize.ZERO
  while at < 2 {
    let argument = match move TypedBody.callArgument(body, node, start + at) {
      Option<CallArgument>.Some {value} => move value
      Option<CallArgument>.None => { fail RevisionMismatch {} }
    }
    // Cleanup acts on the carrier's realized storage, including an opaque returned callable.
    let closed = run RuntimeType.applyBindings(&argument.ty, callerBindings, projections)
    let cleanup = match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, argument.origin, anchor) {
      Result<Option<Interned<Type>>, PreparationFailure>.Success {value} => move value
      Result<Option<Interned<Type>>, PreparationFailure>.Failure {error} => { return Result<MirCarrierPlan, PreparationFailure>.failResult(move error) }
    }
    run List<Option<Interned<Type>>>.append(&mut drops, move cleanup)
    let none = List<Constraint>.make()
    let contract = match move run valueCallableContract(&argument.ty, List<Constraint>.asSlice(&none)) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return Result<MirCarrierPlan, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.TypedForm}) }
    }
    let mut written = List<Interned<Type>>.make()
    if at == usize.ZERO { run List<Interned<Type>>.append(&mut written, Interned<Type>.clone(&produced)) }
    let inputs = CallableCallInputs {receiver: Interned<Type>.clone(&argument.ty), inference: Interned<DeclarationId>.clone(identity),
      bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Interned<Type>.with<CallableMode>(&contract, callableInvocationMode),
      callee: node, result: Interned<Type>.clone(result), count: List<Interned<Type>>.length(&written), origin: argument.origin}
    let target = match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, body, node, caller,
      callerBindings, projections, move inputs, List<Interned<Type>>.asSlice(&written), anchor) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<MirCarrierPlan, PreparationFailure>.failResult(move error) }
    }
    let unbound = List<BoundProvider>.make()
    let served = match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies.*, move target, own,
      List<BoundProvider>.asSlice(&unbound), projections, module, BodyOrigin.span(argument.origin, anchor)) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => move value
      Result<MirCallTarget, PreparationFailure>.Failure {error} => { return Result<MirCarrierPlan, PreparationFailure>.failResult(move error) }
    }
    run List<MirCallTarget>.append(&mut targets, move served)
    at = at + usize.ONE
  }
  let present = List<MirCallTarget>.remove(&mut targets, usize.ZERO)
  let absent = List<MirCallTarget>.remove(&mut targets, usize.ZERO)
  let presentDrop = List<Option<Interned<Type>>>.remove(&mut drops, usize.ZERO)
  let absentDrop = List<Option<Interned<Type>>>.remove(&mut drops, usize.ZERO)
  return Result<MirCarrierPlan, PreparationFailure>.succeed(MirCarrierPlan {node: node, present: move present, absent: move absent,
    presentDrop: move presentDrop, absentDrop: move absentDrop})
}

// Whether a stored part owns cleanup; an unanswerable verdict is treated as owning.
effect fn ownsCleanup(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, part: &Interned<Type>, origin: BodyOrigin, anchor: &Anchor) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  return match move run ownedCleanup(&mut resolver.*, &mut owner.*, &mut dependencies.*, part, origin, anchor) {
    Result<Option<Interned<Type>>, PreparationFailure>.Success {value: Option<Interned<Type>>.None} => false
    _ => true
  }
}

// A stored part's type when an exit that does not consume it must drop it.
effect fn ownedCleanup(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, part: &Interned<Type>, origin: BodyOrigin, anchor: &Anchor) -> Result<Option<Interned<Type>>, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut visiting = List<Interned<Type>>.make()
  let premises = List<Constraint>.make()
  let free = match move run cleanupFree(&mut resolver.*, &mut owner.*, &mut dependencies.*, part, List<Constraint>.asSlice(&premises),
    &mut visiting, BodyOrigin.span(origin, anchor)) {
    Result<bool, Shared<Rejection>>.Success {value} => value
    Result<bool, Shared<Rejection>>.Failure {error} => {
      return Result<Option<Interned<Type>>, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move error})
    }
  }
  if free { return Result<Option<Interned<Type>>, PreparationFailure>.succeed(Option<Interned<Type>>.none()) }
  return Result<Option<Interned<Type>>, PreparationFailure>.succeed(Option<Interned<Type>>.some(Interned<Type>.clone(part)))
}

fn constructedEffect(value: &Type) -> bool {
  return match &value.* {
    Type.CallableValue {contract, ..} => Interned<Type>.with<bool>(&contract, |selected: &Type| -> bool {
      return match &selected.* { Type.Effect {..} => true _ => false }
    })
    _ => false
  }
}

// An effect fn call or `effect fn` value invocation that is not itself run only constructs its
// Effect (D1); its row is served where that value runs, so the call's target is never called here.
// Whether `node` is an `effect fn` interface call whose Effect is stored rather than run in place.
fn storedInterfaceEffect(body: &TypedBody, node: BodyNodeId) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {data: _bx}, ..} = &nodes[node.index].kind {
  let InterfaceCallData {isEffect, ..} = &_bx.get().*

    return isEffect && !ranInPlace(nodes, node.index)
  }
  return false
}

fn constructedOnly(body: &TypedBody, node: BodyNodeId) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let constructs = match &nodes[node.index].kind {
    BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {..}} => Interned<Type>.with<bool>(&ty, constructedEffect)
    BodyNodeKind.Expression {form: BodyExpression.CallableCall {data: _bx}, ..} => { let CallableCallData {constructs: invoked, ..} = &_bx.get().*
  invoked }
    _ => false
  }
  if !constructs { return false }
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Run {value, ..}, ..} = &nodes[at].kind {
      if value.index == node.index { return false }
    }
    at = at + usize.ONE
  }
  return true
}

// One provider stored by a binding that encloses a composed run, outermost first (D2 rule 2).
struct BoundProvider {
  key: Requirement,
  owned: bool,
  access: Access,
  provider: Interned<Type>,
  address: Interned<Type>,
}

// The providers serving one callee row, in its canonical key order, and where each comes from.
struct RowProviders {
  sources: List<MirProviderSource>,
  entries: List<ProviderEntry>,
}

// Whether a declaration is an operation of a service rather than a function with a body.
pub fn serviceOperation(id: &DeclarationId) -> bool {
  let count = DeclarationId.ownerCount(id)
  return count > usize.ONE && serviceKind(DeclarationId.ownerKind(id, count - 2))
}

// The canonical service-role key order (G3): runtime encodings of capability, then role.
effect fn keyEncoding(entry: &Requirement, owner: &DeclarationId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut encoded = run Type.runtimeEncoding(&entry.capability, owner)
  if let Option<Interned<Type>>.Some {value: roleValue} = &entry.roleType {
    let roleBytes = run Type.runtimeEncoding(&roleValue, owner)
    run Bytes.append(&mut encoded, Bytes.asSlice(&roleBytes))
  }
  return move encoded
}

pub fn bytesBefore(left: &[u8], right: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] { return left[at] < right[at] }
    at = at + usize.ONE
  }
  return left.length < right.length
}

fn encodedBefore(encodings: &List<Bytes>, slot: usize) -> bool {
  let listed = List<Bytes>.asSlice(encodings)
  return bytesBefore(Bytes.asSlice(&listed[slot]), Bytes.asSlice(&listed[slot - usize.ONE]))
}

// The entries of a closed row in canonical key order, never source order.
effect fn canonicalEntries(row: &Interned<Row>, owner: &DeclarationId) -> List<Requirement> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = run Row.entryList(row)
  let mut encodings = List<Bytes>.make()
  let listed = List<Requirement>.asSlice(&entries)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Bytes>.append(&mut encodings, run keyEncoding(&listed[at], owner))
    at = at + usize.ONE
  }
  // ponytail: insertion sort; rows hold a handful of keys.
  let mut sorted = usize.ONE
  while sorted < List<Requirement>.length(&entries) {
    let mut slot = sorted
    while slot > usize.ZERO && encodedBefore(&encodings, slot) {
      let key = List<Requirement>.remove(&mut entries, slot)
      run List<Requirement>.insert(&mut entries, slot - usize.ONE, move key)
      let bytes = List<Bytes>.remove(&mut encodings, slot)
      run List<Bytes>.insert(&mut encodings, slot - usize.ONE, move bytes)
      slot = slot - usize.ONE
    }
    sorted = sorted + usize.ONE
  }
  return move entries
}

// The callee's substituted requirement row in canonical key order, each entry served by the
// innermost enclosing binding of its key, else by this instance's own provider (D2), else, for an
// optional service, by the absent provider.
effect fn rowProviders(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, application: &Application, own: &[ProviderEntry], bound: &[BoundProvider],
  module: &ModuleId, span: Span) -> Result<RowProviders, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let signatureOwner = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(application)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    _ => { fail InvalidModulePath {} }
  }
  let declarationAccess179Request = Key {
    family: Family.Signature, module: location.module, name: usize.ZERO,
    declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess179 = run internDeclaration(&mut resolver.*, declarationAccess179Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess179, span)
  let declared = run signatureRequirements(&signature)
  let bindings = run Application.bindings(application)
  let row = run Row.applyBindings(&declared, List<Binding>.asSlice(&bindings), true)
  if Row.hasOpenRuntimeParameters(&row) { return CompilerBug.panic(b"an instance runs an Effect with an open requirement row") }
  let ordered = run canonicalEntries(&row, Application.bodyDeclaration(application))
  let listed = List<Requirement>.asSlice(&ordered)
  let mut sources = List<MirProviderSource>.make()
  let mut entries = List<ProviderEntry>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    let mut found = false
    let mut depth = bound.length
    while !found && depth > usize.ZERO {
      depth = depth - usize.ONE
      if run Requirement.keyEquals(&bound[depth].key, &listed[at]) {
        run List<MirProviderSource>.append(&mut sources, MirProviderSource.Bound {depth: depth, owned: bound[depth].owned,
          access: bound[depth].access, address: Interned<Type>.clone(&bound[depth].address)})
        run List<ProviderEntry>.append(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]),
          provider: Interned<Type>.clone(&bound[depth].provider)})
        found = true
      }
    }
    let mut ownAt = usize.ZERO
    while !found && ownAt < own.length {
      if run Requirement.keyEquals(&own[ownAt].key, &listed[at]) {
        run List<MirProviderSource>.append(&mut sources, MirProviderSource.Own {index: ownAt})
        run List<ProviderEntry>.append(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]),
          provider: Interned<Type>.clone(&own[ownAt].provider)})
        found = true
      }
      ownAt = ownAt + usize.ONE
    }
    // An optional service that neither a binding nor this instance provides runs absent (SERV-011).
    let ambient = Interned<Type>.with<OwnerKind>(&listed[at].capability, nominalKind) == OwnerKind.AmbientService
    if !found && (ambient || optionalService(&resolver.*, &listed[at].capability)) {
      let default = if ambient {
        let serviceModule = match move Interned<Type>.with<Option<ModuleId>>(&listed[at].capability, nominalModule) {
          Option<ModuleId>.Some {value} => move value
          _ => { fail RevisionMismatch {} }
        }
        let position = match move run ordinalOfProvider(&mut resolver.*, &serviceModule, &listed[at].capability) {
          Option<usize>.Some {value} => value
          _ => { fail RevisionMismatch {} }
        }
        let written = match move run scopedHeader(&mut resolver.*, &serviceModule, position) {
          Option<HeaderSyntax>.Some {value} => value
          _ => { fail RevisionMismatch {} }
        }
        let path = match written.header { Node.ServiceHeader {ambientDefault, ..} => ambientDefault _ => HirRef.absent() }
        if !path.present { fail RevisionMismatch {} }
        let ordinal = run internModule(&mut resolver.*, &serviceModule)
        let contractKey = run internDeclaration(&mut resolver.*, Key {family: Family.Contract, module: ordinal,
          name: usize.ZERO, declaration: position, member: usize.ZERO, external: false})
        let contract = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, contractKey, span)
        if let Option<Shared<Rejection>>.Some {value: diagnostic} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&contract, answerCause) {
          return Result<RowProviders, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move diagnostic})
        }
        match move run resolveAmbientDefault(&mut resolver.*, &mut owner.*, &mut dependencies.*, ordinal, &serviceModule, path.id, written.span) {
          Result<AmbientDefault, Shared<Rejection>>.Success {value} => move value
          Result<AmbientDefault, Shared<Rejection>>.Failure {error} => {
            return Result<RowProviders, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move error})
          }
        }
      } else {
        AmbientDefault {ty: run absentProvider(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at].capability, span),
          constant: Option<Interned<StaticData>>.none()}
      }
      let AmbientDefault {ty: provider, constant} = move default
      let address = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&provider), access: Access.Shared,
        lifetime: run Types.internLifetime(Lifetime.Static)})
      let mut dynamic = false
      let mut registrations = Option<Interned<Type>>.none()
      if ambient {
        let registry = run Types.intern(Type.Erased {contracts: Interned<Type>.clone(&listed[at].capability), transferable: true, concurrent: true})
        let unit = recordingUnit(&resolver.*)
        run recordErasedMembers(&mut resolver.*, &registry, Application.bodyDeclaration(application), unit)
        run observeAmbientExtent(&mut resolver.*)
        dynamic = !resolver.closedErasures
        if !dynamic {
          let members = run ErasureIndex.members(currentErasures(&resolver.*), &registry)
          dynamic = List<ErasureFact>.length(&members) != usize.ZERO
        }
        registrations = Option<Interned<Type>>.some(move registry)
      }
      if dynamic {
        let registration = match move registrations { Option<Interned<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        let erased = run Types.intern(Type.Erased {contracts: Interned<Type>.clone(&listed[at].capability), transferable: false, concurrent: false})
        let descriptor = run Types.intern(Type.Reference {referent: Interned<Type>.clone(&erased), access: Access.Shared, lifetime: run Types.internLifetime(Lifetime.Static)})
        run List<MirProviderSource>.append(&mut sources, MirProviderSource.Ambient {provider: move provider, address: move address, constant: move constant,
          erased: Interned<Type>.clone(&erased), registration: move registration, descriptor: move descriptor, tagType: run Types.intern(Type.Primitive {name: run Bytes.copy(b"u64")})})
        run List<ProviderEntry>.append(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]), provider: move erased})
      } else {
        let source = if let Option<Interned<StaticData>>.Some {value} = move constant {
          MirProviderSource.ConstantDefault {provider: Interned<Type>.clone(&provider), address: move address, constant: move value}
        } else { MirProviderSource.Absent {provider: Interned<Type>.clone(&provider), address: move address} }
        run List<MirProviderSource>.append(&mut sources, move source)
        run List<ProviderEntry>.append(&mut entries, ProviderEntry {key: Requirement.copy(&listed[at]), provider: move provider})
      }
      found = true
    }
    // A standalone proof can inspect a stored Effect before any run selects its providers.
    // Keep that distinction until a concrete operation actually needs this service.
    if !found {
      let mut diagnostic = run makeRejection(RejectionCode.UnhandledRequirement, module, span)
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"provider"), value: run writtenTypeName(module, &listed[at].capability)})
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
      return Result<RowProviders, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: run Shared<Rejection>.make(move diagnostic)})
    }
    at = at + usize.ONE
  }
  return Result<RowProviders, PreparationFailure>.succeed(RowProviders {sources: move sources, entries: move entries})
}

// The one row entry naming the service that owns `operation`, by position; absent when the row
// names that service under no role or several (witness checking refuses the latter).
fn dispatchedEntry(entries: &[ProviderEntry], operation: &DeclarationId) -> usize {
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < entries.length {
    let owns = Interned<Type>.with<bool>(&entries[at].key.capability, |value: &Type| -> bool {
      return match &value.* { Type.Nominal {declaration, ..} => DeclarationId.isPrefixOf(&declaration, operation) _ => false }
    })
    if owns {
      if found != usize.MAX { return usize.MAX }
      found = at
    }
    at = at + usize.ONE
  }
  return found
}

// Completes a call target with its callee's providers (D2). A service operation dispatches to the
// witness of its service for the serving provider's type; that witness's own row is served from
// the same environment, and its own declared failure types the call's failure edge (D3).
effect fn provideCall(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, target: MirCallTarget, own: &[ProviderEntry], bound: &[BoundProvider],
  projections: &[RuntimeProjection], module: &ModuleId, span: Span) -> Result<MirCallTarget, PreparationFailure>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut call = move target
  // Providers are matched in the call edge's actual regions; the rebuilt key numbers them.
  let application = run Application.copy(&call.application)
  let operation = DeclarationId.copy(Application.bodyDeclaration(&application))
  let served = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &application, own, bound, module, span) {
    Result<RowProviders, PreparationFailure>.Success {value} => move value
    Result<RowProviders, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  if !serviceOperation(&operation) {
    if List<ProviderEntry>.length(&served.entries) != usize.ZERO {
      call.key = match move run InstanceKey.withProviders(move application, move served.entries) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
      call.providers = move served.sources
    }
    return Result<MirCallTarget, PreparationFailure>.succeed(move call)
  }
  // The operation's row names its own service; that entry's provider receives the call.
  let dispatch = dispatchedEntry(List<ProviderEntry>.asSlice(&served.entries), &operation)
  if dispatch == usize.MAX { return CompilerBug.panic(b"a dispatched call has no provider to dispatch on") }
  let mut request = Request.make()
  let servedEntries = List<ProviderEntry>.asSlice(&served.entries)
  let capability = Interned<Type>.clone(&servedEntries[dispatch].key.capability)
  let provider = Interned<Type>.clone(&servedEntries[dispatch].provider)
  // A `never` provider serves its key vacuously (`Option<never>.none()`): no provider value exists,
  // so the call is never reached and selects no witness.
  if Interned<Type>.with<bool>(&provider, neverType) {
    call.vacuous = true
    return Result<MirCallTarget, PreparationFailure>.succeed(move call)
  }
  // A union provider's witness is the operation itself under `Self := U`, which dispatches on the
  // provider's tag (UNION-003); its own row reaches the same provider.
  let mut witness = ResolvedWitness {application: run Application.copy(&application), operands: List<OperandPass>.make()}
  if Interned<Type>.with<bool>(&provider, unionType) || Interned<Type>.with<bool>(&provider, Type.isErased) {
    witness.application = run unionServiceApplication(&application, &capability, &provider)
  } else {
    witness = match move run resolveWitnessApplication(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies.*, true,
      &capability, &provider, &operation, module, span) {
      Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
      Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Rejected {diagnostic: move error}) }
    }
  }
  // The witness mapping names the operation's own binders; the call supplies their arguments.
  // Lifetimes lent to the witness are erased at runtime; the caller's loans were already checked.
  let passes = List<OperandPass>.asSlice(&witness.operands)
  let mut lent = run Application.bindings(&application)
  let mut at = usize.ZERO
  while at < passes.length {
    if let OperandPass.Borrow {lifetimeOrdinal, ..} = &passes[at] {
      run List<Binding>.append(&mut lent, Binding {
        declaration: run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(&witness.application))),
        ordinal: lifetimeOrdinal, value: Argument.Lifetime {value: run Types.internLifetime(Lifetime.Static)},
      })
    }
    at = at + usize.ONE
  }
  let mut closed = run Application.applyBindings(&witness.application, List<Binding>.asSlice(&lent))
  // EFF-009 bounds the witness's failure by the operation's, so it may be narrower (even `never`).
  let signatureOwner = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(&closed)))
  let location = match move run locationOfIdentity(&mut resolver.*, &signatureOwner) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { fail InvalidModulePath {} }
  }
  let declarationAccess180Request = Key {family: Family.Signature,
    module: location.module, name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false}
  let declarationAccess180 = run internDeclaration(&mut resolver.*, declarationAccess180Request)
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, declarationAccess180, span)
  let facts = match move Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&signature, signatureFacts) {
    Option<SignatureFacts>.Some {value} => move value
    Option<SignatureFacts>.None => { return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Coverage {code: GapCode.SignatureForm}) }
  }
  // The operation's static arguments select the witness instance. Conformance matches static
  // parameters in order, so each value moves to the witness's static slot at the same position.
  let suppliedStatics = List<StaticSlot>.asSlice(&application.statics)
  if suppliedStatics.length > usize.ZERO {
    let witnessSlots = run signatureStaticSlots(&signature, facts.staticSlots)
    let slots = List<usize>.asSlice(&witnessSlots)
    if slots.length != suppliedStatics.length { return CompilerBug.panic(b"a witness's static parameters differ from its operation's") }
    let mut statics = run List<StaticSlot>.makeWithCapacity(slots.length)
    let mut staticAt = usize.ZERO
    while staticAt < slots.length {
      run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: slots[staticAt], value: StaticValue.copy(&suppliedStatics[staticAt].value)})
      staticAt = staticAt + usize.ONE
    }
    closed.statics = move statics
  }
  let witnessBindings = run Application.bindings(&closed)
  let declaredFailure = run RuntimeType.applyBindings(&facts.failure, List<Binding>.asSlice(&witnessBindings), projections)
  let servedSources = List<MirProviderSource>.asSlice(&served.sources)
  let receiver = MirProviderSource.copy(&servedSources[dispatch])
  let witnessRow = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies.*, &closed, own, bound, module, span) {
    Result<RowProviders, PreparationFailure>.Success {value} => move value
    Result<RowProviders, PreparationFailure>.Failure {error} => { return Result<MirCallTarget, PreparationFailure>.failResult(move error) }
  }
  call.application = run Application.copy(&closed)
  call.key = match move run InstanceKey.withProviders(move closed, move witnessRow.entries) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
      return Result<MirCallTarget, PreparationFailure>.failResult(PreparationFailure.Canonicalization {reason: reason})
    }
  }
  call.providers = move witnessRow.sources
  // An operation's own default body takes no receiver; its row reaches the same provider.
  if !DeclarationId.equals(Application.bodyDeclaration(&call.application), &operation) {
    call.dispatch = Option<MirProviderSource>.some(move receiver)
  }
  call.witnessFailure = Option<Interned<Type>>.some(move declaredFailure)
  call.edge = Edge.Witness
  if DeclarationId.isAmbientOperation(&operation) && !Interned<Type>.with<bool>(&provider, Type.isErased) {
    let enclosingService = run DeclarationId.enclosing(&operation, DeclarationId.ownerCount(&operation) - usize.ONE)
    let declaring = ModuleId.copy(DeclarationId.moduleId(&enclosingService))
    let id = run Types.internDeclaration(move enclosingService)
    let location = match move run locationOfIdentity(&mut resolver.*, &id) {
      Option<InstanceLocation>.Some {value} => value
      _ => { fail RevisionMismatch {} }
    }
    let header = match move run scopedHeader(&mut resolver.*, &declaring, location.declaration) {
      Option<HeaderSyntax>.Some {value} => move value
      _ => { fail RevisionMismatch {} }
    }
    call.promise = CallPromise.Ambient {module: move declaring, span: header.span}
  } else if run operationNonParking(&mut resolver.*, &operation) {
    call.promise = CallPromise.NonParking
  }
  return Result<MirCallTarget, PreparationFailure>.succeed(move call)
}

// Whether a service operation is written `@nonParking`: each call then owes
// the NonParking proof for the witness its provider selects (SEM0139).
pub effect fn operationNonParking(resolver: &mut Resolver, operation: &DeclarationId) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let identity = run Types.internDeclaration(DeclarationId.copy(operation))
  let location = match move run locationOfIdentity(&mut resolver.*, &identity) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return false }
  }
  let module = resolvedModule(&resolver.*, location.module)
  let answer = run observedDeclaration(&mut resolver.*, &module, location.declaration, SourceFacet.Directives)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, &module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if location.declaration >= declarations.length { return false }
    let hir = IndexedSource.authored(value)
    if let Node.OperationHeader {..} = Module.node(hir, declarations[location.declaration].header) {
      let directives = Directives.of(hir, declarations[location.declaration].local)
      if let Option<HirId>.Some {..} = move Directives.find(hir, directives, DirectiveKind.NonParking) { return true }
    }
  }
  return false
}

fn providerEntryCount(values: &List<ProviderEntry>) -> usize { return List<ProviderEntry>.length(values) }

// This instance's own providers, copied out of its key in canonical key order.
effect fn instanceProviders(instance: &InstanceKey) -> List<ProviderEntry> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = List<ProviderEntry>.make()
  if let Option<Arc<List<ProviderEntry>>>.Some {value: listed} = move InstanceKey.providers(instance) {
    let entries = List<ProviderEntry>.asSlice(Arc<List<ProviderEntry>>.get(&listed))
    let mut at = usize.ZERO
    while at < entries.length {
      run List<ProviderEntry>.append(&mut copied, ProviderEntry.copy(&entries[at]))
      at = at + usize.ONE
    }
  }
  return move copied
}

// The address type of each own provider, as the hidden parameter's local type.
effect fn providerAddresses(own: &[ProviderEntry]) -> List<Interned<Type>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut addresses = run List<Interned<Type>>.makeWithCapacity(own.length)
  let mut at = usize.ZERO
  while at < own.length {
    run List<Interned<Type>>.append(&mut addresses, run Types.intern(Type.Reference {referent: Interned<Type>.clone(&own[at].provider),
      access: own[at].key.access, lifetime: run Types.internLifetime(Lifetime.Static)}))
    at = at + usize.ONE
  }
  return move addresses
}

pub fn callableResult(value: &Type) -> Option<Interned<Type>> {
  return match &value.* { Type.Callable {result, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&result)) _ => Option<Interned<Type>>.none() }
}

// Builds the C ABI shim of one exported definition after classifying every lane. A lane outside
// the immediate scalar and pointer subset keeps its named C ABI gap.
effect fn exportShim(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: List<Dependency>,
  identity: &Interned<DeclarationId>,
  key: Key,
  symbol: &Arc<Bytes>,
  written: ForeignHeader,
  observing: bool,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut evidence = move dependencies
  let declarationAccess181 = declarationPosition(&resolver.*, key)
  let location = InstanceLocation {module: key.module, declaration: declarationAccess181}
  let classified = run Effect.result(cSignature(&mut resolver.*, &mut owner.*, &mut evidence, identity, location, move written, &Option<ForeignSite>.none()))
  let signature = match move classified {
    Result<CAbi.Signature, ForeignRefusal | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => move value
    Result<CAbi.Signature, ForeignRefusal | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      // `checkForeignClaims` reports the same refusal; the shim answers it.
      ForeignRefusal {diagnostic} => { return run mirRejection(identity, move diagnostic, move evidence) }
      Cycle {} => { fail Cycle {} }
      InvalidModulePath {} => { fail InvalidModulePath {} }
      RevisionMismatch {} => { fail RevisionMismatch {} }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
  let lanes = List<CAbi.Lane>.asSlice(&signature.parameters)
  let mut parameters = run List<Interned<Type>>.makeWithCapacity(lanes.length)
  let mut at = usize.ZERO
  while at < lanes.length {
    run List<Interned<Type>>.append(&mut parameters, Interned<Type>.clone(&lanes[at].ty))
    at = at + usize.ONE
  }
  let mut shim = run MirFunction.cExport(identity, symbol, List<Interned<Type>>.asSlice(&parameters), &signature.result.ty, observing)
  // A variadic export's entry starts the `va_list` and passes its address to the body.
  shim.variadic = signature.variadic
  return run storeMir(&mut resolver.*, &mut owner.*, move shim, move evidence, false)
}

// Whether `instance` runs an interface operation itself under a structural union `Self`: the
// witness a union provider selects (UNION-003).
pub enum OperationDispatch { Direct, Union, Erased }

pub fn operationDispatch(instance: &InstanceKey) -> OperationDispatch {
  if let InstanceKey.Function {application, ..} = &instance.* {
    return Interned<Application>.with<OperationDispatch>(&application, |value: &Application| -> OperationDispatch {
      if let SpecializationTarget.Operation {provider, operation, implementation, ..} = &value.target {
        if DeclarationId.equals(&operation, &implementation) {
          return Interned<Type>.with<OperationDispatch>(&provider, |ty: &Type| -> OperationDispatch {
            return match &ty.* {
              Type.Union {..} => OperationDispatch.Union
              Type.Erased {..} => OperationDispatch.Erased
              _ => OperationDispatch.Direct
            }
          })
        }
      }
      return OperationDispatch.Direct
    })
  }
  return OperationDispatch.Direct
}

// The dispatch body of a union operation instance: one arm per member calls that member's witness.
struct DispatchTarget {
  contract: Interned<Type>,
  provider: Interned<Type>,
}

// A provisional answer lives only within one closure pass. Calls that keep the same operation,
// providers and member set share this answer. Only final dispatcher MIR enters ordinary queries.
pub struct DiscoveryDispatch {
  pub instance: InstanceKey,
  pub call: RelatedSite,
  pub contract: usize,
  pub count: usize,
  pub mir: Shared<Result<Answer, NoRejection>>,
}

pub struct CheckedDispatch {
  pub instance: InstanceKey,
  pub checkSet: usize,
}

// A witness with a known call graph that cannot observe or capture the table needs no
// temporary default. Read its raw MIR as a dependency so editing a helper revises this proof.
effect fn ambientWitnessNeedsMask(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  arms: &[DispatchArm], observing: bool) -> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut reached = InstanceTable.make()
  let mut at = usize.ZERO
  while at < arms.length {
    run reached.note(&arms[at].callee)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<InstanceKey>.length(&reached.keys) {
    if List<InstanceKey>.length(&reached.keys) > quietReach() { return true }
    let key = InstanceKey.copy(&List<InstanceKey>.asSlice(&reached.keys)[at])
    if operationDispatch(&key) != OperationDispatch.Direct { return true }
    let location = match move run locationOfInstance(&mut resolver.*, &key) {
      Option<InstanceLocation>.Some {value} => value
      Option<InstanceLocation>.None => { return true }
    }
    let variant = run exactBackendVariant(&mut resolver.*, &key, observing, &Option<CoroutineFacts>.none(), true)
    let request = run internDeclaration(&mut resolver.*, Key {family: Family.Mir, module: location.module,
      declaration: location.declaration, member: instanceMember(&key), name: variant, external: false})
    let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, request, Span.make(usize.ZERO, usize.ZERO))
    let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return true }
    }
    let function = &List<MirFunction>.asSlice(&resolver.mirValues)[index]
    if function.observes || function.releasesPackages { return true }
    if observing && (function.traps.length() != usize.ZERO || function.contexts.length() != usize.ZERO) { return true }
    let blocks = List<MirBlock>.asSlice(&function.blocks)
    let mut block = usize.ZERO
    while block < blocks.length {
      let statements = List<MirStatement>.asSlice(&blocks[block].statements)
      let mut i = usize.ZERO
      while i < statements.length {
        match &statements[i] {
          MirStatement.Assign {value: MirRvalue.AmbientSlot, ..} => { return true }
          MirStatement.Assign {value: MirRvalue.Assembly {..}, ..} => { return true }
          MirStatement.Drop {glue, ..} => { run reached.note(&glue) }
          _ => {}
        }
        i = i + usize.ONE
      }
      if observing {
        match &blocks[block].terminator {
          MirTerminator.Trap {..} => { return true }
          MirTerminator.TrapText {..} => { return true }
          MirTerminator.Fail {..} => { return true }
          _ => {}
        }
      }
      if let MirTerminator.Call {call} = &blocks[block].terminator {
  let MirCallTerminator {callee, ..} = &call.get().*

        match &callee {
          MirCallee.Instance {key: target} => { run reached.note(&target) }
          _ => { return true }
        }
      }
      block = block + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

// The closure and the ordinary escape walk have independent dependencies. A root whose
// proof remains current can recheck its escapes under its original frozen member sets.
pub struct CheckScope {
  pub unit: usize,
  pub index: ErasureIndex,
  pub dispatchers: List<CheckedDispatch>,
}

pub fn currentErasures<'a>(resolver: &'a Resolver) -> &'a ErasureIndex {
  if resolver.activeCheckScope == usize.MAX { return &resolver.erasures }
  return &List<CheckScope>.asSlice(&resolver.checkScopes)[resolver.activeCheckScope].index
}

pub fn checkScopeOf(resolver: &Resolver, unit: usize) -> usize {
  let saved = List<CheckScope>.asSlice(&resolver.checkScopes)
  let mut at = usize.ZERO
  while at < saved.length {
    if saved[at].unit == unit { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

pub effect fn retainCheckScope(resolver: &mut Resolver, unit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let selected = checkScopeOf(&resolver.*, unit)
  let scope = CheckScope {unit: unit, index: Intrinsic.replace(resolver.erasures, ErasureIndex.make()),
    dispatchers: Intrinsic.replace(resolver.checkedDispatchers, List<CheckedDispatch>.make())}
  if selected == usize.MAX {
    resolver.activeCheckScope = List<CheckScope>.length(&resolver.checkScopes)
    run List<CheckScope>.append(&mut resolver.checkScopes, move scope)
  } else {
    List<CheckScope>.set(&mut resolver.checkScopes, selected, move scope)
    resolver.activeCheckScope = selected
  }
  return ()
}

// Declaration roots can legitimately close one contract over different concrete members.
// Retain one MIR variant per exact set, including the provenance of its admissions. Switching
// declarations then preserves the results and dependency edges of the other roots.
fn sameCheckMembers(left: &[ErasureFact], right: &[ErasureFact]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    let a = &left[at]
    let b = &right[at]
    if !Interned<Type>.same(&a.source, &b.source) || !Interned<Type>.same(&a.target, &b.target)
      || !Interned<DeclarationId>.same(&a.owner, &b.owner) || a.origin.node != b.origin.node
      || a.origin.location.start != b.origin.location.start || a.origin.location.end != b.origin.location.end { return false }
    at = at + usize.ONE
  }
  return true
}

pub effect fn internCheckMembers(sets: &mut List<List<ErasureFact>>, facts: &[ErasureFact]) -> usize ! OutOfMemoryError ? &mut Allocator {
  let listed = List<List<ErasureFact>>.asSlice(&sets.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if sameCheckMembers(List<ErasureFact>.asSlice(&listed[at]), facts) { return at }
    at = at + usize.ONE
  }
  let mut kept = List<ErasureFact>.make()
  run ErasureFact.appendTo(facts, &mut kept)
  run List<List<ErasureFact>>.append(&mut sets.*, move kept)
  return at
}

pub effect fn checkedSetFor(resolver: &Resolver, instance: &InstanceKey) -> usize ! OutOfMemoryError ? &mut Allocator {
  if !resolver.checkingMembers || operationDispatch(instance) != OperationDispatch.Erased { return usize.MAX }
  let sites = if resolver.activeCheckScope == usize.MAX { List<CheckedDispatch>.asSlice(&resolver.checkedDispatchers) }
    else { List<CheckedDispatch>.asSlice(&List<CheckScope>.asSlice(&resolver.checkScopes)[resolver.activeCheckScope].dispatchers) }
  let mut at = usize.ZERO
  while at < sites.length {
    if run InstanceKey.sameInstance(instance, &sites[at].instance) { return sites[at].checkSet }
    at = at + usize.ONE
  }
  return usize.MAX
}

effect fn dispatchMembers(resolver: &Resolver, key: Key, provider: &Interned<Type>) -> List<ErasureFact>
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let set = List<BackendInstance>.asSlice(&resolver.backendInstances)[key.name].checkSet
  if set == usize.MAX { return run ErasureIndex.members(currentErasures(resolver), provider) }
  let mut facts = List<ErasureFact>.make()
  run ErasureFact.appendTo(List<ErasureFact>.asSlice(&List<List<ErasureFact>>.asSlice(&resolver.checkMemberSets)[set]), &mut facts)
  return move facts
}

pub effect fn discoveryDispatcher(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key, instance: &InstanceKey, caller: &ModuleId, span: Span, positionOut: &mut usize)
  -> Shared<Result<Answer, NoRejection>> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run List<InstanceKey>.append(&mut resolver.erasureRound.dispatchers, InstanceKey.copy(instance))
  let application = run InstanceKey.selected(instance)
  let position = match &application.target {
    SpecializationTarget.Operation {provider, ..} => run ErasureIndex.position(&mut resolver.erasures, &provider)
    _ => { fail RevisionMismatch {} }
  }
  let count = ErasureIndex.countAt(&resolver.erasures, position)
  let dispatchers = List<DiscoveryDispatch>.asSlice(&resolver.erasureDispatchers)
  let mut at = usize.ZERO
  while at < dispatchers.length {
    if run InstanceKey.sameInstance(instance, &dispatchers[at].instance) {
      positionOut.* = at
      if dispatchers[at].count == count { return Shared<Result<Answer, NoRejection>>.clone(&dispatchers[at].mir) }
      break
    }
    at = at + usize.ONE
  }
  positionOut.* = at
  let identity = InstanceKey.identity(instance)
  let answer = run resolveUnionDispatchMir(&mut resolver.*, &mut owner.*, key, InstanceKey.copy(instance), &identity, false)
  let mir = run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(move answer))
  let result = DiscoveryDispatch {instance: InstanceKey.copy(instance), call: RelatedSite {module: ModuleId.copy(caller), span: span}, contract: position, count: count,
    mir: Shared<Result<Answer, NoRejection>>.clone(&mir)}
  if at == List<DiscoveryDispatch>.length(&resolver.erasureDispatchers) { run List<DiscoveryDispatch>.append(&mut resolver.erasureDispatchers, move result) }
  else { List<DiscoveryDispatch>.set(&mut resolver.erasureDispatchers, at, move result) }
  return move mir
}

// Where an ordinary walk reached a dispatcher. Its witnesses enter under that exact
// specialization path, even when another root supplies their conversion in a later wave.
pub struct DiscoverySite {
  pub dispatcher: usize,
  pub admission: Admission,
  pub span: Span,
  pub module: ModuleId,
  pub requester: Option<RelatedSite>,
  pub origin: VisitOrigin,
  pub body: usize,
  pub summary: usize,
}

pub fn copyRequestSite(source: &Option<RelatedSite>) -> Option<RelatedSite> {
  if let Option<RelatedSite>.Some {value} = &source.* {
    return Option<RelatedSite>.some(RelatedSite {module: ModuleId.copy(&value.module), span: value.span})
  }
  return Option<RelatedSite>.none()
}

pub effect fn changedDispatchers(resolver: &mut Resolver, sites: &[DiscoverySite], pending: &mut List<usize>)
  -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<ErasureFact>.length(&resolver.erasureRound.facts) == usize.ZERO { return () }
  run ErasureRound.mergeFacts(&resolver.erasureRound, &mut resolver.erasures)
  resolver.erasureRound.facts = List<ErasureFact>.make()
  let dispatchers = List<DiscoveryDispatch>.asSlice(&resolver.erasureDispatchers)
  let mut at = sites.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let old = &dispatchers[sites[at].dispatcher]
    if ErasureIndex.countAt(&resolver.erasures, old.contract) != old.count {
      run List<usize>.append(&mut pending.*, at)
    }
  }
}

effect fn dispatchGap(code: GapCode, identity: &Interned<DeclarationId>) -> Value ! OutOfMemoryError ? &mut Allocator {
  return Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(code, identity, Span.make(usize.ZERO, usize.ZERO)))}
}

effect fn resolveUnionDispatchMir(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key,
  instance: InstanceKey, identity: &Interned<DeclarationId>, observing: bool) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let application = run InstanceKey.selected(&instance)
  let target = match &application.target {
    SpecializationTarget.Operation {contract, provider, ..} => DispatchTarget {contract: Interned<Type>.clone(&contract),
      provider: Interned<Type>.clone(&provider)}
    _ => { return memberSuccess(run dispatchGap(GapCode.WitnessOperand, identity), move dependencies) }
  }
  let contract = move target.contract
  let provider = move target.provider
  let operation = DeclarationId.copy(Application.bodyDeclaration(&application))
  let module = ModuleId.copy(DeclarationId.moduleId(&operation))
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {family: Family.Signature,
    module: key.module, name: usize.ZERO, declaration: key.declaration, member: usize.ZERO, external: false}, span)
  if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature, answerCause) {
    return run memberRejected(move value, move dependencies)
  }
  let bindings = run Application.bindings(&application)
  let noProjections = List<RuntimeProjection>.make()
  let projections = List<RuntimeProjection>.asSlice(&noProjections)
  let mut parameters = List<Interned<Type>>.make()
  let statics = List<StaticSlot>.asSlice(&application.statics)
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    if staticSlotAt(statics, at) != usize.MAX { at = at + usize.ONE continue }
    let written = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameterAt(answer, at) })
    match move written {
      Option<Interned<Type>>.Some {value} => {
        run List<Interned<Type>>.append(&mut parameters, run RuntimeType.applyBindings(&value, List<Binding>.asSlice(&bindings), projections))
      }
      Option<Interned<Type>>.None => { return memberSuccess(run dispatchGap(GapCode.SignatureForm, identity), move dependencies) }
    }
    at = at + usize.ONE
  }
  let writtenResult = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&signature, signatureResult) {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => { return memberSuccess(run dispatchGap(GapCode.SignatureForm, identity), move dependencies) }
  }
  let result = run RuntimeType.applyBindings(&writtenResult, List<Binding>.asSlice(&bindings), projections)
  let writtenFailure = run signatureFailure(&signature)
  let failure = run Type.applyBindings(&writtenFailure, List<Binding>.asSlice(&bindings), true)
  let fails = !Interned<Type>.with<bool>(&failure, neverType)
  let mut own = run instanceProviders(&instance)
  // A dispatcher requested by an executable-property proof can precede a prepared caller.
  // Its ambient receiver type and shared requirement are already fixed by the operation.
  if List<ProviderEntry>.length(&own) == usize.ZERO && DeclarationId.isAmbientOperation(&operation) {
    let declared = run signatureRequirements(&signature)
    let requirements = run canonicalEntries(&declared, &operation)
    let entries = List<Requirement>.asSlice(&requirements)
    if entries.length == usize.ONE {
      run List<ProviderEntry>.append(&mut own, ProviderEntry {key: Requirement.copy(&entries[0]), provider: Interned<Type>.clone(&provider)})
    }
  }
  let addresses = run providerAddresses(List<ProviderEntry>.asSlice(&own))
  // A service operation receives the union from its own provider and passes every parameter on;
  // any other operation receives it through its first parameter (UNION-003).
  let mut receiver = Option<usize>.none()
  let mut first = usize.ONE
  if run ambientDispatch(&signature, &contract) {
    let entries = List<ProviderEntry>.asSlice(&own)
    let mut entry = usize.ZERO
    while entry < entries.length {
      if run Type.equalsShared(&entries[entry].key.capability, &contract) { receiver = Option<usize>.some(entry) }
      entry = entry + usize.ONE
    }
    if let Option<usize>.None = &receiver { fail RevisionMismatch {} }
    first = usize.ZERO
  }
  // Tags number the canonical physical members.
  let observation = DeclarationId.isAmbientOperation(&operation)
  let promised = observation || run operationNonParking(&mut resolver.*, &operation)
  let erased = Interned<Type>.with<bool>(&provider, Type.isErased)
  let checkCycles = erased && !observation && !resolver.closedErasures && List<BackendInstance>.asSlice(&resolver.backendInstances)[key.name].checkSet == usize.MAX && Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsEffect)
  let mut conversions = List<ErasureFact>.make()
  let members = if erased {
    let facts = run dispatchMembers(&resolver.*, key, &provider)
    let mut types = List<Interned<Type>>.make()
    let mut encodings = List<Bytes>.make()
    let sites = List<ErasureFact>.asSlice(&facts)
    let mut site = usize.ZERO
    while site < sites.length {
      run List<Bytes>.append(&mut encodings, run Type.runtimeEncoding(&sites[site].source, &operation))
      site = site + usize.ONE
    }
    let order = run RuntimeEncoding.order(&encodings)
    let positions = List<usize>.asSlice(&order)
    site = usize.ZERO
    while site < positions.length {
      run List<Interned<Type>>.append(&mut types, Interned<Type>.clone(&sites[positions[site]].source))
      if promised || checkCycles { run List<ErasureFact>.append(&mut conversions, ErasureFact.copy(&sites[positions[site]])) }
      site = site + usize.ONE
    }
    move types
  } else {
    match move run Type.canonicalUnionMembers(&provider) {
      Option<List<Interned<Type>>>.Some {value} => move value
      Option<List<Interned<Type>>>.None => { return memberSuccess(run dispatchGap(GapCode.WitnessOperand, identity), move dependencies) }
    }
  }
  let listed = List<Interned<Type>>.asSlice(&members)
  let mut arms = List<DispatchArm>.make()
  let mut request = Request.make()
  at = usize.ZERO
  while at < listed.length {
    let selected = run resolveWitnessApplication(&mut resolver.*, &mut owner.*, &mut request, &mut dependencies, true,
      &contract, &listed[at], &operation, &module, span)
    let witness = match move selected {
      Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
      Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return run mirRejection(identity, move error, move dependencies) }
    }
    // A by-value operand the member's witness borrows is lent for the call; the lent lifetime is
    // erased at runtime, as at an ordinary witness call.
    // The witness's first operand is the receiver; each later one is the operation operand at
    // `first + pass - 1`.
    let passes = List<OperandPass>.asSlice(&witness.operands)
    let operands = List<Interned<Type>>.asSlice(&parameters)
    if passes.length + first != count + usize.ONE { fail RevisionMismatch {} }
    let mut lent = run Application.bindings(&application)
    let mut borrows = List<DispatchBorrow>.make()
    let mut parameter = first
    let mut pass = usize.ZERO
    while pass < passes.length {
      if let OperandPass.Borrow {lifetimeOrdinal, ..} = &passes[pass] {
        run List<Binding>.append(&mut lent, Binding {
          declaration: run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(&witness.application))),
          ordinal: lifetimeOrdinal, value: Argument.Lifetime {value: run Types.internLifetime(Lifetime.Static)},
        })
      }
      if pass == usize.ZERO {
        pass = usize.ONE
        continue
      }
      if staticSlotAt(statics, first + pass - usize.ONE) != usize.MAX {
        pass = pass + usize.ONE
        continue
      }
      if let OperandPass.Borrow {access, ..} = &passes[pass] {
        let needed = match move run glueNeeds(&mut resolver.*, &mut owner.*, &mut dependencies, &operands[parameter]) {
          Result<bool, PreparationFailure>.Success {value} => value
          Result<bool, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(identity, move error, move dependencies) }
        }
        let mut glue = Option<InstanceKey>.none()
        if needed {
          match move run glueChild(parameter, &operands[parameter], &operation) {
            Result<Option<GlueChild>, PreparationFailure>.Success {value: Option<GlueChild>.Some {value: child}} => { glue = Option<InstanceKey>.some(move child.glue) }
            Result<Option<GlueChild>, PreparationFailure>.Success {..} => { return memberSuccess(run dispatchGap(GapCode.Cleanup, identity), move dependencies) }
            Result<Option<GlueChild>, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(identity, move error, move dependencies) }
          }
        }
        run List<DispatchBorrow>.append(&mut borrows, DispatchBorrow {parameter: parameter, access: access, glue: move glue})
      }
      parameter = parameter + usize.ONE
      pass = pass + usize.ONE
    }
    let mut closed = run Application.applyBindings(&witness.application, List<Binding>.asSlice(&lent))
    // Each witness takes its receiver first. A service dispatcher receives it through its row.
    let mut slot = usize.ZERO
    while slot < statics.length {
      run List<StaticSlot>.append(&mut closed.statics, StaticSlot {ordinal: statics[slot].ordinal + usize.ONE - first,
        value: StaticValue.copy(&statics[slot].value)})
      slot = slot + usize.ONE
    }
    let unbound = List<BoundProvider>.make()
    let served = match move run rowProviders(&mut resolver.*, &mut owner.*, &mut dependencies, &closed,
      List<ProviderEntry>.asSlice(&own), List<BoundProvider>.asSlice(&unbound), &module, span) {
      Result<RowProviders, PreparationFailure>.Success {value} => move value
      Result<RowProviders, PreparationFailure>.Failure {error} => { return run preparationQueryAnswer(identity, move error, move dependencies) }
    }
    let mut sources = List<usize>.make()
    let given = List<MirProviderSource>.asSlice(&served.sources)
    let mut source = usize.ZERO
    while source < given.length {
      match &given[source] {
        MirProviderSource.Own {index} => { run List<usize>.append(&mut sources, index) }
        _ => { return memberSuccess(run dispatchGap(GapCode.EffectForm, identity), move dependencies) }
      }
      source = source + usize.ONE
    }
    let mut calleeKey = Result<InstanceKey, CanonicalizationFailure>.failResult(CanonicalizationFailure.Resource)
    if List<ProviderEntry>.length(&served.entries) != usize.ZERO {
      calleeKey = run InstanceKey.withProviders(move closed, move served.entries)
    } else {
      calleeKey = run InstanceKey.function(move closed)
    }
    let callee = match move calleeKey {
      Result<InstanceKey, CanonicalizationFailure>.Success {value} => move value
      Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
        if erased && reason == CanonicalizationFailure.Resource {
          // A witness can convert a larger instantiation of its own receiver in each round.
          // Identify the conversion that exhausted the existing specialization budget.
          let facts = run dispatchMembers(&resolver.*, key, &provider)
          let sites = List<ErasureFact>.asSlice(&facts)
          let mut site = usize.ZERO
          while site < sites.length {
            if run Type.runtimeEqualsShared(&sites[site].source, &listed[at]) {
              let from = DeclarationId.copyShared(&sites[site].owner)
              let anchor = run declarationAnchor(&mut resolver.*, &from)
              let mut report = run makeRejection(RejectionCode.ErasedMemberLimit, DeclarationId.moduleId(&from), anchoredSpan(&anchor, sites[site].origin))
              run List<MessageArgument>.append(&mut report.arguments, MessageArgument {name: run Bytes.copy(b"operation"), value: run shownName(&mut resolver.*, &operation)})
              return run memberRejected(run Shared<Rejection>.make(move report), move dependencies)
            }
            site = site + usize.ONE
          }
        }
        return run preparationQueryAnswer(identity, PreparationFailure.Canonicalization {reason: reason}, move dependencies)
      }
    }
    // The member witness fails with this operation's own failure, or with a narrower one the
    // dispatcher widens.
    let calleeFailure = match move run witnessFailureType(&mut resolver.*, &mut owner.*, &mut dependencies, &callee, span) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return memberSuccess(run dispatchGap(GapCode.SignatureForm, identity), move dependencies) }
    }
    let memberFails = !Interned<Type>.with<bool>(&calleeFailure, neverType)
    let mut narrower = Option<Interned<Type>>.none()
    if memberFails && !sameReusableType(&calleeFailure, &failure) {
      let placed = run UnionProjection.within(&failure, &calleeFailure)
      if placed.isNone() {
        return memberSuccess(run dispatchGap(GapCode.WitnessOperand, identity), move dependencies)
      }
      narrower = Option<Interned<Type>>.some(move calleeFailure)
    }
    run List<DispatchArm>.append(&mut arms, DispatchArm {tag: at, member: Interned<Type>.clone(&listed[at]), callee: move callee,
      providers: move sources, fails: memberFails, failure: move narrower, borrows: move borrows})
    at = at + usize.ONE
  }
  let mut obligations = List<MirNonParkingRun>.make()
  if checkCycles && listed.length > usize.ZERO {
    let mut witnesses = List<ErasedRecursion.Witness>.make()
    let lowered = List<DispatchArm>.asSlice(&arms)
    let sites = List<ErasureFact>.asSlice(&conversions)
    let mut each = usize.ZERO
    while each < lowered.length {
      run List<ErasedRecursion.Witness>.append(&mut witnesses, ErasedRecursion.Witness {key: InstanceKey.copy(&lowered[each].callee), site: ErasureFact.copy(&sites[each])})
      each = each + usize.ONE
    }
    let prior = List<ErasedRecursion.Operation>.asSlice(&resolver.effectDispatchers)
    each = usize.ZERO
    while each < prior.length && !run InstanceKey.sameInstance(&prior[each].key, &instance) { each = each + usize.ONE }
    let candidate = ErasedRecursion.Operation {key: InstanceKey.copy(&instance), witnesses: move witnesses}
    if each == prior.length { run List<ErasedRecursion.Operation>.append(&mut resolver.effectDispatchers, move candidate) }
    else { List<ErasedRecursion.Operation>.set(&mut resolver.effectDispatchers, each, move candidate) }
  }
  if erased && promised {
    let witnesses = List<DispatchArm>.asSlice(&arms)
    let sites = List<ErasureFact>.asSlice(&conversions)
    let mut introductions = List<ErasureFact>.make()
    if observation {
      let reporting = run Types.intern(Type.Erased {contracts: Interned<Type>.clone(&contract), transferable: true, concurrent: false})
      let unit = recordingUnit(&resolver.*)
      run recordErasedMembers(&mut resolver.*, &reporting, &operation, unit)
      introductions = run ErasureIndex.members(currentErasures(&resolver.*), &reporting)
    }
    let mut each = usize.ZERO
    while each < witnesses.length {
      let mut callees = List<InstanceKey>.make()
      run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&witnesses[each].callee))
      let borrows = List<DispatchBorrow>.asSlice(&witnesses[each].borrows)
      let mut loan = usize.ZERO
      while loan < borrows.length {
        if let Option<InstanceKey>.Some {value: glue} = &borrows[loan].glue {
          run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&glue))
        }
        loan = loan + usize.ONE
      }
      let origin = if observation {
        let candidates = List<ErasureFact>.asSlice(&introductions)
        let mut candidate = usize.ZERO
        while candidate < candidates.length && !run Type.runtimeEqualsShared(&candidates[candidate].source, &sites[each].source) { candidate = candidate + usize.ONE }
        let selected = if candidate < candidates.length { &candidates[candidate] } else { &sites[each] }
        let witnessSite = DeclarationId.copyShared(&selected.owner)
        let siteAnchor = run declarationAnchor(&mut resolver.*, &witnessSite)
        ParkOrigin.Ambient {module: ModuleId.copy(DeclarationId.moduleId(&witnessSite)), span: anchoredSpan(&siteAnchor, selected.origin)}
      } else { ParkOrigin.Conversion {fact: ErasureFact.copy(&sites[each])} }
      run List<MirNonParkingRun>.append(&mut obligations, MirNonParkingRun {callees: move callees, glues: List<Interned<Type>>.make(),
        declarations: List<Interned<DeclarationId>>.make(), exact: true, origin: move origin})
      each = each + usize.ONE
    }
  }
  let mut ambientIndex = usize.MAX
  let mut ambientExtent = usize.ZERO
  if observation {
    let registration = run Types.intern(Type.Erased {contracts: Interned<Type>.clone(&contract), transferable: true, concurrent: true})
    let unit = recordingUnit(&resolver.*)
    run recordErasedMembers(&mut resolver.*, &registration, &operation, unit)
    let members = run ErasureIndex.members(currentErasures(&resolver.*), &registration)
    if List<ErasureFact>.length(&members) > usize.ZERO {
      run observeAmbientServices(&mut resolver.*, DeclarationId.moduleId(&operation))
      let services = ErasureIndex.ambientServices(currentErasures(&resolver.*))
      ambientExtent = services.length
      let tag = run InstanceKey.memberTag(&contract, &operation)
      let mut index = usize.ZERO
      while index < services.length && services[index] != tag { index = index + usize.ONE }
      if index < services.length { ambientIndex = index }
    }
  }
  let maskAmbient = ambientIndex < ambientExtent && run ambientWitnessNeedsMask(&mut resolver.*, &mut owner.*, &mut dependencies,
    List<DispatchArm>.asSlice(&arms), observing)
  let mut function = run UnionDispatch.lower(UnionDispatch {key: move instance, result: move result, parameters: move parameters,
    receiver: move receiver, ambientIndex: ambientIndex, ambientExtent: ambientExtent, maskAmbient: maskAmbient,
    providers: move addresses, failure: move failure, fails: fails, count: listed.length, arms: move arms}, observing)
  function.nonParking = move obligations
  if promised && !erased {
    let mut callees = List<InstanceKey>.make()
    run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&function.key))
    run List<MirNonParkingRun>.append(&mut function.nonParking, MirNonParkingRun {callees: move callees,
      glues: List<Interned<Type>>.make(), declarations: List<Interned<DeclarationId>>.make(), exact: true,
      origin: ParkOrigin.Entry})
  }
  return run storeMir(&mut resolver.*, &mut owner.*, move function, move dependencies, false)
}

// The declared failure of the instance `callee` runs, under its application.
effect fn witnessFailureType(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  callee: &InstanceKey, span: Span) -> Option<Interned<Type>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let application = run InstanceKey.selected(callee)
  let location = match move run locationOfInstance(&mut resolver.*, callee) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option<Interned<Type>>.none() }
  }
  let signatureKey = run internDeclaration(&mut resolver.*, Key {family: Family.Signature, module: location.module,
    name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false})
  let signature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, signatureKey, span)
  if Shared<Result<Answer, NoRejection>>.with<bool>(&signature, hasRejection) { return Option<Interned<Type>>.none() }
  let declared = run signatureFailure(&signature)
  let bindings = run Application.bindings(&application)
  return Option<Interned<Type>>.some(run Type.applyBindings(&declared, List<Binding>.asSlice(&bindings), true))
}

struct InlineExpansion {
  key: InstanceKey,
  parent: usize,
}

// Whether a callee's un-inlined MIR, read for inlining, is quiet: it is inlinable and no instance
// its calls reach, through any number of calls, suspends or parks. Only such a body may be
// inlined at a call that is not a suspension point. A caller that suspends is lowered twice, as
// an ordinary function and as a frame, and both must make the same calls suspension points: the
// frame lowers a callee with the frame's facts, under which a call of a suspending instance has
// a cancel exit and its body is no longer inlinable, while the ordinary function would have
// spliced it. Nothing a quiet body reaches suspends, so its MIR is the same under any facts and
// both make the same decision. The calls a quiet body makes stay calls in the caller.
struct InlineVerdicts {
  instances: InstanceTable,
  quiet: List<bool>,
  // Each body's inlining directive (`MirInline.directive`).
  directives: List<usize>,
}

// Instances, each found by its `InstanceKey.runtimeHash` at the position it was added, so a
// function with thousands of calls looks one up without walking the rest.
struct InstanceTable {
  lookup: InternIndex,
  keys: List<InstanceKey>,
}

impl InstanceTable {
  fn make() -> InstanceTable { return InstanceTable {lookup: InternIndex.make(), keys: List<InstanceKey>.make()} }

  // The position of `key`, whose hash is `hash`, or `usize.MAX`.
  effect fn find(self: &Self, hash: u64, key: &InstanceKey) -> usize ! OutOfMemoryError ? &mut Allocator {
    let mut at = InternIndex.first(&self.lookup, hash)
    while at != usize.MAX {
      if run InstanceKey.sameInstance(&List<InstanceKey>.asSlice(&self.keys)[at], key) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  // Adds `key`, whose hash is `hash` and which must not be there yet; answers its position.
  effect fn add(self: &mut Self, hash: u64, key: &InstanceKey) -> usize ! OutOfMemoryError ? &mut Allocator {
    let position = List<InstanceKey>.length(&self.keys)
    run List<InstanceKey>.append(&mut self.keys, InstanceKey.copy(key))
    run InternIndex.record(&mut self.lookup, hash)
    return position
  }

  // Adds `key` unless it is there.
  effect fn note(self: &mut Self, key: &InstanceKey) -> () ! OutOfMemoryError ? &mut Allocator {
    let hash = InstanceKey.runtimeHash(key)
    if (run self.find(hash, key)) == usize.MAX { drop run self.add(hash, key) }
    return ()
  }
}

// The most instances a quiet body's calls may reach before it counts as not quiet: each one is
// a summary the caller reads and depends on.
fn quietReach() -> usize { return 256 }

// The directive of the quiet callee `selected`, whose verdict `verdicts` holds.
effect fn verdictDirective(verdicts: &InlineVerdicts, selected: &InstanceKey) -> usize ! OutOfMemoryError ? &mut Allocator {
  let at = run verdicts.instances.find(InstanceKey.runtimeHash(selected), selected)
  if at == usize.MAX { return usize.ZERO }
  return List<usize>.get(&verdicts.directives, at)
}

// The expanded sizes worked out so far in one function's inlining, by instance, with each
// instance's directive.
struct Expansions {
  instances: InstanceTable,
  sizes: List<usize>,
  directives: List<usize>,
}

// An instance's expanded size and directive; the size is `usize.MAX` for one that is not
// inlinable.
struct Expansion {
  size: usize,
  directive: usize,
}

impl Copy for Expansion {}

// The expanded size of `selected`: its own body's size and, for each call the body makes of an
// inlinable instance whose expanded size its directive allows at an ordinary call, that size in
// turn less the call it replaces (`MirInline.callSized`), as inlining the body would bring those
// in after it. A call back into `chain`, the
// instances being expanded, stays a call. The sum stops at `MirInline.expansionCap`.
effect fn expandedSize(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  selected: &InstanceKey, observing: bool, facts: &Option<CoroutineFacts>, chain: &mut List<u64>, known: &mut Expansions) -> Expansion
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let hash = InstanceKey.runtimeHash(selected)
  let found = run known.instances.find(hash, selected)
  if found != usize.MAX { return Expansion {size: List<usize>.get(&known.sizes, found), directive: List<usize>.get(&known.directives, found)} }
  let mut size = usize.MAX
  let mut directive = usize.ZERO
  if let Option<InlineFacts>.Some {value: summary} = move run inlineFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, selected,
    observing, facts) {
    directive = summary.directive
    if summary.inlinable {
      size = summary.size
      run List<u64>.append(&mut chain.*, hash)
      let callees = move summary.callees
      let listed = List<InstanceKey>.asSlice(&callees)
      let mut each = usize.ZERO
      while each < listed.length && size <= MirInline.expansionCap {
        let calledHash = InstanceKey.runtimeHash(&listed[each])
        let mut recursive = false
        let mut link = usize.ZERO
        while link < List<u64>.length(&chain.*) {
          if List<u64>.get(&chain.*, link) == calledHash { recursive = true }
          link = link + usize.ONE
        }
        if !recursive {
          let called = run expandedSize(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[each], observing, facts, &mut chain.*,
            &mut known.*)
          if called.size != usize.MAX && called.size <= MirInline.expandedLimit(called.directive, resolver.directSize, MirInline.plainExpanded)
            && (called.directive == 2 || called.size <= MirInline.expansionCap) {
            // The body takes the place of its call.
            if called.size > MirInline.callSized { size = size + called.size - MirInline.callSized }
          }
        }
        each = each + usize.ONE
      }
      drop List<u64>.pop(&mut chain.*)
      if size > MirInline.expansionCap { size = MirInline.expansionCap + usize.ONE }
    }
  }
  drop run known.instances.add(hash, selected)
  run List<usize>.append(&mut known.*.sizes, size)
  run List<usize>.append(&mut known.*.directives, directive)
  return Expansion {size: size, directive: directive}
}

// A successful declaration proof reads outgoing specializations, suspension summaries
// and the paths to a call before suspension. Local operands and names do not decide any of them.
// A new diagnostic reads current source origins when it is produced. An admission, parking
// obligation or direct suspension keeps its exact MIR generation.
pub struct ProofMir {
  pub index: usize,
  pub generation: u32,
  pub digest: Option<ContentHash>,
  pub changed: u32,
}

// Verify a partial read of a MIR result directly. Multiple declaration roots share the
// fingerprint; a lowered generation is hashed once, however many roots observe it.
pub effect fn observeProofMir(resolver: &mut Resolver, unit: usize, answer: &Shared<Result<Answer, NoRejection>>) -> u32
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, answerMirIndex) {
    Option<usize>.Some {value} => value
    _ => usize.MAX
  }
  let generation = Graph.generation(&resolver.graph, unit)
  let slot = InternIndex.first(&resolver.proofMirUnits, usize.toU64(unit))
  if slot != usize.MAX && index != usize.MAX {
    let previous = &List<ProofMir>.asSlice(&resolver.proofMirs)[slot]
    if previous.index == index { return previous.changed }
  }
  let digest = if index == usize.MAX { Option<ContentHash>.none() } else {
    run proofDigest(&List<MirFunction>.asSlice(&resolver.mirValues)[index])
  }
  let mut changed = Graph.revision(&resolver.graph)
  if slot != usize.MAX {
    let previous = &List<ProofMir>.asSlice(&resolver.proofMirs)[slot]
    if let Option<ContentHash>.Some {value: old} = &previous.digest {
      if let Option<ContentHash>.Some {value: fresh} = &digest {
        if ContentHash.equals(old, fresh) { changed = previous.changed }
      }
    }
    List<ProofMir>.set(&mut resolver.proofMirs, slot, ProofMir {index: index, generation: generation, digest: move digest, changed: changed})
  } else {
    run List<ProofMir>.reserve(&mut resolver.proofMirs, usize.ONE)
    run InternIndex.record(&mut resolver.proofMirUnits, usize.toU64(unit))
    run List<ProofMir>.append(&mut resolver.proofMirs, ProofMir {index: index, generation: generation, digest: move digest, changed: changed})
  }
  return changed
}

// A successful raw MIR answer already supplies everything a declaration discovery visit
// needs. Reuse the retained body only for the exact scoped producer and the same run.
// Failed and stale answers take the ordinary path and collect current diagnostics.
pub effect fn retainedDiscoveryMir(resolver: &mut Resolver, key: Key) -> Option<usize> ! OutOfMemoryError ? &mut Allocator {
  let word = run internKey(&mut resolver.*, key)
  let unit = u64.toUsize(word.value)
  if !Graph.current(&resolver.graph, unit) { return Option<usize>.none() }
  let slot = InternIndex.first(&resolver.proofMirUnits, word.value)
  if slot == usize.MAX { return Option<usize>.none() }
  let known = &List<ProofMir>.asSlice(&resolver.proofMirs)[slot]
  if known.index == usize.MAX || known.generation != Graph.generation(&resolver.graph, unit) { return Option<usize>.none() }
  let index = known.index
  run Graph.record(&mut resolver.graph, resolver.rootRecorder, Dependee.MirDispatch {unit: unit})
  return Option<usize>.some(index)
}

effect fn proofDigest(function: &MirFunction) -> Option<ContentHash> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if List<ErasureFact>.length(&function.erasures) != usize.ZERO || List<MirNonParkingRun>.length(&function.nonParking) != usize.ZERO
    || Option<BodyOrigin>.isSome(&function.parks) || Option<BodyOrigin>.isSome(&function.suspension) {
    return Option<ContentHash>.none()
  }
  let mut bytes = Bytes.make()
  let declared = DeclarationId.copyShared(&InstanceKey.identity(&function.key))
  let module = DeclarationId.moduleId(&declared)
  let summary = run SuspensionSummary.make(function, &function.key, module, &Option<Anchor>.none(), module, Span.make(usize.ZERO, usize.ZERO))
  let digest = run summaryDigest(&summary, function.observes, true)
  run RuntimeEncoding.word(&mut bytes, digest.high)
  run RuntimeEncoding.word(&mut bytes, digest.low)
  let refs = List<MirReference>.asSlice(&function.references)
  run RuntimeEncoding.word(&mut bytes, usize.toU64(refs.length))
  let mut at = usize.ZERO
  while at < refs.length {
    run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&run InstanceKey.exactIdentity(&refs[at].key)))
    run RuntimeEncoding.field(&mut bytes, Bytes.asSlice(&run Edge.recordBytes(&refs[at].edge, &declared)))
    at = at + usize.ONE
  }
  run ErasedRecursion.appendControlFlow(&mut bytes, function)
  return Option<ContentHash>.some(ContentHash.of(Bytes.asSlice(&bytes)))
}

// Summarizes the un-inlined MIR of the instance `key` names (`Family.InlineSummary`).
pub effect fn resolveInlineSummary(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut dependencies = List<Dependency>.make()
  let lowered = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, Key {family: Family.Mir, module: key.module,
    declaration: key.declaration, member: key.member, name: key.name, external: false}, Span.make(usize.ZERO, usize.ZERO))
  let mut inlinable = false
  let mut directive = usize.ZERO
  let mut size = usize.ZERO
  let mut suspends = true
  let mut pure: u8 = 0
  let mut callees = List<InstanceKey>.make()
  let mut shift7Calls = Bytes.make()
  let mut encodings = Bytes.make()
  if let Option<MirFunction>.Some {value: function} = move run coalescedMir(&mut resolver.*, &lowered) {
    inlinable = MirInline.inlinable(&function)
    directive = MirInline.directive(&function)
    // Only an inlinable body's size and purity are read, so an edit of any other body leaves its
    // summary, and with it every caller, as they were.
    if inlinable {
      size = MirInline.cost(&function)
      pure = MirInline.pureKind(&function)
    }
    suspends = false
    if let Option.Some {..} = &function.suspension { suspends = true }
    if let Option.Some {..} = &function.parks { suspends = true }
    let blocks = List<MirBlock>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      if let MirTerminator.Call {call} = &blocks[at].terminator { if let MirCallTerminator {callee: MirCallee.Instance {key: called}, ..} = &call.get().* {
        let encoded = run InstanceKey.encoding(&called)
        run Bytes.append(&mut encodings, Bytes.asSlice(&encoded))
        run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&called))
        let s7: u8 = if inlinable && MirInline.callArg1SmallConst(&function, at, 7) { 1 } else { 0 }
        run Bytes.append(&mut shift7Calls, &[s7])
      } }
      at = at + usize.ONE
    }
  }
  return memberSuccess(Value.InlineSummary {inlinable: inlinable, directive: directive, size: size, suspends: suspends, pure: pure, callees: move callees,
    shift7Calls: move shift7Calls, encodings: move encodings},
    move dependencies)
}

// The inline summary of `selected`'s un-inlined MIR, as a recorded dependency of the caller: whether
// it is inlinable, whether it suspends or parks itself, its purity classification (`0` = impure,
// `1` = pure/total, `2` = pure when arg 1 is a constant `<= 7`), and its callees.
struct InlineFacts {
  inlinable: bool,
  directive: usize,
  size: usize,
  suspends: bool,
  pure: u8,
  callees: List<InstanceKey>,
  shift7Calls: Bytes,
}

effect fn inlineFacts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  selected: &InstanceKey, observing: bool, facts: &Option<CoroutineFacts>) -> Option<InlineFacts>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let location = match move run locationOfInstance(&mut resolver.*, selected) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option<InlineFacts>.none() }
  }
  let variant = run exactBackendVariant(&mut resolver.*, selected, observing, facts, true)
  let request = run internDeclaration(&mut resolver.*, Key {family: Family.InlineSummary, module: location.module,
    declaration: location.declaration, member: instanceMember(selected), name: variant, external: false})
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, request, Span.make(usize.ZERO, usize.ZERO))
  let listed = Shared<Result<Answer, NoRejection>>.with<usize>(&answer, |held: &Result<Answer, NoRejection>| -> usize {
    if let Result<Answer, NoRejection>.Success {value} = &held.* {
      if let Outcome.Success {value: Value.InlineSummary {callees, ..}} = &value.outcome { return List<InstanceKey>.length(&callees) }
    }
    return usize.ZERO
  })
  let mut inlinable = false
  let mut directive = usize.ZERO
  let mut size = usize.ZERO
  let mut suspends = true
  let mut pure: u8 = 0
  let mut present = false
  Shared<Result<Answer, NoRejection>>.with<()>(&answer, |held: &Result<Answer, NoRejection>| -> () {
    if let Result<Answer, NoRejection>.Success {value} = &held.* {
      if let Outcome.Success {value: Value.InlineSummary {inlinable: candidate, directive: asked, size: own, suspends: suspending, pure: isPure, ..}} = &value.outcome {
        inlinable = candidate
        directive = asked
        size = own
        suspends = suspending
        pure = isPure
        present = true
      }
    }
    return ()
  })
  if !present { return Option<InlineFacts>.none() }
  let mut callees = run List<InstanceKey>.makeWithCapacity(listed)
  let mut shift7Calls = Bytes.make()
  let mut at = usize.ZERO
  while at < listed {
    let key = Shared<Result<Answer, NoRejection>>.with<Option<InstanceKey>>(&answer, |held: &Result<Answer, NoRejection>| -> Option<InstanceKey> {
      if let Result<Answer, NoRejection>.Success {value} = &held.* {
        if let Outcome.Success {value: Value.InlineSummary {callees: named, ..}} = &value.outcome {
          return Option<InstanceKey>.some(InstanceKey.copy(&List<InstanceKey>.asSlice(&named)[at]))
        }
      }
      return Option<InstanceKey>.none()
    })
    let s7 = Shared<Result<Answer, NoRejection>>.with<u8>(&answer, |held: &Result<Answer, NoRejection>| -> u8 {
      if let Result<Answer, NoRejection>.Success {value} = &held.* {
        if let Outcome.Success {value: Value.InlineSummary {shift7Calls: flags, ..}} = &value.outcome {
          let fs = Bytes.asSlice(&flags)
          if at < fs.length { return fs[at] }
        }
      }
      return 0
    })
    if let Option<InstanceKey>.Some {value} = move key {
      run List<InstanceKey>.append(&mut callees, move value)
      run Bytes.append(&mut shift7Calls, &[s7])
    }
    at = at + usize.ONE
  }
  return Option<InlineFacts>.some(InlineFacts {inlinable: inlinable, directive: directive, size: size, suspends: suspends, pure: pure, callees: move callees, shift7Calls: move shift7Calls})
}

// Transitively checks whether `selected` and all of its callees are side-effect-free, non-trapping,
// and guaranteed to terminate (cycle-guarded at depth 12).
effect fn isPureTotalBody(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  selected: &InstanceKey,
  observing: bool,
  facts: &Option<CoroutineFacts>,
  arg1Const7: bool,
  chain: &mut List<u64>,
) -> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let depth = List<u64>.length(&chain.*)
  if depth >= 12 { return false }
  let hash = InstanceKey.runtimeHash(selected)
  let active = List<u64>.asSlice(&chain.*)
  let mut ci = usize.ZERO
  while ci < active.length {
    if active[ci] == hash { return false }
    ci = ci + usize.ONE
  }
  let info = match move run inlineFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, selected, observing, facts) {
    Option<InlineFacts>.Some {value} => move value
    Option<InlineFacts>.None => { return false }
  }
  let selfPure = info.pure == 1 || (arg1Const7 && info.pure == 2)
  if !selfPure || info.suspends { return false }
  run List<u64>.append(&mut chain.*, hash)
  let callees = List<InstanceKey>.asSlice(&info.callees)
  let s7Flags = Bytes.asSlice(&info.shift7Calls)
  let mut ok = true
  let mut at = usize.ZERO
  while at < callees.length && ok {
    let childS7 = at < s7Flags.length && s7Flags[at] != 0
    if !run isPureTotalBody(&mut resolver.*, &mut owner.*, &mut dependencies.*, &callees[at], observing, facts, childS7, &mut chain.*) {
      ok = false
    }
    at = at + usize.ONE
  }
  drop List<u64>.pop(&mut chain.*)
  return ok
}

// Whether an answer holds the source construction that its own ordinary unit needs.
fn answerMirConstruction(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Mir {construction, ..}} = &value.outcome { return construction }
  }
  return false
}

// An inline decision and a splice read the same coalesced body as storage used to retain.
// Only this temporary view is coalesced; the raw query keeps one construction for its own caller.
effect fn coalescedMir(resolver: &mut Resolver, answer: &Shared<Result<Answer, NoRejection>>) -> Option<MirFunction>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, answerMirIndex) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Option<MirFunction>.none() }
  }
  if !Shared<Result<Answer, NoRejection>>.with<bool>(answer, answerMirConstruction) {
    return Option<MirFunction>.some(run MirInline.copy(&List<MirFunction>.asSlice(&resolver.mirValues)[index]))
  }
  // A stored function never changes, so its coalesced copy is made once and copied from then on.
  while List<usize>.length(&resolver.coalescedIndex) <= index { run List<usize>.append(&mut resolver.coalescedIndex, usize.MAX) }
  let mut held = List<usize>.get(&resolver.coalescedIndex, index)
  if held == usize.MAX {
    let mut function = run MirInline.copy(&List<MirFunction>.asSlice(&resolver.mirValues)[index])
    if !instanceFastPath(&resolver.*, &function.key) {
      run MirCoalesce.coalesce(&mut function)
    }
    held = List<MirFunction>.length(&resolver.coalescedValues)
    run List<MirFunction>.append(&mut resolver.coalescedValues, move function)
    List<usize>.set(&mut resolver.coalescedIndex, index, held)
  }
  return Option<MirFunction>.some(run MirInline.copy(&List<MirFunction>.asSlice(&resolver.coalescedValues)[held]))
}

// The coalesced, un-inlined MIR of `selected`, with its raw query recorded as a dependency;
// none when the instance has no MIR. The returned view is released after this one consumer.
effect fn rawMir(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  selected: &InstanceKey, observing: bool, facts: &Option<CoroutineFacts>) -> Option<MirFunction>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let answer = match move run rawMirAnswer(&mut resolver.*, &mut owner.*, &mut dependencies.*, selected, observing, facts, false) {
    Option<Shared<Result<Answer, NoRejection>>>.Some {value} => move value
    Option<Shared<Result<Answer, NoRejection>>>.None => { return Option<MirFunction>.none() }
  }
  return run coalescedMir(&mut resolver.*, &answer)
}

// A wrapper whose result and destructor are discarded may itself be erased only if it
// and all calls it makes terminate without observable behavior. The inspection variant
// keeps the original calls, so recursive wrappers cannot prove themselves erasable.
pub effect fn erasedInlineBody(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  selected: &InstanceKey, observing: bool) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut stack = List<InstanceKey>.make()
  return run erasedCallTree(&mut resolver.*, &mut owner.*, &mut dependencies.*, selected, observing, &mut stack)
}

effect fn erasedCallTree(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  selected: &InstanceKey, observing: bool, stack: &mut List<InstanceKey>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  // A generated helper is lowered with its creator; following it here could demand
  // the original caller while that caller is being inspected.
  if let InstanceKey.Helper {..} = &selected.* { return false }
  let path = List<InstanceKey>.asSlice(&stack.*)
  if path.length >= 16 { return false }
  let mut at = usize.ZERO
  while at < path.length {
    if run InstanceKey.sameInstance(&path[at], selected) { return false }
    at = at + usize.ONE
  }
  let answer = match move run rawMirAnswer(&mut resolver.*, &mut owner.*, &mut dependencies.*, selected,
    observing, &Option<CoroutineFacts>.none(), true) {
    Option<Shared<Result<Answer, NoRejection>>>.Some {value} => move value
    Option<Shared<Result<Answer, NoRejection>>>.None => { return false }
  }
  let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let mut children = List<InstanceKey>.make()
  if !run MirObservation.directCalls(&List<MirFunction>.asSlice(&resolver.mirValues)[index], &mut children) { return false }
  run List<InstanceKey>.append(&mut stack.*, InstanceKey.copy(selected))
  let called = List<InstanceKey>.asSlice(&children)
  at = usize.ZERO
  while at < called.length {
    if !run erasedCallTree(&mut resolver.*, &mut owner.*, &mut dependencies.*, &called[at], observing, &mut stack.*) {
      drop List<InstanceKey>.pop(&mut stack.*)
      return false
    }
    at = at + usize.ONE
  }
  drop List<InstanceKey>.pop(&mut stack.*)
  return true
}

effect fn rawMirAnswer(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  selected: &InstanceKey, observing: bool, facts: &Option<CoroutineFacts>, inspect: bool) -> Option<Shared<Result<Answer, NoRejection>>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let location = match move run locationOfInstance(&mut resolver.*, selected) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return Option<Shared<Result<Answer, NoRejection>>>.none() }
  }
  let variant = run backendVariantFor(&mut resolver.*, selected, observing, facts, true, inspect)
  let request = run internDeclaration(&mut resolver.*, Key {family: Family.Mir, module: location.module,
    declaration: location.declaration, member: instanceMember(selected), name: variant, external: false})
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, request, Span.make(usize.ZERO, usize.ZERO))
  return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
}

// Whether `selected` may be inlined at a call that is not a suspension point: it is inlinable and
// quiet (`InlineVerdicts`). The walk follows the callees each summary lists and stops at an
// instance that suspends, one without a summary, or more than `quietReach` instances. Every
// verdict is a property of `selected` alone; `verdicts` keeps each one, and `settled` every
// instance a finished walk reached, none of which reaches a suspending one.
effect fn quietBody(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  selected: &InstanceKey, observing: bool, facts: &Option<CoroutineFacts>, settled: &mut InstanceTable,
  verdicts: &mut InlineVerdicts) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let selectedHash = InstanceKey.runtimeHash(selected)
  let known = run verdicts.instances.find(selectedHash, selected)
  if known != usize.MAX { return List<bool>.get(&verdicts.quiet, known) }
  let mut quiet = false
  let mut directive = usize.ZERO
  let mut reached = List<InstanceKey>.make()
  let mut reachedHashes = List<u64>.make()
  if let Option<InlineFacts>.Some {value: summary} = move run inlineFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, selected,
    observing, facts) {
    quiet = summary.inlinable && !summary.suspends
    directive = summary.directive
    run List<InstanceKey>.append(&mut reached, InstanceKey.copy(selected))
    run List<u64>.append(&mut reachedHashes, selectedHash)
    let mut pending = move summary.callees
    while quiet && List<InstanceKey>.length(&pending) != usize.ZERO {
      let last = List<InstanceKey>.length(&pending) - usize.ONE
      let next = List<InstanceKey>.remove(&mut pending, last)
      let nextHash = InstanceKey.runtimeHash(&next)
      let mut seen = (run settled.find(nextHash, &next)) != usize.MAX
      if !seen { seen = run hashedAmong(&reachedHashes, &reached, nextHash, &next) }
      if seen { continue }
      if List<InstanceKey>.length(&reached) >= quietReach() {
        quiet = false
        continue
      }
      match move run inlineFacts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &next, observing, facts) {
        Option<InlineFacts>.Some {value: called} => {
          if called.suspends {
            quiet = false
          } else {
            let mut further = move called.callees
            while List<InstanceKey>.length(&further) != usize.ZERO {
              let tail = List<InstanceKey>.length(&further) - usize.ONE
              let moved = List<InstanceKey>.remove(&mut further, tail)
              run List<InstanceKey>.append(&mut pending, move moved)
            }
          }
        }
        Option<InlineFacts>.None => { quiet = false }
      }
      run List<InstanceKey>.append(&mut reached, move next)
      run List<u64>.append(&mut reachedHashes, nextHash)
    }
  }
  if quiet {
    // Each reached instance is new to `settled`: the walk skipped the ones it held.
    let found = List<InstanceKey>.asSlice(&reached)
    let mut each = usize.ZERO
    while each < found.length {
      drop run settled.add(List<u64>.get(&reachedHashes, each), &found[each])
      each = each + usize.ONE
    }
  }
  drop run verdicts.instances.add(selectedHash, selected)
  run List<bool>.append(&mut verdicts.*.quiet, quiet)
  run List<usize>.append(&mut verdicts.*.directives, directive)
  return quiet
}

// Whether `key`, whose hash is `hash`, is one of `keys`, whose hashes are `hashes`.
effect fn hashedAmong(hashes: &List<u64>, keys: &List<InstanceKey>, hash: u64, key: &InstanceKey) -> bool ! OutOfMemoryError ? &mut Allocator {
  let listed = List<u64>.asSlice(hashes)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == hash && run InstanceKey.sameInstance(&List<InstanceKey>.asSlice(keys)[at], key) { return true }
    at = at + usize.ONE
  }
  return false
}

// Collects every instance `function` still calls, drops through, takes the address of, or owes a
// proof for.
effect fn stillUsed(function: &MirFunction, used: &mut InstanceTable) -> () ! OutOfMemoryError ? &mut Allocator {
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut block = usize.ZERO
  while block < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[block].statements)
    let mut at = usize.ZERO
    while at < statements.length {
      match &statements[at] {
        MirStatement.Drop {glue, ..} => { run used.note(&glue) }
        MirStatement.Assign {value: MirRvalue.FunctionAddress {key: addressed}, ..} => { run used.note(&addressed) }
        _ => {}
      }
      at = at + usize.ONE
    }
    if let MirTerminator.Call {call} = &blocks[block].terminator { if let MirCallTerminator {callee: MirCallee.Instance {key: called}, ..} = &call.get().* {
      run used.note(&called)
    } }
    block = block + usize.ONE
  }
  let runs = List<MirNonParkingRun>.asSlice(&function.nonParking)
  let mut owed = usize.ZERO
  while owed < runs.length {
    let callees = List<InstanceKey>.asSlice(&runs[owed].callees)
    let mut at = usize.ZERO
    while at < callees.length {
      run used.note(&callees[at])
      at = at + usize.ONE
    }
    owed = owed + usize.ONE
  }
  let accesses = List<MirSharedAccess>.asSlice(&function.accesses)
  let mut at = usize.ZERO
  while at < accesses.length {
    run used.note(&accesses[at].callback)
    at = at + usize.ONE
  }
  return ()
}

// Which callees one call may inline, by backend and kind of call (`inlineRule`).
enum InlineRule {
  // None: the call keeps its callee.
  Never,
  // A callee frame selection chose for this suspension point (`MirInline.eligible`).
  Frame,
  // A value forwarder (`MirInline.valueForwarder`).
  Forwarder,
  // A quiet, inlinable callee (`quietBody`).
  Quiet,
  // Either of the last two.
  ForwarderOrQuiet,
  // An explicit `@inlineAlways` small leaf (`MirInline.alwaysLeaf`), spliced across all builds
  // (including dev and LLVM) so trivial generic wrappers never enter codegen or ELF.
  AlwaysLeaf,
}

// Whether `key` carries an explicit `@inlineAlways` directive (reads only `SourceFacet.Directives`,
// so callers of ordinary non-`@inlineAlways` functions never depend on the callee's body).
effect fn explicitInlineAlways(resolver: &mut Resolver, key: &InstanceKey) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Interned<Type>>.Some {..} = move InstanceKey.glueType(key) {
    return false
  }
  let location = match move run locationOfInstance(&mut resolver.*, key) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return false }
  }
  if location.declaration == usize.MAX { return false }
  let module = resolvedModule(&resolver.*, location.module)
  let mode = run declarationInlining(&mut resolver.*, &module, location.declaration)
  return mode == MirInlining.Always
}

// The one inlining rule of a call. A suspension point of a frame variant inlines only what frame
// selection chose, and a frame variant's other calls inline a value forwarder, whatever the
// backend: LLVM inlines too late to coalesce these into the frame. Optimized direct builds inline
// any quiet inlinable callee; all other builds (dev and LLVM) splice explicit `@inlineAlways`
// small leaves so trivial generic wrappers disappear before codegen.
fn inlineRule(direct: bool, fullInlining: bool, framed: bool, selected: bool, suspending: bool) -> InlineRule {
  if suspending { return if fullInlining { InlineRule.Frame } else { InlineRule.Never } }
  if fullInlining && framed && direct { return InlineRule.ForwarderOrQuiet }
  if fullInlining && framed && selected { return InlineRule.Forwarder }
  if fullInlining && direct { return InlineRule.Quiet }
  return InlineRule.AlwaysLeaf
}

// Whether this MIR variant runs full inlining through the raw-MIR wrapper query. LLVM selects
// callees only in suspendable frames; direct builds may also inline synchronous calls. Line tables
// keep every authored boundary. Dev and non-framed LLVM builds splice explicit `@inlineAlways`
// small leaves in place during single-pass `lowerMir` without a second `Family.Mir` query.
pub fn inlinesMir(resolver: &Resolver, facts: &Option<CoroutineFacts>, key: &InstanceKey) -> bool {
  if !instanceInlining(resolver, key) || instanceLines(resolver, key) { return false }
  if resolver.direct { return true }
  if let Option<CoroutineFacts>.Some {value} = &facts.* { return List<InstanceKey>.length(&value.inline) != usize.ZERO }
  return false
}

// Whether `function` has any direct instance call whose target carries an explicit `@inlineAlways`
// directive. Reads only `SourceFacet.Directives`, so callers of ordinary functions gain no
// `Family.Mir` dependency and perform zero extra work.
effect fn hasExplicitAlwaysCall(resolver: &mut Resolver, function: &MirFunction) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut targets = List<InstanceKey>.make()
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {call} = &blocks[at].terminator {
      if let MirCallTerminator {callee: MirCallee.Instance {key: target}, ..} = &call.get().* {
        run List<InstanceKey>.append(&mut targets, InstanceKey.copy(&target))
      }
    }
    at = at + usize.ONE
  }
  let listed = List<InstanceKey>.asSlice(&targets)
  let mut ti = usize.ZERO
  while ti < listed.length {
    if run explicitInlineAlways(&mut resolver.*, &listed[ti]) { return true }
    ti = ti + usize.ONE
  }
  return false
}

// Fast pre-check before copying raw MIR in the `inlinesMir` wrapper path: returns false when
// `resolver.mirValues[mirIndex]` has zero direct instance calls, avoiding `MirInline.copy`.
fn mayInlineAnyCall(resolver: &Resolver, mirIndex: usize) -> bool {
  let blocks = List<MirBlock>.asSlice(&List<MirFunction>.asSlice(&resolver.mirValues)[mirIndex].blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {call} = &blocks[at].terminator {
      if let MirCallTerminator {callee: MirCallee.Instance {..}, ..} = &call.get().* {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Inlines calls of the instance being lowered, in a build without line tables, under each call's
// `inlineRule`.
//
// A quiet callee's un-inlined MIR is inlinable and nothing its calls reach suspends
// (`quietBody`); the calls it makes stay calls in the caller. A value forwarder in a frame variant can call nothing that suspends, since the
// call itself does not. A suspension point of a frame variant
// inlines a callee frame selection chose (`facts.inline`), lowered with this frame's facts so its
// own points have cancel exits, which chain into the point's. Every decision reads the callee
// alone. The caller reads only un-inlined MIR, a recorded dependency, which inlines nothing, so
// inlining demands no other function's inlined MIR. A spliced body's own calls are candidates in
// turn, recursion is cut by ancestry, and bodies larger than a call (`MirInline.callSized`) that
// carry no `@inlineAlways` grow the caller by at most a bound that depends only on its own size. Afterwards an inlined
// instance the body no longer uses is no longer referenced, so the build does not emit it for
// this caller.
effect fn inlineCalls(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, function: &mut MirFunction, facts: &Option<CoroutineFacts>, observing: bool) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let fullInlining = instanceInlining(&resolver.*, &function.key) && !instanceLines(&resolver.*, &function.key)
  let mut candidates = List<InstanceKey>.make()
  let mut rawFacts = Option<CoroutineFacts>.none()
  let mut framed = false
  if let Option<CoroutineFacts>.Some {value} = &facts.* {
    framed = true
    let listed = List<InstanceKey>.asSlice(&value.inline)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<InstanceKey>.append(&mut candidates, InstanceKey.copy(&listed[at]))
      at = at + usize.ONE
    }
    let mut raw = run CoroutineFacts.copy(&value)
    raw.inline = List<InstanceKey>.make()
    rawFacts = Option<CoroutineFacts>.some(move raw)
  }
  // The function's size (`MirInline.size`), kept up as each splice adds blocks and statements,
  // and the size no chosen splice takes it past: a guard against a runaway, far above what the
  // per-call limits (`MirInline.expandedLimit`) let a function reach.
  let mut grown = MirInline.size(&function.*)
  let limit = grown + inlineGrowth(grown)
  let alwaysLimit = grown + alwaysGrowth(grown)
  // The first origin node no statement of the function uses yet, which each splice moves on.
  let mut nodes = MirInline.freshNode(&function.*)
  // The function's references by their instances' hashes, kept up as splices add theirs.
  let mut referenceIndex = InternIndex.make()
  let mut indexed = usize.ZERO
  let mut expandedSizes = Expansions {instances: InstanceTable.make(), sizes: List<usize>.make(), directives: List<usize>.make()}
  let mut verdicts = InlineVerdicts {instances: InstanceTable.make(), quiet: List<bool>.make(), directives: List<usize>.make()}
  // The instances a finished walk of `quietBody` reached, none of which reaches a suspending one.
  let mut settled = InstanceTable.make()
  // The instances spliced at a suspension point or as a value forwarder, and those spliced as
  // quiet bodies, each once.
  let mut inlined = InstanceTable.make()
  let mut quietly = InstanceTable.make()
  // The callee bodies read so far, each with its size (`MirInline.size`), at its instance's
  // position in `held`.
  let mut held = InstanceTable.make()
  let mut bodies = List<MirFunction>.make()
  let mut bodySizes = List<usize>.make()
  let mut ancestry = List<usize>.make()
  run List<usize>.appendRepeated(&mut ancestry, usize.MAX, List<MirBlock>.length(&function.blocks))
  let mut expansions = List<InlineExpansion>.make()
  // The blocks control can come back to: a call there runs many times, so a build for speed
  // inlines a larger body at it. A spliced body's blocks count as its call's block does.
  let mut cyclic = List<bool>.make()
  if fullInlining && resolver.direct {
    cyclic = run MirInline.loopBlocks(&function.*)
  } else {
    run List<bool>.appendRepeated(&mut cyclic, false, List<MirBlock>.length(&function.blocks))
  }
  // The blocks still to visit, the next one last: the function's own in order, and a spliced
  // body's right after its call, so its calls are settled before the budget goes to calls
  // further on, as they would be in the callee's own lowering.
  let mut pending = List<usize>.make()
  let mut queued = List<MirBlock>.length(&function.blocks)
  while queued > usize.ZERO {
    queued = queued - usize.ONE
    run List<usize>.append(&mut pending, queued)
  }
  while List<usize>.length(&pending) != usize.ZERO {
    let last = List<usize>.length(&pending) - usize.ONE
    let at = List<usize>.remove(&mut pending, last)
    let mut budget = MirInline.plainExpanded
    let target = match &List<MirBlock>.asSlice(&function.blocks)[at].terminator {
      MirTerminator.Call {call} => {
        if let MirCallTerminator {callee: MirCallee.Instance {key}, arguments, normal, destination, ..} = &call.get().* {
          if !resolver.directSize && List<bool>.get(&cyclic, at) {
            budget = MirInline.loopBudget(List<MirOperand>.length(&arguments), MirInline.inspectsTag(&function.*, normal, &destination))
          }
          Option<InstanceKey>.some(InstanceKey.copy(&key))
        } else {
          Option<InstanceKey>.none()
        }
      }
      _ => Option<InstanceKey>.none()
    }
    let point = at
    let selected = match move target {
      Option<InstanceKey>.Some {value} => move value
      Option<InstanceKey>.None => { continue }
    }
    // Package backend settings survive lowering: a cross-package call keeps its own body.
    if resolver.packageCodegen.length() != usize.ZERO {
      let caller = DeclarationId.copyShared(&InstanceKey.identity(&function.key))
      let callee = DeclarationId.copyShared(&InstanceKey.identity(&selected))
      let samePackage = ModuleId.withPackage<bool>(DeclarationId.moduleId(&caller), |name: &[u8]| -> bool {
        return ModuleId.withPackage<bool>(DeclarationId.moduleId(&callee), |other: &[u8]| -> bool { return name == other })
      })
      if !samePackage || !instanceInlining(&resolver.*, &selected) || instanceLines(&resolver.*, &selected) { continue }
    }
    let mut suspending = false
    let cancels = List<MirCancel>.asSlice(&function.cancels)
    let mut cancel = usize.ZERO
    while cancel < cancels.length {
      if cancels[cancel].point == point { suspending = true }
      cancel = cancel + usize.ONE
    }
    if suspending {
      let listed = List<InstanceKey>.asSlice(&candidates)
      let mut candidate = usize.ZERO
      let mut found = false
      while candidate < listed.length && !found {
        found = run InstanceKey.sameInstance(&listed[candidate], &selected)
        candidate = candidate + usize.ONE
      }
      if !found { continue }
    }
    let mut recursive = run InstanceKey.sameInstance(&function.key, &selected)
    let mut ancestor = List<usize>.get(&ancestry, point)
    let prior = List<InlineExpansion>.asSlice(&expansions)
    while ancestor != usize.MAX && !recursive {
      recursive = run InstanceKey.sameInstance(&prior[ancestor].key, &selected)
      ancestor = prior[ancestor].parent
    }
    if recursive { continue }
    let rule = inlineRule(resolver.direct, fullInlining, framed, List<InstanceKey>.length(&candidates) != usize.ZERO, suspending)
    if rule == InlineRule.Never { continue }
    if rule == InlineRule.AlwaysLeaf {
      if !run explicitInlineAlways(&mut resolver.*, &selected) { continue }
    }
    let mut largeAlways = false
    // A quiet callee's summary is read first, so the caller depends on the body of a callee it
    // does not inline only through that summary.
    if rule == InlineRule.Quiet {
      if !run quietBody(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, observing, &rawFacts, &mut settled,
        &mut verdicts) { continue }
      // A quiet callee is spliced when what it would bring in is within what its directive
      // allows at this call.
      let directive = run verdictDirective(&verdicts, &selected)
      let mut chain = List<u64>.make()
      let expansion = run expandedSize(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, observing, &rawFacts, &mut chain,
        &mut expandedSizes)
      if expansion.size > MirInline.expandedLimit(directive, resolver.directSize, budget) { continue }
      largeAlways = directive == 2 && expansion.size > MirInline.hintedExpanded
    }
    // A callee's body is read and coalesced once for all its calls in this function.
    let wanted = InstanceKey.runtimeHash(&selected)
    let mut body = run held.find(wanted, &selected)
    if body == usize.MAX {
      let read = match move run rawMir(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, observing, &rawFacts) {
        Option<MirFunction>.Some {value} => move value
        Option<MirFunction>.None => { continue }
      }
      run List<usize>.append(&mut bodySizes, MirInline.size(&read))
      run List<MirFunction>.append(&mut bodies, move read)
      body = run held.add(wanted, &selected)
    }
    let callee = &List<MirFunction>.asSlice(&bodies)[body]
    // A body no larger than the call it replaces costs the caller nothing, whatever it has grown to.
    let calleeSize = List<usize>.get(&bodySizes, body)
    // `@inlineAlways`, and the forwarding bodies that count as it, have no limit of their own at
    // a call. A small one is spliced whatever the caller has grown to, as LLVM does for
    // `alwaysinline`. One whose expanded size is past what a hint allows is bounded by the
    // caller's growth, which keeps a chain of them from multiplying: a field multiplication
    // spliced into each of the dozens of calls of a point operation that is itself spliced
    // tripled a module for no measured gain. A call on a cycle of the caller's blocks is exempt:
    // there the body runs many times for each time its code is paid for.
    if largeAlways && !List<bool>.get(&cyclic, point) && grown + calleeSize > alwaysLimit { continue }
    if calleeSize > MirInline.callSized && callee.inlining != MirInlining.Always && grown + calleeSize > limit { continue }
    let mut allowed = rule == InlineRule.Quiet
    // Whether the body is spliced as a quiet one, which cannot park.
    let mut asQuiet = rule == InlineRule.Quiet
    if rule == InlineRule.AlwaysLeaf {
      allowed = MirInline.alwaysLeaf(callee, resolver.direct)
      asQuiet = allowed
    }
    if rule == InlineRule.Frame { allowed = MirInline.eligible(callee, resolver.direct) }
    if rule == InlineRule.Forwarder || rule == InlineRule.ForwarderOrQuiet { allowed = MirInline.valueForwarder(callee, resolver.direct) }
    if !allowed && rule == InlineRule.ForwarderOrQuiet {
      allowed = run quietBody(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, observing, &rawFacts, &mut settled,
        &mut verdicts)
      let directive = run verdictDirective(&verdicts, &selected)
      if allowed {
        let mut chain = List<u64>.make()
        let expansion = run expandedSize(&mut resolver.*, &mut owner.*, &mut dependencies.*, &selected, observing, &rawFacts, &mut chain,
          &mut expandedSizes)
        if expansion.size > MirInline.expandedLimit(directive, resolver.directSize, budget) { allowed = false }
        if directive == 2 && expansion.size > MirInline.hintedExpanded && !List<bool>.get(&cyclic, point) && grown + calleeSize > alwaysLimit {
          allowed = false
        }
      }
      asQuiet = allowed
    }
    if !allowed { continue }
    let callStatements = List<MirStatement>.length(&List<MirBlock>.asSlice(&function.blocks)[point].statements)
    // The edge of the function's references to this callee: direct unless one of them is a
    // witness edge, which then stands for every call of it here. Two different witness edges
    // that are not both plain leave no one edge to give the spliced body's references, so the
    // call stays.
    while indexed < List<MirReference>.length(&function.references) {
      run InternIndex.record(&mut referenceIndex, InstanceKey.runtimeHash(&List<MirReference>.asSlice(&function.references)[indexed].key))
      indexed = indexed + usize.ONE
    }
    let mut via = Edge.Direct
    let mut witnessed = usize.ZERO
    let mut plain = true
    let mut reference = InternIndex.first(&referenceIndex, wanted)
    while reference != usize.MAX {
      let found = &List<MirReference>.asSlice(&function.references)[reference]
      let direct = match &found.edge {
        Edge.Direct => true
        _ => false
      }
      if !direct && run InstanceKey.sameInstance(&found.key, &selected) {
        if witnessed == usize.ZERO { via = Edge.copy(&found.edge) }
        witnessed = witnessed + usize.ONE
        if let Edge.Witness = &found.edge {} else { plain = false }
      }
      reference = InternIndex.after(&referenceIndex, reference)
    }
    if witnessed > usize.ONE && !plain { continue }
    if run MirInline.call(&mut function.*, point, callee, resolver.direct, &mut nodes, &via) {
      // What the splice added: the statements it put in the call's block, and its new blocks.
      let now = List<MirBlock>.asSlice(&function.blocks)
      grown = grown + List<MirStatement>.length(&now[point].statements) - callStatements
      let mut newBlock = List<usize>.length(&ancestry)
      while newBlock < now.length {
        grown = grown + usize.ONE + List<MirStatement>.length(&now[newBlock].statements)
        newBlock = newBlock + usize.ONE
      }
      let parent = List<usize>.get(&ancestry, point)
      let expansion = List<InlineExpansion>.length(&expansions)
      run List<InlineExpansion>.append(&mut expansions, InlineExpansion {key: InstanceKey.copy(&selected), parent: parent})
      let before = List<usize>.length(&ancestry)
      let added = List<MirBlock>.length(&function.blocks) - before
      run List<usize>.appendRepeated(&mut ancestry, expansion, added)
      let hot = List<bool>.get(&cyclic, point)
      run List<bool>.appendRepeated(&mut cyclic, hot, added)
      let mut fresh = before + added
      while fresh > before {
        fresh = fresh - usize.ONE
        run List<usize>.append(&mut pending, fresh)
      }
      if asQuiet {
        if (run quietly.find(wanted, &selected)) == usize.MAX { drop run quietly.add(wanted, &selected) }
      } else if (run inlined.find(wanted, &selected)) == usize.MAX {
        drop run inlined.add(wanted, &selected)
      }
    }
  }
  if resolver.direct {
    run MirCoalesce.coalesce(&mut function.*)
    let mut pureChain = List<u64>.make()
    let blockCount = List<MirBlock>.length(&function.blocks)
    let mut blk = usize.ZERO
    while blk < blockCount {
      let called = match &List<MirBlock>.asSlice(&function.blocks)[blk].terminator {
        MirTerminator.Call {call} => match &call.get().callee {
          MirCallee.Instance {key} => Option<InstanceKey>.some(InstanceKey.copy(&key))
          _ => Option<InstanceKey>.none()
        }
        _ => Option<InstanceKey>.none()
      }
      if let Option<InstanceKey>.Some {value: target} = move called {
        let arg1S7 = MirInline.callArg1SmallConst(&function.*, blk, 7)
        if run isPureTotalBody(&mut resolver.*, &mut owner.*, &mut dependencies.*, &target, observing, &rawFacts, arg1S7, &mut pureChain) {
          run List<usize>.append(&mut function.pureCallBlocks, blk)
        }
      }
      blk = blk + usize.ONE
    }
  }
  if List<InstanceKey>.length(&inlined.keys) == usize.ZERO && List<InstanceKey>.length(&quietly.keys) == usize.ZERO { return () }
  // The function's inlined instances, each once: those it listed already, then the new ones in
  // the order of their first splice. The quiet ones are listed apart (`MirFunction.quiet`).
  let mut known = InstanceTable.make()
  let mut prior = usize.ZERO
  while prior < List<InstanceKey>.length(&function.inlined) {
    run known.note(&List<InstanceKey>.asSlice(&function.inlined)[prior])
    prior = prior + usize.ONE
  }
  prior = usize.ZERO
  while prior < List<InstanceKey>.length(&function.quiet) {
    run known.note(&List<InstanceKey>.asSlice(&function.quiet)[prior])
    prior = prior + usize.ONE
  }
  let listed = List<InstanceKey>.asSlice(&inlined.keys)
  let mut each = usize.ZERO
  while each < listed.length {
    let hash = InstanceKey.runtimeHash(&listed[each])
    if (run known.find(hash, &listed[each])) == usize.MAX {
      run List<InstanceKey>.append(&mut function.inlined, InstanceKey.copy(&listed[each]))
      drop run known.add(hash, &listed[each])
    }
    each = each + usize.ONE
  }
  let settledNow = List<InstanceKey>.asSlice(&quietly.keys)
  each = usize.ZERO
  while each < settledNow.length {
    let hash = InstanceKey.runtimeHash(&settledNow[each])
    if (run known.find(hash, &settledNow[each])) == usize.MAX {
      run List<InstanceKey>.append(&mut function.quiet, InstanceKey.copy(&settledNow[each]))
      drop run known.add(hash, &settledNow[each])
    }
    each = each + usize.ONE
  }
  // An LLVM build keeps the references of its frames' spliced callees (`inlined`), as it always
  // did, while pruning spliced quiet / `@inlineAlways` leaf callees (`quiet`) so trivial generic
  // wrappers never enter codegen or Clang.
  if !resolver.direct && List<InstanceKey>.length(&function.quiet) == usize.ZERO { return () }
  // A spliced instance the function no longer uses is no longer referenced, so a build that
  // splices it everywhere never reaches it and writes no code for it. What it still uses is
  // found from one walk. A whole-program proof that names such an instance finds it in
  // `inlined` or `quiet`.
  let mut used = InstanceTable.make()
  run stillUsed(&function.*, &mut used)
  let mut gone = InstanceTable.make()
  let mut pass = if resolver.direct { usize.ZERO } else { usize.ONE }
  while pass < 2 {
    let mut spliced = List<InstanceKey>.asSlice(&function.inlined)
    if pass == usize.ONE { spliced = List<InstanceKey>.asSlice(&function.quiet) }
    let mut key = usize.ZERO
    while key < spliced.length {
      let hash = InstanceKey.runtimeHash(&spliced[key])
      if (run used.find(hash, &spliced[key])) == usize.MAX && (run gone.find(hash, &spliced[key])) == usize.MAX {
        drop run gone.add(hash, &spliced[key])
      }
      key = key + usize.ONE
    }
    pass = pass + usize.ONE
  }
  if List<InstanceKey>.length(&gone.keys) != usize.ZERO {
    // The references are sorted afterwards, so they are taken from the end, in any order.
    let mut kept = List<MirReference>.make()
    while List<MirReference>.length(&function.references) != usize.ZERO {
      let last = List<MirReference>.length(&function.references) - usize.ONE
      let reference = List<MirReference>.remove(&mut function.references, last)
      let hash = InstanceKey.runtimeHash(&reference.key)
      if (run gone.find(hash, &reference.key)) == usize.MAX { run List<MirReference>.append(&mut kept, move reference) }
    }
    function.references = move kept
  }
  return run MirFunction.sortReferences(&mut function.references)
}

// How much an inlining caller of `size` statements and blocks may grow before the splices its
// calls' own limits allow stop: far more than those limits let an ordinary function reach.
fn inlineGrowth(size: usize) -> usize {
  return 65536 + 8 * size
}

// How much the `@inlineAlways` bodies whose expanded size is past `MirInline.hintedExpanded` may
// grow an inlining caller of `size` statements and blocks.
fn alwaysGrowth(size: usize) -> usize {
  return 8192 + 4 * size
}

pub effect fn lowerMir(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  key: Key,
) -> Answer ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let instances = List<BackendInstance>.asSlice(&resolver.backendInstances)
  let instance = InstanceKey.copy(&instances[key.name].key)
  let observing = instances[key.name].observing
  // A suspendable instance's frame variant records the cancel exit of each suspension point.
  let mut suspending = Option<List<InstanceKey>>.none()
  if let Option<CoroutineFacts>.Some {value: facts} = &instances[key.name].suspension {
    let mut callees = List<InstanceKey>.make()
    let listed = List<InstanceKey>.asSlice(&facts.callees)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<InstanceKey>.append(&mut callees, InstanceKey.copy(&listed[at]))
      at = at + usize.ONE
    }
    suspending = Option<List<InstanceKey>>.some(move callees)
  }
  if let InstanceKey.Helper {creator, node, ordinal, purpose} = &instance {
    return run resolveHelperMir(&mut resolver.*, &mut owner.*, &instance, Arc<InstanceKey>.get(&creator), node, ordinal, purpose, observing)
  }
  if let Option<Interned<Type>>.Some {value: glued} = move InstanceKey.glueType(&instance) {
    return run resolveGlueMir(&mut resolver.*, &mut owner.*, move instance, &glued, observing)
  }
  let inspecting = instances[key.name].inspect
  let selfRaw = instances[key.name].raw
  let selfFacts = run copySuspension(&instances[key.name].suspension)
  if !selfRaw && inlinesMir(&resolver.*, &selfFacts, &instance) {
    let mut dependencies = List<Dependency>.make()
    let answer = match move run rawMirAnswer(&mut resolver.*, &mut owner.*, &mut dependencies, &instance, observing, &selfFacts, false) {
      Option<Shared<Result<Answer, NoRejection>>>.Some {value} => move value
      Option<Shared<Result<Answer, NoRejection>>>.None => { return CompilerBug.panic(b"a source MIR instance has no location") }
    }
    if let Option<Shared<Rejection>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
      return run memberRejected(move value, move dependencies)
    }
    if let Option<Shared<BackendGap>>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<BackendGap>>>(&answer, answerBackendGap) {
      return memberSuccess(Value.Unsupported {gap: move value}, move dependencies)
    }
    if let Option<CanonicalizationFailure>.Some {value} = move Shared<Result<Answer, NoRejection>>.with<Option<CanonicalizationFailure>>(&answer, answerCanonicalizationFailure) {
      return memberSuccess(Value.CanonicalizationFailed {reason: value}, move dependencies)
    }
    let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, answerMirIndex) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return CompilerBug.panic(b"a raw MIR answer has no lowering outcome") }
    }
    let construction = Shared<Result<Answer, NoRejection>>.with<bool>(&answer, answerMirConstruction)
    // Synthetic producers have no source-body inlining tail, and bodies with no direct instance
    // calls reuse the raw MIR directly without copying.
    if !construction || !mayInlineAnyCall(&resolver.*, index) {
      return memberSuccess(Value.Mir {index: index, construction: construction}, move dependencies)
    }
    let mut function = run MirInline.copy(&List<MirFunction>.asSlice(&resolver.mirValues)[index])
    run inlineCalls(&mut resolver.*, &mut owner.*, &mut dependencies, &mut function, &selfFacts, observing)
    let copied = List<MirFunction>.length(&resolver.mirValues)
    let stored = run storeMir(&mut resolver.*, &mut owner.*, move function, move dependencies, false)
    while List<bool>.length(&resolver.splicedCopies) <= copied { run List<bool>.append(&mut resolver.*.splicedCopies, false) }
    List<bool>.set(&mut resolver.*.splicedCopies, copied, true)
    return move stored
  }
  let module = resolvedModule(&resolver.*, key.module)
  let declarationAccess182 = declarationPosition(&resolver.*, key)
  let declared = run declarationAt(&mut resolver.*, &module, declarationAccess182)
  let identity = match move declared {
    Option<DeclarationId>.Some {value} => run Types.internDeclaration(move value)
    Option<DeclarationId>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Undetermined,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        List<Dependency>.make(),
      )
    }
  }
  let dispatch = operationDispatch(&instance)
  let mutableMembers = dispatch == OperationDispatch.Erased && List<BackendInstance>.asSlice(&resolver.backendInstances)[key.name].checkSet == usize.MAX
  if mutableMembers { run recordMembership(&mut resolver.*, &instance) }
  if mutableMembers && !resolver.closedErasures && !DeclarationId.isAmbientOperation(&DeclarationId.copyShared(&identity)) {
    return memberSuccess(run dispatchGap(GapCode.WitnessOperand, &identity), List<Dependency>.make())
  }
  if dispatch == OperationDispatch.Union || dispatch == OperationDispatch.Erased {
    return run resolveUnionDispatchMir(&mut resolver.*, &mut owner.*, key, move instance, &identity, observing)
  }
  // Typed origins count from the declaration's anchor; MIR keeps them relative and reads them
  // back against it only for a diagnostic, a gap or an observed trap label.
  let declarationAccess183 = declarationPosition(&resolver.*, key)
  let anchor = match move run positionAnchor(&mut resolver.*, &module, declarationAccess183) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {
      return run memberRejected(
        run reject(&resolver.*, &module, RejectionCode.Undetermined, Span.make(usize.ZERO, usize.ZERO)),
        List<Dependency>.make(),
      )
    }
  }
  let mut dependencies = List<Dependency>.make()
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Signature,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: usize.ZERO,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let failure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &signature,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move failure {
    let code = Shared<Rejection>.with<RejectionCode>(
      &value,
      |rejection: &Rejection| -> RejectionCode {
        return rejection.code
      },
    )
    let mut coverageGap = BackendGap.forRejection(code)
    if code == RejectionCode.Undetermined { coverageGap = Option<GapCode>.some(GapCode.SignatureForm) }
    if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.fromRejection(gapCode, &identity, &value)),
        },
        move dependencies,
      )
    }
    return run memberRejected(move value, move dependencies)
  }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(
    &signature,
    signatureResult,
  )
  let mut result = match move selected {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(
            BackendGap.make(GapCode.SignatureForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
  }
  let declarationAccess184 = declarationPosition(&resolver.*, key)
  let written = run signatureSyntax(&mut resolver.*, &module, declarationAccess184)
  if let Option<WrittenSignature>.Some {value} = move written {
    if value.isStatic {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(
            BackendGap.make(GapCode.StaticResidualization, &identity, value.span),
          ),
        },
        move dependencies,
      )
    }
  }
  let declarationAccess185 = declarationPosition(&resolver.*, key)
  let selectedHeader = run header(&mut resolver.*, &module, declarationAccess185)
  let mut linked = false
  if let Option<HeaderSyntax>.Some {value: syntax} = move selectedHeader {
    if let Node.FunctionHeader {linkage, ..} = syntax.header { linked = linkage.present }
  }
  // Each instance of a generic export is lowered with its own C thunk (FFI-012).
  let mut thunked = false
  if linked {
    let declarationAccess186 = declarationPosition(&resolver.*, key)
    let foreign = run foreignHeader(&mut resolver.*, &module, declarationAccess186)
    thunked = foreign.generic
    // An import's definition is C code, so it has no MIR; only a refused header reaches here.
    if !foreign.exported {
      if let Option<HeaderConflict>.Some {value: conflict} = &foreign.refusal {
        return run mirRejection(&identity, run headerRejection(&module, &conflict), move dependencies)
      }
      return CompilerBug.panic(b"MIR was demanded for a C import, whose definition is C code")
    }
    if let Option<Arc<Bytes>>.Some {value: symbol} = move InstanceKey.exportSymbol(&instance) {
      return run exportShim(&mut resolver.*, &mut owner.*, move dependencies, &identity, key, &symbol, move foreign, observing)
    }
    // The exported definition's own body lowers below like any ordinary function.
  }
  if key.member == exportMember() {
    return run memberRejected(
      run reject(&resolver.*, &module, RejectionCode.Undetermined, Span.make(usize.ZERO, usize.ZERO)),
      move dependencies,
    )
  }
  // A function with static work lowers the selected body for this application, never an
  // abstract all-arms body. Ordinary closures (literalKind) whose own body and enclosing
  // declarations need no static residualization reuse their shared Family.Body(member=0) across
  // all monomorphized instantiations instead of re-running Body checking per type argument.
  let declarationAccess187 = declarationPosition(&resolver.*, key)
  let routing = run needsStaticResidualization(
    &mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, declarationAccess187,
  )
  let mut bodyMember = usize.ZERO
  match move routing {
    Result<bool, Shared<Rejection>>.Success {value: routed} => {
      let mut needsSelected = routed
      if !needsSelected && Interned<DeclarationId>.with<bool>(&identity, literalKind) {
        let application = run InstanceKey.selected(&instance)
        if Application.hasStatics(&application) {
          needsSelected = true
        } else {
          // Walk enclosing parent chain in this module to check if any enclosing declaration
          // needs static residualization (e.g. a closure inside a generic `static if`/`static for`).
          let mut cur = declarationAccess187
          let mut parentChain = List<usize>.make()
          let srcAns = run observedDeclaration(&mut resolver.*, &module, declarationAccess187, SourceFacet.Header)
          if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &srcAns, &module) {
            let decls = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
            while cur < decls.length {
              if let Option<usize>.Some {value: p} = &decls[cur].parent {
                let pKind = DeclarationId.kind(&decls[p].identity)
                if pKind == OwnerKind.Implementation || pKind == OwnerKind.Interface || serviceKind(pKind) { break }
                run List<usize>.append(&mut parentChain, p)
                cur = p
              } else { break }
            }
          }
          let parents = List<usize>.asSlice(&parentChain)
          let mut pi = usize.ZERO
          while pi < parents.length && !needsSelected {
            let pRouting = run needsStaticResidualization(
              &mut resolver.*, &mut owner.*, &mut dependencies, &module, key.module, parents[pi],
            )
            match move pRouting {
              Result<bool, Shared<Rejection>>.Success {value: pRouted} => { if pRouted { needsSelected = true } }
              Result<bool, Shared<Rejection>>.Failure {error} => {
                return run mirRejection(&identity, move error, move dependencies)
              }
            }
            pi = pi + usize.ONE
          }
        }
      }
      if needsSelected {
        let application = run InstanceKey.selected(&instance)
        let interned = run internSelectedApplication(&mut resolver.*, &application)
        bodyMember = interned + usize.ONE
      }
    }
    Result<bool, Shared<Rejection>>.Failure {error} => {
      return run mirRejection(&identity, move error, move dependencies)
    }
  }
  let bodyAnswer = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies,
    Key {
      family: Family.Body,
      module: key.module,
      name: usize.ZERO,
      declaration: key.declaration,
      member: bodyMember,
      external: false,
    },
    Span.make(usize.ZERO, usize.ZERO),
  )
  let bodyFailure = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    &bodyAnswer,
    answerCause,
  )
  if let Option<Shared<Rejection>>.Some {value} = move bodyFailure {
    let coverageGap = Shared<Rejection>.with<Option<GapCode>>(&value, |rejection: &Rejection| -> Option<GapCode> {
      return BackendGap.forRejection(rejection.code)
    })
    if let Option<GapCode>.Some {value: gapCode} = move coverageGap {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.fromRejection(gapCode, &identity, &value)),
        },
        move dependencies,
      )
    }
    let unsupported = Shared<Rejection>.with<bool>(
      &value,
      |rejection: &Rejection| -> bool {
        return rejection.code == RejectionCode.Undetermined
      },
    )
    if unsupported {
      let span = Shared<Rejection>.with<Span>(
        &value,
        |rejection: &Rejection| -> Span {
          return rejection.span
        },
      )
      let operationInputs = Shared<Rejection>.with<bool>(&value, |diagnostic: &Rejection| -> bool {
        return List<Interned<DeclarationId>>.length(&diagnostic.path) == usize.ONE
      })
      if operationInputs {
        let operation = Shared<Rejection>.with<Interned<DeclarationId>>(&value, |diagnostic: &Rejection| -> Interned<DeclarationId> {
          let path = List<Interned<DeclarationId>>.asSlice(&diagnostic.path)
          return Interned<DeclarationId>.clone(&path[usize.ZERO])
        })
        let declared = DeclarationId.copyShared(&operation)
        let operationModule = DeclarationId.moduleId(&declared)
        let ordinal = run ordinalOfIdentity(&mut resolver.*, operationModule, &operation)
        if let Option<usize>.Some {value: at} = move ordinal {
          let parent = run enclosingIdentity(&mut resolver.*, operationModule, at)
          if let Option<DeclarationId>.Some {value: parentIdentity} = move parent {
            let parentKind = DeclarationId.kind(&parentIdentity)
            if parentKind == OwnerKind.Interface || serviceKind(parentKind) {
              return memberSuccess(Value.Unsupported {
                gap: run Shared<BackendGap>.make(BackendGap.fromRejection(GapCode.GenericOperation, &identity, &value)),
              }, move dependencies)
            }
          }
        }
      }
      let authoredOrdinal = rejectionModuleOrdinal(&resolver.*, &value)
      if authoredOrdinal == usize.MAX { return run memberRejected(move value, move dependencies) }
      let authoredModule = resolvedModule(&resolver.*, authoredOrdinal)
      let sourceAnswer = run source(&mut resolver.*, &authoredModule)
      let coverage = match move sourceOf(&resolver.*, &sourceAnswer, &authoredModule) {
        Option<&IndexedSource>.Some {value: indexed} => bodyCoverageGap(
          IndexedSource.authored(indexed),
          span,
        )
        Option<&IndexedSource>.None => {
          return run memberRejected(
            run reject(&resolver.*, &authoredModule, RejectionCode.MissingModule, span),
            move dependencies,
          )
        }
      }
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(BackendGap.fromRejection(coverage, &identity, &value)),
        },
        move dependencies,
      )
    }
    return run memberRejected(move value, move dependencies)
  }
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &bodyAnswer,
    answerTypedBody,
  )
  let checkedBody = match move body {
    Option<Shared<TypedBody>>.Some {value} => move value
    Option<Shared<TypedBody>>.None => {
      return memberSuccess(
        Value.Unsupported {
          gap: run Shared<BackendGap>.make(
            BackendGap.make(GapCode.TypedForm, &identity, Span.make(usize.ZERO, usize.ZERO)),
          ),
        },
        move dependencies,
      )
    }
  }
  let hasEnvironment = Shared<TypedBody>.with<bool>(&checkedBody, |value: &TypedBody| -> bool {
    let environment = TypedBody.environmentOf(value)
    return match &environment.* { Option<BodyEnvironment>.Some {..} => true _ => false }
  })
  let typed = move checkedBody
  // Resolve checked call targets before borrowing the caller's authored HIR. Proof queries
  // are MIR children, while target bodies remain deferred to the admitted instance worklist.
  let callerApplication = run InstanceKey.selected(&instance)
  if Interned<Type>.with<bool>(&result, rawCallableType) {
    result = match move run callableResultType(&mut resolver.*, &mut owner.*, &mut dependencies,
      &callerApplication, List<Constraint>.asSlice(&List<Constraint>.make()), Span.make(usize.ZERO, usize.ZERO)) {
      Result<Interned<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Interned<Type>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
    }
  }
  let callerBindings = run Application.bindings(&callerApplication)
  // Runtime lanes only: a static parameter's value is part of the instance key, not an operand.
  let mut parameters = List<Interned<Type>>.make()
  if hasEnvironment {
    run List<Interned<Type>>.append(&mut parameters, Shared<TypedBody>.with<Interned<Type>>(&typed, |value: &TypedBody| -> Interned<Type> {
      let locals = TypedBody.localSlice(value)
      return Interned<Type>.clone(&locals[usize.ZERO].ty)
    }))
  }
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  let staticCount = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureStaticCount)
  let staticSlots = run signatureStaticSlots(&signature, staticCount)
  let mut at = usize.ZERO
  while at < count {
    if !isStaticIndex(List<usize>.asSlice(&staticSlots), at) {
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(
        &signature,
        |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> {
          return signatureParameterAt(answer, at)
        },
      )
      if let Option<Interned<Type>>.Some {value} = move selected {
        run List<Interned<Type>>.append(&mut parameters, move value)
      }
    }
    at = at + usize.ONE
  }
  let projections = match move run runtimeProjections(&mut resolver.*, &mut owner.*, &mut dependencies,
    &callerApplication, List<Binding>.asSlice(&callerBindings), &typed, &result, List<Interned<Type>>.asSlice(&parameters), &anchor) {
    Result<List<RuntimeProjection>, Shared<Rejection>>.Success {value} => move value
    Result<List<RuntimeProjection>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let storageProjection = List<RuntimeProjection>.asSlice(&projections)
  let own = run instanceProviders(&instance)
  let premiseCount = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureConstraintCount)
  let mut premises = List<Constraint>.make()
  let mut premiseAt = usize.ZERO
  while premiseAt < premiseCount {
    let premise = Shared<Result<Answer, NoRejection>>.with<Option<Constraint>>(&signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Constraint> { return signatureConstraint(answer, premiseAt) })
    if let Option<Constraint>.Some {value} = move premise { run List<Constraint>.append(&mut premises, move value) }
    premiseAt = premiseAt + usize.ONE
  }
  let needs = match move run cleanupNeeds(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, List<Binding>.asSlice(&callerBindings),
    storageProjection, List<Constraint>.asSlice(&premises), &anchor) {
    Result<CleanupNeeds, Shared<Rejection>>.Success {value} => move value
    Result<CleanupNeeds, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let mut calls = List<MirCallTarget>.make()
  let mut plans = List<MirNodePlan>.make()
  let mut ambientKeys = List<u64>.make()
  let mut storage = List<MirStoragePlan>.make()
  let mut usesAmbientHeader = false
  let mut carriers = List<MirCarrierPlan>.make()
  let mut witnessIntrinsics = List<MirWitnessIntrinsic>.make()
  let reachedCalls = run MirFunction.callNodes(&typed)
  let callNodes = List<BodyNodeId>.asSlice(&reachedCalls)
  let mut callAt = usize.ZERO
  let mut callRequest = Request.make()
  while callAt < callNodes.length {
    let node = callNodes[callAt]
    if let Option<StorageOperation>.Some {value: operation} = move TypedBody.storageOperation(&typed, node) {
      if operation == StorageOperation.ExecutionFromAllocation || operation == StorageOperation.ExecutionDrive { usesAmbientHeader = true }
      let site = Shared<TypedBody>.with<Span>(&typed, |value: &TypedBody| -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) })
      match move run storagePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, operation, &callerApplication,
        List<Binding>.asSlice(&callerBindings), storageProjection, &identity, List<ProviderEntry>.asSlice(&own), &module, site, &anchor) {
        Result<MirStoragePlan, PreparationFailure>.Success {value} => { run List<MirStoragePlan>.append(&mut storage, move value) }
        Result<MirStoragePlan, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, site, move error, move dependencies)
        }
      }
    }
    let direct = TypedBody.directApplication(&typed, node)
    if let Option<Interned<Application>>.Some {value: recordedApplication} = move direct {
      let recorded = run Application.copyShared(&recordedApplication)
      let closed = run Application.substitute(&recorded, &callerApplication)
      let mut operands = List<MirCallOperand>.make()
      let mut at = usize.ZERO
      while true {
        let selected = TypedBody.callArgument(&typed, node, at)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { break } }
        let ty = run RuntimeType.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), storageProjection)
        run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: Interned<Type>.clone(&ty), parameter: move ty, borrow: Option<Access>.none()})
        at = at + usize.ONE
      }
      let calleeKey = match move run InstanceKey.function(run Application.copy(&closed)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return run preparationAnswer(&resolver.*, &identity, &module,
            Shared<TypedBody>.with<Span>(&typed, |value: &TypedBody| -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) }),
            PreparationFailure.Canonicalization {reason: reason}, move dependencies)
        }
      }
      run List<MirCallTarget>.append(&mut calls, MirCallTarget {
        node: node, receiverDereferences: usize.ZERO, key: move calleeKey, application: move closed, edge: Edge.Direct, operands: move operands,
        stored: Option<MirStoredArguments>.none(), providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(),
        witnessFailure: Option<Interned<Type>>.none(), promise: CallPromise.Unrestricted, vacuous: false, returned: Option<Interned<Type>>.none(),
      })
    }
    // An addressed instantiation of a generic export is closed like a call's: its instance is the
    // creator of the thunk whose address the node takes.
    if let Option<Interned<Application>>.Some {value: addressed} = move TypedBody.addressedApplication(&typed, node) {
      let recorded = run Application.copyShared(&addressed)
      let closed = run Application.substitute(&recorded, &callerApplication)
      let addressedKey = match move run InstanceKey.function(run Application.copy(&closed)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return run preparationAnswer(&resolver.*, &identity, &module,
            Shared<TypedBody>.with<Span>(&typed, |value: &TypedBody| -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) }),
            PreparationFailure.Canonicalization {reason: reason}, move dependencies)
        }
      }
      run List<MirCallTarget>.append(&mut calls, MirCallTarget {
        node: node, receiverDereferences: usize.ZERO, key: move addressedKey, application: move closed, edge: Edge.Direct,
        operands: List<MirCallOperand>.make(),
        stored: Option<MirStoredArguments>.none(), providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(),
        witnessFailure: Option<Interned<Type>>.none(), promise: CallPromise.Unrestricted, vacuous: false, returned: Option<Interned<Type>>.none(),
      })
    }
    // A stored Effect runs through its exact representation's runner, like a callable with no new
    // arguments: its environment supplies the stored arguments or the block's captures (D1).
    let stored = TypedBody.runOperand(&typed, node)
    let mut composed = Option<RunOperand>.none()
    let mut plain = Option<RunOperand>.none()
    if let Option<RunOperand>.Some {value: operand} = move stored {
      let closed = run Type.applyBindings(&operand.receiver, List<Binding>.asSlice(&callerBindings), true)
      if Interned<Type>.with<bool>(&closed, compositeType) { composed = Option<RunOperand>.some(move operand) }
      else { plain = Option<RunOperand>.some(move operand) }
    }
    // A composed Effect expands at its run site through a prepared plan of ordinary targets (D4).
    if let Option<RunOperand>.Some {value: operand} = move composed {
      let closed = run Type.applyBindings(&operand.receiver, List<Binding>.asSlice(&callerBindings), true)
      let mut steps = List<MirRunPlan>.make()
      let mut bound = List<BoundProvider>.make()
      let prepared = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, &callerApplication,
        List<Binding>.asSlice(&callerBindings), storageProjection, &identity, &closed, operand.origin, List<ProviderEntry>.asSlice(&own),
        &mut bound, &module, &mut steps, &anchor)
      match move prepared {
        Result<usize, PreparationFailure>.Success {..} => { run List<MirNodePlan>.append(&mut plans, MirNodePlan {node: node, steps: move steps}) }
        Result<usize, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(operand.origin, &anchor), move error, move dependencies)
        }
      }
    }
    if let Option<RunOperand>.Some {value: operand} = move plain {
      let mode = Interned<Type>.with<CallableMode>(&operand.receiver, callableInvocationMode)
      let inputs = CallableCallInputs {receiver: move operand.receiver, inference: Interned<DeclarationId>.clone(&identity),
        bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: mode, callee: operand.callee,
        result: move operand.result, count: usize.ZERO, origin: operand.origin}
      let none = List<Interned<Type>>.make()
      let selected = run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node,
        &callerApplication, List<Binding>.asSlice(&callerBindings), storageProjection, move inputs, List<Interned<Type>>.asSlice(&none), &anchor)
      match move selected {
        Result<MirCallTarget, PreparationFailure>.Success {value} => { run List<MirCallTarget>.append(&mut calls, move value) }
        Result<MirCallTarget, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, Shared<TypedBody>.with<Span>(&typed, |value: &TypedBody| -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) }), move error, move dependencies)
        }
      }
    }
    let callable = TypedBody.callableCall(&typed, node)
    if let Option<CallableCallInputs>.Some {value: inputs} = move callable {
      if Interned<Type>.with<bool>(&inputs.receiver, nativeFunctionPointer) {
        callAt = callAt + usize.ONE
        continue
      }
      let mut written = List<Interned<Type>>.make()
      let mut writtenAt = usize.ZERO
      while writtenAt < inputs.count {
        let selectedArgument = TypedBody.callArgument(&typed, node, writtenAt)
        let argument = match move selectedArgument { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        run List<Interned<Type>>.append(&mut written, run Type.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), true))
        writtenAt = writtenAt + usize.ONE
      }
      let selected = run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node,
        &callerApplication, List<Binding>.asSlice(&callerBindings), storageProjection, move inputs, List<Interned<Type>>.asSlice(&written), &anchor)
      match move selected {
        Result<MirCallTarget, PreparationFailure>.Success {value} => {
          let returnedEffect = match &value.returned {
            Option<Interned<Type>>.Some {value: promisedEffect} => Option<Interned<Type>>.some(Interned<Type>.clone(&promisedEffect))
            Option<Interned<Type>>.None => Option<Interned<Type>>.none()
          }
          run List<MirCallTarget>.append(&mut calls, move value)
          // A run of an ordinary callee's call executes the Effect it returned, as a run of any
          // returned Effect does (EFF-005): through a prepared plan or its representation's runner.
          if let Option<Interned<Type>>.Some {value: promisedEffect} = move returnedEffect {
            if let Option<ImmediateRun>.Some {value: immediate} = move immediateRunOf(&typed, node) {
              let ImmediateRun {node: runNode, operand} = move immediate
              if Interned<Type>.with<bool>(&promisedEffect, compositeType) {
                let mut steps = List<MirRunPlan>.make()
                let mut bound = List<BoundProvider>.make()
                let prepared = run compositePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, runNode, &callerApplication,
                  List<Binding>.asSlice(&callerBindings), storageProjection, &identity, &promisedEffect, operand.origin, List<ProviderEntry>.asSlice(&own),
                  &mut bound, &module, &mut steps, &anchor)
                match move prepared {
                  Result<usize, PreparationFailure>.Success {..} => { run List<MirNodePlan>.append(&mut plans, MirNodePlan {node: runNode, steps: move steps}) }
                  Result<usize, PreparationFailure>.Failure {error} => {
                    return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(operand.origin, &anchor), move error, move dependencies)
                  }
                }
              } else {
                let runInputs = CallableCallInputs {receiver: Interned<Type>.clone(&promisedEffect), inference: Interned<DeclarationId>.clone(&identity),
                  bindings: run Shared<List<Binding>>.make(List<Binding>.make()), mode: Interned<Type>.with<CallableMode>(&promisedEffect, callableInvocationMode),
                  callee: node, result: move operand.result, count: usize.ZERO, origin: operand.origin}
                let none = List<Interned<Type>>.make()
                match move run concreteCallableCall(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, runNode,
                  &callerApplication, List<Binding>.asSlice(&callerBindings), storageProjection, move runInputs, List<Interned<Type>>.asSlice(&none), &anchor) {
                  Result<MirCallTarget, PreparationFailure>.Success {value: runner} => { run List<MirCallTarget>.append(&mut calls, move runner) }
                  Result<MirCallTarget, PreparationFailure>.Failure {error} => {
                    return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(operand.origin, &anchor), move error, move dependencies)
                  }
                }
              }
            }
          }
        }
        Result<MirCallTarget, PreparationFailure>.Failure {error} => {
          return run preparationAnswer(&resolver.*, &identity, &module, Shared<TypedBody>.with<Span>(&typed, |value: &TypedBody| -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[node.index].origin, &anchor) }), move error, move dependencies)
        }
      }
    }
    // A checked scalar operation invokes exactly one of its carriers.
    if let Option<IntrinsicCallInputs>.Some {value: intrinsic} = move TypedBody.intrinsicCall(&typed, node) {
      if intrinsicIsPrimitive(intrinsic.member, IntrinsicPrimitive.AmbientEntry) {
        run observeAmbientServices(&mut resolver.*, &module)
        if resolver.closedErasures && List<u64>.length(&ambientKeys) == usize.ZERO {
          run List<u64>.appendSlice(&mut ambientKeys, ErasureIndex.ambientServices(currentErasures(&resolver.*)))
        }
      }
      if let IntrinsicMember.Scalar {operation} = intrinsic.member {
        if ScalarOperation.checked(operation) {
          let prepared = run carrierPlan(&mut resolver.*, &mut owner.*, &mut dependencies, &typed, node, &callerApplication,
            List<Binding>.asSlice(&callerBindings), storageProjection, &identity, operation, &intrinsic.result,
            List<ProviderEntry>.asSlice(&own), &module, &anchor)
          match move prepared {
            Result<MirCarrierPlan, PreparationFailure>.Success {value} => { run List<MirCarrierPlan>.append(&mut carriers, move value) }
            Result<MirCarrierPlan, PreparationFailure>.Failure {error} => {
              return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(intrinsic.origin, &anchor), move error, move dependencies)
            }
          }
        }
      }
    }
    let selectedCall = TypedBody.interfaceCall(&typed, node)
    // A stored `effect fn` interface construction calls nothing here: its type is the selected
    // witness's exact Effect, and a later run calls that runner (EFF-001).
    let constructedHere = Shared<TypedBody>.with<bool>(&typed, |value: &TypedBody| -> bool { return storedInterfaceEffect(value, node) })
    if let Option<InterfaceCallInputs>.Some {value: inputs} = move selectedCall {
      if constructedHere {
        callAt = callAt + usize.ONE
        continue
      }
      let operation = DeclarationId.copyShared(&inputs.operation)
      let contract = run Type.applyBindings(&inputs.contract, List<Binding>.asSlice(&callerBindings), true)
      let provider = run Type.applyBindings(&inputs.provider, List<Binding>.asSlice(&callerBindings), true)
      let count = Shared<List<Binding>>.with<usize>(&inputs.bindings, |values: &List<Binding>| -> usize { return List<Binding>.length(values) })
      let mut invocation = List<Binding>.make()
      let mut bindingAt = usize.ZERO
      while bindingAt < count {
        let recorded = Shared<List<Binding>>.with<Binding>(&inputs.bindings, |values: &List<Binding>| -> Binding {
          let entries = List<Binding>.asSlice(values)
          return Binding {declaration: Interned<DeclarationId>.clone(&entries[bindingAt].declaration),
            ordinal: entries[bindingAt].ordinal, value: Argument.copy(&entries[bindingAt].value)}
        })
        run List<Binding>.append(&mut invocation, Binding {declaration: move recorded.declaration, ordinal: recorded.ordinal,
          value: run Argument.applyBindings(&recorded.value, List<Binding>.asSlice(&callerBindings), true)})
        bindingAt = bindingAt + usize.ONE
      }
      let mut actualArguments = List<Interned<Type>>.make()
      let mut actualLoans = List<WitnessLoan>.make()
      // A static operand is part of the witness's instance key, never a runtime operand; its
      // parameter position still takes a place among the witness's operands.
      let operationStatics = run copySharedStaticSlots(&inputs.statics)
      let staticOrdinals = List<StaticSlot>.asSlice(&operationStatics)
      let mut runtimeAt = usize.ZERO
      let mut at = usize.ZERO
      while at < inputs.count + staticOrdinals.length {
        if staticSlotAt(staticOrdinals, at) != usize.MAX {
          run List<Interned<Type>>.append(&mut actualArguments, run Types.intern(Type.Unit))
          run List<WitnessLoan>.append(&mut actualLoans, WitnessLoan {region: Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Static))})
          at = at + usize.ONE
          continue
        }
        let selected = TypedBody.callArgument(&typed, node, runtimeAt)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        run List<Interned<Type>>.append(&mut actualArguments, run Type.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), true))
        run List<WitnessLoan>.append(&mut actualLoans, WitnessLoan {region: Option<Interned<Lifetime>>.some(run Types.internLifetime(Lifetime.Local {
          declaration: DeclarationId.copy(Application.bodyDeclaration(&callerApplication)), ordinal: argument.origin.node, binder: usize.MAX}))})
        runtimeAt = runtimeAt + usize.ONE
        at = at + usize.ONE
      }
      let recipe = WitnessRecipe {operation: run Types.internDeclaration(move operation), contract: move contract, provider: move provider,
        result: Interned<Type>.clone(&inputs.result), bindings: run Shared<List<Binding>>.make(move invocation),
        arguments: run Shared<List<Interned<Type>>>.make(move actualArguments), loans: run Shared<List<WitnessLoan>>.make(move actualLoans), constructs: false}
      // A scalar intrinsic witness lowers in place over the call's operands; it calls no instance.
      let recipeOperation = DeclarationId.copyShared(&recipe.operation)
      let intrinsicWitness = run resolveWitnessIntrinsic(&mut resolver.*, &mut owner.*, &mut callRequest, &mut dependencies,
        &recipe.contract, &recipe.provider, &recipeOperation, &module, BodyOrigin.span(inputs.origin, &anchor))
      if let Option<IntrinsicMember>.Some {value: member} = move intrinsicWitness {
        let mut admitted = inputs.count == intrinsicArity(member)
        at = usize.ZERO
        while admitted && at < inputs.count {
          let selected = TypedBody.callArgument(&typed, node, at)
          let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
          let actual = run RuntimeType.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), storageProjection)
          admitted = match move intrinsicParameterKind(member, at) {
            Option<IntrinsicValueKind>.Some {value: kind} => Interned<Type>.with<bool>(&actual, |value: &Type| -> bool { return intrinsicMatches(kind, value) })
            Option<IntrinsicValueKind>.None => false
          }
          at = at + usize.ONE
        }
        if admitted {
          let expected = run RuntimeType.applyBindings(&inputs.result, List<Binding>.asSlice(&callerBindings), storageProjection)
          admitted = match move intrinsicResultKind(member) {
            Option<IntrinsicValueKind>.Some {value: kind} => Interned<Type>.with<bool>(&expected, |value: &Type| -> bool { return intrinsicMatches(kind, value) })
            Option<IntrinsicValueKind>.None => false
          }
        }
        if !admitted {
          return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
        }
        run List<MirWitnessIntrinsic>.append(&mut witnessIntrinsics, MirWitnessIntrinsic {node: node, member: member})
        callAt = callAt + usize.ONE
        continue
      }
      let witness = match move run completedWitnessApplication(&mut resolver.*, &mut owner.*, &mut callRequest,
        &mut dependencies, &recipe, &module, BodyOrigin.span(inputs.origin, &anchor)) {
        Result<ResolvedWitness, Shared<Rejection>>.Success {value} => move value
        Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
      }
      let mut selectedWitness = run Application.copy(&witness.application)
      // The witness's static slots take the operation's static values in order; only its runtime
      // operands pass at the call.
      let mut runtimePasses = List<OperandPass>.make()
      let allPasses = List<OperandPass>.asSlice(&witness.operands)
      at = usize.ZERO
      while at < allPasses.length {
        if staticSlotAt(staticOrdinals, at) == usize.MAX { run List<OperandPass>.append(&mut runtimePasses, allPasses[at]) }
        at = at + usize.ONE
      }
      let mut witnessStatics = List<usize>.make()
      if staticOrdinals.length > usize.ZERO {
        let witnessIdentity = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(&selectedWitness)))
        let witnessLocation = match move run locationOfIdentity(&mut resolver.*, &witnessIdentity) {
          Option<InstanceLocation>.Some {value} => value
          Option<InstanceLocation>.None => { fail InvalidModulePath {} }
        }
        let witnessSignatureRequest = Key {family: Family.Signature, module: witnessLocation.module, name: usize.ZERO,
          declaration: witnessLocation.declaration, member: usize.ZERO, external: false}
        let witnessSignatureKey = run internDeclaration(&mut resolver.*, witnessSignatureRequest)
        let witnessSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, witnessSignatureKey, BodyOrigin.span(inputs.origin, &anchor))
        let witnessCount = Shared<Result<Answer, NoRejection>>.with<usize>(&witnessSignature, signatureStaticCount)
        witnessStatics = run signatureStaticSlots(&witnessSignature, witnessCount)
        let slots = List<usize>.asSlice(&witnessStatics)
        if slots.length != staticOrdinals.length {
          return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
        }
        let mut statics = run List<StaticSlot>.makeWithCapacity(slots.length)
        let mut staticAt = usize.ZERO
        while staticAt < slots.length {
          run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: slots[staticAt], value: StaticValue.copy(&staticOrdinals[staticAt].value)})
          staticAt = staticAt + usize.ONE
        }
        selectedWitness.statics = move statics
      }
      let application = &selectedWitness
      let passes = List<OperandPass>.asSlice(&runtimePasses)
      let targetBindings = run Application.bindings(application)
      let targetKey = match move run InstanceKey.function(run Application.copy(application)) {
        Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
        Result<InstanceKey, CanonicalizationFailure>.Failure {error: reason} => {
          return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(inputs.origin, &anchor),
            PreparationFailure.Canonicalization {reason: reason}, move dependencies)
        }
      }
      let targetLocation = run locationOfInstance(&mut resolver.*, &targetKey)
      let location = match move targetLocation { Option<InstanceLocation>.Some {value} => value _ => { fail InvalidModulePath {} } }
      let declarationAccess188Request = Key {family: Family.Signature, module: location.module, name: usize.ZERO, declaration: location.declaration, member: usize.ZERO, external: false}
      let declarationAccess188 = run internDeclaration(&mut resolver.*, declarationAccess188Request)
      let targetSignature = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies,
        declarationAccess188, BodyOrigin.span(inputs.origin, &anchor))
      let facts = Shared<Result<Answer, NoRejection>>.with<Option<SignatureFacts>>(&targetSignature, signatureFacts)
      let target = match move facts { Option<SignatureFacts>.Some {value} => move value _ => { return memberSuccess(Value.Unsupported {
        gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.SignatureForm, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies) } }
      let mut promisedResult = Interned<Type>.clone(&inputs.result)
      let mut witnessFailure = Option<Interned<Type>>.none()
      // An `effect fn` witness runs as the one call its enclosing `run` executes (Effect note D1).
      // That call's failure edge is typed by the witness's own declared failure, which EFF-009
      // bounds by the promised one (D3).
      if target.isEffect {
        let promised = match move Interned<Type>.with<Option<EffectChannels>>(&inputs.result, effectChannels) {
          Option<EffectChannels>.Some {value} => move value
          Option<EffectChannels>.None => CompilerBug.panic(b"an effect fn witness serves an operation whose result is not an Effect")
        }
        witnessFailure = Option<Interned<Type>>.some(run RuntimeType.applyBindings(&target.failure, List<Binding>.asSlice(&targetBindings),
          storageProjection))
        promisedResult = move promised.success
      }
      let expectedResult = run RuntimeType.applyBindings(&promisedResult, List<Binding>.asSlice(&callerBindings), storageProjection)
      let targetResult = match move run callableInvocationResult(&mut resolver.*, &mut owner.*, &mut dependencies,
        application, &target.result, List<Binding>.asSlice(&targetBindings), storageProjection, BodyOrigin.span(inputs.origin, &anchor)) {
        Result<Interned<Type>, PreparationFailure>.Success {value} => move value
        Result<Interned<Type>, PreparationFailure>.Failure {error} => { return run preparationAnswer(&resolver.*, &identity, &module, BodyOrigin.span(inputs.origin, &anchor), move error, move dependencies) }
      }
      if target.parameters != passes.length + List<usize>.length(&witnessStatics) || !run Type.runtimeEqualsShared(&expectedResult, &targetResult) {
        return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
      }
      // Header proof already established result/failure/row correspondence. This boundary
      // additionally guards concrete operand storage before any target-neutral call is emitted.
      let mut operands = List<MirCallOperand>.make()
      let witnessSlots = List<usize>.asSlice(&witnessStatics)
      let mut parameterAt = usize.ZERO
      at = usize.ZERO
      while at < passes.length {
        while isStaticIndex(witnessSlots, parameterAt) { parameterAt = parameterAt + usize.ONE }
        let selected = TypedBody.callArgument(&typed, node, at)
        let argument = match move selected { Option<CallArgument>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        let actual = run RuntimeType.applyBindings(&argument.ty, List<Binding>.asSlice(&callerBindings), storageProjection)
        let selectedParameter = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&targetSignature,
          |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> { return signatureParameter(answer, parameterAt) })
        parameterAt = parameterAt + usize.ONE
        let raw = match move selectedParameter { Option<Interned<Type>>.Some {value} => move value _ => { fail RevisionMismatch {} } }
        let parameter = run RuntimeType.applyBindings(&raw, List<Binding>.asSlice(&targetBindings), storageProjection)
        let mut borrow = Option<Access>.none()
        let mut compared = Interned<Type>.clone(&parameter)
        if let OperandPass.Borrow {access, ..} = &passes[at] {
          borrow = Option<Access>.some(access)
          compared = operandTarget(&parameter)
        }
        if !run Type.runtimeEqualsShared(&actual, &compared) {
          return memberSuccess(Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.WitnessOperand, &identity, BodyOrigin.span(inputs.origin, &anchor)))}, move dependencies)
        }
        run List<MirCallOperand>.append(&mut operands, MirCallOperand {value: move actual, parameter: move parameter, borrow: move borrow})
        at = at + usize.ONE
      }
      run List<MirCallTarget>.append(&mut calls, MirCallTarget {
        node: node, receiverDereferences: usize.ZERO, key: move targetKey, application: run Application.copy(application),
        edge: Edge.Witness, operands: move operands,
        stored: Option<MirStoredArguments>.none(), providers: List<MirProviderSource>.make(), dispatch: Option<MirProviderSource>.none(),
        witnessFailure: move witnessFailure, promise: CallPromise.Unrestricted, vacuous: false, returned: Option<Interned<Type>>.none(),
      })
    }
    callAt = callAt + usize.ONE
  }
  // Each callee's requirement row is served from this instance's own providers (D2 rule 1).
  let mut provided = List<MirCallTarget>.make()
  // Reversed once and popped in order: removing each from the front moved every call after it,
  // quadratic in the calls of a large body (a `static for` over thousands of fields).
  let mut queued = List<MirCallTarget>.make()
  while true {
    match move List<MirCallTarget>.pop(&mut calls) {
      Option<MirCallTarget>.Some {value} => { run List<MirCallTarget>.append(&mut queued, move value) }
      Option<MirCallTarget>.None => { break }
    }
  }
  while true {
    let pending = match move List<MirCallTarget>.pop(&mut queued) {
      Option<MirCallTarget>.Some {value} => move value
      Option<MirCallTarget>.None => { break }
    }
    let site = Shared<TypedBody>.with<Span>(&typed, |value: &TypedBody| -> Span { return BodyOrigin.span(TypedBody.nodeSlice(value)[pending.node.index].origin, &anchor) })
    if Shared<TypedBody>.with<bool>(&typed, |value: &TypedBody| -> bool { return constructedOnly(value, pending.node) }) {
      run List<MirCallTarget>.append(&mut provided, move pending)
      continue
    }
    let none = List<BoundProvider>.make()
    match move run provideCall(&mut resolver.*, &mut owner.*, &mut dependencies, move pending, List<ProviderEntry>.asSlice(&own),
      List<BoundProvider>.asSlice(&none), storageProjection, &module, site) {
      Result<MirCallTarget, PreparationFailure>.Success {value} => { run List<MirCallTarget>.append(&mut provided, move value) }
      Result<MirCallTarget, PreparationFailure>.Failure {error} => {
        return run preparationAnswer(&resolver.*, &identity, &module, site, move error, move dependencies)
      }
    }
  }
  let addresses = run providerAddresses(List<ProviderEntry>.asSlice(&own))
  let remainders = match move run partialRemainders(&mut resolver.*, &mut owner.*, &mut dependencies, &module, Application.bodyDeclaration(&callerApplication), &typed, List<Binding>.asSlice(&callerBindings), storageProjection, &anchor) {
    Result<List<Remainder>, Shared<Rejection>>.Success {value} => move value
    Result<List<Remainder>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let mut entry = run entryNonParking(&mut resolver.*, &mut owner.*, &mut dependencies, &callerApplication,
    List<Binding>.asSlice(&callerBindings), storageProjection)
  // A `@nonParking` function owes, at each call that enters it, the proof that it never parks.
  let entered = InstanceKey.identity(&instance)
  let ownBody = Interned<DeclarationId>.with<bool>(&entered, |id: &DeclarationId| -> bool {
    let kind = DeclarationId.kind(id)
    return kind != OwnerKind.Literal
  })
  if ownBody && run declarationNonParking(&mut resolver.*, &module, declarationAccess182) {
    let mut itself = List<InstanceKey>.make()
    run List<InstanceKey>.append(&mut itself, InstanceKey.copy(&instance))
    run List<MirNonParkingRun>.append(&mut entry, MirNonParkingRun {callees: move itself, glues: List<Interned<Type>>.make(),
      declarations: List<Interned<DeclarationId>>.make(), exact: true, origin: ParkOrigin.Entry})
  }
  let constants = match move run bodyConstantValues(&mut resolver.*, &mut owner.*, &mut dependencies, &typed) {
    Result<List<MirConstantValue>, Shared<Rejection>>.Success {value} => move value
    Result<List<MirConstantValue>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
  }
  let failureType = run signatureFailure(&signature)
  // Semantic declaration reads guard literals and types. Embedded site labels and debug
  // locations additionally read the declaration's internal trivia. A debug location is counted
  // from the anchor (`MirFunction.lines`), and so is a site label of a build with line tables
  // (`Mir.siteLabel`), so a body that only moves in its file reads what it read. Any other site
  // label names the line its anchor starts on, so its body reads the anchor's origin too.
  let bodyLines = moduleLines(&resolver.*, &module)
  let relativeSites = bodyLines && !resolver.direct
  let mut sourceAnswer = run demandSource(&mut resolver.*, &module)
  if (observing || bodyLines) && recordingUnit(&resolver.*) != usize.MAX {
    let loaded = move sourceAnswer
    sourceAnswer = run observedDeclarationIn(&mut resolver.*, &module, move loaded, declarationAccess183, SourceFacet.Layout)
    if observing && !relativeSites { drop run observedSource(&mut resolver.*, &module, SourceSelector.Origin {handle: key.declaration}) }
  }
  // Only an observing body names its sites, so only it reads which application reports are for.
  let mut packageRoot = Option<ModuleId>.none()
  if observing { packageRoot = run reportRoot(&resolver.*) }
  let mut ambientEnabled = false
  if usesAmbientHeader {
    ambientEnabled = (run ambientCount(&mut resolver.*, &module)) != usize.ZERO
  }
  let mut tracing = Option<MirTracePlan>.none()
  if ownBody {
    let mut clause = Option<TraceClause>.none()
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &sourceAnswer, &module) {
      let hir = IndexedSource.authored(indexed)
      if hir.hasTraceDirective {
        let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
        let local = &declarations[declarationAccess183]
        if let Option<HirId>.Some {value: directive} = Directives.find(hir, Directives.of(hir, local.local), DirectiveKind.Trace) {
          if let Node.FunctionHeader {contract, ..} = Module.node(hir, local.header) {
            if let Option<HirContract>.Some {value: contractData} = Module.contractOf(hir, contract) {
              if let Result<TraceClause, Span>.Success {value} = move run traceClause(hir, directive, contractData.parameters) {
                clause = Option<TraceClause>.some(move value)
              }
            }
          }
        }
      }
    }
    if let Option<TraceClause>.Some {value} = move clause {
      let site = value.span
      tracing = match move run tracePlan(&mut resolver.*, &mut owner.*, &mut dependencies, &identity, &module, move value,
        &anchor, &signature, &callerApplication, List<Binding>.asSlice(&callerBindings), storageProjection, &failureType, observing) {
        Result<Option<MirTracePlan>, Shared<Rejection>>.Success {value: plan} => move plan
        Result<Option<MirTracePlan>, Shared<Rejection>>.Failure {error} => { return run mirRejection(&identity, move error, move dependencies) }
      }
      if let Option<MirTracePlan>.Some {value: plan} = &tracing {
        let mut targets = List<InstanceKey>.make()
        run List<InstanceKey>.append(&mut targets, InstanceKey.copy(&plan.enter))
        run List<InstanceKey>.append(&mut targets, InstanceKey.copy(&plan.exit))
        run List<InstanceKey>.append(&mut targets, InstanceKey.copy(&plan.cancelled))
        let marked = List<InstanceKey>.asSlice(&plan.failed)
        let mut member = usize.ZERO
        while member < marked.length {
          run List<InstanceKey>.append(&mut targets, InstanceKey.copy(&marked[member]))
          member = member + usize.ONE
        }
        run List<MirNonParkingRun>.append(&mut entry, MirNonParkingRun {callees: move targets, glues: List<Interned<Type>>.make(),
          declarations: List<Interned<DeclarationId>>.make(), exact: true, origin: ParkOrigin.Trace {module: ModuleId.copy(&module), span: site, args: Interned<Type>.clone(&plan.args)}})
      }
    }
  }
  let mut elided = List<bool>.make()
  let mut removedBindings = List<usize>.make()
  if !inspecting && List<MirCallTarget>.length(&provided) != usize.ZERO {
    let candidates = run MirObservation.sites(&typed)
    let targets = List<MirCallTarget>.asSlice(&provided)
    let mut at = usize.ZERO
    while at < targets.length {
      let target = &targets[at]
      at = at + usize.ONE
      let site = match move MirObservation.site(&typed, &candidates, target.node, &needs) {
        Option<MirObservation.Site>.Some {value} => move value
        Option<MirObservation.Site>.None => { continue }
      }
      let selected = InstanceKey.identity(&target.key)
      let ordinal = identityModuleOrdinal(&resolver.*, &selected)
      if ordinal == usize.MAX { continue }
      let targetModule = resolvedModule(&resolver.*, ordinal)
      if !standardOwns(&resolver.*, &targetModule) { continue }
      let location = match move run locationOfInstance(&mut resolver.*, &target.key) {
        Option<InstanceLocation>.Some {value} => value
        Option<InstanceLocation>.None => { continue }
      }
      if !run declarationAlwaysInline(&mut resolver.*, &targetModule, location.declaration) { continue }
      if !resolver.closedErasures {
        // Discovery walks the original body, so every registration and obligation can be
        // found. Reconsider this caller once its selected providers are final.
        run observeAmbientExtent(&mut resolver.*)
        continue
      }
      if !run erasedInlineBody(&mut resolver.*, &mut owner.*, &mut dependencies, &target.key, observing) { continue }
      if let Option<Interned<Type>>.Some {value: ty} = &site.cleanup {
        let closed = run RuntimeType.applyBindings(&ty, List<Binding>.asSlice(&callerBindings), storageProjection)
        let sourceOwner = DeclarationId.copyShared(&identity)
        let glue = match move run InstanceKey.dropGlue(&closed, &sourceOwner) {
          Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: Option<InstanceKey>.Some {value}} => move value
          _ => { continue }
        }
        if !run erasedInlineBody(&mut resolver.*, &mut owner.*, &mut dependencies, &glue, observing) { continue }
      }
      while List<bool>.length(&elided) <= site.statement { run List<bool>.append(&mut elided, false) }
      List<bool>.set(&mut elided, site.statement, true)
      if site.local != usize.MAX { run List<usize>.append(&mut removedBindings, site.local) }
    }
    if candidates.hasDrops && List<usize>.length(&removedBindings) != usize.ZERO {
      let current = move elided
      elided = run MirObservation.elideDrops(&typed, &candidates, List<usize>.asSlice(&removedBindings), move current)
    }
  }
  let lowered = match move sourceOf(&resolver.*, &sourceAnswer, &module) {
    Option<&IndexedSource>.Some {value: indexed} => run Effect.result(
      MirFunction.lower(
        InstanceKey.copy(&instance),
        &typed,
        IndexedSource.authored(indexed),
        &result,
        &failureType,
        List<Interned<Type>>.asSlice(&parameters),
        List<Interned<Type>>.asSlice(&addresses),
        move provided,
        move elided,
        move plans,
        move storage,
        move carriers,
        move witnessIntrinsics,
        move remainders,
        move needs,
        move projections,
        SourceUnit.bytes(IndexedSource.sourceUnit(indexed)),
        &anchor,
        observing,
        ambientEnabled,
        move ambientKeys,
        bodyLines,
        relativeSites,
        moduleFastPath(&resolver.*, &module),
        move packageRoot,
        move suspending,
        move constants,
        move tracing,
      ),
    )
    Option<&IndexedSource>.None => {
      return run memberRejected(
        run reject(
          &resolver.*,
          &module,
          RejectionCode.Undetermined,
          Span.make(usize.ZERO, usize.ZERO),
        ),
        move dependencies,
      )
    }
  }
  let mut completed = match move lowered {
    Result<Lowered, BackendGap | CanonicalizationFailure | OutOfMemoryError>.Success {value} => move value
    Result<Lowered, BackendGap | CanonicalizationFailure | OutOfMemoryError>.Failure {error} => {
      // A body that did not lower names nothing; what it reports rests on the whole report root.
      if observing { run recordRequestInput(&mut resolver.*, &module, run Bytes.copy(b"selected-root")) }
      return match move error {
        BackendGap {code, owner: gapOwner, source} => memberSuccess(
          Value.Unsupported {
            gap: run Shared<BackendGap>.make(
              BackendGap.anchored(BackendGap {code: code, owner: move gapOwner, source: move source}, &anchor),
            ),
          },
          move dependencies,
        )
        CanonicalizationFailure reason => memberSuccess(
          Value.CanonicalizationFailed {reason: reason}, move dependencies)
        OutOfMemoryError {} => {
          fail OutOfMemoryError {}
        }
      }
    }
  }
  run MirObservation.removeBindings(&mut completed.function, List<usize>.asSlice(&removedBindings))
  run recordReportNames(&mut resolver.*, &module, List<ModuleId>.asSlice(&completed.named))
  run List<MirNonParkingRun>.appendList(&mut completed.function.nonParking, move entry)
  // A function with `features` compiles for them (SIMD-009).
  let listedFeatures = run declarationFeatures(&mut resolver.*, &module, declarationAccess182)
  completed.function.features = run featureAttribute(&mut resolver.*, &module, List<Bytes>.asSlice(&listedFeatures))
  completed.function.inlining = run declarationInlining(&mut resolver.*, &module, declarationAccess182)
  completed.function.optimizeSize = run declarationOptimizeSize(&mut resolver.*, &module, declarationAccess182)
  completed.function.variadic = run declarationVariadicExport(&mut resolver.*, &module, declarationAccess182)
  if !selfRaw && !inlinesMir(&resolver.*, &selfFacts, &instance)
    && run hasExplicitAlwaysCall(&mut resolver.*, &completed.function) {
    run inlineCalls(&mut resolver.*, &mut owner.*, &mut dependencies, &mut completed.function, &selfFacts, observing)
  }
  if thunked {
    run List<MirFunction>.append(&mut completed.helpers, run MirFunction.cThunk(&completed.function, observing))
  }
  return run storeLowered(&mut resolver.*, &mut owner.*, move completed, move dependencies, selfRaw)
}

pub fn singleMemberType(answer: &Result<Answer, NoRejection>) -> Option<Interned<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.MemberShape {types}} = &value.outcome {
      let fields = List<Interned<Type>>.asSlice(&types)
      if fields.length == usize.ONE { return Option<Interned<Type>>.some(Interned<Type>.clone(&fields[usize.ZERO])) }
    }
  }
  return Option<Interned<Type>>.none()
}

effect fn storeLayout(resolver: &mut Resolver, computed: Option<BackendLayout>, dependencies: List<Dependency>) -> Answer
! OutOfMemoryError ? &mut Allocator {
  return match move computed {
    Option<BackendLayout>.Some {value} => {
      let index = List<Interned<BackendLayout>>.length(&resolver.layoutValues)
      run List<Interned<BackendLayout>>.append(&mut resolver.*.layoutValues, run Interned<BackendLayout>.make(move value))
      run List<Bytes>.append(&mut resolver.*.layoutContents, Bytes.make())
      return memberSuccess(Value.Layout {index: index}, move dependencies)
    }
    Option<BackendLayout>.None => memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
}

pub effect fn resolveLayout(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, key: Key) -> Answer
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let types = List<Interned<Type>>.asSlice(&resolver.erasedTypes)
  if key.name >= types.length {
    return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make())
  }
  let ty = Interned<Type>.clone(&types[key.name])
  let scalar = BackendLayout.scalar(&ty, &resolver.target)
  if let Option<BackendLayout>.Some {value} = move scalar {
    return run storeLayout(&mut resolver.*, Option<BackendLayout>.some(move value), List<Dependency>.make())
  }
  if Interned<Type>.with<bool>(&ty, Type.erasedReference) {
    let pair = run BackendLayout.erasedReference(&resolver.target)
    return run storeLayout(&mut resolver.*, move pair, List<Dependency>.make())
  }
  if Interned<Type>.with<bool>(&ty, |value: &Type| -> bool { return match &value.* { Type.String {..} => true _ => false } }) {
    let text = run BackendLayout.text(&resolver.target)
    return run storeLayout(&mut resolver.*, move text, List<Dependency>.make())
  }
  if let Option<ArrayShape>.Some {value: array} = move Type.arrayShape(&ty) {
    let mut dependencies = List<Dependency>.make()
    let elementKey = run internErasedType(&mut resolver.*, &array.element)
    let declarationAccess189Request = Key {
      family: Family.Layout, module: key.module, name: elementKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }
    let declarationAccess189 = run internDeclaration(&mut resolver.*, declarationAccess189Request)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess189, Span.make(usize.ZERO, usize.ZERO))
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return run memberRejected(move value, move dependencies)
    }
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
    if let Option<usize>.Some {value: index} = move selected {
      let layouts = List<Interned<BackendLayout>>.asSlice(&resolver.layoutValues)
      let metrics = Interned<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      return run storeLayout(&mut resolver.*, BackendLayout.sequence(&array.element, array.length, metrics), move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  // A slice descriptor is an address and a length whatever its element is: indexing reads the
  // element's stride from the element's own layout, so a record can hold a view of itself.
  if let Option<Interned<Type>>.Some {value: element} = move Type.sliceElement(&ty) {
    let computed = BackendLayout.slice(&element, &resolver.target)
    return run storeLayout(&mut resolver.*, Option<BackendLayout>.some(move computed), List<Dependency>.make())
  }
  // Storage requires a complete canonical member set, independently of source admission.
  let orderedUnion = run Type.canonicalUnionMembers(&ty)
  if let Option<List<Interned<Type>>>.Some {value: canonical} = move orderedUnion {
    let mut dependencies = List<Dependency>.make()
    let mut inputs = List<LayoutFieldInput>.make()
    let listed = List<Interned<Type>>.asSlice(&canonical)
    let mut at = usize.ZERO
    while at < listed.length {
      let memberType = Interned<Type>.clone(&listed[at])
      let memberKey = run internErasedType(&mut resolver.*, &memberType)
      let declarationAccess191Request = Key {
        family: Family.Layout, module: key.module, name: memberKey,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }
      let declarationAccess191 = run internDeclaration(&mut resolver.*, declarationAccess191Request)
      let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess191, Span.make(usize.ZERO, usize.ZERO))
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return run memberRejected(move value, move dependencies)
      }
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
      let index = match move selected {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      let layouts = List<Interned<BackendLayout>>.asSlice(&resolver.layoutValues)
      let metrics = Interned<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: move memberType, metrics: metrics})
      at = at + usize.ONE
    }
    let computed = run BackendLayout.tagged(List<LayoutFieldInput>.asSlice(&inputs))
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  // Anonymous aggregates, callable environments and sealed cores have ordinary ordered record
  // storage; a core's fields match the bootstrap's layout (SealedCore).
  let mut structuralFields = run Type.recordFields(&ty)
  let unstructured = match &structuralFields { Option<List<Interned<Type>>>.None => true _ => false }
  if unstructured {
    let mut enabled = false
    if let Option<SealedKind>.Some {value: SealedKind.ExecutionHeader} = move SealedCore.coreOf(&ty) {
      let module = resolvedModule(&resolver.*, key.module)
      enabled = (run ambientCount(&mut resolver.*, &module)) != usize.ZERO
    }
    structuralFields = run SealedCore.fieldsForAmbient(&ty, enabled)
  }
  if let Option<List<Interned<Type>>>.Some {value: members} = move structuralFields {
    let mut dependencies = List<Dependency>.make()
    let mut inputs = List<LayoutFieldInput>.make()
    let listed = List<Interned<Type>>.asSlice(&members)
    let mut at = usize.ZERO
    while at < listed.length {
      let memberKey = run internErasedType(&mut resolver.*, &listed[at])
      let declarationAccess192Request = Key {
        family: Family.Layout, module: key.module, name: memberKey,
        declaration: usize.ZERO, member: usize.ZERO, external: false,
      }
      let declarationAccess192 = run internDeclaration(&mut resolver.*, declarationAccess192Request)
      let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess192, Span.make(usize.ZERO, usize.ZERO))
      let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
      if let Option<Shared<Rejection>>.Some {value} = move rejected {
        return run memberRejected(move value, move dependencies)
      }
      let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
      let index = match move selected {
        Option<usize>.Some {value} => value
        Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      let layouts = List<Interned<BackendLayout>>.asSlice(&resolver.layoutValues)
      let metrics = Interned<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
      run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: Interned<Type>.clone(&listed[at]), metrics: metrics})
      at = at + usize.ONE
    }
    let computed = run BackendLayout.record(List<LayoutFieldInput>.asSlice(&inputs))
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  let moduleOrdinal = declaringModuleOrdinal(&resolver.*, &ty)
  if moduleOrdinal == usize.MAX {
    return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make())
  }
  let module = resolvedModule(&resolver.*, moduleOrdinal)
  let ordinal = run ordinalOfProvider(&mut resolver.*, &module, &ty)
  let declaration = match move ordinal {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make()) }
  }
  let written = run header(&mut resolver.*, &module, declaration)
  let writtenHeader = match move written {
    Option<HeaderSyntax>.Some {value} => value
    Option<HeaderSyntax>.None => { return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make()) }
  }
  // A scalar enum has exactly its representation's layout (ENUM-003) and keeps nominal identity.
  if let Node.EnumHeader {..} = writtenHeader.header {
    let mut dependencies = List<Dependency>.make()
    let selected = run scalarEnumMembers(&mut resolver.*, &mut owner.*, &mut dependencies, moduleOrdinal, declaration, writtenHeader.span)
    let members = match move selected {
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Success {value} => move value
      Result<Shared<Result<Answer, NoRejection>>, Shared<Rejection>>.Failure {error} => {
        return run memberRejected(move error, move dependencies)
      }
    }
    let representation = Shared<Result<Answer, NoRejection>>.with<Option<StaticIntegerType>>(&members, scalarEnumRepresentation)
    if let Option<StaticIntegerType>.Some {value: integer} = move representation {
      let backing = run primitiveType(StaticConstant.integerName(integer))
      let computed = BackendLayout.scalar(&backing, &resolver.target)
      return run storeLayout(&mut resolver.*, move computed, move dependencies)
    }
    return memberSuccess(Value.LayoutUnsupported, move dependencies)
  }
  // A complete nominal-union instance lays out each substituted variant like a record after a
  // declaration-order tag.
  if let Node.UnionHeader {variants, ..} = writtenHeader.header {
    let mut dependencies = List<Dependency>.make()
    let nominal = NominalUnion {module: moduleOrdinal, declaration: declaration, count: variants.length}
    let mut records = List<Interned<BackendLayout>>.make()
    let mut tag = usize.ZERO
    while tag < nominal.count {
      let shaped = run variantShape(&mut resolver.*, &mut owner.*, &mut dependencies, &module, &ty, &nominal, tag, writtenHeader.span)
      let shape = match move shaped {
        Result<VariantShape, Shared<Rejection>>.Success {value} => move value
        Result<VariantShape, Shared<Rejection>>.Failure {error} => { return run memberRejected(move error, move dependencies) }
      }
      let fieldTypes = List<Interned<Type>>.asSlice(&shape.types)
      let mut inputs = List<LayoutFieldInput>.make()
      let mut at = usize.ZERO
      while at < fieldTypes.length {
        let fieldKey = run internErasedType(&mut resolver.*, &fieldTypes[at])
        let declarationAccess193Request = Key {
          family: Family.Layout, module: key.module, name: fieldKey,
          declaration: usize.ZERO, member: usize.ZERO, external: false,
        }
        let declarationAccess193 = run internDeclaration(&mut resolver.*, declarationAccess193Request)
        let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess193, writtenHeader.span)
        let rejectedChild = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
        if let Option<Shared<Rejection>>.Some {value} = move rejectedChild { return run memberRejected(move value, move dependencies) }
        let childIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
        let index = match move childIndex {
          Option<usize>.Some {value} => value
          Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
        }
        let layouts = List<Interned<BackendLayout>>.asSlice(&resolver.layoutValues)
        let metrics = Interned<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
        run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: Interned<Type>.clone(&fieldTypes[at]), metrics: metrics})
        at = at + usize.ONE
      }
      let record = run BackendLayout.record(List<LayoutFieldInput>.asSlice(&inputs))
      match move record {
        Option<BackendLayout>.Some {value} => { run List<Interned<BackendLayout>>.append(&mut records, run Interned<BackendLayout>.make(move value)) }
        Option<BackendLayout>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
      }
      tag = tag + usize.ONE
    }
    let computed = run BackendLayout.variants(List<Interned<BackendLayout>>.asSlice(&records), nominal.count)
    return run storeLayout(&mut resolver.*, move computed, move dependencies)
  }
  let mut count = usize.MAX
  if let Node.StructHeader {fields, ..} = writtenHeader.header { count = fields.length }
  if let Node.TupleHeader {elements, ..} = writtenHeader.header { count = elements.length }
  if count == usize.MAX {
    return memberSuccess(Value.LayoutUnsupported, List<Dependency>.make())
  }
  let application = run internApplication(&mut resolver.*, &ty)
  let mut dependencies = List<Dependency>.make()
  let mut inputs = List<LayoutFieldInput>.make()
  let mut at = usize.ZERO
  while at < count {
    let declarationAccess194Request = Key {
      family: Family.MemberShape, module: moduleOrdinal, name: application,
      declaration: declaration, member: at, external: false,
    }
    let declarationAccess194 = run internDeclaration(&mut resolver.*, declarationAccess194Request)
    let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess194, writtenHeader.span)
    let rejected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&shaped, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejected {
      return run memberRejected(move value, move dependencies)
    }
    let field = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&shaped, singleMemberType)
    let fieldType = match move field {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
    }
    let fieldKey = run internErasedType(&mut resolver.*, &fieldType)
    let declarationAccess195Request = Key {
      family: Family.Layout, module: key.module, name: fieldKey,
      declaration: usize.ZERO, member: usize.ZERO, external: false,
    }
    let declarationAccess195 = run internDeclaration(&mut resolver.*, declarationAccess195Request)
    let child = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies, declarationAccess195, writtenHeader.span)
    let rejectedChild = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&child, answerCause)
    if let Option<Shared<Rejection>>.Some {value} = move rejectedChild {
      return run memberRejected(move value, move dependencies)
    }
    let childIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&child, answerLayoutIndex)
    let index = match move childIndex {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return memberSuccess(Value.LayoutUnsupported, move dependencies) }
    }
    let layouts = List<Interned<BackendLayout>>.asSlice(&resolver.layoutValues)
    let metrics = Interned<BackendLayout>.with<LayoutMetrics>(&layouts[index], BackendLayout.metrics)
    run List<LayoutFieldInput>.append(&mut inputs, LayoutFieldInput {ty: move fieldType, metrics: metrics})
    at = at + usize.ONE
  }
  let computed = run BackendLayout.record(List<LayoutFieldInput>.asSlice(&inputs))
  return run storeLayout(&mut resolver.*, move computed, move dependencies)
}

/// One runtime type needed by a MIR local or projected operand.
pub struct LayoutDemand {
  pub ty: Interned<Type>,
  pub span: Span,
}

fn dereferencedType(value: &Type) -> Option<Interned<Type>> {
  return match & value.* {
    Type.Reference {referent, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&referent))
    Type.Pointer {pointee, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&pointee))
    _ => Option<Interned<Type>>.none()
  }
}

effect fn appendProjectedLayoutDemands(
  function: &MirFunction,
  place: &MirPlace,
  span: Span,
  needed: &mut List<LayoutDemand>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let locals = List<MirLocal>.asSlice(&function.locals)
  let mut ty = Interned<Type>.clone(&locals[place.local].ty)
  let projections = List<MirProjection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    match & projections[at] {
      MirProjection.Deref => ()
      _ => {
        return ()
      }
    }
    let pointee = Interned<Type>.with<Option<Interned<Type>>>(&ty, dereferencedType)
    ty = match move pointee {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => {
        return ()
      }
    }
    run List<LayoutDemand>.append(
      &mut needed.*,
      LayoutDemand {ty: Interned<Type>.clone(&ty), span: span},
    )
    at = at + usize.ONE
  }
  return ()
}

effect fn appendOperandLayoutDemands(function: &MirFunction, operand: &MirOperand, span: Span, needed: &mut List<LayoutDemand>) -> ()
! OutOfMemoryError ? &mut Allocator {
  match &operand.* {
    MirOperand.Copy {place} => run appendProjectedLayoutDemands(function, &place, span, &mut needed.*)
    MirOperand.Move {place} => run appendProjectedLayoutDemands(function, &place, span, &mut needed.*)
    // A constant's program-lifetime storage is laid out from its type's layout.
    MirOperand.StaticValue {value, ty} => {
      run List<LayoutDemand>.append(&mut needed.*, LayoutDemand {ty: Interned<Type>.clone(&ty), span: span})
      run appendViewLayoutDemands(&value, span, &mut needed.*)
    }
    _ => ()
  }
  return ()
}

// Each static view inside a constant addresses its referent's own constant, laid out from the
// referent's type.
effect fn appendViewLayoutDemands(value: &Interned<StaticData>, span: Span, needed: &mut List<LayoutDemand>) -> ()
! OutOfMemoryError ? &mut Allocator {
  if let Option<Interned<StaticData>>.Some {value: target} = move Interned<StaticData>.with<Option<Interned<StaticData>>>(value, StaticValue.borrowTarget) {
    // A slice's referent is the array it views; a reference's is its own type's referent.
    let view = Interned<StaticData>.with<Option<Interned<Type>>>(value, StaticValue.carriedType)
    let referent = match move view {
      Option<Interned<Type>>.Some {value: ty} => Interned<Type>.with<Option<Interned<Type>>>(&ty, |shape: &Type| -> Option<Interned<Type>> {
        return match &shape.* { Type.Reference {referent: held, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&held)) _ => Option<Interned<Type>>.none() }
      })
      Option<Interned<Type>>.None => Option<Interned<Type>>.none()
    }
    let mut demanded = move referent
    if let Option<Interned<Type>>.None = &demanded { demanded = Interned<StaticData>.with<Option<Interned<Type>>>(&target, StaticValue.carriedType) }
    if let Option<Interned<Type>>.Some {value: ty} = move demanded {
      run List<LayoutDemand>.append(&mut needed.*, LayoutDemand {ty: move ty, span: span})
    }
  }
  let count = Interned<StaticData>.with<usize>(value, StaticValue.childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Interned<StaticData>.with<Interned<StaticData>>(value, |data: &StaticData| -> Interned<StaticData> { return StaticValue.childAt(data, at) })
    run appendViewLayoutDemands(&child, span, &mut needed.*)
    at = at + usize.ONE
  }
  return ()
}

// Projected loads, stores, and address formation of an assignment depend on referent layouts.
effect fn appendStatementLayoutDemands(
  function: &MirFunction,
  statement: &MirStatement,
  needed: &mut List<LayoutDemand>, anchor: &Option<Anchor>,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if let MirStatement.Assign {destination, value, origin} = &statement.* {
    run appendProjectedLayoutDemands(function, &destination, anchoredSpan(anchor, origin), &mut needed.*)
    match & value {
      MirRvalue.Ref {place, ..} => run appendProjectedLayoutDemands(
        function,
        &place,
        anchoredSpan(anchor, origin),
        &mut needed.*,
      )
      MirRvalue.Slice {data, count} => {
        run appendOperandLayoutDemands(function, &data, anchoredSpan(anchor, origin), &mut needed.*)
        run appendOperandLayoutDemands(function, &count, anchoredSpan(anchor, origin), &mut needed.*)
      }
      MirRvalue.Convert {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.Fits {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.ScalarUnary {value: operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.ScalarBinary {left, right, ..} => {
        run appendOperandLayoutDemands(function, &left, anchoredSpan(anchor, origin), &mut needed.*)
        run appendOperandLayoutDemands(function, &right, anchoredSpan(anchor, origin), &mut needed.*)
      }
      MirRvalue.AddressIntegerConversion {operand, ..} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.Prefetch {address, ..} => run appendOperandLayoutDemands(function, &address, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.SliceLength {place} => run appendProjectedLayoutDemands(function, &place, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.SliceData {place} => run appendProjectedLayoutDemands(function, &place, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.PointerOffset {element, ..} => run List<LayoutDemand>.append(
        &mut needed.*,
        LayoutDemand {ty: Interned<Type>.clone(&element), span: anchoredSpan(anchor, origin)},
      )
      MirRvalue.Wasm {operands, ..} => {
        let listed = List<MirOperand>.asSlice(&operands)
        let mut at = usize.ZERO
        while at < listed.length {
          run appendOperandLayoutDemands(function, &listed[at], anchoredSpan(anchor, origin), &mut needed.*)
          at = at + usize.ONE
        }
      }
      MirRvalue.ProcessSlot {element, ..} => run List<LayoutDemand>.append(&mut needed.*,
        LayoutDemand {ty: Interned<Type>.clone(&element), span: anchoredSpan(anchor, origin)})
      MirRvalue.StackAllocate {count, element} => {
        run appendOperandLayoutDemands(function, &count, anchoredSpan(anchor, origin), &mut needed.*)
        run List<LayoutDemand>.append(&mut needed.*, LayoutDemand {ty: Interned<Type>.clone(&element), span: anchoredSpan(anchor, origin)})
      }
      MirRvalue.Discriminant {place} => run appendProjectedLayoutDemands(function, &place, anchoredSpan(anchor, origin), &mut needed.*)
      MirRvalue.AddressOf {place, ..} => run appendProjectedLayoutDemands(
        function,
        &place,
        anchoredSpan(anchor, origin),
        &mut needed.*,
      )
      MirRvalue.Use {value: operand} => run appendOperandLayoutDemands(function, &operand, anchoredSpan(anchor, origin), &mut needed.*)
      _ => ()
    }
  }
  // A drop forms the address of its place before calling the place type's glue.
  if let MirStatement.Drop {destination, origin, ..} = &statement.* {
    run appendProjectedLayoutDemands(function, &destination, anchoredSpan(anchor, origin), &mut needed.*)
  }
  return ()
}

/// Collects complete local and projected-place layout demands for an ordinary MIR body.
pub effect fn mirLayoutDemands(function: &MirFunction, anchor: &Option<Anchor>) -> List<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let locals = List<MirLocal>.asSlice(&function.locals)
  let mut copied = List<LayoutDemand>.make()
  let mut at = usize.ZERO
  while at < locals.length {
    run List<LayoutDemand>.append(
      &mut copied,
      LayoutDemand {ty: Interned<Type>.clone(&locals[at].ty), span: anchoredSpan(anchor, locals[at].origin)},
    )
    at = at + usize.ONE
  }
  // Projected loads, stores, and address formation also depend on their referent layouts.
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut blockAt = usize.ZERO
  while blockAt < blocks.length {
    let statements = List<MirStatement>.asSlice(&blocks[blockAt].statements)
    let mut statementAt = usize.ZERO
    while statementAt < statements.length {
      run appendStatementLayoutDemands(function, &statements[statementAt], &mut copied, anchor)
      statementAt = statementAt + usize.ONE
    }
    // A call reads each argument in place, so a projected argument needs its referent layouts too.
    if let MirTerminator.Call {call} = &blocks[blockAt].terminator {
  let MirCallTerminator {arguments, origin, ..} = &call.get().*

      let listed = List<MirOperand>.asSlice(&arguments)
      let mut argumentAt = usize.ZERO
      while argumentAt < listed.length {
        run appendOperandLayoutDemands(function, &listed[argumentAt], anchoredSpan(anchor, origin), &mut copied)
        argumentAt = argumentAt + usize.ONE
      }
    }
    // A native indirect call classifies its C lanes from the signature itself; a `()` result
    // may have no local left to supply its layout.
    if let MirTerminator.Call {call} = &blocks[blockAt].terminator { if let MirCallTerminator {callee: MirCallee.NativeIndirect {signature, ..}, origin, ..} = &call.get().* {
      if let Type.Callable {parameters, result, ..} = move run Type.copy(&signature) {
        run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: move result, span: anchoredSpan(anchor, origin)})
        let listed = List<Interned<Type>>.asSlice(&parameters)
        let mut parameterAt = usize.ZERO
        while parameterAt < listed.length {
          run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: Interned<Type>.clone(&listed[parameterAt]), span: anchoredSpan(anchor, origin)})
          parameterAt = parameterAt + usize.ONE
        }
      }
    } }
    blockAt = blockAt + usize.ONE
  }
  return move copied
}

pub effect fn copyMirLocalTypes(resolver: &Resolver, index: usize, anchor: &Option<Anchor>) -> List<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  return run mirLayoutDemands(&functions[index], anchor)
}

// Exported entries and indirect calls need the same nested vector feature checks as imports.
pub effect fn copyMirCValues(resolver: &Resolver, index: usize, anchor: &Option<Anchor>) -> List<LayoutDemand>
! OutOfMemoryError ? &mut Allocator {
  let function = &List<MirFunction>.asSlice(&resolver.mirValues)[index]
  let mut copied = List<LayoutDemand>.make()
  if InstanceKey.cEntry(&function.key) {
    let span = anchoredSpan(anchor, List<MirLocal>.asSlice(&function.locals)[usize.ZERO].origin)
    run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: Interned<Type>.clone(&function.result), span: span})
    let parameters = List<Interned<Type>>.asSlice(&function.parameters)
    let mut at = usize.ZERO
    while at < parameters.length {
      run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: Interned<Type>.clone(&parameters[at]), span: span})
      at = at + usize.ONE
    }
  }
  let blocks = List<MirBlock>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {call} = &blocks[at].terminator { if let MirCallTerminator {callee: MirCallee.NativeIndirect {signature, ..}, origin, ..} = &call.get().* {
      run List<LayoutDemand>.append(&mut copied, LayoutDemand {ty: Interned<Type>.clone(&signature), span: anchoredSpan(anchor, origin)})
    } }
    at = at + usize.ONE
  }
  return move copied
}

// Whether `@foreign` directive `id` writes only `noCapture`, naming distinct pointer parameters.
effect fn admittedNoCapture(hir: &Module, id: HirId, parameters: Range) -> bool ! OutOfMemoryError ? &mut Allocator {
  let written = Directives.arguments(hir, id)
  let mut field = usize.ZERO
  while field < written.length {
    if let Node.DirectiveArgument {name, value} = Module.node(hir, Module.child(hir, written, field)) {
      if !name.present || !nameIs(hir, name.id, b"noCapture") { return false }
      let mut listed = List<HirId>.make()
      run Directives.values(hir, value, &mut listed)
      if !capturesPointerParameters(hir, List<HirId>.asSlice(&listed), parameters) { return false }
    } else {
      return false
    }
    field = field + usize.ONE
  }
  return true
}

// Whether a declaration's directives promise callback behavior: a callback mode or a deferred
// reentry. An unknown or misplaced directive promises nothing; its own rule reports it.
fn callbackPromise(hir: &Module, directives: Range) -> bool {
  let mut at = usize.ZERO
  while at < directives.length {
    if let Option<DirectiveKind>.Some {value: kind} = Directives.kindOf(hir, Module.child(hir, directives, at)) {
      if kind == DirectiveKind.InvokesDeferredCallbacks { return true }
      if let Option<ForeignCallbacks>.Some {..} = callbackMode(kind) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether every `noCapture` list of a declaration without a literal contract names distinct
// pointer parameters. The other `@foreign` fields are judged with the callback modes.
effect fn admittedForeignArguments(hir: &Module, directives: Range, parameters: Range) -> bool ! OutOfMemoryError ? &mut Allocator {
  if let Option<ForeignContract>.Some {..} = move NativeForeign.contract(hir, directives) { return true }
  let mut at = usize.ZERO
  while at < directives.length {
    let id = Module.child(hir, directives, at)
    if let Option<DirectiveKind>.Some {value: DirectiveKind.Foreign} = Directives.kindOf(hir, id) {
      let written = Directives.arguments(hir, id)
      let mut field = usize.ZERO
      while field < written.length {
        if let Node.DirectiveArgument {name, value} = Module.node(hir, Module.child(hir, written, field)) {
          if name.present && nameIs(hir, name.id, b"noCapture") {
            let mut listed = List<HirId>.make()
            run Directives.values(hir, value, &mut listed)
            if !capturesPointerParameters(hir, List<HirId>.asSlice(&listed), parameters) { return false }
          }
        }
        field = field + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return true
}

// Callback modes are mutually exclusive and cannot assert restricted memory access. Syntax
// checks direct omissions here; signature resolution authenticates aliases and aggregate paths.
effect fn admittedForeignDirectives(hir: &Module, directives: Range, parameters: Range) -> bool
! OutOfMemoryError ? &mut Allocator {
  if let Option<ForeignContract>.Some {..} = move NativeForeign.contract(hir, directives) {
    return !hasCallbackParameter(hir, parameters)
  }
  let mut fields = usize.ZERO
  let mut callbacks = false
  // Each mode has at most one list, and the lists together name every callback once.
  let mut modes = ForeignContract.conservative()
  let mut named = List<HirId>.make()
  let mut invokes = false
  let mut at = usize.ZERO
  while at < directives.length {
    let id = Module.child(hir, directives, at)
    at = at + usize.ONE
    // An unknown directive (SEM0235) or one this declaration does not take (SEM0236) is
    // reported by its own rule and promises nothing here.
    let kind = match Directives.kindOf(hir, id) {
      Option<DirectiveKind>.Some {value} => value
      Option<DirectiveKind>.None => { continue }
    }
    if kind == DirectiveKind.Foreign {
      if !(run admittedNoCapture(hir, id, parameters)) { return false }
      fields = fields + Directives.arguments(hir, id).length
    } else if let Option<ForeignCallbacks>.Some {value: mode} = callbackMode(kind) {
      let before = ForeignContract.code(modes)
      ForeignContract.admit(&mut modes, mode)
      if ForeignContract.code(modes) == before { return false }
      let listed = run Directives.texts(hir, id)
      if List<HirId>.length(&listed) == usize.ZERO { return false }
      let entries = List<HirId>.asSlice(&listed)
      let mut entry = usize.ZERO
      while entry < entries.length {
        run List<HirId>.append(&mut named, entries[entry])
        entry = entry + usize.ONE
      }
      if !callbacks { fields = fields + usize.ONE }
      callbacks = true
    } else if kind == DirectiveKind.InvokesDeferredCallbacks {
      if invokes || Directives.arguments(hir, id).length != usize.ZERO { return false }
      invokes = true
    }
  }
  if callbacks && !capturesCallbackParameters(hir, List<HirId>.asSlice(&named), parameters) { return false }
  return fields <= usize.ONE && (!invokes || fields == usize.ZERO || callbacks)
    && (!hasCallbackParameter(hir, parameters) || callbacks)
}

// The first directive of a declaration that takes none, rejected: a name outside the table is
// unknown (SEM0235) and a known one, which describes a function, is misplaced (SEM0236). No
// directive is silently ignored. Functions and operations check their own in `directiveConflict`.
pub effect fn directiveRejection(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> Option<Shared<Rejection>>
! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Directives)
  let mut refused = Option<HeaderConflict>.none()
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      let directives = Directives.of(hir, declarations[ordinal].local)
      if let Option<Span>.Some {value: clause} = move Directives.unknown(hir, directives) {
        refused = conflictAt(RejectionCode.UnknownDirective, clause)
      } else if let Option<Span>.Some {value: clause} = move Directives.misplaced(hir, directives, DirectivePosition.Other) {
        refused = conflictAt(RejectionCode.MisplacedDirective, clause)
      }
    }
  }
  drop observed
  if let Option<HeaderConflict>.Some {value: conflict} = move refused {
    return Option<Shared<Rejection>>.some(run reject(&resolver.*, module, conflict.code, conflict.span))
  }
  return Option<Shared<Rejection>>.none()
}

// Whether a function is written `@nonParking`, as a service operation can be (SEM0139).
pub effect fn declarationNonParking(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Directives)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length { return false }
    let hir = IndexedSource.authored(value)
    if let Node.FunctionHeader {..} = Module.node(hir, declarations[ordinal].header) {
      let directives = Directives.of(hir, declarations[ordinal].local)
      if let Option<HirId>.Some {..} = move Directives.find(hir, directives, DirectiveKind.NonParking) { return true }
    }
  }
  return false
}

// Whether a function is written `@optimizeSize`, which builds it for size in any profile.
effect fn declarationOptimizeSize(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Directives)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length { return false }
    let hir = IndexedSource.authored(value)
    if let Node.FunctionHeader {linkage, ..} = Module.node(hir, declarations[ordinal].header) {
      if linkage.present { return false }
      let directives = Directives.of(hir, declarations[ordinal].local)
      if let Option<HirId>.Some {..} = move Directives.find(hir, directives, DirectiveKind.OptimizeSize) { return true }
    }
  }
  return false
}

// Whether the body being checked is a variadic export's own: `caller` is that top-level
// declaration.
pub effect fn variadicExportCaller(resolver: &mut Resolver, caller: &DeclarationId) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  if DeclarationId.ownerCount(caller) != usize.ONE { return false }
  let position = DeclarationTable.position(&resolver.declarations, DeclarationTable.find(&resolver.declarations, caller))
  if position == usize.MAX { return false }
  return run declarationVariadicExport(&mut resolver.*, DeclarationId.moduleId(caller), position)
}

// Whether the declaration at `ordinal` is an `export "C"` function whose parameters end with `...`:
// its body reads the `va_list` its C entry starts (`Intrinsic.variadicArguments`).
effect fn declarationVariadicExport(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Header)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal >= declarations.length { return false }
    let hir = IndexedSource.authored(value)
    if let Node.FunctionHeader {linkage, contract, ..} = Module.node(hir, declarations[ordinal].header) {
      if !linkage.present { return false }
      if let Node.Linkage {direction, ..} = Module.node(hir, linkage.id) {
        if direction != LinkageDirection.Export { return false }
        if let Option<HirContract>.Some {value: HirContract {variadic, ..}} = Module.contractOf(hir, contract) { return variadic }
      }
    }
  }
  return false
}

// A discarded-call proof reads only whether an explicit or inferred policy selects always-inline.
effect fn declarationAlwaysInline(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.AlwaysInline)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    return SourceSyntax.inlining(value, ordinal) == MirInlining.Always
  }
  return false
}

effect fn declarationInlining(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> MirInlining
! Cycle | OutOfMemoryError ? &mut Allocator {
  drop run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Directives)
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Header)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    return SourceSyntax.inlining(value, ordinal)
  }
  return MirInlining.Default
}

// The entries of an `@features(...)` directive: its text literals, in written order. A non-literal
// entry is returned as its span in `invalid`, and so is an empty list, which `empty` marks.
effect fn featureEntries(hir: &Module, directive: HirId) -> FeatureEntries ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Bytes>.make()
  let mut spans = List<Span>.make()
  let mut invalid = Option<Span>.none()
  let mut empty = false
  let listed = run Directives.texts(hir, directive)
  let elements = List<HirId>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < elements.length {
    if let Node.TextLiteral {value: text} = Module.node(hir, elements[at]) {
      run List<Bytes>.append(&mut names, run Bytes.copy(Module.text(hir, text)))
      run List<Span>.append(&mut spans, Module.span(hir, elements[at]))
    } else if let Option<Span>.None = &invalid {
      invalid = Option<Span>.some(Module.span(hir, elements[at]))
    }
    at = at + usize.ONE
  }
  if elements.length == usize.ZERO {
    empty = true
    invalid = Option<Span>.some(Module.span(hir, directive))
  }
  return FeatureEntries {names: move names, spans: move spans, invalid: move invalid, empty: empty}
}

struct FeatureEntries {
  names: List<Bytes>,
  spans: List<Span>,
  invalid: Option<Span>,
  empty: bool,
}

// The first conflict of a function's `features:` list: an empty list or an entry outside the
// target's catalog (SEM0242), a `static` function (SEM0236), or a function not declared `unsafe`
// (SEM0243).
pub effect fn featuresConflict(resolver: &Resolver, hir: &Module, directive: HirId, isUnsafe: bool,
  isStatic: bool, name: &[u8], span: Span) -> Option<HeaderConflict> ! OutOfMemoryError ? &mut Allocator {
  let entries = run featureEntries(hir, directive)
  if let Option<Span>.Some {value: invalid} = &entries.invalid {
    if entries.empty {
      let mut arguments = List<MessageArgument>.make()
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"1")})
      run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"target"), value: run Bytes.copy(resolver.target.name())})
      return Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.UnknownFunctionFeature, span: invalid, arguments: move arguments})
    }
    return run featureConflict(resolver, invalid, b"a non-literal entry")
  }
  let names = List<Bytes>.asSlice(&entries.names)
  let spans = List<Span>.asSlice(&entries.spans)
  let mut at = usize.ZERO
  while at < names.length {
    if !resolver.target.supportsFeature(Bytes.asSlice(&names[at])) {
      return run featureConflict(resolver, spans[at], Bytes.asSlice(&names[at]))
    }
    at = at + usize.ONE
  }
  if isStatic { return conflictAt(RejectionCode.MisplacedDirective, Module.span(hir, directive)) }
  if !isUnsafe { return run namedHeaderConflict(RejectionCode.FeatureFunctionRequiresUnsafe, span, b"name", name) }
  return Option<HeaderConflict>.none()
}

effect fn featureConflict(resolver: &Resolver, span: Span, feature: &[u8]) -> Option<HeaderConflict>
! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<MessageArgument>.make()
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"0")})
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"feature"), value: run Bytes.copy(feature)})
  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"target"), value: run Bytes.copy(resolver.target.name())})
  return Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.UnknownFunctionFeature, span: span, arguments: move arguments})
}

// The CPU features a declaration's `@features(...)` directive lists, as written; empty for any
// other declaration (SIMD-009). Reads the header and directives facets only.
pub effect fn declarationFeatures(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> List<Bytes>
! Cycle | OutOfMemoryError ? &mut Allocator {
  drop run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Directives)
  let answer = run observedDeclaration(&mut resolver.*, module, ordinal, SourceFacet.Header)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    if ordinal < declarations.length {
      let hir = IndexedSource.authored(value)
      if let Node.FunctionHeader {linkage, ..} = Module.node(hir, declarations[ordinal].header) {
        if !linkage.present {
          let directives = Directives.of(hir, declarations[ordinal].local)
          if let Option<HirId>.Some {value: directive} = move Directives.find(hir, directives, DirectiveKind.Features) {
            let entries = run featureEntries(hir, directive)
            return move entries.names
          }
        }
      }
    }
  }
  return List<Bytes>.make()
}

// Whether enabling every feature of `listed` enables `feature`, through the transitive closure of
// the target's implications.
pub fn featureEnabled(target: &MachineTarget, listed: &[Bytes], feature: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    if featureReaches(target, Bytes.asSlice(&listed[at]), feature, target.featureCount()) { return true }
    at = at + usize.ONE
  }
  return false
}

fn featureReaches(target: &MachineTarget, from: &[u8], to: &[u8], depth: usize) -> bool {
  if same(from, to) { return true }
  if depth == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < target.featureCount() {
    let next = target.feature(at)
    if target.implies(from, next) && featureReaches(target, next, to, depth - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

// The LLVM `target-features` text of a function that lists `listed`: every catalog feature that
// the profile or the list's closure enables, as `+name` entries. Empty when nothing is listed.
effect fn featureAttribute(resolver: &mut Resolver, module: &ModuleId, listed: &[Bytes]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if listed.length == usize.ZERO { return move text }
  let mut at = usize.ZERO
  while at < resolver.target.featureCount() {
    let feature = resolver.target.feature(at)
    let mut enabled = featureEnabled(&resolver.target, listed, feature)
    if !enabled { enabled = run profileFeature(&mut resolver.*, module, feature) }
    if enabled {
      if Bytes.length(&text) > usize.ZERO { run Bytes.append(&mut text, b",") }
      run Bytes.append(&mut text, b"+")
      run Bytes.append(&mut text, feature)
    }
    at = at + usize.ONE
  }
  return move text
}

fn nameIs(hir: &Module, id: HirId, spelling: &[u8]) -> bool {
  return match Module.node(hir, id) {
    Node.Name {text} => same(Module.text(hir, text), spelling)
    _ => false
  }
}

// Whether `elements` are distinct text literals that each name a C pointer parameter.
fn capturesPointerParameters(hir: &Module, elements: &[HirId], parameters: Range) -> bool {
  if elements.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < elements.length {
    if let Node.TextLiteral {value: text} = Module.node(hir, elements[at]) {
      if !pointerParameterNamed(hir, parameters, Module.text(hir, text)) { return false }
      let mut earlier = usize.ZERO
      while earlier < at {
        if let Node.TextLiteral {value: previous} = Module.node(hir, elements[earlier]) {
          if same(Module.text(hir, previous), Module.text(hir, text)) { return false }
        }
        earlier = earlier + usize.ONE
      }
    } else {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The `@callbacks` directive naming every C function-pointer parameter, as `@callbacks("compare")`.
effect fn callbacksField(hir: &Module, parameters: Range) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut field = run Bytes.copy(b"@callbacks(")
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < parameters.length {
    if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
      if let Node.ForeignFunctionType {..} = Module.node(hir, annotation) {
        if let Node.Name {text} = Module.node(hir, name) {
          if count > usize.ZERO { run Bytes.append(&mut field, b", ") }
          run Bytes.append(&mut field, b"\"")
          run Bytes.append(&mut field, Module.text(hir, text))
          run Bytes.append(&mut field, b"\"")
          count = count + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  run Bytes.append(&mut field, b")")
  return move field
}

fn hasCallbackParameter(hir: &Module, parameters: Range) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    if let Node.Parameter {annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
      if let Node.ForeignFunctionType {..} = Module.node(hir, annotation) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `elements` are distinct text literals that name parameters, together naming every C
// function-pointer parameter.
fn capturesCallbackParameters(hir: &Module, elements: &[HirId], parameters: Range) -> bool {
  if elements.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < elements.length {
    let mut selected = false
    if let Node.TextLiteral {value: spelling} = Module.node(hir, elements[at]) {
      let mut parameter = usize.ZERO
      while parameter < parameters.length {
        if let Node.Parameter {name, ..} = Module.node(hir, Module.child(hir, parameters, parameter)) {
          let path = Module.text(hir, spelling)
          let mut end = usize.ZERO
          while end < path.length && path[end] != 46 { end = end + usize.ONE }
          if nameIs(hir, name, Slice.view<u8>(path, usize.ZERO, end)) { selected = true }
        }
        parameter = parameter + usize.ONE
      }
      let mut earlier = usize.ZERO
      while earlier < at {
        if let Node.TextLiteral {value: previous} = Module.node(hir, elements[earlier]) {
          if same(Module.text(hir, previous), Module.text(hir, spelling)) { return false }
        }
        earlier = earlier + usize.ONE
      }
    }
    if !selected { return false }
    at = at + usize.ONE
  }
  let mut parameter = usize.ZERO
  while parameter < parameters.length {
    if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, parameter)) {
      if let Node.ForeignFunctionType {..} = Module.node(hir, annotation) {
        let mut listed = false
        let mut entry = usize.ZERO
        while entry < elements.length {
          if let Node.TextLiteral {value: spelling} = Module.node(hir, elements[entry]) {
            if nameIs(hir, name, Module.text(hir, spelling)) { listed = true }
          }
          entry = entry + usize.ONE
        }
        if !listed { return false }
      }
    }
    parameter = parameter + usize.ONE
  }
  return true
}

fn pointerParameterNamed(hir: &Module, parameters: Range, spelling: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < parameters.length {
    if let Node.Parameter {name, annotation, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
      if nameIs(hir, name, spelling) {
        return match Module.node(hir, annotation) {
          Node.PointerType {..} => true
          _ => false
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Whether declaration `ordinal` of `module` is a function with C linkage, imported or exported.
pub effect fn linked(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let observed = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      if let Node.FunctionHeader {linkage, ..} = Module.node(hir, declarations[ordinal].header) {
        return linkage.present
      }
    }
  }
  return false
}

// The position of the `#` that separates a WebAssembly import's module from its field, or
// `usize.MAX` for a symbol that names no pair.
pub fn wasmPairSplit(symbol: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < symbol.length {
    if symbol[at] == 35 { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The native symbol of a WebAssembly import of `pair`: `__silk_import_` followed by the pair with
// every byte other than an ASCII letter or digit written as `_` and two lowercase hex digits.
effect fn wasmImportSymbol(pair: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let digits: &[u8] = b"0123456789abcdef"
  let mut symbol = run Bytes.copy(b"__silk_import_")
  let mut at = usize.ZERO
  while at < pair.length {
    let byte = pair[at]
    let plain = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
    if plain {
      run Bytes.append(&mut symbol, Slice.view<u8>(pair, at, usize.ONE))
    } else {
      run Bytes.append(&mut symbol, b"_")
      run Bytes.append(&mut symbol, Slice.view<u8>(digits, u8.toUsize(byte / 16), usize.ONE))
      run Bytes.append(&mut symbol, Slice.view<u8>(digits, u8.toUsize(byte % 16), usize.ONE))
    }
    at = at + usize.ONE
  }
  return move symbol
}

pub struct ForeignHeader {
  pub importModule: Bytes,
  pub importName: Bytes,
  pub behavior: ForeignContract,
  pub symbol: Bytes,
  /// The first C linkage rule the header breaks, as the coded diagnostic `check` reports. The
  /// signature check reports it first, so classification never meets a refused header.
  pub refusal: Option<HeaderConflict>,
  pub span: Span,
  /// Whether the linkage defines this declaration for C callers (`export`) rather than importing it.
  pub exported: bool,
  /// Whether the declaration is a C object (`static`) rather than a function.
  pub global: bool,
  /// Whether the declaration is a generic export: it declares type parameters, so it publishes no
  /// symbol and each instantiation whose address is taken has its own C thunk.
  pub generic: bool,
  /// The `@callbacks` directive a function with C function-pointer parameters needs when its
  /// directives do not name each of them once, as `@callbacks("compare")`; empty otherwise.
  pub callbacks: Bytes,
  /// The parameter names, which root the callback paths.
  pub parameterNames: List<Bytes>,
  /// Each callback path the directives list, with the mode of its list.
  pub callbackModes: List<CallbackMode>,
}

// One listed callback path and the invocation mode its list promises.
pub struct CallbackMode { path: Bytes, mode: ForeignCallbacks }

// Classifies one linked function or static header. A function import must be `unsafe`; an export
// is an ordinary definition whose C lanes are checked separately. Both admit only the C ABI, no
// generic, effect or static contract. Closed synchronous callback lanes retain their own C signatures. Variadic imports have fixed parameters
// followed by integer-only call-local tails. A static admits no
// linkage properties.
pub effect fn foreignHeader(resolver: &mut Resolver, module: &ModuleId, ordinal: usize) -> ForeignHeader
! Cycle | OutOfMemoryError ? &mut Allocator {
  // The foreign contract rules judge only directives the directive rules admit; an unknown,
  // misplaced or clashing one is reported by its own rule (`directiveConflict`).
  let schematic = match move run directiveConflict(&mut resolver.*, module, ordinal) { Option<HeaderConflict>.None => true _ => false }
  let observed = run source(&mut resolver.*, module)
  if let Option<&IndexedSource>.Some {value} = move sourceOf(&resolver.*, &observed, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let hir = IndexedSource.authored(value)
    if ordinal < declarations.length {
      let span = Module.span(hir, declarations[ordinal].header)
      let directives = Directives.of(hir, declarations[ordinal].local)
      if let Node.StaticHeader {name, linkage, isUnsafe, ..} = Module.node(hir, declarations[ordinal].header) {
        if let Node.Linkage {direction, abi, symbol} = Module.node(hir, linkage) {
          let mut symbolName = Bytes.make()
          if let Node.Name {text} = Module.node(hir, name) { symbolName = run Bytes.copy(Module.text(hir, text)) }
          let staticName = run Bytes.copy(Bytes.asSlice(&symbolName))
          if symbol.present {
            if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { symbolName = run Bytes.copy(Module.text(hir, text)) }
          }
          let mut refusal = Option<HeaderConflict>.none()
          // A C object takes no directive (SEM0236) and only the C ABI (SEM0185).
          if directives.length > usize.ZERO {
            refusal = conflictAt(RejectionCode.MisplacedDirective, Module.span(hir, Module.child(hir, directives, usize.ZERO)))
          }
          if let Node.TextLiteral {value: text} = Module.node(hir, abi) {
            if !same(Module.text(hir, text), b"C") {
              refusal = run namedHeaderConflict(RejectionCode.UnsupportedForeignAbi, Module.span(hir, abi), b"abi", Module.text(hir, text))
            }
          }
          // A C import is `unsafe`, as a function import is (SEM0186).
          if direction == LinkageDirection.Import && !isUnsafe {
            refusal = run namedHeaderConflict(RejectionCode.ForeignFunctionRequiresUnsafe, span, b"name", Bytes.asSlice(&staticName))
          }
          return ForeignHeader {importModule: Bytes.make(), importName: Bytes.make(), behavior: ForeignContract.conservative(), symbol: move symbolName, refusal: move refusal, span: span, exported: direction == LinkageDirection.Export, global: true, generic: false, callbacks: Bytes.make(),
            parameterNames: List<Bytes>.make(), callbackModes: List<CallbackMode>.make()}
        }
      }
      if let Node.FunctionHeader {name, contract, linkage, ..} = Module.node(hir, declarations[ordinal].header) {
        if linkage.present {
          if let Node.Linkage {direction, abi, symbol} = Module.node(hir, linkage.id) {
            let exported = direction == LinkageDirection.Export
            let mut symbolName = Bytes.make()
            if let Node.Name {text} = Module.node(hir, name) { symbolName = run Bytes.copy(Module.text(hir, text)) }
            if symbol.present {
              if let Node.TextLiteral {value: text} = Module.node(hir, symbol.id) { symbolName = run Bytes.copy(Module.text(hir, text)) }
            }
            let mut refusal = Option<HeaderConflict>.none()
            let mut generic = false
            let mut functionName = Bytes.make()
            if let Node.Name {text} = Module.node(hir, name) { functionName = run Bytes.copy(Module.text(hir, text)) }
            let mut behavior = ForeignContract.conservative()
            let mut callbacks = Bytes.make()
            let mut parameterNames = List<Bytes>.make()
            let mut callbackModes = List<CallbackMode>.make()
            if let Option<ForeignContract>.Some {value: literalBehavior} = move NativeForeign.contract(hir, directives) { behavior = literalBehavior }
            let mut directiveAt = usize.ZERO
            while directiveAt < directives.length {
              let directive = Module.child(hir, directives, directiveAt)
              if let Option<DirectiveKind>.Some {value: kind} = Directives.kindOf(hir, directive) {
                if let Option<ForeignCallbacks>.Some {value: mode} = callbackMode(kind) {
                  ForeignContract.admit(&mut behavior, mode)
                  let listed = run Directives.texts(hir, directive)
                  let entries = List<HirId>.asSlice(&listed)
                  let mut entry = usize.ZERO
                  while entry < entries.length {
                    if let Node.TextLiteral {value: spelling} = Module.node(hir, entries[entry]) {
                      run List<CallbackMode>.append(&mut callbackModes, CallbackMode {path: run Bytes.copy(Module.text(hir, spelling)), mode: mode})
                    }
                    entry = entry + usize.ONE
                  }
                }
                if kind == DirectiveKind.InvokesDeferredCallbacks { behavior.invokesDeferredCallbacks = true }
              }
              directiveAt = directiveAt + usize.ONE
            }
            if let Option<HirContract>.Some {value: HirContract {variadic, generics, parameters, result, isEffect, isStatic, isUnsafe, ..}} = Module.contractOf(hir, contract) {
              let mut parameterAt = usize.ZERO
              while parameterAt < parameters.length {
                let mut spelling = Bytes.make()
                if let Node.Parameter {name: parameterName, ..} = Module.node(hir, Module.child(hir, parameters, parameterAt)) {
                  if let Node.Name {text} = Module.node(hir, parameterName) { spelling = run Bytes.copy(Module.text(hir, text)) }
                }
                run List<Bytes>.append(&mut parameterNames, move spelling)
                parameterAt = parameterAt + usize.ONE
              }
              // Callback directives name each C function-pointer lane once (SEM0187).
              if schematic && !(run admittedForeignArguments(hir, directives, parameters)) {
                let mut arguments = List<MessageArgument>.make()
                run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"6")})
                refusal = Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.ForeignType, span: span, arguments: move arguments})
              } else if schematic && !(run admittedForeignDirectives(hir, directives, parameters)) {
                if !ForeignContract.hasCallbacks(behavior) && !behavior.invokesDeferredCallbacks && hasCallbackParameter(hir, parameters) {
                  callbacks = run callbacksField(hir, parameters)
                  let mut arguments = List<MessageArgument>.make()
                  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(b"2")})
                  run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"clause"), value: run Bytes.copy(Bytes.asSlice(&callbacks))})
                  refusal = Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.ForeignType, span: span, arguments: move arguments})
                } else {
                  refusal = conflictAt(RejectionCode.ForeignCallback, span)
                }
              }
              // Returned function pointers still need a proved returned-callback contract.
              if result.present {
                if let Node.ForeignFunctionType {..} = Module.node(hir, result.id) { refusal = conflictAt(RejectionCode.ForeignCallback, span) }
              }
              // A contract an export asserts about itself is the author's unchecked promise, so
              // its Silk callers acknowledge it as they do an import's (SEM0186).
              if exported && !isUnsafe {
                let promised = match move NativeForeign.contract(hir, directives) {
                  Option<ForeignContract>.Some {value: assertedBehavior} => !ForeignContract.same(assertedBehavior, ForeignContract.conservative())
                  Option<ForeignContract>.None => callbackPromise(hir, directives)
                }
                if promised {
                  refusal = run namedHeaderConflict(RejectionCode.ForeignFunctionRequiresUnsafe, span, b"name", Bytes.asSlice(&functionName))
                }
              }
              // The signature check refuses these first, at their own spans (`signatureSyntax`).
              if generics.length > usize.ZERO {
                generic = exported && declaresTypeParameter(hir, generics)
                if !exported { refusal = run linkageRestriction(span, true, b"generic parameters") }
                else if let Option<HirId>.Some {..} = move proofOnlyParameter(hir, generics) {
                  refusal = run linkageRestriction(span, false, b"lifetime or row parameters")
                } else if symbol.present {
                  refusal = run linkageRestriction(span, false,
                    b"an `as` symbol beside type parameters; each instantiation has its own C thunk and symbol")
                }
              }
              if isStatic { refusal = run linkageRestriction(span, !exported, b"static") }
              if isEffect { refusal = run linkageRestriction(span, !exported, b"effect") }
              if !isUnsafe && !exported {
                refusal = run namedHeaderConflict(RejectionCode.ForeignFunctionRequiresUnsafe, span, b"name", Bytes.asSlice(&functionName))
              }
              if variadic && generic { refusal = run linkageRestriction(span, false, variadicGenericRestriction()) }
              // An import names a C definition elsewhere; a Silk definition is written `export "C"`.
              if !exported {
                if let Node.Declaration {body: definition, ..} = Module.node(hir, declarations[ordinal].local) {
                  if let Node.CallableBody {block} = Module.node(hir, definition) {
                    if block.present { refusal = run linkageRestriction(span, true, b"a body; define the function with `export \"C\"` instead") }
                  }
                }
              }
              if variadic && parameters.length == usize.ZERO {
                refusal = run linkageRestriction(span, !exported,
                  b"`...` without a fixed parameter before it; C starts the variadic arguments after the last fixed one")
              }
            }
            if let Node.TextLiteral {value: text} = Module.node(hir, abi) {
              if !same(Module.text(hir, text), b"C") {
                refusal = run namedHeaderConflict(RejectionCode.UnsupportedForeignAbi, Module.span(hir, abi), b"abi", Module.text(hir, text))
              }
            }
            let mut importModule = Bytes.make()
            let mut importName = Bytes.make()
            // A WebAssembly import writes its module and field as `extern "C" as "module#name"`. An
            // empty field imports the function's own name. The native symbol is derived from the
            // pair, so two imports of one pair share it and no other declaration can. An export's
            // `#` is part of its WIT name, as in `"example:api/items@1.0.0#read"`.
            let split = wasmPairSplit(Bytes.asSlice(&symbolName))
            if split != usize.MAX && !exported {
              let pair = Bytes.asSlice(&symbolName)
              importModule = run Bytes.copy(Slice.view<u8>(pair, usize.ZERO, split))
              importName = run Bytes.copy(Slice.view<u8>(pair, split + usize.ONE, pair.length - split - usize.ONE))
              if Bytes.length(&importName) == usize.ZERO {
                if let Node.Name {text} = Module.node(hir, name) { importName = run Bytes.copy(Module.text(hir, text)) }
              }
              if !NativeForeign.validWasmName(Bytes.asSlice(&importModule)) || !NativeForeign.validWasmName(Bytes.asSlice(&importName)) {
                refusal = run namedHeaderConflict(RejectionCode.InvalidForeignSymbol, span, b"symbol", Bytes.asSlice(&symbolName))
              }
              // The pair names a host function only a wasm target links (SEM0193).
              if !same(MachineTarget.objectFormat(&resolver.target), b"wasm") {
                let mut arguments = List<MessageArgument>.make()
                let mut written = run Bytes.copy(b"`")
                run Bytes.append(&mut written, Bytes.asSlice(&importModule))
                run Bytes.append(&mut written, b"#")
                run Bytes.append(&mut written, Bytes.asSlice(&importName))
                run Bytes.append(&mut written, b"`")
                run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"symbol"), value: move written})
                let mut surface = run Bytes.copy(MachineTarget.name(&resolver.target))
                run Bytes.append(&mut surface, b"; guard the declaration with `static if Target.objectFormat() == ObjectFormat.Wasm`")
                run List<MessageArgument>.append(&mut arguments, MessageArgument {name: run Bytes.copy(b"surface"), value: move surface})
                refusal = Option<HeaderConflict>.some(HeaderConflict {code: RejectionCode.ForeignFunctionTargetUnavailable, span: span, arguments: move arguments})
              }
              let mut filled = run Bytes.copy(Bytes.asSlice(&importModule))
              run Bytes.append(&mut filled, b"#")
              run Bytes.append(&mut filled, Bytes.asSlice(&importName))
              symbolName = run wasmImportSymbol(Bytes.asSlice(&filled))
            }
            return ForeignHeader {importModule: move importModule, importName: move importName, behavior: behavior, symbol: move symbolName, refusal: move refusal, span: span, exported: exported, global: false, generic: generic, callbacks: move callbacks,
              parameterNames: move parameterNames, callbackModes: move callbackModes}
          }
        }
      }
    }
  }
  return ForeignHeader {importModule: Bytes.make(), importName: Bytes.make(), behavior: ForeignContract.conservative(), symbol: Bytes.make(), refusal: conflictAt(RejectionCode.UnsupportedForeignAbi, Span.make(usize.ZERO, usize.ZERO)), span: Span.make(usize.ZERO, usize.ZERO), exported: false, global: false, generic: false, callbacks: Bytes.make(),
    parameterNames: List<Bytes>.make(), callbackModes: List<CallbackMode>.make()}
}

pub fn backendUnit(layout: LayoutMetrics) -> bool {
  return match layout.abi { BackendAbi.Unit => true
    _ => false
  }
}

pub fn layoutIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Layout {index}} => Option<usize>.some(index)
      _ => Option<usize>.none()
    }
    _ => Option<usize>.none()
  }
}

// A C ABI rule that a reached C signature breaks, as the coded diagnostic `check` reports. The
// checker classifies every C signature a program reaches (`checkForeignClaims`, `foreignCallRefusal`),
// so the backend never meets one: there it is a compiler bug.
pub struct ForeignRefusal {
  pub diagnostic: Shared<Rejection>,
}

// Where a C refusal is reported: a call reports its callee's refusal at the call.
pub struct ForeignSite {
  pub module: ModuleId,
  pub span: Span,
}

// Demand the complete representation tree before C classification. Every child demand remains
// a dependency of the foreign declaration, so edits to nested fields invalidate its ABI. A vector
// anywhere in the tree crosses in a vector register, so the profile must select its feature.
pub effect fn foreignLayouts(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>, ty: &Interned<Type>, module: &ModuleId, span: Span,
  output: &mut TypeLayouts) -> ()
! ForeignRefusal | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let callable = run Type.copy(ty)
  if let Type.Callable {parameters, result, ..} = move callable {
    run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &result, module, span, &mut output.*)
    let listed = List<Interned<Type>>.asSlice(&parameters)
    let mut at = usize.ZERO
    while at < listed.length {
      run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at], module, span, &mut output.*)
      at = at + usize.ONE
    }
    return ()
  }
  if (run TypeLayouts.firstMatching(&output.*, ty)) != usize.MAX { return () }
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run foreignVectorRejection(&mut resolver.*, module, ty, span) {
    fail ForeignRefusal {diagnostic: move diagnostic}
  }
  let application = run internErasedType(&mut resolver.*, ty)
  let request = Key {family: Family.Layout, module: usize.ZERO, name: application, declaration: usize.ZERO, member: usize.ZERO, external: false}
  let key = run internDeclaration(&mut resolver.*, request)
  let answer = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
  let index = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, layoutIndex) {
    Option<usize>.Some {value} => value
    _ => {
      // A type with no layout was refused where it was written; that refusal is the cause.
      if let Option<Shared<Rejection>>.Some {value: cause} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&answer, answerCause) {
        fail ForeignRefusal {diagnostic: move cause}
      }
      return CompilerBug.panic(b"an admitted C lane has neither a layout nor a refusal")
    }
  }
  let layouts = List<Interned<BackendLayout>>.asSlice(&resolver.layoutValues)
  let layout = Interned<BackendLayout>.clone(&layouts[index])
  run TypeLayouts.append(&mut output.*, TypeLayout {ty: Interned<Type>.clone(ty), layout: Interned<BackendLayout>.clone(&layout)})
  let count = Interned<BackendLayout>.with<usize>(&layout, BackendLayout.childCount)
  let mut at = usize.ZERO
  while at < count {
    let child = Interned<BackendLayout>.with<Option<Interned<Type>>>(&layout, |value: &BackendLayout| -> Option<Interned<Type>> {
      return BackendLayout.childAt(value, at)
    })
    if let Option<Interned<Type>>.Some {value} = move child {
      run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, &value, module, span, &mut output.*)
    }
    at = at + usize.ONE
  }
  return ()
}

// Classifies one C lane: a C-admitted type (SEM0187) whose representation the target's C ABI
// passes (SEM0244 for a vector, SEM0187 for a record no C compiler lays out the same way).
pub effect fn foreignLane(resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>, ty: &Interned<Type>, module: &ModuleId, span: Span, result: bool) -> CAbi.Lane
! ForeignRefusal | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if !CAbi.supported(&resolver.target) { return CompilerBug.panic(b"a target without a C ABI classified a C lane") }
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move run foreignTypeGap(&mut resolver.*, module, ty, span) {
    fail ForeignRefusal {diagnostic: move diagnostic}
  }
  let mut layouts = TypeLayouts.make()
  run foreignLayouts(&mut resolver.*, &mut owner.*, &mut dependencies.*, ty, module, span, &mut layouts)
  if let Option<CAbi.Lane>.Some {value} = move run CAbi.classify(ty, &layouts, &resolver.target, result) { return move value }
  fail ForeignRefusal {diagnostic: run foreignTypeRefusal(module, ty, span, b"0")}
}

// SEM0187 for `ty` with catalog template `template`.
pub effect fn foreignTypeRefusal(module: &ModuleId, ty: &Interned<Type>, span: Span, template: &[u8]) -> Shared<Rejection>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut refused = run makeRejection(RejectionCode.ForeignType, module, span)
  if let Option<Bytes>.Some {value: text} = move run TypeText.displayElided(ty, module) {
    run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"template"), value: run Bytes.copy(template)})
    run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"type"), value: move text})
    run List<MessageArgument>.append(&mut refused.arguments, MessageArgument {name: run Bytes.copy(b"abi"), value: run Bytes.copy(b"C")})
  }
  return run Shared<Rejection>.make(move refused)
}

pub effect fn copyMirExterns(resolver: &Resolver, index: usize) -> List<Interned<DeclarationId>> ! OutOfMemoryError ? &mut Allocator {
  let functions = List<MirFunction>.asSlice(&resolver.mirValues)
  let entries = List<Interned<DeclarationId>>.asSlice(&functions[index].externs)
  let mut copied = run List<Interned<DeclarationId>>.makeWithCapacity(entries.length)
  let mut at = usize.ZERO
  while at < entries.length {
    run List<Interned<DeclarationId>>.append(&mut copied, Interned<DeclarationId>.clone(&entries[at]))
    at = at + usize.ONE
  }
  return move copied
}

pub effect fn foreignSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  declaration: &Interned<DeclarationId>,
  site: &Option<ForeignSite>,
) -> CAbi.Signature
! ForeignRefusal | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  // The C allocator functions the storage primitives expand to have compiler-owned signatures.
  let sealed = Interned<DeclarationId>.with<Option<SealedFunction>>(declaration, SealedCore.declarationFunction)
  if let Option<SealedFunction>.Some {value: selected} = move sealed {
    let span = Span.make(usize.ZERO, usize.ZERO)
    let sealedModule = Interned<DeclarationId>.with<ModuleId>(declaration, |value: &DeclarationId| -> ModuleId {
      return ModuleId.copy(DeclarationId.moduleId(value))
    })
    let resultType = run SealedCore.cResult(selected)
    let result = run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &resultType, &sealedModule, span, true)
    let written = run SealedCore.cParameters(selected)
    let listed = List<Interned<Type>>.asSlice(&written)
    let mut lanes = run List<CAbi.Lane>.makeWithCapacity(listed.length)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<CAbi.Lane>.append(&mut lanes, run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &listed[at],
        &sealedModule, span, false))
      at = at + usize.ONE
    }
    return CAbi.Signature {importModule: Bytes.make(), importName: Bytes.make(), behavior: ForeignContract.conservative(), callbackContracts: Bytes.make(), declaration: Interned<DeclarationId>.clone(declaration), symbol: run Bytes.copy(SealedCore.cSymbol(selected)),
      source: GapSource.Declaration {declaration: Interned<DeclarationId>.clone(declaration), span: span}, result: move result, parameters: move lanes, global: false, variadic: false}
  }
  let key = run InstanceKey.named(declaration)
  let found = run locationOfInstance(&mut resolver.*, &key)
  let location = match move found {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => { return CompilerBug.panic(b"a C signature names a declaration outside every module") }
  }
  let module = resolvedModule(&resolver.*, location.module)
  let written = run foreignHeader(&mut resolver.*, &module, location.declaration)
  // A Silk call to an exported definition calls its C symbol, as an import of the same symbol
  // binds to the export.
  return run cSignature(&mut resolver.*, &mut owner.*, &mut dependencies.*, declaration, location, move written, site)
}

// Classifies the C lanes of one linked function whose header admitted the C contract.
pub fn nativeFunctionPointer(value: &Type) -> bool {
  return match &value.* { Type.ForeignFunction {..} => true _ => false }
}

pub fn nullableNativeFunctionPointer(value: &Type) -> bool {
  return match &value.* { Type.ForeignFunction {nullable, ..} => nullable _ => false }
}

// A callback that may run on another thread, after the call that received it has returned, takes
// no reference: no loan of the caller's could last until it runs.
fn referenceFreeCallback(value: &Type) -> bool {
  if let Type.ForeignFunction {signature, ..} = &value.* {
    return Interned<Type>.with<bool>(&signature, referenceFreeParameters)
  }
  return false
}

pub fn referenceFreeParameters(value: &Type) -> bool {
  if let Type.Callable {parameters, ..} = &value.* {
    let listed = List<Interned<Type>>.asSlice(&parameters)
    let mut at = usize.ZERO
    while at < listed.length {
      if Interned<Type>.with<bool>(&listed[at], borrowedLane) { return false }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

pub fn borrowedLane(value: &Type) -> bool {
  return match &value.* { Type.Reference {..} => true Type.Slice {..} => true _ => false }
}

// Lists describe leaves reached only through by-value C structs. Raw pointers and references
// are traversal boundaries: their pointees are the unsafe caller's ownership responsibility.
fn callbackDirective(kind: DirectiveKind) -> bool {
  return kind == DirectiveKind.Callbacks || kind == DirectiveKind.ThreadCallbacks || kind == DirectiveKind.DeferredCallbacks
}

// The invocation mode a callback directive promises for the callbacks it lists.
fn callbackMode(kind: DirectiveKind) -> Option<ForeignCallbacks> {
  if kind == DirectiveKind.Callbacks { return Option<ForeignCallbacks>.some(ForeignCallbacks.Synchronous) }
  if kind == DirectiveKind.ThreadCallbacks { return Option<ForeignCallbacks>.some(ForeignCallbacks.Thread) }
  if kind == DirectiveKind.DeferredCallbacks { return Option<ForeignCallbacks>.some(ForeignCallbacks.Deferred) }
  return Option<ForeignCallbacks>.none()
}

struct CallbackLeaf { path: Bytes, position: Bytes, ty: Interned<Type> }

effect fn callbackLeaves(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  ty: &Interned<Type>, path: &[u8], position: &[u8], span: Span, active: &mut List<Interned<Type>>, leaves: &mut List<CallbackLeaf>,
) -> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if Interned<Type>.with<bool>(ty, nativeFunctionPointer) {
    run List<CallbackLeaf>.append(&mut leaves.*, CallbackLeaf {path: run Bytes.copy(path), position: run Bytes.copy(position), ty: Interned<Type>.clone(ty)})
    return true
  }
  // Callback-bearing arrays have no admitted path syntax. Reject them rather than hiding their
  // callbacks; ordinary fixed-array fields remain valid C data.
  let array = Interned<Type>.with<Option<Interned<Type>>>(ty, |value: &Type| -> Option<Interned<Type>> {
    return match &value.* { Type.Array {element, ..} => Option<Interned<Type>>.some(Interned<Type>.clone(&element)) _ => Option<Interned<Type>>.none() }
  })
  if let Option<Interned<Type>>.Some {value: element} = move array {
    let before = List<CallbackLeaf>.length(&leaves.*)
    if !run callbackLeaves(&mut resolver.*, &mut owner.*, &mut dependencies.*, &element, path, position, span, &mut active.*, &mut leaves.*) { return false }
    return before == List<CallbackLeaf>.length(&leaves.*)
  }
  let nominal = Interned<Type>.with<bool>(ty, |value: &Type| -> bool { return match &value.* { Type.Nominal {..} => true _ => false } })
  if !nominal { return true }
  let external = match move run structLayout(&mut resolver.*, ty) { Option<bool>.Some {value} => value _ => false }
  if !external { return true }
  let ancestors = List<Interned<Type>>.asSlice(&active.*)
  let mut ancestor = usize.ZERO
  while ancestor < ancestors.length {
    if run Type.equalsShared(&ancestors[ancestor], ty) { return false }
    ancestor = ancestor + usize.ONE
  }
  run List<Interned<Type>>.append(&mut active.*, Interned<Type>.clone(ty))
  let names = run recordFieldNames(&mut resolver.*, ty)
  let fields = List<Bytes>.asSlice(&names)
  let moduleAt = declaringModuleOrdinal(&resolver.*, ty)
  let module = resolvedModule(&resolver.*, moduleAt)
  let declaration = match move run ordinalOfProvider(&mut resolver.*, &module, ty) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let application = run internApplication(&mut resolver.*, ty)
  let mut at = usize.ZERO
  while at < fields.length {
    let key = run internDeclaration(&mut resolver.*, Key {family: Family.MemberShape, module: moduleAt, name: application,
      declaration: declaration, member: at, external: false})
    let shaped = run demandChild(&mut resolver.*, &mut owner.*, &mut dependencies.*, key, span)
    let field = match move Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(&shaped, singleMemberType) {
      Option<Interned<Type>>.Some {value} => move value
      Option<Interned<Type>>.None => { return false }
    }
    let mut nested = run Bytes.copy(path)
    run Bytes.append(&mut nested, b".")
    run Bytes.append(&mut nested, Bytes.asSlice(&fields[at]))
    let mut nestedPosition = run Bytes.copy(position)
    run RuntimeEncoding.word(&mut nestedPosition, usize.toU64(at))
    if !run callbackLeaves(&mut resolver.*, &mut owner.*, &mut dependencies.*, &field, Bytes.asSlice(&nested),
      Bytes.asSlice(&nestedPosition), span, &mut active.*, &mut leaves.*) { return false }
    at = at + usize.ONE
  }
  drop List<Interned<Type>>.pop(&mut active.*)
  return true
}

// This is a signature obligation, not a call-site/backend check. Resolving aliases and field
// shapes here also records the dependencies needed when an uncalled aggregate is edited.
pub effect fn resolvedCallbackParameters(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  location: InstanceLocation, types: &[Interned<Type>], span: Span,
) -> bool ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, location.module)
  // Only the declaration's header and directives are read, so an edit elsewhere in its module
  // leaves the signature current.
  drop run observedDeclaration(&mut resolver.*, &module, location.declaration, SourceFacet.Directives)
  let observed = run observedDeclaration(&mut resolver.*, &module, location.declaration, SourceFacet.Header)
  let mut names = List<Bytes>.make()
  let mut listed = List<Bytes>.make()
  // Whether each listed callback's mode lets native code retain it.
  let mut retained = List<bool>.make()
  let mut referenceFree = false
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&resolver.*, &observed, &module) {
    let hir = IndexedSource.authored(indexed)
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    if let Node.FunctionHeader {contract, ..} = Module.node(hir, declarations[location.declaration].header) {
      if let Option<HirContract>.Some {value: HirContract {parameters, ..}} = Module.contractOf(hir, contract) {
        let mut at = usize.ZERO
        while at < parameters.length {
          let mut spelling = Bytes.make()
          if let Node.Parameter {name, ..} = Module.node(hir, Module.child(hir, parameters, at)) {
            if let Node.Name {text} = Module.node(hir, name) { spelling = run Bytes.copy(Module.text(hir, text)) }
          }
          run List<Bytes>.append(&mut names, move spelling)
          at = at + usize.ONE
        }
        let directives = Directives.of(hir, declarations[location.declaration].local)
        at = usize.ZERO
        while at < directives.length {
          let id = Module.child(hir, directives, at)
          if let Option<DirectiveKind>.Some {value: kind} = Directives.kindOf(hir, id) {
            if callbackDirective(kind) {
              if kind == DirectiveKind.DeferredCallbacks { referenceFree = true }
              let elements = run Directives.texts(hir, id)
              let entries = List<HirId>.asSlice(&elements)
              if entries.length == usize.ZERO { return false }
              let mut entry = usize.ZERO
              while entry < entries.length {
                if let Node.TextLiteral {value: spelling} = Module.node(hir, entries[entry]) {
                  run List<Bytes>.append(&mut listed, run Bytes.copy(Module.text(hir, spelling)))
                  run List<bool>.append(&mut retained, kind != DirectiveKind.Callbacks)
                } else { return false }
                entry = entry + usize.ONE
              }
            }
            if kind == DirectiveKind.InvokesDeferredCallbacks { referenceFree = true }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  drop observed
  let parameterNames = List<Bytes>.asSlice(&names)
  if parameterNames.length != types.length { return false }
  let mut leaves = List<CallbackLeaf>.make()
  let mut active = List<Interned<Type>>.make()
  let mut parameter = usize.ZERO
  while parameter < types.length {
    if referenceFree && Interned<Type>.with<bool>(&types[parameter], borrowedLane) { return false }
    if !run callbackLeaves(&mut resolver.*, &mut owner.*, &mut dependencies.*, &types[parameter],
      Bytes.asSlice(&parameterNames[parameter]), b"", span, &mut active, &mut leaves) { return false }
    parameter = parameter + usize.ONE
  }
  let found = List<CallbackLeaf>.asSlice(&leaves)
  let entries = List<Bytes>.asSlice(&listed)
  if found.length != entries.length { return false }
  let mut at = usize.ZERO
  while at < entries.length {
    let mut earlier = usize.ZERO
    while earlier < at {
      if same(Bytes.asSlice(&entries[earlier]), Bytes.asSlice(&entries[at])) { return false }
      earlier = earlier + usize.ONE
    }
    let mut selected = false
    let mut leaf = usize.ZERO
    while leaf < found.length {
      if same(Bytes.asSlice(&entries[at]), Bytes.asSlice(&found[leaf].path)) {
        selected = !List<bool>.get(&retained, at) || Interned<Type>.with<bool>(&found[leaf].ty, referenceFreeCallback)
      }
      leaf = leaf + usize.ONE
    }
    if !selected { return false }
    at = at + usize.ONE
  }
  return true
}

// Every callback leaf, direct or in a by-value record, as its lane position, the mode of the list
// that names it, and its native signature. Two declarations of one symbol that give a callback
// different modes therefore differ.
effect fn callbackContractIdentity(
  resolver: &mut Resolver, owner: &mut Query<Answer, NoRejection>, dependencies: &mut List<Dependency>,
  declaration: &Interned<DeclarationId>, lanes: &[CAbi.Lane], names: &[Bytes], modes: &[CallbackMode], module: &ModuleId, span: Span,
) -> Bytes ! ForeignRefusal | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if names.length != lanes.length { fail ForeignRefusal {diagnostic: run reject(&resolver.*, module, RejectionCode.ForeignCallback, span)} }
  let mut leaves = List<CallbackLeaf>.make()
  let mut active = List<Interned<Type>>.make()
  let mut at = usize.ZERO
  while at < lanes.length {
    let mut position = Bytes.make()
    run RuntimeEncoding.word(&mut position, usize.toU64(at))
    if !run callbackLeaves(&mut resolver.*, &mut owner.*, &mut dependencies.*, &lanes[at].ty, Bytes.asSlice(&names[at]),
      Bytes.asSlice(&position), span, &mut active, &mut leaves) {
      fail ForeignRefusal {diagnostic: run reject(&resolver.*, module, RejectionCode.ForeignCallback, span)}
    }
    at = at + usize.ONE
  }
  let mut encoded = Bytes.make()
  let identity = DeclarationId.copyShared(declaration)
  let listed = List<CallbackLeaf>.asSlice(&leaves)
  run RuntimeEncoding.word(&mut encoded, usize.toU64(listed.length))
  at = usize.ZERO
  while at < listed.length {
    let mut code: u64 = 0
    let mut entry = usize.ZERO
    while entry < modes.length {
      if same(Bytes.asSlice(&modes[entry].path), Bytes.asSlice(&listed[at].path)) { code = ForeignCallbacks.code(modes[entry].mode) }
      entry = entry + usize.ONE
    }
    if code == 0 { fail ForeignRefusal {diagnostic: run reject(&resolver.*, module, RejectionCode.ForeignCallback, span)} }
    run RuntimeEncoding.field(&mut encoded, Bytes.asSlice(&listed[at].position))
    run RuntimeEncoding.word(&mut encoded, code)
    let callback = run Type.runtimeEncoding(&listed[at].ty, &identity)
    run RuntimeEncoding.field(&mut encoded, Bytes.asSlice(&callback))
    at = at + usize.ONE
  }
  return move encoded
}

// Classifies the C signature of one linked declaration whose header admitted the C contract. This
// is the one classification: `check` runs it for every export and at every call of an import
// (`checkForeignClaims`, `foreignCallRefusal`), and emission reuses it. Each lane refusal names
// its own parameter; a call reports it at the call instead.
pub effect fn cSignature(
  resolver: &mut Resolver,
  owner: &mut Query<Answer, NoRejection>,
  dependencies: &mut List<Dependency>,
  declaration: &Interned<DeclarationId>,
  location: InstanceLocation,
  written: ForeignHeader,
  site: &Option<ForeignSite>,
) -> CAbi.Signature
! ForeignRefusal | Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let module = resolvedModule(&resolver.*, location.module)
  // The signature check reported the header's own refusal (`resolveSignatureUnder`).
  if let Option<HeaderConflict>.Some {value: conflict} = &written.refusal {
    fail ForeignRefusal {diagnostic: run headerRejection(&module, &conflict)}
  }
  // The module every refusal below is reported in; a call's site replaces each lane's own span.
  let mut reported = ModuleId.copy(&module)
  let mut fixed = Option<Span>.none()
  if let Option<ForeignSite>.Some {value: call} = &site.* {
    reported = ModuleId.copy(&call.module)
    fixed = Option<Span>.some(call.span)
  }
  let mut headerSpan = written.span
  if let Option<Span>.Some {value} = &fixed { headerSpan = value }
  if written.global {
    // A C object has one lane: the value its address holds.
    let selected = run foreignStaticType(&mut resolver.*, &mut owner.*, &mut dependencies.*, location.module, location.declaration, written.span)
    let objectType = match move selected {
      Result<Interned<Type>, Shared<Rejection>>.Success {value} => move value
      Result<Interned<Type>, Shared<Rejection>>.Failure {error} => { fail ForeignRefusal {diagnostic: move error} }
    }
    let object = run foreignLane(&mut resolver.*, &mut owner.*, &mut dependencies.*, &objectType, &reported, headerSpan, true)
    return CAbi.Signature {
      importModule: Bytes.make(), importName: Bytes.make(),
      behavior: ForeignContract.conservative(), callbackContracts: Bytes.make(),
      declaration: Interned<DeclarationId>.clone(declaration),
      symbol: run linkedSymbol(&resolver.*, move written.symbol),
      source: GapSource.Declaration {declaration: Interned<DeclarationId>.clone(declaration), span: written.span},
      result: move object,
      parameters: List<CAbi.Lane>.make(),
      global: true,
      variadic: false,
    }
  }
  let declarationAccess197Request = Key {
      family: Family.Signature,
      module: location.module,
      name: usize.ZERO,
      declaration: location.declaration,
      member: usize.ZERO,
      external: false,
    }
  let declarationAccess197 = run internDeclaration(&mut resolver.*, declarationAccess197Request)
  let signature = run demandChild(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    declarationAccess197,
    written.span,
  )
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(
    &signature,
    signatureResult,
  )
  let resultType = match move selected {
    Option<Interned<Type>>.Some {value} => move value
    Option<Interned<Type>>.None => {
      // A refused signature was reported as it is; its C lanes are not classified.
      if let Option<Shared<Rejection>>.Some {value: cause} = move Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(&signature, answerCause) {
        fail ForeignRefusal {diagnostic: move cause}
      }
      return CompilerBug.panic(b"a C signature has neither a result nor a refusal")
    }
  }
  // Each lane refusal names its own written type, as the signature check does.
  let mut laneSpans = List<Span>.make()
  let mut resultSpan = headerSpan
  if let Option<Span>.None = &fixed {
  if let Option<WrittenSignature>.Some {value: syntax} = move run signatureSyntax(&mut resolver.*, &module, location.declaration) {
    let entries = List<HirId>.asSlice(&syntax.parameters)
    let mut entry = usize.ZERO
    while entry < entries.length {
      run List<Span>.append(&mut laneSpans, run parameterSpanOr(&mut resolver.*, &module, entries[entry], written.span))
      entry = entry + usize.ONE
    }
    if let Option<HirId>.Some {value: id} = &syntax.result { resultSpan = run parameterSpanOr(&mut resolver.*, &module, id, written.span) }
  }
  }
  let mut parameters = List<CAbi.Lane>.make()
  let count = Shared<Result<Answer, NoRejection>>.with<usize>(&signature, signatureParameterCount)
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<Interned<Type>>>(
      &signature,
      |answer: &Result<Answer, NoRejection>| -> Option<Interned<Type>> {
        return signatureParameterAt(answer, at)
      },
    )
    if let Option<Interned<Type>>.Some {value} = move selected {
      let mut laneSpan = headerSpan
      if at < List<Span>.length(&laneSpans) { laneSpan = List<Span>.asSlice(&laneSpans)[at] }
      let lane = run foreignLane(
        &mut resolver.*,
        &mut owner.*,
        &mut dependencies.*,
        &value,
        &reported,
        laneSpan,
        false,
      )
      // `()` is a C result (`void`) but no C parameter: a C function that takes nothing has none.
      if backendUnit(lane.layout) {
        fail ForeignRefusal {diagnostic: run foreignTypeRefusal(&reported, &value, laneSpan, b"5")}
      }
      run List<CAbi.Lane>.append(&mut parameters, move lane)
    }
    at = at + usize.ONE
  }
  // The result is classified after the parameters, so the first refusal follows source order.
  if Interned<Type>.with<bool>(&resultType, nativeFunctionPointer) {
    fail ForeignRefusal {diagnostic: run reject(&resolver.*, &reported, RejectionCode.ForeignCallback, resultSpan)}
  }
  let result = run foreignLane(
    &mut resolver.*,
    &mut owner.*,
    &mut dependencies.*,
    &resultType,
    &reported,
    resultSpan,
    true,
  )
  CAbi.assignArguments(&mut parameters, &result, &resolver.target)
  let mut callbackContracts = Bytes.make()
  if ForeignContract.hasCallbacks(written.behavior) {
    callbackContracts = run callbackContractIdentity(&mut resolver.*, &mut owner.*, &mut dependencies.*, declaration,
      List<CAbi.Lane>.asSlice(&parameters), List<Bytes>.asSlice(&written.parameterNames),
      List<CallbackMode>.asSlice(&written.callbackModes), &reported, headerSpan)
  }
  let variadic = Shared<Result<Answer, NoRejection>>.with<bool>(&signature, signatureIsVariadic)
  return CAbi.Signature {
    importModule: move written.importModule, importName: move written.importName,
    behavior: written.behavior, callbackContracts: move callbackContracts,
    declaration: Interned<DeclarationId>.clone(declaration),
    symbol: run linkedSymbol(&resolver.*, move written.symbol),
    source: GapSource.Declaration {declaration: Interned<DeclarationId>.clone(declaration), span: written.span},
    result: move result,
    parameters: move parameters,
    global: false,
    variadic: variadic,
  }
}

// The name the object file holds for the native symbol `written`. A Mach-O linker-defined section
// or segment bound (`section$start$__DATA$__silk_seen`) is not a C name, so it takes LLVM's `\x01`
// prefix, which keeps the leading underscore of C names off it.
pub effect fn linkedSymbol(resolver: &Resolver, written: Bytes) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if !same(MachineTarget.objectFormat(&resolver.target), b"macho") || !NativeForeign.machoBoundSymbol(Bytes.asSlice(&written)) {
    return move written
  }
  let mut linked = run Bytes.copy(b"\x01")
  run Bytes.append(&mut linked, Bytes.asSlice(&written))
  return move linked
}
