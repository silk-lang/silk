import semantic.ModuleId {InvalidModulePath}
import semantic.Query {Cycle}
import semantic.Semantic {Semantic, Request, Answer}
import semantic.SemanticCaseSupport {module, staticSemantic, hasBorrowStatus, rejection, rejectsSpan}
import semantic.Rejection {Rejection, RejectionCode, stableCode}
import semantic.SourceIndex {RevisionMismatch, NoRejection}
import semantic.Target {Target, Id as TargetId}
import semantic.TypedBody {BorrowStatus}
import semantic.Types {TypeTable, Types}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.testing {Testing, AssertionError}
import silk.shared {Shared}
import silk.result {Result}
import silk.option {Option}
import silk.native_descriptor {NativeDescriptor}
import silk.string {String}
import silk.slice {Slice}

effect fn report(name: &[u8], text: string, answer: &Shared<Result<Answer, NoRejection>>) -> () {
  let mut error = 0
  drop run NativeDescriptor.writeAll(2, name, &mut error)
  drop run NativeDescriptor.writeAll(2, b": ", &mut error)
  if hasBorrowStatus(answer, BorrowStatus.Checked) { drop run NativeDescriptor.writeAll(2, b"Checked", &mut error) }
  else if hasBorrowStatus(answer, BorrowStatus.Regions) { drop run NativeDescriptor.writeAll(2, b"Regions", &mut error) }
  else if hasBorrowStatus(answer, BorrowStatus.Imprecise) { drop run NativeDescriptor.writeAll(2, b"Imprecise", &mut error) }
  else {
    let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, rejection)
    if let Option<Shared<Rejection>>.Some {value} = move found {
      let code = Shared<Rejection>.with<RejectionCode>(&value, fn(r: &Rejection) -> RejectionCode { return r.code })
      let start = Shared<Rejection>.with<usize>(&value, fn(r: &Rejection) -> usize { return r.span.start })
      let end = Shared<Rejection>.with<usize>(&value, fn(r: &Rejection) -> usize { return r.span.end })
      drop run NativeDescriptor.writeAll(2, stableCode(code), &mut error)
      drop run NativeDescriptor.writeAll(2, b" @ ", &mut error)
      drop run NativeDescriptor.writeAll(2, Slice.view<u8>(String.utf8Bytes(text), start, end - start), &mut error)
    } else { drop run NativeDescriptor.writeAll(2, b"OTHER", &mut error) }
  }
  drop run NativeDescriptor.writeAll(2, b"\n", &mut error)
}

test effect fn anonymousFiniteResultTrial() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run anonymousClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("anonymous-result-calls.silk")
  let text = """
struct Token { value: i32 }
interface Both { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 }
impl Both for Token { fn both<'w, 'v: 'w>(self: &Self, a: &'v i32, b: &'v i32) -> &'w i32 { return b } }
fn bothDirect<'w, 'v: 'w>(self: &Token, a: &'v i32, b: &'v i32) -> &'w i32 { return b }
fn makeDirect<'w, 'v: 'w>(self: &Token, head: &'v i32) -> &'w i32 { return head }
fn apply<'a>(t: &'a Token, h: &'a i32, f: fn(&'a Token, &'a i32) -> &'a i32) -> &'a i32 { return f(t, h) }
fn constrain<'a, 'x: 'a>(anchor: &'a i32, left: &'x i32, right: &'x i32) -> i32 { return anchor.* }
fn wr2lDirect<'a>(t: &'a Token, h: &'a i32) -> &'a i32 { return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 { let l = 5 let r = bothDirect(x, y, &l) return y }) }
fn wr2lInterface<'a>(t: &'a Token, h: &'a i32) -> &'a i32 { return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 { let l = 5 let r = Both.both(x, y, &l) return y }) }
fn nested<'a>(t: &'a Token, h: &'a i32) -> &'a i32 {
  return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 {
    return apply(x, y, fn(xx: &'a Token, yy: &'a i32) -> &'a i32 {
      let l = 5 let r = bothDirect(xx, yy, &l) return yy
    })
  })
}
fn capturedCaller<'p>(t: &Token, h: &'p i32) -> i32 {
  let g = fn() -> i32 { let l = 5 let r = bothDirect(t, h, &l) return r.* }
  return g()
}
fn callerEscape<'a>(t: &'a Token, h: &'a i32) -> &'a i32 {
  return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 { let l = 5 return bothDirect(x, y, &l) })
}
fn staticEscape(t: &Token) -> &'static i32 {
  let g = fn(x: &Token) -> &'static i32 { let l = 5 return makeDirect(x, &l) }
  return g(t)
}
fn capturedStatic<'p>(t: &Token, h: &'p i32) -> &'static i32 {
  let g = fn() -> &'static i32 { return makeDirect(t, h) }
  return g()
}
fn nestedEscape<'a>(t: &'a Token, h: &'a i32) -> &'a i32 {
  return apply(t, h, fn(x: &'a Token, y: &'a i32) -> &'a i32 {
    return apply(x, y, fn(xx: &'a Token, yy: &'a i32) -> &'a i32 { let l = 5 return bothDirect(xx, yy, &l) })
  })
}
fn pendingPlain<'p>(h: &'p i32) -> i32 {
  let g = fn(y: &'p i32) -> i32 { let l = 5 return constrain(y, &y.*, &l) }
  return g(h)
}
fn pendingShortened<'p>(t: &Token, h: &'p i32) -> i32 {
  let g = fn(x: &Token, y: &'p i32) -> i32 {
    let l = 5 let r = bothDirect(x, y, &l)
    let n = constrain(y, &y.*, &l)
    return r.* + n
  }
  return g(t, h)
}
"""
  let mut store = run staticSemantic(&id, text, Target.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let wr2lDirect = run Semantic.demandBody(&mut store, &mut request, &id, b"wr2lDirect")
  run report(b"wr2lDirect", text, &wr2lDirect)
  let wr2lInterface = run Semantic.demandBody(&mut store, &mut request, &id, b"wr2lInterface")
  run report(b"wr2lInterface", text, &wr2lInterface)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  run report(b"nested", text, &nested)
  let capturedCaller = run Semantic.demandBody(&mut store, &mut request, &id, b"capturedCaller")
  run report(b"capturedCaller", text, &capturedCaller)
  let callerEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"callerEscape")
  run report(b"callerEscape", text, &callerEscape)
  let staticEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"staticEscape")
  run report(b"staticEscape", text, &staticEscape)
  let capturedStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"capturedStatic")
  run report(b"capturedStatic", text, &capturedStatic)
  let nestedEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedEscape")
  run report(b"nestedEscape", text, &nestedEscape)
  let pendingPlain = run Semantic.demandBody(&mut store, &mut request, &id, b"pendingPlain")
  run report(b"pendingPlain", text, &pendingPlain)
  let pendingShortened = run Semantic.demandBody(&mut store, &mut request, &id, b"pendingShortened")
  run report(b"pendingShortened", text, &pendingShortened)
  run Testing.expect(hasBorrowStatus(&wr2lDirect, BorrowStatus.Checked), "wr2lDirect must prove the complete finite body")
  run Testing.expect(hasBorrowStatus(&wr2lInterface, BorrowStatus.Checked), "wr2lInterface must prove the complete finite body")
  run Testing.expect(hasBorrowStatus(&nested, BorrowStatus.Checked), "nested must prove the complete finite body")
  run Testing.expect(hasBorrowStatus(&capturedCaller, BorrowStatus.Checked), "capturedCaller must prove the complete finite body")
  run Testing.expect(hasBorrowStatus(&pendingPlain, BorrowStatus.Regions), "an unrelated pending literal remains explicitly unchecked")
  return ()
}
