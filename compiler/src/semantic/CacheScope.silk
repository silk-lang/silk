//! Canonical semantic scope for a one-process cache guard certificate.
//!
//! Source identities come from the driver's complete immutable source map, not the set of
//! modules parsed or interned while consulting caches. Content digests are checked by anchors;
//! scope identifies application, report root, profile, schema registration and present roster.

import semantic.ContentHash {ContentHash}
import semantic.ModuleId {ModuleId}
import semantic.RuntimeEncoding
import semantic.SourceRevision {Observation}
import semantic.StableKey
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.order {Order, Ordering}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

struct Named {module: ModuleId}
impl Order for Named {
  fn compare(left: &Named, right: &Named) -> Ordering {
    let comparison = ModuleId.compare(&left.module, &right.module)
    if comparison < 0 { return Ordering.Less }
    if comparison > 0 { return Ordering.Greater }
    return Ordering.Equal
  }
}

effect fn names(values: List<Named>) -> ContentHash ! OutOfMemoryError ? &mut Allocator {
  let mut ordered = move values
  run List<Named>.sort(&mut ordered)
  let modules = List<Named>.asSlice(&ordered)
  let mut stream = ContentHash.stream()
  let mut encoded = Bytes.make()
  // Stable module encodings are self-delimiting, so concatenation preserves exact boundaries.
  let mut at = usize.ZERO
  while at < modules.length {
    if at == usize.ZERO || !ModuleId.equals(&modules[at].module, &modules[at - usize.ONE].module) {
      Bytes.clear(&mut encoded)
      run StableKey.module(&mut encoded, &modules[at].module)
      ContentHash.append(&mut stream, Bytes.asSlice(&encoded))
    }
    at = at + usize.ONE
  }
  return ContentHash.finish(move stream)
}

/// Encodes semantic request scope independently of source publication or parsing order.
/// A caller must still validate current file and non-file anchors; this is not a content proof.
pub effect fn context(application: &[u8], reportRoot: &[u8], profile: &[u8], schemas: &[ModuleId], present: &[Observation])
-> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut registered = List<Named>.make()
  let mut at = usize.ZERO
  while at < schemas.length { run List<Named>.append(&mut registered, Named {module: ModuleId.copy(&schemas[at])}) at = at + usize.ONE }
  let schema = run names(move registered)
  let mut modules = List<Named>.make()
  at = usize.ZERO
  while at < present.length {
    if Observation.isPresent(&present[at]) {
      run List<Named>.append(&mut modules, Named {module: ModuleId.copy(Observation.moduleId(&present[at]))})
    }
    at = at + usize.ONE
  }
  let roster = run names(move modules)
  let mut output = Bytes.make()
  run RuntimeEncoding.field(&mut output, b"silk-cache-guard-scope-v1")
  run RuntimeEncoding.field(&mut output, application)
  run RuntimeEncoding.field(&mut output, reportRoot)
  run RuntimeEncoding.field(&mut output, profile)
  run RuntimeEncoding.word(&mut output, schema.high)
  run RuntimeEncoding.word(&mut output, schema.low)
  run RuntimeEncoding.word(&mut output, roster.high)
  run RuntimeEncoding.word(&mut output, roster.low)
  return move output
}
