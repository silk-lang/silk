}

pub effect fn demandCatalog(thisStore: &mut Semantic, request: &mut Request, benchmarks: bool) -> Result<Shared<TestCatalog>, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let root = match &thisStore.resolver.discovery {
    Option<Discovery>.Some {value} => ModuleId.copy(&value.root)
    Option<Discovery>.None => {
      let sealed = run ModuleId.make(b"compiler-sealed-intrinsic", b"silk", b"Intrinsic")
      return Result<Shared<TestCatalog>, Shared<Rejection>>.failResult(
        run reject(&thisStore.resolver, &sealed, RejectionCode.StaticPhaseViolation, Span.make(usize.ZERO, usize.ZERO)))
    }
  }
  let mut kind = usize.ZERO
  if benchmarks { kind = usize.ONE }
  let declarationAccess252Request = Key {family: Family.Tests, module: run internModule(&mut thisStore.resolver, &root), name: usize.ZERO,
    declaration: usize.ZERO, member: kind, external: false}
  let declarationAccess252 = run internDeclaration(&mut thisStore.resolver, declarationAccess252Request)
  let key = declarationAccess252
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, key, Span.make(usize.ZERO, usize.ZERO))
  run recordRoot(&mut request.*, Family.Tests, &root, b"", &answer)
  return run answeredTests(&thisStore.resolver, &answer, &root, Span.make(usize.ZERO, usize.ZERO))
}

/// Updates this revisable store to `revision`.
///
/// # Details
///
/// Before any key/cache/location access, all pending observed modules are reconciled.
/// Surviving identities retain handles; intermediate deletion or absence ends them.
/// Changed consumed source inputs and raw source readers invalidate their result dependers.
/// Publication reserves history before mutation; failed reconciliation remains retryable.
pub effect fn update(thisStore: &mut Semantic, revision: Revision) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !thisStore.resolver.revisable { CompilerBug.panic(b"cannot update a store opened for one revision") }
  // Prepare every history append before SourceIndex publishes the new revision. Modules are
  // precisely this session's observed/interned set, not the project's declaration catalog.
  let mut observations = List<List<Observation>>.make()
  let modules = List<ModuleId>.asSlice(&thisStore.resolver.modules)
  let mut at = usize.ZERO
  while at < modules.length {
    let mut history = List<Observation>.make()
    run List<Observation>.append(&mut history, run Revision.observe(&revision, &modules[at]))
    run List<List<Observation>>.append(&mut observations, move history)
    at = at + usize.ONE
  }
  run List<DeclarationChange>.reserve(&mut thisStore.resolver.declarationChanges, modules.length)
  let mut pending = List<DeclarationChange>.asMutSlice(&mut thisStore.resolver.declarationChanges)
  at = usize.ZERO
  while at < pending.length {
    run List<Observation>.reserve(&mut pending[at].observations, usize.ONE)
    at = at + usize.ONE
  }
  // Embedded files are read raw, never through the source index, so their changes are found
  // here: a changed file reruns what read it (`StaticPort.embeddedFile`).
  let mut embedded = List<usize>.make()
  // The source index reports the changes of the modules it read. A module whose checks an
  // adopted cache image answered was never read, yet those checks rest on its text.
  let mut unread = List<usize>.make()
  at = usize.ZERO
  while at < modules.length {
    let held = run SourceIndex.captureObservation(&thisStore.resolver.source, &modules[at])
    let next = run Revision.observe(&revision, &modules[at])
    if !Observation.equals(&held, &next) {
      if ModuleId.withOrigin<bool>(&modules[at], |origin: &[u8]| -> bool { return same(origin, b"embed") }) {
        run List<usize>.append(&mut embedded, at)
      } else { run List<usize>.append(&mut unread, at) }
    }
    at = at + usize.ONE
  }
  thisStore.resolver.checkImageScope = ContentHash {high: 0, low: 0}
  thisStore.resolver.buildImageScope = ContentHash {high: 0, low: 0}
  thisStore.resolver.activeImageScope = ContentHash {high: 0, low: 0}
  Graph.beginRevision(&mut thisStore.resolver.graph)
  thisStore.resolver.claimFree = List<bool>.make()
  let mut changed = run SourceIndex.revise(&mut thisStore.resolver.source, move revision)
  let reported = List<usize>.asSlice(&unread)
  at = usize.ZERO
  while at < reported.length {
    let module = &List<ModuleId>.asSlice(&thisStore.resolver.modules)[reported[at]]
    let mut known = false
    let listed = List<SourceChange>.asSlice(&changed)
    let mut change = usize.ZERO
    while !known && change < listed.length {
      known = ModuleId.equals(&listed[change].module, module)
      change = change + usize.ONE
    }
    if !known { run List<SourceChange>.append(&mut changed, SourceChange {module: ModuleId.copy(module), previous: Option<ModuleIndex>.none()}) }
    at = at + usize.ONE
  }
  let edited = List<usize>.asSlice(&embedded)
  at = usize.ZERO
  while at < edited.length {
    run Graph.sourceChanged(&mut thisStore.resolver.graph, edited[at])
    at = at + usize.ONE
  }
  // Remaining appends fit reservations. A failed update above leaves source/history unchanged.
  let mut publishedHistory = List<DeclarationChange>.asMutSlice(&mut thisStore.resolver.declarationChanges)
  at = usize.ZERO
  while at < publishedHistory.length {
    let mut staged = List<List<Observation>>.asMutSlice(&mut observations)
    let observed = List<Observation>.remove(&mut staged[publishedHistory[at].ordinal], usize.ZERO)
    let history = List<Observation>.asSlice(&publishedHistory[at].observations)
    if !Observation.equals(&history[history.length - usize.ONE], &observed) {
      run List<Observation>.append(&mut publishedHistory[at].observations, move observed)
    }
    at = at + usize.ONE
  }
  while List<SourceChange>.length(&changed) > usize.ZERO {
    let change = List<SourceChange>.remove(&mut changed, usize.ZERO)
    let ordinal = knownModuleOrdinal(&thisStore.resolver, &change.module)
    if ordinal != usize.MAX && pendingDeclarationChange(&thisStore.resolver, &change.module) == usize.MAX {
      let mut staged = List<List<Observation>>.asMutSlice(&mut observations)
      let history = Intrinsic.replace(staged[ordinal], List<Observation>.make())
      run List<DeclarationChange>.append(&mut thisStore.resolver.declarationChanges, DeclarationChange {
        module: move change.module, ordinal: ordinal, previous: move change.previous, observations: move history,
      })
      DeclarationTable.invalidate(&mut thisStore.resolver.declarations, ordinal)
    }
  }
  return ()
}

/// Reports whether a completed root of `request` demanded a fact of `family` in `module`, itself
/// or through any unit it consumed. Only a revisable store records what its units consumed.
pub fn requestDemanded(thisStore: &mut Semantic, request: &Request, family: Family, module: &ModuleId) -> bool {
  let ordinal = knownModuleOrdinal(&thisStore.resolver, module)
  let roots = List<Root>.asSlice(&request.roots)
  let mut at = usize.ZERO
  while at < roots.length {
    if roots[at].family == family && ModuleId.equals(&roots[at].module, module) {
      return true
    }
    let unit = rootUnit(&mut thisStore.*, &roots[at].answer)
    if ordinal != usize.MAX && unit != usize.MAX {
      Graph.beginTraversal(&mut thisStore.resolver.graph)
      if reachesDemand(&mut thisStore.resolver, unit, family, ordinal) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

/// Logs the store's query work since the last call for the trace: the demand counters, the runs
/// and time of each query family, and of the queries about each module's declarations that
/// took a millisecond or more of their own. Does nothing when the process is not traced.
pub effect fn traceQueries(thisStore: &Semantic) -> () ! OutOfMemoryError ? &mut Allocator {
  if !Tracing.on() {
    return ()
  }
  run Effect.logInfo(
    "queries: {runs} runs for {demands} demands",
    &.{demands: thisStore.resolver.demands, hits: thisStore.resolver.hits, runs: thisStore.resolver.runs},
  )
  let mut families = List<Tracing.QueryTime>.make()
  let mut modules = List<Tracing.QueryTime>.make()
  run Tracing.takeQueryTimes(&mut families, &mut modules)
  let ran = List<Tracing.QueryTime>.asSlice(&families)
  let mut at = usize.ZERO
  while at < ran.length {
    run Effect.logInfo(
      "query.family {family}",
      &.{family: ran[at].name, runs: ran[at].runs, hits: ran[at].hits, verified: ran[at].verified, own_ns: ran[at].own,
        total_ns: ran[at].total},
    )
    at = at + usize.ONE
    run Tracing.pump()
  }
  let about = List<Tracing.QueryTime>.asSlice(&modules)
  at = usize.ZERO
  while at < about.length && at < List<ModuleId>.length(&thisStore.resolver.modules) {
    if about[at].own >= 1000000 {
      let path = run ModuleId.copyPackagePath(&List<ModuleId>.asSlice(&thisStore.resolver.modules)[at])
      run Effect.logInfo(
        "query.module {module}",
        &.{module: Tracing.label(Bytes.asSlice(&path)), runs: about[at].runs, own_ns: about[at].own, total_ns: about[at].total},
      )
      run Tracing.pump()
    }
    at = at + usize.ONE
  }
  return run Tracing.flush()
}

/// Empties every lowered MIR function that no completed answer of the store or root of
/// `request` names, with the helpers lowered after it, and returns how many it emptied. A unit
/// that reruns lowers its function again, so the old one is garbage once nothing names it. An
/// answer held anywhere else must not be read for its MIR afterwards.
pub effect fn releaseStaleMir(thisStore: &mut Semantic, request: &Request) -> usize ! OutOfMemoryError ? &mut Allocator {
  let count = List<MirFunction>.length(&thisStore.resolver.mirValues)
  let mut live = List<bool>.make()
  while List<bool>.length(&live) < count { run List<bool>.append(&mut live, false) }
  let slots = Query<Answer, NoRejection>.slots(&thisStore.query)
  let mut slot = usize.ZERO
  while slot < slots {
    if let Option<Shared<Result<Answer, NoRejection>>>.Some {value: answer} = move Query<Answer, NoRejection>.completed(&mut thisStore.query, Word {value: usize.toU64(slot)}) {
      markLiveMir(&thisStore.resolver, &mut live, &answer)
    }
    slot = slot + usize.ONE
  }
  let roots = List<Root>.asSlice(&request.roots)
  let mut at = usize.ZERO
  while at < roots.length {
    markLiveMir(&thisStore.resolver, &mut live, &roots[at].answer)
    at = at + usize.ONE
  }
  while List<bool>.length(&thisStore.resolver.mirReleased) < count { run List<bool>.append(&mut thisStore.resolver.mirReleased, false) }
  let marks = List<bool>.asSlice(&live)
  let mut released = usize.ZERO
  let mut functions = List<MirFunction>.asMutSlice(&mut thisStore.resolver.mirValues)
  let mut freed = List<bool>.asMutSlice(&mut thisStore.resolver.mirReleased)
  at = usize.ZERO
  while at < count {
    if !marks[at] && !freed[at] {
      emptyMir(&mut functions[at])
      freed[at] = true
      released = released + usize.ONE
      // Its coalesced copy goes with it.
      if at < List<usize>.length(&thisStore.resolver.coalescedIndex) {
        let held = List<usize>.get(&thisStore.resolver.coalescedIndex, at)
        if held != usize.MAX {
          emptyMir(&mut List<MirFunction>.asMutSlice(&mut thisStore.resolver.coalescedValues)[held])
          List<usize>.set(&mut thisStore.resolver.coalescedIndex, at, usize.MAX)
        }
      }
    }
    at = at + usize.ONE
  }
  thisStore.resolver.mirReleasedCount = thisStore.resolver.mirReleasedCount + released
  return released
}

/// Counts the modules whose source the unit that completed `answer` read, itself or through any
/// unit it consumed. Only a revisable store records what its units read.
pub fn sourcesRead(thisStore: &mut Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let unit = rootUnit(&mut thisStore.*, answer)
  if unit == usize.MAX {
    return usize.ZERO
  }
  let mut count = usize.ZERO
  let mut ordinal = usize.ZERO
  while ordinal < List<ModuleId>.length(&thisStore.resolver.modules) {
    Graph.beginTraversal(&mut thisStore.resolver.graph)
    if reachesSource(&mut thisStore.resolver, unit, ordinal) {
      count = count + usize.ONE
    }
    ordinal = ordinal + usize.ONE
  }
  return count
}

/// Reports whether a completed root of `request` read a module that is present, itself or through
/// any unit it consumed. An absent module is not discovered. Only a revisable store records what
/// its units read; a root that is no unit reads only its own module.
pub fn requestDiscovered(thisStore: &mut Semantic, request: &Request, module: &ModuleId) -> bool {
  if !SourceIndex.presents(&thisStore.resolver.source, module) {
    return false
  }
  let ordinal = knownModuleOrdinal(&thisStore.resolver, module)
  let roots = List<Root>.asSlice(&request.roots)
  let mut at = usize.ZERO
  while at < roots.length {
    let unit = rootUnit(&mut thisStore.*, &roots[at].answer)
    if unit == usize.MAX {
      if ModuleId.equals(&roots[at].module, module) {
        return true
      }
    } else if ordinal != usize.MAX {
      Graph.beginTraversal(&mut thisStore.resolver.graph)
      if reachesSource(&mut thisStore.resolver, unit, ordinal) {
        return true
      }
    }
    at = at + usize.ONE
  }
  return false
}

/// Freezes one assembly's facts before any registered source default is demanded.
/// A semantic store accepts only the facts for which its target and cached answers were opened.
pub effect fn bindAssemblyFacts(thisStore: &mut Semantic, facts: &InitialProfile) -> bool
! OutOfMemoryError
? &mut Allocator {
  let selectedTarget = InitialProfile.target(facts)
  if MachineTarget.id(selectedTarget) != MachineTarget.id(&thisStore.resolver.target) {
    return false
  }
  if let Option<&FinalProfile>.Some {value: active} = move selectedProfile(&thisStore.resolver) {
    if !InitialProfile.sameIdentity(FinalProfile.facts(active), facts) { return false }
  }
  let mut bound = false
  match &thisStore.resolver.assemblyFacts {
    Option<InitialProfile>.Some {value: previous} => {
      if !InitialProfile.sameIdentity(&previous, facts) { return false }
      bound = true
    }
    Option<InitialProfile>.None => {}
  }
  if !bound { thisStore.resolver.assemblyFacts = Option<InitialProfile>.some(run InitialProfile.copy(facts)) }
  if thisStore.resolver.profileSlot == usize.ZERO { thisStore.resolver.profileSlot = usize.MAX }
  return true
}

/// Evaluates the written predicate at bool against the current complete assembly map.
/// A package parameter problem found while assembling the profile (SEM0214), reported at the
/// parameter's declaration: `before`, the parameter's name, then `after`.
pub effect fn parameterProblem(thisStore: &mut Semantic, identity: &DeclarationId, before: &[u8], after: &[u8]) -> Shared<Rejection>
! Cycle | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = DeclarationId.moduleId(identity)
  let owned = run Types.internDeclaration(DeclarationId.copy(identity))
  let mut span = Span.make(usize.ZERO, usize.ZERO)
  if let Option<usize>.Some {value: ordinal} = move run ordinalOfIdentity(&mut thisStore.resolver, module, &owned) {
    if let Option<HeaderSyntax>.Some {value: written} = move run header(&mut thisStore.resolver, module, ordinal) { span = written.span }
  }
  let name = run DeclarationId.copySpelling(identity)
  return run namedParameterRejection(RejectionCode.InvalidParameterSchema, module, span, Bytes.asSlice(&name), before, after)
}

pub effect fn validateParameter(thisStore: &mut Semantic, request: &mut Request, identity: &DeclarationId) -> Result<(), Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = DeclarationId.moduleId(identity)
  let owned = run Types.internDeclaration(DeclarationId.copy(identity))
  let ordinal = match move run ordinalOfIdentity(&mut thisStore.resolver, module, &owned) {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<(), Shared<Rejection>>.failResult(run reject(&thisStore.resolver, module,
        RejectionCode.InvalidParameterSchema, Span.make(usize.ZERO, usize.ZERO)))
    }
  }
  let answer = run source(&mut thisStore.resolver, module)
  let mut expression = Option<HirId>.none()
  if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(&thisStore.resolver, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
    let hir = IndexedSource.authored(indexed)
    if ordinal < declarations.length {
      if let Node.Declaration {body, ..} = Module.node(hir, declarations[ordinal].local) {
        if let Node.PackageParameterBody {validation, ..} = Module.node(hir, body) {
          if validation.present { expression = Option<HirId>.some(validation.id) }
        }
      }
    }
  }
  if let Option<HirId>.Some {value: predicate} = move expression {
    let mut dependencies = List<Dependency>.make()
    let span = run staticSpan(&mut thisStore.resolver, module, predicate)
    let evaluated = run staticExpression(&mut thisStore.resolver, &mut thisStore.query, &mut dependencies,
      module, Option<usize>.some(ordinal), predicate,
      StaticRootExpectation.Resolved {ty: run primitiveType(b"bool"), mismatchCode: RejectionCode.InvalidParameterSchema}, &[], &[])
    let value = match move evaluated {
      Result<Interned<StaticData>, Shared<Rejection>>.Success {value} => move value
      Result<Interned<StaticData>, Shared<Rejection>>.Failure {error} => {
        // A predicate that is not a `bool` names its parameter.
        if bareRejection(&error, RejectionCode.InvalidParameterSchema) {
          let name = run DeclarationId.copySpelling(identity)
          return Result<(), Shared<Rejection>>.failResult(run namedParameterRejection(RejectionCode.InvalidParameterSchema,
            module, rejectionSpan(&error), Bytes.asSlice(&name), b"the `where` predicate of package parameter `", b"` is not a `bool`"))
        }
        return Result<(), Shared<Rejection>>.failResult(move error)
      }
    }
    if !Interned<StaticData>.with<bool>(&value, |data: &StaticData| -> bool {
      return match &data.* { StaticData.Boolean {value: holds} => holds _ => false }
    }) {
      let mut diagnostic = run makeRejection(RejectionCode.ParameterValidationFailed, module, span)
      let mut message = run Bytes.copy(b"the bound value of package parameter `")
      let name = run DeclarationId.copySpelling(identity)
      run Bytes.append(&mut message, Bytes.asSlice(&name))
      run Bytes.append(&mut message, b"` does not satisfy its `where` predicate")
      run List<MessageArgument>.append(&mut diagnostic.arguments, MessageArgument {name: run Bytes.copy(b"message"), value: move message})
      return Result<(), Shared<Rejection>>.failResult(run Shared<Rejection>.make(move diagnostic))
    }
  }
  return Result<(), Shared<Rejection>>.succeed(())
}

/// Selects a complete profile by structural content; equal values reuse the same query scope.
pub effect fn reviseProfile(thisStore: &mut Semantic, profile: Option<FinalProfile>) -> ()
! OutOfMemoryError
? &mut Allocator | &mut Types {
  thisStore.resolver.assemblyFacts = Option<InitialProfile>.none()
  let candidate = match move profile {
    Option<FinalProfile>.Some {value} => move value
    Option<FinalProfile>.None => {
      thisStore.resolver.profileSlot = usize.ZERO
      thisStore.resolver.target = thisStore.resolver.baseTarget
      return ()
    }
  }
  let selectedTarget = FinalProfile.target(&candidate)
  if run sameStoredProfile(&thisStore.resolver, &candidate, usize.ONE) {
    thisStore.resolver.initialProfile = Option<FinalProfile>.some(move candidate)
    thisStore.resolver.profileSlot = usize.ONE
    thisStore.resolver.target = selectedTarget
    return ()
  }
  let mut at = usize.ZERO
  while at < List<FinalProfile>.length(&thisStore.resolver.profiles) {
    if run sameStoredProfile(&thisStore.resolver, &candidate, at + 2) {
      let mut current = List<FinalProfile>.asMutSlice(&mut thisStore.resolver.profiles)
      current[at] = move candidate
      thisStore.resolver.profileSlot = at + 2
      thisStore.resolver.target = selectedTarget
      return ()
    }
    at = at + usize.ONE
  }
  let slot = List<FinalProfile>.length(&thisStore.resolver.profiles) + 2
  run List<FinalProfile>.append(&mut thisStore.resolver.profiles, move candidate)
  thisStore.resolver.profileSlot = slot
  thisStore.resolver.target = selectedTarget
  return ()
}

/// A dependee as a traced replay reports it: a unit's name, or a source input's module and selector.
pub effect fn dependeeName(thisStore: &mut Semantic, dependee: Dependee) -> Bytes ! Cycle | OutOfMemoryError ? &mut Allocator {
  return match &dependee {
    Dependee.MirDispatch {unit} => run Semantic.unitName(&mut thisStore.*, unit)
    Dependee.UnitResult {unit} => run Semantic.unitName(&mut thisStore.*, unit)
    Dependee.SourceFile {module} => {
      let mut name = run Bytes.copy(b"file ")
      run ModuleId.appendPath(&resolvedModule(&thisStore.resolver, module), &mut name)
      return move name
    }
    Dependee.SourceInput {input, module} => {
      let mut name = run Bytes.copy(b"input ")
      run ModuleId.appendPath(&resolvedModule(&thisStore.resolver, module), &mut name)
      run Bytes.append(&mut name, b" ")
      let listed = List<Inputs.Input>.asSlice(&thisStore.resolver.sourceInputs.inputs)
      run Bytes.append(&mut name, Inputs.selectorName(&listed[input].selector))
      return move name
    }
  }
}

/// The stable bytes of every current unit whose key has a stable form, in unit order: what a
/// cache written to disk names a unit by, equal in every store that holds the same unit.
pub effect fn stableUnits(thisStore: &Semantic) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut encoded = List<Bytes>.make()
  let mut unit = usize.ZERO
  while unit < List<ScopedKey>.length(&thisStore.resolver.keys) {
    if Graph.state(&thisStore.resolver.graph, unit) == UnitState.UpToDate {
      if let Option<Bytes>.Some {value} = move run stableUnit(&thisStore.resolver, unit) {
        run List<Bytes>.append(&mut encoded, move value)
      }
    }
    unit = unit + usize.ONE
  }
  return move encoded
}

/// The stable bytes of every source input this store captured, in capture order.
pub effect fn stableInputs(thisStore: &Semantic) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut encoded = List<Bytes>.make()
  let mut input = usize.ZERO
  while input < List<Inputs.Input>.length(&thisStore.resolver.sourceInputs.inputs) {
    if let Option<Bytes>.Some {value} = move run stableInput(&thisStore.resolver, input) {
      run List<Bytes>.append(&mut encoded, move value)
    }
    input = input + usize.ONE
  }
  return move encoded
}

/// Copies the canonical declaration a declaration dependency demanded, in the held source
/// revision. Other families and lost declaration handles return `None`.
pub effect fn dependencyDeclaration(
  thisStore: &mut Semantic,
  dependency: &Dependency
) -> Option<DeclarationId>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
  if widened(dependency.declaration) == usize.MAX {
    return Option<DeclarationId>.none()
  }
  let module = resolvedModule(&thisStore.resolver, widened(dependency.module))
  drop run demandSource(&mut thisStore.resolver, &module)
  let position = DeclarationTable.position(&thisStore.resolver.declarations, widened(dependency.declaration))
  return run declarationAt(&mut thisStore.resolver, &module, position)
}

/// Copies named authored addresses and actual import namespaces from one canonical source.
/// Syntax does not admit bodies. Absent source and condition/import refusals retain observations.
pub effect fn demandSourceInventory(thisStore: &mut Semantic, request: &mut Request, module: &ModuleId) -> SourceInventory
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run source(&mut thisStore.resolver, module)
  let observation = run SourceIndex.captureObservation(&thisStore.resolver.source, module)
  let indexed = match move sourceOf(&thisStore.resolver, &answer, module) {
    Option<&IndexedSource>.Some {value} => value
    Option<&IndexedSource>.None => {
      if Observation.isPresent(&observation) { fail RevisionMismatch {} }
      return SourceInventory.Absent {observation: move observation}
    }
  }
  let sourceDigest = Sha256.hash(SourceUnit.bytes(IndexedSource.sourceUnit(indexed)))
  let copied = run ModuleIndex.copyFunctionInventory(IndexedSource.moduleIndex(indexed), IndexedSource.sourceUnit(indexed))
  let mut syntax = match move copied {
    Option<FunctionInventory>.Some {value} => move value
    Option<FunctionInventory>.None => { fail RevisionMismatch {} }
  }
  let authenticated = run SourceIndex.authoredCursor(&mut thisStore.resolver.source, &answer, module)
  let cursor = match move authenticated {
    Option<AuthoredCursor>.Some {value} => move value
    Option<AuthoredCursor>.None => { fail RevisionMismatch {} }
  }
  let owned = List<NamedFunction>.asMutSlice(&mut syntax.functions)
  let mut checked = usize.ZERO
  while checked < owned.length {
    let nameSpan = SourceIndex.authoredSpan(&thisStore.resolver.source, &cursor, owned[checked].name)
    owned[checked].nameSpan = match move nameSpan {
      Option<Span>.Some {value} => value
      Option<Span>.None => { fail RevisionMismatch {} }
    }
    checked = checked + usize.ONE
  }
  drop answer
  let mut availability = List<Result<bool, Shared<Rejection>>>.make()
  let functions = List<NamedFunction>.asSlice(&syntax.functions)
  let mut at = usize.ZERO
  while at < functions.length {
    run List<Result<bool, Shared<Rejection>>>.append(&mut availability,
      run requestAvailability(&mut thisStore.resolver, &mut thisStore.query, &mut request.*, module, functions[at].ordinal, functions[at].headerSpan))
    at = at + usize.ONE
  }
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let mut imports = List<InventoryImport>.make()
  let written = List<IndexedDeclaration>.asSlice(&syntax.imports)
  at = usize.ZERO
  while at < written.length {
    let identity = run Types.internDeclaration(DeclarationId.copy(&written[at].identity))
    let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &identity)
    if let Option<usize>.Some {value: declaration} = move found {
      let declarationAccess254Request = Key {
        family: Family.Import, module: moduleOrdinal, name: usize.ZERO,
        declaration: declaration, member: usize.MAX, external: false,
      }
      let declarationAccess254 = run internDeclaration(&mut thisStore.resolver, declarationAccess254Request)
      let target = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess254, Span.make(usize.ZERO, usize.ZERO))
      let spelled = run DeclarationId.copySpelling(&written[at].identity)
      run recordRoot(&mut request.*, Family.Import, module, Bytes.asSlice(&spelled), &target)
      run List<InventoryImport>.append(&mut imports, InventoryImport {
        declaration: DeclarationId.copy(&written[at].identity), answer: move target,
      })
    } else { fail RevisionMismatch {} }
    at = at + usize.ONE
  }
  return SourceInventory.Present {observation: move observation, sourceDigest: sourceDigest,
    syntax: move syntax, availability: move availability, imports: move imports}
}

/// Returns a nongeneric nominal identity without resolving fields, members, or layout.
/// Returns an anchored rejection if the name does not identify a supported nominal declaration.
pub effect fn demandIdentity(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(&mut thisStore.resolver, &mut thisStore.query, module, name, Family.Identity)
  run recordRoot(&mut request.*, Family.Identity, module, name, &answer)
  return move answer
}

/// Enumerates the written fields, tuple positions, enum cases, or union variants of a nominal.
/// Member types and target layout remain undemanded.
pub effect fn demandMembers(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(&mut thisStore.resolver, &mut thisStore.query, module, name, Family.Members)
  run recordRoot(&mut request.*, Family.Members, module, name, &answer)
  return move answer
}

/// Resolves only one member's written types under a canonical nominal application.
/// A struct field or tuple position has one type; a union variant has its ordered payload
/// types; a scalar enum case has none. The member is selected by its enumeration ordinal.
pub effect fn demandMemberShape(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
  member: usize,
  application: &Interned<Type>,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let nameOrdinal = run internName(&mut thisStore.resolver, name)
  let declarationAccess255Request = Key {
    family: Family.Name,
    module: moduleOrdinal,
    name: nameOrdinal,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess255 = run internDeclaration(&mut thisStore.resolver, declarationAccess255Request)
  let bucketKey = declarationAccess255
  let observed = run demandRaw(
    &mut thisStore.resolver,
    &mut thisStore.query,
    bucketKey,
    Span.make(usize.ZERO, usize.ZERO),
  )
  if Shared<Result<Answer, NoRejection>>.with<bool>(&observed, hasRejection) {
    run recordRoot(&mut request.*, Family.MemberShape, module, name, &observed)
    return move observed
  }
  drop observed
  // A root lookup observes governing conditions without a dependent answer.
  let mut rootConditions = List<Dependency>.make()
  let selectedSelection = run select(&mut thisStore.resolver, &mut thisStore.query, &mut rootConditions, module, name, false)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      let kept = run rootRejection(&mut thisStore.resolver, module, move error)
      run recordRoot(&mut request.*, Family.MemberShape, module, name, &kept)
      return move kept
    }
  }
  if selected.count != usize.ONE || selected.kind != CandidateKind.Declaration {
    let mut code = RejectionCode.Collision
    if selected.count == usize.ZERO {
      code = RejectionCode.UnknownType
    } else if selected.kind != CandidateKind.Declaration {
      code = RejectionCode.NotType
    }
    let rejected = run rejectRoot(&mut thisStore.resolver, module, bucketKey, code, selected.span)
    run recordRoot(&mut request.*, Family.MemberShape, module, name, &rejected)
    return move rejected
  }
  let applicationOrdinal = run internApplication(&mut thisStore.resolver, application)
  let declarationAccess256Request = Key {
    family: Family.MemberShape,
    module: moduleOrdinal,
    name: applicationOrdinal,
    declaration: selected.declaration,
    member: member,
    external: false,
  }
  let declarationAccess256 = run internDeclaration(&mut thisStore.resolver, declarationAccess256Request)
  let key = declarationAccess256
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, key, selected.span)
  run recordRoot(&mut request.*, Family.MemberShape, module, name, &answer)
  return move answer
}

/// Resolves the binders and declared bounds of a type, alias, interface, or service declaration.
///
/// # Details
///
/// This does not demand the declaration's identity or members, and it proves no bound; an
/// application of a bounded declaration is rejected as unsupported where it is written.
pub effect fn demandContract(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(&mut thisStore.resolver, &mut thisStore.query, module, name, Family.Contract)
  run recordRoot(&mut request.*, Family.Contract, module, name, &answer)
  return move answer
}

/// Resolves the variance of each binder of a struct, tuple, union, or enum (LIFE-002), as
/// `Value.Variance` in complete binder order.
///
/// # Details
///
/// Only binders and member shapes are read, never a body or a layout. A recursive or mutually
/// recursive declaration reaches its least fixed point inside the one query, so ordinary
/// recursion is not a cycle. Any other declaration rejects as unsupported.
pub effect fn demandVariance(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(&mut thisStore.resolver, &mut thisStore.query, module, name, Family.Variance)
  run recordRoot(&mut request.*, Family.Variance, module, name, &answer)
  return move answer
}

/// Resolves what cleanup of a struct, tuple, union, or enum observes of each binder (LIFE-005),
/// as `Value.DropObservation` in complete binder order.
///
/// # Details
///
/// Only binders, member shapes and the implementation shapes that may hold a `Drop` hook are
/// read. Recursion is resolved inside the one query, as for `demandVariance`.
pub effect fn demandDropObservation(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(&mut thisStore.resolver, &mut thisStore.query, module, name, Family.DropObservation)
  run recordRoot(&mut request.*, Family.DropObservation, module, name, &answer)
  return move answer
}

/// Enumerates an interface's or service's operation declarations in written order.
///
/// # Details
///
/// Only member headers are read; no operation signature is resolved. A field, a visibility
/// modifier on an operation, or another non-operation member rejects with
/// `InvalidContractMember`, and a repeated operation name rejects at the later operation. An
/// operation with a body is listed as one with a default.
pub effect fn demandOperations(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(
    &mut thisStore.resolver,
    &mut thisStore.query,
    module,
    name,
    Family.Operations,
  )
  run recordRoot(&mut request.*, Family.Operations, module, name, &answer)
  return move answer
}

/// Resolves the written signature of one interface or service operation without reading a body.
///
/// # Details
///
/// The operation resolves under its contract's binders and implicit `Self` provider, while its
/// own binders keep the operation's identity. The contract's operation list is demanded first,
/// so an invalid member list rejects here too. An absent operation rejects with `UnknownMember`.
pub effect fn demandOperation(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  contract: &[u8],
  operation: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let listed = run demandNamed(
    &mut thisStore.resolver,
    &mut thisStore.query,
    module,
    contract,
    Family.Operations,
  )
  if Shared<Result<Answer, NoRejection>>.with<bool>(&listed, hasRejection) {
    run recordRoot(&mut request.*, Family.Signature, module, operation, &listed)
    return move listed
  }
  drop listed
  // A root lookup observes governing conditions without a dependent answer.
  let mut rootConditions = List<Dependency>.make()
  let selectedSelection = run select(&mut thisStore.resolver, &mut thisStore.query, &mut rootConditions, module, contract, false)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      let kept = run rootRejection(&mut thisStore.resolver, module, move error)
      run recordRoot(&mut request.*, Family.Signature, module, operation, &kept)
      return move kept
    }
  }
  let lookup = run memberOrdinal(&mut thisStore.resolver, module, selected.declaration, operation)
  if let Option<Span>.Some {value: span} = move lookup.repeated {
    let diagnostic = run reject(&thisStore.resolver, module, RejectionCode.DuplicateDeclarationName, span)
    let repeated = run rootRejection(&mut thisStore.resolver, module, move diagnostic)
    run recordRoot(&mut request.*, Family.Signature, module, operation, &repeated)
    return move repeated
  }
  if let Option<usize>.Some {value: ordinal} = move lookup.ordinal {
    let answer = run memberSignature(
      &mut thisStore.resolver,
      &mut thisStore.query,
      module,
      ordinal,
      selected.span,
    )
    run recordRoot(&mut request.*, Family.Signature, module, operation, &answer)
    return move answer
  }
  // The contract's name is the nearest written anchor for an absent operation.
  let absent = run rejectAbsent(&mut thisStore.resolver, module, selected.span, RejectionCode.UnknownOperation)
  run recordRoot(&mut request.*, Family.Signature, module, operation, &absent)
  return move absent
}

/// Resolves the heads of every top-level conformance and sealed-property `impl` in one module, in
/// written order.
///
/// # Details
///
/// Each head is the implementation's binders, including lifetimes elided from its heads, with
/// its applied contract and provider. Only header names and applications are resolved; no member
/// or body is read. An empty list observes that the module declares none. One rejected head
/// rejects the list, because the module's membership is then unknown. Inherent `impl`s are
/// reached through their owner with `demandInherentMembers`.
pub effect fn demandImplementations(thisStore: &mut Semantic, request: &mut Request, module: &ModuleId) -> Shared<
  Result<Answer, NoRejection>,
> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let declarationAccess257Request = Key {
    family: Family.Implementations,
    module: run internModule(&mut thisStore.resolver, module),
    name: usize.ZERO,
    declaration: usize.ZERO,
    member: usize.ZERO,
    external: false,
  }
  let declarationAccess257 = run internDeclaration(&mut thisStore.resolver, declarationAccess257Request)
  let key = declarationAccess257
  let answer = run demandRaw(
    &mut thisStore.resolver,
    &mut thisStore.query,
    key,
    Span.make(usize.ZERO, usize.ZERO),
  )
  run recordRoot(&mut request.*, Family.Implementations, module, b"", &answer)
  return move answer
}

/// Lists the conformance heads that implement an applied interface or service for a provider.
///
/// # Details
///
/// Heads are read only from the modules permitted to own them: the contract's module and the
/// nominal provider's module for an interface, the provider's module for a service. A facade or
/// alias spelling of either endpoint converges on the same canonical owners. An empty list
/// observes absence; bodies, members, and applicability are not examined.
///
/// # Gotchas
///
/// Both types must come from answers of this store. A contract whose declaring module this store
/// has never read fails with `InvalidModulePath`.
pub effect fn demandConformanceHeads(
  thisStore: &mut Semantic,
  request: &mut Request,
  contract: &Interned<Type>,
  provider: &Interned<Type>,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let contractModule = declaringModuleOrdinal(&thisStore.resolver, contract)
  if contractModule == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = resolvedModule(&thisStore.resolver, contractModule)
  let located = run ordinalOfProvider(&mut thisStore.resolver, &module, contract)
  let declaration = match move located {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      fail InvalidModulePath {}
    }
  }
  let declarationAccess258Request = Key {
    family: Family.ConformanceHeads,
    module: contractModule,
    name: run internApplication(&mut thisStore.resolver, provider),
    declaration: declaration,
    member: argumentOwnerSlot(&thisStore.resolver, contract, provider),
    external: false,
  }
  let declarationAccess258 = run internDeclaration(&mut thisStore.resolver, declarationAccess258Request)
  let key = declarationAccess258
  let answer = run demandRaw(
    &mut thisStore.resolver,
    &mut thisStore.query,
    key,
    Span.make(usize.ZERO, usize.ZERO),
  )
  run recordRoot(&mut request.*, Family.ConformanceHeads, &module, b"", &answer)
  return move answer
}

/// Proves one interface or service application using exact concrete heads and the caller's
/// declared abstract bounds. Every conditional requirement must finish before proof succeeds.
/// `siteModule` and `siteSpan` anchor a missing or undecidable goal at the use; declaration-level
/// coherence and witness failures keep their own source anchors. This selects no runtime provider
/// and adds no Effect requirement.
pub effect fn proveConformance(
  thisStore: &mut Semantic,
  request: &mut Request,
  contract: &Interned<Type>,
  provider: &Interned<Type>,
  declared: &[Constraint],
  siteModule: &ModuleId,
  siteSpan: Span,
) -> ConformanceDecision
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let goal = ConformanceGoal {
    contract: Interned<Type>.clone(contract),
    provider: Interned<Type>.clone(provider),
  }
  let mut chain = List<ConformanceGoal>.make()
  let mut steps = List<ConformanceStep>.make()
  let mut dependencies = List<Dependency>.make()
  let avoid = Option<Interned<DeclarationId>>.none()
  let failure = run proveGoal(
    &mut thisStore.resolver,
    &mut thisStore.query,
    &mut request.*,
    &mut dependencies,
    false,
    &avoid,
    &goal,
    declared,
    siteModule,
    siteSpan,
    &mut chain,
    &mut steps,
  )
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move failure {
    return ConformanceDecision.Rejected {diagnostic: move diagnostic, chain: move chain}
  }
  return ConformanceDecision.Proven {proof: ConformanceProof {steps: move steps}}
}

/// Validates a complete application against its target and lexical scope headers.
/// No body is demanded, and a rejected environment retains the caller's diagnostic site.
pub effect fn validateApplication(thisStore: &mut Semantic, request: &mut Request, application: &Application,
  siteModule: &ModuleId, siteSpan: Span) -> Result<Application, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  // A root application may name a module no earlier demand has interned in this store.
  let _targetModule = run internModule(&mut thisStore.resolver, DeclarationId.moduleId(Application.bodyDeclaration(application)))
  let targetIdentity = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(application)))
  let targetFound = run ordinalOfIdentity(&mut thisStore.resolver,
    DeclarationId.moduleId(Application.bodyDeclaration(application)), &targetIdentity)
  let targetOrdinal = match move targetFound {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      return Result<Application, Shared<Rejection>>.failResult(
        run reject(&thisStore.resolver, siteModule, RejectionCode.IdentityUnavailable, siteSpan))
    }
  }
  let available = run requestAvailability(&mut thisStore.resolver, &mut thisStore.query, &mut request.*,
    DeclarationId.moduleId(Application.bodyDeclaration(application)), targetOrdinal, siteSpan)
  match move available {
    Result<bool, Shared<Rejection>>.Success {value} => {
      if !value {
        return Result<Application, Shared<Rejection>>.failResult(
          run reject(&thisStore.resolver, siteModule, RejectionCode.IdentityUnavailable, siteSpan))
      }
    }
    Result<bool, Shared<Rejection>>.Failure {error} => {
      return Result<Application, Shared<Rejection>>.failResult(move error)
    }
  }
  let mut dependencies = List<Dependency>.make()
  let found = run resolveTargetSchema(&mut thisStore.resolver, &mut thisStore.query, &mut request.*, &mut dependencies, false,
    Application.bodyDeclaration(application), siteSpan)
  if let Option<TargetSchema>.Some {value: schema} = move found {
    if run TargetSchema.accepts(&schema, application) { return Result<Application, Shared<Rejection>>.succeed(run Application.copy(application)) }
  }
  return Result<Application, Shared<Rejection>>.failResult(run reject(&thisStore.resolver, siteModule, RejectionCode.Undetermined, siteSpan))
}

/// Resolves a target signature under its complete validated own and enclosing environment.
/// The lexical Self provider is derived from the head, never stored as an extra argument.
pub effect fn specializeSignature(thisStore: &mut Semantic, request: &mut Request, application: &Application,
  siteModule: &ModuleId, siteSpan: Span) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let validated = run Semantic.validateApplication(&mut thisStore.*, &mut request.*, application, siteModule, siteSpan)
  let selected = match move validated {
    Result<Application, Shared<Rejection>>.Success {value} => Option<Application>.some(move value)
    Result<Application, Shared<Rejection>>.Failure {error} => {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(move error, List<Dependency>.make())))
    }
  }
  let identity = Application.bodyDeclaration(application)
  let moduleOrdinal = knownModuleOrdinal(&thisStore.resolver, DeclarationId.moduleId(identity))
  let module = resolvedModule(&thisStore.resolver, moduleOrdinal)
  let shared = run Types.internDeclaration(DeclarationId.copy(identity))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, &module, &shared)
  let ordinal = match move found { Option<usize>.Some {value} => value _ => { fail InvalidModulePath {} } }
  let declarationAccess259Request = Key {family: Family.Signature, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: usize.ZERO, external: false}
  let declarationAccess259 = run internDeclaration(&mut thisStore.resolver, declarationAccess259Request)
  let answer = run resolveSignatureUnder(&mut thisStore.resolver, &mut thisStore.query,
    declarationAccess259,
    List<Dependency>.make(), Option<List<Argument>>.none(), Option<List<Argument>>.none(), &selected, &Option<LambdaTypes>.none())
  return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(move answer))
}

/// Resolves an interface call under its caller's concrete type and row arguments.
///
/// # Details
/// Substitutes both contract and provider, proves the concrete goal without declared bounds,
/// and composes the selected witness's argument mapping in target binder order. The returned
/// Named application has the same canonical identity as a direct call to that target.
/// Proof and witness headers are demanded; the target body is never read. Operation-owned
/// arguments absent from the checked call remain unresolved for the backend to classify.
pub effect fn specializeInterfaceCall(
  thisStore: &mut Semantic,
  request: &mut Request,
  contract: &Interned<Type>,
  provider: &Interned<Type>,
  operation: &DeclarationId,
  caller: &Application,
  siteModule: &ModuleId,
  siteSpan: Span,
) -> Result<Application, Shared<Rejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let checked = run Semantic.validateApplication(&mut thisStore.*, &mut request.*, caller, siteModule, siteSpan)
  let environment = match move checked {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => { return Result<Application, Shared<Rejection>>.failResult(move error) }
  }
  let bindings = run Application.bindings(&environment)
  let appliedContract = run Type.applyBindings(contract, List<Binding>.asSlice(&bindings), true)
  let appliedProvider = run Type.applyBindings(provider, List<Binding>.asSlice(&bindings), true)
  let mut dependencies = List<Dependency>.make()
  let selected = run resolveWitnessApplication(
    &mut thisStore.resolver, &mut thisStore.query, &mut request.*, &mut dependencies, false,
    &appliedContract, &appliedProvider, operation, siteModule, siteSpan,
  )
  return match move selected {
    Result<ResolvedWitness, Shared<Rejection>>.Success {value} => Result<Application, Shared<Rejection>>.succeed(move value.application)
    Result<ResolvedWitness, Shared<Rejection>>.Failure {error} => Result<Application, Shared<Rejection>>.failResult(move error)
  }
}

/// Decides whether one conformance `impl` is coherent before any applicability or bound proof.
///
/// # Details
///
/// Every written parameter must occur in the interface application or the provider, and every
/// bound must descend through the provider without repeating an open parameter or rewriting a
/// fixed interface argument (`NonterminatingConformance` with its step). The complete owner
/// bucket is then read, and no other head may name the same goal once lifetimes are erased:
/// bounds never make heads distinct and no head wins by source or demand order. Both heads of a
/// conflict reject with the same diagnostic, anchored at the canonically later head, with `path`
/// holding that head and then the earliest other conflicting head. `DuplicateConformance` names
/// two unbounded heads that rename each other exactly; any other conflict is
/// `OverlappingConformance`. A head the lifetime-erased comparison cannot decide, such as one
/// whose union member nests a parameter, is `Unsupported`. A success proves no bound and admits
/// no witness. An identity absent from the current revision rejects with `UnknownMember`.
pub effect fn demandCoherence(
  thisStore: &mut Semantic,
  request: &mut Request,
  implementation: &DeclarationId,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = DeclarationId.moduleId(implementation)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let identity = run Types.internDeclaration(DeclarationId.copy(implementation))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &identity)
  let mut selectedKey = Option<Key>.none()
  if let Option<usize>.Some {value: ordinal} = move found {
    let declarationRequest = Key {
        family: Family.Coherence,
        module: moduleOrdinal,
        name: usize.ZERO,
        declaration: ordinal,
        member: usize.ZERO,
        external: false,
      }
    selectedKey = Option<Key>.some(run internDeclaration(&mut thisStore.resolver, declarationRequest))
  }
  let answer = match move selectedKey {
    Option<Key>.Some {value: selected} => run demandRaw(
      &mut thisStore.resolver, &mut thisStore.query, selected, Span.make(usize.ZERO, usize.ZERO))
    Option<Key>.None => run rejectAbsent(
      &mut thisStore.resolver,
      module,
      Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
  }
  run recordRoot(&mut request.*, Family.Coherence, module, b"", &answer)
  return move answer
}

/// Lists the written members of a module's `occurrence`th top-level `impl`, which must be a
/// conformance or sealed-property implementation.
///
/// # Details
///
/// An inline member is its function declaration. A mapped member's path is resolved from headers
/// only: a function of this module or of an imported namespace, or an inherent member its owner
/// publishes. A repeated member name rejects with `Collision`; a rejected head publishes no
/// member. Members are not matched against contract operations here.
pub effect fn demandImplementationMembers(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let implementation = run implementationOrdinal(&mut thisStore.resolver, module, occurrence)
  if let Option<usize>.Some {value: ordinal} = move implementation {
    let declarationAccess261Request = Key {
      family: Family.ImplementationMembers,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ordinal,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess261 = run internDeclaration(&mut thisStore.resolver, declarationAccess261Request)
    let key = declarationAccess261
    let answer = run demandRaw(
      &mut thisStore.resolver,
      &mut thisStore.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.ImplementationMembers, module, b"", &answer)
    return move answer
  }
  let absent = run rejectAbsent(&mut thisStore.resolver, module, Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
  run recordRoot(&mut request.*, Family.ImplementationMembers, module, b"", &absent)
  return move absent
}

/// Enumerates the inherent members an owner publishes across its module's inherent `impl`s.
///
/// # Details
///
/// Only the owner's module is read; a rejected head publishes no member, and a deferred head
/// defers the whole enumeration with its own rejection. A member whose name
/// repeats another member, or an owner field, variant, enum member, generated operation, or
/// contract operation, is not published, and its anchored rejection is kept; no winner is chosen
/// by source order. Member signatures are not resolved.
pub effect fn demandInherentMembers(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(
    &mut thisStore.resolver,
    &mut thisStore.query,
    module,
    name,
    Family.InherentMembers,
  )
  run recordRoot(&mut request.*, Family.InherentMembers, module, name, &answer)
  return move answer
}

/// Resolves the signature of `member`, an inherent member of the owner declaration `owner`.
///
/// # Details
///
/// The owner's published members decide the answer. A member that repeats another member's name
/// or claims an owner item's name returns its kept rejection; no winner is chosen by source
/// order. A member of a rejected inherent head is not published. An absent member rejects with
/// `UnknownMember`.
pub effect fn demandInherentMember(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  owner: &[u8],
  member: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let listed = run demandNamed(
    &mut thisStore.resolver,
    &mut thisStore.query,
    module,
    owner,
    Family.InherentMembers,
  )
  if Shared<Result<Answer, NoRejection>>.with<bool>(&listed, hasRejection) {
    run recordRoot(&mut request.*, Family.Signature, module, member, &listed)
    return move listed
  }
  let lookup = Shared<Result<Answer, NoRejection>>.with<InherentLookup>(
    &listed,
    |answer: &Result<Answer, NoRejection>| -> InherentLookup {
      return inherentLookup(answer, member)
    },
  )
  drop listed
  let InherentLookup {published, rejected} = move lookup
  if let Option<Interned<DeclarationId>>.Some {value: declaration} = move published {
    let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &declaration)
    if let Option<usize>.Some {value: ordinal} = move found {
      let answer = run memberSignature(
        &mut thisStore.resolver,
        &mut thisStore.query,
        module,
        ordinal,
        Span.make(usize.ZERO, usize.ZERO),
      )
      run recordRoot(&mut request.*, Family.Signature, module, member, &answer)
      return move answer
    }
  }
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move rejected {
    let kept = run rootRejection(&mut thisStore.resolver, module, move diagnostic)
    run recordRoot(&mut request.*, Family.Signature, module, member, &kept)
    return move kept
  }
  // The owner's name is the nearest written anchor for an absent member.
  // A root lookup observes governing conditions without a dependent answer.
  let mut rootConditions = List<Dependency>.make()
  let selectedSelection = run select(&mut thisStore.resolver, &mut thisStore.query, &mut rootConditions, module, owner, false)
  let selected = match move selectedSelection {
    Result<Selection, Shared<Rejection>>.Success {value: selectedValue} => selectedValue
    Result<Selection, Shared<Rejection>>.Failure {error} => {
      let kept = run rootRejection(&mut thisStore.resolver, module, move error)
      run recordRoot(&mut request.*, Family.Signature, module, member, &kept)
      return move kept
    }
  }
  let absent = run rejectAbsent(&mut thisStore.resolver, module, selected.span, RejectionCode.UnknownOperation)
  run recordRoot(&mut request.*, Family.Signature, module, member, &absent)
  return move absent
}

/// Resolves the signature of one function or operation addressed by its declaration identity.
///
/// # Details
///
/// This is the answer the name lookups return for the same declaration, under the same gates: a
/// contract operation needs its contract's operation list, an `impl` member whose name is written
/// twice in its block rejects with `Collision`, and an inherent member returns its owner's kept
/// rejection unless the owner publishes it. An identity absent from the current revision
/// rejects with `UnknownMember`.
pub effect fn demandSignatureOf(
  thisStore: &mut Semantic,
  request: &mut Request,
  declaration: &DeclarationId,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = DeclarationId.moduleId(declaration)
  let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &identity)
  let answer = match move found {
    Option<usize>.Some {value: ordinal} => run requestMemberSignature(
      &mut thisStore.resolver,
      &mut thisStore.query,
      &mut request.*,
      module,
      ordinal,
      Span.make(usize.ZERO, usize.ZERO),
    )
    Option<usize>.None => run rejectAbsent(
      &mut thisStore.resolver,
      module,
      Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
  }
  let spelled = run DeclarationId.copySpelling(declaration)
  run recordRoot(
    &mut request.*,
    Family.Signature,
    module,
    Bytes.asSlice(&spelled),
    &answer,
  )
  return move answer
}

/// Resolves a contract operation's written call signature under an applied interface and
/// provider, without choosing evidence for the application. Qualified calls, method calls, and
/// operators use this same `Self` substitution after their supplier has been selected. The
/// caller must separately prove the application or supply a declared bound.
pub effect fn demandAppliedOperation(
  thisStore: &mut Semantic,
  request: &mut Request,
  contract: &Interned<Type>,
  provider: &Interned<Type>,
  operation: &DeclarationId,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let moduleOrdinal = declaringModuleOrdinal(&thisStore.resolver, contract)
  if moduleOrdinal == usize.MAX {
    fail InvalidModulePath {}
  }
  let module = resolvedModule(&thisStore.resolver, moduleOrdinal)
  let identity = run Types.internDeclaration(DeclarationId.copy(operation))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, &module, &identity)
  let ordinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      let absent = run rejectAbsent(
        &mut thisStore.resolver,
        &module,
        Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
      let spelled = run DeclarationId.copySpelling(operation)
      run recordRoot(
        &mut request.*,
        Family.AppliedOperation,
        &module,
        Bytes.asSlice(&spelled),
        &absent,
      )
      return move absent
    }
  }
  let declarationAccess262Request = Key {
    family: Family.AppliedOperation,
    module: moduleOrdinal,
    name: run internApplication(&mut thisStore.resolver, contract),
    declaration: ordinal,
    member: run internApplication(&mut thisStore.resolver, provider),
    external: false,
  }
  let declarationAccess262 = run internDeclaration(&mut thisStore.resolver, declarationAccess262Request)
  let key = declarationAccess262
  let answer = run demandRaw(
    &mut thisStore.resolver,
    &mut thisStore.query,
    key,
    Span.make(usize.ZERO, usize.ZERO),
  )
  let spelled = run DeclarationId.copySpelling(operation)
  run recordRoot(
    &mut request.*,
    Family.AppliedOperation,
    &module,
    Bytes.asSlice(&spelled),
    &answer,
  )
  return move answer
}

/// Resolves a contract operation's signature under one conformance `impl`, with the contract's
/// binders bound to the head's contract arguments and `Self` to its provider.
///
/// # Details
///
/// The operation keeps its own binders as its parameters. The supplied arguments are not checked
/// against the contract's bounds. An operation that is not in the head's contract, or a head with
/// no contract, rejects with `UnknownMember`; a rejected head or operation list rejects with its
/// diagnostic. No member or body of the implementation is read.
pub effect fn demandOperationUnder(
  thisStore: &mut Semantic,
  request: &mut Request,
  implementation: &DeclarationId,
  operation: &DeclarationId,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = DeclarationId.moduleId(implementation)
  let spelled = run DeclarationId.copySpelling(operation)
  let name = Bytes.asSlice(&spelled)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let identity = run Types.internDeclaration(DeclarationId.copy(implementation))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &identity)
  let ordinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      let absent = run rejectAbsent(&mut thisStore.resolver, module, Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
      run recordRoot(&mut request.*, Family.OperationUnder, module, name, &absent)
      return move absent
    }
  }
  let position = run operationPosition(
    &mut thisStore.resolver,
    &mut thisStore.query,
    moduleOrdinal,
    ordinal,
    operation,
  )
  let member = match move position {
    Result<usize, Shared<Result<Answer, NoRejection>>>.Success {value} => value
    Result<usize, Shared<Result<Answer, NoRejection>>>.Failure {error} => {
      run recordRoot(&mut request.*, Family.OperationUnder, module, name, &error)
      return move error
    }
  }
  let declarationAccess263Request = Key {
    family: Family.OperationUnder,
    module: moduleOrdinal,
    name: usize.ZERO,
    declaration: ordinal,
    member: member,
    external: false,
  }
  let declarationAccess263 = run internDeclaration(&mut thisStore.resolver, declarationAccess263Request)
  let key = declarationAccess263
  let answer = run demandRaw(
    &mut thisStore.resolver,
    &mut thisStore.query,
    key,
    Span.make(usize.ZERO, usize.ZERO),
  )
  run recordRoot(&mut request.*, Family.OperationUnder, module, name, &answer)
  return move answer
}

/// Pairs every contract operation of one conformance `impl` with the member that implements it,
/// and checks each member's header against the operation's header under the conformance head.
///
/// # Details
///
/// The witnesses follow the contract's operation order. A missing, unknown, or incompatible
/// member rejects with `IncompatibleWitness`, which names the failing component, at the member
/// or, for a missing one, at the `impl`. A narrower implementation keeps the operation's header
/// as the contract callers see. No member body is read, and a successful answer proves no
/// conformance: the head's bounds and coherence are separate facts. An inherent or sealed head
/// rejects with `UnknownMember`.
pub effect fn demandWitnesses(
  thisStore: &mut Semantic,
  request: &mut Request,
  implementation: &DeclarationId,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = DeclarationId.moduleId(implementation)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let identity = run Types.internDeclaration(DeclarationId.copy(implementation))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &identity)
  if let Option<usize>.Some {value: ordinal} = move found {
    let declarationAccess264Request = Key {
      family: Family.Witnesses,
      module: moduleOrdinal,
      name: usize.ZERO,
      declaration: ordinal,
      member: usize.ZERO,
      external: false,
    }
    let declarationAccess264 = run internDeclaration(&mut thisStore.resolver, declarationAccess264Request)
    let key = declarationAccess264
    let answer = run demandRaw(
      &mut thisStore.resolver,
      &mut thisStore.query,
      key,
      Span.make(usize.ZERO, usize.ZERO),
    )
    run recordRoot(&mut request.*, Family.Witnesses, module, b"", &answer)
    return move answer
  }
  let absent = run rejectAbsent(&mut thisStore.resolver, module, Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
  run recordRoot(&mut request.*, Family.Witnesses, module, b"", &absent)
  return move absent
}

/// Resolves a function's written parameter and result types without reading its body.
/// Returns an anchored rejection for an unsupported header or referenced type.
pub effect fn demandSignature(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(
    &mut thisStore.resolver,
    &mut thisStore.query,
    module,
    name,
    Family.Signature,
  )
  run recordRoot(&mut request.*, Family.Signature, module, name, &answer)
  return move answer
}

/// Resolves a constant's written type without reading its initializer.
///
/// # Details
///
/// The type is one primitive scalar or `string`, whose omitted lifetime is `'static`. Any other
/// type is an anchored `InvalidConstant` rejection.
pub effect fn demandConstant(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(&mut thisStore.resolver, &mut thisStore.query, module, name, Family.Constant)
  run recordRoot(&mut request.*, Family.Constant, module, name, &answer)
  return move answer
}

/// Resolves one registered package parameter's header without evaluating its default.
pub effect fn demandParameterSchema(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  if !Request.hasRegisteredSchemaModule(&request.*, module) {
    let diagnostic = run reject(
      &thisStore.resolver,
      module,
      RejectionCode.UnregisteredParameter,
      Span.make(usize.ZERO, usize.ZERO),
    )
    let answer = run rootRejection(&mut thisStore.resolver, module, move diagnostic)
    run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
    return move answer
  }
  let conditional = run conditionalParameterSpan(&mut thisStore.resolver, module, name)
  if let Option<Span>.Some {value: span} = move conditional {
    let diagnostic = run conditionalParameterRejection(module, span, name)
    let answer = run rootRejection(&mut thisStore.resolver, module, move diagnostic)
    run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
    return move answer
  }
  let answer = run demandNamed(
    &mut thisStore.resolver,
    &mut thisStore.query,
    module,
    name,
    Family.ParameterSchema,
  )
  run recordRoot(&mut request.*, Family.ParameterSchema, module, name, &answer)
  return move answer
}

/// Evaluates one registered parameter's exact source default through the held static machine.
pub effect fn demandParameterDefault(
  thisStore: &mut Semantic,
  request: &mut Request,
  identity: &DeclarationId,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = DeclarationId.moduleId(identity)
  let spelled = run DeclarationId.copySpelling(identity)
  let name = Bytes.asSlice(&spelled)
  if !Request.hasRegisteredSchemaModule(&request.*, module) {
    let diagnostic = run reject(&thisStore.resolver, module, RejectionCode.UnregisteredParameter, Span.make(usize.ZERO, usize.ZERO))
    let answer = run rootRejection(&mut thisStore.resolver, module, move diagnostic)
    run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
    return move answer
  }
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let owned = run Types.internDeclaration(DeclarationId.copy(identity))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &owned)
  let ordinal = match move found {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      let absent = run rejectAbsent(&mut thisStore.resolver, module, Span.make(usize.ZERO, usize.ZERO), RejectionCode.IdentityUnavailable)
      run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &absent)
      return move absent
    }
  }
  let declarationAccess265Request = Key {
    family: Family.ParameterDefault, module: moduleOrdinal, name: usize.ZERO,
    declaration: ordinal, member: usize.ZERO, external: false,
  }
  let declarationAccess265 = run internDeclaration(&mut thisStore.resolver, declarationAccess265Request)
  let key = declarationAccess265
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, key, Span.make(usize.ZERO, usize.ZERO))
  run recordRoot(&mut request.*, Family.ParameterDefault, module, name, &answer)
  return move answer
}

/// Demands every parameter header in each explicitly registered source module.
/// Imports alone never add schemas. Registered modules are visited in canonical order.
pub effect fn demandRegisteredParameters(thisStore: &mut Semantic, request: &mut Request) -> Result<
  List<RegisteredParameter>,
  Shared<Rejection>,
> ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut results = List<RegisteredParameter>.make()
  let mut moduleAt = usize.ZERO
  while moduleAt < Request.registeredSchemaModules(&request.*).length {
    let selected = Request.registeredSchemaModules(&request.*)
    let module = ModuleId.copy(&selected[moduleAt])
    let loaded = run source(&mut thisStore.resolver, &module)
    let mut names = List<RegisteredName>.make()
    if let Option<&IndexedSource>.Some {value: indexed} = move sourceOf(
      &thisStore.resolver,
      &loaded,
      &module,
    ) {
      let hir = IndexedSource.authored(indexed)
      let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(indexed))
      let mut at = usize.ZERO
      while at < declarations.length {
        let topLevel = match & declarations[at].parent {
          Option<usize>.None => true
          Option<usize>.Some {..} => false
        }
        if topLevel && DeclarationId.kind(&declarations[at].identity) == OwnerKind.PackageParameter {
          if let Node.PackageParameterHeader {name, ..} = Module.node(
            hir,
            declarations[at].header,
          ) {
            if let Node.Name {text} = Module.node(hir, name) {
              run List<RegisteredName>.append(&mut names, RegisteredName {
                name: run Bytes.copy(Module.text(hir, text)),
                identity: DeclarationId.copy(&declarations[at].identity),
              })
            }
          }
        }
        at = at + usize.ONE
      }
    } else {
      return Result<List<RegisteredParameter>, Shared<Rejection>>.failResult(
        run reject(
          &thisStore.resolver,
          &module,
          RejectionCode.MissingModule,
          Span.make(usize.ZERO, usize.ZERO),
        ),
      )
    }
    while List<RegisteredName>.length(&names) > usize.ZERO {
      let listed = List<RegisteredName>.remove(&mut names, usize.ZERO)
      let answer = run Semantic.demandParameterSchema(
        &mut thisStore.*, &mut request.*, &module, Bytes.asSlice(&listed.name),
      )
      run List<RegisteredParameter>.append(&mut results, RegisteredParameter {
        module: ModuleId.copy(&module),
        name: move listed.name,
        identity: move listed.identity,
        answer: move answer,
      })
    }
    moduleAt = moduleAt + usize.ONE
  }
  return Result<List<RegisteredParameter>, Shared<Rejection>>.succeed(move results)
}

/// Publishes a constant's value when its initializer needs no static execution.
///
/// # Details
///
/// The value demand first demands the constant's type. An exact Boolean or integer literal
/// within its selected target range is the value. A bare name of another constant demands that
/// constant's type, then its value, so a repeated initializer path is a `Cycle` rejection while
/// both types stay available.
///
/// # Gotchas
///
/// Every other initializer, including floating-point, text, call, or operator, is an anchored
/// `Unsupported` rejection rather than a provisional value.
pub effect fn demandInitializer(
  thisStore: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let answer = run demandNamed(
    &mut thisStore.resolver,
    &mut thisStore.query,
    module,
    name,
    Family.Initializer,
  )
  run recordRoot(&mut request.*, Family.Initializer, module, name, &answer)
  return move answer
}

/// Types one exact authored function/operation through the same identity gates as SignatureOf.
/// Unsupported and rejection answers remain their actual discriminants; no-body syntax never
/// gains a fabricated checked body. This is ordinary abstract Body, not selected executable MIR.
pub effect fn demandBodyOf(thisStore: &mut Semantic, request: &mut Request, declaration: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let module = DeclarationId.moduleId(declaration)
  let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, module, &identity)
  let span = Span.make(usize.ZERO, usize.ZERO)
  let answer = match move found {
    Option<usize>.None => run rejectAbsent(&mut thisStore.resolver, module, span, RejectionCode.IdentityUnavailable)
    Option<usize>.Some {value: ordinal} => run requestMemberBody(
      &mut thisStore.resolver, &mut thisStore.query, &mut request.*, module, ordinal, span)
  }
  let spelled = run DeclarationId.copySpelling(declaration)
  run recordRoot(&mut request.*, Family.Body, module, Bytes.asSlice(&spelled), &answer)
  return move answer
}

/// Demands the drop glue MIR of one type through the `Family.Mir` key the instance worklist
/// interns for it. A type that mentions no declaration has no glue and answers `LayoutUnsupported`.
pub effect fn demandGlueMir(thisStore: &mut Semantic, request: &mut Request, ty: &Interned<Type>, sourceOwner: &DeclarationId) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let span = Span.make(usize.ZERO, usize.ZERO)
  let glueResult = match move run InstanceKey.dropGlue(ty, sourceOwner) {
    Result<Option<InstanceKey>, CanonicalizationFailure>.Success {value: canonicalGlue} => move canonicalGlue
    Result<Option<InstanceKey>, CanonicalizationFailure>.Failure {..} => {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(
        run canonicalRejection(&mut thisStore.resolver, sourceOwner, span), List<Dependency>.make())))
    }
  }
  let instance = match move glueResult {
    Option<InstanceKey>.Some {value} => move value
    Option<InstanceKey>.None => {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberSuccess(Value.LayoutUnsupported, List<Dependency>.make())))
    }
  }
  let identity = InstanceKey.identity(&instance)
  let owner = DeclarationId.copyShared(&identity)
  let module = ModuleId.copy(DeclarationId.moduleId(&owner))
  let location = match move run locationOfInstance(&mut thisStore.resolver, &instance) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(
        run reject(&thisStore.resolver, &module, RejectionCode.IdentityUnavailable, span), List<Dependency>.make())))
    }
  }
  let name = run internBackendInstance(&mut thisStore.resolver, &instance, false)
  let declarationAccess266Request = Key {
    family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(&instance), external: false,
  }
  let declarationAccess266 = run internDeclaration(&mut thisStore.resolver, declarationAccess266Request)
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess266, span)
  run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
  return run anchorCanonicalAnswer(&mut thisStore.resolver, &answer, sourceOwner, span)
}

// Lowers a named check root whose caller has already verified its signature.
pub effect fn namedCheckMir(thisStore: &mut Semantic, request: &mut Request, declaration: &DeclarationId) -> Option<Shared<Result<Answer, NoRejection>>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let span = Span.make(usize.ZERO, usize.ZERO)
  let identity = run Types.internDeclaration(DeclarationId.copy(declaration))
  let instance = run InstanceKey.named(&identity)
  let module = ModuleId.copy(DeclarationId.moduleId(declaration))
  let location = match move run locationOfInstance(&mut thisStore.resolver, &instance) {
    Option<InstanceLocation>.Some {value} => value
    Option<InstanceLocation>.None => {
      return Option<Shared<Result<Answer, NoRejection>>>.some(run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(
        run reject(&thisStore.resolver, &module, RejectionCode.IdentityUnavailable, span), List<Dependency>.make()))))
    }
  }
  let name = run internBackendInstance(&mut thisStore.resolver, &instance, false)
  let declarationAccess267Request = Key {
    family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(&instance), external: false,
  }
  let declarationAccess267 = run internDeclaration(&mut thisStore.resolver, declarationAccess267Request)
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess267, span)
  run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
  return Option<Shared<Result<Answer, NoRejection>>>.some(move answer)
}

/// Demands MIR for one complete semantic environment before runtime identity can be reused.
/// Header validation and admission precede the exact-application query cache; target callees
/// remain body-lazy. The instance key numbers the application's caller regions canonically;
/// `'static` and region sharing remain exact evidence even when emitted instructions coincide.
pub effect fn demandApplicationMir(thisStore: &mut Semantic, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declaredModule = Application.bodyDeclaration(application)
  let module = ModuleId.copy(DeclarationId.moduleId(declaredModule))
  let span = Span.make(usize.ZERO, usize.ZERO)
  let checked = run Semantic.validateApplication(&mut thisStore.*, &mut request.*, application, &module, span)
  let environment = match move checked {
    Result<Application, Shared<Rejection>>.Success {value} => move value
    Result<Application, Shared<Rejection>>.Failure {error} => {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(move error, List<Dependency>.make())))
    }
  }
  let mut admission = Admission.make()
  let admitted = run Admission.enter(&mut admission, &environment, Edge.Direct)
  let open = match move admitted { Decision.Open => true _ => false }
  if open {
    let identity = run Types.internDeclaration(DeclarationId.copy(Application.bodyDeclaration(&environment)))
    return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(memberSuccess(
      Value.Unsupported {gap: run Shared<BackendGap>.make(BackendGap.make(GapCode.OpenInstance, &identity, span))}, List<Dependency>.make())))
  }
  // Every region pattern of an application shares one backend instance (IMPL-007), so a root
  // proves its own conformance bounds before reuse: a conformance head can accept one region
  // pattern and refuse another, and the answer must not depend on which was demanded first.
  let refused = run rootConformanceRefusal(&mut thisStore.resolver, &mut thisStore.query, &environment, &module, span)
  if let Option<Shared<Rejection>>.Some {value: diagnostic} = move refused {
    return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(move diagnostic,
      List<Dependency>.make())))
  }
  let instance = match move run InstanceKey.function(move environment) {
    Result<InstanceKey, CanonicalizationFailure>.Success {value: canonicalKey} => move canonicalKey
    Result<InstanceKey, CanonicalizationFailure>.Failure {..} => {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(
        run canonicalRejection(&mut thisStore.resolver, declaredModule, span), List<Dependency>.make())))
    }
  }
  let found = run locationOfInstance(&mut thisStore.resolver, &instance)
  let location = match move found {
    Option<InstanceLocation>.Some {value} => value
    _ => { return CompilerBug.panic(b"MissingRetainedFact: demandApplicationMir") }
  }
  let name = run internBackendInstance(&mut thisStore.resolver, &instance, false)
  let declarationAccess268Request = Key {
    family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: usize.ZERO, external: false,
  }
  let declarationAccess268 = run internDeclaration(&mut thisStore.resolver, declarationAccess268Request)
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess268, span)
  run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
  return run anchorCanonicalAnswer(&mut thisStore.resolver, &answer, declaredModule, span)
}

/// Demands MIR for one exact reached instance, such as a call's callee key with its providers, for
/// a program that does or does not observe diagnostics (failure observer note N1).
/// `sourceOwner` and `span` identify the authentic requester, independently of a generated key.
/// A zero span requests that actual owner's original header; it is never a published refusal.
pub effect fn demandInstanceMir(thisStore: &mut Semantic, request: &mut Request, instance: &InstanceKey, sourceOwner: &DeclarationId, span: Span, observing: bool) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let declared = DeclarationId.copyShared(&InstanceKey.identity(instance))
  let module = ModuleId.copy(DeclarationId.moduleId(&declared))
  let querySpan = Span.make(usize.ZERO, usize.ZERO)
  let location = match move run locationOfInstance(&mut thisStore.resolver, instance) {
    Option<InstanceLocation>.Some {value} => value
    _ => { return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(
      run reject(&thisStore.resolver, &module, RejectionCode.IdentityUnavailable, querySpan), List<Dependency>.make()))) }
  }
  let name = run internBackendInstance(&mut thisStore.resolver, instance, observing)
  let declarationAccess269Request = Key {
    family: Family.Mir, module: location.module, name: name, declaration: location.declaration, member: instanceMember(instance), external: false,
  }
  let declarationAccess269 = run internDeclaration(&mut thisStore.resolver, declarationAccess269Request)
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess269, querySpan)
  run recordRoot(&mut request.*, Family.Mir, &module, b"", &answer)
  return run anchorCanonicalAnswer(&mut thisStore.resolver, &answer, sourceOwner, span)
}

/// Source-validates one instance and returns its immutable content-keyed LLVM answer.
/// The source owner/span belong to its requester; generated instance identity is not source.
/// A zero span asks for the actual requesting owner's authored header.
pub effect fn demandInstanceText(
  thisStore: &mut Semantic,
  request: &mut Request,
  instance: &InstanceKey,
  sourceOwner: &DeclarationId,
  span: Span,
  observing: bool,
) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let declared = DeclarationId.copyShared(&InstanceKey.identity(instance))
  let module = ModuleId.copy(DeclarationId.moduleId(&declared))
  // The glue of a sealed core belongs to no source module.
  let sealed = SealedCore.declarationCore(&declared)
  if let Option<SealedKind>.None = move sealed { drop run internModule(&mut thisStore.resolver, &module) }
  let querySpan = Span.make(usize.ZERO, usize.ZERO)
  let location = match move run locationOfInstance(&mut thisStore.resolver, instance) {
    Option<InstanceLocation>.Some {value} => value
    _ => {
      return run Shared<Result<Answer, NoRejection>>.make(
        Result<Answer, NoRejection>.succeed(
          run memberRejected(
            run reject(&thisStore.resolver, &module, RejectionCode.IdentityUnavailable, querySpan),
            List<Dependency>.make(),
          ),
        ),
      )
    }
  }
  let name = run internBackendInstance(&mut thisStore.resolver, instance, observing)
  let declarationAccess270Request = Key {
    family: Family.EmissionInputs,
    module: location.module,
    name: name,
    declaration: location.declaration,
    member: instanceMember(instance),
    external: false,
  }
  let declarationAccess270 = run internDeclaration(&mut thisStore.resolver, declarationAccess270Request)
  let key = declarationAccess270
  let prepared = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, key, querySpan)
  run recordRoot(&mut request.*, Family.EmissionInputs, &module, b"", &prepared)
  let answer = run demandPreparedText(&mut thisStore.resolver, &mut thisStore.query, key, &prepared)
  run recordRoot(&mut request.*, Family.LlvmText, &module, b"", &answer)
  return run anchorCanonicalAnswer(&mut thisStore.resolver, &answer, sourceOwner, span)
}

/// Demands the selected residual body of one function under its complete semantic application.
///
/// # Details
/// The answer types only the residual its selection pass chose, with static results embedded.
/// Equal semantic applications share one selected body; the declaration's abstract body is a
/// different query and is never used for a function with static work.
pub effect fn demandSelectedBody(thisStore: &mut Semantic, request: &mut Request, application: &Application) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let declared = Application.bodyDeclaration(application)
  let module = ModuleId.copy(DeclarationId.moduleId(declared))
  let moduleOrdinal = run internModule(&mut thisStore.resolver, &module)
  let identity = run Types.internDeclaration(DeclarationId.copy(declared))
  let found = run ordinalOfIdentity(&mut thisStore.resolver, &module, &identity)
  let ordinal = match move found {
    Option<usize>.Some {value} => value
    _ => {
      return run Shared<Result<Answer, NoRejection>>.make(Result<Answer, NoRejection>.succeed(run memberRejected(
        run reject(&thisStore.resolver, &module, RejectionCode.IdentityUnavailable, Span.make(usize.ZERO, usize.ZERO)), List<Dependency>.make())))
    }
  }
  let interned = run internSelectedApplication(&mut thisStore.resolver, application)
  let declarationAccess271Request = Key {
    family: Family.Body, module: moduleOrdinal, name: usize.ZERO, declaration: ordinal, member: interned + usize.ONE, external: false,
  }
  let declarationAccess271 = run internDeclaration(&mut thisStore.resolver, declarationAccess271Request)
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess271, Span.make(usize.ZERO, usize.ZERO))
  run recordRoot(&mut request.*, Family.Body, &module, b"", &answer)
  return move answer
}

/// Demands backend-neutral target layout facts for one runtime type.
pub effect fn demandLayout(thisStore: &mut Semantic, request: &mut Request, module: &ModuleId, ty: &Interned<Type>) -> Shared<Result<Answer, NoRejection>>
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  run selectRequest(&mut thisStore.resolver, &request.*)
  let moduleOrdinal = run internModule(&mut thisStore.resolver, module)
  let application = run internErasedType(&mut thisStore.resolver, ty)
  let declarationAccess272Request = Key {
    family: Family.Layout, module: moduleOrdinal, name: application,
    declaration: usize.ZERO, member: usize.ZERO, external: false,
  }
  let declarationAccess272 = run internDeclaration(&mut thisStore.resolver, declarationAccess272Request)
  let answer = run demandRaw(&mut thisStore.resolver, &mut thisStore.query, declarationAccess272, Span.make(usize.ZERO, usize.ZERO))
  run recordRoot(&mut request.*, Family.Layout, module, b"", &answer)
  return move answer
}
