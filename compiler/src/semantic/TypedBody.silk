//! Typed nodes and retained evidence for one function body.
//!
//! # When to use
//! Use [`TypedBody`] after a body demand succeeds. Inspect [`Stage`] before treating a body as
//! fully checked: abstract and other non-scalar bodies retain safety obligations.
//!
//! # Details
//! Syntax identities in nodes and local entries belong to the source observation returned with
//! the body result. Local IDs belong only to this body. Direct calls use canonical identities.

import hir.Hir {Access, HirId, InfixOperator, PrefixOperator}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.BodyInput {BodyInput}
import semantic.Intrinsic {Member}
import semantic.Type {Argument, Binding, Type}
import semantic.Specialization {Application}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// The position of one typed node in its owning body.
pub struct NodeId {
  /// The zero-based position in `TypedBody.nodes`.
  pub index: usize
}

impl Copy for NodeId {}

/// The position of one parameter or binding in its owning body.
pub struct LocalId {
  /// The zero-based position in `TypedBody.locals`.
  pub index: usize
}

impl Copy for LocalId {}

/// The declared way a receiver-call argument is passed to parameter zero.
pub enum ReceiverPass {
  /// Share a loan of the receiver place.
  Shared,
  /// Take an exclusive loan of the receiver place.
  Mutable,
  /// Transfer ownership of the receiver value.
  Take,
}

/// A syntax node and span in the exact source owned by a typed body.
pub struct Origin {
  /// The HIR node in the body source; it has no meaning in another source.
  pub syntax: HirId
  /// The half-open byte span in the body source.
  pub span: Span
}

impl Copy for Origin {}

/// One parameter or binding whose type is fixed in a checked body.
pub struct Local {
  /// The source binder that introduced this local.
  pub origin: Origin
  /// The type selected when the parameter or binding was declared.
  pub ty: Shared<Type>
  /// Whether this body may replace the complete stored value.
  pub mutable: bool
}

/// One expression form accepted by body checking.
pub union Expression {
  /// An integer whose exact sign and magnitude remain in the owning HIR node.
  Integer {
    /// The integer literal in the body source.
    pub literal: HirId,
  },
  /// A floating literal whose width was selected by checking its source context.
  Float {
    /// The floating literal in the body source.
    pub literal: HirId,
  },
  /// A decoded static text literal retained in its owning HIR node.
  Text {pub literal: HirId},
  /// A Boolean value.
  Boolean {
    /// The checked Boolean value.
    pub value: bool,
  },
  /// The unit value.
  Unit,
  /// A parameter or binding in this body.
  Local {
    /// The body-local entry for this use.
    pub local: LocalId,
  },
  /// A loan of a checked place; lifetime safety remains an explicit obligation.
  Borrow {pub access: Access, pub value: NodeId},
  /// Remove only a raw pointer's mutation capability, retaining its actual source operand.
  PointerAccessWeaken {pub value: NodeId},
  /// A checked projection through one reference or raw pointer.
  Dereference {pub value: NodeId},
  /// One checked record projection; the ordinal belongs to its nominal declaration.
  Field {pub value: NodeId, pub index: usize},
  /// An explicit array reference converted to a borrowed pointer/length descriptor.
  ArraySlice {pub value: NodeId, pub count: usize},
  /// A slice subject is evaluated before reading its runtime logical length.
  SliceLength {pub value: NodeId},
  /// One checked array or slice element; the index is evaluated after the subject.
  Index {pub value: NodeId, pub index: NodeId},
  /// The array subject is evaluated before its type-known logical length is read.
  ArrayLength {pub value: NodeId, pub count: usize},
  /// Aggregate operands in source evaluation order, retaining destination field ordinals.
  Aggregate {pub fields: Vector<AggregateField>},
  /// A constant whose declared type is checked here; its value is demanded only if reached.
  Constant {pub declaration: Shared<DeclarationId>},
  /// A statically reached error; the checked message is evaluated before the diagnostic.
  CompileError {pub message: NodeId},
  /// An explicit whole-value transfer whose operand was typed independently.
  Move {
    /// The typed local use being transferred.
    pub value: NodeId,
  },
  /// A call to a canonical function declaration with arguments in evaluation order.
  DirectCall {
    /// The canonical called declaration.
    pub declaration: DeclarationId,
    /// The complete canonical target environment after call inference.
    pub application: Shared<Application>,
    /// The selected receiver pass, absent for an explicitly written call.
    pub receiverPass: Option<ReceiverPass>,
    /// The arguments in evaluation order.
    pub arguments: Vector<NodeId>,
  },
  /// An immediate C call. Its signature is a dependency, never a runtime body.
  ForeignCall {pub declaration: DeclarationId, pub arguments: Vector<NodeId>},
  /// A sealed compiler primitive selected and type-checked by the semantic resolver.
  IntrinsicCall {pub member: Member, pub arguments: Vector<NodeId>},
  /// A closed scalar prefix operation, with its operand evaluated once.
  ConcretePrefix {pub operator: PrefixOperator, pub operand: NodeId},
  /// A closed scalar or string infix operation; left precedes right at runtime.
  ConcreteInfix {pub operator: InfixOperator, pub left: NodeId, pub right: NodeId},
  /// An interface operation selected with a declared bound or a concrete witness.
  InterfaceCall {
    /// The exact selected interface application.
    pub contract: Shared<Type>,
    /// The exact provider type used for conformance selection.
    pub provider: Shared<Type>,
    /// The canonical operation declared by the interface.
    pub operation: DeclarationId,
    /// Existing argument-checking assignments, retaining actual caller regions.
    pub bindings: Shared<Vector<Binding>>,
    /// The selected concrete witness, or absence when a declared bound supplies the operation.
    pub implementation: Option<Shared<DeclarationId>>,
    /// The selected receiver pass, absent for a qualified or operator call.
    pub receiverPass: Option<ReceiverPass>,
    /// The arguments in source evaluation order, including a written or adapted receiver.
    pub arguments: Vector<NodeId>,
  },
}

/// A written aggregate operand and its canonical destination field.
pub struct AggregateField {
  pub index: usize
  pub value: NodeId
}

/// One typed expression or control-flow node in a checked body.
pub union NodeKind {
  /// An expression with its resolved semantic type.
  Expression {
    /// The checked semantic type.
    pub ty: Shared<Type>,
    /// The accepted expression form.
    pub form: Expression,
  },
  /// An immutable local and its initializer.
  LocalBinding {
    /// The body-local entry introduced by this statement.
    pub local: LocalId,
    /// The initializing expression.
    pub initializer: NodeId,
  },
  /// A mutable evaluator-local slot and its initial complete value.
  MutableBinding {pub local: LocalId, pub initializer: NodeId},
  /// Replacement of one complete mutable evaluator-local value.
  Assignment {pub local: LocalId, pub value: NodeId},
  /// Replacement through a checked mutable projected place.
  PlaceAssignment {pub target: NodeId, pub value: NodeId},
  /// An explicit return, with no value for unit return.
  Return {
    /// The returned expression, or absence for unit return.
    pub value: Option<NodeId>,
  },
  /// A runtime branch with both arms retained in source order.
  Branch {
    /// The checked Boolean condition.
    pub condition: NodeId,
    /// The arm executed when the condition is true.
    pub thenBranch: NodeId,
    /// The arm executed when the condition is false, if written.
    pub elseBranch: Option<NodeId>,
    /// Whether at least one runtime arm can continue after the branch.
    pub canComplete: bool,
  },
  /// A static loop with a checked Boolean condition and body.
  While {pub condition: NodeId, pub body: NodeId},
  /// Exit the nearest static loop.
  Break,
  /// Restart the nearest static loop.
  Continue,
  /// A sequence of statements in source order.
  Block {
    /// The statements in source order.
    pub statements: Vector<NodeId>,
    /// Whether a reachable path can continue after the block.
    pub canComplete: bool,
  },
}

/// A typed node and its exact source position.
pub struct Node {
  /// The syntax node and byte span in the body source.
  pub origin: Origin
  /// The typed expression or statement form.
  pub kind: NodeKind
}

/// A canonical function signature required to type this body.
pub struct SignatureDependency {
  /// The declaration whose written signature was demanded.
  pub declaration: DeclarationId
}

/// Safety work retained after typing a body against its written contract.
pub union SafetyObligation {
  /// A non-scalar value was introduced, read, or forwarded; ownership and cleanup remain open.
  WholeValue {
    /// The source place that must be checked in the later safety stage.
    pub origin: Origin,
    /// The exact type at that place, including any declaration-owned symbolic parameters.
    pub ty: Shared<Type>,
  },
  /// A written-signature or interface call was typed; argument ownership and lifetimes remain open.
  Invocation {
    /// The call that must be checked in the later safety stage.
    pub origin: Origin,
    /// The called declaration or interface operation, without requiring its body to type this call.
    pub declaration: DeclarationId,
  },
  /// A receiver pass needs place, move, and loan validation at the later safety stage.
  ReceiverPass {
    /// The receiver-call source site.
    pub origin: Origin,
    /// The selected receiver operand, evaluated once in the typed call.
    pub receiver: NodeId,
    /// The pass mode from the selected member contract.
    pub mode: ReceiverPass,
  },
}

/// The guarantee carried by a successful body demand.
pub union Stage {
  /// Existing scalar body checking has discharged the supported safety claims.
  FullyChecked,
  /// The body was typed against its written signature and declared bounds only.
  /// Ownership, lifetime, cleanup, and Effect execution safety are not discharged.
  ContractTyped {
    /// Specific source places retained for the later safety stage.
    pub obligations: Vector<SafetyObligation>,
  },
}

/// Owned header inputs for specializing one checked interface call.
pub struct InterfaceCallInputs {
  pub contract: Shared<Type>
  pub provider: Shared<Type>
  pub operation: Shared<DeclarationId>
  pub bindings: Shared<Vector<Binding>>
  pub origin: Origin
  pub result: Shared<Type>
  pub count: usize
}

/// One already checked argument, retained without extending its body borrow.
pub struct CallArgument {
  pub ty: Shared<Type>
  pub origin: Origin
}

struct InterfaceOperation {
  node: NodeId
  declaration: Shared<DeclarationId>
}

/// A typed body and the evidence needed by later consumers.
///
/// # Details
///
/// The source observation returned beside this payload owns every `HirId` in the nodes. A payload
/// can be kept across an edit only when its declaration bytes, syntax positions, and dependencies
/// validate. Required bodies name runtime callees that a later program build must close.
pub struct TypedBody {
  /// The canonical function declaration that owns this body.
  declaration: DeclarationId
  input: Shared<BodyInput>
  /// Parameters and bindings in the order they become available.
  locals: Vector<Local>
  /// The typed nodes, referenced by indices local to this body.
  nodes: Vector<Node>
  /// The checked block or reached expression that roots this payload.
  root: NodeId
  /// The written signatures demanded during body checking.
  dependencies: Vector<SignatureDependency>
  /// The canonical callees whose runtime bodies remain required.
  foreignDeclarations: Vector<Shared<DeclarationId>>
  requiredBodies: Vector<DeclarationId>
  interfaceOperations: Vector<InterfaceOperation>
  stage: Stage
}

fn inputAddress(input: &BodyInput) -> usize {
  return Pointer.address<BodyInput>(Pointer.fromRef<BodyInput>(input))
}

fn sameInput(previous: &BodyInput, input: &Shared<BodyInput>) -> bool {
  return Shared.with<BodyInput, bool>(input, fn(current: &BodyInput) -> bool {
    return BodyInput.equals(previous, current)
  })
}

impl TypedBody {
  /// Retains a checked direct call's complete application under a short body borrow.
  pub fn directApplication(self: &Shared<Self>, node: NodeId) -> Option<Shared<Application>> {
    return Shared.with<TypedBody, Option<Shared<Application>>>(self, fn(body: &TypedBody) -> Option<Shared<Application>> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.DirectCall {application, ..}, ..} = &nodes[node.index].kind {
          return Option.some<Shared<Application>>(Shared.clone<Application>(&application))
        }
      }
      return Option.none<Shared<Application>>()
    })
  }

  /// Retains interface header inputs under a short body borrow; no target body is selected here.
  pub fn interfaceCall(self: &Shared<Self>, node: NodeId) -> Option<InterfaceCallInputs> {
    return Shared.with<TypedBody, Option<InterfaceCallInputs>>(self, fn(body: &TypedBody) -> Option<InterfaceCallInputs> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.InterfaceCall {contract, provider, bindings, arguments, ..}, ty} = &nodes[node.index].kind {
          let operations = Vector.asSlice<InterfaceOperation>(&body.interfaceOperations)
          let mut at = usize.ZERO
          while at < operations.length {
            if operations[at].node.index == node.index {
              return Option.some<InterfaceCallInputs>(InterfaceCallInputs {
                contract: Shared.clone<Type>(&contract), provider: Shared.clone<Type>(&provider),
                operation: Shared.clone<DeclarationId>(&operations[at].declaration), bindings: Shared.clone<Vector<Binding>>(&bindings), origin: nodes[node.index].origin, result: Shared.clone<Type>(&ty), count: Vector.length<NodeId>(&arguments),
              })
            }
            at = at + usize.ONE
          }
        }
      }
      return Option.none<InterfaceCallInputs>()
    })
  }

  /// Retains the checked type and source origin of one written call argument.
  pub fn callArgument(self: &Shared<Self>, node: NodeId, at: usize) -> Option<CallArgument> {
    return Shared.with<TypedBody, Option<CallArgument>>(self, fn(body: &TypedBody) -> Option<CallArgument> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form, ..} = &nodes[node.index].kind {
          let arguments = match &form {
            Expression.DirectCall {arguments, ..} => Vector.asSlice<NodeId>(&arguments)
            Expression.InterfaceCall {arguments, ..} => Vector.asSlice<NodeId>(&arguments)
            _ => { return Option.none<CallArgument>() }
          }
          if at < arguments.length {
            let selected = arguments[at]
            if let NodeKind.Expression {ty, ..} = &nodes[selected.index].kind {
              return Option.some<CallArgument>(CallArgument {ty: Shared.clone<Type>(&ty), origin: nodes[selected.index].origin})
            }
          }
        }
      }
      return Option.none<CallArgument>()
    })
  }

  /// Creates a typed body with shared declaration inputs and owned checked nodes.
  ///
  /// # Gotchas
  ///
  /// `input` must describe `declaration` under the same source observation.
  pub effect fn make(
    declaration: &DeclarationId,
    input: Shared<BodyInput>,
    locals: Vector<Local>,
    nodes: Vector<Node>,
    root: NodeId,
    dependencies: Vector<SignatureDependency>,
    requiredBodies: Vector<DeclarationId>,
    stage: Stage,
  ) -> TypedBody ! OutOfMemoryError ? &mut Allocator {
    let mut foreignHandles = Vector.make<Shared<DeclarationId>>()
    let mut operations = Vector.make<InterfaceOperation>()
    let checked = Vector.asSlice<Node>(&nodes)
    let mut at = usize.ZERO
    while at < checked.length {
      if let NodeKind.Expression {form: Expression.ForeignCall {declaration: foreignDeclaration, ..}, ..} = &checked[at].kind {
        run Vector.append<Shared<DeclarationId>>(
          &mut foreignHandles,
          run Shared.make<DeclarationId>(run DeclarationId.copy(&foreignDeclaration)),
        )
      }
      if let NodeKind.Expression {form: Expression.InterfaceCall {operation, ..}, ..} = &checked[at].kind {
        run Vector.append<InterfaceOperation>(&mut operations, InterfaceOperation {
          node: NodeId {index: at}, declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&operation)),
        })
      }
      at = at + usize.ONE
    }
    return TypedBody {
      foreignDeclarations: move foreignHandles,
      declaration: run DeclarationId.copy(declaration),
      input: move input,
      locals: move locals,
      nodes: move nodes,
      root: root,
      dependencies: move dependencies,
      requiredBodies: move requiredBodies,
      interfaceOperations: move operations,
      stage: move stage,
    }
  }
  /// Checks exact shared declaration inputs, including source bytes and syntax positions.
  pub fn matchesInput(self: &Self, input: &Shared<BodyInput>) -> bool {
    // Equal immutable owners need no second shared borrow, including across retained revisions.
    if Shared.with<BodyInput, usize>(&self.input, inputAddress) == Shared.with<BodyInput, usize>(input, inputAddress) {
      return Shared.with<BodyInput, bool>(input, BodyInput.isStable)
    }
    return Shared.with<BodyInput, bool>(&self.input, fn(previous: &BodyInput) -> bool {
      return sameInput(previous, input)
    })
  }
  /// Borrows the canonical declaration that owns this checked body.
  pub fn declarationId(self: &Self) -> &DeclarationId {
    return &self.declaration
  }
  /// Borrows the entries addressed by this body's `LocalId` values.
  pub fn localSlice(self: &Self) -> &[Local] {
    return Vector.asSlice<Local>(&self.locals)
  }
  /// Borrows the checked nodes in this body.
  pub fn nodeSlice(self: &Self) -> &[Node] {
    return Vector.asSlice<Node>(&self.nodes)
  }
  /// Returns the index of the checked block or reached expression.
  pub fn rootNode(self: &Self) -> NodeId {
    return self.root
  }
  /// Borrows the canonical signatures demanded while checking this body.
  pub fn signatureDependencies(self: &Self) -> &[SignatureDependency] {
    return Vector.asSlice<SignatureDependency>(&self.dependencies)
  }
  /// Borrows the canonical callees whose runtime bodies remain required.
  pub fn runtimeBodies(self: &Self) -> &[DeclarationId] {
    return Vector.asSlice<DeclarationId>(&self.requiredBodies)
  }
  /// Borrows the identity handles of immediate foreign calls.
  pub fn foreignHandles(self: &Self) -> &[Shared<DeclarationId>] {
    return Vector.asSlice<Shared<DeclarationId>>(&self.foreignDeclarations)
  }
  /// Borrows the exact guarantee of this body result.
  pub fn checkingStage(self: &Self) -> &Stage {
    return &self.stage
  }
}
