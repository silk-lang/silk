//! Typed nodes and retained evidence for one function body.
//!
//! # When to use
//! Use [`TypedBody`] after a body demand succeeds. Inspect [`Stage`] before treating a body as
//! fully checked: abstract and other non-scalar bodies retain safety obligations.
//!
//! # Details
//! Syntax identities in nodes and local entries belong to the source observation returned with
//! the body result. Local IDs belong only to this body. Direct calls use canonical identities.

import hir.Hir {CallableMode, Access, HirId, InfixOperator, PrefixOperator}
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.CallableSchema {CallableSchema}
import semantic.BodyInput {BodyInput}
import semantic.Lifetime {Lifetime}
import semantic.Intrinsic {Member}
import semantic.Type {Argument, Binding, Type}
import semantic.Specialization {Application, StaticSlot}
import semantic.StaticValue {IntegerType as StaticIntegerType, Value as StaticData}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.shared {Shared}
import silk.u64
import silk.usize
import silk.vector {Vector}

/// The position of one typed node in its owning body.
pub struct NodeId {
  /// The zero-based position in `TypedBody.nodes`.
  pub index: usize
}

impl Copy for NodeId {}

/// The position of one parameter or binding in its owning body.
pub struct LocalId {
  /// The zero-based position in `TypedBody.locals`.
  pub index: usize
}

impl Copy for LocalId {}

/// The declared way a receiver-call argument is passed to parameter zero.
pub enum ReceiverPass {
  /// Share a loan of the receiver place.
  Shared,
  /// Take an exclusive loan of the receiver place.
  Mutable,
  /// Transfer ownership of the receiver value.
  Take,
}

/// A syntax node and span in the exact source owned by a typed body.
pub struct Origin {
  /// The HIR node in the body source; it has no meaning in another source.
  pub syntax: HirId
  /// The half-open byte span in the body source.
  pub span: Span
}

impl Copy for Origin {}

/// One parameter or binding whose type is fixed in a checked body.
pub struct Local {
  /// The source binder that introduced this local.
  pub origin: Origin
  /// The type selected when the parameter or binding was declared.
  pub ty: Shared<Type>
  /// Whether this body may replace the complete stored value.
  pub mutable: bool
}

/// One expression form accepted by body checking.
pub union Expression {
  /// An integer whose exact sign and magnitude remain in the owning HIR node.
  Integer {
    /// The integer literal in the body source.
    pub literal: HirId,
  },
  /// A floating literal whose width was selected by checking its source context.
  Float {
    /// The floating literal in the body source.
    pub literal: HirId,
  },
  /// A decoded text or byte-string literal retained in its owning HIR node.
  Text {pub literal: HirId},
  /// A Boolean value.
  Boolean {
    /// The checked Boolean value.
    pub value: bool,
  },
  /// The unit value.
  Unit,
  /// A parameter or binding in this body.
  Local {
    /// The body-local entry for this use.
    pub local: LocalId,
  },
  /// A loan of a checked place; lifetime safety remains an explicit obligation.
  Borrow {pub access: Access, pub value: NodeId},
  /// Remove a raw pointer's mutation capability or add nullability, retaining its actual source
  /// operand.
  PointerWeaken {pub value: NodeId},
  /// A checked projection through one reference or raw pointer.
  Dereference {pub value: NodeId},
  /// One checked record projection; the ordinal belongs to its nominal declaration.
  Field {pub value: NodeId, pub index: usize},
  /// An explicit array reference converted to a borrowed pointer/length descriptor.
  ArraySlice {pub value: NodeId, pub count: usize},
  /// A slice subject is evaluated before reading its runtime logical length.
  SliceLength {pub value: NodeId},
  /// One checked array or slice element; the index is evaluated after the subject.
  Index {pub value: NodeId, pub index: NodeId},
  /// The array subject is evaluated before its type-known logical length is read.
  ArrayLength {pub value: NodeId, pub count: usize},
  /// Aggregate operands in source evaluation order, retaining destination field ordinals.
  Aggregate {pub fields: Vector<AggregateField>},
  /// Construction of an exact anonymous environment. Its checked body is a separate declaration.
  Callable {pub fields: Vector<AggregateField>, pub body: Shared<TypedBody>},
  /// A stored callable evaluated once, followed by newly retained trailing operands. The exact
  /// result type describes whether its original environment stays nested or its fields flatten.
  StagedCallable {pub callee: NodeId, pub mode: CallableMode, pub arguments: Vector<NodeId>},
  /// A constant whose declared type is checked here; its value is demanded only if reached.
  Constant {pub declaration: Shared<DeclarationId>},
  /// One selected scalar enum member, carrying its validated representation value.
  EnumMember {pub member: EnumMember},
  /// A scalar enum operand read as its backing integer; the bits are unchanged.
  EnumValue {pub value: NodeId},
  /// A closed member value stored in its structural union under the member's canonical tag.
  UnionInject {pub tag: usize, pub value: NodeId},
  /// One nominal union variant with its written fields in source order and declaration-order tag.
  VariantConstruct {pub tag: usize, pub fields: Vector<AggregateField>},
  /// A pattern binding: a place reached from the matched subject by `path`, read as `access`. Its
  /// arm lists the node that declares it; every use is a separate node with the same subject and path.
  PatternBinding {pub subject: NodeId, pub path: Vector<PlaceStep>, pub access: BindingAccess},
  /// A subject evaluated once, then tested against arms in written order. A `Place` access
  /// addresses the subject's own storage; otherwise arms read the evaluated subject. `tags` counts
  /// the members or variants of a tagged union subject and is zero otherwise.
  Match {
    pub subject: NodeId,
    pub access: SubjectAccess,
    pub tags: usize,
    /// Whole subject members for flow coverage; MAX denotes an open scalar domain.
    /// Enum members are finite even though their scalar representation needs no union tags.
    pub domain: usize,
    pub arms: Vector<MatchArm>,
    /// The form this match was written as, which fixes where a consuming match's arm bindings and
    /// the subject parts no binding took end.
    pub syntax: MatchSyntax,
  },
  /// A statically reached error; the checked message is evaluated before the diagnostic.
  CompileError {pub message: NodeId},
  /// A static value selected for this body, checked at its exact type. It has no runtime
  /// local, call or reference: a `let static` read or a static-helper call.
  Embedded {pub value: Shared<StaticData>},
  /// A transfer of an owned value: an explicit `move`, or a by-value receiver of an affine place.
  Move {
    /// The typed operand being transferred.
    pub value: NodeId,
    /// The place the operand leaves without an owner, or absence for an owned rvalue operand.
    pub consumed: Option<ConsumedPlace>,
  },
  /// Invocation through an exact representation; specialization chooses its direct body target.
  CallableCall {
    pub callee: NodeId,
    pub mode: CallableMode,
    pub arguments: Vector<NodeId>,
    /// The fresh owner and inferred invocation assignments, retained until direct specialization.
    pub inference: Shared<DeclarationId>,
    pub bindings: Shared<Vector<Binding>>,
    /// Pipelines finish their input before evaluating the callable target.
    pub pipeline: bool,
  },
  /// A call to a canonical function declaration with arguments in evaluation order.
  DirectCall {
    /// The canonical called declaration.
    pub declaration: DeclarationId,
    /// The complete canonical target environment after call inference.
    pub application: Shared<Application>,
    /// The selected receiver pass, absent for an explicitly written call.
    pub receiverPass: Option<ReceiverPass>,
    /// The arguments in evaluation order.
    pub arguments: Vector<NodeId>,
  },
  /// An immediate C call. Its signature is a dependency, never a runtime body.
  ForeignCall {pub declaration: DeclarationId, pub arguments: Vector<NodeId>},
  /// `run` executes exactly one Effect layer (EFF-003). The operand's exact representation names
  /// its runner; its failures propagate through the enclosing failure channel.
  /// `immediate` when the operand is itself an `effect fn` call or an invocation of an `effect fn`
  /// value: the run is that one call. Otherwise a stored Effect runs through its runner (D1).
  Run {pub value: NodeId, pub immediate: bool},
  /// A sealed compiler primitive selected and type-checked by the semantic resolver.
  IntrinsicCall {pub member: Member, pub arguments: Vector<NodeId>},
  /// A closed scalar prefix operation, with its operand evaluated once.
  ConcretePrefix {pub operator: PrefixOperator, pub operand: NodeId},
  /// A closed scalar or string infix operation; left precedes right at runtime.
  ConcreteInfix {pub operator: InfixOperator, pub left: NodeId, pub right: NodeId},
  /// An interface operation selected with a declared bound or a concrete witness.
  InterfaceCall {
    /// The exact selected interface application.
    pub contract: Shared<Type>,
    /// The exact provider type used for conformance selection.
    pub provider: Shared<Type>,
    /// The canonical operation declared by the interface.
    pub operation: DeclarationId,
    /// Existing argument-checking assignments, retaining actual caller regions.
    pub bindings: Shared<Vector<Binding>>,
    /// The selected concrete witness, or absence when a declared bound supplies the operation.
    pub implementation: Option<Shared<DeclarationId>>,
    /// The selected receiver pass, absent for a qualified or operator call.
    pub receiverPass: Option<ReceiverPass>,
    /// The arguments in source evaluation order, including a written or adapted receiver.
    pub arguments: Vector<NodeId>,
  },
}

/// One scalar enum member and its validated representation value in sign-magnitude form.
pub struct EnumMember {
  /// The member's position in its enum declaration.
  pub ordinal: usize
  pub negative: bool
  pub magnitude: u64
  /// The enum's representation integer type, which a static enum value records.
  pub representation: StaticIntegerType
}

impl Copy for EnumMember {}

/// One structural-union member selected by its original source ordinal.
pub struct UnionMember {
  pub tag: usize
  pub ty: Shared<Type>
  pub source: Shared<Type>
}

/// A checked pattern. Coverage was validated against the subject's complete member set.
pub union Pattern {
  /// Accepts every value not selected by an earlier arm.
  Universal,
  /// Selects exactly one scalar enum member.
  EnumMember {pub member: EnumMember},
  /// Selects one structural-union member, or the record subject itself, with irrefutable fields.
  Record {pub member: Option<UnionMember>},
  /// Selects one nominal union variant by its declaration-order tag.
  Variant {pub tag: usize},
  /// Selects one integer value of an integer scrutinee: its decimal magnitude and sign.
  Integer {pub magnitude: u64, pub negative: bool},
}

/// One statically known projection from a matched subject or consumed root toward a place.
pub union PlaceStep {
  /// The payload selected by an ordinal in the retained original source union.
  Member {pub tag: usize, pub ty: Shared<Type>, pub source: Shared<Type>},
  /// One field of the nominal union variant with this declaration-order tag.
  VariantField {pub tag: usize, pub field: usize},
  /// One record field.
  Field {pub index: usize},
  /// One fixed-array element at a statically known in-bounds index.
  Element {pub index: usize},
}

/// The owner a consumed place is projected from.
pub union PlaceRoot {
  /// A parameter or binding of this body.
  Local {pub local: LocalId},
  /// The evaluated subject of the match whose arm binds the consumed place.
  Subject {pub subject: NodeId},
}

/// An owned place a consuming site transfers out of: its root and static projection path. An empty
/// path consumes the complete root (OWN-003); a non-empty path is a partial move (OWN-004).
pub struct ConsumedPlace {
  pub root: PlaceRoot
  pub steps: Vector<PlaceStep>
}

/// How a match reads its subject (MATCH-001).
pub union SubjectAccess {
  /// A bare match reads one copy of a Copy subject.
  Copy,
  /// `match move` consumes the subject: its place when it names one, otherwise an owned rvalue.
  Consume {pub consumed: Option<ConsumedPlace>},
  /// `match place`, `match &` and `match &mut` address the subject's own storage.
  /// The access distinguishes owned inspection from a borrowing read for ownership diagnostics.
  Place {pub access: BindingAccess},
}

/// How an arm-local binding reaches the matched subject.
pub enum BindingAccess {
  /// A bare match's binding reads a copy of a Copy subject.
  Copied,
  /// A `match move` binding owns its part of the consumed subject (MATCH-002).
  Moved,
  /// A `match place` binding names the subject's own storage.
  Place,
  /// A `match &` binding is a shared view of the subject.
  Shared,
  /// A `match &mut` binding, the only binding that may be borrowed or assigned exclusively.
  Exclusive,
}

/// The form a match was written as. For a consuming match it fixes where the selected arm's
/// by-value bindings and the subject parts that no binding took end.
pub enum MatchSyntax {
  /// A written `match`: both end with the selected arm (MATCH-002).
  Match,
  /// An `if let`: the parts no binding took, or the whole unmatched subject, are dropped as soon as
  /// a path is selected, before it runs (PATT-008). The bindings end with the taken body.
  IfLet,
  /// A destructuring `let`: the parts no binding took are dropped when it binds, and its bindings
  /// stay in the enclosing block (PATT-006).
  Let,
}

/// One match arm; a guard, when present, is tested only after its pattern selects the value.
/// One nested refutable test of an arm: the union value at `path` from the subject must hold the
/// member or variant `tag` of its `tags` alternatives.
pub struct PatternTest {
  pub path: Vector<PlaceStep>
  pub tag: usize
  pub tags: usize
  /// Present for structural unions; nominal variants keep their declaration-order tags.
  pub source: Option<Shared<Type>>
}

pub struct MatchArm {
  pub origin: Origin
  pub pattern: Pattern
  /// Nested tests in preorder; the arm is selected only when every one holds.
  pub tests: Vector<PatternTest>
  pub guard: Option<NodeId>
  pub result: NodeId
  /// The `PatternBinding` nodes that declare this arm's bindings, in pattern order. No expression
  /// references them, so a binding that is never used is still declared (MATCH-002).
  pub bindings: Vector<NodeId>
}

/// A written aggregate operand and its canonical destination field.
pub struct AggregateField {
  pub index: usize
  pub value: NodeId
}

/// One typed expression or control-flow node in a checked body.
pub union NodeKind {
  /// An expression with its resolved semantic type.
  Expression {
    /// The checked semantic type.
    pub ty: Shared<Type>,
    /// The accepted expression form.
    pub form: Expression,
  },
  /// An immutable local and its initializer.
  LocalBinding {
    /// The body-local entry introduced by this statement.
    pub local: LocalId,
    /// The initializing expression.
    pub initializer: NodeId,
  },
  /// A mutable evaluator-local slot and its initial complete value.
  MutableBinding {pub local: LocalId, pub initializer: NodeId},
  /// Replacement of one complete mutable evaluator-local value.
  Assignment {pub local: LocalId, pub value: NodeId},
  /// Replacement through a checked mutable projected place.
  PlaceAssignment {pub target: NodeId, pub value: NodeId},
  /// An explicit return, with no value for unit return.
  Return {
    /// The returned expression, or absence for unit return.
    pub value: Option<NodeId>,
  },
  /// A runtime branch with both arms retained in source order.
  Branch {
    /// The checked Boolean condition.
    pub condition: NodeId,
    /// The arm executed when the condition is true.
    pub thenBranch: NodeId,
    /// The arm executed when the condition is false, if written.
    pub elseBranch: Option<NodeId>,
    /// Whether at least one runtime arm can continue after the branch.
    pub canComplete: bool,
  },
  /// A static loop with a checked Boolean condition and body.
  While {pub condition: NodeId, pub body: NodeId},
  /// Exit the nearest static loop.
  Break,
  /// Restart the nearest static loop.
  Continue,
  /// `fail value` exits through the enclosing failure channel after ordinary cleanup (FAIL-002).
  /// The value already has the body's failure type.
  Fail {pub value: NodeId},
  /// `drop value` ends the operand's ownership and cleans its live remainder here (DROP-001).
  Drop {
    /// The typed operand, evaluated before its cleanup.
    pub value: NodeId,
    /// The place whose ownership ends, or absence for an owned rvalue operand.
    pub consumed: Option<ConsumedPlace>,
  },
  /// A sequence of statements in source order.
  Block {
    /// The statements in source order.
    pub statements: Vector<NodeId>,
    /// Whether a reachable path can continue after the block.
    pub canComplete: bool,
  },
}

/// A typed node and its exact source position.
pub struct Node {
  /// The syntax node and byte span in the body source.
  pub origin: Origin
  /// The typed expression or statement form.
  pub kind: NodeKind
}

/// A canonical function signature required to type this body.
pub struct SignatureDependency {
  /// The declaration whose written signature was demanded.
  pub declaration: DeclarationId
}

/// Safety work retained after typing a body against its written contract.
pub union SafetyObligation {
  /// Symbolic owned contents were captured for finite body use. This local requirement is
  /// retained for borrow checking and is never a declared outlives premise.
  Contents {pub origin: Origin, pub subject: Shared<Type>, pub region: Shared<Lifetime>},
  /// A non-scalar value was introduced, read, or forwarded; ownership and cleanup remain open.
  WholeValue {
    /// The source place that must be checked in the later safety stage.
    pub origin: Origin,
    /// The exact type at that place, including any declaration-owned symbolic parameters.
    pub ty: Shared<Type>,
  },
  /// A written-signature or interface call was typed; argument ownership and lifetimes remain open.
  Invocation {
    /// The call that must be checked in the later safety stage.
    pub origin: Origin,
    /// The called declaration or interface operation, without requiring its body to type this call.
    pub declaration: DeclarationId,
  },
  /// A delayed invocation retains its exact callable contract and receiver place.
  CallableInvocation {pub origin: Origin, pub callee: NodeId, pub contract: Shared<Type>},
  /// A receiver pass needs place, move, and loan validation at the later safety stage.
  ReceiverPass {
    /// The receiver-call source site.
    pub origin: Origin,
    /// The selected receiver operand, evaluated once in the typed call.
    pub receiver: NodeId,
    /// The pass mode from the selected member contract.
    pub mode: ReceiverPass,
  },
}

/// Native borrow checking has not run for any ordinary or selected body. Type and ownership
/// checking never upgrade this status; only the native borrow stage may.
pub enum BorrowStatus {
  NotChecked,
}

/// The guarantee carried by a successful body demand.
pub union Stage {
  /// Existing scalar body checking has discharged the supported safety claims.
  FullyChecked,
  /// The body was typed against its written signature and declared bounds only.
  /// Ownership, lifetime, cleanup, and Effect execution safety are not discharged.
  ContractTyped {
    /// Specific source places retained for the later safety stage.
    pub obligations: Vector<SafetyObligation>,
  },
}

/// Owned header inputs for specializing one checked interface call.
pub struct InterfaceCallInputs {
  pub contract: Shared<Type>
  pub provider: Shared<Type>
  pub operation: Shared<DeclarationId>
  pub bindings: Shared<Vector<Binding>>
  pub origin: Origin
  pub result: Shared<Type>
  pub count: usize
}

/// Inputs retained for direct invocation of one exact callable environment.
pub struct CallableCallInputs {
  pub receiver: Shared<Type>
  pub inference: Shared<DeclarationId>
  pub bindings: Shared<Vector<Binding>>
  pub mode: CallableMode
  pub callee: NodeId
  pub result: Shared<Type>
  pub count: usize
  pub origin: Origin
}

/// One sealed intrinsic call: its member, checked result type and origin.
pub struct IntrinsicCallInputs {
  pub member: Member
  pub result: Shared<Type>
  pub origin: Origin
}

/// A stored Effect value run by one `run` node: its exact type, success type and operand node.
pub struct RunOperand {
  pub receiver: Shared<Type>
  pub result: Shared<Type>
  pub callee: NodeId
  pub origin: Origin
}

/// One already checked argument, retained without extending its body borrow.
pub struct CallArgument {
  pub ty: Shared<Type>
  pub origin: Origin
}

struct InterfaceOperation {
  node: NodeId
  declaration: Shared<DeclarationId>
}

/// A typed body and the evidence needed by later consumers.
///
/// # Details
///
/// The source observation returned beside this payload owns every `HirId` in the nodes. A payload
/// can be kept across an edit only when its declaration bytes, syntax positions, and dependencies
/// validate. Required bodies name runtime callees that a later program build must close.
/// One static result a selection pass fixed for a selected body, beyond its embedded values.
pub union SelectedFact {
  /// The arm a static conditional selected.
  Decision {pub condition: HirId, pub selected: bool},
  /// The value a `let static` binding holds; it has no runtime lane.
  Binding {pub binder: HirId, pub value: Shared<StaticData>},
  /// The static argument values one call supplies at its callee's original parameter indices.
  Arguments {pub call: HirId, pub slots: Shared<Vector<StaticSlot>>},
}

/// A lexical local represented by one environment field in an anonymous function.
pub struct EnvironmentCapture {
  pub local: LocalId
  pub field: usize
  /// Borrowed captures address the referent stored in the field.
  pub dereference: bool
}

impl Copy for EnvironmentCapture {}

/// The exact environment parameter and lexical aliases of one anonymous function.
pub struct Environment {
  pub ty: Shared<Type>
  pub outerCount: usize
  pub captures: Vector<EnvironmentCapture>
}

pub struct TypedBody {
  /// The canonical function declaration that owns this body.
  declaration: DeclarationId
  environment: Option<Environment>
  input: Shared<BodyInput>
  /// Parameters and bindings in the order they become available.
  locals: Vector<Local>
  /// The typed nodes, referenced by indices local to this body.
  nodes: Vector<Node>
  /// The checked block or reached expression that roots this payload.
  root: NodeId
  /// The written signatures demanded during body checking.
  dependencies: Vector<SignatureDependency>
  /// The canonical callees whose runtime bodies remain required.
  foreignDeclarations: Vector<Shared<DeclarationId>>
  requiredBodies: Vector<DeclarationId>
  interfaceOperations: Vector<InterfaceOperation>
  stage: Stage
  /// The selection pass's decisions and static bindings; empty for an unselected body.
  selection: Vector<SelectedFact>
}

fn inputAddress(input: &BodyInput) -> usize {
  return Pointer.address<BodyInput>(Pointer.fromRef<BodyInput>(input))
}

fn sameInput(previous: &BodyInput, input: &Shared<BodyInput>) -> bool {
  return Shared.with<BodyInput, bool>(input, fn(current: &BodyInput) -> bool {
    return BodyInput.equals(previous, current)
  })
}

fn callArgumentNode(arguments: &Vector<NodeId>, at: usize) -> Option<NodeId> {
  let nodes = Vector.asSlice<NodeId>(arguments)
  if at < nodes.length { return Option.some<NodeId>(nodes[at]) }
  return Option.none<NodeId>()
}

impl TypedBody {
  /// Finishes an anonymous body with environment field places before publishing it.
  /// Capture metadata retains the original lexical binding indices and first-use order.
  pub effect fn materializeEnvironment(self: Self, environment: Environment) -> Option<Self>
  ! OutOfMemoryError ? &mut Allocator {
    let mut checked = move self
    checked.environment = Option.some<Environment>(move environment)
    return run environmentBody(&checked)
  }
  /// The environment parameter for an anonymous body, absent for a named function.
  pub fn environmentOf(self: &Self) -> &Option<Environment> {
    return &self.environment
  }

  /// Retains a checked direct call's complete application under a short body borrow.
  pub fn directApplication(self: &Shared<Self>, node: NodeId) -> Option<Shared<Application>> {
    return Shared.with<TypedBody, Option<Shared<Application>>>(self, fn(body: &TypedBody) -> Option<Shared<Application>> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.DirectCall {application, ..}, ..} = &nodes[node.index].kind {
          return Option.some<Shared<Application>>(Shared.clone<Application>(&application))
        }
      }
      return Option.none<Shared<Application>>()
    })
  }

  /// Retains a callable's checked environment and invocation substitutions.
  pub fn callableCall(self: &Shared<Self>, node: NodeId) -> Option<CallableCallInputs> {
    return Shared.with<TypedBody, Option<CallableCallInputs>>(self, fn(body: &TypedBody) -> Option<CallableCallInputs> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.CallableCall {callee, mode, inference, bindings, arguments, ..}, ty} = &nodes[node.index].kind {
          if let NodeKind.Expression {ty: receiver, ..} = &nodes[callee.index].kind {
            return Option.some<CallableCallInputs>(CallableCallInputs {
              receiver: Shared.clone<Type>(&receiver), inference: Shared.clone<DeclarationId>(&inference),
              bindings: Shared.clone<Vector<Binding>>(&bindings), mode: mode, callee: callee,
              result: Shared.clone<Type>(&ty), count: Vector.length<NodeId>(&arguments), origin: nodes[node.index].origin,
            })
          }
        }
      }
      return Option.none<CallableCallInputs>()
    })
  }

  /// The sealed member a call node selects, and the call's checked result type.
  pub fn intrinsicCall(self: &Shared<Self>, node: NodeId) -> Option<IntrinsicCallInputs> {
    return Shared.with<TypedBody, Option<IntrinsicCallInputs>>(self, fn(body: &TypedBody) -> Option<IntrinsicCallInputs> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.IntrinsicCall {member, ..}, ty} = &nodes[node.index].kind {
          return Option.some<IntrinsicCallInputs>(IntrinsicCallInputs {member: member, result: Shared.clone<Type>(&ty),
            origin: nodes[node.index].origin})
        }
      }
      return Option.none<IntrinsicCallInputs>()
    })
  }

  /// The operand of a `run` of a stored Effect value. An immediate `effect fn` construction has
  /// its own direct call target instead.
  pub fn runOperand(self: &Shared<Self>, node: NodeId) -> Option<RunOperand> {
    return Shared.with<TypedBody, Option<RunOperand>>(self, fn(body: &TypedBody) -> Option<RunOperand> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.Run {value, immediate}, ty} = &nodes[node.index].kind {
          if !immediate {
            if let NodeKind.Expression {ty: receiver, ..} = &nodes[value.index].kind {
              return Option.some<RunOperand>(RunOperand {receiver: Shared.clone<Type>(&receiver),
                result: Shared.clone<Type>(&ty), callee: value, origin: nodes[node.index].origin})
            }
          }
        }
      }
      return Option.none<RunOperand>()
    })
  }

  /// Whether this `run` node is one immediate call rather than a stored Effect's runner.
  pub fn immediateRun(self: &Shared<Self>, node: NodeId) -> bool {
    return Shared.with<TypedBody, bool>(self, fn(body: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.Run {immediate, ..}, ..} = &nodes[node.index].kind { return immediate }
      }
      return false
    })
  }

  /// Retains interface header inputs under a short body borrow; no target body is selected here.
  pub fn interfaceCall(self: &Shared<Self>, node: NodeId) -> Option<InterfaceCallInputs> {
    return Shared.with<TypedBody, Option<InterfaceCallInputs>>(self, fn(body: &TypedBody) -> Option<InterfaceCallInputs> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.InterfaceCall {contract, provider, bindings, arguments, ..}, ty} = &nodes[node.index].kind {
          let operations = Vector.asSlice<InterfaceOperation>(&body.interfaceOperations)
          let mut at = usize.ZERO
          while at < operations.length {
            if operations[at].node.index == node.index {
              return Option.some<InterfaceCallInputs>(InterfaceCallInputs {
                contract: Shared.clone<Type>(&contract), provider: Shared.clone<Type>(&provider),
                operation: Shared.clone<DeclarationId>(&operations[at].declaration), bindings: Shared.clone<Vector<Binding>>(&bindings), origin: nodes[node.index].origin, result: Shared.clone<Type>(&ty), count: Vector.length<NodeId>(&arguments),
              })
            }
            at = at + usize.ONE
          }
        }
      }
      return Option.none<InterfaceCallInputs>()
    })
  }

  /// Retains the checked type and source origin of one written call argument.
  pub fn callArgument(self: &Shared<Self>, node: NodeId, at: usize) -> Option<CallArgument> {
    return Shared.with<TypedBody, Option<CallArgument>>(self, fn(body: &TypedBody) -> Option<CallArgument> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form, ..} = &nodes[node.index].kind {
          let selected = match &form {
            Expression.DirectCall {arguments, ..} => callArgumentNode(&arguments, at)
            Expression.CallableCall {arguments, ..} => callArgumentNode(&arguments, at)
            Expression.InterfaceCall {arguments, ..} => callArgumentNode(&arguments, at)
            Expression.IntrinsicCall {arguments, ..} => callArgumentNode(&arguments, at)
            _ => Option.none<NodeId>()
          }
          if let Option<NodeId>.Some {value: argument} = move selected {
            if let NodeKind.Expression {ty, ..} = &nodes[argument.index].kind {
              return Option.some<CallArgument>(CallArgument {ty: Shared.clone<Type>(&ty), origin: nodes[argument.index].origin})
            }
          }
        }
      }
      return Option.none<CallArgument>()
    })
  }

  /// The node that declares binding `binding`, in pattern order, of arm `arm` of the match at `node`.
  pub fn armBinding(self: &Shared<Self>, node: NodeId, arm: usize, binding: usize) -> Option<NodeId> {
    return Shared.with<TypedBody, Option<NodeId>>(self, fn(body: &TypedBody) -> Option<NodeId> {
      let nodes = TypedBody.nodeSlice(body)
      if node.index < nodes.length {
        if let NodeKind.Expression {form: Expression.Match {arms, ..}, ..} = &nodes[node.index].kind {
          let written = Vector.asSlice<MatchArm>(&arms)
          if arm < written.length {
            let declared = Vector.asSlice<NodeId>(&written[arm].bindings)
            if binding < declared.length { return Option.some<NodeId>(declared[binding]) }
          }
        }
      }
      return Option.none<NodeId>()
    })
  }

  /// Creates a typed body with shared declaration inputs and owned checked nodes.
  ///
  /// # Gotchas
  ///
  /// `input` must describe `declaration` under the same source observation.
  pub effect fn make(
    declaration: &DeclarationId,
    input: Shared<BodyInput>,
    locals: Vector<Local>,
    nodes: Vector<Node>,
    root: NodeId,
    dependencies: Vector<SignatureDependency>,
    requiredBodies: Vector<DeclarationId>,
    stage: Stage,
    selection: Vector<SelectedFact>,
  ) -> TypedBody ! OutOfMemoryError ? &mut Allocator {
    let mut foreignHandles = Vector.make<Shared<DeclarationId>>()
    let mut operations = Vector.make<InterfaceOperation>()
    let checked = Vector.asSlice<Node>(&nodes)
    let mut at = usize.ZERO
    while at < checked.length {
      if let NodeKind.Expression {form: Expression.ForeignCall {declaration: foreignDeclaration, ..}, ..} = &checked[at].kind {
        run Vector.append<Shared<DeclarationId>>(
          &mut foreignHandles,
          run Shared.make<DeclarationId>(run DeclarationId.copy(&foreignDeclaration)),
        )
      }
      if let NodeKind.Expression {form: Expression.InterfaceCall {operation, ..}, ..} = &checked[at].kind {
        run Vector.append<InterfaceOperation>(&mut operations, InterfaceOperation {
          node: NodeId {index: at}, declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&operation)),
        })
      }
      at = at + usize.ONE
    }
    return TypedBody {
      environment: Option.none<Environment>(),
      foreignDeclarations: move foreignHandles,
      declaration: run DeclarationId.copy(declaration),
      input: move input,
      locals: move locals,
      nodes: move nodes,
      root: root,
      dependencies: move dependencies,
      requiredBodies: move requiredBodies,
      interfaceOperations: move operations,
      stage: move stage,
      selection: move selection,
    }
  }
  /// The selection pass's decisions and static bindings, in selection order.
  pub fn selectedFacts(self: &Self) -> &[SelectedFact] {
    return Vector.asSlice<SelectedFact>(&self.selection)
  }
  /// Checks exact shared declaration inputs, including source bytes and syntax positions.
  pub fn matchesInput(self: &Self, input: &Shared<BodyInput>) -> bool {
    // Equal immutable owners need no second shared borrow, including across retained revisions.
    if Shared.with<BodyInput, usize>(&self.input, inputAddress) == Shared.with<BodyInput, usize>(input, inputAddress) {
      return Shared.with<BodyInput, bool>(input, BodyInput.isStable)
    }
    return Shared.with<BodyInput, bool>(&self.input, fn(previous: &BodyInput) -> bool {
      return sameInput(previous, input)
    })
  }
  /// Borrows the canonical declaration that owns this checked body.
  pub fn declarationId(self: &Self) -> &DeclarationId {
    return &self.declaration
  }
  /// Borrows the entries addressed by this body's `LocalId` values.
  pub fn localSlice(self: &Self) -> &[Local] {
    return Vector.asSlice<Local>(&self.locals)
  }
  /// Borrows the checked nodes in this body.
  pub fn nodeSlice(self: &Self) -> &[Node] {
    return Vector.asSlice<Node>(&self.nodes)
  }
  /// Returns the index of the checked block or reached expression.
  pub fn rootNode(self: &Self) -> NodeId {
    return self.root
  }
  /// Borrows the canonical signatures demanded while checking this body.
  pub fn signatureDependencies(self: &Self) -> &[SignatureDependency] {
    return Vector.asSlice<SignatureDependency>(&self.dependencies)
  }
  /// Borrows the canonical callees whose runtime bodies remain required.
  pub fn runtimeBodies(self: &Self) -> &[DeclarationId] {
    return Vector.asSlice<DeclarationId>(&self.requiredBodies)
  }
  /// Borrows the identity handles of immediate foreign calls.
  pub fn foreignHandles(self: &Self) -> &[Shared<DeclarationId>] {
    return Vector.asSlice<Shared<DeclarationId>>(&self.foreignDeclarations)
  }
  /// Borrows the exact guarantee of this body result.
  pub fn checkingStage(self: &Self) -> &Stage {
    return &self.stage
  }
  /// This body's borrow-checking status.
  pub fn borrowStatus(self: &Self) -> BorrowStatus {
    return BorrowStatus.NotChecked
  }
}

struct EnvironmentMap<'a, 'b> {
  outer: usize
  offset: usize
  base: NodeId
  fields: &'a [EnvironmentCapture]
  places: &'b [NodeId]
}

fn environmentAlias<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, local: LocalId) -> usize {
  let mut at = usize.ZERO
  while at < mapping.fields.length {
    if mapping.fields[at].local.index == local.index { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn environmentNode<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, node: NodeId) -> NodeId {
  return NodeId {index: node.index + mapping.offset}
}

fn environmentLocal<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, local: LocalId) -> LocalId {
  return LocalId {index: local.index - mapping.outer + usize.ONE}
}

fn environmentOptionalNode<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, node: &Option<NodeId>) -> Option<NodeId> {
  return match &node.* {
    Option<NodeId>.Some {value} => Option.some<NodeId>(environmentNode(mapping, value))
    Option<NodeId>.None => Option.none<NodeId>()
  }
}

effect fn environmentNodes<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, nodes: &[NodeId]) -> Vector<NodeId> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<NodeId>()
  let mut at = usize.ZERO
  while at < nodes.length {
    run Vector.append<NodeId>(&mut copied, environmentNode(mapping, nodes[at]))
    at = at + usize.ONE
  }
  return move copied
}

effect fn environmentFields<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, fields: &[AggregateField]) -> Vector<AggregateField>
! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<AggregateField>()
  let mut at = usize.ZERO
  while at < fields.length {
    run Vector.append<AggregateField>(&mut copied, AggregateField {index: fields[at].index, value: environmentNode(mapping, fields[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

effect fn environmentSteps(steps: &[PlaceStep]) -> Vector<PlaceStep> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<PlaceStep>()
  let mut at = usize.ZERO
  while at < steps.length {
    let step = match &steps[at] {
      PlaceStep.Field {index} => PlaceStep.Field {index: index}
      PlaceStep.Element {index} => PlaceStep.Element {index: index}
      PlaceStep.Member {tag, ty, source} => PlaceStep.Member {tag: tag, ty: Shared.clone<Type>(&ty), source: Shared.clone<Type>(&source)}
      PlaceStep.VariantField {tag, field} => PlaceStep.VariantField {tag: tag, field: field}
    }
    run Vector.append<PlaceStep>(&mut copied, move step)
    at = at + usize.ONE
  }
  return move copied
}

effect fn environmentConsumed<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, consumed: &Option<ConsumedPlace>) -> Option<ConsumedPlace>
! OutOfMemoryError ? &mut Allocator {
  if let Option<ConsumedPlace>.Some {value} = &consumed.* {
    let mut steps = Vector.make<PlaceStep>()
    let mut root = PlaceRoot.Local {local: LocalId {index: usize.ZERO}}
    match &value.root {
      PlaceRoot.Local {local} => {
        if local.index < mapping.outer {
          let alias = environmentAlias(mapping, local)
          run Vector.append<PlaceStep>(&mut steps, PlaceStep.Field {index: mapping.fields[alias].field})
        } else { root = PlaceRoot.Local {local: environmentLocal(mapping, local)} }
      }
      PlaceRoot.Subject {subject} => { root = PlaceRoot.Subject {subject: environmentNode(mapping, subject)} }
    }
    let mut rest = run environmentSteps(Vector.asSlice<PlaceStep>(&value.steps))
    while Vector.length<PlaceStep>(&rest) > usize.ZERO {
      let step = Vector.remove<PlaceStep>(&mut rest, usize.ZERO)
      run Vector.append<PlaceStep>(&mut steps, move step)
    }
    return Option.some<ConsumedPlace>(ConsumedPlace {root: move root, steps: move steps})
  }
  return Option.none<ConsumedPlace>()
}

effect fn environmentPattern(pattern: &Pattern) -> Pattern ! OutOfMemoryError ? &mut Allocator {
  return match &pattern.* {
    Pattern.Universal => Pattern.Universal
    Pattern.EnumMember {member} => Pattern.EnumMember {member: member}
    Pattern.Variant {tag} => Pattern.Variant {tag: tag}
    Pattern.Integer {magnitude, negative} => Pattern.Integer {magnitude: magnitude, negative: negative}
    Pattern.Record {member} => {
      let mut copied = Option.none<UnionMember>()
      if let Option<UnionMember>.Some {value} = &member {
        copied = Option.some<UnionMember>(UnionMember {tag: value.tag, ty: Shared.clone<Type>(&value.ty), source: Shared.clone<Type>(&value.source)})
      }
      return Pattern.Record {member: move copied}
    }
  }
}

effect fn environmentArms<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, arms: &[MatchArm]) -> Vector<MatchArm>
! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<MatchArm>()
  let mut at = usize.ZERO
  while at < arms.length {
    let mut tests = Vector.make<PatternTest>()
    let written = Vector.asSlice<PatternTest>(&arms[at].tests)
    let mut testAt = usize.ZERO
    while testAt < written.length {
      run Vector.append<PatternTest>(&mut tests, PatternTest {path: run environmentSteps(Vector.asSlice<PlaceStep>(&written[testAt].path)),
        tag: written[testAt].tag, tags: written[testAt].tags, source: copyOptionalType(&written[testAt].source)})
      testAt = testAt + usize.ONE
    }
    run Vector.append<MatchArm>(&mut copied, MatchArm {origin: arms[at].origin, pattern: run environmentPattern(&arms[at].pattern),
      tests: move tests, guard: environmentOptionalNode(mapping, &arms[at].guard), result: environmentNode(mapping, arms[at].result),
      bindings: run environmentNodes(mapping, Vector.asSlice<NodeId>(&arms[at].bindings))})
    at = at + usize.ONE
  }
  return move copied
}

effect fn environmentExpression<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, form: &Expression) -> Expression ! OutOfMemoryError ? &mut Allocator {
  return match &form.* {
    Expression.Integer {literal} => Expression.Integer {literal: literal}
    Expression.Float {literal} => Expression.Float {literal: literal}
    Expression.Text {literal} => Expression.Text {literal: literal}
    Expression.Boolean {value} => Expression.Boolean {value: value}
    Expression.Unit => Expression.Unit
    Expression.Local {local} => {
      if local.index < mapping.outer {
        let alias = environmentAlias(mapping, local)
        if mapping.fields[alias].dereference {
          return Expression.Dereference {value: NodeId {index: mapping.places[alias].index - usize.ONE}}
        } else { return Expression.Field {value: mapping.base, index: mapping.fields[alias].field} }
      } else { return Expression.Local {local: environmentLocal(mapping, local)} }
    }
    Expression.Borrow {access, value} => Expression.Borrow {access: access, value: environmentNode(mapping, value)}
    Expression.PointerWeaken {value} => Expression.PointerWeaken {value: environmentNode(mapping, value)}
    Expression.Dereference {value} => Expression.Dereference {value: environmentNode(mapping, value)}
    Expression.Field {value, index} => Expression.Field {value: environmentNode(mapping, value), index: index}
    Expression.ArraySlice {value, count} => Expression.ArraySlice {value: environmentNode(mapping, value), count: count}
    Expression.SliceLength {value} => Expression.SliceLength {value: environmentNode(mapping, value)}
    Expression.Index {value, index} => Expression.Index {value: environmentNode(mapping, value), index: environmentNode(mapping, index)}
    Expression.ArrayLength {value, count} => Expression.ArrayLength {value: environmentNode(mapping, value), count: count}
    Expression.Aggregate {fields} => Expression.Aggregate {fields: run environmentFields(mapping, Vector.asSlice<AggregateField>(&fields))}
    Expression.Callable {fields, body} => Expression.Callable {fields: run environmentFields(mapping, Vector.asSlice<AggregateField>(&fields)), body: Shared.clone<TypedBody>(&body)}
    Expression.StagedCallable {callee, mode, arguments} => Expression.StagedCallable {
      callee: environmentNode(mapping, callee), mode: mode,
      arguments: run environmentNodes(mapping, Vector.asSlice<NodeId>(&arguments)),
    }
    Expression.Constant {declaration} => Expression.Constant {declaration: Shared.clone<DeclarationId>(&declaration)}
    Expression.EnumMember {member} => Expression.EnumMember {member: member}
    Expression.EnumValue {value} => Expression.EnumValue {value: environmentNode(mapping, value)}
    Expression.UnionInject {tag, value} => Expression.UnionInject {tag: tag, value: environmentNode(mapping, value)}
    Expression.VariantConstruct {tag, fields} => Expression.VariantConstruct {tag: tag, fields: run environmentFields(mapping, Vector.asSlice<AggregateField>(&fields))}
    Expression.PatternBinding {subject, path, access} => Expression.PatternBinding {subject: environmentNode(mapping, subject), path: run environmentSteps(Vector.asSlice<PlaceStep>(&path)), access: access}
    Expression.Match {subject, access, tags, domain, arms, syntax} => {
      let selected = match &access {
        SubjectAccess.Copy => SubjectAccess.Copy
        SubjectAccess.Place {access: selected} => SubjectAccess.Place {access: selected}
        SubjectAccess.Consume {consumed} => SubjectAccess.Consume {consumed: run environmentConsumed(mapping, &consumed)}
      }
      return Expression.Match {subject: environmentNode(mapping, subject), access: move selected, tags: tags, domain: domain,
        arms: run environmentArms(mapping, Vector.asSlice<MatchArm>(&arms)), syntax: syntax}
    }
    Expression.CompileError {message} => Expression.CompileError {message: environmentNode(mapping, message)}
    Expression.Embedded {value} => Expression.Embedded {value: Shared.clone<StaticData>(&value)}
    Expression.Move {value, consumed} => Expression.Move {value: environmentNode(mapping, value), consumed: run environmentConsumed(mapping, &consumed)}
    Expression.CallableCall {callee, mode, arguments, inference, bindings, pipeline} => Expression.CallableCall {
      callee: environmentNode(mapping, callee), mode: mode, arguments: run environmentNodes(mapping, Vector.asSlice<NodeId>(&arguments)),
      inference: Shared.clone<DeclarationId>(&inference), bindings: Shared.clone<Vector<Binding>>(&bindings), pipeline: pipeline,
    }
    Expression.DirectCall {declaration, application, receiverPass, arguments} => Expression.DirectCall {
      declaration: run DeclarationId.copy(&declaration), application: Shared.clone<Application>(&application),
      receiverPass: environmentReceiver(&receiverPass), arguments: run environmentNodes(mapping, Vector.asSlice<NodeId>(&arguments)),
    }
    Expression.ForeignCall {declaration, arguments} => Expression.ForeignCall {declaration: run DeclarationId.copy(&declaration), arguments: run environmentNodes(mapping, Vector.asSlice<NodeId>(&arguments))}
    Expression.Run {value, immediate} => Expression.Run {value: environmentNode(mapping, value), immediate: immediate}
    Expression.IntrinsicCall {member, arguments} => Expression.IntrinsicCall {member: member, arguments: run environmentNodes(mapping, Vector.asSlice<NodeId>(&arguments))}
    Expression.ConcretePrefix {operator, operand} => Expression.ConcretePrefix {operator: operator, operand: environmentNode(mapping, operand)}
    Expression.ConcreteInfix {operator, left, right} => Expression.ConcreteInfix {operator: operator, left: environmentNode(mapping, left), right: environmentNode(mapping, right)}
    Expression.InterfaceCall {contract, provider, operation, bindings, implementation, receiverPass, arguments} => {
      let mut selected = Option.none<Shared<DeclarationId>>()
      if let Option<Shared<DeclarationId>>.Some {value} = &implementation { selected = Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&value)) }
      return Expression.InterfaceCall {contract: Shared.clone<Type>(&contract), provider: Shared.clone<Type>(&provider), operation: run DeclarationId.copy(&operation),
        bindings: Shared.clone<Vector<Binding>>(&bindings), implementation: move selected, receiverPass: environmentReceiver(&receiverPass),
        arguments: run environmentNodes(mapping, Vector.asSlice<NodeId>(&arguments))}
    }
  }
}

fn environmentReceiver(pass: &Option<ReceiverPass>) -> Option<ReceiverPass> {
  return match &pass.* {
    Option<ReceiverPass>.Some {value} => Option.some<ReceiverPass>(value)
    Option<ReceiverPass>.None => Option.none<ReceiverPass>()
  }
}

effect fn environmentKind<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, kind: &NodeKind) -> NodeKind ! OutOfMemoryError ? &mut Allocator {
  return match &kind.* {
    NodeKind.Expression {ty, form} => NodeKind.Expression {ty: Shared.clone<Type>(&ty), form: run environmentExpression(mapping, &form)}
    NodeKind.LocalBinding {local, initializer} => NodeKind.LocalBinding {local: environmentLocal(mapping, local), initializer: environmentNode(mapping, initializer)}
    NodeKind.MutableBinding {local, initializer} => NodeKind.MutableBinding {local: environmentLocal(mapping, local), initializer: environmentNode(mapping, initializer)}
    NodeKind.Assignment {local, value} => {
      if local.index < mapping.outer { return NodeKind.PlaceAssignment {target: mapping.places[environmentAlias(mapping, local)], value: environmentNode(mapping, value)} }
      else { return NodeKind.Assignment {local: environmentLocal(mapping, local), value: environmentNode(mapping, value)} }
    }
    NodeKind.PlaceAssignment {target, value} => NodeKind.PlaceAssignment {target: environmentNode(mapping, target), value: environmentNode(mapping, value)}
    NodeKind.Return {value} => NodeKind.Return {value: environmentOptionalNode(mapping, &value)}
    NodeKind.Branch {condition, thenBranch, elseBranch, canComplete} => NodeKind.Branch {condition: environmentNode(mapping, condition), thenBranch: environmentNode(mapping, thenBranch), elseBranch: environmentOptionalNode(mapping, &elseBranch), canComplete: canComplete}
    NodeKind.While {condition, body} => NodeKind.While {condition: environmentNode(mapping, condition), body: environmentNode(mapping, body)}
    NodeKind.Break => NodeKind.Break
    NodeKind.Continue => NodeKind.Continue
    NodeKind.Fail {value} => NodeKind.Fail {value: environmentNode(mapping, value)}
    NodeKind.Drop {value, consumed} => NodeKind.Drop {value: environmentNode(mapping, value), consumed: run environmentConsumed(mapping, &consumed)}
    NodeKind.Block {statements, canComplete} => NodeKind.Block {statements: run environmentNodes(mapping, Vector.asSlice<NodeId>(&statements)), canComplete: canComplete}
  }
}

effect fn environmentObligation<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, obligation: &SafetyObligation) -> SafetyObligation
! OutOfMemoryError ? &mut Allocator {
  return match &obligation.* {
    SafetyObligation.Contents {origin, subject, region} => SafetyObligation.Contents {
      origin: origin, subject: Shared.clone<Type>(&subject), region: Shared.clone<Lifetime>(&region),
    }
    SafetyObligation.WholeValue {origin, ty} => SafetyObligation.WholeValue {origin: origin, ty: Shared.clone<Type>(&ty)}
    SafetyObligation.Invocation {origin, declaration} => SafetyObligation.Invocation {origin: origin, declaration: run DeclarationId.copy(&declaration)}
    SafetyObligation.CallableInvocation {origin, callee, contract} => SafetyObligation.CallableInvocation {
      origin: origin, callee: environmentNode(mapping, callee), contract: Shared.clone<Type>(&contract),
    }
    SafetyObligation.ReceiverPass {origin, receiver, mode} => SafetyObligation.ReceiverPass {origin: origin, receiver: environmentNode(mapping, receiver), mode: mode}
  }
}

effect fn environmentStage<'a, 'b>(mapping: &EnvironmentMap<'a, 'b>, stage: &Stage) -> Stage ! OutOfMemoryError ? &mut Allocator {
  if let Stage.ContractTyped {obligations} = &stage.* {
    let mut copied = Vector.make<SafetyObligation>()
    let listed = Vector.asSlice<SafetyObligation>(&obligations)
    let mut at = usize.ZERO
    while at < listed.length {
      let obligation = run environmentObligation(mapping, &listed[at])
      run Vector.append<SafetyObligation>(&mut copied, move obligation)
      at = at + usize.ONE
    }
    return Stage.ContractTyped {obligations: move copied}
  }
  return Stage.FullyChecked
}

fn callableMode(value: &Type) -> CallableMode {
  return match &value.* { Type.Callable {mode, ..} => mode Type.Effect {mode, ..} => mode _ => CallableMode.Once }
}

fn environmentMode(value: &Type) -> CallableMode {
  return match &value.* {
    Type.CallableValue {contract, ..} => Shared.with<Type, CallableMode>(&contract, callableMode)
    Type.CallableSchema {schema, ..} => Shared.with<CallableSchema, CallableMode>(&schema,
      fn(selected: &CallableSchema) -> CallableMode { return Shared.with<Type, CallableMode>(&selected.contract, callableMode) })
    _ => CallableMode.Once
  }
}

effect fn environmentBody(body: &TypedBody) -> Option<TypedBody> ! OutOfMemoryError ? &mut Allocator {
  if let Option<Environment>.Some {value} = &body.environment {
    return run environmentPrepared(body, &value)
  }
  return Option.none<TypedBody>()
}

effect fn environmentPrepared(body: &TypedBody, environment: &Environment) -> Option<TypedBody>
! OutOfMemoryError ? &mut Allocator {
  let mode = Shared.with<Type, CallableMode>(&environment.ty, environmentMode)
  let retainedFields = run Type.recordFields(&environment.ty)
  let fieldTypes = match move retainedFields {
    Option<Vector<Shared<Type>>>.Some {value} => value
    Option<Vector<Shared<Type>>>.None => { return Option.none<TypedBody>() }
  }
  let mut parameter = Shared.clone<Type>(&environment.ty)
  if mode != CallableMode.Once {
    parameter = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&environment.ty),
      access: match mode { CallableMode.Mutable => Access.Mutable _ => Access.Shared },
      lifetime: run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&body.declaration), ordinal: usize.MAX})})
  }
  let written = Vector.asSlice<Node>(&body.nodes)
  let origin = written[body.root.index].origin
  let mut nodes = Vector.make<Node>()
  run Vector.append<Node>(&mut nodes, Node {origin: origin, kind: NodeKind.Expression {ty: Shared.clone<Type>(&parameter), form: Expression.Local {local: LocalId {index: usize.ZERO}}}})
  let mut base = NodeId {index: usize.ZERO}
  if mode != CallableMode.Once {
    base = NodeId {index: usize.ONE}
    run Vector.append<Node>(&mut nodes, Node {origin: origin, kind: NodeKind.Expression {ty: Shared.clone<Type>(&environment.ty), form: Expression.Dereference {value: NodeId {index: usize.ZERO}}}})
  }
  let captures = Vector.asSlice<EnvironmentCapture>(&environment.captures)
  let types = Vector.asSlice<Shared<Type>>(&fieldTypes)
  let lexical = Vector.asSlice<Local>(&body.locals)
  let mut places = Vector.make<NodeId>()
  let mut at = usize.ZERO
  while at < captures.length {
    let capture = captures[at]
    let source = &lexical[capture.local.index]
    let sourceOrigin = Origin {syntax: source.origin.syntax, span: source.origin.span}
    let fieldType = Shared.clone<Type>(&types[capture.field])
    let field = NodeId {index: Vector.length<Node>(&nodes)}
    run Vector.append<Node>(&mut nodes, Node {origin: sourceOrigin, kind: NodeKind.Expression {
      ty: move fieldType, form: Expression.Field {value: base, index: capture.field}}})
    let mut place = field
    if capture.dereference {
      let originalType = Shared.clone<Type>(&source.ty)
      place = NodeId {index: Vector.length<Node>(&nodes)}
      run Vector.append<Node>(&mut nodes, Node {origin: sourceOrigin, kind: NodeKind.Expression {
        ty: move originalType, form: Expression.Dereference {value: field}}})
    }
    run Vector.append<NodeId>(&mut places, place)
    at = at + usize.ONE
  }
  let mapping = EnvironmentMap {outer: environment.outerCount, offset: Vector.length<Node>(&nodes), base: base,
    fields: captures, places: Vector.asSlice<NodeId>(&places)}
  // Capture analysis must account for every lexical local referenced by the retained body.
  let mut scan = usize.ZERO
  while scan < written.length {
    let local = match &written[scan].kind {
      NodeKind.Expression {form: Expression.Local {local}, ..} => Option.some<LocalId>(local)
      NodeKind.Assignment {local, ..} => Option.some<LocalId>(local)
      _ => Option.none<LocalId>()
    }
    if let Option<LocalId>.Some {value} = move local {
      if value.index < mapping.outer && environmentAlias(&mapping, value) == usize.MAX { return Option.none<TypedBody>() }
    }
    run Vector.append<Node>(&mut nodes, Node {origin: written[scan].origin, kind: run environmentKind(&mapping, &written[scan].kind)})
    scan = scan + usize.ONE
  }
  let locals = run environmentLocals(body, move parameter, origin, mode, environment.outerCount)
  let mut dependencies = Vector.make<SignatureDependency>()
  let signatures = Vector.asSlice<SignatureDependency>(&body.dependencies)
  let mut depAt = usize.ZERO
  while depAt < signatures.length {
    run Vector.append<SignatureDependency>(&mut dependencies, SignatureDependency {declaration: run DeclarationId.copy(&signatures[depAt].declaration)})
    depAt = depAt + usize.ONE
  }
  let mut required = Vector.make<DeclarationId>()
  let callees = Vector.asSlice<DeclarationId>(&body.requiredBodies)
  let mut calleeAt = usize.ZERO
  while calleeAt < callees.length { run Vector.append<DeclarationId>(&mut required, run DeclarationId.copy(&callees[calleeAt])) calleeAt = calleeAt + usize.ONE }
  let mut selection = Vector.make<SelectedFact>()
  let selected = Vector.asSlice<SelectedFact>(&body.selection)
  let mut selectedAt = usize.ZERO
  while selectedAt < selected.length {
    let fact = match &selected[selectedAt] {
      SelectedFact.Decision {condition, selected: decision} => SelectedFact.Decision {condition: condition, selected: decision}
      SelectedFact.Binding {binder, value} => SelectedFact.Binding {binder: binder, value: Shared.clone<StaticData>(&value)}
      SelectedFact.Arguments {call, slots} => SelectedFact.Arguments {call: call, slots: Shared.clone<Vector<StaticSlot>>(&slots)}
    }
    run Vector.append<SelectedFact>(&mut selection, move fact)
    selectedAt = selectedAt + usize.ONE
  }
  let mut prepared = run TypedBody.make(&body.declaration, Shared.clone<BodyInput>(&body.input), move locals, move nodes,
    environmentNode(&mapping, body.root), move dependencies, move required, run environmentStage(&mapping, &body.stage), move selection)
  let aliases = run environmentAliases(environment)
  prepared.environment = Option.some<Environment>(Environment {ty: Shared.clone<Type>(&environment.ty), outerCount: environment.outerCount, captures: move aliases})
  return Option.some<TypedBody>(move prepared)
}

// Keep this scan apart from capture projection construction: the bootstrap's debug backend
// cannot yet index the same slice spill from two loops in one function (PAPERCUTS.md).
effect fn environmentLocals(body: &TypedBody, parameter: Shared<Type>, origin: Origin,
  mode: CallableMode, outer: usize) -> Vector<Local> ! OutOfMemoryError ? &mut Allocator {
  let mut locals = Vector.make<Local>()
  run Vector.append<Local>(&mut locals, Local {origin: origin, ty: move parameter, mutable: mode == CallableMode.Once})
  let lexical = Vector.asSlice<Local>(&body.locals)
  let mut at = outer
  while at < lexical.length {
    run Vector.append<Local>(&mut locals, Local {origin: lexical[at].origin, ty: Shared.clone<Type>(&lexical[at].ty), mutable: lexical[at].mutable})
    at = at + usize.ONE
  }
  return move locals
}

effect fn environmentAliases(environment: &Environment) -> Vector<EnvironmentCapture>
! OutOfMemoryError ? &mut Allocator {
  let captures = Vector.asSlice<EnvironmentCapture>(&environment.captures)
  let mut aliases = Vector.make<EnvironmentCapture>()
  let mut at = usize.ZERO
  while at < captures.length {
    run Vector.append<EnvironmentCapture>(&mut aliases, captures[at])
    at = at + usize.ONE
  }
  return move aliases
}

fn copyOptionalType(value: &Option<Shared<Type>>) -> Option<Shared<Type>> {
  return match &value.* {
    Option<Shared<Type>>.Some {value: ty} => Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    _ => Option.none<Shared<Type>>()
  }
}
