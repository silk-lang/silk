//! Exact source-evidence verification reused across immutable shards during one adoption.
//!
//! A memo belongs to one selected source revision, request, profile and resolution context.
//! Discard it when adoption succeeds or fails; it is not an authority across later requests.
//! The same selector under different recorded file bytes, token text or position is a distinct
//! proof. Shard-local file ordinals never identify the recorded file.

import semantic.CacheImage
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

struct File { key: Bytes, digest: ContentHash }
struct Entry { key: Bytes, leaf: CacheImage.Leaf, file: usize, placed: usize, positional: bool }

/// Completed leaf checks in one adoption attempt, keyed by their exact recorded evidence.
pub struct Memo { files: List<File>, fileIndex: InternIndex, entries: List<Entry>, index: InternIndex }

/// Creates an empty proof memo for one source and request context.
pub fn make() -> Memo {
  return Memo {files: List<File>.make(), fileIndex: InternIndex.make(), entries: List<Entry>.make(), index: InternIndex.make()}
}

/// The number of distinct recorded-evidence checks completed during this adoption.
pub fn count(memo: &Memo) -> usize { return List<Entry>.length(&memo.entries) }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length { if left[at] != right[at] { return false } at = at + usize.ONE }
  return true
}

fn fileOf(memo: &Memo, key: &[u8], digest: ContentHash) -> usize {
  let mut at = InternIndex.first(&memo.fileIndex, InternIndex.hashBytes(digest.low, key))
  let files = List<File>.asSlice(&memo.files)
  while at != usize.MAX {
    if ContentHash.equals(files[at].digest, digest) && same(Bytes.asSlice(&files[at].key), key) { return at }
    at = InternIndex.after(&memo.fileIndex, at)
  }
  return usize.MAX
}

/// Finds an already completed exact check, or `usize.MAX`. `fileKey` and `fileDigest` describe
/// the leaf's recorded file; they are ignored when the leaf has no file reference.
pub fn find(memo: &Memo, key: &[u8], leaf: &CacheImage.Leaf, fileKey: &[u8], fileDigest: ContentHash) -> usize {
  let file = if leaf.file == usize.MAX { usize.MAX } else { fileOf(memo, fileKey, fileDigest) }
  if leaf.file != usize.MAX && file == usize.MAX { return usize.MAX }
  let mut at = InternIndex.first(&memo.index, InternIndex.hashBytes(leaf.digest.low, key))
  let entries = List<Entry>.asSlice(&memo.entries)
  while at != usize.MAX {
    let entry = &entries[at]
    if entry.file == file && entry.leaf.input == leaf.input && entry.leaf.selector == leaf.selector
      && entry.leaf.position == leaf.position && ContentHash.equals(entry.leaf.digest, leaf.digest)
      && ContentHash.equals(entry.leaf.text, leaf.text) && same(Bytes.asSlice(&entry.key), key) { return at }
    at = InternIndex.after(&memo.index, at)
  }
  return usize.MAX
}

/// Returns the resolver-owned input or module handle, including `usize.MAX` for a failed match.
pub fn placed(memo: &Memo, proof: usize) -> usize { return List<Entry>.asSlice(&memo.entries)[proof].placed }

/// Returns whether this failed match changes positions alone, preserving semantic content.
pub fn positional(memo: &Memo, proof: usize) -> bool { return List<Entry>.asSlice(&memo.entries)[proof].positional }

/// Records a completed verification. On allocation failure discard the adoption attempt and its
/// memo; a partial index is never reused. File identities are interned independently of leaf keys.
pub effect fn remember(memo: &mut Memo, key: &[u8], leaf: &CacheImage.Leaf, fileKey: &[u8], fileDigest: ContentHash,
  placed: usize, positional: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if find(&memo.*, key, leaf, fileKey, fileDigest) != usize.MAX { return () }
  let mut file = usize.MAX
  if leaf.file != usize.MAX {
    file = fileOf(&memo.*, fileKey, fileDigest)
    if file == usize.MAX {
      file = List<File>.length(&memo.files)
      run List<File>.append(&mut memo.files, File {key: run Bytes.copy(fileKey), digest: fileDigest})
      run InternIndex.record(&mut memo.fileIndex, InternIndex.hashBytes(fileDigest.low, fileKey))
    }
  }
  run List<Entry>.append(&mut memo.entries, Entry {key: run Bytes.copy(key), leaf: leaf.*, file: file,
    placed: placed, positional: positional})
  run InternIndex.record(&mut memo.index, InternIndex.hashBytes(leaf.digest.low, key))
}

import silk.testing.testing {Testing, AssertionError}
import silk.core.effect {Effect}

effect fn proofClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut image = CacheImage.make()
  let digest = ContentHash {high: 1, low: 2}
  let fileDigest = ContentHash {high: 3, low: 4}
  drop run CacheImage.addLeaf(&mut image, false, run Bytes.copy(b"file"), fileDigest, usize.MAX, usize.MAX,
    ContentHash {high: 0, low: 0})
  drop run CacheImage.addLeaf(&mut image, true, run Bytes.copy(b"facet"), digest, 7, 0, ContentHash {high: 5, low: 6})
  let mut leaf = CacheImage.leaves(&image)[1]
  let mut memo = make()
  run remember(&mut memo, b"facet", &leaf, b"file", fileDigest, 17, false)
  leaf.file = 900
  let shared = find(&memo, b"facet", &leaf, b"file", fileDigest)
  run Testing.expect(shared != usize.MAX && placed(&memo, shared) == 17,
    "equivalent evidence shares a verification despite different shard-local file ordinals")
  run Testing.expect(find(&memo, b"facet", &leaf, b"other-file", fileDigest) == usize.MAX,
    "equal file digests do not replace exact file identity")
  run Testing.expect(find(&memo, b"facet", &leaf, b"file", ContentHash {high: 3, low: 9}) == usize.MAX,
    "the same selector from a different recorded file snapshot requires its own check")
  leaf.position = 8
  run Testing.expect(find(&memo, b"facet", &leaf, b"file", fileDigest) == usize.MAX,
    "positions belong to the recorded snapshot")
  run remember(&mut memo, b"facet", &leaf, b"file", fileDigest, usize.MAX, true)
  let moved = find(&memo, b"facet", &leaf, b"file", fileDigest)
  run Testing.expect(moved != usize.MAX && placed(&memo, moved) == usize.MAX && positional(&memo, moved),
    "a position-only failed match remains distinct from semantic invalidation")
  leaf.text = ContentHash {high: 5, low: 9}
  run Testing.expect(find(&memo, b"facet", &leaf, b"file", fileDigest) == usize.MAX,
    "different recorded token text cannot share a proof")
  let fresh = make()
  run Testing.expect(find(&fresh, b"facet", &leaf, b"file", fileDigest) == usize.MAX,
    "a new adoption or request starts without old verification authority")
}

test effect fn exactCrossShardSourceEvidenceClaims() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run proofClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
