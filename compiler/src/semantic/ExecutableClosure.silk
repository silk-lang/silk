//! Executable selection within an already admitted logical proof graph.
//! Selection never removes proof obligations or changes the record. Known body adjacency can
//! omit proof-only references; bodies without that evidence retain every logical reference.
import semantic.BuildRecord
import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import silk.collections.hash {Hash}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.u64
import silk.num.usize

fn hashed(key: ContentHash) -> u64 { return Hash.combine(key.high, key.low) }

fn find(entries: &[BuildRecord.Entry], lookup: &InternIndex, key: ContentHash) -> usize {
  let mut at = InternIndex.first(lookup, hashed(key))
  while at != usize.MAX {
    if ContentHash.equals(entries[at].exact, key) { return at }
    at = InternIndex.after(lookup, at)
  }
  return usize.MAX
}

effect fn enqueue(selected: &mut List<bool>, pending: &mut List<usize>, index: usize) -> bool
! OutOfMemoryError ? &mut Allocator {
  if index >= List<bool>.length(&selected.*) { return false }
  if !List<bool>.get(&selected.*, index) {
    run List<usize>.append(&mut pending.*, index)
    List<bool>.set(&mut selected.*, index, true)
  }
  return true
}

/// Selects executable entries without changing their original order. The caller must first
/// admit the entire logical graph, including its finite, ownership and callback obligations.
/// Extra roots, like the record roots, use exact digests when `patterns` is true and definition
/// digests otherwise. They retain exports and backend-generated roots outside instruction edges.
/// Missing or ambiguous targets, selected unfinished leaves and malformed selected aliases or
/// references refuse selection. Unknown executable adjacency conservatively follows proof edges.
pub effect fn select(record: &BuildRecord.Record, extraRoots: &[ContentHash]) -> Option<List<bool>>
! OutOfMemoryError ? &mut Allocator {
  let entries = List<BuildRecord.Entry>.asSlice(&record.entries)
  let mut lookup = run InternIndex.withCapacity(entries.length)
  let mut selected = run List<bool>.makeWithCapacity(entries.length)
  let mut at = usize.ZERO
  while at < entries.length {
    if find(entries, &lookup, entries[at].exact) != usize.MAX { return Option<List<bool>>.none() }
    run InternIndex.record(&mut lookup, hashed(entries[at].exact))
    run List<bool>.append(&mut selected, false)
    at = at + usize.ONE
  }
  let mut pending = List<usize>.make()
  let roots = List<ContentHash>.asSlice(&record.roots)
  at = usize.ZERO
  while at < roots.length {
    if !(run enqueue(&mut selected, &mut pending, find(entries, &lookup, roots[at]))) {
      return Option<List<bool>>.none()
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < extraRoots.length {
    if !(run enqueue(&mut selected, &mut pending, find(entries, &lookup, extraRoots[at]))) {
      return Option<List<bool>>.none()
    }
    at = at + usize.ONE
  }
  while let Option<usize>.Some {value: current} = move List<usize>.pop(&mut pending) {
    let entry = &entries[current]
    if entry.leaf != 0 && entry.leaf != BuildRecord.FOREIGN { return Option<List<bool>>.none() }
    if entry.alias != usize.MAX {
      // The record contract only permits aliases of earlier definitions; this also excludes
      // alias cycles without another graph traversal or recursion on the native stack.
      if entry.leaf != 0 || entry.alias >= current || !(run enqueue(&mut selected, &mut pending, entry.alias)) {
        return Option<List<bool>>.none()
      }
      continue
    }
    let known = u64.bitAnd(entry.facts.flags, BuildRecord.FACT_EXECUTABLES) != 0
    let targets = List<BuildRecord.Callee>.asSlice(&entry.facts.executables)
    let references = List<BuildRecord.Reference>.asSlice(&entry.references)
    if entry.leaf == BuildRecord.FOREIGN {
      if references.length != usize.ZERO || (known && targets.length != usize.ZERO) {
        return Option<List<bool>>.none()
      }
      continue
    }
    if entry.leaf != 0 { return Option<List<bool>>.none() }
    at = usize.ZERO
    if known {
      while at < targets.length {
        let key = if record.patterns { targets[at].exact } else { targets[at].definition }
        if !(run enqueue(&mut selected, &mut pending, find(entries, &lookup, key))) {
          return Option<List<bool>>.none()
        }
        at = at + usize.ONE
      }
    } else {
      while at < references.length {
        if !(run enqueue(&mut selected, &mut pending, references[at].target)) {
          return Option<List<bool>>.none()
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<List<bool>>.some(move selected)
}
