//! Grounded normal rules for one complete body's source and policy facts.
//!
//! Positive closure uses indexed body occurrences. Alternating lower/upper closures
//! preserve unresolved negative cycles; neither candidate reservation nor a possible
//! witness establishes a fact. The source analysis owns atom identity and admission.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.testing {AssertionError, Testing}
import silk.ownership {Copy}
import silk.usize
import silk.list {List}

/// A reserved fact in one Program. Not an externally usable source/route identifier.
pub struct Atom {
  index: usize
}
impl Copy for Atom {}

impl Atom {
  /// Compares reserved identities within the caller's one Program; this does not prove truth.
  pub fn same(left: Self, right: Self) -> bool { return left.index == right.index }
}

/// Definite truth, definite falsity, or an unresolved policy dependency.
pub enum Truth { False, True, Undefined }

struct Rule {
  head: Atom
  positive: usize
  positiveCount: usize
  negative: usize
  negativeCount: usize
}
impl Copy for Rule {}

// One contiguous range per atom, containing every positive occurrence in original
// rule order. A flat index avoids one independently allocated List per atom.
struct PositiveWatches {
  offsets: List<usize>
  rules: List<usize>
}

/// One finite rule program. Construction reserves all atoms before solve.
pub struct Program {
  atoms: usize
  rules: List<Rule>
  positive: List<Atom>
  negative: List<Atom>
  wellFormed: bool
}

/// Immutable grounded lower and possible upper interpretations.
pub struct Solution {
  lower: List<bool>
  upper: List<bool>
  wellFormed: bool
}

impl Program {
  pub fn make() -> Self {
    return Program {atoms: usize.ZERO, rules: List<Rule>.make(),
      positive: List<Atom>.make(), negative: List<Atom>.make(), wellFormed: true}
  }

  /// Reserves identity only. A source must have an actual grounding rule to exist.
  pub fn atom(self: &mut Self) -> Atom {
    let id = self.atoms
    self.atoms = id + usize.ONE
    return Atom {index: id}
  }

  /// Adds a finite conjunction, with negation interpreted by grounded refinement.
  pub effect fn rule(self: &mut Self, head: Atom, positive: &[Atom], negative: &[Atom]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let firstPositive = List<Atom>.length(&self.positive)
    let firstNegative = List<Atom>.length(&self.negative)
    if head.index >= self.atoms { self.wellFormed = false }
    let mut at = usize.ZERO
    while at < positive.length {
      if positive[at].index >= self.atoms { self.wellFormed = false }
      run List<Atom>.append(&mut self.positive, positive[at])
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < negative.length {
      if negative[at].index >= self.atoms { self.wellFormed = false }
      run List<Atom>.append(&mut self.negative, negative[at])
      at = at + usize.ONE
    }
    run List<Rule>.append(&mut self.rules, Rule {head: head,
      positive: firstPositive, positiveCount: positive.length,
      negative: firstNegative, negativeCount: negative.length})
    return ()
  }

  /// A genuine entry/expression/borrow or a fixed typed predicate.
  pub effect fn fact(self: &mut Self, head: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let empty = List<Atom>.make()
    return run Program.rule(&mut self.*, head, List<Atom>.asSlice(&empty), List<Atom>.asSlice(&empty))
  }

  /// Solves the fixed program once; callers retain only the immutable answer.
  pub effect fn solve(self: &Self) -> Solution
  ! OutOfMemoryError ? &mut Allocator {
    let mut lower = run flags(self.atoms, false)
    let mut upper = run flags(self.atoms, true)
    if !self.wellFormed { return Solution {lower: move lower, upper: move upper, wellFormed: false} }
    let watches = run positiveWatches(self)
    let mut done = false
    while !done {
      let nextLower = run closure(self, &watches, List<bool>.asSlice(&upper))
      let nextUpper = run closure(self, &watches, List<bool>.asSlice(&nextLower))
      let unchanged = same(List<bool>.asSlice(&lower), List<bool>.asSlice(&nextLower))
        && same(List<bool>.asSlice(&upper), List<bool>.asSlice(&nextUpper))
      // Invalid refinement can never become a certificate even if a caller asks
      // about an atom outside the malformed dependency slice.
      if !subset(List<bool>.asSlice(&lower), List<bool>.asSlice(&nextLower))
        || !subset(List<bool>.asSlice(&nextLower), List<bool>.asSlice(&nextUpper))
        || !subset(List<bool>.asSlice(&nextUpper), List<bool>.asSlice(&upper)) {
        return Solution {lower: move nextLower, upper: move nextUpper, wellFormed: false}
      }
      lower = move nextLower
      upper = move nextUpper
      done = unchanged
    }
    return Solution {lower: move lower, upper: move upper, wellFormed: true}
  }
}

impl Solution {
  pub fn truth(self: &Self, atom: Atom) -> Truth {
    let lower = List<bool>.asSlice(&self.lower)
    let upper = List<bool>.asSlice(&self.upper)
    if !self.wellFormed || atom.index >= lower.length || atom.index >= upper.length { return Truth.Undefined }
    if lower[atom.index] { return Truth.True }
    if !upper[atom.index] { return Truth.False }
    return Truth.Undefined
  }

  /// Well-formed refinement is necessary, not sufficient for Checked: the caller
  /// must also check source presence, categories, coverage and mandatory outcomes.
  pub fn valid(self: &Self) -> bool { return self.wellFormed }
}

effect fn flags(count: usize, value: bool) -> List<bool>
! OutOfMemoryError ? &mut Allocator {
  let mut result = List<bool>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<bool>.append(&mut result, value)
    at = at + usize.ONE
  }
  return move result
}

fn same(left: &[bool], right: &[bool]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn subset(left: &[bool], right: &[bool]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] && !right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn establish(reached: &mut List<bool>, queue: &mut List<usize>, head: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  if !List<bool>.asSlice(&reached.*)[head.index] {
    let bits = List<bool>.asMutSlice(&mut reached.*)
    bits[head.index] = true
    run List<usize>.append(&mut queue.*, head.index)
  }
  return ()
}

effect fn positiveWatches(program: &Program) -> PositiveWatches
! OutOfMemoryError ? &mut Allocator {
  let mut offsets = List<usize>.make()
  run List<usize>.reserveExact(&mut offsets, program.atoms + usize.ONE)
  let mut atom = usize.ZERO
  while atom < program.atoms {
    run List<usize>.append(&mut offsets, usize.ZERO)
    atom = atom + usize.ONE
  }
  let positive = List<Atom>.asSlice(&program.positive)
  let mut occurrence = usize.ZERO
  while occurrence < positive.length {
    let counts = List<usize>.asMutSlice(&mut offsets)
    let input = positive[occurrence].index
    counts[input] = counts[input] + usize.ONE
    occurrence = occurrence + usize.ONE
  }
  // Initially retain range ends. Reverse insertion turns each end into its start,
  // preserving the original order without a second per-atom cursor allocation.
  let mut total = usize.ZERO
  atom = usize.ZERO
  while atom < program.atoms {
    let ends = List<usize>.asMutSlice(&mut offsets)
    total = total + ends[atom]
    ends[atom] = total
    atom = atom + usize.ONE
  }
  run List<usize>.append(&mut offsets, total)
  let mut indexed = List<usize>.make()
  run List<usize>.reserveExact(&mut indexed, positive.length)
  occurrence = usize.ZERO
  while occurrence < positive.length {
    run List<usize>.append(&mut indexed, usize.ZERO)
    occurrence = occurrence + usize.ONE
  }
  let rules = List<Rule>.asSlice(&program.rules)
  let mut at = rules.length
  while at > usize.ZERO {
    at = at - usize.ONE
    let rule = rules[at]
    let mut each = rule.positiveCount
    while each > usize.ZERO {
      each = each - usize.ONE
      let input = positive[rule.positive + each].index
      let starts = List<usize>.asMutSlice(&mut offsets)
      let slot = starts[input] - usize.ONE
      starts[input] = slot
      let rows = List<usize>.asMutSlice(&mut indexed)
      rows[slot] = at
    }
  }
  return PositiveWatches {offsets: move offsets, rules: move indexed}
}

// Gamma(assumption): omit rules whose negative premise is assumed true, then
// take the least positive closure. Duplicate positive occurrences are counted
// and watched separately; a derived atom is queued only once.
effect fn closure(program: &Program, watches: &PositiveWatches, assumption: &[bool]) -> List<bool>
! OutOfMemoryError ? &mut Allocator {
  let mut reached = run flags(program.atoms, false)
  let mut queue = List<usize>.make()
  let mut remaining = List<usize>.make()
  let mut enabled = List<bool>.make()
  let rules = List<Rule>.asSlice(&program.rules)
  let negatives = List<Atom>.asSlice(&program.negative)
  let offsets = List<usize>.asSlice(&watches.offsets)
  let dependents = List<usize>.asSlice(&watches.rules)
  let mut at = usize.ZERO
  while at < rules.length {
    let rule = rules[at]
    let mut active = true
    let mut each = usize.ZERO
    while active && each < rule.negativeCount {
      if assumption[negatives[rule.negative + each].index] { active = false }
      each = each + usize.ONE
    }
    run List<bool>.append(&mut enabled, active)
    run List<usize>.append(&mut remaining, rule.positiveCount)
    if active && rule.positiveCount == usize.ZERO { run establish(&mut reached, &mut queue, rule.head) }
    at = at + usize.ONE
  }
  let mut next = usize.ZERO
  while next < List<usize>.length(&queue) {
    let atom = List<usize>.asSlice(&queue)[next]
    let mut each = offsets[atom]
    while each < offsets[atom + usize.ONE] {
      let index = dependents[each]
      if List<bool>.asSlice(&enabled)[index] {
        let count = List<usize>.asSlice(&remaining)[index]
        if count > usize.ZERO {
          let counts = List<usize>.asMutSlice(&mut remaining)
          counts[index] = count - usize.ONE
          if count == usize.ONE { run establish(&mut reached, &mut queue, rules[index].head) }
        }
      }
      each = each + usize.ONE
    }
    next = next + usize.ONE
  }
  return move reached
}

// These tests exercise the rule engine's observable three-valued contract. In particular,
// arbitrary stable-model choice, optimistic cycle seeding and a lost duplicate watch each
// falsify a different assertion without depending on compiler policy translation.

test effect fn sourceRulesRequireGroundingAndKeepNegativeCyclesOpen() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run groundingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn groundingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = Program.make()
  let seed = Program.atom(&mut rules)
  let identity = Program.atom(&mut rules)
  let looped = Program.atom(&mut rules)
  let ungrounded = Program.atom(&mut rules)
  let left = Program.atom(&mut rules)
  let right = Program.atom(&mut rules)
  let afterBoth = Program.atom(&mut rules)
  let duplicate = Program.atom(&mut rules)
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  run Program.fact(&mut rules, seed)
  let fromSeed: [Atom; 1] = [seed]
  run Program.rule(&mut rules, identity, &fromSeed, none)
  let fromIdentity: [Atom; 1] = [identity]
  run Program.rule(&mut rules, looped, &fromIdentity, none)
  let fromLoop: [Atom; 1] = [looped]
  run Program.rule(&mut rules, identity, &fromLoop, none)
  let selfOnly: [Atom; 1] = [ungrounded]
  run Program.rule(&mut rules, ungrounded, &selfOnly, none)
  let unlessLeft: [Atom; 1] = [left]
  let unlessRight: [Atom; 1] = [right]
  run Program.rule(&mut rules, left, none, &unlessRight)
  run Program.rule(&mut rules, right, none, &unlessLeft)
  let pair: [Atom; 2] = [left, right]
  run Program.rule(&mut rules, afterBoth, &pair, none)
  let repeated: [Atom; 2] = [seed, seed]
  run Program.rule(&mut rules, duplicate, &repeated, none)
  let solved = run Program.solve(&rules)
  run Testing.expect(Solution.valid(&solved), "finite alternating refinement is well formed")
  run Testing.expect(Solution.truth(&solved, identity) == Truth.True && Solution.truth(&solved, looped) == Truth.True,
    "a genuine source grounds every node in its positive identity cycle")
  run Testing.expect(Solution.truth(&solved, ungrounded) == Truth.False,
    "a source-free positive cycle supplies no witness")
  run Testing.expect(Solution.truth(&solved, left) == Truth.Undefined && Solution.truth(&solved, right) == Truth.Undefined,
    "two admissible negative-cycle choices are not resolved arbitrarily")
  run Testing.expect(Solution.truth(&solved, afterBoth) == Truth.Undefined,
    "an unresolved conjunct cannot certify a downstream policy")
  run Testing.expect(Solution.truth(&solved, duplicate) == Truth.True,
    "repeated positive occurrences have matching watch counts")
  return ()
}

test effect fn sourceRulesLossNeedsPresenceAndFollowsOnlyValueEdges() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lossClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn lossClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = Program.make()
  let present = Program.atom(&mut rules)
  let savedStored = Program.atom(&mut rules)
  let loopStored = Program.atom(&mut rules)
  let store = Program.atom(&mut rules)
  let savedExact = Program.atom(&mut rules)
  let loopExact = Program.atom(&mut rules)
  let absent = Program.atom(&mut rules)
  let absentExact = Program.atom(&mut rules)
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  run Program.fact(&mut rules, present)
  run Program.fact(&mut rules, store)
  let source: [Atom; 1] = [present]
  let storedSource: [Atom; 2] = [present, store]
  run Program.rule(&mut rules, loopStored, &storedSource, none)
  let backedge: [Atom; 2] = [present, loopStored]
  run Program.rule(&mut rules, loopStored, &backedge, none)
  let savedLoss: [Atom; 1] = [savedStored]
  let loopLoss: [Atom; 1] = [loopStored]
  run Program.rule(&mut rules, savedExact, &source, &savedLoss)
  run Program.rule(&mut rules, loopExact, &source, &loopLoss)
  let missing: [Atom; 1] = [absent]
  run Program.rule(&mut rules, absentExact, &missing, &savedLoss)
  let solved = run Program.solve(&rules)
  run Testing.expect(Solution.truth(&solved, loopStored) == Truth.True && Solution.truth(&solved, loopExact) == Truth.False,
    "an actual store transported on a value backedge rules out Exact")
  run Testing.expect(Solution.truth(&solved, savedStored) == Truth.False && Solution.truth(&solved, savedExact) == Truth.True,
    "a saved value without a backward value edge does not acquire another version's loss")
  run Testing.expect(Solution.truth(&solved, absentExact) == Truth.False,
    "absence of precision loss is insufficient without an actual source")
  return ()
}
