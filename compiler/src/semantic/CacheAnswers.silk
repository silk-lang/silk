//! Borrowed answer namespaces for immutable disk segments and fresh worker transport.
//!
//! Selected segment roots occupy a fixed prefix. Fresh in-memory roots append after that prefix,
//! so worker imports cannot rebind an ordinal already held by a replay or pending check.

import semantic.CacheImage
import semantic.CacheView
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.num.usize

/// Borrowed selected roots followed by fresh worker roots; neither payload is copied.
pub struct Answers<'a> {image: Option<&'a CacheImage.Image>, view: Option<&'a CacheView.View>}
impl<'a> Copy for Answers<'a> {}

pub fn fromImage<'a>(image: &'a CacheImage.Image) -> Answers<'a> {
  return Answers {image: Option<&CacheImage.Image>.some(image), view: Option<&CacheView.View>.none()}
}
pub fn fromView<'a>(view: &'a CacheView.View) -> Answers<'a> {
  return Answers {image: Option<&CacheImage.Image>.none(), view: Option<&CacheView.View>.some(view)}
}
/// Combines a stable selected prefix with an append-only in-memory suffix.
pub fn both<'a>(view: &'a CacheView.View, image: &'a CacheImage.Image) -> Answers<'a> {
  return Answers {image: Option<&CacheImage.Image>.some(image), view: Option<&CacheView.View>.some(view)}
}
pub fn prefix(source: Answers) -> usize {
  if let Option<&CacheView.View>.Some {value: view} = source.view { return CacheView.rootCount(view) }
  return usize.ZERO
}
pub fn count(source: Answers) -> usize {
  let mut size = prefix(source)
  if let Option<&CacheImage.Image>.Some {value: image} = source.image { size = size + List<CacheImage.Root>.length(&image.roots) }
  return size
}
/// The exact root key, or empty bytes for an invalid ordinal. Semantic keys are nonempty.
pub fn key<'a>(source: Answers<'a>, at: usize) -> &'a [u8] {
  let offset = prefix(source)
  if at < offset {
    if let Option<&CacheView.View>.Some {value: view} = source.view {
      if let Option<&[u8]>.Some {value: bytes} = move CacheView.rootKey(view, at) { return bytes }
    }
    return b""
  }
  if let Option<&CacheImage.Image>.Some {value: image} = source.image {
    let roots = List<CacheImage.Root>.asSlice(&image.roots)
    if at - offset < roots.length { return Bytes.asSlice(&roots[at - offset].key) }
  }
  return b""
}
/// Answer bytes, or empty for an invalid ordinal. Consumers still validate their payload family.
pub fn answer<'a>(source: Answers<'a>, at: usize) -> &'a [u8] {
  let offset = prefix(source)
  if at < offset {
    if let Option<&CacheView.View>.Some {value: view} = source.view {
      if let Option<&[u8]>.Some {value: bytes} = move CacheView.rootAnswer(view, at) { return bytes }
    }
    return b""
  }
  if let Option<&CacheImage.Image>.Some {value: image} = source.image {
    let roots = List<CacheImage.Root>.asSlice(&image.roots)
    if at - offset < roots.length { return Bytes.asSlice(&roots[at - offset].answer) }
  }
  return b""
}
/// Whether a selected root has dependencies; none denotes missing or malformed guard metadata.
pub fn guarded(source: Answers, at: usize) -> Option<bool> {
  let offset = prefix(source)
  if at < offset {
    if let Option<&CacheView.View>.Some {value: view} = source.view {
      if let Option<CacheView.Handle>.Some {value: node} = move CacheView.rootNode(view, at) {
        if let Option<usize>.Some {value: edges} = move CacheView.edgeCount(view, node) { return Option<bool>.some(edges > usize.ZERO) }
      }
    }
    return Option<bool>.none()
  }
  if let Option<&CacheImage.Image>.Some {value: image} = source.image {
    let roots = List<CacheImage.Root>.asSlice(&image.roots)
    if at - offset >= roots.length { return Option<bool>.none() }
    return Option<bool>.some(CacheImage.edgesOf(image, roots[at - offset].node).length > usize.ZERO)
  }
  return Option<bool>.none()
}
