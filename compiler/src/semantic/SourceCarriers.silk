//! Finite, case-gated backwards descriptor carriers in the caller's one rule program.
//! This module reserves no values, sources, origins, storage reads, flow edges or policy facts.
//! The owner admits real descriptor seeds and performs Origin/current-storage composition.

import semantic.SourcePreparation as Prepared
import semantic.SourcePreparation {SourcePreparation, EndpointId, ShapeId, ResidualStateId, MapId, BoundaryTransitionId}
import semantic.SourceRules {Atom, Program}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.ownership {Copy}
import silk.usize
import silk.vector {Vector}
import CompilerBug

/// Slice ordinals are actual source-domain cell IDs. shape is the effective value shape;
/// subject, if present, is the immediate authored selection at this value's physical anchor.
/// The adapter excludes operation-result positions and preserves private transport identity.
pub struct Cell {
  pub value: usize
  pub endpoint: EndpointId
  pub shape: ShapeId
  pub leaf: usize
  pub subject: Option<ResidualStateId>
}
impl Copy for Cell {}

pub enum Direction { Forward, StorageInverse }

/// These are authenticated case authorities, not assertions inferred from equal shapes.
/// SameComponent certifies exact endpoint/subject/Position/private-transport publication.
/// Physical.address is an AliasEdge ordinal validated by the adapter against map and actual
/// occurrence. OperationResult and publications of declared result subjects are Blocked.
/// OriginContents.proof is the root operation proof identity, equal to Pair.originProof;
/// Pair.proof instead identifies an individual residual derivation for that operation.
pub union Authority {
  SameComponent,
  Physical {pub map: MapId, pub direction: Direction, pub address: Option<usize>},
  OriginContents {pub proof: usize},
  Blocked,
}
impl Copy for Authority {}

/// Slice ordinal is the original append-only SA Case ordinal. A seed has source None;
/// only the owner can admit that seed as a ReferenceOrigin, after inspecting the real Case.
pub struct Case {
  pub source: Option<usize>
  pub target: usize
  pub active: Atom
  pub authority: Authority
}
impl Copy for Case {}

/// Root-authenticated translation across a composite Origin contents case. originProof
/// matches that case's authority; proof identifies the root's finite derivation retaining
/// original carrier cursors, reference pair and actual sourceAlias. Neither is a MapId.
/// Slice ordinals remain stable, including distinct proofs of the same residual pair.
pub struct Pair {
  pub case: usize
  pub originProof: usize
  pub sourceState: ResidualStateId
  pub targetState: ResidualStateId
  pub proof: usize
  pub active: Atom
}
impl Copy for Pair {}

/// Slice ordinal is the unique demand identity, independently of SelectionUse ordinal.
/// Retain this initial cell/state even when backwards copies reinterpret current state.
pub struct Demand {
  pub selectionUse: usize
  pub cell: usize
  pub state: ResidualStateId
  pub active: Atom
  pub reachable: Atom
}
impl Copy for Demand {}

pub struct Node {
  pub demand: usize
  pub cell: usize
  pub state: ResidualStateId
  pub active: Atom
}
impl Copy for Node {}

/// Both paired states, access and substitution remain available through current. root is
/// an exact map.boundaries entry; descendants are reached only through explicit pair.next.
pub struct BoundaryCursor {
  pub root: BoundaryTransitionId
  pub current: BoundaryTransitionId
  pub direction: Direction
}
impl Copy for BoundaryCursor {}

pub union EdgeAuthority {
  SameComponent,
  Physical {pub boundary: BoundaryCursor},
  OriginContents {pub pair: usize},
}
impl Copy for EdgeAuthority {}

pub struct Edge {
  pub later: usize
  pub earlier: usize
  pub case: usize
  pub authority: EdgeAuthority
}
impl Copy for Edge {}

pub struct Product {
  demands: Vector<Demand>
  nodes: Vector<Node>
  edges: Vector<Edge>
  scanned: Vector<usize>
  scannedPairs: Vector<usize>
  cells: usize
  cases: usize
  pairs: usize
}

impl Product {
  pub fn make() -> Self {
    return Product {demands: Vector<Demand>.make(), nodes: Vector<Node>.make(), edges: Vector<Edge>.make(),
      scanned: Vector<usize>.make(), scannedPairs: Vector<usize>.make(),
      cells: usize.ZERO, cases: usize.ZERO, pairs: usize.ZERO}
  }

  pub fn demands(self: &Self) -> &[Demand] { return Vector<Demand>.asSlice(&self.demands) }
  pub fn nodes(self: &Self) -> &[Node] { return Vector<Node>.asSlice(&self.nodes) }
  pub fn edges(self: &Self) -> &[Edge] { return Vector<Edge>.asSlice(&self.edges) }

  /// All snapshots and prepared tables keep their identities and old entries unchanged.
  /// Late cases, origin pairs and demands extend this same finite product and Program.
  /// Node/case and node/pair cursors advance independently, so a new translation for an
  /// already scanned case is still consumed. No Truth sampling, Flow emission or solve.
  pub effect fn close<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, cells: &[Cell],
    cases: &[Case], pairs: &[Pair], demands: &[Demand], rules: &mut Program) -> bool ! OutOfMemoryError ? &mut Allocator {
    if cells.length < self.cells || cases.length < self.cases || pairs.length < self.pairs
      || demands.length < Vector<Demand>.length(&self.demands) {
      return CompilerBug.panic(b"descriptor carrier snapshots shrank")
    }
    let oldNodes = Vector<Node>.length(&self.nodes)
    let oldEdges = Vector<Edge>.length(&self.edges)
    let oldDemands = Vector<Demand>.length(&self.demands)
    let mut at = self.pairs
    while at < pairs.length {
      validateOriginPair(prepared, cells, cases, pairs[at])
      at = at + usize.ONE
    }
    at = oldDemands
    let empty = Vector<Atom>.make()
    while at < demands.length {
      let demand = demands[at]
      validateNode(prepared, cells, demand.cell, demand.state)
      run Vector<Demand>.append(&mut self.demands, demand)
      let root = run Product.node(&mut self.*, rules, at, demand.cell, demand.state)
      let active = Vector<Node>.asSlice(&self.nodes)[root].active
      let gates: [Atom; 2] = [demand.active, demand.reachable]
      run Program.rule(&mut rules.*, active, &gates, Vector<Atom>.asSlice(&empty))
      at = at + usize.ONE
    }
    at = usize.ZERO
    while at < Vector<Node>.length(&self.nodes) {
      let node = Vector<Node>.asSlice(&self.nodes)[at]
      let mut each = Vector<usize>.asSlice(&self.scanned)[at]
      while each < cases.length {
        let actual = cases[each]
        if actual.target >= cells.length { return CompilerBug.panic(b"carrier case has no actual target cell") }
        if actual.target == node.cell {
          if let Option<usize>.Some {value: source} = actual.source {
            if source >= cells.length { return CompilerBug.panic(b"carrier case has no actual source cell") }
            if cells[source].leaf != cells[node.cell].leaf { return CompilerBug.panic(b"carrier case changed its actual source leaf") }
            match actual.authority {
              Authority.Blocked => ()
              Authority.OriginContents {..} => ()
              Authority.SameComponent => {
                if cells[source].endpoint.index != cells[node.cell].endpoint.index
                  || cells[source].shape.index != cells[node.cell].shape.index
                  || !sameSubject(cells[source].subject, cells[node.cell].subject) {
                  return CompilerBug.panic(b"same-component carrier changed its authenticated subject")
                }
                validateNode(prepared, cells, source, node.state)
                let gates: [Atom; 2] = [node.active, actual.active]
                run Product.edge(&mut self.*, rules, at, source, node.state, each,
                  EdgeAuthority.SameComponent, &gates)
              }
              Authority.Physical {map, direction, address} => {
                run Product.physical(&mut self.*, prepared, cells, rules, at, source, each, actual.active, map, direction, address)
              }
            }
          }
        }
        each = each + usize.ONE
      }
      Vector<usize>.asMutSlice(&mut self.scanned)[at] = cases.length
      each = Vector<usize>.asSlice(&self.scannedPairs)[at]
      while each < pairs.length {
        let pair = pairs[each]
        let actual = cases[pair.case]
        if actual.target == node.cell && pair.targetState.index == node.state.index {
          let source = match actual.source {
            Option<usize>.Some {value} => value
            _ => { return CompilerBug.panic(b"origin contents pair substituted a descriptor seed") }
          }
          let gates: [Atom; 3] = [node.active, actual.active, pair.active]
          run Product.edge(&mut self.*, rules, at, source, pair.sourceState, pair.case,
            EdgeAuthority.OriginContents {pair: each}, &gates)
        }
        each = each + usize.ONE
      }
      Vector<usize>.asMutSlice(&mut self.scannedPairs)[at] = pairs.length
      at = at + usize.ONE
    }
    self.cells = cells.length
    self.cases = cases.length
    self.pairs = pairs.length
    return oldNodes != Vector<Node>.length(&self.nodes) || oldEdges != Vector<Edge>.length(&self.edges)
      || oldDemands != Vector<Demand>.length(&self.demands)
  }

  effect fn node(self: &mut Self, rules: &mut Program, demand: usize, cell: usize, state: ResidualStateId) -> usize
  ! OutOfMemoryError ? &mut Allocator {
    let nodes = Vector<Node>.asSlice(&self.nodes)
    let mut at = usize.ZERO
    while at < nodes.length {
      if nodes[at].demand == demand && nodes[at].cell == cell && nodes[at].state.index == state.index { return at }
      at = at + usize.ONE
    }
    let id = nodes.length
    let active = Program.atom(&mut rules.*)
    run Vector<Node>.append(&mut self.nodes, Node {demand: demand, cell: cell, state: state, active: active})
    run Vector<usize>.append(&mut self.scanned, usize.ZERO)
    run Vector<usize>.append(&mut self.scannedPairs, usize.ZERO)
    return id
  }

  effect fn edge(self: &mut Self, rules: &mut Program, later: usize, cell: usize, state: ResidualStateId,
    actualCase: usize, authority: EdgeAuthority, gates: &[Atom]) -> () ! OutOfMemoryError ? &mut Allocator {
    let following = Vector<Node>.asSlice(&self.nodes)[later]
    let earlier = run Product.node(&mut self.*, rules, following.demand, cell, state)
    let edges = Vector<Edge>.asSlice(&self.edges)
    let mut at = usize.ZERO
    while at < edges.length {
      if edges[at].later == later && edges[at].earlier == earlier && edges[at].case == actualCase
        && sameEdgeAuthority(edges[at].authority, authority) { return () }
      at = at + usize.ONE
    }
    let previous = Vector<Node>.asSlice(&self.nodes)[earlier]
    let empty = Vector<Atom>.make()
    run Program.rule(&mut rules.*, previous.active, gates, Vector<Atom>.asSlice(&empty))
    run Vector<Edge>.append(&mut self.edges, Edge {later: later, earlier: earlier, case: actualCase, authority: authority})
    return ()
  }

  effect fn physical<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, cells: &[Cell],
    rules: &mut Program, later: usize, source: usize, actualCase: usize, active: Atom,
    map: MapId, direction: Direction, address: Option<usize>) -> () ! OutOfMemoryError ? &mut Allocator {
    let node = Vector<Node>.asSlice(&self.nodes)[later]
    validateMap(prepared, map, direction, address, cells[source], cells[node.cell])
    let maps = Vector<Prepared.SelectionMap>.asSlice(&prepared.maps)
    let pairs = Vector<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
    let roots = Vector<BoundaryTransitionId>.asSlice(&maps[map.index].boundaries)
    let mut matched = false
    let mut root = usize.ZERO
    while root < roots.length {
      validatePair(prepared, map, roots[root])
      let anchored = &pairs[roots[root].index]
      let endpoints = Vector<Prepared.Endpoint>.asSlice(&prepared.endpoints)
      if anchored.source.shape.index != endpoints[maps[map.index].source.index].shape.index
        || anchored.target.shape.index != endpoints[maps[map.index].target.index].shape.index {
        return CompilerBug.panic(b"carrier boundary root lost its actual map anchors")
      }
      match cells[source].subject {
        Option<ResidualStateId>.None => {
          if let Option<ResidualStateId>.Some {..} = cells[node.cell].subject {
            return CompilerBug.panic(b"physical carrier lacks paired actual subject coordinates")
          }
          if run Product.pairedEdge(&mut self.*, prepared, cells, rules, later, source, actualCase, active,
            BoundaryCursor {root: roots[root], current: roots[root], direction: direction}) { matched = true }
        }
        Option<ResidualStateId>.Some {value: sourceSubject} => {
          let targetSubject = match cells[node.cell].subject {
            Option<ResidualStateId>.Some {value} => value
            _ => { return CompilerBug.panic(b"physical carrier lacks paired actual subject coordinates") }
          }
          // Locate the supplied subject pair only through this exact root/next graph.
          // The requested selector starts at that subject's output, hence its paired next.
          let mut pending = Vector<BoundaryTransitionId>.make()
          run Vector<BoundaryTransitionId>.append(&mut pending, roots[root])
          let mut at = usize.ZERO
          while at < Vector<BoundaryTransitionId>.length(&pending) {
            let current = Vector<BoundaryTransitionId>.asSlice(&pending)[at]
            validatePair(prepared, map, current)
            let pair = &pairs[current.index]
            let next = Vector<BoundaryTransitionId>.asSlice(&pair.next)
            let selected = earlierState(pair, direction).index == sourceSubject.index
              && laterState(pair, direction).index == targetSubject.index
            let mut each = usize.ZERO
            while each < next.length {
              validateNext(prepared, map, current, next[each])
              if selected {
                if run Product.pairedEdge(&mut self.*, prepared, cells, rules, later, source, actualCase, active,
                  BoundaryCursor {root: roots[root], current: next[each], direction: direction}) { matched = true }
              }
              run appendPair(&mut pending, next[each])
              each = each + usize.ONE
            }
            at = at + usize.ONE
          }
        }
      }
      root = root + usize.ONE
    }
    if !matched { CompilerBug.panic(b"actual descriptor case has no exact paired requested state") }
    return ()
  }

  effect fn pairedEdge<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, cells: &[Cell],
    rules: &mut Program, later: usize, source: usize, actualCase: usize, active: Atom,
    cursor: BoundaryCursor) -> bool ! OutOfMemoryError ? &mut Allocator {
    let node = Vector<Node>.asSlice(&self.nodes)[later]
    let pairs = Vector<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
    let pair = &pairs[cursor.current.index]
    if laterState(pair, cursor.direction).index != node.state.index { return false }
    let before = earlierState(pair, cursor.direction)
    validateNode(prepared, cells, source, before)
    let gates: [Atom; 2] = [node.active, active]
    run Product.edge(&mut self.*, rules, later, source, before, actualCase,
      EdgeAuthority.Physical {boundary: cursor}, &gates)
    return true
  }
}

fn earlierState(pair: &Prepared.BoundaryTransition, direction: Direction) -> ResidualStateId {
  if direction == Direction.StorageInverse { return pair.targetState }
  return pair.sourceState
}
fn laterState(pair: &Prepared.BoundaryTransition, direction: Direction) -> ResidualStateId {
  if direction == Direction.StorageInverse { return pair.sourceState }
  return pair.targetState
}
fn sameSubject(left: Option<ResidualStateId>, right: Option<ResidualStateId>) -> bool {
  return match left {
    Option<ResidualStateId>.None => match right { Option<ResidualStateId>.None => true _ => false }
    Option<ResidualStateId>.Some {value} => match right { Option<ResidualStateId>.Some {value: other} => value.index == other.index _ => false }
  }
}
fn sameEdgeAuthority(left: EdgeAuthority, right: EdgeAuthority) -> bool {
  return match left {
    EdgeAuthority.SameComponent => match right { EdgeAuthority.SameComponent => true _ => false }
    EdgeAuthority.Physical {boundary: value} => match right {
      EdgeAuthority.Physical {boundary: other} => value.root.index == other.root.index
        && value.current.index == other.current.index && value.direction == other.direction
      _ => false
    }
    EdgeAuthority.OriginContents {pair} => match right {
      EdgeAuthority.OriginContents {pair: other} => pair == other
      _ => false
    }
  }
}

fn validateOriginPair<'body>(prepared: &SourcePreparation<'body>, cells: &[Cell], cases: &[Case], pair: Pair) -> () {
  if pair.case >= cases.length { CompilerBug.panic(b"origin contents pair has no actual case") }
  let actual = cases[pair.case]
  match actual.authority {
    Authority.OriginContents {proof} => {
      if proof != pair.originProof { CompilerBug.panic(b"origin contents pair changed its exact origin proof") }
    }
    _ => { CompilerBug.panic(b"origin contents pair substituted a different case authority") }
  }
  let source = match actual.source {
    Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"origin contents pair substituted a descriptor seed") }
  }
  validateNode(prepared, cells, source, pair.sourceState)
  validateNode(prepared, cells, actual.target, pair.targetState)
  if cells[source].leaf != cells[actual.target].leaf {
    CompilerBug.panic(b"origin contents pair changed its actual source leaf")
  }
  let states = Vector<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let before = &states[pair.sourceState.index]
  let after = &states[pair.targetState.index]
  if before.selection.index != after.selection.index || before.vertex.index != after.vertex.index
    || before.accepts != after.accepts {
    CompilerBug.panic(b"origin contents pair cross-paired its authored suffix")
  }
  // The root validates pair.proof's entire derivation and gates pair.active with its
  // original cases/cursors. Equal shapes or source leaves never manufacture this proof.
  return ()
}

effect fn appendPair(values: &mut Vector<BoundaryTransitionId>, id: BoundaryTransitionId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let existing = Vector<BoundaryTransitionId>.asSlice(&values.*)
  let mut at = usize.ZERO
  while at < existing.length { if existing[at].index == id.index { return () } at = at + usize.ONE }
  run Vector<BoundaryTransitionId>.append(&mut values.*, id)
  return ()
}

fn validateNode<'body>(prepared: &SourcePreparation<'body>, cells: &[Cell], cell: usize, state: ResidualStateId) -> () {
  let endpoints = Vector<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  let states = Vector<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = Vector<Prepared.Shape>.asSlice(&prepared.shapes)
  if cell >= cells.length || state.index >= states.length { CompilerBug.panic(b"carrier node is outside its actual frozen domain") }
  let actual = cells[cell]
  if actual.endpoint.index >= endpoints.length || actual.shape.index >= shapes.length {
    CompilerBug.panic(b"carrier cell lost its actual value component")
  }
  let mut shape = endpoints[actual.endpoint.index].shape
  if let Option<ResidualStateId>.Some {value} = actual.subject {
    if value.index >= states.length { CompilerBug.panic(b"carrier cell has no selected subject") }
    validateState(prepared, value)
    shape = states[value.index].output
  }
  if shape.index != actual.shape.index || states[state.index].input.shape.index != actual.shape.index {
    CompilerBug.panic(b"carrier node changed its exact actual subject shape")
  }
  validateState(prepared, state)
  return ()
}

fn validateState<'body>(prepared: &SourcePreparation<'body>, id: ResidualStateId) -> () {
  let states = Vector<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = Vector<Prepared.Shape>.asSlice(&prepared.shapes)
  if id.index >= states.length { CompilerBug.panic(b"carrier has no frozen selector state") }
  let state = &states[id.index]
  if let Prepared.ResidualAuthority.Contract {..} = state.authority {
    CompilerBug.panic(b"original contract state is not physical descriptor evidence")
  }
  if state.input.shape.index >= shapes.length || state.output.index >= shapes.length {
    CompilerBug.panic(b"carrier state has no frozen component shapes")
  }
  let components = Vector<Prepared.Component>.asSlice(&shapes[state.input.shape.index].components)
  if state.input.ordinal >= components.length { CompilerBug.panic(b"carrier state lost its exact component") }
  match &components[state.input.ordinal].selector {
    Prepared.Selector.EffectSuccess => CompilerBug.panic(b"effect success is not physical address authority")
    Prepared.Selector.EffectFailure => CompilerBug.panic(b"effect failure is not physical address authority")
    _ => ()
  }
  return ()
}

fn validateMap<'body>(prepared: &SourcePreparation<'body>, id: MapId, direction: Direction,
  address: Option<usize>, source: Cell, target: Cell) -> () {
  let maps = Vector<Prepared.SelectionMap>.asSlice(&prepared.maps)
  let endpoints = Vector<Prepared.Endpoint>.asSlice(&prepared.endpoints)
  if id.index >= maps.length { CompilerBug.panic(b"carrier case names an absent physical map") }
  let map = &maps[id.index]
  if map.source.index >= endpoints.length || map.target.index >= endpoints.length {
    CompilerBug.panic(b"carrier map lost its actual endpoints")
  }
  let identity = match &map.selector { Prepared.Selector.Identity => true _ => false }
  let physical = map.componentTransport && !map.addressTransport
    && (map.kind == Prepared.MapKind.Copy || map.kind == Prepared.MapKind.Place)
  let alias = map.addressTransport && !map.componentTransport && map.kind == Prepared.MapKind.Select
    && storageEndpoint(&endpoints[map.source.index]) && storageEndpoint(&endpoints[map.target.index])
  if !identity || (!physical && !alias) { CompilerBug.panic(b"carrier case substituted an unsupported physical map authority") }
  if let Option<Prepared.ApplicationId>.Some {..} = map.application {
    CompilerBug.panic(b"original application map is not descriptor-copy evidence")
  }
  if alias {
    if let Option<usize>.None = address { CompilerBug.panic(b"carrier alias has no authenticated AliasEdge") }
  } else {
    if let Option<usize>.Some {..} = address { CompilerBug.panic(b"descriptor copy substituted storage-alias evidence") }
  }
  let mut before = map.source
  let mut after = map.target
  if direction == Direction.StorageInverse {
    if !alias { CompilerBug.panic(b"descriptor value map cannot be inverted as storage identity") }
    before = map.target
    after = map.source
  }
  if source.endpoint.index != before.index || target.endpoint.index != after.index {
    CompilerBug.panic(b"carrier case does not join its exact physical endpoint occurrences")
  }
  return ()
}

fn storageEndpoint(endpoint: &Prepared.Endpoint) -> bool {
  return match &endpoint.root {
    Prepared.Root.Node {role, ..} => role == Prepared.EndpointRole.Storage
    Prepared.Root.Local {role, ..} => role == Prepared.EndpointRole.Storage
    _ => false
  }
}

fn validatePair<'body>(prepared: &SourcePreparation<'body>, map: MapId, id: BoundaryTransitionId) -> () {
  let pairs = Vector<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let states = Vector<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let substitutions = Vector<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)
  if id.index >= pairs.length { CompilerBug.panic(b"carrier has no frozen paired boundary") }
  let pair = &pairs[id.index]
  if pair.map.index != map.index || pair.substitution.index >= substitutions.length {
    CompilerBug.panic(b"carrier boundary changed its physical map or substitution")
  }
  let physical = &Vector<Prepared.SelectionMap>.asSlice(&prepared.maps)[map.index]
  let authority = match pair.authority {
    Prepared.BoundaryAuthority.Physical => physical.componentTransport && !physical.addressTransport
    Prepared.BoundaryAuthority.StorageAlias => physical.addressTransport && !physical.componentTransport
  }
  if !authority { CompilerBug.panic(b"carrier boundary changed its frozen authority") }
  validateState(prepared, pair.sourceState)
  validateState(prepared, pair.targetState)
  let source = &states[pair.sourceState.index]
  let target = &states[pair.targetState.index]
  if pair.source.shape.index != source.input.shape.index || pair.source.ordinal != source.input.ordinal
    || pair.target.shape.index != target.input.shape.index || pair.target.ordinal != target.input.ordinal
    || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
    || source.accepts != target.accepts || substitutions[pair.substitution.index].source.index != source.output.index
    || substitutions[pair.substitution.index].target.index != target.output.index {
    CompilerBug.panic(b"carrier boundary cross-paired its exact selector subjects")
  }
  // Access and substitution are retained by ID, not re-derived or weakened here. The
  // preparation validator checks their full declaration semantics before this product runs.
  return ()
}

fn validateNext<'body>(prepared: &SourcePreparation<'body>, map: MapId,
  parent: BoundaryTransitionId, child: BoundaryTransitionId) -> () {
  validatePair(prepared, map, child)
  let pairs = Vector<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let states = Vector<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let left = &pairs[parent.index]
  let right = &pairs[child.index]
  let source = Vector<ResidualStateId>.asSlice(&states[left.sourceState.index].next)
  let target = Vector<ResidualStateId>.asSlice(&states[left.targetState.index].next)
  let mut sourceFound = false
  let mut targetFound = false
  let mut at = usize.ZERO
  while at < source.length { if source[at].index == right.sourceState.index { sourceFound = true } at = at + usize.ONE }
  at = usize.ZERO
  while at < target.length { if target[at].index == right.targetState.index { targetFound = true } at = at + usize.ONE }
  if !sourceFound || !targetFound { CompilerBug.panic(b"carrier boundary did not advance both frozen selector sides") }
  return ()
}
