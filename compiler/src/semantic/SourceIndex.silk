//! Query-backed loading and syntax indexing for one immutable source revision.
//!
//! # When to use
//! Use [`SourceIndex`] to request a module from a held [`Revision`](semantic.SourceRevision.Revision).
//! An unused import target is not read when its importing module is indexed.
//!
//! # Details
//! Each source demand uses [`Query`](semantic.Query.Query) for typed reservation and completed
//! answers. Events record actual query starts, hits, finishes, and source map reads.

import semantic.ModuleId {ModuleId}
import semantic.InternIndex {InternIndex}
import semantic.BodyInput {BodyInput}
import semantic.ModuleIndex {ModuleIndex, NameObservation}
import semantic.Query {Cycle, Query}
import semantic.SourceRevision {Observation, Revision}
import semantic.SourceUnit {SourceUnit}
import hir.Hir {HirId, Module, Node, OwnerKind, Range}
import semantic.DeclarationId {DeclarationId}
import hir.Intern {StringTable, Symbol}
import lexer.Span {Span}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.hash {Hash, Word}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// A completed source demand with retained bytes and a syntax-only index.
pub struct IndexedSource {
  observation: Observation
  unit: SourceUnit
  index: ModuleIndex
  bodyInputs: Vector<Option<Shared<BodyInput>>>
  // One shared canonical identity per declaration ordinal, made on first request.
  identities: Vector<Option<Shared<DeclarationId>>>
}

/// One stable source-store slot whose parsed payload may be invalidated.
///
/// The slot owns its optional source, including that source's lazy declaration inputs.
/// A changed observation clears the payload while completed answers retain the slot number.
pub struct SourceSlot {
  source: Option<IndexedSource>
}

/// An owned address for short reads of one exact parsed source observation.
///
/// Keeping this address does not borrow the source index, so a body checker can request more
/// semantic facts between HIR reads. The exact source is authenticated once at creation; later
/// reads check a constant-time store identity and generation before borrowing its original HIR.
pub struct AuthoredCursor {
  token: Shared<CursorStamp>
  generation: usize
  slot: usize
}

impl AuthoredCursor {
  /// Copies a held source address without copying its parsed HIR.
  pub fn copy(self: &Self) -> Self {
    return AuthoredCursor {
      token: Shared.clone<CursorStamp>(&self.token),
      generation: self.generation,
      slot: self.slot,
    }
  }
}

struct CursorStamp {
  generation: usize
}

fn stampAddress(value: &CursorStamp) -> usize {
  return Pointer.address<CursorStamp>(Pointer.fromRef<CursorStamp>(value))
}

fn authenticatedSource(store: &SourceIndex, answer: &Shared<Result<SourceResult, NoRejection>>, id: &ModuleId) -> bool {
  return match move SourceIndex.source(store, answer, id) {
    Option<&IndexedSource>.Some {value: ignored} => true
    Option<&IndexedSource>.None => false
  }
}

/// An absent or present source result with its exact held source observation.
pub union SourceResult {
  /// The module path was absent in the held revision.
  Absent {pub observation: Observation},
  /// The module path had bytes; the observation checks the retained source before borrowing it.
  Present {pub slot: usize, pub observation: Observation},
}

/// A source append that is retained only if its query answer becomes complete.
struct SourcePublication<'a, 'b> {
  sources: &'a mut Vector<SourceSlot>
  query: &'b mut Query<Word, SourceResult, NoRejection>
  key: Word
  base: usize
}

effect fn demandSource(
  query: &mut Query<Word, SourceResult, NoRejection>,
  sources: &mut Vector<SourceSlot>,
  events: &mut Vector<Event>,
  revision: &Revision,
  id: &ModuleId,
  number: usize,
  key: Word,
) -> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  return run Query.demand(
    move query,
    key,
    effect fn(owner: &mut Query<Word, SourceResult, NoRejection>, queryKey: Word) -> Result<
      SourceResult,
      NoRejection,
    > ! OutOfMemoryError ? &mut Allocator {
      run record(&mut events.*, EventKind.QueryStart, id, number, false)
      let observed = run Revision.observe(revision, id)
      let present = Observation.isPresent(&observed)
      run record(&mut events.*, EventKind.SourceRead, id, number, present)
      let content = run Observation.copyContent(&observed)
      if let Option<Bytes>.Some {value} = move content {
        let unit = run SourceUnit.parse(id, number, move value)
        let index = run ModuleIndex.build(&unit)
        let source = IndexedSource {
          observation: run Observation.copy(&observed),
          unit: move unit,
          index: move index,
          bodyInputs: Vector.make<Option<Shared<BodyInput>>>(),
          identities: Vector.make<Option<Shared<DeclarationId>>>(),
        }
        let slot = Vector.length<SourceSlot>(&sources.*)
        run Vector.append<SourceSlot>(
          &mut sources.*,
          SourceSlot {source: Option.some<IndexedSource>(move source)},
        )
        return Result.succeed<SourceResult, NoRejection>(
          SourceResult.Present {slot: slot, observation: move observed},
        )
      }
      return Result.succeed<SourceResult, NoRejection>(
        SourceResult.Absent {observation: move observed},
      )
    },
  )
}

effect fn withPublication<'a, 'b, 'c, 'd, 'e>(
  sources: &'a mut Vector<SourceSlot>,
  query: &'b mut Query<Word, SourceResult, NoRejection>,
  events: &'c mut Vector<Event>,
  revision: &'d Revision,
  id: &'e ModuleId,
  number: usize,
  key: Word,
) -> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let base = Vector.length<SourceSlot>(&sources.*)
  let publication = SourcePublication {
    sources: move sources,
    query: move query,
    key: key,
    base: base,
  }
  let use = effect fn(resource: &mut SourcePublication<'a, 'b>) -> Shared<
    Result<SourceResult, NoRejection>,
  > ! Cycle | OutOfMemoryError ? &mut Allocator {
    let selected = resource.key
    return run demandSource(
      &mut resource.query.*,
      &mut resource.sources.*,
      move events,
      revision,
      id,
      number,
      selected,
    )
  }
  let release = effect fn(resource: &mut SourcePublication<'a, 'b>) -> () {
    let selected = resource.key
    let original = resource.base
    if !Query.isComplete(&mut resource.query.*, selected) {
      Vector.truncate<SourceSlot>(&mut resource.sources.*, original)
    }
    return ()
  }
  return run Effect.useReleaseNonParking(move publication, move use, move release)
}

struct NameSelection {
  valid: bool
  present: bool
  slot: usize
  found: Option<Shared<NameObservation>>
}

/// An empty semantic rejection type for source queries that return presence or absence.
pub struct NoRejection {}

/// An indexed unit that does not belong to this store's held source revision.
pub struct RevisionMismatch {}

/// One source-index operation that ran a provider, recorded in demand order.
///
/// # Details
///
/// A demand that reuses a completed answer and a name-bucket observation record nothing, so the
/// log grows with the modules read rather than with the queries that reuse them.
pub enum EventKind {
  /// A source index query started its provider.
  QueryStart,
  /// A source index provider completed and published its answer.
  QueryFinish,
  /// The held revision's source mapping was read.
  SourceRead,
}

/// One observable query or source-read event.
pub struct Event {
  /// The kind of operation that occurred.
  pub kind: EventKind
  /// The canonical module path involved in the operation.
  pub module: ModuleId
  /// The held revision number.
  pub revision: usize
  /// Whether a `SourceRead` found bytes; unused for other event kinds.
  pub present: bool
}

/// The fixed semantic environment for M1 source and name queries.
pub enum Environment {
  /// A completed Final profile with no package-parameter queries in this slice.
  Final,
}

/// A serial source-query store bound to one immutable Final environment and revision.
///
/// # Details
///
/// M1 has one fixed Final environment. Package-parameter queries and bootstrap environments are
/// outside this actor. The store never reads a host filesystem or follows an unused import.
pub struct SourceIndex {
  environment: Environment
  revision: Revision
  keys: Vector<ModuleId>
  keyLookup: InternIndex
  sources: Vector<SourceSlot>
  cursorToken: Option<Shared<CursorStamp>>
  query: Query<Word, SourceResult, NoRejection>
  events: Vector<Event>
}

effect fn record(
  events: &mut Vector<Event>,
  kind: EventKind,
  id: &ModuleId,
  revision: usize,
  present: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run Vector.append<Event>(
    &mut events.*,
    Event {
      kind: kind,
      module: run ModuleId.copy(id),
      revision: revision,
      present: present,
    },
  )
  return ()
}

effect fn keyFor(store: &mut SourceIndex, id: &ModuleId) -> Word ! OutOfMemoryError ? &mut Allocator {
  let hashed = ModuleId.hash(id)
  let keys = Vector.asSlice<ModuleId>(&store.keys)
  let mut ordinal = InternIndex.first(&store.keyLookup, hashed)
  while ordinal != usize.MAX {
    if ModuleId.equals(&keys[ordinal], id) {
      return Hash.word(usize.toU64(ordinal))
    }
    ordinal = InternIndex.after(&store.keyLookup, ordinal)
  }
  let next = keys.length
  run Vector.append<ModuleId>(&mut store.keys, run ModuleId.copy(id))
  run InternIndex.record(&mut store.keyLookup, hashed)
  return Hash.word(usize.toU64(next))
}

// Source slot identities never move while completed answers can retain them. Invalidating a
// content observation drops its parsed source and leaves only an empty slot identity.
fn sourceAtSlot<'a>(sources: &'a [SourceSlot], slot: usize) -> Option<&'a IndexedSource> {
  if slot < sources.length {
    if let Option<IndexedSource>.Some {value} = &sources[slot].source {
      return Option.some<&IndexedSource>(&value)
    }
  }
  return Option.none<&IndexedSource>()
}

fn answerMatches(answer: &Result<SourceResult, NoRejection>, revision: &Revision) -> bool {
  return match &answer.* {
    Result<SourceResult, NoRejection>.Success {value} => match &value {
      SourceResult.Present {observation, ..} => Observation.matches(&observation, revision)
      SourceResult.Absent {observation} => Observation.matches(&observation, revision)
    }
    Result<SourceResult, NoRejection>.Failure {..} => false
  }
}

fn answerSlot(answer: &Result<SourceResult, NoRejection>) -> usize {
  return match &answer.* {
    Result<SourceResult, NoRejection>.Success {value: SourceResult.Present {slot, ..}} => slot
    _ => usize.MAX
  }
}

fn invalidNameSelection() -> NameSelection {
  return NameSelection {
    valid: false,
    present: false,
    slot: usize.ZERO,
    found: Option.none<Shared<NameObservation>>(),
  }
}

fn presentNameSelection(
  slot: usize,
  observation: &Observation,
  sources: &[SourceSlot],
  id: &ModuleId,
  held: &Revision,
  name: &[u8],
) -> NameSelection {
  if slot >= sources.length {
    return invalidNameSelection()
  }
  let source = match move sourceAtSlot(sources, slot) {
    Option<&IndexedSource>.Some {value: indexed} => indexed
    Option<&IndexedSource>.None => {
      return invalidNameSelection()
    }
  }
  if !ModuleId.equals(&source.unit.id, id) || !Observation.equals(
    observation,
    &source.observation,
  ) || !Observation.matches(observation, held) {
    return invalidNameSelection()
  }
  let found = ModuleIndex.cachedName(&source.index, name)
  return NameSelection {valid: true, present: true, slot: slot, found: move found}
}

fn absentNameSelection(observation: &Observation, id: &ModuleId, held: &Revision) -> NameSelection {
  if ModuleId.equals(Observation.moduleId(observation), id) && Observation.matches(
    observation,
    held,
  ) {
    return NameSelection {
      valid: true,
      present: false,
      slot: usize.ZERO,
      found: Option.none<Shared<NameObservation>>(),
    }
  }
  return invalidNameSelection()
}

fn selectName(
  answer: &Result<SourceResult, NoRejection>,
  sources: &[SourceSlot],
  id: &ModuleId,
  held: &Revision,
  name: &[u8],
) -> NameSelection {
  return match & answer.* {
    Result<SourceResult, NoRejection>.Success {value} => match & value {
      SourceResult.Present {slot, observation} => {
        return presentNameSelection(slot, &observation, sources, id, held, name)
      }
      SourceResult.Absent {observation} => absentNameSelection(&observation, id, held)
    }
    Result<SourceResult, NoRejection>.Failure {error: _} => invalidNameSelection()
  }
}

effect fn bodyInputOf(indexed: &mut IndexedSource, ordinal: usize) -> Option<Shared<BodyInput>>
! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(&indexed.index)
  if ordinal >= declarations.length {
    return Option.none<Shared<BodyInput>>()
  }
  while Vector.length<Option<Shared<BodyInput>>>(&indexed.bodyInputs) <= ordinal {
    run Vector.append<Option<Shared<BodyInput>>>(
      &mut indexed.bodyInputs,
      Option.none<Shared<BodyInput>>(),
    )
  }
  let inputs = Vector.asSlice<Option<Shared<BodyInput>>>(&indexed.bodyInputs)
  if let Option<Shared<BodyInput>>.Some {value: cached} = &inputs[ordinal] {
    return Option.some<Shared<BodyInput>>(Shared.clone<BodyInput>(&cached))
  }
  let kind = DeclarationId.kind(&declarations[ordinal].identity)
  let mut enclosing = Option.none<Shared<BodyInput>>()
  if kind == OwnerKind.Anonymous || kind == OwnerKind.EffectBlock {
    let parent = match &declarations[ordinal].parent {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return Option.none<Shared<BodyInput>>() }
    }
    enclosing = run bodyInputOf(&mut indexed.*, parent)
    if let Option<Shared<BodyInput>>.None = &enclosing { return Option.none<Shared<BodyInput>>() }
  }
  let currentDeclarations = ModuleIndex.listDeclarations(&indexed.index)
  let declaration = &currentDeclarations[ordinal]
  let input = run Shared.make<BodyInput>(run BodyInput.make(
    &indexed.unit.authored,
    &declaration.identity,
    declaration.local,
    declaration.ambiguous,
    SourceUnit.bytes(&indexed.unit),
    move enclosing,
  ))
  Vector.set<Option<Shared<BodyInput>>>(
    &mut indexed.bodyInputs,
    ordinal,
    Option.some<Shared<BodyInput>>(Shared.clone<BodyInput>(&input)),
  )
  return Option.some<Shared<BodyInput>>(move input)
}

effect fn identityOf(indexed: &mut IndexedSource, ordinal: usize) -> Option<Shared<DeclarationId>>
! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(&indexed.index)
  if ordinal >= declarations.length {
    return Option.none<Shared<DeclarationId>>()
  }
  while Vector.length<Option<Shared<DeclarationId>>>(&indexed.identities) <= ordinal {
    run Vector.append<Option<Shared<DeclarationId>>>(
      &mut indexed.identities,
      Option.none<Shared<DeclarationId>>(),
    )
  }
  let identities = Vector.asSlice<Option<Shared<DeclarationId>>>(&indexed.identities)
  if let Option<Shared<DeclarationId>>.Some {value: cached} = &identities[ordinal] {
    return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&cached))
  }
  let identity = run Shared.make<DeclarationId>(run DeclarationId.copy(&declarations[ordinal].identity))
  Vector.set<Option<Shared<DeclarationId>>>(
    &mut indexed.identities,
    ordinal,
    Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&identity)),
  )
  return Option.some<Shared<DeclarationId>>(move identity)
}

impl IndexedSource {
  /// Borrows the exact present-path observation captured on the source-query miss.
  pub fn sourceObservation(self: &Self) -> &Observation {
    return &self.observation
  }
  /// Borrows the retained bytes, syntax tree, and authored HIR for this indexed source.
  pub fn sourceUnit(self: &Self) -> &SourceUnit {
    return &self.unit
  }
  /// Borrows the authored HIR retained by this indexed source.
  pub fn authored(self: &Self) -> &Module {
    return &self.unit.authored
  }
  /// Borrows the syntax-only declarations and name candidates for this indexed source.
  pub fn moduleIndex(self: &Self) -> &ModuleIndex {
    return &self.index
  }
}

impl SourceIndex {
  /// Creates a source-query store for one held in-memory revision and fixed Final environment.
  pub fn make(revision: Revision) -> SourceIndex {
    return SourceIndex {
      environment: Environment.Final,
      revision: move revision,
      keys: Vector.make<ModuleId>(),
      keyLookup: InternIndex.make(),
      sources: Vector.make<SourceSlot>(),
      cursorToken: Option.none<Shared<CursorStamp>>(),
      query: Query.make<Word, SourceResult, NoRejection>(),
      events: Vector.make<Event>(),
    }
  }
  /// Selects another immutable revision, retaining source queries whose exact content agrees.
  ///
  /// # Details
  ///
  /// Unchanged present sources keep their parsed syntax, authored HIR, name index, and stable
  /// source slots. Changed or removed sources release those values and invalidate their query;
  /// a newly present path invalidates its absent answer. Content observations, rather than paths
  /// or revision numbers, decide reuse. Every previously issued authored cursor is invalidated.
  pub fn revise(self: &mut Self, revision: Revision) -> () {
    if let Option<Shared<CursorStamp>>.Some {value} = &self.cursorToken {
      Shared.withMut<CursorStamp, ()>(&value, fn(stamp: &mut CursorStamp) -> () {
        stamp.generation = stamp.generation + usize.ONE
        return ()
      })
    }
    let mut at = usize.ZERO
    while at < Vector.length<ModuleId>(&self.keys) {
      let key = Hash.word(usize.toU64(at))
      let completed = Query.completed(&mut self.query, key)
      if let Option<Shared<Result<SourceResult, NoRejection>>>.Some {value} = move completed {
        let valid = Shared.with<Result<SourceResult, NoRejection>, bool>(
          &value,
          fn(answer: &Result<SourceResult, NoRejection>) -> bool {
            return answerMatches(answer, &revision)
          },
        )
        if !valid {
          let slot = Shared.with<Result<SourceResult, NoRejection>, usize>(&value, answerSlot)
          if slot < Vector.length<SourceSlot>(&self.sources) {
            let mut sources = Vector.asMutSlice<SourceSlot>(&mut self.sources)
            sources[slot].source = Option.none<IndexedSource>()
          }
          Query.forget(&mut self.query, key)
        }
      }
      at = at + usize.ONE
    }
    self.revision = move revision
    self.events = Vector.make<Event>()
    return ()
  }
  /// Checks exact present bytes or absence against this store's held revision.
  pub fn matchesObservation(self: &Self, observed: &Observation) -> bool {
    return Observation.matches(observed, &self.revision)
  }
  /// Returns the fixed Final environment selected for this M1 store.
  pub fn queryEnvironment(self: &Self) -> Environment {
    return self.environment
  }
  /// Borrows the provider start, source-read, and completion events recorded by this store.
  pub fn eventLog(self: &Self) -> &[Event] {
    return Vector.asSlice<Event>(&self.events)
  }
  /// Copies the held revision's exact present or absent mapping for a demanded path.
  ///
  /// # Details
  ///
  /// Semantic answers retain this observation so a later revision can validate a source
  /// dependency. This does not start another source query or parse the path again.
  pub effect fn captureObservation(self: &Self, id: &ModuleId) -> Observation
  ! OutOfMemoryError
  ? &mut Allocator {
    return run Revision.observe(&self.revision, id)
  }
  /// Requests one source and its complete syntax index through the typed query store.
  ///
  /// # Details
  ///
  /// A miss reads only this module path, then parses and indexes all of its declarations. A hit
  /// returns the completed answer without another source read or event. Source absence also
  /// completes.
  /// Provider or publication failure removes the active reservation and any unpublished source.
  pub effect fn demand(self: &mut Self, id: &ModuleId) -> Shared<Result<SourceResult, NoRejection>>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let key = run keyFor(&mut self.*, id)
    let number = Revision.revisionNumber(&self.revision)
    let hit = Query.isComplete(&mut self.query, key)
    let answer = run withPublication(
      &mut self.sources,
      &mut self.query,
      &mut self.events,
      &self.revision,
      id,
      number,
      key,
    )
    if !hit {
      run record(&mut self.events, EventKind.QueryFinish, id, number, false)
    }
    return move answer
  }
  /// Observes a complete name bucket from a completed source answer without reopening the source.
  ///
  /// # Details
  ///
  /// A written bucket is precomputed during syntax indexing and cloned without allocation. An
  /// unwritten spelling produces an owned empty observation. An absent source returns `None`;
  /// its source observation is already in the answer. No import, type, body, or layout work runs.
  ///
  /// # Gotchas
  ///
  /// If `answer` names another module or source observation, this operation fails with
  /// `RevisionMismatch`.
  pub effect fn observeName(
    self: &mut Self,
    answer: &Shared<Result<SourceResult, NoRejection>>,
    id: &ModuleId,
    name: &[u8],
  ) -> Option<Shared<NameObservation>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let held = &self.revision
    let sources = Vector.asSlice<SourceSlot>(&self.sources)
    let selected = Shared.with<Result<SourceResult, NoRejection>, NameSelection>(
      answer,
      fn(value: &Result<SourceResult, NoRejection>) -> NameSelection {
        return selectName(value, sources, id, held, name)
      },
    )
    if !selected.valid {
      fail RevisionMismatch {}
    }
    if !selected.present {
      return Option.none<Shared<NameObservation>>()
    }
    let observed = match move selected.found {
      Option<Shared<NameObservation>>.Some {value} => move value
      Option<Shared<NameObservation>>.None => run Shared.make<NameObservation>(
        run NameObservation.empty(id, name),
      )
    }
    return Option.some<Shared<NameObservation>>(move observed)
  }
  /// Borrows the one parsed unit and syntax index from a completed present answer.
  ///
  /// # Gotchas
  ///
  /// An absent answer or an answer for another module or source observation returns `None`.
  pub fn source(self: &Self, answer: &Shared<Result<SourceResult, NoRejection>>, id: &ModuleId) -> Option<
    &IndexedSource,
  > {
    let held = &self.revision
    let sources = Vector.asSlice<SourceSlot>(&self.sources)
    let selected = Shared.with<Result<SourceResult, NoRejection>, NameSelection>(
      answer,
      fn(value: &Result<SourceResult, NoRejection>) -> NameSelection {
        return selectName(value, sources, id, held, b"")
      },
    )
    if !selected.valid || !selected.present {
      return Option.none<&IndexedSource>()
    }
    return sourceAtSlot(sources, selected.slot)
  }
  /// Returns shared declaration inputs on demand, or `None` if the source or declaration is absent.
  ///
  /// # Details
  ///
  /// Unchanged source content retains the handle across revisions. Changed source content drops
  /// the cache with its parsed source. A foreign or stale source answer returns `None`.
  pub effect fn bodyInput(
    self: &mut Self,
    answer: &Shared<Result<SourceResult, NoRejection>>,
    id: &ModuleId,
    ordinal: usize,
  ) -> Option<Shared<BodyInput>> ! OutOfMemoryError ? &mut Allocator {
    let available = run SourceIndex.authoredCursor(&mut self.*, answer, id)
    let slot = match move available {
      Option<AuthoredCursor>.Some {value: cursor} => cursor.slot
      Option<AuthoredCursor>.None => { return Option.none<Shared<BodyInput>>() }
    }
    let mut sources = Vector.asMutSlice<SourceSlot>(&mut self.sources)
    let mut selected = &mut sources[slot]
    if let Option<IndexedSource>.Some {value: indexed} = &mut selected.source {
      return run bodyInputOf(&mut indexed, ordinal)
    }
    return Option.none<Shared<BodyInput>>()
  }
  /// Returns the declaration's shared canonical identity, or `None` if the source or declaration
  /// is absent.
  ///
  /// # Details
  ///
  /// Every request for one parsed source's declaration shares one handle, so retaining the
  /// identity allocates once per declaration. A foreign or stale source answer returns `None`.
  pub effect fn sharedIdentity(
    self: &mut Self,
    answer: &Shared<Result<SourceResult, NoRejection>>,
    id: &ModuleId,
    ordinal: usize,
  ) -> Option<Shared<DeclarationId>> ! OutOfMemoryError ? &mut Allocator {
    let available = run SourceIndex.authoredCursor(&mut self.*, answer, id)
    let slot = match move available {
      Option<AuthoredCursor>.Some {value: cursor} => cursor.slot
      Option<AuthoredCursor>.None => { return Option.none<Shared<DeclarationId>>() }
    }
    let mut sources = Vector.asMutSlice<SourceSlot>(&mut self.sources)
    let mut selected = &mut sources[slot]
    if let Option<IndexedSource>.Some {value: indexed} = &mut selected.source {
      return run identityOf(&mut indexed, ordinal)
    }
    return Option.none<Shared<DeclarationId>>()
  }
  /// Authenticates an exact present source once, then retains a zero-copy cursor to its HIR.
  pub effect fn authoredCursor(
    self: &mut Self,
    answer: &Shared<Result<SourceResult, NoRejection>>,
    id: &ModuleId,
  ) -> Option<AuthoredCursor> ! OutOfMemoryError ? &mut Allocator {
    if !authenticatedSource(&self.*, answer, id) {
      return Option.none<AuthoredCursor>()
    }
    let slot = Shared.with<Result<SourceResult, NoRejection>, usize>(answer, fn(value: &Result<SourceResult, NoRejection>) -> usize {
      return match &value.* {
        Result<SourceResult, NoRejection>.Success {value: SourceResult.Present {slot, ..}} => slot
        _ => usize.MAX
      }
    })
    if slot == usize.MAX {
      return Option.none<AuthoredCursor>()
    }
    let needsToken = match &self.cursorToken {
      Option<Shared<CursorStamp>>.None => true
      Option<Shared<CursorStamp>>.Some {value: ignored} => false
    }
    if needsToken {
      self.cursorToken = Option.some<Shared<CursorStamp>>(
        run Shared.make<CursorStamp>(CursorStamp {generation: usize.ZERO}),
      )
    }
    if let Option<Shared<CursorStamp>>.Some {value} = &self.cursorToken {
      return Option.some<AuthoredCursor>(AuthoredCursor {
        token: Shared.clone<CursorStamp>(&value),
        generation: Shared.with<CursorStamp, usize>(&value, fn(stamp: &CursorStamp) -> usize {
          return stamp.generation
        }),
        slot: slot,
      })
    }
    return Option.none<AuthoredCursor>()
  }
  /// Borrows the exact indexed source authenticated by this cursor.
  pub fn sourceAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
    return cursorSource(self, cursor)
  }
  /// Reads one Copy HIR node through a short, constant-time authenticated borrow.
  pub fn authoredNode(self: &Self, cursor: &AuthoredCursor, id: HirId) -> Option<Node> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      let hir = IndexedSource.authored(value)
      if id.index < Module.length(hir) {
        return Option.some<Node>(Module.node(hir, id))
      }
    }
    return Option.none<Node>()
  }
  /// Reads one source span through a short, constant-time authenticated borrow.
  pub fn authoredSpan(self: &Self, cursor: &AuthoredCursor, id: HirId) -> Option<Span> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      let hir = IndexedSource.authored(value)
      if id.index < Module.length(hir) {
        return Option.some<Span>(Module.span(hir, id))
      }
    }
    return Option.none<Span>()
  }
  /// Reads one child identity through a short, constant-time authenticated borrow.
  pub fn authoredChild(self: &Self, cursor: &AuthoredCursor, range: Range, at: usize) -> Option<HirId> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      if at < range.length {
        return Option.some<HirId>(Module.child(IndexedSource.authored(value), range, at))
      }
    }
    return Option.none<HirId>()
  }
  /// Borrows interned text only until the next mutable resolver demand.
  pub fn authoredText(self: &Self, cursor: &AuthoredCursor, symbol: Symbol) -> Option<&[u8]> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      let hir = IndexedSource.authored(value)
      if symbol.index < StringTable.length(&hir.strings) {
        return Option.some<&[u8]>(Module.text(hir, symbol))
      }
    }
    return Option.none<&[u8]>()
  }
}

// A cloned token keeps its allocation live, so its payload address is an exact store identity
// without an ABA reuse. Revising the store advances the generation even when parsed content
// is retained.
fn cursorSource(self: &SourceIndex, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
  if let Option<Shared<CursorStamp>>.Some {value: held} = &self.cursorToken {
    let owner = Shared.with<CursorStamp, usize>(&held, stampAddress)
    let supplied = Shared.with<CursorStamp, usize>(&cursor.token, stampAddress)
    if owner != supplied {
      return Option.none<&IndexedSource>()
    }
    let generation = Shared.with<CursorStamp, usize>(&held, fn(stamp: &CursorStamp) -> usize {
      return stamp.generation
    })
    if generation != cursor.generation {
      return Option.none<&IndexedSource>()
    }
    let sources = Vector.asSlice<SourceSlot>(&self.sources)
    if cursor.slot < sources.length {
      return sourceAtSlot(sources, cursor.slot)
    }
  }
  return Option.none<&IndexedSource>()
}
