//! Query-backed loading and syntax indexing for one immutable source revision.
//!
//! # When to use
//! Use [`SourceIndex`] to request a module from a held [`Revision`](semantic.SourceRevision.Revision).
//! An unused import target is not read when its importing module is indexed.
//!
//! # Details
//! Each source demand uses [`Query`](semantic.Query.Query) for typed reservation and completed
//! answers. Events record actual query starts, hits, finishes, and source map reads.

import semantic.Published {Published}
import semantic.SourceEpoch {SourceEpoch}
import semantic.Types {Types}
import silk.mem.interned {Interned}
import semantic.Anchor {Anchor}
import semantic.ModuleId {ModuleId}
import semantic.InternIndex {InternIndex}
import semantic.ModuleIndex {ModuleIndex, NameObservation}
import semantic.Query {Cycle, Query}
import semantic.SourceRevision {Observation, Revision}
import semantic.SourceUnit {SourceUnit}
import hir.Hir {Cause, CauseCode, DiagnosticDetail, HirId, Module, Node, OwnerKind, Range, ownedChildren}
import semantic.DeclarationId {DeclarationId}
import hir.Intern {StringTable, Symbol}
import lexer.Span {Span}
import lexer.LexicalDiagnostic {LexicalDiagnostic}
import silk.collections.slice {Slice}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.collections.hash {Hash, Word}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.mem.pointer {Pointer}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.num.usize
import silk.collections.list {List}

/// A completed source demand with retained bytes and a syntax-only index.
pub struct IndexedSource {
  observation: Observation,
  payload: ParsedPayload,
  // Private per-store memo: only immutable parsed data is published to other workers.
  identities: List<Option<Interned<DeclarationId>>>,
}

/// Complete immutable syntax/HIR, declaration/name index and header placement for exact bytes.
/// Builders own all fields until SourceEpoch publication. No query, cursor or lazy identity memo
/// is stored here. SourceEpoch authenticates unit bytes before accepting a completed payload.
pub struct ParsedSource { unit: SourceUnit, index: ModuleIndex, headers: HeaderPlaces }
impl ParsedSource {
  pub fn unit(self: &Self) -> &SourceUnit { return &self.unit }
}
union ParsedPayload {
  Owned {value: ParsedSource},
  Published {value: Published<ParsedSource>},
}
fn parsedSource(source: &IndexedSource) -> &ParsedSource {
  return match &source.payload {
    ParsedPayload.Owned {value} => &value
    ParsedPayload.Published {value} => Published<ParsedSource>.get(&value)
  }
}

/// The aggregate members of a written header, each one a direct child of it.
pub fn memberRange(value: Node) -> Range {
  return match value {
    Node.StructHeader {fields, ..} => fields
    Node.TupleHeader {elements, ..} => elements
    Node.UnionHeader {variants, ..} => variants
    Node.EnumHeader {members, ..} => members
    _ => Range.empty()
  }
}

/// Where one authored node sits inside a written header: the innermost indexed declaration whose
/// header holds it, and the header member it falls under, or `usize.MAX` outside every member.
pub struct HeaderPlace {
  pub declaration: usize,
  pub member: usize,
}

impl Copy for HeaderPlace {}

/// Every node of every indexed header, placed once per source revision. Finding the header and
/// member around a node is then one lookup, rather than a walk of its declaration's header per
/// read, which made a deeply nested written type quadratic.
struct HeaderPlaces {
  nodes: List<usize>,
  places: List<HeaderPlace>,
  lookup: InternIndex,
}

// Declarations are listed after their parents, so a nested header placed later overwrites the
// enclosing one and every node keeps its innermost header.
effect fn placeHeaders(hir: &Module, index: &ModuleIndex) -> HeaderPlaces ! OutOfMemoryError ? &mut Allocator {
  let declarations = ModuleIndex.listDeclarations(index)
  let mut placed = HeaderPlaces {nodes: List<usize>.make(), places: List<HeaderPlace>.make(), lookup: InternIndex.make()}
  let mut ordinal = usize.ZERO
  while ordinal < declarations.length {
    let header = declarations[ordinal].header
    run placeSubtree(&mut placed, hir, header, HeaderPlace {declaration: ordinal, member: usize.MAX})
    let range = memberRange(Module.node(hir, header))
    let mut at = usize.ZERO
    while at < range.length {
      run placeSubtree(&mut placed, hir, Module.child(hir, range, at), HeaderPlace {declaration: ordinal, member: at})
      at = at + usize.ONE
    }
    ordinal = ordinal + usize.ONE
  }
  return move placed
}

effect fn placeSubtree(placed: &mut HeaderPlaces, hir: &Module, root: HirId, place: HeaderPlace) -> () ! OutOfMemoryError ? &mut Allocator {
  let nodes = List<usize>.asSlice(&placed.nodes)
  let mut at = InternIndex.first(&placed.lookup, usize.toU64(root.index))
  while at != usize.MAX && nodes[at] != root.index { at = InternIndex.after(&placed.lookup, at) }
  if at == usize.MAX {
    run List<usize>.append(&mut placed.nodes, root.index)
    run List<HeaderPlace>.append(&mut placed.places, place)
    run InternIndex.record(&mut placed.lookup, usize.toU64(root.index))
  } else {
    let places = List<HeaderPlace>.asMutSlice(&mut placed.places)
    places[at] = place
  }
  let children = run ownedChildren(hir, root)
  let listed = List<HirId>.asSlice(&children)
  let mut child = usize.ZERO
  while child < listed.length {
    run placeSubtree(&mut placed.*, hir, listed[child], place)
    child = child + usize.ONE
  }
  return ()
}

/// One changed loaded module, retaining its previous declaration index for identity matching.
pub struct SourceChange {
  pub module: ModuleId,
  pub previous: Option<ModuleIndex>,
}

/// One parser diagnostic of a loaded source. A syntax error rejects the program whether or not any
/// declaration of its module is demanded: every loaded module is parsed (MODULE-004).
pub struct SyntaxProblem {
  /// The module whose source holds the problem.
  pub module: ModuleId,
  /// The parser's span: zero width for a missing token.
  pub span: Span,
  /// The parser's classification.
  pub code: CauseCode,
  /// The token the parser's diagnostic names.
  pub detail: DiagnosticDetail,
  /// The source text of each span a lexical failure's message names (`LexicalDiagnostic.holeSpan`).
  pub holes: List<Bytes>,
}

/// One stable source-store slot whose parsed payload may be invalidated.
///
/// The slot owns its optional source, including that source's lazy declaration inputs.
/// A changed observation clears the payload while completed answers retain the slot number.
pub struct SourceSlot {
  source: Option<IndexedSource>,
}

/// An owned address for short reads of one exact parsed source observation.
///
/// Keeping this address does not borrow the source index, so a body checker can request more
/// semantic facts between HIR reads. The exact source is authenticated once at creation; later
/// reads check a constant-time store identity and generation before borrowing its original HIR.
pub struct AuthoredCursor {
  token: Shared<CursorStamp>,
  generation: usize,
  slot: usize,
  // The declaration whose body is read through this cursor, which positions are kept relative to.
  body: Option<Anchor>,
}

impl AuthoredCursor {
  /// Copies a held source address without copying its parsed HIR.
  pub fn copy(self: &Self) -> Self {
    return AuthoredCursor {
      token: Shared<CursorStamp>.clone(&self.token),
      generation: self.generation,
      slot: self.slot,
      body: copyAnchor(&self.body),
    }
  }
  /// Copies this address for reading the body of the declaration `anchor` starts.
  pub fn anchored(self: &Self, anchor: &Anchor) -> Self {
    return AuthoredCursor {
      token: Shared<CursorStamp>.clone(&self.token),
      generation: self.generation,
      slot: self.slot,
      body: Option<Anchor>.some(Anchor.copy(anchor)),
    }
  }
  /// The declaration this cursor reads a body of, absent for a cursor over the whole module.
  pub fn anchor(self: &Self) -> Option<Anchor> {
    return copyAnchor(&self.body)
  }
}

fn copyAnchor(anchor: &Option<Anchor>) -> Option<Anchor> {
  return match &anchor.* {
    Option<Anchor>.Some {value} => Option<Anchor>.some(Anchor.copy(&value))
    Option<Anchor>.None => Option<Anchor>.none()
  }
}

struct CursorStamp {
  generation: usize,
}

fn stampAddress(value: &CursorStamp) -> usize {
  return Pointer.address<CursorStamp>(Pointer.fromRef<CursorStamp>(value))
}

fn authenticatedSource(store: &SourceIndex, answer: &Shared<Result<SourceResult, NoRejection>>, id: &ModuleId) -> bool {
  return match move SourceIndex.source(store, answer, id) {
    Option<&IndexedSource>.Some {..} => true
    Option<&IndexedSource>.None => false
  }
}

/// An absent or present source result with its exact held source observation.
pub union SourceResult {
  /// The module path was absent in the held revision.
  Absent {pub observation: Observation},
  /// The module path had bytes; the observation checks the retained source before borrowing it.
  Present {pub slot: usize, pub observation: Observation},
}

/// A source append that is retained only if its query answer becomes complete.
struct SourcePublication<'a, 'b> {
  sources: &'a mut List<SourceSlot>,
  query: &'b mut Query<SourceResult, NoRejection>,
  key: Word,
  base: usize,
}

effect fn demandSource(
  query: &mut Query<SourceResult, NoRejection>,
  sources: &mut List<SourceSlot>,
  events: &mut List<Event>,
  revision: &Revision,
  id: &ModuleId,
  number: usize,
  key: Word,
  fingerprinted: bool,
  parsed: &mut List<SourceUnit>,
  epoch: &Option<SourceEpoch>,
) -> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  return run Query.demand(
    move query,
    key,
    effect fn(owner: &mut Query<SourceResult, NoRejection>, queryKey: Word) -> Result<
      SourceResult,
      NoRejection,
    > ! OutOfMemoryError ? &mut Allocator {
      run record(&mut events.*, EventKind.QueryStart, id, number, false)
      let observed = run Revision.observe(revision, id)
      let present = Observation.isPresent(&observed)
      run record(&mut events.*, EventKind.SourceRead, id, number, present)
      if present {
        let payload = run sourcePayload(&observed, id, number, fingerprinted, &mut parsed.*, epoch)
        let source = IndexedSource {
          observation: run Observation.copy(&observed), payload: move payload,
          identities: List<Option<Interned<DeclarationId>>>.make(),
        }
        let slot = List<SourceSlot>.length(&sources.*)
        run List<SourceSlot>.append(
          &mut sources.*,
          SourceSlot {source: Option<IndexedSource>.some(move source)},
        )
        return Result<SourceResult, NoRejection>.succeed(
          SourceResult.Present {slot: slot, observation: move observed},
        )
      }
      return Result<SourceResult, NoRejection>.succeed(
        SourceResult.Absent {observation: move observed},
      )
    },
  )
}

effect fn sourcePayload(observed: &Observation, id: &ModuleId, number: usize, fingerprinted: bool,
  offered: &mut List<SourceUnit>, epoch: &Option<SourceEpoch>) -> ParsedPayload
! OutOfMemoryError ? &mut Allocator {
  let mut prepared = Option<SourceUnit>.none()
  if let Option<SourceEpoch>.Some {value: held} = &epoch.* {
    if let Option<Published<ParsedSource>>.Some {value} = move SourceEpoch.parsed(&held, id) {
      return ParsedPayload.Published {value: move value}
    }
    prepared = SourceEpoch.takeParsed(&held, id)
  }
  let mut unit = match move prepared {
    Option<SourceUnit>.Some {value} => move value
    Option<SourceUnit>.None => {
      let content = match move run Observation.copyContent(observed) {
        Option<Bytes>.Some {value} => move value
        _ => Intrinsic.trap("a present source observation retains its bytes")
      }
      match move takeParsed(&mut offered.*, id, number, Bytes.asSlice(&content)) {
        Option<SourceUnit>.Some {value} => move value
        _ => run SourceUnit.parse(id, number, move content)
      }
    }
  }
  unit.revision = number
  let index = run ModuleIndex.build(&unit, fingerprinted)
  SourceUnit.releaseTokens(&mut unit)
  let headers = run placeHeaders(&unit.authored, &index)
  let payload = ParsedSource {unit: move unit, index: move index, headers: move headers}
  if let Option<SourceEpoch>.Some {value: held} = &epoch.* {
    let ready = run Published<ParsedSource>.make(move payload)
    return match move SourceEpoch.keep(&held, &ready) {
      Option<Published<ParsedSource>>.Some {value} => ParsedPayload.Published {value: move value}
      _ => Intrinsic.trap("a parser result belongs to the exact held source epoch")
    }
  }
  return ParsedPayload.Owned {value: move payload}
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

// The unit a driver parsed from exactly `content` of module `id`, if any, as a unit of revision
// `number`: a parse depends only on the bytes, and the driver's revision numbers count its loads.
fn takeParsed(parsed: &mut List<SourceUnit>, id: &ModuleId, number: usize, content: &[u8]) -> Option<SourceUnit> {
  let units = List<SourceUnit>.asSlice(&parsed.*)
  let mut at = usize.ZERO
  while at < units.length {
    if ModuleId.equals(&units[at].id, id) && sameBytes(SourceUnit.bytes(&units[at]), content) {
      let mut unit = List<SourceUnit>.remove(&mut parsed.*, at)
      unit.revision = number
      return Option<SourceUnit>.some(move unit)
    }
    at = at + usize.ONE
  }
  return Option<SourceUnit>.none()
}

effect fn withPublication<'a, 'b, 'c, 'd, 'e, 'f, 'g>(
  sources: &'a mut List<SourceSlot>,
  query: &'b mut Query<SourceResult, NoRejection>,
  events: &'c mut List<Event>,
  revision: &'d Revision,
  id: &'e ModuleId,
  number: usize,
  key: Word,
  fingerprinted: bool,
  parsed: &'f mut List<SourceUnit>,
  epoch: &'g Option<SourceEpoch>,
) -> Shared<Result<SourceResult, NoRejection>> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let base = List<SourceSlot>.length(&sources.*)
  let publication = SourcePublication {
    sources: move sources,
    query: move query,
    key: key,
    base: base,
  }
  let use = effect fn(resource: &mut SourcePublication<'a, 'b>) -> Shared<
    Result<SourceResult, NoRejection>,
  > ! Cycle | OutOfMemoryError ? &mut Allocator {
    let selected = resource.key
    return run demandSource(
      &mut resource.query.*,
      &mut resource.sources.*,
      move events,
      revision,
      id,
      number,
      selected,
      fingerprinted,
      move parsed,
      epoch,
    )
  }
  let release = effect fn(resource: &mut SourcePublication<'a, 'b>) -> () {
    let selected = resource.key
    let original = resource.base
    if !Query.isComplete(&mut resource.query.*, selected) {
      List<SourceSlot>.truncate(&mut resource.sources.*, original)
    }
    return ()
  }
  return run Effect.useReleaseNonParking(move publication, move use, move release)
}

struct NameSelection {
  valid: bool,
  present: bool,
  slot: usize,
  found: Option<Published<NameObservation>>,
}

/// An empty semantic rejection type for source queries that return presence or absence.
pub struct NoRejection {}

/// An indexed unit that does not belong to this store's held source revision.
pub struct RevisionMismatch {}

/// One source-index operation that ran a provider, recorded in demand order.
///
/// # Details
///
/// A demand that reuses a completed answer and a name-bucket observation record nothing, so the
/// log grows with the modules read rather than with the queries that reuse them.
pub enum EventKind {
  /// A source index query started its provider.
  QueryStart,
  /// A source index provider completed and published its answer.
  QueryFinish,
  /// The held revision's source mapping was read.
  SourceRead,
}

/// One observable query or source-read event.
pub struct Event {
  /// The kind of operation that occurred.
  pub kind: EventKind,
  /// The canonical module path involved in the operation.
  pub module: ModuleId,
  /// The held revision number.
  pub revision: usize,
  /// Whether a `SourceRead` found bytes; unused for other event kinds.
  pub present: bool,
}

/// The fixed semantic environment for M1 source and name queries.
pub enum Environment {
  /// A completed Final profile with no package-parameter queries in this slice.
  Final,
}

/// A serial source-query store bound to one immutable Final environment and revision.
///
/// # Details
///
/// M1 has one fixed Final environment. Package-parameter queries and bootstrap environments are
/// outside this actor. The store never reads a host filesystem or follows an unused import.
pub struct SourceIndex {
  environment: Environment,
  revision: Revision,
  epoch: Option<SourceEpoch>,
  keys: List<ModuleId>,
  keyLookup: InternIndex,
  // The key `keyFor` found last, or `usize.MAX`: consecutive demands mostly name one module.
  lastKey: usize,
  sources: List<SourceSlot>,
  cursorToken: Option<Shared<CursorStamp>>,
  query: Query<SourceResult, NoRejection>,
  events: List<Event>,
  // Whether this store can be revised; `revise` traps on a one-shot store.
  revisions: bool,
  // Units a driver parsed already, each taken by the first demand of the same module and bytes.
  parsed: List<SourceUnit>,
}

effect fn record(
  events: &mut List<Event>,
  kind: EventKind,
  id: &ModuleId,
  revision: usize,
  present: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Event>.append(
    &mut events.*,
    Event {
      kind: kind,
      module: ModuleId.copy(id),
      revision: revision,
      present: present,
    },
  )
  return ()
}

/// The source text of each span a lexical failure's message names (`LexicalDiagnostic.holeSpan`),
/// read from `bytes`, the text of the module the failure is in.
pub effect fn sourceHoles(detail: DiagnosticDetail, bytes: &[u8]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut holes = List<Bytes>.make()
  if let DiagnosticDetail.Lexical {diagnostic: failure} = detail {
    let mut hole = usize.ZERO
    while true {
      let located = LexicalDiagnostic.holeSpan(failure, hole)
      if let Option<Span>.Some {value} = move located {
        if value.start > value.end || value.end > bytes.length { break }
        run List<Bytes>.append(&mut holes, run Bytes.copy(Slice.view<u8>(bytes, value.start, value.end - value.start)))
      } else {
        break
      }
      hole = hole + usize.ONE
    }
  }
  return move holes
}

effect fn keyFor(store: &mut SourceIndex, id: &ModuleId) -> Word ! OutOfMemoryError ? &mut Allocator {
  let keys = List<ModuleId>.asSlice(&store.keys)
  if store.lastKey != usize.MAX && ModuleId.equals(&keys[store.lastKey], id) {
    return Hash.word(usize.toU64(store.lastKey))
  }
  let hashed = ModuleId.hash(id)
  let mut ordinal = InternIndex.first(&store.keyLookup, hashed)
  while ordinal != usize.MAX {
    if ModuleId.equals(&keys[ordinal], id) {
      store.lastKey = ordinal
      return Hash.word(usize.toU64(ordinal))
    }
    ordinal = InternIndex.after(&store.keyLookup, ordinal)
  }
  let next = keys.length
  run List<ModuleId>.append(&mut store.keys, ModuleId.copy(id))
  run InternIndex.record(&mut store.keyLookup, hashed)
  store.lastKey = next
  return Hash.word(usize.toU64(next))
}

// Source slot identities never move while completed answers can retain them. Invalidating a
// content observation drops its parsed source and leaves only an empty slot identity.
fn sourceAtSlot<'a>(sources: &'a [SourceSlot], slot: usize) -> Option<&'a IndexedSource> {
  if slot < sources.length {
    if let Option<IndexedSource>.Some {value} = &sources[slot].source {
      return Option<&IndexedSource>.some(&value)
    }
  }
  return Option<&IndexedSource>.none()
}

fn answerMatches(answer: &Result<SourceResult, NoRejection>, revision: &Revision) -> bool {
  return match &answer.* {
    Result<SourceResult, NoRejection>.Success {value} => match &value {
      SourceResult.Present {observation, ..} => Observation.matches(&observation, revision)
      SourceResult.Absent {observation} => Observation.matches(&observation, revision)
    }
    Result<SourceResult, NoRejection>.Failure {..} => false
  }
}

fn answerSlot(answer: &Result<SourceResult, NoRejection>) -> usize {
  return match &answer.* {
    Result<SourceResult, NoRejection>.Success {value: SourceResult.Present {slot, ..}} => slot
    _ => usize.MAX
  }
}

fn invalidNameSelection() -> NameSelection {
  return NameSelection {
    valid: false,
    present: false,
    slot: usize.ZERO,
    found: Option<Published<NameObservation>>.none(),
  }
}

fn presentNameSelection(
  slot: usize,
  observation: &Observation,
  sources: &[SourceSlot],
  id: &ModuleId,
  name: &[u8],
  lookup: bool,
) -> NameSelection {
  if slot >= sources.length {
    return invalidNameSelection()
  }
  let source = match move sourceAtSlot(sources, slot) {
    Option<&IndexedSource>.Some {value: indexed} => indexed
    Option<&IndexedSource>.None => {
      return invalidNameSelection()
    }
  }
  // A filled slot's observation matches the held revision: a slot is kept only once its answer
  // completes, and `revise` empties the slot of every completed answer the new revision changes.
  // So an answer observing the same bytes as the slot matches the held revision too.
  if !ModuleId.equals(&parsedSource(source).unit.id, id) || !Observation.equals(observation, &source.observation) {
    return invalidNameSelection()
  }
  let mut found = Option<Published<NameObservation>>.none()
  if lookup { found = ModuleIndex.cachedName(&parsedSource(source).index, name) }
  return NameSelection {valid: true, present: true, slot: slot, found: move found}
}

fn absentNameSelection(observation: &Observation, id: &ModuleId, held: &Revision) -> NameSelection {
  if ModuleId.equals(Observation.moduleId(observation), id) && Observation.matches(
    observation,
    held,
  ) {
    return NameSelection {
      valid: true,
      present: false,
      slot: usize.ZERO,
      found: Option<Published<NameObservation>>.none(),
    }
  }
  return invalidNameSelection()
}

// The filled slot a present `answer` for `id` reads, or `usize.MAX`; the same check as
// `presentNameSelection` without a name lookup.
fn presentSlot(answer: &Result<SourceResult, NoRejection>, sources: &[SourceSlot], id: &ModuleId) -> usize {
  if let Result<SourceResult, NoRejection>.Success {value: SourceResult.Present {slot, observation}} = &answer.* {
    if let Option<&IndexedSource>.Some {value: source} = move sourceAtSlot(sources, slot) {
      if ModuleId.equals(&parsedSource(source).unit.id, id) && Observation.equals(&observation, &source.observation) { return slot }
    }
  }
  return usize.MAX
}

// Validates `answer` against this store and, when `lookup` is set, finds `name`'s bucket.
fn selectName(
  answer: &Result<SourceResult, NoRejection>,
  sources: &[SourceSlot],
  id: &ModuleId,
  held: &Revision,
  name: &[u8],
  lookup: bool,
) -> NameSelection {
  return match & answer.* {
    Result<SourceResult, NoRejection>.Success {value} => match & value {
      SourceResult.Present {slot, observation} => {
        return presentNameSelection(slot, &observation, sources, id, name, lookup)
      }
      SourceResult.Absent {observation} => absentNameSelection(&observation, id, held)
    }
    Result<SourceResult, NoRejection>.Failure {..} => invalidNameSelection()
  }
}

effect fn identityOf(indexed: &mut IndexedSource, ordinal: usize) -> Option<Interned<DeclarationId>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = ModuleIndex.listDeclarations(&parsedSource(&indexed.*).index).length
  if ordinal >= count {
    return Option<Interned<DeclarationId>>.none()
  }
  while List<Option<Interned<DeclarationId>>>.length(&indexed.identities) <= ordinal {
    run List<Option<Interned<DeclarationId>>>.append(
      &mut indexed.identities,
      Option<Interned<DeclarationId>>.none(),
    )
  }
  let identities = List<Option<Interned<DeclarationId>>>.asSlice(&indexed.identities)
  if let Option<Interned<DeclarationId>>.Some {value: cached} = &identities[ordinal] {
    return Option<Interned<DeclarationId>>.some(Interned<DeclarationId>.clone(&cached))
  }
  let declaration = DeclarationId.copy(&ModuleIndex.listDeclarations(&parsedSource(&indexed.*).index)[ordinal].identity)
  let identity = run Types.internDeclaration(move declaration)
  List<Option<Interned<DeclarationId>>>.set(
    &mut indexed.identities,
    ordinal,
    Option<Interned<DeclarationId>>.some(Interned<DeclarationId>.clone(&identity)),
  )
  return Option<Interned<DeclarationId>>.some(move identity)
}

impl IndexedSource {
  /// The anchor of the declaration at `ordinal`; an anonymous literal takes the anchor of its
  /// nearest enclosing named declaration, whose analysis it belongs to.
  pub fn anchorOf(self: &Self, ordinal: usize) -> Option<Anchor> {
    let declarations = ModuleIndex.listDeclarations(&parsedSource(self).index)
    let mut at = ordinal
    while at < declarations.length {
      let kind = DeclarationId.kind(&declarations[at].identity)
      if kind != OwnerKind.Literal {
        return Anchor.of(&parsedSource(self).unit.authored, &parsedSource(self).unit.locations, declarations[at].local)
      }
      at = match &declarations[at].parent {
        Option<usize>.Some {value} => value
        Option<usize>.None => usize.MAX
      }
    }
    return Option<Anchor>.none()
  }
  /// Borrows the exact present-path observation captured on the source-query miss.
  pub fn sourceObservation(self: &Self) -> &Observation {
    return &self.observation
  }
  /// Borrows the retained bytes, syntax tree, and authored HIR for this indexed source.
  pub fn sourceUnit(self: &Self) -> &SourceUnit {
    return &parsedSource(self).unit
  }
  /// Borrows the authored HIR retained by this indexed source.
  pub fn authored(self: &Self) -> &Module {
    return &parsedSource(self).unit.authored
  }
  /// Borrows the syntax-only declarations and name candidates for this indexed source.
  pub fn moduleIndex(self: &Self) -> &ModuleIndex {
    return &parsedSource(self).index
  }
  /// The innermost indexed header holding `id`, with its member; absent outside every header.
  pub fn headerPlace(self: &Self, id: HirId) -> Option<HeaderPlace> {
    let nodes = List<usize>.asSlice(&parsedSource(self).headers.nodes)
    let mut at = InternIndex.first(&parsedSource(self).headers.lookup, usize.toU64(id.index))
    while at != usize.MAX {
      if nodes[at] == id.index { return Option<HeaderPlace>.some(List<HeaderPlace>.asSlice(&parsedSource(self).headers.places)[at]) }
      at = InternIndex.after(&parsedSource(self).headers.lookup, at)
    }
    return Option<HeaderPlace>.none()
  }
}

fn heldRevision(self: &SourceIndex) -> &Revision {
  return match &self.epoch {
    Option<SourceEpoch>.Some {value} => SourceEpoch.revision(&value)
    _ => &self.revision
  }
}

fn openIndex(revision: Revision, revisions: bool) -> SourceIndex {
  return SourceIndex {
    environment: Environment.Final,
    revision: move revision,
    epoch: Option<SourceEpoch>.none(),
    keys: List<ModuleId>.make(),
    keyLookup: InternIndex.make(),
    lastKey: usize.MAX,
    sources: List<SourceSlot>.make(),
    cursorToken: Option<Shared<CursorStamp>>.none(),
    query: Query<SourceResult, NoRejection>.make(),
    events: List<Event>.make(),
    revisions: revisions,
    parsed: List<SourceUnit>.make(),
  }
}

// A one-shot store recorded no evidence to validate a revision against, so revising one is a
// caller defect.
fn oneShotRevised() -> () {
  return Intrinsic.trap("a one-shot store was revised")
}

impl SourceIndex {
  /// Creates a private immutable query store over the common source epoch. No Query, local
  /// source ordinal, declaration-handle memo or AuthoredCursor token crosses the boundary.
  pub fn inEpoch(epoch: &SourceEpoch) -> SourceIndex {
    let mut store = openIndex(Revision.make(), false)
    store.epoch = Option<SourceEpoch>.some(SourceEpoch.clone(epoch))
    return move store
  }

  /// Creates a source-query store for one held in-memory revision and fixed Final environment.
  pub fn make(revision: Revision) -> SourceIndex {
    return openIndex(move revision, true)
  }
  /// Creates a store that is never revised, for a one-shot build that holds its whole program.
  ///
  /// # Details
  ///
  /// It computes the same answers as [`make`].
  ///
  /// # Gotchas
  ///
  /// [`revise`] traps on a one-shot store.
  pub fn oneShot(revision: Revision) -> SourceIndex {
    return openIndex(move revision, false)
  }
  /// Makes this inherited source store immutable, retaining its already computed answers.
  /// Further revision attempts trap, as they do for a store opened with `oneShot`.
  pub fn freeze(self: &mut Self) -> () { self.revisions = false }
  /// Reports whether this store can be revised, so its users keep revision evidence.
  pub fn revisable(self: &Self) -> bool {
    return self.revisions
  }
  /// Selects another immutable revision, retaining source queries whose exact content agrees, and
  /// returns the loaded modules whose bytes or presence changed.
  ///
  /// # Details
  ///
  /// Unchanged present sources keep their parsed syntax, authored HIR, name index, and stable
  /// source slots. Changed or removed sources release those values and invalidate their query;
  /// a newly present path invalidates its absent answer. Content observations, rather than paths
  /// or revision numbers, decide reuse. Every previously issued authored cursor is invalidated.
  pub effect fn revise(self: &mut Self, revision: Revision) -> List<SourceChange> ! OutOfMemoryError ? &mut Allocator {
    if !self.revisions {
      oneShotRevised()
    }
    let mut changed = List<SourceChange>.make()
    // No fallible publication after source slots/cursors start changing.
    run List<SourceChange>.reserve(&mut changed, List<ModuleId>.length(&self.keys))
    if let Option<Shared<CursorStamp>>.Some {value} = &self.cursorToken {
      Shared<CursorStamp>.withMut<()>(&value, fn(stamp: &mut CursorStamp) -> () {
        stamp.generation = stamp.generation + usize.ONE
        return ()
      })
    }
    let mut at = usize.ZERO
    while at < List<ModuleId>.length(&self.keys) {
      let key = Hash.word(usize.toU64(at))
      let completed = Query.completed(&mut self.query, key)
      if let Option<Shared<Result<SourceResult, NoRejection>>>.Some {value} = move completed {
        let valid = Shared<Result<SourceResult, NoRejection>>.with<bool>(
          &value,
          fn(answer: &Result<SourceResult, NoRejection>) -> bool {
            return answerMatches(answer, &revision)
          },
        )
        if !valid {
          let slot = Shared<Result<SourceResult, NoRejection>>.with<usize>(&value, answerSlot)
          let mut previous = Option<ModuleIndex>.none()
          if slot < List<SourceSlot>.length(&self.sources) {
            let mut sources = List<SourceSlot>.asMutSlice(&mut self.sources)
            let held = Intrinsic.replace(sources[slot].source, Option<IndexedSource>.none())
            if let Option<IndexedSource>.Some {value: prior} = move held {
              previous = match move prior.payload {
                ParsedPayload.Owned {value} => Option<ModuleIndex>.some(move value.index)
                ParsedPayload.Published {..} => Intrinsic.trap("a source epoch store cannot be revised")
              }
            }
          }
          Query.forget(&mut self.query, key)
          let keys = List<ModuleId>.asSlice(&self.keys)
          run List<SourceChange>.append(&mut changed, SourceChange {module: ModuleId.copy(&keys[at]), previous: move previous})
        }
      }
      at = at + usize.ONE
    }
    self.revision = move revision
    self.events = List<Event>.make()
    return move changed
  }
  /// Reports whether this store's held revision has bytes for one module path.
  pub fn presents(self: &Self, id: &ModuleId) -> bool {
    return Revision.presents(heldRevision(self), id)
  }
  /// Returns the fixed Final environment selected for this M1 store.
  pub fn queryEnvironment(self: &Self) -> Environment {
    return self.environment
  }
  /// Borrows the provider start, source-read, and completion events recorded by this store.
  pub fn eventLog(self: &Self) -> &[Event] {
    return List<Event>.asSlice(&self.events)
  }
  /// Lists the parser diagnostics of every source this store has loaded, in load order and then
  /// source order. HIR causes that only mark a construct the lowering does not support are not
  /// syntax errors and are left to the analysis that demands them.
  /// How many source slots the index holds, in load order; loading a module only appends.
  pub fn slotCount(self: &Self) -> usize {
    return List<SourceSlot>.length(&self.sources)
  }
  /// The module slot `at` holds, when that source is present.
  pub fn presentModule(self: &Self, at: usize) -> Option<&ModuleId> {
    let slots = List<SourceSlot>.asSlice(&self.sources)
    if at < slots.length {
      if let Option<IndexedSource>.Some {value: indexed} = &slots[at].source {
        return Option<&ModuleId>.some(&parsedSource(&indexed).unit.id)
      }
    }
    return Option<&ModuleId>.none()
  }
  pub effect fn syntaxProblems(self: &Self) -> List<SyntaxProblem> ! OutOfMemoryError ? &mut Allocator {
    let mut problems = List<SyntaxProblem>.make()
    let slots = List<SourceSlot>.asSlice(&self.sources)
    let mut at = usize.ZERO
    while at < slots.length {
      if let Option<IndexedSource>.Some {value: indexed} = &slots[at].source {
        let mut position = usize.ZERO
        while position < SourceUnit.diagnosticCount(&parsedSource(&indexed).unit) {
          let diagnostic = SourceUnit.diagnostic(&parsedSource(&indexed).unit, position)
          if diagnostic.code == CauseCode.MissingToken || diagnostic.code == CauseCode.UnexpectedToken
            || diagnostic.code == CauseCode.NestingLimit || diagnostic.code == CauseCode.ReservedTemplate
            || diagnostic.code == CauseCode.ReservedImportBinding || diagnostic.code == CauseCode.LoopStatement
            || diagnostic.code == CauseCode.OptionalTypeSyntax || diagnostic.code == CauseCode.TupleTypeSyntax
            || diagnostic.code == CauseCode.IfExpression || diagnostic.code == CauseCode.ForeignSpelling
            || diagnostic.code == CauseCode.WithClause || diagnostic.code == CauseCode.LexicalError {
            let holes = run sourceHoles(diagnostic.detail, SourceUnit.bytes(&parsedSource(&indexed).unit))
            run List<SyntaxProblem>.append(&mut problems, SyntaxProblem {
              module: ModuleId.copy(&parsedSource(&indexed).unit.id), span: diagnostic.span, code: diagnostic.code,
              detail: diagnostic.detail, holes: move holes,
            })
          }
          position = position + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    return move problems
  }
  /// Copies the held revision's exact present or absent mapping for a demanded path.
  ///
  /// # Details
  ///
  /// Semantic answers retain this observation so a later revision can validate a source
  /// dependency. This does not start another source query or parse the path again.
  pub effect fn captureObservation(self: &Self, id: &ModuleId) -> Observation
  ! OutOfMemoryError
  ? &mut Allocator {
    return run Revision.observe(heldRevision(self), id)
  }
  /// Requests one source and its complete syntax index through the typed query store.
  ///
  /// # Details
  ///
  /// A miss reads only this module path, then parses and indexes all of its declarations. A hit
  /// returns the completed answer without another source read or event. Source absence also
  /// completes.
  /// Provider or publication failure removes the active reservation and any unpublished source.
  /// Hands the store units a driver already parsed. The first demand of a module whose bytes in
  /// this revision equal a unit's takes that unit instead of parsing again.
  pub fn offerParsed(self: &mut Self, units: List<SourceUnit>) -> () {
    if let Option<SourceEpoch>.Some {value} = &self.epoch {
      let mut remaining = move units
      while List<SourceUnit>.length(&remaining) > 0 {
        let last = List<SourceUnit>.length(&remaining) - 1
        let unit = List<SourceUnit>.remove(&mut remaining, last)
        SourceEpoch.offerParsed(&value, move unit)
      }
      return ()
    }
    self.parsed = move units
  }
  pub effect fn demand(self: &mut Self, id: &ModuleId) -> Shared<Result<SourceResult, NoRejection>>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let key = run keyFor(&mut self.*, id)
    // A completed answer needs no publication scope; nearly every demand is one.
    if let Option<Shared<Result<SourceResult, NoRejection>>>.Some {value: completed} = Query.completed(&mut self.query, key) {
      return move completed
    }
    return run SourceIndex.publishDemand(&mut self.*, id, key)
  }
  // The publishing path of `demand`, kept out of line so the completed-answer path keeps a small
  // frame.
  @inlineNever
  effect fn publishDemand(self: &mut Self, id: &ModuleId, key: Word) -> Shared<Result<SourceResult, NoRejection>>
  ! Cycle | OutOfMemoryError
  ? &mut Allocator {
    let epoch = match &self.epoch {
      Option<SourceEpoch>.Some {value} => Option<SourceEpoch>.some(SourceEpoch.clone(&value))
      _ => Option<SourceEpoch>.none()
    }
    let revision = match &epoch {
      Option<SourceEpoch>.Some {value} => SourceEpoch.revision(&value)
      _ => &self.revision
    }
    let number = Revision.revisionNumber(revision)
    let answer = run withPublication(
      &mut self.sources,
      &mut self.query,
      &mut self.events,
      revision,
      id,
      number,
      key,
      self.revisions,
      &mut self.parsed,
      &epoch,
    )
    run record(&mut self.events, EventKind.QueryFinish, id, number, false)
    return move answer
  }
  /// Observes a complete name bucket from a completed source answer without reopening the source.
  ///
  /// # Details
  ///
  /// A written bucket is precomputed during syntax indexing and cloned without allocation. An
  /// unwritten spelling produces an owned empty observation. An absent source returns `None`;
  /// its source observation is already in the answer. No import, type, body, or layout work runs.
  ///
  /// # Gotchas
  ///
  /// If `answer` names another module or source observation, this operation fails with
  /// `RevisionMismatch`.
  pub effect fn observeName(
    self: &mut Self,
    answer: &Shared<Result<SourceResult, NoRejection>>,
    id: &ModuleId,
    name: &[u8],
  ) -> Option<Published<NameObservation>> ! RevisionMismatch | OutOfMemoryError ? &mut Allocator {
    let held = heldRevision(&self.*)
    let sources = List<SourceSlot>.asSlice(&self.sources)
    let selected = Shared<Result<SourceResult, NoRejection>>.with<NameSelection>(
      answer,
      fn(value: &Result<SourceResult, NoRejection>) -> NameSelection {
        return selectName(value, sources, id, held, name, true)
      },
    )
    if !selected.valid {
      fail RevisionMismatch {}
    }
    if !selected.present {
      return Option<Published<NameObservation>>.none()
    }
    let observed = match move selected.found {
      Option<Published<NameObservation>>.Some {value} => move value
      Option<Published<NameObservation>>.None => run Published<NameObservation>.make(
        run NameObservation.empty(id, name),
      )
    }
    return Option<Published<NameObservation>>.some(move observed)
  }
  /// Borrows the one parsed unit and syntax index from a completed present answer.
  ///
  /// # Gotchas
  ///
  /// An absent answer or an answer for another module or source observation returns `None`.
  pub fn source(self: &Self, answer: &Shared<Result<SourceResult, NoRejection>>, id: &ModuleId) -> Option<
    &IndexedSource,
  > {
    let sources = List<SourceSlot>.asSlice(&self.sources)
    let slot = Shared<Result<SourceResult, NoRejection>>.with<usize>(
      answer,
      fn(value: &Result<SourceResult, NoRejection>) -> usize { return presentSlot(value, sources, id) },
    )
    return sourceAtSlot(sources, slot)
  }
  /// Returns the declaration's shared canonical identity, or `None` if the source or declaration
  /// is absent.
  ///
  /// # Details
  ///
  /// Every request for one parsed source's declaration shares one handle, so retaining the
  /// identity allocates once per declaration. A foreign or stale source answer returns `None`.
  pub effect fn sharedIdentity(
    self: &mut Self,
    answer: &Shared<Result<SourceResult, NoRejection>>,
    id: &ModuleId,
    ordinal: usize,
  ) -> Option<Interned<DeclarationId>> ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let available = run SourceIndex.authoredCursor(&mut self.*, answer, id)
    let slot = match move available {
      Option<AuthoredCursor>.Some {value: cursor} => cursor.slot
      Option<AuthoredCursor>.None => { return Option<Interned<DeclarationId>>.none() }
    }
    let mut sources = List<SourceSlot>.asMutSlice(&mut self.sources)
    let mut selected = &mut sources[slot]
    if let Option<IndexedSource>.Some {value: indexed} = &mut selected.source {
      return run identityOf(&mut indexed, ordinal)
    }
    return Option<Interned<DeclarationId>>.none()
  }
  /// Authenticates an exact present source once, then retains a zero-copy cursor to its HIR.
  pub effect fn authoredCursor(
    self: &mut Self,
    answer: &Shared<Result<SourceResult, NoRejection>>,
    id: &ModuleId,
  ) -> Option<AuthoredCursor> ! OutOfMemoryError ? &mut Allocator {
    if !authenticatedSource(&self.*, answer, id) {
      return Option<AuthoredCursor>.none()
    }
    let slot = Shared<Result<SourceResult, NoRejection>>.with<usize>(answer, fn(value: &Result<SourceResult, NoRejection>) -> usize {
      return match &value.* {
        Result<SourceResult, NoRejection>.Success {value: SourceResult.Present {slot, ..}} => slot
        _ => usize.MAX
      }
    })
    if slot == usize.MAX {
      return Option<AuthoredCursor>.none()
    }
    let needsToken = match &self.cursorToken {
      Option<Shared<CursorStamp>>.None => true
      Option<Shared<CursorStamp>>.Some {..} => false
    }
    if needsToken {
      self.cursorToken = Option<Shared<CursorStamp>>.some(
        run Shared<CursorStamp>.make(CursorStamp {generation: usize.ZERO}),
      )
    }
    if let Option<Shared<CursorStamp>>.Some {value} = &self.cursorToken {
      return Option<AuthoredCursor>.some(AuthoredCursor {
        token: Shared<CursorStamp>.clone(&value),
        generation: Shared<CursorStamp>.with<usize>(&value, fn(stamp: &CursorStamp) -> usize {
          return stamp.generation
        }),
        slot: slot,
        body: Option<Anchor>.none(),
      })
    }
    return Option<AuthoredCursor>.none()
  }
  /// The anchor of the declaration at `ordinal` in the cursor's source; an anonymous literal
  /// takes the anchor of its nearest enclosing named declaration, whose analysis it belongs to.
  pub fn declarationAnchor(self: &Self, cursor: &AuthoredCursor, ordinal: usize) -> Option<Anchor> {
    if let Option<&IndexedSource>.Some {value: indexed} = move SourceIndex.sourceAtCursor(self, cursor) {
      return IndexedSource.anchorOf(indexed, ordinal)
    }
    return Option<Anchor>.none()
  }
  /// Borrows the exact indexed source authenticated by this cursor.
  pub fn sourceAtCursor(self: &Self, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
    return cursorSource(self, cursor)
  }
  /// Reads one Copy HIR node through a short, constant-time authenticated borrow.
  pub fn authoredNode(self: &Self, cursor: &AuthoredCursor, id: HirId) -> Option<Node> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      let hir = IndexedSource.authored(value)
      if id.index < Module.length(hir) {
        return Option<Node>.some(Module.node(hir, id))
      }
    }
    return Option<Node>.none()
  }
  /// Reports whether the node records `code` among its recovery causes.
  pub fn authoredHasCause(self: &Self, cursor: &AuthoredCursor, id: HirId, code: CauseCode) -> bool {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      let hir = IndexedSource.authored(value)
      if id.index < Module.length(hir) {
        let range = Module.causeRange(hir, id)
        let causes = List<Cause>.asSlice(&hir.causes)
        let mut at = usize.ZERO
        while at < range.length {
          if causes[range.start + at].code == code {
            return true
          }
          at = at + usize.ONE
        }
      }
    }
    return false
  }
  /// Reads one source span through a short, constant-time authenticated borrow.
  pub fn authoredSpan(self: &Self, cursor: &AuthoredCursor, id: HirId) -> Option<Span> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      let hir = IndexedSource.authored(value)
      if id.index < Module.length(hir) {
        return Option<Span>.some(Module.span(hir, id))
      }
    }
    return Option<Span>.none()
  }
  /// Reads one child identity through a short, constant-time authenticated borrow.
  pub fn authoredChild(self: &Self, cursor: &AuthoredCursor, range: Range, at: usize) -> Option<HirId> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      if at < range.length {
        return Option<HirId>.some(Module.child(IndexedSource.authored(value), range, at))
      }
    }
    return Option<HirId>.none()
  }
  /// Borrows interned text only until the next mutable resolver demand.
  pub fn authoredText(self: &Self, cursor: &AuthoredCursor, symbol: Symbol) -> Option<&[u8]> {
    if let Option<&IndexedSource>.Some {value} = move cursorSource(self, cursor) {
      let hir = IndexedSource.authored(value)
      if symbol.index < StringTable.length(&hir.strings) {
        return Option<&[u8]>.some(Module.text(hir, symbol))
      }
    }
    return Option<&[u8]>.none()
  }
}

// A cloned token keeps its allocation live, so its payload address is an exact store identity
// without an ABA reuse. Revising the store advances the generation even when parsed content
// is retained.
fn cursorSource(self: &SourceIndex, cursor: &AuthoredCursor) -> Option<&IndexedSource> {
  if let Option<Shared<CursorStamp>>.Some {value: held} = &self.cursorToken {
    let owner = Shared<CursorStamp>.with<usize>(&held, stampAddress)
    let supplied = Shared<CursorStamp>.with<usize>(&cursor.token, stampAddress)
    if owner != supplied {
      return Option<&IndexedSource>.none()
    }
    let generation = Shared<CursorStamp>.with<usize>(&held, fn(stamp: &CursorStamp) -> usize {
      return stamp.generation
    })
    if generation != cursor.generation {
      return Option<&IndexedSource>.none()
    }
    let sources = List<SourceSlot>.asSlice(&self.sources)
    if cursor.slot < sources.length {
      return sourceAtSlot(sources, cursor.slot)
    }
  }
  return Option<&IndexedSource>.none()
}
