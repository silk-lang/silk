//! Behavioral identity retained by a native C function pointer and linked C signature.

import silk.core.ownership {Copy}

pub enum Memory { None, Read, Write, ReadWrite }
pub enum Locality { External, Arguments }
/// The invocation extent one callback list of a linked C declaration promises for its callbacks.
pub enum Callbacks {
  /// Callbacks run on the calling thread before the receiving call returns, without retention.
  Synchronous,
  /// Callbacks may run on any thread during or after the receiving call.
  Thread,
  /// Retained callbacks run only during later marked calls on the registering thread.
  Deferred,
}
impl Callbacks {
  /// The mode's word in a callback contract identity.
  pub fn code(self: Self) -> u64 {
    return match self { Callbacks.Synchronous => 1 Callbacks.Thread => 2 Callbacks.Deferred => 3 }
  }
}

/// Memory access and callback invocation facts that participate in native signature identity.
pub struct ForeignContract {
  /// The reads and writes the foreign implementation may perform.
  pub memory: Memory,
  /// Whether memory access may reach external storage or only argument-reachable storage.
  pub locality: Locality,
  /// Whether a callback list promises synchronous invocation.
  pub synchronousCallbacks: bool,
  /// Whether a callback list permits invocation on any thread.
  pub threadCallbacks: bool,
  /// Whether a callback list permits deferred invocation on the registering thread.
  pub deferredCallbacks: bool,
  /// Whether this call may invoke callbacks retained on the calling thread.
  pub invokesDeferredCallbacks: bool,
}
impl Copy for ForeignContract {}
impl ForeignContract {
  pub fn conservative() -> ForeignContract {
    return ForeignContract {memory: Memory.ReadWrite, locality: Locality.External, synchronousCallbacks: false,
      threadCallbacks: false, deferredCallbacks: false, invokesDeferredCallbacks: false}
  }
  /// Whether the declaration takes checked callback arguments in any mode.
  pub fn hasCallbacks(self: Self) -> bool {
    return self.synchronousCallbacks || self.threadCallbacks || self.deferredCallbacks
  }
  /// Records that a callback list of `mode` is present.
  pub fn admit(self: &mut Self, mode: Callbacks) -> () {
    match mode {
      Callbacks.Synchronous => { self.synchronousCallbacks = true }
      Callbacks.Thread => { self.threadCallbacks = true }
      Callbacks.Deferred => { self.deferredCallbacks = true }
    }
    return ()
  }
  pub fn same(left: ForeignContract, right: ForeignContract) -> bool {
    return ForeignContract.code(left) == ForeignContract.code(right)
  }
  pub fn code(self: Self) -> u64 {
    let memory: u64 = match self.memory { Memory.None => 0 Memory.Read => 1 Memory.Write => 2 Memory.ReadWrite => 3 }
    let mut locality: u64 = 0
    if self.memory != Memory.None { locality = match self.locality { Locality.External => 0 Locality.Arguments => 4 } }
    let mut code = memory + locality
    if self.synchronousCallbacks { code = code + 8 }
    if self.threadCallbacks { code = code + 16 }
    if self.invokesDeferredCallbacks { code = code + 32 }
    if self.deferredCallbacks { code = code + 64 }
    return code
  }
}
