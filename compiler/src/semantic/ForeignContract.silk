//! Behavioral identity retained by a synchronous native C function pointer.

pub enum Memory { None, Read, Write, ReadWrite }
pub enum Locality { External, Arguments }
pub struct ForeignContract { pub memory: Memory pub locality: Locality }
impl Copy for ForeignContract {}
impl ForeignContract {
  pub fn conservative() -> ForeignContract { return ForeignContract {memory: Memory.ReadWrite, locality: Locality.External} }
  pub fn same(left: ForeignContract, right: ForeignContract) -> bool {
    return left.memory == right.memory && left.locality == right.locality
  }
  pub fn code(self: Self) -> u64 {
    let memory: u64 = match self.memory { Memory.None => 0 Memory.Read => 1 Memory.Write => 2 Memory.ReadWrite => 3 }
    let locality: u64 = match self.locality { Locality.External => 0 Locality.Arguments => 4 }
    return memory + locality
  }
}
