//! Normal-rule translation of the borrow checker's ordered source policy.
//!
//! Inputs name the exact observation versions prepared by the owning operation. Result scans
//! use one snapshot and sequential per-loan precision versions; these functions never read a
//! final whole-body precision or choose one admissible policy solution.

import semantic.SourceRules {Atom, Program, Solution, Truth}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.testing {AssertionError, Testing}
import silk.ownership {Copy}
import silk.usize
import silk.vector {Vector}
import CompilerBug

/// Positive source presence and the two independent positive precision-loss facts.
pub struct Quality { pub present: Atom, pub stored: Atom, pub alternatives: Atom }
impl Copy for Quality {}

pub struct ResultInput {
  pub quality: Quality
  pub stores: Atom
  pub retained: Atom
  pub required: Atom
  pub known: Atom
  pub outside: Atom
  pub forwarded: Atom
  pub local: Atom
  pub matched: Atom
  pub outlivesResult: Atom
  pub declared: Atom
  pub body: Atom
  pub complete: Atom
  pub unneeded: Atom
  pub placedSeveral: Atom
  pub namedSingle: Atom
  pub impliedKnown: Atom
  pub ancestor: Atom
  pub mayOutlive: Atom
  pub alternatives: Atom
  pub wholeField: Atom
  pub forwardingNone: Atom
  pub hasTyped: Atom
}

pub struct ResultOutput {
  pub kept: Atom
  pub addStored: Atom
  pub addAlternatives: Atom
  pub bound: Atom
  pub unretained: Atom
  pub declared: Atom
  pub whole: Atom
  pub described: Atom
}

/// Compiles resultDecision in its original first-match order. Unknown earlier guards prevent
/// later rules from certifying, while an independent earlier grounded decision still applies.
pub effect fn result(rules: &mut Program, input: &ResultInput) -> ResultOutput
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let mut guards = Vector<Atom>.make()
  run Vector<Atom>.append(&mut guards, input.stores)
  let notRetained: [Atom; 2] = [input.retained, input.required]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, none, &notRetained))
  let outsideForwarded: [Atom; 4] = [input.known, input.outside, input.forwarded, input.local]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &outsideForwarded, none))
  let outsideBound: [Atom; 4] = [input.known, input.outside, input.local, input.outlivesResult]
  let notMatched: [Atom; 1] = [input.matched]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &outsideBound, &notMatched))
  let declared: [Atom; 2] = [input.known, input.declared]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &declared, none))
  let localOrBodyInputs: [Atom; 2] = [input.local, input.body]
  let localOrBody = run disjunction(rules, &localOrBodyInputs)
  let outsideDrop: [Atom; 3] = [input.known, input.outside, localOrBody]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &outsideDrop, none))
  let completeDrop: [Atom; 3] = [input.known, input.complete, input.unneeded]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &completeDrop, none))
  let placed: [Atom; 2] = [input.known, input.placedSeveral]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &placed, none))
  let named: [Atom; 2] = [input.known, input.namedSingle]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &named, none))
  let implied: [Atom; 3] = [input.known, input.impliedKnown, input.body]
  let preventImplied: [Atom; 5] = [input.quality.stored, input.quality.alternatives, input.ancestor, input.required, input.mayOutlive]
  run Vector<Atom>.append(&mut guards, run conjunction(rules, &implied, &preventImplied))
  let selected = run ordered(rules, input.quality.present, Vector<Atom>.asSlice(&guards))
  let branches = Vector<Atom>.asSlice(&selected)
  let keepInputs: [Atom; 7] = [branches[0], branches[2], branches[3], branches[4], branches[7], branches[8], branches[10]]
  let kept = run disjunction(rules, &keepInputs)
  // Only the final undecided branch changes precision. The earlier exact branches preserve
  // both existing loss bits rather than upgrading Stored/Alternatives/Unknown to Exact.
  let unresolved = branches[10]
  let loseA: [Atom; 1] = [unresolved]
  let addAlternatives = run conjunction(rules, &loseA, none)
  let alternatives: [Atom; 1] = [input.alternatives]
  let addStored = run conjunction(rules, &loseA, &alternatives)
  let retainedDeclared: [Atom; 2] = [kept, input.declared]
  let noStore: [Atom; 1] = [input.stores]
  let declaredOutput = run conjunction(rules, &retainedDeclared, &noStore)
  let wholeInputs: [Atom; 2] = [kept, input.wholeField]
  let noWhole: [Atom; 2] = [declaredOutput, input.matched]
  let whole = run conjunction(rules, &wholeInputs, &noWhole)
  let describedInputs: [Atom; 2] = [input.forwardingNone, input.hasTyped]
  let described = run conjunction(rules, &describedInputs, &noStore)
  return ResultOutput {kept: kept, addStored: addStored, addAlternatives: addAlternatives,
    bound: branches[3], unretained: branches[5], declared: declaredOutput, whole: whole, described: described}
}

/// One original final retention judgment, before parent closure. The typed classifier supplies
/// exactly one of these for this paired route case; it is not a union over unrelated histories.
pub enum Sink { Local, Universal, Unknown }
pub struct RetentionInput {
  pub quality: Quality
  pub initial: Sink
  pub local: bool
  pub located: bool
  pub knownField: bool
  pub actualPoint: bool
}
impl Copy for RetentionInput {}

/// A source-authenticated child/parent relation, including original operand/only restrictions.
pub struct ParentEdge { pub child: usize, pub parent: usize, pub applicable: Atom }
impl Copy for ParentEdge {}

pub struct RetentionOutput {
  pub universal: Atom
  pub unknown: Atom
  pub caller: Atom
  pub independentEscape: Atom
  pub storing: Atom
}
impl Copy for RetentionOutput {}

/// Completes the parent walk before producing effects. Passing through a nonlocal parent does
/// not promote its own sink; promoting a local parent never creates a located witness.
pub effect fn retention(rules: &mut Program, input: &[RetentionInput], parents: &[ParentEdge]) -> Vector<RetentionOutput>
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let mut visited = Vector<Atom>.make()
  let mut promoted = Vector<Atom>.make()
  let mut at = usize.ZERO
  while at < input.length {
    let reached = Program.atom(rules)
    let promotion = Program.atom(rules)
    run Vector<Atom>.append(&mut visited, reached)
    run Vector<Atom>.append(&mut promoted, promotion)
    if input[at].initial == Sink.Universal {
      let present: [Atom; 1] = [input[at].quality.present]
      run Program.rule(rules, reached, &present, none)
    }
    if input[at].local {
      let reachedAndPresent: [Atom; 2] = [reached, input[at].quality.present]
      run Program.rule(rules, promotion, &reachedAndPresent, none)
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < parents.length {
    let edge = parents[at]
    let traversal: [Atom; 4] = [Vector<Atom>.asSlice(&visited)[edge.child], edge.applicable,
      input[edge.child].quality.present, input[edge.parent].quality.present]
    run Program.rule(rules, Vector<Atom>.asSlice(&visited)[edge.parent], &traversal, none)
    at = at + usize.ONE
  }
  let mut output = Vector<RetentionOutput>.make()
  at = usize.ZERO
  while at < input.length {
    let actual = input[at]
    let universal = Program.atom(rules)
    let unknown = Program.atom(rules)
    let caller = Program.atom(rules)
    let independent = Program.atom(rules)
    let promotion = Vector<Atom>.asSlice(&promoted)[at]
    let promotedInput: [Atom; 1] = [promotion]
    run Program.rule(rules, universal, &promotedInput, none)
    let present: [Atom; 1] = [actual.quality.present]
    if actual.initial == Sink.Universal { run Program.rule(rules, universal, &present, none) }
    if actual.initial == Sink.Unknown {
      let noPromotion: [Atom; 1] = [promotion]
      run Program.rule(rules, unknown, &present, &noPromotion)
    }
    let finalUniversal: [Atom; 1] = [universal]
    if actual.located && actual.knownField && actual.actualPoint {
      let lost: [Atom; 1] = [actual.quality.alternatives]
      // Exact and Stored share A=false; presence is already required by Universal.
      run Program.rule(rules, caller, &finalUniversal, &lost)
      let imprecise: [Atom; 2] = [universal, actual.quality.alternatives]
      run Program.rule(rules, independent, &imprecise, none)
    } else {
      run Program.rule(rules, independent, &finalUniversal, none)
    }
    run Vector<RetentionOutput>.append(&mut output, RetentionOutput {
      universal: universal, unknown: unknown, caller: caller, independentEscape: independent, storing: unknown})
    at = at + usize.ONE
  }
  return move output
}

pub struct CleanupInput {
  pub observed: Atom
  pub matchingHolder: Atom
  pub everything: Atom
  pub namedEmpty: Atom
  pub shares: Atom
}
pub struct CleanupOutput { pub interval: Atom, pub addStored: Atom, pub addAlternatives: Atom }

pub struct CaseProof { pub applicable: Atom, pub proved: Atom }
impl Copy for CaseProof {}

pub struct ParentInput {
  pub present: Atom
  pub seed: Atom
  pub eligible: Atom
}
impl Copy for ParentInput {}

/// Retained/declared parent snapshots use the same finite positive closure, with different
/// original gates. The retained caller supplies known && !stores && actual-count>1. Declared
/// routes additionally require same-operand edges and snapshot Exact on each admitted parent.
pub effect fn parents(rules: &mut Program, gate: Atom, inputs: &[ParentInput], edges: &[ParentEdge]) -> Vector<Atom>
! OutOfMemoryError ? &mut Allocator {
  let mut supported = Vector<Atom>.make()
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < inputs.length {
    let source = Program.atom(rules)
    let seed: [Atom; 4] = [gate, inputs[at].present, inputs[at].seed, inputs[at].eligible]
    run Program.rule(rules, source, &seed, none)
    run Vector<Atom>.append(&mut supported, source)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    if edge.child >= inputs.length || edge.parent >= inputs.length {
      CompilerBug.panic(b"source parent edge names an absent policy input")
    }
    let support: [Atom; 4] = [Vector<Atom>.asSlice(&supported)[edge.child], edge.applicable,
      inputs[edge.parent].present, inputs[edge.parent].eligible]
    run Program.rule(rules, Vector<Atom>.asSlice(&supported)[edge.parent], &support, none)
    at = at + usize.ONE
  }
  return move supported
}

/// A named finite region's statically authenticated source candidates. These indices mean
/// exact borrowed/region identity, not existence: each witness still requires present Exact.
pub struct SourceRequirement { pub candidates: Vector<usize> }

/// Complete-source release requires all present inputs Exact and at least one actual witness
/// for every named local region. Universal-only names and unknown domains never certify it.
pub effect fn completeSources(rules: &mut Program, gate: Atom, domainsKnown: bool,
  inputs: &[Quality], required: &[SourceRequirement]) -> Atom
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let result = Program.atom(rules)
  if !domainsKnown || required.length == usize.ZERO { return result }
  let mut exact = Vector<Atom>.make()
  let mut all = Vector<CaseProof>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    let present: [Atom; 1] = [inputs[at].present]
    let losses: [Atom; 2] = [inputs[at].stored, inputs[at].alternatives]
    let source = run conjunction(rules, &present, &losses)
    run Vector<Atom>.append(&mut exact, source)
    run Vector<CaseProof>.append(&mut all, CaseProof {applicable: inputs[at].present, proved: source})
    at = at + usize.ONE
  }
  let every = run allCases(rules, gate, Vector<CaseProof>.asSlice(&all))
  let mut conditions = Vector<Atom>.make()
  run Vector<Atom>.append(&mut conditions, every)
  at = usize.ZERO
  while at < required.length {
    let witness = Program.atom(rules)
    let candidates = Vector<usize>.asSlice(&required[at].candidates)
    let mut candidate = usize.ZERO
    while candidate < candidates.length {
      if candidates[candidate] >= inputs.length { CompilerBug.panic(b"complete source witness names an absent policy input") }
      let actual: [Atom; 1] = [Vector<Atom>.asSlice(&exact)[candidates[candidate]]]
      run Program.rule(rules, witness, &actual, none)
      candidate = candidate + usize.ONE
    }
    run Vector<Atom>.append(&mut conditions, witness)
    at = at + usize.ONE
  }
  run Program.rule(rules, result, Vector<Atom>.asSlice(&conditions), none)
  return result
}

/// A single physical occurrence is released only with positive coverage/presence and proof
/// for every possible history. Undefined case proof is a blocker, not a false case to omit.
pub effect fn allCases(rules: &mut Program, coverage: Atom, cases: &[CaseProof]) -> Atom
! OutOfMemoryError ? &mut Allocator {
  let present = Program.atom(rules)
  let blocked = Program.atom(rules)
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < cases.length {
    let active: [Atom; 1] = [cases[at].applicable]
    let unproved: [Atom; 1] = [cases[at].proved]
    run Program.rule(rules, present, &active, none)
    run Program.rule(rules, blocked, &active, &unproved)
    at = at + usize.ONE
  }
  let witnessed: [Atom; 2] = [coverage, present]
  let noBlocker: [Atom; 1] = [blocked]
  return run conjunction(rules, &witnessed, &noBlocker)
}

/// The owning cleanup phase supplies the original outer observation gates. Interval creation
/// and precision loss differ: nonempty matching names preserve quality even under everything.
pub effect fn cleanup(rules: &mut Program, input: &CleanupInput) -> CleanupOutput
! OutOfMemoryError ? &mut Allocator {
  let alternatives: [Atom; 3] = [input.everything, input.namedEmpty, input.shares]
  let matched = run disjunction(rules, &alternatives)
  let positive: [Atom; 3] = [input.observed, input.matchingHolder, matched]
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let interval = run conjunction(rules, &positive, none)
  let loses: [Atom; 2] = [interval, input.namedEmpty]
  let loss = run conjunction(rules, &loses, none)
  return CleanupOutput {interval: interval, addStored: loss, addAlternatives: loss}
}

pub effect fn conjunction(rules: &mut Program, positive: &[Atom], negative: &[Atom]) -> Atom
! OutOfMemoryError ? &mut Allocator {
  let atom = Program.atom(rules)
  run Program.rule(rules, atom, positive, negative)
  return atom
}

pub effect fn disjunction(rules: &mut Program, inputs: &[Atom]) -> Atom
! OutOfMemoryError ? &mut Allocator {
  let atom = Program.atom(rules)
  let empty = Vector<Atom>.make()
  let mut at = usize.ZERO
  while at < inputs.length {
    let source: [Atom; 1] = [inputs[at]]
    run Program.rule(rules, atom, &source, Vector<Atom>.asSlice(&empty))
    at = at + usize.ONE
  }
  return atom
}

/// One selected fact per original ordered guard plus its else arm. Negation belongs to the
/// same founded program; an unknown prior guard never becomes an eager false default.
effect fn ordered(rules: &mut Program, present: Atom, guards: &[Atom]) -> Vector<Atom>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector<Atom>.make()
  let mut prior = Vector<Atom>.make()
  let mut at = usize.ZERO
  while at < guards.length {
    let selected = Program.atom(rules)
    let gate: [Atom; 2] = [present, guards[at]]
    run Program.rule(rules, selected, &gate, Vector<Atom>.asSlice(&prior))
    run Vector<Atom>.append(&mut result, selected)
    run Vector<Atom>.append(&mut prior, guards[at])
    at = at + usize.ONE
  }
  let otherwise = Program.atom(rules)
  let gate: [Atom; 1] = [present]
  run Program.rule(rules, otherwise, &gate, Vector<Atom>.asSlice(&prior))
  run Vector<Atom>.append(&mut result, otherwise)
  return move result
}

pub struct NamingInput {
  pub present: Atom
  pub names: Atom
  pub unnamed: Atom
  pub operand: usize
}
impl Copy for NamingInput {}

/// A finite ordered observation state. Count saturates at two because the original guards ask
/// only empty, single or several. naming keeps MAX as an actual machine state, not a set member.
pub struct NamingState {
  pub naming: usize
  pub several: bool
  pub unnamed: bool
  pub count: usize
  pub active: Atom
}
impl Copy for NamingState {}

pub struct Naming {
  pub states: Vector<NamingState>
  pub several: Atom
  pub unnamed: Atom
  pub multiple: Atom
}

/// Scans stable physical occurrence/leaf positions once. Alternative paired histories are
/// represented by one input presence at that position; two authored uses remain two positions.
pub effect fn naming(rules: &mut Program, input: &[NamingInput]) -> Naming
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let initial = Program.atom(rules)
  run Program.fact(rules, initial)
  let mut current = Vector<NamingState>.make()
  run Vector<NamingState>.append(&mut current,
    NamingState {naming: usize.MAX, several: false, unnamed: false, count: usize.ZERO, active: initial})
  let mut position = usize.ZERO
  while position < input.length {
    let actual = input[position]
    let mut next = Vector<NamingState>.make()
    let states = Vector<NamingState>.asSlice(&current)
    let mut at = usize.ZERO
    while at < states.length {
      let state = states[at]
      let skip = run namingState(rules, &mut next, state.naming, state.several, state.unnamed, state.count)
      let before: [Atom; 1] = [state.active]
      let absent: [Atom; 1] = [actual.present]
      run Program.rule(rules, skip, &before, &absent)
      let mut count = state.count
      if count < 2 { count = count + usize.ONE }
      let mut selected = state.naming
      let mut several = state.several
      if selected == usize.MAX { selected = actual.operand }
      else if selected != actual.operand { several = true }
      let names = run namingState(rules, &mut next, selected, several, state.unnamed, count)
      let namesGate: [Atom; 3] = [state.active, actual.present, actual.names]
      run Program.rule(rules, names, &namesGate, none)
      let unnamed = run namingState(rules, &mut next, state.naming, state.several, true, count)
      let unnamedGate: [Atom; 3] = [state.active, actual.present, actual.unnamed]
      let notNamed: [Atom; 1] = [actual.names]
      run Program.rule(rules, unnamed, &unnamedGate, &notNamed)
      let unchanged = run namingState(rules, &mut next, state.naming, state.several, state.unnamed, count)
      let unchangedGate: [Atom; 2] = [state.active, actual.present]
      let notNameOrUnnamed: [Atom; 2] = [actual.names, actual.unnamed]
      run Program.rule(rules, unchanged, &unchangedGate, &notNameOrUnnamed)
      at = at + usize.ONE
    }
    current = move next
    position = position + usize.ONE
  }
  let several = Program.atom(rules)
  let unnamed = Program.atom(rules)
  let multiple = Program.atom(rules)
  let states = Vector<NamingState>.asSlice(&current)
  let mut at = usize.ZERO
  while at < states.length {
    let state = states[at]
    let from: [Atom; 1] = [state.active]
    if state.several { run Program.rule(rules, several, &from, none) }
    if state.unnamed { run Program.rule(rules, unnamed, &from, none) }
    if state.count > usize.ONE { run Program.rule(rules, multiple, &from, none) }
    at = at + usize.ONE
  }
  return Naming {states: move current, several: several, unnamed: unnamed, multiple: multiple}
}

impl Naming {
  pub effect fn operand(self: &Self, rules: &mut Program, operand: usize) -> Atom
  ! OutOfMemoryError ? &mut Allocator {
    let answer = Program.atom(rules)
    let empty = Vector<Atom>.make()
    let states = Vector<NamingState>.asSlice(&self.states)
    let mut at = usize.ZERO
    while at < states.length {
      if states[at].naming == operand {
        let from: [Atom; 1] = [states[at].active]
        run Program.rule(rules, answer, &from, Vector<Atom>.asSlice(&empty))
      }
      at = at + usize.ONE
    }
    return answer
  }
}

effect fn namingState(rules: &mut Program, states: &mut Vector<NamingState>, naming: usize,
  several: bool, unnamed: bool, count: usize) -> Atom ! OutOfMemoryError ? &mut Allocator {
  let existing = Vector<NamingState>.asSlice(states)
  let mut at = usize.ZERO
  while at < existing.length {
    let state = existing[at]
    if state.naming == naming && state.several == several && state.unnamed == unnamed && state.count == count { return state.active }
    at = at + usize.ONE
  }
  let active = Program.atom(rules)
  run Vector<NamingState>.append(states, NamingState {naming: naming, several: several, unnamed: unnamed, count: count, active: active})
  return active
}

test effect fn sourcePolicyPreservesMaxNamingOrderAndRealMultiplicity() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run namingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn namingClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = Program.make()
  let yes = Program.atom(&mut rules)
  let no = Program.atom(&mut rules)
  run Program.fact(&mut rules, yes)
  let unmatched = NamingInput {present: yes, names: yes, unnamed: no, operand: usize.MAX}
  let matched = NamingInput {present: yes, names: yes, unnamed: no, operand: usize.ZERO}
  let maxFirst: [NamingInput; 2] = [unmatched, matched]
  let maxLast: [NamingInput; 2] = [matched, unmatched]
  let repeated: [NamingInput; 2] = [matched, matched]
  let before = run naming(&mut rules, &maxFirst)
  let after = run naming(&mut rules, &maxLast)
  let twice = run naming(&mut rules, &repeated)
  let beforeZero = run Naming.operand(&before, &mut rules, usize.ZERO)
  let afterZero = run Naming.operand(&after, &mut rules, usize.ZERO)
  let solved = run Program.solve(&rules)
  run Testing.expect(Solution.truth(&solved, beforeZero) == Truth.True && Solution.truth(&solved, before.several) == Truth.False,
    "an unmatched first operand leaves the original MAX naming state available to the next operand")
  run Testing.expect(Solution.truth(&solved, afterZero) == Truth.True && Solution.truth(&solved, after.several) == Truth.True,
    "a later unmatched operand disagrees with an already selected operand")
  run Testing.expect(Solution.truth(&solved, twice.multiple) == Truth.True && Solution.truth(&solved, twice.several) == Truth.False,
    "two real equal-label occurrences remain multiple without becoming distinct naming labels")
  return ()
}

test effect fn sourcePolicyClosesParentsBeforeEffectsAndSeparatesCleanupLoss() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run retentionCleanupClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn retentionCleanupClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = Program.make()
  let yes = Program.atom(&mut rules)
  let no = Program.atom(&mut rules)
  run Program.fact(&mut rules, yes)
  let exact = Quality {present: yes, stored: no, alternatives: no}
  let children: [RetentionInput; 3] = [
    RetentionInput {quality: exact, initial: Sink.Universal, local: true, located: true, knownField: true, actualPoint: true},
    RetentionInput {quality: exact, initial: Sink.Unknown, local: true, located: false, knownField: true, actualPoint: true},
    RetentionInput {quality: exact, initial: Sink.Unknown, local: false, located: false, knownField: true, actualPoint: true}
  ]
  let parents: [ParentEdge; 2] = [ParentEdge {child: 0, parent: 1, applicable: yes}, ParentEdge {child: 1, parent: 2, applicable: yes}]
  let retained = run retention(&mut rules, &children, &parents)
  let named = run cleanup(&mut rules, &CleanupInput {observed: yes, matchingHolder: yes, everything: yes, namedEmpty: no, shares: no})
  let empty = run cleanup(&mut rules, &CleanupInput {observed: yes, matchingHolder: yes, everything: no, namedEmpty: yes, shares: no})
  let unobserved = run cleanup(&mut rules, &CleanupInput {observed: no, matchingHolder: yes, everything: yes, namedEmpty: yes, shares: yes})
  let solved = run Program.solve(&rules)
  let outputs = Vector<RetentionOutput>.asSlice(&retained)
  run Testing.expect(Solution.truth(&solved, outputs[0].caller) == Truth.True, "an actual located Exact source reaches the caller adapter")
  run Testing.expect(Solution.truth(&solved, outputs[1].universal) == Truth.True
    && Solution.truth(&solved, outputs[1].storing) == Truth.False
    && Solution.truth(&solved, outputs[1].caller) == Truth.False
    && Solution.truth(&solved, outputs[1].independentEscape) == Truth.True,
    "parent promotion discards provisional Unknown without manufacturing location")
  run Testing.expect(Solution.truth(&solved, outputs[2].storing) == Truth.True,
    "traversal of a nonlocal Unknown parent does not promote its classification")
  run Testing.expect(Solution.truth(&solved, named.interval) == Truth.True
    && Solution.truth(&solved, named.addStored) == Truth.False && Solution.truth(&solved, named.addAlternatives) == Truth.False,
    "everything admits nonempty cleanup intervals without degrading their quality")
  run Testing.expect(Solution.truth(&solved, empty.interval) == Truth.True
    && Solution.truth(&solved, empty.addStored) == Truth.True && Solution.truth(&solved, empty.addAlternatives) == Truth.True,
    "eligible empty-name cleanup adds both loss bits")
  run Testing.expect(Solution.truth(&solved, unobserved.interval) == Truth.False
    && Solution.truth(&solved, unobserved.addStored) == Truth.False,
    "empty names cannot bypass the outer observation gate")
  return ()
}

/// A structural per-loan observation version. Version edges follow operation order; they are
/// not CFG backedges. Only an incoming source's Q can carry a later loss across a real value edge.
pub struct Precision { pub stored: Atom, pub alternatives: Atom }
impl Copy for Precision {}

pub effect fn observe(rules: &mut Program, before: Precision, inputs: &[Quality]) -> Precision
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let stored = Program.atom(rules)
  let alternatives = Program.atom(rules)
  let oldStored: [Atom; 1] = [before.stored]
  let oldAlternatives: [Atom; 1] = [before.alternatives]
  run Program.rule(rules, stored, &oldStored, none)
  run Program.rule(rules, alternatives, &oldAlternatives, none)
  let mut at = usize.ZERO
  while at < inputs.length {
    let arrivingStored: [Atom; 2] = [inputs[at].present, inputs[at].stored]
    let arrivingAlternatives: [Atom; 2] = [inputs[at].present, inputs[at].alternatives]
    run Program.rule(rules, stored, &arrivingStored, none)
    run Program.rule(rules, alternatives, &arrivingAlternatives, none)
    at = at + usize.ONE
  }
  return Precision {stored: stored, alternatives: alternatives}
}

/// All alternative cases of one real position share `before`; their effects join into this
/// post-version. The next real position, even for the same loan ID, receives the returned version.
pub effect fn advance(rules: &mut Program, before: Precision, effects: &[Precision]) -> Precision
! OutOfMemoryError ? &mut Allocator {
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let stored = Program.atom(rules)
  let alternatives = Program.atom(rules)
  let oldStored: [Atom; 1] = [before.stored]
  let oldAlternatives: [Atom; 1] = [before.alternatives]
  run Program.rule(rules, stored, &oldStored, none)
  run Program.rule(rules, alternatives, &oldAlternatives, none)
  let mut at = usize.ZERO
  while at < effects.length {
    let addedStored: [Atom; 1] = [effects[at].stored]
    let addedAlternatives: [Atom; 1] = [effects[at].alternatives]
    run Program.rule(rules, stored, &addedStored, none)
    run Program.rule(rules, alternatives, &addedAlternatives, none)
    at = at + usize.ONE
  }
  return Precision {stored: stored, alternatives: alternatives}
}

test effect fn sourceResultCannotCertifyItsOwnCompleteDrop() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run completeDropClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn completeDropClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut rules = Program.make()
  let yes = Program.atom(&mut rules)
  let no = Program.atom(&mut rules)
  let complete = Program.atom(&mut rules)
  run Program.fact(&mut rules, yes)
  // A unique named input is retained exactly unless a prior complete-source guard drops it.
  // If that guard's only witness is this very output, neither eager outcome is justified.
  let input = ResultInput {quality: Quality {present: yes, stored: no, alternatives: no},
    stores: no, retained: yes, required: no, known: yes, outside: no, forwarded: no, local: yes,
    matched: no, outlivesResult: no, declared: no, body: yes, complete: complete, unneeded: yes,
    placedSeveral: no, namedSingle: yes, impliedKnown: no, ancestor: no, mayOutlive: no,
    alternatives: no, wholeField: yes, forwardingNone: yes, hasTyped: yes}
  let dependent = run result(&mut rules, &input)
  let mut witnessCandidates = Vector<usize>.make()
  run Vector<usize>.append(&mut witnessCandidates, 0)
  let mut required = Vector<SourceRequirement>.make()
  run Vector<SourceRequirement>.append(&mut required, SourceRequirement {candidates: move witnessCandidates})
  let feedback: [Quality; 1] = [Quality {present: dependent.kept,
    stored: dependent.addStored, alternatives: dependent.addAlternatives}]
  let witnessed = run completeSources(&mut rules, yes, true, &feedback, Vector<SourceRequirement>.asSlice(&required))
  let outputWitness: [Atom; 1] = [witnessed]
  let empty = Vector<Atom>.make()
  run Program.rule(&mut rules, complete, &outputWitness, Vector<Atom>.asSlice(&empty))
  let actual: [Quality; 1] = [Quality {present: yes, stored: no, alternatives: no}]
  let actualComplete = run completeSources(&mut rules, yes, true, &actual, Vector<SourceRequirement>.asSlice(&required))
  let absentSource: [Quality; 1] = [Quality {present: no, stored: no, alternatives: no}]
  let noWitness = run completeSources(&mut rules, yes, true, &absentSource, Vector<SourceRequirement>.asSlice(&required))
  let independentlyComplete = ResultInput {quality: Quality {present: yes, stored: no, alternatives: no},
    stores: no, retained: yes, required: no, known: yes, outside: no, forwarded: no, local: yes,
    matched: no, outlivesResult: no, declared: no, body: yes, complete: actualComplete, unneeded: yes,
    placedSeveral: no, namedSingle: yes, impliedKnown: no, ancestor: no, mayOutlive: no,
    alternatives: no, wholeField: yes, forwardingNone: yes, hasTyped: yes}
  let independent = run result(&mut rules, &independentlyComplete)
  let cases: [CaseProof; 2] = [CaseProof {applicable: yes, proved: yes},
    CaseProof {applicable: yes, proved: complete}]
  let release = run allCases(&mut rules, yes, &cases)
  let absent: [CaseProof; 1] = [CaseProof {applicable: no, proved: yes}]
  let emptyRelease = run allCases(&mut rules, yes, &absent)
  let safe: [CaseProof; 2] = [CaseProof {applicable: yes, proved: yes}, CaseProof {applicable: no, proved: no}]
  let provedRelease = run allCases(&mut rules, yes, &safe)
  let solved = run Program.solve(&rules)
  run Testing.expect(Solution.truth(&solved, dependent.kept) == Truth.Undefined
    && Solution.truth(&solved, complete) == Truth.Undefined,
    "a complete/drop cycle cannot erase its own only witness by selecting an arbitrary outcome")
  run Testing.expect(Solution.truth(&solved, dependent.addStored) == Truth.False
    && Solution.truth(&solved, dependent.addAlternatives) == Truth.False,
    "undefined presence does not fabricate Stored or Alternatives loss in an exact retention branch")
  run Testing.expect(Solution.truth(&solved, independent.kept) == Truth.False
    && Solution.truth(&solved, actualComplete) == Truth.True && Solution.truth(&solved, noWitness) == Truth.False,
    "an independently established complete-source guard still precedes unique-name retention")
  run Testing.expect(Solution.truth(&solved, release) == Truth.Undefined
    && Solution.truth(&solved, emptyRelease) == Truth.False
    && Solution.truth(&solved, provedRelease) == Truth.True,
    "all-case release needs a real witness and cannot discard an unresolved applicable history")
  return ()
}
