/// The catalog code that reports `code`; none for a compiler refusal, which is not a catalog
/// diagnostic.
pub fn catalogCode(code: RejectionCode) -> Option<Code> {
  return match code {
    RejectionCode.UnknownName => Option<Code>.some(Code.UnknownValueReference)
    RejectionCode.UnknownActor => Option<Code>.some(Code.UnknownActor)
    RejectionCode.UnknownFunction => Option<Code>.some(Code.UnknownFunction)
    RejectionCode.UnknownType => Option<Code>.some(Code.UnknownType)
    RejectionCode.MissingModule => Option<Code>.some(Code.UnknownModule)
    RejectionCode.SelfImport => Option<Code>.some(Code.SelfImport)
    RejectionCode.IdentityUnavailable => Option<Code>.none()
    RejectionCode.ProjectionOnNonStruct => Option<Code>.some(Code.ProjectionOnNonStruct)
    RejectionCode.InaccessibleProjectedField => Option<Code>.some(Code.InaccessibleProjectedField)
    RejectionCode.UnknownProjectedField => Option<Code>.some(Code.UnknownProjectedField)
    RejectionCode.UnknownUnionVariant => Option<Code>.some(Code.UnknownUnionVariant)
    RejectionCode.UnknownEnumMember => Option<Code>.some(Code.UnknownEnumMember)
    RejectionCode.UnknownOperation => Option<Code>.some(Code.UnknownActorOperation)
    RejectionCode.UnknownImportedMember => Option<Code>.some(Code.UnknownImportedMember)
    RejectionCode.OwnerArgumentPlacement => Option<Code>.some(Code.OwnerArgumentPlacement)
    RejectionCode.IntrinsicUnavailable => Option<Code>.none()
    RejectionCode.PrivateMember => Option<Code>.some(Code.InaccessibleImportedMember)
    RejectionCode.Collision => Option<Code>.some(Code.BindingConflict)
    RejectionCode.CyclicTypeAlias => Option<Code>.some(Code.CyclicTypeAlias)
