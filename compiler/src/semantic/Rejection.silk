      232 => Option<RejectionCode>.some(RejectionCode.AmbiguousConformanceMethod)
      233 => Option<RejectionCode>.some(RejectionCode.AmbiguousSuppliedOperation)
      234 => Option<RejectionCode>.some(RejectionCode.AssociatedFunctionOnValue)
      235 => Option<RejectionCode>.some(RejectionCode.FailOutsideEffect)
      236 => Option<RejectionCode>.some(RejectionCode.UndeclaredFailure)
      237 => Option<RejectionCode>.some(RejectionCode.RunNonEffect)
      238 => Option<RejectionCode>.some(RejectionCode.InvalidEffectHandler)
      239 => Option<RejectionCode>.some(RejectionCode.UnhandledFailure)
      240 => Option<RejectionCode>.some(RejectionCode.UnhandledRequirement)
      241 => Option<RejectionCode>.some(RejectionCode.MissingProvidedKey)
      242 => Option<RejectionCode>.some(RejectionCode.AmbiguousProvidedKey)
      243 => Option<RejectionCode>.some(RejectionCode.InsufficientProviderAccess)
      244 => Option<RejectionCode>.some(RejectionCode.ProviderSelectorCardinality)
      245 => Option<RejectionCode>.some(RejectionCode.MissingToken)
      246 => Option<RejectionCode>.some(RejectionCode.UnexpectedToken)
      247 => Option<RejectionCode>.some(RejectionCode.NestingLimit)
      248 => Option<RejectionCode>.some(RejectionCode.ReservedTemplateSyntax)
      249 => Option<RejectionCode>.some(RejectionCode.ReservedImportBinding)
      250 => Option<RejectionCode>.some(RejectionCode.LoopStatement)
      251 => Option<RejectionCode>.some(RejectionCode.OptionalTypeSyntax)
      252 => Option<RejectionCode>.some(RejectionCode.TupleTypeSyntax)
      253 => Option<RejectionCode>.some(RejectionCode.IfExpression)
      254 => Option<RejectionCode>.some(RejectionCode.ForeignSpelling)
      255 => Option<RejectionCode>.some(RejectionCode.LexicalUnsupportedBytes)
      256 => Option<RejectionCode>.some(RejectionCode.LexicalUnknownLiteralModifier)
      257 => Option<RejectionCode>.some(RejectionCode.LexicalUnterminatedStaticLiteral)
      258 => Option<RejectionCode>.some(RejectionCode.LexicalMissingBaseDigits)
      259 => Option<RejectionCode>.some(RejectionCode.LexicalInvalidDigitSeparator)
      260 => Option<RejectionCode>.some(RejectionCode.LexicalMissingExponentDigits)
      261 => Option<RejectionCode>.some(RejectionCode.LexicalCharacterLiteralScalarCount)
      262 => Option<RejectionCode>.some(RejectionCode.LexicalInvalidDurationAmount)
      263 => Option<RejectionCode>.some(RejectionCode.LexicalUnknownDurationUnit)
      264 => Option<RejectionCode>.some(RejectionCode.LexicalRepeatedDurationUnit)
      265 => Option<RejectionCode>.some(RejectionCode.LexicalOutOfOrderDurationUnit)
      266 => Option<RejectionCode>.some(RejectionCode.LexicalSubordinateDurationOutOfRange)
      267 => Option<RejectionCode>.some(RejectionCode.LexicalInvalidBaseDigit)
      268 => Option<RejectionCode>.some(RejectionCode.LexicalLiteralTypeSuffix)
      _ => Option<RejectionCode>.none()
    }
  }
  /// Returns an internal reason name, never a catalog code.
  pub fn name(code: RejectionCode) -> &'static [u8] {
    return match code {
      RejectionCode.UnknownName => b"UnknownName"
      RejectionCode.UnknownActor => b"UnknownActor"
