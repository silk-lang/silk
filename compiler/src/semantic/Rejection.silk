/// The stable spelling of `code`'s catalog code; empty for a compiler refusal.
pub fn stableCode(code: RejectionCode) -> &'static [u8] {
  return match move catalogCode(code) {
    Option<Code>.Some {value} => String.utf8Bytes(Catalog.spelling(value))
    Option<Code>.None => b""
  }
}
