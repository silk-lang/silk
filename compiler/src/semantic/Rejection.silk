/// The catalog code that reports `code`; none for a compiler refusal, which is not a catalog
/// diagnostic.
pub fn catalogCode(code: RejectionCode) -> Option<Code> {
  return match code {
    RejectionCode.UnknownName => Option<Code>.some(Code.UnknownValueReference)
    RejectionCode.UnknownActor => Option<Code>.some(Code.UnknownActor)
    RejectionCode.UnknownFunction => Option<Code>.some(Code.UnknownFunction)
    RejectionCode.UnknownType => Option<Code>.some(Code.UnknownType)
    RejectionCode.MissingModule => Option<Code>.some(Code.UnknownModule)
    RejectionCode.SelfImport => Option<Code>.some(Code.SelfImport)
    RejectionCode.InternalModule => Option<Code>.some(Code.InternalModule)
    RejectionCode.ReservedModule => Option<Code>.some(Code.ReservedModule)
    RejectionCode.AmbiguousModule => Option<Code>.some(Code.AmbiguousModule)
    RejectionCode.BarrelSpelling => Option<Code>.some(Code.BarrelSpelling)
    RejectionCode.IdentityUnavailable => Option<Code>.none()
    RejectionCode.ProjectionOnNonStruct => Option<Code>.some(Code.ProjectionOnNonStruct)
    RejectionCode.InaccessibleProjectedField => Option<Code>.some(Code.InaccessibleProjectedField)
    RejectionCode.UnknownProjectedField => Option<Code>.some(Code.UnknownProjectedField)
    RejectionCode.UnknownUnionVariant => Option<Code>.some(Code.UnknownUnionVariant)
    RejectionCode.UnknownEnumMember => Option<Code>.some(Code.UnknownEnumMember)
    RejectionCode.UnknownOperation => Option<Code>.some(Code.UnknownActorOperation)
    RejectionCode.UnknownImportedMember => Option<Code>.some(Code.UnknownImportedMember)
    RejectionCode.OwnerArgumentPlacement => Option<Code>.some(Code.OwnerArgumentPlacement)
    RejectionCode.IntrinsicUnavailable => Option<Code>.none()
    RejectionCode.PrivateMember => Option<Code>.some(Code.InaccessibleImportedMember)
    RejectionCode.Collision => Option<Code>.some(Code.BindingConflict)
    RejectionCode.CyclicTypeAlias => Option<Code>.some(Code.CyclicTypeAlias)
    RejectionCode.DuplicateFieldName => Option<Code>.some(Code.DuplicateFieldName)
    RejectionCode.DuplicateUnionVariant => Option<Code>.some(Code.DuplicateUnionVariant)
    RejectionCode.EmptyUnion => Option<Code>.some(Code.EmptyNominalUnion)
    RejectionCode.EmptyUnionVariant => Option<Code>.some(Code.EmptyUnionVariant)
    RejectionCode.RebindingName => Option<Code>.some(Code.RebindingName)
    RejectionCode.DuplicateParameterName => Option<Code>.some(Code.DuplicateParameterName)
    RejectionCode.DuplicateDeclarationName => Option<Code>.some(Code.DuplicateDeclarationName)
    RejectionCode.DuplicateConformanceMember => Option<Code>.some(Code.InvalidConformance)
    RejectionCode.Unsupported => Option<Code>.none()
    RejectionCode.UnavailableBinding => Option<Code>.none()
    RejectionCode.ProfileInputUnavailable => Option<Code>.none()
    RejectionCode.UnionFormUnavailable => Option<Code>.none()
    RejectionCode.ProviderSectionUnavailable => Option<Code>.none()
    RejectionCode.SectionResultInferenceUnavailable => Option<Code>.none()
    RejectionCode.EffectFormUnavailable => Option<Code>.none()
    RejectionCode.NestedEffectJoinUnavailable => Option<Code>.none()
    RejectionCode.InterfaceEffectUnavailable => Option<Code>.none()
    RejectionCode.BodyLifetimeElisionUnavailable => Option<Code>.none()
    RejectionCode.IntrinsicWitnessUnavailable => Option<Code>.none()
    RejectionCode.CallTargetUnavailable => Option<Code>.none()
    RejectionCode.MutableParameterUnavailable => Option<Code>.none()
    RejectionCode.InlineStorageUnavailable => Option<Code>.none()
    RejectionCode.InlineRecursiveAggregate => Option<Code>.some(Code.InlineRecursiveAggregate)
    RejectionCode.StaticPhaseViolation => Option<Code>.some(Code.StaticPhaseViolation)
    RejectionCode.StaticRecursionNotProven => Option<Code>.none()
    RejectionCode.UnknownOwnedCallableReturn => Option<Code>.some(Code.UnknownOwnedCallableReturn)
    RejectionCode.TypeMismatch => Option<Code>.some(Code.ArgumentTypeMismatch)
    RejectionCode.ContextualAggregateKindMismatch => Option<Code>.some(Code.ContextualAggregateKindMismatch)
    RejectionCode.EnumIntegerMismatch => Option<Code>.some(Code.EnumIntegerMismatch)
    RejectionCode.InaccessibleConstruction => Option<Code>.some(Code.InaccessibleStructConstruction)
    RejectionCode.MutableContractParameter => Option<Code>.some(Code.InvalidMutableParameter)
    RejectionCode.InvalidStaticLiteral => Option<Code>.some(Code.InvalidStaticLiteral)
    RejectionCode.CrossEnumEquality => Option<Code>.some(Code.CrossEnumEquality)
    RejectionCode.EnumOrdering => Option<Code>.some(Code.EnumOrdering)
    RejectionCode.IncompatibleUnionConversion => Option<Code>.some(Code.IncompatibleUnionConversion)
    RejectionCode.ImmutableAssignment => Option<Code>.some(Code.ImmutableAssignment)
    RejectionCode.InvalidAssignmentPlace => Option<Code>.some(Code.InvalidAssignmentPlace)
    RejectionCode.AssignmentTypeMismatch => Option<Code>.some(Code.AssignmentTypeMismatch)
    RejectionCode.StructFieldTypeMismatch => Option<Code>.some(Code.StructFieldTypeMismatch)
    RejectionCode.InvalidReferentProjection => Option<Code>.some(Code.InvalidReferentProjection)
    RejectionCode.ForeignEnumPattern => Option<Code>.some(Code.ForeignEnumPattern)
    RejectionCode.WrongEnumMember => Option<Code>.some(Code.WrongEnumMember)
    RejectionCode.MatchMemberNotInScrutinee => Option<Code>.some(Code.MatchMemberNotInScrutinee)
    RejectionCode.UninferredArrayElement => Option<Code>.some(Code.EmptyArrayNeedsContext)
    RejectionCode.ArrayElementMismatch => Option<Code>.some(Code.ArrayElementTypeMismatch)
    RejectionCode.ArrayLengthMismatch => Option<Code>.some(Code.ArrayLengthMismatch)
    RejectionCode.NotIndexable => Option<Code>.some(Code.IndexOnNonArray)
    RejectionCode.InvalidIndexType => Option<Code>.some(Code.IndexNotUsize)
    RejectionCode.IndexOutOfRange => Option<Code>.some(Code.IndexOutOfBounds)
    RejectionCode.UnsafeAcknowledgement => Option<Code>.some(Code.MissingUnsafeBoundary)
    RejectionCode.UnsafeInvocation => Option<Code>.some(Code.MisplacedUnsafeAcknowledgement)
    RejectionCode.ForeignSymbolConflict => Option<Code>.some(Code.ConflictingForeignSignature)
    RejectionCode.ExpandingSpecialization => Option<Code>.some(Code.PolymorphicRecursion)
    RejectionCode.ForeignCallback => Option<Code>.none()
    RejectionCode.ForeignFunctionNotFirstClass => Option<Code>.some(Code.ForeignFunctionNotFirstClass)
    RejectionCode.ForeignType => Option<Code>.some(Code.ForeignTypeNotAdmitted)
    RejectionCode.ForeignDeclarationRestriction => Option<Code>.some(Code.ForeignDeclarationRestriction)
