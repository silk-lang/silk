//! Anchored reasons for a completed semantic rejection.
//!
//! # When to use
//! Use [`Rejection`] when a demanded semantic fact has no valid answer. A rejected answer is
//! complete; an unfinished demand has no rejection yet.

import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {ModuleId}
import semantic.Specialization {Application}
import semantic.StaticExecution {Diagnostic as StaticDiagnostic}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// The kind of an explicit generic argument or its declared parameter.
pub enum GenericKind {
  /// An ordinary value type.
  Type,
  /// A validity lifetime.
  Lifetime,
  /// A complete requirement row.
  Requirement,
  /// A failure channel written in an argument list.
  Failure,
}

/// The stable reason for a demanded fact's rejection.
pub enum RejectionCode {
  /// A required name is absent.
  UnknownName,
  /// An imported module is absent.
  MissingModule,
  /// A selected or qualified member is absent.
  UnknownMember,
  /// A catalog-defined sealed runtime primitive is not implemented by selfhost yet.
  IntrinsicUnavailable,
  /// A member exists but is private to another module.
  PrivateMember,
  /// Several bindings claim the same name.
  Collision,
  /// The demanded syntax is outside the supported subset.
  Unsupported,
  /// A package value needs the profile input query, which this checking lane cannot consume yet.
  ProfileInputUnavailable,
  /// A valid structural or nominal union value needs deferred representation lowering.
  UnionFormUnavailable,
  /// A selected inherent method needs deferred bound callable capture.
  BoundMethodUnavailable,
  /// A pipeline target requires deferred interface-operation application.
  PipelineInterfaceUnavailable,
  /// Distinct caller-local slice regions need a deferred common-validity proof.
  SliceRegionRelationUnavailable,
  /// An ordinary borrow-region relation is deferred: repeated inferred references need a
  /// common-validity proof, or static String/covariant nominal storage needs a shorter lifetime.
  BorrowRegionRelationUnavailable,
  /// A section that leaves a `provides` selector to a later invocation needs deferred provider
  /// selection.
  ProviderSectionUnavailable,
  /// A section leaves a binder that only its result mentions, which needs inference from the
  /// expected callable contract.
  SectionResultInferenceUnavailable,
  /// Effect construction or execution needs the deferred Step 9 checking/lowering lane.
  EffectFormUnavailable,
  /// An Effect join whose arm or return already holds several alternatives needs per-alternative
  /// re-injection into the wider join.
  NestedEffectJoinUnavailable,
  /// Constructing an interface operation's Effect needs the witness construction.
  InterfaceEffectUnavailable,
  /// Reached `Intrinsic.suspendEffect` or `Intrinsic.park` needs the deferred suspension stage.
  SuspensionUnavailable,
  /// A catalog `Intrinsic` type family outside the storage core, such as `Intrinsic.Execution`, is not
  /// implemented yet.
  CoreTypeUnavailable,
  /// A body-local type argument omits a lifetime that no described value supplies in this lane yet,
  /// such as an explicit call-site generic argument or a constructor reached through an alias.
  BodyLifetimeElisionUnavailable,
  /// An interface witness maps directly to a sealed intrinsic target not admitted yet.
  IntrinsicWitnessUnavailable,
  /// A nested or aggregate invocation lacks a collected call-target fact.
  CallTargetUnavailable,
  /// A nominal variant nested in a structural union needs pattern lowering.
  NestedUnionPatternUnavailable,
  /// A mutable value parameter needs the parameter-binding follow-up.
  MutableParameterUnavailable,
  /// A moving scalar-enum match needs its ownership-mode follow-up.
  ScalarEnumMovingMatchUnavailable,
  /// Inline stored-property recursion has no admitted finite descent.
  InlineStorageUnavailable,
  /// A static function attempts an operation unavailable during static evaluation.
  StaticPhaseViolation,
  /// A changing-static specialization chain did not close within its node budget; it is neither
  /// admitted nor diagnosed as infinite.
  StaticRecursionNotProven,
  /// A raw nonshared callable parameter has no concrete returned value identity (SEM0081).
  UnknownOwnedCallableReturn,
  /// A checked value does not have the required type.
  TypeMismatch,
  /// An empty array literal has no immediate element context.
  UninferredArrayElement,
  /// An array element has a different type from the selected element type.
  ArrayElementMismatch,
  /// A contextual array literal has a different logical length.
  ArrayLengthMismatch,
  /// An indexed subject is neither a fixed array nor a slice.
  NotIndexable,
  /// An index is not a checked usize value.
  InvalidIndexType,
  /// A known index is outside its fixed logical length.
  IndexOutOfRange,
  /// An unsafe operation requires an explicit lexical acknowledgement.
  UnsafeAcknowledgement,
  /// An unsafe prefix does not select one invocation with an unsafe obligation.
  UnsafeInvocation,
  /// One native symbol has conflicting reached C signatures.
  ForeignSymbolConflict,
  /// Distinct reached instances produced the same content symbol.
  InstanceSymbolConflict,
  /// A direct call path changes a recursive function's runtime arguments.
  ExpandingSpecialization,
  /// A reached C signature passes an aggregate by value.
  ForeignAggregate,
  /// A reached C signature requires a callback.
  ForeignCallback,
  /// A foreign function cannot form a source callable value or section (bootstrap SEM0189).
  ForeignFunctionNotFirstClass,
  /// A reached foreign signature uses a type excluded by closed C ABI admission.
  ForeignType,
  /// A reached C call needs deferred variadic ABI classification.
  ForeignVariadic,
  /// Reading reached foreign static storage requires deferred symbol-address lowering.
  ForeignStaticUnavailable,
  /// An ordinary conditional uses a value other than `bool`.
  ConditionNotBool,
  /// A scalar enum match leaves at least one member uncovered.
  MissingEnumMember,
  /// A structural-union or record match leaves at least one member uncovered.
  MissingUnionMember,
  /// An unguarded member pattern repeats an earlier covered member.
  DuplicateMatchPattern,
  /// Reachable match arms produce distinct result types, such as a completing block arm's `()` and
  /// an `i32` arm (the bootstrap's `SEM0049`).
  IncompatibleMatchResults,
  /// A bare `match value` names an affine scrutinee; it must state `move`, `&` or `&mut` (the
  /// bootstrap's `OWN0003`).
  ExplicitMoveRequired,
  /// A `move`, `drop` or by-value receiver would extract a place behind a reference or at a runtime
  /// index, where no hole may be left (the bootstrap's `OWN0002`).
  ExtractionBoundary,
  /// A `move`, `drop` or by-value receiver would move a non-Copy value out through a reference (the
  /// bootstrap's `OWN0012`).
  BorrowedExtraction,
  /// A `move`, `drop` or by-value receiver would move a non-Copy binding of a `match &` or
  /// `match &mut` out of its arm (the bootstrap's `OWN0006`).
  MatchBorrowEscape,
  /// A guard consumes provisional ownership before its pattern is committed (bootstrap OWN0008).
  GuardConsumesPattern,
  /// A captured place is unavailable after an explicit consumption (bootstrap OWN0001).
  UseAfterMove,
  /// A repeating loop edge changes owner liveness (bootstrap OWN0005).
  IncompatibleLoopHeader,
  /// A replacement consumes overlapping target storage in its RHS (bootstrap OWN0004).
  OverlappingAssignment,
  /// Capture availability needs a deferred guard or dynamic-place ownership proof.
  CaptureAvailabilityUnavailable,
  /// A local invocation region cannot satisfy a written static bound (bootstrap SEM0212).
  UnsatisfiedLifetimeBound,
  /// `break` or `continue` appears outside every enclosing loop (the bootstrap's `SEM0038`).
  TransferOutsideLoop,
  /// An integer scrutinee's match leaves values uncovered without a universal arm (the bootstrap's
  /// `SEM0044`).
  IncompleteMatch,
  /// An integer literal pattern names a value of a scalar enum scrutinee (the bootstrap's `SEM0162`).
  IntegerPatternOnEnum,
  /// `&mut` names a place that is not mutable (the bootstrap's `SEM0057`).
  ExclusiveBorrowRequiresMutable,
  /// A record pattern names a field twice, names a non-field, or omits fields without `..`.
  InvalidRecordPattern,
  /// An unconditional `let` pattern can fail to match its initializer (the bootstrap's `SEM0133`).
  RefutableBinding,
  /// `let _ = value` discards a result; intentional discard is `drop value` (the bootstrap's
  /// `SEM0087`).
  ExplicitDiscard,
  /// A match arm follows an unguarded universal arm.
  MatchArmAfterUniversal,
  /// Earlier unguarded arms already cover every value this arm could select.
  UnreachableMatchArm,
  /// An ordinary call supplies an invalid number of arguments.
  CallArity,
  /// A mutable callable is invoked through an immutable binding (bootstrap SEM0077).
  InvalidCallableInvocationAccess,
  /// A callable argument cannot satisfy its promised invocation contract (bootstrap SEM0076).
  IncompatibleCallableSignature,
  /// Callable representation evidence cannot solve a generic call (bootstrap SEM0052).
  TypeArgumentInference,
  /// A called expression does not identify a callable declaration.
  NotCallable,
  /// An empty call cannot invoke a function that requires arguments.
  RedundantCall,
  /// An exact integer literal is outside its selected integer type on this target.
  IntegerOutOfRange,
  /// A reachable function exit does not return its declared non-unit result.
  MissingReturn,
  /// An alias, import-name, or constant-initializer path repeats an unfinished query. Each member
  /// of the cycle is rejected at its own reference to the next member.
  Cycle,
  /// The requested identity is not a type declaration.
  NotType,
  /// A public contract exposes a private nominal type.
  PrivateTypeExposure,
  /// Two binders in one declaration use the same name.
  DuplicateTypeParameter,
  /// A declared type supplies a different number of generic arguments.
  TypeArity,
  /// An explicit generic argument has a different kind from its binder.
  TypeArgumentKind,
  /// A call leaves a declaration-owned generic parameter without operand or constraint evidence.
  UninferredParameter,
  /// `typeof` does not name one fully specialized visible callable item.
  InvalidExactRepresentation,
  /// A `some` result has no valid single executable representation binder and use contract.
  InvalidOpaqueResult,
  /// A returned construction does not satisfy its producer's result contract (SEM0129).
  ReturnTypeMismatch,
  /// Reachable returns establish distinct exact representations (SEM0113).
  DivergentOpaqueRealization,
  /// A recursive opaque forwarding component has no concrete construction (SEM0114).
  OpaqueRealizationCycle,
  /// The realized inline capture graph contains its own opaque family (SEM0115).
  InlineOpaqueLayoutCycle,
  /// Reachable returns establish no representation evidence (SEM0117).
  MissingOpaqueRealization,
  /// A written lifetime does not name a visible binder or `'static`.
  UnknownLifetime,
  /// A lifetime binder or lifetime position has an invalid written form.
  InvalidLifetime,
  /// Two lifetime binders in one declaration have the same name.
  DuplicateLifetimeParameter,
  /// An omitted result lifetime has no unique input relationship.
  AmbiguousLifetime,
  /// A raw pointer qualifier is unknown or has an invalid value.
  InvalidPointerQualifier,
  /// A requirement entry is not a service, or its `at` role is not a role declaration.
  InvalidRequirement,
  /// A generic bound is neither an interface, a service, a callable contract, nor an Effect contract;
  /// or a conformance names neither an interface, a service, nor a sealed language property.
  InvalidBound,
  /// One parameter repeats the same bound application.
  DuplicateBound,
  /// An ordinary function writes an Effect failure or requirement channel.
  EffectChannelOnOrdinary,
  /// A structural union member is a borrow or bare callable or Effect contract.
  InvalidUnionMember,
  /// A quantified callable contract appears inside another invocation-quantified contract.
  NestedQuantifier,
  /// A constant lacks a written type, has a type outside the primitive constant contract, or has an
  /// initializer literal that does not produce exactly that type.
  InvalidConstant,
  /// A static operation or value is unavailable at the selected source site.
  StaticViolation,
  /// A reached `compileError` intentionally rejects this static demand.
  SelectedCompileError,
  /// A selected static application repeats an active semantic call key.
  StaticEvaluationCycle,
  /// A selected static demand exhausted its work budget.
  StaticStepLimit,
  /// A selected static demand exceeded its call-depth budget.
  StaticDepthLimit,
  /// A selected static demand exceeded its retained-value budget.
  StaticValueLimit,
  /// A package parameter lacks a concrete annotation, or a private parameter lacks a default.
  InvalidParameterSchema,
  /// A package parameter was demanded outside the request's explicit registration set.
  UnregisteredParameter,
  /// A package parameter is declared inside a module-level `static if` arm.
  ConditionalParameter,
  /// A demanded scalar enum has no members.
  EmptyEnum,
  /// A scalar enum selected a type other than one fixed-width integer representation.
  InvalidEnumRepresentation,
  /// The later of two enum members with one name or representation value.
  DuplicateEnumMember,
  DuplicateEnumDiscriminant,
  /// An explicit decimal discriminant exceeds its selected representation.
  EnumDiscriminantOutOfRange,
  /// An implicit successor exceeds its selected representation.
  EnumImplicitOverflow,
  /// An unsigned scalar enum writes a negative discriminant.
  UnsignedEnumNegative,
  /// An interface or service member is not a bodiless operation, or writes its own visibility.
  InvalidContractMember,
  /// An operator marker is outside the closed eager table, has the wrong arity, or belongs to a service.
  InvalidOperatorContract,
  /// Neither a closed concrete contract nor a visible marked interface operation accepts the operands.
  MissingOperator,
  /// More than one marked interface operation accepts the same precise operand types.
  AmbiguousOperator,
  /// A conformance provider is not a nominal, scalar, or `string` type.
  InvalidProvider,
  /// A conformance is declared outside every module permitted to own it.
  ConformanceOwner,
  /// An inherent `impl` head does not name a nominal declaration of its own module applied to
  /// exactly the implementation's unbounded binders: a foreign, alias, specialized, or bounded head.
  InvalidInherentHead,
  /// An inherent member is a mapping or a Drop hook, or reuses the name of one of its owner's
  /// fields, variants, enum members, generated operations, or contract operations.
  InvalidInherentMember,
  /// An `impl Copy` names an ineligible provider: an always-Copy scalar enum, an applicable own
  /// Drop hook, an affine stored field, or an unavailable recursive stored-type proof.
  InvalidCopyConformance,
  /// An `impl Drop` names a provider that cannot admit a Drop hook, such as a scalar enum.
  InvalidDropImplementation,
  /// A conformance member is missing, names no contract operation, or does not satisfy the
  /// substituted operation it implements. `witness` names the first failing component.
  IncompatibleWitness,
  /// Two unbounded conformances have the same head up to parameter names, lifetimes included.
  /// `path` holds the primary declaration, then the related one.
  DuplicateConformance,
  /// Some substitution makes two conformance heads name one goal once lifetimes are erased; bounds
  /// never make them distinct. `path` holds the primary declaration, then the related one.
  OverlappingConformance,
  /// An `impl` parameter occurs in neither its interface application nor its provider.
  UnconstrainedImplParameter,
  /// A conformance bound could keep proof from descending through the provider; `termination`
  /// names the step.
  NonterminatingConformance,
  /// No coherent concrete or declared evidence discharges the requested interface or service goal.
  MissingConformance,
  /// More than one declared bound supplies a receiver operation of this name (INTF-007).
  AmbiguousBoundMethod,
  /// More than one visible concrete conformance supplies a receiver operation of this name
  /// (INTF-007), or an unapplied qualified call's provider conforms to more than one application
  /// of its interface (INTF-006).
  AmbiguousConformanceMethod,
  /// A value named an associated function that has no receiver operand (CALL-003).
  AssociatedFunctionOnValue,
  /// `fail` appears in a body with no typed-failure channel (bootstrap SEM0063).
  FailOutsideEffect,
  /// A `fail` value is not a member of the body's declared failure type (bootstrap SEM0064).
  UndeclaredFailure,
  /// `run` names a value that is not an Effect (bootstrap SEM0065).
  RunNonEffect,
  /// A recovery handler does not accept a nonempty subset of the protected failures (bootstrap SEM0067).
  InvalidEffectHandler,
  /// A `run` leaves failures outside the surrounding failure channel (bootstrap SEM0066).
  UnhandledFailure,
  /// A `run` leaves requirements outside the surrounding requirement row (bootstrap SEM0071).
  UnhandledRequirement,
  /// A provision's selected service-role key is absent from its source row, or the provider
  /// conforms to no key the source row contains (SERV-007, bootstrap SEM0123).
  MissingProvidedKey,
  /// More than one source-row key is compatible with an inferred provision selector (SERV-007,
  /// bootstrap SEM0125).
  AmbiguousProvidedKey,
  /// A shared provider borrow cannot satisfy the exclusive entry its provision selects (SERV-006,
  /// bootstrap SEM0131).
  InsufficientProviderAccess,
  /// A provision selector names other than exactly one service-role key (SERV-007, bootstrap
  /// SEM0126).
  ProviderSelectorCardinality,
}

/// Why a conditional conformance bound could keep proof from descending.
pub enum TerminationStep {
  /// The bound's provider is not a strict structural part of the conformance provider.
  Peer,
  /// The bound repeats an open parameter more often than the conformance head does.
  DuplicatedParameter,
  /// The bound rewrites a ground argument of the same interface.
  ChangedFixedArgument,
}

/// The first component of a substituted contract operation that a conformance fails to supply.
pub union WitnessProblem {
  /// No member implements the operation.
  Missing,
  /// The member names no operation of the contract.
  Unknown,
  /// A scalar or `string` conformance maps the operation to a source function instead of
  /// defining it inline.
  ScalarMapping,
  /// An ordinary function implements an `effect fn` operation, or the reverse.
  Kind,
  /// An `unsafe` function implements a safe operation.
  Safety,
  /// The implementation takes a different number of operands.
  OperandCount,
  /// The operand at this position demands stronger access, or consumes a borrowed operand.
  OperandAccess {pub operand: usize},
  /// The operand at this position is a slice where a reference is promised, or the reverse.
  OperandShape {pub operand: usize},
  /// The operand at this position has a different type or region.
  OperandType {pub operand: usize},
  /// The result type differs.
  ResultType,
  /// A failure lies outside the promised failure type.
  Failure,
  /// A requirement's service-role key is not promised.
  Requirement,
  /// A requirement needs exclusive access where only shared access is promised.
  RequirementAccess,
  /// A requirement row parameter is not promised.
  RequirementParameter,
  /// The implementation's Effect environment is not known to cover the promised one.
  Environment,
}

impl Copy for WitnessProblem {}

/// A semantic diagnostic anchored in the held source bytes.
/// A source location related to a rejection, in its own module.
pub struct RelatedSite {
  pub module: ModuleId
  pub span: Span
}

pub struct Rejection {
  /// The stable reason for rejection.
  pub code: RejectionCode
  /// The module that contains the rejected use.
  pub module: ModuleId
  /// The half-open byte span of that use.
  pub span: Span
  /// Earlier source location for a duplicate enum name or discriminant; for a changing-static
  /// closure refusal, the edge that opened the closure transaction, in whichever module it is.
  pub related: Option<RelatedSite>
  /// For a cycle, the member declarations in demand order, starting and ending with the member
  /// whose answer this is; for a duplicate inherent member, the other declaration; for a
  /// conflicting conformance, the primary declaration and then the related one; empty for other
  /// errors.
  pub path: Vector<Shared<DeclarationId>>
  /// Expected argument count for `TypeArity`; zero for other reasons.
  pub expected: usize
  /// Supplied argument count for `TypeArity`; zero for other reasons.
  pub supplied: usize
  /// The parameter named by `TypeArgumentKind`; empty for other reasons or a row suffix.
  pub parameterName: Bytes
  /// The parameter kind required by `TypeArgumentKind`; meaningful only for that reason.
  pub expectedKind: GenericKind
  /// The written argument kind supplied for `TypeArgumentKind`; meaningful only for that reason.
  pub suppliedKind: GenericKind
  /// The failing component for `IncompatibleWitness`; absent for other reasons.
  pub witness: Option<WitnessProblem>
  /// The step named by `NonterminatingConformance`; meaningful only for that reason.
  pub termination: TerminationStep
  /// Complete static-phase fault, including authored origin and ordered specialization trace.
  pub staticFailure: Option<StaticDiagnostic>
  /// Ordered application path for ExpandingSpecialization, including the rejected request.
  pub specialization: Vector<Application>
}

impl Rejection {
  /// Returns the stable diagnostic code spelling used by build reports.
  pub fn name(code: RejectionCode) -> &'static [u8] {
    return match code {
      RejectionCode.UnknownName => b"UnknownName"
      RejectionCode.MissingModule => b"MissingModule"
      RejectionCode.UnknownMember => b"UnknownMember"
      RejectionCode.IntrinsicUnavailable => b"IntrinsicUnavailable"
      RejectionCode.PrivateMember => b"PrivateMember"
      RejectionCode.Collision => b"Collision"
      RejectionCode.Unsupported => b"Unsupported"
      RejectionCode.UnionFormUnavailable => b"UnionFormUnavailable"
      RejectionCode.BoundMethodUnavailable => b"BoundMethodUnavailable"
      RejectionCode.PipelineInterfaceUnavailable => b"PipelineInterfaceUnavailable"
      RejectionCode.SliceRegionRelationUnavailable => b"SliceRegionRelationUnavailable"
      RejectionCode.BorrowRegionRelationUnavailable => b"BorrowRegionRelationUnavailable"
      RejectionCode.ProviderSectionUnavailable => b"ProviderSectionUnavailable"
      RejectionCode.SectionResultInferenceUnavailable => b"SectionResultInferenceUnavailable"
      RejectionCode.EffectFormUnavailable => b"EffectFormUnavailable"
      RejectionCode.NestedEffectJoinUnavailable => b"NestedEffectJoinUnavailable"
      RejectionCode.InterfaceEffectUnavailable => b"InterfaceEffectUnavailable"
      RejectionCode.SuspensionUnavailable => b"SuspensionUnavailable"
      RejectionCode.CoreTypeUnavailable => b"CoreTypeUnavailable"
      RejectionCode.BodyLifetimeElisionUnavailable => b"BodyLifetimeElisionUnavailable"
      RejectionCode.IntrinsicWitnessUnavailable => b"IntrinsicWitnessUnavailable"
      RejectionCode.CallTargetUnavailable => b"CallTargetUnavailable"
      RejectionCode.NestedUnionPatternUnavailable => b"NestedUnionPatternUnavailable"
      RejectionCode.MutableParameterUnavailable => b"MutableParameterUnavailable"
      RejectionCode.ScalarEnumMovingMatchUnavailable => b"ScalarEnumMovingMatchUnavailable"
      RejectionCode.InlineStorageUnavailable => b"InlineStorageUnavailable"
      RejectionCode.ProfileInputUnavailable => b"ProfileInputUnavailable"
      RejectionCode.StaticPhaseViolation => b"StaticPhaseViolation"
      RejectionCode.StaticRecursionNotProven => b"StaticRecursionNotProven"
      RejectionCode.UnknownOwnedCallableReturn => b"UnknownOwnedCallableReturn"
      RejectionCode.TypeMismatch => b"TypeMismatch"
      RejectionCode.UninferredArrayElement => b"UninferredArrayElement"
      RejectionCode.ArrayElementMismatch => b"ArrayElementMismatch"
      RejectionCode.ArrayLengthMismatch => b"ArrayLengthMismatch"
      RejectionCode.NotIndexable => b"NotIndexable"
      RejectionCode.InvalidIndexType => b"InvalidIndexType"
      RejectionCode.IndexOutOfRange => b"IndexOutOfRange"
      RejectionCode.UnsafeAcknowledgement => b"UnsafeAcknowledgement"
      RejectionCode.UnsafeInvocation => b"UnsafeInvocation"
      RejectionCode.ConditionNotBool => b"ConditionNotBool"
      RejectionCode.MissingEnumMember => b"MissingEnumMember"
      RejectionCode.MissingUnionMember => b"MissingUnionMember"
      RejectionCode.DuplicateMatchPattern => b"DuplicateMatchPattern"
      RejectionCode.IncompatibleMatchResults => b"IncompatibleMatchResults"
      RejectionCode.ExplicitMoveRequired => b"ExplicitMoveRequired"
      RejectionCode.ExtractionBoundary => b"ExtractionBoundary"
      RejectionCode.BorrowedExtraction => b"BorrowedExtraction"
      RejectionCode.MatchBorrowEscape => b"MatchBorrowEscape"
      RejectionCode.GuardConsumesPattern => b"GuardConsumesPattern"
      RejectionCode.UseAfterMove => b"UseAfterMove"
      RejectionCode.IncompatibleLoopHeader => b"IncompatibleLoopHeader"
      RejectionCode.OverlappingAssignment => b"OverlappingAssignment"
      RejectionCode.CaptureAvailabilityUnavailable => b"CaptureAvailabilityUnavailable"
      RejectionCode.UnsatisfiedLifetimeBound => b"UnsatisfiedLifetimeBound"
      RejectionCode.TransferOutsideLoop => b"TransferOutsideLoop"
      RejectionCode.IncompleteMatch => b"IncompleteMatch"
      RejectionCode.IntegerPatternOnEnum => b"IntegerPatternOnEnum"
      RejectionCode.ExclusiveBorrowRequiresMutable => b"ExclusiveBorrowRequiresMutable"
      RejectionCode.InvalidRecordPattern => b"InvalidRecordPattern"
      RejectionCode.RefutableBinding => b"RefutableBinding"
      RejectionCode.ExplicitDiscard => b"ExplicitDiscard"
      RejectionCode.MatchArmAfterUniversal => b"MatchArmAfterUniversal"
      RejectionCode.UnreachableMatchArm => b"UnreachableMatchArm"
      RejectionCode.CallArity => b"CallArity"
      RejectionCode.InvalidCallableInvocationAccess => b"InvalidCallableInvocationAccess"
      RejectionCode.IncompatibleCallableSignature => b"IncompatibleCallableSignature"
      RejectionCode.TypeArgumentInference => b"TypeArgumentInference"
      RejectionCode.NotCallable => b"NotCallable"
      RejectionCode.RedundantCall => b"RedundantCall"
      RejectionCode.IntegerOutOfRange => b"IntegerOutOfRange"
      RejectionCode.MissingReturn => b"MissingReturn"
      RejectionCode.Cycle => b"Cycle"
      RejectionCode.NotType => b"NotType"
      RejectionCode.PrivateTypeExposure => b"PrivateTypeExposure"
      RejectionCode.DuplicateTypeParameter => b"DuplicateTypeParameter"
      RejectionCode.TypeArity => b"TypeArity"
      RejectionCode.TypeArgumentKind => b"TypeArgumentKind"
      RejectionCode.UninferredParameter => b"UninferredParameter"
      RejectionCode.InvalidExactRepresentation => b"InvalidExactRepresentation"
      RejectionCode.InvalidOpaqueResult => b"InvalidOpaqueResult"
      RejectionCode.ReturnTypeMismatch => b"ReturnTypeMismatch"
      RejectionCode.DivergentOpaqueRealization => b"DivergentOpaqueRealization"
      RejectionCode.OpaqueRealizationCycle => b"OpaqueRealizationCycle"
      RejectionCode.InlineOpaqueLayoutCycle => b"InlineOpaqueLayoutCycle"
      RejectionCode.MissingOpaqueRealization => b"MissingOpaqueRealization"
      RejectionCode.UnknownLifetime => b"UnknownLifetime"
      RejectionCode.InvalidLifetime => b"InvalidLifetime"
      RejectionCode.DuplicateLifetimeParameter => b"DuplicateLifetimeParameter"
      RejectionCode.AmbiguousLifetime => b"AmbiguousLifetime"
      RejectionCode.InvalidPointerQualifier => b"InvalidPointerQualifier"
      RejectionCode.InvalidRequirement => b"InvalidRequirement"
      RejectionCode.InvalidBound => b"InvalidBound"
      RejectionCode.DuplicateBound => b"DuplicateBound"
      RejectionCode.EffectChannelOnOrdinary => b"EffectChannelOnOrdinary"
      RejectionCode.InvalidUnionMember => b"InvalidUnionMember"
      RejectionCode.NestedQuantifier => b"NestedQuantifier"
      RejectionCode.InvalidConstant => b"InvalidConstant"
      RejectionCode.StaticViolation => b"StaticViolation"
      RejectionCode.SelectedCompileError => b"SelectedCompileError"
      RejectionCode.StaticEvaluationCycle => b"StaticEvaluationCycle"
      RejectionCode.StaticStepLimit => b"StaticStepLimit"
      RejectionCode.StaticDepthLimit => b"StaticDepthLimit"
      RejectionCode.StaticValueLimit => b"StaticValueLimit"
      RejectionCode.InvalidParameterSchema => b"InvalidParameterSchema"
      RejectionCode.ConditionalParameter => b"ConditionalParameter"
      RejectionCode.UnregisteredParameter => b"UnregisteredParameter"
      RejectionCode.EmptyEnum => b"EmptyEnum"
      RejectionCode.InvalidEnumRepresentation => b"InvalidEnumRepresentation"
      RejectionCode.DuplicateEnumMember => b"DuplicateEnumMember"
      RejectionCode.DuplicateEnumDiscriminant => b"DuplicateEnumDiscriminant"
      RejectionCode.EnumDiscriminantOutOfRange => b"EnumDiscriminantOutOfRange"
      RejectionCode.EnumImplicitOverflow => b"EnumImplicitOverflow"
      RejectionCode.UnsignedEnumNegative => b"UnsignedEnumNegative"
      RejectionCode.InvalidContractMember => b"InvalidContractMember"
      RejectionCode.InvalidOperatorContract => b"InvalidOperatorContract"
      RejectionCode.MissingOperator => b"MissingOperator"
      RejectionCode.AmbiguousOperator => b"AmbiguousOperator"
      RejectionCode.InvalidProvider => b"InvalidProvider"
      RejectionCode.ConformanceOwner => b"ConformanceOwner"
      RejectionCode.InvalidInherentHead => b"InvalidInherentHead"
      RejectionCode.InvalidInherentMember => b"InvalidInherentMember"
