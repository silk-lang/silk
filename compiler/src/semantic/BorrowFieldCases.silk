//! Authenticated field descriptors disappear into ordinary shared runtime projections.

import semantic.Types {TypeTable, Types}
import hir.Hir {Access}
import backend.Mir {Block, MirFunction, Operand, Terminator}
import semantic.Intrinsic {Primitive, isPrimitive}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Rejection {RejectionCode}
import semantic.Semantic {Answer, Request, Semantic}
import semantic.SemanticCaseSupport {answerCarries, checkedBody, hasBorrowStatus, makeSemantic, module, present, rejectionCode, rejectsSpan, selectedMirIndex, selectedApplicationOf, specializationWithArguments, namedMirApplication, succeeded}
import semantic.SourceIndex {NoRejection, RevisionMismatch, SourceIndex}
import semantic.Specialization {Application, StaticSlot}
import semantic.Type {Argument}
import semantic.Lifetime {Lifetime}
import semantic.DeclarationId {DeclarationId}
import semantic.SourceRevision {Revision}
import semantic.TypedBody {BorrowStatus, Expression, NodeKind, TypedBody}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize
import silk.collections.list {List}
import semantic.Type {Type}

fn ordinaryReflectedProjections(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut first = false
  let mut second = false
  let mut shared = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {form, ..} = &nodes[at].kind {
      if let Expression.Field {index, ..} = &form {
        first = first || index == usize.ZERO
        second = second || index == usize.ONE
      } else if let Expression.Borrow {access, ..} = &form {
        if access == Access.Shared {shared = shared + usize.ONE}
      } else if let Expression.IntrinsicCall {member, ..} = &form {
        if isPrimitive(member, Primitive.BorrowField) {return false}
      }
    }
    at = at + usize.ONE
  }
  return first && second && shared == 2
}

test effect fn ordinaryStaticFieldWrappersInferOnlyUnfixedParameters() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run ordinaryWrapperClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn ordinaryWrapperClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("ordinary-static-field-wrapper.silk")
  let text = """
struct Box {value: i32}
struct Other {value: i32}
struct Stored<'a> {value: &'a i32}
fn project<'a, Owner, Value>(static field: Intrinsic.Field<Owner, Value>, owner: &'a Owner) -> &'a Value {
  return Intrinsic.borrowField<Owner, Value>(owner, field)
}
fn inferProject<'a, Owner, Value>(static field: Intrinsic.Field<Owner, Value>, owner: &'a Owner) -> &'a Value {
  return Intrinsic.borrowField(owner, field)
}
fn ownerFirst<'a, Owner, Value>(owner: &'a Owner, static field: Intrinsic.Field<Owner, Value>) -> &'a Value {
  return Intrinsic.borrowField<Owner, Value>(owner, field)
}
fn relay<'a, Owner, Value>(owner: &'a Owner, static field: Intrinsic.Field<Owner, Value>) -> &'a Value {
  return project(field, owner)
}
fn forwardRead(owner: &Box) -> i32 {
  let mut total = 0
  static for field in Intrinsic.reflectFields<Box>() {total = total + relay(owner, field).*}
  return total
}
fn read(owner: &Box) -> i32 {
  let mut total = 0
  static for field in Intrinsic.reflectFields<Box>() {
    total = total + project(field, owner).* + inferProject(field, owner).* + ownerFirst(owner, field).*
  }
  return total
}
fn readStored<'storage, 'loan>(owner: &'loan Stored<'storage>) -> i32 {
  let mut total = 0
  static for field in Intrinsic.reflectFields<Stored<'storage>>() {
    total = total + project(field, owner).*.*
  }
  return total
}
fn wrongOwner(owner: &Other) -> () {
  static for field in Intrinsic.reflectFields<Box>() {let selected = project<Other, i32>(field, owner) drop selected}
}
fn wrongValue(owner: &Box) -> () {
  static for field in Intrinsic.reflectFields<Box>() {let selected = project<Box, bool>(field, owner) drop selected}
}
fn wrongInferredOwner(owner: &Other) -> () {
  static for field in Intrinsic.reflectFields<Box>() {let selected = ownerFirst(owner, field) drop selected}
}
fn escapingRelay<'a>(owner: &'a Box) -> () {
  static for field in Intrinsic.reflectFields<Box>() {
    let escaped: &'static i32 = ownerFirst(owner, field)
    drop escaped
  }
}
pub fn main() -> i32 {let value = Box {value: 14} return read(&value)}
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let read = run Semantic.demandMir(&mut store, &mut request, &id, b"read")
  run Testing.expect(succeeded(&read), "a user wrapper infers Owner and Value from its static first operand")
  run Testing.expect(singleRuntimeCallOperands(&store, &read), "each static-first call retains exactly its runtime owner operand")
  let forwarded = run Semantic.demandMir(&mut store, &mut request, &id, b"forwardRead")
  run Testing.expect(succeeded(&forwarded), "an outer caller retains its selected generic relay")
  let relay = namedMirApplication(&store, &forwarded, b"relay")
  if let Option<Shared<Application>>.Some {value: chosen} = move relay {
    let applied = run Application.copyShared(&chosen)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &applied)
    run Testing.expect(oneOwnerParameter(&store, &target),
      "a selected generic relay matches its symbolic runtime owner after the static first operand fixes the nested call")
  } else {run Testing.expect(false, "the generic relay retains its concrete application")}
  return run wrapperTargetClaims(&mut store, &mut request, &mut index, &id, &read)
}

fn singleRuntimeCallOperands(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = List<Block>.asSlice(&function.blocks)
      let mut calls = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let Terminator.Call {arguments, ..} = &blocks[at].terminator {
          if List<Operand>.length(&arguments) != usize.ONE {return false}
          calls = calls + usize.ONE
        }
        at = at + usize.ONE
      }
      return calls == 3
    }
  }
  return false
}

effect fn wrapperTargetClaims(store: &mut Semantic, request: &mut Request, index: &mut SourceIndex,
  id: &ModuleId, caller: &Shared<Result<Answer, NoRejection>>) -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < 3 {
    let mut name: &[u8] = b"project"
    if at == usize.ONE {name = b"inferProject"}
    if at == 2 {name = b"ownerFirst"}
    let selected = namedMirApplication(&store.*, caller, name)
    if let Option<Shared<Application>>.Some {value} = move selected {
      let application = run Application.copyShared(&value)
      let slots = List<StaticSlot>.asSlice(&application.statics)
      let mut ordinal = usize.ZERO
      if at == 2 {ordinal = usize.ONE}
      run Testing.expect(slots.length == usize.ONE && slots[usize.ZERO].ordinal == ordinal,
        "the descriptor remains an application side fact at its original formal ordinal")
      let target = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &application)
      run Testing.expect(oneOwnerParameter(&store.*, &target), "all explicit, inferred and owner-first intrinsic wrappers lower with only the owner parameter")
    } else {run Testing.expect(false, "all ordinary generic wrapper applications are retained")}
    at = at + usize.ONE
  }
  let stored = run selectedApplicationOf(&mut index.*, id, b"readStored")
  let mut regions = List<Argument>.make()
  run List<Argument>.append(&mut regions, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
  run List<Argument>.append(&mut regions, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Local {
    declaration: DeclarationId.copy(Application.bodyDeclaration(&stored)), ordinal: usize.ZERO, binder: usize.MAX,
  })})
  let application = run specializationWithArguments(Application.bodyDeclaration(&stored), move regions)
  let storedMir = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &application)
  run Testing.expect(succeeded(&storedMir), "a stored reference field retains its exact referent region independently of the owner's loan")
  let projected = namedMirApplication(&store.*, &storedMir, b"project")
  if let Option<Shared<Application>>.Some {value: chosen} = move projected {
    let applied = run Application.copyShared(&chosen)
    let result = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &applied)
    run Testing.expect(storedReferenceResult(&store.*, &result), "the wrapper result preserves both the local owner loan and static stored referent")
  } else {run Testing.expect(false, "the stored-reference wrapper has a concrete selected application")}
  let wrongOwner = run selectedApplicationOf(&mut index.*, id, b"wrongOwner")
  let ownerAnswer = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &wrongOwner)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&ownerAnswer, rejectsType),
    "a descriptor cannot rebind an explicitly fixed incompatible nominal owner")
  let wrongValue = run selectedApplicationOf(&mut index.*, id, b"wrongValue")
  let valueAnswer = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &wrongValue)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&valueAnswer, rejectsType),
    "a descriptor cannot rebind an explicitly fixed incompatible Value")
  run Testing.expect(answerCarries(&valueAnswer, b"expected", b"Intrinsic.Field<ordinary-static-field-wrapper.Box, bool>")
    && answerCarries(&valueAnswer, b"actual", b"Intrinsic.Field<ordinary-static-field-wrapper.Box, i32>")
    && answerCarries(&valueAnswer, b"note", b"the argument describes field `value`"),
    "a static field argument of another Value names both types and the field (SEM0012)")
  let wrongInferred = run selectedApplicationOf(&mut index.*, id, b"wrongInferredOwner")
  let inferredAnswer = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &wrongInferred)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&inferredAnswer, rejectsType),
    "a descriptor cannot rebind the nominal Owner inferred from an earlier runtime operand")
  let escaping = run selectedApplicationOf(&mut index.*, id, b"escapingRelay")
  let mut loans = List<Argument>.make()
  run List<Argument>.append(&mut loans, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Local {
    declaration: DeclarationId.copy(Application.bodyDeclaration(&wrongOwner)), ordinal: usize.ZERO, binder: usize.MAX,
  })})
  let escapingApplication = run specializationWithArguments(Application.bodyDeclaration(&escaping), move loans)
  let escapingAnswer = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &escapingApplication)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&escapingAnswer, fn(answer: &Result<Answer, NoRejection>) -> bool { return rejectionCode(answer, RejectionCode.UnsatisfiedLifetimeBound) }),
    "selected call-result comparison cannot extend the owner loan to a static return reference")
}

fn oneOwnerParameter(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return List<Shared<Type>>.length(&function.parameters) == usize.ONE
    }
  }
  return false
}

fn storedReferenceResult(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Shared<Type>.with<bool>(&function.result, storedReferenceType)
    }
  }
  return false
}

fn storedReferenceType(result: &Type) -> bool {
  if let Type.Reference {referent, access, lifetime} = &result.* {
    if access != Access.Shared {return false}
    if !Shared<Lifetime>.with<bool>(&lifetime, callerRegion) {return false}
    return Shared<Type>.with<bool>(&referent, storedInnerReference)
  }
  return false
}

fn callerRegion(region: &Lifetime) -> bool {
  return match &region.* {Lifetime.Local {..} => true Lifetime.Supplied {..} => true _ => false}
}

fn storedInnerReference(inner: &Type) -> bool {
  if let Type.Reference {access, lifetime, ..} = &inner.* {
    return access == Access.Shared && Shared<Lifetime>.with<bool>(&lifetime, staticRegion)
  }
  return false
}

fn staticRegion(region: &Lifetime) -> bool {
  return match &region.* {Lifetime.Static => true _ => false}
}

fn rejectsType(answer: &Result<Answer, NoRejection>) -> bool {
  return rejectionCode(answer, RejectionCode.TypeMismatch)
}

test effect fn reflectedBorrowUsesOrdinaryProjectionsAndNoDescriptorParameter() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("borrow-field.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("""
struct Box { first: i32, second: i32 }
fn read<'a>(owner: &'a Box) -> i32 {
  let mut total = 0
  static for field in Intrinsic.reflectFields<Box>() {
    total = total + Intrinsic.borrowField(owner, field).*
  }
  return total
}
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let template = run selectedApplicationOf(&mut index, &id, b"read") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut arguments = List<Argument>.make()
  let region = run Shared<Lifetime>.make(Lifetime.Static) |> Effect.provideMut<Allocator>(&mut allocator)
  run List<Argument>.append(&mut arguments, Argument.Lifetime {value: move region}) |> Effect.provideMut<Allocator>(&mut allocator)
  let application = run specializationWithArguments(Application.bodyDeclaration(&template), move arguments) |> Effect.provideMut<Allocator>(&mut allocator)
  let answer = run Semantic.demandSelectedBody(&mut store, &mut request, &application) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, checkedBody)
  let mut ordinary = false
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    ordinary = Shared<TypedBody>.with<bool>(&value, ordinaryReflectedProjections)
  }
  run Testing.expect(ordinary, "each selected field becomes an ordinary field projection and shared loan")
  let mir = run Semantic.demandApplicationMir(&mut store, &mut request, &application) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, selectedMirIndex)
  let mut onlyOwner = false
  if let Option<usize>.Some {value} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, value) {
      onlyOwner = List<Shared<Type>>.length(&function.parameters) == usize.ONE
    }
  }
  run Testing.expect(onlyOwner, "MIR retains the runtime owner parameter and consumes field descriptors during specialization")
}

test effect fn reflectedBorrowRequiresSharedAccessAndExactNominalOwner() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("borrow-field-access.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Box { value: i32 }
struct Other { value: i32 }
fn owned(owner: Box) -> i32 {
  static for field in Intrinsic.reflectFields<Box>() {let selected = Intrinsic.borrowField<Box, i32>(owner, field).* drop selected}
  return 0
}
fn mutable(owner: &mut Box) -> i32 {
  static for field in Intrinsic.reflectFields<Box>() {let selected = Intrinsic.borrowField<Box, i32>(owner, field).* drop selected}
  return 0
}
fn wrong(owner: &Other) -> i32 {
  static for field in Intrinsic.reflectFields<Box>() {let selected = Intrinsic.borrowField<Box, i32>(owner, field).* drop selected}
  return 0
}
fn wrongValue(owner: &Box) -> () {
  static for field in Intrinsic.reflectFields<Box>() {let selected = Intrinsic.borrowField<Box, bool>(owner, field).* drop selected}
}
fn escaping<'a>(owner: &'a Box) -> () {
  static for field in Intrinsic.reflectFields<Box>() {
    let escaped: &'static i32 = Intrinsic.borrowField<Box, i32>(owner, field)
    drop escaped
  }
}
fn write<'a>(owner: &'a mut Box) -> () {
  static for field in Intrinsic.reflectFields<Box>() {let place = Intrinsic.borrowFieldMut<Box, i32>(owner, field) place.* = 1}
}
fn sharedWrite(owner: &Box) -> () {
  static for field in Intrinsic.reflectFields<Box>() {let place = Intrinsic.borrowFieldMut<Box, i32>(owner, field) place.* = 1}
}
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &id, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let ownedApplication = run selectedApplicationOf(&mut index, &id, b"owned") |> Effect.provideMut<Allocator>(&mut allocator)
  let owned = run Semantic.demandSelectedBody(&mut store, &mut request, &ownedApplication) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mutableApplication = run selectedApplicationOf(&mut index, &id, b"mutable") |> Effect.provideMut<Allocator>(&mut allocator)
  let mutable = run Semantic.demandSelectedBody(&mut store, &mut request, &mutableApplication) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongApplication = run selectedApplicationOf(&mut index, &id, b"wrong") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandSelectedBody(&mut store, &mut request, &wrongApplication) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongValueApplication = run selectedApplicationOf(&mut index, &id, b"wrongValue") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongValue = run Semantic.demandSelectedBody(&mut store, &mut request, &wrongValueApplication) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let escapingTemplate = run selectedApplicationOf(&mut index, &id, b"escaping") |> Effect.provideMut<Allocator>(&mut allocator)
  let suppliedRegion = run Shared<Lifetime>.make(Lifetime.Local {
    declaration: DeclarationId.copy(Application.bodyDeclaration(&ownedApplication)),
    ordinal: usize.ZERO, binder: usize.MAX,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut escapingArguments = List<Argument>.make()
  run List<Argument>.append(&mut escapingArguments, Argument.Lifetime {value: move suppliedRegion}) |> Effect.provideMut<Allocator>(&mut allocator)
  let escapingApplication = run specializationWithArguments(Application.bodyDeclaration(&escapingTemplate), move escapingArguments) |> Effect.provideMut<Allocator>(&mut allocator)
  let escaping = run Semantic.demandSelectedBody(&mut store, &mut request, &escapingApplication) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&owned, rejectsType), "owned values do not acquire projection authority")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&mutable, rejectsType), "exclusive references do not satisfy the shared-reference contract")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&wrong, rejectsType), "equal field layouts do not erase nominal owner identity")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&wrongValue, rejectsType), "explicit Value arguments cannot change an authenticated field's declared type")
  run Testing.expect(rejectsSpan(&escaping, RejectionCode.UnsatisfiedLifetimeBound, text, "Intrinsic.borrowField<Box, i32>(owner, field)", 3), "a field descriptor cannot extend the owner's reference lifetime (SEM0212)")
  let writeTemplate = run selectedApplicationOf(&mut index, &id, b"write") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut writeArguments = List<Argument>.make()
  let writeRegion = run Shared<Lifetime>.make(Lifetime.Static) |> Effect.provideMut<Allocator>(&mut allocator)
  run List<Argument>.append(&mut writeArguments, Argument.Lifetime {value: move writeRegion}) |> Effect.provideMut<Allocator>(&mut allocator)
  let writeApplication = run specializationWithArguments(Application.bodyDeclaration(&writeTemplate), move writeArguments) |> Effect.provideMut<Allocator>(&mut allocator)
  let written = run Semantic.demandSelectedBody(&mut store, &mut request, &writeApplication) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let writtenBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&written, checkedBody)
  let mut mutableLoan = false
  if let Option<Shared<TypedBody>>.Some {value} = move writtenBody {
    mutableLoan = Shared<TypedBody>.with<bool>(&value, mutableReflectedProjection)
  }
  run Testing.expect(mutableLoan, "a mutable reflected projection is an ordinary field projection and mutable loan")
  let sharedWriteApplication = run selectedApplicationOf(&mut index, &id, b"sharedWrite") |> Effect.provideMut<Allocator>(&mut allocator)
  let sharedWrite = run Semantic.demandSelectedBody(&mut store, &mut request, &sharedWriteApplication) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&sharedWrite, rejectsType), "a shared reference does not satisfy the mutable projection contract")
}

fn mutableReflectedProjection(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut field = false
  let mut mutable = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let NodeKind.Expression {form, ..} = &nodes[at].kind {
      if let Expression.Field {..} = &form {
        field = true
      } else if let Expression.Borrow {access, ..} = &form {
        mutable = mutable || access == Access.Mutable
      } else if let Expression.IntrinsicCall {member, ..} = &form {
        if isPrimitive(member, Primitive.BorrowFieldMut) {return false}
      }
    }
    at = at + usize.ONE
  }
  return field && mutable
}

test effect fn selectedBodiesProveOnlyTheirOwnSuppliedRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run ownSuppliedRegionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn ownSuppliedRegionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("selected-supplied-regions.silk")
  let text = """
struct Box { first: i32, second: i32 }
fn pick(x: &i32, static n: usize) -> &i32 { return x }
fn pickSecond<'x, 'y>(x: &'x i32, y: &'y i32, static n: usize) -> &'y i32 { return y }
fn viaParameter<'a>(p: &'a i32) -> i32 { return pick(p, 3).* }
fn second<'a, 'b>(p: &'a i32, q: &'b i32) -> &'b i32 { return pickSecond(p, q, 3) }
fn first<'a, 'b>(p: &'a i32, q: &'b i32) -> &'a i32 { return pickSecond(p, q, 3) }
fn escapes<'a>(p: &'a i32) -> &'a i32 { let v = 1  return pick(&v, 3) }
fn reflected<'a>(owner: &'a Box) -> i32 {
  let mut total = 0
  static for field in Intrinsic.reflectFields<Box>() { total = total + Intrinsic.borrowField(owner, field).* }
  return total
}
fn reflectedOther<'a, 'b>(x: &'a Box, lender: &'b Box) -> &'a i32 {
  let mut lent = &x.first
  static for field in Intrinsic.reflectFields<Box>() { lent = Intrinsic.borrowField<Box, i32>(lender, field) }
  return lent
}
fn closure<'k>(v: &'k i32) -> fn<'k>() -> i32 { return fn() -> i32 { return v.* } }
fn originProbe<'a>(p: &'a i32) -> i32 { let v = 4  let q = pick(p, 1)  let f = closure(&v)  let g = closure(q)  return f() + g() }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let viaParameter = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"viaParameter", 0, usize.MAX)
  let reflected = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"reflected", 0, usize.MAX)
  let staticBound = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"viaParameter", usize.MAX, usize.MAX)
  run Testing.expect(hasBorrowStatus(&viaParameter, BorrowStatus.Checked) && hasBorrowStatus(&reflected, BorrowStatus.Checked)
    && hasBorrowStatus(&staticBound, BorrowStatus.Checked),
    "a static callee's result in a selected body names the region its own application binds, which outlives the whole body")
  let shifted = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"second", 1, 0)
  let shared = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"second", 0, 0)
  run Testing.expect(hasBorrowStatus(&shifted, BorrowStatus.Checked) && hasBorrowStatus(&shared, BorrowStatus.Checked),
    "any numbering of the body's own regions, shifted or shared, is the caller's and valid for the whole call")
  let crossed = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"first", 1, 0)
  let escapes = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"escapes", 0, usize.MAX)
  run Testing.expect(!hasBorrowStatus(&crossed, BorrowStatus.Checked) && !hasBorrowStatus(&escapes, BorrowStatus.Checked),
    "a result in one supplied region never stands for another, and a loan of a body local never becomes a supplied region")
  let other = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"reflectedOther", 0, 1)
  run Testing.expect(rejectsSpan(&other, RejectionCode.UnsatisfiedLifetimeBound, text, "lent", 2),
    "a reflected borrow of another parameter is not the first parameter's region")
  let origin = run selectedWithRegions(&mut store, &mut request, &mut index, &id, b"originProbe", 0, usize.MAX)
  run Testing.expect(hasBorrowStatus(&origin, BorrowStatus.Checked),
    "a body that takes a callable-origin result from a static callee is checked in its supplied regions")
  return ()
}

// Demands `name`'s selected body with its lifetime parameters bound to `Supplied` ordinals in
// order; `usize.MAX` binds `'static` and ends the list.
effect fn selectedWithRegions(store: &mut Semantic, request: &mut Request, index: &mut SourceIndex, id: &ModuleId,
  name: &[u8], first: usize, second: usize) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let template = run selectedApplicationOf(&mut index.*, id, name)
  let mut arguments = List<Argument>.make()
  if first == usize.MAX {
    run List<Argument>.append(&mut arguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
  } else {
    run List<Argument>.append(&mut arguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: first})})
  }
  if second != usize.MAX {
    run List<Argument>.append(&mut arguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: second})})
  }
  let application = run specializationWithArguments(Application.bodyDeclaration(&template), move arguments)
  return run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &application)
}
