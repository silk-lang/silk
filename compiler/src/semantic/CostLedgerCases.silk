//! `silk build --costs` charges each generated function to the call that asked for it.

import lexer.Span {Span}
import semantic.CostLedger as CostLedger {Ledger, Site}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Semantic {BackendBuild, Request, Semantic, staticClosureNodes}
import semantic.SemanticCaseSupport {applicationSemantic, buildApplication, module}
import semantic.SourceIndex {RevisionMismatch}
import semantic.Target {Id as TargetId, Target as MachineTarget}
import semantic.Types {TypeTable, Types}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize
import silk.testing.testing {AssertionError, Testing}
import silk.text.string {String}

test effect fn ledgerSumsEachCallAndOrdersByCode() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run ledgerClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn ledgerClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let own = run module("main.silk")
  let mut ledger = Ledger.off()
  ledger.enabled = true
  run List<ModuleId>.append(&mut ledger.root, ModuleId.copy(&own))
  run Ledger.charge(&mut ledger, true, &own, Span.make(10, 20), 100, 5, 1000)
  run Ledger.charge(&mut ledger, true, &own, Span.make(30, 40), 900, 0, 1)
  run Ledger.charge(&mut ledger, true, &own, Span.make(10, 20), 50, 2, 1000)
  run Ledger.charge(&mut ledger, false, &own, Span.make(0, 0), 7, 1, 1)
  let sites = Ledger.charged(&ledger)
  run Testing.expect(sites.length == 2 && sites[0].functions == 2 && sites[0].bytes == 150 && sites[0].steps == 7
    && sites[0].nanos == 2000 && sites[1].functions == 1,
    "a call's instances add up at one site, and an uncharged instance makes none")
  run Testing.expect(ledger.functions == 4 && ledger.bytes == 1057 && ledger.steps == 8,
    "the totals count every lowered instance, charged or not")
  let order = run Ledger.costliest(&ledger, 5)
  let ranked = List<usize>.asSlice(&order)
  run Testing.expect(ranked.length == 2 && ranked[0] == 1 && ranked[1] == 0,
    "the call with the most code comes first, whatever its time or function count")
  run Testing.expect(Ledger.inRoot(&ledger, &own), "a module of the root package is charged")
  Ledger.restart(&mut ledger)
  run Testing.expect(Ledger.charged(&ledger).length == 0 && ledger.functions == 0,
    "a later walk of the same build starts from no sites")
  let mut sized = Bytes.make()
  run CostLedger.appendSize(&mut sized, 999)
  run Bytes.append(&mut sized, b",")
  run CostLedger.appendSize(&mut sized, 48250)
  run Bytes.append(&mut sized, b",")
  run CostLedger.appendSize(&mut sized, 2150000)
  run Testing.expect(Bytes.length(&sized) == 20 && contains(Bytes.asSlice(&sized), b"999 B,48.2 KB,2.1 MB"), "sizes read in powers of 1,000")
}

test effect fn buildChargesEachInstanceToTheNearestOwnCall() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run buildClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn buildClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("cost-sites.silk")
  let text = """
fn helper<T>(value: T) -> T { return move value }
fn twice<T>(value: T) -> T { return helper<T>(move value) }
pub fn main() -> i32 {
  let _small = twice<u8>(2)
  return twice<i32>(1)
}
"""
  let mut store = run applicationSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  Semantic.selectCosts(&mut store, true)
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, staticClosureNodes)
  run Testing.expect(match &built { BackendBuild.Module {..} => true _ => false }, "the costed program builds")
  let sites = Semantic.costSites(&store)
  let written = String.utf8Bytes(text)
  let helperCall = found(written, b"helper<T>(move value)")
  let smallCall = found(written, b"twice<u8>(2)")
  let wideCall = found(written, b"twice<i32>(1)")
  run Testing.expect(functionsAt(sites, helperCall) == 2 && functionsAt(sites, smallCall) == 1 && functionsAt(sites, wideCall) == 1,
    "each instance is charged to the call in the package that reached it: both helper instances to the call in twice")
  let report = run Semantic.costReport(&mut store, 15, b"src/")
  run Testing.expect(contains(Bytes.asSlice(&report), b"src/cost-sites.silk:3:37  helper<T>(move value)"),
    "a report row names the call as path:line:column and its source text")
}

// The functions charged to the call that starts at `start`, or zero.
fn functionsAt(sites: &[Site], start: usize) -> usize {
  let mut at = usize.ZERO
  while at < sites.length {
    if sites[at].span.start == start { return sites[at].functions }
    at = at + usize.ONE
  }
  return usize.ZERO
}

// Where `needle` first starts in `text`, or `usize.MAX`.
fn found(text: &[u8], needle: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at + needle.length <= text.length {
    let mut same = true
    let mut offset = usize.ZERO
    while offset < needle.length {
      if text[at + offset] != needle[offset] {
        same = false
        break
      }
      offset = offset + usize.ONE
    }
    if same { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn contains(text: &[u8], needle: &[u8]) -> bool {
  return found(text, needle) != usize.MAX
}
