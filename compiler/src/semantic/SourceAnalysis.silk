/// Finite construction evidence. It never gates the earlier writer by a later read.
pub union OwnershipMirrorOrigin {
  Move { pub moveRead: usize },
  Field { pub fieldRead: usize, pub case: usize },
}
impl Copy for OwnershipMirrorOrigin {}
/// An ownership lane at the ORIGINAL physical writer, shared across observation kinds.
pub struct OwnershipMirror {
  pub origin: OwnershipMirrorOrigin
  pub acquisitionCase: usize
  pub sourceCase: usize
  pub original: DefinitionId
  pub read: ReadId
  pub definition: DefinitionId
  pub summary: usize
  pub writer: EvalId
  pub storage: Storage
  pub placement: OwnershipPlacement
  pub source: ValueId
  pub target: ValueId
  pub active: Atom
  pub admitted: Atom
  sourceCell: usize
}
impl Copy for OwnershipMirror {}
pub struct MoveCoverage {
  pub request: usize
  pub active: Atom
  pub missing: Atom
}
impl Copy for MoveCoverage {}
/// Later definitions remain observable but cannot retroactively construct earlier carries.
/// BC supplies covered for each exact Case, including a proved observation-only alternative.
pub struct MoveHoldingCoverage {
  pub moveRead: usize
  pub observation: usize
  pub request: usize
  pub case: usize
  pub source: ValueId
  pub leaf: LeafId
  pub category: SourceRole
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub construction: Option<bool>
  pub active: Atom
  pub covered: Atom
  pub missing: Atom
}
impl Copy for MoveHoldingCoverage {}
pub struct OwnershipMirrorCoverage {
  pub origin: OwnershipMirrorOrigin
  pub acquisitionCase: usize
  pub original: DefinitionId
  pub case: usize
  pub source: ValueId
  pub leaf: LeafId
  pub category: SourceRole
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub active: Atom
  pub covered: Atom
  pub missing: Atom
}
impl Copy for OwnershipMirrorCoverage {}
struct OwnershipMirrors {
  candidates: List<OwnershipMirror>
  coverage: List<OwnershipMirrorCoverage>
}
impl OwnershipMirrors {
  fn make() -> OwnershipMirrors { return OwnershipMirrors {candidates: List<OwnershipMirror>.make(), coverage: List<OwnershipMirrorCoverage>.make()} }
}
struct SelectedMoves {
  occurrences: List<OwnershipOccurrence>
  requests: List<SelectedMove>
  observations: List<MoveObservation>
  reads: List<MoveRead>
  holdings: List<MoveHolding>
  positions: List<OwnershipPosition>
  coverage: List<MoveCoverage>
  holdingCoverage: List<MoveHoldingCoverage>
}
impl SelectedMoves {
  fn make() -> Self {
    return Self {occurrences: List<OwnershipOccurrence>.make(), requests: List<SelectedMove>.make(),
      observations: List<MoveObservation>.make(), reads: List<MoveRead>.make(), holdings: List<MoveHolding>.make(),
      positions: List<OwnershipPosition>.make(), coverage: List<MoveCoverage>.make(), holdingCoverage: List<MoveHoldingCoverage>.make()}
  }
}

/// The request is an actual PlaceAssignment; BC admits only retaining, direct, selected
/// stores. Acceptance is independent of whether any incoming source carries a loan.
pub struct FieldReholdRequest {
  pub map: MapId
  pub source: EvalId
  pub address: EvalId
  pub execution: EvalId
  pub result: EvalId
  pub active: Atom
  pub accepted: Atom
}
impl Copy for FieldReholdRequest {}
pub struct FieldReholdObservation {
  pub request: usize
  pub alias: usize
  pub storage: Storage
  pub owner: Storage
  pub active: Atom
}
impl Copy for FieldReholdObservation {}
pub struct FieldReholdRead {
  pub observation: usize
  pub storage: Storage
  pub read: ReadId
  pub value: ValueId
  pub active: Atom
}
impl Copy for FieldReholdRead {}
pub union FieldReholdOrigin {
  Old { pub fieldRead: usize, pub definition: DefinitionId, pub read: ReadId, pub storage: Storage,
    pub held: OwnershipPlacement, pub disposition: SummaryDisposition },
  Rhs { pub publication: Option<usize>, pub held: OwnershipPlacement },
}
impl Copy for FieldReholdOrigin {}
pub struct FieldReholdCandidate {
  pub observation: usize
  pub case: usize
  pub origin: FieldReholdOrigin
  pub source: ValueId
  pub target: ValueId
  pub summary: usize
  pub definition: DefinitionId
  pub placement: OwnershipPlacement
  pub disposition: SummaryDisposition
  pub active: Atom
  sourceCell: usize
  admitted: Atom
}
impl Copy for FieldReholdCandidate {}
pub struct FieldReholdCoverage {
  pub request: usize
  pub active: Atom
  pub missing: Atom
}
impl Copy for FieldReholdCoverage {}
pub struct FieldReholdCaseCoverage {
  pub observation: usize
  pub fieldRead: Option<usize>
  pub case: usize
  pub source: ValueId
  pub leaf: LeafId
  pub category: SourceRole
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub construction: Option<bool>
  pub active: Atom
  pub covered: Atom
  pub missing: Atom
}
impl Copy for FieldReholdCaseCoverage {}
struct FieldReholdDefinition {
  observation: usize
  summary: usize
  definition: DefinitionId
  value: ValueId
  active: Atom
}
impl Copy for FieldReholdDefinition {}
pub struct FieldReholdClear {
  pub observation: usize
  pub summary: usize
  pub definition: DefinitionId
}
impl Copy for FieldReholdClear {}
/// An original physical write whose ordinary summary action is handled by this
/// exact accepted semantic owner rebind. It does not assert source-case coverage.
pub struct FieldReholdSuppression {
  pub original: DefinitionId
  pub observation: usize
  pub summary: usize
  pub active: Atom
}
impl Copy for FieldReholdSuppression {}
struct FieldReholds {
  requests: List<FieldReholdRequest>
  observations: List<FieldReholdObservation>
  reads: List<FieldReholdRead>
  candidates: List<FieldReholdCandidate>
  definitions: List<FieldReholdDefinition>
  clears: List<FieldReholdClear>
  coverage: List<FieldReholdCoverage>
  cases: List<FieldReholdCaseCoverage>
  suppressions: List<FieldReholdSuppression>
}
impl FieldReholds {
  fn make() -> Self { return Self {requests: List<FieldReholdRequest>.make(), observations: List<FieldReholdObservation>.make(),
    reads: List<FieldReholdRead>.make(), candidates: List<FieldReholdCandidate>.make(), definitions: List<FieldReholdDefinition>.make(),
    clears: List<FieldReholdClear>.make(), coverage: List<FieldReholdCoverage>.make(), cases: List<FieldReholdCaseCoverage>.make(),
    suppressions: List<FieldReholdSuppression>.make()} }
}

/// Exact structural correspondence from an original tagged placement to a current history.
/// Only the inline anchor moves; this record does not decide held/read overlap.
pub struct OwnershipPublication {
  pub category: SourceRole
  pub origin: usize
  pub initial: OwnershipPlacement
  pub placement: OwnershipPlacement
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub active: Atom
  cell: usize
  scanned: usize
}
impl Copy for OwnershipPublication {}

pub struct OwnershipPublicationGap {
  pub category: SourceRole
  pub origin: usize
  pub initial: OwnershipPlacement
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub active: Atom
  cell: usize
  scanned: usize
}
impl Copy for OwnershipPublicationGap {}

/// Structural output placement for an exact policy transfer. The two gates deliberately
/// exclude that transfer's kept decision; target publication.active includes it and must
/// not be used to decide the same port. The caller also retains its exact incoming Case.
pub struct OwnershipPolicyPlacement {
  pub source: usize
  pub target: usize
  pub case: usize
  pub member: Option<MapId>
  pub sourceActive: Atom
  pub applicable: Atom
}
impl Copy for OwnershipPolicyPlacement {}

struct OwnershipPublicationEdge {
  source: usize
  target: usize
  case: usize
  member: Option<MapId>
}

/// A whole operation result's pre-policy reset view. sourceActive/applicable exclude
/// this Case's kept gate. Policy alone derives accepted for its ordinary, nondeclared
/// branch; the resulting publication additionally requires the exact output Case.
pub struct OperationOwnershipReset {
  pub case: usize
  pub source: ValueId
  pub target: ValueId
  pub root: EndpointId
  pub sourceRole: SourceRole
  pub outputRole: SourceRole
  pub leaf: LeafId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub publication: usize
  pub sourceActive: Atom
  pub applicable: Atom
  pub accepted: Atom
  sourceCell: usize
  targetCell: usize
}
impl Copy for OperationOwnershipReset {}

struct OwnershipPublications {
  emptyRows: List<usize>
  valuesByValue: List<List<usize>>
  gapsByValue: List<List<usize>>
  valuesByOrigin: List<List<usize>>
  gapsByOrigin: List<List<usize>>
  fieldReads: List<FieldRead>
  fieldResults: List<FieldResultPublication>
  ordinaryResets: List<OrdinaryOwnershipReset>
  rvalueDereferences: List<RvalueDereferencePublication>
  throughResets: List<ThroughOwnershipReset>
  resets: List<OperationOwnershipReset>
  origins: List<OwnershipOrigin>
  values: List<OwnershipPublication>
  edges: List<OwnershipPublicationEdge>
  gaps: List<OwnershipPublicationGap>
}

impl OwnershipPublications {
  fn make() -> Self {
    return Self {emptyRows: List<usize>.make(), valuesByValue: List<List<usize>>.make(), gapsByValue: List<List<usize>>.make(),
      valuesByOrigin: List<List<usize>>.make(), gapsByOrigin: List<List<usize>>.make(),
      fieldReads: List<FieldRead>.make(), fieldResults: List<FieldResultPublication>.make(), ordinaryResets: List<OrdinaryOwnershipReset>.make(), rvalueDereferences: List<RvalueDereferencePublication>.make(), throughResets: List<ThroughOwnershipReset>.make(), resets: List<OperationOwnershipReset>.make(), origins: List<OwnershipOrigin>.make(), values: List<OwnershipPublication>.make(),
      edges: List<OwnershipPublicationEdge>.make(), gaps: List<OwnershipPublicationGap>.make()}
  }
}

// Read-only indexes of the same immutable rows; neither lookup establishes applicability.
fn ownershipRowsAt(product: &OwnershipPublications, value: ValueId, gaps: bool) -> &[usize] {
  if gaps {
    let indexed = List<List<usize>>.asSlice(&product.gapsByValue)
    if value.index < indexed.length { return List<usize>.asSlice(&indexed[value.index]) }
  } else {
    let indexed = List<List<usize>>.asSlice(&product.valuesByValue)
    if value.index < indexed.length { return List<usize>.asSlice(&indexed[value.index]) }
  }
  return List<usize>.asSlice(&product.emptyRows)
}

effect fn ownershipOriginsAt(product: &OwnershipPublications, value: ValueId) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<bool>.make()
  let count = List<OwnershipOrigin>.length(&product.origins)
  let mut at = usize.ZERO
  while at < count { run List<bool>.append(&mut selected, false) at = at + usize.ONE }
  let values = ownershipRowsAt(product, value, false)
  at = usize.ZERO
  while at < values.length {
    let origin = List<OwnershipPublication>.asSlice(&product.values)[values[at]].origin
    let flags = List<bool>.asMutSlice(&mut selected)
    flags[origin] = true
    at = at + usize.ONE
  }
  let gaps = ownershipRowsAt(product, value, true)
  at = usize.ZERO
  while at < gaps.length {
    let origin = List<OwnershipPublicationGap>.asSlice(&product.gaps)[gaps[at]].origin
    let flags = List<bool>.asMutSlice(&mut selected)
    flags[origin] = true
    at = at + usize.ONE
  }
  let mut result = List<usize>.make()
  at = usize.ZERO
  // Preserve the original origin order, even if an older origin arrives here later.
  while at < count {
    if List<bool>.asSlice(&selected)[at] { run List<usize>.append(&mut result, at) }
    at = at + usize.ONE
  }
  return move result
}

// Finite keys retain the original origin, tagged initial/current placement and actual cell.
// Copies change only the inline anchor. The descriptor suffix is never re-rooted or extended.
effect fn ownershipPublicationNode(product: &mut OwnershipPublications, domain: &Domain, rules: &mut Program,
  origin: usize, initial: OwnershipPlacement, placement: OwnershipPlacement, cell: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  while List<List<usize>>.length(&product.valuesByOrigin) <= origin {
    run List<List<usize>>.append(&mut product.valuesByOrigin, List<usize>.make())
  }
  let rows = List<OwnershipPublication>.asSlice(&product.values)
  let indexed = List<usize>.asSlice(&List<List<usize>>.asSlice(&product.valuesByOrigin)[origin])
  let mut at = usize.ZERO
  while at < indexed.length {
    let index = indexed[at]
    if sameOwnershipPlacement(rows[index].initial, initial)
      && sameOwnershipPlacement(rows[index].placement, placement) && rows[index].cell == cell { return index }
    at = at + usize.ONE
  }
  let key = List<CellKey>.asSlice(&domain.keys)[cell]
  let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
  let result = rows.length
  let active = Program.atom(&mut rules.*)
  run List<OwnershipPublication>.append(&mut product.values, OwnershipPublication {category: key.category, origin: origin,
    initial: initial, placement: placement, value: key.value, leaf: key.leaf, direct: key.direct,
    definition: witness.definition, read: witness.read, active: active, cell: cell, scanned: usize.ZERO})
  let byOrigin = List<List<usize>>.asMutSlice(&mut product.valuesByOrigin)
  run List<usize>.append(&mut byOrigin[origin], result)
  while List<List<usize>>.length(&product.valuesByValue) <= key.value.index {
    run List<List<usize>>.append(&mut product.valuesByValue, List<usize>.make())
  }
  let byValue = List<List<usize>>.asMutSlice(&mut product.valuesByValue)
  run List<usize>.append(&mut byValue[key.value.index], result)
  return result
}

effect fn ownershipPublicationEdge(product: &mut OwnershipPublications, domain: &Domain, rules: &mut Program,
  source: usize, cell: usize, placement: OwnershipPlacement, case: usize, member: Option<MapId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let previous = List<OwnershipPublication>.asSlice(&product.values)[source]
  let target = run ownershipPublicationNode(&mut product.*, domain, &mut rules.*, previous.origin, previous.initial, placement, cell)
  run List<OwnershipPublicationEdge>.append(&mut product.edges, OwnershipPublicationEdge {
    source: source, target: target, case: case, member: member})
  let admitted: [Atom; 2] = [previous.active, List<Case>.asSlice(&domain.cases)[case].active]
  run Program.rule(&mut rules.*, List<OwnershipPublication>.asSlice(&product.values)[target].active, &admitted, &[])
  return ()
}

effect fn ownershipPublicationGap(product: &mut OwnershipPublications, domain: &Domain, rules: &mut Program,
  origin: usize, initial: OwnershipPlacement, cell: usize, source: Atom, gate: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  while List<List<usize>>.length(&product.gapsByOrigin) <= origin {
    run List<List<usize>>.append(&mut product.gapsByOrigin, List<usize>.make())
  }
  let gaps = List<OwnershipPublicationGap>.asSlice(&product.gaps)
  let indexed = List<usize>.asSlice(&List<List<usize>>.asSlice(&product.gapsByOrigin)[origin])
  let mut index = gaps.length
  let mut at = usize.ZERO
  while at < indexed.length {
    let candidate = indexed[at]
    if sameOwnershipPlacement(gaps[candidate].initial, initial) && gaps[candidate].cell == cell { index = candidate break }
    at = at + usize.ONE
  }
  if index == gaps.length {
    let target = List<CellKey>.asSlice(&domain.keys)[cell]
    let witness = &List<Witness>.asSlice(&domain.witnesses)[target.witness]
    let active = Program.atom(&mut rules.*)
    run List<OwnershipPublicationGap>.append(&mut product.gaps, OwnershipPublicationGap {
      category: target.category, origin: origin, initial: initial, value: target.value, leaf: target.leaf,
      direct: target.direct, definition: witness.definition, read: witness.read,
      active: active, cell: cell, scanned: usize.ZERO})
    let byOrigin = List<List<usize>>.asMutSlice(&mut product.gapsByOrigin)
    run List<usize>.append(&mut byOrigin[origin], index)
    while List<List<usize>>.length(&product.gapsByValue) <= target.value.index {
      run List<List<usize>>.append(&mut product.gapsByValue, List<usize>.make())
    }
    let byValue = List<List<usize>>.asMutSlice(&mut product.gapsByValue)
    run List<usize>.append(&mut byValue[target.value.index], index)
  }
  let admitted: [Atom; 2] = [source, gate]
  run Program.rule(&mut rules.*, List<OwnershipPublicationGap>.asSlice(&product.gaps)[index].active, &admitted, &[])
  return ()
}

fn operationOwnershipResetCase<'body>(prepared: &SourcePreparation<'body>, policy: PendingPolicy,
  cases: &[Case], keys: &[CellKey], witnesses: &[Witness], values: &[Value], evaluations: &[Evaluation]) -> bool
{
  if policy.port.outputRole != SourceRole.Ownership { return false }
  let candidate = match policy.port.authority {
    TransferAuthority.OperationResult {candidate, position: Option<Results.Position>.None} => candidate
    _ => { return false }
  }
  if !Results.wholeResultCandidate(prepared, candidate) { return false }
  if policy.outputCase >= cases.length || policy.sourceCell >= keys.length {
    return CompilerBug.panic(b"operation reset lost its exact policy Case")
  }
  let actual = &cases[policy.outputCase]
  let source = match actual.source { Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"operation reset substituted a source seed") } }
  if source != policy.sourceCell || actual.target >= keys.length {
    return CompilerBug.panic(b"operation reset changed its paired cells")
  }
  let before = keys[source]
  let after = keys[actual.target]
  let from = values[before.value.index]
  let into = values[after.value.index]
  let witness = &witnesses[before.witness]
  let sameDefinition = match witness.definition {
    Option<DefinitionId>.Some {value} => match policy.port.definition {
      Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
  }
  let sameRead = match witness.read {
    Option<ReadId>.Some {value} => match policy.port.read {
      Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
    _ => match policy.port.read { Option<ReadId>.None => true _ => false }
  }
  if before.value.index != policy.port.source.index || after.value.index != policy.port.target.index
    || before.category != policy.port.category || after.category != policy.port.outputRole
    || before.leaf.index != policy.port.leaf.index || after.leaf.index != before.leaf.index
    || before.direct != policy.port.direct || after.direct || policy.port.outputDirect
    || before.witness != after.witness || !sameDefinition || !sameRead
    || from.endpoint.index != candidate.source.index || from.evaluation.index != candidate.operand.index
    || into.endpoint.index != candidate.target.index || into.evaluation.index != candidate.result.index
    || into.phase != ValuePhase.Output {
    return CompilerBug.panic(b"operation reset changed its actual source witness or result root")
  }
  if let Option<ResidualSubject>.Some {..} = into.subject {
    return CompilerBug.panic(b"operation reset promoted a selected result")
  }
  if let Option<usize>.Some {..} = into.summary { return CompilerBug.panic(b"operation reset substituted a summary") }
  if let Option<usize>.Some {..} = into.writeHolder { return CompilerBug.panic(b"operation reset substituted a write holder") }
  let operation = &List<Prepared.Operation>.asSlice(&prepared.operations)[candidate.operation]
  let sameSite = match evaluations[into.evaluation.index].site {
    EvaluationSite.Node {node} => node.index == operation.site.index _ => false }
  if !sameSite { return CompilerBug.panic(b"operation reset changed its result occurrence") }
  match actual.authority {
    TransferAuthority.OperationResult {candidate: other, position: Option<Results.Position>.None} => {
      if !sameInvocationCandidate(candidate, other) { return CompilerBug.panic(b"operation reset changed its original contributor") }
    }
    _ => { return CompilerBug.panic(b"operation reset lost its result authority") }
  }
  return true
}

/// Reservation is finite in original policy Cases. It neither transports the incoming
/// suffix nor requires that suffix to have a publication (including semantic MAX).
effect fn reserveOperationOwnershipResets<'body>(product: &mut OwnershipPublications,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<OperationOwnershipReset>.length(&product.resets)
  let policies = List<PendingPolicy>.asSlice(&domain.policies)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let values = List<Value>.asSlice(&skeleton.values)
  let evaluations = List<Evaluation>.asSlice(&skeleton.evaluations)
  let mut at = usize.ZERO
  while at < policies.length {
    let policy = policies[at]
    if !isOperationOwnershipReset(&product.*, policy.outputCase)
      && operationOwnershipResetCase(prepared, policy, cases, keys, witnesses, values, evaluations) {
      let actual = &cases[policy.outputCase]
      let target = keys[actual.target]
      let root = values[target.value.index].endpoint
      let reset = List<OperationOwnershipReset>.length(&product.resets)
      let origin = List<OwnershipOrigin>.length(&product.origins)
      let accepted = Program.atom(&mut skeleton.rules)
      let active = Program.atom(&mut skeleton.rules)
      let admitted: [Atom; 2] = [actual.active, accepted]
      run Program.rule(&mut skeleton.rules, active, &admitted, &[])
      run List<OwnershipOrigin>.append(&mut product.origins,
        OwnershipOrigin.OperationReset {reset: reset, category: target.category, root: root, active: active})
      let placement = OwnershipPlacement.Known {anchor: root, suffix: Option<OwnershipSuffix>.none()}
      let publication = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
        origin, placement, placement, actual.target)
      let seed: [Atom; 1] = [active]
      run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[publication].active, &seed, &[])
      run List<OperationOwnershipReset>.append(&mut product.resets, OperationOwnershipReset {
        case: policy.outputCase, source: policy.port.source, target: target.value, root: root,
        sourceRole: policy.port.category, outputRole: target.category, leaf: target.leaf, direct: policy.port.direct,
        definition: policy.port.definition, read: policy.port.read, publication: publication,
        sourceActive: cells[policy.sourceCell].present, applicable: policy.port.quality.present, accepted: accepted,
        sourceCell: policy.sourceCell, targetCell: actual.target})
    }
    at = at + usize.ONE
  }
  return before != List<OperationOwnershipReset>.length(&product.resets)
}

fn throughOwnershipResetCase(policy: PendingPolicy, cases: &[Case], keys: &[CellKey], witnesses: &[Witness],
  values: &[Value], candidates: &[ThroughResultCandidate]) -> bool {
  let candidate = match policy.port.authority { TransferAuthority.ThroughResult {candidate, ..} => candidate
    _ => { return false } }
  if candidate >= candidates.length || policy.outputCase >= cases.length || policy.sourceCell >= keys.length {
    return CompilerBug.panic(b"through reset lost its actual candidate or Case")
  }
  let selected = candidates[candidate]
  if let TransferAuthority.ThroughResult {read, ..} = policy.port.authority {
    if read.index != selected.read.index { return CompilerBug.panic(b"through reset policy changed its original read witness") }
  }
  let actual = &cases[policy.outputCase]
  let source = match actual.source { Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"through reset substituted a source seed") } }
  if source != policy.sourceCell || actual.target >= keys.length { return CompilerBug.panic(b"through reset changed its paired cells") }
  let before = keys[source]
  let after = keys[actual.target]
  let witness = &witnesses[before.witness]
  let sameDefinition = match witness.definition {
    Option<DefinitionId>.Some {value} => match policy.port.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
  }
  let sameRead = match witness.read { Option<ReadId>.Some {value} => value.index == selected.read.index
    && match policy.port.read { Option<ReadId>.Some {value: other} => other.index == value.index _ => false } _ => false }
  if policy.port.outputRole != SourceRole.Ownership || after.category != SourceRole.Ownership || before.category != policy.port.category
    || before.value.index != selected.source.index || after.value.index != selected.target.index
    || policy.port.source.index != selected.source.index || policy.port.target.index != selected.target.index
    || before.leaf.index != policy.port.leaf.index || after.leaf.index != before.leaf.index
    || before.witness != after.witness || !sameDefinition || !sameRead
    || before.direct != policy.port.direct || after.direct || policy.port.outputDirect
    || values[after.value.index].endpoint.index != selected.root.index {
    return CompilerBug.panic(b"through reset changed its exact source role, witness or whole result")
  }
  match actual.authority {
    TransferAuthority.ThroughResult {candidate: other, read} => {
      if other != candidate || read.index != selected.read.index { return CompilerBug.panic(b"through reset substituted another read flight") }
    }
    _ => { return CompilerBug.panic(b"through reset lost its exact result Case authority") }
  }
  return true
}

effect fn reserveThroughOwnershipResets<'body>(product: &mut OwnershipPublications,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<ThroughOwnershipReset>.length(&product.throughResets)
  let policies = List<PendingPolicy>.asSlice(&domain.policies)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let values = List<Value>.asSlice(&skeleton.values)
  let candidates = List<ThroughResultCandidate>.asSlice(&skeleton.throughResultCandidates)
  let mut at = usize.ZERO
  while at < policies.length {
    let policy = policies[at]
    if !isThroughOwnershipReset(&product.*, policy.outputCase)
      && throughOwnershipResetCase(policy, cases, keys, witnesses, values, candidates) {
      let candidate = match policy.port.authority { TransferAuthority.ThroughResult {candidate, ..} => candidate
        _ => { return CompilerBug.panic(b"through reset changed authority during reservation") } }
      validateThroughResultCandidate(prepared, &skeleton.*, candidates[candidate])
      let actual = &cases[policy.outputCase]
      let target = keys[actual.target]
      let root = candidates[candidate].root
      let reset = List<ThroughOwnershipReset>.length(&product.throughResets)
      let origin = List<OwnershipOrigin>.length(&product.origins)
      let accepted = Program.atom(&mut skeleton.rules)
      let active = Program.atom(&mut skeleton.rules)
      let admitted: [Atom; 2] = [actual.active, accepted]
      run Program.rule(&mut skeleton.rules, active, &admitted, &[])
      run List<OwnershipOrigin>.append(&mut product.origins,
        OwnershipOrigin.ThroughReset {reset: reset, category: target.category, root: root, active: active})
      let placement = OwnershipPlacement.Known {anchor: root, suffix: Option<OwnershipSuffix>.none()}
      let publication = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
        origin, placement, placement, actual.target)
      let seed: [Atom; 1] = [active]
      run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[publication].active, &seed, &[])
      run List<ThroughOwnershipReset>.append(&mut product.throughResets, ThroughOwnershipReset {
        candidate: candidate, case: policy.outputCase, source: policy.port.source, target: target.value, root: root,
        sourceRole: policy.port.category, outputRole: target.category, leaf: target.leaf, direct: policy.port.direct,
        definition: policy.port.definition, read: policy.port.read, publication: publication,
        sourceActive: cells[policy.sourceCell].present, applicable: policy.port.quality.present, accepted: accepted,
        sourceCell: policy.sourceCell, targetCell: actual.target})
    }
    at = at + usize.ONE
  }
  return before != List<ThroughOwnershipReset>.length(&product.throughResets)
}

fn isThroughOwnershipReset(product: &OwnershipPublications, case: usize) -> bool {
  let rows = List<ThroughOwnershipReset>.asSlice(&product.throughResets)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].case == case { return true }
    at = at + usize.ONE
  }
  return false
}

fn ordinaryOwnershipResetCase(policy: PendingPolicy, cases: &[Case], keys: &[CellKey], witnesses: &[Witness],
  values: &[Value], candidates: &[OrdinaryResultCandidate]) -> bool {
  let candidate = match policy.port.authority { TransferAuthority.OrdinaryResult {candidate, ..} => candidate
    _ => { return false } }
  if candidate >= candidates.length || policy.outputCase >= cases.length || policy.sourceCell >= keys.length {
    return CompilerBug.panic(b"ordinary result publication lost its actual candidate or Case")
  }
  let selected = candidates[candidate]
  let actual = &cases[policy.outputCase]
  let source = match actual.source { Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"ordinary result publication substituted a source seed") } }
  if source != policy.sourceCell || actual.target >= keys.length { return CompilerBug.panic(b"ordinary result publication changed its paired cells") }
  let before = keys[source]
  let after = keys[actual.target]
  let witness = &witnesses[before.witness]
  let sameDefinition = match witness.definition {
    Option<DefinitionId>.Some {value} => match policy.port.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
  }
  let sameRead = match witness.read {
    Option<ReadId>.Some {value} => match policy.port.read { Option<ReadId>.Some {value: other} => other.index == value.index _ => false }
    _ => match policy.port.read { Option<ReadId>.None => true _ => false }
  }
  if policy.port.outputRole != SourceRole.Ownership || after.category != SourceRole.Ownership || before.category != policy.port.category
    || before.value.index != selected.source.index || after.value.index != selected.target.index
    || policy.port.source.index != selected.source.index || policy.port.target.index != selected.target.index
    || before.leaf.index != policy.port.leaf.index || after.leaf.index != before.leaf.index
    || before.witness != after.witness || !sameDefinition || !sameRead
    || before.direct != policy.port.direct || after.direct || policy.port.outputDirect
    || values[after.value.index].endpoint.index != selected.root.index {
    return CompilerBug.panic(b"ordinary result publication changed its exact source role, witness or whole result")
  }
  match actual.authority {
    TransferAuthority.OrdinaryResult {candidate: other} => {
      if other != candidate { return CompilerBug.panic(b"ordinary result publication substituted another operand finish") }
    }
    _ => { return CompilerBug.panic(b"ordinary result publication lost its exact result Case authority") }
  }
  return true
}

effect fn reserveOrdinaryOwnershipResets<'body>(product: &mut OwnershipPublications,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<OrdinaryOwnershipReset>.length(&product.ordinaryResets)
  let policies = List<PendingPolicy>.asSlice(&domain.policies)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let values = List<Value>.asSlice(&skeleton.values)
  let candidates = List<OrdinaryResultCandidate>.asSlice(&skeleton.ordinaryResultCandidates)
  let mut at = usize.ZERO
  while at < policies.length {
    let policy = policies[at]
    if !isOrdinaryOwnershipReset(&product.*, policy.outputCase)
      && ordinaryOwnershipResetCase(policy, cases, keys, witnesses, values, candidates) {
      let candidate = match policy.port.authority { TransferAuthority.OrdinaryResult {candidate, ..} => candidate
        _ => { return CompilerBug.panic(b"ordinary result publication changed authority during reservation") } }
      validateOrdinaryResultCandidate(prepared, &skeleton.*, candidates[candidate])
      let actual = &cases[policy.outputCase]
      let target = keys[actual.target]
      let root = candidates[candidate].root
      let reset = List<OrdinaryOwnershipReset>.length(&product.ordinaryResets)
      let origin = List<OwnershipOrigin>.length(&product.origins)
      let accepted = Program.atom(&mut skeleton.rules)
      let active = Program.atom(&mut skeleton.rules)
      let admitted: [Atom; 2] = [actual.active, accepted]
      run Program.rule(&mut skeleton.rules, active, &admitted, &[])
      run List<OwnershipOrigin>.append(&mut product.origins,
        OwnershipOrigin.OrdinaryReset {reset: reset, category: target.category, root: root, active: active})
      let placement = OwnershipPlacement.Known {anchor: root, suffix: Option<OwnershipSuffix>.none()}
      let publication = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
        origin, placement, placement, actual.target)
      let seed: [Atom; 1] = [active]
      run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[publication].active, &seed, &[])
      run List<OrdinaryOwnershipReset>.append(&mut product.ordinaryResets, OrdinaryOwnershipReset {
        demand: candidates[candidate].demand, candidate: candidate, case: policy.outputCase, source: policy.port.source, target: target.value, root: root,
        sourceRole: policy.port.category, outputRole: target.category, leaf: target.leaf, direct: policy.port.direct,
        definition: policy.port.definition, read: policy.port.read, publication: publication,
        sourceActive: cells[policy.sourceCell].present, applicable: policy.port.quality.present, accepted: accepted,
        sourceCell: policy.sourceCell, targetCell: actual.target})
    }
    at = at + usize.ONE
  }
  return before != List<OrdinaryOwnershipReset>.length(&product.ordinaryResets)
}

fn isOrdinaryOwnershipReset(product: &OwnershipPublications, case: usize) -> bool {
  let rows = List<OrdinaryOwnershipReset>.asSlice(&product.ordinaryResets)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].case == case { return true }
    at = at + usize.ONE
  }
  return false
}

fn rvalueDereferencePublicationCase(policy: PendingPolicy, cases: &[Case], keys: &[CellKey], witnesses: &[Witness],
  values: &[Value], candidates: &[RvalueDereferenceResult]) -> bool {
  let candidate = match policy.port.authority { TransferAuthority.RvalueDereferenceResult {candidate, ..} => candidate
    _ => { return false } }
  if candidate >= candidates.length || policy.outputCase >= cases.length || policy.sourceCell >= keys.length {
    return CompilerBug.panic(b"rvalue dereference publication lost its actual candidate or Case")
  }
  let selected = candidates[candidate]
  let actual = &cases[policy.outputCase]
  let source = match actual.source { Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"rvalue dereference publication substituted a source seed") } }
  if source != policy.sourceCell || actual.target >= keys.length { return CompilerBug.panic(b"rvalue dereference publication changed its paired cells") }
  let before = keys[source]
  let after = keys[actual.target]
  let witness = &witnesses[before.witness]
  let sameDefinition = match witness.definition {
    Option<DefinitionId>.Some {value} => match policy.port.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
  }
  let sameRead = match witness.read {
    Option<ReadId>.Some {value} => match policy.port.read { Option<ReadId>.Some {value: other} => other.index == value.index _ => false }
    _ => match policy.port.read { Option<ReadId>.None => true _ => false }
  }
  if policy.port.outputRole != SourceRole.Ownership || after.category != SourceRole.Ownership || before.category != policy.port.category
    || before.value.index != selected.source.index || after.value.index != selected.target.index
    || policy.port.source.index != selected.source.index || policy.port.target.index != selected.target.index
    || before.leaf.index != policy.port.leaf.index || after.leaf.index != before.leaf.index
    || before.witness != after.witness || !sameDefinition || !sameRead
    || before.direct != policy.port.direct || after.direct || policy.port.outputDirect
    || values[after.value.index].endpoint.index != selected.root.index {
    return CompilerBug.panic(b"rvalue dereference publication changed its exact source role, witness or whole result")
  }
  match actual.authority {
    TransferAuthority.RvalueDereferenceResult {candidate: other} => {
      if other != candidate { return CompilerBug.panic(b"rvalue dereference publication substituted another operand finish") }
    }
    _ => { return CompilerBug.panic(b"rvalue dereference publication lost its exact result Case authority") }
  }
  return true
}

effect fn reserveRvalueDereferencePublications<'body>(product: &mut OwnershipPublications,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<RvalueDereferencePublication>.length(&product.rvalueDereferences)
  let policies = List<PendingPolicy>.asSlice(&domain.policies)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let values = List<Value>.asSlice(&skeleton.values)
  let candidates = List<RvalueDereferenceResult>.asSlice(&skeleton.rvalueDereferenceResults)
  let mut at = usize.ZERO
  while at < policies.length {
    let policy = policies[at]
    if !isRvalueDereferencePublication(&product.*, policy.outputCase)
      && rvalueDereferencePublicationCase(policy, cases, keys, witnesses, values, candidates) {
      let candidate = match policy.port.authority { TransferAuthority.RvalueDereferenceResult {candidate, ..} => candidate
        _ => { return CompilerBug.panic(b"rvalue dereference publication changed authority during reservation") } }
      validateRvalueDereferenceResult(prepared, &skeleton.*, candidates[candidate])
      let actual = &cases[policy.outputCase]
      let target = keys[actual.target]
      let root = candidates[candidate].root
      let reset = List<RvalueDereferencePublication>.length(&product.rvalueDereferences)
      let origin = List<OwnershipOrigin>.length(&product.origins)
      let accepted = Program.atom(&mut skeleton.rules)
      let active = Program.atom(&mut skeleton.rules)
      let admitted: [Atom; 2] = [actual.active, accepted]
      run Program.rule(&mut skeleton.rules, active, &admitted, &[])
      run List<OwnershipOrigin>.append(&mut product.origins,
        OwnershipOrigin.RvalueDereference {reset: reset, category: target.category, root: root, active: active})
      let placement = OwnershipPlacement.Known {anchor: root, suffix: Option<OwnershipSuffix>.none()}
      let publication = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
        origin, placement, placement, actual.target)
      let seed: [Atom; 1] = [active]
      run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[publication].active, &seed, &[])
      run List<RvalueDereferencePublication>.append(&mut product.rvalueDereferences, RvalueDereferencePublication {
        candidate: candidate, case: policy.outputCase, source: policy.port.source, target: target.value, root: root,
        sourceRole: policy.port.category, outputRole: target.category, leaf: target.leaf, direct: policy.port.direct,
        definition: policy.port.definition, read: policy.port.read, publication: publication,
        sourceActive: cells[policy.sourceCell].present, applicable: policy.port.quality.present, accepted: accepted,
        sourceCell: policy.sourceCell, targetCell: actual.target})
    }
    at = at + usize.ONE
  }
  return before != List<RvalueDereferencePublication>.length(&product.rvalueDereferences)
}

fn isRvalueDereferencePublication(product: &OwnershipPublications, case: usize) -> bool {
  let rows = List<RvalueDereferencePublication>.asSlice(&product.rvalueDereferences)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].case == case { return true }
    at = at + usize.ONE
  }
  return false
}

fn isOperationOwnershipReset(product: &OwnershipPublications, case: usize) -> bool {
  let rows = List<OperationOwnershipReset>.asSlice(&product.resets)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].case == case { return true }
    at = at + usize.ONE
  }
  return false
}

// Exact admitted writes restart the original held placement at the next summary read.
// ReferenceHolding instead starts the specifically referencedPath-transformed placement.
fn ownershipPlacementDefinition(authority: TransferAuthority, target: Value) -> bool {
  if let TransferAuthority.ReferenceHolding {..} = authority { return true }
  if let TransferAuthority.MoveHolding {..} = authority { return true }
  if let TransferAuthority.FieldRehold {..} = authority { return true }
  let summary = match target.summary { Option<usize>.Some {..} => true _ => false }
  return summary && match authority {
    TransferAuthority.OwnershipMirror {..} => true
    TransferAuthority.OrdinarySummary {..} => true
    TransferAuthority.RetainedWrite {..} => true
    TransferAuthority.InvocationWrite {..} => true
    _ => false
  }
}

// Shared reservation/terminal read views use original Flow arrays; no second reaching graph.
effect fn closeOwnershipPublications<'body>(product: &mut OwnershipPublications,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain) -> bool
! OutOfMemoryError ? &mut Allocator {
  let beforeOrigins = List<OwnershipOrigin>.length(&product.origins)
  let beforeValues = List<OwnershipPublication>.length(&product.values)
  let beforeGaps = List<OwnershipPublicationGap>.length(&product.gaps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  // Preserve the original ascending Case order while visiting only exact predecessors.
  let cases = List<Case>.asSlice(&domain.cases)
  let mut bySource = List<List<usize>>.make()
  let mut indexedCell = usize.ZERO
  while indexedCell < keys.length {
    run List<List<usize>>.append(&mut bySource, List<usize>.make())
    indexedCell = indexedCell + usize.ONE
  }
  let mut indexedCase = usize.ZERO
  while indexedCase < cases.length {
    if let Option<usize>.Some {value: source} = cases[indexedCase].source {
      let rows = List<List<usize>>.asMutSlice(&mut bySource)
      run List<usize>.append(&mut rows[source], indexedCase)
    }
    indexedCase = indexedCase + usize.ONE
  }
  let definitions = List<DefinedValue>.asSlice(&skeleton.definitions)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let valuesBefore = List<Value>.asSlice(&skeleton.values)
  let mut reading = usize.ZERO
  while reading < summaryReads.length {
    let read = summaryReads[reading].read
    let placements = run readPlacementsByRead(prepared, Flow.reservedReads(&skeleton.flow), Flow.reservedPoints(&skeleton.flow),
      List<Storage>.asSlice(&skeleton.storage), List<ReadValue>.asSlice(&skeleton.reads), valuesBefore,
      List<Evaluation>.asSlice(&skeleton.evaluations), List<StorageAlias>.asSlice(&skeleton.aliases),
      List<AliasTransport>.asSlice(&skeleton.aliasTransports), List<AliasRead>.asSlice(&skeleton.aliasReads), summaryReads, read)
    let placementsSelected = List<ReadPlacement>.asSlice(&placements)
    let mut placement = usize.ZERO
    while placement < placementsSelected.length {
      let selected = placementsSelected[placement]
      let family = run transferFamily(endpoints, maps, selected.map)
      let members = List<MapId>.asSlice(&family)
      let indexed = List<usize>.asSlice(&List<List<usize>>.asSlice(&domain.cellsByValue)[selected.consumer.index])
      let mut cursor = usize.ZERO
      while cursor < indexed.length {
        let cell = indexed[cursor]
        let key = keys[cell]
        let witness = &witnesses[key.witness]
        let paired = match witness.read { Option<ReadId>.Some {value} => value.index == read.index _ => false }
        if key.value.index == selected.consumer.index && paired {
          if let Option<DefinitionId>.Some {value: definition} = witness.definition {
            if definition.index >= definitions.length { CompilerBug.panic(b"ownership publication has no original definition") }
            let exact = match definitions[definition.index].summary {
              Option<usize>.Some {value} => value == summaryReads[reading].summary
              _ => false
            }
            if !exact { CompilerBug.panic(b"ownership publication crossed a canonical summary lane") }
            let origins = List<OwnershipOrigin>.asSlice(&product.origins)
            let mut old = usize.ZERO
            while old < origins.length {
              if let OwnershipOrigin.Read {placement: prior, cell: previous, ..} = origins[old] {
                if previous == cell && prior.read.index == read.index && prior.map.index == selected.map.index
                  && prior.consumer.index == selected.consumer.index && Atom.same(prior.active, selected.active) { break }
              }
              old = old + usize.ONE
            }
            if old == origins.length {
              let held = summaries[summaryReads[reading].summary]
              let active = Program.atom(&mut skeleton.rules)
              let admitted: [Atom; 2] = [selected.active, cells[cell].present]
              run Program.rule(&mut skeleton.rules, active, &admitted, &[])
              run List<OwnershipOrigin>.append(&mut product.origins, OwnershipOrigin.Read {category: key.category, placement: selected,
                storage: held.prefix, held: held.placement, definition: definition,
                leaf: key.leaf, direct: key.direct, active: active, cell: cell})
              let mut member = usize.ZERO
              // A selected B can observe an ancestor A with semantic MAX placement.
              // Keep that tagged alternative separate; policy compares the original A/B
              // before selecting it, never as a fallback for a missing known counterpart.
              let width = match held.placement {
                OwnershipPlacement.Position {position, offset, ..} =>
                  List<OwnershipPositionStep>.length(&List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions)[position.index].steps) - offset + usize.ONE
                _ => usize.ONE
              }
              let count = match held.placement { OwnershipPlacement.Unknown => usize.ONE _ => members.length * width + usize.ONE }
              while member < count {
                let mut initial = OwnershipPlacement.Unknown
                match held.placement {
                  OwnershipPlacement.Unknown => ()
                  OwnershipPlacement.Position {position, offset, ..} => {
                    if member != members.length * width {
                      initial = OwnershipPlacement.Position {anchor: maps[members[member / width].index].target,
                        position: position, offset: offset + member % width}
                    }
                  }
                  OwnershipPlacement.Known {suffix, ..} => {
                    if member != members.length {
                      initial = OwnershipPlacement.Known {anchor: maps[members[member].index].target, suffix: suffix}
                    }
                  }
                }
                let node = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules, old, initial, initial, cell)
                let seed: [Atom; 1] = [active]
                run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[node].active, &seed, &[])
                member = member + usize.ONE
              }
            }
          }
        }
        cursor = cursor + usize.ONE
      }
      placement = placement + usize.ONE
    }
    reading = reading + usize.ONE
  }
  let holdings = List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings)
  let referenceReads = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let mut actual = usize.ZERO
  while actual < cases.length {
    if let TransferAuthority.ReferenceHolding {candidate} = cases[actual].authority {
      let holding = holdings[candidate]
      let source = match cases[actual].source { Option<usize>.Some {value} => value
        _ => { return CompilerBug.panic(b"reference holding has no actual source Case") } }
      let key = keys[source]
      let witness = &witnesses[key.witness]
      let origins = List<OwnershipOrigin>.asSlice(&product.origins)
      let mut old = usize.ZERO
      while old < origins.length {
        if let OwnershipOrigin.Reference {case, ..} = origins[old] { if case == actual { break } }
        old = old + usize.ONE
      }
      if old == origins.length {
        let original = referenceReads[holding.referenceRead]
        let mut storage = original.storage
        let mut held = OwnershipPlacement.Known {anchor: storage.endpoint, suffix: Option<OwnershipSuffix>.none()}
        let mut exact = match witness.read { Option<ReadId>.Some {value} => value.index == original.read.index _ => false }
        if let Option<DefinitionId>.Some {value: definition} = witness.definition {
          if let Option<usize>.Some {value: summary} = definitions[definition.index].summary {
            storage = summaries[summary].prefix
            held = summaries[summary].placement
            exact = false
            let mut at = usize.ZERO
            while at < summaryReads.length {
              if summaryReads[at].summary == summary && summaryReads[at].original.index == original.read.index {
                if let Option<ReadId>.Some {value} = witness.read {
                  if value.index == summaryReads[at].read.index { exact = true }
                }
              }
              at = at + usize.ONE
            }
          }
        }
        if !exact { return CompilerBug.panic(b"reference holding lost its acquisition read pairing") }
        run List<OwnershipOrigin>.append(&mut product.origins, OwnershipOrigin.Reference {
          category: key.category, candidate: candidate, case: actual, source: holding.source, target: holding.target,
          storage: storage, held: held, leaf: key.leaf, direct: key.direct,
          definition: witness.definition, read: witness.read, active: cases[actual].active})
        let node = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
          old, holding.placement, holding.placement, cases[actual].target)
        let seed: [Atom; 1] = [cases[actual].active]
        run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[node].active, &seed, &[])
      }
    }
    actual = actual + usize.ONE
  }
  actual = usize.ZERO
  while actual < cases.length {
    if let TransferAuthority.MoveHolding {candidate} = cases[actual].authority {
      let holding = List<MoveHolding>.asSlice(&skeleton.selectedMoves.holdings)[candidate]
      let source = match cases[actual].source { Option<usize>.Some {value} => value
        _ => { return CompilerBug.panic(b"Move holding omitted its genuine input cell") } }
      let origins = List<OwnershipOrigin>.asSlice(&product.origins)
      let mut old = usize.ZERO
      while old < origins.length {
        if let OwnershipOrigin.Move {case, ..} = origins[old] { if case == actual { break } }
        old = old + usize.ONE
      }
      if old == origins.length {
        let key = keys[source]
        run List<OwnershipOrigin>.append(&mut product.origins, OwnershipOrigin.Move {
          category: key.category, candidate: candidate, case: actual, source: holding.source, target: holding.target,
          storage: holding.storage, held: holding.held, leaf: key.leaf, direct: key.direct,
          definition: holding.definition, read: holding.read, active: cases[actual].active})
        let node = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
          old, holding.placement, holding.placement, cases[actual].target)
        let seed: [Atom; 1] = [cases[actual].active]
        run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[node].active, &seed, &[])
      }
    }
    actual = actual + usize.ONE
  }
  run reserveFieldReads(&mut product.*, prepared, &mut skeleton.*, domain)
  run reserveCaptureReborrowPublications(&mut product.*, &mut skeleton.*, domain)
  let reset = run reserveOperationOwnershipResets(&mut product.*, prepared, &mut skeleton.*, domain)
  let throughReset = run reserveThroughOwnershipResets(&mut product.*, prepared, &mut skeleton.*, domain)
  let fieldResults = run reserveFieldResultPublications(&mut product.*, &mut skeleton.*, domain)
  let ordinaryReset = run reserveOrdinaryOwnershipResets(&mut product.*, prepared, &mut skeleton.*, domain)
  let rvalueReset = run reserveRvalueDereferencePublications(&mut product.*, prepared, &mut skeleton.*, domain)
  let values = List<Value>.asSlice(&skeleton.values)
  let mut node = usize.ZERO
  while node < List<OwnershipPublication>.length(&product.values) {
    let source = List<OwnershipPublication>.asSlice(&product.values)[node]
    let outgoing = List<usize>.asSlice(&List<List<usize>>.asSlice(&bySource)[source.cell])
    let mut next = usize.ZERO
    while next < outgoing.length && outgoing[next] < source.scanned { next = next + usize.ONE }
    while next < outgoing.length {
      actual = outgoing[next]
      if !ownershipPlacementDefinition(cases[actual].authority, values[keys[cases[actual].target].value.index])
        && !isOperationOwnershipReset(&product.*, actual) && !isThroughOwnershipReset(&product.*, actual) && !isRvalueDereferencePublication(&product.*, actual) && !isOrdinaryOwnershipReset(&product.*, actual) && !isFieldResultCase(cases[actual].authority) {
        let target = keys[cases[actual].target]
        let from = values[source.value.index]
        let into = values[target.value.index]
        let mut mapped = false
        let physical = match from.subject { Option<ResidualSubject>.None => true _ => false }
          && match into.subject { Option<ResidualSubject>.None => true _ => false }
        if physical {
          match cases[actual].authority {
            TransferAuthority.CaptureReborrow {origin, placement} => {
              let captured = List<CaptureReborrowOrigin>.asSlice(&skeleton.captureReborrowData.origins)[origin]
              let map = &maps[placement.index]
              if captured.descriptor.index != source.value.index || captured.target.index != target.value.index
                || captured.leaf.index != source.leaf.index || source.category != SourceRole.Ownership {
                CompilerBug.panic(b"capture publication substituted another acquisition")
              }
              if let Option<EndpointId>.Some {value: anchor} = ownershipAnchor(source.placement) {
                if anchor.index == map.source.index {
                  run ownershipPublicationEdge(&mut product.*, domain, &mut skeleton.rules, node, cases[actual].target,
                    ownershipAt(source.placement, map.target), actual, Option<MapId>.some(placement))
                  mapped = true
                }
              }
            }
            TransferAuthority.SameComponent => {
              if from.endpoint.index != into.endpoint.index { CompilerBug.panic(b"ownership identity changed its physical component") }
              run ownershipPublicationEdge(&mut product.*, domain, &mut skeleton.rules, node, cases[actual].target,
                source.placement, actual, Option<MapId>.none())
              mapped = true
            }
            TransferAuthority.Physical {map, direction, ..} => {
              let physical = &maps[map.index]
              let authentic = (physical.componentTransport || physical.addressTransport)
                && match &physical.selector { Selector.Identity => true _ => false }
              if authentic {
                let family = run transferFamily(endpoints, maps, map)
                let members = List<MapId>.asSlice(&family)
                if let OwnershipPlacement.Unknown = source.placement {
                  run ownershipPublicationEdge(&mut product.*, domain, &mut skeleton.rules, node, cases[actual].target,
                    OwnershipPlacement.Unknown, actual, Option<MapId>.some(map))
                  mapped = true
                } else if let Option<EndpointId>.Some {value: anchor} = ownershipAnchor(source.placement) {
                  let mut member = usize.ZERO
                  while member < members.length {
                    let mapping = &maps[members[member].index]
                    let mut input = mapping.source
                    let mut output = mapping.target
                    if direction == MapDirection.StorageInverse { input = mapping.target output = mapping.source }
                    if input.index == anchor.index {
                      run ownershipPublicationEdge(&mut product.*, domain, &mut skeleton.rules, node, cases[actual].target,
                        ownershipAt(source.placement, output), actual, Option<MapId>.some(members[member]))
                      mapped = true
                    }
                    member = member + usize.ONE
                  }
                }
              }
            }
            _ => ()
          }
        }
        if !mapped {
          run ownershipPublicationGap(&mut product.*, domain, &mut skeleton.rules, source.origin, source.initial,
            cases[actual].target, source.active, cases[actual].active)
        }
      }
      next = next + usize.ONE
    }
    let mutableRows1 = List<OwnershipPublication>.asMutSlice(&mut product.values)
    mutableRows1[node].scanned = cases.length
    node = node + usize.ONE
  }
  // A lost known counterpart remains a gap; it is never coerced into Unknown.
  let mut gap = usize.ZERO
  while gap < List<OwnershipPublicationGap>.length(&product.gaps) {
    let source = List<OwnershipPublicationGap>.asSlice(&product.gaps)[gap]
    let outgoing = List<usize>.asSlice(&List<List<usize>>.asSlice(&bySource)[source.cell])
    let mut next = usize.ZERO
    while next < outgoing.length && outgoing[next] < source.scanned { next = next + usize.ONE }
    while next < outgoing.length {
      actual = outgoing[next]
      if !ownershipPlacementDefinition(cases[actual].authority, values[keys[cases[actual].target].value.index])
        && !isOperationOwnershipReset(&product.*, actual) && !isThroughOwnershipReset(&product.*, actual) && !isRvalueDereferencePublication(&product.*, actual) && !isOrdinaryOwnershipReset(&product.*, actual) && !isFieldResultCase(cases[actual].authority) {
        run ownershipPublicationGap(&mut product.*, domain, &mut skeleton.rules, source.origin, source.initial,
          cases[actual].target, source.active, cases[actual].active)
      }
      next = next + usize.ONE
    }
    let mutableRows2 = List<OwnershipPublicationGap>.asMutSlice(&mut product.gaps)
    mutableRows2[gap].scanned = cases.length
    gap = gap + usize.ONE
  }
  return fieldResults || ordinaryReset || rvalueReset || throughReset || reset || beforeOrigins != List<OwnershipOrigin>.length(&product.origins)
    || beforeValues != List<OwnershipPublication>.length(&product.values)
    || beforeGaps != List<OwnershipPublicationGap>.length(&product.gaps)
}

/// Deferred address consumers are recorded at their actual execution points. Candidate
/// closure may discover another address history later; it extends this same operation's
/// destination gate instead of creating a second store or rereading a prior snapshot.
union AliasOperationKind {
  Project { map: MapId, source: EvalId, target: EvalId, write: Write },
  Read { map: MapId, source: EvalId, target: EvalId, active: Atom },
  Write { map: MapId, source: EvalId, address: EvalId, target: EvalId, active: Atom },
  Invalidate { address: EvalId, root: EndpointId, target: EvalId, origin: Origin, active: Atom },
}
impl Copy for AliasOperationKind {}
struct AliasOperation {
  kind: AliasOperationKind
  closed: usize
}
impl Copy for AliasOperation {}
struct AliasDefinition {
  operation: usize
  storage: Storage
  active: Atom
  definition: DefinitionId
}

/// A real referent reborrow of an already evaluated capture descriptor. The descriptor's
/// physical Place is unchanged; this loan is an ownership holding, never a new address.
pub struct CaptureReborrowOrigin {
  pub prepared: usize
  pub result: EvalId
  pub source: EvalId
  pub input: usize
  pub usePoint: PointId
  pub acquisition: EvalId
  pub loan: usize
  pub leaf: LeafId
  pub descriptor: ValueId
  pub target: ValueId
  pub active: Atom
}
impl Copy for CaptureReborrowOrigin {}
/// Exact co-travelling descriptor evidence. Original and current Cases are primitive graph
/// ordinals; a recursive path or an equal lifetime never identifies this correspondence.
pub struct CaptureReborrowDescriptor {
  pub origin: usize
  pub originalCase: usize
  pub placementCase: usize
  pub case: usize
  pub current: InvocationCaptureCell
  pub physicalCase: usize
  pub physical: InvocationCaptureCell
  pub active: Atom
}
impl Copy for CaptureReborrowDescriptor {}
struct CaptureReborrows {
  origins: List<CaptureReborrowOrigin>
  descriptors: List<CaptureReborrowDescriptor>
  byValue: List<List<usize>>
}
impl CaptureReborrows {
  fn make() -> Self { return CaptureReborrows {origins: List<CaptureReborrowOrigin>.make(),
    descriptors: List<CaptureReborrowDescriptor>.make(), byValue: List<List<usize>>.make()} }
}

impl Skeleton {
  pub fn captureReborrows(self: &Self) -> &[CaptureReborrowOrigin] { return List<CaptureReborrowOrigin>.asSlice(&self.captureReborrowData.origins) }
  pub effect fn captureReborrow<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, record: usize,
    result: EvalId, source: EvalId, input: usize, usePoint: PointId,
    acquisition: ReferenceAcquisition, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let rows = List<Prepared.CaptureReborrow>.asSlice(&prepared.captureReborrows)
    if record >= rows.length { return CompilerBug.panic(b"capture reborrow lost its frozen typed occurrence") }
    let selected = &rows[record]
    Prepared.validateCaptureReborrow(prepared, selected)
    let map = &List<SelectionMap>.asSlice(&prepared.maps)[selected.placement.index]
    let ordinal = match selected.read { InputRead.Field {ordinal} => ordinal
      _ => { return CompilerBug.panic(b"capture reborrow is not an actual field operand") } }
    let acquired = Skeleton.evaluation(&self.*, acquisition.evaluation)
    let returned = Skeleton.evaluation(&self.*, result)
    let operand = Skeleton.evaluation(&self.*, source)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let operandNode = match endpoints[map.source.index].root { Root.Node {node, ..} => node
      _ => { return CompilerBug.panic(b"capture reborrow source is not its actual operand") } }
    let acquiredHere = match acquired.site { EvaluationSite.Node {node} => node.index == selected.site.index _ => false }
    let returnedHere = match returned.site { EvaluationSite.Node {node} => node.index == selected.site.index _ => false }
    let operandHere = match operand.site { EvaluationSite.Node {node} => node.index == operandNode.index _ => false }
    if !acquiredHere || !returnedHere || !operandHere || ordinal != input
      || acquired.category != EvaluationRole.Capture || acquired.point.index != usePoint.index
      || acquisition.evaluation.index == result.index {
      return CompilerBug.panic(b"capture reborrow changed its actual input acquisition occurrence")
    }
    let previous = List<CaptureReborrowOrigin>.asSlice(&self.captureReborrowData.origins)
    let mut at = usize.ZERO
    while at < previous.length {
      if previous[at].loan == acquisition.loan || (previous[at].result.index == result.index && previous[at].prepared == record) {
        return CompilerBug.panic(b"capture reborrow repeated its original acquisition")
      }
      at = at + usize.ONE
    }
    let origin = previous.length
    let existingLeaves = List<Leaf>.asSlice(&self.leaves)
    at = usize.ZERO
    while at < existingLeaves.length {
      if let SourceLeaf.Borrow {loan, ..} = &existingLeaves[at].kind {
        if loan == acquisition.loan { return CompilerBug.panic(b"one loan was created by two acquisition authorities") }
      }
      at = at + usize.ONE
    }
    let descriptor = run Skeleton.value(&mut self.*, acquisition.evaluation, map.source)
    let target = run Skeleton.value(&mut self.*, result, map.target)
    let absent = Program.atom(&mut self.rules)
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Borrow {loan: acquisition.loan,
      node: Option<NodeId>.some(selected.site)}, origin: map.origin, endpoint: map.source})
    run List<Seed>.append(&mut self.seeds, Seed {category: SourceRole.Ownership, value: descriptor,
      leaf: leaf, direct: true, active: active, stored: absent, alternatives: absent})
    run List<CaptureReborrowOrigin>.append(&mut self.captureReborrowData.origins,
      CaptureReborrowOrigin {prepared: record, result: result, source: source, input: input, usePoint: usePoint,
        acquisition: acquisition.evaluation, loan: acquisition.loan, leaf: leaf, descriptor: descriptor, target: target, active: active})
    run List<Transfer>.append(&mut self.transfers, Transfer {source: descriptor, target: target,
      active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical,
      terminal: false, authority: TransferAuthority.CaptureReborrow {origin: origin, placement: selected.placement}})
    return descriptor
  }
}

// Fresh field0/direct capture holdings participate in the existing publication product.
// Their original acquisition seed has no definition/read; this does not invent a storage read.
effect fn reserveCaptureReborrowPublications(product: &mut OwnershipPublications,
  skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let origins = List<CaptureReborrowOrigin>.asSlice(&skeleton.captureReborrowData.origins)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let mut origin = usize.ZERO
  while origin < origins.length {
    let selected = origins[origin]
    let mut actual = usize.ZERO
    while actual < cases.length {
      let key = keys[cases[actual].target]
      let seed = match cases[actual].source { Option<usize>.None => true _ => false }
      if seed && key.category == SourceRole.Ownership && key.value.index == selected.descriptor.index && key.leaf.index == selected.leaf.index {
        let prior = List<OwnershipOrigin>.asSlice(&product.origins)
        let mut found = usize.ZERO
        while found < prior.length {
          if let OwnershipOrigin.CaptureReborrow {origin: old, case, ..} = prior[found] {
            if old == origin && case == actual { break }
          }
          found = found + usize.ONE
        }
        if found == prior.length {
          let active = cases[actual].active
          run List<OwnershipOrigin>.append(&mut product.origins, OwnershipOrigin.CaptureReborrow {origin: origin, case: actual, active: active})
          let root = List<Value>.asSlice(&skeleton.values)[selected.descriptor.index].endpoint
          let initial = OwnershipPlacement.Known {anchor: root, suffix: Option<OwnershipSuffix>.none()}
          let node = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules, found, initial, initial, cases[actual].target)
          run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[node].active, &[active], &[])
        }
      }
      actual = actual + usize.ONE
    }
    origin = origin + usize.ONE
  }
  return ()
}

fn captureSameDefinition(left: Option<DefinitionId>, right: Option<DefinitionId>) -> bool {
  return match left { Option<DefinitionId>.Some {value} => match right {
    Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<DefinitionId>.None => true _ => false } }
}
fn captureSameRead(left: Option<ReadId>, right: Option<ReadId>) -> bool {
  return match left { Option<ReadId>.Some {value} => match right {
    Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<ReadId>.None => true _ => false } }
}

// Both edges must be the same real component/read operation. Two successful unrelated
// copies into equal-shaped values do not establish descriptor correspondence.
fn capturePairedCopy(left: &Case, right: &Case) -> bool {
  if !captureSameDefinition(left.definition, right.definition) || !captureSameRead(left.read, right.read) { return false }
  return match left.authority {
    TransferAuthority.SameComponent => match right.authority { TransferAuthority.SameComponent => true _ => false }
    TransferAuthority.Physical {map, direction, address} => match right.authority {
      TransferAuthority.Physical {map: other, direction: otherDirection, address: otherAddress} =>
        map.index == other.index && direction == otherDirection && sameTemporary(address, otherAddress)
      _ => false }
    TransferAuthority.Address {edge, direction} => match right.authority {
      TransferAuthority.Address {edge: other, direction: otherDirection} => edge == other && direction == otherDirection
      _ => false }
    _ => false
  }
}

effect fn captureDescriptorRow(product: &mut CaptureReborrows, domain: &Domain, rules: &mut Program,
  origin: usize, originalCase: usize, placementCase: usize, own: usize, physical: usize, gates: &[Atom]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let current = invocationCaptureCell(domain, cases[own].target)
  let descriptor = invocationCaptureCell(domain, cases[physical].target)
  if current.category != SourceRole.Ownership || descriptor.category != SourceRole.Physical
    || current.value.index != descriptor.value.index {
    return CompilerBug.panic(b"capture descriptor correspondence changed its exact component or category")
  }
  let bucket = List<usize>.asSlice(&List<List<usize>>.asSlice(&product.byValue)[current.value.index])
  let rows = List<CaptureReborrowDescriptor>.asSlice(&product.descriptors)
  let mut at = usize.ZERO
  while at < bucket.length {
    let previous = rows[bucket[at]]
    if previous.origin == origin && previous.originalCase == originalCase && previous.placementCase == placementCase
      && previous.case == own && previous.physicalCase == physical {
      run Program.rule(&mut rules.*, previous.active, gates, &[])
      return ()
    }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut rules.*)
  run Program.rule(&mut rules.*, active, gates, &[])
  let id = rows.length
  run List<CaptureReborrowDescriptor>.append(&mut product.descriptors, CaptureReborrowDescriptor {
    origin: origin, originalCase: originalCase, placementCase: placementCase, case: own, current: current,
    physicalCase: physical, physical: descriptor, active: active})
  let buckets = List<List<usize>>.asMutSlice(&mut product.byValue)
  run List<usize>.append(&mut buckets[current.value.index], id)
  return ()
}

// A summary's physical counterpart is retained at its ORIGINAL installed definition. Join
// the actual paired storage reads before the separate SummaryRead publication; neither read
// ID nor a same-point lookup can stand in for this two-stage correspondence.
effect fn captureDescriptorSummary(product: &mut CaptureReborrows, values: &[Value], writes: &[OrdinarySummaryWrite],
  definitions: &[DefinedValue], lanes: &[SummaryStorage], summaries: &[SummaryRead], domain: &Domain, index: &ObservationCaseIndex, row: CaptureReborrowDescriptor,
  publication: usize, candidate: usize, rules: &mut Program) -> () ! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let write = writes[candidate]
  let actual = &cases[publication]
  if write.source.index != row.current.value.index || write.source.index != row.physical.value.index
    || keys[actual.target].value.index != write.target.index { return () }
  let original = definitions[write.original.index]
  if original.value.index != row.physical.value.index { return () }
  let exactPlacement = match lanes[write.summary].placement {
    OwnershipPlacement.Known {anchor, suffix: Option<OwnershipSuffix>.None} => anchor.index == values[original.value.index].endpoint.index
    _ => false }
  if !exactPlacement { return () }
  let ownReads = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[actual.target])
  let physicalReads = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[row.physical.cell])
  let mut at = usize.ZERO
  while at < ownReads.length {
    let storageCase = ownReads[at]
    let stored = &cases[storageCase]
    let definition = match stored.definition { Option<DefinitionId>.Some {value} => value.index == write.definition.index _ => false }
    let mut reading = usize.ZERO
    while definition && reading < summaries.length {
      let read = summaries[reading]
      if read.summary == write.summary && captureSameRead(stored.read, Option<ReadId>.some(read.read)) {
        let publications = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[stored.target])
        let mut each = usize.ZERO
        while each < publications.length {
          let published = publications[each]
          let exact = match cases[published].authority { TransferAuthority.SummaryRead {reading: originalRead} => originalRead == reading _ => false }
          if exact && keys[cases[published].target].value.index == read.target.index {
            let mut physical = usize.ZERO
            while physical < physicalReads.length {
              let paired = physicalReads[physical]
              let other = &cases[paired]
              if captureSameDefinition(other.definition, Option<DefinitionId>.some(write.original))
                && captureSameRead(other.read, Option<ReadId>.some(read.original))
                && keys[other.target].value.index == read.target.index
                && values[read.target.index].phase == ValuePhase.Input {
                let gates: [Atom; 6] = [row.active, actual.active, stored.active, cases[published].active, other.active, read.active]
                run captureDescriptorRow(&mut product.*, domain, &mut rules.*, row.origin, row.originalCase,
                  row.placementCase, published, paired, &gates)
              }
              physical = physical + usize.ONE
            }
          }
          each = each + usize.ONE
        }
      }
      reading = reading + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Run once on the frozen Case inventory. Interned coordinates contain only original/current
// Cases, and each row is visited once; cycles add rules, not recursively extended histories.
effect fn reserveCaptureReborrowDescriptors<'body>(skeleton: &mut Skeleton, prepared: &SourcePreparation<'body>,
  domain: &Domain) -> CaptureReborrows ! OutOfMemoryError ? &mut Allocator {
  let mut product = CaptureReborrows.make()
  let values = List<Value>.asSlice(&skeleton.values)
  let mut value = usize.ZERO
  while value < values.length {
    run List<List<usize>>.append(&mut product.byValue, List<usize>.make())
    value = value + usize.ONE
  }
  if List<CaptureReborrowOrigin>.length(&skeleton.captureReborrowData.origins) == usize.ZERO { return move product }
  let index = run observationCaseIndex(domain)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let origins = List<CaptureReborrowOrigin>.asSlice(&skeleton.captureReborrowData.origins)
  let rows = List<Prepared.CaptureReborrow>.asSlice(&prepared.captureReborrows)
  let mut own = usize.ZERO
  while own < cases.length {
    if let TransferAuthority.CaptureReborrow {origin, placement} = cases[own].authority {
      let capture = origins[origin]
      let recorded = &rows[capture.prepared]
      if placement.index != recorded.placement.index { return CompilerBug.panic(b"capture correspondence changed its original Place") }
      let target = keys[cases[own].target]
      let map = &List<SelectionMap>.asSlice(&prepared.maps)[placement.index]
      let targetCells = List<usize>.asSlice(&List<List<usize>>.asSlice(&domain.cellsByValue)[target.value.index])
      let mut cellAt = usize.ZERO
      while cellAt < targetCells.length {
        let cell = targetCells[cellAt]
        if keys[cell].category == SourceRole.Physical {
          let incoming = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.targets)[cell])
          let mut at = usize.ZERO
          while at < incoming.length {
            let placed = incoming[at]
            let actual = &cases[placed]
            let exact = match actual.authority { TransferAuthority.Physical {map: original, direction, address: Option<EvalId>.None} =>
              original.index == placement.index && direction == MapDirection.Forward _ => false }
            if let Option<usize>.Some {value: source} = actual.source {
              let before = values[keys[source].value.index]
              if exact && keys[source].category == SourceRole.Physical && before.evaluation.index == capture.source.index
                && before.endpoint.index == map.source.index && before.phase == ValuePhase.Output {
                let inputs = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.targets)[source])
                let mut entry = usize.ZERO
                while entry < inputs.length {
                  let original = inputs[entry]
                  let gates: [Atom; 3] = [cases[own].active, actual.active, cases[original].active]
                  run captureDescriptorRow(&mut product, domain, &mut skeleton.rules, origin, original, placed, own, placed, &gates)
                  entry = entry + usize.ONE
                }
              }
            }
            at = at + usize.ONE
          }
        }
        cellAt = cellAt + usize.ONE
      }
    }
    own = own + usize.ONE
  }
  let mut at = usize.ZERO
  while at < List<CaptureReborrowDescriptor>.length(&product.descriptors) {
    let row = List<CaptureReborrowDescriptor>.asSlice(&product.descriptors)[at]
    let ownEdges = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[row.current.cell])
    let physicalEdges = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[row.physical.cell])
    let mut next = usize.ZERO
    while next < ownEdges.length {
      let copied = ownEdges[next]
      if let TransferAuthority.OrdinarySummary {candidate} = cases[copied].authority {
        // Immutable views are passed separately from the mutable Program below.
        run captureDescriptorSummary(&mut product, values, List<OrdinarySummaryWrite>.asSlice(&skeleton.ordinarySummaries),
          List<DefinedValue>.asSlice(&skeleton.definitions), List<SummaryStorage>.asSlice(&skeleton.summaries),
          List<SummaryRead>.asSlice(&skeleton.summaryReads), domain, &index, row, copied, candidate, &mut skeleton.rules)
      }
      let mut physical = usize.ZERO
      while physical < physicalEdges.length {
        let paired = physicalEdges[physical]
        if keys[cases[copied].target].value.index == keys[cases[paired].target].value.index
          && capturePairedCopy(&cases[copied], &cases[paired]) {
          let gates: [Atom; 3] = [row.active, cases[copied].active, cases[paired].active]
          run captureDescriptorRow(&mut product, domain, &mut skeleton.rules, row.origin, row.originalCase,
            row.placementCase, copied, paired, &gates)
        }
        physical = physical + usize.ONE
      }
      next = next + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut original = usize.ZERO
  while original < origins.length {
    run List<CaptureReborrowOrigin>.append(&mut product.origins, origins[original])
    original = original + usize.ONE
  }
  return move product
}

fn validateCaptureReborrows<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let origins = List<CaptureReborrowOrigin>.asSlice(&skeleton.captureReborrowData.origins)
  let preparedRows = List<Prepared.CaptureReborrow>.asSlice(&prepared.captureReborrows)
  let values = List<Value>.asSlice(&skeleton.values)
  let leaves = List<Leaf>.asSlice(&skeleton.leaves)
  let seeds = List<Seed>.asSlice(&skeleton.seeds)
  let transfers = List<Transfer>.asSlice(&skeleton.transfers)
  let mut at = usize.ZERO
  while at < origins.length {
    let origin = origins[at]
    let record = &preparedRows[origin.prepared]
    Prepared.validateCaptureReborrow(prepared, record)
    let map = &List<SelectionMap>.asSlice(&prepared.maps)[record.placement.index]
    let descriptor = values[origin.descriptor.index]
    let target = values[origin.target.index]
    let acquisition = Skeleton.evaluation(skeleton, origin.acquisition)
    let acquiredHere = match acquisition.site { EvaluationSite.Node {node} => node.index == record.site.index _ => false }
    if !acquiredHere || acquisition.category != EvaluationRole.Capture || acquisition.point.index != origin.usePoint.index
      || descriptor.phase != ValuePhase.Output || descriptor.evaluation.index != origin.acquisition.index
      || descriptor.endpoint.index != map.source.index || target.phase != ValuePhase.Output
      || target.evaluation.index != origin.result.index || target.endpoint.index != map.target.index
      || leaves[origin.leaf.index].endpoint.index != descriptor.endpoint.index {
      CompilerBug.panic(b"capture reborrow changed its original acquisition or environment component")
    }
    let loan = match &leaves[origin.leaf.index].kind { SourceLeaf.Borrow {loan, node: Option<NodeId>.Some {value}} =>
      loan == origin.loan && value.index == record.site.index _ => false }
    if !loan { CompilerBug.panic(b"capture reborrow lost its actual loan declaration") }
    let mut count = usize.ZERO
    let mut seed = usize.ZERO
    while seed < seeds.length {
      if seeds[seed].leaf.index == origin.leaf.index {
        if seeds[seed].category != SourceRole.Ownership || seeds[seed].value.index != origin.descriptor.index
          || !seeds[seed].direct || !Atom.same(seeds[seed].active, origin.active) {
          CompilerBug.panic(b"capture reborrow acquired physical source authority")
        }
        count = count + usize.ONE
      }
      seed = seed + usize.ONE
    }
    if count != usize.ONE { CompilerBug.panic(b"capture reborrow has no unique acquisition seed") }
    count = usize.ZERO
    let mut transfer = usize.ZERO
    while transfer < transfers.length {
      if let TransferAuthority.CaptureReborrow {origin: matched, placement} = transfers[transfer].authority {
        if matched == at {
          let actual = &transfers[transfer]
          if placement.index != record.placement.index || actual.source.index != origin.descriptor.index
            || actual.target.index != origin.target.index || actual.policy != TransferPolicy.Physical || actual.terminal
            || actual.directness != Directness.Preserve || !Atom.same(actual.active, origin.active)
            || !captureSameDefinition(actual.definition, Option<DefinitionId>.none())
            || !captureSameRead(actual.read, Option<ReadId>.none()) {
            CompilerBug.panic(b"capture reborrow changed its automatic original Place publication")
          }
          count = count + usize.ONE
        }
      }
      transfer = transfer + usize.ONE
    }
    if count != usize.ONE { CompilerBug.panic(b"capture reborrow omitted its actual environment publication") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < seeds.length {
    if seeds[at].category == SourceRole.Ownership {
      let mut found = false
      let mut origin = usize.ZERO
      while origin < origins.length {
        if origins[origin].descriptor.index == seeds[at].value.index && origins[origin].leaf.index == seeds[at].leaf.index { found = true }
        origin = origin + usize.ONE
      }
      if !found { CompilerBug.panic(b"ownership seed has no genuine capture acquisition") }
    }
    at = at + usize.ONE
  }
  return ()
}

/// A real reference descriptor remembers its actual address formation, not a copy of the
