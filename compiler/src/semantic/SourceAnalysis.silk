  /// Reserves the finite typed-topology value/leaf/witness/directness domain and emits source rules.
  /// Cases retain each paired edge; their alternatives do not multiply physical operands.
  pub effect fn reserve(preparation: SourcePreparation<'body>, skeleton: Skeleton) -> Self
  ! OutOfMemoryError ? &mut Allocator {
    validateShapeContexts(&preparation)
    run validatePreparedOperations(&preparation)
    run validateProducerChannels(&preparation)
    validateInvocationChannels(&preparation)
    validateResiduals(&preparation)
    validateRootChannelStops(&preparation)
    validateChannelLifts(&preparation)
    validateBoundaryLifts(&preparation)
    validateContractProducts(&preparation)
    let mut closed = move skeleton
    run Skeleton.reserveInvocationRequests(&mut closed, &preparation)
    run Skeleton.activateSelections(&mut closed, &preparation)
    let mut domain = Domain.make()
    let mut descriptors = DescriptorClosure.make()
    let mut invocations = InvocationClosure.make()
    let mut ownershipPublications = OwnershipPublications.make()
    let mut emitted = usize.ZERO
    let mut extending = true
    while extending {
      let aliases = run Skeleton.activateAliasOperations(&mut closed, List<Endpoint>.asSlice(&preparation.endpoints),
        List<SelectionMap>.asSlice(&preparation.maps))
      let transports = run Skeleton.activateAliasTransports(&mut closed, List<SelectionMap>.asSlice(&preparation.maps))
      let references = run reserveReferenceObservations(&preparation, &mut closed)
      let moveObservations = run reserveMoveObservations(&preparation, &mut closed)
      let dropObservations = run reserveDropObservations(&preparation, &mut closed)
      let fieldObservations = run reserveFieldReholdObservations(&preparation, &mut closed)
      let holdings = run reserveReferenceHoldings(&preparation, &mut closed)
      let ordinarySummaries = run Skeleton.closeOrdinarySummaries(&mut closed, &preparation, &ownershipPublications)
      let summaries = run Skeleton.closeSummaries(&mut closed, &preparation)
      let storage = run Skeleton.closeStorage(&mut closed)
      let throughResults = run closeThroughResults(&preparation, &mut closed)
      let ordinaryResults = run closeOrdinaryResults(&preparation, &mut closed)
      let rvalueResults = run closeRvalueDereferenceResults(&preparation, &mut closed)
      let throughValues = run closeThroughReadValues(&preparation, &mut closed)
      // Normalize only new arrivals before their candidate/policy rules are emitted. A late
      // canonical read joins the same Input; it must not rewrite an already filtered Output
      // or create a second policy observation of previously emitted histories.
      run Skeleton.prepareReadResults(&mut closed, &preparation, emitted)
      run Skeleton.activateResults(&mut closed, &preparation, emitted)
      let throughFlights = run reserveThroughFlights(&preparation, &mut closed)
      let readFlights = run reserveReadFlights(&preparation, &mut closed)
      let transfers = List<Transfer>.length(&closed.transfers)
      run extendDomain(&mut domain, &mut closed.rules, Flow.reservedPoints(&closed.flow), Flow.reservedPairs(&closed.flow),
        List<Evaluation>.asSlice(&closed.evaluations), List<Value>.asSlice(&closed.values),
        List<Seed>.asSlice(&closed.seeds), List<Transfer>.asSlice(&closed.transfers),
        List<ReferenceHolding>.asSlice(&closed.referenceHoldings), List<ReferenceRead>.asSlice(&closed.referenceReads), List<SummaryRead>.asSlice(&closed.summaryReads), List<MoveHolding>.asSlice(&closed.selectedMoves.holdings), List<FieldReholdCandidate>.asSlice(&closed.fieldReholds.candidates))
      let ownershipMirrors = run reserveOwnershipMirrors(&preparation, &mut closed, &domain)
      let moveHoldings = run reserveMoveHoldings(&preparation, &mut closed, &domain)
      let fieldCandidates = run reserveFieldReholdCandidates(&preparation, &mut closed, &domain, &ownershipPublications)
      let fieldClears = run reserveFieldReholdClears(&preparation, &mut closed)
      let published = run closeOwnershipPublications(&mut ownershipPublications, &preparation, &mut closed, &domain)
      let fieldResults = run closeFieldResults(&preparation, &mut closed, &domain, &ownershipPublications)
      let carried = run closeDescriptors(&mut descriptors, &preparation, &mut closed, &domain)
      let invocationWrites = run Skeleton.closeInvocationWrites(&mut closed, &preparation)
      let invoked = run closeInvocations(&mut invocations, &preparation, &mut closed, &domain, &mut descriptors)
      let written = run Skeleton.closeRetainedWrites(&mut closed, &preparation)
      extending = fieldResults || ordinaryResults || dropObservations || throughValues || rvalueResults || fieldObservations || fieldCandidates || fieldClears || throughResults || throughFlights || readFlights || aliases || transports || references || holdings || moveObservations || moveHoldings || ownershipMirrors || published || ordinarySummaries || summaries || storage || carried || written || invoked || invocationWrites || transfers != emitted
      emitted = transfers
    }
    validateCaptureReborrows(&preparation, &closed)
    let captureReborrows = run reserveCaptureReborrowDescriptors(&mut closed, &preparation, &domain)
    closed.captureReborrowData = move captureReborrows
    let addressCoverage = run addressProofCoverage(&preparation, &mut closed, &descriptors, &domain)
    run sealReferenceCoverage(&preparation, &mut closed, &addressCoverage)
    run sealThroughFlightCoverage(&preparation, &mut closed, &addressCoverage)
    run validateThroughFlights(&preparation, &closed)
    validateThroughResults(&preparation, &closed)
    let fieldReads = List<FieldRead>.asSlice(&ownershipPublications.fieldReads)
    let mut fieldRead = usize.ZERO
    while fieldRead < fieldReads.length {
      if !fieldReadValid(&preparation, &closed, &domain, fieldReads[fieldRead]) {
        CompilerBug.panic(b"Field read lost its original summary and canonical transport chain")
      }
      fieldRead = fieldRead + usize.ONE
    }
    run validateFieldResults(&preparation, &closed, &domain, &ownershipPublications)
    validateOrdinaryResults(&preparation, &closed)
    validateRvalueDereferenceResults(&preparation, &closed)
    validateRvalueDereferenceValues(&preparation, &closed)
    validateThroughReadValues(&preparation, &closed)
    run sealReadFlightCoverage(&preparation, &mut closed, &addressCoverage)
    run validateReadFlights(&preparation, &closed)
    run sealFieldReholdCoverage(&preparation, &mut closed, &addressCoverage, &domain)
    run validateFieldReholds(&preparation, &closed, &domain, &ownershipPublications)
    run sealDropCoverage(&preparation, &mut closed, &addressCoverage)
    validateConsumedDrops(&preparation, &closed)
    run sealMoveCoverage(&preparation, &mut closed, &addressCoverage, &domain)
    run sealOwnershipMirrorCoverage(&mut closed, &domain)
    run validateSelectedMoves(&preparation, &closed, &domain)
    run validateOwnershipMirrors(&preparation, &closed, &domain)
    validateReferenceObservations(&preparation, &closed)
    validateReferenceHoldings(&preparation, &closed)
    run sealReferenceHoldingCoverage(&mut closed, &domain)
    run sealInvocationGaps(&mut closed.rules, &invocations)
    validateInvocations(&preparation, &closed, &domain, &invocations, &descriptors)
    validateRetainedAddresses(&preparation, &closed, &descriptors, &domain)
    validateInvocationAddresses(&preparation, &closed, &descriptors, &domain)
    validateSummaries(&preparation, &closed)
    validateOrdinarySummaries(&preparation, &closed)
    validateRetainedWrites(&preparation, &closed)
    let observations = run reserveObservationProjection(&preparation, &mut closed, &domain)
    let skeleton = move closed
    let mut rules = move skeleton.rules
    let reaching = run Flow.emit(move skeleton.flow, &mut rules)
    let transfers = move skeleton.transfers
    validateStorage(List<SelectionMap>.asSlice(&preparation.maps), &reaching, List<Storage>.asSlice(&skeleton.storage), List<DefinedValue>.asSlice(&skeleton.definitions),
      List<ReadValue>.asSlice(&skeleton.reads), List<Value>.asSlice(&skeleton.values),
      List<Evaluation>.asSlice(&skeleton.evaluations))
    validateReferenceOrigins(&preparation, List<ReferenceOrigin>.asSlice(&skeleton.references),
      List<Evaluation>.asSlice(&skeleton.evaluations), List<Value>.asSlice(&skeleton.values), List<Leaf>.asSlice(&skeleton.leaves))
    run validateAliasGraph(&preparation, List<Evaluation>.asSlice(&skeleton.evaluations),
      List<StorageAlias>.asSlice(&skeleton.aliases), List<AliasEdge>.asSlice(&skeleton.aliasEdges),
      List<ReferenceOrigin>.asSlice(&skeleton.references), List<SelectionUse>.asSlice(&skeleton.selections),
      List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests), List<SliceConversion>.asSlice(&skeleton.slices), &descriptors)
    validateContents(&preparation, List<AliasEdge>.asSlice(&skeleton.aliasEdges), List<Case>.asSlice(&domain.cases), &descriptors)
    validateAliasPorts(List<Value>.asSlice(&skeleton.values), List<StorageAlias>.asSlice(&skeleton.aliases),
      List<AliasTransport>.asSlice(&skeleton.aliasTransports))
    run validateReservation(&preparation, &reaching, List<Evaluation>.asSlice(&skeleton.evaluations),
      List<Value>.asSlice(&skeleton.values), List<Leaf>.asSlice(&skeleton.leaves),
      List<Seed>.asSlice(&skeleton.seeds), List<Transfer>.asSlice(&transfers), List<StorageAlias>.asSlice(&skeleton.aliases), List<AliasEdge>.asSlice(&skeleton.aliasEdges), List<AliasTransport>.asSlice(&skeleton.aliasTransports), List<Storage>.asSlice(&skeleton.storage), List<RetainedWrite>.asSlice(&skeleton.writes), List<InvocationWrite>.asSlice(&skeleton.invocationWrites), List<SummaryRead>.asSlice(&skeleton.summaryReads), List<OrdinarySummaryWrite>.asSlice(&skeleton.ordinarySummaries), List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings), List<MoveHolding>.asSlice(&skeleton.selectedMoves.holdings), List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates), List<SummaryStorage>.asSlice(&skeleton.summaries), List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates))
    let inputIndex = run reserveInputIndex(List<Value>.length(&skeleton.values),
      List<CellKey>.asSlice(&domain.keys), List<Case>.asSlice(&domain.cases))
    return Builder<'body> {inputIndex: move inputIndex, observations: move observations, fieldReholds: move skeleton.fieldReholds, drops: move skeleton.drops, selectedMovesData: move skeleton.selectedMoves, ownershipMirrorsData: move skeleton.ownershipMirrors, ownershipPublicationsData: move ownershipPublications, addressCoverageData: move addressCoverage, results: move skeleton.results, operationResultsData: move skeleton.operationResults, operationContributorsData: move skeleton.operationContributors, storesData: move skeleton.stores, writes: move skeleton.writes, writeHolders: move skeleton.writeHolders, ordinarySummariesData: move skeleton.ordinarySummaries, summariesData: move skeleton.summaries, summaryReadsData: move skeleton.summaryReads, summaryClearsData: move skeleton.summaryClears, summaryWrites: move skeleton.summaryWrites, rules: move rules, reaching: move reaching, storage: move skeleton.storage,
      selections: move skeleton.selections, invocationWrites: move skeleton.invocationWrites, invocationRequestsData: move skeleton.invocationRequests, invocationAddressesData: move skeleton.invocationAddresses, invocationReadsData: move skeleton.invocationReads, descriptorRequests: move skeleton.descriptorRequests, retainedRequestsData: move skeleton.retainedRequests, retainedAddressesData: move skeleton.retainedAddresses, retainedStatusData: move skeleton.retainedStatus, retainedReadsData: move skeleton.retainedReads, descriptors: move descriptors, invocations: move invocations, aliasesData: move skeleton.aliases, aliasEdges: move skeleton.aliasEdges,
      aliasTransports: move skeleton.aliasTransports, aliasReads: move skeleton.aliasReads, referenceObservationsData: move skeleton.referenceObservations, throughReadValuesData: move skeleton.throughReadValues, rvalueDereferenceValuesData: move skeleton.rvalueDereferenceValues, fieldResultRecipesData: move skeleton.fieldResultRecipes, fieldResultCandidatesData: move skeleton.fieldResultCandidates, ordinaryResultDemandsData: move skeleton.ordinaryResultDemands, ordinaryResultCandidatesData: move skeleton.ordinaryResultCandidates, rvalueDereferenceResultsData: move skeleton.rvalueDereferenceResults, throughResultCandidatesData: move skeleton.throughResultCandidates, throughFlightRequestsData: move skeleton.throughFlightRequests, throughFlightObservationsData: move skeleton.throughFlightObservations, throughFlightReadsData: move skeleton.throughFlightReads, throughFlightCoverageData: move skeleton.throughFlightCoverage, readFlightObservationsData: move skeleton.readFlightObservations, readFlightReadsData: move skeleton.readFlightReads, readFlightCoverageData: move skeleton.readFlightCoverage, referenceHoldingCoverageData: move skeleton.referenceHoldingCoverage, referenceHoldingsData: move skeleton.referenceHoldings, referenceReadsData: move skeleton.referenceReads, referenceCoverageData: move skeleton.referenceCoverage, captureReborrowData: move skeleton.captureReborrowData, references: move skeleton.references, slices: move skeleton.slices, definitions: move skeleton.definitions, reads: move skeleton.reads, preparationData: move preparation,
      evaluations: move skeleton.evaluations, executions: move skeleton.executions, valuesData: move skeleton.values, leaves: move skeleton.leaves,
      cells: move domain.cells, keys: move domain.keys, witnesses: move domain.witnesses, cases: move domain.cases,
      policies: move domain.policies}
  }

  pub fn cell(self: &Self, value: ValueId, leaf: LeafId, witness: usize, direct: bool, category: SourceRole) -> Option<Cell> {
    let index = findCell(List<CellKey>.asSlice(&self.keys), value, leaf, witness, direct, category)
    if index == usize.MAX { return Option<Cell>.none() }
    return Option<Cell>.some(List<Cell>.asSlice(&self.cells)[index])
  }

  fn cellView(self: &Self, index: usize) -> CellView {
    let keys = List<CellKey>.asSlice(&self.keys)
    let cells = List<Cell>.asSlice(&self.cells)
    let witnesses = List<Witness>.asSlice(&self.witnesses)
    if index >= keys.length || index >= cells.length {
      return CompilerBug.panic(b"source case names an absent cell")
    }
    let key = keys[index]
    if key.witness >= witnesses.length { return CompilerBug.panic(b"source cell lost its retained witness") }
    let witness = &witnesses[key.witness]
    return CellView {id: index, value: key.value, leaf: key.leaf, category: key.category, direct: key.direct,
      definition: witness.definition, read: witness.read, quality: cells[index]}
  }

  pub fn caseCount(self: &Self) -> usize { return List<Case>.length(&self.cases) }

  /// Exposes the existing finite predecessor graph without reconstructing it from Values
  /// or changing any source, policy, reaching pair, or rule.
  pub fn case(self: &Self, index: usize) -> CaseView {
    let cases = List<Case>.asSlice(&self.cases)
    if index >= cases.length { return CompilerBug.panic(b"source provenance names an absent case") }
    let actual = &cases[index]
    let source = match actual.source {
      Option<usize>.Some {value} => Option<CellView>.some(Builder.cellView(self, value))
      Option<usize>.None => Option<CellView>.none()
    }
    return CaseView {id: index, source: move source, target: Builder.cellView(self, actual.target),
      active: actual.active, definition: actual.definition, read: actual.read, authority: actual.authority}
  }

  pub fn leaf(self: &Self, leaf: LeafId) -> &Leaf {
    let leaves = List<Leaf>.asSlice(&self.leaves)
    if leaf.index >= leaves.length { CompilerBug.panic(b"policy input names an unreserved source leaf") }
    return &leaves[leaf.index]
  }

  /// Creation identity only. A caller must still prove this descriptor reaches the exact
  /// selected operand component; this record does not authenticate nested contents or a
  /// declared result route and does not sample the source's current precision.
  pub fn referenceOrigin(self: &Self, leaf: LeafId) -> Option<ReferenceOrigin> {
    if leaf.index >= List<Leaf>.length(&self.leaves) {
      return CompilerBug.panic(b"reference origin names an absent source leaf")
    }
    let origins = List<ReferenceOrigin>.asSlice(&self.references)
    let mut at = usize.ZERO
    while at < origins.length {
      if origins[at].leaf.index == leaf.index { return Option<ReferenceOrigin>.some(origins[at]) }
      at = at + usize.ONE
    }
    return Option<ReferenceOrigin>.none()
  }

  /// Called once at each operation's input barrier. The caller supplies written operand and
  /// structural component order; this returns stable leaf order within that physical position.
  /// No candidate Truth is inspected and none of the inputs can depend on a selected output.
  pub effect fn inputs(self: &mut Self, value: ValueId) -> List<Input>
  ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.valuesData)
    if value.index >= values.length { CompilerBug.panic(b"policy input names an unreserved physical value") }
    return run inputPositions(&mut self.rules, value, List<Leaf>.length(&self.leaves), values,
      List<CellKey>.asSlice(&self.keys), List<Cell>.asSlice(&self.cells),
      List<Witness>.asSlice(&self.witnesses), List<Case>.asSlice(&self.cases), &self.inputIndex, Option<SourceRole>.none())
  }

  pub fn observationCase(self: &Self, case: usize) -> ObservationCase {
    let cases = List<ObservationCase>.asSlice(&self.observations.cases)
    if case >= cases.length { return CompilerBug.panic(b"semantic observation lost its actual incoming Case") }
    return cases[case]
  }

  pub fn observationNormalizations(self: &Self) -> &[ObservationNormalization] {
    return List<ObservationNormalization>.asSlice(&self.observations.evidence)
  }

  pub fn fieldReholdNormalizations(self: &Self) -> &FieldReholdNormalizations {
    return &self.observations.fieldReholds
  }

  /// This view is for semantic policy observation only. Descriptor proofs and original
  /// writer binding still use inputs(), which retains every genuine physical source.
  pub effect fn observationInputs(self: &mut Self, value: ValueId) -> List<Input>
  ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.valuesData)
    if value.index >= values.length { CompilerBug.panic(b"policy input names an unreserved physical value") }
    // The frozen projection already unions every incoming semantic Case at its exact
    // cell. Reuse that union instead of re-emitting it at every policy observation.
    let mut inputs = run inputPositions(&mut self.rules, value, List<Leaf>.length(&self.leaves), values,
      List<CellKey>.asSlice(&self.keys), List<Cell>.asSlice(&self.observations.cells),
      List<Witness>.asSlice(&self.witnesses), List<Case>.asSlice(&self.cases), &self.inputIndex, Option<SourceRole>.none())
    let sources = List<Input>.asMutSlice(&mut inputs)
    let mut input = usize.ZERO
    while input < sources.length {
      let cases = List<InputCase>.asMutSlice(&mut sources[input].cases)
      let mut at = usize.ZERO
      while at < cases.length {
        let observed = Builder.observationCase(&self.*, cases[at].case)
        cases[at].quality = observed.semantic
        at = at + usize.ONE
      }
      input = input + usize.ONE
    }
    return move inputs
  }

  /// Applicability before this terminal's own decision. A masked physical branch passes
  /// through the raw descriptor port while contributing no semantic result or effects.
  pub effect fn policyObservationCases(self: &mut Self, id: PolicyPortId) -> List<ObservationCase>
  ! OutOfMemoryError ? &mut Allocator {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { return CompilerBug.panic(b"semantic policy observation lost its port") }
    let policy = policies[id.index]
    let boundary = List<Atom>.asSlice(&self.observations.boundaries)[policy.outputCase]
    let cases = run Builder.policyCases(&self.*, id)
    let casesSelected = List<InputCase>.asSlice(&cases)
    let mut result = List<ObservationCase>.make()
    let mut at = usize.ZERO
    while at < casesSelected.length {
      let original = Builder.observationCase(&self.*, casesSelected[at].case)
      let semantic = freshObservation(&mut self.rules)
      let masked = Program.atom(&mut self.rules)
      let gate: [Atom; 2] = [original.semantic.present, policy.port.quality.present]
      let excluded: [Atom; 1] = [boundary]
      run Program.rule(&mut self.rules, semantic.present, &gate, &excluded)
      let stored: [Atom; 2] = [semantic.present, original.semantic.stored]
      let alternatives: [Atom; 2] = [semantic.present, original.semantic.alternatives]
      run Program.rule(&mut self.rules, semantic.stored, &stored, &[])
      run Program.rule(&mut self.rules, semantic.alternatives, &alternatives, &[])
      if policy.port.category == SourceRole.Physical && policy.port.outputRole == SourceRole.Physical {
        let hidden: [Atom; 2] = [original.masked, policy.port.quality.present]
        let replaced: [Atom; 3] = [original.raw.present, boundary, policy.port.quality.present]
        run Program.rule(&mut self.rules, masked, &hidden, &[])
        run Program.rule(&mut self.rules, masked, &replaced, &[])
      }
      run List<ObservationCase>.append(&mut result, ObservationCase {case: original.case,
        raw: original.raw, semantic: semantic, masked: masked})
      at = at + usize.ONE
    }
    return move result
  }

  /// Storage membership after canonical summary normalization. Raw inputs remain available
  /// to the writer policy; these exact original cases instead describe the installed lane.
  pub effect fn definitionInputs(self: &mut Self, definition: DefinitionId) -> DefinitionInputs
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Builder.definition(&self.*, definition)
    let values = List<Value>.asSlice(&self.valuesData)
    let physical = match actual.summary { Option<usize>.None => true _ => false }
      && match values[actual.value.index].writeHolder { Option<usize>.None => true _ => false }
    let mut selected = Option<SourceRole>.none()
    if physical { selected = Option<SourceRole>.some(SourceRole.Physical) }
    let redirected = Program.atom(&mut self.rules)
    if physical {
      let keys = List<CellKey>.asSlice(&self.keys)
      let cells = List<Cell>.asSlice(&self.cells)
      let mut at = usize.ZERO
      while at < keys.length {
        if keys[at].value.index == actual.value.index && keys[at].category == SourceRole.Ownership {
          let covered: [Atom; 1] = [cells[at].present]
          run Program.rule(&mut self.rules, redirected, &covered, &[])
        }
        at = at + usize.ONE
      }
    }
    let mut inputs = run inputPositions(&mut self.rules, actual.value, List<Leaf>.length(&self.leaves), values,
      List<CellKey>.asSlice(&self.keys), List<Cell>.asSlice(&self.cells),
      List<Witness>.asSlice(&self.witnesses), List<Case>.asSlice(&self.cases), &self.inputIndex, selected)
    let rows = List<Input>.asMutSlice(&mut inputs)
    let actualCases = List<Case>.asSlice(&self.cases)
    let mirrors = List<OwnershipMirror>.asSlice(&self.ownershipMirrorsData.candidates)
    let mut input = usize.ZERO
    while input < rows.length {
      let quality = freshObservation(&mut self.rules)
      let histories = List<InputCase>.asMutSlice(&mut rows[input].cases)
      let mut history = usize.ZERO
      while history < histories.length {
        let original = Builder.observationCase(&self.*, histories[history].case)
        let replaced = Program.atom(&mut self.rules)
        if physical {
          // Exact writer source cell, not the definition-wide admitted OR. Different
          // original incoming Cases retain their own semantic/precision alternatives.
          let cell = actualCases[histories[history].case].target
          let mut each = usize.ZERO
          while each < actualCases.length {
            if let TransferAuthority.OwnershipMirror {candidate, ..} = actualCases[each].authority {
              if mirrors[candidate].original.index == definition.index && mirrors[candidate].sourceCase == histories[history].case
                && match actualCases[each].source { Option<usize>.Some {value} => value == cell _ => false } {
                let gate: [Atom; 2] = [original.semantic.present, actualCases[each].active]
                run Program.rule(&mut self.rules, replaced, &gate, &[])
              }
            }
            each = each + usize.ONE
          }
          let hidden: [Atom; 1] = [original.masked]
          let mirrored: [Atom; 1] = [replaced]
          run Program.rule(&mut self.rules, redirected, &hidden, &[])
          run Program.rule(&mut self.rules, redirected, &mirrored, &[])
        }
        let semantic = freshObservation(&mut self.rules)
        let gate: [Atom; 1] = [original.semantic.present]
        let excluded: [Atom; 1] = [replaced]
        run Program.rule(&mut self.rules, semantic.present, &gate, &excluded)
        let stored: [Atom; 2] = [semantic.present, original.semantic.stored]
        let alternatives: [Atom; 2] = [semantic.present, original.semantic.alternatives]
        run Program.rule(&mut self.rules, semantic.stored, &stored, &[])
        run Program.rule(&mut self.rules, semantic.alternatives, &alternatives, &[])
        histories[history].quality = semantic
        run mergeObservation(&mut self.rules, quality, semantic)
        history = history + usize.ONE
      }
      rows[input].quality = quality
      input = input + usize.ONE
    }
    return DefinitionInputs {inputs: move inputs, redirected: redirected}
  }

  pub effect fn solve(self: Self) -> Graph<'body> ! OutOfMemoryError ? &mut Allocator {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    let mut at = usize.ZERO
    while at < policies.length {
      if !policies[at].bound { CompilerBug.panic(b"source policy omitted a reserved candidate decision") }
      at = at + usize.ONE
    }
    let solution = run Program.solve(&self.rules)
    let stamp = run Shared<Stamp>.make(Stamp {marker: true})
    return Graph<'body> {observations: move self.observations, fieldReholds: move self.fieldReholds, drops: move self.drops, selectedMovesData: move self.selectedMovesData, ownershipMirrorsData: move self.ownershipMirrorsData, ownershipPublicationsData: move self.ownershipPublicationsData, addressCoverageData: move self.addressCoverageData, results: move self.results, operationResultsData: move self.operationResultsData, operationContributorsData: move self.operationContributorsData, storesData: move self.storesData, writes: move self.writes, writeHolders: move self.writeHolders, ordinarySummariesData: move self.ordinarySummariesData, summariesData: move self.summariesData, summaryReadsData: move self.summaryReadsData, summaryClearsData: move self.summaryClearsData, summaryWrites: move self.summaryWrites, stamp: move stamp, preparationData: move self.preparationData, solution: move solution,
      reaching: move self.reaching, storage: move self.storage, selections: move self.selections, invocationWrites: move self.invocationWrites, invocationRequestsData: move self.invocationRequestsData, invocationAddressesData: move self.invocationAddressesData, invocationReadsData: move self.invocationReadsData, descriptorRequests: move self.descriptorRequests, retainedRequestsData: move self.retainedRequestsData, retainedAddressesData: move self.retainedAddressesData, retainedStatusData: move self.retainedStatusData, retainedReadsData: move self.retainedReadsData, descriptors: move self.descriptors, invocations: move self.invocations, aliasesData: move self.aliasesData, aliasEdges: move self.aliasEdges,
      aliasTransports: move self.aliasTransports, aliasReads: move self.aliasReads, referenceObservationsData: move self.referenceObservationsData, throughReadValuesData: move self.throughReadValuesData, rvalueDereferenceValuesData: move self.rvalueDereferenceValuesData, fieldResultRecipesData: move self.fieldResultRecipesData, fieldResultCandidatesData: move self.fieldResultCandidatesData, ordinaryResultDemandsData: move self.ordinaryResultDemandsData, ordinaryResultCandidatesData: move self.ordinaryResultCandidatesData, rvalueDereferenceResultsData: move self.rvalueDereferenceResultsData, throughResultCandidatesData: move self.throughResultCandidatesData, throughFlightRequestsData: move self.throughFlightRequestsData, throughFlightObservationsData: move self.throughFlightObservationsData, throughFlightReadsData: move self.throughFlightReadsData, throughFlightCoverageData: move self.throughFlightCoverageData, readFlightObservationsData: move self.readFlightObservationsData, readFlightReadsData: move self.readFlightReadsData, readFlightCoverageData: move self.readFlightCoverageData, referenceHoldingCoverageData: move self.referenceHoldingCoverageData, referenceHoldingsData: move self.referenceHoldingsData, referenceReadsData: move self.referenceReadsData, referenceCoverageData: move self.referenceCoverageData, captureReborrowData: move self.captureReborrowData, references: move self.references, slices: move self.slices, definitions: move self.definitions, reads: move self.reads, evaluations: move self.evaluations, executions: move self.executions, valuesData: move self.valuesData,
      leaves: move self.leaves, cells: move self.cells, keys: move self.keys, witnesses: move self.witnesses, cases: move self.cases}
  }

  pub fn policyCount(self: &Self) -> usize { return List<PendingPolicy>.length(&self.policies) }

  pub fn policy(self: &Self, index: usize) -> PolicyPort {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if index >= policies.length { CompilerBug.panic(b"source policy names an absent decision port") }
    return policies[index].port
  }

  /// Predecessor routes of this paired source are still alternatives, not additional scan
  /// positions. A consumer needing placement/contract evidence must use each complete case.
  pub effect fn policyCases(self: &Self, id: PolicyPortId) -> List<InputCase>
  ! OutOfMemoryError ? &mut Allocator {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { CompilerBug.panic(b"source policy names an absent decision port") }
    let mut result = List<InputCase>.make()
    run appendInputCases(&mut result, policies[id.index].sourceCell, List<Value>.asSlice(&self.valuesData),
      List<CellKey>.asSlice(&self.keys), List<Witness>.asSlice(&self.witnesses), List<Case>.asSlice(&self.cases), &self.inputIndex)
    return move result
  }

  /// Retain the existing paired placement edge before this port's policy decision.
  /// Absence is missing placement evidence, never a whole-output or Unknown fallback.
  pub effect fn policyOwnershipPlacements(self: &Self, id: PolicyPortId) -> List<OwnershipPolicyPlacement>
  ! OutOfMemoryError ? &mut Allocator {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { return CompilerBug.panic(b"ownership placement lost its policy port") }
    let policy = policies[id.index]
    let cases = List<Case>.asSlice(&self.cases)
    if policy.outputCase >= cases.length { return CompilerBug.panic(b"ownership policy lost its output Case") }
    let actual = &cases[policy.outputCase]
    let source = match actual.source { Option<usize>.Some {value} => value
      _ => { return CompilerBug.panic(b"ownership policy substituted a seed Case") } }
    if source != policy.sourceCell { return CompilerBug.panic(b"ownership policy changed its incoming cell") }
    let publications = List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values)
    let edges = List<OwnershipPublicationEdge>.asSlice(&self.ownershipPublicationsData.edges)
    let mut result = List<OwnershipPolicyPlacement>.make()
    let mut at = usize.ZERO
    while at < edges.length {
      let edge = &edges[at]
      if edge.case == policy.outputCase {
        let before = publications[edge.source]
        let after = publications[edge.target]
        if before.cell != source || after.cell != actual.target
          || before.value.index != policy.port.source.index || after.value.index != policy.port.target.index
          || before.category != policy.port.category || after.category != policy.port.outputRole {
          return CompilerBug.panic(b"ownership policy placement changed its actual paired cells")
        }
        run List<OwnershipPolicyPlacement>.append(&mut result, OwnershipPolicyPlacement {
          source: edge.source, target: edge.target, case: edge.case, member: edge.member,
          sourceActive: before.active, applicable: policy.port.quality.present})
      }
      at = at + usize.ONE
    }
    return move result
  }

  /// Exact whole-result reset before policy. Missing reset authority stays missing; the
  /// caller must not use an arbitrary selected target or a target publication's activity.
  pub fn policyOperationOwnershipReset(self: &Self, id: PolicyPortId) -> Option<OperationOwnershipReset> {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { return CompilerBug.panic(b"operation reset has no policy port") }
    let policy = policies[id.index]
    let cases = List<Case>.asSlice(&self.cases)
    let keys = List<CellKey>.asSlice(&self.keys)
    let witnesses = List<Witness>.asSlice(&self.witnesses)
    let values = List<Value>.asSlice(&self.valuesData)
    if !operationOwnershipResetCase(&self.preparationData, policy, cases, keys, witnesses, values,
      List<Evaluation>.asSlice(&self.evaluations)) { return Option<OperationOwnershipReset>.none() }
    let resets = List<OperationOwnershipReset>.asSlice(&self.ownershipPublicationsData.resets)
    let publications = List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values)
    let origins = List<OwnershipOrigin>.asSlice(&self.ownershipPublicationsData.origins)
    let mut at = usize.ZERO
    while at < resets.length {
      let row = resets[at]
      if row.case == policy.outputCase {
        let publication = publications[row.publication]
        let sameDefinition = match row.definition {
          Option<DefinitionId>.Some {value} => match policy.port.definition {
            Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
        }
        let sameRead = match row.read {
          Option<ReadId>.Some {value} => match policy.port.read {
            Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.read { Option<ReadId>.None => true _ => false }
        }
        if row.sourceCell != policy.sourceCell || row.targetCell != cases[row.case].target
          || row.source.index != policy.port.source.index || row.target.index != policy.port.target.index
          || row.sourceRole != policy.port.category || row.outputRole != policy.port.outputRole
          || row.leaf.index != policy.port.leaf.index || row.direct != policy.port.direct || !sameDefinition || !sameRead
          || !Atom.same(row.sourceActive, List<Cell>.asSlice(&self.cells)[policy.sourceCell].present)
          || !Atom.same(row.applicable, policy.port.quality.present)
          || publication.cell != row.targetCell || publication.value.index != row.target.index
          || publication.leaf.index != row.leaf.index || publication.direct || publication.category != row.outputRole
          || row.root.index != values[row.target.index].endpoint.index {
          return CompilerBug.panic(b"operation reset changed its reserved policy correspondence")
        }
        let placement = OwnershipPlacement.Known {anchor: row.root, suffix: Option<OwnershipSuffix>.none()}
        if !sameOwnershipPlacement(publication.initial, placement) || !sameOwnershipPlacement(publication.placement, placement) {
          return CompilerBug.panic(b"operation reset retained an incoming ownership suffix")
        }
        match origins[publication.origin] {
          OwnershipOrigin.OperationReset {reset, category, root, ..} => {
            if reset != at || category != row.outputRole || root.index != row.root.index {
              return CompilerBug.panic(b"operation reset changed its original publication")
            }
          }
          _ => { return CompilerBug.panic(b"operation reset substituted another ownership origin") }
        }
        return Option<OperationOwnershipReset>.some(row)
      }
      at = at + usize.ONE
    }
    return CompilerBug.panic(b"whole operation result omitted its reserved ownership reset")
  }

  /// Exact whole-result reset before policy. Missing reset authority stays missing; the
  /// caller must not use an arbitrary selected target or a target publication's activity.
  pub fn policyThroughOwnershipReset(self: &Self, id: PolicyPortId) -> Option<ThroughOwnershipReset> {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { return CompilerBug.panic(b"through reset has no policy port") }
    let policy = policies[id.index]
    let cases = List<Case>.asSlice(&self.cases)
    let keys = List<CellKey>.asSlice(&self.keys)
    let witnesses = List<Witness>.asSlice(&self.witnesses)
    let values = List<Value>.asSlice(&self.valuesData)
    if !throughOwnershipResetCase(policy, cases, keys, witnesses, values,
      List<ThroughResultCandidate>.asSlice(&self.throughResultCandidatesData)) { return Option<ThroughOwnershipReset>.none() }
    let resets = List<ThroughOwnershipReset>.asSlice(&self.ownershipPublicationsData.throughResets)
    let publications = List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values)
    let origins = List<OwnershipOrigin>.asSlice(&self.ownershipPublicationsData.origins)
    let mut at = usize.ZERO
    while at < resets.length {
      let row = resets[at]
      if row.case == policy.outputCase {
        let candidate = match policy.port.authority { TransferAuthority.ThroughResult {candidate, ..} => candidate
          _ => { return CompilerBug.panic(b"through reset lost its actual candidate") } }
        if row.candidate != candidate { return CompilerBug.panic(b"through reset changed its read-flight candidate") }
        let publication = publications[row.publication]
        let sameDefinition = match row.definition {
          Option<DefinitionId>.Some {value} => match policy.port.definition {
            Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
        }
        let sameRead = match row.read {
          Option<ReadId>.Some {value} => match policy.port.read {
            Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.read { Option<ReadId>.None => true _ => false }
        }
        if row.sourceCell != policy.sourceCell || row.targetCell != cases[row.case].target
          || row.source.index != policy.port.source.index || row.target.index != policy.port.target.index
          || row.sourceRole != policy.port.category || row.outputRole != policy.port.outputRole
          || row.leaf.index != policy.port.leaf.index || row.direct != policy.port.direct || !sameDefinition || !sameRead
          || !Atom.same(row.sourceActive, List<Cell>.asSlice(&self.cells)[policy.sourceCell].present)
          || !Atom.same(row.applicable, policy.port.quality.present)
          || publication.cell != row.targetCell || publication.value.index != row.target.index
          || publication.leaf.index != row.leaf.index || publication.direct || publication.category != row.outputRole
          || row.root.index != values[row.target.index].endpoint.index {
          return CompilerBug.panic(b"through reset changed its reserved policy correspondence")
        }
        let placement = OwnershipPlacement.Known {anchor: row.root, suffix: Option<OwnershipSuffix>.none()}
        if !sameOwnershipPlacement(publication.initial, placement) || !sameOwnershipPlacement(publication.placement, placement) {
          return CompilerBug.panic(b"through reset retained an incoming ownership suffix")
        }
        match origins[publication.origin] {
          OwnershipOrigin.ThroughReset {reset, category, root, ..} => {
            if reset != at || category != row.outputRole || root.index != row.root.index {
              return CompilerBug.panic(b"through reset changed its original publication")
            }
          }
          _ => { return CompilerBug.panic(b"through reset substituted another ownership origin") }
        }
        return Option<ThroughOwnershipReset>.some(row)
      }
      at = at + usize.ONE
    }
    return CompilerBug.panic(b"whole through result omitted its reserved ownership reset")
  }

  /// Exact incoming alternatives of this one recipe port. Each row has its own pre-kept
  /// applicability and accepted atom; another same-cell publication cannot admit it.
  pub effect fn policyFieldResultPublications(self: &Self, id: PolicyPortId) -> List<FieldResultPublication>
  ! OutOfMemoryError ? &mut Allocator {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { return CompilerBug.panic(b"Field publication has no actual policy port") }
    let policy = policies[id.index]
    let cases = List<Case>.asSlice(&self.cases)
    let keys = List<CellKey>.asSlice(&self.keys)
    let values = List<Value>.asSlice(&self.valuesData)
    let recipes = List<FieldResultRecipe>.asSlice(&self.fieldResultRecipesData)
    let mut result = List<FieldResultPublication>.make()
    let recipe = match fieldResultPolicy(policy, cases, keys, List<Witness>.asSlice(&self.witnesses), values, recipes) {
      Option<usize>.Some {value} => value _ => { return move result } }
    let candidates = List<FieldResultCandidate>.asSlice(&self.fieldResultCandidatesData)
    let rows = List<FieldResultPublication>.asSlice(&self.ownershipPublicationsData.fieldResults)
    let publications = List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values)
    let origins = List<OwnershipOrigin>.asSlice(&self.ownershipPublicationsData.origins)
    let mut at = usize.ZERO
    while at < rows.length {
      let row = rows[at]
      if row.case == policy.outputCase {
        let candidate = candidates[row.candidate]
        let publication = publications[row.publication]
        let definition = match row.definition { Option<DefinitionId>.Some {value} => match candidate.definition {
          Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
          _ => match candidate.definition { Option<DefinitionId>.None => true _ => false } }
        let read = match row.read { Option<ReadId>.Some {value} => match candidate.read {
          Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
          _ => match candidate.read { Option<ReadId>.None => true _ => false } }
        if candidate.recipe != recipe || row.sourceCase != candidate.sourceCase || cases[row.sourceCase].target != policy.sourceCell
          || row.sourceCell != policy.sourceCell || row.targetCell != cases[row.case].target
          || row.source.index != policy.port.source.index || row.target.index != policy.port.target.index
          || row.sourceRole != policy.port.category || row.outputRole != policy.port.outputRole
          || row.leaf.index != policy.port.leaf.index || row.direct != policy.port.direct || !definition || !read
          || !Atom.same(row.sourceActive, cases[row.sourceCase].active)
          || !sameOwnershipPlacement(row.placement, candidate.placement) || !sameOwnershipPlacement(row.placement, recipes[recipe].placement)
          || publication.cell != row.targetCell || publication.value.index != row.target.index || publication.leaf.index != row.leaf.index
          || publication.category != row.outputRole || publication.direct != policy.port.outputDirect
          || !sameOwnershipPlacement(publication.initial, row.placement) || !sameOwnershipPlacement(publication.placement, row.placement) {
          return CompilerBug.panic(b"Field publication changed its exact incoming evidence or tagged residual")
        }
        match origins[publication.origin] {
          OwnershipOrigin.FieldResult {recipe: original, category, root, ..} => {
            if original != recipe || category != row.outputRole || root.index != row.root.index { return CompilerBug.panic(b"Field publication changed its stable origin") }
          }
          _ => { return CompilerBug.panic(b"Field publication substituted another origin") }
        }
        run List<FieldResultPublication>.append(&mut result, row)
      }
      at = at + usize.ONE
    }
    if List<FieldResultPublication>.length(&result) == usize.ZERO { return CompilerBug.panic(b"Field recipe omitted all actual incoming publication evidence") }
    return move result
  }

  /// Pre-kept publication correspondence. Incoming placement is deliberately irrelevant to
  /// this unplaced finish; only the caller's exact ordinary decision activates the reset.
  pub fn policyOrdinaryOwnershipReset(self: &Self, id: PolicyPortId) -> Option<OrdinaryOwnershipReset> {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { return CompilerBug.panic(b"ordinary result publication has no policy port") }
    let policy = policies[id.index]
    let cases = List<Case>.asSlice(&self.cases)
    let keys = List<CellKey>.asSlice(&self.keys)
    let witnesses = List<Witness>.asSlice(&self.witnesses)
    let values = List<Value>.asSlice(&self.valuesData)
    if !ordinaryOwnershipResetCase(policy, cases, keys, witnesses, values,
      List<OrdinaryResultCandidate>.asSlice(&self.ordinaryResultCandidatesData)) { return Option<OrdinaryOwnershipReset>.none() }
    let resets = List<OrdinaryOwnershipReset>.asSlice(&self.ownershipPublicationsData.ordinaryResets)
    let publications = List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values)
    let origins = List<OwnershipOrigin>.asSlice(&self.ownershipPublicationsData.origins)
    let mut at = usize.ZERO
    while at < resets.length {
      let row = resets[at]
      if row.case == policy.outputCase {
        let candidate = match policy.port.authority { TransferAuthority.OrdinaryResult {candidate, ..} => candidate
          _ => { return CompilerBug.panic(b"ordinary result publication lost its actual candidate") } }
        if row.candidate != candidate || row.demand != List<OrdinaryResultCandidate>.asSlice(&self.ordinaryResultCandidatesData)[candidate].demand { return CompilerBug.panic(b"ordinary result publication changed its operand-finish candidate") }
        let publication = publications[row.publication]
        let sameDefinition = match row.definition {
          Option<DefinitionId>.Some {value} => match policy.port.definition {
            Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
        }
        let sameRead = match row.read {
          Option<ReadId>.Some {value} => match policy.port.read {
            Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.read { Option<ReadId>.None => true _ => false }
        }
        if row.sourceCell != policy.sourceCell || row.targetCell != cases[row.case].target
          || row.source.index != policy.port.source.index || row.target.index != policy.port.target.index
          || row.sourceRole != policy.port.category || row.outputRole != policy.port.outputRole
          || row.leaf.index != policy.port.leaf.index || row.direct != policy.port.direct || !sameDefinition || !sameRead
          || !Atom.same(row.sourceActive, List<Cell>.asSlice(&self.cells)[policy.sourceCell].present)
          || !Atom.same(row.applicable, policy.port.quality.present)
          || publication.cell != row.targetCell || publication.value.index != row.target.index
          || publication.leaf.index != row.leaf.index || publication.direct || publication.category != row.outputRole
          || row.root.index != values[row.target.index].endpoint.index {
          return CompilerBug.panic(b"ordinary result publication changed its reserved policy correspondence")
        }
        let placement = OwnershipPlacement.Known {anchor: row.root, suffix: Option<OwnershipSuffix>.none()}
        if !sameOwnershipPlacement(publication.initial, placement) || !sameOwnershipPlacement(publication.placement, placement) {
          return CompilerBug.panic(b"ordinary result publication retained an incoming ownership suffix")
        }
        match origins[publication.origin] {
          OwnershipOrigin.OrdinaryReset {reset, category, root, ..} => {
            if reset != at || category != row.outputRole || root.index != row.root.index {
              return CompilerBug.panic(b"ordinary result publication changed its original publication")
            }
          }
          _ => { return CompilerBug.panic(b"ordinary result publication substituted another ownership origin") }
        }
        return Option<OrdinaryOwnershipReset>.some(row)
      }
      at = at + usize.ONE
    }
    return CompilerBug.panic(b"ordinary result finish omitted its reserved ownership reset")
  }

  /// Pre-kept publication correspondence. Incoming placement is deliberately irrelevant to
  /// this unplaced finish; only the caller's exact ordinary decision activates the reset.
  pub fn policyRvalueDereferencePublication(self: &Self, id: PolicyPortId) -> Option<RvalueDereferencePublication> {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { return CompilerBug.panic(b"rvalue dereference publication has no policy port") }
    let policy = policies[id.index]
    let cases = List<Case>.asSlice(&self.cases)
    let keys = List<CellKey>.asSlice(&self.keys)
    let witnesses = List<Witness>.asSlice(&self.witnesses)
    let values = List<Value>.asSlice(&self.valuesData)
    if !rvalueDereferencePublicationCase(policy, cases, keys, witnesses, values,
      List<RvalueDereferenceResult>.asSlice(&self.rvalueDereferenceResultsData)) { return Option<RvalueDereferencePublication>.none() }
    let resets = List<RvalueDereferencePublication>.asSlice(&self.ownershipPublicationsData.rvalueDereferences)
    let publications = List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values)
    let origins = List<OwnershipOrigin>.asSlice(&self.ownershipPublicationsData.origins)
    let mut at = usize.ZERO
    while at < resets.length {
      let row = resets[at]
      if row.case == policy.outputCase {
        let candidate = match policy.port.authority { TransferAuthority.RvalueDereferenceResult {candidate, ..} => candidate
          _ => { return CompilerBug.panic(b"rvalue dereference publication lost its actual candidate") } }
        if row.candidate != candidate { return CompilerBug.panic(b"rvalue dereference publication changed its operand-finish candidate") }
        let publication = publications[row.publication]
        let sameDefinition = match row.definition {
          Option<DefinitionId>.Some {value} => match policy.port.definition {
            Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false }
        }
        let sameRead = match row.read {
          Option<ReadId>.Some {value} => match policy.port.read {
            Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
          _ => match policy.port.read { Option<ReadId>.None => true _ => false }
        }
        if row.sourceCell != policy.sourceCell || row.targetCell != cases[row.case].target
          || row.source.index != policy.port.source.index || row.target.index != policy.port.target.index
          || row.sourceRole != policy.port.category || row.outputRole != policy.port.outputRole
          || row.leaf.index != policy.port.leaf.index || row.direct != policy.port.direct || !sameDefinition || !sameRead
          || !Atom.same(row.sourceActive, List<Cell>.asSlice(&self.cells)[policy.sourceCell].present)
          || !Atom.same(row.applicable, policy.port.quality.present)
          || publication.cell != row.targetCell || publication.value.index != row.target.index
          || publication.leaf.index != row.leaf.index || publication.direct || publication.category != row.outputRole
          || row.root.index != values[row.target.index].endpoint.index {
          return CompilerBug.panic(b"rvalue dereference publication changed its reserved policy correspondence")
        }
        let placement = OwnershipPlacement.Known {anchor: row.root, suffix: Option<OwnershipSuffix>.none()}
        if !sameOwnershipPlacement(publication.initial, placement) || !sameOwnershipPlacement(publication.placement, placement) {
          return CompilerBug.panic(b"rvalue dereference publication retained an incoming ownership suffix")
        }
        match origins[publication.origin] {
          OwnershipOrigin.RvalueDereference {reset, category, root, ..} => {
            if reset != at || category != row.outputRole || root.index != row.root.index {
              return CompilerBug.panic(b"rvalue dereference publication changed its original publication")
            }
          }
          _ => { return CompilerBug.panic(b"rvalue dereference publication substituted another ownership origin") }
        }
        return Option<RvalueDereferencePublication>.some(row)
      }
      at = at + usize.ONE
    }
    return CompilerBug.panic(b"rvalue dereference finish omitted its reserved ownership reset")
  }

  /// Every candidate must be bound exactly once, including absent/unknown/loan-free cases.
  /// The arguments are rules in this same program, not sampled Truth values or final precision.
  pub effect fn bindPolicy(self: &mut Self, port: PolicyPortId, kept: Atom, stored: Atom, alternatives: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Builder.policy(&self.*, port.index)
    if let TransferAuthority.RetainedWrite {candidate} = actual.authority {
      let selected = Builder.writeCandidate(&self.*, candidate)
      let active = List<WriteHolder>.asSlice(&self.writeHolders)[selected.holder].active
      let empty = List<Atom>.make()
      let accepted: [Atom; 3] = [actual.quality.present, actual.active, kept]
      run Program.rule(&mut self.rules, active, &accepted, List<Atom>.asSlice(&empty))
      if let Option<usize>.Some {value: summary} = selected.summary {
        let writes = List<SummaryWrite>.asSlice(&self.summaryWrites)
        let mut found = false
        let mut at = usize.ZERO
        while at < writes.length {
          if writes[at].summary == summary && writes[at].holder == selected.holder
            && writes[at].value.index == selected.target.index {
            run Program.rule(&mut self.rules, writes[at].active, &accepted, List<Atom>.asSlice(&empty))
            found = true
          }
          at = at + usize.ONE
        }
        if !found { return CompilerBug.panic(b"summary policy lost its original reserved definition") }
      } else {
        let components = List<WriteComponent>.asSlice(&List<WriteHolder>.asSlice(&self.writeHolders)[selected.holder].components)
        let mut found = false
        let mut at = usize.ZERO
        while at < components.length {
          if components[at].value.index == selected.target.index {
            run Program.rule(&mut self.rules, components[at].active, &accepted, List<Atom>.asSlice(&empty))
            found = true
          }
          at = at + usize.ONE
        }
        if !found { return CompilerBug.panic(b"retained policy lost its exact received component") }
      }
    }
    if let TransferAuthority.FieldRehold {candidate} = actual.authority {
      let rows = List<FieldReholdCandidate>.asSlice(&self.fieldReholds.candidates)
      if candidate >= rows.length { CompilerBug.panic(b"field rehold policy lost its original Case") }
      let accepted: [Atom; 3] = [actual.quality.present, actual.active, kept]
      run Program.rule(&mut self.rules, rows[candidate].admitted, &accepted, &[])
    }
    if let TransferAuthority.OwnershipMirror {candidate, ..} = actual.authority {
      let rows = List<OwnershipMirror>.asSlice(&self.ownershipMirrorsData.candidates)
      if candidate >= rows.length { CompilerBug.panic(b"ownership mirror policy lost its original definition") }
      let accepted: [Atom; 3] = [actual.quality.present, actual.active, kept]
      run Program.rule(&mut self.rules, rows[candidate].admitted, &accepted, &[])
    }
    if let TransferAuthority.OrdinarySummary {candidate} = actual.authority {
      let rows = List<OrdinarySummaryWrite>.asSlice(&self.ordinarySummariesData)
      if candidate >= rows.length { CompilerBug.panic(b"ordinary summary policy lost its original definition") }
      let accepted: [Atom; 3] = [actual.quality.present, actual.active, kept]
      run Program.rule(&mut self.rules, rows[candidate].admitted, &accepted, &[])
    }
    if let TransferAuthority.InvocationWrite {candidate} = actual.authority {
      let selected = Builder.invocationWrite(&self.*, candidate)
      let empty = List<Atom>.make()
      let accepted: [Atom; 3] = [actual.quality.present, actual.active, kept]
      run Program.rule(&mut self.rules, List<WriteHolder>.asSlice(&self.writeHolders)[selected.holder].active,
        &accepted, List<Atom>.asSlice(&empty))
      let writes = List<SummaryWrite>.asSlice(&self.summaryWrites)
      let mut found = false
      let mut at = usize.ZERO
      while at < writes.length {
        if writes[at].summary == selected.summary && writes[at].holder == selected.holder
          && writes[at].value.index == selected.target.index {
          run Program.rule(&mut self.rules, writes[at].active, &accepted, List<Atom>.asSlice(&empty))
          found = true
        }
        at = at + usize.ONE
      }
      if !found { return CompilerBug.panic(b"invocation policy lost its real whole-owner definition") }
    }
    return run bindPolicy(&mut self.policies, &mut self.rules, port, kept, stored, alternatives)
  }
}

effect fn bindPolicy(policies: &mut List<PendingPolicy>, rules: &mut Program, id: PolicyPortId,
  kept: Atom, stored: Atom, alternatives: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let pending = List<PendingPolicy>.asMutSlice(&mut policies.*)
  if id.index >= pending.length || pending[id.index].bound {
    CompilerBug.panic(b"source policy decision was absent or bound twice")
  }
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  let retains: [Atom; 1] = [kept]
  let losesStorage: [Atom; 1] = [stored]
  let losesAlternatives: [Atom; 1] = [alternatives]
  run Program.rule(&mut rules.*, pending[id.index].kept, &retains, none)
  run Program.rule(&mut rules.*, pending[id.index].stored, &losesStorage, none)
  run Program.rule(&mut rules.*, pending[id.index].alternatives, &losesAlternatives, none)
  pending[id.index].bound = true
  return ()
}

// Built after reservation has frozen every cell and Case. These rows preserve original
// ordinals and only index the exact equality filters used by policy observation.
struct InputIndex {
  keysByValue: List<List<usize>>
  casesByTarget: List<List<usize>>
}

effect fn reserveInputIndex(valueCount: usize, keys: &[CellKey], cases: &[Case]) -> InputIndex
! OutOfMemoryError ? &mut Allocator {
  let mut byValue = List<List<usize>>.make()
  let mut byTarget = List<List<usize>>.make()
  let mut at = usize.ZERO
  while at < valueCount {
    run List<List<usize>>.append(&mut byValue, List<usize>.make())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < keys.length {
    let valueRows = List<List<usize>>.asMutSlice(&mut byValue)
    run List<usize>.append(&mut valueRows[keys[at].value.index], at)
    run List<List<usize>>.append(&mut byTarget, List<usize>.make())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < cases.length {
    let targetRows = List<List<usize>>.asMutSlice(&mut byTarget)
    run List<usize>.append(&mut targetRows[cases[at].target], at)
    at = at + usize.ONE
  }
  return InputIndex {keysByValue: move byValue, casesByTarget: move byTarget}
}

effect fn inputPositions(rules: &mut Program, value: ValueId, leafCount: usize, values: &[Value],
  keys: &[CellKey], cells: &[Cell], witnesses: &[Witness], cases: &[Case], index: &InputIndex, category: Option<SourceRole>) -> List<Input>
! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Input>.make()
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  let selectedKeys = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.keysByValue)[value.index])
  let mut leaf = usize.ZERO
  while leaf < leafCount {
    let mut found = false
    let mut selected = usize.ZERO
    while selected < selectedKeys.length {
      let key = selectedKeys[selected]
      if keys[key].value.index == value.index && keys[key].leaf.index == leaf
        && match category { Option<SourceRole>.Some {value: matchedRole} => keys[key].category == matchedRole _ => true } { found = true }
      selected = selected + usize.ONE
    }
    if found {
      let quality = Cell {present: Program.atom(&mut rules.*), stored: Program.atom(&mut rules.*), alternatives: Program.atom(&mut rules.*)}
      let mut alternatives = List<InputCase>.make()
      selected = usize.ZERO
      while selected < selectedKeys.length {
        let key = selectedKeys[selected]
        if keys[key].value.index == value.index && keys[key].leaf.index == leaf
          && match category { Option<SourceRole>.Some {value: matchedRole} => keys[key].category == matchedRole _ => true } {
          let member = cells[key]
          let present: [Atom; 1] = [member.present]
          let stored: [Atom; 1] = [member.stored]
          let lost: [Atom; 1] = [member.alternatives]
          run Program.rule(&mut rules.*, quality.present, &present, none)
          run Program.rule(&mut rules.*, quality.stored, &stored, none)
          run Program.rule(&mut rules.*, quality.alternatives, &lost, none)
          run appendInputCases(&mut alternatives, key, values, keys, witnesses, cases, index)
        }
        selected = selected + usize.ONE
      }
      run List<Input>.append(&mut result, Input {value: value, leaf: LeafId {index: leaf},
        quality: quality, cases: move alternatives})
    }
    leaf = leaf + usize.ONE
  }
  return move result
}

effect fn appendInputCases(target: &mut List<InputCase>, key: usize, values: &[Value],
  keys: &[CellKey], witnesses: &[Witness], cases: &[Case], index: &InputIndex) -> () ! OutOfMemoryError ? &mut Allocator {
  let witness = &witnesses[keys[key].witness]
  let incoming = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.casesByTarget)[key])
  let mut ordinal = usize.ZERO
  while ordinal < incoming.length {
    let each = incoming[ordinal]
    if cases[each].target == key {
      let mut source = Option<ValueId>.none()
      if let Option<usize>.Some {value: previous} = cases[each].source {
        source = Option<ValueId>.some(keys[previous].value)
      }
      run List<InputCase>.append(&mut target.*, InputCase {case: each, category: keys[key].category, direction: authorityDirection(cases[each].authority), address: authorityAddress(cases[each].authority), source: source,
        placement: values[keys[key].value.index].endpoint, direct: keys[key].direct,
        definition: witness.definition, read: witness.read, map: authorityMap(cases[each].authority),
        contract: authorityContract(cases[each].authority), quality: cases[each].quality})
    }
    ordinal = ordinal + usize.ONE
  }
  return ()
}

impl<'body> Graph<'body> {
  pub fn observationCase(self: &Self, case: usize) -> ObservationCase {
    let cases = List<ObservationCase>.asSlice(&self.observations.cases)
    if case >= cases.length { return CompilerBug.panic(b"semantic observation lost its actual incoming Case") }
    return cases[case]
  }
  pub fn observationNormalizations(self: &Self) -> &[ObservationNormalization] {
    return List<ObservationNormalization>.asSlice(&self.observations.evidence)
  }
  pub fn fieldReholdNormalizations(self: &Self) -> &FieldReholdNormalizations {
    return &self.observations.fieldReholds
  }
  pub fn captureReborrows(self: &Self) -> &[CaptureReborrowOrigin] { return List<CaptureReborrowOrigin>.asSlice(&self.captureReborrowData.origins) }
  pub fn captureReborrowDescriptors(self: &Self) -> &[CaptureReborrowDescriptor] { return List<CaptureReborrowDescriptor>.asSlice(&self.captureReborrowData.descriptors) }
  pub fn captureReborrowDescriptorsAt(self: &Self, value: ValueId) -> &[usize] {
    let rows = List<List<usize>>.asSlice(&self.captureReborrowData.byValue)
    if value.index >= rows.length { return CompilerBug.panic(b"capture descriptor lookup has no actual value") }
    return List<usize>.asSlice(&rows[value.index])
  }
  pub fn ownershipOrigins(self: &Self) -> &[OwnershipOrigin] { return List<OwnershipOrigin>.asSlice(&self.ownershipPublicationsData.origins) }
  pub fn fieldReads(self: &Self) -> &[FieldRead] { return List<FieldRead>.asSlice(&self.ownershipPublicationsData.fieldReads) }
  pub fn ownershipPublications(self: &Self) -> &[OwnershipPublication] { return List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values) }
  pub fn ownershipPublicationsAt(self: &Self, value: ValueId) -> &[usize] { return ownershipRowsAt(&self.ownershipPublicationsData, value, false) }
  pub fn ownershipPublicationGapsAt(self: &Self, value: ValueId) -> &[usize] { return ownershipRowsAt(&self.ownershipPublicationsData, value, true) }
  pub effect fn ownershipPublicationOrigins(self: &Self, value: ValueId) -> List<usize>
  ! OutOfMemoryError ? &mut Allocator { return run ownershipOriginsAt(&self.ownershipPublicationsData, value) }
  pub fn ownershipPublicationGaps(self: &Self) -> &[OwnershipPublicationGap] { return List<OwnershipPublicationGap>.asSlice(&self.ownershipPublicationsData.gaps) }
  pub fn addressCoverage(self: &Self) -> &[AddressCoverage] { return List<AddressCoverage>.asSlice(&self.addressCoverageData.requests) }
  pub fn selectionUses(self: &Self) -> &[SelectionUse] { return List<SelectionUse>.asSlice(&self.selections) }
  pub fn fieldReholdRequests(self: &Self) -> &[FieldReholdRequest] { return List<FieldReholdRequest>.asSlice(&self.fieldReholds.requests) }
  pub fn fieldReholdObservations(self: &Self) -> &[FieldReholdObservation] { return List<FieldReholdObservation>.asSlice(&self.fieldReholds.observations) }
  pub fn fieldReholdReads(self: &Self) -> &[FieldReholdRead] { return List<FieldReholdRead>.asSlice(&self.fieldReholds.reads) }
  pub fn fieldReholdCandidates(self: &Self) -> &[FieldReholdCandidate] { return List<FieldReholdCandidate>.asSlice(&self.fieldReholds.candidates) }
  pub fn fieldReholdCoverage(self: &Self) -> &[FieldReholdCoverage] { return List<FieldReholdCoverage>.asSlice(&self.fieldReholds.coverage) }
  pub fn fieldReholdClears(self: &Self) -> &[FieldReholdClear] { return List<FieldReholdClear>.asSlice(&self.fieldReholds.clears) }
  pub fn fieldReholdSuppressions(self: &Self) -> &[FieldReholdSuppression] { return List<FieldReholdSuppression>.asSlice(&self.fieldReholds.suppressions) }
  pub fn fieldReholdCaseCoverage(self: &Self) -> &[FieldReholdCaseCoverage] { return List<FieldReholdCaseCoverage>.asSlice(&self.fieldReholds.cases) }
  pub fn consumedDrops(self: &Self) -> &[ConsumedDrop] { return List<ConsumedDrop>.asSlice(&self.drops.requests) }
  pub fn dropObservations(self: &Self) -> &[DropObservation] { return List<DropObservation>.asSlice(&self.drops.observations) }
  pub fn dropReads(self: &Self) -> &[DropRead] { return List<DropRead>.asSlice(&self.drops.reads) }
  pub fn dropCoverage(self: &Self) -> &[DropCoverage] { return List<DropCoverage>.asSlice(&self.drops.coverage) }
  pub fn selectedMoves(self: &Self) -> &[SelectedMove] { return List<SelectedMove>.asSlice(&self.selectedMovesData.requests) }
  pub fn moveObservations(self: &Self) -> &[MoveObservation] { return List<MoveObservation>.asSlice(&self.selectedMovesData.observations) }
  pub fn moveReads(self: &Self) -> &[MoveRead] { return List<MoveRead>.asSlice(&self.selectedMovesData.reads) }
  pub fn moveHoldings(self: &Self) -> &[MoveHolding] { return List<MoveHolding>.asSlice(&self.selectedMovesData.holdings) }
  pub fn ownershipMirrors(self: &Self) -> &[OwnershipMirror] { return List<OwnershipMirror>.asSlice(&self.ownershipMirrorsData.candidates) }
  pub fn ownershipMirrorCoverage(self: &Self) -> &[OwnershipMirrorCoverage] { return List<OwnershipMirrorCoverage>.asSlice(&self.ownershipMirrorsData.coverage) }
  pub fn moveCoverage(self: &Self) -> &[MoveCoverage] { return List<MoveCoverage>.asSlice(&self.selectedMovesData.coverage) }
  pub fn moveHoldingCoverage(self: &Self) -> &[MoveHoldingCoverage] { return List<MoveHoldingCoverage>.asSlice(&self.selectedMovesData.holdingCoverage) }
  pub fn ownershipPositions(self: &Self) -> &[OwnershipPosition] { return List<OwnershipPosition>.asSlice(&self.selectedMovesData.positions) }
  pub fn referenceObservations(self: &Self) -> &[ReferenceObservation] { return List<ReferenceObservation>.asSlice(&self.referenceObservationsData) }
  pub fn throughResultCandidates(self: &Self) -> &[ThroughResultCandidate] { return List<ThroughResultCandidate>.asSlice(&self.throughResultCandidatesData) }
  pub fn fieldResultRecipes(self: &Self) -> &[FieldResultRecipe] { return List<FieldResultRecipe>.asSlice(&self.fieldResultRecipesData) }
  pub fn fieldResultCandidates(self: &Self) -> &[FieldResultCandidate] { return List<FieldResultCandidate>.asSlice(&self.fieldResultCandidatesData) }
  pub fn ordinaryResultDemands(self: &Self) -> &[OrdinaryResultDemand] { return List<OrdinaryResultDemand>.asSlice(&self.ordinaryResultDemandsData) }
  pub fn ordinaryResultCandidates(self: &Self) -> &[OrdinaryResultCandidate] { return List<OrdinaryResultCandidate>.asSlice(&self.ordinaryResultCandidatesData) }
  pub fn rvalueDereferenceResults(self: &Self) -> &[RvalueDereferenceResult] { return List<RvalueDereferenceResult>.asSlice(&self.rvalueDereferenceResultsData) }
  pub fn rvalueDereferenceValues(self: &Self) -> &[RvalueDereferenceValue] { return List<RvalueDereferenceValue>.asSlice(&self.rvalueDereferenceValuesData) }
  pub fn throughReadValues(self: &Self) -> &[ThroughReadValue] { return List<ThroughReadValue>.asSlice(&self.throughReadValuesData) }
  pub fn throughFlightRequests(self: &Self) -> &[ThroughFlightRequest] { return List<ThroughFlightRequest>.asSlice(&self.throughFlightRequestsData) }
  pub fn throughFlightObservations(self: &Self) -> &[ThroughFlightObservation] { return List<ThroughFlightObservation>.asSlice(&self.throughFlightObservationsData) }
  pub fn throughFlightReads(self: &Self) -> &[ThroughFlightRead] { return List<ThroughFlightRead>.asSlice(&self.throughFlightReadsData) }
  pub fn throughFlightCoverage(self: &Self) -> &[ThroughFlightCoverage] { return List<ThroughFlightCoverage>.asSlice(&self.throughFlightCoverageData) }
  pub fn readFlightObservations(self: &Self) -> &[ReadFlightObservation] { return List<ReadFlightObservation>.asSlice(&self.readFlightObservationsData) }
  pub fn readFlightReads(self: &Self) -> &[ReadFlightRead] { return List<ReadFlightRead>.asSlice(&self.readFlightReadsData) }
  pub fn readFlightCoverage(self: &Self) -> &[ReadFlightCoverage] { return List<ReadFlightCoverage>.asSlice(&self.readFlightCoverageData) }
  pub fn referenceReads(self: &Self) -> &[ReferenceRead] { return List<ReferenceRead>.asSlice(&self.referenceReadsData) }
  pub fn referenceHoldingCoverage(self: &Self) -> &[ReferenceHoldingCoverage] { return List<ReferenceHoldingCoverage>.asSlice(&self.referenceHoldingCoverageData) }
  pub fn referenceHoldings(self: &Self) -> &[ReferenceHolding] { return List<ReferenceHolding>.asSlice(&self.referenceHoldingsData) }
  pub fn referenceCoverage(self: &Self) -> &[ReferenceCoverage] { return List<ReferenceCoverage>.asSlice(&self.referenceCoverageData) }
  pub fn reference(self: &Self, index: usize) -> ReferenceOrigin {
    let values = List<ReferenceOrigin>.asSlice(&self.references)
    if index >= values.length { return CompilerBug.panic(b"reference evidence names an absent acquisition") }
    return values[index]
  }
  pub fn aliasMissing(self: &Self, alias: usize) -> Atom {
    let values = List<Atom>.asSlice(&self.addressCoverageData.aliases)
    if alias >= values.length { return CompilerBug.panic(b"address coverage names an absent canonical alias") }
    return values[alias]
  }

  pub fn resultUses(self: &Self) -> &[ResultUse] { return List<ResultUse>.asSlice(&self.results) }
  pub fn operationResults(self: &Self) -> &Results.Inventory { return &self.operationResultsData }
  pub fn operationContributors(self: &Self) -> &[OperationContributor] { return List<OperationContributor>.asSlice(&self.operationContributorsData) }
  pub fn invocationCallOutputs(self: &Self) -> &[InvocationCallOutput] { return List<InvocationCallOutput>.asSlice(&self.invocations.callOutputs) }
  pub fn invocationCallPairs(self: &Self) -> &[InvocationCallPair] { return List<InvocationCallPair>.asSlice(&self.invocations.callPairs) }
  pub fn invocationCallEdges(self: &Self) -> &[InvocationCallEdge] { return List<InvocationCallEdge>.asSlice(&self.invocations.callEdges) }
  pub fn invocationCallContributors(self: &Self) -> &[InvocationCallContributor] { return List<InvocationCallContributor>.asSlice(&self.invocations.callContributors) }
  pub fn invocationCaptureSources(self: &Self) -> &[InvocationCaptureSource] { return List<InvocationCaptureSource>.asSlice(&self.invocations.captureSources) }
  pub fn invocationCaptureValues(self: &Self) -> &[InvocationCaptureValue] { return List<InvocationCaptureValue>.asSlice(&self.invocations.captureValues) }
  pub fn invocationCaptureEdges(self: &Self) -> &[InvocationCaptureEdge] { return List<InvocationCaptureEdge>.asSlice(&self.invocations.captureEdges) }
  pub fn invocationContributors(self: &Self) -> &[InvocationContributor] { return List<InvocationContributor>.asSlice(&self.invocations.contributors) }
  pub fn invocationGaps(self: &Self) -> &[InvocationGap] { return List<InvocationGap>.asSlice(&self.invocations.gaps) }

  pub fn stores(self: &Self) -> &Stores.Inventory { return &self.storesData }
  pub fn ordinarySummaries(self: &Self) -> &[OrdinarySummaryWrite] { return List<OrdinarySummaryWrite>.asSlice(&self.ordinarySummariesData) }
  pub fn summaries(self: &Self) -> &[SummaryStorage] { return List<SummaryStorage>.asSlice(&self.summariesData) }
  pub fn summaryReads(self: &Self) -> &[SummaryRead] { return List<SummaryRead>.asSlice(&self.summaryReadsData) }
  pub fn summaryClears(self: &Self) -> &[SummaryClear] { return List<SummaryClear>.asSlice(&self.summaryClearsData) }
  pub fn writeCandidate(self: &Self, id: usize) -> RetainedWrite {
    let values = List<RetainedWrite>.asSlice(&self.writes)
    if id >= values.length { return CompilerBug.panic(b"retained policy names an absent write candidate") }
    return values[id]
  }
  pub fn writeHolder(self: &Self, id: usize) -> &WriteHolder {
    let values = List<WriteHolder>.asSlice(&self.writeHolders)
    if id >= values.length { return CompilerBug.panic(b"retained policy names an absent holder update") }
    return &values[id]
  }
  pub fn aliases(self: &Self) -> &[StorageAlias] { return List<StorageAlias>.asSlice(&self.aliasesData) }
  pub fn invocationWrite(self: &Self, id: usize) -> InvocationWrite {
    let values = List<InvocationWrite>.asSlice(&self.invocationWrites)
    if id >= values.length { return CompilerBug.panic(b"invocation policy names an absent candidate") }
    return values[id]
  }
  pub fn invocationRequests(self: &Self) -> &[InvocationRequest] { return List<InvocationRequest>.asSlice(&self.invocationRequestsData) }
  pub fn invocationAddresses(self: &Self) -> &[InvocationAddress] { return List<InvocationAddress>.asSlice(&self.invocationAddressesData) }
  pub fn invocationReads(self: &Self) -> &[InvocationRead] { return List<InvocationRead>.asSlice(&self.invocationReadsData) }
  pub fn retainedRequests(self: &Self) -> &[RetainedRequest] { return List<RetainedRequest>.asSlice(&self.retainedRequestsData) }
  pub fn retainedAddresses(self: &Self) -> &[RetainedAddress] { return List<RetainedAddress>.asSlice(&self.retainedAddressesData) }
  pub fn retainedStatus(self: &Self) -> &[RetainedStatus] { return List<RetainedStatus>.asSlice(&self.retainedStatusData) }
  pub fn retainedReads(self: &Self) -> &[RetainedRead] { return List<RetainedRead>.asSlice(&self.retainedReadsData) }

  /// Physical reservation order only; operation operands keep the visitor's explicit order.
  pub fn values(self: &Self) -> &[Value] { return List<Value>.asSlice(&self.valuesData) }
  pub fn value(self: &Self, id: ValueId) -> Value {
    let values = List<Value>.asSlice(&self.valuesData)
    if id.index >= values.length { return CompilerBug.panic(b"source consumer names an absent value") }
    return values[id.index]
  }
  pub fn valueShape(self: &Self, id: ValueId) -> ShapeId {
    return valueShape(&self.preparationData, Graph.value(&self.*, id))
  }
  pub fn evaluation(self: &Self, id: EvalId) -> Evaluation {
    let evaluations = List<Evaluation>.asSlice(&self.evaluations)
    if id.index >= evaluations.length { return CompilerBug.panic(b"source consumer names an absent evaluation") }
    return evaluations[id.index]
  }
  pub fn definitionCount(self: &Self) -> usize { return List<DefinedValue>.length(&self.definitions) }
  pub fn readCount(self: &Self) -> usize { return List<ReadValue>.length(&self.reads) }
  pub fn definition(self: &Self, id: DefinitionId) -> DefinitionView {
    return definitionView(&self.reaching, List<Storage>.asSlice(&self.storage), List<DefinedValue>.asSlice(&self.definitions), id)
  }
  pub fn read(self: &Self, id: ReadId) -> ReadView {
    return readView(List<Read>.asSlice(&self.reaching.reads), List<Storage>.asSlice(&self.storage), List<ReadValue>.asSlice(&self.reads), id)
  }

  /// Allocates only the matching actual placements; it emits no rules and performs no solve.
  pub effect fn readPlacementsByRead(self: &Self, read: ReadId) -> List<ReadPlacement>
  ! OutOfMemoryError ? &mut Allocator {
    return run readPlacementsByRead(&self.preparationData, List<Read>.asSlice(&self.reaching.reads), List<Point>.asSlice(&self.reaching.points), List<Storage>.asSlice(&self.storage),
      List<ReadValue>.asSlice(&self.reads), List<Value>.asSlice(&self.valuesData),
      List<Evaluation>.asSlice(&self.evaluations), List<StorageAlias>.asSlice(&self.aliasesData),
      List<AliasTransport>.asSlice(&self.aliasTransports), List<AliasRead>.asSlice(&self.aliasReads), List<SummaryRead>.asSlice(&self.summaryReadsData), read)
  }

  pub effect fn readPlacements(self: &Self, value: ValueId, read: ReadId) -> List<ReadPlacement>
  ! OutOfMemoryError ? &mut Allocator {
    return run readPlacements(&self.preparationData, List<Read>.asSlice(&self.reaching.reads), List<Point>.asSlice(&self.reaching.points), List<Storage>.asSlice(&self.storage),
      List<ReadValue>.asSlice(&self.reads), List<Value>.asSlice(&self.valuesData),
      List<Evaluation>.asSlice(&self.evaluations), List<StorageAlias>.asSlice(&self.aliasesData),
      List<AliasTransport>.asSlice(&self.aliasTransports), List<AliasRead>.asSlice(&self.aliasReads), List<SummaryRead>.asSlice(&self.summaryReadsData), value, read)
  }

  pub fn preparation(self: &Self) -> &SourcePreparation<'body> { return &self.preparationData }

  /// Ownership consumes the same immutable runtime/reaching graph, including explicit
  /// reachability and transfer-pair atoms. This is not a second temporal source analysis.
  pub fn control(self: &Self) -> &Reaching { return &self.reaching }

  pub fn componentStorage(self: &Self, component: ComponentId) -> Storage {
    let stored = List<Storage>.asSlice(&self.storage)
    if component.index >= stored.length { return CompilerBug.panic(b"ownership projection names absent source storage") }
    return stored[component.index]
  }

  pub fn truth(self: &Self, atom: Atom) -> Truth { return Solution.truth(&self.solution, atom) }

  pub fn selection(self: &Self, prepared: PreparedSelectionId) -> Result<SelectionId, AccessError> {
    if prepared.index >= List<Selection>.length(&self.preparationData.selections) {
      return Result<SelectionId, AccessError>.failResult(AccessError.InvalidSelection)
    }
    return Result<SelectionId, AccessError>.succeed(SelectionId {stamp: Shared<Stamp>.clone(&self.stamp), index: prepared.index})
  }

  pub fn quality(self: &Self, cell: Cell) -> Quality {
    return Quality {present: Solution.truth(&self.solution, cell.present), stored: Solution.truth(&self.solution, cell.stored),
      alternatives: Solution.truth(&self.solution, cell.alternatives)}
  }

  pub fn leaf(self: &Self, leaf: &SourceLeafId) -> Result<&Leaf, AccessError> {
    if !sameStamp(&self.stamp, &leaf.stamp) { return Result<&Leaf, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let leaves = List<Leaf>.asSlice(&self.leaves)
    if leaf.index >= leaves.length { return Result<&Leaf, AccessError>.failResult(AccessError.InvalidPort) }
    return Result<&Leaf, AccessError>.succeed(&leaves[leaf.index])
  }

  pub fn requestOutcome(self: &Self, ordinal: usize, disposition: SourceDisposition) -> SourceOutcome {
    return SourceOutcome {stamp: Shared<Stamp>.clone(&self.stamp), ordinal: ordinal, disposition: move disposition}
  }

  /// Missing, duplicated, foreign or recovery outcomes cannot discharge a retained request.
  /// The owning checker additionally authenticates its original obligation kind and producer.
  pub fn outcome(self: &Self, ordinal: usize, outcomes: &[SourceOutcome]) -> SourceDisposition {
    let mut matchAt = usize.MAX
    let mut at = usize.ZERO
    while at < outcomes.length {
      if outcomes[at].ordinal == ordinal {
        if !sameStamp(&self.stamp, &outcomes[at].stamp) || matchAt != usize.MAX { return SourceDisposition.Pending }
        matchAt = at
      }
      at = at + usize.ONE
    }
    if self.preparationData.body.coverage != Coverage.Complete || !Solution.valid(&self.solution) || matchAt == usize.MAX {
      return SourceDisposition.Pending
    }
    return copyDisposition(&outcomes[matchAt].disposition)
  }
}

fn copyDisposition(value: &SourceDisposition) -> SourceDisposition {
  return match &value.* {
    SourceDisposition.Proved => SourceDisposition.Proved
    SourceDisposition.Pending => SourceDisposition.Pending
    SourceDisposition.Refuted {origin} => SourceDisposition.Refuted {origin: origin}
  }
}

fn acceptsValue<'body>(prepared: &SourcePreparation<'body>, value: Value,
  selection: PreparedSelectionId, endpoint: EndpointId) -> bool {
  if value.phase != ValuePhase.Output { return false }
  if let Option<usize>.Some {..} = value.summary { return false }
  if let Option<usize>.Some {..} = value.writeHolder { return false }
  return match value.subject {
    Option<ResidualSubject>.None => value.endpoint.index == endpoint.index
    Option<ResidualSubject>.Some {value: subject} => {
      // A declaration suffix is a proof node, not an evaluated selection. Its exact
      // placement must first compose with the actual read; vertex coincidence is not that
      // composition and would merge root and descendant placements of the same state.
      if let Option<Results.Position>.Some {..} = subject.position { return false }
      let state = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[subject.state.index]
      let authored = match state.authority { PreparedResidualAuthority.Authored => true _ => false }
      return authored && state.accepts && state.selection.index == selection.index && state.vertex.index == endpoint.index
    }
  }
}

impl<'body> Graph<'body> {
  /// Imports only an existing prepared selection. Arbitrary paths cannot grow the solved graph.
  pub effect fn sourcesAt(self: &Self, query: &SourceQuery) -> Result<Sources, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &query.selection.stamp) {
      return Result<Sources, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    let selections = List<Selection>.asSlice(&self.preparationData.selections)
    if query.selection.index >= selections.length {
      return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection)
    }
    let selection = &selections[query.selection.index]
    let endpoints = List<Endpoint>.asSlice(&self.preparationData.endpoints)
    if selection.root.index >= endpoints.length { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let matches = match &endpoints[selection.root.index].root {
      Root.Node {node, ..} => node.index == query.read.index
      _ => false
    }
    if !matches { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let accepts = List<EndpointId>.asSlice(&selection.accepts)
    if accepts.length == usize.ZERO { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let values = List<Value>.asSlice(&self.valuesData)
    let evaluations = List<Evaluation>.asSlice(&self.evaluations)
    let points = List<Point>.asSlice(&self.reaching.points)
    let cells = List<Cell>.asSlice(&self.cells)
    let cases = List<Case>.asSlice(&self.cases)
    let leaves = List<Leaf>.asSlice(&self.leaves)
    let mut alternatives = List<SourceAlternative>.make()
    let mut observed = List<SourceEvaluation>.make()
    let mut observedIds = List<usize>.make()
    let mut gaps = List<SourceGap>.make()
    let mut complete = Solution.valid(&self.solution)
    if self.preparationData.body.coverage != Coverage.Complete {
      complete = false
      run List<SourceGap>.append(&mut gaps, SourceGap.Recovery)
    }
    let mut found = false
    // An actual evaluation with impossible successful completion (for example indexing a
    // fixed zero-length array) has a reserved unreachable result point but no value/read.
    // Do not confuse this positive CFG fact with a missing evaluation or invent a source.
    let mut evaluation = usize.ZERO
    while evaluation < evaluations.length {
      let atRead = match evaluations[evaluation].site {
        EvaluationSite.Node {node} => node.index == query.read.index
        EvaluationSite.Entry {..} => false
      }
      if atRead && evaluations[evaluation].category == EvaluationRole.Value {
        found = true
        let reachable = Solution.truth(&self.solution, points[evaluations[evaluation].point.index].reachable)
        run List<usize>.append(&mut observedIds, evaluation)
        run List<SourceEvaluation>.append(&mut observed, SourceEvaluation {
          occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: evaluation}, reachable: reachable})
        if reachable == Truth.Undefined {
          complete = false
          run List<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
        }
      }
      evaluation = evaluation + usize.ONE
    }
    let mut value = usize.ZERO
    while value < values.length {
      let evaluation = values[value].evaluation.index
      let atRead = match evaluations[evaluation].site {
        EvaluationSite.Node {node} => node.index == query.read.index
        EvaluationSite.Entry {..} => false
      }
      if atRead && evaluations[evaluation].category == EvaluationRole.Value {
        let mut selected = false
        let mut accept = usize.ZERO
        while accept < accepts.length {
          if acceptsValue(&self.preparationData, values[value], PreparedSelectionId {index: query.selection.index}, accepts[accept]) { selected = true }
          accept = accept + usize.ONE
        }
        if selected {
          let reachable = Solution.truth(&self.solution, points[evaluations[evaluation].point.index].reachable)
          let mut grounded = false
          let keys = List<CellKey>.asSlice(&self.keys)
          let mut cell = usize.ZERO
          while cell < keys.length {
            if keys[cell].value.index == value && keys[cell].category == SourceRole.Physical {
              let leaf = keys[cell].leaf.index
              let presence = Solution.truth(&self.solution, cells[cell].present)
              if presence != Truth.False {
                if presence == Truth.True { grounded = true }
                if presence == Truth.Undefined {
                  complete = false
                  run List<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
                }
                let mut routeCase = usize.ZERO
                while routeCase < cases.length {
                  if cases[routeCase].target == cell && Solution.truth(&self.solution, cases[routeCase].active) != Truth.False {
                    if Solution.truth(&self.solution, cases[routeCase].active) == Truth.Undefined {
                      complete = false
                      run List<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
                    }
                    run List<SourceAlternative>.append(&mut alternatives, SourceAlternative {
                      leaf: SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: leaf}, origin: leaves[leaf].origin,
                      occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: evaluation},
                      route: SourceRouteId {stamp: Shared<Stamp>.clone(&self.stamp), root: cell},
                      case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: routeCase}})
                  }
                  routeCase = routeCase + usize.ONE
                }
              }
            }
            cell = cell + usize.ONE
          }
          if reachable != Truth.False && !grounded {
            complete = false
            run List<SourceGap>.append(&mut gaps, SourceGap.Ungrounded)
          }
        }
      }
      value = value + usize.ONE
    }
    let observedEvaluations = List<usize>.asSlice(&observedIds)
    let mut observedAt = usize.ZERO
    while observedAt < observedEvaluations.length {
      let reachable = Solution.truth(&self.solution, points[evaluations[observedEvaluations[observedAt]].point.index].reachable)
      let mut accept = usize.ZERO
      while reachable != Truth.False && accept < accepts.length {
        let mut represented = false
        let mut candidate = usize.ZERO
        while candidate < values.length {
          if values[candidate].evaluation.index == observedEvaluations[observedAt]
            && acceptsValue(&self.preparationData, values[candidate], PreparedSelectionId {index: query.selection.index}, accepts[accept]) { represented = true }
          candidate = candidate + usize.ONE
        }
        if !represented {
          complete = false
          run List<SourceGap>.append(&mut gaps, SourceGap.Ungrounded)
        }
        accept = accept + usize.ONE
      }
      observedAt = observedAt + usize.ONE
    }
    if !found {
      complete = false
      run List<SourceGap>.append(&mut gaps, SourceGap.MissingEvaluation)
    }
    return Result<Sources, AccessError>.succeed(Sources {evaluations: move observed, alternatives: move alternatives, gaps: move gaps, complete: complete})
  }

  pub fn occurrence(self: &Self, id: &OccurrenceId) -> Result<Evaluation, AccessError> {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<Evaluation, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let evaluations = List<Evaluation>.asSlice(&self.evaluations)
    if id.index >= evaluations.length { return Result<Evaluation, AccessError>.failResult(AccessError.InvalidOccurrence) }
    return Result<Evaluation, AccessError>.succeed(evaluations[id.index])
  }

  pub effect fn route(self: &Self, id: &SourceRouteId) -> Result<RouteView, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<RouteView, AccessError>.failResult(AccessError.ForeignAnalysis) }
    if id.root >= List<Cell>.length(&self.cells) { return Result<RouteView, AccessError>.failResult(AccessError.InvalidRoute) }
    let closure = run routeClosure(self, id.root)
    let cases = List<Case>.asSlice(&self.cases)
    let ports = List<usize>.asSlice(&closure)
    let mut accepts = List<RoutePortId>.make()
    let mut at = usize.ZERO
    while at < ports.length {
      let mut each = usize.ZERO
      let mut grounded = false
      while each < cases.length {
        if cases[each].target == ports[at] && Solution.truth(&self.solution, cases[each].active) != Truth.False {
          if let Option<usize>.None = cases[each].source { grounded = true }
        }
        each = each + usize.ONE
      }
      if grounded { run List<RoutePortId>.append(&mut accepts, RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: ports[at]}) }
      at = at + usize.ONE
    }
    let leaf = List<CellKey>.asSlice(&self.keys)[id.root].leaf.index
    return Result<RouteView, AccessError>.succeed(RouteView {
      start: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: id.root}, accepts: move accepts,
      leaf: SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: leaf}})
  }

  pub effect fn routePort(self: &Self, route: &SourceRouteId, port: &RoutePortId) -> Result<RoutePort, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &route.stamp) || !sameStamp(&self.stamp, &port.stamp) {
      return Result<RoutePort, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    if route.root >= List<Cell>.length(&self.cells) || port.index >= List<Cell>.length(&self.cells) {
      return Result<RoutePort, AccessError>.failResult(AccessError.InvalidPort)
    }
    let closure = run routeClosure(self, route.root)
    if !contains(List<usize>.asSlice(&closure), port.index) { return Result<RoutePort, AccessError>.failResult(AccessError.InvalidPort) }
    let value = List<CellKey>.asSlice(&self.keys)[port.index].value.index
    let actual = List<Value>.asSlice(&self.valuesData)[value]
    let mut residual = Option<Prepared.ResidualStateId>.none()
    let mut position = Option<Results.Position>.none()
    if let Option<ResidualSubject>.Some {value: matchedSubject} = actual.subject {
      residual = Option<Prepared.ResidualStateId>.some(matchedSubject.state)
      position = matchedSubject.position
    }
    return Result<RoutePort, AccessError>.succeed(RoutePort {summary: actual.summary, position: position, phase: actual.phase, subject: valueShape(&self.preparationData, actual),
      residual: residual, endpoint: actual.endpoint,
      occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: actual.evaluation.index},
      direct: List<CellKey>.asSlice(&self.keys)[port.index].direct, quality: Graph<'body>.quality(self, List<Cell>.asSlice(&self.cells)[port.index])})
  }

  pub effect fn routeEdges(self: &Self, route: &SourceRouteId, port: &RoutePortId) -> Result<List<RouteEdge>, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &route.stamp) || !sameStamp(&self.stamp, &port.stamp) {
      return Result<List<RouteEdge>, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    if route.root >= List<Cell>.length(&self.cells) || port.index >= List<Cell>.length(&self.cells) {
      return Result<List<RouteEdge>, AccessError>.failResult(AccessError.InvalidPort)
    }
    let closure = run routeClosure(self, route.root)
    if !contains(List<usize>.asSlice(&closure), port.index) { return Result<List<RouteEdge>, AccessError>.failResult(AccessError.InvalidPort) }
    let cases = List<Case>.asSlice(&self.cases)
    let mut result = List<RouteEdge>.make()
    let mut at = usize.ZERO
    while at < cases.length {
      if cases[at].target == port.index && Solution.truth(&self.solution, cases[at].active) != Truth.False {
        if let Option<usize>.Some {value: source} = cases[at].source {
          let mut address = Option<OccurrenceId>.none()
          if let Option<EvalId>.Some {value} = authorityAddress(cases[at].authority) {
            address = Option<OccurrenceId>.some(OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: value.index})
          }
          let mut addressProof = Option<AddressRoute>.none()
          if let TransferAuthority.Address {edge, ..} = cases[at].authority {
            let actual = List<AliasEdge>.asSlice(&self.aliasEdges)[edge]
            match actual.authority {
              AliasAuthority.Selected {selection, map} => {
                let use = &List<SelectionUse>.asSlice(&self.selections)[selection]
                addressProof = Option<AddressRoute>.some(AddressRoute.Selected {selection: use.selection, map: map,
                  formation: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: use.result.index}})
              }
              AliasAuthority.Origin {placement} => {
                let selected = List<OriginPlacement>.asSlice(&self.descriptors.placements)[placement]
                let proof = List<OriginProof>.asSlice(&self.descriptors.origins)[selected.proof]
                let origin = List<ReferenceOrigin>.asSlice(&self.references)[proof.origin]
                let descriptor = List<Value>.asSlice(&self.valuesData)[origin.descriptor.index]
                addressProof = Option<AddressRoute>.some(AddressRoute.Origin {creation: origin.map,
                  referent: origin.referent, member: selected.member, state: selected.state,
                  source: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: origin.source.index},
                  descriptor: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: descriptor.evaluation.index},
                  seed: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: proof.seed}, carrier: proof.carrier})
              }
              AliasAuthority.Slice {placement} => {
                let selected = List<SlicePlacement>.asSlice(&self.descriptors.slicePlacements)[placement]
                let proof = List<SliceProof>.asSlice(&self.descriptors.sliceProofs)[selected.proof]
                let conversion = List<SliceConversion>.asSlice(&self.slices)[proof.conversion]
                let row = &List<Prepared.ArraySlice>.asSlice(&self.preparationData.arraySlices)[conversion.prepared]
                let descriptor = List<Value>.asSlice(&self.valuesData)[conversion.descriptor.index]
                addressProof = Option<AddressRoute>.some(AddressRoute.Slice {conversion: conversion.prepared,
                  descriptor: row.descriptor, element: selected.element, member: selected.member, state: selected.state,
                  source: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: conversion.source.index},
                  result: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: descriptor.evaluation.index},
                  case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: proof.case},
                  carrier: proof.carrier, origin: selected.origin})
              }
              _ => { return CompilerBug.panic(b"route lost its actual composite address authority") }
            }
          }
          let mut physical = authorityMap(cases[at].authority)
          let mut operation = Option<OperationRoute>.none()
          if let TransferAuthority.OperationResult {candidate, position} = cases[at].authority {
            physical = Option<MapId>.none()
            operation = Option<OperationRoute>.some(OperationRoute {position: position, operation: candidate.operation,
              binding: candidate.binding,
              operand: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: candidate.operand.index},
              result: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: candidate.result.index},
              selection: candidate.selection, route: candidate.route, projection: candidate.projection,
              continuation: candidate.continuation, output: candidate.output})
          }
          run List<RouteEdge>.append(&mut result, RouteEdge {summary: match cases[at].authority {
            TransferAuthority.SummaryRead {reading} => Option<SummaryRead>.some(List<SummaryRead>.asSlice(&self.summaryReadsData)[reading])
            _ => Option<SummaryRead>.none()
          }, addressProof: move addressProof, operation: move operation,
            direction: authorityDirection(cases[at].authority), address: move address,
            from: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: port.index},
            to: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: source}, map: physical,
            originalContract: authorityContract(cases[at].authority), case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: at}})
        }
      }
      at = at + usize.ONE
    }
    return Result<List<RouteEdge>, AccessError>.succeed(move result)
  }

  pub fn routeCase(self: &Self, id: &RouteCaseId) -> Result<RouteCase, AccessError> {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<RouteCase, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let cases = List<Case>.asSlice(&self.cases)
    if id.index >= cases.length { return Result<RouteCase, AccessError>.failResult(AccessError.InvalidCase) }
    let actual = &cases[id.index]
    let key = List<CellKey>.asSlice(&self.keys)[actual.target]
    let value = key.value.index
    let witness = &List<Witness>.asSlice(&self.witnesses)[key.witness]
    let mut definition = Option<SourceDefinitionId>.none()
    let mut read = Option<SourceReadId>.none()
    if let Option<DefinitionId>.Some {value: matchedDefinition} = witness.definition {
      definition = Option<SourceDefinitionId>.some(SourceDefinitionId {stamp: Shared<Stamp>.clone(&self.stamp), index: matchedDefinition.index})
    }
    if let Option<ReadId>.Some {value: matchedRead} = witness.read {
      read = Option<SourceReadId>.some(SourceReadId {stamp: Shared<Stamp>.clone(&self.stamp), index: matchedRead.index})
    }
    return Result<RouteCase, AccessError>.succeed(RouteCase {applicability: Solution.truth(&self.solution, actual.active),
      definition: move definition, read: move read, placement: List<Value>.asSlice(&self.valuesData)[value].endpoint,
      direct: key.direct, quality: Graph<'body>.quality(self, actual.quality)})
  }
}

fn contains(values: &[usize], value: usize) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at] == value { return true }
    at = at + usize.ONE
  }
  return false
}

// Reachability here is immutable route access, not another source solver. Only the already
// solved case applicability is read; a visited cycle establishes no source or lifetime proof.
effect fn routeClosure<'body>(graph: &Graph<'body>, start: usize) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut result = List<usize>.make()
  run List<usize>.append(&mut result, start)
  let cases = List<Case>.asSlice(&graph.cases)
  let mut next = usize.ZERO
  while next < List<usize>.length(&result) {
    let port = List<usize>.asSlice(&result)[next]
    let mut at = usize.ZERO
    while at < cases.length {
      if cases[at].target == port && Solution.truth(&graph.solution, cases[at].active) != Truth.False {
        if let Option<usize>.Some {value} = cases[at].source {
          if !contains(List<usize>.asSlice(&result), value) { run List<usize>.append(&mut result, value) }
        }
      }
      at = at + usize.ONE
    }
    next = next + usize.ONE
  }
  return move result
}

