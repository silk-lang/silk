//! Immutable occurrence-aware source facts from one complete typed-body reservation.
//!
//! CFG definitions, value transfers and policy guards share SourceRules.Program. A solved
//! Graph owns the exact preparation package and a fresh stamp. Public identifiers cannot be
//! applied to another analysis, even after the producing graph is dropped and memory reused.

import semantic.SourcePreparation {
  ApplicationId, ContractRouteId, Coverage, EndpointId, MapId, SelectionId as PreparedSelectionId,
  SourcePreparation, Selection, SelectionMap, ContractRoute, Root, Endpoint, Selector, MapKind,
  InputRoute, InputRead, Transport, EndpointRole, IndexClass, ShapeId,
}
import semantic.SourcePreparation as Prepared
import semantic.SourceResults as Results
import semantic.SourceStores as Stores
import semantic.SourceCarriers as Carriers
import semantic.SourceFlow {ComponentId, Definition, DefinitionId, Flow, PointId, Read, ReadId, Reaching, Point, Pair, Write}
import semantic.SourceRules {Atom, Program, Solution, Truth}
import semantic.TypedBody {Local, LocalId, Node, NodeId, NodeKind, Origin, Expression, AggregateField, SafetyObligation}
import semantic.Type {Type}
import semantic.StorageOperation {StorageOperation}
import semantic.Semantic {Constraint}
import hir.Hir {Access as ReferenceAccess}
import semantic.Lifetime {Lifetime}
import semantic.SourceLocations {Location}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.option {Option}
import silk.ownership {Copy}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.shared {Shared}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.list {List}
import CompilerBug

/// A static evaluation role. Repeated evaluations of the same NodeId have separate EvalIds.
pub enum EvaluationRole { Entry, Value, Receiver, Argument, Capture, Cleanup, Run, Binding, Replacement, Execute }
pub struct EvalId { pub index: usize }
impl Copy for EvalId {}
pub struct ValueId { pub index: usize }
impl Copy for ValueId {}
/// The real acquisition occurrence precedes later operands even when their enclosing call
/// never produces a value. Its loan identity is supplied by the ownership projection.
pub struct ReferenceAcquisition { pub evaluation: EvalId, pub loan: usize }
impl Copy for ReferenceAcquisition {}

pub struct LeafId { pub index: usize }
impl Copy for LeafId {}

pub union SourceLeaf {
  Entry { pub local: LocalId },
  Borrow { pub loan: usize, pub node: Option<NodeId> },
  Expression { pub node: NodeId },
  LoanFree { pub node: NodeId },
  Unknown { pub node: Option<NodeId>, pub reason: UnknownReason },
}
pub enum UnknownReason { OpaqueSource, UnavailableDeclaration, UnsupportedTransfer, Uninitialized }

pub struct Leaf {
  pub kind: SourceLeaf
  pub origin: Origin
  pub endpoint: EndpointId
}

pub union EvaluationSite { Entry { pub local: LocalId }, Node { pub node: NodeId } }
impl Copy for EvaluationSite {}

pub struct Evaluation {
  pub site: EvaluationSite
  pub role: EvaluationRole
  pub point: PointId
}
impl Copy for Evaluation {}

/// One observation at actual execution, distinct from a possibly noncompleting result.
struct Execution { result: EvalId, observation: EvalId }
impl Copy for Execution {}

/// One physical component of an actual value occurrence. Historical alternatives do not add
/// values: they add conditional cases reaching this same port.
pub struct ResidualSubject {
  pub base: ValueId
  pub state: Prepared.ResidualStateId
  /// An operation suffix retains its exact root/current coordinate before any query join.
  pub position: Option<Results.Position>
}
impl Copy for ResidualSubject {}
pub enum ValuePhase { Input, Output, Transport }

/// A private address-composition lane. Equal physical endpoints in different canonical
/// address proofs cannot exchange contents before reaching the actual read/publication.
struct AliasPort { request: usize, alias: usize }
impl Copy for AliasPort {}

pub struct Value {
  pub phase: ValuePhase
  pub evaluation: EvalId
  /// Actual physical anchor. A residual subject selects a finite prepared component without
  /// inventing a recursive endpoint or claiming the anchor's whole contents were copied.
  pub endpoint: EndpointId
  pub subject: Option<ResidualSubject>
  transport: Option<AliasPort>
}
impl Copy for Value {}

pub enum Directness { Preserve, Direct, Indirect }
pub enum TransferPolicy { Physical, Filtered }

/// A physical value map runs forward. Only an authenticated Storage->Storage address map
/// may run inversely while placing a value into the canonical storage it actually denotes.
pub enum MapDirection { Forward, StorageInverse }

/// A transfer has one correspondence authority. A physical map never stands in for
/// an input binding plus a declaration route plus an applied result projection.
pub union TransferAuthority {
  SameComponent,
  RetainedWrite { pub candidate: usize },
  Physical { pub map: MapId, pub direction: MapDirection, pub address: Option<EvalId> },
  OperationResult { pub candidate: Results.Candidate, pub position: Option<Results.Position> },
  /// Current contents through a retained composite address proof, never an invented map.
  Address { pub edge: usize, pub direction: MapDirection },
}
impl Copy for TransferAuthority {}

/// Placement map for policy consumers; a declared output map is only the final leg.
/// Public route traversal exposes the complete OperationRoute instead of claiming one map.
fn authorityMap(authority: TransferAuthority) -> Option<MapId> {
  return match authority {
    TransferAuthority.Physical {map, ..} => Option<MapId>.some(map)
    TransferAuthority.OperationResult {candidate, ..} => Option<MapId>.some(candidate.output)
    _ => Option<MapId>.none()
  }
}
fn authorityContract(authority: TransferAuthority) -> Option<ContractRouteId> {
  return match authority {
    TransferAuthority.OperationResult {candidate, ..} => Option<ContractRouteId>.some(candidate.route)
    _ => Option<ContractRouteId>.none()
  }
}
fn authorityDirection(authority: TransferAuthority) -> MapDirection {
  return match authority { TransferAuthority.Physical {direction, ..} => direction
    TransferAuthority.Address {direction, ..} => direction _ => MapDirection.Forward }
}
fn authorityAddress(authority: TransferAuthority) -> Option<EvalId> {
  return match authority { TransferAuthority.Physical {address, ..} => address _ => Option<EvalId>.none() }
}
fn readAuthority(map: Option<MapId>) -> TransferAuthority {
  return match map {
    Option<MapId>.Some {value} => TransferAuthority.Physical {
      map: value, direction: MapDirection.Forward, address: Option<EvalId>.none()}
    Option<MapId>.None => TransferAuthority.SameComponent
  }
}

/// Actual source/read/definition evidence travels together on each transfer. Placement is the
/// target value's prepared endpoint; source and target are never recovered from region equality.
pub struct Transfer {
  pub source: ValueId
  pub target: ValueId
  pub active: Atom
  pub directness: Directness
  pub stored: Atom
  pub alternatives: Atom
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub policy: TransferPolicy
  pub terminal: bool
  pub authority: TransferAuthority
}

pub struct Seed {
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub active: Atom
  pub stored: Atom
  pub alternatives: Atom
}
impl Copy for Seed {}

/// Canonical storage identity includes the physical temporary occurrence. Reusing a typed
/// NodeId does not make its two evaluated owners the same storage. Local declaration storage
/// has no temporary occurrence; caller/source identity is never inferred from a type or region.
pub struct Storage {
  pub endpoint: EndpointId
  pub temporary: Option<EvalId>
}
impl Copy for Storage {}

fn sameResultPosition(left: Option<Results.Position>, right: Option<Results.Position>) -> bool {
  return match left {
    Option<Results.Position>.Some {value} => match right {
      Option<Results.Position>.Some {value: other} => Results.samePosition(value, other)
      _ => false
    }
    Option<Results.Position>.None => match right { Option<Results.Position>.None => true _ => false }
  }
}

fn sameSubject(left: Option<ResidualSubject>, right: Option<ResidualSubject>) -> bool {
  return match left {
    Option<ResidualSubject>.Some {value} => match right {
      Option<ResidualSubject>.Some {value: other} => value.base.index == other.base.index && value.state.index == other.state.index && sameResultPosition(value.position, other.position)
      _ => false
    }
    Option<ResidualSubject>.None => match right { Option<ResidualSubject>.None => true _ => false }
  }
}

fn valueShape<'body>(prepared: &SourcePreparation<'body>, value: Value) -> ShapeId {
  return match value.subject {
    Option<ResidualSubject>.Some {value: selected} => List<Prepared.ResidualState>.asSlice(&prepared.residuals)[selected.state.index].output
    Option<ResidualSubject>.None => List<Endpoint>.asSlice(&prepared.endpoints)[value.endpoint.index].shape
  }
}

fn sameStorage(left: Storage, right: Storage) -> bool {
  if left.endpoint.index != right.endpoint.index { return false }
  return match left.temporary {
    Option<EvalId>.Some {value} => match right.temporary { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
    Option<EvalId>.None => match right.temporary { Option<EvalId>.None => true _ => false }
  }
}

/// A definition's value is the actual stored component, after its RHS placement. Entries,
/// loan-free replacements and opaque/unknown values use the same definition representation.
struct DefinedValue {
  definition: DefinitionId
  value: ValueId
  writer: Option<EvalId>
}
impl Copy for DefinedValue {}

/// A read supplies its actual storage-to-value map once. Complete definition/read pairing is
/// reserved later, including definitions not yet visited when the read was encountered.
struct ReadValue {
  read: ReadId
  storage: Storage
  value: ValueId
  map: Option<MapId>
}
impl Copy for ReadValue {}

/// An actual place occurrence denotes canonical storage through an explicit finite graph of
/// prepared Select maps. This is address identity, not a snapshot of that storage's contents.
pub struct StorageAlias {
  pub evaluation: EvalId
  pub endpoint: EndpointId
  pub storage: Storage
  /// Grounded applicability of this exact address history in the one source program.
  pub active: Atom
  pub write: Write
}

/// Proof edges share finite alias nodes. An edge is not a new physical occurrence or a
/// reaching definition. Only canonical seeds ground the positive address-proof equations.
union AliasAuthority {
  Canonical,
  Project {map: MapId},
  Selected {selection: usize, map: MapId},
  Origin {placement: usize},
  Slice {placement: usize},
}
impl Copy for AliasAuthority {}
struct AliasEdge {
  source: Option<usize>
  target: usize
  authority: AliasAuthority
  active: Atom
}
impl Copy for AliasEdge {}
fn sameAliasAuthority(left: AliasAuthority, right: AliasAuthority) -> bool {
  return match left {
    AliasAuthority.Canonical => match right { AliasAuthority.Canonical => true _ => false }
    AliasAuthority.Project {map} => match right { AliasAuthority.Project {map: other} => map.index == other.index _ => false }
    AliasAuthority.Selected {selection, map} => match right {
      AliasAuthority.Selected {selection: other, map: otherMap} => selection == other && map.index == otherMap.index
      _ => false
    }
    AliasAuthority.Origin {placement} => match right { AliasAuthority.Origin {placement: other} => placement == other _ => false }
    AliasAuthority.Slice {placement} => match right { AliasAuthority.Slice {placement: other} => placement == other _ => false }
  }
}
fn aliasMap(authority: AliasAuthority) -> Option<MapId> {
  return match authority {
    AliasAuthority.Project {map} => Option<MapId>.some(map)
    AliasAuthority.Selected {map, ..} => Option<MapId>.some(map)
    _ => Option<MapId>.none()
  }
}
union AliasConsumer {
  Projection {map: MapId},
  Retained {request: usize, path: usize, prefix: usize, edge: usize},
}
impl Copy for AliasConsumer {}
struct AliasTransport {
  // Exact consumer retained at emission, then changed only by its real Input/Output split.
  consumer: Option<ValueId>
  alias: usize
  authority: AliasConsumer
  evaluation: EvalId
  active: Atom
  direction: MapDirection
  closed: usize
}
impl Copy for AliasTransport {}

struct AliasRead { request: usize, read: ReadId }
impl Copy for AliasRead {}

/// Actual selected read correspondence. storage is the requested canonical component,
/// not the post-selection Value endpoint. Ancestor/opaque summaries require their own
/// retained source component and cannot borrow this exact-component certificate.
pub struct ReadPlacement {
  pub consumer: ValueId
  pub read: ReadId
  pub storage: Storage
  pub map: MapId
  pub operand: EvalId
  pub result: EvalId
  pub alias: Option<usize>
  pub active: Atom
}
impl Copy for ReadPlacement {}

/// Deferred address consumers are recorded at their actual execution points. Candidate
/// closure may discover another address history later; it extends this same operation's
/// destination gate instead of creating a second store or rereading a prior snapshot.
union AliasOperationKind {
  Project { map: MapId, source: EvalId, target: EvalId, write: Write },
  Read { map: MapId, source: EvalId, target: EvalId, active: Atom },
  Write { map: MapId, source: EvalId, address: EvalId, target: EvalId, active: Atom },
  Invalidate { address: EvalId, root: EndpointId, target: EvalId, origin: Origin, active: Atom },
}
impl Copy for AliasOperationKind {}
struct AliasOperation {
  kind: AliasOperationKind
  closed: usize
}
impl Copy for AliasOperation {}
struct AliasDefinition {
  operation: usize
  storage: Storage
  active: Atom
  definition: DefinitionId
}

/// A real reference descriptor remembers its actual address formation, not a copy of the
/// referent's then-current contents. The paired map is frozen interpretation evidence for
/// a later read at its own use point; it must never become a borrow-time value snapshot.
pub struct ReferenceOrigin {
  pub leaf: LeafId
  pub source: EvalId
  pub descriptor: ValueId
  pub map: MapId
  pub referent: MapId
}
impl Copy for ReferenceOrigin {}

/// An actual selection occurrence retains its frozen selector path and distinct value/place
/// families. It is activated after candidate address closure, at result's current read point;
/// merely reserving an endpoint or a selection never evaluates it.
pub struct SelectionUse {
  pub operand: EvalId
  pub result: EvalId
  pub selection: PreparedSelectionId
  pub selectors: List<MapId>
  pub value: Option<MapId>
  pub place: Option<MapId>
  pub strength: Write
  pub active: Atom
}

/// A retained call selector has no projection result family. Its selection belongs to
/// originating, while every current contents read belongs to the exact execution Eval.
pub struct RetainedPath {pub endpoint: EndpointId, pub selectors: List<MapId>}
pub struct RetainedRequest {
  pub operation: usize
  pub input: usize
  pub slot: usize
  pub retention: Prepared.RetentionId
  pub originating: EvalId
  pub operand: EvalId
  pub usePoint: PointId
  pub execution: EvalId
  pub original: PreparedSelectionId
  pub selection: PreparedSelectionId
  pub paths: List<RetainedPath>
  pub active: Atom
}

/// Exact descriptor contributor BEFORE crossing this particular address proof edge.
/// alias.active is a join and is deliberately not the history's applicability gate.
pub struct RetainedAddress {
  pub operation: usize
  pub input: usize
  pub slot: usize
  pub path: usize
  pub descriptor: ValueId
  pub leaf: LeafId
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub direct: bool
  pub alias: usize
  pub edge: usize
  pub storage: Storage
  pub active: Atom
}
impl Copy for RetainedAddress {}

/// The original SlotCoverage remains in retention. These flags describe only its frozen
/// structural coverage; addresses do not establish complete descriptor/origin coverage.
pub struct RetainedStatus {
  pub request: usize
  pub originalExact: bool
  pub physicalExact: bool
  pub empty: bool
  pub missing: Atom
}
impl Copy for RetainedStatus {}

/// A real canonical read made while interpreting a retained prefix at execution. Prefix
/// counts selector edges from the request root; no invented Copy map labels this read.
pub struct RetainedRead {
  pub request: usize
  pub path: usize
  pub prefix: usize
  pub consumer: ValueId
  pub read: ReadId
  pub alias: usize
  pub edge: usize
  pub active: Atom
}
impl Copy for RetainedRead {}

/// Read-only joins of the original source-flow identity with its actual stored/read value.
/// Consumers cannot manufacture a second reaching relation from these projections.
pub struct DefinitionView {
  /// Actual defining operation, retained at emission; body-entry initialization has none.
  pub writer: Option<EvalId>
  pub id: DefinitionId
  pub point: PointId
  pub storage: Storage
  pub value: ValueId
  pub active: Atom
  pub write: Write
}
impl Copy for DefinitionView {}
pub struct ReadView {
  pub id: ReadId
  pub point: PointId
  pub storage: Storage
  pub value: ValueId
  pub map: Option<MapId>
}
impl Copy for ReadView {}

/// Structural producer; no source alternative is selected during reservation. The BorrowCheck
/// visitor records actual roots, evaluations, storage and typed transfers into this one skeleton.
/// Semantic handlers select terminal result boundaries before the single reservation.
/// The graph neither infers a handler from a map kind nor duplicates written operands.
pub union ResultKind { Physical, Read { pub read: EvalId }, Declared }
impl Copy for ResultKind {}
pub struct ResultUse {
  pub evaluation: EvalId
  pub active: Atom
  pub kind: ResultKind
  pub sources: List<EvalId>
}

/// A policy candidate is an actual source component plus one exact destination address
/// contributor. Slot eligibility belongs to BorrowCheck, never candidate reservation.
pub struct RetainedWrite {
  pub operation: usize
  pub sourceInput: usize
  pub sourceSlot: usize
  pub address: usize
  pub source: ValueId
  pub target: ValueId
  pub holder: usize
  pub active: Atom
}
impl Copy for RetainedWrite {}
pub struct WriteComponent {
  pub storage: Storage
  pub value: ValueId
  pub read: ReadId
  pub definition: DefinitionId
}
impl Copy for WriteComponent {}
pub struct WriteHolder {
  pub execution: EvalId
  pub storage: Storage
  pub active: Atom
  pub components: List<WriteComponent>
}

/// One ORIGINAL enumeration row at an actual invocation, including empty and incomplete
/// rows. The immutable inventory owns its candidates; coverage remains the exact prepared
/// ContractSelection. active is execution/completion applicability, not predicate admission.
pub struct OperationContributor {
  pub operation: usize
  pub output: usize
  pub contributor: usize
  pub active: Atom
}
impl Copy for OperationContributor {}

pub struct Skeleton {
  operationResultsInstalled: bool
  operationResults: Results.Inventory
  operationContributors: List<OperationContributor>
  stores: Stores.Inventory
  writes: List<RetainedWrite>
  writeHolders: List<WriteHolder>
  pub results: List<ResultUse>
  pub rules: Program
  pub flow: Flow
  pub evaluations: List<Evaluation>
  executions: List<Execution>
  pub values: List<Value>
  pub leaves: List<Leaf>
  pub transfers: List<Transfer>
  pub seeds: List<Seed>
  pub storage: List<Storage>
  pub aliases: List<StorageAlias>
  aliasEdges: List<AliasEdge>
  aliasTransports: List<AliasTransport>
  aliasReads: List<AliasRead>
  pub selections: List<SelectionUse>
  retainedRequests: List<RetainedRequest>
  retainedAddresses: List<RetainedAddress>
  retainedStatus: List<RetainedStatus>
  retainedReads: List<RetainedRead>
  aliasOperations: List<AliasOperation>
  aliasDefinitions: List<AliasDefinition>
  references: List<ReferenceOrigin>
  slices: List<SliceConversion>
  definitions: List<DefinedValue>
  reads: List<ReadValue>
  closedPairs: usize
}

/// A source-quality observation. Presence is separate from positive loss bits: an absent cell
/// is not Exact, and an unresolved loss is not false.
pub struct Cell {
  pub present: Atom
  pub stored: Atom
  pub alternatives: Atom
}
impl Copy for Cell {}

/// One policy scan position for a physical value component and one source leaf. Reaching
/// histories belong to cases, not additional positions; genuinely repeated operands have
/// distinct ValueIds. Entry/loan-free/unknown inputs remain visible but are not Borrow counts.
pub struct Input {
  pub value: ValueId
  pub leaf: LeafId
  pub quality: Cell
  pub cases: List<InputCase>
}

/// All case attributes come from one paired route. Policy guards cannot combine one history's
/// directness or placement with another history's definition/read or quality.
pub struct InputCase {
  pub source: Option<ValueId>
  pub placement: EndpointId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub map: Option<MapId>
  pub direction: MapDirection
  pub address: Option<EvalId>
  pub contract: Option<ContractRouteId>
  pub quality: Cell
}

struct CellKey {
  value: ValueId
  leaf: LeafId
  witness: usize
  direct: bool
}
impl Copy for CellKey {}

struct Witness {
  definition: Option<DefinitionId>
  read: Option<ReadId>
}

struct Case {
  source: Option<usize>
  target: usize
  active: Atom
  quality: Cell
  definition: Option<DefinitionId>
  read: Option<ReadId>
  authority: TransferAuthority
}

/// One pre-reserved policy decision for a concrete candidate source and paired history.
/// Multiple leaves using the same physical transfer have DIFFERENT ports: one source's
/// retained result must not activate every other source on that transfer.
pub struct PolicyPortId { index: usize }
impl Copy for PolicyPortId {}
pub struct PolicyPort {
  pub terminal: bool
  pub authority: TransferAuthority
  /// Exact operation/route applicability, independent of predecessor source presence.
  pub active: Atom
  pub id: PolicyPortId
  pub transfer: usize
  pub source: ValueId
  pub target: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub outputDirect: bool
  pub map: Option<MapId>
  pub contract: Option<ContractRouteId>
  pub direction: MapDirection
  pub address: Option<EvalId>
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub quality: Cell
}
impl Copy for PolicyPort {}

struct PendingPolicy {
  port: PolicyPort
  sourceCell: usize
  kept: Atom
  stored: Atom
  alternatives: Atom
  bound: bool
}
impl Copy for PendingPolicy {}

/// Policy translation adds rules to these reserved cells and observation versions, never new
/// source leaves or components. There is only one solve, after all consumers have emitted rules.
pub struct Builder<'body> {
  operationResults: Results.Inventory
  operationContributors: List<OperationContributor>
  stores: Stores.Inventory
  writes: List<RetainedWrite>
  writeHolders: List<WriteHolder>
  pub rules: Program
  pub reaching: Reaching
  storage: List<Storage>
  selections: List<SelectionUse>
  retainedRequests: List<RetainedRequest>
  retainedAddresses: List<RetainedAddress>
  retainedStatus: List<RetainedStatus>
  retainedReads: List<RetainedRead>
  descriptors: DescriptorClosure
  aliases: List<StorageAlias>
  aliasEdges: List<AliasEdge>
  aliasTransports: List<AliasTransport>
  aliasReads: List<AliasRead>
  references: List<ReferenceOrigin>
  slices: List<SliceConversion>
  definitions: List<DefinedValue>
  reads: List<ReadValue>
  preparation: SourcePreparation<'body>
  evaluations: List<Evaluation>
  executions: List<Execution>
  values: List<Value>
  leaves: List<Leaf>
  cells: List<Cell>
  keys: List<CellKey>
  witnesses: List<Witness>
  cases: List<Case>
  policies: List<PendingPolicy>
}

struct Stamp { marker: bool }
fn stampAddress(value: &Stamp) -> usize {
  return Pointer.address<Stamp>(Pointer.fromRef<Stamp>(value))
}
fn sameStamp(left: &Shared<Stamp>, right: &Shared<Stamp>) -> bool {
  return Shared<Stamp>.with<usize>(left, stampAddress) == Shared<Stamp>.with<usize>(right, stampAddress)
}

pub struct SourceLeafId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SelectionId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SourceRouteId {
  stamp: Shared<Stamp>
  root: usize
}
pub struct RoutePortId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct RouteCaseId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct OccurrenceId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SourceDefinitionId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SourceReadId {
  stamp: Shared<Stamp>
  index: usize
}

pub enum AccessError { ForeignAnalysis, InvalidSelection, InvalidRoute, InvalidPort, InvalidCase, InvalidOccurrence }

pub struct SourceQuery {
  pub read: NodeId
  pub selection: SelectionId
}

pub struct Quality {
  pub present: Truth
  pub stored: Truth
  pub alternatives: Truth
}

pub struct SourceAlternative {
  pub leaf: SourceLeafId
  pub origin: Origin
  pub occurrence: OccurrenceId
  pub route: SourceRouteId
  pub case: RouteCaseId
}

pub enum SourceGap { MissingEvaluation, Recovery, Ungrounded, UnresolvedApplicability }

pub struct SourceEvaluation {
  pub occurrence: OccurrenceId
  pub reachable: Truth
}

pub struct Sources {
  pub evaluations: List<SourceEvaluation>
  pub alternatives: List<SourceAlternative>
  pub gaps: List<SourceGap>
  /// Enumeration only. Unknown leaves and unresolved cases still owe their semantic proof.
  pub complete: bool
}

pub struct RouteView {
  pub start: RoutePortId
  pub accepts: List<RoutePortId>
  pub leaf: SourceLeafId
}

pub struct RoutePort {
  pub position: Option<Results.Position>
  pub phase: ValuePhase
  pub subject: ShapeId
  pub residual: Option<Prepared.ResidualStateId>
  pub endpoint: EndpointId
  pub occurrence: OccurrenceId
  pub direct: bool
  pub quality: Quality
}

/// Backward proof traversal: from is the receiving value and to is its prior source. The
/// prepared map retains its forward physical source->target orientation, so from corresponds
/// to map.target and to corresponds to map.source for Forward. StorageInverse reverses this
/// orientation only for authenticated address identity; address names the real place occurrence.
/// Neither direction manufactures a map or treats a reference boundary as storage identity.
/// Declaration composition is not a physical map. The actual input and result occurrences
/// are stamped; table IDs remain scoped to this graph's immutable preparation package.
pub struct OperationRoute {
  pub position: Option<Results.Position>
  pub operation: usize
  pub input: usize
  pub inputMap: MapId
  pub operand: OccurrenceId
  pub result: OccurrenceId
  pub selection: Prepared.ContractSelectionId
  pub route: ContractRouteId
  pub projection: Prepared.ContractProjectionId
  pub continuation: Option<Prepared.ContractContinuationId>
  pub output: MapId
}

/// Exceptional address-role crossings retain their actual producer/selection authority.
/// This is a contents correspondence at a current use, not an outlives certificate.
pub union AddressRoute {
  Slice {pub conversion: usize, pub descriptor: MapId, pub element: usize, pub member: MapId,
    pub state: Prepared.ResidualStateId, pub source: OccurrenceId, pub result: OccurrenceId,
    pub case: RouteCaseId, pub carrier: usize, pub origin: usize},
  Selected {pub selection: PreparedSelectionId, pub map: MapId, pub formation: OccurrenceId},
  Origin {pub creation: MapId, pub referent: MapId, pub member: MapId,
    pub state: Prepared.ResidualStateId, pub source: OccurrenceId, pub descriptor: OccurrenceId,
    pub seed: RouteCaseId, pub carrier: usize},
}

pub struct RouteEdge {
  pub addressProof: Option<AddressRoute>
  pub operation: Option<OperationRoute>
  pub direction: MapDirection
  pub address: Option<OccurrenceId>
  pub from: RoutePortId
  pub to: RoutePortId
  pub map: Option<MapId>
  pub originalContract: Option<ContractRouteId>
  pub case: RouteCaseId
}

pub struct RouteCase {
  pub applicability: Truth
  pub definition: Option<SourceDefinitionId>
  pub read: Option<SourceReadId>
  pub placement: EndpointId
  pub direct: bool
  pub quality: Quality
}

pub union SourceDisposition { Proved, Pending, Refuted { pub origin: Origin } }
pub struct SourceOutcome {
  stamp: Shared<Stamp>
  ordinal: usize
  disposition: SourceDisposition
}

/// Owns all immutable source and policy facts for this invocation. It is neither a query answer
/// nor TypedBody metadata and exposes no rebase/copy constructor.
pub struct Graph<'body> {
  operationResults: Results.Inventory
  operationContributors: List<OperationContributor>
  stores: Stores.Inventory
  writes: List<RetainedWrite>
  writeHolders: List<WriteHolder>
  stamp: Shared<Stamp>
  preparation: SourcePreparation<'body>
  solution: Solution
  reaching: Reaching
  storage: List<Storage>
  selections: List<SelectionUse>
  retainedRequests: List<RetainedRequest>
  retainedAddresses: List<RetainedAddress>
  retainedStatus: List<RetainedStatus>
  retainedReads: List<RetainedRead>
  descriptors: DescriptorClosure
  aliases: List<StorageAlias>
  aliasEdges: List<AliasEdge>
  aliasTransports: List<AliasTransport>
  aliasReads: List<AliasRead>
  references: List<ReferenceOrigin>
  slices: List<SliceConversion>
  definitions: List<DefinedValue>
  reads: List<ReadValue>
  evaluations: List<Evaluation>
  executions: List<Execution>
  values: List<Value>
  leaves: List<Leaf>
  cells: List<Cell>
  keys: List<CellKey>
  witnesses: List<Witness>
  cases: List<Case>
}

impl Skeleton {
  pub fn make() -> Self {
    return Skeleton {operationResultsInstalled: false, operationResults: Results.Inventory {operations: List<Results.Operation>.make()},
      operationContributors: List<OperationContributor>.make(), stores: Stores.Inventory {operations: List<Stores.Operation>.make()}, writes: List<RetainedWrite>.make(), writeHolders: List<WriteHolder>.make(), results: List<ResultUse>.make(), rules: Program.make(), flow: Flow.make(), evaluations: List<Evaluation>.make(), executions: List<Execution>.make(),
      values: List<Value>.make(), leaves: List<Leaf>.make(), transfers: List<Transfer>.make(), seeds: List<Seed>.make(),
      storage: List<Storage>.make(), aliases: List<StorageAlias>.make(), aliasEdges: List<AliasEdge>.make(), aliasTransports: List<AliasTransport>.make(), aliasReads: List<AliasRead>.make(), selections: List<SelectionUse>.make(), retainedRequests: List<RetainedRequest>.make(), retainedAddresses: List<RetainedAddress>.make(), retainedStatus: List<RetainedStatus>.make(), retainedReads: List<RetainedRead>.make(), aliasOperations: List<AliasOperation>.make(), aliasDefinitions: List<AliasDefinition>.make(), references: List<ReferenceOrigin>.make(), slices: List<SliceConversion>.make(), definitions: List<DefinedValue>.make(), reads: List<ReadValue>.make(), closedPairs: usize.ZERO}
  }

  pub effect fn evaluate(self: &mut Self, node: NodeId, role: EvaluationRole, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let id = EvalId {index: List<Evaluation>.length(&self.evaluations)}
    run List<Evaluation>.append(&mut self.evaluations, Evaluation {site: EvaluationSite.Node {node: node}, role: role, point: point})
    return id
  }

  /// The caller supplies the retained operation's actual execution point. Intern by its
  /// result occurrence, never by node identity or a point scan; there is no new CFG point.
  pub effect fn execution(self: &mut Self, result: EvalId, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, result)
    let node = match actual.site { EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"entry is not an executing operation") } }
    let previous = List<Execution>.asSlice(&self.executions)
    let mut at = usize.ZERO
    while at < previous.length {
      if previous[at].result.index == result.index {
        let retained = Skeleton.evaluation(&self.*, previous[at].observation)
        if retained.point.index != point.index { return CompilerBug.panic(b"one operation changed its execution point") }
        return previous[at].observation
      }
      at = at + usize.ONE
    }
    if point.index >= Flow.reservedPoints(&self.flow).length { return CompilerBug.panic(b"execution has no reserved operation point") }
    let observation = run Skeleton.evaluate(&mut self.*, node, EvaluationRole.Execute, point)
    run List<Execution>.append(&mut self.executions, Execution {result: result, observation: observation})
    return observation
  }

  /// SourceStores has already authenticated the complete actual call/receiver chain.
  /// This method binds its immutable coordinates to the shared execution observation.
  pub effect fn reserveRetained<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    operation: usize, source: &Stores.Operation, execution: EvalId) -> () ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, execution)
    let result = Skeleton.evaluation(&self.*, source.evaluation)
    let same = match actual.site {
      EvaluationSite.Node {node} => match result.site { EvaluationSite.Node {node: other} => node.index == other.index _ => false }
      _ => false
    }
    let executions = List<Execution>.asSlice(&self.executions)
    let mut found = false
    let mut at = usize.ZERO
    while at < executions.length {
      if executions[at].result.index == source.evaluation.index && executions[at].observation.index == execution.index { found = true }
      at = at + usize.ONE
    }
    if !found || !same || actual.role != EvaluationRole.Execute || actual.point.index != source.execute.index {
      CompilerBug.panic(b"retained selector lost its actual execution observation")
    }
    let old = List<RetainedRequest>.asSlice(&self.retainedRequests)
    at = usize.ZERO
    while at < old.length {
      if old[at].operation == operation { CompilerBug.panic(b"retained operation was installed twice") }
      at = at + usize.ONE
    }
    let retained = List<Prepared.Retention>.asSlice(&prepared.retentions)
    if source.retention.index >= retained.length { CompilerBug.panic(b"retained selector lost its original stage") }
    let record = &retained[source.retention.index]
    let origin = Skeleton.evaluation(&self.*, source.originating)
    let original = match origin.site { EvaluationSite.Node {node} => node.index == record.site.index _ => false }
    if !original { CompilerBug.panic(b"retained selector changed its originating call") }
    let operands = List<Prepared.RetentionOperand>.asSlice(&record.operands)
    let inputs = List<Stores.Input>.asSlice(&source.inputs)
    if inputs.length != operands.length { CompilerBug.panic(b"retained requests omitted an original operand") }
    let mut input = usize.ZERO
    while input < inputs.length {
      let slots = List<Stores.Slot>.asSlice(&inputs[input].slots)
      let owning = List<Prepared.RetentionSlot>.asSlice(&operands[input].slots)
      if inputs[input].operand != operands[input].operand || inputs[input].route != operands[input].input
        || slots.length != owning.length { CompilerBug.panic(b"retained requests changed their input/slot coordinates") }
      let mut slot = usize.ZERO
      while slot < slots.length {
        let selected = &slots[slot]
        if selected.slot != owning[slot].slot || selected.original.index != owning[slot].original.selection.index
          || selected.physical.index != owning[slot].physical.selection.index {
          CompilerBug.panic(b"retained request substituted another original slot selection")
        }
        let paths = List<Stores.Path>.asSlice(&selected.paths)
        let mut copied = List<RetainedPath>.make()
        let mut path = usize.ZERO
        while path < paths.length {
          let mut selectors = List<MapId>.make()
          let maps = List<MapId>.asSlice(&paths[path].selectors)
          let mut step = usize.ZERO
          while step < maps.length { run List<MapId>.append(&mut selectors, maps[step]) step = step + usize.ONE }
          run List<RetainedPath>.append(&mut copied, RetainedPath {endpoint: paths[path].endpoint, selectors: move selectors})
          path = path + usize.ONE
        }
        let request = List<RetainedRequest>.length(&self.retainedRequests)
        let active = Flow.reachable(&self.flow, source.execute)
        run List<RetainedRequest>.append(&mut self.retainedRequests, RetainedRequest {
          operation: operation, input: input, slot: slot, retention: source.retention, originating: source.originating,
          operand: inputs[input].actual.evaluation, usePoint: inputs[input].actual.usePoint, execution: execution,
          original: selected.original, selection: selected.physical, paths: move copied, active: active})
        let originalExact = match &owning[slot].original.coverage { Prepared.SlotCoverage.Exact => true _ => false }
        let physicalExact = match &owning[slot].physical.coverage { Prepared.SlotCoverage.Exact => true _ => false }
        let originalEmpty = match &owning[slot].original.coverage { Prepared.SlotCoverage.EmptyArray {..} => true _ => false }
        let physicalEmpty = match &owning[slot].physical.coverage { Prepared.SlotCoverage.EmptyArray {..} => true _ => false }
        let missing = Program.atom(&mut self.rules)
        if (!originalExact && !originalEmpty) || (!physicalExact && !physicalEmpty) {
          let gates: [Atom; 1] = [active]
          let empty = List<Atom>.make()
          run Program.rule(&mut self.rules, missing, &gates, List<Atom>.asSlice(&empty))
        }
        run List<RetainedStatus>.append(&mut self.retainedStatus, RetainedStatus {request: request,
          originalExact: originalExact, physicalExact: physicalExact, empty: originalEmpty || physicalEmpty, missing: missing})
        slot = slot + usize.ONE
      }
      input = input + usize.ONE
    }
    return ()
  }

  /// The immutable occurrence inventory was authenticated against Traversal and Results.
  /// Requests use an execution observation even if the successful result is unreachable.
  pub effect fn installStores<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, inventory: Stores.Inventory) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if List<Stores.Operation>.length(&self.stores.operations) != usize.ZERO
      || List<RetainedRequest>.length(&self.retainedRequests) != usize.ZERO {
      CompilerBug.panic(b"retained operations were installed twice")
    }
    let operations = List<Stores.Operation>.asSlice(&inventory.operations)
    let mut at = usize.ZERO
    while at < operations.length {
      let execution = run Skeleton.execution(&mut self.*, operations[at].evaluation, operations[at].execute)
      run Skeleton.reserveRetained(&mut self.*, prepared, at, &operations[at], execution)
      at = at + usize.ONE
    }
    self.stores = move inventory
    return ()
  }

  effect fn writeHolder<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, execution: EvalId,
    storage: Storage) -> usize ! OutOfMemoryError ? &mut Allocator {
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let root = storageOwner(prepared, storage.endpoint)
    let whole = Storage {endpoint: root, temporary: storage.temporary}
    let old = List<WriteHolder>.asSlice(&self.writeHolders)
    let mut at = usize.ZERO
    while at < old.length {
      if old[at].execution.index == execution.index && sameStorage(old[at].storage, whole) { return at }
      at = at + usize.ONE
    }
    let id = old.length
    let active = Program.atom(&mut self.rules)
    let actual = Skeleton.evaluation(&self.*, execution)
    if actual.role != EvaluationRole.Execute { return CompilerBug.panic(b"retained holder has no actual execution observation") }
    let mut components = List<WriteComponent>.make()
    at = usize.ZERO
    while at < endpoints.length {
      let endpoint = EndpointId {index: at}
      if inlineWithin(prepared, endpoint, root) {
        let canonical = Storage {endpoint: endpoint, temporary: storage.temporary}
        let value = run Skeleton.value(&mut self.*, execution, endpoint)
        let read = run Skeleton.read(&mut self.*, actual.point, canonical, value, Option<MapId>.none())
        // The call may store, and every applicable source contributes to ONE holder update.
        // No policy history can kill another source or create a second replacement.
        let definition = run Skeleton.define(&mut self.*, actual.point, execution, canonical, value, active, Write.Weak)
        run List<WriteComponent>.append(&mut components, WriteComponent {
          storage: canonical, value: value, read: read, definition: definition})
      }
      at = at + usize.ONE
    }
    run List<WriteHolder>.append(&mut self.writeHolders, WriteHolder {
      execution: execution, storage: whole, active: active, components: move components})
    return id
  }

  effect fn closeRetainedWrites<'body>(self: &mut Self, prepared: &SourcePreparation<'body>) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let before = List<RetainedWrite>.length(&self.writes)
    let beforeHolders = List<WriteHolder>.length(&self.writeHolders)
    let beforeTransfers = List<Transfer>.length(&self.transfers)
    let addresses = List<RetainedAddress>.length(&self.retainedAddresses)
    let mut address = usize.ZERO
    while address < addresses {
      let selected = List<RetainedAddress>.asSlice(&self.retainedAddresses)[address]
      let operation = &List<Stores.Operation>.asSlice(&self.stores.operations)[selected.operation]
      let result = operation.evaluation
      let point = operation.execute
      let inputCount = List<Stores.Input>.length(&operation.inputs)
      let execution = run Skeleton.execution(&mut self.*, result, point)
      let holder = run Skeleton.writeHolder(&mut self.*, prepared, execution, selected.storage)
      let components = List<WriteComponent>.asSlice(&List<WriteHolder>.asSlice(&self.writeHolders)[holder].components)
      let mut target = Option<ValueId>.none()
      let mut each = usize.ZERO
      while each < components.length {
        if sameStorage(components[each].storage, selected.storage) { target = Option<ValueId>.some(components[each].value) }
        each = each + usize.ONE
      }
      let target = match target { Option<ValueId>.Some {value} => value
        _ => { return CompilerBug.panic(b"retained destination escaped its actual canonical holder") } }
      let mut input = usize.ZERO
      while input < inputCount {
        let recorded = &List<Stores.Input>.asSlice(&List<Stores.Operation>.asSlice(&self.stores.operations)[selected.operation].inputs)[input]
        let operand = recorded.actual.evaluation
        let slotCount = List<Stores.Slot>.length(&recorded.slots)
        let route = recorded.route
        let retention = List<Stores.Operation>.asSlice(&self.stores.operations)[selected.operation].retention
        let retained = &List<Prepared.Retention>.asSlice(&prepared.retentions)[retention.index]
        let original = List<Prepared.Operation>.asSlice(&prepared.operations)
        let mut origin = usize.MAX
        let mut row = usize.ZERO
        while row < original.length {
          if original[row].site.index == retained.site.index { origin = row }
          row = row + usize.ONE
        }
        if origin == usize.MAX { return CompilerBug.panic(b"retained write lost its original input operation") }
        let root = maps[List<InputRoute>.asSlice(&original[origin].inputs)[route].map.index].source
        let valueCount = List<Value>.length(&self.values)
        let mut value = usize.ZERO
        while value < valueCount {
          let source = List<Value>.asSlice(&self.values)[value]
          if source.evaluation.index == operand.index && source.phase == ValuePhase.Output
            && match source.subject { Option<ResidualSubject>.None => true _ => false }
            && match source.transport { Option<AliasPort>.None => true _ => false }
            && inlineWithin(prepared, source.endpoint, root) {
            let mut slot = usize.ZERO
            while slot < slotCount {
              let old = List<RetainedWrite>.asSlice(&self.writes)
              let mut found = false
              each = usize.ZERO
              while each < old.length {
                if old[each].address == address && old[each].source.index == value
                  && old[each].sourceInput == input && old[each].sourceSlot == slot { found = true }
                each = each + usize.ONE
              }
              if !found {
                let id = old.length
                let active = run addressApplies(&mut self.rules, selected.active, Flow.reachable(&self.flow, point))
                let source = ValueId {index: value}
                run List<RetainedWrite>.append(&mut self.writes, RetainedWrite {
                  operation: selected.operation, sourceInput: input, sourceSlot: slot,
                  address: address, source: source, target: target, holder: holder, active: active})
                let absent = Program.atom(&mut self.rules)
                run List<Transfer>.append(&mut self.transfers, Transfer {source: source, target: target,
                  active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
                  definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
                  policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.RetainedWrite {candidate: id}})
              }
              slot = slot + usize.ONE
            }
          }
          value = value + usize.ONE
        }
        input = input + usize.ONE
      }
      address = address + usize.ONE
    }
    return before != List<RetainedWrite>.length(&self.writes)
      || beforeHolders != List<WriteHolder>.length(&self.writeHolders)
      || beforeTransfers != List<Transfer>.length(&self.transfers)
  }

  /// Only the owning visitor may create entry storage, for actual parameters/capture aliases.
  /// Locals with a binding node obtain their definitions at that binding, never here.
  pub effect fn entry(self: &mut Self, local: LocalId, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let id = EvalId {index: List<Evaluation>.length(&self.evaluations)}
    run List<Evaluation>.append(&mut self.evaluations,
      Evaluation {site: EvaluationSite.Entry {local: local}, role: EvaluationRole.Entry, point: point})
    return id
  }

  pub effect fn value(self: &mut Self, evaluation: EvalId, endpoint: EndpointId) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    return run Skeleton.componentValue(&mut self.*, evaluation, endpoint, Option<ResidualSubject>.none(), ValuePhase.Output)
  }

  effect fn componentValue(self: &mut Self, evaluation: EvalId, endpoint: EndpointId,
    subject: Option<ResidualSubject>, phase: ValuePhase) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.values)
    let mut at = usize.ZERO
    while at < values.length {
      if values[at].evaluation.index == evaluation.index && values[at].endpoint.index == endpoint.index
        && values[at].phase == phase && sameSubject(values[at].subject, subject) {
        if let Option<AliasPort>.None = values[at].transport { return ValueId {index: at} }
      }
      at = at + usize.ONE
    }
    let id = ValueId {index: values.length}
    run List<Value>.append(&mut self.values, Value {phase: phase, evaluation: evaluation, endpoint: endpoint, subject: subject, transport: Option<AliasPort>.none()})
    return id
  }

  /// Product identity is bounded by reserved evaluations, physical anchors and frozen
  /// residual states. The base retains the actual descriptor occurrence being interpreted.
  effect fn selectedValue<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, base: ValueId,
    state: Prepared.ResidualStateId, read: EvalId) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.values)
    if base.index >= values.length || state.index >= List<Prepared.ResidualState>.length(&prepared.residuals) {
      return CompilerBug.panic(b"source product has an absent base occurrence or frozen suffix")
    }
    drop Skeleton.evaluation(&self.*, read)
    let mut physical = base
    if let Option<ResidualSubject>.Some {value: parent} = values[base.index].subject {
      physical = parent.base
      if physical.index >= values.length { return CompilerBug.panic(b"residual subject lost its physical anchor") }
      if let Option<ResidualSubject>.Some {..} = values[physical.index].subject {
        return CompilerBug.panic(b"residual products cannot recursively grow physical anchors")
      }
    }
    let value = values[physical.index]
    return run Skeleton.componentValue(&mut self.*, read, value.endpoint,
      Option<ResidualSubject>.some(ResidualSubject {base: physical, state: state, position: Option<Results.Position>.none()}), ValuePhase.Output)
  }

  pub effect fn leaf(self: &mut Self, leaf: Leaf) -> LeafId
  ! OutOfMemoryError ? &mut Allocator {
    let id = LeafId {index: List<Leaf>.length(&self.leaves)}
    run List<Leaf>.append(&mut self.leaves, move leaf)
    return id
  }

  effect fn internStorage(self: &mut Self, storage: Storage) -> ComponentId ! OutOfMemoryError ? &mut Allocator {
    let existing = List<Storage>.asSlice(&self.storage)
    let mut at = usize.ZERO
    while at < existing.length {
      if sameStorage(existing[at], storage) { return ComponentId {index: at} }
      at = at + usize.ONE
    }
    let component = ComponentId {index: existing.length}
    run List<Storage>.append(&mut self.storage, storage)
    return component
  }

  /// The prepared storage endpoint is the component identity. The value must already occupy
  /// that exact endpoint; a distinct RHS->storage map records physical placement separately.
  pub effect fn define(self: &mut Self, point: PointId, writer: EvalId, storage: Storage, value: ValueId,
    active: Atom, write: Write) -> DefinitionId ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.values)
    if value.index >= values.length || values[value.index].endpoint.index != storage.endpoint.index {
      CompilerBug.panic(b"source definition does not name its stored component")
    }
    if let Option<ResidualSubject>.Some {..} = values[value.index].subject {
      CompilerBug.panic(b"a selected residual is not a whole canonical storage definition")
    }
    if values[value.index].phase != ValuePhase.Output { CompilerBug.panic(b"a stored definition cannot be an unfinished read input") }
    let operation = Skeleton.evaluation(&self.*, writer)
    if operation.point.index != point.index { CompilerBug.panic(b"source definition writer is not at its actual write point") }
    let mut written = Option<EvalId>.none()
    if let EvaluationSite.Node {..} = operation.site { written = Option<EvalId>.some(writer) }
    let component = run Skeleton.internStorage(&mut self.*, storage)
    let definition = run Flow.define(&mut self.flow, point, component, active, write)
    run List<DefinedValue>.append(&mut self.definitions, DefinedValue {definition: definition, value: value, writer: written})
    return definition
  }

  pub effect fn read(self: &mut Self, point: PointId, storage: Storage, value: ValueId, map: Option<MapId>) -> ReadId
  ! OutOfMemoryError ? &mut Allocator {
    let output = List<Value>.asSlice(&self.values)[value.index]
    if output.phase != ValuePhase.Output { CompilerBug.panic(b"canonical reads require their published component") }
    let incoming = run Skeleton.componentValue(&mut self.*, output.evaluation, output.endpoint, output.subject, ValuePhase.Input)
    let mut published = false
    let transfers = List<Transfer>.asSlice(&self.transfers)
    let mut publication = usize.ZERO
    while publication < transfers.length {
      if transfers[publication].source.index == incoming.index && transfers[publication].target.index == value.index {
        published = true
      }
      publication = publication + usize.ONE
    }
    if !published {
      let active = Flow.reachable(&self.flow, point)
      let absent = Program.atom(&mut self.rules)
      run List<Transfer>.append(&mut self.transfers, Transfer {source: incoming, target: value,
        active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
    }
    let value = incoming
    let recorded = List<ReadValue>.asSlice(&self.reads)
    let mut at = usize.ZERO
    while at < recorded.length {
      if sameStorage(recorded[at].storage, storage) && recorded[at].value.index == value.index {
        let same = match recorded[at].map {
          Option<MapId>.Some {value: selected} => match map { Option<MapId>.Some {value: other} => selected.index == other.index _ => false }
          Option<MapId>.None => match map { Option<MapId>.None => true _ => false }
        }
        if same { return recorded[at].read }
      }
      at = at + usize.ONE
    }
    let component = run Skeleton.internStorage(&mut self.*, storage)
    let read = run Flow.read(&mut self.flow, point, component)
    run List<ReadValue>.append(&mut self.reads, ReadValue {read: read, storage: storage, value: value, map: move map})
    return read
  }

  effect fn aliasNode(self: &mut Self, evaluation: EvalId, endpoint: EndpointId,
    storage: Storage, write: Write) -> usize ! OutOfMemoryError ? &mut Allocator {
    let aliases = List<StorageAlias>.asSlice(&self.aliases)
    let mut at = usize.ZERO
    while at < aliases.length {
      if aliases[at].evaluation.index == evaluation.index && aliases[at].endpoint.index == endpoint.index
        && sameStorage(aliases[at].storage, storage) && aliases[at].write == write { return at }
      at = at + usize.ONE
    }
    let id = aliases.length
    let active = Program.atom(&mut self.rules)
    run List<StorageAlias>.append(&mut self.aliases, StorageAlias {evaluation: evaluation,
      endpoint: endpoint, storage: storage, active: active, write: write})
    return id
  }

  effect fn aliasEdge(self: &mut Self, source: Option<usize>, target: usize,
    authority: AliasAuthority, applicable: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let edges = List<AliasEdge>.asSlice(&self.aliasEdges)
    let mut at = usize.ZERO
    let mut found = usize.MAX
    while at < edges.length {
      let sameSource = match source {
        Option<usize>.Some {value} => match edges[at].source { Option<usize>.Some {value: other} => value == other _ => false }
        _ => match edges[at].source { Option<usize>.None => true _ => false }
      }
      if sameSource && sameAliasAuthority(authority, edges[at].authority) && edges[at].target == target { found = at }
      at = at + usize.ONE
    }
    let mut edge = applicable
    let empty = List<Atom>.make()
    let none = List<Atom>.asSlice(&empty)
    if found == usize.MAX {
      edge = Program.atom(&mut self.rules)
      run List<AliasEdge>.append(&mut self.aliasEdges, AliasEdge {source: source, target: target, authority: authority, active: edge})
      let output = List<StorageAlias>.asSlice(&self.aliases)[target].active
      match source {
        Option<usize>.Some {value} => {
          let predecessor = List<StorageAlias>.asSlice(&self.aliases)[value].active
          let requires: [Atom; 2] = [predecessor, edge]
          run Program.rule(&mut self.rules, output, &requires, none)
        }
        Option<usize>.None => {
          let requires: [Atom; 1] = [edge]
          run Program.rule(&mut self.rules, output, &requires, none)
        }
      }
    } else {
      edge = List<AliasEdge>.asSlice(&self.aliasEdges)[found].active
    }
    let requires: [Atom; 1] = [applicable]
    run Program.rule(&mut self.rules, edge, &requires, none)
    return ()
  }

  effect fn aliasPort(self: &mut Self, request: usize, alias: usize) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let transport = List<AliasTransport>.asSlice(&self.aliasTransports)[request]
    let node = &List<StorageAlias>.asSlice(&self.aliases)[alias]
    let endpoint = node.endpoint
    if !sameStorage(node.storage, List<StorageAlias>.asSlice(&self.aliases)[transport.alias].storage) {
      return CompilerBug.panic(b"one address composition crossed canonical owners")
    }
    let values = List<Value>.asSlice(&self.values)
    let mut at = usize.ZERO
    while at < values.length {
      if let Option<AliasPort>.Some {value} = values[at].transport {
        if value.request == request && value.alias == alias { return ValueId {index: at} }
      }
      at = at + usize.ONE
    }
    let id = ValueId {index: values.length}
    run List<Value>.append(&mut self.values, Value {evaluation: transport.evaluation, endpoint: endpoint,
      phase: ValuePhase.Transport, subject: Option<ResidualSubject>.none(),
      transport: Option<AliasPort>.some(AliasPort {request: request, alias: alias})})
    return id
  }

  /// Extend each actual read/write through new proof edges, with private per-use ports.
  /// Finite graph sharing replaces path copying; cycles alone cannot seed source presence.
  effect fn activateAliasTransports(self: &mut Self, maps: &[SelectionMap]) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let count = List<AliasEdge>.length(&self.aliasEdges)
    let length = List<AliasTransport>.length(&self.aliasTransports)
    let absent = Program.atom(&mut self.rules)
    let mut changed = false
    let mut request = usize.ZERO
    while request < length {
      let use = List<AliasTransport>.asSlice(&self.aliasTransports)[request]
      let storage = List<StorageAlias>.asSlice(&self.aliases)[use.alias].storage
      if use.closed > count { CompilerBug.panic(b"address proof edge reservation shrank") }
      let mut at = use.closed
      while at < count {
        let edge = List<AliasEdge>.asSlice(&self.aliasEdges)[at]
        let node = &List<StorageAlias>.asSlice(&self.aliases)[edge.target]
        let same = sameStorage(node.storage, storage)
        let address = node.evaluation
        if same {
          let target = run Skeleton.aliasPort(&mut self.*, request, edge.target)
          let mut source = target
          match edge.source {
            Option<usize>.Some {value} => { source = run Skeleton.aliasPort(&mut self.*, request, value) }
            Option<usize>.None => {
              source = run Skeleton.value(&mut self.*, use.evaluation, storage.endpoint)
              if use.direction == MapDirection.Forward {
                let actual = Skeleton.evaluation(&self.*, use.evaluation)
                let read = run Skeleton.read(&mut self.*, actual.point, storage, source, Option<MapId>.none())
                let recorded = List<AliasRead>.asSlice(&self.aliasReads)
                let mut found = false
                let mut earlier = usize.ZERO
                while earlier < recorded.length {
                  if recorded[earlier].request == request && recorded[earlier].read.index == read.index { found = true }
                  earlier = earlier + usize.ONE
                }
                if !found { run List<AliasRead>.append(&mut self.aliasReads, AliasRead {request: request, read: read}) }
                if let AliasConsumer.Retained {request: retained, path, prefix, edge} = use.authority {
                  let consumer = match use.consumer { Option<ValueId>.Some {value} => value
                    _ => { return CompilerBug.panic(b"retained current read lost its actual consumer") } }
                  let retainedReads = List<RetainedRead>.asSlice(&self.retainedReads)
                  let mut listed = false
                  let mut prior = usize.ZERO
                  while prior < retainedReads.length {
                    let previous = retainedReads[prior]
                    if previous.request == retained && previous.path == path && previous.prefix == prefix
                      && previous.edge == edge && previous.read.index == read.index && previous.consumer.index == consumer.index { listed = true }
                    prior = prior + usize.ONE
                  }
                  if !listed {
                    run List<RetainedRead>.append(&mut self.retainedReads, RetainedRead {request: retained,
                      path: path, prefix: prefix, consumer: consumer, read: read, alias: use.alias, edge: edge, active: use.active})
                  }
                }
              }
            }
          }
          let mut authority = TransferAuthority.SameComponent
          if let Option<MapId>.Some {value: map} = aliasMap(edge.authority) {
            if map.index >= maps.length { CompilerBug.panic(b"address proof lost its exact prepared map") }
            authority = TransferAuthority.Physical {map: map, direction: use.direction, address: Option<EvalId>.some(address)}
          }
          match edge.authority {
            AliasAuthority.Selected {..} => { authority = TransferAuthority.Address {edge: at, direction: use.direction} }
            AliasAuthority.Origin {..} => { authority = TransferAuthority.Address {edge: at, direction: use.direction} }
            AliasAuthority.Slice {..} => { authority = TransferAuthority.Address {edge: at, direction: use.direction} }
            _ => ()
          }
          let active = run addressApplies(&mut self.rules, use.active, edge.active)
          let mut from = source
          let mut to = target
          if use.direction == MapDirection.StorageInverse { from = target to = source }
          run List<Transfer>.append(&mut self.transfers, Transfer {source: from, target: to, active: active,
            directness: Directness.Preserve, stored: absent, alternatives: absent,
            definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
            policy: TransferPolicy.Physical, terminal: false, authority: authority})
        }
        at = at + usize.ONE
      }
      if use.closed != count { changed = true }
      List<AliasTransport>.asMutSlice(&mut self.aliasTransports)[request].closed = count
      request = request + usize.ONE
    }
    return changed
  }

  effect fn aliasDefinition(self: &mut Self, operation: usize, storage: Storage, target: EvalId,
    active: Atom, write: Write, unavailable: Option<Origin>) -> () ! OutOfMemoryError ? &mut Allocator {
    let existing = List<AliasDefinition>.asSlice(&self.aliasDefinitions)
    let mut index = usize.ZERO
    let mut found = usize.MAX
    while index < existing.length {
      if existing[index].operation == operation && sameStorage(existing[index].storage, storage) { found = index }
      index = index + usize.ONE
    }
    let mut joined = active
    if found == usize.MAX {
      joined = Program.atom(&mut self.rules)
      let actual = Skeleton.evaluation(&self.*, target)
      let mut definition = DefinitionId {index: usize.MAX}
      match unavailable {
        Option<Origin>.Some {value: origin} => {
          definition = run Skeleton.uninitialize(&mut self.*, storage, target, origin, joined, write)
        }
        Option<Origin>.None => {
          let value = run Skeleton.value(&mut self.*, target, storage.endpoint)
          definition = run Skeleton.define(&mut self.*, actual.point, target, storage, value, joined, write)
        }
      }
      run List<AliasDefinition>.append(&mut self.aliasDefinitions, AliasDefinition {
        operation: operation, storage: storage, active: joined, definition: definition})
    } else {
      let previous = &List<AliasDefinition>.asSlice(&self.aliasDefinitions)[found]
      joined = previous.active
      if write == Write.Weak { Flow.weaken(&mut self.flow, previous.definition) }
    }
    let input: [Atom; 1] = [active]
    let none = List<Atom>.make()
    run Program.rule(&mut self.rules, joined, &input, List<Atom>.asSlice(&none))
    return ()
  }

  effect fn activateSelections<'body>(self: &mut Self, prepared: &SourcePreparation<'body>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let length = List<SelectionUse>.length(&self.selections)
    let mut index = usize.ZERO
    while index < length {
      let request = &List<SelectionUse>.asSlice(&self.selections)[index]
      run validateSelectionUse(prepared, request, List<Evaluation>.asSlice(&self.evaluations))
      let operand = request.operand
      let result = request.result
      let active = request.active
      let strength = request.strength
      let value = request.value
      let place = request.place
      // These families are also the exact output side of a later boundary composition.
      // Ordinary inline storage already has matching aliases; a reference/slice boundary
      // supplies them only through its occurrence-sensitive product, never by this map alone.
      if let Option<MapId>.Some {value: map} = place {
        run Skeleton.projectAliases(&mut self.*, endpoints, maps, map, operand, result, strength)
      }
      if let Option<MapId>.Some {value: map} = value {
        run Skeleton.readAliases(&mut self.*, endpoints, maps, map, operand, result, active)
      }
      index = index + usize.ONE
    }
    return ()
  }

  /// Extends operations only for newly discovered actual aliases. Destination definitions and
  /// their gates keep stable identities across rounds; no solved fact or policy is sampled.
  effect fn activateAliasOperations(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap]) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let count = List<StorageAlias>.length(&self.aliases)
    let length = List<AliasOperation>.length(&self.aliasOperations)
    let mut changed = false
    let mut operation = usize.ZERO
    while operation < length {
      let request = List<AliasOperation>.asSlice(&self.aliasOperations)[operation]
      if request.closed > count { CompilerBug.panic(b"actual source alias inventory shrank") }
      if request.closed < count {
        match request.kind {
          AliasOperationKind.Project {map, source, target, write} => {
            run Skeleton.emitAliasProjection(&mut self.*, endpoints, maps, map, source, target, write, request.closed, count)
          }
          AliasOperationKind.Read {map, source, target, active} => {
            run Skeleton.emitAliasRead(&mut self.*, endpoints, maps, map, source, target, active, request.closed, count)
          }
          AliasOperationKind.Write {map, address, target, active, ..} => {
            run Skeleton.emitAliasWrite(&mut self.*, endpoints, maps, map, address, target, active, operation, request.closed, count)
          }
          AliasOperationKind.Invalidate {address, root, target, origin, active} => {
            let mut alias = request.closed
            while alias < count {
              let actual = &List<StorageAlias>.asSlice(&self.aliases)[alias]
              if actual.evaluation.index == address.index && componentWithin(endpoints, actual.endpoint, root) {
                let storage = actual.storage
                let write = actual.write
                let applicable = run addressApplies(&mut self.rules, active, actual.active)
                run Skeleton.aliasDefinition(&mut self.*, operation, storage, target, applicable, write, Option<Origin>.some(origin))
              }
              alias = alias + usize.ONE
            }
          }
        }
        List<AliasOperation>.asMutSlice(&mut self.aliasOperations)[operation].closed = count
        changed = true
      }
      operation = operation + usize.ONE
    }
    return changed
  }

  /// Observe an actual owner at its cleanup/use point. The cause node names the action,
  /// not the storage being read. Only canonical inline storage is observed; reference
  /// referents and Effect channels are not owned fields and cannot be read by this walk.
  pub effect fn observeStorage<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    storage: Storage, evaluation: EvalId) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
    if actual.role != EvaluationRole.Cleanup || storage.endpoint.index >= endpoints.length {
      return CompilerBug.panic(b"owner observation has no actual cleanup occurrence or storage")
    }
    let root = &endpoints[storage.endpoint.index]
    let whole = match root.parent { Option<EndpointId>.None => true _ => false }
    let identity = match &root.root {
      Root.Local {local, role} => local.index < prepared.body.locals.length && role == EndpointRole.Storage
        && match storage.temporary { Option<EvalId>.None => true _ => false }
      Root.Node {node, role} => role == EndpointRole.Storage && match storage.temporary {
        Option<EvalId>.Some {value} => match Skeleton.evaluation(&self.*, value).site {
          EvaluationSite.Node {node: owner} => owner.index == node.index
          _ => false
        }
        _ => false
      }
      _ => false
    }
    if !whole || !identity { return CompilerBug.panic(b"cleanup observation changed its canonical owner identity") }
    let mut pending = List<EndpointId>.make()
    run List<EndpointId>.append(&mut pending, storage.endpoint)
    let result = run Skeleton.value(&mut self.*, evaluation, storage.endpoint)
    let mut at = usize.ZERO
    while at < List<EndpointId>.length(&pending) {
      let endpoint = List<EndpointId>.asSlice(&pending)[at]
      let value = run Skeleton.value(&mut self.*, evaluation, endpoint)
      drop run Skeleton.read(&mut self.*, actual.point,
        Storage {endpoint: endpoint, temporary: storage.temporary}, value, Option<MapId>.none())
      let components = List<Prepared.Component>.asSlice(&shapes[endpoints[endpoint.index].shape.index].components)
      let mut component = usize.ZERO
      while component < components.length {
        if components[component].inline {
          let mut found = usize.MAX
          let mut child = usize.ZERO
          while child < endpoints.length {
            let parent = match endpoints[child].parent {
              Option<EndpointId>.Some {value} => value.index == endpoint.index
              _ => false
            }
            if parent && sameSelector(&endpoints[child].selector, &components[component].selector) {
              if found != usize.MAX { CompilerBug.panic(b"owned storage repeats a prepared inline component") }
              found = child
            }
            child = child + usize.ONE
          }
          if found == usize.MAX { CompilerBug.panic(b"owned storage omitted a prepared inline component") }
          run List<EndpointId>.append(&mut pending, EndpointId {index: found})
        }
        component = component + usize.ONE
      }
      at = at + usize.ONE
    }
    return result
  }

  /// Close only the newly reserved storage pairs into the SAME transfer graph. Boundary
  /// discovery can append an actual later read and call this again before Flow.emit; no
  /// source/policy truth is sampled and no earlier pair is duplicated or replaced.
  pub effect fn closeStorage(self: &mut Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    let pairs = run Flow.reservePairs(&mut self.flow, &mut self.rules)
    let count = pairs.length
    if self.closedPairs > count { CompilerBug.panic(b"source storage pair reservation shrank") }
    let changed = self.closedPairs != count
    run storageTransfers(pairs, self.closedPairs, List<DefinedValue>.asSlice(&self.definitions),
      List<ReadValue>.asSlice(&self.reads), &mut self.transfers, &mut self.rules)
    self.closedPairs = count
    return changed
  }

  /// Materialize an actually addressed rvalue. Frozen temporary maps alone never call this:
  /// the structural visitor or explicit producer reference must supply its actual evaluation.
  pub effect fn materialize(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, evaluation: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let node = match actual.site { EvaluationSite.Node {node} => node _ => return CompilerBug.panic(b"entry is not a temporary evaluation") }
    let family = run transferFamily(endpoints, maps, map)
    let absent = Program.atom(&mut self.rules)
    drop run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, evaluation,
      active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let members = List<MapId>.asSlice(&family)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      let from = match &endpoints[physical.source.index].root {
        Root.Node {node: source, role} => source.index == node.index && role == EndpointRole.Value _ => false
      }
      let into = match &endpoints[physical.target.index].root {
        Root.Node {node: target, role} => target.index == node.index && role == EndpointRole.Storage _ => false
      }
      if !from || !into || physical.kind != MapKind.Place { CompilerBug.panic(b"temporary materialization lacks its exact evaluated value placement") }
      let storage = Storage {endpoint: physical.target, temporary: Option<EvalId>.some(evaluation)}
      let existing = List<StorageAlias>.asSlice(&self.aliases)
      let mut at = usize.ZERO
      while at < existing.length {
        if existing[at].evaluation.index == evaluation.index && existing[at].endpoint.index == physical.target.index {
          CompilerBug.panic(b"one actual temporary occurrence was materialized twice")
        }
        at = at + usize.ONE
      }
      let value = run Skeleton.value(&mut self.*, evaluation, physical.target)
      drop run Skeleton.define(&mut self.*, actual.point, evaluation, storage, value, active, Write.Strong)
      let alias = run Skeleton.aliasNode(&mut self.*, evaluation, physical.target, storage, Write.Strong)
      run Skeleton.aliasEdge(&mut self.*, Option<usize>.none(), alias, AliasAuthority.Canonical, active)
      member = member + usize.ONE
    }
    return ()
  }

  /// A local whole/component read binds every explicitly prepared inline map to the same
  /// actual read evaluation. Entry and loan-free definitions therefore follow the same path
  /// as borrowed definitions, including later replacements reaching a loop backedge.
  pub effect fn readLocal(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    evaluation: EvalId, local: LocalId) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let sameSite = match actual.site {
      EvaluationSite.Node {node} => node.index == maps[map.index].site.index
      _ => false
    }
    if !sameSite { CompilerBug.panic(b"a local read map was attached to another occurrence") }
    let members = List<MapId>.asSlice(&family)
    let root = run Skeleton.value(&mut self.*, evaluation, maps[map.index].target)
    let mut at = usize.ZERO
    while at < members.length {
      let member = members[at]
      let physical = &maps[member.index]
      let storage = match &endpoints[physical.source.index].root {
        Root.Local {local: found, role} => found.index == local.index && role == EndpointRole.Storage
        _ => false
      }
      if !storage || physical.kind != MapKind.Copy {
        CompilerBug.panic(b"a local read must name canonical local storage and a prepared Copy map")
      }
      let value = run Skeleton.value(&mut self.*, evaluation, physical.target)
      drop run Skeleton.read(&mut self.*, actual.point, Storage {endpoint: physical.source, temporary: Option<EvalId>.none()}, value, Option<MapId>.some(member))
      at = at + usize.ONE
    }
    return root
  }

  /// Local place formation binds the explicit Storage->Storage family to this occurrence.
  /// No value is copied and no declaration/read pairing is guessed until an actual read occurs.
  pub effect fn localAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    evaluation: EvalId, local: LocalId) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"local place map has a different actual occurrence") }
    let mut at = usize.ZERO
    while at < members.length {
      let physical = &maps[members[at].index]
      let canonical = match &endpoints[physical.source.index].root {
        Root.Local {local: owner, role} => owner.index == local.index && role == EndpointRole.Storage
        _ => false
      }
      let storage = match move endpointRole(&endpoints[physical.target.index]) {
        Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
      }
      if !canonical || !storage || physical.kind != MapKind.Select {
        CompilerBug.panic(b"local address map does not identify canonical storage")
      }
      let alias = run Skeleton.aliasNode(&mut self.*, evaluation, physical.target,
        Storage {endpoint: physical.source, temporary: Option<EvalId>.none()}, Write.Strong)
      run Skeleton.aliasEdge(&mut self.*, Option<usize>.none(), alias, AliasAuthority.Project {map: members[at]},
        Flow.reachable(&self.flow, actual.point))
      at = at + usize.ONE
    }
    return ()
  }

  /// An inline place projection composes exact address evidence. It does not read the old
  /// stored value or turn an unknown reference selector into an owned-storage alias.
  pub effect fn projectAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, write: Write) -> () ! OutOfMemoryError ? &mut Allocator {
    drop run transferFamily(endpoints, maps, map)
    // Address formation composes an already evaluated operand with its later projection.
    // Runtime loop cycles are source-flow edges, not recursively expanding address paths.
    if source.index >= target.index { CompilerBug.panic(b"source address projection does not follow operand evaluation") }
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Project {map: map, source: source, target: target, write: write}, closed: usize.ZERO})
    return ()
  }

  effect fn emitAliasProjection(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, write: Write, first: usize, limit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let actual = Skeleton.evaluation(&self.*, target)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"projected address map has a different actual occurrence") }
    let members = List<MapId>.asSlice(&family)
    let previous = limit
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Select { CompilerBug.panic(b"projected storage identity requires a Select map") }
      let mut at = first
      while at < previous {
        let alias = &List<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == source.index && alias.endpoint.index == physical.source.index {
          let storage = alias.storage
          let mut strength = write
          if alias.write == Write.Weak { strength = Write.Weak }
          let mut authority = AliasAuthority.Project {map: members[member]}
          let sourceStorage = match endpointRole(&endpoints[physical.source.index]) {
            Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
          }
          if !sourceStorage {
            let selection = run selectedAliasMap(&self.*, endpoints, maps, members[member], source, target)
            authority = AliasAuthority.Selected {selection: selection, map: members[member]}
          }
          let next = run Skeleton.aliasNode(&mut self.*, target, physical.target, storage, strength)
          run Skeleton.aliasEdge(&mut self.*, Option<usize>.some(at), next, authority,
            Flow.reachable(&self.flow, actual.point))
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// Read canonical storage at THIS operation's point, then compose its already-authenticated
  /// address maps. Reusing an earlier base's value would miss intervening writes/backedges.
  /// Intermediate ports share the actual read evaluation; map.site still names the real earlier
  /// address formation, so the proof exposes both facts without inventing another evaluation.
  pub effect fn readAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    drop run transferFamily(endpoints, maps, map)
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Read {map: map, source: source, target: target, active: active}, closed: usize.ZERO})
    return ()
  }

  effect fn emitAliasRead(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom, first: usize, limit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let actual = Skeleton.evaluation(&self.*, target)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"projected read map has a different actual occurrence") }
    let absent = Program.atom(&mut self.rules)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Copy { CompilerBug.panic(b"projected value read requires a prepared Copy map") }
      let count = limit
      let mut at = first
      while at < count {
        let alias = &List<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == source.index && alias.endpoint.index == physical.source.index {
          let applicable = run addressApplies(&mut self.rules, active, alias.active)
          let request = List<AliasTransport>.length(&self.aliasTransports)
          let onward = run Skeleton.value(&mut self.*, target, physical.target)
          run List<AliasTransport>.append(&mut self.aliasTransports, AliasTransport {consumer: Option<ValueId>.some(onward),
            alias: at, authority: AliasConsumer.Projection {map: members[member]}, evaluation: target, active: applicable,
            direction: MapDirection.Forward, closed: usize.ZERO})
          let incoming = run Skeleton.aliasPort(&mut self.*, request, at)
          run List<Transfer>.append(&mut self.transfers, Transfer {source: incoming, target: onward,
            active: applicable, directness: Directness.Preserve, stored: absent, alternatives: absent,
            definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical,
            terminal: false, authority: TransferAuthority.Physical {map: members[member], direction: MapDirection.Forward,
              address: Option<EvalId>.none()}})
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// A whole local binding/replacement installs all components even when its value has no
  /// Borrow leaf. Strong kills are definitions of actual values, not side effects of finding
  /// an existing held loan. Field/conditional stores use their separately authenticated target.
  pub effect fn writeLocal(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, local: LocalId, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, target)
    let absent = Program.atom(&mut self.rules)
    let root = run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, target, active,
      Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let mut at = usize.ZERO
    while at < members.length {
      let physical = &maps[members[at].index]
      let storage = match &endpoints[physical.target.index].root {
        Root.Local {local: found, role} => found.index == local.index && role == EndpointRole.Storage
        _ => false
      }
      if !storage || physical.kind != MapKind.Place {
        CompilerBug.panic(b"a local replacement must name canonical local storage and a prepared Place map")
      }
      let stored = run Skeleton.value(&mut self.*, target, physical.target)
      drop run Skeleton.define(&mut self.*, actual.point, target, Storage {endpoint: physical.target, temporary: Option<EvalId>.none()}, stored, active, Write.Strong)
      at = at + usize.ONE
    }
    return root
  }

  /// Place through an actual owned address. The RHS follows its frozen placement map; the
  /// inverse address chain only chooses canonical storage. It is not a new value copy or a
  /// reference-content proof. Runtime-index alternatives remain weak writes to each candidate.
  pub effect fn writeAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, address: EvalId, target: EvalId, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let absent = Program.atom(&mut self.rules)
    drop run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, target, active,
      Directness.Preserve, absent, absent, TransferPolicy.Physical)
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Write {map: map, source: source, address: address, target: target, active: active}, closed: usize.ZERO})
    return ()
  }

  effect fn emitAliasWrite(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    address: EvalId, target: EvalId, active: Atom, operation: usize, first: usize, limit: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let absent = Program.atom(&mut self.rules)
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Place { CompilerBug.panic(b"projected replacement has no prepared Place map") }
      let count = limit
      let mut at = first
      while at < count {
        let alias = &List<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == address.index && alias.endpoint.index == physical.target.index {
          let storage = alias.storage
          let applicable = run addressApplies(&mut self.rules, active, alias.active)
          let mut write = alias.write
          // Alternative address routes to one canonical component are histories of the same
          // write, not extra definitions. A non-singleton address cannot acquire a strong kill
          // merely because a second route to that component was visited first.
          let aliases = List<StorageAlias>.asSlice(&self.aliases)
          let mut other = usize.ZERO
          while other < aliases.length {
            if aliases[other].evaluation.index == address.index && sameStorage(aliases[other].storage, storage)
              && aliases[other].write == Write.Weak { write = Write.Weak }
            other = other + usize.ONE
          }
          let request = List<AliasTransport>.length(&self.aliasTransports)
          run List<AliasTransport>.append(&mut self.aliasTransports, AliasTransport {consumer: Option<ValueId>.none(),
            alias: at, authority: AliasConsumer.Projection {map: members[member]}, evaluation: target, active: applicable,
            direction: MapDirection.StorageInverse, closed: usize.ZERO})
          let before = run Skeleton.value(&mut self.*, target, physical.target)
          let onward = run Skeleton.aliasPort(&mut self.*, request, at)
          run List<Transfer>.append(&mut self.transfers, Transfer {source: before, target: onward,
            active: applicable, directness: Directness.Preserve, stored: absent, alternatives: absent,
            definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical,
            terminal: false, authority: TransferAuthority.SameComponent})
          run Skeleton.aliasDefinition(&mut self.*, operation, storage, target, applicable, write, Option<Origin>.none())
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// The displaced value is read after the RHS completes, at a separate point before
  /// installation. Publication forwards that snapshot; it never rereads the replaced storage.
  pub effect fn replace<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, replacement: &Prepared.Replacement,
    address: EvalId, source: EvalId, read: EvalId, result: EvalId, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    validateReplacement(prepared, replacement)
    let readAt = Skeleton.evaluation(&self.*, read)
    let writtenAt = Skeleton.evaluation(&self.*, result)
    let sameRead = match readAt.site { EvaluationSite.Node {node} => node.index == replacement.site.index _ => false }
    let sameWrite = match writtenAt.site { EvaluationSite.Node {node} => node.index == replacement.site.index _ => false }
    if !sameRead || !sameWrite || readAt.role != EvaluationRole.Replacement || writtenAt.role != EvaluationRole.Value
      || readAt.point.index == writtenAt.point.index {
      CompilerBug.panic(b"replacement lost its distinct displaced-read and installation occurrences")
    }
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let actualAddress = Skeleton.evaluation(&self.*, address)
    let actualSource = Skeleton.evaluation(&self.*, source)
    let addressed = match &endpoints[maps[replacement.displaced.index].source.index].root {
      Root.Node {node, ..} => match actualAddress.site { EvaluationSite.Node {node: actual} => actual.index == node.index _ => false }
      _ => false
    }
    let supplied = match &endpoints[maps[replacement.installed.index].source.index].root {
      Root.Node {node, ..} => match actualSource.site { EvaluationSite.Node {node: actual} => actual.index == node.index _ => false }
      _ => false
    }
    if !addressed || !supplied { CompilerBug.panic(b"replacement substituted another argument evaluation") }
    run Skeleton.readAliases(&mut self.*, endpoints, maps, replacement.displaced, address, read, active)
    run Skeleton.writeAliases(&mut self.*, endpoints, maps, replacement.installed, source, address, result, active)
    let family = run transferFamily(endpoints, maps, replacement.displaced)
    let members = List<MapId>.asSlice(&family)
    let absent = Program.atom(&mut self.rules)
    let mut at = usize.ZERO
    while at < members.length {
      let endpoint = maps[members[at].index].target
      let before = run Skeleton.value(&mut self.*, read, endpoint)
      let after = run Skeleton.value(&mut self.*, result, endpoint)
      run List<Transfer>.append(&mut self.transfers, Transfer {source: before, target: after, active: active,
        directness: Directness.Preserve, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
      at = at + usize.ONE
    }
    return ()
  }

  fn evaluation(self: &Self, id: EvalId) -> Evaluation {
    let actual = List<Evaluation>.asSlice(&self.evaluations)
    if id.index >= actual.length { CompilerBug.panic(b"source transfer has no actual evaluation") }
    return actual[id.index]
  }

  /// Destruction is an actual definition of unavailable storage, not absence of a held
  /// loan. Copies read before this point keep their predecessor; a later read (including a
  /// backedge) observes Uninitialized. Ownership independently reports the exact move/drop.
  pub effect fn invalidateAliases(self: &mut Self, endpoints: &[Endpoint], address: EvalId,
    root: EndpointId, target: EvalId, origin: Origin, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if root.index >= endpoints.length { CompilerBug.panic(b"consumed source address has no prepared root") }
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Invalidate {address: address, root: root, target: target, origin: origin, active: active}, closed: usize.ZERO})
    return ()
  }

  // Unavailable is an explicit source definition. It is neither a synthetic RHS nor a
  // LoanFree value, and it cannot make a later mandatory source obligation disappear.
  effect fn uninitialize(self: &mut Self, storage: Storage, evaluation: EvalId, origin: Origin,
    active: Atom, write: Write) -> DefinitionId ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let node = match actual.site { EvaluationSite.Node {node} => node _ => { return CompilerBug.panic(b"entry is not a consuming operation") } }
    let absent = Program.atom(&mut self.rules)
    let value = run Skeleton.value(&mut self.*, evaluation, storage.endpoint)
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Unknown {
      node: Option<NodeId>.some(node), reason: UnknownReason.Uninitialized}, origin: origin, endpoint: storage.endpoint})
    run List<Seed>.append(&mut self.seeds, Seed {value: value, leaf: leaf,
      direct: false, active: active, stored: absent, alternatives: absent})
    return run Skeleton.define(&mut self.*, actual.point, evaluation, storage, value, active, write)
  }

  /// A real owner end kills its own reserved storage components. Reference descriptors which
  /// were copied earlier keep their earlier definition; their referent's end remains a distinct
  /// ownership fact. This does not recursively destroy storage reached through a reference.
  pub effect fn endOwner(self: &mut Self, endpoints: &[Endpoint], root: EndpointId,
    owner: Option<EvalId>, evaluation: EvalId, origin: Origin, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if root.index >= endpoints.length { CompilerBug.panic(b"source owner end has no prepared root") }
    let actual = Skeleton.evaluation(&self.*, evaluation)
    if actual.role != EvaluationRole.Cleanup { CompilerBug.panic(b"source owner end has no actual lifecycle occurrence") }
    let count = List<Storage>.length(&self.storage)
    let mut at = usize.ZERO
    while at < count {
      let storage = List<Storage>.asSlice(&self.storage)[at]
      let sameOwner = match owner {
        Option<EvalId>.Some {value} => match storage.temporary { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
        Option<EvalId>.None => match storage.temporary { Option<EvalId>.None => true _ => false }
      }
      if sameOwner && componentWithin(endpoints, storage.endpoint, root) {
        // Only components actually materialized as this owner's storage enter this table.
        // Refuse an accidental boundary descendant rather than end a foreign referent.
        let mut component = storage.endpoint
        let mut remaining = endpoints.length
        while component.index != root.index && remaining > usize.ZERO {
          match &endpoints[component.index].selector {
            Selector.Referent => CompilerBug.panic(b"owner end cannot destroy a referent through its descriptor")
            Selector.EffectSuccess => CompilerBug.panic(b"owner end cannot destroy an Effect result")
            Selector.EffectFailure => CompilerBug.panic(b"owner end cannot destroy an Effect failure")
            _ => ()
          }
          component = match endpoints[component.index].parent {
            Option<EndpointId>.Some {value} => value
            _ => { return CompilerBug.panic(b"source owner component lost its storage ancestry") }
          }
          remaining = remaining - usize.ONE
        }
        if remaining == usize.ZERO { CompilerBug.panic(b"source owner component ancestry is cyclic") }
        drop run Skeleton.uninitialize(&mut self.*, storage, evaluation, origin, active, Write.Strong)
      }
      at = at + usize.ONE
    }
    return ()
  }

  /// Install the actual Traversal-authenticated operation occurrences once. Preparation
  /// remains metadata; only executing NamedInvoke plans publish their declared result routes.
  /// Descriptor plans retain their actual receiver Eval/usePoint and separate construction
  /// application until their exact original-contract bridge is supplied.
  pub effect fn installResults<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, inventory: Results.Inventory)
  -> () ! OutOfMemoryError ? &mut Allocator {
    if self.operationResultsInstalled { CompilerBug.panic(b"actual operation result inventory was installed twice") }
    self.operationResultsInstalled = true
    let operations = List<Results.Operation>.asSlice(&inventory.operations)
    let rows = List<Prepared.Operation>.asSlice(&prepared.operations)
    let points = Flow.reservedPoints(&self.flow)
    let mut operation = usize.ZERO
    while operation < operations.length {
      let actual = &operations[operation]
      if actual.prepared >= rows.length || actual.execute.index >= points.length {
        CompilerBug.panic(b"operation result inventory lost its prepared row or actual execution")
      }
      let row = &rows[actual.prepared]
      let evaluation = Skeleton.evaluation(&self.*, actual.evaluation)
      let site = match evaluation.site { EvaluationSite.Node {node} => node.index == row.site.index _ => false }
      if !site || evaluation.role == EvaluationRole.Execute {
        CompilerBug.panic(b"operation result inventory changed its actual result occurrence")
      }
      let mut earlier = usize.ZERO
      while earlier < operation {
        if operations[earlier].evaluation.index == actual.evaluation.index {
          CompilerBug.panic(b"one operation occurrence has duplicate result plans")
        }
        earlier = earlier + usize.ONE
      }
      let inputs = List<Results.Input>.asSlice(&actual.inputs)
      let routes = List<InputRoute>.asSlice(&row.inputs)
      if inputs.length != routes.length { CompilerBug.panic(b"operation result inventory omitted an actual input route") }
      let mut input = usize.ZERO
      while input < inputs.length {
        let selected = inputs[input]
        if selected.route >= routes.length || selected.actual.usePoint.index >= points.length {
          CompilerBug.panic(b"operation input lost its route or actual use point")
        }
        let read = match selected.actual.read { Option<InputRead>.Some {value} => value
          _ => { return CompilerBug.panic(b"operation input lost its actual typed read") } }
        let operand = inputOperand(prepared, row.site, routes[selected.route].read)
        let at = Skeleton.evaluation(&self.*, selected.actual.evaluation)
        let same = match at.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
        if !same || selected.actual.node.index != operand.index || !sameInputRead(read, routes[selected.route].read) {
          CompilerBug.panic(b"operation input changed its actual operand occurrence")
        }
        earlier = usize.ZERO
        while earlier < input {
          if inputs[earlier].route == selected.route { CompilerBug.panic(b"operation input route was activated twice") }
          earlier = earlier + usize.ONE
        }
        input = input + usize.ONE
      }
      match &actual.plan {
        Results.Plan.NamedInvoke {application, result, outputs} => {
          let exact = match row.application { Option<ApplicationId>.Some {value} => value.index == application.index _ => false }
          let output = match row.result { Option<MapId>.Some {value} => value.index == result.index _ => false }
          if row.phase != Prepared.OperationPhase.Invoke || !exact || !output {
            CompilerBug.panic(b"named result plan changed its application or phase")
          }
          if let Option<Results.Receiver>.Some {..} = actual.receiver {
            CompilerBug.panic(b"named result plan substituted a runtime descriptor receiver")
          }
          let active = run addressApplies(&mut self.rules, Flow.reachable(&self.flow, actual.execute),
            Flow.reachable(&self.flow, evaluation.point))
          let outputs = List<Results.Output>.asSlice(&outputs)
          let mut output = usize.ZERO
          while output < outputs.length {
            let contributors = List<Results.Contributor>.asSlice(&outputs[output].contributors)
            let mut contributor = usize.ZERO
            while contributor < contributors.length {
              let original = &contributors[contributor]
              Results.validateContributor(prepared, actual.prepared, outputs[output].map,
                original.projection, original.continuation, original.selection)
              run List<OperationContributor>.append(&mut self.operationContributors,
                OperationContributor {operation: operation, output: output, contributor: contributor, active: active})
              let candidates = List<Results.Candidate>.asSlice(&original.candidates)
              let mut candidate = usize.ZERO
              while candidate < candidates.length {
                let selected = candidates[candidate]
                let continued = match original.continuation {
                  Option<Prepared.ContractContinuationId>.Some {value} => match selected.continuation {
                    Option<Prepared.ContractContinuationId>.Some {value: other} => value.index == other.index _ => false }
                  Option<Prepared.ContractContinuationId>.None => match selected.continuation {
                    Option<Prepared.ContractContinuationId>.None => true _ => false }
                }
                if selected.operation != actual.prepared || selected.result.index != actual.evaluation.index
                  || selected.output.index != outputs[output].map.index || selected.projection.index != original.projection.index
                  || selected.selection.index != original.selection.index || !continued {
                  CompilerBug.panic(b"operation result candidate left its original contributor")
                }
                let mut bound = false
                input = usize.ZERO
                while input < inputs.length {
                  let source = inputs[input]
                  if source.route == selected.input && source.position == selected.position
                    && source.actual.evaluation.index == selected.operand.index && source.actual.usePoint.index == selected.usePoint.index {
                    bound = true
                  }
                  input = input + usize.ONE
                }
                if !bound { CompilerBug.panic(b"operation result candidate lost its exact actual input position") }
                let applicable = run addressApplies(&mut self.rules, active, Flow.reachable(&self.flow, selected.usePoint))
                drop run Skeleton.operationResult(&mut self.*, prepared, selected, applicable)
                candidate = candidate + usize.ONE
              }
              contributor = contributor + usize.ONE
            }
            output = output + usize.ONE
          }
        }
        Results.Plan.PrepareEffect {..} => {
          // BC owns all physical Construction activation. No invocation/write/result edge.
          if row.phase != Prepared.OperationPhase.PrepareEffect { CompilerBug.panic(b"prepared Effect plan changed its phase") }
        }
        Results.Plan.CallableInvoke {..} => {
          if row.phase != Prepared.OperationPhase.Invoke { CompilerBug.panic(b"callable invocation plan changed its phase") }
        }
        Results.Plan.ExecuteEffect {..} => {
          if row.phase != Prepared.OperationPhase.ExecuteEffect { CompilerBug.panic(b"Effect execution plan changed its phase") }
        }
      }
      operation = operation + usize.ONE
    }
    self.operationResults = move inventory
    return ()
  }

  /// Publish one actual operation-result candidate. Input binding and original/application
  /// correspondence are retained as a compound authority, never a fabricated physical map.
  pub effect fn operationResult<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    candidate: Results.Candidate, active: Atom) -> List<ValueId> ! OutOfMemoryError ? &mut Allocator {
    Results.validateCandidate(prepared, candidate)
    let operation = &List<Prepared.Operation>.asSlice(&prepared.operations)[candidate.operation]
    let inputs = List<InputRoute>.asSlice(&operation.inputs)
    let operand = inputOperand(prepared, operation.site, inputs[candidate.input].read)
    let sourceAt = Skeleton.evaluation(&self.*, candidate.operand)
    let resultAt = Skeleton.evaluation(&self.*, candidate.result)
    let sourceMatches = match sourceAt.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
    let resultMatches = match resultAt.site { EvaluationSite.Node {node} => node.index == operation.site.index _ => false }
    if !sourceMatches || !resultMatches || candidate.usePoint.index >= Flow.reservedPoints(&self.flow).length {
      return CompilerBug.panic(b"result candidate changed its actual operation or operand occurrence")
    }
    let source = run Skeleton.value(&mut self.*, candidate.operand, candidate.source)
    let anchor = run Skeleton.value(&mut self.*, candidate.result, candidate.target)
    let placement = run Results.outputPlacement(prepared, candidate)
    let mut positions = List<Option<Results.Position>>.make()
    match &placement.suffix {
      Results.PlacementSuffix.Whole => run List<Option<Results.Position>>.append(&mut positions, Option<Results.Position>.none())
      Results.PlacementSuffix.Selected {targets, ..} => {
        let targets = List<Results.Position>.asSlice(&targets)
        let mut at = usize.ZERO
        while at < targets.length {
          run List<Option<Results.Position>>.append(&mut positions, Option<Results.Position>.some(targets[at]))
          at = at + usize.ONE
        }
      }
    }
    let mut outputs = List<ValueId>.make()
    let positions = List<Option<Results.Position>>.asSlice(&positions)
    let absent = Program.atom(&mut self.rules)
    let mut at = usize.ZERO
    while at < positions.length {
      let position = positions[at]
      let mut target = anchor
      if let Option<Results.Position>.Some {value} = position {
        let state = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[value.current.index].outputState
        target = run Skeleton.componentValue(&mut self.*, candidate.result, candidate.target,
          Option<ResidualSubject>.some(ResidualSubject {base: anchor, state: state, position: position}), ValuePhase.Output)
      }
      run List<Transfer>.append(&mut self.transfers, Transfer {source: source, target: target,
        active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Filtered, terminal: false,
        authority: TransferAuthority.OperationResult {candidate: candidate, position: position}})
      run List<ValueId>.append(&mut outputs, target)
      at = at + usize.ONE
    }
    return move outputs
  }

  /// Address composition can end after the canonical storage read. Collect that final
  /// selected component at the read's Input, rather than filtering individual histories or
  /// interpreting the canonical owner's endpoint as the selected result.
  effect fn readResultInput(self: &mut Self, value: ValueId, emitted: usize) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let output = List<Value>.asSlice(&self.values)[value.index]
    let incoming = run Skeleton.componentValue(&mut self.*, output.evaluation, output.endpoint,
      output.subject, ValuePhase.Input)
    let mut publication = false
    let mut index = usize.ZERO
    while index < List<Transfer>.length(&self.transfers) {
      let transfer = &mut List<Transfer>.asMutSlice(&mut self.transfers)[index]
      if transfer.target.index == value.index {
        if transfer.source.index == incoming.index {
          publication = true
        } else {
          if index < emitted { CompilerBug.panic(b"a read phase changed after its source rules were emitted") }
          transfer.target = incoming
        }
      }
      index = index + usize.ONE
    }
    if !publication {
      let active = Flow.reachable(&self.flow, Skeleton.evaluation(&self.*, output.evaluation).point)
      let absent = Program.atom(&mut self.rules)
      run List<Transfer>.append(&mut self.transfers, Transfer {source: incoming, target: value,
        active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
    }
    let mut request = usize.ZERO
    while request < List<AliasTransport>.length(&self.aliasTransports) {
      let transport = &mut List<AliasTransport>.asMutSlice(&mut self.aliasTransports)[request]
      if let Option<ValueId>.Some {value: consumer} = transport.consumer {
        if consumer.index == value.index { transport.consumer = Option<ValueId>.some(incoming) }
      }
      request = request + usize.ONE
    }
    return incoming
  }

  effect fn prepareReadResults<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, emitted: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let mut request = usize.ZERO
    while request < List<ResultUse>.length(&self.results) {
      let use = &List<ResultUse>.asSlice(&self.results)[request]
      if let ResultKind.Read {read} = use.kind {
        let result = use.evaluation
        let node = match Skeleton.evaluation(&self.*, read).site {
          EvaluationSite.Node {node} => node
          _ => { return CompilerBug.panic(b"a result read must name an actual expression") }
        }
        let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
        let count = List<Value>.length(&self.values)
        let mut index = usize.ZERO
        while index < count {
          let value = List<Value>.asSlice(&self.values)[index]
          let selected = match &endpoints[value.endpoint.index].root {
            Root.Node {node: owner, role} => owner.index == node.index && role == EndpointRole.Value
            _ => false
          }
          if value.evaluation.index == read.index && value.phase == ValuePhase.Output && selected {
            let incoming = run Skeleton.readResultInput(&mut self.*, ValueId {index: index}, emitted)
            // Replace publishes its earlier displaced read at a distinct result point.
            // Keep that snapshot, but policy sees the joined input at the actual read.
            if result.index != read.index {
              let mut transfer = usize.ZERO
              while transfer < List<Transfer>.length(&self.transfers) {
                let edge = &List<Transfer>.asSlice(&self.transfers)[transfer]
                let target = List<Value>.asSlice(&self.values)[edge.target.index]
                let identity = match edge.authority { TransferAuthority.SameComponent => true _ => false }
                if edge.source.index == index && target.evaluation.index == result.index
                  && target.endpoint.index == value.endpoint.index && identity {
                  if transfer < emitted { CompilerBug.panic(b"a displaced read changed after its source rules were emitted") }
                  List<Transfer>.asMutSlice(&mut self.transfers)[transfer].source = incoming
                }
                transfer = transfer + usize.ONE
              }
            }
          }
          index = index + usize.ONE
        }
      }
      request = request + usize.ONE
    }
    return ()
  }

  /// Select terminal policy edges only after structural transfer/address closure. Incoming
  /// histories first meet at one read Input; publication is a distinct Output component.
  effect fn activateResults<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, emitted: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let requests = List<ResultUse>.asSlice(&self.results)
    let values = List<Value>.asSlice(&self.values)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let mut request = usize.ZERO
    while request < requests.length {
      let use = &requests[request]
      let actual = Skeleton.evaluation(&self.*, use.evaluation)
      let node = match actual.site {
        EvaluationSite.Node {node} => node
        _ => { return CompilerBug.panic(b"entry storage cannot be a terminal expression result") }
      }
      let mut earlier = usize.ZERO
      while earlier < request {
        if requests[earlier].evaluation.index == use.evaluation.index {
          CompilerBug.panic(b"one actual result has multiple semantic finish handlers")
        }
        earlier = earlier + usize.ONE
      }
      let sources = List<EvalId>.asSlice(&use.sources)
      let mut index = emitted
      while index < List<Transfer>.length(&self.transfers) {
        let transfer = &List<Transfer>.asSlice(&self.transfers)[index]
        let source = values[transfer.source.index]
        let target = values[transfer.target.index]
        let physicalOutput = match &endpoints[target.endpoint.index].root {
          Root.Node {node: owner, role} => owner.index == node.index && role == EndpointRole.Value
          _ => false
        }
        let mut terminal = false
        if target.evaluation.index == use.evaluation.index && target.phase == ValuePhase.Output && physicalOutput {
          match use.kind {
            ResultKind.Declared => {
              terminal = match transfer.authority { TransferAuthority.OperationResult {..} => true _ => false }
            }
            ResultKind.Read {read} => {
              terminal = source.evaluation.index == read.index && source.phase == ValuePhase.Input
                && source.endpoint.index == target.endpoint.index && sameSubject(source.subject, target.subject)
                && match transfer.authority { TransferAuthority.SameComponent => true _ => false }
            }
            ResultKind.Physical => {
              let declared = match transfer.authority { TransferAuthority.OperationResult {..} => true _ => false }
              if !declared && source.phase == ValuePhase.Output {
                if let Option<ResidualSubject>.None = target.subject {
                  let mut input = usize.ZERO
                  while input < sources.length {
                    if sources[input].index == source.evaluation.index { terminal = true }
                    input = input + usize.ONE
                  }
                }
              }
            }
          }
        }
        if terminal {
          let active = run addressApplies(&mut self.rules, transfer.active, use.active)
          let transfer = &mut List<Transfer>.asMutSlice(&mut self.transfers)[index]
          if transfer.terminal { CompilerBug.panic(b"terminal result transfer was activated twice") }
          transfer.active = active
          transfer.policy = TransferPolicy.Filtered
          transfer.terminal = true
        }
        index = index + usize.ONE
      }
      request = request + usize.ONE
    }
    return ()
  }

  /// Instantiates exactly the producer's frozen map family at two actual evaluations. Child
  /// endpoints come from explicit child-map IDs, never a scan for equal types or same-site maps.
  /// This only reserves transfers: it creates no source, owner, storage alias or evaluation.
  pub effect fn transfer(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom, directness: Directness,
    stored: Atom, alternatives: Atom, policy: TransferPolicy) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    if source.index >= List<Evaluation>.length(&self.evaluations)
      || target.index >= List<Evaluation>.length(&self.evaluations) {
      CompilerBug.panic(b"a physical source transfer has no actual evaluation")
    }
    let occurrence = List<Evaluation>.asSlice(&self.evaluations)[target.index]
    let sameSite = match occurrence.site {
      EvaluationSite.Node {node} => node.index == maps[map.index].site.index
      _ => false
    }
    if !sameSite { CompilerBug.panic(b"physical transfer was attached to another evaluation occurrence") }
    let result = run Skeleton.value(&mut self.*, target, maps[map.index].target)
    let mut at = usize.ZERO
    while at < members.length {
      let member = members[at]
      let from = run Skeleton.value(&mut self.*, source, maps[member.index].source)
      let to = run Skeleton.value(&mut self.*, target, maps[member.index].target)
      run List<Transfer>.append(&mut self.transfers, Transfer {
        source: from, target: to, active: active, directness: directness,
        stored: stored, alternatives: alternatives,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: policy, terminal: false, authority: TransferAuthority.Physical {map: member, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
      at = at + usize.ONE
    }
    return result
  }

  /// Conversion preserves the actual descriptor source. Element maps belong exclusively
  /// to later reads; activating them here would freeze borrowed storage at conversion time.
  pub effect fn arraySlice<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, conversion: &Prepared.ArraySlice,
    source: EvalId, target: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    validateArraySlice(prepared, conversion)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let actual = Skeleton.evaluation(&self.*, source)
    let from = &endpoints[maps[conversion.descriptor.index].source.index]
    let matches = match &from.root {
      Root.Node {node, ..} => match actual.site { EvaluationSite.Node {node: selected} => node.index == selected.index _ => false }
      _ => false
    }
    if !matches { CompilerBug.panic(b"array slice substituted another descriptor occurrence") }
    let absent = Program.atom(&mut self.rules)
    let descriptor = run Skeleton.transfer(&mut self.*, endpoints, maps, conversion.descriptor, source, target,
      active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let rows = List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)
    let mut selected = usize.MAX
    let mut at = usize.ZERO
    while at < rows.length {
      if rows[at].descriptor.index == conversion.descriptor.index {
        if selected != usize.MAX { CompilerBug.panic(b"array slice descriptor has duplicate prepared conversions") }
        selected = at
      }
      at = at + usize.ONE
    }
    if selected == usize.MAX { CompilerBug.panic(b"array slice lost its frozen conversion identity") }
    run List<SliceConversion>.append(&mut self.slices, SliceConversion {prepared: selected, source: source, descriptor: descriptor})
    return ()
  }

  /// Binds one producer-selected capture/input route. Copy/Move/Evaluated transfer existing
  /// values; only explicit Borrow transport creates a new descriptor source. Its distinct
  /// referent family authenticates later address interpretation from the SAME source evaluation.
  /// The visitor owns the real borrow event/loan; its ID is required only for that transport.
  pub effect fn input(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], route: &InputRoute,
    source: EvalId, target: EvalId, acquisition: Option<ReferenceAcquisition>, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    if route.map.index >= maps.length { CompilerBug.panic(b"producer input has no physical map") }
    let created = route.transport == Transport.BorrowShared || route.transport == Transport.BorrowMutable
    let absent = Program.atom(&mut self.rules)
    if !created {
      if let Option<MapId>.Some {..} = &route.referent {
        CompilerBug.panic(b"a value transfer cannot create a second reference")
      }
      if let Option<ReferenceAcquisition>.Some {..} = acquisition {
        CompilerBug.panic(b"a value transfer cannot supply a new borrow loan")
      }
      return run Skeleton.transfer(&mut self.*, endpoints, maps, route.map, source, target, active,
        Directness.Preserve, absent, absent, TransferPolicy.Physical)
    }
    let referent = match route.referent {
      Option<MapId>.Some {value} => value
      _ => { return CompilerBug.panic(b"producer-created reference has no paired referent map") }
    }
    let acquired = match acquisition {
      Option<ReferenceAcquisition>.Some {value} => value
      _ => { return CompilerBug.panic(b"producer-created reference has no actual borrow event") }
    }
    return run Skeleton.reference(&mut self.*, endpoints, maps, route.map, referent, source, acquired.evaluation, target,
      acquired.loan, Option<NodeId>.none(), active)
  }

  /// Authored borrows own their exact pair independently of contract inputs. The actual loan
  /// is created by the ownership consumer at this occurrence, not inferred from a region atom.
  pub effect fn borrow<'body>(self: &mut Self, preparation: &SourcePreparation<'body>, borrowed: &Prepared.Borrow,
    source: EvalId, target: EvalId, loan: usize, active: Atom) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    validateAuthoredBorrow(preparation, borrowed)
    let operand = match &preparation.body.nodes[borrowed.site.index].kind {
      NodeKind.Expression {form: Expression.Borrow {value, ..}, ..} => value
      _ => { return CompilerBug.panic(b"authored borrow changed its typed node") }
    }
    let actual = Skeleton.evaluation(&self.*, source)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
    if !matches { CompilerBug.panic(b"authored borrow does not use its actual operand occurrence") }
    return run Skeleton.reference(&mut self.*, List<Endpoint>.asSlice(&preparation.endpoints),
      List<SelectionMap>.asSlice(&preparation.maps), borrowed.map, borrowed.referent,
      source, target, target, loan, Option<NodeId>.some(borrowed.site), active)
  }

  effect fn reference(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId, referent: MapId,
    source: EvalId, acquisition: EvalId, target: EvalId, actualLoan: usize, node: Option<NodeId>, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    validateReferenceMaps(endpoints, maps, map, referent)
    let absent = Program.atom(&mut self.rules)
    let acquired = Skeleton.evaluation(&self.*, acquisition)
    let result = Skeleton.evaluation(&self.*, target)
    let acquiredHere = match acquired.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    let returnedHere = match result.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !acquiredHere || !returnedHere { CompilerBug.panic(b"reference acquisition and result disagree with their physical producer") }
    if acquisition.index != target.index && acquired.role != EvaluationRole.Capture {
      CompilerBug.panic(b"implicit reference has no distinct acquisition occurrence")
    }
    let descriptor = run Skeleton.value(&mut self.*, acquisition, maps[map.index].target)
    let leaves = List<Leaf>.asSlice(&self.leaves)
    let mut at = usize.ZERO
    while at < leaves.length {
      if let SourceLeaf.Borrow {loan: previous, ..} = &leaves[at].kind {
        if previous == actualLoan { CompilerBug.panic(b"one borrow event was created by two producer routes") }
      }
      at = at + usize.ONE
    }
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Borrow {loan: actualLoan, node: move node},
      origin: maps[map.index].origin, endpoint: maps[map.index].target})
    run List<Seed>.append(&mut self.seeds, Seed {value: descriptor, leaf: leaf,
      direct: true, active: active, stored: absent, alternatives: absent})
    // Neither Storage -> descriptor nor Value -> Referent copies old contents. The former
    // creates the descriptor above; the latter authenticates the source component for the
    // later residual/address product. A later use must observe reaching storage at that use.
    run List<ReferenceOrigin>.append(&mut self.references, ReferenceOrigin {leaf: leaf,
      source: source, descriptor: descriptor, map: map, referent: referent})
    if acquisition.index == target.index { return descriptor }
    let result = run Skeleton.value(&mut self.*, target, maps[map.index].target)
    // Same physical descriptor, published only if the enclosing expression completes. The
    // acquisition seed remains reachable independently of this later successful result.
    run List<Transfer>.append(&mut self.transfers, Transfer {source: descriptor, target: result,
      active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
      policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
    return result
  }
}

// The consumer site is independent of the subject root: two empty-path pattern bindings
// may select precisely the same subject but still perform different actual reads.
effect fn validateSelectionUse<'body>(prepared: &SourcePreparation<'body>, request: &SelectionUse,
  evaluations: &[Evaluation]) -> () ! OutOfMemoryError ? &mut Allocator {
  let selections = List<Selection>.asSlice(&prepared.selections)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  if request.operand.index >= evaluations.length || request.result.index >= evaluations.length
    || request.selection.index >= selections.length {
    CompilerBug.panic(b"source selection has an absent actual occurrence or prepared selection")
  }
  let selected = &selections[request.selection.index]
  let site = match evaluations[request.result.index].site {
    EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"source projection result is not an actual node evaluation") }
  }
  if selected.site.index != site.index || selected.root.index >= endpoints.length {
    CompilerBug.panic(b"source selection belongs to another consumer site")
  }
  let actual = match &endpoints[selected.root.index].root {
    Root.Node {node, ..} => match evaluations[request.operand.index].site {
      EvaluationSite.Node {node: operand} => operand.index == node.index
      _ => false
    }
    _ => false
  }
  if !actual { CompilerBug.panic(b"source selection lost its retained subject occurrence") }
  let listed = List<MapId>.asSlice(&selected.maps)
  let selectors = List<MapId>.asSlice(&request.selectors)
  let mut terminal = selected.root
  let mut at = usize.ZERO
  while at < selectors.length {
    let id = selectors[at]
    if id.index >= maps.length { CompilerBug.panic(b"source selection names an absent selector") }
    let map = &maps[id.index]
    if map.site.index != site.index || map.kind != MapKind.Select || map.source.index != terminal.index {
      CompilerBug.panic(b"source selection lost its ordered authored selector path")
    }
    let mut found = usize.ZERO
    let mut each = usize.ZERO
    while each < listed.length {
      if listed[each].index == id.index { found = found + usize.ONE }
      each = each + usize.ONE
    }
    if found != usize.ONE { CompilerBug.panic(b"source selector is not a unique member of its prepared selection") }
    terminal = map.target
    at = at + usize.ONE
  }
  let accepted = List<EndpointId>.asSlice(&selected.accepts)
  if accepted.length == usize.ZERO { CompilerBug.panic(b"source selection has no explicit accepting frontier") }
  let families: [Option<MapId>; 2] = [request.value, request.place]
  let mut family = usize.ZERO
  while family < families.length {
    if let Option<MapId>.Some {value: root} = families[family] {
      let members = run transferFamily(endpoints, maps, root)
      let map = &maps[root.index]
      let mut expectedKind = MapKind.Copy
      let mut expectedRole = EndpointRole.Value
      if family == usize.ONE {
        expectedKind = MapKind.Select
        expectedRole = EndpointRole.Storage
      }
      let output = match &endpoints[map.target.index].root {
        Root.Node {node, role} => node.index == site.index && role == expectedRole
        _ => false
      }
      if map.site.index != site.index || map.source.index != terminal.index
        || map.kind != expectedKind || !output {
        CompilerBug.panic(b"source projection output family is not its exact consumer placement")
      }
      let children = List<MapId>.asSlice(&members)
      let mut leafCount = usize.ZERO
      at = usize.ZERO
      while at < children.length {
        let child = &maps[children[at].index]
        if List<MapId>.length(&child.children) == usize.ZERO {
          let mut matches = usize.ZERO
          let mut each = usize.ZERO
          while each < accepted.length {
            if accepted[each].index == child.source.index { matches = matches + usize.ONE }
            each = each + usize.ONE
          }
          if matches != usize.ONE { CompilerBug.panic(b"source projection changed its accepting component frontier") }
          leafCount = leafCount + usize.ONE
        }
        at = at + usize.ONE
      }
      if leafCount != accepted.length { CompilerBug.panic(b"source projection omitted an accepting component") }
    }
    family = family + usize.ONE
  }
  return ()
}

// The family is a finite tree of actual inline component maps. Reject malformed cycles or
// duplicate ownership; do not turn them into a truncated/opaque source route.
effect fn transferFamily(endpoints: &[Endpoint], maps: &[SelectionMap], root: MapId) -> List<MapId>
! OutOfMemoryError ? &mut Allocator {
  if root.index >= maps.length { CompilerBug.panic(b"physical transfer has no prepared map") }
  let mut family = List<MapId>.make()
  run List<MapId>.append(&mut family, root)
  let mut next = usize.ZERO
  while next < List<MapId>.length(&family) {
    let index = List<MapId>.asSlice(&family)[next].index
    let map = &maps[index]
    if map.source.index >= endpoints.length || map.target.index >= endpoints.length {
      CompilerBug.panic(b"physical transfer map has an absent endpoint")
    }
    let children = List<MapId>.asSlice(&map.children)
    let mut child = usize.ZERO
    while child < children.length {
      let nested = children[child]
      if nested.index >= maps.length { CompilerBug.panic(b"physical transfer family has an absent child map") }
      let found = List<MapId>.asSlice(&family)
      let mut previous = usize.ZERO
      while previous < found.length {
        if found[previous].index == nested.index { CompilerBug.panic(b"physical transfer family repeats a child map") }
        previous = previous + usize.ONE
      }
      let inner = &maps[nested.index]
      if inner.source.index >= endpoints.length || inner.target.index >= endpoints.length
        || inner.site.index != map.site.index || inner.kind != map.kind {
        CompilerBug.panic(b"physical transfer child belongs to another operation")
      }
      let fromParent = match &endpoints[inner.source.index].parent {
        Option<EndpointId>.Some {value} => value.index == map.source.index
        _ => false
      }
      let toParent = match &endpoints[inner.target.index].parent {
        Option<EndpointId>.Some {value} => value.index == map.target.index
        _ => false
      }
      if !fromParent || !toParent { CompilerBug.panic(b"physical transfer child is not its paired inline component") }
      run List<MapId>.append(&mut family, nested)
      child = child + usize.ONE
    }
    next = next + usize.ONE
  }
  return move family
}

effect fn selectedAliasMap(skeleton: &Skeleton, endpoints: &[Endpoint], maps: &[SelectionMap],
  map: MapId, source: EvalId, target: EvalId) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let mut at = usize.ZERO
  while at < selections.length {
    let selected = &selections[at]
    if selected.operand.index == source.index && selected.result.index == target.index {
      if let Option<MapId>.Some {value: root} = selected.place {
        let family = run transferFamily(endpoints, maps, root)
        let members = List<MapId>.asSlice(&family)
        let mut each = usize.ZERO
        while each < members.length {
          if members[each].index == map.index { return at }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"selected address projection has no actual selector occurrence")
}

effect fn addressApplies(rules: &mut Program, operation: Atom, address: Atom) -> Atom
! OutOfMemoryError ? &mut Allocator {
  let result = Program.atom(&mut rules.*)
  let both: [Atom; 2] = [operation, address]
  let absent = List<Atom>.make()
  run Program.rule(&mut rules.*, result, &both, List<Atom>.asSlice(&absent))
  return result
}

// Descendant identity within one frozen component tree; never a comparison of types or
// region sets. Aliases supplied here were already restricted to actual inline storage.
fn validateRetainedWrites<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let operations = List<Stores.Operation>.asSlice(&skeleton.stores.operations)
  let addresses = List<RetainedAddress>.asSlice(&skeleton.retainedAddresses)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let values = List<Value>.asSlice(&skeleton.values)
  let holders = List<WriteHolder>.asSlice(&skeleton.writeHolders)
  let candidates = List<RetainedWrite>.asSlice(&skeleton.writes)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let rows = List<Prepared.Operation>.asSlice(&prepared.operations)
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = candidates[at]
    if candidate.operation >= operations.length || candidate.address >= addresses.length
      || candidate.source.index >= values.length || candidate.target.index >= values.length || candidate.holder >= holders.length {
      CompilerBug.panic(b"retained write lost an actual operation, value, holder or address")
    }
    let operation = &operations[candidate.operation]
    let address = addresses[candidate.address]
    let inputs = List<Stores.Input>.asSlice(&operation.inputs)
    if address.operation != candidate.operation || candidate.sourceInput >= inputs.length
      || address.input >= inputs.length || address.alias >= aliases.length || address.edge >= edges.length {
      CompilerBug.panic(b"retained write changed its owning input or address contributor")
    }
    let source = &inputs[candidate.sourceInput]
    let destination = &inputs[address.input]
    if candidate.sourceSlot >= List<Stores.Slot>.length(&source.slots)
      || address.slot >= List<Stores.Slot>.length(&destination.slots)
      || address.path >= List<Stores.Path>.length(&List<Stores.Slot>.asSlice(&destination.slots)[address.slot].paths) {
      CompilerBug.panic(b"retained write substituted another original slot or physical path")
    }
    let retained = &List<Prepared.Retention>.asSlice(&prepared.retentions)[operation.retention.index]
    let mut owner = usize.MAX
    let mut row = usize.ZERO
    while row < rows.length {
      if rows[row].site.index == retained.site.index {
        if owner != usize.MAX { CompilerBug.panic(b"retained writer has duplicate originating operations") }
        owner = row
      }
      row = row + usize.ONE
    }
    if owner == usize.MAX || source.route >= List<InputRoute>.length(&rows[owner].inputs) {
      CompilerBug.panic(b"retained write has no originating physical input binding")
    }
    let route = List<InputRoute>.asSlice(&rows[owner].inputs)[source.route]
    let root = maps[route.map.index].source
    let before = values[candidate.source.index]
    let after = values[candidate.target.index]
    let holder = &holders[candidate.holder]
    let execution = Skeleton.evaluation(skeleton, holder.execution)
    let actual = Skeleton.evaluation(skeleton, operation.evaluation)
    let sameSite = match execution.site { EvaluationSite.Node {node} => match actual.site {
      EvaluationSite.Node {node: other} => node.index == other.index _ => false } _ => false }
    if before.evaluation.index != source.actual.evaluation.index || before.phase != ValuePhase.Output
      || !inlineWithin(prepared, before.endpoint, root) || !sameSite || execution.role != EvaluationRole.Execute
      || execution.point.index != operation.execute.index || after.evaluation.index != holder.execution.index
      || after.endpoint.index != address.storage.endpoint.index || edges[address.edge].target != address.alias
      || !sameStorage(aliases[address.alias].storage, address.storage)
      || !sameTemporary(holder.storage.temporary, address.storage.temporary)
      || !inlineWithin(prepared, address.storage.endpoint, holder.storage.endpoint) {
      CompilerBug.panic(b"retained write changed source occurrence or canonical execution placement")
    }
    let components = List<WriteComponent>.asSlice(&holder.components)
    let mut found = false
    row = usize.ZERO
    while row < components.length {
      if components[row].value.index == candidate.target.index && sameStorage(components[row].storage, address.storage) { found = true }
      row = row + usize.ONE
    }
    if !found { CompilerBug.panic(b"retained write has no coalesced holder definition") }
    at = at + usize.ONE
  }
  return ()
}

// Actual inline ownership only. Referent/channel/opaque boundaries never become holder
// fields, even if a deeper endpoint was reserved for a later selector.
fn inlineWithin<'body>(prepared: &SourcePreparation<'body>, endpoint: EndpointId, root: EndpointId) -> bool {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let mut current = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index == root.index { return true }
    if current.index >= endpoints.length { return CompilerBug.panic(b"inline owner has an absent component") }
    let parent = match endpoints[current.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    let components = List<Prepared.Component>.asSlice(&shapes[endpoints[parent.index].shape.index].components)
    let mut owned = false
    let mut at = usize.ZERO
    while at < components.length {
      if sameSelector(&components[at].selector, &endpoints[current.index].selector) { owned = components[at].inline }
      at = at + usize.ONE
    }
    if !owned { return false }
    current = parent
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"inline owner component ancestry is cyclic")
}
fn storageOwner<'body>(prepared: &SourcePreparation<'body>, endpoint: EndpointId) -> EndpointId {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut root = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    let parent = match endpoints[root.index].parent { Option<EndpointId>.Some {value} => value _ => { return root } }
    if !inlineWithin(prepared, root, parent) { return root }
    root = parent
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"retained holder ancestry is cyclic")
}

fn componentWithin(endpoints: &[Endpoint], candidate: EndpointId, root: EndpointId) -> bool {
  let mut current = candidate
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index == root.index { return true }
    if current.index >= endpoints.length { CompilerBug.panic(b"storage component is absent") }
    match endpoints[current.index].parent {
      Option<EndpointId>.Some {value} => { current = value }
      Option<EndpointId>.None => { return false }
    }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"storage component ancestry is cyclic")
}

fn endpointRole(endpoint: &Endpoint) -> Option<EndpointRole> {
  return match &endpoint.root {
    Root.Local {role, ..} => Option<EndpointRole>.some(role)
    Root.Node {role, ..} => Option<EndpointRole>.some(role)
    _ => Option<EndpointRole>.none()
  }
}

fn validateReferenceMaps(endpoints: &[Endpoint], maps: &[SelectionMap], descriptor: MapId, referent: MapId) -> () {
  if descriptor.index >= maps.length || referent.index >= maps.length {
    CompilerBug.panic(b"producer-created reference has an absent map")
  }
  let created = &maps[descriptor.index]
  let carried = &maps[referent.index]
  if created.source.index >= endpoints.length || created.target.index >= endpoints.length
    || carried.source.index >= endpoints.length || carried.target.index >= endpoints.length {
    CompilerBug.panic(b"producer-created reference has an absent endpoint")
  }
  if created.site.index != carried.site.index || List<MapId>.length(&created.children) != usize.ZERO {
    CompilerBug.panic(b"reference creation and its referent are not one producer operation")
  }
  let storage = match move endpointRole(&endpoints[created.source.index]) {
    Option<EndpointRole>.Some {value} => value == EndpointRole.Storage
    _ => false
  }
  let value = match move endpointRole(&endpoints[carried.source.index]) {
    Option<EndpointRole>.Some {value} => value == EndpointRole.Value
    _ => false
  }
  let paired = match &endpoints[carried.target.index].parent {
    Option<EndpointId>.Some {value: parent} => parent.index == created.target.index
    _ => false
  }
  let through = match &endpoints[carried.target.index].selector { Selector.Referent => true _ => false }
  if !storage || !value || !paired || !through
    || !sameSourceComponent(endpoints, created.source, carried.source) {
    CompilerBug.panic(b"reference map must create a descriptor and separately carry its referent")
  }
  return ()
}

// Storage and Value roots for the same authored component differ in role, never in source
// identity. This validates the supplied pair; it does not search for or construct a map.
fn sameSourceComponent(endpoints: &[Endpoint], storage: EndpointId, value: EndpointId) -> bool {
  let mut left = storage
  let mut right = value
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if left.index >= endpoints.length || right.index >= endpoints.length { return false }
    let a = &endpoints[left.index]
    let b = &endpoints[right.index]
    if !sameSelector(&a.selector, &b.selector) { return false }
    match &a.parent {
      Option<EndpointId>.Some {value: parent} => {
        if let Option<EndpointId>.Some {value: other} = &b.parent {
          left = parent
          right = other
        } else { return false }
      }
      Option<EndpointId>.None => {
        if let Option<EndpointId>.Some {..} = &b.parent { return false }
        return match &a.root {
          Root.Node {node, ..} => match &b.root {
            Root.Node {node: other, ..} => node.index == other.index
            _ => false
          }
          Root.Local {local, ..} => match &b.root {
            Root.Local {local: other, ..} => local.index == other.index
            _ => false
          }
          _ => false
        }
      }
    }
    remaining = remaining - usize.ONE
  }
  CompilerBug.panic(b"prepared component ancestry is cyclic")
}

pub fn sameSelector(left: &Selector, right: &Selector) -> bool {
  return match &left.* {
    Selector.Member {declaration, member, payload} => match &right.* {
      Selector.Member {declaration: other, member: selected, payload: field} =>
        DeclarationId.equals(&DeclarationId.copyShared(&declaration), &DeclarationId.copyShared(&other))
          && member == selected && payload == field
      _ => false
    }
    Selector.Field {ordinal} => match &right.* { Selector.Field {ordinal: other} => ordinal == other _ => false }
    Selector.Variant {ordinal} => match &right.* { Selector.Variant {ordinal: other} => ordinal == other _ => false }
    Selector.Index {class: IndexClass.Exact {index}} => match &right.* {
      Selector.Index {class: IndexClass.Exact {index: other}} => index == other
      _ => false
    }
    Selector.Index {class: IndexClass.Remainder} => match &right.* { Selector.Index {class: IndexClass.Remainder} => true _ => false }
    Selector.Referent => match &right.* { Selector.Referent => true _ => false }
    Selector.EffectSuccess => match &right.* { Selector.EffectSuccess => true _ => false }
    Selector.EffectFailure => match &right.* { Selector.EffectFailure => true _ => false }
    Selector.Identity => match &right.* { Selector.Identity => true _ => false }
    Selector.Opaque => match &right.* { Selector.Opaque => true _ => false }
  }
}

fn findCell(keys: &[CellKey], value: ValueId, leaf: LeafId, witness: usize, direct: bool) -> usize {
  let mut at = usize.ZERO
  while at < keys.length {
    let key = keys[at]
    if key.value.index == value.index && key.leaf.index == leaf.index && key.witness == witness && key.direct == direct { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// Complete physical storage transfers are created from the same relation used by ownership
/// projection. No creation-order source classifier or historical loan list participates here.
/// The definition/read numbers index explicit records, not inferred source ordering.
fn definitionView(reaching: &Reaching, storage: &[Storage], recorded: &[DefinedValue], id: DefinitionId) -> DefinitionView {
  let definitions = List<Definition>.asSlice(&reaching.definitions)
  if id.index >= definitions.length || id.index >= recorded.length || recorded[id.index].definition.index != id.index {
    return CompilerBug.panic(b"source definition projection lost its original flow identity")
  }
  let actual = definitions[id.index]
  if actual.component.index >= storage.length { return CompilerBug.panic(b"source definition has no canonical storage") }
  return DefinitionView {id: id, point: actual.point, storage: storage[actual.component.index],
    value: recorded[id.index].value, writer: recorded[id.index].writer, active: actual.active, write: actual.write}
}

fn readView(reaching: &Reaching, storage: &[Storage], recorded: &[ReadValue], id: ReadId) -> ReadView {
  let reads = List<Read>.asSlice(&reaching.reads)
  if id.index >= reads.length || id.index >= recorded.length || recorded[id.index].read.index != id.index {
    return CompilerBug.panic(b"source read projection lost its original flow identity")
  }
  let actual = reads[id.index]
  if actual.component.index >= storage.length || !sameStorage(storage[actual.component.index], recorded[id.index].storage) {
    return CompilerBug.panic(b"source read projection substituted another canonical storage")
  }
  return ReadView {id: id, point: actual.point, storage: recorded[id.index].storage,
    value: recorded[id.index].value, map: recorded[id.index].map}
}

effect fn readPlacements<'body>(prepared: &SourcePreparation<'body>, reaching: &Reaching,
  storage: &[Storage], reads: &[ReadValue], values: &[Value], evaluations: &[Evaluation],
  aliases: &[StorageAlias], requests: &[AliasTransport], recorded: &[AliasRead],
  value: ValueId, read: ReadId) -> List<ReadPlacement> ! OutOfMemoryError ? &mut Allocator {
  if value.index >= values.length { return CompilerBug.panic(b"read attribution names an absent input") }
  let input = values[value.index]
  if input.phase != ValuePhase.Input { return CompilerBug.panic(b"read attribution requires the actual pre-publication input") }
  if let Option<ResidualSubject>.Some {..} = input.subject {
    return CompilerBug.panic(b"selected residual read needs its explicit selected placement authority")
  }
  let actual = readView(reaching, storage, reads, read)
  let mut result = List<ReadPlacement>.make()
  if evaluations[input.evaluation.index].point.index != actual.point.index { return move result }
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  if reads[read.index].value.index == value.index {
    if let Option<MapId>.Some {value: map} = actual.map {
      if map.index >= maps.length || maps[map.index].kind != MapKind.Copy
        || maps[map.index].source.index != actual.storage.endpoint.index
        || maps[map.index].target.index != input.endpoint.index {
        return CompilerBug.panic(b"local read lost its exact canonical component mapping")
      }
      run List<ReadPlacement>.append(&mut result, ReadPlacement {consumer: value, read: read, storage: actual.storage,
        map: map, operand: input.evaluation, result: input.evaluation, alias: Option<usize>.none(),
        active: List<Point>.asSlice(&reaching.points)[actual.point.index].reachable})
    }
  }
  let mut at = usize.ZERO
  while at < recorded.length {
    if recorded[at].read.index == read.index {
      if recorded[at].request >= requests.length { CompilerBug.panic(b"canonical read lost its actual address use") }
      let request = requests[recorded[at].request]
      if let AliasConsumer.Projection {map: selected} = request.authority {
        if request.alias >= aliases.length || selected.index >= maps.length {
          CompilerBug.panic(b"canonical read lost its selected address or consumer map")
        }
        let alias = &aliases[request.alias]
        let map = &maps[selected.index]
        if request.direction != MapDirection.Forward || map.kind != MapKind.Copy
          || map.source.index != alias.endpoint.index || !sameStorage(alias.storage, actual.storage) {
          CompilerBug.panic(b"read attribution substituted another canonical source or selection")
        }
        let exact = match request.consumer { Option<ValueId>.Some {value: selected} => selected.index == value.index _ => false }
        if exact && request.evaluation.index == input.evaluation.index && map.target.index == input.endpoint.index {
          run List<ReadPlacement>.append(&mut result, ReadPlacement {consumer: value, read: read, storage: alias.storage,
            map: selected, operand: alias.evaluation, result: request.evaluation,
            alias: Option<usize>.some(request.alias), active: request.active})
        }
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// Enumerate only consumers actually recorded by the read emitter. A copied operand may
// retain this ReadId long after the original read, so its present endpoint/evaluation must
// never be used to recover the earlier selected place.
effect fn readPlacementsByRead<'body>(prepared: &SourcePreparation<'body>, reaching: &Reaching,
  storage: &[Storage], reads: &[ReadValue], values: &[Value], evaluations: &[Evaluation],
  aliases: &[StorageAlias], requests: &[AliasTransport], recorded: &[AliasRead],
  read: ReadId) -> List<ReadPlacement> ! OutOfMemoryError ? &mut Allocator {
  let actual = readView(reaching, storage, reads, read)
  let mut consumers = List<ValueId>.make()
  if let Option<MapId>.Some {..} = actual.map {
    run List<ValueId>.append(&mut consumers, actual.value)
  }
  let mut at = usize.ZERO
  while at < recorded.length {
    if recorded[at].read.index == read.index {
      if recorded[at].request >= requests.length { CompilerBug.panic(b"read consumer lost its actual transport") }
      let request = requests[recorded[at].request]
      let consumer = match request.consumer {
        Option<ValueId>.Some {value} => value
        _ => { return CompilerBug.panic(b"an emitted read omitted its original consumer") }
      }
      if consumer.index >= values.length { CompilerBug.panic(b"read consumer has no reserved value") }
      let value = values[consumer.index]
      if value.evaluation.index != request.evaluation.index || request.direction != MapDirection.Forward {
        CompilerBug.panic(b"read consumer changed its actual occurrence or direction")
      }
      // Only actual Input observations have an attribution certificate. A handler that
      // did not request such a read retains explicit missing coverage in its consumer.
      if value.phase == ValuePhase.Input {
        let old = List<ValueId>.asSlice(&consumers)
        let mut found = false
        let mut each = usize.ZERO
        while each < old.length { if old[each].index == consumer.index { found = true } each = each + usize.ONE }
        if !found { run List<ValueId>.append(&mut consumers, consumer) }
      }
    }
    at = at + usize.ONE
  }
  let mut result = List<ReadPlacement>.make()
  let selected = List<ValueId>.asSlice(&consumers)
  at = usize.ZERO
  while at < selected.length {
    let rows = run readPlacements(prepared, reaching, storage, reads, values, evaluations,
      aliases, requests, recorded, selected[at], read)
    let rows = List<ReadPlacement>.asSlice(&rows)
    let mut each = usize.ZERO
    while each < rows.length { run List<ReadPlacement>.append(&mut result, rows[each]) each = each + usize.ONE }
    at = at + usize.ONE
  }
  return move result
}

fn validateStorage(maps: &[SelectionMap], reaching: &Reaching, storage: &[Storage],
  stored: &[DefinedValue], readValues: &[ReadValue], values: &[Value], evaluations: &[Evaluation]) -> () {
  let definitions = List<Definition>.asSlice(&reaching.definitions)
  let reads = List<Read>.asSlice(&reaching.reads)
  if stored.length != definitions.length || readValues.length != reads.length {
    CompilerBug.panic(b"source storage reservation omitted a definition or read value")
  }
  let mut at = usize.ZERO
  while at < stored.length {
    let actual = stored[at]
    if actual.definition.index != at || actual.value.index >= values.length {
      CompilerBug.panic(b"source storage definition identity is invalid")
    }
    let value = values[actual.value.index]
    if value.evaluation.index >= evaluations.length || definitions[at].component.index >= storage.length || value.endpoint.index != storage[definitions[at].component.index].endpoint.index {
      CompilerBug.panic(b"source storage definition value has a different component")
    }
    if evaluations[value.evaluation.index].point.index != definitions[at].point.index {
      CompilerBug.panic(b"source storage definition value has a different evaluation point")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < readValues.length {
    let actual = readValues[at]
    if actual.read.index != at || actual.value.index >= values.length {
      CompilerBug.panic(b"source storage read identity is invalid")
    }
    let value = values[actual.value.index]
    if value.evaluation.index >= evaluations.length { CompilerBug.panic(b"source storage read has no evaluation") }
    if value.phase != ValuePhase.Input { CompilerBug.panic(b"reaching sources must enter a read before its publication") }
    if reads[at].component.index >= storage.length || !sameStorage(actual.storage, storage[reads[at].component.index]) {
      CompilerBug.panic(b"source storage read substituted another canonical owner occurrence")
    }
    match actual.map {
      Option<MapId>.Some {value: selected} => {
        if selected.index >= maps.length { CompilerBug.panic(b"source storage read has no prepared map") }
        let map = &maps[selected.index]
        if reads[at].component.index >= storage.length || map.source.index != storage[reads[at].component.index].endpoint.index || map.target.index != value.endpoint.index {
          CompilerBug.panic(b"source storage read map does not name its actual endpoints")
        }
      }
      Option<MapId>.None => {
        if reads[at].component.index >= storage.length || storage[reads[at].component.index].endpoint.index != value.endpoint.index {
          CompilerBug.panic(b"an identity storage read changed its physical component")
        }
      }
    }
    if evaluations[value.evaluation.index].point.index != reads[at].point.index {
      CompilerBug.panic(b"source storage read value has a different evaluation point")
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn storageTransfers(pairs: &[Pair], first: usize, stored: &[DefinedValue], readValues: &[ReadValue],
  transfers: &mut List<Transfer>, rules: &mut Program) -> () ! OutOfMemoryError ? &mut Allocator {
  // Copying a descriptor adds no loss itself. Loss already present at the definition travels
  // along the value path; observation of a later loan-wide loss does not rewrite this copy.
  let noLoss = Program.atom(&mut rules.*)
  let mut at = first
  while at < pairs.length {
    let pair = pairs[at]
    if pair.definition.index >= stored.length || pair.read.index >= readValues.length {
      CompilerBug.panic(b"source pair lacks its actual stored/read value")
    }
    let source = stored[pair.definition.index]
    let target = readValues[pair.read.index]
    run List<Transfer>.append(&mut transfers.*, Transfer { source: source.value, target: target.value,
      active: pair.active, directness: Directness.Preserve, stored: noLoss, alternatives: noLoss,
      definition: Option<DefinitionId>.some(pair.definition), read: Option<ReadId>.some(pair.read), policy: TransferPolicy.Physical, terminal: false, authority: readAuthority(target.map)})
    at = at + usize.ONE
  }
  return ()
}

fn validateReplacement<'body>(prepared: &SourcePreparation<'body>, replacement: &Prepared.Replacement) -> () {
  let nodes = prepared.body.nodes
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  if replacement.site.index >= nodes.length || replacement.displaced.index >= maps.length || replacement.installed.index >= maps.length {
    CompilerBug.panic(b"replacement names an absent typed operation or map")
  }
  let arguments = match &nodes[replacement.site.index].kind {
    NodeKind.Expression {form: Expression.StorageCall {operation: StorageOperation.Replace, arguments, ..}, ..} =>
      List<NodeId>.asSlice(&arguments)
    _ => { return CompilerBug.panic(b"replacement maps do not belong to a typed Replace operation") }
  }
  if arguments.length != 2 { CompilerBug.panic(b"replacement maps lost their place/value operands") }
  let read = &maps[replacement.displaced.index]
  let write = &maps[replacement.installed.index]
  if read.source.index >= endpoints.length || read.target.index >= endpoints.length
    || write.source.index >= endpoints.length || write.target.index >= endpoints.length {
    CompilerBug.panic(b"replacement map has an absent physical endpoint")
  }
  let storage = &endpoints[read.source.index]
  let actual = match &storage.root {
    Root.Node {node, role} => node.index == arguments[usize.ZERO].index && role == EndpointRole.Storage
    _ => false
  }
  let whole = match &storage.parent { Option<EndpointId>.None => true _ => false }
  if !actual || !whole || read.source.index != write.target.index
    || read.kind != MapKind.Copy || write.kind != MapKind.Place
    || read.site.index != replacement.site.index || write.site.index != replacement.site.index
    || !nodeValueEndpoint(&endpoints[read.target.index], replacement.site)
    || !nodeValueEndpoint(&endpoints[write.source.index], arguments[usize.ONE]) {
    CompilerBug.panic(b"replacement maps changed their exact displaced/installed correspondence")
  }
  return ()
}

// Typed conversion is the only authority for Reference<Array> -> Slice. The root is
// descriptor transport, not a general same-shape component map or another borrow.
fn validateArraySlice<'body>(prepared: &SourcePreparation<'body>, conversion: &Prepared.ArraySlice) -> () {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  if conversion.site.index >= prepared.body.nodes.length || conversion.descriptor.index >= maps.length
    || conversion.referent.index >= maps.length { CompilerBug.panic(b"array slice lost its typed conversion or maps") }
  let descriptor = &maps[conversion.descriptor.index]
  let referent = &maps[conversion.referent.index]
  if descriptor.source.index >= endpoints.length || descriptor.target.index >= endpoints.length || referent.target.index >= endpoints.length {
    CompilerBug.panic(b"array slice has an absent endpoint")
  }
  let mut count = usize.ZERO
  match &prepared.body.nodes[conversion.site.index].kind {
    NodeKind.Expression {form: Expression.ArraySlice {value, count: extent}, ..} => {
      if !nodeValueEndpoint(&endpoints[descriptor.source.index], value) {
        CompilerBug.panic(b"array slice does not transport its actual operand")
      }
      count = extent
    }
    _ => { CompilerBug.panic(b"array slice record is not a typed conversion") }
  }
  if !nodeValueEndpoint(&endpoints[descriptor.target.index], conversion.site)
    || descriptor.kind != MapKind.Copy || descriptor.componentTransport || descriptor.addressTransport
    || descriptor.site.index != conversion.site.index || List<MapId>.length(&descriptor.children) != usize.ZERO
    || List<Prepared.BoundaryTransitionId>.length(&descriptor.boundaries) != usize.ZERO
    || !sameSelector(&descriptor.selector, &Selector.Identity)
    || referent.site.index != conversion.site.index || referent.kind != MapKind.Select
    || referent.source.index != descriptor.source.index || !sameSelector(&referent.selector, &Selector.Referent) {
    CompilerBug.panic(b"array slice descriptor acquired fabricated component or address authority")
  }
  let array = &endpoints[referent.target.index]
  let child = match array.parent { Option<EndpointId>.Some {value} => value.index == descriptor.source.index _ => false }
  if !child || !sameSelector(&array.selector, &Selector.Referent) || array.shape.index >= shapes.length {
    CompilerBug.panic(b"array slice lost its exact borrowed-array referent")
  }
  match &shapes[array.shape.index].state {
    Prepared.ShapeState.Array {length} => {
      if length != count { CompilerBug.panic(b"array slice changed its reaching extent") }
    }
    _ => { CompilerBug.panic(b"array slice referent is not an array") }
  }
  let parts = List<Prepared.Component>.asSlice(&shapes[array.shape.index].components)
  let elements = List<Prepared.ArraySliceElement>.asSlice(&conversion.elements)
  if elements.length != parts.length || (count == usize.ZERO && elements.length != usize.ZERO)
    || (count != usize.ZERO && elements.length == usize.ZERO) {
    CompilerBug.panic(b"array slice omitted or invented an element partition")
  }
  let selections = List<Selection>.asSlice(&prepared.selections)
  let mut at = usize.ZERO
  while at < elements.length {
    let element = &elements[at]
    if element.source.index >= maps.length || element.target.index >= maps.length || element.value.index >= maps.length
      || element.selection.index >= selections.length { CompilerBug.panic(b"array slice element lost its paired route") }
    let source = &maps[element.source.index]
    let target = &maps[element.target.index]
    let value = &maps[element.value.index]
    if source.target.index >= endpoints.length || target.target.index >= endpoints.length {
      CompilerBug.panic(b"array slice element names an absent selected component")
    }
    if source.site.index != conversion.site.index || target.site.index != conversion.site.index || value.site.index != conversion.site.index
      || source.kind != MapKind.Select || target.kind != MapKind.Select || value.kind != MapKind.Copy
      || source.source.index != referent.target.index || target.source.index != descriptor.target.index
      || value.source.index != source.target.index || value.target.index != target.target.index
      || !sameSelector(&source.selector, &parts[at].selector)
      || !sameSelector(&target.selector, &Selector.Index {class: IndexClass.Remainder}) {
      CompilerBug.panic(b"array slice cross-paired its source partition and target selection")
    }
    let sourceChild = match endpoints[source.target.index].parent { Option<EndpointId>.Some {value} => value.index == source.source.index _ => false }
    let targetChild = match endpoints[target.target.index].parent { Option<EndpointId>.Some {value} => value.index == target.source.index _ => false }
    if !sourceChild || !targetChild || !sameSelector(&endpoints[source.target.index].selector, &source.selector)
      || !sameSelector(&endpoints[target.target.index].selector, &target.selector) {
      CompilerBug.panic(b"array slice element selector has a different physical parent")
    }
    let selection = &selections[element.selection.index]
    if selection.root.index != descriptor.source.index { CompilerBug.panic(b"array slice history is not rooted at its actual descriptor") }
    let listed = List<MapId>.asSlice(&selection.maps)
    let mut refCount = usize.ZERO
    let mut partCount = usize.ZERO
    let mut each = usize.ZERO
    while each < listed.length {
      if listed[each].index == conversion.referent.index { refCount = refCount + usize.ONE }
      if listed[each].index == element.source.index { partCount = partCount + usize.ONE }
      each = each + usize.ONE
    }
    if refCount != usize.ONE || partCount != usize.ONE { CompilerBug.panic(b"array slice source history lost its exact two boundary edges") }
    let accepted = List<EndpointId>.asSlice(&selection.accepts)
    each = usize.ZERO
    while each < accepted.length {
      if !componentWithin(endpoints, accepted[each], source.target) { CompilerBug.panic(b"array slice source history accepts another partition") }
      each = each + usize.ONE
    }
    if accepted.length == usize.ZERO { CompilerBug.panic(b"array slice source history has no explicit component frontier") }
    at = at + usize.ONE
  }
  return ()
}

/// Missing supported routes are internal construction failures even when their inputs happen
/// to be absent in this solution. Validate before source closure, never by selected outcomes.
fn validateAuthoredBorrow<'body>(preparation: &SourcePreparation<'body>, borrowed: &Prepared.Borrow) -> () {
  let nodes = preparation.body.nodes
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  if borrowed.site.index >= nodes.length { CompilerBug.panic(b"prepared borrow has no actual node") }
  let operand = match &nodes[borrowed.site.index].kind {
    NodeKind.Expression {form: Expression.Borrow {value, ..}, ..} => value
    _ => { return CompilerBug.panic(b"prepared authored borrow is not a typed Borrow node") }
  }
  validateReferenceMaps(endpoints, maps, borrowed.map, borrowed.referent)
  let descriptor = &maps[borrowed.map.index]
  if descriptor.site.index != borrowed.site.index || !nodeValueEndpoint(&endpoints[descriptor.target.index], borrowed.site) {
    CompilerBug.panic(b"authored borrow map belongs to another descriptor occurrence")
  }
  let actual = match &endpoints[descriptor.source.index].root {
    Root.Node {node, role} => node.index == operand.index && role == EndpointRole.Storage
    _ => false
  }
  let whole = match endpoints[descriptor.source.index].parent { Option<EndpointId>.None => true _ => false }
  if !actual || !whole { CompilerBug.panic(b"authored borrow map does not name its actual operand storage root") }
  return ()
}

// Prepared operations name physical transfer families explicitly. In particular, preparing an
// Effect references Construction's placement; it is not a second execution of that placement.
// Validate before reservation, even for a currently unreachable operation. A malformed package
// is a compiler construction defect, not source uncertainty that can become a successful gap.
effect fn validatePreparedOperations<'body>(preparation: &SourcePreparation<'body>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let constructions = List<Prepared.Construction>.asSlice(&preparation.constructions)
  let operations = List<Prepared.Operation>.asSlice(&preparation.operations)
  let applications = List<Prepared.Application>.asSlice(&preparation.applications)
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  let borrows = List<Prepared.Borrow>.asSlice(&preparation.borrows)
  let replacements = List<Prepared.Replacement>.asSlice(&preparation.replacements)
  let mut at = usize.ZERO
  let conversions = List<Prepared.ArraySlice>.asSlice(&preparation.arraySlices)
  while at < conversions.length {
    validateArraySlice(preparation, &conversions[at])
    let elements = List<Prepared.ArraySliceElement>.asSlice(&conversions[at].elements)
    let mut each = usize.ZERO
    while each < elements.length {
      drop run transferFamily(endpoints, maps, elements[each].value)
      each = each + usize.ONE
    }
    let mut prior = usize.ZERO
    while prior < at {
      if conversions[prior].site.index == conversions[at].site.index { CompilerBug.panic(b"typed array slice has duplicate conversion records") }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < replacements.length {
    validateReplacement(preparation, &replacements[at])
    drop run transferFamily(endpoints, maps, replacements[at].displaced)
    drop run transferFamily(endpoints, maps, replacements[at].installed)
    let mut prior = usize.ZERO
    while prior < at {
      if replacements[prior].site.index == replacements[at].site.index { CompilerBug.panic(b"typed replacement has duplicate physical records") }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < borrows.length {
    validateAuthoredBorrow(preparation, &borrows[at])
    drop run transferFamily(endpoints, maps, borrows[at].referent)
    let mut earlier = usize.ZERO
    while earlier < at {
      if borrows[earlier].site.index == borrows[at].site.index { CompilerBug.panic(b"authored borrow has duplicate physical records") }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < preparation.body.nodes.length {
    if let NodeKind.Expression {form: Expression.Borrow {..}, ..} = &preparation.body.nodes[at].kind {
      let mut found = false
      let mut each = usize.ZERO
      while each < borrows.length {
        found = found || borrows[each].site.index == at
        each = each + usize.ONE
      }
      if !found { CompilerBug.panic(b"typed Borrow is missing its prepared physical map pair") }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constructions.length {
    let construction = &constructions[at]
    if construction.site.index >= preparation.body.nodes.length || construction.application.index >= applications.length {
      CompilerBug.panic(b"source construction has no actual site or representation application")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if constructions[earlier].site.index == construction.site.index {
        CompilerBug.panic(b"one physical construction has duplicate preparation records")
      }
      earlier = earlier + usize.ONE
    }
    let inputs = List<InputRoute>.asSlice(&construction.inputs)
    let mut input = usize.ZERO
    while input < inputs.length {
      run validatePreparedInput(preparation, construction.site, &inputs[input])
      let target = maps[inputs[input].map.index].target
      if !nodeValueEndpoint(&endpoints[target.index], construction.site) {
        CompilerBug.panic(b"construction placement does not target its actual descriptor")
      }
      earlier = usize.ZERO
      while earlier < input {
        if inputs[earlier].map.index == inputs[input].map.index {
          CompilerBug.panic(b"physical capture placement was duplicated as another input")
        }
        earlier = earlier + usize.ONE
      }
      input = input + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < operations.length {
    let operation = &operations[at]
    if operation.site.index >= preparation.body.nodes.length {
      CompilerBug.panic(b"source operation has no actual body site")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if operations[earlier].site.index == operation.site.index {
        CompilerBug.panic(b"one physical operation has duplicate preparation records")
      }
      earlier = earlier + usize.ONE
    }
    if let Option<ApplicationId>.Some {value} = operation.application {
      if value.index >= applications.length { CompilerBug.panic(b"source operation has no selected application") }
    }
    if let Option<EndpointId>.Some {value} = operation.receiver {
      if value.index >= endpoints.length { CompilerBug.panic(b"source operation has no actual receiver endpoint") }
    }
    let inputs = List<InputRoute>.asSlice(&operation.inputs)
    let mut input = usize.ZERO
    while input < inputs.length {
      run validatePreparedInput(preparation, operation.site, &inputs[input])
      input = input + usize.ONE
    }
    if operation.phase == Prepared.OperationPhase.PrepareEffect {
      if let Option<MapId>.Some {..} = operation.result {
        CompilerBug.panic(b"Effect preparation cannot publish an executed success result")
      }
      let mut found = usize.MAX
      let mut construction = usize.ZERO
      while construction < constructions.length {
        if constructions[construction].site.index == operation.site.index { found = construction }
        construction = construction + usize.ONE
      }
      if found == usize.MAX { CompilerBug.panic(b"Effect preparation has no owning physical construction") }
      let captures = List<InputRoute>.asSlice(&constructions[found].inputs)
      if captures.length != inputs.length { CompilerBug.panic(b"Effect preparation changed its physical input count") }
      input = usize.ZERO
      while input < inputs.length {
        if !sameInputRoute(&inputs[input], &captures[input]) {
          CompilerBug.panic(b"Effect preparation must reference its construction's exact paired input routes")
        }
        input = input + usize.ONE
      }
    } else {
      let result = match operation.result {
        Option<MapId>.Some {value} => value
        _ => { return CompilerBug.panic(b"executing operation has no exact result family") }
      }
      drop run transferFamily(endpoints, maps, result)
      let output = &maps[result.index]
      if output.site.index != operation.site.index || output.kind != MapKind.Contract
        || !nodeValueEndpoint(&endpoints[output.target.index], operation.site) {
        CompilerBug.panic(b"operation result is not its selected contract-to-result family")
      }
      if operation.phase == Prepared.OperationPhase.Invoke {
        let application = match operation.application {
          Option<ApplicationId>.Some {value} => value
          _ => { return CompilerBug.panic(b"invocation has no exact selected application") }
        }
        let selectedResult = match &endpoints[output.source.index].root {
          Root.Application {application: selected, port, space, ..} => selected.index == application.index
            && port == Prepared.ContractPort.Result && space == Prepared.TypeSpace.Applied
          _ => false
        }
        if !selectedResult {
          CompilerBug.panic(b"invocation result does not belong to its exact applied original contract")
        }
      }
      if operation.phase == Prepared.OperationPhase.ExecuteEffect {
        if let Option<ApplicationId>.Some {..} = operation.application {
          CompilerBug.panic(b"stored Run cannot substitute a type-selected application for reaching descriptors")
        }
        let receiver = match operation.receiver {
          Option<EndpointId>.Some {value} => value
          _ => { return CompilerBug.panic(b"stored Run has no actual descriptor receiver") }
        }
        let success = &endpoints[output.source.index]
        let paired = match success.parent {
          Option<EndpointId>.Some {value} => value.index == receiver.index
          _ => false
        }
        let selectedSuccess = match &success.selector { Selector.EffectSuccess => true _ => false }
        if !paired || !selectedSuccess { CompilerBug.panic(b"Run result must start at its actual receiver's success port") }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn nodeValueEndpoint(endpoint: &Endpoint, site: NodeId) -> bool {
  return match &endpoint.root {
    Root.Node {node, role} => node.index == site.index && role == EndpointRole.Value
    _ => false
  }
}

effect fn validatePreparedInput<'body>(preparation: &SourcePreparation<'body>, site: NodeId, input: &InputRoute) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  drop run transferFamily(endpoints, maps, input.map)
  let map = &maps[input.map.index]
  let operand = inputOperand(preparation, site, input.read)
  let physical = match &endpoints[map.source.index].root {
    Root.Node {node, ..} => node.index == operand.index
    _ => false
  }
  if !physical { CompilerBug.panic(b"prepared input map does not start at its selected actual operand") }
  if map.site.index != site.index || map.kind == MapKind.Contract
    || input.selected.index >= endpoints.length || input.original.index >= endpoints.length {
    CompilerBug.panic(b"operation input lacks its physical and declaration endpoint pair")
  }
  let selected = match &endpoints[input.selected.index].root {
    Root.Application {application, space, ..} => application.index < List<Prepared.Application>.length(&preparation.applications)
      && space == Prepared.TypeSpace.Selected
    _ => false
  }
  let original = match &endpoints[input.original.index].root {
    Root.Application {application, space, ..} => application.index < List<Prepared.Application>.length(&preparation.applications)
      && space == Prepared.TypeSpace.Original
    _ => false
  }
  if !selected || !original { CompilerBug.panic(b"input correspondence lost its distinct selected and original owner spaces") }
  let borrows = input.transport == Transport.BorrowShared || input.transport == Transport.BorrowMutable
  match input.referent {
    Option<MapId>.Some {value} => {
      if !borrows { CompilerBug.panic(b"value transport has a fabricated reference-creation route") }
      drop run transferFamily(endpoints, maps, value)
      validateReferenceMaps(endpoints, maps, input.map, value)
    }
    Option<MapId>.None => {
      if borrows { CompilerBug.panic(b"created reference is missing its paired referent route") }
    }
  }
  return ()
}

/// Select an authored operand coordinate, never a last evaluation of an equal NodeId.
pub fn inputOperand<'body>(preparation: &SourcePreparation<'body>, site: NodeId, read: InputRead) -> NodeId {
  if site.index >= preparation.body.nodes.length { return CompilerBug.panic(b"prepared input has no typed operation") }
  let form = match &preparation.body.nodes[site.index].kind {
    NodeKind.Expression {form, ..} => &form
    _ => return CompilerBug.panic(b"prepared input does not belong to an expression")
  }
  return match read {
    InputRead.Argument {ordinal} => {
      let arguments = match &form.* {
        Expression.DirectCall {arguments, ..} => List<NodeId>.asSlice(&arguments)
        Expression.InterfaceCall {arguments, ..} => List<NodeId>.asSlice(&arguments)
        Expression.CallableCall {arguments, ..} => List<NodeId>.asSlice(&arguments)
        Expression.StagedCallable {arguments, ..} => List<NodeId>.asSlice(&arguments)
        _ => return CompilerBug.panic(b"prepared argument selector has no actual argument vector")
      }
      if ordinal >= arguments.length { return CompilerBug.panic(b"prepared argument selector is out of bounds") }
      return arguments[ordinal]
    }
    InputRead.Receiver => match &form.* {
      Expression.Run {value, ..} => value
      Expression.CallableCall {callee, ..} => callee
      Expression.StagedCallable {callee, ..} => callee
      _ => return CompilerBug.panic(b"prepared receiver selector has no actual callee")
    }
    InputRead.Field {ordinal} => {
      let fields = match &form.* {
        Expression.Aggregate {fields, ..} => List<AggregateField>.asSlice(&fields)
        Expression.Callable {fields, ..} => List<AggregateField>.asSlice(&fields)
        _ => return CompilerBug.panic(b"prepared field selector has no actual capture vector")
      }
      if ordinal >= fields.length { return CompilerBug.panic(b"prepared field selector is out of bounds") }
      return fields[ordinal].value
    }
  }
}

pub fn sameInputRead(left: InputRead, right: InputRead) -> bool {
  return match left {
    InputRead.Argument {ordinal} => match right { InputRead.Argument {ordinal: other} => ordinal == other _ => false }
    InputRead.Receiver => match right { InputRead.Receiver => true _ => false }
    InputRead.Field {ordinal} => match right { InputRead.Field {ordinal: other} => ordinal == other _ => false }
  }
}

fn sameInputRoute(left: &InputRoute, right: &InputRoute) -> bool {
  if left.map.index != right.map.index || left.selected.index != right.selected.index
    || left.original.index != right.original.index || left.transport != right.transport
    || !sameInputRead(left.read, right.read) { return false }
  return match left.referent {
    Option<MapId>.Some {value} => match right.referent {
      Option<MapId>.Some {value: other} => value.index == other.index
      _ => false
    }
    Option<MapId>.None => match right.referent { Option<MapId>.None => true _ => false }
  }
}

effect fn validateReservation<'body>(preparation: &SourcePreparation<'body>, reaching: &Reaching,
  evaluations: &[Evaluation], values: &[Value], leaves: &[Leaf], seeds: &[Seed], transfers: &[Transfer], aliases: &[StorageAlias], aliasEdges: &[AliasEdge], aliasTransports: &[AliasTransport], storage: &[Storage], writes: &[RetainedWrite]) -> () ! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let points = List<Point>.asSlice(&reaching.points)
  let nodes = preparation.body.nodes
  let mut component = usize.ZERO
  while component < storage.length {
    let stored = storage[component]
    if stored.endpoint.index >= endpoints.length { CompilerBug.panic(b"canonical source storage lacks a prepared endpoint") }
    let valid = match stored.temporary {
      Option<EvalId>.Some {value} => {
        if value.index >= evaluations.length { CompilerBug.panic(b"temporary source storage has no actual owner evaluation") }
        match evaluations[value.index].site {
          EvaluationSite.Node {node: actual} => match &endpoints[stored.endpoint.index].root {
            Root.Node {node, role} => actual.index == node.index && role == EndpointRole.Storage
            _ => false
          }
          _ => false
        }
      }
      Option<EvalId>.None => match &endpoints[stored.endpoint.index].root { Root.Local {role, ..} => role == EndpointRole.Storage _ => false }
    }
    if !valid { CompilerBug.panic(b"canonical source storage substituted another owner or occurrence") }
    component = component + usize.ONE
  }
  let mut at = usize.ZERO
  while at < evaluations.length {
    let evaluation = evaluations[at]
    if evaluation.point.index >= points.length { CompilerBug.panic(b"source evaluation has no reserved CFG point") }
    match evaluation.site {
      EvaluationSite.Node {node} => {
        if node.index >= nodes.length || evaluation.role == EvaluationRole.Entry {
          CompilerBug.panic(b"source evaluation does not name its actual body node")
        }
      }
      EvaluationSite.Entry {local} => {
        if local.index >= preparation.body.locals.length || evaluation.role != EvaluationRole.Entry {
          CompilerBug.panic(b"source entry does not name actual initialized storage")
        }
        let mut node = usize.ZERO
        while node < nodes.length {
          let binding = match &nodes[node].kind {
            NodeKind.LocalBinding {local: bound, ..} => bound.index == local.index
            NodeKind.MutableBinding {local: bound, ..} => bound.index == local.index
            _ => false
          }
          if binding { CompilerBug.panic(b"a later local binding was fabricated as source entry storage") }
          node = node + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < values.length {
    if values[at].evaluation.index >= evaluations.length || values[at].endpoint.index >= endpoints.length {
      CompilerBug.panic(b"source value has no actual evaluation or prepared endpoint")
    }
    if let Option<ResidualSubject>.Some {value} = values[at].subject {
      if value.base.index >= values.length || value.state.index >= List<Prepared.ResidualState>.length(&preparation.residuals)
        || values[value.base.index].endpoint.index != values[at].endpoint.index {
        CompilerBug.panic(b"source residual lost its physical anchor or finite suffix")
      }
      if let Option<ResidualSubject>.Some {..} = values[value.base.index].subject {
        CompilerBug.panic(b"source residual recursively extended another virtual anchor")
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < leaves.length {
    if leaves[at].endpoint.index >= endpoints.length { CompilerBug.panic(b"source leaf has no prepared endpoint") }
    let valid = match &leaves[at].kind {
      SourceLeaf.Entry {local} => local.index < preparation.body.locals.length
      SourceLeaf.Borrow {node: Option<NodeId>.Some {value}, ..} => value.index < nodes.length
      SourceLeaf.Borrow {node: Option<NodeId>.None, ..} => true
      SourceLeaf.Expression {node} => node.index < nodes.length
      SourceLeaf.LoanFree {node} => node.index < nodes.length
      SourceLeaf.Unknown {node: Option<NodeId>.Some {value}, ..} => value.index < nodes.length
      SourceLeaf.Unknown {node: Option<NodeId>.None, ..} => true
    }
    if !valid { CompilerBug.panic(b"source leaf names an absent body origin") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < seeds.length {
    let seed = seeds[at]
    if seed.value.index >= values.length || seed.leaf.index >= leaves.length {
      CompilerBug.panic(b"source seed has no reserved value or leaf")
    }
    if values[seed.value.index].phase != ValuePhase.Output { CompilerBug.panic(b"a source seed cannot bypass a real read") }
    if let Option<ResidualSubject>.Some {..} = values[seed.value.index].subject { CompilerBug.panic(b"a selected suffix must derive from actual source evidence") }
    if values[seed.value.index].endpoint.index != leaves[seed.leaf.index].endpoint.index {
      CompilerBug.panic(b"source seed bypasses its physical placement map")
    }
    if let SourceLeaf.Entry {local} = &leaves[seed.leaf.index].kind {
      let actual = evaluations[values[seed.value.index].evaluation.index]
      let valid = match actual.site {
        EvaluationSite.Entry {local: bound} => bound.index == local.index
        _ => false
      }
      if !valid { CompilerBug.panic(b"caller source seed did not originate in actual entry storage") }
    }
    at = at + usize.ONE
  }
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  let routes = List<ContractRoute>.asSlice(&preparation.routes)
  at = usize.ZERO
  while at < transfers.length {
    let transfer = &transfers[at]
    if transfer.source.index >= values.length || transfer.target.index >= values.length {
      CompilerBug.panic(b"source transfer has no reserved physical value")
    }
    let source = values[transfer.source.index].endpoint
    let target = values[transfer.target.index].endpoint
    match transfer.authority {
      TransferAuthority.RetainedWrite {candidate} => {
        if candidate >= writes.length || writes[candidate].source.index != transfer.source.index
          || writes[candidate].target.index != transfer.target.index || transfer.policy != TransferPolicy.Filtered
          || transfer.terminal || transfer.directness != Directness.Indirect {
          CompilerBug.panic(b"retained write changed its actual candidate or publication policy")
        }
      }
      TransferAuthority.Address {edge, direction} => {
        validateAddressTransfer(values, aliases, aliasEdges, aliasTransports, transfer.source, transfer.target, edge, direction)
      }
      TransferAuthority.OperationResult {candidate, position} => {
        Results.validateCandidate(preparation, candidate)
        let placement = run Results.outputPlacement(preparation, candidate)
        let valid = match &placement.suffix {
          Results.PlacementSuffix.Whole => match position { Option<Results.Position>.None => true _ => false }
          Results.PlacementSuffix.Selected {targets, ..} => {
            let targets = List<Results.Position>.asSlice(&targets)
            let mut found = false
            let mut each = usize.ZERO
            if let Option<Results.Position>.Some {value} = position {
              while each < targets.length {
                if Results.samePosition(value, targets[each]) { found = true }
                each = each + usize.ONE
              }
            }
            found
          }
        }
        if !valid { CompilerBug.panic(b"operation result lost its exact root/current placement") }
        if source.index != candidate.source.index || target.index != candidate.target.index
          || values[transfer.source.index].evaluation.index != candidate.operand.index
          || values[transfer.target.index].evaluation.index != candidate.result.index {
          CompilerBug.panic(b"operation result lost its actual input/output occurrences")
        }
        let subject = values[transfer.target.index].subject
        match candidate.continuation {
          Option<Prepared.ContractContinuationId>.Some {value} => {
            let state = List<Prepared.ContractContinuation>.asSlice(&preparation.contractContinuations)[value.index].outputState
            let exact = match subject { Option<ResidualSubject>.Some {value: actual} => actual.state.index == state.index && sameResultPosition(actual.position, position) _ => false }
            if !exact { CompilerBug.panic(b"result continuation was substituted for its whole output anchor") }
          }
          Option<Prepared.ContractContinuationId>.None => {
            if let Option<ResidualSubject>.Some {..} = subject { CompilerBug.panic(b"whole result invented a residual subject") }
          }
        }
      }
      _ => {
        match authorityMap(transfer.authority) {
          Option<MapId>.Some {value} => {
            if value.index >= maps.length { CompilerBug.panic(b"source transfer has no prepared physical map") }
            let physical = &maps[value.index]
            let forward = authorityDirection(transfer.authority) == MapDirection.Forward
            let mut matches = physical.source.index == source.index && physical.target.index == target.index
            if !forward { matches = physical.target.index == source.index && physical.source.index == target.index }
            if !matches { CompilerBug.panic(b"source transfer does not follow its prepared physical endpoints") }
            match authorityAddress(transfer.authority) {
              Option<EvalId>.Some {value: address} => validateAddressMap(endpoints, maps, aliases, aliasEdges, value, address)
              Option<EvalId>.None => {
                if !forward || physical.addressTransport { CompilerBug.panic(b"source address map has no actual storage-identity evidence") }
              }
            }
          }
          Option<MapId>.None => {
            if source.index != target.index { CompilerBug.panic(b"distinct source endpoints require a prepared map") }
            if authorityDirection(transfer.authority) != MapDirection.Forward { CompilerBug.panic(b"unmapped source transfer cannot invert an address") }
            if let Option<EvalId>.Some {..} = authorityAddress(transfer.authority) { CompilerBug.panic(b"address evidence requires its actual map") }
          }
        }
        if let Option<ContractRouteId>.Some {value} = authorityContract(transfer.authority) {
          if value.index >= routes.length { CompilerBug.panic(b"source transfer has no original contract route") }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Frozen residual rows are not source witnesses. Validate the paired finite automaton before
// following any actual value edge, including unreachable ones: a same-shaped sibling must not
// be substituted for the producer's recorded continuation, and descendants are not new roots.
fn residualAccess(shape: &Prepared.Shape) -> Option<ReferenceAccess> {
  return Shared<Type>.with<Option<ReferenceAccess>>(&shape.ty, fn(ty: &Type) -> Option<ReferenceAccess> {
    return match &ty.* {
      Type.Reference {access, ..} => Option<ReferenceAccess>.some(access)
      Type.Slice {access, ..} => Option<ReferenceAccess>.some(access)
      Type.Pointer {access, ..} => Option<ReferenceAccess>.some(access)
      _ => Option<ReferenceAccess>.none()
    }
  })
}

fn sameResidualAccess(left: Option<ReferenceAccess>, right: Option<ReferenceAccess>) -> bool {
  return match left {
    Option<ReferenceAccess>.Some {value} => match right { Option<ReferenceAccess>.Some {value: other} => value == other _ => false }
    Option<ReferenceAccess>.None => match right { Option<ReferenceAccess>.None => true _ => false }
  }
}

fn residualComponent(shapes: &[Prepared.Shape], id: Prepared.ComponentId) -> &Prepared.Component {
  if id.shape.index >= shapes.length { return CompilerBug.panic(b"residual component has no frozen parent shape") }
  let components = List<Prepared.Component>.asSlice(&shapes[id.shape.index].components)
  if id.ordinal >= components.length { return CompilerBug.panic(b"residual component has no exact parent row") }
  return &components[id.ordinal]
}

fn sameResidualComponent(left: Prepared.ComponentId, right: Prepared.ComponentId) -> bool {
  return left.shape.index == right.shape.index && left.ordinal == right.ordinal
}

fn containsResidual(ids: &[Prepared.ResidualStateId], id: Prepared.ResidualStateId) -> bool {
  let mut at = usize.ZERO
  while at < ids.length {
    if ids[at].index == id.index { return true }
    at = at + usize.ONE
  }
  return false
}

fn authoredResidual(state: &Prepared.ResidualState) -> bool {
  return match state.authority { Prepared.ResidualAuthority.Authored => true _ => false }
}

fn sameOptionalResidual(left: &Option<Prepared.ResidualStateId>, right: &Option<Prepared.ResidualStateId>) -> bool {
  return match &left.* {
    Option<Prepared.ResidualStateId>.Some {value} => match &right.* {
      Option<Prepared.ResidualStateId>.Some {value: other} => value.index == other.index
      _ => false
    }
    Option<Prepared.ResidualStateId>.None => match &right.* { Option<Prepared.ResidualStateId>.None => true _ => false }
  }
}

// These states retain original contract components under one exact prepared transformation.
// Normalization-away Variant prefixes are not authored selectors or physical alias evidence.
fn validateContractResidual<'body>(prepared: &SourcePreparation<'body>, state: &Prepared.ResidualState,
  projection: Prepared.ContractProjectionId, terminal: bool) -> () {
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  if projection.index >= List<Prepared.ContractProjection>.length(&prepared.contractProjections)
    || state.selection.index >= selections.length || state.vertex.index >= endpoints.length || state.output.index >= shapes.length {
    CompilerBug.panic(b"contract residual is outside its projection domain")
  }
  let component = residualComponent(shapes, state.input)
  let accepted = List<EndpointId>.asSlice(&selections[state.selection.index].accepts)
  let mut accepts = false
  let mut each = usize.ZERO
  while each < accepted.length {
    if accepted[each].index == state.vertex.index { accepts = true }
    each = each + usize.ONE
  }
  if terminal {
    let variant = match &component.selector { Selector.Variant {..} => true _ => false }
    let authoredVariant = match &endpoints[state.vertex.index].selector { Selector.Variant {..} => true _ => false }
    if state.accepts != accepts || (!sameSelector(&component.selector, &endpoints[state.vertex.index].selector)
      && !(variant && authoredVariant)) {
      CompilerBug.panic(b"contract terminal changed its authored selector or acceptance")
    }
  } else {
    let variant = match &component.selector { Selector.Variant {..} => true _ => false }
    if !variant || state.accepts { CompilerBug.panic(b"normalization prefix is not a nonaccepting original variant") }
  }
  let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
  each = usize.ZERO
  while each < next.length {
    if next[each].index >= states.length { CompilerBug.panic(b"contract residual names an absent continuation") }
    let child = &states[next[each].index]
    let exact = match child.authority {
      Prepared.ResidualAuthority.Contract {projection: actual, ..} => actual.index == projection.index
      _ => false
    }
    if !exact || child.selection.index != state.selection.index || child.input.shape.index != state.output.index {
      CompilerBug.panic(b"contract residual changed projection, selection or component chain")
    }
    each = each + usize.ONE
  }
  return ()
}

// Authored states preserve the exact finite selector graph. Contract normalization has a
// different authority and must not relax these physical/address selector invariants.
fn validateAuthoredResidual(shapes: &[Prepared.Shape], endpoints: &[Endpoint],
  selections: &[Selection], maps: &[SelectionMap], states: &[Prepared.ResidualState],
  state: &Prepared.ResidualState) -> () {
  if !authoredResidual(state) { CompilerBug.panic(b"physical residual has contract normalization authority") }
  if state.selection.index >= selections.length || state.vertex.index >= endpoints.length || state.output.index >= shapes.length {
    CompilerBug.panic(b"residual state is outside its frozen selection domain")
  }
  let component = residualComponent(shapes, state.input)
  if !sameSelector(&component.selector, &endpoints[state.vertex.index].selector) {
    CompilerBug.panic(b"residual state changed its original selector vertex")
  }
  let selection = &selections[state.selection.index]
  let accepted = List<EndpointId>.asSlice(&selection.accepts)
  let mut accepts = false
  let mut each = usize.ZERO
  while each < accepted.length {
    if accepted[each].index == state.vertex.index { accepts = true }
    each = each + usize.ONE
  }
  if accepts != state.accepts { CompilerBug.panic(b"residual acceptance changed the original selection frontier") }
  let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
  let edges = List<MapId>.asSlice(&selection.maps)
  each = usize.ZERO
  while each < next.length {
    if next[each].index >= states.length { CompilerBug.panic(b"residual continuation is outside its finite domain") }
    let child = &states[next[each].index]
    if !authoredResidual(child) || child.selection.index != state.selection.index || child.input.shape.index != state.output.index {
      CompilerBug.panic(b"residual continuation changed selection or component output")
    }
    let mut found = false
    let mut edge = usize.ZERO
    while edge < edges.length {
      if edges[edge].index >= maps.length { CompilerBug.panic(b"residual selection names an absent map") }
      let physical = &maps[edges[edge].index]
      if physical.kind == MapKind.Select && physical.source.index == state.vertex.index
        && physical.target.index == child.vertex.index { found = true }
      edge = edge + usize.ONE
    }
    if !found { CompilerBug.panic(b"residual continuation has no original selector edge") }
    each = each + usize.ONE
  }
  if !state.accepts && next.length == usize.ZERO { CompilerBug.panic(b"residual selection lost every accepting continuation") }
  return ()
}

fn sameShapeContext(left: Prepared.ShapeContext, right: Prepared.ShapeContext) -> bool {
  return match left {
    Prepared.ShapeContext.Body => match right { Prepared.ShapeContext.Body => true _ => false }
    Prepared.ShapeContext.Retention {retention} => match right {
      Prepared.ShapeContext.Retention {retention: other} => retention.index == other.index
      _ => false
    }
    Prepared.ShapeContext.Application {application, space} => match right {
      Prepared.ShapeContext.Application {application: other, space: otherSpace} => application.index == other.index && space == otherSpace
      _ => false
    }
  }
}

// Semantic owns tracked type application and channel selection. The graph authenticates
// the retained original premise/context, never reapplies bindings or promotes opaque storage.
fn validateShapeContexts<'body>(prepared: &SourcePreparation<'body>) -> () {
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let applications = List<Prepared.Application>.asSlice(&prepared.applications)
  let evidence = List<Prepared.Representation>.asSlice(&prepared.representations)
  let mut at = usize.ZERO
  while at < evidence.length {
    let row = &evidence[at]
    let mut constraints = prepared.body.constraints
    if let Prepared.ShapeContext.Application {application, ..} = row.context {
      if application.index >= applications.length { CompilerBug.panic(b"representation premise has an absent application") }
      constraints = List<Constraint>.asSlice(&applications[application.index].constraints)
    }
    if let Prepared.ShapeContext.Retention {retention} = row.context {
      let retained = List<Prepared.Retention>.asSlice(&prepared.retentions)
      if retention.index >= retained.length { CompilerBug.panic(b"representation premise has an absent retained stage") }
      constraints = List<Constraint>.asSlice(&retained[retention.index].constraints)
    }
    if row.ordinal >= constraints.length { CompilerBug.panic(b"representation premise has no original constraint ordinal") }
    let represented = match &constraints[row.ordinal] { Constraint.Represents {..} => true _ => false }
    if !represented { CompilerBug.panic(b"channel evidence reclassified another constraint as Represents") }
    let mut prior = usize.ZERO
    while prior < at {
      if evidence[prior].ordinal == row.ordinal && sameShapeContext(evidence[prior].context, row.context) {
        CompilerBug.panic(b"representation premise was duplicated within one application space")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < shapes.length {
    let shape = &shapes[at]
    if let Prepared.ShapeContext.Application {application, ..} = shape.context {
      if application.index >= applications.length { CompilerBug.panic(b"shape context has an absent application") }
    }
    if let Prepared.ShapeContext.Retention {retention} = shape.context {
      if retention.index >= List<Prepared.Retention>.length(&prepared.retentions) {
        CompilerBug.panic(b"shape context has an absent retained parameter stage")
      }
    }
    let components = List<Prepared.Component>.asSlice(&shape.components)
    let mut child = usize.ZERO
    while child < components.length {
      let component = &components[child]
      if let Option<Prepared.RepresentationId>.Some {value} = component.representation {
        if value.index >= evidence.length || !sameShapeContext(evidence[value.index].context, shape.context)
          || component.inline || !channelSelector(&component.selector) {
          CompilerBug.panic(b"declared channel evidence leaked into storage or another premise context")
        }
      }
      child = child + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < endpoints.length {
    let endpoint = &endpoints[at]
    if endpoint.shape.index >= shapes.length { CompilerBug.panic(b"prepared endpoint has an absent contextual shape") }
    let expected = match &endpoint.root {
      Root.Application {application, space, ..} => Prepared.ShapeContext.Application {application: application, space: space}
      Root.Retention {retention, ..} => Prepared.ShapeContext.Retention {retention: retention}
      _ => Prepared.ShapeContext.Body
    }
    if !sameShapeContext(shapes[endpoint.shape.index].context, expected) {
      CompilerBug.panic(b"prepared endpoint imported another declaration's shape premises")
    }
    at = at + usize.ONE
  }
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  at = usize.ZERO
  while at < states.length {
    if states[at].input.shape.index >= shapes.length || states[at].output.index >= shapes.length
      || !sameShapeContext(shapes[states[at].input.shape.index].context, shapes[states[at].output.index].context) {
      CompilerBug.panic(b"residual output changed its exact parent premise context")
    }
    at = at + usize.ONE
  }
  return ()
}

fn channelSelector(selector: &Selector) -> bool {
  return match &selector.* { Selector.EffectSuccess => true Selector.EffectFailure => true _ => false }
}

fn validateResiduals<'body>(prepared: &SourcePreparation<'body>) -> () {
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let pairs = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let substitutions = List<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)
  let mut at = usize.ZERO
  while at < states.length {
    match states[at].authority {
      Prepared.ResidualAuthority.Authored => validateAuthoredResidual(shapes, endpoints, selections, maps, states, &states[at])
      Prepared.ResidualAuthority.Contract {projection, terminal} => {
        validateContractResidual(prepared, &states[at], projection, terminal)
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < pairs.length {
    let pair = &pairs[at]
    if pair.map.index >= maps.length || pair.sourceState.index >= states.length || pair.targetState.index >= states.length
      || pair.substitution.index >= substitutions.length { CompilerBug.panic(b"residual pair is outside its frozen domain") }
    let physical = &maps[pair.map.index]
    if physical.source.index >= endpoints.length || physical.target.index >= endpoints.length {
      CompilerBug.panic(b"residual transport lost its physical endpoints")
    }
    let physicalAuthority = physical.componentTransport && !physical.addressTransport
      && (physical.kind == MapKind.Copy || physical.kind == MapKind.Place)
      && pair.authority == Prepared.BoundaryAuthority.Physical
    let sourceStorage = match move endpointRole(&endpoints[physical.source.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
    let targetStorage = match move endpointRole(&endpoints[physical.target.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
    let aliasAuthority = physical.addressTransport && !physical.componentTransport && physical.kind == MapKind.Select
      && sourceStorage && targetStorage && pair.authority == Prepared.BoundaryAuthority.StorageAlias
    if (!physicalAuthority && !aliasAuthority) || !sameSelector(&physical.selector, &Selector.Identity) {
      CompilerBug.panic(b"residual pair lacks its exact physical or storage-alias authority")
    }
    let source = &states[pair.sourceState.index]
    let target = &states[pair.targetState.index]
    if !authoredResidual(source) || !authoredResidual(target) {
      CompilerBug.panic(b"physical or storage-alias pair used contract normalization")
    }
    if !sameResidualComponent(pair.source, source.input) || !sameResidualComponent(pair.target, target.input)
      || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
      || source.accepts != target.accepts {
      CompilerBug.panic(b"residual pair combines different selector histories")
    }
    let left = residualComponent(shapes, pair.source)
    let right = residualComponent(shapes, pair.target)
    if channelSelector(&left.selector) || !sameSelector(&left.selector, &right.selector)
      || !sameResidualAccess(pair.sourceAccess, residualAccess(&shapes[pair.source.shape.index]))
      || !sameResidualAccess(pair.targetAccess, residualAccess(&shapes[pair.target.shape.index])) {
      CompilerBug.panic(b"residual pair lost its component or descriptor access evidence")
    }
    let substitution = &substitutions[pair.substitution.index]
    if substitution.source.index != source.output.index || substitution.target.index != target.output.index {
      CompilerBug.panic(b"residual substitution must describe component outputs, not parent descriptors")
    }
    let sourceNext = List<Prepared.ResidualStateId>.asSlice(&source.next)
    let targetNext = List<Prepared.ResidualStateId>.asSlice(&target.next)
    let next = List<Prepared.BoundaryTransitionId>.asSlice(&pair.next)
    let stops = List<Prepared.BoundaryStop>.asSlice(&pair.stops)
    if next.length + stops.length != sourceNext.length || next.length + stops.length != targetNext.length {
      CompilerBug.panic(b"residual pair omitted or multiplied a continuation")
    }
    let mut each = usize.ZERO
    while each < next.length {
      if next[each].index >= pairs.length { CompilerBug.panic(b"residual pair has an absent continuation") }
      let child = &pairs[next[each].index]
      if child.map.index != pair.map.index || child.authority != pair.authority || !containsResidual(sourceNext, child.sourceState)
        || !containsResidual(targetNext, child.targetState) {
        CompilerBug.panic(b"residual continuation does not follow both sides of the same map")
      }
      // A child is already an explicitly paired transition, not a Cartesian combination of
      // otherwise valid source/target successors. Each side must occur exactly once here.
      let mut earlier = usize.ZERO
      while earlier < each {
        let prior = &pairs[next[earlier].index]
        if prior.sourceState.index == child.sourceState.index || prior.targetState.index == child.targetState.index {
          CompilerBug.panic(b"residual pairing duplicated one side of a continuation")
        }
        earlier = earlier + usize.ONE
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < stops.length {
      let stop = &stops[each]
      if !containsResidual(sourceNext, stop.sourceState) || !containsResidual(targetNext, stop.targetState)
        || stop.sourceState.index >= states.length || stop.targetState.index >= states.length {
        CompilerBug.panic(b"channel stop lost one side of its physical parent continuation")
      }
      let sourceStop = &states[stop.sourceState.index]
      let targetStop = &states[stop.targetState.index]
      let sourceChannel = residualComponent(shapes, sourceStop.input)
      let targetChannel = residualComponent(shapes, targetStop.input)
      if !authoredResidual(sourceStop) || !authoredResidual(targetStop)
        || sourceStop.selection.index != targetStop.selection.index || sourceStop.vertex.index != targetStop.vertex.index
        || sourceStop.accepts != targetStop.accepts || !channelSelector(&sourceChannel.selector)
        || !sameSelector(&sourceChannel.selector, &targetChannel.selector) {
        CompilerBug.panic(b"channel stop cross-paired histories or acquired physical component authority")
      }
      // This partition records an obligation to compose the selected descriptor's original
      // contract. It provides neither a physical transition nor a source acceptance witness.
      let mut earlier = usize.ZERO
      while earlier < next.length {
        let prior = &pairs[next[earlier].index]
        if prior.sourceState.index == stop.sourceState.index || prior.targetState.index == stop.targetState.index {
          CompilerBug.panic(b"channel stop duplicated a physical continuation")
        }
        earlier = earlier + usize.ONE
      }
      earlier = usize.ZERO
      while earlier < each {
        if stops[earlier].sourceState.index == stop.sourceState.index || stops[earlier].targetState.index == stop.targetState.index {
          CompilerBug.panic(b"channel stop duplicated one side of a continuation")
        }
        earlier = earlier + usize.ONE
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < maps.length {
    let physical = &maps[at]
    let roots = List<Prepared.BoundaryTransitionId>.asSlice(&physical.boundaries)
    let mut each = usize.ZERO
    while each < roots.length {
      if roots[each].index >= pairs.length || physical.source.index >= endpoints.length || physical.target.index >= endpoints.length {
        CompilerBug.panic(b"residual root has no physical map endpoints")
      }
      let root = &pairs[roots[each].index]
      if root.map.index != at || root.source.shape.index != endpoints[physical.source.index].shape.index
        || root.target.shape.index != endpoints[physical.target.index].shape.index {
        CompilerBug.panic(b"residual root is not anchored at its actual transport endpoints")
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn boundaryLiftStates(lift: &Prepared.BoundaryLift, pairs: &[Prepared.BoundaryTransition]) -> Prepared.BoundaryStop {
  return match &lift.step {
    Prepared.BoundaryLiftStep.Transition {id} => {
      if id.index >= pairs.length { return CompilerBug.panic(b"output lift has no frozen continuation") }
      Prepared.BoundaryStop {sourceState: pairs[id.index].sourceState, targetState: pairs[id.index].targetState}
    }
    Prepared.BoundaryLiftStep.Stop {sourceState, targetState} => {
      Prepared.BoundaryStop {sourceState: sourceState, targetState: targetState}
    }
  }
}

fn validateBoundaryLifts<'body>(prepared: &SourcePreparation<'body>) -> () {
  let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
  let pairs = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let substitutions = List<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)
  let mut at = usize.ZERO
  while at < lifts.length {
    let lift = &lifts[at]
    if lift.boundary.index >= pairs.length { CompilerBug.panic(b"output lift has no prior boundary authority") }
    let prior = &pairs[lift.boundary.index]
    match lift.direction {
      Prepared.BoundaryLiftDirection.Forward => ()
      Prepared.BoundaryLiftDirection.StorageAliasInverse => {
        if prior.authority != Prepared.BoundaryAuthority.StorageAlias {
          CompilerBug.panic(b"inverse storage lift has no storage-alias authority")
        }
      }
      Prepared.BoundaryLiftDirection.OriginInverse => {
        let map = &List<SelectionMap>.asSlice(&prepared.maps)[prior.map.index]
        let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
        let descriptor = match &shapes[endpoints[map.source.index].shape.index].state {
          Prepared.ShapeState.Reference => match &shapes[endpoints[map.target.index].shape.index].state {
            Prepared.ShapeState.Reference => true _ => false
          }
          Prepared.ShapeState.Slice => match &shapes[endpoints[map.target.index].shape.index].state {
            Prepared.ShapeState.Slice => true _ => false
          }
          _ => false
        }
        if prior.authority != Prepared.BoundaryAuthority.Physical || !map.componentTransport
          || map.addressTransport || (map.kind != MapKind.Copy && map.kind != MapKind.Place)
          || !sameSelector(&map.selector, &Selector.Identity) || !descriptor {
          CompilerBug.panic(b"inverse origin lift is not an actual reference/slice descriptor transport")
        }
        // The row reserves correspondence only. A consumer must separately retain the
        // actual composite Address proof; this never licenses Physical StorageInverse.
      }
    }
    let substitution = &substitutions[prior.substitution.index]
    let selected = boundaryLiftStates(lift, pairs)
    if selected.sourceState.index >= states.length || selected.targetState.index >= states.length {
      CompilerBug.panic(b"output lift has no paired authored suffix")
    }
    let source = &states[selected.sourceState.index]
    let target = &states[selected.targetState.index]
    if !authoredResidual(source) || !authoredResidual(target)
      || source.input.shape.index != substitution.source.index || target.input.shape.index != substitution.target.index
      || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
      || source.accepts != target.accepts {
      CompilerBug.panic(b"output lift changed prior output shapes or paired selector history")
    }
    let left = residualComponent(shapes, source.input)
    let right = residualComponent(shapes, target.input)
    if !sameSelector(&left.selector, &right.selector) { CompilerBug.panic(b"output lift cross-paired component selectors") }
    match &lift.step {
      Prepared.BoundaryLiftStep.Transition {id} => {
        let child = &pairs[id.index]
        if child.map.index != prior.map.index || child.authority != prior.authority || channelSelector(&left.selector) {
          CompilerBug.panic(b"output lift substituted a map or made a channel physical")
        }
        // This row supplies its root authority. map.boundaries remains anchored to actual
        // endpoint shapes; this continuation must not be used as one of those roots.
      }
      Prepared.BoundaryLiftStep.Stop {..} => {
        if !channelSelector(&left.selector) { CompilerBug.panic(b"output lift stopped an ordinary physical component") }
      }
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if lifts[earlier].boundary.index == lift.boundary.index && lifts[earlier].direction == lift.direction {
        let other = boundaryLiftStates(&lifts[earlier], pairs)
        let duplicate = match lift.direction {
          Prepared.BoundaryLiftDirection.Forward => other.targetState.index == selected.targetState.index
          _ => other.sourceState.index == selected.sourceState.index
        }
        if duplicate { CompilerBug.panic(b"output lift duplicated one directed suffix interpretation") }
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Checks frozen correspondence only. Predicate admission and exact type substitution were
// established by tracked preparation; this walk neither reapplies bindings nor proves a goal.
fn contractEndpoint(endpoints: &[Endpoint], endpoint: EndpointId, application: ApplicationId,
  space: Prepared.TypeSpace) -> bool {
  if endpoint.index >= endpoints.length { return false }
  return match &endpoints[endpoint.index].root {
    Root.Application {application: actual, space: actualSpace, ..} => actual.index == application.index && actualSpace == space
    _ => false
  }
}

fn contractSubject<'body>(prepared: &SourcePreparation<'body>, selection: &Prepared.ContractSelection) -> ShapeId {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  if selection.output.index >= endpoints.length { return CompilerBug.panic(b"contract enumeration has no original endpoint") }
  let mut subject = endpoints[selection.output.index].shape
  if let Option<Prepared.ResidualStateId>.Some {value} = &selection.residual {
    let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
    if value.index >= states.length { return CompilerBug.panic(b"contract enumeration has no residual subject") }
    subject = states[value.index].output
  }
  if subject.index >= List<Prepared.Shape>.length(&prepared.shapes) {
    return CompilerBug.panic(b"contract enumeration has no frozen subject shape")
  }
  return subject
}

fn opaqueContractSubject<'body>(prepared: &SourcePreparation<'body>, selection: &Prepared.ContractSelection) -> bool {
  let subject = contractSubject(prepared, selection)
  return match &List<Prepared.Shape>.asSlice(&prepared.shapes)[subject.index].state {
    Prepared.ShapeState.Opaque => true
    Prepared.ShapeState.Unavailable {..} => true
    _ => false
  }
}

fn validateContractPath<'body>(prepared: &SourcePreparation<'body>, continuation: &Prepared.ContractContinuation) -> () {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let rows = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  if continuation.projection.index >= projections.length || continuation.originalSelection.index >= rows.length
    || continuation.outputState.index >= states.length {
    CompilerBug.panic(b"contract continuation has an absent authority or output")
  }
  let projection = &projections[continuation.projection.index]
  let row = &rows[continuation.originalSelection.index]
  let output = &states[continuation.outputState.index]
  if !authoredResidual(output) || continuation.original.index != projection.original.index
    || row.application.index != projection.application.index || row.output.index != continuation.original.index {
    CompilerBug.panic(b"contract continuation changed its exact original enumeration")
  }
  let path = List<Prepared.ResidualStateId>.asSlice(&continuation.originalPath)
  let mut terminal = usize.MAX
  if let Option<Prepared.ResidualStateId>.Some {value} = &continuation.originalState { terminal = value.index }
  if terminal != usize.MAX && (path.length == usize.ZERO || path[path.length - usize.ONE].index != terminal) {
    CompilerBug.panic(b"contract terminal is not the end of its original path")
  }
  let mut step = usize.ZERO
  while step < path.length {
    if path[step].index >= states.length { CompilerBug.panic(b"contract original path has an absent component") }
    let state = &states[path[step].index]
    let isTerminal = terminal == path[step].index && step + usize.ONE == path.length
    let exact = match state.authority {
      Prepared.ResidualAuthority.Contract {projection: actual, terminal: role} =>
        actual.index == continuation.projection.index && role == isTerminal
      _ => false
    }
    if !exact || state.selection.index != output.selection.index || state.vertex.index != output.vertex.index
      || (isTerminal && state.accepts != output.accepts) || (!isTerminal && state.accepts) {
      CompilerBug.panic(b"contract original path changed projection, role or authored history")
    }
    if step != usize.ZERO {
      let previous = &states[path[step - usize.ONE].index]
      if previous.output.index != state.input.shape.index
        || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&previous.next), path[step]) {
        CompilerBug.panic(b"contract original path is not an explicit contiguous component chain")
      }
    }
    step = step + usize.ONE
  }
  if path.length != usize.ZERO {
    let last = Option<Prepared.ResidualStateId>.some(path[path.length - usize.ONE])
    if !sameOptionalResidual(&row.residual, &last) {
      CompilerBug.panic(b"contract enumeration lost the exact original path subject")
    }
  }
  if terminal == usize.MAX {
    let incomplete = match &row.coverage { Prepared.ContractCoverage.Incomplete {..} => true _ => false }
    if !opaqueContractSubject(prepared, row) || !incomplete {
      CompilerBug.panic(b"projected-only suffix strengthened its original opaque subject")
    }
  }
  return ()
}

// A continuation can have several original paths for one output successor. Check coverage
// rather than a bijection: coalescing does not erase any original contributor. Opaque children
// inherit their parent's exact row, not an unrelated root or an independently applied row.
fn validateContractNext<'body>(prepared: &SourcePreparation<'body>, parent: &Prepared.ContractContinuation) -> () {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let output = &states[parent.outputState.index]
  let outputNext = List<Prepared.ResidualStateId>.asSlice(&output.next)
  let next = List<Prepared.ContractContinuationId>.asSlice(&parent.next)
  let mut each = usize.ZERO
  while each < next.length {
    if next[each].index >= continuations.length { CompilerBug.panic(b"contract continuation has an absent paired successor") }
    let child = &continuations[next[each].index]
    if child.projection.index != parent.projection.index || child.original.index != parent.original.index
      || !containsResidual(outputNext, child.outputState) {
      CompilerBug.panic(b"contract continuation changed its projection or authored successor")
    }
    let path = List<Prepared.ResidualStateId>.asSlice(&child.originalPath)
    match &parent.originalState {
      Option<Prepared.ResidualStateId>.Some {value} => {
        if path.length != usize.ZERO {
          if path[usize.ZERO].index >= states.length
            || states[path[usize.ZERO].index].input.shape.index != states[value.index].output.index
            || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[value.index].next), path[usize.ZERO]) {
            CompilerBug.panic(b"contract successor lost its original predecessor component")
          }
        } else if child.originalSelection.index != parent.originalSelection.index {
          CompilerBug.panic(b"opaque contract successor replaced its inherited original row")
        }
      }
      Option<Prepared.ResidualStateId>.None => {
        if path.length != usize.ZERO || child.originalSelection.index != parent.originalSelection.index {
          CompilerBug.panic(b"opaque contract suffix manufactured a new original component")
        }
      }
    }
    let mut prior = usize.ZERO
    while prior < each {
      if next[prior].index == next[each].index { CompilerBug.panic(b"contract successor duplicated an identical paired path") }
      prior = prior + usize.ONE
    }
    each = each + usize.ONE
  }
  each = usize.ZERO
  while each < outputNext.length {
    let mut covered = false
    let mut pair = usize.ZERO
    while pair < next.length {
      if continuations[next[pair].index].outputState.index == outputNext[each].index { covered = true }
      pair = pair + usize.ONE
    }
    if !covered { CompilerBug.panic(b"contract continuation omitted an authored output successor") }
    each = each + usize.ONE
  }
  return ()
}

fn validateContractProducts<'body>(prepared: &SourcePreparation<'body>) -> () {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let applications = List<Prepared.Application>.asSlice(&prepared.applications)
  let rows = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let routes = List<ContractRoute>.asSlice(&prepared.routes)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = &rows[at]
    if row.application.index >= applications.length
      || !contractEndpoint(endpoints, row.output, row.application, Prepared.TypeSpace.Original) {
      CompilerBug.panic(b"contract enumeration used a nonoriginal application output")
    }
    drop contractSubject(prepared, row)
    if let Option<Prepared.ResidualStateId>.Some {value} = &row.residual {
      let projection = match states[value.index].authority {
        Prepared.ResidualAuthority.Contract {projection, ..} => projection
        _ => { return CompilerBug.panic(b"original contract enumeration used an authored output subject") }
      }
      if projections[projection.index].application.index != row.application.index
        || projections[projection.index].original.index != row.output.index {
        CompilerBug.panic(b"contract enumeration residual changed its original application or ancestor")
      }
    }
    let selected = List<ContractRouteId>.asSlice(&row.routes)
    let mut each = usize.ZERO
    while each < selected.length {
      if selected[each].index >= routes.length { CompilerBug.panic(b"contract enumeration names an absent original route") }
      let route = &routes[selected[each].index]
      if route.application.index != row.application.index || route.target.index != row.output.index
        || !sameOptionalResidual(&route.targetResidual, &row.residual)
        || !contractEndpoint(endpoints, route.source, row.application, Prepared.TypeSpace.Original) {
        CompilerBug.panic(b"contract route changed the enumeration's original subject")
      }
      let links = List<MapId>.asSlice(&route.maps)
      let mut linked = false
      let mut link = usize.ZERO
      while link < links.length {
        if links[link].index >= maps.length { CompilerBug.panic(b"original contract route has an absent map") }
        let map = &maps[links[link].index]
        let exact = match &map.application { Option<ApplicationId>.Some {value} => value.index == row.application.index _ => false }
        if !exact || map.kind != MapKind.Contract || map.componentTransport || map.addressTransport
          || map.source.index >= endpoints.length || map.target.index >= endpoints.length {
          CompilerBug.panic(b"original contract route lost its exclusive application map")
        }
        if map.source.index == route.source.index && map.target.index == route.target.index { linked = true }
        link = link + usize.ONE
      }
      if !linked { CompilerBug.panic(b"original contract route lost its endpoint correspondence") }
      let premises = List<Prepared.PredicateId>.asSlice(&route.premises)
      let declared = List<Prepared.PredicateId>.asSlice(&applications[row.application.index].premises)
      let mut premise = usize.ZERO
      while premise < premises.length {
        let mut admitted = false
        let mut index = usize.ZERO
        while index < declared.length {
          if declared[index].index == premises[premise].index { admitted = true }
          index = index + usize.ONE
        }
        if !admitted || premises[premise].index >= List<Prepared.Predicate>.length(&prepared.predicates) {
          CompilerBug.panic(b"contract route substituted a foreign original premise")
        }
        premise = premise + usize.ONE
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < projections.length {
    let projection = &projections[at]
    let mut space = Prepared.TypeSpace.Applied
    if projection.stage == Prepared.ContractProjectionStage.OriginalToSelected { space = Prepared.TypeSpace.Selected }
    if projection.application.index >= applications.length
      || !contractEndpoint(endpoints, projection.original, projection.application, Prepared.TypeSpace.Original)
      || !contractEndpoint(endpoints, projection.output, projection.application, space) {
      CompilerBug.panic(b"contract projection changed its original or selected application domain")
    }
    let suffix = List<EndpointId>.asSlice(&projection.suffix)
    let mut suffixAt = usize.ZERO
    while suffixAt < suffix.length {
      if !contractEndpoint(endpoints, suffix[suffixAt], projection.application, space) {
        CompilerBug.panic(b"contract projection suffix changed its selected domain")
      }
      if suffixAt != usize.ZERO {
        let contiguous = match &endpoints[suffix[suffixAt].index].parent {
          Option<EndpointId>.Some {value} => value.index == suffix[suffixAt - usize.ONE].index
          _ => false
        }
        if !contiguous { CompilerBug.panic(b"contract projection suffix lost its explicit endpoint chain") }
      }
      suffixAt = suffixAt + usize.ONE
    }
    if suffix.length != usize.ZERO && suffix[suffix.length - usize.ONE].index != projection.output.index {
      CompilerBug.panic(b"contract projection suffix does not end at its output")
    }
    let physical = List<MapId>.asSlice(&projection.maps)
    let mut anchored = false
    let mut each = usize.ZERO
    while each < physical.length {
      if physical[each].index >= maps.length { CompilerBug.panic(b"contract projection names an absent map") }
      let map = &maps[physical[each].index]
      let exact = match &map.application { Option<ApplicationId>.Some {value} => value.index == projection.application.index _ => false }
      if !exact || map.kind != MapKind.Contract || map.componentTransport || map.addressTransport
        || map.source.index >= endpoints.length || map.target.index >= endpoints.length {
        CompilerBug.panic(b"contract projection has no exclusive application authority")
      }
      if map.source.index == projection.original.index && map.target.index == projection.output.index { anchored = true }
      each = each + usize.ONE
    }
    if !anchored { CompilerBug.panic(b"contract projection lost its exact endpoint pair") }
    let roots = List<Prepared.ContractContinuationId>.asSlice(&projection.continuations)
    each = usize.ZERO
    while each < roots.length {
      if roots[each].index >= continuations.length { CompilerBug.panic(b"contract projection has an absent continuation root") }
      let root = &continuations[roots[each].index]
      if root.projection.index != at || root.outputState.index >= states.length
        || states[root.outputState.index].input.shape.index != endpoints[projection.output.index].shape.index {
        CompilerBug.panic(b"contract continuation root changed its projected subject")
      }
      let path = List<Prepared.ResidualStateId>.asSlice(&root.originalPath)
      if path.length != usize.ZERO {
        if path[usize.ZERO].index >= states.length
          || states[path[usize.ZERO].index].input.shape.index != endpoints[projection.original.index].shape.index {
          CompilerBug.panic(b"contract continuation root changed its original subject")
        }
      } else {
        if root.originalSelection.index >= rows.length { CompilerBug.panic(b"contract root has no original enumeration") }
        if let Option<Prepared.ResidualStateId>.Some {..} = &rows[root.originalSelection.index].residual {
          CompilerBug.panic(b"nonadvancing contract root inherited an unrelated residual row")
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < continuations.length {
    validateContractPath(prepared, &continuations[at])
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < continuations.length {
    validateContractNext(prepared, &continuations[at])
    at = at + usize.ONE
  }
  return ()
}

// Reference construction is the sole authority for linking a Borrow leaf to physical
// operand storage. Equal reference types or equal regions cannot construct this record.
fn validateReferenceOrigins<'body>(prepared: &SourcePreparation<'body>, origins: &[ReferenceOrigin],
  evaluations: &[Evaluation], values: &[Value], leaves: &[Leaf]) -> () {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut at = usize.ZERO
  while at < origins.length {
    let origin = &origins[at]
    if origin.source.index >= evaluations.length || origin.descriptor.index >= values.length
      || origin.leaf.index >= leaves.length { CompilerBug.panic(b"reference origin lost its actual value occurrence") }
    validateReferenceMaps(endpoints, maps, origin.map, origin.referent)
    let descriptor = values[origin.descriptor.index]
    if descriptor.evaluation.index >= evaluations.length || descriptor.endpoint.index != maps[origin.map.index].target.index
      || leaves[origin.leaf.index].endpoint.index != descriptor.endpoint.index {
      CompilerBug.panic(b"reference origin lost its descriptor component")
    }
    let borrowed = match &leaves[origin.leaf.index].kind { SourceLeaf.Borrow {..} => true _ => false }
    if !borrowed { CompilerBug.panic(b"reference storage identity has no actual Borrow source") }
    let sourceNode = match evaluations[origin.source.index].site {
      EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"reference origin is not an actual operand evaluation") }
    }
    let source = match &endpoints[maps[origin.map.index].source.index].root {
      Root.Node {node, role} => node.index == sourceNode.index && role == EndpointRole.Storage
      _ => false
    }
    let target = match evaluations[descriptor.evaluation.index].site {
      EvaluationSite.Node {node} => node.index == maps[origin.map.index].site.index
      _ => false
    }
    if !source || !target { CompilerBug.panic(b"reference origin does not match its physical preparation site") }
    let mut earlier = usize.ZERO
    while earlier < at {
      if origins[earlier].leaf.index == origin.leaf.index || origins[earlier].descriptor.index == origin.descriptor.index {
        CompilerBug.panic(b"one reference descriptor acquired two independent storage origins")
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// A prepared Select is not sufficient: it must belong to the exact place occurrence's
// contiguous canonical address route. Referent/contract/value maps cannot be inverted here.
effect fn validateAliasGraph<'body>(prepared: &SourcePreparation<'body>, evaluations: &[Evaluation],
  aliases: &[StorageAlias], edges: &[AliasEdge], references: &[ReferenceOrigin], selections: &[SelectionUse], retained: &[RetainedRequest],
  slices: &[SliceConversion], descriptors: &DescriptorClosure) -> () ! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let mut at = usize.ZERO
  while at < aliases.length {
    let node = &aliases[at]
    if node.evaluation.index >= evaluations.length || node.endpoint.index >= endpoints.length
      || node.storage.endpoint.index >= endpoints.length {
      CompilerBug.panic(b"address proof node lost its actual occurrence or canonical component")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      let other = &aliases[earlier]
      if other.evaluation.index == node.evaluation.index && other.endpoint.index == node.endpoint.index
        && sameStorage(other.storage, node.storage) && other.write == node.write {
        CompilerBug.panic(b"address proof duplicated one finite node")
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    if edge.target >= aliases.length { CompilerBug.panic(b"address proof edge has no target node") }
    let target = aliases[edge.target]
    let mut from = target.storage.endpoint
    let mut predecessor = target
    if let Option<usize>.Some {value: source} = edge.source {
      if source >= aliases.length { CompilerBug.panic(b"address proof edge has no predecessor node") }
      predecessor = aliases[source]
      if !sameStorage(predecessor.storage, target.storage)
        || (predecessor.write == Write.Weak && target.write != Write.Weak) {
        CompilerBug.panic(b"address projection changed its owner or strengthened an inexact address")
      }
      from = predecessor.endpoint
    }
    match edge.authority {
      AliasAuthority.Project {map: id} => {
        if id.index >= maps.length { CompilerBug.panic(b"address proof has no exact prepared projection") }
        let map = &maps[id.index]
        let sourceStorage = match endpointRole(&endpoints[map.source.index]) {
          Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
        }
        let targetStorage = match endpointRole(&endpoints[map.target.index]) {
          Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
        }
        let actual = match evaluations[target.evaluation.index].site {
          EvaluationSite.Node {node} => node.index == map.site.index _ => false
        }
        if !sourceStorage || !targetStorage || !actual || map.kind != MapKind.Select
          || map.source.index != from.index || map.target.index != target.endpoint.index {
          CompilerBug.panic(b"address projection substituted a value/contract or disconnected map")
        }
      }
      AliasAuthority.Selected {selection, map} => {
        if let Option<usize>.None = edge.source { CompilerBug.panic(b"selected address lost its grounded predecessor") }
        if selection >= selections.length || map.index >= maps.length {
          CompilerBug.panic(b"selected address has no actual selection or map")
        }
        let selected = &selections[selection]
        let physical = &maps[map.index]
        let root = match selected.place { Option<MapId>.Some {value} => value
          _ => { return CompilerBug.panic(b"selected address has no place output") } }
        let family = run transferFamily(endpoints, maps, root)
        let members = List<MapId>.asSlice(&family)
        let mut found = false
        let mut each = usize.ZERO
        while each < members.length { if members[each].index == map.index { found = true } each = each + usize.ONE }
        if !found || physical.kind != MapKind.Select || physical.source.index != from.index
          || physical.target.index != target.endpoint.index || selected.operand.index != predecessor.evaluation.index
          || selected.result.index != target.evaluation.index {
          CompilerBug.panic(b"selected address changed its actual selection/output correspondence")
        }
      }
      AliasAuthority.Origin {placement: id} => {
        let placements = List<OriginPlacement>.asSlice(&descriptors.placements)
        if id >= placements.length { CompilerBug.panic(b"origin address has no retained component proof") }
        let placement = placements[id]
        let proofs = List<OriginProof>.asSlice(&descriptors.origins)
        if placement.proof >= proofs.length || placement.sourceAlias >= aliases.length
          || placement.state.index >= states.length || placement.member.index >= maps.length {
          CompilerBug.panic(b"origin address lost one of its proof coordinates")
        }
        let proof = proofs[placement.proof]
        let carrier = Carriers.Product.nodes(&descriptors.product)[proof.carrier]
        let request = descriptorUse(prepared, selections, retained, slices, descriptors, carrier.demand)
        let reference = references[proof.origin]
        let member = &maps[placement.member.index]
        let state = &states[placement.state.index]
        let exactSource = match edge.source { Option<usize>.Some {value} => value == placement.sourceAlias _ => false }
        if !exactSource || predecessor.evaluation.index != reference.source.index
          || !sameSourceComponent(endpoints, predecessor.endpoint, member.source)
          || target.evaluation.index != request.operand.index || target.endpoint.index != state.vertex.index
          || state.selection.index != request.selection.index || state.output.index != endpoints[member.target.index].shape.index {
          CompilerBug.panic(b"origin address changed source acquisition or actual selected component")
        }
        match placement.parent {
          Option<usize>.None => {
            if placement.member.index != reference.referent.index || placement.state.index != carrier.state.index {
              CompilerBug.panic(b"origin root substituted another referent family")
            }
          }
          Option<usize>.Some {value} => {
            if value >= id { CompilerBug.panic(b"origin inline component has no finite earlier parent") }
            let parent = placements[value]
            let children = List<MapId>.asSlice(&maps[parent.member.index].children)
            let mut found = false
            let mut each = usize.ZERO
            while each < children.length { if children[each].index == placement.member.index { found = true } each = each + usize.ONE }
            if !found || parent.proof != placement.proof
              || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next), placement.state) {
              CompilerBug.panic(b"origin component did not follow both exact family/selector edges")
            }
          }
        }
      }
      AliasAuthority.Slice {placement: id} => {
        let placements = List<SlicePlacement>.asSlice(&descriptors.slicePlacements)
        if id >= placements.length { CompilerBug.panic(b"slice address has no retained element proof") }
        let placement = placements[id]
        let proofs = List<SliceProof>.asSlice(&descriptors.sliceProofs)
        let origins = List<OriginPlacement>.asSlice(&descriptors.placements)
        if placement.proof >= proofs.length || placement.origin >= origins.length || placement.edge >= edges.length
          || placement.state.index >= states.length || placement.member.index >= maps.length {
          CompilerBug.panic(b"slice address lost an exact proof coordinate")
        }
        let proof = proofs[placement.proof]
        if proof.conversion >= slices.length { CompilerBug.panic(b"slice proof has no actual conversion") }
        let conversion = slices[proof.conversion]
        let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
        let elements = List<Prepared.ArraySliceElement>.asSlice(&row.elements)
        if placement.element >= elements.length { CompilerBug.panic(b"slice proof invented an element partition") }
        let element = &elements[placement.element]
        let member = &maps[placement.member.index]
        let state = &states[placement.state.index]
        let retainedEdge = edges[placement.edge]
        let exactOrigin = match retainedEdge.authority {
          AliasAuthority.Origin {placement: origin} => origin == placement.origin
          _ => false
        }
        let exactSource = match edge.source { Option<usize>.Some {value} => value == retainedEdge.target _ => false }
        let origin = origins[placement.origin]
        let originProof = List<OriginProof>.asSlice(&descriptors.origins)[origin.proof]
        let sourceDemand = Carriers.Product.nodes(&descriptors.product)[originProof.carrier].demand
        let demands = List<SliceDemand>.asSlice(&descriptors.sliceDemands)
        let mut bound = false
        let mut each = usize.ZERO
        while each < demands.length {
          if demands[each].demand == sourceDemand && demands[each].proof == placement.proof
            && demands[each].element == placement.element { bound = true }
          each = each + usize.ONE
        }
        let carrier = Carriers.Product.nodes(&descriptors.product)[proof.carrier]
        let request = descriptorUse(prepared, selections, retained, slices, descriptors, carrier.demand)
        if !exactOrigin || !exactSource || !bound || predecessor.evaluation.index != conversion.source.index
          || predecessor.endpoint.index != member.source.index || target.evaluation.index != request.operand.index
          || target.endpoint.index != state.vertex.index || state.selection.index != request.selection.index
          || state.output.index != endpoints[member.target.index].shape.index
          || states[origin.state.index].selection.index != element.selection.index {
          CompilerBug.panic(b"slice address crossed conversion, element or actual descriptor histories")
        }
        let extent = match &prepared.body.nodes[row.site.index].kind {
          NodeKind.Expression {form: Expression.ArraySlice {count, ..}, ..} => count
          _ => { return CompilerBug.panic(b"slice address lost its actual extent") }
        }
        if extent == usize.ZERO || (extent != usize.ONE && target.write != Write.Weak) {
          CompilerBug.panic(b"slice address strengthened a multi-element or impossible selection")
        }
        match placement.parent {
          Option<usize>.None => {
            if placement.member.index != element.value.index || placement.state.index != carrier.state.index {
              CompilerBug.panic(b"slice root changed its explicit conversion element family")
            }
          }
          Option<usize>.Some {value} => {
            if value >= id { CompilerBug.panic(b"slice inline placement lost its finite parent") }
            let parent = placements[value]
            let children = List<MapId>.asSlice(&maps[parent.member.index].children)
            let mut found = false
            each = usize.ZERO
            while each < children.length { if children[each].index == placement.member.index { found = true } each = each + usize.ONE }
            if !found || parent.proof != placement.proof || parent.element != placement.element
              || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next), placement.state) {
              CompilerBug.panic(b"slice continuation did not follow both exact family and selector edges")
            }
          }
        }
      }
      AliasAuthority.Canonical => {
        if let Option<usize>.Some {..} = edge.source { CompilerBug.panic(b"canonical address seed cannot have a predecessor") }
        if target.endpoint.index != target.storage.endpoint.index {
          CompilerBug.panic(b"a canonical address seed cannot change physical components")
        }
        match target.storage.temporary {
          Option<EvalId>.Some {value} => {
            if value.index != target.evaluation.index { CompilerBug.panic(b"temporary address lost its acquisition identity") }
          }
          Option<EvalId>.None => CompilerBug.panic(b"local address seed requires its actual local-to-view map")
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Contents use a proof edge only inside one actual read/write's private address lane.
// This does not equate the descriptor's Value and Storage roles or create a new map.
fn validateAddressTransfer(values: &[Value], aliases: &[StorageAlias], edges: &[AliasEdge],
  requests: &[AliasTransport], source: ValueId, target: ValueId, id: usize, direction: MapDirection) -> () {
  if id >= edges.length { CompilerBug.panic(b"contents transfer has no composite address edge") }
  let edge = edges[id]
  let previous = match edge.source { Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"composite contents transfer has no address predecessor") } }
  match edge.authority {
    AliasAuthority.Selected {..} => ()
    AliasAuthority.Origin {..} => ()
    AliasAuthority.Slice {..} => ()
    _ => CompilerBug.panic(b"ordinary address map cannot impersonate a composite origin")
  }
  let mut before = values[source.index]
  let mut after = values[target.index]
  if direction == MapDirection.StorageInverse { before = values[target.index] after = values[source.index] }
  let left = match before.transport { Option<AliasPort>.Some {value} => value
    _ => { return CompilerBug.panic(b"composite current contents lost its private source lane") } }
  let right = match after.transport { Option<AliasPort>.Some {value} => value
    _ => { return CompilerBug.panic(b"composite current contents lost its private target lane") } }
  if left.request != right.request || left.alias != previous || right.alias != edge.target
    || left.request >= requests.length || before.evaluation.index != requests[left.request].evaluation.index
    || after.evaluation.index != before.evaluation.index || before.endpoint.index != aliases[previous].endpoint.index
    || after.endpoint.index != aliases[edge.target].endpoint.index {
    CompilerBug.panic(b"composite current contents crossed address histories or use points")
  }
  return ()
}

fn validateAliasPorts(values: &[Value], aliases: &[StorageAlias], requests: &[AliasTransport]) -> () {
  let mut at = usize.ZERO
  while at < values.length {
    let value = values[at]
    match value.transport {
      Option<AliasPort>.Some {value: port} => {
        if port.request >= requests.length || port.alias >= aliases.length {
          CompilerBug.panic(b"address transport port lost its exact use or proof node")
        }
        let request = requests[port.request]
        if request.alias >= aliases.length || value.phase != ValuePhase.Transport
          || value.evaluation.index != request.evaluation.index || value.endpoint.index != aliases[port.alias].endpoint.index
          || !sameStorage(aliases[port.alias].storage, aliases[request.alias].storage) {
          CompilerBug.panic(b"address transport port crossed uses or canonical owners")
        }
        if let Option<ResidualSubject>.Some {..} = value.subject {
          CompilerBug.panic(b"address transport cannot masquerade as a selected result")
        }
      }
      Option<AliasPort>.None => {
        if value.phase == ValuePhase.Transport { CompilerBug.panic(b"address transport has no proof identity") }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn validateAddressMap(endpoints: &[Endpoint], maps: &[SelectionMap], aliases: &[StorageAlias],
  edges: &[AliasEdge], map: MapId, address: EvalId) -> () {
  let physical = &maps[map.index]
  let source = match move endpointRole(&endpoints[physical.source.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
  let target = match move endpointRole(&endpoints[physical.target.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
  if physical.kind != MapKind.Select || !source || !target { CompilerBug.panic(b"value/contract boundary is not storage identity") }
  let mut at = usize.ZERO
  while at < edges.length {
    if let Option<MapId>.Some {value} = aliasMap(edges[at].authority) {
      if value.index == map.index && aliases[edges[at].target].evaluation.index == address.index { return () }
    }
    at = at + usize.ONE
  }
  CompilerBug.panic(b"source address transport has no actual alias edge")
}

effect fn reserveCell(keys: &mut List<CellKey>, cells: &mut List<Cell>, rules: &mut Program, key: CellKey) -> usize
! OutOfMemoryError ? &mut Allocator {
  let existing = findCell(List<CellKey>.asSlice(&keys.*), key.value, key.leaf, key.witness, key.direct)
  if existing != usize.MAX { return existing }
  let at = List<CellKey>.length(&keys.*)
  let present = Program.atom(&mut rules.*)
  let stored = Program.atom(&mut rules.*)
  let alternatives = Program.atom(&mut rules.*)
  run List<Cell>.append(&mut cells.*, Cell {present: present, stored: stored, alternatives: alternatives})
  run List<CellKey>.append(&mut keys.*, key)
  return at
}

/// A discharged descriptor seed still records the whole proof. Its source alias identifies
/// address formation; contents must subsequently be read at the demanding use, not here.
struct OriginProof {
  carrier: usize
  seed: usize
  origin: usize
  sourceAlias: usize
  active: Atom
}
impl Copy for OriginProof {}

// Actual conversions are occurrence-qualified. The descriptor transport creates no loan;
// these coordinates let a later Index demand stop at the exact conversion Case and ask
// for the original borrowed array's current address through its authored source history.
struct SliceConversion {
  prepared: usize
  source: EvalId
  descriptor: ValueId
}
impl Copy for SliceConversion {}
struct SliceProof {
  carrier: usize
  case: usize
  conversion: usize
  active: Atom
}
impl Copy for SliceProof {}
struct SliceDemand {
  demand: usize
  proof: usize
  element: usize
}
impl Copy for SliceDemand {}
struct SlicePlacement {
  proof: usize
  element: usize
  parent: Option<usize>
  origin: usize
  edge: usize
  member: MapId
  state: Prepared.ResidualStateId
}
impl Copy for SlicePlacement {}

struct DescriptorUse {
  operand: EvalId
  result: EvalId
  selection: PreparedSelectionId
  strength: Write
}
impl Copy for DescriptorUse {}

// Both request tables are frozen before reservation. Demand.selectionUse addresses the
// ordinary table followed by the retained table; supplemental Slice demands retain that
// original request coordinate and never allocate a new request for a proof generation.
fn descriptorUse<'body>(prepared: &SourcePreparation<'body>, selections: &[SelectionUse], retained: &[RetainedRequest], slices: &[SliceConversion],
  closure: &DescriptorClosure, demand: usize) -> DescriptorUse {
  let actual = List<Carriers.Demand>.asSlice(&closure.demands)[demand]
  let use = match actual.selectionUse < selections.length {
    true => {
      let selected = &selections[actual.selectionUse]
      DescriptorUse {operand: selected.operand, result: selected.result, selection: selected.selection, strength: selected.strength}
    }
    false => {
      let index = actual.selectionUse - selections.length
      if index >= retained.length { return CompilerBug.panic(b"descriptor demand lost its explicit retained request") }
      let selected = &retained[index]
      DescriptorUse {operand: selected.execution, result: selected.execution, selection: selected.selection, strength: Write.Weak}
    }
  }
  let sources = List<SliceDemand>.asSlice(&closure.sliceDemands)
  let mut at = usize.ZERO
  while at < sources.length {
    if sources[at].demand == demand {
      let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[sources[at].proof]
      let conversion = slices[proof.conversion]
      let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
      let element = &List<Prepared.ArraySliceElement>.asSlice(&row.elements)[sources[at].element]
      return DescriptorUse {operand: conversion.source, result: use.result, selection: element.selection, strength: Write.Strong}
    }
    at = at + usize.ONE
  }
  return use
}

/// One inline member of a discharged referent. parent records the exact prepared-family
/// child and residual next edge; no expanded history/path is stored or inferred by type.
struct OriginPlacement {
  proof: usize
  parent: Option<usize>
  member: MapId
  state: Prepared.ResidualStateId
  sourceAlias: usize
  active: Atom
}
impl Copy for OriginPlacement {}

// Replaying an address formation at its selected OUTPUT is a different product from
// carrying the outer descriptor. The latter supplies the actual cases and frozen cursors;
// these nodes transport a later, independently authored suffix through that same proof.
// In particular, an outer Borrow leaf never stands in for the current contents' leaf.
struct ContentsNode {
  edge: usize
  target: Prepared.ResidualStateId
  carrier: usize
  state: Prepared.ResidualStateId
  active: Atom
  identity: Atom
}
impl Copy for ContentsNode {}

union ContentsLift {
  Publication,
  OutputIdentity {cursor: Carriers.BoundaryCursor},
  Next {cursor: Carriers.BoundaryCursor, next: Prepared.BoundaryTransitionId},
  Prepared {cursor: Carriers.BoundaryCursor, lift: usize},
  CompositeIdentity {pair: usize, sourceSubject: Prepared.ResidualStateId, targetSubject: Prepared.ResidualStateId},
  Composite {pair: usize, sourceSubject: Prepared.ResidualStateId, targetSubject: Prepared.ResidualStateId, result: usize},
}
impl Copy for ContentsLift {}

struct ContentsStep {
  later: usize
  earlier: usize
  carrier: usize
  lift: ContentsLift
}
impl Copy for ContentsStep {}

union ContentsAuthority {
  Selected {map: MapId},
  Origin {node: usize, referent: Prepared.BoundaryTransitionId},
  Slice {node: usize, element: Prepared.BoundaryTransitionId},
}
impl Copy for ContentsAuthority {}

// Both address legs retain their own actual Case. A Slice terminal stops at the
// conversion descriptor and crosses only its exact element.value member; the preceding
// Origin address remains a separate current-read transport, never a contents snapshot.
struct ContentsPlacement {
  carrier: usize
  state: Prepared.ResidualStateId
  member: MapId
}
impl Copy for ContentsPlacement {}

fn contentsPlacement(closure: &DescriptorClosure, authority: AliasAuthority) -> Option<ContentsPlacement> {
  return match authority {
    AliasAuthority.Origin {placement: id} => {
      let placement = List<OriginPlacement>.asSlice(&closure.placements)[id]
      let proof = List<OriginProof>.asSlice(&closure.origins)[placement.proof]
      Option<ContentsPlacement>.some(ContentsPlacement {carrier: proof.carrier, state: placement.state, member: placement.member})
    }
    AliasAuthority.Slice {placement: id} => {
      let placement = List<SlicePlacement>.asSlice(&closure.slicePlacements)[id]
      let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[placement.proof]
      Option<ContentsPlacement>.some(ContentsPlacement {carrier: proof.carrier, state: placement.state, member: placement.member})
    }
    _ => Option<ContentsPlacement>.none()
  }
}

fn contentsTerminal(authority: ContentsAuthority) -> usize {
  return match authority {
    ContentsAuthority.Origin {node, ..} => node
    ContentsAuthority.Slice {node, ..} => node
    _ => CompilerBug.panic(b"selected identity has no original contents graph")
  }
}

fn contentsBoundary(authority: ContentsAuthority) -> Prepared.BoundaryTransitionId {
  return match authority {
    ContentsAuthority.Origin {referent, ..} => referent
    ContentsAuthority.Slice {element, ..} => element
    _ => CompilerBug.panic(b"selected identity has no contents discharge boundary")
  }
}

// One proof per actual contents Case and derivation. identity is a separately grounded
// assertion about the translated selector's complete OUTPUT, not equality of loan IDs or
// input shapes. It permits a subsequent independent query to cross a composite identity.
struct ContentsProof {
  case: usize
  edge: usize
  source: Prepared.ResidualStateId
  target: Prepared.ResidualStateId
  authority: ContentsAuthority
  active: Atom
  identity: Atom
}
impl Copy for ContentsProof {}

// Replay requests name the existing actual Case/Origin authority. ContentsProof's key is
// bounded by actual case/alias edge, frozen states, original ContentsNode and discharge pair;
// replay nodes are NEVER used as ContentsProof.authority. No generation enters this key.
struct ContentsReplay {
  proof: usize
  source: Prepared.ResidualStateId
  target: Prepared.ResidualStateId
  state: Prepared.ResidualStateId
  reverse: bool
  root: usize
}
impl Copy for ContentsReplay {}
union ContentsReplayPoint { Source, Target, Original {node: usize} }
impl Copy for ContentsReplayPoint {}
struct ContentsReplayNode {
  request: usize
  proof: usize
  point: ContentsReplayPoint
  subject: Prepared.ResidualStateId
  state: Prepared.ResidualStateId
}
impl Copy for ContentsReplayNode {}
union ContentsReplayPosition {
  Start,
  Original {node: usize},
  Expanded {expansion: usize, node: usize},
  Done,
}
impl Copy for ContentsReplayPosition {}
// Membership has its own gates. Two histories sharing a normalized physical point cannot
// activate one another's traversal cursor merely because their point/state keys coincide.
struct ContentsReplayCursor {
  node: usize
  position: ContentsReplayPosition
  active: Atom
  identity: Atom
}
impl Copy for ContentsReplayCursor {}
struct ContentsReplayArc {
  later: usize
  earlier: usize
  boundary: Option<Prepared.BoundaryTransitionId>
  reverse: bool
  active: Atom
}
impl Copy for ContentsReplayArc {}
union ContentsReplayWitness {
  Root,
  Step {step: usize},
  Discharge {proof: usize},
  Arc {arc: usize},
  Enter {expansion: usize},
  Leave {expansion: usize},
}
impl Copy for ContentsReplayWitness {}
struct ContentsReplayLink {
  arc: usize
  source: usize
  target: usize
  witness: ContentsReplayWitness
  selected: Option<Prepared.BoundaryTransitionId>
  lift: Option<usize>
}
impl Copy for ContentsReplayLink {}
struct ContentsReplayExpansion {
  source: usize
  step: usize
  result: usize
  reverse: bool
  finish: usize
  continuation: usize
  subject: Prepared.ResidualStateId
}
impl Copy for ContentsReplayExpansion {}
struct ContentsReplayResult {request: usize, cursor: usize}
impl Copy for ContentsReplayResult {}
struct ContentsReplayProjection {
  state: Prepared.ResidualStateId
  selected: Option<Prepared.BoundaryTransitionId>
  boundary: Option<Prepared.BoundaryTransitionId>
  lift: Option<usize>
  identity: bool
}
impl Copy for ContentsReplayProjection {}

fn sameTemporary(left: Option<EvalId>, right: Option<EvalId>) -> bool {
  return match left {
    Option<EvalId>.None => match right { Option<EvalId>.None => true _ => false }
    Option<EvalId>.Some {value} => match right { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
  }
}

// Compare paths only inside two already authenticated component trees. This never chooses
// a canonical owner: both roots come from the same discharged source-alias proof.
fn sameComponentSuffix(endpoints: &[Endpoint], left: EndpointId, leftRoot: EndpointId,
  right: EndpointId, rightRoot: EndpointId) -> bool {
  let mut a = left
  let mut b = right
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if a.index == leftRoot.index || b.index == rightRoot.index {
      return a.index == leftRoot.index && b.index == rightRoot.index
    }
    if a.index >= endpoints.length || b.index >= endpoints.length
      || !sameSelector(&endpoints[a.index].selector, &endpoints[b.index].selector) { return false }
    a = match endpoints[a.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    b = match endpoints[b.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"origin component correspondence is cyclic")
}

effect fn reserveOriginPlacement<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, proof: usize, parent: Option<usize>, member: MapId,
  state: Prepared.ResidualStateId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let evidence = List<OriginProof>.asSlice(&closure.origins)[proof]
  let origin = List<ReferenceOrigin>.asSlice(&skeleton.references)[evidence.origin]
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let physical = &maps[member.index]
  let selected = &states[state.index]
  let sourceRoot = List<StorageAlias>.asSlice(&skeleton.aliases)[evidence.sourceAlias]
  let carrier = Carriers.Product.nodes(&closure.product)[evidence.carrier]
  let request = descriptorUse(prepared, List<SelectionUse>.asSlice(&skeleton.selections),
    List<RetainedRequest>.asSlice(&skeleton.retainedRequests), List<SliceConversion>.asSlice(&skeleton.slices), &closure.*, carrier.demand)
  let evaluation = request.operand
  let strength = request.strength
  let selection = request.selection
  if !authoredResidual(selected) || selected.selection.index != selection.index
    || physical.target.index >= endpoints.length || selected.output.index != endpoints[physical.target.index].shape.index {
    return CompilerBug.panic(b"origin placement changed its exact residual/member subject")
  }
  // vertex is used only in its ORIGINAL SelectionUse component tree, never under an
  // operation-result anchor. That distinction is the purpose of the retained demand.
  let selectedRoot = List<Selection>.asSlice(&prepared.selections)[selection.index].root
  if !componentWithin(endpoints, selected.vertex, selectedRoot) {
    return CompilerBug.panic(b"origin placement escaped the actual authored selection")
  }
  let count = List<StorageAlias>.length(&skeleton.aliases)
  let mut changed = false
  let mut alias = usize.ZERO
  while alias < count {
    let actual = List<StorageAlias>.asSlice(&skeleton.aliases)[alias]
    if actual.evaluation.index == origin.source.index && sameSourceComponent(endpoints, actual.endpoint, physical.source)
      && sameTemporary(actual.storage.temporary, sourceRoot.storage.temporary)
      && sameComponentSuffix(endpoints, actual.storage.endpoint, sourceRoot.storage.endpoint,
        actual.endpoint, maps[origin.map.index].source) {
      let prior = List<OriginPlacement>.asSlice(&closure.placements)
      let mut found = false
      let mut each = usize.ZERO
      while each < prior.length {
        if prior[each].proof == proof && prior[each].member.index == member.index
          && prior[each].state.index == state.index && prior[each].sourceAlias == alias { found = true }
        each = each + usize.ONE
      }
      if !found {
        let active = run addressApplies(&mut skeleton.rules, evidence.active, actual.active)
        let placement = List<OriginPlacement>.length(&closure.placements)
        run List<OriginPlacement>.append(&mut closure.placements, OriginPlacement {proof: proof,
          parent: parent, member: member, state: state, sourceAlias: alias, active: active})
        let mut write = strength
        if actual.write == Write.Weak { write = Write.Weak }
        let target = run Skeleton.aliasNode(&mut skeleton.*, evaluation, selected.vertex, actual.storage, write)
        run Skeleton.aliasEdge(&mut skeleton.*, Option<usize>.some(alias), target,
          AliasAuthority.Origin {placement: placement}, active)
        changed = true
      }
    }
    alias = alias + usize.ONE
  }
  return changed
}

effect fn activateOriginPlacements<'body>(closure: &mut DescriptorClosure,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton) -> bool ! OutOfMemoryError ? &mut Allocator {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let origins = List<OriginProof>.length(&closure.origins)
  let mut changed = false
  let mut proof = usize.ZERO
  while proof < origins {
    let evidence = List<OriginProof>.asSlice(&closure.origins)[proof]
    let origin = List<ReferenceOrigin>.asSlice(&skeleton.references)[evidence.origin]
    let state = Carriers.Product.nodes(&closure.product)[evidence.carrier].state
    if run reserveOriginPlacement(&mut closure.*, prepared, &mut skeleton.*, proof,
      Option<usize>.none(), origin.referent, state) { changed = true }
    proof = proof + usize.ONE
  }
  let mut at = usize.ZERO
  while at < List<OriginPlacement>.length(&closure.placements) {
    let parent = List<OriginPlacement>.asSlice(&closure.placements)[at]
    let next = List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next)
    let children = List<MapId>.asSlice(&maps[parent.member.index].children)
    let mut step = usize.ZERO
    while step < next.length {
      let state = &states[next[step].index]
      if state.input.shape.index != endpoints[maps[parent.member.index].target.index].shape.index {
        return CompilerBug.panic(b"origin inline continuation left its prepared subject")
      }
      let component = &List<Prepared.Component>.asSlice(&shapes[state.input.shape.index].components)[state.input.ordinal]
      if component.inline {
        let mut member = usize.ZERO
        let mut matched = usize.ZERO
        while member < children.length {
          let actual = &maps[children[member].index]
          if sameSelector(&endpoints[actual.target.index].selector, &component.selector) {
            matched = matched + usize.ONE
            if run reserveOriginPlacement(&mut closure.*, prepared, &mut skeleton.*, parent.proof,
              Option<usize>.some(at), children[member], next[step]) { changed = true }
          }
          member = member + usize.ONE
        }
        if matched != usize.ONE { return CompilerBug.panic(b"origin continuation lacks its exact inline family member") }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  return changed
}

// This bridge changes only the interpretation of an actual canonical address. The source
// Origin edge is retained separately from the conversion's element family, so neither
// the conversion-time array contents nor another same-shaped descriptor can supply it.
effect fn reserveSlicePlacement<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, proofId: usize, elementId: usize, parent: Option<usize>, member: MapId,
  stateId: Prepared.ResidualStateId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[proofId]
  let conversion = List<SliceConversion>.asSlice(&skeleton.slices)[proof.conversion]
  let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
  let element = &List<Prepared.ArraySliceElement>.asSlice(&row.elements)[elementId]
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let physical = &maps[member.index]
  let state = &states[stateId.index]
  let node = Carriers.Product.nodes(&closure.product)[proof.carrier]
  let request = descriptorUse(prepared, List<SelectionUse>.asSlice(&skeleton.selections),
    List<RetainedRequest>.asSlice(&skeleton.retainedRequests), List<SliceConversion>.asSlice(&skeleton.slices), &closure.*, node.demand)
  if !authoredResidual(state) || state.selection.index != request.selection.index
    || state.output.index != endpoints[physical.target.index].shape.index {
    return CompilerBug.panic(b"slice element changed its exact selected output subject")
  }
  let mut sourceDemand = usize.MAX
  let demands = List<SliceDemand>.asSlice(&closure.sliceDemands)
  let mut each = usize.ZERO
  while each < demands.length {
    if demands[each].proof == proofId && demands[each].element == elementId { sourceDemand = demands[each].demand }
    each = each + usize.ONE
  }
  if sourceDemand == usize.MAX { return CompilerBug.panic(b"slice element has no exact source reference demand") }
  let count = match &prepared.body.nodes[row.site.index].kind {
    NodeKind.Expression {form: Expression.ArraySlice {count, ..}, ..} => count
    _ => { return CompilerBug.panic(b"slice address has no actual conversion") }
  }
  let mut changed = false
  let edgeCount = List<AliasEdge>.length(&skeleton.aliasEdges)
  let mut edgeId = usize.ZERO
  while edgeId < edgeCount {
    let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
    if let AliasAuthority.Origin {placement: originId} = edge.authority {
      let origin = List<OriginPlacement>.asSlice(&closure.placements)[originId]
      let acquisition = List<OriginProof>.asSlice(&closure.origins)[origin.proof]
      let carried = Carriers.Product.nodes(&closure.product)[acquisition.carrier]
      let source = List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
      if carried.demand == sourceDemand && source.evaluation.index == conversion.source.index
        && source.endpoint.index == physical.source.index
        && states[origin.state.index].selection.index == element.selection.index {
        let prior = List<SlicePlacement>.asSlice(&closure.slicePlacements)
        let mut found = false
        each = usize.ZERO
        while each < prior.length {
          if prior[each].proof == proofId && prior[each].element == elementId && prior[each].origin == originId
            && prior[each].member.index == member.index && prior[each].state.index == stateId.index { found = true }
          each = each + usize.ONE
        }
        if !found {
          let id = prior.length
          run List<SlicePlacement>.append(&mut closure.slicePlacements, SlicePlacement {proof: proofId,
            element: elementId, parent: parent, origin: originId, edge: edgeId, member: member, state: stateId})
          let active = run addressApplies(&mut skeleton.rules, proof.active, edge.active)
          // An unknown successful index in a one-element conversion denotes its sole
          // canonical slot. Larger conversions never turn Remainder into a strong kill.
          let mut write = Write.Weak
          if count == usize.ONE && source.write == Write.Strong { write = Write.Strong }
          let target = run Skeleton.aliasNode(&mut skeleton.*, request.operand, state.vertex, source.storage, write)
          run Skeleton.aliasEdge(&mut skeleton.*, Option<usize>.some(edge.target), target,
            AliasAuthority.Slice {placement: id}, active)
          changed = true
        }
      }
    }
    edgeId = edgeId + usize.ONE
  }
  return changed
}

effect fn activateSlicePlacements<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton) -> bool ! OutOfMemoryError ? &mut Allocator {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let count = List<SliceProof>.length(&closure.sliceProofs)
  let mut changed = false
  let mut proofId = usize.ZERO
  while proofId < count {
    let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[proofId]
    let conversion = List<SliceConversion>.asSlice(&skeleton.slices)[proof.conversion]
    let elements = List<Prepared.ArraySliceElement>.asSlice(&List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared].elements)
    let state = Carriers.Product.nodes(&closure.product)[proof.carrier].state
    let mut element = usize.ZERO
    while element < elements.length {
      if run reserveSlicePlacement(&mut closure.*, prepared, &mut skeleton.*, proofId, element,
        Option<usize>.none(), elements[element].value, state) { changed = true }
      element = element + usize.ONE
    }
    proofId = proofId + usize.ONE
  }
  let mut at = usize.ZERO
  while at < List<SlicePlacement>.length(&closure.slicePlacements) {
    let parent = List<SlicePlacement>.asSlice(&closure.slicePlacements)[at]
    let next = List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next)
    let children = List<MapId>.asSlice(&maps[parent.member.index].children)
    let mut step = usize.ZERO
    while step < next.length {
      let selected = &states[next[step].index]
      if selected.input.shape.index != endpoints[maps[parent.member.index].target.index].shape.index {
        return CompilerBug.panic(b"slice inline continuation changed the exact element output")
      }
      let component = residualComponent(shapes, selected.input)
      if component.inline {
        let mut matched = usize.ZERO
        let mut child = usize.ZERO
        while child < children.length {
          if sameSelector(&endpoints[maps[children[child].index].target.index].selector, &component.selector) {
            matched = matched + usize.ONE
            if run reserveSlicePlacement(&mut closure.*, prepared, &mut skeleton.*, parent.proof, parent.element,
              Option<usize>.some(at), children[child], next[step]) { changed = true }
          }
          child = child + usize.ONE
        }
        if matched != usize.ONE { return CompilerBug.panic(b"slice selected element has no exact inline family member") }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  return changed
}

struct RetainedMissing {request: usize, cell: usize}
impl Copy for RetainedMissing {}

struct DescriptorClosure {
  retainedMissing: List<RetainedMissing>
  product: Carriers.Product
  pairs: List<Carriers.Pair>
  demands: List<Carriers.Demand>
  origins: List<OriginProof>
  placements: List<OriginPlacement>
  sliceProofs: List<SliceProof>
  sliceDemands: List<SliceDemand>
  slicePlacements: List<SlicePlacement>
  contents: List<ContentsNode>
  contentsSteps: List<ContentsStep>
  contentsProofs: List<ContentsProof>
  contentsReplays: List<ContentsReplay>
  contentsReplayNodes: List<ContentsReplayNode>
  contentsReplayCursors: List<ContentsReplayCursor>
  contentsReplayArcs: List<ContentsReplayArc>
  contentsReplayLinks: List<ContentsReplayLink>
  contentsReplayExpansions: List<ContentsReplayExpansion>
  contentsReplayResults: List<ContentsReplayResult>
}
impl DescriptorClosure {
  fn make() -> Self {
    return DescriptorClosure {retainedMissing: List<RetainedMissing>.make(), product: Carriers.Product.make(), pairs: List<Carriers.Pair>.make(), demands: List<Carriers.Demand>.make(),
      origins: List<OriginProof>.make(), placements: List<OriginPlacement>.make(),
      sliceProofs: List<SliceProof>.make(), sliceDemands: List<SliceDemand>.make(), slicePlacements: List<SlicePlacement>.make(),
      contents: List<ContentsNode>.make(), contentsSteps: List<ContentsStep>.make(),
      contentsProofs: List<ContentsProof>.make(), contentsReplays: List<ContentsReplay>.make(),
      contentsReplayNodes: List<ContentsReplayNode>.make(), contentsReplayCursors: List<ContentsReplayCursor>.make(),
      contentsReplayArcs: List<ContentsReplayArc>.make(), contentsReplayLinks: List<ContentsReplayLink>.make(),
      contentsReplayExpansions: List<ContentsReplayExpansion>.make(), contentsReplayResults: List<ContentsReplayResult>.make()}
  }
}

fn contentsPhysicalState<'body>(prepared: &SourcePreparation<'body>, id: Prepared.ResidualStateId) -> bool {
  let state = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[id.index]
  if !authoredResidual(state) { return false }
  let shape = &List<Prepared.Shape>.asSlice(&prepared.shapes)[state.input.shape.index]
  return match &List<Prepared.Component>.asSlice(&shape.components)[state.input.ordinal].selector {
    Selector.EffectSuccess => false
    Selector.EffectFailure => false
    _ => true
  }
}

fn boundaryBefore(pair: &Prepared.BoundaryTransition, direction: Carriers.Direction) -> Prepared.ResidualStateId {
  if direction == Carriers.Direction.StorageInverse { return pair.targetState }
  return pair.sourceState
}
fn boundaryAfter(pair: &Prepared.BoundaryTransition, direction: Carriers.Direction) -> Prepared.ResidualStateId {
  if direction == Carriers.Direction.StorageInverse { return pair.sourceState }
  return pair.targetState
}
fn boundaryOutputIdentity<'body>(prepared: &SourcePreparation<'body>, id: Prepared.BoundaryTransitionId) -> bool {
  let pair = &List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)[id.index]
  let substitution = &List<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)[pair.substitution.index]
  return substitution.form == Prepared.BoundarySubstitutionForm.Identity
    && substitution.source.index == substitution.target.index
}

// Walk only declared next edges of the actual carrier state. A vertex from another query
// is never attached here by endpoint ancestry, spelling or selector/type equality.
effect fn contentsSubject<'body>(prepared: &SourcePreparation<'body>, root: Prepared.ResidualStateId,
  selected: Prepared.ResidualStateId) -> Option<Prepared.ResidualStateId>
! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let wanted = &states[selected.index]
  let mut pending = List<Prepared.ResidualStateId>.make()
  run List<Prepared.ResidualStateId>.append(&mut pending, root)
  let mut result = Option<Prepared.ResidualStateId>.none()
  let mut at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let id = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    let state = &states[id.index]
    if state.selection.index == wanted.selection.index && state.vertex.index == wanted.vertex.index {
      if let Option<Prepared.ResidualStateId>.Some {value} = result {
        if value.index != id.index { return CompilerBug.panic(b"carrier output has ambiguous authored component states") }
      }
      result = Option<Prepared.ResidualStateId>.some(id)
    }
    let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
    let mut each = usize.ZERO
    while each < next.length {
      if !containsResidual(List<Prepared.ResidualStateId>.asSlice(&pending), next[each]) {
        run List<Prepared.ResidualStateId>.append(&mut pending, next[each])
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return result
}

// A complete output identity also preserves an inline descendant. Retain the exact
// intersection of BOTH authored next graphs; equal-shaped siblings are not candidates.
// This is used only under the original composite proof's grounded identity atom.
effect fn contentsIdentityDescendant<'body>(prepared: &SourcePreparation<'body>, source: Prepared.ResidualStateId,
  target: Prepared.ResidualStateId, selected: Prepared.ResidualStateId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  if states[source.index].output.index != states[target.index].output.index { return false }
  let left = List<Prepared.ResidualStateId>.asSlice(&states[source.index].next)
  let right = List<Prepared.ResidualStateId>.asSlice(&states[target.index].next)
  let mut pending = List<Prepared.ResidualStateId>.make()
  let mut at = usize.ZERO
  while at < left.length {
    if containsResidual(right, left[at]) { run List<Prepared.ResidualStateId>.append(&mut pending, left[at]) }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let id = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    let state = &states[id.index]
    let component = residualComponent(shapes, state.input)
    if component.inline && authoredResidual(state) {
      if id.index == selected.index { return true }
      let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
      let mut each = usize.ZERO
      while each < next.length {
        if !containsResidual(List<Prepared.ResidualStateId>.asSlice(&pending), next[each]) {
          run List<Prepared.ResidualStateId>.append(&mut pending, next[each])
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn contentsNode(values: &mut List<ContentsNode>, rules: &mut Program, edge: usize,
  target: Prepared.ResidualStateId, carrier: usize, state: Prepared.ResidualStateId) -> usize
! OutOfMemoryError ? &mut Allocator {
  let nodes = List<ContentsNode>.asSlice(&values.*)
  let mut at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at]
    if node.edge == edge && node.target.index == target.index && node.carrier == carrier
      && node.state.index == state.index { return at }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut rules.*)
  let identity = Program.atom(&mut rules.*)
  run List<ContentsNode>.append(&mut values.*, ContentsNode {edge: edge, target: target,
    carrier: carrier, state: state, active: active, identity: identity})
  return at
}

fn sameContentsLift(left: ContentsLift, right: ContentsLift) -> bool {
  return match left {
    ContentsLift.Publication => match right { ContentsLift.Publication => true _ => false }
    ContentsLift.OutputIdentity {cursor} => match right {
      ContentsLift.OutputIdentity {cursor: other} => cursor.root.index == other.root.index
        && cursor.current.index == other.current.index && cursor.direction == other.direction
      _ => false
    }
    ContentsLift.Next {cursor, next} => match right {
      ContentsLift.Next {cursor: other, next: following} => cursor.root.index == other.root.index
        && cursor.current.index == other.current.index && cursor.direction == other.direction
        && next.index == following.index
      _ => false
    }
    ContentsLift.Prepared {cursor, lift} => match right {
      ContentsLift.Prepared {cursor: other, lift: otherLift} => cursor.root.index == other.root.index
        && cursor.current.index == other.current.index && cursor.direction == other.direction && lift == otherLift
      _ => false
    }
    ContentsLift.CompositeIdentity {pair, sourceSubject, targetSubject} => match right {
      ContentsLift.CompositeIdentity {pair: other, sourceSubject: otherSource, targetSubject: otherTarget} =>
        pair == other && sourceSubject.index == otherSource.index && targetSubject.index == otherTarget.index
      _ => false
    }
    ContentsLift.Composite {pair, sourceSubject, targetSubject, result} => match right {
      ContentsLift.Composite {pair: other, sourceSubject: otherSource, targetSubject: otherTarget, result: otherResult} =>
        pair == other && sourceSubject.index == otherSource.index && targetSubject.index == otherTarget.index && result == otherResult
      _ => false
    }
  }
}

effect fn contentsStep(values: &mut List<ContentsNode>, edges: &mut List<ContentsStep>, rules: &mut Program, later: usize,
  edge: usize, carrier: Carriers.Edge, state: Prepared.ResidualStateId, lift: ContentsLift, applicable: Atom,
  paired: Option<Atom>, identity: bool, identityGate: Option<Atom>) -> () ! OutOfMemoryError ? &mut Allocator {
  let node = List<ContentsNode>.asSlice(&values.*)[later]
  if node.carrier != carrier.later { return CompilerBug.panic(b"contents translation crossed carrier occurrences") }
  let earlier = run contentsNode(&mut values.*, &mut rules.*, node.edge, node.target, carrier.earlier, state)
  let steps = List<ContentsStep>.asSlice(&edges.*)
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].later == later && steps[at].earlier == earlier && steps[at].carrier == edge
      && sameContentsLift(steps[at].lift, lift) { return () }
    at = at + usize.ONE
  }
  let previous = List<ContentsNode>.asSlice(&values.*)[earlier]
  let empty = List<Atom>.make()
  let mut gates = List<Atom>.make()
  run List<Atom>.append(&mut gates, node.active)
  run List<Atom>.append(&mut gates, applicable)
  if let Option<Atom>.Some {value} = paired { run List<Atom>.append(&mut gates, value) }
  run Program.rule(&mut rules.*, previous.active, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  if let Option<Atom>.Some {value} = identityGate {
    let exact: [Atom; 3] = [node.identity, applicable, value]
    run Program.rule(&mut rules.*, previous.identity, &exact, List<Atom>.asSlice(&empty))
  }
  if identity {
    List<Atom>.asMutSlice(&mut gates)[usize.ZERO] = node.identity
    run Program.rule(&mut rules.*, previous.identity, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  }
  run List<ContentsStep>.append(&mut edges.*, ContentsStep {later: later,
    earlier: earlier, carrier: edge, lift: lift})
  return ()
}

fn sameContentsAuthority(left: ContentsAuthority, right: ContentsAuthority) -> bool {
  return match left {
    ContentsAuthority.Selected {map} => match right { ContentsAuthority.Selected {map: other} => map.index == other.index _ => false }
    ContentsAuthority.Origin {node, referent} => match right {
      ContentsAuthority.Origin {node: other, referent: otherReferent} => node == other && referent.index == otherReferent.index
      _ => false
    }
    ContentsAuthority.Slice {node, element} => match right {
      ContentsAuthority.Slice {node: other, element: otherElement} => node == other && element.index == otherElement.index
      _ => false
    }
  }
}

effect fn contentsProof<'body>(retained: &mut List<ContentsProof>, pairs: &mut List<Carriers.Pair>, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, edge: usize, before: Prepared.ResidualStateId,
  after: Prepared.ResidualStateId, authority: ContentsAuthority, gates: &[Atom], identityGates: &[Atom],
  identity: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let mut at = usize.ZERO
  while at < cases.length {
    let actual = &cases[at]
    let mut source = before
    let mut target = after
    let matches = match actual.authority {
      TransferAuthority.Address {edge: selected, direction} => {
        if direction == MapDirection.StorageInverse { source = after target = before }
        selected == edge
      }
      _ => false
    }
    if matches {
      let input = match actual.source { Option<usize>.Some {value} => value
        _ => { return CompilerBug.panic(b"contents authority appeared on a descriptor seed") } }
      if states[source.index].input.shape.index != valueShape(prepared, values[keys[input].value.index]).index
        || states[target.index].input.shape.index != valueShape(prepared, values[keys[actual.target].value.index]).index {
        return CompilerBug.panic(b"contents derivation changed its actual component shapes")
      }
      let proofs = List<ContentsProof>.asSlice(&retained.*)
      let mut found = false
      let mut prior = usize.ZERO
      while prior < proofs.length {
        let proof = proofs[prior]
        if proof.case == at && proof.edge == edge && proof.source.index == source.index
          && proof.target.index == target.index && sameContentsAuthority(proof.authority, authority) { found = true }
        prior = prior + usize.ONE
      }
      if !found {
        let proof = proofs.length
        let active = Program.atom(&mut skeleton.rules)
        let unchanged = Program.atom(&mut skeleton.rules)
        let empty = List<Atom>.make()
        run Program.rule(&mut skeleton.rules, active, gates, List<Atom>.asSlice(&empty))
        if identity { run Program.rule(&mut skeleton.rules, unchanged, identityGates, List<Atom>.asSlice(&empty)) }
        run List<ContentsProof>.append(&mut retained.*, ContentsProof {case: at, edge: edge,
          source: source, target: target, authority: authority, active: active, identity: unchanged})
        run List<Carriers.Pair>.append(&mut pairs.*, Carriers.Pair {case: at, originProof: edge,
          sourceState: source, targetState: target, proof: proof, active: active})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Output replay may select the root or represented inline descendants. Following another
// Referent/channel here would turn descriptor identity into an unauthenticated contents read.
effect fn contentsReplaySubject<'body>(prepared: &SourcePreparation<'body>, root: Prepared.ResidualStateId,
  wanted: Prepared.ResidualStateId) -> Option<Prepared.ResidualStateId> ! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let selected = &states[wanted.index]
  let mut pending = List<Prepared.ResidualStateId>.make()
  run List<Prepared.ResidualStateId>.append(&mut pending, root)
  let mut result = Option<Prepared.ResidualStateId>.none()
  let mut at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let id = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    let state = &states[id.index]
    if state.selection.index == selected.selection.index && state.vertex.index == selected.vertex.index {
      if let Option<Prepared.ResidualStateId>.Some {value} = result {
        if value.index != id.index { return CompilerBug.panic(b"contents replay has ambiguous original subject coordinates") }
      }
      result = Option<Prepared.ResidualStateId>.some(id)
    }
    let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
    let mut each = usize.ZERO
    while each < next.length {
      let child = &states[next[each].index]
      if authoredResidual(child) && residualComponent(shapes, child.input).inline
        && !containsResidual(List<Prepared.ResidualStateId>.asSlice(&pending), next[each]) {
        run List<Prepared.ResidualStateId>.append(&mut pending, next[each])
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return result
}

fn sameContentsReplayPoint(left: ContentsReplayPoint, right: ContentsReplayPoint) -> bool {
  return match left {
    ContentsReplayPoint.Source => match right { ContentsReplayPoint.Source => true _ => false }
    ContentsReplayPoint.Target => match right { ContentsReplayPoint.Target => true _ => false }
    ContentsReplayPoint.Original {node} => match right { ContentsReplayPoint.Original {node: other} => node == other _ => false }
  }
}
fn sameContentsReplayPosition(left: ContentsReplayPosition, right: ContentsReplayPosition) -> bool {
  return match left {
    ContentsReplayPosition.Start => match right { ContentsReplayPosition.Start => true _ => false }
    ContentsReplayPosition.Done => match right { ContentsReplayPosition.Done => true _ => false }
    ContentsReplayPosition.Original {node} => match right { ContentsReplayPosition.Original {node: other} => node == other _ => false }
    ContentsReplayPosition.Expanded {expansion, node} => match right {
      ContentsReplayPosition.Expanded {expansion: other, node: otherNode} => expansion == other && node == otherNode _ => false
    }
  }
}
fn sameContentsReplayBoundary(left: Option<Prepared.BoundaryTransitionId>, right: Option<Prepared.BoundaryTransitionId>) -> bool {
  return match left {
    Option<Prepared.BoundaryTransitionId>.None => match right { Option<Prepared.BoundaryTransitionId>.None => true _ => false }
    Option<Prepared.BoundaryTransitionId>.Some {value} => match right {
      Option<Prepared.BoundaryTransitionId>.Some {value: other} => value.index == other.index _ => false
    }
  }
}
fn sameContentsReplayOrdinal(left: Option<usize>, right: Option<usize>) -> bool {
  return match left {
    Option<usize>.None => match right { Option<usize>.None => true _ => false }
    Option<usize>.Some {value} => match right { Option<usize>.Some {value: other} => value == other _ => false }
  }
}
fn sameContentsReplayWitness(left: ContentsReplayWitness, right: ContentsReplayWitness) -> bool {
  return match left {
    ContentsReplayWitness.Root => match right { ContentsReplayWitness.Root => true _ => false }
    ContentsReplayWitness.Step {step} => match right { ContentsReplayWitness.Step {step: other} => step == other _ => false }
    ContentsReplayWitness.Discharge {proof} => match right { ContentsReplayWitness.Discharge {proof: other} => proof == other _ => false }
    ContentsReplayWitness.Arc {arc} => match right { ContentsReplayWitness.Arc {arc: other} => arc == other _ => false }
    ContentsReplayWitness.Enter {expansion} => match right { ContentsReplayWitness.Enter {expansion: other} => expansion == other _ => false }
    ContentsReplayWitness.Leave {expansion} => match right { ContentsReplayWitness.Leave {expansion: other} => expansion == other _ => false }
  }
}

effect fn contentsReplayNode(closure: &mut DescriptorClosure, value: ContentsReplayNode) -> usize
! OutOfMemoryError ? &mut Allocator {
  let nodes = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)
  let mut at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at]
    if node.request == value.request && node.proof == value.proof && sameContentsReplayPoint(node.point, value.point)
      && node.subject.index == value.subject.index && node.state.index == value.state.index { return at }
    at = at + usize.ONE
  }
  let result = nodes.length
  run List<ContentsReplayNode>.append(&mut closure.contentsReplayNodes, value)
  return result
}
effect fn contentsReplayCursor(closure: &mut DescriptorClosure, rules: &mut Program,
  node: usize, position: ContentsReplayPosition) -> usize ! OutOfMemoryError ? &mut Allocator {
  let cursors = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)
  let mut at = usize.ZERO
  while at < cursors.length {
    if cursors[at].node == node && sameContentsReplayPosition(cursors[at].position, position) { return at }
    at = at + usize.ONE
  }
  let result = cursors.length
  let active = Program.atom(&mut rules.*)
  let identity = Program.atom(&mut rules.*)
  run List<ContentsReplayCursor>.append(&mut closure.contentsReplayCursors,
    ContentsReplayCursor {node: node, position: position, active: active, identity: identity})
  return result
}

// Each primitive arc retains every membership/proof contributor as a separate link. Arc
// identity is finite and contains no previous replay arc/node identity. Links may form cycles.
effect fn contentsReplayAdvance(closure: &mut DescriptorClosure, rules: &mut Program, source: usize,
  node: ContentsReplayNode, position: ContentsReplayPosition, projection: ContentsReplayProjection,
  reverse: bool, witness: ContentsReplayWitness, guard: Atom, paired: Option<Atom>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let from = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[source]
  let targetNode = run contentsReplayNode(&mut closure.*, node)
  let target = run contentsReplayCursor(&mut closure.*, &mut rules.*, targetNode, position)
  let arcs = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)
  let mut arc = usize.MAX
  let mut at = usize.ZERO
  while at < arcs.length {
    if arcs[at].later == from.node && arcs[at].earlier == targetNode && arcs[at].reverse == reverse
      && sameContentsReplayBoundary(arcs[at].boundary, projection.boundary) { arc = at }
    at = at + usize.ONE
  }
  if arc == usize.MAX {
    arc = arcs.length
    let active = Program.atom(&mut rules.*)
    run List<ContentsReplayArc>.append(&mut closure.contentsReplayArcs,
      ContentsReplayArc {later: from.node, earlier: targetNode, boundary: projection.boundary, reverse: reverse, active: active})
  }
  let links = List<ContentsReplayLink>.asSlice(&closure.contentsReplayLinks)
  at = usize.ZERO
  while at < links.length {
    let link = links[at]
    if link.arc == arc && link.source == source && link.target == target && sameContentsReplayWitness(link.witness, witness)
      && sameContentsReplayBoundary(link.selected, projection.selected) && sameContentsReplayOrdinal(link.lift, projection.lift) { return () }
    at = at + usize.ONE
  }
  let to = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[target]
  let mut gates = List<Atom>.make()
  run List<Atom>.append(&mut gates, from.active)
  run List<Atom>.append(&mut gates, guard)
  if let Option<Atom>.Some {value} = paired { run List<Atom>.append(&mut gates, value) }
  let empty = List<Atom>.make()
  run Program.rule(&mut rules.*, to.active, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  run Program.rule(&mut rules.*, List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)[arc].active,
    List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  if projection.identity {
    List<Atom>.asMutSlice(&mut gates)[usize.ZERO] = from.identity
    run Program.rule(&mut rules.*, to.identity, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  }
  run List<ContentsReplayLink>.append(&mut closure.contentsReplayLinks, ContentsReplayLink {
    arc: arc, source: source, target: target, witness: witness, selected: projection.selected, lift: projection.lift})
  return ()
}
fn contentsReplayIdentity(state: Prepared.ResidualStateId) -> ContentsReplayProjection {
  return ContentsReplayProjection {state: state, selected: Option<Prepared.BoundaryTransitionId>.none(),
    boundary: Option<Prepared.BoundaryTransitionId>.none(), lift: Option<usize>.none(), identity: true}
}
fn contentsReplayBefore(pair: &Prepared.BoundaryTransition, reverse: bool) -> Prepared.ResidualStateId {
  if reverse { return pair.targetState }
  return pair.sourceState
}
fn contentsReplayAfter(pair: &Prepared.BoundaryTransition, reverse: bool) -> Prepared.ResidualStateId {
  if reverse { return pair.sourceState }
  return pair.targetState
}

// This helper is called only while replaying an exact actual composite Address proof.
// Reverse reads of retained pairs are internal proof composition, never Physical inverse
// Cases. An independently authored reverse suffix still requires its direction-qualified row.
effect fn contentsReplayProjections<'body>(prepared: &SourcePreparation<'body>, root: Prepared.BoundaryTransitionId,
  before: Prepared.ResidualStateId, after: Prepared.ResidualStateId, state: Prepared.ResidualStateId,
  reverse: bool) -> List<ContentsReplayProjection> ! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let pairs = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
  let mut result = List<ContentsReplayProjection>.make()
  let mut pending = List<Prepared.BoundaryTransitionId>.make()
  run List<Prepared.BoundaryTransitionId>.append(&mut pending, root)
  let mut at = usize.ZERO
  while at < List<Prepared.BoundaryTransitionId>.length(&pending) {
    let id = List<Prepared.BoundaryTransitionId>.asSlice(&pending)[at]
    let pair = &pairs[id.index]
    let next = List<Prepared.BoundaryTransitionId>.asSlice(&pair.next)
    if contentsReplayBefore(pair, reverse).index == before.index && contentsReplayAfter(pair, reverse).index == after.index {
      if states[state.index].input.shape.index != states[after.index].output.index || !contentsPhysicalState(prepared, state) {
        return CompilerBug.panic(b"composite replay lost its exact later authored suffix")
      }
      if boundaryOutputIdentity(prepared, id) {
        let mut identity = contentsReplayIdentity(state)
        identity.selected = Option<Prepared.BoundaryTransitionId>.some(id)
        run List<ContentsReplayProjection>.append(&mut result, identity)
      }
      let mut each = usize.ZERO
      while each < next.length {
        let child = &pairs[next[each].index]
        if contentsReplayAfter(child, reverse).index == state.index && contentsPhysicalState(prepared, contentsReplayBefore(child, reverse)) {
          run List<ContentsReplayProjection>.append(&mut result, ContentsReplayProjection {
            state: contentsReplayBefore(child, reverse), selected: Option<Prepared.BoundaryTransitionId>.some(id),
            boundary: Option<Prepared.BoundaryTransitionId>.some(next[each]), lift: Option<usize>.none(),
            identity: boundaryOutputIdentity(prepared, next[each])})
        }
        each = each + usize.ONE
      }
      each = usize.ZERO
      while each < lifts.length {
        let direction = match lifts[each].direction {
          Prepared.BoundaryLiftDirection.Forward => !reverse
          Prepared.BoundaryLiftDirection.StorageAliasInverse => reverse && pair.authority == Prepared.BoundaryAuthority.StorageAlias
          Prepared.BoundaryLiftDirection.OriginInverse => reverse && pair.authority == Prepared.BoundaryAuthority.Physical
        }
        if lifts[each].boundary.index == id.index && direction {
          if let Prepared.BoundaryLiftStep.Transition {id: child} = &lifts[each].step {
            if contentsReplayAfter(&pairs[child.index], reverse).index == state.index {
              run List<ContentsReplayProjection>.append(&mut result, ContentsReplayProjection {
                state: contentsReplayBefore(&pairs[child.index], reverse), selected: Option<Prepared.BoundaryTransitionId>.some(id),
                boundary: Option<Prepared.BoundaryTransitionId>.some(child), lift: Option<usize>.some(each),
                identity: boundaryOutputIdentity(prepared, child)})
            }
          }
        }
        each = each + usize.ONE
      }
    }
    let mut each = usize.ZERO
    while each < next.length {
      let child = &pairs[next[each].index]
      if residualComponent(shapes, states[child.sourceState.index].input).inline
        && residualComponent(shapes, states[child.targetState.index].input).inline {
        let ids = List<Prepared.BoundaryTransitionId>.asSlice(&pending)
        let mut found = false
        let mut prior = usize.ZERO
        while prior < ids.length { if ids[prior].index == next[each].index { found = true } prior = prior + usize.ONE }
        if !found { run List<Prepared.BoundaryTransitionId>.append(&mut pending, next[each]) }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return move result
}

effect fn contentsReplayRequest(closure: &mut DescriptorClosure, skeleton: &mut Skeleton, domain: &Domain,
  proof: usize, source: Prepared.ResidualStateId, target: Prepared.ResidualStateId, state: Prepared.ResidualStateId) -> usize
! OutOfMemoryError ? &mut Allocator {
  let listed = List<ContentsReplay>.asSlice(&closure.contentsReplays)
  let mut at = usize.ZERO
  while at < listed.length {
    let request = listed[at]
    if request.proof == proof && request.source.index == source.index && request.target.index == target.index
      && request.state.index == state.index { return at }
    at = at + usize.ONE
  }
  let id = listed.length
  let original = List<ContentsProof>.asSlice(&closure.contentsProofs)[proof]
  let actual = &List<Case>.asSlice(&domain.cases)[original.case]
  let reverse = match actual.authority {
    TransferAuthority.Address {edge, direction} => {
      if edge != original.edge { return CompilerBug.panic(b"composite replay changed its actual address proof") }
      direction == MapDirection.StorageInverse
    }
    _ => { return CompilerBug.panic(b"composite replay has no actual address case") }
  }
  let mut point = ContentsReplayPoint.Target
  if reverse { point = ContentsReplayPoint.Source }
  let root = run contentsReplayNode(&mut closure.*, ContentsReplayNode {
    request: id, proof: proof, point: point, subject: target, state: state})
  let cursor = run contentsReplayCursor(&mut closure.*, &mut skeleton.rules, root, ContentsReplayPosition.Start)
  let initial = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[cursor]
  let gates: [Atom; 2] = [original.active, actual.active]
  let empty = List<Atom>.make()
  run Program.rule(&mut skeleton.rules, initial.active, &gates, List<Atom>.asSlice(&empty))
  run Program.rule(&mut skeleton.rules, initial.identity, &gates, List<Atom>.asSlice(&empty))
  run List<ContentsReplay>.append(&mut closure.contentsReplays, ContentsReplay {
    proof: proof, source: source, target: target, state: state, reverse: reverse, root: root})
  return id
}

effect fn contentsReplayRoot(closure: &DescriptorClosure, proof: ContentsProof) -> usize
! OutOfMemoryError ? &mut Allocator {
  let terminal = contentsTerminal(proof.authority)
  let nodes = List<ContentsNode>.asSlice(&closure.contents)
  let terminalNode = nodes[terminal]
  let carrier = Carriers.Product.nodes(&closure.product)[terminalNode.carrier]
  let demand = List<Carriers.Demand>.asSlice(&closure.demands)[carrier.demand]
  let carriers = Carriers.Product.nodes(&closure.product)
  let mut at = usize.ZERO
  let mut result = usize.MAX
  while at < nodes.length {
    let node = nodes[at]
    let actual = carriers[node.carrier]
    if node.edge == terminalNode.edge && node.target.index == terminalNode.target.index && node.state.index == terminalNode.target.index
      && actual.demand == carrier.demand && actual.cell == demand.cell && actual.state.index == demand.state.index {
      if result != usize.MAX { return CompilerBug.panic(b"composite replay has ambiguous original roots") }
      result = at
    }
    at = at + usize.ONE
  }
  if result == usize.MAX { return CompilerBug.panic(b"composite replay omitted its original root") }
  return result
}

effect fn contentsReplayTransport<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  rules: &mut Program, source: usize, destination: ContentsReplayNode, position: ContentsReplayPosition,
  boundary: Option<Prepared.BoundaryTransitionId>, reverse: bool, witness: ContentsReplayWitness,
  guard: Atom, paired: Option<Atom>) -> () ! OutOfMemoryError ? &mut Allocator {
  let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[source]
  let node = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
  let mut projections = List<ContentsReplayProjection>.make()
  match boundary {
    Option<Prepared.BoundaryTransitionId>.Some {value} => {
      projections = move run contentsReplayProjections(prepared, value, destination.subject, node.subject, node.state, reverse)
    }
    Option<Prepared.BoundaryTransitionId>.None => {
      // The caller supplies an actual complete identity witness/connector, not shape equality.
      if destination.subject.index != node.subject.index {
        return CompilerBug.panic(b"composite identity replay changed its exact selected subject")
      }
      run List<ContentsReplayProjection>.append(&mut projections, contentsReplayIdentity(node.state))
    }
  }
  let values = List<ContentsReplayProjection>.asSlice(&projections)
  let mut at = usize.ZERO
  while at < values.length {
    let mut target = destination
    target.state = values[at].state
    run contentsReplayAdvance(&mut closure.*, &mut rules.*, source, target, position, values[at], reverse, witness, guard, paired)
    at = at + usize.ONE
  }
  return ()
}

effect fn contentsReplayExpand(closure: &mut DescriptorClosure, rules: &mut Program, source: usize,
  step: usize, result: usize, reverse: bool, continuation: usize, subject: Prepared.ResidualStateId,
  guard: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[source]
  let current = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
  let completed = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)[result]
  let prior = List<ContentsReplay>.asSlice(&closure.contentsReplays)[completed.request]
  let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
  let mut start = prior.root
  let mut finish = end.node
  if reverse { start = end.node finish = prior.root }
  let values = List<ContentsReplayExpansion>.asSlice(&closure.contentsReplayExpansions)
  let mut expansion = usize.MAX
  let mut at = usize.ZERO
  while at < values.length {
    let value = values[at]
    if value.source == source && value.step == step && value.result == result && value.reverse == reverse
      && value.finish == finish && value.continuation == continuation && value.subject.index == subject.index { expansion = at }
    at = at + usize.ONE
  }
  if expansion == usize.MAX {
    expansion = values.length
    run List<ContentsReplayExpansion>.append(&mut closure.contentsReplayExpansions, ContentsReplayExpansion {
      source: source, step: step, result: result, reverse: reverse, finish: finish, continuation: continuation, subject: subject})
  }
  let old = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[start]
  let target = ContentsReplayNode {request: current.request, proof: old.proof,
    point: old.point, subject: current.subject, state: current.state}
  run contentsReplayAdvance(&mut closure.*, &mut rules.*, source, target,
    ContentsReplayPosition.Expanded {expansion: expansion, node: start}, contentsReplayIdentity(current.state), false,
    ContentsReplayWitness.Enter {expansion: expansion}, guard, Option<Atom>.some(end.active))
  return ()
}

// Replay nodes are normalized to original proof/point coordinates. Expansion cursors retain
// exact old graph membership separately; no node key contains an earlier replay node. All
// arcs are primitive paired transports or authenticated identity connectors, so projecting
// a previously projected graph needs no recursive path/authority representation.
effect fn closeContentsReplays<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let oldNodes = List<ContentsReplayNode>.length(&closure.contentsReplayNodes)
  let oldCursors = List<ContentsReplayCursor>.length(&closure.contentsReplayCursors)
  let oldLinks = List<ContentsReplayLink>.length(&closure.contentsReplayLinks)
  let oldResults = List<ContentsReplayResult>.length(&closure.contentsReplayResults)
  let actualCases = List<Case>.asSlice(&domain.cases)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let mut at = usize.ZERO
  while at < List<ContentsReplayCursor>.length(&closure.contentsReplayCursors) {
    let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[at]
    let node = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
    let request = List<ContentsReplay>.asSlice(&closure.contentsReplays)[node.request]
    let proof = List<ContentsProof>.asSlice(&closure.contentsProofs)[request.proof]
    if !contentsPhysicalState(prepared, node.state)
      || states[node.state.index].input.shape.index != states[node.subject.index].output.index {
      return CompilerBug.panic(b"contents replay lost its authored output subject")
    }
    match cursor.position {
      ContentsReplayPosition.Done => {
        let values = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)
        let mut found = false
        let mut each = usize.ZERO
        while each < values.length { if values[each].request == node.request && values[each].cursor == at { found = true } each = each + usize.ONE }
        if !found { run List<ContentsReplayResult>.append(&mut closure.contentsReplayResults, ContentsReplayResult {request: node.request, cursor: at}) }
      }
      ContentsReplayPosition.Start => {
        match proof.authority {
          ContentsAuthority.Selected {..} => {
            let mut destination = node
            destination.subject = request.source
            destination.point = ContentsReplayPoint.Source
            if request.reverse { destination.point = ContentsReplayPoint.Target }
            run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
              ContentsReplayPosition.Done, Option<Prepared.BoundaryTransitionId>.none(), false,
              ContentsReplayWitness.Root, proof.identity, Option<Atom>.none())
          }
          _ => {
            let terminal = contentsTerminal(proof.authority)
            let mut original = terminal
            if !request.reverse { original = run contentsReplayRoot(&closure.*, proof) }
            let old = List<ContentsNode>.asSlice(&closure.contents)[original]
            let subject = match move run contentsReplaySubject(prepared, old.state, node.subject) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"contents replay root lost its original selected subject") }
            }
            let destination = ContentsReplayNode {request: node.request, proof: request.proof,
              point: ContentsReplayPoint.Original {node: original}, subject: subject, state: node.state}
            let mut boundary = Option<Prepared.BoundaryTransitionId>.none()
            if request.reverse { boundary = Option<Prepared.BoundaryTransitionId>.some(contentsBoundary(proof.authority)) }
            run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
              ContentsReplayPosition.Original {node: original}, boundary, request.reverse,
              ContentsReplayWitness.Discharge {proof: request.proof}, proof.active, Option<Atom>.none())
          }
        }
      }
      ContentsReplayPosition.Original {node: original} => {
        let terminal = contentsTerminal(proof.authority)
        let root = run contentsReplayRoot(&closure.*, proof)
        let done = (!request.reverse && original == terminal) || (request.reverse && original == root)
        if done {
          let mut destination = node
          destination.point = ContentsReplayPoint.Source
          if request.reverse { destination.point = ContentsReplayPoint.Target }
          destination.subject = request.source
          let mut boundary = Option<Prepared.BoundaryTransitionId>.none()
          if !request.reverse {
            boundary = Option<Prepared.BoundaryTransitionId>.some(contentsBoundary(proof.authority))
          }
          run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
            ContentsReplayPosition.Done, boundary, false, ContentsReplayWitness.Discharge {proof: request.proof},
            proof.active, Option<Atom>.none())
        }
        let count = List<ContentsStep>.length(&closure.contentsSteps)
        let mut each = usize.ZERO
        while each < count {
          let step = List<ContentsStep>.asSlice(&closure.contentsSteps)[each]
          let mut later = step.later
          let mut earlier = step.earlier
          if request.reverse { later = step.earlier earlier = step.later }
          if later == original {
            let old = List<ContentsNode>.asSlice(&closure.contents)[earlier]
            let subject = match move run contentsReplaySubject(prepared, old.state, node.subject) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"contents step lost its paired selected descendant") }
            }
            let destination = ContentsReplayNode {request: node.request, proof: request.proof,
              point: ContentsReplayPoint.Original {node: earlier}, subject: subject, state: node.state}
            let carrier = Carriers.Product.edges(&closure.product)[step.carrier]
            let applicable = actualCases[carrier.case].active
            let mut boundary = Option<Prepared.BoundaryTransitionId>.none()
            let mut reverse = request.reverse
            let mut guard = Option<Atom>.none()
            let mut primitive = true
            match step.lift {
              ContentsLift.Publication => ()
              ContentsLift.OutputIdentity {..} => ()
              ContentsLift.Next {cursor: oldCursor, next} => {
                boundary = Option<Prepared.BoundaryTransitionId>.some(next)
                if oldCursor.direction == Carriers.Direction.StorageInverse { reverse = !reverse }
              }
              ContentsLift.Prepared {cursor: oldCursor, lift} => {
                boundary = match &List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)[lift].step {
                  Prepared.BoundaryLiftStep.Transition {id} => Option<Prepared.BoundaryTransitionId>.some(id)
                  _ => { return CompilerBug.panic(b"contents replay promoted a prepared channel stop") }
                }
                if oldCursor.direction == Carriers.Direction.StorageInverse { reverse = !reverse }
              }
              ContentsLift.CompositeIdentity {pair, ..} => {
                let retained = List<Carriers.Pair>.asSlice(&closure.pairs)[pair]
                guard = Option<Atom>.some(List<ContentsProof>.asSlice(&closure.contentsProofs)[retained.proof].identity)
              }
              ContentsLift.Composite {result, ..} => {
                primitive = false
                run contentsReplayExpand(&mut closure.*, &mut skeleton.rules, at, each, result, request.reverse, earlier, subject, applicable)
              }
            }
            if primitive {
              run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
                ContentsReplayPosition.Original {node: earlier}, boundary, reverse,
                ContentsReplayWitness.Step {step: each}, applicable, guard)
            }
          }
          each = each + usize.ONE
        }
      }
      ContentsReplayPosition.Expanded {expansion: expansionId, node: oldNode} => {
        let expansion = List<ContentsReplayExpansion>.asSlice(&closure.contentsReplayExpansions)[expansionId]
        let old = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[oldNode]
        let completed = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)[expansion.result]
        let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
        if old.request != completed.request { return CompilerBug.panic(b"contents expansion crossed prior replay roots") }
        let selected = match move run contentsReplaySubject(prepared, old.state, node.subject) {
          Option<Prepared.ResidualStateId>.Some {value} => value
          _ => { return CompilerBug.panic(b"contents expansion lost its selected prior output") }
        }
        if selected.index != node.subject.index { return CompilerBug.panic(b"contents expansion changed its exact subject interpretation") }
        if oldNode == expansion.finish {
          if node.subject.index != expansion.subject.index { return CompilerBug.panic(b"contents expansion changed its continuation subject") }
          let destination = ContentsReplayNode {request: node.request, proof: request.proof,
            point: ContentsReplayPoint.Original {node: expansion.continuation}, subject: expansion.subject, state: node.state}
          run contentsReplayAdvance(&mut closure.*, &mut skeleton.rules, at, destination,
            ContentsReplayPosition.Original {node: expansion.continuation}, contentsReplayIdentity(node.state), false,
            ContentsReplayWitness.Leave {expansion: expansionId}, end.active, Option<Atom>.none())
        }
        let count = List<ContentsReplayArc>.length(&closure.contentsReplayArcs)
        let mut each = usize.ZERO
        while each < count {
          let arc = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)[each]
          let mut later = arc.later
          let mut earlier = arc.earlier
          if expansion.reverse { later = arc.earlier earlier = arc.later }
          if later == oldNode {
            let previous = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[earlier]
            if previous.request != completed.request { return CompilerBug.panic(b"primitive replay arc crossed its original graph") }
            let subject = match move run contentsReplaySubject(prepared, previous.state, node.subject) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"primitive replay arc lost paired authored descendants") }
            }
            let destination = ContentsReplayNode {request: node.request, proof: previous.proof,
              point: previous.point, subject: subject, state: node.state}
            let mut reverse = arc.reverse
            if expansion.reverse { reverse = !reverse }
            run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
              ContentsReplayPosition.Expanded {expansion: expansionId, node: earlier}, arc.boundary, reverse,
              ContentsReplayWitness.Arc {arc: each}, arc.active, Option<Atom>.none())
          }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return oldNodes != List<ContentsReplayNode>.length(&closure.contentsReplayNodes)
    || oldCursors != List<ContentsReplayCursor>.length(&closure.contentsReplayCursors)
    || oldLinks != List<ContentsReplayLink>.length(&closure.contentsReplayLinks)
    || oldResults != List<ContentsReplayResult>.length(&closure.contentsReplayResults)
}

effect fn closeContents<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let oldNodes = List<ContentsNode>.length(&closure.contents)
  let oldSteps = List<ContentsStep>.length(&closure.contentsSteps)
  let oldProofs = List<ContentsProof>.length(&closure.contentsProofs)
  let oldReplays = List<ContentsReplay>.length(&closure.contentsReplays)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let actualCases = List<Case>.asSlice(&domain.cases)
  let edgeCount = List<AliasEdge>.length(&skeleton.aliasEdges)
  let empty = List<Atom>.make()
  let mut edgeId = usize.ZERO
  while edgeId < edgeCount {
    let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
    match edge.authority {
      AliasAuthority.Selected {map, ..} => {
        let actual = &maps[map.index]
        let identity = match &actual.selector { Selector.Identity => true _ => false }
        // This is the actual SelectionUse's value/place-role crossing, not an arbitrary
        // same-shaped map. Its occurrence and family membership are validated separately.
        if actual.kind != MapKind.Select || !identity
          || endpoints[actual.source.index].shape.index != endpoints[actual.target.index].shape.index {
          return CompilerBug.panic(b"selected contents require explicit unchanged component authority")
        }
        let mut state = usize.ZERO
        while state < states.length {
          let id = Prepared.ResidualStateId {index: state}
          if states[state].input.shape.index == endpoints[actual.target.index].shape.index
            && contentsPhysicalState(prepared, id) {
            let gates: [Atom; 1] = [edge.active]
            run contentsProof(&mut closure.contentsProofs, &mut closure.pairs, prepared, &mut skeleton.*, domain, edgeId, id, id,
              ContentsAuthority.Selected {map: map}, &gates, &gates, true)
          }
          state = state + usize.ONE
        }
      }
      _ => {
        if let Option<ContentsPlacement>.Some {value: placement} = contentsPlacement(&closure.*, edge.authority) {
          let nodes = Carriers.Product.nodes(&closure.product)
          let terminal = nodes[placement.carrier]
          let demand = List<Carriers.Demand>.asSlice(&closure.demands)[terminal.demand]
          let mut root = usize.MAX
          let mut each = usize.ZERO
          while each < nodes.length {
            if nodes[each].demand == terminal.demand && nodes[each].cell == demand.cell
              && nodes[each].state.index == demand.state.index { root = each }
            each = each + usize.ONE
          }
          if root == usize.MAX { return CompilerBug.panic(b"contents lost its actual carrier root") }
          let subject = match run contentsSubject(prepared, nodes[root].state, placement.state) {
            Option<Prepared.ResidualStateId>.Some {value} => value
            _ => { return CompilerBug.panic(b"contents selected output is absent from its carrier root") }
          }
          let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
          if states[subject.index].output.index != endpoints[alias.endpoint.index].shape.index {
            return CompilerBug.panic(b"contents root changed the queried output shape")
          }
          let mut state = usize.ZERO
          while state < states.length {
            let id = Prepared.ResidualStateId {index: state}
            if states[state].input.shape.index == states[subject.index].output.index
              && contentsPhysicalState(prepared, id) {
              let before = List<ContentsNode>.length(&closure.contents)
              let node = run contentsNode(&mut closure.contents, &mut skeleton.rules, edgeId, id, root, id)
              if node == before {
                let actual = List<ContentsNode>.asSlice(&closure.contents)[node]
                let gates: [Atom; 2] = [demand.active, demand.reachable]
                run Program.rule(&mut skeleton.rules, actual.active, &gates, List<Atom>.asSlice(&empty))
                run Program.rule(&mut skeleton.rules, actual.identity, &gates, List<Atom>.asSlice(&empty))
              }
            }
            state = state + usize.ONE
          }
        }
      }
    }
    edgeId = edgeId + usize.ONE
  }

  let mut at = usize.ZERO
  while at < List<ContentsNode>.length(&closure.contents) {
    let node = List<ContentsNode>.asSlice(&closure.contents)[at]
    let aliasEdge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[node.edge]
    let placement = match contentsPlacement(&closure.*, aliasEdge.authority) {
      Option<ContentsPlacement>.Some {value} => value
      _ => { return CompilerBug.panic(b"contents carrier replay has no original address placement") }
    }
    let carrierNodes = Carriers.Product.nodes(&closure.product)
    let selected = match run contentsSubject(prepared, carrierNodes[node.carrier].state, placement.state) {
      Option<Prepared.ResidualStateId>.Some {value} => value
      _ => { return CompilerBug.panic(b"contents replay lost its selected outer subject") }
    }
    if states[node.state.index].input.shape.index != states[selected.index].output.index {
      return CompilerBug.panic(b"contents replay attached an unrelated later suffix")
    }
    let carrierEdges = Carriers.Product.edges(&closure.product)
    let mut each = usize.ZERO
    while each < carrierEdges.length {
      let carrierEdge = carrierEdges[each]
      if carrierEdge.later == node.carrier {
        let previous = match run contentsSubject(prepared, carrierNodes[carrierEdge.earlier].state, placement.state) {
          Option<Prepared.ResidualStateId>.Some {value} => value
          _ => { return CompilerBug.panic(b"contents replay changed its paired original suffix") }
        }
        let caseActive = actualCases[carrierEdge.case].active
        match carrierEdge.authority {
          Carriers.EdgeAuthority.SameComponent => {
            if selected.index != previous.index {
              return CompilerBug.panic(b"same-component carrier changed its selected output")
            }
            run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, node.state,
              ContentsLift.Publication, caseActive, Option<Atom>.none(), true, Option<Atom>.none())
          }
          Carriers.EdgeAuthority.Physical {boundary: cursor} => {
            // Locate a deeper selected subject through the retained PAIRED graph. Neither
            // side may advance independently, including equal-shaped sibling fields.
            let mut pending = List<Prepared.BoundaryTransitionId>.make()
            run List<Prepared.BoundaryTransitionId>.append(&mut pending, cursor.current)
            let mut pendingAt = usize.ZERO
            while pendingAt < List<Prepared.BoundaryTransitionId>.length(&pending) {
              let id = List<Prepared.BoundaryTransitionId>.asSlice(&pending)[pendingAt]
              let pair = &boundaries[id.index]
              let next = List<Prepared.BoundaryTransitionId>.asSlice(&pair.next)
              if boundaryAfter(pair, cursor.direction).index == selected.index
                && boundaryBefore(pair, cursor.direction).index == previous.index {
                let actualCursor = Carriers.BoundaryCursor {root: cursor.root, current: id, direction: cursor.direction}
                if boundaryOutputIdentity(prepared, id) {
                  run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, node.state,
                    ContentsLift.OutputIdentity {cursor: actualCursor}, caseActive, Option<Atom>.none(), true, Option<Atom>.none())
                }
                let mut following = usize.ZERO
                while following < next.length {
                  let child = &boundaries[next[following].index]
                  if boundaryAfter(child, cursor.direction).index == node.state.index {
                    run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, boundaryBefore(child, cursor.direction),
                      ContentsLift.Next {cursor: actualCursor, next: next[following]}, caseActive,
                      Option<Atom>.none(), boundaryOutputIdentity(prepared, next[following]), Option<Atom>.none())
                  }
                  following = following + usize.ONE
                }
                let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
                let mut lift = usize.ZERO
                while lift < lifts.length {
                  let permitted = match lifts[lift].direction {
                    Prepared.BoundaryLiftDirection.Forward => cursor.direction == Carriers.Direction.Forward
                    Prepared.BoundaryLiftDirection.StorageAliasInverse => cursor.direction == Carriers.Direction.StorageInverse
                    // Only the composite proof replay above may reverse an Origin leg.
                    Prepared.BoundaryLiftDirection.OriginInverse => false
                  }
                  if lifts[lift].boundary.index == id.index && permitted {
                    match &lifts[lift].step {
                      Prepared.BoundaryLiftStep.Transition {id: lifted} => {
                        let child = &boundaries[lifted.index]
                        if boundaryAfter(child, cursor.direction).index == node.state.index {
                          if cursor.direction == Carriers.Direction.StorageInverse
                            && pair.authority != Prepared.BoundaryAuthority.StorageAlias {
                            return CompilerBug.panic(b"physical output lift cannot supply inverse address authority")
                          }
                          run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules,
                            at, each, carrierEdge, boundaryBefore(child, cursor.direction),
                            ContentsLift.Prepared {cursor: actualCursor, lift: lift}, caseActive,
                            Option<Atom>.none(), boundaryOutputIdentity(prepared, lifted), Option<Atom>.none())
                        }
                      }
                      // A channel stop records a later semantic composition obligation;
                      // it supplies neither a contents transport nor an address witness.
                      Prepared.BoundaryLiftStep.Stop {..} => ()
                    }
                  }
                  lift = lift + usize.ONE
                }
              }
              let mut following = usize.ZERO
              while following < next.length {
                let ids = List<Prepared.BoundaryTransitionId>.asSlice(&pending)
                let mut present = false
                let mut prior = usize.ZERO
                while prior < ids.length { if ids[prior].index == next[following].index { present = true } prior = prior + usize.ONE }
                if !present { run List<Prepared.BoundaryTransitionId>.append(&mut pending, next[following]) }
                following = following + usize.ONE
              }
              pendingAt = pendingAt + usize.ONE
            }
          }
          Carriers.EdgeAuthority.OriginContents {pair: pairId} => {
            let pair = List<Carriers.Pair>.asSlice(&closure.pairs)[pairId]
            let retained = List<ContentsProof>.asSlice(&closure.contentsProofs)[pair.proof]
            // A previously derived COMPLETE output identity can carry a later independent
            // query. Its atom remains grounded in that proof, including every old Case.
            let mut exact = selected.index == pair.targetState.index && previous.index == pair.sourceState.index
            if !exact && selected.index == previous.index {
              exact = run contentsIdentityDescendant(prepared, pair.sourceState, pair.targetState, selected)
            }
            if exact && states[selected.index].output.index == states[previous.index].output.index {
              run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, node.state,
                ContentsLift.CompositeIdentity {pair: pairId, sourceSubject: previous, targetSubject: selected},
                caseActive, Option<Atom>.some(retained.identity), true, Option<Atom>.none())
            }
            // The prior actual proof, rather than equality of its outputs, is the
            // authority for a fresh suffix. Replay retains its original graph and every
            // primitive contributor, including further nonidentity composite steps.
            let sourceSubject = match move run contentsReplaySubject(prepared, pair.sourceState, previous) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"composite contents source is outside its original proof") }
            }
            let targetSubject = match move run contentsReplaySubject(prepared, pair.targetState, selected) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"composite contents target is outside its original proof") }
            }
            if sourceSubject.index != previous.index || targetSubject.index != selected.index {
              return CompilerBug.panic(b"composite contents changed its exact selected subject pair")
            }
            let request = run contentsReplayRequest(&mut closure.*, &mut skeleton.*, domain, pair.proof,
              previous, selected, node.state)
            let results = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)
            let mut result = usize.ZERO
            while result < results.length {
              if results[result].request == request {
                let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[results[result].cursor]
                let replayed = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
                let lift = ContentsLift.Composite {pair: pairId, sourceSubject: previous, targetSubject: selected, result: result}
                run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules,
                  at, each, carrierEdge, replayed.state, lift, caseActive, Option<Atom>.some(cursor.active), false, Option<Atom>.some(cursor.identity))
              }
              result = result + usize.ONE
            }
          }
        }
      }
      each = each + usize.ONE
    }

    if node.carrier == placement.carrier {
      if selected.index != placement.state.index { return CompilerBug.panic(b"contents discharge changed its selected family member") }
      let member = &maps[placement.member.index]
      let roots = List<Prepared.BoundaryTransitionId>.asSlice(&member.boundaries)
      let mut gates = List<Atom>.make()
      run List<Atom>.append(&mut gates, node.active)
      let source = match aliasEdge.authority {
        AliasAuthority.Origin {placement: id} => {
          let origin = List<OriginPlacement>.asSlice(&closure.placements)[id]
          let proof = List<OriginProof>.asSlice(&closure.origins)[origin.proof]
          let reference = List<ReferenceOrigin>.asSlice(&skeleton.references)[proof.origin]
          validateReferenceMaps(endpoints, maps, reference.map, reference.referent)
          let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[origin.sourceAlias]
          if !sameSourceComponent(endpoints, alias.endpoint, member.source) {
            return CompilerBug.panic(b"origin contents discharge lost the Value/Storage role pair")
          }
          run List<Atom>.append(&mut gates, actualCases[proof.seed].active)
          run List<Atom>.append(&mut gates, List<StorageAlias>.asSlice(&skeleton.aliases)[proof.sourceAlias].active)
          run List<Atom>.append(&mut gates, alias.active)
          alias.endpoint
        }
        AliasAuthority.Slice {placement: id} => {
          let slice = List<SlicePlacement>.asSlice(&closure.slicePlacements)[id]
          let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[slice.proof]
          let origin = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[slice.edge]
          let exact = match origin.authority { AliasAuthority.Origin {placement} => placement == slice.origin _ => false }
          let source = match aliasEdge.source { Option<usize>.Some {value} => value
            _ => { return CompilerBug.panic(b"slice contents omitted its actual source Origin leg") } }
          let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[source]
          if !exact || source != origin.target || alias.endpoint.index != member.source.index {
            return CompilerBug.panic(b"slice contents discharge changed its exact element source address")
          }
          // The descriptor Case authenticates the conversion only. The inner leaf
          // reaches this edge from the preceding current-read Origin Address Case.
          run List<Atom>.append(&mut gates, actualCases[proof.case].active)
          run List<Atom>.append(&mut gates, proof.active)
          run List<Atom>.append(&mut gates, origin.active)
          alias.endpoint
        }
        _ => { return CompilerBug.panic(b"contents discharge has no original address authority") }
      }
      let mut root = usize.ZERO
      while root < roots.length {
        let pair = &boundaries[roots[root].index]
        if pair.targetState.index == node.state.index {
          if pair.map.index != placement.member.index
            || states[pair.sourceState.index].input.shape.index != endpoints[source.index].shape.index {
            return CompilerBug.panic(b"contents discharge substituted an unrelated family member")
          }
          let authority = match aliasEdge.authority {
            AliasAuthority.Origin {..} => ContentsAuthority.Origin {node: at, referent: roots[root]}
            AliasAuthority.Slice {..} => ContentsAuthority.Slice {node: at, element: roots[root]}
            _ => { return CompilerBug.panic(b"contents discharge lost its actual kind") }
          }
          let mut identityGates = List<Atom>.make()
          let active = List<Atom>.asSlice(&gates)
          let mut gate = usize.ZERO
          while gate < active.length {
            let mut value = active[gate]
            if gate == usize.ZERO { value = node.identity }
            run List<Atom>.append(&mut identityGates, value)
            gate = gate + usize.ONE
          }
          run contentsProof(&mut closure.contentsProofs, &mut closure.pairs, prepared, &mut skeleton.*, domain, node.edge, pair.sourceState, node.target,
            authority, active, List<Atom>.asSlice(&identityGates),
            boundaryOutputIdentity(prepared, roots[root]))
        }
        root = root + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let replayed = run closeContentsReplays(&mut closure.*, prepared, &mut skeleton.*, domain)
  return replayed || oldReplays != List<ContentsReplay>.length(&closure.contentsReplays)
    || oldNodes != List<ContentsNode>.length(&closure.contents)
    || oldSteps != List<ContentsStep>.length(&closure.contentsSteps)
    || oldProofs != List<ContentsProof>.length(&closure.contentsProofs)
}

fn validateContentsReplays<'body>(prepared: &SourcePreparation<'body>, cases: &[Case], closure: &DescriptorClosure) -> () {
  let requests = List<ContentsReplay>.asSlice(&closure.contentsReplays)
  let nodes = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)
  let cursors = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)
  let arcs = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)
  let proofs = List<ContentsProof>.asSlice(&closure.contentsProofs)
  let originals = List<ContentsNode>.asSlice(&closure.contents)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let mut at = usize.ZERO
  while at < requests.length {
    let request = requests[at]
    if request.proof >= proofs.length || request.root >= nodes.length { CompilerBug.panic(b"contents replay lost its original authority") }
    let proof = proofs[request.proof]
    let reverse = match cases[proof.case].authority {
      TransferAuthority.Address {edge, direction} => {
        if edge != proof.edge { return CompilerBug.panic(b"contents replay changed its original address edge") }
        direction == MapDirection.StorageInverse
      }
      _ => { return CompilerBug.panic(b"contents replay admitted a non-address case") }
    }
    let root = nodes[request.root]
    let mut point = ContentsReplayPoint.Target
    if reverse { point = ContentsReplayPoint.Source }
    if reverse != request.reverse || root.request != at || root.proof != request.proof
      || !sameContentsReplayPoint(root.point, point) || root.subject.index != request.target.index
      || root.state.index != request.state.index {
      CompilerBug.panic(b"contents replay lost its exact root, direction or requested suffix")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at]
    if node.request >= requests.length || node.proof >= proofs.length || node.subject.index >= states.length
      || node.state.index >= states.length { CompilerBug.panic(b"contents replay node is outside its frozen product") }
    if !contentsPhysicalState(prepared, node.subject) || !contentsPhysicalState(prepared, node.state)
      || states[node.state.index].input.shape.index != states[node.subject.index].output.index {
      CompilerBug.panic(b"contents replay node lost its exact authored output component")
    }
    if let ContentsReplayPoint.Original {node: original} = node.point {
      if original >= originals.length || originals[original].edge != proofs[node.proof].edge {
        CompilerBug.panic(b"contents replay point changed its original graph authority")
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < arcs.length {
    let arc = arcs[at]
    if arc.later >= nodes.length || arc.earlier >= nodes.length { CompilerBug.panic(b"contents replay arc has an absent point") }
    let later = nodes[arc.later]
    let earlier = nodes[arc.earlier]
    if later.request != earlier.request { CompilerBug.panic(b"contents replay arc crossed requested histories") }
    match arc.boundary {
      Option<Prepared.BoundaryTransitionId>.Some {value} => {
        if value.index >= boundaries.length { CompilerBug.panic(b"contents replay arc invented a paired boundary") }
        let pair = &boundaries[value.index]
        if contentsReplayBefore(pair, arc.reverse).index != earlier.state.index
          || contentsReplayAfter(pair, arc.reverse).index != later.state.index {
          CompilerBug.panic(b"contents replay arc changed its exact paired orientation")
        }
      }
      Option<Prepared.BoundaryTransitionId>.None => {
        if earlier.state.index != later.state.index { CompilerBug.panic(b"contents identity arc changed its authored suffix") }
      }
    }
    at = at + usize.ONE
  }
  let links = List<ContentsReplayLink>.asSlice(&closure.contentsReplayLinks)
  at = usize.ZERO
  while at < links.length {
    let link = links[at]
    if link.arc >= arcs.length || link.source >= cursors.length || link.target >= cursors.length {
      CompilerBug.panic(b"contents replay link lost its original membership")
    }
    let arc = arcs[link.arc]
    if cursors[link.source].node != arc.later || cursors[link.target].node != arc.earlier {
      CompilerBug.panic(b"contents replay link crossed membership cursors")
    }
    if let Option<Prepared.BoundaryTransitionId>.Some {value} = link.selected {
      if value.index >= boundaries.length { CompilerBug.panic(b"contents replay link lost its selected boundary") }
      let pair = &boundaries[value.index]
      if contentsReplayBefore(pair, arc.reverse).index != nodes[arc.earlier].subject.index
        || contentsReplayAfter(pair, arc.reverse).index != nodes[arc.later].subject.index {
        CompilerBug.panic(b"contents replay link changed its selected paired subjects")
      }
      if let Option<usize>.Some {value: lift} = link.lift {
        let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
        if lift >= lifts.length { CompilerBug.panic(b"contents replay link lost its prepared output row") }
        let row = &lifts[lift]
        let exact = match &row.step {
          Prepared.BoundaryLiftStep.Transition {id} => sameContentsReplayBoundary(arc.boundary, Option<Prepared.BoundaryTransitionId>.some(id))
          _ => false
        }
        let direction = match row.direction {
          Prepared.BoundaryLiftDirection.Forward => !arc.reverse
          Prepared.BoundaryLiftDirection.StorageAliasInverse => arc.reverse && pair.authority == Prepared.BoundaryAuthority.StorageAlias
          Prepared.BoundaryLiftDirection.OriginInverse => arc.reverse && pair.authority == Prepared.BoundaryAuthority.Physical
        }
        if row.boundary.index != value.index || !exact || !direction { CompilerBug.panic(b"contents replay link substituted an output lift") }
      }
    }
    at = at + usize.ONE
  }
  let results = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)
  let steps = List<ContentsStep>.asSlice(&closure.contentsSteps)
  let pairs = List<Carriers.Pair>.asSlice(&closure.pairs)
  at = usize.ZERO
  while at < steps.length {
    let step = steps[at]
    if let ContentsLift.Composite {pair, sourceSubject, targetSubject, result} = step.lift {
      if pair >= pairs.length || result >= results.length || step.later >= originals.length
        || step.earlier >= originals.length { CompilerBug.panic(b"composite contents step lost its retained proof") }
      let completed = results[result]
      if completed.request >= requests.length || completed.cursor >= cursors.length {
        CompilerBug.panic(b"composite contents step lost its replay result")
      }
      let request = requests[completed.request]
      let previous = nodes[cursors[completed.cursor].node]
      let carrier = Carriers.Product.edges(&closure.product)[step.carrier]
      if request.proof != pairs[pair].proof || request.source.index != sourceSubject.index
        || request.target.index != targetSubject.index || request.state.index != originals[step.later].state.index
        || previous.state.index != originals[step.earlier].state.index || carrier.case != pairs[pair].case {
        CompilerBug.panic(b"composite contents step changed its occurrence or selected output proof")
      }
    }
    at = at + usize.ONE
  }
  let expansions = List<ContentsReplayExpansion>.asSlice(&closure.contentsReplayExpansions)
  at = usize.ZERO
  while at < expansions.length {
    let expansion = expansions[at]
    if expansion.source >= cursors.length || expansion.step >= steps.length || expansion.result >= results.length
      || expansion.finish >= nodes.length || expansion.continuation >= originals.length {
      CompilerBug.panic(b"contents expansion lost its original finite coordinates")
    }
    let original = match cursors[expansion.source].position {
      ContentsReplayPosition.Original {node} => node
      _ => { return CompilerBug.panic(b"contents expansion recursively keyed another expansion") }
    }
    let step = steps[expansion.step]
    let mut later = step.later
    let mut earlier = step.earlier
    if expansion.reverse { later = step.earlier earlier = step.later }
    let retained = match step.lift { ContentsLift.Composite {result, ..} => result == expansion.result _ => false }
    if !retained || original != later || expansion.continuation != earlier {
      CompilerBug.panic(b"contents expansion changed its original step membership")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < results.length {
    let result = results[at]
    if result.request >= requests.length || result.cursor >= cursors.length { CompilerBug.panic(b"contents replay result lost its request") }
    let cursor = cursors[result.cursor]
    let node = nodes[cursor.node]
    let request = requests[result.request]
    let done = match cursor.position { ContentsReplayPosition.Done => true _ => false }
    let mut point = ContentsReplayPoint.Source
    if request.reverse { point = ContentsReplayPoint.Target }
    if !done || node.request != result.request || node.proof != request.proof
      || node.subject.index != request.source.index || !sameContentsReplayPoint(node.point, point) {
      CompilerBug.panic(b"contents replay result changed its original source endpoint")
    }
    at = at + usize.ONE
  }
  return ()
}

fn validateContents<'body>(prepared: &SourcePreparation<'body>, aliases: &[AliasEdge],
  cases: &[Case], closure: &DescriptorClosure) -> () {
  let pairs = List<Carriers.Pair>.asSlice(&closure.pairs)
  let proofs = List<ContentsProof>.asSlice(&closure.contentsProofs)
  let nodes = List<ContentsNode>.asSlice(&closure.contents)
  let placements = List<OriginPlacement>.asSlice(&closure.placements)
  let origins = List<OriginProof>.asSlice(&closure.origins)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let mut at = usize.ZERO
  while at < pairs.length {
    let pair = pairs[at]
    if pair.proof >= proofs.length { CompilerBug.panic(b"contents pair omitted its actual derivation") }
    let proof = proofs[pair.proof]
    if proof.case >= cases.length || proof.edge >= aliases.length || pair.case != proof.case
      || pair.originProof != proof.edge || pair.sourceState.index != proof.source.index
      || pair.targetState.index != proof.target.index || pair.active.index != proof.active.index {
      CompilerBug.panic(b"contents pair cross-paired its occurrence or residual derivation")
    }
    let mut before = proof.source
    let mut after = proof.target
    match cases[proof.case].authority {
      TransferAuthority.Address {edge, direction} => {
        if edge != proof.edge { CompilerBug.panic(b"contents derivation belongs to another address case") }
        if direction == MapDirection.StorageInverse { before = proof.target after = proof.source }
      }
      _ => CompilerBug.panic(b"contents derivation replaced physical or declared authority")
    }
    match proof.authority {
      ContentsAuthority.Selected {map} => {
        let exact = match aliases[proof.edge].authority {
          AliasAuthority.Selected {map: selected, ..} => selected.index == map.index _ => false
        }
        if !exact || before.index != after.index { CompilerBug.panic(b"selected contents changed its exact suffix") }
      }
      ContentsAuthority.Origin {node, referent} => {
        let placement = match aliases[proof.edge].authority {
          AliasAuthority.Origin {placement} => placements[placement]
          _ => { return CompilerBug.panic(b"origin contents has no actual reference placement") }
        }
        if node >= nodes.length || referent.index >= boundaries.length {
          CompilerBug.panic(b"origin contents discharge lost its carrier or reference member")
        }
        let replay = nodes[node]
        let boundary = &boundaries[referent.index]
        let roots = List<Prepared.BoundaryTransitionId>.asSlice(&maps[placement.member.index].boundaries)
        let mut found = false
        let mut each = usize.ZERO
        while each < roots.length { if roots[each].index == referent.index { found = true } each = each + usize.ONE }
        if !found || replay.edge != proof.edge || replay.carrier != origins[placement.proof].carrier
          || replay.target.index != after.index || boundary.targetState.index != replay.state.index
          || boundary.sourceState.index != before.index || boundary.map.index != placement.member.index {
          CompilerBug.panic(b"origin contents discharge changed its exact referent pair or carrier endpoint")
        }
      }
      ContentsAuthority.Slice {node, element} => {
        let placement = match aliases[proof.edge].authority {
          AliasAuthority.Slice {placement} => List<SlicePlacement>.asSlice(&closure.slicePlacements)[placement]
          _ => { return CompilerBug.panic(b"slice contents has no actual conversion placement") }
        }
        if node >= nodes.length || element.index >= boundaries.length || placement.edge >= aliases.length {
          CompilerBug.panic(b"slice contents discharge lost its carrier, member or source Origin edge")
        }
        let conversion = List<SliceProof>.asSlice(&closure.sliceProofs)[placement.proof]
        let origin = aliases[placement.edge]
        let exactOrigin = match origin.authority {
          AliasAuthority.Origin {placement: id} => id == placement.origin _ => false
        }
        let exactSource = match aliases[proof.edge].source {
          Option<usize>.Some {value} => value == origin.target _ => false
        }
        let replay = nodes[node]
        let boundary = &boundaries[element.index]
        let roots = List<Prepared.BoundaryTransitionId>.asSlice(&maps[placement.member.index].boundaries)
        let mut found = false
        let mut each = usize.ZERO
        while each < roots.length { if roots[each].index == element.index { found = true } each = each + usize.ONE }
        if !exactOrigin || !exactSource || !found || replay.edge != proof.edge || replay.carrier != conversion.carrier
          || replay.target.index != after.index || boundary.targetState.index != replay.state.index
          || boundary.sourceState.index != before.index || boundary.map.index != placement.member.index {
          CompilerBug.panic(b"slice contents discharge changed its exact element pair or current-read address leg")
        }
      }
    }
    at = at + usize.ONE
  }
  validateContentsReplays(prepared, cases, closure)
  return ()
}

fn operationSubject(value: Value) -> bool {
  if let Option<ResidualSubject>.Some {value: selected} = value.subject {
    if let Option<Results.Position>.Some {..} = selected.position { return true }
  }
  return false
}

// Private address lanes are occurrence-qualified. An arbitrary equal endpoint is not an
// address proof, even when its value happens to contain the same Borrow leaf.
fn carrierAliasEdge(skeleton: &Skeleton, source: Value, target: Value, map: MapId,
  direction: MapDirection, address: EvalId) -> usize {
  let mut before = source
  let mut after = target
  if direction == MapDirection.StorageInverse { before = target after = source }
  let port = match after.transport {
    Option<AliasPort>.Some {value} => value
    _ => { return CompilerBug.panic(b"address carrier lost its actual private destination lane") }
  }
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let requests = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  if port.alias >= aliases.length || port.request >= requests.length
    || aliases[port.alias].evaluation.index != address.index
    || after.evaluation.index != requests[port.request].evaluation.index {
    return CompilerBug.panic(b"address carrier changed its actual use or formation occurrence")
  }
  let mut at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let selected = match edge.authority { AliasAuthority.Project {map: value} => value.index == map.index _ => false }
    if selected && edge.target == port.alias {
      let exact = match edge.source {
        Option<usize>.Some {value: predecessor} => match before.transport {
          Option<AliasPort>.Some {value} => value.request == port.request && value.alias == predecessor
          _ => false
        }
        Option<usize>.None => match before.transport {
          Option<AliasPort>.None => before.endpoint.index == aliases[port.alias].storage.endpoint.index
            && before.evaluation.index == requests[port.request].evaluation.index
          _ => false
        }
      }
      if exact { return at }
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"address carrier has no exact contiguous alias edge")
}

fn carrierPublication(source: Value, target: Value) -> () {
  if source.endpoint.index != target.endpoint.index || !sameSubject(source.subject, target.subject) {
    CompilerBug.panic(b"descriptor publication changed its actual selected component")
  }
  match source.transport {
    Option<AliasPort>.Some {value} => match target.transport {
      Option<AliasPort>.Some {value: other} => {
        if value.request != other.request || value.alias != other.alias {
          CompilerBug.panic(b"descriptor publication merged private address proofs")
        }
      }
      Option<AliasPort>.None => ()
    }
    Option<AliasPort>.None => ()
  }
  // The only nonprivate component changes admitted here are actual reserved publications
  // and canonical definition/read transfers. Their original Case identity remains intact.
  return ()
}

fn carrierAuthority<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  keys: &[CellKey], actual: &Case) -> Carriers.Authority {
  let source = match actual.source {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return Carriers.Authority.Blocked }
  }
  let values = List<Value>.asSlice(&skeleton.values)
  let before = values[keys[source].value.index]
  let after = values[keys[actual.target].value.index]
  if operationSubject(before) || operationSubject(after) { return Carriers.Authority.Blocked }
  return match actual.authority {
    TransferAuthority.RetainedWrite {..} => Carriers.Authority.Blocked
    TransferAuthority.OperationResult {..} => Carriers.Authority.Blocked
    TransferAuthority.Address {edge, ..} => Carriers.Authority.OriginContents {proof: edge}
    TransferAuthority.SameComponent => {
      carrierPublication(before, after)
      Carriers.Authority.SameComponent
    }
    TransferAuthority.Physical {map, direction, address} => {
      let physical = &List<SelectionMap>.asSlice(&prepared.maps)[map.index]
      // Descriptor creation, slice conversion, channel and declaration maps have distinct
      // semantic authorities. None may impersonate ordinary component-preserving transport.
      let supported = (physical.componentTransport || physical.addressTransport)
        && match &physical.selector { Selector.Identity => true _ => false }
      if !supported { return Carriers.Authority.Blocked }
      let mut proof = Option<usize>.none()
      if physical.addressTransport {
        let occurrence = match address {
          Option<EvalId>.Some {value} => value
          _ => { return CompilerBug.panic(b"storage carrier omitted actual alias evidence") }
        }
        proof = Option<usize>.some(carrierAliasEdge(skeleton, before, after, map, direction, occurrence))
      } else {
        if let Option<EvalId>.Some {..} = address {
          return CompilerBug.panic(b"value carrier substituted an address proof")
        }
      }
      let mut orientation = Carriers.Direction.Forward
      if direction == MapDirection.StorageInverse { orientation = Carriers.Direction.StorageInverse }
      Carriers.Authority.Physical {map: map, direction: orientation, address: proof}
    }
  }
}

// Only exact actual selector occurrences start demands. New reaching histories add cells to
// this finite set; no source quality or truth value is sampled to choose the candidates.
effect fn descriptorDemands<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &Skeleton, keys: &[CellKey]) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<SelectionUse>.asSlice(&skeleton.selections)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let values = List<Value>.asSlice(&skeleton.values)
  let mut use = usize.ZERO
  while use < requests.length {
    let request = &requests[use]
    let selectors = List<MapId>.asSlice(&request.selectors)
    let mut step = usize.ZERO
    while step < selectors.length {
      let selector = &maps[selectors[step].index]
      let mut boundary = match &selector.selector { Selector.Referent => true _ => false }
      if let Selector.Index {..} = &selector.selector {
        let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[selector.source.index]
        if let Prepared.ShapeState.Slice = &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state { boundary = true }
      }
      if boundary {
        let mut cell = usize.ZERO
        while cell < keys.length {
          let actual = values[keys[cell].value.index]
          if actual.evaluation.index == request.operand.index && actual.endpoint.index == selector.source.index
            && actual.phase == ValuePhase.Output && !operationSubject(actual) {
            let shape = valueShape(prepared, actual)
            let mut state = usize.ZERO
            while state < states.length {
              let selected = &states[state]
              if authoredResidual(selected) && selected.selection.index == request.selection.index
                && selected.vertex.index == selector.target.index && selected.input.shape.index == shape.index {
                let old = List<Carriers.Demand>.asSlice(&closure.demands)
                let mut found = false
                let mut previous = usize.ZERO
                while previous < old.length {
                  if old[previous].selectionUse == use && old[previous].cell == cell
                    && old[previous].state.index == state { found = true }
                  previous = previous + usize.ONE
                }
                if !found {
                  let result = Skeleton.evaluation(skeleton, request.result)
                  run List<Carriers.Demand>.append(&mut closure.demands, Carriers.Demand {selectionUse: use,
                    cell: cell, state: Prepared.ResidualStateId {index: state}, active: request.active,
                    reachable: Flow.reachable(&skeleton.flow, result.point)})
                }
              }
              state = state + usize.ONE
            }
          }
          cell = cell + usize.ONE
        }
      }
      step = step + usize.ONE
    }
    use = use + usize.ONE
  }
  return ()
}

// A retained request owns its exact authored path, while the source descriptor may be
// either the original operand or a current execution read after a preceding boundary.
fn retainedBoundary<'body>(prepared: &SourcePreparation<'body>, map: MapId) -> bool {
  let selected = &List<SelectionMap>.asSlice(&prepared.maps)[map.index]
  if let Selector.Referent = &selected.selector { return true }
  if let Selector.Index {..} = &selected.selector {
    let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[selected.source.index]
    if let Prepared.ShapeState.Slice = &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state { return true }
  }
  return false
}

fn retainedCurrentDescriptor(skeleton: &Skeleton, request: usize, path: usize, prefix: usize,
  value: Value) -> bool {
  let transports = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let values = List<Value>.asSlice(&skeleton.values)
  let mut at = usize.ZERO
  while at < transports.length {
    let transport = transports[at]
    if let AliasConsumer.Retained {request: selected, path: branch, prefix: step, ..} = transport.authority {
      if selected == request && branch == path && step == prefix {
        let input = match transport.consumer { Option<ValueId>.Some {value} => values[value.index]
          _ => { return CompilerBug.panic(b"retained descriptor read has no actual input") } }
        if value.evaluation.index == input.evaluation.index && value.endpoint.index == input.endpoint.index
          && value.phase == ValuePhase.Output && sameSubject(value.subject, input.subject) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn retainedDescriptorDemands<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, keys: &[CellKey], cells: &[Cell]) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<RetainedRequest>.asSlice(&skeleton.retainedRequests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let values = List<Value>.asSlice(&skeleton.values)
  let offset = List<SelectionUse>.length(&skeleton.selections)
  let mut request = usize.ZERO
  while request < requests.length {
    let use = &requests[request]
    let paths = List<RetainedPath>.asSlice(&use.paths)
    let mut path = usize.ZERO
    while path < paths.length {
      let selectors = List<MapId>.asSlice(&paths[path].selectors)
      let mut crossed = false
      let mut step = usize.ZERO
      while step < selectors.length {
        if retainedBoundary(prepared, selectors[step]) {
          let selector = &maps[selectors[step].index]
          let mut cell = usize.ZERO
          while cell < keys.length {
            let actual = values[keys[cell].value.index]
            let mut occurrence = actual.evaluation.index == use.operand.index
            if crossed { occurrence = retainedCurrentDescriptor(&skeleton.*, request, path, step, actual) }
            if occurrence && actual.endpoint.index == selector.source.index && actual.phase == ValuePhase.Output {
              let unknown = match &List<Leaf>.asSlice(&skeleton.leaves)[keys[cell].leaf.index].kind {
                SourceLeaf.Unknown {..} => true _ => false
              }
              if unknown || operationSubject(actual) {
                let prior = List<RetainedMissing>.asSlice(&closure.retainedMissing)
                let mut listed = false
                let mut earlier = usize.ZERO
                while earlier < prior.length {
                  if prior[earlier].request == request && prior[earlier].cell == cell { listed = true }
                  earlier = earlier + usize.ONE
                }
                if !listed {
                  let gates: [Atom; 2] = [use.active, cells[cell].present]
                  let empty = List<Atom>.make()
                  run Program.rule(&mut skeleton.rules, List<RetainedStatus>.asSlice(&skeleton.retainedStatus)[request].missing,
                    &gates, List<Atom>.asSlice(&empty))
                  run List<RetainedMissing>.append(&mut closure.retainedMissing, RetainedMissing {request: request, cell: cell})
                }
              }
            }
            if occurrence && actual.endpoint.index == selector.source.index && actual.phase == ValuePhase.Output
              && !operationSubject(actual) {
              let mut state = usize.ZERO
              while state < states.length {
                let selected = &states[state]
                if authoredResidual(selected) && selected.selection.index == use.selection.index
                  && selected.vertex.index == selector.target.index && selected.input.shape.index == valueShape(prepared, actual).index {
                  let existing = List<Carriers.Demand>.asSlice(&closure.demands)
                  let mut found = false
                  let mut at = usize.ZERO
                  while at < existing.length {
                    if existing[at].selectionUse == offset + request && existing[at].cell == cell
                      && existing[at].state.index == state { found = true }
                    at = at + usize.ONE
                  }
                  if !found {
                    let execution = Skeleton.evaluation(&skeleton.*, use.execution)
                    run List<Carriers.Demand>.append(&mut closure.demands, Carriers.Demand {selectionUse: offset + request,
                      cell: cell, state: Prepared.ResidualStateId {index: state}, active: use.active,
                      reachable: Flow.reachable(&skeleton.flow, execution.point)})
                  }
                }
                state = state + usize.ONE
              }
            }
            cell = cell + usize.ONE
          }
          crossed = true
        }
        step = step + usize.ONE
      }
      path = path + usize.ONE
    }
    request = request + usize.ONE
  }
  return ()
}

fn retainedEdgeDemand(closure: &DescriptorClosure, edge: AliasEdge) -> Option<usize> {
  let carrier = match edge.authority {
    AliasAuthority.Origin {placement} => {
      let selected = List<OriginPlacement>.asSlice(&closure.placements)[placement]
      List<OriginProof>.asSlice(&closure.origins)[selected.proof].carrier
    }
    AliasAuthority.Slice {placement} => {
      let selected = List<SlicePlacement>.asSlice(&closure.slicePlacements)[placement]
      List<SliceProof>.asSlice(&closure.sliceProofs)[selected.proof].carrier
    }
    _ => { return Option<usize>.none() }
  }
  return Option<usize>.some(Carriers.Product.nodes(&closure.product)[carrier].demand)
}

// Emit a real current read through the existing canonical alias lanes. The last endpoint
// is already the exact authored component: publishing it uses SameComponent, never a Copy
// invented for a retained call slot. Each transport keeps its original address edge gate.
effect fn retainedPrefixRead(skeleton: &mut Skeleton, request: usize, path: usize, prefix: usize,
  edgeId: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let transports = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let mut at = usize.ZERO
  while at < transports.length {
    if let AliasConsumer.Retained {request: old, path: branch, prefix: step, edge} = transports[at].authority {
      if old == request && branch == path && step == prefix && edge == edgeId { return false }
    }
    at = at + usize.ONE
  }
  let use = &List<RetainedRequest>.asSlice(&skeleton.retainedRequests)[request]
  let execution = use.execution
  let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
  let alias = &List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
  if alias.evaluation.index != execution.index { return CompilerBug.panic(b"retained read crossed execution occurrences") }
  let endpoint = alias.endpoint
  let active = run addressApplies(&mut skeleton.rules, use.active, edge.active)
  let output = run Skeleton.value(&mut skeleton.*, execution, endpoint)
  let input = run Skeleton.componentValue(&mut skeleton.*, execution, endpoint, Option<ResidualSubject>.none(), ValuePhase.Input)
  let requestId = List<AliasTransport>.length(&skeleton.aliasTransports)
  run List<AliasTransport>.append(&mut skeleton.aliasTransports, AliasTransport {consumer: Option<ValueId>.some(input),
    alias: edge.target, authority: AliasConsumer.Retained {request: request, path: path, prefix: prefix, edge: edgeId},
    evaluation: execution, active: active, direction: MapDirection.Forward, closed: usize.ZERO})
  let incoming = run Skeleton.aliasPort(&mut skeleton.*, requestId, edge.target)
  let absent = Program.atom(&mut skeleton.rules)
  run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: incoming, target: input, active: active,
    directness: Directness.Preserve, stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(),
    read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
  run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: input, target: output, active: active,
    directness: Directness.Preserve, stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(),
    read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
  return true
}

effect fn activateRetainedAddresses<'body>(closure: &DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let requests = List<RetainedRequest>.asSlice(&skeleton.retainedRequests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let demands = List<Carriers.Demand>.asSlice(&closure.demands)
  let offset = List<SelectionUse>.length(&skeleton.selections)
  let count = List<AliasEdge>.length(&skeleton.aliasEdges)
  let mut changed = false
  let mut edgeId = usize.ZERO
  while edgeId < count {
    let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
    if let Option<usize>.Some {value: demandId} = retainedEdgeDemand(closure, edge) {
      let demand = demands[demandId]
      if demand.selectionUse >= offset {
        let request = demand.selectionUse - offset
        if request >= requests.length { return CompilerBug.panic(b"retained address omitted its explicit request") }
        let use = &requests[request]
        let alias = &List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
        // Supplemental slice-source Origins remain address evidence at conversion.source;
        // only the genuine final Slice bridge belongs to this execution request.
        if alias.evaluation.index == use.execution.index {
          let paths = List<RetainedPath>.asSlice(&use.paths)
          let mut path = usize.ZERO
          while path < paths.length {
            let selectors = List<MapId>.asSlice(&paths[path].selectors)
            let mut prefix = usize.ZERO
            while prefix < selectors.length {
              if maps[selectors[prefix].index].target.index == alias.endpoint.index {
                if run retainedPrefixRead(&mut skeleton.*, request, path, prefix + usize.ONE, edgeId) { changed = true }
              }
              prefix = prefix + usize.ONE
            }
            if alias.endpoint.index == paths[path].endpoint.index {
              let key = keys[demand.cell]
              let history = &witnesses[key.witness]
              let addresses = List<RetainedAddress>.asSlice(&skeleton.retainedAddresses)
              let mut found = false
              let mut at = usize.ZERO
              while at < addresses.length {
                if addresses[at].operation == use.operation && addresses[at].input == use.input
                  && addresses[at].slot == use.slot && addresses[at].path == path && addresses[at].edge == edgeId {
                  if addresses[at].descriptor.index != key.value.index || addresses[at].leaf.index != key.leaf.index
                    || addresses[at].direct != key.direct { return CompilerBug.panic(b"retained edge changed its original descriptor contributor") }
                  found = true
                }
                at = at + usize.ONE
              }
              if !found {
                run List<RetainedAddress>.append(&mut skeleton.retainedAddresses, RetainedAddress {operation: use.operation,
                  input: use.input, slot: use.slot, path: path, descriptor: key.value, leaf: key.leaf,
                  definition: history.definition, read: history.read, direct: key.direct, alias: edge.target,
                  edge: edgeId, storage: alias.storage, active: edge.active})
                changed = true
              }
            }
            path = path + usize.ONE
          }
        }
      }
    }
    edgeId = edgeId + usize.ONE
  }
  return changed
}

fn retainedHistory(history: &Witness, address: RetainedAddress) -> bool {
  let definition = match history.definition {
    Option<DefinitionId>.Some {value} => match address.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    Option<DefinitionId>.None => match address.definition { Option<DefinitionId>.None => true _ => false }
  }
  let read = match history.read {
    Option<ReadId>.Some {value} => match address.read { Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
    Option<ReadId>.None => match address.read { Option<ReadId>.None => true _ => false }
  }
  return definition && read
}

fn validateRetainedAddresses<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  closure: &DescriptorClosure, domain: &Domain) -> () {
  let requests = List<RetainedRequest>.asSlice(&skeleton.retainedRequests)
  let statuses = List<RetainedStatus>.asSlice(&skeleton.retainedStatus)
  let addresses = List<RetainedAddress>.asSlice(&skeleton.retainedAddresses)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let demands = List<Carriers.Demand>.asSlice(&closure.demands)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let offset = List<SelectionUse>.length(&skeleton.selections)
  if statuses.length != requests.length { CompilerBug.panic(b"retained requests lost explicit structural coverage") }
  let mut at = usize.ZERO
  while at < requests.length {
    let request = &requests[at]
    if statuses[at].request != at || request.selection.index >= selections.length {
      CompilerBug.panic(b"retained request lost its exact selection/status identity")
    }
    let row = &selections[request.selection.index]
    let retention = &List<Prepared.Retention>.asSlice(&prepared.retentions)[request.retention.index]
    let actual = Skeleton.evaluation(skeleton, request.operand)
    let source = match &endpoints[row.root.index].root {
      Root.Node {node, role: EndpointRole.Value} => match actual.site { EvaluationSite.Node {node: operand} => node.index == operand.index _ => false }
      _ => false
    }
    if !source || row.site.index != retention.site.index || Skeleton.evaluation(skeleton, request.execution).role != EvaluationRole.Execute {
      CompilerBug.panic(b"retained request confused original selector and actual execution")
    }
    let accepted = List<EndpointId>.asSlice(&row.accepts)
    let paths = List<RetainedPath>.asSlice(&request.paths)
    if paths.length != accepted.length { CompilerBug.panic(b"retained request lost an accepted physical path") }
    let mut path = usize.ZERO
    while path < paths.length {
      if paths[path].endpoint.index != accepted[path].index { CompilerBug.panic(b"retained request changed its original path order") }
      let selectors = List<MapId>.asSlice(&paths[path].selectors)
      let listed = List<MapId>.asSlice(&row.maps)
      let mut current = row.root
      let mut step = usize.ZERO
      while step < selectors.length {
        if selectors[step].index >= maps.length { CompilerBug.panic(b"retained path invented a selector map") }
        let map = &maps[selectors[step].index]
        let mut matches = usize.ZERO
        let mut each = usize.ZERO
        while each < listed.length { if listed[each].index == selectors[step].index { matches = matches + usize.ONE } each = each + usize.ONE }
        if matches != usize.ONE || map.site.index != retention.site.index || map.kind != MapKind.Select || map.source.index != current.index {
          CompilerBug.panic(b"retained path lost its exact originating selector chain")
        }
        current = map.target
        step = step + usize.ONE
      }
      if current.index != paths[path].endpoint.index { CompilerBug.panic(b"retained path changed its selected frontier") }
      path = path + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < addresses.length {
    let address = addresses[at]
    if address.edge >= edges.length || address.alias >= aliases.length { CompilerBug.panic(b"retained address lost its exact alias proof") }
    let edge = edges[address.edge]
    let demandId = match retainedEdgeDemand(closure, edge) { Option<usize>.Some {value} => value
      _ => { return CompilerBug.panic(b"retained address replaced its actual descriptor proof") } }
    let demand = demands[demandId]
    if demand.selectionUse < offset || demand.selectionUse - offset >= requests.length {
      CompilerBug.panic(b"retained address borrowed an ordinary projection demand")
    }
    let request = &requests[demand.selectionUse - offset]
    let paths = List<RetainedPath>.asSlice(&request.paths)
    let key = keys[demand.cell]
    let alias = &aliases[address.alias]
    if address.operation != request.operation || address.input != request.input || address.slot != request.slot
      || address.path >= paths.length || alias.endpoint.index != paths[address.path].endpoint.index
      || alias.evaluation.index != request.execution.index || address.alias != edge.target || address.active.index != edge.active.index
      || !sameStorage(address.storage, alias.storage) || address.descriptor.index != key.value.index
      || address.leaf.index != key.leaf.index || address.direct != key.direct || !retainedHistory(&witnesses[key.witness], address) {
      CompilerBug.panic(b"retained address changed its exact descriptor contributor, witness or canonical storage")
    }
    at = at + usize.ONE
  }
  let reads = List<RetainedRead>.asSlice(&skeleton.retainedReads)
  let canonical = List<ReadValue>.asSlice(&skeleton.reads)
  let values = List<Value>.asSlice(&skeleton.values)
  let transports = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let recorded = List<AliasRead>.asSlice(&skeleton.aliasReads)
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.request >= requests.length || read.read.index >= canonical.length || read.consumer.index >= values.length
      || read.edge >= edges.length || read.alias >= aliases.length { CompilerBug.panic(b"retained current read lost its real reservation") }
    let request = &requests[read.request]
    let paths = List<RetainedPath>.asSlice(&request.paths)
    if read.path >= paths.length { CompilerBug.panic(b"retained read changed its originating path") }
    let selectors = List<MapId>.asSlice(&paths[read.path].selectors)
    if read.prefix == usize.ZERO || read.prefix > selectors.length { CompilerBug.panic(b"retained read has no exact selected prefix") }
    let endpoint = maps[selectors[read.prefix - usize.ONE].index].target
    let input = values[read.consumer.index]
    if input.phase != ValuePhase.Input || input.evaluation.index != request.execution.index || input.endpoint.index != endpoint.index
      || edges[read.edge].target != read.alias || aliases[read.alias].endpoint.index != endpoint.index
      || !sameStorage(canonical[read.read.index].storage, aliases[read.alias].storage) {
      CompilerBug.panic(b"retained read replaced current canonical contents with an old operand")
    }
    let mut found = false
    let mut each = usize.ZERO
    while each < recorded.length {
      if recorded[each].read.index == read.read.index {
        let transport = transports[recorded[each].request]
        if let AliasConsumer.Retained {request: selected, path, prefix, edge} = transport.authority {
          if selected == read.request && path == read.path && prefix == read.prefix && edge == read.edge
            && transport.active.index == read.active.index && transport.alias == read.alias { found = true }
        }
      }
      each = each + usize.ONE
    }
    if !found { CompilerBug.panic(b"retained read lost its original edge-gated consumer") }
    at = at + usize.ONE
  }
  return ()
}

effect fn sliceSourceDemands<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let oldProofs = List<SliceProof>.length(&closure.sliceProofs)
  let oldDemands = List<Carriers.Demand>.length(&closure.demands)
  let oldLinks = List<SliceDemand>.length(&closure.sliceDemands)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let nodes = Carriers.Product.nodes(&closure.product)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let conversions = List<SliceConversion>.asSlice(&skeleton.slices)
  let values = List<Value>.asSlice(&skeleton.values)
  let empty = List<Atom>.make()
  let mut nodeId = usize.ZERO
  while nodeId < nodes.length {
    let node = nodes[nodeId]
    let mut conversionId = usize.ZERO
    while conversionId < conversions.length {
      let conversion = conversions[conversionId]
      if keys[node.cell].value.index == conversion.descriptor.index {
        let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
        let selector = residualComponent(List<Prepared.Shape>.asSlice(&prepared.shapes), states[node.state.index].input)
        let indexed = match &selector.selector { Selector.Index {..} => true _ => false }
        if !indexed { return CompilerBug.panic(b"slice conversion was asked to create a non-index address") }
        let mut caseId = usize.ZERO
        while caseId < cases.length {
          let actual = &cases[caseId]
          let exact = match actual.authority {
            TransferAuthority.Physical {map, direction: MapDirection.Forward, address: Option<EvalId>.None} =>
              map.index == row.descriptor.index && actual.target == node.cell
            _ => false
          }
          if exact {
            let source = match actual.source { Option<usize>.Some {value} => value
              _ => { return CompilerBug.panic(b"slice conversion substituted a new descriptor seed") } }
            let operand = values[keys[source].value.index]
            if operand.evaluation.index != conversion.source.index || operand.endpoint.index != maps[row.descriptor.index].source.index {
              return CompilerBug.panic(b"slice conversion changed its real source descriptor occurrence")
            }
            let retained = List<SliceProof>.asSlice(&closure.sliceProofs)
            let mut proof = usize.MAX
            let mut each = usize.ZERO
            while each < retained.length {
              if retained[each].carrier == nodeId && retained[each].case == caseId
                && retained[each].conversion == conversionId { proof = each }
              each = each + usize.ONE
            }
            if proof == usize.MAX {
              proof = retained.length
              let active = Program.atom(&mut skeleton.rules)
              let gates: [Atom; 2] = [node.active, actual.active]
              run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
              run List<SliceProof>.append(&mut closure.sliceProofs, SliceProof {carrier: nodeId,
                case: caseId, conversion: conversionId, active: active})
            }
            let elements = List<Prepared.ArraySliceElement>.asSlice(&row.elements)
            let outer = List<Carriers.Demand>.asSlice(&closure.demands)[node.demand]
            let mut element = usize.ZERO
            while element < elements.length {
              let mut found = false
              let prior = List<SliceDemand>.asSlice(&closure.sliceDemands)
              each = usize.ZERO
              while each < prior.length {
                if prior[each].proof == proof && prior[each].element == element { found = true }
                each = each + usize.ONE
              }
              if !found {
                let mut referent = usize.MAX
                let mut state = usize.ZERO
                while state < states.length {
                  if authoredResidual(&states[state]) && states[state].selection.index == elements[element].selection.index
                    && states[state].vertex.index == maps[row.referent.index].target.index
                    && states[state].input.shape.index == valueShape(prepared, operand).index {
                    if referent != usize.MAX { return CompilerBug.panic(b"slice source has ambiguous frozen referent histories") }
                    referent = state
                  }
                  state = state + usize.ONE
                }
                if referent == usize.MAX { return CompilerBug.panic(b"slice source lost its explicit Referent/Index history") }
                // A backedge may discover another conversion proof for this SAME
                // source demand. Intern by finite actual query/cell/history, not by the
                // recursively discovered proof ordinal; alternatives add gated rules.
                let existing = List<Carriers.Demand>.asSlice(&closure.demands)
                let links = List<SliceDemand>.asSlice(&closure.sliceDemands)
                let mut demand = usize.MAX
                let mut link = usize.ZERO
                while link < links.length {
                  let candidate = existing[links[link].demand]
                  if candidate.selectionUse == outer.selectionUse && candidate.cell == source
                    && candidate.state.index == referent { demand = links[link].demand }
                  link = link + usize.ONE
                }
                if demand == usize.MAX {
                  demand = existing.length
                  let active = Program.atom(&mut skeleton.rules)
                  run List<Carriers.Demand>.append(&mut closure.demands, Carriers.Demand {selectionUse: outer.selectionUse,
                    cell: source, state: Prepared.ResidualStateId {index: referent}, active: active, reachable: outer.reachable})
                }
                let gate: [Atom; 1] = [List<SliceProof>.asSlice(&closure.sliceProofs)[proof].active]
                run Program.rule(&mut skeleton.rules, List<Carriers.Demand>.asSlice(&closure.demands)[demand].active,
                  &gate, List<Atom>.asSlice(&empty))
                run List<SliceDemand>.append(&mut closure.sliceDemands, SliceDemand {demand: demand, proof: proof, element: element})
              }
              element = element + usize.ONE
            }
          }
          caseId = caseId + usize.ONE
        }
      }
      conversionId = conversionId + usize.ONE
    }
    nodeId = nodeId + usize.ONE
  }
  return oldProofs != List<SliceProof>.length(&closure.sliceProofs)
    || oldDemands != List<Carriers.Demand>.length(&closure.demands)
    || oldLinks != List<SliceDemand>.length(&closure.sliceDemands)
}

effect fn closeDescriptors<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let keys = List<CellKey>.asSlice(&domain.keys)
  run descriptorDemands(&mut closure.*, prepared, &skeleton.*, keys)
  run retainedDescriptorDemands(&mut closure.*, prepared, &mut skeleton.*, keys, List<Cell>.asSlice(&domain.cells))
  let mut cells = List<Carriers.Cell>.make()
  let mut index = usize.ZERO
  while index < keys.length {
    let actual = List<Value>.asSlice(&skeleton.values)[keys[index].value.index]
    let mut subject = Option<Prepared.ResidualStateId>.none()
    if let Option<ResidualSubject>.Some {value} = actual.subject { subject = Option<Prepared.ResidualStateId>.some(value.state) }
    run List<Carriers.Cell>.append(&mut cells, Carriers.Cell {value: keys[index].value.index,
      endpoint: actual.endpoint, shape: valueShape(prepared, actual), leaf: keys[index].leaf.index, subject: subject})
    index = index + usize.ONE
  }
  let actualCases = List<Case>.asSlice(&domain.cases)
  let mut cases = List<Carriers.Case>.make()
  index = usize.ZERO
  while index < actualCases.length {
    let actual = &actualCases[index]
    let authority = carrierAuthority(prepared, &skeleton.*, keys, actual)
    run List<Carriers.Case>.append(&mut cases, Carriers.Case {source: actual.source, target: actual.target,
      active: actual.active, authority: authority})
    index = index + usize.ONE
  }
  let mut changed = run Carriers.Product.close(&mut closure.product, prepared, List<Carriers.Cell>.asSlice(&cells),
    List<Carriers.Case>.asSlice(&cases), List<Carriers.Pair>.asSlice(&closure.pairs),
    List<Carriers.Demand>.asSlice(&closure.demands), &mut skeleton.rules)
  if run sliceSourceDemands(&mut closure.*, prepared, &mut skeleton.*, domain) { changed = true }
  let nodes = Carriers.Product.nodes(&closure.product)
  let references = List<ReferenceOrigin>.asSlice(&skeleton.references)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  index = usize.ZERO
  while index < nodes.length {
    let node = nodes[index]
    let key = keys[node.cell]
    let mut origin = usize.ZERO
    while origin < references.length {
      let reference = references[origin]
      if key.value.index == reference.descriptor.index && key.leaf.index == reference.leaf.index {
        validateReferenceMaps(endpoints, maps, reference.map, reference.referent)
        let state = &states[node.state.index]
        let components = List<Prepared.Component>.asSlice(&List<Prepared.Shape>.asSlice(&prepared.shapes)[state.input.shape.index].components)
        let through = match &components[state.input.ordinal].selector { Selector.Referent => true _ => false }
        if !through || state.output.index != endpoints[maps[reference.referent.index].target.index].shape.index {
          return CompilerBug.panic(b"descriptor origin changed the demanded referent subject")
        }
        let mut seed = usize.ZERO
        while seed < actualCases.length {
          let seedCase = &actualCases[seed]
          let genuine = match seedCase.source { Option<usize>.None => seedCase.target == node.cell _ => false }
          if genuine {
            let mut alias = usize.ZERO
            while alias < aliases.length {
              let source = aliases[alias]
              if source.evaluation.index == reference.source.index && source.endpoint.index == maps[reference.map.index].source.index {
                let prior = List<OriginProof>.asSlice(&closure.origins)
                let mut found = false
                let mut earlier = usize.ZERO
                while earlier < prior.length {
                  if prior[earlier].carrier == index && prior[earlier].seed == seed
                    && prior[earlier].origin == origin && prior[earlier].sourceAlias == alias { found = true }
                  earlier = earlier + usize.ONE
                }
                if !found {
                  let active = Program.atom(&mut skeleton.rules)
                  let gates: [Atom; 3] = [node.active, seedCase.active, source.active]
                  let empty = List<Atom>.make()
                  run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
                  run List<OriginProof>.append(&mut closure.origins, OriginProof {carrier: index, seed: seed,
                    origin: origin, sourceAlias: alias, active: active})
                  changed = true
                }
              }
              alias = alias + usize.ONE
            }
          }
          seed = seed + usize.ONE
        }
      }
      origin = origin + usize.ONE
    }
    index = index + usize.ONE
  }
  if run activateOriginPlacements(&mut closure.*, prepared, &mut skeleton.*) { changed = true }
  if run activateSlicePlacements(&mut closure.*, prepared, &mut skeleton.*) { changed = true }
  if run activateRetainedAddresses(&closure.*, prepared, &mut skeleton.*, domain) { changed = true }
  if run closeContents(&mut closure.*, prepared, &mut skeleton.*, domain) { changed = true }
  return changed
}

struct Domain {
  cells: List<Cell>
  keys: List<CellKey>
  witnesses: List<Witness>
  cases: List<Case>
  policies: List<PendingPolicy>
  seedWitnesses: List<usize>
  pairWitnesses: List<usize>
  scannedTransfers: List<usize>
}

impl Domain {
  fn make() -> Self {
    return Domain {cells: List<Cell>.make(), keys: List<CellKey>.make(), witnesses: List<Witness>.make(),
      cases: List<Case>.make(), policies: List<PendingPolicy>.make(), seedWitnesses: List<usize>.make(),
      pairWitnesses: List<usize>.make(), scannedTransfers: List<usize>.make()}
  }
}

// Extends finite candidate topology and emits rules in the SAME program. This does not solve
// source/policy truth. Late boundary reads may add pairs/seeds/transfers without renumbering
// prior witness, case or policy IDs; no earlier decision or gate is replayed/replaced.
effect fn extendDomain(domain: &mut Domain, rules: &mut Program, points: &[Point], pairs: &[Pair],
  evaluations: &[Evaluation], values: &[Value], seeds: &[Seed], transfers: &[Transfer]) -> ()
! OutOfMemoryError ? &mut Allocator {
  let firstSeed = List<usize>.length(&domain.seedWitnesses)
  if firstSeed > seeds.length || List<usize>.length(&domain.pairWitnesses) > pairs.length {
    CompilerBug.panic(b"source candidate reservation cannot shrink its seed or reaching-pair universe")
  }
  let mut seed = firstSeed
  while seed < seeds.length {
    let witness = List<Witness>.length(&domain.witnesses)
    run List<Witness>.append(&mut domain.witnesses, Witness {definition: Option<DefinitionId>.none(), read: Option<ReadId>.none()})
    run List<usize>.append(&mut domain.seedWitnesses, witness)
    seed = seed + usize.ONE
  }
  let mut pair = List<usize>.length(&domain.pairWitnesses)
  while pair < pairs.length {
    let witness = List<Witness>.length(&domain.witnesses)
    run List<Witness>.append(&mut domain.witnesses, Witness {definition: Option<DefinitionId>.some(pairs[pair].definition),
      read: Option<ReadId>.some(pairs[pair].read)})
    run List<usize>.append(&mut domain.pairWitnesses, witness)
    pair = pair + usize.ONE
  }
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  let mut index = firstSeed
  while index < seeds.length {
    let seed = seeds[index]
    let target = run reserveCell(&mut domain.keys, &mut domain.cells, &mut rules.*,
      CellKey {value: seed.value, leaf: seed.leaf, witness: List<usize>.asSlice(&domain.seedWitnesses)[index], direct: seed.direct})
    let cell = List<Cell>.asSlice(&domain.cells)[target]
    let active = Program.atom(&mut rules.*)
    let reach = points[evaluations[values[seed.value.index].evaluation.index].point.index].reachable
    let admitted: [Atom; 2] = [seed.active, reach]
    run Program.rule(&mut rules.*, active, &admitted, none)
    let present: [Atom; 1] = [active]
    run Program.rule(&mut rules.*, cell.present, &present, none)
    let stored: [Atom; 2] = [active, seed.stored]
    run Program.rule(&mut rules.*, cell.stored, &stored, none)
    let alternatives: [Atom; 2] = [active, seed.alternatives]
    run Program.rule(&mut rules.*, cell.alternatives, &alternatives, none)
    run List<Case>.append(&mut domain.cases, Case { source: Option<usize>.none(), target: target, active: active, quality: cell,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), authority: TransferAuthority.SameComponent})
    index = index + usize.ONE
  }
  // Candidate closure follows physical topology only. It reads no Truth and ignores every
  // policy/CFG gate, including late backedges. It reserves cells, not source witnesses.
  // Each key/transfer pair is processed once, including transfers appended after the key.
  index = usize.ZERO
  while index < List<CellKey>.length(&domain.keys) {
    let key = List<CellKey>.asSlice(&domain.keys)[index]
    while List<usize>.length(&domain.scannedTransfers) <= index {
      run List<usize>.append(&mut domain.scannedTransfers, usize.ZERO)
    }
    let mut transferIndex = List<usize>.asSlice(&domain.scannedTransfers)[index]
    if transferIndex > transfers.length { CompilerBug.panic(b"source transfer reservation cannot shrink") }
    while transferIndex < transfers.length {
      let transfer = &transfers[transferIndex]
      if transfer.source.index == key.value.index {
        let direct = match transfer.directness {
          Directness.Preserve => key.direct
          Directness.Direct => true
          Directness.Indirect => false
        }
        let mut targetWitness = key.witness
        let mut paired = Option<Atom>.none()
        if let Option<DefinitionId>.Some {value: definition} = transfer.definition {
          if let Option<ReadId>.Some {value: read} = transfer.read {
            let mut pairIndex = usize.ZERO
            while pairIndex < pairs.length {
              if pairs[pairIndex].definition.index == definition.index && pairs[pairIndex].read.index == read.index {
                targetWitness = List<usize>.asSlice(&domain.pairWitnesses)[pairIndex]
                paired = Option<Atom>.some(pairs[pairIndex].active)
                break
              }
              pairIndex = pairIndex + usize.ONE
            }
            if let Option<Atom>.None = paired { CompilerBug.panic(b"source transfer has no matching definition/read pair") }
          } else { CompilerBug.panic(b"source transfer omits its paired read") }
        } else {
          if let Option<ReadId>.Some {value: ignored} = transfer.read { CompilerBug.panic(b"source transfer omits its paired definition") }
        }
        let target = run reserveCell(&mut domain.keys, &mut domain.cells, &mut rules.*,
          CellKey {value: transfer.target, leaf: key.leaf, witness: targetWitness, direct: direct})
        let input = List<Cell>.asSlice(&domain.cells)[index]
        let output = List<Cell>.asSlice(&domain.cells)[target]
        let applicable = Program.atom(&mut rules.*)
        let reach = points[evaluations[values[transfer.target.index].evaluation.index].point.index].reachable
        if let Option<Atom>.Some {value: pairGate} = paired {
          let admitted: [Atom; 4] = [input.present, transfer.active, reach, pairGate]
          run Program.rule(&mut rules.*, applicable, &admitted, none)
        } else {
          let admitted: [Atom; 3] = [input.present, transfer.active, reach]
          run Program.rule(&mut rules.*, applicable, &admitted, none)
        }
        let mut active = applicable
        let mut addedStored = transfer.stored
        let mut addedAlternatives = transfer.alternatives
        if transfer.policy == TransferPolicy.Filtered {
          let id = PolicyPortId {index: List<PendingPolicy>.length(&domain.policies)}
          let kept = Program.atom(&mut rules.*)
          let stored = Program.atom(&mut rules.*)
          let alternatives = Program.atom(&mut rules.*)
          let transferStored: [Atom; 1] = [transfer.stored]
          let transferAlternatives: [Atom; 1] = [transfer.alternatives]
          run Program.rule(&mut rules.*, stored, &transferStored, none)
          run Program.rule(&mut rules.*, alternatives, &transferAlternatives, none)
          // Reservation never consults this gate. Even when a later policy drops this
          // source, all downstream candidate cells and their own ports already exist.
          let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
          run List<PendingPolicy>.append(&mut domain.policies, PendingPolicy {
            port: PolicyPort {terminal: transfer.terminal, authority: transfer.authority, active: transfer.active, id: id, transfer: transferIndex, source: transfer.source,
              target: transfer.target, leaf: key.leaf, direct: key.direct, outputDirect: direct,
              map: authorityMap(transfer.authority), contract: authorityContract(transfer.authority), direction: authorityDirection(transfer.authority), address: authorityAddress(transfer.authority),
              definition: witness.definition, read: witness.read,
              quality: Cell {present: applicable, stored: input.stored, alternatives: input.alternatives}},
            sourceCell: index, kept: kept, stored: stored, alternatives: alternatives, bound: false})
          active = Program.atom(&mut rules.*)
          let selected: [Atom; 2] = [applicable, kept]
          run Program.rule(&mut rules.*, active, &selected, none)
          addedStored = stored
          addedAlternatives = alternatives
        }
        let present: [Atom; 1] = [active]
        run Program.rule(&mut rules.*, output.present, &present, none)
        let caseStored = Program.atom(&mut rules.*)
        let caseAlternatives = Program.atom(&mut rules.*)
        let stored: [Atom; 2] = [active, input.stored]
        run Program.rule(&mut rules.*, caseStored, &stored, none)
        let newStored: [Atom; 2] = [active, addedStored]
        run Program.rule(&mut rules.*, caseStored, &newStored, none)
        let alternatives: [Atom; 2] = [active, input.alternatives]
        run Program.rule(&mut rules.*, caseAlternatives, &alternatives, none)
        let newAlternatives: [Atom; 2] = [active, addedAlternatives]
        run Program.rule(&mut rules.*, caseAlternatives, &newAlternatives, none)
        let storedOutput: [Atom; 1] = [caseStored]
        let alternativesOutput: [Atom; 1] = [caseAlternatives]
        run Program.rule(&mut rules.*, output.stored, &storedOutput, none)
        run Program.rule(&mut rules.*, output.alternatives, &alternativesOutput, none)
        run List<Case>.append(&mut domain.cases, Case { source: Option<usize>.some(index), target: target, active: active,
          quality: Cell {present: active, stored: caseStored, alternatives: caseAlternatives},
          definition: transfer.definition, read: transfer.read, authority: transfer.authority})
      }
      transferIndex = transferIndex + usize.ONE
    }
    List<usize>.asMutSlice(&mut domain.scannedTransfers)[index] = transfers.length
    index = index + usize.ONE
  }
  return ()
}

impl<'body> Builder<'body> {
  pub fn operationResults(self: &Self) -> &Results.Inventory { return &self.operationResults }
  pub fn operationContributors(self: &Self) -> &[OperationContributor] { return List<OperationContributor>.asSlice(&self.operationContributors) }

  pub fn stores(self: &Self) -> &Stores.Inventory { return &self.stores }
  pub fn writeCandidate(self: &Self, id: usize) -> RetainedWrite {
    let values = List<RetainedWrite>.asSlice(&self.writes)
    if id >= values.length { return CompilerBug.panic(b"retained policy names an absent write candidate") }
    return values[id]
  }
  pub fn writeHolder(self: &Self, id: usize) -> &WriteHolder {
    let values = List<WriteHolder>.asSlice(&self.writeHolders)
    if id >= values.length { return CompilerBug.panic(b"retained policy names an absent holder update") }
    return &values[id]
  }
  /// Actual address proofs only; a matching endpoint without its occurrence/gate is not identity.
  pub fn aliases(self: &Self) -> &[StorageAlias] { return List<StorageAlias>.asSlice(&self.aliases) }
  pub fn retainedRequests(self: &Self) -> &[RetainedRequest] { return List<RetainedRequest>.asSlice(&self.retainedRequests) }
  pub fn retainedAddresses(self: &Self) -> &[RetainedAddress] { return List<RetainedAddress>.asSlice(&self.retainedAddresses) }
  pub fn retainedStatus(self: &Self) -> &[RetainedStatus] { return List<RetainedStatus>.asSlice(&self.retainedStatus) }
  pub fn retainedReads(self: &Self) -> &[RetainedRead] { return List<RetainedRead>.asSlice(&self.retainedReads) }

  pub fn preparation(self: &Self) -> &SourcePreparation<'body> { return &self.preparation }

  /// Physical reservation order only; operation operands keep the visitor's explicit order.
  pub fn values(self: &Self) -> &[Value] { return List<Value>.asSlice(&self.values) }
  pub fn value(self: &Self, id: ValueId) -> Value {
    let values = List<Value>.asSlice(&self.values)
    if id.index >= values.length { return CompilerBug.panic(b"source consumer names an absent value") }
    return values[id.index]
  }
  pub fn valueShape(self: &Self, id: ValueId) -> ShapeId {
    return valueShape(&self.preparation, Builder.value(&self.*, id))
  }
  pub fn evaluation(self: &Self, id: EvalId) -> Evaluation {
    let evaluations = List<Evaluation>.asSlice(&self.evaluations)
    if id.index >= evaluations.length { return CompilerBug.panic(b"source consumer names an absent evaluation") }
    return evaluations[id.index]
  }
  pub fn definitionCount(self: &Self) -> usize { return List<DefinedValue>.length(&self.definitions) }
  pub fn readCount(self: &Self) -> usize { return List<ReadValue>.length(&self.reads) }
  pub fn definition(self: &Self, id: DefinitionId) -> DefinitionView {
    return definitionView(&self.reaching, List<Storage>.asSlice(&self.storage), List<DefinedValue>.asSlice(&self.definitions), id)
  }
  pub fn read(self: &Self, id: ReadId) -> ReadView {
    return readView(&self.reaching, List<Storage>.asSlice(&self.storage), List<ReadValue>.asSlice(&self.reads), id)
  }

  /// Allocates only the matching actual placements; it emits no rules and performs no solve.
  pub effect fn readPlacementsByRead(self: &Self, read: ReadId) -> List<ReadPlacement>
  ! OutOfMemoryError ? &mut Allocator {
    return run readPlacementsByRead(&self.preparation, &self.reaching, List<Storage>.asSlice(&self.storage),
      List<ReadValue>.asSlice(&self.reads), List<Value>.asSlice(&self.values),
      List<Evaluation>.asSlice(&self.evaluations), List<StorageAlias>.asSlice(&self.aliases),
      List<AliasTransport>.asSlice(&self.aliasTransports), List<AliasRead>.asSlice(&self.aliasReads), read)
  }

  pub effect fn readPlacements(self: &Self, value: ValueId, read: ReadId) -> List<ReadPlacement>
  ! OutOfMemoryError ? &mut Allocator {
    return run readPlacements(&self.preparation, &self.reaching, List<Storage>.asSlice(&self.storage),
      List<ReadValue>.asSlice(&self.reads), List<Value>.asSlice(&self.values),
      List<Evaluation>.asSlice(&self.evaluations), List<StorageAlias>.asSlice(&self.aliases),
      List<AliasTransport>.asSlice(&self.aliasTransports), List<AliasRead>.asSlice(&self.aliasReads), value, read)
  }

  /// Reserves the finite typed-topology value/leaf/witness/directness domain and emits source rules.
  /// Cases retain each paired edge; their alternatives do not multiply physical operands.
  pub effect fn reserve(preparation: SourcePreparation<'body>, skeleton: Skeleton) -> Self
  ! OutOfMemoryError ? &mut Allocator {
    validateShapeContexts(&preparation)
    run validatePreparedOperations(&preparation)
    validateResiduals(&preparation)
    validateBoundaryLifts(&preparation)
    validateContractProducts(&preparation)
    let mut closed = move skeleton
    run Skeleton.activateSelections(&mut closed, &preparation)
    let mut domain = Domain.make()
    let mut descriptors = DescriptorClosure.make()
    let mut emitted = usize.ZERO
    let mut extending = true
    while extending {
      let aliases = run Skeleton.activateAliasOperations(&mut closed, List<Endpoint>.asSlice(&preparation.endpoints),
        List<SelectionMap>.asSlice(&preparation.maps))
      let transports = run Skeleton.activateAliasTransports(&mut closed, List<SelectionMap>.asSlice(&preparation.maps))
      let storage = run Skeleton.closeStorage(&mut closed)
      // Normalize only new arrivals before their candidate/policy rules are emitted. A late
      // canonical read joins the same Input; it must not rewrite an already filtered Output
      // or create a second policy observation of previously emitted histories.
      run Skeleton.prepareReadResults(&mut closed, &preparation, emitted)
      run Skeleton.activateResults(&mut closed, &preparation, emitted)
      let transfers = List<Transfer>.length(&closed.transfers)
      run extendDomain(&mut domain, &mut closed.rules, Flow.reservedPoints(&closed.flow), Flow.reservedPairs(&closed.flow),
        List<Evaluation>.asSlice(&closed.evaluations), List<Value>.asSlice(&closed.values),
        List<Seed>.asSlice(&closed.seeds), List<Transfer>.asSlice(&closed.transfers))
      let carried = run closeDescriptors(&mut descriptors, &preparation, &mut closed, &domain)
      let written = run Skeleton.closeRetainedWrites(&mut closed, &preparation)
      extending = aliases || transports || storage || carried || written || transfers != emitted
      emitted = transfers
    }
    validateRetainedAddresses(&preparation, &closed, &descriptors, &domain)
    validateRetainedWrites(&preparation, &closed)
    let skeleton = move closed
    let mut rules = move skeleton.rules
    let reaching = run Flow.emit(move skeleton.flow, &mut rules)
    let transfers = move skeleton.transfers
    validateStorage(List<SelectionMap>.asSlice(&preparation.maps), &reaching, List<Storage>.asSlice(&skeleton.storage), List<DefinedValue>.asSlice(&skeleton.definitions),
      List<ReadValue>.asSlice(&skeleton.reads), List<Value>.asSlice(&skeleton.values),
      List<Evaluation>.asSlice(&skeleton.evaluations))
    validateReferenceOrigins(&preparation, List<ReferenceOrigin>.asSlice(&skeleton.references),
      List<Evaluation>.asSlice(&skeleton.evaluations), List<Value>.asSlice(&skeleton.values), List<Leaf>.asSlice(&skeleton.leaves))
    run validateAliasGraph(&preparation, List<Evaluation>.asSlice(&skeleton.evaluations),
      List<StorageAlias>.asSlice(&skeleton.aliases), List<AliasEdge>.asSlice(&skeleton.aliasEdges),
      List<ReferenceOrigin>.asSlice(&skeleton.references), List<SelectionUse>.asSlice(&skeleton.selections),
      List<RetainedRequest>.asSlice(&skeleton.retainedRequests), List<SliceConversion>.asSlice(&skeleton.slices), &descriptors)
    validateContents(&preparation, List<AliasEdge>.asSlice(&skeleton.aliasEdges), List<Case>.asSlice(&domain.cases), &descriptors)
    validateAliasPorts(List<Value>.asSlice(&skeleton.values), List<StorageAlias>.asSlice(&skeleton.aliases),
      List<AliasTransport>.asSlice(&skeleton.aliasTransports))
    run validateReservation(&preparation, &reaching, List<Evaluation>.asSlice(&skeleton.evaluations),
      List<Value>.asSlice(&skeleton.values), List<Leaf>.asSlice(&skeleton.leaves),
      List<Seed>.asSlice(&skeleton.seeds), List<Transfer>.asSlice(&transfers), List<StorageAlias>.asSlice(&skeleton.aliases), List<AliasEdge>.asSlice(&skeleton.aliasEdges), List<AliasTransport>.asSlice(&skeleton.aliasTransports), List<Storage>.asSlice(&skeleton.storage), List<RetainedWrite>.asSlice(&skeleton.writes))
    return Builder<'body> {operationResults: move skeleton.operationResults, operationContributors: move skeleton.operationContributors, stores: move skeleton.stores, writes: move skeleton.writes, writeHolders: move skeleton.writeHolders, rules: move rules, reaching: move reaching, storage: move skeleton.storage,
      selections: move skeleton.selections, retainedRequests: move skeleton.retainedRequests, retainedAddresses: move skeleton.retainedAddresses, retainedStatus: move skeleton.retainedStatus, retainedReads: move skeleton.retainedReads, descriptors: move descriptors, aliases: move skeleton.aliases, aliasEdges: move skeleton.aliasEdges,
      aliasTransports: move skeleton.aliasTransports, aliasReads: move skeleton.aliasReads, references: move skeleton.references, slices: move skeleton.slices, definitions: move skeleton.definitions, reads: move skeleton.reads, preparation: move preparation,
      evaluations: move skeleton.evaluations, executions: move skeleton.executions, values: move skeleton.values, leaves: move skeleton.leaves,
      cells: move domain.cells, keys: move domain.keys, witnesses: move domain.witnesses, cases: move domain.cases,
      policies: move domain.policies}
  }

  pub fn cell(self: &Self, value: ValueId, leaf: LeafId, witness: usize, direct: bool) -> Option<Cell> {
    let index = findCell(List<CellKey>.asSlice(&self.keys), value, leaf, witness, direct)
    if index == usize.MAX { return Option<Cell>.none() }
    return Option<Cell>.some(List<Cell>.asSlice(&self.cells)[index])
  }

  pub fn leaf(self: &Self, leaf: LeafId) -> &Leaf {
    let leaves = List<Leaf>.asSlice(&self.leaves)
    if leaf.index >= leaves.length { CompilerBug.panic(b"policy input names an unreserved source leaf") }
    return &leaves[leaf.index]
  }

  /// Creation identity only. A caller must still prove this descriptor reaches the exact
  /// selected operand component; this record does not authenticate nested contents or a
  /// declared result route and does not sample the source's current precision.
  pub fn referenceOrigin(self: &Self, leaf: LeafId) -> Option<ReferenceOrigin> {
    if leaf.index >= List<Leaf>.length(&self.leaves) {
      return CompilerBug.panic(b"reference origin names an absent source leaf")
    }
    let origins = List<ReferenceOrigin>.asSlice(&self.references)
    let mut at = usize.ZERO
    while at < origins.length {
      if origins[at].leaf.index == leaf.index { return Option<ReferenceOrigin>.some(origins[at]) }
      at = at + usize.ONE
    }
    return Option<ReferenceOrigin>.none()
  }

  /// Called once at each operation's input barrier. The caller supplies written operand and
  /// structural component order; this returns stable leaf order within that physical position.
  /// No candidate Truth is inspected and none of the inputs can depend on a selected output.
  pub effect fn inputs(self: &mut Self, value: ValueId) -> List<Input>
  ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.values)
    if value.index >= values.length { CompilerBug.panic(b"policy input names an unreserved physical value") }
    return run inputPositions(&mut self.rules, value, List<Leaf>.length(&self.leaves), values,
      List<CellKey>.asSlice(&self.keys), List<Cell>.asSlice(&self.cells),
      List<Witness>.asSlice(&self.witnesses), List<Case>.asSlice(&self.cases))
  }

  pub effect fn solve(self: Self) -> Graph<'body> ! OutOfMemoryError ? &mut Allocator {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    let mut at = usize.ZERO
    while at < policies.length {
      if !policies[at].bound { CompilerBug.panic(b"source policy omitted a reserved candidate decision") }
      at = at + usize.ONE
    }
    let solution = run Program.solve(&self.rules)
    let stamp = run Shared<Stamp>.make(Stamp {marker: true})
    return Graph<'body> {operationResults: move self.operationResults, operationContributors: move self.operationContributors, stores: move self.stores, writes: move self.writes, writeHolders: move self.writeHolders, stamp: move stamp, preparation: move self.preparation, solution: move solution,
      reaching: move self.reaching, storage: move self.storage, selections: move self.selections, retainedRequests: move self.retainedRequests, retainedAddresses: move self.retainedAddresses, retainedStatus: move self.retainedStatus, retainedReads: move self.retainedReads, descriptors: move self.descriptors, aliases: move self.aliases, aliasEdges: move self.aliasEdges,
      aliasTransports: move self.aliasTransports, aliasReads: move self.aliasReads, references: move self.references, slices: move self.slices, definitions: move self.definitions, reads: move self.reads, evaluations: move self.evaluations, executions: move self.executions, values: move self.values,
      leaves: move self.leaves, cells: move self.cells, keys: move self.keys, witnesses: move self.witnesses, cases: move self.cases}
  }

  pub fn policyCount(self: &Self) -> usize { return List<PendingPolicy>.length(&self.policies) }

  pub fn policy(self: &Self, index: usize) -> PolicyPort {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if index >= policies.length { CompilerBug.panic(b"source policy names an absent decision port") }
    return policies[index].port
  }

  /// Predecessor routes of this paired source are still alternatives, not additional scan
  /// positions. A consumer needing placement/contract evidence must use each complete case.
  pub effect fn policyCases(self: &Self, id: PolicyPortId) -> List<InputCase>
  ! OutOfMemoryError ? &mut Allocator {
    let policies = List<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { CompilerBug.panic(b"source policy names an absent decision port") }
    let mut result = List<InputCase>.make()
    run appendInputCases(&mut result, policies[id.index].sourceCell, List<Value>.asSlice(&self.values),
      List<CellKey>.asSlice(&self.keys), List<Witness>.asSlice(&self.witnesses), List<Case>.asSlice(&self.cases))
    return move result
  }

  /// Every candidate must be bound exactly once, including absent/unknown/loan-free cases.
  /// The arguments are rules in this same program, not sampled Truth values or final precision.
  pub effect fn bindPolicy(self: &mut Self, port: PolicyPortId, kept: Atom, stored: Atom, alternatives: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Builder.policy(&self.*, port.index)
    if let TransferAuthority.RetainedWrite {candidate} = actual.authority {
      let selected = Builder.writeCandidate(&self.*, candidate)
      let active = List<WriteHolder>.asSlice(&self.writeHolders)[selected.holder].active
      let empty = List<Atom>.make()
      let accepted: [Atom; 2] = [actual.quality.present, kept]
      run Program.rule(&mut self.rules, active, &accepted, List<Atom>.asSlice(&empty))
    }
    return run bindPolicy(&mut self.policies, &mut self.rules, port, kept, stored, alternatives)
  }
}

effect fn bindPolicy(policies: &mut List<PendingPolicy>, rules: &mut Program, id: PolicyPortId,
  kept: Atom, stored: Atom, alternatives: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let pending = List<PendingPolicy>.asMutSlice(&mut policies.*)
  if id.index >= pending.length || pending[id.index].bound {
    CompilerBug.panic(b"source policy decision was absent or bound twice")
  }
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  let retains: [Atom; 1] = [kept]
  let losesStorage: [Atom; 1] = [stored]
  let losesAlternatives: [Atom; 1] = [alternatives]
  run Program.rule(&mut rules.*, pending[id.index].kept, &retains, none)
  run Program.rule(&mut rules.*, pending[id.index].stored, &losesStorage, none)
  run Program.rule(&mut rules.*, pending[id.index].alternatives, &losesAlternatives, none)
  pending[id.index].bound = true
  return ()
}

effect fn inputPositions(rules: &mut Program, value: ValueId, leafCount: usize, values: &[Value],
  keys: &[CellKey], cells: &[Cell], witnesses: &[Witness], cases: &[Case]) -> List<Input>
! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Input>.make()
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  let mut leaf = usize.ZERO
  while leaf < leafCount {
    let mut found = false
    let mut key = usize.ZERO
    while key < keys.length {
      if keys[key].value.index == value.index && keys[key].leaf.index == leaf { found = true }
      key = key + usize.ONE
    }
    if found {
      let quality = Cell {present: Program.atom(&mut rules.*), stored: Program.atom(&mut rules.*), alternatives: Program.atom(&mut rules.*)}
      let mut alternatives = List<InputCase>.make()
      key = usize.ZERO
      while key < keys.length {
        if keys[key].value.index == value.index && keys[key].leaf.index == leaf {
          let present: [Atom; 1] = [cells[key].present]
          let stored: [Atom; 1] = [cells[key].stored]
          let lost: [Atom; 1] = [cells[key].alternatives]
          run Program.rule(&mut rules.*, quality.present, &present, none)
          run Program.rule(&mut rules.*, quality.stored, &stored, none)
          run Program.rule(&mut rules.*, quality.alternatives, &lost, none)
          run appendInputCases(&mut alternatives, key, values, keys, witnesses, cases)
        }
        key = key + usize.ONE
      }
      run List<Input>.append(&mut result, Input {value: value, leaf: LeafId {index: leaf},
        quality: quality, cases: move alternatives})
    }
    leaf = leaf + usize.ONE
  }
  return move result
}

effect fn appendInputCases(target: &mut List<InputCase>, key: usize, values: &[Value],
  keys: &[CellKey], witnesses: &[Witness], cases: &[Case]) -> () ! OutOfMemoryError ? &mut Allocator {
  let witness = &witnesses[keys[key].witness]
  let mut each = usize.ZERO
  while each < cases.length {
    if cases[each].target == key {
      let mut source = Option<ValueId>.none()
      if let Option<usize>.Some {value: previous} = cases[each].source {
        source = Option<ValueId>.some(keys[previous].value)
      }
      run List<InputCase>.append(&mut target.*, InputCase {direction: authorityDirection(cases[each].authority), address: authorityAddress(cases[each].authority), source: source,
        placement: values[keys[key].value.index].endpoint, direct: keys[key].direct,
        definition: witness.definition, read: witness.read, map: authorityMap(cases[each].authority),
        contract: authorityContract(cases[each].authority), quality: cases[each].quality})
    }
    each = each + usize.ONE
  }
  return ()
}

impl<'body> Graph<'body> {
  pub fn operationResults(self: &Self) -> &Results.Inventory { return &self.operationResults }
  pub fn operationContributors(self: &Self) -> &[OperationContributor] { return List<OperationContributor>.asSlice(&self.operationContributors) }

  pub fn stores(self: &Self) -> &Stores.Inventory { return &self.stores }
  pub fn writeCandidate(self: &Self, id: usize) -> RetainedWrite {
    let values = List<RetainedWrite>.asSlice(&self.writes)
    if id >= values.length { return CompilerBug.panic(b"retained policy names an absent write candidate") }
    return values[id]
  }
  pub fn writeHolder(self: &Self, id: usize) -> &WriteHolder {
    let values = List<WriteHolder>.asSlice(&self.writeHolders)
    if id >= values.length { return CompilerBug.panic(b"retained policy names an absent holder update") }
    return &values[id]
  }
  pub fn aliases(self: &Self) -> &[StorageAlias] { return List<StorageAlias>.asSlice(&self.aliases) }
  pub fn retainedRequests(self: &Self) -> &[RetainedRequest] { return List<RetainedRequest>.asSlice(&self.retainedRequests) }
  pub fn retainedAddresses(self: &Self) -> &[RetainedAddress] { return List<RetainedAddress>.asSlice(&self.retainedAddresses) }
  pub fn retainedStatus(self: &Self) -> &[RetainedStatus] { return List<RetainedStatus>.asSlice(&self.retainedStatus) }
  pub fn retainedReads(self: &Self) -> &[RetainedRead] { return List<RetainedRead>.asSlice(&self.retainedReads) }

  /// Physical reservation order only; operation operands keep the visitor's explicit order.
  pub fn values(self: &Self) -> &[Value] { return List<Value>.asSlice(&self.values) }
  pub fn value(self: &Self, id: ValueId) -> Value {
    let values = List<Value>.asSlice(&self.values)
    if id.index >= values.length { return CompilerBug.panic(b"source consumer names an absent value") }
    return values[id.index]
  }
  pub fn valueShape(self: &Self, id: ValueId) -> ShapeId {
    return valueShape(&self.preparation, Graph.value(&self.*, id))
  }
  pub fn evaluation(self: &Self, id: EvalId) -> Evaluation {
    let evaluations = List<Evaluation>.asSlice(&self.evaluations)
    if id.index >= evaluations.length { return CompilerBug.panic(b"source consumer names an absent evaluation") }
    return evaluations[id.index]
  }
  pub fn definitionCount(self: &Self) -> usize { return List<DefinedValue>.length(&self.definitions) }
  pub fn readCount(self: &Self) -> usize { return List<ReadValue>.length(&self.reads) }
  pub fn definition(self: &Self, id: DefinitionId) -> DefinitionView {
    return definitionView(&self.reaching, List<Storage>.asSlice(&self.storage), List<DefinedValue>.asSlice(&self.definitions), id)
  }
  pub fn read(self: &Self, id: ReadId) -> ReadView {
    return readView(&self.reaching, List<Storage>.asSlice(&self.storage), List<ReadValue>.asSlice(&self.reads), id)
  }

  /// Allocates only the matching actual placements; it emits no rules and performs no solve.
  pub effect fn readPlacementsByRead(self: &Self, read: ReadId) -> List<ReadPlacement>
  ! OutOfMemoryError ? &mut Allocator {
    return run readPlacementsByRead(&self.preparation, &self.reaching, List<Storage>.asSlice(&self.storage),
      List<ReadValue>.asSlice(&self.reads), List<Value>.asSlice(&self.values),
      List<Evaluation>.asSlice(&self.evaluations), List<StorageAlias>.asSlice(&self.aliases),
      List<AliasTransport>.asSlice(&self.aliasTransports), List<AliasRead>.asSlice(&self.aliasReads), read)
  }

  pub effect fn readPlacements(self: &Self, value: ValueId, read: ReadId) -> List<ReadPlacement>
  ! OutOfMemoryError ? &mut Allocator {
    return run readPlacements(&self.preparation, &self.reaching, List<Storage>.asSlice(&self.storage),
      List<ReadValue>.asSlice(&self.reads), List<Value>.asSlice(&self.values),
      List<Evaluation>.asSlice(&self.evaluations), List<StorageAlias>.asSlice(&self.aliases),
      List<AliasTransport>.asSlice(&self.aliasTransports), List<AliasRead>.asSlice(&self.aliasReads), value, read)
  }

  pub fn preparation(self: &Self) -> &SourcePreparation<'body> { return &self.preparation }

  /// Ownership consumes the same immutable runtime/reaching graph, including explicit
  /// reachability and transfer-pair atoms. This is not a second temporal source analysis.
  pub fn control(self: &Self) -> &Reaching { return &self.reaching }

  pub fn componentStorage(self: &Self, component: ComponentId) -> Storage {
    let stored = List<Storage>.asSlice(&self.storage)
    if component.index >= stored.length { return CompilerBug.panic(b"ownership projection names absent source storage") }
    return stored[component.index]
  }

  pub fn truth(self: &Self, atom: Atom) -> Truth { return Solution.truth(&self.solution, atom) }

  pub fn selection(self: &Self, prepared: PreparedSelectionId) -> Result<SelectionId, AccessError> {
    if prepared.index >= List<Selection>.length(&self.preparation.selections) {
      return Result<SelectionId, AccessError>.failResult(AccessError.InvalidSelection)
    }
    return Result<SelectionId, AccessError>.succeed(SelectionId {stamp: Shared<Stamp>.clone(&self.stamp), index: prepared.index})
  }

  pub fn quality(self: &Self, cell: Cell) -> Quality {
    return Quality {present: Solution.truth(&self.solution, cell.present), stored: Solution.truth(&self.solution, cell.stored),
      alternatives: Solution.truth(&self.solution, cell.alternatives)}
  }

  pub fn leaf(self: &Self, leaf: &SourceLeafId) -> Result<&Leaf, AccessError> {
    if !sameStamp(&self.stamp, &leaf.stamp) { return Result<&Leaf, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let leaves = List<Leaf>.asSlice(&self.leaves)
    if leaf.index >= leaves.length { return Result<&Leaf, AccessError>.failResult(AccessError.InvalidPort) }
    return Result<&Leaf, AccessError>.succeed(&leaves[leaf.index])
  }

  pub fn requestOutcome(self: &Self, ordinal: usize, disposition: SourceDisposition) -> SourceOutcome {
    return SourceOutcome {stamp: Shared<Stamp>.clone(&self.stamp), ordinal: ordinal, disposition: move disposition}
  }

  /// Missing, duplicated, foreign or recovery outcomes cannot discharge a retained request.
  /// The owning checker additionally authenticates its original obligation kind and producer.
  pub fn outcome(self: &Self, ordinal: usize, outcomes: &[SourceOutcome]) -> SourceDisposition {
    let mut matchAt = usize.MAX
    let mut at = usize.ZERO
    while at < outcomes.length {
      if outcomes[at].ordinal == ordinal {
        if !sameStamp(&self.stamp, &outcomes[at].stamp) || matchAt != usize.MAX { return SourceDisposition.Pending }
        matchAt = at
      }
      at = at + usize.ONE
    }
    if self.preparation.body.coverage != Coverage.Complete || !Solution.valid(&self.solution) || matchAt == usize.MAX {
      return SourceDisposition.Pending
    }
    return copyDisposition(&outcomes[matchAt].disposition)
  }
}

fn copyDisposition(value: &SourceDisposition) -> SourceDisposition {
  return match &value.* {
    SourceDisposition.Proved => SourceDisposition.Proved
    SourceDisposition.Pending => SourceDisposition.Pending
    SourceDisposition.Refuted {origin} => SourceDisposition.Refuted {origin: origin}
  }
}

fn acceptsValue<'body>(prepared: &SourcePreparation<'body>, value: Value,
  selection: PreparedSelectionId, endpoint: EndpointId) -> bool {
  if value.phase != ValuePhase.Output { return false }
  return match value.subject {
    Option<ResidualSubject>.None => value.endpoint.index == endpoint.index
    Option<ResidualSubject>.Some {value: subject} => {
      // A declaration suffix is a proof node, not an evaluated selection. Its exact
      // placement must first compose with the actual read; vertex coincidence is not that
      // composition and would merge root and descendant placements of the same state.
      if let Option<Results.Position>.Some {..} = subject.position { return false }
      let state = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[subject.state.index]
      let authored = match state.authority { Prepared.ResidualAuthority.Authored => true _ => false }
      authored && state.accepts && state.selection.index == selection.index && state.vertex.index == endpoint.index
    }
  }
}

impl<'body> Graph<'body> {
  /// Imports only an existing prepared selection. Arbitrary paths cannot grow the solved graph.
  pub effect fn sourcesAt(self: &Self, query: &SourceQuery) -> Result<Sources, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &query.selection.stamp) {
      return Result<Sources, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    let selections = List<Selection>.asSlice(&self.preparation.selections)
    if query.selection.index >= selections.length {
      return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection)
    }
    let selection = &selections[query.selection.index]
    let endpoints = List<Endpoint>.asSlice(&self.preparation.endpoints)
    if selection.root.index >= endpoints.length { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let matches = match &endpoints[selection.root.index].root {
      Root.Node {node, ..} => node.index == query.read.index
      _ => false
    }
    if !matches { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let accepts = List<EndpointId>.asSlice(&selection.accepts)
    if accepts.length == usize.ZERO { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let values = List<Value>.asSlice(&self.values)
    let evaluations = List<Evaluation>.asSlice(&self.evaluations)
    let points = List<Point>.asSlice(&self.reaching.points)
    let cells = List<Cell>.asSlice(&self.cells)
    let cases = List<Case>.asSlice(&self.cases)
    let leaves = List<Leaf>.asSlice(&self.leaves)
    let mut alternatives = List<SourceAlternative>.make()
    let mut observed = List<SourceEvaluation>.make()
    let mut observedIds = List<usize>.make()
    let mut gaps = List<SourceGap>.make()
    let mut complete = Solution.valid(&self.solution)
    if self.preparation.body.coverage != Coverage.Complete {
      complete = false
      run List<SourceGap>.append(&mut gaps, SourceGap.Recovery)
    }
    let mut found = false
    // An actual evaluation with impossible successful completion (for example indexing a
    // fixed zero-length array) has a reserved unreachable result point but no value/read.
    // Do not confuse this positive CFG fact with a missing evaluation or invent a source.
    let mut evaluation = usize.ZERO
    while evaluation < evaluations.length {
      let atRead = match evaluations[evaluation].site {
        EvaluationSite.Node {node} => node.index == query.read.index
        EvaluationSite.Entry {..} => false
      }
      if atRead && evaluations[evaluation].role == EvaluationRole.Value {
        found = true
        let reachable = Solution.truth(&self.solution, points[evaluations[evaluation].point.index].reachable)
        run List<usize>.append(&mut observedIds, evaluation)
        run List<SourceEvaluation>.append(&mut observed, SourceEvaluation {
          occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: evaluation}, reachable: reachable})
        if reachable == Truth.Undefined {
          complete = false
          run List<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
        }
      }
      evaluation = evaluation + usize.ONE
    }
    let mut value = usize.ZERO
    while value < values.length {
      let evaluation = values[value].evaluation.index
      let atRead = match evaluations[evaluation].site {
        EvaluationSite.Node {node} => node.index == query.read.index
        EvaluationSite.Entry {..} => false
      }
      if atRead && evaluations[evaluation].role == EvaluationRole.Value {
        let mut selected = false
        let mut accept = usize.ZERO
        while accept < accepts.length {
          if acceptsValue(&self.preparation, values[value], PreparedSelectionId {index: query.selection.index}, accepts[accept]) { selected = true }
          accept = accept + usize.ONE
        }
        if selected {
          let reachable = Solution.truth(&self.solution, points[evaluations[evaluation].point.index].reachable)
          let mut grounded = false
          let keys = List<CellKey>.asSlice(&self.keys)
          let mut cell = usize.ZERO
          while cell < keys.length {
            if keys[cell].value.index == value {
              let leaf = keys[cell].leaf.index
              let presence = Solution.truth(&self.solution, cells[cell].present)
              if presence != Truth.False {
                if presence == Truth.True { grounded = true }
                if presence == Truth.Undefined {
                  complete = false
                  run List<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
                }
                let mut routeCase = usize.ZERO
                while routeCase < cases.length {
                  if cases[routeCase].target == cell && Solution.truth(&self.solution, cases[routeCase].active) != Truth.False {
                    if Solution.truth(&self.solution, cases[routeCase].active) == Truth.Undefined {
                      complete = false
                      run List<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
                    }
                    run List<SourceAlternative>.append(&mut alternatives, SourceAlternative {
                      leaf: SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: leaf}, origin: leaves[leaf].origin,
                      occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: evaluation},
                      route: SourceRouteId {stamp: Shared<Stamp>.clone(&self.stamp), root: cell},
                      case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: routeCase}})
                  }
                  routeCase = routeCase + usize.ONE
                }
              }
            }
            cell = cell + usize.ONE
          }
          if reachable != Truth.False && !grounded {
            complete = false
            run List<SourceGap>.append(&mut gaps, SourceGap.Ungrounded)
          }
        }
      }
      value = value + usize.ONE
    }
    let observedEvaluations = List<usize>.asSlice(&observedIds)
    let mut observedAt = usize.ZERO
    while observedAt < observedEvaluations.length {
      let reachable = Solution.truth(&self.solution, points[evaluations[observedEvaluations[observedAt]].point.index].reachable)
      let mut accept = usize.ZERO
      while reachable != Truth.False && accept < accepts.length {
        let mut represented = false
        let mut candidate = usize.ZERO
        while candidate < values.length {
          if values[candidate].evaluation.index == observedEvaluations[observedAt]
            && acceptsValue(&self.preparation, values[candidate], PreparedSelectionId {index: query.selection.index}, accepts[accept]) { represented = true }
          candidate = candidate + usize.ONE
        }
        if !represented {
          complete = false
          run List<SourceGap>.append(&mut gaps, SourceGap.Ungrounded)
        }
        accept = accept + usize.ONE
      }
      observedAt = observedAt + usize.ONE
    }
    if !found {
      complete = false
      run List<SourceGap>.append(&mut gaps, SourceGap.MissingEvaluation)
    }
    return Result<Sources, AccessError>.succeed(Sources {evaluations: move observed, alternatives: move alternatives, gaps: move gaps, complete: complete})
  }

  pub fn occurrence(self: &Self, id: &OccurrenceId) -> Result<Evaluation, AccessError> {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<Evaluation, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let evaluations = List<Evaluation>.asSlice(&self.evaluations)
    if id.index >= evaluations.length { return Result<Evaluation, AccessError>.failResult(AccessError.InvalidOccurrence) }
    return Result<Evaluation, AccessError>.succeed(evaluations[id.index])
  }

  pub effect fn route(self: &Self, id: &SourceRouteId) -> Result<RouteView, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<RouteView, AccessError>.failResult(AccessError.ForeignAnalysis) }
    if id.root >= List<Cell>.length(&self.cells) { return Result<RouteView, AccessError>.failResult(AccessError.InvalidRoute) }
    let closure = run routeClosure(self, id.root)
    let cases = List<Case>.asSlice(&self.cases)
    let ports = List<usize>.asSlice(&closure)
    let mut accepts = List<RoutePortId>.make()
    let mut at = usize.ZERO
    while at < ports.length {
      let mut each = usize.ZERO
      let mut grounded = false
      while each < cases.length {
        if cases[each].target == ports[at] && Solution.truth(&self.solution, cases[each].active) != Truth.False {
          if let Option<usize>.None = cases[each].source { grounded = true }
        }
        each = each + usize.ONE
      }
      if grounded { run List<RoutePortId>.append(&mut accepts, RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: ports[at]}) }
      at = at + usize.ONE
    }
    let leaf = List<CellKey>.asSlice(&self.keys)[id.root].leaf.index
    return Result<RouteView, AccessError>.succeed(RouteView {
      start: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: id.root}, accepts: move accepts,
      leaf: SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: leaf}})
  }

  pub effect fn routePort(self: &Self, route: &SourceRouteId, port: &RoutePortId) -> Result<RoutePort, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &route.stamp) || !sameStamp(&self.stamp, &port.stamp) {
      return Result<RoutePort, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    if route.root >= List<Cell>.length(&self.cells) || port.index >= List<Cell>.length(&self.cells) {
      return Result<RoutePort, AccessError>.failResult(AccessError.InvalidPort)
    }
    let closure = run routeClosure(self, route.root)
    if !contains(List<usize>.asSlice(&closure), port.index) { return Result<RoutePort, AccessError>.failResult(AccessError.InvalidPort) }
    let value = List<CellKey>.asSlice(&self.keys)[port.index].value.index
    let actual = List<Value>.asSlice(&self.values)[value]
    let mut residual = Option<Prepared.ResidualStateId>.none()
    let mut position = Option<Results.Position>.none()
    if let Option<ResidualSubject>.Some {value} = actual.subject {
      residual = Option<Prepared.ResidualStateId>.some(value.state)
      position = value.position
    }
    return Result<RoutePort, AccessError>.succeed(RoutePort {position: position, phase: actual.phase, subject: valueShape(&self.preparation, actual),
      residual: residual, endpoint: actual.endpoint,
      occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: actual.evaluation.index},
      direct: List<CellKey>.asSlice(&self.keys)[port.index].direct, quality: Graph<'body>.quality(self, List<Cell>.asSlice(&self.cells)[port.index])})
  }

  pub effect fn routeEdges(self: &Self, route: &SourceRouteId, port: &RoutePortId) -> Result<List<RouteEdge>, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &route.stamp) || !sameStamp(&self.stamp, &port.stamp) {
      return Result<List<RouteEdge>, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    if route.root >= List<Cell>.length(&self.cells) || port.index >= List<Cell>.length(&self.cells) {
      return Result<List<RouteEdge>, AccessError>.failResult(AccessError.InvalidPort)
    }
    let closure = run routeClosure(self, route.root)
    if !contains(List<usize>.asSlice(&closure), port.index) { return Result<List<RouteEdge>, AccessError>.failResult(AccessError.InvalidPort) }
    let cases = List<Case>.asSlice(&self.cases)
    let mut result = List<RouteEdge>.make()
    let mut at = usize.ZERO
    while at < cases.length {
      if cases[at].target == port.index && Solution.truth(&self.solution, cases[at].active) != Truth.False {
        if let Option<usize>.Some {value: source} = cases[at].source {
          let mut address = Option<OccurrenceId>.none()
          if let Option<EvalId>.Some {value} = authorityAddress(cases[at].authority) {
            address = Option<OccurrenceId>.some(OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: value.index})
          }
          let mut addressProof = Option<AddressRoute>.none()
          if let TransferAuthority.Address {edge, ..} = cases[at].authority {
            let actual = List<AliasEdge>.asSlice(&self.aliasEdges)[edge]
            match actual.authority {
              AliasAuthority.Selected {selection, map} => {
                let use = &List<SelectionUse>.asSlice(&self.selections)[selection]
                addressProof = Option<AddressRoute>.some(AddressRoute.Selected {selection: use.selection, map: map,
                  formation: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: use.result.index}})
              }
              AliasAuthority.Origin {placement} => {
                let selected = List<OriginPlacement>.asSlice(&self.descriptors.placements)[placement]
                let proof = List<OriginProof>.asSlice(&self.descriptors.origins)[selected.proof]
                let origin = List<ReferenceOrigin>.asSlice(&self.references)[proof.origin]
                let descriptor = List<Value>.asSlice(&self.values)[origin.descriptor.index]
                addressProof = Option<AddressRoute>.some(AddressRoute.Origin {creation: origin.map,
                  referent: origin.referent, member: selected.member, state: selected.state,
                  source: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: origin.source.index},
                  descriptor: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: descriptor.evaluation.index},
                  seed: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: proof.seed}, carrier: proof.carrier})
              }
              AliasAuthority.Slice {placement} => {
                let selected = List<SlicePlacement>.asSlice(&self.descriptors.slicePlacements)[placement]
                let proof = List<SliceProof>.asSlice(&self.descriptors.sliceProofs)[selected.proof]
                let conversion = List<SliceConversion>.asSlice(&self.slices)[proof.conversion]
                let row = &List<Prepared.ArraySlice>.asSlice(&self.preparation.arraySlices)[conversion.prepared]
                let descriptor = List<Value>.asSlice(&self.values)[conversion.descriptor.index]
                addressProof = Option<AddressRoute>.some(AddressRoute.Slice {conversion: conversion.prepared,
                  descriptor: row.descriptor, element: selected.element, member: selected.member, state: selected.state,
                  source: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: conversion.source.index},
                  result: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: descriptor.evaluation.index},
                  case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: proof.case},
                  carrier: proof.carrier, origin: selected.origin})
              }
              _ => { return CompilerBug.panic(b"route lost its actual composite address authority") }
            }
          }
          let mut physical = authorityMap(cases[at].authority)
          let mut operation = Option<OperationRoute>.none()
          if let TransferAuthority.OperationResult {candidate, position} = cases[at].authority {
            physical = Option<MapId>.none()
            operation = Option<OperationRoute>.some(OperationRoute {position: position, operation: candidate.operation,
              input: candidate.input, inputMap: candidate.inputMap,
              operand: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: candidate.operand.index},
              result: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: candidate.result.index},
              selection: candidate.selection, route: candidate.route, projection: candidate.projection,
              continuation: candidate.continuation, output: candidate.output})
          }
          run List<RouteEdge>.append(&mut result, RouteEdge {addressProof: move addressProof, operation: move operation,
            direction: authorityDirection(cases[at].authority), address: move address,
            from: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: port.index},
            to: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: source}, map: physical,
            originalContract: authorityContract(cases[at].authority), case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: at}})
        }
      }
      at = at + usize.ONE
    }
    return Result<List<RouteEdge>, AccessError>.succeed(move result)
  }

  pub fn routeCase(self: &Self, id: &RouteCaseId) -> Result<RouteCase, AccessError> {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<RouteCase, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let cases = List<Case>.asSlice(&self.cases)
    if id.index >= cases.length { return Result<RouteCase, AccessError>.failResult(AccessError.InvalidCase) }
    let actual = &cases[id.index]
    let key = List<CellKey>.asSlice(&self.keys)[actual.target]
    let value = key.value.index
    let witness = &List<Witness>.asSlice(&self.witnesses)[key.witness]
    let mut definition = Option<SourceDefinitionId>.none()
    let mut read = Option<SourceReadId>.none()
    if let Option<DefinitionId>.Some {value} = witness.definition {
      definition = Option<SourceDefinitionId>.some(SourceDefinitionId {stamp: Shared<Stamp>.clone(&self.stamp), index: value.index})
    }
    if let Option<ReadId>.Some {value} = witness.read {
      read = Option<SourceReadId>.some(SourceReadId {stamp: Shared<Stamp>.clone(&self.stamp), index: value.index})
    }
    return Result<RouteCase, AccessError>.succeed(RouteCase {applicability: Solution.truth(&self.solution, actual.active),
      definition: move definition, read: move read, placement: List<Value>.asSlice(&self.values)[value].endpoint,
      direct: key.direct, quality: Graph<'body>.quality(self, actual.quality)})
  }
}

fn contains(values: &[usize], value: usize) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at] == value { return true }
    at = at + usize.ONE
  }
  return false
}

// Reachability here is immutable route access, not another source solver. Only the already
// solved case applicability is read; a visited cycle establishes no source or lifetime proof.
effect fn routeClosure<'body>(graph: &Graph<'body>, start: usize) -> List<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut result = List<usize>.make()
  run List<usize>.append(&mut result, start)
  let cases = List<Case>.asSlice(&graph.cases)
  let mut next = usize.ZERO
  while next < List<usize>.length(&result) {
    let port = List<usize>.asSlice(&result)[next]
    let mut at = usize.ZERO
    while at < cases.length {
      if cases[at].target == port && Solution.truth(&graph.solution, cases[at].active) != Truth.False {
        if let Option<usize>.Some {value} = cases[at].source {
          if !contains(List<usize>.asSlice(&result), value) { run List<usize>.append(&mut result, value) }
        }
      }
      at = at + usize.ONE
    }
    next = next + usize.ONE
  }
  return move result
}

impl SourceLeafId {
  pub fn copy(self: &Self) -> Self {
    return SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

impl SelectionId {
