  throughResultCandidatesData: List<ThroughResultCandidate>
  throughFlightRequestsData: List<ThroughFlightRequest>
  throughFlightObservationsData: List<ThroughFlightObservation>
  throughFlightReadsData: List<ThroughFlightRead>
  throughFlightCoverageData: List<ThroughFlightCoverage>
  readFlightObservationsData: List<ReadFlightObservation>
  readFlightReadsData: List<ReadFlightRead>
