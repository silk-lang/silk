  fieldReholds: FieldReholds
  referenceObservationsData: List<ReferenceObservation>
  throughReadValuesData: List<ThroughReadValue>
  rvalueDereferenceValuesData: List<RvalueDereferenceValue>
  fieldResultRecipesData: List<FieldResultRecipe>
  fieldResultCandidatesData: List<FieldResultCandidate>
