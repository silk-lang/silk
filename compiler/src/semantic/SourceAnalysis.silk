  witnesses: List<Witness>
  cases: List<Case>
}

impl Skeleton {
  pub fn make() -> Self {
    return Skeleton {fieldReholds: FieldReholds.make(), ownershipMirrors: OwnershipMirrors.make(), drops: ConsumedDrops.make(), selectedMoves: SelectedMoves.make(), operationResultsInstalled: false, operationResults: Results.Inventory {operations: List<Results.Operation>.make()},
      operationContributors: List<OperationContributor>.make(), stores: Stores.Inventory {operations: List<Stores.Operation>.make()}, writes: List<RetainedWrite>.make(), writeHolders: List<WriteHolder>.make(), ordinarySummaries: List<OrdinarySummaryWrite>.make(), summaries: List<SummaryStorage>.make(), summaryReads: List<SummaryRead>.make(), summaryClears: List<SummaryClear>.make(), summaryWrites: List<SummaryWrite>.make(), results: List<ResultUse>.make(), rules: Program.make(), flow: Flow.make(), evaluations: List<Evaluation>.make(), executions: List<Execution>.make(),
      values: List<Value>.make(), leaves: List<Leaf>.make(), transfers: List<Transfer>.make(), seeds: List<Seed>.make(),
      storage: List<Storage>.make(), aliases: List<StorageAlias>.make(), aliasEdges: List<AliasEdge>.make(), aliasTransports: List<AliasTransport>.make(), aliasReads: List<AliasRead>.make(), selections: List<SelectionUse>.make(), invocationWrites: List<InvocationWrite>.make(), invocationRequests: List<InvocationRequest>.make(), invocationAddresses: List<InvocationAddress>.make(), invocationReads: List<InvocationRead>.make(), descriptorRequests: List<DescriptorRequest>.make(), retainedRequests: List<RetainedRequest>.make(), retainedAddresses: List<RetainedAddress>.make(), retainedStatus: List<RetainedStatus>.make(), retainedReads: List<RetainedRead>.make(), aliasOperations: List<AliasOperation>.make(), aliasDefinitions: List<AliasDefinition>.make(), referenceObservations: List<ReferenceObservation>.make(), throughReadValues: List<ThroughReadValue>.make(), rvalueDereferenceValues: List<RvalueDereferenceValue>.make(), fieldResultRecipes: List<FieldResultRecipe>.make(), fieldResultCandidates: List<FieldResultCandidate>.make(), ordinaryResultDemands: List<OrdinaryResultDemand>.make(), ordinaryResultCandidates: List<OrdinaryResultCandidate>.make(), rvalueDereferenceResults: List<RvalueDereferenceResult>.make(), throughResultCandidates: List<ThroughResultCandidate>.make(), throughFlightRequests: List<ThroughFlightRequest>.make(), throughFlightObservations: List<ThroughFlightObservation>.make(), throughFlightReads: List<ThroughFlightRead>.make(), throughFlightCoverage: List<ThroughFlightCoverage>.make(), readFlightObservations: List<ReadFlightObservation>.make(), readFlightReads: List<ReadFlightRead>.make(), readFlightCoverage: List<ReadFlightCoverage>.make(), referenceHoldingCoverage: List<ReferenceHoldingCoverage>.make(), referenceHoldings: List<ReferenceHolding>.make(), referenceReads: List<ReferenceRead>.make(), referenceCoverage: List<ReferenceCoverage>.make(), captureReborrowData: CaptureReborrows.make(), references: List<ReferenceOrigin>.make(), slices: List<SliceConversion>.make(), definitions: List<DefinedValue>.make(), reads: List<ReadValue>.make(), closedPairs: usize.ZERO}
  }

  pub fn referenceOrigins(self: &Self) -> &[ReferenceOrigin] { return List<ReferenceOrigin>.asSlice(&self.references) }

  pub fn referenceObservationBoundary<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    source: EvalId, acquisition: EvalId, descriptor: ThroughDescriptor) -> () {
    let count = List<ReferenceOrigin>.length(&self.references)
    let mut found = false
    let mut at = usize.ZERO
    while at < count {
      let original = List<ReferenceOrigin>.asSlice(&self.references)[at]
      if original.source.index == source.index
        && List<Value>.asSlice(&self.values)[original.descriptor.index].evaluation.index == acquisition.index {
        validateReferenceBoundary(prepared, &self.*, original, descriptor)
        if let Option<ThroughDescriptor>.Some {value} = original.ownership {
          if value.evaluation.index != descriptor.evaluation.index || value.root.index != descriptor.root.index
            || value.crossing.index != descriptor.crossing.index {
            CompilerBug.panic(b"reference ownership boundary changed its actual occurrence")
          }
        }
        let origins = List<ReferenceOrigin>.asMutSlice(&mut self.references)
        origins[at].ownership = Option<ThroughDescriptor>.some(descriptor)
        found = true
      }
      at = at + usize.ONE
    }
    if !found { CompilerBug.panic(b"reference ownership boundary has no actual acquisition") }
    return ()
  }

  pub effect fn evaluate(self: &mut Self, node: NodeId, category: EvaluationRole, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let id = EvalId {index: List<Evaluation>.length(&self.evaluations)}
    run List<Evaluation>.append(&mut self.evaluations, Evaluation {site: EvaluationSite.Node {node: node}, category: category, point: point})
    return id
  }

  /// Structural dispatch/snapshot order is construction evidence only. Flow keeps every
  /// CFG/backedge pair independently of this finite inventory.
  pub effect fn constructionOccurrence(self: &mut Self, evaluation: EvalId, ordinal: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let old = List<OwnershipOccurrence>.asSlice(&self.selectedMoves.occurrences)
    let mut at = usize.ZERO
    while at < old.length {
      if old[at].evaluation.index == evaluation.index {
        if old[at].ordinal != ordinal { return CompilerBug.panic(b"ownership construction changed its actual encounter boundary") }
        return ()
      }
      at = at + usize.ONE
    }
    if evaluation.index >= List<Evaluation>.length(&self.evaluations) { CompilerBug.panic(b"ownership construction has no actual evaluation") }
    run List<OwnershipOccurrence>.append(&mut self.selectedMoves.occurrences,
      OwnershipOccurrence {evaluation: evaluation, ordinal: ordinal})
    return ()
  }

  pub effect fn fieldRehold<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, map: MapId,
    source: EvalId, address: EvalId, execution: EvalId, result: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    if map.index >= maps.length { return CompilerBug.panic(b"field rehold omitted actual Place map") }
    let selected = &maps[map.index]
    let site = match Skeleton.evaluation(&self.*, result).site { EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"field rehold has no actual assignment occurrence") } }
    let destination = match &prepared.body.nodes[site.index].kind { NodeKind.PlaceAssignment {target, ..} => target
      _ => { return CompilerBug.panic(b"field rehold is not an actual PlaceAssignment") } }
    let operand = match &prepared.body.nodes[site.index].kind { NodeKind.PlaceAssignment {value, ..} => value
      _ => { return CompilerBug.panic(b"field rehold lost its actual RHS") } }
    let lhs = match Skeleton.evaluation(&self.*, address).site { EvaluationSite.Node {node} => node.index == destination.index _ => false }
    let rhs = match Skeleton.evaluation(&self.*, source).site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
    let from = match &endpoints[selected.source.index].root { Root.Node {node, category: endpointCategory} if endpointCategory == EndpointRole.Value => node.index == operand.index _ => false }
    let into = match &endpoints[selected.target.index].root { Root.Node {node, category: endpointCategory} if endpointCategory == EndpointRole.Storage => node.index == destination.index _ => false }
    let executions = List<Execution>.asSlice(&self.executions)
    let mut exact = false
    let mut at = usize.ZERO
    while at < executions.length {
      if executions[at].result.index == result.index && executions[at].observation.index == execution.index { exact = true }
      at = at + usize.ONE
    }
    if !lhs || !rhs || !from || !into || !exact || selected.site.index != site.index || selected.kind != MapKind.Place {
      return CompilerBug.panic(b"field rehold changed its actual destination, RHS, write or map")
    }
    let requests = List<FieldReholdRequest>.asSlice(&self.fieldReholds.requests)
    at = usize.ZERO
    while at < requests.length {
      if requests[at].result.index == result.index { return CompilerBug.panic(b"field rehold has two actual requests") }
      at = at + usize.ONE
    }
    let accepted = Program.atom(&mut self.rules)
    run List<FieldReholdRequest>.append(&mut self.fieldReholds.requests, FieldReholdRequest {
      map: map, source: source, address: address, execution: execution, result: result, active: active, accepted: accepted})
    return ()
  }

  /// Reserve only the actual consumed Drop occurrence; reads join before its existing kill.
  pub effect fn consumedDrop<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    source: EvalId, root: EndpointId, evaluation: EvalId, point: PointId, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let request = ConsumedDrop {source: source, root: root, evaluation: evaluation, point: point, active: active}
    validateConsumedDrop(prepared, &self.*, request)
    let prior = List<ConsumedDrop>.asSlice(&self.drops.requests)
    let mut at = usize.ZERO
    while at < prior.length {
      if prior[at].evaluation.index == evaluation.index { return CompilerBug.panic(b"consumed Drop was registered twice") }
      at = at + usize.ONE
    }
    run List<ConsumedDrop>.append(&mut self.drops.requests, request)
    return ()
  }

  pub effect fn selectedMove<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, map: MapId,
    source: EvalId, execution: EvalId, result: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    if map.index >= maps.length { return CompilerBug.panic(b"consumed Move omitted its original Copy") }
    let selected = &maps[map.index]
    let actual = Skeleton.evaluation(&self.*, result)
    let node = match actual.site { EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"selected Move is not an actual expression occurrence") } }
    let operand = match &prepared.body.nodes[node.index].kind {
      NodeKind.Expression {form: Expression.Move {value, consumed: Option<ConsumedPlace>.Some {..}}, ..} => value
      _ => { return CompilerBug.panic(b"ownership Move requires typing's consumed place") }
    }
    let original = match Skeleton.evaluation(&self.*, source).site { EvaluationSite.Node {node: matchedNode} => matchedNode.index == operand.index _ => false }
    let root = match &endpoints[selected.source.index].root {
      Root.Node {node: matchedNode, category: endpointCategory} if endpointCategory == EndpointRole.Storage => matchedNode.index == operand.index
      _ => false
    }
    let executions = List<Execution>.asSlice(&self.executions)
    let mut exact = false
    let mut at = usize.ZERO
    while at < executions.length {
      if executions[at].result.index == result.index && executions[at].observation.index == execution.index { exact = true }
      at = at + usize.ONE
    }
    if !original || !root || !exact || selected.site.index != node.index || selected.kind != MapKind.Copy {
      return CompilerBug.panic(b"selected Move changed its operand, Copy or pre-kill execution")
    }
    let old = List<SelectedMove>.asSlice(&self.selectedMoves.requests)
    at = usize.ZERO
    while at < old.length {
      if old[at].result.index == result.index { return CompilerBug.panic(b"selected Move has two construction requests") }
      at = at + usize.ONE
    }
    let target = run Skeleton.value(&mut self.*, result, selected.target)
    run List<SelectedMove>.append(&mut self.selectedMoves.requests, SelectedMove {
      map: map, source: source, execution: execution, result: result, target: target, active: active})
    return ()
  }

  /// The caller supplies the retained operation's actual execution point. Intern by its
  /// result occurrence, never by node identity or a point scan; there is no new CFG point.
  pub effect fn execution(self: &mut Self, result: EvalId, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, result)
    let node = match actual.site { EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"entry is not an executing operation") } }
    let previous = List<Execution>.asSlice(&self.executions)
    let mut at = usize.ZERO
    while at < previous.length {
      if previous[at].result.index == result.index {
        let retained = Skeleton.evaluation(&self.*, previous[at].observation)
        if retained.point.index != point.index { return CompilerBug.panic(b"one operation changed its execution point") }
        return previous[at].observation
      }
      at = at + usize.ONE
    }
    if point.index >= Flow.reservedPoints(&self.flow).length { return CompilerBug.panic(b"execution has no reserved operation point") }
    let observation = run Skeleton.evaluate(&mut self.*, node, EvaluationRole.Execute, point)
    run List<Execution>.append(&mut self.executions, Execution {result: result, observation: observation})
    if let Option<usize>.Some {value} = ownershipOrder(&self.*, result) {
      run Skeleton.constructionOccurrence(&mut self.*, observation, value)
    }
    return observation
  }

  /// Traversal supplies the real first-operand occurrence chain. Only the existing action
  /// evaluation is used: Replace reads at Replacement and writes at its later result.
  pub effect fn reserveThroughFlight<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    operation: EvalId, target: EvalId, evaluation: EvalId, kind: ThroughFlightKind,
    descriptor: Option<ThroughDescriptor>, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let requests = List<ThroughFlightRequest>.asSlice(&self.throughFlightRequests)
    let mut at = usize.ZERO
    while at < requests.length {
      if requests[at].operation.index == operation.index && requests[at].kind == kind {
        return CompilerBug.panic(b"through operation repeated its actual action request")
      }
      at = at + usize.ONE
    }
    let applicable = Program.atom(&mut self.rules)
    let missing = Program.atom(&mut self.rules)
    let action = Skeleton.evaluation(&self.*, evaluation)
    let gates: [Atom; 2] = [active, Flow.reservedPoints(&self.flow)[action.point.index].reachable]
    run Program.rule(&mut self.rules, applicable, &gates, &[])
    let request = ThroughFlightRequest {operation: operation, target: target, evaluation: evaluation,
      kind: kind, descriptor: descriptor, active: applicable, missing: missing}
    validateThroughFlightRequest(prepared, &self.*, request)
    run List<ThroughFlightRequest>.append(&mut self.throughFlightRequests, request)
    return ()
  }

  /// SourceStores has already authenticated the complete actual call/receiver chain.
  /// This method binds its immutable coordinates to the shared execution observation.
  pub effect fn reserveRetained<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    operation: usize, source: &Stores.Operation, execution: EvalId) -> () ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, execution)
    let result = Skeleton.evaluation(&self.*, source.evaluation)
    let same = match actual.site {
      EvaluationSite.Node {node} => match result.site { EvaluationSite.Node {node: other} => node.index == other.index _ => false }
      _ => false
    }
    let executions = List<Execution>.asSlice(&self.executions)
    let mut found = false
    let mut at = usize.ZERO
    while at < executions.length {
      if executions[at].result.index == source.evaluation.index && executions[at].observation.index == execution.index { found = true }
      at = at + usize.ONE
    }
    if !found || !same || actual.category != EvaluationRole.Execute || actual.point.index != source.execute.index {
      CompilerBug.panic(b"retained selector lost its actual execution observation")
    }
    let old = List<RetainedRequest>.asSlice(&self.retainedRequests)
    at = usize.ZERO
    while at < old.length {
      if old[at].operation == operation { CompilerBug.panic(b"retained operation was installed twice") }
      at = at + usize.ONE
    }
    let retained = List<Prepared.Retention>.asSlice(&prepared.retentions)
    if source.retention.index >= retained.length { CompilerBug.panic(b"retained selector lost its original stage") }
    let record = &retained[source.retention.index]
    let origin = Skeleton.evaluation(&self.*, source.originating)
    let original = match origin.site { EvaluationSite.Node {node} => node.index == record.site.index _ => false }
    if !original { CompilerBug.panic(b"retained selector changed its originating call") }
    let operands = List<Prepared.RetentionOperand>.asSlice(&record.operands)
    let inputs = List<Stores.Input>.asSlice(&source.inputs)
    if inputs.length != operands.length { CompilerBug.panic(b"retained requests omitted an original operand") }
    let mut input = usize.ZERO
    while input < inputs.length {
      let slots = List<Stores.Slot>.asSlice(&inputs[input].slots)
      let owning = List<Prepared.RetentionSlot>.asSlice(&operands[input].slots)
      if inputs[input].operand != operands[input].operand || inputs[input].route != operands[input].input
        || slots.length != owning.length { CompilerBug.panic(b"retained requests changed their input/slot coordinates") }
      let mut slot = usize.ZERO
      while slot < slots.length {
        let selected = &slots[slot]
        if selected.slot != owning[slot].slot || selected.original.index != owning[slot].original.selection.index
          || selected.physical.index != owning[slot].physical.selection.index {
          CompilerBug.panic(b"retained request substituted another original slot selection")
        }
        let paths = List<Stores.Path>.asSlice(&selected.paths)
        let mut copied = List<RetainedPath>.make()
        let mut path = usize.ZERO
        while path < paths.length {
          let mut selectors = List<MapId>.make()
          let maps = List<MapId>.asSlice(&paths[path].selectors)
          let mut step = usize.ZERO
          while step < maps.length { run List<MapId>.append(&mut selectors, maps[step]) step = step + usize.ONE }
          run List<RetainedPath>.append(&mut copied, RetainedPath {endpoint: paths[path].endpoint, selectors: move selectors})
          path = path + usize.ONE
        }
        let request = List<RetainedRequest>.length(&self.retainedRequests)
        let active = Flow.reachable(&self.flow, source.execute)
        run List<RetainedRequest>.append(&mut self.retainedRequests, RetainedRequest {
          operation: operation, input: input, slot: slot, retention: source.retention, originating: source.originating,
          operand: inputs[input].actual.evaluation, usePoint: inputs[input].actual.usePoint, execution: execution,
          original: selected.original, selection: selected.physical, paths: move copied, active: active})
        let originalExact = match &owning[slot].original.coverage { PreparedSlotCoverage.Exact => true _ => false }
        let physicalExact = match &owning[slot].physical.coverage { PreparedSlotCoverage.Exact => true _ => false }
        let originalEmpty = match &owning[slot].original.coverage { PreparedSlotCoverage.EmptyArray {..} => true _ => false }
        let physicalEmpty = match &owning[slot].physical.coverage { PreparedSlotCoverage.EmptyArray {..} => true _ => false }
        let missing = Program.atom(&mut self.rules)
        if (!originalExact && !originalEmpty) || (!physicalExact && !physicalEmpty) {
          let gates: [Atom; 1] = [active]
          let empty = List<Atom>.make()
          run Program.rule(&mut self.rules, missing, &gates, List<Atom>.asSlice(&empty))
        }
        run List<RetainedStatus>.append(&mut self.retainedStatus, RetainedStatus {request: request,
          originalExact: originalExact, physicalExact: physicalExact, empty: originalEmpty || physicalEmpty, missing: missing})
        slot = slot + usize.ONE
      }
      input = input + usize.ONE
    }
    return ()
  }

  /// The immutable occurrence inventory was authenticated against Traversal and Results.
  /// Requests use an execution observation even if the successful result is unreachable.
  pub effect fn installStores<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, inventory: Stores.Inventory) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if List<Stores.Operation>.length(&self.stores.operations) != usize.ZERO
      || List<RetainedRequest>.length(&self.retainedRequests) != usize.ZERO {
      CompilerBug.panic(b"retained operations were installed twice")
    }
    let operations = List<Stores.Operation>.asSlice(&inventory.operations)
    let mut at = usize.ZERO
    while at < operations.length {
      let execution = run Skeleton.execution(&mut self.*, operations[at].evaluation, operations[at].execute)
      run Skeleton.reserveRetained(&mut self.*, prepared, at, &operations[at], execution)
      at = at + usize.ONE
    }
    self.stores = move inventory
    return ()
  }

  // Freeze invocation requests before any candidate closure. Results supplies exact actual
  // receiver/argument occurrences; Prepared supplies selectors, never eligibility policy.
  effect fn reserveInvocationRequests<'body>(self: &mut Self, prepared: &SourcePreparation<'body>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let rows = List<Prepared.InvocationView>.asSlice(&prepared.invocationViews)
    let preparedOperations = List<Prepared.Operation>.asSlice(&prepared.operations)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let selections = List<Selection>.asSlice(&prepared.selections)
    let count = List<Results.Operation>.length(&self.operationResults.operations)
    let mut operation = usize.ZERO
    while operation < count {
      let actual = &List<Results.Operation>.asSlice(&self.operationResults.operations)[operation]
      let row = &preparedOperations[actual.prepared]
      if row.phase == PreparedOperationPhase.Invoke || row.phase == PreparedOperationPhase.ExecuteEffect {
        let result = actual.evaluation
        let execute = actual.execute
        let preparedIndex = actual.prepared
        let execution = run Skeleton.execution(&mut self.*, result, execute)
        let mut view = usize.ZERO
        while view < rows.length {
          let selected = &rows[view]
          if selected.operation == preparedIndex {
            let actual = &List<Results.Operation>.asSlice(&self.operationResults.operations)[operation]
            let routes = List<InputRoute>.asSlice(&row.inputs)
            let inputs = List<Results.Input>.asSlice(&actual.inputs)
            let mut operand = Option<EvalId>.none()
            let mut usePoint = execute
            let mut root = Option<EndpointId>.none()
            let mut each = usize.ZERO
            while each < inputs.length {
              let route = &routes[inputs[each].route]
              if sameInputRead(route.read, selected.read) {
                let candidate = inputs[each].actual
                if let Option<EvalId>.Some {value} = operand {
                  if value.index != candidate.evaluation.index || usePoint.index != candidate.usePoint.index {
                    return CompilerBug.panic(b"invocation view changed its actual input occurrence")
                  }
                }
                operand = Option<EvalId>.some(candidate.evaluation)
                usePoint = candidate.usePoint
                root = Option<EndpointId>.some(maps[route.map.index].source)
              }
              each = each + usize.ONE
            }
            if sameInputRead(selected.read, InputRead.Receiver) {
              if let Option<Results.Receiver>.Some {value} = &actual.receiver {
                operand = Option<EvalId>.some(value.actual.evaluation)
                usePoint = value.actual.usePoint
                root = Option<EndpointId>.some(value.endpoint)
              }
            }
            let operandSelected = match operand { Option<EvalId>.Some {value} => value
              _ => { return CompilerBug.panic(b"invocation view lost its exact runtime input") } }
            let rootSelected = match root { Option<EndpointId>.Some {value} => value
              _ => { return CompilerBug.panic(b"invocation view lost its input root") } }
            if selected.selection.index >= selections.length { return CompilerBug.panic(b"invocation view lost its selection") }
            let selection = &selections[selected.selection.index]
            if selection.site.index != row.site.index || selection.root.index != rootSelected.index
              || !inlineWithin(prepared, selected.descriptor, rootSelected) {
              return CompilerBug.panic(b"invocation view changed its actual descriptor or input root")
            }
            let paths = run Stores.selectionPaths(prepared, selected.selection)
            let mut copied = List<RetainedPath>.make()
            let pathsSelected = List<Stores.Path>.asSlice(&paths)
            each = usize.ZERO
            while each < pathsSelected.length {
              let mut selectors = List<MapId>.make()
              let source = List<MapId>.asSlice(&pathsSelected[each].selectors)
              let mut step = usize.ZERO
              while step < source.length { run List<MapId>.append(&mut selectors, source[step]) step = step + usize.ONE }
              run List<RetainedPath>.append(&mut copied, RetainedPath {endpoint: pathsSelected[each].endpoint, selectors: move selectors})
              each = each + usize.ONE
            }
            let missing = Program.atom(&mut self.rules)
            run List<InvocationRequest>.append(&mut self.invocationRequests, InvocationRequest {
              operation: operation, view: view, operand: operandSelected, usePoint: usePoint, execution: execution,
              selection: selected.selection, paths: move copied, active: Flow.reachable(&self.flow, execute), missing: missing})
          }
          view = view + usize.ONE
        }
      }
      operation = operation + usize.ONE
    }
    // One finite request namespace is shared by address closure. Policy authorities remain
    // discriminated; an invocation request never acquires a fabricated retained slot.
    let retained = List<RetainedRequest>.asSlice(&self.retainedRequests)
    let invocation = List<InvocationRequest>.asSlice(&self.invocationRequests)
    let mut at = usize.ZERO
    while at < retained.length + invocation.length {
      let authority = descriptorRequestAuthority(at, retained.length)
      let operand = match authority { DescriptorRequestAuthority.Retained {request} => retained[request].operand
        DescriptorRequestAuthority.Invocation {request} => invocation[request].operand }
      let execution = match authority { DescriptorRequestAuthority.Retained {request} => retained[request].execution
        DescriptorRequestAuthority.Invocation {request} => invocation[request].execution }
      let selection = match authority { DescriptorRequestAuthority.Retained {request} => retained[request].selection
        DescriptorRequestAuthority.Invocation {request} => invocation[request].selection }
      let active = match authority { DescriptorRequestAuthority.Retained {request} => retained[request].active
        DescriptorRequestAuthority.Invocation {request} => invocation[request].active }
      let missing = match authority { DescriptorRequestAuthority.Retained {request} => List<RetainedStatus>.asSlice(&self.retainedStatus)[request].missing
        DescriptorRequestAuthority.Invocation {request} => invocation[request].missing }
      let paths = match authority { DescriptorRequestAuthority.Retained {request} => List<RetainedPath>.asSlice(&retained[request].paths)
        DescriptorRequestAuthority.Invocation {request} => List<RetainedPath>.asSlice(&invocation[request].paths) }
      let mut copied = List<RetainedPath>.make()
      let mut path = usize.ZERO
      while path < paths.length {
        let mut selectors = List<MapId>.make()
        let source = List<MapId>.asSlice(&paths[path].selectors)
        let mut step = usize.ZERO
        while step < source.length { run List<MapId>.append(&mut selectors, source[step]) step = step + usize.ONE }
        run List<RetainedPath>.append(&mut copied, RetainedPath {endpoint: paths[path].endpoint, selectors: move selectors})
        path = path + usize.ONE
      }
      run List<DescriptorRequest>.append(&mut self.descriptorRequests, DescriptorRequest {authority: authority,
        operand: operand, execution: execution, selection: selection, paths: move copied, active: active, missing: missing})
      at = at + usize.ONE
    }
    return ()
  }

  effect fn writeHolder<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, execution: EvalId,
    storage: Storage) -> usize ! OutOfMemoryError ? &mut Allocator {
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let root = storageOwner(prepared, storage.endpoint)
    let whole = Storage {endpoint: root, temporary: storage.temporary}
    let old = List<WriteHolder>.asSlice(&self.writeHolders)
    let mut at = usize.ZERO
    while at < old.length {
      if old[at].execution.index == execution.index && sameStorage(old[at].storage, whole) { return at }
      at = at + usize.ONE
    }
    let id = old.length
    let active = Program.atom(&mut self.rules)
    let actual = Skeleton.evaluation(&self.*, execution)
    if actual.category != EvaluationRole.Execute { return CompilerBug.panic(b"retained holder has no actual execution observation") }
    let mut components = List<WriteComponent>.make()
    at = usize.ZERO
    while at < endpoints.length {
      let endpoint = EndpointId {index: at}
      if inlineWithin(prepared, endpoint, root) {
        let canonical = Storage {endpoint: endpoint, temporary: storage.temporary}
        let current = run Skeleton.value(&mut self.*, execution, endpoint)
        let read = run Skeleton.read(&mut self.*, actual.point, canonical, current, Option<MapId>.none())
        // Keep the current read separate from the received values. Weak Flow updates retain
        // each old definition once; copying the observation into every new definition would
        // scatter a whole-prefix summary into all physical fields.
        let value = ValueId {index: List<Value>.length(&self.values)}
        run List<Value>.append(&mut self.values, Value {phase: ValuePhase.Output, evaluation: execution,
          endpoint: endpoint, subject: Option<ResidualSubject>.none(), summary: Option<usize>.none(),
          writeHolder: Option<usize>.some(id), cleared: Option<DefinitionId>.none(), summaryRead: Option<ReadId>.none(),
          transport: Option<AliasPort>.none()})
        let received = Program.atom(&mut self.rules)
        let definition = run Skeleton.define(&mut self.*, actual.point, execution, canonical, value, received, Write.Weak)
        run List<WriteComponent>.append(&mut components, WriteComponent {active: received,
          storage: canonical, value: value, read: read, definition: definition})
      }
      at = at + usize.ONE
    }
    run List<WriteHolder>.append(&mut self.writeHolders, WriteHolder {
      execution: execution, storage: whole, active: active, components: move components})
    return id
  }

  effect fn summaryStorage(self: &mut Self, prefix: Storage, placement: OwnershipPlacement, disposition: SummaryDisposition) -> usize ! OutOfMemoryError ? &mut Allocator {
    let existing = List<SummaryStorage>.asSlice(&self.summaries)
    let mut at = usize.ZERO
    while at < existing.length {
      if sameStorage(existing[at].prefix, prefix) && sameOwnershipPlacement(existing[at].placement, placement) && existing[at].disposition == disposition { return at }
      at = at + usize.ONE
    }
    let id = existing.length
    let component = ComponentId {index: List<Storage>.length(&self.storage)}
    run List<Storage>.append(&mut self.storage, prefix)
    run List<SummaryStorage>.append(&mut self.summaries, SummaryStorage {prefix: prefix, placement: placement, disposition: disposition, component: component})
    return id
  }

  effect fn summaryValue(self: &mut Self, summary: usize, evaluation: EvalId, phase: ValuePhase,
    cleared: Option<DefinitionId>, reading: Option<ReadId>) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let prefix = List<SummaryStorage>.asSlice(&self.summaries)[summary].prefix
    let values = List<Value>.asSlice(&self.values)
    let mut at = usize.ZERO
    while at < values.length {
      let actual = values[at]
      let sameClear = match cleared {
        Option<DefinitionId>.Some {value} => match actual.cleared { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
        Option<DefinitionId>.None => match actual.cleared { Option<DefinitionId>.None => true _ => false }
      }
      let sameRead = match reading {
        Option<ReadId>.Some {value} => match actual.summaryRead { Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
        Option<ReadId>.None => match actual.summaryRead { Option<ReadId>.None => true _ => false }
      }
      if actual.evaluation.index == evaluation.index && actual.phase == phase && sameClear && sameRead {
        if let Option<usize>.Some {value} = actual.summary {
          if value == summary { return ValueId {index: at} }
        }
      }
      at = at + usize.ONE
    }
    let id = ValueId {index: values.length}
    run List<Value>.append(&mut self.values, Value {phase: phase, evaluation: evaluation,
      endpoint: prefix.endpoint, subject: Option<ResidualSubject>.none(), summary: Option<usize>.some(summary), writeHolder: Option<usize>.none(),
      cleared: cleared, summaryRead: reading, transport: Option<AliasPort>.none()})
    return id
  }

  effect fn summaryWrite(self: &mut Self, holder: usize, prefix: Storage, placement: OwnershipPlacement, disposition: SummaryDisposition) -> usize ! OutOfMemoryError ? &mut Allocator {
    if disposition == SummaryDisposition.Shadowed { return CompilerBug.panic(b"a copied received holding must be inherited, not newly shadowed") }
    let summary = run Skeleton.summaryStorage(&mut self.*, prefix, placement, disposition)
    let existing = List<SummaryWrite>.asSlice(&self.summaryWrites)
    let mut at = usize.ZERO
    while at < existing.length {
      if existing[at].holder == holder && existing[at].summary == summary { return at }
      at = at + usize.ONE
    }
    let id = existing.length
    let execution = List<WriteHolder>.asSlice(&self.writeHolders)[holder].execution
    let point = Skeleton.evaluation(&self.*, execution).point
    let value = run Skeleton.summaryValue(&mut self.*, summary, execution, ValuePhase.Output, Option<DefinitionId>.none(), Option<ReadId>.none())
    let active = Program.atom(&mut self.rules)
    let component = List<SummaryStorage>.asSlice(&self.summaries)[summary].component
    let definition = run Flow.define(&mut self.flow, point, component, active, Write.Weak)
    run List<DefinedValue>.append(&mut self.definitions, DefinedValue {definition: definition, value: value,
      writer: Option<EvalId>.some(execution), summary: Option<usize>.some(summary), clears: Option<DefinitionId>.none()})
    run List<SummaryWrite>.append(&mut self.summaryWrites, SummaryWrite {
      summary: summary, holder: holder, value: value, definition: definition, active: active})
    return id
  }

  // A summary copied into an ordinary definition receives its own canonical Flow lane.
  // This reserves placement alternatives only; policy chooses the actual held field.
  effect fn closeOrdinarySummaries<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, publications: &OwnershipPublications) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let before = List<OrdinarySummaryWrite>.length(&self.ordinarySummaries)
    let count = List<DefinedValue>.length(&self.definitions)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let mut at = usize.ZERO
    while at < count {
      let original = List<DefinedValue>.asSlice(&self.definitions)[at]
      let value = List<Value>.asSlice(&self.values)[original.value.index]
      let physical = match original.summary { Option<usize>.None => true _ => false }
        && match original.writer { Option<EvalId>.Some {..} => true _ => false }
        && match value.writeHolder { Option<usize>.None => true _ => false }
      if physical {
        let actual = Flow.reservedDefinitions(&self.flow)[at]
        let storage = List<Storage>.asSlice(&self.storage)[actual.component.index]
        let writer = match original.writer { Option<EvalId>.Some {value: matchedWriterEvaluation} => matchedWriterEvaluation
          _ => { return CompilerBug.panic(b"ordinary summary lost its real writer") } }
        let owner = storageOwner(prepared, storage.endpoint)
        let mut prefixes = List<EndpointId>.make()
        let mut prefix = storage.endpoint
        while true {
          run List<EndpointId>.append(&mut prefixes, prefix)
          if prefix.index == owner.index { break }
          prefix = match endpoints[prefix.index].parent { Option<EndpointId>.Some {value: matchedParentEndpoint} => matchedParentEndpoint
            _ => { return CompilerBug.panic(b"ordinary summary left its canonical owner") } }
        }
        // A whole physical definition can carry a known held child. These are alternatives
        // under this exact component, not copies of an unknown whole holding into each field.
        let mut descendant = usize.ZERO
        while descendant < endpoints.length {
          let child = EndpointId {index: descendant}
          if descendant != storage.endpoint.index && inlineWithin(prepared, child, storage.endpoint) {
            run List<EndpointId>.append(&mut prefixes, child)
          }
          descendant = descendant + usize.ONE
        }
        let mut placements = List<OwnershipPlacement>.make()
        let prefixesSelected = List<EndpointId>.asSlice(&prefixes)
        let mut prefixIndex = usize.ZERO
        while prefixIndex < prefixesSelected.length {
          run List<OwnershipPlacement>.append(&mut placements,
            OwnershipPlacement.Known {anchor: prefixesSelected[prefixIndex], suffix: Option<OwnershipSuffix>.none()})
          prefixIndex = prefixIndex + usize.ONE
        }
        run List<OwnershipPlacement>.append(&mut placements, OwnershipPlacement.Unknown)
        // Semantic suffix lanes come only from actual publication cells at THIS definition.
        // The original witness is immutable; no suffix-by-definition Cartesian inventory.
        let published = List<OwnershipPublication>.asSlice(&publications.values)
        let mut carried = usize.ZERO
        while carried < published.length {
          let row = published[carried]
          if row.value.index == original.value.index {
            if let OwnershipPlacement.Position {anchor, ..} = row.placement {
              let constructed = match ownershipPositionBefore(&self.*, row.placement, writer, false) { Option<bool>.Some {value: constructedBefore} => constructedBefore _ => false }
              if constructed && storageOwner(prepared, anchor).index == owner.index
                && (inlineWithin(prepared, anchor, storage.endpoint) || inlineWithin(prepared, storage.endpoint, anchor)) {
                run List<OwnershipPlacement>.append(&mut placements, row.placement)
              }
            }
            if let OwnershipPlacement.Known {anchor, suffix: Option<OwnershipSuffix>.Some {value: tail}} = row.placement {
              if storageOwner(prepared, anchor).index == owner.index
                && (inlineWithin(prepared, anchor, storage.endpoint) || inlineWithin(prepared, storage.endpoint, anchor)) {
                run List<OwnershipPlacement>.append(&mut placements,
                  OwnershipPlacement.Known {anchor: anchor, suffix: Option<OwnershipSuffix>.some(tail)})
              }
            }
          }
          carried = carried + usize.ONE
        }
        let placementsSelected = List<OwnershipPlacement>.asSlice(&placements)
        let mut placement = usize.ZERO
        while placement < placementsSelected.length * 2 {
          let held = placementsSelected[placement / 2]
          let mut disposition = SummaryDisposition.Inherited
          if placement % 2 == usize.ZERO { disposition = SummaryDisposition.Ordinary }
          let canonicalPrefix = match ownershipAnchor(held) { Option<EndpointId>.Some {value: matchedHeldAnchor} => matchedHeldAnchor _ => owner }
          let destination = Storage {endpoint: canonicalPrefix, temporary: storage.temporary}
          let summary = run Skeleton.summaryStorage(&mut self.*, destination, held, disposition)
          let rows = List<OrdinarySummaryWrite>.asSlice(&self.ordinarySummaries)
          let mut old = usize.ZERO
          while old < rows.length {
            if rows[old].original.index == original.definition.index && rows[old].summary == summary { break }
            old = old + usize.ONE
          }
          if old == rows.length {
            let mut shared = usize.MAX
            let mut each = usize.ZERO
            while each < rows.length {
              if rows[each].writer.index == writer.index && rows[each].summary == summary { shared = each }
              each = each + usize.ONE
            }
            let target = run Skeleton.summaryValue(&mut self.*, summary, writer, ValuePhase.Output,
              Option<DefinitionId>.none(), Option<ReadId>.none())
            let admitted = ordinarySummaryAdmission(&mut self.rules, List<OrdinarySummaryWrite>.asSlice(&self.ordinarySummaries), shared)
            let mut definition = DefinitionId {index: usize.MAX}
            if shared != usize.MAX {
              let prior = List<OrdinarySummaryWrite>.asSlice(&self.ordinarySummaries)[shared]
              definition = prior.definition
            } else {
              let component = List<SummaryStorage>.asSlice(&self.summaries)[summary].component
              definition = run Flow.define(&mut self.flow, actual.point, component, admitted, Write.Weak)
              run List<DefinedValue>.append(&mut self.definitions, DefinedValue {definition: definition, value: target,
                writer: Option<EvalId>.some(writer), summary: Option<usize>.some(summary), clears: Option<DefinitionId>.none()})
            }
            let suppressed = Program.atom(&mut self.rules)
            let applicable = Program.atom(&mut self.rules)
            let originalGate: [Atom; 1] = [actual.active]
            let reheld: [Atom; 1] = [suppressed]
            run Program.rule(&mut self.rules, applicable, &originalGate, &reheld)
            run recordFieldReholdSuppression(prepared, &mut self.*, original.definition, summary, suppressed)
            let candidate = List<OrdinarySummaryWrite>.length(&self.ordinarySummaries)
            run List<OrdinarySummaryWrite>.append(&mut self.ordinarySummaries, OrdinarySummaryWrite {
              original: original.definition, definition: definition, writer: writer, storage: storage,
              summary: summary, source: original.value, target: target, active: applicable, originalActive: actual.active, suppressed: suppressed, admitted: admitted})
            let absent = Program.atom(&mut self.rules)
            run List<Transfer>.append(&mut self.transfers, Transfer {source: original.value, target: target,
              active: applicable, directness: holdingDirectness(unknownOwnership(held)), stored: absent, alternatives: absent,
              definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Filtered,
              terminal: false, authority: TransferAuthority.OrdinarySummary {candidate: candidate}})
          } else {
            let suppressed = rows[old].suppressed
            run recordFieldReholdSuppression(prepared, &mut self.*, original.definition, summary, suppressed)
          }
          placement = placement + usize.ONE
        }
      }
      at = at + usize.ONE
    }
    return before != List<OrdinarySummaryWrite>.length(&self.ordinarySummaries)
  }

  // The finite summary universe is closed against ORIGINAL physical definitions/reads only.
  // A narrower write cannot kill unknown contents of an ancestor. A covering real write
  // supplies its exact point, applicability and strength; no independent reaching is computed.
  effect fn closeSummaries<'body>(self: &mut Self, prepared: &SourcePreparation<'body>) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let beforeReads = List<SummaryRead>.length(&self.summaryReads)
    let beforeClears = List<SummaryClear>.length(&self.summaryClears)
    let summaryCount = List<SummaryStorage>.length(&self.summaries)
    let definitionCount = List<DefinedValue>.length(&self.definitions)
    let readCount = List<ReadValue>.length(&self.reads)
    let mut summary = usize.ZERO
    while summary < summaryCount {
      let selected = List<SummaryStorage>.asSlice(&self.summaries)[summary]
      let mut at = usize.ZERO
      while at < definitionCount {
        let source = List<DefinedValue>.asSlice(&self.definitions)[at]
        if let Option<usize>.None = source.summary {
          let actual = Flow.reservedDefinitions(&self.flow)[at]
          let storage = List<Storage>.asSlice(&self.storage)[actual.component.index]
          if sameTemporary(storage.temporary, selected.prefix.temporary)
            && inlineWithin(prepared, selected.prefix.endpoint, storage.endpoint)
            && moveSummaryClear(prepared, &self.*, source.definition) {
            let old = List<SummaryClear>.asSlice(&self.summaryClears)
            let mut found = usize.MAX
            let mut each = usize.ZERO
            while each < old.length {
              if old[each].summary == summary && old[each].original.index == at { found = each }
              each = each + usize.ONE
            }
            if found == usize.MAX && actual.write == Write.Strong {
              let evaluation = List<Value>.asSlice(&self.values)[source.value.index].evaluation
              let empty = run Skeleton.summaryValue(&mut self.*, summary, evaluation, ValuePhase.Output,
                Option<DefinitionId>.some(source.definition), Option<ReadId>.none())
              let suppressed = Program.atom(&mut self.rules)
              let clearActive = Program.atom(&mut self.rules)
              let positive: [Atom; 1] = [actual.active]
              let negative: [Atom; 1] = [suppressed]
              run Program.rule(&mut self.rules, clearActive, &positive, &negative)
              run recordFieldReholdSuppression(prepared, &mut self.*, source.definition, summary, suppressed)
              let cleared = run Flow.define(&mut self.flow, actual.point, selected.component, clearActive, Write.Strong)
              run List<DefinedValue>.append(&mut self.definitions, DefinedValue {definition: cleared, value: empty,
                writer: source.writer, summary: Option<usize>.some(summary), clears: Option<DefinitionId>.some(source.definition)})
              run List<SummaryClear>.append(&mut self.summaryClears, SummaryClear {
                summary: summary, original: source.definition, definition: cleared, active: clearActive, suppressed: suppressed})
            } else if found != usize.MAX {
              let previousClear = old[found]
              run recordFieldReholdSuppression(prepared, &mut self.*, source.definition, summary, previousClear.suppressed)
              if actual.write == Write.Weak {
              // A later alias alternative can weaken the original definition before emit.
              Flow.weaken(&mut self.flow, previousClear.definition)
              }
            }
          }
        }
        at = at + usize.ONE
      }
      at = usize.ZERO
      while at < readCount {
        let original = List<ReadValue>.asSlice(&self.reads)[at]
        if let Option<usize>.None = original.summary {
          let overlaps = referenceSummaryRoot(&self.*, original.read)
            && readFlightSummaryRoot(&self.*, original.read)
            && throughFlightSummaryRoot(&self.*, original.read)
            && fieldReholdSummaryRoot(&self.*, original.read)
            && sameTemporary(original.storage.temporary, selected.prefix.temporary)
            && (inlineWithin(prepared, original.storage.endpoint, selected.prefix.endpoint)
              || inlineWithin(prepared, selected.prefix.endpoint, original.storage.endpoint))
          if overlaps {
            let old = List<SummaryRead>.asSlice(&self.summaryReads)
            let mut found = false
            let mut each = usize.ZERO
            while each < old.length {
              if old[each].summary == summary && old[each].original.index == at { found = true }
              each = each + usize.ONE
            }
            if !found {
              let id = old.length
              let target = List<Value>.asSlice(&self.values)[original.value.index]
              let point = Flow.reservedReads(&self.flow)[at].point
              let incoming = run Skeleton.summaryValue(&mut self.*, summary, target.evaluation,
                ValuePhase.Input, Option<DefinitionId>.none(), Option<ReadId>.some(original.read))
              let read = run Flow.read(&mut self.flow, point, selected.component)
              run List<ReadValue>.append(&mut self.reads, ReadValue {read: read, storage: selected.prefix,
                value: incoming, map: Option<MapId>.none(), summary: Option<usize>.some(summary)})
              let active = Flow.reachable(&self.flow, point)
              run List<SummaryRead>.append(&mut self.summaryReads, SummaryRead {
                summary: summary, original: original.read, read: read, target: original.value, active: active})
              let absent = Program.atom(&mut self.rules)
              run List<Transfer>.append(&mut self.transfers, Transfer {source: incoming, target: original.value,
                active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
                definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
                policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SummaryRead {reading: id}})
            }
          }
        }
        at = at + usize.ONE
      }
      summary = summary + usize.ONE
    }
    return beforeReads != List<SummaryRead>.length(&self.summaryReads)
      || beforeClears != List<SummaryClear>.length(&self.summaryClears)
  }

  effect fn retainedCandidate(self: &mut Self, operation: usize, input: usize, slot: usize,
    address: usize, source: ValueId, target: ValueId, holder: usize, summary: Option<usize>, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let old = List<RetainedWrite>.asSlice(&self.writes)
    let mut at = usize.ZERO
    while at < old.length {
      if old[at].address == address && old[at].source.index == source.index
        && old[at].sourceInput == input && old[at].sourceSlot == slot && old[at].target.index == target.index { return () }
      at = at + usize.ONE
    }
    let id = old.length
    let point = Skeleton.evaluation(&self.*, List<Value>.asSlice(&self.values)[target.index].evaluation).point
    let active = run addressApplies(&mut self.rules, active, Flow.reachable(&self.flow, point))
    run List<RetainedWrite>.append(&mut self.writes, RetainedWrite {summary: summary,
      operation: operation, sourceInput: input, sourceSlot: slot, address: address,
      source: source, target: target, holder: holder, active: active})
    let absent = Program.atom(&mut self.rules)
    run List<Transfer>.append(&mut self.transfers, Transfer {source: source, target: target,
      active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
      policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.RetainedWrite {candidate: id}})
    return ()
  }

  effect fn closeInvocationWrites<'body>(self: &mut Self, prepared: &SourcePreparation<'body>) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let before = List<InvocationWrite>.length(&self.invocationWrites)
    let beforeHolders = List<WriteHolder>.length(&self.writeHolders)
    let beforeTransfers = List<Transfer>.length(&self.transfers)
    let addresses = List<InvocationAddress>.length(&self.invocationAddresses)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let mut address = usize.ZERO
    while address < addresses {
      let selected = List<InvocationAddress>.asSlice(&self.invocationAddresses)[address]
      let request = &List<InvocationRequest>.asSlice(&self.invocationRequests)[selected.request]
      let operation = request.operation
      let execution = request.execution
      let actual = &List<Results.Operation>.asSlice(&self.operationResults.operations)[operation]
      let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[actual.prepared]
      if row.phase != PreparedOperationPhase.Invoke && row.phase != PreparedOperationPhase.ExecuteEffect {
        return CompilerBug.panic(b"invocation body write acquired construction authority")
      }
      let inputCount = List<Results.Input>.length(&actual.inputs)
      let holder = run Skeleton.writeHolder(&mut self.*, prepared, execution, selected.storage)
      let owner = List<WriteHolder>.asSlice(&self.writeHolders)[holder].storage
      let mut tag = usize.ZERO
      while tag < 2 {
        let mut disposition = SummaryDisposition.Inherited
        if tag == usize.ZERO { disposition = SummaryDisposition.Ordinary }
        let write = run Skeleton.summaryWrite(&mut self.*, holder, owner, OwnershipPlacement.Unknown, disposition)
        let written = List<SummaryWrite>.asSlice(&self.summaryWrites)[write]
        let mut input = usize.ZERO
        while input <= inputCount {
          let actual = &List<Results.Operation>.asSlice(&self.operationResults.operations)[operation]
          let mut operand = Option<EvalId>.none()
          let mut usePoint = actual.execute
          let mut root = Option<EndpointId>.none()
          let mut read = InputRead.Receiver
          if input < inputCount {
            let selected = List<Results.Input>.asSlice(&actual.inputs)[input]
            let route = &List<InputRoute>.asSlice(&row.inputs)[selected.route]
            operand = Option<EvalId>.some(selected.actual.evaluation)
            usePoint = selected.actual.usePoint
            root = Option<EndpointId>.some(maps[route.map.index].source)
            read = route.read
          } else if let Option<Results.Receiver>.Some {value} = &actual.receiver {
            operand = Option<EvalId>.some(value.actual.evaluation)
            usePoint = value.actual.usePoint
            root = Option<EndpointId>.some(value.endpoint)
          }
          if let Option<EvalId>.Some {value: matchedOperand} = operand {
            let rootSelected = match root { Option<EndpointId>.Some {value} => value
              _ => { return CompilerBug.panic(b"invocation body input has no actual physical root") } }
            let count = List<Value>.length(&self.values)
            let mut value = usize.ZERO
            while value < count {
              let source = List<Value>.asSlice(&self.values)[value]
              if source.evaluation.index == matchedOperand.index && source.phase == ValuePhase.Output
                && match source.subject { Option<ResidualSubject>.None => true _ => false }
                && match source.summary { Option<usize>.None => true _ => false }
                && match source.writeHolder { Option<usize>.None => true _ => false }
                && match source.transport { Option<AliasPort>.None => true _ => false }
                && inlineWithin(prepared, source.endpoint, rootSelected) {
                let previous = List<InvocationWrite>.asSlice(&self.invocationWrites)
                let mut found = false
                let mut at = usize.ZERO
                while at < previous.length {
                  if previous[at].address == address && previous[at].source.index == value
                    && previous[at].summary == written.summary && sameInputRead(previous[at].read, read) { found = true }
                  at = at + usize.ONE
                }
                if !found {
                  let candidate = previous.length
                  let inputActive = run addressApplies(&mut self.rules, selected.active, Flow.reachable(&self.flow, usePoint))
                  let active = run addressApplies(&mut self.rules, inputActive, Flow.reachable(&self.flow, actual.execute))
                  let source = ValueId {index: value}
                  run List<InvocationWrite>.append(&mut self.invocationWrites, InvocationWrite {
                    operation: operation, read: read, operand: matchedOperand, usePoint: usePoint, address: address,
                    source: source, target: written.value, holder: holder, summary: written.summary, active: active})
                  let absent = Program.atom(&mut self.rules)
                  run List<Transfer>.append(&mut self.transfers, Transfer {source: source, target: written.value,
                    active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
                    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
                    policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.InvocationWrite {candidate: candidate}})
                }
              }
              value = value + usize.ONE
            }
          }
          input = input + usize.ONE
        }
        tag = tag + usize.ONE
      }
      address = address + usize.ONE
    }
    return before != List<InvocationWrite>.length(&self.invocationWrites)
      || beforeHolders != List<WriteHolder>.length(&self.writeHolders)
      || beforeTransfers != List<Transfer>.length(&self.transfers)
  }

  effect fn closeRetainedWrites<'body>(self: &mut Self, prepared: &SourcePreparation<'body>) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let before = List<RetainedWrite>.length(&self.writes)
    let beforeHolders = List<WriteHolder>.length(&self.writeHolders)
    let beforeTransfers = List<Transfer>.length(&self.transfers)
    let addresses = List<RetainedAddress>.length(&self.retainedAddresses)
    let mut address = usize.ZERO
    while address < addresses {
      let selected = List<RetainedAddress>.asSlice(&self.retainedAddresses)[address]
      let operation = &List<Stores.Operation>.asSlice(&self.stores.operations)[selected.operation]
      let result = operation.evaluation
      let point = operation.execute
      let inputCount = List<Stores.Input>.length(&operation.inputs)
      let execution = run Skeleton.execution(&mut self.*, result, point)
      let holder = run Skeleton.writeHolder(&mut self.*, prepared, execution, selected.storage)
      let components = List<WriteComponent>.asSlice(&List<WriteHolder>.asSlice(&self.writeHolders)[holder].components)
      let mut target = Option<ValueId>.none()
      let mut each = usize.ZERO
      while each < components.length {
        if sameStorage(components[each].storage, selected.storage) { target = Option<ValueId>.some(components[each].value) }
        each = each + usize.ONE
      }
      let targetSelected = match target { Option<ValueId>.Some {value} => value
        _ => { return CompilerBug.panic(b"retained destination escaped its actual canonical holder") } }
      let mut input = usize.ZERO
      while input < inputCount {
        let recorded = &List<Stores.Input>.asSlice(&List<Stores.Operation>.asSlice(&self.stores.operations)[selected.operation].inputs)[input]
        let operand = recorded.actual.evaluation
        let slotCount = List<Stores.Slot>.length(&recorded.slots)
        let route = recorded.route
        let retention = List<Stores.Operation>.asSlice(&self.stores.operations)[selected.operation].retention
        let retained = &List<Prepared.Retention>.asSlice(&prepared.retentions)[retention.index]
        let original = List<Prepared.Operation>.asSlice(&prepared.operations)
        let mut origin = usize.MAX
        let mut row = usize.ZERO
        while row < original.length {
          if original[row].site.index == retained.site.index { origin = row }
          row = row + usize.ONE
        }
        if origin == usize.MAX { return CompilerBug.panic(b"retained write lost its original input operation") }
        let root = maps[List<InputRoute>.asSlice(&original[origin].inputs)[route].map.index].source
        let valueCount = List<Value>.length(&self.values)
        let mut value = usize.ZERO
        while value < valueCount {
          let source = List<Value>.asSlice(&self.values)[value]
          if source.evaluation.index == operand.index && source.phase == ValuePhase.Output
            && match source.subject { Option<ResidualSubject>.None => true _ => false }
            && match source.summary { Option<usize>.None => true _ => false }
            && match source.transport { Option<AliasPort>.None => true _ => false }
            && inlineWithin(prepared, source.endpoint, root) {
            let mut slot = usize.ZERO
            while slot < slotCount {
              let active = selected.active
              let from = ValueId {index: value}
              run Skeleton.retainedCandidate(&mut self.*, selected.operation, input, slot, address,
                from, targetSelected, holder, Option<usize>.none(), active)
              // Policy can retain an unknown location below this actual address or a known
              // canonical ancestor. These are alternative placements, not additional fields.
              let mut tag = usize.ZERO
              while tag < 2 {
                let mut disposition = SummaryDisposition.Inherited
                if tag == usize.ZERO { disposition = SummaryDisposition.Ordinary }
                let mut prefix = selected.storage.endpoint
                let mut remaining = endpoints.length
                while remaining > usize.ZERO {
                  let entry = run Skeleton.summaryWrite(&mut self.*, holder,
                    Storage {endpoint: prefix, temporary: selected.storage.temporary},
                    OwnershipPlacement.Known {anchor: prefix, suffix: Option<OwnershipSuffix>.none()}, disposition)
                  let written = List<SummaryWrite>.asSlice(&self.summaryWrites)[entry]
                  run Skeleton.retainedCandidate(&mut self.*, selected.operation, input, slot, address,
                    from, written.value, holder, Option<usize>.some(written.summary), active)
                  let owner = List<WriteHolder>.asSlice(&self.writeHolders)[holder].storage.endpoint
                  if prefix.index == owner.index {
                    let unknown = run Skeleton.summaryWrite(&mut self.*, holder,
                      Storage {endpoint: owner, temporary: selected.storage.temporary}, OwnershipPlacement.Unknown, disposition)
                    let written = List<SummaryWrite>.asSlice(&self.summaryWrites)[unknown]
                    run Skeleton.retainedCandidate(&mut self.*, selected.operation, input, slot, address,
                      from, written.value, holder, Option<usize>.some(written.summary), active)
                    break
                  }
                  prefix = match endpoints[prefix.index].parent { Option<EndpointId>.Some {value: matchedParentEndpoint} => matchedParentEndpoint
                    _ => { return CompilerBug.panic(b"summary destination escaped its actual inline owner") } }
                  remaining = remaining - usize.ONE
                }
                tag = tag + usize.ONE
              }
              slot = slot + usize.ONE
            }
          }
          value = value + usize.ONE
        }
        input = input + usize.ONE
      }
      address = address + usize.ONE
    }
    return before != List<RetainedWrite>.length(&self.writes)
      || beforeHolders != List<WriteHolder>.length(&self.writeHolders)
      || beforeTransfers != List<Transfer>.length(&self.transfers)
  }

  /// Only the owning visitor may create entry storage, for actual parameters/capture aliases.
  /// Locals with a binding node obtain their definitions at that binding, never here.
  pub effect fn entry(self: &mut Self, local: LocalId, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let id = EvalId {index: List<Evaluation>.length(&self.evaluations)}
    run List<Evaluation>.append(&mut self.evaluations,
      Evaluation {site: EvaluationSite.Entry {local: local}, category: EvaluationRole.Entry, point: point})
    return id
  }

  pub effect fn value(self: &mut Self, evaluation: EvalId, endpoint: EndpointId) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    return run Skeleton.componentValue(&mut self.*, evaluation, endpoint, Option<ResidualSubject>.none(), ValuePhase.Output)
  }

  effect fn componentValue(self: &mut Self, evaluation: EvalId, endpoint: EndpointId,
    subject: Option<ResidualSubject>, phase: ValuePhase) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.values)
    let mut at = usize.ZERO
    while at < values.length {
      if values[at].evaluation.index == evaluation.index && values[at].endpoint.index == endpoint.index
        && values[at].phase == phase && sameSubject(values[at].subject, subject) {
        if let Option<AliasPort>.None = values[at].transport {
          if let Option<usize>.None = values[at].summary {
            if let Option<usize>.None = values[at].writeHolder { return ValueId {index: at} }
          }
        }
      }
      at = at + usize.ONE
    }
    let id = ValueId {index: values.length}
    run List<Value>.append(&mut self.values, Value {phase: phase, evaluation: evaluation, endpoint: endpoint, subject: subject, summary: Option<usize>.none(), writeHolder: Option<usize>.none(), cleared: Option<DefinitionId>.none(), summaryRead: Option<ReadId>.none(), transport: Option<AliasPort>.none()})
    return id
  }

  /// Product identity is bounded by reserved evaluations, physical anchors and frozen
  /// residual states. The base retains the actual descriptor occurrence being interpreted.
  effect fn selectedValue<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, base: ValueId,
    state: Prepared.ResidualStateId, read: EvalId) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.values)
    if base.index >= values.length || state.index >= List<Prepared.ResidualState>.length(&prepared.residuals) {
      return CompilerBug.panic(b"source product has an absent base occurrence or frozen suffix")
    }
    drop Skeleton.evaluation(&self.*, read)
    let mut physical = base
    if let Option<ResidualSubject>.Some {value: parent} = values[base.index].subject {
      physical = parent.base
      if physical.index >= values.length { return CompilerBug.panic(b"residual subject lost its physical anchor") }
      if let Option<ResidualSubject>.Some {..} = values[physical.index].subject {
        return CompilerBug.panic(b"residual products cannot recursively grow physical anchors")
      }
    }
    let value = values[physical.index]
    if let Option<usize>.Some {..} = value.summary { return CompilerBug.panic(b"opaque holding cannot become a selected physical descriptor") }
    return run Skeleton.componentValue(&mut self.*, read, value.endpoint,
      Option<ResidualSubject>.some(ResidualSubject {base: physical, state: state, position: Option<Results.Position>.none()}), ValuePhase.Output)
  }

  pub effect fn leaf(self: &mut Self, leaf: Leaf) -> LeafId
  ! OutOfMemoryError ? &mut Allocator {
    let id = LeafId {index: List<Leaf>.length(&self.leaves)}
    run List<Leaf>.append(&mut self.leaves, move leaf)
    return id
  }

  effect fn internStorage(self: &mut Self, storage: Storage) -> ComponentId ! OutOfMemoryError ? &mut Allocator {
    let existing = List<Storage>.asSlice(&self.storage)
    let mut at = usize.ZERO
    while at < existing.length {
      let summaries = List<SummaryStorage>.asSlice(&self.summaries)
      let mut summary = false
      let mut each = usize.ZERO
      while each < summaries.length {
        if summaries[each].component.index == at { summary = true }
        each = each + usize.ONE
      }
      if !summary && sameStorage(existing[at], storage) { return ComponentId {index: at} }
      at = at + usize.ONE
    }
    let component = ComponentId {index: existing.length}
    run List<Storage>.append(&mut self.storage, storage)
    return component
  }

  /// The prepared storage endpoint is the component identity. The value must already occupy
  /// that exact endpoint; a distinct RHS->storage map records physical placement separately.
  pub effect fn define(self: &mut Self, point: PointId, writer: EvalId, storage: Storage, value: ValueId,
    active: Atom, write: Write) -> DefinitionId ! OutOfMemoryError ? &mut Allocator {
    let values = List<Value>.asSlice(&self.values)
    if value.index >= values.length || values[value.index].endpoint.index != storage.endpoint.index {
      CompilerBug.panic(b"source definition does not name its stored component")
    }
    if let Option<usize>.Some {..} = values[value.index].summary { CompilerBug.panic(b"physical definition cannot use a summary holding") }
    if let Option<ResidualSubject>.Some {..} = values[value.index].subject {
      CompilerBug.panic(b"a selected residual is not a whole canonical storage definition")
    }
    if values[value.index].phase != ValuePhase.Output { CompilerBug.panic(b"a stored definition cannot be an unfinished read input") }
    let operation = Skeleton.evaluation(&self.*, writer)
    if operation.point.index != point.index { CompilerBug.panic(b"source definition writer is not at its actual write point") }
    let mut written = Option<EvalId>.none()
    if let EvaluationSite.Node {..} = operation.site { written = Option<EvalId>.some(writer) }
    let component = run Skeleton.internStorage(&mut self.*, storage)
    let definition = run Flow.define(&mut self.flow, point, component, active, write)
    run List<DefinedValue>.append(&mut self.definitions, DefinedValue {definition: definition, value: value, writer: written, summary: Option<usize>.none(), clears: Option<DefinitionId>.none()})
    return definition
  }

  pub effect fn read(self: &mut Self, point: PointId, storage: Storage, value: ValueId, map: Option<MapId>) -> ReadId
  ! OutOfMemoryError ? &mut Allocator {
    let output = List<Value>.asSlice(&self.values)[value.index]
    if let Option<usize>.Some {..} = output.summary { CompilerBug.panic(b"physical read cannot publish a summary as a physical value") }
    if output.phase != ValuePhase.Output { CompilerBug.panic(b"canonical reads require their published component") }
    let incoming = run Skeleton.componentValue(&mut self.*, output.evaluation, output.endpoint, output.subject, ValuePhase.Input)
    let mut published = false
    let transfers = List<Transfer>.asSlice(&self.transfers)
    let mut publication = usize.ZERO
    while publication < transfers.length {
      if transfers[publication].source.index == incoming.index && transfers[publication].target.index == value.index {
        published = true
      }
      publication = publication + usize.ONE
    }
    if !published {
      let active = Flow.reachable(&self.flow, point)
      let absent = Program.atom(&mut self.rules)
      run List<Transfer>.append(&mut self.transfers, Transfer {source: incoming, target: value,
        active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
    }
    let value = incoming
    let recorded = List<ReadValue>.asSlice(&self.reads)
    let mut at = usize.ZERO
    while at < recorded.length {
      if sameStorage(recorded[at].storage, storage) && recorded[at].value.index == value.index {
        let same = match recorded[at].map {
          Option<MapId>.Some {value: selected} => match map { Option<MapId>.Some {value: other} => selected.index == other.index _ => false }
          Option<MapId>.None => match map { Option<MapId>.None => true _ => false }
        }
        if same { return recorded[at].read }
      }
      at = at + usize.ONE
    }
    let component = run Skeleton.internStorage(&mut self.*, storage)
    let read = run Flow.read(&mut self.flow, point, component)
    run List<ReadValue>.append(&mut self.reads, ReadValue {read: read, storage: storage, value: value, map: move map, summary: Option<usize>.none()})
    return read
  }

  effect fn aliasNode(self: &mut Self, evaluation: EvalId, endpoint: EndpointId,
    storage: Storage, write: Write) -> usize ! OutOfMemoryError ? &mut Allocator {
    let aliases = List<StorageAlias>.asSlice(&self.aliases)
    let mut at = usize.ZERO
    while at < aliases.length {
      if aliases[at].evaluation.index == evaluation.index && aliases[at].endpoint.index == endpoint.index
        && sameStorage(aliases[at].storage, storage) && aliases[at].write == write { return at }
      at = at + usize.ONE
    }
    let id = aliases.length
    let active = Program.atom(&mut self.rules)
    run List<StorageAlias>.append(&mut self.aliases, StorageAlias {evaluation: evaluation,
      endpoint: endpoint, storage: storage, active: active, write: write})
    return id
  }

  effect fn aliasEdge(self: &mut Self, source: Option<usize>, target: usize,
    authority: AliasAuthority, applicable: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let edges = List<AliasEdge>.asSlice(&self.aliasEdges)
    let mut at = usize.ZERO
    let mut found = usize.MAX
    while at < edges.length {
      let sameSource = match source {
        Option<usize>.Some {value} => match edges[at].source { Option<usize>.Some {value: other} => value == other _ => false }
        _ => match edges[at].source { Option<usize>.None => true _ => false }
      }
      if sameSource && sameAliasAuthority(authority, edges[at].authority) && edges[at].target == target { found = at }
      at = at + usize.ONE
    }
    let mut edge = applicable
    let empty = List<Atom>.make()
    let none = List<Atom>.asSlice(&empty)
    if found == usize.MAX {
      edge = Program.atom(&mut self.rules)
      run List<AliasEdge>.append(&mut self.aliasEdges, AliasEdge {source: source, target: target, authority: authority, active: edge})
      let output = List<StorageAlias>.asSlice(&self.aliases)[target].active
      match source {
        Option<usize>.Some {value} => {
          let predecessor = List<StorageAlias>.asSlice(&self.aliases)[value].active
          let requires: [Atom; 2] = [predecessor, edge]
          run Program.rule(&mut self.rules, output, &requires, none)
        }
        Option<usize>.None => {
          let requires: [Atom; 1] = [edge]
          run Program.rule(&mut self.rules, output, &requires, none)
        }
      }
    } else {
      edge = List<AliasEdge>.asSlice(&self.aliasEdges)[found].active
    }
    let requires: [Atom; 1] = [applicable]
    run Program.rule(&mut self.rules, edge, &requires, none)
    return ()
  }

  effect fn aliasPort(self: &mut Self, request: usize, alias: usize) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let transport = List<AliasTransport>.asSlice(&self.aliasTransports)[request]
    let node = &List<StorageAlias>.asSlice(&self.aliases)[alias]
    let endpoint = node.endpoint
    if !sameStorage(node.storage, List<StorageAlias>.asSlice(&self.aliases)[transport.alias].storage) {
      return CompilerBug.panic(b"one address composition crossed canonical owners")
    }
    let values = List<Value>.asSlice(&self.values)
    let mut at = usize.ZERO
    while at < values.length {
      if let Option<AliasPort>.Some {value} = values[at].transport {
        if value.request == request && value.alias == alias { return ValueId {index: at} }
      }
      at = at + usize.ONE
    }
    let id = ValueId {index: values.length}
    run List<Value>.append(&mut self.values, Value {evaluation: transport.evaluation, endpoint: endpoint,
      phase: ValuePhase.Transport, subject: Option<ResidualSubject>.none(), summary: Option<usize>.none(), writeHolder: Option<usize>.none(), cleared: Option<DefinitionId>.none(), summaryRead: Option<ReadId>.none(),
      transport: Option<AliasPort>.some(AliasPort {request: request, alias: alias})})
    return id
  }

  /// Extend each actual read/write through new proof edges, with private per-use ports.
  /// Finite graph sharing replaces path copying; cycles alone cannot seed source presence.
  effect fn activateAliasTransports(self: &mut Self, maps: &[SelectionMap]) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let count = List<AliasEdge>.length(&self.aliasEdges)
    let length = List<AliasTransport>.length(&self.aliasTransports)
    let absent = Program.atom(&mut self.rules)
    let mut changed = false
    let mut request = usize.ZERO
    while request < length {
      let use = List<AliasTransport>.asSlice(&self.aliasTransports)[request]
      let storage = List<StorageAlias>.asSlice(&self.aliases)[use.alias].storage
      if use.closed > count { CompilerBug.panic(b"address proof edge reservation shrank") }
      let mut at = use.closed
      while at < count {
        let edge = List<AliasEdge>.asSlice(&self.aliasEdges)[at]
        let node = &List<StorageAlias>.asSlice(&self.aliases)[edge.target]
        let same = sameStorage(node.storage, storage)
        let address = node.evaluation
        if same {
          let target = run Skeleton.aliasPort(&mut self.*, request, edge.target)
          let mut source = target
          match edge.source {
            Option<usize>.Some {value} => { source = run Skeleton.aliasPort(&mut self.*, request, value) }
            Option<usize>.None => {
              if use.direction == MapDirection.Forward {
                // Consume the genuine pre-write Input. The canonical Output at this
                // same occurrence may be the Uninitialized definition installed by Move.
                let incoming = run reserveOwnerRead(&mut self.*, use.evaluation, storage)
                source = incoming.value
                let read = incoming.read
                let recorded = List<AliasRead>.asSlice(&self.aliasReads)
                let mut found = false
                let mut earlier = usize.ZERO
                while earlier < recorded.length {
                  if recorded[earlier].request == request && recorded[earlier].read.index == read.index { found = true }
                  earlier = earlier + usize.ONE
                }
                if !found { run List<AliasRead>.append(&mut self.aliasReads, AliasRead {request: request, read: read}) }
                if let AliasConsumer.Descriptor {request: retained, path, prefix, edge: matchedDescriptorEdge} = use.authority {
                  let consumer = match use.consumer { Option<ValueId>.Some {value} => value
                    _ => { return CompilerBug.panic(b"retained current read lost its actual consumer") } }
                  let request = &List<DescriptorRequest>.asSlice(&self.descriptorRequests)[retained]
                  match request.authority {
                    DescriptorRequestAuthority.Retained {request: retainedRequest} => {
                      let retainedReads = List<RetainedRead>.asSlice(&self.retainedReads)
                      let mut listed = false
                      let mut prior = usize.ZERO
                      while prior < retainedReads.length {
                        let previous = retainedReads[prior]
                        if previous.request == retainedRequest && previous.path == path && previous.prefix == prefix
                          && previous.edge == matchedDescriptorEdge && previous.read.index == read.index && previous.consumer.index == consumer.index { listed = true }
                        prior = prior + usize.ONE
                      }
                      if !listed {
                        run List<RetainedRead>.append(&mut self.retainedReads, RetainedRead {request: retainedRequest,
                          path: path, prefix: prefix, consumer: consumer, read: read, alias: use.alias, edge: matchedDescriptorEdge, active: use.active})
                      }
                    }
                    DescriptorRequestAuthority.Invocation {request: invocation} => {
                      let priorReads = List<InvocationRead>.asSlice(&self.invocationReads)
                      let mut listed = false
                      let mut prior = usize.ZERO
                      while prior < priorReads.length {
                        let previous = priorReads[prior]
                        if previous.request == invocation && previous.path == path && previous.prefix == prefix
                          && previous.edge == matchedDescriptorEdge && previous.read.index == read.index && previous.consumer.index == consumer.index { listed = true }
                        prior = prior + usize.ONE
                      }
                      if !listed {
                        run List<InvocationRead>.append(&mut self.invocationReads, InvocationRead {request: invocation,
                          path: path, prefix: prefix, consumer: consumer, read: read, alias: use.alias, edge: matchedDescriptorEdge, active: use.active})
                      }
                    }
                  }
                }
              } else {
                source = run Skeleton.value(&mut self.*, use.evaluation, storage.endpoint)
              }
            }
          }
          let mut authority = TransferAuthority.SameComponent
          if let Option<MapId>.Some {value: map} = aliasMap(edge.authority) {
            if map.index >= maps.length { CompilerBug.panic(b"address proof lost its exact prepared map") }
            authority = TransferAuthority.Physical {map: map, direction: use.direction, address: Option<EvalId>.some(address)}
          }
          match edge.authority {
            AliasAuthority.Selected {..} => { authority = TransferAuthority.Address {edge: at, direction: use.direction} }
            AliasAuthority.Origin {..} => { authority = TransferAuthority.Address {edge: at, direction: use.direction} }
            AliasAuthority.Slice {..} => { authority = TransferAuthority.Address {edge: at, direction: use.direction} }
            _ => ()
          }
          let active = run addressApplies(&mut self.rules, use.active, edge.active)
          let mut from = source
          let mut to = target
          if use.direction == MapDirection.StorageInverse { from = target to = source }
          run List<Transfer>.append(&mut self.transfers, Transfer {source: from, target: to, active: active,
            directness: Directness.Preserve, stored: absent, alternatives: absent,
            definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
            policy: TransferPolicy.Physical, terminal: false, authority: authority})
        }
        at = at + usize.ONE
      }
      if use.closed != count { changed = true }
      let mutableRows3 = List<AliasTransport>.asMutSlice(&mut self.aliasTransports)
      mutableRows3[request].closed = count
      request = request + usize.ONE
    }
    return changed
  }

  effect fn aliasDefinition(self: &mut Self, operation: usize, storage: Storage, target: EvalId,
    active: Atom, write: Write, unavailable: Option<Origin>) -> () ! OutOfMemoryError ? &mut Allocator {
    let existing = List<AliasDefinition>.asSlice(&self.aliasDefinitions)
    let mut index = usize.ZERO
    let mut found = usize.MAX
    while index < existing.length {
      if existing[index].operation == operation && sameStorage(existing[index].storage, storage) { found = index }
      index = index + usize.ONE
    }
    let mut joined = active
    if found == usize.MAX {
      joined = Program.atom(&mut self.rules)
      let actual = Skeleton.evaluation(&self.*, target)
      let mut definition = DefinitionId {index: usize.MAX}
      match unavailable {
        Option<Origin>.Some {value: origin} => {
          definition = run Skeleton.uninitialize(&mut self.*, storage, target, origin, joined, write)
        }
        Option<Origin>.None => {
          let value = run Skeleton.value(&mut self.*, target, storage.endpoint)
          definition = run Skeleton.define(&mut self.*, actual.point, target, storage, value, joined, write)
        }
      }
      run List<AliasDefinition>.append(&mut self.aliasDefinitions, AliasDefinition {
        operation: operation, storage: storage, active: joined, definition: definition})
    } else {
      let previous = &List<AliasDefinition>.asSlice(&self.aliasDefinitions)[found]
      joined = previous.active
      if write == Write.Weak { Flow.weaken(&mut self.flow, previous.definition) }
    }
    let input: [Atom; 1] = [active]
    let none = List<Atom>.make()
    run Program.rule(&mut self.rules, joined, &input, List<Atom>.asSlice(&none))
    return ()
  }

  effect fn activateSelections<'body>(self: &mut Self, prepared: &SourcePreparation<'body>) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let length = List<SelectionUse>.length(&self.selections)
    let mut index = usize.ZERO
    while index < length {
      let request = &List<SelectionUse>.asSlice(&self.selections)[index]
      run validateSelectionUse(prepared, request, List<Evaluation>.asSlice(&self.evaluations))
      let operand = request.operand
      let result = request.result
      let active = request.active
      let strength = request.strength
      let value = request.value
      let place = request.place
      // These families are also the exact output side of a later boundary composition.
      // Ordinary inline storage already has matching aliases; a reference/slice boundary
      // supplies them only through its occurrence-sensitive product, never by this map alone.
      if let Option<MapId>.Some {value: map} = place {
        run Skeleton.projectAliases(&mut self.*, endpoints, maps, map, operand, result, strength)
      }
      if let Option<MapId>.Some {value: map} = value {
        run Skeleton.readAliases(&mut self.*, endpoints, maps, map, operand, result, active)
      }
      index = index + usize.ONE
    }
    return ()
  }

  /// Extends operations only for newly discovered actual aliases. Destination definitions and
  /// their gates keep stable identities across rounds; no solved fact or policy is sampled.
  effect fn activateAliasOperations(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap]) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    let count = List<StorageAlias>.length(&self.aliases)
    let length = List<AliasOperation>.length(&self.aliasOperations)
    let mut changed = false
    let mut operation = usize.ZERO
    while operation < length {
      let request = List<AliasOperation>.asSlice(&self.aliasOperations)[operation]
      if request.closed > count { CompilerBug.panic(b"actual source alias inventory shrank") }
      if request.closed < count {
        match request.kind {
          AliasOperationKind.Project {map, source, target, write} => {
            run Skeleton.emitAliasProjection(&mut self.*, endpoints, maps, map, source, target, write, request.closed, count)
          }
          AliasOperationKind.Read {map, source, target, active} => {
            run Skeleton.emitAliasRead(&mut self.*, endpoints, maps, map, source, target, active, request.closed, count)
          }
          AliasOperationKind.Write {map, address, target, active, ..} => {
            run Skeleton.emitAliasWrite(&mut self.*, endpoints, maps, map, address, target, active, operation, request.closed, count)
          }
          AliasOperationKind.Invalidate {address, root, target, origin, active} => {
            let mut alias = request.closed
            while alias < count {
              let actual = &List<StorageAlias>.asSlice(&self.aliases)[alias]
              if actual.evaluation.index == address.index && componentWithin(endpoints, actual.endpoint, root) {
                let storage = actual.storage
                let write = actual.write
                let applicable = run addressApplies(&mut self.rules, active, actual.active)
                run Skeleton.aliasDefinition(&mut self.*, operation, storage, target, applicable, write, Option<Origin>.some(origin))
              }
              alias = alias + usize.ONE
            }
          }
        }
        let mutableRows4 = List<AliasOperation>.asMutSlice(&mut self.aliasOperations)
        mutableRows4[operation].closed = count
        changed = true
      }
      operation = operation + usize.ONE
    }
    return changed
  }

  /// Observe an actual owner at its cleanup/use point. The cause node names the action,
  /// not the storage being read. Only canonical inline storage is observed; reference
  /// referents and Effect channels are not owned fields and cannot be read by this walk.
  pub effect fn observeStorage<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    storage: Storage, evaluation: EvalId) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
    if actual.category != EvaluationRole.Cleanup || storage.endpoint.index >= endpoints.length {
      return CompilerBug.panic(b"owner observation has no actual cleanup occurrence or storage")
    }
    let root = &endpoints[storage.endpoint.index]
    let whole = match root.parent { Option<EndpointId>.None => true _ => false }
    let identity = match &root.root {
      Root.Local {local, category} => local.index < prepared.body.locals.length && category == EndpointRole.Storage
        && match storage.temporary { Option<EvalId>.None => true _ => false }
      Root.Node {node, category} => category == EndpointRole.Storage && match storage.temporary {
        Option<EvalId>.Some {value} => match Skeleton.evaluation(&self.*, value).site {
          EvaluationSite.Node {node: owner} => owner.index == node.index
          _ => false
        }
        _ => false
      }
      _ => false
    }
    if !whole || !identity { return CompilerBug.panic(b"cleanup observation changed its canonical owner identity") }
    let mut pending = List<EndpointId>.make()
    run List<EndpointId>.append(&mut pending, storage.endpoint)
    let result = run Skeleton.value(&mut self.*, evaluation, storage.endpoint)
    let mut at = usize.ZERO
    while at < List<EndpointId>.length(&pending) {
      let endpoint = List<EndpointId>.asSlice(&pending)[at]
      let value = run Skeleton.value(&mut self.*, evaluation, endpoint)
      drop run Skeleton.read(&mut self.*, actual.point,
        Storage {endpoint: endpoint, temporary: storage.temporary}, value, Option<MapId>.none())
      let components = List<Prepared.Component>.asSlice(&shapes[endpoints[endpoint.index].shape.index].components)
      let mut component = usize.ZERO
      while component < components.length {
        if components[component].inline {
          let mut found = usize.MAX
          let mut child = usize.ZERO
          while child < endpoints.length {
            let parent = match endpoints[child].parent {
              Option<EndpointId>.Some {value: matchedParentEndpoint} => matchedParentEndpoint.index == endpoint.index
              _ => false
            }
            if parent && sameSelector(&endpoints[child].selector, &components[component].selector) {
              if found != usize.MAX { CompilerBug.panic(b"owned storage repeats a prepared inline component") }
              found = child
            }
            child = child + usize.ONE
          }
          if found == usize.MAX { CompilerBug.panic(b"owned storage omitted a prepared inline component") }
          run List<EndpointId>.append(&mut pending, EndpointId {index: found})
        }
        component = component + usize.ONE
      }
      at = at + usize.ONE
    }
    return result
  }

  /// Close only the newly reserved storage pairs into the SAME transfer graph. Boundary
  /// discovery can append an actual later read and call this again before Flow.emit; no
  /// source/policy truth is sampled and no earlier pair is duplicated or replaced.
  pub effect fn closeStorage(self: &mut Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    let pairs = run Flow.reservePairs(&mut self.flow, &mut self.rules)
    let count = pairs.length
    if self.closedPairs > count { CompilerBug.panic(b"source storage pair reservation shrank") }
    let changed = self.closedPairs != count
    run storageTransfers(pairs, self.closedPairs, List<DefinedValue>.asSlice(&self.definitions),
      List<ReadValue>.asSlice(&self.reads), &mut self.transfers, &mut self.rules)
    self.closedPairs = count
    return changed
  }

  /// Materialize an actually addressed rvalue. Frozen temporary maps alone never call this:
  /// the structural visitor or explicit producer reference must supply its actual evaluation.
  pub effect fn materialize(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, evaluation: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let node = match actual.site { EvaluationSite.Node {node} => node _ => { return CompilerBug.panic(b"entry is not a temporary evaluation") } }
    let family = run transferFamily(endpoints, maps, map)
    let absent = Program.atom(&mut self.rules)
    drop run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, evaluation,
      active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let members = List<MapId>.asSlice(&family)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      let from = match &endpoints[physical.source.index].root {
        Root.Node {node: matchedSource, category} => matchedSource.index == node.index && category == EndpointRole.Value _ => false
      }
      let into = match &endpoints[physical.target.index].root {
        Root.Node {node: target, category} => target.index == node.index && category == EndpointRole.Storage _ => false
      }
      if !from || !into || physical.kind != MapKind.Place { CompilerBug.panic(b"temporary materialization lacks its exact evaluated value placement") }
      let storage = Storage {endpoint: physical.target, temporary: Option<EvalId>.some(evaluation)}
      let existing = List<StorageAlias>.asSlice(&self.aliases)
      let mut at = usize.ZERO
      while at < existing.length {
        if existing[at].evaluation.index == evaluation.index && existing[at].endpoint.index == physical.target.index {
          CompilerBug.panic(b"one actual temporary occurrence was materialized twice")
        }
        at = at + usize.ONE
      }
      let value = run Skeleton.value(&mut self.*, evaluation, physical.target)
      drop run Skeleton.define(&mut self.*, actual.point, evaluation, storage, value, active, Write.Strong)
      let alias = run Skeleton.aliasNode(&mut self.*, evaluation, physical.target, storage, Write.Strong)
      run Skeleton.aliasEdge(&mut self.*, Option<usize>.none(), alias, AliasAuthority.Canonical, active)
      member = member + usize.ONE
    }
    return ()
  }

  /// A local whole/component read binds every explicitly prepared inline map to the same
  /// actual read evaluation. Entry and loan-free definitions therefore follow the same path
  /// as borrowed definitions, including later replacements reaching a loop backedge.
  pub effect fn readLocal(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    evaluation: EvalId, local: LocalId) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let sameSite = match actual.site {
      EvaluationSite.Node {node} => node.index == maps[map.index].site.index
      _ => false
    }
    if !sameSite { CompilerBug.panic(b"a local read map was attached to another occurrence") }
    let members = List<MapId>.asSlice(&family)
    let root = run Skeleton.value(&mut self.*, evaluation, maps[map.index].target)
    let mut at = usize.ZERO
    while at < members.length {
      let member = members[at]
      let physical = &maps[member.index]
      let storage = match &endpoints[physical.source.index].root {
        Root.Local {local: found, category} => found.index == local.index && category == EndpointRole.Storage
        _ => false
      }
      if !storage || physical.kind != MapKind.Copy {
        CompilerBug.panic(b"a local read must name canonical local storage and a prepared Copy map")
      }
      let value = run Skeleton.value(&mut self.*, evaluation, physical.target)
      drop run Skeleton.read(&mut self.*, actual.point, Storage {endpoint: physical.source, temporary: Option<EvalId>.none()}, value, Option<MapId>.some(member))
      at = at + usize.ONE
    }
    return root
  }

  /// Local place formation binds the explicit Storage->Storage family to this occurrence.
  /// No value is copied and no declaration/read pairing is guessed until an actual read occurs.
  pub effect fn localAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    evaluation: EvalId, local: LocalId) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"local place map has a different actual occurrence") }
    let mut at = usize.ZERO
    while at < members.length {
      let physical = &maps[members[at].index]
      let canonical = match &endpoints[physical.source.index].root {
        Root.Local {local: owner, category} => owner.index == local.index && category == EndpointRole.Storage
        _ => false
      }
      let storage = match move endpointRole(&endpoints[physical.target.index]) {
        Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
      }
      if !canonical || !storage || physical.kind != MapKind.Select {
        CompilerBug.panic(b"local address map does not identify canonical storage")
      }
      let alias = run Skeleton.aliasNode(&mut self.*, evaluation, physical.target,
        Storage {endpoint: physical.source, temporary: Option<EvalId>.none()}, Write.Strong)
      let active = Flow.reachable(&self.flow, actual.point)
      run Skeleton.aliasEdge(&mut self.*, Option<usize>.none(), alias, AliasAuthority.Project {map: members[at]}, active)
      at = at + usize.ONE
    }
    return ()
  }

  /// An inline place projection composes exact address evidence. It does not read the old
  /// stored value or turn an unknown reference selector into an owned-storage alias.
  pub effect fn projectAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, write: Write) -> () ! OutOfMemoryError ? &mut Allocator {
    drop run transferFamily(endpoints, maps, map)
    // Address formation composes an already evaluated operand with its later projection.
    // Runtime loop cycles are source-flow edges, not recursively expanding address paths.
    if source.index >= target.index { CompilerBug.panic(b"source address projection does not follow operand evaluation") }
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Project {map: map, source: source, target: target, write: write}, closed: usize.ZERO})
    return ()
  }

  effect fn emitAliasProjection(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, write: Write, first: usize, limit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let actual = Skeleton.evaluation(&self.*, target)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"projected address map has a different actual occurrence") }
    let members = List<MapId>.asSlice(&family)
    let previous = limit
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Select { CompilerBug.panic(b"projected storage identity requires a Select map") }
      let mut at = first
      while at < previous {
        let alias = &List<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == source.index && alias.endpoint.index == physical.source.index {
          let storage = alias.storage
          let mut strength = write
          if alias.write == Write.Weak { strength = Write.Weak }
          let mut authority = AliasAuthority.Project {map: members[member]}
          let sourceStorage = match endpointRole(&endpoints[physical.source.index]) {
            Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
          }
          if !sourceStorage {
            let selection = run selectedAliasMap(&self.*, endpoints, maps, members[member], source, target)
            authority = AliasAuthority.Selected {selection: selection, map: members[member]}
          }
          let next = run Skeleton.aliasNode(&mut self.*, target, physical.target, storage, strength)
          let active = Flow.reachable(&self.flow, actual.point)
          run Skeleton.aliasEdge(&mut self.*, Option<usize>.some(at), next, authority, active)
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// Read canonical storage at THIS operation's point, then compose its already-authenticated
  /// address maps. Reusing an earlier base's value would miss intervening writes/backedges.
  /// Intermediate ports share the actual read evaluation; map.site still names the real earlier
  /// address formation, so the proof exposes both facts without inventing another evaluation.
  pub effect fn readAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    drop run transferFamily(endpoints, maps, map)
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Read {map: map, source: source, target: target, active: active}, closed: usize.ZERO})
    return ()
  }

  effect fn emitAliasRead(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom, first: usize, limit: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let actual = Skeleton.evaluation(&self.*, target)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"projected read map has a different actual occurrence") }
    let absent = Program.atom(&mut self.rules)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Copy { CompilerBug.panic(b"projected value read requires a prepared Copy map") }
      let count = limit
      let mut at = first
      while at < count {
        let alias = &List<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == source.index && alias.endpoint.index == physical.source.index {
          let applicable = run addressApplies(&mut self.rules, active, alias.active)
          let request = List<AliasTransport>.length(&self.aliasTransports)
          let onward = run Skeleton.value(&mut self.*, target, physical.target)
          run List<AliasTransport>.append(&mut self.aliasTransports, AliasTransport {consumer: Option<ValueId>.some(onward),
            alias: at, authority: AliasConsumer.Projection {map: members[member]}, evaluation: target, active: applicable,
            direction: MapDirection.Forward, closed: usize.ZERO})
          let incoming = run Skeleton.aliasPort(&mut self.*, request, at)
          run List<Transfer>.append(&mut self.transfers, Transfer {source: incoming, target: onward,
            active: applicable, directness: Directness.Preserve, stored: absent, alternatives: absent,
            definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical,
            terminal: false, authority: TransferAuthority.Physical {map: members[member], direction: MapDirection.Forward,
              address: Option<EvalId>.none()}})
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// A whole local binding/replacement installs all components even when its value has no
  /// Borrow leaf. Strong kills are definitions of actual values, not side effects of finding
  /// an existing held loan. Field/conditional stores use their separately authenticated target.
  pub effect fn writeLocal(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, local: LocalId, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, target)
    let absent = Program.atom(&mut self.rules)
    let root = run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, target, active,
      Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let mut at = usize.ZERO
    while at < members.length {
      let physical = &maps[members[at].index]
      let storage = match &endpoints[physical.target.index].root {
        Root.Local {local: found, category} => found.index == local.index && category == EndpointRole.Storage
        _ => false
      }
      if !storage || physical.kind != MapKind.Place {
        CompilerBug.panic(b"a local replacement must name canonical local storage and a prepared Place map")
      }
      let stored = run Skeleton.value(&mut self.*, target, physical.target)
      drop run Skeleton.define(&mut self.*, actual.point, target, Storage {endpoint: physical.target, temporary: Option<EvalId>.none()}, stored, active, Write.Strong)
      at = at + usize.ONE
    }
    return root
  }

  /// Place through an actual owned address. The RHS follows its frozen placement map; the
  /// inverse address chain only chooses canonical storage. It is not a new value copy or a
  /// reference-content proof. Runtime-index alternatives remain weak writes to each candidate.
  pub effect fn writeAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, address: EvalId, target: EvalId, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let absent = Program.atom(&mut self.rules)
    drop run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, target, active,
      Directness.Preserve, absent, absent, TransferPolicy.Physical)
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Write {map: map, source: source, address: address, target: target, active: active}, closed: usize.ZERO})
    return ()
  }

  effect fn emitAliasWrite(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    address: EvalId, target: EvalId, active: Atom, operation: usize, first: usize, limit: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let absent = Program.atom(&mut self.rules)
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Place { CompilerBug.panic(b"projected replacement has no prepared Place map") }
      let count = limit
      let mut at = first
      while at < count {
        let alias = &List<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == address.index && alias.endpoint.index == physical.target.index {
          let storage = alias.storage
          let applicable = run addressApplies(&mut self.rules, active, alias.active)
          let mut write = alias.write
          // Alternative address routes to one canonical component are histories of the same
          // write, not extra definitions. A non-singleton address cannot acquire a strong kill
          // merely because a second route to that component was visited first.
          let aliases = List<StorageAlias>.asSlice(&self.aliases)
          let mut other = usize.ZERO
          while other < aliases.length {
            if aliases[other].evaluation.index == address.index && sameStorage(aliases[other].storage, storage)
              && aliases[other].write == Write.Weak { write = Write.Weak }
            other = other + usize.ONE
          }
          let request = List<AliasTransport>.length(&self.aliasTransports)
          run List<AliasTransport>.append(&mut self.aliasTransports, AliasTransport {consumer: Option<ValueId>.none(),
            alias: at, authority: AliasConsumer.Projection {map: members[member]}, evaluation: target, active: applicable,
            direction: MapDirection.StorageInverse, closed: usize.ZERO})
          let before = run Skeleton.value(&mut self.*, target, physical.target)
          let onward = run Skeleton.aliasPort(&mut self.*, request, at)
          run List<Transfer>.append(&mut self.transfers, Transfer {source: before, target: onward,
            active: applicable, directness: Directness.Preserve, stored: absent, alternatives: absent,
            definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical,
            terminal: false, authority: TransferAuthority.SameComponent})
          run Skeleton.aliasDefinition(&mut self.*, operation, storage, target, applicable, write, Option<Origin>.none())
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// The displaced value is read after the RHS completes, at a separate point before
  /// installation. Publication forwards that snapshot; it never rereads the replaced storage.
  pub effect fn replace<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, replacement: &Prepared.Replacement,
    address: EvalId, source: EvalId, read: EvalId, result: EvalId, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    validateReplacement(prepared, replacement)
    let readAt = Skeleton.evaluation(&self.*, read)
    let writtenAt = Skeleton.evaluation(&self.*, result)
    let sameRead = match readAt.site { EvaluationSite.Node {node} => node.index == replacement.site.index _ => false }
    let sameWrite = match writtenAt.site { EvaluationSite.Node {node} => node.index == replacement.site.index _ => false }
    if !sameRead || !sameWrite || readAt.category != EvaluationRole.Replacement || writtenAt.category != EvaluationRole.Value
      || readAt.point.index == writtenAt.point.index {
      CompilerBug.panic(b"replacement lost its distinct displaced-read and installation occurrences")
    }
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let actualAddress = Skeleton.evaluation(&self.*, address)
    let actualSource = Skeleton.evaluation(&self.*, source)
    let addressed = match &endpoints[maps[replacement.displaced.index].source.index].root {
      Root.Node {node, ..} => match actualAddress.site { EvaluationSite.Node {node: actual} => actual.index == node.index _ => false }
      _ => false
    }
    let supplied = match &endpoints[maps[replacement.installed.index].source.index].root {
      Root.Node {node, ..} => match actualSource.site { EvaluationSite.Node {node: actual} => actual.index == node.index _ => false }
      _ => false
    }
    if !addressed || !supplied { CompilerBug.panic(b"replacement substituted another argument evaluation") }
    run Skeleton.readAliases(&mut self.*, endpoints, maps, replacement.displaced, address, read, active)
    run Skeleton.writeAliases(&mut self.*, endpoints, maps, replacement.installed, source, address, result, active)
    let family = run transferFamily(endpoints, maps, replacement.displaced)
    let members = List<MapId>.asSlice(&family)
    let absent = Program.atom(&mut self.rules)
    let mut at = usize.ZERO
    while at < members.length {
      let endpoint = maps[members[at].index].target
      let before = run Skeleton.value(&mut self.*, read, endpoint)
      let after = run Skeleton.value(&mut self.*, result, endpoint)
      run List<Transfer>.append(&mut self.transfers, Transfer {source: before, target: after, active: active,
        directness: Directness.Preserve, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
      at = at + usize.ONE
    }
    return ()
  }

  fn evaluation(self: &Self, id: EvalId) -> Evaluation {
    let actual = List<Evaluation>.asSlice(&self.evaluations)
    if id.index >= actual.length { CompilerBug.panic(b"source transfer has no actual evaluation") }
    return actual[id.index]
  }

  /// Destruction is an actual definition of unavailable storage, not absence of a held
  /// loan. Copies read before this point keep their predecessor; a later read (including a
  /// backedge) observes Uninitialized. Ownership independently reports the exact move/drop.
  pub effect fn invalidateAliases(self: &mut Self, endpoints: &[Endpoint], address: EvalId,
    root: EndpointId, target: EvalId, origin: Origin, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if root.index >= endpoints.length { CompilerBug.panic(b"consumed source address has no prepared root") }
    run List<AliasOperation>.append(&mut self.aliasOperations, AliasOperation {
      kind: AliasOperationKind.Invalidate {address: address, root: root, target: target, origin: origin, active: active}, closed: usize.ZERO})
    return ()
  }

  // Unavailable is an explicit source definition. It is neither a synthetic RHS nor a
  // LoanFree value, and it cannot make a later mandatory source obligation disappear.
  effect fn uninitialize(self: &mut Self, storage: Storage, evaluation: EvalId, origin: Origin,
    active: Atom, write: Write) -> DefinitionId ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let node = match actual.site { EvaluationSite.Node {node} => node _ => { return CompilerBug.panic(b"entry is not a consuming operation") } }
    let absent = Program.atom(&mut self.rules)
    let value = run Skeleton.value(&mut self.*, evaluation, storage.endpoint)
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Unknown {
      node: Option<NodeId>.some(node), reason: UnknownReason.Uninitialized}, origin: origin, endpoint: storage.endpoint})
    run List<Seed>.append(&mut self.seeds, Seed {category: SourceRole.Physical, value: value, leaf: leaf,
      direct: false, active: active, stored: absent, alternatives: absent})
    return run Skeleton.define(&mut self.*, actual.point, evaluation, storage, value, active, write)
  }

  /// A real owner end kills its own reserved storage components. Reference descriptors which
  /// were copied earlier keep their earlier definition; their referent's end remains a distinct
  /// ownership fact. This does not recursively destroy storage reached through a reference.
  pub effect fn endOwner(self: &mut Self, endpoints: &[Endpoint], root: EndpointId,
    owner: Option<EvalId>, evaluation: EvalId, origin: Origin, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if root.index >= endpoints.length { CompilerBug.panic(b"source owner end has no prepared root") }
    let actual = Skeleton.evaluation(&self.*, evaluation)
    if actual.category != EvaluationRole.Cleanup { CompilerBug.panic(b"source owner end has no actual lifecycle occurrence") }
    let count = List<Storage>.length(&self.storage)
    let mut at = usize.ZERO
    while at < count {
      let storage = List<Storage>.asSlice(&self.storage)[at]
      let sameOwner = match owner {
        Option<EvalId>.Some {value} => match storage.temporary { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
        Option<EvalId>.None => match storage.temporary { Option<EvalId>.None => true _ => false }
      }
      if sameOwner && componentWithin(endpoints, storage.endpoint, root) {
        // Only components actually materialized as this owner's storage enter this table.
        // Refuse an accidental boundary descendant rather than end a foreign referent.
        let mut component = storage.endpoint
        let mut remaining = endpoints.length
        while component.index != root.index && remaining > usize.ZERO {
          match &endpoints[component.index].selector {
            Selector.Referent => CompilerBug.panic(b"owner end cannot destroy a referent through its descriptor")
            Selector.CallableResult => CompilerBug.panic(b"owner end cannot destroy a callable result")
            Selector.EffectSuccess => CompilerBug.panic(b"owner end cannot destroy an Effect result")
            Selector.EffectFailure => CompilerBug.panic(b"owner end cannot destroy an Effect failure")
            _ => ()
          }
          component = match endpoints[component.index].parent {
            Option<EndpointId>.Some {value} => value
            _ => { return CompilerBug.panic(b"source owner component lost its storage ancestry") }
          }
          remaining = remaining - usize.ONE
        }
        if remaining == usize.ZERO { CompilerBug.panic(b"source owner component ancestry is cyclic") }
        drop run Skeleton.uninitialize(&mut self.*, storage, evaluation, origin, active, Write.Strong)
      }
      at = at + usize.ONE
    }
    return ()
  }

  /// A prepared Effect is an actual descriptor-producing expression. Reuse the exact
  /// existing root seed (including genuinely empty layouts); never use a same-node Eval.
  /// This identity adds no capture placement, loan, referent contents or invocation result.
  effect fn prepareEffectDescriptor<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    operation: &Results.Operation, construction: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
    let constructions = List<Prepared.Construction>.asSlice(&prepared.constructions)
    if construction >= constructions.length { return CompilerBug.panic(b"Effect descriptor lost its actual construction") }
    let original = &constructions[construction]
    let actual = Skeleton.evaluation(&self.*, operation.evaluation)
    let site = match actual.site { EvaluationSite.Node {node} => node.index == original.site.index _ => false }
    if !site { return CompilerBug.panic(b"Effect descriptor construction changed its actual occurrence") }
    let channels = List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)
    let mut descriptor = Option<EndpointId>.none()
    let mut at = usize.ZERO
    while at < channels.length {
      if channels[at].site.index == original.site.index && channels[at].application.index == original.application.index
        && channels[at].channel == PreparedContractPort.Success {
        if let Option<EndpointId>.Some {..} = descriptor { return CompilerBug.panic(b"Effect producer has duplicate success channels") }
        descriptor = Option<EndpointId>.some(channels[at].descriptor)
      }
      at = at + usize.ONE
    }
    let descriptorSelected = match descriptor { Option<EndpointId>.Some {value} => value
      _ => { return CompilerBug.panic(b"Effect descriptor has no exact prepared producer channel") } }
    let value = run Skeleton.value(&mut self.*, operation.evaluation, descriptorSelected)
    let actualValue = List<Value>.asSlice(&self.values)[value.index]
    if let Option<usize>.Some {..} = actualValue.summary {
      return CompilerBug.panic(b"Effect producer seed substituted summary storage")
    }
    if let Option<usize>.Some {..} = actualValue.writeHolder {
      return CompilerBug.panic(b"Effect producer seed substituted a retained write holder")
    }
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let empty = match &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoints[descriptorSelected.index].shape.index].state {
      PreparedShapeState.KnownEmpty => true _ => false
    }
    let seeds = List<Seed>.asSlice(&self.seeds)
    let leaves = List<Leaf>.asSlice(&self.leaves)
    let mut found = usize.MAX
    at = usize.ZERO
    while at < seeds.length {
      if seeds[at].value.index == value.index {
        let leaf = &leaves[seeds[at].leaf.index]
        let genuine = match &leaf.kind {
          SourceLeaf.Expression {node} => node.index == original.site.index
          SourceLeaf.LoanFree {node} => empty && node.index == original.site.index
          _ => false
        }
        if !genuine || leaf.endpoint.index != descriptorSelected.index || seeds[at].direct || found != usize.MAX {
          return CompilerBug.panic(b"Effect descriptor replaced or duplicated its genuine producer seed")
        }
        found = at
      }
      at = at + usize.ONE
    }
    if found != usize.MAX { return found }
    // Physical empty layouts were already seeded by Traversal, independently of contracts.
    if empty { return CompilerBug.panic(b"empty Effect descriptor lost its original layout seed") }
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Expression {node: original.site},
      origin: prepared.body.nodes[original.site.index].origin, endpoint: descriptorSelected})
    let absent = Program.atom(&mut self.rules)
    let seed = List<Seed>.length(&self.seeds)
    run List<Seed>.append(&mut self.seeds, Seed {category: SourceRole.Physical, value: value, leaf: leaf, direct: false,
      active: Flow.reachable(&self.flow, actual.point), stored: absent, alternatives: absent})
    return seed
  }

  /// Install the actual Traversal-authenticated operation occurrences once. Preparation
  /// remains metadata; NamedInvoke emits its original routes immediately. ExecuteEffect
  /// retains its actual receiver Eval/usePoint for the common finite descriptor closure.
  /// CallableInvoke is activated only by the common actual receiver/projection closure.
  pub effect fn installResults<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, inventory: Results.Inventory)
  -> () ! OutOfMemoryError ? &mut Allocator {
    if self.operationResultsInstalled { CompilerBug.panic(b"actual operation result inventory was installed twice") }
    self.operationResultsInstalled = true
    let operations = List<Results.Operation>.asSlice(&inventory.operations)
    let rows = List<Prepared.Operation>.asSlice(&prepared.operations)
    let pointCount = Flow.reservedPoints(&self.flow).length
    let mut operation = usize.ZERO
    while operation < operations.length {
      let actual = &operations[operation]
      if actual.prepared >= rows.length || actual.execute.index >= pointCount {
        CompilerBug.panic(b"operation result inventory lost its prepared row or actual execution")
      }
      let row = &rows[actual.prepared]
      let evaluation = Skeleton.evaluation(&self.*, actual.evaluation)
      let site = match evaluation.site { EvaluationSite.Node {node} => node.index == row.site.index _ => false }
      if !site || evaluation.category == EvaluationRole.Execute {
        CompilerBug.panic(b"operation result inventory changed its actual result occurrence")
      }
      let mut earlier = usize.ZERO
      while earlier < operation {
        if operations[earlier].evaluation.index == actual.evaluation.index {
          CompilerBug.panic(b"one operation occurrence has duplicate result plans")
        }
        earlier = earlier + usize.ONE
      }
      let inputs = List<Results.Input>.asSlice(&actual.inputs)
      let routes = List<InputRoute>.asSlice(&row.inputs)
      if inputs.length != routes.length { CompilerBug.panic(b"operation result inventory omitted an actual input route") }
      let mut input = usize.ZERO
      while input < inputs.length {
        let selected = inputs[input]
        if selected.route >= routes.length || selected.actual.usePoint.index >= pointCount {
          CompilerBug.panic(b"operation input lost its route or actual use point")
        }
        let read = match selected.actual.read { Option<InputRead>.Some {value} => value
          _ => { return CompilerBug.panic(b"operation input lost its actual typed read") } }
        let operand = inputOperand(prepared, row.site, routes[selected.route].read)
        let at = Skeleton.evaluation(&self.*, selected.actual.evaluation)
        let same = match at.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
        if !same || selected.actual.node.index != operand.index || !sameInputRead(read, routes[selected.route].read) {
          CompilerBug.panic(b"operation input changed its actual operand occurrence")
        }
        earlier = usize.ZERO
        while earlier < input {
          if inputs[earlier].route == selected.route { CompilerBug.panic(b"operation input route was activated twice") }
          earlier = earlier + usize.ONE
        }
        input = input + usize.ONE
      }
      match &actual.plan {
        ResultsPlan.NamedInvoke {application, result, outputs} => {
          let exact = match row.application { Option<ApplicationId>.Some {value} => value.index == application.index _ => false }
          let output = match row.result { Option<MapId>.Some {value} => value.index == result.index _ => false }
          if row.phase != PreparedOperationPhase.Invoke || !exact || !output {
            CompilerBug.panic(b"named result plan changed its application or phase")
          }
          if let Option<Results.Receiver>.Some {..} = actual.receiver {
            CompilerBug.panic(b"named result plan substituted a runtime descriptor receiver")
          }
          let active = run addressApplies(&mut self.rules, Flow.reachable(&self.flow, actual.execute),
            Flow.reachable(&self.flow, evaluation.point))
          let outputsSelected = List<Results.Output>.asSlice(&outputs)
          let mut outputIndex = usize.ZERO
          while outputIndex < outputsSelected.length {
            let contributors = List<Results.Contributor>.asSlice(&outputsSelected[outputIndex].contributors)
            let mut contributor = usize.ZERO
            while contributor < contributors.length {
              let original = &contributors[contributor]
              Results.validateContributor(prepared, actual.prepared, outputsSelected[outputIndex].map,
                original.projection, original.continuation, original.selection)
              run List<OperationContributor>.append(&mut self.operationContributors,
                OperationContributor {operation: operation, output: outputIndex, contributor: contributor, active: active})
              let candidates = List<Results.Candidate>.asSlice(&original.candidates)
              let mut candidate = usize.ZERO
              while candidate < candidates.length {
                let selected = candidates[candidate]
                let continued = match original.continuation {
                  Option<Prepared.ContractContinuationId>.Some {value} => match selected.continuation {
                    Option<Prepared.ContractContinuationId>.Some {value: other} => value.index == other.index _ => false }
                  Option<Prepared.ContractContinuationId>.None => match selected.continuation {
                    Option<Prepared.ContractContinuationId>.None => true _ => false }
                }
                if selected.operation != actual.prepared || selected.result.index != actual.evaluation.index
                  || selected.output.index != outputsSelected[outputIndex].map.index || selected.projection.index != original.projection.index
                  || selected.selection.index != original.selection.index || !continued {
                  CompilerBug.panic(b"operation result candidate left its original contributor")
                }
                let mut bound = false
                input = usize.ZERO
                while input < inputs.length {
                  let source = inputs[input]
                  let binding = match selected.binding {
                    ResultsBinding.Argument {input: route, position, ..} => source.route == route && source.position == position
                    _ => false
                  }
                  if binding
                    && source.actual.evaluation.index == selected.operand.index && source.actual.usePoint.index == selected.usePoint.index {
                    bound = true
                  }
                  input = input + usize.ONE
                }
                if !bound { CompilerBug.panic(b"operation result candidate lost its exact actual input position") }
                let applicable = run addressApplies(&mut self.rules, active, Flow.reachable(&self.flow, selected.usePoint))
                drop run Skeleton.operationResult(&mut self.*, prepared, selected, applicable)
                candidate = candidate + usize.ONE
              }
              contributor = contributor + usize.ONE
            }
            outputIndex = outputIndex + usize.ONE
          }
        }
        ResultsPlan.PrepareEffect {construction, ..} => {
          // BC owns all physical Construction activation. No invocation/write/result edge.
          if row.phase != PreparedOperationPhase.PrepareEffect { CompilerBug.panic(b"prepared Effect plan changed its phase") }
          drop run Skeleton.prepareEffectDescriptor(&mut self.*, prepared, actual, construction)
        }
        ResultsPlan.CallableInvoke {..} => {
          if row.phase != PreparedOperationPhase.Invoke { CompilerBug.panic(b"callable invocation plan changed its phase") }
        }
        ResultsPlan.ExecuteEffect {..} => {
          if row.phase != PreparedOperationPhase.ExecuteEffect { CompilerBug.panic(b"Effect execution plan changed its phase") }
        }
      }
      operation = operation + usize.ONE
    }
    self.operationResults = move inventory
    return ()
  }

  /// Publish one actual operation-result candidate. Input binding and original/application
  /// correspondence are retained as a compound authority, never a fabricated physical map.
  pub effect fn operationResult<'body>(self: &mut Self, prepared: &SourcePreparation<'body>,
    candidate: Results.Candidate, active: Atom) -> List<ValueId> ! OutOfMemoryError ? &mut Allocator {
    Results.validateCandidate(prepared, candidate)
    let operation = &List<Prepared.Operation>.asSlice(&prepared.operations)[candidate.operation]
    let inputs = List<InputRoute>.asSlice(&operation.inputs)
    let operand = match candidate.binding {
      ResultsBinding.Argument {input, ..} => inputOperand(prepared, operation.site, inputs[input].read)
      ResultsBinding.CallableArgument {input, ..} => inputOperand(prepared, operation.site, inputs[input].read)
      ResultsBinding.DescriptorInput {..} => inputOperand(prepared, operation.site, InputRead.Receiver)
    }
    let sourceAt = Skeleton.evaluation(&self.*, candidate.operand)
    let resultAt = Skeleton.evaluation(&self.*, candidate.result)
    let sourceMatches = match sourceAt.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
    let resultMatches = match resultAt.site { EvaluationSite.Node {node} => node.index == operation.site.index _ => false }
    if !sourceMatches || !resultMatches || candidate.usePoint.index >= Flow.reservedPoints(&self.flow).length {
      return CompilerBug.panic(b"result candidate changed its actual operation or operand occurrence")
    }
    let source = run Skeleton.value(&mut self.*, candidate.operand, candidate.source)
    let anchor = run Skeleton.value(&mut self.*, candidate.result, candidate.target)
    let placement = run Results.outputPlacement(prepared, candidate)
    let mut positions = List<Option<Results.Position>>.make()
    match &placement.suffix {
      ResultsPlacementSuffix.Whole => run List<Option<Results.Position>>.append(&mut positions, Option<Results.Position>.none())
      ResultsPlacementSuffix.Selected {targets, ..} => {
        let targetsSelected = List<Results.Position>.asSlice(&targets)
        let mut at = usize.ZERO
        while at < targetsSelected.length {
          run List<Option<Results.Position>>.append(&mut positions, Option<Results.Position>.some(targetsSelected[at]))
          at = at + usize.ONE
        }
      }
    }
    let mut outputs = List<ValueId>.make()
    let positionsSelected = List<Option<Results.Position>>.asSlice(&positions)
    let absent = Program.atom(&mut self.rules)
    let mut at = usize.ZERO
    while at < positionsSelected.length {
      let position = positionsSelected[at]
      let mut target = anchor
      if let Option<Results.Position>.Some {value} = position {
        let state = Results.positionState(prepared, value)
        target = run Skeleton.componentValue(&mut self.*, candidate.result, candidate.target,
          Option<ResidualSubject>.some(ResidualSubject {base: anchor, state: state, position: position}), ValuePhase.Output)
      }
      run List<Transfer>.append(&mut self.transfers, Transfer {source: source, target: target,
        active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Filtered, terminal: false,
        authority: TransferAuthority.OperationResult {candidate: candidate, position: position}})
      run List<ValueId>.append(&mut outputs, target)
      at = at + usize.ONE
    }
    return move outputs
  }

  /// Address composition can end after the canonical storage read. Collect that final
  /// selected component at the read's Input, rather than filtering individual histories or
  /// interpreting the canonical owner's endpoint as the selected result.
  effect fn readResultInput(self: &mut Self, value: ValueId, emitted: usize) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let output = List<Value>.asSlice(&self.values)[value.index]
    let incoming = run Skeleton.componentValue(&mut self.*, output.evaluation, output.endpoint,
      output.subject, ValuePhase.Input)
    let mut publication = false
    let mut index = usize.ZERO
    while index < List<Transfer>.length(&self.transfers) {
      let transfer = &mut List<Transfer>.asMutSlice(&mut self.transfers)[index]
      if transfer.target.index == value.index {
        if transfer.source.index == incoming.index {
          publication = true
        } else {
          if index < emitted { CompilerBug.panic(b"a read phase changed after its source rules were emitted") }
          transfer.target = incoming
        }
      }
      index = index + usize.ONE
    }
    if !publication {
      let active = Flow.reachable(&self.flow, Skeleton.evaluation(&self.*, output.evaluation).point)
      let absent = Program.atom(&mut self.rules)
      run List<Transfer>.append(&mut self.transfers, Transfer {source: incoming, target: value,
        active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
    }
    let mut request = usize.ZERO
    while request < List<AliasTransport>.length(&self.aliasTransports) {
      let transport = &mut List<AliasTransport>.asMutSlice(&mut self.aliasTransports)[request]
      if let Option<ValueId>.Some {value: consumer} = transport.consumer {
        if consumer.index == value.index { transport.consumer = Option<ValueId>.some(incoming) }
      }
      request = request + usize.ONE
    }
    return incoming
  }

  effect fn prepareReadResults<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, emitted: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let mut request = usize.ZERO
    while request < List<ResultUse>.length(&self.results) {
      let use = &List<ResultUse>.asSlice(&self.results)[request]
      if let ResultKind.Read {read} = use.kind {
        let result = use.evaluation
        let node = match Skeleton.evaluation(&self.*, read).site {
          EvaluationSite.Node {node} => node
          _ => { return CompilerBug.panic(b"a result read must name an actual expression") }
        }
        let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
        let count = List<Value>.length(&self.values)
        let mut index = usize.ZERO
        while index < count {
          let value = List<Value>.asSlice(&self.values)[index]
          let selected = match &endpoints[value.endpoint.index].root {
            Root.Node {node: owner, category} => owner.index == node.index && category == EndpointRole.Value
            _ => false
          }
          if value.evaluation.index == read.index && value.phase == ValuePhase.Output && selected {
            let incoming = run Skeleton.readResultInput(&mut self.*, ValueId {index: index}, emitted)
            // Replace publishes its earlier displaced read at a distinct result point.
            // Keep that snapshot, but policy sees the joined input at the actual read.
            if result.index != read.index {
              let mut transfer = usize.ZERO
              while transfer < List<Transfer>.length(&self.transfers) {
                let edge = &List<Transfer>.asSlice(&self.transfers)[transfer]
                let target = List<Value>.asSlice(&self.values)[edge.target.index]
                let identity = match edge.authority { TransferAuthority.SameComponent => true _ => false }
                if edge.source.index == index && target.evaluation.index == result.index
                  && target.endpoint.index == value.endpoint.index && identity {
                  if transfer < emitted { CompilerBug.panic(b"a displaced read changed after its source rules were emitted") }
                  let mutableRows5 = List<Transfer>.asMutSlice(&mut self.transfers)
                  mutableRows5[transfer].source = incoming
                }
                transfer = transfer + usize.ONE
              }
            }
          }
          index = index + usize.ONE
        }
      }
      request = request + usize.ONE
    }
    return ()
  }

  /// Select terminal policy edges only after structural transfer/address closure. Incoming
  /// histories first meet at one read Input; publication is a distinct Output component.
  effect fn activateResults<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, emitted: usize) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let requests = List<ResultUse>.asSlice(&self.results)
    let values = List<Value>.asSlice(&self.values)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let mut request = usize.ZERO
    while request < requests.length {
      let use = &requests[request]
      let actual = Skeleton.evaluation(&self.*, use.evaluation)
      let node = match actual.site {
        EvaluationSite.Node {node} => node
        _ => { return CompilerBug.panic(b"entry storage cannot be a terminal expression result") }
      }
      let mut earlier = usize.ZERO
      while earlier < request {
        if requests[earlier].evaluation.index == use.evaluation.index {
          CompilerBug.panic(b"one actual result has multiple semantic finish handlers")
        }
        earlier = earlier + usize.ONE
      }
      let sources = List<EvalId>.asSlice(&use.sources)
      let mut index = emitted
      while index < List<Transfer>.length(&self.transfers) {
        let transfer = &List<Transfer>.asSlice(&self.transfers)[index]
        let source = values[transfer.source.index]
        let target = values[transfer.target.index]
        let physicalOutput = match &endpoints[target.endpoint.index].root {
          Root.Node {node: owner, category} => owner.index == node.index && category == EndpointRole.Value
          _ => false
        }
        let mut terminal = false
        if target.evaluation.index == use.evaluation.index && target.phase == ValuePhase.Output && physicalOutput {
          match use.kind {
            ResultKind.Declared => {
              terminal = match transfer.authority { TransferAuthority.OperationResult {..} => true
                TransferAuthority.OrdinaryResult {..} => true _ => false }
            }
            ResultKind.Read {read} => {
              terminal = source.evaluation.index == read.index && source.phase == ValuePhase.Input
                && source.endpoint.index == target.endpoint.index && sameSubject(source.subject, target.subject)
                && match transfer.authority { TransferAuthority.SameComponent => true _ => false }
              if let TransferAuthority.ThroughResult {candidate, ..} = transfer.authority {
                let candidate = List<ThroughResultCandidate>.asSlice(&self.throughResultCandidates)[candidate]
                let flight = List<ThroughFlightRequest>.asSlice(&self.throughFlightRequests)[candidate.request]
                terminal = flight.kind == ThroughFlightKind.Read && flight.evaluation.index == read.index
                  && flight.operation.index == use.evaluation.index && candidate.source.index == transfer.source.index
                  && candidate.target.index == transfer.target.index
              }
            }
            ResultKind.Physical => {
              let declared = match transfer.authority { TransferAuthority.OperationResult {..} => true _ => false }
              if !declared && source.phase == ValuePhase.Output {
                if let Option<ResidualSubject>.None = target.subject {
                  let mut input = usize.ZERO
                  while input < sources.length {
                    if sources[input].index == source.evaluation.index { terminal = true }
                    input = input + usize.ONE
                  }
                }
              }
            }
          }
        }
        if terminal {
          let active = run addressApplies(&mut self.rules, transfer.active, use.active)
          let transfer = &mut List<Transfer>.asMutSlice(&mut self.transfers)[index]
          if transfer.terminal { CompilerBug.panic(b"terminal result transfer was activated twice") }
          transfer.active = active
          transfer.policy = TransferPolicy.Filtered
          transfer.terminal = true
        }
        index = index + usize.ONE
      }
      request = request + usize.ONE
    }
    return ()
  }

  /// Instantiates exactly the producer's frozen map family at two actual evaluations. Child
  /// endpoints come from explicit child-map IDs, never a scan for equal types or same-site maps.
  /// This only reserves transfers: it creates no source, owner, storage alias or evaluation.
  pub effect fn transfer(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom, directness: Directness,
    stored: Atom, alternatives: Atom, policy: TransferPolicy) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    if source.index >= List<Evaluation>.length(&self.evaluations)
      || target.index >= List<Evaluation>.length(&self.evaluations) {
      CompilerBug.panic(b"a physical source transfer has no actual evaluation")
    }
    let occurrence = List<Evaluation>.asSlice(&self.evaluations)[target.index]
    let sameSite = match occurrence.site {
      EvaluationSite.Node {node} => node.index == maps[map.index].site.index
      _ => false
    }
    if !sameSite { CompilerBug.panic(b"physical transfer was attached to another evaluation occurrence") }
    let resultSelected = run Skeleton.value(&mut self.*, target, maps[map.index].target)
    let mut at = usize.ZERO
    while at < members.length {
      let member = members[at]
      let from = run Skeleton.value(&mut self.*, source, maps[member.index].source)
      let to = run Skeleton.value(&mut self.*, target, maps[member.index].target)
      run List<Transfer>.append(&mut self.transfers, Transfer {
        source: from, target: to, active: active, directness: directness,
        stored: stored, alternatives: alternatives,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: policy, terminal: false, authority: TransferAuthority.Physical {map: member, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
      at = at + usize.ONE
    }
    return resultSelected
  }

  /// Conversion preserves the actual descriptor source. Element maps belong exclusively
  /// to later reads; activating them here would freeze borrowed storage at conversion time.
  pub effect fn arraySlice<'body>(self: &mut Self, prepared: &SourcePreparation<'body>, conversion: &Prepared.ArraySlice,
    source: EvalId, target: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    validateArraySlice(prepared, conversion)
    let maps = List<SelectionMap>.asSlice(&prepared.maps)
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    let actual = Skeleton.evaluation(&self.*, source)
    let from = &endpoints[maps[conversion.descriptor.index].source.index]
    let matches = match &from.root {
      Root.Node {node, ..} => match actual.site { EvaluationSite.Node {node: selected} => node.index == selected.index _ => false }
      _ => false
    }
    if !matches { CompilerBug.panic(b"array slice substituted another descriptor occurrence") }
    let absent = Program.atom(&mut self.rules)
    let descriptor = run Skeleton.transfer(&mut self.*, endpoints, maps, conversion.descriptor, source, target,
      active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let rows = List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)
    let mut selected = usize.MAX
    let mut at = usize.ZERO
    while at < rows.length {
      if rows[at].descriptor.index == conversion.descriptor.index {
        if selected != usize.MAX { CompilerBug.panic(b"array slice descriptor has duplicate prepared conversions") }
        selected = at
      }
      at = at + usize.ONE
    }
    if selected == usize.MAX { CompilerBug.panic(b"array slice lost its frozen conversion identity") }
    run List<SliceConversion>.append(&mut self.slices, SliceConversion {prepared: selected, source: source, descriptor: descriptor})
    return ()
  }

  /// Binds one producer-selected capture/input route. Copy/Move/Evaluated transfer existing
  /// values; only explicit Borrow transport creates a new descriptor source. Its distinct
  /// referent family authenticates later address interpretation from the SAME source evaluation.
  /// The visitor owns the real borrow event/loan; its ID is required only for that transport.
  pub effect fn input(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], route: &InputRoute,
    source: EvalId, target: EvalId, acquisition: Option<ReferenceAcquisition>, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    if route.map.index >= maps.length { CompilerBug.panic(b"producer input has no physical map") }
    let created = route.transport == Transport.BorrowShared || route.transport == Transport.BorrowMutable
    let absent = Program.atom(&mut self.rules)
    if !created {
      if let Option<MapId>.Some {..} = &route.referent {
        CompilerBug.panic(b"a value transfer cannot create a second reference")
      }
      if let Option<ReferenceAcquisition>.Some {..} = acquisition {
        CompilerBug.panic(b"a value transfer cannot supply a new borrow loan")
      }
      return run Skeleton.transfer(&mut self.*, endpoints, maps, route.map, source, target, active,
        Directness.Preserve, absent, absent, TransferPolicy.Physical)
    }
    let referent = match route.referent {
      Option<MapId>.Some {value} => value
      _ => { return CompilerBug.panic(b"producer-created reference has no paired referent map") }
    }
    let acquired = match acquisition {
      Option<ReferenceAcquisition>.Some {value} => value
      _ => { return CompilerBug.panic(b"producer-created reference has no actual borrow event") }
    }
    return run Skeleton.reference(&mut self.*, endpoints, maps, route.map, referent, source, acquired.evaluation, target,
      acquired.loan, Option<NodeId>.none(), active)
  }

  /// Authored borrows own their exact pair independently of contract inputs. The actual loan
  /// is created by the ownership consumer at this occurrence, not inferred from a region atom.
  pub effect fn borrow<'body>(self: &mut Self, preparation: &SourcePreparation<'body>, borrowed: &Prepared.Borrow,
    source: EvalId, target: EvalId, loan: usize, active: Atom) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    validateAuthoredBorrow(preparation, borrowed)
    let operand = match &preparation.body.nodes[borrowed.site.index].kind {
      NodeKind.Expression {form: Expression.Borrow {value, ..}, ..} => value
      _ => { return CompilerBug.panic(b"authored borrow changed its typed node") }
    }
    let actual = Skeleton.evaluation(&self.*, source)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
    if !matches { CompilerBug.panic(b"authored borrow does not use its actual operand occurrence") }
    return run Skeleton.reference(&mut self.*, List<Endpoint>.asSlice(&preparation.endpoints),
      List<SelectionMap>.asSlice(&preparation.maps), borrowed.map, borrowed.referent,
      source, target, target, loan, Option<NodeId>.some(borrowed.site), active)
  }

  effect fn reference(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId, referent: MapId,
    source: EvalId, acquisition: EvalId, target: EvalId, actualLoan: usize, node: Option<NodeId>, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    validateReferenceMaps(endpoints, maps, map, referent)
    let absent = Program.atom(&mut self.rules)
    let acquired = Skeleton.evaluation(&self.*, acquisition)
    let result = Skeleton.evaluation(&self.*, target)
    let acquiredHere = match acquired.site { EvaluationSite.Node {node: matchedNode} => matchedNode.index == maps[map.index].site.index _ => false }
    let returnedHere = match result.site { EvaluationSite.Node {node: matchedNode} => matchedNode.index == maps[map.index].site.index _ => false }
    if !acquiredHere || !returnedHere { CompilerBug.panic(b"reference acquisition and result disagree with their physical producer") }
    if acquisition.index != target.index && acquired.category != EvaluationRole.Capture {
      CompilerBug.panic(b"implicit reference has no distinct acquisition occurrence")
    }
    let descriptor = run Skeleton.value(&mut self.*, acquisition, maps[map.index].target)
    let leaves = List<Leaf>.asSlice(&self.leaves)
    let mut at = usize.ZERO
    while at < leaves.length {
      if let SourceLeaf.Borrow {loan: previous, ..} = &leaves[at].kind {
        if previous == actualLoan { CompilerBug.panic(b"one borrow event was created by two producer routes") }
      }
      at = at + usize.ONE
    }
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Borrow {loan: actualLoan, node: move node},
      origin: maps[map.index].origin, endpoint: maps[map.index].target})
    run List<Seed>.append(&mut self.seeds, Seed {category: SourceRole.Physical, value: descriptor, leaf: leaf,
      direct: true, active: active, stored: absent, alternatives: absent})
    // Neither Storage -> descriptor nor Value -> Referent copies old contents. The former
    // creates the descriptor above; the latter authenticates the source component for the
    // later residual/address product. A later use must observe reaching storage at that use.
    run List<ReferenceOrigin>.append(&mut self.references, ReferenceOrigin {leaf: leaf,
      source: source, descriptor: descriptor, map: map, referent: referent, ownership: Option<ThroughDescriptor>.none()})
    if acquisition.index == target.index { return descriptor }
    let resultSelected = run Skeleton.value(&mut self.*, target, maps[map.index].target)
    // Same physical descriptor, published only if the enclosing expression completes. The
    // acquisition seed remains reachable independently of this later successful result.
    run List<Transfer>.append(&mut self.transfers, Transfer {source: descriptor, target: resultSelected,
      active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
      policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
    return resultSelected
  }
}

// The consumer site is independent of the subject root: two empty-path pattern bindings
// may select precisely the same subject but still perform different actual reads.
effect fn validateSelectionUse<'body>(prepared: &SourcePreparation<'body>, request: &SelectionUse,
  evaluations: &[Evaluation]) -> () ! OutOfMemoryError ? &mut Allocator {
  let selections = List<Selection>.asSlice(&prepared.selections)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  if request.operand.index >= evaluations.length || request.result.index >= evaluations.length
    || request.selection.index >= selections.length {
    CompilerBug.panic(b"source selection has an absent actual occurrence or prepared selection")
  }
  let selected = &selections[request.selection.index]
  let site = match evaluations[request.result.index].site {
    EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"source projection result is not an actual node evaluation") }
  }
  if selected.site.index != site.index || selected.root.index >= endpoints.length {
    CompilerBug.panic(b"source selection belongs to another consumer site")
  }
  let actual = match &endpoints[selected.root.index].root {
    Root.Node {node, ..} => match evaluations[request.operand.index].site {
      EvaluationSite.Node {node: operand} => operand.index == node.index
      _ => false
    }
    _ => false
  }
  if !actual { CompilerBug.panic(b"source selection lost its retained subject occurrence") }
  let listed = List<MapId>.asSlice(&selected.maps)
  let selectors = List<MapId>.asSlice(&request.selectors)
  let mut terminal = selected.root
  let mut at = usize.ZERO
  while at < selectors.length {
    let id = selectors[at]
    if id.index >= maps.length { CompilerBug.panic(b"source selection names an absent selector") }
    let map = &maps[id.index]
    if map.site.index != site.index || map.kind != MapKind.Select || map.source.index != terminal.index {
      CompilerBug.panic(b"source selection lost its ordered authored selector path")
    }
    let mut found = usize.ZERO
    let mut each = usize.ZERO
    while each < listed.length {
      if listed[each].index == id.index { found = found + usize.ONE }
      each = each + usize.ONE
    }
    if found != usize.ONE { CompilerBug.panic(b"source selector is not a unique member of its prepared selection") }
    terminal = map.target
    at = at + usize.ONE
  }
  let accepted = List<EndpointId>.asSlice(&selected.accepts)
  if accepted.length == usize.ZERO { CompilerBug.panic(b"source selection has no explicit accepting frontier") }
  let families: [Option<MapId>; 2] = [request.value, request.place]
  let mut family = usize.ZERO
  while family < families.length {
    if let Option<MapId>.Some {value: root} = families[family] {
      let members = run transferFamily(endpoints, maps, root)
      let map = &maps[root.index]
      let mut expectedKind = MapKind.Copy
      let mut expectedRole = EndpointRole.Value
      if family == usize.ONE {
        expectedKind = MapKind.Select
        expectedRole = EndpointRole.Storage
      }
      let output = match &endpoints[map.target.index].root {
        Root.Node {node, category} => node.index == site.index && category == expectedRole
        _ => false
      }
      if map.site.index != site.index || map.source.index != terminal.index
        || map.kind != expectedKind || !output {
        CompilerBug.panic(b"source projection output family is not its exact consumer placement")
      }
      let children = List<MapId>.asSlice(&members)
      let mut leafCount = usize.ZERO
      at = usize.ZERO
      while at < children.length {
        let child = &maps[children[at].index]
        if List<MapId>.length(&child.children) == usize.ZERO {
          let mut matches = usize.ZERO
          let mut each = usize.ZERO
          while each < accepted.length {
            if accepted[each].index == child.source.index { matches = matches + usize.ONE }
            each = each + usize.ONE
          }
          if matches != usize.ONE { CompilerBug.panic(b"source projection changed its accepting component frontier") }
          leafCount = leafCount + usize.ONE
        }
        at = at + usize.ONE
      }
      if leafCount != accepted.length { CompilerBug.panic(b"source projection omitted an accepting component") }
    }
    family = family + usize.ONE
  }
  return ()
}

// The family is a finite tree of actual inline component maps. Reject malformed cycles or
// duplicate ownership; do not turn them into a truncated/opaque source route.
effect fn transferFamily(endpoints: &[Endpoint], maps: &[SelectionMap], root: MapId) -> List<MapId>
! OutOfMemoryError ? &mut Allocator {
  if root.index >= maps.length { CompilerBug.panic(b"physical transfer has no prepared map") }
  let mut family = List<MapId>.make()
  run List<MapId>.append(&mut family, root)
  let mut next = usize.ZERO
  while next < List<MapId>.length(&family) {
    let index = List<MapId>.asSlice(&family)[next].index
    let map = &maps[index]
    if map.source.index >= endpoints.length || map.target.index >= endpoints.length {
      CompilerBug.panic(b"physical transfer map has an absent endpoint")
    }
    let children = List<MapId>.asSlice(&map.children)
    let mut child = usize.ZERO
    while child < children.length {
      let nested = children[child]
      if nested.index >= maps.length { CompilerBug.panic(b"physical transfer family has an absent child map") }
      let found = List<MapId>.asSlice(&family)
      let mut previous = usize.ZERO
      while previous < found.length {
        if found[previous].index == nested.index { CompilerBug.panic(b"physical transfer family repeats a child map") }
        previous = previous + usize.ONE
      }
      let inner = &maps[nested.index]
      if inner.source.index >= endpoints.length || inner.target.index >= endpoints.length
        || inner.site.index != map.site.index || inner.kind != map.kind {
        CompilerBug.panic(b"physical transfer child belongs to another operation")
      }
      let fromParent = match &endpoints[inner.source.index].parent {
        Option<EndpointId>.Some {value} => value.index == map.source.index
        _ => false
      }
      let toParent = match &endpoints[inner.target.index].parent {
        Option<EndpointId>.Some {value} => value.index == map.target.index
        _ => false
      }
      if !fromParent || !toParent { CompilerBug.panic(b"physical transfer child is not its paired inline component") }
      run List<MapId>.append(&mut family, nested)
      child = child + usize.ONE
    }
    next = next + usize.ONE
  }
  return move family
}

effect fn selectedAliasMap(skeleton: &Skeleton, endpoints: &[Endpoint], maps: &[SelectionMap],
  map: MapId, source: EvalId, target: EvalId) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let mut at = usize.ZERO
  while at < selections.length {
    let selected = &selections[at]
    if selected.operand.index == source.index && selected.result.index == target.index {
      if let Option<MapId>.Some {value: root} = selected.place {
        let family = run transferFamily(endpoints, maps, root)
        let members = List<MapId>.asSlice(&family)
        let mut each = usize.ZERO
        while each < members.length {
          if members[each].index == map.index { return at }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"selected address projection has no actual selector occurrence")
}

effect fn addressApplies(rules: &mut Program, operation: Atom, address: Atom) -> Atom
! OutOfMemoryError ? &mut Allocator {
  let result = Program.atom(&mut rules.*)
  let both: [Atom; 2] = [operation, address]
  let absent = List<Atom>.make()
  run Program.rule(&mut rules.*, result, &both, List<Atom>.asSlice(&absent))
  return result
}

// Descendant identity within one frozen component tree; never a comparison of types or
// region sets. Aliases supplied here were already restricted to actual inline storage.
fn validateSummaries<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let storage = List<Storage>.asSlice(&skeleton.storage)
  let values = List<Value>.asSlice(&skeleton.values)
  let definitions = List<DefinedValue>.asSlice(&skeleton.definitions)
  let reads = List<ReadValue>.asSlice(&skeleton.reads)
  let actualDefinitions = Flow.reservedDefinitions(&skeleton.flow)
  let actualReads = Flow.reservedReads(&skeleton.flow)
  let mut at = usize.ZERO
  while at < summaries.length {
    let summary = summaries[at]
    if summary.component.index >= storage.length || !sameStorage(summary.prefix, storage[summary.component.index]) {
      CompilerBug.panic(b"summary lost its distinct canonical Flow component")
    }
    validateOwnershipPlacement(prepared, List<ReferenceOrigin>.asSlice(&skeleton.references), values, List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions), summary.placement)
    if let Option<EndpointId>.Some {value: anchor} = ownershipAnchor(summary.placement) {
      if anchor.index != summary.prefix.endpoint.index { CompilerBug.panic(b"summary canonical prefix changed its inline anchor") }
    }
    if unknownOwnership(summary.placement) && storageOwner(prepared, summary.prefix.endpoint).index != summary.prefix.endpoint.index {
      CompilerBug.panic(b"opaque holding must retain its whole canonical owner")
    }
    let mut prior = usize.ZERO
    while prior < at {
      if summaries[prior].component.index == summary.component.index
        || (sameStorage(summaries[prior].prefix, summary.prefix) && sameOwnershipPlacement(summaries[prior].placement, summary.placement) && summaries[prior].disposition == summary.disposition) {
        CompilerBug.panic(b"summary storage has duplicate canonical identity")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < definitions.length {
    let definition = definitions[at]
    let value = values[definition.value.index]
    let component = actualDefinitions[at].component
    match definition.summary {
      Option<usize>.Some {value: summary} => {
        let selected = match value.summary { Option<usize>.Some {value: other} => other == summary _ => false }
        if summary >= summaries.length || summaries[summary].component.index != component.index
          || !selected || value.phase != ValuePhase.Output || value.endpoint.index != summaries[summary].prefix.endpoint.index {
          CompilerBug.panic(b"summary definition changed its canonical prefix or private value")
        }
      }
      Option<usize>.None => {
        if let Option<usize>.Some {..} = value.summary { CompilerBug.panic(b"physical definition acquired an opaque summary") }
        let mut each = usize.ZERO
        while each < summaries.length {
          if summaries[each].component.index == component.index { CompilerBug.panic(b"physical definition used a summary component") }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  let cleared = List<SummaryClear>.asSlice(&skeleton.summaryClears)
  at = usize.ZERO
  while at < cleared.length {
    let clear = cleared[at]
    if clear.summary >= summaries.length || clear.original.index >= definitions.length || clear.definition.index >= definitions.length {
      CompilerBug.panic(b"summary clearing lost its actual physical definition")
    }
    let source = definitions[clear.original.index]
    let target = definitions[clear.definition.index]
    let before = actualDefinitions[clear.original.index]
    let after = actualDefinitions[clear.definition.index]
    let prefix = summaries[clear.summary].prefix
    let original = storage[before.component.index]
    let exact = match target.clears { Option<DefinitionId>.Some {value} => value.index == clear.original.index _ => false }
    if let Option<usize>.Some {..} = source.summary { CompilerBug.panic(b"summary clearing cannot recursively clear another summary") }
    if !exact || before.point.index != after.point.index || !Atom.same(clear.active, after.active)
      || before.write != after.write || after.component.index != summaries[clear.summary].component.index
      || !sameTemporary(original.temporary, prefix.temporary) || !inlineWithin(prepared, prefix.endpoint, original.endpoint)
      || !moveSummaryClear(prepared, skeleton, source.definition) {
      CompilerBug.panic(b"summary clearing strengthened or moved an actual covering write")
    }
    at = at + usize.ONE
  }
  let selectedReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  at = usize.ZERO
  while at < selectedReads.length {
    let selected = selectedReads[at]
    if selected.summary >= summaries.length || selected.original.index >= reads.length || selected.read.index >= reads.length {
      CompilerBug.panic(b"summary read lost its actual requested read")
    }
    let original = reads[selected.original.index]
    let summary = reads[selected.read.index]
    let prefix = summaries[selected.summary].prefix
    if let Option<usize>.Some {..} = original.summary { CompilerBug.panic(b"summary read recursively selected another summary") }
    let exact = match summary.summary { Option<usize>.Some {value} => value == selected.summary _ => false }
    if !exact || !sameStorage(summary.storage, prefix) || selected.target.index != original.value.index
      || actualReads[selected.original.index].point.index != actualReads[selected.read.index].point.index
      || actualReads[selected.read.index].component.index != summaries[selected.summary].component.index
      || !sameTemporary(original.storage.temporary, prefix.temporary)
      || !(inlineWithin(prepared, original.storage.endpoint, prefix.endpoint) || inlineWithin(prepared, prefix.endpoint, original.storage.endpoint)) {
      CompilerBug.panic(b"summary read substituted a different owner or noninline requested component")
    }
    at = at + usize.ONE
  }
  let written = List<SummaryWrite>.asSlice(&skeleton.summaryWrites)
  let holders = List<WriteHolder>.asSlice(&skeleton.writeHolders)
  at = usize.ZERO
  while at < written.length {
    let write = written[at]
    if write.summary >= summaries.length || write.holder >= holders.length || write.definition.index >= definitions.length {
      CompilerBug.panic(b"summary write lost its real coalesced holder")
    }
    let prefix = summaries[write.summary].prefix
    let holder = &holders[write.holder]
    let actual = actualDefinitions[write.definition.index]
    if definitions[write.definition.index].value.index != write.value.index || !Atom.same(actual.active, write.active)
      || actual.write != Write.Weak || values[write.value.index].evaluation.index != holder.execution.index
      || !sameTemporary(prefix.temporary, holder.storage.temporary) || !inlineWithin(prepared, prefix.endpoint, holder.storage.endpoint) {
      CompilerBug.panic(b"summary write changed its actual holder, point or weak update")
    }
    at = at + usize.ONE
  }
  return ()
}

fn validateRetainedWrites<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let operations = List<Stores.Operation>.asSlice(&skeleton.stores.operations)
  let addresses = List<RetainedAddress>.asSlice(&skeleton.retainedAddresses)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let values = List<Value>.asSlice(&skeleton.values)
  let holders = List<WriteHolder>.asSlice(&skeleton.writeHolders)
  let candidates = List<RetainedWrite>.asSlice(&skeleton.writes)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let rows = List<Prepared.Operation>.asSlice(&prepared.operations)
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = candidates[at]
    if candidate.operation >= operations.length || candidate.address >= addresses.length
      || candidate.source.index >= values.length || candidate.target.index >= values.length || candidate.holder >= holders.length {
      CompilerBug.panic(b"retained write lost an actual operation, value, holder or address")
    }
    let operation = &operations[candidate.operation]
    let address = addresses[candidate.address]
    let inputs = List<Stores.Input>.asSlice(&operation.inputs)
    if address.operation != candidate.operation || candidate.sourceInput >= inputs.length
      || address.input >= inputs.length || address.alias >= aliases.length || address.edge >= edges.length {
      CompilerBug.panic(b"retained write changed its owning input or address contributor")
    }
    let source = &inputs[candidate.sourceInput]
    let destination = &inputs[address.input]
    if candidate.sourceSlot >= List<Stores.Slot>.length(&source.slots)
      || address.slot >= List<Stores.Slot>.length(&destination.slots)
      || address.path >= List<Stores.Path>.length(&List<Stores.Slot>.asSlice(&destination.slots)[address.slot].paths) {
      CompilerBug.panic(b"retained write substituted another original slot or physical path")
    }
    let retained = &List<Prepared.Retention>.asSlice(&prepared.retentions)[operation.retention.index]
    let mut owner = usize.MAX
    let mut row = usize.ZERO
    while row < rows.length {
      if rows[row].site.index == retained.site.index {
        if owner != usize.MAX { CompilerBug.panic(b"retained writer has duplicate originating operations") }
        owner = row
      }
      row = row + usize.ONE
    }
    if owner == usize.MAX || source.route >= List<InputRoute>.length(&rows[owner].inputs) {
      CompilerBug.panic(b"retained write has no originating physical input binding")
    }
    let route = &List<InputRoute>.asSlice(&rows[owner].inputs)[source.route]
    let root = maps[route.map.index].source
    let before = values[candidate.source.index]
    let after = values[candidate.target.index]
    let holder = &holders[candidate.holder]
    let execution = Skeleton.evaluation(skeleton, holder.execution)
    let actual = Skeleton.evaluation(skeleton, operation.evaluation)
    let sameSite = match execution.site { EvaluationSite.Node {node} => match actual.site {
      EvaluationSite.Node {node: other} => node.index == other.index _ => false } _ => false }
    if before.evaluation.index != source.actual.evaluation.index || before.phase != ValuePhase.Output
      || !inlineWithin(prepared, before.endpoint, root) || !sameSite || execution.category != EvaluationRole.Execute
      || execution.point.index != operation.execute.index || after.evaluation.index != holder.execution.index
      || edges[address.edge].target != address.alias
      || !sameStorage(aliases[address.alias].storage, address.storage)
      || !sameTemporary(holder.storage.temporary, address.storage.temporary)
      || !inlineWithin(prepared, address.storage.endpoint, holder.storage.endpoint) {
      CompilerBug.panic(b"retained write changed source occurrence or canonical execution placement")
    }
    let mut found = false
    match candidate.summary {
      Option<usize>.None => {
        let components = List<WriteComponent>.asSlice(&holder.components)
        row = usize.ZERO
        while row < components.length {
          if components[row].value.index == candidate.target.index && sameStorage(components[row].storage, address.storage) { found = true }
          row = row + usize.ONE
        }
        if after.endpoint.index != address.storage.endpoint.index { CompilerBug.panic(b"exact retained write changed its destination component") }
        if let Option<usize>.Some {..} = after.summary { CompilerBug.panic(b"exact retained write acquired summary placement") }
      }
      Option<usize>.Some {value: summary} => {
        let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
        if summary >= summaries.length { CompilerBug.panic(b"retained write has no canonical summary") }
        let prefix = summaries[summary].prefix
        let exact = match after.summary { Option<usize>.Some {value} => value == summary _ => false }
        if !exact || !sameTemporary(prefix.temporary, address.storage.temporary)
          || after.endpoint.index != prefix.endpoint.index || !inlineWithin(prepared, address.storage.endpoint, prefix.endpoint)
          || !inlineWithin(prepared, prefix.endpoint, holder.storage.endpoint) {
          CompilerBug.panic(b"summary write has no exact ancestor of its proven destination")
        }
        let written = List<SummaryWrite>.asSlice(&skeleton.summaryWrites)
        row = usize.ZERO
        while row < written.length {
          if written[row].summary == summary && written[row].holder == candidate.holder
            && written[row].value.index == candidate.target.index { found = true }
          row = row + usize.ONE
        }
      }
    }
    if !found { CompilerBug.panic(b"retained write has no coalesced holder definition") }
    at = at + usize.ONE
  }
  return ()
}

// Actual inline ownership only. Referent/channel/opaque boundaries never become holder
// fields, even if a deeper endpoint was reserved for a later selector.
fn inlineWithin<'body>(prepared: &SourcePreparation<'body>, endpoint: EndpointId, root: EndpointId) -> bool {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let mut current = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index == root.index { return true }
    if current.index >= endpoints.length { return CompilerBug.panic(b"inline owner has an absent component") }
    let parent = match endpoints[current.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    let components = List<Prepared.Component>.asSlice(&shapes[endpoints[parent.index].shape.index].components)
    let mut owned = false
    let mut at = usize.ZERO
    while at < components.length {
      if sameSelector(&components[at].selector, &endpoints[current.index].selector) { owned = components[at].inline }
      at = at + usize.ONE
    }
    if !owned { return false }
    current = parent
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"inline owner component ancestry is cyclic")
}
fn validateOrdinarySummaries<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let rows = List<OrdinarySummaryWrite>.asSlice(&skeleton.ordinarySummaries)
  let definitions = List<DefinedValue>.asSlice(&skeleton.definitions)
  let flow = Flow.reservedDefinitions(&skeleton.flow)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let values = List<Value>.asSlice(&skeleton.values)
  let storage = List<Storage>.asSlice(&skeleton.storage)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = rows[at]
    if row.original.index >= definitions.length || row.definition.index >= definitions.length
      || row.summary >= summaries.length || row.source.index >= values.length || row.target.index >= values.length {
      CompilerBug.panic(b"ordinary summary has absent original write coordinates")
    }
    let original = definitions[row.original.index]
    let actual = flow[row.original.index]
    let held = definitions[row.definition.index]
    let summary = summaries[row.summary]
    if summary.disposition == SummaryDisposition.Shadowed { CompilerBug.panic(b"ordinary copied definition retained a shadowed tag") }
    let writer = match original.writer { Option<EvalId>.Some {value} => value.index == row.writer.index _ => false }
    let target = match held.summary { Option<usize>.Some {value} => value == row.summary _ => false }
      && match values[row.target.index].summary { Option<usize>.Some {value} => value == row.summary _ => false }
    let heldWriter = match held.writer { Option<EvalId>.Some {value} => value.index == row.writer.index _ => false }
    let physical = match original.summary { Option<usize>.None => true _ => false }
    let category = match values[row.source.index].writeHolder { Option<usize>.None => true _ => false }
    if !writer || !heldWriter || !target || !physical || !category || original.value.index != row.source.index
      || values[row.target.index].evaluation.index != row.writer.index || values[row.target.index].phase != ValuePhase.Output
      || values[row.target.index].endpoint.index != summary.prefix.endpoint.index
      || held.value.index != row.target.index || !sameStorage(storage[actual.component.index], row.storage)
      || !Atom.same(row.originalActive, actual.active) || flow[row.definition.index].point.index != actual.point.index
      || !Atom.same(flow[row.definition.index].active, row.admitted) || flow[row.definition.index].write != Write.Weak
      || !sameTemporary(summary.prefix.temporary, row.storage.temporary)
      || !(inlineWithin(prepared, row.storage.endpoint, summary.prefix.endpoint)
        || inlineWithin(prepared, summary.prefix.endpoint, row.storage.endpoint))
      || storageOwner(prepared, row.storage.endpoint).index != storageOwner(prepared, summary.prefix.endpoint).index {
      CompilerBug.panic(b"ordinary summary changed its real writer, canonical placement or lifetime")
    }
    if unknownOwnership(summary.placement) && summary.prefix.endpoint.index != storageOwner(prepared, row.storage.endpoint).index {
      CompilerBug.panic(b"unknown ordinary summary was narrowed to a physical field")
    }
    if let OwnershipPlacement.Position {..} = summary.placement {
      let constructed = match ownershipPositionBefore(skeleton, summary.placement, row.writer, false) { Option<bool>.Some {value} => value _ => false }
      if !constructed { CompilerBug.panic(b"ordinary summary retroactively constructed a later ownership position") }
    }
    let mut before = usize.ZERO
    while before < at {
      if rows[before].original.index == row.original.index && rows[before].summary == row.summary {
        CompilerBug.panic(b"ordinary summary duplicated one actual write alternative")
      }
      if rows[before].writer.index == row.writer.index && rows[before].summary == row.summary
        && (rows[before].definition.index != row.definition.index || !Atom.same(rows[before].admitted, row.admitted)) {
        CompilerBug.panic(b"one ordinary write split its whole summary into independent holdings")
      }
      before = before + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn storageOwner<'body>(prepared: &SourcePreparation<'body>, endpoint: EndpointId) -> EndpointId {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut root = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    let parent = match endpoints[root.index].parent { Option<EndpointId>.Some {value} => value _ => { return root } }
    if !inlineWithin(prepared, root, parent) { return root }
    root = parent
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"retained holder ancestry is cyclic")
}

fn componentWithin(endpoints: &[Endpoint], candidate: EndpointId, root: EndpointId) -> bool {
  let mut current = candidate
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index == root.index { return true }
    if current.index >= endpoints.length { CompilerBug.panic(b"storage component is absent") }
    match endpoints[current.index].parent {
      Option<EndpointId>.Some {value} => { current = value }
      Option<EndpointId>.None => { return false }
    }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"storage component ancestry is cyclic")
}

fn endpointRole(endpoint: &Endpoint) -> Option<EndpointRole> {
  return match &endpoint.root {
    Root.Local {category, ..} => Option<EndpointRole>.some(category)
    Root.Node {category, ..} => Option<EndpointRole>.some(category)
    _ => Option<EndpointRole>.none()
  }
}

fn validateReferenceMaps(endpoints: &[Endpoint], maps: &[SelectionMap], descriptor: MapId, referent: MapId) -> () {
  if descriptor.index >= maps.length || referent.index >= maps.length {
    CompilerBug.panic(b"producer-created reference has an absent map")
  }
  let created = &maps[descriptor.index]
  let carried = &maps[referent.index]
  if created.source.index >= endpoints.length || created.target.index >= endpoints.length
    || carried.source.index >= endpoints.length || carried.target.index >= endpoints.length {
    CompilerBug.panic(b"producer-created reference has an absent endpoint")
  }
  if created.site.index != carried.site.index || List<MapId>.length(&created.children) != usize.ZERO {
    CompilerBug.panic(b"reference creation and its referent are not one producer operation")
  }
  let storage = match move endpointRole(&endpoints[created.source.index]) {
    Option<EndpointRole>.Some {value} => value == EndpointRole.Storage
    _ => false
  }
  let value = match move endpointRole(&endpoints[carried.source.index]) {
    Option<EndpointRole>.Some {value} => value == EndpointRole.Value
    _ => false
  }
  let paired = match &endpoints[carried.target.index].parent {
    Option<EndpointId>.Some {value: parent} => parent.index == created.target.index
    _ => false
  }
  let through = match &endpoints[carried.target.index].selector { Selector.Referent => true _ => false }
  if !storage || !value || !paired || !through
    || !sameSourceComponent(endpoints, created.source, carried.source) {
    CompilerBug.panic(b"reference map must create a descriptor and separately carry its referent")
  }
  return ()
}

// Storage and Value roots for the same authored component differ in role, never in source
// identity. This validates the supplied pair; it does not search for or construct a map.
fn sameSourceComponent(endpoints: &[Endpoint], storage: EndpointId, value: EndpointId) -> bool {
  let mut left = storage
  let mut right = value
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if left.index >= endpoints.length || right.index >= endpoints.length { return false }
    let a = &endpoints[left.index]
    let b = &endpoints[right.index]
    if !sameSelector(&a.selector, &b.selector) { return false }
    match &a.parent {
      Option<EndpointId>.Some {value: parent} => {
        if let Option<EndpointId>.Some {value: other} = &b.parent {
          left = parent
          right = other
        } else { return false }
      }
      Option<EndpointId>.None => {
        if let Option<EndpointId>.Some {..} = &b.parent { return false }
        return match &a.root {
          Root.Node {node, ..} => match &b.root {
            Root.Node {node: other, ..} => node.index == other.index
            _ => false
          }
          Root.Local {local, ..} => match &b.root {
            Root.Local {local: other, ..} => local.index == other.index
            _ => false
          }
          _ => false
        }
      }
    }
    remaining = remaining - usize.ONE
  }
  CompilerBug.panic(b"prepared component ancestry is cyclic")
}

pub fn sameSelector(left: &Selector, right: &Selector) -> bool {
  return match &left.* {
    Selector.Member {declaration, member, payload} => match &right.* {
      Selector.Member {declaration: other, member: selected, payload: field} =>
        DeclarationId.equals(&DeclarationId.copyShared(&declaration), &DeclarationId.copyShared(&other))
          && member == selected && payload == field
      _ => false
    }
    Selector.Field {ordinal} => match &right.* { Selector.Field {ordinal: other} => ordinal == other _ => false }
    Selector.Variant {ordinal} => match &right.* { Selector.Variant {ordinal: other} => ordinal == other _ => false }
    Selector.Index {class: IndexClass.Exact {index}} => match &right.* {
      Selector.Index {class: IndexClass.Exact {index: other}} => index == other
      _ => false
    }
    Selector.Index {class: IndexClass.Remainder} => match &right.* { Selector.Index {class: IndexClass.Remainder} => true _ => false }
    Selector.Referent => match &right.* { Selector.Referent => true _ => false }
    Selector.CallableResult => match &right.* { Selector.CallableResult => true _ => false }
    Selector.EffectSuccess => match &right.* { Selector.EffectSuccess => true _ => false }
    Selector.EffectFailure => match &right.* { Selector.EffectFailure => true _ => false }
    Selector.Identity => match &right.* { Selector.Identity => true _ => false }
    Selector.Opaque => match &right.* { Selector.Opaque => true _ => false }
  }
}

fn findCell(keys: &[CellKey], value: ValueId, leaf: LeafId, witness: usize, direct: bool, category: SourceRole) -> usize {
  let mut at = usize.ZERO
  while at < keys.length {
    let key = keys[at]
    if key.value.index == value.index && key.leaf.index == leaf.index && key.witness == witness && key.direct == direct && key.category == category { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// Complete physical storage transfers are created from the same relation used by ownership
/// projection. No creation-order source classifier or historical loan list participates here.
/// The definition/read numbers index explicit records, not inferred source ordering.
fn definitionView(reaching: &Reaching, storage: &[Storage], recorded: &[DefinedValue], id: DefinitionId) -> DefinitionView {
  let definitions = List<Definition>.asSlice(&reaching.definitions)
  if id.index >= definitions.length || id.index >= recorded.length || recorded[id.index].definition.index != id.index {
    return CompilerBug.panic(b"source definition projection lost its original flow identity")
  }
  let actual = definitions[id.index]
  if actual.component.index >= storage.length { return CompilerBug.panic(b"source definition has no canonical storage") }
  return DefinitionView {summary: recorded[id.index].summary, clears: recorded[id.index].clears, id: id, point: actual.point, storage: storage[actual.component.index],
    value: recorded[id.index].value, writer: recorded[id.index].writer, active: actual.active, write: actual.write}
}

fn readView(reads: &[Read], storage: &[Storage], recorded: &[ReadValue], id: ReadId) -> ReadView {
  if id.index >= reads.length || id.index >= recorded.length || recorded[id.index].read.index != id.index {
    return CompilerBug.panic(b"source read projection lost its original flow identity")
  }
  let actual = reads[id.index]
  if actual.component.index >= storage.length || !sameStorage(storage[actual.component.index], recorded[id.index].storage) {
    return CompilerBug.panic(b"source read projection substituted another canonical storage")
  }
  return ReadView {summary: recorded[id.index].summary, id: id, point: actual.point, storage: recorded[id.index].storage,
    value: recorded[id.index].value, map: recorded[id.index].map}
}

effect fn readPlacements<'body>(prepared: &SourcePreparation<'body>, flowReads: &[Read], points: &[Point],
  storage: &[Storage], reads: &[ReadValue], values: &[Value], evaluations: &[Evaluation],
  aliases: &[StorageAlias], requests: &[AliasTransport], recorded: &[AliasRead], summaryReads: &[SummaryRead],
  value: ValueId, read: ReadId) -> List<ReadPlacement> ! OutOfMemoryError ? &mut Allocator {
  if value.index >= values.length { return CompilerBug.panic(b"read attribution names an absent input") }
  let input = values[value.index]
  if input.phase != ValuePhase.Input { return CompilerBug.panic(b"read attribution requires the actual pre-publication input") }
  if let Option<ResidualSubject>.Some {..} = input.subject {
    return CompilerBug.panic(b"selected residual read needs its explicit selected placement authority")
  }
  let actual = readView(flowReads, storage, reads, read)
  if let Option<usize>.Some {value: summary} = actual.summary {
    let mut at = usize.ZERO
    while at < summaryReads.length {
      let selected = summaryReads[at]
      if selected.read.index == read.index {
        if selected.summary != summary || selected.original.index >= reads.length {
          return CompilerBug.panic(b"summary attribution lost its exact original read")
        }
        if let Option<usize>.Some {..} = reads[selected.original.index].summary {
          return CompilerBug.panic(b"summary attribution cannot recurse through another summary")
        }
        let mut rows = run readPlacements(prepared, flowReads, points, storage, reads, values, evaluations,
          aliases, requests, recorded, summaryReads, value, selected.original)
        let entries = List<ReadPlacement>.asMutSlice(&mut rows)
        let mut each = usize.ZERO
        while each < entries.length {
          entries[each].read = read
          entries[each].summary = Option<usize>.some(summary)
          each = each + usize.ONE
        }
        return move rows
      }
      at = at + usize.ONE
    }
    return CompilerBug.panic(b"summary read has no original consumer record")
  }
  let mut result = List<ReadPlacement>.make()
  if evaluations[input.evaluation.index].point.index != actual.point.index { return move result }
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  if reads[read.index].value.index == value.index {
    if let Option<MapId>.Some {value: map} = actual.map {
      if map.index >= maps.length || maps[map.index].kind != MapKind.Copy
        || maps[map.index].source.index != actual.storage.endpoint.index
        || maps[map.index].target.index != input.endpoint.index {
        return CompilerBug.panic(b"local read lost its exact canonical component mapping")
      }
      run List<ReadPlacement>.append(&mut result, ReadPlacement {summary: Option<usize>.none(), original: read, consumer: value, read: read, storage: actual.storage,
        map: map, operand: input.evaluation, result: input.evaluation, alias: Option<usize>.none(),
        active: points[actual.point.index].reachable})
    }
  }
  let mut at = usize.ZERO
  while at < recorded.length {
    if recorded[at].read.index == read.index {
      if recorded[at].request >= requests.length { CompilerBug.panic(b"canonical read lost its actual address use") }
      let request = requests[recorded[at].request]
      if let AliasConsumer.Projection {map: selected} = request.authority {
        if request.alias >= aliases.length || selected.index >= maps.length {
          CompilerBug.panic(b"canonical read lost its selected address or consumer map")
        }
        let alias = &aliases[request.alias]
        let map = &maps[selected.index]
        if request.direction != MapDirection.Forward || map.kind != MapKind.Copy
          || map.source.index != alias.endpoint.index || !sameStorage(alias.storage, actual.storage) {
          CompilerBug.panic(b"read attribution substituted another canonical source or selection")
        }
        let exact = match request.consumer { Option<ValueId>.Some {value: matchedConsumer} => matchedConsumer.index == value.index _ => false }
        if exact && request.evaluation.index == input.evaluation.index && map.target.index == input.endpoint.index {
          run List<ReadPlacement>.append(&mut result, ReadPlacement {summary: Option<usize>.none(), original: read, consumer: value, read: read, storage: alias.storage,
            map: selected, operand: alias.evaluation, result: request.evaluation,
            alias: Option<usize>.some(request.alias), active: request.active})
        }
      }
    }
    at = at + usize.ONE
  }
  return move result
}

// Enumerate only consumers actually recorded by the read emitter. A copied operand may
// retain this ReadId long after the original read, so its present endpoint/evaluation must
// never be used to recover the earlier selected place.
effect fn readPlacementsByRead<'body>(prepared: &SourcePreparation<'body>, flowReads: &[Read], points: &[Point],
  storage: &[Storage], reads: &[ReadValue], values: &[Value], evaluations: &[Evaluation],
  aliases: &[StorageAlias], requests: &[AliasTransport], recorded: &[AliasRead], summaryReads: &[SummaryRead],
  read: ReadId) -> List<ReadPlacement> ! OutOfMemoryError ? &mut Allocator {
  let actual = readView(flowReads, storage, reads, read)
  if let Option<usize>.Some {value: summary} = actual.summary {
    let mut at = usize.ZERO
    while at < summaryReads.length {
      let selected = summaryReads[at]
      if selected.read.index == read.index {
        if selected.summary != summary || selected.original.index >= reads.length {
          return CompilerBug.panic(b"summary consumer lost its original read identity")
        }
        if let Option<usize>.Some {..} = reads[selected.original.index].summary {
          return CompilerBug.panic(b"summary consumer cannot recurse through another summary")
        }
        let mut rows = run readPlacementsByRead(prepared, flowReads, points, storage, reads, values, evaluations,
          aliases, requests, recorded, summaryReads, selected.original)
        let entries = List<ReadPlacement>.asMutSlice(&mut rows)
        let mut each = usize.ZERO
        while each < entries.length {
          entries[each].read = read
          entries[each].summary = Option<usize>.some(summary)
          each = each + usize.ONE
        }
        return move rows
      }
      at = at + usize.ONE
    }
    return CompilerBug.panic(b"summary read has no actual original consumer")
  }
  let mut consumers = List<ValueId>.make()
  if let Option<MapId>.Some {..} = actual.map {
    run List<ValueId>.append(&mut consumers, actual.value)
  }
  let mut at = usize.ZERO
  while at < recorded.length {
    if recorded[at].read.index == read.index {
      if recorded[at].request >= requests.length { CompilerBug.panic(b"read consumer lost its actual transport") }
      let request = requests[recorded[at].request]
      let consumer = match request.consumer {
        Option<ValueId>.Some {value} => value
        _ => { return CompilerBug.panic(b"an emitted read omitted its original consumer") }
      }
      if consumer.index >= values.length { CompilerBug.panic(b"read consumer has no reserved value") }
      let value = values[consumer.index]
      if value.evaluation.index != request.evaluation.index || request.direction != MapDirection.Forward {
        CompilerBug.panic(b"read consumer changed its actual occurrence or direction")
      }
      // Only actual Input observations have an attribution certificate. A handler that
      // did not request such a read retains explicit missing coverage in its consumer.
      if value.phase == ValuePhase.Input {
        let old = List<ValueId>.asSlice(&consumers)
        let mut found = false
        let mut each = usize.ZERO
        while each < old.length { if old[each].index == consumer.index { found = true } each = each + usize.ONE }
        if !found { run List<ValueId>.append(&mut consumers, consumer) }
      }
    }
    at = at + usize.ONE
  }
  let mut result = List<ReadPlacement>.make()
  let selected = List<ValueId>.asSlice(&consumers)
  at = usize.ZERO
  while at < selected.length {
    let rows = run readPlacements(prepared, flowReads, points, storage, reads, values, evaluations,
      aliases, requests, recorded, summaryReads, selected[at], read)
    let rowsSelected = List<ReadPlacement>.asSlice(&rows)
    let mut each = usize.ZERO
    while each < rowsSelected.length { run List<ReadPlacement>.append(&mut result, rowsSelected[each]) each = each + usize.ONE }
    at = at + usize.ONE
  }
  return move result
}

fn validateStorage(maps: &[SelectionMap], reaching: &Reaching, storage: &[Storage],
  stored: &[DefinedValue], readValues: &[ReadValue], values: &[Value], evaluations: &[Evaluation]) -> () {
  let definitions = List<Definition>.asSlice(&reaching.definitions)
  let reads = List<Read>.asSlice(&reaching.reads)
  if stored.length != definitions.length || readValues.length != reads.length {
    CompilerBug.panic(b"source storage reservation omitted a definition or read value")
  }
  let mut at = usize.ZERO
  while at < stored.length {
    let actual = stored[at]
    if actual.definition.index != at || actual.value.index >= values.length {
      CompilerBug.panic(b"source storage definition identity is invalid")
    }
    let value = values[actual.value.index]
    if value.evaluation.index >= evaluations.length || definitions[at].component.index >= storage.length || value.endpoint.index != storage[definitions[at].component.index].endpoint.index {
      CompilerBug.panic(b"source storage definition value has a different component")
    }
    if evaluations[value.evaluation.index].point.index != definitions[at].point.index {
      CompilerBug.panic(b"source storage definition value has a different evaluation point")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < readValues.length {
    let actual = readValues[at]
    if actual.read.index != at || actual.value.index >= values.length {
      CompilerBug.panic(b"source storage read identity is invalid")
    }
    let value = values[actual.value.index]
    if value.evaluation.index >= evaluations.length { CompilerBug.panic(b"source storage read has no evaluation") }
    if value.phase != ValuePhase.Input { CompilerBug.panic(b"reaching sources must enter a read before its publication") }
    if reads[at].component.index >= storage.length || !sameStorage(actual.storage, storage[reads[at].component.index]) {
      CompilerBug.panic(b"source storage read substituted another canonical owner occurrence")
    }
    match actual.map {
      Option<MapId>.Some {value: selected} => {
        if selected.index >= maps.length { CompilerBug.panic(b"source storage read has no prepared map") }
        let map = &maps[selected.index]
        if reads[at].component.index >= storage.length || map.source.index != storage[reads[at].component.index].endpoint.index || map.target.index != value.endpoint.index {
          CompilerBug.panic(b"source storage read map does not name its actual endpoints")
        }
      }
      Option<MapId>.None => {
        if reads[at].component.index >= storage.length || storage[reads[at].component.index].endpoint.index != value.endpoint.index {
          CompilerBug.panic(b"an identity storage read changed its physical component")
        }
      }
    }
    if evaluations[value.evaluation.index].point.index != reads[at].point.index {
      CompilerBug.panic(b"source storage read value has a different evaluation point")
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn storageTransfers(pairs: &[Pair], first: usize, stored: &[DefinedValue], readValues: &[ReadValue],
  transfers: &mut List<Transfer>, rules: &mut Program) -> () ! OutOfMemoryError ? &mut Allocator {
  // Copying a descriptor adds no loss itself. Loss already present at the definition travels
  // along the value path; observation of a later loan-wide loss does not rewrite this copy.
  let noLoss = Program.atom(&mut rules.*)
  let mut at = first
  while at < pairs.length {
    let pair = pairs[at]
    if pair.definition.index >= stored.length || pair.read.index >= readValues.length {
      CompilerBug.panic(b"source pair lacks its actual stored/read value")
    }
    let source = stored[pair.definition.index]
    let target = readValues[pair.read.index]
    run List<Transfer>.append(&mut transfers.*, Transfer { source: source.value, target: target.value,
      active: pair.active, directness: Directness.Preserve, stored: noLoss, alternatives: noLoss,
      definition: Option<DefinitionId>.some(pair.definition), read: Option<ReadId>.some(pair.read), policy: TransferPolicy.Physical, terminal: false, authority: readAuthority(target.map)})
    at = at + usize.ONE
  }
  return ()
}

fn validateReplacement<'body>(prepared: &SourcePreparation<'body>, replacement: &Prepared.Replacement) -> () {
  let nodes = prepared.body.nodes
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  if replacement.site.index >= nodes.length || replacement.displaced.index >= maps.length || replacement.installed.index >= maps.length {
    CompilerBug.panic(b"replacement names an absent typed operation or map")
  }
  let arguments = match &nodes[replacement.site.index].kind {
    NodeKind.Expression {form: Expression.StorageCall {operation: storageOperation, arguments, ..}, ..} if storageOperation == StorageOperation.Replace =>
      List<NodeId>.asSlice(&arguments)
    _ => { return CompilerBug.panic(b"replacement maps do not belong to a typed Replace operation") }
  }
  if arguments.length != 2 { CompilerBug.panic(b"replacement maps lost their place/value operands") }
  let read = &maps[replacement.displaced.index]
  let write = &maps[replacement.installed.index]
  if read.source.index >= endpoints.length || read.target.index >= endpoints.length
    || write.source.index >= endpoints.length || write.target.index >= endpoints.length {
    CompilerBug.panic(b"replacement map has an absent physical endpoint")
  }
  let storage = &endpoints[read.source.index]
  let actual = match &storage.root {
    Root.Node {node, category} => node.index == arguments[usize.ZERO].index && category == EndpointRole.Storage
    _ => false
  }
  let whole = match &storage.parent { Option<EndpointId>.None => true _ => false }
  if !actual || !whole || read.source.index != write.target.index
    || read.kind != MapKind.Copy || write.kind != MapKind.Place
    || read.site.index != replacement.site.index || write.site.index != replacement.site.index
    || !nodeValueEndpoint(&endpoints[read.target.index], replacement.site)
    || !nodeValueEndpoint(&endpoints[write.source.index], arguments[usize.ONE]) {
    CompilerBug.panic(b"replacement maps changed their exact displaced/installed correspondence")
  }
  return ()
}

// Typed conversion is the only authority for Reference<Array> -> Slice. The root is
// descriptor transport, not a general same-shape component map or another borrow.
fn validateArraySlice<'body>(prepared: &SourcePreparation<'body>, conversion: &Prepared.ArraySlice) -> () {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  if conversion.site.index >= prepared.body.nodes.length || conversion.descriptor.index >= maps.length
    || conversion.referent.index >= maps.length { CompilerBug.panic(b"array slice lost its typed conversion or maps") }
  let descriptor = &maps[conversion.descriptor.index]
  let referent = &maps[conversion.referent.index]
  if descriptor.source.index >= endpoints.length || descriptor.target.index >= endpoints.length || referent.target.index >= endpoints.length {
    CompilerBug.panic(b"array slice has an absent endpoint")
  }
  let mut count = usize.ZERO
  match &prepared.body.nodes[conversion.site.index].kind {
    NodeKind.Expression {form: Expression.ArraySlice {value, count: extent}, ..} => {
      if !nodeValueEndpoint(&endpoints[descriptor.source.index], value) {
        CompilerBug.panic(b"array slice does not transport its actual operand")
      }
      count = extent
    }
    _ => { CompilerBug.panic(b"array slice record is not a typed conversion") }
  }
  if !nodeValueEndpoint(&endpoints[descriptor.target.index], conversion.site)
    || descriptor.kind != MapKind.Copy || descriptor.componentTransport || descriptor.addressTransport
    || descriptor.site.index != conversion.site.index || List<MapId>.length(&descriptor.children) != usize.ZERO
    || List<Prepared.BoundaryTransitionId>.length(&descriptor.boundaries) != usize.ZERO
    || !sameSelector(&descriptor.selector, &Selector.Identity)
    || referent.site.index != conversion.site.index || referent.kind != MapKind.Select
    || referent.source.index != descriptor.source.index || !sameSelector(&referent.selector, &Selector.Referent) {
    CompilerBug.panic(b"array slice descriptor acquired fabricated component or address authority")
  }
  let array = &endpoints[referent.target.index]
  let child = match array.parent { Option<EndpointId>.Some {value} => value.index == descriptor.source.index _ => false }
  if !child || !sameSelector(&array.selector, &Selector.Referent) || array.shape.index >= shapes.length {
    CompilerBug.panic(b"array slice lost its exact borrowed-array referent")
  }
  match &shapes[array.shape.index].state {
    PreparedShapeState.Array {length} => {
      if length != count { CompilerBug.panic(b"array slice changed its reaching extent") }
    }
    _ => { CompilerBug.panic(b"array slice referent is not an array") }
  }
  let parts = List<Prepared.Component>.asSlice(&shapes[array.shape.index].components)
  let elements = List<Prepared.ArraySliceElement>.asSlice(&conversion.elements)
  if elements.length != parts.length || (count == usize.ZERO && elements.length != usize.ZERO)
    || (count != usize.ZERO && elements.length == usize.ZERO) {
    CompilerBug.panic(b"array slice omitted or invented an element partition")
  }
  let selections = List<Selection>.asSlice(&prepared.selections)
  let mut at = usize.ZERO
  while at < elements.length {
    let element = &elements[at]
    if element.source.index >= maps.length || element.target.index >= maps.length || element.value.index >= maps.length
      || element.selection.index >= selections.length { CompilerBug.panic(b"array slice element lost its paired route") }
    let source = &maps[element.source.index]
    let target = &maps[element.target.index]
    let value = &maps[element.value.index]
    if source.target.index >= endpoints.length || target.target.index >= endpoints.length {
      CompilerBug.panic(b"array slice element names an absent selected component")
    }
    if source.site.index != conversion.site.index || target.site.index != conversion.site.index || value.site.index != conversion.site.index
      || source.kind != MapKind.Select || target.kind != MapKind.Select || value.kind != MapKind.Copy
      || source.source.index != referent.target.index || target.source.index != descriptor.target.index
      || value.source.index != source.target.index || value.target.index != target.target.index
      || !sameSelector(&source.selector, &parts[at].selector)
      || !sameSelector(&target.selector, &Selector.Index {class: IndexClass.Remainder}) {
      CompilerBug.panic(b"array slice cross-paired its source partition and target selection")
    }
    let sourceChild = match endpoints[source.target.index].parent { Option<EndpointId>.Some {value: matchedSourceParent} => matchedSourceParent.index == source.source.index _ => false }
    let targetChild = match endpoints[target.target.index].parent { Option<EndpointId>.Some {value: matchedTargetParent} => matchedTargetParent.index == target.source.index _ => false }
    if !sourceChild || !targetChild || !sameSelector(&endpoints[source.target.index].selector, &source.selector)
      || !sameSelector(&endpoints[target.target.index].selector, &target.selector) {
      CompilerBug.panic(b"array slice element selector has a different physical parent")
    }
    let selection = &selections[element.selection.index]
    if selection.root.index != descriptor.source.index { CompilerBug.panic(b"array slice history is not rooted at its actual descriptor") }
    let listed = List<MapId>.asSlice(&selection.maps)
    let mut refCount = usize.ZERO
    let mut partCount = usize.ZERO
    let mut each = usize.ZERO
    while each < listed.length {
      if listed[each].index == conversion.referent.index { refCount = refCount + usize.ONE }
      if listed[each].index == element.source.index { partCount = partCount + usize.ONE }
      each = each + usize.ONE
    }
    if refCount != usize.ONE || partCount != usize.ONE { CompilerBug.panic(b"array slice source history lost its exact two boundary edges") }
    let accepted = List<EndpointId>.asSlice(&selection.accepts)
    each = usize.ZERO
    while each < accepted.length {
      if !componentWithin(endpoints, accepted[each], source.target) { CompilerBug.panic(b"array slice source history accepts another partition") }
      each = each + usize.ONE
    }
    if accepted.length == usize.ZERO { CompilerBug.panic(b"array slice source history has no explicit component frontier") }
    at = at + usize.ONE
  }
  return ()
}

/// Missing supported routes are internal construction failures even when their inputs happen
/// to be absent in this solution. Validate before source closure, never by selected outcomes.
fn validateAuthoredBorrow<'body>(preparation: &SourcePreparation<'body>, borrowed: &Prepared.Borrow) -> () {
  let nodes = preparation.body.nodes
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  if borrowed.site.index >= nodes.length { CompilerBug.panic(b"prepared borrow has no actual node") }
  let operand = match &nodes[borrowed.site.index].kind {
    NodeKind.Expression {form: Expression.Borrow {value, ..}, ..} => value
    _ => { return CompilerBug.panic(b"prepared authored borrow is not a typed Borrow node") }
  }
  validateReferenceMaps(endpoints, maps, borrowed.map, borrowed.referent)
  let descriptor = &maps[borrowed.map.index]
  if descriptor.site.index != borrowed.site.index || !nodeValueEndpoint(&endpoints[descriptor.target.index], borrowed.site) {
    CompilerBug.panic(b"authored borrow map belongs to another descriptor occurrence")
  }
  let actual = match &endpoints[descriptor.source.index].root {
    Root.Node {node, category} => node.index == operand.index && category == EndpointRole.Storage
    _ => false
  }
  let whole = match endpoints[descriptor.source.index].parent { Option<EndpointId>.None => true _ => false }
  if !actual || !whole { CompilerBug.panic(b"authored borrow map does not name its actual operand storage root") }
  return ()
}

// Schema output maps retain an application transform. Their projection contributors can
// normalize several original components to one output, so they are not a physical child family.
fn validateSchemaProducerMap(map: &SelectionMap, application: ApplicationId, site: NodeId,
  source: EndpointId, target: EndpointId) -> () {
  let exact = match map.application { Option<ApplicationId>.Some {value} => value.index == application.index _ => false }
  if !exact || map.site.index != site.index || map.source.index != source.index || map.target.index != target.index
    || map.kind != MapKind.Contract || !sameSelector(&map.selector, &Selector.Identity)
    || map.componentTransport || map.addressTransport || List<MapId>.length(&map.children) != usize.ZERO
    || List<Prepared.BoundaryTransitionId>.length(&map.boundaries) != usize.ZERO
    || List<Prepared.BoundaryStop>.length(&map.channelStops) != usize.ZERO {
    CompilerBug.panic(b"schema producer map changed its exact application correspondence")
  }
  return ()
}

fn validateSchemaProducerFamily<'body>(prepared: &SourcePreparation<'body>, channel: &Prepared.ProducerChannel) -> () {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let selected = List<Prepared.ContractProjectionId>.asSlice(&channel.projections)
  let bridge = &maps[channel.map.index]
  validateSchemaProducerMap(bridge, channel.application, channel.site, channel.source, bridge.target)
  let mut root = usize.ZERO
  let mut each = usize.ZERO
  while each < selected.length {
    if selected[each].index >= projections.length { CompilerBug.panic(b"schema producer names an absent projection") }
    let row = &projections[selected[each].index]
    if row.application.index != channel.application.index || row.stage != PreparedContractProjectionStage.OriginalToReceiver
      || row.original.index >= endpoints.length || row.output.index >= endpoints.length {
      CompilerBug.panic(b"schema producer changed its original projection application or stage")
    }
    let original = match &endpoints[row.original.index].root {
      Root.Application {application, port, ordinal, space} => application.index == channel.application.index
        && port == channel.channel && ordinal == usize.ZERO && space == PreparedTypeSpace.Original
      _ => false
    }
    if !original || !componentWithin(endpoints, row.original, channel.source)
      || !nodeValueEndpoint(&endpoints[row.output.index], channel.site)
      || !componentWithin(endpoints, row.output, bridge.target) {
      CompilerBug.panic(b"schema producer projection left its exact original or output subtree")
    }
    let mut previous = usize.ZERO
    while previous < each {
      if selected[previous].index == selected[each].index { CompilerBug.panic(b"schema producer duplicated an original contributor") }
      previous = previous + usize.ONE
    }
    // sourceMap appends both maps independently. The bridge and root contributor must
    // agree on their exact endpoints and application, not on their separately reserved IDs.
    if row.original.index == channel.source.index && row.output.index == bridge.target.index { root = root + usize.ONE }
    let links = List<MapId>.asSlice(&row.maps)
    if links.length == usize.ZERO { CompilerBug.panic(b"schema producer contributor has no exact projection map") }
    let mut link = usize.ZERO
    while link < links.length {
      if links[link].index >= maps.length { CompilerBug.panic(b"schema producer contributor names an absent map") }
      validateSchemaProducerMap(&maps[links[link].index], channel.application, channel.site, row.original, row.output)
      link = link + usize.ONE
    }
    each = each + usize.ONE
  }
  if root != usize.ONE { CompilerBug.panic(b"schema producer omitted or duplicated its exact root projection") }
  // Enumerate frozen contributors independently of the retained membership list. In
  // particular, every collapsed-union contributor and exposed descendant must be retained.
  each = usize.ZERO
  while each < projections.length {
    let row = &projections[each]
    if row.application.index == channel.application.index && row.stage == PreparedContractProjectionStage.OriginalToReceiver {
      if row.output.index >= endpoints.length { CompilerBug.panic(b"schema producer projection has an absent output") }
      if componentWithin(endpoints, row.output, bridge.target) {
        let mut matches = usize.ZERO
        let mut member = usize.ZERO
        while member < selected.length {
          if selected[member].index == each { matches = matches + usize.ONE }
          member = member + usize.ONE
        }
        if matches != usize.ONE { CompilerBug.panic(b"schema producer omitted an original normalization contributor") }
      }
    }
    each = each + usize.ONE
  }
  return ()
}

// A producer channel is frozen declaration correspondence, never physical descriptor
// transport. Keep Construction's full application separate from the invocation opening.
effect fn validateProducerChannels<'body>(prepared: &SourcePreparation<'body>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let channels = List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)
  let constructions = List<Prepared.Construction>.asSlice(&prepared.constructions)
  let operations = List<Prepared.Operation>.asSlice(&prepared.operations)
  let applications = List<Prepared.Application>.asSlice(&prepared.applications)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut at = usize.ZERO
  while at < channels.length {
    let channel = &channels[at]
    if channel.site.index >= prepared.body.nodes.length || channel.application.index >= applications.length
      || channel.descriptor.index >= endpoints.length || channel.source.index >= endpoints.length || channel.map.index >= maps.length {
      CompilerBug.panic(b"producer channel has an absent original or actual coordinate")
    }
    let mut construction = usize.ZERO
    let mut operation = usize.ZERO
    let mut each = usize.ZERO
    while each < constructions.length {
      if constructions[each].site.index == channel.site.index && constructions[each].application.index == channel.application.index {
        construction = construction + usize.ONE
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < operations.length {
      if operations[each].site.index == channel.site.index && operations[each].phase == PreparedOperationPhase.PrepareEffect {
        operation = operation + usize.ONE
      }
      each = each + usize.ONE
    }
    let app = &applications[channel.application.index]
    if app.site.index != channel.site.index { CompilerBug.panic(b"producer channel changed its original application site") }
    let literal = match &prepared.body.nodes[channel.site.index].kind {
      NodeKind.Expression {form: Expression.Callable {..}, ..} => true _ => false
    }
    let header = match &app.anonymous { Option<Shared<SourceAnonymousUse>>.Some {..} => true _ => false }
    let schema = !literal && operation == usize.ZERO && match &app.schemaOutput { Option<Shared<OutputTransform>>.Some {..} => true _ => false }
    let mut space = PreparedTypeSpace.Applied
    let mut stage = PreparedContractProjectionStage.OriginalToApplied
    if schema {
      if construction != usize.ONE || header { CompilerBug.panic(b"schema channel lost its exact physical construction") }
      let output = match &app.schemaOutput { Option<Shared<OutputTransform>>.Some {value} => Shared<OutputTransform>.with<bool>(&value,
        fn(value: &OutputTransform) -> bool { return match &value.root { OutputRoot.Success {..} => true _ => false } })
        _ => { return CompilerBug.panic(b"schema channel omitted its retained output transform") } }
      if output != app.constructs { CompilerBug.panic(b"schema channel changed its original result/success root") }
      space = PreparedTypeSpace.Original
      stage = PreparedContractProjectionStage.OriginalToReceiver
    } else if literal {
      let recorded = match &prepared.body.nodes[channel.site.index].kind {
        NodeKind.Expression {form: Expression.Callable {source: Option<Shared<SourceAnonymousUse>>.Some {..}, ..}, ..} => true
        _ => false
      }
      if recorded != header { CompilerBug.panic(b"literal channel lost its raw-to-use application") }
      if header { space = PreparedTypeSpace.Selected stage = PreparedContractProjectionStage.OriginalToSelected }
      else {
        let owner = DeclarationId.copyShared(&app.owner)
        if !app.constructs || DeclarationId.kind(&owner) != OwnerKind.EffectBlock {
          CompilerBug.panic(b"derived literal channel invented a raw callable result")
        }
      }
    } else if construction != usize.ONE || operation != usize.ONE || !app.constructs || header {
      CompilerBug.panic(b"producer channel substituted the invocation opening for its physical construction")
    }
    let mut port = PreparedContractPort.Result
    if app.constructs { port = PreparedContractPort.Success }
    if channel.channel != port { CompilerBug.panic(b"producer channel changed its original output port") }
    let root = &endpoints[channel.descriptor.index]
    if !nodeValueEndpoint(root, channel.site) { CompilerBug.panic(b"producer descriptor belongs to another actual node") }
    if let Option<EndpointId>.Some {..} = root.parent { CompilerBug.panic(b"producer descriptor is not the whole actual root") }
    let source = &endpoints[channel.source.index]
    let original = match &source.root { Root.Application {application, port: actualPort, ordinal, space: actualSpace} =>
      application.index == channel.application.index && actualPort == port && ordinal == usize.ZERO
        && actualSpace == space _ => false }
    if !original { CompilerBug.panic(b"producer channel lost its full applied success contract") }
    if let Option<EndpointId>.Some {..} = source.parent { CompilerBug.panic(b"producer success contract starts at a component") }
    let map = &maps[channel.map.index]
    if map.source.index != channel.source.index || map.target.index >= endpoints.length {
      CompilerBug.panic(b"producer channel changed its exact applied-to-actual endpoints")
    }
    let mut current = map.target
    if app.constructs {
      if !sameSelector(&endpoints[current.index].selector, &Selector.EffectSuccess) {
        CompilerBug.panic(b"producer success lost its actual Effect channel")
      }
      current = match endpoints[current.index].parent { Option<EndpointId>.Some {value} => value
        _ => { return CompilerBug.panic(b"producer success has no actual channel parent") } }
    }
    if header || schema {
      if !sameSelector(&endpoints[current.index].selector, &Selector.CallableResult) {
        CompilerBug.panic(b"anonymous producer lost its exposed callable-result channel")
      }
      current = match endpoints[current.index].parent { Option<EndpointId>.Some {value} => value
        _ => { return CompilerBug.panic(b"anonymous result has no actual descriptor parent") } }
    }
    if current.index != channel.descriptor.index || !nodeValueEndpoint(&endpoints[map.target.index], channel.site) {
      CompilerBug.panic(b"producer output channel changed its exact actual descriptor path")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if channels[earlier].site.index == channel.site.index && channels[earlier].application.index == channel.application.index
        && channels[earlier].channel == channel.channel { CompilerBug.panic(b"producer channel was reserved twice") }
      earlier = earlier + usize.ONE
    }
    if schema {
      validateSchemaProducerFamily(prepared, channel)
      at = at + usize.ONE
      continue
    }
    let family = run transferFamily(endpoints, maps, channel.map)
    let familySelected = List<MapId>.asSlice(&family)
    let selected = List<Prepared.ContractProjectionId>.asSlice(&channel.projections)
    let mut member = usize.ZERO
    while member < familySelected.length {
      let physical = &maps[familySelected[member].index]
      let source = &endpoints[physical.source.index]
      let correct = match &source.root { Root.Application {application, port: actualPort, space: actualSpace, ..} =>
        application.index == channel.application.index && actualPort == port
          && actualSpace == space _ => false }
      if !correct || !nodeValueEndpoint(&endpoints[physical.target.index], channel.site)
        || physical.site.index != channel.site.index || physical.kind != MapKind.Contract
        || physical.componentTransport || physical.addressTransport
        || List<Prepared.BoundaryTransitionId>.length(&physical.boundaries) != usize.ZERO
        || List<Prepared.BoundaryStop>.length(&physical.channelStops) != usize.ZERO {
        CompilerBug.panic(b"producer output family invented physical or foreign authority")
      }
      if let Option<ApplicationId>.Some {..} = physical.application { CompilerBug.panic(b"producer output family replaced its original projection") }
      let mut found = false
      let mut projection = usize.ZERO
      while projection < projections.length {
        let row = &projections[projection]
        if row.application.index == channel.application.index && row.output.index == physical.target.index
          && row.stage == stage {
          let mut matches = usize.ZERO
          each = usize.ZERO
          while each < selected.length { if selected[each].index == projection { matches = matches + usize.ONE } each = each + usize.ONE }
          if matches != usize.ONE { CompilerBug.panic(b"producer channel omitted or duplicated an original normalization contributor") }
          found = true
        }
        projection = projection + usize.ONE
      }
      if !found { CompilerBug.panic(b"producer output component has no original projection") }
      member = member + usize.ONE
    }
    each = usize.ZERO
    while each < selected.length {
      if selected[each].index >= projections.length { CompilerBug.panic(b"producer channel names an absent original projection") }
      let row = &projections[selected[each].index]
      let mut found = false
      member = usize.ZERO
      while member < familySelected.length {
        if maps[familySelected[member].index].target.index == row.output.index { found = true }
        member = member + usize.ONE
      }
      if !found || row.original.index >= endpoints.length || row.application.index != channel.application.index
        || row.stage != stage {
        CompilerBug.panic(b"producer projection left its exact output family or original application")
      }
      let original = match &endpoints[row.original.index].root { Root.Application {application, port: actualPort, space: actualSpace, ..} =>
        application.index == channel.application.index && actualPort == port
          && actualSpace == PreparedTypeSpace.Original _ => false }
      if !original { CompilerBug.panic(b"producer projection lost its original success subject") }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < operations.length {
    if operations[at].phase == PreparedOperationPhase.PrepareEffect {
      let mut found = usize.ZERO
      let mut channel = usize.ZERO
      while channel < channels.length {
        if channels[channel].site.index == operations[at].site.index { found = found + usize.ONE }
        channel = channel + usize.ONE
      }
      if found != usize.ONE { CompilerBug.panic(b"Effect preparation omitted its original producer success authority") }
    }
    at = at + usize.ONE
  }
  return ()
}

// Prepared operations name physical transfer families explicitly. In particular, preparing an
// Effect references Construction's placement; it is not a second execution of that placement.
// Validate before reservation, even for a currently unreachable operation. A malformed package
// is a compiler construction defect, not source uncertainty that can become a successful gap.
effect fn validatePreparedOperations<'body>(preparation: &SourcePreparation<'body>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let constructions = List<Prepared.Construction>.asSlice(&preparation.constructions)
  let operations = List<Prepared.Operation>.asSlice(&preparation.operations)
  let applications = List<Prepared.Application>.asSlice(&preparation.applications)
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  let borrows = List<Prepared.Borrow>.asSlice(&preparation.borrows)
  let replacements = List<Prepared.Replacement>.asSlice(&preparation.replacements)
  let mut at = usize.ZERO
  let conversions = List<Prepared.ArraySlice>.asSlice(&preparation.arraySlices)
  while at < conversions.length {
    validateArraySlice(preparation, &conversions[at])
    let elements = List<Prepared.ArraySliceElement>.asSlice(&conversions[at].elements)
    let mut each = usize.ZERO
    while each < elements.length {
      drop run transferFamily(endpoints, maps, elements[each].value)
      each = each + usize.ONE
    }
    let mut prior = usize.ZERO
    while prior < at {
      if conversions[prior].site.index == conversions[at].site.index { CompilerBug.panic(b"typed array slice has duplicate conversion records") }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < replacements.length {
    validateReplacement(preparation, &replacements[at])
    drop run transferFamily(endpoints, maps, replacements[at].displaced)
    drop run transferFamily(endpoints, maps, replacements[at].installed)
    let mut prior = usize.ZERO
    while prior < at {
      if replacements[prior].site.index == replacements[at].site.index { CompilerBug.panic(b"typed replacement has duplicate physical records") }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < borrows.length {
    validateAuthoredBorrow(preparation, &borrows[at])
    drop run transferFamily(endpoints, maps, borrows[at].referent)
    let mut earlier = usize.ZERO
    while earlier < at {
      if borrows[earlier].site.index == borrows[at].site.index { CompilerBug.panic(b"authored borrow has duplicate physical records") }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < preparation.body.nodes.length {
    if let NodeKind.Expression {form: Expression.Borrow {..}, ..} = &preparation.body.nodes[at].kind {
      let mut found = false
      let mut each = usize.ZERO
      while each < borrows.length {
        found = found || borrows[each].site.index == at
        each = each + usize.ONE
      }
      if !found { CompilerBug.panic(b"typed Borrow is missing its prepared physical map pair") }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constructions.length {
    let construction = &constructions[at]
    if construction.site.index >= preparation.body.nodes.length || construction.application.index >= applications.length {
      CompilerBug.panic(b"source construction has no actual site or representation application")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if constructions[earlier].site.index == construction.site.index {
        CompilerBug.panic(b"one physical construction has duplicate preparation records")
      }
      earlier = earlier + usize.ONE
    }
    let inputs = List<InputRoute>.asSlice(&construction.inputs)
    let mut input = usize.ZERO
    while input < inputs.length {
      run validatePreparedInput(preparation, construction.site, &inputs[input])
      let target = maps[inputs[input].map.index].target
      if !nodeValueEndpoint(&endpoints[target.index], construction.site) {
        CompilerBug.panic(b"construction placement does not target its actual descriptor")
      }
      earlier = usize.ZERO
      while earlier < input {
        if inputs[earlier].map.index == inputs[input].map.index {
          CompilerBug.panic(b"physical capture placement was duplicated as another input")
        }
        earlier = earlier + usize.ONE
      }
      input = input + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < operations.length {
    let operation = &operations[at]
    if operation.site.index >= preparation.body.nodes.length {
      CompilerBug.panic(b"source operation has no actual body site")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if operations[earlier].site.index == operation.site.index {
        CompilerBug.panic(b"one physical operation has duplicate preparation records")
      }
      earlier = earlier + usize.ONE
    }
    if let Option<ApplicationId>.Some {value} = operation.application {
      if value.index >= applications.length { CompilerBug.panic(b"source operation has no selected application") }
    }
    if let Option<EndpointId>.Some {value} = operation.receiver {
      if value.index >= endpoints.length { CompilerBug.panic(b"source operation has no actual receiver endpoint") }
    }
    let inputs = List<InputRoute>.asSlice(&operation.inputs)
    let mut input = usize.ZERO
    while input < inputs.length {
      run validatePreparedInput(preparation, operation.site, &inputs[input])
      input = input + usize.ONE
    }
    if operation.phase == PreparedOperationPhase.PrepareEffect {
      if let Option<MapId>.Some {..} = operation.result {
        CompilerBug.panic(b"Effect preparation cannot publish an executed success result")
      }
      let mut found = usize.MAX
      let mut construction = usize.ZERO
      while construction < constructions.length {
        if constructions[construction].site.index == operation.site.index { found = construction }
        construction = construction + usize.ONE
      }
      if found == usize.MAX { CompilerBug.panic(b"Effect preparation has no owning physical construction") }
      let captures = List<InputRoute>.asSlice(&constructions[found].inputs)
      if captures.length != inputs.length { CompilerBug.panic(b"Effect preparation changed its physical input count") }
      input = usize.ZERO
      while input < inputs.length {
        if !sameInputRoute(&inputs[input], &captures[input]) {
          CompilerBug.panic(b"Effect preparation must reference its construction's exact paired input routes")
        }
        input = input + usize.ONE
      }
    } else {
      let result = match operation.result {
        Option<MapId>.Some {value} => value
        _ => { return CompilerBug.panic(b"executing operation has no exact result family") }
      }
      drop run transferFamily(endpoints, maps, result)
      let output = &maps[result.index]
      if output.site.index != operation.site.index || output.kind != MapKind.Contract
        || !nodeValueEndpoint(&endpoints[output.target.index], operation.site) {
        CompilerBug.panic(b"operation result is not its selected contract-to-result family")
      }
      if operation.phase == PreparedOperationPhase.Invoke {
        let application = match operation.application {
          Option<ApplicationId>.Some {value} => value
          _ => { return CompilerBug.panic(b"invocation has no exact selected application") }
        }
        let selectedResult = match &endpoints[output.source.index].root {
          Root.Application {application: selected, port, space, ..} => selected.index == application.index
            && port == PreparedContractPort.Result && space == PreparedTypeSpace.Applied
          _ => false
        }
        if !selectedResult {
          CompilerBug.panic(b"invocation result does not belong to its exact applied original contract")
        }
      }
      if operation.phase == PreparedOperationPhase.ExecuteEffect {
        if let Option<ApplicationId>.Some {..} = operation.application {
          CompilerBug.panic(b"stored Run cannot substitute a type-selected application for reaching descriptors")
        }
        let receiver = match operation.receiver {
          Option<EndpointId>.Some {value} => value
          _ => { return CompilerBug.panic(b"stored Run has no actual descriptor receiver") }
        }
        let success = &endpoints[output.source.index]
        let paired = match success.parent {
          Option<EndpointId>.Some {value} => value.index == receiver.index
          _ => false
        }
        let selectedSuccess = match &success.selector { Selector.EffectSuccess => true _ => false }
        if !paired || !selectedSuccess { CompilerBug.panic(b"Run result must start at its actual receiver's success port") }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn nodeValueEndpoint(endpoint: &Endpoint, site: NodeId) -> bool {
  return match &endpoint.root {
    Root.Node {node, category} => node.index == site.index && category == EndpointRole.Value
    _ => false
  }
}

effect fn validatePreparedInput<'body>(preparation: &SourcePreparation<'body>, site: NodeId, input: &InputRoute) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  drop run transferFamily(endpoints, maps, input.map)
  let map = &maps[input.map.index]
  let operand = inputOperand(preparation, site, input.read)
  let physical = match &endpoints[map.source.index].root {
    Root.Node {node, ..} => node.index == operand.index
    _ => false
  }
  if !physical { CompilerBug.panic(b"prepared input map does not start at its selected actual operand") }
  if map.site.index != site.index || map.kind == MapKind.Contract
    || input.selected.index >= endpoints.length || input.original.index >= endpoints.length {
    CompilerBug.panic(b"operation input lacks its physical and declaration endpoint pair")
  }
  let selected = match &endpoints[input.selected.index].root {
    Root.Application {application, space, ..} => application.index < List<Prepared.Application>.length(&preparation.applications)
      && space == PreparedTypeSpace.Selected
    _ => false
  }
  let original = match &endpoints[input.original.index].root {
    Root.Application {application, space, ..} => application.index < List<Prepared.Application>.length(&preparation.applications)
      && space == PreparedTypeSpace.Original
    _ => false
  }
  if !selected || !original { CompilerBug.panic(b"input correspondence lost its distinct selected and original owner spaces") }
  let borrows = input.transport == Transport.BorrowShared || input.transport == Transport.BorrowMutable
  match input.referent {
    Option<MapId>.Some {value} => {
      if !borrows { CompilerBug.panic(b"value transport has a fabricated reference-creation route") }
      drop run transferFamily(endpoints, maps, value)
      validateReferenceMaps(endpoints, maps, input.map, value)
    }
    Option<MapId>.None => {
      if borrows { CompilerBug.panic(b"created reference is missing its paired referent route") }
    }
  }
  return ()
}

/// Select an authored operand coordinate, never a last evaluation of an equal NodeId.
pub fn inputOperand<'body>(preparation: &SourcePreparation<'body>, site: NodeId, read: InputRead) -> NodeId {
  if site.index >= preparation.body.nodes.length { return CompilerBug.panic(b"prepared input has no typed operation") }
  let form = match &preparation.body.nodes[site.index].kind {
    NodeKind.Expression {form, ..} => &form
    _ => { return CompilerBug.panic(b"prepared input does not belong to an expression") }
  }
  return match read {
    InputRead.Argument {ordinal} => {
      let arguments = match &form.* {
        Expression.DirectCall {arguments, ..} => List<NodeId>.asSlice(&arguments)
        Expression.InterfaceCall {arguments, ..} => List<NodeId>.asSlice(&arguments)
        Expression.CallableCall {arguments, ..} => List<NodeId>.asSlice(&arguments)
        Expression.StagedCallable {arguments, ..} => List<NodeId>.asSlice(&arguments)
        _ => { return CompilerBug.panic(b"prepared argument selector has no actual argument vector") }
      }
      if ordinal >= arguments.length { return CompilerBug.panic(b"prepared argument selector is out of bounds") }
      return arguments[ordinal]
    }
    InputRead.Receiver => match &form.* {
      Expression.Run {value, ..} => value
      Expression.CallableCall {callee, ..} => callee
      Expression.StagedCallable {callee, ..} => callee
      _ => { return CompilerBug.panic(b"prepared receiver selector has no actual callee") }
    }
    InputRead.Field {ordinal} => {
      let fields = match &form.* {
        Expression.Aggregate {fields, ..} => List<AggregateField>.asSlice(&fields)
        Expression.Callable {fields, ..} => List<AggregateField>.asSlice(&fields)
        _ => { return CompilerBug.panic(b"prepared field selector has no actual capture vector") }
      }
      if ordinal >= fields.length { return CompilerBug.panic(b"prepared field selector is out of bounds") }
      return fields[ordinal].value
    }
  }
}

pub fn sameInputRead(left: InputRead, right: InputRead) -> bool {
  return match left {
    InputRead.Argument {ordinal} => match right { InputRead.Argument {ordinal: other} => ordinal == other _ => false }
    InputRead.Receiver => match right { InputRead.Receiver => true _ => false }
    InputRead.Field {ordinal} => match right { InputRead.Field {ordinal: other} => ordinal == other _ => false }
  }
}

fn sameInputRoute(left: &InputRoute, right: &InputRoute) -> bool {
  if left.map.index != right.map.index || left.selected.index != right.selected.index
    || left.original.index != right.original.index || left.transport != right.transport
    || !sameInputRead(left.read, right.read) { return false }
  return match left.referent {
    Option<MapId>.Some {value} => match right.referent {
      Option<MapId>.Some {value: other} => value.index == other.index
      _ => false
    }
    Option<MapId>.None => match right.referent { Option<MapId>.None => true _ => false }
  }
}

effect fn validateReservation<'body>(preparation: &SourcePreparation<'body>, reaching: &Reaching,
  evaluations: &[Evaluation], values: &[Value], leaves: &[Leaf], seeds: &[Seed], transfers: &[Transfer], aliases: &[StorageAlias], aliasEdges: &[AliasEdge], aliasTransports: &[AliasTransport], storage: &[Storage], writes: &[RetainedWrite], invocationWrites: &[InvocationWrite], summaryReads: &[SummaryRead], ordinarySummaries: &[OrdinarySummaryWrite], referenceHoldings: &[ReferenceHolding], moveHoldings: &[MoveHolding], ownershipMirrors: &[OwnershipMirror], summaries: &[SummaryStorage], fields: &[FieldReholdCandidate]) -> () ! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&preparation.endpoints)
  let points = List<Point>.asSlice(&reaching.points)
  let nodes = preparation.body.nodes
  let mut component = usize.ZERO
  while component < storage.length {
    let stored = storage[component]
    if stored.endpoint.index >= endpoints.length { CompilerBug.panic(b"canonical source storage lacks a prepared endpoint") }
    let mut valid = false
    match stored.temporary {
      Option<EvalId>.Some {value} => {
        if value.index >= evaluations.length { CompilerBug.panic(b"temporary source storage has no actual owner evaluation") }
        valid = match evaluations[value.index].site {
          EvaluationSite.Node {node: actual} => match &endpoints[stored.endpoint.index].root {
            Root.Node {node, category} => actual.index == node.index && category == EndpointRole.Storage
            _ => false
          }
          _ => false
        }
      }
      Option<EvalId>.None => { valid = match &endpoints[stored.endpoint.index].root { Root.Local {category, ..} => category == EndpointRole.Storage _ => false } }
    }
    if !valid { CompilerBug.panic(b"canonical source storage substituted another owner or occurrence") }
    component = component + usize.ONE
  }
  let mut at = usize.ZERO
  while at < evaluations.length {
    let evaluation = evaluations[at]
    if evaluation.point.index >= points.length { CompilerBug.panic(b"source evaluation has no reserved CFG point") }
    match evaluation.site {
      EvaluationSite.Node {node} => {
        if node.index >= nodes.length || evaluation.category == EvaluationRole.Entry {
          CompilerBug.panic(b"source evaluation does not name its actual body node")
        }
      }
      EvaluationSite.Entry {local} => {
        if local.index >= preparation.body.locals.length || evaluation.category != EvaluationRole.Entry {
          CompilerBug.panic(b"source entry does not name actual initialized storage")
        }
        let mut node = usize.ZERO
        while node < nodes.length {
          let binding = match &nodes[node].kind {
            NodeKind.LocalBinding {local: bound, ..} => bound.index == local.index
            NodeKind.MutableBinding {local: bound, ..} => bound.index == local.index
            _ => false
          }
          if binding { CompilerBug.panic(b"a later local binding was fabricated as source entry storage") }
          node = node + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < values.length {
    if values[at].evaluation.index >= evaluations.length || values[at].endpoint.index >= endpoints.length {
      CompilerBug.panic(b"source value has no actual evaluation or prepared endpoint")
    }
    if let Option<ResidualSubject>.Some {value} = values[at].subject {
      if value.base.index >= values.length || value.state.index >= List<Prepared.ResidualState>.length(&preparation.residuals)
        || values[value.base.index].endpoint.index != values[at].endpoint.index {
        CompilerBug.panic(b"source residual lost its physical anchor or finite suffix")
      }
      if let Option<ResidualSubject>.Some {..} = values[value.base.index].subject {
        CompilerBug.panic(b"source residual recursively extended another virtual anchor")
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < leaves.length {
    if leaves[at].endpoint.index >= endpoints.length { CompilerBug.panic(b"source leaf has no prepared endpoint") }
    let valid = match &leaves[at].kind {
      SourceLeaf.Entry {local} => local.index < preparation.body.locals.length
      SourceLeaf.Borrow {node: Option<NodeId>.Some {value}, ..} => value.index < nodes.length
      SourceLeaf.Borrow {node: Option<NodeId>.None, ..} => true
      SourceLeaf.Expression {node} => node.index < nodes.length
      SourceLeaf.LoanFree {node} => node.index < nodes.length
      SourceLeaf.Unknown {node: Option<NodeId>.Some {value}, ..} => value.index < nodes.length
      SourceLeaf.Unknown {node: Option<NodeId>.None, ..} => true
    }
    if !valid { CompilerBug.panic(b"source leaf names an absent body origin") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < seeds.length {
    let seed = seeds[at]
    if seed.value.index >= values.length || seed.leaf.index >= leaves.length {
      CompilerBug.panic(b"source seed has no reserved value or leaf")
    }
    if let Option<usize>.Some {..} = values[seed.value.index].summary { CompilerBug.panic(b"summary storage cannot invent a value source") }
    if values[seed.value.index].phase != ValuePhase.Output { CompilerBug.panic(b"a source seed cannot bypass a real read") }
    if let Option<ResidualSubject>.Some {..} = values[seed.value.index].subject { CompilerBug.panic(b"a selected suffix must derive from actual source evidence") }
    if values[seed.value.index].endpoint.index != leaves[seed.leaf.index].endpoint.index {
      CompilerBug.panic(b"source seed bypasses its physical placement map")
    }
    if let SourceLeaf.Entry {local} = &leaves[seed.leaf.index].kind {
      let actual = evaluations[values[seed.value.index].evaluation.index]
      let valid = match actual.site {
        EvaluationSite.Entry {local: bound} => bound.index == local.index
        _ => false
      }
      if !valid { CompilerBug.panic(b"caller source seed did not originate in actual entry storage") }
    }
    at = at + usize.ONE
  }
  let maps = List<SelectionMap>.asSlice(&preparation.maps)
  let routes = List<ContractRoute>.asSlice(&preparation.routes)
  at = usize.ZERO
  while at < transfers.length {
    let transfer = &transfers[at]
    if transfer.source.index >= values.length || transfer.target.index >= values.length {
      CompilerBug.panic(b"source transfer has no reserved physical value")
    }
    let source = values[transfer.source.index].endpoint
    let target = values[transfer.target.index].endpoint
    match transfer.authority {
      TransferAuthority.DeclaredResult {..} => {
        // validateInvocationDeclarations checks the actual Entry Case and result family.
        if transfer.policy != TransferPolicy.Physical || transfer.terminal || transfer.directness != Directness.Indirect {
          CompilerBug.panic(b"declared Entry result changed its provenance publication")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"declared Entry result replaced its source definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"declared Entry result replaced its source read") }
      }
      TransferAuthority.FieldResult {..} => {
        // The exact recipe/evidence validator checks residual placement and source Case.
        if transfer.policy != TransferPolicy.Filtered || !transfer.terminal {
          CompilerBug.panic(b"semantic Field bypassed its actual operand finish")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"semantic Field changed its definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"semantic Field changed its read") }
      }
      TransferAuthority.OrdinaryResult {..} => {
        // validateOrdinaryResults authenticates the exact NamedInvoke occurrence, input member and whole finish directive.
        if transfer.policy != TransferPolicy.Filtered || !transfer.terminal || transfer.directness != Directness.Indirect {
          CompilerBug.panic(b"ordinary result result bypassed its ownership finish policy")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"ordinary result result changed its raw definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"ordinary result result changed its raw read") }
      }
      TransferAuthority.RvalueDereferenceResult {..} => {
        // validateRvalueDereferenceResults authenticates the exact typed occurrence, finish directive and selection map.
        if transfer.policy != TransferPolicy.Filtered || !transfer.terminal || transfer.directness != Directness.Indirect {
          CompilerBug.panic(b"rvalue dereference result bypassed its ownership finish policy")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"rvalue dereference result changed its raw definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"rvalue dereference result changed its raw read") }
      }
      TransferAuthority.ThroughResult {..} => {
        // validateThroughResults authenticates the complete original flight/summary table.
        if transfer.policy != TransferPolicy.Filtered || !transfer.terminal || transfer.directness != Directness.Indirect {
          CompilerBug.panic(b"through result bypassed its ownership finish policy")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"through result changed its raw definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"through result changed its raw read") }
      }
      TransferAuthority.FieldRehold {candidate} => {
        if candidate >= fields.length { CompilerBug.panic(b"field rehold lost its exact original Case candidate") }
        let row = fields[candidate]
        let directness = holdingDirectness(row.disposition == SummaryDisposition.Shadowed || unknownOwnership(row.placement))
        if transfer.source.index != row.source.index || transfer.target.index != row.target.index || !Atom.same(transfer.active, row.active)
          || transfer.directness != directness || transfer.policy != TransferPolicy.Filtered || transfer.terminal {
          CompilerBug.panic(b"field rehold changed original input or publication policy")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"field rehold replaced original definition witness") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"field rehold replaced original read witness") }
      }
      TransferAuthority.OwnershipMirror {candidate, sourceCell} => {
        if candidate >= ownershipMirrors.length { CompilerBug.panic(b"ownership mirror lost its original writer candidate") }
        let mirror = ownershipMirrors[candidate]
        let directness = holdingDirectness(unknownOwnership(mirror.placement))
        if sourceCell != mirror.sourceCell || transfer.source.index != mirror.source.index || transfer.target.index != mirror.target.index
          || !Atom.same(transfer.active, mirror.active) || transfer.directness != directness
          || transfer.policy != TransferPolicy.Filtered || transfer.terminal {
          CompilerBug.panic(b"ownership mirror changed its original writer or holding policy")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"ownership mirror replaced its raw source definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"ownership mirror replaced its raw source read") }
      }
      TransferAuthority.MoveHolding {candidate} => {
        if candidate >= moveHoldings.length { CompilerBug.panic(b"Move transfer lost its construction candidate") }
        let selected = moveHoldings[candidate]
        let directness = holdingDirectness(unknownOwnership(selected.placement))
        if transfer.source.index != selected.source.index || transfer.target.index != selected.target.index
          || !Atom.same(transfer.active, selected.active) || transfer.policy != TransferPolicy.Filtered
          || transfer.directness != directness || transfer.terminal {
          CompilerBug.panic(b"Move holding changed its actual observation or policy")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"Move holding replaced original definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"Move holding replaced original read") }
      }
      TransferAuthority.CaptureReborrow {placement, ..} => {
        let physical = &maps[placement.index]
        if source.index != physical.source.index || target.index != physical.target.index
          || transfer.policy != TransferPolicy.Physical || transfer.directness != Directness.Preserve
          || transfer.terminal || physical.kind != MapKind.Place || !physical.componentTransport || physical.addressTransport {
          CompilerBug.panic(b"capture reborrow changed its original environment placement")
        }
      }
      TransferAuthority.ReferenceHolding {candidate} => {
        if candidate >= referenceHoldings.length { CompilerBug.panic(b"reference transfer lost its original holding candidate") }
        let selected = referenceHoldings[candidate]
        let directness = match selected.placement { OwnershipPlacement.Unknown => Directness.Indirect _ => Directness.Preserve }
        if transfer.source.index != selected.source.index || transfer.target.index != selected.target.index
          || !Atom.same(transfer.active, selected.active) || transfer.policy != TransferPolicy.Filtered
          || transfer.directness != directness || transfer.terminal {
          CompilerBug.panic(b"reference holding changed its input identity or policy")
        }
        if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"reference holding replaced its original definition") }
        if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"reference holding replaced its original read") }
      }
      TransferAuthority.SummaryRead {reading} => {
        if reading >= summaryReads.length { CompilerBug.panic(b"summary transfer has no exact read authority") }
        let actual = summaryReads[reading]
        let from = values[transfer.source.index]
        let selected = match from.summary { Option<usize>.Some {value} => value == actual.summary _ => false }
        let exactRead = match from.summaryRead { Option<ReadId>.Some {value} => value.index == actual.original.index _ => false }
        if !selected || !exactRead || from.phase != ValuePhase.Input || transfer.target.index != actual.target.index
          || !Atom.same(transfer.active, actual.active) || transfer.directness != Directness.Preserve
          || transfer.policy != TransferPolicy.Physical || transfer.terminal {
          CompilerBug.panic(b"summary read changed its original prefix, consumer or applicability")
        }
      }
      TransferAuthority.OrdinarySummary {candidate} => {
        if candidate >= ordinarySummaries.length { CompilerBug.panic(b"ordinary summary has no actual definition authority") }
        let selected = ordinarySummaries[candidate]
        let directness = holdingDirectness(unknownOwnership(summaries[selected.summary].placement))
        if transfer.source.index != selected.source.index || transfer.target.index != selected.target.index
          || !Atom.same(transfer.active, selected.active) || transfer.policy != TransferPolicy.Filtered
          || transfer.directness != directness || transfer.terminal {
          CompilerBug.panic(b"ordinary summary changed its original write or policy")
        }
      }
      TransferAuthority.InvocationWrite {candidate} => {
        if candidate >= invocationWrites.length || invocationWrites[candidate].source.index != transfer.source.index
          || invocationWrites[candidate].target.index != transfer.target.index || transfer.policy != TransferPolicy.Filtered
          || !Atom.same(transfer.active, invocationWrites[candidate].active)
          || transfer.terminal || transfer.directness != Directness.Indirect {
          CompilerBug.panic(b"invocation write changed its actual candidate or publication policy")
        }
      }
      TransferAuthority.RetainedWrite {candidate} => {
        if candidate >= writes.length || writes[candidate].source.index != transfer.source.index
          || writes[candidate].target.index != transfer.target.index || transfer.policy != TransferPolicy.Filtered
          || transfer.terminal || transfer.directness != Directness.Indirect {
          CompilerBug.panic(b"retained write changed its actual candidate or publication policy")
        }
      }
      TransferAuthority.Address {edge, direction} => {
        validateAddressTransfer(values, aliases, aliasEdges, aliasTransports, transfer.source, transfer.target, edge, direction)
      }
      TransferAuthority.OperationResult {candidate, position} => {
        Results.validateCandidate(preparation, candidate)
        let placement = run Results.outputPlacement(preparation, candidate)
        let mut valid = false
        match &placement.suffix {
          ResultsPlacementSuffix.Whole => { valid = match position { Option<Results.Position>.None => true _ => false } }
          ResultsPlacementSuffix.Selected {targets, ..} => {
            let targetsSelected = List<Results.Position>.asSlice(&targets)
            let mut found = false
            let mut each = usize.ZERO
            if let Option<Results.Position>.Some {value} = position {
              while each < targetsSelected.length {
                if Results.samePosition(value, targetsSelected[each]) { found = true }
                each = each + usize.ONE
              }
            }
            valid = found
          }
        }
        if !valid { CompilerBug.panic(b"operation result lost its exact root/current placement") }
        if source.index != candidate.source.index || target.index != candidate.target.index
          || values[transfer.source.index].evaluation.index != candidate.operand.index
          || values[transfer.target.index].evaluation.index != candidate.result.index {
          CompilerBug.panic(b"operation result lost its actual input/output occurrences")
        }
        let subject = values[transfer.target.index].subject
        match position {
          Option<Results.Position>.Some {value} => {
            let state = Results.positionState(preparation, value)
            let exact = match subject { Option<ResidualSubject>.Some {value: actual} => actual.state.index == state.index && sameResultPosition(actual.position, position) _ => false }
            if !exact { CompilerBug.panic(b"result continuation was substituted for its whole output anchor") }
          }
          Option<Results.Position>.None => {
            if let Option<ResidualSubject>.Some {..} = subject { CompilerBug.panic(b"whole result invented a residual subject") }
          }
        }
      }
      _ => {
        match authorityMap(transfer.authority) {
          Option<MapId>.Some {value} => {
            if value.index >= maps.length { CompilerBug.panic(b"source transfer has no prepared physical map") }
            let physical = &maps[value.index]
            let forward = authorityDirection(transfer.authority) == MapDirection.Forward
            let mut matches = physical.source.index == source.index && physical.target.index == target.index
            if !forward { matches = physical.target.index == source.index && physical.source.index == target.index }
            if !matches { CompilerBug.panic(b"source transfer does not follow its prepared physical endpoints") }
            match authorityAddress(transfer.authority) {
              Option<EvalId>.Some {value: address} => validateAddressMap(endpoints, maps, aliases, aliasEdges, value, address)
              Option<EvalId>.None => {
                if !forward || physical.addressTransport { CompilerBug.panic(b"source address map has no actual storage-identity evidence") }
              }
            }
          }
          Option<MapId>.None => {
            if source.index != target.index { CompilerBug.panic(b"distinct source endpoints require a prepared map") }
            if authorityDirection(transfer.authority) != MapDirection.Forward { CompilerBug.panic(b"unmapped source transfer cannot invert an address") }
            if let Option<EvalId>.Some {..} = authorityAddress(transfer.authority) { CompilerBug.panic(b"address evidence requires its actual map") }
          }
        }
        if let Option<ContractRouteId>.Some {value} = authorityContract(transfer.authority) {
          if value.index >= routes.length { CompilerBug.panic(b"source transfer has no original contract route") }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Frozen residual rows are not source witnesses. Validate the paired finite automaton before
// following any actual value edge, including unreachable ones: a same-shaped sibling must not
// be substituted for the producer's recorded continuation, and descendants are not new roots.
fn residualAccess(shape: &Prepared.Shape) -> Option<ReferenceAccess> {
  return Shared<Type>.with<Option<ReferenceAccess>>(&shape.ty, fn(ty: &Type) -> Option<ReferenceAccess> {
    return match &ty.* {
      Type.Reference {access, ..} => Option<ReferenceAccess>.some(access)
      Type.Slice {access, ..} => Option<ReferenceAccess>.some(access)
      Type.Pointer {access, ..} => Option<ReferenceAccess>.some(access)
      _ => Option<ReferenceAccess>.none()
    }
  })
}

fn sameResidualAccess(left: Option<ReferenceAccess>, right: Option<ReferenceAccess>) -> bool {
  return match left {
    Option<ReferenceAccess>.Some {value} => match right { Option<ReferenceAccess>.Some {value: other} => value == other _ => false }
    Option<ReferenceAccess>.None => match right { Option<ReferenceAccess>.None => true _ => false }
  }
}

fn residualComponent(shapes: &[Prepared.Shape], id: Prepared.ComponentId) -> &Prepared.Component {
  if id.shape.index >= shapes.length { return CompilerBug.panic(b"residual component has no frozen parent shape") }
  let components = List<Prepared.Component>.asSlice(&shapes[id.shape.index].components)
  if id.ordinal >= components.length { return CompilerBug.panic(b"residual component has no exact parent row") }
  return &components[id.ordinal]
}

fn sameResidualComponent(left: Prepared.ComponentId, right: Prepared.ComponentId) -> bool {
  return left.shape.index == right.shape.index && left.ordinal == right.ordinal
}

fn containsResidual(ids: &[Prepared.ResidualStateId], id: Prepared.ResidualStateId) -> bool {
  let mut at = usize.ZERO
  while at < ids.length {
    if ids[at].index == id.index { return true }
    at = at + usize.ONE
  }
  return false
}

fn authoredResidual(state: &Prepared.ResidualState) -> bool {
  return match state.authority { PreparedResidualAuthority.Authored => true _ => false }
}

fn sameOptionalResidual(left: &Option<Prepared.ResidualStateId>, right: &Option<Prepared.ResidualStateId>) -> bool {
  return match &left.* {
    Option<Prepared.ResidualStateId>.Some {value} => match &right.* {
      Option<Prepared.ResidualStateId>.Some {value: other} => value.index == other.index
      _ => false
    }
    Option<Prepared.ResidualStateId>.None => match &right.* { Option<Prepared.ResidualStateId>.None => true _ => false }
  }
}

// These states retain original contract components under one exact prepared transformation.
// Normalization-away Variant prefixes are not authored selectors or physical alias evidence.
fn validateContractResidual<'body>(prepared: &SourcePreparation<'body>, state: &Prepared.ResidualState,
  projection: Prepared.ContractProjectionId, terminal: bool) -> () {
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  if projection.index >= List<Prepared.ContractProjection>.length(&prepared.contractProjections)
    || state.selection.index >= selections.length || state.vertex.index >= endpoints.length || state.output.index >= shapes.length {
    CompilerBug.panic(b"contract residual is outside its projection domain")
  }
  let component = residualComponent(shapes, state.input)
  let accepted = List<EndpointId>.asSlice(&selections[state.selection.index].accepts)
  let mut accepts = false
  let mut each = usize.ZERO
  while each < accepted.length {
    if accepted[each].index == state.vertex.index { accepts = true }
    each = each + usize.ONE
  }
  if terminal {
    let variant = match &component.selector { Selector.Variant {..} => true _ => false }
    let authoredVariant = match &endpoints[state.vertex.index].selector { Selector.Variant {..} => true _ => false }
    if state.accepts != accepts || (!sameSelector(&component.selector, &endpoints[state.vertex.index].selector)
      && !(variant && authoredVariant)) {
      CompilerBug.panic(b"contract terminal changed its authored selector or acceptance")
    }
  } else {
    let variant = match &component.selector { Selector.Variant {..} => true _ => false }
    if !variant || state.accepts { CompilerBug.panic(b"normalization prefix is not a nonaccepting original variant") }
  }
  let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
  each = usize.ZERO
  while each < next.length {
    if next[each].index >= states.length { CompilerBug.panic(b"contract residual names an absent continuation") }
    let child = &states[next[each].index]
    let exact = match child.authority {
      PreparedResidualAuthority.Contract {projection: actual, ..} => actual.index == projection.index
      _ => false
    }
    if !exact || child.selection.index != state.selection.index || child.input.shape.index != state.output.index {
      CompilerBug.panic(b"contract residual changed projection, selection or component chain")
    }
    each = each + usize.ONE
  }
  return ()
}

// Authored states preserve the exact finite selector graph. Contract normalization has a
// different authority and must not relax these physical/address selector invariants.
fn validateAuthoredResidual(shapes: &[Prepared.Shape], endpoints: &[Endpoint],
  selections: &[Selection], maps: &[SelectionMap], states: &[Prepared.ResidualState],
  state: &Prepared.ResidualState) -> () {
  if !authoredResidual(state) { CompilerBug.panic(b"physical residual has contract normalization authority") }
  if state.selection.index >= selections.length || state.vertex.index >= endpoints.length || state.output.index >= shapes.length {
    CompilerBug.panic(b"residual state is outside its frozen selection domain")
  }
  let component = residualComponent(shapes, state.input)
  if !sameSelector(&component.selector, &endpoints[state.vertex.index].selector) {
    CompilerBug.panic(b"residual state changed its original selector vertex")
  }
  let selection = &selections[state.selection.index]
  let accepted = List<EndpointId>.asSlice(&selection.accepts)
  let mut accepts = false
  let mut each = usize.ZERO
  while each < accepted.length {
    if accepted[each].index == state.vertex.index { accepts = true }
    each = each + usize.ONE
  }
  if accepts != state.accepts { CompilerBug.panic(b"residual acceptance changed the original selection frontier") }
  let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
  let edges = List<MapId>.asSlice(&selection.maps)
  each = usize.ZERO
  while each < next.length {
    if next[each].index >= states.length { CompilerBug.panic(b"residual continuation is outside its finite domain") }
    let child = &states[next[each].index]
    if !authoredResidual(child) || child.selection.index != state.selection.index || child.input.shape.index != state.output.index {
      CompilerBug.panic(b"residual continuation changed selection or component output")
    }
    let mut found = false
    let mut edge = usize.ZERO
    while edge < edges.length {
      if edges[edge].index >= maps.length { CompilerBug.panic(b"residual selection names an absent map") }
      let physical = &maps[edges[edge].index]
      if physical.kind == MapKind.Select && physical.source.index == state.vertex.index
        && physical.target.index == child.vertex.index { found = true }
      edge = edge + usize.ONE
    }
    if !found { CompilerBug.panic(b"residual continuation has no original selector edge") }
    each = each + usize.ONE
  }
  if !state.accepts && next.length == usize.ZERO { CompilerBug.panic(b"residual selection lost every accepting continuation") }
  return ()
}

fn sameShapeContext(left: PreparedShapeContext, right: PreparedShapeContext) -> bool {
  return match left {
    PreparedShapeContext.Body => match right { PreparedShapeContext.Body => true _ => false }
    PreparedShapeContext.Retention {retention} => match right {
      PreparedShapeContext.Retention {retention: other} => retention.index == other.index
      _ => false
    }
    PreparedShapeContext.Application {application, space} => match right {
      PreparedShapeContext.Application {application: other, space: otherSpace} => application.index == other.index && space == otherSpace
      _ => false
    }
  }
}

// Semantic owns tracked type application and channel selection. The graph authenticates
// the retained original premise/context, never reapplies bindings or promotes opaque storage.
fn validateShapeContexts<'body>(prepared: &SourcePreparation<'body>) -> () {
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let applications = List<Prepared.Application>.asSlice(&prepared.applications)
  let evidence = List<Prepared.Representation>.asSlice(&prepared.representations)
  let mut at = usize.ZERO
  while at < evidence.length {
    let row = &evidence[at]
    let mut constraints = prepared.body.constraints
    if let PreparedShapeContext.Application {application, ..} = row.context {
      if application.index >= applications.length { CompilerBug.panic(b"representation premise has an absent application") }
      constraints = List<Constraint>.asSlice(&applications[application.index].constraints)
    }
    if let PreparedShapeContext.Retention {retention} = row.context {
      let retained = List<Prepared.Retention>.asSlice(&prepared.retentions)
      if retention.index >= retained.length { CompilerBug.panic(b"representation premise has an absent retained stage") }
      constraints = List<Constraint>.asSlice(&retained[retention.index].constraints)
    }
    if row.ordinal >= constraints.length { CompilerBug.panic(b"representation premise has no original constraint ordinal") }
    let represented = match &constraints[row.ordinal] { Constraint.Represents {..} => true _ => false }
    if !represented { CompilerBug.panic(b"channel evidence reclassified another constraint as Represents") }
    let mut prior = usize.ZERO
    while prior < at {
      if evidence[prior].ordinal == row.ordinal && sameShapeContext(evidence[prior].context, row.context) {
        CompilerBug.panic(b"representation premise was duplicated within one application space")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < shapes.length {
    let shape = &shapes[at]
    if let PreparedShapeContext.Application {application, ..} = shape.context {
      if application.index >= applications.length { CompilerBug.panic(b"shape context has an absent application") }
    }
    if let PreparedShapeContext.Retention {retention} = shape.context {
      if retention.index >= List<Prepared.Retention>.length(&prepared.retentions) {
        CompilerBug.panic(b"shape context has an absent retained parameter stage")
      }
    }
    let components = List<Prepared.Component>.asSlice(&shape.components)
    let mut child = usize.ZERO
    while child < components.length {
      let component = &components[child]
      if let Option<Prepared.RepresentationId>.Some {value} = component.representation {
        if value.index >= evidence.length || !sameShapeContext(evidence[value.index].context, shape.context)
          || component.inline || !channelSelector(&component.selector) {
          CompilerBug.panic(b"declared channel evidence leaked into storage or another premise context")
        }
      }
      child = child + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < endpoints.length {
    let endpoint = &endpoints[at]
    if endpoint.shape.index >= shapes.length { CompilerBug.panic(b"prepared endpoint has an absent contextual shape") }
    let expected = match &endpoint.root {
      Root.Application {application, space, ..} => PreparedShapeContext.Application {application: application, space: space}
      Root.Retention {retention, ..} => PreparedShapeContext.Retention {retention: retention}
      _ => PreparedShapeContext.Body
    }
    if !sameShapeContext(shapes[endpoint.shape.index].context, expected) {
      CompilerBug.panic(b"prepared endpoint imported another declaration's shape premises")
    }
    at = at + usize.ONE
  }
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  at = usize.ZERO
  while at < states.length {
    if states[at].input.shape.index >= shapes.length || states[at].output.index >= shapes.length
      || !sameShapeContext(shapes[states[at].input.shape.index].context, shapes[states[at].output.index].context) {
      CompilerBug.panic(b"residual output changed its exact parent premise context")
    }
    at = at + usize.ONE
  }
  return ()
}

fn channelSelector(selector: &Selector) -> bool {
  return match &selector.* { Selector.CallableResult => true Selector.EffectSuccess => true Selector.EffectFailure => true _ => false }
}

fn validateResiduals<'body>(prepared: &SourcePreparation<'body>) -> () {
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let pairs = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let substitutions = List<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)
  let mut at = usize.ZERO
  while at < states.length {
    match states[at].authority {
      PreparedResidualAuthority.Authored => validateAuthoredResidual(shapes, endpoints, selections, maps, states, &states[at])
      PreparedResidualAuthority.Contract {projection, terminal} => {
        validateContractResidual(prepared, &states[at], projection, terminal)
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < pairs.length {
    let pair = &pairs[at]
    if pair.map.index >= maps.length || pair.sourceState.index >= states.length || pair.targetState.index >= states.length
      || pair.substitution.index >= substitutions.length { CompilerBug.panic(b"residual pair is outside its frozen domain") }
    let physical = &maps[pair.map.index]
    if physical.source.index >= endpoints.length || physical.target.index >= endpoints.length {
      CompilerBug.panic(b"residual transport lost its physical endpoints")
    }
    let physicalAuthority = physical.componentTransport && !physical.addressTransport
      && (physical.kind == MapKind.Copy || physical.kind == MapKind.Place)
      && pair.authority == PreparedBoundaryAuthority.Physical
    let sourceStorage = match move endpointRole(&endpoints[physical.source.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
    let targetStorage = match move endpointRole(&endpoints[physical.target.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
    let aliasAuthority = physical.addressTransport && !physical.componentTransport && physical.kind == MapKind.Select
      && sourceStorage && targetStorage && pair.authority == PreparedBoundaryAuthority.StorageAlias
    if (!physicalAuthority && !aliasAuthority) || !sameSelector(&physical.selector, &Selector.Identity) {
      CompilerBug.panic(b"residual pair lacks its exact physical or storage-alias authority")
    }
    let source = &states[pair.sourceState.index]
    let target = &states[pair.targetState.index]
    if !authoredResidual(source) || !authoredResidual(target) {
      CompilerBug.panic(b"physical or storage-alias pair used contract normalization")
    }
    if !sameResidualComponent(pair.source, source.input) || !sameResidualComponent(pair.target, target.input)
      || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
      || source.accepts != target.accepts {
      CompilerBug.panic(b"residual pair combines different selector histories")
    }
    let left = residualComponent(shapes, pair.source)
    let right = residualComponent(shapes, pair.target)
    if channelSelector(&left.selector) || !sameSelector(&left.selector, &right.selector)
      || !sameResidualAccess(pair.sourceAccess, residualAccess(&shapes[pair.source.shape.index]))
      || !sameResidualAccess(pair.targetAccess, residualAccess(&shapes[pair.target.shape.index])) {
      CompilerBug.panic(b"residual pair lost its component or descriptor access evidence")
    }
    let substitution = &substitutions[pair.substitution.index]
    if substitution.source.index != source.output.index || substitution.target.index != target.output.index {
      CompilerBug.panic(b"residual substitution must describe component outputs, not parent descriptors")
    }
    let sourceNext = List<Prepared.ResidualStateId>.asSlice(&source.next)
    let targetNext = List<Prepared.ResidualStateId>.asSlice(&target.next)
    let next = List<Prepared.BoundaryTransitionId>.asSlice(&pair.next)
    let stops = List<Prepared.BoundaryStop>.asSlice(&pair.stops)
    if next.length + stops.length != sourceNext.length || next.length + stops.length != targetNext.length {
      CompilerBug.panic(b"residual pair omitted or multiplied a continuation")
    }
    let mut each = usize.ZERO
    while each < next.length {
      if next[each].index >= pairs.length { CompilerBug.panic(b"residual pair has an absent continuation") }
      let child = &pairs[next[each].index]
      if child.map.index != pair.map.index || child.authority != pair.authority || !containsResidual(sourceNext, child.sourceState)
        || !containsResidual(targetNext, child.targetState) {
        CompilerBug.panic(b"residual continuation does not follow both sides of the same map")
      }
      // A child is already an explicitly paired transition, not a Cartesian combination of
      // otherwise valid source/target successors. Each side must occur exactly once here.
      let mut earlier = usize.ZERO
      while earlier < each {
        let prior = &pairs[next[earlier].index]
        if prior.sourceState.index == child.sourceState.index || prior.targetState.index == child.targetState.index {
          CompilerBug.panic(b"residual pairing duplicated one side of a continuation")
        }
        earlier = earlier + usize.ONE
      }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < stops.length {
      let stop = &stops[each]
      if !containsResidual(sourceNext, stop.sourceState) || !containsResidual(targetNext, stop.targetState)
        || stop.sourceState.index >= states.length || stop.targetState.index >= states.length {
        CompilerBug.panic(b"channel stop lost one side of its physical parent continuation")
      }
      let sourceStop = &states[stop.sourceState.index]
      let targetStop = &states[stop.targetState.index]
      let sourceChannel = residualComponent(shapes, sourceStop.input)
      let targetChannel = residualComponent(shapes, targetStop.input)
      if !authoredResidual(sourceStop) || !authoredResidual(targetStop)
        || sourceStop.selection.index != targetStop.selection.index || sourceStop.vertex.index != targetStop.vertex.index
        || sourceStop.accepts != targetStop.accepts || !channelSelector(&sourceChannel.selector)
        || !sameSelector(&sourceChannel.selector, &targetChannel.selector) {
        CompilerBug.panic(b"channel stop cross-paired histories or acquired physical component authority")
      }
      // This partition records an obligation to compose the selected descriptor's original
      // contract. It provides neither a physical transition nor a source acceptance witness.
      let mut earlier = usize.ZERO
      while earlier < next.length {
        let prior = &pairs[next[earlier].index]
        if prior.sourceState.index == stop.sourceState.index || prior.targetState.index == stop.targetState.index {
          CompilerBug.panic(b"channel stop duplicated a physical continuation")
        }
        earlier = earlier + usize.ONE
      }
      earlier = usize.ZERO
      while earlier < each {
        if stops[earlier].sourceState.index == stop.sourceState.index || stops[earlier].targetState.index == stop.targetState.index {
          CompilerBug.panic(b"channel stop duplicated one side of a continuation")
        }
        earlier = earlier + usize.ONE
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < maps.length {
    let physical = &maps[at]
    let roots = List<Prepared.BoundaryTransitionId>.asSlice(&physical.boundaries)
    let mut each = usize.ZERO
    while each < roots.length {
      if roots[each].index >= pairs.length || physical.source.index >= endpoints.length || physical.target.index >= endpoints.length {
        CompilerBug.panic(b"residual root has no physical map endpoints")
      }
      let root = &pairs[roots[each].index]
      if root.map.index != at || root.source.shape.index != endpoints[physical.source.index].shape.index
        || root.target.shape.index != endpoints[physical.target.index].shape.index {
        CompilerBug.panic(b"residual root is not anchored at its actual transport endpoints")
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn boundaryLiftStates(lift: &Prepared.BoundaryLift, pairs: &[Prepared.BoundaryTransition]) -> Prepared.BoundaryStop {
  return match &lift.step {
    PreparedBoundaryLiftStep.Transition {id} => {
      if id.index >= pairs.length { return CompilerBug.panic(b"output lift has no frozen continuation") }
      return Prepared.BoundaryStop {sourceState: pairs[id.index].sourceState, targetState: pairs[id.index].targetState}
    }
    PreparedBoundaryLiftStep.Stop {sourceState, targetState} => {
      return Prepared.BoundaryStop {sourceState: sourceState, targetState: targetState}
    }
  }
}

fn validateBoundaryLifts<'body>(prepared: &SourcePreparation<'body>) -> () {
  let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
  let pairs = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let substitutions = List<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)
  let mut at = usize.ZERO
  while at < lifts.length {
    let lift = &lifts[at]
    if lift.boundary.index >= pairs.length { CompilerBug.panic(b"output lift has no prior boundary authority") }
    let prior = &pairs[lift.boundary.index]
    match lift.direction {
      PreparedBoundaryLiftDirection.Forward => ()
      PreparedBoundaryLiftDirection.StorageAliasInverse => {
        if prior.authority != PreparedBoundaryAuthority.StorageAlias {
          CompilerBug.panic(b"inverse storage lift has no storage-alias authority")
        }
      }
      PreparedBoundaryLiftDirection.OriginInverse => {
        let map = &List<SelectionMap>.asSlice(&prepared.maps)[prior.map.index]
        let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
        let descriptor = match &shapes[endpoints[map.source.index].shape.index].state {
          PreparedShapeState.Reference => match &shapes[endpoints[map.target.index].shape.index].state {
            PreparedShapeState.Reference => true _ => false
          }
          PreparedShapeState.Slice => match &shapes[endpoints[map.target.index].shape.index].state {
            PreparedShapeState.Slice => true _ => false
          }
          _ => false
        }
        if prior.authority != PreparedBoundaryAuthority.Physical || !map.componentTransport
          || map.addressTransport || (map.kind != MapKind.Copy && map.kind != MapKind.Place)
          || !sameSelector(&map.selector, &Selector.Identity) || !descriptor {
          CompilerBug.panic(b"inverse origin lift is not an actual reference/slice descriptor transport")
        }
        // The row reserves correspondence only. A consumer must separately retain the
        // actual composite Address proof; this never licenses Physical StorageInverse.
      }
    }
    let substitution = &substitutions[prior.substitution.index]
    let selected = boundaryLiftStates(lift, pairs)
    if selected.sourceState.index >= states.length || selected.targetState.index >= states.length {
      CompilerBug.panic(b"output lift has no paired authored suffix")
    }
    let source = &states[selected.sourceState.index]
    let target = &states[selected.targetState.index]
    if !authoredResidual(source) || !authoredResidual(target)
      || source.input.shape.index != substitution.source.index || target.input.shape.index != substitution.target.index
      || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
      || source.accepts != target.accepts {
      CompilerBug.panic(b"output lift changed prior output shapes or paired selector history")
    }
    let left = residualComponent(shapes, source.input)
    let right = residualComponent(shapes, target.input)
    if !sameSelector(&left.selector, &right.selector) { CompilerBug.panic(b"output lift cross-paired component selectors") }
    match &lift.step {
      PreparedBoundaryLiftStep.Transition {id} => {
        let child = &pairs[id.index]
        if child.map.index != prior.map.index || child.authority != prior.authority || channelSelector(&left.selector) {
          CompilerBug.panic(b"output lift substituted a map or made a channel physical")
        }
        // This row supplies its root authority. map.boundaries remains anchored to actual
        // endpoint shapes; this continuation must not be used as one of those roots.
      }
      PreparedBoundaryLiftStep.Stop {..} => {
        if !channelSelector(&left.selector) { CompilerBug.panic(b"output lift stopped an ordinary physical component") }
      }
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if lifts[earlier].boundary.index == lift.boundary.index && lifts[earlier].direction == lift.direction {
        let other = boundaryLiftStates(&lifts[earlier], pairs)
        let duplicate = match lift.direction {
          PreparedBoundaryLiftDirection.Forward => other.targetState.index == selected.targetState.index
          _ => other.sourceState.index == selected.sourceState.index
        }
        if duplicate { CompilerBug.panic(b"output lift duplicated one directed suffix interpretation") }
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Checks frozen correspondence only. Predicate admission and exact type substitution were
// established by tracked preparation; this walk neither reapplies bindings nor proves a goal.
fn contractEndpoint(endpoints: &[Endpoint], endpoint: EndpointId, application: ApplicationId,
  space: PreparedTypeSpace) -> bool {
  if endpoint.index >= endpoints.length { return false }
  return match &endpoints[endpoint.index].root {
    Root.Application {application: actual, space: actualSpace, ..} => actual.index == application.index && actualSpace == space
    _ => false
  }
}

fn contractSubject<'body>(prepared: &SourcePreparation<'body>, selection: &Prepared.ContractSelection) -> ShapeId {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  if selection.output.index >= endpoints.length { return CompilerBug.panic(b"contract enumeration has no original endpoint") }
  let mut subject = endpoints[selection.output.index].shape
  if let Option<Prepared.ResidualStateId>.Some {value} = &selection.residual {
    let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
    if value.index >= states.length { return CompilerBug.panic(b"contract enumeration has no residual subject") }
    subject = states[value.index].output
  }
  if subject.index >= List<Prepared.Shape>.length(&prepared.shapes) {
    return CompilerBug.panic(b"contract enumeration has no frozen subject shape")
  }
  return subject
}

fn opaqueContractSubject<'body>(prepared: &SourcePreparation<'body>, selection: &Prepared.ContractSelection) -> bool {
  let subject = contractSubject(prepared, selection)
  return match &List<Prepared.Shape>.asSlice(&prepared.shapes)[subject.index].state {
    PreparedShapeState.Opaque => true
    PreparedShapeState.Unavailable {..} => true
    _ => false
  }
}

fn validateContractPath<'body>(prepared: &SourcePreparation<'body>, continuation: &Prepared.ContractContinuation) -> () {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let rows = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  if continuation.projection.index >= projections.length || continuation.originalSelection.index >= rows.length
    || continuation.outputState.index >= states.length {
    CompilerBug.panic(b"contract continuation has an absent authority or output")
  }
  let projection = &projections[continuation.projection.index]
  let row = &rows[continuation.originalSelection.index]
  let output = &states[continuation.outputState.index]
  if !authoredResidual(output) || continuation.original.index != projection.original.index
    || row.application.index != projection.application.index || row.output.index != continuation.original.index {
    CompilerBug.panic(b"contract continuation changed its exact original enumeration")
  }
  let path = List<Prepared.ResidualStateId>.asSlice(&continuation.originalPath)
  let mut terminal = usize.MAX
  if let Option<Prepared.ResidualStateId>.Some {value} = &continuation.originalState { terminal = value.index }
  if terminal != usize.MAX && (path.length == usize.ZERO || path[path.length - usize.ONE].index != terminal) {
    CompilerBug.panic(b"contract terminal is not the end of its original path")
  }
  let mut step = usize.ZERO
  while step < path.length {
    if path[step].index >= states.length { CompilerBug.panic(b"contract original path has an absent component") }
    let state = &states[path[step].index]
    let isTerminal = terminal == path[step].index && step + usize.ONE == path.length
    let exact = match state.authority {
      PreparedResidualAuthority.Contract {projection: actual, terminal: category} =>
        actual.index == continuation.projection.index && category == isTerminal
      _ => false
    }
    if !exact || state.selection.index != output.selection.index || state.vertex.index != output.vertex.index
      || (isTerminal && state.accepts != output.accepts) || (!isTerminal && state.accepts) {
      CompilerBug.panic(b"contract original path changed projection, role or authored history")
    }
    if step != usize.ZERO {
      let previous = &states[path[step - usize.ONE].index]
      if previous.output.index != state.input.shape.index
        || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&previous.next), path[step]) {
        CompilerBug.panic(b"contract original path is not an explicit contiguous component chain")
      }
    }
    step = step + usize.ONE
  }
  if path.length != usize.ZERO {
    let last = Option<Prepared.ResidualStateId>.some(path[path.length - usize.ONE])
    if !sameOptionalResidual(&row.residual, &last) {
      CompilerBug.panic(b"contract enumeration lost the exact original path subject")
    }
  }
  if terminal == usize.MAX {
    let incomplete = match &row.coverage { PreparedContractCoverage.Incomplete {..} => true _ => false }
    if !opaqueContractSubject(prepared, row) || !incomplete {
      CompilerBug.panic(b"projected-only suffix strengthened its original opaque subject")
    }
  }
  return ()
}

// A continuation can have several original paths for one output successor. Check coverage
// rather than a bijection: coalescing does not erase any original contributor. Opaque children
// inherit their parent's exact row, not an unrelated root or an independently applied row.
fn validateContractNext<'body>(prepared: &SourcePreparation<'body>, parent: &Prepared.ContractContinuation) -> () {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let output = &states[parent.outputState.index]
  let outputNext = List<Prepared.ResidualStateId>.asSlice(&output.next)
  let next = List<Prepared.ContractContinuationId>.asSlice(&parent.next)
  let mut each = usize.ZERO
  while each < next.length {
    if next[each].index >= continuations.length { CompilerBug.panic(b"contract continuation has an absent paired successor") }
    let child = &continuations[next[each].index]
    if child.projection.index != parent.projection.index || child.original.index != parent.original.index
      || !containsResidual(outputNext, child.outputState) {
      CompilerBug.panic(b"contract continuation changed its projection or authored successor")
    }
    let path = List<Prepared.ResidualStateId>.asSlice(&child.originalPath)
    match &parent.originalState {
      Option<Prepared.ResidualStateId>.Some {value} => {
        if path.length != usize.ZERO {
          if path[usize.ZERO].index >= states.length
            || states[path[usize.ZERO].index].input.shape.index != states[value.index].output.index
            || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[value.index].next), path[usize.ZERO]) {
            CompilerBug.panic(b"contract successor lost its original predecessor component")
          }
        } else if child.originalSelection.index != parent.originalSelection.index {
          CompilerBug.panic(b"opaque contract successor replaced its inherited original row")
        }
      }
      Option<Prepared.ResidualStateId>.None => {
        if path.length != usize.ZERO || child.originalSelection.index != parent.originalSelection.index {
          CompilerBug.panic(b"opaque contract suffix manufactured a new original component")
        }
      }
    }
    let mut prior = usize.ZERO
    while prior < each {
      if next[prior].index == next[each].index { CompilerBug.panic(b"contract successor duplicated an identical paired path") }
      prior = prior + usize.ONE
    }
    each = each + usize.ONE
  }
  each = usize.ZERO
  while each < outputNext.length {
    let mut covered = false
    let mut pair = usize.ZERO
    while pair < next.length {
      if continuations[next[pair].index].outputState.index == outputNext[each].index { covered = true }
      pair = pair + usize.ONE
    }
    if !covered { CompilerBug.panic(b"contract continuation omitted an authored output successor") }
    each = each + usize.ONE
  }
  return ()
}

// Explicit membership authorizes actual producer-channel projections. A Body endpoint or
// equal output shape alone cannot relax the original application's projection domain.
fn producerProjectionChannel<'body>(prepared: &SourcePreparation<'body>, projection: usize) -> Option<usize> {
  let channels = List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)
  let mut found = Option<usize>.none()
  let mut channel = usize.ZERO
  while channel < channels.length {
    let rows = List<Prepared.ContractProjectionId>.asSlice(&channels[channel].projections)
    let mut at = usize.ZERO
    while at < rows.length {
      if rows[at].index == projection {
        if let Option<usize>.Some {..} = found { return CompilerBug.panic(b"producer projection has duplicate channel owners") }
        found = Option<usize>.some(channel)
      }
      at = at + usize.ONE
    }
    channel = channel + usize.ONE
  }
  return found
}

// Root channel cursors pair the same authored request across an actual whole-descriptor
// transport. No physical admission, substitution, source or accepting rule is emitted here.

fn invocationProjectionChannel<'body>(prepared: &SourcePreparation<'body>, projection: usize) -> Option<usize> {
  let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
  let mut found = Option<usize>.none()
  let mut at = usize.ZERO
  while at < channels.length {
    let rows = List<Prepared.ContractProjectionId>.asSlice(&channels[at].receiverProjections)
    let mut each = usize.ZERO
    while each < rows.length {
      if rows[each].index == projection {
        if let Option<usize>.Some {..} = found { return CompilerBug.panic(b"receiver projection has duplicate invocation authority") }
        found = Option<usize>.some(at)
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return found
}

fn validateInvocationChannels<'body>(prepared: &SourcePreparation<'body>) -> () {
  let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
  let operations = List<Prepared.Operation>.asSlice(&prepared.operations)
  let applications = List<Prepared.Application>.asSlice(&prepared.applications)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let mut at = usize.ZERO
  while at < channels.length {
    let channel = &channels[at]
    if channel.operation >= operations.length || channel.application.index >= applications.length
      || channel.selection.index >= selections.length || channel.map.index >= maps.length {
      CompilerBug.panic(b"invocation channel is outside its exact operation/application domain")
    }
    let operation = &operations[channel.operation]
    let application = &applications[channel.application.index]
    let selected = &selections[channel.selection.index]
    let map = &maps[channel.map.index]
    let receiver = match operation.receiver { Option<EndpointId>.Some {value} => value
      _ => { return CompilerBug.panic(b"invocation channel lost its actual receiver") } }
    let result = match operation.result { Option<MapId>.Some {value} => value
      _ => { return CompilerBug.panic(b"invocation channel lost its independent finalized result map") } }
    let applied = match operation.application { Option<ApplicationId>.Some {value} => value.index == channel.application.index _ => false }
    let owned = match map.application { Option<ApplicationId>.Some {value} => value.index == channel.application.index _ => false }
    let callable = match &prepared.body.nodes[operation.site.index].kind {
      NodeKind.Expression {form: Expression.CallableCall {constructs, ..}, ..} if !constructs => true _ => false
    }
    let mut opening = false
    if let PreparedTarget.Callable {inference, contract} = &application.target {
      let identity = DeclarationId.copyShared(&application.owner)
      let count = Shared<Type>.with<usize>(&contract, fn(value: &Type) -> usize {
        return match &value.* { Type.Callable {invocationBinders, ..} => invocationBinders
          _ => CompilerBug.panic(b"invocation opening has no retained Callable contract") }
      })
      let actual = match &application.inference {
        Option<Shared<SourceInference>>.Some {value} => Shared<SourceInference>.with<DeclarationId>(&value,
          fn(source: &SourceInference) -> DeclarationId { return DeclarationId.copyShared(&source.owner) })
        _ => { return CompilerBug.panic(b"invocation opening omitted its actual fresh inference owner") }
      }
      opening = DeclarationId.equals(&DeclarationId.copyShared(&inference), &identity) && DeclarationId.equals(&actual, &identity)
      let parameters = List<Shared<Lifetime>>.asSlice(&application.lifetimeParameters)
      if parameters.length != count { CompilerBug.panic(b"invocation opening changed its complete lifetime domain") }
      let mut parameter = usize.ZERO
      while parameter < parameters.length {
        let owner = Shared<Lifetime>.with<DeclarationId>(&parameters[parameter], fn(value: &Lifetime) -> DeclarationId {
          return match &value.* { Lifetime.Parameter {declaration, ..} => DeclarationId.copy(&declaration)
            _ => CompilerBug.panic(b"invocation opening replaced an original parameter handle") }
        })
        let ordinal = Shared<Lifetime>.with<usize>(&parameters[parameter], fn(value: &Lifetime) -> usize {
          return match &value.* { Lifetime.Parameter {ordinal, ..} => ordinal
            _ => CompilerBug.panic(b"invocation opening replaced an original parameter ordinal") }
        })
        if !DeclarationId.equals(&owner, &identity) || ordinal != parameter { CompilerBug.panic(b"invocation opening mixed fresh owner or parameter domains") }
        parameter = parameter + usize.ONE
      }
    }
    if let PreparedTarget.Direct {..} = &application.target {
      if let Option<Shared<OutputTransform>>.Some {..} = &application.schemaOutput { opening = true }
    }
    if !callable || !opening || application.constructs || !applied || !owned || operation.phase != PreparedOperationPhase.Invoke
      || application.site.index != operation.site.index || selected.site.index != operation.site.index || selected.root.index != receiver.index
      || map.site.index != operation.site.index || map.kind != MapKind.Contract || map.componentTransport || map.addressTransport
      || !sameSelector(&map.selector, &Selector.Identity) || map.target.index != maps[result.index].target.index {
      CompilerBug.panic(b"invocation channel changed its actual opening, selection or finalized result bridge")
    }
    if List<Prepared.BoundaryTransitionId>.length(&map.boundaries) != usize.ZERO || List<Prepared.BoundaryStop>.length(&map.channelStops) != usize.ZERO {
      CompilerBug.panic(b"invocation channel acquired physical descriptor transport authority")
    }
    let source = &endpoints[map.source.index]
    let child = match source.parent { Option<EndpointId>.Some {value} => value.index == receiver.index _ => false }
    if !child || !sameSelector(&source.selector, &Selector.CallableResult) {
      CompilerBug.panic(b"invocation receiver channel is not its actual CallableResult")
    }
    let selectors = List<MapId>.asSlice(&selected.maps)
    let mut root = false
    let mut each = usize.ZERO
    while each < selectors.length {
      let edge = &maps[selectors[each].index]
      if edge.source.index == receiver.index && edge.target.index == map.source.index && edge.site.index == operation.site.index
        && edge.kind == MapKind.Select && sameSelector(&edge.selector, &Selector.CallableResult) { root = true }
      each = each + usize.ONE
    }
    if !root { CompilerBug.panic(b"invocation channel lost its exact receiver selection edge") }
    // Full membership, not list-position pairing: normalized projection alternatives keep
    // their original IDs in both independently retained lists.
    let receiverRows = List<Prepared.ContractProjectionId>.asSlice(&channel.receiverProjections)
    let resultRows = List<Prepared.ContractProjectionId>.asSlice(&channel.resultProjections)
    if receiverRows.length == usize.ZERO || resultRows.length == usize.ZERO { CompilerBug.panic(b"invocation channel lost an original projection family") }
    let mut projection = usize.ZERO
    while projection < projections.length {
      let row = &projections[projection]
      let originalResult = match &endpoints[row.original.index].root {
        Root.Application {application: actual, port: contractPort, ordinal, space: typeSpace} if contractPort == PreparedContractPort.Result && typeSpace == PreparedTypeSpace.Original =>
          actual.index == channel.application.index && ordinal == usize.ZERO
        _ => false
      }
      let expectedReceiver = row.application.index == channel.application.index && row.stage == PreparedContractProjectionStage.OriginalToReceiver
        && componentWithin(endpoints, row.output, map.source)
      let expectedResult = row.application.index == channel.application.index && row.stage == PreparedContractProjectionStage.OriginalToApplied
        && match &endpoints[row.output.index].root {
          Root.Application {application: actual, port: contractPort, ordinal, space: typeSpace} if contractPort == PreparedContractPort.Result && typeSpace == PreparedTypeSpace.Applied =>
            actual.index == channel.application.index && ordinal == usize.ZERO
          _ => false
        }
      let mut receiverCount = usize.ZERO
      let mut resultCount = usize.ZERO
      each = usize.ZERO
      while each < receiverRows.length { if receiverRows[each].index == projection { receiverCount = receiverCount + usize.ONE } each = each + usize.ONE }
      each = usize.ZERO
      while each < resultRows.length { if resultRows[each].index == projection { resultCount = resultCount + usize.ONE } each = each + usize.ONE }
      if receiverCount > usize.ONE || resultCount > usize.ONE || (receiverCount == usize.ONE) != expectedReceiver
        || (resultCount == usize.ONE) != expectedResult || ((expectedReceiver || expectedResult) && !originalResult) {
        CompilerBug.panic(b"invocation channel dropped or substituted an original projection contributor")
      }
      projection = projection + usize.ONE
    }
    each = usize.ZERO
    while each < receiverRows.length {
      if receiverRows[each].index >= projections.length { CompilerBug.panic(b"invocation channel has an absent receiver projection") }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < resultRows.length {
      if resultRows[each].index >= projections.length { CompilerBug.panic(b"invocation channel has an absent result projection") }
      each = each + usize.ONE
    }
    each = usize.ZERO
    while each < at { if channels[each].operation == channel.operation { CompilerBug.panic(b"actual invocation has duplicate receiver channels") } each = each + usize.ONE }
    at = at + usize.ONE
  }
  return ()
}

fn validateRootChannelStops<'body>(prepared: &SourcePreparation<'body>) -> () {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let mut map = usize.ZERO
  while map < maps.length {
    let row = &maps[map]
    let stops = List<Prepared.BoundaryStop>.asSlice(&row.channelStops)
    let mut at = usize.ZERO
    while at < stops.length {
      if row.source.index >= endpoints.length || row.target.index >= endpoints.length
        || !row.componentTransport || row.addressTransport
        || (row.kind != MapKind.Copy && row.kind != MapKind.Place)
        || !sameSelector(&row.selector, &Selector.Identity) {
        CompilerBug.panic(b"root channel cursor is not an actual whole-descriptor transport")
      }
      if let Option<ApplicationId>.Some {..} = row.application { CompilerBug.panic(b"root channel cursor substituted contract authority") }
      let stop = &stops[at]
      if stop.sourceState.index >= states.length || stop.targetState.index >= states.length {
        CompilerBug.panic(b"root channel cursor has an absent authored state")
      }
      let source = &states[stop.sourceState.index]
      let target = &states[stop.targetState.index]
      if !authoredResidual(source) || !authoredResidual(target)
        || source.input.shape.index != endpoints[row.source.index].shape.index
        || target.input.shape.index != endpoints[row.target.index].shape.index
        || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
        || source.accepts != target.accepts {
        CompilerBug.panic(b"root channel cursor changed its paired actual parents or requested suffix")
      }
      let left = residualComponent(shapes, source.input)
      let right = residualComponent(shapes, target.input)
      if !channelSelector(&left.selector) || !sameSelector(&left.selector, &right.selector)
        || left.inline || right.inline {
        CompilerBug.panic(b"root channel cursor was reclassified as physical contents")
      }
      let mut earlier = usize.ZERO
      while earlier < at {
        if stops[earlier].targetState.index == stop.targetState.index {
          CompilerBug.panic(b"root channel transport duplicated an authored target interpretation")
        }
        earlier = earlier + usize.ONE
      }
      at = at + usize.ONE
    }
    map = map + usize.ONE
  }
  return ()
}

// A channel output lift is paired syntax, never a physical boundary or a source proof.
// Keep entry in the key: equal input shapes cannot promote an internal cursor to a root.
fn channelPrefixPath<'body>(prepared: &SourcePreparation<'body>, root: Prepared.ChannelLiftId,
  current: Prepared.ChannelLiftId, remaining: usize) -> bool {
  if remaining == usize.ZERO { return false }
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  if root.index >= lifts.length || current.index >= lifts.length { return false }
  let row = &lifts[root.index]
  let target = &lifts[current.index]
  if let PreparedChannelLiftOrigin.Projection {..} = row.origin { return false }
  if !sameContentsChannelOrigin(row.origin, target.origin) || row.map.index != target.map.index
    || row.channel.sourceState.index != target.channel.sourceState.index || row.channel.targetState.index != target.channel.targetState.index { return false }
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  if row.sourceState.index >= states.length || row.targetState.index >= states.length { return false }
  if !residualComponent(shapes, states[row.sourceState.index].input).inline
    || !residualComponent(shapes, states[row.targetState.index].input).inline { return false }
  if root.index == current.index { return true }
  let next = List<Prepared.ChannelLiftId>.asSlice(&row.next)
  let mut at = usize.ZERO
  while at < next.length {
    if channelPrefixPath(prepared, next[at], current, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

fn validateChannelLifts<'body>(prepared: &SourcePreparation<'body>) -> () {
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let mut at = usize.ZERO
  while at < lifts.length {
    let lift = &lifts[at]
    if lift.map.index >= maps.length || lift.channel.sourceState.index >= states.length
      || lift.channel.targetState.index >= states.length || lift.sourceState.index >= states.length
      || lift.targetState.index >= states.length {
      CompilerBug.panic(b"channel output lift is outside its frozen domain")
    }
    let mut sourceParent = lift.channel.sourceState
    let mut targetParent = lift.channel.targetState
    match lift.origin {
      PreparedChannelLiftOrigin.Projection {projection, prefixRoot, prefixCurrent} => {
        let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
        if projection.index >= projections.length || prefixRoot.index >= lifts.length || prefixCurrent.index >= lifts.length {
          CompilerBug.panic(b"projection channel lift is outside its frozen prefix domain")
        }
        let first = &lifts[prefixRoot.index]
        let last = &lifts[prefixCurrent.index]
        if !first.entry || !channelPrefixPath(prepared, prefixRoot, prefixCurrent, lifts.length)
          || first.map.index != lift.map.index || first.channel.sourceState.index != lift.channel.sourceState.index
          || first.channel.targetState.index != lift.channel.targetState.index {
          CompilerBug.panic(b"projection channel lift replaced its original bounded inline cursor")
        }
        let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
        let mut bound = false
        let mut channel = usize.ZERO
        while channel < channels.length {
          if Results.receiverPrefix(prepared, channel, projection, first.targetState, last.targetState) { bound = true }
          channel = channel + usize.ONE
        }
        if !bound { CompilerBug.panic(b"projection channel lift lost its exact original A receiver prefix") }
        sourceParent = last.sourceState
        targetParent = last.targetState
        if lift.entry {
          let roots = List<Prepared.ContractContinuationId>.asSlice(&projections[projection.index].continuations)
          let rows = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
          let mut retained = false
          let mut root = usize.ZERO
          while root < roots.length {
            let row = &rows[roots[root].index]
            let original = &states[row.outputState.index]
            if row.projection.index == projection.index && original.selection.index == states[lift.targetState.index].selection.index
              && original.vertex.index == states[lift.targetState.index].vertex.index { retained = true }
            root = root + usize.ONE
          }
          if !retained { CompilerBug.panic(b"projection relative entry lost its independent continuation history") }
        }
      }
      PreparedChannelLiftOrigin.Root => {
        let stops = List<Prepared.BoundaryStop>.asSlice(&maps[lift.map.index].channelStops)
        let mut found = false
        let mut stop = usize.ZERO
        while stop < stops.length {
          if stops[stop].sourceState.index == lift.channel.sourceState.index
            && stops[stop].targetState.index == lift.channel.targetState.index {
            if found { CompilerBug.panic(b"channel output lift has duplicate root authority") }
            found = true
          }
          stop = stop + usize.ONE
        }
        if !found { CompilerBug.panic(b"channel output lift has no exact descriptor channel stop") }
      }
      PreparedChannelLiftOrigin.Boundary {lift: id} => {
        let rows = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
        let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
        if id >= rows.length || rows[id].boundary.index >= boundaries.length {
          CompilerBug.panic(b"channel output lift lost its exact prior output anchor")
        }
        let prior = &boundaries[rows[id].boundary.index]
        let exact = match &rows[id].step {
          PreparedBoundaryLiftStep.Stop {sourceState, targetState} => sourceState.index == lift.channel.sourceState.index
            && targetState.index == lift.channel.targetState.index
          _ => false
        }
        if !exact || prior.map.index != lift.map.index {
          CompilerBug.panic(b"channel output lift substituted a root stop or prior boundary")
        }
        if rows[id].direction == PreparedBoundaryLiftDirection.StorageAliasInverse
          && prior.authority != PreparedBoundaryAuthority.StorageAlias {
          CompilerBug.panic(b"channel output lift invented inverse storage authority")
        }
        if rows[id].direction == PreparedBoundaryLiftDirection.OriginInverse
          && prior.authority != PreparedBoundaryAuthority.Physical {
          CompilerBug.panic(b"channel output lift lost its original Origin direction")
        }
      }
    }
    let source = &states[lift.sourceState.index]
    let target = &states[lift.targetState.index]
    if !authoredResidual(source) || !authoredResidual(target)
      || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
      || source.accepts != target.accepts {
      CompilerBug.panic(b"channel output lift changed its paired authored history")
    }
    let left = residualComponent(shapes, source.input)
    let right = residualComponent(shapes, target.input)
    if !sameSelector(&left.selector, &right.selector) {
      CompilerBug.panic(b"channel output lift cross-paired component selectors")
    }
    if lift.entry && (source.input.shape.index != states[sourceParent.index].output.index
      || target.input.shape.index != states[targetParent.index].output.index) {
      CompilerBug.panic(b"channel output lift entry lost its exact channel output anchors")
    }
    let sourceNext = List<Prepared.ResidualStateId>.asSlice(&source.next)
    let targetNext = List<Prepared.ResidualStateId>.asSlice(&target.next)
    let next = List<Prepared.ChannelLiftId>.asSlice(&lift.next)
    if next.length != sourceNext.length || next.length != targetNext.length {
      CompilerBug.panic(b"channel output lift omitted or multiplied a paired successor")
    }
    let mut each = usize.ZERO
    while each < next.length {
      if next[each].index >= lifts.length { CompilerBug.panic(b"channel output lift has an absent successor") }
      let child = &lifts[next[each].index]
      if child.map.index != lift.map.index || !sameContentsChannelOrigin(child.origin, lift.origin) || child.entry
        || child.channel.sourceState.index != lift.channel.sourceState.index
        || child.channel.targetState.index != lift.channel.targetState.index
        || !containsResidual(sourceNext, child.sourceState) || !containsResidual(targetNext, child.targetState) {
        CompilerBug.panic(b"channel output lift successor lost its exact paired parent")
      }
      if child.sourceState.index >= states.length || child.targetState.index >= states.length {
        CompilerBug.panic(b"channel output lift successor has absent residual states")
      }
      if states[child.sourceState.index].input.shape.index != source.output.index
        || states[child.targetState.index].input.shape.index != target.output.index {
        CompilerBug.panic(b"channel output lift successor changed its paired output anchors")
      }
      let mut earlier = usize.ZERO
      while earlier < each {
        let prior = &lifts[next[earlier].index]
        if prior.sourceState.index == child.sourceState.index || prior.targetState.index == child.targetState.index {
          CompilerBug.panic(b"channel output lift duplicated one side of a successor")
        }
        earlier = earlier + usize.ONE
      }
      each = each + usize.ONE
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      let prior = &lifts[earlier]
      let mut sameRequested = prior.targetState.index == lift.targetState.index
      let originalOrigin = match lift.origin {
        PreparedChannelLiftOrigin.Projection {prefixRoot, ..} => lifts[prefixRoot.index].origin
        _ => lift.origin
      }
      if let PreparedChannelLiftOrigin.Boundary {lift: id} = originalOrigin {
        if List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)[id].direction != PreparedBoundaryLiftDirection.Forward {
          sameRequested = prior.sourceState.index == lift.sourceState.index
        }
      }
      if prior.map.index == lift.map.index && sameContentsChannelOrigin(prior.origin, lift.origin) && prior.entry == lift.entry
        && prior.channel.sourceState.index == lift.channel.sourceState.index
        && prior.channel.targetState.index == lift.channel.targetState.index
        && sameRequested {
        CompilerBug.panic(b"channel output lift duplicated one requested interpretation")
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn validateContractProducts<'body>(prepared: &SourcePreparation<'body>) -> () {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let applications = List<Prepared.Application>.asSlice(&prepared.applications)
  let rows = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let routes = List<ContractRoute>.asSlice(&prepared.routes)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = &rows[at]
    if row.application.index >= applications.length
      || !contractEndpoint(endpoints, row.output, row.application, PreparedTypeSpace.Original) {
      CompilerBug.panic(b"contract enumeration used a nonoriginal application output")
    }
    drop contractSubject(prepared, row)
    if let Option<Prepared.ResidualStateId>.Some {value} = &row.residual {
      let projection = match states[value.index].authority {
        PreparedResidualAuthority.Contract {projection, ..} => projection
        _ => { return CompilerBug.panic(b"original contract enumeration used an authored output subject") }
      }
      if projections[projection.index].application.index != row.application.index
        || projections[projection.index].original.index != row.output.index {
        CompilerBug.panic(b"contract enumeration residual changed its original application or ancestor")
      }
    }
    let selected = List<ContractRouteId>.asSlice(&row.routes)
    let mut each = usize.ZERO
    while each < selected.length {
      if selected[each].index >= routes.length { CompilerBug.panic(b"contract enumeration names an absent original route") }
      let route = &routes[selected[each].index]
      if route.application.index != row.application.index || route.target.index != row.output.index
        || !sameOptionalResidual(&route.targetResidual, &row.residual)
        || !contractEndpoint(endpoints, route.source, row.application, PreparedTypeSpace.Original) {
        CompilerBug.panic(b"contract route changed the enumeration's original subject")
      }
      let links = List<MapId>.asSlice(&route.maps)
      let mut linked = false
      let mut link = usize.ZERO
      while link < links.length {
        if links[link].index >= maps.length { CompilerBug.panic(b"original contract route has an absent map") }
        let map = &maps[links[link].index]
        let exact = match &map.application { Option<ApplicationId>.Some {value} => value.index == row.application.index _ => false }
        if !exact || map.kind != MapKind.Contract || map.componentTransport || map.addressTransport
          || map.source.index >= endpoints.length || map.target.index >= endpoints.length {
          CompilerBug.panic(b"original contract route lost its exclusive application map")
        }
        if map.source.index == route.source.index && map.target.index == route.target.index { linked = true }
        link = link + usize.ONE
      }
      if !linked { CompilerBug.panic(b"original contract route lost its endpoint correspondence") }
      let premises = List<Prepared.PredicateId>.asSlice(&route.premises)
      let declared = List<Prepared.PredicateId>.asSlice(&applications[row.application.index].premises)
      let mut premise = usize.ZERO
      while premise < premises.length {
        let mut admitted = false
        let mut index = usize.ZERO
        while index < declared.length {
          if declared[index].index == premises[premise].index { admitted = true }
          index = index + usize.ONE
        }
        if !admitted || premises[premise].index >= List<Prepared.Predicate>.length(&prepared.predicates) {
          CompilerBug.panic(b"contract route substituted a foreign original premise")
        }
        premise = premise + usize.ONE
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < projections.length {
    let projection = &projections[at]
    let mut space = PreparedTypeSpace.Applied
    if projection.stage == PreparedContractProjectionStage.OriginalToSelected { space = PreparedTypeSpace.Selected }
    let producer = producerProjectionChannel(prepared, at)
    let invocation = invocationProjectionChannel(prepared, at)
    if projection.stage == PreparedContractProjectionStage.OriginalToReceiver {
      if let Option<usize>.None = invocation {
        let channel = match producer { Option<usize>.Some {value} => value
          _ => { return CompilerBug.panic(b"receiver projection has no exact invocation or schema producer membership") } }
        let actual = &List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)[channel]
        if let Option<Shared<OutputTransform>>.None = &applications[actual.application.index].schemaOutput {
          CompilerBug.panic(b"producer receiver projection has no retained schema output authority")
        }
      }
    } else if let Option<usize>.Some {..} = invocation { CompilerBug.panic(b"invocation receiver substituted another projection stage") }
    let mut actualOutput = false
    match invocation {
      Option<usize>.Some {value} => {
        let channel = &List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)[value]
        actualOutput = projection.output.index < endpoints.length && channel.application.index == projection.application.index
          && componentWithin(endpoints, projection.output, maps[channel.map.index].source)
      }
      Option<usize>.None => match producer {
      Option<usize>.Some {value} => {
        let channel = &List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)[value]
        actualOutput = projection.output.index < endpoints.length && channel.application.index == projection.application.index
          && componentWithin(endpoints, projection.output, maps[channel.map.index].target)
      }
      Option<usize>.None => { actualOutput = contractEndpoint(endpoints, projection.output, projection.application, space) }
      }
    }
    if projection.application.index >= applications.length
      || !contractEndpoint(endpoints, projection.original, projection.application, PreparedTypeSpace.Original)
      || !actualOutput {
      CompilerBug.panic(b"contract projection changed its original or selected application domain")
    }
    let suffix = List<EndpointId>.asSlice(&projection.suffix)
    let mut suffixAt = usize.ZERO
    while suffixAt < suffix.length {
      let mut exact = false
      match invocation {
        Option<usize>.Some {value} => {
          let channel = &List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)[value]
          exact = suffix[suffixAt].index < endpoints.length && componentWithin(endpoints, suffix[suffixAt], maps[channel.map.index].source)
        }
        Option<usize>.None => match producer {
        Option<usize>.Some {value} => {
          let channel = &List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)[value]
          exact = suffix[suffixAt].index < endpoints.length && componentWithin(endpoints, suffix[suffixAt], maps[channel.map.index].target)
        }
        Option<usize>.None => { exact = contractEndpoint(endpoints, suffix[suffixAt], projection.application, space) }
        }
      }
      if !exact { CompilerBug.panic(b"contract projection suffix changed its selected domain") }
      if suffixAt != usize.ZERO {
        let contiguous = match &endpoints[suffix[suffixAt].index].parent {
          Option<EndpointId>.Some {value} => value.index == suffix[suffixAt - usize.ONE].index
          _ => false
        }
        if !contiguous { CompilerBug.panic(b"contract projection suffix lost its explicit endpoint chain") }
      }
      suffixAt = suffixAt + usize.ONE
    }
    if suffix.length != usize.ZERO && suffix[suffix.length - usize.ONE].index != projection.output.index {
      CompilerBug.panic(b"contract projection suffix does not end at its output")
    }
    let physical = List<MapId>.asSlice(&projection.maps)
    let mut anchored = false
    let mut each = usize.ZERO
    while each < physical.length {
      if physical[each].index >= maps.length { CompilerBug.panic(b"contract projection names an absent map") }
      let map = &maps[physical[each].index]
      let exact = match &map.application { Option<ApplicationId>.Some {value} => value.index == projection.application.index _ => false }
      if !exact || map.kind != MapKind.Contract || map.componentTransport || map.addressTransport
        || map.source.index >= endpoints.length || map.target.index >= endpoints.length {
        CompilerBug.panic(b"contract projection has no exclusive application authority")
      }
      if map.source.index == projection.original.index && map.target.index == projection.output.index { anchored = true }
      each = each + usize.ONE
    }
    if !anchored { CompilerBug.panic(b"contract projection lost its exact endpoint pair") }
    let roots = List<Prepared.ContractContinuationId>.asSlice(&projection.continuations)
    each = usize.ZERO
    while each < roots.length {
      if roots[each].index >= continuations.length { CompilerBug.panic(b"contract projection has an absent continuation root") }
      let root = &continuations[roots[each].index]
      if root.projection.index != at || root.outputState.index >= states.length
        || states[root.outputState.index].input.shape.index != endpoints[projection.output.index].shape.index {
        CompilerBug.panic(b"contract continuation root changed its projected subject")
      }
      let path = List<Prepared.ResidualStateId>.asSlice(&root.originalPath)
      if path.length != usize.ZERO {
        if path[usize.ZERO].index >= states.length
          || states[path[usize.ZERO].index].input.shape.index != endpoints[projection.original.index].shape.index {
          CompilerBug.panic(b"contract continuation root changed its original subject")
        }
      } else {
        if root.originalSelection.index >= rows.length { CompilerBug.panic(b"contract root has no original enumeration") }
        if let Option<Prepared.ResidualStateId>.Some {..} = &rows[root.originalSelection.index].residual {
          CompilerBug.panic(b"nonadvancing contract root inherited an unrelated residual row")
        }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < continuations.length {
    validateContractPath(prepared, &continuations[at])
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < continuations.length {
    validateContractNext(prepared, &continuations[at])
    at = at + usize.ONE
  }
  return ()
}

// Reference construction is the sole authority for linking a Borrow leaf to physical
// operand storage. Equal reference types or equal regions cannot construct this record.
fn validateReferenceOrigins<'body>(prepared: &SourcePreparation<'body>, origins: &[ReferenceOrigin],
  evaluations: &[Evaluation], values: &[Value], leaves: &[Leaf]) -> () {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut at = usize.ZERO
  while at < origins.length {
    let origin = &origins[at]
    if origin.source.index >= evaluations.length || origin.descriptor.index >= values.length
      || origin.leaf.index >= leaves.length { CompilerBug.panic(b"reference origin lost its actual value occurrence") }
    validateReferenceMaps(endpoints, maps, origin.map, origin.referent)
    let descriptor = values[origin.descriptor.index]
    if descriptor.evaluation.index >= evaluations.length || descriptor.endpoint.index != maps[origin.map.index].target.index
      || leaves[origin.leaf.index].endpoint.index != descriptor.endpoint.index {
      CompilerBug.panic(b"reference origin lost its descriptor component")
    }
    let borrowed = match &leaves[origin.leaf.index].kind { SourceLeaf.Borrow {..} => true _ => false }
    if !borrowed { CompilerBug.panic(b"reference storage identity has no actual Borrow source") }
    let sourceNode = match evaluations[origin.source.index].site {
      EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"reference origin is not an actual operand evaluation") }
    }
    let source = match &endpoints[maps[origin.map.index].source.index].root {
      Root.Node {node, category} => node.index == sourceNode.index && category == EndpointRole.Storage
      _ => false
    }
    let target = match evaluations[descriptor.evaluation.index].site {
      EvaluationSite.Node {node} => node.index == maps[origin.map.index].site.index
      _ => false
    }
    if !source || !target { CompilerBug.panic(b"reference origin does not match its physical preparation site") }
    let mut earlier = usize.ZERO
    while earlier < at {
      if origins[earlier].leaf.index == origin.leaf.index || origins[earlier].descriptor.index == origin.descriptor.index {
        CompilerBug.panic(b"one reference descriptor acquired two independent storage origins")
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// A prepared Select is not sufficient: it must belong to the exact place occurrence's
// contiguous canonical address route. Referent/contract/value maps cannot be inverted here.
effect fn validateAliasGraph<'body>(prepared: &SourcePreparation<'body>, evaluations: &[Evaluation],
  aliases: &[StorageAlias], edges: &[AliasEdge], references: &[ReferenceOrigin], selections: &[SelectionUse], retained: &[DescriptorRequest],
  slices: &[SliceConversion], descriptors: &DescriptorClosure) -> () ! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let mut at = usize.ZERO
  while at < aliases.length {
    let node = &aliases[at]
    if node.evaluation.index >= evaluations.length || node.endpoint.index >= endpoints.length
      || node.storage.endpoint.index >= endpoints.length {
      CompilerBug.panic(b"address proof node lost its actual occurrence or canonical component")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      let other = &aliases[earlier]
      if other.evaluation.index == node.evaluation.index && other.endpoint.index == node.endpoint.index
        && sameStorage(other.storage, node.storage) && other.write == node.write {
        CompilerBug.panic(b"address proof duplicated one finite node")
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    if edge.target >= aliases.length { CompilerBug.panic(b"address proof edge has no target node") }
    let target = aliases[edge.target]
    let mut from = target.storage.endpoint
    let mut predecessor = target
    if let Option<usize>.Some {value: source} = edge.source {
      if source >= aliases.length { CompilerBug.panic(b"address proof edge has no predecessor node") }
      predecessor = aliases[source]
      if !sameStorage(predecessor.storage, target.storage)
        || (predecessor.write == Write.Weak && target.write != Write.Weak) {
        CompilerBug.panic(b"address projection changed its owner or strengthened an inexact address")
      }
      from = predecessor.endpoint
    }
    match edge.authority {
      AliasAuthority.Project {map: id} => {
        if id.index >= maps.length { CompilerBug.panic(b"address proof has no exact prepared projection") }
        let map = &maps[id.index]
        let sourceStorage = match endpointRole(&endpoints[map.source.index]) {
          Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
        }
        let targetStorage = match endpointRole(&endpoints[map.target.index]) {
          Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
        }
        let actual = match evaluations[target.evaluation.index].site {
          EvaluationSite.Node {node} => node.index == map.site.index _ => false
        }
        if !sourceStorage || !targetStorage || !actual || map.kind != MapKind.Select
          || map.source.index != from.index || map.target.index != target.endpoint.index {
          CompilerBug.panic(b"address projection substituted a value/contract or disconnected map")
        }
      }
      AliasAuthority.Selected {selection, map} => {
        if let Option<usize>.None = edge.source { CompilerBug.panic(b"selected address lost its grounded predecessor") }
        if selection >= selections.length || map.index >= maps.length {
          CompilerBug.panic(b"selected address has no actual selection or map")
        }
        let selected = &selections[selection]
        let physical = &maps[map.index]
        let root = match selected.place { Option<MapId>.Some {value} => value
          _ => { return CompilerBug.panic(b"selected address has no place output") } }
        let family = run transferFamily(endpoints, maps, root)
        let members = List<MapId>.asSlice(&family)
        let mut found = false
        let mut each = usize.ZERO
        while each < members.length { if members[each].index == map.index { found = true } each = each + usize.ONE }
        if !found || physical.kind != MapKind.Select || physical.source.index != from.index
          || physical.target.index != target.endpoint.index || selected.operand.index != predecessor.evaluation.index
          || selected.result.index != target.evaluation.index {
          CompilerBug.panic(b"selected address changed its actual selection/output correspondence")
        }
      }
      AliasAuthority.Origin {placement: id} => {
        let placements = List<OriginPlacement>.asSlice(&descriptors.placements)
        if id >= placements.length { CompilerBug.panic(b"origin address has no retained component proof") }
        let placement = placements[id]
        let proofs = List<OriginProof>.asSlice(&descriptors.origins)
        if placement.proof >= proofs.length || placement.sourceAlias >= aliases.length
          || placement.state.index >= states.length || placement.member.index >= maps.length {
          CompilerBug.panic(b"origin address lost one of its proof coordinates")
        }
        let proof = proofs[placement.proof]
        let carrier = CarriersProduct.nodes(&descriptors.product)[proof.carrier]
        let request = descriptorUse(prepared, selections, retained, slices, descriptors, carrier.demand)
        let reference = references[proof.origin]
        let member = &maps[placement.member.index]
        let state = &states[placement.state.index]
        let exactSource = match edge.source { Option<usize>.Some {value} => value == placement.sourceAlias _ => false }
        if !exactSource || predecessor.evaluation.index != reference.source.index
          || !sameSourceComponent(endpoints, predecessor.endpoint, member.source)
          || target.evaluation.index != request.operand.index || target.endpoint.index != state.vertex.index
          || state.selection.index != request.selection.index || state.output.index != endpoints[member.target.index].shape.index {
          CompilerBug.panic(b"origin address changed source acquisition or actual selected component")
        }
        match placement.parent {
          Option<usize>.None => {
            if placement.member.index != reference.referent.index || placement.state.index != carrier.state.index {
              CompilerBug.panic(b"origin root substituted another referent family")
            }
          }
          Option<usize>.Some {value} => {
            if value >= id { CompilerBug.panic(b"origin inline component has no finite earlier parent") }
            let parent = placements[value]
            let children = List<MapId>.asSlice(&maps[parent.member.index].children)
            let mut found = false
            let mut each = usize.ZERO
            while each < children.length { if children[each].index == placement.member.index { found = true } each = each + usize.ONE }
            if !found || parent.proof != placement.proof
              || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next), placement.state) {
              CompilerBug.panic(b"origin component did not follow both exact family/selector edges")
            }
          }
        }
      }
      AliasAuthority.Slice {placement: id} => {
        let placements = List<SlicePlacement>.asSlice(&descriptors.slicePlacements)
        if id >= placements.length { CompilerBug.panic(b"slice address has no retained element proof") }
        let placement = placements[id]
        let proofs = List<SliceProof>.asSlice(&descriptors.sliceProofs)
        let origins = List<OriginPlacement>.asSlice(&descriptors.placements)
        if placement.proof >= proofs.length || placement.origin >= origins.length || placement.edge >= edges.length
          || placement.state.index >= states.length || placement.member.index >= maps.length {
          CompilerBug.panic(b"slice address lost an exact proof coordinate")
        }
        let proof = proofs[placement.proof]
        if proof.conversion >= slices.length { CompilerBug.panic(b"slice proof has no actual conversion") }
        let conversion = slices[proof.conversion]
        let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
        let elements = List<Prepared.ArraySliceElement>.asSlice(&row.elements)
        if placement.element >= elements.length { CompilerBug.panic(b"slice proof invented an element partition") }
        let element = &elements[placement.element]
        let member = &maps[placement.member.index]
        let state = &states[placement.state.index]
        let retainedEdge = edges[placement.edge]
        let exactOrigin = match retainedEdge.authority {
          AliasAuthority.Origin {placement: origin} => origin == placement.origin
          _ => false
        }
        let exactSource = match edge.source { Option<usize>.Some {value} => value == retainedEdge.target _ => false }
        let origin = origins[placement.origin]
        let originProof = List<OriginProof>.asSlice(&descriptors.origins)[origin.proof]
        let sourceDemand = CarriersProduct.nodes(&descriptors.product)[originProof.carrier].demand
        let demands = List<SliceDemand>.asSlice(&descriptors.sliceDemands)
        let mut bound = false
        let mut each = usize.ZERO
        while each < demands.length {
          if demands[each].demand == sourceDemand && demands[each].proof == placement.proof
            && demands[each].element == placement.element { bound = true }
          each = each + usize.ONE
        }
        let carrier = CarriersProduct.nodes(&descriptors.product)[proof.carrier]
        let request = descriptorUse(prepared, selections, retained, slices, descriptors, carrier.demand)
        if !exactOrigin || !exactSource || !bound || predecessor.evaluation.index != conversion.source.index
          || predecessor.endpoint.index != member.source.index || target.evaluation.index != request.operand.index
          || target.endpoint.index != state.vertex.index || state.selection.index != request.selection.index
          || state.output.index != endpoints[member.target.index].shape.index
          || states[origin.state.index].selection.index != element.selection.index {
          CompilerBug.panic(b"slice address crossed conversion, element or actual descriptor histories")
        }
        let extent = match &prepared.body.nodes[row.site.index].kind {
          NodeKind.Expression {form: Expression.ArraySlice {count, ..}, ..} => count
          _ => { return CompilerBug.panic(b"slice address lost its actual extent") }
        }
        if extent == usize.ZERO || (extent != usize.ONE && target.write != Write.Weak) {
          CompilerBug.panic(b"slice address strengthened a multi-element or impossible selection")
        }
        match placement.parent {
          Option<usize>.None => {
            if placement.member.index != element.value.index || placement.state.index != carrier.state.index {
              CompilerBug.panic(b"slice root changed its explicit conversion element family")
            }
          }
          Option<usize>.Some {value} => {
            if value >= id { CompilerBug.panic(b"slice inline placement lost its finite parent") }
            let parent = placements[value]
            let sourceParent = match origin.parent {
              Option<usize>.Some {value: matchedOriginParent} => matchedOriginParent == parent.origin
              _ => false
            }
            let children = List<MapId>.asSlice(&maps[parent.member.index].children)
            let mut found = false
            each = usize.ZERO
            while each < children.length { if children[each].index == placement.member.index { found = true } each = each + usize.ONE }
            if !found || !sourceParent || origins[parent.origin].proof != origin.proof
              || parent.proof != placement.proof || parent.element != placement.element
              || !containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next), placement.state) {
              CompilerBug.panic(b"slice continuation did not follow both exact family and selector edges")
            }
          }
        }
      }
      AliasAuthority.Canonical => {
        if let Option<usize>.Some {..} = edge.source { CompilerBug.panic(b"canonical address seed cannot have a predecessor") }
        if target.endpoint.index != target.storage.endpoint.index {
          CompilerBug.panic(b"a canonical address seed cannot change physical components")
        }
        match target.storage.temporary {
          Option<EvalId>.Some {value} => {
            if value.index != target.evaluation.index { CompilerBug.panic(b"temporary address lost its acquisition identity") }
          }
          Option<EvalId>.None => CompilerBug.panic(b"local address seed requires its actual local-to-view map")
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Contents use a proof edge only inside one actual read/write's private address lane.
// This does not equate the descriptor's Value and Storage roles or create a new map.
fn validateAddressTransfer(values: &[Value], aliases: &[StorageAlias], edges: &[AliasEdge],
  requests: &[AliasTransport], source: ValueId, target: ValueId, id: usize, direction: MapDirection) -> () {
  if id >= edges.length { CompilerBug.panic(b"contents transfer has no composite address edge") }
  let edge = edges[id]
  let previous = match edge.source { Option<usize>.Some {value} => value
    _ => { return CompilerBug.panic(b"composite contents transfer has no address predecessor") } }
  match edge.authority {
    AliasAuthority.Selected {..} => ()
    AliasAuthority.Origin {..} => ()
    AliasAuthority.Slice {..} => ()
    _ => CompilerBug.panic(b"ordinary address map cannot impersonate a composite origin")
  }
  let mut before = values[source.index]
  let mut after = values[target.index]
  if direction == MapDirection.StorageInverse { before = values[target.index] after = values[source.index] }
  let left = match before.transport { Option<AliasPort>.Some {value} => value
    _ => { return CompilerBug.panic(b"composite current contents lost its private source lane") } }
  let right = match after.transport { Option<AliasPort>.Some {value} => value
    _ => { return CompilerBug.panic(b"composite current contents lost its private target lane") } }
  if left.request != right.request || left.alias != previous || right.alias != edge.target
    || left.request >= requests.length || before.evaluation.index != requests[left.request].evaluation.index
    || after.evaluation.index != before.evaluation.index || before.endpoint.index != aliases[previous].endpoint.index
    || after.endpoint.index != aliases[edge.target].endpoint.index {
    CompilerBug.panic(b"composite current contents crossed address histories or use points")
  }
  return ()
}

fn validateAliasPorts(values: &[Value], aliases: &[StorageAlias], requests: &[AliasTransport]) -> () {
  let mut at = usize.ZERO
  while at < values.length {
    let value = values[at]
    match value.transport {
      Option<AliasPort>.Some {value: port} => {
        if port.request >= requests.length || port.alias >= aliases.length {
          CompilerBug.panic(b"address transport port lost its exact use or proof node")
        }
        let request = requests[port.request]
        if request.alias >= aliases.length || value.phase != ValuePhase.Transport
          || value.evaluation.index != request.evaluation.index || value.endpoint.index != aliases[port.alias].endpoint.index
          || !sameStorage(aliases[port.alias].storage, aliases[request.alias].storage) {
          CompilerBug.panic(b"address transport port crossed uses or canonical owners")
        }
        if let Option<ResidualSubject>.Some {..} = value.subject {
          CompilerBug.panic(b"address transport cannot masquerade as a selected result")
        }
      }
      Option<AliasPort>.None => {
        if value.phase == ValuePhase.Transport { CompilerBug.panic(b"address transport has no proof identity") }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn validateAddressMap(endpoints: &[Endpoint], maps: &[SelectionMap], aliases: &[StorageAlias],
  edges: &[AliasEdge], map: MapId, address: EvalId) -> () {
  let physical = &maps[map.index]
  let source = match move endpointRole(&endpoints[physical.source.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
  let target = match move endpointRole(&endpoints[physical.target.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
  if physical.kind != MapKind.Select || !source || !target { CompilerBug.panic(b"value/contract boundary is not storage identity") }
  let mut at = usize.ZERO
  while at < edges.length {
    if let Option<MapId>.Some {value} = aliasMap(edges[at].authority) {
      if value.index == map.index && aliases[edges[at].target].evaluation.index == address.index { return () }
    }
    at = at + usize.ONE
  }
  CompilerBug.panic(b"source address transport has no actual alias edge")
}

effect fn reserveCell(keys: &mut List<CellKey>, cells: &mut List<Cell>, byValue: &mut List<List<usize>>,
  rules: &mut Program, key: CellKey) -> usize
! OutOfMemoryError ? &mut Allocator {
  while List<List<usize>>.length(&byValue.*) <= key.value.index {
    run List<List<usize>>.append(&mut byValue.*, List<usize>.make())
  }
  let rows = List<usize>.asSlice(&List<List<usize>>.asSlice(&byValue.*)[key.value.index])
  let candidates = List<CellKey>.asSlice(&keys.*)
  let mut row = usize.ZERO
  while row < rows.length {
    let index = rows[row]
    let previous = candidates[index]
    if previous.leaf.index == key.leaf.index && previous.witness == key.witness
      && previous.direct == key.direct && previous.category == key.category { return index }
    row = row + usize.ONE
  }
  let at = List<CellKey>.length(&keys.*)
  let present = Program.atom(&mut rules.*)
  let stored = Program.atom(&mut rules.*)
  let alternatives = Program.atom(&mut rules.*)
  run List<Cell>.append(&mut cells.*, Cell {present: present, stored: stored, alternatives: alternatives})
  run List<CellKey>.append(&mut keys.*, key)
  let indexed = List<List<usize>>.asMutSlice(&mut byValue.*)
  run List<usize>.append(&mut indexed[key.value.index], at)
  return at
}

/// A discharged descriptor seed still records the whole proof. Its source alias identifies
/// address formation; contents must subsequently be read at the demanding use, not here.
struct OriginProof {
  carrier: usize
  seed: usize
  origin: usize
  sourceAlias: usize
  active: Atom
}
impl Copy for OriginProof {}

// Actual conversions are occurrence-qualified. The descriptor transport creates no loan;
// these coordinates let a later Index demand stop at the exact conversion Case and ask
// for the original borrowed array's current address through its authored source history.
struct SliceConversion {
  prepared: usize
  source: EvalId
  descriptor: ValueId
}
impl Copy for SliceConversion {}
struct SliceProof {
  carrier: usize
  case: usize
  conversion: usize
  active: Atom
}
impl Copy for SliceProof {}
struct SliceDemand {
  demand: usize
  proof: usize
  element: usize
}
impl Copy for SliceDemand {}
struct SlicePlacement {
  proof: usize
  element: usize
  parent: Option<usize>
  origin: usize
  edge: usize
  member: MapId
  state: Prepared.ResidualStateId
}
impl Copy for SlicePlacement {}

struct DescriptorUse {
  operand: EvalId
  result: EvalId
  selection: PreparedSelectionId
  strength: Write
}
impl Copy for DescriptorUse {}

fn descriptorRequestedUse(selections: &[SelectionUse], retained: &[DescriptorRequest], selectionUse: usize) -> DescriptorUse {
  if selectionUse < selections.length {
    let selected = &selections[selectionUse]
    return DescriptorUse {operand: selected.operand, result: selected.result, selection: selected.selection, strength: selected.strength}
  }
  let index = selectionUse - selections.length
  if index >= retained.length { return CompilerBug.panic(b"descriptor demand lost its explicit retained request") }
  let selected = &retained[index]
  return DescriptorUse {operand: selected.execution, result: selected.execution, selection: selected.selection, strength: Write.Weak}
}

// Request tables are frozen before candidate closure. Demand.selectionUse addresses ordinary
// projections followed by the discriminated descriptor table (retained slots, then actual
// invocation views). Supplemental Slice demands retain that same original coordinate.
fn descriptorUse<'body>(prepared: &SourcePreparation<'body>, selections: &[SelectionUse], retained: &[DescriptorRequest], slices: &[SliceConversion],
  closure: &DescriptorClosure, demand: usize) -> DescriptorUse {
  let actual = List<Carriers.Demand>.asSlice(&closure.demands)[demand]
  let use = descriptorRequestedUse(selections, retained, actual.selectionUse)
  let sources = List<SliceDemand>.asSlice(&closure.sliceDemands)
  let mut at = usize.ZERO
  while at < sources.length {
    if sources[at].demand == demand {
      let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[sources[at].proof]
      let conversion = slices[proof.conversion]
      let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
      let element = &List<Prepared.ArraySliceElement>.asSlice(&row.elements)[sources[at].element]
      return DescriptorUse {operand: conversion.source, result: use.result, selection: element.selection, strength: Write.Strong}
    }
    at = at + usize.ONE
  }
  return use
}

/// One inline member of a discharged referent. parent records the exact prepared-family
/// child and residual next edge; no expanded history/path is stored or inferred by type.
struct OriginPlacement {
  proof: usize
  parent: Option<usize>
  member: MapId
  state: Prepared.ResidualStateId
  sourceAlias: usize
  active: Atom
}
impl Copy for OriginPlacement {}

// Replaying an address formation at its selected OUTPUT is a different product from
// carrying the outer descriptor. The latter supplies the actual cases and frozen cursors;
// these nodes transport a later, independently authored suffix through that same proof.
// In particular, an outer Borrow leaf never stands in for the current contents' leaf.
struct ContentsNode {
  edge: usize
  target: Prepared.ResidualStateId
  carrier: usize
  state: Prepared.ResidualStateId
  active: Atom
  identity: Atom
}
impl Copy for ContentsNode {}

union ContentsLift {
  Publication,
  OutputIdentity {cursor: Carriers.BoundaryCursor},
  Next {cursor: Carriers.BoundaryCursor, next: Prepared.BoundaryTransitionId},
  Prepared {cursor: Carriers.BoundaryCursor, lift: usize},
  CompositeIdentity {pair: usize, sourceSubject: Prepared.ResidualStateId, targetSubject: Prepared.ResidualStateId},
  Composite {pair: usize, sourceSubject: Prepared.ResidualStateId, targetSubject: Prepared.ResidualStateId, result: usize},
}
impl Copy for ContentsLift {}

struct ContentsStep {
  later: usize
  earlier: usize
  carrier: usize
  lift: ContentsLift
}
impl Copy for ContentsStep {}

union ContentsAuthority {
  Selected {map: MapId},
  Origin {node: usize, referent: Prepared.BoundaryTransitionId},
  Slice {node: usize, element: Prepared.BoundaryTransitionId},
}
impl Copy for ContentsAuthority {}

// Both address legs retain their own actual Case. A Slice terminal stops at the
// conversion descriptor and crosses only its exact element.value member; the preceding
// Origin address remains a separate current-read transport, never a contents snapshot.
struct ContentsPlacement {
  carrier: usize
  state: Prepared.ResidualStateId
  member: MapId
}
impl Copy for ContentsPlacement {}

fn contentsPlacement(closure: &DescriptorClosure, authority: AliasAuthority) -> Option<ContentsPlacement> {
  return match authority {
    AliasAuthority.Origin {placement: id} => {
      let placement = List<OriginPlacement>.asSlice(&closure.placements)[id]
      let proof = List<OriginProof>.asSlice(&closure.origins)[placement.proof]
      return Option<ContentsPlacement>.some(ContentsPlacement {carrier: proof.carrier, state: placement.state, member: placement.member})
    }
    AliasAuthority.Slice {placement: id} => {
      let placement = List<SlicePlacement>.asSlice(&closure.slicePlacements)[id]
      let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[placement.proof]
      return Option<ContentsPlacement>.some(ContentsPlacement {carrier: proof.carrier, state: placement.state, member: placement.member})
    }
    _ => Option<ContentsPlacement>.none()
  }
}

fn contentsTerminal(authority: ContentsAuthority) -> usize {
  return match authority {
    ContentsAuthority.Origin {node, ..} => node
    ContentsAuthority.Slice {node, ..} => node
    _ => CompilerBug.panic(b"selected identity has no original contents graph")
  }
}

fn contentsBoundary(authority: ContentsAuthority) -> Prepared.BoundaryTransitionId {
  return match authority {
    ContentsAuthority.Origin {referent, ..} => referent
    ContentsAuthority.Slice {element, ..} => element
    _ => CompilerBug.panic(b"selected identity has no contents discharge boundary")
  }
}

// One proof per actual contents Case and derivation. identity is a separately grounded
// assertion about the translated selector's complete OUTPUT, not equality of loan IDs or
// input shapes. It permits a subsequent independent query to cross a composite identity.
struct ContentsProof {
  case: usize
  edge: usize
  source: Prepared.ResidualStateId
  target: Prepared.ResidualStateId
  authority: ContentsAuthority
  active: Atom
  identity: Atom
}
impl Copy for ContentsProof {}

// Semantic channels retain the actual current-read Address occurrence and original
// contents graph, but NEVER enter Carriers.Pair or physical acceptance. identity is
// complete channel OUTPUT identity, separately grounded from root transport.
union ContentsChannelAuthority {
  Selected {map: MapId},
  Origin {node: usize, member: MapId, stop: usize},
  Slice {node: usize, member: MapId, stop: usize},
}
impl Copy for ContentsChannelAuthority {}
struct ContentsChannelProof {
  case: usize
  edge: usize
  source: Prepared.ResidualStateId
  target: Prepared.ResidualStateId
  authority: ContentsChannelAuthority
  active: Atom
  identity: Atom
}
impl Copy for ContentsChannelProof {}
// Prefix and relative selections remain separate authored histories. This tuple carries
// only frozen coordinates; the common cursor below proves their joint actual path.
struct ContentsChannelPrefix {
  projection: Prepared.ContractProjectionId
  root: Prepared.ResidualStateId
  current: Prepared.ResidualStateId
}
impl Copy for ContentsChannelPrefix {}
struct ContentsChannelOutput {
  proof: usize
  requestedPrefix: Option<ContentsChannelPrefix>
  requestedRoot: Prepared.ResidualStateId
  requested: Prepared.ResidualStateId
  prefix: Option<ContentsChannelPrefix>
  root: Prepared.ResidualStateId
  current: Prepared.ResidualStateId
  cursor: usize
  active: Atom
}
impl Copy for ContentsChannelOutput {}

struct ContentsChannelRequest {
  proof: usize
  prefix: Option<ContentsChannelPrefix>
  requestedRoot: Prepared.ResidualStateId
  requested: Prepared.ResidualStateId
  reverse: bool
  root: usize
}
impl Copy for ContentsChannelRequest {}
// Nodes contain original finite proof coordinates and the two independent segment
// pairs. Membership in an old primitive replay is kept on cursors, never in this key.
union ContentsChannelPoint {
  Source, Target,
  Original {node: usize},
  Primitive {proof: usize, point: ContentsReplayPoint, subject: Prepared.ResidualStateId, channel: Prepared.ResidualStateId},
}
impl Copy for ContentsChannelPoint {}
struct ContentsChannelNode {
  request: usize
  point: ContentsChannelPoint
  prefix: Option<ContentsChannelPrefix>
  root: Prepared.ResidualStateId
  current: Prepared.ResidualStateId
}
impl Copy for ContentsChannelNode {}
union ContentsChannelPosition {
  Start, Done,
  Original {node: usize},
  Expanded {step: usize, result: usize, node: usize},
}
impl Copy for ContentsChannelPosition {}
struct ContentsChannelCursor {
  node: usize
  position: ContentsChannelPosition
  active: Atom
}
impl Copy for ContentsChannelCursor {}
union ContentsChannelWitness {
  Selected, Start, Finish,
  Step {step: usize},
  Enter {step: usize, result: usize},
  Arc {arc: usize},
  Leave {step: usize, result: usize},
}
impl Copy for ContentsChannelWitness {}
struct ContentsChannelLink {
  source: usize
  target: usize
  witness: ContentsChannelWitness
  root: Option<Prepared.ChannelLiftId>
  current: Option<Prepared.ChannelLiftId>
  reverse: bool
  active: Atom
  prefixRoot: Option<Prepared.ChannelLiftId>
  prefixCurrent: Option<Prepared.ChannelLiftId>
}
impl Copy for ContentsChannelLink {}
struct ContentsChannelProjection {
  prefix: Option<ContentsChannelPrefix>
  root: Prepared.ResidualStateId
  current: Prepared.ResidualStateId
  rootLift: Option<Prepared.ChannelLiftId>
  currentLift: Option<Prepared.ChannelLiftId>
  prefixRoot: Option<Prepared.ChannelLiftId>
  prefixCurrent: Option<Prepared.ChannelLiftId>
}
impl Copy for ContentsChannelProjection {}

// Replay requests name the existing actual Case/Origin authority. ContentsProof's key is
// bounded by actual case/alias edge, frozen states, original ContentsNode and discharge pair;
// replay nodes are NEVER used as ContentsProof.authority. No generation enters this key.
struct ContentsReplay {
  proof: usize
  source: Prepared.ResidualStateId
  target: Prepared.ResidualStateId
  state: Prepared.ResidualStateId
  reverse: bool
  root: usize
}
impl Copy for ContentsReplay {}
union ContentsReplayPoint { Source, Target, Original {node: usize} }
impl Copy for ContentsReplayPoint {}
struct ContentsReplayNode {
  request: usize
  proof: usize
  point: ContentsReplayPoint
  subject: Prepared.ResidualStateId
  state: Prepared.ResidualStateId
}
impl Copy for ContentsReplayNode {}
union ContentsReplayPosition {
  Start,
  Original {node: usize},
  Expanded {expansion: usize, node: usize},
  Done,
}
impl Copy for ContentsReplayPosition {}
// Membership has its own gates. Two histories sharing a normalized physical point cannot
// activate one another's traversal cursor merely because their point/state keys coincide.
struct ContentsReplayCursor {
  node: usize
  position: ContentsReplayPosition
  active: Atom
  identity: Atom
}
impl Copy for ContentsReplayCursor {}
struct ContentsReplayArc {
  later: usize
  earlier: usize
  boundary: Option<Prepared.BoundaryTransitionId>
  stop: Option<usize>
  reverse: bool
  active: Atom
}
impl Copy for ContentsReplayArc {}
union ContentsReplayWitness {
  Root,
  Step {step: usize},
  Discharge {proof: usize},
  Arc {arc: usize},
  Enter {expansion: usize},
  Leave {expansion: usize},
}
impl Copy for ContentsReplayWitness {}
struct ContentsReplayLink {
  arc: usize
  source: usize
  target: usize
  witness: ContentsReplayWitness
  selected: Option<Prepared.BoundaryTransitionId>
  lift: Option<usize>
}
impl Copy for ContentsReplayLink {}
struct ContentsReplayExpansion {
  source: usize
  step: usize
  result: usize
  reverse: bool
  finish: usize
  continuation: usize
  subject: Prepared.ResidualStateId
}
impl Copy for ContentsReplayExpansion {}
struct ContentsReplayResult {
  request: usize
  cursor: usize
}
impl Copy for ContentsReplayResult {}
struct ContentsReplayProjection {
  state: Prepared.ResidualStateId
  selected: Option<Prepared.BoundaryTransitionId>
  boundary: Option<Prepared.BoundaryTransitionId>
  lift: Option<usize>
  stop: Option<usize>
  identity: bool
}
impl Copy for ContentsReplayProjection {}

fn sameTemporary(left: Option<EvalId>, right: Option<EvalId>) -> bool {
  return match left {
    Option<EvalId>.None => match right { Option<EvalId>.None => true _ => false }
    Option<EvalId>.Some {value} => match right { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
  }
}

// Compare paths only inside two already authenticated component trees. This never chooses
// a canonical owner: both roots come from the same discharged source-alias proof.
fn sameComponentSuffix(endpoints: &[Endpoint], left: EndpointId, leftRoot: EndpointId,
  right: EndpointId, rightRoot: EndpointId) -> bool {
  let mut a = left
  let mut b = right
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if a.index == leftRoot.index || b.index == rightRoot.index {
      return a.index == leftRoot.index && b.index == rightRoot.index
    }
    if a.index >= endpoints.length || b.index >= endpoints.length
      || !sameSelector(&endpoints[a.index].selector, &endpoints[b.index].selector) { return false }
    a = match endpoints[a.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    b = match endpoints[b.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"origin component correspondence is cyclic")
}

effect fn reserveOriginPlacement<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, proof: usize, parent: Option<usize>, member: MapId,
  state: Prepared.ResidualStateId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let evidence = List<OriginProof>.asSlice(&closure.origins)[proof]
  let origin = List<ReferenceOrigin>.asSlice(&skeleton.references)[evidence.origin]
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let physical = &maps[member.index]
  let selected = &states[state.index]
  let sourceRoot = List<StorageAlias>.asSlice(&skeleton.aliases)[evidence.sourceAlias]
  let carrier = CarriersProduct.nodes(&closure.product)[evidence.carrier]
  let request = descriptorUse(prepared, List<SelectionUse>.asSlice(&skeleton.selections),
    List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests), List<SliceConversion>.asSlice(&skeleton.slices), &closure.*, carrier.demand)
  let evaluation = request.operand
  let strength = request.strength
  let selection = request.selection
  if !authoredResidual(selected) || selected.selection.index != selection.index
    || physical.target.index >= endpoints.length || selected.output.index != endpoints[physical.target.index].shape.index {
    return CompilerBug.panic(b"origin placement changed its exact residual/member subject")
  }
  // vertex is used only in its ORIGINAL SelectionUse component tree, never under an
  // operation-result anchor. That distinction is the purpose of the retained demand.
  let selectedRoot = List<Selection>.asSlice(&prepared.selections)[selection.index].root
  if !componentWithin(endpoints, selected.vertex, selectedRoot) {
    return CompilerBug.panic(b"origin placement escaped the actual authored selection")
  }
  let count = List<StorageAlias>.length(&skeleton.aliases)
  let mut changed = false
  let mut alias = usize.ZERO
  while alias < count {
    let actual = List<StorageAlias>.asSlice(&skeleton.aliases)[alias]
    if actual.evaluation.index == origin.source.index && sameSourceComponent(endpoints, actual.endpoint, physical.source)
      && sameTemporary(actual.storage.temporary, sourceRoot.storage.temporary)
      && sameComponentSuffix(endpoints, actual.storage.endpoint, sourceRoot.storage.endpoint,
        actual.endpoint, maps[origin.map.index].source) {
      let prior = List<OriginPlacement>.asSlice(&closure.placements)
      let mut found = false
      let mut each = usize.ZERO
      while each < prior.length {
        if prior[each].proof == proof && prior[each].member.index == member.index
          && prior[each].state.index == state.index && prior[each].sourceAlias == alias { found = true }
        each = each + usize.ONE
      }
      if !found {
        let active = run addressApplies(&mut skeleton.rules, evidence.active, actual.active)
        let placement = List<OriginPlacement>.length(&closure.placements)
        run List<OriginPlacement>.append(&mut closure.placements, OriginPlacement {proof: proof,
          parent: parent, member: member, state: state, sourceAlias: alias, active: active})
        let mut write = strength
        if actual.write == Write.Weak { write = Write.Weak }
        let target = run Skeleton.aliasNode(&mut skeleton.*, evaluation, selected.vertex, actual.storage, write)
        run Skeleton.aliasEdge(&mut skeleton.*, Option<usize>.some(alias), target,
          AliasAuthority.Origin {placement: placement}, active)
        changed = true
      }
    }
    alias = alias + usize.ONE
  }
  return changed
}

effect fn activateOriginPlacements<'body>(closure: &mut DescriptorClosure,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton) -> bool ! OutOfMemoryError ? &mut Allocator {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let origins = List<OriginProof>.length(&closure.origins)
  let mut changed = false
  let mut proof = usize.ZERO
  while proof < origins {
    let evidence = List<OriginProof>.asSlice(&closure.origins)[proof]
    let origin = List<ReferenceOrigin>.asSlice(&skeleton.references)[evidence.origin]
    let state = CarriersProduct.nodes(&closure.product)[evidence.carrier].state
    if run reserveOriginPlacement(&mut closure.*, prepared, &mut skeleton.*, proof,
      Option<usize>.none(), origin.referent, state) { changed = true }
    proof = proof + usize.ONE
  }
  let mut at = usize.ZERO
  while at < List<OriginPlacement>.length(&closure.placements) {
    let parent = List<OriginPlacement>.asSlice(&closure.placements)[at]
    let next = List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next)
    let children = List<MapId>.asSlice(&maps[parent.member.index].children)
    let mut step = usize.ZERO
    while step < next.length {
      let state = &states[next[step].index]
      if state.input.shape.index != endpoints[maps[parent.member.index].target.index].shape.index {
        return CompilerBug.panic(b"origin inline continuation left its prepared subject")
      }
      let component = &List<Prepared.Component>.asSlice(&shapes[state.input.shape.index].components)[state.input.ordinal]
      if component.inline {
        let mut member = usize.ZERO
        let mut matched = usize.ZERO
        while member < children.length {
          let actual = &maps[children[member].index]
          if sameSelector(&endpoints[actual.target.index].selector, &component.selector) {
            matched = matched + usize.ONE
            if run reserveOriginPlacement(&mut closure.*, prepared, &mut skeleton.*, parent.proof,
              Option<usize>.some(at), children[member], next[step]) { changed = true }
          }
          member = member + usize.ONE
        }
        if matched != usize.ONE { return CompilerBug.panic(b"origin continuation lacks its exact inline family member") }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  return changed
}

// This bridge changes only the interpretation of an actual canonical address. The source
// Origin edge is retained separately from the conversion's element family, so neither
// the conversion-time array contents nor another same-shaped descriptor can supply it.
effect fn reserveSlicePlacement<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, proofId: usize, elementId: usize, parent: Option<usize>, member: MapId,
  stateId: Prepared.ResidualStateId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[proofId]
  let conversion = List<SliceConversion>.asSlice(&skeleton.slices)[proof.conversion]
  let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
  let element = &List<Prepared.ArraySliceElement>.asSlice(&row.elements)[elementId]
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let physical = &maps[member.index]
  let state = &states[stateId.index]
  let node = CarriersProduct.nodes(&closure.product)[proof.carrier]
  let request = descriptorUse(prepared, List<SelectionUse>.asSlice(&skeleton.selections),
    List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests), List<SliceConversion>.asSlice(&skeleton.slices), &closure.*, node.demand)
  if !authoredResidual(state) || state.selection.index != request.selection.index
    || state.output.index != endpoints[physical.target.index].shape.index {
    return CompilerBug.panic(b"slice element changed its exact selected output subject")
  }
  let mut sourceDemand = usize.MAX
  let demands = List<SliceDemand>.asSlice(&closure.sliceDemands)
  let mut each = usize.ZERO
  while each < demands.length {
    if demands[each].proof == proofId && demands[each].element == elementId { sourceDemand = demands[each].demand }
    each = each + usize.ONE
  }
  if sourceDemand == usize.MAX { return CompilerBug.panic(b"slice element has no exact source reference demand") }
  let count = match &prepared.body.nodes[row.site.index].kind {
    NodeKind.Expression {form: Expression.ArraySlice {count, ..}, ..} => count
    _ => { return CompilerBug.panic(b"slice address has no actual conversion") }
  }
  let mut changed = false
  let edgeCount = List<AliasEdge>.length(&skeleton.aliasEdges)
  let mut edgeId = usize.ZERO
  while edgeId < edgeCount {
    let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
    if let AliasAuthority.Origin {placement: originId} = edge.authority {
      let origin = List<OriginPlacement>.asSlice(&closure.placements)[originId]
      let acquisition = List<OriginProof>.asSlice(&closure.origins)[origin.proof]
      let carried = CarriersProduct.nodes(&closure.product)[acquisition.carrier]
      let source = List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
      // A child belongs to this exact source-Origin alternative. Visiting another
      // alternative first cannot attach its child here and suppress the authentic parent.
      let mut pairedParent = false
      match parent {
        Option<usize>.None => { pairedParent = true }
        Option<usize>.Some {value} => {
          let placements = List<SlicePlacement>.asSlice(&closure.slicePlacements)
          if value >= placements.length { return CompilerBug.panic(b"slice child lost its reserved parent") }
          let previous = placements[value]
          pairedParent = previous.proof == proofId && previous.element == elementId
            && List<OriginPlacement>.asSlice(&closure.placements)[previous.origin].proof == origin.proof
            && match origin.parent { Option<usize>.Some {value: matchedOriginParent} => matchedOriginParent == previous.origin _ => false }
        }
      }
      if carried.demand == sourceDemand && source.evaluation.index == conversion.source.index
        && source.endpoint.index == physical.source.index
        && states[origin.state.index].selection.index == element.selection.index && pairedParent {
        let prior = List<SlicePlacement>.asSlice(&closure.slicePlacements)
        let mut found = false
        each = usize.ZERO
        while each < prior.length {
          let sameParent = match parent {
            Option<usize>.None => match prior[each].parent { Option<usize>.None => true _ => false }
            Option<usize>.Some {value} => match prior[each].parent { Option<usize>.Some {value: other} => value == other _ => false }
          }
          if prior[each].proof == proofId && prior[each].element == elementId && prior[each].origin == originId
            && prior[each].edge == edgeId && sameParent
            && prior[each].member.index == member.index && prior[each].state.index == stateId.index { found = true }
          each = each + usize.ONE
        }
        if !found {
          let id = prior.length
          run List<SlicePlacement>.append(&mut closure.slicePlacements, SlicePlacement {proof: proofId,
            element: elementId, parent: parent, origin: originId, edge: edgeId, member: member, state: stateId})
          let active = run addressApplies(&mut skeleton.rules, proof.active, edge.active)
          // An unknown successful index in a one-element conversion denotes its sole
          // canonical slot. Larger conversions never turn Remainder into a strong kill.
          let mut write = Write.Weak
          if count == usize.ONE && source.write == Write.Strong { write = Write.Strong }
          let target = run Skeleton.aliasNode(&mut skeleton.*, request.operand, state.vertex, source.storage, write)
          run Skeleton.aliasEdge(&mut skeleton.*, Option<usize>.some(edge.target), target,
            AliasAuthority.Slice {placement: id}, active)
          changed = true
        }
      }
    }
    edgeId = edgeId + usize.ONE
  }
  return changed
}

effect fn activateSlicePlacements<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton) -> bool ! OutOfMemoryError ? &mut Allocator {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let count = List<SliceProof>.length(&closure.sliceProofs)
  let mut changed = false
  let mut proofId = usize.ZERO
  while proofId < count {
    let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[proofId]
    let conversion = List<SliceConversion>.asSlice(&skeleton.slices)[proof.conversion]
    let elements = List<Prepared.ArraySliceElement>.asSlice(&List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared].elements)
    let state = CarriersProduct.nodes(&closure.product)[proof.carrier].state
    let mut element = usize.ZERO
    while element < elements.length {
      if run reserveSlicePlacement(&mut closure.*, prepared, &mut skeleton.*, proofId, element,
        Option<usize>.none(), elements[element].value, state) { changed = true }
      element = element + usize.ONE
    }
    proofId = proofId + usize.ONE
  }
  let mut at = usize.ZERO
  while at < List<SlicePlacement>.length(&closure.slicePlacements) {
    let parent = List<SlicePlacement>.asSlice(&closure.slicePlacements)[at]
    let next = List<Prepared.ResidualStateId>.asSlice(&states[parent.state.index].next)
    let children = List<MapId>.asSlice(&maps[parent.member.index].children)
    let mut step = usize.ZERO
    while step < next.length {
      let selected = &states[next[step].index]
      if selected.input.shape.index != endpoints[maps[parent.member.index].target.index].shape.index {
        return CompilerBug.panic(b"slice inline continuation changed the exact element output")
      }
      let component = residualComponent(shapes, selected.input)
      if component.inline {
        let mut matched = usize.ZERO
        let mut child = usize.ZERO
        while child < children.length {
          if sameSelector(&endpoints[maps[children[child].index].target.index].selector, &component.selector) {
            matched = matched + usize.ONE
            if run reserveSlicePlacement(&mut closure.*, prepared, &mut skeleton.*, parent.proof, parent.element,
              Option<usize>.some(at), children[child], next[step]) { changed = true }
          }
          child = child + usize.ONE
        }
        if matched != usize.ONE { return CompilerBug.panic(b"slice selected element has no exact inline family member") }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  return changed
}

struct RetainedMissing {
  request: usize
  cell: usize
}
impl Copy for RetainedMissing {}

struct DescriptorClosure {
  retainedMissing: List<RetainedMissing>
  product: CarriersProduct
  pairs: List<Carriers.Pair>
  demands: List<Carriers.Demand>
  origins: List<OriginProof>
  placements: List<OriginPlacement>
  sliceProofs: List<SliceProof>
  sliceDemands: List<SliceDemand>
  slicePlacements: List<SlicePlacement>
  contents: List<ContentsNode>
  contentsSteps: List<ContentsStep>
  contentsProofs: List<ContentsProof>
  contentsChannels: List<ContentsChannelProof>
  contentsChannelOutputs: List<ContentsChannelOutput>
  contentsChannelRequests: List<ContentsChannelRequest>
  contentsChannelNodes: List<ContentsChannelNode>
  contentsChannelCursors: List<ContentsChannelCursor>
  contentsChannelLinks: List<ContentsChannelLink>
  contentsReplays: List<ContentsReplay>
  contentsReplayNodes: List<ContentsReplayNode>
  contentsReplayCursors: List<ContentsReplayCursor>
  contentsReplayArcs: List<ContentsReplayArc>
  contentsReplayLinks: List<ContentsReplayLink>
  contentsReplayExpansions: List<ContentsReplayExpansion>
  contentsReplayResults: List<ContentsReplayResult>
}
impl DescriptorClosure {
  fn make() -> Self {
    return DescriptorClosure {retainedMissing: List<RetainedMissing>.make(), product: CarriersProduct.make(), pairs: List<Carriers.Pair>.make(), demands: List<Carriers.Demand>.make(),
      origins: List<OriginProof>.make(), placements: List<OriginPlacement>.make(),
      sliceProofs: List<SliceProof>.make(), sliceDemands: List<SliceDemand>.make(), slicePlacements: List<SlicePlacement>.make(),
      contents: List<ContentsNode>.make(), contentsSteps: List<ContentsStep>.make(),
      contentsProofs: List<ContentsProof>.make(), contentsChannels: List<ContentsChannelProof>.make(),
      contentsChannelOutputs: List<ContentsChannelOutput>.make(), contentsChannelRequests: List<ContentsChannelRequest>.make(),
      contentsChannelNodes: List<ContentsChannelNode>.make(), contentsChannelCursors: List<ContentsChannelCursor>.make(),
      contentsChannelLinks: List<ContentsChannelLink>.make(), contentsReplays: List<ContentsReplay>.make(),
      contentsReplayNodes: List<ContentsReplayNode>.make(), contentsReplayCursors: List<ContentsReplayCursor>.make(),
      contentsReplayArcs: List<ContentsReplayArc>.make(), contentsReplayLinks: List<ContentsReplayLink>.make(),
      contentsReplayExpansions: List<ContentsReplayExpansion>.make(), contentsReplayResults: List<ContentsReplayResult>.make()}
  }
}

fn contentsChannelState<'body>(prepared: &SourcePreparation<'body>, id: Prepared.ResidualStateId) -> bool {
  let state = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[id.index]
  if !authoredResidual(state) { return false }
  let shape = &List<Prepared.Shape>.asSlice(&prepared.shapes)[state.input.shape.index]
  return channelSelector(&List<Prepared.Component>.asSlice(&shape.components)[state.input.ordinal].selector)
}

fn contentsPhysicalState<'body>(prepared: &SourcePreparation<'body>, id: Prepared.ResidualStateId) -> bool {
  let state = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[id.index]
  if !authoredResidual(state) { return false }
  let shape = &List<Prepared.Shape>.asSlice(&prepared.shapes)[state.input.shape.index]
  return match &List<Prepared.Component>.asSlice(&shape.components)[state.input.ordinal].selector {
    Selector.CallableResult => false
    Selector.EffectSuccess => false
    Selector.EffectFailure => false
    _ => true
  }
}

fn boundaryBefore(pair: &Prepared.BoundaryTransition, direction: CarriersDirection) -> Prepared.ResidualStateId {
  if direction == CarriersDirection.StorageInverse { return pair.targetState }
  return pair.sourceState
}
fn boundaryAfter(pair: &Prepared.BoundaryTransition, direction: CarriersDirection) -> Prepared.ResidualStateId {
  if direction == CarriersDirection.StorageInverse { return pair.sourceState }
  return pair.targetState
}
fn boundaryOutputIdentity<'body>(prepared: &SourcePreparation<'body>, id: Prepared.BoundaryTransitionId) -> bool {
  let pair = &List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)[id.index]
  let substitution = &List<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)[pair.substitution.index]
  return substitution.form == PreparedBoundarySubstitutionForm.Identity
    && substitution.source.index == substitution.target.index
}

// Walk only declared next edges of the actual carrier state. A vertex from another query
// is never attached here by endpoint ancestry, spelling or selector/type equality.
effect fn contentsSubject<'body>(prepared: &SourcePreparation<'body>, root: Prepared.ResidualStateId,
  selected: Prepared.ResidualStateId) -> Option<Prepared.ResidualStateId>
! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let wanted = &states[selected.index]
  let mut pending = List<Prepared.ResidualStateId>.make()
  run List<Prepared.ResidualStateId>.append(&mut pending, root)
  let mut result = Option<Prepared.ResidualStateId>.none()
  let mut at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let id = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    let state = &states[id.index]
    if state.selection.index == wanted.selection.index && state.vertex.index == wanted.vertex.index {
      if let Option<Prepared.ResidualStateId>.Some {value} = result {
        if value.index != id.index { return CompilerBug.panic(b"carrier output has ambiguous authored component states") }
      }
      result = Option<Prepared.ResidualStateId>.some(id)
    }
    let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
    let mut each = usize.ZERO
    while each < next.length {
      if !containsResidual(List<Prepared.ResidualStateId>.asSlice(&pending), next[each]) {
        run List<Prepared.ResidualStateId>.append(&mut pending, next[each])
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return result
}

// A complete output identity also preserves an inline descendant. Retain the exact
// intersection of BOTH authored next graphs; equal-shaped siblings are not candidates.
// This is used only under the original composite proof's grounded identity atom.
effect fn contentsIdentityDescendant<'body>(prepared: &SourcePreparation<'body>, source: Prepared.ResidualStateId,
  target: Prepared.ResidualStateId, selected: Prepared.ResidualStateId) -> bool
! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  if states[source.index].output.index != states[target.index].output.index { return false }
  let left = List<Prepared.ResidualStateId>.asSlice(&states[source.index].next)
  let right = List<Prepared.ResidualStateId>.asSlice(&states[target.index].next)
  let mut pending = List<Prepared.ResidualStateId>.make()
  let mut at = usize.ZERO
  while at < left.length {
    if containsResidual(right, left[at]) { run List<Prepared.ResidualStateId>.append(&mut pending, left[at]) }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let id = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    let state = &states[id.index]
    let component = residualComponent(shapes, state.input)
    if component.inline && authoredResidual(state) {
      if id.index == selected.index { return true }
      let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
      let mut each = usize.ZERO
      while each < next.length {
        if !containsResidual(List<Prepared.ResidualStateId>.asSlice(&pending), next[each]) {
          run List<Prepared.ResidualStateId>.append(&mut pending, next[each])
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn contentsNode(values: &mut List<ContentsNode>, rules: &mut Program, edge: usize,
  target: Prepared.ResidualStateId, carrier: usize, state: Prepared.ResidualStateId) -> usize
! OutOfMemoryError ? &mut Allocator {
  let nodes = List<ContentsNode>.asSlice(&values.*)
  let mut at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at]
    if node.edge == edge && node.target.index == target.index && node.carrier == carrier
      && node.state.index == state.index { return at }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut rules.*)
  let identity = Program.atom(&mut rules.*)
  run List<ContentsNode>.append(&mut values.*, ContentsNode {edge: edge, target: target,
    carrier: carrier, state: state, active: active, identity: identity})
  return at
}

fn sameContentsLift(left: ContentsLift, right: ContentsLift) -> bool {
  return match left {
    ContentsLift.Publication => match right { ContentsLift.Publication => true _ => false }
    ContentsLift.OutputIdentity {cursor} => match right {
      ContentsLift.OutputIdentity {cursor: other} => cursor.root.index == other.root.index
        && cursor.current.index == other.current.index && cursor.direction == other.direction
      _ => false
    }
    ContentsLift.Next {cursor, next} => match right {
      ContentsLift.Next {cursor: other, next: following} => cursor.root.index == other.root.index
        && cursor.current.index == other.current.index && cursor.direction == other.direction
        && next.index == following.index
      _ => false
    }
    ContentsLift.Prepared {cursor, lift} => match right {
      ContentsLift.Prepared {cursor: other, lift: otherLift} => cursor.root.index == other.root.index
        && cursor.current.index == other.current.index && cursor.direction == other.direction && lift == otherLift
      _ => false
    }
    ContentsLift.CompositeIdentity {pair, sourceSubject, targetSubject} => match right {
      ContentsLift.CompositeIdentity {pair: other, sourceSubject: otherSource, targetSubject: otherTarget} =>
        pair == other && sourceSubject.index == otherSource.index && targetSubject.index == otherTarget.index
      _ => false
    }
    ContentsLift.Composite {pair, sourceSubject, targetSubject, result} => match right {
      ContentsLift.Composite {pair: other, sourceSubject: otherSource, targetSubject: otherTarget, result: otherResult} =>
        pair == other && sourceSubject.index == otherSource.index && targetSubject.index == otherTarget.index && result == otherResult
      _ => false
    }
  }
}

effect fn contentsStep(values: &mut List<ContentsNode>, edges: &mut List<ContentsStep>, rules: &mut Program, later: usize,
  edge: usize, carrier: Carriers.Edge, state: Prepared.ResidualStateId, lift: ContentsLift, applicable: Atom,
  paired: Option<Atom>, identity: bool, identityGate: Option<Atom>) -> () ! OutOfMemoryError ? &mut Allocator {
  let node = List<ContentsNode>.asSlice(&values.*)[later]
  if node.carrier != carrier.later { return CompilerBug.panic(b"contents translation crossed carrier occurrences") }
  let earlier = run contentsNode(&mut values.*, &mut rules.*, node.edge, node.target, carrier.earlier, state)
  let steps = List<ContentsStep>.asSlice(&edges.*)
  let mut at = usize.ZERO
  while at < steps.length {
    if steps[at].later == later && steps[at].earlier == earlier && steps[at].carrier == edge
      && sameContentsLift(steps[at].lift, lift) { return () }
    at = at + usize.ONE
  }
  let previous = List<ContentsNode>.asSlice(&values.*)[earlier]
  let empty = List<Atom>.make()
  let mut gates = List<Atom>.make()
  run List<Atom>.append(&mut gates, node.active)
  run List<Atom>.append(&mut gates, applicable)
  if let Option<Atom>.Some {value} = paired { run List<Atom>.append(&mut gates, value) }
  run Program.rule(&mut rules.*, previous.active, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  if let Option<Atom>.Some {value} = identityGate {
    let exact: [Atom; 3] = [node.identity, applicable, value]
    run Program.rule(&mut rules.*, previous.identity, &exact, List<Atom>.asSlice(&empty))
  }
  if identity {
    let mutableRows6 = List<Atom>.asMutSlice(&mut gates)
    mutableRows6[usize.ZERO] = node.identity
    run Program.rule(&mut rules.*, previous.identity, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  }
  run List<ContentsStep>.append(&mut edges.*, ContentsStep {later: later,
    earlier: earlier, carrier: edge, lift: lift})
  return ()
}

fn sameContentsAuthority(left: ContentsAuthority, right: ContentsAuthority) -> bool {
  return match left {
    ContentsAuthority.Selected {map} => match right { ContentsAuthority.Selected {map: other} => map.index == other.index _ => false }
    ContentsAuthority.Origin {node, referent} => match right {
      ContentsAuthority.Origin {node: other, referent: otherReferent} => node == other && referent.index == otherReferent.index
      _ => false
    }
    ContentsAuthority.Slice {node, element} => match right {
      ContentsAuthority.Slice {node: other, element: otherElement} => node == other && element.index == otherElement.index
      _ => false
    }
  }
}

fn sameContentsChannelAuthority(left: ContentsChannelAuthority, right: ContentsChannelAuthority) -> bool {
  return match left {
    ContentsChannelAuthority.Selected {map} => match right { ContentsChannelAuthority.Selected {map: other} => map.index == other.index _ => false }
    ContentsChannelAuthority.Origin {node, member, stop} => match right {
      ContentsChannelAuthority.Origin {node: other, member: otherMember, stop: otherStop} => node == other && member.index == otherMember.index && stop == otherStop
      _ => false
    }
    ContentsChannelAuthority.Slice {node, member, stop} => match right {
      ContentsChannelAuthority.Slice {node: other, member: otherMember, stop: otherStop} => node == other && member.index == otherMember.index && stop == otherStop
      _ => false
    }
  }
}

effect fn contentsChannelProof<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, edge: usize, before: Prepared.ResidualStateId,
  after: Prepared.ResidualStateId, authority: ContentsChannelAuthority, gates: &[Atom], identityGates: &[Atom],
  identity: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if !contentsChannelState(prepared, before) || !contentsChannelState(prepared, after) {
    return CompilerBug.panic(b"semantic contents proof requires exact authored channel states")
  }
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let empty = List<Atom>.make()
  let mut at = usize.ZERO
  while at < cases.length {
    let actual = &cases[at]
    let mut source = before
    let mut target = after
    let mut matches = false
    match actual.authority {
      TransferAuthority.Address {edge: selected, direction} => {
        if direction == MapDirection.StorageInverse { source = after target = before }
        matches = selected == edge
      }
      _ => ()
    }
    if matches {
      let input = match actual.source { Option<usize>.Some {value} => value
        _ => { return CompilerBug.panic(b"channel contents cannot originate at a descriptor seed") } }
      if states[source.index].input.shape.index != valueShape(prepared, values[keys[input].value.index]).index
        || states[target.index].input.shape.index != valueShape(prepared, values[keys[actual.target].value.index]).index {
        return CompilerBug.panic(b"channel contents changed its actual effective subjects")
      }
      let proofs = List<ContentsChannelProof>.asSlice(&closure.contentsChannels)
      let mut found = false
      let mut prior = usize.ZERO
      while prior < proofs.length {
        let proof = proofs[prior]
        if proof.case == at && proof.edge == edge && proof.source.index == source.index
          && proof.target.index == target.index && sameContentsChannelAuthority(proof.authority, authority) { found = true }
        prior = prior + usize.ONE
      }
      if !found {
        let active = Program.atom(&mut skeleton.rules)
        let unchanged = Program.atom(&mut skeleton.rules)
        let derived = Program.atom(&mut skeleton.rules)
        run Program.rule(&mut skeleton.rules, derived, gates, List<Atom>.asSlice(&empty))
        let actualGates: [Atom; 2] = [derived, actual.active]
        run Program.rule(&mut skeleton.rules, active, &actualGates, List<Atom>.asSlice(&empty))
        if identity {
          let paired = Program.atom(&mut skeleton.rules)
          run Program.rule(&mut skeleton.rules, paired, identityGates, List<Atom>.asSlice(&empty))
          let identityGates: [Atom; 2] = [paired, active]
          run Program.rule(&mut skeleton.rules, unchanged, &identityGates, List<Atom>.asSlice(&empty))
        }
        run List<ContentsChannelProof>.append(&mut closure.contentsChannels, ContentsChannelProof {
          case: at, edge: edge, source: source, target: target, authority: authority, active: active, identity: unchanged})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn sameContentsChannelLift(left: Option<Prepared.ChannelLiftId>, right: Option<Prepared.ChannelLiftId>) -> bool {
  return match left {
    Option<Prepared.ChannelLiftId>.Some {value} => match right { Option<Prepared.ChannelLiftId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<Prepared.ChannelLiftId>.None => true _ => false }
  }
}

fn contentsChannelLiftDescends(lifts: &[Prepared.ChannelLift], root: Prepared.ChannelLiftId,
  current: Prepared.ChannelLiftId, remaining: usize) -> bool {
  if root.index == current.index { return true }
  if remaining == usize.ZERO { return CompilerBug.panic(b"contents channel lift contains a cycle") }
  let next = List<Prepared.ChannelLiftId>.asSlice(&lifts[root.index].next)
  let mut at = usize.ZERO
  while at < next.length {
    if contentsChannelLiftDescends(lifts, next[at], current, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn contentsChannelSuffixContains(states: &[Prepared.ResidualState], root: Prepared.ResidualStateId,
  current: Prepared.ResidualStateId) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut pending = List<Prepared.ResidualStateId>.make()
  run List<Prepared.ResidualStateId>.append(&mut pending, root)
  let mut at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let id = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    if id.index == current.index { return true }
    let next = List<Prepared.ResidualStateId>.asSlice(&states[id.index].next)
    let mut each = usize.ZERO
    while each < next.length {
      if !containsResidual(List<Prepared.ResidualStateId>.asSlice(&pending), next[each]) {
        run List<Prepared.ResidualStateId>.append(&mut pending, next[each])
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn sameContentsChannelOrigin(left: PreparedChannelLiftOrigin, right: PreparedChannelLiftOrigin) -> bool {
  return match left {
    PreparedChannelLiftOrigin.Root => match right { PreparedChannelLiftOrigin.Root => true _ => false }
    PreparedChannelLiftOrigin.Boundary {lift} => match right { PreparedChannelLiftOrigin.Boundary {lift: other} => lift == other _ => false }
    PreparedChannelLiftOrigin.Projection {projection, prefixRoot, prefixCurrent} => match right {
      PreparedChannelLiftOrigin.Projection {projection: other, prefixRoot: otherRoot, prefixCurrent: otherCurrent} =>
        projection.index == other.index && prefixRoot.index == otherRoot.index && prefixCurrent.index == otherCurrent.index
      _ => false
    }
  }
}
fn sameContentsChannelPoint(left: ContentsChannelPoint, right: ContentsChannelPoint) -> bool {
  return match left {
    ContentsChannelPoint.Source => match right { ContentsChannelPoint.Source => true _ => false }
    ContentsChannelPoint.Target => match right { ContentsChannelPoint.Target => true _ => false }
    ContentsChannelPoint.Original {node} => match right { ContentsChannelPoint.Original {node: other} => node == other _ => false }
    ContentsChannelPoint.Primitive {proof, point, subject, channel} => match right {
      ContentsChannelPoint.Primitive {proof: other, point: otherPoint, subject: otherSubject, channel: otherChannel} =>
        proof == other && sameContentsReplayPoint(point, otherPoint) && subject.index == otherSubject.index && channel.index == otherChannel.index
      _ => false
    }
  }
}
fn sameContentsChannelPosition(left: ContentsChannelPosition, right: ContentsChannelPosition) -> bool {
  return match left {
    ContentsChannelPosition.Start => match right { ContentsChannelPosition.Start => true _ => false }
    ContentsChannelPosition.Done => match right { ContentsChannelPosition.Done => true _ => false }
    ContentsChannelPosition.Original {node} => match right { ContentsChannelPosition.Original {node: other} => node == other _ => false }
    ContentsChannelPosition.Expanded {step, result, node} => match right {
      ContentsChannelPosition.Expanded {step: other, result: otherResult, node: otherNode} => step == other && result == otherResult && node == otherNode
      _ => false
    }
  }
}
fn sameContentsChannelWitness(left: ContentsChannelWitness, right: ContentsChannelWitness) -> bool {
  return match left {
    ContentsChannelWitness.Selected => match right { ContentsChannelWitness.Selected => true _ => false }
    ContentsChannelWitness.Start => match right { ContentsChannelWitness.Start => true _ => false }
    ContentsChannelWitness.Finish => match right { ContentsChannelWitness.Finish => true _ => false }
    ContentsChannelWitness.Step {step} => match right { ContentsChannelWitness.Step {step: other} => step == other _ => false }
    ContentsChannelWitness.Enter {step, result} => match right { ContentsChannelWitness.Enter {step: other, result: otherResult} => step == other && result == otherResult _ => false }
    ContentsChannelWitness.Arc {arc} => match right { ContentsChannelWitness.Arc {arc: other} => arc == other _ => false }
    ContentsChannelWitness.Leave {step, result} => match right { ContentsChannelWitness.Leave {step: other, result: otherResult} => step == other && result == otherResult _ => false }
  }
}
fn contentsChannelPrimitive(node: ContentsReplayNode) -> ContentsChannelPoint {
  return ContentsChannelPoint.Primitive {proof: node.proof, point: node.point, subject: node.subject, channel: node.state}
}
fn sameContentsChannelPrefix(left: Option<ContentsChannelPrefix>, right: Option<ContentsChannelPrefix>) -> bool {
  return match left {
    Option<ContentsChannelPrefix>.None => match right { Option<ContentsChannelPrefix>.None => true _ => false }
    Option<ContentsChannelPrefix>.Some {value: a} => match right {
      Option<ContentsChannelPrefix>.Some {value: b} => a.projection.index == b.projection.index
        && a.root.index == b.root.index && a.current.index == b.current.index
      _ => false
    }
  }
}
fn contentsChannelPrefixValid<'body>(prepared: &SourcePreparation<'body>, prefix: ContentsChannelPrefix) -> bool {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  if prefix.projection.index >= List<Prepared.ContractProjection>.length(&prepared.contractProjections)
    || prefix.root.index >= states.length || prefix.current.index >= states.length
    || !authoredResidual(&states[prefix.root.index]) || !authoredResidual(&states[prefix.current.index]) { return false }
  let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
  let mut at = usize.ZERO
  while at < channels.length {
    if Results.receiverPrefix(prepared, at, prefix.projection, prefix.root, prefix.current) { return true }
    at = at + usize.ONE
  }
  return false
}

fn contentsChannelIdentity(node: ContentsChannelNode) -> ContentsChannelProjection {
  return ContentsChannelProjection {root: node.root, current: node.current, prefix: node.prefix,
    rootLift: Option<Prepared.ChannelLiftId>.none(), currentLift: Option<Prepared.ChannelLiftId>.none(),
    prefixRoot: Option<Prepared.ChannelLiftId>.none(), prefixCurrent: Option<Prepared.ChannelLiftId>.none()}
}

effect fn contentsChannelCursor(closure: &mut DescriptorClosure, rules: &mut Program,
  request: usize, point: ContentsChannelPoint, position: ContentsChannelPosition,
  root: Prepared.ResidualStateId, current: Prepared.ResidualStateId, prefix: Option<ContentsChannelPrefix>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let nodes = List<ContentsChannelNode>.asSlice(&closure.contentsChannelNodes)
  let mut node = usize.MAX
  let mut at = usize.ZERO
  while at < nodes.length {
    if nodes[at].request == request && sameContentsChannelPoint(nodes[at].point, point)
      && nodes[at].root.index == root.index && nodes[at].current.index == current.index
      && sameContentsChannelPrefix(nodes[at].prefix, prefix) { node = at }
    at = at + usize.ONE
  }
  if node == usize.MAX {
    node = nodes.length
    run List<ContentsChannelNode>.append(&mut closure.contentsChannelNodes,
      ContentsChannelNode {request: request, point: point, root: root, current: current, prefix: prefix})
  }
  let cursors = List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)
  at = usize.ZERO
  while at < cursors.length {
    if cursors[at].node == node && sameContentsChannelPosition(cursors[at].position, position) { return at }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut rules.*)
  run List<ContentsChannelCursor>.append(&mut closure.contentsChannelCursors,
    ContentsChannelCursor {node: node, position: position, active: active})
  return at
}

effect fn contentsChannelAdvance(closure: &mut DescriptorClosure, rules: &mut Program,
  source: usize, point: ContentsChannelPoint, position: ContentsChannelPosition,
  projection: ContentsChannelProjection, reverse: bool, witness: ContentsChannelWitness,
  guard: Atom, paired: Option<Atom>) -> () ! OutOfMemoryError ? &mut Allocator {
  let from = List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)[source]
  let old = List<ContentsChannelNode>.asSlice(&closure.contentsChannelNodes)[from.node]
  let target = run contentsChannelCursor(&mut closure.*, &mut rules.*, old.request, point, position, projection.root, projection.current, projection.prefix)
  let links = List<ContentsChannelLink>.asSlice(&closure.contentsChannelLinks)
  let mut at = usize.ZERO
  while at < links.length {
    let link = links[at]
    if link.source == source && link.target == target && sameContentsChannelWitness(link.witness, witness)
      && link.reverse == reverse && sameContentsChannelLift(link.root, projection.rootLift)
      && sameContentsChannelLift(link.current, projection.currentLift)
      && sameContentsChannelLift(link.prefixRoot, projection.prefixRoot)
      && sameContentsChannelLift(link.prefixCurrent, projection.prefixCurrent) { return () }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut rules.*)
  let mut gates = List<Atom>.make()
  run List<Atom>.append(&mut gates, from.active)
  run List<Atom>.append(&mut gates, guard)
  if let Option<Atom>.Some {value} = paired { run List<Atom>.append(&mut gates, value) }
  let empty = List<Atom>.make()
  run Program.rule(&mut rules.*, active, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  let admitted: [Atom; 1] = [active]
  run Program.rule(&mut rules.*, List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)[target].active,
    &admitted, List<Atom>.asSlice(&empty))
  run List<ContentsChannelLink>.append(&mut closure.contentsChannelLinks, ContentsChannelLink {
    source: source, target: target, witness: witness, root: projection.rootLift, current: projection.currentLift,
    prefixRoot: projection.prefixRoot, prefixCurrent: projection.prefixCurrent, reverse: reverse, active: active})
  return ()
}

// A reverse replay needs the direction-qualified frozen row for that SAME old output.
// It cannot reinterpret a Forward anchor or pair independently authored histories.
fn contentsChannelBoundary<'body>(prepared: &SourcePreparation<'body>, original: usize, reverse: bool) -> Option<usize> {
  let rows = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
  let old = &rows[original]
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let prior = &boundaries[old.boundary.index]
  let pair = boundaryLiftStates(old, boundaries)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = &rows[at]
    let direction = match row.direction {
      PreparedBoundaryLiftDirection.Forward => !reverse
      PreparedBoundaryLiftDirection.StorageAliasInverse => reverse && prior.authority == PreparedBoundaryAuthority.StorageAlias
      PreparedBoundaryLiftDirection.OriginInverse => reverse && prior.authority == PreparedBoundaryAuthority.Physical
    }
    if row.boundary.index == old.boundary.index && direction {
      if let PreparedBoundaryLiftStep.Stop {sourceState, targetState} = &row.step {
        if sourceState.index == pair.sourceState.index && targetState.index == pair.targetState.index {
          return Option<usize>.some(at)
        }
      }
    }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

effect fn contentsChannelProjections<'body>(prepared: &SourcePreparation<'body>, map: MapId,
  origin: PreparedChannelLiftOrigin, pair: &Prepared.BoundaryStop,
  root: Prepared.ResidualStateId, current: Prepared.ResidualStateId, reverse: bool)
  -> List<ContentsChannelProjection> ! OutOfMemoryError ? &mut Allocator {
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  let mut result = List<ContentsChannelProjection>.make()
  let mut at = usize.ZERO
  while at < lifts.length {
    let entry = &lifts[at]
    let mut later = entry.targetState
    let mut earlier = entry.sourceState
    if reverse { later = entry.sourceState earlier = entry.targetState }
    if entry.entry && entry.map.index == map.index && sameContentsChannelOrigin(entry.origin, origin)
      && entry.channel.sourceState.index == pair.sourceState.index && entry.channel.targetState.index == pair.targetState.index
      && later.index == root.index {
      let mut each = usize.ZERO
      while each < lifts.length {
        let suffix = &lifts[each]
        let mut later = suffix.targetState
        let mut earlierSuffix = suffix.sourceState
        if reverse { later = suffix.sourceState earlierSuffix = suffix.targetState }
        if later.index == current.index && contentsChannelLiftDescends(lifts,
          Prepared.ChannelLiftId {index: at}, Prepared.ChannelLiftId {index: each}, lifts.length) {
          run List<ContentsChannelProjection>.append(&mut result, ContentsChannelProjection {
            root: earlier, current: earlierSuffix, rootLift: Option<Prepared.ChannelLiftId>.some(Prepared.ChannelLiftId {index: at}),
            currentLift: Option<Prepared.ChannelLiftId>.some(Prepared.ChannelLiftId {index: each}),
            prefix: Option<ContentsChannelPrefix>.none(), prefixRoot: Option<Prepared.ChannelLiftId>.none(),
            prefixCurrent: Option<Prepared.ChannelLiftId>.none()})
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move result
}

effect fn contentsChannelTransport<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  rules: &mut Program, source: usize, point: ContentsChannelPoint, position: ContentsChannelPosition,
  map: MapId, origin: PreparedChannelLiftOrigin, pair: &Prepared.BoundaryStop,
  reverse: bool, witness: ContentsChannelWitness, guard: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let cursor = List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)[source]
  let node = List<ContentsChannelNode>.asSlice(&closure.contentsChannelNodes)[cursor.node]
  match node.prefix {
    Option<ContentsChannelPrefix>.None => {
      let projections = run contentsChannelProjections(prepared, map, origin, pair, node.root, node.current, reverse)
      let values = List<ContentsChannelProjection>.asSlice(&projections)
      let mut at = usize.ZERO
      while at < values.length {
        run contentsChannelAdvance(&mut closure.*, &mut rules.*, source, point, position, values[at], reverse, witness, guard, Option<Atom>.none())
        at = at + usize.ONE
      }
    }
    Option<ContentsChannelPrefix>.Some {value: prefix} => {
      // The relative family must name THIS exact Root/Boundary prefix pair. Neither
      // segment is published independently, so no OR of unrelated paths can join them.
      let prefixes = run contentsChannelProjections(prepared, map, origin, pair, prefix.root, prefix.current, reverse)
      let prefixesSelected = List<ContentsChannelProjection>.asSlice(&prefixes)
      let mut at = usize.ZERO
      while at < prefixesSelected.length {
        let first = prefixesSelected[at]
        let prefixRoot = match first.rootLift { Option<Prepared.ChannelLiftId>.Some {value} => value
          _ => { return CompilerBug.panic(b"segmented channel transport omitted its prefix root") } }
        let prefixCurrent = match first.currentLift { Option<Prepared.ChannelLiftId>.Some {value} => value
          _ => { return CompilerBug.panic(b"segmented channel transport omitted its prefix cursor") } }
        let relative = run contentsChannelProjections(prepared, map, PreparedChannelLiftOrigin.Projection {
          projection: prefix.projection, prefixRoot: prefixRoot, prefixCurrent: prefixCurrent}, pair, node.root, node.current, reverse)
        let relativeSelected = List<ContentsChannelProjection>.asSlice(&relative)
        let mut each = usize.ZERO
        while each < relativeSelected.length {
          let mut projected = relativeSelected[each]
          projected.prefix = Option<ContentsChannelPrefix>.some(ContentsChannelPrefix {
            projection: prefix.projection, root: first.root, current: first.current})
          projected.prefixRoot = first.rootLift
          projected.prefixCurrent = first.currentLift
          run contentsChannelAdvance(&mut closure.*, &mut rules.*, source, point, position,
            projected, reverse, witness, guard, Option<Atom>.none())
          each = each + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return ()
}

effect fn contentsChannelStop<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  rules: &mut Program, source: usize, point: ContentsChannelPoint, position: ContentsChannelPosition,
  stop: usize, reverse: bool, witness: ContentsChannelWitness, guard: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let selected = match contentsChannelBoundary(prepared, stop, reverse) {
    Option<usize>.Some {value} => value
    _ => { return () }
  }
  let row = &List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)[selected]
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let pair = boundaryLiftStates(row, boundaries)
  run contentsChannelTransport(&mut closure.*, prepared, &mut rules.*, source, point, position,
    boundaries[row.boundary.index].map, PreparedChannelLiftOrigin.Boundary {lift: selected}, &pair, reverse, witness, guard)
  return ()
}

// Walk original Contents membership, expanding a composite only into its already retained
// primitive replay graph. Both authored suffix cursors advance on ONE frozen lift family.
// There is no channel-output identity assumption and no recursively keyed replay history.
effect fn closeContentsChannelReplays<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let mut at = usize.ZERO
  while at < List<ContentsChannelCursor>.length(&closure.contentsChannelCursors) {
    let cursor = List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)[at]
    let node = List<ContentsChannelNode>.asSlice(&closure.contentsChannelNodes)[cursor.node]
    let request = List<ContentsChannelRequest>.asSlice(&closure.contentsChannelRequests)[node.request]
    let proof = List<ContentsChannelProof>.asSlice(&closure.contentsChannels)[request.proof]
    let identity = contentsChannelIdentity(node)
    match cursor.position {
      ContentsChannelPosition.Done => {
        let outputs = List<ContentsChannelOutput>.asSlice(&closure.contentsChannelOutputs)
        let mut found = false
        let mut each = usize.ZERO
        while each < outputs.length { if outputs[each].cursor == at { found = true } each = each + usize.ONE }
        if !found {
          run List<ContentsChannelOutput>.append(&mut closure.contentsChannelOutputs, ContentsChannelOutput {
            proof: request.proof, requestedRoot: request.requestedRoot, requested: request.requested,
            root: node.root, current: node.current, requestedPrefix: request.prefix, prefix: node.prefix, cursor: at, active: cursor.active})
        }
      }
      _ => {
        let mut terminal = usize.MAX
        let mut member = MapId {index: usize.ZERO}
        let mut stop = usize.ZERO
        match proof.authority {
          ContentsChannelAuthority.Selected {..} => ()
          ContentsChannelAuthority.Origin {node: matchedOriginalNode, member: id, stop: value} => { terminal = matchedOriginalNode member = id stop = value }
          ContentsChannelAuthority.Slice {node: matchedOriginalNode, member: id, stop: value} => { terminal = matchedOriginalNode member = id stop = value }
        }
        match cursor.position {
          ContentsChannelPosition.Start => {
            if terminal == usize.MAX {
              run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules, at, ContentsChannelPoint.Source,
                ContentsChannelPosition.Done, identity, false, ContentsChannelWitness.Selected, proof.identity, Option<Atom>.none())
            } else if request.reverse {
              let paired = &List<Prepared.BoundaryStop>.asSlice(&List<SelectionMap>.asSlice(&prepared.maps)[member.index].channelStops)[stop]
              run contentsChannelTransport(&mut closure.*, prepared, &mut skeleton.rules, at,
                ContentsChannelPoint.Original {node: terminal}, ContentsChannelPosition.Original {node: terminal},
                member, PreparedChannelLiftOrigin.Root, paired, true, ContentsChannelWitness.Start, proof.active)
            } else {
              let root = contentsOriginalRoot(&closure.*, terminal)
              run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules, at, ContentsChannelPoint.Original {node: root},
                ContentsChannelPosition.Original {node: root}, identity, false, ContentsChannelWitness.Start, proof.active, Option<Atom>.none())
            }
          }
          ContentsChannelPosition.Original {node: original} => {
            let root = contentsOriginalRoot(&closure.*, terminal)
            if (!request.reverse && original == terminal) || (request.reverse && original == root) {
              if request.reverse {
                run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules, at, ContentsChannelPoint.Source,
                  ContentsChannelPosition.Done, identity, false, ContentsChannelWitness.Finish, proof.active, Option<Atom>.none())
              } else {
                let paired = &List<Prepared.BoundaryStop>.asSlice(&List<SelectionMap>.asSlice(&prepared.maps)[member.index].channelStops)[stop]
                run contentsChannelTransport(&mut closure.*, prepared, &mut skeleton.rules, at, ContentsChannelPoint.Source,
                  ContentsChannelPosition.Done, member, PreparedChannelLiftOrigin.Root, paired, false, ContentsChannelWitness.Finish, proof.active)
              }
            }
            let count = List<ContentsStep>.length(&closure.contentsSteps)
            let mut each = usize.ZERO
            while each < count {
              let step = List<ContentsStep>.asSlice(&closure.contentsSteps)[each]
              let mut later = step.later
              let mut earlier = step.earlier
              if request.reverse { later = step.earlier earlier = step.later }
              if later == original {
                let carrier = CarriersProduct.edges(&closure.product)[step.carrier]
                let active = cases[carrier.case].active
                let point = ContentsChannelPoint.Original {node: earlier}
                let position = ContentsChannelPosition.Original {node: earlier}
                let witness = ContentsChannelWitness.Step {step: each}
                match step.lift {
                  ContentsLift.Publication => run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules,
                    at, point, position, identity, false, witness, active, Option<Atom>.none())
                  ContentsLift.OutputIdentity {..} => run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules,
                    at, point, position, identity, false, witness, active, Option<Atom>.none())
                  ContentsLift.Prepared {cursor: old, lift} => {
                    let channel = match &List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)[lift].step {
                      PreparedBoundaryLiftStep.Stop {..} => true _ => false
                    }
                    if !channel { return CompilerBug.panic(b"channel contents step substituted a physical suffix") }
                    let reverse = (old.direction == CarriersDirection.StorageInverse) != request.reverse
                    run contentsChannelStop(&mut closure.*, prepared, &mut skeleton.rules, at, point, position, lift, reverse, witness, active)
                  }
                  ContentsLift.CompositeIdentity {pair, ..} => {
                    let retained = List<Carriers.Pair>.asSlice(&closure.pairs)[pair]
                    let gate = List<ContentsProof>.asSlice(&closure.contentsProofs)[retained.proof].identity
                    run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules,
                      at, point, position, identity, false, witness, active, Option<Atom>.some(gate))
                  }
                  ContentsLift.Composite {result, ..} => {
                    let completed = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)[result]
                    let prior = List<ContentsReplay>.asSlice(&closure.contentsReplays)[completed.request]
                    let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
                    let mut start = prior.root
                    if request.reverse { start = end.node }
                    let old = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[start]
                    run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules, at, contentsChannelPrimitive(old),
                      ContentsChannelPosition.Expanded {step: each, result: result, node: start}, identity, false,
                      ContentsChannelWitness.Enter {step: each, result: result}, active, Option<Atom>.some(end.active))
                  }
                  ContentsLift.Next {..} => { return CompilerBug.panic(b"channel contents graph admitted a physical continuation") }
                }
              }
              each = each + usize.ONE
            }
          }
          ContentsChannelPosition.Expanded {step: stepId, result, node: oldNode} => {
            let step = List<ContentsStep>.asSlice(&closure.contentsSteps)[stepId]
            let completed = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)[result]
            let prior = List<ContentsReplay>.asSlice(&closure.contentsReplays)[completed.request]
            let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
            let mut finish = end.node
            let mut continuation = step.earlier
            if request.reverse { finish = prior.root continuation = step.later }
            if oldNode == finish {
              run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules, at,
                ContentsChannelPoint.Original {node: continuation}, ContentsChannelPosition.Original {node: continuation},
                identity, false, ContentsChannelWitness.Leave {step: stepId, result: result}, end.active, Option<Atom>.none())
            }
            let count = List<ContentsReplayArc>.length(&closure.contentsReplayArcs)
            let mut each = usize.ZERO
            while each < count {
              let arc = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)[each]
              let mut later = arc.later
              let mut earlier = arc.earlier
              if request.reverse { later = arc.earlier earlier = arc.later }
              if later == oldNode {
                let old = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[earlier]
                if old.request != completed.request { return CompilerBug.panic(b"channel expansion crossed original replay membership") }
                let point = contentsChannelPrimitive(old)
                let position = ContentsChannelPosition.Expanded {step: stepId, result: result, node: earlier}
                let witness = ContentsChannelWitness.Arc {arc: each}
                match arc.stop {
                  Option<usize>.Some {value} => {
                    run contentsChannelStop(&mut closure.*, prepared, &mut skeleton.rules, at, point, position,
                      value, arc.reverse != request.reverse, witness, arc.active)
                  }
                  Option<usize>.None => {
                    if let Option<Prepared.BoundaryTransitionId>.Some {..} = arc.boundary {
                      return CompilerBug.panic(b"semantic replay primitive substituted a physical continuation")
                    }
                    run contentsChannelAdvance(&mut closure.*, &mut skeleton.rules, at, point, position,
                      identity, false, witness, arc.active, Option<Atom>.none())
                  }
                }
              }
              each = each + usize.ONE
            }
          }
          ContentsChannelPosition.Done => ()
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Requests and outputs are interned independently from original graph membership. The
// consumer receives the exact composed root/current pair and its whole-path active gate.
effect fn contentsChannelRequestOutputs<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, proofId: usize, requestedRoot: Prepared.ResidualStateId,
  requested: Prepared.ResidualStateId, prefix: Option<ContentsChannelPrefix>) -> List<ContentsChannelOutput> ! OutOfMemoryError ? &mut Allocator {
  let proof = List<ContentsChannelProof>.asSlice(&closure.contentsChannels)[proofId]
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let contains = run contentsChannelSuffixContains(states, requestedRoot, requested)
  let mut parent = proof.target
  if let Option<ContentsChannelPrefix>.Some {value} = prefix {
    if value.projection.index >= List<Prepared.ContractProjection>.length(&prepared.contractProjections)
      || value.root.index >= states.length || value.current.index >= states.length {
      return CompilerBug.panic(b"contents prefix request escaped the frozen projection domain")
    }
    let prefixContains = run contentsChannelSuffixContains(states, value.root, value.current)
    if !contentsChannelPrefixValid(prepared, value)
      || states[value.root.index].input.shape.index != states[proof.target.index].output.index || !prefixContains {
      return CompilerBug.panic(b"contents prefix request changed its exact target anchor or suffix")
    }
    parent = value.current
  }
  if !authoredResidual(&states[requestedRoot.index]) || !authoredResidual(&states[requested.index])
    || states[requestedRoot.index].input.shape.index != states[parent.index].output.index || !contains {
    return CompilerBug.panic(b"contents channel output request changed its exact target anchor or suffix")
  }
  let requests = List<ContentsChannelRequest>.asSlice(&closure.contentsChannelRequests)
  let mut request = usize.MAX
  let mut at = usize.ZERO
  while at < requests.length {
    if requests[at].proof == proofId && requests[at].requestedRoot.index == requestedRoot.index
      && requests[at].requested.index == requested.index && sameContentsChannelPrefix(requests[at].prefix, prefix) { request = at }
    at = at + usize.ONE
  }
  if request == usize.MAX {
    request = requests.length
    let reverse = contentsAddressReverse(List<Case>.asSlice(&domain.cases)[proof.case].authority, proof.edge)
    let root = run contentsChannelCursor(&mut closure.*, &mut skeleton.rules, request, ContentsChannelPoint.Target,
      ContentsChannelPosition.Start, requestedRoot, requested, prefix)
    let gates: [Atom; 1] = [proof.active]
    let empty = List<Atom>.make()
    run Program.rule(&mut skeleton.rules, List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)[root].active,
      &gates, List<Atom>.asSlice(&empty))
    run List<ContentsChannelRequest>.append(&mut closure.contentsChannelRequests, ContentsChannelRequest {
      proof: proofId, requestedRoot: requestedRoot, requested: requested, prefix: prefix, reverse: reverse, root: root})
  }
  run closeContentsChannelReplays(&mut closure.*, prepared, &mut skeleton.*, domain)
  let mut result = List<ContentsChannelOutput>.make()
  let outputs = List<ContentsChannelOutput>.asSlice(&closure.contentsChannelOutputs)
  at = usize.ZERO
  while at < outputs.length {
    let cursor = List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)[outputs[at].cursor]
    if List<ContentsChannelNode>.asSlice(&closure.contentsChannelNodes)[cursor.node].request == request {
      run List<ContentsChannelOutput>.append(&mut result, outputs[at])
    }
    at = at + usize.ONE
  }
  return move result
}

// Both entry points use the same finite primitive graph and completion identities.
effect fn contentsChannelOutputs<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, proofId: usize, requestedRoot: Prepared.ResidualStateId,
  requested: Prepared.ResidualStateId) -> List<ContentsChannelOutput> ! OutOfMemoryError ? &mut Allocator {
  return run contentsChannelRequestOutputs(&mut closure.*, prepared, &mut skeleton.*, domain,
    proofId, requestedRoot, requested, Option<ContentsChannelPrefix>.none())
}
effect fn contentsChannelSegmentOutputs<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, proofId: usize, projection: Prepared.ContractProjectionId,
  prefixRoot: Prepared.ResidualStateId, prefixCurrent: Prepared.ResidualStateId,
  relativeRoot: Prepared.ResidualStateId, relativeCurrent: Prepared.ResidualStateId)
  -> List<ContentsChannelOutput> ! OutOfMemoryError ? &mut Allocator {
  return run contentsChannelRequestOutputs(&mut closure.*, prepared, &mut skeleton.*, domain,
    proofId, relativeRoot, relativeCurrent, Option<ContentsChannelPrefix>.some(ContentsChannelPrefix {
      projection: projection, root: prefixRoot, current: prefixCurrent}))
}

effect fn contentsProof<'body>(retained: &mut List<ContentsProof>, pairs: &mut List<Carriers.Pair>, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, edge: usize, before: Prepared.ResidualStateId,
  after: Prepared.ResidualStateId, authority: ContentsAuthority, gates: &[Atom], identityGates: &[Atom],
  identity: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if !contentsPhysicalState(prepared, before) || !contentsPhysicalState(prepared, after) {
    return CompilerBug.panic(b"physical contents cannot publish a semantic channel pair")
  }
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let mut at = usize.ZERO
  while at < cases.length {
    let actual = &cases[at]
    let mut source = before
    let mut target = after
    let mut matches = false
    match actual.authority {
      TransferAuthority.Address {edge: selected, direction} => {
        if direction == MapDirection.StorageInverse { source = after target = before }
        matches = selected == edge
      }
      _ => ()
    }
    // A residual pair is physical descriptor authority. Ownership histories can use
    // this same Address Case family for capture correspondence, but cannot enter the
    // backwards physical carrier product. Use its exact adapter admission here too.
    if matches {
      matches = match carrierAuthority(prepared, &skeleton.*, keys, actual) {
        CarriersAuthority.OriginContents {proof} => proof == edge
        _ => false
      }
    }
    if matches {
      let input = match actual.source { Option<usize>.Some {value} => value
        _ => { return CompilerBug.panic(b"contents authority appeared on a descriptor seed") } }
      if states[source.index].input.shape.index != valueShape(prepared, values[keys[input].value.index]).index
        || states[target.index].input.shape.index != valueShape(prepared, values[keys[actual.target].value.index]).index {
        return CompilerBug.panic(b"contents derivation changed its actual component shapes")
      }
      let proofs = List<ContentsProof>.asSlice(&retained.*)
      let mut found = false
      let mut prior = usize.ZERO
      while prior < proofs.length {
        let proof = proofs[prior]
        if proof.case == at && proof.edge == edge && proof.source.index == source.index
          && proof.target.index == target.index && sameContentsAuthority(proof.authority, authority) { found = true }
        prior = prior + usize.ONE
      }
      if !found {
        let proof = proofs.length
        let active = Program.atom(&mut skeleton.rules)
        let unchanged = Program.atom(&mut skeleton.rules)
        let empty = List<Atom>.make()
        run Program.rule(&mut skeleton.rules, active, gates, List<Atom>.asSlice(&empty))
        if identity { run Program.rule(&mut skeleton.rules, unchanged, identityGates, List<Atom>.asSlice(&empty)) }
        run List<ContentsProof>.append(&mut retained.*, ContentsProof {case: at, edge: edge,
          source: source, target: target, authority: authority, active: active, identity: unchanged})
        run List<Carriers.Pair>.append(&mut pairs.*, Carriers.Pair {case: at, originProof: edge,
          sourceState: source, targetState: target, proof: proof, active: active})
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// Output replay may select the root or represented inline descendants. Following another
// Referent/channel here would turn descriptor identity into an unauthenticated contents read.
effect fn contentsReplaySubject<'body>(prepared: &SourcePreparation<'body>, root: Prepared.ResidualStateId,
  wanted: Prepared.ResidualStateId) -> Option<Prepared.ResidualStateId> ! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let selected = &states[wanted.index]
  let mut pending = List<Prepared.ResidualStateId>.make()
  run List<Prepared.ResidualStateId>.append(&mut pending, root)
  let mut result = Option<Prepared.ResidualStateId>.none()
  let mut at = usize.ZERO
  while at < List<Prepared.ResidualStateId>.length(&pending) {
    let id = List<Prepared.ResidualStateId>.asSlice(&pending)[at]
    let state = &states[id.index]
    if state.selection.index == selected.selection.index && state.vertex.index == selected.vertex.index {
      if let Option<Prepared.ResidualStateId>.Some {value} = result {
        if value.index != id.index { return CompilerBug.panic(b"contents replay has ambiguous original subject coordinates") }
      }
      result = Option<Prepared.ResidualStateId>.some(id)
    }
    let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
    let mut each = usize.ZERO
    while each < next.length {
      let child = &states[next[each].index]
      if authoredResidual(child) && residualComponent(shapes, child.input).inline
        && !containsResidual(List<Prepared.ResidualStateId>.asSlice(&pending), next[each]) {
        run List<Prepared.ResidualStateId>.append(&mut pending, next[each])
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return result
}

fn sameContentsReplayPoint(left: ContentsReplayPoint, right: ContentsReplayPoint) -> bool {
  return match left {
    ContentsReplayPoint.Source => match right { ContentsReplayPoint.Source => true _ => false }
    ContentsReplayPoint.Target => match right { ContentsReplayPoint.Target => true _ => false }
    ContentsReplayPoint.Original {node} => match right { ContentsReplayPoint.Original {node: other} => node == other _ => false }
  }
}
fn sameContentsReplayPosition(left: ContentsReplayPosition, right: ContentsReplayPosition) -> bool {
  return match left {
    ContentsReplayPosition.Start => match right { ContentsReplayPosition.Start => true _ => false }
    ContentsReplayPosition.Done => match right { ContentsReplayPosition.Done => true _ => false }
    ContentsReplayPosition.Original {node} => match right { ContentsReplayPosition.Original {node: other} => node == other _ => false }
    ContentsReplayPosition.Expanded {expansion, node} => match right {
      ContentsReplayPosition.Expanded {expansion: other, node: otherNode} => expansion == other && node == otherNode _ => false
    }
  }
}
fn sameContentsReplayBoundary(left: Option<Prepared.BoundaryTransitionId>, right: Option<Prepared.BoundaryTransitionId>) -> bool {
  return match left {
    Option<Prepared.BoundaryTransitionId>.None => match right { Option<Prepared.BoundaryTransitionId>.None => true _ => false }
    Option<Prepared.BoundaryTransitionId>.Some {value} => match right {
      Option<Prepared.BoundaryTransitionId>.Some {value: other} => value.index == other.index _ => false
    }
  }
}
fn sameContentsReplayOrdinal(left: Option<usize>, right: Option<usize>) -> bool {
  return match left {
    Option<usize>.None => match right { Option<usize>.None => true _ => false }
    Option<usize>.Some {value} => match right { Option<usize>.Some {value: other} => value == other _ => false }
  }
}
fn sameContentsReplayWitness(left: ContentsReplayWitness, right: ContentsReplayWitness) -> bool {
  return match left {
    ContentsReplayWitness.Root => match right { ContentsReplayWitness.Root => true _ => false }
    ContentsReplayWitness.Step {step} => match right { ContentsReplayWitness.Step {step: other} => step == other _ => false }
    ContentsReplayWitness.Discharge {proof} => match right { ContentsReplayWitness.Discharge {proof: other} => proof == other _ => false }
    ContentsReplayWitness.Arc {arc} => match right { ContentsReplayWitness.Arc {arc: other} => arc == other _ => false }
    ContentsReplayWitness.Enter {expansion} => match right { ContentsReplayWitness.Enter {expansion: other} => expansion == other _ => false }
    ContentsReplayWitness.Leave {expansion} => match right { ContentsReplayWitness.Leave {expansion: other} => expansion == other _ => false }
  }
}

effect fn contentsReplayNode(closure: &mut DescriptorClosure, value: ContentsReplayNode) -> usize
! OutOfMemoryError ? &mut Allocator {
  let nodes = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)
  let mut at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at]
    if node.request == value.request && node.proof == value.proof && sameContentsReplayPoint(node.point, value.point)
      && node.subject.index == value.subject.index && node.state.index == value.state.index { return at }
    at = at + usize.ONE
  }
  let result = nodes.length
  run List<ContentsReplayNode>.append(&mut closure.contentsReplayNodes, value)
  return result
}
effect fn contentsReplayCursor(closure: &mut DescriptorClosure, rules: &mut Program,
  node: usize, position: ContentsReplayPosition) -> usize ! OutOfMemoryError ? &mut Allocator {
  let cursors = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)
  let mut at = usize.ZERO
  while at < cursors.length {
    if cursors[at].node == node && sameContentsReplayPosition(cursors[at].position, position) { return at }
    at = at + usize.ONE
  }
  let result = cursors.length
  let active = Program.atom(&mut rules.*)
  let identity = Program.atom(&mut rules.*)
  run List<ContentsReplayCursor>.append(&mut closure.contentsReplayCursors,
    ContentsReplayCursor {node: node, position: position, active: active, identity: identity})
  return result
}

// Each primitive arc retains every membership/proof contributor as a separate link. Arc
// identity is finite and contains no previous replay arc/node identity. Links may form cycles.
effect fn contentsReplayAdvance(closure: &mut DescriptorClosure, rules: &mut Program, source: usize,
  node: ContentsReplayNode, position: ContentsReplayPosition, projection: ContentsReplayProjection,
  reverse: bool, witness: ContentsReplayWitness, guard: Atom, paired: Option<Atom>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let from = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[source]
  let targetNode = run contentsReplayNode(&mut closure.*, node)
  let target = run contentsReplayCursor(&mut closure.*, &mut rules.*, targetNode, position)
  let arcs = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)
  let mut arc = usize.MAX
  let mut at = usize.ZERO
  while at < arcs.length {
    if arcs[at].later == from.node && arcs[at].earlier == targetNode && arcs[at].reverse == reverse
      && sameContentsReplayBoundary(arcs[at].boundary, projection.boundary)
      && sameContentsReplayOrdinal(arcs[at].stop, projection.stop) { arc = at }
    at = at + usize.ONE
  }
  if arc == usize.MAX {
    arc = arcs.length
    let active = Program.atom(&mut rules.*)
    run List<ContentsReplayArc>.append(&mut closure.contentsReplayArcs,
      ContentsReplayArc {later: from.node, earlier: targetNode, boundary: projection.boundary, stop: projection.stop, reverse: reverse, active: active})
  }
  let links = List<ContentsReplayLink>.asSlice(&closure.contentsReplayLinks)
  at = usize.ZERO
  while at < links.length {
    let link = links[at]
    if link.arc == arc && link.source == source && link.target == target && sameContentsReplayWitness(link.witness, witness)
      && sameContentsReplayBoundary(link.selected, projection.selected) && sameContentsReplayOrdinal(link.lift, projection.lift) { return () }
    at = at + usize.ONE
  }
  let to = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[target]
  let mut gates = List<Atom>.make()
  run List<Atom>.append(&mut gates, from.active)
  run List<Atom>.append(&mut gates, guard)
  if let Option<Atom>.Some {value} = paired { run List<Atom>.append(&mut gates, value) }
  let empty = List<Atom>.make()
  run Program.rule(&mut rules.*, to.active, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  run Program.rule(&mut rules.*, List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)[arc].active,
    List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  if projection.identity {
    let mutableRows7 = List<Atom>.asMutSlice(&mut gates)
    mutableRows7[usize.ZERO] = from.identity
    run Program.rule(&mut rules.*, to.identity, List<Atom>.asSlice(&gates), List<Atom>.asSlice(&empty))
  }
  run List<ContentsReplayLink>.append(&mut closure.contentsReplayLinks, ContentsReplayLink {
    arc: arc, source: source, target: target, witness: witness, selected: projection.selected, lift: projection.lift})
  return ()
}
fn contentsReplayIdentity(state: Prepared.ResidualStateId) -> ContentsReplayProjection {
  return ContentsReplayProjection {state: state, selected: Option<Prepared.BoundaryTransitionId>.none(),
    boundary: Option<Prepared.BoundaryTransitionId>.none(), lift: Option<usize>.none(), stop: Option<usize>.none(), identity: true}
}
fn contentsReplayBefore(pair: &Prepared.BoundaryTransition, reverse: bool) -> Prepared.ResidualStateId {
  if reverse { return pair.targetState }
  return pair.sourceState
}
fn contentsReplayAfter(pair: &Prepared.BoundaryTransition, reverse: bool) -> Prepared.ResidualStateId {
  if reverse { return pair.sourceState }
  return pair.targetState
}

// This helper is called only while replaying an exact actual composite Address proof.
// Reverse reads of retained pairs are internal proof composition, never Physical inverse
// Cases. An independently authored reverse suffix still requires its direction-qualified row.
effect fn contentsReplayProjections<'body>(prepared: &SourcePreparation<'body>, root: Prepared.BoundaryTransitionId,
  before: Prepared.ResidualStateId, after: Prepared.ResidualStateId, state: Prepared.ResidualStateId,
  reverse: bool) -> List<ContentsReplayProjection> ! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let pairs = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
  let mut result = List<ContentsReplayProjection>.make()
  let mut pending = List<Prepared.BoundaryTransitionId>.make()
  run List<Prepared.BoundaryTransitionId>.append(&mut pending, root)
  let mut at = usize.ZERO
  while at < List<Prepared.BoundaryTransitionId>.length(&pending) {
    let id = List<Prepared.BoundaryTransitionId>.asSlice(&pending)[at]
    let pair = &pairs[id.index]
    let next = List<Prepared.BoundaryTransitionId>.asSlice(&pair.next)
    if contentsReplayBefore(pair, reverse).index == before.index && contentsReplayAfter(pair, reverse).index == after.index {
      if states[state.index].input.shape.index != states[after.index].output.index || !authoredResidual(&states[state.index]) {
        return CompilerBug.panic(b"composite replay lost its exact later authored suffix")
      }
      if boundaryOutputIdentity(prepared, id) {
        let mut identity = contentsReplayIdentity(state)
        identity.selected = Option<Prepared.BoundaryTransitionId>.some(id)
        run List<ContentsReplayProjection>.append(&mut result, identity)
      }
      let mut each = usize.ZERO
      while each < next.length {
        let child = &pairs[next[each].index]
        if contentsReplayAfter(child, reverse).index == state.index && contentsPhysicalState(prepared, contentsReplayBefore(child, reverse)) {
          run List<ContentsReplayProjection>.append(&mut result, ContentsReplayProjection {
            state: contentsReplayBefore(child, reverse), selected: Option<Prepared.BoundaryTransitionId>.some(id),
            boundary: Option<Prepared.BoundaryTransitionId>.some(next[each]), lift: Option<usize>.none(), stop: Option<usize>.none(),
            identity: boundaryOutputIdentity(prepared, next[each])})
        }
        each = each + usize.ONE
      }
      each = usize.ZERO
      while each < lifts.length {
        let direction = match lifts[each].direction {
          PreparedBoundaryLiftDirection.Forward => !reverse
          PreparedBoundaryLiftDirection.StorageAliasInverse => reverse && pair.authority == PreparedBoundaryAuthority.StorageAlias
          PreparedBoundaryLiftDirection.OriginInverse => reverse && pair.authority == PreparedBoundaryAuthority.Physical
        }
        if lifts[each].boundary.index == id.index && direction {
          if let PreparedBoundaryLiftStep.Transition {id: child} = &lifts[each].step {
            if contentsReplayAfter(&pairs[child.index], reverse).index == state.index {
              run List<ContentsReplayProjection>.append(&mut result, ContentsReplayProjection {
                state: contentsReplayBefore(&pairs[child.index], reverse), selected: Option<Prepared.BoundaryTransitionId>.some(id),
                boundary: Option<Prepared.BoundaryTransitionId>.some(child), lift: Option<usize>.some(each), stop: Option<usize>.none(),
                identity: boundaryOutputIdentity(prepared, child)})
            }
          }
          if let PreparedBoundaryLiftStep.Stop {sourceState, targetState} = &lifts[each].step {
            let mut earlier = sourceState
            let mut later = targetState
            if reverse { earlier = targetState later = sourceState }
            if later.index == state.index {
              run List<ContentsReplayProjection>.append(&mut result, ContentsReplayProjection {
                state: earlier, selected: Option<Prepared.BoundaryTransitionId>.some(id),
                boundary: Option<Prepared.BoundaryTransitionId>.none(), lift: Option<usize>.some(each),
                stop: Option<usize>.some(each), identity: earlier.index == later.index})
            }
          }
        }
        each = each + usize.ONE
      }
    }
    let mut each = usize.ZERO
    while each < next.length {
      let child = &pairs[next[each].index]
      if residualComponent(shapes, states[child.sourceState.index].input).inline
        && residualComponent(shapes, states[child.targetState.index].input).inline {
        let ids = List<Prepared.BoundaryTransitionId>.asSlice(&pending)
        let mut found = false
        let mut prior = usize.ZERO
        while prior < ids.length { if ids[prior].index == next[each].index { found = true } prior = prior + usize.ONE }
        if !found { run List<Prepared.BoundaryTransitionId>.append(&mut pending, next[each]) }
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return move result
}

effect fn contentsReplayRequest(closure: &mut DescriptorClosure, skeleton: &mut Skeleton, domain: &Domain,
  proof: usize, source: Prepared.ResidualStateId, target: Prepared.ResidualStateId, state: Prepared.ResidualStateId) -> usize
! OutOfMemoryError ? &mut Allocator {
  let listed = List<ContentsReplay>.asSlice(&closure.contentsReplays)
  let mut at = usize.ZERO
  while at < listed.length {
    let request = listed[at]
    if request.proof == proof && request.source.index == source.index && request.target.index == target.index
      && request.state.index == state.index { return at }
    at = at + usize.ONE
  }
  let id = listed.length
  let original = List<ContentsProof>.asSlice(&closure.contentsProofs)[proof]
  let actual = &List<Case>.asSlice(&domain.cases)[original.case]
  let reverse = contentsAddressReverse(actual.authority, original.edge)
  let mut point = ContentsReplayPoint.Target
  if reverse { point = ContentsReplayPoint.Source }
  let root = run contentsReplayNode(&mut closure.*, ContentsReplayNode {
    request: id, proof: proof, point: point, subject: target, state: state})
  let cursor = run contentsReplayCursor(&mut closure.*, &mut skeleton.rules, root, ContentsReplayPosition.Start)
  let initial = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[cursor]
  let gates: [Atom; 2] = [original.active, actual.active]
  let empty = List<Atom>.make()
  run Program.rule(&mut skeleton.rules, initial.active, &gates, List<Atom>.asSlice(&empty))
  run Program.rule(&mut skeleton.rules, initial.identity, &gates, List<Atom>.asSlice(&empty))
  run List<ContentsReplay>.append(&mut closure.contentsReplays, ContentsReplay {
    proof: proof, source: source, target: target, state: state, reverse: reverse, root: root})
  return id
}

fn contentsOriginalRoot(closure: &DescriptorClosure, terminal: usize) -> usize {
  let nodes = List<ContentsNode>.asSlice(&closure.contents)
  let terminalNode = nodes[terminal]
  let carrier = CarriersProduct.nodes(&closure.product)[terminalNode.carrier]
  let demand = List<Carriers.Demand>.asSlice(&closure.demands)[carrier.demand]
  let carriers = CarriersProduct.nodes(&closure.product)
  let mut at = usize.ZERO
  let mut result = usize.MAX
  while at < nodes.length {
    let node = nodes[at]
    let actual = carriers[node.carrier]
    if node.edge == terminalNode.edge && node.target.index == terminalNode.target.index && node.state.index == terminalNode.target.index
      && actual.demand == carrier.demand && actual.cell == demand.cell && actual.state.index == demand.state.index {
      if result != usize.MAX { return CompilerBug.panic(b"composite replay has ambiguous original roots") }
      result = at
    }
    at = at + usize.ONE
  }
  if result == usize.MAX { return CompilerBug.panic(b"composite replay omitted its original root") }
  return result
}

effect fn contentsReplayRoot(closure: &DescriptorClosure, proof: ContentsProof) -> usize
! OutOfMemoryError ? &mut Allocator {
  return contentsOriginalRoot(closure, contentsTerminal(proof.authority))
}

effect fn contentsReplayTransport<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  rules: &mut Program, source: usize, destination: ContentsReplayNode, position: ContentsReplayPosition,
  boundary: Option<Prepared.BoundaryTransitionId>, reverse: bool, witness: ContentsReplayWitness,
  guard: Atom, paired: Option<Atom>) -> () ! OutOfMemoryError ? &mut Allocator {
  let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[source]
  let node = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
  let mut projections = List<ContentsReplayProjection>.make()
  match boundary {
    Option<Prepared.BoundaryTransitionId>.Some {value} => {
      projections = move run contentsReplayProjections(prepared, value, destination.subject, node.subject, node.state, reverse)
    }
    Option<Prepared.BoundaryTransitionId>.None => {
      // The caller supplies an actual complete identity witness/connector, not shape equality.
      if destination.subject.index != node.subject.index {
        return CompilerBug.panic(b"composite identity replay changed its exact selected subject")
      }
      run List<ContentsReplayProjection>.append(&mut projections, contentsReplayIdentity(node.state))
    }
  }
  let values = List<ContentsReplayProjection>.asSlice(&projections)
  let mut at = usize.ZERO
  while at < values.length {
    let mut target = destination
    target.state = values[at].state
    run contentsReplayAdvance(&mut closure.*, &mut rules.*, source, target, position, values[at], reverse, witness, guard, paired)
    at = at + usize.ONE
  }
  return ()
}

effect fn contentsReplayExpand(closure: &mut DescriptorClosure, rules: &mut Program, source: usize,
  step: usize, result: usize, reverse: bool, continuation: usize, subject: Prepared.ResidualStateId,
  guard: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[source]
  let current = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
  let completed = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)[result]
  let prior = List<ContentsReplay>.asSlice(&closure.contentsReplays)[completed.request]
  let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
  let mut start = prior.root
  let mut finish = end.node
  if reverse { start = end.node finish = prior.root }
  let values = List<ContentsReplayExpansion>.asSlice(&closure.contentsReplayExpansions)
  let mut expansion = usize.MAX
  let mut at = usize.ZERO
  while at < values.length {
    let value = values[at]
    if value.source == source && value.step == step && value.result == result && value.reverse == reverse
      && value.finish == finish && value.continuation == continuation && value.subject.index == subject.index { expansion = at }
    at = at + usize.ONE
  }
  if expansion == usize.MAX {
    expansion = values.length
    run List<ContentsReplayExpansion>.append(&mut closure.contentsReplayExpansions, ContentsReplayExpansion {
      source: source, step: step, result: result, reverse: reverse, finish: finish, continuation: continuation, subject: subject})
  }
  let old = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[start]
  let target = ContentsReplayNode {request: current.request, proof: old.proof,
    point: old.point, subject: current.subject, state: current.state}
  run contentsReplayAdvance(&mut closure.*, &mut rules.*, source, target,
    ContentsReplayPosition.Expanded {expansion: expansion, node: start}, contentsReplayIdentity(current.state), false,
    ContentsReplayWitness.Enter {expansion: expansion}, guard, Option<Atom>.some(end.active))
  return ()
}

// Replay nodes are normalized to original proof/point coordinates. Expansion cursors retain
// exact old graph membership separately; no node key contains an earlier replay node. All
// arcs are primitive paired transports or authenticated identity connectors, so projecting
// a previously projected graph needs no recursive path/authority representation.
effect fn closeContentsReplays<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let oldNodes = List<ContentsReplayNode>.length(&closure.contentsReplayNodes)
  let oldCursors = List<ContentsReplayCursor>.length(&closure.contentsReplayCursors)
  let oldLinks = List<ContentsReplayLink>.length(&closure.contentsReplayLinks)
  let oldResults = List<ContentsReplayResult>.length(&closure.contentsReplayResults)
  let actualCases = List<Case>.asSlice(&domain.cases)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let mut at = usize.ZERO
  while at < List<ContentsReplayCursor>.length(&closure.contentsReplayCursors) {
    let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[at]
    let node = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
    let request = List<ContentsReplay>.asSlice(&closure.contentsReplays)[node.request]
    let proof = List<ContentsProof>.asSlice(&closure.contentsProofs)[request.proof]
    if !authoredResidual(&states[node.state.index])
      || states[node.state.index].input.shape.index != states[node.subject.index].output.index {
      return CompilerBug.panic(b"contents replay lost its authored output subject")
    }
    match cursor.position {
      ContentsReplayPosition.Done => {
        let values = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)
        let mut found = false
        let mut each = usize.ZERO
        while each < values.length { if values[each].request == node.request && values[each].cursor == at { found = true } each = each + usize.ONE }
        if !found { run List<ContentsReplayResult>.append(&mut closure.contentsReplayResults, ContentsReplayResult {request: node.request, cursor: at}) }
      }
      ContentsReplayPosition.Start => {
        match proof.authority {
          ContentsAuthority.Selected {..} => {
            let mut destination = node
            destination.subject = request.source
            destination.point = ContentsReplayPoint.Source
            if request.reverse { destination.point = ContentsReplayPoint.Target }
            run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
              ContentsReplayPosition.Done, Option<Prepared.BoundaryTransitionId>.none(), false,
              ContentsReplayWitness.Root, proof.identity, Option<Atom>.none())
          }
          _ => {
            let terminal = contentsTerminal(proof.authority)
            let mut original = terminal
            if !request.reverse { original = run contentsReplayRoot(&closure.*, proof) }
            let old = List<ContentsNode>.asSlice(&closure.contents)[original]
            let subject = match move run contentsReplaySubject(prepared, old.state, node.subject) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"contents replay root lost its original selected subject") }
            }
            let destination = ContentsReplayNode {request: node.request, proof: request.proof,
              point: ContentsReplayPoint.Original {node: original}, subject: subject, state: node.state}
            let mut boundary = Option<Prepared.BoundaryTransitionId>.none()
            if request.reverse { boundary = Option<Prepared.BoundaryTransitionId>.some(contentsBoundary(proof.authority)) }
            run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
              ContentsReplayPosition.Original {node: original}, boundary, request.reverse,
              ContentsReplayWitness.Discharge {proof: request.proof}, proof.active, Option<Atom>.none())
          }
        }
      }
      ContentsReplayPosition.Original {node: original} => {
        let terminal = contentsTerminal(proof.authority)
        let root = run contentsReplayRoot(&closure.*, proof)
        let done = (!request.reverse && original == terminal) || (request.reverse && original == root)
        if done {
          let mut destination = node
          destination.point = ContentsReplayPoint.Source
          if request.reverse { destination.point = ContentsReplayPoint.Target }
          destination.subject = request.source
          let mut boundary = Option<Prepared.BoundaryTransitionId>.none()
          if !request.reverse {
            boundary = Option<Prepared.BoundaryTransitionId>.some(contentsBoundary(proof.authority))
          }
          run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
            ContentsReplayPosition.Done, boundary, false, ContentsReplayWitness.Discharge {proof: request.proof},
            proof.active, Option<Atom>.none())
        }
        let count = List<ContentsStep>.length(&closure.contentsSteps)
        let mut each = usize.ZERO
        while each < count {
          let step = List<ContentsStep>.asSlice(&closure.contentsSteps)[each]
          let mut later = step.later
          let mut earlier = step.earlier
          if request.reverse { later = step.earlier earlier = step.later }
          if later == original {
            let old = List<ContentsNode>.asSlice(&closure.contents)[earlier]
            let subject = match move run contentsReplaySubject(prepared, old.state, node.subject) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"contents step lost its paired selected descendant") }
            }
            let destination = ContentsReplayNode {request: node.request, proof: request.proof,
              point: ContentsReplayPoint.Original {node: earlier}, subject: subject, state: node.state}
            let carrier = CarriersProduct.edges(&closure.product)[step.carrier]
            let applicable = actualCases[carrier.case].active
            let mut boundary = Option<Prepared.BoundaryTransitionId>.none()
            let mut reverse = request.reverse
            let mut guard = Option<Atom>.none()
            let mut primitive = true
            match step.lift {
              ContentsLift.Publication => ()
              ContentsLift.OutputIdentity {..} => ()
              ContentsLift.Next {cursor: oldCursor, next} => {
                boundary = Option<Prepared.BoundaryTransitionId>.some(next)
                if oldCursor.direction == CarriersDirection.StorageInverse { reverse = !reverse }
              }
              ContentsLift.Prepared {cursor: oldCursor, lift} => {
                boundary = match &List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)[lift].step {
                  PreparedBoundaryLiftStep.Transition {id} => Option<Prepared.BoundaryTransitionId>.some(id)
                  _ => { return CompilerBug.panic(b"contents replay promoted a prepared channel stop") }
                }
                if oldCursor.direction == CarriersDirection.StorageInverse { reverse = !reverse }
              }
              ContentsLift.CompositeIdentity {pair, ..} => {
                let retained = List<Carriers.Pair>.asSlice(&closure.pairs)[pair]
                guard = Option<Atom>.some(List<ContentsProof>.asSlice(&closure.contentsProofs)[retained.proof].identity)
              }
              ContentsLift.Composite {result, ..} => {
                primitive = false
                run contentsReplayExpand(&mut closure.*, &mut skeleton.rules, at, each, result, request.reverse, earlier, subject, applicable)
              }
            }
            if primitive {
              run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
                ContentsReplayPosition.Original {node: earlier}, boundary, reverse,
                ContentsReplayWitness.Step {step: each}, applicable, guard)
            }
          }
          each = each + usize.ONE
        }
      }
      ContentsReplayPosition.Expanded {expansion: expansionId, node: oldNode} => {
        let expansion = List<ContentsReplayExpansion>.asSlice(&closure.contentsReplayExpansions)[expansionId]
        let old = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[oldNode]
        let completed = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)[expansion.result]
        let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
        if old.request != completed.request { return CompilerBug.panic(b"contents expansion crossed prior replay roots") }
        let selected = match move run contentsReplaySubject(prepared, old.state, node.subject) {
          Option<Prepared.ResidualStateId>.Some {value} => value
          _ => { return CompilerBug.panic(b"contents expansion lost its selected prior output") }
        }
        if selected.index != node.subject.index { return CompilerBug.panic(b"contents expansion changed its exact subject interpretation") }
        if oldNode == expansion.finish {
          if node.subject.index != expansion.subject.index { return CompilerBug.panic(b"contents expansion changed its continuation subject") }
          let destination = ContentsReplayNode {request: node.request, proof: request.proof,
            point: ContentsReplayPoint.Original {node: expansion.continuation}, subject: expansion.subject, state: node.state}
          run contentsReplayAdvance(&mut closure.*, &mut skeleton.rules, at, destination,
            ContentsReplayPosition.Original {node: expansion.continuation}, contentsReplayIdentity(node.state), false,
            ContentsReplayWitness.Leave {expansion: expansionId}, end.active, Option<Atom>.none())
        }
        let count = List<ContentsReplayArc>.length(&closure.contentsReplayArcs)
        let mut each = usize.ZERO
        while each < count {
          let arc = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)[each]
          let mut later = arc.later
          let mut earlier = arc.earlier
          if expansion.reverse { later = arc.earlier earlier = arc.later }
          if later == oldNode {
            // This expansion selects a physical subject of a physical ContentsProof.
            // Semantic-output graphs are expanded by closeContentsChannelReplays instead.
            if let Option<usize>.Some {..} = arc.stop {
              return CompilerBug.panic(b"physical contents expansion selected a semantic output graph")
            }
            let previous = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[earlier]
            if previous.request != completed.request { return CompilerBug.panic(b"primitive replay arc crossed its original graph") }
            let subject = match move run contentsReplaySubject(prepared, previous.state, node.subject) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"primitive replay arc lost paired authored descendants") }
            }
            let destination = ContentsReplayNode {request: node.request, proof: previous.proof,
              point: previous.point, subject: subject, state: node.state}
            let mut reverse = arc.reverse
            if expansion.reverse { reverse = !reverse }
            run contentsReplayTransport(&mut closure.*, prepared, &mut skeleton.rules, at, destination,
              ContentsReplayPosition.Expanded {expansion: expansionId, node: earlier}, arc.boundary, reverse,
              ContentsReplayWitness.Arc {arc: each}, arc.active, Option<Atom>.none())
          }
          each = each + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return oldNodes != List<ContentsReplayNode>.length(&closure.contentsReplayNodes)
    || oldCursors != List<ContentsReplayCursor>.length(&closure.contentsReplayCursors)
    || oldLinks != List<ContentsReplayLink>.length(&closure.contentsReplayLinks)
    || oldResults != List<ContentsReplayResult>.length(&closure.contentsReplayResults)
}

effect fn closeContents<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let oldNodes = List<ContentsNode>.length(&closure.contents)
  let oldSteps = List<ContentsStep>.length(&closure.contentsSteps)
  let oldProofs = List<ContentsProof>.length(&closure.contentsProofs)
  let oldReplays = List<ContentsReplay>.length(&closure.contentsReplays)
  let oldChannels = List<ContentsChannelProof>.length(&closure.contentsChannels)
  let oldChannelOutputs = List<ContentsChannelOutput>.length(&closure.contentsChannelOutputs)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let actualCases = List<Case>.asSlice(&domain.cases)
  let edgeCount = List<AliasEdge>.length(&skeleton.aliasEdges)
  let empty = List<Atom>.make()
  let mut edgeId = usize.ZERO
  while edgeId < edgeCount {
    let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
    match edge.authority {
      AliasAuthority.Selected {map, ..} => {
        let actual = &maps[map.index]
        let identity = match &actual.selector { Selector.Identity => true _ => false }
        // This is the actual SelectionUse's value/place-role crossing, not an arbitrary
        // same-shaped map. Its occurrence and family membership are validated separately.
        if actual.kind != MapKind.Select || !identity
          || endpoints[actual.source.index].shape.index != endpoints[actual.target.index].shape.index {
          return CompilerBug.panic(b"selected contents require explicit unchanged component authority")
        }
        let mut state = usize.ZERO
        while state < states.length {
          let id = Prepared.ResidualStateId {index: state}
          if states[state].input.shape.index == endpoints[actual.target.index].shape.index
            && contentsPhysicalState(prepared, id) {
            let gates: [Atom; 1] = [edge.active]
            run contentsProof(&mut closure.contentsProofs, &mut closure.pairs, prepared, &mut skeleton.*, domain, edgeId, id, id,
              ContentsAuthority.Selected {map: map}, &gates, &gates, true)
          }
          if states[state].input.shape.index == endpoints[actual.target.index].shape.index
            && contentsChannelState(prepared, id) {
            let gates: [Atom; 1] = [edge.active]
            run contentsChannelProof(&mut closure.*, prepared, &mut skeleton.*, domain, edgeId, id, id,
              ContentsChannelAuthority.Selected {map: map}, &gates, &gates, true)
          }
          state = state + usize.ONE
        }
      }
      _ => {
        if let Option<ContentsPlacement>.Some {value: placement} = contentsPlacement(&closure.*, edge.authority) {
          let nodes = CarriersProduct.nodes(&closure.product)
          let terminal = nodes[placement.carrier]
          let demand = List<Carriers.Demand>.asSlice(&closure.demands)[terminal.demand]
          let mut root = usize.MAX
          let mut each = usize.ZERO
          while each < nodes.length {
            if nodes[each].demand == terminal.demand && nodes[each].cell == demand.cell
              && nodes[each].state.index == demand.state.index { root = each }
            each = each + usize.ONE
          }
          if root == usize.MAX { return CompilerBug.panic(b"contents lost its actual carrier root") }
          let subject = match run contentsSubject(prepared, nodes[root].state, placement.state) {
            Option<Prepared.ResidualStateId>.Some {value} => value
            _ => { return CompilerBug.panic(b"contents selected output is absent from its carrier root") }
          }
          let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
          if states[subject.index].output.index != endpoints[alias.endpoint.index].shape.index {
            return CompilerBug.panic(b"contents root changed the queried output shape")
          }
          let mut state = usize.ZERO
          while state < states.length {
            let id = Prepared.ResidualStateId {index: state}
            if states[state].input.shape.index == states[subject.index].output.index
              && authoredResidual(&states[state]) {
              let before = List<ContentsNode>.length(&closure.contents)
              let node = run contentsNode(&mut closure.contents, &mut skeleton.rules, edgeId, id, root, id)
              if node == before {
                let actual = List<ContentsNode>.asSlice(&closure.contents)[node]
                let gates: [Atom; 2] = [demand.active, demand.reachable]
                run Program.rule(&mut skeleton.rules, actual.active, &gates, List<Atom>.asSlice(&empty))
                run Program.rule(&mut skeleton.rules, actual.identity, &gates, List<Atom>.asSlice(&empty))
              }
            }
            state = state + usize.ONE
          }
        }
      }
    }
    edgeId = edgeId + usize.ONE
  }

  let mut at = usize.ZERO
  while at < List<ContentsNode>.length(&closure.contents) {
    let node = List<ContentsNode>.asSlice(&closure.contents)[at]
    let aliasEdge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[node.edge]
    let placement = match contentsPlacement(&closure.*, aliasEdge.authority) {
      Option<ContentsPlacement>.Some {value} => value
      _ => { return CompilerBug.panic(b"contents carrier replay has no original address placement") }
    }
    let selected = match run contentsSubject(prepared, CarriersProduct.nodes(&closure.product)[node.carrier].state, placement.state) {
      Option<Prepared.ResidualStateId>.Some {value} => value
      _ => { return CompilerBug.panic(b"contents replay lost its selected outer subject") }
    }
    if states[node.state.index].input.shape.index != states[selected.index].output.index {
      return CompilerBug.panic(b"contents replay attached an unrelated later suffix")
    }
    let carrierEdgeCount = CarriersProduct.edges(&closure.product).length
    let mut each = usize.ZERO
    while each < carrierEdgeCount {
      let carrierEdge = CarriersProduct.edges(&closure.product)[each]
      if carrierEdge.later == node.carrier {
        let previous = match run contentsSubject(prepared, CarriersProduct.nodes(&closure.product)[carrierEdge.earlier].state, placement.state) {
          Option<Prepared.ResidualStateId>.Some {value} => value
          _ => { return CompilerBug.panic(b"contents replay changed its paired original suffix") }
        }
        let caseActive = actualCases[carrierEdge.case].active
        match carrierEdge.authority {
          CarriersEdgeAuthority.SameComponent => {
            if selected.index != previous.index {
              return CompilerBug.panic(b"same-component carrier changed its selected output")
            }
            run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, node.state,
              ContentsLift.Publication, caseActive, Option<Atom>.none(), true, Option<Atom>.none())
          }
          CarriersEdgeAuthority.Physical {boundary: cursor} => {
            // Locate a deeper selected subject through the retained PAIRED graph. Neither
            // side may advance independently, including equal-shaped sibling fields.
            let mut pending = List<Prepared.BoundaryTransitionId>.make()
            run List<Prepared.BoundaryTransitionId>.append(&mut pending, cursor.current)
            let mut pendingAt = usize.ZERO
            while pendingAt < List<Prepared.BoundaryTransitionId>.length(&pending) {
              let id = List<Prepared.BoundaryTransitionId>.asSlice(&pending)[pendingAt]
              let pair = &boundaries[id.index]
              let next = List<Prepared.BoundaryTransitionId>.asSlice(&pair.next)
              if boundaryAfter(pair, cursor.direction).index == selected.index
                && boundaryBefore(pair, cursor.direction).index == previous.index {
                let actualCursor = Carriers.BoundaryCursor {root: cursor.root, current: id, direction: cursor.direction}
                if boundaryOutputIdentity(prepared, id) {
                  run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, node.state,
                    ContentsLift.OutputIdentity {cursor: actualCursor}, caseActive, Option<Atom>.none(), true, Option<Atom>.none())
                }
                let mut following = usize.ZERO
                while following < next.length {
                  let child = &boundaries[next[following].index]
                  if boundaryAfter(child, cursor.direction).index == node.state.index {
                    run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, boundaryBefore(child, cursor.direction),
                      ContentsLift.Next {cursor: actualCursor, next: next[following]}, caseActive,
                      Option<Atom>.none(), boundaryOutputIdentity(prepared, next[following]), Option<Atom>.none())
                  }
                  following = following + usize.ONE
                }
                let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
                let mut lift = usize.ZERO
                while lift < lifts.length {
                  let permitted = match lifts[lift].direction {
                    PreparedBoundaryLiftDirection.Forward => cursor.direction == CarriersDirection.Forward
                    PreparedBoundaryLiftDirection.StorageAliasInverse => cursor.direction == CarriersDirection.StorageInverse
                    // Only the composite proof replay above may reverse an Origin leg.
                    PreparedBoundaryLiftDirection.OriginInverse => false
                  }
                  if lifts[lift].boundary.index == id.index && permitted {
                    match &lifts[lift].step {
                      PreparedBoundaryLiftStep.Transition {id: lifted} => {
                        let child = &boundaries[lifted.index]
                        if boundaryAfter(child, cursor.direction).index == node.state.index {
                          if cursor.direction == CarriersDirection.StorageInverse
                            && pair.authority != PreparedBoundaryAuthority.StorageAlias {
                            return CompilerBug.panic(b"physical output lift cannot supply inverse address authority")
                          }
                          run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules,
                            at, each, carrierEdge, boundaryBefore(child, cursor.direction),
                            ContentsLift.Prepared {cursor: actualCursor, lift: lift}, caseActive,
                            Option<Atom>.none(), boundaryOutputIdentity(prepared, lifted), Option<Atom>.none())
                        }
                      }
                      // The actual carrier Case and original Contents graph authenticate
                      // this semantic pair. It is never published as a physical Pair.
                      PreparedBoundaryLiftStep.Stop {sourceState, targetState} => {
                        let mut before = sourceState
                        let mut after = targetState
                        if cursor.direction == CarriersDirection.StorageInverse { before = targetState after = sourceState }
                        if after.index == node.state.index {
                          run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules,
                            at, each, carrierEdge, before, ContentsLift.Prepared {cursor: actualCursor, lift: lift},
                            caseActive, Option<Atom>.none(), before.index == after.index, Option<Atom>.none())
                        }
                      }
                    }
                  }
                  lift = lift + usize.ONE
                }
              }
              let mut following = usize.ZERO
              while following < next.length {
                let ids = List<Prepared.BoundaryTransitionId>.asSlice(&pending)
                let mut present = false
                let mut prior = usize.ZERO
                while prior < ids.length { if ids[prior].index == next[following].index { present = true } prior = prior + usize.ONE }
                if !present { run List<Prepared.BoundaryTransitionId>.append(&mut pending, next[following]) }
                following = following + usize.ONE
              }
              pendingAt = pendingAt + usize.ONE
            }
          }
          CarriersEdgeAuthority.OriginContents {pair: pairId} => {
            let pair = List<Carriers.Pair>.asSlice(&closure.pairs)[pairId]
            let retained = List<ContentsProof>.asSlice(&closure.contentsProofs)[pair.proof]
            // A previously derived COMPLETE output identity can carry a later independent
            // query. Its atom remains grounded in that proof, including every old Case.
            let mut exact = selected.index == pair.targetState.index && previous.index == pair.sourceState.index
            if !exact && selected.index == previous.index {
              exact = run contentsIdentityDescendant(prepared, pair.sourceState, pair.targetState, selected)
            }
            if exact && states[selected.index].output.index == states[previous.index].output.index {
              run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules, at, each, carrierEdge, node.state,
                ContentsLift.CompositeIdentity {pair: pairId, sourceSubject: previous, targetSubject: selected},
                caseActive, Option<Atom>.some(retained.identity), true, Option<Atom>.none())
            }
            // The prior actual proof, rather than equality of its outputs, is the
            // authority for a fresh suffix. Replay retains its original graph and every
            // primitive contributor, including further nonidentity composite steps.
            let sourceSubject = match move run contentsReplaySubject(prepared, pair.sourceState, previous) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"composite contents source is outside its original proof") }
            }
            let targetSubject = match move run contentsReplaySubject(prepared, pair.targetState, selected) {
              Option<Prepared.ResidualStateId>.Some {value} => value
              _ => { return CompilerBug.panic(b"composite contents target is outside its original proof") }
            }
            if sourceSubject.index != previous.index || targetSubject.index != selected.index {
              return CompilerBug.panic(b"composite contents changed its exact selected subject pair")
            }
            let request = run contentsReplayRequest(&mut closure.*, &mut skeleton.*, domain, pair.proof,
              previous, selected, node.state)
            let results = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)
            let mut result = usize.ZERO
            while result < results.length {
              if results[result].request == request {
                let cursor = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[results[result].cursor]
                let replayed = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)[cursor.node]
                let lift = ContentsLift.Composite {pair: pairId, sourceSubject: previous, targetSubject: selected, result: result}
                run contentsStep(&mut closure.contents, &mut closure.contentsSteps, &mut skeleton.rules,
                  at, each, carrierEdge, replayed.state, lift, caseActive, Option<Atom>.some(cursor.active), false, Option<Atom>.some(cursor.identity))
              }
              result = result + usize.ONE
            }
          }
        }
      }
      each = each + usize.ONE
    }

    if node.carrier == placement.carrier {
      if selected.index != placement.state.index { return CompilerBug.panic(b"contents discharge changed its selected family member") }
      let member = &maps[placement.member.index]
      let roots = List<Prepared.BoundaryTransitionId>.asSlice(&member.boundaries)
      let mut gates = List<Atom>.make()
      run List<Atom>.append(&mut gates, node.active)
      let mut sourceEndpoint = Option<EndpointId>.none()
      match aliasEdge.authority {
        AliasAuthority.Origin {placement: id} => {
          let origin = List<OriginPlacement>.asSlice(&closure.placements)[id]
          let proof = List<OriginProof>.asSlice(&closure.origins)[origin.proof]
          let reference = List<ReferenceOrigin>.asSlice(&skeleton.references)[proof.origin]
          validateReferenceMaps(endpoints, maps, reference.map, reference.referent)
          let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[origin.sourceAlias]
          if !sameSourceComponent(endpoints, alias.endpoint, member.source) {
            return CompilerBug.panic(b"origin contents discharge lost the Value/Storage role pair")
          }
          run List<Atom>.append(&mut gates, actualCases[proof.seed].active)
          run List<Atom>.append(&mut gates, List<StorageAlias>.asSlice(&skeleton.aliases)[proof.sourceAlias].active)
          run List<Atom>.append(&mut gates, alias.active)
          sourceEndpoint = Option<EndpointId>.some(alias.endpoint)
        }
        AliasAuthority.Slice {placement: id} => {
          let slice = List<SlicePlacement>.asSlice(&closure.slicePlacements)[id]
          let proof = List<SliceProof>.asSlice(&closure.sliceProofs)[slice.proof]
          let origin = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[slice.edge]
          let exact = match origin.authority { AliasAuthority.Origin {placement: matchedOriginPlacement} => matchedOriginPlacement == slice.origin _ => false }
          let source = match aliasEdge.source { Option<usize>.Some {value} => value
            _ => { return CompilerBug.panic(b"slice contents omitted its actual source Origin leg") } }
          let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[source]
          if !exact || source != origin.target || alias.endpoint.index != member.source.index {
            return CompilerBug.panic(b"slice contents discharge changed its exact element source address")
          }
          // The descriptor Case authenticates the conversion only. The inner leaf
          // reaches this edge from the preceding current-read Origin Address Case.
          run List<Atom>.append(&mut gates, actualCases[proof.case].active)
          run List<Atom>.append(&mut gates, proof.active)
          run List<Atom>.append(&mut gates, origin.active)
          sourceEndpoint = Option<EndpointId>.some(alias.endpoint)
        }
        _ => { return CompilerBug.panic(b"contents discharge has no original address authority") }
      }
      let source = match sourceEndpoint { Option<EndpointId>.Some {value} => value
        _ => { return CompilerBug.panic(b"contents discharge omitted its authenticated source endpoint") } }
      let channelStops = List<Prepared.BoundaryStop>.asSlice(&member.channelStops)
      let mut stop = usize.ZERO
      while stop < channelStops.length {
        let paired = &channelStops[stop]
        if paired.targetState.index == node.state.index {
          if states[paired.sourceState.index].input.shape.index != endpoints[source.index].shape.index {
            return CompilerBug.panic(b"channel contents discharge changed its source role")
          }
          let authority = match aliasEdge.authority {
            AliasAuthority.Origin {..} => ContentsChannelAuthority.Origin {node: at, member: placement.member, stop: stop}
            AliasAuthority.Slice {..} => ContentsChannelAuthority.Slice {node: at, member: placement.member, stop: stop}
            _ => { return CompilerBug.panic(b"channel contents omitted its actual address placement") }
          }
          let mut identityGates = List<Atom>.make()
          let active = List<Atom>.asSlice(&gates)
          let mut gate = usize.ZERO
          while gate < active.length {
            let mut value = active[gate]
            if gate == usize.ZERO { value = node.identity }
            run List<Atom>.append(&mut identityGates, value)
            gate = gate + usize.ONE
          }
          run contentsChannelProof(&mut closure.*, prepared, &mut skeleton.*, domain, node.edge,
            paired.sourceState, node.target, authority, active, List<Atom>.asSlice(&identityGates),
            paired.sourceState.index == paired.targetState.index)
        }
        stop = stop + usize.ONE
      }
      let mut root = usize.ZERO
      while root < roots.length {
        let pair = &boundaries[roots[root].index]
        if pair.targetState.index == node.state.index {
          if pair.map.index != placement.member.index
            || states[pair.sourceState.index].input.shape.index != endpoints[source.index].shape.index {
            return CompilerBug.panic(b"contents discharge substituted an unrelated family member")
          }
          let authority = match aliasEdge.authority {
            AliasAuthority.Origin {..} => ContentsAuthority.Origin {node: at, referent: roots[root]}
            AliasAuthority.Slice {..} => ContentsAuthority.Slice {node: at, element: roots[root]}
            _ => { return CompilerBug.panic(b"contents discharge lost its actual kind") }
          }
          let mut identityGates = List<Atom>.make()
          let active = List<Atom>.asSlice(&gates)
          let mut gate = usize.ZERO
          while gate < active.length {
            let mut value = active[gate]
            if gate == usize.ZERO { value = node.identity }
            run List<Atom>.append(&mut identityGates, value)
            gate = gate + usize.ONE
          }
          run contentsProof(&mut closure.contentsProofs, &mut closure.pairs, prepared, &mut skeleton.*, domain, node.edge, pair.sourceState, node.target,
            authority, active, List<Atom>.asSlice(&identityGates),
            boundaryOutputIdentity(prepared, roots[root]))
        }
        root = root + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let replayed = run closeContentsReplays(&mut closure.*, prepared, &mut skeleton.*, domain)
  run closeContentsChannelReplays(&mut closure.*, prepared, &mut skeleton.*, domain)
  return replayed || oldReplays != List<ContentsReplay>.length(&closure.contentsReplays)
    || oldNodes != List<ContentsNode>.length(&closure.contents)
    || oldSteps != List<ContentsStep>.length(&closure.contentsSteps)
    || oldProofs != List<ContentsProof>.length(&closure.contentsProofs)
    || oldChannels != List<ContentsChannelProof>.length(&closure.contentsChannels)
    || oldChannelOutputs != List<ContentsChannelOutput>.length(&closure.contentsChannelOutputs)
}

fn validateContentsReplays<'body>(prepared: &SourcePreparation<'body>, cases: &[Case], closure: &DescriptorClosure) -> () {
  let requests = List<ContentsReplay>.asSlice(&closure.contentsReplays)
  let nodes = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)
  let cursors = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)
  let arcs = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)
  let proofs = List<ContentsProof>.asSlice(&closure.contentsProofs)
  let originals = List<ContentsNode>.asSlice(&closure.contents)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let mut at = usize.ZERO
  while at < requests.length {
    let request = requests[at]
    if request.proof >= proofs.length || request.root >= nodes.length { CompilerBug.panic(b"contents replay lost its original authority") }
    let proof = proofs[request.proof]
    let reverse = contentsAddressReverse(cases[proof.case].authority, proof.edge)
    let root = nodes[request.root]
    let mut point = ContentsReplayPoint.Target
    if reverse { point = ContentsReplayPoint.Source }
    if reverse != request.reverse || root.request != at || root.proof != request.proof
      || !sameContentsReplayPoint(root.point, point) || root.subject.index != request.target.index
      || root.state.index != request.state.index {
      CompilerBug.panic(b"contents replay lost its exact root, direction or requested suffix")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at]
    if node.request >= requests.length || node.proof >= proofs.length || node.subject.index >= states.length
      || node.state.index >= states.length { CompilerBug.panic(b"contents replay node is outside its frozen product") }
    if !contentsPhysicalState(prepared, node.subject) || !authoredResidual(&states[node.state.index])
      || states[node.state.index].input.shape.index != states[node.subject.index].output.index {
      CompilerBug.panic(b"contents replay node lost its exact authored output component")
    }
    if let ContentsReplayPoint.Original {node: original} = node.point {
      if original >= originals.length || originals[original].edge != proofs[node.proof].edge {
        CompilerBug.panic(b"contents replay point changed its original graph authority")
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < arcs.length {
    let arc = arcs[at]
    if arc.later >= nodes.length || arc.earlier >= nodes.length { CompilerBug.panic(b"contents replay arc has an absent point") }
    let later = nodes[arc.later]
    let earlier = nodes[arc.earlier]
    if later.request != earlier.request { CompilerBug.panic(b"contents replay arc crossed requested histories") }
    if let Option<usize>.Some {value: stop} = arc.stop {
      let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
      if stop >= lifts.length { CompilerBug.panic(b"contents replay lost its exact channel stop") }
      let paired = boundaryLiftStates(&lifts[stop], boundaries)
      let mut before = paired.sourceState
      let mut after = paired.targetState
      if arc.reverse { before = paired.targetState after = paired.sourceState }
      let channel = match &lifts[stop].step { PreparedBoundaryLiftStep.Stop {..} => true _ => false }
      if !channel || before.index != earlier.state.index || after.index != later.state.index {
        CompilerBug.panic(b"contents replay channel stop changed its paired authored states")
      }
      if let Option<Prepared.BoundaryTransitionId>.Some {..} = arc.boundary {
        CompilerBug.panic(b"contents replay made a channel stop physical")
      }
    }
    match arc.boundary {
      Option<Prepared.BoundaryTransitionId>.Some {value} => {
        if value.index >= boundaries.length { CompilerBug.panic(b"contents replay arc invented a paired boundary") }
        let pair = &boundaries[value.index]
        if contentsReplayBefore(pair, arc.reverse).index != earlier.state.index
          || contentsReplayAfter(pair, arc.reverse).index != later.state.index {
          CompilerBug.panic(b"contents replay arc changed its exact paired orientation")
        }
      }
      Option<Prepared.BoundaryTransitionId>.None => {
        if let Option<usize>.None = arc.stop {
          if earlier.state.index != later.state.index { CompilerBug.panic(b"contents identity arc changed its authored suffix") }
        }
      }
    }
    at = at + usize.ONE
  }
  let links = List<ContentsReplayLink>.asSlice(&closure.contentsReplayLinks)
  at = usize.ZERO
  while at < links.length {
    let link = links[at]
    if link.arc >= arcs.length || link.source >= cursors.length || link.target >= cursors.length {
      CompilerBug.panic(b"contents replay link lost its original membership")
    }
    let arc = arcs[link.arc]
    if cursors[link.source].node != arc.later || cursors[link.target].node != arc.earlier {
      CompilerBug.panic(b"contents replay link crossed membership cursors")
    }
    if let Option<Prepared.BoundaryTransitionId>.Some {value} = link.selected {
      if value.index >= boundaries.length { CompilerBug.panic(b"contents replay link lost its selected boundary") }
      let pair = &boundaries[value.index]
      if contentsReplayBefore(pair, arc.reverse).index != nodes[arc.earlier].subject.index
        || contentsReplayAfter(pair, arc.reverse).index != nodes[arc.later].subject.index {
        CompilerBug.panic(b"contents replay link changed its selected paired subjects")
      }
      if let Option<usize>.Some {value: lift} = link.lift {
        let lifts = List<Prepared.BoundaryLift>.asSlice(&prepared.boundaryLifts)
        if lift >= lifts.length { CompilerBug.panic(b"contents replay link lost its prepared output row") }
        let row = &lifts[lift]
        let exact = match &row.step {
          PreparedBoundaryLiftStep.Transition {id} => sameContentsReplayBoundary(arc.boundary, Option<Prepared.BoundaryTransitionId>.some(id))
          PreparedBoundaryLiftStep.Stop {..} => sameContentsReplayOrdinal(arc.stop, Option<usize>.some(lift))
        }
        let direction = match row.direction {
          PreparedBoundaryLiftDirection.Forward => !arc.reverse
          PreparedBoundaryLiftDirection.StorageAliasInverse => arc.reverse && pair.authority == PreparedBoundaryAuthority.StorageAlias
          PreparedBoundaryLiftDirection.OriginInverse => arc.reverse && pair.authority == PreparedBoundaryAuthority.Physical
        }
        if row.boundary.index != value.index || !exact || !direction { CompilerBug.panic(b"contents replay link substituted an output lift") }
      }
    }
    at = at + usize.ONE
  }
  let results = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)
  let steps = List<ContentsStep>.asSlice(&closure.contentsSteps)
  let pairs = List<Carriers.Pair>.asSlice(&closure.pairs)
  at = usize.ZERO
  while at < steps.length {
    let step = steps[at]
    if let ContentsLift.Composite {pair, sourceSubject, targetSubject, result} = step.lift {
      if pair >= pairs.length || result >= results.length || step.later >= originals.length
        || step.earlier >= originals.length { CompilerBug.panic(b"composite contents step lost its retained proof") }
      let completed = results[result]
      if completed.request >= requests.length || completed.cursor >= cursors.length {
        CompilerBug.panic(b"composite contents step lost its replay result")
      }
      let request = requests[completed.request]
      let previous = nodes[cursors[completed.cursor].node]
      let carrier = CarriersProduct.edges(&closure.product)[step.carrier]
      if request.proof != pairs[pair].proof || request.source.index != sourceSubject.index
        || request.target.index != targetSubject.index || request.state.index != originals[step.later].state.index
        || previous.state.index != originals[step.earlier].state.index || carrier.case != pairs[pair].case {
        CompilerBug.panic(b"composite contents step changed its occurrence or selected output proof")
      }
    }
    at = at + usize.ONE
  }
  let expansions = List<ContentsReplayExpansion>.asSlice(&closure.contentsReplayExpansions)
  at = usize.ZERO
  while at < expansions.length {
    let expansion = expansions[at]
    if expansion.source >= cursors.length || expansion.step >= steps.length || expansion.result >= results.length
      || expansion.finish >= nodes.length || expansion.continuation >= originals.length {
      CompilerBug.panic(b"contents expansion lost its original finite coordinates")
    }
    let original = match cursors[expansion.source].position {
      ContentsReplayPosition.Original {node} => node
      _ => { return CompilerBug.panic(b"contents expansion recursively keyed another expansion") }
    }
    let step = steps[expansion.step]
    let mut later = step.later
    let mut earlier = step.earlier
    if expansion.reverse { later = step.earlier earlier = step.later }
    let retained = match step.lift { ContentsLift.Composite {result, ..} => result == expansion.result _ => false }
    if !retained || original != later || expansion.continuation != earlier {
      CompilerBug.panic(b"contents expansion changed its original step membership")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < results.length {
    let result = results[at]
    if result.request >= requests.length || result.cursor >= cursors.length { CompilerBug.panic(b"contents replay result lost its request") }
    let cursor = cursors[result.cursor]
    let node = nodes[cursor.node]
    let request = requests[result.request]
    let done = match cursor.position { ContentsReplayPosition.Done => true _ => false }
    let mut point = ContentsReplayPoint.Source
    if request.reverse { point = ContentsReplayPoint.Target }
    if !done || node.request != result.request || node.proof != request.proof
      || node.subject.index != request.source.index || !sameContentsReplayPoint(node.point, point) {
      CompilerBug.panic(b"contents replay result changed its original source endpoint")
    }
    at = at + usize.ONE
  }
  return ()
}

fn contentsAddressReverse(authority: TransferAuthority, originalEdge: usize) -> bool {
  match authority {
    TransferAuthority.Address {edge, direction} => {
      if edge != originalEdge { return CompilerBug.panic(b"contents replay changed its original Address edge") }
      return direction == MapDirection.StorageInverse
    }
    _ => { return CompilerBug.panic(b"contents replay has no actual Address authority") }
  }
}

fn contentsChannelNodeState(closure: &DescriptorClosure, node: ContentsChannelNode) -> Prepared.ResidualStateId {
  let request = List<ContentsChannelRequest>.asSlice(&closure.contentsChannelRequests)[node.request]
  let proof = List<ContentsChannelProof>.asSlice(&closure.contentsChannels)[request.proof]
  return match node.point {
    ContentsChannelPoint.Source => proof.source
    ContentsChannelPoint.Target => proof.target
    ContentsChannelPoint.Original {node: matchedNode} => List<ContentsNode>.asSlice(&closure.contents)[matchedNode].state
    ContentsChannelPoint.Primitive {channel, ..} => channel
  }
}
fn contentsChannelOriginalPosition(position: ContentsChannelPosition) -> usize {
  return match position {
    ContentsChannelPosition.Original {node} => node
    _ => CompilerBug.panic(b"channel replay left its original Contents membership")
  }
}
fn contentsChannelExpandedPosition(position: ContentsChannelPosition, step: usize, result: usize) -> usize {
  return match position {
    ContentsChannelPosition.Expanded {step: actual, result: selected, node} => {
      if actual != step || selected != result { return CompilerBug.panic(b"channel replay crossed composite membership") }
      return node
    }
    _ => CompilerBug.panic(b"channel replay lost its primitive graph membership")
  }
}
fn validateContentsChannelLiftPair(lifts: &[Prepared.ChannelLift], root: Prepared.ChannelLiftId,
  current: Prepared.ChannelLiftId, origin: PreparedChannelLiftOrigin, reverse: bool,
  laterRoot: Prepared.ResidualStateId, laterCurrent: Prepared.ResidualStateId,
  earlierRoot: Prepared.ResidualStateId, earlierCurrent: Prepared.ResidualStateId) -> () {
  if root.index >= lifts.length || current.index >= lifts.length || !lifts[root.index].entry
    || !sameContentsChannelOrigin(lifts[root.index].origin, origin)
    || !sameContentsChannelOrigin(lifts[current.index].origin, origin)
    || !contentsChannelLiftDescends(lifts, root, current, lifts.length) {
    CompilerBug.panic(b"channel replay cross-paired independent segment lift families")
  }
  let entry = &lifts[root.index]
  let suffix = &lifts[current.index]
  if entry.map.index != suffix.map.index || entry.channel.sourceState.index != suffix.channel.sourceState.index
    || entry.channel.targetState.index != suffix.channel.targetState.index {
    CompilerBug.panic(b"channel segment changed its exact map or channel pair")
  }
  let mut before = entry.sourceState
  let mut after = entry.targetState
  let mut beforeCurrent = suffix.sourceState
  let mut afterCurrent = suffix.targetState
  if reverse {
    before = entry.targetState after = entry.sourceState
    beforeCurrent = suffix.targetState afterCurrent = suffix.sourceState
  }
  if before.index != earlierRoot.index || after.index != laterRoot.index
    || beforeCurrent.index != earlierCurrent.index || afterCurrent.index != laterCurrent.index {
    CompilerBug.panic(b"channel replay changed its exact oriented segment coordinates")
  }
  return ()
}

fn validateContentsChannelReplays<'body>(prepared: &SourcePreparation<'body>, cases: &[Case], closure: &DescriptorClosure) -> () {
  let requests = List<ContentsChannelRequest>.asSlice(&closure.contentsChannelRequests)
  let nodes = List<ContentsChannelNode>.asSlice(&closure.contentsChannelNodes)
  let cursors = List<ContentsChannelCursor>.asSlice(&closure.contentsChannelCursors)
  let proofs = List<ContentsChannelProof>.asSlice(&closure.contentsChannels)
  let originals = List<ContentsNode>.asSlice(&closure.contents)
  let steps = List<ContentsStep>.asSlice(&closure.contentsSteps)
  let oldNodes = List<ContentsReplayNode>.asSlice(&closure.contentsReplayNodes)
  let results = List<ContentsReplayResult>.asSlice(&closure.contentsReplayResults)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  let mut at = usize.ZERO
  while at < requests.length {
    let request = requests[at]
    if request.proof >= proofs.length || request.root >= cursors.length { CompilerBug.panic(b"channel replay omitted its original proof or root") }
    let proof = proofs[request.proof]
    let reverse = contentsAddressReverse(cases[proof.case].authority, proof.edge)
    let cursor = cursors[request.root]
    if cursor.node >= nodes.length { CompilerBug.panic(b"channel replay root omitted its normalized point") }
    let node = nodes[cursor.node]
    let start = match cursor.position { ContentsChannelPosition.Start => true _ => false }
    if !start || !sameContentsChannelPoint(node.point, ContentsChannelPoint.Target) || node.request != at
      || reverse != request.reverse || node.root.index != request.requestedRoot.index || node.current.index != request.requested.index
      || !sameContentsChannelPrefix(node.prefix, request.prefix) {
      CompilerBug.panic(b"channel replay changed its requested paired suffix or original direction")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < cursors.length {
    let cursor = cursors[at]
    if cursor.node >= nodes.length { CompilerBug.panic(b"channel replay cursor omitted its normalized point") }
    let node = nodes[cursor.node]
    if node.request >= requests.length || node.root.index >= states.length || node.current.index >= states.length {
      CompilerBug.panic(b"channel replay escaped its frozen paired suffix domain")
    }
    let proof = proofs[requests[node.request].proof]
    match cursor.position {
      ContentsChannelPosition.Start => {
        if !sameContentsChannelPoint(node.point, ContentsChannelPoint.Target) { CompilerBug.panic(b"channel replay changed its target point") }
      }
      ContentsChannelPosition.Done => {
        if !sameContentsChannelPoint(node.point, ContentsChannelPoint.Source) { CompilerBug.panic(b"channel replay changed its source point") }
      }
      ContentsChannelPosition.Original {node: original} => {
        if original >= originals.length || originals[original].edge != proof.edge
          || !sameContentsChannelPoint(node.point, ContentsChannelPoint.Original {node: original}) {
          CompilerBug.panic(b"channel replay substituted an original Contents node")
        }
      }
      ContentsChannelPosition.Expanded {step, result, node: old} => {
        if step >= steps.length || result >= results.length || old >= oldNodes.length {
          CompilerBug.panic(b"channel replay lost its original primitive coordinates")
        }
        let exact = match steps[step].lift { ContentsLift.Composite {result: selected, ..} => result == selected _ => false }
        if !exact || oldNodes[old].request != results[result].request
          || !sameContentsChannelPoint(node.point, contentsChannelPrimitive(oldNodes[old])) {
          CompilerBug.panic(b"channel replay cross-paired primitive graph membership")
        }
      }
    }
    let channel = contentsChannelNodeState(closure, node)
    let mut parent = channel
    match node.prefix {
      Option<ContentsChannelPrefix>.None => {
        if let Option<ContentsChannelPrefix>.Some {..} = requests[node.request].prefix {
          CompilerBug.panic(b"channel replay erased its separate projection prefix")
        }
      }
      Option<ContentsChannelPrefix>.Some {value} => {
        let original = match requests[node.request].prefix { Option<ContentsChannelPrefix>.Some {value: matchedRequestedPrefix} => matchedRequestedPrefix
          _ => { return CompilerBug.panic(b"channel replay invented a projection prefix") } }
        if value.projection.index != original.projection.index || !contentsChannelPrefixValid(prepared, value)
          || states[value.root.index].input.shape.index != states[channel.index].output.index {
          CompilerBug.panic(b"channel replay changed its exact original projection prefix")
        }
        parent = value.current
      }
    }
    if !contentsChannelState(prepared, channel) || !authoredResidual(&states[node.root.index])
      || !authoredResidual(&states[node.current.index]) || states[node.root.index].input.shape.index != states[parent.index].output.index {
      CompilerBug.panic(b"channel replay changed its exact authored output subject")
    }
    at = at + usize.ONE
  }
  let links = List<ContentsChannelLink>.asSlice(&closure.contentsChannelLinks)
  at = usize.ZERO
  while at < links.length {
    let link = links[at]
    if link.source >= cursors.length || link.target >= cursors.length { CompilerBug.panic(b"channel replay link omitted membership cursors") }
    let from = cursors[link.source]
    let into = cursors[link.target]
    let later = nodes[from.node]
    let earlier = nodes[into.node]
    if later.request != earlier.request { CompilerBug.panic(b"channel replay link crossed independent requests") }
    let request = requests[later.request]
    let proof = proofs[request.proof]
    let mut terminal = usize.MAX
    let mut member = MapId {index: usize.ZERO}
    let mut stop = usize.ZERO
    match proof.authority {
      ContentsChannelAuthority.Selected {..} => ()
      ContentsChannelAuthority.Origin {node, member: id, stop: value} => { terminal = node member = id stop = value }
      ContentsChannelAuthority.Slice {node, member: id, stop: value} => { terminal = node member = id stop = value }
    }
    let mut origin = Option<PreparedChannelLiftOrigin>.none()
    let mut expectedReverse = false
    match link.witness {
      ContentsChannelWitness.Selected => {
        let start = match from.position { ContentsChannelPosition.Start => true _ => false }
        let done = match into.position { ContentsChannelPosition.Done => true _ => false }
        if terminal != usize.MAX || !start || !done { CompilerBug.panic(b"channel replay invented selected identity") }
      }
      ContentsChannelWitness.Start => {
        let start = match from.position { ContentsChannelPosition.Start => true _ => false }
        let original = contentsChannelOriginalPosition(into.position)
        let mut expected = contentsOriginalRoot(closure, terminal)
        if request.reverse {
          expected = terminal
          origin = Option<PreparedChannelLiftOrigin>.some(PreparedChannelLiftOrigin.Root)
          expectedReverse = true
        }
        if !start || original != expected { CompilerBug.panic(b"channel replay changed its original entry") }
      }
      ContentsChannelWitness.Finish => {
        let done = match into.position { ContentsChannelPosition.Done => true _ => false }
        let original = contentsChannelOriginalPosition(from.position)
        let mut expected = terminal
        if request.reverse { expected = contentsOriginalRoot(closure, terminal) }
        else { origin = Option<PreparedChannelLiftOrigin>.some(PreparedChannelLiftOrigin.Root) }
        if !done || original != expected { CompilerBug.panic(b"channel replay changed its original discharge") }
      }
      ContentsChannelWitness.Step {step: id} => {
        if id >= steps.length { CompilerBug.panic(b"channel replay invented an original step") }
        let step = steps[id]
        let mut source = step.later
        let mut target = step.earlier
        if request.reverse { source = step.earlier target = step.later }
        if contentsChannelOriginalPosition(from.position) != source || contentsChannelOriginalPosition(into.position) != target {
          CompilerBug.panic(b"channel replay changed an original step's membership")
        }
        match step.lift {
          ContentsLift.Publication => ()
          ContentsLift.OutputIdentity {..} => ()
          ContentsLift.CompositeIdentity {..} => ()
          ContentsLift.Prepared {cursor, lift} => {
            expectedReverse = (cursor.direction == CarriersDirection.StorageInverse) != request.reverse
            let selected = match contentsChannelBoundary(prepared, lift, expectedReverse) {
              Option<usize>.Some {value} => value
              _ => { return CompilerBug.panic(b"channel replay has no direction-qualified original stop") }
            }
            origin = Option<PreparedChannelLiftOrigin>.some(PreparedChannelLiftOrigin.Boundary {lift: selected})
          }
          _ => CompilerBug.panic(b"channel replay bypassed a composite or physical step")
        }
      }
      ContentsChannelWitness.Enter {step: id, result} => {
        let step = steps[id]
        let completed = results[result]
        let prior = List<ContentsReplay>.asSlice(&closure.contentsReplays)[completed.request]
        let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
        let mut source = step.later
        let mut target = prior.root
        if request.reverse { source = step.earlier target = end.node }
        if contentsChannelOriginalPosition(from.position) != source
          || contentsChannelExpandedPosition(into.position, id, result) != target {
          CompilerBug.panic(b"channel replay changed its exact composite entry")
        }
      }
      ContentsChannelWitness.Leave {step: id, result} => {
        let step = steps[id]
        let completed = results[result]
        let prior = List<ContentsReplay>.asSlice(&closure.contentsReplays)[completed.request]
        let end = List<ContentsReplayCursor>.asSlice(&closure.contentsReplayCursors)[completed.cursor]
        let mut source = end.node
        let mut target = step.earlier
        if request.reverse { source = prior.root target = step.later }
        if contentsChannelExpandedPosition(from.position, id, result) != source
          || contentsChannelOriginalPosition(into.position) != target {
          CompilerBug.panic(b"channel replay changed its exact composite continuation")
        }
      }
      ContentsChannelWitness.Arc {arc: id} => {
        let arc = List<ContentsReplayArc>.asSlice(&closure.contentsReplayArcs)[id]
        let step = match from.position { ContentsChannelPosition.Expanded {step, ..} => step
          _ => { return CompilerBug.panic(b"channel primitive lost its original membership") } }
        let result = match from.position { ContentsChannelPosition.Expanded {result, ..} => result
          _ => { return CompilerBug.panic(b"channel primitive lost its original result") } }
        let mut source = arc.later
        let mut target = arc.earlier
        if request.reverse { source = arc.earlier target = arc.later }
        if contentsChannelExpandedPosition(from.position, step, result) != source
          || contentsChannelExpandedPosition(into.position, step, result) != target {
          CompilerBug.panic(b"channel primitive cross-paired its old replay arc")
        }
        match arc.stop {
          Option<usize>.Some {value} => {
            expectedReverse = arc.reverse != request.reverse
            let selected = match contentsChannelBoundary(prepared, value, expectedReverse) {
              Option<usize>.Some {value: matchedOriginalParent} => matchedOriginalParent
              _ => { return CompilerBug.panic(b"channel primitive omitted its exact directed stop") }
            }
            origin = Option<PreparedChannelLiftOrigin>.some(PreparedChannelLiftOrigin.Boundary {lift: selected})
          }
          Option<usize>.None => {
            if let Option<Prepared.BoundaryTransitionId>.Some {..} = arc.boundary { CompilerBug.panic(b"channel primitive made a physical boundary semantic") }
          }
        }
      }
    }
    if link.reverse != expectedReverse { CompilerBug.panic(b"channel replay changed its primitive orientation") }
    match origin {
      Option<PreparedChannelLiftOrigin>.None => {
        if let Option<Prepared.ChannelLiftId>.Some {..} = link.root { CompilerBug.panic(b"channel identity invented an output lift") }
        if let Option<Prepared.ChannelLiftId>.Some {..} = link.current { CompilerBug.panic(b"channel identity invented a suffix lift") }
        if let Option<Prepared.ChannelLiftId>.Some {..} = link.prefixRoot { CompilerBug.panic(b"channel identity invented a prefix root lift") }
        if let Option<Prepared.ChannelLiftId>.Some {..} = link.prefixCurrent { CompilerBug.panic(b"channel identity invented a prefix cursor lift") }
        if later.root.index != earlier.root.index || later.current.index != earlier.current.index
          || !sameContentsChannelPrefix(later.prefix, earlier.prefix) {
          CompilerBug.panic(b"channel identity changed its exact separate suffixes")
        }
      }
      Option<PreparedChannelLiftOrigin>.Some {value: selected} => {
        let relativeRoot = match link.root { Option<Prepared.ChannelLiftId>.Some {value} => value
          _ => { return CompilerBug.panic(b"channel replay omitted its frozen output root") } }
        let relativeCurrent = match link.current { Option<Prepared.ChannelLiftId>.Some {value} => value
          _ => { return CompilerBug.panic(b"channel replay omitted its frozen output cursor") } }
        let mut root = relativeRoot
        let mut current = relativeCurrent
        let mut laterRoot = later.root
        let mut laterCurrent = later.current
        let mut earlierRoot = earlier.root
        let mut earlierCurrent = earlier.current
        if let Option<ContentsChannelPrefix>.Some {value: prefix} = later.prefix {
          let translated = match earlier.prefix { Option<ContentsChannelPrefix>.Some {value} => value
            _ => { return CompilerBug.panic(b"channel replay erased its transported prefix") } }
          root = match link.prefixRoot { Option<Prepared.ChannelLiftId>.Some {value} => value
            _ => { return CompilerBug.panic(b"channel replay omitted its paired prefix root") } }
          current = match link.prefixCurrent { Option<Prepared.ChannelLiftId>.Some {value} => value
            _ => { return CompilerBug.panic(b"channel replay omitted its paired prefix cursor") } }
          validateContentsChannelLiftPair(lifts, relativeRoot, relativeCurrent,
            PreparedChannelLiftOrigin.Projection {projection: prefix.projection, prefixRoot: root, prefixCurrent: current},
            link.reverse, later.root, later.current, earlier.root, earlier.current)
          laterRoot = prefix.root laterCurrent = prefix.current
          earlierRoot = translated.root earlierCurrent = translated.current
        } else {
          if let Option<Prepared.ChannelLiftId>.Some {..} = link.prefixRoot { CompilerBug.panic(b"one-segment channel replay invented a prefix root") }
          if let Option<Prepared.ChannelLiftId>.Some {..} = link.prefixCurrent { CompilerBug.panic(b"one-segment channel replay invented a prefix cursor") }
        }
        validateContentsChannelLiftPair(lifts, root, current, selected, link.reverse,
          laterRoot, laterCurrent, earlierRoot, earlierCurrent)
        let entry = &lifts[root.index]
        let relative = &lifts[relativeRoot.index]
        if relative.map.index != entry.map.index || relative.channel.sourceState.index != entry.channel.sourceState.index
          || relative.channel.targetState.index != entry.channel.targetState.index {
          CompilerBug.panic(b"channel segments changed their common actual map or channel stop")
        }
        if let PreparedChannelLiftOrigin.Root = selected {
          let pair = &List<Prepared.BoundaryStop>.asSlice(&List<SelectionMap>.asSlice(&prepared.maps)[member.index].channelStops)[stop]
          if entry.map.index != member.index || entry.channel.sourceState.index != pair.sourceState.index
            || entry.channel.targetState.index != pair.targetState.index {
            CompilerBug.panic(b"channel replay changed its exact discharge stop")
          }
        }
        let mut beforeChannel = entry.channel.sourceState
        let mut afterChannel = entry.channel.targetState
        if link.reverse { beforeChannel = entry.channel.targetState afterChannel = entry.channel.sourceState }
        if beforeChannel.index != contentsChannelNodeState(closure, earlier).index
          || afterChannel.index != contentsChannelNodeState(closure, later).index {
          CompilerBug.panic(b"channel replay changed its exact oriented channel pair")
        }
      }
    }
    at = at + usize.ONE
  }
  let outputs = List<ContentsChannelOutput>.asSlice(&closure.contentsChannelOutputs)
  at = usize.ZERO
  while at < outputs.length {
    let output = outputs[at]
    if output.cursor >= cursors.length { CompilerBug.panic(b"channel output omitted its complete replay") }
    let cursor = cursors[output.cursor]
    let node = nodes[cursor.node]
    let request = requests[node.request]
    let done = match cursor.position { ContentsChannelPosition.Done => true _ => false }
    if !done || output.proof != request.proof || output.requestedRoot.index != request.requestedRoot.index
      || output.requested.index != request.requested.index || output.root.index != node.root.index
      || output.current.index != node.current.index || !Atom.same(output.active, cursor.active)
      || !sameContentsChannelPrefix(output.requestedPrefix, request.prefix) || !sameContentsChannelPrefix(output.prefix, node.prefix) {
      CompilerBug.panic(b"channel output changed its complete actual replay proof")
    }
    at = at + usize.ONE
  }
  return ()
}

fn validateContentsChannels<'body>(prepared: &SourcePreparation<'body>, aliases: &[AliasEdge],
  cases: &[Case], closure: &DescriptorClosure) -> () {
  let proofs = List<ContentsChannelProof>.asSlice(&closure.contentsChannels)
  let nodes = List<ContentsNode>.asSlice(&closure.contents)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut at = usize.ZERO
  while at < proofs.length {
    let proof = proofs[at]
    if proof.case >= cases.length || proof.edge >= aliases.length
      || !contentsChannelState(prepared, proof.source) || !contentsChannelState(prepared, proof.target) {
      CompilerBug.panic(b"channel contents lost its actual occurrence or semantic states")
    }
    let mut before = proof.source
    let mut after = proof.target
    match cases[proof.case].authority {
      TransferAuthority.Address {edge, direction} => {
        if edge != proof.edge { CompilerBug.panic(b"channel contents changed its original address edge") }
        if direction == MapDirection.StorageInverse { before = proof.target after = proof.source }
      }
      _ => CompilerBug.panic(b"channel contents replaced its actual Address authority")
    }
    let mut original = Option<usize>.none()
    let mut memberId = Option<MapId>.none()
    let mut stopId = usize.ZERO
    match proof.authority {
      ContentsChannelAuthority.Selected {map} => {
        let exact = match aliases[proof.edge].authority {
          AliasAuthority.Selected {map: selected, ..} => selected.index == map.index _ => false
        }
        if !exact || map.index >= maps.length { CompilerBug.panic(b"selected channel contents lost its original map") }
        let selected = &maps[map.index]
        if selected.kind != MapKind.Select || !sameSelector(&selected.selector, &Selector.Identity)
          || endpoints[selected.source.index].shape.index != endpoints[selected.target.index].shape.index
          || before.index != after.index {
          CompilerBug.panic(b"selected channel contents has no complete original identity")
        }
      }
      ContentsChannelAuthority.Origin {node, member, stop} => {
        let placement = match aliases[proof.edge].authority {
          AliasAuthority.Origin {placement} => List<OriginPlacement>.asSlice(&closure.placements)[placement]
          _ => { return CompilerBug.panic(b"channel contents lost its genuine Origin placement") }
        }
        let origin = List<OriginProof>.asSlice(&closure.origins)[placement.proof]
        if node >= nodes.length || member.index != placement.member.index || nodes[node].carrier != origin.carrier {
          CompilerBug.panic(b"channel contents changed its original reference member or carrier")
        }
        original = Option<usize>.some(node)
        memberId = Option<MapId>.some(member)
        stopId = stop
      }
      ContentsChannelAuthority.Slice {node, member, stop} => {
        let placement = match aliases[proof.edge].authority {
          AliasAuthority.Slice {placement} => List<SlicePlacement>.asSlice(&closure.slicePlacements)[placement]
          _ => { return CompilerBug.panic(b"channel contents lost its actual Slice placement") }
        }
        let conversion = List<SliceProof>.asSlice(&closure.sliceProofs)[placement.proof]
        let origin = aliases[placement.edge]
        let exact = match origin.authority { AliasAuthority.Origin {placement: id} => id == placement.origin _ => false }
        let source = match aliases[proof.edge].source { Option<usize>.Some {value} => value == origin.target _ => false }
        if !exact || !source || node >= nodes.length || member.index != placement.member.index
          || nodes[node].carrier != conversion.carrier {
          CompilerBug.panic(b"channel contents changed its Slice element or preceding current read")
        }
        original = Option<usize>.some(node)
        memberId = Option<MapId>.some(member)
        stopId = stop
      }
    }
    if let Option<usize>.Some {value: node} = original {
      let member = match memberId { Option<MapId>.Some {value} => value
        _ => { return CompilerBug.panic(b"channel contents omitted its discharge member") } }
      if member.index >= maps.length { CompilerBug.panic(b"channel contents invented its original member") }
      let map = &maps[member.index]
      let stops = List<Prepared.BoundaryStop>.asSlice(&map.channelStops)
      if stopId >= stops.length || !map.componentTransport || map.addressTransport
        || (map.kind != MapKind.Copy && map.kind != MapKind.Place) || !sameSelector(&map.selector, &Selector.Identity) {
        CompilerBug.panic(b"channel contents has no exact producer member stop")
      }
      let paired = &stops[stopId]
      if nodes[node].edge != proof.edge || nodes[node].target.index != after.index
        || paired.targetState.index != nodes[node].state.index || paired.sourceState.index != before.index {
        CompilerBug.panic(b"channel contents cross-paired original graph and discharge states")
      }
    }
    at = at + usize.ONE
  }
  validateContentsChannelReplays(prepared, cases, closure)
  return ()
}

fn validateContents<'body>(prepared: &SourcePreparation<'body>, aliases: &[AliasEdge],
  cases: &[Case], closure: &DescriptorClosure) -> () {
  let pairs = List<Carriers.Pair>.asSlice(&closure.pairs)
  let proofs = List<ContentsProof>.asSlice(&closure.contentsProofs)
  let nodes = List<ContentsNode>.asSlice(&closure.contents)
  let placements = List<OriginPlacement>.asSlice(&closure.placements)
  let origins = List<OriginProof>.asSlice(&closure.origins)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let boundaries = List<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let mut at = usize.ZERO
  while at < pairs.length {
    let pair = pairs[at]
    if pair.proof >= proofs.length { CompilerBug.panic(b"contents pair omitted its actual derivation") }
    let proof = proofs[pair.proof]
    if proof.case >= cases.length || proof.edge >= aliases.length || pair.case != proof.case
      || pair.originProof != proof.edge || pair.sourceState.index != proof.source.index
      || pair.targetState.index != proof.target.index || !Atom.same(pair.active, proof.active) {
      CompilerBug.panic(b"contents pair cross-paired its occurrence or residual derivation")
    }
    let mut before = proof.source
    let mut after = proof.target
    match cases[proof.case].authority {
      TransferAuthority.Address {edge, direction} => {
        if edge != proof.edge { CompilerBug.panic(b"contents derivation belongs to another address case") }
        if direction == MapDirection.StorageInverse { before = proof.target after = proof.source }
      }
      _ => CompilerBug.panic(b"contents derivation replaced physical or declared authority")
    }
    match proof.authority {
      ContentsAuthority.Selected {map} => {
        let exact = match aliases[proof.edge].authority {
          AliasAuthority.Selected {map: selected, ..} => selected.index == map.index _ => false
        }
        if !exact || before.index != after.index { CompilerBug.panic(b"selected contents changed its exact suffix") }
      }
      ContentsAuthority.Origin {node, referent} => {
        let placement = match aliases[proof.edge].authority {
          AliasAuthority.Origin {placement} => placements[placement]
          _ => { return CompilerBug.panic(b"origin contents has no actual reference placement") }
        }
        if node >= nodes.length || referent.index >= boundaries.length {
          CompilerBug.panic(b"origin contents discharge lost its carrier or reference member")
        }
        let replay = nodes[node]
        let boundary = &boundaries[referent.index]
        let roots = List<Prepared.BoundaryTransitionId>.asSlice(&maps[placement.member.index].boundaries)
        let mut found = false
        let mut each = usize.ZERO
        while each < roots.length { if roots[each].index == referent.index { found = true } each = each + usize.ONE }
        if !found || replay.edge != proof.edge || replay.carrier != origins[placement.proof].carrier
          || replay.target.index != after.index || boundary.targetState.index != replay.state.index
          || boundary.sourceState.index != before.index || boundary.map.index != placement.member.index {
          CompilerBug.panic(b"origin contents discharge changed its exact referent pair or carrier endpoint")
        }
      }
      ContentsAuthority.Slice {node, element} => {
        let placement = match aliases[proof.edge].authority {
          AliasAuthority.Slice {placement} => List<SlicePlacement>.asSlice(&closure.slicePlacements)[placement]
          _ => { return CompilerBug.panic(b"slice contents has no actual conversion placement") }
        }
        if node >= nodes.length || element.index >= boundaries.length || placement.edge >= aliases.length {
          CompilerBug.panic(b"slice contents discharge lost its carrier, member or source Origin edge")
        }
        let conversion = List<SliceProof>.asSlice(&closure.sliceProofs)[placement.proof]
        let origin = aliases[placement.edge]
        let exactOrigin = match origin.authority {
          AliasAuthority.Origin {placement: id} => id == placement.origin _ => false
        }
        let exactSource = match aliases[proof.edge].source {
          Option<usize>.Some {value} => value == origin.target _ => false
        }
        let replay = nodes[node]
        let boundary = &boundaries[element.index]
        let roots = List<Prepared.BoundaryTransitionId>.asSlice(&maps[placement.member.index].boundaries)
        let mut found = false
        let mut each = usize.ZERO
        while each < roots.length { if roots[each].index == element.index { found = true } each = each + usize.ONE }
        if !exactOrigin || !exactSource || !found || replay.edge != proof.edge || replay.carrier != conversion.carrier
          || replay.target.index != after.index || boundary.targetState.index != replay.state.index
          || boundary.sourceState.index != before.index || boundary.map.index != placement.member.index {
          CompilerBug.panic(b"slice contents discharge changed its exact element pair or current-read address leg")
        }
      }
    }
    at = at + usize.ONE
  }
  validateContentsReplays(prepared, cases, closure)
  validateContentsChannels(prepared, aliases, cases, closure)
  return ()
}

fn operationSubject(value: Value) -> bool {
  if let Option<ResidualSubject>.Some {value: selected} = value.subject {
    if let Option<Results.Position>.Some {..} = selected.position { return true }
  }
  return false
}

// Private address lanes are occurrence-qualified. An arbitrary equal endpoint is not an
// address proof, even when its value happens to contain the same Borrow leaf.
fn carrierAliasEdge(skeleton: &Skeleton, source: Value, target: Value, map: MapId,
  direction: MapDirection, address: EvalId) -> usize {
  let mut before = source
  let mut after = target
  if direction == MapDirection.StorageInverse { before = target after = source }
  let port = match after.transport {
    Option<AliasPort>.Some {value} => value
    _ => { return CompilerBug.panic(b"address carrier lost its actual private destination lane") }
  }
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let requests = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  if port.alias >= aliases.length || port.request >= requests.length
    || aliases[port.alias].evaluation.index != address.index
    || after.evaluation.index != requests[port.request].evaluation.index {
    return CompilerBug.panic(b"address carrier changed its actual use or formation occurrence")
  }
  let mut at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let selected = match edge.authority { AliasAuthority.Project {map: value} => value.index == map.index _ => false }
    if selected && edge.target == port.alias {
      let exact = match edge.source {
        Option<usize>.Some {value: predecessor} => match before.transport {
          Option<AliasPort>.Some {value} => value.request == port.request && value.alias == predecessor
          _ => false
        }
        Option<usize>.None => match before.transport {
          Option<AliasPort>.None => before.endpoint.index == aliases[port.alias].storage.endpoint.index
            && before.evaluation.index == requests[port.request].evaluation.index
          _ => false
        }
      }
      if exact { return at }
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"address carrier has no exact contiguous alias edge")
}

fn carrierPublication(source: Value, target: Value) -> () {
  if source.endpoint.index != target.endpoint.index || !sameSubject(source.subject, target.subject) {
    CompilerBug.panic(b"descriptor publication changed its actual selected component")
  }
  match source.transport {
    Option<AliasPort>.Some {value} => match target.transport {
      Option<AliasPort>.Some {value: other} => {
        if value.request != other.request || value.alias != other.alias {
          CompilerBug.panic(b"descriptor publication merged private address proofs")
        }
      }
      Option<AliasPort>.None => ()
    }
    Option<AliasPort>.None => ()
  }
  // The only nonprivate component changes admitted here are actual reserved publications
  // and canonical definition/read transfers. Their original Case identity remains intact.
  return ()
}

fn carrierAuthority<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  keys: &[CellKey], actual: &Case) -> CarriersAuthority {
  let source = match actual.source {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return CarriersAuthority.Blocked }
  }
  if keys[source].category != SourceRole.Physical || keys[actual.target].category != SourceRole.Physical { return CarriersAuthority.Blocked }
  let values = List<Value>.asSlice(&skeleton.values)
  let before = values[keys[source].value.index]
  let after = values[keys[actual.target].value.index]
  if operationSubject(before) || operationSubject(after) { return CarriersAuthority.Blocked }
  if let Option<usize>.Some {..} = before.summary { return CarriersAuthority.Blocked }
  if let Option<usize>.Some {..} = after.summary { return CarriersAuthority.Blocked }
  return match actual.authority {
    TransferAuthority.CaptureReborrow {..} => CarriersAuthority.Blocked
    TransferAuthority.ReferenceHolding {..} => CarriersAuthority.Blocked
    TransferAuthority.MoveHolding {..} => CarriersAuthority.Blocked
    TransferAuthority.FieldRehold {..} => CarriersAuthority.Blocked
    TransferAuthority.OwnershipMirror {..} => CarriersAuthority.Blocked
    TransferAuthority.SummaryRead {..} => CarriersAuthority.Blocked
    TransferAuthority.RetainedWrite {..} => CarriersAuthority.Blocked
    TransferAuthority.InvocationWrite {..} => CarriersAuthority.Blocked
    TransferAuthority.OrdinarySummary {..} => CarriersAuthority.Blocked
    TransferAuthority.OperationResult {..} => CarriersAuthority.Blocked
    TransferAuthority.OrdinaryResult {..} => CarriersAuthority.Blocked
    TransferAuthority.FieldResult {..} => CarriersAuthority.Blocked
    TransferAuthority.DeclaredResult {..} => CarriersAuthority.Blocked
    TransferAuthority.RvalueDereferenceResult {..} => CarriersAuthority.Blocked
    TransferAuthority.ThroughResult {..} => CarriersAuthority.Blocked
    TransferAuthority.Address {edge, ..} => CarriersAuthority.OriginContents {proof: edge}
    TransferAuthority.SameComponent => {
      carrierPublication(before, after)
      return CarriersAuthority.SameComponent
    }
    TransferAuthority.Physical {map, direction, address} => {
      let physical = &List<SelectionMap>.asSlice(&prepared.maps)[map.index]
      // Descriptor creation, slice conversion, channel and declaration maps have distinct
      // semantic authorities. None may impersonate ordinary component-preserving transport.
      let supported = (physical.componentTransport || physical.addressTransport)
        && match &physical.selector { Selector.Identity => true _ => false }
      if !supported { return CarriersAuthority.Blocked }
      let mut proof = Option<usize>.none()
      if physical.addressTransport {
        let occurrence = match address {
          Option<EvalId>.Some {value} => value
          _ => { return CompilerBug.panic(b"storage carrier omitted actual alias evidence") }
        }
        proof = Option<usize>.some(carrierAliasEdge(skeleton, before, after, map, direction, occurrence))
      } else {
        if let Option<EvalId>.Some {..} = address {
          return CompilerBug.panic(b"value carrier substituted an address proof")
        }
      }
      let mut orientation = CarriersDirection.Forward
      if direction == MapDirection.StorageInverse { orientation = CarriersDirection.StorageInverse }
      return CarriersAuthority.Physical {map: map, direction: orientation, address: proof}
    }
  }
}

// Only exact actual selector occurrences start demands. New reaching histories add cells to
// this finite set; no source quality or truth value is sampled to choose the candidates.
effect fn descriptorDemands<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &Skeleton, keys: &[CellKey]) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<SelectionUse>.asSlice(&skeleton.selections)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let values = List<Value>.asSlice(&skeleton.values)
  let mut use = usize.ZERO
  while use < requests.length {
    let request = &requests[use]
    let selectors = List<MapId>.asSlice(&request.selectors)
    let mut step = usize.ZERO
    while step < selectors.length {
      let selector = &maps[selectors[step].index]
      let mut boundary = match &selector.selector { Selector.Referent => true _ => false }
      if let Selector.Index {..} = &selector.selector {
        let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[selector.source.index]
        if let PreparedShapeState.Slice = &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state { boundary = true }
      }
      if boundary {
        let mut cell = usize.ZERO
        while cell < keys.length {
          let actual = values[keys[cell].value.index]
          if keys[cell].category == SourceRole.Physical && actual.evaluation.index == request.operand.index && actual.endpoint.index == selector.source.index
            && actual.phase == ValuePhase.Output && !operationSubject(actual) {
            let shape = valueShape(prepared, actual)
            let mut state = usize.ZERO
            while state < states.length {
              let selected = &states[state]
              if authoredResidual(selected) && selected.selection.index == request.selection.index
                && selected.vertex.index == selector.target.index && selected.input.shape.index == shape.index {
                let old = List<Carriers.Demand>.asSlice(&closure.demands)
                let mut found = false
                let mut previous = usize.ZERO
                while previous < old.length {
                  if old[previous].selectionUse == use && old[previous].cell == cell
                    && old[previous].state.index == state { found = true }
                  previous = previous + usize.ONE
                }
                if !found {
                  let result = Skeleton.evaluation(skeleton, request.result)
                  run List<Carriers.Demand>.append(&mut closure.demands, Carriers.Demand {selectionUse: use,
                    cell: cell, state: Prepared.ResidualStateId {index: state}, active: request.active,
                    reachable: Flow.reachable(&skeleton.flow, result.point)})
                }
              }
              state = state + usize.ONE
            }
          }
          cell = cell + usize.ONE
        }
      }
      step = step + usize.ONE
    }
    use = use + usize.ONE
  }
  return ()
}

// A retained request owns its exact authored path, while the source descriptor may be
// either the original operand or a current execution read after a preceding boundary.
fn retainedBoundary<'body>(prepared: &SourcePreparation<'body>, map: MapId) -> bool {
  let selected = &List<SelectionMap>.asSlice(&prepared.maps)[map.index]
  if let Selector.Referent = &selected.selector { return true }
  if let Selector.Index {..} = &selected.selector {
    let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[selected.source.index]
    if let PreparedShapeState.Slice = &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state { return true }
  }
  return false
}

fn retainedCurrentDescriptor(transports: &[AliasTransport], values: &[Value], request: usize, path: usize, prefix: usize,
  value: Value) -> bool {
  if let Option<usize>.Some {..} = value.summary { return false }
  if let Option<usize>.Some {..} = value.writeHolder { return false }
  if let Option<AliasPort>.Some {..} = value.transport { return false }
  let mut at = usize.ZERO
  while at < transports.length {
    let transport = transports[at]
    if let AliasConsumer.Descriptor {request: selected, path: branch, prefix: step, ..} = transport.authority {
      if selected == request && branch == path && step == prefix {
        let input = match transport.consumer { Option<ValueId>.Some {value: matchedConsumer} => values[matchedConsumer.index]
          _ => { return CompilerBug.panic(b"retained descriptor read has no actual input") } }
        if value.evaluation.index == input.evaluation.index && value.endpoint.index == input.endpoint.index
          && value.phase == ValuePhase.Output && sameSubject(value.subject, input.subject) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn retainedDescriptorDemands<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, keys: &[CellKey], cells: &[Cell]) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let values = List<Value>.asSlice(&skeleton.values)
  let offset = List<SelectionUse>.length(&skeleton.selections)
  let mut request = usize.ZERO
  while request < requests.length {
    let use = &requests[request]
    let paths = List<RetainedPath>.asSlice(&use.paths)
    let mut path = usize.ZERO
    while path < paths.length {
      let selectors = List<MapId>.asSlice(&paths[path].selectors)
      let mut crossed = false
      let mut step = usize.ZERO
      while step < selectors.length {
        if retainedBoundary(prepared, selectors[step]) {
          let selector = &maps[selectors[step].index]
          let mut cell = usize.ZERO
          while cell < keys.length {
            let actual = values[keys[cell].value.index]
            let mut occurrence = actual.evaluation.index == use.operand.index
            if crossed { occurrence = retainedCurrentDescriptor(List<AliasTransport>.asSlice(&skeleton.aliasTransports), values, request, path, step, actual) }
            if let Option<usize>.Some {..} = actual.writeHolder { occurrence = false }
            if let Option<usize>.Some {..} = actual.summary { occurrence = false }
            if let Option<AliasPort>.Some {..} = actual.transport { occurrence = false }
            if keys[cell].category == SourceRole.Physical && occurrence && actual.endpoint.index == selector.source.index && actual.phase == ValuePhase.Output {
              let unknown = match &List<Leaf>.asSlice(&skeleton.leaves)[keys[cell].leaf.index].kind {
                SourceLeaf.Unknown {..} => true _ => false
              }
              if unknown || operationSubject(actual) {
                let prior = List<RetainedMissing>.asSlice(&closure.retainedMissing)
                let mut listed = false
                let mut earlier = usize.ZERO
                while earlier < prior.length {
                  if prior[earlier].request == request && prior[earlier].cell == cell { listed = true }
                  earlier = earlier + usize.ONE
                }
                if !listed {
                  let gates: [Atom; 2] = [use.active, cells[cell].present]
                  let empty = List<Atom>.make()
                  run Program.rule(&mut skeleton.rules, use.missing,
                    &gates, List<Atom>.asSlice(&empty))
                  run List<RetainedMissing>.append(&mut closure.retainedMissing, RetainedMissing {request: request, cell: cell})
                }
              }
            }
            if keys[cell].category == SourceRole.Physical && occurrence && actual.endpoint.index == selector.source.index && actual.phase == ValuePhase.Output
              && !operationSubject(actual) {
              let mut state = usize.ZERO
              while state < states.length {
                let selected = &states[state]
                if authoredResidual(selected) && selected.selection.index == use.selection.index
                  && selected.vertex.index == selector.target.index && selected.input.shape.index == valueShape(prepared, actual).index {
                  let existing = List<Carriers.Demand>.asSlice(&closure.demands)
                  let mut found = false
                  let mut at = usize.ZERO
                  while at < existing.length {
                    if existing[at].selectionUse == offset + request && existing[at].cell == cell
                      && existing[at].state.index == state { found = true }
                    at = at + usize.ONE
                  }
                  if !found {
                    let execution = Skeleton.evaluation(&skeleton.*, use.execution)
                    run List<Carriers.Demand>.append(&mut closure.demands, Carriers.Demand {selectionUse: offset + request,
                      cell: cell, state: Prepared.ResidualStateId {index: state}, active: use.active,
                      reachable: Flow.reachable(&skeleton.flow, execution.point)})
                  }
                }
                state = state + usize.ONE
              }
            }
            cell = cell + usize.ONE
          }
          crossed = true
        }
        step = step + usize.ONE
      }
      path = path + usize.ONE
    }
    request = request + usize.ONE
  }
  return ()
}

fn retainedEdgeDemand(closure: &DescriptorClosure, edge: AliasEdge) -> Option<usize> {
  let mut carrier = usize.ZERO
  match edge.authority {
    AliasAuthority.Origin {placement} => {
      let selected = List<OriginPlacement>.asSlice(&closure.placements)[placement]
      carrier = List<OriginProof>.asSlice(&closure.origins)[selected.proof].carrier
    }
    AliasAuthority.Slice {placement} => {
      let selected = List<SlicePlacement>.asSlice(&closure.slicePlacements)[placement]
      carrier = List<SliceProof>.asSlice(&closure.sliceProofs)[selected.proof].carrier
    }
    _ => { return Option<usize>.none() }
  }
  return Option<usize>.some(CarriersProduct.nodes(&closure.product)[carrier].demand)
}

// Emit a real current read through the existing canonical alias lanes. The last endpoint
// is already the exact authored component: publishing it uses SameComponent, never a Copy
// invented for a retained call slot. Each transport keeps its original address edge gate.
effect fn retainedPrefixRead(skeleton: &mut Skeleton, request: usize, path: usize, prefix: usize,
  edgeId: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let transports = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let mut at = usize.ZERO
  while at < transports.length {
    if let AliasConsumer.Descriptor {request: old, path: branch, prefix: step, edge} = transports[at].authority {
      if old == request && branch == path && step == prefix && edge == edgeId { return false }
    }
    at = at + usize.ONE
  }
  let use = &List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[request]
  let execution = use.execution
  let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
  let alias = &List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
  if alias.evaluation.index != execution.index { return CompilerBug.panic(b"retained read crossed execution occurrences") }
  let endpoint = alias.endpoint
  let active = run addressApplies(&mut skeleton.rules, use.active, edge.active)
  let output = run Skeleton.value(&mut skeleton.*, execution, endpoint)
  let input = run Skeleton.componentValue(&mut skeleton.*, execution, endpoint, Option<ResidualSubject>.none(), ValuePhase.Input)
  let requestId = List<AliasTransport>.length(&skeleton.aliasTransports)
  run List<AliasTransport>.append(&mut skeleton.aliasTransports, AliasTransport {consumer: Option<ValueId>.some(input),
    alias: edge.target, authority: AliasConsumer.Descriptor {request: request, path: path, prefix: prefix, edge: edgeId},
    evaluation: execution, active: active, direction: MapDirection.Forward, closed: usize.ZERO})
  let incoming = run Skeleton.aliasPort(&mut skeleton.*, requestId, edge.target)
  let absent = Program.atom(&mut skeleton.rules)
  run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: incoming, target: input, active: active,
    directness: Directness.Preserve, stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(),
    read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
  run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: input, target: output, active: active,
    directness: Directness.Preserve, stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(),
    read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.SameComponent})
  return true
}

effect fn activateRetainedAddresses<'body>(closure: &DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let requestCount = List<DescriptorRequest>.length(&skeleton.descriptorRequests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let demands = List<Carriers.Demand>.asSlice(&closure.demands)
  let offset = List<SelectionUse>.length(&skeleton.selections)
  let count = List<AliasEdge>.length(&skeleton.aliasEdges)
  let mut changed = false
  let mut edgeId = usize.ZERO
  while edgeId < count {
    let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[edgeId]
    if let Option<usize>.Some {value: demandId} = retainedEdgeDemand(closure, edge) {
      let demand = demands[demandId]
      if demand.selectionUse >= offset {
        let request = demand.selectionUse - offset
        if request >= requestCount { return CompilerBug.panic(b"retained address omitted its explicit request") }
        let execution = List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[request].execution
        let authority = List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[request].authority
        let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[edge.target]
        // Supplemental slice-source Origins remain address evidence at conversion.source;
        // only the genuine final Slice bridge belongs to this execution request.
        if alias.evaluation.index == execution.index {
          let pathCount = List<RetainedPath>.length(&List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[request].paths)
          let mut path = usize.ZERO
          while path < pathCount {
            let endpoint = List<RetainedPath>.asSlice(&List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[request].paths)[path].endpoint
            let selectorCount = List<MapId>.length(&List<RetainedPath>.asSlice(&List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[request].paths)[path].selectors)
            let mut prefix = usize.ZERO
            while prefix < selectorCount {
              if maps[List<MapId>.asSlice(&List<RetainedPath>.asSlice(&List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[request].paths)[path].selectors)[prefix].index].target.index == alias.endpoint.index {
                if run retainedPrefixRead(&mut skeleton.*, request, path, prefix + usize.ONE, edgeId) { changed = true }
              }
              prefix = prefix + usize.ONE
            }
            if alias.endpoint.index == endpoint.index {
              let key = keys[demand.cell]
              let history = &witnesses[key.witness]
              match authority {
                DescriptorRequestAuthority.Retained {request: retainedId} => {
                  let retained = &List<RetainedRequest>.asSlice(&skeleton.retainedRequests)[retainedId]
                  let addresses = List<RetainedAddress>.asSlice(&skeleton.retainedAddresses)
                  let mut found = false
                  let mut at = usize.ZERO
                  while at < addresses.length {
                    if addresses[at].operation == retained.operation && addresses[at].input == retained.input
                      && addresses[at].slot == retained.slot && addresses[at].path == path && addresses[at].edge == edgeId {
                      if addresses[at].descriptor.index != key.value.index || addresses[at].leaf.index != key.leaf.index
                        || addresses[at].direct != key.direct || addresses[at].category != key.category { return CompilerBug.panic(b"retained edge changed its original descriptor contributor") }
                      found = true
                    }
                    at = at + usize.ONE
                  }
                  if !found {
                    run List<RetainedAddress>.append(&mut skeleton.retainedAddresses, RetainedAddress {category: key.category, operation: retained.operation,
                      input: retained.input, slot: retained.slot, path: path, descriptor: key.value, leaf: key.leaf,
                      definition: history.definition, read: history.read, direct: key.direct, alias: edge.target,
                      edge: edgeId, storage: alias.storage, active: edge.active})
                    changed = true
                  }
                }
                DescriptorRequestAuthority.Invocation {request: invocation} => {
                  let addresses = List<InvocationAddress>.asSlice(&skeleton.invocationAddresses)
                  let mut found = false
                  let mut at = usize.ZERO
                  while at < addresses.length {
                    if addresses[at].request == invocation && addresses[at].path == path && addresses[at].edge == edgeId {
                      if addresses[at].descriptor.index != key.value.index || addresses[at].leaf.index != key.leaf.index
                        || addresses[at].direct != key.direct || addresses[at].category != key.category { return CompilerBug.panic(b"invocation edge changed its descriptor contributor") }
                      found = true
                    }
                    at = at + usize.ONE
                  }
                  if !found {
                    run List<InvocationAddress>.append(&mut skeleton.invocationAddresses, InvocationAddress {
                      category: key.category, request: invocation, path: path, descriptor: key.value, leaf: key.leaf,
                      definition: history.definition, read: history.read, direct: key.direct,
                      alias: edge.target, edge: edgeId, storage: alias.storage, active: edge.active})
                    changed = true
                  }
                }
              }
            }
            path = path + usize.ONE
          }
        }
      }
    }
    edgeId = edgeId + usize.ONE
  }
  return changed
}

fn retainedHistory(history: &Witness, address: RetainedAddress) -> bool {
  let definition = match history.definition {
    Option<DefinitionId>.Some {value} => match address.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    Option<DefinitionId>.None => match address.definition { Option<DefinitionId>.None => true _ => false }
  }
  let read = match history.read {
    Option<ReadId>.Some {value} => match address.read { Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
    Option<ReadId>.None => match address.read { Option<ReadId>.None => true _ => false }
  }
  return definition && read
}

fn validateInvocationAddresses<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  closure: &DescriptorClosure, domain: &Domain) -> () {
  let requests = List<InvocationRequest>.asSlice(&skeleton.invocationRequests)
  let addresses = List<InvocationAddress>.asSlice(&skeleton.invocationAddresses)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let demands = List<Carriers.Demand>.asSlice(&closure.demands)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let offset = List<SelectionUse>.length(&skeleton.selections) + List<RetainedRequest>.length(&skeleton.retainedRequests)
  let mut at = usize.ZERO
  while at < addresses.length {
    let address = addresses[at]
    if address.request >= requests.length || address.edge >= edges.length || address.alias >= aliases.length {
      CompilerBug.panic(b"invocation address lost its actual request or proof")
    }
    let request = &requests[address.request]
    let paths = List<RetainedPath>.asSlice(&request.paths)
    let edge = edges[address.edge]
    let demandId = match retainedEdgeDemand(closure, edge) { Option<usize>.Some {value} => value
      _ => { return CompilerBug.panic(b"invocation address has no actual descriptor demand") } }
    let demand = demands[demandId]
    let key = keys[demand.cell]
    let witness = &witnesses[key.witness]
    let definition = match witness.definition { Option<DefinitionId>.Some {value} => match address.definition {
      Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
      Option<DefinitionId>.None => match address.definition { Option<DefinitionId>.None => true _ => false } }
    let read = match witness.read { Option<ReadId>.Some {value} => match address.read {
      Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
      Option<ReadId>.None => match address.read { Option<ReadId>.None => true _ => false } }
    let alias = &aliases[address.alias]
    if demand.selectionUse != offset + address.request || address.path >= paths.length
      || alias.endpoint.index != paths[address.path].endpoint.index || alias.evaluation.index != request.execution.index
      || edge.target != address.alias || !Atom.same(edge.active, address.active) || !sameStorage(address.storage, alias.storage)
      || key.value.index != address.descriptor.index || key.leaf.index != address.leaf.index
      || key.category != address.category || key.direct != address.direct || !definition || !read {
      CompilerBug.panic(b"invocation address changed its descriptor case, occurrence or canonical target")
    }
    at = at + usize.ONE
  }
  let reads = List<InvocationRead>.asSlice(&skeleton.invocationReads)
  let canonical = List<ReadValue>.asSlice(&skeleton.reads)
  let transports = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let recorded = List<AliasRead>.asSlice(&skeleton.aliasReads)
  let values = List<Value>.asSlice(&skeleton.values)
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.request >= requests.length || read.read.index >= canonical.length || read.consumer.index >= values.length
      || read.edge >= edges.length || read.alias >= aliases.length { CompilerBug.panic(b"invocation read lost its exact reservation") }
    let request = &requests[read.request]
    let paths = List<RetainedPath>.asSlice(&request.paths)
    if read.path >= paths.length { CompilerBug.panic(b"invocation read lost its explicit path") }
    let selectors = List<MapId>.asSlice(&paths[read.path].selectors)
    if read.prefix == usize.ZERO || read.prefix > selectors.length { CompilerBug.panic(b"invocation read lost its selected prefix") }
    let endpoint = maps[selectors[read.prefix - usize.ONE].index].target
    let input = values[read.consumer.index]
    if input.phase != ValuePhase.Input || input.evaluation.index != request.execution.index || input.endpoint.index != endpoint.index
      || edges[read.edge].target != read.alias || aliases[read.alias].endpoint.index != endpoint.index
      || !sameStorage(canonical[read.read.index].storage, aliases[read.alias].storage) {
      CompilerBug.panic(b"invocation read substituted a prior operand for current storage")
    }
    let mut found = false
    let mut each = usize.ZERO
    while each < recorded.length {
      if recorded[each].read.index == read.read.index {
        let transport = transports[recorded[each].request]
        if let AliasConsumer.Descriptor {request: common, path, prefix, edge} = transport.authority {
          let authority = List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)[common].authority
          if let DescriptorRequestAuthority.Invocation {request: selected} = authority {
            if selected == read.request && path == read.path && prefix == read.prefix && edge == read.edge
              && Atom.same(transport.active, read.active) && transport.alias == read.alias { found = true }
          }
        }
      }
      each = each + usize.ONE
    }
    if !found { CompilerBug.panic(b"invocation read lost its original edge-gated consumer") }
    at = at + usize.ONE
  }
  let writes = List<InvocationWrite>.asSlice(&skeleton.invocationWrites)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let holders = List<WriteHolder>.asSlice(&skeleton.writeHolders)
  at = usize.ZERO
  while at < writes.length {
    let write = writes[at]
    if write.address >= addresses.length || write.summary >= summaries.length || write.holder >= holders.length
      || write.source.index >= values.length || write.target.index >= values.length { CompilerBug.panic(b"invocation write lost its candidate") }
    let request = &requests[addresses[write.address].request]
    let actual = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[write.operation]
    let target = values[write.target.index]
    let source = values[write.source.index]
    let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[actual.prepared]
    let routes = List<InputRoute>.asSlice(&row.inputs)
    let inputs = List<Results.Input>.asSlice(&actual.inputs)
    let mut inputMatches = false
    let mut input = usize.ZERO
    while input < inputs.length {
      let route = &routes[inputs[input].route]
      if sameInputRead(route.read, write.read) && inputs[input].actual.evaluation.index == write.operand.index
        && inputs[input].actual.usePoint.index == write.usePoint.index
        && inlineWithin(prepared, source.endpoint, maps[route.map.index].source) { inputMatches = true }
      input = input + usize.ONE
    }
    if sameInputRead(write.read, InputRead.Receiver) {
      if let Option<Results.Receiver>.Some {value} = &actual.receiver {
        if value.actual.evaluation.index == write.operand.index && value.actual.usePoint.index == write.usePoint.index
          && inlineWithin(prepared, source.endpoint, value.endpoint) { inputMatches = true }
      }
    }
    if !inputMatches || source.phase != ValuePhase.Output { CompilerBug.panic(b"invocation write replaced its actual ordered source input") }
    if let Option<usize>.Some {..} = source.summary { CompilerBug.panic(b"invocation body write invented a physical summary source") }
    if let Option<usize>.Some {..} = source.writeHolder { CompilerBug.panic(b"invocation body write reused received output as a snapshot") }
    if let Option<ResidualSubject>.Some {..} = source.subject { CompilerBug.panic(b"invocation body write treated a residual result as a physical source") }
    let selected = match target.summary { Option<usize>.Some {value} => value == write.summary _ => false }
    if write.operation != request.operation || target.evaluation.index != request.execution.index
      || Skeleton.evaluation(skeleton, request.execution).point.index != actual.execute.index
      || !unknownOwnership(summaries[write.summary].placement) || !sameStorage(summaries[write.summary].prefix, holders[write.holder].storage)
      || !selected || values[write.source.index].evaluation.index != write.operand.index {
      CompilerBug.panic(b"invocation body write changed execution or its whole-owner unknown placement")
    }
    at = at + usize.ONE
  }
  return ()
}

fn validateRetainedAddresses<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  closure: &DescriptorClosure, domain: &Domain) -> () {
  let requests = List<RetainedRequest>.asSlice(&skeleton.retainedRequests)
  let statuses = List<RetainedStatus>.asSlice(&skeleton.retainedStatus)
  let addresses = List<RetainedAddress>.asSlice(&skeleton.retainedAddresses)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let demands = List<Carriers.Demand>.asSlice(&closure.demands)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let offset = List<SelectionUse>.length(&skeleton.selections)
  if statuses.length != requests.length { CompilerBug.panic(b"retained requests lost explicit structural coverage") }
  let mut at = usize.ZERO
  while at < requests.length {
    let request = &requests[at]
    if statuses[at].request != at || request.selection.index >= selections.length {
      CompilerBug.panic(b"retained request lost its exact selection/status identity")
    }
    let row = &selections[request.selection.index]
    let retention = &List<Prepared.Retention>.asSlice(&prepared.retentions)[request.retention.index]
    let actual = Skeleton.evaluation(skeleton, request.operand)
    let source = match &endpoints[row.root.index].root {
      Root.Node {node, category: endpointCategory} if endpointCategory == EndpointRole.Value => match actual.site { EvaluationSite.Node {node: operand} => node.index == operand.index _ => false }
      _ => false
    }
    if !source || row.site.index != retention.site.index || Skeleton.evaluation(skeleton, request.execution).category != EvaluationRole.Execute {
      CompilerBug.panic(b"retained request confused original selector and actual execution")
    }
    let accepted = List<EndpointId>.asSlice(&row.accepts)
    let paths = List<RetainedPath>.asSlice(&request.paths)
    if paths.length != accepted.length { CompilerBug.panic(b"retained request lost an accepted physical path") }
    let mut path = usize.ZERO
    while path < paths.length {
      if paths[path].endpoint.index != accepted[path].index { CompilerBug.panic(b"retained request changed its original path order") }
      let selectors = List<MapId>.asSlice(&paths[path].selectors)
      let listed = List<MapId>.asSlice(&row.maps)
      let mut current = row.root
      let mut step = usize.ZERO
      while step < selectors.length {
        if selectors[step].index >= maps.length { CompilerBug.panic(b"retained path invented a selector map") }
        let map = &maps[selectors[step].index]
        let mut matches = usize.ZERO
        let mut each = usize.ZERO
        while each < listed.length { if listed[each].index == selectors[step].index { matches = matches + usize.ONE } each = each + usize.ONE }
        if matches != usize.ONE || map.site.index != retention.site.index || map.kind != MapKind.Select || map.source.index != current.index {
          CompilerBug.panic(b"retained path lost its exact originating selector chain")
        }
        current = map.target
        step = step + usize.ONE
      }
      if current.index != paths[path].endpoint.index { CompilerBug.panic(b"retained path changed its selected frontier") }
      path = path + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < addresses.length {
    let address = addresses[at]
    if address.edge >= edges.length || address.alias >= aliases.length { CompilerBug.panic(b"retained address lost its exact alias proof") }
    let edge = edges[address.edge]
    let demandId = match retainedEdgeDemand(closure, edge) { Option<usize>.Some {value} => value
      _ => { return CompilerBug.panic(b"retained address replaced its actual descriptor proof") } }
    let demand = demands[demandId]
    if demand.selectionUse < offset || demand.selectionUse - offset >= requests.length {
      CompilerBug.panic(b"retained address borrowed an ordinary projection demand")
    }
    let request = &requests[demand.selectionUse - offset]
    let paths = List<RetainedPath>.asSlice(&request.paths)
    let key = keys[demand.cell]
    let alias = &aliases[address.alias]
    if address.operation != request.operation || address.input != request.input || address.slot != request.slot
      || address.path >= paths.length || alias.endpoint.index != paths[address.path].endpoint.index
      || alias.evaluation.index != request.execution.index || address.alias != edge.target || !Atom.same(address.active, edge.active)
      || !sameStorage(address.storage, alias.storage) || address.descriptor.index != key.value.index
      || address.category != key.category || address.leaf.index != key.leaf.index || address.direct != key.direct || !retainedHistory(&witnesses[key.witness], address) {
      CompilerBug.panic(b"retained address changed its exact descriptor contributor, witness or canonical storage")
    }
    at = at + usize.ONE
  }
  let reads = List<RetainedRead>.asSlice(&skeleton.retainedReads)
  let canonical = List<ReadValue>.asSlice(&skeleton.reads)
  let values = List<Value>.asSlice(&skeleton.values)
  let transports = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let recorded = List<AliasRead>.asSlice(&skeleton.aliasReads)
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.request >= requests.length || read.read.index >= canonical.length || read.consumer.index >= values.length
      || read.edge >= edges.length || read.alias >= aliases.length { CompilerBug.panic(b"retained current read lost its real reservation") }
    let request = &requests[read.request]
    let paths = List<RetainedPath>.asSlice(&request.paths)
    if read.path >= paths.length { CompilerBug.panic(b"retained read changed its originating path") }
    let selectors = List<MapId>.asSlice(&paths[read.path].selectors)
    if read.prefix == usize.ZERO || read.prefix > selectors.length { CompilerBug.panic(b"retained read has no exact selected prefix") }
    let endpoint = maps[selectors[read.prefix - usize.ONE].index].target
    let input = values[read.consumer.index]
    if input.phase != ValuePhase.Input || input.evaluation.index != request.execution.index || input.endpoint.index != endpoint.index
      || edges[read.edge].target != read.alias || aliases[read.alias].endpoint.index != endpoint.index
      || !sameStorage(canonical[read.read.index].storage, aliases[read.alias].storage) {
      CompilerBug.panic(b"retained read replaced current canonical contents with an old operand")
    }
    let mut found = false
    let mut each = usize.ZERO
    while each < recorded.length {
      if recorded[each].read.index == read.read.index {
        let transport = transports[recorded[each].request]
        if let AliasConsumer.Descriptor {request: selected, path, prefix, edge} = transport.authority {
          if selected == read.request && path == read.path && prefix == read.prefix && edge == read.edge
            && Atom.same(transport.active, read.active) && transport.alias == read.alias { found = true }
        }
      }
      each = each + usize.ONE
    }
    if !found { CompilerBug.panic(b"retained read lost its original edge-gated consumer") }
    at = at + usize.ONE
  }
  return ()
}

effect fn sliceSourceDemands<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let oldProofs = List<SliceProof>.length(&closure.sliceProofs)
  let oldDemands = List<Carriers.Demand>.length(&closure.demands)
  let oldLinks = List<SliceDemand>.length(&closure.sliceDemands)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let nodes = CarriersProduct.nodes(&closure.product)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let conversions = List<SliceConversion>.asSlice(&skeleton.slices)
  let values = List<Value>.asSlice(&skeleton.values)
  let empty = List<Atom>.make()
  let mut nodeId = usize.ZERO
  while nodeId < nodes.length {
    let node = nodes[nodeId]
    let mut conversionId = usize.ZERO
    while conversionId < conversions.length {
      let conversion = conversions[conversionId]
      if keys[node.cell].value.index == conversion.descriptor.index {
        let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
        let selector = residualComponent(List<Prepared.Shape>.asSlice(&prepared.shapes), states[node.state.index].input)
        let indexed = match &selector.selector { Selector.Index {..} => true _ => false }
        if !indexed { return CompilerBug.panic(b"slice conversion was asked to create a non-index address") }
        let mut caseId = usize.ZERO
        while caseId < cases.length {
          let actual = &cases[caseId]
          let exact = match actual.authority {
            TransferAuthority.Physical {map, direction: matchedOrientation, address: Option<EvalId>.None} if matchedOrientation == MapDirection.Forward =>
              map.index == row.descriptor.index && actual.target == node.cell
            _ => false
          }
          if exact {
            let source = match actual.source { Option<usize>.Some {value} => value
              _ => { return CompilerBug.panic(b"slice conversion substituted a new descriptor seed") } }
            let operand = values[keys[source].value.index]
            if operand.evaluation.index != conversion.source.index || operand.endpoint.index != maps[row.descriptor.index].source.index {
              return CompilerBug.panic(b"slice conversion changed its real source descriptor occurrence")
            }
            let retained = List<SliceProof>.asSlice(&closure.sliceProofs)
            let mut proof = usize.MAX
            let mut each = usize.ZERO
            while each < retained.length {
              if retained[each].carrier == nodeId && retained[each].case == caseId
                && retained[each].conversion == conversionId { proof = each }
              each = each + usize.ONE
            }
            if proof == usize.MAX {
              proof = retained.length
              let active = Program.atom(&mut skeleton.rules)
              let gates: [Atom; 2] = [node.active, actual.active]
              run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
              run List<SliceProof>.append(&mut closure.sliceProofs, SliceProof {carrier: nodeId,
                case: caseId, conversion: conversionId, active: active})
            }
            let elements = List<Prepared.ArraySliceElement>.asSlice(&row.elements)
            let outer = List<Carriers.Demand>.asSlice(&closure.demands)[node.demand]
            let mut element = usize.ZERO
            while element < elements.length {
              let mut found = false
              let prior = List<SliceDemand>.asSlice(&closure.sliceDemands)
              each = usize.ZERO
              while each < prior.length {
                if prior[each].proof == proof && prior[each].element == element { found = true }
                each = each + usize.ONE
              }
              if !found {
                let mut referent = usize.MAX
                let mut state = usize.ZERO
                while state < states.length {
                  if authoredResidual(&states[state]) && states[state].selection.index == elements[element].selection.index
                    && states[state].vertex.index == maps[row.referent.index].target.index
                    && states[state].input.shape.index == valueShape(prepared, operand).index {
                    if referent != usize.MAX { return CompilerBug.panic(b"slice source has ambiguous frozen referent histories") }
                    referent = state
                  }
                  state = state + usize.ONE
                }
                if referent == usize.MAX { return CompilerBug.panic(b"slice source lost its explicit Referent/Index history") }
                // A backedge may discover another conversion proof for this SAME
                // source demand. Intern by finite actual query/cell/history, not by the
                // recursively discovered proof ordinal; alternatives add gated rules.
                let existing = List<Carriers.Demand>.asSlice(&closure.demands)
                let links = List<SliceDemand>.asSlice(&closure.sliceDemands)
                let mut demand = usize.MAX
                let mut link = usize.ZERO
                while link < links.length {
                  let candidate = existing[links[link].demand]
                  if candidate.selectionUse == outer.selectionUse && candidate.cell == source
                    && candidate.state.index == referent { demand = links[link].demand }
                  link = link + usize.ONE
                }
                if demand == usize.MAX {
                  demand = existing.length
                  let active = Program.atom(&mut skeleton.rules)
                  run List<Carriers.Demand>.append(&mut closure.demands, Carriers.Demand {selectionUse: outer.selectionUse,
                    cell: source, state: Prepared.ResidualStateId {index: referent}, active: active, reachable: outer.reachable})
                }
                let gate: [Atom; 1] = [List<SliceProof>.asSlice(&closure.sliceProofs)[proof].active]
                run Program.rule(&mut skeleton.rules, List<Carriers.Demand>.asSlice(&closure.demands)[demand].active,
                  &gate, List<Atom>.asSlice(&empty))
                run List<SliceDemand>.append(&mut closure.sliceDemands, SliceDemand {demand: demand, proof: proof, element: element})
              }
              element = element + usize.ONE
            }
          }
          caseId = caseId + usize.ONE
        }
      }
      conversionId = conversionId + usize.ONE
    }
    nodeId = nodeId + usize.ONE
  }
  return oldProofs != List<SliceProof>.length(&closure.sliceProofs)
    || oldDemands != List<Carriers.Demand>.length(&closure.demands)
    || oldLinks != List<SliceDemand>.length(&closure.sliceDemands)
}

effect fn closeDescriptors<'body>(closure: &mut DescriptorClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let keys = List<CellKey>.asSlice(&domain.keys)
  run descriptorDemands(&mut closure.*, prepared, &skeleton.*, keys)
  run retainedDescriptorDemands(&mut closure.*, prepared, &mut skeleton.*, keys, List<Cell>.asSlice(&domain.cells))
  let mut cells = List<Carriers.Cell>.make()
  let mut index = usize.ZERO
  while index < keys.length {
    let actual = List<Value>.asSlice(&skeleton.values)[keys[index].value.index]
    let mut subject = Option<Prepared.ResidualStateId>.none()
    if let Option<ResidualSubject>.Some {value} = actual.subject { subject = Option<Prepared.ResidualStateId>.some(value.state) }
    run List<Carriers.Cell>.append(&mut cells, Carriers.Cell {value: keys[index].value.index,
      endpoint: actual.endpoint, shape: valueShape(prepared, actual), leaf: keys[index].leaf.index, subject: subject})
    index = index + usize.ONE
  }
  let actualCases = List<Case>.asSlice(&domain.cases)
  let mut cases = List<Carriers.Case>.make()
  index = usize.ZERO
  while index < actualCases.length {
    let actual = &actualCases[index]
    let authority = carrierAuthority(prepared, &skeleton.*, keys, actual)
    run List<Carriers.Case>.append(&mut cases, Carriers.Case {source: actual.source, target: actual.target,
      active: actual.active, authority: authority})
    index = index + usize.ONE
  }
  let mut changed = run CarriersProduct.close(&mut closure.product, prepared, List<Carriers.Cell>.asSlice(&cells),
    List<Carriers.Case>.asSlice(&cases), List<Carriers.Pair>.asSlice(&closure.pairs),
    List<Carriers.Demand>.asSlice(&closure.demands), &mut skeleton.rules)
  if run sliceSourceDemands(&mut closure.*, prepared, &mut skeleton.*, domain) { changed = true }
  let nodes = CarriersProduct.nodes(&closure.product)
  let references = List<ReferenceOrigin>.asSlice(&skeleton.references)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  index = usize.ZERO
  while index < nodes.length {
    let node = nodes[index]
    let key = keys[node.cell]
    let mut origin = usize.ZERO
    while origin < references.length {
      let reference = references[origin]
      if key.value.index == reference.descriptor.index && key.leaf.index == reference.leaf.index {
        validateReferenceMaps(endpoints, maps, reference.map, reference.referent)
        let state = &states[node.state.index]
        let components = List<Prepared.Component>.asSlice(&List<Prepared.Shape>.asSlice(&prepared.shapes)[state.input.shape.index].components)
        let through = match &components[state.input.ordinal].selector { Selector.Referent => true _ => false }
        if !through || state.output.index != endpoints[maps[reference.referent.index].target.index].shape.index {
          return CompilerBug.panic(b"descriptor origin changed the demanded referent subject")
        }
        let mut seed = usize.ZERO
        while seed < actualCases.length {
          let seedCase = &actualCases[seed]
          let genuine = match seedCase.source { Option<usize>.None => seedCase.target == node.cell _ => false }
          if genuine {
            let mut alias = usize.ZERO
            while alias < aliases.length {
              let source = aliases[alias]
              if source.evaluation.index == reference.source.index && source.endpoint.index == maps[reference.map.index].source.index {
                let prior = List<OriginProof>.asSlice(&closure.origins)
                let mut found = false
                let mut earlier = usize.ZERO
                while earlier < prior.length {
                  if prior[earlier].carrier == index && prior[earlier].seed == seed
                    && prior[earlier].origin == origin && prior[earlier].sourceAlias == alias { found = true }
                  earlier = earlier + usize.ONE
                }
                if !found {
                  let active = Program.atom(&mut skeleton.rules)
                  let gates: [Atom; 3] = [node.active, seedCase.active, source.active]
                  let empty = List<Atom>.make()
                  run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
                  run List<OriginProof>.append(&mut closure.origins, OriginProof {carrier: index, seed: seed,
                    origin: origin, sourceAlias: alias, active: active})
                  changed = true
                }
              }
              alias = alias + usize.ONE
            }
          }
          seed = seed + usize.ONE
        }
      }
      origin = origin + usize.ONE
    }
    index = index + usize.ONE
  }
  if run activateOriginPlacements(&mut closure.*, prepared, &mut skeleton.*) { changed = true }
  if run activateSlicePlacements(&mut closure.*, prepared, &mut skeleton.*) { changed = true }
  if run activateRetainedAddresses(&closure.*, prepared, &mut skeleton.*, domain) { changed = true }
  if run closeContents(&mut closure.*, prepared, &mut skeleton.*, domain) { changed = true }
  return changed
}

fn fieldReholdSummaryRoot(skeleton: &Skeleton, read: ReadId) -> bool {
  let reads = List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)
  let observations = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)
  let mut selected = false
  let mut at = usize.ZERO
  while at < reads.length {
    if reads[at].read.index == read.index {
      selected = true
      if sameStorage(reads[at].storage, observations[reads[at].observation].owner) { return true }
    }
    at = at + usize.ONE
  }
  return !selected
}

effect fn reserveFieldReholdObservations<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<FieldReholdObservation>.length(&skeleton.fieldReholds.observations)
  let beforeCoverage = List<FieldReholdCoverage>.length(&skeleton.fieldReholds.coverage)
  let requestsCount = List<FieldReholdRequest>.length(&skeleton.fieldReholds.requests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut request = usize.ZERO
  while request < requestsCount {
    let selected = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[request]
    if request == List<FieldReholdCoverage>.length(&skeleton.fieldReholds.coverage) {
      let gates: [Atom; 3] = [selected.active, selected.accepted, Flow.reachable(&skeleton.flow, Skeleton.evaluation(&skeleton.*, selected.execution).point)]
      let active = Program.atom(&mut skeleton.rules)
      run Program.rule(&mut skeleton.rules, active, &gates, &[])
      let missing = Program.atom(&mut skeleton.rules)
      run List<FieldReholdCoverage>.append(&mut skeleton.fieldReholds.coverage, FieldReholdCoverage {request: request, active: active, missing: missing})
    }
    let aliasesCount = List<StorageAlias>.length(&skeleton.aliases)
    let mut alias = usize.ZERO
    while alias < aliasesCount {
      let address = List<StorageAlias>.asSlice(&skeleton.aliases)[alias]
      if address.evaluation.index == selected.address.index && address.endpoint.index == maps[selected.map.index].target.index {
        let owner = Storage {endpoint: storageOwner(prepared, address.storage.endpoint), temporary: address.storage.temporary}
        if !sameStorage(owner, address.storage) {
          let observations = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)
          let mut at = usize.ZERO
          while at < observations.length {
            if observations[at].request == request && observations[at].alias == alias { break }
            at = at + usize.ONE
          }
          if at == observations.length {
            let active = run addressApplies(&mut skeleton.rules, List<FieldReholdCoverage>.asSlice(&skeleton.fieldReholds.coverage)[request].active, address.active)
            let observation = observations.length
            run List<FieldReholdObservation>.append(&mut skeleton.fieldReholds.observations, FieldReholdObservation {
              request: request, alias: alias, storage: address.storage, owner: owner, active: active})
            let components = run referenceOwnerComponents(prepared, owner)
            let componentsSelected = List<EndpointId>.asSlice(&components)
            at = usize.ZERO
            while at < componentsSelected.length {
              let storage = Storage {endpoint: componentsSelected[at], temporary: owner.temporary}
              let read = run reserveOwnerRead(&mut skeleton.*, selected.execution, storage)
              run List<FieldReholdRead>.append(&mut skeleton.fieldReholds.reads, FieldReholdRead {
                observation: observation, storage: storage, read: read.read, value: read.value, active: active})
              at = at + usize.ONE
            }
          }
        }
      }
      alias = alias + usize.ONE
    }
    request = request + usize.ONE
  }
  return before != List<FieldReholdObservation>.length(&skeleton.fieldReholds.observations)
    || beforeCoverage != List<FieldReholdCoverage>.length(&skeleton.fieldReholds.coverage)
}

fn sourceDisposition(skeleton: &Skeleton, definition: Option<DefinitionId>) -> SummaryDisposition {
  if let Option<DefinitionId>.Some {value} = definition {
    if let Option<usize>.Some {value: summary} = List<DefinedValue>.asSlice(&skeleton.definitions)[value.index].summary {
      return List<SummaryStorage>.asSlice(&skeleton.summaries)[summary].disposition
    }
  }
  return SummaryDisposition.Ordinary
}
fn copiedDisposition(disposition: SummaryDisposition) -> SummaryDisposition {
  return match disposition { SummaryDisposition.Ordinary => SummaryDisposition.Ordinary _ => SummaryDisposition.Inherited }
}

// Canonical B is supplied by one actual alias. Descend only the exact original Place
// member's target ancestry, through existing inline children under that B. This gives
// an ownership anchor, never a source, a current contents proof or a reference address.
effect fn fieldReholdAnchor<'body>(prepared: &SourcePreparation<'body>, map: MapId,
  storage: Storage, endpoint: EndpointId) -> Option<EndpointId> ! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let family = run transferFamily(endpoints, maps, map)
  let familySelected = List<MapId>.asSlice(&family)
  let mut member = usize.ZERO
  while member < familySelected.length {
    let row = &maps[familySelected[member].index]
    if row.source.index == endpoint.index {
      let mut path = List<EndpointId>.make()
      let mut current = row.target
      while current.index != maps[map.index].target.index {
        if !inlineWithin(prepared, current, maps[map.index].target) { return Option<EndpointId>.none() }
        run List<EndpointId>.append(&mut path, current)
        current = match endpoints[current.index].parent { Option<EndpointId>.Some {value} => value _ => { return Option<EndpointId>.none() } }
      }
      current = storage.endpoint
      let pathSelected = List<EndpointId>.asSlice(&path)
      let mut at = pathSelected.length
      while at != usize.ZERO {
        at = at - usize.ONE
        let mut child = usize.ZERO
        let mut found = usize.MAX
        while child < endpoints.length {
          let parent = match endpoints[child].parent { Option<EndpointId>.Some {value} => value.index == current.index _ => false }
          if parent && inlineWithin(prepared, EndpointId {index: child}, current)
            && sameSelector(&endpoints[child].selector, &endpoints[pathSelected[at].index].selector) {
            if found != usize.MAX { return CompilerBug.panic(b"field rehold repeats an original inline member") }
            found = child
          }
          child = child + usize.ONE
        }
        if found == usize.MAX { return Option<EndpointId>.none() }
        current = EndpointId {index: found}
      }
      return Option<EndpointId>.some(current)
    }
    member = member + usize.ONE
  }
  return Option<EndpointId>.none()
}

fn sameFieldReholdOrigin(left: FieldReholdOrigin, right: FieldReholdOrigin) -> bool {
  return match left {
    FieldReholdOrigin.Old {fieldRead, definition, read, ..} => match right {
      FieldReholdOrigin.Old {fieldRead: other, definition: d, read: r, ..} => fieldRead == other && definition.index == d.index && read.index == r.index
      _ => false }
    FieldReholdOrigin.Rhs {publication, held} => match right {
      FieldReholdOrigin.Rhs {publication: other, held: placement} => sameOwnershipPlacement(held, placement) && match publication {
        Option<usize>.Some {value} => match other { Option<usize>.Some {value: second} => value == second _ => false }
        _ => match other { Option<usize>.None => true _ => false } }
      _ => false }
  }
}

effect fn fieldReholdCandidate(skeleton: &mut Skeleton, domain: &Domain, observation: usize, case: usize,
  origin: FieldReholdOrigin, placement: OwnershipPlacement, disposition: SummaryDisposition, evidence: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let rows = List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].observation == observation && rows[at].case == case && sameFieldReholdOrigin(rows[at].origin, origin)
      && rows[at].disposition == disposition && sameOwnershipPlacement(rows[at].placement, placement) { return () }
    at = at + usize.ONE
  }
  let observed = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)[observation]
  let request = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[observed.request]
  let anchor = match ownershipAnchor(placement) { Option<EndpointId>.Some {value} => value _ => observed.owner.endpoint }
  let prefix = Storage {endpoint: anchor, temporary: observed.owner.temporary}
  let summary = run Skeleton.summaryStorage(&mut skeleton.*, prefix, placement, disposition)
  let definitions = List<FieldReholdDefinition>.asSlice(&skeleton.fieldReholds.definitions)
  let mut found = usize.ZERO
  while found < definitions.length {
    if definitions[found].observation == observation && definitions[found].summary == summary { break }
    found = found + usize.ONE
  }
  if found == definitions.length {
    let target = run Skeleton.summaryValue(&mut skeleton.*, summary, request.execution, ValuePhase.Output, Option<DefinitionId>.none(), Option<ReadId>.none())
    let active = Program.atom(&mut skeleton.rules)
    let point = Skeleton.evaluation(&skeleton.*, request.execution).point
    let definition = run Flow.define(&mut skeleton.flow, point, List<SummaryStorage>.asSlice(&skeleton.summaries)[summary].component, active, Write.Weak)
    run List<DefinedValue>.append(&mut skeleton.definitions, DefinedValue {definition: definition, value: target,
      writer: Option<EvalId>.some(request.execution), summary: Option<usize>.some(summary), clears: Option<DefinitionId>.none()})
    run List<FieldReholdDefinition>.append(&mut skeleton.fieldReholds.definitions,
      FieldReholdDefinition {observation: observation, summary: summary, definition: definition, value: target, active: active})
  }
  let defined = List<FieldReholdDefinition>.asSlice(&skeleton.fieldReholds.definitions)[found]
  let incoming = &List<Case>.asSlice(&domain.cases)[case]
  let source = List<CellKey>.asSlice(&domain.keys)[incoming.target]
  let gates: [Atom; 3] = [observed.active, incoming.active, evidence]
  let active = Program.atom(&mut skeleton.rules)
  run Program.rule(&mut skeleton.rules, active, &gates, &[])
  let candidate = List<FieldReholdCandidate>.length(&skeleton.fieldReholds.candidates)
  run List<FieldReholdCandidate>.append(&mut skeleton.fieldReholds.candidates, FieldReholdCandidate {
    observation: observation, case: case, origin: origin, source: source.value, target: defined.value,
    summary: summary, definition: defined.definition, placement: placement, disposition: disposition, active: active,
    sourceCell: incoming.target, admitted: defined.active})
  let absent = Program.atom(&mut skeleton.rules)
  run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: source.value, target: defined.value,
    active: active, directness: holdingDirectness(disposition == SummaryDisposition.Shadowed || unknownOwnership(placement)),
    stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
    policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.FieldRehold {candidate: candidate}})
  return ()
}

// Every summary lane of the actual owner is rebound at the prewrite action. Clears are
// gated by operation acceptance, independently of positive candidates or their admissions.
effect fn reserveFieldReholdClears<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<FieldReholdClear>.length(&skeleton.fieldReholds.clears)
  let observationsCount = List<FieldReholdObservation>.length(&skeleton.fieldReholds.observations)
  let summariesCount = List<SummaryStorage>.length(&skeleton.summaries)
  let mut observation = usize.ZERO
  while observation < observationsCount {
    let selected = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)[observation]
    let request = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[selected.request]
    let mut summary = usize.ZERO
    while summary < summariesCount {
      if sameTemporary(List<SummaryStorage>.asSlice(&skeleton.summaries)[summary].prefix.temporary, selected.owner.temporary)
        && inlineWithin(prepared, List<SummaryStorage>.asSlice(&skeleton.summaries)[summary].prefix.endpoint, selected.owner.endpoint) {
        let old = List<FieldReholdClear>.asSlice(&skeleton.fieldReholds.clears)
        let mut at = usize.ZERO
        while at < old.length {
          if old[at].observation == observation && old[at].summary == summary { break }
          at = at + usize.ONE
        }
        if at == old.length {
          let point = Skeleton.evaluation(&skeleton.*, request.execution).point
          let definition = DefinitionId {index: Flow.reservedDefinitions(&skeleton.flow).length}
          let empty = run Skeleton.summaryValue(&mut skeleton.*, summary, request.execution, ValuePhase.Output,
            Option<DefinitionId>.some(definition), Option<ReadId>.none())
          let actual = run Flow.define(&mut skeleton.flow, point, List<SummaryStorage>.asSlice(&skeleton.summaries)[summary].component, selected.active, Write.Strong)
          if actual.index != definition.index { return CompilerBug.panic(b"field rehold clear changed its reserved definition") }
          run List<DefinedValue>.append(&mut skeleton.definitions, DefinedValue {definition: definition, value: empty,
            writer: Option<EvalId>.some(request.execution), summary: Option<usize>.some(summary), clears: Option<DefinitionId>.none()})
          run List<FieldReholdClear>.append(&mut skeleton.fieldReholds.clears, FieldReholdClear {observation: observation, summary: summary, definition: definition})
        }
      }
      summary = summary + usize.ONE
    }
    observation = observation + usize.ONE
  }
  return before != List<FieldReholdClear>.length(&skeleton.fieldReholds.clears)
}

fn fieldReholdRhs<'body>(prepared: &SourcePreparation<'body>, request: FieldReholdRequest, value: Value) -> bool {
  return value.evaluation.index == request.source.index && value.phase == ValuePhase.Output
    && match value.subject { Option<ResidualSubject>.None => true _ => false }
    && match value.summary { Option<usize>.None => true _ => false }
    && match value.writeHolder { Option<usize>.None => true _ => false }
    && match value.transport { Option<AliasPort>.None => true _ => false }
    && inlineWithin(prepared, value.endpoint, List<SelectionMap>.asSlice(&prepared.maps)[request.map.index].source)
}
fn fieldReholdConstruction(skeleton: &Skeleton, request: FieldReholdRequest, witness: &Witness) -> Option<bool> {
  if let Option<DefinitionId>.Some {value} = witness.definition { return ownershipDefinitionBefore(skeleton, value, request.result) }
  let source = match ownershipOrder(skeleton, request.source) { Option<usize>.Some {value} => value _ => { return Option<bool>.none() } }
  let result = match ownershipOrder(skeleton, request.result) { Option<usize>.Some {value} => value _ => { return Option<bool>.none() } }
  return Option<bool>.some(source < result)
}

effect fn reserveFieldReholdCandidates<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  domain: &Domain, publications: &OwnershipPublications) -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<FieldReholdCandidate>.length(&skeleton.fieldReholds.candidates)
  let readsCount = List<FieldReholdRead>.length(&skeleton.fieldReholds.reads)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let mut reading = usize.ZERO
  while reading < readsCount {
    let original = List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)[reading]
    let observation = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)[original.observation]
    let request = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[observation.request]
    let mut case = usize.ZERO
    while case < cases.length {
      let key = keys[cases[case].target]
      if key.value.index == original.value.index {
        if let Option<OwnerReadOriginal>.Some {value: source} = ownerReadOriginal(prepared, &skeleton.*, observation.owner, original.read, &witnesses[key.witness]) {
          let constructed = match ownershipDefinitionBefore(&skeleton.*, source.definition, request.result) { Option<bool>.Some {value} => value _ => false }
          if constructed {
            let disposition = sourceDisposition(&skeleton.*, Option<DefinitionId>.some(source.definition))
            let origin = FieldReholdOrigin.Old {fieldRead: reading, definition: source.definition, read: source.read,
              storage: source.storage, held: source.held, disposition: disposition}
            // Policy alone decides discards(B,A). Previous Shadowed has no ordinary arm.
            if disposition != SummaryDisposition.Shadowed {
              run fieldReholdCandidate(&mut skeleton.*, domain, original.observation, case, origin, source.held, disposition, original.active)
            }
            run fieldReholdCandidate(&mut skeleton.*, domain, original.observation, case, origin, source.held, SummaryDisposition.Shadowed, original.active)
            // Physical observations can carry genuine semantic MAX. It is a separate
            // initial alternative which BC may select only from that original source policy.
            if key.category == SourceRole.Physical {
              let unknown = FieldReholdOrigin.Old {fieldRead: reading, definition: source.definition, read: source.read,
                storage: source.storage, held: OwnershipPlacement.Unknown, disposition: disposition}
              run fieldReholdCandidate(&mut skeleton.*, domain, original.observation, case, unknown, OwnershipPlacement.Unknown, disposition, original.active)
              run fieldReholdCandidate(&mut skeleton.*, domain, original.observation, case, unknown, OwnershipPlacement.Unknown, SummaryDisposition.Shadowed, original.active)
            }
          }
        }
      }
      case = case + usize.ONE
    }
    reading = reading + usize.ONE
  }
  let observationsCount = List<FieldReholdObservation>.length(&skeleton.fieldReholds.observations)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let published = List<OwnershipPublication>.asSlice(&publications.values)
  let mut observation = usize.ZERO
  while observation < observationsCount {
    let selected = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)[observation]
    let request = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[selected.request]
    let family = run transferFamily(endpoints, maps, request.map)
    let familySelected = List<MapId>.asSlice(&family)
    let mut case = usize.ZERO
    while case < cases.length {
      let key = keys[cases[case].target]
      let value = List<Value>.asSlice(&skeleton.values)[key.value.index]
      let constructed = match fieldReholdConstruction(&skeleton.*, request, &witnesses[key.witness]) { Option<bool>.Some {value: matchedConstruction} => matchedConstruction _ => false }
      if fieldReholdRhs(prepared, request, value) && constructed {
        let disposition = copiedDisposition(sourceDisposition(&skeleton.*, witnesses[key.witness].definition))
        if key.category == SourceRole.Physical {
          let mut member = usize.ZERO
          while member < familySelected.length {
            let anchor = maps[familySelected[member].index].source
            if inlineWithin(prepared, anchor, value.endpoint) {
              if let Option<EndpointId>.Some {value: target} = run fieldReholdAnchor(prepared, request.map, selected.storage, anchor) {
                let held = OwnershipPlacement.Known {anchor: anchor, suffix: Option<OwnershipSuffix>.none()}
                run fieldReholdCandidate(&mut skeleton.*, domain, observation, case,
                  FieldReholdOrigin.Rhs {publication: Option<usize>.none(), held: held},
                  OwnershipPlacement.Known {anchor: target, suffix: Option<OwnershipSuffix>.none()}, disposition, cases[case].active)
                // A genuinely computed written prefix has semantic MAX under prefixedPath.
                // This tagged alternative is selected by BC, never by absent geometry.
                run fieldReholdCandidate(&mut skeleton.*, domain, observation, case,
                  FieldReholdOrigin.Rhs {publication: Option<usize>.none(), held: held}, OwnershipPlacement.Unknown, disposition, cases[case].active)
              }
            }
            member = member + usize.ONE
          }
          // prefixedPath(B, MAX) is B, not MAX. BC checks the original full RHS
          // field and exact written prefix before selecting this explicit alternative.
          run fieldReholdCandidate(&mut skeleton.*, domain, observation, case,
            FieldReholdOrigin.Rhs {publication: Option<usize>.none(), held: OwnershipPlacement.Unknown},
            OwnershipPlacement.Known {anchor: selected.storage.endpoint, suffix: Option<OwnershipSuffix>.none()}, disposition, cases[case].active)
          run fieldReholdCandidate(&mut skeleton.*, domain, observation, case,
            FieldReholdOrigin.Rhs {publication: Option<usize>.none(), held: OwnershipPlacement.Unknown},
            OwnershipPlacement.Unknown, disposition, cases[case].active)
        } else {
          let mut row = usize.ZERO
          while row < published.length {
            let publication = published[row]
            if publication.cell == cases[case].target {
              let born = match ownershipPositionBefore(&skeleton.*, publication.placement, request.result, true) { Option<bool>.Some {value: constructedBefore} => constructedBefore _ => false }
              if born {
                run fieldReholdCandidate(&mut skeleton.*, domain, observation, case,
                  FieldReholdOrigin.Rhs {publication: Option<usize>.some(row), held: publication.placement},
                  OwnershipPlacement.Unknown, disposition, publication.active)
                let mut translated = Option<OwnershipPlacement>.none()
                if unknownOwnership(publication.placement) {
                  translated = Option<OwnershipPlacement>.some(OwnershipPlacement.Known {anchor: selected.storage.endpoint, suffix: Option<OwnershipSuffix>.none()})
                } else if let Option<EndpointId>.Some {value: anchor} = ownershipAnchor(publication.placement) {
                  if let Option<EndpointId>.Some {value: target} = run fieldReholdAnchor(prepared, request.map, selected.storage, anchor) {
                    translated = Option<OwnershipPlacement>.some(ownershipAt(publication.placement, target))
                  }
                }
                if let Option<OwnershipPlacement>.Some {value: placement} = translated {
                  run fieldReholdCandidate(&mut skeleton.*, domain, observation, case,
                    FieldReholdOrigin.Rhs {publication: Option<usize>.some(row), held: publication.placement}, placement, disposition, publication.active)
                }
              }
            }
            row = row + usize.ONE
          }
        }
      }
      case = case + usize.ONE
    }
    observation = observation + usize.ONE
  }
  return before != List<FieldReholdCandidate>.length(&skeleton.fieldReholds.candidates)
}

// Return the canonical original write operation for exact final-summary suppression.
fn fieldReholdOriginal(skeleton: &Skeleton, observation: FieldReholdObservation, definition: DefinitionId) -> bool {
  let request = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[observation.request]
  let definitions = List<AliasDefinition>.asSlice(&skeleton.aliasDefinitions)
  let operations = List<AliasOperation>.asSlice(&skeleton.aliasOperations)
  let mut at = usize.ZERO
  while at < definitions.length {
    if definitions[at].definition.index == definition.index {
      if let AliasOperationKind.Write {map, source, address, target, ..} = operations[definitions[at].operation].kind {
        return map.index == request.map.index && source.index == request.source.index && address.index == request.address.index
          && target.index == request.result.index && sameTemporary(definitions[at].storage.temporary, observation.owner.temporary)
      }
    }
    at = at + usize.ONE
  }
  return false
}

// The original physical write still kills physical storage. Its normal summary clear is
// disabled only for this same accepted owner rebind; other aliases and writes remain live.
effect fn recordFieldReholdSuppression<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  definition: DefinitionId, summary: usize, suppressed: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let selected = List<SummaryStorage>.asSlice(&skeleton.summaries)[summary]
  let observations = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)
  let mut at = usize.ZERO
  while at < observations.length {
    let observation = observations[at]
    if sameTemporary(selected.prefix.temporary, observation.owner.temporary)
      && inlineWithin(prepared, selected.prefix.endpoint, observation.owner.endpoint)
      && fieldReholdOriginal(&skeleton.*, observation, definition) {
      let previous = List<FieldReholdSuppression>.asSlice(&skeleton.fieldReholds.suppressions)
      let mut found = false
      let mut each = usize.ZERO
      while each < previous.length {
        if previous[each].original.index == definition.index && previous[each].observation == at
          && previous[each].summary == summary { found = true }
        each = each + usize.ONE
      }
      if !found {
        run List<FieldReholdSuppression>.append(&mut skeleton.fieldReholds.suppressions,
          FieldReholdSuppression {original: definition, observation: at, summary: summary, active: observation.active})
      }
      let gates: [Atom; 1] = [observation.active]
      run Program.rule(&mut skeleton.rules, suppressed, &gates, &[])
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn fieldReholdCase(rules: &mut Program, coveredCases: &mut List<FieldReholdCaseCoverage>, observationActive: Atom, domain: &Domain, observation: usize, reading: Option<usize>,
  case: usize, construction: Option<bool>) -> () ! OutOfMemoryError ? &mut Allocator {
  let original = &List<Case>.asSlice(&domain.cases)[case]
  let key = List<CellKey>.asSlice(&domain.keys)[original.target]
  let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
  let active = run addressApplies(&mut rules.*, observationActive, original.active)
  let covered = Program.atom(&mut rules.*)
  let missing = Program.atom(&mut rules.*)
  let gates: [Atom; 1] = [active]
  let absent: [Atom; 1] = [covered]
  run Program.rule(&mut rules.*, missing, &gates, &absent)
  run List<FieldReholdCaseCoverage>.append(&mut coveredCases.*, FieldReholdCaseCoverage {
    observation: observation, fieldRead: reading, case: case, source: key.value, leaf: key.leaf, category: key.category, direct: key.direct,
    definition: witness.definition, read: witness.read, construction: construction, active: active, covered: covered, missing: missing})
  return ()
}

effect fn sealFieldReholdCoverage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  addresses: &AddressProofCoverage, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)
  let coverage = List<FieldReholdCoverage>.asSlice(&skeleton.fieldReholds.coverage)
  let observations = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)
  let reads = List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let mut request = usize.ZERO
  while request < requests.length {
    let selected = requests[request]
    let status = coverage[request]
    let present = Program.atom(&mut skeleton.rules)
    let mut alias = usize.ZERO
    while alias < aliases.length {
      if aliases[alias].evaluation.index == selected.address.index && aliases[alias].endpoint.index == maps[selected.map.index].target.index {
        let observed = Program.atom(&mut skeleton.rules)
        let mut each = usize.ZERO
        while each < observations.length {
          if observations[each].request == request && observations[each].alias == alias {
            let gates: [Atom; 1] = [observations[each].active]
            run Program.rule(&mut skeleton.rules, observed, &gates, &[])
          }
          each = each + usize.ONE
        }
        let gates: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, present, &gates, &[])
        let required: [Atom; 2] = [status.active, aliases[alias].active]
        let absent: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, status.missing, &required, &absent)
        let incomplete: [Atom; 2] = [status.active, List<Atom>.asSlice(&addresses.aliases)[alias]]
        run Program.rule(&mut skeleton.rules, status.missing, &incomplete, &[])
      }
      alias = alias + usize.ONE
    }
    let gates: [Atom; 1] = [status.active]
    let absent: [Atom; 1] = [present]
    run Program.rule(&mut skeleton.rules, status.missing, &gates, &absent)
    if let Option<usize>.None = ownershipOrder(&skeleton.*, selected.result) { run Program.rule(&mut skeleton.rules, status.missing, &gates, &[]) }
    let mut selection = usize.ZERO
    while selection < selections.length {
      if selections[selection].result.index == selected.address.index {
        if let Option<MapId>.Some {value} = selections[selection].place {
          if maps[value.index].target.index == maps[selected.map.index].target.index {
            let gates: [Atom; 2] = [status.active, List<AddressCoverage>.asSlice(&addresses.requests)[selection].missing]
            run Program.rule(&mut skeleton.rules, status.missing, &gates, &[])
          }
        }
      }
      selection = selection + usize.ONE
    }
    request = request + usize.ONE
  }
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let mut observation = usize.ZERO
  while observation < observations.length {
    let selected = observations[observation]
    let request = requests[selected.request]
    let status = coverage[selected.request]
    let components = run referenceOwnerComponents(prepared, selected.owner)
    let componentsSelected = List<EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < componentsSelected.length {
      let present = Program.atom(&mut skeleton.rules)
      let mut read = usize.ZERO
      while read < reads.length {
        if reads[read].observation == observation && reads[read].storage.endpoint.index == componentsSelected[component].index {
          let gates: [Atom; 1] = [reads[read].active]
          run Program.rule(&mut skeleton.rules, present, &gates, &[])
        }
        read = read + usize.ONE
      }
      let gates: [Atom; 1] = [selected.active]
      let absent: [Atom; 1] = [present]
      run Program.rule(&mut skeleton.rules, status.missing, &gates, &absent)
      component = component + usize.ONE
    }
    let mut summary = usize.ZERO
    while summary < summaries.length {
      if sameTemporary(summaries[summary].prefix.temporary, selected.owner.temporary)
        && inlineWithin(prepared, summaries[summary].prefix.endpoint, selected.owner.endpoint) {
        let present = Program.atom(&mut skeleton.rules)
        let mut read = usize.ZERO
        while read < reads.length {
          if reads[read].observation == observation && sameStorage(reads[read].storage, selected.owner) {
            let mut each = usize.ZERO
            while each < summaryReads.length {
              if summaryReads[each].summary == summary && summaryReads[each].original.index == reads[read].read.index {
                let gates: [Atom; 2] = [reads[read].active, summaryReads[each].active]
                run Program.rule(&mut skeleton.rules, present, &gates, &[])
              }
              each = each + usize.ONE
            }
          }
          read = read + usize.ONE
        }
        let gates: [Atom; 1] = [selected.active]
        let absent: [Atom; 1] = [present]
        run Program.rule(&mut skeleton.rules, status.missing, &gates, &absent)
      }
      summary = summary + usize.ONE
    }
    let mut case = usize.ZERO
    while case < cases.length {
      let key = keys[cases[case].target]
      let witness = &witnesses[key.witness]
      let mut read = usize.ZERO
      while read < reads.length {
        let original = reads[read]
        if original.observation == observation && original.value.index == key.value.index && referenceReadHistory(original.read, witness.read, summaryReads) {
          let construction = match ownerReadOriginal(prepared, &skeleton.*, selected.owner, original.read, witness) {
            Option<OwnerReadOriginal>.Some {value} => ownershipDefinitionBefore(&skeleton.*, value.definition, request.result)
            _ => Option<bool>.none() }
          run fieldReholdCase(&mut skeleton.rules, &mut skeleton.fieldReholds.cases, selected.active, domain, observation, Option<usize>.some(read), case, construction)
        }
        read = read + usize.ONE
      }
      if fieldReholdRhs(prepared, request, List<Value>.asSlice(&skeleton.values)[key.value.index]) {
        let construction = fieldReholdConstruction(&skeleton.*, request, witness)
        run fieldReholdCase(&mut skeleton.rules, &mut skeleton.fieldReholds.cases, selected.active, domain, observation, Option<usize>.none(), case, construction)
      }
      case = case + usize.ONE
    }
    observation = observation + usize.ONE
  }
  return ()
}

effect fn validateFieldReholds<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, domain: &Domain,
  publications: &OwnershipPublications) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)
  let observations = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)
  let reads = List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)
  let candidates = List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates)
  let coverage = List<FieldReholdCoverage>.asSlice(&skeleton.fieldReholds.coverage)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let values = List<Value>.asSlice(&skeleton.values)
  let definitions = List<DefinedValue>.asSlice(&skeleton.definitions)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let actualDefinitions = Flow.reservedDefinitions(&skeleton.flow)
  let actualReads = Flow.reservedReads(&skeleton.flow)
  let recorded = List<ReadValue>.asSlice(&skeleton.reads)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  if coverage.length != requests.length { return CompilerBug.panic(b"field rehold omitted request coverage") }
  let mut at = usize.ZERO
  while at < coverage.length {
    if coverage[at].request != at { return CompilerBug.panic(b"field rehold changed request coverage ordinal") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < observations.length {
    let observation = observations[at]
    if observation.request >= requests.length || observation.alias >= aliases.length { return CompilerBug.panic(b"field rehold lost address evidence") }
    let request = requests[observation.request]
    let alias = &aliases[observation.alias]
    if alias.evaluation.index != request.address.index || alias.endpoint.index != maps[request.map.index].target.index
      || !sameStorage(alias.storage, observation.storage) || sameStorage(observation.storage, observation.owner)
      || storageOwner(prepared, observation.storage.endpoint).index != observation.owner.endpoint.index
      || !sameTemporary(observation.storage.temporary, observation.owner.temporary) {
      return CompilerBug.panic(b"field rehold changed original B or canonical whole owner")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.observation >= observations.length || read.read.index >= recorded.length || read.value.index >= values.length {
      return CompilerBug.panic(b"field rehold read omitted original evidence")
    }
    let observation = observations[read.observation]
    let request = requests[observation.request]
    if recorded[read.read.index].value.index != read.value.index || !sameStorage(recorded[read.read.index].storage, read.storage)
      || values[read.value.index].phase != ValuePhase.Input || values[read.value.index].evaluation.index != request.execution.index
      || actualReads[read.read.index].point.index != Skeleton.evaluation(skeleton, request.execution).point.index
      || !sameTemporary(read.storage.temporary, observation.owner.temporary) || !inlineWithin(prepared, read.storage.endpoint, observation.owner.endpoint) {
      return CompilerBug.panic(b"field rehold substituted another prewrite observation")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < candidates.length {
    let candidate = candidates[at]
    if candidate.observation >= observations.length || candidate.case >= cases.length || candidate.sourceCell >= keys.length
      || candidate.summary >= summaries.length || candidate.definition.index >= definitions.length { return CompilerBug.panic(b"field rehold candidate omitted original coordinates") }
    let observation = observations[candidate.observation]
    let request = requests[observation.request]
    let summary = summaries[candidate.summary]
    let key = keys[candidate.sourceCell]
    let witness = &witnesses[key.witness]
    let defined = definitions[candidate.definition.index]
    let exact = match defined.summary { Option<usize>.Some {value} => value == candidate.summary _ => false }
    if cases[candidate.case].target != candidate.sourceCell || key.value.index != candidate.source.index || !exact
      || defined.value.index != candidate.target.index || values[candidate.target.index].evaluation.index != request.execution.index
      || actualDefinitions[candidate.definition.index].point.index != Skeleton.evaluation(skeleton, request.execution).point.index
      || !Atom.same(actualDefinitions[candidate.definition.index].active, candidate.admitted) || actualDefinitions[candidate.definition.index].write != Write.Weak
      || !sameOwnershipPlacement(summary.placement, candidate.placement) || summary.disposition != candidate.disposition
      || !sameTemporary(summary.prefix.temporary, observation.owner.temporary) || !inlineWithin(prepared, summary.prefix.endpoint, observation.owner.endpoint) {
      return CompilerBug.panic(b"field rehold changed its incoming Case or semantic definition")
    }
    validateOwnershipPlacement(prepared, List<ReferenceOrigin>.asSlice(&skeleton.references), values,
      List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions), candidate.placement)
    match candidate.origin {
      FieldReholdOrigin.Old {fieldRead, definition, read, storage, held, disposition} => {
        if fieldRead >= reads.length || reads[fieldRead].observation != candidate.observation || reads[fieldRead].value.index != candidate.source.index {
          return CompilerBug.panic(b"field rehold changed its original whole owner Input")
        }
        let original = match ownerReadOriginal(prepared, skeleton, observation.owner, reads[fieldRead].read, witness) {
          Option<OwnerReadOriginal>.Some {value} => value _ => { return CompilerBug.panic(b"field rehold lost its original def/read pair") } }
        let constructed = match ownershipDefinitionBefore(skeleton, definition, request.result) { Option<bool>.Some {value} => value _ => false }
        let exactHeld = sameOwnershipPlacement(original.held, held) || (key.category == SourceRole.Physical && unknownOwnership(held))
        if !constructed || original.definition.index != definition.index || original.read.index != read.index || !sameStorage(original.storage, storage)
          || !exactHeld || !sameOwnershipPlacement(held, candidate.placement) || sourceDisposition(skeleton, witness.definition) != disposition
          || (candidate.disposition != SummaryDisposition.Shadowed && candidate.disposition != disposition)
          || (disposition == SummaryDisposition.Shadowed && candidate.disposition != SummaryDisposition.Shadowed) {
          return CompilerBug.panic(b"field rehold changed original A, disposition or construction inventory")
        }
      }
      FieldReholdOrigin.Rhs {publication, held} => {
        let constructed = match fieldReholdConstruction(skeleton, request, witness) { Option<bool>.Some {value} => value _ => false }
        let born = match ownershipPositionBefore(skeleton, held, request.result, true) { Option<bool>.Some {value} => value _ => false }
        if !constructed || !born || !fieldReholdRhs(prepared, request, values[candidate.source.index])
          || candidate.disposition != copiedDisposition(sourceDisposition(skeleton, witness.definition)) {
          return CompilerBug.panic(b"field rehold changed original RHS or inherited disposition")
        }
        if let Option<usize>.Some {value} = publication {
          let rows = List<OwnershipPublication>.asSlice(&publications.values)
          if value >= rows.length || rows[value].cell != candidate.sourceCell || !sameOwnershipPlacement(rows[value].placement, held) {
            return CompilerBug.panic(b"field rehold fabricated an ownership RHS suffix")
          }
        } else if key.category != SourceRole.Physical { return CompilerBug.panic(b"ownership RHS lacks its actual publication") }
        if !unknownOwnership(candidate.placement) {
          let mut expected = OwnershipPlacement.Known {anchor: observation.storage.endpoint, suffix: Option<OwnershipSuffix>.none()}
          if let Option<EndpointId>.Some {value: anchor} = ownershipAnchor(held) {
            let target = match run fieldReholdAnchor(prepared, request.map, observation.storage, anchor) {
              Option<EndpointId>.Some {value} => value _ => { return CompilerBug.panic(b"field rehold has no exact RHS anchor counterpart") } }
            expected = ownershipAt(held, target)
          }
          if !sameOwnershipPlacement(expected, candidate.placement) { return CompilerBug.panic(b"field rehold substituted a prefixed ownership path") }
        }
      }
    }
    at = at + usize.ONE
  }
  let clears = List<FieldReholdClear>.asSlice(&skeleton.fieldReholds.clears)
  at = usize.ZERO
  while at < clears.length {
    let clear = clears[at]
    if clear.observation >= observations.length || clear.summary >= summaries.length || clear.definition.index >= definitions.length {
      return CompilerBug.panic(b"field rehold clear omitted original coordinates")
    }
    let observation = observations[clear.observation]
    let request = requests[observation.request]
    let actual = actualDefinitions[clear.definition.index]
    let recorded = definitions[clear.definition.index]
    let empty = values[recorded.value.index]
    let sameSummary = match recorded.summary { Option<usize>.Some {value} => value == clear.summary _ => false }
      && match empty.summary { Option<usize>.Some {value} => value == clear.summary _ => false }
    let sameWriter = match recorded.writer { Option<EvalId>.Some {value} => value.index == request.execution.index _ => false }
    let dedicated = match empty.cleared { Option<DefinitionId>.Some {value} => value.index == clear.definition.index _ => false }
    if !sameSummary || !sameWriter || !dedicated || empty.evaluation.index != request.execution.index || empty.phase != ValuePhase.Output
      || match recorded.clears { Option<DefinitionId>.Some {..} => true _ => false } {
      return CompilerBug.panic(b"field rehold clear lost its dedicated empty summary definition")
    }
    if actual.point.index != Skeleton.evaluation(skeleton, request.execution).point.index
      || actual.component.index != summaries[clear.summary].component.index || !Atom.same(actual.active, observation.active)
      || actual.write != Write.Strong || !sameTemporary(summaries[clear.summary].prefix.temporary, observation.owner.temporary)
      || !inlineWithin(prepared, summaries[clear.summary].prefix.endpoint, observation.owner.endpoint) {
      return CompilerBug.panic(b"field rehold clear is not its accepted whole-owner semantic rebind")
    }
    at = at + usize.ONE
  }
  let suppressions = List<FieldReholdSuppression>.asSlice(&skeleton.fieldReholds.suppressions)
  at = usize.ZERO
  while at < suppressions.length {
    let row = suppressions[at]
    if row.original.index >= definitions.length || row.observation >= observations.length || row.summary >= summaries.length {
      return CompilerBug.panic(b"field rehold suppression lost its original write or semantic owner")
    }
    let observation = observations[row.observation]
    let selected = summaries[row.summary]
    if !Atom.same(row.active, observation.active) || !fieldReholdOriginal(skeleton, observation, row.original)
      || !sameTemporary(selected.prefix.temporary, observation.owner.temporary)
      || !inlineWithin(prepared, selected.prefix.endpoint, observation.owner.endpoint) {
      return CompilerBug.panic(b"field rehold suppression substituted another write or owner")
    }
    at = at + usize.ONE
  }
  let obligations = List<FieldReholdCaseCoverage>.asSlice(&skeleton.fieldReholds.cases)
  at = usize.ZERO
  while at < obligations.length {
    let obligation = obligations[at]
    if obligation.observation >= observations.length || obligation.case >= cases.length { return CompilerBug.panic(b"field rehold coverage lost incoming Case") }
    let key = keys[cases[obligation.case].target]
    let witness = &witnesses[key.witness]
    let definition = match witness.definition {
      Option<DefinitionId>.Some {value} => match obligation.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
      _ => match obligation.definition { Option<DefinitionId>.None => true _ => false } }
    let read = match witness.read {
      Option<ReadId>.Some {value} => match obligation.read { Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
      _ => match obligation.read { Option<ReadId>.None => true _ => false } }
    if key.value.index != obligation.source.index || key.leaf.index != obligation.leaf.index || key.category != obligation.category
      || key.direct != obligation.direct || !definition || !read { return CompilerBug.panic(b"field rehold coverage substituted a coincident raw history") }
    at = at + usize.ONE
  }
  return ()
}

// Only the whole canonical owner's original invalidation kills semantic holdings. A
// selected Move's physical child definitions remain in Flow but clear no summary lane.
fn moveSummaryClear<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, definition: DefinitionId) -> bool {
  let definitions = List<AliasDefinition>.asSlice(&skeleton.aliasDefinitions)
  let operations = List<AliasOperation>.asSlice(&skeleton.aliasOperations)
  let requests = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)
  let mut at = usize.ZERO
  while at < definitions.length {
    if definitions[at].definition.index == definition.index {
      if let AliasOperationKind.Invalidate {address, target, root, ..} = operations[definitions[at].operation].kind {
        let mut request = usize.ZERO
        while request < requests.length {
          let selected = requests[request]
          if selected.source.index == address.index && selected.result.index == target.index
            && List<SelectionMap>.asSlice(&prepared.maps)[selected.map.index].source.index == root.index {
            return definitions[at].storage.endpoint.index == storageOwner(prepared, definitions[at].storage.endpoint).index
          }
          request = request + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return true
}

fn validateConsumedDrop<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, request: ConsumedDrop) -> () {
  let actual = Skeleton.evaluation(skeleton, request.evaluation)
  let site = match actual.site { EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"consumed Drop has no actual operation") } }
  let operand = match &prepared.body.nodes[site.index].kind {
    NodeKind.Drop {value, consumed: Option<ConsumedPlace>.Some {..}} => value
    _ => { return CompilerBug.panic(b"Drop observation requires typing's consumed place") }
  }
  let source = Skeleton.evaluation(skeleton, request.source)
  let original = match source.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  if request.root.index >= endpoints.length { CompilerBug.panic(b"Drop observation lost its operand Storage root") }
  let root = &endpoints[request.root.index]
  let exact = match root.root { Root.Node {node, category} => node.index == operand.index && category == EndpointRole.Storage _ => false }
  if !original || !exact || actual.category != EvaluationRole.Value || actual.point.index != request.point.index
    || match root.parent { Option<EndpointId>.Some {..} => true _ => false } {
    CompilerBug.panic(b"Drop observation changed its original operand or execution point")
  }
  return ()
}

fn validateConsumedDrops<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let requests = List<ConsumedDrop>.asSlice(&skeleton.drops.requests)
  let observations = List<DropObservation>.asSlice(&skeleton.drops.observations)
  let reads = List<DropRead>.asSlice(&skeleton.drops.reads)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let values = List<Value>.asSlice(&skeleton.values)
  let originalReads = List<ReadValue>.asSlice(&skeleton.reads)
  let flowReads = Flow.reservedReads(&skeleton.flow)
  let coverage = List<DropCoverage>.asSlice(&skeleton.drops.coverage)
  if coverage.length != requests.length { CompilerBug.panic(b"Drop observation omitted request coverage") }
  let mut at = usize.ZERO
  while at < requests.length {
    validateConsumedDrop(prepared, skeleton, requests[at])
    if coverage[at].request != at { CompilerBug.panic(b"Drop coverage substituted another operation") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < observations.length {
    let row = observations[at]
    if row.request >= requests.length || row.alias >= aliases.length { CompilerBug.panic(b"Drop observation lost its actual alias") }
    let request = requests[row.request]
    let alias = aliases[row.alias]
    let owner = Storage {endpoint: storageOwner(prepared, alias.storage.endpoint), temporary: alias.storage.temporary}
    if alias.evaluation.index != request.source.index || alias.endpoint.index != request.root.index
      || !sameStorage(alias.storage, row.storage) || !sameStorage(owner, row.owner) {
      CompilerBug.panic(b"Drop observation substituted a different selected owner")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < reads.length {
    let row = reads[at]
    if row.observation >= observations.length || row.value.index >= values.length || row.read.index >= flowReads.length {
      CompilerBug.panic(b"Drop read lost its actual acquisition coordinate")
    }
    let observation = observations[row.observation]
    let request = requests[observation.request]
    let value = values[row.value.index]
    if value.evaluation.index != request.evaluation.index || value.phase != ValuePhase.Input
      || value.endpoint.index != row.storage.endpoint.index || flowReads[row.read.index].point.index != request.point.index
      || !sameTemporary(row.storage.temporary, observation.owner.temporary)
      || !inlineWithin(prepared, row.storage.endpoint, observation.owner.endpoint)
      || !Atom.same(row.active, observation.active) {
      CompilerBug.panic(b"Drop read substituted an earlier snapshot or a referent component")
    }
    if let Option<ResidualSubject>.Some {..} = value.subject { CompilerBug.panic(b"Drop read substituted a selected value") }
    if let Option<usize>.Some {..} = value.summary { CompilerBug.panic(b"Drop read substituted a summary publication") }
    if let Option<usize>.Some {..} = value.writeHolder { CompilerBug.panic(b"Drop read substituted a write holder") }
    let mut found = usize.ZERO
    let mut each = usize.ZERO
    while each < originalReads.length {
      let original = originalReads[each]
      if original.read.index == row.read.index && original.value.index == row.value.index && sameStorage(original.storage, row.storage)
        && match original.map { Option<MapId>.None => true _ => false }
        && match original.summary { Option<usize>.None => true _ => false } { found = found + usize.ONE }
      each = each + usize.ONE
    }
    if found != usize.ONE { CompilerBug.panic(b"Drop observation has no unique original current read") }
    at = at + usize.ONE
  }
  return ()
}

effect fn sealDropCoverage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  addresses: &AddressProofCoverage) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<ConsumedDrop>.asSlice(&skeleton.drops.requests)
  let coverage = List<DropCoverage>.asSlice(&skeleton.drops.coverage)
  let observations = List<DropObservation>.asSlice(&skeleton.drops.observations)
  let reads = List<DropRead>.asSlice(&skeleton.drops.reads)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let mut request = usize.ZERO
  while request < requests.length {
    let selected = requests[request]
    let status = coverage[request]
    let grounded = Program.atom(&mut skeleton.rules)
    let mut alias = usize.ZERO
    while alias < aliases.length {
      let address = aliases[alias]
      if address.evaluation.index == selected.source.index && address.endpoint.index == selected.root.index {
        let observed = Program.atom(&mut skeleton.rules)
        let mut each = usize.ZERO
        while each < observations.length {
          if observations[each].request == request && observations[each].alias == alias {
            let gate: [Atom; 1] = [observations[each].active]
            run Program.rule(&mut skeleton.rules, observed, &gate, &[])
          }
          each = each + usize.ONE
        }
        let gate: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, grounded, &gate, &[])
        let required: [Atom; 2] = [status.active, address.active]
        let absent: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, status.missing, &required, &absent)
        let incomplete: [Atom; 2] = [status.active, List<Atom>.asSlice(&addresses.aliases)[alias]]
        run Program.rule(&mut skeleton.rules, status.missing, &incomplete, &[])
      }
      alias = alias + usize.ONE
    }
    let active: [Atom; 1] = [status.active]
    let absent: [Atom; 1] = [grounded]
    run Program.rule(&mut skeleton.rules, status.missing, &active, &absent)
    let mut each = usize.ZERO
    while each < selections.length {
      if selections[each].result.index == selected.source.index {
        if let Option<MapId>.Some {value} = selections[each].place {
          if maps[value.index].target.index == selected.root.index {
            let gates: [Atom; 2] = [status.active, List<AddressCoverage>.asSlice(&addresses.requests)[each].missing]
            run Program.rule(&mut skeleton.rules, status.missing, &gates, &[])
          }
        }
      }
      each = each + usize.ONE
    }
    request = request + usize.ONE
  }
  let mut observation = usize.ZERO
  while observation < observations.length {
    let selected = observations[observation]
    let missing = coverage[selected.request].missing
    let components = run referenceOwnerComponents(prepared, selected.owner)
    let componentsSelected = List<EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < componentsSelected.length {
      let present = Program.atom(&mut skeleton.rules)
      let mut each = usize.ZERO
      while each < reads.length {
        if reads[each].observation == observation && reads[each].storage.endpoint.index == componentsSelected[component].index {
          let gates: [Atom; 1] = [reads[each].active]
          run Program.rule(&mut skeleton.rules, present, &gates, &[])
        }
        each = each + usize.ONE
      }
      let gates: [Atom; 1] = [selected.active]
      let absent: [Atom; 1] = [present]
      run Program.rule(&mut skeleton.rules, missing, &gates, &absent)
      component = component + usize.ONE
    }
    let mut summary = usize.ZERO
    while summary < summaries.length {
      if sameTemporary(summaries[summary].prefix.temporary, selected.owner.temporary)
        && inlineWithin(prepared, summaries[summary].prefix.endpoint, selected.owner.endpoint) {
        let present = Program.atom(&mut skeleton.rules)
        let mut each = usize.ZERO
        while each < reads.length {
          if reads[each].observation == observation && sameStorage(reads[each].storage, selected.owner) {
            let mut reading = usize.ZERO
            while reading < summaryReads.length {
              if summaryReads[reading].original.index == reads[each].read.index && summaryReads[reading].summary == summary {
                let gates: [Atom; 2] = [reads[each].active, summaryReads[reading].active]
                run Program.rule(&mut skeleton.rules, present, &gates, &[])
              }
              reading = reading + usize.ONE
            }
          }
          each = each + usize.ONE
        }
        let gates: [Atom; 1] = [selected.active]
        let absent: [Atom; 1] = [present]
        run Program.rule(&mut skeleton.rules, missing, &gates, &absent)
      }
      summary = summary + usize.ONE
    }
    observation = observation + usize.ONE
  }
  return ()
}

effect fn sealMoveCoverage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  addresses: &AddressProofCoverage, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)
  let coverage = List<MoveCoverage>.asSlice(&skeleton.selectedMoves.coverage)
  let observations = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)
  let reads = List<MoveRead>.asSlice(&skeleton.selectedMoves.reads)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let mut request = usize.ZERO
  while request < requests.length {
    let selected = requests[request]
    let status = coverage[request]
    let grounded = Program.atom(&mut skeleton.rules)
    let mut alias = usize.ZERO
    while alias < aliases.length {
      let address = aliases[alias]
      if address.evaluation.index == selected.source.index && address.endpoint.index == maps[selected.map.index].source.index {
        let observed = Program.atom(&mut skeleton.rules)
        if address.storage.endpoint.index == storageOwner(prepared, address.storage.endpoint).index {
          let gates: [Atom; 2] = [status.active, address.active]
          run Program.rule(&mut skeleton.rules, observed, &gates, &[])
        }
        let mut each = usize.ZERO
        while each < observations.length {
          if observations[each].request == request && observations[each].alias == alias {
            let gate: [Atom; 1] = [observations[each].active]
            run Program.rule(&mut skeleton.rules, observed, &gate, &[])
          }
          each = each + usize.ONE
        }
        let gate: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, grounded, &gate, &[])
        let required: [Atom; 2] = [status.active, address.active]
        let absent: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, status.missing, &required, &absent)
        let incomplete: [Atom; 2] = [status.active, List<Atom>.asSlice(&addresses.aliases)[alias]]
        run Program.rule(&mut skeleton.rules, status.missing, &incomplete, &[])
      }
      alias = alias + usize.ONE
    }
    let active: [Atom; 1] = [status.active]
    let absent: [Atom; 1] = [grounded]
    run Program.rule(&mut skeleton.rules, status.missing, &active, &absent)
    if let Option<usize>.None = ownershipOrder(&skeleton.*, selected.result) {
      run Program.rule(&mut skeleton.rules, status.missing, &active, &[])
    }
    let mut each = usize.ZERO
    while each < selections.length {
      if selections[each].result.index == selected.source.index {
        if let Option<MapId>.Some {value} = selections[each].place {
          if maps[value.index].target.index == maps[selected.map.index].source.index {
            let gates: [Atom; 2] = [status.active, List<AddressCoverage>.asSlice(&addresses.requests)[each].missing]
            run Program.rule(&mut skeleton.rules, status.missing, &gates, &[])
          }
        }
      }
      each = each + usize.ONE
    }
    request = request + usize.ONE
  }
  let mut observation = usize.ZERO
  while observation < observations.length {
    let selected = observations[observation]
    let missing = coverage[selected.request].missing
    let components = run referenceOwnerComponents(prepared, selected.owner)
    let componentsSelected = List<EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < componentsSelected.length {
      let present = Program.atom(&mut skeleton.rules)
      let mut each = usize.ZERO
      while each < reads.length {
        if reads[each].observation == observation && reads[each].storage.endpoint.index == componentsSelected[component].index {
          let gates: [Atom; 1] = [reads[each].active]
          run Program.rule(&mut skeleton.rules, present, &gates, &[])
        }
        each = each + usize.ONE
      }
      let gates: [Atom; 1] = [selected.active]
      let absent: [Atom; 1] = [present]
      run Program.rule(&mut skeleton.rules, missing, &gates, &absent)
      component = component + usize.ONE
    }
    let mut summary = usize.ZERO
    while summary < summaries.length {
      if sameTemporary(summaries[summary].prefix.temporary, selected.owner.temporary)
        && inlineWithin(prepared, summaries[summary].prefix.endpoint, selected.owner.endpoint) {
        let present = Program.atom(&mut skeleton.rules)
        let mut each = usize.ZERO
        while each < reads.length {
          if reads[each].observation == observation && sameStorage(reads[each].storage, selected.owner) {
            let mut reading = usize.ZERO
            while reading < summaryReads.length {
              if summaryReads[reading].original.index == reads[each].read.index && summaryReads[reading].summary == summary {
                let gates: [Atom; 2] = [reads[each].active, summaryReads[reading].active]
                run Program.rule(&mut skeleton.rules, present, &gates, &[])
              }
              reading = reading + usize.ONE
            }
          }
          each = each + usize.ONE
        }
        let gates: [Atom; 1] = [selected.active]
        let absent: [Atom; 1] = [present]
        run Program.rule(&mut skeleton.rules, missing, &gates, &absent)
      }
      summary = summary + usize.ONE
    }
    observation = observation + usize.ONE
  }
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let mut reading = usize.ZERO
  while reading < reads.length {
    let original = reads[reading]
    let request = observations[original.observation].request
    let mut case = usize.ZERO
    while case < cases.length {
      let key = keys[cases[case].target]
      let witness = &witnesses[key.witness]
      if key.value.index == original.value.index && referenceReadHistory(original.read, witness.read, summaryReads) {
        let construction = match moveOriginal(prepared, &skeleton.*, original, witness) {
          Option<OwnerReadOriginal>.Some {value} => moveConstruction(&skeleton.*, request, value.definition)
          _ => Option<bool>.none()
        }
        let active = run addressApplies(&mut skeleton.rules, original.active, cases[case].active)
        let covered = Program.atom(&mut skeleton.rules)
        let missing = Program.atom(&mut skeleton.rules)
        let positive: [Atom; 1] = [active]
        let negative: [Atom; 1] = [covered]
        run Program.rule(&mut skeleton.rules, missing, &positive, &negative)
        run List<MoveHoldingCoverage>.append(&mut skeleton.selectedMoves.holdingCoverage, MoveHoldingCoverage {
          moveRead: reading, observation: original.observation, request: request, case: case,
          source: key.value, leaf: key.leaf, category: key.category, direct: key.direct,
          definition: witness.definition, read: witness.read, construction: construction,
          active: active, covered: covered, missing: missing})
      }
      case = case + usize.ONE
    }
    reading = reading + usize.ONE
  }

  return ()
}

effect fn validateSelectedMoves<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, domain: &Domain) -> ()
! OutOfMemoryError ? &mut Allocator {
  let requests = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)
  let observations = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)
  let reads = List<MoveRead>.asSlice(&skeleton.selectedMoves.reads)
  let holdings = List<MoveHolding>.asSlice(&skeleton.selectedMoves.holdings)
  let positions = List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions)
  let coverage = List<MoveCoverage>.asSlice(&skeleton.selectedMoves.coverage)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let values = List<Value>.asSlice(&skeleton.values)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let recorded = List<ReadValue>.asSlice(&skeleton.reads)
  let actualReads = Flow.reservedReads(&skeleton.flow)
  if coverage.length != requests.length { CompilerBug.panic(b"Move omitted original request coverage") }
  let mut at = usize.ZERO
  while at < coverage.length {
    if coverage[at].request != at { CompilerBug.panic(b"Move coverage changed its request ordinal") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < observations.length {
    let observed = observations[at]
    if observed.request >= requests.length || observed.alias >= aliases.length { CompilerBug.panic(b"Move observation lost original evidence") }
    let request = requests[observed.request]
    let alias = aliases[observed.alias]
    if alias.evaluation.index != request.source.index || alias.endpoint.index != maps[request.map.index].source.index
      || !sameStorage(alias.storage, observed.storage) || sameStorage(observed.storage, observed.owner)
      || observed.owner.endpoint.index != storageOwner(prepared, observed.storage.endpoint).index
      || !sameTemporary(observed.storage.temporary, observed.owner.temporary) {
      CompilerBug.panic(b"Move observation substituted canonical B or its whole owner")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.observation >= observations.length || read.read.index >= recorded.length || read.value.index >= values.length {
      CompilerBug.panic(b"Move read omitted its original observation")
    }
    let observation = observations[read.observation]
    let request = requests[observation.request]
    let original = recorded[read.read.index]
    let value = values[read.value.index]
    if !sameStorage(original.storage, read.storage) || original.value.index != read.value.index
      || value.phase != ValuePhase.Input || value.evaluation.index != request.execution.index
      || actualReads[read.read.index].point.index != Skeleton.evaluation(skeleton, request.execution).point.index
      || !sameTemporary(read.storage.temporary, observation.owner.temporary)
      || !inlineWithin(prepared, read.storage.endpoint, observation.owner.endpoint) {
      CompilerBug.panic(b"Move read is not a genuine pre-kill whole-owner Input")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < positions.length {
    let position = &positions[at]
    if position.request >= requests.length { CompilerBug.panic(b"ownership position omitted its construction occurrence") }
    let admitted = match moveConstruction(skeleton, position.request, position.definition) { Option<bool>.Some {value} => value _ => false }
    if !admitted { CompilerBug.panic(b"ownership position retroactively enlarged an earlier construction") }
    if let OwnershipPlacement.Position {position: previous, ..} = position.held {
      if previous.index >= at { CompilerBug.panic(b"ownership position has cyclic construction ancestry") }
    }
    let root = storageOwner(prepared, position.storage.endpoint)
    let expected = match move run ownershipPositionSteps(prepared, positions, root, position.held) {
      Option<List<OwnershipPositionStep>>.Some {value} => move value
      _ => { return CompilerBug.panic(b"ownership position has an unauthenticated semantic path") }
    }
    let expectedSelected = List<OwnershipPositionStep>.asSlice(&expected)
    let steps = List<OwnershipPositionStep>.asSlice(&position.steps)
    if steps.length != expectedSelected.length { CompilerBug.panic(b"ownership position lost an atomic selector part") }
    let mut step = usize.ZERO
    while step < steps.length {
      if steps[step].endpoint.index != expectedSelected[step].endpoint.index || steps[step].part != expectedSelected[step].part {
        CompilerBug.panic(b"ownership position substituted another original selector")
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < holdings.length {
    let held = holdings[at]
    if held.request >= requests.length || held.observation >= observations.length || held.moveRead >= reads.length {
      CompilerBug.panic(b"Move holding lost its exact source observation")
    }
    let request = requests[held.request]
    let read = reads[held.moveRead]
    if read.observation != held.observation || observations[held.observation].request != held.request
      || held.source.index != read.value.index || held.target.index != request.target.index || !Atom.same(held.active, read.active) {
      CompilerBug.panic(b"Move holding changed its original input or publication")
    }
    let witness = Witness {definition: Option<DefinitionId>.some(held.definition), read: Option<ReadId>.some(held.read)}
    let original = match moveOriginal(prepared, skeleton, read, &witness) { Option<OwnerReadOriginal>.Some {value} => value
      _ => { return CompilerBug.panic(b"Move holding lost its exact canonical read pairing") } }
    let admitted = match moveConstruction(skeleton, held.request, held.definition) { Option<bool>.Some {value} => value _ => false }
    if !admitted || !sameStorage(original.storage, held.storage) || !sameOwnershipPlacement(original.held, held.held) {
      CompilerBug.panic(b"Move holding changed its original A or construction admission")
    }
    validateOwnershipPlacement(prepared, List<ReferenceOrigin>.asSlice(&skeleton.references), values, positions, held.placement)
    match held.placement {
      OwnershipPlacement.Position {anchor, position, offset} => {
        let original = &positions[position.index]
        if anchor.index != values[request.target.index].endpoint.index || offset != usize.ZERO
          || original.request != held.request || original.definition.index != held.definition.index || original.read.index != held.read.index {
          CompilerBug.panic(b"Move holding did not preserve its full original A")
        }
      }
      OwnershipPlacement.Unknown => {
        if !unknownOwnership(held.held) { CompilerBug.panic(b"Move holding coerced a missing known position into MAX") }
      }
      _ => { CompilerBug.panic(b"Move holding substituted a physical or reference placement") }
    }
    at = at + usize.ONE
  }
  let obligations = List<MoveHoldingCoverage>.asSlice(&skeleton.selectedMoves.holdingCoverage)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  at = usize.ZERO
  while at < obligations.length {
    let obligation = obligations[at]
    if obligation.case >= cases.length || obligation.moveRead >= reads.length { CompilerBug.panic(b"Move completion lost exact incoming Case") }
    let key = keys[cases[obligation.case].target]
    let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
    let definition = match witness.definition {
      Option<DefinitionId>.Some {value} => match obligation.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
      _ => match obligation.definition { Option<DefinitionId>.None => true _ => false }
    }
    let read = match witness.read {
      Option<ReadId>.Some {value} => match obligation.read { Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
      _ => match obligation.read { Option<ReadId>.None => true _ => false }
    }
    if key.value.index != obligation.source.index || key.category != obligation.category || key.leaf.index != obligation.leaf.index
      || key.direct != obligation.direct || key.value.index != reads[obligation.moveRead].value.index
      || !definition || !read {
      CompilerBug.panic(b"Move completion substituted another coincident history")
    }
    at = at + usize.ONE
  }
  return ()
}

fn ownershipOrder(skeleton: &Skeleton, evaluation: EvalId) -> Option<usize> {
  let rows = List<OwnershipOccurrence>.asSlice(&skeleton.selectedMoves.occurrences)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].evaluation.index == evaluation.index { return Option<usize>.some(rows[at].ordinal) }
    at = at + usize.ONE
  }
  // Execution may be reserved before its enclosing visit's order is installed.
  let executions = List<Execution>.asSlice(&skeleton.executions)
  at = usize.ZERO
  while at < executions.length {
    if executions[at].observation.index == evaluation.index {
      let mut each = usize.ZERO
      while each < rows.length {
        if rows[each].evaluation.index == executions[at].result.index { return Option<usize>.some(rows[each].ordinal) }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

fn ownershipPositionBefore(skeleton: &Skeleton, placement: OwnershipPlacement, evaluation: EvalId, strict: bool) -> Option<bool> {
  if let OwnershipPlacement.Position {position, ..} = placement {
    let original = &List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions)[position.index]
    let request = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)[original.request]
    let born = match ownershipOrder(skeleton, request.result) { Option<usize>.Some {value} => value _ => { return Option<bool>.none() } }
    let now = match ownershipOrder(skeleton, evaluation) { Option<usize>.Some {value} => value _ => { return Option<bool>.none() } }
    return Option<bool>.some(born < now || (!strict && born == now))
  }
  return Option<bool>.some(true)
}

// This predicate classifies construction only. It is never consulted by Flow pairing,
// read reservation, liveness or alias/address closure.
fn moveConstruction(skeleton: &Skeleton, request: usize, definition: DefinitionId) -> Option<bool> {
  return ownershipDefinitionBefore(skeleton, definition, List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)[request].result)
}

fn ownershipDefinitionBefore(skeleton: &Skeleton, definition: DefinitionId, result: EvalId) -> Option<bool> {
  let definitions = List<DefinedValue>.asSlice(&skeleton.definitions)
  if definition.index >= definitions.length { return Option<bool>.none() }
  let original = definitions[definition.index]
  let writer = match original.writer { Option<EvalId>.Some {value} => value
    _ => List<Value>.asSlice(&skeleton.values)[original.value.index].evaluation }
  let before = match ownershipOrder(skeleton, writer) { Option<usize>.Some {value} => value _ => { return Option<bool>.none() } }
  let current = match ownershipOrder(skeleton, result) { Option<usize>.Some {value} => value _ => { return Option<bool>.none() } }
  if before >= current { return Option<bool>.some(false) }
  if let Option<usize>.Some {value} = original.summary {
    return ownershipPositionBefore(skeleton, List<SummaryStorage>.asSlice(&skeleton.summaries)[value].placement, result, true)
  }
  return Option<bool>.some(true)
}

effect fn ownershipPathSteps(endpoints: &[Endpoint], root: EndpointId, endpoint: EndpointId,
  steps: &mut List<OwnershipPositionStep>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut reversed = List<EndpointId>.make()
  let mut current = endpoint
  let mut remaining = endpoints.length
  while current.index != root.index && remaining != usize.ZERO {
    if current.index >= endpoints.length { return false }
    run List<EndpointId>.append(&mut reversed, current)
    current = match endpoints[current.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    remaining = remaining - usize.ONE
  }
  if current.index != root.index { return false }
  let path = List<EndpointId>.asSlice(&reversed)
  let mut at = path.length
  while at != usize.ZERO {
    at = at - usize.ONE
    let selected = path[at]
    let selector = &endpoints[selected.index].selector
    match &selector.* {
      Selector.Identity => ()
      Selector.Member {declaration, payload, ..} => {
        if Shared<DeclarationId>.with<OwnerKind>(&declaration, fn(value: &DeclarationId) -> OwnerKind { return DeclarationId.kind(value) }) == OwnerKind.Union {
          run List<OwnershipPositionStep>.append(&mut steps.*, OwnershipPositionStep {endpoint: selected, part: OwnershipStepPart.NominalMember})
          run List<OwnershipPositionStep>.append(&mut steps.*, OwnershipPositionStep {endpoint: selected, part: OwnershipStepPart.NominalPayload})
        } else {
          if payload != usize.ZERO { return CompilerBug.panic(b"record ownership position has a union payload") }
          run List<OwnershipPositionStep>.append(&mut steps.*, OwnershipPositionStep {endpoint: selected, part: OwnershipStepPart.Selector})
        }
      }
      Selector.Field {..} => {
        run List<OwnershipPositionStep>.append(&mut steps.*, OwnershipPositionStep {endpoint: selected, part: OwnershipStepPart.Selector})
      }
      Selector.Variant {..} => {
        run List<OwnershipPositionStep>.append(&mut steps.*, OwnershipPositionStep {endpoint: selected, part: OwnershipStepPart.Selector})
      }
      Selector.Index {..} => {
        run List<OwnershipPositionStep>.append(&mut steps.*, OwnershipPositionStep {endpoint: selected, part: OwnershipStepPart.Selector})
      }
      Selector.Referent => {
        run List<OwnershipPositionStep>.append(&mut steps.*, OwnershipPositionStep {endpoint: selected, part: OwnershipStepPart.Selector})
      }
      _ => { return false }
    }
  }
  return true
}

effect fn ownershipPositionSteps<'body>(prepared: &SourcePreparation<'body>, positions: &[OwnershipPosition],
  root: EndpointId, placement: OwnershipPlacement) -> Option<List<OwnershipPositionStep>> ! OutOfMemoryError ? &mut Allocator {
  let mut steps = List<OwnershipPositionStep>.make()
  let anchor = match placement {
    OwnershipPlacement.Known {anchor, ..} => anchor
    OwnershipPlacement.Position {anchor, ..} => anchor
    OwnershipPlacement.Unknown => { return Option<List<OwnershipPositionStep>>.none() }
  }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  if !run ownershipPathSteps(endpoints, root, anchor, &mut steps) { return Option<List<OwnershipPositionStep>>.none() }
  match placement {
    OwnershipPlacement.Known {suffix: Option<OwnershipSuffix>.Some {value}, ..} => {
      if !run ownershipPathSteps(endpoints, value.root, value.endpoint, &mut steps) { return Option<List<OwnershipPositionStep>>.none() }
    }
    OwnershipPlacement.Position {position, offset, ..} => {
      if position.index >= positions.length { return CompilerBug.panic(b"ownership position lost its finite original") }
      let tail = List<OwnershipPositionStep>.asSlice(&positions[position.index].steps)
      if offset > tail.length { return CompilerBug.panic(b"ownership position offset is not an atomic semantic suffix") }
      let mut at = offset
      while at < tail.length { run List<OwnershipPositionStep>.append(&mut steps, tail[at]) at = at + usize.ONE }
    }
    _ => ()
  }
  return Option<List<OwnershipPositionStep>>.some(move steps)
}

// Shared genuine acquisition/read reservation, reused by references and consumed Move.
struct OwnerRead {
  read: ReadId
  value: ValueId
}
impl Copy for OwnerRead {}
effect fn reserveOwnerRead(skeleton: &mut Skeleton, evaluation: EvalId, storage: Storage) -> OwnerRead
! OutOfMemoryError ? &mut Allocator {
  let input = run Skeleton.componentValue(&mut skeleton.*, evaluation, storage.endpoint,
    Option<ResidualSubject>.none(), ValuePhase.Input)
  let recorded = List<ReadValue>.asSlice(&skeleton.reads)
  let mut at = usize.ZERO
  while at < recorded.length {
    if recorded[at].value.index == input.index && sameStorage(recorded[at].storage, storage)
      && match recorded[at].summary { Option<usize>.None => true _ => false }
      && match recorded[at].map { Option<MapId>.None => true _ => false } {
      return OwnerRead {read: recorded[at].read, value: input}
    }
    at = at + usize.ONE
  }
  let component = run Skeleton.internStorage(&mut skeleton.*, storage)
  let point = Skeleton.evaluation(&skeleton.*, evaluation).point
  let read = run Flow.read(&mut skeleton.flow, point, component)
  run List<ReadValue>.append(&mut skeleton.reads, ReadValue {read: read, storage: storage,
    value: input, map: Option<MapId>.none(), summary: Option<usize>.none()})
  return OwnerRead {read: read, value: input}
}

effect fn reserveMoveObservations<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<MoveObservation>.length(&skeleton.selectedMoves.observations)
  let beforeCoverage = List<MoveCoverage>.length(&skeleton.selectedMoves.coverage)
  let requestsCount = List<SelectedMove>.length(&skeleton.selectedMoves.requests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut request = usize.ZERO
  while request < requestsCount {
    let selected = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)[request]
    if request == List<MoveCoverage>.length(&skeleton.selectedMoves.coverage) {
      let point = Skeleton.evaluation(&skeleton.*, selected.execution).point
      let reachable = Flow.reachable(&skeleton.flow, point)
      let active = run addressApplies(&mut skeleton.rules, selected.active, reachable)
      let missing = Program.atom(&mut skeleton.rules)
      run List<MoveCoverage>.append(&mut skeleton.selectedMoves.coverage,
        MoveCoverage {request: request, active: active, missing: missing})
    }
    let coverage = List<MoveCoverage>.asSlice(&skeleton.selectedMoves.coverage)[request]
    let aliasesCount = List<StorageAlias>.length(&skeleton.aliases)
    let mut alias = usize.ZERO
    while alias < aliasesCount {
      let address = List<StorageAlias>.asSlice(&skeleton.aliases)[alias]
      if address.evaluation.index == selected.source.index && address.endpoint.index == maps[selected.map.index].source.index {
        let owner = Storage {endpoint: storageOwner(prepared, address.storage.endpoint), temporary: address.storage.temporary}
        // Whole Move already has its genuine physical read. Only selected Move needs the
        // distinct unchanged-A publication; whole aliases still discharge alias coverage.
        if !sameStorage(address.storage, owner) {
          let observations = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)
          let mut at = usize.ZERO
          while at < observations.length {
            if observations[at].request == request && observations[at].alias == alias { break }
            at = at + usize.ONE
          }
          if at == observations.length {
            let active = run addressApplies(&mut skeleton.rules, coverage.active, address.active)
            let observation = observations.length
            run List<MoveObservation>.append(&mut skeleton.selectedMoves.observations,
              MoveObservation {request: request, alias: alias, storage: address.storage, owner: owner, active: active})
            let components = run referenceOwnerComponents(prepared, owner)
            let componentsSelected = List<EndpointId>.asSlice(&components)
            at = usize.ZERO
            while at < componentsSelected.length {
              let storage = Storage {endpoint: componentsSelected[at], temporary: owner.temporary}
              let read = run reserveOwnerRead(&mut skeleton.*, selected.execution, storage)
              run List<MoveRead>.append(&mut skeleton.selectedMoves.reads,
                MoveRead {observation: observation, storage: storage, read: read.read, value: read.value, active: active})
              at = at + usize.ONE
            }
          }
        }
      }
      alias = alias + usize.ONE
    }
    request = request + usize.ONE
  }
  return before != List<MoveObservation>.length(&skeleton.selectedMoves.observations)
    || beforeCoverage != List<MoveCoverage>.length(&skeleton.selectedMoves.coverage)
}

effect fn reserveDropObservations<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<DropObservation>.length(&skeleton.drops.observations)
  let beforeCoverage = List<DropCoverage>.length(&skeleton.drops.coverage)
  let requestsCount = List<ConsumedDrop>.length(&skeleton.drops.requests)
  let mut request = usize.ZERO
  while request < requestsCount {
    let selected = List<ConsumedDrop>.asSlice(&skeleton.drops.requests)[request]
    if request == List<DropCoverage>.length(&skeleton.drops.coverage) {
      let point = Skeleton.evaluation(&skeleton.*, selected.evaluation).point
      let reachable = Flow.reachable(&skeleton.flow, point)
      let active = run addressApplies(&mut skeleton.rules, selected.active, reachable)
      let missing = Program.atom(&mut skeleton.rules)
      run List<DropCoverage>.append(&mut skeleton.drops.coverage,
        DropCoverage {request: request, active: active, missing: missing})
    }
    let coverage = List<DropCoverage>.asSlice(&skeleton.drops.coverage)[request]
    let aliasesCount = List<StorageAlias>.length(&skeleton.aliases)
    let mut alias = usize.ZERO
    while alias < aliasesCount {
      let address = List<StorageAlias>.asSlice(&skeleton.aliases)[alias]
      if address.evaluation.index == selected.source.index && address.endpoint.index == selected.root.index {
        let owner = Storage {endpoint: storageOwner(prepared, address.storage.endpoint), temporary: address.storage.temporary}
        // Drop observes the whole owner even when the selected B already is its root.
        let observations = List<DropObservation>.asSlice(&skeleton.drops.observations)
        let mut at = usize.ZERO
        while at < observations.length {
          if observations[at].request == request && observations[at].alias == alias { break }
          at = at + usize.ONE
        }
        if at == observations.length {
          let active = run addressApplies(&mut skeleton.rules, coverage.active, address.active)
          let observation = observations.length
          run List<DropObservation>.append(&mut skeleton.drops.observations,
            DropObservation {request: request, alias: alias, storage: address.storage, owner: owner, active: active})
          let components = run referenceOwnerComponents(prepared, owner)
          let componentsSelected = List<EndpointId>.asSlice(&components)
          at = usize.ZERO
          while at < componentsSelected.length {
            let storage = Storage {endpoint: componentsSelected[at], temporary: owner.temporary}
            let read = run reserveOwnerRead(&mut skeleton.*, selected.evaluation, storage)
            run List<DropRead>.append(&mut skeleton.drops.reads,
              DropRead {observation: observation, storage: storage, read: read.read, value: read.value, active: active})
            at = at + usize.ONE
          }
        }
      }
      alias = alias + usize.ONE
    }
    request = request + usize.ONE
  }
  return before != List<DropObservation>.length(&skeleton.drops.observations)
    || beforeCoverage != List<DropCoverage>.length(&skeleton.drops.coverage)
}

struct OwnerReadOriginal {
  storage: Storage
  held: OwnershipPlacement
  definition: DefinitionId
  read: ReadId
}
impl Copy for OwnerReadOriginal {}
fn moveOriginal<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, original: MoveRead,
  witness: &Witness) -> Option<OwnerReadOriginal> {
  let owner = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)[original.observation].owner
  return ownerReadOriginal(prepared, skeleton, owner, original.read, witness)
}

fn ownerReadOriginal<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, owner: Storage, original: ReadId,
  witness: &Witness) -> Option<OwnerReadOriginal> {
  let definition = match witness.definition { Option<DefinitionId>.Some {value} => value _ => { return Option<OwnerReadOriginal>.none() } }
  let read = match witness.read { Option<ReadId>.Some {value} => value _ => { return Option<OwnerReadOriginal>.none() } }
  if !referenceReadHistory(original, witness.read, List<SummaryRead>.asSlice(&skeleton.summaryReads)) { return Option<OwnerReadOriginal>.none() }
  let written = List<DefinedValue>.asSlice(&skeleton.definitions)[definition.index]
  let pair = Flow.reservedDefinitions(&skeleton.flow)[definition.index]
  if pair.component.index != Flow.reservedReads(&skeleton.flow)[read.index].component.index { return Option<OwnerReadOriginal>.none() }
  let storage = List<Storage>.asSlice(&skeleton.storage)[pair.component.index]
  let mut result = OwnerReadOriginal {storage: storage,
    held: OwnershipPlacement.Known {anchor: storage.endpoint, suffix: Option<OwnershipSuffix>.none()}, definition: definition, read: read}
  if let Option<usize>.Some {value} = written.summary {
    let summary = List<SummaryStorage>.asSlice(&skeleton.summaries)[value]
    result.storage = summary.prefix
    result.held = summary.placement
  }
  if !sameTemporary(result.storage.temporary, owner.temporary)
    || storageOwner(prepared, result.storage.endpoint).index != owner.endpoint.index { return Option<OwnerReadOriginal>.none() }
  return Option<OwnerReadOriginal>.some(result)
}

fn sameOwnershipMirrorOrigin(left: OwnershipMirrorOrigin, right: OwnershipMirrorOrigin) -> bool {
  return match left {
    OwnershipMirrorOrigin.Move {moveRead} => match right { OwnershipMirrorOrigin.Move {moveRead: other} => moveRead == other _ => false }
    OwnershipMirrorOrigin.Field {fieldRead, case} => match right { OwnershipMirrorOrigin.Field {fieldRead: other, case: original} => fieldRead == other && case == original _ => false }
  }
}
struct OwnershipMirrorUse {
  read: ReadId
  value: ValueId
  owner: Storage
  result: EvalId
}
impl Copy for OwnershipMirrorUse {}
fn ownershipMirrorUse(skeleton: &Skeleton, origin: OwnershipMirrorOrigin) -> OwnershipMirrorUse {
  return match origin {
    OwnershipMirrorOrigin.Move {moveRead} => {
      let reads = List<MoveRead>.asSlice(&skeleton.selectedMoves.reads)
      if moveRead >= reads.length { return CompilerBug.panic(b"ownership mirror lost its Move construction read") }
      let read = reads[moveRead]
      let observation = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)[read.observation]
      let request = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)[observation.request]
      return OwnershipMirrorUse {read: read.read, value: read.value, owner: observation.owner, result: request.result}
    }
    OwnershipMirrorOrigin.Field {fieldRead, ..} => {
      let reads = List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)
      if fieldRead >= reads.length { return CompilerBug.panic(b"ownership mirror lost its Field construction read") }
      let read = reads[fieldRead]
      let observation = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)[read.observation]
      let request = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[observation.request]
      return OwnershipMirrorUse {read: read.read, value: read.value, owner: observation.owner, result: request.result}
    }
  }
}

// The acquisition is finite topology evidence only. Activation belongs to the original
// writer, before the observing operation, so conditional later reads cannot erase holdings.
effect fn reserveOwnershipMirror<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  domain: &Domain, origin: OwnershipMirrorOrigin, acquisitionCase: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let use = ownershipMirrorUse(&skeleton.*, origin)
  let cases = List<Case>.asSlice(&domain.cases)
  let incoming = &cases[acquisitionCase]
  let keys = List<CellKey>.asSlice(&domain.keys)
  let key = keys[incoming.target]
  if key.category != SourceRole.Physical || key.value.index != use.value.index { return () }
  let source = match ownerReadOriginal(prepared, &skeleton.*, use.owner, use.read, &List<Witness>.asSlice(&domain.witnesses)[key.witness]) {
    Option<OwnerReadOriginal>.Some {value} => value _ => { return () } }
  if !fieldCasePair(incoming, source.definition, source.read) { return () }
  let sourceCell = match incoming.source { Option<usize>.Some {value} => value _ => { return () } }
  let original = List<DefinedValue>.asSlice(&skeleton.definitions)[source.definition.index]
  if let Option<usize>.Some {..} = original.summary { return () }
  if keys[sourceCell].category != SourceRole.Physical || keys[sourceCell].value.index != original.value.index { return () }
  let constructed = match ownershipDefinitionBefore(&skeleton.*, source.definition, use.result) { Option<bool>.Some {value} => value _ => false }
  if !constructed { return () }
  let writer = match original.writer { Option<EvalId>.Some {value} => value
    _ => List<Value>.asSlice(&skeleton.values)[original.value.index].evaluation }
  let actual = Flow.reservedDefinitions(&skeleton.flow)[source.definition.index]
  let mut sourceCase = usize.ZERO
  while sourceCase < cases.length {
    if cases[sourceCase].target == sourceCell {
      let mut alternative = usize.ZERO
      while alternative < 2 {
        let mut held = OwnershipPlacement.Unknown
        if alternative == usize.ZERO {
          held = OwnershipPlacement.Known {anchor: source.storage.endpoint, suffix: Option<OwnershipSuffix>.none()}
        }
        let mut prefix = use.owner
        if alternative == usize.ZERO { prefix = source.storage }
        let old = List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates)
        let mut at = usize.ZERO
        while at < old.length {
          if sameOwnershipMirrorOrigin(old[at].origin, origin) && old[at].acquisitionCase == acquisitionCase
            && old[at].sourceCase == sourceCase && old[at].original.index == source.definition.index
            && sameOwnershipPlacement(old[at].placement, held) { break }
          at = at + usize.ONE
        }
        if at == old.length {
          let summary = run Skeleton.summaryStorage(&mut skeleton.*, prefix, held, SummaryDisposition.Ordinary)
          // Move and Field observations share one installed original-definition lane.
          let old = List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates)
          let mut shared = usize.MAX
          at = usize.ZERO
          while at < old.length {
            if old[at].original.index == source.definition.index && old[at].summary == summary { shared = at }
            at = at + usize.ONE
          }
          let target = run Skeleton.summaryValue(&mut skeleton.*, summary, writer, ValuePhase.Output,
            Option<DefinitionId>.none(), Option<ReadId>.none())
          let admitted = ownershipMirrorAdmission(&mut skeleton.rules, List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates), shared)
          let mut definition = DefinitionId {index: usize.MAX}
          if shared == usize.MAX {
            let component = List<SummaryStorage>.asSlice(&skeleton.summaries)[summary].component
            definition = run Flow.define(&mut skeleton.flow, actual.point, component, admitted, Write.Weak)
            run List<DefinedValue>.append(&mut skeleton.definitions, DefinedValue {definition: definition,
              value: target, writer: original.writer, summary: Option<usize>.some(summary), clears: Option<DefinitionId>.none()})
          } else { definition = List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates)[shared].definition }
          let active = Program.atom(&mut skeleton.rules)
          let gates: [Atom; 2] = [actual.active, cases[sourceCase].active]
          run Program.rule(&mut skeleton.rules, active, &gates, &[])
          let candidate = List<OwnershipMirror>.length(&skeleton.ownershipMirrors.candidates)
          run List<OwnershipMirror>.append(&mut skeleton.ownershipMirrors.candidates, OwnershipMirror {
            origin: origin, acquisitionCase: acquisitionCase, sourceCase: sourceCase, sourceCell: sourceCell,
            original: source.definition, read: source.read, definition: definition, summary: summary,
            writer: writer, storage: source.storage, placement: held, source: original.value,
            target: target, active: active, admitted: admitted})
          let absent = Program.atom(&mut skeleton.rules)
          run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: original.value, target: target,
            active: active, directness: holdingDirectness(alternative != usize.ZERO),
            stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
            policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.OwnershipMirror {candidate: candidate, sourceCell: sourceCell}})
        }
        alternative = alternative + usize.ONE
      }
    }
    sourceCase = sourceCase + usize.ONE
  }
  return ()
}

effect fn reserveOwnershipMirrors<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<OwnershipMirror>.length(&skeleton.ownershipMirrors.candidates)
  let moveCount = List<MoveRead>.length(&skeleton.selectedMoves.reads)
  let fieldCount = List<FieldReholdRead>.length(&skeleton.fieldReholds.reads)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let mut case = usize.ZERO
  while case < cases.length {
    let key = keys[cases[case].target]
    if key.category == SourceRole.Physical {
      let mut reading = usize.ZERO
      while reading < moveCount {
        if key.value.index == List<MoveRead>.asSlice(&skeleton.selectedMoves.reads)[reading].value.index {
          run reserveOwnershipMirror(prepared, &mut skeleton.*, domain, OwnershipMirrorOrigin.Move {moveRead: reading}, case)
        }
        reading = reading + usize.ONE
      }
      reading = usize.ZERO
      while reading < fieldCount {
        if key.value.index == List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)[reading].value.index {
          run reserveOwnershipMirror(prepared, &mut skeleton.*, domain, OwnershipMirrorOrigin.Field {fieldRead: reading, case: case}, case)
        }
        reading = reading + usize.ONE
      }
    }
    case = case + usize.ONE
  }
  return before != List<OwnershipMirror>.length(&skeleton.ownershipMirrors.candidates)
}

effect fn sealOwnershipMirrorCoverage(skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let mirrors = List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let mut mirror = usize.ZERO
  while mirror < mirrors.length {
    let selected = mirrors[mirror]
    let old = List<OwnershipMirrorCoverage>.asSlice(&skeleton.ownershipMirrors.coverage)
    let mut at = usize.ZERO
    while at < old.length {
      if sameOwnershipMirrorOrigin(old[at].origin, selected.origin) && old[at].acquisitionCase == selected.acquisitionCase
        && old[at].original.index == selected.original.index && old[at].case == selected.sourceCase { break }
      at = at + usize.ONE
    }
    if at == old.length {
      let key = keys[selected.sourceCell]
      let witness = &witnesses[key.witness]
      let active = Program.atom(&mut skeleton.rules)
      let gates: [Atom; 2] = [Flow.reservedDefinitions(&skeleton.flow)[selected.original.index].active, cases[selected.sourceCase].active]
      run Program.rule(&mut skeleton.rules, active, &gates, &[])
      let covered = Program.atom(&mut skeleton.rules)
      let missing = Program.atom(&mut skeleton.rules)
      let positive: [Atom; 1] = [active]
      let negative: [Atom; 1] = [covered]
      run Program.rule(&mut skeleton.rules, missing, &positive, &negative)
      run List<OwnershipMirrorCoverage>.append(&mut skeleton.ownershipMirrors.coverage, OwnershipMirrorCoverage {
        origin: selected.origin, acquisitionCase: selected.acquisitionCase, original: selected.original, case: selected.sourceCase,
        source: key.value, leaf: key.leaf, category: key.category, direct: key.direct, definition: witness.definition, read: witness.read,
        active: active, covered: covered, missing: missing})
    }
    mirror = mirror + usize.ONE
  }
  return ()
}

effect fn validateOwnershipMirrors<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, domain: &Domain) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mirrors = List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates)
  let definitions = List<DefinedValue>.asSlice(&skeleton.definitions)
  let flow = Flow.reservedDefinitions(&skeleton.flow)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let values = List<Value>.asSlice(&skeleton.values)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let mut at = usize.ZERO
  while at < mirrors.length {
    let mirror = mirrors[at]
    if mirror.acquisitionCase >= cases.length || mirror.sourceCase >= cases.length || mirror.sourceCell >= keys.length
      || mirror.original.index >= definitions.length || mirror.definition.index >= definitions.length || mirror.summary >= summaries.length {
      return CompilerBug.panic(b"ownership mirror omitted original definition or Case evidence")
    }
    let use = ownershipMirrorUse(skeleton, mirror.origin)
    if let OwnershipMirrorOrigin.Field {case, ..} = mirror.origin {
      if case != mirror.acquisitionCase { return CompilerBug.panic(b"Field mirror changed its construction Case") }
    }
    let incoming = &cases[mirror.acquisitionCase]
    let source = keys[mirror.sourceCell]
    let original = definitions[mirror.original.index]
    let installed = definitions[mirror.definition.index]
    let summary = summaries[mirror.summary]
    let exact = match installed.summary { Option<usize>.Some {value} => value == mirror.summary _ => false }
    let physical = match original.summary { Option<usize>.None => true _ => false }
    let writer = match original.writer { Option<EvalId>.Some {value} => value _ => values[original.value.index].evaluation }
    let observed = match ownerReadOriginal(prepared, skeleton, use.owner, use.read, &witnesses[keys[incoming.target].witness]) {
      Option<OwnerReadOriginal>.Some {value} => value _ => { return CompilerBug.panic(b"ownership mirror detached its genuine whole-owner read pair") } }
    let construction = match ownershipDefinitionBefore(skeleton, mirror.original, use.result) { Option<bool>.Some {value} => value _ => false }
    if !exact || !physical || !construction || writer.index != mirror.writer.index
      || keys[incoming.target].value.index != use.value.index || keys[incoming.target].category != SourceRole.Physical
      || !fieldCasePair(incoming, mirror.original, mirror.read) || !fieldCaseSource(incoming, mirror.sourceCell)
      || cases[mirror.sourceCase].target != mirror.sourceCell || source.category != SourceRole.Physical || source.value.index != mirror.source.index
      || mirror.source.index != original.value.index || mirror.target.index != installed.value.index
      || observed.definition.index != mirror.original.index || observed.read.index != mirror.read.index
      || !sameStorage(observed.storage, mirror.storage) || !sameOwnershipPlacement(summary.placement, mirror.placement) || summary.disposition != SummaryDisposition.Ordinary
      || flow[mirror.original.index].point.index != flow[mirror.definition.index].point.index
      || !Atom.same(flow[mirror.definition.index].active, mirror.admitted) || flow[mirror.definition.index].write != Write.Weak {
      return CompilerBug.panic(b"ownership mirror changed original writer, canonical A or admitted summary")
    }
    match mirror.placement {
      OwnershipPlacement.Known {anchor, suffix: Option<OwnershipSuffix>.None} => {
        if anchor.index != mirror.storage.endpoint.index || !sameStorage(summary.prefix, mirror.storage) {
          return CompilerBug.panic(b"ownership mirror changed its original physical held component")
        }
      }
      OwnershipPlacement.Unknown => {
        if !sameStorage(summary.prefix, use.owner) { return CompilerBug.panic(b"MAX ownership mirror lost whole owner") }
      }
      _ => { return CompilerBug.panic(b"physical ownership mirror invented a semantic source suffix") }
    }
    let mut previous = usize.ZERO
    while previous < at {
      let other = mirrors[previous]
      if other.original.index == mirror.original.index && other.summary == mirror.summary
        && (other.definition.index != mirror.definition.index || !Atom.same(other.admitted, mirror.admitted) || other.target.index != mirror.target.index) {
        return CompilerBug.panic(b"ownership mirror duplicated its shared original-definition lane")
      }
      previous = previous + usize.ONE
    }
    at = at + usize.ONE
  }
  let obligations = List<OwnershipMirrorCoverage>.asSlice(&skeleton.ownershipMirrors.coverage)
  at = usize.ZERO
  while at < obligations.length {
    let obligation = obligations[at]
    if obligation.case >= cases.length || obligation.acquisitionCase >= cases.length || obligation.original.index >= definitions.length {
      return CompilerBug.panic(b"ownership mirror completion lost original evidence")
    }
    let key = keys[cases[obligation.case].target]
    let witness = &witnesses[key.witness]
    let definition = match witness.definition {
      Option<DefinitionId>.Some {value} => match obligation.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
      _ => match obligation.definition { Option<DefinitionId>.None => true _ => false } }
    let read = match witness.read {
      Option<ReadId>.Some {value} => match obligation.read { Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
      _ => match obligation.read { Option<ReadId>.None => true _ => false } }
    let mut retained = false
    let mut mirror = usize.ZERO
    while mirror < mirrors.length {
      if sameOwnershipMirrorOrigin(mirrors[mirror].origin, obligation.origin) && mirrors[mirror].acquisitionCase == obligation.acquisitionCase
        && mirrors[mirror].original.index == obligation.original.index && mirrors[mirror].sourceCase == obligation.case
        && mirrors[mirror].sourceCell == cases[obligation.case].target { retained = true }
      mirror = mirror + usize.ONE
    }
    if !retained || key.value.index != obligation.source.index || key.category != SourceRole.Physical || key.category != obligation.category
      || key.leaf.index != obligation.leaf.index || key.direct != obligation.direct || !definition || !read {
      return CompilerBug.panic(b"ownership mirror completion substituted another original writer Case")
    }
    at = at + usize.ONE
  }
  return ()
}


effect fn reserveMoveHoldings<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain) -> bool
! OutOfMemoryError ? &mut Allocator {
  let before = List<MoveHolding>.length(&skeleton.selectedMoves.holdings)
  let reads = List<MoveRead>.asSlice(&skeleton.selectedMoves.reads)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let mut reading = usize.ZERO
  while reading < reads.length {
    let original = reads[reading]
    let observation = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)[original.observation]
    let request = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)[observation.request]
    let mut cell = usize.ZERO
    while cell < keys.length {
      let key = keys[cell]
      if key.value.index == original.value.index {
        if let Option<OwnerReadOriginal>.Some {value: source} = moveOriginal(prepared, &skeleton.*, original, &witnesses[key.witness]) {
          let admitted = match moveConstruction(&skeleton.*, observation.request, source.definition) { Option<bool>.Some {value} => value _ => false }
          if admitted {
            let old = List<MoveHolding>.asSlice(&skeleton.selectedMoves.holdings)
            let mut at = usize.ZERO
            while at < old.length {
              if old[at].moveRead == reading && old[at].definition.index == source.definition.index && old[at].read.index == source.read.index { break }
              at = at + usize.ONE
            }
            if at == old.length {
              let mut placement = Option<OwnershipPlacement>.none()
              if let OwnershipPlacement.Unknown = source.held { placement = Option<OwnershipPlacement>.some(OwnershipPlacement.Unknown) }
              else {
                let positions = List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions)
                let mut position = usize.ZERO
                while position < positions.length {
                  if positions[position].request == observation.request && positions[position].definition.index == source.definition.index
                    && positions[position].read.index == source.read.index { break }
                  position = position + usize.ONE
                }
                if position == positions.length {
                  if let Option<List<OwnershipPositionStep>>.Some {value: steps} = move run ownershipPositionSteps(prepared,
                    positions, observation.owner.endpoint, source.held) {
                    run List<OwnershipPosition>.append(&mut skeleton.selectedMoves.positions, OwnershipPosition {
                      request: observation.request, definition: source.definition, read: source.read, storage: source.storage,
                      held: source.held, steps: move steps})
                  }
                }
                if position < List<OwnershipPosition>.length(&skeleton.selectedMoves.positions) {
                  placement = Option<OwnershipPlacement>.some(OwnershipPlacement.Position {
                    anchor: List<Value>.asSlice(&skeleton.values)[request.target.index].endpoint,
                    position: OwnershipPositionId {index: position}, offset: usize.ZERO})
                }
              }
              if let Option<OwnershipPlacement>.Some {value} = placement {
                let candidate = List<MoveHolding>.length(&skeleton.selectedMoves.holdings)
                run List<MoveHolding>.append(&mut skeleton.selectedMoves.holdings, MoveHolding {
                  moveRead: reading, observation: original.observation, request: observation.request,
                  source: original.value, target: request.target, definition: source.definition, read: source.read,
                  storage: source.storage, held: source.held, placement: value, active: original.active})
                let absent = Program.atom(&mut skeleton.rules)
                run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: original.value, target: request.target,
                  active: original.active, directness: holdingDirectness(unknownOwnership(value)),
                  stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
                  policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.MoveHolding {candidate: candidate}})
              }
            }
          }
        }
      }
      cell = cell + usize.ONE
    }
    reading = reading + usize.ONE
  }
  return before != List<MoveHolding>.length(&skeleton.selectedMoves.holdings)
}

// Whole-owner enumeration is frozen inline geometry. No Referent or semantic channel is
// traversed, and an opaque owner is observed through its actual root and summary reads.
effect fn referenceOwnerComponents<'body>(prepared: &SourcePreparation<'body>, owner: Storage)
  -> List<EndpointId> ! OutOfMemoryError ? &mut Allocator {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let mut pending = List<EndpointId>.make()
  run List<EndpointId>.append(&mut pending, owner.endpoint)
  let mut at = usize.ZERO
  while at < List<EndpointId>.length(&pending) {
    let endpoint = List<EndpointId>.asSlice(&pending)[at]
    let components = List<Prepared.Component>.asSlice(&shapes[endpoints[endpoint.index].shape.index].components)
    let mut component = usize.ZERO
    while component < components.length {
      if components[component].inline {
        let mut found = usize.MAX
        let mut child = usize.ZERO
        while child < endpoints.length {
          let parent = match endpoints[child].parent { Option<EndpointId>.Some {value} => value.index == endpoint.index _ => false }
          if parent && sameSelector(&endpoints[child].selector, &components[component].selector) {
            if found != usize.MAX { return CompilerBug.panic(b"reference owner repeats an inline component") }
            found = child
          }
          child = child + usize.ONE
        }
        if found == usize.MAX { return CompilerBug.panic(b"reference owner omitted a prepared inline component") }
        run List<EndpointId>.append(&mut pending, EndpointId {index: found})
      }
      component = component + usize.ONE
    }
    at = at + usize.ONE
  }
  return move pending
}

fn referenceSeed(skeleton: &Skeleton, reference: ReferenceOrigin) -> Atom {
  let seeds = List<Seed>.asSlice(&skeleton.seeds)
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < seeds.length {
    if seeds[at].value.index == reference.descriptor.index && seeds[at].leaf.index == reference.leaf.index {
      if found != usize.MAX { return CompilerBug.panic(b"reference observation has repeated acquisition seeds") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"reference observation has no original acquisition seed") }
  return seeds[found].active
}

// Summary reads of a whole-owner observation belong to its root once. A narrower physical
// component read must not multiply the same opaque holding into independent histories.
fn referenceSummaryRoot(skeleton: &Skeleton, read: ReadId) -> bool {
  let reads = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let observations = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)
  let mut selected = false
  let mut at = usize.ZERO
  while at < reads.length {
    if reads[at].read.index == read.index {
      selected = true
      if sameStorage(reads[at].storage, observations[reads[at].observation].owner) { return true }
    }
    at = at + usize.ONE
  }
  let moveReads = List<MoveRead>.asSlice(&skeleton.selectedMoves.reads)
  let moves = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)
  at = usize.ZERO
  while at < moveReads.length {
    if moveReads[at].read.index == read.index {
      selected = true
      if sameStorage(moveReads[at].storage, moves[moveReads[at].observation].owner) { return true }
    }
    at = at + usize.ONE
  }
  let dropReads = List<DropRead>.asSlice(&skeleton.drops.reads)
  let drops = List<DropObservation>.asSlice(&skeleton.drops.observations)
  at = usize.ZERO
  while at < dropReads.length {
    if dropReads[at].read.index == read.index {
      selected = true
      if sameStorage(dropReads[at].storage, drops[dropReads[at].observation].owner) { return true }
    }
    at = at + usize.ONE
  }
  return !selected
}

fn validateThroughFlightRequest<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  request: ThroughFlightRequest) -> () {
  let operation = Skeleton.evaluation(skeleton, request.operation)
  let destination = Skeleton.evaluation(skeleton, request.target)
  let action = Skeleton.evaluation(skeleton, request.evaluation)
  let site = match operation.site { EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"through flight has no actual operation") } }
  let actualTarget = match destination.site { EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"through flight has no actual destination") } }
  let sameSite = match action.site { EvaluationSite.Node {node} => node.index == site.index _ => false }
  if !sameSite { CompilerBug.panic(b"through flight moved its action to another operation") }
  match &prepared.body.nodes[site.index].kind {
    NodeKind.PlaceAssignment {target, ..} => {
      if target.index != actualTarget.index || request.kind != ThroughFlightKind.Write || action.category != EvaluationRole.Execute {
        CompilerBug.panic(b"through assignment changed its actual write action")
      }
      let executions = List<Execution>.asSlice(&skeleton.executions)
      let mut found = false
      let mut at = usize.ZERO
      while at < executions.length {
        if executions[at].result.index == request.operation.index && executions[at].observation.index == request.evaluation.index { found = true }
        at = at + usize.ONE
      }
      if !found { CompilerBug.panic(b"through assignment invented an execution observation") }
    }
    NodeKind.Expression {form: Expression.StorageCall {operation: storageOperation, arguments, ..}, ..} if storageOperation == StorageOperation.Replace => {
      let argumentsSelected = List<NodeId>.asSlice(&arguments)
      if argumentsSelected.length != 2 || argumentsSelected[0].index != actualTarget.index { CompilerBug.panic(b"through replacement changed its destination") }
      if request.kind == ThroughFlightKind.Read {
        if action.category != EvaluationRole.Replacement || action.point.index == operation.point.index {
          CompilerBug.panic(b"through replacement lost its earlier displaced read")
        }
      } else if request.evaluation.index != request.operation.index {
        CompilerBug.panic(b"through replacement write moved before its actual result")
      }
    }
    NodeKind.Expression {form: Expression.PatternBinding {..}, ..} => {
      if request.kind != ThroughFlightKind.Read || request.target.index != request.operation.index
        || request.evaluation.index != request.operation.index || action.category != EvaluationRole.Value {
        CompilerBug.panic(b"through value read changed its actual projection occurrence")
      }
    }
    NodeKind.Expression {form: Expression.Field {..}, ..} => {
      if request.kind != ThroughFlightKind.Read || request.target.index != request.operation.index
        || request.evaluation.index != request.operation.index || action.category != EvaluationRole.Value {
        CompilerBug.panic(b"through value read changed its actual projection occurrence")
      }
    }
    NodeKind.Expression {form: Expression.Index {..}, ..} => {
      if request.kind != ThroughFlightKind.Read || request.target.index != request.operation.index
        || request.evaluation.index != request.operation.index || action.category != EvaluationRole.Value {
        CompilerBug.panic(b"through value read changed its actual projection occurrence")
      }
    }
    NodeKind.Expression {form: Expression.Dereference {..}, ..} => {
      if request.kind != ThroughFlightKind.Read || request.target.index != request.operation.index
        || request.evaluation.index != request.operation.index || action.category != EvaluationRole.Value {
        CompilerBug.panic(b"through value read changed its actual projection occurrence")
      }
    }
    _ => { CompilerBug.panic(b"through flight is not an actual read, assignment or replacement") }
  }
  if let Option<ThroughDescriptor>.Some {value} = request.descriptor {
    let descriptor = Skeleton.evaluation(skeleton, value.evaluation)
    let crossing = Skeleton.evaluation(skeleton, value.crossing)
    let node = match descriptor.site { EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"through descriptor has no operand occurrence") } }
    let cross = match crossing.site { EvaluationSite.Node {node: matchedCrossingNode} => matchedCrossingNode
      _ => { return CompilerBug.panic(b"through descriptor has no crossing occurrence") } }
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    if value.root.index >= endpoints.length { CompilerBug.panic(b"through descriptor omitted its Storage root") }
    let endpoint = &endpoints[value.root.index]
    let exact = match endpoint.root { Root.Node {node: actual, category} => actual.index == node.index && category == EndpointRole.Storage _ => false }
    if !exact { CompilerBug.panic(b"through flight substituted its destination for the descriptor") }
    if let Option<EndpointId>.Some {..} = endpoint.parent { CompilerBug.panic(b"through descriptor root is a guessed child") }
    let mut crossingOperand = Option<NodeId>.none()
    match &prepared.body.nodes[cross.index].kind {
      NodeKind.Expression {form: Expression.Dereference {value: crossedOperand}, ..} => {
        let reference = match &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state { PreparedShapeState.Reference => true _ => false }
        if !reference { return CompilerBug.panic(b"through Dereference has no actual reference descriptor") }
        crossingOperand = Option<NodeId>.some(crossedOperand)
      }
      NodeKind.Expression {form: Expression.Index {value: crossedOperand, ..}, ..} => {
        let slice = match &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state { PreparedShapeState.Slice => true _ => false }
        if !slice { return CompilerBug.panic(b"through Index has no actual slice descriptor") }
        crossingOperand = Option<NodeId>.some(crossedOperand)
      }
      _ => { return CompilerBug.panic(b"through descriptor has no genuine reference crossing") }
    }
    let operand = match crossingOperand { Option<NodeId>.Some {value: matchedOperand} => matchedOperand
      _ => { return CompilerBug.panic(b"through descriptor omitted its authenticated operand") } }
    if operand.index != node.index { CompilerBug.panic(b"through crossing changed its actual descriptor operand") }
  }
  return ()
}

fn throughFlightSummaryRoot(skeleton: &Skeleton, read: ReadId) -> bool {
  let reads = List<ThroughFlightRead>.asSlice(&skeleton.throughFlightReads)
  let observations = List<ThroughFlightObservation>.asSlice(&skeleton.throughFlightObservations)
  let mut selected = false
  let mut at = usize.ZERO
  while at < reads.length {
    if reads[at].read.index == read.index {
      selected = true
      if sameStorage(reads[at].storage, observations[reads[at].observation].owner) { return true }
    }
    at = at + usize.ONE
  }
  return !selected
}

effect fn reserveThroughFlights<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<ThroughFlightObservation>.length(&skeleton.throughFlightObservations)
  let requestCount = List<ThroughFlightRequest>.length(&skeleton.throughFlightRequests)
  let aliasesCount = List<StorageAlias>.length(&skeleton.aliases)
  let mut request = usize.ZERO
  while request < requestCount {
    let selected = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)[request]
    if let Option<ThroughDescriptor>.Some {value: descriptor} = selected.descriptor {
      let mut alias = usize.ZERO
      while alias < aliasesCount {
        let actual = List<StorageAlias>.asSlice(&skeleton.aliases)[alias]
        if actual.evaluation.index == descriptor.evaluation.index && actual.endpoint.index == descriptor.root.index {
          let previous = List<ThroughFlightObservation>.asSlice(&skeleton.throughFlightObservations)
          let mut found = false
          let mut each = usize.ZERO
          while each < previous.length {
            if previous[each].request == request && previous[each].alias == alias { found = true }
            each = each + usize.ONE
          }
          if !found {
            let observation = previous.length
            let owner = Storage {endpoint: storageOwner(prepared, actual.storage.endpoint), temporary: actual.storage.temporary}
            let active = Program.atom(&mut skeleton.rules)
            let gates: [Atom; 2] = [selected.active, actual.active]
            run Program.rule(&mut skeleton.rules, active, &gates, &[])
            run List<ThroughFlightObservation>.append(&mut skeleton.throughFlightObservations,
              ThroughFlightObservation {request: request, alias: alias, storage: actual.storage, owner: owner, active: active})
            run List<ThroughFlightCoverage>.append(&mut skeleton.throughFlightCoverage,
              ThroughFlightCoverage {observation: observation, missing: Program.atom(&mut skeleton.rules)})
            let components = run referenceOwnerComponents(prepared, owner)
            let componentsSelected = List<EndpointId>.asSlice(&components)
            each = usize.ZERO
            while each < componentsSelected.length {
              let storage = Storage {endpoint: componentsSelected[each], temporary: owner.temporary}
              let incoming = run reserveOwnerRead(&mut skeleton.*, selected.evaluation, storage)
              run List<ThroughFlightRead>.append(&mut skeleton.throughFlightReads, ThroughFlightRead {
                observation: observation, storage: storage, read: incoming.read, value: incoming.value, active: active})
              each = each + usize.ONE
            }
          }
        }
        alias = alias + usize.ONE
      }
    }
    request = request + usize.ONE
  }
  return before != List<ThroughFlightObservation>.length(&skeleton.throughFlightObservations)
}

fn throughResultUse(skeleton: &Skeleton, request: ThroughFlightRequest) -> Option<Atom> {
  // Ordinary through reads observe their descriptor holder without publishing it as a
  // displaced result. Only the distinct Replacement occurrence owns this reset boundary.
  if Skeleton.evaluation(skeleton, request.evaluation).category != EvaluationRole.Replacement {
    return Option<Atom>.none()
  }
  let results = List<ResultUse>.asSlice(&skeleton.results)
  let mut at = usize.ZERO
  while at < results.length {
    if results[at].evaluation.index == request.operation.index {
      if let ResultKind.Read {read} = results[at].kind {
        if read.index == request.evaluation.index { return Option<Atom>.some(results[at].active) }
      }
    }
    at = at + usize.ONE
  }
  return Option<Atom>.none()
}

// Authenticate the retained occurrence chain back to this request's original descriptor.
// The chain only names actual SelectionUses; it grants no canonical referent address.
fn throughReadValuePath(skeleton: &Skeleton, selection: usize, descriptor: ThroughDescriptor) -> bool {
  let uses = List<SelectionUse>.asSlice(&skeleton.selections)
  let mut current = selection
  let mut remaining = List<Evaluation>.length(&skeleton.evaluations)
  while remaining > usize.ZERO {
    let selected = &uses[current]
    if selected.result.index == descriptor.crossing.index {
      return selected.operand.index == descriptor.evaluation.index
    }
    let mut prior = usize.MAX
    let mut at = usize.ZERO
    while at < uses.length {
      if uses[at].result.index == selected.operand.index {
        if prior != usize.MAX && uses[prior].operand.index != uses[at].operand.index {
          return CompilerBug.panic(b"through scalar result has conflicting actual projection operands")
        }
        if prior == usize.MAX { prior = at }
      }
      at = at + usize.ONE
    }
    if prior == usize.MAX { return false }
    current = prior
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"through scalar result has cyclic occurrence ancestry")
}

fn throughReadValueMap<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  result: usize, request: usize, selection: usize) -> Option<MapId> {
  let use = &List<ResultUse>.asSlice(&skeleton.results)[result]
  let flight = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)[request]
  let selected = &List<SelectionUse>.asSlice(&skeleton.selections)[selection]
  let read = match use.kind { ResultKind.Read {read} => read _ => { return Option<MapId>.none() } }
  if flight.kind != ThroughFlightKind.Read || flight.operation.index != use.evaluation.index
    || flight.target.index != use.evaluation.index || flight.evaluation.index != use.evaluation.index
    || read.index != flight.evaluation.index || selected.result.index != use.evaluation.index {
    return Option<MapId>.none()
  }
  let descriptor = match flight.descriptor { Option<ThroughDescriptor>.Some {value} => value
    _ => { return Option<MapId>.none() } }
  // Replacement has a distinct earlier read, and a local/non-through read has no such
  // descriptor. Neither can enter this computed through-value authority.
  validateThroughFlightRequest(prepared, skeleton, flight)
  if !throughReadValuePath(skeleton, selection, descriptor) { return Option<MapId>.none() }
  let map = match selected.value { Option<MapId>.Some {value} => value _ => { return Option<MapId>.none() } }
  let output = &List<SelectionMap>.asSlice(&prepared.maps)[map.index]
  let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[output.target.index]
  let site = match Skeleton.evaluation(skeleton, use.evaluation).site { EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"through scalar result lost its actual typed occurrence") } }
  let exact = match endpoint.root { Root.Node {node, category} => node.index == site.index && category == EndpointRole.Value _ => false }
  if !exact || output.site.index != site.index || output.kind != MapKind.Copy
    || match endpoint.parent { Option<EndpointId>.Some {..} => true _ => false } {
    return CompilerBug.panic(b"through scalar result substituted another result family")
  }
  let known = match &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state {
    PreparedShapeState.KnownEmpty => true _ => false }
  if !known { return Option<MapId>.none() }
  return Option<MapId>.some(map)
}

effect fn closeThroughReadValues<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<ThroughReadValue>.length(&skeleton.throughReadValues)
  let resultCount = List<ResultUse>.length(&skeleton.results)
  let requestCount = List<ThroughFlightRequest>.length(&skeleton.throughFlightRequests)
  let selectionCount = List<SelectionUse>.length(&skeleton.selections)
  let mut result = usize.ZERO
  while result < resultCount {
    let directive = &List<ResultUse>.asSlice(&skeleton.results)[result]
    let sameRead = match directive.kind { ResultKind.Read {read} => read.index == directive.evaluation.index _ => false }
    if !sameRead { result = result + usize.ONE continue }
    let requested = directive.evaluation
    let mut request = usize.ZERO
    while request < requestCount {
      let original = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)[request]
      if original.kind != ThroughFlightKind.Read || original.operation.index != requested.index
        || original.target.index != requested.index || original.evaluation.index != requested.index {
        request = request + usize.ONE continue
      }
      let mut selection = usize.ZERO
      while selection < selectionCount {
        if let Option<MapId>.Some {value: map} = throughReadValueMap(prepared, &skeleton.*, result, request, selection) {
          let prior = List<ThroughReadValue>.asSlice(&skeleton.throughReadValues)
          let mut at = usize.ZERO
          while at < prior.length {
            if prior[at].result == result && prior[at].request == request { break }
            at = at + usize.ONE
          }
          if at == prior.length {
            let selected = &List<SelectionUse>.asSlice(&skeleton.selections)[selection]
            run validateSelectionUse(prepared, selected, List<Evaluation>.asSlice(&skeleton.evaluations))
            let selectionActive = selected.active
            let flight = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)[request]
            let evaluation = List<ResultUse>.asSlice(&skeleton.results)[result].evaluation
            let resultActive = List<ResultUse>.asSlice(&skeleton.results)[result].active
            let root = List<SelectionMap>.asSlice(&prepared.maps)[map.index].target
            let actual = Skeleton.evaluation(&skeleton.*, evaluation)
            let site = match actual.site { EvaluationSite.Node {node} => node
              _ => { return CompilerBug.panic(b"through scalar result has no actual expression") } }
            let target = run Skeleton.value(&mut skeleton.*, evaluation, root)
            let applicable = Program.atom(&mut skeleton.rules)
            let reached = Flow.reservedPoints(&skeleton.flow)[actual.point.index].reachable
            let gates: [Atom; 4] = [flight.active, selectionActive, resultActive, reached]
            run Program.rule(&mut skeleton.rules, applicable, &gates, &[])
            let accepted = Program.atom(&mut skeleton.rules)
            let active = Program.atom(&mut skeleton.rules)
            let complete: [Atom; 2] = [applicable, accepted]
            run Program.rule(&mut skeleton.rules, active, &complete, &[])
            let leaf = run Skeleton.leaf(&mut skeleton.*, Leaf {kind: SourceLeaf.LoanFree {node: site},
              origin: prepared.body.nodes[site.index].origin, endpoint: root})
            let seed = List<Seed>.length(&skeleton.seeds)
            let absent = Program.atom(&mut skeleton.rules)
            run List<Seed>.append(&mut skeleton.seeds, Seed {category: SourceRole.Physical, value: target, leaf: leaf,
              direct: false, active: active, stored: absent, alternatives: absent})
            run List<ThroughReadValue>.append(&mut skeleton.throughReadValues, ThroughReadValue {
              result: result, request: request, selection: selection, target: target, leaf: leaf,
              applicable: applicable, accepted: accepted, active: active, seed: seed})
          }
        }
        selection = selection + usize.ONE
      }
      request = request + usize.ONE
    }
    result = result + usize.ONE
  }
  return before != List<ThroughReadValue>.length(&skeleton.throughReadValues)
}

fn validateThroughReadValues<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let rows = List<ThroughReadValue>.asSlice(&skeleton.throughReadValues)
  let values = List<Value>.asSlice(&skeleton.values)
  let leaves = List<Leaf>.asSlice(&skeleton.leaves)
  let seeds = List<Seed>.asSlice(&skeleton.seeds)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = rows[at]
    let map = match throughReadValueMap(prepared, skeleton, row.result, row.request, row.selection) {
      Option<MapId>.Some {value} => value
      _ => { return CompilerBug.panic(b"through scalar result lost its original descriptor read authority") }
    }
    if row.target.index >= values.length || row.leaf.index >= leaves.length || row.seed >= seeds.length {
      CompilerBug.panic(b"through scalar result lost its original computed source")
    }
    let target = values[row.target.index]
    let root = List<SelectionMap>.asSlice(&prepared.maps)[map.index].target
    let use = &List<ResultUse>.asSlice(&skeleton.results)[row.result]
    if target.evaluation.index != use.evaluation.index || target.endpoint.index != root.index || target.phase != ValuePhase.Output {
      CompilerBug.panic(b"through scalar result changed its actual result placement")
    }
    if let Option<ResidualSubject>.Some {..} = target.subject { CompilerBug.panic(b"through scalar result substituted a selected value") }
    if let Option<usize>.Some {..} = target.summary { CompilerBug.panic(b"through scalar result substituted a summary") }
    if let Option<usize>.Some {..} = target.writeHolder { CompilerBug.panic(b"through scalar result substituted a write holder") }
    let site = match Skeleton.evaluation(skeleton, target.evaluation).site { EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"through scalar result has no computed result occurrence") } }
    let leaf = &leaves[row.leaf.index]
    let genuine = match &leaf.kind { SourceLeaf.LoanFree {node} => node.index == site.index _ => false }
    let seed = seeds[row.seed]
    if !genuine || leaf.endpoint.index != root.index || seed.value.index != row.target.index
      || seed.leaf.index != row.leaf.index || seed.direct || !Atom.same(seed.active, row.active)
      || Atom.same(row.active, row.accepted) || Atom.same(row.applicable, row.accepted) {
      CompilerBug.panic(b"through scalar result bypassed its complete descriptor-handler gate")
    }
    let mut prior = usize.ZERO
    while prior < at {
      if rows[prior].result == row.result || rows[prior].target.index == row.target.index {
        CompilerBug.panic(b"through scalar result duplicated its actual computed source")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// This authority is a semantic operand finish. Its selection map authenticates the
// actual dereference/result occurrence, and is never used as a descriptor->contents Copy.
fn rvalueDereferenceSelection<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  result: usize, selection: usize) -> Option<MapId> {
  let results = List<ResultUse>.asSlice(&skeleton.results)
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  if result >= results.length || selection >= selections.length {
    return CompilerBug.panic(b"rvalue dereference lost its actual finish or selection")
  }
  let use = &results[result]
  let selected = &selections[selection]
  if selected.result.index != use.evaluation.index { return Option<MapId>.none() }
  match use.kind { ResultKind.Physical => () _ => { return Option<MapId>.none() } }
  let operation = Skeleton.evaluation(skeleton, use.evaluation)
  let site = match operation.site { EvaluationSite.Node {node} => node _ => { return Option<MapId>.none() } }
  let operand = match &prepared.body.nodes[site.index].kind {
    NodeKind.Expression {form: Expression.Dereference {value}, ..} => value
    _ => { return Option<MapId>.none() }
  }
  let sourceEvaluation = Skeleton.evaluation(skeleton, selected.operand)
  let actualOperand = match sourceEvaluation.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
  let sources = List<EvalId>.asSlice(&use.sources)
  if !actualOperand || sources.length != usize.ONE || sources[0].index != selected.operand.index {
    return CompilerBug.panic(b"rvalue dereference substituted another written operand occurrence")
  }
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let authored = &List<Selection>.asSlice(&prepared.selections)[selected.selection.index]
  let selectors = List<MapId>.asSlice(&selected.selectors)
  if authored.site.index != site.index || selectors.length != usize.ONE {
    return CompilerBug.panic(b"rvalue dereference lost its exact authored Referent selection")
  }
  let selector = &maps[selectors[0].index]
  let root = &endpoints[authored.root.index]
  let operandRoot = match root.root { Root.Node {node, category} => node.index == operand.index && category == EndpointRole.Value _ => false }
  if !operandRoot || match root.parent { Option<EndpointId>.Some {..} => true _ => false }
    || selector.kind != MapKind.Select || selector.site.index != site.index || selector.source.index != authored.root.index
    || !sameSelector(&selector.selector, &Selector.Referent) {
    return CompilerBug.panic(b"rvalue dereference changed its actual descriptor root or selector")
  }
  let referent = &endpoints[selector.target.index]
  let child = match referent.parent { Option<EndpointId>.Some {value} => value.index == authored.root.index _ => false }
  if !child || !sameSelector(&referent.selector, &Selector.Referent) {
    return CompilerBug.panic(b"rvalue dereference selector has no original referent endpoint")
  }
  let output = match selected.value { Option<MapId>.Some {value} => value
    _ => { return CompilerBug.panic(b"rvalue dereference has no actual result map") } }
  let map = &maps[output.index]
  let endpoint = &endpoints[map.target.index]
  let resultRoot = match endpoint.root { Root.Node {node, category} => node.index == site.index && category == EndpointRole.Value _ => false }
  if map.kind != MapKind.Copy || map.site.index != site.index || map.source.index != selector.target.index
    || !resultRoot || match endpoint.parent { Option<EndpointId>.Some {..} => true _ => false } {
    return CompilerBug.panic(b"rvalue dereference replaced its frozen result family")
  }
  return Option<MapId>.some(output)
}

// A typed, actually completed rvalue dereference computes a scalar value even when its
// declared reference has no canonical address in this body. This is not a current-read
// substitute: BC must prove the original operand/route finish complete before admission.
effect fn reserveRvalueDereferenceValue<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  result: usize, selection: usize, target: ValueId) -> () ! OutOfMemoryError ? &mut Allocator {
  let output = List<Value>.asSlice(&skeleton.values)[target.index]
  let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[output.endpoint.index]
  match &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state {
    PreparedShapeState.KnownEmpty => ()
    _ => { return () }
  }
  let prior = List<RvalueDereferenceValue>.asSlice(&skeleton.rvalueDereferenceValues)
  let mut at = usize.ZERO
  while at < prior.length {
    if prior[at].result == result && prior[at].selection == selection {
      if prior[at].target.index != target.index { CompilerBug.panic(b"scalar dereference changed its actual result value") }
      return ()
    }
    at = at + usize.ONE
  }
  let actual = Skeleton.evaluation(&skeleton.*, output.evaluation)
  let site = match actual.site { EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"scalar dereference has no actual result occurrence") } }
  let selectionActive = List<SelectionUse>.asSlice(&skeleton.selections)[selection].active
  let resultActive = List<ResultUse>.asSlice(&skeleton.results)[result].active
  let reached = Flow.reservedPoints(&skeleton.flow)[actual.point.index].reachable
  let applicable = Program.atom(&mut skeleton.rules)
  let gates: [Atom; 3] = [selectionActive, resultActive, reached]
  run Program.rule(&mut skeleton.rules, applicable, &gates, &[])
  let accepted = Program.atom(&mut skeleton.rules)
  let active = Program.atom(&mut skeleton.rules)
  let complete: [Atom; 2] = [applicable, accepted]
  run Program.rule(&mut skeleton.rules, active, &complete, &[])
  let leaf = run Skeleton.leaf(&mut skeleton.*, Leaf {kind: SourceLeaf.LoanFree {node: site},
    origin: prepared.body.nodes[site.index].origin, endpoint: output.endpoint})
  let seed = List<Seed>.length(&skeleton.seeds)
  let absent = Program.atom(&mut skeleton.rules)
  run List<Seed>.append(&mut skeleton.seeds, Seed {category: SourceRole.Physical, value: target, leaf: leaf,
    direct: false, active: active, stored: absent, alternatives: absent})
  run List<RvalueDereferenceValue>.append(&mut skeleton.rvalueDereferenceValues, RvalueDereferenceValue {
    result: result, selection: selection, target: target, leaf: leaf, applicable: applicable,
    accepted: accepted, active: active, seed: seed})
  return ()
}

fn validateRvalueDereferenceValues<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let rows = List<RvalueDereferenceValue>.asSlice(&skeleton.rvalueDereferenceValues)
  let values = List<Value>.asSlice(&skeleton.values)
  let leaves = List<Leaf>.asSlice(&skeleton.leaves)
  let seeds = List<Seed>.asSlice(&skeleton.seeds)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = rows[at]
    let map = match rvalueDereferenceSelection(prepared, skeleton, row.result, row.selection) {
      Option<MapId>.Some {value} => value
      _ => { return CompilerBug.panic(b"scalar dereference lost its original unplaced finish authority") }
    }
    if row.target.index >= values.length || row.leaf.index >= leaves.length || row.seed >= seeds.length {
      CompilerBug.panic(b"scalar dereference lost its actual value source")
    }
    let target = values[row.target.index]
    let root = List<SelectionMap>.asSlice(&prepared.maps)[map.index].target
    let shape = List<Endpoint>.asSlice(&prepared.endpoints)[root.index].shape
    let known = match &List<Prepared.Shape>.asSlice(&prepared.shapes)[shape.index].state { PreparedShapeState.KnownEmpty => true _ => false }
    let use = &List<ResultUse>.asSlice(&skeleton.results)[row.result]
    if !known || target.evaluation.index != use.evaluation.index || target.endpoint.index != root.index
      || target.phase != ValuePhase.Output {
      CompilerBug.panic(b"scalar dereference changed its positive empty result evidence")
    }
    if let Option<ResidualSubject>.Some {..} = target.subject { CompilerBug.panic(b"scalar dereference substituted a selected value") }
    if let Option<usize>.Some {..} = target.summary { CompilerBug.panic(b"scalar dereference substituted a summary") }
    if let Option<usize>.Some {..} = target.writeHolder { CompilerBug.panic(b"scalar dereference substituted a write holder") }
    let site = match Skeleton.evaluation(skeleton, target.evaluation).site { EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"scalar dereference has no computed result occurrence") } }
    let leaf = &leaves[row.leaf.index]
    let genuine = match &leaf.kind { SourceLeaf.LoanFree {node} => node.index == site.index _ => false }
    let seed = seeds[row.seed]
    if !genuine || leaf.endpoint.index != root.index || seed.value.index != row.target.index
      || seed.leaf.index != row.leaf.index || seed.direct || !Atom.same(seed.active, row.active)
      || Atom.same(row.active, row.accepted) || Atom.same(row.applicable, row.accepted) {
      CompilerBug.panic(b"scalar dereference bypassed its exact finish-completion gate")
    }
    let mut prior = usize.ZERO
    while prior < at {
      if rows[prior].result == row.result || rows[prior].target.index == row.target.index {
        CompilerBug.panic(b"scalar dereference duplicated its actual computed source")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// This is the original summary read's direct canonical alias chain, not another
// semantic handler. Only the exact existing Field output receives its publication.
fn fieldReadValid<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  domain: &Domain, row: FieldRead) -> bool {
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let summary = List<SummaryRead>.asSlice(&skeleton.summaryReads)[row.summaryRead]
  let held = List<SummaryStorage>.asSlice(&skeleton.summaries)[row.summary]
  let definition = List<DefinedValue>.asSlice(&skeleton.definitions)[row.definition.index]
  let original = List<ReadValue>.asSlice(&skeleton.reads)[row.original.index]
  let read = List<ReadValue>.asSlice(&skeleton.reads)[row.read.index]
  let request = List<AliasTransport>.asSlice(&skeleton.aliasTransports)[row.request]
  let alias = List<StorageAlias>.asSlice(&skeleton.aliases)[row.alias]
  let recorded = List<AliasRead>.asSlice(&skeleton.aliasReads)[row.aliasRead]
  let edge = List<AliasEdge>.asSlice(&skeleton.aliasEdges)[row.edge]
  let selection = &List<SelectionUse>.asSlice(&skeleton.selections)[row.selection]
  let family = match fieldResultMap(prepared, skeleton, row.result, row.selection) {
    Option<MapId>.Some {value} => value _ => { return false } }
  if row.root.index != maps[family.index].target.index || !Results.inFamily(maps, family, row.map)
    || maps[row.map.index].kind != MapKind.Copy || !maps[row.map.index].componentTransport
    || !match &maps[row.map.index].selector { Selector.Identity => true _ => false }
    || summary.summary != row.summary || summary.original.index != row.original.index || summary.read.index != row.read.index
    || summary.target.index != row.canonical.index || !sameStorage(row.storage, original.storage)
    || !sameOwnershipPlacement(row.held, held.placement) || !sameStorage(read.storage, held.prefix)
    || read.read.index != row.read.index || original.read.index != row.original.index
    || !match definition.summary { Option<usize>.Some {value} => value == row.summary _ => false }
    || !match read.summary { Option<usize>.Some {value} => value == row.summary _ => false }
    || !match original.summary { Option<usize>.None => true _ => false }
    || original.value.index != row.canonical.index || !match original.map { Option<MapId>.None => true _ => false }
    || recorded.request != row.request || recorded.read.index != row.original.index
    || request.alias != row.alias || request.direction != MapDirection.Forward
    || !match request.consumer { Option<ValueId>.Some {value} => value.index == row.output.index _ => false }
    || !match request.authority { AliasConsumer.Projection {map} => map.index == row.map.index _ => false }
    || request.evaluation.index != selection.result.index || alias.evaluation.index != selection.operand.index
    || alias.endpoint.index != maps[row.map.index].source.index || !sameStorage(alias.storage, row.storage)
    || edge.target != row.alias || !match edge.source { Option<usize>.None => true _ => false }
    || !match edge.authority { AliasAuthority.Canonical => true _ => false } { return false }
  let points = Flow.reservedReads(&skeleton.flow)
  let defined = Flow.reservedDefinitions(&skeleton.flow)[row.definition.index]
  if definition.definition.index != row.definition.index || defined.component.index != held.component.index
    || points[row.read.index].component.index != held.component.index
    || !match values[definition.value.index].summary { Option<usize>.Some {value} => value == row.summary _ => false }
    || !match values[read.value.index].summary { Option<usize>.Some {value} => value == row.summary _ => false }
    || points[row.original.index].point.index != points[row.read.index].point.index
    || points[row.read.index].point.index != Skeleton.evaluation(skeleton, request.evaluation).point.index { return false }
  let canonical = values[row.canonical.index]
  let transport = values[row.transport.index]
  let output = values[row.output.index]
  if canonical.phase != ValuePhase.Input || transport.phase != ValuePhase.Transport || output.phase != ValuePhase.Output
    || canonical.evaluation.index != request.evaluation.index || transport.evaluation.index != request.evaluation.index
    || output.evaluation.index != request.evaluation.index || canonical.endpoint.index != row.storage.endpoint.index
    || transport.endpoint.index != alias.endpoint.index || output.endpoint.index != maps[row.map.index].target.index
    || !match transport.transport { Option<AliasPort>.Some {value} => value.request == row.request && value.alias == row.alias _ => false } { return false }
  let plain: [Value; 3] = [canonical, transport, output]
  let mut at = usize.ZERO
  while at < plain.length {
    if !match plain[at].subject { Option<ResidualSubject>.None => true _ => false }
      || !match plain[at].summary { Option<usize>.None => true _ => false }
      || !match plain[at].writeHolder { Option<usize>.None => true _ => false } { return false }
    at = at + usize.ONE
  }
  let stored = &cases[row.storageCase]
  let loaded = &cases[row.summaryCase]
  let moved = &cases[row.transportCase]
  let published = &cases[row.case]
  let writer = match stored.source { Option<usize>.Some {value} => value _ => { return false } }
  if keys[writer].value.index != definition.value.index || keys[stored.target].value.index != read.value.index
    || !match stored.authority { TransferAuthority.SameComponent => true _ => false }
    || !match stored.definition { Option<DefinitionId>.Some {value} => value.index == row.definition.index _ => false }
    || !match stored.read { Option<ReadId>.Some {value} => value.index == row.read.index _ => false }
    || !fieldCaseSource(loaded, stored.target) || keys[loaded.target].value.index != row.canonical.index
    || !match loaded.authority { TransferAuthority.SummaryRead {reading} => reading == row.summaryRead _ => false }
    || !fieldCaseSource(moved, loaded.target) || keys[moved.target].value.index != row.transport.index
    || !match moved.authority { TransferAuthority.SameComponent => true _ => false }
    || !fieldCaseSource(published, moved.target) || keys[published.target].value.index != row.output.index
    || !match published.authority { TransferAuthority.Physical {map, direction, address: Option<EvalId>.None} =>
      map.index == row.map.index && direction == MapDirection.Forward _ => false } { return false }
  let chain: [usize; 4] = [row.storageCase, row.summaryCase, row.transportCase, row.case]
  let witness = keys[stored.target].witness
  at = usize.ZERO
  while at < chain.length {
    let actual = &cases[chain[at]]
    let key = keys[actual.target]
    if key.category != row.category || key.leaf.index != row.leaf.index || key.direct != row.direct || key.witness != witness { return false }
    if at != usize.ZERO {
      if !match actual.definition { Option<DefinitionId>.None => true _ => false }
        || !match actual.read { Option<ReadId>.None => true _ => false } { return false }
    }
    at = at + usize.ONE
  }
  let carried = &List<Witness>.asSlice(&domain.witnesses)[witness]
  return row.category == SourceRole.Ownership
    && match carried.definition { Option<DefinitionId>.Some {value} => value.index == row.definition.index _ => false }
    && match carried.read { Option<ReadId>.Some {value} => value.index == row.read.index _ => false }
}

effect fn seedFieldRead<'body>(product: &mut OwnershipPublications, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, row: FieldRead) -> () ! OutOfMemoryError ? &mut Allocator {
  let prior = List<FieldRead>.asSlice(&product.fieldReads)
  let reading = prior.length
  let mut at = usize.ZERO
  while at < prior.length {
    let old = prior[at]
    if old.result == row.result && old.selection == row.selection && old.summaryRead == row.summaryRead
      && old.aliasRead == row.aliasRead && old.edge == row.edge && old.storageCase == row.storageCase
      && old.summaryCase == row.summaryCase && old.transportCase == row.transportCase && old.case == row.case { return () }
    at = at + usize.ONE
  }
  if !fieldReadValid(prepared, &skeleton.*, domain, row) { return () }
  run validateSelectionUse(prepared, &List<SelectionUse>.asSlice(&skeleton.selections)[row.selection],
    List<Evaluation>.asSlice(&skeleton.evaluations))
  let cases = List<Case>.asSlice(&domain.cases)
  let mut retained = row
  retained.active = Program.atom(&mut skeleton.rules)
  let active = retained.active
  let evaluation = List<ResultUse>.asSlice(&skeleton.results)[row.result].evaluation
  let gates: [Atom; 10] = [cases[row.storageCase].active, cases[row.summaryCase].active,
    cases[row.transportCase].active, cases[row.case].active, List<SummaryRead>.asSlice(&skeleton.summaryReads)[row.summaryRead].active,
    List<AliasTransport>.asSlice(&skeleton.aliasTransports)[row.request].active,
    List<StorageAlias>.asSlice(&skeleton.aliases)[row.alias].active, List<AliasEdge>.asSlice(&skeleton.aliasEdges)[row.edge].active,
    List<ResultUse>.asSlice(&skeleton.results)[row.result].active, List<SelectionUse>.asSlice(&skeleton.selections)[row.selection].active]
  let reach = Flow.reachable(&skeleton.flow, Skeleton.evaluation(&skeleton.*, evaluation).point)
  let available = Program.atom(&mut skeleton.rules)
  run Program.rule(&mut skeleton.rules, available, &gates, &[])
  let seed: [Atom; 2] = [available, reach]
  run Program.rule(&mut skeleton.rules, active, &seed, &[])
  run List<FieldRead>.append(&mut product.fieldReads, retained)
  let origin = List<OwnershipOrigin>.length(&product.origins)
  run List<OwnershipOrigin>.append(&mut product.origins, OwnershipOrigin.FieldRead {
    reading: reading, category: row.category, root: row.root, active: active})
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let family = run transferFamily(List<Endpoint>.asSlice(&prepared.endpoints), maps, row.map)
  let members = List<MapId>.asSlice(&family)
  let width = match row.held { OwnershipPlacement.Position {position, offset, ..} =>
    List<OwnershipPositionStep>.length(&List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions)[position.index].steps) - offset + usize.ONE
    _ => usize.ONE }
  let count = match row.held { OwnershipPlacement.Unknown => usize.ONE _ => members.length * width + usize.ONE }
  at = usize.ZERO
  while at < count {
    let mut initial = OwnershipPlacement.Unknown
    match row.held {
      OwnershipPlacement.Unknown => ()
      OwnershipPlacement.Known {suffix, ..} => {
        if at != members.length { initial = OwnershipPlacement.Known {anchor: maps[members[at].index].target, suffix: suffix} }
      }
      OwnershipPlacement.Position {position, offset, ..} => {
        if at != members.length * width { initial = OwnershipPlacement.Position {
          anchor: maps[members[at / width].index].target, position: position, offset: offset + at % width} }
      }
    }
    let node = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
      origin, initial, initial, cases[row.case].target)
    let seed: [Atom; 1] = [active]
    run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[node].active, &seed, &[])
    at = at + usize.ONE
  }
  return ()
}

effect fn fieldReadCandidates<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  domain: &Domain) -> List<FieldRead> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<FieldRead>.make()
  let summaries = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  if summaries.length == usize.ZERO { return move found }
  let mut eligible = false
  let mut result = usize.ZERO
  while result < List<ResultUse>.length(&skeleton.results) {
    let mut selection = usize.ZERO
    while selection < List<SelectionUse>.length(&skeleton.selections) {
      if let Option<MapId>.Some {..} = fieldResultMap(prepared, skeleton, result, selection) { eligible = true }
      selection = selection + usize.ONE
    }
    result = result + usize.ONE
  }
  if !eligible { return move found }
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let index = run observationCaseIndex(domain)
  let requests = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let recorded = List<AliasRead>.asSlice(&skeleton.aliasReads)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut finalCase = usize.ZERO
  while finalCase < cases.length {
    let finalEdge = &cases[finalCase]
    if let TransferAuthority.Physical {map, direction, address: Option<EvalId>.None} = finalEdge.authority {
      if direction == MapDirection.Forward {
        if let Option<usize>.Some {value: source} = finalEdge.source {
          let incoming = values[keys[source].value.index]
          if let Option<AliasPort>.Some {value: port} = incoming.transport {
            let request = requests[port.request]
            if port.alias == request.alias && request.direction == MapDirection.Forward {
              let mut resultAt = usize.ZERO
              while resultAt < List<ResultUse>.length(&skeleton.results) {
                let mut selection = usize.ZERO
                while selection < List<SelectionUse>.length(&skeleton.selections) {
                  if let Option<MapId>.Some {value: family} = fieldResultMap(prepared, skeleton, resultAt, selection) {
                    if Results.inFamily(maps, family, map) {
                      let transports = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.targets)[source])
                      let mut ti = usize.ZERO
                      while ti < transports.length {
                        let transportCase = transports[ti]
                        if let Option<usize>.Some {value: canonicalCell} = cases[transportCase].source {
                          let loads = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.targets)[canonicalCell])
                          let mut li = usize.ZERO
                          while li < loads.length {
                            let summaryCase = loads[li]
                            if let TransferAuthority.SummaryRead {reading} = cases[summaryCase].authority {
                              let summary = summaries[reading]
                              if let Option<usize>.Some {value: readCell} = cases[summaryCase].source {
                                let stores = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.targets)[readCell])
                                let mut si = usize.ZERO
                                while si < stores.length {
                                  let storageCase = stores[si]
                                  if let Option<DefinitionId>.Some {value: definition} = cases[storageCase].definition {
                                    let mut ar = usize.ZERO
                                    while ar < recorded.length {
                                      if recorded[ar].request == port.request && recorded[ar].read.index == summary.original.index {
                                        let mut edge = usize.ZERO
                                        while edge < edges.length {
                                          if edges[edge].target == port.alias && match edges[edge].authority { AliasAuthority.Canonical => true _ => false } {
                                            let key = keys[finalEdge.target]
                                            let held = List<SummaryStorage>.asSlice(&skeleton.summaries)[summary.summary]
                                            let row = FieldRead {result: resultAt, selection: selection, summaryRead: reading, summary: summary.summary,
                                              definition: definition, original: summary.original, read: summary.read, storage: aliases[port.alias].storage,
                                              held: held.placement, canonical: keys[canonicalCell].value, transport: keys[source].value,
                                              output: key.value, root: maps[family.index].target, map: map, alias: port.alias, request: port.request, aliasRead: ar,
                                              storageCase: storageCase, summaryCase: summaryCase, transportCase: transportCase, case: finalCase,
                                              category: key.category, leaf: key.leaf, direct: key.direct, active: finalEdge.active, edge: edge}
                                            run List<FieldRead>.append(&mut found, row)
                                          }
                                          edge = edge + usize.ONE
                                        }
                                      }
                                      ar = ar + usize.ONE
                                    }
                                  }
                                  si = si + usize.ONE
                                }
                              }
                            }
                            li = li + usize.ONE
                          }
                        }
                        ti = ti + usize.ONE
                      }
                    }
                  }
                  selection = selection + usize.ONE
                }
                resultAt = resultAt + usize.ONE
              }
            }
          }
        }
      }
    }
    finalCase = finalCase + usize.ONE
  }
  return move found
}

effect fn reserveFieldReads<'body>(product: &mut OwnershipPublications, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let candidates = run fieldReadCandidates(prepared, &skeleton.*, domain)
  let rows = List<FieldRead>.asSlice(&candidates)
  let mut at = usize.ZERO
  while at < rows.length {
    run seedFieldRead(&mut product.*, prepared, &mut skeleton.*, domain, rows[at])
    at = at + usize.ONE
  }
  return ()
}

fn sameFieldResultSource(left: FieldResultSource, right: FieldResultSource) -> bool {
  return match left {
    FieldResultSource.Physical => match right { FieldResultSource.Physical => true _ => false }
    FieldResultSource.Publication {publication} => match right {
      FieldResultSource.Publication {publication: other} => publication == other _ => false }
  }
}
fn isFieldResultCase(authority: TransferAuthority) -> bool {
  return match authority { TransferAuthority.FieldResult {..} => true _ => false }
}

fn fieldResultMap<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  result: usize, selection: usize) -> Option<MapId> {
  let use = &List<ResultUse>.asSlice(&skeleton.results)[result]
  let selected = &List<SelectionUse>.asSlice(&skeleton.selections)[selection]
  if use.evaluation.index != selected.result.index
    || !match use.kind { ResultKind.Physical => true _ => false } { return Option<MapId>.none() }
  let evaluation = Skeleton.evaluation(skeleton, use.evaluation)
  let site = match evaluation.site { EvaluationSite.Node {node} => node _ => { return Option<MapId>.none() } }
  let form = match &prepared.body.nodes[site.index].kind { NodeKind.Expression {form, ..} => &form
    _ => { return Option<MapId>.none() } }
  let operand = match &form.* { Expression.Field {value, ..} => value _ => { return Option<MapId>.none() } }
  let field = match &form.* { Expression.Field {index, ..} => index _ => { return Option<MapId>.none() } }
  let operandSite = match Skeleton.evaluation(skeleton, selected.operand).site {
    EvaluationSite.Node {node} => node.index == operand.index _ => false }
  let sources = List<EvalId>.asSlice(&use.sources)
  let mut observed = false
  let mut at = usize.ZERO
  while at < sources.length { if sources[at].index == selected.operand.index { observed = true } at = at + usize.ONE }
  let selectors = List<MapId>.asSlice(&selected.selectors)
  if !operandSite || !observed || selectors.length != usize.ONE { return CompilerBug.panic(b"semantic Field lost its exact operand or single authored selector") }
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let selector = &maps[selectors[0].index]
  let exact = match &selector.selector {
    Selector.Field {ordinal} => ordinal == field
    Selector.Member {member, payload, ..} => member == field && payload == usize.ZERO
    _ => false
  }
  if !exact { return CompilerBug.panic(b"semantic Field changed its typed field coordinate") }
  let map = match selected.value { Option<MapId>.Some {value} => value _ => { return Option<MapId>.none() } }
  let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[maps[map.index].target.index]
  let whole = match endpoint.parent { Option<EndpointId>.None => true _ => false }
  if !whole || maps[map.index].source.index != selector.target.index { return CompilerBug.panic(b"semantic Field changed its selected component family") }
  return Option<MapId>.some(map)
}

fn fieldOperandRoot<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, selection: usize) -> EndpointId {
  let selected = &List<SelectionUse>.asSlice(&skeleton.selections)[selection]
  let storage = List<Selection>.asSlice(&prepared.selections)[selected.selection.index].root
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut at = usize.ZERO
  while at < endpoints.length {
    let whole = match endpoints[at].parent { Option<EndpointId>.None => true _ => false }
    let value = match endpoints[at].root { Root.Node {category, ..} => category == EndpointRole.Value _ => false }
    if whole && value && sameSourceComponent(endpoints, storage, EndpointId {index: at}) { return EndpointId {index: at} }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"semantic Field has no original operand Value root")
}

struct FieldResidual {
  member: Option<MapId>
  placement: OwnershipPlacement
}
impl Copy for FieldResidual {}
// Only existing component counterparts and suffix offsets are alternatives. In particular
// Unknown is a candidate for policy MAX; failure to map a known suffix never admits it.
effect fn fieldResiduals<'body>(prepared: &SourcePreparation<'body>, positions: &[OwnershipPosition],
  map: MapId, initial: OwnershipPlacement) -> List<FieldResidual> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<FieldResidual>.make()
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  if let Option<EndpointId>.Some {value: anchor} = ownershipAnchor(initial) {
    let family = run transferFamily(endpoints, maps, map)
    let members = List<MapId>.asSlice(&family)
    let mut at = usize.ZERO
    while at < members.length {
      let member = &maps[members[at].index]
      if sameSourceComponent(endpoints, anchor, member.source) {
        run List<FieldResidual>.append(&mut result, FieldResidual {member: Option<MapId>.some(members[at]),
          placement: ownershipAt(initial, member.target)})
      }
      at = at + usize.ONE
    }
    // An unchanged semantic Position may begin above the selected inline component.
    // Strip only the actual atomic prefix count; BC authenticates full readContains and
    // the resulting residual, so mismatched prefixes cannot publish this alternative.
    if let OwnershipPlacement.Position {position, offset, ..} = initial {
      let mut ancestor = maps[map.index].source
      let mut remaining = endpoints.length
      while remaining != usize.ZERO {
        if sameSourceComponent(endpoints, anchor, ancestor) {
          if ancestor.index != maps[map.index].source.index {
            let mut prefix = List<OwnershipPositionStep>.make()
            if run ownershipPathSteps(endpoints, ancestor, maps[map.index].source, &mut prefix) {
              let count = List<OwnershipPositionStep>.length(&prefix)
              let length = List<OwnershipPositionStep>.length(&positions[position.index].steps)
              if offset <= length && count <= length - offset {
                run List<FieldResidual>.append(&mut result, FieldResidual {member: Option<MapId>.none(),
                  placement: OwnershipPlacement.Position {anchor: maps[map.index].target, position: position, offset: offset + count}})
              }
            }
          }
          break
        }
        if let Option<EndpointId>.Some {value} = endpoints[ancestor.index].parent { ancestor = value } else { break }
        remaining = remaining - usize.ONE
      }
    }
  }
  run List<FieldResidual>.append(&mut result, FieldResidual {member: Option<MapId>.none(), placement: OwnershipPlacement.Unknown})
  return move result
}

effect fn reserveFieldResultEvidence<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  domain: &Domain, product: &OwnershipPublications, result: usize, selection: usize, map: MapId,
  sourceCase: usize, origin: FieldResultSource, initial: OwnershipPlacement) -> () ! OutOfMemoryError ? &mut Allocator {
  let actual = &List<Case>.asSlice(&domain.cases)[sourceCase]
  let key = List<CellKey>.asSlice(&domain.keys)[actual.target]
  let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
  let selectionActive = List<SelectionUse>.asSlice(&skeleton.selections)[selection].active
  let evaluation = List<ResultUse>.asSlice(&skeleton.results)[result].evaluation
  let resultActive = List<ResultUse>.asSlice(&skeleton.results)[result].active
  let root = List<SelectionMap>.asSlice(&prepared.maps)[map.index].target
  let target = run Skeleton.value(&mut skeleton.*, evaluation, root)
  let residuals = run fieldResiduals(prepared, List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions), map, initial)
  let alternatives = List<FieldResidual>.asSlice(&residuals)
  let mut at = usize.ZERO
  while at < alternatives.length {
    let selected = alternatives[at]
    let recipes = List<FieldResultRecipe>.asSlice(&skeleton.fieldResultRecipes)
    let mut recipe = usize.ZERO
    while recipe < recipes.length {
      if recipes[recipe].result == result && recipes[recipe].selection == selection && recipes[recipe].sourceCell == actual.target
        && sameOwnershipPlacement(recipes[recipe].placement, selected.placement) { break }
      recipe = recipe + usize.ONE
    }
    if recipe == recipes.length {
      let active = Program.atom(&mut skeleton.rules)
      run List<FieldResultRecipe>.append(&mut skeleton.fieldResultRecipes, FieldResultRecipe {result: result,
        selection: selection, source: key.value, target: target, root: root, placement: selected.placement,
        active: active, sourceCell: actual.target})
      let absent = Program.atom(&mut skeleton.rules)
      run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: key.value, target: target, active: active,
        directness: holdingDirectness(unknownOwnership(selected.placement)), stored: absent, alternatives: absent,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Filtered, terminal: false,
        authority: TransferAuthority.FieldResult {recipe: recipe, sourceCell: actual.target}})
    }
    let candidates = List<FieldResultCandidate>.asSlice(&skeleton.fieldResultCandidates)
    let mut candidate = usize.ZERO
    while candidate < candidates.length {
      if candidates[candidate].recipe == recipe && candidates[candidate].sourceCase == sourceCase
        && sameFieldResultSource(candidates[candidate].origin, origin) { break }
      candidate = candidate + usize.ONE
    }
    if candidate == candidates.length {
      let active = Program.atom(&mut skeleton.rules)
      let mut incoming = actual.active
      if let FieldResultSource.Publication {publication} = origin {
        incoming = run addressApplies(&mut skeleton.rules, incoming, List<OwnershipPublication>.asSlice(&product.values)[publication].active)
      }
      let gates: [Atom; 4] = [incoming, selectionActive, resultActive, Flow.reachable(&skeleton.flow, Skeleton.evaluation(&skeleton.*, evaluation).point)]
      run Program.rule(&mut skeleton.rules, active, &gates, &[])
      let arrived: [Atom; 1] = [active]
      run Program.rule(&mut skeleton.rules, List<FieldResultRecipe>.asSlice(&skeleton.fieldResultRecipes)[recipe].active, &arrived, &[])
      run List<FieldResultCandidate>.append(&mut skeleton.fieldResultCandidates, FieldResultCandidate {
        recipe: recipe, result: result, selection: selection, map: map, member: selected.member, sourceCase: sourceCase,
        source: key.value, target: target, root: root, category: key.category, leaf: key.leaf, direct: key.direct,
        definition: witness.definition, read: witness.read, origin: origin, initial: initial, placement: selected.placement,
        active: active, sourceCell: actual.target})
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn closeFieldResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  domain: &Domain, product: &OwnershipPublications) -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<FieldResultCandidate>.length(&skeleton.fieldResultCandidates)
  let resultCount = List<ResultUse>.length(&skeleton.results)
  let selectionCount = List<SelectionUse>.length(&skeleton.selections)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let publications = List<OwnershipPublication>.asSlice(&product.values)
  let mut result = usize.ZERO
  while result < resultCount {
    let mut selection = usize.ZERO
    while selection < selectionCount {
      if let Option<MapId>.Some {value: map} = fieldResultMap(prepared, &skeleton.*, result, selection) {
        run validateSelectionUse(prepared, &List<SelectionUse>.asSlice(&skeleton.selections)[selection], List<Evaluation>.asSlice(&skeleton.evaluations))
        let operand = List<SelectionUse>.asSlice(&skeleton.selections)[selection].operand
        let root = fieldOperandRoot(prepared, &skeleton.*, selection)
        let mut sourceCase = usize.ZERO
        while sourceCase < cases.length {
          let key = keys[cases[sourceCase].target]
          let value = List<Value>.asSlice(&skeleton.values)[key.value.index]
          // Match the actual unplaced operand observation. Residual subjects have
          // separate consumers and are not additional histories of this plain Value.
          let ordinary = match value.subject { Option<ResidualSubject>.None => true _ => false }
            && match value.summary { Option<usize>.None => true _ => false }
            && match value.writeHolder { Option<usize>.None => true _ => false }
          if ordinary && value.phase == ValuePhase.Output && value.evaluation.index == operand.index && inlineWithin(prepared, value.endpoint, root) {
            if key.category == SourceRole.Physical {
              let initial = OwnershipPlacement.Known {anchor: value.endpoint, suffix: Option<OwnershipSuffix>.none()}
              run reserveFieldResultEvidence(prepared, &mut skeleton.*, domain, product, result, selection, map,
                sourceCase, FieldResultSource.Physical, initial)
            }
            let rows = ownershipRowsAt(product, key.value, false)
            let mut at = usize.ZERO
            while at < rows.length {
              let publication = rows[at]
              if publications[publication].cell == cases[sourceCase].target {
                run reserveFieldResultEvidence(prepared, &mut skeleton.*, domain, product, result, selection, map,
                  sourceCase, FieldResultSource.Publication {publication: publication}, publications[publication].placement)
              }
              at = at + usize.ONE
            }
          }
          sourceCase = sourceCase + usize.ONE
        }
      }
      selection = selection + usize.ONE
    }
    result = result + usize.ONE
  }
  return before != List<FieldResultCandidate>.length(&skeleton.fieldResultCandidates)
}

// One origin per recipe, never per predecessor publication. New primitive evidence adds
// rules to this same publication instead of allocating another history-keyed origin.
effect fn reserveFieldResultPublications(product: &mut OwnershipPublications, skeleton: &mut Skeleton,
  domain: &Domain) -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<FieldResultPublication>.length(&product.fieldResults)
  let policies = List<PendingPolicy>.asSlice(&domain.policies)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let candidates = List<FieldResultCandidate>.asSlice(&skeleton.fieldResultCandidates)
  let recipes = List<FieldResultRecipe>.asSlice(&skeleton.fieldResultRecipes)
  let mut policy = usize.ZERO
  while policy < policies.length {
    let port = policies[policy]
    if let TransferAuthority.FieldResult {recipe, sourceCell} = port.port.authority {
      let selected = recipes[recipe]
      if sourceCell != selected.sourceCell || port.sourceCell != sourceCell { return CompilerBug.panic(b"semantic Field policy changed its recipe cell") }
      let targetCell = cases[port.outputCase].target
      let origins = List<OwnershipOrigin>.asSlice(&product.origins)
      let mut origin = usize.ZERO
      while origin < origins.length {
        if let OwnershipOrigin.FieldResult {recipe: matched, ..} = origins[origin] { if matched == recipe { break } }
        origin = origin + usize.ONE
      }
      if origin == origins.length {
        let active = Program.atom(&mut skeleton.rules)
        run List<OwnershipOrigin>.append(&mut product.origins, OwnershipOrigin.FieldResult {
          recipe: recipe, category: keys[targetCell].category, root: selected.root, active: active})
      }
      let originActive = match List<OwnershipOrigin>.asSlice(&product.origins)[origin] { OwnershipOrigin.FieldResult {active, ..} => active
        _ => { return CompilerBug.panic(b"semantic Field lost its stable publication origin") } }
      let publication = run ownershipPublicationNode(&mut product.*, domain, &mut skeleton.rules,
        origin, selected.placement, selected.placement, targetCell)
      let mut candidate = usize.ZERO
      while candidate < candidates.length {
        let incoming = candidates[candidate]
        if incoming.recipe == recipe {
          let rows = List<FieldResultPublication>.asSlice(&product.fieldResults)
          let mut found = usize.ZERO
          while found < rows.length { if rows[found].candidate == candidate && rows[found].case == port.outputCase { break } found = found + usize.ONE }
          if found == rows.length {
            let applicable = run addressApplies(&mut skeleton.rules, incoming.active, port.port.quality.present)
            let accepted = Program.atom(&mut skeleton.rules)
            let admitted: [Atom; 3] = [cases[port.outputCase].active, incoming.active, accepted]
            run Program.rule(&mut skeleton.rules, originActive, &admitted, &[])
            run Program.rule(&mut skeleton.rules, List<OwnershipPublication>.asSlice(&product.values)[publication].active, &admitted, &[])
            run List<FieldResultPublication>.append(&mut product.fieldResults, FieldResultPublication {
              candidate: candidate, case: port.outputCase, sourceCase: incoming.sourceCase, source: incoming.source, target: incoming.target,
              root: incoming.root, sourceRole: incoming.category, outputRole: keys[targetCell].category, leaf: incoming.leaf,
              direct: incoming.direct, definition: incoming.definition, read: incoming.read, placement: incoming.placement,
              publication: publication, sourceActive: cases[incoming.sourceCase].active, applicable: applicable, accepted: accepted,
              sourceCell: sourceCell, targetCell: targetCell})
          }
        }
        candidate = candidate + usize.ONE
      }
    }
    policy = policy + usize.ONE
  }
  return before != List<FieldResultPublication>.length(&product.fieldResults)
}

fn fieldResultPolicy(policy: PendingPolicy, cases: &[Case], keys: &[CellKey], witnesses: &[Witness],
  values: &[Value], recipes: &[FieldResultRecipe]) -> Option<usize> {
  let recipe = match policy.port.authority { TransferAuthority.FieldResult {recipe, ..} => recipe
    _ => { return Option<usize>.none() } }
  if let TransferAuthority.FieldResult {sourceCell, ..} = policy.port.authority {
    if sourceCell != policy.sourceCell { return CompilerBug.panic(b"Field policy lost its original cell") }
  }
  if recipe >= recipes.length || policy.outputCase >= cases.length || policy.sourceCell >= keys.length {
    return CompilerBug.panic(b"Field policy lost its finite recipe or Case")
  }
  let selected = recipes[recipe]
  let actual = &cases[policy.outputCase]
  let source = match actual.source { Option<usize>.Some {value} => value _ => { return CompilerBug.panic(b"Field policy substituted a seed") } }
  if source != policy.sourceCell || source != selected.sourceCell { return CompilerBug.panic(b"Field policy changed its exact predecessor") }
  let before = keys[source]
  let after = keys[actual.target]
  let witness = &witnesses[before.witness]
  let definition = match witness.definition { Option<DefinitionId>.Some {value} => match policy.port.definition {
    Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match policy.port.definition { Option<DefinitionId>.None => true _ => false } }
  let read = match witness.read { Option<ReadId>.Some {value} => match policy.port.read {
    Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
    _ => match policy.port.read { Option<ReadId>.None => true _ => false } }
  if before.value.index != selected.source.index || after.value.index != selected.target.index
    || policy.port.source.index != before.value.index || policy.port.target.index != after.value.index
    || before.category != policy.port.category || after.category != SourceRole.Ownership || policy.port.outputRole != after.category
    || before.leaf.index != after.leaf.index || before.leaf.index != policy.port.leaf.index || before.witness != after.witness
    || before.direct != policy.port.direct || after.direct != (before.direct && !unknownOwnership(selected.placement))
    || policy.port.outputDirect != after.direct || !definition || !read
    || values[after.value.index].endpoint.index != selected.root.index || values[after.value.index].phase != ValuePhase.Output {
    return CompilerBug.panic(b"Field policy changed source identity, directness or semantic output")
  }
  match actual.authority {
    TransferAuthority.FieldResult {recipe: other, sourceCell} => {
      if other != recipe || sourceCell != source { return CompilerBug.panic(b"Field output Case substituted another recipe") }
    }
    _ => { return CompilerBug.panic(b"Field output Case lost its semantic authority") }
  }
  return Option<usize>.some(recipe)
}

effect fn validateFieldResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  domain: &Domain, product: &OwnershipPublications) -> () ! OutOfMemoryError ? &mut Allocator {
  let recipes = List<FieldResultRecipe>.asSlice(&skeleton.fieldResultRecipes)
  let candidates = List<FieldResultCandidate>.asSlice(&skeleton.fieldResultCandidates)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let values = List<Value>.asSlice(&skeleton.values)
  let publications = List<OwnershipPublication>.asSlice(&product.values)
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = candidates[at]
    if candidate.recipe >= recipes.length || candidate.sourceCase >= cases.length {
      CompilerBug.panic(b"Field incoming evidence lost its primitive Case or recipe")
    }
    let recipe = recipes[candidate.recipe]
    let sourceCell = cases[candidate.sourceCase].target
    let key = keys[sourceCell]
    let witness = &witnesses[key.witness]
    let source = values[key.value.index]
    let target = values[candidate.target.index]
    let map = match fieldResultMap(prepared, skeleton, candidate.result, candidate.selection) {
      Option<MapId>.Some {value} => value _ => { return CompilerBug.panic(b"Field evidence has no actual typed finish") } }
    let selected = &List<SelectionUse>.asSlice(&skeleton.selections)[candidate.selection]
    run validateSelectionUse(prepared, selected, List<Evaluation>.asSlice(&skeleton.evaluations))
    let root = fieldOperandRoot(prepared, skeleton, candidate.selection)
    let definition = match witness.definition { Option<DefinitionId>.Some {value} => match candidate.definition {
      Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
      _ => match candidate.definition { Option<DefinitionId>.None => true _ => false } }
    let read = match witness.read { Option<ReadId>.Some {value} => match candidate.read {
      Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
      _ => match candidate.read { Option<ReadId>.None => true _ => false } }
    if sourceCell != candidate.sourceCell || sourceCell != recipe.sourceCell || candidate.map.index != map.index
      || key.value.index != candidate.source.index || key.leaf.index != candidate.leaf.index || key.category != candidate.category
      || key.direct != candidate.direct || !definition || !read || source.phase != ValuePhase.Output
      || source.evaluation.index != selected.operand.index || !inlineWithin(prepared, source.endpoint, root)
      || candidate.result != recipe.result || candidate.selection != recipe.selection
      || candidate.source.index != recipe.source.index || candidate.target.index != recipe.target.index || candidate.root.index != recipe.root.index
      || !sameOwnershipPlacement(candidate.placement, recipe.placement)
      || target.phase != ValuePhase.Output || target.evaluation.index != selected.result.index || target.endpoint.index != candidate.root.index
      || candidate.root.index != List<SelectionMap>.asSlice(&prepared.maps)[map.index].target.index {
      CompilerBug.panic(b"Field evidence changed its actual operand history or residual recipe")
    }
    let pair: [Value; 2] = [source, target]
    let mut each = usize.ZERO
    while each < pair.length {
      if let Option<ResidualSubject>.Some {..} = pair[each].subject { CompilerBug.panic(b"Field finish substituted a residual-subject Value") }
      if let Option<usize>.Some {..} = pair[each].summary { CompilerBug.panic(b"Field finish substituted canonical summary storage") }
      if let Option<usize>.Some {..} = pair[each].writeHolder { CompilerBug.panic(b"Field finish substituted a write holder") }
      each = each + usize.ONE
    }
    match candidate.origin {
      FieldResultSource.Physical => {
        let initial = OwnershipPlacement.Known {anchor: source.endpoint, suffix: Option<OwnershipSuffix>.none()}
        if key.category != SourceRole.Physical || !sameOwnershipPlacement(candidate.initial, initial) {
          CompilerBug.panic(b"Field physical evidence invented an ownership source placement")
        }
      }
      FieldResultSource.Publication {publication} => {
        if publication >= publications.length || publications[publication].cell != sourceCell
          || !sameOwnershipPlacement(publications[publication].placement, candidate.initial) {
          CompilerBug.panic(b"Field incoming evidence substituted another semantic publication")
        }
      }
    }
    validateOwnershipPlacement(prepared, List<ReferenceOrigin>.asSlice(&skeleton.references), values,
      List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions), candidate.initial)
    validateOwnershipPlacement(prepared, List<ReferenceOrigin>.asSlice(&skeleton.references), values,
      List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions), candidate.placement)
    let alternatives = run fieldResiduals(prepared, List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions), map, candidate.initial)
    let rows = List<FieldResidual>.asSlice(&alternatives)
    let mut found = false
    each = usize.ZERO
    while each < rows.length {
      let member = match candidate.member { Option<MapId>.Some {value} => match rows[each].member {
        Option<MapId>.Some {value: other} => value.index == other.index _ => false }
        _ => match rows[each].member { Option<MapId>.None => true _ => false } }
      if member && sameOwnershipPlacement(candidate.placement, rows[each].placement) { found = true }
      each = each + usize.ONE
    }
    if !found { CompilerBug.panic(b"Field residual has no frozen counterpart or original atomic offset") }
    at = at + usize.ONE
  }
  let transfers = List<Transfer>.asSlice(&skeleton.transfers)
  at = usize.ZERO
  while at < recipes.length {
    let recipe = recipes[at]
    let mut transfersFound = usize.ZERO
    let mut each = usize.ZERO
    while each < transfers.length {
      let transfer = &transfers[each]
      if let TransferAuthority.FieldResult {recipe: selected, sourceCell} = transfer.authority {
        if selected == at {
          transfersFound = transfersFound + usize.ONE
          if sourceCell != recipe.sourceCell || transfer.source.index != recipe.source.index || transfer.target.index != recipe.target.index
            || transfer.policy != TransferPolicy.Filtered || !transfer.terminal
            || transfer.directness != holdingDirectness(unknownOwnership(recipe.placement)) {
            CompilerBug.panic(b"Field recipe bypassed exact finish or directness")
          }
        }
      }
      each = each + usize.ONE
    }
    if transfersFound != usize.ONE { CompilerBug.panic(b"Field recipe has no unique primitive transfer") }
    at = at + usize.ONE
  }
  let policies = List<PendingPolicy>.asSlice(&domain.policies)
  at = usize.ZERO
  while at < policies.length {
    drop fieldResultPolicy(policies[at], cases, keys, witnesses, values, recipes)
    at = at + usize.ONE
  }
  return ()
}

// This classifier names one existing whole-call finish, not a declaration coverage decision.
// In particular its demand exists before any source cell or ordinary kept branch exists.
fn ordinaryResultOutput<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  operation: usize, result: usize) -> Option<MapId> {
  let actual = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[operation]
  let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[actual.prepared]
  let use = &List<ResultUse>.asSlice(&skeleton.results)[result]
  if actual.evaluation.index != use.evaluation.index || row.phase != PreparedOperationPhase.Invoke {
    return Option<MapId>.none()
  }
  if !match use.kind { ResultKind.Declared => true _ => false } { return Option<MapId>.none() }
  let output = match &actual.plan { ResultsPlan.NamedInvoke {result: resultMap, ..} => resultMap
    _ => { return Option<MapId>.none() } }
  let ordinary = match &prepared.body.nodes[row.site.index].kind {
    NodeKind.Expression {form: Expression.DirectCall {constructs, ..}, ..} => !constructs
    NodeKind.Expression {form: Expression.InterfaceCall {isEffect, ..}, ..} => !isEffect
    _ => false
  }
  if !ordinary { return Option<MapId>.none() }
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let exact = match row.result { Option<MapId>.Some {value} => value.index == output.index _ => false }
  if !exact || output.index >= maps.length { return CompilerBug.panic(b"ordinary result changed its original root map") }
  let target = &endpoints[maps[output.index].target.index]
  let whole = match target.parent { Option<EndpointId>.None => true _ => false }
  let site = match target.root { Root.Node {node, category} => node.index == row.site.index && category == EndpointRole.Value _ => false }
  if !whole || !site { return CompilerBug.panic(b"ordinary result substituted a selected output for its whole finish") }
  return Option<MapId>.some(output)
}

fn validateOrdinaryResultDemand<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  demand: OrdinaryResultDemand) -> () {
  if demand.operation >= List<Results.Operation>.length(&skeleton.operationResults.operations)
    || demand.result >= List<ResultUse>.length(&skeleton.results) {
    CompilerBug.panic(b"ordinary demand lost its actual operation or finish directive")
  }
  let output = match ordinaryResultOutput(prepared, skeleton, demand.operation, demand.result) {
    Option<MapId>.Some {value} => value
    _ => { return CompilerBug.panic(b"ordinary demand has no nonstoring NamedInvoke finish") }
  }
  let actual = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
  if demand.output.index != output.index || demand.evaluation.index != actual.evaluation.index
    || demand.root.index != List<SelectionMap>.asSlice(&prepared.maps)[output.index].target.index {
    CompilerBug.panic(b"ordinary demand changed its whole operation occurrence")
  }
  return ()
}

fn validateOrdinaryResultCandidate<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  candidate: OrdinaryResultCandidate) -> () {
  if candidate.demand >= List<OrdinaryResultDemand>.length(&skeleton.ordinaryResultDemands) {
    CompilerBug.panic(b"ordinary candidate lost its independent whole-call demand")
  }
  let demand = List<OrdinaryResultDemand>.asSlice(&skeleton.ordinaryResultDemands)[candidate.demand]
  validateOrdinaryResultDemand(prepared, skeleton, demand)
  let actual = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
  let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[actual.prepared]
  let inputs = List<Results.Input>.asSlice(&actual.inputs)
  let routes = List<InputRoute>.asSlice(&row.inputs)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let values = List<Value>.asSlice(&skeleton.values)
  if candidate.input >= inputs.length || candidate.route >= routes.length || candidate.sourceMap.index >= maps.length
    || candidate.source.index >= values.length || candidate.target.index >= values.length {
    CompilerBug.panic(b"ordinary candidate changed its actual input member or values")
  }
  let input = inputs[candidate.input]
  let route = &routes[candidate.route]
  let map = &maps[candidate.sourceMap.index]
  let family = &maps[route.map.index]
  let source = values[candidate.source.index]
  let target = values[candidate.target.index]
  let operand = inputOperand(prepared, row.site, route.read)
  let read = match input.actual.read { Option<InputRead>.Some {value} => value
    _ => { return CompilerBug.panic(b"ordinary result input lost its authored read") } }
  let sources = List<EvalId>.asSlice(&List<ResultUse>.asSlice(&skeleton.results)[demand.result].sources)
  let mut observed = false
  let mut each = usize.ZERO
  while each < sources.length {
    if sources[each].index == input.actual.evaluation.index { observed = true }
    each = each + usize.ONE
  }
  let sourceNode = match endpoints[family.source.index].root {
    Root.Node {node, category} => node.index == operand.index && category == EndpointRole.Value _ => false }
  let root = match endpoints[family.source.index].parent { Option<EndpointId>.None => true _ => false }
  if input.route != candidate.route || input.position != candidate.position || input.actual.node.index != operand.index
    || !sameInputRead(read, route.read) || !observed
    || input.actual.evaluation.index != candidate.operand.index || input.actual.usePoint.index != candidate.usePoint.index
    || !Results.inFamily(maps, route.map, candidate.sourceMap) || route.transport != Transport.Evaluated
    || family.site.index != row.site.index || family.kind != MapKind.Select || family.source.index != family.target.index || !sourceNode || !root
    || !match &family.selector { Selector.Identity => true _ => false }
    || map.kind != MapKind.Select || map.site.index != row.site.index || map.source.index != map.target.index
    || map.componentTransport || map.addressTransport
    || !match &map.selector { Selector.Identity => true _ => false }
    || source.phase != ValuePhase.Output || source.evaluation.index != candidate.operand.index || source.endpoint.index != map.source.index
    || target.phase != ValuePhase.Output || target.evaluation.index != demand.evaluation.index || target.endpoint.index != demand.root.index
    || candidate.root.index != demand.root.index {
    CompilerBug.panic(b"ordinary candidate replaced its evaluated identity family or whole result")
  }
  if let Option<ApplicationId>.Some {..} = map.application { CompilerBug.panic(b"ordinary input member substituted a declaration map") }
  if let Option<MapId>.Some {..} = route.referent { CompilerBug.panic(b"ordinary candidate fabricated an acquisition input") }
  // Actual selected source Values retain their primitive subject identity; no residual is
  // interpreted as physical provenance. The output alone is deliberately whole.
  if let Option<ResidualSubject>.Some {..} = target.subject { CompilerBug.panic(b"ordinary result acquired a selected output") }
  let pair: [Value; 2] = [source, target]
  let mut at = usize.ZERO
  while at < pair.length {
    if let Option<usize>.Some {..} = pair[at].summary { CompilerBug.panic(b"ordinary result substituted a canonical summary") }
    if let Option<usize>.Some {..} = pair[at].writeHolder { CompilerBug.panic(b"ordinary result substituted a write-holder snapshot") }
    at = at + usize.ONE
  }
  return ()
}

// The fixed demand inventory and actual input identity families bound this product. Late
// operand Values may add candidates, but no result history creates another input recipe.
effect fn closeOrdinaryResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let beforeDemands = List<OrdinaryResultDemand>.length(&skeleton.ordinaryResultDemands)
  let before = List<OrdinaryResultCandidate>.length(&skeleton.ordinaryResultCandidates)
  let operationCount = List<Results.Operation>.length(&skeleton.operationResults.operations)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let resultCount = List<ResultUse>.length(&skeleton.results)
  let valueCount = List<Value>.length(&skeleton.values)
  let mut operation = usize.ZERO
  while operation < operationCount {
    let evaluation = List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[operation].evaluation
    let execute = List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[operation].execute
    let preparedOperation = List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[operation].prepared
    let mut inputCopies = List<Results.Input>.make()
    let actualInputs = List<Results.Input>.asSlice(&List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[operation].inputs)
    let mut copied = usize.ZERO
    while copied < actualInputs.length {
      run List<Results.Input>.append(&mut inputCopies, actualInputs[copied])
      copied = copied + usize.ONE
    }
    let inputs = List<Results.Input>.asSlice(&inputCopies)
    let mut result = usize.ZERO
    while result < resultCount {
      if let Option<MapId>.Some {value: output} = ordinaryResultOutput(prepared, &skeleton.*, operation, result) {
        let demands = List<OrdinaryResultDemand>.asSlice(&skeleton.ordinaryResultDemands)
        let mut demand = usize.ZERO
        while demand < demands.length {
          if demands[demand].operation == operation && demands[demand].result == result { break }
          demand = demand + usize.ONE
        }
        let root = maps[output.index].target
        if demand == demands.length {
          let applicable = Program.atom(&mut skeleton.rules)
          let resultPoint = Skeleton.evaluation(&skeleton.*, evaluation).point
          let admitted: [Atom; 3] = [List<ResultUse>.asSlice(&skeleton.results)[result].active,
            Flow.reachable(&skeleton.flow, execute), Flow.reachable(&skeleton.flow, resultPoint)]
          run Program.rule(&mut skeleton.rules, applicable, &admitted, &[])
          let completion = Program.atom(&mut skeleton.rules)
          run List<OrdinaryResultDemand>.append(&mut skeleton.ordinaryResultDemands, OrdinaryResultDemand {
            operation: operation, result: result, evaluation: evaluation, output: output, root: root,
            applicable: applicable, completion: completion})
        }
        let applicable = List<OrdinaryResultDemand>.asSlice(&skeleton.ordinaryResultDemands)[demand].applicable
        let target = run Skeleton.value(&mut skeleton.*, evaluation, root)
        let row = &List<Prepared.Operation>.asSlice(&prepared.operations)[preparedOperation]
        let routes = List<InputRoute>.asSlice(&row.inputs)
        let mut input = usize.ZERO
        while input < inputs.length {
          let selected = inputs[input]
          let family = run Results.mapFamily(maps, routes[selected.route].map)
          let members = List<MapId>.asSlice(&family)
          let mut member = usize.ZERO
          while member < members.length {
            let sourceMap = members[member]
            let mut source = usize.ZERO
            while source < valueCount {
              let value = List<Value>.asSlice(&skeleton.values)[source]
              let actualValue = match value.summary { Option<usize>.None => true _ => false }
                && match value.writeHolder { Option<usize>.None => true _ => false }
              if actualValue && value.phase == ValuePhase.Output && value.evaluation.index == selected.actual.evaluation.index
                && value.endpoint.index == maps[sourceMap.index].source.index {
                let prior = List<OrdinaryResultCandidate>.asSlice(&skeleton.ordinaryResultCandidates)
                let mut candidate = usize.ZERO
                while candidate < prior.length {
                  if prior[candidate].demand == demand && prior[candidate].input == input
                    && prior[candidate].sourceMap.index == sourceMap.index && prior[candidate].source.index == source { break }
                  candidate = candidate + usize.ONE
                }
                if candidate == prior.length {
                  let active = run addressApplies(&mut skeleton.rules, applicable, Flow.reachable(&skeleton.flow, selected.actual.usePoint))
                  let sourceValue = ValueId {index: source}
                  let original = OrdinaryResultCandidate {demand: demand, input: input, position: selected.position,
                    route: selected.route, sourceMap: sourceMap, operand: selected.actual.evaluation, usePoint: selected.actual.usePoint,
                    source: sourceValue, target: target, root: root, active: active}
                  validateOrdinaryResultCandidate(prepared, &skeleton.*, original)
                  run List<OrdinaryResultCandidate>.append(&mut skeleton.ordinaryResultCandidates, original)
                  let absent = Program.atom(&mut skeleton.rules)
                  run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: sourceValue, target: target,
                    active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
                    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Filtered,
                    terminal: false, authority: TransferAuthority.OrdinaryResult {candidate: candidate}})
                }
              }
              source = source + usize.ONE
            }
            member = member + usize.ONE
          }
          input = input + usize.ONE
        }
      }
      result = result + usize.ONE
    }
    operation = operation + usize.ONE
  }
  return beforeDemands != List<OrdinaryResultDemand>.length(&skeleton.ordinaryResultDemands)
    || before != List<OrdinaryResultCandidate>.length(&skeleton.ordinaryResultCandidates)
}

fn validateOrdinaryResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let demands = List<OrdinaryResultDemand>.asSlice(&skeleton.ordinaryResultDemands)
  let candidates = List<OrdinaryResultCandidate>.asSlice(&skeleton.ordinaryResultCandidates)
  let transfers = List<Transfer>.asSlice(&skeleton.transfers)
  let mut at = usize.ZERO
  while at < demands.length { validateOrdinaryResultDemand(prepared, skeleton, demands[at]) at = at + usize.ONE }
  at = usize.ZERO
  while at < candidates.length { validateOrdinaryResultCandidate(prepared, skeleton, candidates[at]) at = at + usize.ONE }
  at = usize.ZERO
  while at < transfers.length {
    let transfer = &transfers[at]
    if let TransferAuthority.OrdinaryResult {candidate} = transfer.authority {
      if candidate >= candidates.length { CompilerBug.panic(b"ordinary result transfer lost its actual candidate") }
      let original = candidates[candidate]
      if transfer.source.index != original.source.index || transfer.target.index != original.target.index
        || transfer.policy != TransferPolicy.Filtered || !transfer.terminal || transfer.directness != Directness.Indirect {
        CompilerBug.panic(b"ordinary result bypassed its exact whole-finish policy")
      }
      if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"ordinary result replaced its source definition") }
      if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"ordinary result replaced its source read witness") }
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn closeRvalueDereferenceResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let beforeValues = List<RvalueDereferenceValue>.length(&skeleton.rvalueDereferenceValues)
  let before = List<RvalueDereferenceResult>.length(&skeleton.rvalueDereferenceResults)
  let resultCount = List<ResultUse>.length(&skeleton.results)
  let selectionCount = List<SelectionUse>.length(&skeleton.selections)
  let valueCount = List<Value>.length(&skeleton.values)
  let mut result = usize.ZERO
  while result < resultCount {
    let mut selection = usize.ZERO
    while selection < selectionCount {
      if let Option<MapId>.Some {value: map} = rvalueDereferenceSelection(prepared, &skeleton.*, result, selection) {
        let selected = &List<SelectionUse>.asSlice(&skeleton.selections)[selection]
        run validateSelectionUse(prepared, selected, List<Evaluation>.asSlice(&skeleton.evaluations))
        let operand = selected.operand
        let selectionActive = selected.active
        let inputRoot = List<Selection>.asSlice(&prepared.selections)[selected.selection.index].root
        let evaluation = List<ResultUse>.asSlice(&skeleton.results)[result].evaluation
        let resultActive = List<ResultUse>.asSlice(&skeleton.results)[result].active
        let root = List<SelectionMap>.asSlice(&prepared.maps)[map.index].target
        let target = run Skeleton.value(&mut skeleton.*, evaluation, root)
        run reserveRvalueDereferenceValue(prepared, &mut skeleton.*, result, selection, target)
        let mut source = usize.ZERO
        while source < valueCount {
          let value = List<Value>.asSlice(&skeleton.values)[source]
          let physical = match value.subject { Option<ResidualSubject>.None => true _ => false }
            && match value.summary { Option<usize>.None => true _ => false }
            && match value.writeHolder { Option<usize>.None => true _ => false }
          if physical && value.phase == ValuePhase.Output && value.evaluation.index == operand.index
            && inlineWithin(prepared, value.endpoint, inputRoot) {
            let prior = List<RvalueDereferenceResult>.asSlice(&skeleton.rvalueDereferenceResults)
            let mut candidate = usize.ZERO
            while candidate < prior.length {
              if prior[candidate].result == result && prior[candidate].selection == selection && prior[candidate].source.index == source { break }
              candidate = candidate + usize.ONE
            }
            if candidate == prior.length {
              let active = Program.atom(&mut skeleton.rules)
              let point = Skeleton.evaluation(&skeleton.*, evaluation).point
              let reached = Flow.reservedPoints(&skeleton.flow)[point.index].reachable
              let admitted: [Atom; 3] = [selectionActive, resultActive, reached]
              run Program.rule(&mut skeleton.rules, active, &admitted, &[])
              let sourceValue = ValueId {index: source}
              run List<RvalueDereferenceResult>.append(&mut skeleton.rvalueDereferenceResults, RvalueDereferenceResult {
                result: result, selection: selection, source: sourceValue, target: target, root: root, active: active})
              let absent = Program.atom(&mut skeleton.rules)
              run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: sourceValue, target: target,
                active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
                definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Filtered,
                terminal: false, authority: TransferAuthority.RvalueDereferenceResult {candidate: candidate}})
            }
          }
          source = source + usize.ONE
        }
      }
      selection = selection + usize.ONE
    }
    result = result + usize.ONE
  }
  return beforeValues != List<RvalueDereferenceValue>.length(&skeleton.rvalueDereferenceValues)
    || before != List<RvalueDereferenceResult>.length(&skeleton.rvalueDereferenceResults)
}

fn validateRvalueDereferenceResult<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  candidate: RvalueDereferenceResult) -> () {
  let map = match rvalueDereferenceSelection(prepared, skeleton, candidate.result, candidate.selection) {
    Option<MapId>.Some {value} => value _ => { return CompilerBug.panic(b"rvalue dereference has no actual operand finish authority") } }
  let selected = &List<SelectionUse>.asSlice(&skeleton.selections)[candidate.selection]
  let use = &List<ResultUse>.asSlice(&skeleton.results)[candidate.result]
  let root = List<Selection>.asSlice(&prepared.selections)[selected.selection.index].root
  let source = List<Value>.asSlice(&skeleton.values)[candidate.source.index]
  let target = List<Value>.asSlice(&skeleton.values)[candidate.target.index]
  if source.phase != ValuePhase.Output || source.evaluation.index != selected.operand.index
    || !inlineWithin(prepared, source.endpoint, root) || target.phase != ValuePhase.Output
    || target.evaluation.index != use.evaluation.index || target.endpoint.index != candidate.root.index
    || candidate.root.index != List<SelectionMap>.asSlice(&prepared.maps)[map.index].target.index {
    CompilerBug.panic(b"rvalue dereference changed its original operand or actual result")
  }
  let pair: [Value; 2] = [source, target]
  let mut at = usize.ZERO
  while at < pair.length {
    if let Option<ResidualSubject>.Some {..} = pair[at].subject { CompilerBug.panic(b"rvalue dereference substituted a selected value") }
    if let Option<usize>.Some {..} = pair[at].summary { CompilerBug.panic(b"rvalue dereference substituted a canonical summary") }
    if let Option<usize>.Some {..} = pair[at].writeHolder { CompilerBug.panic(b"rvalue dereference substituted a write holder") }
    at = at + usize.ONE
  }
  return ()
}

fn validateRvalueDereferenceResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let candidates = List<RvalueDereferenceResult>.asSlice(&skeleton.rvalueDereferenceResults)
  let transfers = List<Transfer>.asSlice(&skeleton.transfers)
  let mut at = usize.ZERO
  while at < candidates.length { validateRvalueDereferenceResult(prepared, skeleton, candidates[at]) at = at + usize.ONE }
  at = usize.ZERO
  while at < transfers.length {
    let transfer = &transfers[at]
    if let TransferAuthority.RvalueDereferenceResult {candidate} = transfer.authority {
      if candidate >= candidates.length { CompilerBug.panic(b"rvalue dereference transfer lost its original candidate") }
      let original = candidates[candidate]
      if transfer.source.index != original.source.index || transfer.target.index != original.target.index
        || transfer.policy != TransferPolicy.Filtered || !transfer.terminal || transfer.directness != Directness.Indirect {
        CompilerBug.panic(b"rvalue dereference transfer bypassed its exact finish policy")
      }
      if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"rvalue dereference replaced its original definition") }
      if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"rvalue dereference replaced its original read witness") }
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn closeThroughResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<ThroughResultCandidate>.length(&skeleton.throughResultCandidates)
  let readsCount = List<ThroughFlightRead>.length(&skeleton.throughFlightReads)
  let summariesCount = List<SummaryRead>.length(&skeleton.summaryReads)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut reading = usize.ZERO
  while reading < readsCount {
    let flight = List<ThroughFlightRead>.asSlice(&skeleton.throughFlightReads)[reading]
    let observation = List<ThroughFlightObservation>.asSlice(&skeleton.throughFlightObservations)[flight.observation]
    let request = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)[observation.request]
    if request.kind == ThroughFlightKind.Read {
      if let Option<Atom>.Some {value: use} = throughResultUse(&skeleton.*, request) {
        let site = match Skeleton.evaluation(&skeleton.*, request.operation).site { EvaluationSite.Node {node} => node
          _ => { return CompilerBug.panic(b"through result lost its actual replacement") } }
        let mut root = usize.MAX
        let mut each = usize.ZERO
        while each < endpoints.length {
          let actual = match endpoints[each].root { Root.Node {node, category} => node.index == site.index && category == EndpointRole.Value _ => false }
          if actual && match endpoints[each].parent { Option<EndpointId>.None => true _ => false } {
            if root != usize.MAX { CompilerBug.panic(b"through result repeats its actual whole root") }
            root = each
          }
          each = each + usize.ONE
        }
        if root == usize.MAX { CompilerBug.panic(b"through result has no actual whole root") }
        let outputRoot = EndpointId {index: root}
        let target = run Skeleton.value(&mut skeleton.*, request.operation, outputRoot)
        // The first alternative is the actual physical current read. Remaining alternatives
        // are its exact root-only summaries, never a conversion/acquisition snapshot.
        each = usize.ZERO
        while each <= summariesCount {
          let mut summary = Option<usize>.none()
          let mut source = flight.value
          let mut read = flight.read
          let mut gate = flight.active
          if each < summariesCount {
            if List<SummaryRead>.asSlice(&skeleton.summaryReads)[each].original.index != flight.read.index { each = each + usize.ONE continue }
            if !sameStorage(flight.storage, observation.owner) { CompilerBug.panic(b"through summary escaped its whole-owner read") }
            summary = Option<usize>.some(each)
            source = List<SummaryRead>.asSlice(&skeleton.summaryReads)[each].target
            read = List<SummaryRead>.asSlice(&skeleton.summaryReads)[each].read
            gate = List<SummaryRead>.asSlice(&skeleton.summaryReads)[each].active
          }
          let prior = List<ThroughResultCandidate>.asSlice(&skeleton.throughResultCandidates)
          let mut found = false
          let mut at = usize.ZERO
          while at < prior.length {
            let same = match summary {
              Option<usize>.Some {value} => match prior[at].summary { Option<usize>.Some {value: other} => value == other _ => false }
              _ => match prior[at].summary { Option<usize>.None => true _ => false }
            }
            if prior[at].reading == reading && same { found = true }
            at = at + usize.ONE
          }
          if !found {
            let candidate = prior.length
            let active = Program.atom(&mut skeleton.rules)
            let admitted: [Atom; 3] = [flight.active, gate, use]
            run Program.rule(&mut skeleton.rules, active, &admitted, &[])
            run List<ThroughResultCandidate>.append(&mut skeleton.throughResultCandidates, ThroughResultCandidate {
              request: observation.request, observation: flight.observation, reading: reading, summary: summary,
              read: read, source: source, target: target, root: outputRoot, active: active})
            let absent = Program.atom(&mut skeleton.rules)
            run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: source, target: target,
              active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
              definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Filtered,
              terminal: false, authority: TransferAuthority.ThroughResult {candidate: candidate, read: read}})
          }
          each = each + usize.ONE
        }
      }
    }
    reading = reading + usize.ONE
  }
  return before != List<ThroughResultCandidate>.length(&skeleton.throughResultCandidates)
}

fn validateThroughResultCandidate<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  candidate: ThroughResultCandidate) -> () {
  let requests = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)
  let observations = List<ThroughFlightObservation>.asSlice(&skeleton.throughFlightObservations)
  let reads = List<ThroughFlightRead>.asSlice(&skeleton.throughFlightReads)
  if candidate.request >= requests.length || candidate.observation >= observations.length || candidate.reading >= reads.length {
    CompilerBug.panic(b"through result lost its exact read-flight authority")
  }
  let request = requests[candidate.request]
  let observation = observations[candidate.observation]
  let read = reads[candidate.reading]
  validateThroughFlightRequest(prepared, skeleton, request)
  if request.kind != ThroughFlightKind.Read || observation.request != candidate.request || read.observation != candidate.observation {
    CompilerBug.panic(b"through result substituted the later write flight")
  }
  if let Option<Atom>.None = throughResultUse(skeleton, request) { CompilerBug.panic(b"through result has no actual displaced finish directive") }
  let source = List<Value>.asSlice(&skeleton.values)[candidate.source.index]
  let target = List<Value>.asSlice(&skeleton.values)[candidate.target.index]
  if source.evaluation.index != request.evaluation.index || source.phase != ValuePhase.Input
    || target.evaluation.index != request.operation.index || target.phase != ValuePhase.Output
    || target.endpoint.index != candidate.root.index {
    CompilerBug.panic(b"through result changed its current read or successful result occurrence")
  }
  let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[candidate.root.index]
  let site = match Skeleton.evaluation(skeleton, request.operation).site { EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"through result lost its operation site") } }
  let exact = match endpoint.root { Root.Node {node, category} => node.index == site.index && category == EndpointRole.Value _ => false }
  if !exact || match endpoint.parent { Option<EndpointId>.Some {..} => true _ => false }
    || match target.subject { Option<ResidualSubject>.Some {..} => true _ => false }
    || match target.summary { Option<usize>.Some {..} => true _ => false }
    || match target.writeHolder { Option<usize>.Some {..} => true _ => false } {
    CompilerBug.panic(b"through result promoted a selected component or summary to whole")
  }
  match candidate.summary {
    Option<usize>.None => {
      if candidate.source.index != read.value.index || candidate.read.index != read.read.index {
        CompilerBug.panic(b"through result changed its original physical read")
      }
    }
    Option<usize>.Some {value} => {
      let summaries = List<SummaryRead>.asSlice(&skeleton.summaryReads)
      if value >= summaries.length || summaries[value].original.index != read.read.index
        || summaries[value].target.index != candidate.source.index || summaries[value].read.index != candidate.read.index
        || !sameStorage(read.storage, observation.owner) {
        CompilerBug.panic(b"through result changed its original whole-owner summary read")
      }
    }
  }
  return ()
}

fn validateThroughResults<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let candidates = List<ThroughResultCandidate>.asSlice(&skeleton.throughResultCandidates)
  let transfers = List<Transfer>.asSlice(&skeleton.transfers)
  let mut at = usize.ZERO
  while at < candidates.length { validateThroughResultCandidate(prepared, skeleton, candidates[at]) at = at + usize.ONE }
  at = usize.ZERO
  while at < transfers.length {
    let transfer = &transfers[at]
    if let TransferAuthority.ThroughResult {candidate, read} = transfer.authority {
      if candidate >= candidates.length { CompilerBug.panic(b"through result transfer lost its original candidate") }
      let original = candidates[candidate]
      if transfer.source.index != original.source.index || transfer.target.index != original.target.index
        || read.index != original.read.index || transfer.policy != TransferPolicy.Filtered
        || !transfer.terminal || transfer.directness != Directness.Indirect {
        CompilerBug.panic(b"through result transfer changed its exact finish authority")
      }
      if let Option<DefinitionId>.Some {..} = transfer.definition { CompilerBug.panic(b"through result replaced its original definition") }
      if let Option<ReadId>.Some {..} = transfer.read { CompilerBug.panic(b"through result replaced its original read witness") }
    }
    at = at + usize.ONE
  }
  return ()
}

// Completeness is separate from positive alternatives. In particular, one canonical
// alias cannot discharge a different descriptor-selection or address proof's missing gate.
effect fn sealThroughFlightCoverage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  addresses: &AddressProofCoverage) -> () ! OutOfMemoryError ? &mut Allocator {
  let requests = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)
  let observations = List<ThroughFlightObservation>.asSlice(&skeleton.throughFlightObservations)
  let coverage = List<ThroughFlightCoverage>.asSlice(&skeleton.throughFlightCoverage)
  let reads = List<ThroughFlightRead>.asSlice(&skeleton.throughFlightReads)
  let aliasMissing = List<Atom>.asSlice(&addresses.aliases)
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let selectionCoverage = List<AddressCoverage>.asSlice(&addresses.requests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let mut request = usize.ZERO
  while request < requests.length {
    let actual = requests[request]
    let present = Program.atom(&mut skeleton.rules)
    let mut observation = usize.ZERO
    while observation < observations.length {
      let selected = observations[observation]
      if selected.request == request {
        let gate: [Atom; 1] = [selected.active]
        run Program.rule(&mut skeleton.rules, present, &gate, &[])
        let missing = coverage[observation].missing
        let failed: [Atom; 2] = [selected.active, aliasMissing[selected.alias]]
        run Program.rule(&mut skeleton.rules, missing, &failed, &[])
        let propagate: [Atom; 2] = [selected.active, missing]
        run Program.rule(&mut skeleton.rules, actual.missing, &propagate, &[])
        let components = run referenceOwnerComponents(prepared, selected.owner)
        let componentsSelected = List<EndpointId>.asSlice(&components)
        let mut component = usize.ZERO
        while component < componentsSelected.length {
          let retained = Program.atom(&mut skeleton.rules)
          let mut at = usize.ZERO
          while at < reads.length {
            if reads[at].observation == observation && reads[at].storage.endpoint.index == componentsSelected[component].index {
              let gate: [Atom; 1] = [reads[at].active]
              run Program.rule(&mut skeleton.rules, retained, &gate, &[])
            }
            at = at + usize.ONE
          }
          let gate: [Atom; 1] = [selected.active]
          let absent: [Atom; 1] = [retained]
          run Program.rule(&mut skeleton.rules, missing, &gate, &absent)
          component = component + usize.ONE
        }
        let mut summary = usize.ZERO
        while summary < summaries.length {
          if sameTemporary(summaries[summary].prefix.temporary, selected.owner.temporary)
            && inlineWithin(prepared, summaries[summary].prefix.endpoint, selected.owner.endpoint) {
            let retained = Program.atom(&mut skeleton.rules)
            let mut at = usize.ZERO
            while at < reads.length {
              if reads[at].observation == observation && sameStorage(reads[at].storage, selected.owner) {
                let mut each = usize.ZERO
                while each < summaryReads.length {
                  if summaryReads[each].original.index == reads[at].read.index && summaryReads[each].summary == summary {
                    let gate: [Atom; 2] = [reads[at].active, summaryReads[each].active]
                    run Program.rule(&mut skeleton.rules, retained, &gate, &[])
                  }
                  each = each + usize.ONE
                }
              }
              at = at + usize.ONE
            }
            let gate: [Atom; 1] = [selected.active]
            let absent: [Atom; 1] = [retained]
            run Program.rule(&mut skeleton.rules, missing, &gate, &absent)
          }
          summary = summary + usize.ONE
        }
      }
      observation = observation + usize.ONE
    }
    let gate: [Atom; 1] = [actual.active]
    let absent: [Atom; 1] = [present]
    run Program.rule(&mut skeleton.rules, actual.missing, &gate, &absent)
    if let Option<ThroughDescriptor>.Some {value: descriptor} = actual.descriptor {
      let mut at = usize.ZERO
      while at < selections.length {
        if selections[at].result.index == descriptor.evaluation.index {
          if let Option<MapId>.Some {value: place} = selections[at].place {
            if maps[place.index].target.index == descriptor.root.index {
              let failed: [Atom; 2] = [actual.active, selectionCoverage[at].missing]
              run Program.rule(&mut skeleton.rules, actual.missing, &failed, &[])
              observation = usize.ZERO
              while observation < observations.length {
                if observations[observation].request == request {
                  let failed: [Atom; 2] = [observations[observation].active, selectionCoverage[at].missing]
                  run Program.rule(&mut skeleton.rules, coverage[observation].missing, &failed, &[])
                }
                observation = observation + usize.ONE
              }
            }
          }
        }
        at = at + usize.ONE
      }
    }
    request = request + usize.ONE
  }
  return ()
}

effect fn validateThroughFlights<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> ()
! OutOfMemoryError ? &mut Allocator {
  let requests = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)
  let observations = List<ThroughFlightObservation>.asSlice(&skeleton.throughFlightObservations)
  let coverage = List<ThroughFlightCoverage>.asSlice(&skeleton.throughFlightCoverage)
  let reads = List<ThroughFlightRead>.asSlice(&skeleton.throughFlightReads)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let values = List<Value>.asSlice(&skeleton.values)
  let recorded = List<ReadValue>.asSlice(&skeleton.reads)
  let points = Flow.reservedReads(&skeleton.flow)
  if coverage.length != observations.length { CompilerBug.panic(b"through flight lost per-alias coverage") }
  let mut at = usize.ZERO
  while at < requests.length {
    validateThroughFlightRequest(prepared, skeleton, requests[at])
    if requests[at].kind == ThroughFlightKind.Read
      && Skeleton.evaluation(skeleton, requests[at].evaluation).category == EvaluationRole.Replacement {
      let mut paired = false
      let mut each = usize.ZERO
      while each < requests.length {
        if requests[each].operation.index == requests[at].operation.index && requests[each].kind == ThroughFlightKind.Write {
          if requests[each].target.index != requests[at].target.index
            || Skeleton.evaluation(skeleton, requests[each].evaluation).point.index == Skeleton.evaluation(skeleton, requests[at].evaluation).point.index {
            CompilerBug.panic(b"through replacement collapsed its read and write occurrences")
          }
          paired = true
        }
        each = each + usize.ONE
      }
      if !paired { CompilerBug.panic(b"through displaced read omitted its actual write") }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < observations.length {
    let selected = observations[at]
    if selected.request >= requests.length || selected.alias >= aliases.length || coverage[at].observation != at {
      CompilerBug.panic(b"through observation lost its actual request or alias")
    }
    let descriptor = match requests[selected.request].descriptor { Option<ThroughDescriptor>.Some {value} => value
      _ => { return CompilerBug.panic(b"unresolved through request invented a descriptor owner") } }
    let alias = aliases[selected.alias]
    if alias.evaluation.index != descriptor.evaluation.index || alias.endpoint.index != descriptor.root.index
      || !sameStorage(selected.storage, alias.storage)
      || selected.owner.endpoint.index != storageOwner(prepared, selected.storage.endpoint).index
      || !sameTemporary(selected.owner.temporary, selected.storage.temporary) {
      CompilerBug.panic(b"through observation substituted the final destination owner")
    }
    let components = run referenceOwnerComponents(prepared, selected.owner)
    let componentsSelected = List<EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < componentsSelected.length {
      let mut count = usize.ZERO
      let mut each = usize.ZERO
      while each < reads.length {
        if reads[each].observation == at && reads[each].storage.endpoint.index == componentsSelected[component].index { count = count + usize.ONE }
        each = each + usize.ONE
      }
      if count != usize.ONE { CompilerBug.panic(b"through flight omitted or duplicated an original owner component") }
      component = component + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.observation >= observations.length || read.read.index >= recorded.length || read.value.index >= values.length {
      CompilerBug.panic(b"through flight lost its current canonical Input")
    }
    let selected = observations[read.observation]
    let request = requests[selected.request]
    let value = values[read.value.index]
    let original = recorded[read.read.index]
    if value.phase != ValuePhase.Input || value.evaluation.index != request.evaluation.index
      || value.endpoint.index != read.storage.endpoint.index || original.value.index != read.value.index
      || !sameStorage(original.storage, read.storage) || !Atom.same(read.active, selected.active)
      || points[read.read.index].point.index != Skeleton.evaluation(skeleton, request.evaluation).point.index
      || !sameTemporary(read.storage.temporary, selected.owner.temporary)
      || !inlineWithin(prepared, read.storage.endpoint, selected.owner.endpoint)
      || match original.summary { Option<usize>.Some {..} => true _ => false }
      || match original.map { Option<MapId>.Some {..} => true _ => false } {
      CompilerBug.panic(b"through flight changed its component, action point or current read authority")
    }
    at = at + usize.ONE
  }
  return ()
}

fn readFlightMatches(observation: ReadFlightObservation, placement: ReadPlacement) -> bool {
  let alias = match observation.alias {
    Option<usize>.Some {value} => match placement.alias { Option<usize>.Some {value: other} => value == other _ => false }
    _ => match placement.alias { Option<usize>.None => true _ => false }
  }
  return alias && observation.original.index == placement.original.index
    && observation.consumer.index == placement.consumer.index && observation.map.index == placement.map.index
}

fn readFlightSummaryRoot(skeleton: &Skeleton, read: ReadId) -> bool {
  let reads = List<ReadFlightRead>.asSlice(&skeleton.readFlightReads)
  let observations = List<ReadFlightObservation>.asSlice(&skeleton.readFlightObservations)
  let mut selected = false
  let mut at = usize.ZERO
  while at < reads.length {
    if reads[at].read.index == read.index {
      selected = true
      if sameStorage(reads[at].storage, observations[reads[at].observation].owner) { return true }
    }
    at = at + usize.ONE
  }
  return !selected
}

fn readFlightRequested(skeleton: &Skeleton, evaluation: EvalId) -> bool {
  let results = List<ResultUse>.asSlice(&skeleton.results)
  let mut at = usize.ZERO
  while at < results.length {
    if let ResultKind.Read {read} = results[at].kind {
      if read.index == evaluation.index { return true }
    }
    at = at + usize.ONE
  }
  return false
}

// Only genuine mapped reads create requests. Newly reserved owner Inputs have no Copy
// map/transport, so they cannot recursively create more observations. Late alias consumers
// are revisited after the same read-result normalization as ordinary attribution.
effect fn reserveReadFlights<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<ReadFlightObservation>.length(&skeleton.readFlightObservations)
  let count = List<ReadValue>.length(&skeleton.reads)
  let mut original = usize.ZERO
  while original < count {
    let recorded = List<ReadValue>.asSlice(&skeleton.reads)[original]
    let evaluation = List<Value>.asSlice(&skeleton.values)[recorded.value.index].evaluation
    if !readFlightRequested(&skeleton.*, evaluation) { original = original + usize.ONE continue }
    if let Option<usize>.None = recorded.summary {
      let placements = run readPlacementsByRead(prepared, Flow.reservedReads(&skeleton.flow), Flow.reservedPoints(&skeleton.flow),
        List<Storage>.asSlice(&skeleton.storage), List<ReadValue>.asSlice(&skeleton.reads),
        List<Value>.asSlice(&skeleton.values), List<Evaluation>.asSlice(&skeleton.evaluations),
        List<StorageAlias>.asSlice(&skeleton.aliases), List<AliasTransport>.asSlice(&skeleton.aliasTransports),
        List<AliasRead>.asSlice(&skeleton.aliasReads), List<SummaryRead>.asSlice(&skeleton.summaryReads), recorded.read)
      let placementsSelected = List<ReadPlacement>.asSlice(&placements)
      let mut at = usize.ZERO
      while at < placementsSelected.length {
        let placement = placementsSelected[at]
        let previous = List<ReadFlightObservation>.asSlice(&skeleton.readFlightObservations)
        let mut found = false
        let mut each = usize.ZERO
        while each < previous.length {
          if readFlightMatches(previous[each], placement) { found = true }
          each = each + usize.ONE
        }
        if !found {
          let owner = Storage {endpoint: storageOwner(prepared, placement.storage.endpoint), temporary: placement.storage.temporary}
          let observation = List<ReadFlightObservation>.length(&skeleton.readFlightObservations)
          run List<ReadFlightObservation>.append(&mut skeleton.readFlightObservations, ReadFlightObservation {
            original: placement.original, consumer: placement.consumer, map: placement.map, alias: placement.alias,
            storage: placement.storage, owner: owner, evaluation: placement.result, active: placement.active})
          let missing = Program.atom(&mut skeleton.rules)
          run List<ReadFlightCoverage>.append(&mut skeleton.readFlightCoverage,
            ReadFlightCoverage {observation: observation, missing: missing})
          let components = run referenceOwnerComponents(prepared, owner)
          let componentsSelected = List<EndpointId>.asSlice(&components)
          each = usize.ZERO
          while each < componentsSelected.length {
            let storage = Storage {endpoint: componentsSelected[each], temporary: owner.temporary}
            let incoming = run reserveOwnerRead(&mut skeleton.*, placement.result, storage)
            run List<ReadFlightRead>.append(&mut skeleton.readFlightReads, ReadFlightRead {
              observation: observation, storage: storage, read: incoming.read, value: incoming.value, active: placement.active})
            each = each + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
    original = original + usize.ONE
  }
  return before != List<ReadFlightObservation>.length(&skeleton.readFlightObservations)
}

// Completeness belongs to this particular selected read/alias. Positive owner reads never
// discharge a missing alternative from the original selection or address proof.
effect fn sealReadFlightCoverage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  addresses: &AddressProofCoverage) -> () ! OutOfMemoryError ? &mut Allocator {
  let observations = List<ReadFlightObservation>.asSlice(&skeleton.readFlightObservations)
  let coverage = List<ReadFlightCoverage>.asSlice(&skeleton.readFlightCoverage)
  let reads = List<ReadFlightRead>.asSlice(&skeleton.readFlightReads)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let requests = List<AddressCoverage>.asSlice(&addresses.requests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let aliasMissing = List<Atom>.asSlice(&addresses.aliases)
  let mut observation = usize.ZERO
  while observation < observations.length {
    let selected = observations[observation]
    let missing = coverage[observation].missing
    if let Option<usize>.Some {value: alias} = selected.alias {
      let gate: [Atom; 2] = [selected.active, aliasMissing[alias]]
      run Program.rule(&mut skeleton.rules, missing, &gate, &[])
      let address = aliases[alias]
      let mut at = usize.ZERO
      while at < selections.length {
        if selections[at].result.index == address.evaluation.index {
          if let Option<MapId>.Some {value: place} = selections[at].place {
            if componentWithin(List<Endpoint>.asSlice(&prepared.endpoints), address.endpoint, maps[place.index].target) {
              let gate: [Atom; 2] = [selected.active, requests[at].missing]
              run Program.rule(&mut skeleton.rules, missing, &gate, &[])
            }
          }
        }
        at = at + usize.ONE
      }
    }
    let components = run referenceOwnerComponents(prepared, selected.owner)
    let componentsSelected = List<EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < componentsSelected.length {
      let present = Program.atom(&mut skeleton.rules)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && reads[at].storage.endpoint.index == componentsSelected[component].index {
          let gate: [Atom; 1] = [reads[at].active]
          run Program.rule(&mut skeleton.rules, present, &gate, &[])
        }
        at = at + usize.ONE
      }
      let gate: [Atom; 1] = [selected.active]
      let absent: [Atom; 1] = [present]
      run Program.rule(&mut skeleton.rules, missing, &gate, &absent)
      component = component + usize.ONE
    }
    let mut summary = usize.ZERO
    while summary < summaries.length {
      if sameTemporary(summaries[summary].prefix.temporary, selected.owner.temporary)
        && inlineWithin(prepared, summaries[summary].prefix.endpoint, selected.owner.endpoint) {
        let present = Program.atom(&mut skeleton.rules)
        let mut at = usize.ZERO
        while at < reads.length {
          if reads[at].observation == observation && sameStorage(reads[at].storage, selected.owner) {
            let mut each = usize.ZERO
            while each < summaryReads.length {
              if summaryReads[each].original.index == reads[at].read.index && summaryReads[each].summary == summary {
                let gate: [Atom; 2] = [reads[at].active, summaryReads[each].active]
                run Program.rule(&mut skeleton.rules, present, &gate, &[])
              }
              each = each + usize.ONE
            }
          }
          at = at + usize.ONE
        }
        let gate: [Atom; 1] = [selected.active]
        let absent: [Atom; 1] = [present]
        run Program.rule(&mut skeleton.rules, missing, &gate, &absent)
      }
      summary = summary + usize.ONE
    }
    observation = observation + usize.ONE
  }
  return ()
}

effect fn validateReadFlights<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> ()
! OutOfMemoryError ? &mut Allocator {
  let observations = List<ReadFlightObservation>.asSlice(&skeleton.readFlightObservations)
  let coverage = List<ReadFlightCoverage>.asSlice(&skeleton.readFlightCoverage)
  let reads = List<ReadFlightRead>.asSlice(&skeleton.readFlightReads)
  let recorded = List<ReadValue>.asSlice(&skeleton.reads)
  let values = List<Value>.asSlice(&skeleton.values)
  let points = Flow.reservedReads(&skeleton.flow)
  if observations.length != coverage.length { CompilerBug.panic(b"whole read flight omitted its independent coverage") }
  let mut at = usize.ZERO
  while at < observations.length {
    let observation = observations[at]
    let placements = run readPlacementsByRead(prepared, points, Flow.reservedPoints(&skeleton.flow),
      List<Storage>.asSlice(&skeleton.storage), recorded, values, List<Evaluation>.asSlice(&skeleton.evaluations),
      List<StorageAlias>.asSlice(&skeleton.aliases), List<AliasTransport>.asSlice(&skeleton.aliasTransports),
      List<AliasRead>.asSlice(&skeleton.aliasReads), List<SummaryRead>.asSlice(&skeleton.summaryReads), observation.original)
    let placementsSelected = List<ReadPlacement>.asSlice(&placements)
    let mut authenticated = false
    let mut each = usize.ZERO
    while each < placementsSelected.length {
      let placement = placementsSelected[each]
      if readFlightMatches(observation, placement) {
        authenticated = observation.evaluation.index == placement.result.index && sameStorage(observation.storage, placement.storage)
          && Atom.same(observation.active, placement.active)
      }
      each = each + usize.ONE
    }
    if !authenticated || !readFlightRequested(skeleton, observation.evaluation) || coverage[at].observation != at
      || observation.owner.endpoint.index != storageOwner(prepared, observation.storage.endpoint).index
      || !sameTemporary(observation.owner.temporary, observation.storage.temporary)
      || points[observation.original.index].point.index != Skeleton.evaluation(skeleton, observation.evaluation).point.index {
      CompilerBug.panic(b"whole read flight changed its original read, consumer or canonical owner")
    }
    let mut prior = usize.ZERO
    while prior < at {
      let duplicate = ReadPlacement {summary: Option<usize>.none(), original: observation.original, consumer: observation.consumer,
        read: observation.original, storage: observation.storage, map: observation.map, operand: observation.evaluation,
        result: observation.evaluation, alias: observation.alias, active: observation.active}
      if readFlightMatches(observations[prior], duplicate) { CompilerBug.panic(b"whole read flight repeated its actual observation") }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.observation >= observations.length || read.read.index >= recorded.length || read.value.index >= values.length {
      CompilerBug.panic(b"whole read flight lost its canonical Input")
    }
    let observation = observations[read.observation]
    let value = values[read.value.index]
    let original = recorded[read.read.index]
    if value.phase != ValuePhase.Input || value.evaluation.index != observation.evaluation.index
      || value.endpoint.index != read.storage.endpoint.index || original.value.index != read.value.index
      || !sameStorage(original.storage, read.storage) || !Atom.same(read.active, observation.active)
      || points[read.read.index].point.index != Skeleton.evaluation(skeleton, observation.evaluation).point.index
      || !sameTemporary(read.storage.temporary, observation.owner.temporary)
      || !inlineWithin(prepared, read.storage.endpoint, observation.owner.endpoint)
      || match original.summary { Option<usize>.Some {..} => true _ => false }
      || match original.map { Option<MapId>.Some {..} => true _ => false } {
      CompilerBug.panic(b"whole read flight changed component, timing or read authority")
    }
    at = at + usize.ONE
  }
  return ()
}

// A complete frozen ownership path starts with this descriptor's real Referent child.
// Missing nested Referent/repeated-element counterparts stay absent; types never supply them.
fn ownershipSuffixPath<'body>(prepared: &SourcePreparation<'body>, root: EndpointId, referent: EndpointId, endpoint: EndpointId) -> bool {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  if root.index >= endpoints.length || endpoint.index >= endpoints.length || root.index == endpoint.index { return false }
  let mut current = endpoint
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    let parent = match endpoints[current.index].parent { Option<EndpointId>.Some {value} => value _ => { return false } }
    let allowed = match &endpoints[current.index].selector {
      Selector.Member {..} => true
      Selector.Field {..} => true
      Selector.Variant {..} => true
      Selector.Index {..} => true
      Selector.Referent => true
      _ => false
    }
    if !allowed { return false }
    if parent.index == root.index { return current.index == referent.index
      && match &endpoints[current.index].selector { Selector.Referent => true _ => false } }
    current = parent
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"ownership descriptor path has cyclic ancestry")
}

fn validateOwnershipPlacement<'body>(prepared: &SourcePreparation<'body>, references: &[ReferenceOrigin],
  values: &[Value], positions: &[OwnershipPosition], placement: OwnershipPlacement) -> () {
  if let OwnershipPlacement.Position {anchor, position, offset} = placement {
    if anchor.index >= List<Endpoint>.length(&prepared.endpoints) || position.index >= positions.length {
      CompilerBug.panic(b"ownership position lost its actual anchor or immutable path")
    }
    if offset > List<OwnershipPositionStep>.length(&positions[position.index].steps) {
      CompilerBug.panic(b"ownership position offset left its atomic semantic path")
    }
  }
  if let OwnershipPlacement.Known {anchor, suffix} = placement {
    let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
    if anchor.index >= endpoints.length { CompilerBug.panic(b"ownership placement lost its inline anchor") }
    if let Option<OwnershipSuffix>.Some {value} = suffix {
      if value.reference >= references.length { CompilerBug.panic(b"ownership suffix lost its original reference") }
      let reference = references[value.reference]
      if values[reference.descriptor.index].endpoint.index != value.root.index
        || !ownershipSuffixPath(prepared, value.root, List<SelectionMap>.asSlice(&prepared.maps)[reference.referent.index].target, value.endpoint) {
        CompilerBug.panic(b"ownership suffix substituted a descriptor or incomplete path")
      }
    }
  }
  return ()
}

effect fn reserveReferenceHoldings<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<ReferenceHolding>.length(&skeleton.referenceHoldings)
  let reads = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let observations = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)
  let references = List<ReferenceOrigin>.asSlice(&skeleton.references)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mut reading = usize.ZERO
  while reading < reads.length {
    let read = reads[reading]
    let observation = observations[read.observation]
    let reference = references[observation.reference]
    let root = List<Value>.asSlice(&skeleton.values)[reference.descriptor.index].endpoint
    // Alternatives are local to this genuine read and its own reference descriptor.
    // Unknown is always bindable, including for non-Borrow/LoanFree source Cases.
    let mut endpoint = usize.ZERO
    while endpoint <= endpoints.length {
      let unknown = endpoint == endpoints.length
      if unknown || ownershipSuffixPath(prepared, root, List<SelectionMap>.asSlice(&prepared.maps)[reference.referent.index].target, EndpointId {index: endpoint}) {
        let mut placement = OwnershipPlacement.Unknown
        if !unknown {
          placement = OwnershipPlacement.Known {anchor: root, suffix: Option<OwnershipSuffix>.some(
            OwnershipSuffix {reference: observation.reference, root: root, endpoint: EndpointId {index: endpoint}})}
        }
        let old = List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings)
        let mut candidate = usize.ZERO
        while candidate < old.length {
          if old[candidate].referenceRead == reading && sameOwnershipPlacement(old[candidate].placement, placement) { break }
          candidate = candidate + usize.ONE
        }
        if candidate == old.length {
          run List<ReferenceHolding>.append(&mut skeleton.referenceHoldings, ReferenceHolding {
            referenceRead: reading, observation: read.observation, reference: observation.reference,
            source: read.value, target: reference.descriptor, placement: placement, active: read.active})
          let absent = Program.atom(&mut skeleton.rules)
          run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: read.value, target: reference.descriptor,
            active: read.active, directness: holdingDirectness(unknown),
            stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
            policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.ReferenceHolding {candidate: candidate}})
        }
      }
      endpoint = endpoint + usize.ONE
    }
    reading = reading + usize.ONE
  }
  return before != List<ReferenceHolding>.length(&skeleton.referenceHoldings)
}

fn validateReferenceHoldings<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let rows = List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings)
  let reads = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let observations = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)
  let references = List<ReferenceOrigin>.asSlice(&skeleton.references)
  let values = List<Value>.asSlice(&skeleton.values)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = rows[at]
    if row.referenceRead >= reads.length || row.observation >= observations.length || row.reference >= references.length {
      CompilerBug.panic(b"reference holding lost its acquisition observation")
    }
    let read = reads[row.referenceRead]
    let observation = observations[row.observation]
    let reference = references[row.reference]
    if read.observation != row.observation || observation.reference != row.reference
      || row.source.index != read.value.index || row.target.index != reference.descriptor.index
      || !Atom.same(row.active, read.active) || values[row.source.index].phase != ValuePhase.Input
      || values[row.source.index].evaluation.index != observation.acquisition.index
      || values[row.target.index].evaluation.index != observation.acquisition.index {
      CompilerBug.panic(b"reference holding changed its original read, descriptor or acquisition")
    }
    validateOwnershipPlacement(prepared, references, values, List<OwnershipPosition>.asSlice(&skeleton.selectedMoves.positions), row.placement)
    if let OwnershipPlacement.Known {anchor, suffix} = row.placement {
      let exact = match suffix { Option<OwnershipSuffix>.Some {value} => value.reference == row.reference _ => false }
      if !exact || anchor.index != values[row.target.index].endpoint.index {
        CompilerBug.panic(b"reference holding omitted its own full descriptor suffix")
      }
    }
    let mut prior = usize.ZERO
    while prior < at {
      if rows[prior].referenceRead == row.referenceRead && sameOwnershipPlacement(rows[prior].placement, row.placement) {
        CompilerBug.panic(b"reference holding duplicated an acquisition alternative")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// The selected descriptor prefix and original address formation are separate coordinates.
fn referenceObservationSource(origin: ReferenceOrigin) -> EvalId {
  return match origin.ownership { Option<ThroughDescriptor>.Some {value} => value.evaluation _ => origin.source }
}
fn referenceObservationEndpoint(origin: ReferenceOrigin, maps: &[SelectionMap]) -> EndpointId {
  return match origin.ownership { Option<ThroughDescriptor>.Some {value} => value.root _ => maps[origin.map.index].source }
}

fn validateReferenceBoundary<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  origin: ReferenceOrigin, boundary: ThroughDescriptor) -> () {
  let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[boundary.root.index]
  let descriptor = match Skeleton.evaluation(skeleton, boundary.evaluation).site {
    EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"reference holder boundary has no actual descriptor") }
  }
  let crossing = match Skeleton.evaluation(skeleton, boundary.crossing).site {
    EvaluationSite.Node {node} => node
    _ => { return CompilerBug.panic(b"reference holder boundary has no actual crossing") }
  }
  let exact = match endpoint.root {
    Root.Node {node, category} => node.index == descriptor.index && category == EndpointRole.Storage
    _ => false
  }
  if !exact || match endpoint.parent { Option<EndpointId>.Some {..} => true _ => false } {
    CompilerBug.panic(b"reference holder boundary substituted an inline or destination endpoint")
  }
  let mut authentic = false
  match &prepared.body.nodes[crossing.index].kind {
    NodeKind.Expression {form: Expression.Dereference {value}, ..} => {
      authentic = value.index == descriptor.index
        && match &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state {
          PreparedShapeState.Reference => true _ => false }
    }
    NodeKind.Expression {form: Expression.Index {value, ..}, ..} => {
      authentic = value.index == descriptor.index
        && match &List<Prepared.Shape>.asSlice(&prepared.shapes)[endpoint.shape.index].state {
          PreparedShapeState.Slice => true _ => false }
    }
    _ => ()
  }
  if !authentic { CompilerBug.panic(b"reference holder boundary is not a genuine descriptor crossing") }
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let mut current = origin.source
  let mut crossed = false
  let mut remaining = selections.length + usize.ONE
  while current.index != boundary.evaluation.index && remaining != usize.ZERO {
    let mut predecessor = Option<EvalId>.none()
    let mut at = usize.ZERO
    while at < selections.length {
      if selections[at].result.index == current.index {
        if let Option<EvalId>.Some {value} = predecessor {
          if value.index != selections[at].operand.index { CompilerBug.panic(b"reference holder path has two actual operands") }
        }
        predecessor = Option<EvalId>.some(selections[at].operand)
      }
      at = at + usize.ONE
    }
    let earlier = match predecessor { Option<EvalId>.Some {value} => value
      _ => { return CompilerBug.panic(b"reference holder path omitted its actual selection occurrence") } }
    if current.index == boundary.crossing.index && earlier.index == boundary.evaluation.index { crossed = true }
    current = earlier
    remaining = remaining - usize.ONE
  }
  if current.index != boundary.evaluation.index || !crossed {
    CompilerBug.panic(b"reference holder boundary is not on its original selected path")
  }
  return ()
}

// Runs inside the existing candidate closure. Every read uses the descriptor's original
// acquisition Eval (including implicit capture usePoint), not its enclosing publication.
effect fn reserveReferenceObservations<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton)
  -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = List<ReferenceObservation>.length(&skeleton.referenceObservations)
  let beforeCoverage = List<ReferenceCoverage>.length(&skeleton.referenceCoverage)
  let referencesCount = List<ReferenceOrigin>.length(&skeleton.references)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut reference = usize.ZERO
  while reference < referencesCount {
    let origin = List<ReferenceOrigin>.asSlice(&skeleton.references)[reference]
    let acquisition = List<Value>.asSlice(&skeleton.values)[origin.descriptor.index].evaluation
    let actual = Skeleton.evaluation(&skeleton.*, acquisition)
    if reference == List<ReferenceCoverage>.length(&skeleton.referenceCoverage) {
      let seed = referenceSeed(&skeleton.*, origin)
      let active = run addressApplies(&mut skeleton.rules, seed, Flow.reachable(&skeleton.flow, actual.point))
      let missing = Program.atom(&mut skeleton.rules)
      run List<ReferenceCoverage>.append(&mut skeleton.referenceCoverage,
        ReferenceCoverage {reference: reference, active: active, missing: missing})
    }
    let coverage = List<ReferenceCoverage>.asSlice(&skeleton.referenceCoverage)[reference]
    let count = List<StorageAlias>.length(&skeleton.aliases)
    let mut alias = usize.ZERO
    while alias < count {
      let address = List<StorageAlias>.asSlice(&skeleton.aliases)[alias]
      if address.evaluation.index == referenceObservationSource(origin).index && address.endpoint.index == referenceObservationEndpoint(origin, maps).index {
        let observations = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)
        let mut found = false
        let mut at = usize.ZERO
        while at < observations.length {
          if observations[at].reference == reference && observations[at].alias == alias { found = true }
          at = at + usize.ONE
        }
        if !found {
          let owner = Storage {endpoint: storageOwner(prepared, address.storage.endpoint), temporary: address.storage.temporary}
          let active = run addressApplies(&mut skeleton.rules, coverage.active, address.active)
          let observation = List<ReferenceObservation>.length(&skeleton.referenceObservations)
          run List<ReferenceObservation>.append(&mut skeleton.referenceObservations, ReferenceObservation {
            reference: reference, alias: alias, acquisition: acquisition, storage: address.storage, owner: owner, active: active})
          let components = run referenceOwnerComponents(prepared, owner)
          let componentsSelected = List<EndpointId>.asSlice(&components)
          at = usize.ZERO
          while at < componentsSelected.length {
            let storage = Storage {endpoint: componentsSelected[at], temporary: owner.temporary}
            let read = run reserveOwnerRead(&mut skeleton.*, acquisition, storage)
            run List<ReferenceRead>.append(&mut skeleton.referenceReads, ReferenceRead {
              observation: observation, storage: storage, read: read.read, value: read.value, active: active})
            at = at + usize.ONE
          }
        }
      }
      alias = alias + usize.ONE
    }
    reference = reference + usize.ONE
  }
  return before != List<ReferenceObservation>.length(&skeleton.referenceObservations)
    || beforeCoverage != List<ReferenceCoverage>.length(&skeleton.referenceCoverage)
}

// Seal only after address/read reservation. Existence of one alias does not discharge a
// missing alternative, and each owner component/summary has a separate read obligation.
effect fn sealReferenceCoverage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  addresses: &AddressProofCoverage) -> () ! OutOfMemoryError ? &mut Allocator {
  let references = List<ReferenceOrigin>.asSlice(&skeleton.references)
  let coverage = List<ReferenceCoverage>.asSlice(&skeleton.referenceCoverage)
  let observations = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)
  let reads = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let aliasMissing = List<Atom>.asSlice(&addresses.aliases)
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let requests = List<AddressCoverage>.asSlice(&addresses.requests)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let summaries = List<SummaryStorage>.asSlice(&skeleton.summaries)
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let mut reference = usize.ZERO
  while reference < references.length {
    let origin = references[reference]
    let status = coverage[reference]
    let grounded = Program.atom(&mut skeleton.rules)
    let mut alias = usize.ZERO
    while alias < aliases.length {
      if aliases[alias].evaluation.index == referenceObservationSource(origin).index && aliases[alias].endpoint.index == referenceObservationEndpoint(origin, maps).index {
        let observed = Program.atom(&mut skeleton.rules)
        let mut at = usize.ZERO
        while at < observations.length {
          if observations[at].reference == reference && observations[at].alias == alias {
            let gate: [Atom; 1] = [observations[at].active]
            run Program.rule(&mut skeleton.rules, observed, &gate, &[])
          }
          at = at + usize.ONE
        }
        let gate: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, grounded, &gate, &[])
        let applicable: [Atom; 2] = [status.active, aliases[alias].active]
        let absent: [Atom; 1] = [observed]
        run Program.rule(&mut skeleton.rules, status.missing, &applicable, &absent)
        let alternative: [Atom; 2] = [status.active, aliasMissing[alias]]
        run Program.rule(&mut skeleton.rules, status.missing, &alternative, &[])
      }
      alias = alias + usize.ONE
    }
    let active: [Atom; 1] = [status.active]
    let absent: [Atom; 1] = [grounded]
    run Program.rule(&mut skeleton.rules, status.missing, &active, &absent)
    let mut at = usize.ZERO
    while at < selections.length {
      let selected = &selections[at]
      if selected.result.index == referenceObservationSource(origin).index {
        if let Option<MapId>.Some {value} = selected.place {
          if maps[value.index].target.index == referenceObservationEndpoint(origin, maps).index {
            let gates: [Atom; 2] = [status.active, requests[at].missing]
            run Program.rule(&mut skeleton.rules, status.missing, &gates, &[])
          }
        }
      }
      at = at + usize.ONE
    }
    reference = reference + usize.ONE
  }
  let mut observation = usize.ZERO
  while observation < observations.length {
    let selected = observations[observation]
    let missing = coverage[selected.reference].missing
    let components = run referenceOwnerComponents(prepared, selected.owner)
    let componentsSelected = List<EndpointId>.asSlice(&components)
    let mut component = usize.ZERO
    while component < componentsSelected.length {
      let present = Program.atom(&mut skeleton.rules)
      let mut at = usize.ZERO
      while at < reads.length {
        if reads[at].observation == observation && reads[at].storage.endpoint.index == componentsSelected[component].index {
          let gates: [Atom; 1] = [reads[at].active]
          run Program.rule(&mut skeleton.rules, present, &gates, &[])
        }
        at = at + usize.ONE
      }
      let gates: [Atom; 1] = [selected.active]
      let negative: [Atom; 1] = [present]
      run Program.rule(&mut skeleton.rules, missing, &gates, &negative)
      component = component + usize.ONE
    }
    let mut summary = usize.ZERO
    while summary < summaries.length {
      if sameTemporary(summaries[summary].prefix.temporary, selected.owner.temporary)
        && inlineWithin(prepared, summaries[summary].prefix.endpoint, selected.owner.endpoint) {
        let present = Program.atom(&mut skeleton.rules)
        let mut at = usize.ZERO
        while at < reads.length {
          if reads[at].observation == observation && sameStorage(reads[at].storage, selected.owner) {
            let mut each = usize.ZERO
            while each < summaryReads.length {
              if summaryReads[each].original.index == reads[at].read.index && summaryReads[each].summary == summary {
                let gates: [Atom; 2] = [reads[at].active, summaryReads[each].active]
                run Program.rule(&mut skeleton.rules, present, &gates, &[])
              }
              each = each + usize.ONE
            }
          }
          at = at + usize.ONE
        }
        let gates: [Atom; 1] = [selected.active]
        let negative: [Atom; 1] = [present]
        run Program.rule(&mut skeleton.rules, missing, &gates, &negative)
      }
      summary = summary + usize.ONE
    }
    observation = observation + usize.ONE
  }
  return ()
}

fn validateReferenceObservations<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton) -> () {
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let references = List<ReferenceOrigin>.asSlice(&skeleton.references)
  let observations = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)
  let reads = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let recorded = List<ReadValue>.asSlice(&skeleton.reads)
  let flowReads = Flow.reservedReads(&skeleton.flow)
  let values = List<Value>.asSlice(&skeleton.values)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let coverage = List<ReferenceCoverage>.asSlice(&skeleton.referenceCoverage)
  if coverage.length != references.length { CompilerBug.panic(b"reference observations omitted acquisition coverage") }
  let mut at = usize.ZERO
  while at < coverage.length {
    if let Option<ThroughDescriptor>.Some {value} = references[at].ownership {
      validateReferenceBoundary(prepared, skeleton, references[at], value)
    }
    if coverage[at].reference != at { CompilerBug.panic(b"reference coverage changed original acquisition identity") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < observations.length {
    let observation = observations[at]
    if observation.reference >= references.length || observation.alias >= aliases.length { CompilerBug.panic(b"reference observation has absent original evidence") }
    let origin = references[observation.reference]
    let alias = aliases[observation.alias]
    if observation.acquisition.index != values[origin.descriptor.index].evaluation.index
      || alias.evaluation.index != referenceObservationSource(origin).index || alias.endpoint.index != referenceObservationEndpoint(origin, maps).index
      || !sameStorage(observation.storage, alias.storage)
      || observation.owner.endpoint.index != storageOwner(prepared, alias.storage.endpoint).index
      || !sameTemporary(observation.owner.temporary, alias.storage.temporary) {
      CompilerBug.panic(b"reference observation substituted acquisition, selected place or canonical owner")
    }
    let owner = &endpoints[observation.owner.endpoint.index]
    if let Option<EndpointId>.Some {..} = owner.parent { CompilerBug.panic(b"reference observation stopped inside its canonical owner") }
    let canonical = match &owner.root {
      Root.Local {category, ..} => category == EndpointRole.Storage
        && match observation.owner.temporary { Option<EvalId>.None => true _ => false }
      Root.Node {node, category} => category == EndpointRole.Storage && match observation.owner.temporary {
        Option<EvalId>.Some {value} => match Skeleton.evaluation(skeleton, value).site {
          EvaluationSite.Node {node: actual} => actual.index == node.index
          _ => false
        }
        _ => false
      }
      _ => false
    }
    if !canonical { CompilerBug.panic(b"reference observation invented a canonical owner") }
    let mut prior = usize.ZERO
    while prior < at {
      if observations[prior].reference == observation.reference && observations[prior].alias == observation.alias {
        CompilerBug.panic(b"reference observation duplicated an actual alias alternative")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < reads.length {
    let read = reads[at]
    if read.observation >= observations.length || read.read.index >= recorded.length || read.value.index >= values.length {
      CompilerBug.panic(b"reference read omitted its actual observation or read")
    }
    let observation = observations[read.observation]
    let actual = recorded[read.read.index]
    let value = values[read.value.index]
    if actual.read.index != read.read.index || actual.value.index != read.value.index || !sameStorage(actual.storage, read.storage)
      || value.phase != ValuePhase.Input || value.endpoint.index != read.storage.endpoint.index
      || value.evaluation.index != observation.acquisition.index
      || flowReads[read.read.index].point.index != Skeleton.evaluation(skeleton, observation.acquisition).point.index
      || !sameTemporary(read.storage.temporary, observation.owner.temporary)
      || !inlineWithin(prepared, read.storage.endpoint, observation.owner.endpoint)
      || !Atom.same(read.active, observation.active) {
      CompilerBug.panic(b"reference read changed canonical component or acquisition timing")
    }
    if let Option<MapId>.Some {..} = actual.map { CompilerBug.panic(b"reference observation invented a contents projection") }
    if let Option<usize>.Some {..} = actual.summary { CompilerBug.panic(b"reference component substituted a summary read") }
    if let Option<ResidualSubject>.Some {..} = value.subject { CompilerBug.panic(b"reference component substituted a residual result") }
    if let Option<AliasPort>.Some {..} = value.transport { CompilerBug.panic(b"reference observation became an address lane") }
    if let Option<usize>.Some {..} = value.summary { CompilerBug.panic(b"reference observation became a summary value") }
    if let Option<usize>.Some {..} = value.writeHolder { CompilerBug.panic(b"reference observation became a receiving definition") }
    let mut prior = usize.ZERO
    while prior < at {
      if reads[prior].observation == read.observation && sameStorage(reads[prior].storage, read.storage) {
        CompilerBug.panic(b"reference observation repeated an inline read")
      }
      prior = prior + usize.ONE
    }
    at = at + usize.ONE
  }
  let summaryReads = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  at = usize.ZERO
  while at < summaryReads.length {
    if !referenceSummaryRoot(skeleton, summaryReads[at].original) {
      CompilerBug.panic(b"reference summary was duplicated at a narrower component read")
    }
    at = at + usize.ONE
  }
  return ()
}

/// Coverage belongs to an actual request, separately from its positive canonical aliases.
/// A false missing atom is useful only for this request and its existing applicability.
pub union AddressRequest {
  Selection {pub selection: usize},
  Retained {pub request: usize},
  Invocation {pub request: usize},
}
impl Copy for AddressRequest {}
pub struct AddressCoverage {
  pub request: AddressRequest
  pub active: Atom
  pub missing: Atom
}
impl Copy for AddressCoverage {}
struct AddressProofCoverage {
  requests: List<AddressCoverage>
  aliases: List<Atom>
}

// A terminal obligation names the final descriptor boundary in THIS authored path.
// Supplemental conversion-source demands and preceding Referent prefixes cannot complete
// it or manufacture a nonempty alternative to an exact final count-zero conversion.
fn addressTerminalDemand<'body>(prepared: &SourcePreparation<'body>, values: &[Value], selections: &[SelectionUse], requests: &[DescriptorRequest], transports: &[AliasTransport],
  closure: &DescriptorClosure, domain: &Domain, request: usize, path: usize,
  selectors: &[MapId], last: usize, demandId: usize) -> bool {
  let demand = CarriersProduct.demands(&closure.product)[demandId]
  if demand.selectionUse != request { return false }
  let supplemental = List<SliceDemand>.asSlice(&closure.sliceDemands)
  let mut at = usize.ZERO
  while at < supplemental.length {
    if supplemental[at].demand == demandId { return false }
    at = at + usize.ONE
  }
  let map = &List<SelectionMap>.asSlice(&prepared.maps)[selectors[last].index]
  let state = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[demand.state.index]
  let key = List<CellKey>.asSlice(&domain.keys)[demand.cell]
  let actual = values[key.value.index]
  if actual.endpoint.index != map.source.index || actual.phase != ValuePhase.Output
    || state.vertex.index != map.target.index || !authoredResidual(state) { return false }
  if request < selections.length {
    return state.selection.index == selections[request].selection.index
      && actual.evaluation.index == selections[request].operand.index && !operationSubject(actual)
  }
  let selected = request - selections.length
  let use = &requests[selected]
  if state.selection.index != use.selection.index || operationSubject(actual) { return false }
  if let Option<usize>.Some {..} = actual.summary { return false }
  if let Option<usize>.Some {..} = actual.writeHolder { return false }
  if let Option<AliasPort>.Some {..} = actual.transport { return false }
  at = usize.ZERO
  while at < last {
    if retainedBoundary(prepared, selectors[at]) {
      return retainedCurrentDescriptor(transports, values, selected, path, last, actual)
    }
    at = at + usize.ONE
  }
  return actual.evaluation.index == use.operand.index
}

union AddressTerminalProof {Origin {proof: usize}, Slice {proof: usize, element: usize}}
impl Copy for AddressTerminalProof {}

// Discharge one nonempty final history using its own placement edge. A joined alias,
// another Origin or another conversion element is not this proof's completion.
effect fn addressTerminalPlaced<'body>(prepared: &SourcePreparation<'body>, rules: &mut Program, aliases: &[StorageAlias], edges: &[AliasEdge], selections: &[SelectionUse],
  closure: &DescriptorClosure, request: usize, terminal: EndpointId, evaluation: EvalId,
  proof: AddressTerminalProof) -> Atom ! OutOfMemoryError ? &mut Allocator {
  let completed = Program.atom(&mut rules.*)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut endpoint = terminal
  let mut occurrence = evaluation
  let mut publication = Option<MapId>.none()
  if request < selections.length {
    publication = selections[request].place
    if let Option<MapId>.Some {value} = publication {
      endpoint = maps[value.index].source
      occurrence = selections[request].operand
    }
  }
  let empty = List<Atom>.make()
  let mut at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let mut exact = false
    match proof {
      AddressTerminalProof.Origin {proof: actualProof} => { exact = match edge.authority {
        AliasAuthority.Origin {placement} => List<OriginPlacement>.asSlice(&closure.placements)[placement].proof == actualProof
        _ => false
      } }
      AddressTerminalProof.Slice {proof: actualProof, element} => match edge.authority {
        AliasAuthority.Slice {placement} => {
          let selected = List<SlicePlacement>.asSlice(&closure.slicePlacements)[placement]
          exact = selected.proof == actualProof && selected.element == element
        }
        _ => ()
      }
    }
    let alias = aliases[edge.target]
    if exact && alias.endpoint.index == endpoint.index && alias.evaluation.index == occurrence.index {
      match publication {
        Option<MapId>.None => {
          let gates: [Atom; 1] = [edge.active]
          run Program.rule(&mut rules.*, completed, &gates, List<Atom>.asSlice(&empty))
        }
        Option<MapId>.Some {value: map} => {
          let mut next = usize.ZERO
          while next < edges.length {
            let onward = edges[next]
            let source = match onward.source { Option<usize>.Some {value} => value == edge.target _ => false }
            let selected = match onward.authority {
              AliasAuthority.Selected {selection, map: actual} => selection == request && actual.index == map.index
              AliasAuthority.Project {map: actual} => actual.index == map.index
              _ => false
            }
            if source && selected && aliases[onward.target].endpoint.index == terminal.index
              && aliases[onward.target].evaluation.index == evaluation.index {
              let gates: [Atom; 2] = [edge.active, onward.active]
              run Program.rule(&mut rules.*, completed, &gates, List<Atom>.asSlice(&empty))
            }
            next = next + usize.ONE
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return completed
}

// Empty completion is local to the final boundary/root demand. Nonempty siblings still
// owe each terminal placement, even when they share a Carrier root or a canonical alias.
effect fn addressTerminalEmpty<'body>(prepared: &SourcePreparation<'body>, rules: &mut Program, values: &[Value], selections: &[SelectionUse], requests: &[DescriptorRequest],
  transports: &[AliasTransport], conversions: &[SliceConversion], aliases: &[StorageAlias], aliasEdges: &[AliasEdge],
  closure: &DescriptorClosure, domain: &Domain, request: AddressCoverage, ordinal: usize,
  path: usize, selectors: &[MapId], terminal: EndpointId, evaluation: EvalId) -> Atom
  ! OutOfMemoryError ? &mut Allocator {
  let impossible = Program.atom(&mut rules.*)
  let mut last = usize.MAX
  let mut at = usize.ZERO
  while at < selectors.length {
    if retainedBoundary(prepared, selectors[at]) { last = at }
    at = at + usize.ONE
  }
  if last == usize.MAX { return impossible }
  let nodes = CarriersProduct.nodes(&closure.product)
  let origins = List<OriginProof>.asSlice(&closure.origins)
  let slices = List<SliceProof>.asSlice(&closure.sliceProofs)
  let cases = List<Case>.asSlice(&domain.cases)
  let empty = List<Atom>.make()
  at = usize.ZERO
  while at < origins.length {
    let proof = origins[at]
    if addressTerminalDemand(prepared, values, selections, requests, transports, closure, domain, ordinal, path, selectors, last, nodes[proof.carrier].demand) {
      let completed = run addressTerminalPlaced(prepared, &mut rules.*, aliases, aliasEdges, selections, closure, ordinal,
        terminal, evaluation, AddressTerminalProof.Origin {proof: at})
      let gates: [Atom; 3] = [request.active, proof.active, cases[proof.seed].active]
      let negative: [Atom; 1] = [completed]
      run Program.rule(&mut rules.*, request.missing, &gates, &negative)
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < slices.length {
    let proof = slices[at]
    if addressTerminalDemand(prepared, values, selections, requests, transports, closure, domain, ordinal, path, selectors, last, nodes[proof.carrier].demand) {
      let conversion = conversions[proof.conversion]
      let row = &List<Prepared.ArraySlice>.asSlice(&prepared.arraySlices)[conversion.prepared]
      let elements = List<Prepared.ArraySliceElement>.asSlice(&row.elements)
      let count = match &prepared.body.nodes[row.site.index].kind {
        NodeKind.Expression {form: Expression.ArraySlice {count, ..}, ..} => count
        _ => { return CompilerBug.panic(b"terminal slice completion lost its actual conversion") }
      }
      if (count == usize.ZERO) != (elements.length == usize.ZERO) {
        return CompilerBug.panic(b"terminal slice completion changed its frozen element partition")
      }
      if count == usize.ZERO {
        // The retained conversion Case and original root history supply the gates;
        // only the actual typed count, never an empty source inventory, proves emptiness.
        let gates: [Atom; 3] = [request.active, proof.active, cases[proof.case].active]
        run Program.rule(&mut rules.*, impossible, &gates, List<Atom>.asSlice(&empty))
      } else {
        let mut element = usize.ZERO
        while element < elements.length {
          let completed = run addressTerminalPlaced(prepared, &mut rules.*, aliases, aliasEdges, selections, closure, ordinal,
            terminal, evaluation, AddressTerminalProof.Slice {proof: at, element: element})
          let gates: [Atom; 3] = [request.active, proof.active, cases[proof.case].active]
          let negative: [Atom; 1] = [completed]
          run Program.rule(&mut rules.*, request.missing, &gates, &negative)
          element = element + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return impossible
}

fn addressTerminalSelectors<'inputs>(selections: &'inputs [SelectionUse], requests: &'inputs [DescriptorRequest], request: usize, target: usize) -> &'inputs [MapId] {
  if request < selections.length { return List<MapId>.asSlice(&selections[request].selectors) }
  return List<MapId>.asSlice(&List<RetainedPath>.asSlice(&requests[request - selections.length].paths)[target].selectors)
}

// This pass runs once after candidate closure. Negated coverage never controls reservation,
// and every predecessor Case is checked independently of a sibling's successful origin.
effect fn addressProofCoverage<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  closure: &DescriptorClosure, domain: &Domain) -> AddressProofCoverage ! OutOfMemoryError ? &mut Allocator {
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  let requests = List<DescriptorRequest>.asSlice(&skeleton.descriptorRequests)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let aliasEdges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let demands = CarriersProduct.demands(&closure.product)
  let nodes = CarriersProduct.nodes(&closure.product)
  let edges = CarriersProduct.edges(&closure.product)
  let pairs = List<Carriers.Pair>.asSlice(&closure.pairs)
  let origins = List<OriginProof>.asSlice(&closure.origins)
  let slices = List<SliceProof>.asSlice(&closure.sliceProofs)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let cases = List<Case>.asSlice(&domain.cases)
  let values = List<Value>.asSlice(&skeleton.values)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut coverage = AddressProofCoverage {requests: List<AddressCoverage>.make(), aliases: List<Atom>.make()}
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  let mut at = usize.ZERO
  while at < selections.length + requests.length {
    if at < selections.length {
      let source = AddressRequest.Selection {selection: at}
      let point = Skeleton.evaluation(&skeleton.*, selections[at].result).point
      let active = run addressApplies(&mut skeleton.rules, selections[at].active, Flow.reachable(&skeleton.flow, point))
      let missing = Program.atom(&mut skeleton.rules)
      run List<AddressCoverage>.append(&mut coverage.requests, AddressCoverage {request: source, active: active, missing: missing})
    } else {
      let selected = &requests[at - selections.length]
      let source = match selected.authority {
        DescriptorRequestAuthority.Retained {request} => AddressRequest.Retained {request: request}
        DescriptorRequestAuthority.Invocation {request} => AddressRequest.Invocation {request: request}
      }
      run List<AddressCoverage>.append(&mut coverage.requests,
        AddressCoverage {request: source, active: selected.active, missing: selected.missing})
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < aliases.length {
    run List<Atom>.append(&mut coverage.aliases, Program.atom(&mut skeleton.rules))
    at = at + usize.ONE
  }
  let requestsCoverage = List<AddressCoverage>.asSlice(&coverage.requests)
  let aliasMissing = List<Atom>.asSlice(&coverage.aliases)
  // An alias edge proves one address history. Carry missing alternatives along the SAME
  // proof legs, including the exact original demand that discharged an Origin or Slice.
  at = usize.ZERO
  while at < aliasEdges.length {
    let edge = aliasEdges[at]
    if let Option<usize>.Some {value} = edge.source {
      let gates: [Atom; 2] = [edge.active, aliasMissing[value]]
      run Program.rule(&mut skeleton.rules, aliasMissing[edge.target], &gates, none)
    }
    let request = match edge.authority {
      AliasAuthority.Selected {selection, ..} => Option<usize>.some(selection)
      AliasAuthority.Origin {..} => match retainedEdgeDemand(closure, edge) {
        Option<usize>.Some {value} => Option<usize>.some(demands[value].selectionUse)
        _ => { return CompilerBug.panic(b"origin coverage lost its actual demand") }
      }
      AliasAuthority.Slice {..} => match retainedEdgeDemand(closure, edge) {
        Option<usize>.Some {value} => Option<usize>.some(demands[value].selectionUse)
        _ => { return CompilerBug.panic(b"slice coverage lost its actual demand") }
      }
      _ => Option<usize>.none()
    }
    if let Option<usize>.Some {value} = request {
      let gates: [Atom; 2] = [edge.active, requestsCoverage[value].missing]
      run Program.rule(&mut skeleton.rules, aliasMissing[edge.target], &gates, none)
    }
    at = at + usize.ONE
  }
  // A retained predecessor edge is not complete merely because it exists. Ground its
  // actual history at an Origin/Slice seed, then propagate along those same Case edges.
  // This leaves unsupported and ungrounded cyclic alternatives visible beside a good alias.
  let mut groundedCarriers = List<Atom>.make()
  at = usize.ZERO
  while at < nodes.length {
    run List<Atom>.append(&mut groundedCarriers, Program.atom(&mut skeleton.rules))
    at = at + usize.ONE
  }
  let grounded = List<Atom>.asSlice(&groundedCarriers)
  at = usize.ZERO
  while at < origins.length {
    let gates: [Atom; 1] = [origins[at].active]
    run Program.rule(&mut skeleton.rules, grounded[origins[at].carrier], &gates, none)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < slices.length {
    let gates: [Atom; 1] = [slices[at].active]
    run Program.rule(&mut skeleton.rules, grounded[slices[at].carrier], &gates, none)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    let applicable = match edge.authority {
      CarriersEdgeAuthority.OriginContents {pair} => pairs[pair].active
      _ => cases[edge.case].active
    }
    let gates: [Atom; 3] = [grounded[edge.earlier], cases[edge.case].active, applicable]
    run Program.rule(&mut skeleton.rules, grounded[edge.later], &gates, none)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < nodes.length {
    let node = nodes[at]
    let request = requestsCoverage[demands[node.demand].selectionUse]
    let mut caseId = usize.ZERO
    while caseId < cases.length {
      let actual = &cases[caseId]
      if actual.target == node.cell {
        let admitted = Program.atom(&mut skeleton.rules)
        let mut each = usize.ZERO
        while each < edges.length {
          let edge = edges[each]
          if edge.later == at && edge.case == caseId {
            let gate = match edge.authority {
              CarriersEdgeAuthority.OriginContents {pair} => pairs[pair].active
              _ => actual.active
            }
            let gates: [Atom; 2] = [gate, grounded[edge.earlier]]
            run Program.rule(&mut skeleton.rules, admitted, &gates, none)
          }
          each = each + usize.ONE
        }
        each = usize.ZERO
        while each < origins.length {
          let origin = origins[each]
          if origin.carrier == at && origin.seed == caseId {
            let gates: [Atom; 1] = [origin.active]
            run Program.rule(&mut skeleton.rules, admitted, &gates, none)
            let missing: [Atom; 2] = [origin.active, aliasMissing[origin.sourceAlias]]
            run Program.rule(&mut skeleton.rules, request.missing, &missing, none)
          }
          each = each + usize.ONE
        }
        each = usize.ZERO
        while each < slices.length {
          if slices[each].carrier == at && slices[each].case == caseId {
            let gates: [Atom; 1] = [slices[each].active]
            run Program.rule(&mut skeleton.rules, admitted, &gates, none)
          }
          each = each + usize.ONE
        }
        let gates: [Atom; 2] = [node.active, actual.active]
        let negative: [Atom; 1] = [admitted]
        run Program.rule(&mut skeleton.rules, request.missing, &gates, &negative)
        // Composite current contents also depend on completeness of their actual address.
        // The contents leaf itself never proves that canonical address.
        let address = match actual.authority {
          TransferAuthority.Address {edge, ..} => Option<usize>.some(edge)
          _ => match carrierAuthority(prepared, &skeleton.*, keys, actual) {
            CarriersAuthority.Physical {address, ..} => address
            _ => Option<usize>.none()
          }
        }
        if let Option<usize>.Some {value: edge} = address {
          let missing: [Atom; 3] = [node.active, actual.active, aliasMissing[aliasEdges[edge].target]]
          run Program.rule(&mut skeleton.rules, request.missing, &missing, none)
        }
      }
      caseId = caseId + usize.ONE
    }
    at = at + usize.ONE
  }
  // Descriptor operation subjects deliberately have no physical Carrier demand. Retain
  // their active alternative explicitly rather than allowing a sibling origin to hide it.
  at = usize.ZERO
  while at < selections.length {
    let selection = &selections[at]
    let selectors = List<MapId>.asSlice(&selection.selectors)
    let mut step = usize.ZERO
    while step < selectors.length {
      if retainedBoundary(prepared, selectors[step]) {
        let mut cell = usize.ZERO
        while cell < keys.length {
          let value = values[keys[cell].value.index]
          if keys[cell].category == SourceRole.Physical && value.evaluation.index == selection.operand.index && value.endpoint.index == maps[selectors[step].index].source.index
            && value.phase == ValuePhase.Output && operationSubject(value) {
            let gates: [Atom; 2] = [requestsCoverage[at].active, cells[cell].present]
            run Program.rule(&mut skeleton.rules, requestsCoverage[at].missing, &gates, none)
          }
          cell = cell + usize.ONE
        }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  // Ground every requested terminal independently. The only address-free completion is
  // an exact count-zero conversion Case, never an empty contributor/source inventory.
  at = usize.ZERO
  while at < requestsCoverage.length {
    let request = requestsCoverage[at]
    let mut terminals = List<EndpointId>.make()
    let mut observedEvaluation = Option<EvalId>.none()
    match request.request {
      AddressRequest.Selection {selection} => {
        let use = &selections[selection]
        if let Option<MapId>.Some {value} = use.place {
          run List<EndpointId>.append(&mut terminals, maps[value.index].target)
        } else if let Option<MapId>.Some {value} = use.value {
          // Value-copy targets have no invented address alias. Its exact selected source
          // is the address observation before that final publication.
          run List<EndpointId>.append(&mut terminals, maps[value.index].source)
        }
        observedEvaluation = Option<EvalId>.some(match use.place { Option<MapId>.Some {..} => use.result _ => use.operand })
      }
      _ => {
        let use = &requests[at - selections.length]
        let paths = List<RetainedPath>.asSlice(&use.paths)
        let mut path = usize.ZERO
        while path < paths.length {
          run List<EndpointId>.append(&mut terminals, paths[path].endpoint)
          path = path + usize.ONE
        }
        observedEvaluation = Option<EvalId>.some(use.execution)
      }
    }
    let evaluation = match observedEvaluation { Option<EvalId>.Some {value} => value
      _ => { return CompilerBug.panic(b"address terminal omitted its actual observation occurrence") } }
    let targets = List<EndpointId>.asSlice(&terminals)
    let mut target = usize.ZERO
    while target < targets.length {
      let selectors = addressTerminalSelectors(selections, requests, at, target)
      let impossible = run addressTerminalEmpty(prepared, &mut skeleton.rules, values, selections, requests,
        List<AliasTransport>.asSlice(&skeleton.aliasTransports), List<SliceConversion>.asSlice(&skeleton.slices),
        aliases, aliasEdges, closure, domain, request, at, target, selectors, targets[target], evaluation)
      let grounded = Program.atom(&mut skeleton.rules)
      let mut each = usize.ZERO
      while each < aliases.length {
        let alias = &aliases[each]
        if alias.evaluation.index == evaluation.index && alias.endpoint.index == targets[target].index {
          let gates: [Atom; 1] = [alias.active]
          run Program.rule(&mut skeleton.rules, grounded, &gates, none)
          let missing: [Atom; 2] = [request.active, aliasMissing[each]]
          run Program.rule(&mut skeleton.rules, request.missing, &missing, none)
        }
        each = each + usize.ONE
      }
      let gates: [Atom; 1] = [request.active]
      let negative: [Atom; 2] = [grounded, impossible]
      run Program.rule(&mut skeleton.rules, request.missing, &gates, &negative)
      target = target + usize.ONE
    }
    at = at + usize.ONE
  }
  return move coverage
}

// One finite product over actual descriptor Cases. All atoms belong to the caller's Program;
// none of these records samples source/policy truth or creates a producer/source value.
struct InvocationDemand {
  operation: usize
  cell: usize
  state: Prepared.ResidualStateId
  active: Atom
  node: usize
}
impl Copy for InvocationDemand {}
struct InvocationNode {
  demand: usize
  cell: usize
  state: Prepared.ResidualStateId
  active: Atom
  declared: Atom
}
impl Copy for InvocationNode {}
union InvocationStepAuthority {
  SameComponent, Channel {map: MapId, stop: usize}, Contents {proof: usize},
  AliasIdentity {map: MapId, edge: usize},
}
impl Copy for InvocationStepAuthority {}
struct InvocationStep {
  later: usize
  earlier: usize
  case: usize
  authority: InvocationStepAuthority
  active: Atom
}
impl Copy for InvocationStep {}
union InvocationDeclarationAuthority {Entry {seed: usize}, Result {output: usize}, Step {step: usize}}
impl Copy for InvocationDeclarationAuthority {}
struct InvocationDeclaration {
  node: usize
  case: usize
  authority: InvocationDeclarationAuthority
  active: Atom
}
impl Copy for InvocationDeclaration {}
struct InvocationDeclaredOutput {
  demand: usize
  output: MapId
  sourceCell: usize
  source: ValueId
  target: ValueId
  active: Atom
}
impl Copy for InvocationDeclaredOutput {}
struct InvocationDeclaredPublication {
  declaration: usize
  output: usize
}
impl Copy for InvocationDeclaredPublication {}
struct InvocationOrigin {
  node: usize
  seedCase: usize
  seed: usize
  channel: usize
  producer: EvalId
  active: Atom
}
impl Copy for InvocationOrigin {}
struct InvocationCapture {
  origin: usize
  node: usize
  source: ResultsDescriptorSource
  endpoint: EndpointId
  active: Atom
}
impl Copy for InvocationCapture {}
union InvocationCaptureAuthority {
  SameComponent, Physical {map: MapId},
  Alias {descriptorCase: usize, componentCase: usize, descriptorEdge: usize, componentEdge: usize, map: MapId},
  Address {descriptorCase: usize, componentCase: usize, descriptorEdge: usize, componentEdge: usize},
}
impl Copy for InvocationCaptureAuthority {}
struct InvocationCaptureStep {
  source: usize
  target: usize
  carrier: usize
  authority: InvocationCaptureAuthority
  active: Atom
}
impl Copy for InvocationCaptureStep {}
/// Immutable actual history at a capture component. Cell ordinals belong to this Builder/Graph;
/// the witness fields are copied together, never joined independently by source identity.
pub struct InvocationCaptureCell {
  pub category: SourceRole
  pub cell: usize
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
}
impl Copy for InvocationCaptureCell {}
/// Disjoint original capture authorities. Holding retains its real filtered output and
/// the incoming acquisition Case separately from the producer component publication.
pub union InvocationCaptureAcquisition {
  Copy {pub source: InvocationCaptureCell},
  CaptureReborrow {pub origin: usize, pub source: InvocationCaptureCell},
  Reference {pub reference: usize},
  Holding {pub candidate: usize, pub case: usize, pub inputCase: usize,
    pub source: InvocationCaptureCell, pub output: InvocationCaptureCell},
}
impl Copy for InvocationCaptureAcquisition {}

/// case is the actual producer component Case; evaluation is the original observation
/// occurrence. A Holding's source role can differ from its Ownership output role.
pub struct InvocationCaptureSource {
  pub proof: usize
  pub binding: ResultsDescriptorSource
  pub producer: EvalId
  pub capture: usize
  pub case: usize
  pub evaluation: EvalId
  pub acquisition: InvocationCaptureAcquisition
  pub active: Atom
}
impl Copy for InvocationCaptureSource {}
pub struct InvocationCaptureValue {
  pub source: usize
  pub capture: usize
  pub current: InvocationCaptureCell
  pub active: Atom
}
impl Copy for InvocationCaptureValue {}
/// Both the descriptor carrier and actual component Case must execute. Reconverging paths
/// retain separate edges while the finite (source, capture, cell) coordinate is interned.
pub struct InvocationCaptureEdge {
  pub source: usize
  pub target: usize
  pub captureStep: usize
  pub descriptorCase: usize
  pub componentCase: usize
  pub active: Atom
}
impl Copy for InvocationCaptureEdge {}
struct InvocationSuffix {
  node: usize
  requestedRoot: Prepared.ResidualStateId
  requested: Prepared.ResidualStateId
  root: Prepared.ResidualStateId
  current: Prepared.ResidualStateId
  prefix: Option<Results.DescriptorPrefix>
  active: Atom
}
impl Copy for InvocationSuffix {}
union InvocationSuffixAuthority {
  SameComponent, AliasIdentity, Channel {root: Prepared.ChannelLiftId, current: Prepared.ChannelLiftId},
  Projection {root: Prepared.ChannelLiftId, current: Prepared.ChannelLiftId}, Contents {output: usize}
}
impl Copy for InvocationSuffixAuthority {}
struct InvocationSuffixStep {
  later: usize
  earlier: usize
  carrier: usize
  authority: InvocationSuffixAuthority
  active: Atom
}
impl Copy for InvocationSuffixStep {}
pub struct InvocationContributor {
  pub operation: usize
  pub producer: EvalId
  pub channel: usize
  pub origin: usize
  pub projection: Prepared.ContractProjectionId
  pub continuation: Option<Prepared.ContractContinuationId>
  pub selection: Prepared.ContractSelectionId
  pub active: Atom
}
impl Copy for InvocationContributor {}
struct InvocationPlacement {
  origin: usize
  suffix: Option<usize>
  projection: Prepared.ContractProjectionId
  continuation: Option<Prepared.ContractContinuationId>
  originalRoot: Option<Prepared.ContractContinuationId>
  selection: Prepared.ContractSelectionId
  active: Atom
}
impl Copy for InvocationPlacement {}
pub enum InvocationGapKind { Carrier, Producer, Capture, Output }
pub struct InvocationGap {
  pub operation: usize
  pub demand: usize
  pub node: usize
  pub case: usize
  pub kind: InvocationGapKind
  pub capture: Option<usize>
  pub suffix: Option<usize>
  carrier: Option<usize>
  applicable: Atom
  pub active: Atom
}
impl Copy for InvocationGap {}
struct InvocationEmission {
  capture: usize
  placement: usize
  route: ContractRouteId
  candidate: Results.Candidate
  active: Atom
}
impl Copy for InvocationEmission {}
/// Both original A projections remain explicit. root is the projection-pair entry; the two
/// continuation roots keep direct-root and descendant placements distinct at reconvergence.
pub struct InvocationCallPair {
  pub origin: usize
  pub channel: usize
  pub root: usize
  pub receiverProjection: Prepared.ContractProjectionId
  pub resultProjection: Prepared.ContractProjectionId
  pub receiverRoot: Option<Prepared.ContractContinuationId>
  pub resultRoot: Option<Prepared.ContractContinuationId>
  pub receiver: Option<Prepared.ContractContinuationId>
  pub result: Option<Prepared.ContractContinuationId>
  pub receiverSelection: Prepared.ContractSelectionId
  pub resultSelection: Prepared.ContractSelectionId
  pub outputMissing: Atom
  pub active: Atom
}
impl Copy for InvocationCallPair {}
pub struct InvocationCallEdge {
  pub source: usize
  pub target: usize
  pub active: Atom
}
impl Copy for InvocationCallEdge {}
pub struct InvocationCallContributor {
  pub pair: usize
  pub operation: usize
  pub output: usize
  pub contributor: usize
  pub active: Atom
}
impl Copy for InvocationCallContributor {}
pub struct InvocationCallOutput {
  pub pair: usize
  pub suffix: Option<usize>
  pub active: Atom
}
impl Copy for InvocationCallOutput {}
struct InvocationCallEmission {
  pair: usize
  candidate: Results.Candidate
  active: Atom
}
impl Copy for InvocationCallEmission {}
// Derived append-only Case lists retain original ordinal order. They select only the
// equality joins below; every authority, role, history and active gate is still checked.
struct InvocationCaseIndex {
  indexed: usize
  sources: List<List<usize>>
  targets: List<List<usize>>
  evaluations: List<List<usize>>
}
struct InvocationCaptureScan {
  cases: usize
  captures: usize
  steps: usize
  references: usize
}
impl Copy for InvocationCaptureScan {}
struct InvocationClosure {
  caseIndex: InvocationCaseIndex
  captureScan: Option<InvocationCaptureScan>
  callOutputsScanned: usize
  callOutputs: List<InvocationCallOutput>
  callPairs: List<InvocationCallPair>
  callEdges: List<InvocationCallEdge>
  callContributors: List<InvocationCallContributor>
  callEmissions: List<InvocationCallEmission>
  demands: List<InvocationDemand>
  nodes: List<InvocationNode>
  steps: List<InvocationStep>
  origins: List<InvocationOrigin>
  declarations: List<InvocationDeclaration>
  declaredOutputs: List<InvocationDeclaredOutput>
  declaredPublications: List<InvocationDeclaredPublication>
  captures: List<InvocationCapture>
  captureSteps: List<InvocationCaptureStep>
  suffixes: List<InvocationSuffix>
  suffixSteps: List<InvocationSuffixStep>
  contributors: List<InvocationContributor>
  placements: List<InvocationPlacement>
  emissions: List<InvocationEmission>
  captureSources: List<InvocationCaptureSource>
  captureValues: List<InvocationCaptureValue>
  captureEdges: List<InvocationCaptureEdge>
  gaps: List<InvocationGap>
  scanned: List<usize>
  contentsScanned: List<usize>
}
impl InvocationClosure {
  fn make() -> Self {
    return InvocationClosure {caseIndex: InvocationCaseIndex {indexed: usize.ZERO,
      sources: List<List<usize>>.make(), targets: List<List<usize>>.make(), evaluations: List<List<usize>>.make()},
      captureScan: Option<InvocationCaptureScan>.none(), callOutputsScanned: usize.ZERO, callOutputs: List<InvocationCallOutput>.make(), callPairs: List<InvocationCallPair>.make(), callEdges: List<InvocationCallEdge>.make(),
      callContributors: List<InvocationCallContributor>.make(), callEmissions: List<InvocationCallEmission>.make(), demands: List<InvocationDemand>.make(), nodes: List<InvocationNode>.make(),
      steps: List<InvocationStep>.make(), origins: List<InvocationOrigin>.make(),
      declarations: List<InvocationDeclaration>.make(), declaredOutputs: List<InvocationDeclaredOutput>.make(), declaredPublications: List<InvocationDeclaredPublication>.make(), captures: List<InvocationCapture>.make(),
      captureSteps: List<InvocationCaptureStep>.make(), suffixes: List<InvocationSuffix>.make(),
      suffixSteps: List<InvocationSuffixStep>.make(), contributors: List<InvocationContributor>.make(),
      placements: List<InvocationPlacement>.make(), emissions: List<InvocationEmission>.make(), captureSources: List<InvocationCaptureSource>.make(),
      captureValues: List<InvocationCaptureValue>.make(), captureEdges: List<InvocationCaptureEdge>.make(), gaps: List<InvocationGap>.make(), scanned: List<usize>.make(), contentsScanned: List<usize>.make()}
  }
  effect fn gap(self: &mut Self, program: &mut Program, node: usize, case: usize, kind: InvocationGapKind, capture: Option<usize>, carrier: Option<usize>, applicable: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let old = List<InvocationGap>.asSlice(&self.gaps)
    let mut at = usize.ZERO
    while at < old.length {
      let sameCapture = match old[at].capture {
        Option<usize>.Some {value} => match capture { Option<usize>.Some {value: other} => value == other _ => false }
        _ => match capture { Option<usize>.None => true _ => false }
      }
      let sameCarrier = match old[at].carrier {
        Option<usize>.Some {value} => match carrier { Option<usize>.Some {value: other} => value == other _ => false }
        _ => match carrier { Option<usize>.None => true _ => false }
      }
      if old[at].node == node && old[at].case == case && old[at].kind == kind && sameCapture && sameCarrier { return () }
      at = at + usize.ONE
    }
    let selected = List<InvocationNode>.asSlice(&self.nodes)[node]
    let active = Program.atom(&mut program.*)
    run List<InvocationGap>.append(&mut self.gaps, InvocationGap {operation: List<InvocationDemand>.asSlice(&self.demands)[selected.demand].operation, demand: selected.demand, node: node, case: case, kind: kind, capture: capture, suffix: Option<usize>.none(), carrier: carrier, applicable: applicable, active: active})
    return ()
  }
  effect fn node(self: &mut Self, program: &mut Program, demand: usize, cell: usize,
    state: Prepared.ResidualStateId) -> usize ! OutOfMemoryError ? &mut Allocator {
    let nodes = List<InvocationNode>.asSlice(&self.nodes)
    let mut at = usize.ZERO
    while at < nodes.length {
      if nodes[at].demand == demand && nodes[at].cell == cell && nodes[at].state.index == state.index { return at }
      at = at + usize.ONE
    }
    let id = nodes.length
    run List<InvocationNode>.append(&mut self.nodes, InvocationNode {demand: demand, cell: cell,
      state: state, active: Program.atom(&mut program.*), declared: Program.atom(&mut program.*)})
    run List<usize>.append(&mut self.scanned, usize.ZERO)
    run List<usize>.append(&mut self.contentsScanned, usize.ZERO)
    return id
  }
  effect fn edge(self: &mut Self, program: &mut Program, later: usize, earlier: usize,
    case: usize, authority: InvocationStepAuthority, applicable: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let nodes = List<InvocationNode>.asSlice(&self.nodes)
    let active = Program.atom(&mut program.*)
    let gates: [Atom; 2] = [nodes[later].active, applicable]
    let empty = List<Atom>.make()
    run Program.rule(&mut program.*, active, &gates, List<Atom>.asSlice(&empty))
    let admitted: [Atom; 1] = [active]
    run Program.rule(&mut program.*, nodes[earlier].active, &admitted, List<Atom>.asSlice(&empty))
    run List<InvocationStep>.append(&mut self.steps, InvocationStep {later: later, earlier: earlier,
      case: case, authority: authority, active: active})
    return ()
  }
  effect fn capture(self: &mut Self, program: &mut Program, origin: usize, node: usize,
    source: ResultsDescriptorSource, endpoint: EndpointId) -> usize ! OutOfMemoryError ? &mut Allocator {
    let rows = List<InvocationCapture>.asSlice(&self.captures)
    let mut at = usize.ZERO
    while at < rows.length {
      if rows[at].origin == origin && rows[at].node == node && Results.sameDescriptorSource(rows[at].source, source) && rows[at].endpoint.index == endpoint.index { return at }
      at = at + usize.ONE
    }
    let id = rows.length
    run List<InvocationCapture>.append(&mut self.captures, InvocationCapture {origin: origin, node: node,
      source: source, endpoint: endpoint, active: Program.atom(&mut program.*)})
    return id
  }
  effect fn suffix(self: &mut Self, program: &mut Program, node: usize, requestedRoot: Prepared.ResidualStateId,
    requested: Prepared.ResidualStateId, root: Prepared.ResidualStateId, current: Prepared.ResidualStateId,
    prefix: Option<Results.DescriptorPrefix>) -> usize
  ! OutOfMemoryError ? &mut Allocator {
    let rows = List<InvocationSuffix>.asSlice(&self.suffixes)
    let mut at = usize.ZERO
    while at < rows.length {
      if rows[at].node == node && rows[at].requestedRoot.index == requestedRoot.index && rows[at].requested.index == requested.index
        && rows[at].root.index == root.index && rows[at].current.index == current.index
        && Results.sameDescriptorPrefix(rows[at].prefix, prefix) { return at }
      at = at + usize.ONE
    }
    let id = rows.length
    run List<InvocationSuffix>.append(&mut self.suffixes, InvocationSuffix {node: node, requestedRoot: requestedRoot,
      requested: requested, root: root, current: current, prefix: prefix, active: Program.atom(&mut program.*)})
    return id
  }
}

effect fn indexInvocationCases(index: &mut InvocationCaseIndex, skeleton: &Skeleton, domain: &Domain) -> ()
! OutOfMemoryError ? &mut Allocator {
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let values = List<Value>.asSlice(&skeleton.values)
  while List<List<usize>>.length(&index.sources) < keys.length {
    run List<List<usize>>.append(&mut index.sources, List<usize>.make())
    run List<List<usize>>.append(&mut index.targets, List<usize>.make())
  }
  while List<List<usize>>.length(&index.evaluations) < List<Evaluation>.length(&skeleton.evaluations) {
    run List<List<usize>>.append(&mut index.evaluations, List<usize>.make())
  }
  let mut at = index.indexed
  if at > cases.length { return CompilerBug.panic(b"invocation Case inventory shrank") }
  while at < cases.length {
    let actual = &cases[at]
    if let Option<usize>.Some {value} = actual.source {
      let sources = List<List<usize>>.asMutSlice(&mut index.sources)
      run List<usize>.append(&mut sources[value], at)
    }
    let targets = List<List<usize>>.asMutSlice(&mut index.targets)
    run List<usize>.append(&mut targets[actual.target], at)
    let evaluation = values[keys[actual.target].value.index].evaluation
    let evaluations = List<List<usize>>.asMutSlice(&mut index.evaluations)
    run List<usize>.append(&mut evaluations[evaluation.index], at)
    at = at + usize.ONE
  }
  index.indexed = cases.length
  return ()
}

fn invocationPhysical(value: Value) -> bool {
  if operationSubject(value) { return false }
  if let Option<usize>.Some {..} = value.summary { return false }
  if let Option<usize>.Some {..} = value.writeHolder { return false }
  return true
}

// Exact authored states are already frozen. This lookup does not ask Type/Semantic a
// question or create a state; the caller supplies the authentic output map/paired boundary.
fn invocationState(states: &[Prepared.ResidualState], history: Prepared.ResidualStateId, input: ShapeId) -> Prepared.ResidualStateId {
  let requested = &states[history.index]
  let mut found = usize.MAX
  let mut at = usize.ZERO
  while at < states.length {
    if authoredResidual(&states[at]) && states[at].selection.index == requested.selection.index
      && states[at].vertex.index == requested.vertex.index && states[at].input.shape.index == input.index {
      if found != usize.MAX { return CompilerBug.panic(b"invocation suffix has an ambiguous frozen counterpart") }
      found = at
    }
    at = at + usize.ONE
  }
  if found == usize.MAX { return CompilerBug.panic(b"invocation output map has no frozen authored counterpart") }
  return Prepared.ResidualStateId {index: found}
}

fn invocationDescends(states: &[Prepared.ResidualState], root: Prepared.ResidualStateId,
  current: Prepared.ResidualStateId, remaining: usize) -> bool {
  if root.index == current.index { return true }
  if remaining == usize.ZERO { return false }
  let next = List<Prepared.ResidualStateId>.asSlice(&states[root.index].next)
  let mut at = usize.ZERO
  while at < next.length {
    if invocationDescends(states, next[at], current, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

// Reserve an actual receiver-cell demand once. The requested channel belongs to THIS Run,
// and the actual receiver Eval/usePoint comes from Traversal, not a same-node producer search.
effect fn invocationDemands<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let operations = List<Results.Operation>.asSlice(&skeleton.operationResults.operations)
  let rows = List<Prepared.Operation>.asSlice(&prepared.operations)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let selections = List<Selection>.asSlice(&prepared.selections)
  let values = List<Value>.asSlice(&skeleton.values)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let empty = List<Atom>.make()
  let mut operation = usize.ZERO
  while operation < operations.length {
    let actual = &operations[operation]
    let bridge = match &actual.plan {
      ResultsPlan.ExecuteEffect {result, ..} => Option<MapId>.some(result)
      ResultsPlan.CallableInvoke {channel: Option<usize>.Some {value}, ..} =>
        Option<MapId>.some(List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)[value].map)
      _ => Option<MapId>.none()
    }
    if let Option<MapId>.Some {value: result} = bridge {
      let receiver = match actual.receiver { Option<Results.Receiver>.Some {value} => value
        _ => { return CompilerBug.panic(b"Run result activation lost its actual receiver read") } }
      let row = &rows[actual.prepared]
      let mut state = usize.ZERO
      while state < states.length {
        let selected = &states[state]
        if authoredResidual(selected) && selected.vertex.index == maps[result.index].source.index
          && selected.input.shape.index == endpoints[receiver.endpoint.index].shape.index
          && selections[selected.selection.index].site.index == row.site.index
          && selections[selected.selection.index].root.index == receiver.endpoint.index {
          let mut cell = usize.ZERO
          while cell < keys.length {
            let value = values[keys[cell].value.index]
            if keys[cell].category == SourceRole.Physical && value.evaluation.index == receiver.actual.evaluation.index && value.endpoint.index == receiver.endpoint.index
              && value.phase == ValuePhase.Output && invocationPhysical(value) {
              let demands = List<InvocationDemand>.asSlice(&closure.demands)
              let mut found = false
              let mut prior = usize.ZERO
              while prior < demands.length {
                if demands[prior].operation == operation && demands[prior].cell == cell && demands[prior].state.index == state { found = true }
                prior = prior + usize.ONE
              }
              if !found {
                let id = demands.length
                let node = run InvocationClosure.node(&mut closure.*, &mut skeleton.rules, id, cell, Prepared.ResidualStateId {index: state})
                let active = List<InvocationNode>.asSlice(&closure.nodes)[node].active
                let gates: [Atom; 4] = [Flow.reachable(&skeleton.flow, receiver.actual.usePoint),
                  Flow.reachable(&skeleton.flow, actual.execute), Flow.reachable(&skeleton.flow, Skeleton.evaluation(&skeleton.*, actual.evaluation).point),
                  List<Cell>.asSlice(&domain.cells)[cell].present]
                run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
                run List<InvocationDemand>.append(&mut closure.demands, InvocationDemand {operation: operation,
                  cell: cell, state: Prepared.ResidualStateId {index: state}, active: active, node: node})
                // A suffix belongs to the exact actual output family. Its interpretation at
                // the receiver success is authorized by that Run's retained Contract map.
                let executeEffect = match &actual.plan { ResultsPlan.ExecuteEffect {..} => true _ => false }
                let mut root = usize.ZERO
                while executeEffect && root < states.length {
                  if authoredResidual(&states[root]) && states[root].input.shape.index == endpoints[maps[result.index].target.index].shape.index {
                    let requestedRoot = Prepared.ResidualStateId {index: root}
                    let rootState = invocationState(states, requestedRoot, endpoints[maps[result.index].source.index].shape)
                    let mut current = usize.ZERO
                    while current < states.length {
                      let requested = Prepared.ResidualStateId {index: current}
                      if invocationDescends(states, requestedRoot, requested, states.length) {
                        // Both suffix graphs retain the same authored vertices. Parent
                        // correspondence is validated while following the exact next edges.
                        let paired = invocationPairedState(states, requestedRoot, rootState, requested, states.length)
                        let suffix = run InvocationClosure.suffix(&mut closure.*, &mut skeleton.rules, node,
                          requestedRoot, requested, rootState, paired, Option<Results.DescriptorPrefix>.none())
                        let gate: [Atom; 1] = [active]
                        run Program.rule(&mut skeleton.rules, List<InvocationSuffix>.asSlice(&closure.suffixes)[suffix].active,
                          &gate, List<Atom>.asSlice(&empty))
                      }
                      current = current + usize.ONE
                    }
                  }
                  root = root + usize.ONE
                }
              }
            }
            cell = cell + usize.ONE
          }
        }
        state = state + usize.ONE
      }
    }
    operation = operation + usize.ONE
  }
  return ()
}

fn invocationPairedState(states: &[Prepared.ResidualState], requestedRoot: Prepared.ResidualStateId,
  root: Prepared.ResidualStateId, requested: Prepared.ResidualStateId, remaining: usize) -> Prepared.ResidualStateId {
  if requestedRoot.index == requested.index { return root }
  if remaining == usize.ZERO { return CompilerBug.panic(b"invocation suffix pairing contains a cycle") }
  let left = List<Prepared.ResidualStateId>.asSlice(&states[requestedRoot.index].next)
  let right = List<Prepared.ResidualStateId>.asSlice(&states[root.index].next)
  if left.length != right.length { return CompilerBug.panic(b"invocation output bridge lost a paired successor") }
  let mut at = usize.ZERO
  while at < left.length {
    if invocationDescends(states, left[at], requested, states.length) {
      let mut found = usize.MAX
      let mut each = usize.ZERO
      while each < right.length {
        if states[left[at].index].selection.index == states[right[each].index].selection.index
          && states[left[at].index].vertex.index == states[right[each].index].vertex.index {
          if found != usize.MAX { return CompilerBug.panic(b"invocation output bridge duplicated an authored successor") }
          found = each
        }
        each = each + usize.ONE
      }
      if found == usize.MAX { return CompilerBug.panic(b"invocation output bridge omitted an authored successor") }
      return invocationPairedState(states, left[at], right[found], requested, remaining - usize.ONE)
    }
    at = at + usize.ONE
  }
  return CompilerBug.panic(b"invocation requested suffix is outside its exact output root")
}

effect fn closeInvocationCases<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, descriptors: &DescriptorClosure) -> bool ! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let oldNodes = List<InvocationNode>.length(&closure.nodes)
  let oldEdges = List<InvocationStep>.length(&closure.steps)
  let mut index = usize.ZERO
  while index < List<InvocationNode>.length(&closure.nodes) {
    let node = List<InvocationNode>.asSlice(&closure.nodes)[index]
    let incoming = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[node.cell])
    let mut offset = List<usize>.asSlice(&closure.scanned)[index]
    while offset < incoming {
      let at = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[node.cell])[offset]
      let actual = &cases[at]
      if actual.target == node.cell {
        if let Option<usize>.Some {value: source} = actual.source {
          let from = List<Value>.asSlice(&skeleton.values)[keys[source].value.index]
          let into = List<Value>.asSlice(&skeleton.values)[keys[node.cell].value.index]
          if keys[source].leaf.index != keys[node.cell].leaf.index { return CompilerBug.panic(b"descriptor carrier changed its source identity") }
          if invocationPhysical(from) && invocationPhysical(into) {
            let authority = carrierAuthority(prepared, &skeleton.*, keys, actual)
            match authority {
              CarriersAuthority.SameComponent => {
                let predecessor = run InvocationClosure.node(&mut closure.*, &mut skeleton.rules, node.demand, source, node.state)
                run InvocationClosure.edge(&mut closure.*, &mut skeleton.rules, index, predecessor, at,
                  InvocationStepAuthority.SameComponent, actual.active)
              }
              CarriersAuthority.Physical {map, direction, ..} => {
                let oldSteps = List<InvocationStep>.length(&closure.steps)
                if let Option<usize>.Some {value: alias} = invocationAliasIdentity(prepared, &skeleton.*, keys, actual, node.state) {
                  let predecessor = run InvocationClosure.node(&mut closure.*, &mut skeleton.rules, node.demand, source, node.state)
                  run InvocationClosure.edge(&mut closure.*, &mut skeleton.rules, index, predecessor, at,
                    InvocationStepAuthority.AliasIdentity {map: map, edge: alias}, actual.active)
                }
                if direction == CarriersDirection.Forward {
                  let stops = List<Prepared.BoundaryStop>.asSlice(&maps[map.index].channelStops)
                  let mut pair = usize.ZERO
                  while pair < stops.length {
                    let stop = &stops[pair]
                    if stop.targetState.index == node.state.index {
                      if states[stop.sourceState.index].input.shape.index != valueShape(prepared, from).index
                        || states[stop.targetState.index].input.shape.index != valueShape(prepared, into).index {
                        return CompilerBug.panic(b"descriptor root channel pair changed its actual effective subjects")
                      }
                      let predecessor = run InvocationClosure.node(&mut closure.*, &mut skeleton.rules, node.demand, source, stop.sourceState)
                      run InvocationClosure.edge(&mut closure.*, &mut skeleton.rules, index, predecessor, at,
                        InvocationStepAuthority.Channel {map: map, stop: pair}, actual.active)
                    }
                    pair = pair + usize.ONE
                  }
                }
                if List<InvocationStep>.length(&closure.steps) == oldSteps {
                  if maps[map.index].componentTransport && direction == CarriersDirection.Forward {
                    return CompilerBug.panic(b"actual descriptor Copy/Place lost its frozen root channel pair")
                  }
                  run InvocationClosure.gap(&mut closure.*, &mut skeleton.rules, index, at, InvocationGapKind.Carrier, Option<usize>.none(), Option<usize>.none(), actual.active)
                }
              }
              // Exact canonical Address contents need their own retained paired channel
              // derivation; neither a contract result nor retention provenance is a copy.
              _ => run InvocationClosure.gap(&mut closure.*, &mut skeleton.rules, index, at, InvocationGapKind.Carrier, Option<usize>.none(), Option<usize>.none(), actual.active)
            }
          } else {
            run InvocationClosure.gap(&mut closure.*, &mut skeleton.rules, index, at, InvocationGapKind.Carrier, Option<usize>.none(), Option<usize>.none(), actual.active)
          }
        }
      }
      offset = offset + usize.ONE
    }
    let mutableRows8 = List<usize>.asMutSlice(&mut closure.scanned)
    mutableRows8[index] = incoming
    // Contents proofs arrive after the Address Case. They have their own append cursor.
    let proofs = List<ContentsChannelProof>.asSlice(&descriptors.contentsChannels)
    let mut proof = List<usize>.asSlice(&closure.contentsScanned)[index]
    while proof < proofs.length {
      let row = proofs[proof]
      let actual = &cases[row.case]
      if actual.target == node.cell && row.target.index == node.state.index {
        let source = match actual.source { Option<usize>.Some {value} => value
          _ => { return CompilerBug.panic(b"contents channel substituted a descriptor seed") } }
        let exact = match actual.authority { TransferAuthority.Address {edge, ..} => edge == row.edge _ => false }
        let from = List<Value>.asSlice(&skeleton.values)[keys[source].value.index]
        let into = List<Value>.asSlice(&skeleton.values)[keys[node.cell].value.index]
        if !exact || keys[source].leaf.index != keys[node.cell].leaf.index
          || states[row.source.index].input.shape.index != valueShape(prepared, from).index
          || states[row.target.index].input.shape.index != valueShape(prepared, into).index {
          return CompilerBug.panic(b"contents channel changed its actual Address Case or effective subjects")
        }
        if invocationPhysical(from) && invocationPhysical(into) {
          let active = run addressApplies(&mut skeleton.rules, actual.active, row.active)
          let earlier = run InvocationClosure.node(&mut closure.*, &mut skeleton.rules, node.demand, source, row.source)
          run InvocationClosure.edge(&mut closure.*, &mut skeleton.rules, index, earlier, row.case,
            InvocationStepAuthority.Contents {proof: proof}, active)
        }
      }
      proof = proof + usize.ONE
    }
    let mutableRows9 = List<usize>.asMutSlice(&mut closure.contentsScanned)
    mutableRows9[index] = proofs.length
    index = index + usize.ONE
  }
  return oldNodes != List<InvocationNode>.length(&closure.nodes) || oldEdges != List<InvocationStep>.length(&closure.steps)
}

// Entry declarations and their executed channel results are distinct from a locally
// constructed producer. This proof carries no capture layout or physical address.
fn invocationDeclaredChannel<'body>(prepared: &SourcePreparation<'body>, value: Value,
  state: Prepared.ResidualStateId) -> bool {
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let selected = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[state.index]
  if !authoredResidual(selected) || selected.input.shape.index != valueShape(prepared, value).index { return false }
  let component = residualComponent(shapes, selected.input)
  if component.inline || !sameSelector(&component.selector, &Selector.EffectSuccess) { return false }
  if let Option<Prepared.RepresentationId>.Some {value: representation} = component.representation {
    let rows = List<Prepared.Representation>.asSlice(&prepared.representations)
    return representation.index < rows.length && sameShapeContext(rows[representation.index].context,
      shapes[selected.input.shape.index].context)
  }
  return match &shapes[selected.input.shape.index].state { PreparedShapeState.Effect => true _ => false }
}

// An actual storage alias preserves this exact authored channel only through its
// retained Select Identity edge. Capture members still require separate Case evidence.
fn invocationAliasIdentity<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  keys: &[CellKey], actual: &Case, state: Prepared.ResidualStateId) -> Option<usize> {
  let source = match actual.source { Option<usize>.Some {value} => value
    _ => { return Option<usize>.none() } }
  let from = List<Value>.asSlice(&skeleton.values)[keys[source].value.index]
  let into = List<Value>.asSlice(&skeleton.values)[keys[actual.target].value.index]
  if !invocationPhysical(from) || !invocationPhysical(into) { return Option<usize>.none() }
  let authority = carrierAuthority(prepared, skeleton, keys, actual)
  if let CarriersAuthority.Physical {map, direction, address: Option<usize>.Some {value: edge}} = authority {
    let selected = &List<SelectionMap>.asSlice(&prepared.maps)[map.index]
    if direction != CarriersDirection.Forward || !selected.addressTransport || selected.componentTransport
      || selected.kind != MapKind.Select || !sameSelector(&selected.selector, &Selector.Identity)
      || selected.source.index != from.endpoint.index || selected.target.index != into.endpoint.index {
      return Option<usize>.none()
    }
    // The exact identity map is the authority; equal input shapes merely validate that
    // its unchanged authored cursor is applicable on both sides of that actual edge.
    let current = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[state.index]
    if !authoredResidual(current) || current.input.shape.index != valueShape(prepared, from).index
      || current.input.shape.index != valueShape(prepared, into).index {
      return Option<usize>.none()
    }
    return Option<usize>.some(edge)
  }
  return Option<usize>.none()
}

fn sameInvocationDeclaration(left: InvocationDeclarationAuthority, right: InvocationDeclarationAuthority) -> bool {
  return match left {
    InvocationDeclarationAuthority.Entry {seed} => match right { InvocationDeclarationAuthority.Entry {seed: other} => seed == other _ => false }
    InvocationDeclarationAuthority.Result {output} => match right { InvocationDeclarationAuthority.Result {output: other} => output == other _ => false }
    InvocationDeclarationAuthority.Step {step} => match right { InvocationDeclarationAuthority.Step {step: other} => step == other _ => false }
  }
}

effect fn invocationDeclaration(closure: &mut InvocationClosure, rules: &mut Program, node: usize, case: usize,
  authority: InvocationDeclarationAuthority, applicable: Atom, predecessor: Option<Atom>) -> () ! OutOfMemoryError ? &mut Allocator {
  let rows = List<InvocationDeclaration>.asSlice(&closure.declarations)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].node == node && rows[at].case == case && sameInvocationDeclaration(rows[at].authority, authority) { return () }
    at = at + usize.ONE
  }
  let selected = List<InvocationNode>.asSlice(&closure.nodes)[node]
  let active = Program.atom(&mut rules.*)
  let mut gates = List<Atom>.make()
  run List<Atom>.append(&mut gates, selected.active)
  run List<Atom>.append(&mut gates, applicable)
  if let Option<Atom>.Some {value} = predecessor { run List<Atom>.append(&mut gates, value) }
  run Program.rule(&mut rules.*, active, List<Atom>.asSlice(&gates), &[])
  run List<InvocationDeclaration>.append(&mut closure.declarations, InvocationDeclaration {
    node: node, case: case, authority: authority, active: active})
  let admitted: [Atom; 1] = [active]
  run Program.rule(&mut rules.*, selected.declared, &admitted, &[])
  return ()
}

effect fn closeInvocationDeclarations<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let nodes = List<InvocationNode>.length(&closure.nodes)
  let mut at = usize.ZERO
  while at < nodes {
    let node = List<InvocationNode>.asSlice(&closure.nodes)[at]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[node.demand]
    let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
    let execute = match &operation.plan { ResultsPlan.ExecuteEffect {..} => true _ => false }
    let key = keys[node.cell]
    let value = List<Value>.asSlice(&skeleton.values)[key.value.index]
    let local = match &List<Leaf>.asSlice(&skeleton.leaves)[key.leaf.index].kind {
      SourceLeaf.Entry {local: declaredLocal} => Option<LocalId>.some(declaredLocal) _ => Option<LocalId>.none() }
    if execute && key.category == SourceRole.Physical && invocationPhysical(value)
      && invocationDeclaredChannel(prepared, value, node.state) {
      if let Option<LocalId>.Some {value: entryLocal} = local {
        let incoming = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[node.cell])
        let mut offset = usize.ZERO
        while offset < incoming {
          let case = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[node.cell])[offset]
          let actual = &cases[case]
          if actual.target == node.cell {
            match actual.source {
              Option<usize>.None => {
                let entry = match Skeleton.evaluation(&skeleton.*, value.evaluation).site {
                  EvaluationSite.Entry {local: original} => original.index == entryLocal.index _ => false }
                let endpoint = &List<Endpoint>.asSlice(&prepared.endpoints)[value.endpoint.index]
                let storage = match &endpoint.root { Root.Local {local: original, category} =>
                  original.index == entryLocal.index && category == EndpointRole.Storage _ => false }
                if entry && storage && List<Leaf>.asSlice(&skeleton.leaves)[key.leaf.index].endpoint.index == value.endpoint.index {
                  let seeds = List<Seed>.asSlice(&skeleton.seeds)
                  let mut seed = usize.ZERO
                  while seed < seeds.length {
                    if seeds[seed].value.index == key.value.index && seeds[seed].leaf.index == key.leaf.index
                      && seeds[seed].direct == key.direct && List<usize>.asSlice(&domain.seedWitnesses)[seed] == key.witness {
                      run invocationDeclaration(&mut closure.*, &mut skeleton.rules, at, case,
                        InvocationDeclarationAuthority.Entry {seed: seed}, actual.active, Option<Atom>.none())
                    }
                    seed = seed + usize.ONE
                  }
                }
              }
              Option<usize>.Some {value: predecessor} => {
                if let TransferAuthority.DeclaredResult {output, sourceCell} = actual.authority {
                  let outputs = List<InvocationDeclaredOutput>.asSlice(&closure.declaredOutputs)
                  if output >= outputs.length { return CompilerBug.panic(b"declared invocation lost its prior result authority") }
                  let previous = outputs[output]
                  if predecessor != sourceCell || sourceCell != previous.sourceCell || previous.target.index != key.value.index {
                    return CompilerBug.panic(b"declared invocation changed its prior result Case")
                  }
                  run invocationDeclaration(&mut closure.*, &mut skeleton.rules, at, case,
                    InvocationDeclarationAuthority.Result {output: output}, actual.active, Option<Atom>.none())
                }
              }
            }
          }
          offset = offset + usize.ONE
        }
        let count = List<InvocationStep>.length(&closure.steps)
        let mut step = usize.ZERO
        while step < count {
          let edge = List<InvocationStep>.asSlice(&closure.steps)[step]
          if edge.later == at {
            let earlier = List<InvocationNode>.asSlice(&closure.nodes)[edge.earlier]
            run invocationDeclaration(&mut closure.*, &mut skeleton.rules, at, edge.case,
              InvocationDeclarationAuthority.Step {step: step}, edge.active, Option<Atom>.some(earlier.declared))
          }
          step = step + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  // Emit only an authenticated declaration alternative at the actual receiver. Keep
  // the original Entry leaf and witness; no source is inferred from an empty inventory.
  let count = List<InvocationDeclaration>.length(&closure.declarations)
  at = usize.ZERO
  while at < count {
    let declaration = List<InvocationDeclaration>.asSlice(&closure.declarations)[at]
    let node = List<InvocationNode>.asSlice(&closure.nodes)[declaration.node]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[node.demand]
    if declaration.node == demand.node {
      let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
      let result = match &operation.plan { ResultsPlan.ExecuteEffect {result: resultMap, ..} => resultMap
        _ => { return CompilerBug.panic(b"declared invocation substituted a callable producer") } }
      let evaluation = operation.evaluation
      let execution = operation.execute
      let receiver = match operation.receiver { Option<Results.Receiver>.Some {value} => value
        _ => { return CompilerBug.panic(b"declared invocation lost its actual receiver use") } }
      let resultPoint = Skeleton.evaluation(&skeleton.*, evaluation).point
      let executionReached = Flow.reachable(&skeleton.flow, execution)
      let resultReached = Flow.reachable(&skeleton.flow, resultPoint)
      let receiverReached = Flow.reachable(&skeleton.flow, receiver.actual.usePoint)
      let family = run transferFamily(List<Endpoint>.asSlice(&prepared.endpoints), List<SelectionMap>.asSlice(&prepared.maps), result)
      let members = List<MapId>.asSlice(&family)
      let mut member = usize.ZERO
      while member < members.length {
        let maps = List<SelectionMap>.asSlice(&prepared.maps)
        let output = members[member]
        let previous = List<InvocationDeclaredOutput>.asSlice(&closure.declaredOutputs)
        let mut found = usize.MAX
        let mut each = usize.ZERO
        while each < previous.length {
          if previous[each].demand == node.demand && previous[each].output.index == output.index { found = each }
          each = each + usize.ONE
        }
        if found == usize.MAX {
          let target = run Skeleton.value(&mut skeleton.*, evaluation, maps[output.index].target)
          let source = keys[node.cell].value
          found = List<InvocationDeclaredOutput>.length(&closure.declaredOutputs)
          let active = Program.atom(&mut skeleton.rules)
          run List<InvocationDeclaredOutput>.append(&mut closure.declaredOutputs, InvocationDeclaredOutput {
            demand: node.demand, output: output, sourceCell: node.cell, source: source, target: target, active: active})
          let absent = Program.atom(&mut skeleton.rules)
          run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: source, target: target,
            active: active, directness: Directness.Indirect, stored: absent, alternatives: absent,
            definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical,
            terminal: false, authority: TransferAuthority.DeclaredResult {output: found, sourceCell: node.cell}})
        }
        let links = List<InvocationDeclaredPublication>.asSlice(&closure.declaredPublications)
        let mut linked = false
        each = usize.ZERO
        while each < links.length {
          if links[each].declaration == at && links[each].output == found { linked = true }
          each = each + usize.ONE
        }
        if !linked {
          let target = List<InvocationDeclaredOutput>.asSlice(&closure.declaredOutputs)[found]
          run List<InvocationDeclaredPublication>.append(&mut closure.declaredPublications,
            InvocationDeclaredPublication {declaration: at, output: found})
          // Like ordinary operation results, publication requires the successful
          // result occurrence as well as the real receiver use and execution.
          let gates: [Atom; 4] = [declaration.active, receiverReached, executionReached, resultReached]
          run Program.rule(&mut skeleton.rules, target.active, &gates, &[])
        }
        member = member + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn invocationOrigins<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let seeds = List<Seed>.asSlice(&skeleton.seeds)
  let leaves = List<Leaf>.asSlice(&skeleton.leaves)
  let channels = List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let empty = List<Atom>.make()
  let mut at = usize.ZERO
  while at < List<InvocationNode>.length(&closure.nodes) {
    let node = List<InvocationNode>.asSlice(&closure.nodes)[at]
    let key = keys[node.cell]
    let value = values[key.value.index]
    let incoming = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[node.cell])
    let mut offset = usize.ZERO
    while offset < incoming {
      let case = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[node.cell])[offset]
      if cases[case].target == node.cell {
        if let Option<usize>.None = cases[case].source {
          let mut seed = usize.ZERO
          while seed < seeds.length {
            if seeds[seed].value.index == key.value.index && seeds[seed].leaf.index == key.leaf.index
              && seeds[seed].direct == key.direct && List<usize>.asSlice(&domain.seedWitnesses)[seed] == key.witness {
              let site = match Skeleton.evaluation(&skeleton.*, value.evaluation).site {
                EvaluationSite.Node {node: matchedSourceNode} => matchedSourceNode.index _ => usize.MAX
              }
              let genuine = match &leaves[key.leaf.index].kind {
                SourceLeaf.Expression {node: leafNode} => leafNode.index == site
                SourceLeaf.LoanFree {node: leafNode} => leafNode.index == site && match &List<Prepared.Shape>.asSlice(&prepared.shapes)[valueShape(prepared, value).index].state {
                  PreparedShapeState.KnownEmpty => true _ => false
                }
                _ => false
              }
              if genuine && invocationPhysical(value) && leaves[key.leaf.index].endpoint.index == value.endpoint.index {
                let mut channel = usize.ZERO
                while channel < channels.length {
                  let original = &channels[channel]
                  let demand = List<InvocationDemand>.asSlice(&closure.demands)[node.demand]
                  let called = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
                  let callable = match &called.plan { ResultsPlan.CallableInvoke {..} => true _ => false }
                  let mut port = PreparedContractPort.Success
                  if callable { port = PreparedContractPort.Result }
                  if original.site.index == site && original.descriptor.index == value.endpoint.index
                    && original.channel == port {
                    // Only an already constructed Effect has a direct Success channel.
                    let target = &List<Endpoint>.asSlice(&prepared.endpoints)[maps[original.map.index].target.index]
                    let direct = match target.parent { Option<EndpointId>.Some {value: parent} => parent.index == original.descriptor.index _ => false }
                    let mut selector = Selector.EffectSuccess
                    if callable { selector = Selector.CallableResult }
                    if direct && sameSelector(&target.selector, &selector) {
                      if states[node.state.index].output.index != target.shape.index {
                        return CompilerBug.panic(b"actual Effect channel cursor lost its producer output shape")
                      }
                      let origins = List<InvocationOrigin>.asSlice(&closure.origins)
                      let mut found = false
                      let mut each = usize.ZERO
                      while each < origins.length {
                        if origins[each].node == at && origins[each].seedCase == case && origins[each].seed == seed && origins[each].channel == channel { found = true }
                        each = each + usize.ONE
                      }
                      if !found {
                        let origin = origins.length
                        let active = Program.atom(&mut skeleton.rules)
                        let gates: [Atom; 2] = [node.active, cases[case].active]
                        run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
                        run List<InvocationOrigin>.append(&mut closure.origins, InvocationOrigin {node: at, seedCase: case,
                          seed: seed, channel: channel, producer: value.evaluation, active: active})
                        let sources = run Results.descriptorSources(prepared, channel)
                        let sourcesSelected = List<ResultsDescriptorSource>.asSlice(&sources)
                        let mut input = usize.ZERO
                        while input < sourcesSelected.length {
                          let id = run InvocationClosure.capture(&mut closure.*, &mut skeleton.rules, origin, at,
                            sourcesSelected[input], maps[Results.descriptorMap(sourcesSelected[input]).index].target)
                          let admitted: [Atom; 1] = [active]
                          run Program.rule(&mut skeleton.rules, List<InvocationCapture>.asSlice(&closure.captures)[id].active,
                            &admitted, List<Atom>.asSlice(&empty))
                          input = input + usize.ONE
                        }
                      }
                    }
                  }
                  channel = channel + usize.ONE
                }
              }
            }
            seed = seed + usize.ONE
          }
          let origins = List<InvocationOrigin>.asSlice(&closure.origins)
          let mut known = false
          let mut existing = usize.ZERO
          while existing < origins.length {
            if origins[existing].node == at && origins[existing].seedCase == case { known = true }
            existing = existing + usize.ONE
          }
          if !known { run InvocationClosure.gap(&mut closure.*, &mut skeleton.rules, at, case, InvocationGapKind.Producer, Option<usize>.none(), Option<usize>.none(), cases[case].active) }
        }
      }
      offset = offset + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn invocationCaptureMemberStep<'body>(prepared: &SourcePreparation<'body>, parent: MapId, child: MapId,
  before: Prepared.ResidualStateId, after: Prepared.ResidualStateId) -> bool {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let children = List<MapId>.asSlice(&maps[parent.index].children)
  let mut exact = false
  let mut at = usize.ZERO
  while at < children.length { if children[at].index == child.index { exact = true } at = at + usize.ONE }
  let state = &states[after.index]
  let component = &List<Prepared.Component>.asSlice(&shapes[state.input.shape.index].components)[state.input.ordinal]
  return exact && containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[before.index].next), after)
    && authoredResidual(state) && component.inline
    && sameSelector(&component.selector, &endpoints[maps[child.index].target.index].selector)
}

// Address captures use the physical referent family, independently of the descriptor's
// semantic channel. Each parent edge pairs an original map child with an authored next.
fn invocationOriginMember<'body>(prepared: &SourcePreparation<'body>, descriptors: &DescriptorClosure,
  root: usize, member: usize) -> bool {
  let placements = List<OriginPlacement>.asSlice(&descriptors.placements)
  if root >= placements.length || member >= placements.length { return false }
  let mut current = member
  let mut remaining = placements.length
  while remaining > usize.ZERO {
    let child = placements[current]
    if child.proof != placements[root].proof { return false }
    if current == root { return true }
    let parent = match child.parent { Option<usize>.Some {value} => value _ => { return false } }
    if parent >= current { return false }
    let prior = placements[parent]
    if !invocationCaptureMemberStep(prepared, prior.member, child.member, prior.state, child.state) { return false }
    current = parent
    remaining = remaining - usize.ONE
  }
  return false
}

// Selected is one actual value/place projection. The explicit map family supplies both
// component paths; canonical storage must remain below the SAME actual descriptor holder.
fn invocationSelectedMember<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  rootEdge: AliasEdge, memberEdge: AliasEdge) -> bool {
  let selected = match rootEdge.authority { AliasAuthority.Selected {selection, ..} => selection _ => { return false } }
  let root = match rootEdge.authority { AliasAuthority.Selected {map, ..} => map _ => { return false } }
  let memberSelection = match memberEdge.authority { AliasAuthority.Selected {selection, ..} => selection _ => { return false } }
  if memberSelection != selected { return false }
  let member = match memberEdge.authority { AliasAuthority.Selected {map, ..} => map _ => { return false } }
  let selections = List<SelectionUse>.asSlice(&skeleton.selections)
  if selected >= selections.length { return false }
  let request = &selections[selected]
  let family = match request.place { Option<MapId>.Some {value} => value _ => { return false } }
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  if !Results.inFamily(maps, family, root) || !Results.inFamily(maps, root, member) { return false }
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let rootSource = match rootEdge.source { Option<usize>.Some {value} => value _ => { return false } }
  let memberSource = match memberEdge.source { Option<usize>.Some {value} => value _ => { return false } }
  let before = aliases[rootSource]
  let child = aliases[memberSource]
  let after = aliases[rootEdge.target]
  let childAfter = aliases[memberEdge.target]
  if maps[root.index].kind != MapKind.Select || maps[member.index].kind != MapKind.Select
    || before.endpoint.index != maps[root.index].source.index || after.endpoint.index != maps[root.index].target.index
    || child.endpoint.index != maps[member.index].source.index || childAfter.endpoint.index != maps[member.index].target.index
    || before.evaluation.index != request.operand.index || child.evaluation.index != request.operand.index
    || after.evaluation.index != request.result.index || childAfter.evaluation.index != request.result.index
    || !sameStorage(before.storage, after.storage) || !sameStorage(child.storage, childAfter.storage)
    || !sameTemporary(before.storage.temporary, child.storage.temporary) { return false }
  // This validates the supplied canonical/member pair against the frozen paired map family.
  // The descriptor edge already names the owner; no endpoint ancestry chooses an owner here.
  return sameComponentSuffix(List<Endpoint>.asSlice(&prepared.endpoints), child.storage.endpoint, before.storage.endpoint,
    maps[member.index].source, maps[root.index].source)
}

// An element's inline family remains on one actual slice conversion proof/partition AND
// one source Origin tree. The latter is a separate current-storage leg, never a snapshot.
fn invocationSliceMember<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  descriptors: &DescriptorClosure, root: usize, member: usize) -> bool {
  let placements = List<SlicePlacement>.asSlice(&descriptors.slicePlacements)
  let origins = List<OriginPlacement>.asSlice(&descriptors.placements)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  if root >= placements.length || member >= placements.length { return false }
  let original = placements[root]
  let mut current = member
  let mut remaining = placements.length
  while remaining > usize.ZERO {
    let child = placements[current]
    if child.proof != original.proof || child.element != original.element
      || child.origin >= origins.length || child.edge >= edges.length { return false }
    let retained = match edges[child.edge].authority { AliasAuthority.Origin {placement} => placement == child.origin _ => false }
    if !retained { return false }
    if current == root { return true }
    let parent = match child.parent { Option<usize>.Some {value} => value _ => { return false } }
    if parent >= current { return false }
    let prior = placements[parent]
    let originParent = match origins[child.origin].parent { Option<usize>.Some {value} => value == prior.origin _ => false }
    if !originParent || !invocationOriginMember(prepared, descriptors, prior.origin, child.origin)
      || !invocationCaptureMemberStep(prepared, prior.member, child.member, prior.state, child.state) { return false }
    current = parent
    remaining = remaining - usize.ONE
  }
  return false
}

// The descriptor and member have separate private current-read lanes. Pair only their
// actual Address Cases and their original selected/Origin/slice family, never output identity.
fn invocationAddressCapture<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  domain: &Domain, descriptors: &DescriptorClosure, carrier: InvocationStep, endpoint: EndpointId,
  componentCase: usize) -> Option<InvocationCaptureAuthority> {
  let proof = match carrier.authority { InvocationStepAuthority.Contents {proof} => proof
    _ => { return Option<InvocationCaptureAuthority>.none() } }
  let row = List<ContentsChannelProof>.asSlice(&descriptors.contentsChannels)[proof]
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  if row.case != carrier.case || componentCase >= cases.length { return Option<InvocationCaptureAuthority>.none() }
  let descriptor = &cases[carrier.case]
  let actual = &cases[componentCase]
  let descriptorEdge = match descriptor.authority { TransferAuthority.Address {edge, ..} => edge _ => { return Option<InvocationCaptureAuthority>.none() } }
  if descriptorEdge != row.edge { return Option<InvocationCaptureAuthority>.none() }
  let direction = match descriptor.authority { TransferAuthority.Address {direction, ..} => direction _ => { return Option<InvocationCaptureAuthority>.none() } }
  let componentDirection = match actual.authority { TransferAuthority.Address {direction: matchedDirection, ..} => matchedDirection _ => { return Option<InvocationCaptureAuthority>.none() } }
  if direction != componentDirection { return Option<InvocationCaptureAuthority>.none() }
  let componentEdge = match actual.authority { TransferAuthority.Address {edge, ..} => edge _ => { return Option<InvocationCaptureAuthority>.none() } }
  let geometry = match edges[row.edge].authority {
    AliasAuthority.Origin {placement: root} => match edges[componentEdge].authority {
      AliasAuthority.Origin {placement: member} => invocationOriginMember(prepared, descriptors, root, member)
      _ => false
    }
    AliasAuthority.Selected {..} => invocationSelectedMember(prepared, skeleton, edges[row.edge], edges[componentEdge])
    AliasAuthority.Slice {placement: root} => match edges[componentEdge].authority {
      AliasAuthority.Slice {placement: member} => invocationSliceMember(prepared, skeleton, descriptors, root, member)
      _ => false
    }
    _ => false
  }
  if !geometry { return Option<InvocationCaptureAuthority>.none() }
  let before = match descriptor.source { Option<usize>.Some {value} => value
    _ => { return Option<InvocationCaptureAuthority>.none() } }
  let source = match actual.source { Option<usize>.Some {value} => value
    _ => { return Option<InvocationCaptureAuthority>.none() } }
  let from = values[keys[source].value.index]
  let into = values[keys[actual.target].value.index]
  let descriptorFrom = values[keys[before].value.index]
  let descriptorInto = values[keys[descriptor.target].value.index]
  if from.endpoint.index != endpoint.index || !invocationPhysical(from) || !invocationPhysical(into)
    || from.evaluation.index != into.evaluation.index || from.evaluation.index != descriptorFrom.evaluation.index
    || into.evaluation.index != descriptorInto.evaluation.index || keys[source].leaf.index != keys[actual.target].leaf.index
    || keys[source].category != keys[actual.target].category || keys[before].category != SourceRole.Physical
    || keys[descriptor.target].category != SourceRole.Physical {
    return Option<InvocationCaptureAuthority>.none()
  }
  // These checks retain the exact endpoint/alias/use correspondence on both lanes. Neither
  // lane's request identity is substituted for the other's component-specific read witness.
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let requests = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  validateAddressTransfer(values, aliases, edges, requests, keys[before].value, keys[descriptor.target].value, row.edge, direction)
  validateAddressTransfer(values, aliases, edges, requests, keys[source].value, keys[actual.target].value, componentEdge, direction)
  return Option<InvocationCaptureAuthority>.some(InvocationCaptureAuthority.Address {
    descriptorCase: carrier.case, componentCase: componentCase, descriptorEdge: row.edge, componentEdge: componentEdge})
}

// A storage-alias descriptor and its capture use distinct private lanes. Authenticate
// the actual member Case and canonical suffix in the SAME frozen map family and occurrence.
fn invocationAliasCapture<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  domain: &Domain, carrier: InvocationStep, endpoint: EndpointId, componentCase: usize) -> Option<InvocationCaptureAuthority> {
  let root = match carrier.authority { InvocationStepAuthority.AliasIdentity {map, ..} => map
    _ => { return Option<InvocationCaptureAuthority>.none() } }
  let rootEdge = match carrier.authority { InvocationStepAuthority.AliasIdentity {edge, ..} => edge
    _ => { return Option<InvocationCaptureAuthority>.none() } }
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let descriptor = &cases[carrier.case]
  let actual = &cases[componentCase]
  let before = match descriptor.source { Option<usize>.Some {value} => value _ => { return Option<InvocationCaptureAuthority>.none() } }
  let source = match actual.source { Option<usize>.Some {value} => value _ => { return Option<InvocationCaptureAuthority>.none() } }
  let address = match descriptor.authority {
    TransferAuthority.Physical {address: Option<EvalId>.Some {value}, ..} => value
    _ => { return Option<InvocationCaptureAuthority>.none() }
  }
  let member = match actual.authority {
    TransferAuthority.Physical {map, direction, address: Option<EvalId>.Some {value}}
      if direction == MapDirection.Forward && value.index == address.index => map
    _ => { return Option<InvocationCaptureAuthority>.none() }
  }
  let from = values[keys[source].value.index]
  let into = values[keys[actual.target].value.index]
  let descriptorFrom = values[keys[before].value.index]
  let descriptorInto = values[keys[descriptor.target].value.index]
  let selected = &maps[member.index]
  if !Results.inFamily(maps, root, member) || selected.kind != MapKind.Select
    || !selected.addressTransport || selected.componentTransport || !sameSelector(&selected.selector, &Selector.Identity)
    || selected.source.index != endpoint.index || from.endpoint.index != selected.source.index
    || into.endpoint.index != selected.target.index || !invocationPhysical(from) || !invocationPhysical(into)
    || from.evaluation.index != into.evaluation.index || from.evaluation.index != descriptorFrom.evaluation.index
    || into.evaluation.index != descriptorInto.evaluation.index || keys[source].leaf.index != keys[actual.target].leaf.index
    || keys[source].category != keys[actual.target].category
    || valueShape(prepared, from).index != valueShape(prepared, into).index { return Option<InvocationCaptureAuthority>.none() }
  let componentEdge = carrierAliasEdge(skeleton, from, into, member, MapDirection.Forward, address)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let parent = aliases[edges[rootEdge].target]
  let child = aliases[edges[componentEdge].target]
  if parent.evaluation.index != child.evaluation.index || !sameTemporary(parent.storage.temporary, child.storage.temporary)
    || !sameComponentSuffix(List<Endpoint>.asSlice(&prepared.endpoints), child.storage.endpoint, parent.storage.endpoint,
      selected.source, maps[root.index].source) { return Option<InvocationCaptureAuthority>.none() }
  return Option<InvocationCaptureAuthority>.some(InvocationCaptureAuthority.Alias {
    descriptorCase: carrier.case, componentCase: componentCase, descriptorEdge: rootEdge, componentEdge: componentEdge, map: member})
}

fn sameInvocationCaptureAuthority(left: InvocationCaptureAuthority, right: InvocationCaptureAuthority) -> bool {
  return match left {
    InvocationCaptureAuthority.SameComponent => match right { InvocationCaptureAuthority.SameComponent => true _ => false }
    InvocationCaptureAuthority.Alias {descriptorCase, componentCase, descriptorEdge, componentEdge, map} => match right {
      InvocationCaptureAuthority.Alias {descriptorCase: otherDescriptor, componentCase: otherCase, descriptorEdge: otherRoot,
        componentEdge: otherEdge, map: otherMap} => descriptorCase == otherDescriptor && componentCase == otherCase
          && descriptorEdge == otherRoot && componentEdge == otherEdge && map.index == otherMap.index
      _ => false
    }
    InvocationCaptureAuthority.Physical {map} => match right { InvocationCaptureAuthority.Physical {map: other} => map.index == other.index _ => false }
    InvocationCaptureAuthority.Address {descriptorCase, componentCase, descriptorEdge, componentEdge} => match right {
      InvocationCaptureAuthority.Address {descriptorCase: otherDescriptorCase, componentCase: otherComponentCase,
        descriptorEdge: otherDescriptorEdge, componentEdge: otherComponentEdge} => descriptorCase == otherDescriptorCase
        && componentCase == otherComponentCase && descriptorEdge == otherDescriptorEdge && componentEdge == otherComponentEdge
      _ => false
    }
  }
}

fn invocationCaptureCase(authority: InvocationCaptureAuthority, actual: &Case, index: usize) -> bool {
  return match authority {
    InvocationCaptureAuthority.SameComponent => match actual.authority { TransferAuthority.SameComponent => true _ => false }
    InvocationCaptureAuthority.Alias {componentCase, map: member, ..} => index == componentCase && match actual.authority {
      TransferAuthority.Physical {map, direction, ..} => map.index == member.index && direction == MapDirection.Forward
      _ => false
    }
    InvocationCaptureAuthority.Physical {map: member} => match actual.authority {
      TransferAuthority.Physical {map, direction: matchedOrientation, ..} if matchedOrientation == MapDirection.Forward => map.index == member.index
      _ => false
    }
    InvocationCaptureAuthority.Address {componentCase, componentEdge, ..} => index == componentCase && match actual.authority {
      TransferAuthority.Address {edge, ..} => edge == componentEdge
      _ => false
    }
  }
}

// Capture coordinates advance over the SAME actual descriptor Cases used by the backward
// demand. The input leaf comes from the resulting current receiver component, never the seed.
effect fn closeInvocationCaptures<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, descriptors: &DescriptorClosure) -> () ! OutOfMemoryError ? &mut Allocator {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let empty = List<Atom>.make()
  let mut at = usize.ZERO
  while at < List<InvocationCapture>.length(&closure.captures) {
    let capture = List<InvocationCapture>.asSlice(&closure.captures)[at]
    let mut step = usize.ZERO
    while step < List<InvocationStep>.length(&closure.steps) {
      let edge = List<InvocationStep>.asSlice(&closure.steps)[step]
      if edge.earlier == capture.node {
        let mut endpoints = List<EndpointId>.make()
        let mut authorities = List<InvocationCaptureAuthority>.make()
        match edge.authority {
          InvocationStepAuthority.Contents {..} => {
            let descriptor = List<InvocationNode>.asSlice(&closure.nodes)[edge.later]
            let evaluation = values[keys[descriptor.cell].value.index].evaluation
            let incoming = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.evaluations)[evaluation.index])
            let mut offset = usize.ZERO
            while offset < incoming {
              let case = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.evaluations)[evaluation.index])[offset]
              if let Option<InvocationCaptureAuthority>.Some {value} = invocationAddressCapture(
                prepared, &skeleton.*, domain, descriptors, edge, capture.endpoint, case) {
                run List<EndpointId>.append(&mut endpoints, values[keys[cases[case].target].value.index].endpoint)
                run List<InvocationCaptureAuthority>.append(&mut authorities, value)
              }
              offset = offset + usize.ONE
            }
          }
          InvocationStepAuthority.AliasIdentity {..} => {
            let descriptor = List<InvocationNode>.asSlice(&closure.nodes)[edge.later]
            let evaluation = values[keys[descriptor.cell].value.index].evaluation
            let incoming = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.evaluations)[evaluation.index])
            let mut offset = usize.ZERO
            while offset < incoming {
              let case = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.evaluations)[evaluation.index])[offset]
              if let Option<InvocationCaptureAuthority>.Some {value} = invocationAliasCapture(
                prepared, &skeleton.*, domain, edge, capture.endpoint, case) {
                run List<EndpointId>.append(&mut endpoints, values[keys[cases[case].target].value.index].endpoint)
                run List<InvocationCaptureAuthority>.append(&mut authorities, value)
              }
              offset = offset + usize.ONE
            }
          }
          InvocationStepAuthority.SameComponent => {
            run List<EndpointId>.append(&mut endpoints, capture.endpoint)
            run List<InvocationCaptureAuthority>.append(&mut authorities, InvocationCaptureAuthority.SameComponent)
          }
          InvocationStepAuthority.Channel {map, ..} => {
            let family = run Results.mapFamily(maps, map)
            let familySelected = List<MapId>.asSlice(&family)
            let mut each = usize.ZERO
            while each < familySelected.length {
              if maps[familySelected[each].index].source.index == capture.endpoint.index {
                run List<EndpointId>.append(&mut endpoints, maps[familySelected[each].index].target)
                run List<InvocationCaptureAuthority>.append(&mut authorities, InvocationCaptureAuthority.Physical {map: familySelected[each]})
              }
              each = each + usize.ONE
            }
          }
        }
        let guarded = match edge.authority {
          InvocationStepAuthority.Contents {..} => true
          InvocationStepAuthority.AliasIdentity {..} => true
          _ => false
        }
        if List<EndpointId>.length(&endpoints) == usize.ZERO || guarded {
          let recorded = List<InvocationGap>.asSlice(&closure.gaps)
          let mut found = false
          let mut before = usize.ZERO
          while before < recorded.length {
            if recorded[before].node == edge.later && recorded[before].case == edge.case && recorded[before].kind == InvocationGapKind.Capture {
              if let Option<usize>.Some {value} = recorded[before].capture {
                if let Option<usize>.Some {value: carrier} = recorded[before].carrier {
                  if value == at && carrier == step { found = true }
                }
              }
            }
            before = before + usize.ONE
          }
          if !found {
            let missing = Program.atom(&mut skeleton.rules)
            let gates: [Atom; 2] = [capture.active, edge.active]
            run Program.rule(&mut skeleton.rules, missing, &gates, List<Atom>.asSlice(&empty))
            run InvocationClosure.gap(&mut closure.*, &mut skeleton.rules, edge.later, edge.case, InvocationGapKind.Capture,
              Option<usize>.some(at), Option<usize>.some(step), missing)
          }
        }
        let endpointsSelected = List<EndpointId>.asSlice(&endpoints)
        let authoritiesSelected = List<InvocationCaptureAuthority>.asSlice(&authorities)
        let mut each = usize.ZERO
        while each < endpointsSelected.length {
          let target = run InvocationClosure.capture(&mut closure.*, &mut skeleton.rules, capture.origin, edge.later,
            capture.source, endpointsSelected[each])
          let old = List<InvocationCaptureStep>.asSlice(&closure.captureSteps)
          let mut found = false
          let mut previous = usize.ZERO
          while previous < old.length {
            if old[previous].source == at && old[previous].target == target && old[previous].carrier == step
              && sameInvocationCaptureAuthority(old[previous].authority, authoritiesSelected[each]) { found = true }
            previous = previous + usize.ONE
          }
          if !found {
            let active = Program.atom(&mut skeleton.rules)
            match authoritiesSelected[each] {
              // The member Case must start at an actual carried capture cell. Its rule is
              // added by closeInvocationCaptureValues, including both original Case gates.
              InvocationCaptureAuthority.Address {..} => ()
              InvocationCaptureAuthority.Alias {..} => ()
              _ => {
                let gates: [Atom; 2] = [capture.active, edge.active]
                run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
              }
            }
            let admitted: [Atom; 1] = [active]
            run Program.rule(&mut skeleton.rules, List<InvocationCapture>.asSlice(&closure.captures)[target].active,
              &admitted, List<Atom>.asSlice(&empty))
            run List<InvocationCaptureStep>.append(&mut closure.captureSteps, InvocationCaptureStep {
              source: at, target: target, carrier: step, authority: authoritiesSelected[each], active: active})
          }
          each = each + usize.ONE
        }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

fn invocationCaptureCell(domain: &Domain, cell: usize) -> InvocationCaptureCell {
  let key = List<CellKey>.asSlice(&domain.keys)[cell]
  let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
  return InvocationCaptureCell {category: key.category, cell: cell, value: key.value, leaf: key.leaf, direct: key.direct,
    definition: witness.definition, read: witness.read}
}

fn validateInvocationCaptureCell(domain: &Domain, actual: InvocationCaptureCell) -> () {
  let keys = List<CellKey>.asSlice(&domain.keys)
  if actual.cell >= keys.length { return CompilerBug.panic(b"capture correspondence lost its actual cell") }
  let key = keys[actual.cell]
  let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
  let definition = match actual.definition {
    Option<DefinitionId>.Some {value} => match witness.definition { Option<DefinitionId>.Some {value: other} => value.index == other.index _ => false }
    _ => match witness.definition { Option<DefinitionId>.None => true _ => false }
  }
  let read = match actual.read {
    Option<ReadId>.Some {value} => match witness.read { Option<ReadId>.Some {value: other} => value.index == other.index _ => false }
    _ => match witness.read { Option<ReadId>.None => true _ => false }
  }
  if actual.category != key.category || actual.value.index != key.value.index || actual.leaf.index != key.leaf.index || actual.direct != key.direct || !definition || !read {
    CompilerBug.panic(b"capture correspondence changed its actual value or paired definition/read history")
  }
  return ()
}

effect fn invocationCaptureValue(closure: &mut InvocationClosure, program: &mut Program,
  domain: &Domain, source: usize, capture: usize, cell: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let old = List<InvocationCaptureValue>.asSlice(&closure.captureValues)
  let mut at = usize.ZERO
  while at < old.length {
    if old[at].source == source && old[at].capture == capture && old[at].current.cell == cell { return at }
    at = at + usize.ONE
  }
  let id = old.length
  run List<InvocationCaptureValue>.append(&mut closure.captureValues, InvocationCaptureValue {
    source: source, capture: capture, current: invocationCaptureCell(domain, cell), active: Program.atom(&mut program.*)})
  return id
}

fn sameInvocationCaptureAcquisition(left: InvocationCaptureAcquisition, right: InvocationCaptureAcquisition) -> bool {
  return match left {
    InvocationCaptureAcquisition.Copy {source} => match right {
      InvocationCaptureAcquisition.Copy {source: other} => source.cell == other.cell
      _ => false
    }
    InvocationCaptureAcquisition.CaptureReborrow {origin, source} => match right {
      InvocationCaptureAcquisition.CaptureReborrow {origin: other, source: before} => origin == other && source.cell == before.cell
      _ => false
    }
    InvocationCaptureAcquisition.Reference {reference} => match right {
      InvocationCaptureAcquisition.Reference {reference: other} => reference == other
      _ => false
    }
    InvocationCaptureAcquisition.Holding {candidate, case, inputCase, source, output} => match right {
      InvocationCaptureAcquisition.Holding {candidate: other, case: otherCase, inputCase: otherInput,
        source: before, output: after} => candidate == other && case == otherCase && inputCase == otherInput
          && source.cell == before.cell && output.cell == after.cell
      _ => false
    }
  }
}

// Intern original primitive Cases, not a path of prior capture generations. Every arrival
// consumes this source through the existing (source, capture, current cell) product.
effect fn reserveInvocationCaptureSource(closure: &mut InvocationClosure, program: &mut Program,
  domain: &Domain, capture: usize, case: usize, evaluation: EvalId, acquisition: InvocationCaptureAcquisition) -> ()
! OutOfMemoryError ? &mut Allocator {
  let old = List<InvocationCaptureSource>.asSlice(&closure.captureSources)
  let mut at = usize.ZERO
  while at < old.length {
    if old[at].capture == capture && old[at].case == case
      && sameInvocationCaptureAcquisition(old[at].acquisition, acquisition) { return () }
    at = at + usize.ONE
  }
  let selected = List<InvocationCapture>.asSlice(&closure.captures)[capture]
  let origin = List<InvocationOrigin>.asSlice(&closure.origins)[selected.origin]
  let cases = List<Case>.asSlice(&domain.cases)
  let active = Program.atom(&mut program.*)
  match acquisition {
    InvocationCaptureAcquisition.Holding {case: holding, inputCase, ..} => {
      let gates: [Atom; 4] = [selected.active, cases[case].active, cases[holding].active, cases[inputCase].active]
      run Program.rule(&mut program.*, active, &gates, &[])
    }
    _ => {
      let gates: [Atom; 2] = [selected.active, cases[case].active]
      run Program.rule(&mut program.*, active, &gates, &[])
    }
  }
  let id = List<InvocationCaptureSource>.length(&closure.captureSources)
  run List<InvocationCaptureSource>.append(&mut closure.captureSources, InvocationCaptureSource {
    proof: selected.origin, binding: selected.source, producer: origin.producer, capture: capture,
    case: case, evaluation: evaluation, acquisition: acquisition, active: active})
  let current = run invocationCaptureValue(&mut closure.*, &mut program.*, domain, id, capture, cases[case].target)
  let gate: [Atom; 1] = [active]
  run Program.rule(&mut program.*, List<InvocationCaptureValue>.asSlice(&closure.captureValues)[current].active, &gate, &[])
  return ()
}

// A holding output is already in the implicit descriptor. Its only initial capture bridge
// is the real producer publication of that SAME cell (or the output Case itself at that Eval).
// This gives no physical address authority and never substitutes the fresh Borrow leaf.
fn invocationHoldingCapture(skeleton: &Skeleton, domain: &Domain, binding: ResultsDescriptorSource,
  captureCase: usize, holdingCase: usize, candidate: usize) -> bool {
  if let ResultsDescriptorSource.Environment {..} = binding { return false }
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let holdings = List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings)
  if candidate >= holdings.length || captureCase >= cases.length || holdingCase >= cases.length { return false }
  let held = &cases[holdingCase]
  let exact = match held.authority { TransferAuthority.ReferenceHolding {candidate: value} => value == candidate _ => false }
  if !exact { return false }
  let source = match held.source { Option<usize>.Some {value} => value _ => { return false } }
  let holding = holdings[candidate]
  let reference = List<ReferenceOrigin>.asSlice(&skeleton.references)[holding.reference]
  let read = List<ReferenceRead>.asSlice(&skeleton.referenceReads)[holding.referenceRead]
  let observation = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)[holding.observation]
  let witness = &List<Witness>.asSlice(&domain.witnesses)[keys[source].witness]
  if read.observation != holding.observation || observation.reference != holding.reference
    || read.value.index != holding.source.index || values[keys[source].value.index].phase != ValuePhase.Input
    || values[keys[source].value.index].evaluation.index != observation.acquisition.index
    || !referenceReadHistory(read.read, witness.read, List<SummaryRead>.asSlice(&skeleton.summaryReads)) { return false }
  let output = keys[held.target]
  if keys[source].value.index != holding.source.index || output.value.index != holding.target.index
    || holding.target.index != reference.descriptor.index || output.category != SourceRole.Ownership
    || reference.map.index != Results.descriptorMap(binding).index { return false }
  let publication = &cases[captureCase]
  let target = keys[publication.target]
  if target.category != SourceRole.Ownership || target.leaf.index != output.leaf.index
    || target.witness != output.witness || target.direct != output.direct
    || values[target.value.index].endpoint.index != values[output.value.index].endpoint.index { return false }
  if captureCase == holdingCase { return true }
  return match publication.authority {
    TransferAuthority.SameComponent => match publication.source { Option<usize>.Some {value} => value == held.target _ => false }
    _ => false
  }
}

effect fn closeInvocationHoldingCapture(closure: &mut InvocationClosure, skeleton: &mut Skeleton,
  domain: &Domain, capture: usize, case: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let selected = List<InvocationCapture>.asSlice(&closure.captures)[capture]
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let actual = &cases[case]
  if keys[actual.target].category != SourceRole.Ownership { return () }
  let publication = match actual.authority {
    TransferAuthority.ReferenceHolding {..} => true
    TransferAuthority.SameComponent => true
    _ => false
  }
  if !publication { return () }
  // A capture is either this holding output itself or its SameComponent publication.
  // Only Cases targeting that exact cell can pass invocationHoldingCapture.
  let heldCell = match actual.authority {
    TransferAuthority.ReferenceHolding {..} => actual.target
    _ => match actual.source { Option<usize>.Some {value} => value _ => { return () } }
  }
  let holdingCount = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[heldCell])
  let mut holdingOffset = usize.ZERO
  while holdingOffset < holdingCount {
    let holdingCase = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[heldCell])[holdingOffset]
    if let TransferAuthority.ReferenceHolding {candidate} = cases[holdingCase].authority {
      if invocationHoldingCapture(&skeleton.*, domain, selected.source, case, holdingCase, candidate) {
        let held = &cases[holdingCase]
        let source = match held.source { Option<usize>.Some {value} => value
          _ => { return CompilerBug.panic(b"holding capture has no acquisition input") } }
        let evaluation = List<Value>.asSlice(&skeleton.values)[keys[source].value.index].evaluation
        let inputCount = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[source])
        let mut inputOffset = usize.ZERO
        while inputOffset < inputCount {
          let inputCase = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.targets)[source])[inputOffset]
          if cases[inputCase].target == source {
            run reserveInvocationCaptureSource(&mut closure.*, &mut skeleton.rules, domain, capture, case, evaluation,
              InvocationCaptureAcquisition.Holding {candidate: candidate, case: holdingCase, inputCase: inputCase,
                source: invocationCaptureCell(domain, source), output: invocationCaptureCell(domain, held.target)})
          }
          inputOffset = inputOffset + usize.ONE
        }
      }
    }
    holdingOffset = holdingOffset + usize.ONE
  }
  return ()
}

// Authenticate the original actual input at the physical Construction Case. Then advance
// its component over the SAME finite capture graph as the receiver descriptor. No leaf or
// source is invented for a missing Case, and late Cases are considered on every closure pass.
effect fn closeInvocationCaptureValues<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain) -> () ! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let referencesCount = List<ReferenceOrigin>.length(&skeleton.references)
  let scan = InvocationCaptureScan {cases: cases.length, captures: List<InvocationCapture>.length(&closure.captures),
    steps: List<InvocationCaptureStep>.length(&closure.captureSteps), references: referencesCount}
  if let Option<InvocationCaptureScan>.Some {value: previous} = closure.captureScan {
    if previous.cases == scan.cases && previous.captures == scan.captures
      && previous.steps == scan.steps && previous.references == scan.references { return () }
  }
  let empty = List<Atom>.make()
  let mut capture = usize.ZERO
  while capture < List<InvocationCapture>.length(&closure.captures) {
    let selected = List<InvocationCapture>.asSlice(&closure.captures)[capture]
    let origin = List<InvocationOrigin>.asSlice(&closure.origins)[selected.origin]
    if selected.node == origin.node {
      let incoming = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.evaluations)[origin.producer.index])
      let mut offset = usize.ZERO
      while offset < incoming {
        let case = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.evaluations)[origin.producer.index])[offset]
        let actual = &cases[case]
        let target = List<Value>.asSlice(&skeleton.values)[keys[actual.target].value.index]
        if target.evaluation.index == origin.producer.index && target.endpoint.index == selected.endpoint.index
          && target.phase == ValuePhase.Output && invocationPhysical(target) {
          run closeInvocationHoldingCapture(&mut closure.*, &mut skeleton.*, domain, capture, case)
          let mut acquisition = Option<InvocationCaptureAcquisition>.none()
          let mut evaluation = origin.producer
          if let Option<usize>.Some {value: prior} = actual.source {
            if let TransferAuthority.Physical {map, direction: matchedOrientation, ..} = actual.authority {
              if matchedOrientation == MapDirection.Forward {
                let from = List<Value>.asSlice(&skeleton.values)[keys[prior].value.index]
                if map.index == Results.descriptorMap(selected.source).index && from.endpoint.index == maps[map.index].source.index
                  && maps[map.index].target.index == target.endpoint.index && invocationPhysical(from) {
                  acquisition = Option<InvocationCaptureAcquisition>.some(InvocationCaptureAcquisition.Copy {source: invocationCaptureCell(domain, prior)})
                  evaluation = from.evaluation
                }
              }
            }
          }
          if let TransferAuthority.CaptureReborrow {origin: acquired, placement} = actual.authority {
            let recorded = List<CaptureReborrowOrigin>.asSlice(&skeleton.captureReborrowData.origins)[acquired]
            if placement.index == Results.descriptorMap(selected.source).index {
              let prior = match actual.source { Option<usize>.Some {value} => value
                _ => { return CompilerBug.panic(b"capture reborrow publication lost its acquisition cell") } }
              if keys[prior].category != SourceRole.Ownership || keys[prior].value.index != recorded.descriptor.index
                || keys[prior].leaf.index != recorded.leaf.index || keys[actual.target].category != SourceRole.Ownership
                || keys[actual.target].value.index != recorded.target.index {
                return CompilerBug.panic(b"invocation capture changed its actual reborrow seed")
              }
              acquisition = Option<InvocationCaptureAcquisition>.some(InvocationCaptureAcquisition.CaptureReborrow {
                origin: acquired, source: invocationCaptureCell(domain, prior)})
              evaluation = recorded.acquisition
            }
          }
          // A published implicit reference carries its own exact source operand coordinate.
          // This is acquisition evidence, never a claim that old referent contents were copied.
          let mut each = usize.ZERO
          while each < referencesCount {
            let recorded = List<ReferenceOrigin>.asSlice(&skeleton.references)[each]
            if keys[actual.target].category == SourceRole.Physical
              && recorded.map.index == Results.descriptorMap(selected.source).index && recorded.leaf.index == keys[actual.target].leaf.index {
              let descriptor = List<Value>.asSlice(&skeleton.values)[recorded.descriptor.index]
              let published = match actual.source {
                Option<usize>.Some {value: prior} => keys[prior].value.index == recorded.descriptor.index
                  && match actual.authority { TransferAuthority.SameComponent => true _ => false }
                _ => keys[actual.target].value.index == recorded.descriptor.index
              }
              if published && descriptor.endpoint.index == target.endpoint.index {
                if let Option<InvocationCaptureAcquisition>.Some {..} = acquisition { return CompilerBug.panic(b"one capture Case has two original acquisition authorities") }
                acquisition = Option<InvocationCaptureAcquisition>.some(InvocationCaptureAcquisition.Reference {reference: each})
                evaluation = recorded.source
              }
            }
            each = each + usize.ONE
          }
          if let Option<InvocationCaptureAcquisition>.Some {value} = acquisition {
            run reserveInvocationCaptureSource(&mut closure.*, &mut skeleton.rules, domain, capture, case, evaluation, value)
          }
        }
        offset = offset + usize.ONE
      }
    }
    capture = capture + usize.ONE
  }
  let mut at = usize.ZERO
  while at < List<InvocationCaptureValue>.length(&closure.captureValues) {
    let current = List<InvocationCaptureValue>.asSlice(&closure.captureValues)[at]
    let mut step = usize.ZERO
    while step < List<InvocationCaptureStep>.length(&closure.captureSteps) {
      let edge = List<InvocationCaptureStep>.asSlice(&closure.captureSteps)[step]
      if edge.source == current.capture {
        let carrier = List<InvocationStep>.asSlice(&closure.steps)[edge.carrier]
        let destination = List<InvocationCapture>.asSlice(&closure.captures)[edge.target]
        let descriptor = List<InvocationNode>.asSlice(&closure.nodes)[destination.node]
        let evaluation = List<Value>.asSlice(&skeleton.values)[keys[descriptor.cell].value.index].evaluation
        let outgoing = List<usize>.length(&List<List<usize>>.asSlice(&closure.caseIndex.sources)[current.current.cell])
        let mut offset = usize.ZERO
        while offset < outgoing {
          let case = List<usize>.asSlice(&List<List<usize>>.asSlice(&closure.caseIndex.sources)[current.current.cell])[offset]
          let actual = &cases[case]
          let from = match actual.source { Option<usize>.Some {value} => value _ => usize.MAX }
          let target = List<Value>.asSlice(&skeleton.values)[keys[actual.target].value.index]
          if from == current.current.cell && target.evaluation.index == evaluation.index
            && target.endpoint.index == destination.endpoint.index && invocationPhysical(target) {
            let exact = invocationCaptureCase(edge.authority, actual, case)
            if exact {
              let next = run invocationCaptureValue(&mut closure.*, &mut skeleton.rules, domain,
                current.source, edge.target, actual.target)
              let old = List<InvocationCaptureEdge>.asSlice(&closure.captureEdges)
              let mut found = false
              let mut each = usize.ZERO
              while each < old.length {
                if old[each].source == at && old[each].target == next && old[each].captureStep == step
                  && old[each].componentCase == case { found = true }
                each = each + usize.ONE
              }
              if !found {
                let descriptorCase = match edge.authority {
                  InvocationCaptureAuthority.Address {descriptorCase, ..} => Option<usize>.some(descriptorCase)
                  InvocationCaptureAuthority.Alias {descriptorCase, ..} => Option<usize>.some(descriptorCase)
                  _ => Option<usize>.none()
                }
                if let Option<usize>.Some {value} = descriptorCase {
                  let geometry: [Atom; 4] = [current.active, carrier.active, cases[value].active, actual.active]
                  run Program.rule(&mut skeleton.rules, edge.active, &geometry, List<Atom>.asSlice(&empty))
                }
                let active = Program.atom(&mut skeleton.rules)
                let gates: [Atom; 3] = [current.active, edge.active, actual.active]
                run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
                let gate: [Atom; 1] = [active]
                run Program.rule(&mut skeleton.rules, List<InvocationCaptureValue>.asSlice(&closure.captureValues)[next].active,
                  &gate, List<Atom>.asSlice(&empty))
                run List<InvocationCaptureEdge>.append(&mut closure.captureEdges, InvocationCaptureEdge {
                  source: at, target: next, captureStep: step, descriptorCase: carrier.case, componentCase: case, active: active})
              }
            }
          }
          offset = offset + usize.ONE
        }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  // The dynamic captureValues loop visited every appended arrival. Later rules can
  // change atom truth without changing this product; new structural inputs rerun it.
  closure.captureScan = Option<InvocationCaptureScan>.some(scan)
  return ()
}

fn invocationLiftDescends(lifts: &[Prepared.ChannelLift], root: Prepared.ChannelLiftId,
  current: Prepared.ChannelLiftId, remaining: usize) -> bool {
  if root.index == current.index { return true }
  if remaining == usize.ZERO { return false }
  let next = List<Prepared.ChannelLiftId>.asSlice(&lifts[root.index].next)
  let mut at = usize.ZERO
  while at < next.length {
    if invocationLiftDescends(lifts, next[at], current, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

fn invocationProjectionLift<'body>(prepared: &SourcePreparation<'body>, carrier: InvocationStep,
  prefix: Results.DescriptorPrefix, root: Prepared.ChannelLiftId, current: Prepared.ChannelLiftId,
  laterRoot: Prepared.ResidualStateId, later: Prepared.ResidualStateId) -> bool {
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  let entry = &lifts[root.index]
  let selected = &lifts[current.index]
  let map = match carrier.authority { InvocationStepAuthority.Channel {map, ..} => map _ => { return false } }
  let stop = match carrier.authority { InvocationStepAuthority.Channel {stop, ..} => stop _ => { return false } }
  let pair = &List<Prepared.BoundaryStop>.asSlice(&List<SelectionMap>.asSlice(&prepared.maps)[map.index].channelStops)[stop]
  let mut anchor = false
  match entry.origin {
    PreparedChannelLiftOrigin.Projection {projection, prefixRoot, prefixCurrent} => {
      if projection.index != prefix.projection.index { return false }
      let first = &lifts[prefixRoot.index]
      let last = &lifts[prefixCurrent.index]
      let rootOnly = match first.origin { PreparedChannelLiftOrigin.Root => true _ => false }
      let lastRootOnly = match last.origin { PreparedChannelLiftOrigin.Root => true _ => false }
      anchor = rootOnly && lastRootOnly && first.entry && first.map.index == map.index
        && first.channel.sourceState.index == pair.sourceState.index && first.channel.targetState.index == pair.targetState.index
        && first.targetState.index == prefix.root.index && last.targetState.index == prefix.current.index
        && invocationLiftDescends(lifts, prefixRoot, prefixCurrent, lifts.length)
    }
    _ => ()
  }
  let same = match entry.origin {
    PreparedChannelLiftOrigin.Projection {projection, prefixRoot, prefixCurrent} => match selected.origin {
      PreparedChannelLiftOrigin.Projection {projection: other, prefixRoot: otherRoot, prefixCurrent: otherCurrent} =>
        projection.index == other.index && prefixRoot.index == otherRoot.index && prefixCurrent.index == otherCurrent.index
      _ => false
    }
    _ => false
  }
  return anchor && same && entry.entry && entry.map.index == map.index && selected.map.index == map.index
    && entry.channel.sourceState.index == pair.sourceState.index && entry.channel.targetState.index == pair.targetState.index
    && selected.channel.sourceState.index == pair.sourceState.index && selected.channel.targetState.index == pair.targetState.index
    && entry.targetState.index == laterRoot.index && selected.targetState.index == later.index
    && invocationLiftDescends(lifts, root, current, lifts.length)
}

effect fn closeInvocationProjectionSuffix<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, suffixId: usize, carrierId: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let suffix = List<InvocationSuffix>.asSlice(&closure.suffixes)[suffixId]
  let prefix = match suffix.prefix { Option<Results.DescriptorPrefix>.Some {value} => value
    _ => { return CompilerBug.panic(b"projection output transport omitted its separate prefix") } }
  let carrier = List<InvocationStep>.asSlice(&closure.steps)[carrierId]
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  let empty = List<Atom>.make()
  let mut root = usize.ZERO
  while root < lifts.length {
    if lifts[root].entry && lifts[root].targetState.index == suffix.root.index {
      let mut current = usize.ZERO
      while current < lifts.length {
        let rootId = Prepared.ChannelLiftId {index: root}
        let currentId = Prepared.ChannelLiftId {index: current}
        if invocationProjectionLift(prepared, carrier, prefix, rootId, currentId, suffix.root, suffix.current) {
          let mut earlierPrefix = prefix
          if let PreparedChannelLiftOrigin.Projection {prefixRoot, prefixCurrent, ..} = lifts[root].origin {
            earlierPrefix.root = lifts[prefixRoot.index].sourceState
            earlierPrefix.current = lifts[prefixCurrent.index].sourceState
          }
          let earlier = run InvocationClosure.suffix(&mut closure.*, &mut skeleton.rules, carrier.earlier,
            suffix.requestedRoot, suffix.requested, lifts[root].sourceState, lifts[current].sourceState,
            Option<Results.DescriptorPrefix>.some(earlierPrefix))
          let authority = InvocationSuffixAuthority.Projection {root: rootId, current: currentId}
          let old = List<InvocationSuffixStep>.asSlice(&closure.suffixSteps)
          let mut found = false
          let mut at = usize.ZERO
          while at < old.length {
            if old[at].later == suffixId && old[at].earlier == earlier && old[at].carrier == carrierId
              && sameInvocationSuffixAuthority(old[at].authority, authority) { found = true }
            at = at + usize.ONE
          }
          if !found {
            let active = Program.atom(&mut skeleton.rules)
            let gates: [Atom; 2] = [suffix.active, carrier.active]
            run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
            let admitted: [Atom; 1] = [active]
            run Program.rule(&mut skeleton.rules, List<InvocationSuffix>.asSlice(&closure.suffixes)[earlier].active,
              &admitted, List<Atom>.asSlice(&empty))
            run List<InvocationSuffixStep>.append(&mut closure.suffixSteps, InvocationSuffixStep {
              later: suffixId, earlier: earlier, carrier: carrierId, authority: authority, active: active})
          }
        }
        current = current + usize.ONE
      }
    }
    root = root + usize.ONE
  }
  run invocationOutputGap(&mut closure.*, &mut skeleton.rules, suffixId, carrierId)
  return ()
}

effect fn closeInvocationSuffixes<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, descriptors: &mut DescriptorClosure) -> () ! OutOfMemoryError ? &mut Allocator {
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  let empty = List<Atom>.make()
  let mut at = usize.ZERO
  while at < List<InvocationSuffix>.length(&closure.suffixes) {
    let suffix = List<InvocationSuffix>.asSlice(&closure.suffixes)[at]
    let mut step = usize.ZERO
    while step < List<InvocationStep>.length(&closure.steps) {
      let edge = List<InvocationStep>.asSlice(&closure.steps)[step]
      if edge.later == suffix.node {
        if let Option<Results.DescriptorPrefix>.Some {..} = suffix.prefix {
          match edge.authority {
            InvocationStepAuthority.Channel {..} => {
              run closeInvocationProjectionSuffix(&mut closure.*, prepared, &mut skeleton.*, at, step)
              step = step + usize.ONE
              continue
            }
            _ => ()
          }
        }
        if let InvocationStepAuthority.Contents {proof} = edge.authority {
          run closeInvocationContentsSuffix(&mut closure.*, prepared, &mut skeleton.*, domain, &mut descriptors.*, at, step, proof)
          step = step + usize.ONE
          continue
        }
        let mut roots = List<Option<Prepared.ChannelLiftId>>.make()
        let mut currents = List<Option<Prepared.ChannelLiftId>>.make()
        match edge.authority {
          InvocationStepAuthority.Contents {..} => CompilerBug.panic(b"contents suffix bypassed its paired output proof")
          InvocationStepAuthority.SameComponent => {
            run List<Option<Prepared.ChannelLiftId>>.append(&mut roots, Option<Prepared.ChannelLiftId>.none())
            run List<Option<Prepared.ChannelLiftId>>.append(&mut currents, Option<Prepared.ChannelLiftId>.none())
          }
          InvocationStepAuthority.AliasIdentity {..} => {
            run List<Option<Prepared.ChannelLiftId>>.append(&mut roots, Option<Prepared.ChannelLiftId>.none())
            run List<Option<Prepared.ChannelLiftId>>.append(&mut currents, Option<Prepared.ChannelLiftId>.none())
          }
          InvocationStepAuthority.Channel {map, stop} => {
            let pair = &List<Prepared.BoundaryStop>.asSlice(&maps[map.index].channelStops)[stop]
            let mut root = usize.ZERO
            while root < lifts.length {
              let rootAuthority = match lifts[root].origin { PreparedChannelLiftOrigin.Root => true _ => false }
              if lifts[root].entry && rootAuthority
                && lifts[root].map.index == map.index && lifts[root].channel.sourceState.index == pair.sourceState.index
                && lifts[root].channel.targetState.index == pair.targetState.index && lifts[root].targetState.index == suffix.root.index {
                let mut current = usize.ZERO
                while current < lifts.length {
                  let currentAuthority = match lifts[current].origin { PreparedChannelLiftOrigin.Root => true _ => false }
                  if currentAuthority && lifts[current].targetState.index == suffix.current.index
                    && invocationLiftDescends(lifts, Prepared.ChannelLiftId {index: root}, Prepared.ChannelLiftId {index: current}, lifts.length) {
                    run List<Option<Prepared.ChannelLiftId>>.append(&mut roots, Option<Prepared.ChannelLiftId>.some(Prepared.ChannelLiftId {index: root}))
                    run List<Option<Prepared.ChannelLiftId>>.append(&mut currents, Option<Prepared.ChannelLiftId>.some(Prepared.ChannelLiftId {index: current}))
                  }
                  current = current + usize.ONE
                }
              }
              root = root + usize.ONE
            }
            if List<Option<Prepared.ChannelLiftId>>.length(&roots) == usize.ZERO {
              return CompilerBug.panic(b"actual descriptor copy has no frozen channel output lift for its requested suffix")
            }
          }
        }
        let rootsSelected = List<Option<Prepared.ChannelLiftId>>.asSlice(&roots)
        let currentsSelected = List<Option<Prepared.ChannelLiftId>>.asSlice(&currents)
        let mut each = usize.ZERO
        while each < rootsSelected.length {
          let root = match rootsSelected[each] { Option<Prepared.ChannelLiftId>.Some {value} => lifts[value.index].sourceState _ => suffix.root }
          let current = match currentsSelected[each] { Option<Prepared.ChannelLiftId>.Some {value} => lifts[value.index].sourceState _ => suffix.current }
          let target = run InvocationClosure.suffix(&mut closure.*, &mut skeleton.rules, edge.earlier,
            suffix.requestedRoot, suffix.requested, root, current, suffix.prefix)
          let authority = match rootsSelected[each] {
            Option<Prepared.ChannelLiftId>.Some {value} => InvocationSuffixAuthority.Channel {root: value,
              current: match currentsSelected[each] { Option<Prepared.ChannelLiftId>.Some {value: matchedLiftedCurrent} => matchedLiftedCurrent
                _ => { return CompilerBug.panic(b"channel suffix omitted its paired current lift") } }}
            _ => match edge.authority {
              InvocationStepAuthority.AliasIdentity {..} => InvocationSuffixAuthority.AliasIdentity
              _ => InvocationSuffixAuthority.SameComponent
            }
          }
          let old = List<InvocationSuffixStep>.asSlice(&closure.suffixSteps)
          let mut found = false
          let mut before = usize.ZERO
          while before < old.length {
            if old[before].later == at && old[before].earlier == target && old[before].carrier == step
              && sameInvocationSuffixAuthority(old[before].authority, authority) { found = true }
            before = before + usize.ONE
          }
          if !found {
            let active = Program.atom(&mut skeleton.rules)
            let gates: [Atom; 2] = [suffix.active, edge.active]
            run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
            let admitted: [Atom; 1] = [active]
            run Program.rule(&mut skeleton.rules, List<InvocationSuffix>.asSlice(&closure.suffixes)[target].active, &admitted, List<Atom>.asSlice(&empty))
            run List<InvocationSuffixStep>.append(&mut closure.suffixSteps, InvocationSuffixStep {later: at, earlier: target,
              carrier: step, authority: authority, active: active})
          }
          each = each + usize.ONE
        }
      }
      step = step + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}
fn sameInvocationSuffixAuthority(left: InvocationSuffixAuthority, right: InvocationSuffixAuthority) -> bool {
  return match left {
    InvocationSuffixAuthority.SameComponent => match right { InvocationSuffixAuthority.SameComponent => true _ => false }
    InvocationSuffixAuthority.AliasIdentity => match right { InvocationSuffixAuthority.AliasIdentity => true _ => false }
    InvocationSuffixAuthority.Channel {root, current} => match right {
      InvocationSuffixAuthority.Channel {root: otherRoot, current: otherCurrent} => root.index == otherRoot.index && current.index == otherCurrent.index
      _ => false
    }
    InvocationSuffixAuthority.Projection {root, current} => match right {
      InvocationSuffixAuthority.Projection {root: otherRoot, current: otherCurrent} => root.index == otherRoot.index && current.index == otherCurrent.index
      _ => false
    }
    InvocationSuffixAuthority.Contents {output} => match right { InvocationSuffixAuthority.Contents {output: other} => output == other _ => false }
  }
}

// Contents retains contextual segments; the invocation separately preserves original A coordinates.
fn sameInvocationContentsPrefix(left: Option<ContentsChannelPrefix>, right: Option<Results.DescriptorPrefix>) -> bool {
  return match left {
    Option<ContentsChannelPrefix>.Some {value: prefix} => match right {
      Option<Results.DescriptorPrefix>.Some {value: other} => prefix.projection.index == other.projection.index
        && prefix.root.index == other.root.index && prefix.current.index == other.current.index
      _ => false
    }
    Option<ContentsChannelPrefix>.None => match right { Option<Results.DescriptorPrefix>.None => true _ => false }
  }
}

effect fn closeInvocationContentsSuffix<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, descriptors: &mut DescriptorClosure, suffixId: usize, carrierId: usize, proof: usize)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let suffix = List<InvocationSuffix>.asSlice(&closure.suffixes)[suffixId]
  let carrier = List<InvocationStep>.asSlice(&closure.steps)[carrierId]
  let outputs = match suffix.prefix {
    Option<Results.DescriptorPrefix>.Some {value: prefix} => run contentsChannelSegmentOutputs(
      &mut descriptors.*, prepared, &mut skeleton.*, domain, proof, prefix.projection,
      prefix.root, prefix.current, suffix.root, suffix.current)
    Option<Results.DescriptorPrefix>.None => run contentsChannelOutputs(
      &mut descriptors.*, prepared, &mut skeleton.*, domain, proof, suffix.root, suffix.current)
  }
  let outputsSelected = List<ContentsChannelOutput>.asSlice(&outputs)
  let empty = List<Atom>.make()
  let mut at = usize.ZERO
  while at < outputsSelected.length {
    let output = outputsSelected[at]
    let retained = List<ContentsChannelOutput>.asSlice(&descriptors.contentsChannelOutputs)
    let mut identity = usize.MAX
    let mut each = usize.ZERO
    while each < retained.length {
      if Atom.same(retained[each].active, output.active) {
        if identity != usize.MAX { return CompilerBug.panic(b"contents output witness has duplicate finite identities") }
        identity = each
      }
      each = each + usize.ONE
    }
    if identity == usize.MAX || output.proof != proof || output.requestedRoot.index != suffix.root.index
      || output.requested.index != suffix.current.index
      || !sameInvocationContentsPrefix(output.requestedPrefix, suffix.prefix) {
      return CompilerBug.panic(b"invocation lost its retained contents suffix witness")
    }
    let mut prefix = Option<Results.DescriptorPrefix>.none()
    match suffix.prefix {
      Option<Results.DescriptorPrefix>.Some {value: requested} => {
        let translated = match output.prefix { Option<ContentsChannelPrefix>.Some {value} => value
          _ => { return CompilerBug.panic(b"contents output dropped its jointly transported prefix") } }
        if translated.projection.index != requested.projection.index {
          return CompilerBug.panic(b"contents output changed its original receiver projection")
        }
        prefix = Option<Results.DescriptorPrefix>.some(Results.DescriptorPrefix {projection: requested.projection,
          requestedRoot: requested.requestedRoot, requested: requested.requested,
          root: translated.root, current: translated.current})
      }
      Option<Results.DescriptorPrefix>.None => {
        if let Option<ContentsChannelPrefix>.Some {..} = output.prefix {
          return CompilerBug.panic(b"contents output invented a receiver prefix")
        }
      }
    }
    let earlier = run InvocationClosure.suffix(&mut closure.*, &mut skeleton.rules, carrier.earlier,
      suffix.requestedRoot, suffix.requested, output.root, output.current, prefix)
    let authority = InvocationSuffixAuthority.Contents {output: identity}
    let old = List<InvocationSuffixStep>.asSlice(&closure.suffixSteps)
    let mut found = false
    each = usize.ZERO
    while each < old.length {
      if old[each].later == suffixId && old[each].earlier == earlier && old[each].carrier == carrierId
        && sameInvocationSuffixAuthority(old[each].authority, authority) { found = true }
      each = each + usize.ONE
    }
    if !found {
      let active = Program.atom(&mut skeleton.rules)
      let gates: [Atom; 3] = [suffix.active, carrier.active, output.active]
      run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
      let admitted: [Atom; 1] = [active]
      run Program.rule(&mut skeleton.rules, List<InvocationSuffix>.asSlice(&closure.suffixes)[earlier].active,
        &admitted, List<Atom>.asSlice(&empty))
      run List<InvocationSuffixStep>.append(&mut closure.suffixSteps, InvocationSuffixStep {
        later: suffixId, earlier: earlier, carrier: carrierId, authority: authority, active: active})
    }
    at = at + usize.ONE
  }
  run invocationOutputGap(&mut closure.*, &mut skeleton.rules, suffixId, carrierId)
  return ()
}

effect fn invocationOutputGap(closure: &mut InvocationClosure, program: &mut Program,
  suffixId: usize, carrierId: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let suffix = List<InvocationSuffix>.asSlice(&closure.suffixes)[suffixId]
  let carrier = List<InvocationStep>.asSlice(&closure.steps)[carrierId]
  let mut at = usize.ZERO
  let gaps = List<InvocationGap>.asSlice(&closure.gaps)
  let mut found = false
  at = usize.ZERO
  while at < gaps.length {
    if gaps[at].kind == InvocationGapKind.Output && gaps[at].node == suffix.node && gaps[at].case == carrier.case {
      if let Option<usize>.Some {value} = gaps[at].suffix {
        if let Option<usize>.Some {value: exactCarrier} = gaps[at].carrier {
          if value == suffixId && exactCarrier == carrierId { found = true }
        }
      }
    }
    at = at + usize.ONE
  }
  if !found {
    let node = List<InvocationNode>.asSlice(&closure.nodes)[suffix.node]
    let applicable = run addressApplies(&mut program.*, suffix.active, carrier.active)
    run List<InvocationGap>.append(&mut closure.gaps, InvocationGap {
      operation: List<InvocationDemand>.asSlice(&closure.demands)[node.demand].operation,
      demand: node.demand, node: suffix.node, case: carrier.case, kind: InvocationGapKind.Output,
      capture: Option<usize>.none(), suffix: Option<usize>.some(suffixId), carrier: Option<usize>.some(carrierId), applicable: applicable, active: Program.atom(&mut program.*)})
  }
  return ()
}

// Missing is sealed once after candidate closure. A row's mere presence never closes a
// demand, and a proof appended after the Case can discharge exactly its own missing gate.
effect fn sealInvocationGaps(program: &mut Program, closure: &InvocationClosure) -> ()
! OutOfMemoryError ? &mut Allocator {
  let pairs = List<InvocationCallPair>.asSlice(&closure.callPairs)
  let outputs = List<InvocationCallOutput>.asSlice(&closure.callOutputs)
  let mut pair = usize.ZERO
  while pair < pairs.length {
    let mut admitted = List<Atom>.make()
    let mut output = usize.ZERO
    while output < outputs.length {
      if outputs[output].pair == pair { run List<Atom>.append(&mut admitted, outputs[output].active) }
      output = output + usize.ONE
    }
    let gate: [Atom; 1] = [pairs[pair].active]
    run Program.rule(&mut program.*, pairs[pair].outputMissing, &gate, List<Atom>.asSlice(&admitted))
    pair = pair + usize.ONE
  }
  let gaps = List<InvocationGap>.asSlice(&closure.gaps)
  let nodes = List<InvocationNode>.asSlice(&closure.nodes)
  let steps = List<InvocationStep>.asSlice(&closure.steps)
  let mut at = usize.ZERO
  while at < gaps.length {
    let gap = gaps[at]
    let mut admitted = List<Atom>.make()
    match gap.kind {
      InvocationGapKind.Carrier => {
        let mut each = usize.ZERO
        while each < steps.length {
          if steps[each].later == gap.node && steps[each].case == gap.case { run List<Atom>.append(&mut admitted, steps[each].active) }
          each = each + usize.ONE
        }
      }
      InvocationGapKind.Producer => {
        let origins = List<InvocationOrigin>.asSlice(&closure.origins)
        let mut each = usize.ZERO
        while each < origins.length {
          if origins[each].node == gap.node && origins[each].seedCase == gap.case { run List<Atom>.append(&mut admitted, origins[each].active) }
          each = each + usize.ONE
        }
      }
      InvocationGapKind.Capture => {
        let capture = match gap.capture { Option<usize>.Some {value} => value
          _ => { return CompilerBug.panic(b"capture missing lost its actual source coordinate") } }
        let requestedCarrier = match gap.carrier { Option<usize>.Some {value} => value
          _ => { return CompilerBug.panic(b"capture missing lost its exact descriptor proof step") } }
        let edges = List<InvocationCaptureStep>.asSlice(&closure.captureSteps)
        let mut each = usize.ZERO
        while each < edges.length {
          let carrier = steps[edges[each].carrier]
          if edges[each].source == capture && edges[each].carrier == requestedCarrier
            && carrier.later == gap.node && carrier.case == gap.case {
            run List<Atom>.append(&mut admitted, edges[each].active)
          }
          each = each + usize.ONE
        }
      }
      InvocationGapKind.Output => {
        let suffix = match gap.suffix { Option<usize>.Some {value} => value
          _ => { return CompilerBug.panic(b"output missing lost its actual requested suffix") } }
        let edges = List<InvocationSuffixStep>.asSlice(&closure.suffixSteps)
        let mut each = usize.ZERO
        while each < edges.length {
          let carrier = steps[edges[each].carrier]
          if edges[each].later == suffix && carrier.case == gap.case { run List<Atom>.append(&mut admitted, edges[each].active) }
          each = each + usize.ONE
        }
      }
    }
    if gap.kind == InvocationGapKind.Producer || gap.kind == InvocationGapKind.Carrier {
      let declarations = List<InvocationDeclaration>.asSlice(&closure.declarations)
      let mut each = usize.ZERO
      while each < declarations.length {
        if declarations[each].node == gap.node && declarations[each].case == gap.case {
          run List<Atom>.append(&mut admitted, declarations[each].active)
        }
        each = each + usize.ONE
      }
    }
    let gates: [Atom; 2] = [nodes[gap.node].active, gap.applicable]
    run Program.rule(&mut program.*, gap.active, &gates, List<Atom>.asSlice(&admitted))
    at = at + usize.ONE
  }
  return ()
}


fn invocationContinuationDescends(rows: &[Prepared.ContractContinuation], root: Prepared.ContractContinuationId,
  current: Prepared.ContractContinuationId, remaining: usize) -> bool {
  if root.index == current.index { return true }
  if remaining == usize.ZERO { return false }
  let next = List<Prepared.ContractContinuationId>.asSlice(&rows[root.index].next)
  let mut at = usize.ZERO
  while at < next.length {
    if invocationContinuationDescends(rows, next[at], current, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

// Follow an actual producer inline prefix using its frozen Select edges. A state is admitted
// only at the exact parent shape and selected component; equal endpoint types add no path.
fn invocationProjectionPrefix<'body>(prepared: &SourcePreparation<'body>, site: NodeId, endpoint: EndpointId,
  root: Prepared.ResidualStateId, target: EndpointId, current: Prepared.ResidualStateId, remaining: usize) -> bool {
  if remaining == usize.ZERO { return false }
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let shapes = List<Prepared.Shape>.asSlice(&prepared.shapes)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let state = &states[root.index]
  if state.input.shape.index != endpoints[endpoint.index].shape.index { return false }
  let component = residualComponent(shapes, state.input)
  if !component.inline { return false }
  let mut selected = usize.MAX
  let mut at = usize.ZERO
  while at < maps.length {
    if maps[at].site.index == site.index && maps[at].kind == MapKind.Select && maps[at].source.index == endpoint.index
      && sameSelector(&maps[at].selector, &component.selector) {
      let child = &endpoints[maps[at].target.index]
      let exact = match child.parent { Option<EndpointId>.Some {value} => value.index == endpoint.index _ => false }
      if exact {
        if selected != usize.MAX && selected != maps[at].target.index {
          return CompilerBug.panic(b"producer projection has ambiguous exact inline Select targets")
        }
        selected = maps[at].target.index
      }
    }
    at = at + usize.ONE
  }
  if selected == usize.MAX { return false }
  if root.index == current.index { return selected == target.index }
  let next = List<Prepared.ResidualStateId>.asSlice(&state.next)
  at = usize.ZERO
  while at < next.length {
    if invocationProjectionPrefix(prepared, site, EndpointId {index: selected}, next[at], target, current, remaining - usize.ONE) { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn invocationContributor(closure: &mut InvocationClosure, origin: usize,
  projection: Prepared.ContractProjectionId, continuation: Option<Prepared.ContractContinuationId>,
  selection: Prepared.ContractSelectionId) -> () ! OutOfMemoryError ? &mut Allocator {
  let old = List<InvocationContributor>.asSlice(&closure.contributors)
  let mut at = usize.ZERO
  while at < old.length {
    if old[at].origin == origin && old[at].projection.index == projection.index
      && sameInvocationContinuation(old[at].continuation, continuation) { return () }
    at = at + usize.ONE
  }
  let producer = List<InvocationOrigin>.asSlice(&closure.origins)[origin]
  let node = List<InvocationNode>.asSlice(&closure.nodes)[producer.node]
  run List<InvocationContributor>.append(&mut closure.contributors, InvocationContributor {
    operation: List<InvocationDemand>.asSlice(&closure.demands)[node.demand].operation,
    producer: producer.producer, channel: producer.channel, origin: origin, projection: projection, continuation: continuation, selection: selection,
    active: List<InvocationOrigin>.asSlice(&closure.origins)[origin].active})
  return ()
}
fn sameInvocationContinuation(left: Option<Prepared.ContractContinuationId>, right: Option<Prepared.ContractContinuationId>) -> bool {
  return match left {
    Option<Prepared.ContractContinuationId>.Some {value} => match right { Option<Prepared.ContractContinuationId>.Some {value: other} => value.index == other.index _ => false }
    _ => match right { Option<Prepared.ContractContinuationId>.None => true _ => false }
  }
}

effect fn invocationPlacement(closure: &mut InvocationClosure, program: &mut Program, origin: usize,
  suffix: Option<usize>, projection: Prepared.ContractProjectionId, continuation: Option<Prepared.ContractContinuationId>,
  originalRoot: Option<Prepared.ContractContinuationId>, selection: Prepared.ContractSelectionId) -> ()
! OutOfMemoryError ? &mut Allocator {
  let old = List<InvocationPlacement>.asSlice(&closure.placements)
  let mut at = usize.ZERO
  while at < old.length {
    let sameSuffix = match old[at].suffix {
      Option<usize>.Some {value} => match suffix { Option<usize>.Some {value: other} => value == other _ => false }
      _ => match suffix { Option<usize>.None => true _ => false }
    }
    if old[at].origin == origin && sameSuffix && old[at].projection.index == projection.index
      && sameInvocationContinuation(old[at].continuation, continuation) && sameInvocationContinuation(old[at].originalRoot, originalRoot) { return () }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut program.*)
  let empty = List<Atom>.make()
  let producer = List<InvocationOrigin>.asSlice(&closure.origins)[origin]
  match suffix {
    Option<usize>.Some {value} => {
      let gates: [Atom; 2] = [producer.active, List<InvocationSuffix>.asSlice(&closure.suffixes)[value].active]
      run Program.rule(&mut program.*, active, &gates, List<Atom>.asSlice(&empty))
    }
    _ => {
      let gates: [Atom; 1] = [producer.active]
      run Program.rule(&mut program.*, active, &gates, List<Atom>.asSlice(&empty))
    }
  }
  run List<InvocationPlacement>.append(&mut closure.placements, InvocationPlacement {origin: origin, suffix: suffix,
    projection: projection, continuation: continuation, originalRoot: originalRoot, selection: selection, active: active})
  return ()
}

effect fn closeInvocationPlacements<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton) -> () ! OutOfMemoryError ? &mut Allocator {
  let channels = List<Prepared.ProducerChannel>.asSlice(&prepared.producerChannels)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut origin = usize.ZERO
  while origin < List<InvocationOrigin>.length(&closure.origins) {
    let actual = List<InvocationOrigin>.asSlice(&closure.origins)[origin]
    let channel = &channels[actual.channel]
    let output = maps[channel.map.index].target
    let listed = List<Prepared.ContractProjectionId>.asSlice(&channel.projections)
    let mut each = usize.ZERO
    while each < listed.length {
      let id = listed[each]
      let projection = &projections[id.index]
      let whole = Results.rootSelection(prepared, id)
      run invocationContributor(&mut closure.*, origin, id, Option<Prepared.ContractContinuationId>.none(), whole)
      if projection.output.index == output.index {
        run invocationPlacement(&mut closure.*, &mut skeleton.rules, origin, Option<usize>.none(), id,
          Option<Prepared.ContractContinuationId>.none(), Option<Prepared.ContractContinuationId>.none(), whole)
      }
      // Keep ALL original contributor rows, including empty/incomplete rows and shared
      // normalized targets. This is separate from whether an actual suffix reaches a row.
      let mut current = usize.ZERO
      while current < continuations.length {
        if continuations[current].projection.index == id.index {
          run invocationContributor(&mut closure.*, origin, id,
            Option<Prepared.ContractContinuationId>.some(Prepared.ContractContinuationId {index: current}), continuations[current].originalSelection)
        }
        current = current + usize.ONE
      }
      let mut suffix = usize.ZERO
      while suffix < List<InvocationSuffix>.length(&closure.suffixes) {
        let selected = List<InvocationSuffix>.asSlice(&closure.suffixes)[suffix]
        if selected.node == actual.node {
          let prefixWhole = match selected.prefix {
            Option<Results.DescriptorPrefix>.Some {..} => false
            _ => invocationProjectionPrefix(prepared, channel.site, output, selected.root, projection.output, selected.current, states.length)
          }
          if prefixWhole {
            run invocationPlacement(&mut closure.*, &mut skeleton.rules, origin, Option<usize>.some(suffix), id,
              Option<Prepared.ContractContinuationId>.none(), Option<Prepared.ContractContinuationId>.none(), whole)
          }
          let roots = List<Prepared.ContractContinuationId>.asSlice(&projection.continuations)
          let mut root = usize.ZERO
          while root < roots.length {
            let rootState = continuations[roots[root].index].outputState
            let segmented = match selected.prefix { Option<Results.DescriptorPrefix>.Some {..} => true _ => false }
            let mut anchored = match selected.prefix {
              Option<Results.DescriptorPrefix>.Some {value} => rootState.index == selected.root.index
                && invocationProjectionPrefix(prepared, channel.site, output, value.root, projection.output, value.current, states.length)
              _ => projection.output.index == output.index && rootState.index == selected.root.index
            }
            let mut prefix = usize.ZERO
            while !segmented && !anchored && prefix < states.length {
              let state = Prepared.ResidualStateId {index: prefix}
              if invocationProjectionPrefix(prepared, channel.site, output, selected.root, projection.output, state, states.length)
                && containsResidual(List<Prepared.ResidualStateId>.asSlice(&states[prefix].next), rootState) { anchored = true }
              prefix = prefix + usize.ONE
            }
            if anchored {
              current = usize.ZERO
              while current < continuations.length {
                if continuations[current].projection.index == id.index && continuations[current].outputState.index == selected.current.index
                  && invocationContinuationDescends(continuations, roots[root], Prepared.ContractContinuationId {index: current}, continuations.length) {
                  run invocationPlacement(&mut closure.*, &mut skeleton.rules, origin, Option<usize>.some(suffix), id,
                    Option<Prepared.ContractContinuationId>.some(Prepared.ContractContinuationId {index: current}),
                    Option<Prepared.ContractContinuationId>.some(roots[root]), continuations[current].originalSelection)
                }
                current = current + usize.ONE
              }
            }
            root = root + usize.ONE
          }
        }
        suffix = suffix + usize.ONE
      }
      each = each + usize.ONE
    }
    origin = origin + usize.ONE
  }
  return ()
}

// A receiver prefix and selected continuation must already share one frozen authored
// successor graph. A child-relative query from another selection cannot be prepended.
fn invocationCallSuffix<'body>(prepared: &SourcePreparation<'body>, pair: InvocationCallPair,
  root: Prepared.ResidualStateId, current: Prepared.ResidualStateId) -> bool {
  let channel = &List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)[pair.channel]
  let projection = &List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)[pair.receiverProjection.index]
  let output = List<SelectionMap>.asSlice(&prepared.maps)[channel.map.index].source
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  if !authoredResidual(&states[root.index]) || !authoredResidual(&states[current.index])
    || states[root.index].input.shape.index != List<Endpoint>.asSlice(&prepared.endpoints)[output.index].shape.index
    || !invocationDescends(states, root, current, states.length) { return false }
  let site = List<Prepared.Operation>.asSlice(&prepared.operations)[channel.operation].site
  return match pair.receiver {
    Option<Prepared.ContractContinuationId>.None =>
      invocationProjectionPrefix(prepared, site, output, root, projection.output, current, states.length)
    Option<Prepared.ContractContinuationId>.Some {value} => {
      let rows = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
      if rows[value.index].outputState.index != current.index { return false }
      let first = match pair.receiverRoot { Option<Prepared.ContractContinuationId>.Some {value: matchedReceiverRoot} => rows[matchedReceiverRoot.index].outputState
        _ => { return CompilerBug.panic(b"callable receiver suffix lost its paired projection root") } }
      // Inline-prefix continuations use the explicit segmented request below, including
      // when their independent history also happens to share an authored parent graph.
      return projection.output.index == output.index && first.index == root.index
    }
  }
}

effect fn invocationCallOutput(closure: &mut InvocationClosure, program: &mut Program, pair: usize,
  suffix: Option<usize>) -> () ! OutOfMemoryError ? &mut Allocator {
  let old = List<InvocationCallOutput>.asSlice(&closure.callOutputs)
  let mut at = usize.ZERO
  while at < old.length {
    let same = match old[at].suffix {
      Option<usize>.Some {value} => match suffix { Option<usize>.Some {value: other} => value == other _ => false }
      _ => match suffix { Option<usize>.None => true _ => false }
    }
    if old[at].pair == pair && same { return () }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut program.*)
  let pairActive = List<InvocationCallPair>.asSlice(&closure.callPairs)[pair].active
  let empty = List<Atom>.make()
  let gates: [Atom; 1] = [pairActive]
  run Program.rule(&mut program.*, active, &gates, List<Atom>.asSlice(&empty))
  if let Option<usize>.Some {value} = suffix {
    let admitted: [Atom; 1] = [active]
    run Program.rule(&mut program.*, List<InvocationSuffix>.asSlice(&closure.suffixes)[value].active,
      &admitted, List<Atom>.asSlice(&empty))
  }
  run List<InvocationCallOutput>.append(&mut closure.callOutputs, InvocationCallOutput {pair: pair, suffix: suffix, active: active})
  return ()
}

effect fn closeInvocationCallOutputs<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton) -> () ! OutOfMemoryError ? &mut Allocator {
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let mut pairId = closure.callOutputsScanned
  while pairId < List<InvocationCallPair>.length(&closure.callPairs) {
    let pair = List<InvocationCallPair>.asSlice(&closure.callPairs)[pairId]
    let origin = List<InvocationOrigin>.asSlice(&closure.origins)[pair.origin]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[List<InvocationNode>.asSlice(&closure.nodes)[origin.node].demand]
    let channel = &List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)[pair.channel]
    let projection = &List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)[pair.receiverProjection.index]
    let anchor = List<SelectionMap>.asSlice(&prepared.maps)[channel.map.index].source
    if let Option<Prepared.ContractContinuationId>.None = pair.receiver {
      if projection.output.index == anchor.index {
        run invocationCallOutput(&mut closure.*, &mut skeleton.rules, pairId, Option<usize>.none())
      }
    }
    let unsegmented = match pair.receiver {
      Option<Prepared.ContractContinuationId>.None => true
      _ => projection.output.index == anchor.index
    }
    let mut root = usize.ZERO
    while unsegmented && root < states.length {
      if authoredResidual(&states[root]) && states[root].input.shape.index == List<Endpoint>.asSlice(&prepared.endpoints)[anchor.index].shape.index {
        let mut current = usize.ZERO
        let mut limit = states.length
        if let Option<Prepared.ContractContinuationId>.Some {value} = pair.receiver {
          current = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[value.index].outputState.index
          limit = current + usize.ONE
        }
        while current < limit {
          let first = Prepared.ResidualStateId {index: root}
          let last = Prepared.ResidualStateId {index: current}
          if invocationCallSuffix(prepared, pair, first, last) {
            let suffix = run InvocationClosure.suffix(&mut closure.*, &mut skeleton.rules, demand.node, first, last, first, last, Option<Results.DescriptorPrefix>.none())
            run invocationCallOutput(&mut closure.*, &mut skeleton.rules, pairId, Option<usize>.some(suffix))
          }
          current = current + usize.ONE
        }
      }
      root = root + usize.ONE
    }
    if let Option<Prepared.ContractContinuationId>.Some {value: current} = pair.receiver {
      let rows = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
      let relativeRoot = match pair.receiverRoot { Option<Prepared.ContractContinuationId>.Some {value} => rows[value.index].outputState
        _ => { return CompilerBug.panic(b"segmented receiver request lost its paired relative root") } }
      let relative = rows[current.index].outputState
      let mut prefixRoot = usize.ZERO
      while prefixRoot < states.length {
        if authoredResidual(&states[prefixRoot]) && states[prefixRoot].input.shape.index == List<Endpoint>.asSlice(&prepared.endpoints)[anchor.index].shape.index {
          let mut prefixCurrent = usize.ZERO
          while prefixCurrent < states.length {
            let first = Prepared.ResidualStateId {index: prefixRoot}
            let last = Prepared.ResidualStateId {index: prefixCurrent}
            if states[prefixCurrent].output.index == states[relativeRoot.index].input.shape.index
              && Results.receiverPrefix(prepared, pair.channel, pair.receiverProjection, first, last) {
              let prefix = Results.DescriptorPrefix {projection: pair.receiverProjection, requestedRoot: first, requested: last, root: first, current: last}
              let suffix = run InvocationClosure.suffix(&mut closure.*, &mut skeleton.rules, demand.node,
                relativeRoot, relative, relativeRoot, relative, Option<Results.DescriptorPrefix>.some(prefix))
              run invocationCallOutput(&mut closure.*, &mut skeleton.rules, pairId, Option<usize>.some(suffix))
            }
            prefixCurrent = prefixCurrent + usize.ONE
          }
        }
        prefixRoot = prefixRoot + usize.ONE
      }
    }
    pairId = pairId + usize.ONE
  }
  closure.callOutputsScanned = pairId
  return ()
}

struct InvocationResultTarget {
  output: MapId
  invocation: Option<Results.DescriptorInvocation>
  active: Atom
}
impl Copy for InvocationResultTarget {}

effect fn invocationResultTargets<'body>(closure: &InvocationClosure, prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  selected: InvocationPlacement) -> List<InvocationResultTarget> ! OutOfMemoryError ? &mut Allocator {
  let origin = List<InvocationOrigin>.asSlice(&closure.origins)[selected.origin]
  let demand = List<InvocationDemand>.asSlice(&closure.demands)[List<InvocationNode>.asSlice(&closure.nodes)[origin.node].demand]
  let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
  let mut targets = List<InvocationResultTarget>.make()
  if let ResultsPlan.ExecuteEffect {result, ..} = &operation.plan {
    run List<InvocationResultTarget>.append(&mut targets, InvocationResultTarget {
      output: result, invocation: Option<Results.DescriptorInvocation>.none(), active: selected.active})
    return move targets
  }
  let outputs = match &operation.plan { ResultsPlan.CallableInvoke {outputs, ..} => List<Results.Output>.asSlice(&outputs)
    _ => { return move targets } }
  let requests = List<InvocationCallOutput>.asSlice(&closure.callOutputs)
  let suffixes = List<InvocationSuffix>.asSlice(&closure.suffixes)
  let contributors = List<InvocationCallContributor>.asSlice(&closure.callContributors)
  let mut at = usize.ZERO
  while at < requests.length {
    let request = requests[at]
    let pair = List<InvocationCallPair>.asSlice(&closure.callPairs)[request.pair]
    let same = match selected.suffix {
      Option<usize>.Some {value} => match request.suffix {
        Option<usize>.Some {value: wanted} => suffixes[value].requestedRoot.index == suffixes[wanted].root.index
          && suffixes[value].requested.index == suffixes[wanted].current.index
          && Results.sameRequestedPrefix(suffixes[value].prefix, suffixes[wanted].prefix)
        _ => false
      }
      _ => match request.suffix { Option<usize>.None => true _ => false }
    }
    if pair.origin == selected.origin && same {
      let mut row = usize.ZERO
      while row < contributors.length {
        if contributors[row].pair == request.pair && contributors[row].operation == demand.operation {
          run List<InvocationResultTarget>.append(&mut targets, InvocationResultTarget {
            output: outputs[contributors[row].output].map, active: request.active,
            invocation: Option<Results.DescriptorInvocation>.some(Results.DescriptorInvocation {
              channel: pair.channel, pair: request.pair, resultProjection: pair.resultProjection,
              prefix: match selected.suffix { Option<usize>.Some {value} => suffixes[value].prefix _ => Option<Results.DescriptorPrefix>.none() },
              resultRoot: pair.resultRoot, resultContinuation: pair.result})})
        }
        row = row + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move targets
}

effect fn emitInvocationResults<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton) -> () ! OutOfMemoryError ? &mut Allocator {
  let selections = List<Prepared.ContractSelection>.asSlice(&prepared.contractSelections)
  let routes = List<ContractRoute>.asSlice(&prepared.routes)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let empty = List<Atom>.make()
  let mut placement = usize.ZERO
  while placement < List<InvocationPlacement>.length(&closure.placements) {
    let selected = List<InvocationPlacement>.asSlice(&closure.placements)[placement]
    let origin = List<InvocationOrigin>.asSlice(&closure.origins)[selected.origin]
    let node = List<InvocationNode>.asSlice(&closure.nodes)[origin.node]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[node.demand]
    // Copy only scalar coordinates before appending Values/Transfers to the skeleton.
    let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
    let operationIndex = operation.prepared
    let evaluation = operation.evaluation
    let receiver = match operation.receiver { Option<Results.Receiver>.Some {value} => value
      _ => { return CompilerBug.panic(b"descriptor result lost its actual receiver") } }
    let targets = run invocationResultTargets(&closure.*, prepared, &skeleton.*, selected)
    let targetsSelected = List<InvocationResultTarget>.asSlice(&targets)
    let mut target = usize.ZERO
    while target < targetsSelected.length {
      let output = targetsSelected[target].output
      let invocation = targetsSelected[target].invocation
      let declared = List<ContractRouteId>.asSlice(&selections[selected.selection.index].routes)
      let mut route = usize.ZERO
      while route < declared.length {
        let mut capture = usize.ZERO
        while capture < List<InvocationCapture>.length(&closure.captures) {
          let current = List<InvocationCapture>.asSlice(&closure.captures)[capture]
          if current.origin == selected.origin && current.node == demand.node
            && Results.descriptorOriginal(prepared, current.source).index == routes[declared[route].index].source.index {
            let old = List<InvocationEmission>.asSlice(&closure.emissions)
            let mut found = false
            let mut previous = usize.ZERO
            while previous < old.length {
              if old[previous].capture == capture && old[previous].placement == placement && old[previous].route.index == declared[route].index
                && old[previous].candidate.output.index == output.index {
                if let ResultsBinding.DescriptorInput {invocation: before, ..} = old[previous].candidate.binding {
                  if Results.sameDescriptorInvocation(before, invocation) { found = true }
                }
              }
              previous = previous + usize.ONE
            }
            if !found {
              let mut requestedRoot = Option<Prepared.ResidualStateId>.none()
              let mut requested = Option<Prepared.ResidualStateId>.none()
              let mut producerRoot = Option<Prepared.ResidualStateId>.none()
              let mut producerState = Option<Prepared.ResidualStateId>.none()
              if let Option<usize>.Some {value} = selected.suffix {
                let suffix = List<InvocationSuffix>.asSlice(&closure.suffixes)[value]
                requestedRoot = Option<Prepared.ResidualStateId>.some(suffix.requestedRoot)
                requested = Option<Prepared.ResidualStateId>.some(suffix.requested)
                producerRoot = Option<Prepared.ResidualStateId>.some(suffix.root)
                producerState = Option<Prepared.ResidualStateId>.some(suffix.current)
              }
              let candidate = Results.Candidate {operation: operationIndex,
                binding: ResultsBinding.DescriptorInput {channel: origin.channel, source: current.source, producer: origin.producer,
                  receiverPosition: receiver.position, proof: selected.origin, capture: capture, placement: placement,
                  requestedRoot: requestedRoot, requested: requested, producerRoot: producerRoot, producerState: producerState,
                  originalRoot: selected.originalRoot, invocation: invocation},
                operand: receiver.actual.evaluation, usePoint: receiver.actual.usePoint, result: evaluation,
                source: current.endpoint, target: maps[output.index].target, output: output, selection: selected.selection,
                route: declared[route], projection: selected.projection, continuation: selected.continuation}
              let active = Program.atom(&mut skeleton.rules)
              let gates: [Atom; 3] = [current.active, selected.active, targetsSelected[target].active]
              run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
              drop run Skeleton.operationResult(&mut skeleton.*, prepared, candidate, active)
              run List<InvocationEmission>.append(&mut closure.emissions, InvocationEmission {capture: capture,
                placement: placement, route: declared[route], candidate: candidate, active: active})
            }
          }
          capture = capture + usize.ONE
        }
        route = route + usize.ONE
      }
      target = target + usize.ONE
    }
    placement = placement + usize.ONE
  }
  return ()
}

fn invocationPairSelection<'body>(prepared: &SourcePreparation<'body>, projection: Prepared.ContractProjectionId,
  current: Option<Prepared.ContractContinuationId>) -> Prepared.ContractSelectionId {
  return match current {
    Option<Prepared.ContractContinuationId>.Some {value} => List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[value.index].originalSelection
    _ => Results.rootSelection(prepared, projection)
  }
}

fn invocationPairNext<'body>(prepared: &SourcePreparation<'body>, projection: Prepared.ContractProjectionId,
  current: Option<Prepared.ContractContinuationId>) -> &[Prepared.ContractContinuationId] {
  return match current {
    Option<Prepared.ContractContinuationId>.Some {value} => List<Prepared.ContractContinuationId>.asSlice(
      &List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[value.index].next)
    _ => List<Prepared.ContractContinuationId>.asSlice(
      &List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)[projection.index].continuations)
  }
}

// A whole root may remain stationary only when the other side inherits its already paired
// original enumeration. An empty path is not a globally interchangeable original subject.
fn invocationInherited<'body>(prepared: &SourcePreparation<'body>, previous: Prepared.ContractSelectionId,
  current: Option<Prepared.ContractContinuationId>) -> bool {
  return match current {
    Option<Prepared.ContractContinuationId>.Some {value} => {
      let row = &List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)[value.index]
      return row.originalSelection.index == previous.index && List<Prepared.ResidualStateId>.length(&row.originalPath) == usize.ZERO
        && match row.originalState { Option<Prepared.ResidualStateId>.None => true _ => false }
    }
    _ => false
  }
}

fn invocationPairAdvance<'body>(prepared: &SourcePreparation<'body>, parent: InvocationCallPair,
  left: Option<Prepared.ContractContinuationId>, right: Option<Prepared.ContractContinuationId>) -> bool {
  let leftMoves = !sameInvocationContinuation(parent.receiver, left)
  let rightMoves = !sameInvocationContinuation(parent.result, right)
  if !leftMoves && !rightMoves { return false }
  if !leftMoves { return invocationInherited(prepared, parent.resultSelection, right) }
  if !rightMoves { return invocationInherited(prepared, parent.receiverSelection, left) }
  let l = match left { Option<Prepared.ContractContinuationId>.Some {value} => value _ => { return false } }
  let r = match right { Option<Prepared.ContractContinuationId>.Some {value} => value _ => { return false } }
  let continuations = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
  let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let first = &continuations[l.index]
  let second = &continuations[r.index]
  let a = List<Prepared.ResidualStateId>.asSlice(&first.originalPath)
  let b = List<Prepared.ResidualStateId>.asSlice(&second.originalPath)
  if first.original.index != second.original.index || a.length != b.length { return false }
  if a.length == usize.ZERO {
    return invocationInherited(prepared, parent.receiverSelection, left)
      && invocationInherited(prepared, parent.resultSelection, right)
  }
  let mut at = usize.ZERO
  while at < a.length {
    // Exact original ComponentId under matched parents, including normalization prefixes.
    // These are frozen original coordinates, not a comparison of finalized output shapes.
    if states[a[at].index].input.shape.index != states[b[at].index].input.shape.index
      || states[a[at].index].input.ordinal != states[b[at].index].input.ordinal { return false }
    at = at + usize.ONE
  }
  return match first.originalState {
    Option<Prepared.ResidualStateId>.Some {..} => match second.originalState { Option<Prepared.ResidualStateId>.Some {..} => true _ => false }
    _ => match second.originalState { Option<Prepared.ResidualStateId>.None => true _ => false }
  }
}

effect fn closeInvocationCallPairs<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton) -> () ! OutOfMemoryError ? &mut Allocator {
  let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let empty = List<Atom>.make()
  let mut origin = usize.ZERO
  while origin < List<InvocationOrigin>.length(&closure.origins) {
    let producer = List<InvocationOrigin>.asSlice(&closure.origins)[origin]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[List<InvocationNode>.asSlice(&closure.nodes)[producer.node].demand]
    let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
    if let ResultsPlan.CallableInvoke {channel: Option<usize>.Some {value: channel}, ..} = &operation.plan {
      let left = List<Prepared.ContractProjectionId>.asSlice(&channels[channel].receiverProjections)
      let right = List<Prepared.ContractProjectionId>.asSlice(&channels[channel].resultProjections)
      let mut l = usize.ZERO
      while l < left.length {
        let mut r = usize.ZERO
        while r < right.length {
          if projections[left[l].index].original.index == projections[right[r].index].original.index {
            let old = List<InvocationCallPair>.asSlice(&closure.callPairs)
            let mut found = false
            let mut at = usize.ZERO
            while at < old.length {
              if old[at].origin == origin && old[at].channel == channel && old[at].root == at
                && old[at].receiverProjection.index == left[l].index && old[at].resultProjection.index == right[r].index { found = true }
              at = at + usize.ONE
            }
            if !found {
              let id = old.length
              let leftSelection = Results.rootSelection(prepared, left[l])
              let rightSelection = Results.rootSelection(prepared, right[r])
              if leftSelection.index != rightSelection.index { return CompilerBug.panic(b"paired invocation roots changed their exact original whole enumeration") }
              let active = Program.atom(&mut skeleton.rules)
              let gates: [Atom; 1] = [producer.active]
              run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
              run List<InvocationCallPair>.append(&mut closure.callPairs, InvocationCallPair {
                origin: origin, channel: channel, root: id, receiverProjection: left[l], resultProjection: right[r],
                receiverRoot: Option<Prepared.ContractContinuationId>.none(), resultRoot: Option<Prepared.ContractContinuationId>.none(),
                receiver: Option<Prepared.ContractContinuationId>.none(), result: Option<Prepared.ContractContinuationId>.none(),
                receiverSelection: leftSelection, resultSelection: rightSelection, outputMissing: Program.atom(&mut skeleton.rules), active: active})
            }
          }
          r = r + usize.ONE
        }
        l = l + usize.ONE
      }
    }
    origin = origin + usize.ONE
  }
  let mut at = usize.ZERO
  while at < List<InvocationCallPair>.length(&closure.callPairs) {
    let parent = List<InvocationCallPair>.asSlice(&closure.callPairs)[at]
    let left = invocationPairNext(prepared, parent.receiverProjection, parent.receiver)
    let right = invocationPairNext(prepared, parent.resultProjection, parent.result)
    let mut l = usize.ZERO
    while l <= left.length {
      let mut selectedLeft = parent.receiver
      if l < left.length { selectedLeft = Option<Prepared.ContractContinuationId>.some(left[l]) }
      let mut r = usize.ZERO
      while r <= right.length {
        let mut selectedRight = parent.result
        if r < right.length { selectedRight = Option<Prepared.ContractContinuationId>.some(right[r]) }
        if invocationPairAdvance(prepared, parent, selectedLeft, selectedRight) {
          let mut leftRoot = parent.receiverRoot
          let mut rightRoot = parent.resultRoot
          if let Option<Prepared.ContractContinuationId>.None = leftRoot { leftRoot = selectedLeft }
          if let Option<Prepared.ContractContinuationId>.None = rightRoot { rightRoot = selectedRight }
          let old = List<InvocationCallPair>.asSlice(&closure.callPairs)
          let mut target = usize.MAX
          let mut previous = usize.ZERO
          while previous < old.length {
            if old[previous].root == parent.root && sameInvocationContinuation(old[previous].receiverRoot, leftRoot)
              && sameInvocationContinuation(old[previous].resultRoot, rightRoot)
              && sameInvocationContinuation(old[previous].receiver, selectedLeft) && sameInvocationContinuation(old[previous].result, selectedRight) { target = previous }
            previous = previous + usize.ONE
          }
          if target == usize.MAX {
            target = old.length
            run List<InvocationCallPair>.append(&mut closure.callPairs, InvocationCallPair {origin: parent.origin,
              channel: parent.channel, root: parent.root, receiverProjection: parent.receiverProjection, resultProjection: parent.resultProjection,
              receiverRoot: leftRoot, resultRoot: rightRoot, receiver: selectedLeft, result: selectedRight,
              receiverSelection: invocationPairSelection(prepared, parent.receiverProjection, selectedLeft),
              resultSelection: invocationPairSelection(prepared, parent.resultProjection, selectedRight), outputMissing: Program.atom(&mut skeleton.rules), active: Program.atom(&mut skeleton.rules)})
          }
          let edges = List<InvocationCallEdge>.asSlice(&closure.callEdges)
          let mut found = false
          previous = usize.ZERO
          while previous < edges.length { if edges[previous].source == at && edges[previous].target == target { found = true } previous = previous + usize.ONE }
          if !found {
            let active = Program.atom(&mut skeleton.rules)
            let gates: [Atom; 1] = [parent.active]
            run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
            let admitted: [Atom; 1] = [active]
            run Program.rule(&mut skeleton.rules, List<InvocationCallPair>.asSlice(&closure.callPairs)[target].active,
              &admitted, List<Atom>.asSlice(&empty))
            run List<InvocationCallEdge>.append(&mut closure.callEdges, InvocationCallEdge {source: at, target: target, active: active})
          }
        }
        r = r + usize.ONE
      }
      l = l + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn emitInvocationCallResults<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton) -> () ! OutOfMemoryError ? &mut Allocator {
  let empty = List<Atom>.make()
  let mut pair = usize.ZERO
  while pair < List<InvocationCallPair>.length(&closure.callPairs) {
    let selected = List<InvocationCallPair>.asSlice(&closure.callPairs)[pair]
    let origin = List<InvocationOrigin>.asSlice(&closure.origins)[selected.origin]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[List<InvocationNode>.asSlice(&closure.nodes)[origin.node].demand]
    let mut candidates = List<Results.Candidate>.make()
    let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
    if let ResultsPlan.CallableInvoke {outputs, ..} = &operation.plan {
      let outputsSelected = List<Results.Output>.asSlice(&outputs)
      let mut output = usize.ZERO
      while output < outputsSelected.length {
        let contributors = List<Results.Contributor>.asSlice(&outputsSelected[output].contributors)
        let mut contributor = usize.ZERO
        while contributor < contributors.length {
          let row = &contributors[contributor]
          if row.projection.index == selected.resultProjection.index && sameInvocationContinuation(row.continuation, selected.result)
            && row.selection.index == selected.resultSelection.index {
            let old = List<InvocationCallContributor>.asSlice(&closure.callContributors)
            let mut found = false
            let mut previous = usize.ZERO
            while previous < old.length {
              if old[previous].pair == pair && old[previous].output == output && old[previous].contributor == contributor { found = true }
              previous = previous + usize.ONE
            }
            if !found {
              run List<InvocationCallContributor>.append(&mut closure.callContributors, InvocationCallContributor {
                pair: pair, operation: demand.operation, output: output, contributor: contributor, active: selected.active})
              let rows = List<Results.Candidate>.asSlice(&row.candidates)
              let mut candidate = usize.ZERO
              while candidate < rows.length { run List<Results.Candidate>.append(&mut candidates, rows[candidate]) candidate = candidate + usize.ONE }
            }
          }
          contributor = contributor + usize.ONE
        }
        output = output + usize.ONE
      }
    }
    let candidatesSelected = List<Results.Candidate>.asSlice(&candidates)
    let mut at = usize.ZERO
    while at < candidatesSelected.length {
      let mut candidate = candidatesSelected[at]
      candidate.binding = match candidate.binding {
        ResultsBinding.Argument {input, inputMap, position} => ResultsBinding.CallableArgument {
          input: input, inputMap: inputMap, position: position, channel: selected.channel, proof: selected.origin, pair: pair,
          receiverProjection: selected.receiverProjection, receiverContinuation: selected.receiver, resultRoot: selected.resultRoot}
        _ => { return CompilerBug.panic(b"callable argument inventory substituted a capture binding") }
      }
      let active = Program.atom(&mut skeleton.rules)
      let gates: [Atom; 2] = [selected.active, Flow.reachable(&skeleton.flow, candidate.usePoint)]
      run Program.rule(&mut skeleton.rules, active, &gates, List<Atom>.asSlice(&empty))
      drop run Skeleton.operationResult(&mut skeleton.*, prepared, candidate, active)
      run List<InvocationCallEmission>.append(&mut closure.callEmissions, InvocationCallEmission {pair: pair, candidate: candidate, active: active})
      at = at + usize.ONE
    }
    pair = pair + usize.ONE
  }
  return ()
}

fn invocationSize(closure: &InvocationClosure) -> usize {
  return List<InvocationCallOutput>.length(&closure.callOutputs) + List<InvocationCallPair>.length(&closure.callPairs) + List<InvocationCallEdge>.length(&closure.callEdges)
    + List<InvocationCallContributor>.length(&closure.callContributors) + List<InvocationCallEmission>.length(&closure.callEmissions)
    + List<InvocationDemand>.length(&closure.demands) + List<InvocationNode>.length(&closure.nodes)
    + List<InvocationStep>.length(&closure.steps) + List<InvocationOrigin>.length(&closure.origins)
    + List<InvocationCapture>.length(&closure.captures) + List<InvocationCaptureStep>.length(&closure.captureSteps)
    + List<InvocationSuffix>.length(&closure.suffixes) + List<InvocationSuffixStep>.length(&closure.suffixSteps)
    + List<InvocationPlacement>.length(&closure.placements) + List<InvocationContributor>.length(&closure.contributors)
    + List<InvocationEmission>.length(&closure.emissions) + List<InvocationGap>.length(&closure.gaps)
    + List<InvocationCaptureSource>.length(&closure.captureSources) + List<InvocationCaptureValue>.length(&closure.captureValues)
    + List<InvocationCaptureEdge>.length(&closure.captureEdges)
    + List<InvocationDeclaration>.length(&closure.declarations) + List<InvocationDeclaredOutput>.length(&closure.declaredOutputs)
    + List<InvocationDeclaredPublication>.length(&closure.declaredPublications)
}
effect fn closeInvocations<'body>(closure: &mut InvocationClosure, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, descriptors: &mut DescriptorClosure) -> bool ! OutOfMemoryError ? &mut Allocator {
  let before = invocationSize(&closure.*)
  run indexInvocationCases(&mut closure.caseIndex, &skeleton.*, domain)
  run invocationDemands(&mut closure.*, prepared, &mut skeleton.*, domain)
  drop run closeInvocationCases(&mut closure.*, prepared, &mut skeleton.*, domain, &descriptors.*)
  run invocationOrigins(&mut closure.*, prepared, &mut skeleton.*, domain)
  run closeInvocationDeclarations(&mut closure.*, prepared, &mut skeleton.*, domain)
  run closeInvocationCaptures(&mut closure.*, prepared, &mut skeleton.*, domain, &descriptors.*)
  run closeInvocationCaptureValues(&mut closure.*, prepared, &mut skeleton.*, domain)
  run closeInvocationSuffixes(&mut closure.*, prepared, &mut skeleton.*, domain, &mut descriptors.*)
  run closeInvocationPlacements(&mut closure.*, prepared, &mut skeleton.*)
  run closeInvocationCallPairs(&mut closure.*, prepared, &mut skeleton.*)
  run emitInvocationCallResults(&mut closure.*, prepared, &mut skeleton.*)
  run closeInvocationCallOutputs(&mut closure.*, prepared, &mut skeleton.*)
  run emitInvocationResults(&mut closure.*, prepared, &mut skeleton.*)
  return before != invocationSize(&closure.*)
}


fn validateInvocationCalls<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton, closure: &InvocationClosure) -> () {
  let pairs = List<InvocationCallPair>.asSlice(&closure.callPairs)
  let origins = List<InvocationOrigin>.asSlice(&closure.origins)
  let channels = List<Prepared.InvocationChannel>.asSlice(&prepared.invocationChannels)
  let projections = List<Prepared.ContractProjection>.asSlice(&prepared.contractProjections)
  let mut at = usize.ZERO
  while at < pairs.length {
    let pair = pairs[at]
    let origin = origins[pair.origin]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[List<InvocationNode>.asSlice(&closure.nodes)[origin.node].demand]
    let actual = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
    if channels[pair.channel].operation != actual.prepared || pair.root >= pairs.length
      || pairs[pair.root].origin != pair.origin || pairs[pair.root].channel != pair.channel
      || pairs[pair.root].receiverProjection.index != pair.receiverProjection.index
      || pairs[pair.root].resultProjection.index != pair.resultProjection.index
      || projections[pair.receiverProjection.index].original.index != projections[pair.resultProjection.index].original.index
      || invocationPairSelection(prepared, pair.receiverProjection, pair.receiver).index != pair.receiverSelection.index
      || invocationPairSelection(prepared, pair.resultProjection, pair.result).index != pair.resultSelection.index {
      CompilerBug.panic(b"callable projection pair lost its actual receiver origin or original enumeration")
    }
    at = at + usize.ONE
  }
  let edges = List<InvocationCallEdge>.asSlice(&closure.callEdges)
  at = usize.ZERO
  while at < edges.length {
    let source = pairs[edges[at].source]
    let target = pairs[edges[at].target]
    if source.root != target.root || !invocationPairAdvance(prepared, source, target.receiver, target.result) {
      CompilerBug.panic(b"callable projection pair lost its paired original parent")
    }
    let left = invocationPairNext(prepared, source.receiverProjection, source.receiver)
    let right = invocationPairNext(prepared, source.resultProjection, source.result)
    let mut l = sameInvocationContinuation(source.receiver, target.receiver)
    let mut r = sameInvocationContinuation(source.result, target.result)
    let mut each = usize.ZERO
    while each < left.length { if sameInvocationContinuation(target.receiver, Option<Prepared.ContractContinuationId>.some(left[each])) { l = true } each = each + usize.ONE }
    each = usize.ZERO
    while each < right.length { if sameInvocationContinuation(target.result, Option<Prepared.ContractContinuationId>.some(right[each])) { r = true } each = each + usize.ONE }
    if !l || !r { CompilerBug.panic(b"callable projection pair skipped a declared successor") }
    at = at + usize.ONE
  }
  let requests = List<InvocationCallOutput>.asSlice(&closure.callOutputs)
  let suffixes = List<InvocationSuffix>.asSlice(&closure.suffixes)
  at = usize.ZERO
  while at < requests.length {
    let request = requests[at]
    let pair = pairs[request.pair]
    let origin = origins[pair.origin]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[List<InvocationNode>.asSlice(&closure.nodes)[origin.node].demand]
    match request.suffix {
      Option<usize>.Some {value} => {
        let suffix = suffixes[value]
        let mut authentic = false
        match suffix.prefix {
          Option<Results.DescriptorPrefix>.Some {value: prefix} => {
            let rows = List<Prepared.ContractContinuation>.asSlice(&prepared.contractContinuations)
            let root = match pair.receiverRoot { Option<Prepared.ContractContinuationId>.Some {value: matchedReceiverRoot} => rows[matchedReceiverRoot.index].outputState
              _ => { return CompilerBug.panic(b"segmented callable request lost its relative projection root") } }
            let current = match pair.receiver { Option<Prepared.ContractContinuationId>.Some {value: matchedReceiverCurrent} => rows[matchedReceiverCurrent.index].outputState
              _ => { return CompilerBug.panic(b"segmented callable request substituted a whole result") } }
            let states = List<Prepared.ResidualState>.asSlice(&prepared.residuals)
            let anchor = List<SelectionMap>.asSlice(&prepared.maps)[channels[pair.channel].map.index].source
            authentic = prefix.projection.index == pair.receiverProjection.index && prefix.requestedRoot.index == prefix.root.index
              && prefix.requested.index == prefix.current.index && root.index == suffix.root.index && current.index == suffix.current.index
              && states[prefix.root.index].input.shape.index == List<Endpoint>.asSlice(&prepared.endpoints)[anchor.index].shape.index
              && states[prefix.current.index].output.index == states[root.index].input.shape.index
              && Results.receiverPrefix(prepared, pair.channel, prefix.projection, prefix.root, prefix.current)
          }
          _ => { authentic = invocationCallSuffix(prepared, pair, suffix.root, suffix.current) }
        }
        if suffix.node != demand.node || suffix.requestedRoot.index != suffix.root.index
          || suffix.requested.index != suffix.current.index || !authentic {
          CompilerBug.panic(b"callable captured output request changed its actual receiver or authored prefix")
        }
      }
      _ => {
        let anchor = List<SelectionMap>.asSlice(&prepared.maps)[channels[pair.channel].map.index].source
        if projections[pair.receiverProjection.index].output.index != anchor.index {
          CompilerBug.panic(b"whole callable captured output discarded its receiver prefix")
        }
        if let Option<Prepared.ContractContinuationId>.Some {..} = pair.receiver {
          CompilerBug.panic(b"selected callable receiver became a whole captured output")
        }
      }
    }
    at = at + usize.ONE
  }
  let emissions = List<InvocationCallEmission>.asSlice(&closure.callEmissions)
  at = usize.ZERO
  while at < emissions.length {
    let emitted = emissions[at]
    let pair = pairs[emitted.pair]
    let candidate = emitted.candidate
    Results.validateCandidate(prepared, candidate)
    let origin = origins[pair.origin]
    let demand = List<InvocationDemand>.asSlice(&closure.demands)[List<InvocationNode>.asSlice(&closure.nodes)[origin.node].demand]
    let actual = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
    let mut binding = false
    match candidate.binding {
      ResultsBinding.CallableArgument {input, position, channel, proof, pair: selected, receiverProjection, receiverContinuation, resultRoot, ..} => {
        if channel != pair.channel || proof != pair.origin || selected != emitted.pair
          || receiverProjection.index != pair.receiverProjection.index || !sameInvocationContinuation(receiverContinuation, pair.receiver)
          || !sameInvocationContinuation(resultRoot, pair.resultRoot) { CompilerBug.panic(b"callable argument lost its actual paired receiver proof") }
        let inputs = List<Results.Input>.asSlice(&actual.inputs)
        let mut found = false
        let mut each = usize.ZERO
        while each < inputs.length {
          if inputs[each].route == input && inputs[each].position == position
            && inputs[each].actual.evaluation.index == candidate.operand.index && inputs[each].actual.usePoint.index == candidate.usePoint.index { found = true }
          each = each + usize.ONE
        }
        binding = found
      }
      _ => ()
    }
    if !binding || candidate.operation != actual.prepared || candidate.result.index != actual.evaluation.index
      || candidate.projection.index != pair.resultProjection.index || candidate.selection.index != pair.resultSelection.index
      || !sameInvocationContinuation(candidate.continuation, pair.result) { CompilerBug.panic(b"callable argument changed its actual operation/input or result contributor") }
    at = at + usize.ONE
  }
  let transfers = List<Transfer>.asSlice(&skeleton.transfers)
  at = usize.ZERO
  while at < transfers.length {
    if let TransferAuthority.OperationResult {candidate, ..} = transfers[at].authority {
      if let ResultsBinding.Argument {..} = candidate.binding {
        let operation = &List<Prepared.Operation>.asSlice(&prepared.operations)[candidate.operation]
        if let Option<EndpointId>.Some {..} = operation.receiver { CompilerBug.panic(b"callable argument bypassed its actual receiver binding") }
      }
      if let ResultsBinding.CallableArgument {..} = candidate.binding {
        let mut found = false
        let mut each = usize.ZERO
        while each < emissions.length { if sameInvocationCandidate(candidate, emissions[each].candidate) { found = true } each = each + usize.ONE }
        if !found { CompilerBug.panic(b"callable argument bypassed its actual receiver emission") }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn sameInvocationCandidate(left: Results.Candidate, right: Results.Candidate) -> bool {
  if left.operation != right.operation || left.operand.index != right.operand.index || left.usePoint.index != right.usePoint.index
    || left.result.index != right.result.index || left.source.index != right.source.index || left.target.index != right.target.index
    || left.selection.index != right.selection.index || left.route.index != right.route.index || left.projection.index != right.projection.index
    || !sameInvocationContinuation(left.continuation, right.continuation) || left.output.index != right.output.index { return false }
  return match left.binding {
    ResultsBinding.Argument {input, inputMap, position} => match right.binding {
      ResultsBinding.Argument {input: otherInput, inputMap: otherMap, position: otherPosition} =>
        input == otherInput && inputMap.index == otherMap.index && position == otherPosition
      _ => false
    }
    ResultsBinding.CallableArgument {input, inputMap, position, channel, proof, pair, receiverProjection, receiverContinuation, resultRoot} => match right.binding {
      ResultsBinding.CallableArgument {input: otherInput, inputMap: otherMap, position: otherPosition, channel: otherChannel,
        proof: otherProof, pair: otherPair, receiverProjection: otherProjection, receiverContinuation: otherContinuation, resultRoot: otherRoot} =>
          input == otherInput && inputMap.index == otherMap.index && position == otherPosition && channel == otherChannel
          && proof == otherProof && pair == otherPair && receiverProjection.index == otherProjection.index
          && sameInvocationContinuation(receiverContinuation, otherContinuation) && sameInvocationContinuation(resultRoot, otherRoot)
      _ => false
    }
    ResultsBinding.DescriptorInput {channel, source, producer, receiverPosition, proof, capture, placement,
      requestedRoot, requested, producerRoot, producerState, originalRoot, invocation} => match right.binding {
      ResultsBinding.DescriptorInput {channel: otherChannel, source: otherSource,
        producer: otherProducer, receiverPosition: otherReceiver, proof: otherProof, capture: otherCapture, placement: otherPlacement,
        requestedRoot: otherRequestedRoot, requested: otherRequested, producerRoot: otherProducerRoot, producerState: otherProducerState,
        originalRoot: otherOriginalRoot, invocation: otherInvocation} => channel == otherChannel && Results.sameDescriptorSource(source, otherSource) && producer.index == otherProducer.index && receiverPosition == otherReceiver
          && proof == otherProof && capture == otherCapture && placement == otherPlacement
          && sameOptionalResidual(&requestedRoot, &otherRequestedRoot) && sameOptionalResidual(&requested, &otherRequested)
          && sameOptionalResidual(&producerRoot, &otherProducerRoot) && sameOptionalResidual(&producerState, &otherProducerState)
          && sameInvocationContinuation(originalRoot, otherOriginalRoot) && Results.sameDescriptorInvocation(invocation, otherInvocation)
      _ => false
    }
  }
}

fn validateInvocationDeclarations<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  domain: &Domain, closure: &InvocationClosure) -> () {
  let declarations = List<InvocationDeclaration>.asSlice(&closure.declarations)
  let outputs = List<InvocationDeclaredOutput>.asSlice(&closure.declaredOutputs)
  let nodes = List<InvocationNode>.asSlice(&closure.nodes)
  let demands = List<InvocationDemand>.asSlice(&closure.demands)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let values = List<Value>.asSlice(&skeleton.values)
  let seeds = List<Seed>.asSlice(&skeleton.seeds)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let mut at = usize.ZERO
  while at < declarations.length {
    let row = declarations[at]
    let node = nodes[row.node]
    let key = keys[node.cell]
    let actual = &cases[row.case]
    let local = match &List<Leaf>.asSlice(&skeleton.leaves)[key.leaf.index].kind {
      SourceLeaf.Entry {local: declaredLocal} => declaredLocal _ => { return CompilerBug.panic(b"declared invocation replaced its Entry source") } }
    if actual.target != node.cell || key.category != SourceRole.Physical
      || !invocationPhysical(values[key.value.index]) || !invocationDeclaredChannel(prepared, values[key.value.index], node.state) {
      CompilerBug.panic(b"declared invocation changed its exact channel Case")
    }
    match row.authority {
      InvocationDeclarationAuthority.Entry {seed} => {
        if let Option<usize>.Some {..} = actual.source { CompilerBug.panic(b"declared Entry is not an original seed Case") }
        let entry = match Skeleton.evaluation(skeleton, values[key.value.index].evaluation).site {
          EvaluationSite.Entry {local: original} => original.index == local.index _ => false }
        if !entry || seeds[seed].value.index != key.value.index || seeds[seed].leaf.index != key.leaf.index
          || seeds[seed].direct != key.direct || List<usize>.asSlice(&domain.seedWitnesses)[seed] != key.witness {
          CompilerBug.panic(b"declared invocation lost its original Entry witness")
        }
      }
      InvocationDeclarationAuthority.Result {output} => {
        let previous = outputs[output]
        let from = match actual.source { Option<usize>.Some {value} => value _ => usize.MAX }
        let exact = match actual.authority { TransferAuthority.DeclaredResult {output: original, sourceCell} =>
          original == output && sourceCell == from _ => false }
        if !exact || previous.sourceCell != from || previous.target.index != key.value.index {
          CompilerBug.panic(b"declared invocation replaced its executed output Case")
        }
      }
      InvocationDeclarationAuthority.Step {step} => {
        let edge = List<InvocationStep>.asSlice(&closure.steps)[step]
        if edge.later != row.node || edge.case != row.case || nodes[edge.earlier].demand != node.demand {
          CompilerBug.panic(b"declared invocation changed its actual carrier step")
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < outputs.length {
    let row = outputs[at]
    let demand = demands[row.demand]
    let node = nodes[demand.node]
    let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
    let result = match &operation.plan { ResultsPlan.ExecuteEffect {result: resultMap, ..} => resultMap
      _ => { return CompilerBug.panic(b"declared result lost its actual Run") } }
    if node.demand != row.demand || node.cell != row.sourceCell || keys[node.cell].value.index != row.source.index
      || !Results.inFamily(maps, result, row.output) || maps[row.output.index].kind != MapKind.Contract
      || values[row.target.index].evaluation.index != operation.evaluation.index
      || values[row.target.index].endpoint.index != maps[row.output.index].target.index {
      CompilerBug.panic(b"declared result changed its exact receiver proof or result family")
    }
    let publications = List<InvocationDeclaredPublication>.asSlice(&closure.declaredPublications)
    let mut linked = false
    let mut publication = usize.ZERO
    while publication < publications.length {
      if publications[publication].output == at {
        if declarations[publications[publication].declaration].node != demand.node {
          CompilerBug.panic(b"declared result imported another receiver's completion")
        }
        linked = true
      }
      publication = publication + usize.ONE
    }
    if !linked { CompilerBug.panic(b"declared result has no actual Case completion") }
    let transfers = List<Transfer>.asSlice(&skeleton.transfers)
    let mut found = usize.ZERO
    let mut each = usize.ZERO
    while each < transfers.length {
      if let TransferAuthority.DeclaredResult {output, sourceCell} = transfers[each].authority {
        if output == at {
          if sourceCell != row.sourceCell || transfers[each].source.index != row.source.index
            || transfers[each].target.index != row.target.index || !Atom.same(transfers[each].active, row.active) {
            CompilerBug.panic(b"declared result transfer changed its retained output proof")
          }
          found = found + usize.ONE
        }
      }
      each = each + usize.ONE
    }
    if found != usize.ONE { CompilerBug.panic(b"declared result omitted or duplicated its publication") }
    at = at + usize.ONE
  }
  return ()
}

fn validateInvocations<'body>(prepared: &SourcePreparation<'body>, skeleton: &Skeleton,
  domain: &Domain, closure: &InvocationClosure, descriptors: &DescriptorClosure) -> () {
  validateInvocationCalls(prepared, skeleton, closure)
  validateInvocationDeclarations(prepared, skeleton, domain, closure)
  let nodes = List<InvocationNode>.asSlice(&closure.nodes)
  let demands = List<InvocationDemand>.asSlice(&closure.demands)
  let origins = List<InvocationOrigin>.asSlice(&closure.origins)
  let captures = List<InvocationCapture>.asSlice(&closure.captures)
  let placements = List<InvocationPlacement>.asSlice(&closure.placements)
  let suffixes = List<InvocationSuffix>.asSlice(&closure.suffixes)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let seeds = List<Seed>.asSlice(&skeleton.seeds)
  let values = List<Value>.asSlice(&skeleton.values)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let lifts = List<Prepared.ChannelLift>.asSlice(&prepared.channelLifts)
  let steps = List<InvocationStep>.asSlice(&closure.steps)
  let mut at = usize.ZERO
  while at < steps.length {
    let step = steps[at]
    let later = nodes[step.later]
    let earlier = nodes[step.earlier]
    let actual = &cases[step.case]
    let source = match actual.source { Option<usize>.Some {value} => value _ => usize.MAX }
    if source != earlier.cell || actual.target != later.cell || later.demand != earlier.demand
      || keys[earlier.cell].leaf.index != keys[later.cell].leaf.index
      || !invocationPhysical(values[keys[earlier.cell].value.index]) || !invocationPhysical(values[keys[later.cell].value.index]) {
      CompilerBug.panic(b"invocation carrier changed its actual descriptor Case")
    }
    match step.authority {
      InvocationStepAuthority.Contents {proof} => {
        let row = List<ContentsChannelProof>.asSlice(&descriptors.contentsChannels)[proof]
        let exact = match actual.authority { TransferAuthority.Address {edge, ..} => edge == row.edge _ => false }
        if !exact || row.case != step.case || row.source.index != earlier.state.index || row.target.index != later.state.index {
          CompilerBug.panic(b"invocation contents channel changed its actual Address proof")
        }
      }
      InvocationStepAuthority.AliasIdentity {map, edge} => {
        let selected = match actual.authority { TransferAuthority.Physical {map: selected, ..} => selected.index == map.index _ => false }
        let exact = match invocationAliasIdentity(prepared, skeleton, keys, actual, later.state) {
          Option<usize>.Some {value} => value == edge _ => false }
        if !selected || !exact || later.state.index != earlier.state.index {
          CompilerBug.panic(b"invocation alias changed its actual identity edge or channel cursor")
        }
      }
      InvocationStepAuthority.SameComponent => {
        let exact = match actual.authority { TransferAuthority.SameComponent => true _ => false }
        if !exact || later.state.index != earlier.state.index { CompilerBug.panic(b"invocation publication changed its channel") }
        carrierPublication(values[keys[earlier.cell].value.index], values[keys[later.cell].value.index])
      }
      InvocationStepAuthority.Channel {map, stop} => {
        let exact = match actual.authority { TransferAuthority.Physical {map: selected, direction: matchedOrientation, ..} if matchedOrientation == MapDirection.Forward => selected.index == map.index _ => false }
        let pair = &List<Prepared.BoundaryStop>.asSlice(&maps[map.index].channelStops)[stop]
        if !exact || pair.sourceState.index != earlier.state.index || pair.targetState.index != later.state.index {
          CompilerBug.panic(b"invocation channel cursor lost its actual copy and paired stop")
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < origins.length {
    let origin = origins[at]
    let node = nodes[origin.node]
    let key = keys[node.cell]
    let seed = seeds[origin.seed]
    let actual = &cases[origin.seedCase]
    let fresh = match actual.source { Option<usize>.None => true _ => false }
    if !fresh || actual.target != node.cell || seed.value.index != key.value.index || seed.leaf.index != key.leaf.index
      || seed.direct != key.direct || List<usize>.asSlice(&domain.seedWitnesses)[origin.seed] != key.witness
      || values[key.value.index].evaluation.index != origin.producer.index {
      CompilerBug.panic(b"invocation producer substituted a historical value for its genuine seed Case")
    }
    at = at + usize.ONE
  }
  let captureSteps = List<InvocationCaptureStep>.asSlice(&closure.captureSteps)
  at = usize.ZERO
  while at < captureSteps.length {
    let step = captureSteps[at]
    let source = captures[step.source]
    let target = captures[step.target]
    let carrier = steps[step.carrier]
    if source.node != carrier.earlier || target.node != carrier.later || source.origin != target.origin
      || !Results.sameDescriptorSource(source.source, target.source) {
      CompilerBug.panic(b"current capture changed its actual descriptor history or original input")
    }
    match carrier.authority {
      InvocationStepAuthority.Contents {..} => {
        let component = match step.authority { InvocationCaptureAuthority.Address {componentCase, ..} => componentCase
          _ => { return CompilerBug.panic(b"contents capture omitted its actual component Address Case") } }
        let authentic = invocationAddressCapture(prepared, skeleton, domain, descriptors, carrier, source.endpoint, component)
        let exact = match authentic { Option<InvocationCaptureAuthority>.Some {value} => sameInvocationCaptureAuthority(step.authority, value)
          _ => false }
        if !exact || values[keys[cases[component].target].value.index].endpoint.index != target.endpoint.index {
          CompilerBug.panic(b"contents capture changed its paired original address member geometry")
        }
      }
      InvocationStepAuthority.AliasIdentity {..} => {
        let component = match step.authority { InvocationCaptureAuthority.Alias {componentCase, ..} => componentCase
          _ => { return CompilerBug.panic(b"alias capture omitted its actual member Case") } }
        let authentic = invocationAliasCapture(prepared, skeleton, domain, carrier, source.endpoint, component)
        let exact = match authentic { Option<InvocationCaptureAuthority>.Some {value} => sameInvocationCaptureAuthority(step.authority, value)
          _ => false }
        if !exact || values[keys[cases[component].target].value.index].endpoint.index != target.endpoint.index {
          CompilerBug.panic(b"alias capture changed its actual member edge or canonical suffix")
        }
      }
      InvocationStepAuthority.SameComponent => {
        if source.endpoint.index != target.endpoint.index { CompilerBug.panic(b"capture publication changed its actual component") }
        if !sameInvocationCaptureAuthority(step.authority, InvocationCaptureAuthority.SameComponent) {
          CompilerBug.panic(b"capture publication invented component transport authority")
        }
      }
      InvocationStepAuthority.Channel {map, ..} => {
        let member = match step.authority { InvocationCaptureAuthority.Physical {map: matchedCopiedMap} => matchedCopiedMap
          _ => { return CompilerBug.panic(b"current capture lost its exact copy-family member") } }
        if !Results.inFamily(maps, map, member) || maps[member.index].source.index != source.endpoint.index
          || maps[member.index].target.index != target.endpoint.index {
          CompilerBug.panic(b"current capture changed its exact physical family endpoints")
        }
      }
    }
    at = at + usize.ONE
  }
  let captureSources = List<InvocationCaptureSource>.asSlice(&closure.captureSources)
  at = usize.ZERO
  while at < captureSources.length {
    let acquired = captureSources[at]
    if acquired.capture >= captures.length || acquired.proof >= origins.length || acquired.case >= cases.length {
      CompilerBug.panic(b"capture acquisition lost its original component or Case")
    }
    let capture = captures[acquired.capture]
    let origin = origins[acquired.proof]
    let actual = &cases[acquired.case]
    let target = values[keys[actual.target].value.index]
    if capture.origin != acquired.proof || capture.node != origin.node
      || !Results.sameDescriptorSource(capture.source, acquired.binding)
      || acquired.producer.index != origin.producer.index || target.evaluation.index != origin.producer.index
      || target.endpoint.index != capture.endpoint.index || target.phase != ValuePhase.Output || !invocationPhysical(target) {
      CompilerBug.panic(b"capture acquisition changed its genuine producer component")
    }
    match acquired.acquisition {
      InvocationCaptureAcquisition.Copy {source} => {
        validateInvocationCaptureCell(domain, source)
        let from = values[source.value.index]
        let map = Results.descriptorMap(acquired.binding)
        let exact = match actual.authority {
          TransferAuthority.Physical {map: original, direction: matchedOrientation, ..} if matchedOrientation == MapDirection.Forward => original.index == map.index
          _ => false
        }
        let prior = match actual.source { Option<usize>.Some {value} => value _ => usize.MAX }
        if !exact || prior != source.cell || from.evaluation.index != acquired.evaluation.index
          || from.endpoint.index != maps[map.index].source.index || target.endpoint.index != maps[map.index].target.index
          || !invocationPhysical(from) {
          CompilerBug.panic(b"capture copy changed its actual source history or original map")
        }
      }
      InvocationCaptureAcquisition.CaptureReborrow {origin: reborrow, source} => {
        validateInvocationCaptureCell(domain, source)
        let recorded = List<CaptureReborrowOrigin>.asSlice(&skeleton.captureReborrowData.origins)[reborrow]
        let original = &List<Prepared.CaptureReborrow>.asSlice(&prepared.captureReborrows)[recorded.prepared]
        let exact = match actual.authority { TransferAuthority.CaptureReborrow {origin: matched, placement} =>
          matched == reborrow && placement.index == original.placement.index _ => false }
        let prior = match actual.source { Option<usize>.Some {value} => value _ => usize.MAX }
        if !exact || prior != source.cell || source.category != SourceRole.Ownership
          || source.value.index != recorded.descriptor.index || source.leaf.index != recorded.leaf.index
          || keys[actual.target].category != SourceRole.Ownership || keys[actual.target].value.index != recorded.target.index
          || recorded.acquisition.index != acquired.evaluation.index
          || original.placement.index != Results.descriptorMap(acquired.binding).index {
          CompilerBug.panic(b"capture reborrow substituted a physical reference origin")
        }
      }
      InvocationCaptureAcquisition.Reference {reference} => {
        let references = List<ReferenceOrigin>.asSlice(&skeleton.references)
        if reference >= references.length { CompilerBug.panic(b"capture acquisition lost its original reference") }
        let recorded = references[reference]
        let published = match actual.source {
          Option<usize>.Some {value: prior} => keys[prior].value.index == recorded.descriptor.index
            && keys[prior].category == SourceRole.Physical
            && match actual.authority { TransferAuthority.SameComponent => true _ => false }
          _ => keys[actual.target].value.index == recorded.descriptor.index
        }
        if !published || keys[actual.target].category != SourceRole.Physical
          || recorded.leaf.index != keys[actual.target].leaf.index || recorded.source.index != acquired.evaluation.index
          || recorded.map.index != Results.descriptorMap(acquired.binding).index
          || values[recorded.descriptor.index].endpoint.index != target.endpoint.index {
          CompilerBug.panic(b"capture reference substituted an inherited holding for its fresh descriptor")
        }
      }
      InvocationCaptureAcquisition.Holding {candidate, case, inputCase, source, output} => {
        validateInvocationCaptureCell(domain, source)
        validateInvocationCaptureCell(domain, output)
        if !invocationHoldingCapture(skeleton, domain, acquired.binding, acquired.case, case, candidate)
          || inputCase >= cases.length {
          CompilerBug.panic(b"capture holding lost its genuine filtered output or acquisition Case")
        }
        let prior = match cases[case].source { Option<usize>.Some {value} => value _ => usize.MAX }
        if prior != source.cell || cases[inputCase].target != source.cell || cases[case].target != output.cell
          || values[source.value.index].evaluation.index != acquired.evaluation.index {
          CompilerBug.panic(b"capture holding changed its original input role/history or output Case")
        }
      }
    }
    at = at + usize.ONE
  }
  let captureValues = List<InvocationCaptureValue>.asSlice(&closure.captureValues)
  at = usize.ZERO
  while at < captureValues.length {
    let current = captureValues[at]
    validateInvocationCaptureCell(domain, current.current)
    if current.capture >= captures.length || current.source >= List<InvocationCaptureSource>.length(&closure.captureSources) {
      CompilerBug.panic(b"capture value lost its original occurrence or current component")
    }
    let acquired = List<InvocationCaptureSource>.asSlice(&closure.captureSources)[current.source]
    if captures[current.capture].origin != acquired.proof
      || !Results.sameDescriptorSource(captures[current.capture].source, acquired.binding)
      || values[current.current.value.index].endpoint.index != captures[current.capture].endpoint.index {
      CompilerBug.panic(b"capture value changed its original input or current physical endpoint")
    }
    at = at + usize.ONE
  }
  let captureEdges = List<InvocationCaptureEdge>.asSlice(&closure.captureEdges)
  at = usize.ZERO
  while at < captureEdges.length {
    let edge = captureEdges[at]
    if edge.source >= captureValues.length || edge.target >= captureValues.length
      || edge.captureStep >= captureSteps.length || edge.componentCase >= cases.length {
      CompilerBug.panic(b"capture propagation lost its actual source/target Case")
    }
    let before = captureValues[edge.source]
    let after = captureValues[edge.target]
    let step = captureSteps[edge.captureStep]
    let carrier = steps[step.carrier]
    let component = &cases[edge.componentCase]
    let source = match component.source { Option<usize>.Some {value} => value _ => usize.MAX }
    let receiver = values[keys[nodes[carrier.later].cell].value.index]
    if before.source != after.source || before.capture != step.source || after.capture != step.target
      || source != before.current.cell || component.target != after.current.cell || edge.descriptorCase != carrier.case
      || !invocationCaptureCase(step.authority, component, edge.componentCase)
      || values[after.current.value.index].evaluation.index != receiver.evaluation.index {
      CompilerBug.panic(b"capture propagation detached its exact current cell or descriptor/member Cases")
    }
    at = at + usize.ONE
  }
  let suffixSteps = List<InvocationSuffixStep>.asSlice(&closure.suffixSteps)
  at = usize.ZERO
  while at < suffixSteps.length {
    let step = suffixSteps[at]
    let later = suffixes[step.later]
    let earlier = suffixes[step.earlier]
    let carrier = steps[step.carrier]
    if later.node != carrier.later || earlier.node != carrier.earlier || later.requestedRoot.index != earlier.requestedRoot.index
      || later.requested.index != earlier.requested.index || !Results.sameRequestedPrefix(later.prefix, earlier.prefix) {
      CompilerBug.panic(b"invocation output lift changed its demanded root/current or actual descriptor Case")
    }
    match carrier.authority {
      InvocationStepAuthority.Contents {proof} => {
        let output = match step.authority { InvocationSuffixAuthority.Contents {output} => output
          _ => { return CompilerBug.panic(b"contents suffix omitted its retained semantic output witness") } }
        let row = List<ContentsChannelOutput>.asSlice(&descriptors.contentsChannelOutputs)[output]
        if row.proof != proof || row.requestedRoot.index != later.root.index || row.requested.index != later.current.index
          || row.root.index != earlier.root.index || row.current.index != earlier.current.index
          || !sameInvocationContentsPrefix(row.requestedPrefix, later.prefix)
          || !sameInvocationContentsPrefix(row.prefix, earlier.prefix) {
          CompilerBug.panic(b"contents suffix changed its exact requested and producer cursor pair")
        }
      }
      InvocationStepAuthority.AliasIdentity {..} => {
        if later.root.index != earlier.root.index || later.current.index != earlier.current.index
          || !Results.sameDescriptorPrefix(later.prefix, earlier.prefix)
          || !sameInvocationSuffixAuthority(step.authority, InvocationSuffixAuthority.AliasIdentity) {
          CompilerBug.panic(b"invocation alias changed its unchanged output segments")
        }
      }
      InvocationStepAuthority.SameComponent => {
        if later.root.index != earlier.root.index || later.current.index != earlier.current.index
          || !Results.sameDescriptorPrefix(later.prefix, earlier.prefix) {
          CompilerBug.panic(b"invocation output publication changed its suffix")
        }
        if !sameInvocationSuffixAuthority(step.authority, InvocationSuffixAuthority.SameComponent) {
          CompilerBug.panic(b"invocation publication invented a paired suffix authority")
        }
      }
      InvocationStepAuthority.Channel {map, stop} => {
        if let InvocationSuffixAuthority.Projection {root, current} = step.authority {
          let laterPrefix = match later.prefix { Option<Results.DescriptorPrefix>.Some {value} => value
            _ => { return CompilerBug.panic(b"projection copy omitted its later prefix segment") } }
          let earlierPrefix = match earlier.prefix { Option<Results.DescriptorPrefix>.Some {value} => value
            _ => { return CompilerBug.panic(b"projection copy omitted its earlier prefix segment") } }
          if !invocationProjectionLift(prepared, carrier, laterPrefix, root, current, later.root, later.current)
            || lifts[root.index].sourceState.index != earlier.root.index || lifts[current.index].sourceState.index != earlier.current.index {
            CompilerBug.panic(b"projection copy changed its exact prefix-relative paired lift")
          }
          if let PreparedChannelLiftOrigin.Projection {prefixRoot, prefixCurrent, ..} = lifts[root.index].origin {
            if lifts[prefixRoot.index].sourceState.index != earlierPrefix.root.index
              || lifts[prefixCurrent.index].sourceState.index != earlierPrefix.current.index {
              CompilerBug.panic(b"projection copy changed its contextual prefix cursor")
            }
          }
          at = at + usize.ONE
          continue
        }
        if let Option<Results.DescriptorPrefix>.Some {..} = later.prefix { CompilerBug.panic(b"root output lift replaced a segmented projection witness") }
        let root = match step.authority { InvocationSuffixAuthority.Channel {root, ..} => root
          _ => { return CompilerBug.panic(b"invocation copy omitted its exact channel output root") } }
        let current = match step.authority { InvocationSuffixAuthority.Channel {current, ..} => current
          _ => { return CompilerBug.panic(b"invocation copy omitted its exact channel output cursor") } }
        let pair = &List<Prepared.BoundaryStop>.asSlice(&maps[map.index].channelStops)[stop]
        let rootAuthority = match lifts[root.index].origin { PreparedChannelLiftOrigin.Root => true _ => false }
        let currentAuthority = match lifts[current.index].origin { PreparedChannelLiftOrigin.Root => true _ => false }
        if !rootAuthority || !currentAuthority || !lifts[root.index].entry || lifts[root.index].map.index != map.index
          || lifts[root.index].channel.sourceState.index != pair.sourceState.index || lifts[root.index].channel.targetState.index != pair.targetState.index
          || lifts[root.index].sourceState.index != earlier.root.index || lifts[root.index].targetState.index != later.root.index
          || lifts[current.index].sourceState.index != earlier.current.index || lifts[current.index].targetState.index != later.current.index
          || !invocationLiftDescends(lifts, root, current, lifts.length) {
          CompilerBug.panic(b"invocation output lift changed its exact root/current paired cursor")
        }
      }
    }
    at = at + usize.ONE
  }
  let emissions = List<InvocationEmission>.asSlice(&closure.emissions)
  at = usize.ZERO
  while at < emissions.length {
    let emitted = emissions[at]
    let candidate = emitted.candidate
    Results.validateCandidate(prepared, candidate)
    match candidate.binding {
      ResultsBinding.DescriptorInput {channel, source, producer, receiverPosition, proof,
        capture, placement, requestedRoot, requested, producerRoot, producerState, originalRoot, invocation} => {
        if capture != emitted.capture || placement != emitted.placement { CompilerBug.panic(b"descriptor result changed its retained proof IDs") }
        let actual = captures[capture]
        let selected = placements[placement]
        let origin = origins[proof]
        let demand = demands[nodes[origin.node].demand]
        let operation = &List<Results.Operation>.asSlice(&skeleton.operationResults.operations)[demand.operation]
        let receiver = match operation.receiver { Option<Results.Receiver>.Some {value} => value
          _ => { return CompilerBug.panic(b"descriptor result lost its actual invocation receiver") } }
        if actual.origin != proof || selected.origin != proof || actual.node != demand.node
          || channel != origin.channel || !Results.sameDescriptorSource(source, actual.source)
          || producer.index != origin.producer.index || receiverPosition != receiver.position || candidate.source.index != actual.endpoint.index
          || candidate.operation != operation.prepared || candidate.operand.index != receiver.actual.evaluation.index
          || candidate.usePoint.index != receiver.actual.usePoint.index || candidate.result.index != operation.evaluation.index
          || candidate.projection.index != selected.projection.index || candidate.selection.index != selected.selection.index
          || !sameInvocationContinuation(candidate.continuation, selected.continuation) || !sameInvocationContinuation(originalRoot, selected.originalRoot) {
          CompilerBug.panic(b"descriptor result changed its original input, actual receiver or placement proof")
        }
        match invocation {
          Option<Results.DescriptorInvocation>.Some {value} => {
            let pair = List<InvocationCallPair>.asSlice(&closure.callPairs)[value.pair]
            let prefix = match selected.suffix { Option<usize>.Some {value: matchedSuffixIndex} => suffixes[matchedSuffixIndex].prefix _ => Option<Results.DescriptorPrefix>.none() }
            if !Results.sameDescriptorPrefix(value.prefix, prefix) || pair.origin != proof || pair.channel != value.channel
              || pair.resultProjection.index != value.resultProjection.index
              || !sameInvocationContinuation(pair.resultRoot, value.resultRoot)
              || !sameInvocationContinuation(pair.result, value.resultContinuation) {
              CompilerBug.panic(b"captured callable result changed its actual A/B projection pairing")
            }
            let requests = List<InvocationCallOutput>.asSlice(&closure.callOutputs)
            let mut found = false
            let mut each = usize.ZERO
            while each < requests.length {
              if requests[each].pair == value.pair {
                let same = match requests[each].suffix {
                  Option<usize>.Some {value: matchedSuffixIndex} => sameOptionalResidual(&requestedRoot, &Option<Prepared.ResidualStateId>.some(suffixes[matchedSuffixIndex].root))
                    && sameOptionalResidual(&requested, &Option<Prepared.ResidualStateId>.some(suffixes[matchedSuffixIndex].current))
                    && Results.sameRequestedPrefix(prefix, suffixes[matchedSuffixIndex].prefix)
                  _ => match requestedRoot { Option<Prepared.ResidualStateId>.None => true _ => false }
                }
                if same { found = true }
              }
              each = each + usize.ONE
            }
            if !found { CompilerBug.panic(b"captured callable emission bypassed its exact receiver output request") }
          }
          _ => { if let ResultsPlan.CallableInvoke {..} = &operation.plan { CompilerBug.panic(b"captured callable result omitted its invocation placement authority") } }
        }
        match selected.suffix {
          Option<usize>.Some {value} => {
            let suffix = suffixes[value]
            if !sameOptionalResidual(&requestedRoot, &Option<Prepared.ResidualStateId>.some(suffix.requestedRoot))
              || !sameOptionalResidual(&requested, &Option<Prepared.ResidualStateId>.some(suffix.requested))
              || !sameOptionalResidual(&producerRoot, &Option<Prepared.ResidualStateId>.some(suffix.root))
              || !sameOptionalResidual(&producerState, &Option<Prepared.ResidualStateId>.some(suffix.current)) {
              CompilerBug.panic(b"descriptor result discarded its distinct requested and producer suffixes")
            }
          }
          _ => {
            if let Option<Prepared.ResidualStateId>.Some {..} = requestedRoot { CompilerBug.panic(b"whole descriptor output invented a suffix") }
            if let Option<Prepared.ResidualStateId>.Some {..} = requested { CompilerBug.panic(b"whole descriptor output invented a selected component") }
            if let Option<Prepared.ResidualStateId>.Some {..} = producerRoot { CompilerBug.panic(b"whole descriptor output invented a producer suffix") }
            if let Option<Prepared.ResidualStateId>.Some {..} = producerState { CompilerBug.panic(b"whole descriptor output invented a producer component") }
          }
        }
      }
      _ => CompilerBug.panic(b"descriptor emission repurposed invocation argument coordinates")
    }
    at = at + usize.ONE
  }
  let transfers = List<Transfer>.asSlice(&skeleton.transfers)
  at = usize.ZERO
  while at < transfers.length {
    if let TransferAuthority.OperationResult {candidate, ..} = transfers[at].authority {
      if let ResultsBinding.DescriptorInput {..} = candidate.binding {
        let mut found = false
        let mut emission = usize.ZERO
        while emission < emissions.length {
          if sameInvocationCandidate(candidate, emissions[emission].candidate) { found = true }
          emission = emission + usize.ONE
        }
        if !found { CompilerBug.panic(b"descriptor result has no actual retained cursor/capture emission") }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

/// Raw descriptor presence and semantic holding applicability are separate observations of
/// the SAME actual Case. Masking never removes a physical descriptor or changes its witness.
pub struct ObservationCase {
  pub case: usize
  pub raw: Cell
  pub semantic: Cell
  pub masked: Atom
}
impl Copy for ObservationCase {}
pub union ObservationNormalization {
  Through { pub request: usize, pub case: usize, pub active: Atom },
  Move { pub request: usize, pub observation: usize, pub case: usize, pub active: Atom },
  Mirror { pub mirror: usize, pub case: usize, pub mirrorCase: usize, pub storageCase: usize, pub summaryCase: usize,
    pub summaryRead: usize, pub active: Atom },
}
impl Copy for ObservationNormalization {}
struct ObservationProjection {
  cells: List<Cell>
  masked: List<Atom>
  cases: List<ObservationCase>
  boundaries: List<Atom>
  evidence: List<ObservationNormalization>
  fieldReholds: FieldReholdNormalizations
}

fn freshObservation(rules: &mut Program) -> Cell {
  return Cell {present: Program.atom(&mut rules.*), stored: Program.atom(&mut rules.*), alternatives: Program.atom(&mut rules.*)}
}

effect fn mergeObservation(rules: &mut Program, target: Cell, source: Cell) -> ()
! OutOfMemoryError ? &mut Allocator {
  let present: [Atom; 1] = [source.present]
  let stored: [Atom; 1] = [source.stored]
  let alternatives: [Atom; 1] = [source.alternatives]
  run Program.rule(&mut rules.*, target.present, &present, &[])
  run Program.rule(&mut rules.*, target.stored, &stored, &[])
  run Program.rule(&mut rules.*, target.alternatives, &alternatives, &[])
  return ()
}

// Root-only summary reads and sibling physical reads belong together only through an
// immutable observation inventory. Equal evaluation/point/root is not a join authority.
effect fn observationReadPair(skeleton: &mut Skeleton, physical: ReadId, summary: ReadId) -> Atom
! OutOfMemoryError ? &mut Allocator {
  let paired = Program.atom(&mut skeleton.rules)
  if physical.index == summary.index { run Program.fact(&mut skeleton.rules, paired) return paired }
  let references = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let moves = List<MoveRead>.asSlice(&skeleton.selectedMoves.reads)
  let flights = List<ReadFlightRead>.asSlice(&skeleton.readFlightReads)
  let through = List<ThroughFlightRead>.asSlice(&skeleton.throughFlightReads)
  let fields = List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)
  let mut at = usize.ZERO
  while at < references.length {
    if references[at].read.index == physical.index {
      let mut other = usize.ZERO
      while other < references.length {
        if references[other].read.index == summary.index && references[other].observation == references[at].observation {
          let gates: [Atom; 2] = [references[at].active, references[other].active]
          run Program.rule(&mut skeleton.rules, paired, &gates, &[])
        }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < moves.length {
    if moves[at].read.index == physical.index {
      let mut other = usize.ZERO
      while other < moves.length {
        if moves[other].read.index == summary.index && moves[other].observation == moves[at].observation {
          let gates: [Atom; 2] = [moves[at].active, moves[other].active]
          run Program.rule(&mut skeleton.rules, paired, &gates, &[])
        }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let drops = List<DropRead>.asSlice(&skeleton.drops.reads)
  at = usize.ZERO
  while at < drops.length {
    if drops[at].read.index == physical.index {
      let mut other = usize.ZERO
      while other < drops.length {
        if drops[other].read.index == summary.index && drops[other].observation == drops[at].observation {
          let gates: [Atom; 2] = [drops[at].active, drops[other].active]
          run Program.rule(&mut skeleton.rules, paired, &gates, &[])
        }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < flights.length {
    if flights[at].read.index == physical.index {
      let mut other = usize.ZERO
      while other < flights.length {
        if flights[other].read.index == summary.index && flights[other].observation == flights[at].observation {
          let gates: [Atom; 2] = [flights[at].active, flights[other].active]
          run Program.rule(&mut skeleton.rules, paired, &gates, &[])
        }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < through.length {
    if through[at].read.index == physical.index {
      let mut other = usize.ZERO
      while other < through.length {
        if through[other].read.index == summary.index && through[other].observation == through[at].observation {
          let gates: [Atom; 2] = [through[at].active, through[other].active]
          run Program.rule(&mut skeleton.rules, paired, &gates, &[])
        }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < fields.length {
    if fields[at].read.index == physical.index {
      let mut other = usize.ZERO
      while other < fields.length {
        if fields[other].read.index == summary.index && fields[other].observation == fields[at].observation {
          let gates: [Atom; 2] = [fields[at].active, fields[other].active]
          run Program.rule(&mut skeleton.rules, paired, &gates, &[])
        }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  let holders = List<WriteHolder>.asSlice(&skeleton.writeHolders)
  at = usize.ZERO
  while at < holders.length {
    let members = List<WriteComponent>.asSlice(&holders[at].components)
    let mut found = false
    let mut root = false
    let mut member = usize.ZERO
    while member < members.length {
      if members[member].read.index == physical.index { found = true }
      if members[member].read.index == summary.index { root = true }
      member = member + usize.ONE
    }
    if found && root {
      let gate: [Atom; 1] = [holders[at].active]
      run Program.rule(&mut skeleton.rules, paired, &gate, &[])
    }
    at = at + usize.ONE
  }
  return paired
}

/// Exact semantic replacement of one surviving physical read history. The physical Case
/// remains available to address/data consumers. storageCase is the real Flow pair;
/// summaryCase is its distinct publication into the current observation.
pub struct FieldReholdNormalization {
  pub candidate: usize
  pub case: usize
  pub writer: usize
  pub publicationCase: usize
  pub storageCase: usize
  pub summaryCase: usize
  pub summaryRead: usize
  pub active: Atom
}
impl Copy for FieldReholdNormalization {}
pub struct FieldReholdWriter {
  pub candidate: usize
  pub definition: DefinitionId
  pub cell: usize
  pub active: Atom
}
impl Copy for FieldReholdWriter {}
pub union FieldReholdWriterEvidence {
  Physical { pub acquisitionCase: usize },
  Mirror { pub mirror: usize, pub publicationCase: usize, pub storageCase: usize, pub summaryCase: usize, pub summaryRead: usize },
  Previous { pub writer: usize, pub publicationCase: usize, pub storageCase: usize, pub summaryCase: usize, pub summaryRead: usize },
  Rhs { pub placementCase: usize, pub entryCase: usize, pub transport: usize, pub writerCase: usize, pub cursor: usize },
}
impl Copy for FieldReholdWriterEvidence {}
/// Exact new filtered definition paired with one original writer. This is construction
/// correspondence only; later read normalization additionally requires its current Flow pair.
pub struct FieldReholdWriterPublication {
  pub writer: usize
  pub publicationCase: usize
  pub active: Atom
}
impl Copy for FieldReholdWriterPublication {}
pub struct FieldReholdWriterLink {
  pub writer: usize
  pub evidence: FieldReholdWriterEvidence
  pub active: Atom
}
impl Copy for FieldReholdWriterLink {}
pub struct FieldReholdWriteCursor {
  pub entryCase: usize
  pub transport: usize
  pub cell: usize
  pub active: Atom
}
impl Copy for FieldReholdWriteCursor {}
pub struct FieldReholdWriteStep {
  pub source: usize
  pub target: usize
  pub case: usize
}
impl Copy for FieldReholdWriteStep {}
pub struct FieldReholdNormalizations {
  pub rows: List<FieldReholdNormalization>
  pub writers: List<FieldReholdWriter>
  pub links: List<FieldReholdWriterLink>
  pub publications: List<FieldReholdWriterPublication>
  pub cursors: List<FieldReholdWriteCursor>
  pub steps: List<FieldReholdWriteStep>
}
impl FieldReholdNormalizations {
  fn make() -> Self {
    return Self {rows: List<FieldReholdNormalization>.make(), writers: List<FieldReholdWriter>.make(),
      links: List<FieldReholdWriterLink>.make(), publications: List<FieldReholdWriterPublication>.make(),
      cursors: List<FieldReholdWriteCursor>.make(), steps: List<FieldReholdWriteStep>.make()}
  }
}

fn fieldCaseSource(actual: &Case, cell: usize) -> bool {
  return match actual.source { Option<usize>.Some {value} => value == cell _ => false }
}
fn fieldCasePair(actual: &Case, definition: DefinitionId, read: ReadId) -> bool {
  return match actual.definition { Option<DefinitionId>.Some {value} => value.index == definition.index _ => false }
    && match actual.read { Option<ReadId>.Some {value} => value.index == read.index _ => false }
}

effect fn fieldWriter(result: &mut FieldReholdNormalizations, rules: &mut Program,
  candidate: usize, definition: DefinitionId, cell: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let writers = List<FieldReholdWriter>.asSlice(&result.writers)
  let mut at = usize.ZERO
  while at < writers.length {
    if writers[at].candidate == candidate && writers[at].definition.index == definition.index && writers[at].cell == cell { return at }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut rules.*)
  run List<FieldReholdWriter>.append(&mut result.writers, FieldReholdWriter {candidate: candidate, definition: definition, cell: cell, active: active})
  return at
}
effect fn fieldWriterLink(result: &mut FieldReholdNormalizations, rules: &mut Program,
  writer: usize, evidence: FieldReholdWriterEvidence, gates: &[Atom]) -> () ! OutOfMemoryError ? &mut Allocator {
  let active = Program.atom(&mut rules.*)
  run Program.rule(&mut rules.*, active, gates, &[])
  let gate: [Atom; 1] = [active]
  run Program.rule(&mut rules.*, List<FieldReholdWriter>.asSlice(&result.writers)[writer].active, &gate, &[])
  run List<FieldReholdWriterLink>.append(&mut result.links, FieldReholdWriterLink {writer: writer, evidence: evidence, active: active})
  return ()
}

// Nodes are keyed only by one actual emitted private transport, its entry Case and a
// primitive cell. All arcs are original Cases; no selector path/history is a node key.
effect fn fieldWriteCursor(result: &mut FieldReholdNormalizations, rules: &mut Program,
  entry: usize, transport: usize, cell: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let cursors = List<FieldReholdWriteCursor>.asSlice(&result.cursors)
  let mut at = usize.ZERO
  while at < cursors.length {
    if cursors[at].entryCase == entry && cursors[at].transport == transport && cursors[at].cell == cell { return at }
    at = at + usize.ONE
  }
  let active = Program.atom(&mut rules.*)
  run List<FieldReholdWriteCursor>.append(&mut result.cursors, FieldReholdWriteCursor {entryCase: entry, transport: transport, cell: cell, active: active})
  return at
}

// Validate the SAME emitted inverse alias edge; a matching map or raw leaf is not an arc.
fn fieldWriteArc(skeleton: &Skeleton, domain: &Domain, transport: usize, case: usize) -> bool {
  let actual = &List<Case>.asSlice(&domain.cases)[case]
  if let Option<DefinitionId>.Some {..} = actual.definition { return false }
  if let Option<ReadId>.Some {..} = actual.read { return false }
  let source = match actual.source { Option<usize>.Some {value} => value _ => { return false } }
  let keys = List<CellKey>.asSlice(&domain.keys)
  if keys[source].category != SourceRole.Physical || keys[actual.target].category != SourceRole.Physical { return false }
  let values = List<Value>.asSlice(&skeleton.values)
  let before = values[keys[source].value.index]
  let after = values[keys[actual.target].value.index]
  let left = match before.transport { Option<AliasPort>.Some {value} => value _ => { return false } }
  if left.request != transport { return false }
  let use = List<AliasTransport>.asSlice(&skeleton.aliasTransports)[transport]
  if use.direction != MapDirection.StorageInverse || before.evaluation.index != use.evaluation.index || after.evaluation.index != use.evaluation.index { return false }
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let edges = List<AliasEdge>.asSlice(&skeleton.aliasEdges)
  let mut at = usize.ZERO
  while at < edges.length {
    let edge = edges[at]
    if edge.target == left.alias && sameStorage(aliases[edge.target].storage, aliases[use.alias].storage) {
      let previous = match edge.source {
        Option<usize>.Some {value} => match after.transport { Option<AliasPort>.Some {value: port} => port.request == transport && port.alias == value _ => false }
        _ => match after.transport { Option<AliasPort>.None => after.endpoint.index == aliases[use.alias].storage.endpoint.index && after.phase == ValuePhase.Output _ => false }
      }
      if previous {
        let exact = match edge.authority {
          AliasAuthority.Canonical => match actual.authority { TransferAuthority.SameComponent => true _ => false }
          AliasAuthority.Project {map} => match actual.authority {
            TransferAuthority.Physical {map: member, direction: matchedOrientation, address: Option<EvalId>.Some {value}} if matchedOrientation == MapDirection.StorageInverse =>
              member.index == map.index && value.index == aliases[edge.target].evaluation.index
            _ => false }
          _ => match actual.authority { TransferAuthority.Address {edge: original, direction: matchedOrientation} if matchedOrientation == MapDirection.StorageInverse => original == at _ => false }
        }
        if exact { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

// Frozen equality indexes for semantic observation normalization joins. Original Case ordinals
// stay ascending; all physical/summary authority and gate checks remain at each join.
struct ObservationCaseIndex {
  sources: List<List<usize>>
  targets: List<List<usize>>
}
effect fn observationCaseIndex(domain: &Domain) -> ObservationCaseIndex ! OutOfMemoryError ? &mut Allocator {
  let count = List<CellKey>.length(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let mut sources = List<List<usize>>.make()
  let mut targets = List<List<usize>>.make()
  let mut at = usize.ZERO
  while at < count {
    run List<List<usize>>.append(&mut sources, List<usize>.make())
    run List<List<usize>>.append(&mut targets, List<usize>.make())
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < cases.length {
    if let Option<usize>.Some {value} = cases[at].source {
      let sourceRows = List<List<usize>>.asMutSlice(&mut sources)
      run List<usize>.append(&mut sourceRows[value], at)
    }
    let targetRows = List<List<usize>>.asMutSlice(&mut targets)
    run List<usize>.append(&mut targetRows[cases[at].target], at)
    at = at + usize.ONE
  }
  return ObservationCaseIndex {sources: move sources, targets: move targets}
}

effect fn fieldRhsWriters<'body>(result: &mut FieldReholdNormalizations, prepared: &SourcePreparation<'body>,
  skeleton: &mut Skeleton, domain: &Domain, index: &ObservationCaseIndex, candidate: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let selected = List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates)[candidate]
  let observation = List<FieldReholdObservation>.asSlice(&skeleton.fieldReholds.observations)[selected.observation]
  let request = List<FieldReholdRequest>.asSlice(&skeleton.fieldReholds.requests)[observation.request]
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  if keys[selected.sourceCell].category != SourceRole.Physical { return () }
  let values = List<Value>.asSlice(&skeleton.values)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let aliases = List<StorageAlias>.asSlice(&skeleton.aliases)
  let transports = List<AliasTransport>.asSlice(&skeleton.aliasTransports)
  let definitions = List<AliasDefinition>.asSlice(&skeleton.aliasDefinitions)
  let defined = List<DefinedValue>.asSlice(&skeleton.definitions)
  let placementCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[selected.sourceCell])
  let mut placementAt = usize.ZERO
  while placementAt < placementCases.length {
    let placement = placementCases[placementAt]
    if fieldCaseSource(&cases[placement], selected.sourceCell) {
      if let TransferAuthority.Physical {map, direction: matchedOrientation, address: Option<EvalId>.None} = cases[placement].authority {
        if matchedOrientation == MapDirection.Forward {
          let placed = values[keys[cases[placement].target].value.index]
          if Results.inFamily(maps, request.map, map) && maps[map.index].kind == MapKind.Place
            && placed.evaluation.index == request.result.index && placed.endpoint.index == maps[map.index].target.index
            && values[selected.source.index].evaluation.index == request.source.index && values[selected.source.index].endpoint.index == maps[map.index].source.index {
            let entryCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[cases[placement].target])
            let mut entryAt = usize.ZERO
            while entryAt < entryCases.length {
              let entry = entryCases[entryAt]
              if fieldCaseSource(&cases[entry], cases[placement].target) {
                if let TransferAuthority.SameComponent = cases[entry].authority {
                  if let Option<AliasPort>.Some {value: port} = values[keys[cases[entry].target].value.index].transport {
                    let transport = transports[port.request]
                    let member = &aliases[port.alias]
                    let root = &aliases[observation.alias]
                    let original = match transport.authority { AliasConsumer.Projection {map: originalMap} => originalMap.index == map.index _ => false }
                    if original && transport.alias == port.alias && transport.direction == MapDirection.StorageInverse
                      && transport.evaluation.index == request.result.index && member.evaluation.index == request.address.index
                      && member.endpoint.index == maps[map.index].target.index
                      && sameTemporary(member.storage.temporary, root.storage.temporary)
                      && sameComponentSuffix(endpoints, member.storage.endpoint, root.storage.endpoint, maps[map.index].target, maps[request.map.index].target) {
                      let start = run fieldWriteCursor(&mut result.*, &mut skeleton.rules, entry, port.request, cases[entry].target)
                      let seed: [Atom; 4] = [cases[placement].active, cases[entry].active, observation.active, transport.active]
                      run Program.rule(&mut skeleton.rules, List<FieldReholdWriteCursor>.asSlice(&result.cursors)[start].active, &seed, &[])
                      let mut cursor = start
                      while cursor < List<FieldReholdWriteCursor>.length(&result.cursors) {
                        let current = List<FieldReholdWriteCursor>.asSlice(&result.cursors)[cursor]
                        if current.entryCase == entry && current.transport == port.request {
                          let arcCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[current.cell])
                          let mut arcAt = usize.ZERO
                          while arcAt < arcCases.length {
                            let arc = arcCases[arcAt]
                            if fieldCaseSource(&cases[arc], current.cell) && fieldWriteArc(&skeleton.*, domain, port.request, arc) {
                              let target = run fieldWriteCursor(&mut result.*, &mut skeleton.rules, entry, port.request, cases[arc].target)
                              let old = List<FieldReholdWriteStep>.asSlice(&result.steps)
                              let mut found = false
                              let mut step = usize.ZERO
                              while step < old.length {
                                if old[step].source == cursor && old[step].target == target && old[step].case == arc { found = true }
                                step = step + usize.ONE
                              }
                              if !found {
                                let gates: [Atom; 2] = [current.active, cases[arc].active]
                                run Program.rule(&mut skeleton.rules, List<FieldReholdWriteCursor>.asSlice(&result.cursors)[target].active, &gates, &[])
                                run List<FieldReholdWriteStep>.append(&mut result.steps, FieldReholdWriteStep {source: cursor, target: target, case: arc})
                              }
                              let cell = keys[cases[arc].target]
                              let mut definition = usize.ZERO
                              while definition < definitions.length {
                                let installed = &definitions[definition]
                                if defined[installed.definition.index].value.index == cell.value.index
                                  && sameStorage(installed.storage, member.storage) && fieldReholdOriginal(&skeleton.*, observation, installed.definition) {
                                  let writer = run fieldWriter(&mut result.*, &mut skeleton.rules, candidate, installed.definition, cases[arc].target)
                                  let gates: [Atom; 4] = [current.active, cases[arc].active, cases[placement].active, cases[selected.case].active]
                                  run fieldWriterLink(&mut result.*, &mut skeleton.rules, writer,
                                    FieldReholdWriterEvidence.Rhs {placementCase: placement, entryCase: entry, transport: port.request, writerCase: arc, cursor: target}, &gates)
                                }
                                definition = definition + usize.ONE
                              }
                            }
                            arcAt = arcAt + usize.ONE
                          }
                        }
                        cursor = cursor + usize.ONE
                      }
                    }
                  }
                }
              }
              entryAt = entryAt + usize.ONE
            }
          }
        }
      }
    }
    placementAt = placementAt + usize.ONE
  }
  return ()
}

struct FieldReholdPredecessor {
  candidate: usize
  previous: usize
  publicationCase: usize
  storageCase: usize
  summaryCase: usize
  summaryRead: usize
  active: Atom
}
impl Copy for FieldReholdPredecessor {}

// Construction ancestry follows only authenticated original summary publications. Reusing
// a raw def/read tuple is insufficient: both storage and SummaryRead Cases are retained.
effect fn fieldOldWriters(result: &mut FieldReholdNormalizations, skeleton: &mut Skeleton, domain: &Domain, index: &ObservationCaseIndex)
  -> List<FieldReholdPredecessor> ! OutOfMemoryError ? &mut Allocator {
  let candidates = List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let mirrors = List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates)
  let summaries = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let mut predecessors = List<FieldReholdPredecessor>.make()
  let mut candidate = usize.ZERO
  while candidate < candidates.length {
    let selected = candidates[candidate]
    if let FieldReholdOrigin.Old {fieldRead, definition, read, ..} = selected.origin {
      let incoming = &cases[selected.case]
      if incoming.target != selected.sourceCell { return CompilerBug.panic(b"field normalization lost its original incoming Case") }
      if let Option<usize>.Some {value: source} = incoming.source {
        if keys[selected.sourceCell].category == SourceRole.Physical && fieldCasePair(incoming, definition, read) {
          let writer = run fieldWriter(&mut result.*, &mut skeleton.rules, candidate, definition, source)
          let gates: [Atom; 2] = [incoming.active, selected.active]
          run fieldWriterLink(&mut result.*, &mut skeleton.rules, writer, FieldReholdWriterEvidence.Physical {acquisitionCase: selected.case}, &gates)
        }
        if let TransferAuthority.SummaryRead {reading} = incoming.authority {
          let summary = summaries[reading]
          let observed = List<FieldReholdRead>.asSlice(&skeleton.fieldReholds.reads)[fieldRead]
          if summary.read.index == read.index && referenceReadHistory(observed.read, Option<ReadId>.some(read), summaries) {
            let storageCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.targets)[source])
            let mut storageAt = usize.ZERO
            while storageAt < storageCases.length {
              let storage = storageCases[storageAt]
              if cases[storage].target == source && fieldCasePair(&cases[storage], definition, summary.read) {
                if let Option<usize>.Some {value: held} = cases[storage].source {
                  let publishedCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.targets)[held])
                  let mut publishedAt = usize.ZERO
                  while publishedAt < publishedCases.length {
                    let published = publishedCases[publishedAt]
                    if cases[published].target == held {
                      if let TransferAuthority.OwnershipMirror {candidate: mirror, ..} = cases[published].authority {
                        let original = mirrors[mirror]
                        if original.definition.index == definition.index && original.summary == summary.summary {
                          if let Option<usize>.Some {value: writerCell} = cases[published].source {
                            let writer = run fieldWriter(&mut result.*, &mut skeleton.rules, candidate, original.original, writerCell)
                            let gates: [Atom; 4] = [cases[published].active, cases[storage].active, incoming.active, selected.active]
                            run fieldWriterLink(&mut result.*, &mut skeleton.rules, writer, FieldReholdWriterEvidence.Mirror {
                              mirror: mirror, publicationCase: published, storageCase: storage, summaryCase: selected.case, summaryRead: reading}, &gates)
                          }
                        }
                      }
                      if let TransferAuthority.FieldRehold {candidate: previous} = cases[published].authority {
                        let original = candidates[previous]
                        if original.definition.index == definition.index && original.summary == summary.summary
                          && fieldCaseSource(&cases[published], original.sourceCell) {
                          let active = Program.atom(&mut skeleton.rules)
                          let gates: [Atom; 4] = [cases[published].active, cases[storage].active, incoming.active, selected.active]
                          run Program.rule(&mut skeleton.rules, active, &gates, &[])
                          run List<FieldReholdPredecessor>.append(&mut predecessors, FieldReholdPredecessor {
                            candidate: candidate, previous: previous, publicationCase: published, storageCase: storage,
                            summaryCase: selected.case, summaryRead: reading, active: active})
                        }
                      }
                    }
                    publishedAt = publishedAt + usize.ONE
                  }
                }
              }
              storageAt = storageAt + usize.ONE
            }
          }
        }
      }
    }
    candidate = candidate + usize.ONE
  }
  return move predecessors
}

/// Standalone evidence reservation for the generic semantic projection. It creates no
/// source/loan/Eval/read/pair and runs no solve. The caller attaches row.active to the
/// boundary for row.case and retains this complete finite proof inventory for inspection.
effect fn reserveFieldReholdNormalizations<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  domain: &Domain, index: &ObservationCaseIndex) -> FieldReholdNormalizations ! OutOfMemoryError ? &mut Allocator {
  let mut result = FieldReholdNormalizations.make()
  let predecessors = run fieldOldWriters(&mut result, &mut skeleton.*, domain, index)
  let candidatesCount = List<FieldReholdCandidate>.length(&skeleton.fieldReholds.candidates)
  let mut candidate = usize.ZERO
  while candidate < candidatesCount {
    if let FieldReholdOrigin.Rhs {..} = List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates)[candidate].origin {
      run fieldRhsWriters(&mut result, prepared, &mut skeleton.*, domain, index, candidate)
    }
    candidate = candidate + usize.ONE
  }
  // One bounded primitive relation: candidate + original physical definition/cell.
  // A previous rehold can contribute another edge to an existing node, never another
  // recursively keyed history. The common construction admission has already required
  // every previous definition to precede this FieldRehold's actual writer occurrence.
  let predecessorsSelected = List<FieldReholdPredecessor>.asSlice(&predecessors)
  let mut writer = usize.ZERO
  while writer < List<FieldReholdWriter>.length(&result.writers) {
    let current = List<FieldReholdWriter>.asSlice(&result.writers)[writer]
    let mut at = usize.ZERO
    while at < predecessorsSelected.length {
      let edge = predecessorsSelected[at]
      if edge.previous == current.candidate {
        let target = run fieldWriter(&mut result, &mut skeleton.rules, edge.candidate, current.definition, current.cell)
        let gates: [Atom; 2] = [current.active, edge.active]
        run fieldWriterLink(&mut result, &mut skeleton.rules, target, FieldReholdWriterEvidence.Previous {writer: writer,
          publicationCase: edge.publicationCase, storageCase: edge.storageCase, summaryCase: edge.summaryCase, summaryRead: edge.summaryRead}, &gates)
      }
      at = at + usize.ONE
    }
    writer = writer + usize.ONE
  }
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let summariesCount = List<SummaryRead>.length(&skeleton.summaryReads)
  writer = usize.ZERO
  while writer < List<FieldReholdWriter>.length(&result.writers) {
    let original = List<FieldReholdWriter>.asSlice(&result.writers)[writer]
    let selected = List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates)[original.candidate]
    let publicationCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[selected.sourceCell])
    let mut publicationAt = usize.ZERO
    while publicationAt < publicationCases.length {
      let publication = publicationCases[publicationAt]
      let own = match cases[publication].authority { TransferAuthority.FieldRehold {candidate: matchedFieldCandidate} => matchedFieldCandidate == original.candidate _ => false }
      if own && fieldCaseSource(&cases[publication], selected.sourceCell) {
        let active = Program.atom(&mut skeleton.rules)
        let gates: [Atom; 2] = [original.active, cases[publication].active]
        run Program.rule(&mut skeleton.rules, active, &gates, &[])
        run List<FieldReholdWriterPublication>.append(&mut result.publications,
          FieldReholdWriterPublication {writer: writer, publicationCase: publication, active: active})
      }
      publicationAt = publicationAt + usize.ONE
    }
    let physicalCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[original.cell])
    let mut physicalAt = usize.ZERO
    while physicalAt < physicalCases.length {
      let physical = physicalCases[physicalAt]
      let actual = &cases[physical]
      if keys[actual.target].category == SourceRole.Physical && fieldCaseSource(actual, original.cell) {
        if let Option<ReadId>.Some {value: read} = actual.read {
          if fieldCasePair(actual, original.definition, read) {
            let publishedCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[selected.sourceCell])
            let mut publishedAt = usize.ZERO
            while publishedAt < publishedCases.length {
              let published = publishedCases[publishedAt]
              let own = match cases[published].authority { TransferAuthority.FieldRehold {candidate: matchedFieldCandidate} => matchedFieldCandidate == original.candidate _ => false }
              if own && fieldCaseSource(&cases[published], selected.sourceCell) {
                let storageCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[cases[published].target])
                let mut storageAt = usize.ZERO
                while storageAt < storageCases.length {
                  let storage = storageCases[storageAt]
                  if fieldCaseSource(&cases[storage], cases[published].target) {
                    if let Option<ReadId>.Some {value: readSummary} = cases[storage].read {
                      if fieldCasePair(&cases[storage], selected.definition, readSummary) {
                        let summaryCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[cases[storage].target])
                        let mut summaryAt = usize.ZERO
                        while summaryAt < summaryCases.length {
                          let summary = summaryCases[summaryAt]
                          if fieldCaseSource(&cases[summary], cases[storage].target) {
                            if let TransferAuthority.SummaryRead {reading} = cases[summary].authority {
                              let row = List<SummaryRead>.asSlice(&skeleton.summaryReads)[reading]
                              if row.summary == selected.summary && row.read.index == readSummary.index {
                                let paired = run observationReadPair(&mut skeleton.*, read, row.original)
                                let active = Program.atom(&mut skeleton.rules)
                                let gates: [Atom; 6] = [original.active, actual.active, cases[published].active,
                                  cases[storage].active, cases[summary].active, paired]
                                run Program.rule(&mut skeleton.rules, active, &gates, &[])
                                run List<FieldReholdNormalization>.append(&mut result.rows, FieldReholdNormalization {
                                  candidate: original.candidate, case: physical, writer: writer, publicationCase: published,
                                  storageCase: storage, summaryCase: summary, summaryRead: reading, active: active})
                              }
                            }
                          }
                          summaryAt = summaryAt + usize.ONE
                        }
                      }
                    }
                  }
                  storageAt = storageAt + usize.ONE
                }
              }
              publishedAt = publishedAt + usize.ONE
            }
          }
        }
      }
      physicalAt = physicalAt + usize.ONE
    }
    writer = writer + usize.ONE
  }
  return move result
}

effect fn reserveObservationBoundaries<'body>(result: &mut ObservationProjection,
  prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton, domain: &Domain, index: &ObservationCaseIndex) -> ()
! OutOfMemoryError ? &mut Allocator {
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let mirrorsCount = List<OwnershipMirror>.length(&skeleton.ownershipMirrors.candidates)
  let observationsCount = List<MoveObservation>.length(&skeleton.selectedMoves.observations)
  let mut at = usize.ZERO
  while at < cases.length {
    let actual = &cases[at]
    let target = keys[actual.target]
    if target.category == SourceRole.Physical {
      if let Option<usize>.Some {value: source} = actual.source {
        // A displaced through-reference result resets the original holder flight.
        // Its old selected physical snapshot remains descriptor evidence, not a second
        // semantic result. The exact Read directive and request bind both occurrences.
        if let TransferAuthority.SameComponent = actual.authority {
          let before = List<Value>.asSlice(&skeleton.values)[keys[source].value.index]
          let after = List<Value>.asSlice(&skeleton.values)[target.value.index]
          if before.phase == ValuePhase.Input && after.phase == ValuePhase.Output
            && before.endpoint.index == after.endpoint.index && sameSubject(before.subject, after.subject) {
            let flights = List<ThroughFlightRequest>.asSlice(&skeleton.throughFlightRequests)
            let mut flight = usize.ZERO
            while flight < flights.length {
              let request = flights[flight]
              if request.kind == ThroughFlightKind.Read && before.evaluation.index == request.evaluation.index
                && after.evaluation.index == request.operation.index {
                if let Option<Atom>.Some {value: use} = throughResultUse(&skeleton.*, request) {
                  let node = match Skeleton.evaluation(&skeleton.*, request.operation).site {
                    EvaluationSite.Node {node} => node _ => { return CompilerBug.panic(b"through result lost its operation") } }
                  let root = match &endpoints[after.endpoint.index].root {
                    Root.Node {node: owner, category: endpointCategory} if endpointCategory == EndpointRole.Value => owner.index == node.index _ => false }
                  if root {
                    let active = run addressApplies(&mut skeleton.rules, request.active, use)
                    let gate: [Atom; 1] = [active]
                    run Program.rule(&mut skeleton.rules, List<Atom>.asSlice(&result.boundaries)[at], &gate, &[])
                    run List<ObservationNormalization>.append(&mut result.evidence,
                      ObservationNormalization.Through {request: flight, case: at, active: active})
                  }
                }
              }
              flight = flight + usize.ONE
            }
          }
        }
        // This exact emitted private alias lane authenticates the consumed Copy. It is
        // not enough that a later Copy shares the same endpoint, leaf or typed node.
        if let TransferAuthority.Physical {map, direction: matchedOrientation, address: Option<EvalId>.None} = actual.authority {
          if matchedOrientation == MapDirection.Forward {
            if let Option<AliasPort>.Some {value: port} = List<Value>.asSlice(&skeleton.values)[keys[source].value.index].transport {
              let transport = List<AliasTransport>.asSlice(&skeleton.aliasTransports)[port.request]
              let member = List<StorageAlias>.asSlice(&skeleton.aliases)[port.alias]
              if let AliasConsumer.Projection {map: original} = transport.authority {
                if original.index == map.index && transport.alias == port.alias {
                  let mut observation = usize.ZERO
                  while observation < observationsCount {
                    let observed = List<MoveObservation>.asSlice(&skeleton.selectedMoves.observations)[observation]
                    let request = List<SelectedMove>.asSlice(&skeleton.selectedMoves.requests)[observed.request]
                    let root = List<StorageAlias>.asSlice(&skeleton.aliases)[observed.alias]
                    if List<Value>.asSlice(&skeleton.values)[target.value.index].evaluation.index == request.result.index
                      && transport.evaluation.index == request.result.index
                      && member.evaluation.index == request.source.index
                      && Results.inFamily(maps, request.map, map)
                      && sameTemporary(member.storage.temporary, root.storage.temporary)
                      && sameComponentSuffix(endpoints, member.storage.endpoint, root.storage.endpoint,
                        maps[map.index].source, maps[request.map.index].source) {
                      let active = run addressApplies(&mut skeleton.rules, observed.active, transport.active)
                      let gate: [Atom; 1] = [active]
                      run Program.rule(&mut skeleton.rules, List<Atom>.asSlice(&result.boundaries)[at], &gate, &[])
                      run List<ObservationNormalization>.append(&mut result.evidence,
                        ObservationNormalization.Move {request: observed.request, observation: observation, case: at, active: active})
                    }
                    observation = observation + usize.ONE
                  }
                }
              }
            }
          }
        }
        if let Option<DefinitionId>.Some {value: definition} = actual.definition {
          if let Option<ReadId>.Some {value: read} = actual.read {
            let mut mirror = usize.ZERO
            while mirror < mirrorsCount {
              let selected = List<OwnershipMirror>.asSlice(&skeleton.ownershipMirrors.candidates)[mirror]
              if selected.original.index == definition.index && selected.source.index == keys[source].value.index {
                let writtenCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[source])
                let mut writtenAt = usize.ZERO
                while writtenAt < writtenCases.length {
                  let written = writtenCases[writtenAt]
                  let same = match cases[written].authority {
                    TransferAuthority.OwnershipMirror {candidate, ..} => candidate == mirror _ => false }
                  if same && match cases[written].source { Option<usize>.Some {value} => value == source _ => false } {
                    let currentCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[cases[written].target])
                    let mut currentAt = usize.ZERO
                    while currentAt < currentCases.length {
                      let current = currentCases[currentAt]
                      let paired = match cases[current].definition { Option<DefinitionId>.Some {value} => value.index == selected.definition.index _ => false }
                        && match cases[current].source { Option<usize>.Some {value} => value == cases[written].target _ => false }
                      if paired {
                        let publicationCases = List<usize>.asSlice(&List<List<usize>>.asSlice(&index.sources)[cases[current].target])
                        let mut publicationAt = usize.ZERO
                        while publicationAt < publicationCases.length {
                          let publication = publicationCases[publicationAt]
                          if match cases[publication].source { Option<usize>.Some {value} => value == cases[current].target _ => false } {
                            if let TransferAuthority.SummaryRead {reading} = cases[publication].authority {
                              let summary = List<SummaryRead>.asSlice(&skeleton.summaryReads)[reading]
                              let exact = match cases[current].read { Option<ReadId>.Some {value} => value.index == summary.read.index _ => false }
                              if exact && summary.summary == selected.summary {
                                let observed = run observationReadPair(&mut skeleton.*, read, summary.original)
                                let gates: [Atom; 4] = [cases[written].active, cases[current].active, cases[publication].active, observed]
                                let active = Program.atom(&mut skeleton.rules)
                                run Program.rule(&mut skeleton.rules, active, &gates, &[])
                                let gate: [Atom; 1] = [active]
                                run Program.rule(&mut skeleton.rules, List<Atom>.asSlice(&result.boundaries)[at], &gate, &[])
                                run List<ObservationNormalization>.append(&mut result.evidence,
                                  ObservationNormalization.Mirror {mirror: mirror, case: at, mirrorCase: written,
                                    storageCase: current, summaryCase: publication, summaryRead: reading, active: active})
                              }
                            }
                          }
                          publicationAt = publicationAt + usize.ONE
                        }
                      }
                      currentAt = currentAt + usize.ONE
                    }
                  }
                  writtenAt = writtenAt + usize.ONE
                }
              }
              mirror = mirror + usize.ONE
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

// One finite policy projection on the already closed source graph. There is no second
// reaching relation: each rule names one existing Case and its existing predecessor cell.
// Positive propagation retains unmasked alternatives even when the same raw cell also has
// a masked arrival. Only exact publication boundaries introduce negative applicability.
effect fn makeObservationProjection(rules: &mut Program, domain: &Domain) -> ObservationProjection
! OutOfMemoryError ? &mut Allocator {
  let mut result = ObservationProjection {cells: List<Cell>.make(), masked: List<Atom>.make(),
    cases: List<ObservationCase>.make(), boundaries: List<Atom>.make(), evidence: List<ObservationNormalization>.make(),
    fieldReholds: FieldReholdNormalizations.make()}
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let mut at = usize.ZERO
  while at < keys.length {
    run List<Cell>.append(&mut result.cells, freshObservation(&mut rules.*))
    run List<Atom>.append(&mut result.masked, Program.atom(&mut rules.*))
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < cases.length {
    run List<Atom>.append(&mut result.boundaries, Program.atom(&mut rules.*))
    at = at + usize.ONE
  }
  return move result
}

effect fn emitObservationProjection(result: &mut ObservationProjection, rules: &mut Program, domain: &Domain) -> ()
! OutOfMemoryError ? &mut Allocator {
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cases = List<Case>.asSlice(&domain.cases)
  let mut at = usize.ZERO
  while at < cases.length {
    let actual = &cases[at]
    let semantic = freshObservation(&mut rules.*)
    let masked = Program.atom(&mut rules.*)
    let boundary = List<Atom>.asSlice(&result.boundaries)[at]
    match actual.source {
      Option<usize>.None => {
        let gate: [Atom; 1] = [actual.active]
        run Program.rule(&mut rules.*, semantic.present, &gate, &[])
      }
      Option<usize>.Some {value: source} => {
        let previous = List<Cell>.asSlice(&result.cells)[source]
        let gate: [Atom; 2] = [actual.active, previous.present]
        let excluded: [Atom; 1] = [boundary]
        run Program.rule(&mut rules.*, semantic.present, &gate, &excluded)
        if keys[actual.target].category == SourceRole.Physical {
          let inherited: [Atom; 2] = [actual.active, List<Atom>.asSlice(&result.masked)[source]]
          run Program.rule(&mut rules.*, masked, &inherited, &[])
          let replaced: [Atom; 2] = [actual.active, boundary]
          run Program.rule(&mut rules.*, masked, &replaced, &[])
        }
        let stored: [Atom; 2] = [semantic.present, previous.stored]
        let alternatives: [Atom; 2] = [semantic.present, previous.alternatives]
        run Program.rule(&mut rules.*, semantic.stored, &stored, &[])
        run Program.rule(&mut rules.*, semantic.alternatives, &alternatives, &[])
      }
    }
    let stored: [Atom; 2] = [semantic.present, actual.addedStored]
    let alternatives: [Atom; 2] = [semantic.present, actual.addedAlternatives]
    run Program.rule(&mut rules.*, semantic.stored, &stored, &[])
    run Program.rule(&mut rules.*, semantic.alternatives, &alternatives, &[])
    let target = List<Cell>.asSlice(&result.cells)[actual.target]
    let present: [Atom; 1] = [semantic.present]
    let keptStored: [Atom; 1] = [semantic.stored]
    let keptAlternatives: [Atom; 1] = [semantic.alternatives]
    let hidden: [Atom; 1] = [masked]
    run Program.rule(&mut rules.*, target.present, &present, &[])
    run Program.rule(&mut rules.*, target.stored, &keptStored, &[])
    run Program.rule(&mut rules.*, target.alternatives, &keptAlternatives, &[])
    run Program.rule(&mut rules.*, List<Atom>.asSlice(&result.masked)[actual.target], &hidden, &[])
    run List<ObservationCase>.append(&mut result.cases,
      ObservationCase {case: at, raw: actual.quality, semantic: semantic, masked: masked})
    at = at + usize.ONE
  }
  return ()
}

effect fn reserveObservationProjection<'body>(prepared: &SourcePreparation<'body>, skeleton: &mut Skeleton,
  domain: &Domain) -> ObservationProjection ! OutOfMemoryError ? &mut Allocator {
  let mut result = run makeObservationProjection(&mut skeleton.rules, domain)
  let index = run observationCaseIndex(domain)
  run reserveObservationBoundaries(&mut result, prepared, &mut skeleton.*, domain, &index)
  let fields = run reserveFieldReholdNormalizations(prepared, &mut skeleton.*, domain, &index)
  let rows = List<FieldReholdNormalization>.asSlice(&fields.rows)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let mut at = usize.ZERO
  while at < rows.length {
    let row = rows[at]
    if row.case >= cases.length || keys[cases[row.case].target].category != SourceRole.Physical {
      return CompilerBug.panic(b"field normalization changed its actual physical observation Case")
    }
    let gate: [Atom; 1] = [row.active]
    run Program.rule(&mut skeleton.rules, List<Atom>.asSlice(&result.boundaries)[row.case], &gate, &[])
    at = at + usize.ONE
  }
  result.fieldReholds = move fields
  run emitObservationProjection(&mut result, &mut skeleton.rules, domain)
  return move result
}

struct Domain {
  cells: List<Cell>
  keys: List<CellKey>
  witnesses: List<Witness>
  cases: List<Case>
  policies: List<PendingPolicy>
  cellsByValue: List<List<usize>>
  transfersByValue: List<List<usize>>
  indexedTransfers: usize
  transferPairs: List<Option<usize>>
  seedWitnesses: List<usize>
  pairWitnesses: List<usize>
  scannedTransfers: List<usize>
}

impl Domain {
  fn make() -> Self {
    return Domain {cells: List<Cell>.make(), keys: List<CellKey>.make(), witnesses: List<Witness>.make(),
      cases: List<Case>.make(), policies: List<PendingPolicy>.make(), cellsByValue: List<List<usize>>.make(),
      transfersByValue: List<List<usize>>.make(), indexedTransfers: usize.ZERO,
      transferPairs: List<Option<usize>>.make(), seedWitnesses: List<usize>.make(),
      pairWitnesses: List<usize>.make(), scannedTransfers: List<usize>.make()}
  }
}

// Both holding ports and completion rows use the same original-read identity test.
fn referenceReadHistory(original: ReadId, incoming: Option<ReadId>, summaries: &[SummaryRead]) -> bool {
  let read = match incoming { Option<ReadId>.Some {value} => value _ => { return false } }
  if read.index == original.index { return true }
  let mut at = usize.ZERO
  while at < summaries.length {
    if summaries[at].read.index == read.index && summaries[at].original.index == original.index { return true }
    at = at + usize.ONE
  }
  return false
}

effect fn sealReferenceHoldingCoverage(skeleton: &mut Skeleton, domain: &Domain) -> ()
! OutOfMemoryError ? &mut Allocator {
  if List<ReferenceHoldingCoverage>.length(&skeleton.referenceHoldingCoverage) != usize.ZERO {
    CompilerBug.panic(b"reference holding coverage must be sealed once after candidate closure")
  }
  let reads = List<ReferenceRead>.asSlice(&skeleton.referenceReads)
  let observations = List<ReferenceObservation>.asSlice(&skeleton.referenceObservations)
  let summaries = List<SummaryRead>.asSlice(&skeleton.summaryReads)
  let cases = List<Case>.asSlice(&domain.cases)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let mut reading = usize.ZERO
  while reading < reads.length {
    let selected = reads[reading]
    let mut case = usize.ZERO
    while case < cases.length {
      let key = keys[cases[case].target]
      let witness = &witnesses[key.witness]
      if key.value.index == selected.value.index && referenceReadHistory(selected.read, witness.read, summaries) {
        let active = run addressApplies(&mut skeleton.rules, selected.active, cases[case].active)
        let covered = Program.atom(&mut skeleton.rules)
        let missing = Program.atom(&mut skeleton.rules)
        let applies: [Atom; 1] = [active]
        let incomplete: [Atom; 1] = [covered]
        run Program.rule(&mut skeleton.rules, missing, &applies, &incomplete)
        run List<ReferenceHoldingCoverage>.append(&mut skeleton.referenceHoldingCoverage, ReferenceHoldingCoverage {
          referenceRead: reading, observation: selected.observation, reference: observations[selected.observation].reference,
          case: case, source: key.value, leaf: key.leaf, category: key.category, direct: key.direct,
          definition: witness.definition, read: witness.read, active: active, covered: covered, missing: missing})
      }
      case = case + usize.ONE
    }
    reading = reading + usize.ONE
  }
  return ()
}

// A role is part of the bounded source key, not a predicate ORed over coincident histories.
// Only explicit ownership publication boundaries change it; every real copy preserves it.
fn transferRole(source: SourceRole, target: Value, authority: TransferAuthority) -> SourceRole {
  if let Option<usize>.Some {..} = target.summary { return SourceRole.Ownership }
  return match authority {
    TransferAuthority.CaptureReborrow {..} => SourceRole.Ownership
    TransferAuthority.RvalueDereferenceResult {..} => SourceRole.Ownership
    TransferAuthority.OrdinaryResult {..} => SourceRole.Ownership
    TransferAuthority.FieldResult {..} => SourceRole.Ownership
    TransferAuthority.ThroughResult {..} => SourceRole.Ownership
    TransferAuthority.ReferenceHolding {..} => SourceRole.Ownership
    TransferAuthority.MoveHolding {..} => SourceRole.Ownership
    TransferAuthority.FieldRehold {..} => SourceRole.Ownership
    TransferAuthority.OwnershipMirror {..} => SourceRole.Ownership
    TransferAuthority.SummaryRead {..} => SourceRole.Ownership
    _ => source
  }
}

fn transferHistory(values: &[Value], cell: usize, key: CellKey, witness: &Witness, transfer: &Transfer,
  holdings: &[ReferenceHolding], references: &[ReferenceRead], summaries: &[SummaryRead], moves: &[MoveHolding], fields: &[FieldReholdCandidate]) -> bool {
  if let TransferAuthority.FieldResult {sourceCell, ..} = transfer.authority { return cell == sourceCell }
  if let TransferAuthority.DeclaredResult {sourceCell, ..} = transfer.authority {
    return key.category == SourceRole.Physical && cell == sourceCell
  }
  if let TransferAuthority.ThroughResult {read, ..} = transfer.authority {
    return match witness.read { Option<ReadId>.Some {value} => value.index == read.index _ => false }
  }
  if let TransferAuthority.FieldRehold {candidate} = transfer.authority {
    if candidate >= fields.length { return CompilerBug.panic(b"field rehold lost its exact incoming Case recipe") }
    return fields[candidate].sourceCell == cell
  }
  if let TransferAuthority.OwnershipMirror {sourceCell, ..} = transfer.authority { return key.category == SourceRole.Physical && cell == sourceCell }
  if let TransferAuthority.MoveHolding {candidate} = transfer.authority {
    if candidate >= moves.length { return CompilerBug.panic(b"Move transfer lost its exact construction candidate") }
    return match witness.definition { Option<DefinitionId>.Some {value} => value.index == moves[candidate].definition.index _ => false }
      && match witness.read { Option<ReadId>.Some {value} => value.index == moves[candidate].read.index _ => false }
  }
  if let TransferAuthority.ReferenceHolding {candidate} = transfer.authority {
    if candidate >= holdings.length || holdings[candidate].referenceRead >= references.length {
      return CompilerBug.panic(b"reference holding transfer lost its original read")
    }
    return referenceReadHistory(references[holdings[candidate].referenceRead].read, witness.read, summaries)
  }
  if let TransferAuthority.OrdinarySummary {..} = transfer.authority { return key.category == SourceRole.Ownership }
  if let Option<DefinitionId>.Some {..} = transfer.definition {
    let source = values[transfer.source.index]
    let physical = match source.summary { Option<usize>.None => true _ => false }
      && match source.writeHolder { Option<usize>.None => true _ => false }
    // Carried fields are installed in their separate canonical summary Flow lane. A
    // coincident physical source still has its own key and follows this exact read pair.
    if physical && key.category == SourceRole.Ownership { return false }
  }
  return true
}

// Extends finite candidate topology and emits rules in the SAME program. This does not solve
// source/policy truth. Late boundary reads may add pairs/seeds/transfers without renumbering
// prior witness, case or policy IDs; no earlier decision or gate is replayed/replaced.
effect fn extendDomain(domain: &mut Domain, rules: &mut Program, points: &[Point], pairs: &[Pair],
  evaluations: &[Evaluation], values: &[Value], seeds: &[Seed], transfers: &[Transfer],
  holdings: &[ReferenceHolding], referenceReads: &[ReferenceRead], summaryReads: &[SummaryRead], moves: &[MoveHolding], fields: &[FieldReholdCandidate]) -> ()
! OutOfMemoryError ? &mut Allocator {
  // These adjacency rows index the existing immutable transfer ordinals. They do not
  // prune candidates or consult gates; ascending insertion preserves Case/port order.
  while List<List<usize>>.length(&domain.cellsByValue) < values.length {
    run List<List<usize>>.append(&mut domain.cellsByValue, List<usize>.make())
  }
  while List<List<usize>>.length(&domain.transfersByValue) < values.length {
    run List<List<usize>>.append(&mut domain.transfersByValue, List<usize>.make())
  }
  while domain.indexedTransfers < transfers.length {
    let ordinal = domain.indexedTransfers
    let rows = List<List<usize>>.asMutSlice(&mut domain.transfersByValue)
    run List<usize>.append(&mut rows[transfers[ordinal].source.index], ordinal)
    // Reserve an empty lookup only. Ineligible transfers must not validate a Flow pair.
    run List<Option<usize>>.append(&mut domain.transferPairs, Option<usize>.none())
    domain.indexedTransfers = ordinal + usize.ONE
  }
  let firstSeed = List<usize>.length(&domain.seedWitnesses)
  if firstSeed > seeds.length || List<usize>.length(&domain.pairWitnesses) > pairs.length {
    CompilerBug.panic(b"source candidate reservation cannot shrink its seed or reaching-pair universe")
  }
  let mut seed = firstSeed
  while seed < seeds.length {
    let witness = List<Witness>.length(&domain.witnesses)
    run List<Witness>.append(&mut domain.witnesses, Witness {definition: Option<DefinitionId>.none(), read: Option<ReadId>.none()})
    run List<usize>.append(&mut domain.seedWitnesses, witness)
    seed = seed + usize.ONE
  }
  let mut pair = List<usize>.length(&domain.pairWitnesses)
  while pair < pairs.length {
    let witness = List<Witness>.length(&domain.witnesses)
    run List<Witness>.append(&mut domain.witnesses, Witness {definition: Option<DefinitionId>.some(pairs[pair].definition),
      read: Option<ReadId>.some(pairs[pair].read)})
    run List<usize>.append(&mut domain.pairWitnesses, witness)
    pair = pair + usize.ONE
  }
  let empty = List<Atom>.make()
  let none = List<Atom>.asSlice(&empty)
  let mut index = firstSeed
  while index < seeds.length {
    let seed = seeds[index]
    let target = run reserveCell(&mut domain.keys, &mut domain.cells, &mut domain.cellsByValue, &mut rules.*,
      CellKey {category: seed.category, value: seed.value, leaf: seed.leaf, witness: List<usize>.asSlice(&domain.seedWitnesses)[index], direct: seed.direct})
    let cell = List<Cell>.asSlice(&domain.cells)[target]
    let active = Program.atom(&mut rules.*)
    let reach = points[evaluations[values[seed.value.index].evaluation.index].point.index].reachable
    let admitted: [Atom; 2] = [seed.active, reach]
    run Program.rule(&mut rules.*, active, &admitted, none)
    let present: [Atom; 1] = [active]
    run Program.rule(&mut rules.*, cell.present, &present, none)
    let stored: [Atom; 2] = [active, seed.stored]
    run Program.rule(&mut rules.*, cell.stored, &stored, none)
    let alternatives: [Atom; 2] = [active, seed.alternatives]
    run Program.rule(&mut rules.*, cell.alternatives, &alternatives, none)
    run List<Case>.append(&mut domain.cases, Case { addedStored: seed.stored, addedAlternatives: seed.alternatives, source: Option<usize>.none(), target: target, active: active, quality: cell,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), authority: TransferAuthority.SameComponent})
    index = index + usize.ONE
  }
  // Candidate closure follows actual transfer topology and exact role/read identities. It reads no Truth and ignores every
  // policy/CFG gate, including late backedges. It reserves cells, not source witnesses.
  // Each key/transfer pair is processed once, including transfers appended after the key.
  index = usize.ZERO
  while index < List<CellKey>.length(&domain.keys) {
    let key = List<CellKey>.asSlice(&domain.keys)[index]
    while List<usize>.length(&domain.scannedTransfers) <= index {
      run List<usize>.append(&mut domain.scannedTransfers, usize.ZERO)
    }
    let scanned = List<usize>.asSlice(&domain.scannedTransfers)[index]
    if scanned > transfers.length { CompilerBug.panic(b"source transfer reservation cannot shrink") }
    let outgoing = List<usize>.asSlice(&List<List<usize>>.asSlice(&domain.transfersByValue)[key.value.index])
    let mut next = usize.ZERO
    while next < outgoing.length && outgoing[next] < scanned { next = next + usize.ONE }
    while next < outgoing.length {
      let transferIndex = outgoing[next]
      let transfer = &transfers[transferIndex]
      let eligible = transferHistory(values, index, key,
        &List<Witness>.asSlice(&domain.witnesses)[key.witness], transfer, holdings, referenceReads, summaryReads, moves, fields)
      if eligible {
        let category = transferRole(key.category, values[transfer.target.index], transfer.authority)
        let direct = match transfer.directness {
          Directness.Preserve => key.direct
          Directness.Direct => true
          Directness.Indirect => false
        }
        let mut targetWitness = key.witness
        let mut paired = Option<Atom>.none()
        if let Option<DefinitionId>.Some {value: definition} = transfer.definition {
          if let Option<ReadId>.Some {value: read} = transfer.read {
            let mut selected = List<Option<usize>>.asSlice(&domain.transferPairs)[transferIndex]
            if let Option<usize>.None = selected {
              let mut pairIndex = usize.ZERO
              while pairIndex < pairs.length {
                if pairs[pairIndex].definition.index == definition.index && pairs[pairIndex].read.index == read.index {
                  selected = Option<usize>.some(pairIndex)
                  break
                }
                pairIndex = pairIndex + usize.ONE
              }
              // The first eligible history retains the same first matching immutable
              // Pair ordinal. Later histories use its original witness and active atom.
              let indexed = List<Option<usize>>.asMutSlice(&mut domain.transferPairs)
              indexed[transferIndex] = selected
            }
            if let Option<usize>.Some {value: pairIndex} = selected {
              targetWitness = List<usize>.asSlice(&domain.pairWitnesses)[pairIndex]
              paired = Option<Atom>.some(pairs[pairIndex].active)
            }
            if let Option<Atom>.None = paired { CompilerBug.panic(b"source transfer has no matching definition/read pair") }
          } else { CompilerBug.panic(b"source transfer omits its paired read") }
        } else {
          if let Option<ReadId>.Some {value: ignored} = transfer.read { CompilerBug.panic(b"source transfer omits its paired definition") }
        }
        let target = run reserveCell(&mut domain.keys, &mut domain.cells, &mut domain.cellsByValue, &mut rules.*,
          CellKey {category: category, value: transfer.target, leaf: key.leaf, witness: targetWitness, direct: direct})
        let input = List<Cell>.asSlice(&domain.cells)[index]
        let output = List<Cell>.asSlice(&domain.cells)[target]
        let applicable = Program.atom(&mut rules.*)
        let reach = points[evaluations[values[transfer.target.index].evaluation.index].point.index].reachable
        if let Option<Atom>.Some {value: pairGate} = paired {
          let admitted: [Atom; 4] = [input.present, transfer.active, reach, pairGate]
          run Program.rule(&mut rules.*, applicable, &admitted, none)
        } else {
          let admitted: [Atom; 3] = [input.present, transfer.active, reach]
          run Program.rule(&mut rules.*, applicable, &admitted, none)
        }
        let mut active = applicable
        let mut addedStored = transfer.stored
        let mut addedAlternatives = transfer.alternatives
        if transfer.policy == TransferPolicy.Filtered {
          let id = PolicyPortId {index: List<PendingPolicy>.length(&domain.policies)}
          let kept = Program.atom(&mut rules.*)
          let stored = Program.atom(&mut rules.*)
          let alternatives = Program.atom(&mut rules.*)
          let transferStored: [Atom; 1] = [transfer.stored]
          let transferAlternatives: [Atom; 1] = [transfer.alternatives]
          run Program.rule(&mut rules.*, stored, &transferStored, none)
          run Program.rule(&mut rules.*, alternatives, &transferAlternatives, none)
          // Reservation never consults this gate. Even when a later policy drops this
          // source, all downstream candidate cells and their own ports already exist.
          let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
          run List<PendingPolicy>.append(&mut domain.policies, PendingPolicy {
            port: PolicyPort {category: key.category, outputRole: category, terminal: transfer.terminal, authority: transfer.authority, active: transfer.active, id: id, transfer: transferIndex, source: transfer.source,
              target: transfer.target, leaf: key.leaf, direct: key.direct, outputDirect: direct,
              map: authorityMap(transfer.authority), contract: authorityContract(transfer.authority), direction: authorityDirection(transfer.authority), address: authorityAddress(transfer.authority),
              definition: witness.definition, read: witness.read,
              quality: Cell {present: applicable, stored: input.stored, alternatives: input.alternatives}},
            outputCase: List<Case>.length(&domain.cases),
            sourceCell: index, kept: kept, stored: stored, alternatives: alternatives, bound: false})
          active = Program.atom(&mut rules.*)
          let selected: [Atom; 2] = [applicable, kept]
          run Program.rule(&mut rules.*, active, &selected, none)
          addedStored = stored
          addedAlternatives = alternatives
        }
        let present: [Atom; 1] = [active]
        run Program.rule(&mut rules.*, output.present, &present, none)
        let caseStored = Program.atom(&mut rules.*)
        let caseAlternatives = Program.atom(&mut rules.*)
        let stored: [Atom; 2] = [active, input.stored]
        run Program.rule(&mut rules.*, caseStored, &stored, none)
        let newStored: [Atom; 2] = [active, addedStored]
        run Program.rule(&mut rules.*, caseStored, &newStored, none)
        let alternatives: [Atom; 2] = [active, input.alternatives]
        run Program.rule(&mut rules.*, caseAlternatives, &alternatives, none)
        let newAlternatives: [Atom; 2] = [active, addedAlternatives]
        run Program.rule(&mut rules.*, caseAlternatives, &newAlternatives, none)
        let storedOutput: [Atom; 1] = [caseStored]
        let alternativesOutput: [Atom; 1] = [caseAlternatives]
        run Program.rule(&mut rules.*, output.stored, &storedOutput, none)
        run Program.rule(&mut rules.*, output.alternatives, &alternativesOutput, none)
        run List<Case>.append(&mut domain.cases, Case { addedStored: addedStored, addedAlternatives: addedAlternatives, source: Option<usize>.some(index), target: target, active: active,
          quality: Cell {present: active, stored: caseStored, alternatives: caseAlternatives},
          definition: transfer.definition, read: transfer.read, authority: transfer.authority})
      }
      next = next + usize.ONE
    }
    let mutableRows10 = List<usize>.asMutSlice(&mut domain.scannedTransfers)
    mutableRows10[index] = transfers.length
    index = index + usize.ONE
  }
  return ()
}

impl<'body> Builder<'body> {
  pub fn captureReborrows(self: &Self) -> &[CaptureReborrowOrigin] { return List<CaptureReborrowOrigin>.asSlice(&self.captureReborrowData.origins) }
  pub fn captureReborrowDescriptors(self: &Self) -> &[CaptureReborrowDescriptor] { return List<CaptureReborrowDescriptor>.asSlice(&self.captureReborrowData.descriptors) }
  pub fn captureReborrowDescriptorsAt(self: &Self, value: ValueId) -> &[usize] {
    let rows = List<List<usize>>.asSlice(&self.captureReborrowData.byValue)
    if value.index >= rows.length { return CompilerBug.panic(b"capture descriptor lookup has no actual value") }
    return List<usize>.asSlice(&rows[value.index])
  }
  pub fn ownershipOrigins(self: &Self) -> &[OwnershipOrigin] { return List<OwnershipOrigin>.asSlice(&self.ownershipPublicationsData.origins) }
  pub fn fieldReads(self: &Self) -> &[FieldRead] { return List<FieldRead>.asSlice(&self.ownershipPublicationsData.fieldReads) }
  pub fn ownershipPublications(self: &Self) -> &[OwnershipPublication] { return List<OwnershipPublication>.asSlice(&self.ownershipPublicationsData.values) }
  pub fn ownershipPublicationsAt(self: &Self, value: ValueId) -> &[usize] { return ownershipRowsAt(&self.ownershipPublicationsData, value, false) }
  pub fn ownershipPublicationGapsAt(self: &Self, value: ValueId) -> &[usize] { return ownershipRowsAt(&self.ownershipPublicationsData, value, true) }
  pub effect fn ownershipPublicationOrigins(self: &Self, value: ValueId) -> List<usize>
  ! OutOfMemoryError ? &mut Allocator { return run ownershipOriginsAt(&self.ownershipPublicationsData, value) }
  pub fn ownershipPublicationGaps(self: &Self) -> &[OwnershipPublicationGap] { return List<OwnershipPublicationGap>.asSlice(&self.ownershipPublicationsData.gaps) }
  pub fn addressCoverage(self: &Self) -> &[AddressCoverage] { return List<AddressCoverage>.asSlice(&self.addressCoverageData.requests) }
  pub fn selectionUses(self: &Self) -> &[SelectionUse] { return List<SelectionUse>.asSlice(&self.selections) }
  pub fn fieldReholdRequests(self: &Self) -> &[FieldReholdRequest] { return List<FieldReholdRequest>.asSlice(&self.fieldReholds.requests) }
  pub fn fieldReholdObservations(self: &Self) -> &[FieldReholdObservation] { return List<FieldReholdObservation>.asSlice(&self.fieldReholds.observations) }
  pub fn fieldReholdReads(self: &Self) -> &[FieldReholdRead] { return List<FieldReholdRead>.asSlice(&self.fieldReholds.reads) }
  pub fn fieldReholdCandidates(self: &Self) -> &[FieldReholdCandidate] { return List<FieldReholdCandidate>.asSlice(&self.fieldReholds.candidates) }
  pub fn fieldReholdCoverage(self: &Self) -> &[FieldReholdCoverage] { return List<FieldReholdCoverage>.asSlice(&self.fieldReholds.coverage) }
  pub fn fieldReholdClears(self: &Self) -> &[FieldReholdClear] { return List<FieldReholdClear>.asSlice(&self.fieldReholds.clears) }
  pub fn fieldReholdSuppressions(self: &Self) -> &[FieldReholdSuppression] { return List<FieldReholdSuppression>.asSlice(&self.fieldReholds.suppressions) }
  pub fn fieldReholdCaseCoverage(self: &Self) -> &[FieldReholdCaseCoverage] { return List<FieldReholdCaseCoverage>.asSlice(&self.fieldReholds.cases) }
  pub fn consumedDrops(self: &Self) -> &[ConsumedDrop] { return List<ConsumedDrop>.asSlice(&self.drops.requests) }
  pub fn dropObservations(self: &Self) -> &[DropObservation] { return List<DropObservation>.asSlice(&self.drops.observations) }
  pub fn dropReads(self: &Self) -> &[DropRead] { return List<DropRead>.asSlice(&self.drops.reads) }
  pub fn dropCoverage(self: &Self) -> &[DropCoverage] { return List<DropCoverage>.asSlice(&self.drops.coverage) }
  pub fn selectedMoves(self: &Self) -> &[SelectedMove] { return List<SelectedMove>.asSlice(&self.selectedMovesData.requests) }
  pub fn moveObservations(self: &Self) -> &[MoveObservation] { return List<MoveObservation>.asSlice(&self.selectedMovesData.observations) }
  pub fn moveReads(self: &Self) -> &[MoveRead] { return List<MoveRead>.asSlice(&self.selectedMovesData.reads) }
  pub fn moveHoldings(self: &Self) -> &[MoveHolding] { return List<MoveHolding>.asSlice(&self.selectedMovesData.holdings) }
  pub fn ownershipMirrors(self: &Self) -> &[OwnershipMirror] { return List<OwnershipMirror>.asSlice(&self.ownershipMirrorsData.candidates) }
  pub fn ownershipMirrorCoverage(self: &Self) -> &[OwnershipMirrorCoverage] { return List<OwnershipMirrorCoverage>.asSlice(&self.ownershipMirrorsData.coverage) }
  pub fn moveCoverage(self: &Self) -> &[MoveCoverage] { return List<MoveCoverage>.asSlice(&self.selectedMovesData.coverage) }
  pub fn moveHoldingCoverage(self: &Self) -> &[MoveHoldingCoverage] { return List<MoveHoldingCoverage>.asSlice(&self.selectedMovesData.holdingCoverage) }
  pub fn ownershipPositions(self: &Self) -> &[OwnershipPosition] { return List<OwnershipPosition>.asSlice(&self.selectedMovesData.positions) }
  pub fn referenceObservations(self: &Self) -> &[ReferenceObservation] { return List<ReferenceObservation>.asSlice(&self.referenceObservationsData) }
  pub fn throughResultCandidates(self: &Self) -> &[ThroughResultCandidate] { return List<ThroughResultCandidate>.asSlice(&self.throughResultCandidatesData) }
  pub fn fieldResultRecipes(self: &Self) -> &[FieldResultRecipe] { return List<FieldResultRecipe>.asSlice(&self.fieldResultRecipesData) }
  pub fn fieldResultCandidates(self: &Self) -> &[FieldResultCandidate] { return List<FieldResultCandidate>.asSlice(&self.fieldResultCandidatesData) }
  pub fn ordinaryResultDemands(self: &Self) -> &[OrdinaryResultDemand] { return List<OrdinaryResultDemand>.asSlice(&self.ordinaryResultDemandsData) }
  pub fn ordinaryResultCandidates(self: &Self) -> &[OrdinaryResultCandidate] { return List<OrdinaryResultCandidate>.asSlice(&self.ordinaryResultCandidatesData) }
  pub fn rvalueDereferenceResults(self: &Self) -> &[RvalueDereferenceResult] { return List<RvalueDereferenceResult>.asSlice(&self.rvalueDereferenceResultsData) }
  pub fn rvalueDereferenceValues(self: &Self) -> &[RvalueDereferenceValue] { return List<RvalueDereferenceValue>.asSlice(&self.rvalueDereferenceValuesData) }
  pub fn throughReadValues(self: &Self) -> &[ThroughReadValue] { return List<ThroughReadValue>.asSlice(&self.throughReadValuesData) }
  pub fn throughFlightRequests(self: &Self) -> &[ThroughFlightRequest] { return List<ThroughFlightRequest>.asSlice(&self.throughFlightRequestsData) }
  pub fn throughFlightObservations(self: &Self) -> &[ThroughFlightObservation] { return List<ThroughFlightObservation>.asSlice(&self.throughFlightObservationsData) }
