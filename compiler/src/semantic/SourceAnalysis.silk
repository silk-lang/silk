//! Immutable occurrence-aware source facts from one complete typed-body reservation.
//!
//! CFG definitions, value transfers and policy guards share SourceRules.Program. A solved
//! Graph owns the exact preparation package and a fresh stamp. Public identifiers cannot be
//! applied to another analysis, even after the producing graph is dropped and memory reused.

import semantic.SourcePreparation {
  ApplicationId, ContractRouteId, Coverage, EndpointId, MapId, SelectionId as PreparedSelectionId,
  SourcePreparation, Selection, SelectionMap, ContractRoute, Root, Endpoint, Selector, MapKind,
  InputRoute, InputRead, Transport, EndpointRole, IndexClass, ShapeId,
}
import semantic.SourcePreparation as Prepared
import semantic.SourceFlow {ComponentId, Definition, DefinitionId, Flow, PointId, Read, ReadId, Reaching, Point, Pair, Write}
import semantic.SourceRules {Atom, Program, Solution, Truth}
import semantic.TypedBody {Local, LocalId, Node, NodeId, NodeKind, Origin, Expression, AggregateField, SafetyObligation}
import semantic.Type {Type}
import hir.Hir {Access as ReferenceAccess}
import semantic.Lifetime {Lifetime}
import semantic.SourceLocations {Location}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.option {Option}
import silk.ownership {Copy}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.shared {Shared}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}
import CompilerBug

/// A static evaluation role. Repeated evaluations of the same NodeId have separate EvalIds.
pub enum EvaluationRole { Entry, Value, Receiver, Argument, Capture, Cleanup, Run, Binding, Replacement }
pub struct EvalId { pub index: usize }
impl Copy for EvalId {}
pub struct ValueId { pub index: usize }
impl Copy for ValueId {}
/// The real acquisition occurrence precedes later operands even when their enclosing call
/// never produces a value. Its loan identity is supplied by the ownership projection.
pub struct ReferenceAcquisition { pub evaluation: EvalId, pub loan: usize }
impl Copy for ReferenceAcquisition {}

pub struct LeafId { pub index: usize }
impl Copy for LeafId {}

pub union SourceLeaf {
  Entry { pub local: LocalId },
  Borrow { pub loan: usize, pub node: Option<NodeId> },
  Expression { pub node: NodeId },
  LoanFree { pub node: NodeId },
  Unknown { pub node: Option<NodeId>, pub reason: UnknownReason },
}
pub enum UnknownReason { OpaqueSource, UnavailableDeclaration, UnsupportedTransfer, Uninitialized }

pub struct Leaf {
  pub kind: SourceLeaf
  pub origin: Origin
  pub endpoint: EndpointId
}

pub union EvaluationSite { Entry { pub local: LocalId }, Node { pub node: NodeId } }
impl Copy for EvaluationSite {}

pub struct Evaluation {
  pub site: EvaluationSite
  pub role: EvaluationRole
  pub point: PointId
}
impl Copy for Evaluation {}

/// One physical component of an actual value occurrence. Historical alternatives do not add
/// values: they add conditional cases reaching this same port.
pub struct Value {
  pub evaluation: EvalId
  pub endpoint: EndpointId
}
impl Copy for Value {}

pub enum Directness { Preserve, Direct, Indirect }
pub enum TransferPolicy { Physical, Filtered }

/// A physical value map runs forward. Only an authenticated Storage->Storage address map
/// may run inversely while placing a value into the canonical storage it actually denotes.
pub enum MapDirection { Forward, StorageInverse }

/// Actual source/read/definition evidence travels together on each transfer. Placement is the
/// target value's prepared endpoint; source and target are never recovered from region equality.
pub struct Transfer {
  pub source: ValueId
  pub target: ValueId
  pub active: Atom
  pub directness: Directness
  pub stored: Atom
  pub alternatives: Atom
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub map: Option<MapId>
  pub direction: MapDirection
  pub address: Option<EvalId>
  pub contract: Option<ContractRouteId>
  pub policy: TransferPolicy
}

pub struct Seed {
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub active: Atom
  pub stored: Atom
  pub alternatives: Atom
}
impl Copy for Seed {}

/// Canonical storage identity includes the physical temporary occurrence. Reusing a typed
/// NodeId does not make its two evaluated owners the same storage. Local declaration storage
/// has no temporary occurrence; caller/source identity is never inferred from a type or region.
pub struct Storage {
  pub endpoint: EndpointId
  pub temporary: Option<EvalId>
}
impl Copy for Storage {}

fn sameStorage(left: Storage, right: Storage) -> bool {
  if left.endpoint.index != right.endpoint.index { return false }
  return match left.temporary {
    Option<EvalId>.Some {value} => match right.temporary { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
    Option<EvalId>.None => match right.temporary { Option<EvalId>.None => true _ => false }
  }
}

/// A definition's value is the actual stored component, after its RHS placement. Entries,
/// loan-free replacements and opaque/unknown values use the same definition representation.
struct DefinedValue {
  definition: DefinitionId
  value: ValueId
}
impl Copy for DefinedValue {}

/// A read supplies its actual storage-to-value map once. Complete definition/read pairing is
/// reserved later, including definitions not yet visited when the read was encountered.
struct ReadValue {
  read: ReadId
  storage: Storage
  value: ValueId
  map: Option<MapId>
}
impl Copy for ReadValue {}

/// An actual place occurrence denotes canonical storage through an explicit finite chain of
/// prepared Select maps. This is address identity, not a snapshot of that storage's contents.
pub struct StorageAlias {
  pub evaluation: EvalId
  pub endpoint: EndpointId
  pub storage: Storage
  pub write: Write
  pub route: Vector<MapId>
}

/// A real reference descriptor remembers its actual address formation, not a copy of the
/// referent's then-current contents. The paired map is frozen interpretation evidence for
/// a later read at its own use point; it must never become a borrow-time value snapshot.
struct ReferenceOrigin {
  leaf: LeafId
  source: EvalId
  descriptor: ValueId
  map: MapId
  referent: MapId
}

/// Structural producer; no source alternative is selected during reservation. The BorrowCheck
/// visitor records actual roots, evaluations, storage and typed transfers into this one skeleton.
pub struct Skeleton {
  pub rules: Program
  pub flow: Flow
  pub evaluations: Vector<Evaluation>
  pub values: Vector<Value>
  pub leaves: Vector<Leaf>
  pub transfers: Vector<Transfer>
  pub seeds: Vector<Seed>
  pub storage: Vector<Storage>
  pub aliases: Vector<StorageAlias>
  references: Vector<ReferenceOrigin>
  definitions: Vector<DefinedValue>
  reads: Vector<ReadValue>
  closedPairs: usize
}

/// A source-quality observation. Presence is separate from positive loss bits: an absent cell
/// is not Exact, and an unresolved loss is not false.
pub struct Cell {
  pub present: Atom
  pub stored: Atom
  pub alternatives: Atom
}
impl Copy for Cell {}

/// One policy scan position for a physical value component and one source leaf. Reaching
/// histories belong to cases, not additional positions; genuinely repeated operands have
/// distinct ValueIds. Entry/loan-free/unknown inputs remain visible but are not Borrow counts.
pub struct Input {
  pub value: ValueId
  pub leaf: LeafId
  pub quality: Cell
  pub cases: Vector<InputCase>
}

/// All case attributes come from one paired route. Policy guards cannot combine one history's
/// directness or placement with another history's definition/read or quality.
pub struct InputCase {
  pub source: Option<ValueId>
  pub placement: EndpointId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub map: Option<MapId>
  pub direction: MapDirection
  pub address: Option<EvalId>
  pub contract: Option<ContractRouteId>
  pub quality: Cell
}

struct CellKey {
  value: ValueId
  leaf: LeafId
  witness: usize
  direct: bool
}
impl Copy for CellKey {}

struct Witness {
  definition: Option<DefinitionId>
  read: Option<ReadId>
}

struct Case {
  source: Option<usize>
  target: usize
  active: Atom
  quality: Cell
  definition: Option<DefinitionId>
  read: Option<ReadId>
  map: Option<MapId>
  direction: MapDirection
  address: Option<EvalId>
  contract: Option<ContractRouteId>
}

/// One pre-reserved policy decision for a concrete candidate source and paired history.
/// Multiple leaves using the same physical transfer have DIFFERENT ports: one source's
/// retained result must not activate every other source on that transfer.
pub struct PolicyPortId { index: usize }
impl Copy for PolicyPortId {}
pub struct PolicyPort {
  pub id: PolicyPortId
  pub transfer: usize
  pub source: ValueId
  pub target: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub quality: Cell
}
impl Copy for PolicyPort {}

struct PendingPolicy {
  port: PolicyPort
  sourceCell: usize
  kept: Atom
  stored: Atom
  alternatives: Atom
  bound: bool
}
impl Copy for PendingPolicy {}

/// Policy translation adds rules to these reserved cells and observation versions, never new
/// source leaves or components. There is only one solve, after all consumers have emitted rules.
pub struct Builder<'body> {
  pub rules: Program
  pub reaching: Reaching
  storage: Vector<Storage>
  references: Vector<ReferenceOrigin>
  preparation: SourcePreparation<'body>
  evaluations: Vector<Evaluation>
  values: Vector<Value>
  leaves: Vector<Leaf>
  cells: Vector<Cell>
  keys: Vector<CellKey>
  witnesses: Vector<Witness>
  cases: Vector<Case>
  policies: Vector<PendingPolicy>
}

struct Stamp { marker: bool }
fn stampAddress(value: &Stamp) -> usize {
  return Pointer.address<Stamp>(Pointer.fromRef<Stamp>(value))
}
fn sameStamp(left: &Shared<Stamp>, right: &Shared<Stamp>) -> bool {
  return Shared<Stamp>.with<usize>(left, stampAddress) == Shared<Stamp>.with<usize>(right, stampAddress)
}

pub struct SourceLeafId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SelectionId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SourceRouteId {
  stamp: Shared<Stamp>
  root: usize
}
pub struct RoutePortId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct RouteCaseId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct OccurrenceId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SourceDefinitionId {
  stamp: Shared<Stamp>
  index: usize
}
pub struct SourceReadId {
  stamp: Shared<Stamp>
  index: usize
}

pub enum AccessError { ForeignAnalysis, InvalidSelection, InvalidRoute, InvalidPort, InvalidCase, InvalidOccurrence }

pub struct SourceQuery {
  pub read: NodeId
  pub selection: SelectionId
}

pub struct Quality {
  pub present: Truth
  pub stored: Truth
  pub alternatives: Truth
}

pub struct SourceAlternative {
  pub leaf: SourceLeafId
  pub origin: Origin
  pub occurrence: OccurrenceId
  pub route: SourceRouteId
  pub case: RouteCaseId
}

pub enum SourceGap { MissingEvaluation, Recovery, Ungrounded, UnresolvedApplicability }

pub struct SourceEvaluation {
  pub occurrence: OccurrenceId
  pub reachable: Truth
}

pub struct Sources {
  pub evaluations: Vector<SourceEvaluation>
  pub alternatives: Vector<SourceAlternative>
  pub gaps: Vector<SourceGap>
  /// Enumeration only. Unknown leaves and unresolved cases still owe their semantic proof.
  pub complete: bool
}

pub struct RouteView {
  pub start: RoutePortId
  pub accepts: Vector<RoutePortId>
  pub leaf: SourceLeafId
}

pub struct RoutePort {
  pub endpoint: EndpointId
  pub occurrence: OccurrenceId
  pub direct: bool
  pub quality: Quality
}

/// Backward proof traversal: from is the receiving value and to is its prior source. The
/// prepared map retains its forward physical source->target orientation, so from corresponds
/// to map.target and to corresponds to map.source for Forward. StorageInverse reverses this
/// orientation only for authenticated address identity; address names the real place occurrence.
/// Neither direction manufactures a map or treats a reference boundary as storage identity.
pub struct RouteEdge {
  pub direction: MapDirection
  pub address: Option<OccurrenceId>
  pub from: RoutePortId
  pub to: RoutePortId
  pub map: Option<MapId>
  pub originalContract: Option<ContractRouteId>
  pub case: RouteCaseId
}

pub struct RouteCase {
  pub applicability: Truth
  pub definition: Option<SourceDefinitionId>
  pub read: Option<SourceReadId>
  pub placement: EndpointId
  pub direct: bool
  pub quality: Quality
}

pub union SourceDisposition { Proved, Pending, Refuted { pub origin: Origin } }
pub struct SourceOutcome {
  stamp: Shared<Stamp>
  ordinal: usize
  disposition: SourceDisposition
}

/// Owns all immutable source and policy facts for this invocation. It is neither a query answer
/// nor TypedBody metadata and exposes no rebase/copy constructor.
pub struct Graph<'body> {
  stamp: Shared<Stamp>
  preparation: SourcePreparation<'body>
  solution: Solution
  reaching: Reaching
  storage: Vector<Storage>
  references: Vector<ReferenceOrigin>
  evaluations: Vector<Evaluation>
  values: Vector<Value>
  leaves: Vector<Leaf>
  cells: Vector<Cell>
  keys: Vector<CellKey>
  witnesses: Vector<Witness>
  cases: Vector<Case>
}

impl Skeleton {
  pub fn make() -> Self {
    return Skeleton {rules: Program.make(), flow: Flow.make(), evaluations: Vector<Evaluation>.make(),
      values: Vector<Value>.make(), leaves: Vector<Leaf>.make(), transfers: Vector<Transfer>.make(), seeds: Vector<Seed>.make(),
      storage: Vector<Storage>.make(), aliases: Vector<StorageAlias>.make(), references: Vector<ReferenceOrigin>.make(), definitions: Vector<DefinedValue>.make(), reads: Vector<ReadValue>.make(), closedPairs: usize.ZERO}
  }

  pub effect fn evaluate(self: &mut Self, node: NodeId, role: EvaluationRole, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let id = EvalId {index: Vector<Evaluation>.length(&self.evaluations)}
    run Vector<Evaluation>.append(&mut self.evaluations, Evaluation {site: EvaluationSite.Node {node: node}, role: role, point: point})
    return id
  }

  /// Only the owning visitor may create entry storage, for actual parameters/capture aliases.
  /// Locals with a binding node obtain their definitions at that binding, never here.
  pub effect fn entry(self: &mut Self, local: LocalId, point: PointId) -> EvalId
  ! OutOfMemoryError ? &mut Allocator {
    let id = EvalId {index: Vector<Evaluation>.length(&self.evaluations)}
    run Vector<Evaluation>.append(&mut self.evaluations,
      Evaluation {site: EvaluationSite.Entry {local: local}, role: EvaluationRole.Entry, point: point})
    return id
  }

  pub effect fn value(self: &mut Self, evaluation: EvalId, endpoint: EndpointId) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let values = Vector<Value>.asSlice(&self.values)
    let mut at = usize.ZERO
    while at < values.length {
      if values[at].evaluation.index == evaluation.index && values[at].endpoint.index == endpoint.index {
        return ValueId {index: at}
      }
      at = at + usize.ONE
    }
    let id = ValueId {index: Vector<Value>.length(&self.values)}
    run Vector<Value>.append(&mut self.values, Value {evaluation: evaluation, endpoint: endpoint})
    return id
  }

  pub effect fn leaf(self: &mut Self, leaf: Leaf) -> LeafId
  ! OutOfMemoryError ? &mut Allocator {
    let id = LeafId {index: Vector<Leaf>.length(&self.leaves)}
    run Vector<Leaf>.append(&mut self.leaves, move leaf)
    return id
  }

  effect fn internStorage(self: &mut Self, storage: Storage) -> ComponentId ! OutOfMemoryError ? &mut Allocator {
    let existing = Vector<Storage>.asSlice(&self.storage)
    let mut at = usize.ZERO
    while at < existing.length {
      if sameStorage(existing[at], storage) { return ComponentId {index: at} }
      at = at + usize.ONE
    }
    let component = ComponentId {index: existing.length}
    run Vector<Storage>.append(&mut self.storage, storage)
    return component
  }

  /// The prepared storage endpoint is the component identity. The value must already occupy
  /// that exact endpoint; a distinct RHS->storage map records physical placement separately.
  pub effect fn define(self: &mut Self, point: PointId, storage: Storage, value: ValueId,
    active: Atom, write: Write) -> DefinitionId ! OutOfMemoryError ? &mut Allocator {
    let values = Vector<Value>.asSlice(&self.values)
    if value.index >= values.length || values[value.index].endpoint.index != storage.endpoint.index {
      CompilerBug.panic(b"source definition does not name its stored component")
    }
    let component = run Skeleton.internStorage(&mut self.*, storage)
    let definition = run Flow.define(&mut self.flow, point, component, active, write)
    run Vector<DefinedValue>.append(&mut self.definitions, DefinedValue {definition: definition, value: value})
    return definition
  }

  pub effect fn read(self: &mut Self, point: PointId, storage: Storage, value: ValueId, map: Option<MapId>) -> ReadId
  ! OutOfMemoryError ? &mut Allocator {
    let recorded = Vector<ReadValue>.asSlice(&self.reads)
    let mut at = usize.ZERO
    while at < recorded.length {
      if sameStorage(recorded[at].storage, storage) && recorded[at].value.index == value.index {
        let same = match recorded[at].map {
          Option<MapId>.Some {value: selected} => match map { Option<MapId>.Some {value: other} => selected.index == other.index _ => false }
          Option<MapId>.None => match map { Option<MapId>.None => true _ => false }
        }
        if same { return recorded[at].read }
      }
      at = at + usize.ONE
    }
    let component = run Skeleton.internStorage(&mut self.*, storage)
    let read = run Flow.read(&mut self.flow, point, component)
    run Vector<ReadValue>.append(&mut self.reads, ReadValue {read: read, storage: storage, value: value, map: move map})
    return read
  }

  /// Close only the newly reserved storage pairs into the SAME transfer graph. Boundary
  /// discovery can append an actual later read and call this again before Flow.emit; no
  /// source/policy truth is sampled and no earlier pair is duplicated or replaced.
  pub effect fn closeStorage(self: &mut Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    let pairs = run Flow.reservePairs(&mut self.flow, &mut self.rules)
    let count = pairs.length
    if self.closedPairs > count { CompilerBug.panic(b"source storage pair reservation shrank") }
    let changed = self.closedPairs != count
    run storageTransfers(pairs, self.closedPairs, Vector<DefinedValue>.asSlice(&self.definitions),
      Vector<ReadValue>.asSlice(&self.reads), &mut self.transfers, &mut self.rules)
    self.closedPairs = count
    return changed
  }

  /// Materialize an actually addressed rvalue. Frozen temporary maps alone never call this:
  /// the structural visitor or explicit producer reference must supply its actual evaluation.
  pub effect fn materialize(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, evaluation: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let node = match actual.site { EvaluationSite.Node {node} => node _ => return CompilerBug.panic(b"entry is not a temporary evaluation") }
    let family = run transferFamily(endpoints, maps, map)
    let absent = Program.atom(&mut self.rules)
    drop run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, evaluation,
      active, Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let members = Vector<MapId>.asSlice(&family)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      let from = match &endpoints[physical.source.index].root {
        Root.Node {node: source, role} => source.index == node.index && role == EndpointRole.Value _ => false
      }
      let into = match &endpoints[physical.target.index].root {
        Root.Node {node: target, role} => target.index == node.index && role == EndpointRole.Storage _ => false
      }
      if !from || !into || physical.kind != MapKind.Place { CompilerBug.panic(b"temporary materialization lacks its exact evaluated value placement") }
      let storage = Storage {endpoint: physical.target, temporary: Option<EvalId>.some(evaluation)}
      let existing = Vector<StorageAlias>.asSlice(&self.aliases)
      let mut at = usize.ZERO
      while at < existing.length {
        if existing[at].evaluation.index == evaluation.index && existing[at].endpoint.index == physical.target.index {
          CompilerBug.panic(b"one actual temporary occurrence was materialized twice")
        }
        at = at + usize.ONE
      }
      let value = run Skeleton.value(&mut self.*, evaluation, physical.target)
      drop run Skeleton.define(&mut self.*, actual.point, storage, value, active, Write.Strong)
      run Vector<StorageAlias>.append(&mut self.aliases, StorageAlias {evaluation: evaluation,
        endpoint: physical.target, storage: storage, write: Write.Strong, route: Vector<MapId>.make()})
      member = member + usize.ONE
    }
    return ()
  }

  /// A local whole/component read binds every explicitly prepared inline map to the same
  /// actual read evaluation. Entry and loan-free definitions therefore follow the same path
  /// as borrowed definitions, including later replacements reaching a loop backedge.
  pub effect fn readLocal(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    evaluation: EvalId, local: LocalId) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let sameSite = match actual.site {
      EvaluationSite.Node {node} => node.index == maps[map.index].site.index
      _ => false
    }
    if !sameSite { CompilerBug.panic(b"a local read map was attached to another occurrence") }
    let members = Vector<MapId>.asSlice(&family)
    let root = run Skeleton.value(&mut self.*, evaluation, maps[map.index].target)
    let mut at = usize.ZERO
    while at < members.length {
      let member = members[at]
      let physical = &maps[member.index]
      let storage = match &endpoints[physical.source.index].root {
        Root.Local {local: found, role} => found.index == local.index && role == EndpointRole.Storage
        _ => false
      }
      if !storage || physical.kind != MapKind.Copy {
        CompilerBug.panic(b"a local read must name canonical local storage and a prepared Copy map")
      }
      let value = run Skeleton.value(&mut self.*, evaluation, physical.target)
      drop run Skeleton.read(&mut self.*, actual.point, Storage {endpoint: physical.source, temporary: Option<EvalId>.none()}, value, Option<MapId>.some(member))
      at = at + usize.ONE
    }
    return root
  }

  /// Local place formation binds the explicit Storage->Storage family to this occurrence.
  /// No value is copied and no declaration/read pairing is guessed until an actual read occurs.
  pub effect fn localAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    evaluation: EvalId, local: LocalId) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = Vector<MapId>.asSlice(&family)
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"local place map has a different actual occurrence") }
    let mut at = usize.ZERO
    while at < members.length {
      let physical = &maps[members[at].index]
      let canonical = match &endpoints[physical.source.index].root {
        Root.Local {local: owner, role} => owner.index == local.index && role == EndpointRole.Storage
        _ => false
      }
      let storage = match move endpointRole(&endpoints[physical.target.index]) {
        Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false
      }
      if !canonical || !storage || physical.kind != MapKind.Select {
        CompilerBug.panic(b"local address map does not identify canonical storage")
      }
      let mut route = Vector<MapId>.make()
      run Vector<MapId>.append(&mut route, members[at])
      run Vector<StorageAlias>.append(&mut self.aliases, StorageAlias {evaluation: evaluation,
        endpoint: physical.target, storage: Storage {endpoint: physical.source, temporary: Option<EvalId>.none()}, write: Write.Strong, route: move route})
      at = at + usize.ONE
    }
    return ()
  }

  /// An inline place projection composes exact address evidence. It does not read the old
  /// stored value or turn an unknown reference selector into an owned-storage alias.
  pub effect fn projectAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, write: Write) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let actual = Skeleton.evaluation(&self.*, target)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"projected address map has a different actual occurrence") }
    let members = Vector<MapId>.asSlice(&family)
    let previous = Vector<StorageAlias>.length(&self.aliases)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Select { CompilerBug.panic(b"projected storage identity requires a Select map") }
      let mut at = usize.ZERO
      while at < previous {
        let alias = &Vector<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == source.index && alias.endpoint.index == physical.source.index {
          let storage = alias.storage
          let mut strength = write
          if alias.write == Write.Weak { strength = Write.Weak }
          let mut route = run copyMapRoute(Vector<MapId>.asSlice(&alias.route))
          run Vector<MapId>.append(&mut route, members[member])
          run Vector<StorageAlias>.append(&mut self.aliases, StorageAlias {evaluation: target,
            endpoint: physical.target, storage: storage, write: strength, route: move route})
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// Read canonical storage at THIS operation's point, then compose its already-authenticated
  /// address maps. Reusing an earlier base's value would miss intervening writes/backedges.
  /// Intermediate ports share the actual read evaluation; map.site still names the real earlier
  /// address formation, so the proof exposes both facts without inventing another evaluation.
  pub effect fn readAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = Vector<MapId>.asSlice(&family)
    let actual = Skeleton.evaluation(&self.*, target)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !matches { CompilerBug.panic(b"projected read map has a different actual occurrence") }
    let absent = Program.atom(&mut self.rules)
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Copy { CompilerBug.panic(b"projected value read requires a prepared Copy map") }
      let count = Vector<StorageAlias>.length(&self.aliases)
      let mut at = usize.ZERO
      while at < count {
        let alias = &Vector<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == source.index && alias.endpoint.index == physical.source.index {
          let storage = alias.storage
          let mut route = run copyMapRoute(Vector<MapId>.asSlice(&alias.route))
          run Vector<MapId>.append(&mut route, members[member])
          let incoming = run Skeleton.value(&mut self.*, target, storage.endpoint)
          drop run Skeleton.read(&mut self.*, actual.point, storage, incoming, Option<MapId>.none())
          let chain = Vector<MapId>.asSlice(&route)
          let mut before = incoming
          let mut step = usize.ZERO
          while step < chain.length {
            let edge = chain[step]
            if edge.index >= maps.length || maps[edge.index].source.index != Vector<Value>.asSlice(&self.values)[before.index].endpoint.index {
              CompilerBug.panic(b"canonical source read lost its contiguous address route")
            }
            let onward = run Skeleton.value(&mut self.*, target, maps[edge.index].target)
            let mut address = Option<EvalId>.none()
            if maps[edge.index].kind == MapKind.Select { address = Option<EvalId>.some(source) }
            run Vector<Transfer>.append(&mut self.transfers, Transfer {direction: MapDirection.Forward, address: address, source: before, target: onward,
              active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
              definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
              map: Option<MapId>.some(edge), contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Physical})
            before = onward
            step = step + usize.ONE
          }
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  /// A whole local binding/replacement installs all components even when its value has no
  /// Borrow leaf. Strong kills are definitions of actual values, not side effects of finding
  /// an existing held loan. Field/conditional stores use their separately authenticated target.
  pub effect fn writeLocal(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, local: LocalId, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, target)
    let absent = Program.atom(&mut self.rules)
    let root = run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, target, active,
      Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let family = run transferFamily(endpoints, maps, map)
    let members = Vector<MapId>.asSlice(&family)
    let mut at = usize.ZERO
    while at < members.length {
      let physical = &maps[members[at].index]
      let storage = match &endpoints[physical.target.index].root {
        Root.Local {local: found, role} => found.index == local.index && role == EndpointRole.Storage
        _ => false
      }
      if !storage || physical.kind != MapKind.Place {
        CompilerBug.panic(b"a local replacement must name canonical local storage and a prepared Place map")
      }
      let stored = run Skeleton.value(&mut self.*, target, physical.target)
      drop run Skeleton.define(&mut self.*, actual.point, Storage {endpoint: physical.target, temporary: Option<EvalId>.none()}, stored, active, Write.Strong)
      at = at + usize.ONE
    }
    return root
  }

  /// Place through an actual owned address. The RHS follows its frozen placement map; the
  /// inverse address chain only chooses canonical storage. It is not a new value copy or a
  /// reference-content proof. Runtime-index alternatives remain weak writes to each candidate.
  pub effect fn writeAliases(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, address: EvalId, target: EvalId, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, target)
    let absent = Program.atom(&mut self.rules)
    drop run Skeleton.transfer(&mut self.*, endpoints, maps, map, source, target, active,
      Directness.Preserve, absent, absent, TransferPolicy.Physical)
    let family = run transferFamily(endpoints, maps, map)
    let members = Vector<MapId>.asSlice(&family)
    let mut defined = Vector<Storage>.make()
    let mut member = usize.ZERO
    while member < members.length {
      let physical = &maps[members[member].index]
      if physical.kind != MapKind.Place { CompilerBug.panic(b"projected replacement has no prepared Place map") }
      let count = Vector<StorageAlias>.length(&self.aliases)
      let mut at = usize.ZERO
      while at < count {
        let alias = &Vector<StorageAlias>.asSlice(&self.aliases)[at]
        if alias.evaluation.index == address.index && alias.endpoint.index == physical.target.index {
          let storage = alias.storage
          let mut write = alias.write
          // Alternative address routes to one canonical component are histories of the same
          // write, not extra definitions. A non-singleton address cannot acquire a strong kill
          // merely because a second route to that component was visited first.
          let aliases = Vector<StorageAlias>.asSlice(&self.aliases)
          let mut other = usize.ZERO
          while other < aliases.length {
            if aliases[other].evaluation.index == address.index && sameStorage(aliases[other].storage, storage)
              && aliases[other].write == Write.Weak { write = Write.Weak }
            other = other + usize.ONE
          }
          let route = run copyMapRoute(Vector<MapId>.asSlice(&alias.route))
          let chain = Vector<MapId>.asSlice(&route)
          let mut step = chain.length
          let mut before = run Skeleton.value(&mut self.*, target, physical.target)
          while step > usize.ZERO {
            step = step - usize.ONE
            let edge = chain[step]
            validateAddressMap(endpoints, maps, Vector<StorageAlias>.asSlice(&self.aliases), edge, address)
            if maps[edge.index].target.index != Vector<Value>.asSlice(&self.values)[before.index].endpoint.index {
              CompilerBug.panic(b"projected write lost its actual address route")
            }
            let onward = run Skeleton.value(&mut self.*, target, maps[edge.index].source)
            run Vector<Transfer>.append(&mut self.transfers, Transfer {
              direction: MapDirection.StorageInverse, address: Option<EvalId>.some(address),
              source: before, target: onward, active: active, directness: Directness.Preserve,
              stored: absent, alternatives: absent, definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
              map: Option<MapId>.some(edge), contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Physical})
            before = onward
          }
          let installed = Vector<Storage>.asSlice(&defined)
          let mut seen = false
          let mut prior = usize.ZERO
          while prior < installed.length {
            if sameStorage(installed[prior], storage) { seen = true }
            prior = prior + usize.ONE
          }
          if !seen {
            drop run Skeleton.define(&mut self.*, actual.point, storage, before, active, write)
            run Vector<Storage>.append(&mut defined, storage)
          }
        }
        at = at + usize.ONE
      }
      member = member + usize.ONE
    }
    return ()
  }

  fn evaluation(self: &Self, id: EvalId) -> Evaluation {
    let actual = Vector<Evaluation>.asSlice(&self.evaluations)
    if id.index >= actual.length { CompilerBug.panic(b"source transfer has no actual evaluation") }
    return actual[id.index]
  }

  /// Destruction is an actual definition of unavailable storage, not absence of a held
  /// loan. Copies read before this point keep their predecessor; a later read (including a
  /// backedge) observes Uninitialized. Ownership independently reports the exact move/drop.
  pub effect fn invalidateAliases(self: &mut Self, endpoints: &[Endpoint], address: EvalId,
    root: EndpointId, target: EvalId, origin: Origin, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    let mut covered = Vector<Storage>.make()
    let count = Vector<StorageAlias>.length(&self.aliases)
    let mut at = usize.ZERO
    while at < count {
      let alias = &Vector<StorageAlias>.asSlice(&self.aliases)[at]
      if alias.evaluation.index == address.index && componentWithin(endpoints, alias.endpoint, root) {
        let storage = alias.storage
        let mut write = alias.write
        let aliases = Vector<StorageAlias>.asSlice(&self.aliases)
        let mut alternative = usize.ZERO
        while alternative < aliases.length {
          if aliases[alternative].evaluation.index == address.index
            && componentWithin(endpoints, aliases[alternative].endpoint, root)
            && sameStorage(aliases[alternative].storage, storage) && aliases[alternative].write == Write.Weak {
            write = Write.Weak
          }
          alternative = alternative + usize.ONE
        }
        let earlier = Vector<Storage>.asSlice(&covered)
        let mut duplicate = false
        let mut each = usize.ZERO
        while each < earlier.length {
          if sameStorage(earlier[each], storage) { duplicate = true }
          each = each + usize.ONE
        }
        if !duplicate {
          run Vector<Storage>.append(&mut covered, storage)
          run Skeleton.uninitialize(&mut self.*, storage, target, origin, active, write)
        }
      }
      at = at + usize.ONE
    }
    if Vector<Storage>.length(&covered) == usize.ZERO {
      CompilerBug.panic(b"consumed owned place has no actual canonical storage components")
    }
    return ()
  }

  // Unavailable is an explicit source definition. It is neither a synthetic RHS nor a
  // LoanFree value, and it cannot make a later mandatory source obligation disappear.
  effect fn uninitialize(self: &mut Self, storage: Storage, evaluation: EvalId, origin: Origin,
    active: Atom, write: Write) -> () ! OutOfMemoryError ? &mut Allocator {
    let actual = Skeleton.evaluation(&self.*, evaluation)
    let node = match actual.site { EvaluationSite.Node {node} => node _ => { return CompilerBug.panic(b"entry is not a consuming operation") } }
    let absent = Program.atom(&mut self.rules)
    let value = run Skeleton.value(&mut self.*, evaluation, storage.endpoint)
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Unknown {
      node: Option<NodeId>.some(node), reason: UnknownReason.Uninitialized}, origin: origin, endpoint: storage.endpoint})
    run Vector<Seed>.append(&mut self.seeds, Seed {value: value, leaf: leaf,
      direct: false, active: active, stored: absent, alternatives: absent})
    drop run Skeleton.define(&mut self.*, actual.point, storage, value, active, write)
    return ()
  }

  /// A real owner end kills its own reserved storage components. Reference descriptors which
  /// were copied earlier keep their earlier definition; their referent's end remains a distinct
  /// ownership fact. This does not recursively destroy storage reached through a reference.
  pub effect fn endOwner(self: &mut Self, endpoints: &[Endpoint], root: EndpointId,
    owner: Option<EvalId>, evaluation: EvalId, origin: Origin, active: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    if root.index >= endpoints.length { CompilerBug.panic(b"source owner end has no prepared root") }
    let actual = Skeleton.evaluation(&self.*, evaluation)
    if actual.role != EvaluationRole.Cleanup { CompilerBug.panic(b"source owner end has no actual lifecycle occurrence") }
    let count = Vector<Storage>.length(&self.storage)
    let mut at = usize.ZERO
    while at < count {
      let storage = Vector<Storage>.asSlice(&self.storage)[at]
      let sameOwner = match owner {
        Option<EvalId>.Some {value} => match storage.temporary { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
        Option<EvalId>.None => match storage.temporary { Option<EvalId>.None => true _ => false }
      }
      if sameOwner && componentWithin(endpoints, storage.endpoint, root) {
        // Only components actually materialized as this owner's storage enter this table.
        // Refuse an accidental boundary descendant rather than end a foreign referent.
        let mut component = storage.endpoint
        let mut remaining = endpoints.length
        while component.index != root.index && remaining > usize.ZERO {
          match &endpoints[component.index].selector {
            Selector.Referent => CompilerBug.panic(b"owner end cannot destroy a referent through its descriptor")
            Selector.EffectSuccess => CompilerBug.panic(b"owner end cannot destroy an Effect result")
            Selector.EffectFailure => CompilerBug.panic(b"owner end cannot destroy an Effect failure")
            _ => ()
          }
          component = match endpoints[component.index].parent {
            Option<EndpointId>.Some {value} => value
            _ => { return CompilerBug.panic(b"source owner component lost its storage ancestry") }
          }
          remaining = remaining - usize.ONE
        }
        if remaining == usize.ZERO { CompilerBug.panic(b"source owner component ancestry is cyclic") }
        run Skeleton.uninitialize(&mut self.*, storage, evaluation, origin, active, Write.Strong)
      }
      at = at + usize.ONE
    }
    return ()
  }

  /// Instantiates exactly the producer's frozen map family at two actual evaluations. Child
  /// endpoints come from explicit child-map IDs, never a scan for equal types or same-site maps.
  /// This only reserves transfers: it creates no source, owner, storage alias or evaluation.
  pub effect fn transfer(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId,
    source: EvalId, target: EvalId, active: Atom, directness: Directness,
    stored: Atom, alternatives: Atom, policy: TransferPolicy) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    let family = run transferFamily(endpoints, maps, map)
    let members = Vector<MapId>.asSlice(&family)
    if source.index >= Vector<Evaluation>.length(&self.evaluations)
      || target.index >= Vector<Evaluation>.length(&self.evaluations) {
      CompilerBug.panic(b"a physical source transfer has no actual evaluation")
    }
    let occurrence = Vector<Evaluation>.asSlice(&self.evaluations)[target.index]
    let sameSite = match occurrence.site {
      EvaluationSite.Node {node} => node.index == maps[map.index].site.index
      _ => false
    }
    if !sameSite { CompilerBug.panic(b"physical transfer was attached to another evaluation occurrence") }
    let result = run Skeleton.value(&mut self.*, target, maps[map.index].target)
    let mut at = usize.ZERO
    while at < members.length {
      let member = members[at]
      let from = run Skeleton.value(&mut self.*, source, maps[member.index].source)
      let to = run Skeleton.value(&mut self.*, target, maps[member.index].target)
      run Vector<Transfer>.append(&mut self.transfers, Transfer {direction: MapDirection.Forward, address: Option<EvalId>.none(),
        source: from, target: to, active: active, directness: directness,
        stored: stored, alternatives: alternatives,
        definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
        map: Option<MapId>.some(member), contract: Option<ContractRouteId>.none(), policy: policy})
      at = at + usize.ONE
    }
    return result
  }

  /// Binds one producer-selected capture/input route. Copy/Move/Evaluated transfer existing
  /// values; only explicit Borrow transport creates a new descriptor source. Its distinct
  /// referent family authenticates later address interpretation from the SAME source evaluation.
  /// The visitor owns the real borrow event/loan; its ID is required only for that transport.
  pub effect fn input(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], route: &InputRoute,
    source: EvalId, target: EvalId, acquisition: Option<ReferenceAcquisition>, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    if route.map.index >= maps.length { CompilerBug.panic(b"producer input has no physical map") }
    let created = route.transport == Transport.BorrowShared || route.transport == Transport.BorrowMutable
    let absent = Program.atom(&mut self.rules)
    if !created {
      if let Option<MapId>.Some {..} = &route.referent {
        CompilerBug.panic(b"a value transfer cannot create a second reference")
      }
      if let Option<ReferenceAcquisition>.Some {..} = acquisition {
        CompilerBug.panic(b"a value transfer cannot supply a new borrow loan")
      }
      return run Skeleton.transfer(&mut self.*, endpoints, maps, route.map, source, target, active,
        Directness.Preserve, absent, absent, TransferPolicy.Physical)
    }
    let referent = match route.referent {
      Option<MapId>.Some {value} => value
      _ => { return CompilerBug.panic(b"producer-created reference has no paired referent map") }
    }
    let acquired = match acquisition {
      Option<ReferenceAcquisition>.Some {value} => value
      _ => { return CompilerBug.panic(b"producer-created reference has no actual borrow event") }
    }
    return run Skeleton.reference(&mut self.*, endpoints, maps, route.map, referent, source, acquired.evaluation, target,
      acquired.loan, Option<NodeId>.none(), active)
  }

  /// Authored borrows own their exact pair independently of contract inputs. The actual loan
  /// is created by the ownership consumer at this occurrence, not inferred from a region atom.
  pub effect fn borrow<'body>(self: &mut Self, preparation: &SourcePreparation<'body>, borrowed: &Prepared.Borrow,
    source: EvalId, target: EvalId, loan: usize, active: Atom) -> ValueId ! OutOfMemoryError ? &mut Allocator {
    validateAuthoredBorrow(preparation, borrowed)
    let operand = match &preparation.body.nodes[borrowed.site.index].kind {
      NodeKind.Expression {form: Expression.Borrow {value, ..}, ..} => value
      _ => { return CompilerBug.panic(b"authored borrow changed its typed node") }
    }
    let actual = Skeleton.evaluation(&self.*, source)
    let matches = match actual.site { EvaluationSite.Node {node} => node.index == operand.index _ => false }
    if !matches { CompilerBug.panic(b"authored borrow does not use its actual operand occurrence") }
    return run Skeleton.reference(&mut self.*, Vector<Endpoint>.asSlice(&preparation.endpoints),
      Vector<SelectionMap>.asSlice(&preparation.maps), borrowed.map, borrowed.referent,
      source, target, target, loan, Option<NodeId>.some(borrowed.site), active)
  }

  effect fn reference(self: &mut Self, endpoints: &[Endpoint], maps: &[SelectionMap], map: MapId, referent: MapId,
    source: EvalId, acquisition: EvalId, target: EvalId, actualLoan: usize, node: Option<NodeId>, active: Atom) -> ValueId
  ! OutOfMemoryError ? &mut Allocator {
    validateReferenceMaps(endpoints, maps, map, referent)
    let absent = Program.atom(&mut self.rules)
    let acquired = Skeleton.evaluation(&self.*, acquisition)
    let result = Skeleton.evaluation(&self.*, target)
    let acquiredHere = match acquired.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    let returnedHere = match result.site { EvaluationSite.Node {node} => node.index == maps[map.index].site.index _ => false }
    if !acquiredHere || !returnedHere { CompilerBug.panic(b"reference acquisition and result disagree with their physical producer") }
    if acquisition.index != target.index && acquired.role != EvaluationRole.Capture {
      CompilerBug.panic(b"implicit reference has no distinct acquisition occurrence")
    }
    let descriptor = run Skeleton.value(&mut self.*, acquisition, maps[map.index].target)
    let leaves = Vector<Leaf>.asSlice(&self.leaves)
    let mut at = usize.ZERO
    while at < leaves.length {
      if let SourceLeaf.Borrow {loan: previous, ..} = &leaves[at].kind {
        if previous == actualLoan { CompilerBug.panic(b"one borrow event was created by two producer routes") }
      }
      at = at + usize.ONE
    }
    let leaf = run Skeleton.leaf(&mut self.*, Leaf {kind: SourceLeaf.Borrow {loan: actualLoan, node: move node},
      origin: maps[map.index].origin, endpoint: maps[map.index].target})
    run Vector<Seed>.append(&mut self.seeds, Seed {value: descriptor, leaf: leaf,
      direct: true, active: active, stored: absent, alternatives: absent})
    // Neither Storage -> descriptor nor Value -> Referent copies old contents. The former
    // creates the descriptor above; the latter authenticates the source component for the
    // later residual/address product. A later use must observe reaching storage at that use.
    run Vector<ReferenceOrigin>.append(&mut self.references, ReferenceOrigin {leaf: leaf,
      source: source, descriptor: descriptor, map: map, referent: referent})
    if acquisition.index == target.index { return descriptor }
    let result = run Skeleton.value(&mut self.*, target, maps[map.index].target)
    // Same physical descriptor, published only if the enclosing expression completes. The
    // acquisition seed remains reachable independently of this later successful result.
    run Vector<Transfer>.append(&mut self.transfers, Transfer {source: descriptor, target: result,
      active: active, directness: Directness.Preserve, stored: absent, alternatives: absent,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), map: Option<MapId>.none(),
      direction: MapDirection.Forward, address: Option<EvalId>.none(), contract: Option<ContractRouteId>.none(),
      policy: TransferPolicy.Physical})
    return result
  }
}

// The family is a finite tree of actual inline component maps. Reject malformed cycles or
// duplicate ownership; do not turn them into a truncated/opaque source route.
effect fn transferFamily(endpoints: &[Endpoint], maps: &[SelectionMap], root: MapId) -> Vector<MapId>
! OutOfMemoryError ? &mut Allocator {
  if root.index >= maps.length { CompilerBug.panic(b"physical transfer has no prepared map") }
  let mut family = Vector<MapId>.make()
  run Vector<MapId>.append(&mut family, root)
  let mut next = usize.ZERO
  while next < Vector<MapId>.length(&family) {
    let index = Vector<MapId>.asSlice(&family)[next].index
    let map = &maps[index]
    if map.source.index >= endpoints.length || map.target.index >= endpoints.length {
      CompilerBug.panic(b"physical transfer map has an absent endpoint")
    }
    let children = Vector<MapId>.asSlice(&map.children)
    let mut child = usize.ZERO
    while child < children.length {
      let nested = children[child]
      if nested.index >= maps.length { CompilerBug.panic(b"physical transfer family has an absent child map") }
      let found = Vector<MapId>.asSlice(&family)
      let mut previous = usize.ZERO
      while previous < found.length {
        if found[previous].index == nested.index { CompilerBug.panic(b"physical transfer family repeats a child map") }
        previous = previous + usize.ONE
      }
      let inner = &maps[nested.index]
      if inner.source.index >= endpoints.length || inner.target.index >= endpoints.length
        || inner.site.index != map.site.index || inner.kind != map.kind {
        CompilerBug.panic(b"physical transfer child belongs to another operation")
      }
      let fromParent = match &endpoints[inner.source.index].parent {
        Option<EndpointId>.Some {value} => value.index == map.source.index
        _ => false
      }
      let toParent = match &endpoints[inner.target.index].parent {
        Option<EndpointId>.Some {value} => value.index == map.target.index
        _ => false
      }
      if !fromParent || !toParent { CompilerBug.panic(b"physical transfer child is not its paired inline component") }
      run Vector<MapId>.append(&mut family, nested)
      child = child + usize.ONE
    }
    next = next + usize.ONE
  }
  return move family
}

effect fn copyMapRoute(maps: &[MapId]) -> Vector<MapId> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector<MapId>.make()
  let mut at = usize.ZERO
  while at < maps.length {
    run Vector<MapId>.append(&mut copied, maps[at])
    at = at + usize.ONE
  }
  return move copied
}

// Descendant identity within one frozen component tree; never a comparison of types or
// region sets. Aliases supplied here were already restricted to actual inline storage.
fn componentWithin(endpoints: &[Endpoint], candidate: EndpointId, root: EndpointId) -> bool {
  let mut current = candidate
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if current.index == root.index { return true }
    if current.index >= endpoints.length { CompilerBug.panic(b"storage component is absent") }
    match endpoints[current.index].parent {
      Option<EndpointId>.Some {value} => { current = value }
      Option<EndpointId>.None => { return false }
    }
    remaining = remaining - usize.ONE
  }
  return CompilerBug.panic(b"storage component ancestry is cyclic")
}

fn endpointRole(endpoint: &Endpoint) -> Option<EndpointRole> {
  return match &endpoint.root {
    Root.Local {role, ..} => Option<EndpointRole>.some(role)
    Root.Node {role, ..} => Option<EndpointRole>.some(role)
    _ => Option<EndpointRole>.none()
  }
}

fn validateReferenceMaps(endpoints: &[Endpoint], maps: &[SelectionMap], descriptor: MapId, referent: MapId) -> () {
  if descriptor.index >= maps.length || referent.index >= maps.length {
    CompilerBug.panic(b"producer-created reference has an absent map")
  }
  let created = &maps[descriptor.index]
  let carried = &maps[referent.index]
  if created.source.index >= endpoints.length || created.target.index >= endpoints.length
    || carried.source.index >= endpoints.length || carried.target.index >= endpoints.length {
    CompilerBug.panic(b"producer-created reference has an absent endpoint")
  }
  if created.site.index != carried.site.index || Vector<MapId>.length(&created.children) != usize.ZERO {
    CompilerBug.panic(b"reference creation and its referent are not one producer operation")
  }
  let storage = match move endpointRole(&endpoints[created.source.index]) {
    Option<EndpointRole>.Some {value} => value == EndpointRole.Storage
    _ => false
  }
  let value = match move endpointRole(&endpoints[carried.source.index]) {
    Option<EndpointRole>.Some {value} => value == EndpointRole.Value
    _ => false
  }
  let paired = match &endpoints[carried.target.index].parent {
    Option<EndpointId>.Some {value: parent} => parent.index == created.target.index
    _ => false
  }
  let through = match &endpoints[carried.target.index].selector { Selector.Referent => true _ => false }
  if !storage || !value || !paired || !through
    || !sameSourceComponent(endpoints, created.source, carried.source) {
    CompilerBug.panic(b"reference map must create a descriptor and separately carry its referent")
  }
  return ()
}

// Storage and Value roots for the same authored component differ in role, never in source
// identity. This validates the supplied pair; it does not search for or construct a map.
fn sameSourceComponent(endpoints: &[Endpoint], storage: EndpointId, value: EndpointId) -> bool {
  let mut left = storage
  let mut right = value
  let mut remaining = endpoints.length
  while remaining > usize.ZERO {
    if left.index >= endpoints.length || right.index >= endpoints.length { return false }
    let a = &endpoints[left.index]
    let b = &endpoints[right.index]
    if !sameSelector(&a.selector, &b.selector) { return false }
    match &a.parent {
      Option<EndpointId>.Some {value: parent} => {
        if let Option<EndpointId>.Some {value: other} = &b.parent {
          left = parent
          right = other
        } else { return false }
      }
      Option<EndpointId>.None => {
        if let Option<EndpointId>.Some {..} = &b.parent { return false }
        return match &a.root {
          Root.Node {node, ..} => match &b.root {
            Root.Node {node: other, ..} => node.index == other.index
            _ => false
          }
          Root.Local {local, ..} => match &b.root {
            Root.Local {local: other, ..} => local.index == other.index
            _ => false
          }
          _ => false
        }
      }
    }
    remaining = remaining - usize.ONE
  }
  CompilerBug.panic(b"prepared component ancestry is cyclic")
}

pub fn sameSelector(left: &Selector, right: &Selector) -> bool {
  return match &left.* {
    Selector.Member {declaration, member, payload} => match &right.* {
      Selector.Member {declaration: other, member: selected, payload: field} =>
        DeclarationId.equals(&DeclarationId.copyShared(&declaration), &DeclarationId.copyShared(&other))
          && member == selected && payload == field
      _ => false
    }
    Selector.Field {ordinal} => match &right.* { Selector.Field {ordinal: other} => ordinal == other _ => false }
    Selector.Variant {ordinal} => match &right.* { Selector.Variant {ordinal: other} => ordinal == other _ => false }
    Selector.Index {class: IndexClass.Exact {index}} => match &right.* {
      Selector.Index {class: IndexClass.Exact {index: other}} => index == other
      _ => false
    }
    Selector.Index {class: IndexClass.Remainder} => match &right.* { Selector.Index {class: IndexClass.Remainder} => true _ => false }
    Selector.Referent => match &right.* { Selector.Referent => true _ => false }
    Selector.EffectSuccess => match &right.* { Selector.EffectSuccess => true _ => false }
    Selector.EffectFailure => match &right.* { Selector.EffectFailure => true _ => false }
    Selector.Identity => match &right.* { Selector.Identity => true _ => false }
    Selector.Opaque => match &right.* { Selector.Opaque => true _ => false }
  }
}

fn findCell(keys: &[CellKey], value: ValueId, leaf: LeafId, witness: usize, direct: bool) -> usize {
  let mut at = usize.ZERO
  while at < keys.length {
    let key = keys[at]
    if key.value.index == value.index && key.leaf.index == leaf.index && key.witness == witness && key.direct == direct { return at }
    at = at + usize.ONE
  }
  return usize.MAX
}

/// Complete physical storage transfers are created from the same relation used by ownership
/// projection. No creation-order source classifier or historical loan list participates here.
/// The definition/read numbers index explicit records, not inferred source ordering.
fn validateStorage(maps: &[SelectionMap], reaching: &Reaching, storage: &[Storage],
  stored: &[DefinedValue], readValues: &[ReadValue], values: &[Value], evaluations: &[Evaluation]) -> () {
  let definitions = Vector<Definition>.asSlice(&reaching.definitions)
  let reads = Vector<Read>.asSlice(&reaching.reads)
  if stored.length != definitions.length || readValues.length != reads.length {
    CompilerBug.panic(b"source storage reservation omitted a definition or read value")
  }
  let mut at = usize.ZERO
  while at < stored.length {
    let actual = stored[at]
    if actual.definition.index != at || actual.value.index >= values.length {
      CompilerBug.panic(b"source storage definition identity is invalid")
    }
    let value = values[actual.value.index]
    if value.evaluation.index >= evaluations.length || definitions[at].component.index >= storage.length || value.endpoint.index != storage[definitions[at].component.index].endpoint.index {
      CompilerBug.panic(b"source storage definition value has a different component")
    }
    if evaluations[value.evaluation.index].point.index != definitions[at].point.index {
      CompilerBug.panic(b"source storage definition value has a different evaluation point")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < readValues.length {
    let actual = readValues[at]
    if actual.read.index != at || actual.value.index >= values.length {
      CompilerBug.panic(b"source storage read identity is invalid")
    }
    let value = values[actual.value.index]
    if value.evaluation.index >= evaluations.length { CompilerBug.panic(b"source storage read has no evaluation") }
    if reads[at].component.index >= storage.length || !sameStorage(actual.storage, storage[reads[at].component.index]) {
      CompilerBug.panic(b"source storage read substituted another canonical owner occurrence")
    }
    match actual.map {
      Option<MapId>.Some {value: selected} => {
        if selected.index >= maps.length { CompilerBug.panic(b"source storage read has no prepared map") }
        let map = &maps[selected.index]
        if reads[at].component.index >= storage.length || map.source.index != storage[reads[at].component.index].endpoint.index || map.target.index != value.endpoint.index {
          CompilerBug.panic(b"source storage read map does not name its actual endpoints")
        }
      }
      Option<MapId>.None => {
        if reads[at].component.index >= storage.length || storage[reads[at].component.index].endpoint.index != value.endpoint.index {
          CompilerBug.panic(b"an identity storage read changed its physical component")
        }
      }
    }
    if evaluations[value.evaluation.index].point.index != reads[at].point.index {
      CompilerBug.panic(b"source storage read value has a different evaluation point")
    }
    at = at + usize.ONE
  }
  return ()
}

effect fn storageTransfers(pairs: &[Pair], first: usize, stored: &[DefinedValue], readValues: &[ReadValue],
  transfers: &mut Vector<Transfer>, rules: &mut Program) -> () ! OutOfMemoryError ? &mut Allocator {
  // Copying a descriptor adds no loss itself. Loss already present at the definition travels
  // along the value path; observation of a later loan-wide loss does not rewrite this copy.
  let noLoss = Program.atom(&mut rules.*)
  let mut at = first
  while at < pairs.length {
    let pair = pairs[at]
    if pair.definition.index >= stored.length || pair.read.index >= readValues.length {
      CompilerBug.panic(b"source pair lacks its actual stored/read value")
    }
    let source = stored[pair.definition.index]
    let target = readValues[pair.read.index]
    run Vector<Transfer>.append(&mut transfers.*, Transfer {direction: MapDirection.Forward, address: Option<EvalId>.none(), source: source.value, target: target.value,
      active: pair.active, directness: Directness.Preserve, stored: noLoss, alternatives: noLoss,
      definition: Option<DefinitionId>.some(pair.definition), read: Option<ReadId>.some(pair.read),
      map: target.map, contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Physical})
    at = at + usize.ONE
  }
  return ()
}

/// Missing supported routes are internal construction failures even when their inputs happen
/// to be absent in this solution. Validate before source closure, never by selected outcomes.
fn validateAuthoredBorrow<'body>(preparation: &SourcePreparation<'body>, borrowed: &Prepared.Borrow) -> () {
  let nodes = preparation.body.nodes
  let endpoints = Vector<Endpoint>.asSlice(&preparation.endpoints)
  let maps = Vector<SelectionMap>.asSlice(&preparation.maps)
  if borrowed.site.index >= nodes.length { CompilerBug.panic(b"prepared borrow has no actual node") }
  let operand = match &nodes[borrowed.site.index].kind {
    NodeKind.Expression {form: Expression.Borrow {value, ..}, ..} => value
    _ => { return CompilerBug.panic(b"prepared authored borrow is not a typed Borrow node") }
  }
  validateReferenceMaps(endpoints, maps, borrowed.map, borrowed.referent)
  let descriptor = &maps[borrowed.map.index]
  if descriptor.site.index != borrowed.site.index || !nodeValueEndpoint(&endpoints[descriptor.target.index], borrowed.site) {
    CompilerBug.panic(b"authored borrow map belongs to another descriptor occurrence")
  }
  let actual = match &endpoints[descriptor.source.index].root {
    Root.Node {node, role} => node.index == operand.index && role == EndpointRole.Storage
    _ => false
  }
  let whole = match endpoints[descriptor.source.index].parent { Option<EndpointId>.None => true _ => false }
  if !actual || !whole { CompilerBug.panic(b"authored borrow map does not name its actual operand storage root") }
  return ()
}

// Prepared operations name physical transfer families explicitly. In particular, preparing an
// Effect references Construction's placement; it is not a second execution of that placement.
// Validate before reservation, even for a currently unreachable operation. A malformed package
// is a compiler construction defect, not source uncertainty that can become a successful gap.
effect fn validatePreparedOperations<'body>(preparation: &SourcePreparation<'body>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let constructions = Vector<Prepared.Construction>.asSlice(&preparation.constructions)
  let operations = Vector<Prepared.Operation>.asSlice(&preparation.operations)
  let applications = Vector<Prepared.Application>.asSlice(&preparation.applications)
  let endpoints = Vector<Endpoint>.asSlice(&preparation.endpoints)
  let maps = Vector<SelectionMap>.asSlice(&preparation.maps)
  let borrows = Vector<Prepared.Borrow>.asSlice(&preparation.borrows)
  let mut at = usize.ZERO
  while at < borrows.length {
    validateAuthoredBorrow(preparation, &borrows[at])
    drop run transferFamily(endpoints, maps, borrows[at].referent)
    let mut earlier = usize.ZERO
    while earlier < at {
      if borrows[earlier].site.index == borrows[at].site.index { CompilerBug.panic(b"authored borrow has duplicate physical records") }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < preparation.body.nodes.length {
    if let NodeKind.Expression {form: Expression.Borrow {..}, ..} = &preparation.body.nodes[at].kind {
      let mut found = false
      let mut each = usize.ZERO
      while each < borrows.length {
        found = found || borrows[each].site.index == at
        each = each + usize.ONE
      }
      if !found { CompilerBug.panic(b"typed Borrow is missing its prepared physical map pair") }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < constructions.length {
    let construction = &constructions[at]
    if construction.site.index >= preparation.body.nodes.length || construction.application.index >= applications.length {
      CompilerBug.panic(b"source construction has no actual site or representation application")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if constructions[earlier].site.index == construction.site.index {
        CompilerBug.panic(b"one physical construction has duplicate preparation records")
      }
      earlier = earlier + usize.ONE
    }
    let inputs = Vector<InputRoute>.asSlice(&construction.inputs)
    let mut input = usize.ZERO
    while input < inputs.length {
      run validatePreparedInput(preparation, construction.site, &inputs[input])
      let target = maps[inputs[input].map.index].target
      if !nodeValueEndpoint(&endpoints[target.index], construction.site) {
        CompilerBug.panic(b"construction placement does not target its actual descriptor")
      }
      earlier = usize.ZERO
      while earlier < input {
        if inputs[earlier].map.index == inputs[input].map.index {
          CompilerBug.panic(b"physical capture placement was duplicated as another input")
        }
        earlier = earlier + usize.ONE
      }
      input = input + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < operations.length {
    let operation = &operations[at]
    if operation.site.index >= preparation.body.nodes.length {
      CompilerBug.panic(b"source operation has no actual body site")
    }
    let mut earlier = usize.ZERO
    while earlier < at {
      if operations[earlier].site.index == operation.site.index {
        CompilerBug.panic(b"one physical operation has duplicate preparation records")
      }
      earlier = earlier + usize.ONE
    }
    if let Option<ApplicationId>.Some {value} = operation.application {
      if value.index >= applications.length { CompilerBug.panic(b"source operation has no selected application") }
    }
    if let Option<EndpointId>.Some {value} = operation.receiver {
      if value.index >= endpoints.length { CompilerBug.panic(b"source operation has no actual receiver endpoint") }
    }
    let inputs = Vector<InputRoute>.asSlice(&operation.inputs)
    let mut input = usize.ZERO
    while input < inputs.length {
      run validatePreparedInput(preparation, operation.site, &inputs[input])
      input = input + usize.ONE
    }
    if operation.phase == Prepared.OperationPhase.PrepareEffect {
      if let Option<MapId>.Some {..} = operation.result {
        CompilerBug.panic(b"Effect preparation cannot publish an executed success result")
      }
      let mut found = usize.MAX
      let mut construction = usize.ZERO
      while construction < constructions.length {
        if constructions[construction].site.index == operation.site.index { found = construction }
        construction = construction + usize.ONE
      }
      if found == usize.MAX { CompilerBug.panic(b"Effect preparation has no owning physical construction") }
      let captures = Vector<InputRoute>.asSlice(&constructions[found].inputs)
      if captures.length != inputs.length { CompilerBug.panic(b"Effect preparation changed its physical input count") }
      input = usize.ZERO
      while input < inputs.length {
        if !sameInputRoute(&inputs[input], &captures[input]) {
          CompilerBug.panic(b"Effect preparation must reference its construction's exact paired input routes")
        }
        input = input + usize.ONE
      }
    } else {
      let result = match operation.result {
        Option<MapId>.Some {value} => value
        _ => { return CompilerBug.panic(b"executing operation has no exact result family") }
      }
      drop run transferFamily(endpoints, maps, result)
      let output = &maps[result.index]
      if output.site.index != operation.site.index || output.kind != MapKind.Contract
        || !nodeValueEndpoint(&endpoints[output.target.index], operation.site) {
        CompilerBug.panic(b"operation result is not its selected contract-to-result family")
      }
      if operation.phase == Prepared.OperationPhase.Invoke {
        let application = match operation.application {
          Option<ApplicationId>.Some {value} => value
          _ => { return CompilerBug.panic(b"invocation has no exact selected application") }
        }
        let selectedResult = match &endpoints[output.source.index].root {
          Root.Application {application: selected, port, space, ..} => selected.index == application.index
            && port == Prepared.ContractPort.Result && space == Prepared.TypeSpace.Applied
          _ => false
        }
        if !selectedResult {
          CompilerBug.panic(b"invocation result does not belong to its exact applied original contract")
        }
      }
      if operation.phase == Prepared.OperationPhase.ExecuteEffect {
        if let Option<ApplicationId>.Some {..} = operation.application {
          CompilerBug.panic(b"stored Run cannot substitute a type-selected application for reaching descriptors")
        }
        let receiver = match operation.receiver {
          Option<EndpointId>.Some {value} => value
          _ => { return CompilerBug.panic(b"stored Run has no actual descriptor receiver") }
        }
        let success = &endpoints[output.source.index]
        let paired = match success.parent {
          Option<EndpointId>.Some {value} => value.index == receiver.index
          _ => false
        }
        let selectedSuccess = match &success.selector { Selector.EffectSuccess => true _ => false }
        if !paired || !selectedSuccess { CompilerBug.panic(b"Run result must start at its actual receiver's success port") }
      }
    }
    at = at + usize.ONE
  }
  return ()
}

fn nodeValueEndpoint(endpoint: &Endpoint, site: NodeId) -> bool {
  return match &endpoint.root {
    Root.Node {node, role} => node.index == site.index && role == EndpointRole.Value
    _ => false
  }
}

effect fn validatePreparedInput<'body>(preparation: &SourcePreparation<'body>, site: NodeId, input: &InputRoute) -> ()
! OutOfMemoryError ? &mut Allocator {
  let endpoints = Vector<Endpoint>.asSlice(&preparation.endpoints)
  let maps = Vector<SelectionMap>.asSlice(&preparation.maps)
  drop run transferFamily(endpoints, maps, input.map)
  let map = &maps[input.map.index]
  let operand = inputOperand(preparation, site, input.read)
  let physical = match &endpoints[map.source.index].root {
    Root.Node {node, ..} => node.index == operand.index
    _ => false
  }
  if !physical { CompilerBug.panic(b"prepared input map does not start at its selected actual operand") }
  if map.site.index != site.index || map.kind == MapKind.Contract
    || input.selected.index >= endpoints.length || input.original.index >= endpoints.length {
    CompilerBug.panic(b"operation input lacks its physical and declaration endpoint pair")
  }
  let selected = match &endpoints[input.selected.index].root {
    Root.Application {application, space, ..} => application.index < Vector<Prepared.Application>.length(&preparation.applications)
      && space == Prepared.TypeSpace.Selected
    _ => false
  }
  let original = match &endpoints[input.original.index].root {
    Root.Application {application, space, ..} => application.index < Vector<Prepared.Application>.length(&preparation.applications)
      && space == Prepared.TypeSpace.Original
    _ => false
  }
  if !selected || !original { CompilerBug.panic(b"input correspondence lost its distinct selected and original owner spaces") }
  let borrows = input.transport == Transport.BorrowShared || input.transport == Transport.BorrowMutable
  match input.referent {
    Option<MapId>.Some {value} => {
      if !borrows { CompilerBug.panic(b"value transport has a fabricated reference-creation route") }
      drop run transferFamily(endpoints, maps, value)
      validateReferenceMaps(endpoints, maps, input.map, value)
    }
    Option<MapId>.None => {
      if borrows { CompilerBug.panic(b"created reference is missing its paired referent route") }
    }
  }
  return ()
}

/// Select an authored operand coordinate, never a last evaluation of an equal NodeId.
pub fn inputOperand<'body>(preparation: &SourcePreparation<'body>, site: NodeId, read: InputRead) -> NodeId {
  if site.index >= preparation.body.nodes.length { return CompilerBug.panic(b"prepared input has no typed operation") }
  let form = match &preparation.body.nodes[site.index].kind {
    NodeKind.Expression {form, ..} => &form
    _ => return CompilerBug.panic(b"prepared input does not belong to an expression")
  }
  return match read {
    InputRead.Argument {ordinal} => {
      let arguments = match &form.* {
        Expression.DirectCall {arguments, ..} => Vector<NodeId>.asSlice(&arguments)
        Expression.InterfaceCall {arguments, ..} => Vector<NodeId>.asSlice(&arguments)
        Expression.CallableCall {arguments, ..} => Vector<NodeId>.asSlice(&arguments)
        Expression.StagedCallable {arguments, ..} => Vector<NodeId>.asSlice(&arguments)
        _ => return CompilerBug.panic(b"prepared argument selector has no actual argument vector")
      }
      if ordinal >= arguments.length { return CompilerBug.panic(b"prepared argument selector is out of bounds") }
      return arguments[ordinal]
    }
    InputRead.Receiver => match &form.* {
      Expression.CallableCall {callee, ..} => callee
      Expression.StagedCallable {callee, ..} => callee
      _ => return CompilerBug.panic(b"prepared receiver selector has no actual callee")
    }
    InputRead.Field {ordinal} => {
      let fields = match &form.* {
        Expression.Aggregate {fields, ..} => Vector<AggregateField>.asSlice(&fields)
        Expression.Callable {fields, ..} => Vector<AggregateField>.asSlice(&fields)
        _ => return CompilerBug.panic(b"prepared field selector has no actual capture vector")
      }
      if ordinal >= fields.length { return CompilerBug.panic(b"prepared field selector is out of bounds") }
      return fields[ordinal].value
    }
  }
}

pub fn sameInputRead(left: InputRead, right: InputRead) -> bool {
  return match left {
    InputRead.Argument {ordinal} => match right { InputRead.Argument {ordinal: other} => ordinal == other _ => false }
    InputRead.Receiver => match right { InputRead.Receiver => true _ => false }
    InputRead.Field {ordinal} => match right { InputRead.Field {ordinal: other} => ordinal == other _ => false }
  }
}

fn sameInputRoute(left: &InputRoute, right: &InputRoute) -> bool {
  if left.map.index != right.map.index || left.selected.index != right.selected.index
    || left.original.index != right.original.index || left.transport != right.transport
    || !sameInputRead(left.read, right.read) { return false }
  return match left.referent {
    Option<MapId>.Some {value} => match right.referent {
      Option<MapId>.Some {value: other} => value.index == other.index
      _ => false
    }
    Option<MapId>.None => match right.referent { Option<MapId>.None => true _ => false }
  }
}

fn validateReservation<'body>(preparation: &SourcePreparation<'body>, reaching: &Reaching,
  evaluations: &[Evaluation], values: &[Value], leaves: &[Leaf], seeds: &[Seed], transfers: &[Transfer], aliases: &[StorageAlias], storage: &[Storage]) -> () {
  let endpoints = Vector<Endpoint>.asSlice(&preparation.endpoints)
  let points = Vector<Point>.asSlice(&reaching.points)
  let nodes = preparation.body.nodes
  let mut component = usize.ZERO
  while component < storage.length {
    let stored = storage[component]
    if stored.endpoint.index >= endpoints.length { CompilerBug.panic(b"canonical source storage lacks a prepared endpoint") }
    let valid = match stored.temporary {
      Option<EvalId>.Some {value} => {
        if value.index >= evaluations.length { CompilerBug.panic(b"temporary source storage has no actual owner evaluation") }
        match evaluations[value.index].site {
          EvaluationSite.Node {node: actual} => match &endpoints[stored.endpoint.index].root {
            Root.Node {node, role} => actual.index == node.index && role == EndpointRole.Storage
            _ => false
          }
          _ => false
        }
      }
      Option<EvalId>.None => match &endpoints[stored.endpoint.index].root { Root.Local {role, ..} => role == EndpointRole.Storage _ => false }
    }
    if !valid { CompilerBug.panic(b"canonical source storage substituted another owner or occurrence") }
    component = component + usize.ONE
  }
  let mut at = usize.ZERO
  while at < evaluations.length {
    let evaluation = evaluations[at]
    if evaluation.point.index >= points.length { CompilerBug.panic(b"source evaluation has no reserved CFG point") }
    match evaluation.site {
      EvaluationSite.Node {node} => {
        if node.index >= nodes.length || evaluation.role == EvaluationRole.Entry {
          CompilerBug.panic(b"source evaluation does not name its actual body node")
        }
      }
      EvaluationSite.Entry {local} => {
        if local.index >= preparation.body.locals.length || evaluation.role != EvaluationRole.Entry {
          CompilerBug.panic(b"source entry does not name actual initialized storage")
        }
        let mut node = usize.ZERO
        while node < nodes.length {
          let binding = match &nodes[node].kind {
            NodeKind.LocalBinding {local: bound, ..} => bound.index == local.index
            NodeKind.MutableBinding {local: bound, ..} => bound.index == local.index
            _ => false
          }
          if binding { CompilerBug.panic(b"a later local binding was fabricated as source entry storage") }
          node = node + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < values.length {
    if values[at].evaluation.index >= evaluations.length || values[at].endpoint.index >= endpoints.length {
      CompilerBug.panic(b"source value has no actual evaluation or prepared endpoint")
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < leaves.length {
    if leaves[at].endpoint.index >= endpoints.length { CompilerBug.panic(b"source leaf has no prepared endpoint") }
    let valid = match &leaves[at].kind {
      SourceLeaf.Entry {local} => local.index < preparation.body.locals.length
      SourceLeaf.Borrow {node: Option<NodeId>.Some {value}, ..} => value.index < nodes.length
      SourceLeaf.Borrow {node: Option<NodeId>.None, ..} => true
      SourceLeaf.Expression {node} => node.index < nodes.length
      SourceLeaf.LoanFree {node} => node.index < nodes.length
      SourceLeaf.Unknown {node: Option<NodeId>.Some {value}, ..} => value.index < nodes.length
      SourceLeaf.Unknown {node: Option<NodeId>.None, ..} => true
    }
    if !valid { CompilerBug.panic(b"source leaf names an absent body origin") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < seeds.length {
    let seed = seeds[at]
    if seed.value.index >= values.length || seed.leaf.index >= leaves.length {
      CompilerBug.panic(b"source seed has no reserved value or leaf")
    }
    if values[seed.value.index].endpoint.index != leaves[seed.leaf.index].endpoint.index {
      CompilerBug.panic(b"source seed bypasses its physical placement map")
    }
    if let SourceLeaf.Entry {local} = &leaves[seed.leaf.index].kind {
      let actual = evaluations[values[seed.value.index].evaluation.index]
      let valid = match actual.site {
        EvaluationSite.Entry {local: bound} => bound.index == local.index
        _ => false
      }
      if !valid { CompilerBug.panic(b"caller source seed did not originate in actual entry storage") }
    }
    at = at + usize.ONE
  }
  let maps = Vector<SelectionMap>.asSlice(&preparation.maps)
  let routes = Vector<ContractRoute>.asSlice(&preparation.routes)
  at = usize.ZERO
  while at < transfers.length {
    let transfer = &transfers[at]
    if transfer.source.index >= values.length || transfer.target.index >= values.length {
      CompilerBug.panic(b"source transfer has no reserved physical value")
    }
    let source = values[transfer.source.index].endpoint
    let target = values[transfer.target.index].endpoint
    match transfer.map {
      Option<MapId>.Some {value} => {
        if value.index >= maps.length { CompilerBug.panic(b"source transfer has no prepared physical map") }
        let physical = &maps[value.index]
        let forward = transfer.direction == MapDirection.Forward
        let mut matches = physical.source.index == source.index && physical.target.index == target.index
        if !forward { matches = physical.target.index == source.index && physical.source.index == target.index }
        if !matches { CompilerBug.panic(b"source transfer does not follow its prepared physical endpoints") }
        match transfer.address {
          Option<EvalId>.Some {value: address} => validateAddressMap(endpoints, maps, aliases, value, address)
          Option<EvalId>.None => {
            if !forward || physical.addressTransport { CompilerBug.panic(b"source address map has no actual storage-identity evidence") }
          }
        }
      }
      Option<MapId>.None => {
        if source.index != target.index { CompilerBug.panic(b"distinct source endpoints require a prepared map") }
        if transfer.direction != MapDirection.Forward { CompilerBug.panic(b"unmapped source transfer cannot invert an address") }
        if let Option<EvalId>.Some {..} = transfer.address { CompilerBug.panic(b"address evidence requires its actual map") }
      }
    }
    if let Option<ContractRouteId>.Some {value} = transfer.contract {
      if value.index >= routes.length { CompilerBug.panic(b"source transfer has no original contract route") }
    }
    at = at + usize.ONE
  }
  return ()
}

// Frozen residual rows are not source witnesses. Validate the paired finite automaton before
// following any actual value edge, including unreachable ones: a same-shaped sibling must not
// be substituted for the producer's recorded continuation, and descendants are not new roots.
fn residualAccess(shape: &Prepared.Shape) -> Option<ReferenceAccess> {
  return Shared<Type>.with<Option<ReferenceAccess>>(&shape.ty, fn(ty: &Type) -> Option<ReferenceAccess> {
    return match &ty.* {
      Type.Reference {access, ..} => Option<ReferenceAccess>.some(access)
      Type.Slice {access, ..} => Option<ReferenceAccess>.some(access)
      Type.Pointer {access, ..} => Option<ReferenceAccess>.some(access)
      _ => Option<ReferenceAccess>.none()
    }
  })
}

fn sameResidualAccess(left: Option<ReferenceAccess>, right: Option<ReferenceAccess>) -> bool {
  return match left {
    Option<ReferenceAccess>.Some {value} => match right { Option<ReferenceAccess>.Some {value: other} => value == other _ => false }
    Option<ReferenceAccess>.None => match right { Option<ReferenceAccess>.None => true _ => false }
  }
}

fn residualComponent(shapes: &[Prepared.Shape], id: Prepared.ComponentId) -> &Prepared.Component {
  if id.shape.index >= shapes.length { return CompilerBug.panic(b"residual component has no frozen parent shape") }
  let components = Vector<Prepared.Component>.asSlice(&shapes[id.shape.index].components)
  if id.ordinal >= components.length { return CompilerBug.panic(b"residual component has no exact parent row") }
  return &components[id.ordinal]
}

fn sameResidualComponent(left: Prepared.ComponentId, right: Prepared.ComponentId) -> bool {
  return left.shape.index == right.shape.index && left.ordinal == right.ordinal
}

fn containsResidual(ids: &[Prepared.ResidualStateId], id: Prepared.ResidualStateId) -> bool {
  let mut at = usize.ZERO
  while at < ids.length {
    if ids[at].index == id.index { return true }
    at = at + usize.ONE
  }
  return false
}

fn validateResiduals<'body>(prepared: &SourcePreparation<'body>) -> () {
  let shapes = Vector<Prepared.Shape>.asSlice(&prepared.shapes)
  let endpoints = Vector<Endpoint>.asSlice(&prepared.endpoints)
  let selections = Vector<Selection>.asSlice(&prepared.selections)
  let maps = Vector<SelectionMap>.asSlice(&prepared.maps)
  let states = Vector<Prepared.ResidualState>.asSlice(&prepared.residuals)
  let pairs = Vector<Prepared.BoundaryTransition>.asSlice(&prepared.boundaryTransitions)
  let substitutions = Vector<Prepared.BoundarySubstitution>.asSlice(&prepared.boundarySubstitutions)
  let mut at = usize.ZERO
  while at < states.length {
    let state = &states[at]
    if state.selection.index >= selections.length || state.vertex.index >= endpoints.length || state.output.index >= shapes.length {
      CompilerBug.panic(b"residual state is outside its frozen selection domain")
    }
    let component = residualComponent(shapes, state.input)
    if !sameSelector(&component.selector, &endpoints[state.vertex.index].selector) {
      CompilerBug.panic(b"residual state changed its original selector vertex")
    }
    let selection = &selections[state.selection.index]
    let accepted = Vector<EndpointId>.asSlice(&selection.accepts)
    let mut accepts = false
    let mut each = usize.ZERO
    while each < accepted.length {
      if accepted[each].index == state.vertex.index { accepts = true }
      each = each + usize.ONE
    }
    if accepts != state.accepts { CompilerBug.panic(b"residual acceptance changed the original selection frontier") }
    let next = Vector<Prepared.ResidualStateId>.asSlice(&state.next)
    let edges = Vector<MapId>.asSlice(&selection.maps)
    each = usize.ZERO
    while each < next.length {
      if next[each].index >= states.length { CompilerBug.panic(b"residual continuation is outside its finite domain") }
      let child = &states[next[each].index]
      if child.selection.index != state.selection.index || child.input.shape.index != state.output.index {
        CompilerBug.panic(b"residual continuation changed selection or component output")
      }
      let mut found = false
      let mut edge = usize.ZERO
      while edge < edges.length {
        if edges[edge].index >= maps.length { CompilerBug.panic(b"residual selection names an absent map") }
        let physical = &maps[edges[edge].index]
        if physical.kind == MapKind.Select && physical.source.index == state.vertex.index
          && physical.target.index == child.vertex.index { found = true }
        edge = edge + usize.ONE
      }
      if !found { CompilerBug.panic(b"residual continuation has no original selector edge") }
      each = each + usize.ONE
    }
    if !state.accepts && next.length == usize.ZERO { CompilerBug.panic(b"residual selection lost every accepting continuation") }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < pairs.length {
    let pair = &pairs[at]
    if pair.map.index >= maps.length || pair.sourceState.index >= states.length || pair.targetState.index >= states.length
      || pair.substitution.index >= substitutions.length { CompilerBug.panic(b"residual pair is outside its frozen domain") }
    let physical = &maps[pair.map.index]
    if physical.source.index >= endpoints.length || physical.target.index >= endpoints.length {
      CompilerBug.panic(b"residual transport lost its physical endpoints")
    }
    let physicalAuthority = physical.componentTransport && !physical.addressTransport
      && (physical.kind == MapKind.Copy || physical.kind == MapKind.Place)
      && pair.authority == Prepared.BoundaryAuthority.Physical
    let sourceStorage = match move endpointRole(&endpoints[physical.source.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
    let targetStorage = match move endpointRole(&endpoints[physical.target.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
    let aliasAuthority = physical.addressTransport && !physical.componentTransport && physical.kind == MapKind.Select
      && sourceStorage && targetStorage && pair.authority == Prepared.BoundaryAuthority.StorageAlias
    if (!physicalAuthority && !aliasAuthority) || !sameSelector(&physical.selector, &Selector.Identity) {
      CompilerBug.panic(b"residual pair lacks its exact physical or storage-alias authority")
    }
    let source = &states[pair.sourceState.index]
    let target = &states[pair.targetState.index]
    if !sameResidualComponent(pair.source, source.input) || !sameResidualComponent(pair.target, target.input)
      || source.selection.index != target.selection.index || source.vertex.index != target.vertex.index
      || source.accepts != target.accepts {
      CompilerBug.panic(b"residual pair combines different selector histories")
    }
    let left = residualComponent(shapes, pair.source)
    let right = residualComponent(shapes, pair.target)
    if !sameSelector(&left.selector, &right.selector)
      || !sameResidualAccess(pair.sourceAccess, residualAccess(&shapes[pair.source.shape.index]))
      || !sameResidualAccess(pair.targetAccess, residualAccess(&shapes[pair.target.shape.index])) {
      CompilerBug.panic(b"residual pair lost its component or descriptor access evidence")
    }
    let substitution = &substitutions[pair.substitution.index]
    if substitution.source.index != source.output.index || substitution.target.index != target.output.index {
      CompilerBug.panic(b"residual substitution must describe component outputs, not parent descriptors")
    }
    let sourceNext = Vector<Prepared.ResidualStateId>.asSlice(&source.next)
    let targetNext = Vector<Prepared.ResidualStateId>.asSlice(&target.next)
    let next = Vector<Prepared.BoundaryTransitionId>.asSlice(&pair.next)
    if next.length != sourceNext.length || next.length != targetNext.length {
      CompilerBug.panic(b"residual pair omitted or multiplied a continuation")
    }
    let mut each = usize.ZERO
    while each < next.length {
      if next[each].index >= pairs.length { CompilerBug.panic(b"residual pair has an absent continuation") }
      let child = &pairs[next[each].index]
      if child.map.index != pair.map.index || child.authority != pair.authority || !containsResidual(sourceNext, child.sourceState)
        || !containsResidual(targetNext, child.targetState) {
        CompilerBug.panic(b"residual continuation does not follow both sides of the same map")
      }
      // A child is already an explicitly paired transition, not a Cartesian combination of
      // otherwise valid source/target successors. Each side must occur exactly once here.
      let mut earlier = usize.ZERO
      while earlier < each {
        let prior = &pairs[next[earlier].index]
        if prior.sourceState.index == child.sourceState.index || prior.targetState.index == child.targetState.index {
          CompilerBug.panic(b"residual pairing duplicated one side of a continuation")
        }
        earlier = earlier + usize.ONE
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < maps.length {
    let physical = &maps[at]
    let roots = Vector<Prepared.BoundaryTransitionId>.asSlice(&physical.boundaries)
    let mut each = usize.ZERO
    while each < roots.length {
      if roots[each].index >= pairs.length || physical.source.index >= endpoints.length || physical.target.index >= endpoints.length {
        CompilerBug.panic(b"residual root has no physical map endpoints")
      }
      let root = &pairs[roots[each].index]
      if root.map.index != at || root.source.shape.index != endpoints[physical.source.index].shape.index
        || root.target.shape.index != endpoints[physical.target.index].shape.index {
        CompilerBug.panic(b"residual root is not anchored at its actual transport endpoints")
      }
      each = each + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Reference construction is the sole authority for linking a Borrow leaf to physical
// operand storage. Equal reference types or equal regions cannot construct this record.
fn validateReferenceOrigins<'body>(prepared: &SourcePreparation<'body>, origins: &[ReferenceOrigin],
  evaluations: &[Evaluation], values: &[Value], leaves: &[Leaf]) -> () {
  let maps = Vector<SelectionMap>.asSlice(&prepared.maps)
  let endpoints = Vector<Endpoint>.asSlice(&prepared.endpoints)
  let mut at = usize.ZERO
  while at < origins.length {
    let origin = &origins[at]
    if origin.source.index >= evaluations.length || origin.descriptor.index >= values.length
      || origin.leaf.index >= leaves.length { CompilerBug.panic(b"reference origin lost its actual value occurrence") }
    validateReferenceMaps(endpoints, maps, origin.map, origin.referent)
    let descriptor = values[origin.descriptor.index]
    if descriptor.evaluation.index >= evaluations.length || descriptor.endpoint.index != maps[origin.map.index].target.index
      || leaves[origin.leaf.index].endpoint.index != descriptor.endpoint.index {
      CompilerBug.panic(b"reference origin lost its descriptor component")
    }
    let borrowed = match &leaves[origin.leaf.index].kind { SourceLeaf.Borrow {..} => true _ => false }
    if !borrowed { CompilerBug.panic(b"reference storage identity has no actual Borrow source") }
    let sourceNode = match evaluations[origin.source.index].site {
      EvaluationSite.Node {node} => node
      _ => { return CompilerBug.panic(b"reference origin is not an actual operand evaluation") }
    }
    let source = match &endpoints[maps[origin.map.index].source.index].root {
      Root.Node {node, role} => node.index == sourceNode.index && role == EndpointRole.Storage
      _ => false
    }
    let target = match evaluations[descriptor.evaluation.index].site {
      EvaluationSite.Node {node} => node.index == maps[origin.map.index].site.index
      _ => false
    }
    if !source || !target { CompilerBug.panic(b"reference origin does not match its physical preparation site") }
    let mut earlier = usize.ZERO
    while earlier < at {
      if origins[earlier].leaf.index == origin.leaf.index || origins[earlier].descriptor.index == origin.descriptor.index {
        CompilerBug.panic(b"one reference descriptor acquired two independent storage origins")
      }
      earlier = earlier + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// A prepared Select is not sufficient: it must belong to the exact place occurrence's
// contiguous canonical address route. Referent/contract/value maps cannot be inverted here.
fn validateAddressMap(endpoints: &[Endpoint], maps: &[SelectionMap], aliases: &[StorageAlias], map: MapId, address: EvalId) -> () {
  let physical = &maps[map.index]
  let source = match move endpointRole(&endpoints[physical.source.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
  let target = match move endpointRole(&endpoints[physical.target.index]) { Option<EndpointRole>.Some {value} => value == EndpointRole.Storage _ => false }
  if physical.kind != MapKind.Select || !source || !target { CompilerBug.panic(b"value/contract boundary is not storage identity") }
  let mut at = usize.ZERO
  while at < aliases.length {
    if aliases[at].evaluation.index == address.index {
      let route = Vector<MapId>.asSlice(&aliases[at].route)
      let mut current = aliases[at].storage.endpoint
      let mut found = false
      let mut step = usize.ZERO
      while step < route.length {
        if route[step].index >= maps.length || maps[route[step].index].source.index != current.index {
          CompilerBug.panic(b"storage identity has a disconnected address route")
        }
        if route[step].index == map.index { found = true }
        current = maps[route[step].index].target
        step = step + usize.ONE
      }
      if current.index != aliases[at].endpoint.index { CompilerBug.panic(b"storage identity route ends at another place") }
      if found { return () }
    }
    at = at + usize.ONE
  }
  CompilerBug.panic(b"source address transport has no actual alias occurrence")
}

effect fn reserveCell(keys: &mut Vector<CellKey>, cells: &mut Vector<Cell>, rules: &mut Program, key: CellKey) -> usize
! OutOfMemoryError ? &mut Allocator {
  let existing = findCell(Vector<CellKey>.asSlice(&keys.*), key.value, key.leaf, key.witness, key.direct)
  if existing != usize.MAX { return existing }
  let at = Vector<CellKey>.length(&keys.*)
  let present = Program.atom(&mut rules.*)
  let stored = Program.atom(&mut rules.*)
  let alternatives = Program.atom(&mut rules.*)
  run Vector<Cell>.append(&mut cells.*, Cell {present: present, stored: stored, alternatives: alternatives})
  run Vector<CellKey>.append(&mut keys.*, key)
  return at
}

struct Domain {
  cells: Vector<Cell>
  keys: Vector<CellKey>
  witnesses: Vector<Witness>
  cases: Vector<Case>
  policies: Vector<PendingPolicy>
}

// Emits the finite paired value domain into the one program. This is independent of query
// stamping and TypedBody publication; it cannot solve or extend prepared physical endpoints.
effect fn reserveDomain(rules: &mut Program, reaching: &Reaching, evaluations: &[Evaluation],
  values: &[Value], seeds: &[Seed], transfers: &[Transfer]) -> Domain
! OutOfMemoryError ? &mut Allocator {
  let mut witnesses = Vector<Witness>.make()
  let seedCount = seeds.length
  let mut seedWitness = usize.ZERO
  while seedWitness < seedCount {
    run Vector<Witness>.append(&mut witnesses, Witness {definition: Option<DefinitionId>.none(), read: Option<ReadId>.none()})
    seedWitness = seedWitness + usize.ONE
  }
  let pairs = Vector<Pair>.asSlice(&reaching.pairs)
  let mut pair = usize.ZERO
  while pair < pairs.length {
    run Vector<Witness>.append(&mut witnesses, Witness {definition: Option<DefinitionId>.some(pairs[pair].definition),
      read: Option<ReadId>.some(pairs[pair].read)})
    pair = pair + usize.ONE
  }
  let mut cells = Vector<Cell>.make()
  let mut keys = Vector<CellKey>.make()
  let mut index = usize.ZERO
  let mut cases = Vector<Case>.make()
  let mut policies = Vector<PendingPolicy>.make()
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let points = Vector<Point>.asSlice(&reaching.points)
  index = usize.ZERO
  while index < seeds.length {
    let seed = seeds[index]
    let target = run reserveCell(&mut keys, &mut cells, &mut rules.*,
      CellKey {value: seed.value, leaf: seed.leaf, witness: index, direct: seed.direct})
    let cell = Vector<Cell>.asSlice(&cells)[target]
    let active = Program.atom(&mut rules.*)
    let reach = points[evaluations[values[seed.value.index].evaluation.index].point.index].reachable
    let admitted: [Atom; 2] = [seed.active, reach]
    run Program.rule(&mut rules.*, active, &admitted, none)
    let present: [Atom; 1] = [active]
    run Program.rule(&mut rules.*, cell.present, &present, none)
    let stored: [Atom; 2] = [active, seed.stored]
    run Program.rule(&mut rules.*, cell.stored, &stored, none)
    let alternatives: [Atom; 2] = [active, seed.alternatives]
    run Program.rule(&mut rules.*, cell.alternatives, &alternatives, none)
    run Vector<Case>.append(&mut cases, Case {direction: MapDirection.Forward, address: Option<EvalId>.none(), source: Option<usize>.none(), target: target, active: active, quality: cell,
      definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), map: Option<MapId>.none(),
      contract: Option<ContractRouteId>.none()})
    index = index + usize.ONE
  }
  // Candidate closure follows physical topology only. It reads no Truth and ignores every
  // policy/CFG gate, including late backedges. It reserves cells, not source witnesses.
  // Each (value, leaf, paired witness, directness) key is processed exactly once.
  index = usize.ZERO
  while index < Vector<CellKey>.length(&keys) {
    let key = Vector<CellKey>.asSlice(&keys)[index]
    let mut transferIndex = usize.ZERO
    while transferIndex < transfers.length {
      let transfer = &transfers[transferIndex]
      if transfer.source.index == key.value.index {
        let direct = match transfer.directness {
          Directness.Preserve => key.direct
          Directness.Direct => true
          Directness.Indirect => false
        }
        let mut targetWitness = key.witness
        let mut paired = Option<Atom>.none()
        if let Option<DefinitionId>.Some {value: definition} = transfer.definition {
          if let Option<ReadId>.Some {value: read} = transfer.read {
            let mut pairIndex = usize.ZERO
            while pairIndex < pairs.length {
              if pairs[pairIndex].definition.index == definition.index && pairs[pairIndex].read.index == read.index {
                targetWitness = seedCount + pairIndex
                paired = Option<Atom>.some(pairs[pairIndex].active)
                break
              }
              pairIndex = pairIndex + usize.ONE
            }
            if let Option<Atom>.None = paired { CompilerBug.panic(b"source transfer has no matching definition/read pair") }
          } else { CompilerBug.panic(b"source transfer omits its paired read") }
        } else {
          if let Option<ReadId>.Some {value: ignored} = transfer.read { CompilerBug.panic(b"source transfer omits its paired definition") }
        }
        let target = run reserveCell(&mut keys, &mut cells, &mut rules.*,
          CellKey {value: transfer.target, leaf: key.leaf, witness: targetWitness, direct: direct})
        let input = Vector<Cell>.asSlice(&cells)[index]
        let output = Vector<Cell>.asSlice(&cells)[target]
        let applicable = Program.atom(&mut rules.*)
        let reach = points[evaluations[values[transfer.target.index].evaluation.index].point.index].reachable
        if let Option<Atom>.Some {value: pairGate} = paired {
          let admitted: [Atom; 4] = [input.present, transfer.active, reach, pairGate]
          run Program.rule(&mut rules.*, applicable, &admitted, none)
        } else {
          let admitted: [Atom; 3] = [input.present, transfer.active, reach]
          run Program.rule(&mut rules.*, applicable, &admitted, none)
        }
        let mut active = applicable
        let mut addedStored = transfer.stored
        let mut addedAlternatives = transfer.alternatives
        if transfer.policy == TransferPolicy.Filtered {
          let id = PolicyPortId {index: Vector<PendingPolicy>.length(&policies)}
          let kept = Program.atom(&mut rules.*)
          let stored = Program.atom(&mut rules.*)
          let alternatives = Program.atom(&mut rules.*)
          let transferStored: [Atom; 1] = [transfer.stored]
          let transferAlternatives: [Atom; 1] = [transfer.alternatives]
          run Program.rule(&mut rules.*, stored, &transferStored, none)
          run Program.rule(&mut rules.*, alternatives, &transferAlternatives, none)
          // Reservation never consults this gate. Even when a later policy drops this
          // source, all downstream candidate cells and their own ports already exist.
          let witness = &Vector<Witness>.asSlice(&witnesses)[key.witness]
          run Vector<PendingPolicy>.append(&mut policies, PendingPolicy {
            port: PolicyPort {id: id, transfer: transferIndex, source: transfer.source,
              target: transfer.target, leaf: key.leaf, direct: key.direct,
              definition: witness.definition, read: witness.read,
              quality: Cell {present: applicable, stored: input.stored, alternatives: input.alternatives}},
            sourceCell: index, kept: kept, stored: stored, alternatives: alternatives, bound: false})
          active = Program.atom(&mut rules.*)
          let selected: [Atom; 2] = [applicable, kept]
          run Program.rule(&mut rules.*, active, &selected, none)
          addedStored = stored
          addedAlternatives = alternatives
        }
        let present: [Atom; 1] = [active]
        run Program.rule(&mut rules.*, output.present, &present, none)
        let caseStored = Program.atom(&mut rules.*)
        let caseAlternatives = Program.atom(&mut rules.*)
        let stored: [Atom; 2] = [active, input.stored]
        run Program.rule(&mut rules.*, caseStored, &stored, none)
        let newStored: [Atom; 2] = [active, addedStored]
        run Program.rule(&mut rules.*, caseStored, &newStored, none)
        let alternatives: [Atom; 2] = [active, input.alternatives]
        run Program.rule(&mut rules.*, caseAlternatives, &alternatives, none)
        let newAlternatives: [Atom; 2] = [active, addedAlternatives]
        run Program.rule(&mut rules.*, caseAlternatives, &newAlternatives, none)
        let storedOutput: [Atom; 1] = [caseStored]
        let alternativesOutput: [Atom; 1] = [caseAlternatives]
        run Program.rule(&mut rules.*, output.stored, &storedOutput, none)
        run Program.rule(&mut rules.*, output.alternatives, &alternativesOutput, none)
        run Vector<Case>.append(&mut cases, Case {direction: transfer.direction, address: transfer.address, source: Option<usize>.some(index), target: target, active: active,
          quality: Cell {present: active, stored: caseStored, alternatives: caseAlternatives},
          definition: transfer.definition, read: transfer.read, map: transfer.map, contract: transfer.contract})
      }
      transferIndex = transferIndex + usize.ONE
    }
    index = index + usize.ONE
  }
  return Domain {cells: move cells, keys: move keys, witnesses: move witnesses, cases: move cases, policies: move policies}
}

impl<'body> Builder<'body> {
  /// Reserves the finite typed-topology value/leaf/witness/directness domain and emits source rules.
  /// Cases retain each paired edge; their alternatives do not multiply physical operands.
  pub effect fn reserve(preparation: SourcePreparation<'body>, skeleton: Skeleton) -> Self
  ! OutOfMemoryError ? &mut Allocator {
    run validatePreparedOperations(&preparation)
    validateResiduals(&preparation)
    let mut closed = move skeleton
    drop run Skeleton.closeStorage(&mut closed)
    let skeleton = move closed
    let mut rules = move skeleton.rules
    let reaching = run Flow.emit(move skeleton.flow, &mut rules)
    let transfers = move skeleton.transfers
    validateStorage(Vector<SelectionMap>.asSlice(&preparation.maps), &reaching, Vector<Storage>.asSlice(&skeleton.storage), Vector<DefinedValue>.asSlice(&skeleton.definitions),
      Vector<ReadValue>.asSlice(&skeleton.reads), Vector<Value>.asSlice(&skeleton.values),
      Vector<Evaluation>.asSlice(&skeleton.evaluations))
    validateReferenceOrigins(&preparation, Vector<ReferenceOrigin>.asSlice(&skeleton.references),
      Vector<Evaluation>.asSlice(&skeleton.evaluations), Vector<Value>.asSlice(&skeleton.values), Vector<Leaf>.asSlice(&skeleton.leaves))
    validateReservation(&preparation, &reaching, Vector<Evaluation>.asSlice(&skeleton.evaluations),
      Vector<Value>.asSlice(&skeleton.values), Vector<Leaf>.asSlice(&skeleton.leaves),
      Vector<Seed>.asSlice(&skeleton.seeds), Vector<Transfer>.asSlice(&transfers), Vector<StorageAlias>.asSlice(&skeleton.aliases), Vector<Storage>.asSlice(&skeleton.storage))
    let domain = run reserveDomain(&mut rules, &reaching, Vector<Evaluation>.asSlice(&skeleton.evaluations),
      Vector<Value>.asSlice(&skeleton.values), Vector<Seed>.asSlice(&skeleton.seeds), Vector<Transfer>.asSlice(&transfers))
    return Builder<'body> {rules: move rules, reaching: move reaching, storage: move skeleton.storage, references: move skeleton.references, preparation: move preparation,
      evaluations: move skeleton.evaluations, values: move skeleton.values, leaves: move skeleton.leaves,
      cells: move domain.cells, keys: move domain.keys, witnesses: move domain.witnesses, cases: move domain.cases,
      policies: move domain.policies}
  }

  pub fn cell(self: &Self, value: ValueId, leaf: LeafId, witness: usize, direct: bool) -> Option<Cell> {
    let index = findCell(Vector<CellKey>.asSlice(&self.keys), value, leaf, witness, direct)
    if index == usize.MAX { return Option<Cell>.none() }
    return Option<Cell>.some(Vector<Cell>.asSlice(&self.cells)[index])
  }

  pub fn leaf(self: &Self, leaf: LeafId) -> &Leaf {
    let leaves = Vector<Leaf>.asSlice(&self.leaves)
    if leaf.index >= leaves.length { CompilerBug.panic(b"policy input names an unreserved source leaf") }
    return &leaves[leaf.index]
  }

  /// Called once at each operation's input barrier. The caller supplies written operand and
  /// structural component order; this returns stable leaf order within that physical position.
  /// No candidate Truth is inspected and none of the inputs can depend on a selected output.
  pub effect fn inputs(self: &mut Self, value: ValueId) -> Vector<Input>
  ! OutOfMemoryError ? &mut Allocator {
    let values = Vector<Value>.asSlice(&self.values)
    if value.index >= values.length { CompilerBug.panic(b"policy input names an unreserved physical value") }
    return run inputPositions(&mut self.rules, value, Vector<Leaf>.length(&self.leaves), values,
      Vector<CellKey>.asSlice(&self.keys), Vector<Cell>.asSlice(&self.cells),
      Vector<Witness>.asSlice(&self.witnesses), Vector<Case>.asSlice(&self.cases))
  }

  pub effect fn solve(self: Self) -> Graph<'body> ! OutOfMemoryError ? &mut Allocator {
    let policies = Vector<PendingPolicy>.asSlice(&self.policies)
    let mut at = usize.ZERO
    while at < policies.length {
      if !policies[at].bound { CompilerBug.panic(b"source policy omitted a reserved candidate decision") }
      at = at + usize.ONE
    }
    let solution = run Program.solve(&self.rules)
    let stamp = run Shared<Stamp>.make(Stamp {marker: true})
    return Graph<'body> {stamp: move stamp, preparation: move self.preparation, solution: move solution,
      reaching: move self.reaching, storage: move self.storage, references: move self.references, evaluations: move self.evaluations, values: move self.values,
      leaves: move self.leaves, cells: move self.cells, keys: move self.keys, witnesses: move self.witnesses, cases: move self.cases}
  }

  pub fn policyCount(self: &Self) -> usize { return Vector<PendingPolicy>.length(&self.policies) }

  pub fn policy(self: &Self, index: usize) -> PolicyPort {
    let policies = Vector<PendingPolicy>.asSlice(&self.policies)
    if index >= policies.length { CompilerBug.panic(b"source policy names an absent decision port") }
    return policies[index].port
  }

  /// Predecessor routes of this paired source are still alternatives, not additional scan
  /// positions. A consumer needing placement/contract evidence must use each complete case.
  pub effect fn policyCases(self: &Self, id: PolicyPortId) -> Vector<InputCase>
  ! OutOfMemoryError ? &mut Allocator {
    let policies = Vector<PendingPolicy>.asSlice(&self.policies)
    if id.index >= policies.length { CompilerBug.panic(b"source policy names an absent decision port") }
    let mut result = Vector<InputCase>.make()
    run appendInputCases(&mut result, policies[id.index].sourceCell, Vector<Value>.asSlice(&self.values),
      Vector<CellKey>.asSlice(&self.keys), Vector<Witness>.asSlice(&self.witnesses), Vector<Case>.asSlice(&self.cases))
    return move result
  }

  /// Every candidate must be bound exactly once, including absent/unknown/loan-free cases.
  /// The arguments are rules in this same program, not sampled Truth values or final precision.
  pub effect fn bindPolicy(self: &mut Self, port: PolicyPortId, kept: Atom, stored: Atom, alternatives: Atom) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    return run bindPolicy(&mut self.policies, &mut self.rules, port, kept, stored, alternatives)
  }
}

effect fn bindPolicy(policies: &mut Vector<PendingPolicy>, rules: &mut Program, id: PolicyPortId,
  kept: Atom, stored: Atom, alternatives: Atom) -> () ! OutOfMemoryError ? &mut Allocator {
  let pending = Vector<PendingPolicy>.asMutSlice(&mut policies.*)
  if id.index >= pending.length || pending[id.index].bound {
    CompilerBug.panic(b"source policy decision was absent or bound twice")
  }
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let retains: [Atom; 1] = [kept]
  let losesStorage: [Atom; 1] = [stored]
  let losesAlternatives: [Atom; 1] = [alternatives]
  run Program.rule(&mut rules.*, pending[id.index].kept, &retains, none)
  run Program.rule(&mut rules.*, pending[id.index].stored, &losesStorage, none)
  run Program.rule(&mut rules.*, pending[id.index].alternatives, &losesAlternatives, none)
  pending[id.index].bound = true
  return ()
}

effect fn inputPositions(rules: &mut Program, value: ValueId, leafCount: usize, values: &[Value],
  keys: &[CellKey], cells: &[Cell], witnesses: &[Witness], cases: &[Case]) -> Vector<Input>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector<Input>.make()
  let empty = Vector<Atom>.make()
  let none = Vector<Atom>.asSlice(&empty)
  let mut leaf = usize.ZERO
  while leaf < leafCount {
    let mut found = false
    let mut key = usize.ZERO
    while key < keys.length {
      if keys[key].value.index == value.index && keys[key].leaf.index == leaf { found = true }
      key = key + usize.ONE
    }
    if found {
      let quality = Cell {present: Program.atom(&mut rules.*), stored: Program.atom(&mut rules.*), alternatives: Program.atom(&mut rules.*)}
      let mut alternatives = Vector<InputCase>.make()
      key = usize.ZERO
      while key < keys.length {
        if keys[key].value.index == value.index && keys[key].leaf.index == leaf {
          let present: [Atom; 1] = [cells[key].present]
          let stored: [Atom; 1] = [cells[key].stored]
          let lost: [Atom; 1] = [cells[key].alternatives]
          run Program.rule(&mut rules.*, quality.present, &present, none)
          run Program.rule(&mut rules.*, quality.stored, &stored, none)
          run Program.rule(&mut rules.*, quality.alternatives, &lost, none)
          run appendInputCases(&mut alternatives, key, values, keys, witnesses, cases)
        }
        key = key + usize.ONE
      }
      run Vector<Input>.append(&mut result, Input {value: value, leaf: LeafId {index: leaf},
        quality: quality, cases: move alternatives})
    }
    leaf = leaf + usize.ONE
  }
  return move result
}

effect fn appendInputCases(target: &mut Vector<InputCase>, key: usize, values: &[Value],
  keys: &[CellKey], witnesses: &[Witness], cases: &[Case]) -> () ! OutOfMemoryError ? &mut Allocator {
  let witness = &witnesses[keys[key].witness]
  let mut each = usize.ZERO
  while each < cases.length {
    if cases[each].target == key {
      let mut source = Option<ValueId>.none()
      if let Option<usize>.Some {value: previous} = cases[each].source {
        source = Option<ValueId>.some(keys[previous].value)
      }
      run Vector<InputCase>.append(&mut target.*, InputCase {direction: cases[each].direction, address: cases[each].address, source: source,
        placement: values[keys[key].value.index].endpoint, direct: keys[key].direct,
        definition: witness.definition, read: witness.read, map: cases[each].map,
        contract: cases[each].contract, quality: cases[each].quality})
    }
    each = each + usize.ONE
  }
  return ()
}

impl<'body> Graph<'body> {
  pub fn preparation(self: &Self) -> &SourcePreparation<'body> { return &self.preparation }

  /// Ownership consumes the same immutable runtime/reaching graph, including explicit
  /// reachability and transfer-pair atoms. This is not a second temporal source analysis.
  pub fn control(self: &Self) -> &Reaching { return &self.reaching }

  pub fn componentStorage(self: &Self, component: ComponentId) -> Storage {
    let stored = Vector<Storage>.asSlice(&self.storage)
    if component.index >= stored.length { return CompilerBug.panic(b"ownership projection names absent source storage") }
    return stored[component.index]
  }

  pub fn truth(self: &Self, atom: Atom) -> Truth { return Solution.truth(&self.solution, atom) }

  pub fn selection(self: &Self, prepared: PreparedSelectionId) -> Result<SelectionId, AccessError> {
    if prepared.index >= Vector<Selection>.length(&self.preparation.selections) {
      return Result<SelectionId, AccessError>.failResult(AccessError.InvalidSelection)
    }
    return Result<SelectionId, AccessError>.succeed(SelectionId {stamp: Shared<Stamp>.clone(&self.stamp), index: prepared.index})
  }

  pub fn quality(self: &Self, cell: Cell) -> Quality {
    return Quality {present: Solution.truth(&self.solution, cell.present), stored: Solution.truth(&self.solution, cell.stored),
      alternatives: Solution.truth(&self.solution, cell.alternatives)}
  }

  pub fn leaf(self: &Self, leaf: &SourceLeafId) -> Result<&Leaf, AccessError> {
    if !sameStamp(&self.stamp, &leaf.stamp) { return Result<&Leaf, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let leaves = Vector<Leaf>.asSlice(&self.leaves)
    if leaf.index >= leaves.length { return Result<&Leaf, AccessError>.failResult(AccessError.InvalidPort) }
    return Result<&Leaf, AccessError>.succeed(&leaves[leaf.index])
  }

  pub fn requestOutcome(self: &Self, ordinal: usize, disposition: SourceDisposition) -> SourceOutcome {
    return SourceOutcome {stamp: Shared<Stamp>.clone(&self.stamp), ordinal: ordinal, disposition: move disposition}
  }

  /// Missing, duplicated, foreign or recovery outcomes cannot discharge a retained request.
  /// The owning checker additionally authenticates its original obligation kind and producer.
  pub fn outcome(self: &Self, ordinal: usize, outcomes: &[SourceOutcome]) -> SourceDisposition {
    let mut matchAt = usize.MAX
    let mut at = usize.ZERO
    while at < outcomes.length {
      if outcomes[at].ordinal == ordinal {
        if !sameStamp(&self.stamp, &outcomes[at].stamp) || matchAt != usize.MAX { return SourceDisposition.Pending }
        matchAt = at
      }
      at = at + usize.ONE
    }
    if self.preparation.body.coverage != Coverage.Complete || !Solution.valid(&self.solution) || matchAt == usize.MAX {
      return SourceDisposition.Pending
    }
    return copyDisposition(&outcomes[matchAt].disposition)
  }
}

fn copyDisposition(value: &SourceDisposition) -> SourceDisposition {
  return match &value.* {
    SourceDisposition.Proved => SourceDisposition.Proved
    SourceDisposition.Pending => SourceDisposition.Pending
    SourceDisposition.Refuted {origin} => SourceDisposition.Refuted {origin: origin}
  }
}

impl<'body> Graph<'body> {
  /// Imports only an existing prepared selection. Arbitrary paths cannot grow the solved graph.
  pub effect fn sourcesAt(self: &Self, query: &SourceQuery) -> Result<Sources, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &query.selection.stamp) {
      return Result<Sources, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    let selections = Vector<Selection>.asSlice(&self.preparation.selections)
    if query.selection.index >= selections.length {
      return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection)
    }
    let selection = &selections[query.selection.index]
    let endpoints = Vector<Endpoint>.asSlice(&self.preparation.endpoints)
    if selection.root.index >= endpoints.length { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let matches = match &endpoints[selection.root.index].root {
      Root.Node {node, ..} => node.index == query.read.index
      _ => false
    }
    if !matches { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let accepts = Vector<EndpointId>.asSlice(&selection.accepts)
    if accepts.length == usize.ZERO { return Result<Sources, AccessError>.failResult(AccessError.InvalidSelection) }
    let values = Vector<Value>.asSlice(&self.values)
    let evaluations = Vector<Evaluation>.asSlice(&self.evaluations)
    let points = Vector<Point>.asSlice(&self.reaching.points)
    let cells = Vector<Cell>.asSlice(&self.cells)
    let cases = Vector<Case>.asSlice(&self.cases)
    let leaves = Vector<Leaf>.asSlice(&self.leaves)
    let mut alternatives = Vector<SourceAlternative>.make()
    let mut observed = Vector<SourceEvaluation>.make()
    let mut observedIds = Vector<usize>.make()
    let mut gaps = Vector<SourceGap>.make()
    let mut complete = Solution.valid(&self.solution)
    if self.preparation.body.coverage != Coverage.Complete {
      complete = false
      run Vector<SourceGap>.append(&mut gaps, SourceGap.Recovery)
    }
    let mut found = false
    // An actual evaluation with impossible successful completion (for example indexing a
    // fixed zero-length array) has a reserved unreachable result point but no value/read.
    // Do not confuse this positive CFG fact with a missing evaluation or invent a source.
    let mut evaluation = usize.ZERO
    while evaluation < evaluations.length {
      let atRead = match evaluations[evaluation].site {
        EvaluationSite.Node {node} => node.index == query.read.index
        EvaluationSite.Entry {..} => false
      }
      if atRead && evaluations[evaluation].role == EvaluationRole.Value {
        found = true
        let reachable = Solution.truth(&self.solution, points[evaluations[evaluation].point.index].reachable)
        run Vector<usize>.append(&mut observedIds, evaluation)
        run Vector<SourceEvaluation>.append(&mut observed, SourceEvaluation {
          occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: evaluation}, reachable: reachable})
        if reachable == Truth.Undefined {
          complete = false
          run Vector<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
        }
      }
      evaluation = evaluation + usize.ONE
    }
    let mut value = usize.ZERO
    while value < values.length {
      let evaluation = values[value].evaluation.index
      let atRead = match evaluations[evaluation].site {
        EvaluationSite.Node {node} => node.index == query.read.index
        EvaluationSite.Entry {..} => false
      }
      if atRead && evaluations[evaluation].role == EvaluationRole.Value {
        let mut selected = false
        let mut accept = usize.ZERO
        while accept < accepts.length {
          if accepts[accept].index == values[value].endpoint.index { selected = true }
          accept = accept + usize.ONE
        }
        if selected {
          let reachable = Solution.truth(&self.solution, points[evaluations[evaluation].point.index].reachable)
          let mut grounded = false
          let keys = Vector<CellKey>.asSlice(&self.keys)
          let mut cell = usize.ZERO
          while cell < keys.length {
            if keys[cell].value.index == value {
              let leaf = keys[cell].leaf.index
              let presence = Solution.truth(&self.solution, cells[cell].present)
              if presence != Truth.False {
                if presence == Truth.True { grounded = true }
                if presence == Truth.Undefined {
                  complete = false
                  run Vector<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
                }
                let mut routeCase = usize.ZERO
                while routeCase < cases.length {
                  if cases[routeCase].target == cell && Solution.truth(&self.solution, cases[routeCase].active) != Truth.False {
                    if Solution.truth(&self.solution, cases[routeCase].active) == Truth.Undefined {
                      complete = false
                      run Vector<SourceGap>.append(&mut gaps, SourceGap.UnresolvedApplicability)
                    }
                    run Vector<SourceAlternative>.append(&mut alternatives, SourceAlternative {
                      leaf: SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: leaf}, origin: leaves[leaf].origin,
                      occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: evaluation},
                      route: SourceRouteId {stamp: Shared<Stamp>.clone(&self.stamp), root: cell},
                      case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: routeCase}})
                  }
                  routeCase = routeCase + usize.ONE
                }
              }
            }
            cell = cell + usize.ONE
          }
          if reachable != Truth.False && !grounded {
            complete = false
            run Vector<SourceGap>.append(&mut gaps, SourceGap.Ungrounded)
          }
        }
      }
      value = value + usize.ONE
    }
    let observedEvaluations = Vector<usize>.asSlice(&observedIds)
    let mut observedAt = usize.ZERO
    while observedAt < observedEvaluations.length {
      let reachable = Solution.truth(&self.solution, points[evaluations[observedEvaluations[observedAt]].point.index].reachable)
      let mut accept = usize.ZERO
      while reachable != Truth.False && accept < accepts.length {
        let mut represented = false
        let mut candidate = usize.ZERO
        while candidate < values.length {
          if values[candidate].evaluation.index == observedEvaluations[observedAt]
            && values[candidate].endpoint.index == accepts[accept].index { represented = true }
          candidate = candidate + usize.ONE
        }
        if !represented {
          complete = false
          run Vector<SourceGap>.append(&mut gaps, SourceGap.Ungrounded)
        }
        accept = accept + usize.ONE
      }
      observedAt = observedAt + usize.ONE
    }
    if !found {
      complete = false
      run Vector<SourceGap>.append(&mut gaps, SourceGap.MissingEvaluation)
    }
    return Result<Sources, AccessError>.succeed(Sources {evaluations: move observed, alternatives: move alternatives, gaps: move gaps, complete: complete})
  }

  pub fn occurrence(self: &Self, id: &OccurrenceId) -> Result<Evaluation, AccessError> {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<Evaluation, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let evaluations = Vector<Evaluation>.asSlice(&self.evaluations)
    if id.index >= evaluations.length { return Result<Evaluation, AccessError>.failResult(AccessError.InvalidOccurrence) }
    return Result<Evaluation, AccessError>.succeed(evaluations[id.index])
  }

  pub effect fn route(self: &Self, id: &SourceRouteId) -> Result<RouteView, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<RouteView, AccessError>.failResult(AccessError.ForeignAnalysis) }
    if id.root >= Vector<Cell>.length(&self.cells) { return Result<RouteView, AccessError>.failResult(AccessError.InvalidRoute) }
    let closure = run routeClosure(self, id.root)
    let cases = Vector<Case>.asSlice(&self.cases)
    let ports = Vector<usize>.asSlice(&closure)
    let mut accepts = Vector<RoutePortId>.make()
    let mut at = usize.ZERO
    while at < ports.length {
      let mut each = usize.ZERO
      let mut grounded = false
      while each < cases.length {
        if cases[each].target == ports[at] && Solution.truth(&self.solution, cases[each].active) != Truth.False {
          if let Option<usize>.None = cases[each].source { grounded = true }
        }
        each = each + usize.ONE
      }
      if grounded { run Vector<RoutePortId>.append(&mut accepts, RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: ports[at]}) }
      at = at + usize.ONE
    }
    let leaf = Vector<CellKey>.asSlice(&self.keys)[id.root].leaf.index
    return Result<RouteView, AccessError>.succeed(RouteView {
      start: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: id.root}, accepts: move accepts,
      leaf: SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: leaf}})
  }

  pub effect fn routePort(self: &Self, route: &SourceRouteId, port: &RoutePortId) -> Result<RoutePort, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &route.stamp) || !sameStamp(&self.stamp, &port.stamp) {
      return Result<RoutePort, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    if route.root >= Vector<Cell>.length(&self.cells) || port.index >= Vector<Cell>.length(&self.cells) {
      return Result<RoutePort, AccessError>.failResult(AccessError.InvalidPort)
    }
    let closure = run routeClosure(self, route.root)
    if !contains(Vector<usize>.asSlice(&closure), port.index) { return Result<RoutePort, AccessError>.failResult(AccessError.InvalidPort) }
    let value = Vector<CellKey>.asSlice(&self.keys)[port.index].value.index
    let actual = Vector<Value>.asSlice(&self.values)[value]
    return Result<RoutePort, AccessError>.succeed(RoutePort {endpoint: actual.endpoint,
      occurrence: OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: actual.evaluation.index},
      direct: Vector<CellKey>.asSlice(&self.keys)[port.index].direct, quality: Graph<'body>.quality(self, Vector<Cell>.asSlice(&self.cells)[port.index])})
  }

  pub effect fn routeEdges(self: &Self, route: &SourceRouteId, port: &RoutePortId) -> Result<Vector<RouteEdge>, AccessError>
  ! OutOfMemoryError ? &mut Allocator {
    if !sameStamp(&self.stamp, &route.stamp) || !sameStamp(&self.stamp, &port.stamp) {
      return Result<Vector<RouteEdge>, AccessError>.failResult(AccessError.ForeignAnalysis)
    }
    if route.root >= Vector<Cell>.length(&self.cells) || port.index >= Vector<Cell>.length(&self.cells) {
      return Result<Vector<RouteEdge>, AccessError>.failResult(AccessError.InvalidPort)
    }
    let closure = run routeClosure(self, route.root)
    if !contains(Vector<usize>.asSlice(&closure), port.index) { return Result<Vector<RouteEdge>, AccessError>.failResult(AccessError.InvalidPort) }
    let cases = Vector<Case>.asSlice(&self.cases)
    let mut result = Vector<RouteEdge>.make()
    let mut at = usize.ZERO
    while at < cases.length {
      if cases[at].target == port.index && Solution.truth(&self.solution, cases[at].active) != Truth.False {
        if let Option<usize>.Some {value: source} = cases[at].source {
          let mut address = Option<OccurrenceId>.none()
          if let Option<EvalId>.Some {value} = cases[at].address {
            address = Option<OccurrenceId>.some(OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: value.index})
          }
          run Vector<RouteEdge>.append(&mut result, RouteEdge {direction: cases[at].direction, address: move address,
            from: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: port.index},
            to: RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: source}, map: cases[at].map,
            originalContract: cases[at].contract, case: RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: at}})
        }
      }
      at = at + usize.ONE
    }
    return Result<Vector<RouteEdge>, AccessError>.succeed(move result)
  }

  pub fn routeCase(self: &Self, id: &RouteCaseId) -> Result<RouteCase, AccessError> {
    if !sameStamp(&self.stamp, &id.stamp) { return Result<RouteCase, AccessError>.failResult(AccessError.ForeignAnalysis) }
    let cases = Vector<Case>.asSlice(&self.cases)
    if id.index >= cases.length { return Result<RouteCase, AccessError>.failResult(AccessError.InvalidCase) }
    let actual = &cases[id.index]
    let key = Vector<CellKey>.asSlice(&self.keys)[actual.target]
    let value = key.value.index
    let witness = &Vector<Witness>.asSlice(&self.witnesses)[key.witness]
    let mut definition = Option<SourceDefinitionId>.none()
    let mut read = Option<SourceReadId>.none()
    if let Option<DefinitionId>.Some {value} = witness.definition {
      definition = Option<SourceDefinitionId>.some(SourceDefinitionId {stamp: Shared<Stamp>.clone(&self.stamp), index: value.index})
    }
    if let Option<ReadId>.Some {value} = witness.read {
      read = Option<SourceReadId>.some(SourceReadId {stamp: Shared<Stamp>.clone(&self.stamp), index: value.index})
    }
    return Result<RouteCase, AccessError>.succeed(RouteCase {applicability: Solution.truth(&self.solution, actual.active),
      definition: move definition, read: move read, placement: Vector<Value>.asSlice(&self.values)[value].endpoint,
      direct: key.direct, quality: Graph<'body>.quality(self, actual.quality)})
  }
}

fn contains(values: &[usize], value: usize) -> bool {
  let mut at = usize.ZERO
  while at < values.length {
    if values[at] == value { return true }
    at = at + usize.ONE
  }
  return false
}

// Reachability here is immutable route access, not another source solver. Only the already
// solved case applicability is read; a visited cycle establishes no source or lifetime proof.
effect fn routeClosure<'body>(graph: &Graph<'body>, start: usize) -> Vector<usize>
! OutOfMemoryError ? &mut Allocator {
  let mut result = Vector<usize>.make()
  run Vector<usize>.append(&mut result, start)
  let cases = Vector<Case>.asSlice(&graph.cases)
  let mut next = usize.ZERO
  while next < Vector<usize>.length(&result) {
    let port = Vector<usize>.asSlice(&result)[next]
    let mut at = usize.ZERO
    while at < cases.length {
      if cases[at].target == port && Solution.truth(&graph.solution, cases[at].active) != Truth.False {
        if let Option<usize>.Some {value} = cases[at].source {
          if !contains(Vector<usize>.asSlice(&result), value) { run Vector<usize>.append(&mut result, value) }
        }
      }
      at = at + usize.ONE
    }
    next = next + usize.ONE
  }
  return move result
}

impl SourceLeafId {
  pub fn copy(self: &Self) -> Self {
    return SourceLeafId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

impl SelectionId {
  pub fn copy(self: &Self) -> Self {
    return SelectionId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

impl SourceRouteId {
  pub fn copy(self: &Self) -> Self {
    return SourceRouteId {stamp: Shared<Stamp>.clone(&self.stamp), root: self.root}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.root == other.root
  }
}

impl RoutePortId {
  pub fn copy(self: &Self) -> Self {
    return RoutePortId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

impl RouteCaseId {
  pub fn copy(self: &Self) -> Self {
    return RouteCaseId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

impl OccurrenceId {
  pub fn copy(self: &Self) -> Self {
    return OccurrenceId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

impl SourceDefinitionId {
  pub fn copy(self: &Self) -> Self {
    return SourceDefinitionId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

impl SourceReadId {
  pub fn copy(self: &Self) -> Self {
    return SourceReadId {stamp: Shared<Stamp>.clone(&self.stamp), index: self.index}
  }
  pub fn equals(self: &Self, other: &Self) -> bool {
    return sameStamp(&self.stamp, &other.stamp) && self.index == other.index
  }
}

// Reservation-level source semantics, not acceptance of a manually assembled typed body.
// The graph supplies independently observable read results: a saved copy, a backedge alias,
// an explicit unknown entry and a loan-free replacement all need distinct source identities.
test effect fn sourceCopiesKeepEarlierReadsAndAcquireBackedgeDefinitions() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceCopyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceCopyClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut skeleton = Skeleton.make()
  let yes = Program.atom(&mut skeleton.rules)
  let no = Program.atom(&mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, yes)
  let entry = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let before = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let save = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let header = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let alias = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let replacement = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let exit = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let reset = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let finalRead = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let savedRead = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let aliasRead = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let otherAlias = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, Flow.reachable(&skeleton.flow, entry))
  run Flow.edge(&mut skeleton.flow, entry, before, yes)
  run Flow.edge(&mut skeleton.flow, before, save, yes)
  run Flow.edge(&mut skeleton.flow, save, header, yes)
  run Flow.edge(&mut skeleton.flow, header, alias, yes)
  run Flow.edge(&mut skeleton.flow, alias, replacement, yes)
  run Flow.edge(&mut skeleton.flow, header, otherAlias, yes)
  run Flow.edge(&mut skeleton.flow, otherAlias, replacement, yes)
  run Flow.edge(&mut skeleton.flow, replacement, header, yes)
  run Flow.edge(&mut skeleton.flow, header, exit, yes)
  run Flow.edge(&mut skeleton.flow, exit, reset, yes)
  run Flow.edge(&mut skeleton.flow, reset, finalRead, yes)
  run Flow.edge(&mut skeleton.flow, finalRead, savedRead, yes)
  run Flow.edge(&mut skeleton.flow, savedRead, aliasRead, yes)

  // Storage component coordinates 0=r, 1=saved, 2=alias. The initial alias is explicitly
  // unknown; reaching no loan at entry must not make the zero-iteration case loan-free.
  let initial = run sourceTestValue(&mut skeleton, entry, 0)
  let initialAlias = run sourceTestValue(&mut skeleton, entry, 2)
  let early = run sourceTestValue(&mut skeleton, before, 3)
  let saved = run sourceTestValue(&mut skeleton, save, 1)
  let current = run sourceTestValue(&mut skeleton, header, 4)
  let copied = run sourceTestValue(&mut skeleton, alias, 2)
  let copiedIndirectly = run sourceTestValue(&mut skeleton, otherAlias, 2)
  let later = run sourceTestValue(&mut skeleton, replacement, 0)
  let cleared = run sourceTestValue(&mut skeleton, reset, 0)
  let finalValue = run sourceTestValue(&mut skeleton, finalRead, 5)
  let savedValue = run sourceTestValue(&mut skeleton, savedRead, 6)
  let aliasValue = run sourceTestValue(&mut skeleton, aliasRead, 7)
  let filtered = run sourceTestValue(&mut skeleton, aliasRead, 8)
  let filteredCopy = run sourceTestValue(&mut skeleton, aliasRead, 9)
  let caller = LeafId {index: 0}
  let storedSource = LeafId {index: 1}
  let unknown = LeafId {index: 2}
  let loanFree = LeafId {index: 3}
  run Vector<Seed>.append(&mut skeleton.seeds,
    Seed {value: initial, leaf: caller, direct: true, active: yes, stored: no, alternatives: no})
  run Vector<Seed>.append(&mut skeleton.seeds,
    Seed {value: initialAlias, leaf: unknown, direct: false, active: yes, stored: no, alternatives: no})
  run Vector<Seed>.append(&mut skeleton.seeds,
    Seed {value: later, leaf: storedSource, direct: true, active: yes, stored: yes, alternatives: no})
  run Vector<Seed>.append(&mut skeleton.seeds,
    Seed {value: cleared, leaf: loanFree, direct: false, active: yes, stored: no, alternatives: no})
  let initialDefinition = run Skeleton.define(&mut skeleton, entry, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, initial, yes, Write.Strong)
  let unknownDefinition = run Skeleton.define(&mut skeleton, entry, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, initialAlias, yes, Write.Strong)
  let savedDefinition = run Skeleton.define(&mut skeleton, save, Storage {endpoint: EndpointId {index: 1}, temporary: Option<EvalId>.none()}, saved, yes, Write.Strong)
  let aliasDefinition = run Skeleton.define(&mut skeleton, alias, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, copied, yes, Write.Strong)
  let otherAliasDefinition = run Skeleton.define(&mut skeleton, otherAlias, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, copiedIndirectly, yes, Write.Strong)
  // Deliberately register the read before the later replacement definition. The result must
  // depend on CFG reachability, not on this constructor order.
  let mut maps = Vector<SelectionMap>.make()
  let earlyMap = run sourceTestMap(&mut maps, 0, 3)
  let currentMap = run sourceTestMap(&mut maps, 0, 4)
  let savedMap = run sourceTestMap(&mut maps, 1, 6)
  let aliasMap = run sourceTestMap(&mut maps, 2, 7)
  let finalMap = run sourceTestMap(&mut maps, 0, 5)
  let earlyRead = run Skeleton.read(&mut skeleton, before, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, early, Option<MapId>.some(earlyMap))
  let currentRead = run Skeleton.read(&mut skeleton, header, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, current, Option<MapId>.some(currentMap))
  // Reserve the initial copies before the backedge replacement exists. The unchanged
  // saved/current/cleared source assertions below require stable old gates AND new pairs.
  drop run Skeleton.closeStorage(&mut skeleton)
  let laterDefinition = run Skeleton.define(&mut skeleton, replacement, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, later, yes, Write.Strong)
  let clearedDefinition = run Skeleton.define(&mut skeleton, reset, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, cleared, yes, Write.Strong)
  let finalStorageRead = run Skeleton.read(&mut skeleton, finalRead, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, finalValue, Option<MapId>.some(finalMap))
  let savedStorageRead = run Skeleton.read(&mut skeleton, savedRead, Storage {endpoint: EndpointId {index: 1}, temporary: Option<EvalId>.none()}, savedValue, Option<MapId>.some(savedMap))
  let aliasStorageRead = run Skeleton.read(&mut skeleton, aliasRead, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, aliasValue, Option<MapId>.some(aliasMap))
  let savingMap = run sourceTestMap(&mut maps, 3, 1)
  let copyingMap = run sourceTestMap(&mut maps, 4, 2)
  run Vector<Transfer>.append(&mut skeleton.transfers, Transfer {direction: MapDirection.Forward, address: Option<EvalId>.none(), source: early, target: saved,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
    map: Option<MapId>.some(savingMap), contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Physical})
  run Vector<Transfer>.append(&mut skeleton.transfers, Transfer {direction: MapDirection.Forward, address: Option<EvalId>.none(), source: current, target: copied,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
    map: Option<MapId>.some(copyingMap), contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Physical})
  run Vector<Transfer>.append(&mut skeleton.transfers, Transfer {direction: MapDirection.Forward, address: Option<EvalId>.none(), source: current, target: copiedIndirectly,
    active: yes, directness: Directness.Indirect, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
    map: Option<MapId>.some(copyingMap), contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Physical})
  let filterMap = run sourceTestMap(&mut maps, 7, 8)
  let afterFilter = run sourceTestMap(&mut maps, 8, 9)
  run Vector<Transfer>.append(&mut skeleton.transfers, Transfer {direction: MapDirection.Forward, address: Option<EvalId>.none(), source: aliasValue, target: filtered,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
    map: Option<MapId>.some(filterMap), contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Filtered})
  run Vector<Transfer>.append(&mut skeleton.transfers, Transfer {direction: MapDirection.Forward, address: Option<EvalId>.none(), source: filtered, target: filteredCopy,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(),
    map: Option<MapId>.some(afterFilter), contract: Option<ContractRouteId>.none(), policy: TransferPolicy.Physical})
  drop run Skeleton.closeStorage(&mut skeleton)
  let mut rules = move skeleton.rules
  let reaching = run Flow.emit(move skeleton.flow, &mut rules)
  let transfers = move skeleton.transfers
  validateStorage(Vector<SelectionMap>.asSlice(&maps), &reaching, Vector<Storage>.asSlice(&skeleton.storage),
    Vector<DefinedValue>.asSlice(&skeleton.definitions), Vector<ReadValue>.asSlice(&skeleton.reads),
    Vector<Value>.asSlice(&skeleton.values), Vector<Evaluation>.asSlice(&skeleton.evaluations))
  let mut domain = run reserveDomain(&mut rules, &reaching, Vector<Evaluation>.asSlice(&skeleton.evaluations),
    Vector<Value>.asSlice(&skeleton.values), Vector<Seed>.asSlice(&skeleton.seeds), Vector<Transfer>.asSlice(&transfers))
  let inputs = run inputPositions(&mut rules, aliasValue, 4, Vector<Value>.asSlice(&skeleton.values),
    Vector<CellKey>.asSlice(&domain.keys), Vector<Cell>.asSlice(&domain.cells),
    Vector<Witness>.asSlice(&domain.witnesses), Vector<Case>.asSlice(&domain.cases))
  let undecided = Program.atom(&mut rules)
  let opposite = Program.atom(&mut rules)
  let empty = Vector<Atom>.make()
  let notOpposite: [Atom; 1] = [opposite]
  let notUndecided: [Atom; 1] = [undecided]
  run Program.rule(&mut rules, undecided, Vector<Atom>.asSlice(&empty), &notOpposite)
  run Program.rule(&mut rules, opposite, Vector<Atom>.asSlice(&empty), &notUndecided)
  let mut policy = usize.ZERO
  while policy < Vector<PendingPolicy>.length(&domain.policies) {
    let port = Vector<PendingPolicy>.asSlice(&domain.policies)[policy].port
    let mut kept = no
    if port.leaf.index == caller.index { kept = yes }
    if port.leaf.index == unknown.index { kept = undecided }
    run bindPolicy(&mut domain.policies, &mut rules, port.id, kept, no, no)
    policy = policy + usize.ONE
  }
  let solved = run Program.solve(&rules)
  run Testing.expect(sourceTestPresence(&domain, &solved, savedValue, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, savedValue, storedSource) == Truth.False,
    "the pre-loop saved copy keeps its actual caller source and excludes the later replacement")
  run Testing.expect(sourceTestPresence(&domain, &solved, current, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, current, storedSource) == Truth.True,
    "the loop read includes entry and replacement sources even when the read was reserved first")
  run Testing.expect(sourceTestPresence(&domain, &solved, aliasValue, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, aliasValue, storedSource) == Truth.True
    && sourceTestPresence(&domain, &solved, aliasValue, unknown) == Truth.True,
    "an earlier loop copy acquires later backedge sources while preserving explicit zero-iteration unknown")
  run Testing.expect(sourceTestPresence(&domain, &solved, finalValue, loanFree) == Truth.True
    && sourceTestPresence(&domain, &solved, finalValue, caller) == Truth.False
    && sourceTestPresence(&domain, &solved, finalValue, storedSource) == Truth.False,
    "a loan-free overwrite is a real definition that kills the old reaching sources")
  run Testing.expect(sourceTestStored(&domain, &solved, savedValue, caller) == Truth.False
    && sourceTestStored(&domain, &solved, aliasValue, storedSource) == Truth.True,
    "stored loss follows the actual loop copy and cannot travel backward into the saved value")
  run Testing.expect(sourceTestPresence(&domain, &solved, filteredCopy, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, filteredCopy, storedSource) == Truth.False
    && sourceTestPresence(&domain, &solved, filteredCopy, unknown) == Truth.Undefined,
    "one physical result has separate decisions for each source and retains unresolved source applicability downstream")
  let positions = Vector<Input>.asSlice(&inputs)
  let mut position = usize.ZERO
  let mut present = usize.ZERO
  let mut callerPositions = usize.ZERO
  let mut direct = false
  let mut indirect = false
  while position < positions.length {
    if Solution.truth(&solved, positions[position].quality.present) == Truth.True {
      present = present + usize.ONE
      if positions[position].leaf.index == caller.index {
        callerPositions = callerPositions + usize.ONE
        let histories = Vector<InputCase>.asSlice(&positions[position].cases)
        let mut history = usize.ZERO
        while history < histories.length {
          if Solution.truth(&solved, histories[history].quality.present) == Truth.True {
            if histories[history].direct { direct = true } else { indirect = true }
          }
          history = history + usize.ONE
        }
      }
    }
    position = position + usize.ONE
  }
  run Testing.expect(present == 3 && callerPositions == usize.ONE && direct && indirect,
    "branch histories keep paired directness but do not multiply one physical read into duplicate inputs")
  return ()
}

effect fn sourceTestValue(skeleton: &mut Skeleton, point: PointId, endpoint: usize) -> ValueId
! OutOfMemoryError ? &mut Allocator {
  let node = NodeId {index: Vector<Evaluation>.length(&skeleton.evaluations)}
  let evaluation = run Skeleton.evaluate(&mut skeleton.*, node, EvaluationRole.Value, point)
  return run Skeleton.value(&mut skeleton.*, evaluation, EndpointId {index: endpoint})
}

effect fn sourceTestMap(maps: &mut Vector<SelectionMap>, source: usize, target: usize) -> MapId
! OutOfMemoryError ? &mut Allocator {
  let id = MapId {index: Vector<SelectionMap>.length(&maps.*)}
  run Vector<SelectionMap>.append(&mut maps.*, SelectionMap {site: NodeId {index: 0},
    origin: Origin {node: 0, location: Location.make(0, 1)}, source: EndpointId {index: source},
    target: EndpointId {index: target}, selector: Selector.Identity, kind: MapKind.Copy,
    application: Option<ApplicationId>.none(), children: Vector<MapId>.make(),
    componentTransport: false, addressTransport: false, boundaries: Vector<Prepared.BoundaryTransitionId>.make()})
  return id
}

fn sourceTestPresence(domain: &Domain, solved: &Solution, value: ValueId, leaf: LeafId) -> Truth {
  let keys = Vector<CellKey>.asSlice(&domain.keys)
  let cells = Vector<Cell>.asSlice(&domain.cells)
  let mut result = Truth.False
  let mut at = usize.ZERO
  while at < keys.length {
    if keys[at].value.index == value.index && keys[at].leaf.index == leaf.index {
      let present = Solution.truth(solved, cells[at].present)
      if present == Truth.True { return Truth.True }
      if present == Truth.Undefined { result = Truth.Undefined }
    }
    at = at + usize.ONE
  }
  return result
}

fn sourceTestStored(domain: &Domain, solved: &Solution, value: ValueId, leaf: LeafId) -> Truth {
  let keys = Vector<CellKey>.asSlice(&domain.keys)
  let cells = Vector<Cell>.asSlice(&domain.cells)
  let mut result = Truth.False
  let mut at = usize.ZERO
  while at < keys.length {
    if keys[at].value.index == value.index && keys[at].leaf.index == leaf.index {
      let stored = Solution.truth(solved, cells[at].stored)
      if stored == Truth.True { return Truth.True }
      if stored == Truth.Undefined { result = Truth.Undefined }
    }
    at = at + usize.ONE
  }
  return result
}

test effect fn sourceProducerReferencesKeepDescriptorAndReferentSeparate() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceReferenceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Tests the reservation/rule contract, not a Silk source-program verdict. Two component
// sources deliberately share the same prepared shape coordinate: only the explicit maps
// may place them. A same-site map outside the chosen family must not be inferred as a lane.
effect fn sourceReferenceClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut skeleton = Skeleton.make()
  let yes = Program.atom(&mut skeleton.rules)
  let no = Program.atom(&mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, yes)
  let start = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let construct = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let copied = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, Flow.reachable(&skeleton.flow, start))
  run Flow.edge(&mut skeleton.flow, start, construct, yes)
  run Flow.edge(&mut skeleton.flow, construct, copied, yes)
  let source = run Skeleton.evaluate(&mut skeleton, NodeId {index: 0}, EvaluationRole.Value, start)
  let output = run Skeleton.evaluate(&mut skeleton, NodeId {index: 1}, EvaluationRole.Capture, construct)
  let copy = run Skeleton.evaluate(&mut skeleton, NodeId {index: 2}, EvaluationRole.Value, copied)
  let mut endpoints = Vector<Endpoint>.make()
  let origin = Origin {node: 0, location: Location.make(0, 1)}
  // 0: actual storage C; 1: its value; 2/3: two inline C fields.
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Storage, usize.MAX, Selector.Identity)
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Value, usize.MAX, Selector.Identity)
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Value, 1, Selector.Field {ordinal: 0})
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Value, 1, Selector.Field {ordinal: 1})
  // 4: created &C descriptor; 5: C referent; 6/7: its distinct inline fields.
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, usize.MAX, Selector.Identity)
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, 4, Selector.Referent)
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, 5, Selector.Field {ordinal: 0})
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, 5, Selector.Field {ordinal: 1})
  run sourceTestEndpoint(&mut endpoints, 2, EndpointRole.Value, usize.MAX, Selector.Identity)
  let mut maps = Vector<SelectionMap>.make()
  let descriptor = run sourceTestMap(&mut maps, 0, 4)
  let referent = run sourceTestMap(&mut maps, 1, 5)
  let first = run sourceTestMap(&mut maps, 2, 6)
  let second = run sourceTestMap(&mut maps, 3, 7)
  // This valid standalone map is not in this transfer family.
  drop run sourceTestMap(&mut maps, 2, 7)
  let descriptorCopy = run sourceTestMap(&mut maps, 4, 8)
  let children = Vector<SelectionMap>.asMutSlice(&mut maps)
  let mut mapIndex = usize.ZERO
  while mapIndex < children.length {
    children[mapIndex].site = NodeId {index: 1}
    mapIndex = mapIndex + usize.ONE
  }
  children[descriptorCopy.index].site = NodeId {index: 2}
  run Vector<MapId>.append(&mut children[referent.index].children, first)
  run Vector<MapId>.append(&mut children[referent.index].children, second)
  let held = run Skeleton.value(&mut skeleton, source, EndpointId {index: 2})
  let plain = run Skeleton.value(&mut skeleton, source, EndpointId {index: 3})
  let heldLeaf = run Skeleton.leaf(&mut skeleton, Leaf {
    kind: SourceLeaf.Borrow {loan: 0, node: Option<NodeId>.some(NodeId {index: 0})},
    origin: origin, endpoint: EndpointId {index: 2}})
  let plainLeaf = run Skeleton.leaf(&mut skeleton, Leaf {kind: SourceLeaf.LoanFree {node: NodeId {index: 0}},
    origin: origin, endpoint: EndpointId {index: 3}})
  run Vector<Seed>.append(&mut skeleton.seeds, Seed {value: held, leaf: heldLeaf,
    direct: false, active: yes, stored: no, alternatives: no})
  run Vector<Seed>.append(&mut skeleton.seeds, Seed {value: plain, leaf: plainLeaf,
    direct: true, active: yes, stored: no, alternatives: no})
  let route = InputRoute {read: InputRead.Receiver, map: descriptor, referent: Option<MapId>.some(referent),
    selected: EndpointId {index: 4}, original: EndpointId {index: 4}, transport: Transport.BorrowShared}
  let made = run Skeleton.input(&mut skeleton, Vector<Endpoint>.asSlice(&endpoints),
    Vector<SelectionMap>.asSlice(&maps), &route, source, output, Option<ReferenceAcquisition>.some(ReferenceAcquisition {evaluation: output, loan: 1}), yes)
  let createdLeaf = LeafId {index: 2}
  let copyRoute = InputRoute {read: InputRead.Receiver, map: descriptorCopy, referent: Option<MapId>.none(),
    selected: EndpointId {index: 8}, original: EndpointId {index: 8}, transport: Transport.Copy}
  let forwarded = run Skeleton.input(&mut skeleton, Vector<Endpoint>.asSlice(&endpoints),
    Vector<SelectionMap>.asSlice(&maps), &copyRoute, output, copy, Option<ReferenceAcquisition>.none(), yes)
  let one = run Skeleton.value(&mut skeleton, output, EndpointId {index: 6})
  let two = run Skeleton.value(&mut skeleton, output, EndpointId {index: 7})
  let reaching = run Flow.emit(move skeleton.flow, &mut skeleton.rules)
  let domain = run reserveDomain(&mut skeleton.rules, &reaching, Vector<Evaluation>.asSlice(&skeleton.evaluations),
    Vector<Value>.asSlice(&skeleton.values), Vector<Seed>.asSlice(&skeleton.seeds), Vector<Transfer>.asSlice(&skeleton.transfers))
  let inputs = run inputPositions(&mut skeleton.rules, one, Vector<Leaf>.length(&skeleton.leaves),
    Vector<Value>.asSlice(&skeleton.values), Vector<CellKey>.asSlice(&domain.keys), Vector<Cell>.asSlice(&domain.cells),
    Vector<Witness>.asSlice(&domain.witnesses), Vector<Case>.asSlice(&domain.cases))
  let solved = run Program.solve(&skeleton.rules)
  run Testing.expect(sourceTestPresence(&domain, &solved, made, createdLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, made, heldLeaf) == Truth.False,
    "a created reference is one new descriptor source, not a copied C value")
  run Testing.expect(sourceTestPresence(&domain, &solved, one, heldLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, two, heldLeaf) == Truth.False
    && sourceTestPresence(&domain, &solved, two, plainLeaf) == Truth.True,
    "only the paired referent family carries C's fields; same-site equal-shape siblings stay distinct")
  run Testing.expect(sourceTestPresence(&domain, &solved, forwarded, createdLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, forwarded, heldLeaf) == Truth.False
    && Vector<Leaf>.length(&skeleton.leaves) == 3,
    "copying the descriptor forwards its original borrow rather than creating or flattening another reference")
  let positions = Vector<Input>.asSlice(&inputs)
  let mut at = usize.ZERO
  let mut indirect = false
  while at < positions.length {
    if positions[at].leaf.index == heldLeaf.index {
      let cases = Vector<InputCase>.asSlice(&positions[at].cases)
      let mut each = usize.ZERO
      while each < cases.length {
        if !cases[each].direct { indirect = true }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(indirect, "reference creation does not upgrade the carried referent's indirect history")
  return ()
}

effect fn sourceTestEndpoint(endpoints: &mut Vector<Endpoint>, node: usize, role: EndpointRole,
  parent: usize, selector: Selector) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut ancestor = Option<EndpointId>.none()
  if parent != usize.MAX { ancestor = Option<EndpointId>.some(EndpointId {index: parent}) }
  run Vector<Endpoint>.append(&mut endpoints.*, Endpoint {root: Root.Node {node: NodeId {index: node}, role: role},
    parent: move ancestor, selector: move selector, shape: ShapeId {index: 0},
    origin: Origin {node: node, location: Location.make(0, 1)}})
  return ()
}

test effect fn sourceQueriesDistinguishUnreachableMissingAndUngrounded() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceQueryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Exercises the actual stamped query API on a tiny complete body. This is source-analysis
// protocol evidence, not acceptance of zero-length indexing or a Semantic publication path.
effect fn sourceQueryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"source", b"query-coverage.silk")
  let owner = run DeclarationId.fromParts(move module, Vector<OwnerStep>.make())
  let unit = run Shared<Type>.make(Type.Unit)
  let mut nodes = Vector<Node>.make()
  let mut at = usize.ZERO
  while at < 5 {
    run Vector<Node>.append(&mut nodes, Node {origin: Origin {node: at, location: Location.make(at, at + usize.ONE)},
      kind: NodeKind.Expression {ty: Shared<Type>.clone(&unit), form: Expression.Unit}})
    at = at + usize.ONE
  }
  let locals = Vector<Local>.make()
  let supplied = Vector<Shared<Lifetime>>.make()
  let obligations = Vector<SafetyObligation>.make()
  let premises = Vector<Prepared.RegionBound>.make()
  let body = Prepared.Body {owner: &owner, supplied: Vector<Shared<Lifetime>>.asSlice(&supplied),
    locals: Vector<Local>.asSlice(&locals), nodes: Vector<Node>.asSlice(&nodes), root: NodeId {index: 0}, pending: false,
    obligations: Vector<SafetyObligation>.asSlice(&obligations), premises: Vector<Prepared.RegionBound>.asSlice(&premises),
    coverage: Coverage.Complete}
  let prepared = run sourceQueryPreparation(move body, &unit)
  let graph = run Builder.solve(run Builder.reserve(move prepared, run sourceQuerySkeleton()))
  let actual = run querySources(&graph, 0)
  run Testing.expect(actual.complete && Vector<SourceAlternative>.length(&actual.alternatives) == usize.ONE
    && Vector<SourceGap>.length(&actual.gaps) == usize.ZERO,
    "a positively loan-free value has an actual complete source, not an empty success")
  let leaf = Graph.leaf(&graph, &Vector<SourceAlternative>.asSlice(&actual.alternatives)[0].leaf)
  let positive = match move leaf {
    Result<&Leaf, AccessError>.Success {value} => match &value.kind { SourceLeaf.LoanFree {..} => true _ => false }
    _ => false
  }
  run Testing.expect(positive, "query enumeration preserves the explicit loan-free source kind")
  let impossible = run querySources(&graph, 1)
  run Testing.expect(impossible.complete && Vector<SourceAlternative>.length(&impossible.alternatives) == usize.ZERO
    && Vector<SourceGap>.length(&impossible.gaps) == usize.ZERO
    && Vector<SourceEvaluation>.length(&impossible.evaluations) == usize.ONE
    && Vector<SourceEvaluation>.asSlice(&impossible.evaluations)[0].reachable == Truth.False,
    "an actual impossible-success evaluation has no source and is distinguished by explicit false reachability")
  let missing = run querySources(&graph, 2)
  run Testing.expect(!missing.complete && Vector<SourceEvaluation>.length(&missing.evaluations) == usize.ZERO
    && hasSourceGap(&missing, SourceGap.MissingEvaluation),
    "no evaluation cannot stand in for a proved unreachable evaluation")
  let ungrounded = run querySources(&graph, 3)
  run Testing.expect(!ungrounded.complete && hasSourceGap(&ungrounded, SourceGap.Ungrounded)
    && !hasSourceGap(&ungrounded, SourceGap.MissingEvaluation),
    "a real reachable evaluation without a represented source remains an explicit gap")
  let unresolved = run querySources(&graph, 4)
  run Testing.expect(!unresolved.complete && hasSourceGap(&unresolved, SourceGap.UnresolvedApplicability)
    && Vector<SourceEvaluation>.asSlice(&unresolved.evaluations)[0].reachable == Truth.Undefined,
    "unresolved runtime applicability cannot certify the unreachable case")
  let recoveryBody = Prepared.Body {owner: &owner, supplied: Vector<Shared<Lifetime>>.asSlice(&supplied),
    locals: Vector<Local>.asSlice(&locals), nodes: Vector<Node>.asSlice(&nodes), root: NodeId {index: 0}, pending: false,
    obligations: Vector<SafetyObligation>.asSlice(&obligations), premises: Vector<Prepared.RegionBound>.asSlice(&premises),
    coverage: Coverage.Recovery}
  let recovery = run Builder.solve(run Builder.reserve(run sourceQueryPreparation(move recoveryBody, &unit), run sourceQuerySkeleton()))
  let partial = run querySources(&recovery, 0)
  run Testing.expect(!partial.complete && hasSourceGap(&partial, SourceGap.Recovery),
    "grounded source enumeration from recovery never certifies complete-body coverage")
  let foreign = SourceQuery {read: NodeId {index: 0}, selection: querySelection(&graph, 0)}
  let rejected = run Graph.sourcesAt(&recovery, &foreign)
  let foreignStamp = match move rejected {
    Result<Sources, AccessError>.Failure {error} => error == AccessError.ForeignAnalysis
    _ => false
  }
  run Testing.expect(foreignStamp, "another analysis of the same body cannot reuse a selection certificate")
  return ()
}

effect fn sourceQueryPreparation<'body>(body: Prepared.Body<'body>, ty: &Shared<Type>) -> SourcePreparation<'body>
! OutOfMemoryError ? &mut Allocator {
  let mut shapes = Vector<Prepared.Shape>.make()
  run Vector<Prepared.Shape>.append(&mut shapes, Prepared.Shape {ty: Shared<Type>.clone(ty),
    state: Prepared.ShapeState.KnownEmpty, components: Vector<Prepared.Component>.make()})
  let mut endpoints = Vector<Endpoint>.make()
  let mut selections = Vector<Selection>.make()
  let mut at = usize.ZERO
  while at < body.nodes.length {
    run sourceTestEndpoint(&mut endpoints, at, EndpointRole.Value, usize.MAX, Selector.Identity)
    let mut accepts = Vector<EndpointId>.make()
    run Vector<EndpointId>.append(&mut accepts, EndpointId {index: at})
    run Vector<Selection>.append(&mut selections, Selection {root: EndpointId {index: at},
      accepts: move accepts, maps: Vector<MapId>.make()})
    at = at + usize.ONE
  }
  return SourcePreparation {body: move body, shapes: move shapes, endpoints: move endpoints,
    applications: Vector<Prepared.Application>.make(), maps: Vector<SelectionMap>.make(), selections: move selections,
    residuals: Vector<Prepared.ResidualState>.make(), boundarySubstitutions: Vector<Prepared.BoundarySubstitution>.make(),
    boundaryTransitions: Vector<Prepared.BoundaryTransition>.make(),
    routes: Vector<ContractRoute>.make(), contractSelections: Vector<Prepared.ContractSelection>.make(), borrows: Vector<Prepared.Borrow>.make(), constructions: Vector<Prepared.Construction>.make(), operations: Vector<Prepared.Operation>.make(),
    predicates: Vector<Prepared.Predicate>.make(), premises: Vector<Prepared.PredicateId>.make(), obligations: Vector<Prepared.Obligation>.make()}
}

effect fn sourceQuerySkeleton() -> Skeleton ! OutOfMemoryError ? &mut Allocator {
  let mut skeleton = Skeleton.make()
  let yes = Program.atom(&mut skeleton.rules)
  let no = Program.atom(&mut skeleton.rules)
  let maybe = Program.atom(&mut skeleton.rules)
  let other = Program.atom(&mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, yes)
  let none = Vector<Atom>.make()
  let notOther: [Atom; 1] = [other]
  let notMaybe: [Atom; 1] = [maybe]
  run Program.rule(&mut skeleton.rules, maybe, Vector<Atom>.asSlice(&none), &notOther)
  run Program.rule(&mut skeleton.rules, other, Vector<Atom>.asSlice(&none), &notMaybe)
  let reached = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let unreachable = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let uncertain = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, Flow.reachable(&skeleton.flow, reached))
  run Flow.edge(&mut skeleton.flow, reached, uncertain, maybe)
  let actual = run Skeleton.evaluate(&mut skeleton, NodeId {index: 0}, EvaluationRole.Value, reached)
  drop run Skeleton.evaluate(&mut skeleton, NodeId {index: 1}, EvaluationRole.Value, unreachable)
  drop run Skeleton.evaluate(&mut skeleton, NodeId {index: 3}, EvaluationRole.Value, reached)
  drop run Skeleton.evaluate(&mut skeleton, NodeId {index: 4}, EvaluationRole.Value, uncertain)
  let value = run Skeleton.value(&mut skeleton, actual, EndpointId {index: 0})
  let leaf = run Skeleton.leaf(&mut skeleton, Leaf {kind: SourceLeaf.LoanFree {node: NodeId {index: 0}},
    origin: Origin {node: 0, location: Location.make(0, 1)}, endpoint: EndpointId {index: 0}})
  run Vector<Seed>.append(&mut skeleton.seeds, Seed {value: value, leaf: leaf, direct: false,
    active: yes, stored: no, alternatives: no})
  return move skeleton
}

fn querySelection<'body>(graph: &Graph<'body>, index: usize) -> SelectionId {
  return match move Graph.selection(graph, PreparedSelectionId {index: index}) {
    Result<SelectionId, AccessError>.Success {value} => move value
    _ => { return CompilerBug.panic(b"source query test has no prepared selection") }
  }
}

effect fn querySources<'body>(graph: &Graph<'body>, index: usize) -> Sources ! OutOfMemoryError ? &mut Allocator {
  let query = SourceQuery {read: NodeId {index: index}, selection: querySelection(graph, index)}
  return match move run Graph.sourcesAt(graph, &query) {
    Result<Sources, AccessError>.Success {value} => move value
    _ => { return CompilerBug.panic(b"source query test rejected its own selection") }
  }
}

fn hasSourceGap(sources: &Sources, gap: SourceGap) -> bool {
  let gaps = Vector<SourceGap>.asSlice(&sources.gaps)
  let mut at = usize.ZERO
  while at < gaps.length {
    if gaps[at] == gap { return true }
    at = at + usize.ONE
  }
  return false
}
