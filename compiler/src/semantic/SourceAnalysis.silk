// Reservation-level source semantics, not acceptance of a manually assembled typed body.
// The graph supplies independently observable read results: a saved copy, a backedge alias,
// an explicit unknown entry and a loan-free replacement all need distinct source identities.
test effect fn sourceCopiesKeepEarlierReadsAndAcquireBackedgeDefinitions() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceCopyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sourceCopyClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut skeleton = Skeleton.make()
  let yes = Program.atom(&mut skeleton.rules)
  let no = Program.atom(&mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, yes)
  let entry = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let before = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let save = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let header = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let alias = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let replacement = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let exit = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let reset = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let finalRead = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let savedRead = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let aliasRead = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let otherAlias = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, Flow.reachable(&skeleton.flow, entry))
  run Flow.edge(&mut skeleton.flow, entry, before, yes)
  run Flow.edge(&mut skeleton.flow, before, save, yes)
  run Flow.edge(&mut skeleton.flow, save, header, yes)
  run Flow.edge(&mut skeleton.flow, header, alias, yes)
  run Flow.edge(&mut skeleton.flow, alias, replacement, yes)
  run Flow.edge(&mut skeleton.flow, header, otherAlias, yes)
  run Flow.edge(&mut skeleton.flow, otherAlias, replacement, yes)
  run Flow.edge(&mut skeleton.flow, replacement, header, yes)
  run Flow.edge(&mut skeleton.flow, header, exit, yes)
  run Flow.edge(&mut skeleton.flow, exit, reset, yes)
  run Flow.edge(&mut skeleton.flow, reset, finalRead, yes)
  run Flow.edge(&mut skeleton.flow, finalRead, savedRead, yes)
  run Flow.edge(&mut skeleton.flow, savedRead, aliasRead, yes)

  // Storage component coordinates 0=r, 1=saved, 2=alias. The initial alias is explicitly
  // unknown; reaching no loan at entry must not make the zero-iteration case loan-free.
  let initial = run sourceTestValue(&mut skeleton, entry, 0)
  let initialAlias = run sourceTestValue(&mut skeleton, entry, 2)
  let early = run sourceTestValue(&mut skeleton, before, 3)
  let saved = run sourceTestValue(&mut skeleton, save, 1)
  let current = run sourceTestValue(&mut skeleton, header, 4)
  let copied = run sourceTestValue(&mut skeleton, alias, 2)
  let copiedIndirectly = run sourceTestValue(&mut skeleton, otherAlias, 2)
  let later = run sourceTestValue(&mut skeleton, replacement, 0)
  let cleared = run sourceTestValue(&mut skeleton, reset, 0)
  let finalValue = run sourceTestValue(&mut skeleton, finalRead, 5)
  let savedValue = run sourceTestValue(&mut skeleton, savedRead, 6)
  let aliasValue = run sourceTestValue(&mut skeleton, aliasRead, 7)
  let filtered = run sourceTestValue(&mut skeleton, aliasRead, 8)
  let filteredCopy = run sourceTestValue(&mut skeleton, aliasRead, 9)
  let caller = LeafId {index: 0}
  let storedSource = LeafId {index: 1}
  let unknown = LeafId {index: 2}
  let loanFree = LeafId {index: 3}
  run List<Seed>.append(&mut skeleton.seeds,
    Seed {category: SourceRole.Physical, value: initial, leaf: caller, direct: true, active: yes, stored: no, alternatives: no})
  run List<Seed>.append(&mut skeleton.seeds,
    Seed {category: SourceRole.Physical, value: initialAlias, leaf: unknown, direct: false, active: yes, stored: no, alternatives: no})
  run List<Seed>.append(&mut skeleton.seeds,
    Seed {category: SourceRole.Physical, value: cleared, leaf: loanFree, direct: false, active: yes, stored: no, alternatives: no})
  let replacementWriter = run Skeleton.evaluate(&mut skeleton, NodeId {index: 100}, EvaluationRole.Value, replacement)
  let initialWriter = List<Value>.asSlice(&skeleton.values)[initial.index].evaluation
  let initialDefinition = run Skeleton.define(&mut skeleton, entry, initialWriter, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, initial, yes, Write.Strong)
  let initialAliasWriter = List<Value>.asSlice(&skeleton.values)[initialAlias.index].evaluation
  let unknownDefinition = run Skeleton.define(&mut skeleton, entry, initialAliasWriter, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, initialAlias, yes, Write.Strong)
  let savedWriter = List<Value>.asSlice(&skeleton.values)[saved.index].evaluation
  let savedDefinition = run Skeleton.define(&mut skeleton, save, savedWriter, Storage {endpoint: EndpointId {index: 1}, temporary: Option<EvalId>.none()}, saved, yes, Write.Strong)
  let copiedWriter = List<Value>.asSlice(&skeleton.values)[copied.index].evaluation
  let aliasDefinition = run Skeleton.define(&mut skeleton, alias, copiedWriter, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, copied, yes, Write.Strong)
  let copiedIndirectlyWriter = List<Value>.asSlice(&skeleton.values)[copiedIndirectly.index].evaluation
  let otherAliasDefinition = run Skeleton.define(&mut skeleton, otherAlias, copiedIndirectlyWriter, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, copiedIndirectly, yes, Write.Strong)
  // Deliberately register the read before the later replacement definition. The result must
  // depend on CFG reachability, not on this constructor order.
  let mut maps = List<SelectionMap>.make()
  let earlyMap = run sourceTestMap(&mut maps, 0, 3)
  let currentMap = run sourceTestMap(&mut maps, 0, 4)
  let savedMap = run sourceTestMap(&mut maps, 1, 6)
  let aliasMap = run sourceTestMap(&mut maps, 2, 7)
  let finalMap = run sourceTestMap(&mut maps, 0, 5)
  let earlyRead = run Skeleton.read(&mut skeleton, before, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, early, Option<MapId>.some(earlyMap))
  let currentRead = run Skeleton.read(&mut skeleton, header, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, current, Option<MapId>.some(currentMap))
  // Reserve the initial copies before the backedge replacement exists. The unchanged
  // saved/current/cleared source assertions below require stable old gates AND new pairs.
  drop run Skeleton.closeStorage(&mut skeleton)
  let mut domain = Domain.make()
  run extendDomain(&mut domain, &mut skeleton.rules, Flow.reservedPoints(&skeleton.flow), Flow.reservedPairs(&skeleton.flow),
    List<Evaluation>.asSlice(&skeleton.evaluations), List<Value>.asSlice(&skeleton.values),
    List<Seed>.asSlice(&skeleton.seeds), List<Transfer>.asSlice(&skeleton.transfers),
    List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings), List<ReferenceRead>.asSlice(&skeleton.referenceReads), List<SummaryRead>.asSlice(&skeleton.summaryReads), List<MoveHolding>.asSlice(&skeleton.selectedMoves.holdings), List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates))
  // A discovered later source must not change the already reserved caller/read witness IDs.
  run List<Seed>.append(&mut skeleton.seeds,
    Seed {category: SourceRole.Physical, value: later, leaf: storedSource, direct: true, active: yes, stored: yes, alternatives: no})
  let laterWriter = replacementWriter
  let laterDefinition = run Skeleton.define(&mut skeleton, replacement, laterWriter, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, later, yes, Write.Strong)
  let clearedWriter = List<Value>.asSlice(&skeleton.values)[cleared.index].evaluation
  let clearedDefinition = run Skeleton.define(&mut skeleton, reset, clearedWriter, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, cleared, yes, Write.Strong)
  let finalStorageRead = run Skeleton.read(&mut skeleton, finalRead, Storage {endpoint: EndpointId {index: 0}, temporary: Option<EvalId>.none()}, finalValue, Option<MapId>.some(finalMap))
  let savedStorageRead = run Skeleton.read(&mut skeleton, savedRead, Storage {endpoint: EndpointId {index: 1}, temporary: Option<EvalId>.none()}, savedValue, Option<MapId>.some(savedMap))
  let aliasStorageRead = run Skeleton.read(&mut skeleton, aliasRead, Storage {endpoint: EndpointId {index: 2}, temporary: Option<EvalId>.none()}, aliasValue, Option<MapId>.some(aliasMap))
  let savingMap = run sourceTestMap(&mut maps, 3, 1)
  let copyingMap = run sourceTestMap(&mut maps, 4, 2)
  run List<Transfer>.append(&mut skeleton.transfers, Transfer { source: early, target: saved,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.Physical {map: savingMap, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
  run List<Transfer>.append(&mut skeleton.transfers, Transfer { source: current, target: copied,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.Physical {map: copyingMap, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
  run List<Transfer>.append(&mut skeleton.transfers, Transfer { source: current, target: copiedIndirectly,
    active: yes, directness: Directness.Indirect, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.Physical {map: copyingMap, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
  // A distinct stored arrival coalesces at the SAME source cell as the ordinary copy.
  // Its policy-observation mask must not erase the ordinary arrival or leak its quality.
  let maskedCopyingMap = run sourceTestMap(&mut maps, 4, 2)
  run List<Transfer>.append(&mut skeleton.transfers, Transfer {source: current, target: copied,
    active: yes, directness: Directness.Preserve, stored: yes, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false,
    authority: TransferAuthority.Physical {map: maskedCopyingMap, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
  let filterMap = run sourceTestMap(&mut maps, 7, 8)
  let afterFilter = run sourceTestMap(&mut maps, 8, 9)
  run List<Transfer>.append(&mut skeleton.transfers, Transfer { source: aliasValue, target: filtered,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Filtered, terminal: false, authority: TransferAuthority.Physical {map: filterMap, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
  run List<Transfer>.append(&mut skeleton.transfers, Transfer { source: filtered, target: filteredCopy,
    active: yes, directness: Directness.Preserve, stored: no, alternatives: no,
    definition: Option<DefinitionId>.none(), read: Option<ReadId>.none(), policy: TransferPolicy.Physical, terminal: false, authority: TransferAuthority.Physical {map: afterFilter, direction: MapDirection.Forward, address: Option<EvalId>.none()}})
  drop run Skeleton.closeStorage(&mut skeleton)
  let mut rules = move skeleton.rules
  let reaching = run Flow.emit(move skeleton.flow, &mut rules)
  let transfers = move skeleton.transfers
  let written = definitionView(&reaching, List<Storage>.asSlice(&skeleton.storage),
    List<DefinedValue>.asSlice(&skeleton.definitions), laterDefinition)
  run Testing.expect(match written.writer {
    Option<EvalId>.Some {value} => value.index == replacementWriter.index
      && value.index != List<Value>.asSlice(&skeleton.values)[later.index].evaluation.index
    _ => false
  }, "definition diagnostics retain the actual writer rather than the stored value occurrence")
  validateStorage(List<SelectionMap>.asSlice(&maps), &reaching, List<Storage>.asSlice(&skeleton.storage),
    List<DefinedValue>.asSlice(&skeleton.definitions), List<ReadValue>.asSlice(&skeleton.reads),
    List<Value>.asSlice(&skeleton.values), List<Evaluation>.asSlice(&skeleton.evaluations))
  run extendDomain(&mut domain, &mut rules, List<Point>.asSlice(&reaching.points), List<Pair>.asSlice(&reaching.pairs),
    List<Evaluation>.asSlice(&skeleton.evaluations), List<Value>.asSlice(&skeleton.values),
    List<Seed>.asSlice(&skeleton.seeds), List<Transfer>.asSlice(&transfers),
    List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings), List<ReferenceRead>.asSlice(&skeleton.referenceReads), List<SummaryRead>.asSlice(&skeleton.summaryReads), List<MoveHolding>.asSlice(&skeleton.selectedMoves.holdings), List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates))
  let inputIndex = run reserveInputIndex(List<Value>.length(&skeleton.values),
    List<CellKey>.asSlice(&domain.keys), List<Case>.asSlice(&domain.cases))
  let inputs = run inputPositions(&mut rules, aliasValue, 4, List<Value>.asSlice(&skeleton.values),
    List<CellKey>.asSlice(&domain.keys), List<Cell>.asSlice(&domain.cells),
    List<Witness>.asSlice(&domain.witnesses), List<Case>.asSlice(&domain.cases), &inputIndex, Option<SourceRole>.none())
  let undecided = Program.atom(&mut rules)
  let opposite = Program.atom(&mut rules)
  let empty = List<Atom>.make()
  let notOpposite: [Atom; 1] = [opposite]
  let notUndecided: [Atom; 1] = [undecided]
  run Program.rule(&mut rules, undecided, List<Atom>.asSlice(&empty), &notOpposite)
  run Program.rule(&mut rules, opposite, List<Atom>.asSlice(&empty), &notUndecided)
  let mut policy = usize.ZERO
  while policy < List<PendingPolicy>.length(&domain.policies) {
    let port = List<PendingPolicy>.asSlice(&domain.policies)[policy].port
    let mut kept = no
    if port.leaf.index == caller.index { kept = yes }
    if port.leaf.index == unknown.index { kept = undecided }
    run bindPolicy(&mut domain.policies, &mut rules, port.id, kept, no, no)
    policy = policy + usize.ONE
  }
  let mut observation = run makeObservationProjection(&mut rules, &domain)
  let cases = List<Case>.asSlice(&domain.cases)
  let mut each = usize.ZERO
  while each < cases.length {
    if let TransferAuthority.Physical {map, ..} = cases[each].authority {
      if map.index == savingMap.index || map.index == maskedCopyingMap.index {
        run Program.fact(&mut rules, List<Atom>.asSlice(&observation.boundaries)[each])
      }
    }
    each = each + usize.ONE
  }
  run emitObservationProjection(&mut observation, &mut rules, &domain)
  let solved = run Program.solve(&rules)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let semantic = List<Cell>.asSlice(&observation.cells)
  let mut mixed = false
  let mut maskedCopy = false
  each = usize.ZERO
  while each < keys.length {
    if keys[each].leaf.index == caller.index {
      if keys[each].value.index == filteredCopy.index && Solution.truth(&solved, semantic[each].present) == Truth.True {
        run Testing.expect(Solution.truth(&solved, semantic[each].stored) == Truth.False,
          "masked stored arrivals cannot contaminate the unmasked semantic copy")
        mixed = true
      }
      if keys[each].value.index == savedValue.index {
        run Testing.expect(Solution.truth(&solved, semantic[each].present) == Truth.False
          && Solution.truth(&solved, List<Atom>.asSlice(&observation.masked)[each]) == Truth.True,
          "semantic masking propagates through actual copies and reads while the raw descriptor survives")
        maskedCopy = true
      }
    }
    each = each + usize.ONE
  }
  run Testing.expect(mixed && maskedCopy,
    "a masked alternative does not remove an unmasked history at the same raw cell")
  run Testing.expect(sourceTestPresence(&domain, &solved, savedValue, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, savedValue, storedSource) == Truth.False,
    "the pre-loop saved copy keeps its actual caller source and excludes the later replacement")
  run Testing.expect(sourceTestPresence(&domain, &solved, current, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, current, storedSource) == Truth.True,
    "the loop read includes entry and replacement sources even when the read was reserved first")
  run Testing.expect(sourceTestPresence(&domain, &solved, aliasValue, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, aliasValue, storedSource) == Truth.True
    && sourceTestPresence(&domain, &solved, aliasValue, unknown) == Truth.True,
    "an earlier loop copy acquires later backedge sources while preserving explicit zero-iteration unknown")
  run Testing.expect(sourceTestPresence(&domain, &solved, finalValue, loanFree) == Truth.True
    && sourceTestPresence(&domain, &solved, finalValue, caller) == Truth.False
    && sourceTestPresence(&domain, &solved, finalValue, storedSource) == Truth.False,
    "a loan-free overwrite is a real definition that kills the old reaching sources")
  run Testing.expect(sourceTestStored(&domain, &solved, savedValue, caller) == Truth.False
    && sourceTestStored(&domain, &solved, aliasValue, storedSource) == Truth.True,
    "stored loss follows the actual loop copy and cannot travel backward into the saved value")
  run Testing.expect(sourceTestPresence(&domain, &solved, filteredCopy, caller) == Truth.True
    && sourceTestPresence(&domain, &solved, filteredCopy, storedSource) == Truth.False
    && sourceTestPresence(&domain, &solved, filteredCopy, unknown) == Truth.Undefined,
    "one physical result has separate decisions for each source and retains unresolved source applicability downstream")
  let positions = List<Input>.asSlice(&inputs)
  let mut position = usize.ZERO
  let mut present = usize.ZERO
  let mut callerPositions = usize.ZERO
  let mut direct = false
  let mut indirect = false
  while position < positions.length {
    if Solution.truth(&solved, positions[position].quality.present) == Truth.True {
      present = present + usize.ONE
      if positions[position].leaf.index == caller.index {
        callerPositions = callerPositions + usize.ONE
        let histories = List<InputCase>.asSlice(&positions[position].cases)
        let mut history = usize.ZERO
        while history < histories.length {
          if Solution.truth(&solved, histories[history].quality.present) == Truth.True {
            if histories[history].direct { direct = true } else { indirect = true }
          }
          history = history + usize.ONE
        }
      }
    }
    position = position + usize.ONE
  }
  run Testing.expect(present == 3 && callerPositions == usize.ONE && direct && indirect,
    "branch histories keep paired directness but do not multiply one physical read into duplicate inputs")
  return ()
}

effect fn sourceTestValue(skeleton: &mut Skeleton, point: PointId, endpoint: usize) -> ValueId
! OutOfMemoryError ? &mut Allocator {
  let node = NodeId {index: List<Evaluation>.length(&skeleton.evaluations)}
  let evaluation = run Skeleton.evaluate(&mut skeleton.*, node, EvaluationRole.Value, point)
  return run Skeleton.value(&mut skeleton.*, evaluation, EndpointId {index: endpoint})
}

effect fn sourceTestMap(maps: &mut List<SelectionMap>, source: usize, target: usize) -> MapId
! OutOfMemoryError ? &mut Allocator {
  let id = MapId {index: List<SelectionMap>.length(&maps.*)}
  run List<SelectionMap>.append(&mut maps.*, SelectionMap {site: NodeId {index: 0},
    origin: Origin {node: 0, location: Location.make(0, 1)}, source: EndpointId {index: source},
    target: EndpointId {index: target}, selector: Selector.Identity, kind: MapKind.Copy,
    application: Option<ApplicationId>.none(), children: List<MapId>.make(),
    componentTransport: false, addressTransport: false, boundaries: List<Prepared.BoundaryTransitionId>.make(), channelStops: List<Prepared.BoundaryStop>.make()})
  return id
}

fn sourceTestPresence(domain: &Domain, solved: &Solution, value: ValueId, leaf: LeafId) -> Truth {
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let mut result = Truth.False
  let mut at = usize.ZERO
  while at < keys.length {
    if keys[at].value.index == value.index && keys[at].leaf.index == leaf.index {
      let present = Solution.truth(solved, cells[at].present)
      if present == Truth.True { return Truth.True }
      if present == Truth.Undefined { result = Truth.Undefined }
    }
    at = at + usize.ONE
  }
  return result
}

fn sourceTestStored(domain: &Domain, solved: &Solution, value: ValueId, leaf: LeafId) -> Truth {
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let mut result = Truth.False
  let mut at = usize.ZERO
  while at < keys.length {
    if keys[at].value.index == value.index && keys[at].leaf.index == leaf.index {
      let stored = Solution.truth(solved, cells[at].stored)
      if stored == Truth.True { return Truth.True }
      if stored == Truth.Undefined { result = Truth.Undefined }
    }
    at = at + usize.ONE
  }
  return result
}

test effect fn sourceProducerReferencesKeepDescriptorAndReferentSeparate() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceReferenceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Tests the reservation/rule contract, not a Silk source-program verdict. Two component
// sources deliberately share the same prepared shape coordinate: only the explicit maps
// may place them. A same-site map outside the chosen family must not be inferred as a lane.
effect fn sourceReferenceClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut skeleton = Skeleton.make()
  let yes = Program.atom(&mut skeleton.rules)
  let no = Program.atom(&mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, yes)
  let start = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let construct = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let copied = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let before = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let overwrite = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let after = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let consume = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let consumedRead = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, Flow.reachable(&skeleton.flow, start))
  run Flow.edge(&mut skeleton.flow, start, construct, yes)
  run Flow.edge(&mut skeleton.flow, construct, copied, yes)
  run Flow.edge(&mut skeleton.flow, copied, before, yes)
  run Flow.edge(&mut skeleton.flow, before, overwrite, yes)
  run Flow.edge(&mut skeleton.flow, overwrite, after, yes)
  run Flow.edge(&mut skeleton.flow, after, consume, yes)
  run Flow.edge(&mut skeleton.flow, consume, consumedRead, yes)
  let source = run Skeleton.evaluate(&mut skeleton, NodeId {index: 0}, EvaluationRole.Value, start)
  let output = run Skeleton.evaluate(&mut skeleton, NodeId {index: 1}, EvaluationRole.Capture, construct)
  let copy = run Skeleton.evaluate(&mut skeleton, NodeId {index: 2}, EvaluationRole.Value, copied)
  let early = run Skeleton.evaluate(&mut skeleton, NodeId {index: 4}, EvaluationRole.Value, before)
  let writer = run Skeleton.evaluate(&mut skeleton, NodeId {index: 3}, EvaluationRole.Replacement, overwrite)
  let late = run Skeleton.evaluate(&mut skeleton, NodeId {index: 4}, EvaluationRole.Value, after)
  let consuming = run Skeleton.evaluate(&mut skeleton, NodeId {index: 4}, EvaluationRole.Value, consume)
  let consumed = run Skeleton.evaluate(&mut skeleton, NodeId {index: 4}, EvaluationRole.Value, consumedRead)
  let mut endpoints = List<Endpoint>.make()
  let origin = Origin {node: 0, location: Location.make(0, 1)}
  // 0: actual storage C; 1: its value; 2/3: two inline C fields.
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Storage, usize.MAX, Selector.Identity)
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Value, usize.MAX, Selector.Identity)
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Value, 1, Selector.Field {ordinal: 0})
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Value, 1, Selector.Field {ordinal: 1})
  // 4: created &C descriptor; 5: C referent; 6/7: its distinct inline fields.
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, usize.MAX, Selector.Identity)
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, 4, Selector.Referent)
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, 5, Selector.Field {ordinal: 0})
  run sourceTestEndpoint(&mut endpoints, 1, EndpointRole.Value, 5, Selector.Field {ordinal: 1})
  run sourceTestEndpoint(&mut endpoints, 2, EndpointRole.Value, usize.MAX, Selector.Identity)
  // Canonical storage fields, the copied descriptor's authored frontier, and read output.
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Storage, 0, Selector.Field {ordinal: 0})
  run sourceTestEndpoint(&mut endpoints, 0, EndpointRole.Storage, 0, Selector.Field {ordinal: 1})
  run sourceTestEndpoint(&mut endpoints, 2, EndpointRole.Value, 8, Selector.Referent)
  run sourceTestEndpoint(&mut endpoints, 2, EndpointRole.Value, 11, Selector.Field {ordinal: 0})
  run sourceTestEndpoint(&mut endpoints, 2, EndpointRole.Value, 11, Selector.Field {ordinal: 1})
  run sourceTestEndpoint(&mut endpoints, 4, EndpointRole.Value, usize.MAX, Selector.Identity)
  run sourceTestEndpoint(&mut endpoints, 4, EndpointRole.Value, 14, Selector.Field {ordinal: 0})
  run sourceTestEndpoint(&mut endpoints, 4, EndpointRole.Value, 14, Selector.Field {ordinal: 1})
  let mut endpoint = usize.ZERO
  while endpoint < List<Endpoint>.length(&endpoints) {
    let actual = &mut List<Endpoint>.asMutSlice(&mut endpoints)[endpoint]
    if let Selector.Field {..} = &actual.selector { actual.shape = ShapeId {index: 1} }
    if endpoint == 4 || endpoint == 8 { actual.shape = ShapeId {index: 2} }
    endpoint = endpoint + usize.ONE
  }
  let mut maps = List<SelectionMap>.make()
  let descriptor = run sourceTestMap(&mut maps, 0, 4)
  let referent = run sourceTestMap(&mut maps, 1, 5)
  let first = run sourceTestMap(&mut maps, 2, 6)
  let second = run sourceTestMap(&mut maps, 3, 7)
  // This valid standalone map is not in this transfer family.
  drop run sourceTestMap(&mut maps, 2, 7)
  let descriptorCopy = run sourceTestMap(&mut maps, 4, 8)
  let materialize = run sourceTestMap(&mut maps, 1, 0)
  let materializeFirst = run sourceTestMap(&mut maps, 2, 9)
  let materializeSecond = run sourceTestMap(&mut maps, 3, 10)
  let read = run sourceTestMap(&mut maps, 11, 14)
  let readFirst = run sourceTestMap(&mut maps, 12, 15)
  let readSecond = run sourceTestMap(&mut maps, 13, 16)
  let consumeFirst = run sourceTestMap(&mut maps, 9, 15)
  let selector = run sourceTestMap(&mut maps, 8, 11)
  let firstSelector = run sourceTestMap(&mut maps, 11, 12)
  let secondSelector = run sourceTestMap(&mut maps, 11, 13)
  let children = List<SelectionMap>.asMutSlice(&mut maps)
  let mut mapIndex = usize.ZERO
  while mapIndex < children.length {
    children[mapIndex].site = NodeId {index: 1}
    children[mapIndex].kind = MapKind.Place
    children[mapIndex].componentTransport = true
    mapIndex = mapIndex + usize.ONE
  }
  children[descriptor.index].componentTransport = false
  children[descriptorCopy.index].site = NodeId {index: 2}
  children[descriptorCopy.index].kind = MapKind.Copy
  mapIndex = materialize.index
  while mapIndex <= materializeSecond.index { children[mapIndex].site = NodeId {index: 0} mapIndex = mapIndex + usize.ONE }
  mapIndex = read.index
  while mapIndex < children.length { children[mapIndex].site = NodeId {index: 4} children[mapIndex].kind = MapKind.Copy mapIndex = mapIndex + usize.ONE }
  children[selector.index].selector = Selector.Referent
  children[firstSelector.index].selector = Selector.Field {ordinal: 0}
  children[secondSelector.index].selector = Selector.Field {ordinal: 1}
  mapIndex = selector.index
  while mapIndex < children.length { children[mapIndex].kind = MapKind.Select children[mapIndex].componentTransport = false mapIndex = mapIndex + usize.ONE }
  run List<MapId>.append(&mut children[materialize.index].children, materializeFirst)
  run List<MapId>.append(&mut children[materialize.index].children, materializeSecond)
  run List<MapId>.append(&mut children[read.index].children, readFirst)
  run List<MapId>.append(&mut children[read.index].children, readSecond)
  run List<MapId>.append(&mut children[referent.index].children, first)
  run List<MapId>.append(&mut children[referent.index].children, second)
  let held = run Skeleton.value(&mut skeleton, source, EndpointId {index: 2})
  let plain = run Skeleton.value(&mut skeleton, source, EndpointId {index: 3})
  let heldLeaf = run Skeleton.leaf(&mut skeleton, Leaf {
    kind: SourceLeaf.Borrow {loan: 0, node: Option<NodeId>.some(NodeId {index: 0})},
    origin: origin, endpoint: EndpointId {index: 2}})
  let plainLeaf = run Skeleton.leaf(&mut skeleton, Leaf {kind: SourceLeaf.LoanFree {node: NodeId {index: 0}},
    origin: origin, endpoint: EndpointId {index: 3}})
  run List<Seed>.append(&mut skeleton.seeds, Seed {category: SourceRole.Physical, value: held, leaf: heldLeaf,
    direct: false, active: yes, stored: no, alternatives: no})
  run List<Seed>.append(&mut skeleton.seeds, Seed {category: SourceRole.Physical, value: plain, leaf: plainLeaf,
    direct: true, active: yes, stored: no, alternatives: no})
  run Skeleton.materialize(&mut skeleton, List<Endpoint>.asSlice(&endpoints), List<SelectionMap>.asSlice(&maps),
    materialize, source, source, yes)
  let route = InputRoute {read: InputRead.Receiver, map: descriptor, referent: Option<MapId>.some(referent),
    selected: EndpointId {index: 4}, original: EndpointId {index: 4}, transport: Transport.BorrowShared}
  let made = run Skeleton.input(&mut skeleton, List<Endpoint>.asSlice(&endpoints),
    List<SelectionMap>.asSlice(&maps), &route, source, output, Option<ReferenceAcquisition>.some(ReferenceAcquisition {evaluation: output, loan: 1}), yes)
  let createdLeaf = LeafId {index: 2}
  let copyRoute = InputRoute {read: InputRead.Receiver, map: descriptorCopy, referent: Option<MapId>.none(),
    selected: EndpointId {index: 8}, original: EndpointId {index: 8}, transport: Transport.Copy}
  let forwarded = run Skeleton.input(&mut skeleton, List<Endpoint>.asSlice(&endpoints),
    List<SelectionMap>.asSlice(&maps), &copyRoute, output, copy, Option<ReferenceAcquisition>.none(), yes)
  let snapshotOne = run Skeleton.value(&mut skeleton, output, EndpointId {index: 6})
  let snapshotTwo = run Skeleton.value(&mut skeleton, output, EndpointId {index: 7})
  let one = run Skeleton.value(&mut skeleton, early, EndpointId {index: 15})
  let two = run Skeleton.value(&mut skeleton, early, EndpointId {index: 16})
  let laterOne = run Skeleton.value(&mut skeleton, late, EndpointId {index: 15})
  let laterTwo = run Skeleton.value(&mut skeleton, late, EndpointId {index: 16})
  let movedField = run Skeleton.value(&mut skeleton, consuming, EndpointId {index: 15})
  let consumedField = run Skeleton.value(&mut skeleton, consumed, EndpointId {index: 15})
  // The read and invalidation deliberately share an Eval, canonical component and point.
  // The real alias path must consume its Input, not the tombstone's canonical Output.
  run Skeleton.readAliases(&mut skeleton, List<Endpoint>.asSlice(&endpoints), List<SelectionMap>.asSlice(&maps),
    consumeFirst, source, consuming, yes)
  run Skeleton.invalidateAliases(&mut skeleton, List<Endpoint>.asSlice(&endpoints), source,
    EndpointId {index: 9}, consuming, origin, yes)
  run Skeleton.readAliases(&mut skeleton, List<Endpoint>.asSlice(&endpoints), List<SelectionMap>.asSlice(&maps),
    consumeFirst, source, consumed, yes)
  let replacement = run Skeleton.value(&mut skeleton, writer, EndpointId {index: 9})
  let replacementLeaf = run Skeleton.leaf(&mut skeleton, Leaf {
    kind: SourceLeaf.Borrow {loan: 2, node: Option<NodeId>.some(NodeId {index: 3})}, origin: origin, endpoint: EndpointId {index: 9}})
  run List<Seed>.append(&mut skeleton.seeds, Seed {category: SourceRole.Physical, value: replacement, leaf: replacementLeaf,
    direct: false, active: yes, stored: no, alternatives: no})
  drop run Skeleton.define(&mut skeleton, overwrite, writer,
    Storage {endpoint: EndpointId {index: 9}, temporary: Option<EvalId>.some(source)}, replacement, yes, Write.Strong)
  let module = run ModuleId.make(b"test", b"source", b"reference-current-read.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let unit = run Shared<Type>.make(Type.Unit)
  let lifetime = run Shared<Lifetime>.make(Lifetime.Static)
  let field = run Shared<Type>.make(Type.Reference {referent: Shared<Type>.clone(&unit), access: ReferenceAccess.Shared,
    lifetime: Shared<Lifetime>.clone(&lifetime)})
  let mut fields = List<Shared<Type>>.make()
  run List<Shared<Type>>.append(&mut fields, Shared<Type>.clone(&field))
  run List<Shared<Type>>.append(&mut fields, Shared<Type>.clone(&field))
  let occurrence = run Shared<AnonymousOccurrence>.make(AnonymousOccurrence {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&owner)),
    syntax: 0, positional: true, labels: List<Bytes>.make()})
  let aggregate = run Shared<Type>.make(Type.Anonymous {occurrence: move occurrence, members: move fields})
  let reference = run Shared<Type>.make(Type.Reference {referent: Shared<Type>.clone(&aggregate), access: ReferenceAccess.Shared,
    lifetime: move lifetime})
  // The owning body header supplies context only: this is a frozen reservation actor test,
  // not Semantic acceptance of a handwritten body or declaration.
  let nodes = List<Node>.make()
  let locals = List<Local>.make()
  let supplied = List<Shared<Lifetime>>.make()
  let obligations = List<SafetyObligation>.make()
  let premises = List<Prepared.RegionBound>.make()
  let constraints = List<Constraint>.make()
  let body = Prepared.Body {owner: &owner, supplied: List<Shared<Lifetime>>.asSlice(&supplied),
    locals: List<Local>.asSlice(&locals), nodes: List<Node>.asSlice(&nodes), root: NodeId {index: 0}, pending: false,
    obligations: List<SafetyObligation>.asSlice(&obligations), premises: List<Prepared.RegionBound>.asSlice(&premises),
    constraints: List<Constraint>.asSlice(&constraints), coverage: Coverage.Complete}
  let prepared = run sourceReferencePreparation(move body, &unit, &field, &aggregate, &reference,
    move endpoints, move maps, selector, firstSelector, secondSelector, descriptorCopy, referent)
  validateResiduals(&prepared)
  let reads: [EvalId; 2] = [early, late]
  let mut reading = usize.ZERO
  while reading < reads.length {
    let mut selectors = List<MapId>.make()
    run List<MapId>.append(&mut selectors, selector)
    run List<SelectionUse>.append(&mut skeleton.selections, SelectionUse {operand: copy, result: reads[reading],
      selection: PreparedSelectionId {index: 0}, selectors: move selectors, value: Option<MapId>.some(read),
      place: Option<MapId>.none(), strength: Write.Weak, active: yes})
    reading = reading + usize.ONE
  }
  run Skeleton.activateSelections(&mut skeleton, &prepared)
  let mut domain = Domain.make()
  let mut descriptors = DescriptorClosure.make()
  let mut extending = true
  let mut emitted = usize.ZERO
  while extending {
    let aliases = run Skeleton.activateAliasOperations(&mut skeleton, List<Endpoint>.asSlice(&prepared.endpoints), List<SelectionMap>.asSlice(&prepared.maps))
    let transports = run Skeleton.activateAliasTransports(&mut skeleton, List<SelectionMap>.asSlice(&prepared.maps))
    let references = run reserveReferenceObservations(&prepared, &mut skeleton)
    let holdings = run reserveReferenceHoldings(&prepared, &mut skeleton)
    let storage = run Skeleton.closeStorage(&mut skeleton)
    let transfers = List<Transfer>.length(&skeleton.transfers)
    run extendDomain(&mut domain, &mut skeleton.rules, Flow.reservedPoints(&skeleton.flow), Flow.reservedPairs(&skeleton.flow),
      List<Evaluation>.asSlice(&skeleton.evaluations), List<Value>.asSlice(&skeleton.values),
      List<Seed>.asSlice(&skeleton.seeds), List<Transfer>.asSlice(&skeleton.transfers),
      List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings), List<ReferenceRead>.asSlice(&skeleton.referenceReads), List<SummaryRead>.asSlice(&skeleton.summaryReads), List<MoveHolding>.asSlice(&skeleton.selectedMoves.holdings), List<FieldReholdCandidate>.asSlice(&skeleton.fieldReholds.candidates))
    let carried = run closeDescriptors(&mut descriptors, &prepared, &mut skeleton, &domain)
    extending = aliases || transports || references || holdings || storage || carried || transfers != emitted
    emitted = transfers
  }
  validateReferenceHoldings(&prepared, &skeleton)
  run sealReferenceHoldingCoverage(&mut skeleton, &domain)
  // Policy admits one inherited holding at its exact Referent/Field path. The physical
  // descriptor and the inherited loan then coexist at both descriptor occurrences.
  let mut policy = usize.ZERO
  while policy < List<PendingPolicy>.length(&domain.policies) {
    let port = List<PendingPolicy>.asSlice(&domain.policies)[policy].port
    let candidate = match port.authority { TransferAuthority.ReferenceHolding {candidate} => candidate
      _ => { return CompilerBug.panic(b"reference fixture acquired an unrelated policy port") } }
    let holding = List<ReferenceHolding>.asSlice(&skeleton.referenceHoldings)[candidate]
    let selected = match holding.placement {
      OwnershipPlacement.Known {suffix: Option<OwnershipSuffix>.Some {value}, ..} => value.endpoint.index == 6
      _ => false
    }
    let mut kept = no
    if port.leaf.index == heldLeaf.index && selected { kept = yes }
    run Testing.expect(port.category == SourceRole.Physical && port.outputRole == SourceRole.Ownership,
      "reference publication changes only the explicit ownership role")
    run bindPolicy(&mut domain.policies, &mut skeleton.rules, port.id, kept, no, no)
    policy = policy + usize.ONE
  }
  drop run Flow.emit(move skeleton.flow, &mut skeleton.rules)
  let inputIndex = run reserveInputIndex(List<Value>.length(&skeleton.values),
    List<CellKey>.asSlice(&domain.keys), List<Case>.asSlice(&domain.cases))
  let inputs = run inputPositions(&mut skeleton.rules, one, List<Leaf>.length(&skeleton.leaves),
    List<Value>.asSlice(&skeleton.values), List<CellKey>.asSlice(&domain.keys), List<Cell>.asSlice(&domain.cells),
    List<Witness>.asSlice(&domain.witnesses), List<Case>.asSlice(&domain.cases), &inputIndex, Option<SourceRole>.none())
  let solved = run Program.solve(&skeleton.rules)
  run Testing.expect(sourceTestPresence(&domain, &solved, made, createdLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, made, heldLeaf) == Truth.True,
    "a reference retains its new descriptor and the separately admitted inherited ownership")
  run Testing.expect(sourceTestPresence(&domain, &solved, snapshotOne, heldLeaf) == Truth.False
    && sourceTestPresence(&domain, &solved, snapshotTwo, plainLeaf) == Truth.False,
    "acquiring a descriptor does not copy a referent contents snapshot")
  run Testing.expect(sourceTestPresence(&domain, &solved, one, heldLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, two, heldLeaf) == Truth.False
    && sourceTestPresence(&domain, &solved, two, plainLeaf) == Truth.True,
    "a current read follows both exact referent members; the unrelated equal-shape sibling map supplies no source")
  run Testing.expect(sourceTestPresence(&domain, &solved, forwarded, createdLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, forwarded, heldLeaf) == Truth.True
    && List<Leaf>.length(&skeleton.leaves) == 5
    && List<ReferenceOrigin>.length(&skeleton.references) == usize.ONE
    && List<ReferenceOrigin>.asSlice(&skeleton.references)[0].descriptor.index == made.index,
    "copying preserves descriptor and ownership roles; the later invalidation adds only its one tombstone")
  let tombstone = LeafId {index: 4}
  run Testing.expect(match &List<Leaf>.asSlice(&skeleton.leaves)[tombstone.index].kind {
    SourceLeaf.Unknown {reason, ..} => reason == UnknownReason.Uninitialized _ => false
  }, "consuming storage installs its real Uninitialized source")
  run Testing.expect(sourceTestPresence(&domain, &solved, movedField, replacementLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, movedField, heldLeaf) == Truth.False
    && sourceTestPresence(&domain, &solved, movedField, tombstone) == Truth.False,
    "the same-Eval alias read preserves the current source without reading its own invalidation")
  run Testing.expect(sourceTestPresence(&domain, &solved, consumedField, tombstone) == Truth.True
    && sourceTestPresence(&domain, &solved, consumedField, replacementLeaf) == Truth.False
    && sourceTestPresence(&domain, &solved, consumedField, heldLeaf) == Truth.False,
    "a later canonical read sees only Uninitialized, not the moved source republished into its tombstone")
  run Testing.expect(sourceTestPresence(&domain, &solved, laterOne, replacementLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, laterOne, heldLeaf) == Truth.False
    && sourceTestPresence(&domain, &solved, one, replacementLeaf) == Truth.False
    && sourceTestPresence(&domain, &solved, laterTwo, plainLeaf) == Truth.True
    && sourceTestPresence(&domain, &solved, laterTwo, replacementLeaf) == Truth.False,
    "the later read sees the strong overwrite, preserves its sibling, and cannot reuse acquisition or earlier-read contents")
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let mut ownership = false
  let mut physical = false
  let mut cell = usize.ZERO
  while cell < keys.length {
    if keys[cell].value.index == forwarded.index && Solution.truth(&solved, cells[cell].present) == Truth.True {
      if keys[cell].leaf.index == heldLeaf.index {
        run Testing.expect(keys[cell].category == SourceRole.Ownership,
          "a carried loan is never a physical descriptor alternative")
        ownership = true
      }
      if keys[cell].leaf.index == createdLeaf.index {
        run Testing.expect(keys[cell].category == SourceRole.Physical,
          "the genuine descriptor keeps physical identity through its copy")
        physical = true
      }
    }
    cell = cell + usize.ONE
  }
  run Testing.expect(ownership && physical, "the same descriptor occurrence retains both distinct source roles")
  let carriers = CarriersProduct.nodes(&descriptors.product)
  let mut carrier = usize.ZERO
  while carrier < carriers.length {
    run Testing.expect(keys[carriers[carrier].cell].category == SourceRole.Physical,
      "address demand never treats inherited ownership as a missing descriptor route")
    carrier = carrier + usize.ONE
  }
  let positions = List<Input>.asSlice(&inputs)
  let mut at = usize.ZERO
  let mut indirect = false
  let mut direct = false
  while at < positions.length {
    if positions[at].leaf.index == heldLeaf.index {
      let cases = List<InputCase>.asSlice(&positions[at].cases)
      let mut each = usize.ZERO
      while each < cases.length {
        if Solution.truth(&solved, cases[each].quality.present) == Truth.True {
          if cases[each].direct { direct = true } else { indirect = true }
        }
        each = each + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(indirect && !direct, "the current canonical read preserves the held field's indirect history")
  return ()
}

// Frozen actor inputs for the two-field reservation fixture. Semantic preparation itself
// is outside this test: the actual alias/current-read product consumes these exact rows.
effect fn sourceReferencePreparation<'body>(body: Prepared.Body<'body>, unit: &Shared<Type>,
  field: &Shared<Type>, aggregate: &Shared<Type>, reference: &Shared<Type>,
  endpoints: List<Endpoint>, maps: List<SelectionMap>, selector: MapId, firstSelector: MapId,
  secondSelector: MapId, descriptorCopy: MapId, referent: MapId) -> SourcePreparation<'body>
! OutOfMemoryError ? &mut Allocator {
  let mut prepared = run sourceQueryPreparation(move body, unit)
  prepared.endpoints = move endpoints
  prepared.maps = move maps
  prepared.shapes = List<Prepared.Shape>.make()
  let mut fields = List<Prepared.Component>.make()
  let mut ordinal = usize.ZERO
  while ordinal < 2 {
    run List<Prepared.Component>.append(&mut fields, Prepared.Component {selector: Selector.Field {ordinal: ordinal},
      ty: Shared<Type>.clone(field), inline: true, representation: Option<Prepared.RepresentationId>.none()})
    ordinal = ordinal + usize.ONE
  }
  run List<Prepared.Shape>.append(&mut prepared.shapes, Prepared.Shape {context: PreparedShapeContext.Body,
    ty: Shared<Type>.clone(aggregate), state: PreparedShapeState.Inline, components: move fields})
  let mut inner = List<Prepared.Component>.make()
  run List<Prepared.Component>.append(&mut inner, Prepared.Component {selector: Selector.Referent,
    ty: Shared<Type>.clone(unit), inline: false, representation: Option<Prepared.RepresentationId>.none()})
  run List<Prepared.Shape>.append(&mut prepared.shapes, Prepared.Shape {context: PreparedShapeContext.Body,
    ty: Shared<Type>.clone(field), state: PreparedShapeState.Reference, components: move inner})
  let mut outer = List<Prepared.Component>.make()
  run List<Prepared.Component>.append(&mut outer, Prepared.Component {selector: Selector.Referent,
    ty: Shared<Type>.clone(aggregate), inline: false, representation: Option<Prepared.RepresentationId>.none()})
  run List<Prepared.Shape>.append(&mut prepared.shapes, Prepared.Shape {context: PreparedShapeContext.Body,
    ty: Shared<Type>.clone(reference), state: PreparedShapeState.Reference, components: move outer})
  let mut accepts = List<EndpointId>.make()
  run List<EndpointId>.append(&mut accepts, EndpointId {index: 12})
  run List<EndpointId>.append(&mut accepts, EndpointId {index: 13})
  let mut selected = List<MapId>.make()
  run List<MapId>.append(&mut selected, selector)
  run List<MapId>.append(&mut selected, firstSelector)
  run List<MapId>.append(&mut selected, secondSelector)
  prepared.selections = List<Selection>.make()
  run List<Selection>.append(&mut prepared.selections, Selection {site: NodeId {index: 4}, root: EndpointId {index: 8},
    accepts: move accepts, maps: move selected})
  let mut next = List<Prepared.ResidualStateId>.make()
  run List<Prepared.ResidualStateId>.append(&mut next, Prepared.ResidualStateId {index: 1})
  run List<Prepared.ResidualStateId>.append(&mut next, Prepared.ResidualStateId {index: 2})
  run List<Prepared.ResidualState>.append(&mut prepared.residuals, Prepared.ResidualState {
    authority: PreparedResidualAuthority.Authored, selection: PreparedSelectionId {index: 0}, vertex: EndpointId {index: 11},
    input: Prepared.ComponentId {shape: ShapeId {index: 2}, ordinal: 0}, output: ShapeId {index: 0}, accepts: false, next: move next})
  ordinal = usize.ZERO
  while ordinal < 2 {
    run List<Prepared.ResidualState>.append(&mut prepared.residuals, Prepared.ResidualState {
      authority: PreparedResidualAuthority.Authored, selection: PreparedSelectionId {index: 0}, vertex: EndpointId {index: 12 + ordinal},
      input: Prepared.ComponentId {shape: ShapeId {index: 0}, ordinal: ordinal}, output: ShapeId {index: 1}, accepts: true,
      next: List<Prepared.ResidualStateId>.make()})
    run List<Prepared.BoundarySubstitution>.append(&mut prepared.boundarySubstitutions, Prepared.BoundarySubstitution {
      source: ShapeId {index: ordinal}, target: ShapeId {index: ordinal}, form: PreparedBoundarySubstitutionForm.Identity})
    ordinal = ordinal + usize.ONE
  }
  // The copied descriptor pairs the entire authored frontier. The separate referent Place
  // authenticates its field outputs, but is never activated as an acquisition-time copy.
  let mut boundary = usize.ZERO
  while boundary < 5 {
    let mut state = boundary
    let mut map = descriptorCopy
    if boundary >= 3 { state = boundary - 2 map = referent }
    let residual = &List<Prepared.ResidualState>.asSlice(&prepared.residuals)[state]
    let mut next = List<Prepared.BoundaryTransitionId>.make()
    let mut access = Option<ReferenceAccess>.none()
    let mut substitution = usize.ONE
    if boundary == usize.ZERO {
      substitution = usize.ZERO
      access = Option<ReferenceAccess>.some(ReferenceAccess.Shared)
      run List<Prepared.BoundaryTransitionId>.append(&mut next, Prepared.BoundaryTransitionId {index: 1})
      run List<Prepared.BoundaryTransitionId>.append(&mut next, Prepared.BoundaryTransitionId {index: 2})
    }
    run List<Prepared.BoundaryTransition>.append(&mut prepared.boundaryTransitions, Prepared.BoundaryTransition {
      map: map, authority: PreparedBoundaryAuthority.Physical, sourceState: Prepared.ResidualStateId {index: state},
      targetState: Prepared.ResidualStateId {index: state}, source: residual.input, target: residual.input,
      sourceAccess: access, targetAccess: access, substitution: Prepared.BoundarySubstitutionId {index: substitution},
      next: move next, stops: List<Prepared.BoundaryStop>.make()})
    if boundary == usize.ZERO || boundary >= 3 {
      run List<Prepared.BoundaryTransitionId>.append(&mut List<SelectionMap>.asMutSlice(&mut prepared.maps)[map.index].boundaries,
        Prepared.BoundaryTransitionId {index: boundary})
    }
    boundary = boundary + usize.ONE
  }
  return move prepared
}


effect fn sourceTestEndpoint(endpoints: &mut List<Endpoint>, node: usize, category: EndpointRole,
  parent: usize, selector: Selector) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut ancestor = Option<EndpointId>.none()
  if parent != usize.MAX { ancestor = Option<EndpointId>.some(EndpointId {index: parent}) }
  run List<Endpoint>.append(&mut endpoints.*, Endpoint {root: Root.Node {node: NodeId {index: node}, category: category},
    parent: move ancestor, selector: move selector, shape: ShapeId {index: 0},
    origin: Origin {node: node, location: Location.make(0, 1)}})
  return ()
}

test effect fn sourceQueriesDistinguishUnreachableMissingAndUngrounded() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sourceQueryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Exercises the actual stamped query API on a tiny complete body. This is source-analysis
// protocol evidence, not acceptance of zero-length indexing or a Semantic publication path.
effect fn sourceQueryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run ModuleId.make(b"test", b"source", b"query-coverage.silk")
  let owner = run DeclarationId.fromParts(move module, List<OwnerStep>.make())
  let unit = run Shared<Type>.make(Type.Unit)
  let mut nodes = List<Node>.make()
  let mut at = usize.ZERO
  while at < 5 {
    run List<Node>.append(&mut nodes, Node {origin: Origin {node: at, location: Location.make(at, at + usize.ONE)},
      kind: NodeKind.Expression {ty: Shared<Type>.clone(&unit), form: Expression.Unit}})
    at = at + usize.ONE
  }
  let locals = List<Local>.make()
  let supplied = List<Shared<Lifetime>>.make()
  let obligations = List<SafetyObligation>.make()
  let premises = List<Prepared.RegionBound>.make()
  let constraints = List<Constraint>.make()
  let body = Prepared.Body {owner: &owner, supplied: List<Shared<Lifetime>>.asSlice(&supplied),
    locals: List<Local>.asSlice(&locals), nodes: List<Node>.asSlice(&nodes), root: NodeId {index: 0}, pending: false,
    obligations: List<SafetyObligation>.asSlice(&obligations), premises: List<Prepared.RegionBound>.asSlice(&premises),
    constraints: List<Constraint>.asSlice(&constraints), coverage: Coverage.Complete}
  let prepared = run sourceQueryPreparation(move body, &unit)
  let graph = run Builder.solve(run Builder.reserve(move prepared, run sourceQuerySkeleton()))
  let actual = run querySources(&graph, 0)
  run Testing.expect(actual.complete && List<SourceAlternative>.length(&actual.alternatives) == usize.ONE
    && List<SourceGap>.length(&actual.gaps) == usize.ZERO,
    "a positively loan-free value has an actual complete source, not an empty success")
  let leaf = Graph.leaf(&graph, &List<SourceAlternative>.asSlice(&actual.alternatives)[0].leaf)
  let positive = match move leaf {
    Result<&Leaf, AccessError>.Success {value} => match &value.kind { SourceLeaf.LoanFree {..} => true _ => false }
    _ => false
  }
  run Testing.expect(positive, "query enumeration preserves the explicit loan-free source kind")
  let impossible = run querySources(&graph, 1)
  run Testing.expect(impossible.complete && List<SourceAlternative>.length(&impossible.alternatives) == usize.ZERO
    && List<SourceGap>.length(&impossible.gaps) == usize.ZERO
    && List<SourceEvaluation>.length(&impossible.evaluations) == usize.ONE
    && List<SourceEvaluation>.asSlice(&impossible.evaluations)[0].reachable == Truth.False,
    "an actual impossible-success evaluation has no source and is distinguished by explicit false reachability")
  let missing = run querySources(&graph, 2)
  run Testing.expect(!missing.complete && List<SourceEvaluation>.length(&missing.evaluations) == usize.ZERO
    && hasSourceGap(&missing, SourceGap.MissingEvaluation),
    "no evaluation cannot stand in for a proved unreachable evaluation")
  let ungrounded = run querySources(&graph, 3)
  run Testing.expect(!ungrounded.complete && hasSourceGap(&ungrounded, SourceGap.Ungrounded)
    && !hasSourceGap(&ungrounded, SourceGap.MissingEvaluation),
    "a real reachable evaluation without a represented source remains an explicit gap")
  let unresolved = run querySources(&graph, 4)
  run Testing.expect(!unresolved.complete && hasSourceGap(&unresolved, SourceGap.UnresolvedApplicability)
    && List<SourceEvaluation>.asSlice(&unresolved.evaluations)[0].reachable == Truth.Undefined,
    "unresolved runtime applicability cannot certify the unreachable case")
  let recoveryBody = Prepared.Body {owner: &owner, supplied: List<Shared<Lifetime>>.asSlice(&supplied),
    locals: List<Local>.asSlice(&locals), nodes: List<Node>.asSlice(&nodes), root: NodeId {index: 0}, pending: false,
    obligations: List<SafetyObligation>.asSlice(&obligations), premises: List<Prepared.RegionBound>.asSlice(&premises),
    constraints: List<Constraint>.asSlice(&constraints), coverage: Coverage.Recovery}
  let recovery = run Builder.solve(run Builder.reserve(run sourceQueryPreparation(move recoveryBody, &unit), run sourceQuerySkeleton()))
  let partial = run querySources(&recovery, 0)
  run Testing.expect(!partial.complete && hasSourceGap(&partial, SourceGap.Recovery),
    "grounded source enumeration from recovery never certifies complete-body coverage")
  let foreign = SourceQuery {read: NodeId {index: 0}, selection: querySelection(&graph, 0)}
  let rejected = run Graph.sourcesAt(&recovery, &foreign)
  let foreignStamp = match move rejected {
    Result<Sources, AccessError>.Failure {error} => error == AccessError.ForeignAnalysis
    _ => false
  }
  run Testing.expect(foreignStamp, "another analysis of the same body cannot reuse a selection certificate")
  return ()
}

effect fn sourceQueryPreparation<'body>(body: Prepared.Body<'body>, ty: &Shared<Type>) -> SourcePreparation<'body>
! OutOfMemoryError ? &mut Allocator {
  let mut shapes = List<Prepared.Shape>.make()
  run List<Prepared.Shape>.append(&mut shapes, Prepared.Shape {context: PreparedShapeContext.Body, ty: Shared<Type>.clone(ty),
    state: PreparedShapeState.KnownEmpty, components: List<Prepared.Component>.make()})
  let mut endpoints = List<Endpoint>.make()
  let mut selections = List<Selection>.make()
  let mut at = usize.ZERO
  while at < body.nodes.length {
    run sourceTestEndpoint(&mut endpoints, at, EndpointRole.Value, usize.MAX, Selector.Identity)
    let mut accepts = List<EndpointId>.make()
    run List<EndpointId>.append(&mut accepts, EndpointId {index: at})
    run List<Selection>.append(&mut selections, Selection {site: NodeId {index: at}, root: EndpointId {index: at},
      accepts: move accepts, maps: List<MapId>.make()})
    at = at + usize.ONE
  }
  return SourcePreparation {body: move body, shapes: move shapes, endpoints: move endpoints,
    representations: List<Prepared.Representation>.make(),
    applications: List<Prepared.Application>.make(), maps: List<SelectionMap>.make(), selections: move selections,
    residuals: List<Prepared.ResidualState>.make(), boundarySubstitutions: List<Prepared.BoundarySubstitution>.make(),
    boundaryTransitions: List<Prepared.BoundaryTransition>.make(), boundaryLifts: List<Prepared.BoundaryLift>.make(), channelLifts: List<Prepared.ChannelLift>.make(),
    replacements: List<Prepared.Replacement>.make(), arraySlices: List<Prepared.ArraySlice>.make(),
    matchViews: List<Prepared.MatchView>.make(), producerChannels: List<Prepared.ProducerChannel>.make(), invocationViews: List<Prepared.InvocationView>.make(), invocationChannels: List<Prepared.InvocationChannel>.make(),
    routes: List<ContractRoute>.make(), contractSelections: List<Prepared.ContractSelection>.make(),
    contractProjections: List<Prepared.ContractProjection>.make(), contractContinuations: List<Prepared.ContractContinuation>.make(), borrows: List<Prepared.Borrow>.make(), captureReborrows: List<Prepared.CaptureReborrow>.make(), constructions: List<Prepared.Construction>.make(), operations: List<Prepared.Operation>.make(), retentions: List<Prepared.Retention>.make(),
    predicates: List<Prepared.Predicate>.make(), premises: List<Prepared.PredicateId>.make(), obligations: List<Prepared.Obligation>.make()}
}

effect fn sourceQuerySkeleton() -> Skeleton ! OutOfMemoryError ? &mut Allocator {
  let mut skeleton = Skeleton.make()
  let yes = Program.atom(&mut skeleton.rules)
  let no = Program.atom(&mut skeleton.rules)
  let maybe = Program.atom(&mut skeleton.rules)
  let other = Program.atom(&mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, yes)
  let none = List<Atom>.make()
  let notOther: [Atom; 1] = [other]
  let notMaybe: [Atom; 1] = [maybe]
  run Program.rule(&mut skeleton.rules, maybe, List<Atom>.asSlice(&none), &notOther)
  run Program.rule(&mut skeleton.rules, other, List<Atom>.asSlice(&none), &notMaybe)
  let reached = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let unreachable = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  let uncertain = run Flow.point(&mut skeleton.flow, &mut skeleton.rules)
  run Program.fact(&mut skeleton.rules, Flow.reachable(&skeleton.flow, reached))
  run Flow.edge(&mut skeleton.flow, reached, uncertain, maybe)
  let actual = run Skeleton.evaluate(&mut skeleton, NodeId {index: 0}, EvaluationRole.Value, reached)
  drop run Skeleton.evaluate(&mut skeleton, NodeId {index: 1}, EvaluationRole.Value, unreachable)
  drop run Skeleton.evaluate(&mut skeleton, NodeId {index: 3}, EvaluationRole.Value, reached)
  drop run Skeleton.evaluate(&mut skeleton, NodeId {index: 4}, EvaluationRole.Value, uncertain)
  let value = run Skeleton.value(&mut skeleton, actual, EndpointId {index: 0})
  let leaf = run Skeleton.leaf(&mut skeleton, Leaf {kind: SourceLeaf.LoanFree {node: NodeId {index: 0}},
    origin: Origin {node: 0, location: Location.make(0, 1)}, endpoint: EndpointId {index: 0}})
  run List<Seed>.append(&mut skeleton.seeds, Seed {category: SourceRole.Physical, value: value, leaf: leaf, direct: false,
    active: yes, stored: no, alternatives: no})
  return move skeleton
}

fn querySelection<'body>(graph: &Graph<'body>, index: usize) -> SelectionId {
  return match move Graph.selection(graph, PreparedSelectionId {index: index}) {
    Result<SelectionId, AccessError>.Success {value} => move value
    _ => { return CompilerBug.panic(b"source query test has no prepared selection") }
  }
}

effect fn querySources<'body>(graph: &Graph<'body>, index: usize) -> Sources ! OutOfMemoryError ? &mut Allocator {
  let query = SourceQuery {read: NodeId {index: index}, selection: querySelection(graph, index)}
  return match move run Graph.sourcesAt(graph, &query) {
    Result<Sources, AccessError>.Success {value} => move value
    _ => { return CompilerBug.panic(b"source query test rejected its own selection") }
  }
}

fn hasSourceGap(sources: &Sources, gap: SourceGap) -> bool {
  let gaps = List<SourceGap>.asSlice(&sources.gaps)
  let mut at = usize.ZERO
  while at < gaps.length {
    if gaps[at] == gap { return true }
    at = at + usize.ONE
  }
  return false
}
