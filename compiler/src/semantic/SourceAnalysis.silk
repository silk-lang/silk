//! Immutable occurrence-aware source facts from one complete typed-body reservation.
//!
//! CFG definitions, value transfers and policy guards share SourceRules.Program. A solved
//! Graph owns the exact preparation package and a fresh stamp. Public identifiers cannot be
//! applied to another analysis, even after the producing graph is dropped and memory reused.

import semantic.SourcePreparation {
  ApplicationId, ContractRouteId, Coverage, EndpointId, MapId, SelectionId as PreparedSelectionId,
  SourcePreparation, Selection, SelectionMap, ContractRoute, Root, Endpoint, Selector, MapKind,
  InputRoute, InputRead, Transport, EndpointRole, IndexClass, ShapeId,
}
import semantic.SourcePreparation as Prepared
import semantic.SourceResults as Results
import semantic.CallableSchema {OutputTransform, OutputRoot}
import semantic.SourceStores as Stores
import semantic.SourceCarriers as Carriers
import semantic.SourceFlow {ComponentId, Definition, DefinitionId, Flow, PointId, Read, ReadId, Reaching, Point, Pair, Write}
import semantic.SourceRules {Atom, Program, Solution, Truth}
import semantic.TypedBody {Local, LocalId, Node, NodeId, NodeKind, Origin, Expression, AggregateField, SafetyObligation, SourceAnonymousUse, SourceInference}
import semantic.Type {Type}
import semantic.StorageOperation {StorageOperation}
import semantic.Semantic {Constraint}
import hir.Hir {Access as ReferenceAccess, OwnerKind}
import semantic.Lifetime {Lifetime}
import semantic.SourceLocations {Location}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.option {Option}
import silk.ownership {Copy}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.shared {Shared}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.list {List}
import CompilerBug

/// A static evaluation role. Repeated evaluations of the same NodeId have separate EvalIds.
pub enum EvaluationRole { Entry, Value, Receiver, Argument, Capture, Cleanup, Run, Binding, Replacement, Execute }
pub struct EvalId { pub index: usize }
impl Copy for EvalId {}
pub struct ValueId { pub index: usize }
impl Copy for ValueId {}
/// The real acquisition occurrence precedes later operands even when their enclosing call
/// never produces a value. Its loan identity is supplied by the ownership projection.
pub struct ReferenceAcquisition { pub evaluation: EvalId, pub loan: usize }
impl Copy for ReferenceAcquisition {}

pub struct LeafId { pub index: usize }
impl Copy for LeafId {}

pub union SourceLeaf {
  Entry { pub local: LocalId },
  Borrow { pub loan: usize, pub node: Option<NodeId> },
  Expression { pub node: NodeId },
  LoanFree { pub node: NodeId },
  Unknown { pub node: Option<NodeId>, pub reason: UnknownReason },
}
pub enum UnknownReason { OpaqueSource, UnavailableDeclaration, UnsupportedTransfer, Uninitialized }

pub struct Leaf {
  pub kind: SourceLeaf
  pub origin: Origin
  pub endpoint: EndpointId
}

pub union EvaluationSite { Entry { pub local: LocalId }, Node { pub node: NodeId } }
impl Copy for EvaluationSite {}

pub struct Evaluation {
  pub site: EvaluationSite
  pub role: EvaluationRole
  pub point: PointId
}
impl Copy for Evaluation {}

/// One observation at actual execution, distinct from a possibly noncompleting result.
struct Execution { result: EvalId, observation: EvalId }
impl Copy for Execution {}

/// One physical component of an actual value occurrence. Historical alternatives do not add
/// values: they add conditional cases reaching this same port.
pub struct ResidualSubject {
  pub base: ValueId
  pub state: Prepared.ResidualStateId
  /// An operation suffix retains its exact root/current coordinate before any query join.
  pub position: Option<Results.Position>
}
impl Copy for ResidualSubject {}
pub enum ValuePhase { Input, Output, Transport }

/// A private address-composition lane. Equal physical endpoints in different canonical
/// address proofs cannot exchange contents before reaching the actual read/publication.
struct AliasPort { request: usize, alias: usize }
impl Copy for AliasPort {}

pub struct Value {
  pub phase: ValuePhase
  pub evaluation: EvalId
  /// Actual physical anchor. A residual subject selects a finite prepared component without
  /// inventing a recursive endpoint or claiming the anchor's whole contents were copied.
  pub endpoint: EndpointId
  pub subject: Option<ResidualSubject>
  /// An opaque holding below a canonical prefix, not that prefix's physical value.
  pub summary: Option<usize>
  /// A reserved write output is distinct from the current holder observation.
  pub writeHolder: Option<usize>
  cleared: Option<DefinitionId>
  summaryRead: Option<ReadId>
  transport: Option<AliasPort>
}
impl Copy for Value {}

pub enum Directness { Preserve, Direct, Indirect }
pub enum TransferPolicy { Physical, Filtered }

/// A physical value map runs forward. Only an authenticated Storage->Storage address map
/// may run inversely while placing a value into the canonical storage it actually denotes.
pub enum MapDirection { Forward, StorageInverse }

/// A transfer has one correspondence authority. A physical map never stands in for
/// an input binding plus a declaration route plus an applied result projection.
pub union TransferAuthority {
  SameComponent,
  RetainedWrite { pub candidate: usize },
  OrdinarySummary { pub candidate: usize },
  InvocationWrite { pub candidate: usize },
  SummaryRead { pub reading: usize },
  Physical { pub map: MapId, pub direction: MapDirection, pub address: Option<EvalId> },
  OperationResult { pub candidate: Results.Candidate, pub position: Option<Results.Position> },
  /// Current contents through a retained composite address proof, never an invented map.
  Address { pub edge: usize, pub direction: MapDirection },
}
impl Copy for TransferAuthority {}

/// Placement map for policy consumers; a declared output map is only the final leg.
/// Public route traversal exposes the complete OperationRoute instead of claiming one map.
fn authorityMap(authority: TransferAuthority) -> Option<MapId> {
  return match authority {
    TransferAuthority.Physical {map, ..} => Option<MapId>.some(map)
    TransferAuthority.OperationResult {candidate, ..} => Option<MapId>.some(candidate.output)
    _ => Option<MapId>.none()
  }
}
fn authorityContract(authority: TransferAuthority) -> Option<ContractRouteId> {
  return match authority {
    TransferAuthority.OperationResult {candidate, ..} => Option<ContractRouteId>.some(candidate.route)
    _ => Option<ContractRouteId>.none()
  }
}
fn authorityDirection(authority: TransferAuthority) -> MapDirection {
  return match authority { TransferAuthority.Physical {direction, ..} => direction
    TransferAuthority.Address {direction, ..} => direction _ => MapDirection.Forward }
}
fn authorityAddress(authority: TransferAuthority) -> Option<EvalId> {
  return match authority { TransferAuthority.Physical {address, ..} => address _ => Option<EvalId>.none() }
}
fn readAuthority(map: Option<MapId>) -> TransferAuthority {
  return match map {
    Option<MapId>.Some {value} => TransferAuthority.Physical {
      map: value, direction: MapDirection.Forward, address: Option<EvalId>.none()}
    Option<MapId>.None => TransferAuthority.SameComponent
  }
}

/// Actual source/read/definition evidence travels together on each transfer. Placement is the
/// target value's prepared endpoint; source and target are never recovered from region equality.
pub struct Transfer {
  pub source: ValueId
  pub target: ValueId
  pub active: Atom
  pub directness: Directness
  pub stored: Atom
  pub alternatives: Atom
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub policy: TransferPolicy
  pub terminal: bool
  pub authority: TransferAuthority
}

pub struct Seed {
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub active: Atom
  pub stored: Atom
  pub alternatives: Atom
}
impl Copy for Seed {}

/// Canonical storage identity includes the physical temporary occurrence. Reusing a typed
/// NodeId does not make its two evaluated owners the same storage. Local declaration storage
/// has no temporary occurrence; caller/source identity is never inferred from a type or region.
pub struct Storage {
  pub endpoint: EndpointId
  pub temporary: Option<EvalId>
}
impl Copy for Storage {}

fn sameResultPosition(left: Option<Results.Position>, right: Option<Results.Position>) -> bool {
  return match left {
    Option<Results.Position>.Some {value} => match right {
      Option<Results.Position>.Some {value: other} => Results.samePosition(value, other)
      _ => false
    }
    Option<Results.Position>.None => match right { Option<Results.Position>.None => true _ => false }
  }
}

fn sameSubject(left: Option<ResidualSubject>, right: Option<ResidualSubject>) -> bool {
  return match left {
    Option<ResidualSubject>.Some {value} => match right {
      Option<ResidualSubject>.Some {value: other} => value.base.index == other.base.index && value.state.index == other.state.index && sameResultPosition(value.position, other.position)
      _ => false
    }
    Option<ResidualSubject>.None => match right { Option<ResidualSubject>.None => true _ => false }
  }
}

fn valueShape<'body>(prepared: &SourcePreparation<'body>, value: Value) -> ShapeId {
  return match value.subject {
    Option<ResidualSubject>.Some {value: selected} => List<Prepared.ResidualState>.asSlice(&prepared.residuals)[selected.state.index].output
    Option<ResidualSubject>.None => List<Endpoint>.asSlice(&prepared.endpoints)[value.endpoint.index].shape
  }
}

fn sameStorage(left: Storage, right: Storage) -> bool {
  if left.endpoint.index != right.endpoint.index { return false }
  return match left.temporary {
    Option<EvalId>.Some {value} => match right.temporary { Option<EvalId>.Some {value: other} => value.index == other.index _ => false }
    Option<EvalId>.None => match right.temporary { Option<EvalId>.None => true _ => false }
  }
}

/// A definition's value is the actual stored component, after its RHS placement. Entries,
/// loan-free replacements and opaque/unknown values use the same definition representation.
struct DefinedValue {
  definition: DefinitionId
  value: ValueId
  writer: Option<EvalId>
  summary: Option<usize>
  clears: Option<DefinitionId>
}
impl Copy for DefinedValue {}

/// A read supplies its actual storage-to-value map once. Complete definition/read pairing is
/// reserved later, including definitions not yet visited when the read was encountered.
struct ReadValue {
  read: ReadId
  storage: Storage
  value: ValueId
  map: Option<MapId>
  summary: Option<usize>
}
impl Copy for ReadValue {}

/// An actual place occurrence denotes canonical storage through an explicit finite graph of
/// prepared Select maps. This is address identity, not a snapshot of that storage's contents.
pub struct StorageAlias {
  pub evaluation: EvalId
  pub endpoint: EndpointId
  pub storage: Storage
  /// Grounded applicability of this exact address history in the one source program.
  pub active: Atom
  pub write: Write
}

/// Proof edges share finite alias nodes. An edge is not a new physical occurrence or a
/// reaching definition. Only canonical seeds ground the positive address-proof equations.
union AliasAuthority {
  Canonical,
  Project {map: MapId},
  Selected {selection: usize, map: MapId},
  Origin {placement: usize},
  Slice {placement: usize},
}
impl Copy for AliasAuthority {}
struct AliasEdge {
  source: Option<usize>
  target: usize
  authority: AliasAuthority
  active: Atom
}
impl Copy for AliasEdge {}
fn sameAliasAuthority(left: AliasAuthority, right: AliasAuthority) -> bool {
  return match left {
    AliasAuthority.Canonical => match right { AliasAuthority.Canonical => true _ => false }
    AliasAuthority.Project {map} => match right { AliasAuthority.Project {map: other} => map.index == other.index _ => false }
    AliasAuthority.Selected {selection, map} => match right {
      AliasAuthority.Selected {selection: other, map: otherMap} => selection == other && map.index == otherMap.index
      _ => false
    }
    AliasAuthority.Origin {placement} => match right { AliasAuthority.Origin {placement: other} => placement == other _ => false }
    AliasAuthority.Slice {placement} => match right { AliasAuthority.Slice {placement: other} => placement == other _ => false }
  }
}
fn aliasMap(authority: AliasAuthority) -> Option<MapId> {
  return match authority {
    AliasAuthority.Project {map} => Option<MapId>.some(map)
    AliasAuthority.Selected {map, ..} => Option<MapId>.some(map)
    _ => Option<MapId>.none()
  }
}
union AliasConsumer {
  Projection {map: MapId},
  Descriptor {request: usize, path: usize, prefix: usize, edge: usize},
}
impl Copy for AliasConsumer {}
struct AliasTransport {
  // Exact consumer retained at emission, then changed only by its real Input/Output split.
  consumer: Option<ValueId>
  alias: usize
  authority: AliasConsumer
  evaluation: EvalId
  active: Atom
  direction: MapDirection
  closed: usize
}
impl Copy for AliasTransport {}

struct AliasRead { request: usize, read: ReadId }
impl Copy for AliasRead {}

/// Actual selected read correspondence. storage is the requested canonical component,
/// not the post-selection Value endpoint. summary identifies the separately held A;
/// original retains the actual requested B read and its final Copy certificate.
pub struct ReadPlacement {
  /// Summary A is separate from the actual selected B named by storage/map.
  pub summary: Option<usize>
  pub original: ReadId
  pub consumer: ValueId
  pub read: ReadId
  pub storage: Storage
  pub map: MapId
  pub operand: EvalId
  pub result: EvalId
  pub alias: Option<usize>
  pub active: Atom
}
impl Copy for ReadPlacement {}

/// Initial A/B correspondence retained before publication; consumers apply read policy here once.
pub struct SummaryOrigin {
  pub placement: ReadPlacement
  pub definition: DefinitionId
  pub leaf: LeafId
  pub direct: bool
  pub active: Atom
}
impl Copy for SummaryOrigin {}

/// Exact structural correspondence from an initial Copy target component to a current history.
/// Neither endpoint is a new read, and this record does not decide held/read overlap.
pub struct SummaryPublication {
  pub origin: usize
  pub initial: EndpointId
  pub endpoint: EndpointId
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub active: Atom
  cell: usize
}
impl Copy for SummaryPublication {}

pub struct SummaryPublicationGap {
  pub origin: usize
  pub initial: EndpointId
  pub value: ValueId
  pub leaf: LeafId
  pub direct: bool
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub active: Atom
  cell: usize
}
impl Copy for SummaryPublicationGap {}

struct SummaryPublicationEdge { source: usize, target: usize, case: usize, member: Option<MapId> }
struct SummaryPublications {
  origins: List<SummaryOrigin>
  values: List<SummaryPublication>
  edges: List<SummaryPublicationEdge>
  gaps: List<SummaryPublicationGap>
}

// Nodes are bounded by the original read occurrence, actual cell, and frozen endpoint pair.
// Cycles add proof edges; no reaching or history order is recomputed here.
effect fn summaryPublicationNode(product: &mut SummaryPublications, domain: &Domain, rules: &mut Program,
  origin: usize, initial: EndpointId, endpoint: EndpointId, cell: usize) -> usize
! OutOfMemoryError ? &mut Allocator {
  let rows = List<SummaryPublication>.asSlice(&product.values)
  let mut at = usize.ZERO
  while at < rows.length {
    if rows[at].origin == origin && rows[at].initial.index == initial.index
      && rows[at].endpoint.index == endpoint.index && rows[at].cell == cell { return at }
    at = at + usize.ONE
  }
  let key = List<CellKey>.asSlice(&domain.keys)[cell]
  let witness = &List<Witness>.asSlice(&domain.witnesses)[key.witness]
  let result = rows.length
  run List<SummaryPublication>.append(&mut product.values, SummaryPublication {origin: origin,
    initial: initial, endpoint: endpoint, value: key.value, leaf: key.leaf, direct: key.direct,
    definition: witness.definition, read: witness.read, active: Program.atom(&mut rules.*), cell: cell})
  return result
}

effect fn summaryPublicationEdge(product: &mut SummaryPublications, domain: &Domain, rules: &mut Program,
  source: usize, cell: usize, endpoint: EndpointId, case: usize, member: Option<MapId>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let previous = List<SummaryPublication>.asSlice(&product.values)[source]
  let target = run summaryPublicationNode(&mut product.*, domain, &mut rules.*, previous.origin, previous.initial, endpoint, cell)
  run List<SummaryPublicationEdge>.append(&mut product.edges, SummaryPublicationEdge {
    source: source, target: target, case: case, member: member})
  let admitted: [Atom; 2] = [previous.active, List<Case>.asSlice(&domain.cases)[case].active]
  run Program.rule(&mut rules.*, List<SummaryPublication>.asSlice(&product.values)[target].active, &admitted, &[])
  return ()
}

effect fn summaryPublicationGap(product: &mut SummaryPublications, domain: &Domain, rules: &mut Program,
  origin: usize, initial: EndpointId, cell: usize, source: Atom, gate: Atom) -> ()
! OutOfMemoryError ? &mut Allocator {
  let gaps = List<SummaryPublicationGap>.asSlice(&product.gaps)
  let mut index = usize.ZERO
  while index < gaps.length {
    if gaps[index].origin == origin && gaps[index].initial.index == initial.index && gaps[index].cell == cell { break }
    index = index + usize.ONE
  }
  if index == gaps.length {
    let target = List<CellKey>.asSlice(&domain.keys)[cell]
    let witness = &List<Witness>.asSlice(&domain.witnesses)[target.witness]
    run List<SummaryPublicationGap>.append(&mut product.gaps, SummaryPublicationGap {
      origin: origin, initial: initial, value: target.value, leaf: target.leaf,
      direct: target.direct, definition: witness.definition, read: witness.read,
      active: Program.atom(&mut rules.*), cell: cell})
  }
  let admitted: [Atom; 2] = [source, gate]
  run Program.rule(&mut rules.*, List<SummaryPublicationGap>.asSlice(&product.gaps)[index].active, &admitted, &[])
  return ()
}

// An admitted canonical summary write starts a new held placement. Its later original
// summary read supplies A/B authority; carrying a pre-write placement through this boundary
// would attribute the old holder to the new one. The exact policy Case remains the source
// of the new definition, so this does not discharge an unsupported incoming policy.
fn summaryPlacementDefinition(authority: TransferAuthority, target: Value) -> bool {
  let summary = match target.summary { Option<usize>.Some {..} => true _ => false }
  return summary && match authority {
    TransferAuthority.OrdinarySummary {..} => true
    TransferAuthority.RetainedWrite {..} => true
    TransferAuthority.InvocationWrite {..} => true
    _ => false
  }
}

effect fn summaryPublications<'body>(prepared: &SourcePreparation<'body>, reaching: &Reaching,
  storage: &[Storage], definitions: &[DefinedValue], reads: &[ReadValue], values: &[Value], evaluations: &[Evaluation],
  aliases: &[StorageAlias], requests: &[AliasTransport], recorded: &[AliasRead], summaryReads: &[SummaryRead],
  domain: &Domain, rules: &mut Program) -> SummaryPublications ! OutOfMemoryError ? &mut Allocator {
  let mut result = SummaryPublications {origins: List<SummaryOrigin>.make(), values: List<SummaryPublication>.make(),
    edges: List<SummaryPublicationEdge>.make(), gaps: List<SummaryPublicationGap>.make()}
  let endpoints = List<Endpoint>.asSlice(&prepared.endpoints)
  let maps = List<SelectionMap>.asSlice(&prepared.maps)
  let keys = List<CellKey>.asSlice(&domain.keys)
  let cells = List<Cell>.asSlice(&domain.cells)
  let witnesses = List<Witness>.asSlice(&domain.witnesses)
  let cases = List<Case>.asSlice(&domain.cases)
  let mut reading = usize.ZERO
  while reading < summaryReads.length {
    let read = summaryReads[reading].read
    let placements = run readPlacementsByRead(prepared, reaching, storage, reads, values, evaluations,
      aliases, requests, recorded, summaryReads, read)
    let placements = List<ReadPlacement>.asSlice(&placements)
    let mut placement = usize.ZERO
    while placement < placements.length {
      let selected = placements[placement]
      let family = run transferFamily(endpoints, maps, selected.map)
      let members = List<MapId>.asSlice(&family)
      let mut cell = usize.ZERO
      while cell < keys.length {
        let key = keys[cell]
        let witness = &witnesses[key.witness]
        let paired = match witness.read { Option<ReadId>.Some {value} => value.index == read.index _ => false }
        if key.value.index == selected.consumer.index && paired {
          if let Option<DefinitionId>.Some {value: definition} = witness.definition {
            if definition.index >= definitions.length { CompilerBug.panic(b"summary publication has no original definition") }
            let exact = match definitions[definition.index].summary {
              Option<usize>.Some {value} => value == summaryReads[reading].summary
              _ => false
            }
            if !exact { CompilerBug.panic(b"summary publication crossed a canonical summary lane") }
            let origin = List<SummaryOrigin>.length(&result.origins)
            let active = Program.atom(&mut rules.*)
            let admitted: [Atom; 2] = [selected.active, cells[cell].present]
            run Program.rule(&mut rules.*, active, &admitted, &[])
            run List<SummaryOrigin>.append(&mut result.origins, SummaryOrigin {placement: selected,
              definition: definition, leaf: key.leaf, direct: key.direct, active: active})
            let mut member = usize.ZERO
            while member < members.length {
              let endpoint = maps[members[member].index].target
              let node = run summaryPublicationNode(&mut result, domain, &mut rules.*, origin, endpoint, endpoint, cell)
              let seed: [Atom; 1] = [active]
              run Program.rule(&mut rules.*, List<SummaryPublication>.asSlice(&result.values)[node].active, &seed, &[])
              member = member + usize.ONE
            }
          }
        }
        cell = cell + usize.ONE
      }
      placement = placement + usize.ONE
    }
    reading = reading + usize.ONE
  }
  let mut node = usize.ZERO
  while node < List<SummaryPublication>.length(&result.values) {
    let source = List<SummaryPublication>.asSlice(&result.values)[node]
    let mut actual = usize.ZERO
    while actual < cases.length {
      let follows = match cases[actual].source { Option<usize>.Some {value} => value == source.cell _ => false }
      if follows && !summaryPlacementDefinition(cases[actual].authority, values[keys[cases[actual].target].value.index]) {
        let target = keys[cases[actual].target]
        let from = values[source.value.index]
        let into = values[target.value.index]
        let mut mapped = false
        let physical = match from.subject { Option<ResidualSubject>.None => true _ => false }
          && match into.subject { Option<ResidualSubject>.None => true _ => false }
        if physical {
          match cases[actual].authority {
            TransferAuthority.SameComponent => {
              if from.endpoint.index != into.endpoint.index {
                CompilerBug.panic(b"summary publication identity changed its physical component")
              }
              run summaryPublicationEdge(&mut result, domain, &mut rules.*, node, cases[actual].target,
                source.endpoint, actual, Option<MapId>.none())
              mapped = true
            }
            TransferAuthority.Physical {map, direction, ..} => {
              let family = run transferFamily(endpoints, maps, map)
              let members = List<MapId>.asSlice(&family)
              let mut member = usize.ZERO
              while member < members.length {
                let mapping = &maps[members[member].index]
                let mut input = mapping.source
                let mut output = mapping.target
                if direction == MapDirection.StorageInverse { input = mapping.target output = mapping.source }
                if input.index == source.endpoint.index {
                  run summaryPublicationEdge(&mut result, domain, &mut rules.*, node, cases[actual].target,
                    output, actual, Option<MapId>.some(members[member]))
                  mapped = true
                }
                member = member + usize.ONE
              }
            }
            _ => ()
          }
        }
        if !mapped {
          run summaryPublicationGap(&mut result, domain, &mut rules.*, source.origin, source.initial,
            cases[actual].target, source.active, cases[actual].active)
        }
      }
      actual = actual + usize.ONE
    }
    node = node + usize.ONE
  }
  // A lost placement must survive later copies even if another path has positive evidence.
  // As with sources, only the exact actual Case gate carries this obligation forward.
  let mut gap = usize.ZERO
  while gap < List<SummaryPublicationGap>.length(&result.gaps) {
    let source = List<SummaryPublicationGap>.asSlice(&result.gaps)[gap]
    let mut actual = usize.ZERO
    while actual < cases.length {
      let follows = match cases[actual].source { Option<usize>.Some {value} => value == source.cell _ => false }
      if follows && !summaryPlacementDefinition(cases[actual].authority, values[keys[cases[actual].target].value.index]) {
        run summaryPublicationGap(&mut result, domain, &mut rules.*, source.origin, source.initial,
          cases[actual].target, source.active, cases[actual].active)
      }
      actual = actual + usize.ONE
    }
    gap = gap + usize.ONE
  }
  return move result
}

/// Deferred address consumers are recorded at their actual execution points. Candidate
/// closure may discover another address history later; it extends this same operation's
/// destination gate instead of creating a second store or rereading a prior snapshot.
union AliasOperationKind {
  Project { map: MapId, source: EvalId, target: EvalId, write: Write },
  Read { map: MapId, source: EvalId, target: EvalId, active: Atom },
  Write { map: MapId, source: EvalId, address: EvalId, target: EvalId, active: Atom },
  Invalidate { address: EvalId, root: EndpointId, target: EvalId, origin: Origin, active: Atom },
}
impl Copy for AliasOperationKind {}
struct AliasOperation {
  kind: AliasOperationKind
  closed: usize
}
impl Copy for AliasOperation {}
struct AliasDefinition {
  operation: usize
  storage: Storage
  active: Atom
  definition: DefinitionId
}

/// A real reference descriptor remembers its actual address formation, not a copy of the
/// referent's then-current contents. The paired map is frozen interpretation evidence for
/// a later read at its own use point; it must never become a borrow-time value snapshot.
pub struct ReferenceOrigin {
  pub leaf: LeafId
  pub source: EvalId
  pub descriptor: ValueId
  pub map: MapId
  pub referent: MapId
}
impl Copy for ReferenceOrigin {}

/// An actual selection occurrence retains its frozen selector path and distinct value/place
/// families. It is activated after candidate address closure, at result's current read point;
/// merely reserving an endpoint or a selection never evaluates it.
pub struct SelectionUse {
  pub operand: EvalId
  pub result: EvalId
  pub selection: PreparedSelectionId
  pub selectors: List<MapId>
  pub value: Option<MapId>
  pub place: Option<MapId>
  pub strength: Write
  pub active: Atom
}

/// A retained call selector has no projection result family. Its selection belongs to
/// originating, while every current contents read belongs to the exact execution Eval.
pub struct RetainedPath {pub endpoint: EndpointId, pub selectors: List<MapId>}
pub struct RetainedRequest {
  pub operation: usize
  pub input: usize
  pub slot: usize
  pub retention: Prepared.RetentionId
  pub originating: EvalId
  pub operand: EvalId
  pub usePoint: PointId
  pub execution: EvalId
  pub original: PreparedSelectionId
  pub selection: PreparedSelectionId
  pub paths: List<RetainedPath>
  pub active: Atom
}

/// Policy-gated body storage, distinct from original retained-slot eligibility. The
/// receiving definition is an opaque whole-owner summary, never a precise field claim.
pub struct InvocationWrite {
  pub operation: usize
  pub read: InputRead
  pub operand: EvalId
  pub usePoint: PointId
  pub address: usize
  pub source: ValueId
  pub target: ValueId
  pub holder: usize
  pub summary: usize
  pub active: Atom
}
impl Copy for InvocationWrite {}

/// Actual invocation-body address authority. This has no retained-slot or declaration
/// parameter coordinate; the owning prepared InvocationView supplies the physical selector.
pub struct InvocationRequest {
  pub operation: usize
  pub view: usize
  pub operand: EvalId
  pub usePoint: PointId
  pub execution: EvalId
  pub selection: PreparedSelectionId
  pub paths: List<RetainedPath>
  pub active: Atom
  /// Positive unsupported evidence only; address presence does not certify completeness.
  pub missing: Atom
}
pub struct InvocationAddress {
  pub request: usize
  pub path: usize
  pub descriptor: ValueId
  pub leaf: LeafId
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub direct: bool
  pub alias: usize
  pub edge: usize
  pub storage: Storage
  pub active: Atom
}
impl Copy for InvocationAddress {}
pub struct InvocationRead {
  pub request: usize
  pub path: usize
  pub prefix: usize
  pub consumer: ValueId
  pub read: ReadId
  pub alias: usize
  pub edge: usize
  pub active: Atom
}
impl Copy for InvocationRead {}
union DescriptorRequestAuthority { Retained {request: usize}, Invocation {request: usize} }
impl Copy for DescriptorRequestAuthority {}
struct DescriptorRequest {
  authority: DescriptorRequestAuthority
  operand: EvalId
  execution: EvalId
  selection: PreparedSelectionId
  paths: List<RetainedPath>
  active: Atom
  missing: Atom
}

/// Exact descriptor contributor BEFORE crossing this particular address proof edge.
/// alias.active is a join and is deliberately not the history's applicability gate.
pub struct RetainedAddress {
  pub operation: usize
  pub input: usize
  pub slot: usize
  pub path: usize
  pub descriptor: ValueId
  pub leaf: LeafId
  pub definition: Option<DefinitionId>
  pub read: Option<ReadId>
  pub direct: bool
  pub alias: usize
  pub edge: usize
  pub storage: Storage
  pub active: Atom
}
impl Copy for RetainedAddress {}

/// The original SlotCoverage remains in retention. These flags describe only its frozen
/// structural coverage; addresses do not establish complete descriptor/origin coverage.
pub struct RetainedStatus {
  pub request: usize
  pub originalExact: bool
  pub physicalExact: bool
  pub empty: bool
  pub missing: Atom
}
impl Copy for RetainedStatus {}

/// A real canonical read made while interpreting a retained prefix at execution. Prefix
/// counts selector edges from the request root; no invented Copy map labels this read.
pub struct RetainedRead {
  pub request: usize
  pub path: usize
  pub prefix: usize
  pub consumer: ValueId
  pub read: ReadId
  pub alias: usize
  pub edge: usize
  pub active: Atom
}
impl Copy for RetainedRead {}

/// Read-only joins of the original source-flow identity with its actual stored/read value.
/// Consumers cannot manufacture a second reaching relation from these projections.
pub struct DefinitionView {
  pub summary: Option<usize>
  pub clears: Option<DefinitionId>
  /// Actual defining operation, retained at emission; body-entry initialization has none.
  pub writer: Option<EvalId>
  pub id: DefinitionId
  pub point: PointId
  pub storage: Storage
  pub value: ValueId
  pub active: Atom
  pub write: Write
}
impl Copy for DefinitionView {}
pub struct ReadView {
  pub summary: Option<usize>
  pub id: ReadId
  pub point: PointId
  pub storage: Storage
  pub value: ValueId
  pub map: Option<MapId>
}
impl Copy for ReadView {}

/// Structural producer; no source alternative is selected during reservation. The BorrowCheck
/// visitor records actual roots, evaluations, storage and typed transfers into this one skeleton.
/// Semantic handlers select terminal result boundaries before the single reservation.
/// The graph neither infers a handler from a map kind nor duplicates written operands.
pub union ResultKind { Physical, Read { pub read: EvalId }, Declared }
impl Copy for ResultKind {}
pub struct ResultUse {
  pub evaluation: EvalId
  pub active: Atom
  pub kind: ResultKind
  pub sources: List<EvalId>
}

/// A policy candidate is an actual source component plus one exact destination address
/// contributor. Slot eligibility belongs to BorrowCheck, never candidate reservation.
pub struct RetainedWrite {
  /// None is exact physical placement; Some retains unknown contents below this prefix.
  pub summary: Option<usize>
  pub operation: usize
  pub sourceInput: usize
  pub sourceSlot: usize
  pub address: usize
  pub source: ValueId
  pub target: ValueId
  pub holder: usize
  pub active: Atom
}
impl Copy for RetainedWrite {}
pub struct WriteComponent {
  pub active: Atom
  pub storage: Storage
  pub value: ValueId
  pub read: ReadId
  pub definition: DefinitionId
}
impl Copy for WriteComponent {}
pub struct WriteHolder {
  pub execution: EvalId
  pub storage: Storage
  pub active: Atom
  pub components: List<WriteComponent>
}

/// Actual ordinary writer and its policy-reserved canonical summary placement.
pub struct OrdinarySummaryWrite {
  pub original: DefinitionId
  pub definition: DefinitionId
  pub writer: EvalId
  pub storage: Storage
  pub summary: usize
  pub source: ValueId
  pub target: ValueId
  pub active: Atom
  admitted: Atom
}
impl Copy for OrdinarySummaryWrite {}

/// Separate Flow component for one canonical opaque-prefix holding, not a physical field.
pub struct SummaryStorage { pub prefix: Storage, pub unknown: bool, component: ComponentId }
impl Copy for SummaryStorage {}
pub struct SummaryRead {
  pub summary: usize
  pub original: ReadId
  pub read: ReadId
  pub target: ValueId
  pub active: Atom
}
impl Copy for SummaryRead {}
pub struct SummaryClear { pub summary: usize, pub original: DefinitionId, pub definition: DefinitionId }
impl Copy for SummaryClear {}
struct SummaryWrite { summary: usize, holder: usize, value: ValueId, definition: DefinitionId, active: Atom }
impl Copy for SummaryWrite {}

/// One ORIGINAL enumeration row at an actual invocation, including empty and incomplete
/// rows. The immutable inventory owns its candidates; coverage remains the exact prepared
/// ContractSelection. active is execution/completion applicability, not predicate admission.
pub struct OperationContributor {
  pub operation: usize
  pub output: usize
  pub contributor: usize
  pub active: Atom
}
impl Copy for OperationContributor {}

