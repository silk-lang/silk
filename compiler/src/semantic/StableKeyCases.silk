//! Stable keys name the same units and source inputs in two stores built independently, as two
//! processes build them, and a store reads back the inputs another store wrote.

import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query { Cycle }
import semantic.Semantic { Request, Semantic }
import semantic.SemanticCaseSupport { makeSemantic, module, present }
import semantic.SourceIndex { RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.StableKey
import semantic.Types { TypeTable, Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.option { Option }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn library() -> string<'static> {
  return """
pub struct Point {pub x: i32, pub y: i32}
impl Point {
  pub fn sum(self: &Self) -> i32 {
    return self.x + self.y
  }
}
pub fn origin() -> Point {
  return Point { x: 0, y: 0 }
}
"""
}

fn application() -> string<'static> {
  return """
import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  return Point.sum(point)
}
pub fn main() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

fn renamed() -> string<'static> {
  return """
pub struct Point {pub x: i32, pub y: i32}
impl Point {
  pub fn total(self: &Self) -> i32 {
    return self.x + self.y
  }
}
pub fn origin() -> Point {
  return Point { x: 0, y: 0 }
}
"""
}

test effect fn stableKeysRoundTripAcrossStores() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run stableClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A store of the two modules that checks `first` and then `second`, so stores that check them in
// different orders number their units and inputs differently.
effect fn checked(library: string<'static>, first: &ModuleId, second: &ModuleId) -> Semantic
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(application()))
  let revision = run Revision.publish(&initial, &shape, &run present(library))
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  drop run Semantic.checkModule(&mut store, &mut request, first, &Option<ModuleId>.none())
  drop run Semantic.checkModule(&mut store, &mut request, second, &Option<ModuleId>.none())
  return move store
}

effect fn stableClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let mut forward = run checked(library(), &app, &shape)
  let mut backward = run checked(library(), &shape, &app)

  let written = run Semantic.stableUnits(&forward)
  let read = run Semantic.stableUnits(&backward)
  run Testing.expect(List<Bytes>.length(&written) > 2, "a check completes units with stable keys")
  run Testing.expect(List<Bytes>.length(&written) == List<Bytes>.length(&read), "both stores hold the same units")
  run Testing.expect(includesAll(&read, &written) && includesAll(&written, &read), "equal units encode alike whatever their ordinals")

  let inputs = run Semantic.stableInputs(&forward)
  let listed = List<Bytes>.asSlice(&inputs)
  run Testing.expect(listed.length > 2, "a check captures source inputs")
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length {
    let placed = run Semantic.findStableInput(&mut backward, Bytes.asSlice(&listed[at]))
    if placed != usize.MAX { found = found + usize.ONE }
    at = at + usize.ONE
  }
  run Testing.expect(found == listed.length, "every input one store wrote is an input the other store captured")

  // An input naming a declaration the source no longer holds is not placed.
  let mut edited = run checked(renamed(), &app, &shape)
  let mut missing = usize.ZERO
  at = usize.ZERO
  while at < listed.length {
    let placed = run Semantic.findStableInput(&mut edited, Bytes.asSlice(&listed[at]))
    if placed == usize.MAX { missing = missing + usize.ONE }
    at = at + usize.ONE
  }
  run Testing.expect(missing > usize.ZERO && missing < listed.length, "only the inputs of a renamed declaration are lost")

  // A module identity reads back, and bytes that are no declaration's content read as none.
  let nothing = run DeclarationId.fromContent(b"")
  run Testing.expect(isNone(&nothing), "empty bytes are no declaration")
  let mut reader = StableKey.reader()
  let mut encoded = Bytes.make()
  run StableKey.module(&mut encoded, &shape)
  let module = run StableKey.readModule(Bytes.asSlice(&encoded), &mut reader)
  run Testing.expect(sameModule(&module, &shape) && StableKey.finished(Bytes.asSlice(&encoded), &reader), "a module reads back")
  return ()
}

fn isNone(value: &Option<DeclarationId>) -> bool {
  return match &value.* {
    Option<DeclarationId>.Some {..} => false
    Option<DeclarationId>.None => true
  }
}

fn sameModule(value: &Option<ModuleId>, expected: &ModuleId) -> bool {
  return match &value.* {
    Option<ModuleId>.Some {value: found} => ModuleId.equals(&found, expected)
    Option<ModuleId>.None => false
  }
}

fn includesAll(haystack: &List<Bytes>, needles: &List<Bytes>) -> bool {
  let wanted = List<Bytes>.asSlice(needles)
  let held = List<Bytes>.asSlice(haystack)
  let mut at = usize.ZERO
  while at < wanted.length {
    let mut seen = false
    let mut other = usize.ZERO
    while other < held.length && !seen {
      seen = same(Bytes.asSlice(&held[other]), Bytes.asSlice(&wanted[at]))
      other = other + usize.ONE
    }
    if !seen { return false }
    at = at + usize.ONE
  }
  return true
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
