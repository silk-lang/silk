fn planLocal(plan: &mut Plan, value: &Local) -> () {
  if !enter(&mut plan.*) { return () }
  planOrigin(&mut plan.*, &value.origin)
  planInterned_Type_(&mut plan.*, &value.ty)
  planbool(&mut plan.*, &value.mutable)
  planOption_usize_(&mut plan.*, &value.meetDepth)
  planbool(&mut plan.*, &value.written)
  leave(&mut plan.*)
}

effect fn readLocalValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Local>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_origin = match move run readOrigin(&mut state.*, bytes, &mut input.*) { Option<Origin>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Local>.none() } }
  let field_ty = match move run readInterned_Type_(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Local>.none() } }
  let field_mutable = match move run readbool(&mut state.*, bytes, &mut input.*) { Option<bool>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Local>.none() } }
  let field_meetDepth = match move run readOption_usize_(&mut state.*, bytes, &mut input.*) { Option<Option<usize>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Local>.none() } }
  let field_written = match move run readbool(&mut state.*, bytes, &mut input.*) { Option<bool>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Local>.none() } }
  let result = Local {origin: move field_origin, ty: move field_ty, mutable: move field_mutable, meetDepth: move field_meetDepth, written: move field_written}
  if input.failed { return Option<Local>.none() }
  return Option<Local>.some(move result)
}

effect fn readLocal(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Local>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Local>.none() }
  let result = run readLocalValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planList_Local_(plan: &mut Plan, value: &List<Local>) -> () {
  if !enter(&mut plan.*) { return () }
  let entries = List<Local>.asSlice(value)
  if entries.length > BodyWire.NODE_LIMIT { refusePlan(&mut plan.*, BodyWire.RESOURCE)
    return () }
  number(&mut plan.*, usize.toU64(entries.length))
  let mut at = usize.ZERO
  while at < entries.length && !plan.failed {
    planLocal(&mut plan.*, &entries[at])
    at = at + usize.ONE
  }
  leave(&mut plan.*)
}

effect fn readList_Local_Value(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<List<Local>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = BodyWire.count(bytes, &mut input.*, BodyWire.NODE_LIMIT)
  if input.failed { return Option<List<Local>>.none() }
  let mut result = run List<Local>.makeWithCapacity(count)
  let mut at = usize.ZERO
  while at < count {
  let item = match move run readLocal(&mut state.*, bytes, &mut input.*) { Option<Local>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<List<Local>>.none() } }
  run List<Local>.append(&mut result, move item)
  at = at + usize.ONE
  }
  if input.failed { return Option<List<Local>>.none() }
  return Option<List<Local>>.some(move result)
}

effect fn readList_Local_(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<List<Local>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<List<Local>>.none() }
  let result = run readList_Local_Value(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planAccess(plan: &mut Plan, value: &Access) -> () {
  if !enter(&mut plan.*) { return () }
  match &value.* {
  Access.Shared => { number(&mut plan.*, 0)
  }
  Access.Mutable => { number(&mut plan.*, 1)
  }
  }
  leave(&mut plan.*)
}

effect fn readAccessValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Access>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  let result = match tag {
  0 => {
  Access.Shared
  }
  1 => {
  Access.Mutable
  }
  _ => { input.failed = true
    return Option<Access>.none() }
  }
  if input.failed { return Option<Access>.none() }
  return Option<Access>.some(move result)
}

effect fn readAccess(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Access>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Access>.none() }
  let result = run readAccessValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planNodeId(plan: &mut Plan, value: &NodeId) -> () {
  if !enter(&mut plan.*) { return () }
  planusize(&mut plan.*, &value.index)
  leave(&mut plan.*)
}

effect fn readNodeIdValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<NodeId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_index = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<NodeId>.none() } }
  if field_index >= state.nodeLimit { input.failed = true
    return Option<NodeId>.none() }
  let result = NodeId {index: move field_index}
  if input.failed { return Option<NodeId>.none() }
  return Option<NodeId>.some(move result)
}

effect fn readNodeId(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<NodeId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<NodeId>.none() }
  let result = run readNodeIdValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
