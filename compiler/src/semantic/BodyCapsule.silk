  let item = match move run readNode(&mut state.*, bytes, &mut input.*) { Option<Node>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<List<Node>>.none() } }
  run List<Node>.append(&mut result, move item)
  at = at + usize.ONE
  }
  if input.failed { return Option<List<Node>>.none() }
  return Option<List<Node>>.some(move result)
}

