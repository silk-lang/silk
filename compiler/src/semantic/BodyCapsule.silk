fn planNodeKind(plan: &mut Plan, value: &NodeKind) -> () {
  if !enter(&mut plan.*) { return () }
  match &value.* {
  NodeKind.Expression {ty, form} => { number(&mut plan.*, 0)
  planInterned_Type_(&mut plan.*, &ty)
  planExpression(&mut plan.*, &form)
  }
  NodeKind.LocalBinding {local, initializer} => { number(&mut plan.*, 1)
  planLocalId(&mut plan.*, &local)
  planNodeId(&mut plan.*, &initializer)
  }
  NodeKind.MutableBinding {local, initializer} => { number(&mut plan.*, 2)
  planLocalId(&mut plan.*, &local)
  planNodeId(&mut plan.*, &initializer)
  }
  NodeKind.Assignment {local, value: selectedValue} => { number(&mut plan.*, 3)
  planLocalId(&mut plan.*, &local)
  planNodeId(&mut plan.*, &selectedValue)
  }
  NodeKind.PlaceAssignment {target, value: selectedValue} => { number(&mut plan.*, 4)
  planNodeId(&mut plan.*, &target)
  planNodeId(&mut plan.*, &selectedValue)
  }
  NodeKind.Return {value: selectedValue} => { number(&mut plan.*, 5)
  planOption_NodeId_(&mut plan.*, &selectedValue)
  }
  NodeKind.Branch {condition, thenBranch, elseBranch, canComplete} => { number(&mut plan.*, 6)
  planNodeId(&mut plan.*, &condition)
  planNodeId(&mut plan.*, &thenBranch)
  planOption_NodeId_(&mut plan.*, &elseBranch)
  planbool(&mut plan.*, &canComplete)
  }
  NodeKind.While {condition, body} => { number(&mut plan.*, 7)
  planNodeId(&mut plan.*, &condition)
  planNodeId(&mut plan.*, &body)
  }
  NodeKind.Break => { number(&mut plan.*, 8)
  }
  NodeKind.Continue => { number(&mut plan.*, 9)
  }
  NodeKind.Fail {value: selectedValue} => { number(&mut plan.*, 10)
  planNodeId(&mut plan.*, &selectedValue)
  }
  NodeKind.Drop {value: selectedValue, consumed} => { number(&mut plan.*, 11)
  planNodeId(&mut plan.*, &selectedValue)
  planOption_ConsumedPlace_(&mut plan.*, &consumed)
  }
  NodeKind.Recovered {resumes} => { number(&mut plan.*, 12)
  refusePlan(&mut plan.*, BodyWire.MALFORMED_PLAN)
  planbool(&mut plan.*, &resumes)
  }
  NodeKind.Block {statements, value: selectedValue, canComplete} => { number(&mut plan.*, 13)
  planList_NodeId_(&mut plan.*, &statements)
  planOption_NodeId_(&mut plan.*, &selectedValue)
  planbool(&mut plan.*, &canComplete)
  }
  }
  leave(&mut plan.*)
}

