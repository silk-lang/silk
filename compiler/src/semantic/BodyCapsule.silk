//! Portable ordinary typed-body payloads with receiver-local interned dictionaries.
//!
//! Capsules preserve checking stage and complete body metadata. The caller independently
//! authenticates the full provider dependency graph before publishing the decoded query answer.
//! Neither successful decoding nor ContractTyped is a runtime closure or borrow-check proof.

import semantic.BodyWire
import semantic.BodyTypes
import semantic.TypedBody {NodeId, LocalId, ReceiverPass, Origin, Local, SectionRetention, Expression, EnumMember, UnionMember, Pattern, PlaceStep, PlaceRoot, ConsumedPlace, SubjectAccess, RunAccess, BindingAccess, MatchSyntax, PatternTest, ScalarTest, MatchArm, AggregateField, RegionRequirement, ReferentCapture, NodeKind, Node, SignatureDependency, Stage, StaticIteration, EnvironmentCapture, Environment, Referent, Resolution, TypedBody}
import semantic.Type {Type, Binding, Argument, KeptRegions, KeptSlot, KeptStep, KeptStepKind}
import semantic.Types {Types}
import semantic.Lifetime {Lifetime}
import semantic.Specialization {Application, StaticSlot}
import semantic.StaticValue {Value as StaticData, IntegerType as StaticIntegerType}
import semantic.DeclarationId {DeclarationId}
import semantic.SourceLocations {Location}
import semantic.Intrinsic {Member, Primitive}
import semantic.ScalarOperation {ScalarOperation, Scalar, Code}
import semantic.StorageOperation {StorageOperation}
import hir.Hir {Access, CallableMode, PrefixOperator, InfixOperator}
import backend.CAbi
import semantic.StableKey
import semantic.RuntimeEncoding
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.shared {Shared}
import silk.mem.interned {Interned}
import silk.num.usize
import silk.num.u64

union Atom {
  Word {value: u64},
  Type {value: Interned<Type>},
  Lifetime {value: Interned<Lifetime>},
  Application {value: Interned<Application>},
  StaticData {value: Interned<StaticData>},
  Declaration {value: DeclarationId},
  Binding {value: Binding},
  Bytes {value: Shared<Bytes>},
}

struct Plan {
  reason: usize,
  atoms: List<Atom>,
  counting: bool,
  failed: bool,
  count: usize,
  depth: usize,
  nodes: usize,
  locals: usize,
}

struct Decode {
  types: BodyTypes.Decoder,
  nodeLimit: usize,
  localLimit: usize,
  nodes: usize,
  locals: usize,
}

fn refusePlan(plan: &mut Plan, reason: usize) -> () {
  if !plan.failed { plan.reason = reason }
  plan.failed = true
}

fn atom(plan: &mut Plan, value: Atom) -> () {
  if plan.failed { return () }
  if plan.count >= BodyWire.STEP_LIMIT { refusePlan(&mut plan.*, BodyWire.RESOURCE)
    return () }
  plan.count = plan.count + usize.ONE
  if !plan.counting && !List<Atom>.appendWithinCapacity(&mut plan.atoms, move value) { refusePlan(&mut plan.*, BodyWire.MALFORMED_PLAN) }
}

fn number(plan: &mut Plan, value: u64) -> () { atom(&mut plan.*, Atom.Word {value: value}) }

fn enter(plan: &mut Plan) -> bool {
  if plan.failed || plan.depth >= BodyWire.DEPTH_LIMIT { refusePlan(&mut plan.*, BodyWire.DEPTH)
    return false }
  plan.depth = plan.depth + usize.ONE
  return true
}

fn leave(plan: &mut Plan) -> () { plan.depth = plan.depth - usize.ONE }


fn planDeclarationId(plan: &mut Plan, value: &DeclarationId) -> () {
  atom(&mut plan.*, Atom.Declaration {value: DeclarationId.copy(value)})
}

effect fn readDeclarationIdValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<DeclarationId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run BodyTypes.readDeclaration(&mut state.types, bytes, &mut input.*)
}

effect fn readDeclarationId(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<DeclarationId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<DeclarationId>.none() }
  let result = run readDeclarationIdValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planInterned_Type_(plan: &mut Plan, value: &Interned<Type>) -> () {
  atom(&mut plan.*, Atom.Type {value: Interned<Type>.clone(value)})
}

effect fn readInterned_Type_Value(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run BodyTypes.readType(&mut state.types, bytes, &mut input.*)
}

effect fn readInterned_Type_(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Interned<Type>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Interned<Type>>.none() }
  let result = run readInterned_Type_Value(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planusize(plan: &mut Plan, value: &usize) -> () {
  number(&mut plan.*, usize.toU64(value.*))
}

effect fn readusizeValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<usize>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let raw = BodyWire.readWord(bytes, &mut input.*)
  if raw > usize.toU64(usize.MAX) { input.failed = true
    return Option<usize>.none() }
  let result = u64.toUsize(raw)
  if input.failed { return Option<usize>.none() }
  return Option<usize>.some(move result)
}

effect fn readusize(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<usize>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<usize>.none() }
  let result = run readusizeValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planLocalId(plan: &mut Plan, value: &LocalId) -> () {
  if !enter(&mut plan.*) { return () }
  planusize(&mut plan.*, &value.index)
  leave(&mut plan.*)
}

effect fn readLocalIdValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<LocalId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_index = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<LocalId>.none() } }
  if field_index >= state.localLimit { input.failed = true
    return Option<LocalId>.none() }
  let result = LocalId {index: move field_index}
  if input.failed { return Option<LocalId>.none() }
  return Option<LocalId>.some(move result)
}

effect fn readLocalId(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<LocalId>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<LocalId>.none() }
  let result = run readLocalIdValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planbool(plan: &mut Plan, value: &bool) -> () {
  number(&mut plan.*, if value.* { 1 } else { 0 })
}

effect fn readboolValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<bool>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let raw = BodyWire.readWord(bytes, &mut input.*)
  if raw > 1 { input.failed = true
    return Option<bool>.none() }
  let result = raw == 1
  if input.failed { return Option<bool>.none() }
  return Option<bool>.some(move result)
}

effect fn readbool(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<bool>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<bool>.none() }
  let result = run readboolValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planEnvironmentCapture(plan: &mut Plan, value: &EnvironmentCapture) -> () {
  if !enter(&mut plan.*) { return () }
  planLocalId(&mut plan.*, &value.local)
  planusize(&mut plan.*, &value.field)
  planbool(&mut plan.*, &value.dereference)
  leave(&mut plan.*)
}

effect fn readEnvironmentCaptureValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<EnvironmentCapture>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_local = match move run readLocalId(&mut state.*, bytes, &mut input.*) { Option<LocalId>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<EnvironmentCapture>.none() } }
  let field_field = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<EnvironmentCapture>.none() } }
  let field_dereference = match move run readbool(&mut state.*, bytes, &mut input.*) { Option<bool>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<EnvironmentCapture>.none() } }
  let result = EnvironmentCapture {local: move field_local, field: move field_field, dereference: move field_dereference}
  if input.failed { return Option<EnvironmentCapture>.none() }
  return Option<EnvironmentCapture>.some(move result)
}

effect fn readEnvironmentCapture(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<EnvironmentCapture>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<EnvironmentCapture>.none() }
  let result = run readEnvironmentCaptureValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planList_EnvironmentCapture_(plan: &mut Plan, value: &List<EnvironmentCapture>) -> () {
  if !enter(&mut plan.*) { return () }
  let entries = List<EnvironmentCapture>.asSlice(value)
  if entries.length > BodyWire.NODE_LIMIT { refusePlan(&mut plan.*, BodyWire.RESOURCE)
    return () }
  number(&mut plan.*, usize.toU64(entries.length))
  let mut at = usize.ZERO
  while at < entries.length && !plan.failed {
    planEnvironmentCapture(&mut plan.*, &entries[at])
    at = at + usize.ONE
  }
  leave(&mut plan.*)
}

effect fn readList_EnvironmentCapture_Value(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<List<EnvironmentCapture>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = BodyWire.count(bytes, &mut input.*, BodyWire.NODE_LIMIT)
  if input.failed { return Option<List<EnvironmentCapture>>.none() }
  let mut result = run List<EnvironmentCapture>.makeWithCapacity(count)
  let mut at = usize.ZERO
  while at < count {
  let item = match move run readEnvironmentCapture(&mut state.*, bytes, &mut input.*) { Option<EnvironmentCapture>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<List<EnvironmentCapture>>.none() } }
  run List<EnvironmentCapture>.append(&mut result, move item)
  at = at + usize.ONE
  }
  if input.failed { return Option<List<EnvironmentCapture>>.none() }
  return Option<List<EnvironmentCapture>>.some(move result)
}

effect fn readList_EnvironmentCapture_(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<List<EnvironmentCapture>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<List<EnvironmentCapture>>.none() }
  let result = run readList_EnvironmentCapture_Value(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planEnvironment(plan: &mut Plan, value: &Environment) -> () {
  if !enter(&mut plan.*) { return () }
  planInterned_Type_(&mut plan.*, &value.ty)
  planusize(&mut plan.*, &value.outerCount)
  planList_EnvironmentCapture_(&mut plan.*, &value.captures)
  leave(&mut plan.*)
}

effect fn readEnvironmentValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Environment>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_ty = match move run readInterned_Type_(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Environment>.none() } }
  let field_outerCount = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Environment>.none() } }
  if field_outerCount > BodyWire.ENTRY_LIMIT { input.failed = true
    return Option<Environment>.none() }
  let previousLocals = state.localLimit
  state.localLimit = field_outerCount
  let capturesResult = run readList_EnvironmentCapture_(&mut state.*, bytes, &mut input.*)
  state.localLimit = previousLocals
  let field_captures = match move capturesResult { Option<List<EnvironmentCapture>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Environment>.none() } }
  let result = Environment {ty: move field_ty, outerCount: move field_outerCount, captures: move field_captures}
  if input.failed { return Option<Environment>.none() }
  return Option<Environment>.some(move result)
}

effect fn readEnvironment(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Environment>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Environment>.none() }
  let result = run readEnvironmentValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planOption_Environment_(plan: &mut Plan, value: &Option<Environment>) -> () {
  if !enter(&mut plan.*) { return () }
  match &value.* {
    Option<Environment>.None => number(&mut plan.*, 0)
    Option<Environment>.Some {value: held} => { number(&mut plan.*, 1)
    planEnvironment(&mut plan.*, &held) }
  }
  leave(&mut plan.*)
}

effect fn readOption_Environment_Value(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Option<Environment>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Option<Option<Environment>>.some(Option<Environment>.none()) }
  if tag != 1 { input.failed = true
    return Option<Option<Environment>>.none() }
  let item = match move run readEnvironment(&mut state.*, bytes, &mut input.*) { Option<Environment>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Option<Environment>>.none() } }
  let result = Option<Environment>.some(move item)
  if input.failed { return Option<Option<Environment>>.none() }
  return Option<Option<Environment>>.some(move result)
}

effect fn readOption_Environment_(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Option<Environment>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Option<Environment>>.none() }
  let result = run readOption_Environment_Value(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planLocation(plan: &mut Plan, value: &Location) -> () {
  if !enter(&mut plan.*) { return () }
  planusize(&mut plan.*, &value.start)
  planusize(&mut plan.*, &value.end)
  leave(&mut plan.*)
}

effect fn readLocationValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Location>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_start = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Location>.none() } }
  let field_end = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Location>.none() } }
  let result = Location {start: move field_start, end: move field_end}
  if input.failed { return Option<Location>.none() }
  return Option<Location>.some(move result)
}

effect fn readLocation(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Location>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Location>.none() }
  let result = run readLocationValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planOrigin(plan: &mut Plan, value: &Origin) -> () {
  if !enter(&mut plan.*) { return () }
  planusize(&mut plan.*, &value.node)
  planLocation(&mut plan.*, &value.location)
  leave(&mut plan.*)
}

effect fn readOriginValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Origin>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_node = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Origin>.none() } }
  let field_location = match move run readLocation(&mut state.*, bytes, &mut input.*) { Option<Location>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Origin>.none() } }
  let result = Origin {node: move field_node, location: move field_location}
  if input.failed { return Option<Origin>.none() }
  return Option<Origin>.some(move result)
}

effect fn readOrigin(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Origin>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Origin>.none() }
  let result = run readOriginValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planOption_usize_(plan: &mut Plan, value: &Option<usize>) -> () {
  if !enter(&mut plan.*) { return () }
  match &value.* {
    Option<usize>.None => number(&mut plan.*, 0)
    Option<usize>.Some {value: held} => { number(&mut plan.*, 1)
    planusize(&mut plan.*, &held) }
  }
  leave(&mut plan.*)
}

effect fn readOption_usize_Value(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Option<usize>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  if tag == 0 { return Option<Option<usize>>.some(Option<usize>.none()) }
  if tag != 1 { input.failed = true
    return Option<Option<usize>>.none() }
  let item = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Option<usize>>.none() } }
  let result = Option<usize>.some(move item)
  if input.failed { return Option<Option<usize>>.none() }
  return Option<Option<usize>>.some(move result)
