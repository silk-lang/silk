fn planList_Node_(plan: &mut Plan, value: &List<Node>) -> () {
  if !enter(&mut plan.*) { return () }
  let entries = List<Node>.asSlice(value)
  if entries.length > BodyWire.NODE_LIMIT { refusePlan(&mut plan.*, BodyWire.RESOURCE)
    return () }
  number(&mut plan.*, usize.toU64(entries.length))
  let mut at = usize.ZERO
  while at < entries.length && !plan.failed {
    planNode(&mut plan.*, &entries[at])
    at = at + usize.ONE
  }
  leave(&mut plan.*)
}

