effect fn readPrimitive(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Primitive>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Primitive>.none() }
  let result = run readPrimitiveValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planScalar(plan: &mut Plan, value: &Scalar) -> () {
  if !enter(&mut plan.*) { return () }
  match &value.* {
  Scalar.Bool => { number(&mut plan.*, 0)
  }
  Scalar.Char => { number(&mut plan.*, 1)
  }
  Scalar.U8 => { number(&mut plan.*, 2)
  }
  Scalar.U16 => { number(&mut plan.*, 3)
  }
  Scalar.U32 => { number(&mut plan.*, 4)
  }
  Scalar.U64 => { number(&mut plan.*, 5)
  }
  Scalar.Usize => { number(&mut plan.*, 6)
  }
  Scalar.I8 => { number(&mut plan.*, 7)
  }
  Scalar.I16 => { number(&mut plan.*, 8)
  }
  Scalar.I32 => { number(&mut plan.*, 9)
  }
