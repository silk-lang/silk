effect fn readOption_usize_(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Option<usize>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Option<usize>>.none() }
