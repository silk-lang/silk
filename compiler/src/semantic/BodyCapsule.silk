  leave(&mut plan.*)
}

effect fn readReferentValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Referent>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let tag = BodyWire.readWord(bytes, &mut input.*)
  let result = match tag {
  0 => {
  let field_declaration = match move run readInterned_DeclarationId_(&mut state.*, bytes, &mut input.*) { Option<Interned<DeclarationId>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Referent>.none() } }
  Referent.Declaration {declaration: move field_declaration}
  }
  1 => {
  let field_local = match move run readLocalId(&mut state.*, bytes, &mut input.*) { Option<LocalId>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Referent>.none() } }
  Referent.Local {local: move field_local}
  }
  2 => {
  let field_owner = match move run readInterned_Type_(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Referent>.none() } }
  let field_index = match move run readusize(&mut state.*, bytes, &mut input.*) { Option<usize>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Referent>.none() } }
  Referent.Field {owner: move field_owner, index: move field_index}
  }
  3 => {
  let field_ty = match move run readInterned_Type_(&mut state.*, bytes, &mut input.*) { Option<Interned<Type>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Referent>.none() } }
  Referent.Type {ty: move field_ty}
  }
  _ => { input.failed = true
    return Option<Referent>.none() }
  }
  if input.failed { return Option<Referent>.none() }
  return Option<Referent>.some(move result)
}

effect fn readReferent(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Referent>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Referent>.none() }
  let result = run readReferentValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planResolution(plan: &mut Plan, value: &Resolution) -> () {
  if !enter(&mut plan.*) { return () }
  planOrigin(&mut plan.*, &value.origin)
  planReferent(&mut plan.*, &value.referent)
  leave(&mut plan.*)
}

effect fn readResolutionValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Resolution>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let field_origin = match move run readOrigin(&mut state.*, bytes, &mut input.*) { Option<Origin>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Resolution>.none() } }
  let field_referent = match move run readReferent(&mut state.*, bytes, &mut input.*) { Option<Referent>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<Resolution>.none() } }
  let result = Resolution {origin: move field_origin, referent: move field_referent}
  if input.failed { return Option<Resolution>.none() }
  return Option<Resolution>.some(move result)
}

effect fn readResolution(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<Resolution>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<Resolution>.none() }
  let result = run readResolutionValue(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planList_Resolution_(plan: &mut Plan, value: &List<Resolution>) -> () {
  if !enter(&mut plan.*) { return () }
  let entries = List<Resolution>.asSlice(value)
  if entries.length > BodyWire.NODE_LIMIT { refusePlan(&mut plan.*, BodyWire.RESOURCE)
    return () }
  number(&mut plan.*, usize.toU64(entries.length))
  let mut at = usize.ZERO
  while at < entries.length && !plan.failed {
    planResolution(&mut plan.*, &entries[at])
    at = at + usize.ONE
  }
  leave(&mut plan.*)
}

effect fn readList_Resolution_Value(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<List<Resolution>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let count = BodyWire.count(bytes, &mut input.*, BodyWire.NODE_LIMIT)
  if input.failed { return Option<List<Resolution>>.none() }
  let mut result = run List<Resolution>.makeWithCapacity(count)
  let mut at = usize.ZERO
  while at < count {
  let item = match move run readResolution(&mut state.*, bytes, &mut input.*) { Option<Resolution>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<List<Resolution>>.none() } }
  run List<Resolution>.append(&mut result, move item)
  at = at + usize.ONE
  }
  if input.failed { return Option<List<Resolution>>.none() }
  return Option<List<Resolution>>.some(move result)
}

effect fn readList_Resolution_(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<List<Resolution>>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<List<Resolution>>.none() }
  let result = run readList_Resolution_Value(&mut state.*, bytes, &mut input.*)
  BodyWire.leaveRead(&mut input.*)
  return move result
}

fn planTypedBody(plan: &mut Plan, value: &TypedBody) -> () {
  if !enter(&mut plan.*) { return () }
  let locals = TypedBody.localSlice(value)
  let nodes = TypedBody.nodeSlice(value)
  if nodes.length > BodyWire.NODE_LIMIT - plan.nodes || locals.length > BodyWire.ENTRY_LIMIT - plan.locals {
    refusePlan(&mut plan.*, BodyWire.RESOURCE)
    leave(&mut plan.*)
    return ()
  }
  plan.nodes = plan.nodes + nodes.length
  plan.locals = plan.locals + locals.length
  number(&mut plan.*, usize.toU64(nodes.length))
  number(&mut plan.*, usize.toU64(locals.length))
  planDeclarationId(&mut plan.*, TypedBody.declarationId(value))
  planOption_Environment_(&mut plan.*, TypedBody.environmentOf(value))
  let localsValues = TypedBody.localSlice(value)
  number(&mut plan.*, usize.toU64(localsValues.length))
  let mut localsAt = usize.ZERO
  while localsAt < localsValues.length && !plan.failed {
    planLocal(&mut plan.*, &localsValues[localsAt])
    localsAt = localsAt + usize.ONE
  }
  let nodesValues = TypedBody.nodeSlice(value)
  number(&mut plan.*, usize.toU64(nodesValues.length))
  let mut nodesAt = usize.ZERO
  while nodesAt < nodesValues.length && !plan.failed {
    planNode(&mut plan.*, &nodesValues[nodesAt])
    nodesAt = nodesAt + usize.ONE
  }
  let root = TypedBody.rootNode(value)
  planNodeId(&mut plan.*, &root)
  let dependenciesValues = TypedBody.signatureDependencies(value)
  number(&mut plan.*, usize.toU64(dependenciesValues.length))
  let mut dependenciesAt = usize.ZERO
  while dependenciesAt < dependenciesValues.length && !plan.failed {
    planSignatureDependency(&mut plan.*, &dependenciesValues[dependenciesAt])
    dependenciesAt = dependenciesAt + usize.ONE
  }
  let requiredValues = TypedBody.runtimeBodies(value)
  number(&mut plan.*, usize.toU64(requiredValues.length))
  let mut requiredAt = usize.ZERO
  while requiredAt < requiredValues.length && !plan.failed {
    planDeclarationId(&mut plan.*, &requiredValues[requiredAt])
    requiredAt = requiredAt + usize.ONE
  }
  planStage(&mut plan.*, TypedBody.checkingStage(value))
  let iterationsValues = TypedBody.staticIterations(value)
  number(&mut plan.*, usize.toU64(iterationsValues.length))
  let mut iterationsAt = usize.ZERO
  while iterationsAt < iterationsValues.length && !plan.failed {
    planStaticIteration(&mut plan.*, &iterationsValues[iterationsAt])
    iterationsAt = iterationsAt + usize.ONE
  }
  let resolutionsValues = TypedBody.resolutionSlice(value)
  number(&mut plan.*, usize.toU64(resolutionsValues.length))
  let mut resolutionsAt = usize.ZERO
  while resolutionsAt < resolutionsValues.length && !plan.failed {
    planResolution(&mut plan.*, &resolutionsValues[resolutionsAt])
    resolutionsAt = resolutionsAt + usize.ONE
  }
  leave(&mut plan.*)
}

effect fn readTypedBody(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<TypedBody>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if !BodyWire.enterRead(&mut input.*) { return Option<TypedBody>.none() }
  let oldNodes = state.nodeLimit
  let oldLocals = state.localLimit
  let result = run readTypedBodyValue(&mut state.*, bytes, &mut input.*)
  state.nodeLimit = oldNodes
  state.localLimit = oldLocals
  BodyWire.leaveRead(&mut input.*)
  return move result
}

effect fn readTypedBodyValue(state: &mut Decode, bytes: &[u8], input: &mut BodyWire.Reader) -> Option<TypedBody>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let nodes = BodyWire.count(bytes, &mut input.*, BodyWire.NODE_LIMIT - state.nodes)
  let locals = BodyWire.count(bytes, &mut input.*, BodyWire.ENTRY_LIMIT - state.locals)
  if input.failed || nodes == usize.ZERO { return Option<TypedBody>.none() }
  state.nodes = state.nodes + nodes
  state.locals = state.locals + locals
  state.nodeLimit = nodes
  state.localLimit = locals
  let body_declaration = match move run readDeclarationId(&mut state.*, bytes, &mut input.*) { Option<DeclarationId>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_environment = match move run readOption_Environment_(&mut state.*, bytes, &mut input.*) { Option<Option<Environment>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_locals = match move run readList_Local_(&mut state.*, bytes, &mut input.*) { Option<List<Local>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_nodes = match move run readList_Node_(&mut state.*, bytes, &mut input.*) { Option<List<Node>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_root = match move run readNodeId(&mut state.*, bytes, &mut input.*) { Option<NodeId>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_dependencies = match move run readList_SignatureDependency_(&mut state.*, bytes, &mut input.*) { Option<List<SignatureDependency>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_required = match move run readList_DeclarationId_(&mut state.*, bytes, &mut input.*) { Option<List<DeclarationId>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_stage = match move run readStage(&mut state.*, bytes, &mut input.*) { Option<Stage>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_iterations = match move run readList_StaticIteration_(&mut state.*, bytes, &mut input.*) { Option<List<StaticIteration>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  let body_resolutions = match move run readList_Resolution_(&mut state.*, bytes, &mut input.*) { Option<List<Resolution>>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<TypedBody>.none() } }
  if List<Node>.length(&body_nodes) != nodes || List<Local>.length(&body_locals) != locals || input.failed {
    input.failed = true
    return Option<TypedBody>.none()
  }
  let body = run TypedBody.make(&body_declaration, move body_locals, move body_nodes, body_root,
    move body_dependencies, move body_required, move body_stage, move body_iterations)
  let withNames = TypedBody.withResolutions(move body, move body_resolutions)
  return Option<TypedBody>.some(TypedBody.withPortableEnvironment(move withNames, move body_environment))
}


/// Encodes one complete body with exact application/profile/source context supplied by the caller.
/// Unsupported type evidence or any resource limit returns none; no query is published here.
pub struct EncodeResult {
  pub bytes: Option<Bytes>,
  pub reason: usize,
}

fn refusedEncode(reason: usize) -> EncodeResult {
  return EncodeResult {bytes: Option<Bytes>.none(), reason: reason}
}

pub effect fn encode(body: &TypedBody, context: &[u8]) -> Option<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let result = run encodeDetailed(body, context)
  return move result.bytes
}

pub effect fn encodeDetailed(body: &TypedBody, context: &[u8]) -> EncodeResult
! OutOfMemoryError ? &mut Allocator {
  if context.length > 524288 { return refusedEncode(BodyWire.SIZE) }
  let mut plan = Plan {reason: BodyWire.NONE, atoms: List<Atom>.make(), counting: true, failed: false,
    count: usize.ZERO, depth: usize.ZERO, nodes: usize.ZERO, locals: usize.ZERO}
  planTypedBody(&mut plan, body)
  if plan.failed { return refusedEncode(plan.reason) }
  let count = plan.count
  if count > 524288 / 8 { return refusedEncode(BodyWire.SIZE) }
  plan.atoms = run List<Atom>.makeWithCapacity(count)
  plan.counting = false
  plan.count = usize.ZERO
  plan.nodes = usize.ZERO
  plan.locals = usize.ZERO
  planTypedBody(&mut plan, body)
  if plan.failed { return refusedEncode(plan.reason) }
  if plan.count != count { return refusedEncode(BodyWire.MALFORMED_PLAN) }
  let mut output = BodyWire.writer()
  output.limit = 524288
  run BodyWire.field(&mut output, b"typed-body-capsule-v1")
  run BodyWire.field(&mut output, context)
  let mut types = BodyTypes.encoder()
  let values = List<Atom>.asSlice(&plan.atoms)
  let mut at = usize.ZERO
  while at < values.length && !output.failed {
    match &values[at] {
      Atom.Word {value} => run BodyWire.word(&mut output, value)
      Atom.Type {value} => run BodyTypes.writeType(&mut types, &mut output, &value)
      Atom.Lifetime {value} => run BodyTypes.writeLifetime(&mut types, &mut output, &value)
      Atom.Application {value} => run BodyTypes.writeApplication(&mut types, &mut output, &value)
      Atom.StaticData {value} => run BodyTypes.writeStaticData(&mut types, &mut output, &value)
      Atom.Declaration {value} => run BodyTypes.writeDeclaration(&mut types, &mut output, &value)
      Atom.Binding {value} => run BodyTypes.writeBinding(&mut types, &mut output, &value)
      Atom.Bytes {value} => {
        let count = Shared<Bytes>.with<usize>(&value, Bytes.length)
        if count > output.limit { BodyWire.refuse(&mut output, BodyWire.SIZE) }
        else {
          let mut copied = run Bytes.zeroed(count)
          Shared<Bytes>.with<()>( &value, fn(held: &Bytes) -> () {
            let from = Bytes.asSlice(held)
            let into = Bytes.asMutSlice(&mut copied)
            let mut position = usize.ZERO
            while position < from.length { into[position] = from[position]
              position = position + usize.ONE }
          })
          run BodyWire.field(&mut output, Bytes.asSlice(&copied))
        }
      }
    }
    at = at + usize.ONE
  }
  if output.failed { return refusedEncode(if output.reason == BodyWire.NONE { BodyWire.OTHER } else { output.reason }) }
  return EncodeResult {bytes: Option<Bytes>.some(move output.bytes), reason: BodyWire.NONE}
}

/// Reconstructs owned body data and receiver-local interned types after exact context matching.
/// Failure never installs a semantic answer; the caller must validate the separate provider guard.
pub effect fn decode(bytes: &[u8], expectedContext: &[u8]) -> Option<TypedBody>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut input = BodyWire.reader(bytes)
  let magic = BodyWire.readField(bytes, &mut input)
  let context = BodyWire.readField(bytes, &mut input)
  if input.failed || !RuntimeEncoding.equals(StableKey.view(bytes, magic), b"typed-body-capsule-v1") ||
    !RuntimeEncoding.equals(StableKey.view(bytes, context), expectedContext) { return Option<TypedBody>.none() }
  let mut state = Decode {types: BodyTypes.decoder(), nodeLimit: usize.ZERO,
    localLimit: usize.ZERO, nodes: usize.ZERO, locals: usize.ZERO}
  let body = run readTypedBody(&mut state, bytes, &mut input)
  if !BodyWire.finished(bytes, &input) { return Option<TypedBody>.none() }
  return move body
}

import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.DeclarationId {OwnerStep}
import semantic.Types {TypeTable}
import silk.testing.testing {Testing, AssertionError}
import silk.core.effect {Effect}

// A compact body whose metadata is independently inspected after decoding into another table.
effect fn fixtureBody(checked: bool, badRoot: bool) -> TypedBody
! OutOfMemoryError | InvalidModulePath ? &mut Allocator | &mut Types {
  let id = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"capsule", b"body"), List<OwnerStep>.make())
  let ty = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let mut locals = List<Local>.make()
  run List<Local>.append(&mut locals, Local {origin: Origin {node: 4, location: Location.make(5, 6)},
    ty: Interned<Type>.clone(&ty), mutable: true, meetDepth: Option<usize>.some(2), written: true})
  let mut nodes = List<Node>.make()
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 7, location: Location.make(8, 9)},
    kind: NodeKind.Expression {ty: Interned<Type>.clone(&ty), form: Expression.Boolean {value: true}}})
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 10, location: Location.make(11, 12)},
    kind: NodeKind.Return {value: Option<NodeId>.some(NodeId {index: usize.ZERO})}})
  let mut dependencies = List<SignatureDependency>.make()
  run List<SignatureDependency>.append(&mut dependencies, SignatureDependency {declaration: DeclarationId.copy(&id)})
  let mut required = List<DeclarationId>.make()
  run List<DeclarationId>.append(&mut required, DeclarationId.copy(&id))
  let mut iterations = List<StaticIteration>.make()
  run List<StaticIteration>.append(&mut iterations, StaticIteration {syntax: 2, ordinal: 3,
    nodeStart: usize.ZERO, nodeEnd: 2, localStart: usize.ZERO, localEnd: usize.ONE})
  let mut stage = Stage.ContractTyped
  if checked { stage = Stage.FullyChecked }
  let mut root = usize.ONE
  if badRoot { root = 99 }
  let body = run TypedBody.make(&id, move locals, move nodes, NodeId {index: root}, move dependencies,
    move required, move stage, move iterations)
  let mut resolutions = List<Resolution>.make()
  run List<Resolution>.append(&mut resolutions, Resolution {origin: Origin {node: 4, location: Location.make(5, 6)},
    referent: Referent.Local {local: LocalId {index: usize.ZERO}}})
  return TypedBody.withResolutions(move body, move resolutions)
}

effect fn capsuleClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut producer = TypeTable.make()
  let mut consumer = TypeTable.make()
  let mut checked = false
  let mut pass = usize.ZERO
  while pass < 2 {
    let original = run fixtureBody(checked, false) |> Effect.provideMut<Types>(&mut producer)
    let encoded = run encodeDetailed(&original, b"application/profile/source-observation")
    run Testing.expect(encoded.reason == BodyWire.NONE, "successful encoding has no refusal reason")
    let bytes = match move encoded.bytes { Option<Bytes>.Some {value} => move value _ => {
      run Testing.expect(false, "ordinary scalar body is supported by the portable capsule")
      return ()
    } }
    let decoded = run decode(Bytes.asSlice(&bytes), b"application/profile/source-observation") |> Effect.provideMut<Types>(&mut consumer)
    let body = match move decoded { Option<TypedBody>.Some {value} => move value _ => {
      run Testing.expect(false, "portable body reconstructs in a different type table")
      return ()
    } }
    run Testing.expect(DeclarationId.equals(TypedBody.declarationId(&body), TypedBody.declarationId(&original))
      && TypedBody.rootNode(&body).index == usize.ONE && TypedBody.nodeSlice(&body).length == 2,
      "body identity, root and local graph survive receiver-local reconstruction")
    let locals = TypedBody.localSlice(&body)
    run Testing.expect(locals.length == usize.ONE && locals[0].mutable && locals[0].written
      && locals[0].origin.node == 4 && locals[0].origin.location.start == 5
      && match &locals[0].meetDepth { Option<usize>.Some {value} => value == 2 _ => false },
      "relative origins and local binding-region metadata are preserved")
    let bodyStage = TypedBody.checkingStage(&body)
    let full = match &bodyStage.* { Stage.FullyChecked => true _ => false }
    run Testing.expect(full == checked && TypedBody.signatureDependencies(&body).length == usize.ONE
      && TypedBody.runtimeBodies(&body).length == usize.ONE && TypedBody.staticIterations(&body).length == usize.ONE
      && TypedBody.resolutionSlice(&body).length == usize.ONE,
      "contract-only bodies never acquire checked status and all retained body evidence survives")
    let reencoded = run encode(&body, b"application/profile/source-observation")
    run Testing.expect(match &reencoded { Option<Bytes>.Some {value} => RuntimeEncoding.equals(Bytes.asSlice(&value), Bytes.asSlice(&bytes)) _ => false },
      "receiver-local type interning never changes portable identity or body evidence")
    let mismatch = run decode(Bytes.asSlice(&bytes), b"another-application") |> Effect.provideMut<Types>(&mut consumer)
    run Testing.expect(match &mismatch { Option<TypedBody>.None => true _ => false }, "exact context mismatch refuses before publication")
    let mut trailing = run Bytes.copy(Bytes.asSlice(&bytes))
    run Bytes.append(&mut trailing, b"x")
    let malformed = run decode(Bytes.asSlice(&trailing), b"application/profile/source-observation") |> Effect.provideMut<Types>(&mut consumer)
    run Testing.expect(match &malformed { Option<TypedBody>.None => true _ => false }, "trailing capsule bytes cannot be silently ignored")
    checked = true
    pass = pass + usize.ONE
  }
  let invalid = run fixtureBody(true, true) |> Effect.provideMut<Types>(&mut producer)
  let encodedInvalid = run encode(&invalid, b"same")
  if let Option<Bytes>.Some {value} = move encodedInvalid {
    let refused = run decode(Bytes.asSlice(&value), b"same") |> Effect.provideMut<Types>(&mut consumer)
    run Testing.expect(match &refused { Option<TypedBody>.None => true _ => false }, "body-local root indexes are validated before a body is returned")
  }
  let mut rejectedPlan = Plan {reason: BodyWire.NONE, atoms: List<Atom>.make(), counting: true, failed: false,
    count: usize.ZERO, depth: usize.ZERO, nodes: usize.ZERO, locals: usize.ZERO}
  planNodeKind(&mut rejectedPlan, &NodeKind.Recovered {resumes: false})
  run Testing.expect(rejectedPlan.failed && rejectedPlan.reason == BodyWire.MALFORMED_PLAN,
    "a recovered statement is classified separately from a resource refusal")
  let truncated = run decode(b"short", b"same") |> Effect.provideMut<Types>(&mut consumer)
  run Testing.expect(match &truncated { Option<TypedBody>.None => true _ => false }, "truncated fields refuse without querying semantic providers")
}

test effect fn typedBodyCapsulePreservesStageOriginsAndContext() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run capsuleClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedCapsuleClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let child = run fixtureBody(true, false)
  let id = DeclarationId.copy(TypedBody.declarationId(&child))
  let ty = Interned<Type>.clone(&TypedBody.localSlice(&child)[0].ty)
  let region = run Types.internLifetime(Lifetime.Local {declaration: DeclarationId.copy(&id), ordinal: 6, binder: 7})
  let mut requirements = List<RegionRequirement>.make()
  run List<RegionRequirement>.append(&mut requirements, RegionRequirement {
    longer: Interned<Lifetime>.clone(&region), shorter: Interned<Lifetime>.clone(&region), site: Location.make(16, 17)})
  let mut referents = List<ReferentCapture>.make()
  run List<ReferentCapture>.append(&mut referents, ReferentCapture {field: 3, access: Access.Mutable, region: Interned<Lifetime>.clone(&region)})
  let mut nodes = List<Node>.make()
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 1, location: Location.make(2, 3)},
    kind: NodeKind.Expression {ty: Interned<Type>.clone(&ty), form: Expression.Callable {
      fields: List<AggregateField>.make(), referents: move referents, requirements: move requirements,
      body: run Shared<TypedBody>.make(move child)}}})
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 4, location: Location.make(5, 6)},
    kind: NodeKind.Expression {ty: Interned<Type>.clone(&ty), form: Expression.ForeignAddress {
      declaration: run Types.internDeclaration(DeclarationId.copy(&id)), symbol: run Shared<Bytes>.make(run Bytes.copy(b"foreign_symbol"))}}})
  run List<Node>.append(&mut nodes, Node {origin: Origin {node: 7, location: Location.make(8, 9)},
    kind: NodeKind.Return {value: Option<NodeId>.some(NodeId {index: usize.ZERO})}})
  let parent = run TypedBody.make(&id, List<Local>.make(), move nodes, NodeId {index: 2},
    List<SignatureDependency>.make(), List<DeclarationId>.make(), Stage.ContractTyped, List<StaticIteration>.make())
  let mut captures = List<EnvironmentCapture>.make()
  run List<EnvironmentCapture>.append(&mut captures, EnvironmentCapture {local: LocalId {index: usize.ONE}, field: 3, dereference: true})
  let body = TypedBody.withPortableEnvironment(move parent, Option<Environment>.some(Environment {
    ty: move ty, outerCount: 2, captures: move captures}))
  let encoded = run encode(&body, b"nested-source")
  let bytes = match move encoded { Option<Bytes>.Some {value} => move value _ => {
    run Testing.expect(false, "nested immutable bodies are portable without borrowed Shared pointers")
    return ()
  } }
  let mut receiving = TypeTable.make()
  let decoded = run decode(Bytes.asSlice(&bytes), b"nested-source") |> Effect.provideMut<Types>(&mut receiving)
  let imported = match move decoded { Option<TypedBody>.Some {value} => move value _ => {
    run Testing.expect(false, "nested body indexes restore the surrounding body's local reference bounds")
    return ()
  } }
  let importedNodes = TypedBody.nodeSlice(&imported)
  let mut nested = false
  if let NodeKind.Expression {form: Expression.Callable {body: nestedBody, referents: nestedReferents, requirements: nestedRequirements, ..}, ..} = &importedNodes[0].kind {
    nested = Shared<TypedBody>.with<bool>(&nestedBody, fn(value: &TypedBody) -> bool {
      let stage = TypedBody.checkingStage(value)
      return TypedBody.nodeSlice(value).length == 2 && TypedBody.rootNode(value).index == usize.ONE
        && match &stage.* { Stage.FullyChecked => true _ => false }
    }) && List<ReferentCapture>.asSlice(&nestedReferents)[0].field == 3
      && List<RegionRequirement>.asSlice(&nestedRequirements)[0].site.start == 16
  }
  run Testing.expect(nested, "nested stage, relative origins and captured region requirements remain intact")
  let mut symbol = false
  if let NodeKind.Expression {form: Expression.ForeignAddress {symbol: retained, ..}, ..} = &importedNodes[1].kind {
    symbol = Shared<Bytes>.with<bool>(&retained, fn(value: &Bytes) -> bool { return RuntimeEncoding.equals(Bytes.asSlice(value), b"foreign_symbol") })
  }
  let environment = TypedBody.environmentOf(&imported)
  let mut exactEnvironment = false
  if let Option<Environment>.Some {value} = &environment.* {
    let entries = List<EnvironmentCapture>.asSlice(&value.captures)
    exactEnvironment = value.outerCount == 2 && entries.length == usize.ONE && entries[0].local.index == usize.ONE
      && entries[0].field == 3 && entries[0].dereference
  }
  run Testing.expect(symbol && exactEnvironment && TypedBody.rootNode(&imported).index == 2,
    "foreign payload bytes and lexical outer captures preserve their own index domain")
}

test effect fn typedBodyCapsulePreservesNestedSharedPayloadAndEnvironment() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  run nestedCapsuleClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
