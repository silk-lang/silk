fn planExpression(plan: &mut Plan, value: &Expression) -> () {
  if !enter(&mut plan.*) { return () }
  match &value.* {
  Expression.Integer {literal} => { number(&mut plan.*, 0)
  planusize(&mut plan.*, &literal)
  }
  Expression.Float {literal} => { number(&mut plan.*, 1)
  planusize(&mut plan.*, &literal)
  }
  Expression.Text {literal} => { number(&mut plan.*, 2)
  planusize(&mut plan.*, &literal)
  }
  Expression.Boolean {value: selectedValue} => { number(&mut plan.*, 3)
  planbool(&mut plan.*, &selectedValue)
  }
  Expression.Unit => { number(&mut plan.*, 4)
  }
  Expression.Local {local} => { number(&mut plan.*, 5)
  planLocalId(&mut plan.*, &local)
  }
  Expression.Borrow {access, value: selectedValue} => { number(&mut plan.*, 6)
  planAccess(&mut plan.*, &access)
  planNodeId(&mut plan.*, &selectedValue)
  }
  Expression.PointerWeaken {value: selectedValue} => { number(&mut plan.*, 7)
  planNodeId(&mut plan.*, &selectedValue)
  }
  Expression.Dereference {value: selectedValue} => { number(&mut plan.*, 8)
  planNodeId(&mut plan.*, &selectedValue)
  }
  Expression.Field {value: selectedValue, index, declared} => { number(&mut plan.*, 9)
  planNodeId(&mut plan.*, &selectedValue)
  planusize(&mut plan.*, &index)
  planInterned_Type_(&mut plan.*, &declared)
  }
  Expression.ArraySlice {value: selectedValue, count} => { number(&mut plan.*, 10)
  planNodeId(&mut plan.*, &selectedValue)
  planusize(&mut plan.*, &count)
  }
  Expression.SliceLength {value: selectedValue} => { number(&mut plan.*, 11)
  planNodeId(&mut plan.*, &selectedValue)
  }
  Expression.Index {value: selectedValue, index, element} => { number(&mut plan.*, 12)
  planNodeId(&mut plan.*, &selectedValue)
  planNodeId(&mut plan.*, &index)
  planusize(&mut plan.*, &element)
  }
  Expression.ArrayLength {value: selectedValue, count} => { number(&mut plan.*, 13)
  planNodeId(&mut plan.*, &selectedValue)
  planusize(&mut plan.*, &count)
  }
  Expression.ArrayRepeat {value: selectedValue, count} => { number(&mut plan.*, 14)
  planNodeId(&mut plan.*, &selectedValue)
  planusize(&mut plan.*, &count)
  }
  Expression.Aggregate {fields, written, section} => { number(&mut plan.*, 15)
  planList_AggregateField_(&mut plan.*, &fields)
  planList_Interned_Lifetime__(&mut plan.*, &written)
  planOption_SectionRetention_(&mut plan.*, &section)
  }
  Expression.Callable {fields, referents, requirements, body} => { number(&mut plan.*, 16)
  planList_AggregateField_(&mut plan.*, &fields)
  planList_ReferentCapture_(&mut plan.*, &referents)
  planList_RegionRequirement_(&mut plan.*, &requirements)
  planShared_TypedBody_(&mut plan.*, &body)
  }
  Expression.StagedCallable {callee, mode, arguments, retention} => { number(&mut plan.*, 17)
  planNodeId(&mut plan.*, &callee)
  planCallableMode(&mut plan.*, &mode)
  planList_NodeId_(&mut plan.*, &arguments)
  planSectionRetention(&mut plan.*, &retention)
  }
  Expression.Constant {declaration} => { number(&mut plan.*, 18)
  planInterned_DeclarationId_(&mut plan.*, &declaration)
  }
  Expression.ForeignStatic {declaration} => { number(&mut plan.*, 19)
  planInterned_DeclarationId_(&mut plan.*, &declaration)
  }
  Expression.ForeignAddress {declaration, symbol} => { number(&mut plan.*, 20)
  planInterned_DeclarationId_(&mut plan.*, &declaration)
  planShared_Bytes_(&mut plan.*, &symbol)
  }
  Expression.EnumMember {member} => { number(&mut plan.*, 21)
  planEnumMember(&mut plan.*, &member)
  }
  Expression.EnumValue {value: selectedValue} => { number(&mut plan.*, 22)
  planNodeId(&mut plan.*, &selectedValue)
  }
  Expression.UnionInject {tag, value: selectedValue} => { number(&mut plan.*, 23)
  planusize(&mut plan.*, &tag)
  planNodeId(&mut plan.*, &selectedValue)
  }
  Expression.UnionWiden {value: selectedValue} => { number(&mut plan.*, 24)
  planNodeId(&mut plan.*, &selectedValue)
  }
  Expression.VariantConstruct {tag, fields} => { number(&mut plan.*, 25)
  planusize(&mut plan.*, &tag)
  planList_AggregateField_(&mut plan.*, &fields)
  }
  Expression.PatternBinding {subject, path, access, declared} => { number(&mut plan.*, 26)
  planNodeId(&mut plan.*, &subject)
  planList_PlaceStep_(&mut plan.*, &path)
  planBindingAccess(&mut plan.*, &access)
  planInterned_Type_(&mut plan.*, &declared)
  }
  Expression.Match {subject, access, tags, domain, arms, syntax} => { number(&mut plan.*, 27)
  planNodeId(&mut plan.*, &subject)
  planSubjectAccess(&mut plan.*, &access)
  planusize(&mut plan.*, &tags)
  planusize(&mut plan.*, &domain)
  planList_MatchArm_(&mut plan.*, &arms)
  planMatchSyntax(&mut plan.*, &syntax)
  }
  Expression.CompileError {message} => { number(&mut plan.*, 28)
  planNodeId(&mut plan.*, &message)
  }
  Expression.Embedded {value: selectedValue} => { number(&mut plan.*, 29)
  planInterned_StaticData_(&mut plan.*, &selectedValue)
  }
  Expression.Move {value: selectedValue, consumed} => { number(&mut plan.*, 30)
  planNodeId(&mut plan.*, &selectedValue)
  planOption_ConsumedPlace_(&mut plan.*, &consumed)
  }
  Expression.CallableCall {callee, mode, arguments, inference, bindings, pipeline, constructs, kept} => { number(&mut plan.*, 31)
  planNodeId(&mut plan.*, &callee)
  planCallableMode(&mut plan.*, &mode)
  planList_NodeId_(&mut plan.*, &arguments)
  planInterned_DeclarationId_(&mut plan.*, &inference)
  planShared_List_Binding__(&mut plan.*, &bindings)
  planbool(&mut plan.*, &pipeline)
  planbool(&mut plan.*, &constructs)
  planShared_List_KeptRegions__(&mut plan.*, &kept)
  }
  Expression.DirectCall {declaration, application, receiverPass, constructs, arguments, kept, written, writtenLifetimes} => { number(&mut plan.*, 32)
  planDeclarationId(&mut plan.*, &declaration)
  planInterned_Application_(&mut plan.*, &application)
  planOption_ReceiverPass_(&mut plan.*, &receiverPass)
  planbool(&mut plan.*, &constructs)
  planList_NodeId_(&mut plan.*, &arguments)
  planShared_List_KeptRegions__(&mut plan.*, &kept)
  planList_Interned_Type__(&mut plan.*, &written)
  planShared_List_usize__(&mut plan.*, &writtenLifetimes)
  }
  Expression.ForeignCall {declaration, arguments, variadicArguments} => { number(&mut plan.*, 33)
  planDeclarationId(&mut plan.*, &declaration)
  planList_NodeId_(&mut plan.*, &arguments)
  planShared_List_CAbi_VariadicArgument__(&mut plan.*, &variadicArguments)
  }
  Expression.Run {value: selectedValue, access} => { number(&mut plan.*, 34)
  planNodeId(&mut plan.*, &selectedValue)
  planRunAccess(&mut plan.*, &access)
  }
  Expression.IntrinsicCall {member, arguments} => { number(&mut plan.*, 35)
  planMember(&mut plan.*, &member)
  planList_NodeId_(&mut plan.*, &arguments)
  }
  Expression.StorageCall {operation, typeArguments, arguments} => { number(&mut plan.*, 36)
  planStorageOperation(&mut plan.*, &operation)
  planList_Interned_Type__(&mut plan.*, &typeArguments)
  planList_NodeId_(&mut plan.*, &arguments)
  }
  Expression.ConcretePrefix {operator, operand} => { number(&mut plan.*, 37)
  planPrefixOperator(&mut plan.*, &operator)
  planNodeId(&mut plan.*, &operand)
  }
  Expression.ConcreteInfix {operator, left, right} => { number(&mut plan.*, 38)
  planInfixOperator(&mut plan.*, &operator)
  planNodeId(&mut plan.*, &left)
  planNodeId(&mut plan.*, &right)
  }
  Expression.InterfaceCall {contract, provider, operation, bindings, implementation, receiverPass, isEffect, arguments, kept, statics} => { number(&mut plan.*, 39)
  planInterned_Type_(&mut plan.*, &contract)
  planInterned_Type_(&mut plan.*, &provider)
  planDeclarationId(&mut plan.*, &operation)
  planShared_List_Binding__(&mut plan.*, &bindings)
  planOption_Interned_DeclarationId__(&mut plan.*, &implementation)
  planOption_ReceiverPass_(&mut plan.*, &receiverPass)
  planbool(&mut plan.*, &isEffect)
  planList_NodeId_(&mut plan.*, &arguments)
  planShared_List_KeptRegions__(&mut plan.*, &kept)
  planShared_List_StaticSlot__(&mut plan.*, &statics)
  }
  }
  leave(&mut plan.*)
}

