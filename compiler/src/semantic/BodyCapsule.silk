  let field_code = match move run readCode(&mut state.*, bytes, &mut input.*) { Option<Code>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<ScalarOperation>.none() } }
  let field_target = match move run readScalar(&mut state.*, bytes, &mut input.*) { Option<Scalar>.Some {value: decoded} => move decoded _ => { input.failed = true
    return Option<ScalarOperation>.none() } }
  let result = ScalarOperation {actor: move field_actor, code: move field_code, target: move field_target}
  if input.failed { return Option<ScalarOperation>.none() }
  return Option<ScalarOperation>.some(move result)
}

