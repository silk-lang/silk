//! Hash-bucketed lookup for append-only tables interned under a structural equality.
//!
//! # When to use
//! Use [`InternIndex`] beside a `Vector` whose entries are interned under an equality that cannot
//! be a `HashKey` witness, such as an effectful comparison of shared types or of canonical
//! encodings. The caller hashes each value so that equal values always share a hash, compares only
//! the entries recorded under the probe's hash, and records each entry it appends.
//!
//! # Details
//! Entries recorded under one hash are presented oldest first, so a lookup finds the same equal
//! entry a full scan of the table finds first. Recording and finding the first candidate take
//! expected constant time; only entries whose hashes collide share a chain.
//!
//! # Gotchas
//! The index cannot check the caller's hash. A hash that differs for two equal values lets the
//! table hold both, and a lookup then finds only the entry recorded under the probe's own hash.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.hash {Hash, Word}
import silk.hash_map {HashMap}
import silk.option {Option}
import silk.u8
import silk.usize
import silk.vector {Vector}

// The oldest and newest entry recorded under one hash.
struct Chain {
  first: usize
  last: usize
}

impl Copy for Chain {}

/// The entries of one append-only table, bucketed by caller-computed hashes.
pub struct InternIndex {
  chains: HashMap<Word, Chain>
  // For each recorded entry, the next newer entry recorded under the same hash, or `usize.MAX`.
  successors: Vector<usize>
}

impl InternIndex {
  /// Folds a byte string's length and then each byte into `start`.
  ///
  /// # Details
  ///
  /// Equal byte strings fold to the same hash from the same start, and the length keeps adjacent
  /// strings folded in sequence from exchanging bytes. Byte-keyed tables, identity hashes, and
  /// fixed-width content digests share this fold.
  pub fn hashBytes(start: u64, bytes: &[u8]) -> u64 {
    let mut hashed = Hash.combine(start, usize.toU64(bytes.length))
    let mut at = usize.ZERO
    while at < bytes.length {
      hashed = Hash.combine(hashed, u8.toU64(bytes[at]))
      at = at + usize.ONE
    }
    return hashed
  }
  /// Creates an index that has recorded no entry. It allocates nothing until the first record.
  pub fn make() -> InternIndex {
    return InternIndex {chains: HashMap.make<Word, Chain>(Hash.seed(0)), successors: Vector.make<usize>()}
  }
  /// Returns the oldest entry recorded under `hash`, or `usize.MAX` when none is.
  pub fn first(self: &Self, hash: u64) -> usize {
    let found = HashMap.get<Word, Chain>(&self.chains, Hash.word(hash))
    if let Option<Chain>.Some {value} = move found {
      return value.first
    }
    return usize.MAX
  }
  /// Returns the next newer entry recorded under the same hash as `entry`, or `usize.MAX`.
  pub fn after(self: &Self, entry: usize) -> usize {
    return Vector.get<usize>(&self.successors, entry)
  }
  /// Records the table's next entry under `hash`; its ordinal is the number of earlier records.
  ///
  /// # Gotchas
  ///
  /// Record every table entry exactly once and in table order.
  pub effect fn record(self: &mut Self, hash: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    let entry = Vector.length<usize>(&self.successors)
    run Vector.append<usize>(&mut self.successors, usize.MAX)
    let mut first = entry
    let found = HashMap.get<Word, Chain>(&self.chains, Hash.word(hash))
    if let Option<Chain>.Some {value} = move found {
      Vector.set<usize>(&mut self.successors, value.last, entry)
      first = value.first
    }
    let replaced = run HashMap.insert<Word, Chain>(&mut self.chains, Hash.word(hash), Chain {first: first, last: entry})
    drop replaced
    return ()
  }
}
