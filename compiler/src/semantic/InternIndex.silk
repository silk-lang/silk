//! Open-addressed hash index for append-only tables interned under a structural equality.
//!
//! # When to use
//! Use [`InternIndex`] beside a `List` whose entries are interned under an equality that cannot
//! be a `HashKey` witness, such as an effectful comparison of shared types or of canonical
//! encodings. The caller hashes each value so that equal values always share a hash, compares only
//! the entries recorded under the probe's hash, and records each entry it appends.
//!
//! # Details
//! Entries recorded under one hash are presented oldest first, so a lookup finds the same equal
//! entry a full scan of the table finds first. Distinct hashes occupy one slot each in an
//! `h2`-tagged open-addressed linear-probing table (1-byte control tag per slot plus 4-byte entry
//! index) that doubles before exceeding 75% load, while entries sharing the exact same 64-bit hash
//! link in insertion order via `successors`. Only entries whose hashes match reach the caller's
//! comparison.
//!
//! # Gotchas
//! The index cannot check the caller's hash. A hash that differs for two equal values lets the
//! table hold both, and a lookup then finds only the entry recorded under the probe's own hash.

import silk.collections.hash {Hash}
import silk.collections.list {List}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// The entries of one append-only table, indexed by caller-computed hashes.
pub struct InternIndex {
  // Open-addressed control bytes: `0` is empty; `0x80 | h2(mixed)` marks an occupied slot.
  controls: List<u8>,
  // For each occupied slot in `controls`, the oldest entry recorded under its exact 64-bit hash.
  slots: List<u32>,
  // For each recorded entry, its hash and the next newer entry with the exact same hash, or `u32.MAX`.
  hashes: List<u64>,
  successors: List<u32>,
}

fn fullWord(bytes: &[u8], start: usize) -> u64 {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(bytes))
    return Pointer.readUnaligned<u64>(
      Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Pointer.at<u8>(base, start)),
    )
  }
}

fn mixHash(hash: u64) -> u64 {
  return Hash.mix(&Hash.seed(0), hash)
}

// 7-bit fingerprint with high bit set so every occupied control byte is non-zero.
fn controlTag(mixed: u64) -> u8 {
  return u64.toU8(u64.bitOr(u64.shiftRight(mixed, 57), 128))
}

fn homeSlot(mixed: u64, mask: usize) -> usize {
  return u64.toUsize(u64.bitAnd(mixed, usize.toU64(mask)))
}

fn insertSlot(
  controls: &mut List<u8>,
  slots: &mut List<u32>,
  hashes: &[u64],
  successors: &mut List<u32>,
  entry: usize,
  hash: u64,
) -> () {
  let mut ctrlSlice = List<u8>.asMutSlice(&mut controls.*)
  let mut slotSlice = List<u32>.asMutSlice(&mut slots.*)
  let mut succSlice = List<u32>.asMutSlice(&mut successors.*)
  let mask = ctrlSlice.length - usize.ONE
  let mixed = mixHash(hash)
  let tag = controlTag(mixed)
  let mut pos = homeSlot(mixed, mask)
  while true {
    let ctrl = ctrlSlice[pos]
    if ctrl == 0 {
      ctrlSlice[pos] = tag
      slotSlice[pos] = usize.toU32(entry)
      return ()
    }
    if ctrl == tag {
      let head = u32.toUsize(slotSlice[pos])
      if hashes[head] == hash {
        let mut tail = head
        while succSlice[tail] != u32.MAX {
          tail = u32.toUsize(succSlice[tail])
        }
        succSlice[tail] = usize.toU32(entry)
        return ()
      }
    }
    pos = usize.bitAnd(pos + usize.ONE, mask)
  }
  return ()
}

effect fn emptyControls(width: usize) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut controls = run List<u8>.makeWithCapacity(width)
  run List<u8>.appendRepeated(&mut controls, 0, width)
  return move controls
}

effect fn emptySlots(width: usize) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut slots = run List<u32>.makeWithCapacity(width)
  run List<u32>.appendRepeated(&mut slots, 0, width)
  return move slots
}

// Rebuilds the open-addressed table to `width` slots, relinking every recorded entry in order.
effect fn rebuild(index: &mut InternIndex, width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut controls = run emptyControls(width)
  let mut slots = run emptySlots(width)
  let count = List<u64>.length(&index.hashes)
  let hashes = List<u64>.asSlice(&index.hashes)
  let mut entry = usize.ZERO
  while entry < count {
    List<u32>.set(&mut index.successors, entry, u32.MAX)
    insertSlot(&mut controls, &mut slots, hashes, &mut index.successors, entry, hashes[entry])
    entry = entry + usize.ONE
  }
  drop hashes
  index.controls = move controls
  index.slots = move slots
  return ()
}

impl InternIndex {
  /// Folds a byte string's length and then its bytes in 8-byte words into `start`.
  ///
  /// # Details
  ///
  /// Equal byte strings fold to the same hash from the same start, and the length keeps adjacent
  /// strings folded in sequence from exchanging bytes. Byte-keyed tables, identity hashes, and
  /// fixed-width content digests share this fold.
  pub fn hashBytes(start: u64, bytes: &[u8]) -> u64 {
    let mut hashed = Hash.combine(start, usize.toU64(bytes.length))
    let mut at = usize.ZERO
    while at + 8 <= bytes.length {
      hashed = Hash.combine(hashed, fullWord(bytes, at))
      at = at + 8
    }
    if at < bytes.length {
      let mut tail: u64 = 0
      let mut shift: u64 = 0
      while at < bytes.length {
        tail = u64.bitOr(tail, u64.shiftLeft(u8.toU64(bytes[at]), shift))
        shift = shift + 8
        at = at + usize.ONE
      }
      hashed = Hash.combine(hashed, tail)
    }
    return hashed
  }

  /// Creates an index that has recorded no entry. It allocates nothing until the first record.
  pub fn make() -> InternIndex {
    return InternIndex {
      controls: List<u8>.make(),
      slots: List<u32>.make(),
      hashes: List<u64>.make(),
      successors: List<u32>.make(),
    }
  }

  /// Creates an index that records `entries` entries without growing.
  ///
  /// # Details
  ///
  /// The index holds the same entries in the same chains as one made by [`InternIndex.make`]; it
  /// only skips the rehashing that each doubling of the probe table costs.
  pub effect fn withCapacity(entries: usize) -> InternIndex ! OutOfMemoryError ? &mut Allocator {
    let mut width: usize = 16
    while width * 3 < entries * 4 { width = width + width }
    return InternIndex {
      controls: run emptyControls(width),
      slots: run emptySlots(width),
      hashes: run List<u64>.makeWithCapacity(entries),
      successors: run List<u32>.makeWithCapacity(entries),
    }
  }

  /// Returns the oldest entry recorded under `hash`, or `usize.MAX` when none is.
  pub fn first(self: &Self, hash: u64) -> usize {
    let width = List<u8>.length(&self.controls)
    if width == usize.ZERO {
      return usize.MAX
    }
    let controls = List<u8>.asSlice(&self.controls)
    let slots = List<u32>.asSlice(&self.slots)
    let hashes = List<u64>.asSlice(&self.hashes)
    let mask = width - usize.ONE
    let mixed = mixHash(hash)
    let tag = controlTag(mixed)
    let mut pos = homeSlot(mixed, mask)
    while true {
      let ctrl = controls[pos]
      if ctrl == 0 {
        return usize.MAX
      }
      if ctrl == tag {
        let head = u32.toUsize(slots[pos])
        if hashes[head] == hash {
          return head
        }
      }
      pos = usize.bitAnd(pos + usize.ONE, mask)
    }
    return usize.MAX
  }

  /// Returns the next newer entry recorded under the same hash as `entry`, or `usize.MAX`.
  pub fn after(self: &Self, entry: usize) -> usize {
    let next = List<u32>.get(&self.successors, entry)
    if next == u32.MAX {
      return usize.MAX
    }
    return u32.toUsize(next)
  }

  /// Records the table's next entry under `hash`; its ordinal is the number of earlier records.
  ///
  /// # Gotchas
  ///
  /// Record every table entry exactly once and in table order. Allocation failure publishes no
  /// entry, so retrying preserves the next ordinal.
  pub effect fn record(self: &mut Self, hash: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let entry = List<u64>.length(&self.hashes)

    // All allocations precede publication: a failed record must leave ordinal chains intact.
    if entry == List<u64>.capacity(&self.hashes) {
      run List<u64>.reserve(&mut self.hashes, usize.ONE)
    }
    if entry == List<u32>.capacity(&self.successors) {
      run List<u32>.reserve(&mut self.successors, usize.ONE)
    }
    let width = List<u8>.length(&self.controls)
    if width * 3 < (entry + usize.ONE) * 4 {
      let mut grown = width + width
      if grown == usize.ZERO {
        grown = 16
      }
      run rebuild(&mut self.*, grown)
    }
    run List<u64>.append(&mut self.hashes, hash)
    run List<u32>.append(&mut self.successors, u32.MAX)
    let hashes = List<u64>.asSlice(&self.hashes)
    insertSlot(&mut self.controls, &mut self.slots, hashes, &mut self.successors, entry, hash)
    return ()
  }
}
