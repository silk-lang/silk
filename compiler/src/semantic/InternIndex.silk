//! Hash-bucketed lookup for append-only tables interned under a structural equality.
//!
//! # When to use
//! Use [`InternIndex`] beside a `Vector` whose entries are interned under an equality that cannot
//! be a `HashKey` witness, such as an effectful comparison of shared types or of canonical
//! encodings. The caller hashes each value so that equal values always share a hash, compares only
//! the entries recorded under the probe's hash, and records each entry it appends.
//!
//! # Details
//! Entries recorded under one hash are presented oldest first, so a lookup finds the same equal
//! entry a full scan of the table finds first. Each bucket chains its entries in table order and
//! the bucket count doubles before it falls under four thirds of the entry count, so recording
//! and finding the first candidate take expected constant time. Only entries whose hashes collide
//! reach the caller's comparison.
//!
//! # Gotchas
//! The index cannot check the caller's hash. A hash that differs for two equal values lets the
//! table hold both, and a lookup then finds only the entry recorded under the probe's own hash.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.hash {Hash}
import silk.layout {Layout}
import silk.u8
import silk.u64
import silk.usize
import silk.vector {Vector}

/// The entries of one append-only table, bucketed by caller-computed hashes.
pub struct InternIndex {
  // Each bucket's oldest and newest entry plus one, or zero for an empty bucket.
  heads: Vector<usize>
  tails: Vector<usize>
  // For each recorded entry, its hash and the next newer entry in its bucket, or `usize.MAX`.
  hashes: Vector<u64>
  successors: Vector<usize>
}

// The bucket of one hash in a power-of-two table. The hash is mixed first, so callers may key
// entries by small ordinals.
fn bucketOf(hash: u64, width: usize) -> usize {
  return u64.toUsize(u64.bitAnd(Hash.mix(&Hash.seed(0), hash), usize.toU64(width - usize.ONE)))
}

// The first entry, from `entry` along its bucket chain, recorded under exactly `hash`.
fn withHash(index: &InternIndex, entry: usize, hash: u64) -> usize {
  let mut at = entry
  while at != usize.MAX && Vector<u64>.get(&index.hashes, at) != hash {
    at = Vector<usize>.get(&index.successors, at)
  }
  return at
}

// Appends one recorded entry to the tail of its bucket chain.
fn link(index: &mut InternIndex, entry: usize, width: usize) -> () {
  let bucket = bucketOf(Vector<u64>.get(&index.hashes, entry), width)
  let tail = Vector<usize>.get(&index.tails, bucket)
  if tail == usize.ZERO {
    Vector<usize>.set(&mut index.heads, bucket, entry + usize.ONE)
  } else {
    Vector<usize>.set(&mut index.successors, tail - usize.ONE, entry)
  }
  Vector<usize>.set(&mut index.tails, bucket, entry + usize.ONE)
  return ()
}

effect fn emptyBuckets(width: usize) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut buckets = Vector<usize>.make()
  run Vector<usize>.reserveExact(&mut buckets, width)
  let mut at = usize.ZERO
  while at < width {
    run Vector<usize>.append(&mut buckets, usize.ZERO)
    at = at + usize.ONE
  }
  return move buckets
}

// Relinks every recorded entry, in table order, into a table of `width` buckets.
effect fn rebuild(index: &mut InternIndex, width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let heads = run emptyBuckets(width)
  let tails = run emptyBuckets(width)
  index.heads = move heads
  index.tails = move tails
  let count = Vector<u64>.length(&index.hashes)
  let mut entry = usize.ZERO
  while entry < count {
    Vector<usize>.set(&mut index.successors, entry, usize.MAX)
    link(&mut index.*, entry, width)
    entry = entry + usize.ONE
  }
  return ()
}

impl InternIndex {
  /// Folds a byte string's length and then each byte into `start`.
  ///
  /// # Details
  ///
  /// Equal byte strings fold to the same hash from the same start, and the length keeps adjacent
  /// strings folded in sequence from exchanging bytes. Byte-keyed tables, identity hashes, and
  /// fixed-width content digests share this fold.
  pub fn hashBytes(start: u64, bytes: &[u8]) -> u64 {
    let mut hashed = Hash.combine(start, usize.toU64(bytes.length))
    let mut at = usize.ZERO
    while at < bytes.length {
      hashed = Hash.combine(hashed, u8.toU64(bytes[at]))
      at = at + usize.ONE
    }
    return hashed
  }
  /// Creates an index that has recorded no entry. It allocates nothing until the first record.
  pub fn make() -> InternIndex {
    return InternIndex {
      heads: Vector<usize>.make(),
      tails: Vector<usize>.make(),
      hashes: Vector<u64>.make(),
      successors: Vector<usize>.make(),
    }
  }
  /// Bytes reserved in the four index arrays, for a caller's retained-memory accounting.
  pub fn retainedBytes(self: &Self) -> usize {
    return Vector<usize>.capacity(&self.heads) * Layout.of<usize>().bytes
      + Vector<usize>.capacity(&self.tails) * Layout.of<usize>().bytes
      + Vector<u64>.capacity(&self.hashes) * Layout.of<u64>().bytes
      + Vector<usize>.capacity(&self.successors) * Layout.of<usize>().bytes
  }
  /// Returns the oldest entry recorded under `hash`, or `usize.MAX` when none is.
  pub fn first(self: &Self, hash: u64) -> usize {
    let width = Vector<usize>.length(&self.heads)
    if width == usize.ZERO {
      return usize.MAX
    }
    let head = Vector<usize>.get(&self.heads, bucketOf(hash, width))
    if head == usize.ZERO {
      return usize.MAX
    }
    return withHash(self, head - usize.ONE, hash)
  }
  /// Returns the next newer entry recorded under the same hash as `entry`, or `usize.MAX`.
  pub fn after(self: &Self, entry: usize) -> usize {
    return withHash(self, Vector<usize>.get(&self.successors, entry), Vector<u64>.get(&self.hashes, entry))
  }
  /// Records the table's next entry under `hash`; its ordinal is the number of earlier records.
  ///
  /// # Gotchas
  ///
  /// Record every table entry exactly once and in table order. Allocation failure publishes no
  /// entry, so retrying preserves the next ordinal.
  pub effect fn record(self: &mut Self, hash: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let entry = Vector<u64>.length(&self.hashes)

    // All allocations precede publication: a failed record must leave ordinal chains intact.
    if entry == Vector<u64>.capacity(&self.hashes) {
      run Vector<u64>.reserve(&mut self.hashes, usize.ONE)
    }
    if entry == Vector<usize>.capacity(&self.successors) {
      run Vector<usize>.reserve(&mut self.successors, usize.ONE)
    }
    let mut width = Vector<usize>.length(&self.heads)
    if width * 3 < (entry + usize.ONE) * 4 {
      let mut grown = width + width
      if grown == usize.ZERO {
        grown = 16
      }
      run rebuild(&mut self.*, grown)
      width = grown
    }
    run Vector<u64>.append(&mut self.hashes, hash)
    run Vector<usize>.append(&mut self.successors, usize.MAX)
    link(&mut self.*, entry, width)
    return ()
  }
}
