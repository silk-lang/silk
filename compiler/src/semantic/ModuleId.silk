//! Canonical identity for one logical source module.
//!
//! # When to use
//! Use [`ModuleId`] to identify a module across source revisions. Local HIR indexes and interned
//! symbols identify values only inside one parsed source unit.
//!
//! # Details
//! The origin, package, and path are exact bytes. A path uses slash-separated nonempty segments.
//! It has no leading or trailing slash, backslash, or `.` or `..` segment.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import semantic.InternIndex {InternIndex}
import silk.hash {Hash}
import silk.u8
import silk.usize

/// A module path that does not use the canonical logical form.
pub struct InvalidModulePath {}

/// A source origin, package, and normalized logical path.
pub struct ModuleId {
  origin: Bytes
  package: Bytes
  path: Bytes
  // The content hash of the three components, fixed at construction. Unequal hashes decide
  // inequality without reading the bytes.
  hashed: u64
}

fn contentHash(origin: &[u8], package: &[u8], path: &[u8]) -> u64 {
  let folded = InternIndex.hashBytes(InternIndex.hashBytes(Hash.mix(&Hash.seed(0), 0), origin), package)
  return InternIndex.hashBytes(folded, path)
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

// Lexicographic byte order: -1, 0, or 1 as `left` sorts before, equal to, or after `right`.
fn compareBytes(left: &[u8], right: &[u8]) -> i32 {
  let mut index = usize.ZERO
  while index < left.length && index < right.length {
    if left[index] != right[index] {
      if left[index] < right[index] {
        return -1
      }
      return 1
    }
    index = index + usize.ONE
  }
  if left.length == right.length {
    return 0
  }
  if left.length < right.length {
    return -1
  }
  return 1
}

fn validPath(path: &[u8]) -> bool {
  if path.length == usize.ZERO || path[usize.ZERO] == 47 || path[path.length - usize.ONE] == 47 {
    return false
  }
  let mut start = usize.ZERO
  let mut index = usize.ZERO
  while index <= path.length {
    if index == path.length || path[index] == 47 {
      let length = index - start
      if length == usize.ZERO || (length == usize.ONE && path[start] == 46) || (length == 2 && path[start] == 46 && path[start + usize.ONE] == 46) {
        return false
      }
      start = index + usize.ONE
    } else {
      if path[index] == 92 {
        return false
      }
    }
    index = index + usize.ONE
  }
  return true
}

impl ModuleId {
  /// Reassembles exact components read from an existing canonical module identity.
  pub effect fn fromParts(origin: Bytes, package: Bytes, path: Bytes) -> ModuleId ! InvalidModulePath {
    if Bytes.asSlice(&origin).length == usize.ZERO || Bytes.asSlice(&package).length == usize.ZERO || !validPath(Bytes.asSlice(&path)) {
      fail InvalidModulePath {}
    }
    let hashed = contentHash(Bytes.asSlice(&origin), Bytes.asSlice(&package), Bytes.asSlice(&path))
    return ModuleId {origin: move origin, package: move package, path: move path, hashed: hashed}
  }
  /// Copies a canonical module identity from its source origin, package, and logical path.
  ///
  /// # Gotchas
  ///
  /// An empty origin or package fails. A path with empty, `.` or `..` segments or a backslash fails.
  pub effect fn make(origin: &[u8], package: &[u8], path: &[u8]) -> ModuleId
  ! InvalidModulePath | OutOfMemoryError
  ? &mut Allocator {
    if origin.length == usize.ZERO || package.length == usize.ZERO || !validPath(path) {
      fail InvalidModulePath {}
    }
    return ModuleId {
      origin: run Bytes.copy(origin),
      package: run Bytes.copy(package),
      path: run Bytes.copy(path),
      hashed: contentHash(origin, package, path),
    }
  }
  /// Copies an identity without changing its origin, package, or path.
  pub effect fn copy(self: &Self) -> ModuleId ! OutOfMemoryError ? &mut Allocator {
    return ModuleId {
      origin: run Bytes.copy(Bytes.asSlice(&self.origin)),
      package: run Bytes.copy(Bytes.asSlice(&self.package)),
      path: run Bytes.copy(Bytes.asSlice(&self.path)),
      hashed: self.hashed,
    }
  }
  /// Reports whether two identities name the same module in the same source origin.
  pub fn equals(self: &Self, other: &ModuleId) -> bool {
    return self.hashed == other.hashed && sameBytes(Bytes.asSlice(&self.origin), Bytes.asSlice(&other.origin)) && sameBytes(
      Bytes.asSlice(&self.package),
      Bytes.asSlice(&other.package),
    ) && sameBytes(Bytes.asSlice(&self.path), Bytes.asSlice(&other.path))
  }
  /// Returns a hash that two identities share whenever [`equals`] reports them equal.
  ///
  /// # Details
  ///
  /// The hash is computed once from the origin, package, and path when the identity is built.
  pub fn hash(self: &Self) -> u64 {
    return self.hashed
  }
  /// Orders identities by origin, then package, then logical path bytes: -1, 0, or 1 as `self`
  /// sorts before, equal to, or after `other`. The order depends only on the identities.
  pub fn compare(self: &Self, other: &ModuleId) -> i32 {
    let origin = compareBytes(Bytes.asSlice(&self.origin), Bytes.asSlice(&other.origin))
    if origin != 0 {
      return origin
    }
    let package = compareBytes(Bytes.asSlice(&self.package), Bytes.asSlice(&other.package))
    if package != 0 {
      return package
    }
    return compareBytes(Bytes.asSlice(&self.path), Bytes.asSlice(&other.path))
  }
  /// Borrows the source-origin identity bytes for constructing a related module ID.
  pub fn sourceOrigin(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.origin)
  }
  /// Borrows the package identity bytes for constructing a related module ID.
  pub fn packageIdentity(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.package)
  }
  /// Borrows the normalized logical path bytes.
  pub fn logicalPath(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.path)
  }
}
