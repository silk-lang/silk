//! Slice 4 declaration-invalidation acceptance: exact provider starts and current projections.

import semantic.Semantic {Semantic, Request, Family, Answer, Event, EventKind, Outcome, Value}
import semantic.Types {Types, TypeTable}
import semantic.Anchor {Anchor}
import semantic.SourceLocations {LineMap}
import semantic.TypedBody {Origin}
import semantic.DeclarationId {DeclarationId}
import semantic.SemanticCaseSupport {
  module,
  present,
  starts,
  succeeded,
  selectedMirIndex,
  rejection,
  sameBytes,
}
import semantic.SourceRevision {Revision}
import semantic.SourceIndex {RevisionMismatch, NoRejection}
import semantic.Rejection {Rejection}
import lexer.Span {Span}
import backend.InstanceRecipe {InstanceRecipe}
import backend.InstanceKey {InstanceKey}
import backend.Mir {Local as MirLocal, MirFunction}
import silk.bytes {Bytes}
import silk.result {Result}
import silk.shared {Shared}
import silk.string {String}
import silk.vector {Vector}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.FinalProfile {FinalProfile}
import semantic.Target {Target, Id as TargetId}
import semantic.Query {Cycle}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.option {Option}
import silk.testing {Testing, AssertionError}
import silk.usize

effect fn demandAll(store: &mut Semantic, library: &ModuleId, entry: &ModuleId) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let leafBody = run Semantic.demandBody(&mut store.*, &mut request, library, b"leaf")
  let otherBody = run Semantic.demandBody(&mut store.*, &mut request, library, b"other")
  let aBody = run Semantic.demandBody(&mut store.*, &mut request, entry, b"a")
  let bBody = run Semantic.demandBody(&mut store.*, &mut request, entry, b"b")
  let cBody = run Semantic.demandBody(&mut store.*, &mut request, entry, b"c")
  let leafMir = run Semantic.demandMir(&mut store.*, &mut request, library, b"leaf")
  let otherMir = run Semantic.demandMir(&mut store.*, &mut request, library, b"other")
  let aMir = run Semantic.demandMir(&mut store.*, &mut request, entry, b"a")
  let bMir = run Semantic.demandMir(&mut store.*, &mut request, entry, b"b")
  let cMir = run Semantic.demandMir(&mut store.*, &mut request, entry, b"c")
  run Testing.expect(
    succeeded(&leafBody) && succeeded(&otherBody) && succeeded(&aBody) && succeeded(&bBody) && succeeded(
      &cBody,
    ),
    "every probe body checks successfully",
  )
  run Testing.expect(Semantic.requestDiscovered(&mut store.*, &request, library)
    && Semantic.requestDiscovered(&mut store.*, &request, entry),
    "a request retains both discovered modules")
  return ()
}

test effect fn siblingBodyEditProbe() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run siblingBodyEditClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn siblingBodyEditClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let library = run module("lib.silk")
  let entry = run module("main.silk")
  let librarySource = run present(
    "pub fn leaf() -> i32 { return 1 }\npub fn other() -> i32 { return 2 }\n",
  )
  let entrySource = run present(
    "import lib as Lib\nfn a() -> i32 { return Lib.leaf() }\nfn b() -> i32 { return 3 }\nfn c() -> i32 { return Lib.other() }\n",
  )
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let baseline = run Revision.publish(&first, &entry, &entrySource)
  let mut store = Semantic.traced(
    run Revision.copy(&baseline),
    Target.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  run demandAll(&mut store, &library, &entry)
  let bodies = starts(Semantic.eventLog(&store), Family.Body)
  let lowered = starts(Semantic.eventLog(&store), Family.Mir)
  let edited = run present(
    "pub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n",
  )
  run Semantic.update(&mut store, run Revision.publish(&baseline, &library, &edited))
  run demandAll(&mut store, &library, &entry)
  run Testing.expect(
    starts(Semantic.eventLog(&store), Family.Body) - bodies == 1,
    "a same-width runtime leaf edit starts only its own body",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&store), Family.Mir) - lowered == 1,
    "a same-width runtime leaf edit re-lowers only its own MIR",
  )
  let current = run Revision.publish(&baseline, &library, &edited)
  run compareAll(&mut store, &current, &library, &entry)
  let warmIr = run instanceIr(&mut store, &library, b"leaf")
  let mut freshIrStore = Semantic.traced(run Revision.copy(&current),
    Target.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let freshIr = run instanceIr(&mut freshIrStore, &library, b"leaf")
  run Testing.expect(sameBytes(Bytes.asSlice(&warmIr), Bytes.asSlice(&freshIr)),
    "warm and fresh edited leaf LLVM IR agree")
  let comments = run present(
    "pub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n// trailing comment\n",
  )
  let commented = run Revision.publish(&current, &library, &comments)
  let bodyStarts = starts(Semantic.eventLog(&store), Family.Body)
  let mirStarts = starts(Semantic.eventLog(&store), Family.Mir)
  run Semantic.update(&mut store, run Revision.copy(&commented))
  run demandAll(&mut store, &library, &entry)
  run Testing.expect(
    starts(Semantic.eventLog(&store), Family.Body) == bodyStarts && starts(
      Semantic.eventLog(&store),
      Family.Mir,
    ) == mirStarts,
    "trailing trivia starts no body or MIR providers",
  )
  run compareAll(&mut store, &commented, &library, &entry)
  let shifted = run present(
    "// moved declarations\npub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n",
  )
  let moved = run Revision.publish(&commented, &library, &shifted)
  let movedBodies = starts(Semantic.eventLog(&store), Family.Body)
  let movedMir = starts(Semantic.eventLog(&store), Family.Mir)
  run Semantic.update(&mut store, run Revision.copy(&moved))
  run demandAll(&mut store, &library, &entry)
  run Testing.expect(starts(Semantic.eventLog(&store), Family.Body) == movedBodies
    && starts(Semantic.eventLog(&store), Family.Mir) == movedMir,
    "moving declarations above a comment reuses their bodies and MIR")
  run compareAll(&mut store, &moved, &library, &entry)
  let leafKey = firstBodyKey(Semantic.eventLog(&store), usize.ZERO)
  let eventStart = Semantic.eventLog(&store).length
  let inserted = run present(
    "pub fn inserted() -> i32 { return 0 }\n// moved declarations\npub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n",
  )
  let insertion = run Revision.publish(&moved, &library, &inserted)
  run Semantic.update(&mut store, run Revision.copy(&insertion))
  run demandAll(&mut store, &library, &entry)
  run Testing.expect(
    firstBodyKey(Semantic.eventLog(&store), eventStart) == leafKey,
    "inserting a distinct declaration keeps the named leaf query key",
  )
  run compareAll(&mut store, &insertion, &library, &entry)
  return ()
}

effect fn compareMir(warm: &mut Semantic, fresh: &mut Semantic, module: &ModuleId, name: &[u8]) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let mut warmRequest = Request.make()
  let mut freshRequest = Request.make()
  let warmAnswer = run Semantic.demandMir(&mut warm.*, &mut warmRequest, module, name)
  let freshAnswer = run Semantic.demandMir(&mut fresh.*, &mut freshRequest, module, name)
  let warmIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
    &warmAnswer,
    selectedMirIndex,
  )
  let freshIndex = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(
    &freshAnswer,
    selectedMirIndex,
  )
  let left = match move warmIndex {
    Option<usize>.Some {value} => value
    _ => {
      run Testing.expect(false, "warm MIR exists")
      return ()
    }
  }
  let right = match move freshIndex {
    Option<usize>.Some {value} => value
    _ => {
      run Testing.expect(false, "fresh MIR exists")
      return ()
    }
  }
  let warmKey = match move Semantic.mirAt(&warm.*, left) {
    Option<&MirFunction>.Some {value} => InstanceKey.copy(&value.key)
    _ => {return run Testing.expect(false, "warm MIR is retained")}
  }
  let freshKey = match move Semantic.mirAt(&fresh.*, right) {
    Option<&MirFunction>.Some {value} => InstanceKey.copy(&value.key)
    _ => {return run Testing.expect(false, "fresh MIR is retained")}
  }
  let warmAnchor = match move run Semantic.mirAnchor(&mut warm.*, &warmKey) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {return run Testing.expect(false, "warm MIR has current anchor")}
  }
  let freshAnchor = match move run Semantic.mirAnchor(&mut fresh.*, &freshKey) {
    Option<Anchor>.Some {value} => move value
    Option<Anchor>.None => {return run Testing.expect(false, "fresh MIR has current anchor")}
  }
  let warmMir = match move Semantic.mirAt(&warm.*, left) {
    Option<&MirFunction>.Some {value} => value
    _ => {return run Testing.expect(false, "warm MIR is retained")}
  }
  let freshMir = match move Semantic.mirAt(&fresh.*, right) {
    Option<&MirFunction>.Some {value} => value
    _ => {return run Testing.expect(false, "fresh MIR is retained")}
  }
  let warmRecipe = run InstanceRecipe.make(warmMir)
  let freshRecipe = run InstanceRecipe.make(freshMir)
  run Testing.expect(
    sameBytes(Bytes.asSlice(&warmRecipe.shape), Bytes.asSlice(&freshRecipe.shape)) && warmMir.borrow == freshMir.borrow,
    "warm and fresh MIR instruction content and safety agree",
  )
  let warmCallees = Vector<InstanceKey>.asSlice(&warmRecipe.callees)
  let freshCallees = Vector<InstanceKey>.asSlice(&freshRecipe.callees)
  run Testing.expect(
    warmCallees.length == freshCallees.length,
    "warm and fresh MIR have the same runtime references",
  )
  let mut at = usize.ZERO
  while at < warmCallees.length {
    run Testing.expect(
      run InstanceKey.sameInstance(&warmCallees[at], &freshCallees[at]),
      "warm and fresh exact callees agree",
    )
    at = at + usize.ONE
  }
  let warmLocals = Vector<MirLocal>.asSlice(&warmMir.locals)
  let freshLocals = Vector<MirLocal>.asSlice(&freshMir.locals)
  run Testing.expect(warmLocals.length == freshLocals.length, "warm and fresh local counts agree")
  at = usize.ZERO
  while at < warmLocals.length {
    let projected = Origin.span(warmLocals[at].origin, &warmAnchor)
    let expected = Origin.span(freshLocals[at].origin, &freshAnchor)
    run Testing.expect(
      Origin.syntax(warmLocals[at].origin, &warmAnchor).index == Origin.syntax(freshLocals[at].origin, &freshAnchor).index
        && projected.start == expected.start && projected.end == expected.end,
      "warm MIR projects current syntax identities and source locations",
    )
    at = at + usize.ONE
  }
  return ()
}

effect fn compareAll(warm: &mut Semantic, revision: &Revision, library: &ModuleId, entry: &ModuleId) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let mut fresh = Semantic.traced(
    run Revision.copy(revision),
    Target.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  run compareMir(&mut warm.*, &mut fresh, library, b"leaf")
  run compareMir(&mut warm.*, &mut fresh, library, b"other")
  run compareMir(&mut warm.*, &mut fresh, entry, b"a")
  run compareMir(&mut warm.*, &mut fresh, entry, b"b")
  run compareMir(&mut warm.*, &mut fresh, entry, b"c")
  return ()
}

fn selectedLlvmIndex(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.LlvmText {index}} => index
      _ => usize.MAX
    }
    _ => usize.MAX
  }
}

effect fn instanceIr(store: &mut Semantic, module: &ModuleId, name: &[u8]) -> Bytes
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store.*, &mut request, module, name)
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&answer, selectedMirIndex)
  let ordinal = match move index {
    Option<usize>.Some {value} => value
    Option<usize>.None => {
      run Testing.expect(false, "IR input MIR exists")
      return Bytes.make()
    }
  }
  let key = match move Semantic.mirAt(&store.*, ordinal) {
    Option<&MirFunction>.Some {value} => InstanceKey.copy(&value.key)
    Option<&MirFunction>.None => {
      run Testing.expect(false, "IR input MIR is retained")
      return Bytes.make()
    }
  }
  let owner = DeclarationId.copyShared(&InstanceKey.identity(&key))
  let text = run Semantic.demandInstanceText(&mut store.*, &mut request, &key, &owner,
    Span.make(usize.ZERO, usize.ZERO), false)
  let slot = Shared<Result<Answer, NoRejection>>.with<usize>(&text, selectedLlvmIndex)
  let definitions = Semantic.instanceTexts(&store.*)
  run Testing.expect(slot < definitions.length, "LLVM text is emitted")
  return run Bytes.copy(Bytes.asSlice(&definitions[slot].text))
}

test effect fn negativeNameAndSignatureReadsFollowCurrentSources() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run negativeNameClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn negativeNameClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("main.silk")
  let library = run module("lib.silk")
  let entrySource = run present("import lib as Lib\nfn caller() -> i32 { return Lib.missing() }\n")
  let initial = run Revision.publish(&Revision.make(), &entry, &entrySource)
  let mut warm = Semantic.traced(
    run Revision.copy(&initial),
    Target.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  let mut request = Request.make()
  let absent = run Semantic.demandBody(&mut warm, &mut request, &entry, b"caller")
  run Testing.expect(!succeeded(&absent), "an absent imported module rejects the caller")
  let empty = run present("pub fn other() -> i32 { return 1 }\n")
  let emptyRevision = run Revision.publish(&initial, &library, &empty)
  run Semantic.update(&mut warm, run Revision.copy(&emptyRevision))
  let mut emptyRequest = Request.make()
  let missing = run Semantic.demandBody(&mut warm, &mut emptyRequest, &entry, b"caller")
  run Testing.expect(
    !succeeded(&missing) && Semantic.requestDiscovered(&mut warm, &emptyRequest, &library),
    "an empty name bucket is a negative read of a present module",
  )
  let added = run present(
    "pub fn other() -> i32 { return 1 }\npub fn missing() -> i32 { return 42 }\n",
  )
  let namedRevision = run Revision.publish(&emptyRevision, &library, &added)
  run Semantic.update(&mut warm, run Revision.copy(&namedRevision))
  let mut namedRequest = Request.make()
  let accepted = run Semantic.demandBody(&mut warm, &mut namedRequest, &entry, b"caller")
  run Testing.expect(
    succeeded(&accepted),
    "adding the missing binding invalidates the negative name read",
  )
  let mut fresh = Semantic.traced(
    run Revision.copy(&namedRevision),
    Target.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  run compareMir(&mut warm, &mut fresh, &entry, b"caller")
  let changed = run present(
    "pub fn other() -> i32 { return 1 }\npub fn missing() -> bool { return true }\n",
  )
  let signatureRevision = run Revision.publish(&namedRevision, &library, &changed)
  run Semantic.update(&mut warm, run Revision.copy(&signatureRevision))
  let mut signatureRequest = Request.make()
  let refused = run Semantic.demandBody(&mut warm, &mut signatureRequest, &entry, b"caller")
  let mut freshSignature = Semantic.traced(
    run Revision.copy(&signatureRevision),
    Target.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  let mut freshRequest = Request.make()
  let freshRefusal = run Semantic.demandBody(
    &mut freshSignature,
    &mut freshRequest,
    &entry,
    b"caller",
  )
  run Testing.expect(
    !succeeded(&refused) && !succeeded(&freshRefusal) && sameRefusal(&refused, &freshRefusal),
    "a callee signature change rejects the runtime caller in warm and fresh stores",
  )
  return ()
}

fn firstBodyKey(events: &[Event], start: usize) -> usize {
  let mut at = start
  while at < events.length {
    if events[at].family == Family.Body
      && (events[at].kind == EventKind.Start || events[at].kind == EventKind.Hit) {
      return events[at].key
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn sameDiagnostic(left: &Rejection, right: &Shared<Rejection>) -> bool {
  return Shared<Rejection>.with<bool>(
    right,
    fn(other: &Rejection) -> bool {
      return left.code == other.code && ModuleId.equals(&left.module, &other.module) && left.span.start == other.span.start && left.span.end == other.span.end
    },
  )
}

fn sameRefusal(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool {
  let leftDiagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    left,
    rejection,
  )
  let rightDiagnostic = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(
    right,
    rejection,
  )
  let first = match move leftDiagnostic {
    Option<Shared<Rejection>>.Some {value} => move value
    _ => {
      return false
    }
  }
  let second = match move rightDiagnostic {
    Option<Shared<Rejection>>.Some {value} => move value
    _ => {
      return false
    }
  }
  return Shared<Rejection>.with<bool>(
    &first,
    fn(value: &Rejection) -> bool {
      return sameDiagnostic(value, &second)
    },
  )
}

test effect fn unchangedByteOffsetsStillObserveChangedLineCoordinates() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  return run lineCoordinateClaims()
    |> Effect.provideMut<Types>(&mut types)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn lineCoordinateClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("main.silk")
  let initial = run present("/* x  */fn value() -> i32 { return 1 }\n")
  let first = run Revision.publish(&Revision.make(), &entry, &initial)
  let mut warm = Semantic.traced(
    run Revision.copy(&first),
    Target.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut warm, &mut request, &entry, b"value")
  let before = starts(Semantic.eventLog(&warm), Family.Body)
  let changed = run present("/*\n   */fn value() -> i32 { return 1 }\n")
  let revision = run Revision.publish(&first, &entry, &changed)
  run Semantic.update(&mut warm, run Revision.copy(&revision))
  let mut freshRequest = Request.make()
  let refreshed = run Semantic.demandBody(&mut warm, &mut freshRequest, &entry, b"value")
  run Testing.expect(
    succeeded(&checked) && succeeded(&refreshed) && starts(Semantic.eventLog(&warm), Family.Body) == before,
    "line/column changes keep the relative body when byte offsets stay equal",
  )
  let oldLines = run LineMap.make(String.utf8Bytes("/* x  */fn value() -> i32 { return 1 }\n"))
  let newLines = run LineMap.make(String.utf8Bytes("/*\n   */fn value() -> i32 { return 1 }\n"))
  run Testing.expect(!LineMap.sameAt(&oldLines, &newLines, 8),
    "current line and column differ at the unchanged function byte offset")
  let mut fresh = Semantic.traced(
    run Revision.copy(&revision),
    Target.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  run compareMir(&mut warm, &mut fresh, &entry, b"value")
  return ()
}
