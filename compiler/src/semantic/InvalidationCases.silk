//! Structural revision probes for declaration cache validity and dependency cutoff.

import semantic.Semantic {Semantic, Request, Family, Answer, Event, EventKind}
import semantic.SemanticCaseSupport {module, present, starts, succeeded, selectedMirIndex, rejection}
import semantic.SourceRevision {Revision}
import semantic.SourceIndex {RevisionMismatch, NoRejection}
import semantic.SourceRead
import semantic.Rejection {Rejection}
import backend.InstanceRecipe {InstanceRecipe}
import backend.InstanceKey {InstanceKey}
import backend.Mir {Local as MirLocal, MirFunction}
import silk.bytes {Bytes}
import silk.result {Result}
import silk.shared {Shared}
import silk.vector {Vector}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.FinalProfile {FinalProfile}
import semantic.Target {Target, Id as TargetId}
import semantic.Query {Cycle}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.option {Option}
import silk.testing {Testing, AssertionError}
import silk.usize

effect fn demandAll(store: &mut Semantic, library: &ModuleId, entry: &ModuleId) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let mut request = Request.make()
  let leafBody = run Semantic.demandBody(&mut store.*, &mut request, library, b"leaf")
  let otherBody = run Semantic.demandBody(&mut store.*, &mut request, library, b"other")
  let aBody = run Semantic.demandBody(&mut store.*, &mut request, entry, b"a")
  let bBody = run Semantic.demandBody(&mut store.*, &mut request, entry, b"b")
  let cBody = run Semantic.demandBody(&mut store.*, &mut request, entry, b"c")
  let leafMir = run Semantic.demandMir(&mut store.*, &mut request, library, b"leaf")
  let otherMir = run Semantic.demandMir(&mut store.*, &mut request, library, b"other")
  let aMir = run Semantic.demandMir(&mut store.*, &mut request, entry, b"a")
  let bMir = run Semantic.demandMir(&mut store.*, &mut request, entry, b"b")
  let cMir = run Semantic.demandMir(&mut store.*, &mut request, entry, b"c")
  run Testing.expect(succeeded(&leafBody) && succeeded(&otherBody) && succeeded(&aBody) && succeeded(&bBody) && succeeded(&cBody),
    "every probe body checks successfully")
  run Testing.expect(Request.hasDiscovered(&request, library) && Request.hasDiscovered(&request, entry),
    "a request retains both discovered modules")
  return ()
}

test effect fn siblingBodyEditProbe() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run siblingBodyEditClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn siblingBodyEditClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let library = run module("lib.silk")
  let entry = run module("main.silk")
  let librarySource = run present("pub fn leaf() -> i32 { return 1 }\npub fn other() -> i32 { return 2 }\n")
  let entrySource = run present("import lib as Lib\nfn a() -> i32 { return Lib.leaf() }\nfn b() -> i32 { return 3 }\nfn c() -> i32 { return Lib.other() }\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let baseline = run Revision.publish(&first, &entry, &entrySource)
  let mut store = Semantic.traced(run Revision.copy(&baseline), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  run demandAll(&mut store, &library, &entry)
  let bodies = starts(Semantic.eventLog(&store), Family.Body)
  let lowered = starts(Semantic.eventLog(&store), Family.Mir)
  let edited = run present("pub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n")
  Semantic.revise(&mut store, run Revision.publish(&baseline, &library, &edited))
  run demandAll(&mut store, &library, &entry)
  run Testing.expect(starts(Semantic.eventLog(&store), Family.Body) - bodies == 1,
    "a same-width runtime leaf edit starts only its own body")
  run Testing.expect(starts(Semantic.eventLog(&store), Family.Mir) - lowered == 1,
    "a same-width runtime leaf edit re-lowers only its own MIR")
  let current = run Revision.publish(&baseline, &library, &edited)
  run compareAll(&mut store, &current, &library, &entry)
  let comments = run present("pub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n// trailing comment\n")
  let commented = run Revision.publish(&current, &library, &comments)
  let bodyStarts = starts(Semantic.eventLog(&store), Family.Body)
  let mirStarts = starts(Semantic.eventLog(&store), Family.Mir)
  Semantic.revise(&mut store, run Revision.copy(&commented))
  run demandAll(&mut store, &library, &entry)
  run Testing.expect(starts(Semantic.eventLog(&store), Family.Body) == bodyStarts && starts(Semantic.eventLog(&store), Family.Mir) == mirStarts,
    "trailing trivia starts no body or MIR providers")
  run compareAll(&mut store, &commented, &library, &entry)
  let shifted = run present("// moved declarations\npub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n")
  let moved = run Revision.publish(&commented, &library, &shifted)
  Semantic.revise(&mut store, run Revision.copy(&moved))
  run demandAll(&mut store, &library, &entry)
  run compareAll(&mut store, &moved, &library, &entry)
  let leafKey = firstBodyKey(Semantic.eventLog(&store), usize.ZERO)
  let eventStart = Semantic.eventLog(&store).length
  let inserted = run present("pub fn inserted() -> i32 { return 0 }\n// moved declarations\npub fn leaf() -> i32 { return 9 }\npub fn other() -> i32 { return 2 }\n")
  let insertion = run Revision.publish(&moved, &library, &inserted)
  Semantic.revise(&mut store, run Revision.copy(&insertion))
  run demandAll(&mut store, &library, &entry)
  run Testing.expect(firstBodyKey(Semantic.eventLog(&store), eventStart) == leafKey,
    "inserting a distinct declaration keeps the named leaf query key")
  run compareAll(&mut store, &insertion, &library, &entry)
  return ()
}

effect fn compareMir(warm: &mut Semantic, fresh: &mut Semantic, module: &ModuleId, name: &[u8]) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let mut warmRequest = Request.make()
  let mut freshRequest = Request.make()
  let warmAnswer = run Semantic.demandMir(&mut warm.*, &mut warmRequest, module, name)
  let freshAnswer = run Semantic.demandMir(&mut fresh.*, &mut freshRequest, module, name)
  let warmIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&warmAnswer, selectedMirIndex)
  let freshIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&freshAnswer, selectedMirIndex)
  let left = match move warmIndex { Option<usize>.Some {value} => value _ => { run Testing.expect(false, "warm MIR exists")
      return () } }
  let right = match move freshIndex { Option<usize>.Some {value} => value _ => { run Testing.expect(false, "fresh MIR exists")
      return () } }
  let warmMir = match move Semantic.mirAt(&warm.*, left) { Option<&MirFunction>.Some {value} => value _ => { return () } }
  let freshMir = match move Semantic.mirAt(&fresh.*, right) { Option<&MirFunction>.Some {value} => value _ => { return () } }
  let warmRecipe = run InstanceRecipe.make(warmMir)
  let freshRecipe = run InstanceRecipe.make(freshMir)
  run Testing.expect(SourceRead.sameDigest(Bytes.asSlice(&warmRecipe.shape), Bytes.asSlice(&freshRecipe.shape))
    && warmMir.safetyChecked == freshMir.safetyChecked, "warm and fresh MIR instruction content and safety agree")
  let warmCallees = Vector.asSlice<InstanceKey>(&warmRecipe.callees)
  let freshCallees = Vector.asSlice<InstanceKey>(&freshRecipe.callees)
  run Testing.expect(warmCallees.length == freshCallees.length, "warm and fresh MIR have the same runtime references")
  let mut at = usize.ZERO
  while at < warmCallees.length {
    run Testing.expect(run InstanceKey.sameInstance(&warmCallees[at], &freshCallees[at], true), "warm and fresh exact callees agree")
    at = at + usize.ONE
  }
  let warmLocals = Vector.asSlice<MirLocal>(&warmMir.locals)
  let freshLocals = Vector.asSlice<MirLocal>(&freshMir.locals)
  run Testing.expect(warmLocals.length == freshLocals.length, "warm and fresh local counts agree")
  at = usize.ZERO
  while at < warmLocals.length {
    run Testing.expect(warmLocals[at].origin.syntax.index == freshLocals[at].origin.syntax.index
      && warmLocals[at].origin.span.start == freshLocals[at].origin.span.start
      && warmLocals[at].origin.span.end == freshLocals[at].origin.span.end, "warm MIR carries current syntax identities and source locations")
    at = at + usize.ONE
  }
  return ()
}

effect fn compareAll(warm: &mut Semantic, revision: &Revision, library: &ModuleId, entry: &ModuleId) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let mut fresh = Semantic.traced(run Revision.copy(revision), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  run compareMir(&mut warm.*, &mut fresh, library, b"leaf")
  run compareMir(&mut warm.*, &mut fresh, library, b"other")
  run compareMir(&mut warm.*, &mut fresh, entry, b"a")
  run compareMir(&mut warm.*, &mut fresh, entry, b"b")
  run compareMir(&mut warm.*, &mut fresh, entry, b"c")
  return ()
}

test effect fn negativeNameAndSignatureReadsFollowCurrentSources() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run negativeNameClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn negativeNameClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let entry = run module("main.silk")
  let library = run module("lib.silk")
  let entrySource = run present("import lib as Lib\nfn caller() -> i32 { return Lib.missing() }\n")
  let initial = run Revision.publish(&Revision.make(), &entry, &entrySource)
  let mut warm = Semantic.traced(run Revision.copy(&initial), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let absent = run Semantic.demandBody(&mut warm, &mut request, &entry, b"caller")
  run Testing.expect(!succeeded(&absent), "an absent imported module rejects the caller")
  let empty = run present("pub fn other() -> i32 { return 1 }\n")
  let emptyRevision = run Revision.publish(&initial, &library, &empty)
  Semantic.revise(&mut warm, run Revision.copy(&emptyRevision))
  let mut emptyRequest = Request.make()
  let missing = run Semantic.demandBody(&mut warm, &mut emptyRequest, &entry, b"caller")
  run Testing.expect(!succeeded(&missing) && Request.hasDiscovered(&emptyRequest, &library), "an empty name bucket is a negative read of a present module")
  let added = run present("pub fn other() -> i32 { return 1 }\npub fn missing() -> i32 { return 42 }\n")
  let namedRevision = run Revision.publish(&emptyRevision, &library, &added)
  Semantic.revise(&mut warm, run Revision.copy(&namedRevision))
  let mut namedRequest = Request.make()
  let accepted = run Semantic.demandBody(&mut warm, &mut namedRequest, &entry, b"caller")
  run Testing.expect(succeeded(&accepted), "adding the missing binding invalidates the negative name read")
  let mut fresh = Semantic.traced(run Revision.copy(&namedRevision), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  run compareMir(&mut warm, &mut fresh, &entry, b"caller")
  let changed = run present("pub fn other() -> i32 { return 1 }\npub fn missing() -> bool { return true }\n")
  let signatureRevision = run Revision.publish(&namedRevision, &library, &changed)
  Semantic.revise(&mut warm, run Revision.copy(&signatureRevision))
  let mut signatureRequest = Request.make()
  let refused = run Semantic.demandBody(&mut warm, &mut signatureRequest, &entry, b"caller")
  let mut freshSignature = Semantic.traced(run Revision.copy(&signatureRevision), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut freshRequest = Request.make()
  let freshRefusal = run Semantic.demandBody(&mut freshSignature, &mut freshRequest, &entry, b"caller")
  run Testing.expect(!succeeded(&refused) && !succeeded(&freshRefusal) && sameRefusal(&refused, &freshRefusal), "a callee signature change rejects the runtime caller in warm and fresh stores")
  return ()
}

fn firstBodyKey(events: &[Event], start: usize) -> usize {
  let mut at = start
  while at < events.length {
    if events[at].family == Family.Body && events[at].kind == EventKind.Start { return events[at].key }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn sameDiagnostic(left: &Rejection, right: &Shared<Rejection>) -> bool {
  return Shared.with<Rejection, bool>(right, fn(other: &Rejection) -> bool {
    return left.code == other.code && ModuleId.equals(&left.module, &other.module)
      && left.span.start == other.span.start && left.span.end == other.span.end
  })
}

fn sameRefusal(left: &Shared<Result<Answer, NoRejection>>, right: &Shared<Result<Answer, NoRejection>>) -> bool {
  let leftDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(left, rejection)
  let rightDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(right, rejection)
  let first = match move leftDiagnostic { Option<Shared<Rejection>>.Some {value} => move value _ => { return false } }
  let second = match move rightDiagnostic { Option<Shared<Rejection>>.Some {value} => move value _ => { return false } }
  return Shared.with<Rejection, bool>(&first, fn(value: &Rejection) -> bool { return sameDiagnostic(value, &second) })
}

test effect fn unchangedByteOffsetsStillObserveChangedLineCoordinates() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lineCoordinateClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn lineCoordinateClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let entry = run module("main.silk")
  let initial = run present("/* x  */fn value() -> i32 { return 1 }\n")
  let first = run Revision.publish(&Revision.make(), &entry, &initial)
  let mut warm = Semantic.traced(run Revision.copy(&first), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut warm, &mut request, &entry, b"value")
  let before = starts(Semantic.eventLog(&warm), Family.Body)
  let changed = run present("/*\n   */fn value() -> i32 { return 1 }\n")
  let revision = run Revision.publish(&first, &entry, &changed)
  Semantic.revise(&mut warm, run Revision.copy(&revision))
  let mut freshRequest = Request.make()
  let refreshed = run Semantic.demandBody(&mut warm, &mut freshRequest, &entry, b"value")
  run Testing.expect(succeeded(&checked) && succeeded(&refreshed) && starts(Semantic.eventLog(&warm), Family.Body) == before + usize.ONE,
    "line/column changes invalidate location-bearing facts even when byte offsets stay equal")
  let mut fresh = Semantic.traced(run Revision.copy(&revision), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  run compareMir(&mut warm, &mut fresh, &entry, b"value")
  return ()
}
