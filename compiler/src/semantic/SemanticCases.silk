test effect fn staticArithmeticReportsOperationCodeAndSpan() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-arithmetic.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn add(value: u32) -> u32 { return value + 1 }\nstatic fn divide(value: u32) -> u32 { return value / 0 }\n"
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 512})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let max = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 4294967295})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let one = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let overflow = run Effect.result(StaticExecution.demand(&mut machine, b"add", &[move max], Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionSourceFault(&overflow, StaticExecutionFault.Overflow, b"SEM0176", offsetOf(source, "+", usize.ZERO)), "overflow names the authored operator and static diagnostic code")
  let division = run Effect.result(StaticExecution.demand(&mut machine, b"divide", &[move one], Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionSourceFault(&division, StaticExecutionFault.DivisionByZero, b"SEM0176", offsetOf(source, "/", usize.ZERO)), "division by zero names the authored operator and static diagnostic code")
  return ()
}

test effect fn staticCallsDistinguishCyclesLimitsAndCheckedFailures() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-failures.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn cycle(value: u32) -> u32 { return cycle(value) }
static fn descend(value: u32) -> u32 { return descend(value + 1) }
static fn spin(value: u32) -> u32 { while true {} return value }
static fn badField(boxed: Box) -> u32 { let mut result = boxed result.value = 1 return 0 }
fn runtime(value: u32) -> u32 { return value }
static fn badCall(value: u32) -> u32 { return runtime(value) }
static fn skipped(value: u32) -> bool { return false && broken(value) }
static fn broken(value: u32) -> bool { return missing }
static fn reported(value: u32) -> u32 { compileError("invalid static value") }
static fn terminal(value: u32) -> never { compileError("terminal failure") }
static fn forwarded(value: u32) -> u32 { terminal(value) }
struct Box { value: u32 }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 100, depth: 2, valueBytes: 1024})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let span = Span.make(usize.ZERO, usize.ZERO)
  let cycle = run Effect.result(StaticExecution.demand(&mut machine, b"cycle", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&cycle, StaticExecutionFault.Cycle) && staticExecutionTraceHas(&cycle, usize.ONE), "equal active call reports its ordered trace")
  let depth = run Effect.result(StaticExecution.demand(&mut machine, b"descend", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&depth, StaticExecutionFault.DepthLimit) && staticExecutionTraceHas(&depth, 2), "distinct recursive calls exhaust depth")
  let skipped = run StaticExecution.demand(&mut machine, b"skipped", &args, span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&skipped, fn(value: &StaticData) -> bool {
    return match &value.* {
      StaticData.Boolean {value: chosen} => !chosen
      _ => false
    }
  }), "short circuit leaves the invalid function uncalled")
  let sameCycle = run Effect.result(StaticExecution.demand(&mut machine, b"cycle", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&sameCycle, StaticExecutionFault.Cycle), "typed failure leaves the call retryable")
  let steps = run Effect.result(StaticExecution.demand(&mut machine, b"spin", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&steps, StaticExecutionFault.StepLimit), "loop exhausts the step budget")
  let invalid = run Effect.result(StaticExecution.demand(&mut machine, b"badField", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&invalid, RejectionCode.StaticPhaseViolation, offsetOf(source, "result.value", usize.ZERO)),
    "evaluator preserves the checked body's field-mutation rejection and source span",
  )
  drop machine
  let mut reportedMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut staticDependencies),
    &id,
    StaticExecution.Limits {steps: 16, depth: 2, valueBytes: 1024},
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let reported = run Effect.result(StaticExecution.demand(&mut reportedMachine, b"reported", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(
      &reported,
      StaticExecutionFault.CompileError,
      b"SEM0177",
      offsetOf(source, "compileError", usize.ZERO),
      String.utf8Bytes("compileError(\"invalid static value\")").length,
    ),
    "checked compileError reports its selected source diagnostic",
  )
  drop reportedMachine
  let mut forwardedMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut staticDependencies),
    &id,
    StaticExecution.Limits {steps: 16, depth: 3, valueBytes: 1024},
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Effect.result(StaticExecution.demand(&mut forwardedMachine, b"forwarded", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(
      &forwarded,
      StaticExecutionFault.CompileError,
      b"SEM0177",
      offsetOf(source, "compileError(\"terminal failure\")", usize.ZERO),
      String.utf8Bytes("compileError(\"terminal failure\")").length,
    ),
    "a checked never-returning call terminates its enclosing static body",
  )
  drop forwardedMachine
  let mut request = Request.make()
  let runtime = run Semantic.demandBody(&mut semantic, &mut request, &id, b"badCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&runtime, RejectionCode.StaticPhaseViolation, offsetOf(source, "runtime(value)", usize.ZERO)),
    "a runtime call in a static body rejects at its authored call before evaluation",
  )
  return ()
}

fn staticBodyExpressionAt(answer: &Result<Answer, NoRejection>, start: usize) -> HirId {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body, ..}} => Shared.with<TypedBody, HirId>(
        &body,
        fn(checked: &TypedBody) -> HirId {
          let nodes = TypedBody.nodeSlice(checked)
          let mut at = usize.ZERO
          while at < nodes.length {
            if nodes[at].origin.span.start == start {
              if let BodyNodeKind.Expression {..} = &nodes[at].kind { return nodes[at].origin.syntax }
            }
            at = at + usize.ONE
          }
          return HirId {index: usize.MAX}
        },
      )
      _ => HirId {index: usize.MAX}
    }
    _ => HirId {index: usize.MAX}
  }
}

test effect fn staticRetainedValueLimitRejectsPublication() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-value-limit.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
static fn identity(value: u32) -> u32 { return value }
static fn texts() -> u32 {
  let mut at: u32 = 0
  while at < 3 {
    let text = "abcdefghijklmnopqrstuvwx"
    at = at + 1
  }
  return 7
}
static fn returned() -> string<'static> { return "abcdefghijklmnopqrstuvwx" }
static fn alias() -> string<'static> { return returned() }
static fn resumed(supplied: string<'static>) -> string<'static> { return supplied }
static fn wide() -> [u32; 8] { return [1, 2, 3, 4, 5, 6, 7, 8] }
"""
  let textLiteral = "\"abcdefghijklmnopqrstuvwx\""
  let literalStart = offsetOf(source, textLiteral, usize.ONE)
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 20, depth: 4, valueBytes: 32})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let first = run StaticExecution.demand(&mut machine, b"identity", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run StaticExecution.demand(&mut machine, b"identity", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&first, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }) && Shared.with<StaticData, bool>(&repeated, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }), "equal static arguments reuse a completed result")
  let two = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 2})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = [move two]
  let attempted = run Effect.result(StaticExecution.demand(&mut machine, b"identity", &different, Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&attempted, StaticExecutionFault.ValueLimit), "distinct result exceeds retained value budget")
  drop machine
  let mut arrayDependencies = Vector.make<Dependency>()
  let mut arrayMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut arrayDependencies), &id, StaticExecution.Limits {steps: 64, depth: 4, valueBytes: 48})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noArrayArguments = Vector.make<Shared<StaticData>>()
  let wide = run Effect.result(StaticExecution.demand(&mut arrayMachine, b"wide", Vector.asSlice<Shared<StaticData>>(&noArrayArguments), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&wide, StaticExecutionFault.ValueLimit), "constructing a static array is charged to the retained value budget")
  drop arrayMachine
  let mut textDependencies = Vector.make<Dependency>()
  let mut textMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut textDependencies), &id, StaticExecution.Limits {steps: 128, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noArguments = Vector.make<Shared<StaticData>>()
  let repeatedText = run Effect.result(StaticExecution.demand(&mut textMachine, b"texts", Vector.asSlice<Shared<StaticData>>(&noArguments), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&repeatedText, StaticExecutionFault.ValueLimit), "retained text provenance exhausts the cumulative value budget without publishing a value")
  drop textMachine
  let mut returnedDependencies = Vector.make<Dependency>()
  let mut returnedMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut returnedDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let returned = run StaticExecution.demand(&mut returnedMachine, b"alias", Vector.asSlice<Shared<StaticData>>(&noArguments), Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let origin = StaticExecution.textOrigin(&returnedMachine, &returned)
  let returnedOriginMatches = match move origin {
    Option<Span>.Some {value: returnedOrigin} => returnedOrigin.start == literalStart
    Option<Span>.None => false
  }
  run Testing.expect(returnedOriginMatches, "returned text aliases preserve the authored origin without a second budget charge")
  drop returnedMachine
  let mut rootRequest = Request.make()
  let literalBody = run Semantic.demandBody(&mut semantic, &mut rootRequest, &id, b"returned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resumedBody = run Semantic.demandBody(&mut semantic, &mut rootRequest, &id, b"resumed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let literalId = Shared.with<Result<Answer, NoRejection>, HirId>(&literalBody, fn(answer: &Result<Answer, NoRejection>) -> HirId {
    return staticBodyExpressionAt(answer, literalStart)
  })
  let resumedId = Shared.with<Result<Answer, NoRejection>, HirId>(&resumedBody, fn(answer: &Result<Answer, NoRejection>) -> HirId {
    return staticBodyExpressionAt(answer, offsetOf(source, "supplied }", usize.ZERO))
  })
  let checkedLiteralRoot = Shared.with<Result<Answer, NoRejection>, Option<StaticExecution.CheckedRoot>>(
    &literalBody, StaticExecution.checkedRoot,
  )
  let literalRoot = match move checkedLiteralRoot {
    Option<StaticExecution.CheckedRoot>.Some {value: checkedLiteral} => move checkedLiteral
    Option<StaticExecution.CheckedRoot>.None => {
      run Testing.expect(false, "the text literal has a checked root")
      return ()
    }
  }
  let checkedResumedRoot = Shared.with<Result<Answer, NoRejection>, Option<StaticExecution.CheckedRoot>>(
    &resumedBody, StaticExecution.checkedRoot,
  )
  let resumedRoot = match move checkedResumedRoot {
    Option<StaticExecution.CheckedRoot>.Some {value: checkedResumed} => move checkedResumed
    Option<StaticExecution.CheckedRoot>.None => {
      run Testing.expect(false, "the supplied text reference has a checked root")
      return ()
    }
  }
  let mut rootDependencies = Vector.make<Dependency>()
  let mut rootMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut rootDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noBindings = Vector.make<StaticExecution.Binding>()
  let literalValue = run StaticExecution.evaluate(&mut rootMachine, &literalRoot, Vector.asSlice<StaticExecution.Binding>(&noBindings), literalId)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let suppliedModule = run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator)
  let supplied = [StaticExecution.Binding {
    module: move suppliedModule,
    binder: resumedId,
    value: StaticValue.copy(&literalValue),
  }]
  let resumedValue = run StaticExecution.evaluate(&mut rootMachine, &resumedRoot, &supplied, resumedId)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resumedOriginValue = StaticExecution.textOrigin(&rootMachine, &resumedValue)
  let resumedOriginMatches = match move resumedOriginValue {
    Option<Span>.Some {value: resumedOrigin} => resumedOrigin.start == literalStart
    Option<Span>.None => false
  }
  run Testing.expect(resumedOriginMatches, "literal roots and supplied aliases publish with one retained provenance charge")
  let exhausted = run Effect.result(StaticExecution.evaluate(&mut rootMachine, &literalRoot, Vector.asSlice<StaticExecution.Binding>(&noBindings), literalId))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&exhausted, StaticExecutionFault.ValueLimit), "releasing an origin-held supplied alias preserves the live charge for later roots")
  return ()
}

test effect fn staticCallCacheIncludesCheckedGenericApplication() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-generic-key.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn phantom<T>(value: u32) -> u32 { return value }\n"
  let bytes = run Bytes.copy(String.utf8Bytes(source))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move bytes) |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run ModuleIndex.build(&unit) |> Effect.provideMut<Allocator>(&mut allocator)
  let declarations = ModuleIndex.listDeclarations(&index)
  let header = run StaticFunction.select(&unit, &index, &declarations[usize.ZERO].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = match move header {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => value
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error: _} => {
      run Testing.expect(false, "generic static function has a selectable header")
      return ()
    }
  }
  let integer = run specializationPrimitive(b"u32") |> Effect.provideMut<Allocator>(&mut allocator)
  let boolean = run specializationPrimitive(b"bool") |> Effect.provideMut<Allocator>(&mut allocator)
  let firstApplication = run specializationOf(&selected.declaration, &integer)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let otherApplication = run specializationOf(&selected.declaration, &boolean)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 20, depth: 4, valueBytes: 32})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let span = Span.make(usize.ZERO, usize.ZERO)
  let first = run StaticExecution.demandApplication(&mut machine, &firstApplication, b"phantom", &args, span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run StaticExecution.demandApplication(&mut machine, &firstApplication, b"phantom", &args, span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&first, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }) && Shared.with<StaticData, bool>(&repeated, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }), "equal checked applications reuse one static result")
  let other = run Effect.result(StaticExecution.demandApplication(&mut machine, &otherApplication, b"phantom", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&other, StaticExecutionFault.ValueLimit), "different generic arguments have separate cache entries")
  let operation = run DeclarationId.copy(&selected.declaration) |> Effect.provideMut<Allocator>(&mut allocator)
  let implementation = run DeclarationId.copy(&selected.declaration) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedOperation = SpecializationApplication {
    target: SpecializationTarget.Operation {
      contract: Shared.clone<Type>(&integer),
      provider: Shared.clone<Type>(&boolean),
      operation: move operation,
      implementation: move implementation,
    },
    argumentOrdinals: Vector.make<usize>(),
    scopes: Vector.make<ScopeBinding>(),
    arguments: Vector.make<Argument>(),
    statics: Vector.make<StaticSlot>(),
  }
  let operationSpan = Span.make(usize.ONE, usize.ONE + usize.ONE)
  let rejectedOperation = run Effect.result(StaticExecution.demandApplication(&mut machine, &selectedOperation, b"phantom", &args, operationSpan))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(&rejectedOperation, StaticExecutionFault.StaticPhaseViolation, b"SEM0176", usize.ONE, usize.ONE),
    "interface operations cannot be called during static evaluation",
  )
  return ()
}

test effect fn staticUnsuffixedPointerLiteralsUseSelectedTarget() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-pointer-literals.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn wideUnsigned() -> usize { return 4294967296 }
static fn wideSigned() -> isize { return 2147483648 }
static fn echo(value: usize) -> usize { return value }
static fn callEcho() -> usize { return echo(4294967296) }
static fn sumWord() -> usize { return 1 + 2 }
static fn callSum() -> usize { return echo(1 + 2) }
static fn nested() -> usize { return (1 + 2) + (3 + 4) }
"""
  let mut nativeSemantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasmSemantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Wasm32UnknownUnknown))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nativeDependencies = Vector.make<Dependency>()
  let mut wasmDependencies = Vector.make<Dependency>()
  let mut native = run StaticExecution.make(Semantic.staticPort(&mut nativeSemantic, &mut nativeDependencies), &id, StaticExecution.Limits {steps: 64, depth: 3, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = run StaticExecution.make(Semantic.staticPort(&mut wasmSemantic, &mut wasmDependencies), &id, StaticExecution.Limits {steps: 64, depth: 3, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = Vector.make<Shared<StaticData>>()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let unsigned = run StaticExecution.demand(&mut native, b"wideUnsigned", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let signed = run StaticExecution.demand(&mut native, b"wideSigned", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run StaticExecution.demand(&mut native, b"callEcho", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let summed = run StaticExecution.demand(&mut native, b"sumWord", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedSum = run StaticExecution.demand(&mut native, b"callSum", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&unsigned, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 4294967296
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&signed, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Isize && magnitude == 2147483648
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&forwarded, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 4294967296
      _ => false
    }
  }), "unsuffixed return and call-argument literals use the declared pointer-sized type on a 64-bit target")
  run Testing.expect(Shared.with<StaticData, bool>(&summed, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&forwardedSum, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }), "arithmetic operands inherit the return or parameter integer type")
  let unsigned32 = run Effect.result(StaticExecution.demand(&mut wasm, b"wideUnsigned", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let signed32 = run Effect.result(StaticExecution.demand(&mut wasm, b"wideSigned", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded32 = run Effect.result(StaticExecution.demand(&mut wasm, b"callEcho", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&unsigned32, RejectionCode.IntegerOutOfRange, offsetOf(source, "4294967296", usize.ZERO)) &&
    staticExecutionBodyRejection(&signed32, RejectionCode.IntegerOutOfRange, offsetOf(source, "2147483648", usize.ZERO)) &&
    staticExecutionBodyRejection(&forwarded32, RejectionCode.IntegerOutOfRange, offsetOf(source, "4294967296", 1)),
    "the checked bodies reject values outside the wasm32 pointer-sized ranges",
  )
  let sum32 = run StaticExecution.demand(&mut wasm, b"sumWord", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedSum32 = run StaticExecution.demand(&mut wasm, b"callSum", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&sum32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&forwardedSum32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }), "arithmetic uses usize on wasm32 as well as native64")
  let nested32 = run StaticExecution.demand(&mut wasm, b"nested", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&nested32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 10
      _ => false
    }
  }), "nested arithmetic operands inherit the pointer-sized return type on wasm32")
  return ()
}

test effect fn staticFunctionHeaderIsDemandedWithoutRunningItsBody() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-header.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn valid(value: u32) -> u32 { return value }\nfn runtime() -> u32 { return 1 }\nstatic fn broken() -> u32 { return missing }\n"
  let bytes = run Bytes.copy(String.utf8Bytes(source)) |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move bytes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run ModuleIndex.build(&unit) |> Effect.provideMut<Allocator>(&mut allocator)
  let declarations = ModuleIndex.listDeclarations(&index)
  let valid = run StaticFunction.select(&unit, &index, &declarations[usize.ZERO].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedHeader = match move valid {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => Vector.length<HirId>(&value.parameters) == usize.ONE
    _ => false
  }
  run Testing.expect(selectedHeader, "static header selects its body and parameter binder")
  let broken = run StaticFunction.select(&unit, &index, &declarations[2].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBroken = match move broken {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value: _} => true
    _ => false
  }
  run Testing.expect(selectedBroken, "uncalled body is not evaluated")
  let runtime = run StaticFunction.select(&unit, &index, &declarations[usize.ONE].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejectedRuntime = match move runtime {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error} => error.fault == StaticHeaderFault.RuntimeFunction
    _ => false
  }
  run Testing.expect(rejectedRuntime, "runtime function is not a static call target")
  return ()
}

test effect fn staticCallRejectsCheckedBodyFailure() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-checked-body.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn invalid() -> u32 {
  let value: bool = 7
  return value
}
static fn caller() -> u32 { return invalid() }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arguments = Vector.make<Shared<StaticData>>()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let attempted = run Effect.result(StaticExecution.demand(&mut machine, b"caller", Vector.asSlice<Shared<StaticData>>(&arguments), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&attempted, RejectionCode.TypeMismatch, offsetOf(source, "7", usize.ZERO)),
    "a rejected checked body never executes from raw HIR",
  )
  return ()
}

fn staticFaultIs(answer: &Result<StaticData, StaticFault>, expected: StaticFault) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Failure {error} => error == expected
    _ => false
  }
}

fn staticBooleanIs(answer: &Result<StaticData, StaticFault>, expected: bool) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Success {value: StaticData.Boolean {value}} => value == expected
    _ => false
  }
}

fn staticFloatBitsAre(answer: &Result<StaticData, StaticFault>, expected: u64) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Success {value: StaticData.Float {bits, ..}} => bits == expected
    _ => false
  }
}

fn staticIsText(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Text {..}} => true
    _ => false
  }
}

fn staticIsNone(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.None => true
    _ => false
  }
}

fn staticOptionIntegerIs(answer: &Option<StaticData>, ty: StaticIntegerType, magnitude: u64) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Integer {ty: found, sign, magnitude: amount}} => found == ty && sign == StaticSign.Positive && amount == magnitude
    _ => false
  }
}

fn staticOptionFloatBitsAre(answer: &Option<StaticData>, ty: StaticFloatType, bits: u64) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Float {ty: found, bits: payload}} => found == ty && payload == bits
    _ => false
  }
}

fn staticIsUnit(value: &StaticData) -> bool {
  return match &value.* {
    StaticData.Unit => true
    _ => false
  }
}

fn staticHasUnitField(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value} => match move StaticValue.field(&value, usize.ZERO) {
      Option<Shared<StaticData>>.Some {value: field} => Shared.with<StaticData, bool>(&field, staticIsUnit)
      Option<Shared<StaticData>>.None => false
    }
    Option<StaticData>.None => false
  }
}

fn enumMemberIs(answer: &Result<Answer, NoRejection>, ordinal: usize, sign: StaticSign, magnitude: u64) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let entries = Vector.asSlice<Member>(&members)
        if ordinal >= entries.length {
          return false
        }
        return match &entries[ordinal].discriminant {
          Option<EnumCase>.Some {value: selected} => selected.sign == sign && selected.magnitude == magnitude
          Option<EnumCase>.None => false
        }
      }
      _ => false
    }
    _ => false
  }
}

test effect fn staticIntegerArithmeticUsesExactBoundsAndTraps() -> () ! AssertionError<'static> {
  let max = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 255}
  let one = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 1}
  let zero = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0}
  let overflow = StaticValue.infix(InfixOperator.Add, &max, &one, 64)
  let zeroDivision = StaticValue.infix(InfixOperator.Divide, &one, &zero, 64)
  run Testing.expect(staticFaultIs(&overflow, StaticFault.Overflow), "static u8 addition must reject overflow")
  run Testing.expect(staticFaultIs(&zeroDivision, StaticFault.DivisionByZero), "static division must reject zero")
  let minusSeven = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 7}
  let two = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 2}
  let quotient = StaticValue.infix(InfixOperator.Divide, &minusSeven, &two, 64)
  let remainder = StaticValue.infix(InfixOperator.Remainder, &minusSeven, &two, 64)
  run Testing.expect(staticIntegerIs(&quotient, StaticSign.Negative, 3), "signed static division truncates toward zero")
  run Testing.expect(staticIntegerIs(&remainder, StaticSign.Negative, 1), "signed static remainder takes the dividend sign")
  let minimum = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 128}
  let minusOne = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 1}
  let invalidRemainder = StaticValue.infix(InfixOperator.Remainder, &minimum, &minusOne, 64)
  run Testing.expect(staticFaultIs(&invalidRemainder, StaticFault.Overflow), "MIN remainder -1 traps")
  let wasm = MachineTarget.forId(TargetId.Wasm32UnknownUnknown)
  let native = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let rejected32 = StaticValue.integer(StaticIntegerType.Usize, StaticSign.Positive, 4294967296, wasm.pointerBits())
  let accepted64 = StaticValue.integer(StaticIntegerType.Usize, StaticSign.Positive, 4294967296, native.pointerBits())
  run Testing.expect(staticIsNone(&rejected32), "usize rejects values outside the frozen 32-bit target")
  run Testing.expect(staticOptionIntegerIs(&accepted64, StaticIntegerType.Usize, 4294967296), "usize accepts the same value on a frozen 64-bit target")
  let rejectedSigned32 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Positive, 2147483648, wasm.pointerBits())
  let acceptedSigned64 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Positive, 2147483648, native.pointerBits())
  let minimumSigned32 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Negative, 2147483648, wasm.pointerBits())
  run Testing.expect(staticIsNone(&rejectedSigned32), "isize rejects positive values above the frozen 32-bit maximum")
  run Testing.expect(staticOptionIntegerIs(&acceptedSigned64, StaticIntegerType.Isize, 2147483648), "isize accepts the same positive value on a frozen 64-bit target")
  run Testing.expect(!staticIsNone(&minimumSigned32), "isize admits the negative 32-bit minimum")
  return ()
}

test effect fn staticValueReuseIsIdentityFree() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let first = run Shared.make<StaticData>(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let retained = StaticValue.copy(&first)
  let equivalent = run Shared.make<StaticData>(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = run Shared.make<StaticData>(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameRetained = run StaticValue.equals(&first, &retained)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameSeparate = run StaticValue.equals(&first, &equivalent)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let differs = run StaticValue.equals(&first, &different)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(sameRetained && sameSeparate && !differs, "static reuse compares values, not allocation handles")
  let seven = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 7})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = StaticValue.copy(&seven)
  let five = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selfSum = StaticValue.infixShared(InfixOperator.Add, &seven, &alias, 64)
  let distinctSum = StaticValue.infixShared(InfixOperator.Add, &seven, &five, 64)
  let negated = StaticValue.prefixShared(PrefixOperator.Negate, &seven, 64)
  run Testing.expect(staticIntegerIs(&selfSum, StaticSign.Positive, 14), "an aliased value can be used on both sides of an operator")
  run Testing.expect(staticIntegerIs(&distinctSum, StaticSign.Positive, 12), "distinct shared values can be combined")
  run Testing.expect(staticIntegerIs(&negated, StaticSign.Negative, 7), "prefix operators accept a shared value")
  return ()
}

// Runtime identity bytes agree with semantic equality wherever no lifetime is erased.
effect fn expectStaticIdentity(left: StaticData, right: StaticData, owner: &DeclarationId, same: bool) -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let first = run Shared.make<StaticData>(move left)
  let second = run Shared.make<StaticData>(move right)
  let runtime = run StaticValue.runtimeEquals(&first, &second, owner)
  let semantic = run StaticValue.equals(&first, &second)
  run Testing.expect(runtime == same && semantic == same, "static runtime identity matches the expected distinction and semantic equality")
  return ()
}

// A lifetime-only difference is semantic identity but erases from runtime identity.
effect fn expectLifetimeOnlyIdentity(left: StaticData, right: StaticData, owner: &DeclarationId) -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let first = run Shared.make<StaticData>(move left)
  let second = run Shared.make<StaticData>(move right)
  let runtime = run StaticValue.runtimeEquals(&first, &second, owner)
  let semantic = run StaticValue.equals(&first, &second)
  run Testing.expect(runtime && !semantic, "values differing only by a lifetime are semantically distinct and runtime equal")
  return ()
}

effect fn staticNestedArray(outer: &Shared<Type>, inner: &Shared<Type>, last: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let mut rows = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut rows, run Shared.make<StaticData>(run staticArray(inner, 1, 2)))
  run Vector.append<Shared<StaticData>>(&mut rows, run Shared.make<StaticData>(run staticArray(inner, 1, last)))
  let built = StaticValue.aggregate(Shared.clone<Type>(outer), Option.none<usize>(), move rows)
  return match move built {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

effect fn staticU8(magnitude: u64) -> Shared<StaticData> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: magnitude})
}

effect fn staticPairFields(first: u64, second: u64) -> Vector<Shared<StaticData>> ! OutOfMemoryError ? &mut Allocator {
  let mut fields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut fields, run staticU8(first))
  run Vector.append<Shared<StaticData>>(&mut fields, run staticU8(second))
  return move fields
}

effect fn staticArray(ty: &Shared<Type>, first: u64, second: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let built = StaticValue.aggregate(Shared.clone<Type>(ty), Option.none<usize>(), run staticPairFields(first, second))
  return match move built {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

effect fn staticRecord(ty: &Shared<Type>, first: u64, second: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  return StaticValue.record(Shared.clone<Type>(ty), run staticPairFields(first, second))
}

effect fn staticVariant(ty: &Shared<Type>, ordinal: usize, payload: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let mut fields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut fields, run staticU8(payload))
  return StaticValue.unionVariant(Shared.clone<Type>(ty), ordinal, move fields)
}

effect fn staticEnum(declaration: &DeclarationId, member: usize) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  return StaticData.Enum {
    declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(declaration)),
    member: member, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
  }
}

effect fn staticTextValue(spelling: &[u8]) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let decoded = StaticValue.text(run Bytes.copy(spelling))
  return match move decoded {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

test effect fn staticValueRuntimeIdentityCoversEveryKind() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run staticValueRuntimeIdentityClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn staticValueRuntimeIdentityClaims() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("static-identity.silk")
  let source = run present("enum Alpha { First, Second }\nenum Beta { First }\nstruct Pair { left: u8, right: u8 }\nunion Choice { A { value: u8 }, B { value: u8 } }\n")
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let alpha = run requireIndexedIdentity(&mut index, &id, OwnerKind.Enumeration, b"Alpha", usize.ZERO)
  let beta = run requireIndexedIdentity(&mut index, &id, OwnerKind.Enumeration, b"Beta", usize.ZERO)
  let pair = run requireIndexedIdentity(&mut index, &id, OwnerKind.Struct, b"Pair", usize.ZERO)
  let byte = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"u8")})
  let arrayType = run Shared.make<Type>(Type.Array {element: Shared.clone<Type>(&byte), extent: run Bytes.copy(b"2")})
  let pairType = run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(&pair), isPublic: false, arguments: Vector.make<Argument>()})
  let choice = run requireIndexedIdentity(&mut index, &id, OwnerKind.Union, b"Choice", usize.ZERO)
  let choiceType = run Shared.make<Type>(Type.Nominal {declaration: move choice, isPublic: false, arguments: Vector.make<Argument>()})
  run expectStaticIdentity(StaticData.Unit, StaticData.Unit, &pair, true)
  run expectStaticIdentity(StaticData.Unit, StaticData.Boolean {value: false}, &pair, false)
  run expectStaticIdentity(StaticData.Boolean {value: true}, StaticData.Boolean {value: false}, &pair, false)
  run expectStaticIdentity(StaticData.Character {scalar: 0x1f600}, StaticData.Character {scalar: 0x1f600}, &pair, true)
  run expectStaticIdentity(StaticData.Character {scalar: 97}, StaticData.Character {scalar: 98}, &pair, false)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, true)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, false)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0}, StaticData.Float {ty: StaticFloatType.F32, bits: 0x80000000}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc00000}, StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc12345}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0x3f800000}, StaticData.Float {ty: StaticFloatType.F64, bits: 0x3f800000}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F64, bits: 0x7ff8000000001234}, StaticData.Float {ty: StaticFloatType.F64, bits: 0x7ff8000000001234}, &pair, true)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&alpha, 0), &pair, true)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&beta, 0), &pair, false)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&alpha, 1), &pair, false)
  run expectStaticIdentity(run staticTextValue(b"ab"), run staticTextValue(b"ab"), &pair, true)
  run expectStaticIdentity(run staticTextValue(b"ab"), run staticTextValue(b"ba"), &pair, false)
  run expectStaticIdentity(run staticTextValue(b"a"), run staticTextValue(b"ab"), &pair, false)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticArray(&arrayType, 1, 2), &pair, true)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticArray(&arrayType, 2, 1), &pair, false)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticRecord(&pairType, 1, 2), &pair, false)
  run expectStaticIdentity(run staticRecord(&pairType, 1, 2), run staticRecord(&pairType, 1, 2), &pair, true)
  run expectStaticIdentity(run staticVariant(&choiceType, 0, 1), run staticVariant(&choiceType, 1, 1), &pair, false)
  let nestedType = run Shared.make<Type>(Type.Array {element: Shared.clone<Type>(&arrayType), extent: run Bytes.copy(b"2")})
  run expectStaticIdentity(run staticNestedArray(&nestedType, &arrayType, 2), run staticNestedArray(&nestedType, &arrayType, 2), &pair, true)
  run expectStaticIdentity(run staticNestedArray(&nestedType, &arrayType, 2), run staticNestedArray(&nestedType, &arrayType, 3), &pair, false)
  let mut staticRegion = Vector.make<Argument>()
  run Vector.append<Argument>(&mut staticRegion, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
  let mut ownRegion = Vector.make<Argument>()
  run Vector.append<Argument>(&mut ownRegion, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {
    declaration: run DeclarationId.copy(&pair), ordinal: usize.ZERO,
  })})
  let staticHolder = run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(&pair), isPublic: false, arguments: move staticRegion})
  let ownHolder = run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(&pair), isPublic: false, arguments: move ownRegion})
  run expectLifetimeOnlyIdentity(run staticRecord(&staticHolder, 1, 2), run staticRecord(&ownHolder, 1, 2), &pair)
  return ()
}

test effect fn staticFloatIdentityKeepsSignedZeroAndUnorderedNaN() -> () ! AssertionError<'static> {
  let plusZero = StaticData.Float {ty: StaticFloatType.F32, bits: 0}
  let minusZero = StaticData.Float {ty: StaticFloatType.F32, bits: 0x80000000}
  let equal = StaticValue.infix(InfixOperator.Equals, &plusZero, &minusZero, 64)
  run Testing.expect(staticBooleanIs(&equal, true), "signed zeros compare equal")
  let nan = StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc00000}
  let payload32 = StaticValue.floating(StaticFloatType.F32, 0x7fc12345)
  let payload64 = StaticValue.floating(StaticFloatType.F64, 0x7ff8000000001234)
  run Testing.expect(staticOptionFloatBitsAre(&payload32, StaticFloatType.F32, 0x7fc12345), "f32 NaN payload survives static bit admission")
  run Testing.expect(staticOptionFloatBitsAre(&payload64, StaticFloatType.F64, 0x7ff8000000001234), "f64 NaN payload survives static bit admission")
  let unordered = StaticValue.infix(InfixOperator.LessThan, &nan, &plusZero, 64)
  let unequal = StaticValue.infix(InfixOperator.NotEquals, &nan, &nan, 64)
  run Testing.expect(staticBooleanIs(&unordered, false), "NaN is unordered")
  run Testing.expect(staticBooleanIs(&unequal, true), "NaN differs from itself")
  let negated = StaticValue.prefix(PrefixOperator.Negate, &plusZero, 64)
  run Testing.expect(staticFloatBitsAre(&negated, 0x80000000), "negating zero preserves its sign bit")
  return ()
}

test effect fn scalarEnumDemandChecksDiscriminantSequence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("enum-values.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Empty {}\nstruct Resource {}\nimpl Drop for Resource {}\nenum(i8) Exit { Start, Rewind = -2, Next }\nenum(u8) Separated { Ten = 1_0 }\nenum(u8) Named { Same, Same }\nenum(u8) Duplicate { First = 1, Second = 1 }\nenum(u8) Range { Bad = 256 }\nenum(u8) Overflow { Max = 255, Next }\nenum(u8) Negative { Bad = -1 }\n"
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let emptyIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Empty")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&emptyIdentity, nominalResult)
  let mut pureNominalUnsupported = false
  if let Option<Shared<Type>>.Some {value: ty} = move emptyType {
    let unsupported = StaticValue.aggregate(Shared.clone<Type>(&ty), Option.none<usize>(), Vector.make<Shared<StaticData>>())
    let record = StaticValue.record(Shared.clone<Type>(&ty), Vector.make<Shared<StaticData>>())
    let tupleValue = StaticValue.tupleValue(Shared.clone<Type>(&ty), Vector.make<Shared<StaticData>>())
    let variant = StaticValue.unionVariant(Shared.clone<Type>(&ty), usize.ZERO, Vector.make<Shared<StaticData>>())
    let optional = StaticValue.optionalVariant(move ty, usize.ZERO, Vector.make<Shared<StaticData>>())
    pureNominalUnsupported = staticIsNone(&unsupported) && !StaticValue.pure(&record) && !StaticValue.pure(&tupleValue) && !StaticValue.pure(&variant) && !StaticValue.pure(&optional)
  }
  let resourceIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Resource")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resourceType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&resourceIdentity, nominalResult)
  let implementations = run Semantic.demandImplementations(&mut semantic, &mut request, &entry)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hasDropHead = Shared.with<Result<Answer, NoRejection>, usize>(&implementations, headCount) == usize.ONE
  let mut cleanupNominalRejected = false
  if let Option<Shared<Type>>.Some {value: ty} = move resourceType {
    let unsupported = StaticValue.aggregate(move ty, Option.none<usize>(), Vector.make<Shared<StaticData>>())
    cleanupNominalRejected = staticIsNone(&unsupported)
  }
  run Testing.expect(pureNominalUnsupported && hasDropHead && cleanupNominalRejected, "source-backed cleanup nominal and unproven pure nominal are Unsupported until M2.5")
  let valid = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Exit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&valid, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return enumMemberIs(answer, 0, StaticSign.Positive, 0) && enumMemberIs(answer, 1, StaticSign.Negative, 2) && enumMemberIs(answer, 2, StaticSign.Negative, 1)
  }), "enum members retain exact explicit and implicit discriminants")
  let separated = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Separated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&separated, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return enumMemberIs(answer, 0, StaticSign.Positive, 10)
  }), "decimal enum discriminants accept separators")
  let duplicate = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsRelated(&duplicate, RejectionCode.DuplicateEnumDiscriminant, offsetOf(text, "Second = 1", usize.ZERO) + 9, offsetOf(text, "First = 1", usize.ZERO) + 8), "duplicate enum values relate both discriminants")
  let duplicateName = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Named")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsRelated(&duplicateName, RejectionCode.DuplicateEnumMember, offsetOf(text, "Same", 1), offsetOf(text, "Same", usize.ZERO)), "duplicate enum names relate both name tokens")
  let outOfRange = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Range")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&outOfRange, RejectionCode.EnumDiscriminantOutOfRange, offsetOf(text, "256", usize.ZERO)), "explicit enum values stay in representation range")
  let overflow = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Overflow")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&overflow, RejectionCode.EnumImplicitOverflow, offsetOf(text, "Next", 1)), "implicit enum successor cannot overflow")
  let negative = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Negative")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&negative, RejectionCode.UnsignedEnumNegative, offsetOf(text, "-1", usize.ZERO)), "unsigned enum rejects a negative discriminant")
  return ()
}

test effect fn staticValueMatchesResolvedType() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let boolName = run Bytes.copy(b"bool") |> Effect.provideMut<Allocator>(&mut allocator)
  let boolType = run Shared.make<Type>(Type.Primitive {name: move boolName})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let staticLifetime = run Shared.make<Lifetime>(Lifetime.Static)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stringType = run Shared.make<Type>(Type.String {lifetime: move staticLifetime})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boolean = run Shared.make<StaticData>(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let textBytes = run Bytes.copy(b"hello") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run Shared.make<StaticData>(StaticData.Text {bytes: move textBytes})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptsBool = run StaticValue.matchesType(&boolean, &boolType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejectsBoolAsString = run StaticValue.matchesType(&boolean, &stringType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptsString = run StaticValue.matchesType(&text, &stringType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(acceptsBool && !rejectsBoolAsString && acceptsString,
    "resolved primitive and string types admit only matching static scalars")
  let extent = run Bytes.copy(b"2") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayType = run Shared.make<Type>(Type.Array {
    element: Shared.clone<Type>(&boolType), extent: move extent,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut fields, Shared.clone<StaticData>(&boolean))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Shared.make<StaticData>(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut fields, move second)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptedArray = StaticValue.aggregate(Shared.clone<Type>(&arrayType), Option.none<usize>(), move fields)
  let array = match move acceptedArray {
    Option<StaticData>.Some {value} => run Shared.make<StaticData>(move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<StaticData>.None => { return run Testing.expect(false, "pure fixed array constructs") }
  }
  let acceptsArray = run StaticValue.matchesType(&array, &arrayType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wrongFields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut wrongFields, Shared.clone<StaticData>(&boolean))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongElement = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut wrongFields, move wrongElement)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mismatchedArray = StaticValue.aggregate(Shared.clone<Type>(&arrayType), Option.none<usize>(), move wrongFields)
  let wrongArray = match move mismatchedArray {
    Option<StaticData>.Some {value} => run Shared.make<StaticData>(move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<StaticData>.None => { return run Testing.expect(false, "wrong child still constructs") }
  }
  let rejectsWrongChild = run StaticValue.matchesType(&wrongArray, &arrayType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(acceptsArray && !rejectsWrongChild,
    "fixed-array admission compares every child with the canonical element type")
  return ()
}

test effect fn staticTextAndAggregateRejectBorrowedStorage() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let validBytes = run Bytes.copy(b"ok") |> Effect.provideMut<Allocator>(&mut allocator)
  let valid = StaticValue.text(move validBytes)
  run Testing.expect(staticIsText(&valid), "static text admits valid UTF-8")
  let mut copiedText = false
  if let Option<StaticData>.Some {value} = move valid {
    let shared = run Shared.make<StaticData>(move value) |> Effect.provideMut<Allocator>(&mut allocator)
    let copied = run StaticValue.textBytes(&shared) |> Effect.provideMut<Allocator>(&mut allocator)
    if let Option<Bytes>.Some {value: bytes} = move copied {
      copiedText = sameBytes(Bytes.asSlice(&bytes), b"ok")
    }
  }
  run Testing.expect(copiedText, "shared static text can be copied for a diagnostic")
  let mut invalidBytes = run Bytes.copy(b"ok") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut raw = Bytes.asMutSlice(&mut invalidBytes)
  raw[usize.ZERO] = 255
  let invalid = StaticValue.text(move invalidBytes)
  run Testing.expect(staticIsNone(&invalid), "static text rejects invalid UTF-8")
  let unitType = run Shared.make<Type>(Type.Unit) |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = run Bytes.copy(b"1") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayType = run Shared.make<Type>(Type.Array {element: Shared.clone<Type>(&unitType), extent: move extent})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let constructionType = Shared.clone<Type>(&arrayType)
  let mut fields = Vector.make<Shared<StaticData>>()
  let mut constructionFields = Vector.make<Shared<StaticData>>()
  let unitValue = run Shared.make<StaticData>(StaticData.Unit)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut fields, Shared.clone<StaticData>(&unitValue))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut constructionFields, move unitValue)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aggregate = StaticValue.aggregate(move arrayType, Option.none<usize>(), move fields)
  run Testing.expect(staticHasUnitField(&aggregate), "static aggregate projection returns a reusable value")
  let constructed = StaticValue.fixedArray(move constructionType, move constructionFields)
  let mut constructionOnly = false
  if let Option<StaticData>.Some {value} = move constructed {
    constructionOnly = !StaticValue.pure(&value)
  }
  run Testing.expect(constructionOnly, "a configuration array is construction-only before Shape admission")
  let environment = run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let requirements = run Shared.make<Row>(Row.empty())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let deferred = Type.Effect {
    mode: CallableMode.Shared,
    environment: move environment,
    success: Shared.clone<Type>(&unitType),
    failure: Shared.clone<Type>(&unitType),
    requirements: move requirements,
  }
  let forbiddenEffect = StaticValue.intrinsicallyForbidden(&deferred)
  run Testing.expect(forbiddenEffect, "an Effect cannot enter static aggregate storage")
  let deferredType = run Shared.make<Type>(move deferred) |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyExtent = run Bytes.copy(b"0") |> Effect.provideMut<Allocator>(&mut allocator)
  let deferredArray = run Shared.make<Type>(Type.Array {element: move deferredType, extent: move emptyExtent})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forbiddenAggregate = StaticValue.aggregate(move deferredArray, Option.none<usize>(), Vector.make<Shared<StaticData>>())
  run Testing.expect(staticIsNone(&forbiddenAggregate), "an empty array of Effects is not a static aggregate")
  let lifetime = run Shared.make<Lifetime>(Lifetime.Static) |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowed = Type.Reference {referent: move unitType, access: Access.Shared, lifetime: move lifetime}
  let forbiddenBorrow = StaticValue.intrinsicallyForbidden(&borrowed)
  run Testing.expect(forbiddenBorrow, "a borrow cannot enter static aggregate storage")
  return ()
}

// All semantic fixtures deliberately use one selected native target.
fn makeSemantic(revision: Revision) -> Semantic {
  return Semantic.make(move revision, MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option.none<FinalProfile>())
}

struct AnswerView {
  success: bool
  dependencies: usize
  sources: usize
}

struct BranchArms {
  first: usize
  second: usize
}

struct InterfaceCallPair {
  firstContract: Shared<Type>
  secondContract: Shared<Type>
  firstProvider: Shared<Type>
  secondProvider: Shared<Type>
  sameOperation: bool
  sameWitness: bool
  hasWitness: bool
  oneReceiverPerCall: bool
  qualifiedThenReceiver: bool
}

struct NestedFailureAllocator {
  targetBytes: usize
  rejected: bool
}

impl NestedFailureAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Allocation ! OutOfMemoryError {
    if layout.bytes == self.targetBytes && layout.alignment == 1 {
      self.rejected = true
      fail OutOfMemoryError {}
    }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout)
      |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for NestedFailureAllocator {
  allocate: NestedFailureAllocator.allocate
}

fn inspect(answer: &Result<Answer, NoRejection>) -> AnswerView {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: _} => AnswerView {
        success: true,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
      Outcome.Rejected {diagnostic: _} => AnswerView {
        success: false,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => AnswerView {
      success: false,
      dependencies: usize.ZERO,
      sources: usize.ZERO,
    }
  }
}

fn rejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      Outcome.Success {value: _} => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn answerHasAbsentSource(answer: &Result<Answer, NoRejection>, module: &ModuleId) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let sources = Vector.asSlice<Shared<Observation>>(&value.sources)
      let mut at = usize.ZERO
      while at < sources.length {
        if Shared.with<Observation, bool>(
          &sources[at],
          fn(observed: &Observation) -> bool {
            return !Observation.isPresent(observed) && ModuleId.equals(
              Observation.moduleId(observed),
              module,
            )
          },
        ) {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => Option.some<Shared<TypedBody>>(
        Shared.clone<TypedBody>(&body),
      )
      _ => Option.none<Shared<TypedBody>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<TypedBody>>()
  }
}

fn bodyIsFullyChecked(body: &TypedBody) -> bool {
  let stage = TypedBody.checkingStage(body)
  return match &stage.* {
    BodyStage.FullyChecked => true
    BodyStage.ContractTyped {..} => false
  }
}

fn bodyIsContractTyped(body: &TypedBody) -> bool {
  let stage = TypedBody.checkingStage(body)
  return match &stage.* {
    BodyStage.ContractTyped {..} => true
    BodyStage.FullyChecked => false
  }
}

fn bodyAnswerIsContractTyped(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&value, bodyIsContractTyped)
  }
  return false
}

fn bodyRetainsReceiverPass(body: &TypedBody, mode: BodyReceiverPass) -> bool {
  let mut typed = false
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form, ..} = &nodes[at].kind {
      if let BodyExpression.DirectCall {receiverPass, arguments, ..} = &form {
        if let Option<BodyReceiverPass>.Some {value} = &receiverPass {
          typed = typed || value == mode && Vector.length<BodyNodeId>(&arguments) > usize.ZERO
        }
      }
    }
    at = at + usize.ONE
  }
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector.asSlice<BodySafetyObligation>(&obligations)
    at = usize.ZERO
    while at < entries.length {
      if let BodySafetyObligation.ReceiverPass {receiver, mode: retained, ..} = &entries[at] {
        if receiver.index < nodes.length && retained == mode {
          return typed
        }
      }
      at = at + usize.ONE
    }
  }
  return false
}

struct ForwardedTypes {
  local: Shared<Type>
  moved: Shared<Type>
  entry: Shared<Type>
  deferred: Shared<Type>
}

fn forwardedTypes(body: &TypedBody) -> Option<ForwardedTypes> {
  let locals = TypedBody.localSlice(body)
  let nodes = TypedBody.nodeSlice(body)
  if locals.length != usize.ONE || nodes.length != 4 {
    return Option.none<ForwardedTypes>()
  }
  let moved = match &nodes[usize.ONE].kind {
    BodyNodeKind.Expression {ty, form: BodyExpression.Move {..}} => Option.some<Shared<Type>>(
      Shared.clone<Type>(&ty),
    )
    _ => Option.none<Shared<Type>>()
  }
  let mut entry = Option.none<Shared<Type>>()
  let mut deferred = Option.none<Shared<Type>>()
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector.asSlice<BodySafetyObligation>(&obligations)
    if entries.length == 2 {
      if let BodySafetyObligation.WholeValue {ty, ..} = &entries[usize.ZERO] {
        entry = Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
      }
      if let BodySafetyObligation.WholeValue {ty, ..} = &entries[usize.ONE] {
        deferred = Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
      }
    }
  }
  if let Option<Shared<Type>>.Some {value: movedType} = move moved {
    if let Option<Shared<Type>>.Some {value: entryType} = move entry {
      if let Option<Shared<Type>>.Some {value: deferredType} = move deferred {
        return Option.some<ForwardedTypes>(ForwardedTypes {
          local: Shared.clone<Type>(&locals[usize.ZERO].ty),
          moved: move movedType,
          entry: move entryType,
          deferred: move deferredType,
        })
      }
    }
  }
  return Option.none<ForwardedTypes>()
}

fn directCallType(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {..}} = &nodes[at].kind {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn bodyFirstIntegerType(body: &TypedBody, spelling: &[u8]) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if nodes.length == usize.ZERO {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {ty, form: BodyExpression.Integer {..}} => Shared.with<Type, bool>(
      &ty,
      fn(found: &Type) -> bool {
        return match & found.* {
          Type.Primitive {name} => {
            let bytes = Bytes.asSlice(&name)
            if bytes.length != spelling.length {
              return false
            }
            let mut at = usize.ZERO
            while at < bytes.length {
              if bytes[at] != spelling[at] {
                return false
              }
              at = at + usize.ONE
            }
            return true
          }
          _ => false
        }
      },
    )
    _ => false
  }
}

fn rejectionSpells(
  answer: &Result<Answer, NoRejection>,
  code: RejectionCode,
  source: &[u8],
  spelling: &[u8],
) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        if diagnostic.code != code || diagnostic.span.end > source.length || diagnostic.span.end - diagnostic.span.start != spelling.length {
          return false
        }
        let mut at = usize.ZERO
        while at < spelling.length {
          if source[diagnostic.span.start + at] != spelling[at] {
            return false
          }
          at = at + usize.ONE
        }
        return true
      },
    )
  }
  return false
}

fn missingReturnAtFunctionClose(answer: &Result<Answer, NoRejection>, source: &[u8], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + name.length <= source.length {
    let mut matched = usize.ZERO
    while matched < name.length && source[at + matched] == name[matched] {
      matched = matched + usize.ONE
    }
    if matched == name.length {
      let mut end = at + name.length
      while end < source.length && source[end] != 10 {
        end = end + usize.ONE
      }
      if end == usize.ZERO || source[end - usize.ONE] != 125 {
        return false
      }
      let found = rejection(answer)
      if let Option<Shared<Rejection>>.Some {value} = move found {
        return Shared.with<Rejection, bool>(
          &value,
          fn(diagnostic: &Rejection) -> bool {
            return diagnostic.code == RejectionCode.MissingReturn && diagnostic.span.start == end - usize.ONE && diagnostic.span.end == end
          },
        )
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyReadsParameter(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if nodes.length != 3 || TypedBody.runtimeBodies(body).length != 0 || TypedBody.signatureDependencies(
    body,
  ).length != 1 {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => {
      let locals = TypedBody.localSlice(body)
      return local.index < locals.length && locals[local.index].origin.syntax.index < nodes[usize.ZERO].origin.syntax.index
    }
    _ => false
  }
}

fn bodyReadsLocalChain(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  if nodes.length != 7 || locals.length != 2 || !bodyFirstIntegerType(body, b"i32") {
    return false
  }
  return match & nodes[usize.ONE].kind {
    BodyNodeKind.LocalBinding {local: first, initializer: firstValue} => {
      if first.index != usize.ZERO || firstValue.index != usize.ZERO || locals[first.index].origin.syntax.index != nodes[usize.ONE].origin.syntax.index {
        return false
      }
      return match & nodes[2].kind {
        BodyNodeKind.Expression {form: BodyExpression.Local {local: readFirst}, ..} => {
          if readFirst.index != first.index {
            return false
          }
          return match & nodes[3].kind {
            BodyNodeKind.LocalBinding {local: second, initializer: secondValue} => {
              if second.index != usize.ONE || secondValue.index != 2 || locals[second.index].origin.syntax.index != nodes[3].origin.syntax.index {
                return false
              }
              return match & nodes[4].kind {
                BodyNodeKind.Expression {form: BodyExpression.Local {local: readSecond}, ..} => {
                  return readSecond.index == second.index
                }
                _ => false
              }
            }
            _ => false
          }
        }
        _ => false
      }
    }
    _ => false
  }
}

fn bodyShadowsParameter(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  if nodes.length != 5 || locals.length != 2 {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local: initial}, ..} => {
      if initial.index != usize.ZERO {
        return false
      }
      return match & nodes[2].kind {
        BodyNodeKind.Expression {form: BodyExpression.Local {local: returned}, ..} => {
          return returned.index == usize.ONE && locals[usize.ZERO].origin.syntax.index != locals[usize.ONE].origin.syntax.index
        }
        _ => false
      }
    }
    _ => false
  }
}

fn bodyCalls(body: &TypedBody, module: &ModuleId, argumentCount: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let signatures = TypedBody.signatureDependencies(body)
  let required = TypedBody.runtimeBodies(body)
  if signatures.length != 2 || required.length != 1 || !ModuleId.equals(
    DeclarationId.moduleId(&required[usize.ZERO]),
    module,
  ) || !DeclarationId.equals(&signatures[usize.ONE].declaration, &required[usize.ZERO]) {
    return false
  }
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, arguments, ..}, ..} = &nodes[at].kind {
      if !DeclarationId.equals(&declaration, &required[usize.ZERO]) || Vector.length(&arguments) != argumentCount {
        return false
      }
      let ordered = Vector.asSlice(&arguments)
      let mut argument = usize.ONE
      while argument < ordered.length {
        if nodes[ordered[argument - usize.ONE].index].origin.span.start >= nodes[ordered[argument].index].origin.span.start {
          return false
        }
        argument = argument + usize.ONE
      }
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn sameWitness(
  left: &Option<Shared<DeclarationId>>,
  right: &Option<Shared<DeclarationId>>,
) -> bool {
  return match &left.* {
    Option<Shared<DeclarationId>>.None => match &right.* {
      Option<Shared<DeclarationId>>.None => true
      _ => false
    }
    Option<Shared<DeclarationId>>.Some {value: first} => match &right.* {
      Option<Shared<DeclarationId>>.Some {value: second} => sameStep(&first, &second)
      _ => false
    }
  }
}

fn interfaceCallPair(body: &TypedBody) -> Option<InterfaceCallPair> {
  let nodes = TypedBody.nodeSlice(body)
  let mut first = usize.MAX
  let mut second = usize.MAX
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {..}, ..} = &nodes[at].kind {
      if first == usize.MAX {
        first = at
      } else if second == usize.MAX {
        second = at
      }
    }
    at = at + usize.ONE
  }
  if first == usize.MAX || second == usize.MAX {
    return Option.none<InterfaceCallPair>()
  }
  if let BodyNodeKind.Expression {
    form: BodyExpression.InterfaceCall {
      contract: firstContract,
      provider: firstProvider,
      operation: firstOperation,
      implementation: firstWitness,
      receiverPass: firstPass,
      arguments: firstArguments,
      ..
    }, ..
  } = &nodes[first].kind {
    if let BodyNodeKind.Expression {
      form: BodyExpression.InterfaceCall {
        contract: secondContract,
        provider: secondProvider,
        operation: secondOperation,
        implementation: secondWitness,
        receiverPass: secondPass,
        arguments: secondArguments,
        ..
      }, ..
    } = &nodes[second].kind {
      let hasWitness = match &firstWitness {
        Option<Shared<DeclarationId>>.Some {..} => true
        _ => false
      }
      let firstExplicit = match &firstPass {
        Option<BodyReceiverPass>.None => true
        _ => false
      }
      let secondMethod = match &secondPass {
        Option<BodyReceiverPass>.Some {..} => true
        _ => false
      }
      return Option.some<InterfaceCallPair>(InterfaceCallPair {
        firstContract: Shared.clone<Type>(&firstContract),
        secondContract: Shared.clone<Type>(&secondContract),
        firstProvider: Shared.clone<Type>(&firstProvider),
        secondProvider: Shared.clone<Type>(&secondProvider),
        sameOperation: DeclarationId.equals(&firstOperation, &secondOperation),
        sameWitness: sameWitness(&firstWitness, &secondWitness),
        hasWitness: hasWitness,
        oneReceiverPerCall: Vector.length<BodyNodeId>(&firstArguments) == usize.ONE && Vector.length<BodyNodeId>(&secondArguments) == usize.ONE,
        qualifiedThenReceiver: firstExplicit && secondMethod,
      })
    }
  }
  return Option.none<InterfaceCallPair>()
}

fn answerInterfaceCallPair(answer: &Result<Answer, NoRejection>) -> Option<InterfaceCallPair> {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, Option<InterfaceCallPair>>(&value, interfaceCallPair)
  }
  return Option.none<InterfaceCallPair>()
}

fn bodyCallGenericCount(body: &TypedBody, count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {application, ..}, ..} = &nodes[at].kind {
      return Shared.with<SpecializationApplication, bool>(&application, fn(value: &SpecializationApplication) -> bool {
        return Vector.length<Argument>(&value.arguments) == count
      })
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyNestedCalls(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let required = TypedBody.runtimeBodies(body)
  if required.length != 2 || TypedBody.signatureDependencies(body).length != 3 {
    return false
  }
  let mut seen = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, ..}, ..} = &nodes[at].kind {
      if seen >= required.length || !DeclarationId.equals(&declaration, &required[seen]) {
        return false
      }
      seen = seen + usize.ONE
    }
    at = at + usize.ONE
  }
  return seen == 2
}

fn singleBranch(body: &TypedBody) -> Option<usize> {
  let nodes = TypedBody.nodeSlice(body)
  let root = TypedBody.rootNode(body)
  if root.index >= nodes.length {
    return Option.none<usize>()
  }
  if let BodyNodeKind.Block {statements, canComplete} = &nodes[root.index].kind {
    let written = Vector.asSlice(&statements)
    if !canComplete && written.length == 1 {
      return Option.some<usize>(written[usize.ZERO].index)
    }
  }
  return Option.none<usize>()
}

fn completeBranchArms(body: &TypedBody, branchIndex: usize) -> Option<BranchArms> {
  let nodes = TypedBody.nodeSlice(body)
  if branchIndex >= nodes.length {
    return Option.none<BranchArms>()
  }
  if let BodyNodeKind.Branch {thenBranch, elseBranch, canComplete, ..} = &nodes[branchIndex].kind {
    if !canComplete {
      if let Option<BodyNodeId>.Some {value: other} = &elseBranch {
        return Option.some<BranchArms>(BranchArms {first: thenBranch.index, second: other.index})
      }
    }
  }
  return Option.none<BranchArms>()
}

fn blockCannotComplete(body: &TypedBody, index: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if index < nodes.length {
    if let BodyNodeKind.Block {canComplete, ..} = &nodes[index].kind {
      return !canComplete
    }
  }
  return false
}

fn bodyHasCompleteBranch(body: &TypedBody) -> bool {
  let branch = singleBranch(body)
  if let Option<usize>.Some {value: branchIndex} = move branch {
    let selected = completeBranchArms(body, branchIndex)
    if let Option<BranchArms>.Some {value: arms} = move selected {
      return blockCannotComplete(body, arms.first) && blockCannotComplete(body, arms.second)
    }
  }
  return false
}

fn bodyHasDistinctArmLocals(body: &TypedBody) -> bool {
  let locals = TypedBody.localSlice(body)
  if locals.length != 3 || locals[usize.ONE].origin.syntax.index == locals[2].origin.syntax.index {
    return false
  }
  let nodes = TypedBody.nodeSlice(body)
  let mut first = false
  let mut second = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[at].kind {
      if local.index == 1 {
        first = true
      } else if local.index == 2 {
        second = true
      }
    }
    at = at + usize.ONE
  }
  return first && second
}

fn rejectionCode(answer: &Result<Answer, NoRejection>, code: RejectionCode) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.end > diagnostic.span.start
      },
    )
  }
  return false
}

fn selectedStaticFailure(answer: &Result<Answer, NoRejection>, source: &[u8]) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      if diagnostic.code != RejectionCode.SelectedCompileError { return false }
      if let Option<StaticDiagnostic>.Some {value: details} = &diagnostic.staticFailure {
        if !sameBytes(details.code, b"SEM0177") ||
          Vector.length<StaticTraceStep>(&details.trace) != usize.ONE {
          return false
        }
        if let Option<Bytes>.Some {value: message} = &details.message {
          if !sameBytes(Bytes.asSlice(&message), b"stop") { return false }
        } else { return false }
        if let Option<Span>.Some {value: origin} = &details.origin {
          return origin.end <= source.length && origin.end > origin.start
        }
      }
      return false
    })
  }
  return false
}

fn isUnknownName(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownName
}

fn isUnknownMember(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownMember
}

fn isMissingModule(value: &Rejection) -> bool {
  return value.code == RejectionCode.MissingModule && value.span.end > value.span.start
}

fn isPrivateExposure(value: &Rejection) -> bool {
  return value.code == RejectionCode.PrivateTypeExposure && value.span.end > value.span.start
}

fn isCollision(value: &Rejection) -> bool {
  return value.code == RejectionCode.Collision
}

fn isCycle(value: &Rejection) -> bool {
  return value.code == RejectionCode.Cycle
}

fn cyclePathLength(value: &Rejection) -> usize {
  return Vector.length(&value.path)
}

fn spanEnd(value: &Rejection) -> usize {
  return value.span.end
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn stepWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

// Cycle paths share declaration handles; compare one handle without entering it twice.
fn sameStep(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return stepWith(first, right)
    },
  )
}

fn stepOf(value: &Rejection, at: usize) -> Shared<DeclarationId> {
  let path = Vector.asSlice<Shared<DeclarationId>>(&value.path)
  return Shared.clone<DeclarationId>(&path[at])
}

fn cycleStep(diagnostic: &Shared<Rejection>, at: usize) -> Shared<DeclarationId> {
  return Shared.with<Rejection, Shared<DeclarationId>>(
    diagnostic,
    fn(value: &Rejection) -> Shared<DeclarationId> {
      return stepOf(value, at)
    },
  )
}

fn sameModuleWith(first: &Rejection, other: &Shared<Rejection>) -> bool {
  return Shared.with<Rejection, bool>(
    other,
    fn(second: &Rejection) -> bool {
      return ModuleId.equals(&first.module, &second.module)
    },
  )
}

// Compares cycle rejections from two stores: anchor, module, and the complete ordered path.
fn sameCycle(left: &Shared<Rejection>, right: &Shared<Rejection>) -> bool {
  let length = Shared.with<Rejection, usize>(left, cyclePathLength)
  if !Shared.with<Rejection, bool>(left, isCycle) || !Shared.with<Rejection, bool>(right, isCycle) || length != Shared.with<
    Rejection,
    usize,
  >(right, cyclePathLength) || length < 2 || Shared.with<Rejection, usize>(left, spanStart) != Shared.with<
    Rejection,
    usize,
  >(right, spanStart) || Shared.with<Rejection, usize>(left, spanEnd) != Shared.with<
    Rejection,
    usize,
  >(right, spanEnd) || !Shared.with<Rejection, bool>(
    left,
    fn(first: &Rejection) -> bool {
      return sameModuleWith(first, right)
    },
  ) {
    return false
  }
  let mut at = usize.ZERO
  while at < length {
    if !sameStep(&cycleStep(left, at), &cycleStep(right, at)) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameCycleAnswers(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(left, rejection)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(right, rejection)
  if let Option<Shared<Rejection>>.Some {value: from} = move first {
    if let Option<Shared<Rejection>>.Some {value: to} = move second {
      return sameCycle(&from, &to)
    }
  }
  return false
}

// Two members of one two-declaration cycle each start the path at themselves.
fn rotatedPair(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(left, rejection)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(right, rejection)
  if let Option<Shared<Rejection>>.Some {value: from} = move first {
    if let Option<Shared<Rejection>>.Some {value: to} = move second {
      return Shared.with<Rejection, usize>(&from, cyclePathLength) == 3 && Shared.with<
        Rejection,
        usize,
      >(&to, cyclePathLength) == 3 && sameStep(&cycleStep(&from, 0), &cycleStep(&to, 1)) && sameStep(
        &cycleStep(&from, 1),
        &cycleStep(&to, 0),
      ) && !sameStep(&cycleStep(&from, 0), &cycleStep(&to, 0))
    }
  }
  return false
}

fn cycleAnchoredAt(answer: &Result<Answer, NoRejection>, start: usize) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.Cycle && diagnostic.span.start == start && diagnostic.span.end == start + usize.ONE
      },
    )
  }
  return false
}

fn importCycleAnchor(value: &Rejection) -> bool {
  return value.span.end > value.span.start
}

fn isNominal(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Nominal {..} => true
    _ => false
  }
}

fn isBool(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 4 && bytes[0] == 98 && bytes[1] == 111 && bytes[2] == 111 && bytes[3] == 108
    }
    _ => false
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn spanStart(value: &Rejection) -> usize {
  return value.span.start
}

fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Signature {signature} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&signature.result),
        )
        _ => Option.none<Shared<Type>>()
      }
      Outcome.Rejected {diagnostic: _} => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn nominalResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Type {resolved}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&resolved),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn memberNames(answer: &Result<Answer, NoRejection>, first: &[u8], second: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let entries = Vector.asSlice(&members)
        if entries.length != 2 {
          return false
        }
        return match & entries[0].name {
          Option<Bytes>.Some {value: left} => match & entries[1].name {
            Option<Bytes>.Some {value: right} => sameBytes(Bytes.asSlice(&left), first) && sameBytes(
              Bytes.asSlice(&right),
              second,
            )
            _ => false
          }
          _ => false
        }
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn memberSingleName(answer: &Result<Answer, NoRejection>, expected: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let entries = Vector.asSlice<Member>(&members)
        if entries.length != 1 {
          return false
        }
        return match & entries[0].name {
          Option<Bytes>.Some {value: name} => sameBytes(Bytes.asSlice(&name), expected)
          Option<Bytes>.None => false
        }
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => Vector.length<Shared<Type>>(&types)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn shapeFirstIsBool(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector.asSlice<Shared<Type>>(&types)
        return values.length == 1 && Shared.with<Type, bool>(&values[0], isBool)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeFirstIsI32(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector.asSlice<Shared<Type>>(&types)
        return values.length == 1 && Shared.with<Type, bool>(&values[0], isI32)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeFirstIsNominal(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector.asSlice<Shared<Type>>(&types)
        return values.length == 1 && Shared.with<Type, bool>(&values[0], isNominal)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn zeroArrayOfNominal(value: &Type) -> bool {
  return match & value.* {
    Type.Array {element, extent} => sameBytes(Bytes.asSlice(&extent), b"0") && Shared.with<
      Type,
      bool,
    >(&element, isNominal)
    _ => false
  }
}

fn signatureIsZeroNominalArray(answer: &Result<Answer, NoRejection>) -> bool {
  let result = signatureResult(answer)
  if let Option<Shared<Type>>.Some {value: ty} = move result {
    return Shared.with<Type, bool>(&ty, zeroArrayOfNominal)
  }
  return false
}

// Demands one fixed set of member facts and their consumers. Warm and fresh stores must agree at
// each stage: 0 is the initial source, 1 changes the field type, and 2 renames the fields, makes
// the second member present, and writes an unknown first field type.
effect fn memberFacts(
  semantic: &mut Semantic,
  geometry: &ModuleId,
  consumer: &ModuleId,
  point: &Shared<Type>,
  text: &[u8],
  stage: usize,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let mut request = Request.make()
  let identity = run Semantic.demandIdentity(&mut semantic.*, &mut request, geometry, b"Point")
  let names = run Semantic.demandMembers(&mut semantic.*, &mut request, geometry, b"Point")
  let first = run Semantic.demandMemberShape(
    &mut semantic.*,
    &mut request,
    geometry,
    b"Point",
    0,
    point,
  )
  let second = run Semantic.demandMemberShape(
    &mut semantic.*,
    &mut request,
    geometry,
    b"Point",
    1,
    point,
  )
  let origin = run Semantic.demandSignature(&mut semantic.*, &mut request, consumer, b"origin")
  let caller = run Semantic.demandBody(&mut semantic.*, &mut request, consumer, b"caller")
  let sameIdentity = run typesEqual(
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&identity, nominalResult),
    Option.some<Shared<Type>>(Shared.clone<Type>(point)),
  )
  let sameParameter = run typesEqual(
    slotOf(&origin, usize.ZERO),
    Option.some<Shared<Type>>(Shared.clone<Type>(point)),
  )
  let callerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &caller,
    checkedBody,
  )
  let mut callsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move callerBody {
    callsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, geometry, usize.ZERO)
      },
    )
  }
  let consumers = sameIdentity && sameParameter && callsLeaf && Request.hasDiscovered(
    &request,
    geometry,
  )
  if stage == 2 {
    return consumers && Shared.with<Result<Answer, NoRejection>, bool>(
      &names,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return memberNames(answer, b"height", b"depth")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &first,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.UnknownLifetime, text, b"'undeclared")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(&second, shapeFirstIsI32)
  }
  let widthOnly = Shared.with<Result<Answer, NoRejection>, bool>(
    &names,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return memberSingleName(answer, b"width")
    },
  )
  let absent = Shared.with<Result<Answer, NoRejection>, bool>(
    &second,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectedTypeApplication(answer, RejectionCode.UnknownMember)
    },
  )
  if stage == usize.ONE {
    return consumers && widthOnly && absent && Shared.with<Result<Answer, NoRejection>, bool>(
      &first,
      shapeFirstIsBool,
    )
  }
  return consumers && widthOnly && absent && Shared.with<Result<Answer, NoRejection>, bool>(
    &first,
    shapeFirstIsI32,
  )
}

effect fn memberRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let geometry = run module("geometry.silk")
  let consumer = run module("consumer.silk")
  let consumerSource = run present(
    "import geometry as Geometry\nfn origin(at: Geometry.Point) -> () { return () }\nfn caller() -> i32 { return Geometry.leaf() }\nfn unrelated() -> i32 { return 2 }\n",
  )
  let initialText = "type Element = i32\npub struct Point { width: Element }\npub fn leaf() -> i32 { return 1 }\n"
  let initialSource = run present(initialText)
  let base = run Revision.publish(&Revision.make(), &consumer, &consumerSource)
  let held = run Revision.publish(&base, &geometry, &initialSource)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut original = Request.make()
  let identity = run Semantic.demandIdentity(&mut semantic, &mut original, &geometry, b"Point")
  let nominal = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &identity,
    nominalResult,
  )
  let point = match move nominal {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the nominal identity resolves")
      return ()
    }
  }
  let initial = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(initialText),
    usize.ZERO,
  )
  let unrelated = run Semantic.demandBody(&mut semantic, &mut original, &consumer, b"unrelated")
  run Testing.expect(
    initial && Shared.with<Result<Answer, NoRejection>, AnswerView>(&unrelated, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 2,
    "names, one field type, an absent member, and their consumers are separate facts",
  )
  let typeText = "type Element = bool\npub struct Point { width: Element }\npub fn leaf() -> i32 { return 1 }\n"
  let typeSource = run present(typeText)
  let typeRevision = run Revision.publish(&held, &geometry, &typeSource)
  Semantic.revise(&mut semantic, run Revision.copy(&typeRevision))
  let warmType = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(typeText),
    usize.ONE,
  )
  let mut unrelatedRequest = Request.make()
  let kept = run Semantic.demandBody(&mut semantic, &mut unrelatedRequest, &consumer, b"unrelated")
  let mut freshType = makeSemantic(run Revision.copy(&typeRevision))
  let coldType = run memberFacts(
    &mut freshType,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(typeText),
    usize.ONE,
  )
  run Testing.expect(
    warmType && coldType && Shared.with<Result<Answer, NoRejection>, AnswerView>(&kept, inspect).success && reused(
      Semantic.eventLog(&semantic),
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Body) == 3 && hits(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 1 && starts(Semantic.eventLog(&freshType), Family.Body) == 1,
    "a field type edit changes shape consumers while equal identity, names, and callee signature keep the caller",
  )
  let renamedText = "type Element = bool\npub struct Point {\n height: &'undeclared i32\n depth: i32\n}\npub fn leaf() -> i32 { return 1 }\n"
  let renamedSource = run present(renamedText)
  let renamedRevision = run Revision.publish(&typeRevision, &geometry, &renamedSource)
  Semantic.revise(&mut semantic, run Revision.copy(&renamedRevision))
  let warmRenamed = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(renamedText),
    2,
  )
  let mut freshRenamed = makeSemantic(run Revision.copy(&renamedRevision))
  let coldRenamed = run memberFacts(
    &mut freshRenamed,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(renamedText),
    2,
  )
  run Testing.expect(
    warmRenamed && coldRenamed && reused(Semantic.eventLog(&semantic)) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 4,
    "renamed names, a newly present member, and a current field diagnostic reach only their consumers",
  )
  let faultText = "type Element = bool\npub struct Point {\n height: bool\n depth: i32\n}\npub fn leaf() -> i32 { return 1 }\n// This unique source allocation fails while the caller revalidates.\n"
  let faultSource = run present(faultText)
  let faultRevision = run Revision.publish(&renamedRevision, &geometry, &faultSource)
  Semantic.revise(&mut semantic, move faultRevision)
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(faultText).length,
    rejected: false,
  }
  let mut failedRequest = Request.make()
  let attempted = run Effect.result(
    Semantic.demandBody(&mut semantic, &mut failedRequest, &consumer, b"caller"),
  )
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Success {value: ignored} => false
  }
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandBody(&mut semantic, &mut retriedRequest, &consumer, b"caller")
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == 0 && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&retried, inspect).success && Request.hasDiscovered(&retriedRequest, &geometry) && reused(
      Semantic.eventLog(&semantic),
    ) == 2 && starts(Semantic.eventLog(&semantic), Family.Body) == 6,
    "a failure during caller revalidation publishes nothing, and the retry checks the current caller",
  )
  return ()
}

test effect fn selectedTargetChecksPointerSizedLiteralMagnitudes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("target-literals.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn localContext() -> usize { let value: usize = 4294967296 return value }\nfn returnContext() -> usize { return 4294967296 }\nfn signed() -> isize { return 2147483648 }\nfn minimum() -> isize { return -2147483648 }\nfn fixed() -> u64 { return 4294967296 }\nfn maximum() -> usize { return 4294967295 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = Semantic.make(
    run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.Wasm32UnknownUnknown),
    Option.none<FinalProfile>(),
  )
  let mut native = Semantic.make(
    move revision,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Option.none<FinalProfile>(),
  )
  let mut wasmRequest = Request.make()
  let mut nativeRequest = Request.make()
  let wasmLocal = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"localContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmReturn = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"returnContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmSigned = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"signed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmMinimum = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"minimum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmFixed = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"fixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmMaximum = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"maximum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeLocal = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"localContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeReturn = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"returnContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeSigned = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"signed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&wasmLocal, RejectionCode.IntegerOutOfRange, offsetOf(text, "4294967296", 0)),
    "wasm32 rejects the annotated usize above its maximum at the literal",
  )
  run Testing.expect(
    rejectsFrom(&wasmReturn, RejectionCode.IntegerOutOfRange, offsetOf(text, "4294967296", 1)),
    "wasm32 rejects the return-context usize above its maximum at the literal",
  )
  run Testing.expect(
    rejectsFrom(&wasmSigned, RejectionCode.IntegerOutOfRange, offsetOf(text, "2147483648", 0)),
    "wasm32 rejects the signed isize above its maximum at the literal",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&wasmMaximum, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&wasmMinimum, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&wasmFixed, inspect).success,
    "wasm32 accepts its usize maximum, its signed minimum and a wide fixed u64",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&nativeLocal, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&nativeReturn, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&nativeSigned, inspect).success,
    "a 64-bit target accepts the same pointer-sized magnitudes",
  )
  return ()
}

test effect fn closedOperatorsKeepExactOperandsAndRuntimeOrder() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("closed-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn add(left: i32, right: i32) -> i32 { return left + right }\nfn literalRight(left: u8) -> u8 { return left + 1 }\nfn literalLeft(right: u8) -> u8 { return 1 + right }\nfn equal(left: bool, right: bool) -> bool { return left == right }\nfn bitwise(left: u16, right: u16) -> u16 { return left ^ right }\nfn pointerSized(left: usize, right: usize) -> usize { return left + right }\nfn mismatch(left: i32, right: u8) -> i32 { return left + right }\nfn noOrder(left: bool, right: bool) -> bool { return left < right }\nfn noNegate(value: u8) -> u8 { return -value }\nfn contextual(value: usize) -> usize { return value + 7 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let add = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"add")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let literalRight = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"literalRight")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let literalLeft = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"literalLeft")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let equal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"equal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bitwise = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bitwise")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerSized = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"pointerSized")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mismatch = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mismatch")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noOrder = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noOrder")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noNegate = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noNegate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let contextual = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"contextual")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&add, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&literalRight, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&literalLeft, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&equal, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&bitwise, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&pointerSized, inspect).success,
    "closed operators accept exact scalar operands and contextual integer literals",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&contextual, inspect).success,
    "an in-range contextual usize participates in a selected-target operator",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&mismatch, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&noOrder, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&noNegate, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "closed operators reject unlike numeric types and unsupported scalar operations",
  )
  return ()
}

fn interfaceOperandsRemainOrdered(body: &TypedBody, concrete: bool) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {implementation, arguments, ..}, ..} = &nodes[at].kind {
      let values = Vector.asSlice<BodyNodeId>(&arguments)
      if values.length != usize.add(1, 1) || values[usize.ZERO].index >= nodes.length || values[usize.ONE].index >= nodes.length {
        return false
      }
      let witness = match &implementation {
        Option<Shared<DeclarationId>>.Some {value: _} => true
        Option<Shared<DeclarationId>>.None => false
      }
      let bodies = TypedBody.runtimeBodies(body)
      let mut required = bodies.length == usize.ZERO
      if concrete {
        required = bodies.length == usize.ONE
      }
      return witness == concrete && required && nodes[values[usize.ZERO].index].origin.span.start < nodes[values[usize.ONE].index].origin.span.start
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn markedOperatorsSelectOneBoundOrConcreteCall() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("marked-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Sum { operator + fn sum(left: Self, right: Self) -> Self }\nstruct Solo {}\nimpl Sum for Solo { fn sum(left: Self, right: Self) -> Self { return left } }\nfn concrete(left: Solo, right: Solo) -> Solo { return left + right }\nfn bounded<T: Sum>(left: T, right: T) -> T { return left + right }\ninterface Plain { fn add(left: Self, right: Self) -> Self }\nstruct Bare {}\nimpl Plain for Bare { fn add(left: Self, right: Self) -> Self { return left } }\nfn unmarked(left: Bare, right: Bare) -> Bare { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unmarked")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let concreteTyped = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &concrete, checkedBody,
  )
  let boundTyped = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &bounded, checkedBody,
  )
  let concreteOrder = match move concreteTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return interfaceOperandsRemainOrdered(body, true)
    })
    Option<Shared<TypedBody>>.None => false
  }
  let boundOrder = match move boundTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return interfaceOperandsRemainOrdered(body, false)
    })
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    concreteOrder && boundOrder &&
    Shared.with<Result<Answer, NoRejection>, bool>(&unmarked, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "marked operator selection keeps source operand order and excludes unmarked operations",
  )
  return ()
}

fn singleOperatorIdentity(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&operations)
      if listed.length == usize.ONE { return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&listed[0])) }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

fn borrowedOperatorBindings(value: &Vector<Binding>, operation: &DeclarationId, left: &Shared<Lifetime>, right: &Shared<Lifetime>, firstOriginal: usize) -> bool {
  let learned = Vector.asSlice<Binding>(value)
  if learned.length != 2 { return false }
  let mut slot = usize.ZERO
  while slot < learned.length {
    let mut original = firstOriginal
    if slot != usize.ZERO { original = usize.ONE - firstOriginal }
    if learned[slot].ordinal != original || !Shared.with<DeclarationId, bool>(&learned[slot].declaration,
      fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, operation) }) { return false }
    if let Argument.Lifetime {value: region} = &learned[slot].value {
      if slot == usize.ZERO {
        if !Lifetime.equalsShared(&region, left) { return false }
      } else if !Lifetime.equalsShared(&region, right) { return false }
    } else { return false }
    slot = slot + usize.ONE
  }
  return true
}

fn borrowedOperatorOperandRegion(node: &BodyNode) -> Option<Shared<Lifetime>> {
  return match &node.kind {
    BodyNodeKind.Expression {ty, ..} => Shared.with<Type, Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
    _ => Option.none<Shared<Lifetime>>()
  }
}

fn borrowedOperatorCall(body: &TypedBody, expected: &Shared<DeclarationId>, concrete: bool, borrowedResult: bool, firstOriginal: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.InterfaceCall {operation, implementation, arguments, bindings, ..}} = &nodes[at].kind {
      if !Shared.with<DeclarationId, bool>(expected, fn(identity: &DeclarationId) -> bool {
        return DeclarationId.equals(identity, &operation)
      }) { return false }
      let bodies = TypedBody.runtimeBodies(body)
      match &implementation {
        Option<Shared<DeclarationId>>.Some {value} => {
          if !concrete || bodies.length != usize.ONE || !DeclarationId.named(&bodies[0], b"equal") { return false }
          let retained = Shared.with<DeclarationId, bool>(&value,
            fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, &bodies[0]) })
          if !retained { return false }
        }
        Option<Shared<DeclarationId>>.None => {
          if concrete || bodies.length != usize.ZERO { return false }
        }
      }
      let supplied = Vector.asSlice<BodyNodeId>(&arguments)
      if supplied.length != 2 || supplied[0].index >= nodes.length || supplied[1].index >= nodes.length { return false }
      if nodes[supplied[0].index].origin.span.start >= nodes[supplied[1].index].origin.span.start { return false }
      let first = borrowedOperatorOperandRegion(&nodes[supplied[0].index])
      let second = borrowedOperatorOperandRegion(&nodes[supplied[1].index])
      if let Option<Shared<Lifetime>>.Some {value: left} = move first {
        if let Option<Shared<Lifetime>>.Some {value: right} = move second {
          if Lifetime.equalsShared(&left, &right) { return false }
          let caller = TypedBody.declarationId(body)
          let firstOwned = Shared.with<Lifetime, bool>(&left, fn(region: &Lifetime) -> bool {
            return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.equals(&declaration, caller) && ordinal == usize.ZERO _ => false }
          })
          let secondOwned = Shared.with<Lifetime, bool>(&right, fn(region: &Lifetime) -> bool {
            return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.equals(&declaration, caller) && ordinal == usize.ONE _ => false }
          })
          if !firstOwned || !secondOwned { return false }
          let exact = Shared.with<Vector<Binding>, bool>(&bindings, fn(value: &Vector<Binding>) -> bool {
            return borrowedOperatorBindings(value, &operation, &left, &right, firstOriginal)
          })
          if !exact { return false }
          if borrowedResult {
            let resultRegion = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
            if let Option<Shared<Lifetime>>.Some {value} = move resultRegion { return Lifetime.equalsShared(&value, &left) }
            return false
          }
          return Shared.with<Type, bool>(&ty, fn(result: &Type) -> bool {
            return match &result.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"bool") _ => false }
          })
        }
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

fn borrowedOperatorEvidence(answer: &Shared<Result<Answer, NoRejection>>, expected: &Shared<DeclarationId>, concrete: bool, borrowedResult: bool, firstOriginal: usize) -> bool {
  let typed = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move typed {
    return Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return borrowedOperatorCall(body, expected, concrete, borrowedResult, firstOriginal)
    })
  }
  return false
}

test effect fn borrowedOperatorsInferOnlyTheirLifetimesAndProveBounds() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("borrowed-operators.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let contracts = run module("keys.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let contractText = """pub interface Equality { operator == fn equal(left: &Self, right: &Self) -> bool }
pub struct Key { pub value: i32 }
impl Equality for Key {
  fn equal(left: &Self, right: &Self) -> bool { return left.value == right.value }
}
pub interface Pick { operator + fn first<'b, 'a>(left: &'a Self, right: &'b Self) -> &'a Self }
pub interface Ordered { operator + fn ordered<'a, 'b: 'a>(left: &'a Self, right: &'b Self) -> &'a Self }
pub interface Fixed { operator == fn fixed(left: &'static Self, right: &'static Self) -> bool }
pub interface Risky { operator == unsafe fn risky(left: &Self, right: &Self) -> bool }
pub interface Repeated { operator == fn repeated<'a>(left: &'a Self, right: &'a Self) -> bool }
"""
  let text = """import keys { Equality, Key, Pick, Ordered, Fixed, Risky, Repeated }
fn bounded<'x, 'y, K: Equality>(left: &'x K, right: &'y K) -> bool { return left == right }
fn concrete<'x, 'y>(left: &'x Key, right: &'y Key) -> bool { return left == right }
fn returned<'x, 'y, K: Pick>(left: &'x K, right: &'y K) -> &'x K { return left + right }
fn proven<'x, 'y: 'x, K: Ordered>(left: &'x K, right: &'y K) -> &'x K { return left + right }
fn missing<'x, 'y, K: Ordered>(left: &'x K, right: &'y K) -> &'x K { return left + right }
fn staticOperands<K: Fixed>(left: &'static K, right: &'static K) -> bool { return left == right }
fn localOperands<'x, 'y, K: Fixed>(left: &'x K, right: &'y K) -> bool { return left == right }
fn wrongAccess<'x, 'y, K: Equality>(left: &'x mut K, right: &'y K) -> bool { return left == right }
fn unsafeOperand<'x, 'y, K: Risky>(left: &'x K, right: &'y K) -> bool { return left == right }
fn repeated<'x, 'y, K: Repeated>(left: &'x K, right: &'y K) -> bool { return left == right }
fn authorized<'x, 'y, K: Risky>(left: &'x K, right: &'y K) -> bool { unsafe { return left == right } }
"""
  let contractSource = run present(contractText) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&r1, &entry, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let equalOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Equality") |> Effect.provideMut<Allocator>(&mut allocator)
  let pickOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Pick") |> Effect.provideMut<Allocator>(&mut allocator)
  let orderedOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Ordered") |> Effect.provideMut<Allocator>(&mut allocator)
  let riskyOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Risky") |> Effect.provideMut<Allocator>(&mut allocator)
  let equal = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&equalOperations, singleOperatorIdentity)
  let pick = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&pickOperations, singleOperatorIdentity)
  let ordered = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&orderedOperations, singleOperatorIdentity)
  let risky = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&riskyOperations, singleOperatorIdentity)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded") |> Effect.provideMut<Allocator>(&mut allocator)
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete") |> Effect.provideMut<Allocator>(&mut allocator)
  let returned = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"returned") |> Effect.provideMut<Allocator>(&mut allocator)
  let proven = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"proven") |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<Shared<DeclarationId>>.Some {value} = move equal {
    run Testing.expect(borrowedOperatorEvidence(&bounded, &value, false, false, usize.ZERO)
      && borrowedOperatorEvidence(&concrete, &value, true, false, usize.ZERO),
      "borrowed generic and concrete operators keep their original target, distinct canonical lifetime bindings and operand order")
  } else { run Testing.expect(false, "Equality publishes exactly one operator") }
  if let Option<Shared<DeclarationId>>.Some {value} = move pick {
    run Testing.expect(borrowedOperatorEvidence(&returned, &value, false, true, usize.ONE),
      "a borrowed operator result retains the first operand lifetime at original ordinal one, independently of operand order")
  } else { run Testing.expect(false, "Pick publishes exactly one operator") }
  if let Option<Shared<DeclarationId>>.Some {value} = move ordered {
    run Testing.expect(borrowedOperatorEvidence(&proven, &value, false, true, usize.ZERO),
      "caller premises independently prove the instantiated operation lifetime bound")
  } else { run Testing.expect(false, "Ordered publishes exactly one operator") }
  let missing = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missing") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.Unsupported, text, "+", 2),
    "an operation lifetime obligation is never assumed as its own proof")
  let staticOperands = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"staticOperands") |> Effect.provideMut<Allocator>(&mut allocator)
  let staticBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&staticOperands, checkedBody)
  run Testing.expect(match move staticBody { Option<Shared<TypedBody>>.Some {..} => true _ => false },
    "fixed static operands still select their exact contract")
  let localOperands = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"localOperands") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongAccess = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongAccess") |> Effect.provideMut<Allocator>(&mut allocator)
  let unsafeOperand = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unsafeOperand") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&localOperands, RejectionCode.MissingOperator, text, "==", 3)
    && rejectsSpan(&wrongAccess, RejectionCode.MissingOperator, text, "==", 4)
    && rejectsSpan(&unsafeOperand, RejectionCode.UnsafeAcknowledgement, text, "==", 5),
    "operand inference preserves fixed static lifetimes, reference access and unsafe admission")
  let repeated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"repeated") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.MissingOperator, text, "==", 6),
    "a repeated operation lifetime is inferred jointly and cannot bind independently to incompatible caller parameters")
  let authorized = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"authorized") |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<Shared<DeclarationId>>.Some {value} = move risky {
    run Testing.expect(borrowedOperatorEvidence(&authorized, &value, false, false, usize.ZERO),
      "an authorized unsafe body retains the selected operation and canonical loan bindings")
  } else { run Testing.expect(false, "Risky publishes exactly one operator") }
  return ()
}

test effect fn competingMarkedOperatorsRejectWithoutResultContextChoice() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("competing-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Sum { operator + fn sum(left: Self, right: Self) -> Self }\ninterface Other { operator + fn other(left: Self, right: Self) -> bool }\nstruct Double {}\nimpl Sum for Double { fn sum(left: Self, right: Self) -> Self { return left } }\nimpl Other for Double { fn other(left: Self, right: Self) -> bool { return false } }\nfn competing(left: Double, right: Double) -> Double { return left + right }\ninterface ScalarAdd { operator + fn add(left: Self, right: Self) -> Self }\nimpl ScalarAdd for i32 { fn add(left: Self, right: Self) -> Self { return left } }\nfn builtinCompetes(left: i32, right: i32) -> i32 { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let competing = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"competing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let builtinCompetes = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"builtinCompetes")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&competing, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.AmbiguousOperator)
    }) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&builtinCompetes, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.AmbiguousOperator)
    }),
    "same-operand interface suppliers and builtin/interface suppliers reject without result context choice",
  )
  return ()
}

test effect fn namespaceImportsExposeOnlyNameableOperatorInterfaces() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let math = run module("math.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let model = run module("model.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let imported = run module("imported.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hidden = run module("hidden.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mathSource = run present("pub interface Sum { operator + fn sum(left: Self, right: Self) -> Self }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let modelSource = run present("import math { Sum }\npub struct Vector {}\nimpl Sum for Vector { fn sum(left: Self, right: Self) -> Self { return left } }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let importedSource = run present("import math\nimport model { Vector }\nfn combine(left: Vector, right: Vector) -> Vector { return left + right }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hiddenSource = run present("import model { Vector }\nfn combine(left: Vector, right: Vector) -> Vector { return left + right }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &math, &mathSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let r2 = run Revision.publish(&r1, &model, &modelSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let r3 = run Revision.publish(&r2, &imported, &importedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&r3, &hidden, &hiddenSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let visible = run Semantic.demandBody(&mut semantic, &mut request, &imported, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invisible = run Semantic.demandBody(&mut semantic, &mut request, &hidden, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&visible, inspect).success,
    "namespace imports make public operator interfaces eligible",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&invisible, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "an unimported operator interface is not eligible",
  )
  return ()
}

test effect fn operatorDiscoverySharesEvidenceAndInvalidatesNamespaceEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let math = run module("math.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """import math as Math
fn first() -> i32 { return 1 + 2 + 3 }
fn second() -> i32 { return 4 + 5 }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let initialMath = run present("""pub interface Unmarked {}
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &entry, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&r1, &math, &initialMath) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.make()
  let first = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"first") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"second") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&first, operatorBodyHasSharedDiscovery) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&second, operatorBodyHasSharedDiscovery) &&
    starts(Semantic.eventLog(&semantic), Family.OperatorInterfaces) == usize.ONE,
    "operator bodies share one discovery query rather than repeating namespace/name scans",
  )
  let changed = run present("""pub interface Unmarked {}
pub interface Sum { operator + fn sum(left: Self, right: Self) -> Self }
impl Sum for i32 { fn sum(left: Self, right: Self) -> Self { return left } }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let updated = run Revision.publish(&revision, &math, &changed) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move updated)
  let replaced = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"second") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&replaced, RejectionCode.AmbiguousOperator, offsetOf(text, "+", 2)) &&
    starts(Semantic.eventLog(&semantic), Family.OperatorInterfaces) == 2,
    "an added namespace operator invalidates the cached interface list and keeps the expression span",
  )
  return ()
}

fn operatorBodyHasSharedDiscovery(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Body {..}} = &value.outcome {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut shared = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        if dependencies[at].family == Family.Name { return false }
        if dependencies[at].family == Family.OperatorInterfaces { shared = true }
        at = at + usize.ONE
      }
      return shared
    }
  }
  return false
}

test effect fn operatorWithoutProviderOwnedOperandHasExplicitBoundary() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("unanchored-operator.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Left {}\ninterface Unanchored { operator + fn combine(left: Left, right: Left) -> Self }\nfn combine(left: Left, right: Left) -> Left { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&checked, RejectionCode.Unsupported, offsetOf(text, "+", 1)),
    "an operator with no provider-owned operand cannot discover a provider-only implementation",
  )
  return ()
}

test effect fn staticOperatorOperandWaitsForStaticEvaluation() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-operator.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface StaticAdd { operator + fn add(left: Self, static right: Self) -> Self }\nfn combine<T: StaticAdd>(left: T, right: T) -> T { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&checked, RejectionCode.Unsupported, offsetOf(text, "+", 1)),
    "a runtime operator call cannot supply an evaluator-only static operand, and the gap is anchored on its operator use",
  )
  return ()
}

fn staleMemberKindRejected(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == RejectionCode.TypeArgumentKind && found.span.end > found.span.start && Bytes.asSlice(
          &found.parameterName,
        ).length > usize.ZERO && found.expectedKind == GenericKind.Lifetime && found.suppliedKind == GenericKind.Type
      },
    )
  }
  return false
}

effect fn memberKindRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("member-kind-edits.silk")
  let source = run present("struct Box<T> { value: T }\nfn applied() -> Box<bool> { return () }\n")
  let held = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut original = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut original, &entry, b"applied")
  let applied = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: application} = move applied {
    let changed = run present("struct Box<'life> { value: bool }\n")
    let revision = run Revision.publish(&held, &entry, &changed)
    Semantic.revise(&mut semantic, move revision)
    let mut request = Request.make()
    let shape = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Box",
      0,
      &application,
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&shape, staleMemberKindRejected),
      "a stale application reports the changed generic argument kind at a source span",
    )
  } else {
    run Testing.expect(false, "the original generic application resolves")
  }
  return ()
}

fn isParameter(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Parameter {ordinal, ..} => ordinal == usize.ZERO
    _ => false
  }
}

fn typeAddressForContract(value: &Type) -> usize {
  return Pointer.address<Type>(Pointer.fromRef<Type>(value))
}

fn sameRepresentationParameterWith(value: &Type, right: &Shared<Type>) -> bool {
  if let Type.Parameter {declaration, ordinal} = &value.* {
    return Shared.with<Type, bool>(
      right,
      fn(other: &Type) -> bool {
        if let Type.Parameter {declaration: selected, ordinal: position} = &other.* {
          return ordinal == position && DeclarationId.equals(&declaration, &selected)
        }
        return false
      },
    )
  }
  return false
}

fn sameRepresentationParameter(left: &Shared<Type>, right: &Shared<Type>) -> bool {
  if Shared.with<Type, usize>(left, typeAddressForContract) == Shared.with<Type, usize>(
    right,
    typeAddressForContract,
  ) {
    return true
  }
  return Shared.with<Type, bool>(
    left,
    fn(value: &Type) -> bool {
      return sameRepresentationParameterWith(value, right)
    },
  )
}

// Contract normalization assertions inspect the promised callable, separately from its exact
// declaration-owned parameter representation, which has independent specialization assertions.
fn parameterContractAt(signature: &Signature, slot: usize) -> Option<Shared<Type>> {
  if slot == usize.MAX { return Option.some<Shared<Type>>(Shared.clone<Type>(&signature.result)) }
  let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
  if slot >= parameters.length {
    return Option.none<Shared<Type>>()
  }
  let parameter = Shared.clone<Type>(&parameters[slot])
  let ordinal = Shared.with<Type, usize>(
    &parameter,
    fn(value: &Type) -> usize {
      return match & value.* {
        Type.Parameter {ordinal, ..} => ordinal
        _ => usize.MAX
      }
    },
  )
  if ordinal != usize.MAX && ordinal >= signature.callableParameterStart {
    let bounds = Vector.asSlice<Constraint>(&signature.constraints)
    let mut at = usize.ZERO
    while at < bounds.length {
      if let Constraint.Represents {parameter: representation, contract} = &bounds[at] {
        if sameRepresentationParameter(&parameter, &representation) {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
        }
      }
      at = at + usize.ONE
    }
  }
  return Option.some<Shared<Type>>(move parameter)
}

fn contractSlotOf(answer: &Shared<Result<Answer, NoRejection>>, slot: usize) -> Option<Shared<Type>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      if let Result<Answer, NoRejection>.Success {value: resolved} = &value.* {
        if let Outcome.Success {value: Value.Signature {signature}} = &resolved.outcome {
          return parameterContractAt(&signature, slot)
        }
      }
      return Option.none<Shared<Type>>()
    },
  )
}

fn typeAt(answer: &Result<Answer, NoRejection>, slot: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        if slot == usize.MAX {
          return Option.some<Shared<Type>>(writtenResult(&signature.result))
        }
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        if slot < parameters.length {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[slot]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

// The written result: a declared `Effect<...>` result's contract rather than the producer family
// that stores its returned Effects (EFF-013).
fn writtenResult(result: &Shared<Type>) -> Shared<Type> {
  let contract = Shared.with<Type, Option<Shared<Type>>>(result, familyEffectContract)
  return match move contract {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => Shared.clone<Type>(result)
  }
}

fn familyEffectContract(value: &Type) -> Option<Shared<Type>> {
  if let Type.OpaqueRepresentation {contract, ..} = &value.* {
    if Shared.with<Type, bool>(&contract, bareEffectType) { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
  }
  return Option.none<Shared<Type>>()
}

fn bareEffectType(value: &Type) -> bool {
  return match &value.* { Type.Effect {..} => true _ => false }
}

// A parameter's type, or the result's type when `slot` is `usize.MAX`.
fn slotOf(answer: &Shared<Result<Answer, NoRejection>>, slot: usize) -> Option<Shared<Type>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return typeAt(value, slot)
    },
  )
}

effect fn typesEqual(first: Option<Shared<Type>>, second: Option<Shared<Type>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: from} = move first {
    if let Option<Shared<Type>>.Some {value: to} = move second {
      return run Type.equalsShared(&from, &to)
    }
  }
  return false
}

effect fn slotsEqual(answer: &Shared<Result<Answer, NoRejection>>, left: usize, right: usize) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run typesEqual(contractSlotOf(answer, left), contractSlotOf(answer, right))
}

effect fn answersEqual(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
  slot: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run typesEqual(slotOf(first, slot), slotOf(second, slot))
}

fn parameterCountOf(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length(&signature.parameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn lifetimeCountOf(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length(
        &signature.lifetimeParameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn signatureHasOrdinaryBinder(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        return binders.length == 1 && parameters.length == 1 && Shared.with<Type, bool>(
          &binders[usize.ZERO],
          isParameter,
        ) && Shared.with<Type, bool>(&parameters[usize.ZERO], isParameter) && Shared.with<
          Type,
          bool,
        >(&signature.result, isParameter)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn resultEquals(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run answersEqual(first, second, usize.MAX)
}

effect fn signatureReferencesAgree(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run slotsEqual(answer, usize.ZERO, usize.MAX)
}

effect fn signatureArgumentsAgree(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(answer, parameterCountOf) != 2 {
    return false
  }
  if !run slotsEqual(answer, usize.ZERO, usize.ONE) {
    return false
  }
  return run slotsEqual(answer, usize.ZERO, usize.MAX)
}

effect fn signatureArgumentsDiffer(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(answer, parameterCountOf) != 2 || Shared.with<
    Result<Answer, NoRejection>,
    usize,
  >(answer, lifetimeCountOf) != 2 {
    return false
  }
  return !run slotsEqual(answer, usize.ZERO, usize.ONE)
}

fn signatureSucceeded(answer: &Result<Answer, NoRejection>) -> bool {
  return match move signatureResult(answer) {
    Option<Shared<Type>>.Some {value: _} => true
    Option<Shared<Type>>.None => false
  }
}

fn rejectedTypeApplication(answer: &Result<Answer, NoRejection>, code: RejectionCode) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == code && found.span.end > found.span.start
      },
    )
  }
  return false
}

fn wrongTypeArity(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == RejectionCode.TypeArity && found.expected == 2 && found.supplied == 1 && found.span.end > found.span.start
      },
    )
  }
  return false
}

fn nameIsA(value: &Bytes) -> bool {
  let name = Bytes.asSlice(value)
  return name.length == 1 && name[usize.ZERO] == 65
}

fn isWrongTypeKind(found: &Rejection) -> bool {
  if found.code != RejectionCode.TypeArgumentKind || found.span.end <= found.span.start {
    return false
  }
  return nameIsA(&found.parameterName) && found.expectedKind == GenericKind.Type && found.suppliedKind == GenericKind.Lifetime
}

fn wrongTypeKind(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(&value, isWrongTypeKind)
  }
  return false
}

fn hasTypeLookup(answer: &Result<Answer, NoRejection>, expected: Family) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut at = usize.ZERO
      while at < dependencies.length {
        if dependencies[at].family == expected {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn nominalOwnedBy(resolved: &Type, module: &ModuleId) -> bool {
  return match & resolved.* {
    Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
    _ => false
  }
}

fn signatureOwnedBy(answer: &Shared<Result<Answer, NoRejection>>, module: &ModuleId) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(
      &value,
      fn(resolved: &Type) -> bool {
        return nominalOwnedBy(resolved, module)
      },
    )
  }
  return false
}

fn isI32(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 3 && bytes[0] == 105 && bytes[1] == 51 && bytes[2] == 50
    }
    _ => false
  }
}

fn signatureIsI32(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(&value, isI32)
  }
  return false
}

fn signatureIsBool(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(&value, isBool)
  }
  return false
}

fn importedSignatureHasDependencies(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut selected = false
      let mut namespace = false
      let mut publicName = false
      let mut alias = false
      let mut identity = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        let item = &dependencies[at]
        if item.family == Family.Import {
          match move Dependency.member(item) {
            Option<usize>.Some {value: ordinal} => {
              if ordinal == usize.ZERO {
                selected = true
              }
            }
            Option<usize>.None => {
              namespace = true
            }
          }
        }
        if item.family == Family.Name && item.external {
          publicName = true
        }
        if item.family == Family.Alias {
          alias = true
        }
        if item.family == Family.Identity {
          identity = true
        }
        at = at + usize.ONE
      }
      return selected && namespace && publicName && alias && identity
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn reads(events: &[SourceEvent], module: &ModuleId) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == SourceEventKind.SourceRead && ModuleId.equals(&events[at].module, module) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn starts(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn hits(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Hit && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn reused(events: &[SemanticEvent]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Reuse && events[at].family == Family.Body {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn bodyHasCurrentSource(answer: &Result<Answer, NoRejection>, revision: &Revision) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body: _, source}} => Shared.with<Observation, bool>(
        &source,
        fn(observed: &Observation) -> bool {
          return Observation.matches(observed, revision)
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option.some<Bytes>(run Bytes.copy(String.utf8Bytes(text)))
}

effect fn lazyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let missing = run module("missing.silk")
  let source = run present(
    "import missing as Ghost\ntype Broken = Unknown\nfn entry() -> i32 { return unknown() }\nfn missing(value: Ghost.Thing) -> i32 { return 0 }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let first = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(
    first.success && first.sources == 1,
    "written signature needs entry source only",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &missing,
    ) == 0,
    "unused import target stays unread",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 0,
    "unused import and bad alias stay undemanded",
  )
  let broken = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Broken")
  let rejected = Shared.with<Result<Answer, NoRejection>, AnswerView>(&broken, inspect)
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &broken,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      !rejected.success && Shared.with<Rejection, bool>(&value, isUnknownName) && rejected.dependencies > 0 && rejected.sources == 1,
      "demanded bad alias records negative name dependency",
    )
  } else {
    run Testing.expect(false, "demanded bad alias has a typed rejection")
  }
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let hit = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    hit.success && hit.sources == first.sources && reads(Semantic.sourceEvents(&semantic), &entry) == 1,
    "memo hit retains evidence without another source read",
  )
  let demanded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"missing")
  let missingDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &demanded,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move missingDiagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule),
      "demanded import target absence is anchored",
    )
  } else {
    run Testing.expect(false, "demanded missing import has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &missing) == 1,
    "missing target is read only on demand",
  )
  return ()
}

test effect fn defersUnusedDeclarationsAndReusesWrittenSignature() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lazyClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let librarySource = run present(
    "pub struct Thing { field: &'undeclared i32 }\npub type PublicAlias = Thing\n",
  )
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let entrySource = run present(
    "import library as Library { PublicAlias as Alias }\nfn entry(value: Alias) -> Library.Thing { return move value }\n",
  )
  let revision = run Revision.publish(&first, &entry, &entrySource)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(result.success, "imported alias resolves from written signature")
  run Testing.expect(result.dependencies > 0, "imported alias records nested demands")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&signature, importedSignatureHasDependencies),
    "signature keeps selected import ordinal, namespace, public name, alias, and identity edges",
  )
  run Testing.expect(result.sources == 2, "signature records each directly inspected source")
  let writtenResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move writtenResult {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isNominal),
      "alias result retains nominal identity",
    )
  } else {
    run Testing.expect(false, "signature has a written result")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "import target is read only when alias is used",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Identity) == 1,
    "hybrid namespace and selected alias share nominal identity",
  )
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let cached = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    cached.success && cached.dependencies == result.dependencies && cached.sources == result.sources,
    "imported signature memo hit keeps fact and dependency evidence",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "imported signature memo hit does not reread sources",
  )
  let priorSignatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let priorSignatureHits = hits(Semantic.eventLog(&semantic), Family.Signature)
  let mut fresh = Request.make()
  run Testing.expect(
    Request.rootCount(&fresh) == 0 && !Request.hasDiscovered(&fresh, &library),
    "fresh request has no inherited roots or discoveries",
  )
  let replayed = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && Request.rootCount(
      &fresh,
    ) == 1 && Request.hasRoot(&fresh, Family.Signature, &entry, b"entry") && Request.hasDiscovered(
      &fresh,
      &entry,
    ) && Request.hasDiscovered(&fresh, &library) && Request.hasDemand(
      &fresh,
      Family.Alias,
      &library,
    ) && Request.hasDemand(&fresh, Family.Identity, &library),
    "fresh request replays imported discovery and nested demand evidence",
  )
  run Testing.expect(
    priorSignatureStarts == starts(Semantic.eventLog(&semantic), Family.Signature) && hits(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == priorSignatureHits + 1 && reads(Semantic.sourceEvents(&semantic), &library) == 1,
    "replay emits only the actual root hit and no new provider read",
  )
  return ()
}

test effect fn resolvesImportedAliasWithoutFieldsOrBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// MODULE-STATIC-001/002: selected arm members belong to the module namespace, inactive ones are
// absent, and a failed condition admits neither arm.
effect fn moduleSelectionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let helper = run module("helper.silk")
  let missing = run module("missing.silk")
  let libraryText = """
static if true && true {
  import helper { Helped }
  pub fn helped(value: Helped) -> i32 { return 0 }
  pub param gated: bool
  pub struct Chosen {}
  impl Chosen {
    pub fn make() -> Chosen { return Chosen {} }
  }
  static if false {
    pub fn pick() -> bool { return true }
  } else {
    pub fn pick() -> i32 { return 1 }
  }
} else {
  import missing { Gone }
  pub struct Chosen {}
  pub struct Hidden {}
}
static if false {
  import helper { Helped as Twin }
} else {
  import helper { Helped as Twin }
}
pub fn twin(value: Twin) -> i32 { return 0 }
static if 7 {
  pub fn broken() -> i32 { return 0 }
}
static if cyclic() {
  pub static fn cyclic() -> bool { return true }
}
static if false {
  pub param hiddenParameter: bool
}
static if 7 {
  pub param brokenParameter: bool
}
"""
  let entryText = "import library { Chosen, Hidden }\nfn entry(value: Chosen) -> i32 { return 0 }\nfn hiddenUse(value: Hidden) -> i32 { return 0 }\n"
  let librarySource = run present(libraryText)
  let entrySource = run present(entryText)
  let helperSource = run present("pub struct Helped {}\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let second = run Revision.publish(&first, &helper, &helperSource)
  let revision = run Revision.publish(&second, &entry, &entrySource)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &library)
  let chosen = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let helped = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"helped")
  let twin = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"twin")
  let cyclic = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"cyclic")
  let gated = run Semantic.demandParameterSchema(&mut semantic, &mut request, &library, b"gated")
  let hiddenParameter = run Semantic.demandParameterSchema(&mut semantic, &mut request, &library, b"hiddenParameter")
  let brokenParameter = run Semantic.demandParameterSchema(&mut semantic, &mut request, &library, b"brokenParameter")
  let hidden = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"hiddenUse")
  let pick = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"pick")
  let make = run Semantic.demandInherentMember(&mut semantic, &mut request, &library, b"Chosen", b"make")
  let broken = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"broken")
  let picked = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&pick, signatureResult)
  let pickIsI32 = match &picked {
    Option<Shared<Type>>.Some {value} => Shared.with<Type, bool>(&value, isI32)
    Option<Shared<Type>>.None => false
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&chosen, inspect).success && pickIsI32,
    "an importer and the module see only the selected arm, including a nested else arm",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&make, inspect).success,
    "an impl in a selected arm publishes inherent members",
  )
  run Testing.expect(
    rejectsSpan(&hidden, RejectionCode.UnknownMember, entryText, "Hidden", usize.ZERO),
    "an inactive-only declaration is absent at its import",
  )
  run Testing.expect(
    rejectsSpan(&broken, RejectionCode.ConditionNotBool, libraryText, "7", usize.ZERO),
    "a non-bool condition admits neither arm and keeps its anchored rejection",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&helped, inspect).success && reads(
      Semantic.sourceEvents(&semantic),
      &missing,
    ) == 0,
    "a selected arm's import resolves while an inactive arm's import is never read",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&twin, inspect).success,
    "the same import in both arms survives through whichever arm is selected",
  )
  run Testing.expect(
    rejectsSpan(&cyclic, RejectionCode.Cycle, libraryText, "cyclic", usize.ONE) &&
      rejectsFrom(&gated, RejectionCode.ConditionalParameter, offsetOf(libraryText, "pub param gated", usize.ZERO)) &&
      rejectsFrom(&hiddenParameter, RejectionCode.ConditionalParameter, offsetOf(libraryText, "pub param hiddenParameter", usize.ZERO)) &&
      rejectsFrom(&brokenParameter, RejectionCode.ConditionalParameter, offsetOf(libraryText, "pub param brokenParameter", usize.ZERO)),
    "a condition using its own arm is a cycle, and any conditional package parameter is rejected before selection",
  )
  return ()
}

test effect fn moduleArmsSelectNativeDeclarations() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run moduleSelectionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// Answers for one condition's helpers must not depend on which demand reaches them first. Each
// order uses a fresh store.
effect fn conditionOrderClaims(conditionFirst: bool) -> bool
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch
? &mut Allocator {
  let library = run module("ordered.silk")
  let fast = run module("fast.silk")
  let librarySource = run present("""
static fn enabled() -> bool { return 1 == 1 }
static if enabled() {
  import fast { Engine }
  pub fn engine(value: Engine) -> i32 { return 0 }
}
""")
  let fastSource = run present("pub struct Engine {}\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let revision = run Revision.publish(&first, &fast, &fastSource)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  if conditionFirst {
    let armFirst = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"engine")
    let helperLater = run Semantic.demandBody(&mut semantic, &mut request, &library, b"enabled")
    return Shared.with<Result<Answer, NoRejection>, AnswerView>(&armFirst, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&helperLater, inspect).success
  }
  let enabled = run Semantic.demandBody(&mut semantic, &mut request, &library, b"enabled")
  let engine = run Semantic.demandSignature(&mut semantic, &mut request, &library, b"engine")
  return Shared.with<Result<Answer, NoRejection>, AnswerView>(&engine, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&enabled, inspect).success
}

test effect fn conditionOrderSelectNativeAnswers() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let conditionFirst = run conditionOrderClaims(true) |> Effect.provideMut<Allocator>(&mut allocator)
  let helperFirst = run conditionOrderClaims(false) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    conditionFirst && helperFirst,
    "a condition's helper and its arm answer the same whichever is demanded first",
  )
  return ()
}

effect fn cycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present(
    "type A = B\ntype B = A\nfn f() -> i32 { return g() }\nfn g() -> i32 { return f() }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let function = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"f")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&function, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1,
    "recursive bodies do not demand another signature",
  )
  let alias = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"A")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &alias,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "alias cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "alias cycle has a declaration path",
    )
  } else {
    run Testing.expect(false, "alias cycle has a typed rejection")
  }
  let other = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"B")
  let mut reversed = makeSemantic(move revision)
  let mut reversedRequest = Request.make()
  let reversedOther = run Semantic.demandAlias(&mut reversed, &mut reversedRequest, &entry, b"B")
  let reversedAlias = run Semantic.demandAlias(&mut reversed, &mut reversedRequest, &entry, b"A")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &alias,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return cycleAnchoredAt(answer, 9)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &other,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return cycleAnchoredAt(answer, 20)
      },
    ) && rotatedPair(&alias, &other) && sameCycleAnswers(&alias, &reversedAlias) && sameCycleAnswers(
      &other,
      &reversedOther,
    ),
    "each alias cycle member rejects at its own reference in either demand order",
  )
  return ()
}

test effect fn separatesSignatureRecursionFromAliasCycles() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn visibilityClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let text = """struct Hidden { field: i32 }
pub fn reveal() -> Hidden { return () }
type Clash = i32
struct Clash {}
pub type HiddenExact = typeof(reveal)
pub fn identity<T>(value: T) -> T { return value }
fn caller() -> i32 {
  let hidden = Hidden { field: 42 }
  let copied = identity(hidden)
  return copied.field
}
pub struct Box<T> { value: T }
impl<T> Box<T> {
  pub fn withMut<F: once fn(&mut T) -> ()>(self: &mut Self, use: F) -> () {
    use(&mut self.value)
    return ()
  }
}
fn touch(value: &mut Hidden) -> () { value.field = value.field + 1 return () }
fn privateBoundCaller() -> i32 {
  let mut boxed = Box<Hidden> { value: Hidden { field: 42 } }
  Box.withMut(&mut boxed, touch)
  return boxed.value.field
}
pub fn authoredPrivateCallback<F: once fn(&mut Hidden) -> ()>(use: F) -> () { drop use return () }
interface PrivateWitness { fn mark(self: &Self) -> () }
pub fn authoredPrivateInterface<T: PrivateWitness>(value: T) -> () { drop value return () }
"""
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let revealed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"reveal")
  let privateType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &revealed,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move privateType {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isPrivateExposure),
      "public written signature rejects private nominal type at its use",
    )
  } else {
    run Testing.expect(false, "private type exposure has a typed rejection")
  }
  let clash = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Clash")
  let collision = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &clash,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move collision {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCollision),
      "complete name bucket rejects collision without winner",
    )
  } else {
    run Testing.expect(false, "colliding name has a typed rejection")
  }
  let hiddenExact = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"HiddenExact")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &hiddenExact,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isPrivateExposure),
      "exact representations cannot bypass a rejected public callable signature",
    )
  } else {
    run Testing.expect(false, "exact representation has a typed rejection")
  }
  let caller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&caller, inspect).success,
    "a public generic instantiated with a caller-private record does not publish that record",
  )
  let boundCaller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"privateBoundCaller")
  let selected = run directApplicationAt(&boundCaller, usize.ZERO)
  let mut privateBound = false
  if let Option<SpecializationApplication>.Some {value: application} = move selected {
    let start = offsetOf(text, "Box.withMut(&mut boxed, touch)", usize.ZERO)
    let site = b"Box.withMut(&mut boxed, touch)"
    let signature = run Semantic.specializeSignature(&mut semantic, &mut request, &application, &entry,
      Span.make(start, start + site.length))
    privateBound = privateCallbackScope(&application)
      && Shared.with<Result<Answer, NoRejection>, bool>(&signature, privateCallbackBound)
  }
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&boundCaller, privateCallbackBodyPresent) && privateBound,
    "a public generic member's selected callback bound retains the caller-private type in its distinct impl scope and types the source call")
  let callback = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"authoredPrivateCallback")
  let interfaceBound = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"authoredPrivateInterface")
  run Testing.expect(rejectsSpan(&callback, RejectionCode.PrivateTypeExposure, text, "once fn(&mut Hidden) -> ()", usize.ZERO)
    && rejectsSpan(&interfaceBound, RejectionCode.PrivateTypeExposure, text, "PrivateWitness", usize.ONE),
    "authored public callback and interface bounds still reject their explicit private types at the exact bound syntax")
  return ()
}

fn privateCallbackBodyPresent(answer: &Result<Answer, NoRejection>) -> bool {
  return match move checkedBody(answer) { Option<Shared<TypedBody>>.Some {..} => true _ => false }
}

fn privateCallbackScope(value: &SpecializationApplication) -> bool {
  let member = SpecializationApplication.bodyDeclaration(value)
  if !DeclarationId.named(member, b"withMut") { return false }
  let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
  if scopes.length != usize.ONE || Shared.with<DeclarationId, bool>(&scopes[usize.ZERO].owner,
    fn(owner: &DeclarationId) -> bool { return DeclarationId.equals(owner, member) }) { return false }
  let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
  let ordinals = Vector.asSlice<usize>(&scopes[usize.ZERO].argumentOrdinals)
  if arguments.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO { return false }
  let privateScope = match &arguments[usize.ZERO] {
    Argument.Type {value: ty} => Shared.with<Type, bool>(&ty, privateHidden) _ => false }
  let own = Vector.asSlice<Argument>(&value.arguments)
  let ownOrdinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if !privateScope || own.length != ownOrdinals.length { return false }
  let mut at = usize.ZERO
  while at < own.length {
    if ownOrdinals[at] == usize.ZERO {
      return match &own[at] { Argument.Type {..} => true _ => false }
    }
    at = at + usize.ONE
  }
  return false
}

fn privateHidden(value: &Type) -> bool {
  return match &value.* { Type.Nominal {declaration, isPublic, arguments, ..} => !isPublic
    && DeclarationId.named(&declaration, b"Hidden") && Vector.length<Argument>(&arguments) == usize.ZERO _ => false }
}

fn privateMutableHiddenReference(value: &Type) -> bool {
  return match &value.* { Type.Reference {access, referent, ..} => access == Access.Mutable
    && Shared.with<Type, bool>(&referent, privateHidden) _ => false }
}

fn privateOnceHiddenContract(value: &Type) -> bool {
  if let Type.Callable {mode, parameters, ..} = &value.* {
    let inputs = Vector.asSlice<Shared<Type>>(&parameters)
    return mode == CallableMode.Once && inputs.length == usize.ONE
      && Shared.with<Type, bool>(&inputs[usize.ZERO], privateMutableHiddenReference)
  }
  return false
}

fn privateCallbackBound(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let bounds = Vector.asSlice<Constraint>(&signature.constraints)
      let mut at = usize.ZERO
      while at < bounds.length {
        if let Constraint.Represents {contract, ..} = &bounds[at] {
          let found = Shared.with<Type, bool>(&contract, privateOnceHiddenContract)
          if found { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn rejectsPrivateExposureAndCollisions() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run visibilityClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn namedCallableRepresentationsKeepExactIdentity() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("named-representations.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn first(value: i32) -> i32 { return value }\nfn second(value: i32) -> i32 { return value }\ntype First = typeof(first)\ntype FirstAgain = typeof(first)\ntype Second = typeof(second)\ntype Use = fn(i32) -> i32\npub type Leaked = typeof(first)\nfn generic<T>(value: T) -> T { return move value }\ntype Open = typeof(generic)\ntype Closed = typeof(generic<i32>)\nfn scoped<T>() -> typeof(generic<T>) { return () }\nservice Clock {}\nfn rowItem<?R>(value: i32) -> i32 { return value }\ntype RowOnce = typeof(rowItem<&Clock>)\ntype RowRepeated = typeof(rowItem<&Clock | &Clock>)\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let first = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"First")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let again = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"FirstAgain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Second")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let useContract = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Use")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let closed = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Closed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let scoped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"scoped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let open = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Open")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leaked = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Leaked")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rowOnce = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"RowOnce")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rowRepeated = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"RowRepeated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &first,
    nominalResult,
  )
  let againType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &again,
    nominalResult,
  )
  let secondType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &second,
    nominalResult,
  )
  let useType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &useContract,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: firstValue} = move firstType {
    if let Option<Shared<Type>>.Some {value: againValue} = move againType {
      if let Option<Shared<Type>>.Some {value: secondValue} = move secondType {
        let repeated = run Type.equalsShared(&firstValue, &againValue)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let distinct = run Type.equalsShared(&firstValue, &secondValue)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut separateUse = false
        if let Option<Shared<Type>>.Some {value: callableUse} = move useType {
          let sameUse = run Type.equalsShared(&firstValue, &callableUse)
            |> Effect.provideMut<Allocator>(&mut allocator)
          separateUse = !sameUse
        }
        run Testing.expect(Shared.with<Type, bool>(&firstValue, StaticValue.intrinsicallyForbidden),
          "canonical named callable values remain forbidden as source static data")
        run Testing.expect(
          repeated && !distinct && separateUse,
          "named items retain distinct exact identities despite identical callable signatures",
        )
      } else {
        run Testing.expect(false, "second item has an exact representation")
      }
    } else {
      run Testing.expect(false, "repeated item has an exact representation")
    }
  } else {
    run Testing.expect(false, "first item has an exact representation")
  }
  let normalizedRows = run typesEqual(
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&rowOnce, nominalResult),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &rowRepeated,
      nominalResult,
    ),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    normalizedRows && Shared.with<Result<Answer, NoRejection>, AnswerView>(&closed, inspect).success
      && rejectsSpan(&scoped, RejectionCode.InvalidExactRepresentation,
        text,
        "typeof(generic<T>)", usize.ZERO) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &open,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidExactRepresentation)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &leaked,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.PrivateTypeExposure)
      },
    ),
    "typeof normalizes row arguments, requires full specialization, and keeps private item identity inside its module",
  )
  return ()
}

test effect fn opaqueResultContractsKeepProducerFamiliesDistinct() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("opaque-results.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "fn make() -> some<F: fn<'static>(i32) -> i32> F { return () }\nfn other() -> some<F: fn<'static>(i32) -> i32> F { return () }\nfn nested() -> some<F: fn<'static>(i32) -> i32> Effect<'static; F> { return () }\nfn unused() -> some<F: fn<'static>(i32) -> i32> i32 { return 0 }\ninterface Maker { fn absent() -> some<F: fn<'static>(i32) -> i32> F }\nstruct Hidden {}\npub fn leak() -> some<F: fn<'static>(Hidden) -> i32> F { return () }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let made = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"make")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"other")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unused = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unused")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bodyless = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Maker", b"absent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leak = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"leak")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &made,
    signatureResult,
  )
  let otherType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &other,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: firstResult} = move firstType {
    if let Option<Shared<Type>>.Some {value: otherResult} = move otherType {
      let exact = Shared.with<Type, bool>(
        &firstResult,
        fn(ty: &Type) -> bool {
          return match & ty.* {
            Type.OpaqueRepresentation {..} => true
            _ => false
          }
        },
      )
      let sameFamily = run Type.equalsShared(&firstResult, &otherResult)
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(exact && !sameFamily, "each opaque producer owns a distinct representation")
    } else {
      run Testing.expect(false, "other producer has an opaque result contract")
    }
  } else {
    run Testing.expect(false, "first producer has an opaque result contract")
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&nested, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &unused,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidOpaqueResult)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &bodyless,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidOpaqueResult)
      },
    ),
    "an opaque binder may appear inside the result, but cannot be unused or bodyless",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &leak,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.PrivateTypeExposure)
      },
    ),
    "an opaque result cannot hide a private type in its public use contract",
  )
  return ()
}

// Hidden representation inputs and retained outer owners are part of the opaque family key.
test effect fn opaqueProducerApplicationsRetainCompleteHeaderEvidence() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueApplicationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueApplicationClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-applications.silk")
  let text = """
fn positive(value: i32) -> i32 { return value + 1 }
fn negative(value: i32) -> i32 { return value - 1 }
type Positive = typeof(positive)
type Negative = typeof(negative)
fn keep(callback: fn<'static>(i32) -> i32) -> some<F: fn<'static>(i32) -> i32> F { return positive }
fn phantom<'a>() -> some<F: fn<'static>(i32) -> i32> F { return positive }
struct Box<T> { value: T }
impl<T> Box<T> {
  fn wrap(callback: fn<'static>(T) -> T) -> some<F: fn<'static>(T) -> T> F { return fn(value: T) -> T { return move value } }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let keep = run Semantic.demandSignature(&mut store, &mut request, &id, b"keep")
  let phantom = run Semantic.demandSignature(&mut store, &mut request, &id, b"phantom")
  let scoped = run Semantic.demandInherentMember(&mut store, &mut request, &id, b"Box", b"wrap")
  let positive = run Semantic.demandAlias(&mut store, &mut request, &id, b"Positive")
  let negative = run Semantic.demandAlias(&mut store, &mut request, &id, b"Negative")
  let family = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&keep, signatureResult)
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&positive, nominalResult)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&negative, nominalResult)
  if let Option<Shared<Type>>.Some {value: source} = move family {
    if let Option<Shared<Type>>.Some {value: increment} = move first {
      if let Option<Shared<Type>>.Some {value: decrement} = move second {
        let firstFamily = run bindOpaqueArgument(&source, Argument.Type {value: move increment})
        let secondFamily = run bindOpaqueArgument(&source, Argument.Type {value: move decrement})
        let copy = run Shared.make<Type>(run Type.copy(&firstFamily))
        let copied = run Type.equalsShared(&copy, &firstFamily)
        let sameFamily = run Type.equalsShared(&firstFamily, &secondFamily)
        let distinctRuntime = run opaqueRuntimeDiffers(&firstFamily, &secondFamily)
        run Testing.expect(copied && !sameFamily && distinctRuntime,
          "opaque hidden representations distinguish equal-contract targets in semantic and runtime identity")
        run Testing.expect(run opaqueFormalOwnSlot(&source), "binding copies preserve the producer's symbolic hidden slot")
      } else { run Testing.expect(false, "the second exact target is available") }
    } else { run Testing.expect(false, "the first exact target is available") }
  } else { run Testing.expect(false, "the producer publishes its opaque family") }
  let lifetimeFamily = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&phantom, signatureResult)
  if let Option<Shared<Type>>.Some {value: source} = move lifetimeFamily {
    let app = match move Type.opaqueApplication(&source) {
      Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
      _ => { run Testing.expect(false, "the phantom lifetime retains an application") return () }
    }
    let local = run Shared.make<Lifetime>(Lifetime.Local {
      declaration: run DeclarationId.copy(SpecializationApplication.bodyDeclaration(&app)), ordinal: 7})
    let fixed = run bindOpaqueArgument(&source, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
    let borrowed = run bindOpaqueArgument(&source, Argument.Lifetime {value: move local})
    let sameFamily = run Type.equalsShared(&fixed, &borrowed)
    let distinctRuntime = run opaqueRuntimeDiffers(&fixed, &borrowed)
    run Testing.expect(!sameFamily && !distinctRuntime,
      "selected lifetimes distinguish semantic families while the runtime projection erases only validity")
  } else { run Testing.expect(false, "the unused written lifetime retains its producer schema") }
  let scopedFamily = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&scoped, signatureResult)
  if let Option<Shared<Type>>.Some {value: source} = move scopedFamily {
    run Testing.expect(run opaqueScopedSlots(&source),
      "the hidden own representation and retained impl T keep independent original owner slots")
  } else { run Testing.expect(false, "the inherent producer publishes its scoped family") }
}

effect fn opaqueRuntimeDiffers(first: &Shared<Type>, second: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let app = match move Type.opaqueApplication(first) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let owner = SpecializationApplication.bodyDeclaration(&app)
  let one = run Type.runtimeEncoding(first, owner)
  let two = run Type.runtimeEncoding(second, owner)
  return !sameBytes(Bytes.asSlice(&one), Bytes.asSlice(&two))
}

effect fn bindOpaqueArgument(source: &Shared<Type>, value: Argument) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let app = match move Type.opaqueApplication(source) {
    Option<Shared<SpecializationApplication>>.Some {value: selected} => run SpecializationApplication.copyShared(&selected)
    _ => { return Shared.clone<Type>(source) }
  }
  let indices = Vector.asSlice<usize>(&app.argumentOrdinals)
  if indices.length != usize.ONE { return Shared.clone<Type>(source) }
  let mut bindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut bindings, Binding {
    declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(SpecializationApplication.bodyDeclaration(&app))),
    ordinal: indices[usize.ZERO], value: move value})
  return run Type.applyBindings(source, Vector.asSlice<Binding>(&bindings), true)
}

effect fn opaqueFormalOwnSlot(source: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let app = match move Type.opaqueApplication(source) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let values = Vector.asSlice<Argument>(&app.arguments)
  let ordinals = Vector.asSlice<usize>(&app.argumentOrdinals)
  if values.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO { return false }
  if let Argument.Type {value} = &values[usize.ZERO] {
    return Shared.with<Type, usize>(&value, fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, SpecializationApplication.bodyDeclaration(&app))
    }) == usize.ZERO
  }
  return false
}

effect fn opaqueScopedSlots(source: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !run opaqueFormalOwnSlot(source) { return false }
  let app = match move Type.opaqueApplication(source) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let scopes = Vector.asSlice<ScopeBinding>(&app.scopes)
  if scopes.length != usize.ONE { return false }
  let scopeOwner = run DeclarationId.copyShared(&scopes[usize.ZERO].owner)
  let values = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
  let ordinals = Vector.asSlice<usize>(&scopes[usize.ZERO].argumentOrdinals)
  if values.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO
    || DeclarationId.equals(&scopeOwner, SpecializationApplication.bodyDeclaration(&app)) { return false }
  if let Argument.Type {value} = &values[usize.ZERO] {
    return Shared.with<Type, usize>(&value, fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, &scopeOwner)
    }) == usize.ZERO
  }
  return false
}

effect fn importCycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let firstModule = run module("first.silk")
  let secondModule = run module("second.silk")
  let firstSource = run present("pub import second { Alias }\n")
  let first = run Revision.publish(&Revision.make(), &firstModule, &firstSource)
  let secondSource = run present("pub import first { Alias }\n")
  let second = run Revision.publish(&first, &secondModule, &secondSource)
  let entrySource = run present("import first { Alias }\nfn entry() -> Alias { return () }\n")
  let entered = run Revision.publish(&second, &entry, &entrySource)
  let otherModule = run module("other.silk")
  let otherSource = run present("import second { Alias }\nfn other() -> Alias { return () }\n")
  let revision = run Revision.publish(&entered, &otherModule, &otherSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "public import-name cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "public import-name cycle has a declaration path",
    )
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, importCycleAnchor),
      "public import-name cycle is anchored",
    )
  } else {
    run Testing.expect(false, "public import-name cycle has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &firstModule) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &secondModule,
    ) == 1,
    "import-name cycle opens each target once",
  )
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &otherModule, b"other")
  let mut reversed = makeSemantic(move revision)
  let mut reversedRequest = Request.make()
  let reversedOther = run Semantic.demandSignature(
    &mut reversed,
    &mut reversedRequest,
    &otherModule,
    b"other",
  )
  let reversedEntry = run Semantic.demandSignature(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"entry",
  )
  run Testing.expect(
    rotatedPair(&signature, &other) && sameCycleAnswers(&signature, &reversedEntry) && sameCycleAnswers(
      &other,
      &reversedOther,
    ),
    "consumers entering an import-name cycle at either member agree in either demand order",
  )
  return ()
}

test effect fn rejectsPublicImportNameCycle() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importCycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn revisionReuseClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let unrelated = run module("unrelated.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let b = run present("pub type Alias = i32\n")
  let first = run Revision.publish(&Revision.make(), &entry, &a)
  let held = run Revision.publish(&first, &library, &b)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut coldRequest = Request.make()
  let cold = run Semantic.demandSignature(&mut semantic, &mut coldRequest, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&cold, inspect).success && Request.hasDiscovered(
      &coldRequest,
      &library,
    ),
    "cold signature discovers its imported alias source",
  )
  let startsBefore = starts(Semantic.eventLog(&semantic), Family.Signature)
  let c = run present("fn changed() -> i32 { return 3 }\n")
  let irrelevant = run Revision.publish(&held, &unrelated, &c)
  Semantic.revise(&mut semantic, move irrelevant)
  let mut fresh = Request.make()
  let warm = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&warm, inspect).success && Request.hasDiscovered(
      &fresh,
      &library,
    ) && !Request.hasDiscovered(&fresh, &unrelated) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == startsBefore && hits(Semantic.eventLog(&semantic), Family.Signature) == 1,
    "unrelated revision keeps the completed signature and replays only its discoveries",
  )
  let changed = run present("pub type Alias = bool\n")
  let relevant = run Revision.publish(&held, &library, &changed)
  Semantic.revise(&mut semantic, move relevant)
  let mut revised = Request.make()
  let updated = run Semantic.demandSignature(&mut semantic, &mut revised, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &updated,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isBool) && starts(
        Semantic.eventLog(&semantic),
        Family.Signature,
      ) == startsBefore + 1,
      "changed imported alias header recomputes the transitive signature",
    )
  } else {
    run Testing.expect(false, "recomputed signature has a written result")
  }
  return ()
}

test effect fn reusesUnrelatedRevisionAndInvalidatesImportedHeader() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run revisionReuseClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn negativeRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let held = run Revision.publish(&Revision.make(), &entry, &a)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut firstRequest = Request.make()
  let missing = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &entry, b"entry")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &missing,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule) && !Request.hasDiscovered(
        &firstRequest,
        &library,
      ),
      "absent imported path records a typed rejection without a present discovery",
    )
  } else {
    run Testing.expect(false, "absent imported path rejects")
  }
  let b = run present("pub type Other = i32\n")
  let appeared = run Revision.publish(&held, &library, &b)
  Semantic.revise(&mut semantic, move appeared)
  let mut secondRequest = Request.make()
  let missingName = run Semantic.demandSignature(
    &mut semantic,
    &mut secondRequest,
    &entry,
    b"entry",
  )
  let nameDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &missingName,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move nameDiagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isUnknownMember) && Request.hasDiscovered(
        &secondRequest,
        &library,
      ),
      "formerly absent path is discovered and its absent-name bucket rejects",
    )
  } else {
    run Testing.expect(false, "present imported module with absent name rejects")
  }
  let named = run present("pub type Other = i32\npub type Alias = bool\n")
  let namedRevision = run Revision.publish(&held, &library, &named)
  Semantic.revise(&mut semantic, move namedRevision)
  let mut namedRequest = Request.make()
  let resolved = run Semantic.demandSignature(&mut semantic, &mut namedRequest, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &resolved,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isBool) && Request.hasDiscovered(&namedRequest, &library),
      "new imported name invalidates the transitive negative bucket",
    )
  } else {
    run Testing.expect(false, "new imported name resolves")
  }
  let shifted = run present(
    "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
  )
  let absentAgain = run Revision.publish(&held, &entry, &shifted)
  Semantic.revise(&mut semantic, move absentAgain)
  let mut shiftedRequest = Request.make()
  let newFailure = run Semantic.demandSignature(
    &mut semantic,
    &mut shiftedRequest,
    &entry,
    b"entry",
  )
  let anchored = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &newFailure,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move anchored {
    let offset = Shared.with<Rejection, usize>(&value, spanStart)
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule) && offset == 17 && String.utf8Bytes(
        "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
      )[offset] == 108,
      "recomputed rejection span points into exact changed entry bytes",
    )
  } else {
    run Testing.expect(false, "changed entry bytes produce a new anchored rejection")
  }
  return ()
}

test effect fn invalidatesNegativePathAndNameAndReanchorsDiagnostic() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run negativeRevisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedFailureRetryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let entrySource = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
    |> Effect.provideMut<Allocator>(&mut system)
  let libraryText = "pub type Alias = bool\n// This unique source allocation is rejected inside the nested import.\n"
  let librarySource = run present(libraryText)
    |> Effect.provideMut<Allocator>(&mut system)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let revision = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut semantic = makeSemantic(move revision)
  let mut failedRequest = Request.make()
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(libraryText).length,
    rejected: false,
  }
  let attempted = run Effect.result(
    Semantic.demandSignature(&mut semantic, &mut failedRequest, &entry, b"entry"),
  )
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Success {value: ignored} => false
  }
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Import) > 0,
    "nested imported-signature provider failure publishes no root",
  )
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandSignature(&mut semantic, &mut retriedRequest, &entry, b"entry")
    |> Effect.provideMut<Allocator>(&mut system)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&retried, inspect).success && Request.rootCount(
      &retriedRequest,
    ) == 1 && Request.hasDiscovered(&retriedRequest, &library) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 2,
    "retry recomputes the same signature and publishes complete imported evidence",
  )
  return ()
}

test effect fn retriesNestedImportedSignatureAfterTypedFailure() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  return run nestedFailureRetryClaims()
}

test effect fn canonicalTypeIdentityKeepsNominalOwners() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let left = run module("left.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run module("right.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leftSource = run present(
    "struct Item {}\ntype Alias = Item\nfn original() -> Item { return () }\nfn aliased() -> Alias { return () }\nfn count() -> i32 { return 1 }\nfn flag() -> bool { return true }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rightSource = run present("struct Item {}\nfn original() -> Item { return () }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &left, &leftSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &right, &rightSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move held)
  let mut request = Request.make()
  let original = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"original")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliased = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"aliased")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &right, b"original")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let count = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"count")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let flag = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"flag")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    signatureOwnedBy(&original, &left) && signatureOwnedBy(&aliased, &left) && !signatureOwnedBy(
      &other,
      &left,
    ) && signatureOwnedBy(&other, &right) && signatureIsI32(&count) && signatureIsBool(&flag),
    "source signatures keep nominal module owners and distinct scalar kinds",
  )
  return ()
}

fn onSignature(answer: &Result<Answer, NoRejection>, check: fn(&Signature) -> bool) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => check(&signature)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn rowsEqual(left: &Shared<Row>, right: &Shared<Row>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run Row.equalsShared(left, right)
}

fn rowSize(row: &Shared<Row>) -> usize {
  return Shared.with<Row, usize>(
    row,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries) + Vector.length(&value.parameters)
    },
  )
}

fn failureOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&signature.failure),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn requirementsOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Row>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Row>>(
        Shared.clone<Row>(&signature.requirements),
      )
      _ => Option.none<Shared<Row>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Row>>()
  }
}

effect fn channelsEqual(
  failure: Option<Shared<Type>>,
  requirements: Option<Shared<Row>>,
  otherFailure: Option<Shared<Type>>,
  otherRequirements: Option<Shared<Row>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !run typesEqual(move failure, move otherFailure) {
    return false
  }
  if let Option<Shared<Row>>.Some {value: row} = move requirements {
    if let Option<Shared<Row>>.Some {value: otherRow} = move otherRequirements {
      return run rowsEqual(&row, &otherRow)
    }
  }
  return false
}

effect fn sameChannels(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run channelsEqual(
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(first, failureOf),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(first, requirementsOf),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(second, failureOf),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(second, requirementsOf),
  )
}

fn effectFailure(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Effect {failure, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&failure))
    _ => Option.none<Shared<Type>>()
  }
}

fn effectSuccess(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Effect {success, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&success))
    _ => Option.none<Shared<Type>>()
  }
}

fn effectRequirements(value: &Type) -> Option<Shared<Row>> {
  return match & value.* {
    Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements))
    _ => Option.none<Shared<Row>>()
  }
}

fn effectEnvironment(value: &Type) -> Option<Shared<Intersection>> {
  return match & value.* {
    Type.Effect {environment, ..} => Option.some<Shared<Intersection>>(
      Shared.clone<Intersection>(&environment),
    )
    _ => Option.none<Shared<Intersection>>()
  }
}

// A written `Effect<...>` parameter has the channels of the declared effect function.
effect fn pendingMatches(
  pending: &Shared<Result<Answer, NoRejection>>,
  declared: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let parameter = contractSlotOf(pending, usize.ZERO)
  if let Option<Shared<Type>>.Some {value} = move parameter {
    return run channelsEqual(
      Shared.with<Type, Option<Shared<Type>>>(&value, effectFailure),
      Shared.with<Type, Option<Shared<Row>>>(&value, effectRequirements),
      Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(declared, failureOf),
      Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(declared, requirementsOf),
    )
  }
  return false
}

fn modeOf(value: &Type) -> usize {
  let mode = match & value.* {
    Type.Callable {mode, ..} => mode
    Type.Effect {mode, ..} => mode
    _ => {
      return usize.ZERO
    }
  }
  return match mode {
    CallableMode.Shared => usize.ONE
    CallableMode.Mutable => 2
    CallableMode.Once => 3
  }
}

fn firstParameterMode(signature: &Signature) -> usize {
  if let Option<Shared<Type>>.Some {value} = move parameterContractAt(signature, usize.ZERO) {
    return Shared.with<Type, usize>(&value, modeOf)
  }
  return usize.ZERO
}

fn firstModeIs(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return firstParameterMode(signature) == expected
    },
  )
}

fn environmentWith(first: &Intersection, right: &Shared<Intersection>) -> bool {
  return Shared.with<Intersection, bool>(
    right,
    fn(second: &Intersection) -> bool {
      return Intersection.equals(first, second)
    },
  )
}

// The consumed and returned Effects hold distinct environment handles.
fn environmentsEqual(left: &Shared<Intersection>, right: &Shared<Intersection>) -> bool {
  return Shared.with<Intersection, bool>(
    left,
    fn(first: &Intersection) -> bool {
      return environmentWith(first, right)
    },
  )
}

fn rowBinderAndConsumed(signature: &Signature) -> bool {
  return Vector.length(&signature.rowParameters) == usize.ONE && firstParameterMode(signature) == 3
}

effect fn environmentsSame(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let first = Shared.with<Type, Option<Shared<Intersection>>>(left, effectEnvironment)
  let second = Shared.with<Type, Option<Shared<Intersection>>>(right, effectEnvironment)
  if let Option<Shared<Intersection>>.Some {value: from} = move first {
    if let Option<Shared<Intersection>>.Some {value: to} = move second {
      return environmentsEqual(&from, &to)
    }
  }
  return false
}

// Mode aside, the consumed parameter and the returned Effect share environment and channels.
effect fn sharesEffectParts(input: &Shared<Type>, output: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if !run environmentsSame(input, output) {
    return false
  }
  let success = Shared.with<Type, Option<Shared<Type>>>(input, effectSuccess)
  let otherSuccess = Shared.with<Type, Option<Shared<Type>>>(output, effectSuccess)
  if !run typesEqual(move success, move otherSuccess) {
    return false
  }
  let row = Shared.with<Type, Option<Shared<Row>>>(input, effectRequirements)
  if let Option<Shared<Row>>.Some {value: requirements} = &row {
    if rowSize(&requirements) != usize.ONE {
      return false
    }
  }
  if !run channelsEqual(
    Shared.with<Type, Option<Shared<Type>>>(input, effectFailure),
    move row,
    Shared.with<Type, Option<Shared<Type>>>(output, effectFailure),
    Shared.with<Type, Option<Shared<Row>>>(output, effectRequirements),
  ) {
    return false
  }
  return !run Type.equalsShared(input, output)
}

fn firstParameterOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[usize.ZERO]))
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

// An Effect parameter is an exact representation slot; its bound keeps the written contract.
fn firstContractOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome { return parameterContractAt(&signature, usize.ZERO) }
  }
  return Option.none<Shared<Type>>()
}

fn unionSize(value: &Type) -> usize {
  return match & value.* {
    Type.Union {members} => Vector.length<Shared<Type>>(&members)
    _ => usize.ZERO
  }
}

fn effectRowSize(value: &Type) -> usize {
  return match & value.* {
    Type.Effect {requirements, ..} => rowSize(&requirements)
    _ => usize.ZERO
  }
}

// `Pair<Box<i32>>` places one `Box<i32>` handle both as a union member and inside `Box<Box<i32>>`;
// `Stored` does the same inside two generic service keys.
effect fn substitutedShapes(
  control: &Shared<Result<Answer, NoRejection>>,
  nested: &Shared<Result<Answer, NoRejection>>,
  again: &Shared<Result<Answer, NoRejection>>,
  stored: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    control,
    firstParameterOf,
  )
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    nested,
    firstParameterOf,
  )
  let third = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    again,
    firstParameterOf,
  )
  let fourth = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    stored,
    firstContractOf,
  )
  if let Option<Shared<Type>>.Some {value: plain} = move first {
    if let Option<Shared<Type>>.Some {value: boxed} = move second {
      if let Option<Shared<Type>>.Some {value: repeated} = move third {
        if let Option<Shared<Type>>.Some {value: effectType} = move fourth {
          let distinct = !run Type.equalsShared(&plain, &boxed)
          let same = run Type.equalsShared(&boxed, &repeated)
          return Shared.with<Type, usize>(&plain, unionSize) == 2 && Shared.with<Type, usize>(
            &boxed,
            unionSize,
          ) == 2 && distinct && same && Shared.with<Type, usize>(&effectType, effectRowSize) == 2
        }
      }
    }
  }
  return false
}

fn rejectsAt(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return rejectedTypeApplication(value, code)
    },
  )
}

// A rejection with `code` whatever its anchor, as for an identity with no written site left.
fn rejectsWith(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code
      },
    )
  }
  return false
}

// Elided and spelled invocation binders give the same callable contract across declarations.
effect fn sameFirstParameters(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run typesEqual(contractSlotOf(left, usize.ZERO), contractSlotOf(right, usize.ZERO)
)
}

// `'a & 'b` equals `'b & 'static & 'a`; `'a & 'a` equals `'a` and differs from the pair.
effect fn environmentsNormalize(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(answer, parameterCountOf) != 4 {
    return false
  }
  let pair = run slotsEqual(answer, usize.ZERO, usize.ONE)
  let single = run slotsEqual(answer, 2, 3)
  let different = !run slotsEqual(answer, usize.ZERO, 3)
  return pair && single && different
}

fn writtenEnvironment(signature: &Signature) -> bool {
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  let contents = declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Contents {..} => true
    _ => false
  }
  return contents && match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members) == usize.ONE
    Option<Intersection>.None => false
  }
}

fn retainsEnvironment(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, writtenEnvironment)
}

fn representationBound(signature: &Signature) -> bool {
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Represents {contract, ..} => Shared.with<Type, usize>(&contract, modeOf) == usize.ONE
    _ => false
  }
}

fn representsCallable(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, representationBound)
}

fn onContract(answer: &Result<Answer, NoRejection>, check: fn(&Contract) -> bool) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => check(&contract)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn conformsOnly(contract: &Contract) -> bool {
  let declared = Vector.asSlice<Constraint>(&contract.constraints)
  return Vector.length(&contract.typeParameters) == usize.ONE && declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Conforms {..} => true
    _ => false
  }
}

fn sortedContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, conformsOnly)
}

fn generatedBoundLifetime(contract: &Contract) -> bool {
  let constraints = Vector.asSlice<Constraint>(&contract.constraints)
  return Vector.length<Shared<Type>>(&contract.typeParameters) == usize.ONE && Vector.length<Shared<Lifetime>>(
    &contract.lifetimeParameters,
  ) == usize.ONE && constraints.length == usize.ONE && match & constraints[usize.ZERO] {
    Constraint.Conforms {..} => true
    _ => false
  }
}

fn datedBoxContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, generatedBoundLifetime)
}

fn rowBinderOnly(contract: &Contract) -> bool {
  return Vector.length(&contract.rowParameters) == usize.ONE && Vector.length(
    &contract.typeParameters,
  ) == usize.ONE && Vector.length(&contract.constraints) == usize.ZERO
}

fn loadContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, rowBinderOnly)
}

fn representationOnly(contract: &Contract) -> bool {
  let declared = Vector.asSlice<Constraint>(&contract.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Represents {..} => true
    _ => false
  }
}

fn parserContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, representationOnly)
}

// `Loaded<? &Clock>` splices the supplied row beside the alias's own `&Logger` entry.
fn splicedRow(answer: &Result<Answer, NoRejection>) -> bool {
  let parameter = firstContractOf(answer)
  if let Option<Shared<Type>>.Some {value} = move parameter {
    return Shared.with<Type, usize>(&value, effectRowSize) == 2
  }
  return false
}

effect fn sameResults(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run answersEqual(left, right, usize.MAX)
}

fn environmentSizeOf(signature: &Signature) -> usize {
  return match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members)
    Option<Intersection>.None => usize.MAX
  }
}

fn environmentMembers(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => environmentSizeOf(&signature)
      _ => usize.MAX - usize.ONE
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX - usize.ONE
  }
}

fn staticSignatureEnvironment(signature: &Signature) -> bool {
  return match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members) == usize.ZERO
    Option<Intersection>.None => false
  }
}

fn staticEnvironment(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, staticSignatureEnvironment)
}

fn contentsOnly(contract: &Contract) -> bool {
  let declared = Vector.asSlice<Constraint>(&contract.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Contents {..} => true
    _ => false
  }
}

fn lifetimeBoundOnly(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, contentsOnly)
}

fn constraintCount(contract: &Contract) -> usize {
  return Vector.length(&contract.constraints)
}

fn contractConstraints(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => constraintCount(&contract)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

effect fn preserved(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let shape = Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return onSignature(value, rowBinderAndConsumed)
    },
  )
  // An Effect parameter is an exact representation slot whose bound keeps the written contract.
  let input = contractSlotOf(answer, usize.ZERO)
  let output = slotOf(answer, usize.MAX)
  if let Option<Shared<Type>>.Some {value: from} = move input {
    if let Option<Shared<Type>>.Some {value: to} = move output {
      return shape && run sharesEffectParts(&from, &to)
    }
  }
  return false
}

fn declaredEffect(answer: &Result<Answer, NoRejection>) -> bool {
  return hasTypeLookup(answer, Family.Identity) && onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return signature.isEffect && rowSize(&signature.requirements) == usize.ONE && Shared.with<
        Type,
        bool,
      >(&signature.failure, isNominal)
    },
  )
}

fn rowCountIs(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return rowSize(&signature.requirements) == expected
    },
  )
}

fn unsafeOrdinary(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return signature.isUnsafe && !signature.isEffect
    },
  )
}

fn constraintOrder(signature: &Signature) -> bool {
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  if declared.length != 4 {
    return false
  }
  let outlives = match & declared[usize.ZERO] {
    Constraint.Outlives {..} => true
    _ => false
  }
  let hash = match & declared[usize.ONE] {
    Constraint.Conforms {contract, ..} => Shared.with<Type, bool>(&contract, isNominal)
    _ => false
  }
  let logger = match & declared[2] {
    Constraint.Conforms {..} => true
    _ => false
  }
  let contents = match & declared[3] {
    Constraint.Contents {..} => true
    _ => false
  }
  return outlives && hash && logger && contents
}

// Give each independent contract claim only the declarations it needs to resolve.
fn contractFixture(part: usize) -> string<'static> {
  if part == 0 {
    return "import services { Clock }\nservice Logger {}\ninterface Hash {}\nstruct Problem {}\nstruct Other {}\nrole Primary\nfn apply(transform: fn(i32) -> i32, value: i32) -> i32 { return value }\nfn consume(transform: once fn(i32) -> i32) -> i32 { return 0 }\neffect fn load(id: i32) -> i32 ! Problem ? &Clock { return id }\neffect fn both() -> i32 ! Problem | Other ? &Logger | &Clock at Primary | &mut Clock at Primary | &Clock { return 0 }\neffect fn swapped() -> i32 ! Other | Problem | Other ? &mut Clock at Primary | &Clock | &Logger { return 0 }\neffect fn closed() -> i32 { return 0 }\neffect fn spelled() -> i32 ! never ? never { return 0 }\nfn pending(value: Effect<i32 ! Problem ? &Clock>) -> i32 { return 0 }\nfn preserve<'env, A, ?R>(pending: once Effect<'env; A ? R>) -> Effect<'env; A ? R> { return move pending }\nfn bounded<'long: 'short, 'short, T: Hash + Logger + 'short>(value: &'long T) -> &'short i32 { return () }\nunsafe fn risky() -> i32 { return 1 }\nstruct Box<T> { value: T }\ntype Pair<T> = T | Box<T>\nfn control(value: Pair<i32>) -> i32 { return 0 }\nfn nested(value: Pair<Box<i32>>) -> i32 { return 0 }\nfn again(value: Pair<Box<i32>>) -> i32 { return 0 }\nservice Store<T> {}\ntype Stored<'env, T> = Effect<'env; i32 ? &Store<T> | &Store<Box<T>>>\nfn stored<'a>(value: Stored<'a, Box<i32>>) -> i32 { return 0 }\n"
  }
  if part == 1 {
    return "import services { Clock }\nservice Logger {}\ninterface Hash {}\nstruct Plain {}\nstruct Problem {}\nstruct Other {}\nrole Primary\ntype Borrowed = &'static i32\neffect fn notService() -> i32 ? &Plain { return 0 }\neffect fn interfaceRow() -> i32 ? &Hash { return 0 }\neffect fn badRole() -> i32 ? &Clock at Plain { return 0 }\nfn notBound<T: Plain>() -> i32 { return 0 }\nfn repeated<T: Hash + Hash>() -> i32 { return 0 }\nfn ordinaryFailure() -> i32 ! Problem { return 0 }\nfn rowAsType<?R>(value: R) -> i32 { return 0 }\nfn borrowedUnion() -> Borrowed | i32 { return 0 }\nfn ambiguousCallable(transform: fn<'static>(&i32, &i32) -> &i32) -> i32 { return 0 }\nfn nestedQuantifier(transform: for<'a> fn<'static>(for<'b> fn<'static>(&'b i32) -> i32) -> i32) -> i32 { return 0 }\nfn ordinaryRow() -> i32 ? &Clock { return 0 }\npub fn exposedCallable(transform: fn(Plain) -> i32) -> i32 { return 0 }\npub effect fn exposedRow() -> i32 ? &Logger { return 0 }\n"
  }
  if part == 2 {
    return "fn closedEffect() -> Effect<i32> { return () }\nfn explicitStatic() -> Effect<'static; i32> { return () }\nfn inputEffect(value: i32) -> Effect<i32> { return () }\neffect fn closedDeferred() -> i32 { return 0 }\neffect fn inputDeferred(value: i32) -> i32 { return value }\neffect fn sameRegion<'a>(left: &'a i32, right: &'a i32, count: i32) -> i32 { return count }\neffect fn heldDeferred<'a>(value: Held<'a, i32>) -> i32 { return 0 }\nfn genericEffect<T>(value: T) -> Effect<i32> { return () }\nfn twoBorrowEffect(left: &i32, right: &i32) -> Effect<i32> { return () }\nfn heldEffect(value: Held<'static, i32>, count: i32) -> Effect<i32> { return () }\nstruct Held<'a, T: 'a> { value: &'a T }\n"
  }
  if part == 3 {
    return "interface Hash {}\neffect fn sameRegion<'a>(left: &'a i32, right: &'a i32, count: i32) -> i32 { return count }\neffect fn heldDeferred<'a>(value: Held<'a, i32>) -> i32 { return 0 }\neffect fn runPending<A, E>(pending: once Effect<'static; A ! E>) -> i32 { return 0 }\neffect fn callbackDeferred<A>(callback: fn<'static>(A) -> A) -> i32 { return 0 }\neffect fn keepPending<A>(pending: once Effect<A>) -> i32 { return 0 }\nfn heldOpenEffect<'a>(value: Held<'a, i32>) -> Effect<i32> { return () }\nfn nestedStatic() -> Effect<'static; Effect<i32>> { return () }\neffect fn representedBorrowed<'a, F: fn<'a>(i32) -> i32>(callback: F) -> i32 { return 0 }\neffect fn representedStatic<A, F: once Effect<'static; A>>(pending: F) -> i32 { return 0 }\neffect fn conformedStored<T: Hash>(value: T) -> i32 { return 0 }\neffect fn effectSuccess() -> Effect<i32> { return () }\neffect fn effectSuccessStatic() -> Effect<'static; i32> { return () }\neffect fn borrowedDeferred(value: &i32, count: i32) -> i32 { return count }\neffect fn twoBorrowed(left: &i32, right: &i32) -> i32 { return 0 }\neffect fn genericDeferred<Kept>(value: &i32, stored: Kept) -> i32 { return 0 }\nstruct Held<'a, T: 'a> { value: &'a T }\n"
  }
  if part == 4 {
    return "fn orderedA(transform: for<'a, 'b> fn<'static>(Effect<'a & 'b; i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn orderedB(transform: for<'a, 'b> fn<'static>(Effect<'b & 'a; i32>, &'a i32) -> i32) -> i32 { return 0 }\nstruct HolderA<'x> { v: &'x i32 }\nstruct HolderB<'x> { v: &'x i32 }\nfn unionAB(transform: for<'a, 'b> fn<'static>(HolderA<'a> | HolderB<'b>) -> i32) -> i32 { return 0 }\nfn unionBA(transform: for<'a, 'b> fn<'static>(HolderB<'b> | HolderA<'a>) -> i32) -> i32 { return 0 }\nfn unionShared(transform: for<'a> fn<'static>(HolderA<'a> | HolderB<'a>) -> i32) -> i32 { return 0 }\nservice SA<'x> {}\nservice SB<'x> {}\nfn rowAB(transform: for<'a, 'b> fn<'static>(Effect<'static; i32 ? &SA<'a> | &SB<'b>>) -> i32) -> i32 { return 0 }\nfn rowBA(transform: for<'a, 'b> fn<'static>(Effect<'static; i32 ? &SB<'b> | &SA<'a>>) -> i32) -> i32 { return 0 }\nfn overlapAB(transform: for<'a, 'b, 'c> fn<'static>(Effect<'a & 'b; i32>, Effect<'a & 'c; i32>) -> i32) -> i32 { return 0 }\nfn overlapBA(transform: for<'a, 'b, 'c> fn<'static>(Effect<'b & 'a; i32>, Effect<'a & 'c; i32>) -> i32) -> i32 { return 0 }\nfn overlapApart(transform: for<'a, 'b, 'c> fn<'static>(Effect<'a & 'b; i32>, Effect<'c; i32>) -> i32) -> i32 { return 0 }\nfn orderedSingle(transform: for<'a> fn<'static>(Effect<'a; i32>, &'a i32) -> i32) -> i32 { return 0 }\n"
  }
  if part == 5 {
    return "fn nestedRef(transform: for<'a> fn<'static>(fn<'static>(&'a i32) -> i32) -> i32) -> i32 { return 0 }\nfn nestedRefAgain(transform: for<'z> fn<'static>(fn<'static>(&'z i32) -> i32) -> i32) -> i32 { return 0 }\nfn nestedFirst(transform: for<'a, 'b> fn<'static>(fn<'static>(&'a i32) -> i32, &'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn nestedFirstRenamed(transform: for<'x, 'y> fn<'static>(fn<'static>(&'x i32) -> i32, &'x i32, &'y i32) -> i32) -> i32 { return 0 }\nfn nestedSecond(transform: for<'a, 'b> fn<'static>(fn<'static>(&'b i32) -> i32, &'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn nestedUnion(transform: for<'a, 'b> fn<'static>(Box<fn<'static>(&'b i32) -> i32> | Box<fn<'static>(&'a i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn nestedUnionSwapped(transform: for<'a, 'b> fn<'static>(Box<fn<'static>(&'a i32) -> i32> | Box<fn<'static>(&'b i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn nestedUnionOne(transform: for<'a> fn<'static>(Box<fn<'static>(&'a i32) -> i32> | Box<fn<'static>(&'a i32, &'a i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn mixedBinders(transform: for<'a> fn<'static>(&i32, &'a i32) -> i32) -> i32 { return 0 }\nfn elidedBinders(transform: fn<'static>(&i32, &i32) -> i32) -> i32 { return 0 }\nfn permutedBinders(transform: for<'b, 'a> fn<'static>(&'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn unusedBinder(transform: for<'a> fn<'static>(i32) -> i32) -> i32 { return 0 }\nfn plainCallable(transform: fn<'static>(i32) -> i32) -> i32 { return 0 }\nfn boundedBinders(transform: for<'a: 'b, 'b> fn<'static>(&'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn swappedBound(transform: for<'y, 'x: 'y> fn<'static>(&'x i32, &'y i32) -> i32) -> i32 { return 0 }\nstruct Box<T> { value: T }\n"
  }
  if part == 6 {
    return "import services { Clock }\nservice Logger {}\ninterface Hash {}\nstruct Problem {}\nfn quantified(transform: fn<'static>(&i32) -> &i32) -> i32 { return 0 }\nfn spelledQuantifier(transform: for<'call> fn<'static>(&'call i32) -> &'call i32) -> i32 { return 0 }\nfn environments<'a, 'b>(first: Effect<'a & 'b; i32>, second: Effect<'b & 'static & 'a; i32>, third: Effect<'a & 'a; i32>, fourth: Effect<'a; i32>) -> i32 { return 0 }\neffect<'env> fn retain<T: 'env, 'env>(value: T) -> i32 { return 0 }\nfn parse<F: fn(i32) -> i32>(parser: F) -> i32 { return 0 }\nstruct Sorted<T: Hash> { value: T }\ninterface Dated<'a> {}\nstruct DatedBox<T: Dated> { value: T }\nfn useSorted(value: Sorted<i32>) -> i32 { return 0 }\ninterface Load<E, ?R> {}\nfn loadable<T: Load<Problem ? &Clock>>(source: &T) -> i32 { return 0 }\nfn wrongRow<T: Load<Problem>>(source: &T) -> i32 { return 0 }\nstruct Parser<F: fn<'static>(i32) -> i32> { parse: F }\ntype Loaded<?R> = Effect<'static; i32 ? &Logger | R>\nfn loaded(value: Loaded<? &Clock>) -> i32 { return 0 }\n"
  }
  if part == 7 {
    return "import services { Clock }\ninterface Hash {}\nstruct Problem {}\neffect fn load(id: i32) -> i32 ! Problem ? &Clock { return id }\nstruct Held<'a, T: 'a> { value: &'a T }\nfn held(value: Held<'static, i32>) -> i32 { return 0 }\n"
  }
  if part == 8 {
    return "fn manyA(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\nfn manyB(transform: for<'b20, 'b19, 'b18, 'b17, 'b16, 'b15, 'b14, 'b13, 'b12, 'b11, 'b10, 'b9, 'b8, 'b7, 'b6, 'b5, 'b4, 'b3, 'b2, 'b1, 'b0> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\nfn manyC(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b1 i32) -> i32 { return 0 }\nfn manyD(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 mut i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\n"
  }
  return ""
}

effect fn contractClaims(part: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("contracts.silk")
  let services = run module("services.silk")
  let text = contractFixture(part)
  let source = run present(text)
  let clock = run present("pub service Clock {}\n")
  let bounds = run module("bounds.silk")
  let ranked = run present(
    "interface Hash {}\ninterface Show {}\nstruct Ranked<T: Hash> { value: T }\nfn wrongRanked(value: Ranked<'static>) -> i32 { return 0 }\n",
  )
  let first = run Revision.publish(&Revision.make(), &entry, &source)
  let seeded = run Revision.publish(&first, &services, &clock)
  let held = run Revision.publish(&seeded, &bounds, &ranked)
  let mut semantic = makeSemantic(run Revision.copy(&held))
  let mut request = Request.make()
  if part == 0 {
    let apply = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"apply")
    let consume = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"consume")
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &apply,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return firstModeIs(answer, usize.ONE)
        },
      ) && Shared.with<Result<Answer, NoRejection>, bool>(
        &consume,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return firstModeIs(answer, 3)
        },
      ),
      "callable parameters keep shared and consuming invocation modes",
    )
    let load = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"load")
    let pending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pending")
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&load, declaredEffect) && (run pendingMatches(
        &pending,
        &load,
      )),
      "an effect declaration and a written Effect type resolve the same channels",
    )
    let both = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"both")
    let swapped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"swapped")
    let closed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"closed")
    let spelled = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"spelled")
    run Testing.expect(
      (run sameChannels(&both, &swapped)) && !(run sameChannels(&both, &load)) && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(
        &both,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return rowCountIs(answer, 3)
        },
      ) && (run sameChannels(&closed, &spelled)) && !(run sameChannels(&closed, &load)),
      "failure unions and requirement rows normalize; omitted channels equal never and empty",
    )
    let preserve = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"preserve")
    let bounded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"bounded")
    let risky = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"risky")
    run Testing.expect(
      (run preserved(&preserve)) && Shared.with<Result<Answer, NoRejection>, bool>(
        &bounded,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return onSignature(answer, constraintOrder)
        },
      ) && Shared.with<Result<Answer, NoRejection>, bool>(&risky, unsafeOrdinary),
      "row binders, run modes, ordered bounds and unsafe contracts are retained",
    )
    let control = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"control")
    let nested = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nested")
    let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"again")
    let stored = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"stored")
    run Testing.expect(
      (run substitutedShapes(&control, &nested, &again, &stored)),
      "substituted unions and rows compare a handle shared at different depths",
    )
    let loadBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"load")
    run Testing.expect(succeeded(&loadBody), "an effect body is typed against its declared success type")
  }
  if part == 1 {
    let notService = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"notService")
    let interfaceRow = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"interfaceRow",
    )
    let badRole = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"badRole")
    let notBound = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"notBound")
    let repeated = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"repeated")
    let ordinaryFailure = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"ordinaryFailure",
    )
    let rowAsType = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowAsType")
    let borrowedUnion = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"borrowedUnion",
    )
    let ambiguousCallable = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"ambiguousCallable",
    )
    let nestedQuantifier = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedQuantifier",
    )
    let ordinaryRow = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"ordinaryRow",
    )
    let exposedCallable = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"exposedCallable",
    )
    let exposedRow = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"exposedRow")
    run Testing.expect(
      rejectsAt(&notService, RejectionCode.InvalidRequirement) && rejectsAt(
        &interfaceRow,
        RejectionCode.InvalidRequirement,
      ) && rejectsAt(&badRole, RejectionCode.InvalidRequirement) && rejectsAt(
        &notBound,
        RejectionCode.InvalidBound,
      ) && rejectsAt(&repeated, RejectionCode.DuplicateBound) && rejectsAt(
        &ordinaryFailure,
        RejectionCode.EffectChannelOnOrdinary,
      ) && rejectsAt(&ordinaryRow, RejectionCode.EffectChannelOnOrdinary) && rejectsAt(
        &rowAsType,
        RejectionCode.TypeArgumentKind,
      ) && rejectsAt(&borrowedUnion, RejectionCode.InvalidUnionMember) && rejectsAt(
        &ambiguousCallable,
        RejectionCode.AmbiguousLifetime,
      ) && rejectsAt(&nestedQuantifier, RejectionCode.NestedQuantifier) && rejectsAt(
        &exposedCallable,
        RejectionCode.PrivateTypeExposure,
      ) && rejectsAt(&exposedRow, RejectionCode.PrivateTypeExposure),
      "invalid contracts reject at their spans",
    )
  }
  if part == 2 {
    let closedEffect = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"closedEffect")
    let explicitStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"explicitStatic",
    )
    let inputEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"inputEffect",
    )
    let closedDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"closedDeferred",
    )
    let inputDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"inputDeferred",
    )
    let genericEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"genericEffect",
    )
    let twoBorrowEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"twoBorrowEffect",
    )
    let heldEffect = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"heldEffect")
    let staticClosed = run sameResults(&closedEffect, &explicitStatic)
    let staticOwned = run sameResults(&inputEffect, &explicitStatic)
    let staticHeld = run sameResults(&heldEffect, &explicitStatic)
    run Testing.expect(
      staticClosed && staticOwned && staticHeld && rejectsAt(
        &genericEffect,
        RejectionCode.AmbiguousLifetime,
      ) && rejectsAt(&twoBorrowEffect, RejectionCode.AmbiguousLifetime) && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&closedDeferred, staticEnvironment) && Shared.with<Result<Answer, NoRejection>, bool>(
        &inputDeferred,
        staticEnvironment,
      ),
      "inputs free of borrowed data give an omitted Effect environment 'static",
    )
  }
  if part == 3 {
    let nestedStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedStatic",
    )
    let borrowedDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"borrowedDeferred",
    )
    let twoBorrowed = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"twoBorrowed",
    )
    let genericDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"genericDeferred",
    )
    let sameRegion = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"sameRegion")
    let heldDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"heldDeferred",
    )
    let runPending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"runPending")
    let callbackDeferred = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"callbackDeferred",
    )
    let keepPending = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"keepPending",
    )
    let heldOpenEffect = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"heldOpenEffect",
    )
    let representedBorrowed = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"representedBorrowed",
    )
    let representedStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"representedStatic",
    )
    let conformedStored = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"conformedStored",
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, usize>(&representedBorrowed, environmentMembers) == usize.ONE && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&representedStatic, environmentMembers) == usize.ZERO && rejectsAt(
        &conformedStored,
        RejectionCode.AmbiguousLifetime,
      ),
      "a representation parameter retains its contract environment; other stored parameters are unknown",
    )
    let effectSuccess = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"effectSuccess",
    )
    let effectSuccessStatic = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"effectSuccessStatic",
    )
    run Testing.expect(
      rejectsAt(&effectSuccess, RejectionCode.AmbiguousLifetime) && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&effectSuccessStatic, environmentMembers) == usize.ZERO,
      "an effect fn success Effect gets no environment default; its capture environment stays 'static",
    )
    run Testing.expect(
      rejectsAt(&nestedStatic, RejectionCode.AmbiguousLifetime) && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&borrowedDeferred, environmentMembers) == usize.ONE && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&twoBorrowed, environmentMembers) == 2 && Shared.with<Result<Answer, NoRejection>, usize>(
        &sameRegion,
        environmentMembers,
      ) == usize.ONE && rejectsAt(&genericDeferred, RejectionCode.AmbiguousLifetime) && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&heldDeferred, environmentMembers) == usize.ONE && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&runPending, environmentMembers) == usize.ZERO && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&callbackDeferred, environmentMembers) == usize.ZERO && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&keepPending, environmentMembers) == usize.ONE && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(
        &genericDeferred,
        fn(value: &Result<Answer, NoRejection>) -> bool {
          return rejectionSpells(
            value,
            RejectionCode.AmbiguousLifetime,
            String.utf8Bytes(text),
            b"Kept",
          )
        },
      ) && Shared.with<Result<Answer, NoRejection>, bool>(
        &heldOpenEffect,
        fn(value: &Result<Answer, NoRejection>) -> bool {
          return rejectionSpells(
            value,
            RejectionCode.AmbiguousLifetime,
            String.utf8Bytes(text),
            b"Effect<i32>",
          )
        },
      ),
      "an effect fn intersects retained regions; stored generic contents need an environment",
    )
  }
  if part == 4 {
    let orderedA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"orderedA")
    let orderedB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"orderedB")
    let orderedSingle = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"orderedSingle",
    )
    run Testing.expect(
      (run sameFirstParameters(&orderedA, &orderedB)) && !(run sameFirstParameters(
        &orderedA,
        &orderedSingle,
      )),
      "intersection member order does not number invocation binders",
    )
    let unionAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unionAB")
    let unionBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unionBA")
    let unionShared = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"unionShared",
    )
    let rowAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowAB")
    let rowBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowBA")
    let overlapAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"overlapAB")
    let overlapBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"overlapBA")
    let overlapApart = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"overlapApart",
    )
    run Testing.expect(
      (run sameFirstParameters(&unionAB, &unionBA)) && (run sameFirstParameters(&rowAB, &rowBA)) && (run sameFirstParameters(
        &overlapAB,
        &overlapBA,
      )) && !(run sameFirstParameters(&unionAB, &unionShared)) && !(run sameFirstParameters(
        &overlapAB,
        &overlapApart,
      )),
      "callables equal up to a renaming of invocation binders across unions, rows and environments",
    )
  }
  if part == 5 {
    let nestedRef = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nestedRef")
    let nestedRefAgain = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedRefAgain",
    )
    let nestedFirst = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedFirst",
    )
    let nestedFirstRenamed = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedFirstRenamed",
    )
    let nestedSecond = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedSecond",
    )
    let nestedUnion = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedUnion",
    )
    let nestedUnionSwapped = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedUnionSwapped",
    )
    let nestedUnionOne = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"nestedUnionOne",
    )
    let refSame = run sameFirstParameters(&nestedRef, &nestedRefAgain)
    let firstSame = run sameFirstParameters(&nestedFirst, &nestedFirstRenamed)
    let firstSecond = run sameFirstParameters(&nestedFirst, &nestedSecond)
    let unionSame = run sameFirstParameters(&nestedUnion, &nestedUnionSwapped)
    let unionOne = run sameFirstParameters(&nestedUnion, &nestedUnionOne)
    run Testing.expect(
      refSame && firstSame && !firstSecond && unionSame && !unionOne,
      "an unquantified inner callable refers to its enclosing contract's invocation binders",
    )
    let mixedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"mixedBinders",
    )
    let elidedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"elidedBinders",
    )
    let permutedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"permutedBinders",
    )
    let unusedBinder = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"unusedBinder",
    )
    let plainCallable = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"plainCallable",
    )
    let boundedBinders = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"boundedBinders",
    )
    let swappedBound = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"swappedBound",
    )
    run Testing.expect(
      (run sameFirstParameters(&mixedBinders, &elidedBinders)) && (run sameFirstParameters(
        &permutedBinders,
        &elidedBinders,
      )) && (run sameFirstParameters(&unusedBinder, &plainCallable)) && !(run sameFirstParameters(
        &boundedBinders,
        &elidedBinders,
      )) && (run sameFirstParameters(&boundedBinders, &swappedBound)),
      "invocation binders number by first use; unused names vanish and bounds stay meaningful",
    )
  }
  if part == 6 {
    let quantified = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"quantified")
    let spelledQuantifier = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"spelledQuantifier",
    )
    let environments = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"environments",
    )
    let retain = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"retain")
    let parse = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"parse")
    run Testing.expect(
      (run sameFirstParameters(&quantified, &spelledQuantifier)) && (run environmentsNormalize(
        &environments,
      )) && Shared.with<Result<Answer, NoRejection>, bool>(&retain, retainsEnvironment) && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&parse, representsCallable),
      "invocation binders, environment intersections and representation bounds are canonical",
    )
    let sorted = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Sorted")
    let datedBox = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"DatedBox")
    let loadInterface = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Load")
    let parser = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Parser")
    let useSorted = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"useSorted")
    let loadable = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"loadable")
    let wrongRow = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"wrongRow")
    let loaded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"loaded")
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&sorted, sortedContract) && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&datedBox, datedBoxContract) && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&loadInterface, loadContract) && Shared.with<Result<Answer, NoRejection>, bool>(
        &parser,
        parserContract,
      ),
      "declaration contracts record bounds, row binders and representation parameters",
    )
    run Testing.expect(
      rejectsFrom(&useSorted, RejectionCode.MissingConformance, offsetOf(text, "Sorted<i32>", usize.ZERO)),
      "a bounded application rejects at its written use when Hash is unproved",
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&loadable, signatureSucceeded) && rejectsAt(
        &wrongRow,
        RejectionCode.TypeArgumentKind,
      ) && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&loaded, splicedRow),
      "a row argument binds and splices through an alias",
    )
  }
  if part == 7 {
    let heldAnswer = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"held")
    let heldContract = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Held")
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&heldAnswer, signatureSucceeded) && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&heldContract, lifetimeBoundOnly),
      "a lifetime-only bound is recorded and does not block applications",
    )
    let rankedMembers = run Semantic.demandMembers(&mut semantic, &mut request, &bounds, b"Ranked")
    let rankedContract = run Semantic.demandContract(&mut semantic, &mut request, &bounds, b"Ranked")
    let wrongRanked = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &bounds,
      b"wrongRanked",
    )
    run Testing.expect(
      !Shared.with<Result<Answer, NoRejection>, bool>(
        &rankedMembers,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return hasTypeLookup(answer, Family.Contract)
        },
      ) && Shared.with<Result<Answer, NoRejection>, usize>(&rankedContract, contractConstraints) == usize.ONE && rejectsAt(
        &wrongRanked,
        RejectionCode.TypeArgumentKind,
      ),
      "bounded applications check arguments before proof, without affecting declaration identity",
    )
    let changed = run present("pub interface Clock {}\n")
    Semantic.revise(&mut semantic, run Revision.publish(&held, &services, &changed))
    let mut revised = Request.make()
    let reloaded = run Semantic.demandSignature(&mut semantic, &mut revised, &entry, b"load")
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &reloaded,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return rejectedTypeApplication(answer, RejectionCode.InvalidRequirement)
        },
      ),
      "an imported service becoming an interface invalidates its requirement use",
    )
    let reranked = run present(
      "interface Hash {}\ninterface Show {}\nstruct Ranked<T: Hash + Show> { value: T }\n",
    )
    Semantic.revise(&mut semantic, run Revision.publish(&held, &bounds, &reranked))
    let mut edited = Request.make()
    let editedContract = run Semantic.demandContract(&mut semantic, &mut edited, &bounds, b"Ranked")
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, usize>(&editedContract, contractConstraints) == 2,
      "editing only a bound yields the new contract",
    )
  }
  if part == 8 {
    let manyA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyA")
    let manyB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyB")
    let manyC = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyC")
    let manyD = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyD")
    let manySame = run sameFirstParameters(&manyA, &manyB)
    let manyResult = run sameFirstParameters(&manyA, &manyC)
    let manyAccess = run sameFirstParameters(&manyA, &manyD)
    run Testing.expect(
      manySame && !manyResult && !manyAccess,
      "contracts with many invocation binders compare without enumerating permutations",
    )
  }
  return ()
}

