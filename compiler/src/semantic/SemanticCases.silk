test effect fn receiverAutoBorrowRetainsProjectedReference() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("receiver-place.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(
    &id,
    """
struct Counter {}
impl Counter { fn read(value: &Self) -> i32 { return 42 } }
fn reborrow(value: &mut Counter) -> i32 { return value.read() }
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrow")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &body,
    checkedBody,
  )
  let mut retained = false
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    retained = Shared.with<TypedBody, bool>(&value, fn(typed: &TypedBody) -> bool {
      return bodyRetainsReceiverPass(typed, BodyReceiverPass.Shared)
    })
  }
  run Testing.expect(retained, "a mutable receiver retains its shared reborrow obligation")
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"reborrow")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&answer, selectedMirIndex)
  let mut projected = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut item = usize.ZERO
        while item < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Ref {access, place}, ..} = &statements[item] {
            let projections = Vector.asSlice<MirProjection>(&place.projections)
            if access == Access.Shared && projections.length == usize.ONE {
              projected = projected || mirProjectionIsDeref(&projections[usize.ZERO])
            }
          }
          item = item + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(projected, "receiver adaptation borrows the referent through one dereference")
  return ()
}

fn receiverRegionBelongsTo(lifetime: &Lifetime, caller: &DeclarationId) -> bool {
  return match &lifetime.* {
    Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, caller)
    Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, caller)
    _ => false
  }
}

fn receiverReferenceRegion(input: &Type) -> Option<Shared<Lifetime>> {
  return match &input.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    _ => Option.none<Shared<Lifetime>>()
  }
}

fn receiverApplicationMatchesRegions(value: &SpecializationApplication, declaration: &DeclarationId,
  inputs: &[BodyNodeId], nodes: &[BodyNode], caller: &DeclarationId) -> bool {
  let given = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if !DeclarationId.equals(SpecializationApplication.bodyDeclaration(value), declaration)
    || given.length != inputs.length || ordinals.length != inputs.length
    || Vector.length<ScopeBinding>(&value.scopes) != usize.ZERO { return false }
  let mut index = usize.ZERO
  while index < inputs.length {
    if ordinals[index] != index || inputs[index].index >= nodes.length { return false }
    let region = match &given[index] {
      Argument.Lifetime {value: lifetime} => Shared.clone<Lifetime>(&lifetime)
      _ => { return false }
    }
    let callerOwned = Shared.with<Lifetime, bool>(&region, fn(lifetime: &Lifetime) -> bool {
      return receiverRegionBelongsTo(lifetime, caller)
    })
    if !callerOwned { return false }
    if let BodyNodeKind.Expression {ty, ..} = &nodes[inputs[index].index].kind {
      let actual = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
      if let Option<Shared<Lifetime>>.Some {value: lifetime} = move actual {
        if !Lifetime.equalsShared(&region, &lifetime) { return false }
      } else { return false }
    } else { return false }
    index = index + usize.ONE
  }
  return true
}

fn receiverCallNode(body: &TypedBody) -> Option<BodyNodeId> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {receiverPass, ..}, ..} = &nodes[at].kind {
      if let Option<BodyReceiverPass>.Some {..} = &receiverPass {
        return Option.some<BodyNodeId>(BodyNodeId {index: at})
      }
    }
    at = at + usize.ONE
  }
  return Option.none<BodyNodeId>()
}

fn receiverApplicationMatchesBody(body: &TypedBody, application: &SpecializationApplication, node: BodyNodeId) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if node.index < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, arguments, ..}, ..} = &nodes[node.index].kind {
      let inputs = Vector.asSlice<BodyNodeId>(&arguments)
      let caller = TypedBody.declarationId(body)
      return receiverApplicationMatchesRegions(application, &declaration, inputs, nodes, caller)
    }
  }
  return false
}

effect fn receiverApplicationRetainsArgumentRegions(body: &Shared<TypedBody>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<TypedBody, Option<BodyNodeId>>(body, receiverCallNode)
  if let Option<BodyNodeId>.Some {value: node} = move selected {
    let found = TypedBody.directApplication(body, node)
    if let Option<Shared<SpecializationApplication>>.Some {value} = move found {
      let application = run SpecializationApplication.copyShared(&value)
      return Shared.with<TypedBody, bool>(body, fn(checked: &TypedBody) -> bool {
        return receiverApplicationMatchesBody(checked, &application, node)
      })
    }
  }
  return false
}

test effect fn receiverArgumentsInferCallerReferenceLifetimes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("receiver-argument-region.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(
    &id,
    """
struct Counter {}
impl Counter {
  fn inspect(value: &Self, other: &i32) -> i32 { return other.* }
}
fn forward(value: Counter, other: &i32) -> i32 {
  return value.inspect(other)
}
fn reborrow(value: Counter, other: &i32) -> i32 {
  return value.inspect(&other)
}
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let forwarded = run Semantic.demandBody(&mut store, &mut request, &id, b"forward")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrow")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&forwarded, bodyAnswerIsContractTyped)
      && Shared.with<Result<Answer, NoRejection>, bool>(&borrowed, bodyAnswerIsContractTyped),
    "non-receiver reference arguments infer caller lifetimes and explicit reborrows",
  )
  let forwardedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&forwarded, checkedBody)
  let borrowedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&borrowed, checkedBody)
  let retainedForwarded = match move forwardedBody {
    Option<Shared<TypedBody>>.Some {value} => run receiverApplicationRetainsArgumentRegions(&value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    _ => false
  }
  let retainedBorrowed = match move borrowedBody {
    Option<Shared<TypedBody>>.Some {value} => run receiverApplicationRetainsArgumentRegions(&value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    _ => false
  }
  run Testing.expect(retainedForwarded && retainedBorrowed,
    "published receiver applications retain each actual caller region in original method slot order")
  return ()
}

test effect fn recordAndSliceIndexProjectionsRetainPlaces() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("projection-gap.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Pair { value: i32 }
fn field(pair: &Pair) -> i32 { return pair.value }
fn index(values: &[i32]) -> i32 { return values[0] }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let field = run Semantic.demandMir(&mut store, &mut request, &id, b"field")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run Semantic.demandMir(&mut store, &mut request, &id, b"index")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&field, selectedMirIndex)
  let mut projected = false
  if let Option<usize>.Some {value} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[at] {
            let projections = Vector.asSlice<MirProjection>(&place.projections)
            if projections.length == 2 {
              if mirProjectionIsDeref(&projections[usize.ZERO]) {
                if let MirProjection.Field {index: ordinal} = &projections[usize.ONE] {
                  projected = ordinal == usize.ZERO
                }
              }
            }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  let selectedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&index, selectedMirIndex)
  let mut checkedIndex = false
  if let Option<usize>.Some {value: ordinal} = move selectedIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, ordinal) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        if let MirTerminator.Branch {thenBlock, elseBlock, ..} = &blocks[blockAt].terminator {
          if let MirTerminator.Trap {..} = &blocks[elseBlock].terminator {
            let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
            let mut statementAt = usize.ZERO
            let mut runtimeLength = false
            while statementAt < statements.length {
              if let MirStatement.Assign {value: MirRvalue.SliceLength {..}, ..} = &statements[statementAt] { runtimeLength = true }
              statementAt = statementAt + usize.ONE
            }
            let safeStatements = Vector.asSlice<MirStatement>(&blocks[thenBlock].statements)
            let mut safeAt = usize.ZERO
            while safeAt < safeStatements.length {
              if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &safeStatements[safeAt] {
                let projections = Vector.asSlice<MirProjection>(&place.projections)
                if projections.length == usize.ONE {
                  if let MirProjection.Index {..} = &projections[usize.ZERO] { checkedIndex = checkedIndex || runtimeLength }
                }
              }
              safeAt = safeAt + usize.ONE
            }
          }
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(projected, "a borrowed nominal field lowers as Deref followed by Field zero")
  run Testing.expect(checkedIndex, "slice indexing reads runtime length and reaches its element projection only through the bounds-success block")
  return ()
}

test effect fn unsafePrefixAcknowledgesOnlySelectedCall() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("unsafe-prefix.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
unsafe fn inner() -> i32 { return 42 }
unsafe fn outer(value: i32) -> i32 { return value }
fn safe() -> i32 { return 42 }
struct Counter {}
impl Counter { unsafe fn marked(value: &Self) -> i32 { return 42 } }
unsafe fn receiverSource(value: Counter) -> Counter { return move value }
fn nested() -> i32 { return unsafe outer(inner()) }
fn acknowledged() -> i32 { return unsafe outer(unsafe inner()) }
fn block() -> i32 { unsafe { return outer(inner()) } }
fn literal() -> i32 { return unsafe 42 }
fn pointer(value: *const i32) -> i32 { return unsafe value.* }
fn redundant() -> i32 { return unsafe safe() }
fn receiver(value: Counter) -> i32 { return unsafe receiverSource(move value).marked() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&nested, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "inner())", 0)),
    "an outer unsafe prefix does not acknowledge its argument call",
  )
  let acknowledged = run Semantic.demandMir(&mut store, &mut request, &id, b"acknowledged")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let block = run Semantic.demandMir(&mut store, &mut request, &id, b"block")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicitMir = Shared.with<Result<Answer, NoRejection>, Option<usize>>(
    &acknowledged,
    selectedMirIndex,
  )
  let blockMir = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&block, selectedMirIndex)
  let mut permitted = false
  if let Option<usize>.Some {..} = &explicitMir {
    if let Option<usize>.Some {..} = &blockMir {
      permitted = true
    }
  }
  run Testing.expect(permitted, "nested prefixes and a lexical unsafe block each authorize calls")
  let literal = run Semantic.demandBody(&mut store, &mut request, &id, b"literal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointer = run Semantic.demandBody(&mut store, &mut request, &id, b"pointer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&literal, RejectionCode.UnsafeInvocation, offsetOf(text, "unsafe 42", 0)) && rejectsFrom(
      &pointer,
      RejectionCode.UnsafeInvocation,
      offsetOf(text, "unsafe value.*", 0),
    ),
    "an unsafe prefix rejects non-call operands including raw dereference",
  )
  let redundant = run Semantic.demandBody(&mut store, &mut request, &id, b"redundant")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&redundant, RejectionCode.UnsafeInvocation, offsetOf(text, "safe()", 1)),
    "a safe call has no obligation for a prefix to acknowledge",
  )
  let receiver = run Semantic.demandBody(&mut store, &mut request, &id, b"receiver")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(
      &receiver,
      RejectionCode.UnsafeAcknowledgement,
      offsetOf(text, "receiverSource(move value).marked()", 0),
    ),
    "a prefix on the receiver operation does not acknowledge its receiver call",
  )
  return ()
}

fn containsIrLine(text: &[u8], operation: &[u8], guarantee: &[u8]) -> bool {
  let mut start = usize.ZERO
  while start < text.length {
    let mut end = start
    while end < text.length && text[end] != 10 {
      end = end + usize.ONE
    }
    let line = Slice.view<u8>(text, start, end - start)
    if containsIr(line, operation) && containsIr(line, guarantee) {
      return true
    }
    start = end + usize.ONE
  }
  return false
}

fn bodyRetainsPointerAccessWeaken(answer: &Result<Answer, NoRejection>) -> bool {
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBody(answer) {
    return Shared.with<TypedBody, bool>(&body, fn(checked: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(checked)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form: BodyExpression.PointerAccessWeaken {value: source}} = &nodes[at].kind {
          if source.index < nodes.length {
            let shared = Shared.with<Type, bool>(&ty, pointerHasSharedAccess)
            if let BodyNodeKind.Expression {ty: original, ..} = &nodes[source.index].kind {
              if shared && Shared.with<Type, bool>(&original, pointerHasMutableAccess) { return true }
            }
          }
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  return false
}

fn pointerHasSharedAccess(value: &Type) -> bool {
  return match &value.* { Type.Pointer {access, ..} => access == Access.Shared _ => false }
}

fn pointerHasMutableAccess(value: &Type) -> bool {
  return match &value.* { Type.Pointer {access, ..} => access == Access.Mutable _ => false }
}

test effect fn pointerAlignmentUsesNeutralFactsAndDeclaredGuarantees() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("pointer-alignment.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let target = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let text = """
fn probe(aligned: *const i32, unaligned: *const align(1) i32) -> i32 {
  unsafe { return aligned.* + unaligned.* }
}
struct PointerHolder { pointer: ?[*]mut i32 }
impl PointerHolder { fn raw(self: &Self) -> ?[*]mut i32 { return self.pointer } }
fn inspect<T>(pointer: ?[*]const T) -> i32 { return 42 }
fn inspectI32(pointer: ?[*]const i32) -> i32 { return 42 }
fn inspectMut(pointer: ?[*]mut i32) -> i32 { return 42 }
fn inspectNonNull(pointer: [*]const i32) -> i32 { return 42 }
fn inspectNested(pointer: ?[*]const (*const i32)) -> i32 { return 42 }
fn weaken(pointer: ?[*]mut i32) -> i32 { return inspect(pointer) }
fn weakenReturn(pointer: ?[*]mut i32) -> ?[*]const i32 { return pointer }
fn weakenLocal(pointer: ?[*]mut i32) -> i32 { let held: ?[*]const i32 = pointer return inspectI32(held) }
fn fieldReturn(holder: PointerHolder) -> ?[*]const i32 { return holder.pointer }
fn fieldLocal(holder: PointerHolder) -> i32 { let held: ?[*]const i32 = holder.pointer return inspectI32(held) }
fn fieldCall(holder: PointerHolder) -> i32 { return inspectI32(holder.pointer) }
fn receiverResult(holder: PointerHolder) -> ?[*]const i32 { return holder.raw() }
fn reverseAccess(reversePointer: ?[*]const i32) -> i32 { return inspectMut(reversePointer) }
fn wrongPointee(wrongValue: ?[*]mut bool) -> i32 { return inspectI32(wrongValue) }
fn wrongExtent(singlePointer: ?*mut i32) -> i32 { return inspectI32(singlePointer) }
fn wrongNullability(nullablePointer: ?[*]mut i32) -> i32 { return inspectNonNull(nullablePointer) }
fn wrongAlignment(unalignedPointer: ?[*]mut align(1) i32) -> i32 { return inspectI32(unalignedPointer) }
fn wrongNested(nestedPointer: ?[*]mut (*mut i32)) -> i32 { return inspectNested(nestedPointer) }
"""
  let mut store = run staticSemantic(&id, text, target)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let checked = run Semantic.demandMir(&mut store, &mut request, &id, b"probe")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&checked, selectedMirIndex)
  let mut aligned = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut layouts = Vector.make<TypeLayout>()
      let mut at = usize.ZERO
      while at < locals.length {
        if let Option<BackendLayout>.Some {value: facts} = move BackendLayout.scalar(
          &locals[at].ty,
          &target,
        ) {
          let layout = run Shared.make<BackendLayout>(move facts)
            |> Effect.provideMut<Allocator>(&mut allocator)
          run Vector.append<TypeLayout>(
            &mut layouts,
            TypeLayout {ty: Shared.clone<Type>(&locals[at].ty), layout: move layout},
          )
            |> Effect.provideMut<Allocator>(&mut allocator)
        }
        at = at + usize.ONE
      }
      let foreign = Vector.make<CAbi.Signature>()
      let emitted = run Effect.result(
        LlvmText.emit(function, &target, Vector.asSlice<TypeLayout>(&layouts), Vector.asSlice<CAbi.Signature>(&foreign)),
      )
        |> Effect.provideMut<Allocator>(&mut allocator)
      match move emitted {
        Result<Bytes, BackendGap | OutOfMemoryError>.Success {value: llvmText} => {
          let ir = Bytes.asSlice(&llvmText)
          aligned = containsIr(ir, b"alloca i32, align 4") && containsIr(ir, b"alloca ptr, align 8") && containsIrLine(
            ir,
            b"load i32, ptr",
            b", align 4",
          ) && containsIrLine(ir, b"load i32, ptr", b", align 1")
        }
        _ => ()
      }
    }
  }
  run Testing.expect(
    aligned,
    "local alignment uses neutral facts and explicit raw align(1) is preserved",
  )
  let weakened = run Semantic.demandBody(&mut store, &mut request, &id, b"weaken") |> Effect.provideMut<Allocator>(&mut allocator)
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"weakenReturn") |> Effect.provideMut<Allocator>(&mut allocator)
  let initialized = run Semantic.demandBody(&mut store, &mut request, &id, b"weakenLocal") |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldReturn = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldReturn") |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldLocal") |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldCall = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldCall") |> Effect.provideMut<Allocator>(&mut allocator)
  let receiverResult = run Semantic.demandBody(&mut store, &mut request, &id, b"receiverResult") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&weakened, bodyRetainsPointerAccessWeaken)
    && Shared.with<Result<Answer, NoRejection>, bool>(&returned, bodyRetainsPointerAccessWeaken)
    && Shared.with<Result<Answer, NoRejection>, bool>(&initialized, bodyRetainsPointerAccessWeaken)
    && Shared.with<Result<Answer, NoRejection>, bool>(&fieldReturn, bodyRetainsPointerAccessWeaken)
    && Shared.with<Result<Answer, NoRejection>, bool>(&fieldLocal, bodyRetainsPointerAccessWeaken)
    && Shared.with<Result<Answer, NoRejection>, bool>(&fieldCall, bodyRetainsPointerAccessWeaken)
    && Shared.with<Result<Answer, NoRejection>, bool>(&receiverResult, bodyRetainsPointerAccessWeaken),
    "immediate pointer boundaries retain mutable identifiers, fields and selected results below shared access")
  let reverse = run Semantic.demandBody(&mut store, &mut request, &id, b"reverseAccess") |> Effect.provideMut<Allocator>(&mut allocator)
  let pointee = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongPointee") |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongExtent") |> Effect.provideMut<Allocator>(&mut allocator)
  let nullability = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongNullability") |> Effect.provideMut<Allocator>(&mut allocator)
  let alignment = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongAlignment") |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongNested") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&reverse, RejectionCode.TypeMismatch, text, "reversePointer", usize.ONE)
    && rejectsSpan(&pointee, RejectionCode.TypeMismatch, text, "wrongValue", usize.ONE)
    && rejectsSpan(&extent, RejectionCode.TypeMismatch, text, "singlePointer", usize.ONE)
    && rejectsSpan(&nullability, RejectionCode.TypeMismatch, text, "nullablePointer", usize.ONE)
    && rejectsSpan(&alignment, RejectionCode.TypeMismatch, text, "unalignedPointer", usize.ONE)
    && rejectsSpan(&nested, RejectionCode.TypeMismatch, text, "nestedPointer", usize.ONE),
    "pointer access weakening preserves pointee, extent, nullability and alignment and cannot reverse")
  return ()
}


test effect fn importedNominalQualifiersUseInherentQueries() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("qualified-calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("actor.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
    import actor { Counter as Imported }
    import actor
    fn works() -> i32 { return Imported.make() }
    fn namespace() -> i32 { return actor.answer() }
    fn privateMember() -> i32 { return Imported.hidden() }
    fn missingMember() -> i32 { return Imported.absent() }
    """
  let libraryText = """
    pub struct Counter {}
    impl Counter {
      pub fn make() -> i32 { return 42 }
      fn hidden() -> i32 { return 7 }
    }
    pub fn answer() -> i32 { return 42 }
    """
  let written = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let exported = run present(libraryText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = run Revision.publish(&Revision.make(), &entry, &written)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&initial, &library, &exported)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let works = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"works")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let namespace = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"namespace")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let privateMember = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"privateMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingMember = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&works, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&namespace, inspect).success,
    "an imported type alias selects its inherent function while namespace calls retain their path",
  )
  run Testing.expect(
    rejectsFrom(&privateMember, RejectionCode.PrivateMember, offsetOf(text, "hidden", 0)) &&
    rejectsFrom(&missingMember, RejectionCode.UnknownMember, offsetOf(text, "absent", 0)),
    "imported inherent lookup preserves privacy and missing-member spans",
  )
  return ()
}


test effect fn constructorAndPackageValueAdmission() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("value-admission.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
    tuple Pair(i32, bool)
    param answer: i32 = 42
    param absent: i32
    fn tupleValue() -> i32 {
      let pair = Pair(42, true)
      return 42
    }
    fn tupleArity() -> i32 {
      let pair = Pair(42)
      return 42
    }
    fn tupleType() -> i32 {
      let pair = Pair(true, true)
      return 42
    }
    pub fn main() -> i32 { return answer }
    fn parameterValue() -> i32 { return answer }
    fn parameterCall() -> i32 { return answer() }
    fn invalidSchema() -> i32 { return absent }
    """
  let mut semantic = run staticSemantic(&entry, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let tupleValue = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tupleValue")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleArity = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tupleArity")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleType = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tupleType")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterValue = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"parameterValue")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parameterCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"parameterCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidSchema = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"invalidSchema")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&tupleValue, bodyAnswerIsContractTyped) && rejectsSpan(&parameterValue, RejectionCode.ProfileInputUnavailable, text, "answer", 2),
    "named tuple construction is checked while package values retain the profile gap",
  )
  run Testing.expect(
    rejectsSpan(&tupleArity, RejectionCode.CallArity, text, "Pair(42)", 0) && rejectsSpan(&tupleType, RejectionCode.TypeMismatch, text, "true", 1) &&
    rejectsSpan(&parameterCall, RejectionCode.NotCallable, text, "answer", 3) && rejectsSpan(&invalidSchema, RejectionCode.InvalidParameterSchema, text, "param absent: i32", 0),
    "argument and schema errors stay diagnostics before value deferral",
  )
  let built = run Semantic.buildMain(&mut semantic, &mut request, &entry)
    |> Effect.provideMut<Allocator>(&mut allocator)
  match move built {
    BackendBuild.Unsupported {gaps} => {
      let entries = Vector.asSlice<Shared<BackendGap>>(&gaps)
      run Testing.expect(entries.length == usize.ONE, "one profile input gap is retained")
      if entries.length == usize.ONE {
        run Testing.expect(
          Shared.with<BackendGap, bool>(&entries[usize.ZERO], fn(gap: &BackendGap) -> bool {
            return gap.code == GapCode.ProfileInput &&
              gap.span.start == offsetOf(text, "answer", 1) && gap.span.end == gap.span.start + 6
          }),
          "a package value reports the profile input gap at its use",
        )
      }
    }
    _ => { run Testing.expect(false, "package values require the profile input query") }
  }
  return ()
}


test effect fn openOwnerCallsValidateBeforeDeferral() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("open-owner.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
    pub struct Box<T> { value: T }
    impl<T> Box<T> {
      pub fn read(value: T) -> T { return move value }
      pub fn fixed() -> i32 { return 42 }
      pub fn keep<U>(value: U) -> U { return move value }
    }
    struct Scalar {}
    impl Scalar { fn keep<T>(value: T) -> T { return move value } }
    fn inferredOwner() -> i32 { return Box.read(42) }
    fn fixedMember() -> i32 { return Box.fixed() }
    fn explicitMember() -> i32 { return Scalar.keep<i32>(42) }
    fn ownExplicit() -> i32 { return Box.keep<i32>(42) }
    fn ownInferred() -> i32 { return Box.keep(42) }
    fn excessArguments() -> i32 { return Box.read(1, 2) }
    fn excessPrefix() -> i32 { return Box.read<i32, bool>(42) }
    fn unknownPrefix() -> i32 { return Box.read<Missing>(42) }
    fn missingMember() -> i32 { return Box.absent() }
    """
  let mut semantic = run staticSemantic(&entry, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let inferredOwner = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferredOwner")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fixedMember = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"fixedMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicitMember = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicitMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingMember = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ownExplicit = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"ownExplicit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ownInferred = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"ownInferred")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let excessArguments = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"excessArguments")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let excessPrefix = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"excessPrefix")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownPrefix = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknownPrefix")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&ownExplicit, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&ownInferred, inspect).success,
    "an owner-independent member keeps its own explicit and inferred generic arguments",
  )
  run Testing.expect(
    rejectsSpan(&excessArguments, RejectionCode.CallArity, text, "Box.read", 1) &&
    rejectsSpan(&excessPrefix, RejectionCode.TypeArity, text, "bool", 0) &&
    rejectsSpan(&unknownPrefix, RejectionCode.UnknownName, text, "Missing", 0),
    "known call and prefix errors remain diagnostics before owner specialization defers",
  )
  run Testing.expect(
    rejectsSpan(&inferredOwner, RejectionCode.Unsupported, text, "read", 1) &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&fixedMember, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&explicitMember, inspect).success,
    "only members needing open owner inference defer and explicit member arguments remain writable",
  )
  run Testing.expect(
    rejectsSpan(&missingMember, RejectionCode.UnknownMember, text, "absent", 0),
    "an open owner still diagnoses a nonexistent member",
  )
  return ()
}

fn recordLayoutType(body: &TypedBody) -> Option<Shared<Type>> {
  let locals = TypedBody.localSlice(body)
  if locals.length != usize.ONE { return Option.none<Shared<Type>>() }
  return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[usize.ZERO].ty))
}

test effect fn aggregateLayoutRetainsFieldOffsetsAndChildPadding() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("record-layout.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(&id, """
struct Inner {
  first: u8
  second: i32
  third: u8
}
struct Outer {
  prefix: u8
  nested: Inner
}
fn probe(value: Outer) -> i32 { return 42 }
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let bodyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"probe")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&bodyAnswer, checkedBody)
  let mut ty = Option.none<Shared<Type>>()
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    ty = Shared.with<TypedBody, Option<Shared<Type>>>(&value, recordLayoutType)
  }
  let record = match move ty {
    Option<Shared<Type>>.Some {value} => value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the record parameter retains its nominal type")
      return ()
    }
  }
  let answer = run Semantic.demandLayout(&mut store, &mut request, &id, &record)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&answer, selectedLayoutIndex)
  let hasLayout = match &selected {
    Option<usize>.Some {..} => true
    Option<usize>.None => false
  }
  run Testing.expect(hasLayout, "the aggregate query publishes a layout answer")
  let mut aligned = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
      aligned = Shared.with<BackendLayout, bool>(&facts, fn(layout: &BackendLayout) -> bool {
        if let LayoutStorage.Record {fields} = &layout.storage {
          let entries = Vector.asSlice<LayoutField>(&fields)
          if entries.length == 2 {
            return layout.size == 16 && layout.alignment == 4 && layout.abi == LayoutAbi.Indirect
              && entries[usize.ZERO].offset == usize.ZERO && entries[usize.ONE].offset == 4
          }
        }
        return false
      })
    }
  }
  run Testing.expect(aligned, "record padding and alignment come from recursively demanded child layouts")
  return ()
}

fn recordOperandsKeepWrittenOrder(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields}, ..} = &nodes[at].kind {
      let operands = Vector.asSlice<BodyAggregateField>(&fields)
      if operands.length == 2 {
        return operands[usize.ZERO].index == usize.ONE && operands[usize.ONE].index == usize.ZERO
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn recordConstructionAndAssignmentRetainCanonicalFields() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("record-fields.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(&id, """
struct Pair {
  left: i32
  right: i32
}
fn create() -> Pair { return Pair { left: 40, right: 2 } }
fn sum(pair: Pair) -> i32 { return pair.left + pair.right }
pub fn main() -> i32 {
  let mut pair = Pair { right: 22, left: 20 }
  pair.left = 21
  return sum(create()) + pair.left + pair.right
}
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let bodyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&bodyAnswer, checkedBody)
  let mut writtenOrder = false
  if let Option<Shared<TypedBody>>.Some {value} = move selectedBody {
    writtenOrder = Shared.with<TypedBody, bool>(&value, recordOperandsKeepWrittenOrder)
  }
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedMir = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  let mut aggregate = false
  let mut replacement = false
  if let Option<usize>.Some {value: index} = move selectedMir {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
        let mut at = usize.ZERO
        while at < statements.length {
          if let MirStatement.Assign {destination, value, ..} = &statements[at] {
            if let MirRvalue.Aggregate {fields} = &value {
              let operands = Vector.asSlice<MirAggregateField>(&fields)
              if operands.length == 2 {
                aggregate = operands[usize.ZERO].index == usize.ONE && operands[usize.ONE].index == usize.ZERO
              }
            }
            let projections = Vector.asSlice<MirProjection>(&destination.projections)
            if projections.length == usize.ONE {
              if let MirProjection.Field {index: ordinal} = &projections[usize.ZERO] {
                replacement = ordinal == usize.ZERO
              }
            }
          }
          at = at + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  run Testing.expect(writtenOrder, "typed record operands retain written order and canonical fields")
  run Testing.expect(aggregate, "written record operand order survives canonical field selection into MIR")
  run Testing.expect(replacement, "assignment retains a canonical projected destination")
  let built = run Semantic.buildMain(&mut store, &mut request, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut storage = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      storage = containsIr(ir, b"(ptr %out") && containsIr(ir, b"load [8 x i8], ptr %p0")
        && containsIrLine(ir, b"getelementptr i8", b", i64 4")
    }
    _ => ()
  }
  run Testing.expect(storage, "record storage uses layout offsets and indirect parameter and result copies")
  return ()
}

// Runtime boolean typing uses the same concrete rule as compile-time boolean typing.
test effect fn runtimeBooleanOperatorsLowerShortCircuit() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("runtime-booleans.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn choose(value: bool) -> bool { return value && true || false }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"choose")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mir, selectedMirIndex)
  let mut branches = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Branch {..} = &blocks[at].terminator { branches = true }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(branches, "runtime boolean operators retain conditional evaluation in MIR")
  return ()
}

// Deferred representations keep unknown members and incompatible injection operands diagnostic.
test effect fn deferredRecordFormsRetainInvalidOperandDiagnostics() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("record-coverage.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { value: i32 }
struct Holder { value: Left | Right }
union Choice { Value { value: i32 }, Empty }
struct Counter { value: i32 }
impl Counter { fn read(value: &Self) -> i32 { return value.value } }
enum Status { Ready }
struct Box<T> { value: T }
fn consume(value: Left | Right) -> i32 { return 42 }
fn unionValue() -> i32 { return consume(Left { value: 42 }) }
fn invalidUnion() -> i32 { return consume(true) }
fn fieldUnion() -> i32 { let holder = Holder { value: Left { value: 42 } } return 42 }
fn invalidFieldUnion() -> i32 { let holder = Holder { value: true } return 42 }
fn invalidRecordUnion() -> i32 { let holder = Holder { value: Left { value: true } } return 42 }
fn produce(value: i32) -> Choice { return Choice.Value { value: value } }
fn unionResult() -> i32 { let selected = produce(42) return 42 }
fn invalidUnionResult() -> bool { return produce(42) }
fn invalidEnum() -> i32 { let status = Status.Absent return 42 }
fn genericValue() -> i32 { let boxed = Box { value: 42 } return 42 }
fn bound(value: &Counter) -> i32 { let read = value.read return 42 }
fn invalidMember(value: &Counter) -> i32 { let read = value.absent return 42 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let unionValue = run Semantic.demandBody(&mut store, &mut request, &id, b"unionValue")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidFieldUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidFieldUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidRecordUnion = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidRecordUnion")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unionResult = run Semantic.demandBody(&mut store, &mut request, &id, b"unionResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidUnionResult = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidUnionResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidEnum = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidEnum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let genericValue = run Semantic.demandBody(&mut store, &mut request, &id, b"genericValue")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidMember = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidMember")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let injectedArgument = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&unionValue, checkedBody)
  let injectedField = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&fieldUnion, checkedBody)
  let argumentChecked = match &injectedArgument {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  let fieldChecked = match &injectedField {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    argumentChecked && rejectsSpan(&invalidUnion, RejectionCode.TypeMismatch, text, "true", 0),
    "a closed record injects into its structural union and a non-member is a mismatch",
  )
  run Testing.expect(
    fieldChecked &&
    rejectsSpan(&invalidFieldUnion, RejectionCode.TypeMismatch, text, "true", 1) &&
    rejectsSpan(&invalidRecordUnion, RejectionCode.TypeMismatch, text, "true", 2),
    "a record field injects its union member only after checking the nested initializer",
  )
  let nominalResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&unionResult, checkedBody)
  let resultChecked = match &nominalResult {
    Option<Shared<TypedBody>>.Some {..} => true
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    resultChecked && rejectsSpan(&invalidUnionResult, RejectionCode.TypeMismatch, text, "produce(42)", 1),
    "a non-generic nominal union result is a runtime value and a mismatched use is rejected",
  )
  run Testing.expect(
    rejectsSpan(&invalidEnum, RejectionCode.UnknownMember, text, "Status.Absent", 0),
    "an absent enum member remains an unknown member",
  )
  run Testing.expect(
    rejectsSpan(&genericValue, RejectionCode.GenericRecordUnavailable, text, "Box { value: 42 }", 0) &&
    rejectsSpan(&bound, RejectionCode.BoundMethodUnavailable, text, "value.read", 0) &&
    rejectsSpan(&invalidMember, RejectionCode.UnknownMember, text, "absent", 0),
    "generic records and published bound methods have specific reached gaps",
  )
  return ()
}

fn enumMatchArmsKeepPatternsAndGuards(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if written.length != 3 { return false }
      let mut guarded = false
      if let Option<BodyNodeId>.Some {..} = &written[usize.ZERO].guard { guarded = true }
      let mut ready = false
      if let BodyPattern.EnumMember {member} = &written[usize.ZERO].pattern {
        ready = member.ordinal == usize.ONE && !member.negative && member.magnitude == 7
      }
      let mut unknown = false
      if let BodyPattern.EnumMember {member} = &written[usize.ONE].pattern {
        unknown = member.ordinal == usize.ZERO && member.negative && member.magnitude == 1
      }
      let mut fallback = true
      if let BodyPattern.EnumMember {..} = &written[2].pattern { fallback = false }
      return guarded && ready && unknown && fallback
    }
    at = at + usize.ONE
  }
  return false
}

fn enumParameterType(body: &TypedBody) -> Option<Shared<Type>> {
  let locals = TypedBody.localSlice(body)
  if locals.length == usize.ZERO { return Option.none<Shared<Type>>() }
  return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[usize.ZERO].ty))
}

// Scalar enums keep nominal identity, take their representation's layout, and lower matches to switches.
test effect fn scalarEnumsLowerMembersValuesAndSwitches() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("scalar-enums.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
enum(i8) Status {
  Unknown = -1,
  Ready = 7,
}
enum Other { First, Second }
struct Flags { status: Status }
fn raw(status: Status) -> i8 { return Status.value(status) }
fn stored(flags: &Flags) -> bool { return flags.status != Status.Ready }
fn classify(status: Status, open: bool) -> i32 {
  return match status {
    Status.Ready if open => 1
    Status.Unknown => 2
    _ => 3
  }
}
pub fn main() -> i32 {
  let flags = Flags { status: Status.Unknown }
  if stored(&flags) && raw(flags.status) == -1 { return classify(flags.status, true) }
  return 0
}
fn missing(status: Status) -> i32 { return match status { Status.Ready => 1 } }
fn duplicate(status: Status) -> i32 { return match status { Status.Unknown => 1 Status.Unknown => 2 _ => 3 } }
fn afterUniversal(status: Status) -> i32 { return match status { _ => 1 Status.Ready => 4 } }
fn covered(status: Status) -> i32 { return match status { Status.Ready => 1 Status.Unknown => 5 _ => 6 } }
fn foreign(status: Status) -> i32 { return match status { Other.First => 1 _ => 2 } }
fn guardType(status: Status, count: i32) -> i32 { return match status { Status.Ready if count => 1 _ => 2 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let classifyAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"classify")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let classifyBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&classifyAnswer, checkedBody)
  let mut arms = false
  let mut enumType = Option.none<Shared<Type>>()
  if let Option<Shared<TypedBody>>.Some {value} = move classifyBody {
    arms = Shared.with<TypedBody, bool>(&value, enumMatchArmsKeepPatternsAndGuards)
    enumType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
  }
  run Testing.expect(arms, "match arms keep member values, guard and universal fallback in written order")
  let mut scalarLayout = false
  if let Option<Shared<Type>>.Some {value: ty} = move enumType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        scalarLayout = Shared.with<BackendLayout, bool>(&facts, fn(layout: &BackendLayout) -> bool {
          let scalarStorage = match &layout.storage {
            LayoutStorage.Scalar => true
            _ => false
          }
          return scalarStorage && layout.size == usize.ONE && layout.alignment == usize.ONE && layout.abi == LayoutAbi.Integer
        })
      }
    }
  }
  run Testing.expect(scalarLayout, "a scalar enum takes its representation's neutral layout")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"classify")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector.length<MirSwitchCase>(&selected)
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(switches == 2 && cases == 3, "a false guard resumes dispatch at the next arm with a second switch")
  let built = run Semantic.buildMain(&mut store, &mut request, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIr(bytes, b"i8 7, label %b") && containsIr(bytes, b"i8 -1, label %b")
    }
    _ => ()
  }
  run Testing.expect(emitted, "enum switches and values are spelled from the representation layout")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let afterUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUniversal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let covered = run Semantic.demandBody(&mut store, &mut request, &id, b"covered")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let guardType = run Semantic.demandBody(&mut store, &mut request, &id, b"guardType")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missing, RejectionCode.MissingEnumMember, text, "match status { Status.Ready => 1 }", 0) &&
    rejectsSpan(&duplicate, RejectionCode.DuplicateMatchPattern, text, "Status.Unknown", 3) &&
    rejectsSpan(&afterUniversal, RejectionCode.MatchArmAfterUniversal, text, "Status.Ready", 3) &&
    rejectsSpan(&covered, RejectionCode.UnreachableMatchArm, text, "_", 3) &&
    rejectsSpan(&foreign, RejectionCode.TypeMismatch, text, "Other.First", 0) &&
    rejectsSpan(&guardType, RejectionCode.ConditionNotBool, text, "count", 1),
    "enum coverage, foreign members and non-Boolean guards report precise spans",
  )
  return ()
}

fn firstUnionInjectTag(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.UnionInject {tag, ..}, ..} = &nodes[at].kind { return tag }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn recordArmTag(body: &TypedBody, arm: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if arm < written.length {
        if let BodyPattern.Record {member} = &written[arm].pattern {
          if let Option<BodyUnionMember>.Some {value} = &member { return value.tag }
        }
      }
      return usize.MAX
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn matchAddressesPlace(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {place, ..}, ..} = &nodes[at].kind { return place }
    at = at + usize.ONE
  }
  return false
}

// Counts binding places reaching field `first` (then `second`, unless MAX) after an optional
// structural member step `tag` (MAX = none).
fn bindingPlaces(body: &TypedBody, tag: usize, first: usize, second: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
      let steps = Vector.asSlice<BodyPatternStep>(&path)
      let mut cursor = usize.ZERO
      let mut matched = true
      if tag != usize.MAX {
        matched = false
        if steps.length > usize.ZERO {
          if let BodyPatternStep.Member {tag: selected, ..} = &steps[usize.ZERO] { matched = selected == tag }
        }
        cursor = usize.ONE
      }
      let mut expected = usize.ONE + usize.ONE
      if second == usize.MAX { expected = usize.ONE }
      if matched && steps.length == cursor + expected {
        let mut fieldsMatch = false
        if let BodyPatternStep.Field {index} = &steps[cursor] { fieldsMatch = index == first }
        if second != usize.MAX {
          let mut secondMatch = false
          if let BodyPatternStep.Field {index} = &steps[cursor + usize.ONE] { secondMatch = index == second }
          fieldsMatch = fieldsMatch && secondMatch
        }
        if fieldsMatch { found = found + usize.ONE }
      }
    }
    at = at + usize.ONE
  }
  return found
}

effect fn injectionCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  return match move selected {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, usize>(&value, unionInjections)
    Option<Shared<TypedBody>>.None => usize.MAX
  }
}

fn unionInjections(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.UnionInject {..}, ..} = &nodes[at].kind { found = found + usize.ONE }
    at = at + usize.ONE
  }
  return found
}

fn firstArmMember(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if written.length > usize.ZERO {
        if let BodyPattern.Record {member} = &written[usize.ZERO].pattern {
          if let Option<BodyUnionMember>.Some {value} = &member { return Option.some<Shared<Type>>(Shared.clone<Type>(&value.ty)) }
        }
      }
      return Option.none<Shared<Type>>()
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn taggedMemberAt(layout: &BackendLayout, tag: usize) -> Option<Shared<Type>> {
  if let LayoutStorage.Tagged {members, ..} = &layout.storage {
    let listed = Vector.asSlice<Shared<Type>>(&members)
    if tag < listed.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&listed[tag])) }
  }
  return Option.none<Shared<Type>>()
}

fn taggedLayout(layout: &BackendLayout) -> usize {
  if let LayoutStorage.Tagged {tagSize, payloadOffset, ..} = &layout.storage {
    if tagSize == usize.ONE && layout.abi == LayoutAbi.Indirect { return payloadOffset * 100 + layout.size }
  }
  return usize.MAX
}

// Closed-record unions share canonical tags across functions, keep field places for bindings, and
// lower matches to tag switches over a Tagged layout.
test effect fn structuralUnionsInjectBindAndSwitchOnTags() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("structural-unions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Left { value: i32 }
struct Right { marker: u8 value: i32 }
struct Empty {}
struct Token { value: i32 }
struct Pair { token: Token discarded: Token }
struct Holder { inner: Left | Empty }
fn inspect(input: Left | Right | Empty, open: bool) -> i32 {
  return match &input {
    Left { value } if open => value
    Right { value, .. } => value
    _ => 7
  }
}
fn total(pair: Pair) -> i32 { return match move pair { Pair { token: Token { value }, .. } => value } }
fn exclusive(token: Token) -> i32 { let mut held = token return match &mut held { Token { value } => value } }
fn same(input: Left | Token) -> i32 { return 0 }
pub fn main() -> i32 {
  return inspect(Left { value: 41 }, true) + total(Pair { token: Token { value: 1 }, discarded: Token { value: 0 } })
}
fn missing(input: Left | Right | Empty) -> i32 { return match &input { Left { value } => value Empty {} => 0 } }
fn duplicate(input: Left | Right | Empty) -> i32 { return match &input { Left { .. } => 1 Left { value } => value _ => 0 } }
fn afterUniversal(input: Left | Right | Empty) -> i32 { return match &input { _ => 1 Empty {} => 2 } }
fn covered(input: Left | Right | Empty) -> i32 { return match &input { Left { .. } => 1 Right { .. } => 2 Empty {} => 3 _ => 4 } }
fn foreign(input: Left | Right | Empty) -> i32 { return match &input { Token { value } => value _ => 0 } }
fn incomplete(input: Left | Right | Empty) -> i32 { return match &input { Left {} => 1 _ => 0 } }
fn refutable(holder: Holder) -> i32 { return match &holder { Holder { inner: Left { value } } => value } }
fn guardType(input: Left | Right | Empty, count: i32) -> i32 { return match &input { Left { value } if count => value _ => 0 } }
fn spelled(input: Empty | Right | Left) -> i32 { return 0 }
fn returned() -> Left | Empty { return Left { value: 1 } }
fn bound() -> i32 { let held: Left | Empty = Empty {} return 0 }
fn assigned() -> i32 { let mut held: Left | Empty = Empty {} held = Left { value: 2 } return 0 }
fn listed() -> i32 { let values: [Left | Empty; 2] = [Left { value: 3 }, Empty {}] return 0 }
fn armResult(input: Left | Right | Empty) -> Left | Empty { return match &input { Left { value } => Left { value: value } _ => Empty {} } }
fn wrong() -> Left | Empty { return Token { value: 1 } }
fn bare(input: Left | Empty) -> i32 { return match input { _ => 0 } }
fn openUnion(value: i32 | Token) -> i32 { return 0 }
fn deferredOpen() -> i32 { return openUnion(7) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let spelledAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"spelled")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut spelledType = Option.none<Shared<Type>>()
  let spelledBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&spelledAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move spelledBody {
    spelledType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
  }
  let mut spelledLayout = Option.none<Shared<BackendLayout>>()
  if let Option<Shared<Type>>.Some {value: ty} = move spelledType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex { spelledLayout = Semantic.layoutAt(&store, index) }
  }
  let inspectAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"inspect")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mainAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let totalAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"total")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusiveAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusive")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"same")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut leftArm = usize.MAX
  let mut rightArm = usize.MAX
  let mut leftValues = usize.ZERO
  let mut rightValues = usize.ZERO
  let mut unionType = Option.none<Shared<Type>>()
  let mut leftType = Option.none<Shared<Type>>()
  let checked1 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&inspectAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked1 {
    leftArm = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return recordArmTag(body, usize.ZERO) })
    rightArm = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return recordArmTag(body, usize.ONE) })
    leftValues = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, leftArm, usize.ZERO, usize.MAX) })
    rightValues = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, rightArm, usize.ONE, usize.MAX) })
    unionType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
    leftType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, firstArmMember)
  }
  let mut injected = usize.MAX
  let checked2 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&mainAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked2 {
    injected = Shared.with<TypedBody, usize>(&value, firstUnionInjectTag)
  }
  run Testing.expect(leftArm < 3 && rightArm < 3 && leftArm != rightArm && injected == leftArm,
    "an injected member and its pattern in another function share one canonical tag")
  run Testing.expect(leftValues >= usize.ONE && rightValues >= usize.ONE, "member field bindings are places under their member tag")
  let mut nested = usize.ZERO
  let mut consumed = true
  let checked3 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&totalAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked3 {
    nested = Shared.with<TypedBody, usize>(&value, fn(body: &TypedBody) -> usize { return bindingPlaces(body, usize.MAX, usize.ZERO, usize.ZERO) })
    consumed = Shared.with<TypedBody, bool>(&value, matchAddressesPlace)
  }
  let mut addressed = false
  let checked4 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&exclusiveAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked4 {
    addressed = Shared.with<TypedBody, bool>(&value, matchAddressesPlace)
  }
  run Testing.expect(nested >= usize.ONE && !consumed && addressed,
    "nested record bindings follow field paths; moves read a copy and exclusive matches address the place")
  let mut asymmetric = usize.MAX
  if let Option<Shared<Type>>.Some {value: ty} = move unionType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        asymmetric = Shared.with<BackendLayout, usize>(&facts, taggedLayout)
      }
    }
  }
  let mut equal = usize.MAX
  let mut sameType = Option.none<Shared<Type>>()
  let checked5 = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&sameAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move checked5 {
    sameType = Shared.with<TypedBody, Option<Shared<Type>>>(&value, enumParameterType)
  }
  if let Option<Shared<Type>>.Some {value: ty} = move sameType {
    let layoutAnswer = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let layoutIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layoutAnswer, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move layoutIndex {
      if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(&store, index) {
        equal = Shared.with<BackendLayout, usize>(&facts, taggedLayout)
      }
    }
  }
  run Testing.expect(asymmetric == 412 && equal == 408,
    "a one-byte tag precedes the largest member at the strictest member alignment")
  let mut canonicalMember = false
  if let Option<Shared<BackendLayout>>.Some {value: facts} = move spelledLayout {
    let selected = Shared.with<BackendLayout, Option<Shared<Type>>>(&facts, fn(layout: &BackendLayout) -> Option<Shared<Type>> {
      return taggedMemberAt(layout, leftArm)
    })
    if let Option<Shared<Type>>.Some {value: member} = move selected {
      if let Option<Shared<Type>>.Some {value: left} = move leftType { canonicalMember = run Type.equalsShared(&member, &left)
        |> Effect.provideMut<Allocator>(&mut allocator) }
    }
  }
  run Testing.expect(canonicalMember, "a differently spelled union demanded first still stores members in canonical tag order")
  let returned = run Semantic.demandBody(&mut store, &mut request, &id, b"returned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let assigned = run Semantic.demandBody(&mut store, &mut request, &id, b"assigned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let listed = run Semantic.demandBody(&mut store, &mut request, &id, b"listed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let armResult = run Semantic.demandBody(&mut store, &mut request, &id, b"armResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bare = run Semantic.demandBody(&mut store, &mut request, &id, b"bare")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&bare, RejectionCode.Unsupported, text, "match input { _ => 0 }", 0),
    "a bare record or union match remains an explicit unsupported access form")
  let deferredOpen = run Semantic.demandBody(&mut store, &mut request, &id, b"deferredOpen")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&deferredOpen, RejectionCode.UnionFormUnavailable, text, "openUnion(7)", 0),
    "a member of a union outside the closed-record lane stays a named union-form deferral")
  let returnedInjections = run injectionCount(&returned) |> Effect.provideMut<Allocator>(&mut allocator)
  let boundInjections = run injectionCount(&bound) |> Effect.provideMut<Allocator>(&mut allocator)
  let assignedInjections = run injectionCount(&assigned) |> Effect.provideMut<Allocator>(&mut allocator)
  let listedInjections = run injectionCount(&listed) |> Effect.provideMut<Allocator>(&mut allocator)
  let armInjections = run injectionCount(&armResult) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(returnedInjections == usize.ONE, "a returned member injects once")
  run Testing.expect(boundInjections == usize.ONE, "a typed binding initializer injects once")
  run Testing.expect(assignedInjections == 2, "an initializer and an assignment each inject")
  run Testing.expect(listedInjections == 2, "each contextual array element injects")
  run Testing.expect(armInjections == 2, "each union-typed arm result injects")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "Token { value: 1 }", 1),
    "a non-member return is a mismatch at the returned expression")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"inspect")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut switches = usize.ZERO
  let mut cases = usize.ZERO
  let mut discriminant = false
  let mut payload = false
  let mirIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move mirIndex {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases: selected, ..} = &blocks[at].terminator {
          switches = switches + usize.ONE
          cases = cases + Vector.length<MirSwitchCase>(&selected)
        }
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value, ..} = &statements[statementAt] {
            if let MirRvalue.Discriminant {..} = &value { discriminant = true }
            if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
              let projections = Vector.asSlice<MirProjection>(&place.projections)
              let mut step = usize.ZERO
              while step < projections.length {
                if let MirProjection.Payload {..} = &projections[step] { payload = true }
                step = step + usize.ONE
              }
            }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(discriminant && payload && switches == 2 && cases == 3,
    "the tag is read once and a false guard resumes the switch at the next arm")
  let built = run Semantic.buildMain(&mut store, &mut request, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut emitted = false
  match move built {
    BackendBuild.Module {text: ir, ..} => {
      let bytes = Bytes.asSlice(&ir)
      emitted = containsIr(bytes, b"switch i8") && containsIrLine(bytes, b"getelementptr i8", b", i64 4")
    }
    _ => ()
  }
  run Testing.expect(emitted, "tags and payload offsets are spelled from the Tagged layout")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let afterUniversal = run Semantic.demandBody(&mut store, &mut request, &id, b"afterUniversal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let covered = run Semantic.demandBody(&mut store, &mut request, &id, b"covered")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let incomplete = run Semantic.demandBody(&mut store, &mut request, &id, b"incomplete")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let refutable = run Semantic.demandBody(&mut store, &mut request, &id, b"refutable")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let guardType = run Semantic.demandBody(&mut store, &mut request, &id, b"guardType")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&missing, RejectionCode.MissingUnionMember, text, "match &input { Left { value } => value Empty {} => 0 }", 0) &&
    rejectsSpan(&duplicate, RejectionCode.DuplicateMatchPattern, text, "Left { value }", 2) &&
    rejectsSpan(&afterUniversal, RejectionCode.MatchArmAfterUniversal, text, "Empty {}", 2) &&
    rejectsSpan(&covered, RejectionCode.UnreachableMatchArm, text, "_", 3) &&
    rejectsSpan(&foreign, RejectionCode.TypeMismatch, text, "Token { value }", 2) &&
    rejectsSpan(&incomplete, RejectionCode.InvalidRecordPattern, text, "Left {}", 0) &&
    rejectsSpan(&refutable, RejectionCode.RefutableSubpattern, text, "Left { value }", 3) &&
    rejectsSpan(&guardType, RejectionCode.ConditionNotBool, text, "count", 1),
    "union coverage, foreign members, field lists, refutable subpatterns and guards report precise spans",
  )
  return ()
}

fn variantConstructions(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut encoded = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.VariantConstruct {tag, fields}, ..} = &nodes[at].kind {
      encoded = encoded * 10 + tag * 3 + Vector.length<BodyAggregateField>(&fields) + usize.ONE
    }
    at = at + usize.ONE
  }
  return encoded
}

fn matchTagCount(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {tags, ..}, ..} = &nodes[at].kind { return tags }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn matchArmCount(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      return Vector.length<BodyMatchArm>(&arms)
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn variantArmTag(body: &TypedBody, arm: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[at].kind {
      let written = Vector.asSlice<BodyMatchArm>(&arms)
      if arm < written.length {
        if let BodyPattern.Variant {tag} = &written[arm].pattern { return tag }
      }
      return usize.MAX
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn variantBindings(body: &TypedBody, tag: usize, field: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.PatternBinding {path, ..}, ..} = &nodes[at].kind {
      let steps = Vector.asSlice<BodyPatternStep>(&path)
      if steps.length == usize.ONE {
        if let BodyPatternStep.VariantField {tag: selected, field: index} = &steps[usize.ZERO] {
          if selected == tag && index == field { found = found + usize.ONE }
        }
      }
    }
    at = at + usize.ONE
  }
  return found
}

fn variantsLayout(layout: &BackendLayout) -> bool {
  if let LayoutStorage.Variants {tagSize, payloadOffset, ..} = &layout.storage {
    let height = BackendLayout.variantField(layout, usize.ONE, usize.ONE)
    let radius = BackendLayout.variantField(layout, usize.ZERO, usize.ZERO)
    let mut offsets = false
    if let Option<LayoutField>.Some {value: second} = &height {
      if let Option<LayoutField>.Some {value: first} = &radius { offsets = second.offset == 16 && first.offset == 8 }
    }
    return tagSize == usize.ONE && payloadOffset == 8 && layout.size == 24 && layout.alignment == 8 && offsets
  }
  return false
}

// Non-generic nominal unions tag variants in declaration order, lay each variant out like a record
// after the tag, bind variant fields as places and switch on the tag.
test effect fn nominalUnionsDiagTypingMake() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nominal-unions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
union Generic<T> { Some { value: T }, None }
struct Holder { shape: Shape }
fn make(kind: i32) -> Shape {
  if kind == 0 { return Shape.Circle { radius: 3 } }
  return Shape.Empty
}
fn area(shape: &Shape) -> i32 {
  return match &shape.* {
    Shape.Circle { radius } => radius
    Shape.Rect { width, .. } if width > 10 => width
    Shape.Rect { width, height } => width
    Shape.Empty => 0
  }
}
pub fn main() -> i32 { let shape = make(0) return area(&shape) }
fn missing(shape: Shape) -> i32 { return match move shape { Shape.Circle { radius } => radius Shape.Empty => 0 } }
fn duplicate(shape: Shape) -> i32 { return match move shape { Shape.Empty => 0 Shape.Empty => 1 _ => 2 } }
fn unknownField() -> Shape { return Shape.Circle { size: 1 } }
fn fieldCount() -> Shape { return Shape.Rect { width: 1 } }
fn payloadUnit() -> Shape { return Shape.Rect }
fn unitPattern(shape: Shape) -> i32 { return match move shape { Shape.Rect => 1 _ => 0 } }
fn nested(holder: Holder) -> i32 { return match move holder { Holder { shape: Shape.Empty {} } => 0 } }
fn generic() -> i32 { let value = Generic.Some { value: 1 } return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let makeAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"make")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut constructions = usize.ZERO
  let madeBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&makeAnswer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move madeBody {
    constructions = Shared.with<TypedBody, usize>(&value, variantConstructions)
  }
  run Testing.expect(constructions == 27, "a payload variant keeps its tag and field operand and a unit variant has none")
  return ()
}

