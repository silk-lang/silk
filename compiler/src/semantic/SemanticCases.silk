// A nominal type argument is covariant when its declaration stores it covariantly (bootstrap
// NominalVariance); behind an exclusive reference it stays exact.
test effect fn covariantTypeArgumentsShortenRegions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("type-argument-regions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Maybe<T> { Empty, Held { value: T } }
fn optionalView<'a>(bytes: &'a [u8]) -> Maybe<&'a [u8]> { let held = Maybe<&'static [u8]>.Held {value: b"x"} return move held }
struct InvariantBox<'s, T> { place: &'s mut T }
fn pinned<'a, 's>(bytes: &'a [u8], slot: InvariantBox<'s, &'static [u8]>) -> InvariantBox<'s, &'a [u8]> { let moved = move slot return move moved }
fn pinnedParameter<'a, 's>(bytes: &'a [u8], slot: InvariantBox<'s, &'static [u8]>) -> InvariantBox<'s, &'a [u8]> { return move slot }
struct Phantom<T> {}
fn emptyPhantom<'a>(bytes: &'a [u8]) -> Phantom<&'a [u8]> { let empty = Phantom<&'static [u8]> {} return move empty }
fn sealedPinned<'a, 's>(bytes: &'a [u8], slot: Slot<'s, &'static [u8]>) -> Slot<'s, &'a [u8]> { let moved = move slot return move moved }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let optionalView = run providedProvesRegions(&mut store, &mut request, &id, "optionalView")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(optionalView, "a covariant type argument shortens its 'static reference to the declared region")
  let pinned = run providedRejects(&mut store, &mut request, &id, "pinned", RejectionCode.TypeMismatch,
    text, "move moved", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(pinned, "a type argument behind an exclusive reference stays exact")
  let pinnedParameter = run providedRejects(&mut store, &mut request, &id, "pinnedParameter", RejectionCode.TypeMismatch,
    text, "move slot", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(pinnedParameter, "a moved parameter keeps its invariant stored type at the return boundary")
  let emptyPhantom = run providedProvesRegions(&mut store, &mut request, &id, "emptyPhantom")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(emptyPhantom, "a known empty source record proves covariance without confusing unavailable metadata with emptiness")
  let sealedPinned = run providedRejects(&mut store, &mut request, &id, "sealedPinned", RejectionCode.TypeMismatch,
    text, "move moved", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(sealedPinned, "opaque core Slot storage has no source member proof of covariance")
  return ()
}

// A caller-local region the bootstrap infers by flow meets the declared region at the boundary that
// fixes it as an open relation: a loan through a call-local view, an operand of a fixed type binder
// and a variant pattern's written region. Body-owned storage and invariant evidence stay exact.
test effect fn callerLocalRegionsRelateAtFixedBoundaries() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("caller-local-regions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Inner { values: [u8; 4] }
fn whole(inner: &Inner) -> &[u8] { return &inner.values }
struct Outer { inner: Inner }
struct Name<'a> { bytes: &'a [u8] }
union Config<'a> { Disabled, Offered { protocols: &'a [u8] } }
union Maybe<T> { Empty, Held { value: T } }
fn element<'a>(outer: &'a Outer) -> &'a u8 { let view = whole(&outer.inner) return &view[0] }
fn dangling<'a>(outer: &'a Outer) -> &'a Inner { let owned = Inner {values: [0, 0, 0, 0]} return &owned }
fn wrap<T>(value: T) -> Maybe<T> { return Maybe<T>.Held {value: move value} }
fn wrapped<'a>(outer: &'a Outer) -> Maybe<&'a u8> { return wrap<&'a u8>(&outer.inner.values[0]) }
fn viewed<'a>(outer: &'a Outer) -> i32 {
  let found = wrap(whole(&outer.inner))
  match move found {
    Maybe<&'a [u8]>.Held {value} => { return 1 }
    Maybe<&'a [u8]>.Empty => { return 0 }
  }
}
fn bothConfigs<'v>(first: Config<'v>, second: &Config<'v>) -> i32 { return 0 }
fn shortensStatic(outer: &Outer) -> i32 {
  let local = Config.Offered {protocols: whole(&outer.inner)}
  return bothConfigs(Config<'static>.Disabled, &local)
}
fn pinnedConfigs<'v>(first: &mut Config<'v>, second: &Config<'v>) -> i32 { return 0 }
fn keepsStatic(outer: &Outer) -> i32 {
  let local = Config.Offered {protocols: whole(&outer.inner)}
  let mut fixed = Config<'static>.Disabled
  return pinnedConfigs(&mut fixed, &local)
}
fn takeNames<'v>(first: Name<'v>, second: &Name<'v>, third: &Name<'v>) -> i32 { return 0 }
fn mixedNames(outer: &Outer, fixed: Name<'static>) -> i32 {
  let local = Name {bytes: whole(&outer.inner)}
  return takeNames(Name<'static> {bytes: b"fixed"}, &local, &fixed)
}
struct Method<'a> { bytes: &'a [u8] }
struct Target<'a> { bytes: &'a [u8] }
struct Headers<'a> { bytes: &'a [u8] }
struct Policy<'a> { bytes: &'a [u8] }
fn prepare<'v>(method: Method<'v>, target: Target<'v>, headers: &Headers<'v>, policy: &Policy<'v>) -> i32 { return 0 }
fn httpStyle(outer: &Outer, method: Method<'static>, target: Target<'static>, policy: Policy<'static>) -> i32 {
  let local = Headers {bytes: whole(&outer.inner)}
  return prepare(move method, move target, &local, &policy)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let element = run providedRelates(&mut store, &mut request, &id, "element", text, "&view[0]", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(element, "a loan through a call-local view meets a declared region as an open relation")
  let dangling = run providedRejects(&mut store, &mut request, &id, "dangling", RejectionCode.TypeMismatch,
    text, "&owned", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(dangling, "a fresh loan of body-owned storage never meets a declared region")
  let wrapped = run providedRelates(&mut store, &mut request, &id, "wrapped", text, "&outer.inner.values[0]", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(wrapped, "a call-region loan meets a written type binder's declared region as an open relation")
  let viewed = run providedRelates(&mut store, &mut request, &id, "viewed", text, "Maybe<&'a [u8]>.Held {value}", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(viewed, "a variant pattern writing a declared region relates a call-local subject region")
  let shortensStatic = run providedSucceeds(&mut store, &mut request, &id, "shortensStatic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(shortensStatic, "a covariant binder fixed by 'static evidence shortens to later caller-local evidence")
  let keepsStatic = run providedRejects(&mut store, &mut request, &id, "keepsStatic", RejectionCode.TypeMismatch,
    text, "pinnedConfigs(&mut fixed, &local)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(keepsStatic, "a binder behind an exclusive reference keeps its 'static evidence")
  let mixedNames = run providedSucceeds(&mut store, &mut request, &id, "mixedNames")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mixedNames, "a later borrowed static operand meets a binder shortened by a caller-local nominal operand")
  let httpStyle = run providedSucceeds(&mut store, &mut request, &id, "httpStyle")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(httpStyle, "static method and target, local headers and a borrowed static policy share the inferred storage region")
  return ()
}

// LIFE-003: a pattern annotation takes each lifetime it elides from the subject it matches; every
// written part of the annotation must still agree with the subject exactly.
test effect fn patternElisionInfersOmittedLifetimesFromTheSubject() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("pattern-elision-region.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Maybe<T> { Some { value: T }, None }
union Other<T> { Some { value: T }, None }
union Pair<A, B> { Both { first: A, second: B } }
union Outcome<T, E> { Success { value: T }, Failure { error: E } }
struct Holder<T> { held: T }
struct Left { value: i32 }
fn omitted(subject: Maybe<&'static i32>) -> i32 {
 return match move subject { Maybe<&i32>.Some {value} => value.* Maybe<&i32>.None => 0 }
}
fn exact(subject: Maybe<&'static i32>) -> i32 {
 return match move subject { Maybe<&'static i32>.Some {value} => value.* Maybe<&'static i32>.None => 0 }
}
fn explicit<'a>(subject: Maybe<&'static i32>) -> i32 {
 return match move subject { Maybe<&'a i32>.Some {value} => value.* Maybe<&'a i32>.None => 0 }
}
fn owner(subject: Maybe<&'static i32>) -> i32 {
 return match move subject { Other<&i32>.Some {value} => value.* _ => 0 }
}
fn referent(subject: Maybe<&'static i32>) -> i32 {
 return match move subject { Maybe<&bool>.Some {value} => 0 _ => 0 }
}
fn access(subject: Maybe<&'static mut i32>) -> i32 {
 return match move subject { Maybe<&i32>.Some {value} => value.* _ => 0 }
}
fn laterMismatch(subject: Pair<&'static i32, bool>) -> i32 {
 return match move subject { Pair<&i32, i32>.Both {first, second} => first.* }
}
fn region<'a>(found: Maybe<string<'a>>) -> i32 {
 if let Maybe<string>.Some {value: text} = move found { return 42 }
 return 1
}
fn nested<'a>(found: Outcome<string<'a>, bool>, fallback: string<'a>) -> string<'a> {
 return match move found { Outcome<string, bool>.Success {value} => value Outcome<string, bool>.Failure {error: _} => fallback }
}
fn record<'a>(subject: Holder<&'a i32>) -> &'a i32 {
 return match move subject { Holder<&i32> {held} => held }
}
fn member<'a>(subject: Left | Holder<&'a i32>, fallback: &'a i32) -> &'a i32 {
 return match move subject { Holder<&i32> {held} => held Left _ => fallback }
}
fn recordMismatch<'a>(subject: Holder<&'a i32>) -> i32 {
 return match move subject { Holder<&bool> {held} => 0 }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let omitted = run providedSucceeds(&mut store, &mut request, &id, "omitted") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(omitted, "an omitted reference lifetime takes the subject's static lifetime")
  let region = run providedSucceeds(&mut store, &mut request, &id, "region") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(region, "an omitted String lifetime takes the subject's declared lifetime")
  let nested = run providedSucceeds(&mut store, &mut request, &id, "nested") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(nested, "a binding below an elided qualifier carries the subject's exact lifetime")
  let record = run providedSucceeds(&mut store, &mut request, &id, "record") |> Effect.provideMut<Allocator>(&mut allocator)
  let member = run providedSucceeds(&mut store, &mut request, &id, "member") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(record && member, "record annotations infer elided lifetimes from the record or union member they select")
  let recordMismatch = run providedRejects(&mut store, &mut request, &id, "recordMismatch", RejectionCode.TypeMismatch,
    text, "Holder<&bool> {held}", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(recordMismatch, "an elided record annotation still names its subject's written referent")
  let exact = run providedSucceeds(&mut store, &mut request, &id, "exact") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(exact, "an exact explicit pattern lifetime retains ordinary union selection")
  let explicit = run providedProvesRegions(&mut store, &mut request, &id, "explicit") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(explicit, "a 'static subject meets an explicit shorter pattern region, as in the bootstrap")
  let owner = run providedRejects(&mut store, &mut request, &id, "owner", RejectionCode.TypeMismatch,
    text, "Other<&i32>.Some {value}", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(owner, "same-shaped nominal owners never share pattern elision evidence")
  let referent = run providedRejects(&mut store, &mut request, &id, "referent", RejectionCode.TypeMismatch,
    text, "Maybe<&bool>.Some {value}", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(referent, "an elided lifetime never hides a different referent")
  let access = run providedRejects(&mut store, &mut request, &id, "access", RejectionCode.TypeMismatch,
    text, "Maybe<&i32>.Some {value}", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(access, "an elided lifetime never changes reference access")
  let later = run providedRejects(&mut store, &mut request, &id, "laterMismatch", RejectionCode.TypeMismatch,
    text, "Pair<&i32, i32>.Both {first, second}", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(later, "an earlier elided lifetime never excuses a later argument mismatch")
  return ()
}

fn bindingRegion(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> Option<Shared<Lifetime>> {
  if let Option<Shared<Type>>.Some {value} = move bodyLocalType(answer, at) {
    return Shared.with<Type, Option<Shared<Lifetime>>>(&value, fn(ty: &Type) -> Option<Shared<Lifetime>> {
      return match &ty.* {
        Type.String {lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
        Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
        Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
        _ => Option.none<Shared<Lifetime>>()
      }
    })
  }
  return Option.none<Shared<Lifetime>>()
}

fn bindingRegionIsStatic(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> bool {
  if let Option<Shared<Lifetime>>.Some {value} = move bindingRegion(answer, at) {
    return Shared.with<Lifetime, bool>(&value, fn(region: &Lifetime) -> bool {
      return match &region.* { Lifetime.Static => true _ => false }
    })
  }
  return false
}

// Whether a local's region is the first lifetime parameter of `owner`, or a loan in its body.
fn bindingRegionOf(answer: &Shared<Result<Answer, NoRejection>>, at: usize, owner: &[u8], parameter: bool) -> bool {
  if let Option<Shared<Lifetime>>.Some {value} = move bindingRegion(answer, at) {
    return Shared.with<Lifetime, bool>(&value, fn(region: &Lifetime) -> bool {
      return match &region.* {
        Lifetime.Parameter {declaration, ordinal} => parameter && ordinal == usize.ZERO && DeclarationId.named(&declaration, owner)
        Lifetime.Local {declaration, ..} => !parameter && DeclarationId.named(&declaration, owner)
        _ => false
      }
    })
  }
  return false
}

struct BodyPrefixCall {
  application: Shared<SpecializationApplication>
  origin: BodyOrigin
  result: Shared<Type>
  operand: Option<Shared<Type>>
  secondOperand: Option<Shared<Type>>
  callerRegion: bool
}

fn bodyPrefixRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match &value.* {
    Type.Reference {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.Slice {lifetime, ..} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    Type.String {lifetime} => Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&lifetime))
    _ => Option.none<Shared<Lifetime>>()
  }
}

fn bodyPrefixPayload(value: &Type, owner: &[u8], ordinal: usize) -> Option<Shared<Type>> {
  if let Type.Nominal {declaration, arguments, ..} = &value.* {
    let given = Vector.asSlice<Argument>(&arguments)
    if DeclarationId.named(&declaration, owner) && ordinal < given.length {
      if let Argument.Type {value: selected} = &given[ordinal] {
        return Option.some<Shared<Type>>(Shared.clone<Type>(&selected))
      }
    }
  }
  return Option.none<Shared<Type>>()
}

fn bodyPrefixCallerRegion(ty: &Shared<Type>, caller: &DeclarationId) -> bool {
  let region = Shared.with<Type, Option<Shared<Lifetime>>>(ty, bodyPrefixRegion)
  if let Option<Shared<Lifetime>>.Some {value} = move region {
    return Shared.with<Lifetime, bool>(&value, fn(found: &Lifetime) -> bool {
      return match &found.* {
        Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, caller)
        Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, caller)
        _ => false
      }
    })
  }
  return false
}

fn bodyPrefixCall(body: &TypedBody, target: &[u8], input: usize, wrapper: &[u8]) -> Option<BodyPrefixCall> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, application, arguments, ..}} = &nodes[at].kind {
      if DeclarationId.named(&declaration, target) {
        let original = Shared.with<SpecializationApplication, bool>(&application,
          fn(selected: &SpecializationApplication) -> bool {
            return DeclarationId.equals(SpecializationApplication.bodyDeclaration(selected), &declaration)
          })
        if !original || !ModuleId.equals(DeclarationId.moduleId(&declaration), DeclarationId.moduleId(TypedBody.declarationId(body))) {
          return Option.none<BodyPrefixCall>()
        }
        let supplied = Vector.asSlice<BodyNodeId>(&arguments)
        let mut operand = Option.none<Shared<Type>>()
        let mut secondOperand = Option.none<Shared<Type>>()
        if input != usize.MAX {
          if input >= supplied.length || supplied[input].index >= nodes.length { return Option.none<BodyPrefixCall>() }
          if let BodyNodeKind.Expression {ty: actual, ..} = &nodes[supplied[input].index].kind {
            operand = Option.some<Shared<Type>>(Shared.clone<Type>(&actual))
          } else { return Option.none<BodyPrefixCall>() }
          if input + usize.ONE < supplied.length {
            if supplied[input + usize.ONE].index >= nodes.length { return Option.none<BodyPrefixCall>() }
            if let BodyNodeKind.Expression {ty: actual, ..} = &nodes[supplied[input + usize.ONE].index].kind {
              secondOperand = Option.some<Shared<Type>>(Shared.clone<Type>(&actual))
            } else { return Option.none<BodyPrefixCall>() }
          }
        }
        let payload = Shared.with<Type, Option<Shared<Type>>>(&ty,
          fn(result: &Type) -> Option<Shared<Type>> { return bodyPrefixPayload(result, wrapper, usize.ZERO) })
        let mut callerRegion = false
        if let Option<Shared<Type>>.Some {value} = move payload {
          callerRegion = bodyPrefixCallerRegion(&value, TypedBody.declarationId(body))
        }
        return Option.some<BodyPrefixCall>(BodyPrefixCall {
          application: Shared.clone<SpecializationApplication>(&application), origin: nodes[at].origin, result: Shared.clone<Type>(&ty),
          operand: move operand, secondOperand: move secondOperand, callerRegion: callerRegion})
      }
    }
    at = at + usize.ONE
  }
  return Option.none<BodyPrefixCall>()
}

fn bodyPrefixFixedType(value: &Type, shape: usize) -> bool {
  if shape == 3 { return match &value.* { Type.String {..} => true _ => false } }
  if shape == usize.ZERO {
    if let Type.Slice {element, access, ..} = &value.* {
      return access == Access.Shared && Shared.with<Type, bool>(&element,
        fn(found: &Type) -> bool { return witnessPrimitive(found, b"u8") })
    }
  }
  if let Type.Reference {referent, access, ..} = &value.* {
    let mut expected = Access.Shared
    if shape == 2 { expected = Access.Mutable }
    return access == expected && Shared.with<Type, bool>(&referent, fn(found: &Type) -> bool {
      return match &found.* { Type.Nominal {declaration, arguments, ..} => DeclarationId.named(&declaration, b"Entry")
        && Vector.length<Argument>(&arguments) == usize.ZERO _ => false }
    })
  }
  return false
}

fn bodyPrefixScopeParameter(value: &Type, scope: &ScopeBinding, ordinal: usize) -> bool {
  if let Type.Parameter {declaration, ordinal: original} = &value.* {
    if original != ordinal { return false }
    return Shared.with<DeclarationId, bool>(&scope.owner,
      fn(owner: &DeclarationId) -> bool { return DeclarationId.equals(owner, &declaration) })
  }
  return false
}
fn bodyPrefixSharedReferent(value: &Type) -> Option<Shared<Type>> {
  if let Type.Reference {referent, access, ..} = &value.* {
    if access == Access.Shared { return Option.some<Shared<Type>>(Shared.clone<Type>(&referent)) }
  }
  return Option.none<Shared<Type>>()
}

// checkExpectedValue preserves the canonical application but retypes its contextual view.
// COMPILER_COMPATIBILITY's caller-local region contract requires the exact unproven pair.
fn bodyPrefixContextualRelation(body: &TypedBody, origin: BodyOrigin,
  offered: &Shared<Type>, wanted: &Shared<Type>) -> bool {
  let source = Shared.with<Type, Option<Shared<Lifetime>>>(offered, bodyPrefixRegion)
  let target = Shared.with<Type, Option<Shared<Lifetime>>>(wanted, bodyPrefixRegion)
  if let Option<Shared<Lifetime>>.Some {value: sourceRegion} = move source {
    if let Option<Shared<Lifetime>>.Some {value: targetRegion} = move target {
      if !Shared.with<Lifetime, bool>(&sourceRegion, fn(region: &Lifetime) -> bool {
        return match &region.* { Lifetime.Local {declaration, ..} => DeclarationId.equals(&declaration, TypedBody.declarationId(body)) _ => false }
      }) || !Shared.with<Lifetime, bool>(&targetRegion, fn(region: &Lifetime) -> bool {
        return match &region.* { Lifetime.Parameter {declaration, ..} => DeclarationId.equals(&declaration, TypedBody.declarationId(body)) _ => false }
      }) { return false }
      let stage = TypedBody.checkingStage(body)
      if let BodyStage.ContractTyped {obligations} = &stage.* {
        let entries = Vector.asSlice<BodySafetyObligation>(&obligations)
        let mut at = usize.ZERO
        while at < entries.length {
          if let BodySafetyObligation.RegionRelation {origin: retained, offered: from, wanted: to} = &entries[at] {
            if retained.syntax.index == origin.syntax.index && retained.span.start == origin.span.start
              && retained.span.end == origin.span.end && Lifetime.equalsShared(&from, &sourceRegion)
              && Lifetime.equalsShared(&to, &targetRegion) { return true }
          }
          at = at + usize.ONE
        }
      }
    }
  }
  return false
}

effect fn bodyPrefixSelected(answer: &Shared<Result<Answer, NoRejection>>,
  signature: &Shared<Result<Answer, NoRejection>>, expected: Option<Shared<Type>>,
  target: &[u8], shape: usize, absent: bool, failure: bool) -> bool
! OutOfMemoryError ? &mut Allocator {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  let mut wrapper: &'static [u8] = b"Maybe"
  if failure { wrapper = b"Outcome" }
  let mut input = usize.ZERO
  if absent { input = usize.MAX }
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    let call = Shared.with<TypedBody, Option<BodyPrefixCall>>(&typed,
      fn(value: &TypedBody) -> Option<BodyPrefixCall> { return bodyPrefixCall(value, target, input, wrapper) })
    if let Option<BodyPrefixCall>.Some {value: selected} = move call {
      if !selected.callerRegion { return false }
      let application = run SpecializationApplication.copyShared(&selected.application)
      let scopes = Vector.asSlice<ScopeBinding>(&application.scopes)
      if Vector.length<Argument>(&application.arguments) != usize.ZERO
        || Vector.length<usize>(&application.argumentOrdinals) != usize.ZERO || scopes.length != usize.ONE { return false }
      let given = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
      let ordinals = Vector.asSlice<usize>(&scopes[usize.ZERO].argumentOrdinals)
      let mut count = usize.ONE
      if failure { count = 2 }
      if given.length != count || ordinals.length != count || ordinals[usize.ZERO] != usize.ZERO { return false }
      let raw = contractSlotOf(signature, input)
      let mut rawParameter = Option.none<Shared<Type>>()
      if absent {
        let extractedRaw = match move raw {
          Option<Shared<Type>>.Some {value} => Shared.with<Type, Option<Shared<Type>>>(&value,
            fn(result: &Type) -> Option<Shared<Type>> { return bodyPrefixPayload(result, b"Maybe", usize.ZERO) })
          _ => Option.none<Shared<Type>>()
        }
        rawParameter = move extractedRaw
      } else { rawParameter = move raw }
      let mut originalOrdinal = usize.ZERO
      if failure { originalOrdinal = usize.ONE }
      if let Option<Shared<Type>>.Some {value: parameter} = move rawParameter {
        let original = Shared.with<Type, bool>(&parameter,
          fn(value: &Type) -> bool { return bodyPrefixScopeParameter(value, &scopes[usize.ZERO], originalOrdinal) })
        if !original { return false }
      } else { return false }
      if let Argument.Type {value: closed} = &given[usize.ZERO] {
        if !Shared.with<Type, bool>(&closed, fn(value: &Type) -> bool { return bodyPrefixFixedType(value, shape) }) { return false }
        let rawResult = match move contractSlotOf(signature, usize.MAX) {
          Option<Shared<Type>>.Some {value} => move value
          _ => { return false }
        }
        let bindings = run SpecializationApplication.bindings(&application)
        let canonical = run Type.applyBindings(&rawResult, Vector.asSlice<Binding>(&bindings), true)
        let canonicalPayload = Shared.with<Type, Option<Shared<Type>>>(&canonical,
          fn(value: &Type) -> Option<Shared<Type>> { return bodyPrefixPayload(value, wrapper, usize.ZERO) })
        if !(run typesEqual(Option.some<Shared<Type>>(Shared.clone<Type>(&closed)), move canonicalPayload)) { return false }
        let returned = Shared.with<Type, Option<Shared<Type>>>(&selected.result,
          fn(value: &Type) -> Option<Shared<Type>> { return bodyPrefixPayload(value, wrapper, usize.ZERO) })
        let viewed = match move returned {
          Option<Shared<Type>>.Some {value} => move value
          _ => { return false }
        }
        let sameResult = run typesEqual(Option.some<Shared<Type>>(Shared.clone<Type>(&closed)),
          Option.some<Shared<Type>>(Shared.clone<Type>(&viewed)))
        if !sameResult {
          if shape != usize.ONE || absent || failure { return false }
          let sourceReferent = Shared.with<Type, Option<Shared<Type>>>(&closed, bodyPrefixSharedReferent)
          let viewedReferent = Shared.with<Type, Option<Shared<Type>>>(&viewed, bodyPrefixSharedReferent)
          if !(run typesEqual(move sourceReferent, move viewedReferent)) { return false }
          match &expected {
            Option<Shared<Type>>.Some {value} => { if !(run Type.equalsShared(&selected.result, &value)) { return false } }
            _ => { return false }
          }
          if !Shared.with<TypedBody, bool>(&typed, fn(body: &TypedBody) -> bool {
            return bodyPrefixContextualRelation(body, selected.origin, &closed, &viewed)
          }) { return false }
        }
        if failure {
          if ordinals[usize.ONE] != usize.ONE { return false }
          if let Argument.Type {value: error} = &given[usize.ONE] {
            if !(run typesEqual(Option.some<Shared<Type>>(Shared.clone<Type>(&error)), move selected.operand)) { return false }
          } else { return false }
        } else if !absent {
          if !(run typesEqual(Option.some<Shared<Type>>(Shared.clone<Type>(&closed)), move selected.operand)) { return false }
        }
        if absent || failure {
          return run typesEqual(Option.some<Shared<Type>>(move selected.result), move expected)
        }
        return true
      }
    }
  }
  return false
}

effect fn bodyPrefixLeadingOrdinals(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let application = run directApplicationAt(answer, usize.ZERO)
  let locals = bodyLocalType(answer, usize.ONE)
  if let Option<SpecializationApplication>.Some {value} = move application {
    let given = Vector.asSlice<Argument>(&value.arguments)
    let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
    if !DeclarationId.named(SpecializationApplication.bodyDeclaration(&value), b"leading")
      || given.length != 2 || ordinals.length != 2 || ordinals[usize.ZERO] != usize.ZERO || ordinals[usize.ONE] != usize.ONE
      || Vector.length<ScopeBinding>(&value.scopes) != usize.ZERO { return false }
    if let Argument.Type {value: selected} = &given[usize.ONE] {
      if !(run typesEqual(Option.some<Shared<Type>>(Shared.clone<Type>(&selected)), move locals)) { return false }
      let region = Shared.with<Type, Option<Shared<Lifetime>>>(&selected, bodyPrefixRegion)
      if let Argument.Lifetime {value: fixed} = &given[usize.ZERO] {
        let declared = Shared.with<Lifetime, bool>(&fixed, fn(region: &Lifetime) -> bool {
          return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.named(&declaration, b"callLeading")
            && ordinal == usize.ZERO _ => false }
        })
        if !declared { return false }
        if let Option<Shared<Lifetime>>.Some {value: inferred} = move region { return Lifetime.equalsShared(&fixed, &inferred) }
      }
    }
  }
  return false
}

effect fn bodyPrefixTargetSignature(store: &mut Semantic, request: &mut Request,
  answer: &Shared<Result<Answer, NoRejection>>) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let selected = run directApplicationAt(answer, usize.ZERO)
  if let Option<SpecializationApplication>.Some {value} = move selected {
    return run Semantic.demandSignatureOf(&mut store.*, &mut request.*, SpecializationApplication.bodyDeclaration(&value))
  }
  // Preserve the actual failed/body answer: it cannot satisfy a signature contract predicate.
  return Shared.clone<Result<Answer, NoRejection>>(answer)
}

effect fn bodyPrefixIndependentRegions(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    let call = Shared.with<TypedBody, Option<BodyPrefixCall>>(&typed,
      fn(value: &TypedBody) -> Option<BodyPrefixCall> { return bodyPrefixCall(value, b"join", usize.ZERO, b"Duo") })
    if let Option<BodyPrefixCall>.Some {value: selected} = move call {
      if !selected.callerRegion { return false }
      let application = run SpecializationApplication.copyShared(&selected.application)
      let given = Vector.asSlice<Argument>(&application.arguments)
      let ordinals = Vector.asSlice<usize>(&application.argumentOrdinals)
      if given.length != 2 || ordinals.length != 2 || ordinals[usize.ZERO] != usize.ZERO || ordinals[usize.ONE] != usize.ONE
        || Vector.length<ScopeBinding>(&application.scopes) != usize.ZERO || Vector.length<StaticSlot>(&application.statics) != usize.ZERO { return false }
      let mut firstRegion = Option.none<Shared<Lifetime>>()
      let mut at = usize.ZERO
      while at < given.length {
        if let Argument.Type {value: closed} = &given[at] {
          if !Shared.with<Type, bool>(&closed, fn(value: &Type) -> bool { return bodyPrefixFixedType(value, usize.ONE) }) { return false }
          let operand = bodyPrefixPairOperand(&selected, at)
          if !(run typesEqual(Option.some<Shared<Type>>(Shared.clone<Type>(&closed)), move operand)) { return false }
          let returned = Shared.with<Type, Option<Shared<Type>>>(&selected.result,
            fn(value: &Type) -> Option<Shared<Type>> { return bodyPrefixPayload(value, b"Duo", at) })
          if !(run typesEqual(Option.some<Shared<Type>>(Shared.clone<Type>(&closed)), move returned)) { return false }
          let region = Shared.with<Type, Option<Shared<Lifetime>>>(&closed, bodyPrefixRegion)
          if let Option<Shared<Lifetime>>.Some {value} = move region {
            let original = Shared.with<TypedBody, bool>(&typed, fn(body: &TypedBody) -> bool {
              return bodyPrefixPairRegion(&value, TypedBody.declarationId(body), at)
            })
            if !original { return false }
            if at == usize.ZERO { firstRegion = Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&value)) }
            else {
              if let Option<Shared<Lifetime>>.Some {value: first} = &firstRegion {
                if Lifetime.equalsShared(&first, &value) { return false }
              } else { return false }
            }
          } else { return false }
        } else { return false }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

fn bodyPrefixPairOperand(value: &BodyPrefixCall, ordinal: usize) -> Option<Shared<Type>> {
  if ordinal == usize.ZERO {
    if let Option<Shared<Type>>.Some {value: operand} = &value.operand {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&operand))
    }
  } else if ordinal == usize.ONE {
    if let Option<Shared<Type>>.Some {value: operand} = &value.secondOperand {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&operand))
    }
  }
  return Option.none<Shared<Type>>()
}

fn bodyPrefixPairRegion(value: &Shared<Lifetime>, caller: &DeclarationId, position: usize) -> bool {
  return Shared.with<Lifetime, bool>(value, fn(region: &Lifetime) -> bool {
    return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.equals(&declaration, caller)
      && ordinal == position _ => false }
  })
}

// LIFE-003: a binding annotation takes each lifetime it elides from its initializer, and a written
// constructor qualifier from its operands or its same-owner expectation.
test effect fn bindingAndConstructionElisionInferOmittedLifetimes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("binding-elision-region.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Maybe<T> { Some { value: T }, None }
impl<T> Maybe<T> {
 fn some(value: T) -> Maybe<T> { return Maybe<T>.Some {value: move value} }
 fn none() -> Maybe<T> { return Maybe<T>.None }
}
union Outcome<A, E> { Success {value: A}, Failure {error: E} }
impl<A, E> Outcome<A, E> {
 fn failResult(error: E) -> Outcome<A, E> { return Outcome<A, E>.Failure {error: move error} }
}
struct Entry {value: i32}
struct Error {value: i32}
struct Holder<T> { held: T }
fn letStatic() -> i32 {
 let mut held: &[u8] = b"dynamic"
 held = b"static"
 return 42
}
fn letRegion<'a>(text: string<'a>) -> string<'a> {
 let copied: string = text
 return copied
}
fn letBorrow() -> i32 {
 let local = 7
 let view: &i32 = &local
 return view.*
}
fn letWrong<'a>(mismatched: string<'a>) -> i32 {
 let wrong: &[u8] = mismatched
 return 0
}
fn construct<'a>(text: string<'a>) -> Maybe<string<'a>> {
 return Maybe<string>.Some {value: text}
}
fn constructNone<'a>() -> Maybe<string<'a>> {
 return Maybe<string>.None
}
fn constructRecord<'a>(view: &'a i32) -> Holder<&'a i32> {
 return Holder<&i32> {held: view}
}
fn callSlice<'a, 'b>(values: &'a [u8], key: &'b i32) -> Maybe<&'a [u8]> {
 return Maybe.some<&[u8]>(values)
}
fn callEntry<'a>(values: &'a [Entry]) -> Maybe<&'a Entry> {
 return Maybe.some<&Entry>(&values[0])
}
fn callMutable<'a>(value: &'a mut Entry) -> Maybe<&'a mut Entry> {
 return Maybe.some<&mut Entry>(move value)
}
fn callFailure<'a, 'b>(witness: string<'b>, error: Error) -> Outcome<string<'a>, Error> {
 return Outcome.failResult<string, Error>(move error)
}
fn callNone<'a, 'b>(witness: &'b Entry) -> Maybe<&'a Entry> {
 return Maybe.none<&Entry>()
}
fn leading<'keep, T>(marker: &'keep i32, value: T) -> T { return move value }
fn callLeading<'a>(marker: &'a i32, value: &'a Entry) -> &'a Entry {
 return leading<'a, &Entry>(marker, value)
}
fn callExplicit<'a>(value: &'a Entry) -> Maybe<&'a Entry> {
 return Maybe.some<&'a Entry>(value)
}
struct Duo<A, B> {first: A
 second: B}
fn join<A, B>(first: A, second: B) -> Duo<A, B> { return Duo<A, B> {first: move first, second: move second} }
fn callPair<'a, 'b>(first: &'a Entry, second: &'b Entry) -> Duo<&'a Entry, &'b Entry> {
 return join<&Entry, &Entry>(first, second)
}
fn callFixed<'a>(shorter: &'a Entry) -> Maybe<&'static Entry> {
 return Maybe.some<&'static Entry>(shorter)
}
fn callWrongAccess<'a>(sharedOnly: &'a Entry) -> Maybe<&'a mut Entry> {
 return Maybe.some<&mut Entry>(sharedOnly)
}
fn callWrongReferent<'a>(different: &'a i32) -> Maybe<&'a Entry> {
 return Maybe.some<&Entry>(different)
}
fn callEscape<'a>(shorter: &'a Entry) -> Maybe<&'static Entry> {
 return Maybe.some<&Entry>(shorter)
}
fn callWithoutEvidence() -> i32 {
 let missing = Maybe.none<&Entry>()
 return 0
}
fn maybeWith<T>(value: T, marker: i32) -> Maybe<T> { return Maybe<T>.Some {value: move value} }
fn callUnresolvedSection() -> i32 {
 let missing = maybeWith<&Entry>(42)
 return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let letStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"letStatic") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&letStatic) && bindingRegionIsStatic(&letStatic, usize.ZERO),
    "an elided slice lifetime takes the static lifetime of its byte-string initializer")
  let letRegion = run Semantic.demandBody(&mut store, &mut request, &id, b"letRegion") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&letRegion) && bindingRegionOf(&letRegion, usize.ONE, b"letRegion", true),
    "an elided String lifetime takes the initializer's declared lifetime")
  let letBorrow = run Semantic.demandBody(&mut store, &mut request, &id, b"letBorrow") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&letBorrow) && bindingRegionOf(&letBorrow, usize.ONE, b"letBorrow", false),
    "an elided reference lifetime takes the region of the loan it is initialized with")
  let letWrong = run providedRejects(&mut store, &mut request, &id, "letWrong", RejectionCode.TypeMismatch,
    text, "mismatched", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(letWrong, "an elided annotation still requires the initializer's written type")
  let construct = run providedSucceeds(&mut store, &mut request, &id, "construct") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(construct, "a variant qualifier's elided lifetime is inferred from its operand")
  let constructNone = run providedSucceeds(&mut store, &mut request, &id, "constructNone") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(constructNone, "a variant without operands takes its elided lifetime from the same-union expectation")
  let constructRecord = run providedSucceeds(&mut store, &mut request, &id, "constructRecord") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(constructRecord, "a struct qualifier's elided lifetime is inferred from its field")
  let slice = run Semantic.demandBody(&mut store, &mut request, &id, b"callSlice") |> Effect.provideMut<Allocator>(&mut allocator)
  let someSignature = run bodyPrefixTargetSignature(&mut store, &mut request, &slice) |> Effect.provideMut<Allocator>(&mut allocator)
  let sliceSelected = run bodyPrefixSelected(&slice, &someSignature, Option.none<Shared<Type>>(), b"some", usize.ZERO, false, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(sliceSelected, "a written slice prefix keeps the original enclosing T0 and the actual first input's nonstatic region despite a separate borrowed key")
  let entry = run Semantic.demandBody(&mut store, &mut request, &id, b"callEntry") |> Effect.provideMut<Allocator>(&mut allocator)
  let entrySignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"callEntry") |> Effect.provideMut<Allocator>(&mut allocator)
  let entrySelected = run bodyPrefixSelected(&entry, &someSignature, contractSlotOf(&entrySignature, usize.MAX), b"some", usize.ONE, false, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(entrySelected, "a written shared Entry prefix selects its real indexed loan and preserves the call result payload")
  let mutable = run Semantic.demandBody(&mut store, &mut request, &id, b"callMutable") |> Effect.provideMut<Allocator>(&mut allocator)
  let mutableSelected = run bodyPrefixSelected(&mutable, &someSignature, Option.none<Shared<Type>>(), b"some", 2, false, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mutableSelected, "an omitted region preserves explicitly written exclusive access and the actual moved operand's referent and region")
  let failureExpected = run Semantic.demandSignature(&mut store, &mut request, &id, b"callFailure") |> Effect.provideMut<Allocator>(&mut allocator)
  let failure = run Semantic.demandBody(&mut store, &mut request, &id, b"callFailure") |> Effect.provideMut<Allocator>(&mut allocator)
  let failureSignature = run bodyPrefixTargetSignature(&mut store, &mut request, &failure) |> Effect.provideMut<Allocator>(&mut allocator)
  let failureSelected = run bodyPrefixSelected(&failure, &failureSignature, contractSlotOf(&failureExpected, usize.MAX), b"failResult", 3, false, true)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(failureSelected, "a failure-only source call closes success string A0 from the actual expected result rather than its independent witness region while retaining the error E1 operand")
  let noneExpected = run Semantic.demandSignature(&mut store, &mut request, &id, b"callNone") |> Effect.provideMut<Allocator>(&mut allocator)
  let absent = run Semantic.demandBody(&mut store, &mut request, &id, b"callNone") |> Effect.provideMut<Allocator>(&mut allocator)
  let noneSignature = run bodyPrefixTargetSignature(&mut store, &mut request, &absent) |> Effect.provideMut<Allocator>(&mut allocator)
  let absentSelected = run bodyPrefixSelected(&absent, &noneSignature, contractSlotOf(&noneExpected, usize.MAX), b"none", usize.ONE, true, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(absentSelected, "a no-operand source constructor closes its omitted region from the real expected Maybe payload rather than its independent witness region or a static default")
  let leading = run Semantic.demandBody(&mut store, &mut request, &id, b"callLeading") |> Effect.provideMut<Allocator>(&mut allocator)
  let originalOrdinals = run bodyPrefixLeadingOrdinals(&leading) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(originalOrdinals, "a leading authored lifetime stays at original ordinal0 and the closed written type stays at original ordinal1")
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"callExplicit") |> Effect.provideMut<Allocator>(&mut allocator)
  let explicitSelected = run bodyPrefixSelected(&explicit, &someSignature, Option.none<Shared<Type>>(), b"some", usize.ONE, false, false)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(explicitSelected, "an explicit caller lifetime remains unchanged through the original constructor application")
  let pair = run Semantic.demandBody(&mut store, &mut request, &id, b"callPair") |> Effect.provideMut<Allocator>(&mut allocator)
  let independent = run bodyPrefixIndependentRegions(&pair) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(independent, "two omitted regions in one written prefix stay distinct at original type slots0/1 and match their actual operands and corresponding Duo result payloads")
  let mir = run Semantic.demandMir(&mut store, &mut request, &id, b"callEntry") |> Effect.provideMut<Allocator>(&mut allocator)
  let emitted = providedCallee(&store, &mir, "some")
  let typedApplication = run directApplicationAt(&entry, usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut canonicalMir = false
  if let Option<InstanceKey>.Some {value: key} = move emitted {
    if let Option<SpecializationApplication>.Some {value: selected} = move typedApplication {
      if let Option<Shared<SpecializationApplication>>.Some {value: actual} = move InstanceKey.application(&key) {
        let copied = run SpecializationApplication.copyShared(&actual) |> Effect.provideMut<Allocator>(&mut allocator)
        let mut numbering = Numbering.make()
        let canonical = run SpecializationApplication.numberRegions(&selected, &mut numbering) |> Effect.provideMut<Allocator>(&mut allocator)
        canonicalMir = run SpecializationApplication.equals(&copied, &canonical) |> Effect.provideMut<Allocator>(&mut allocator)
      }
    }
  }
  run Testing.expect(canonicalMir, "a genuine MIR call carries the same fully closed original constructor application selected in its TypedBody")
  let fixed = run providedRejects(&mut store, &mut request, &id, "callFixed", RejectionCode.TypeMismatch,
    text, "Maybe.some<&'static Entry>(shorter)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongAccess = run providedRejects(&mut store, &mut request, &id, "callWrongAccess", RejectionCode.TypeMismatch,
    text, "Maybe.some<&mut Entry>(sharedOnly)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongReferent = run providedRejects(&mut store, &mut request, &id, "callWrongReferent", RejectionCode.TypeMismatch,
    text, "Maybe.some<&Entry>(different)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let escape = run providedRejects(&mut store, &mut request, &id, "callEscape", RejectionCode.TypeMismatch,
    text, "Maybe.some<&Entry>(shorter)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(fixed && wrongAccess && wrongReferent && escape,
    "omitted regions never replace explicit static evidence, access, referents or a conflicting escaping result")
  let missing = run providedRejects(&mut store, &mut request, &id, "callWithoutEvidence", RejectionCode.BodyLifetimeElisionUnavailable,
    text, "Maybe.none<&Entry>()", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  let section = run providedRejects(&mut store, &mut request, &id, "callUnresolvedSection", RejectionCode.BodyLifetimeElisionUnavailable,
    text, "maybeWith<&Entry>(42)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(missing && section,
    "a result-only omitted region without actual evidence and an unresolved first-class prefix retain their explicit refusal before publication")
  return ()
}


test effect fn nominalRegionShorteningPreservesExactTypesAndFixedEvidence() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nominal-region.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Request<'a, T> { loan: &'a i32
 payload: T }
fn target<'a>(client: &'a i32, value: Request<'a, i32>) -> i32 { return 42 }
fn gap(value: Request<'static, i32>) -> i32 { let local = 1 return target(&local, move value) }
fn exact(client: &'static i32, value: Request<'static, i32>) -> i32 { return target(client, move value) }
fn fixed<'a>(client: &'a i32, value: Request<'static, i32>) -> i32 { return target<'a>(client, move value) }
fn reverse<'a>(client: &'static i32, value: Request<'a, i32>) -> i32 { return target(client, move value) }
struct Multi<'uri, 'policy> { uri: string<'uri>
 policy: string<'policy> }
fn multiTarget<'uri, 'policy>(client: &'policy i32, value: Multi<'uri, 'policy>) -> i32 { return 42 }
fn multiGap(value: Multi<'static, 'static>) -> i32 { let local = 1 return multiTarget(&local, move value) }
fn multiStatic<'policy>(client: &'policy i32, value: Multi<'static, 'policy>) -> i32 { return 42 }
fn multiMismatch<'uri>(value: Multi<'uri, 'static>) -> i32 { let local = 1 return multiStatic(&local, move value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let shortened = run providedSucceeds(&mut store, &mut request, &id, "gap") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(shortened, "inferred covariant Static nominal storage shortens to the caller-local binder region")
  let exact = run providedSucceeds(&mut store, &mut request, &id, "exact") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(exact, "exact nominal lifetime evidence still succeeds")
  let fixed = run providedRejects(&mut store, &mut request, &id, "fixed", RejectionCode.TypeMismatch,
    text, "target<'a>(client, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(fixed, "a written fixed lifetime is not an inferred region to shorten")
  let reverse = run providedRejects(&mut store, &mut request, &id, "reverse", RejectionCode.TypeMismatch,
    text, "target(client, move value)", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(reverse, "a nonstatic nominal argument cannot manufacture static evidence")
  let multiGap = run providedSucceeds(&mut store, &mut request, &id, "multiGap") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(multiGap, "an unchanged unbound lifetime is inferred by the exact proof before the later shortened local slot")
  let multiMismatch = run providedRejects(&mut store, &mut request, &id, "multiMismatch", RejectionCode.TypeMismatch,
    text, "multiStatic(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(multiMismatch, "an ordinary noncandidate lifetime mismatch still dominates a later eligible local slot")
  return ()
}

test effect fn nominalRegionShorteningRejectsOtherArgumentsAndInvariantStorage() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nominal-region-negative.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
struct Request<'a, T> { loan: &'a i32
 payload: T }
struct Other<'a, T> { loan: &'a i32
 payload: T }
struct Pointer<'a> { value: *const string<'a> }
struct Mutable<'a> { value: &'a mut string<'a> }
service Clock {}
service Logger {}
struct Rows<'a, ?R> { loan: &'a i32 }
fn target<'a>(client: &'a i32, value: Request<'a, i32>) -> i32 { return 42 }
fn arrayTarget<'a>(client: &'a i32, value: Request<'a, [i32; 1]>) -> i32 { return 42 }
fn rowTarget<'a>(client: &'a i32, value: Rows<'a, &Clock>) -> i32 { return 42 }
fn pointerTarget<'a>(client: &'a i32, value: Pointer<'a>) -> i32 { return 42 }
fn mutableTarget<'a>(client: &'a i32, value: Mutable<'a>) -> i32 { return 42 }
fn owner(value: Other<'static, i32>) -> i32 { let local = 1 return target(&local, move value) }
fn wrongType(value: Request<'static, i64>) -> i32 { let local = 1 return target(&local, move value) }
fn extent(value: Request<'static, [i32; 2]>) -> i32 { let local = 1 return arrayTarget(&local, move value) }
fn row(value: Rows<'static, &Logger>) -> i32 { let local = 1 return rowTarget(&local, move value) }
fn pointer(value: Pointer<'static>) -> i32 { let local = 1 return pointerTarget(&local, move value) }
fn mutable(value: Mutable<'static>) -> i32 { let local = 1 return mutableTarget(&local, move value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let owner = run providedRejects(&mut store, &mut request, &id, "owner", RejectionCode.TypeMismatch,
    text, "target(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(owner, "nominal owner identity remains exact")
  let wrongType = run providedRejects(&mut store, &mut request, &id, "wrongType", RejectionCode.TypeMismatch,
    text, "target(&local, move value)", usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(wrongType, "a shortened earlier lifetime never hides a nonchanged type mismatch")
  let extent = run providedRejects(&mut store, &mut request, &id, "extent", RejectionCode.TypeMismatch,
    text, "arrayTarget(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(extent, "static array extents remain exact after a potential lifetime shortening")
  let row = run providedRejects(&mut store, &mut request, &id, "row", RejectionCode.TypeMismatch,
    text, "rowTarget(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(row, "a different requirement row retains its ordinary type error")
  let pointer = run providedRejects(&mut store, &mut request, &id, "pointer", RejectionCode.TypeMismatch,
    text, "pointerTarget(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(pointer, "a lifetime inside an invariant pointee cannot shorten")
  let mutable = run providedRejects(&mut store, &mut request, &id, "mutable", RejectionCode.TypeMismatch,
    text, "mutableTarget(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mutable, "a lifetime inside an invariant mutable referent cannot shorten")
  return ()
}

test effect fn nominalRegionShorteningTracksImportedStorageRevisions() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nominal-region-cache.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("shape.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
import shape { Request }
fn target<'a>(client: &'a i32, value: Request<'a>) -> i32 { return 42 }
fn call(value: Request<'static>) -> i32 { let local = 1 return target(&local, move value) }
"""
  let entry = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let covariant = run present("pub struct Request<'a> { pub value: string<'a> }") |> Effect.provideMut<Allocator>(&mut allocator)
  let invariant = run present("pub struct Request<'a> { pub value: *const string<'a> }") |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = run Revision.publish(&Revision.make(), &id, &entry) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&initial, &library, &covariant) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut warm = makeSemantic(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.make()
  let first = run providedSucceeds(&mut warm, &mut request, &id, "call") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(first, "the original imported field gives an actual covariant storage proof")
  let changed = run Revision.publish(&revision, &library, &invariant) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut warm, run Revision.copy(&changed) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut fresh = makeSemantic(move changed)
  let later = run providedRejects(&mut warm, &mut request, &id, "call", RejectionCode.TypeMismatch,
    text, "target(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  let rebuilt = run providedRejects(&mut fresh, &mut request, &id, "call", RejectionCode.TypeMismatch,
    text, "target(&local, move value)", usize.ZERO) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(later && rebuilt, "a revised invariant field invalidates the warmed proof and agrees with a fresh store")
  return ()
}
