}

// Each witness claim uses only the model implementations whose signatures it checks.
fn witnessModelFixture(part: usize) -> string<'static> {
  if part == 0 {
    return "import wcontracts { Info, Load, LoadError, IoError, Clock, Logger, Ticker, Shift, Look, Poke, Spread, Risky, Pick, Bridge }\npub struct Schema {}\nfn schemaWidth(value: Schema) -> i32 { return 32 }\nimpl Info for Schema {\n  fn decode(value: Self) -> i32 { return 42 }\n  width: schemaWidth\n}\nstruct Lacking {}\nimpl Info for Lacking {\n  fn decode(value: Self) -> i32 { return 0 }\n}\nstruct Misnamed {}\nimpl Info for Misnamed {\n  fn decodeSchema(value: Self) -> i32 { return 0 }\n  fn decode(value: Self) -> i32 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Twice {}\nfn twiceDecode(value: Twice) -> i32 { return 0 }\nimpl Info for Twice {\n  fn decode(value: Self) -> i32 { return 0 }\n  decode: twiceDecode\n  fn width(value: Self) -> i32 { return 0 }\n}\nimpl Ticker for Schema {\n  fn tick(value: Self) -> i32 { return 0 }\n}\n"
  }
  if part == 1 {
    return "import wcontracts { Info, Load, LoadError, IoError, Clock, Logger, Ticker, Shift, Look, Poke, Spread, Risky, Pick, Bridge }\nstruct Eager {}\nimpl Load for Eager {\n  fn load(value: Self) -> i32 { return 0 }\n}\nstruct Lazy {}\nimpl Info for Lazy {\n  effect fn decode(value: Self) -> i32 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Hazard {}\nimpl Info for Hazard {\n  unsafe fn decode(value: Self) -> i32 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Careful {}\nimpl Risky for Careful {\n  fn risky(value: Self) -> i32 { return 0 }\n}\n"
  }
  if part == 2 {
    return "import wcontracts { Info, Load, LoadError, IoError, Clock, Logger, Ticker, Shift, Look, Poke, Spread, Risky, Pick, Bridge }\nstruct Grabby {}\nimpl Look for Grabby {\n  fn look(value: &'static mut Self) -> i32 { return 0 }\n}\nstruct Taker {}\nimpl Look for Taker {\n  fn look(value: Self) -> i32 { return 0 }\n}\nstruct Reader {}\nimpl Poke for Reader {\n  fn poke(value: &'static Self) -> i32 { return 0 }\n}\nstruct Single {}\nimpl Spread for Single {\n  fn spread(value: Self, items: &'static i32) -> i32 { return 0 }\n}\nstruct Wide {}\nimpl Shift for Wide {\n  fn shift(value: Self, amount: i64) -> i32 { return 0 }\n}\nstruct Nested {}\nimpl Look for Nested {\n  fn look(value: &'static &'static Self) -> i32 { return 0 }\n}\n"
  }
  if part == 3 {
    return "import wcontracts { Info, Load, LoadError, IoError, Clock, Logger, Ticker, Shift, Look, Poke, Spread, Risky, Pick, Bridge }\nstruct Long {}\nimpl Info for Long {\n  fn decode(value: Self) -> i64 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Deferred {}\nimpl Load for Deferred {\n  effect fn load(value: Self) -> Effect<'static; i32> { return () }\n}\nstruct Noisy {}\nimpl Load for Noisy {\n  effect fn load(value: Self) -> i32 ! LoadError | IoError { return 0 }\n}\nstruct Chatty {}\nimpl Load for Chatty {\n  effect fn load(value: Self) -> i32 ? &Logger { return 0 }\n}\nstruct Writer {}\nimpl Load for Writer {\n  effect fn load(value: Self) -> i32 ? &mut Clock { return 0 }\n}\nstruct Quiet {}\nimpl Load for Quiet {\n  effect fn load(value: Self) -> i32 { return 0 }\n}\n"
  }
  if part == 4 {
    return "import wcontracts { Info, Load, LoadError, IoError, Clock, Logger, Ticker, Shift, Look, Poke, Spread, Risky, Pick, Bridge }\nstruct Broken {}\nfn brokenWidth(value: Missing) -> i32 { return 0 }\nimpl Info for Broken {\n  fn decode(value: Self) -> i32 { return 0 }\n  width: brokenWidth\n}\nstruct Loose {}\nfn looseWidth(value: Loose) -> i32 { return true }\nimpl Info for Loose {\n  fn decode(value: Self) -> i32 { return 0 }\n  width: looseWidth\n}\nstruct Two<'a> {\n  value: &'a i32\n}\nimpl<'a> Pick<'a, 'a> for Two<'a> {\n  effect fn pick(value: Self) -> i32 { return 0 }\n}\nstruct Three<'a> {\n  value: &'a i32\n}\nimpl<'a, 'b, 'c> Pick<'b, 'c> for Three<'a> {\n  effect<'c> fn pick(value: Self) -> i32 { return 0 }\n}\nstruct Four<'b> {\n  value: &'b i32\n}\nimpl<'a, 'b: 'c, 'c: 'a> Bridge<'a, 'c> for Four<'b> {\n  effect<'b> fn cross() -> i32 { return 0 }\n}\nstruct Borrower {}\nimpl Look for Borrower {\n  fn look(value: &Self) -> i32 { return 0 }\n}\n"
  }
  return ""
}

test effect fn contractReuseRevisionWitnessBodyEdit() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("witness-revision.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = "interface Measure { fn value(item: Self) -> i32 }\nstruct Counter {}\nfn first(item: Counter) -> i32 { return 1 }\nfn other(item: Counter) -> i32 { return 2 }\nimpl Measure for Counter { value: first }\nfn caller(item: Counter) -> i32 { return Measure.value(move item) }\n"
  let firstSource = run present(initial)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &firstSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut cold = Request.make()
  let checked = run Semantic.demandBody(&mut semantic, &mut cold, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&checked) && Request.hasDemand(&cold, Family.ConformanceHeads, &entry) && Request.hasDemand(
      &cold, Family.Witnesses, &entry,
    ),
    "concrete call records its conformance and witness demand",
  )
  let bodyEdited = run present(
    "interface Measure { fn value(item: Self) -> i32 }\nstruct Counter {}\nfn first(item: Counter) -> i32 { return 3 }\nfn other(item: Counter) -> i32 { return 2 }\nimpl Measure for Counter { value: first }\nfn caller(item: Counter) -> i32 { return Measure.value(move item) }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &entry, &bodyEdited)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut editedRequest = Request.make()
  let edited = run Semantic.demandBody(&mut semantic, &mut editedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&edited) && reused(Semantic.eventLog(&semantic)) == usize.ONE && Request.hasDemand(
      &editedRequest, Family.Witnesses, &entry,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &edited,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return bodyHasCurrentSource(answer, &second)
      },
    ),
    "witness-body-only edit retains the checked caller with current evidence and demand",
  )
  let remapped = run present(
    "interface Measure { fn value(item: Self) -> i32 }\nstruct Counter {}\nfn first(item: Counter) -> i32 { return 3 }\nfn other(item: Counter) -> i32 { return 2 }\nimpl Measure for Counter { value: other }\nfn caller(item: Counter) -> i32 { return Measure.value(move item) }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run Revision.publish(&second, &entry, &remapped)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move third)
  let mut changedRequest = Request.make()
  let changed = run Semantic.demandBody(&mut semantic, &mut changedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&changed) && reused(Semantic.eventLog(&semantic)) == usize.ONE && Request.hasDemand(
      &changedRequest, Family.Witnesses, &entry,
    ),
    "replacing the witness mapping checks the caller again",
  )
  return ()
}

test effect fn contractReuseRevisionMissingConformance() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let library = run module("revision_contracts.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let consumer = run module("revision_consumer.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let consumerText = "import revision_contracts { Mark, Item, gated }\nfn caller(item: Item<i32>) -> i32 { return gated(move item) }\n"
  let consumerSource = run present(consumerText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let absentText = "pub interface Mark { fn value(item: Self) -> i32 }\npub struct Item<T> {}\npub fn gated<T: Mark>(item: T) -> i32 { return 1 }\n"
  let absentSource = run present(absentText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let base = run Revision.publish(&Revision.make(), &consumer, &consumerSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let absentRevision = run Revision.publish(&base, &library, &absentSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&absentRevision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut missingRequest = Request.make()
  let missing = run Semantic.demandBody(&mut semantic, &mut missingRequest, &consumer, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&missing, RejectionCode.MissingConformance, offsetOf(consumerText, "gated(move item)", 0)) && Request.hasDemand(
      &missingRequest, Family.ConformanceHeads, &library,
    ) && Request.hasDiscovered(&missingRequest, &library),
    "missing conformance records its negative head observation and imported discovery",
  )
  let presentText = "pub interface Mark { fn value(item: Self) -> i32 }\npub struct Item<T> {}\npub fn gated<T: Mark>(item: T) -> i32 { return 1 }\nimpl Mark for Item<i32> { fn value(item: Self) -> i32 { return 1 } }\n"
  let presentSource = run present(presentText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let presentRevision = run Revision.publish(&absentRevision, &library, &presentSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move presentRevision)
  let mut positiveRequest = Request.make()
  let positive = run Semantic.demandBody(&mut semantic, &mut positiveRequest, &consumer, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&positive) && Request.hasDemand(&positiveRequest, Family.ConformanceHeads, &library) && Request.hasDiscovered(
      &positiveRequest, &library,
    ),
    "adding the missing conformance validates the former negative consumer",
  )
  let before = hits(Semantic.eventLog(&semantic), Family.Body)
  let mut warmRequest = Request.make()
  let warm = run Semantic.demandBody(&mut semantic, &mut warmRequest, &consumer, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&warm) && hits(Semantic.eventLog(&semantic), Family.Body) == before + usize.ONE && Request.hasDemand(
      &warmRequest, Family.ConformanceHeads, &library,
    ) && Request.hasDiscovered(
      &warmRequest, &library,
    ),
    "a warm contract call replays proof and source discovery",
  )
  return ()
}

test effect fn contractReuseSecondConsumerReplaysWitnesses() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("contract-order.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "interface Mark { fn value(item: Self) -> i32 }\nstruct Item {}\nimpl Mark for Item { fn value(item: Self) -> i32 { return 1 } }\nfn caller(item: Item) -> i32 { return Mark.value(move item) }\nfn other(item: Item) -> i32 { return Mark.value(move item) }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut forward = makeSemantic(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut forwardRequest = Request.make()
  let caller = run Semantic.demandBody(&mut forward, &mut forwardRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let witnessStarts = starts(Semantic.eventLog(&forward), Family.Witnesses)
  let mut otherRequest = Request.make()
  let other = run Semantic.demandBody(&mut forward, &mut otherRequest, &entry, b"other")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&caller) && succeeded(&other) && Request.hasDemand(&forwardRequest, Family.Witnesses, &entry) &&
      Request.hasDemand(&otherRequest, Family.Witnesses, &entry) &&
      starts(Semantic.eventLog(&forward), Family.Witnesses) == witnessStarts,
    "a second contract consumer replays the cached witness demand without recomputing it",
  )
  return ()
}

fn contractOverlapBaseText() -> string<'static> {
  return "interface Mark { fn value(item: Self) -> i32 }\nstruct Item<T> {}\nfn gated<T: Mark>(item: T) -> i32 { return 1 }\nimpl Mark for Item<i32> { fn value(item: Self) -> i32 { return 1 } }\nfn caller(item: Item<i32>) -> i32 { return gated(move item) }\n"
}

fn contractOverlapAddedText() -> string<'static> {
  return "interface Mark { fn value(item: Self) -> i32 }\nstruct Item<T> {}\nfn gated<T: Mark>(item: T) -> i32 { return 1 }\nimpl Mark for Item<i32> { fn value(item: Self) -> i32 { return 1 } }\nimpl<T> Mark for Item<T> { fn value(item: Self) -> i32 { return 2 } }\nfn caller(item: Item<i32>) -> i32 { return gated(move item) }\n"
}

test effect fn contractReuseRevisionAddedOverlap() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("overlap-added.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(contractOverlapBaseText())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let changedText = contractOverlapAddedText()
  let changedSource = run present(changedText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &entry, &changedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut changedRequest = Request.make()
  let overlapping = run Semantic.demandBody(&mut semantic, &mut changedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&checked) && rejectsFrom(
      &overlapping, RejectionCode.OverlappingConformance, offsetOf(changedText, "impl<T> Mark", 0),
    ) && Request.hasDemand(&changedRequest, Family.ConformanceHeads, &entry),
    "adding an overlapping head invalidates a checked contract consumer at the new head",
  )
  let restored = run present(contractOverlapBaseText())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run Revision.publish(&second, &entry, &restored)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move third)
  let mut restoredRequest = Request.make()
  let valid = run Semantic.demandBody(&mut semantic, &mut restoredRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    succeeded(&valid) && Request.hasDemand(&restoredRequest, Family.ConformanceHeads, &entry),
    "removing an overlapping head restores the positive proof",
  )
  return ()
}

test effect fn contractReuseRevisionCoherenceRetry() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("overlap-retry.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = contractOverlapAddedText()
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut index = SourceIndex.make(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let firstHead = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Implementation, b"", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(text).length,
    rejected: false,
  }
  let mut failedRequest = Request.make()
  let attempted = run Effect.result(Semantic.demandCoherence(&mut semantic, &mut failedRequest, &firstHead))
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<Shared<Result<Answer, NoRejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value: ignored} => false
  }
  let mut retryRequest = Request.make()
  let retry = run Semantic.demandCoherence(&mut semantic, &mut retryRequest, &firstHead)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == usize.ZERO && rejectsFrom(
      &retry, RejectionCode.OverlappingConformance, offsetOf(text, "impl<T> Mark", 0),
    ),
    "typed coherence failure publishes no root and retry observes the complete overlap",
  )
  return ()
}

