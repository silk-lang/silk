test effect fn staticFunctionsDoNotBecomeRuntimeInstances() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entryId = run module("static-entry.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut entry = run staticSemantic(
    &entryId,
    "pub static fn main() -> i32 { return 42 }",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut entryRequest = Request.make()
  let entryBuild = run Semantic.buildMain(&mut entry, &mut entryRequest, &entryId)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut rejectedEntry = false
  match move entryBuild {
    BackendBuild.Rejected {diagnostic} => {
      rejectedEntry = Shared.with<Rejection, bool>(&diagnostic, fn(value: &Rejection) -> bool {
        return value.code == RejectionCode.StaticPhaseViolation && value.span.end > value.span.start
      })
    }
    _ => {}
  }
  run Testing.expect(rejectedEntry, "static entry is a phase diagnostic")

  let calleeId = run module("static-callee.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut callee = run staticSemantic(
    &calleeId,
    """static fn answer() -> i32 { return 42 }
pub fn main() -> i32 { return answer() }
""",
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut calleeRequest = Request.make()
  let calleeBuild = run Semantic.buildMain(&mut callee, &mut calleeRequest, &calleeId)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut deferredCall = false
  match move calleeBuild {
    BackendBuild.Unsupported {gaps} => {
      let entries = Vector.asSlice<Shared<BackendGap>>(&gaps)
      let mut at = usize.ZERO
      while at < entries.length {
        if Shared.with<BackendGap, bool>(&entries[at], fn(gap: &BackendGap) -> bool {
          return gap.code == GapCode.StaticResidualization && gap.span.end > gap.span.start
        }) {
          deferredCall = true
        }
        at = at + usize.ONE
      }
    }
    _ => {}
  }
  run Testing.expect(deferredCall, "static callee remains a named residualization gap")
  return ()
}

test effect fn foreignCallsKeepCSignatureAndSeparateMirEdges() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("foreign-c-signature.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut store = run staticSemantic(&id, """unsafe extern "C" fn narrow(value: i8) -> i8
unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
unsafe extern "C" fn fabs(value: f64) -> f64
unsafe extern "C" fn fabsf(value: f32) -> f32
pub fn main() -> i32 {
  let value = unsafe narrow(-7)
  let memory = unsafe malloc(8)
  unsafe free(memory)
  if unsafe fabs(-42.0) != 42.0 { return 1 }
  if unsafe fabsf(-7.0) != 7.0 { return 2 }
  if 7.0 != unsafe fabsf(-7.0) { return 3 }
  return 42
}
""", MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let built = run Semantic.buildMain(&mut store, &mut request, &id) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut classified = false
  match move built {
    BackendBuild.Module {text, ..} => {
      let ir = Bytes.asSlice(&text)
      classified = containsIr(ir, b"declare signext i8 @\"narrow\"(i8 signext ") && containsIr(ir, b"call signext i8 @\"narrow\"(i8 signext -7)") && containsIr(ir, b"declare ptr @\"malloc\"(i64 ") && containsIr(ir, b"declare void @\"free\"(ptr ") && containsIr(ir, b"declare double @\"fabs\"(double ") && containsIr(ir, b"declare float @\"fabsf\"(float ") && containsIr(ir, b"call float @\"fabsf\"(float 0xC01C000000000000") && containsIr(ir, b"call double @\"fabs\"(double 0xC045000000000000") && containsIr(ir, b" = fcmp une float ") && containsIr(ir, b" = fcmp une double ")
    }
    _ => {}
  }
  run Testing.expect(classified, "C narrow extensions, pointer and contextual floating lanes agree at declaration and call")
  let mirAnswer = run Semantic.demandMir(&mut store, &mut request, &id, b"main") |> Effect.provideMut<Allocator>(&mut allocator)
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&mirAnswer, selectedMirIndex)
  let mut separate = false
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: mir} = move Semantic.mirAt(&store, value) {
      separate = Vector.length<MirReference>(&mir.references) == usize.ZERO && Vector.length<Shared<DeclarationId>>(&mir.externs) > usize.ZERO
    }
  }
  run Testing.expect(separate, "foreign declarations never enter the runtime body worklist")
  return ()
}

test effect fn foreignUnsafePrefixesSelectOnlyTheirInvocation() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("foreign-unsafe-regions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """unsafe extern "C" fn outer(value: i32) -> i32
unsafe extern "C" fn inner() -> i32
fn safe(value: i32) -> i32 { return value }
fn nestedMissing() -> i32 { return unsafe outer(inner()) }
unsafe fn unsafeFunction() -> i32 { return inner() }
fn explicitNested() -> i32 { return unsafe outer(unsafe inner()) }
fn blockNested() -> i32 {
  unsafe { return outer(inner()) }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nestedMissing") |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut store, &mut request, &id, b"unsafeFunction") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&nested, RejectionCode.UnsafeAcknowledgement, text, "inner()", usize.ONE) &&
    rejectsFrom(&unmarked, RejectionCode.UnsafeAcknowledgement, offsetOf(text, "inner() }", usize.ZERO)),
    "prefix authority selects one unsafe call and function modifiers grant no lexical permission",
  )
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitNested") |> Effect.provideMut<Allocator>(&mut allocator)
  let blocked = run Semantic.demandBody(&mut store, &mut request, &id, b"blockNested") |> Effect.provideMut<Allocator>(&mut allocator)
  let markedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&explicit, checkedBody)
  let blockBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&blocked, checkedBody)
  let mut accepted = false
  if let Option<Shared<TypedBody>>.Some {value: marked} = move markedBody {
    if let Option<Shared<TypedBody>>.Some {value: region} = move blockBody {
      accepted = Shared.with<TypedBody, bool>(&marked, bodyIsFullyChecked) && Shared.with<TypedBody, bool>(&region, bodyIsFullyChecked)
    }
  }
  run Testing.expect(accepted, "explicit nested prefixes and a lexical unsafe block acknowledge both calls")
  return ()
}

