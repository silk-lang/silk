effect fn contextualGenericHigherOrderClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("contextual-generic-higher-order-section.silk")
  let text = """
fn select<T>(callback: fn<'static>() -> T, enabled: bool) -> () { drop callback() return () }
fn consume<F: fn<'static>(fn<'static>() -> i32) -> ()>(callback: F) -> () {
  callback(fn() -> i32 { return 42 })
}
fn main() -> () { let next = select(true) consume(next) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller),
    "contextual target inference learns T from its hidden callable representation bound even when the target result is unit")
}

test effect fn contextualGenericSectionsInferSharedReferentsFromExclusivePromises() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn select<T>(value: &'static T, enabled: bool) -> () { return () }
fn consume(callback: fn<'static>(&'static mut i32) -> (), value: &'static mut i32) -> () { callback(move value) }
fn main(value: &'static mut i32) -> () { let next = select(true) consume(next, move value) }
"""
  return run contextualGenericDescriptorClaims(text) |> Effect.provideMut<Allocator>(&mut allocator)
}

