//! Focused source tests for lazy semantic demands and their retained evidence.

import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Semantic {
  Answer,
  Dependency,
  Event as SemanticEvent,
  EventKind,
  Family,
  Outcome,
  Semantic,
  Request,
  Value,
}
import semantic.SourceIndex {
  Event as SourceEvent,
  EventKind as SourceEventKind,
  NoRejection,
  RevisionMismatch,
}
import semantic.Rejection {Rejection, RejectionCode}
import semantic.SourceRevision {Revision}
import semantic.Type {Type}
import semantic.TypedBody {Expression as BodyExpression, NodeKind as BodyNodeKind, TypedBody}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.layout {Layout}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}

struct AnswerView {
  success: bool
  dependencies: usize
  sources: usize
}

struct NestedFailureAllocator {
  targetBytes: usize
  rejected: bool
}

impl NestedFailureAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Allocation ! OutOfMemoryError {
    if layout.bytes == self.targetBytes && layout.alignment == 1 {
      self.rejected = true
      fail OutOfMemoryError {}
    }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout)
      |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for NestedFailureAllocator {
  allocate: NestedFailureAllocator.allocate
}

fn inspect(answer: &Result<Answer, NoRejection>) -> AnswerView {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: _} => AnswerView {
        success: true,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
      Outcome.Rejected {diagnostic: _} => AnswerView {
        success: false,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => AnswerView {
      success: false,
      dependencies: usize.ZERO,
      sources: usize.ZERO,
    }
  }
}

fn rejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      Outcome.Success {value: _} => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body}} => Option.some<Shared<TypedBody>>(
        Shared.clone<TypedBody>(&body),
      )
      _ => Option.none<Shared<TypedBody>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<TypedBody>>()
  }
}

fn bodyFirstIntegerType(body: &TypedBody, spelling: &[u8]) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if nodes.length == usize.ZERO {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {ty, form: BodyExpression.Integer {..}} => Shared.with<Type, bool>(
      &ty,
      fn(found: &Type) -> bool {
        return match & found.* {
          Type.Primitive {name} => {
            let bytes = Bytes.asSlice(&name)
            if bytes.length != spelling.length {
              return false
            }
            let mut at = usize.ZERO
            while at < bytes.length {
              if bytes[at] != spelling[at] {
                return false
              }
              at = at + usize.ONE
            }
            return true
          }
          _ => false
        }
      },
    )
    _ => false
  }
}

fn rejectionSpells(
  answer: &Result<Answer, NoRejection>,
  code: RejectionCode,
  source: &[u8],
  spelling: &[u8],
) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        if diagnostic.code != code || diagnostic.span.end > source.length || diagnostic.span.end - diagnostic.span.start != spelling.length {
          return false
        }
        let mut at = usize.ZERO
        while at < spelling.length {
          if source[diagnostic.span.start + at] != spelling[at] {
            return false
          }
          at = at + usize.ONE
        }
        return true
      },
    )
  }
  return false
}

fn bodyReadsParameter(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if nodes.length != 3 || TypedBody.runtimeBodies(body).length != 0 || TypedBody.signatureDependencies(
    body,
  ).length != 1 {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {binding}, ..} => {
      return binding.index < nodes[usize.ZERO].origin.syntax.index
    }
    _ => false
  }
}

fn rejectionCode(answer: &Result<Answer, NoRejection>, code: RejectionCode) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.end > diagnostic.span.start
      },
    )
  }
  return false
}

fn isUnknownName(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownName
}

fn isUnknownMember(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownMember
}

fn isMissingModule(value: &Rejection) -> bool {
  return value.code == RejectionCode.MissingModule && value.span.end > value.span.start
}

fn isPrivateExposure(value: &Rejection) -> bool {
  return value.code == RejectionCode.PrivateTypeExposure && value.span.end > value.span.start
}

fn isCollision(value: &Rejection) -> bool {
  return value.code == RejectionCode.Collision
}

fn isUnsupported(value: &Rejection) -> bool {
  return value.code == RejectionCode.Unsupported && value.span.end > value.span.start
}

fn isCycle(value: &Rejection) -> bool {
  return value.code == RejectionCode.Cycle
}

fn cyclePathLength(value: &Rejection) -> usize {
  return Vector.length(&value.path)
}

fn aliasCycleAnchor(value: &Rejection) -> bool {
  return value.span.start == 20 && value.span.end == 21
}

fn importCycleAnchor(value: &Rejection) -> bool {
  return value.span.end > value.span.start
}

fn isNominal(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Nominal {..} => true
    _ => false
  }
}

fn isBool(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 4 && bytes[0] == 98 && bytes[1] == 111 && bytes[2] == 111 && bytes[3] == 108
    }
    _ => false
  }
}

fn spanStart(value: &Rejection) -> usize {
  return value.span.start
}

fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Signature {signature} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&signature.result),
        )
        _ => Option.none<Shared<Type>>()
      }
      Outcome.Rejected {diagnostic: _} => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn nominalOwnedBy(resolved: &Type, module: &ModuleId) -> bool {
  return match & resolved.* {
    Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
    _ => false
  }
}

fn signatureOwnedBy(answer: &Shared<Result<Answer, NoRejection>>, module: &ModuleId) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(
      &value,
      fn(resolved: &Type) -> bool {
        return nominalOwnedBy(resolved, module)
      },
    )
  }
  return false
}

fn isI32(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 3 && bytes[0] == 105 && bytes[1] == 51 && bytes[2] == 50
    }
    _ => false
  }
}

fn signatureIsI32(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(&value, isI32)
  }
  return false
}

fn signatureIsBool(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(&value, isBool)
  }
  return false
}

fn importedSignatureHasDependencies(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut selected = false
      let mut namespace = false
      let mut publicName = false
      let mut alias = false
      let mut identity = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        let item = &dependencies[at]
        if item.family == Family.Import {
          match & item.member {
            Option<usize>.Some {value: ordinal} => {
              if ordinal == usize.ZERO {
                selected = true
              }
            }
            Option<usize>.None => {
              namespace = true
            }
          }
        }
        if item.family == Family.Name && item.external {
          publicName = true
        }
        if item.family == Family.Alias {
          alias = true
        }
        if item.family == Family.Identity {
          identity = true
        }
        at = at + usize.ONE
      }
      return selected && namespace && publicName && alias && identity
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn reads(events: &[SourceEvent], module: &ModuleId) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == SourceEventKind.SourceRead && ModuleId.equals(&events[at].module, module) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn starts(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn hits(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Hit && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option.some<Bytes>(run Bytes.copy(String.utf8Bytes(text)))
}

effect fn lazyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let missing = run module("missing.silk")
  let source = run present(
    "import missing as Ghost\ntype Broken = Unknown\nfn entry() -> i32 { return unknown() }\nfn missing(value: Ghost.Thing) -> i32 { return 0 }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let first = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(
    first.success && first.sources == 1,
    "written signature needs entry source only",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &missing,
    ) == 0,
    "unused import target stays unread",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 0,
    "unused import and bad alias stay undemanded",
  )
  let broken = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Broken")
  let rejected = Shared.with<Result<Answer, NoRejection>, AnswerView>(&broken, inspect)
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &broken,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      !rejected.success && Shared.with<Rejection, bool>(&value, isUnknownName) && rejected.dependencies > 0 && rejected.sources == 1,
      "demanded bad alias records negative name dependency",
    )
  } else {
    run Testing.expect(false, "demanded bad alias has a typed rejection")
  }
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let hit = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    hit.success && hit.sources == first.sources && reads(Semantic.sourceEvents(&semantic), &entry) == 1,
    "memo hit retains evidence without another source read",
  )
  let demanded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"missing")
  let missingDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &demanded,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move missingDiagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule),
      "demanded import target absence is anchored",
    )
  } else {
    run Testing.expect(false, "demanded missing import has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &missing) == 1,
    "missing target is read only on demand",
  )
  return ()
}

test effect fn defersUnusedDeclarationsAndReusesWrittenSignature() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lazyClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let librarySource = run present(
    "pub struct Thing { field: Missing }\npub type PublicAlias = Thing\n",
  )
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let entrySource = run present(
    "import library as Library { PublicAlias as Alias }\nfn entry(value: Alias) -> Library.Thing { return move value }\n",
  )
  let revision = run Revision.publish(&first, &entry, &entrySource)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(result.success, "imported alias resolves from written signature")
  run Testing.expect(result.dependencies > 0, "imported alias records nested demands")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&signature, importedSignatureHasDependencies),
    "signature keeps selected import ordinal, namespace, public name, alias, and identity edges",
  )
  run Testing.expect(result.sources == 2, "signature records each directly inspected source")
  let writtenResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move writtenResult {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isNominal),
      "alias result retains nominal identity",
    )
  } else {
    run Testing.expect(false, "signature has a written result")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "import target is read only when alias is used",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Identity) == 1,
    "hybrid namespace and selected alias share nominal identity",
  )
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let cached = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    cached.success && cached.dependencies == result.dependencies && cached.sources == result.sources,
    "imported signature memo hit keeps fact and dependency evidence",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "imported signature memo hit does not reread sources",
  )
  let priorSignatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let priorSignatureHits = hits(Semantic.eventLog(&semantic), Family.Signature)
  let mut fresh = Request.make()
  run Testing.expect(
    Request.rootCount(&fresh) == 0 && !Request.hasDiscovered(&fresh, &library),
    "fresh request has no inherited roots or discoveries",
  )
  let replayed = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && Request.rootCount(
      &fresh,
    ) == 1 && Request.hasRoot(&fresh, Family.Signature, &entry, b"entry") && Request.hasDiscovered(
      &fresh,
      &entry,
    ) && Request.hasDiscovered(&fresh, &library) && Request.hasDemand(
      &fresh,
      Family.Alias,
      &library,
    ) && Request.hasDemand(&fresh, Family.Identity, &library),
    "fresh request replays imported discovery and nested demand evidence",
  )
  run Testing.expect(
    priorSignatureStarts == starts(Semantic.eventLog(&semantic), Family.Signature) && hits(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == priorSignatureHits + 1 && reads(Semantic.sourceEvents(&semantic), &library) == 1,
    "replay emits only the actual root hit and no new provider read",
  )
  return ()
}

test effect fn resolvesImportedAliasWithoutFieldsOrBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present(
    "type A = B\ntype B = A\nfn f() -> i32 { return g() }\nfn g() -> i32 { return f() }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let function = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"f")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&function, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1,
    "recursive bodies do not demand another signature",
  )
  let alias = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"A")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &alias,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "alias cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "alias cycle has a declaration path",
    )
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, aliasCycleAnchor),
      "alias cycle is anchored",
    )
  } else {
    run Testing.expect(false, "alias cycle has a typed rejection")
  }
  return ()
}

test effect fn separatesSignatureRecursionFromAliasCycles() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn visibilityClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present(
    "struct Hidden { field: Missing }\npub fn reveal() -> Hidden { return () }\ntype Clash = i32\nstruct Clash {}\npub type NotReady = never\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let revealed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"reveal")
  let privateType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &revealed,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move privateType {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isPrivateExposure),
      "public written signature rejects private nominal type at its use",
    )
  } else {
    run Testing.expect(false, "private type exposure has a typed rejection")
  }
  let clash = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Clash")
  let collision = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &clash,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move collision {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCollision),
      "complete name bucket rejects collision without winner",
    )
  } else {
    run Testing.expect(false, "colliding name has a typed rejection")
  }
  let unsupported = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"NotReady")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &unsupported,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isUnsupported),
      "demanded unsupported type is anchored",
    )
  } else {
    run Testing.expect(false, "unsupported type has a typed rejection")
  }
  return ()
}

test effect fn rejectsPrivateExposureCollisionsAndDemandedUnsupportedType() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run visibilityClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importCycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let firstModule = run module("first.silk")
  let secondModule = run module("second.silk")
  let firstSource = run present("pub import second { Alias }\n")
  let first = run Revision.publish(&Revision.make(), &firstModule, &firstSource)
  let secondSource = run present("pub import first { Alias }\n")
  let second = run Revision.publish(&first, &secondModule, &secondSource)
  let entrySource = run present("import first { Alias }\nfn entry() -> Alias { return () }\n")
  let revision = run Revision.publish(&second, &entry, &entrySource)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "public import-name cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "public import-name cycle has a declaration path",
    )
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, importCycleAnchor),
      "public import-name cycle is anchored",
    )
  } else {
    run Testing.expect(false, "public import-name cycle has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &firstModule) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &secondModule,
    ) == 1,
    "import-name cycle opens each target once",
  )
  return ()
}

test effect fn rejectsPublicImportNameCycle() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importCycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn revisionReuseClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let unrelated = run module("unrelated.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let b = run present("pub type Alias = i32\n")
  let first = run Revision.publish(&Revision.make(), &entry, &a)
  let held = run Revision.publish(&first, &library, &b)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let mut coldRequest = Request.make()
  let cold = run Semantic.demandSignature(&mut semantic, &mut coldRequest, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&cold, inspect).success && Request.hasDiscovered(
      &coldRequest,
      &library,
    ),
    "cold signature discovers its imported alias source",
  )
  let startsBefore = starts(Semantic.eventLog(&semantic), Family.Signature)
  let c = run present("fn changed() -> i32 { return 3 }\n")
  let irrelevant = run Revision.publish(&held, &unrelated, &c)
  Semantic.revise(&mut semantic, move irrelevant)
  let mut fresh = Request.make()
  let warm = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&warm, inspect).success && Request.hasDiscovered(
      &fresh,
      &library,
    ) && !Request.hasDiscovered(&fresh, &unrelated) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == startsBefore && hits(Semantic.eventLog(&semantic), Family.Signature) == 1,
    "unrelated revision keeps the completed signature and replays only its discoveries",
  )
  let changed = run present("pub type Alias = bool\n")
  let relevant = run Revision.publish(&held, &library, &changed)
  Semantic.revise(&mut semantic, move relevant)
  let mut revised = Request.make()
  let updated = run Semantic.demandSignature(&mut semantic, &mut revised, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &updated,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isBool) && starts(
        Semantic.eventLog(&semantic),
        Family.Signature,
      ) == startsBefore + 1,
      "changed imported alias header recomputes the transitive signature",
    )
  } else {
    run Testing.expect(false, "recomputed signature has a written result")
  }
  return ()
}

test effect fn reusesUnrelatedRevisionAndInvalidatesImportedHeader() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run revisionReuseClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn negativeRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let held = run Revision.publish(&Revision.make(), &entry, &a)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let mut firstRequest = Request.make()
  let missing = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &entry, b"entry")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &missing,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule) && !Request.hasDiscovered(
        &firstRequest,
        &library,
      ),
      "absent imported path records a typed rejection without a present discovery",
    )
  } else {
    run Testing.expect(false, "absent imported path rejects")
  }
  let b = run present("pub type Other = i32\n")
  let appeared = run Revision.publish(&held, &library, &b)
  Semantic.revise(&mut semantic, move appeared)
  let mut secondRequest = Request.make()
  let missingName = run Semantic.demandSignature(
    &mut semantic,
    &mut secondRequest,
    &entry,
    b"entry",
  )
  let nameDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &missingName,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move nameDiagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isUnknownMember) && Request.hasDiscovered(
        &secondRequest,
        &library,
      ),
      "formerly absent path is discovered and its absent-name bucket rejects",
    )
  } else {
    run Testing.expect(false, "present imported module with absent name rejects")
  }
  let named = run present("pub type Other = i32\npub type Alias = bool\n")
  let namedRevision = run Revision.publish(&held, &library, &named)
  Semantic.revise(&mut semantic, move namedRevision)
  let mut namedRequest = Request.make()
  let resolved = run Semantic.demandSignature(&mut semantic, &mut namedRequest, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &resolved,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isBool) && Request.hasDiscovered(&namedRequest, &library),
      "new imported name invalidates the transitive negative bucket",
    )
  } else {
    run Testing.expect(false, "new imported name resolves")
  }
  let shifted = run present(
    "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
  )
  let absentAgain = run Revision.publish(&held, &entry, &shifted)
  Semantic.revise(&mut semantic, move absentAgain)
  let mut shiftedRequest = Request.make()
  let newFailure = run Semantic.demandSignature(
    &mut semantic,
    &mut shiftedRequest,
    &entry,
    b"entry",
  )
  let anchored = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &newFailure,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move anchored {
    let offset = Shared.with<Rejection, usize>(&value, spanStart)
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule) && offset == 17 && String.utf8Bytes(
        "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
      )[offset] == 108,
      "recomputed rejection span points into exact changed entry bytes",
    )
  } else {
    run Testing.expect(false, "changed entry bytes produce a new anchored rejection")
  }
  return ()
}

test effect fn invalidatesNegativePathAndNameAndReanchorsDiagnostic() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run negativeRevisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedFailureRetryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let entrySource = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
    |> Effect.provideMut<Allocator>(&mut system)
  let libraryText = "pub type Alias = bool\n// This unique source allocation is rejected inside the nested import.\n"
  let librarySource = run present(libraryText)
    |> Effect.provideMut<Allocator>(&mut system)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let revision = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut semantic = Semantic.make(move revision)
  let mut failedRequest = Request.make()
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(libraryText).length,
    rejected: false,
  }
  let attempted = run Effect.result(
    Semantic.demandSignature(&mut semantic, &mut failedRequest, &entry, b"entry"),
  )
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Success {value: ignored} => false
  }
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Import) > 0,
    "nested imported-signature provider failure publishes no root",
  )
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandSignature(&mut semantic, &mut retriedRequest, &entry, b"entry")
    |> Effect.provideMut<Allocator>(&mut system)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&retried, inspect).success && Request.rootCount(
      &retriedRequest,
    ) == 1 && Request.hasDiscovered(&retriedRequest, &library) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 2,
    "retry recomputes the same signature and publishes complete imported evidence",
  )
  return ()
}

test effect fn retriesNestedImportedSignatureAfterTypedFailure() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  return run nestedFailureRetryClaims()
}

test effect fn canonicalTypeIdentityKeepsNominalOwners() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let left = run module("left.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run module("right.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leftSource = run present(
    "struct Item {}\ntype Alias = Item\nfn original() -> Item { return () }\nfn aliased() -> Alias { return () }\nfn count() -> i32 { return 1 }\nfn flag() -> bool { return true }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rightSource = run present("struct Item {}\nfn original() -> Item { return () }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &left, &leftSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &right, &rightSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move held)
  let mut request = Request.make()
  let original = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"original")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliased = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"aliased")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &right, b"original")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let count = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"count")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let flag = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"flag")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    signatureOwnedBy(&original, &left) && signatureOwnedBy(&aliased, &left) && !signatureOwnedBy(
      &other,
      &left,
    ) && signatureOwnedBy(&other, &right) && signatureIsI32(&count) && !signatureIsBool(&count) && signatureIsBool(
      &flag,
    ) && !signatureIsI32(&flag),
    "source signatures keep nominal module owners and distinct scalar kinds",
  )
  return ()
}

test effect fn bodyChecksDemandedScalarReturnsAndReplaysEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bodies.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "type Byte = u8\nfn answer() -> i32 { return 42 }\nfn broken() -> i32 { return missing }\nfn fits() -> u8 { return 255 }\nfn tooLarge() -> u8 { return 256 }\nfn alias() -> Byte { return 255 }\nfn echo(value: i32) -> i32 { return value }\nfn discard() { 7 }\nfn empty() {}\nfn bare() { return }\nfn explicit() -> () { return () }\nfn mismatch() -> bool { return 1 }\nfn noReturn() -> i32 { true }\nfn unsupported() -> i32 { return 1 + 2 }\n"
  let held = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &held)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()

  let answer = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"answer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let answerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &answer,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move answerBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"i32") && TypedBody.nodeSlice(body).length == 3 && TypedBody.runtimeBodies(
            body,
          ).length == 0 && TypedBody.signatureDependencies(body).length == 1
        },
      ),
      "demanded answer has a complete typed return and signature dependency",
    )
  } else {
    run Testing.expect(false, "demanded answer has a checked body")
  }
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Body) == 1 && Request.hasDemand(
      &request,
      Family.Signature,
      &entry,
    ) && Request.hasDiscovered(&request, &entry),
    "demanding answer does not start the broken body and retains its source",
  )
  let priorStarts = starts(Semantic.eventLog(&semantic), Family.Body)
  let mut fresh = Request.make()
  let replayed = run Semantic.demandBody(&mut semantic, &mut fresh, &entry, b"answer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == priorStarts && hits(Semantic.eventLog(&semantic), Family.Body) == 1 && Request.hasRoot(
      &fresh,
      Family.Body,
      &entry,
      b"answer",
    ) && Request.hasDemand(&fresh, Family.Signature, &entry) && Request.hasDiscovered(
      &fresh,
      &entry,
    ),
    "a fresh request reuses and replays the completed body answer",
  )

  let broken = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"broken")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &broken,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.UnknownName, String.utf8Bytes(text), b"missing")
      },
    ),
    "the demanded unresolved parameter name is rejected at its source span",
  )

  let fits = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"fits")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooLarge = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooLarge")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fitsBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &fits,
    checkedBody,
  )
  let aliasBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &alias,
    checkedBody,
  )
  let mut typedAsU8 = false
  if let Option<Shared<TypedBody>>.Some {value} = move fitsBody {
    typedAsU8 = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyFirstIntegerType(body, b"u8")
      },
    )
  }
  if let Option<Shared<TypedBody>>.Some {value} = move aliasBody {
    typedAsU8 = typedAsU8 && Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyFirstIntegerType(body, b"u8")
      },
    )
  } else {
    typedAsU8 = false
  }
  run Testing.expect(
    typedAsU8 && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooLarge,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.IntegerOutOfRange)
      },
    ),
    "the immediate return context selects u8 through an alias and checks exact range",
  )

  let echo = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"echo")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let echoBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &echo,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move echoBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyReadsParameter),
      "parameter read keeps its authored binder identity",
    )
  } else {
    run Testing.expect(false, "parameter read has a checked body")
  }
  let discard = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"discard")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let discardBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &discard,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move discardBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"i32")
        },
      ),
      "an integer without immediate context defaults to i32",
    )
  } else {
    run Testing.expect(false, "unit expression body is checked")
  }
  let empty = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"empty")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bare = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bare")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicit = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&empty, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&bare, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &explicit,
      inspect,
    ).success,
    "empty, bare-return, and explicit-unit bodies satisfy unit contracts",
  )
  let mismatch = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mismatch")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noReturn = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noReturn")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unsupported = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unsupported")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &mismatch,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.TypeMismatch)
      },
    ),
    "incompatible return has a type-mismatch rejection",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &noReturn,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.MissingReturn)
      },
    ),
    "reachable non-unit fallthrough has a missing-return rejection",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &unsupported,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.Unsupported)
      },
    ),
    "an operator has an unsupported-syntax rejection",
  )
  return ()
}
