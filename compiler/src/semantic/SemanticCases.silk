effect fn stagedCallableParameterForwardingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("forwarded-staged-parameter.silk")
  let text = """
fn relay(callback: fn<'static>(i32) -> i32) -> i32 { return callback(1) }
fn invoke<F: fn<'static>(i32, i32) -> i32>(callback: F) -> i32 {
  let next = callback(2)
  return relay(next)
}
fn main() -> i32 {
  let add = fn(first: i32, last: i32) -> i32 { return first + last }
  return invoke(add)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "the source constrained callable specializes its staged owner")
  let selected = namedMirApplication(&store, &caller, b"invoke")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let owner = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&owner) && stagedParameterRuntimeTypes(&store, &owner),
      "the staging owner normalizes its abstract recipe before forwarding its environment")
    let forwarded = namedMirApplication(&store, &owner, b"relay")
    if let Option<Shared<SpecializationApplication>>.Some {value: relay} = move forwarded {
      let next = run SpecializationApplication.copyShared(&relay)
      let target = run Semantic.demandApplicationMir(&mut store, &mut request, &next)
      run Testing.expect(succeeded(&target) && stagedParameterRuntimeTypes(&store, &target)
        && stagedAnonymousFields(&store, &target, CallableMode.Shared, false),
        "a plain callable parameter receives the closed staged environment and directly invokes its original target")
      return ()
    }
  }
  run Testing.expect(false, "both source callable parameters retain ordinary exact function applications")
}

test effect fn effectLiteralsRunTheirInstanceWithTheirEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectLiteralClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn effectLiteralClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-literals.silk")
  let text = """
struct Missing { code: i32 }
struct Offline {}
fn block() -> i32 {
  let base = 40
  let pending = effect { return base + 2 }
  return run pending
}
effect fn fallible(code: i32) -> i32 ! Missing | Offline {
  let pending = effect {
    if code > 1 { fail Offline {} }
    if code > 0 { fail Missing { code: code } }
    return code
  }
  return run pending
}
fn anonymous() -> i32 {
  let add = effect fn(value: i32) -> i32 { return value + 1 }
  return run add(1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let block = run Semantic.demandMir(&mut store, &mut request, &id, b"block")
  let fallible = run Semantic.demandMir(&mut store, &mut request, &id, b"fallible")
  let anonymous = run Semantic.demandMir(&mut store, &mut request, &id, b"anonymous")
  run Testing.expect(effectBlockOperands(&store, &block) == usize.ONE && failureFact(&store, &block, 2) == usize.ZERO,
    "running a stored Effect block calls the block's instance with its environment")
  run Testing.expect(effectBlockOperands(&store, &fallible) == usize.ONE && failureFact(&store, &fallible, 2) == usize.ONE,
    "a block's derived failures give its run a failure edge")
  let runner = effectBlockApplication(&store, &fallible)
  if let Option<Shared<SpecializationApplication>>.Some {value} = move runner {
    let application = run SpecializationApplication.copyShared(&value)
    let instance = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(failureFact(&store, &instance, usize.ZERO) == usize.ONE && failureFact(&store, &instance, usize.ONE) == 2,
      "the block's instance fails through its out-slot with the join of its failures")
  } else {
    run Testing.expect(false, "the fallible block's run references its instance")
  }
  run Testing.expect(effectBlockOperands(&store, &anonymous) == 2,
    "running an invoked anonymous effect fn calls its instance with its environment and argument")
}

fn characterEmbeddedValue(data: &StaticData, integer: bool, kind: StaticIntegerType, scalar: u32) -> bool {
  return match &data.* {
    StaticData.Character {scalar: actual} => !integer && actual == scalar
    StaticData.Integer {ty, sign, magnitude} => integer && ty == kind && sign == StaticSign.Positive && magnitude == u32.toU64(scalar)
    _ => false
  }
}

fn characterBodyFact(answer: &Shared<Result<Answer, NoRejection>>, spelling: &[u8], integer: bool, kind: StaticIntegerType, scalar: u32, count: usize) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    return Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return characterBodyValue(body, spelling, integer, kind, scalar, count)
    })
  }
  return false
}

fn characterBodyValue(body: &TypedBody, spelling: &[u8], integer: bool, kind: StaticIntegerType, scalar: u32, count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut matching = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Embedded {value}} = &nodes[at].kind {
      let typed = Shared.with<Type, bool>(&ty, fn(found: &Type) -> bool { return witnessPrimitive(found, spelling) })
      let exact = Shared.with<StaticData, bool>(&value, fn(data: &StaticData) -> bool { return characterEmbeddedValue(data, integer, kind, scalar) })
      if typed && exact { matching = matching + usize.ONE }
    }
    at = at + usize.ONE
  }
  return matching == count
}

fn characterInitializerFact(answer: &Shared<Result<Answer, NoRejection>>, integer: bool, kind: StaticIntegerType, scalar: u32) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(answer, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return characterInitializerValue(answer, integer, kind, scalar)
  })
}

fn characterInitializerValue(answer: &Result<Answer, NoRejection>, integer: bool, kind: StaticIntegerType, scalar: u32) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Initializer {value: selected}} = &value.outcome {
      return Shared.with<StaticData, bool>(&selected, fn(data: &StaticData) -> bool { return characterEmbeddedValue(data, integer, kind, scalar) })
    }
  }
  return false
}

fn characterSubtractMirOrder(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statement = usize.ZERO
        while statement < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Binary {operation, left, right}, ..} = &statements[statement] {
            if operation == InfixOperator.Subtract { return integerOperand(&left, b"5") && integerOperand(&right, b"2") }
          }
          statement = statement + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn characterCallsMirOrder(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut block = usize.ZERO
      let mut phase = usize.ZERO
      while phase < 2 {
        if block >= blocks.length { return false }
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, normal, ..} = &blocks[block].terminator {
          let identity = InstanceKey.identity(&key)
          let mut expected = b"leftValue"
          if phase == usize.ONE { expected = b"rightValue" }
          if !Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, expected) }) { return false }
          block = normal
          phase = phase + usize.ONE
        } else { return false }
      }
      return true
    }
  }
  return false
}

test effect fn characterLiteralsRetainExactContextualAndStaticValues() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run characterLiteralClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn characterLiteralClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  // Numeric suffix fields exist in HIR, but the current source frontend does not produce them.
  // Pin that exact refusal; this is not a witness of suffix-present semantic driver policy.
  let mut suffixLexer = Lexer.make(b"65u8")
  let suffixToken = run Stream.take(&mut suffixLexer)
  let suffixRefused = match move suffixToken {
    Option<Token>.Some {value: Token.InvalidDurationLiteral {span, diagnostic: LexicalDiagnostic.UnknownDurationUnit {spelling, span: reason}}} =>
      span.start == usize.ZERO && span.end == 4 && spelling.start == 2 && spelling.end == 3 && reason.start == 2 && reason.end == 3
    _ => false
  }
  run Testing.expect(suffixRefused, "65u8 remains an invalid duration token with an unknown unit u at bytes 2..3")
  let id = run module("contextual-character.silk")
  let text = """
fn ascii() -> char { return 'A' }
fn unicode() -> char { return 'é' }
fn byte() -> u8 { return 'A' }
fn zero() -> u8 { return '\\0' }
fn wide() -> u64 { return 'Ā' }
fn word() -> usize { return '😀' }
fn compared(value: u8) -> bool { return value == 'é' && 'é' == value }
fn lambdaWide() -> u16 { return 'λ' }
fn signedWide() -> i16 { return 'λ' }
fn tooLambda() -> u8 { return 'λ' }
fn noCoercion(heldCharacter: char) -> u8 { return heldCharacter }
fn wrongFloat() -> f64 { return 'F' }
struct Marker {}
fn wrongNominal() -> Marker { return 'N' }
fn firstInteger() -> bool { return 65 == 'A' }
fn firstCharacter() -> bool { return 'A' == 65 }
fn charLocal(value: char) -> bool { return value == 'A' && 'A' == value }
fn overflowCompare(value: u8) -> bool { return value == 'λ' }
fn integerContext(value: u8) -> bool { return 5 == value }
fn floatContext(value: f32) -> bool { return 0.5 == value }
fn difference() -> i32 { return 5 - 2 }
fn leftValue() -> i32 { return 5 }
fn rightValue() -> i32 { return 2 }
fn orderedCalls() -> i32 { return leftValue() - rightValue() }
static fn staticDifference() -> i32 { return 5 - 2 }
const exactDifference: i32 = staticDifference()
fn tooWide() -> u8 { return 'Ā' }
fn tooSigned() -> i8 { return '\u{80}' }
fn wrong() -> bool { return 'Q' }
static fn staticByte() -> u8 { return 'A' }
const evaluated: u8 = staticByte()
const nonAscii: char = 'é'
fn readsNonAscii() -> char { return nonAscii }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.Wasm32UnknownUnknown))
  let mut request = Request.make()
  let ascii = run Semantic.demandBody(&mut store, &mut request, &id, b"ascii")
  let unicode = run Semantic.demandBody(&mut store, &mut request, &id, b"unicode")
  let byte = run Semantic.demandBody(&mut store, &mut request, &id, b"byte")
  let zero = run Semantic.demandBody(&mut store, &mut request, &id, b"zero")
  let wide = run Semantic.demandBody(&mut store, &mut request, &id, b"wide")
  let word = run Semantic.demandBody(&mut store, &mut request, &id, b"word")
  let compared = run Semantic.demandBody(&mut store, &mut request, &id, b"compared")
  run Testing.expect(characterBodyFact(&ascii, b"char", false, StaticIntegerType.U8, 65, usize.ONE)
    && characterBodyFact(&unicode, b"char", false, StaticIntegerType.U8, 233, usize.ONE)
    && characterBodyFact(&byte, b"u8", true, StaticIntegerType.U8, 65, usize.ONE)
    && characterBodyFact(&zero, b"u8", true, StaticIntegerType.U8, 0, usize.ONE)
    && characterBodyFact(&wide, b"u64", true, StaticIntegerType.U64, 256, usize.ONE)
    && characterBodyFact(&word, b"usize", true, StaticIntegerType.Usize, 0x1f600, usize.ONE)
    && characterBodyFact(&compared, b"u8", true, StaticIntegerType.U8, 233, 2),
    "authored character scalars retain exact char or contextual integer types and values, including a 32-bit target word")
  let lambdaWide = run Semantic.demandBody(&mut store, &mut request, &id, b"lambdaWide")
  let signedWide = run Semantic.demandBody(&mut store, &mut request, &id, b"signedWide")
  let tooLambda = run Semantic.demandBody(&mut store, &mut request, &id, b"tooLambda")
  let noCoercion = run Semantic.demandBody(&mut store, &mut request, &id, b"noCoercion")
  let wrongFloat = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFloat")
  let wrongNominal = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongNominal")
  run Testing.expect(characterBodyFact(&lambdaWide, b"u16", true, StaticIntegerType.U16, 955, usize.ONE)
    && characterBodyFact(&signedWide, b"i16", true, StaticIntegerType.I16, 955, usize.ONE)
    && rejectsSpan(&tooLambda, RejectionCode.IntegerOutOfRange, text, "'λ'", 2)
    && rejectsSpan(&noCoercion, RejectionCode.TypeMismatch, text, "heldCharacter", usize.ONE)
    && rejectsSpan(&wrongFloat, RejectionCode.TypeMismatch, text, "'F'", usize.ZERO)
    && rejectsSpan(&wrongNominal, RejectionCode.TypeMismatch, text, "'N'", usize.ZERO),
    "immediate signed and unsigned contexts admit codepoints; typed char values and noninteger contexts retain exact mismatch spans")
  let firstInteger = run Semantic.demandBody(&mut store, &mut request, &id, b"firstInteger")
  let firstCharacter = run Semantic.demandBody(&mut store, &mut request, &id, b"firstCharacter")
  let charLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"charLocal")
  let overflowCompare = run Semantic.demandBody(&mut store, &mut request, &id, b"overflowCompare")
  run Testing.expect(characterBodyFact(&firstInteger, b"i32", true, StaticIntegerType.I32, 65, usize.ONE),
    "an all-literal pair keeps its first integer default")
  run Testing.expect(rejectsSpan(&firstCharacter, RejectionCode.TypeMismatch, text, "65", usize.ONE),
    "an all-literal pair keeps its first character default and rejects the bare incompatible integer")
  run Testing.expect(characterBodyFact(&charLocal, b"char", false, StaticIntegerType.U8, 65, 2),
    "both character-local comparisons retain Character scalars")
  run Testing.expect(rejectsSpan(&overflowCompare, RejectionCode.IntegerOutOfRange, text, "'λ'", 3),
    "a declared u8 driver rejects the exact overflowing character literal")
  let integerContext = run Semantic.demandBody(&mut store, &mut request, &id, b"integerContext")
  let floatContext = run Semantic.demandBody(&mut store, &mut request, &id, b"floatContext")
  run Testing.expect(succeeded(&integerContext) && succeeded(&floatContext),
    "existing declared integer and float operand contexts remain accepted")
  let difference = run Semantic.demandMir(&mut store, &mut request, &id, b"difference")
  let ordered = run Semantic.demandMir(&mut store, &mut request, &id, b"orderedCalls")
  let exactDifference = run Semantic.demandInitializer(&mut store, &mut request, &id, b"exactDifference")
  run Testing.expect(characterSubtractMirOrder(&store, &difference) && characterCallsMirOrder(&store, &ordered)
    && characterInitializerFact(&exactDifference, true, StaticIntegerType.I32, 3),
    "noncommutative all-literal subtraction retains left 5 and right 2, evaluates to 3, and declared calls retain authored order")
  let tooWide = run Semantic.demandBody(&mut store, &mut request, &id, b"tooWide")
  let tooSigned = run Semantic.demandBody(&mut store, &mut request, &id, b"tooSigned")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  run Testing.expect(rejectsSpan(&tooWide, RejectionCode.IntegerOutOfRange, text, "'Ā'", usize.ONE)
    && rejectsSpan(&tooSigned, RejectionCode.IntegerOutOfRange, text, "'\u{80}'", usize.ZERO)
    && rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "'Q'", usize.ZERO),
    "unsigned and signed range overflow and noninteger mismatches retain exact authored literal spans")
  let evaluated = run Semantic.demandInitializer(&mut store, &mut request, &id, b"evaluated")
  let nonAscii = run Semantic.demandInitializer(&mut store, &mut request, &id, b"nonAscii")
  run Testing.expect(characterInitializerFact(&evaluated, true, StaticIntegerType.U8, 65)
    && characterInitializerFact(&nonAscii, false, StaticIntegerType.U8, 233),
    "checked contextual static execution returns integer data while default non-ASCII char remains Character")
  let readsNonAscii = run Semantic.demandBody(&mut store, &mut request, &id, b"readsNonAscii")
  run Testing.expect(characterBodyFact(&readsNonAscii, b"char", false, StaticIntegerType.U8, 233, usize.ONE),
    "a runtime char constant read embeds its Character scalar at type char")
}

fn allocationSignatureParameter(answer: &Shared<Result<Answer, NoRejection>>, index: usize) -> Option<Shared<Type>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      if let Result<Answer, NoRejection>.Success {value: checkedAnswer} = &value.* {
        if let Outcome.Success {value: Value.Signature {signature}} = &checkedAnswer.outcome {
          let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
          if index < parameters.length { return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[index])) }
        }
      }
      return Option.none<Shared<Type>>()
    })
}

effect fn allocationLike(origin: &[u8], package: &[u8], path: &[u8], kind: OwnerKind, occurrence: usize, parent: bool) -> Shared<Type>
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let module = run ModuleId.make(origin, package, path)
  let mut owners = Vector.make<OwnerStep>()
  if parent { run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Struct,
    name: Option.some<Bytes>(run Bytes.copy(b"Parent")), occurrence: usize.ZERO}) }
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: kind,
    name: Option.some<Bytes>(run Bytes.copy(b"Allocation")), occurrence: occurrence})
  return run Shared.make<Type>(Type.Nominal {declaration: DeclarationId.fromParts(move module, move owners),
    isPublic: true, arguments: Vector.make<Argument>()})
}

test effect fn allocationCanonicalIdentityAndTypeShadowing() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run allocationCanonicalClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn allocationCanonicalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let first = run module("allocation-first.silk")
  let second = run module("allocation-second.silk")
  let text = "struct Allocation {}\nfn plain(value: Allocation) -> () { return () }\nfn shadow<Allocation>(value: Allocation) -> () { return () }\nfn excess(value: Allocation<i32>) -> () { return () }\n"
  let firstSource = run present(text)
  let secondSource = run present("fn plain(value: Allocation) -> () { return () }")
  let withFirst = run Revision.publish(&Revision.make(), &first, &firstSource)
  let revision = run Revision.publish(&withFirst, &second, &secondSource)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let plain = run Semantic.demandSignature(&mut store, &mut request, &first, b"plain")
  let other = run Semantic.demandSignature(&mut store, &mut request, &second, b"plain")
  let shadow = run Semantic.demandSignature(&mut store, &mut request, &first, b"shadow")
  let canonical = run SealedCore.allocation()
  let emptyBindings = Vector.make<Binding>()
  let copied = run Shared.make<Type>(run Type.copy(&canonical))
  let applied = run Type.applyBindings(&canonical, Vector.asSlice<Binding>(&emptyBindings), true)
  let mut index = usize.ZERO
  while index < 3 {
    let mut answer = Shared.clone<Result<Answer, NoRejection>>(&plain)
    if index == usize.ONE { answer = Shared.clone<Result<Answer, NoRejection>>(&other) }
    if index == 2 { answer = Shared.clone<Result<Answer, NoRejection>>(&shadow) }
    let selected = allocationSignatureParameter(&answer, usize.ZERO)
    if let Option<Shared<Type>>.Some {value} = move selected {
      run Testing.expect((run Type.equalsShared(&value, &canonical)) && SealedCore.isCore(&value, SealedKind.Allocation),
        "bare Allocation has one compiler-authenticated identity across source modules, source declarations and same-spelled binders")
    } else { run Testing.expect(false, "Allocation signature parameter is available") }
    index = index + usize.ONE
  }
  run Testing.expect((run Type.equalsShared(&canonical, &copied)) && (run Type.equalsShared(&canonical, &applied)),
    "copying and ordinary bindings retain Allocation identity")
  let owned = run Type.copy(&canonical)
  if let Type.Nominal {declaration, ..} = &owned {
    let originalKey = run Type.runtimeEncoding(&canonical, &declaration)
    let copiedKey = run Type.runtimeEncoding(&copied, &declaration)
    let appliedKey = run Type.runtimeEncoding(&applied, &declaration)
    run Testing.expect(sameBytes(Bytes.asSlice(&originalKey), Bytes.asSlice(&copiedKey))
      && sameBytes(Bytes.asSlice(&originalKey), Bytes.asSlice(&appliedKey)),
      "runtime encoding preserves complete sealed declaration identity through copies and bindings")
  } else { run Testing.expect(false, "Allocation uses existing Nominal representation") }
  let excess = run Semantic.demandSignature(&mut store, &mut request, &first, b"excess")
  run Testing.expect(rejectsSpan(&excess, RejectionCode.TypeArity, text, "i32", usize.ZERO)
    && Shared.with<Result<Answer, NoRejection>, bool>(&excess, allocationZeroArity),
    "Allocation accepts zero supplied type arguments and points at the offending argument")
  let sourceLike = run allocationLike(b"file", b"silk", b"silk/core", OwnerKind.Struct, usize.ZERO, false)
  let packageLike = run allocationLike(b"compiler-sealed-core", b"other", b"silk/core", OwnerKind.Struct, usize.ZERO, false)
  let pathLike = run allocationLike(b"compiler-sealed-core", b"silk", b"other/core", OwnerKind.Struct, usize.ZERO, false)
  let kindLike = run allocationLike(b"compiler-sealed-core", b"silk", b"silk/core", OwnerKind.Union, usize.ZERO, false)
  let occurrenceLike = run allocationLike(b"compiler-sealed-core", b"silk", b"silk/core", OwnerKind.Struct, usize.ONE, false)
  let parentLike = run allocationLike(b"compiler-sealed-core", b"silk", b"silk/core", OwnerKind.Struct, usize.ZERO, true)
  run Testing.expect(!SealedCore.isCore(&sourceLike, SealedKind.Allocation)
    && !SealedCore.isCore(&packageLike, SealedKind.Allocation)
    && !SealedCore.isCore(&pathLike, SealedKind.Allocation)
    && !SealedCore.isCore(&kindLike, SealedKind.Allocation)
    && !SealedCore.isCore(&occurrenceLike, SealedKind.Allocation)
    && !SealedCore.isCore(&parentLike, SealedKind.Allocation)
    && !(run Type.equalsShared(&canonical, &sourceLike)),
    "same spelling/path alone cannot forge the reserved origin, package, owner kind, occurrence or complete chain")
}

test effect fn allocationConstructionRefusesAndInherentLookupStaysOrdinary() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run allocationExpressionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn allocationExpressionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("allocation-source-expression.silk")
  let text = """
struct Allocation {}
impl Allocation { fn value() -> i32 { return 1 } }
fn source() -> i32 { return Allocation.value() }
fn blocked() -> Allocation { return Allocation {} }
fn shadow<Allocation>() -> i32 { let made = Allocation {} return 1 }
struct Holder<T> { owner: T }
fn typed(value: Allocation) -> Holder<Allocation> { return Holder<Allocation> { owner: move value } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"source")
  let sourceBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&source, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move sourceBody {
    run Testing.expect(Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyCalls(body, &id, usize.ZERO)
    }), "an inherent namespace member resolves the ordinary source Allocation owner")
  } else { run Testing.expect(false, "ordinary source Allocation inherent namespace call is checked") }
  let blocked = run Semantic.demandBody(&mut store, &mut request, &id, b"blocked")
  run Testing.expect(rejectsSpan(&blocked, RejectionCode.NotType, text, "Allocation {}", usize.ONE),
    "the raw constructor type root remains sealed even beside a same-spelled source declaration")
  let shadow = run Semantic.demandBody(&mut store, &mut request, &id, b"shadow")
  run Testing.expect(rejectsSpan(&shadow, RejectionCode.NotType, text, "Allocation {}", 2),
    "a same-spelled type binder cannot grant a raw Allocation constructor")
  let typed = run Semantic.demandBody(&mut store, &mut request, &id, b"typed")
  run Testing.expect(succeeded(&typed), "ordinary Holder construction retains its canonical Allocation argument")
  let genericId = run module("allocation-source-generic.silk")
  let genericText = """
struct Allocation<T> { item: T }
fn supplied() -> i32 { let made = Allocation<i32> { item: 1 } return 1 }
fn inferred() -> i32 { let made = Allocation { item: 1 } return 1 }
"""
  let mut generic = run staticSemantic(&genericId, genericText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let supplied = run Semantic.demandBody(&mut generic, &mut request, &genericId, b"supplied")
  run Testing.expect(rejectsSpan(&supplied, RejectionCode.TypeArity, genericText, "i32", usize.ONE)
    && Shared.with<Result<Answer, NoRejection>, bool>(&supplied, allocationZeroArity),
    "a generic source declaration cannot override reserved zero-arity constructor typing")
  let inferred = run Semantic.demandBody(&mut generic, &mut request, &genericId, b"inferred")
  run Testing.expect(rejectsSpan(&inferred, RejectionCode.NotType, genericText, "Allocation { item: 1 }", usize.ZERO),
    "the inferred source aggregate shortcut cannot forge canonical Allocation construction")
  let absentId = run module("allocation-no-source-constructor.silk")
  let absentText = "fn absent() -> Allocation { return Allocation {} }"
  let mut absent = run staticSemantic(&absentId, absentText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let missing = run Semantic.demandBody(&mut absent, &mut request, &absentId, b"absent")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.NotType, absentText, "Allocation {}", usize.ZERO),
    "admitting the canonical nominal type does not admit its opaque field constructor")
}

fn allocationZeroArity(answer: &Result<Answer, NoRejection>) -> bool {
  let selected = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move selected {
    return Shared.with<Rejection, bool>(&value, fn(found: &Rejection) -> bool {
      return found.code == RejectionCode.TypeArity && found.expected == usize.ZERO && found.supplied == usize.ONE
    })
  }
  return false
}

test effect fn allocationRemainsAffineThroughPremisesAndStoredParts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run allocationAffineClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn allocationAffineClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("allocation-affine.silk")
  let text = """
struct Inner { owner: Allocation }
struct Outer { inner: Inner }
union Choice { Empty, Owned { owner: Allocation } }
struct Box<T> { value: T }
impl<T: Copy> Copy for Box<T> {}
fn core(value: &Allocation) -> () { drop value.* return () }
fn nested(value: &Outer) -> () { drop value.* return () }
fn array(value: &([Allocation; 1])) -> () { drop value.* return () }
fn unioned(value: &Choice) -> () { drop value.* return () }
fn conditional(value: &Box<Allocation>) -> () { drop value.* return () }
fn scalar(value: &i32) -> () { drop value.* return () }
fn copied(value: &Box<i32>) -> () { drop value.* return () }
fn declared<Allocation: Copy>(value: &Allocation) -> () { drop value.* return () }
fn accepts<T: Copy>(value: T) -> () { return () }
fn applied(value: Allocation) -> () { return accepts<Allocation>(move value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let core = run Semantic.demandBody(&mut store, &mut request, &id, b"core")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let array = run Semantic.demandBody(&mut store, &mut request, &id, b"array")
  let unioned = run Semantic.demandBody(&mut store, &mut request, &id, b"unioned")
  let conditional = run Semantic.demandBody(&mut store, &mut request, &id, b"conditional")
  let declared = run Semantic.demandBody(&mut store, &mut request, &id, b"declared")
  run Testing.expect(rejectsSpan(&core, RejectionCode.BorrowedExtraction, text, "value.*", usize.ZERO), "canonical Allocation is affine")
  run Testing.expect(rejectsSpan(&nested, RejectionCode.BorrowedExtraction, text, "value.*", usize.ONE), "nested source records retain affine core storage")
  run Testing.expect(rejectsSpan(&array, RejectionCode.BorrowedExtraction, text, "value.*", 2), "an array of core owners is affine")
  run Testing.expect(rejectsSpan(&unioned, RejectionCode.BorrowedExtraction, text, "value.*", 3), "a nominal union storing core is affine")
  run Testing.expect(rejectsSpan(&conditional, RejectionCode.BorrowedExtraction, text, "value.*", 4), "an instantiated conditional Copy head cannot prove Allocation Copy")
  run Testing.expect(rejectsSpan(&declared, RejectionCode.BorrowedExtraction, text, "value.*", 7), "same-spelled declared Copy premise cannot redirect or make the canonical core Copy")
  let scalar = run Semantic.demandBody(&mut store, &mut request, &id, b"scalar")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  run Testing.expect(succeeded(&scalar) && succeeded(&copied), "ordinary scalar and source conditional Copy remain valid")
  let applied = run Semantic.demandBody(&mut store, &mut request, &id, b"applied")
  run Testing.expect(rejectsSpan(&applied, RejectionCode.Unsupported, text, "accepts<Allocation>(move value)", usize.ZERO), "generic-call application cannot instantiate a core Copy premise")
  let invalidId = run module("allocation-invalid-copy.silk")
  let invalidText = "struct Fixed<T> { item: T owner: Allocation }\nimpl<T: Copy> Copy for Fixed<T> {}\nfn fixed(value: &Fixed<i32>) -> () { drop value.* return () }"
  let mut invalid = run staticSemantic(&invalidId, invalidText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let fixed = run Semantic.demandBody(&mut invalid, &mut request, &invalidId, b"fixed")
  run Testing.expect(rejectsSpan(&fixed, RejectionCode.InvalidCopyConformance, invalidText, "impl<T: Copy> Copy for Fixed<T> {}", usize.ZERO), "a source Copy conformance cannot hide a stored core owner behind another proven field")
  let copyId = run module("allocation-source-copy.silk")
  let copyText = "struct Allocation {}\nimpl Copy for Allocation {}"
  let mut copyStore = run staticSemantic(&copyId, copyText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let copyHead = run Semantic.demandImplementations(&mut copyStore, &mut request, &copyId)
  run Testing.expect(rejectsSpan(&copyHead, RejectionCode.ConformanceOwner, copyText, "impl Copy for Allocation {}", usize.ZERO), "a source same-spelled owner cannot implement Copy for the canonical core")
  let dropId = run module("allocation-source-drop.silk")
  let dropText = "struct Allocation {}\nimpl Drop for Allocation { fn drop(self: &mut Allocation) -> () { return () } }"
  let mut dropStore = run staticSemantic(&dropId, dropText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let dropHead = run Semantic.demandImplementations(&mut dropStore, &mut request, &dropId)
  run Testing.expect(rejectsSpan(&dropHead, RejectionCode.ConformanceOwner, dropText, "impl Drop for Allocation { fn drop(self: &mut Allocation) -> () { return () } }", usize.ZERO), "source cannot install release authority on the canonical core")
}

test effect fn sealedCoreLayoutsAndCleanup() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run sealedCoreLayoutClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Whether a layout answer is an eight-byte-aligned record of `count` fields and `size` bytes whose
// last field starts at `last`.
fn coreRecordLayout(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, count: usize, size: usize, last: usize) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedLayoutIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(store, index) {
      return Shared.with<BackendLayout, bool>(&facts, fn(layout: &BackendLayout) -> bool {
        if let LayoutStorage.Record {fields} = &layout.storage {
          let entries = Vector.asSlice<LayoutField>(&fields)
          return entries.length == count && layout.size == size && layout.alignment == 8
            && entries[usize.ZERO].offset == usize.ZERO && entries[count - usize.ONE].offset == last
        }
        return false
      })
    }
  }
  return false
}

// The sealed C allocator functions one MIR answer declares, counted when they are `wanted`.
fn sealedExterns(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, wanted: SealedFunction) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let externs = Vector.asSlice<Shared<DeclarationId>>(&function.externs)
      let mut count = usize.ZERO
      let mut at = usize.ZERO
      while at < externs.length {
        let sealed = Shared.with<DeclarationId, Option<SealedFunction>>(&externs[at], SealedCore.declarationFunction)
        if let Option<SealedFunction>.Some {value} = move sealed {
          if value == wanted { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
      return count
    }
  }
  return usize.MAX
}

effect fn sealedCoreLayoutClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("sealed-core-layouts.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Inner { owner: Allocation }
struct Outer { inner: Inner }
impl Drop for Outer { fn drop(self: &mut Outer) -> () { return () } }
fn shapes(core: Allocation, buffer: RawBuffer<i32>, slot: Slot<'static, i32>, shared: Intrinsic.SharedCore<i64>, guarded: Intrinsic.SharedCore<Token>, outer: Outer) -> () { return () }
struct RawBuffer {}
struct Linked { next: Intrinsic.SharedCore<Linked> | Token }
struct Full<T> { buffer: RawBuffer<T> }
struct Window<'a> { slot: Slot<'a, i32> }
fn fields(linked: Linked, full: Full<i32>, window: Window<'static>) -> () { return () }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let fields = run Semantic.demandSignature(&mut store, &mut request, &id, b"fields")
  run Testing.expect(succeeded(&fields),
    "a stored storage core contributes only its element types to field lifetimes, past a same-spelled source owner")
  if let Option<Shared<Type>>.Some {value: linked} = move allocationSignatureParameter(&fields, usize.ZERO) {
    let laid = run Semantic.demandLayout(&mut store, &mut request, &id, &linked)
    let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&laid, selectedLayoutIndex)
    run Testing.expect(match move selected { Option<usize>.Some {..} => true _ => false },
      "a structural union of a shared core of its container and a record is laid out")
  } else { run Testing.expect(false, "the recursive container has a checked signature type") }
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"shapes")
  let mut types = Vector.make<Shared<Type>>()
  let mut at = usize.ZERO
  while at < 6 {
    match move allocationSignatureParameter(&signature, at) {
      Option<Shared<Type>>.Some {value} => { run Vector.append<Shared<Type>>(&mut types, move value) }
      Option<Shared<Type>>.None => {
        run Testing.expect(false, "every sealed core shape has a checked signature type")
        return ()
      }
    }
    at = at + usize.ONE
  }
  let shapes = Vector.asSlice<Shared<Type>>(&types)
  run Testing.expect(SealedCore.isCore(&shapes[usize.ZERO], SealedKind.Allocation) && SealedCore.isCore(&shapes[usize.ONE], SealedKind.RawBuffer)
    && SealedCore.isCore(&shapes[2], SealedKind.Slot) && SealedCore.isCore(&shapes[3], SealedKind.SharedCore),
    "the storage core names resolve to their sealed identities in type position")
  let allocation = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[usize.ZERO])
  let buffer = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[usize.ONE])
  let slot = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[2])
  let shared = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[3])
  run Testing.expect(coreRecordLayout(&store, &allocation, 6, 48, 40) && coreRecordLayout(&store, &buffer, 2, 56, 48)
    && coreRecordLayout(&store, &slot, usize.ONE, 8, usize.ZERO) && coreRecordLayout(&store, &shared, usize.ONE, 8, usize.ZERO),
    "an allocation is six words, a raw buffer its allocation and count, and a slot or shared core one address")
  let release = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[usize.ZERO])
  run Testing.expect(glueFact(&store, &release, usize.ONE) == usize.ONE && sealedExterns(&store, &release, SealedFunction.Free) == usize.ONE,
    "an allocation releases its storage through one sealed free call")
  let adopted = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[usize.ONE])
  run Testing.expect(glueFact(&store, &adopted, usize.ZERO) == usize.ONE && glueFact(&store, &adopted, usize.ONE) == usize.ZERO,
    "a raw buffer drops its allocation and never discovers elements")
  let counted = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[3])
  let guarded = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[4])
  run Testing.expect(glueFact(&store, &counted, 5) == usize.ONE && glueFact(&store, &counted, usize.ZERO) == usize.ONE
    && glueFact(&store, &guarded, usize.ZERO) == 2,
    "a shared core branches on its strong count, and the last handle drops a value needing cleanup before its allocation")
  let outer = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[5])
  run Testing.expect(glueFact(&store, &outer, usize.ONE) == usize.ONE && glueFact(&store, &outer, usize.ZERO) == usize.ONE,
    "a source Drop hook runs before the nested core storage it owns is released")
}

test effect fn storagePrimitivesFollowTheirContracts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run storagePrimitiveClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Counts in one MIR answer: traps (0), calls of sealed C allocator functions (1), failure exits (2)
// or calls (3).
fn storageFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut count = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        match &blocks[at].terminator {
          MirTerminator.Trap {..} => { if fact == usize.ZERO { count = count + usize.ONE } }
          MirTerminator.Call {callee, ..} => {
            if fact == 3 { count = count + usize.ONE }
            if fact == usize.ONE {
              if let MirCallee.Extern {declaration, ..} = &callee {
                let sealed = Shared.with<DeclarationId, Option<SealedFunction>>(&declaration, SealedCore.declarationFunction)
                if let Option<SealedFunction>.Some {..} = move sealed { count = count + usize.ONE }
              }
            }
          }
          MirTerminator.Fail {..} => { if fact == 2 { count = count + usize.ONE } }
          _ => ()
        }
        at = at + usize.ONE
      }
      return count
    }
  }
  return usize.MAX
}

effect fn storagePrimitiveClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("storage-primitives.silk")
  let layoutId = run module("silk/layout.silk")
  let text = """
import silk.layout { Layout }
struct Counter { value: i32 }
fn from(allocation: Allocation) -> RawBuffer<i32> { return unsafe Intrinsic.rawBufferFrom<i32>(move allocation, 4) }
fn select<'a>(buffer: &'a mut RawBuffer<i32>) -> Slot<'a, i32> { return unsafe Intrinsic.rawBufferSlot<i32>(buffer, 0) }
fn count(buffer: &RawBuffer<i32>) -> usize { return Intrinsic.rawBufferCount<i32>(buffer) }
fn view(buffer: &RawBuffer<i32>) -> &[i32] { return unsafe Intrinsic.rawBufferView<i32>(buffer, 0, 1) }
fn take(slot: Slot<'static, i32>) -> i32 { return unsafe Intrinsic.slotTake<i32>(move slot) }
fn address(slot: Slot<'static, i32>) -> *mut i32 { return Intrinsic.slotAddress<i32>(move slot) }
fn share(allocation: Allocation, value: i32) -> Intrinsic.SharedCore<i32> { return unsafe Intrinsic.sharedFromAllocation<i32>(move allocation, value) }
fn clone(core: &Intrinsic.SharedCore<i32>) -> Intrinsic.SharedCore<i32> { return Intrinsic.sharedClone<i32>(core) }
fn bump(value: &mut i32) -> i32 { return 1 }
fn busy() -> i32 { return 0 }
fn access(core: &Intrinsic.SharedCore<i32>) -> i32 { return Intrinsic.sharedWithMut<i32, i32>(core, bump, busy) }
fn swap(counter: &mut Counter) -> i32 { return Intrinsic.replace(counter.value, 2) }
fn bytes(text: string<'static>) -> &'static [u8] { return Intrinsic.stringUtf8Bytes(text) }
fn measure() -> Layout { return Intrinsic.layoutOf<i64>() }
effect fn acquire(layout: Layout) -> Allocation ! Intrinsic.StorageFailure { return run Intrinsic.systemAllocationAcquire(move layout) }
fn checked(buffer: &RawBuffer<i32>) -> i32 { return Intrinsic.rawBufferRead<i32>(buffer, 0) }
fn affine(buffer: &RawBuffer<Counter>) -> Counter { return unsafe Intrinsic.rawBufferRead<Counter>(buffer, 0) }
fn mismatched(buffer: &RawBuffer<i64>) -> usize { return Intrinsic.rawBufferCount<i32>(buffer) }
fn untyped(buffer: &RawBuffer<i32>) -> usize { return Intrinsic.rawBufferCount(buffer) }
fn misused(core: &Intrinsic.SharedCore<i32>) -> i32 { return Intrinsic.sharedWithMut<i32, i32>(core, busy, busy) }
fn fixed(value: i32) -> i32 { return Intrinsic.replace(value, 2) }
struct Empty {}
struct Node { next: Intrinsic.SharedCore<Node> | Empty }
fn recursive() -> Layout { return Intrinsic.sharedLayout<Node>() }
fn forward<T, A>(core: &Intrinsic.SharedCore<T>, use: once fn(&mut T) -> A) -> A {
  return Intrinsic.sharedWithMut<T, A>(core, move use, conflict)
}
fn conflict() -> never { return conflict() }
fn inspect<T, A>(value: &mut T, use: once fn(&T) -> A) -> A { return use(&value.*) }
fn inspectImplicit<T, A>(value: &mut T, use: once fn(&T) -> A) -> A { return use(move value) }
fn read(value: &i32) -> i32 { return value.* }
fn readBool(value: &i32) -> bool { return value.* > 0 }
fn sectionAccess(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return forward<i32, i32>(core, inspect<i32, i32>(read))
}
fn sectionBool(core: &Intrinsic.SharedCore<i32>) -> bool {
  return forward<i32, bool>(core, inspect<i32, bool>(readBool))
}
fn booleanUse(value: &mut i32) -> bool { return value.* > 0 }
fn neverUse(value: &mut i32) -> never { return conflict() }
fn sharedUseRejected(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return Intrinsic.sharedWithMut<i32, i32>(core, read, busy)
}
fn resultRejected(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return Intrinsic.sharedWithMut<i32, i32>(core, booleanUse, busy)
}
fn neverUseRejected(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return Intrinsic.sharedWithMut<i32, i32>(core, neverUse, conflict)
}
"""
  let layoutText = "pub struct Layout {\n  pub bytes: usize\n  pub alignment: usize\n}\n"
  let source = run present(text)
  let layoutSource = run present(layoutText)
  let withLayout = run Revision.publish(&Revision.make(), &layoutId, &layoutSource)
  let revision = run Revision.publish(&withLayout, &id, &source)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option.none<FinalProfile>())
  let mut request = Request.make()
  let names = ["from", "select", "count", "view", "take", "address", "share", "clone", "access", "swap", "bytes", "measure", "acquire"]
  let listed: &[string<'static>] = &names
  let mut typed = true
  let mut at = usize.ZERO
  while at < listed.length {
    let answer = run Semantic.demandBody(&mut store, &mut request, &id, String.utf8Bytes(listed[at]))
    typed = typed && succeeded(&answer)
    at = at + usize.ONE
  }
  run Testing.expect(typed, "each storage primitive types against its contract instantiated from its type arguments")
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"checked")
  let affine = run Semantic.demandBody(&mut store, &mut request, &id, b"affine")
  let mismatched = run Semantic.demandBody(&mut store, &mut request, &id, b"mismatched")
  let untyped = run Semantic.demandBody(&mut store, &mut request, &id, b"untyped")
  let misused = run Semantic.demandBody(&mut store, &mut request, &id, b"misused")
  let fixed = run Semantic.demandBody(&mut store, &mut request, &id, b"fixed")
  run Testing.expect(rejectsSpan(&checked, RejectionCode.UnsafeAcknowledgement, text, "Intrinsic.rawBufferRead<i32>(buffer, 0)", 0),
    "an unsafe storage primitive needs an acknowledgement")
  run Testing.expect(rejectsSpan(&affine, RejectionCode.MissingConformance, text, "Intrinsic.rawBufferRead<Counter>(buffer, 0)", 0),
    "a read that leaves its storage initialized needs a Copy element")
  run Testing.expect(rejectsSpan(&mismatched, RejectionCode.TypeMismatch, text, "Intrinsic.rawBufferCount<i32>(buffer)", 1),
    "an operand must match the contract instantiated from the written type arguments")
  run Testing.expect(rejectsFrom(&untyped, RejectionCode.TypeArity, offsetOf(text, "Intrinsic.rawBufferCount(buffer)", 0)),
    "an element-generic primitive needs its written type argument")
  run Testing.expect(rejectsSpan(&misused, RejectionCode.TypeMismatch, text, "Intrinsic.sharedWithMut<i32, i32>(core, busy, busy)", 0),
    "shared access needs a use taking the value exclusively")
  run Testing.expect(rejectsSpan(&fixed, RejectionCode.TypeMismatch, text, "Intrinsic.replace(value, 2)", 0),
    "a replacement displaces only a mutable place")
  let implicit = run Semantic.demandBody(&mut store, &mut request, &id, b"inspectImplicit")
  run Testing.expect(rejectsSpan(&implicit, RejectionCode.TypeMismatch, text, "use(move value)", usize.ZERO),
    "an exclusive reference does not become shared by transfer; inspection requires an authored reborrow")
  let from = run Semantic.demandMir(&mut store, &mut request, &id, b"from")
  let share = run Semantic.demandMir(&mut store, &mut request, &id, b"share")
  run Testing.expect(storageFact(&store, &from, usize.ZERO) == usize.ONE && storageFact(&store, &from, 3) == usize.ZERO,
    "adopting an allocation as a raw buffer traps on a layout mismatch and calls nothing")
  run Testing.expect(storageFact(&store, &share, usize.ZERO) == usize.ONE,
    "adopting an allocation as a shared core traps on a layout mismatch")
  let acquire = run Semantic.demandMir(&mut store, &mut request, &id, b"acquire")
  run Testing.expect(storageFact(&store, &acquire, usize.ONE) == usize.ONE && sealedExterns(&store, &acquire, SealedFunction.Malloc) == usize.ONE,
    "an acquisition calls the sealed malloc once")
  run Testing.expect(storageFact(&store, &acquire, 2) == usize.ONE, "an acquisition refuses through one failure exit")
  let access = run Semantic.demandMir(&mut store, &mut request, &id, b"access")
  run Testing.expect(storageFact(&store, &access, 3) == 2, "shared access invokes its use or its conflict policy")
  let swap = run Semantic.demandMir(&mut store, &mut request, &id, b"swap")
  run Testing.expect(glueFact(&store, &swap, usize.ZERO) == usize.ZERO, "a replacement moves without cleanup")
  let measure = run Semantic.demandMir(&mut store, &mut request, &id, b"measure")
  run Testing.expect(succeeded(&measure), "a measured layout is a closed record value")
  let recursive = run Semantic.demandMir(&mut store, &mut request, &id, b"recursive")
  run Testing.expect(succeeded(&recursive), "a control block measures a value that stores a shared core of itself")
  let selected = run Semantic.demandMir(&mut store, &mut request, &id, b"sectionAccess")
  let selectedBool = run Semantic.demandMir(&mut store, &mut request, &id, b"sectionBool")
  let retained = run sharedCallbackMirChain(&mut store, &mut request, &id, &selected, b"i32", "read")
  let retainedBool = run sharedCallbackMirChain(&mut store, &mut request, &id, &selectedBool, b"bool", "readBool")
  run Testing.expect(succeeded(&selected) && succeeded(&selectedBool) && retained && retainedBool,
    "shared access specializes the original section result, lends the control-block value mutably, and forwards capture field zero to the original callback parameter one")
  let sharedUse = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedUseRejected")
  let wrongResult = run Semantic.demandBody(&mut store, &mut request, &id, b"resultRejected")
  let neverUse = run Semantic.demandBody(&mut store, &mut request, &id, b"neverUseRejected")
  run Testing.expect(rejectsSpan(&sharedUse, RejectionCode.TypeMismatch, text,
    "Intrinsic.sharedWithMut<i32, i32>(core, read, busy)", usize.ZERO),
    "a shared callback input cannot replace the required exclusive storage loan")
  run Testing.expect(rejectsSpan(&wrongResult, RejectionCode.TypeMismatch, text,
    "Intrinsic.sharedWithMut<i32, i32>(core, booleanUse, busy)", usize.ZERO),
    "a concrete callback result must satisfy the storage primitive's promised result")
  run Testing.expect(rejectsSpan(&neverUse, RejectionCode.TypeMismatch, text,
    "Intrinsic.sharedWithMut<i32, i32>(core, neverUse, conflict)", usize.ZERO),
    "never is admitted only for the conflict policy, not as the use callback's result")
}

// Follow the actual wrapper edge: demanding only the generic source body would not exercise
// the storage plan prepared for a captured section's concrete result and original application.
effect fn sharedCallbackMirChain(store: &mut Semantic, request: &mut Request, id: &ModuleId,
  entry: &Shared<Result<Answer, NoRejection>>, primitive: &[u8], reader: string) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let forward = match move sharedCallbackCalleeApplication(&store.*, entry, "forward") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !sharedCallbackApplication(&forward, id, b"forward", primitive) { return false }
  let invoked = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &forward)
  if !sharedCallbackStorageMir(&store.*, &invoked, id, primitive, String.utf8Bytes(reader)) { return false }
  let section = match move sharedCallbackCalleeApplication(&store.*, &invoked, "inspect") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !sharedCallbackApplication(&section, id, b"inspect", primitive) { return false }
  let inspected = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &section)
  if !sharedCallbackInspectMir(&store.*, &inspected, id, primitive, String.utf8Bytes(reader)) { return false }
  let selected = match move sharedCallbackCalleeApplication(&store.*, &inspected, reader) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !sharedCallbackTarget(SpecializationApplication.bodyDeclaration(&selected), id, String.utf8Bytes(reader)) { return false }
  let read = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &selected)
  return sharedCallbackReadMir(&store.*, &read, primitive)
}

fn sharedCallbackTarget(value: &DeclarationId, id: &ModuleId, name: &[u8]) -> bool {
  return DeclarationId.named(value, name) && ModuleId.equals(DeclarationId.moduleId(value), id)
}

fn sharedCallbackApplication(value: &SpecializationApplication, id: &ModuleId, name: &[u8], primitive: &[u8]) -> bool {
  if !sharedCallbackTarget(SpecializationApplication.bodyDeclaration(value), id, name) { return false }
  let supplied = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if supplied.length != ordinals.length { return false }
  let mut element = usize.ZERO
  let mut result = usize.ZERO
  let mut at = usize.ZERO
  while at < supplied.length {
    if ordinals[at] == usize.ZERO {
      if !genericSectionArgument(&supplied[at], b"i32") { return false }
      element = element + usize.ONE
    }
    if ordinals[at] == usize.ONE {
      if !genericSectionArgument(&supplied[at], primitive) { return false }
      result = result + usize.ONE
    }
    at = at + usize.ONE
  }
  return element == usize.ONE && result == usize.ONE
}

fn sharedCallbackCalleeApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string)
  -> Option<Shared<SpecializationApplication>> {
  let selected = providedCallee(store, answer, name)
  if let Option<InstanceKey>.Some {value} = move selected { return InstanceKey.application(&value) }
  return Option.none<Shared<SpecializationApplication>>()
}

fn sharedCallbackStorageMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId,
  primitive: &[u8], reader: &[u8]) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if !Shared.with<Type, bool>(&function.result, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut captured = false
      let mut local = usize.ZERO
      while local < locals.length {
        if let MirLocalKind.Parameter {index: parameter} = &locals[local].kind {
          if parameter == usize.ONE {
            captured = Shared.with<Type, bool>(&locals[local].ty, fn(value: &Type) -> bool {
              return sharedCallbackSection(value, id, primitive, reader)
            })
          }
        }
        local = local + usize.ONE
      }
      if !captured { return false }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut uses = usize.ZERO
      let mut policies = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, destination, normal, failure, ..} = &blocks[at].terminator {
          let application = InstanceKey.application(&key)
          if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
            let inspect = Shared.with<SpecializationApplication, bool>(&value, fn(call: &SpecializationApplication) -> bool {
              return sharedCallbackApplication(call, id, b"inspect", primitive)
            })
            let conflict = Shared.with<SpecializationApplication, bool>(&value, fn(call: &SpecializationApplication) -> bool {
              return sharedCallbackTarget(SpecializationApplication.bodyDeclaration(call), id, b"conflict")
            })
            let inputs = Vector.asSlice<MirOperand>(&arguments)
            if inspect {
              if inputs.length != 2 || destination.local >= locals.length { return false }
              if !Shared.with<Type, bool>(&locals[destination.local].ty, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
              if !sharedCallbackLoan(function, &inputs[usize.ZERO]) || !sharedCallbackCapture(function, &inputs[usize.ONE]) { return false }
              uses = uses + usize.ONE
            }
            if conflict {
              if inputs.length != usize.ZERO || destination.local >= locals.length || normal >= blocks.length { return false }
              if !Shared.with<Type, bool>(&locals[destination.local].ty, Type.isNever) { return false }
              if Vector.length<MirStatement>(&blocks[normal].statements) != usize.ZERO { return false }
              if !sharedCallbackUnreachable(&blocks[normal]) { return false }
              if let Option<MirFailureEdge>.Some {..} = &failure { return false }
              policies = policies + usize.ONE
            }
          }
        }
        at = at + usize.ONE
      }
      return uses == usize.ONE && policies == usize.ONE
    }
  }
  return false
}

fn sharedCallbackSection(value: &Type, id: &ModuleId, primitive: &[u8], reader: &[u8]) -> bool {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let slots = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if fields.length != usize.ONE || slots.length != usize.ONE { return false }
    if let CallableFieldInput.Argument {parameter} = &slots[usize.ZERO] {
      if parameter != usize.ONE { return false }
    } else { return false }
    let selected = Shared.with<SectionSchema, bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      return sharedCallbackSchemaSelected(recipe, id, primitive)
    })
    return selected && Shared.with<Type, bool>(&fields[usize.ZERO], fn(capture: &Type) -> bool {
      return sharedCallbackReader(capture, id, reader)
    })
  }
  return false
}

fn sharedCallbackUnreachable(value: &MirBlock) -> bool {
  return match &value.terminator { MirTerminator.Unreachable {..} => true _ => false }
}

fn sharedCallbackSchemaTarget(value: &SectionSchema, id: &ModuleId, name: &[u8]) -> bool {
  return Shared.with<DeclarationId, bool>(&value.target, fn(declaration: &DeclarationId) -> bool {
    return sharedCallbackTarget(declaration, id, name)
  })
}
fn sharedCallbackSchemaSelected(value: &SectionSchema, id: &ModuleId, primitive: &[u8]) -> bool {
  if !sharedCallbackSchemaTarget(value, id, b"inspect") { return false }
  let bindings = Vector.asSlice<Binding>(&value.selected)
  let mut element = usize.ZERO
  let mut result = usize.ZERO
  let mut at = usize.ZERO
  while at < bindings.length {
    let target = Shared.with<DeclarationId, bool>(&bindings[at].declaration, fn(declaration: &DeclarationId) -> bool {
      return sharedCallbackTarget(declaration, id, b"inspect")
    })
    if target && bindings[at].ordinal == usize.ZERO {
      if !genericSectionArgument(&bindings[at].value, b"i32") { return false }
      element = element + usize.ONE
    }
    if target && bindings[at].ordinal == usize.ONE {
      if !genericSectionArgument(&bindings[at].value, primitive) { return false }
      result = result + usize.ONE
    }
    at = at + usize.ONE
  }
  return element == usize.ONE && result == usize.ONE
}

fn sharedCallbackReader(value: &Type, id: &ModuleId, reader: &[u8]) -> bool {
  return match &value.* {
    Type.CallableSchema {schema, captures, fieldInputs, ..} => Vector.length<Shared<Type>>(&captures) == usize.ZERO
      && Vector.length<CallableFieldInput>(&fieldInputs) == usize.ZERO
      && Shared.with<SectionSchema, bool>(&schema, fn(recipe: &SectionSchema) -> bool {
        return sharedCallbackSchemaTarget(recipe, id, reader)
      })
    Type.CallableValue {application, captures, fieldInputs, ..} => Vector.length<Shared<Type>>(&captures) == usize.ZERO
      && Vector.length<CallableFieldInput>(&fieldInputs) == usize.ZERO
      && Shared.with<SpecializationApplication, bool>(&application, fn(call: &SpecializationApplication) -> bool {
        return sharedCallbackTarget(SpecializationApplication.bodyDeclaration(call), id, reader)
      })
    _ => false
  }
}

// A descriptor may be snapshotted before storage expansion. Only unprojected copies/moves
// retain the original parameter identity; a same-typed unrelated local cannot establish it.
fn sharedCallbackParameter(function: &MirFunction, start: usize, parameter: usize) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut local = start
  let mut steps = usize.ZERO
  while local < locals.length && steps < locals.length {
    if let MirLocalKind.Parameter {index} = &locals[local].kind { return index == parameter }
    let mut source = usize.MAX
    let mut assignments = usize.ZERO
    let mut at = usize.ZERO
    while at < blocks.length {
      let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
      let mut item = usize.ZERO
      while item < statements.length {
        if let MirStatement.Assign {destination, value: MirRvalue.Use {value}, ..} = &statements[item] {
          if destination.local == local && Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
            match &value {
              MirOperand.Copy {place} => { if Vector.length<MirProjection>(&place.projections) == usize.ZERO { source = place.local
                  assignments = assignments + usize.ONE } }
              MirOperand.Move {place} => { if Vector.length<MirProjection>(&place.projections) == usize.ZERO { source = place.local
                  assignments = assignments + usize.ONE } }
              _ => ()
            }
          }
        }
        item = item + usize.ONE
      }
      at = at + usize.ONE
    }
    if assignments != usize.ONE { return false }
    local = source
    steps = steps + usize.ONE
  }
  return false
}

fn sharedCallbackCapture(function: &MirFunction, value: &MirOperand) -> bool {
  return match &value.* {
    MirOperand.Copy {place} => sharedCallbackCapturePlace(function, &place)
    MirOperand.Move {place} => sharedCallbackCapturePlace(function, &place)
    _ => false
  }
}
fn sharedCallbackCapturePlace(function: &MirFunction, value: &MirPlace) -> bool {
  let projections = Vector.asSlice<MirProjection>(&value.projections)
  if projections.length != usize.ONE { return false }
  if let MirProjection.Field {index} = &projections[usize.ZERO] {
    return index == usize.ZERO && sharedCallbackParameter(function, value.local, usize.ONE)
  }
  return false
}
fn sharedCallbackLoan(function: &MirFunction, value: &MirOperand) -> bool {
  if let MirOperand.Copy {place} = &value.* {
    let locals = Vector.asSlice<MirLocal>(&function.locals)
    if place.local >= locals.length || Vector.length<MirProjection>(&place.projections) != usize.ZERO { return false }
    if !Shared.with<Type, bool>(&locals[place.local].ty, sharedCallbackMutableI32) { return false }
    let blocks = Vector.asSlice<MirBlock>(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
      let mut item = usize.ZERO
      while item < statements.length {
        if let MirStatement.Assign {destination, value: MirRvalue.Ref {access, place: source}, ..} = &statements[item] {
          if destination.local == place.local && access == Access.Mutable {
            let projections = Vector.asSlice<MirProjection>(&source.projections)
            if projections.length != 2 || !mirProjectionIsDeref(&projections[usize.ZERO]) { return false }
            if let MirProjection.Field {index} = &projections[usize.ONE] {
              return index == SealedCore.ordinal(SealedField.BlockValue) && sharedCallbackControlBlock(function, source.local)
            }
            return false
          }
        }
        item = item + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return false
}
fn sharedCallbackControlBlock(function: &MirFunction, local: usize) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut item = usize.ZERO
    while item < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[item] {
        if destination.local == local {
          let projections = Vector.asSlice<MirProjection>(&place.projections)
          if projections.length != 2 || !mirProjectionIsDeref(&projections[usize.ZERO]) { return false }
          if let MirProjection.Field {index} = &projections[usize.ONE] {
            return index == SealedCore.ordinal(SealedField.CoreBlock) && sharedCallbackParameter(function, place.local, usize.ZERO)
          }
          return false
        }
      }
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}
fn sharedCallbackI32(value: &Type) -> bool { return witnessPrimitive(value, b"i32") }
fn sharedCallbackMutableI32(value: &Type) -> bool {
  if let Type.Reference {referent, access, ..} = &value.* {
    return access == Access.Mutable && Shared.with<Type, bool>(&referent, sharedCallbackI32)
  }
  return false
}
fn sharedCallbackInspectMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId,
  primitive: &[u8], reader: &[u8]) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if !Shared.with<Type, bool>(&function.result, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut captured = false
      let mut lent = false
      let mut local = usize.ZERO
      while local < locals.length {
        if let MirLocalKind.Parameter {index: parameter} = &locals[local].kind {
          if parameter == usize.ZERO { lent = Shared.with<Type, bool>(&locals[local].ty, sharedCallbackMutableI32) }
          if parameter == usize.ONE {
            captured = Shared.with<Type, bool>(&locals[local].ty, fn(value: &Type) -> bool {
              return sharedCallbackReader(value, id, reader)
            })
          }
        }
        local = local + usize.ONE
      }
      if !lent || !captured { return false }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let target = Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool {
            return sharedCallbackTarget(value, id, reader)
          })
          if target {
            let inputs = Vector.asSlice<MirOperand>(&arguments)
            if inputs.length != usize.ONE { return false }
            return sharedCallbackReaderOperand(function, &inputs[usize.ZERO])
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}
fn sharedCallbackReaderOperand(function: &MirFunction, value: &MirOperand) -> bool {
  return match &value.* {
    MirOperand.Copy {place} => sharedCallbackReaderPlace(function, &place)
    MirOperand.Move {place} => sharedCallbackReaderPlace(function, &place)
    _ => false
  }
}

fn sharedCallbackReaderPlace(function: &MirFunction, value: &MirPlace) -> bool {
  if Vector.length<MirProjection>(&value.projections) != usize.ZERO { return false }
  if sharedCallbackParameter(function, value.local, usize.ZERO) { return true }
  // A shared reborrow may adapt the lent exclusive descriptor without changing its source.
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut item = usize.ZERO
    while item < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Ref {access, place}, ..} = &statements[item] {
        if destination.local == value.local && access == Access.Shared {
          let projections = Vector.asSlice<MirProjection>(&place.projections)
          return projections.length == usize.ONE && mirProjectionIsDeref(&projections[usize.ZERO])
            && sharedCallbackParameter(function, place.local, usize.ZERO)
        }
      }
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}
fn sharedCallbackReadMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if !Shared.with<Type, bool>(&function.result, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if let MirLocalKind.Parameter {index: parameter} = &locals[at].kind {
          if parameter == usize.ZERO { return Shared.with<Type, bool>(&locals[at].ty, sharedCallbackSharedI32) }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}
fn sharedCallbackSharedI32(value: &Type) -> bool {
  if let Type.Reference {referent, access, ..} = &value.* {
    return access == Access.Shared && Shared.with<Type, bool>(&referent, sharedCallbackI32)
  }
  return false
}

// A callable bound whose environment is omitted elides a declaration lifetime that each call
// infers from its argument, so a closure over caller locals satisfies the bound for that call.
test effect fn callableBoundsAdmitClosuresOverCallerLocals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run callableBoundClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableBoundClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("callable-bound-environment.silk")
  let text = """
fn apply<T, F: once fn(&mut T) -> () + Intrinsic.NonParking>(value: &mut T, use: F) -> () { return use(move value) }
fn applyBare<T, F: once fn(&mut T) -> ()>(value: &mut T, use: F) -> () { return use(move value) }
fn captured() -> i32 {
  let mut first = 1
  let mut completed = 0
  apply(&mut first, fn(entry: &mut i32) -> () {
      completed = entry.*
      return ()
    })
  return completed
}
fn bare() -> i32 {
  let mut first = 1
  let mut completed = 0
  applyBare(&mut first, fn(entry: &mut i32) -> () {
      completed = entry.*
      return ()
    })
  return completed
}
fn closed() -> i32 {
  let mut first = 1
  apply(&mut first, fn(entry: &mut i32) -> () { return () })
  return first
}
effect fn effectful() -> i32 {
  let mut first = 1
  let mut completed = 0
  apply(&mut first, fn(entry: &mut i32) -> () {
      completed = entry.*
      return ()
    })
  return completed
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let bare = run Semantic.demandBody(&mut store, &mut request, &id, b"bare")
  let closed = run Semantic.demandBody(&mut store, &mut request, &id, b"closed")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  run Testing.expect(succeeded(&captured) && succeeded(&bare),
    "a closure over caller locals satisfies an omitted bound environment, with or without a property bound")
  run Testing.expect(succeeded(&closed), "a closure that captures nothing satisfies the same bound")
  run Testing.expect(succeeded(&effectful), "an effect fn caller infers the environment the same way")
}

test effect fn neverAtExpectedValueBoundary() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run neverExpectedValueClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn neverExpectedValueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("never-expected-value.silk")
  let text = """
struct StopError {}
effect fn stop() -> never ! StopError { fail StopError {} }
effect fn work() -> i32 ! StopError { return run stop() }
effect fn wrong() -> i32 ! StopError { return true }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let work = run Semantic.demandBody(&mut store, &mut request, &id, b"work")
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&work, checkedBody)
  let mut retainedNever = false
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    retainedNever = Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(body)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form: BodyExpression.Run {..}} = &nodes[at].kind {
          return Shared.with<Type, bool>(&ty, Type.isNever)
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  run Testing.expect(retainedNever, "a diverging run satisfies expected i32 without changing its never type")
  let lowered = run Semantic.demandMir(&mut store, &mut request, &id, b"work")
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&lowered, selectedMirIndex)
  let mut unreachableReturn = false
  if let Option<usize>.Some {value: ordinal} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, ordinal) {
      unreachableReturn = neverCallContinuesUnreachable(function)
    }
  }
  run Testing.expect(unreachableReturn, "the normal continuation of a call producing never is unreachable and carries no result")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "true", usize.ZERO),
    "an ordinary incompatible result keeps TypeMismatch at the exact authored value")
}

// Whether the one call's normal continuation is an empty unreachable block.
fn neverCallContinuesUnreachable(function: &MirFunction) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut continuation = usize.MAX
  let mut at = usize.ZERO
  while at < blocks.length && continuation == usize.MAX {
    if let MirTerminator.Call {normal, ..} = &blocks[at].terminator { continuation = normal }
    at = at + usize.ONE
  }
  if continuation == usize.MAX || Vector.length<MirStatement>(&blocks[continuation].statements) != usize.ZERO { return false }
  return match &blocks[continuation].terminator { MirTerminator.Unreachable {..} => true _ => false }
}

test effect fn effectBlockChannelsAreDerivedAndChecked() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectBlockChannelClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn effectBlockChannelClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-block-channels.silk")
  let text = """
struct Missing { code: i32 }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
effect fn plain() -> i32 ! Missing {
  let pending = effect {
    let inner = fn() -> i32 { fail Missing { code: 1 } }
    return inner()
  }
  return run pending
}
fn leaks() -> i32 {
  let pending = effect { fail Missing { code: 2 } }
  return run pending
}
fn falls(flag: bool) -> i32 {
  let pending = effect { if flag { return 1 } }
  return run pending
}
fn narrower() -> Effect<u8 ! Missing> { return effect { return 1 } }
fn wrong() -> Effect<bool> { return effect { return 7 } }
fn undeclared() -> Effect<i32> { return effect { fail Missing { code: 3 } } }
effect fn owned(code: i32) -> i32 ! Missing {
  let token = Token { value: code }
  let pending = effect {
    if code > 0 { fail Missing { code: code } }
    let held = move token
    return held.value
  }
  return run pending
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let plain = run Semantic.demandBody(&mut store, &mut request, &id, b"plain")
  let leaks = run Semantic.demandBody(&mut store, &mut request, &id, b"leaks")
  let falls = run Semantic.demandBody(&mut store, &mut request, &id, b"falls")
  let closing = offsetOf(text, "{ if flag { return 1 } }", 0) + String.utf8Bytes("{ if flag { return 1 } }").length - usize.ONE
  run Testing.expect(rejectsSpan(&plain, RejectionCode.FailOutsideEffect, text, "fail Missing { code: 1 }", 0)
    && rejectsSpan(&leaks, RejectionCode.UnhandledFailure, text, "run pending", 1)
    && rejectsSpan(&falls, RejectionCode.MissingReturn, text, "}", countBefore(text, closing)),
    "a plain closure in a block has no failure channel, a derived failure must be handled, and a returning block cannot fall through")
  let narrower = run Semantic.demandBody(&mut store, &mut request, &id, b"narrower")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  let undeclared = run Semantic.demandBody(&mut store, &mut request, &id, b"undeclared")
  run Testing.expect(succeeded(&narrower)
    && rejectsSpan(&wrong, RejectionCode.TypeMismatch, text, "7", 0)
    && rejectsSpan(&undeclared, RejectionCode.UndeclaredFailure, text, "Missing { code: 3 }", 0),
    "a closed expected Effect supplies a block's channels: a converted block is stored behind it, a return outside its success is a mismatch at the value, and an undeclared failure is reported at its site")
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"owned")
  let runner = effectBlockApplication(&store, &owned)
  if let Option<Shared<SpecializationApplication>>.Some {value} = move runner {
    let application = run SpecializationApplication.copyShared(&value)
    let instance = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(failDrops(&store, &instance), "a block's failure exit drops the captured owner it has not moved")
  } else {
    run Testing.expect(false, "the owned block's run references its instance")
  }
}

// How many times `}` occurs before byte `end` in `text`.
fn countBefore(text: string, end: usize) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < end && at < bytes.length {
    if bytes[at] == 125 { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

// Whether some `Fail` exit drops a value before failing.
test effect fn effectJoinsRunOnlyTheSelectedAlternative() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectJoinRunClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn effectJoinRunClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-join-runs.silk")
  let text = """
struct Missing { code: i32 }
struct First {}
struct Second {}
fn choose(input: First | Second, base: i32) -> Effect<'static; i32> {
  return match move input {
    First {} => effect { return base + 1 }
    Second {} => effect { return 2 }
  }
}
fn chosen() -> i32 { return run choose(First {}, 1) }
effect fn one() -> i32 { return 1 }
fn returned(flag: bool) -> Effect<'static; i32 ! Missing> {
  if flag { return one() }
  return effect { fail Missing { code: 2 } }
}
effect fn ranReturned(flag: bool) -> i32 ! Missing { return run returned(flag) }
effect fn declared() -> i32 ! Missing {
  let pending: Effect<'static; i32 ! Missing> = effect { return 3 }
  return run pending
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let choose = run Semantic.demandMir(&mut store, &mut request, &id, b"choose")
  let chosen = run Semantic.demandMir(&mut store, &mut request, &id, b"chosen")
  run Testing.expect(injectCount(&store, &choose) == 2, "each arm stores its own Effect block under its tag in the join")
  run Testing.expect((run joinDispatch(&store, &chosen)) == 2,
    "running a returned join switches on its tag: each case calls a block on that tag's payload")
  let ran = run Semantic.demandMir(&mut store, &mut request, &id, b"ranReturned")
  run Testing.expect(switchCount(&store, &ran) == usize.ONE && edgedCalls(&store, &ran) == usize.ONE,
    "joined returns run under the declared failure: only the alternative that can fail has a failure edge")
  let declared = run Semantic.demandMir(&mut store, &mut request, &id, b"declared")
  run Testing.expect(effectBlockOperands(&store, &declared) == usize.ONE && switchCount(&store, &declared) == usize.ZERO,
    "a declared binding stores one exact Effect as itself and runs its block directly")
}

test effect fn effectJoinsCleanOnlyTheStoredAlternative() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectJoinCleanupClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn effectJoinCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-join-cleanup.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct First {}
struct Second {}
effect fn withToken(token: Token) -> i32 { return token.value }
fn owned(flag: bool) -> once Effect<'static; i32> {
  if flag { return withToken(Token { value: 1 }) }
  return effect { return 2 }
}
fn abandoned() -> i32 { drop owned(true) return 0 }
fn nested(flag: bool, input: First | Second) -> Effect<'static; i32> {
  if flag { return effect { return 1 } }
  return match move input { First {} => effect { return 2 } Second {} => effect { return 3 } }
}
fn mixed(input: First | Second) -> i32 {
  let picked = match move input { First {} => effect { return 1 } Second {} => 2 }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"owned")
  let abandoned = run Semantic.demandMir(&mut store, &mut request, &id, b"abandoned")
  run Testing.expect(succeeded(&abandoned) && glueFact(&store, &abandoned, 6) == usize.ONE,
    "an unrun join is dropped through its storage glue")
  if let Option<Shared<Type>>.Some {value} = move plainCallableMirResultType(&store, &owned) {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &value)
    run Testing.expect(succeeded(&glue) && switchCount(&store, &glue) == usize.ONE && glueFact(&store, &glue, 6) == usize.ONE,
      "join glue switches on the tag and drops only the alternative that owns cleanup")
  } else { run Testing.expect(false, "the owned producer returns its join storage") }
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let mixed = run Semantic.demandBody(&mut store, &mut request, &id, b"mixed")
  run Testing.expect(rejectsSpan(&nested, RejectionCode.NestedEffectJoinUnavailable, text,
      "match move input { First {} => effect { return 2 } Second {} => effect { return 3 } }", 0)
    && rejectsSpan(&mixed, RejectionCode.IncompatibleMatchResults, text, "match move input { First {} => effect { return 1 } Second {} => 2 }", 0),
    "re-injecting a returned join is the named nested-join gap, and an Effect cannot join a value")
}

test effect fn effectJoinsAdmitOnlyCoveredEffects() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectJoinAdmissionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn effectJoinAdmissionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-join-admission.silk")
  let text = """
struct Missing { code: i32 }
struct Token { value: i32 }
struct First {}
struct Second {}
service Clock { effect fn now() -> i32 ? &Clock }
effect fn failing() -> i32 ! Missing { fail Missing { code: 1 } }
effect fn needing() -> i32 ? &Clock { return run Clock.now() }
effect fn spending(token: Token) -> i32 { return token.value }
effect fn reading(value: &i32) -> i32 { return value.* }
fn failure() -> Effect<'static; i32> { return failing() }
fn requirement() -> Effect<'static; i32> { return needing() }
fn access(token: Token) -> Effect<'static; i32> { return spending(move token) }
fn environment(value: &i32) -> Effect<'static; i32> { return reading(value) }
fn bound() -> i32 {
  let pending: Effect<'static; i32> = failing()
  return 0
}
fn shared(flag: bool) -> Effect<'static; i32> { if flag { return effect { return 1 } } return effect { return 2 } }
fn give(flag: bool) -> Effect<'static; i32> {
  let first = shared(flag)
  return first
}
fn giveJoin(input: First | Second) -> Effect<'static; i32> {
  let picked = match move input { First {} => effect { return 1 } Second {} => effect { return 2 } }
  return picked
}
fn guarded(input: First | Second) -> i32 {
  return match &input { First {} if match 1 { _ => { return 3 } } => 1 _ => 0 }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let failure = run Semantic.demandBody(&mut store, &mut request, &id, b"failure")
  let requirement = run Semantic.demandBody(&mut store, &mut request, &id, b"requirement")
  let access = run Semantic.demandBody(&mut store, &mut request, &id, b"access")
  let environment = run Semantic.demandBody(&mut store, &mut request, &id, b"environment")
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
  run Testing.expect(rejectsSpan(&failure, RejectionCode.ReturnTypeMismatch, text, "failing()", usize.ONE),
    "a returned Effect whose failure the declared result does not cover is a return mismatch")
  run Testing.expect(rejectsSpan(&requirement, RejectionCode.ReturnTypeMismatch, text, "needing()", usize.ONE),
    "a returned Effect needing a requirement the declared result lacks is a return mismatch")
  run Testing.expect(rejectsSpan(&access, RejectionCode.ReturnTypeMismatch, text, "spending(move token)", usize.ZERO),
    "a once Effect does not satisfy a shared declared result")
  run Testing.expect(rejectsSpan(&environment, RejectionCode.ReturnTypeMismatch, text, "reading(value)", usize.ZERO),
    "a returned Effect borrowing a parameter does not outlive a 'static declared result")
  run Testing.expect(rejectsSpan(&bound, RejectionCode.TypeMismatch, text, "failing()", 2),
    "a declared binding does not admit an Effect whose failure it does not cover")
  let give = run Semantic.demandBody(&mut store, &mut request, &id, b"give")
  let giveJoin = run Semantic.demandBody(&mut store, &mut request, &id, b"giveJoin")
  run Testing.expect(rejectsSpan(&give, RejectionCode.ExplicitMoveRequired, text, "first", usize.ONE) && succeeded(&giveJoin),
    "a producer's Effect family is affine, while a join of Copy alternatives is Copy")
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guarded")
  run Testing.expect(succeeded(&guarded), "a match guard that always returns is `never` and accepted")
}

// The cases of the function's tag switch when each one calls an Effect literal on the payload its
// own tag selects; `usize.MAX` when any case does not.
effect fn joinDispatch(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases, ..} = &blocks[at].terminator {
          let listed = Vector.asSlice<MirSwitchCase>(&cases)
          let mut item = usize.ZERO
          while item < listed.length {
            let arm = &blocks[listed[item].target]
            let mut tag = usize.ZERO
            let mut found = false
            while tag < listed.length && !found {
              let decimal = run Type.extentText(tag)
              found = sameBytes(Bytes.asSlice(&listed[item].decimal), Bytes.asSlice(&decimal))
              if !found { tag = tag + usize.ONE }
            }
            if !blockReadsPayload(arm, tag) { return usize.MAX }
            if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &arm.terminator {
              if !effectBlockKey(&key) { return usize.MAX }
            } else { return usize.MAX }
            item = item + usize.ONE
          }
          return listed.length
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.ZERO
}

// Whether a block's statements or call arguments address the payload of union tag `tag`.
fn blockReadsPayload(block: &MirBlock, tag: usize) -> bool {
  if let MirTerminator.Call {arguments, ..} = &block.terminator {
    let operands = Vector.asSlice<MirOperand>(&arguments)
    let mut at = usize.ZERO
    while at < operands.length {
      if let MirOperand.Move {place} = &operands[at] { if placeSelects(&place, tag) { return true } }
      if let MirOperand.Copy {place} = &operands[at] { if placeSelects(&place, tag) { return true } }
      at = at + usize.ONE
    }
  }
  let statements = Vector.asSlice<MirStatement>(&block.statements)
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {value: MirRvalue.Ref {place, ..}, ..} = &statements[at] {
      if placeSelects(&place, tag) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn placeSelects(place: &MirPlace, tag: usize) -> bool {
  let projections = Vector.asSlice<MirProjection>(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    if let MirProjection.Payload {index, ..} = &projections[at] { if index == tag { return true } }
    at = at + usize.ONE
  }
  return false
}

// The calls whose callee can fail, each with its failure edge.
fn edgedCalls(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {failure, ..} = &blocks[at].terminator {
          if let Option<MirFailureEdge>.Some {..} = &failure { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

// The calls to Effect literal instances.
fn effectBlockCalls(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
          if effectBlockKey(&key) { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

// The union injections a function's MIR performs.
fn injectCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Inject {..}, ..} = &statements[position] { count = count + usize.ONE }
          position = position + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

fn failDrops(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Fail {..} = &blocks[at].terminator {
          let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
          let mut position = usize.ZERO
          while position < statements.length {
            if let MirStatement.Drop {..} = &statements[position] { return true }
            position = position + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// The operand count of the first call to an Effect literal's instance, `usize.MAX` without one.
fn effectBlockOperands(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          if effectBlockKey(&key) { return Vector.length<MirOperand>(&arguments) }
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

fn effectBlockKey(key: &InstanceKey) -> bool {
  let identity = InstanceKey.identity(key)
  return Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool {
    return DeclarationId.kind(value) == OwnerKind.EffectBlock
  })
}

fn effectBlockApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<SpecializationApplication>> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        if effectBlockKey(&references[at].key) { return InstanceKey.application(&references[at].key) }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}

test effect fn genericNamedSectionsInferEachInvocationIndependently() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn select<T>(value: T, enabled: bool) -> T { return move value }
fn main() -> i32 {
  let next = select(true)
  let first = next(41)
  if next(true) { return first + 1 }
  return 0
}
"""
  return run genericNamedSectionClaims(text, b"select", usize.MAX, usize.ZERO, b"bool")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn genericNamedSectionsPreserveSparseSelectedOrdinals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn choose<A, B>(value: B, stored: A) -> B { drop stored return move value }
fn main() -> i32 {
  let next = choose(3)
  let first = next(41)
  if next(true) { return first + 1 }
  return 0
}
"""
  return run genericNamedSectionClaims(text, b"choose", usize.ZERO, usize.ONE, b"i32")
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionClaims(text: string<'static>, target: &[u8], selected: usize,
  deferred: usize, capture: &[u8]) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("generic-named-section.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&answer) && genericSectionTargets(&store, &answer, target, selected, deferred),
    "one immutable section directly selects both i32 and bool target instances with its stored suffix appended")
  let environment = genericSectionEnvironment(&store, &answer)
  if let Option<Shared<Type>>.Some {value: ty} = move environment {
    let copied = run Shared.make<Type>(run Type.copy(&ty))
    let copiedIdentity = run Type.equalsShared(&ty, &copied)
    run Testing.expect(!Type.hasOpenRuntimeParameters(&ty) && copiedIdentity
      && Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return genericSectionBlueprint(value, selected, deferred, capture) }),
      "deferred target variables remain bound metadata while selected caller evidence and capture storage retain their original ordinals")
    let layout = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layout, selectedLayoutIndex)
    if let Option<usize>.Some {value: at} = move index {
      if let Option<Shared<BackendLayout>>.Some {value: record} = move Semantic.layoutAt(&store, at) {
        run Testing.expect(Shared.with<BackendLayout, bool>(&record, fn(value: &BackendLayout) -> bool {
          return genericSectionRecord(value, capture)
        }), "generic section layout stores only its supplied capture, with no deferred argument, code pointer or adapter")
        return ()
      }
    }
  }
  run Testing.expect(false, "the exact generic section environment has a capture-only record layout")
}

fn genericSectionEnvironment(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if Shared.with<Type, bool>(&locals[at].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableSchema {..} => true _ => false }
        }) { return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[at].ty)) }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<Type>>()
}

fn genericSectionBlueprint(value: &Type, selected: usize, deferred: usize, capture: &[u8]) -> bool {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    if fields.length != usize.ONE || Vector.length<CallableFieldInput>(&fieldInputs) != usize.ONE
      || !Shared.with<Type, bool>(&fields[usize.ZERO], fn(ty: &Type) -> bool { return witnessPrimitive(ty, capture) }) { return false }
    return Shared.with<SectionSchema, bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      let deferredSlots = Vector.asSlice<usize>(&recipe.deferred)
      let evidence = Vector.asSlice<Binding>(&recipe.selected)
      if deferredSlots.length != usize.ONE || deferredSlots[usize.ZERO] != deferred { return false }
      if selected == usize.MAX { return evidence.length == usize.ZERO }
      return evidence.length == usize.ONE && evidence[usize.ZERO].ordinal == selected
        && genericSectionArgument(&evidence[usize.ZERO].value, b"i32")
    })
  }
  return false
}

fn genericSectionRecord(value: &BackendLayout, capture: &[u8]) -> bool {
  if let LayoutStorage.Record {fields} = &value.storage {
    let stored = Vector.asSlice<LayoutField>(&fields)
    return stored.length == usize.ONE && stored[usize.ZERO].offset == usize.ZERO
      && Shared.with<Type, bool>(&stored[usize.ZERO].ty, fn(ty: &Type) -> bool { return witnessPrimitive(ty, capture) })
  }
  return false
}

fn genericSectionArgument(value: &Argument, name: &[u8]) -> bool {
  return match &value.* {
    Argument.Type {value: ty} => Shared.with<Type, bool>(&ty, fn(actual: &Type) -> bool { return witnessPrimitive(actual, name) })
    _ => false
  }
}

fn genericSectionApplication(value: &SpecializationApplication, target: &[u8], selected: usize, deferred: usize) -> usize {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), target) { return usize.ZERO }
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != deferred + usize.ONE || ordinals.length != arguments.length { return usize.ZERO }
  let mut at = usize.ZERO
  while at < ordinals.length {
    if ordinals[at] != at { return usize.ZERO }
    at = at + usize.ONE
  }
  if selected != usize.MAX && !genericSectionArgument(&arguments[selected], b"i32") { return usize.ZERO }
  if genericSectionArgument(&arguments[deferred], b"i32") { return usize.ONE }
  if genericSectionArgument(&arguments[deferred], b"bool") { return 2 }
  return usize.ZERO
}

fn genericSectionTargets(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], selected: usize, deferred: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move found {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut integer = false
      let mut boolean = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value
            _ => { return false }
          }
          let kind = Shared.with<SpecializationApplication, usize>(&application,
            fn(value: &SpecializationApplication) -> usize { return genericSectionApplication(value, target, selected, deferred) })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if kind == usize.ZERO || operands.length != 2 || !sectionStoredField(&operands[usize.ONE], usize.ZERO) { return false }
          if kind == usize.ONE { integer = true }
          if kind == 2 { boolean = true }
        }
        at = at + usize.ONE
      }
      return integer && boolean
    }
  }
  return false
}

test effect fn genericNamedSectionsCheckInferenceAndBoundsAtTheirSites() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run genericNamedSectionDiagnosticClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionDiagnosticClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("generic-section-diagnostics.silk")
  let text = """
interface Permit {}
impl Permit for i32 {}
fn choose<T: Permit>(value: T, enabled: bool) -> T { return move value }
fn fixed<A: Permit, B>(value: B, stored: A) -> B { drop stored return move value }
fn unused<T>(value: i32, enabled: bool) -> i32 { return value }
fn manufacture<T>(value: i32, enabled: bool) -> T { return manufacture<T>(value, enabled) }
fn badDeferred() -> bool {
  let deferredCheck = choose(true)
  let successful = deferredCheck(1)
  return deferredCheck(true)
}
fn badFixed() -> () { let fixedCheck = fixed(true) }
fn badUnused() -> () { let unusedCheck = unused(true) }
fn badResult() -> () { let resultCheck = manufacture(true) }
fn quantifiedStage(callback: for<'a, 'b: 'a> fn<'static>(&'a i32, &'b i32, i32) -> i32) -> () {
  let quantifiedStep = callback(1)
}
fn good() -> i32 { let next = choose(true) return next(42) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let deferred = run Semantic.demandBody(&mut store, &mut request, &id, b"badDeferred")
  let fixed = run Semantic.demandBody(&mut store, &mut request, &id, b"badFixed")
  let unused = run Semantic.demandBody(&mut store, &mut request, &id, b"badUnused")
  let result = run Semantic.demandBody(&mut store, &mut request, &id, b"badResult")
  let quantified = run Semantic.demandBody(&mut store, &mut request, &id, b"quantifiedStage")
  let good = run Semantic.demandMir(&mut store, &mut request, &id, b"good")
  run Testing.expect(rejectsSpan(&deferred, RejectionCode.MissingConformance, text, "deferredCheck(true)", usize.ZERO)
    && rejectsSpan(&fixed, RejectionCode.MissingConformance, text, "fixed(true)", usize.ZERO),
    "a deferred bound is checked after each use while construction-fixed bounds are checked at construction")
  run Testing.expect(rejectsSpan(&unused, RejectionCode.UninferredParameter, text, "unused(true)", usize.ZERO)
    && rejectsSpan(&result, RejectionCode.UninferredParameter, text, "manufacture(true)", usize.ZERO),
    "unused and result-only binders retain SEM0052 at the complete section construction")
  run Testing.expect(succeeded(&good), "failed section inference and bound queries cannot poison a later supported application")
  run Testing.expect(rejectsSpan(&quantified, RejectionCode.Unsupported, text, "callback(1)", usize.ZERO),
    "deferred quantified staging retains its named typed-form gap before unresolved invocation bounds are proved")
}

// Exact key admission must not collapse selected lifetime evidence before recipe planning.
// This actor claim needs no parser/body/build demand and keeps runtime erasure independently true.
test effect fn genericNamedSectionExactIdentityRetainsSelectedAndContractLifetimes() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run genericNamedSectionLifetimeIdentityClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionLifetimeIdentityClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("schema-lifetime-identity.silk")
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"choose")), occurrence: usize.ZERO})
  let owner = DeclarationId.fromParts(move id, move owners)
  let lasting = run Shared.make<Lifetime>(Lifetime.Static)
  let local = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&owner), ordinal: usize.ZERO})
  let first = run genericSectionLifetimeType(&owner, &lasting, &lasting)
  let repeated = run genericSectionLifetimeType(&owner, &lasting, &lasting)
  let selectedLocal = run genericSectionLifetimeType(&owner, &local, &lasting)
  let contractLocal = run genericSectionLifetimeType(&owner, &lasting, &local)
  let copied = run Shared.make<Type>(run Type.copy(&first))
  let repeatEqual = run Type.equalsShared(&first, &repeated)
  let copyEqual = run Type.equalsShared(&first, &copied)
  let selectedEqual = run Type.equalsShared(&first, &selectedLocal)
  let contractEqual = run Type.equalsShared(&first, &contractLocal)
  let selectedRuntime = run Type.runtimeEqualsShared(&first, &selectedLocal)
  let contractRuntime = run Type.runtimeEqualsShared(&first, &contractLocal)
  run Testing.expect(repeatEqual && copyEqual && !selectedEqual && !contractEqual && selectedRuntime && contractRuntime,
    "exact schema identity retains selected lifetimes and free contract validity, while runtime identity erases both and copies remain equal")
  let alphaLeft = run genericSectionCallerAlphaContract(&owner, false)
  let alphaRight = run genericSectionCallerAlphaContract(&owner, true)
  let alphaEqual = run Type.alphaEquivalent(&alphaLeft, &first, &alphaRight, &repeated, 2)
  run Testing.expect(alphaEqual,
    "a caller's swapped impl binder map cannot rename the section blueprint's bound target parameter")
  let mut firstArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut firstArguments, Argument.Type {value: Shared.clone<Type>(&first)})
  let firstKey = run InstanceKey.function(run specializationWithArguments(&owner, move firstArguments))
  let mut secondArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut secondArguments, Argument.Type {value: move selectedLocal})
  let secondKey = run InstanceKey.function(run specializationWithArguments(&owner, move secondArguments))
  let exactEqual = run InstanceKey.sameApplication(&firstKey, &secondKey)
  run Testing.expect(!exactEqual && InstanceKey.sameRuntimeBase(&firstKey, &secondKey),
    "runtime-equal schema arguments remain distinct proof-bearing backend query keys")
  return ()
}

effect fn genericSectionCallerAlphaContract(owner: &DeclarationId, reversed: bool) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let mut first = usize.ZERO
  let mut second = usize.ONE
  if reversed { first = usize.ONE second = usize.ZERO }
  let mut parameters = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut parameters, run specializationParameter(owner, first))
  run Vector.append<Shared<Type>>(&mut parameters, run specializationParameter(owner, second))
  let regions = Vector.make<Shared<Lifetime>>()
  return run Shared.make<Type>(Type.Callable {mode: CallableMode.Once, isUnsafe: false,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))), invocationBinders: usize.ZERO,
    invocationBounds: Vector.make<Outlives>(), parameters: move parameters, result: run Shared.make<Type>(Type.Unit)})
}

effect fn genericSectionLifetimeType(owner: &DeclarationId, selectedLifetime: &Shared<Lifetime>, contractLifetime: &Shared<Lifetime>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let bound = run specializationParameter(owner, usize.ONE)
  let mut parameters = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut parameters, Shared.clone<Type>(&bound))
  let mut regions = Vector.make<Shared<Lifetime>>()
  run Vector.append<Shared<Lifetime>>(&mut regions, Shared.clone<Lifetime>(contractLifetime))
  let contract = run Shared.make<Type>(Type.Callable {mode: CallableMode.Once, isUnsafe: false,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))), invocationBinders: usize.ZERO,
    invocationBounds: Vector.make<Outlives>(), parameters: move parameters, result: move bound})
  let mut selected = Vector.make<Binding>()
  run Vector.append<Binding>(&mut selected, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(owner)),
    ordinal: usize.ZERO, value: Argument.Lifetime {value: Shared.clone<Lifetime>(selectedLifetime)}})
  let mut deferred = Vector.make<usize>()
  run Vector.append<usize>(&mut deferred, usize.ONE)
  let schema = run Shared.make<SectionSchema>(SectionSchema {target: run Shared.make<DeclarationId>(run DeclarationId.copy(owner)),
    contract: move contract, selected: move selected, deferred: move deferred})
  return run Type.callableSchema(move schema, Vector.make<Shared<Type>>(), Vector.make<CallableFieldInput>())
}

// This is a type-substitution claim: no parser, source body, backend demand or runtime oracle is
// needed to distinguish a bound target variable from a free caller variable with the same owner.
test effect fn genericNamedSectionSubstitutionKeepsBoundAndFreeOwnersSeparate() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run genericNamedSectionOwnerClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionOwnerClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("recursive-schema-owner.silk")
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"choose")), occurrence: usize.ZERO})
  let owner = DeclarationId.fromParts(move id, move owners)
  let bound = run specializationParameter(&owner, usize.ZERO)
  let free = run specializationParameter(&owner, usize.ONE)
  let mut parameters = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut parameters, Shared.clone<Type>(&bound))
  let regions = Vector.make<Shared<Lifetime>>()
  let contract = run Shared.make<Type>(Type.Callable {mode: CallableMode.Once, isUnsafe: false,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))), invocationBinders: usize.ZERO,
    invocationBounds: Vector.make<Outlives>(), parameters: move parameters, result: move bound})
  let mut selected = Vector.make<Binding>()
  run Vector.append<Binding>(&mut selected, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: usize.ONE, value: Argument.Type {value: Shared.clone<Type>(&free)}})
  let mut deferred = Vector.make<usize>()
  run Vector.append<usize>(&mut deferred, usize.ZERO)
  let schema = run Shared.make<SectionSchema>(SectionSchema {target: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    contract: move contract, selected: move selected, deferred: move deferred})
  let mut captures = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut captures, move free)
  let mut inputs = Vector.make<CallableFieldInput>()
  run Vector.append<CallableFieldInput>(&mut inputs, CallableFieldInput.Argument {parameter: usize.ONE})
  let original = run Type.callableSchema(move schema, move captures, move inputs)
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(&original, &owner, &mut types, &mut lifetimes, &mut rows)
  let listed = Vector.asSlice<usize>(&types)
  run Testing.expect(listed.length == usize.ONE && listed[usize.ZERO] == usize.ONE,
    "free-variable traversal sees caller B while target A is bound by the section blueprint")
  let mut bindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut bindings, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: usize.ZERO, value: Argument.Type {value: run specializationPrimitive(b"i32")}})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: usize.ONE, value: Argument.Type {value: run specializationPrimitive(b"bool")}})
  let closed = run Type.applyBindings(&original, Vector.asSlice<Binding>(&bindings), true)
  let metadata = Shared.with<Type, Option<Shared<SectionSchema>>>(&closed, fn(value: &Type) -> Option<Shared<SectionSchema>> {
    return match &value.* { Type.CallableSchema {schema: recipe, ..} => Option.some<Shared<SectionSchema>>(Shared.clone<SectionSchema>(&recipe)) _ => Option.none<Shared<SectionSchema>>() }
  })
  if let Option<Shared<SectionSchema>>.Some {value} = move metadata {
    let correct = Shared.with<SectionSchema, bool>(&value, fn(recipe: &SectionSchema) -> bool {
      return genericSectionOwnerMetadata(recipe, &owner)
    })
    run Testing.expect(correct && !Type.hasOpenRuntimeParameters(&closed),
      "owner monomorphization closes free evidence and storage without substituting the section's bound parameter or result")
    return ()
  }
  run Testing.expect(false, "owner substitution retains immutable generic section metadata")
}


fn genericSectionOwnerMetadata(recipe: &SectionSchema, owner: &DeclarationId) -> bool {
  let evidence = Vector.asSlice<Binding>(&recipe.selected)
  return evidence.length == usize.ONE && evidence[usize.ZERO].ordinal == usize.ONE
    && genericSectionArgument(&evidence[usize.ZERO].value, b"bool")
    && Shared.with<Type, bool>(&recipe.contract, fn(contract: &Type) -> bool {
      return genericSectionBoundContract(contract, owner)
    })
}

fn genericSectionBoundContract(contract: &Type, owner: &DeclarationId) -> bool {
  if let Type.Callable {parameters, result, ..} = &contract.* {
    let inputs = Vector.asSlice<Shared<Type>>(&parameters)
    if inputs.length != usize.ONE { return false }
    let parameter = Shared.with<Type, usize>(&inputs[usize.ZERO], fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, owner)
    })
    let resultOrdinal = Shared.with<Type, usize>(&result, fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, owner)
    })
    return parameter == usize.ZERO && resultOrdinal == usize.ZERO
  }
  return false
}

