effect fn inherentClaims(part: usize) -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let owners = run module("owners.silk")
  let external = run module("external.silk")
  let text = "import external { Foreign }\nstruct Counter {\n  count: i32\n}\nstruct Pair<A, B> {}\ntype Alias = Counter\nenum Status { Ready }\nimpl Counter {\n  fn value(counter: &Self) -> i32 { return 0 }\n  fn count(counter: &Self) -> i32 { return 0 }\n}\nimpl Counter {\n  fn value(other: &Self) -> i32 { return 1 }\n  fn reset() -> Self { return () }\n  measure: Counter.reset\n  fn drop(counter: &mut Self) -> () { return () }\n}\nimpl<A, B> Pair<A, B> {\n  fn first<A: Copy>(pair: &Self, value: A) -> A { return move value }\n  fn left(value: A) -> A { return move value }\n  fn plain() -> i32 { return 0 }\n}\nimpl Pair<i32, bool> {\n  fn special() -> i32 { return 0 }\n}\nimpl<A, B> Pair<B, A> {\n  fn swapped() -> i32 { return 0 }\n}\nimpl<A: Copy, B> Pair<A, B> {\n  fn bounded() -> Self { return () }\n}\nimpl Alias {\n  fn aliased() -> i32 { return 0 }\n}\nimpl Foreign {\n  fn mine() -> i32 { return 0 }\n}\nimpl Status {\n  fn value() -> i32 { return 0 }\n}\nstruct Twice {}\nimpl Twice {\n  fn same() -> i32 { return 0 }\n  fn same() -> bool { return true }\n}\nstruct Rowed<?R> {}\nimpl<?R> Rowed<? R> {\n  fn rowed() -> i32 { return 0 }\n  fn clash<R>() -> i32 { return 0 }\n}\nstruct Held<'a> {\n  value: &'a i32\n}\nimpl<'a> Held<'a> {\n  effect<'a> fn retained() -> i32 { return 0 }\n}\nimpl Copy for Status {}\nservice Clock {}\nrole Primary\nstruct Routed<?H> {}\nimpl<?H> Routed<H> {\n  fn routed() -> i32 { return 0 }\n}\nfn served(value: Routed<&Clock at Primary>) -> i32 { return 0 }\nfn mismatched(value: Routed<i32>) -> i32 { return 0 }\nfn extra(value: Routed<&Clock ? &Clock>) -> i32 { return 0 }\nstatic if true {\n  fn conditional<T>(value: T) -> T { return move value }\n}\n"
  let ownersSource = run present(text)
  let externalSource = run present("pub struct Foreign {}\n")
  let first = run Revision.publish(&Revision.make(), &owners, &ownersSource)
  let revision = run Revision.publish(&first, &external, &externalSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut request = Request.make()
  if part == 0 {
    let counter = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Counter")
    let counterPublished = Shared.with<Result<Answer, NoRejection>, usize>(
      &counter,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, true)
      },
    )
    let counterRejected = Shared.with<Result<Answer, NoRejection>, usize>(
      &counter,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, false)
      },
    )
    run Testing.expect(
      counterPublished == usize.ONE && counterRejected == 5,
      "duplicates, field collisions, mappings and Drop hooks publish nothing and choose no winner",
    )
    let pair = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Pair")
    let status = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Status")
    let pairPublished = Shared.with<Result<Answer, NoRejection>, usize>(
      &pair,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, true)
      },
    )
    let statusRejected = Shared.with<Result<Answer, NoRejection>, usize>(
      &status,
      fn(answer: &Result<Answer, NoRejection>) -> usize {
        return inherentCount(answer, false)
      },
    )
    run Testing.expect(
      pairPublished == 3 && statusRejected == usize.ONE,
      "rejected heads publish no member and a generated enum operation keeps its name",
    )
    let special = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"special", 0)
    let swapped = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"swapped", 0)
    let bounded = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"bounded", 0)
    let aliased = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"aliased", 0)
    let foreign = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"mine", 0)
    let specialAt = rejectsFrom(&special, RejectionCode.InvalidInherentHead, offsetOf(text, "Pair<i32", 0))
    let swappedAt = rejectsFrom(&swapped, RejectionCode.InvalidInherentHead, offsetOf(text, "Pair<B, A>", 0))
    let boundedAt = rejectsFrom(
      &bounded,
      RejectionCode.InvalidInherentHead,
      offsetOf(text, "Pair<A, B> {\n  fn bounded", 0),
    )
    let aliasedAt = rejectsFrom(&aliased, RejectionCode.InvalidInherentHead, offsetOf(text, "Alias {", 0))
    let foreignAt = rejectsFrom(&foreign, RejectionCode.InvalidInherentHead, offsetOf(text, "Foreign {", 0))
    run Testing.expect(
      specialAt && swappedAt && boundedAt && aliasedAt && foreignAt,
      "specialized, reordered, bounded, alias and foreign inherent heads report only the head",
    )
  }
  if part == 1 {
    let refined = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"first", 0)
    // `first` names `Self`, so its contract lists both owner binders and adds no binder of its own.
    let ownerPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&refined, ownBinderCount) == 2
    let refinedBound = Shared.with<Result<Answer, NoRejection>, bool>(&refined, copyBoundOnly)
    run Testing.expect(
      ownerPrefix && refinedBound,
      "an inherent member restating an owner binder bounds the owner's parameter for itself",
    )
    let left = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Pair", b"left")
    let plain = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Pair", b"plain")
    let leftPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&left, ownBinderCount) == usize.ONE
    let plainPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&plain, ownBinderCount) == usize.ZERO
    run Testing.expect(
      leftPrefix && plainPrefix,
      "a member's contract lists only the owner binders it mentions",
    )
    let duplicated = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"value")
    let claimed = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"count")
    let reset = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"reset")
    let absent = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"absent")
    let twice = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"same", 0)
    let twiceAgain = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"same", 1)
    let duplicatedAt = rejectsAt(&duplicated, RejectionCode.Collision)
    let claimedAt = rejectsAt(&claimed, RejectionCode.InvalidInherentMember)
    let resetView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&reset, inspect)
    let absentAt = rejectsAt(&absent, RejectionCode.UnknownMember)
    let twiceAt = rejectsFrom(&twice, RejectionCode.Collision, offsetOf(text, "fn same() -> bool", 0)) && rejectsFrom(
      &twiceAgain,
      RejectionCode.Collision,
      offsetOf(text, "fn same() -> bool", 0),
    )
    run Testing.expect(
      duplicatedAt && claimedAt && resetView.success && absentAt && twiceAt,
      "member lookups return the kept rejection for duplicates and claimed names and never a winner",
    )
    let signatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
    let leftById = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"left", 0)
    let valueAgain = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"value", 1)
    let sameLeft = run resultEquals(&left, &leftById)
    let noRestart = starts(Semantic.eventLog(&semantic), Family.Signature) == signatureStarts
    run Testing.expect(
      sameLeft && noRestart && rejectsAt(&valueAgain, RejectionCode.Collision),
      "an identity-addressed member shares the name lookup's answer, and each duplicate identity rejects",
    )
    let conditional = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"conditional", 0)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&conditional, signatureHasOrdinaryBinder),
      "a function in a static conditional sees no enclosing binders or `Self`",
    )
    let firstValue = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"value", 0)
    let firstCount = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"count", 0)
    let crossDuplicate = rejectsAt(&firstValue, RejectionCode.Collision)
    let fieldClaimed = rejectsAt(&firstCount, RejectionCode.InvalidInherentMember)
    run Testing.expect(
      crossDuplicate && fieldClaimed,
      "an impl-addressed inherent member obeys owner-wide uniqueness across impl blocks",
    )
  }
  if part == 2 {
    let rowed = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"rowed", 0)
    let clash = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"clash", 0)
    let retained = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Held", b"retained")
    let rowedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&rowed, inspect)
    let clashAt = rejectsFrom(&clash, RejectionCode.DuplicateTypeParameter, offsetOf(text, "clash<R>", 0) + 6)
    let environmentOwner = Shared.with<Result<Answer, NoRejection>, usize>(&retained, lifetimeCountOf) == usize.ONE
    run Testing.expect(
      rowedView.success && clashAt && environmentOwner,
      "row owner binders form a whole family, a restated binder of another kind rejects, and a written environment names owner lifetimes",
    )
    let sealedHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &owners)
    let sealedEnum = rejectsFrom(
      &sealedHeads,
      RejectionCode.InvalidCopyConformance,
      offsetOf(text, "impl Copy for Status", 0),
    )
    run Testing.expect(sealedEnum, "a scalar enum cannot request Copy by implementation")
    let routed = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"routed", 0)
    let suffixed = run signatureNamed(&mut semantic, &mut request, &mut index, &owners, b"rowed", 0)
    let served = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"served")
    let mismatched = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"mismatched")
    let routedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&routed, inspect)
    let suffixedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&suffixed, inspect)
    let servedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&served, inspect)
    let mismatchedKind = rejectsFrom(&mismatched, RejectionCode.TypeArgumentKind, offsetOf(text, "i32>) -> i32", 0))
    let extra = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"extra")
    let extraSuffix = rejectsAt(&extra, RejectionCode.TypeArity)
    run Testing.expect(
      routedView.success && suffixedView.success && servedView.success && mismatchedKind && extraSuffix,
      "a requirement row binder takes a positional or suffixed row argument, and a value type there is a kind error",
    )
  }
  return ()
}

test effect fn importBindingsPreludeAndDemandOrder() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bindingClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bindingClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("bindings.silk")
  let lib = run module("lib.silk")
  let other = run module("other.silk")
  let clashing = run module("clashing.silk")
  let entryText = "import lib { Item }\nimport lib { Item }\nimport lib as lib\nimport lib\nfn twice(value: Item) -> i32 { return 0 }\nfn qualified(value: lib.Item) -> i32 { return 0 }\nfn prelude(value: Option<i32>) -> i32 { return 0 }\neffect fn fails<E>() -> i32 ! E { return 0 }\nfn marked<!E>() -> i32 { return 0 }\n"
  let clashingText = "import lib { Item }\nimport other { Item }\nfn clash(value: Item) -> i32 { return 0 }\n"
  let entrySource = run present(entryText)
  let libSource = run present("pub struct Item {}\n")
  let otherSource = run present("pub struct Item {}\n")
  let clashingSource = run present(clashingText)
  let r1 = run Revision.publish(&Revision.make(), &lib, &libSource)
  let r2 = run Revision.publish(&r1, &other, &otherSource)
  let r3 = run Revision.publish(&r2, &clashing, &clashingSource)
  let revision = run Revision.publish(&r3, &entry, &entrySource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let twice = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"twice")
  let qualified = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"qualified")
  let clash = run Semantic.demandSignature(&mut semantic, &mut request, &clashing, b"clash")
  let twiceView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&twice, inspect)
  let qualifiedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&qualified, inspect)
  let sameItem = run answersEqual(&twice, &qualified, usize.ZERO)
  let stillClashes = rejectsAt(&clash, RejectionCode.Collision)
  run Testing.expect(
    twiceView.success && qualifiedView.success && sameItem && stillClashes,
    "a repeated identical import and a redundant alias are one binding; different imports still collide",
  )
  let prelude = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"prelude")
  let fails = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"fails")
  let marked = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"marked")
  let noPrelude = rejectsFrom(&prelude, RejectionCode.UnknownName, offsetOf(entryText, "Option<i32>", 0))
  let failsView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&fails, inspect)
  let markedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&marked, inspect)
  run Testing.expect(
    noPrelude && failsView.success && !markedView.success,
    "no library name is implicit, and an ordinary failure parameter needs no `!E` binder",
  )
  let mut reversed = makeSemantic(move revision)
  let mut reversedRequest = Request.make()
  let clashFirst = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &clashing, b"clash")
  let qualifiedFirst = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &entry, b"qualified")
  let twiceLast = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &entry, b"twice")
  let reversedClash = rejectsAt(&clashFirst, RejectionCode.Collision)
  let reversedSame = run answersEqual(&twiceLast, &qualifiedFirst, usize.ZERO)
  let reversedTwice = run answersEqual(&twiceLast, &twice, usize.ZERO)
  run Testing.expect(
    reversedClash && reversedSame && reversedTwice,
    "binding answers do not depend on demand order",
  )
  return ()
}

test effect fn requestApplicationImportKeepsSelectionsSeparate() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run applicationImportClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn applicationImportClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("application-client.silk")
  let idle = run module("application-idle.silk")
  let namespace = run module("application-namespace.silk")
  let coherence = run module("application-coherence.silk")
  let operations = run module("application-operations.silk")
  let first = run module("runtime-first.silk")
  let second = run module("runtime-second.silk")
  let private = run module("runtime-private.silk")
  let entryText = "import Intrinsic.application { Item }\nfn consume(value: Item) -> i32 { return 0 }\n"
  let entrySource = run present(entryText)
  let idleSource = run present(
    "import Intrinsic.application { Item }\nfn idle(value: i32) -> i32 { return value }\n",
  )
  let namespaceSource = run present(
    "import Intrinsic.application\nfn consume(value: application.Item) -> i32 { return 0 }\n",
  )
  let coherenceText = "import Intrinsic.application { Item }\ninterface Label {}\nimpl Label for Item {}\n"
  let coherenceSource = run present(coherenceText)
  let operationsText = "import Intrinsic.application { Item }\ninterface Label { fn select(value: Self) -> Item }\nstruct Local {}\nimpl Label for Local {}\n"
  let operationsSource = run present(operationsText)
  let firstSource = run present("pub struct Item {}\n")
  let secondSource = run present("pub struct Item {}\n")
  let privateSource = run present("struct Item {}\n")
  let r1 = run Revision.publish(&Revision.make(), &first, &firstSource)
  let r2 = run Revision.publish(&r1, &second, &secondSource)
  let r3 = run Revision.publish(&r2, &private, &privateSource)
  let r4 = run Revision.publish(&r3, &idle, &idleSource)
  let r5 = run Revision.publish(&r4, &namespace, &namespaceSource)
  let r6 = run Revision.publish(&r5, &coherence, &coherenceSource)
  let r7 = run Revision.publish(&r6, &entry, &entrySource)
  let revision = run Revision.publish(&r7, &operations, &operationsSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut firstRequest = Request.forApplication(run ModuleId.copy(&first))
  let mut secondRequest = Request.forApplication(run ModuleId.copy(&second))
  let mut absentRequest = Request.make()
  let firstUse = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &entry, b"consume")
  let namespaceUse = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &namespace, b"consume")
  let secondUse = run Semantic.demandSignature(&mut semantic, &mut secondRequest, &entry, b"consume")
  let absentUse = run Semantic.demandSignature(&mut semantic, &mut absentRequest, &entry, b"consume")
  let distinct = !run answersEqual(&firstUse, &secondUse, usize.ZERO)
  let sameNamespace = run answersEqual(&firstUse, &namespaceUse, usize.ZERO)
  let missing = rejectsFrom(
    &absentUse,
    RejectionCode.MissingModule,
    offsetOf(entryText, "Intrinsic.application", usize.ZERO),
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&firstUse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&secondUse, inspect).success && sameNamespace && distinct && missing,
    "namespace and selective imports choose the request application; other bindings and absence stay separate",
  )
  let implementation = run requireIdentity(&revision, &coherence, OwnerKind.Implementation, b"", usize.ZERO)
  let mut coherenceFirstRequest = Request.forApplication(run ModuleId.copy(&first))
  let mut coherencePrivateRequest = Request.forApplication(run ModuleId.copy(&private))
  let mut coherenceAbsentRequest = Request.make()
  let firstHead = run Semantic.demandCoherence(&mut semantic, &mut coherenceFirstRequest, &implementation)
  let privateHead = run Semantic.demandCoherence(&mut semantic, &mut coherencePrivateRequest, &implementation)
  let absentHead = run Semantic.demandCoherence(&mut semantic, &mut coherenceAbsentRequest, &implementation)
  run Testing.expect(
    succeeded(&firstHead) && rejectsAt(&privateHead, RejectionCode.PrivateMember) && rejectsFrom(
      &absentHead,
      RejectionCode.MissingModule,
      offsetOf(coherenceText, "Intrinsic.application", usize.ZERO),
    ) && Request.hasDiscovered(&coherenceFirstRequest, &first) && !Request.hasDiscovered(
      &coherenceAbsentRequest,
      &first,
    ),
    "coherence demands select each request application and do not inherit a prior binding or discovery",
  )
  let beforeHits = hits(Semantic.eventLog(&semantic), Family.Signature)
  let mut repeatRequest = Request.forApplication(run ModuleId.copy(&first))
  let firstAgain = run Semantic.demandSignature(&mut semantic, &mut repeatRequest, &entry, b"consume")
  let same = run answersEqual(&firstUse, &firstAgain, usize.ZERO)
  run Testing.expect(
    same && hits(Semantic.eventLog(&semantic), Family.Signature) > beforeHits,
    "an identical selected application reuses its completed signature",
  )
  let idleUse = run Semantic.demandSignature(&mut semantic, &mut absentRequest, &idle, b"idle")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&idleUse, inspect).success,
    "an unused application import does not demand a binding",
  )
  let mut privateRequest = Request.forApplication(run ModuleId.copy(&private))
  let privateUse = run Semantic.demandSignature(&mut semantic, &mut privateRequest, &entry, b"consume")
  run Testing.expect(
    rejectsAt(&privateUse, RejectionCode.PrivateMember),
    "selected application members obey ordinary import visibility",
  )
  let operation = run requireIdentity(&revision, &operations, OwnerKind.Function, b"select", usize.ZERO)
  let mut operationFirstRequest = Request.forApplication(run ModuleId.copy(&first))
  let heads = run Semantic.demandImplementations(&mut semantic, &mut operationFirstRequest, &operations)
  let head = headAt(&heads, usize.ZERO)
  let selectedContract = contractOf(&head)
  let selectedProvider = providerOf(&head)
  let mut switched = false
  if let Option<Shared<Type>>.Some {value: contract} = move selectedContract {
    if let Option<Shared<Type>>.Some {value: provider} = move selectedProvider {
      let firstApplied = run Semantic.demandAppliedOperation(
        &mut semantic, &mut operationFirstRequest, &contract, &provider, &operation,
      )
      let mut operationSecondRequest = Request.forApplication(run ModuleId.copy(&second))
      let secondApplied = run Semantic.demandAppliedOperation(
        &mut semantic, &mut operationSecondRequest, &contract, &provider, &operation,
      )
      let mut operationAbsentRequest = Request.make()
      let absentApplied = run Semantic.demandAppliedOperation(
        &mut semantic, &mut operationAbsentRequest, &contract, &provider, &operation,
      )
      let sameAppliedResult = run resultEquals(&firstApplied, &secondApplied)
      switched = succeeded(&firstApplied) && succeeded(&secondApplied) && !sameAppliedResult && rejectsFrom(
        &absentApplied,
        RejectionCode.MissingModule,
        offsetOf(operationsText, "Intrinsic.application", usize.ZERO),
      )
    }
  }
  run Testing.expect(switched, "applied operation selects each request application before resolving its signature")
  let removed = run present("pub struct Other {}\n")
  let changed = run Revision.publish(&revision, &first, &removed)
  Semantic.revise(&mut semantic, move changed)
  let mut changedRequest = Request.forApplication(run ModuleId.copy(&first))
  let missingItem = run Semantic.demandSignature(&mut semantic, &mut changedRequest, &entry, b"consume")
  run Testing.expect(
    rejectsAt(&missingItem, RejectionCode.UnknownMember),
    "a selected application edit invalidates its imported member",
  )
  return ()
}

// Whether a signature records the sealed `wanted` property on some parameter.
fn recordsProperty(answer: &Result<Answer, NoRejection>, wanted: IntrinsicProperty) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let declared = Vector.asSlice<Constraint>(&signature.constraints)
      let mut at = usize.ZERO
      while at < declared.length {
        if let Constraint.Property {property, ..} = &declared[at] {
          let matches = match property {
            IntrinsicProperty.Detached => match wanted {
              IntrinsicProperty.Detached => true
              IntrinsicProperty.NonParking => false
            }
            IntrinsicProperty.NonParking => match wanted {
              IntrinsicProperty.Detached => false
              IntrinsicProperty.NonParking => true
            }
          }
          if matches {
            return true
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn parameterOwnedBy(answer: &Result<Answer, NoRejection>, slot: usize, name: &[u8]) -> bool {
  if let Option<Shared<Type>>.Some {value} = move typeAt(answer, slot) {
    return Shared.with<Type, bool>(
      &value,
      fn(found: &Type) -> bool {
        return match & found.* {
          Type.Parameter {declaration, ..} => DeclarationId.named(&declaration, name)
          _ => false
        }
      },
    )
  }
  return false
}

// The `occurrence`th identity of `kind` named `name` (any name when empty), or a failed expectation.
effect fn requireIdentity(
  revision: &Revision,
  module: &ModuleId,
  kind: OwnerKind,
  name: &[u8],
  occurrence: usize,
) -> DeclarationId ! Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let found = run identityOf(revision, module, kind, name, occurrence)
  if let Option<DeclarationId>.Some {value} = move found {
    return move value
  }
  run Testing.expect(false, "the fixture declares the addressed declaration")
  // Unreachable: the failed expectation has already ended the test.
  return run requireIdentity(revision, module, kind, name, occurrence)
}

test effect fn operationSignaturesUnderImplementations() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run operationUnderClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn operationUnderClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let contracts = run module("contracts.silk")
  let model = run module("model.silk")
  let witness = run module("witness.silk")
  let contractsText = "pub interface Convert<T> {\n  fn convert<U>(value: Self, other: U) -> T\n}\npub interface Hold<'a> {\n  fn hold(value: &Self) -> &'a i32\n}\npub service Clock {}\npub interface Needs<?R> {\n  fn pending(value: &Self) -> Effect<'static; i32 ? R>\n}\npub interface Other {\n  fn other(value: &Self) -> i32\n}\nstruct Hidden {}\npub interface Leaks {\n  fn leak(value: &Self) -> Hidden\n}\ninterface Quiet {\n  fn quiet(value: &Self) -> Hidden\n}\n"
  let modelText = "import contracts { Convert, Hold, Needs, Clock, Other }\nimport witness\npub struct Box<T> {\n  value: T\n}\npub struct Plain {}\nimpl Convert<i32> for Box<bool> {\n  convert: witness.convertBool\n}\nimpl Convert<bool> for Box<i32> {}\nimpl Hold<'static> for Plain {}\nimpl Needs<&Clock> for Plain {}\nimpl Other for Plain {}\nfn expectBoxBool(value: Box<bool>) -> i32 { return 0 }\nfn expectInt() -> i32 { return 0 }\nfn expectBool() -> bool { return true }\nfn expectStatic() -> &'static i32 { return () }\nfn expectPending() -> Effect<'static; i32 ? &Clock> { return () }\n"
  let contractsSource = run present(contractsText)
  let modelSource = run present(modelText)
  let witnessSource = run present("pub fn convertBool(value: i32) -> i32 { return 0 }\n")
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractsSource)
  let r2 = run Revision.publish(&r1, &model, &modelSource)
  let first = run Revision.publish(&r2, &witness, &witnessSource)
  let mut semantic = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  let boxBool = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 0)
  let boxInt = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 1)
  let plainHold = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 2)
  let plainNeeds = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 3)
  let plainOther = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 4)
  let convert = run requireIdentity(&first, &contracts, OwnerKind.Function, b"convert", 0)
  let hold = run requireIdentity(&first, &contracts, OwnerKind.Function, b"hold", 0)
  let pending = run requireIdentity(&first, &contracts, OwnerKind.Function, b"pending", 0)
  let other = run requireIdentity(&first, &contracts, OwnerKind.Function, b"other", 0)
  let underBool = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let underInt = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxInt, &convert)
  let heads = run Semantic.demandImplementations(&mut semantic, &mut request, &model)
  let appliedContract = contractOf(&headAt(&heads, usize.ZERO))
  let appliedProvider = providerOf(&headAt(&heads, usize.ZERO))
  let mut sameAppliedContract = false
  if let Option<Shared<Type>>.Some {value: contract} = move appliedContract {
    if let Option<Shared<Type>>.Some {value: provider} = move appliedProvider {
      let applied = run Semantic.demandAppliedOperation(
        &mut semantic,
        &mut request,
        &contract,
        &provider,
        &convert,
      )
      sameAppliedContract = run answersEqual(&applied, &underBool, usize.MAX)
    }
  }
  run Testing.expect(
    sameAppliedContract,
    "an applied operation has the same call signature with or without its conformance head",
  )
  let expectBoxBool = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectBoxBool")
  let expectInt = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectInt")
  let expectBool = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectBool")
  let selfBound = run answersEqual(&underBool, &expectBoxBool, usize.ZERO)
  let resultInt = run resultEquals(&underBool, &expectInt)
  let resultBool = run resultEquals(&underInt, &expectBool)
  let distinct = !(run resultEquals(&underBool, &underInt))
  let ownRigid = Shared.with<Result<Answer, NoRejection>, bool>(
    &underBool,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return parameterOwnedBy(answer, usize.ONE, b"convert")
    },
  )
  run Testing.expect(
    selfBound && resultInt && resultBool && distinct && ownRigid,
    "each conformance head binds the contract's T and Self in one operation while its own U stays its parameter",
  )
  let underHold = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainHold, &hold)
  let underNeeds = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainNeeds, &pending)
  let expectStatic = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectStatic")
  let expectPending = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectPending")
  let staticBound = run resultEquals(&underHold, &expectStatic)
  let rowBound = run resultEquals(&underNeeds, &expectPending)
  let foreign = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainOther, &convert)
  let foreignAt = rejectsFrom(&foreign, RejectionCode.UnknownMember, offsetOf(modelText, "Other for Plain", 0))
  let foreignHead = headAt(&heads, 4)
  let foreignContract = contractOf(&foreignHead)
  let foreignProvider = providerOf(&foreignHead)
  let mut appliedForeignAt = false
  if let Option<Shared<Type>>.Some {value: contract} = move foreignContract {
    if let Option<Shared<Type>>.Some {value: provider} = move foreignProvider {
      let appliedForeign = run Semantic.demandAppliedOperation(
        &mut semantic,
        &mut request,
        &contract,
        &provider,
        &convert,
      )
      appliedForeignAt = rejectsFrom(
        &appliedForeign,
        RejectionCode.UnknownMember,
        offsetOf(contractsText, "fn convert", 0),
      )
    }
  }
  run Testing.expect(
    staticBound && rowBound && foreignAt && appliedForeignAt,
    "contract lifetime and row arguments bind, and a foreign operation rejects at its written header",
  )
  let named = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Convert", b"convert")
  let signatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let byIdentity = run Semantic.demandSignatureOf(&mut semantic, &mut request, &convert)
  let sameAnswer = run resultEquals(&named, &byIdentity)
  let noRestart = starts(Semantic.eventLog(&semantic), Family.Signature) == signatureStarts
  let leak = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Leaks", b"leak")
  let quiet = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Quiet", b"quiet")
  let quietView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&quiet, inspect)
  run Testing.expect(
    sameAnswer && noRestart && rejectsAt(&leak, RejectionCode.PrivateTypeExposure) && quietView.success,
    "an identity-addressed operation shares its name lookup's answer, and a public contract's operation cannot expose a private type",
  )
  let underStarts = starts(Semantic.eventLog(&semantic), Family.OperationUnder)
  let underHits = hits(Semantic.eventLog(&semantic), Family.OperationUnder)
  let editedWitness = run present("pub fn convertBool(value: i32) -> i32 { return 1 }\n")
  let second = run Revision.publish(&first, &witness, &editedWitness)
  Semantic.revise(&mut semantic, run Revision.copy(&second))
  let afterBody = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let bodyReused = starts(Semantic.eventLog(&semantic), Family.OperationUnder) == underStarts && hits(
    Semantic.eventLog(&semantic),
    Family.OperationUnder,
  ) == underHits + usize.ONE && (run resultEquals(&afterBody, &expectInt))
  let editedContracts = run present(
    "pub interface Convert<T> {\n  fn convert<U>(value: Self, other: U) -> U\n}\npub interface Hold<'a> {\n  fn hold(value: &Self) -> &'a i32\n}\npub service Clock {}\npub interface Needs<?R> {\n  fn pending(value: &Self) -> Effect<'static; i32 ? R>\n}\npub interface Other {}\nstruct Hidden {}\npub interface Leaks {\n  fn leak(value: &Self) -> Hidden\n}\ninterface Quiet {\n  fn quiet(value: &Self) -> Hidden\n}\n",
  )
  let third = run Revision.publish(&second, &contracts, &editedContracts)
  Semantic.revise(&mut semantic, run Revision.copy(&third))
  let afterHeader = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let headerRecomputed = starts(Semantic.eventLog(&semantic), Family.OperationUnder) == underStarts + usize.ONE && Shared.with<
    Result<Answer, NoRejection>,
    bool,
  >(
    &afterHeader,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return parameterOwnedBy(answer, usize.MAX, b"convert")
    },
  )
  let deleted = run Semantic.demandSignatureOf(&mut semantic, &mut request, &other)
  run Testing.expect(
    bodyReused && headerRecomputed && rejectsWith(&deleted, RejectionCode.UnknownMember),
    "a witness body edit reuses the answer, a contract header edit recomputes it, and a deleted identity rejects",
  )
  return ()
}

