test effect fn nestedGenericCallResultsApplyCalleeBinders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("nested-call-result.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Box<T> { value: T }\nfn make<T>(value: T) -> Box<T> { return () }\nfn useBox(value: i32) -> Box<i32> { return make(value) }\nfn wrap<U>(value: U) -> Box<U> { return make(move value) }\nfn ignore<U>(value: U) { make(move value) }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let contextual = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useBox")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let symbolic = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrap")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ignored = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"ignore")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let makerSignature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"make")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let contextualSignature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"useBox")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let symbolicSignature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"wrap")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&contextual, bodyAnswerIsContractTyped) && Shared.with<Result<Answer, NoRejection>, bool>(&symbolic, bodyAnswerIsContractTyped) && Shared.with<Result<Answer, NoRejection>, bool>(&ignored, bodyAnswerIsContractTyped),
    "nested generic results type from the written signature without checking the invalid callee body",
  )
  let concreteCall = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &contextual,
    checkedBody,
  )
  let symbolicCall = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &symbolic,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move concreteCall {
    let callType = Shared.with<TypedBody, Option<Shared<Type>>>(&body, directCallType)
    let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &contextualSignature,
      signatureResult,
    )
    if let Option<Shared<Type>>.Some {value: actual} = move callType {
      if let Option<Shared<Type>>.Some {value: expected} = move result {
        let same = run Type.equalsShared(&actual, &expected)
          |> Effect.provideMut<Allocator>(&mut allocator)
        run Testing.expect(
          same,
          "Box<T> specializes to Box<i32> for the concrete caller",
        )
      } else {
        run Testing.expect(false, "the concrete caller has a result type")
      }
    } else {
      run Testing.expect(false, "the concrete caller retains its typed call")
    }
  } else {
    run Testing.expect(false, "the concrete caller has a contract-typed body")
  }
  if let Option<Shared<TypedBody>>.Some {value: body} = move symbolicCall {
    let callType = Shared.with<TypedBody, Option<Shared<Type>>>(&body, directCallType)
    let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &symbolicSignature,
      signatureResult,
    )
    if let Option<Shared<Type>>.Some {value: actual} = move callType {
      if let Option<Shared<Type>>.Some {value: expected} = move result {
        let same = run Type.equalsShared(&actual, &expected)
          |> Effect.provideMut<Allocator>(&mut allocator)
        run Testing.expect(
          same,
          "Box<T> specializes to Box<caller U> without retaining callee T",
        )
      } else {
        run Testing.expect(false, "the symbolic caller has a result type")
      }
    } else {
      run Testing.expect(false, "the symbolic caller retains its typed call")
    }
  } else {
    run Testing.expect(false, "the symbolic caller has a contract-typed body")
  }
  let ignoredBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &ignored,
    checkedBody,
  )
  let makerBinder = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &makerSignature,
    ownBinder,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move ignoredBody {
    let callType = Shared.with<TypedBody, Option<Shared<Type>>>(&body, directCallType)
    if let Option<Shared<Type>>.Some {value: actual} = move callType {
      if let Option<Shared<Type>>.Some {value: binder} = move makerBinder {
        let detached = Shared.with<Type, bool>(&binder, fn(value: &Type) -> bool {
          if let Type.Parameter {declaration, ..} = &value.* {
            return Type.occurrences(&actual, &declaration, usize.MAX) == usize.ZERO
          }
          return false
        })
        run Testing.expect(detached, "an ignored result also sheds the callee-owned T")
      } else {
        run Testing.expect(false, "the callee has a declared type binder")
      }
    } else {
      run Testing.expect(false, "the ignored result retains a typed call")
    }
  } else {
    run Testing.expect(false, "the ignored-result caller has a contract-typed body")
  }
  return ()
}

test effect fn boundedNominalAndAliasApplicationsProveConformance() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bounded-applications.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Marker {}\nstruct Good {}\nstruct Bad {}\nimpl Marker for Good {}\nstruct Bounded<T: Marker> {}\ntype Named<T: Marker> = Bounded<T>\nfn good() -> Bounded<Good> { return () }\nfn bad() -> Bounded<Bad> { return () }\nfn aliasGood() -> Named<Good> { return () }\nfn aliasBad() -> Named<Bad> { return () }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let good = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"good")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bad = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"bad")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasGood = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"aliasGood")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasBad = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"aliasBad")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(succeeded(&good), "a concrete bounded nominal application proves its coherent conformance")
  run Testing.expect(
    rejectsFrom(&bad, RejectionCode.MissingConformance, offsetOf(text, "Bounded<Bad>", usize.ZERO)),
    "a bounded nominal application rejects without a coherent conformance",
  )
  run Testing.expect(succeeded(&aliasGood), "a bounded alias proves its bound and expanded target")
  run Testing.expect(
    rejectsFrom(&aliasBad, RejectionCode.MissingConformance, offsetOf(text, "Named<Bad>", usize.ZERO)),
    "a bounded alias cannot bypass its declared interface bound",
  )
  return ()
}

// The byte offset of the zero-based `occurrence` of `needle` in `text`; `usize.MAX` when absent.
fn offsetOf(text: string, needle: string, occurrence: usize) -> usize {
  let haystack = String.utf8Bytes(text)
  let wanted = String.utf8Bytes(needle)
  let mut seen = usize.ZERO
  let mut at = usize.ZERO
  while at + wanted.length <= haystack.length {
    let mut matched = true
    let mut inner = usize.ZERO
    while inner < wanted.length {
      if haystack[at + inner] != wanted[inner] {
        matched = false
      }
      inner = inner + usize.ONE
    }
    if matched {
      if seen == occurrence {
        return at
      }
      seen = seen + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A completed rejection with `code` whose nonempty span starts at `start`.
fn rejectsFrom(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode, start: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.start == start && diagnostic.span.end > start
      },
    )
  }
  return false
}

// A rejection at the exact authored occurrence of `spelling`, including both boundaries.
fn rejectsSpan(
  answer: &Shared<Result<Answer, NoRejection>>,
  code: RejectionCode,
  text: string,
  spelling: string,
  occurrence: usize,
) -> bool {
  let start = offsetOf(text, spelling, occurrence)
  if start == usize.MAX { return false }
  let end = start + String.utf8Bytes(spelling).length
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      return diagnostic.code == code && diagnostic.span.start == start && diagnostic.span.end == end
    })
  }
  return false
}

fn rejectsRelated(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode, start: usize, earlier: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      if diagnostic.code != code || diagnostic.span.start != start { return false }
      return match &diagnostic.related {
        Option<Span>.Some {value: related} => related.start == earlier && related.end > earlier
        Option<Span>.None => false
      }
    })
  }
  return false
}

fn operationCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Operations {operations}} => Vector.length(&operations)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn contractProvider(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => match & contract.provider {
        Option<Shared<Type>>.Some {value: provider} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&provider),
        )
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn ownBinder(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
        if binders.length == usize.ONE {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&binders[usize.ZERO]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn referentOf(value: Option<Shared<Type>>) -> Option<Shared<Type>> {
  if let Option<Shared<Type>>.Some {value: resolved} = move value {
    return Shared.with<Type, Option<Shared<Type>>>(
      &resolved,
      fn(node: &Type) -> Option<Shared<Type>> {
        return match & node.* {
          Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
          _ => Option.none<Shared<Type>>()
        }
      },
    )
  }
  return Option.none<Shared<Type>>()
}

fn parameterAt(value: &Option<Shared<Type>>, ordinal: usize) -> bool {
  if let Option<Shared<Type>>.Some {value: resolved} = &value.* {
    return Shared.with<Type, bool>(
      &resolved,
      fn(node: &Type) -> bool {
        return match & node.* {
          Type.Parameter {ordinal: found, ..} => found == ordinal
          _ => false
        }
      },
    )
  }
  return false
}

fn resolvedSignatures(events: &[SemanticEvent]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].family == Family.Signature {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

test effect fn contractScopesAndOperationHeaders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("contracts.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Decoder<A> {\n  fn decode<B>(value: &Self, hint: B) -> A\n  fn make() -> Self\n}\nservice Clock<T> {\n  fn now(clock: &Self) -> T\n}\ninterface Echo<Self> {}\ninterface Shadow<T> {\n  fn restate<T>(value: T) -> T\n}\ninterface Reserved {\n  fn named<Self>() -> i32\n}\ninterface Repeated {\n  fn decode(value: &Self) -> i32\n  fn decode(other: &Self) -> i32\n}\ninterface Bodied {\n  fn step(value: &Self) -> i32 { return 0 }\n}\ninterface Stored {\n  value: i32\n}\nfn outside(value: Self) -> i32 { return 0 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let listed = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Decoder")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let listedCount = Shared.with<Result<Answer, NoRejection>, usize>(&listed, operationCount)
  let unresolved = resolvedSignatures(Semantic.eventLog(&semantic)) == usize.ZERO
  run Testing.expect(
    listedCount == 2 && unresolved,
    "listing a contract's operations reads member headers without resolving their signatures",
  )
  let contract = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Decoder")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let decode = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Decoder", b"decode")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let make = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Decoder", b"make")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let provider = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &contract,
    contractProvider,
  )
  let providerAfterBinders = parameterAt(&provider, usize.ONE)
  let madeSelf = run typesEqual(slotOf(&make, usize.MAX), move provider)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let receivedSelf = run typesEqual(
    referentOf(slotOf(&decode, usize.ZERO)),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&contract, contractProvider),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    providerAfterBinders && madeSelf && receivedSelf,
    "an operation's Self is the contract's implicit provider, bound after its written binders",
  )
  let own = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&decode, ownBinder)
  let result = slotOf(&decode, usize.MAX)
  let ownFirst = parameterAt(&own, usize.ZERO)
  let resultFirst = parameterAt(&result, usize.ZERO)
  let hintUsesOwn = run typesEqual(
    slotOf(&decode, usize.ONE),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&decode, ownBinder),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ownersDiffer = !(run typesEqual(move result, move own)
    |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(
    ownFirst && resultFirst && hintUsesOwn && ownersDiffer,
    "an operation binder and its contract binder at the same ordinal keep distinct owners",
  )
  let now = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Clock", b"now")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let clock = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Clock")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let clockSelf = run typesEqual(
    referentOf(slotOf(&now, usize.ZERO)),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&clock, contractProvider),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let clockResult = slotOf(&now, usize.MAX)
  let clockBinder = parameterAt(&clockResult, usize.ZERO)
  run Testing.expect(
    clockSelf && clockBinder,
    "a service operation resolves under the same implicit provider scope",
  )
  let echo = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Echo")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let named = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Reserved", b"named")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let restate = run Semantic.demandOperation(
    &mut semantic,
    &mut request,
    &entry,
    b"Shadow",
    b"restate",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let outside = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"outside")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let echoReserved = rejectsFrom(
    &echo,
    RejectionCode.DuplicateTypeParameter,
    offsetOf(text, "Echo<Self>", 0) + 5,
  )
  let operationReserved = rejectsFrom(
    &named,
    RejectionCode.DuplicateTypeParameter,
    offsetOf(text, "named<Self>", 0) + 6,
  )
  let unavailable = rejectsFrom(
    &outside,
    RejectionCode.UnknownName,
    offsetOf(text, "value: Self)", 0) + 7,
  )
  run Testing.expect(
    echoReserved && operationReserved && unavailable,
    "Self is reserved where it is bound and unavailable outside a contract",
  )
  // Whether a member binder may restate an enclosing binder is not settled by the reference.
  let restated = rejectsFrom(&restate, RejectionCode.Unsupported, offsetOf(text, "restate<T>", 0) + 8)
  run Testing.expect(restated, "a restated enclosing binder stays an explicit boundary")
  let repeated = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Repeated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bodied = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Bodied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stored = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Stored")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Decoder", b"absent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedAt = rejectsFrom(&repeated, RejectionCode.Collision, offsetOf(text, "fn decode(other", 0))
  let bodiedAt = rejectsFrom(
    &bodied,
    RejectionCode.InvalidContractMember,
    offsetOf(text, "fn step", 0),
  )
  let storedAt = rejectsAt(&stored, RejectionCode.InvalidContractMember)
  let missingAt = rejectsAt(&missing, RejectionCode.UnknownMember)
  run Testing.expect(
    repeatedAt && bodiedAt && storedAt && missingAt,
    "repeated, bodied, stored and absent contract members reject at their members",
  )
  return ()
}

test effect fn operatorMarkersUseOnlyTheClosedEagerTable() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("operator-markers.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Valid {\n  fn add(left: Self, right: Self) -> Self\n  operator + fn plus(left: Self, right: Self) -> Self\n  operator - fn negate(value: Self) -> Self\n}\ninterface WrongArity { operator + fn add(value: Self) -> Self }\ninterface Control { operator && fn both(left: Self, right: Self) -> bool }\ninterface Assignment { operator = fn set(left: Self, right: Self) -> Self }\nservice Runtime { operator + fn add(left: Self, right: Self) -> Self }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let valid = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Valid")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrong = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"WrongArity")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let control = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Control")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let assignment = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Assignment")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let serviceList = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Runtime")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, usize>(&valid, operationCount) == 3 &&
    rejectsFrom(&wrong, RejectionCode.InvalidOperatorContract, offsetOf(text, "operator +", 1) + 9) &&
    rejectsFrom(&control, RejectionCode.InvalidOperatorContract, offsetOf(text, "operator &&", 0) + 9) &&
    rejectsFrom(&assignment, RejectionCode.InvalidOperatorContract, offsetOf(text, "operator =", 0) + 9) &&
    rejectsFrom(&serviceList, RejectionCode.InvalidOperatorContract, offsetOf(text, "operator +", 2) + 9),
    "unmarked names have no eligibility and invalid marker spellings, arity, and service ownership reject",
  )
  return ()
}

fn contractLifetimes(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => Vector.length(&contract.lifetimeParameters)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

test effect fn generatedFieldLifetimeBinders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("holders.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parts = run module("parts.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let holdersText = "import parts { Part, Broken, Slice, Either }\nservice Store<T> {}\nstruct Uses<?R> {}\nstruct OnceTask {\n  task: once Effect<&i32>\n}\nstruct UsesStore {\n  uses: Uses<&Store<i32>>\n}\nstruct Stored {\n  task: Effect<i32 ? &Store<&u8>>\n}\nstruct Suffixed {\n  uses: Uses<? &Store<&u8>>\n}\nstruct Failing {\n  task: Effect<i32 ! Holder<&u8>>\n}\nstruct UsesEither {\n  either: Either\n}\nimport parts as Parts\nstruct Sliced {\n  bytes: Slice\n}\nstruct Qualified {\n  part: Parts.Part\n}\nstruct Peeks {\n  secret: Parts.Secret\n}\nstruct Pending {\n  task: Effect<&i32>\n}\nstruct Callback {\n  call: fn(&i32) -> i32\n}\nstruct View {\n  data: &[u8]\n  name: string\n}\nstruct Mixed<'a> {\n  first: &'a i32\n  second: &i32\n}\nstruct Plain {\n  value: i32\n}\nunion Choice { Empty, Held { payload: &i32 } }\ntuple Pairing(&i32, string<'static>)\nstruct Outer {\n  inner: View\n}\nstruct Nested {\n  outer: Outer\n  written: View<'static, 'static>\n}\ntype Bytes = &[u8]\nstruct Buffer {\n  bytes: Bytes\n}\nstruct Carrier {\n  part: Part\n}\nstruct Chain {\n  next: &Chain\n}\nstruct Linked<'a> {\n  next: &'a Linked<'a>\n}\nstruct Holder<T> {\n  value: T\n}\nstruct List<T> {\n  next: Holder<List<T>>\n}\nfn read(view: View) -> i32 { return 0 }\nfn keep(value: &i32) -> View { return () }\nfn usesBroken(value: Broken) -> i32 { return 0 }\nstruct Scoped<'a, ?R> {\n  value: &'a i32\n}\nstruct UsesScoped {\n  scoped: Scoped<&Store<i32>>\n}\nfn partial<'x>(m: Mixed<'x>) -> i32 { return 0 }\nfn complete<'x, 'y>(m: Mixed<'x, 'y>) -> i32 { return 0 }\n"
  let partsText = "pub struct Part {\n  value: &i32\n}\npub struct Broken {\n  field: Missing\n}\npub type Slice = &[u8]\nstruct Secret {\n  value: i32\n}\npub union Either { Left { value: &i32 }, Right }\n"
  let source = run present(holdersText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partsSource = run present(partsText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let withParts = run Revision.publish(&Revision.make(), &parts, &partsSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&withParts, &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let view = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"View")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mixed = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Mixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let plain = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Plain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let choice = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Choice")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pairing = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Pairing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let viewCount = Shared.with<Result<Answer, NoRejection>, usize>(&view, contractLifetimes)
  let mixedCount = Shared.with<Result<Answer, NoRejection>, usize>(&mixed, contractLifetimes)
  let plainCount = Shared.with<Result<Answer, NoRejection>, usize>(&plain, contractLifetimes)
  let choiceCount = Shared.with<Result<Answer, NoRejection>, usize>(&choice, contractLifetimes)
  let pairingCount = Shared.with<Result<Answer, NoRejection>, usize>(&pairing, contractLifetimes)
  run Testing.expect(
    viewCount == 2 && mixedCount == 2 && plainCount == usize.ZERO && choiceCount == usize.ONE && pairingCount == usize.ONE,
    "each omitted borrowed field lifetime adds one declaration lifetime after the written binders",
  )
  let read = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"read")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let keep = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"keep")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let readInputs = Shared.with<Result<Answer, NoRejection>, usize>(&read, lifetimeCountOf)
  let keepInputs = Shared.with<Result<Answer, NoRejection>, usize>(&keep, lifetimeCountOf)
  run Testing.expect(
    readInputs == 2 && keepInputs == usize.ONE,
    "an omitted holder application elides each generated lifetime like any nominal input or result",
  )
  let outer = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Outer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let buffer = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Buffer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let carrier = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Carrier")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let linked = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Linked")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let list = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"List")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    outer == 2 && nested == 2 && buffer == usize.ONE && carrier == usize.ONE,
    "a nested nominal, alias, or imported field used without lifetimes adds every lifetime it omits",
  )
  run Testing.expect(
    linked == usize.ONE && list == usize.ZERO,
    "explicit recursive lifetimes and recursion that omits none keep finite arity",
  )
  let chain = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Chain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let broken = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"usesBroken")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unbounded = rejectsFrom(&chain, RejectionCode.Unsupported, offsetOf(holdersText, "&Chain", 0) + 1)
  let importedName = Shared.with<Result<Answer, NoRejection>, bool>(
    &broken,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UnknownName, String.utf8Bytes(partsText), b"Missing")
    },
  )
  run Testing.expect(
    unbounded && importedName,
    "recursion that omits a lifetime on every turn stays unsupported, and an imported field name failure rejects the application",
  )
  let sliced = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Sliced")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let peeks = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Peeks")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pending = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Pending")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callback = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Callback")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    sliced == usize.ONE && qualified == usize.ONE && peeks == usize.ZERO && pending == 2 && callback == usize.ONE,
    "imported aliases, namespace types, Effect environments and payloads, and callable environments count; privacy does not affect arity",
  )
  let peeksIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Peeks")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let peeksType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&peeksIdentity, nominalResult)
  let mut privateMember = false
  if let Option<Shared<Type>>.Some {value: applied} = move peeksType {
    let secret = run Semantic.demandMemberShape(&mut semantic, &mut request, &entry, b"Peeks", 0, &applied)
      |> Effect.provideMut<Allocator>(&mut allocator)
    privateMember = rejectsAt(&secret, RejectionCode.PrivateMember)
  }
  run Testing.expect(privateMember, "a private field type is rejected where the member is demanded")
  let onceTask = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"OnceTask")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let usesStore = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"UsesStore")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stored = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Stored")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let suffixed = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Suffixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let failing = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Failing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let usesEither = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"UsesEither")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let usesScoped = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"UsesScoped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    usesScoped == usize.ONE,
    "an elided lifetime binder consumes no argument, so the next argument binds the next binder's kind",
  )
  let partial = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"partial")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let complete = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"complete")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partialArity = Shared.with<Result<Answer, NoRejection>, bool>(&partial, wrongTypeArity)
  let completeInputs = Shared.with<Result<Answer, NoRejection>, usize>(&complete, lifetimeCountOf)
  run Testing.expect(
    partialArity && completeInputs == 2,
    "a written lifetime list supplies every lifetime parameter, including generated ones",
  )
  run Testing.expect(
    onceTask == 2 && usesStore == usize.ZERO && stored == 2 && suffixed == usize.ONE && failing == 2 && usesEither == usize.ONE,
    "run modes, row access markers, row capabilities, failure types, and imported unions follow argument kinds",
  )
  return ()
}

// The lifetime parameter count of a declaration's contract, or `usize.MAX` when it rejects.
effect fn contractLifetimeCount(
  semantic: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> usize ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let answer = run Semantic.demandContract(&mut semantic.*, &mut request.*, module, name)
  return Shared.with<Result<Answer, NoRejection>, usize>(&answer, contractLifetimes)
}

fn headCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Implementations {heads}} => Vector.length(&heads)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn headAt(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> Option<Shared<ImplementationHead>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return match & value.* {
        Result<Answer, NoRejection>.Success {value: found} => match & found.outcome {
          Outcome.Success {value: Value.Implementations {heads}} => {
            let listed = Vector.asSlice<Shared<ImplementationHead>>(&heads)
            if at < listed.length {
              return Option.some<Shared<ImplementationHead>>(
                Shared.clone<ImplementationHead>(&listed[at]),
              )
            }
            return Option.none<Shared<ImplementationHead>>()
          }
          _ => Option.none<Shared<ImplementationHead>>()
        }
        Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ImplementationHead>>()
      }
    },
  )
}

// 0 inherent, 1 conformance, 2 sealed Copy, 3 sealed Drop; `usize.MAX` when absent.
fn kindOf(head: &Option<Shared<ImplementationHead>>) -> usize {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, usize>(
      &value,
      fn(found: &ImplementationHead) -> usize {
        return match & found.kind {
          ImplementationKind.Inherent => usize.ZERO
          ImplementationKind.Conformance => usize.ONE
          ImplementationKind.Sealed {property} => match property {
            SealedProperty.Copy => 2
            SealedProperty.Drop => 3
          }
        }
      },
    )
  }
  return usize.MAX
}

// Whether the head's provider is a nominal declared in `module`.
fn providedFrom(head: &Option<Shared<ImplementationHead>>, module: &ModuleId) -> bool {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, bool>(
      &value,
      fn(found: &ImplementationHead) -> bool {
        return providerIn(&found.provider, module)
      },
    )
  }
  return false
}

fn providerIn(provider: &Shared<Type>, module: &ModuleId) -> bool {
  return Shared.with<Type, bool>(
    provider,
    fn(resolved: &Type) -> bool {
      return match & resolved.* {
        Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
        _ => false
      }
    },
  )
}

fn headLifetimes(head: &Option<Shared<ImplementationHead>>) -> usize {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, usize>(
      &value,
      fn(found: &ImplementationHead) -> usize {
        return Vector.length(&found.binders.lifetimeParameters)
      },
    )
  }
  return usize.MAX
}

fn copyBoundOnly(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      let declared = Vector.asSlice<Constraint>(&signature.constraints)
      if declared.length != usize.ONE {
        return false
      }
      return match & declared[usize.ZERO] {
        Constraint.Copyable {..} => true
        _ => false
      }
    },
  )
}

test effect fn implementationHeadsAndConformanceOwners() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run implementationClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn implementationClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let contracts = run module("contracts.silk")
  let model = run module("model.silk")
  let outsider = run module("outsider.silk")
  let services = run module("services.silk")
  let sealed = run module("sealed.silk")
  let provider = run module("provider.silk")
  let notContract = run module("notcontract.silk")
  let values = run module("values.silk")
  let empty = run module("empty.silk")
  let streams = run module("streams.silk")
  let unrelated = run module("unrelated.silk")
  let outsiderText = "import model { User }\nimport contracts { Show }\nimpl Show for User {}\n"
  let providerText = "interface Shown {}\nimpl Shown for &i32 {}\n"
  let notContractText = "struct Plain {}\nstruct Other {}\nimpl Plain for Other {}\n"
  let valuesText = "import contracts { Show }\nfn keep(value: &Show) -> i32 { return 0 }\nfn dup<T: Copy>(value: T) -> T { return move value }\nfn drops<T: Drop>(value: T) -> i32 { return 0 }\n"
  let contractsSource = run present(
    "import model { User }\nimport unrelated { Noise }\npub interface Show {}\npub service Clock {}\nimpl Show for User {}\nimpl Show for i32 {}\nfn unused(value: Noise) -> i32 { return 0 }\n",
  )
  let modelSource = run present(
    "import contracts { Show, Clock }\npub struct User {}\npub struct Box<T> {\n  value: T\n}\nimpl Clock for User {}\nimpl<T> Show for Box<T> {}\nimpl Copy for User {}\nimpl User {\n  fn make() -> Self { return () }\n}\n",
  )
  let outsiderSource = run present(outsiderText)
  let servicesSource = run present("pub service Tick {}\nimpl Tick for i32 {}\n")
  let sealedSource = run present("impl Copy for i32 {}\n")
  let providerSource = run present(providerText)
  let notContractSource = run present(notContractText)
  let valuesSource = run present(valuesText)
  let emptySource = run present("fn nothing() -> i32 { return missing() }\n")
  let streamsSource = run present(
    "struct SliceStream<A> {\n  items: &[A]\n}\ninterface Stream<A> {}\nimpl<A> Stream<A> for SliceStream<A> {}\nimpl<A> SliceStream<A> {\n  fn first(stream: &Self) -> i32 { return 0 }\n}\n",
  )
  let unrelatedSource = run present("pub struct Noise {}\n")
  let membersModule = run module("members.silk")
  let membersText = "interface Pairwise {\n  fn left(value: &Self) -> i32\n  fn right(value: &Self) -> i32\n}\nstruct Item {}\nfn itemRight(value: &Item) -> i32 { return 0 }\nimpl Item {\n  fn width(item: &Self) -> i32 { return 0 }\n}\nimpl Pairwise for Item {\n  fn left(value: &Self) -> i32 { return 1 }\n  right: itemRight\n}\nstruct Other {}\nimpl Pairwise for Other {\n  left: Item.width\n  right: missing\n}\nstruct Dup {}\nimpl Pairwise for Dup {\n  fn left(value: &Self) -> i32 { return 1 }\n  left: itemRight\n}\nstruct Twin {}\nimpl Twin {\n  fn both() -> i32 { return 0 }\n}\nimpl Twin {\n  fn both() -> i32 { return 1 }\n}\nstruct Mapper {}\nimpl Pairwise for Mapper {\n  left: Twin.both\n  right: itemRight\n}\nstruct Sealed {}\nimpl Pairwise for Sealed {\n  left: Intrinsic.replace\n  right: itemRight\n}\nstruct Wrap<T> {\n  value: T\n}\nimpl<'long: 'short, 'short, T: Pairwise + Copy + 'short, F: fn<'static>(i32) -> i32> Pairwise for Wrap<T> {}\n"
  let membersSource = run present(membersText)
  let facade = run module("facade.silk")
  let consumer = run module("consumer.silk")
  let facadeSource = run present("pub import contracts { Show }\n")
  let consumerSource = run present(
    "import facade { Show as Visible }\nimport contracts { Show }\nimport model { User, Box }\nstruct Plain {}\nfn viaFacade<T: Visible>(value: T) -> i32 { return 0 }\nfn direct<T: Show>(value: T) -> i32 { return 0 }\nfn user(value: User) -> i32 { return 0 }\nfn boxed(value: Box<i32>) -> i32 { return 0 }\nfn scalar(value: i32) -> i32 { return 0 }\nfn plain(value: Plain) -> i32 { return 0 }\n",
  )
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractsSource)
  let r2 = run Revision.publish(&r1, &model, &modelSource)
  let r3 = run Revision.publish(&r2, &outsider, &outsiderSource)
  let r4 = run Revision.publish(&r3, &services, &servicesSource)
  let r5 = run Revision.publish(&r4, &sealed, &sealedSource)
  let r6 = run Revision.publish(&r5, &provider, &providerSource)
  let r7 = run Revision.publish(&r6, &notContract, &notContractSource)
  let r8 = run Revision.publish(&r7, &values, &valuesSource)
  let r9 = run Revision.publish(&r8, &empty, &emptySource)
  let r10 = run Revision.publish(&r9, &streams, &streamsSource)
  let r11 = run Revision.publish(&r10, &unrelated, &unrelatedSource)
  let r12 = run Revision.publish(&r11, &facade, &facadeSource)
  let r13 = run Revision.publish(&r12, &consumer, &consumerSource)
  let revision = run Revision.publish(&r13, &membersModule, &membersSource)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let contractHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &contracts)
  let first = headAt(&contractHeads, usize.ZERO)
  let second = headAt(&contractHeads, usize.ONE)
  let contractCount = Shared.with<Result<Answer, NoRejection>, usize>(&contractHeads, headCount)
  let interfaceOwned = kindOf(&first) == usize.ONE && providedFrom(&first, &model) && kindOf(&second) == usize.ONE
  let noiseUnread = reads(Semantic.sourceEvents(&semantic), &unrelated) == usize.ZERO
  run Testing.expect(
    contractCount == 2 && interfaceOwned && noiseUnread,
    "an interface's module owns conformances for imported and scalar providers without reading unrelated imports",
  )
  let modelHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &model)
  let serviceHead = headAt(&modelHeads, usize.ZERO)
  let generic = headAt(&modelHeads, usize.ONE)
  let copy = headAt(&modelHeads, 2)
  let modelCount = Shared.with<Result<Answer, NoRejection>, usize>(&modelHeads, headCount)
  let providerOwned = kindOf(&serviceHead) == usize.ONE && kindOf(&generic) == usize.ONE && providedFrom(
    &generic,
    &model,
  )
  let sealedHead = kindOf(&copy) == 2
  run Testing.expect(
    modelCount == 3 && providerOwned && sealedHead,
    "a provider's module owns its service, interface and sealed heads across an import cycle",
  )
  let make = run signatureNamed(&mut semantic, &mut request, &mut index, &model, b"make", 0)
  let made = slotOf(&make, usize.MAX)
  let mut madeUser = false
  if let Option<Shared<Type>>.Some {value} = move made {
    madeUser = Shared.with<Type, bool>(&value, isNominal)
  }
  run Testing.expect(madeUser, "an inherent member's Self is its applied owner")
  let outsiderHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &outsider)
  let serviceHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &services)
  let sealedHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &sealed)
  let providerHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &provider)
  let notContractHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &notContract)
  let unowned = rejectsFrom(
    &outsiderHeads,
    RejectionCode.ConformanceOwner,
    offsetOf(outsiderText, "impl Show", 0),
  )
  let serviceScalar = rejectsAt(&serviceHeads, RejectionCode.ConformanceOwner)
  let sealedScalar = rejectsAt(&sealedHeads, RejectionCode.ConformanceOwner)
  let borrowed = rejectsFrom(
    &providerHeads,
    RejectionCode.InvalidProvider,
    offsetOf(providerText, "&i32", 0),
  )
  let plain = rejectsFrom(
    &notContractHeads,
    RejectionCode.InvalidBound,
    offsetOf(notContractText, "Plain for", 0),
  )
  run Testing.expect(
    unowned && serviceScalar && sealedScalar && borrowed && plain,
    "unowned, scalar-service, scalar-sealed, borrowed-provider and non-contract heads reject",
  )
  let keep = run Semantic.demandSignature(&mut semantic, &mut request, &values, b"keep")
  let dup = run Semantic.demandSignature(&mut semantic, &mut request, &values, b"dup")
  let drops = run Semantic.demandSignature(&mut semantic, &mut request, &values, b"drops")
  let existential = rejectsFrom(&keep, RejectionCode.NotType, offsetOf(valuesText, "&Show", 0))
  let copyBound = Shared.with<Result<Answer, NoRejection>, bool>(&dup, copyBoundOnly)
  let dropBound = rejectsFrom(&drops, RejectionCode.InvalidBound, offsetOf(valuesText, "Drop>", 0))
  run Testing.expect(
    existential && copyBound && dropBound,
    "an interface is not a value type, Copy is a sealed bound and Drop is not a bound",
  )
  let none = run Semantic.demandImplementations(&mut semantic, &mut request, &empty)
  let noneCount = Shared.with<Result<Answer, NoRejection>, usize>(&none, headCount)
  let noBodies = starts(Semantic.eventLog(&semantic), Family.Body) == usize.ZERO
  run Testing.expect(
    noneCount == usize.ZERO && noBodies,
    "a module without implementations observes an empty head list without checking bodies",
  )
  let streamHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &streams)
  let conformance = headAt(&streamHeads, usize.ZERO)
  let conformanceLifetime = headLifetimes(&conformance) == usize.ONE
  let streamMember = run signatureNamed(&mut semantic, &mut request, &mut index, &streams, b"first", 0)
  let streamView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&streamMember, inspect)
  let inherentLifetime = streamView.success
  run Testing.expect(
    conformanceLifetime && inherentLifetime,
    "a holder lifetime omitted from an impl head becomes an implementation lifetime",
  )
  let viaFacade = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"viaFacade")
  let direct = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"direct")
  let user = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"user")
  let boxed = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"boxed")
  let scalar = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"scalar")
  let plainSignature = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"plain")
  let facadeContract = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&viaFacade, boundContract)
  let directContract = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&direct, boundContract)
  let userProvider = slotOf(&user, usize.ZERO)
  let boxedProvider = slotOf(&boxed, usize.ZERO)
  let scalarProvider = slotOf(&scalar, usize.ZERO)
  let plainProvider = slotOf(&plainSignature, usize.ZERO)
  let facadeCount = run conformanceCount(&mut semantic, &mut request, &facadeContract, &userProvider)
  let directCount = run conformanceCount(&mut semantic, &mut request, &directContract, &userProvider)
  let boxedCount = run conformanceCount(&mut semantic, &mut request, &directContract, &boxedProvider)
  let scalarCount = run conformanceCount(&mut semantic, &mut request, &directContract, &scalarProvider)
  let plainCount = run conformanceCount(&mut semantic, &mut request, &directContract, &plainProvider)
  let converged = run typesEqual(move facadeContract, move directContract)
  run Testing.expect(
    converged && facadeCount == usize.ONE && directCount == usize.ONE,
    "a facade and renamed contract endpoint converge on the canonical conformance owners",
  )
  run Testing.expect(
    boxedCount == usize.ONE && scalarCount == usize.ONE && plainCount == usize.ZERO,
    "provider-owned, contract-owned scalar and absent conformances are observed from permitted modules",
  )
  let itemMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 1)
  let otherMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 2)
  let dupMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 3)
  let itemShape = Shared.with<Result<Answer, NoRejection>, bool>(&itemMembers, inlineThenMapped)
  let otherMissing = rejectsFrom(&otherMembers, RejectionCode.UnknownName, offsetOf(membersText, "missing", 0))
  let dupRepeated = rejectsFrom(&dupMembers, RejectionCode.Collision, offsetOf(membersText, "left: itemRight", 0))
  let dupRelated = Shared.with<Result<Answer, NoRejection>, bool>(&dupMembers, relatesOne)
  run Testing.expect(
    itemShape && otherMissing && dupRepeated && dupRelated,
    "conformance members keep written order, resolve mapped targets from headers and reject repeats",
  )
  let mapperMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 6)
  let sealedMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 7)
  let keptRejection = rejectsAt(&mapperMembers, RejectionCode.Collision)
  let sealedMapping = rejectsFrom(
    &sealedMembers,
    RejectionCode.Unsupported,
    offsetOf(membersText, "Intrinsic.replace", 0),
  )
  let pairwiseHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &membersModule)
  let wrapHead = headAt(&pairwiseHeads, 5)
  // Outlives, conformance, sealed Copy, contents, and representation bounds each yield one span.
  let boundAnchors = boundSpansMatch(&wrapHead, 5, offsetOf(membersText, "Pairwise + Copy", 0))
  run Testing.expect(
    keptRejection && sealedMapping && boundAnchors,
    "a mapped duplicate keeps its rejection, an intrinsic mapping is unsupported, and bound spans follow constraints",
  )
  return ()
}

// Two members: an inline operation, then a mapping to a function named `itemRight`.
fn inlineThenMapped(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ImplementationMembers {members}} => {
        let listed = Vector.asSlice<ImplementationMember>(&members)
        if listed.length != 2 {
          return false
        }
        let first = match & listed[usize.ZERO] {
          ImplementationMember.Inline {..} => true
          _ => false
        }
        let second = match & listed[usize.ONE] {
          ImplementationMember.Mapped {target, ..} => Shared.with<DeclarationId, bool>(&target, mapsItemRight)
          _ => false
        }
        return first && second
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// A rejection that relates exactly one other declaration.
fn relatesOne(answer: &Result<Answer, NoRejection>) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return Vector.length(&diagnostic.path) == usize.ONE
      },
    )
  }
  return false
}

// Whether a head records `count` constraints with one bound span each, the second at `second`.
fn boundSpansMatch(head: &Option<Shared<ImplementationHead>>, count: usize, second: usize) -> bool {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, bool>(
      &value,
      fn(found: &ImplementationHead) -> bool {
        let spans = Vector.asSlice<Span>(&found.boundSpans)
        return Vector.length(&found.binders.constraints) == count && spans.length == count && spans[usize.ONE].start == second
      },
    )
  }
  return false
}

fn mapsItemRight(target: &DeclarationId) -> bool {
  return DeclarationId.named(target, b"itemRight")
}

fn boundContract(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let declared = Vector.asSlice<Constraint>(&signature.constraints)
        if declared.length == usize.ONE {
          if let Constraint.Conforms {contract, ..} = &declared[usize.ZERO] {
            return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          }
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn conformanceHeadCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ConformanceHeads {heads}} => Vector.length(&heads)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

// The relevant conformance head count for a goal, or `usize.MAX` when either type is absent.
effect fn conformanceCount(
  semantic: &mut Semantic,
  request: &mut Request,
  contract: &Option<Shared<Type>>,
  provider: &Option<Shared<Type>>,
) -> usize ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: applied} = &contract.* {
    if let Option<Shared<Type>>.Some {value: owner} = &provider.* {
      let heads = run Semantic.demandConformanceHeads(&mut semantic.*, &mut request.*, &applied, &owner)
      return Shared.with<Result<Answer, NoRejection>, usize>(&heads, conformanceHeadCount)
    }
  }
  return usize.MAX
}

fn inherentCount(answer: &Result<Answer, NoRejection>, published: bool) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.InherentMembers {members, rejected}} => {
        if published {
          return Vector.length(&members)
        }
        return Vector.length(&rejected)
      }
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn ownBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length(&signature.typeParameters)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn hasKind(declaration: &DeclarationId, kind: OwnerKind) -> bool {
  return match kind {
    OwnerKind.Function => match DeclarationId.kind(declaration) {
      OwnerKind.Function => true
      _ => false
    }
    OwnerKind.Implementation => match DeclarationId.kind(declaration) {
      OwnerKind.Implementation => true
      _ => false
    }
    OwnerKind.Struct => match DeclarationId.kind(declaration) {
      OwnerKind.Struct => true
      _ => false
    }
    OwnerKind.Enumeration => match DeclarationId.kind(declaration) {
      OwnerKind.Enumeration => true
      _ => false
    }
    OwnerKind.Union => match DeclarationId.kind(declaration) {
      OwnerKind.Union => true
      _ => false
    }
    OwnerKind.Interface => match DeclarationId.kind(declaration) {
      OwnerKind.Interface => true
      _ => false
    }
    OwnerKind.Service => match DeclarationId.kind(declaration) {
      OwnerKind.Service => true
      _ => false
    }
    _ => false
  }
}

// The identity a caller holding the module's source index addresses: the `occurrence`th
// declaration of `kind` in source order, named `name` unless `name` is empty.
// Reuse one parsed source index across every identity addressed by a fixture revision.
effect fn indexedIdentity(
  index: &mut SourceIndex,
  module: &ModuleId,
  kind: OwnerKind,
  name: &[u8],
  occurrence: usize,
) -> Option<DeclarationId> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let answer = run SourceIndex.demand(&mut index.*, module)
  if let Option<&IndexedSource>.Some {value} = move SourceIndex.source(&index.*, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut seen = usize.ZERO
    let mut at = usize.ZERO
    while at < declarations.length {
      let identity = &declarations[at].identity
      if hasKind(identity, kind) && (name.length == usize.ZERO || DeclarationId.named(identity, name)) {
        if seen == occurrence {
          return Option.some<DeclarationId>(run DeclarationId.copy(identity))
        }
        seen = seen + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return Option.none<DeclarationId>()
}

effect fn requireIndexedIdentity(
  index: &mut SourceIndex,
  module: &ModuleId,
  kind: OwnerKind,
  name: &[u8],
  occurrence: usize,
) -> DeclarationId ! Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let found = run indexedIdentity(&mut index.*, module, kind, name, occurrence)
  if let Option<DeclarationId>.Some {value} = move found {
    return move value
  }
  run Testing.expect(false, "the fixture declares the addressed declaration")
  return run requireIndexedIdentity(&mut index.*, module, kind, name, occurrence)
}

// The signature of the `occurrence`th function named `name`, addressed by its identity.
effect fn signatureNamed(
  semantic: &mut Semantic,
  request: &mut Request,
  index: &mut SourceIndex,
  module: &ModuleId,
  name: &[u8],
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let identity = run requireIndexedIdentity(&mut index.*, module, OwnerKind.Function, name, occurrence)
  return run Semantic.demandSignatureOf(&mut semantic.*, &mut request.*, &identity)
}

