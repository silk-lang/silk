struct AnswerView {
  success: bool
  dependencies: usize
  sources: usize
}

struct BranchArms {
  first: usize
  second: usize
}

struct NestedFailureAllocator {
  targetBytes: usize
  rejected: bool
}

impl NestedFailureAllocator {
  effect fn allocate(self: &mut Self, layout: Layout) -> Allocation ! OutOfMemoryError {
    if layout.bytes == self.targetBytes && layout.alignment == 1 {
      self.rejected = true
      fail OutOfMemoryError {}
    }
    let mut system = Allocator.systemAllocatorProvider()
    return run Allocator.allocate(move layout)
      |> Effect.provideMut<Allocator>(&mut system)
  }
}

impl Allocator for NestedFailureAllocator {
  allocate: NestedFailureAllocator.allocate
}

fn inspect(answer: &Result<Answer, NoRejection>) -> AnswerView {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: _} => AnswerView {
        success: true,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
      Outcome.Rejected {diagnostic: _} => AnswerView {
        success: false,
        dependencies: Vector.length(&value.dependencies),
        sources: Vector.length(&value.sources),
      }
    }
    Result<Answer, NoRejection>.Failure {error: _} => AnswerView {
      success: false,
      dependencies: usize.ZERO,
      sources: usize.ZERO,
    }
  }
}

fn rejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      Outcome.Success {value: _} => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn answerHasAbsentSource(answer: &Result<Answer, NoRejection>, module: &ModuleId) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let sources = Vector.asSlice<Shared<Observation>>(&value.sources)
      let mut at = usize.ZERO
      while at < sources.length {
        if Shared.with<Observation, bool>(
          &sources[at],
          fn(observed: &Observation) -> bool {
            return !Observation.isPresent(observed) && ModuleId.equals(
              Observation.moduleId(observed),
              module,
            )
          },
        ) {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => Option.some<Shared<TypedBody>>(
        Shared.clone<TypedBody>(&body),
      )
      _ => Option.none<Shared<TypedBody>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<TypedBody>>()
  }
}

fn bodyFirstIntegerType(body: &TypedBody, spelling: &[u8]) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if nodes.length == usize.ZERO {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {ty, form: BodyExpression.Integer {..}} => Shared.with<Type, bool>(
      &ty,
      fn(found: &Type) -> bool {
        return match & found.* {
          Type.Primitive {name} => {
            let bytes = Bytes.asSlice(&name)
            if bytes.length != spelling.length {
              return false
            }
            let mut at = usize.ZERO
            while at < bytes.length {
              if bytes[at] != spelling[at] {
                return false
              }
              at = at + usize.ONE
            }
            return true
          }
          _ => false
        }
      },
    )
    _ => false
  }
}

fn rejectionSpells(
  answer: &Result<Answer, NoRejection>,
  code: RejectionCode,
  source: &[u8],
  spelling: &[u8],
) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        if diagnostic.code != code || diagnostic.span.end > source.length || diagnostic.span.end - diagnostic.span.start != spelling.length {
          return false
        }
        let mut at = usize.ZERO
        while at < spelling.length {
          if source[diagnostic.span.start + at] != spelling[at] {
            return false
          }
          at = at + usize.ONE
        }
        return true
      },
    )
  }
  return false
}

fn missingReturnAtFunctionClose(answer: &Result<Answer, NoRejection>, source: &[u8], name: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + name.length <= source.length {
    let mut matched = usize.ZERO
    while matched < name.length && source[at + matched] == name[matched] {
      matched = matched + usize.ONE
    }
    if matched == name.length {
      let mut end = at + name.length
      while end < source.length && source[end] != 10 {
        end = end + usize.ONE
      }
      if end == usize.ZERO || source[end - usize.ONE] != 125 {
        return false
      }
      let found = rejection(answer)
      if let Option<Shared<Rejection>>.Some {value} = move found {
        return Shared.with<Rejection, bool>(
          &value,
          fn(diagnostic: &Rejection) -> bool {
            return diagnostic.code == RejectionCode.MissingReturn && diagnostic.span.start == end - usize.ONE && diagnostic.span.end == end
          },
        )
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyReadsParameter(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if nodes.length != 3 || TypedBody.runtimeBodies(body).length != 0 || TypedBody.signatureDependencies(
    body,
  ).length != 1 {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => {
      let locals = TypedBody.localSlice(body)
      return local.index < locals.length && locals[local.index].origin.syntax.index < nodes[usize.ZERO].origin.syntax.index
    }
    _ => false
  }
}

fn bodyReadsLocalChain(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  if nodes.length != 7 || locals.length != 2 || !bodyFirstIntegerType(body, b"i32") {
    return false
  }
  return match & nodes[usize.ONE].kind {
    BodyNodeKind.LocalBinding {local: first, initializer: firstValue} => {
      if first.index != usize.ZERO || firstValue.index != usize.ZERO || locals[first.index].origin.syntax.index != nodes[usize.ONE].origin.syntax.index {
        return false
      }
      return match & nodes[2].kind {
        BodyNodeKind.Expression {form: BodyExpression.Local {local: readFirst}, ..} => {
          if readFirst.index != first.index {
            return false
          }
          return match & nodes[3].kind {
            BodyNodeKind.LocalBinding {local: second, initializer: secondValue} => {
              if second.index != usize.ONE || secondValue.index != 2 || locals[second.index].origin.syntax.index != nodes[3].origin.syntax.index {
                return false
              }
              return match & nodes[4].kind {
                BodyNodeKind.Expression {form: BodyExpression.Local {local: readSecond}, ..} => {
                  return readSecond.index == second.index
                }
                _ => false
              }
            }
            _ => false
          }
        }
        _ => false
      }
    }
    _ => false
  }
}

fn bodyShadowsParameter(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  if nodes.length != 5 || locals.length != 2 {
    return false
  }
  return match & nodes[usize.ZERO].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local: initial}, ..} => {
      if initial.index != usize.ZERO {
        return false
      }
      return match & nodes[2].kind {
        BodyNodeKind.Expression {form: BodyExpression.Local {local: returned}, ..} => {
          return returned.index == usize.ONE && locals[usize.ZERO].origin.syntax.index != locals[usize.ONE].origin.syntax.index
        }
        _ => false
      }
    }
    _ => false
  }
}

fn bodyCalls(body: &TypedBody, module: &ModuleId, argumentCount: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let signatures = TypedBody.signatureDependencies(body)
  let required = TypedBody.runtimeBodies(body)
  if signatures.length != 2 || required.length != 1 || !ModuleId.equals(
    DeclarationId.moduleId(&required[usize.ZERO]),
    module,
  ) || !DeclarationId.equals(&signatures[usize.ONE].declaration, &required[usize.ZERO]) {
    return false
  }
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, arguments, ..}, ..} = &nodes[at].kind {
      if !DeclarationId.equals(&declaration, &required[usize.ZERO]) || Vector.length(&arguments) != argumentCount {
        return false
      }
      let ordered = Vector.asSlice(&arguments)
      let mut argument = usize.ONE
      while argument < ordered.length {
        if nodes[ordered[argument - usize.ONE].index].origin.span.start >= nodes[ordered[argument].index].origin.span.start {
          return false
        }
        argument = argument + usize.ONE
      }
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyCallGenericCount(body: &TypedBody, count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {genericArguments, ..}, ..} = &nodes[at].kind {
      return Vector.length<Argument>(&genericArguments) == count
    }
    at = at + usize.ONE
  }
  return false
}

fn bodyNestedCalls(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let required = TypedBody.runtimeBodies(body)
  if required.length != 2 || TypedBody.signatureDependencies(body).length != 3 {
    return false
  }
  let mut seen = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, ..}, ..} = &nodes[at].kind {
      if seen >= required.length || !DeclarationId.equals(&declaration, &required[seen]) {
        return false
      }
      seen = seen + usize.ONE
    }
    at = at + usize.ONE
  }
  return seen == 2
}

fn singleBranch(body: &TypedBody) -> Option<usize> {
  let nodes = TypedBody.nodeSlice(body)
  let root = TypedBody.rootNode(body)
  if root.index >= nodes.length {
    return Option.none<usize>()
  }
  if let BodyNodeKind.Block {statements, canComplete} = &nodes[root.index].kind {
    let written = Vector.asSlice(&statements)
    if !canComplete && written.length == 1 {
      return Option.some<usize>(written[usize.ZERO].index)
    }
  }
  return Option.none<usize>()
}

fn completeBranchArms(body: &TypedBody, branchIndex: usize) -> Option<BranchArms> {
  let nodes = TypedBody.nodeSlice(body)
  if branchIndex >= nodes.length {
    return Option.none<BranchArms>()
  }
  if let BodyNodeKind.Branch {thenBranch, elseBranch, canComplete, ..} = &nodes[branchIndex].kind {
    if !canComplete {
      if let Option<BodyNodeId>.Some {value: other} = &elseBranch {
        return Option.some<BranchArms>(BranchArms {first: thenBranch.index, second: other.index})
      }
    }
  }
  return Option.none<BranchArms>()
}

fn blockCannotComplete(body: &TypedBody, index: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if index < nodes.length {
    if let BodyNodeKind.Block {canComplete, ..} = &nodes[index].kind {
      return !canComplete
    }
  }
  return false
}

fn bodyHasCompleteBranch(body: &TypedBody) -> bool {
  let branch = singleBranch(body)
  if let Option<usize>.Some {value: branchIndex} = move branch {
    let selected = completeBranchArms(body, branchIndex)
    if let Option<BranchArms>.Some {value: arms} = move selected {
      return blockCannotComplete(body, arms.first) && blockCannotComplete(body, arms.second)
    }
  }
  return false
}

fn bodyHasDistinctArmLocals(body: &TypedBody) -> bool {
  let locals = TypedBody.localSlice(body)
  if locals.length != 3 || locals[usize.ONE].origin.syntax.index == locals[2].origin.syntax.index {
    return false
  }
  let nodes = TypedBody.nodeSlice(body)
  let mut first = false
  let mut second = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[at].kind {
      if local.index == 1 {
        first = true
      } else if local.index == 2 {
        second = true
      }
    }
    at = at + usize.ONE
  }
  return first && second
}

fn rejectionCode(answer: &Result<Answer, NoRejection>, code: RejectionCode) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.end > diagnostic.span.start
      },
    )
  }
  return false
}

fn isUnknownName(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownName
}

fn isUnknownMember(value: &Rejection) -> bool {
  return value.code == RejectionCode.UnknownMember
}

fn isMissingModule(value: &Rejection) -> bool {
  return value.code == RejectionCode.MissingModule && value.span.end > value.span.start
}

fn isPrivateExposure(value: &Rejection) -> bool {
  return value.code == RejectionCode.PrivateTypeExposure && value.span.end > value.span.start
}

fn isCollision(value: &Rejection) -> bool {
  return value.code == RejectionCode.Collision
}

fn isUnsupported(value: &Rejection) -> bool {
  return value.code == RejectionCode.Unsupported && value.span.end > value.span.start
}

fn isCycle(value: &Rejection) -> bool {
  return value.code == RejectionCode.Cycle
}

fn cyclePathLength(value: &Rejection) -> usize {
  return Vector.length(&value.path)
}

fn spanEnd(value: &Rejection) -> usize {
  return value.span.end
}

fn declarationAddress(value: &DeclarationId) -> usize {
  return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(value))
}

fn stepWith(first: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(
    right,
    fn(second: &DeclarationId) -> bool {
      return DeclarationId.equals(first, second)
    },
  )
}

// Cycle paths share declaration handles; compare one handle without entering it twice.
fn sameStep(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  if Shared.with<DeclarationId, usize>(left, declarationAddress) == Shared.with<
    DeclarationId,
    usize,
  >(right, declarationAddress) {
    return true
  }
  return Shared.with<DeclarationId, bool>(
    left,
    fn(first: &DeclarationId) -> bool {
      return stepWith(first, right)
    },
  )
}

fn stepOf(value: &Rejection, at: usize) -> Shared<DeclarationId> {
  let path = Vector.asSlice<Shared<DeclarationId>>(&value.path)
  return Shared.clone<DeclarationId>(&path[at])
}

fn cycleStep(diagnostic: &Shared<Rejection>, at: usize) -> Shared<DeclarationId> {
  return Shared.with<Rejection, Shared<DeclarationId>>(
    diagnostic,
    fn(value: &Rejection) -> Shared<DeclarationId> {
      return stepOf(value, at)
    },
  )
}

fn sameModuleWith(first: &Rejection, other: &Shared<Rejection>) -> bool {
  return Shared.with<Rejection, bool>(
    other,
    fn(second: &Rejection) -> bool {
      return ModuleId.equals(&first.module, &second.module)
    },
  )
}

// Compares cycle rejections from two stores: anchor, module, and the complete ordered path.
fn sameCycle(left: &Shared<Rejection>, right: &Shared<Rejection>) -> bool {
  let length = Shared.with<Rejection, usize>(left, cyclePathLength)
  if !Shared.with<Rejection, bool>(left, isCycle) || !Shared.with<Rejection, bool>(right, isCycle) || length != Shared.with<
    Rejection,
    usize,
  >(right, cyclePathLength) || length < 2 || Shared.with<Rejection, usize>(left, spanStart) != Shared.with<
    Rejection,
    usize,
  >(right, spanStart) || Shared.with<Rejection, usize>(left, spanEnd) != Shared.with<
    Rejection,
    usize,
  >(right, spanEnd) || !Shared.with<Rejection, bool>(
    left,
    fn(first: &Rejection) -> bool {
      return sameModuleWith(first, right)
    },
  ) {
    return false
  }
  let mut at = usize.ZERO
  while at < length {
    if !sameStep(&cycleStep(left, at), &cycleStep(right, at)) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn sameCycleAnswers(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(left, rejection)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(right, rejection)
  if let Option<Shared<Rejection>>.Some {value: from} = move first {
    if let Option<Shared<Rejection>>.Some {value: to} = move second {
      return sameCycle(&from, &to)
    }
  }
  return false
}

// Two members of one two-declaration cycle each start the path at themselves.
fn rotatedPair(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(left, rejection)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(right, rejection)
  if let Option<Shared<Rejection>>.Some {value: from} = move first {
    if let Option<Shared<Rejection>>.Some {value: to} = move second {
      return Shared.with<Rejection, usize>(&from, cyclePathLength) == 3 && Shared.with<
        Rejection,
        usize,
      >(&to, cyclePathLength) == 3 && sameStep(&cycleStep(&from, 0), &cycleStep(&to, 1)) && sameStep(
        &cycleStep(&from, 1),
        &cycleStep(&to, 0),
      ) && !sameStep(&cycleStep(&from, 0), &cycleStep(&to, 0))
    }
  }
  return false
}

fn cycleAnchoredAt(answer: &Result<Answer, NoRejection>, start: usize) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.Cycle && diagnostic.span.start == start && diagnostic.span.end == start + usize.ONE
      },
    )
  }
  return false
}

fn importCycleAnchor(value: &Rejection) -> bool {
  return value.span.end > value.span.start
}

fn isNominal(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Nominal {..} => true
    _ => false
  }
}

fn isBool(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 4 && bytes[0] == 98 && bytes[1] == 111 && bytes[2] == 111 && bytes[3] == 108
    }
    _ => false
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn spanStart(value: &Rejection) -> usize {
  return value.span.start
}

fn signatureResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: fact} => match & fact {
        Value.Signature {signature} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&signature.result),
        )
        _ => Option.none<Shared<Type>>()
      }
      Outcome.Rejected {diagnostic: _} => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn nominalResult(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Type {resolved}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&resolved),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn memberNames(answer: &Result<Answer, NoRejection>, first: &[u8], second: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members}} => {
        let entries = Vector.asSlice(&members)
        if entries.length != 2 {
          return false
        }
        return match & entries[0].name {
          Option<Bytes>.Some {value: left} => match & entries[1].name {
            Option<Bytes>.Some {value: right} => sameBytes(Bytes.asSlice(&left), first) && sameBytes(
              Bytes.asSlice(&right),
              second,
            )
            _ => false
          }
          _ => false
        }
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn memberSingleName(answer: &Result<Answer, NoRejection>, expected: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Members {members}} => {
        let entries = Vector.asSlice<Member>(&members)
        if entries.length != 1 {
          return false
        }
        return match & entries[0].name {
          Option<Bytes>.Some {value: name} => sameBytes(Bytes.asSlice(&name), expected)
          Option<Bytes>.None => false
        }
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => Vector.length<Shared<Type>>(&types)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn shapeFirstIsBool(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector.asSlice<Shared<Type>>(&types)
        return values.length == 1 && Shared.with<Type, bool>(&values[0], isBool)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeFirstIsI32(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector.asSlice<Shared<Type>>(&types)
        return values.length == 1 && Shared.with<Type, bool>(&values[0], isI32)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn shapeFirstIsNominal(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let values = Vector.asSlice<Shared<Type>>(&types)
        return values.length == 1 && Shared.with<Type, bool>(&values[0], isNominal)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn zeroArrayOfNominal(value: &Type) -> bool {
  return match & value.* {
    Type.Array {element, extent} => sameBytes(Bytes.asSlice(&extent), b"0") && Shared.with<
      Type,
      bool,
    >(&element, isNominal)
    _ => false
  }
}

fn signatureIsZeroNominalArray(answer: &Result<Answer, NoRejection>) -> bool {
  let result = signatureResult(answer)
  if let Option<Shared<Type>>.Some {value: ty} = move result {
    return Shared.with<Type, bool>(&ty, zeroArrayOfNominal)
  }
  return false
}

// Demands one fixed set of member facts and their consumers. Warm and fresh stores must agree at
// each stage: 0 is the initial source, 1 changes the field type, and 2 renames the fields, makes
// the second member present, and writes an unknown first field type.
effect fn memberFacts(
  semantic: &mut Semantic,
  geometry: &ModuleId,
  consumer: &ModuleId,
  point: &Shared<Type>,
  text: &[u8],
  stage: usize,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let mut request = Request.make()
  let identity = run Semantic.demandIdentity(&mut semantic.*, &mut request, geometry, b"Point")
  let names = run Semantic.demandMembers(&mut semantic.*, &mut request, geometry, b"Point")
  let first = run Semantic.demandMemberShape(
    &mut semantic.*,
    &mut request,
    geometry,
    b"Point",
    0,
    point,
  )
  let second = run Semantic.demandMemberShape(
    &mut semantic.*,
    &mut request,
    geometry,
    b"Point",
    1,
    point,
  )
  let origin = run Semantic.demandSignature(&mut semantic.*, &mut request, consumer, b"origin")
  let caller = run Semantic.demandBody(&mut semantic.*, &mut request, consumer, b"caller")
  let sameIdentity = run typesEqual(
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&identity, nominalResult),
    Option.some<Shared<Type>>(Shared.clone<Type>(point)),
  )
  let sameParameter = run typesEqual(
    slotOf(&origin, usize.ZERO),
    Option.some<Shared<Type>>(Shared.clone<Type>(point)),
  )
  let callerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &caller,
    checkedBody,
  )
  let mut callsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move callerBody {
    callsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, geometry, usize.ZERO)
      },
    )
  }
  let consumers = sameIdentity && sameParameter && callsLeaf && Request.hasDiscovered(
    &request,
    geometry,
  )
  if stage == 2 {
    return consumers && Shared.with<Result<Answer, NoRejection>, bool>(
      &names,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return memberNames(answer, b"height", b"depth")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &first,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.UnknownLifetime, text, b"'undeclared")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(&second, shapeFirstIsI32)
  }
  let widthOnly = Shared.with<Result<Answer, NoRejection>, bool>(
    &names,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return memberSingleName(answer, b"width")
    },
  )
  let absent = Shared.with<Result<Answer, NoRejection>, bool>(
    &second,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectedTypeApplication(answer, RejectionCode.UnknownMember)
    },
  )
  if stage == usize.ONE {
    return consumers && widthOnly && absent && Shared.with<Result<Answer, NoRejection>, bool>(
      &first,
      shapeFirstIsBool,
    )
  }
  return consumers && widthOnly && absent && Shared.with<Result<Answer, NoRejection>, bool>(
    &first,
    shapeFirstIsI32,
  )
}

effect fn memberRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let geometry = run module("geometry.silk")
  let consumer = run module("consumer.silk")
  let consumerSource = run present(
    "import geometry as Geometry\nfn origin(at: Geometry.Point) -> () { return () }\nfn caller() -> i32 { return Geometry.leaf() }\nfn unrelated() -> i32 { return 2 }\n",
  )
  let initialText = "type Element = i32\npub struct Point { width: Element }\npub fn leaf() -> i32 { return 1 }\n"
  let initialSource = run present(initialText)
  let base = run Revision.publish(&Revision.make(), &consumer, &consumerSource)
  let held = run Revision.publish(&base, &geometry, &initialSource)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let mut original = Request.make()
  let identity = run Semantic.demandIdentity(&mut semantic, &mut original, &geometry, b"Point")
  let nominal = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &identity,
    nominalResult,
  )
  let point = match move nominal {
    Option<Shared<Type>>.Some {value} => move value
    Option<Shared<Type>>.None => {
      run Testing.expect(false, "the nominal identity resolves")
      return ()
    }
  }
  let initial = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(initialText),
    usize.ZERO,
  )
  let unrelated = run Semantic.demandBody(&mut semantic, &mut original, &consumer, b"unrelated")
  run Testing.expect(
    initial && Shared.with<Result<Answer, NoRejection>, AnswerView>(&unrelated, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 2,
    "names, one field type, an absent member, and their consumers are separate facts",
  )
  let typeText = "type Element = bool\npub struct Point { width: Element }\npub fn leaf() -> i32 { return 1 }\n"
  let typeSource = run present(typeText)
  let typeRevision = run Revision.publish(&held, &geometry, &typeSource)
  Semantic.revise(&mut semantic, run Revision.copy(&typeRevision))
  let warmType = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(typeText),
    usize.ONE,
  )
  let mut unrelatedRequest = Request.make()
  let kept = run Semantic.demandBody(&mut semantic, &mut unrelatedRequest, &consumer, b"unrelated")
  let mut freshType = Semantic.make(run Revision.copy(&typeRevision))
  let coldType = run memberFacts(
    &mut freshType,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(typeText),
    usize.ONE,
  )
  run Testing.expect(
    warmType && coldType && Shared.with<Result<Answer, NoRejection>, AnswerView>(&kept, inspect).success && reused(
      Semantic.eventLog(&semantic),
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Body) == 3 && hits(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 1 && starts(Semantic.eventLog(&freshType), Family.Body) == 1,
    "a field type edit changes shape consumers while equal identity, names, and callee signature keep the caller",
  )
  let renamedText = "type Element = bool\npub struct Point {\n height: &'undeclared i32\n depth: i32\n}\npub fn leaf() -> i32 { return 1 }\n"
  let renamedSource = run present(renamedText)
  let renamedRevision = run Revision.publish(&typeRevision, &geometry, &renamedSource)
  Semantic.revise(&mut semantic, run Revision.copy(&renamedRevision))
  let warmRenamed = run memberFacts(
    &mut semantic,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(renamedText),
    2,
  )
  let mut freshRenamed = Semantic.make(run Revision.copy(&renamedRevision))
  let coldRenamed = run memberFacts(
    &mut freshRenamed,
    &geometry,
    &consumer,
    &point,
    String.utf8Bytes(renamedText),
    2,
  )
  run Testing.expect(
    warmRenamed && coldRenamed && reused(Semantic.eventLog(&semantic)) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 4,
    "renamed names, a newly present member, and a current field diagnostic reach only their consumers",
  )
  let faultText = "type Element = bool\npub struct Point {\n height: bool\n depth: i32\n}\npub fn leaf() -> i32 { return 1 }\n// This unique source allocation fails while the caller revalidates.\n"
  let faultSource = run present(faultText)
  let faultRevision = run Revision.publish(&renamedRevision, &geometry, &faultSource)
  Semantic.revise(&mut semantic, move faultRevision)
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(faultText).length,
    rejected: false,
  }
  let mut failedRequest = Request.make()
  let attempted = run Effect.result(
    Semantic.demandBody(&mut semantic, &mut failedRequest, &consumer, b"caller"),
  )
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Success {value: ignored} => false
  }
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandBody(&mut semantic, &mut retriedRequest, &consumer, b"caller")
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == 0 && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&retried, inspect).success && Request.hasDiscovered(&retriedRequest, &geometry) && reused(
      Semantic.eventLog(&semantic),
    ) == 2 && starts(Semantic.eventLog(&semantic), Family.Body) == 6,
    "a failure during caller revalidation publishes nothing, and the retry checks the current caller",
  )
  return ()
}

fn staleMemberKindRejected(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == RejectionCode.TypeArgumentKind && found.span.end > found.span.start && Bytes.asSlice(
          &found.parameterName,
        ).length > usize.ZERO && found.expectedKind == GenericKind.Lifetime && found.suppliedKind == GenericKind.Type
      },
    )
  }
  return false
}

effect fn memberKindRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("member-kind-edits.silk")
  let source = run present("struct Box<T> { value: T }\nfn applied() -> Box<bool> { return () }\n")
  let held = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let mut original = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut original, &entry, b"applied")
  let applied = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: application} = move applied {
    let changed = run present("struct Box<'life> { value: bool }\n")
    let revision = run Revision.publish(&held, &entry, &changed)
    Semantic.revise(&mut semantic, move revision)
    let mut request = Request.make()
    let shape = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Box",
      0,
      &application,
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&shape, staleMemberKindRejected),
      "a stale application reports the changed generic argument kind at a source span",
    )
  } else {
    run Testing.expect(false, "the original generic application resolves")
  }
  return ()
}

fn isParameter(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Parameter {ordinal, ..} => ordinal == usize.ZERO
    _ => false
  }
}

fn typeAt(answer: &Result<Answer, NoRejection>, slot: usize) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        if slot == usize.MAX {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&signature.result))
        }
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        if slot < parameters.length {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[slot]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

// A parameter's type, or the result's type when `slot` is `usize.MAX`.
fn slotOf(answer: &Shared<Result<Answer, NoRejection>>, slot: usize) -> Option<Shared<Type>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
      return typeAt(value, slot)
    },
  )
}

effect fn typesEqual(first: Option<Shared<Type>>, second: Option<Shared<Type>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: from} = move first {
    if let Option<Shared<Type>>.Some {value: to} = move second {
      return run Type.equalsShared(&from, &to)
    }
  }
  return false
}

effect fn slotsEqual(answer: &Shared<Result<Answer, NoRejection>>, left: usize, right: usize) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run typesEqual(slotOf(answer, left), slotOf(answer, right))
}

effect fn answersEqual(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
  slot: usize,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run typesEqual(slotOf(first, slot), slotOf(second, slot))
}

fn parameterCountOf(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length(&signature.parameters)
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

fn lifetimeCountOf(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length(
        &signature.lifetimeParameters,
      )
      _ => usize.ZERO
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.ZERO
  }
}

effect fn resultIsReflexive(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run slotsEqual(answer, usize.MAX, usize.MAX)
}

fn signatureHasOrdinaryBinder(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        return binders.length == 1 && parameters.length == 1 && Shared.with<Type, bool>(
          &binders[usize.ZERO],
          isParameter,
        ) && Shared.with<Type, bool>(&parameters[usize.ZERO], isParameter) && Shared.with<
          Type,
          bool,
        >(&signature.result, isParameter)
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn resultEquals(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run answersEqual(first, second, usize.MAX)
}

effect fn signatureReferencesAgree(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run slotsEqual(answer, usize.ZERO, usize.MAX)
}

effect fn signatureArgumentsAgree(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(answer, parameterCountOf) != 2 {
    return false
  }
  if !run slotsEqual(answer, usize.ZERO, usize.ONE) {
    return false
  }
  return run slotsEqual(answer, usize.ZERO, usize.MAX)
}

effect fn signatureArgumentsDiffer(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(answer, parameterCountOf) != 2 || Shared.with<
    Result<Answer, NoRejection>,
    usize,
  >(answer, lifetimeCountOf) != 2 {
    return false
  }
  return !run slotsEqual(answer, usize.ZERO, usize.ONE)
}

fn signatureSucceeded(answer: &Result<Answer, NoRejection>) -> bool {
  return match move signatureResult(answer) {
    Option<Shared<Type>>.Some {value: _} => true
    Option<Shared<Type>>.None => false
  }
}

fn rejectedTypeApplication(answer: &Result<Answer, NoRejection>, code: RejectionCode) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == code && found.span.end > found.span.start
      },
    )
  }
  return false
}

fn wrongTypeArity(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(
      &value,
      fn(found: &Rejection) -> bool {
        return found.code == RejectionCode.TypeArity && found.expected == 2 && found.supplied == 1 && found.span.end > found.span.start
      },
    )
  }
  return false
}

fn nameIsA(value: &Bytes) -> bool {
  let name = Bytes.asSlice(value)
  return name.length == 1 && name[usize.ZERO] == 65
}

fn isWrongTypeKind(found: &Rejection) -> bool {
  if found.code != RejectionCode.TypeArgumentKind || found.span.end <= found.span.start {
    return false
  }
  return nameIsA(&found.parameterName) && found.expectedKind == GenericKind.Type && found.suppliedKind == GenericKind.Lifetime
}

fn wrongTypeKind(answer: &Result<Answer, NoRejection>) -> bool {
  let diagnostic = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    return Shared.with<Rejection, bool>(&value, isWrongTypeKind)
  }
  return false
}

fn hasTypeLookup(answer: &Result<Answer, NoRejection>, expected: Family) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut at = usize.ZERO
      while at < dependencies.length {
        if dependencies[at].family == expected {
          return true
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn nominalOwnedBy(resolved: &Type, module: &ModuleId) -> bool {
  return match & resolved.* {
    Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
    _ => false
  }
}

fn signatureOwnedBy(answer: &Shared<Result<Answer, NoRejection>>, module: &ModuleId) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(
      &value,
      fn(resolved: &Type) -> bool {
        return nominalOwnedBy(resolved, module)
      },
    )
  }
  return false
}

fn isI32(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.Primitive {name} => {
      let bytes = Bytes.asSlice(&name)
      return bytes.length == 3 && bytes[0] == 105 && bytes[1] == 51 && bytes[2] == 50
    }
    _ => false
  }
}

fn signatureIsI32(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(&value, isI32)
  }
  return false
}

fn signatureIsBool(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    answer,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    return Shared.with<Type, bool>(&value, isBool)
  }
  return false
}

fn importedSignatureHasDependencies(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut selected = false
      let mut namespace = false
      let mut publicName = false
      let mut alias = false
      let mut identity = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        let item = &dependencies[at]
        if item.family == Family.Import {
          match & item.member {
            Option<usize>.Some {value: ordinal} => {
              if ordinal == usize.ZERO {
                selected = true
              }
            }
            Option<usize>.None => {
              namespace = true
            }
          }
        }
        if item.family == Family.Name && item.external {
          publicName = true
        }
        if item.family == Family.Alias {
          alias = true
        }
        if item.family == Family.Identity {
          identity = true
        }
        at = at + usize.ONE
      }
      return selected && namespace && publicName && alias && identity
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn reads(events: &[SourceEvent], module: &ModuleId) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == SourceEventKind.SourceRead && ModuleId.equals(&events[at].module, module) {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn starts(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Start && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn hits(events: &[SemanticEvent], family: Family) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Hit && events[at].family == family {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn reused(events: &[SemanticEvent]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].kind == EventKind.Reuse && events[at].family == Family.Body {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

fn bodyHasCurrentSource(answer: &Result<Answer, NoRejection>, revision: &Revision) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body: _, source}} => Shared.with<Observation, bool>(
        &source,
        fn(observed: &Observation) -> bool {
          return Observation.matches(observed, revision)
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option.some<Bytes>(run Bytes.copy(String.utf8Bytes(text)))
}

effect fn lazyClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let missing = run module("missing.silk")
  let source = run present(
    "import missing as Ghost\ntype Broken = Unknown\nfn entry() -> i32 { return unknown() }\nfn missing(value: Ghost.Thing) -> i32 { return 0 }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let first = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(
    first.success && first.sources == 1,
    "written signature needs entry source only",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &missing,
    ) == 0,
    "unused import target stays unread",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 0,
    "unused import and bad alias stay undemanded",
  )
  let broken = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Broken")
  let rejected = Shared.with<Result<Answer, NoRejection>, AnswerView>(&broken, inspect)
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &broken,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      !rejected.success && Shared.with<Rejection, bool>(&value, isUnknownName) && rejected.dependencies > 0 && rejected.sources == 1,
      "demanded bad alias records negative name dependency",
    )
  } else {
    run Testing.expect(false, "demanded bad alias has a typed rejection")
  }
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let hit = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    hit.success && hit.sources == first.sources && reads(Semantic.sourceEvents(&semantic), &entry) == 1,
    "memo hit retains evidence without another source read",
  )
  let demanded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"missing")
  let missingDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &demanded,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move missingDiagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule),
      "demanded import target absence is anchored",
    )
  } else {
    run Testing.expect(false, "demanded missing import has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &missing) == 1,
    "missing target is read only on demand",
  )
  return ()
}

test effect fn defersUnusedDeclarationsAndReusesWrittenSignature() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lazyClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let librarySource = run present(
    "pub struct Thing { field: &'undeclared i32 }\npub type PublicAlias = Thing\n",
  )
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let entrySource = run present(
    "import library as Library { PublicAlias as Alias }\nfn entry(value: Alias) -> Library.Thing { return move value }\n",
  )
  let revision = run Revision.publish(&first, &entry, &entrySource)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, AnswerView>(&signature, inspect)
  run Testing.expect(result.success, "imported alias resolves from written signature")
  run Testing.expect(result.dependencies > 0, "imported alias records nested demands")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&signature, importedSignatureHasDependencies),
    "signature keeps selected import ordinal, namespace, public name, alias, and identity edges",
  )
  run Testing.expect(result.sources == 2, "signature records each directly inspected source")
  let writtenResult = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &signature,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move writtenResult {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isNominal),
      "alias result retains nominal identity",
    )
  } else {
    run Testing.expect(false, "signature has a written result")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "import target is read only when alias is used",
  )
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Import) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Alias,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Identity) == 1,
    "hybrid namespace and selected alias share nominal identity",
  )
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let cached = Shared.with<Result<Answer, NoRejection>, AnswerView>(&again, inspect)
  run Testing.expect(
    cached.success && cached.dependencies == result.dependencies && cached.sources == result.sources,
    "imported signature memo hit keeps fact and dependency evidence",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &entry) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &library,
    ) == 1,
    "imported signature memo hit does not reread sources",
  )
  let priorSignatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let priorSignatureHits = hits(Semantic.eventLog(&semantic), Family.Signature)
  let mut fresh = Request.make()
  run Testing.expect(
    Request.rootCount(&fresh) == 0 && !Request.hasDiscovered(&fresh, &library),
    "fresh request has no inherited roots or discoveries",
  )
  let replayed = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && Request.rootCount(
      &fresh,
    ) == 1 && Request.hasRoot(&fresh, Family.Signature, &entry, b"entry") && Request.hasDiscovered(
      &fresh,
      &entry,
    ) && Request.hasDiscovered(&fresh, &library) && Request.hasDemand(
      &fresh,
      Family.Alias,
      &library,
    ) && Request.hasDemand(&fresh, Family.Identity, &library),
    "fresh request replays imported discovery and nested demand evidence",
  )
  run Testing.expect(
    priorSignatureStarts == starts(Semantic.eventLog(&semantic), Family.Signature) && hits(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == priorSignatureHits + 1 && reads(Semantic.sourceEvents(&semantic), &library) == 1,
    "replay emits only the actual root hit and no new provider read",
  )
  return ()
}

test effect fn resolvesImportedAliasWithoutFieldsOrBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn cycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present(
    "type A = B\ntype B = A\nfn f() -> i32 { return g() }\nfn g() -> i32 { return f() }\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let function = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"f")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&function, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1,
    "recursive bodies do not demand another signature",
  )
  let alias = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"A")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &alias,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "alias cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "alias cycle has a declaration path",
    )
  } else {
    run Testing.expect(false, "alias cycle has a typed rejection")
  }
  let other = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"B")
  let mut reversed = Semantic.make(move revision)
  let mut reversedRequest = Request.make()
  let reversedOther = run Semantic.demandAlias(&mut reversed, &mut reversedRequest, &entry, b"B")
  let reversedAlias = run Semantic.demandAlias(&mut reversed, &mut reversedRequest, &entry, b"A")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &alias,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return cycleAnchoredAt(answer, 9)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &other,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return cycleAnchoredAt(answer, 20)
      },
    ) && rotatedPair(&alias, &other) && sameCycleAnswers(&alias, &reversedAlias) && sameCycleAnswers(
      &other,
      &reversedOther,
    ),
    "each alias cycle member rejects at its own reference in either demand order",
  )
  return ()
}

test effect fn separatesSignatureRecursionFromAliasCycles() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn visibilityClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let source = run present(
    "struct Hidden { field: i32 }\npub fn reveal() -> Hidden { return () }\ntype Clash = i32\nstruct Clash {}\npub type HiddenExact = typeof(reveal)\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let revealed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"reveal")
  let privateType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &revealed,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move privateType {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isPrivateExposure),
      "public written signature rejects private nominal type at its use",
    )
  } else {
    run Testing.expect(false, "private type exposure has a typed rejection")
  }
  let clash = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Clash")
  let collision = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &clash,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move collision {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCollision),
      "complete name bucket rejects collision without winner",
    )
  } else {
    run Testing.expect(false, "colliding name has a typed rejection")
  }
  let hiddenExact = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"HiddenExact")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &hiddenExact,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isPrivateExposure),
      "exact representations cannot bypass a rejected public callable signature",
    )
  } else {
    run Testing.expect(false, "exact representation has a typed rejection")
  }
  return ()
}

test effect fn rejectsPrivateExposureAndCollisions() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run visibilityClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn namedCallableRepresentationsKeepExactIdentity() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("named-representations.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "fn first(value: i32) -> i32 { return value }\nfn second(value: i32) -> i32 { return value }\ntype First = typeof(first)\ntype FirstAgain = typeof(first)\ntype Second = typeof(second)\ntype Use = fn(i32) -> i32\npub type Leaked = typeof(first)\nfn generic<T>(value: T) -> T { return move value }\ntype Open = typeof(generic)\ntype Closed = typeof(generic<i32>)\nfn scoped<T>() -> typeof(generic<T>) { return () }\nservice Clock {}\nfn rowItem<?R>(value: i32) -> i32 { return value }\ntype RowOnce = typeof(rowItem<&Clock>)\ntype RowRepeated = typeof(rowItem<&Clock | &Clock>)\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let first = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"First")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let again = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"FirstAgain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Second")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let useContract = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Use")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let closed = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Closed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let scoped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"scoped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let open = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Open")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leaked = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"Leaked")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rowOnce = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"RowOnce")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rowRepeated = run Semantic.demandAlias(&mut semantic, &mut request, &entry, b"RowRepeated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &first,
    nominalResult,
  )
  let againType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &again,
    nominalResult,
  )
  let secondType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &second,
    nominalResult,
  )
  let useType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &useContract,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: firstValue} = move firstType {
    if let Option<Shared<Type>>.Some {value: againValue} = move againType {
      if let Option<Shared<Type>>.Some {value: secondValue} = move secondType {
        let repeated = run Type.equalsShared(&firstValue, &againValue)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let distinct = run Type.equalsShared(&firstValue, &secondValue)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut separateUse = false
        if let Option<Shared<Type>>.Some {value: callableUse} = move useType {
          let sameUse = run Type.equalsShared(&firstValue, &callableUse)
            |> Effect.provideMut<Allocator>(&mut allocator)
          separateUse = !sameUse
        }
        run Testing.expect(
          repeated && !distinct && separateUse,
          "named items retain distinct exact identities despite identical callable signatures",
        )
      } else {
        run Testing.expect(false, "second item has an exact representation")
      }
    } else {
      run Testing.expect(false, "repeated item has an exact representation")
    }
  } else {
    run Testing.expect(false, "first item has an exact representation")
  }
  let normalizedRows = run typesEqual(
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&rowOnce, nominalResult),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &rowRepeated,
      nominalResult,
    ),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    normalizedRows && Shared.with<Result<Answer, NoRejection>, AnswerView>(&closed, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&scoped, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &open,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidExactRepresentation)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &leaked,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.PrivateTypeExposure)
      },
    ),
    "typeof normalizes row arguments, requires full specialization, and keeps private item identity inside its module",
  )
  return ()
}

test effect fn opaqueResultContractsKeepProducerFamiliesDistinct() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("opaque-results.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "fn make() -> some<F: fn<'static>(i32) -> i32> F { return () }\nfn other() -> some<F: fn<'static>(i32) -> i32> F { return () }\nfn nested() -> some<F: fn<'static>(i32) -> i32> Effect<'static; F> { return () }\nfn unused() -> some<F: fn<'static>(i32) -> i32> i32 { return 0 }\ninterface Maker { fn absent() -> some<F: fn<'static>(i32) -> i32> F }\nstruct Hidden {}\npub fn leak() -> some<F: fn<'static>(Hidden) -> i32> F { return () }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let made = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"make")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"other")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unused = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unused")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bodyless = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Maker", b"absent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leak = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"leak")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &made,
    signatureResult,
  )
  let otherType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &other,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: firstResult} = move firstType {
    if let Option<Shared<Type>>.Some {value: otherResult} = move otherType {
      let exact = Shared.with<Type, bool>(
        &firstResult,
        fn(ty: &Type) -> bool {
          return match & ty.* {
            Type.OpaqueRepresentation {..} => true
            _ => false
          }
        },
      )
      let sameFamily = run Type.equalsShared(&firstResult, &otherResult)
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(exact && !sameFamily, "each opaque producer owns a distinct representation")
    } else {
      run Testing.expect(false, "other producer has an opaque result contract")
    }
  } else {
    run Testing.expect(false, "first producer has an opaque result contract")
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&nested, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &unused,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidOpaqueResult)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &bodyless,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidOpaqueResult)
      },
    ),
    "an opaque binder may appear inside the result, but cannot be unused or bodyless",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &leak,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.PrivateTypeExposure)
      },
    ),
    "an opaque result cannot hide a private type in its public use contract",
  )
  return ()
}

effect fn importCycleClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let firstModule = run module("first.silk")
  let secondModule = run module("second.silk")
  let firstSource = run present("pub import second { Alias }\n")
  let first = run Revision.publish(&Revision.make(), &firstModule, &firstSource)
  let secondSource = run present("pub import first { Alias }\n")
  let second = run Revision.publish(&first, &secondModule, &secondSource)
  let entrySource = run present("import first { Alias }\nfn entry() -> Alias { return () }\n")
  let entered = run Revision.publish(&second, &entry, &entrySource)
  let otherModule = run module("other.silk")
  let otherSource = run present("import second { Alias }\nfn other() -> Alias { return () }\n")
  let revision = run Revision.publish(&entered, &otherModule, &otherSource)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let signature = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"entry")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &signature,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isCycle),
      "public import-name cycle has a typed code",
    )
    run Testing.expect(
      Shared.with<Rejection, usize>(&value, cyclePathLength) == 3,
      "public import-name cycle has a declaration path",
    )
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, importCycleAnchor),
      "public import-name cycle is anchored",
    )
  } else {
    run Testing.expect(false, "public import-name cycle has a typed rejection")
  }
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &firstModule) == 1 && reads(
      Semantic.sourceEvents(&semantic),
      &secondModule,
    ) == 1,
    "import-name cycle opens each target once",
  )
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &otherModule, b"other")
  let mut reversed = Semantic.make(move revision)
  let mut reversedRequest = Request.make()
  let reversedOther = run Semantic.demandSignature(
    &mut reversed,
    &mut reversedRequest,
    &otherModule,
    b"other",
  )
  let reversedEntry = run Semantic.demandSignature(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"entry",
  )
  run Testing.expect(
    rotatedPair(&signature, &other) && sameCycleAnswers(&signature, &reversedEntry) && sameCycleAnswers(
      &other,
      &reversedOther,
    ),
    "consumers entering an import-name cycle at either member agree in either demand order",
  )
  return ()
}

test effect fn rejectsPublicImportNameCycle() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run importCycleClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn revisionReuseClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let unrelated = run module("unrelated.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let b = run present("pub type Alias = i32\n")
  let first = run Revision.publish(&Revision.make(), &entry, &a)
  let held = run Revision.publish(&first, &library, &b)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let mut coldRequest = Request.make()
  let cold = run Semantic.demandSignature(&mut semantic, &mut coldRequest, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&cold, inspect).success && Request.hasDiscovered(
      &coldRequest,
      &library,
    ),
    "cold signature discovers its imported alias source",
  )
  let startsBefore = starts(Semantic.eventLog(&semantic), Family.Signature)
  let c = run present("fn changed() -> i32 { return 3 }\n")
  let irrelevant = run Revision.publish(&held, &unrelated, &c)
  Semantic.revise(&mut semantic, move irrelevant)
  let mut fresh = Request.make()
  let warm = run Semantic.demandSignature(&mut semantic, &mut fresh, &entry, b"entry")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&warm, inspect).success && Request.hasDiscovered(
      &fresh,
      &library,
    ) && !Request.hasDiscovered(&fresh, &unrelated) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == startsBefore && hits(Semantic.eventLog(&semantic), Family.Signature) == 1,
    "unrelated revision keeps the completed signature and replays only its discoveries",
  )
  let changed = run present("pub type Alias = bool\n")
  let relevant = run Revision.publish(&held, &library, &changed)
  Semantic.revise(&mut semantic, move relevant)
  let mut revised = Request.make()
  let updated = run Semantic.demandSignature(&mut semantic, &mut revised, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &updated,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isBool) && starts(
        Semantic.eventLog(&semantic),
        Family.Signature,
      ) == startsBefore + 1,
      "changed imported alias header recomputes the transitive signature",
    )
  } else {
    run Testing.expect(false, "recomputed signature has a written result")
  }
  return ()
}

test effect fn reusesUnrelatedRevisionAndInvalidatesImportedHeader() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run revisionReuseClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn negativeRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("entry.silk")
  let library = run module("library.silk")
  let a = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
  let held = run Revision.publish(&Revision.make(), &entry, &a)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let mut firstRequest = Request.make()
  let missing = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &entry, b"entry")
  let diagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &missing,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move diagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule) && !Request.hasDiscovered(
        &firstRequest,
        &library,
      ),
      "absent imported path records a typed rejection without a present discovery",
    )
  } else {
    run Testing.expect(false, "absent imported path rejects")
  }
  let b = run present("pub type Other = i32\n")
  let appeared = run Revision.publish(&held, &library, &b)
  Semantic.revise(&mut semantic, move appeared)
  let mut secondRequest = Request.make()
  let missingName = run Semantic.demandSignature(
    &mut semantic,
    &mut secondRequest,
    &entry,
    b"entry",
  )
  let nameDiagnostic = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &missingName,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move nameDiagnostic {
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isUnknownMember) && Request.hasDiscovered(
        &secondRequest,
        &library,
      ),
      "formerly absent path is discovered and its absent-name bucket rejects",
    )
  } else {
    run Testing.expect(false, "present imported module with absent name rejects")
  }
  let named = run present("pub type Other = i32\npub type Alias = bool\n")
  let namedRevision = run Revision.publish(&held, &library, &named)
  Semantic.revise(&mut semantic, move namedRevision)
  let mut namedRequest = Request.make()
  let resolved = run Semantic.demandSignature(&mut semantic, &mut namedRequest, &entry, b"entry")
  let result = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &resolved,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(
      Shared.with<Type, bool>(&value, isBool) && Request.hasDiscovered(&namedRequest, &library),
      "new imported name invalidates the transitive negative bucket",
    )
  } else {
    run Testing.expect(false, "new imported name resolves")
  }
  let shifted = run present(
    "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
  )
  let absentAgain = run Revision.publish(&held, &entry, &shifted)
  Semantic.revise(&mut semantic, move absentAgain)
  let mut shiftedRequest = Request.make()
  let newFailure = run Semantic.demandSignature(
    &mut semantic,
    &mut shiftedRequest,
    &entry,
    b"entry",
  )
  let anchored = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(
    &newFailure,
    rejection,
  )
  if let Option<Shared<Rejection>>.Some {value} = move anchored {
    let offset = Shared.with<Rejection, usize>(&value, spanStart)
    run Testing.expect(
      Shared.with<Rejection, bool>(&value, isMissingModule) && offset == 17 && String.utf8Bytes(
        "// prefix\nimport library { Alias }\nfn entry() -> Alias { return () }\n",
      )[offset] == 108,
      "recomputed rejection span points into exact changed entry bytes",
    )
  } else {
    run Testing.expect(false, "changed entry bytes produce a new anchored rejection")
  }
  return ()
}

test effect fn invalidatesNegativePathAndNameAndReanchorsDiagnostic() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run negativeRevisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedFailureRetryClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut system)
  let entrySource = run present("import library { Alias }\nfn entry() -> Alias { return () }\n")
    |> Effect.provideMut<Allocator>(&mut system)
  let libraryText = "pub type Alias = bool\n// This unique source allocation is rejected inside the nested import.\n"
  let librarySource = run present(libraryText)
    |> Effect.provideMut<Allocator>(&mut system)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let revision = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut semantic = Semantic.make(move revision)
  let mut failedRequest = Request.make()
  let mut fault = NestedFailureAllocator {
    targetBytes: String.utf8Bytes(libraryText).length,
    rejected: false,
  }
  let attempted = run Effect.result(
    Semantic.demandSignature(&mut semantic, &mut failedRequest, &entry, b"entry"),
  )
    |> Effect.provideMut<Allocator>(&mut fault)
  let failed = match move attempted {
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Failure {error} => match move error {
      OutOfMemoryError {} => true
      _ => false
    }
    Result<
      Shared<Result<Answer, NoRejection>>,
      Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError,
    >.Success {value: ignored} => false
  }
  run Testing.expect(
    failed && fault.rejected && Request.rootCount(&failedRequest) == 0 && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 1 && starts(Semantic.eventLog(&semantic), Family.Import) > 0,
    "nested imported-signature provider failure publishes no root",
  )
  let mut retriedRequest = Request.make()
  let retried = run Semantic.demandSignature(&mut semantic, &mut retriedRequest, &entry, b"entry")
    |> Effect.provideMut<Allocator>(&mut system)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&retried, inspect).success && Request.rootCount(
      &retriedRequest,
    ) == 1 && Request.hasDiscovered(&retriedRequest, &library) && starts(
      Semantic.eventLog(&semantic),
      Family.Signature,
    ) == 2,
    "retry recomputes the same signature and publishes complete imported evidence",
  )
  return ()
}

test effect fn retriesNestedImportedSignatureAfterTypedFailure() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  return run nestedFailureRetryClaims()
}

test effect fn canonicalTypeIdentityKeepsNominalOwners() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let left = run module("left.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run module("right.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leftSource = run present(
    "struct Item {}\ntype Alias = Item\nfn original() -> Item { return () }\nfn aliased() -> Alias { return () }\nfn count() -> i32 { return 1 }\nfn flag() -> bool { return true }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rightSource = run present("struct Item {}\nfn original() -> Item { return () }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &left, &leftSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Revision.publish(&first, &right, &rightSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move held)
  let mut request = Request.make()
  let original = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"original")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliased = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"aliased")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run Semantic.demandSignature(&mut semantic, &mut request, &right, b"original")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let count = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"count")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let flag = run Semantic.demandSignature(&mut semantic, &mut request, &left, b"flag")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    signatureOwnedBy(&original, &left) && signatureOwnedBy(&aliased, &left) && !signatureOwnedBy(
      &other,
      &left,
    ) && signatureOwnedBy(&other, &right) && signatureIsI32(&count) && !signatureIsBool(&count) && signatureIsBool(
      &flag,
    ) && !signatureIsI32(&flag),
    "source signatures keep nominal module owners and distinct scalar kinds",
  )
  return ()
}

fn onSignature(answer: &Result<Answer, NoRejection>, check: fn(&Signature) -> bool) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => check(&signature)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn rowsEqual(left: &Shared<Row>, right: &Shared<Row>) -> bool
! OutOfMemoryError
? &mut Allocator {
  return run Row.equalsShared(left, right)
}

fn rowSize(row: &Shared<Row>) -> usize {
  return Shared.with<Row, usize>(
    row,
    fn(value: &Row) -> usize {
      return Vector.length<Requirement>(&value.entries) + Vector.length(&value.parameters)
    },
  )
}

fn failureOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Type>>(
        Shared.clone<Type>(&signature.failure),
      )
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn requirementsOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Row>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Option.some<Shared<Row>>(
        Shared.clone<Row>(&signature.requirements),
      )
      _ => Option.none<Shared<Row>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Row>>()
  }
}

effect fn channelsEqual(
  failure: Option<Shared<Type>>,
  requirements: Option<Shared<Row>>,
  otherFailure: Option<Shared<Type>>,
  otherRequirements: Option<Shared<Row>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !run typesEqual(move failure, move otherFailure) {
    return false
  }
  if let Option<Shared<Row>>.Some {value: row} = move requirements {
    if let Option<Shared<Row>>.Some {value: otherRow} = move otherRequirements {
      return run rowsEqual(&row, &otherRow)
    }
  }
  return false
}

effect fn sameChannels(
  first: &Shared<Result<Answer, NoRejection>>,
  second: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run channelsEqual(
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(first, failureOf),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(first, requirementsOf),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(second, failureOf),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(second, requirementsOf),
  )
}

fn effectFailure(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Effect {failure, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&failure))
    _ => Option.none<Shared<Type>>()
  }
}

fn effectSuccess(value: &Type) -> Option<Shared<Type>> {
  return match & value.* {
    Type.Effect {success, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&success))
    _ => Option.none<Shared<Type>>()
  }
}

fn effectRequirements(value: &Type) -> Option<Shared<Row>> {
  return match & value.* {
    Type.Effect {requirements, ..} => Option.some<Shared<Row>>(Shared.clone<Row>(&requirements))
    _ => Option.none<Shared<Row>>()
  }
}

fn effectEnvironment(value: &Type) -> Option<Shared<Intersection>> {
  return match & value.* {
    Type.Effect {environment, ..} => Option.some<Shared<Intersection>>(
      Shared.clone<Intersection>(&environment),
    )
    _ => Option.none<Shared<Intersection>>()
  }
}

// A written `Effect<...>` parameter has the channels of the declared effect function.
effect fn pendingMatches(
  pending: &Shared<Result<Answer, NoRejection>>,
  declared: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let parameter = slotOf(pending, usize.ZERO)
  if let Option<Shared<Type>>.Some {value} = move parameter {
    return run channelsEqual(
      Shared.with<Type, Option<Shared<Type>>>(&value, effectFailure),
      Shared.with<Type, Option<Shared<Row>>>(&value, effectRequirements),
      Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(declared, failureOf),
      Shared.with<Result<Answer, NoRejection>, Option<Shared<Row>>>(declared, requirementsOf),
    )
  }
  return false
}

fn modeOf(value: &Type) -> usize {
  let mode = match & value.* {
    Type.Callable {mode, ..} => mode
    Type.Effect {mode, ..} => mode
    _ => {
      return usize.ZERO
    }
  }
  return match mode {
    CallableMode.Shared => usize.ONE
    CallableMode.Mutable => 2
    CallableMode.Once => 3
  }
}

fn firstParameterMode(signature: &Signature) -> usize {
  let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
  return Shared.with<Type, usize>(&parameters[usize.ZERO], modeOf)
}

fn firstModeIs(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return firstParameterMode(signature) == expected
    },
  )
}

fn environmentWith(first: &Intersection, right: &Shared<Intersection>) -> bool {
  return Shared.with<Intersection, bool>(
    right,
    fn(second: &Intersection) -> bool {
      return Intersection.equals(first, second)
    },
  )
}

// The consumed and returned Effects hold distinct environment handles.
fn environmentsEqual(left: &Shared<Intersection>, right: &Shared<Intersection>) -> bool {
  return Shared.with<Intersection, bool>(
    left,
    fn(first: &Intersection) -> bool {
      return environmentWith(first, right)
    },
  )
}

fn rowBinderAndConsumed(signature: &Signature) -> bool {
  return Vector.length(&signature.rowParameters) == usize.ONE && firstParameterMode(signature) == 3
}

effect fn environmentsSame(left: &Shared<Type>, right: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let first = Shared.with<Type, Option<Shared<Intersection>>>(left, effectEnvironment)
  let second = Shared.with<Type, Option<Shared<Intersection>>>(right, effectEnvironment)
  if let Option<Shared<Intersection>>.Some {value: from} = move first {
    if let Option<Shared<Intersection>>.Some {value: to} = move second {
      return environmentsEqual(&from, &to)
    }
  }
  return false
}

// Mode aside, the consumed parameter and the returned Effect share environment and channels.
effect fn sharesEffectParts(input: &Shared<Type>, output: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if !run environmentsSame(input, output) {
    return false
  }
  let success = Shared.with<Type, Option<Shared<Type>>>(input, effectSuccess)
  let otherSuccess = Shared.with<Type, Option<Shared<Type>>>(output, effectSuccess)
  if !run typesEqual(move success, move otherSuccess) {
    return false
  }
  let row = Shared.with<Type, Option<Shared<Row>>>(input, effectRequirements)
  if let Option<Shared<Row>>.Some {value: requirements} = &row {
    if rowSize(&requirements) != usize.ONE {
      return false
    }
  }
  if !run channelsEqual(
    Shared.with<Type, Option<Shared<Type>>>(input, effectFailure),
    move row,
    Shared.with<Type, Option<Shared<Type>>>(output, effectFailure),
    Shared.with<Type, Option<Shared<Row>>>(output, effectRequirements),
  ) {
    return false
  }
  return !run Type.equalsShared(input, output)
}

fn firstParameterOf(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let parameters = Vector.asSlice<Shared<Type>>(&signature.parameters)
        return Option.some<Shared<Type>>(Shared.clone<Type>(&parameters[usize.ZERO]))
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn unionSize(value: &Type) -> usize {
  return match & value.* {
    Type.Union {members} => Vector.length<Shared<Type>>(&members)
    _ => usize.ZERO
  }
}

fn effectRowSize(value: &Type) -> usize {
  return match & value.* {
    Type.Effect {requirements, ..} => rowSize(&requirements)
    _ => usize.ZERO
  }
}

// `Pair<Box<i32>>` places one `Box<i32>` handle both as a union member and inside `Box<Box<i32>>`;
// `Stored` does the same inside two generic service keys.
effect fn substitutedShapes(
  control: &Shared<Result<Answer, NoRejection>>,
  nested: &Shared<Result<Answer, NoRejection>>,
  again: &Shared<Result<Answer, NoRejection>>,
  stored: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    control,
    firstParameterOf,
  )
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    nested,
    firstParameterOf,
  )
  let third = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    again,
    firstParameterOf,
  )
  let fourth = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    stored,
    firstParameterOf,
  )
  if let Option<Shared<Type>>.Some {value: plain} = move first {
    if let Option<Shared<Type>>.Some {value: boxed} = move second {
      if let Option<Shared<Type>>.Some {value: repeated} = move third {
        if let Option<Shared<Type>>.Some {value: effectType} = move fourth {
          let distinct = !run Type.equalsShared(&plain, &boxed)
          let same = run Type.equalsShared(&boxed, &repeated)
          return Shared.with<Type, usize>(&plain, unionSize) == 2 && Shared.with<Type, usize>(
            &boxed,
            unionSize,
          ) == 2 && distinct && same && Shared.with<Type, usize>(&effectType, effectRowSize) == 2
        }
      }
    }
  }
  return false
}

fn rejectsAt(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return rejectedTypeApplication(value, code)
    },
  )
}

// A rejection with `code` whatever its anchor, as for an identity with no written site left.
fn rejectsWith(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code
      },
    )
  }
  return false
}

// Elided and spelled invocation binders give the same callable contract across declarations.
effect fn sameFirstParameters(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run answersEqual(left, right, usize.ZERO)
}

// `'a & 'b` equals `'b & 'static & 'a`; `'a & 'a` equals `'a` and differs from the pair.
effect fn environmentsNormalize(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if Shared.with<Result<Answer, NoRejection>, usize>(answer, parameterCountOf) != 4 {
    return false
  }
  let pair = run slotsEqual(answer, usize.ZERO, usize.ONE)
  let single = run slotsEqual(answer, 2, 3)
  let different = !run slotsEqual(answer, usize.ZERO, 3)
  return pair && single && different
}

fn writtenEnvironment(signature: &Signature) -> bool {
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  let contents = declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Contents {..} => true
    _ => false
  }
  return contents && match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members) == usize.ONE
    Option<Intersection>.None => false
  }
}

fn retainsEnvironment(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, writtenEnvironment)
}

fn representationBound(signature: &Signature) -> bool {
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Represents {contract, ..} => Shared.with<Type, usize>(&contract, modeOf) == usize.ONE
    _ => false
  }
}

fn representsCallable(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, representationBound)
}

fn onContract(answer: &Result<Answer, NoRejection>, check: fn(&Contract) -> bool) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => check(&contract)
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn conformsOnly(contract: &Contract) -> bool {
  let declared = Vector.asSlice<Constraint>(&contract.constraints)
  return Vector.length(&contract.typeParameters) == usize.ONE && declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Conforms {..} => true
    _ => false
  }
}

fn sortedContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, conformsOnly)
}

fn generatedBoundLifetime(contract: &Contract) -> bool {
  let constraints = Vector.asSlice<Constraint>(&contract.constraints)
  return Vector.length<Shared<Type>>(&contract.typeParameters) == usize.ONE && Vector.length<Shared<Lifetime>>(
    &contract.lifetimeParameters,
  ) == usize.ONE && constraints.length == usize.ONE && match & constraints[usize.ZERO] {
    Constraint.Conforms {..} => true
    _ => false
  }
}

fn datedBoxContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, generatedBoundLifetime)
}

fn rowBinderOnly(contract: &Contract) -> bool {
  return Vector.length(&contract.rowParameters) == usize.ONE && Vector.length(
    &contract.typeParameters,
  ) == usize.ONE && Vector.length(&contract.constraints) == usize.ZERO
}

fn loadContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, rowBinderOnly)
}

fn representationOnly(contract: &Contract) -> bool {
  let declared = Vector.asSlice<Constraint>(&contract.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Represents {..} => true
    _ => false
  }
}

fn parserContract(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, representationOnly)
}

// `Loaded<? &Clock>` splices the supplied row beside the alias's own `&Logger` entry.
fn splicedRow(answer: &Result<Answer, NoRejection>) -> bool {
  let parameter = firstParameterOf(answer)
  if let Option<Shared<Type>>.Some {value} = move parameter {
    return Shared.with<Type, usize>(&value, effectRowSize) == 2
  }
  return false
}

effect fn sameResults(
  left: &Shared<Result<Answer, NoRejection>>,
  right: &Shared<Result<Answer, NoRejection>>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  return run answersEqual(left, right, usize.MAX)
}

fn environmentSizeOf(signature: &Signature) -> usize {
  return match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members)
    Option<Intersection>.None => usize.MAX
  }
}

fn environmentMembers(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => environmentSizeOf(&signature)
      _ => usize.MAX - usize.ONE
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX - usize.ONE
  }
}

fn staticSignatureEnvironment(signature: &Signature) -> bool {
  return match & signature.environment {
    Option<Intersection>.Some {value} => Vector.length(&value.members) == usize.ZERO
    Option<Intersection>.None => false
  }
}

fn staticEnvironment(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(answer, staticSignatureEnvironment)
}

fn contentsOnly(contract: &Contract) -> bool {
  let declared = Vector.asSlice<Constraint>(&contract.constraints)
  return declared.length == usize.ONE && match & declared[usize.ZERO] {
    Constraint.Contents {..} => true
    _ => false
  }
}

fn lifetimeBoundOnly(answer: &Result<Answer, NoRejection>) -> bool {
  return onContract(answer, contentsOnly)
}

fn constraintCount(contract: &Contract) -> usize {
  return Vector.length(&contract.constraints)
}

fn contractConstraints(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => constraintCount(&contract)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

effect fn preserved(answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError
? &mut Allocator {
  let shape = Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return onSignature(value, rowBinderAndConsumed)
    },
  )
  let input = slotOf(answer, usize.ZERO)
  let output = slotOf(answer, usize.MAX)
  if let Option<Shared<Type>>.Some {value: from} = move input {
    if let Option<Shared<Type>>.Some {value: to} = move output {
      return shape && run sharesEffectParts(&from, &to)
    }
  }
  return false
}

fn declaredEffect(answer: &Result<Answer, NoRejection>) -> bool {
  return hasTypeLookup(answer, Family.Identity) && onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return signature.isEffect && rowSize(&signature.requirements) == usize.ONE && Shared.with<
        Type,
        bool,
      >(&signature.failure, isNominal)
    },
  )
}

fn rowCountIs(answer: &Result<Answer, NoRejection>, expected: usize) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return rowSize(&signature.requirements) == expected
    },
  )
}

fn unsafeOrdinary(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      return signature.isUnsafe && !signature.isEffect
    },
  )
}

fn constraintOrder(signature: &Signature) -> bool {
  let declared = Vector.asSlice<Constraint>(&signature.constraints)
  if declared.length != 4 {
    return false
  }
  let outlives = match & declared[usize.ZERO] {
    Constraint.Outlives {..} => true
    _ => false
  }
  let hash = match & declared[usize.ONE] {
    Constraint.Conforms {contract, ..} => Shared.with<Type, bool>(&contract, isNominal)
    _ => false
  }
  let logger = match & declared[2] {
    Constraint.Conforms {..} => true
    _ => false
  }
  let contents = match & declared[3] {
    Constraint.Contents {..} => true
    _ => false
  }
  return outlives && hash && logger && contents
}

effect fn contractClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("contracts.silk")
  let services = run module("services.silk")
  let text = "import services { Clock }\nservice Logger {}\ninterface Hash {}\nstruct Plain {}\nstruct Problem {}\nstruct Other {}\nrole Primary\ntype Borrowed = &'static i32\nfn apply(transform: fn(i32) -> i32, value: i32) -> i32 { return value }\nfn consume(transform: once fn(i32) -> i32) -> i32 { return 0 }\neffect fn load(id: i32) -> i32 ! Problem ? &Clock { return id }\neffect fn both() -> i32 ! Problem | Other ? &Logger | &Clock at Primary | &mut Clock at Primary | &Clock { return 0 }\neffect fn swapped() -> i32 ! Other | Problem | Other ? &mut Clock at Primary | &Clock | &Logger { return 0 }\neffect fn closed() -> i32 { return 0 }\neffect fn spelled() -> i32 ! never ? never { return 0 }\nfn pending(value: Effect<i32 ! Problem ? &Clock>) -> i32 { return 0 }\nfn preserve<'env, A, ?R>(pending: once Effect<'env; A ? R>) -> Effect<'env; A ? R> { return move pending }\nfn bounded<'long: 'short, 'short, T: Hash + Logger + 'short>(value: &'long T) -> &'short i32 { return () }\nunsafe fn risky() -> i32 { return 1 }\nfn callsRisky() -> i32 { return risky() }\neffect fn notService() -> i32 ? &Plain { return 0 }\neffect fn interfaceRow() -> i32 ? &Hash { return 0 }\neffect fn badRole() -> i32 ? &Clock at Plain { return 0 }\nfn notBound<T: Plain>() -> i32 { return 0 }\nfn repeated<T: Hash + Hash>() -> i32 { return 0 }\nfn ordinaryFailure() -> i32 ! Problem { return 0 }\nfn rowAsType<?R>(value: R) -> i32 { return 0 }\nfn borrowedUnion() -> Borrowed | i32 { return 0 }\nfn quantified(transform: fn<'static>(&i32) -> &i32) -> i32 { return 0 }\nfn spelledQuantifier(transform: for<'call> fn<'static>(&'call i32) -> &'call i32) -> i32 { return 0 }\nfn ambiguousCallable(transform: fn<'static>(&i32, &i32) -> &i32) -> i32 { return 0 }\nfn nestedQuantifier(transform: for<'a> fn<'static>(for<'b> fn<'static>(&'b i32) -> i32) -> i32) -> i32 { return 0 }\nfn environments<'a, 'b>(first: Effect<'a & 'b; i32>, second: Effect<'b & 'static & 'a; i32>, third: Effect<'a & 'a; i32>, fourth: Effect<'a; i32>) -> i32 { return 0 }\neffect<'env> fn retain<T: 'env, 'env>(value: T) -> i32 { return 0 }\nfn parse<F: fn(i32) -> i32>(parser: F) -> i32 { return 0 }\nfn ordinaryRow() -> i32 ? &Clock { return 0 }\npub fn exposedCallable(transform: fn(Plain) -> i32) -> i32 { return 0 }\npub effect fn exposedRow() -> i32 ? &Logger { return 0 }\nstruct Sorted<T: Hash> { value: T }\ninterface Dated<'a> {}\nstruct DatedBox<T: Dated> { value: T }\nfn useSorted(value: Sorted<i32>) -> i32 { return 0 }\ninterface Load<E, ?R> {}\nfn loadable<T: Load<Problem ? &Clock>>(source: &T) -> i32 { return 0 }\nfn wrongRow<T: Load<Problem>>(source: &T) -> i32 { return 0 }\nstruct Parser<F: fn<'static>(i32) -> i32> { parse: F }\ntype Loaded<?R> = Effect<'static; i32 ? &Logger | R>\nfn loaded(value: Loaded<? &Clock>) -> i32 { return 0 }\nfn closedEffect() -> Effect<i32> { return () }\nfn explicitStatic() -> Effect<'static; i32> { return () }\nfn inputEffect(value: i32) -> Effect<i32> { return () }\neffect fn closedDeferred() -> i32 { return 0 }\neffect fn inputDeferred(value: i32) -> i32 { return value }\neffect fn sameRegion<'a>(left: &'a i32, right: &'a i32, count: i32) -> i32 { return count }\neffect fn heldDeferred<'a>(value: Held<'a, i32>) -> i32 { return 0 }\nfn genericEffect<T>(value: T) -> Effect<i32> { return () }\nfn twoBorrowEffect(left: &i32, right: &i32) -> Effect<i32> { return () }\nfn heldEffect(value: Held<'static, i32>, count: i32) -> Effect<i32> { return () }\neffect fn runPending<A, E>(pending: once Effect<'static; A ! E>) -> i32 { return 0 }\neffect fn callbackDeferred<A>(callback: fn<'static>(A) -> A) -> i32 { return 0 }\neffect fn keepPending<A>(pending: once Effect<A>) -> i32 { return 0 }\nfn heldOpenEffect<'a>(value: Held<'a, i32>) -> Effect<i32> { return () }\nfn nestedStatic() -> Effect<'static; Effect<i32>> { return () }\neffect fn representedBorrowed<'a, F: fn<'a>(i32) -> i32>(callback: F) -> i32 { return 0 }\neffect fn representedStatic<A, F: once Effect<'static; A>>(pending: F) -> i32 { return 0 }\neffect fn conformedStored<T: Hash>(value: T) -> i32 { return 0 }\neffect fn effectSuccess() -> Effect<i32> { return () }\neffect fn effectSuccessStatic() -> Effect<'static; i32> { return () }\neffect fn borrowedDeferred(value: &i32, count: i32) -> i32 { return count }\neffect fn twoBorrowed(left: &i32, right: &i32) -> i32 { return 0 }\neffect fn genericDeferred<Kept>(value: &i32, stored: Kept) -> i32 { return 0 }\nfn orderedA(transform: for<'a, 'b> fn<'static>(Effect<'a & 'b; i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn orderedB(transform: for<'a, 'b> fn<'static>(Effect<'b & 'a; i32>, &'a i32) -> i32) -> i32 { return 0 }\nstruct HolderA<'x> { v: &'x i32 }\nstruct HolderB<'x> { v: &'x i32 }\nfn unionAB(transform: for<'a, 'b> fn<'static>(HolderA<'a> | HolderB<'b>) -> i32) -> i32 { return 0 }\nfn unionBA(transform: for<'a, 'b> fn<'static>(HolderB<'b> | HolderA<'a>) -> i32) -> i32 { return 0 }\nfn unionShared(transform: for<'a> fn<'static>(HolderA<'a> | HolderB<'a>) -> i32) -> i32 { return 0 }\nservice SA<'x> {}\nservice SB<'x> {}\nfn rowAB(transform: for<'a, 'b> fn<'static>(Effect<'static; i32 ? &SA<'a> | &SB<'b>>) -> i32) -> i32 { return 0 }\nfn rowBA(transform: for<'a, 'b> fn<'static>(Effect<'static; i32 ? &SB<'b> | &SA<'a>>) -> i32) -> i32 { return 0 }\nfn overlapAB(transform: for<'a, 'b, 'c> fn<'static>(Effect<'a & 'b; i32>, Effect<'a & 'c; i32>) -> i32) -> i32 { return 0 }\nfn overlapBA(transform: for<'a, 'b, 'c> fn<'static>(Effect<'b & 'a; i32>, Effect<'a & 'c; i32>) -> i32) -> i32 { return 0 }\nfn overlapApart(transform: for<'a, 'b, 'c> fn<'static>(Effect<'a & 'b; i32>, Effect<'c; i32>) -> i32) -> i32 { return 0 }\nfn manyA(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\nfn manyB(transform: for<'b20, 'b19, 'b18, 'b17, 'b16, 'b15, 'b14, 'b13, 'b12, 'b11, 'b10, 'b9, 'b8, 'b7, 'b6, 'b5, 'b4, 'b3, 'b2, 'b1, 'b0> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\nfn manyC(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b1 i32) -> i32 { return 0 }\nfn manyD(transform: for<'b0, 'b1, 'b2, 'b3, 'b4, 'b5, 'b6, 'b7, 'b8, 'b9, 'b10, 'b11, 'b12, 'b13, 'b14, 'b15, 'b16, 'b17, 'b18, 'b19, 'b20> fn<'static>(&'b0 i32, &'b1 i32, &'b2 i32, &'b3 i32, &'b4 i32, &'b5 mut i32, &'b6 i32, &'b7 i32, &'b8 i32, &'b9 i32, &'b10 i32, &'b11 i32, &'b12 i32, &'b13 i32, &'b14 i32, &'b15 i32, &'b16 i32, &'b17 i32, &'b18 i32, &'b19 i32, &'b20 i32) -> &'b0 i32) -> i32 { return 0 }\nfn nestedRef(transform: for<'a> fn<'static>(fn<'static>(&'a i32) -> i32) -> i32) -> i32 { return 0 }\nfn nestedRefAgain(transform: for<'z> fn<'static>(fn<'static>(&'z i32) -> i32) -> i32) -> i32 { return 0 }\nfn nestedFirst(transform: for<'a, 'b> fn<'static>(fn<'static>(&'a i32) -> i32, &'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn nestedFirstRenamed(transform: for<'x, 'y> fn<'static>(fn<'static>(&'x i32) -> i32, &'x i32, &'y i32) -> i32) -> i32 { return 0 }\nfn nestedSecond(transform: for<'a, 'b> fn<'static>(fn<'static>(&'b i32) -> i32, &'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn nestedUnion(transform: for<'a, 'b> fn<'static>(Box<fn<'static>(&'b i32) -> i32> | Box<fn<'static>(&'a i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn nestedUnionSwapped(transform: for<'a, 'b> fn<'static>(Box<fn<'static>(&'a i32) -> i32> | Box<fn<'static>(&'b i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn nestedUnionOne(transform: for<'a> fn<'static>(Box<fn<'static>(&'a i32) -> i32> | Box<fn<'static>(&'a i32, &'a i32) -> i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn orderedSingle(transform: for<'a> fn<'static>(Effect<'a; i32>, &'a i32) -> i32) -> i32 { return 0 }\nfn mixedBinders(transform: for<'a> fn<'static>(&i32, &'a i32) -> i32) -> i32 { return 0 }\nfn elidedBinders(transform: fn<'static>(&i32, &i32) -> i32) -> i32 { return 0 }\nfn permutedBinders(transform: for<'b, 'a> fn<'static>(&'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn unusedBinder(transform: for<'a> fn<'static>(i32) -> i32) -> i32 { return 0 }\nfn plainCallable(transform: fn<'static>(i32) -> i32) -> i32 { return 0 }\nfn boundedBinders(transform: for<'a: 'b, 'b> fn<'static>(&'a i32, &'b i32) -> i32) -> i32 { return 0 }\nfn swappedBound(transform: for<'y, 'x: 'y> fn<'static>(&'x i32, &'y i32) -> i32) -> i32 { return 0 }\nstruct Held<'a, T: 'a> { value: &'a T }\nfn held(value: Held<'static, i32>) -> i32 { return 0 }\nstruct Box<T> { value: T }\ntype Pair<T> = T | Box<T>\nfn control(value: Pair<i32>) -> i32 { return 0 }\nfn nested(value: Pair<Box<i32>>) -> i32 { return 0 }\nfn again(value: Pair<Box<i32>>) -> i32 { return 0 }\nservice Store<T> {}\ntype Stored<'env, T> = Effect<'env; i32 ? &Store<T> | &Store<Box<T>>>\nfn stored<'a>(value: Stored<'a, Box<i32>>) -> i32 { return 0 }\n"
  let source = run present(text)
  let clock = run present("pub service Clock {}\n")
  let bounds = run module("bounds.silk")
  let ranked = run present(
    "interface Hash {}\ninterface Show {}\nstruct Ranked<T: Hash> { value: T }\nfn wrongRanked(value: Ranked<'static>) -> i32 { return 0 }\n",
  )
  let first = run Revision.publish(&Revision.make(), &entry, &source)
  let seeded = run Revision.publish(&first, &services, &clock)
  let held = run Revision.publish(&seeded, &bounds, &ranked)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let mut request = Request.make()
  let apply = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"apply")
  let consume = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"consume")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &apply,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return firstModeIs(answer, usize.ONE)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &consume,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return firstModeIs(answer, 3)
      },
    ),
    "callable parameters keep shared and consuming invocation modes",
  )
  let load = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"load")
  let pending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pending")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&load, declaredEffect) && (run pendingMatches(
      &pending,
      &load,
    )),
    "an effect declaration and a written Effect type resolve the same channels",
  )
  let both = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"both")
  let swapped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"swapped")
  let closed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"closed")
  let spelled = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"spelled")
  run Testing.expect(
    (run sameChannels(&both, &swapped)) && !(run sameChannels(&both, &load)) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &both,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rowCountIs(answer, 3)
      },
    ) && (run sameChannels(&closed, &spelled)) && !(run sameChannels(&closed, &load)),
    "failure unions and requirement rows normalize; omitted channels equal never and empty",
  )
  let preserve = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"preserve")
  let bounded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"bounded")
  let risky = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"risky")
  run Testing.expect(
    (run preserved(&preserve)) && Shared.with<Result<Answer, NoRejection>, bool>(
      &bounded,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return onSignature(answer, constraintOrder)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(&risky, unsafeOrdinary),
    "row binders, run modes, ordered bounds and unsafe contracts are retained",
  )
  let control = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"control")
  let nested = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nested")
  let again = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"again")
  let stored = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"stored")
  run Testing.expect(
    (run substitutedShapes(&control, &nested, &again, &stored)),
    "substituted unions and rows compare a handle shared at different depths",
  )
  let callsRisky = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"callsRisky")
  let loadBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"load")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &callsRisky,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.Unsupported)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &loadBody,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.Unsupported)
      },
    ),
    "scalar bodies reject unsafe calls and effect bodies despite resolved contracts",
  )
  let notService = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"notService")
  let interfaceRow = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"interfaceRow",
  )
  let badRole = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"badRole")
  let notBound = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"notBound")
  let repeated = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"repeated")
  let ordinaryFailure = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"ordinaryFailure",
  )
  let rowAsType = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowAsType")
  let borrowedUnion = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"borrowedUnion",
  )
  let quantified = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"quantified")
  let closedEffect = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"closedEffect",
  )
  let ambiguousCallable = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"ambiguousCallable",
  )
  let nestedQuantifier = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedQuantifier",
  )
  let ordinaryRow = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"ordinaryRow",
  )
  let exposedCallable = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"exposedCallable",
  )
  let exposedRow = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"exposedRow")
  run Testing.expect(
    rejectsAt(&notService, RejectionCode.InvalidRequirement) && rejectsAt(
      &interfaceRow,
      RejectionCode.InvalidRequirement,
    ) && rejectsAt(&badRole, RejectionCode.InvalidRequirement) && rejectsAt(
      &notBound,
      RejectionCode.InvalidBound,
    ) && rejectsAt(&repeated, RejectionCode.DuplicateBound) && rejectsAt(
      &ordinaryFailure,
      RejectionCode.EffectChannelOnOrdinary,
    ) && rejectsAt(&ordinaryRow, RejectionCode.EffectChannelOnOrdinary) && rejectsAt(
      &rowAsType,
      RejectionCode.TypeArgumentKind,
    ) && rejectsAt(&borrowedUnion, RejectionCode.InvalidUnionMember) && rejectsAt(
      &ambiguousCallable,
      RejectionCode.AmbiguousLifetime,
    ) && rejectsAt(&nestedQuantifier, RejectionCode.NestedQuantifier) && rejectsAt(
      &exposedCallable,
      RejectionCode.PrivateTypeExposure,
    ) && rejectsAt(&exposedRow, RejectionCode.PrivateTypeExposure),
    "invalid contracts reject at their spans",
  )
  let explicitStatic = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"explicitStatic",
  )
  let inputEffect = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"inputEffect",
  )
  let closedDeferred = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"closedDeferred",
  )
  let inputDeferred = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"inputDeferred",
  )
  let genericEffect = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"genericEffect",
  )
  let twoBorrowEffect = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"twoBorrowEffect",
  )
  let heldEffect = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"heldEffect")
  let staticClosed = run sameResults(&closedEffect, &explicitStatic)
  let staticOwned = run sameResults(&inputEffect, &explicitStatic)
  let staticHeld = run sameResults(&heldEffect, &explicitStatic)
  run Testing.expect(
    staticClosed && staticOwned && staticHeld && rejectsAt(
      &genericEffect,
      RejectionCode.AmbiguousLifetime,
    ) && rejectsAt(&twoBorrowEffect, RejectionCode.AmbiguousLifetime) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&closedDeferred, staticEnvironment) && Shared.with<Result<Answer, NoRejection>, bool>(
      &inputDeferred,
      staticEnvironment,
    ),
    "inputs free of borrowed data give an omitted Effect environment 'static",
  )
  let nestedStatic = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedStatic",
  )
  let borrowedDeferred = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"borrowedDeferred",
  )
  let twoBorrowed = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"twoBorrowed",
  )
  let genericDeferred = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"genericDeferred",
  )
  let sameRegion = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"sameRegion")
  let heldDeferred = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"heldDeferred",
  )
  let runPending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"runPending")
  let callbackDeferred = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"callbackDeferred",
  )
  let keepPending = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"keepPending",
  )
  let heldOpenEffect = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"heldOpenEffect",
  )
  let representedBorrowed = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"representedBorrowed",
  )
  let representedStatic = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"representedStatic",
  )
  let conformedStored = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"conformedStored",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, usize>(&representedBorrowed, environmentMembers) == usize.ONE && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&representedStatic, environmentMembers) == usize.ZERO && rejectsAt(
      &conformedStored,
      RejectionCode.AmbiguousLifetime,
    ),
    "a representation parameter retains its contract environment; other stored parameters are unknown",
  )
  let effectSuccess = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"effectSuccess",
  )
  let effectSuccessStatic = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"effectSuccessStatic",
  )
  run Testing.expect(
    rejectsAt(&effectSuccess, RejectionCode.AmbiguousLifetime) && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&effectSuccessStatic, environmentMembers) == usize.ZERO,
    "an effect fn success Effect gets no environment default; its capture environment stays 'static",
  )
  run Testing.expect(
    rejectsAt(&nestedStatic, RejectionCode.AmbiguousLifetime) && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&borrowedDeferred, environmentMembers) == usize.ONE && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&twoBorrowed, environmentMembers) == 2 && Shared.with<Result<Answer, NoRejection>, usize>(
      &sameRegion,
      environmentMembers,
    ) == usize.ONE && rejectsAt(&genericDeferred, RejectionCode.AmbiguousLifetime) && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&heldDeferred, environmentMembers) == usize.ONE && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&runPending, environmentMembers) == usize.ZERO && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&callbackDeferred, environmentMembers) == usize.ZERO && Shared.with<
      Result<Answer, NoRejection>,
      usize,
    >(&keepPending, environmentMembers) == usize.ONE && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &genericDeferred,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          value,
          RejectionCode.AmbiguousLifetime,
          String.utf8Bytes(text),
          b"Kept",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &heldOpenEffect,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          value,
          RejectionCode.AmbiguousLifetime,
          String.utf8Bytes(text),
          b"Effect<i32>",
        )
      },
    ),
    "an effect fn intersects retained regions; stored generic contents need an environment",
  )
  let orderedA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"orderedA")
  let orderedB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"orderedB")
  let orderedSingle = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"orderedSingle",
  )
  run Testing.expect(
    (run sameFirstParameters(&orderedA, &orderedB)) && !(run sameFirstParameters(
      &orderedA,
      &orderedSingle,
    )),
    "intersection member order does not number invocation binders",
  )
  let unionAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unionAB")
  let unionBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unionBA")
  let unionShared = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"unionShared",
  )
  let rowAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowAB")
  let rowBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"rowBA")
  let overlapAB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"overlapAB")
  let overlapBA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"overlapBA")
  let overlapApart = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"overlapApart",
  )
  run Testing.expect(
    (run sameFirstParameters(&unionAB, &unionBA)) && (run sameFirstParameters(&rowAB, &rowBA)) && (run sameFirstParameters(
      &overlapAB,
      &overlapBA,
    )) && !(run sameFirstParameters(&unionAB, &unionShared)) && !(run sameFirstParameters(
      &overlapAB,
      &overlapApart,
    )),
    "callables equal up to a renaming of invocation binders across unions, rows and environments",
  )
  let manyA = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyA")
  let manyB = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyB")
  let manyC = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyC")
  let manyD = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"manyD")
  let manySame = run sameFirstParameters(&manyA, &manyB)
  let manyResult = run sameFirstParameters(&manyA, &manyC)
  let manyAccess = run sameFirstParameters(&manyA, &manyD)
  run Testing.expect(
    manySame && !manyResult && !manyAccess,
    "contracts with many invocation binders compare without enumerating permutations",
  )
  let nestedRef = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nestedRef")
  let nestedRefAgain = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedRefAgain",
  )
  let nestedFirst = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedFirst",
  )
  let nestedFirstRenamed = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedFirstRenamed",
  )
  let nestedSecond = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedSecond",
  )
  let nestedUnion = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedUnion",
  )
  let nestedUnionSwapped = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedUnionSwapped",
  )
  let nestedUnionOne = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"nestedUnionOne",
  )
  let refSame = run sameFirstParameters(&nestedRef, &nestedRefAgain)
  let firstSame = run sameFirstParameters(&nestedFirst, &nestedFirstRenamed)
  let firstSecond = run sameFirstParameters(&nestedFirst, &nestedSecond)
  let unionSame = run sameFirstParameters(&nestedUnion, &nestedUnionSwapped)
  let unionOne = run sameFirstParameters(&nestedUnion, &nestedUnionOne)
  run Testing.expect(
    refSame && firstSame && !firstSecond && unionSame && !unionOne,
    "an unquantified inner callable refers to its enclosing contract's invocation binders",
  )
  let mixedBinders = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"mixedBinders",
  )
  let elidedBinders = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"elidedBinders",
  )
  let permutedBinders = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"permutedBinders",
  )
  let unusedBinder = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"unusedBinder",
  )
  let plainCallable = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"plainCallable",
  )
  let boundedBinders = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"boundedBinders",
  )
  let swappedBound = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"swappedBound",
  )
  run Testing.expect(
    (run sameFirstParameters(&mixedBinders, &elidedBinders)) && (run sameFirstParameters(
      &permutedBinders,
      &elidedBinders,
    )) && (run sameFirstParameters(&unusedBinder, &plainCallable)) && !(run sameFirstParameters(
      &boundedBinders,
      &elidedBinders,
    )) && (run sameFirstParameters(&boundedBinders, &swappedBound)),
    "invocation binders number by first use; unused names vanish and bounds stay meaningful",
  )
  let spelledQuantifier = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"spelledQuantifier",
  )
  let environments = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"environments",
  )
  let retain = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"retain")
  let parse = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"parse")
  run Testing.expect(
    (run sameFirstParameters(&quantified, &spelledQuantifier)) && (run environmentsNormalize(
      &environments,
    )) && Shared.with<Result<Answer, NoRejection>, bool>(&retain, retainsEnvironment) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&parse, representsCallable),
    "invocation binders, environment intersections and representation bounds are canonical",
  )
  let sorted = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Sorted")
  let datedBox = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"DatedBox")
  let loadInterface = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Load")
  let parser = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Parser")
  let useSorted = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"useSorted")
  let loadable = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"loadable")
  let wrongRow = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"wrongRow")
  let loaded = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"loaded")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&sorted, sortedContract) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&datedBox, datedBoxContract) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&loadInterface, loadContract) && Shared.with<Result<Answer, NoRejection>, bool>(
      &parser,
      parserContract,
    ),
    "declaration contracts record bounds, row binders and representation parameters",
  )
  run Testing.expect(
    rejectsAt(&useSorted, RejectionCode.Unsupported) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&loadable, signatureSucceeded) && rejectsAt(&wrongRow, RejectionCode.TypeArgumentKind) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&loaded, splicedRow),
    "bounded applications await proof; a row argument binds and splices through an alias",
  )
  let heldAnswer = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"held")
  let heldContract = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Held")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&heldAnswer, signatureSucceeded) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&heldContract, lifetimeBoundOnly),
    "a lifetime-only bound is recorded and does not block applications",
  )
  let rankedMembers = run Semantic.demandMembers(&mut semantic, &mut request, &bounds, b"Ranked")
  let rankedContract = run Semantic.demandContract(&mut semantic, &mut request, &bounds, b"Ranked")
  let wrongRanked = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &bounds,
    b"wrongRanked",
  )
  run Testing.expect(
    !Shared.with<Result<Answer, NoRejection>, bool>(
      &rankedMembers,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Contract)
      },
    ) && Shared.with<Result<Answer, NoRejection>, usize>(&rankedContract, contractConstraints) == usize.ONE && rejectsAt(
      &wrongRanked,
      RejectionCode.TypeArgumentKind,
    ),
    "bounded applications check arguments before proof, without affecting declaration identity",
  )
  let changed = run present("pub interface Clock {}\n")
  Semantic.revise(&mut semantic, run Revision.publish(&held, &services, &changed))
  let mut revised = Request.make()
  let reloaded = run Semantic.demandSignature(&mut semantic, &mut revised, &entry, b"load")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &reloaded,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidRequirement)
      },
    ),
    "an imported service becoming an interface invalidates its requirement use",
  )
  let reranked = run present(
    "interface Hash {}\ninterface Show {}\nstruct Ranked<T: Hash + Show> { value: T }\n",
  )
  Semantic.revise(&mut semantic, run Revision.publish(&held, &bounds, &reranked))
  let mut edited = Request.make()
  let editedContract = run Semantic.demandContract(&mut semantic, &mut edited, &bounds, b"Ranked")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, usize>(&editedContract, contractConstraints) == 2,
    "editing only a bound yields the new contract",
  )
  return ()
}

test effect fn callableAndEffectSignatureContracts() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run contractClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn nominalMembersAndRequestedCompositeShapes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("shapes.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  // A written but undeclared lifetime fails only when its member is demanded: it never needs
  // resolving to know a declaration's lifetime arity. A field type name does, so `Missing` makes
  // every application of `Held` and `Maybe` reject while their identities stay available.
  let shapesText = "struct Node { next: Node }\nstruct Box<T> {\n value: T\n deferred: &'undeclared i32\n}\nunion Choice<T> { None, Some { payload: T }, Broken { payload: &'undeclared i32 } }\ntuple Pair(i32, bool)\nenum State { Start, Done }\nfn boxed() -> Box<bool> { return () }\nfn boxedAgain() -> Box<bool> { return () }\nfn chosen() -> Choice<bool> { return () }\nfn array() -> [Node; 0] { return () }\nfn pending() -> [Node; COUNT] { return () }\nstruct Held<T> {\n value: T\n deferred: Missing\n}\nunion Maybe<T> { None, Broken { payload: Missing } }\nfn held() -> Held<bool> { return () }\nfn maybe() -> Maybe<bool> { return () }\n"
  let source = run present(shapesText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let node = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Node")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let recursive = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &node,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: nodeType} = move recursive {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Node")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let shape = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Node",
      0,
      &nodeType,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&names, inspect).success && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&shape, shapeFirstIsNominal),
      "recursive nominal identity and written member type terminate without layout",
    )
  } else {
    run Testing.expect(false, "recursive nominal identity resolves")
  }
  let boxed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"boxed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &boxed,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move boxType {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Box")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let value = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Box",
      0,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    let deferred = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Box",
      1,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &names,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return memberNames(answer, b"value", b"deferred")
        },
      ),
      "member names survive an unrelated invalid field",
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&value, shapeFirstIsBool),
      "applied field type substitutes T",
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &deferred,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return rejectionSpells(answer, RejectionCode.UnknownLifetime, String.utf8Bytes(shapesText), b"'undeclared")
        },
      ),
      "an arity-independent invalid field rejects only when its member is requested",
    )
    let sameShapeStarts = starts(Semantic.eventLog(&semantic), Family.MemberShape)
    let sameShapeHits = hits(Semantic.eventLog(&semantic), Family.MemberShape)
    let separatelyWritten = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"boxedAgain",
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    let secondApplication = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &separatelyWritten,
      signatureResult,
    )
    if let Option<Shared<Type>>.Some {value: separatelyDerived} = move secondApplication {
      let repeated = run Semantic.demandMemberShape(
        &mut semantic,
        &mut request,
        &entry,
        b"Box",
        0,
        &separatelyDerived,
      )
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(
        Shared.with<Result<Answer, NoRejection>, bool>(&repeated, shapeFirstIsBool) && starts(
          Semantic.eventLog(&semantic),
          Family.MemberShape,
        ) == sameShapeStarts && hits(Semantic.eventLog(&semantic), Family.MemberShape) > sameShapeHits,
        "equal separately derived nominal applications reuse one member-shape fact",
      )
    } else {
      run Testing.expect(false, "the second generic nominal application resolves")
    }
  } else {
    run Testing.expect(false, "generic nominal application resolves")
  }
  let chosen = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"chosen")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let choiceType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &chosen,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move choiceType {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Choice")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let empty = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Choice",
      0,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    let some = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Choice",
      1,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&names, inspect).success && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&empty, shapeCount) == 0 && Shared.with<Result<Answer, NoRejection>, bool>(
        &some,
        shapeFirstIsBool,
      ),
      "union variant payload is selected and substituted independently",
    )
  } else {
    run Testing.expect(false, "generic union application resolves")
  }
  let pair = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Pair")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &pair,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move tupleType {
    let position = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Pair",
      1,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&position, shapeFirstIsBool),
      "tuple position resolves its selected written type",
    )
  } else {
    run Testing.expect(false, "tuple identity resolves")
  }
  let enumeration = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"State")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let enumType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &enumeration,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move enumType {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"State")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let case = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"State",
      0,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &names,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return memberNames(answer, b"Start", b"Done")
        },
      ) && Shared.with<Result<Answer, NoRejection>, usize>(&case, shapeCount) == 0,
      "enum names are ordered and scalar cases have no payload",
    )
  } else {
    run Testing.expect(false, "enum identity resolves")
  }
  let array = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"array")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pending")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&array, signatureIsZeroNominalArray) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &pending,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.Unsupported)
      },
    ),
    "authored zero extent retains its element; static execution remains explicitly unsupported",
  )
  run memberRevisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
  run memberKindRevisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"held")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let maybe = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"maybe")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let heldIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Held")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let heldNames = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Held")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let heldArity = Shared.with<Result<Answer, NoRejection>, bool>(
    &held,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UnknownName, String.utf8Bytes(shapesText), b"Missing")
    },
  )
  let maybeArity = rejectsAt(&maybe, RejectionCode.UnknownName)
  let identityView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&heldIdentity, inspect)
  let namesView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&heldNames, inspect)
  run Testing.expect(
    heldArity && maybeArity && identityView.success && namesView.success,
    "an application needs its field type names for lifetime arity while identity and member names stay lazy",
  )
  return ()
}

test effect fn genericTypeBindersAndExplicitApplications() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("generic.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "struct Pair<A, B> {}\nstruct Plain {}\ntype Same<T> = Pair<T, T>\nfn left<T>(value: T) -> T { return move value }\nfn right<T>(value: T) -> T { return move value }\nfn generic<T>() -> i32 { return 1 }\nfn duplicate<T, T>(value: T) -> T { return move value }\nfn one() -> Pair<i32, bool> { return () }\nfn two() -> Pair<i32, bool> { return () }\nfn swapped() -> Pair<bool, i32> { return () }\nfn alias() -> Same<bool> { return () }\nfn direct() -> Pair<bool, bool> { return () }\nfn arity() -> Pair<i32> { return () }\nfn omitted() -> Pair { return () }\nfn excess() -> Plain<i32> { return () }\nfn kind() -> Pair<'x, bool> { return () }\nfn missing() -> Pair<Unknown, bool> { return () }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let left = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"left")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"right")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&left, signatureHasOrdinaryBinder) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&right, signatureHasOrdinaryBinder) && !(run resultEquals(&left, &right)
      |> Effect.provideMut<Allocator>(&mut allocator)),
    "each function owns a distinct ordinary T binder reused in its signature",
  )
  let one = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"one")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let two = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"two")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let swapped = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"swapped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let direct = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"direct")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    (run resultIsReflexive(&one)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run resultEquals(&one, &two)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&one, &swapped)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run resultEquals(&alias, &direct)
      |> Effect.provideMut<Allocator>(&mut allocator)),
    "ordered nominal arguments are canonical and generic aliases substitute explicitly",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &alias,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Alias) && hasTypeLookup(answer, Family.Identity)
      },
    ),
    "an applied alias retains alias and nominal identity dependencies",
  )
  let arity = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"arity")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let omitted = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"omitted")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let excess = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"excess")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let kind = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"kind")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&arity, wrongTypeArity) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&kind, wrongTypeKind) && Shared.with<Result<Answer, NoRejection>, bool>(
      &missing,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.UnknownName) && hasTypeLookup(
          answer,
          Family.Name,
        )
      },
    ),
    "wrong arity, wrong kind and absent argument names reject with anchored evidence",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &omitted,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.TypeArity)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &excess,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.TypeArity)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &duplicate,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.DuplicateTypeParameter)
      },
    ),
    "omitted, excess and duplicate generic declarations reject at source positions",
  )
  let genericBody = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"generic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &genericBody,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.Unsupported)
      },
    ),
    "a resolved generic signature does not claim a checked generic body",
  )
  return ()
}

// The byte offset of the zero-based `occurrence` of `needle` in `text`; `usize.MAX` when absent.
fn offsetOf(text: string, needle: string, occurrence: usize) -> usize {
  let haystack = String.utf8Bytes(text)
  let wanted = String.utf8Bytes(needle)
  let mut seen = usize.ZERO
  let mut at = usize.ZERO
  while at + wanted.length <= haystack.length {
    let mut matched = true
    let mut inner = usize.ZERO
    while inner < wanted.length {
      if haystack[at + inner] != wanted[inner] {
        matched = false
      }
      inner = inner + usize.ONE
    }
    if matched {
      if seen == occurrence {
        return at
      }
      seen = seen + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// A completed rejection with `code` whose nonempty span starts at `start`.
fn rejectsFrom(answer: &Shared<Result<Answer, NoRejection>>, code: RejectionCode, start: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && diagnostic.span.start == start && diagnostic.span.end > start
      },
    )
  }
  return false
}

fn operationCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Operations {operations}} => Vector.length(&operations)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn contractProvider(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => match & contract.provider {
        Option<Shared<Type>>.Some {value: provider} => Option.some<Shared<Type>>(
          Shared.clone<Type>(&provider),
        )
        Option<Shared<Type>>.None => Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn ownBinder(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let binders = Vector.asSlice<Shared<Type>>(&signature.typeParameters)
        if binders.length == usize.ONE {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&binders[usize.ZERO]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn referentOf(value: Option<Shared<Type>>) -> Option<Shared<Type>> {
  if let Option<Shared<Type>>.Some {value: resolved} = move value {
    return Shared.with<Type, Option<Shared<Type>>>(
      &resolved,
      fn(node: &Type) -> Option<Shared<Type>> {
        return match & node.* {
          Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
          _ => Option.none<Shared<Type>>()
        }
      },
    )
  }
  return Option.none<Shared<Type>>()
}

fn parameterAt(value: &Option<Shared<Type>>, ordinal: usize) -> bool {
  if let Option<Shared<Type>>.Some {value: resolved} = &value.* {
    return Shared.with<Type, bool>(
      &resolved,
      fn(node: &Type) -> bool {
        return Type.parameterOrdinal(node) == ordinal
      },
    )
  }
  return false
}

fn resolvedSignatures(events: &[SemanticEvent]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < events.length {
    if events[at].family == Family.Signature {
      count = count + usize.ONE
    }
    at = at + usize.ONE
  }
  return count
}

test effect fn contractScopesAndOperationHeaders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("contracts.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Decoder<A> {\n  fn decode<B>(value: &Self, hint: B) -> A\n  fn make() -> Self\n}\nservice Clock<T> {\n  fn now(clock: &Self) -> T\n}\ninterface Echo<Self> {}\ninterface Shadow<T> {\n  fn restate<T>(value: T) -> T\n}\ninterface Reserved {\n  fn named<Self>() -> i32\n}\ninterface Repeated {\n  fn decode(value: &Self) -> i32\n  fn decode(other: &Self) -> i32\n}\ninterface Bodied {\n  fn step(value: &Self) -> i32 { return 0 }\n}\ninterface Stored {\n  value: i32\n}\nfn outside(value: Self) -> i32 { return 0 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let listed = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Decoder")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let listedCount = Shared.with<Result<Answer, NoRejection>, usize>(&listed, operationCount)
  let unresolved = resolvedSignatures(Semantic.eventLog(&semantic)) == usize.ZERO
  run Testing.expect(
    listedCount == 2 && unresolved,
    "listing a contract's operations reads member headers without resolving their signatures",
  )
  let contract = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Decoder")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let decode = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Decoder", b"decode")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let make = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Decoder", b"make")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let provider = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &contract,
    contractProvider,
  )
  let providerAfterBinders = parameterAt(&provider, usize.ONE)
  let madeSelf = run typesEqual(slotOf(&make, usize.MAX), move provider)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let receivedSelf = run typesEqual(
    referentOf(slotOf(&decode, usize.ZERO)),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&contract, contractProvider),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    providerAfterBinders && madeSelf && receivedSelf,
    "an operation's Self is the contract's implicit provider, bound after its written binders",
  )
  let own = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&decode, ownBinder)
  let result = slotOf(&decode, usize.MAX)
  let ownFirst = parameterAt(&own, usize.ZERO)
  let resultFirst = parameterAt(&result, usize.ZERO)
  let hintUsesOwn = run typesEqual(
    slotOf(&decode, usize.ONE),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&decode, ownBinder),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ownersDiffer = !(run typesEqual(move result, move own)
    |> Effect.provideMut<Allocator>(&mut allocator))
  run Testing.expect(
    ownFirst && resultFirst && hintUsesOwn && ownersDiffer,
    "an operation binder and its contract binder at the same ordinal keep distinct owners",
  )
  let now = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Clock", b"now")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let clock = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Clock")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let clockSelf = run typesEqual(
    referentOf(slotOf(&now, usize.ZERO)),
    Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&clock, contractProvider),
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let clockResult = slotOf(&now, usize.MAX)
  let clockBinder = parameterAt(&clockResult, usize.ZERO)
  run Testing.expect(
    clockSelf && clockBinder,
    "a service operation resolves under the same implicit provider scope",
  )
  let echo = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Echo")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let named = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Reserved", b"named")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let restate = run Semantic.demandOperation(
    &mut semantic,
    &mut request,
    &entry,
    b"Shadow",
    b"restate",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let outside = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"outside")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let echoReserved = rejectsFrom(
    &echo,
    RejectionCode.DuplicateTypeParameter,
    offsetOf(text, "Echo<Self>", 0) + 5,
  )
  let operationReserved = rejectsFrom(
    &named,
    RejectionCode.DuplicateTypeParameter,
    offsetOf(text, "named<Self>", 0) + 6,
  )
  let unavailable = rejectsFrom(
    &outside,
    RejectionCode.UnknownName,
    offsetOf(text, "value: Self)", 0) + 7,
  )
  run Testing.expect(
    echoReserved && operationReserved && unavailable,
    "Self is reserved where it is bound and unavailable outside a contract",
  )
  // Whether a member binder may restate an enclosing binder is not settled by the reference.
  let restated = rejectsFrom(&restate, RejectionCode.Unsupported, offsetOf(text, "restate<T>", 0) + 8)
  run Testing.expect(restated, "a restated enclosing binder stays an explicit boundary")
  let repeated = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Repeated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bodied = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Bodied")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stored = run Semantic.demandOperations(&mut semantic, &mut request, &entry, b"Stored")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run Semantic.demandOperation(&mut semantic, &mut request, &entry, b"Decoder", b"absent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedAt = rejectsFrom(&repeated, RejectionCode.Collision, offsetOf(text, "fn decode(other", 0))
  let bodiedAt = rejectsFrom(
    &bodied,
    RejectionCode.InvalidContractMember,
    offsetOf(text, "fn step", 0),
  )
  let storedAt = rejectsAt(&stored, RejectionCode.InvalidContractMember)
  let missingAt = rejectsAt(&missing, RejectionCode.UnknownMember)
  run Testing.expect(
    repeatedAt && bodiedAt && storedAt && missingAt,
    "repeated, bodied, stored and absent contract members reject at their members",
  )
  return ()
}

fn contractLifetimes(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Contract {contract}} => Vector.length(&contract.lifetimeParameters)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

test effect fn generatedFieldLifetimeBinders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("holders.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parts = run module("parts.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let holdersText = "import parts { Part, Broken, Slice, Either }\nservice Store<T> {}\nstruct Uses<?R> {}\nstruct OnceTask {\n  task: once Effect<&i32>\n}\nstruct UsesStore {\n  uses: Uses<&Store<i32>>\n}\nstruct Stored {\n  task: Effect<i32 ? &Store<&u8>>\n}\nstruct Suffixed {\n  uses: Uses<? &Store<&u8>>\n}\nstruct Failing {\n  task: Effect<i32 ! Holder<&u8>>\n}\nstruct UsesEither {\n  either: Either\n}\nimport parts as Parts\nstruct Sliced {\n  bytes: Slice\n}\nstruct Qualified {\n  part: Parts.Part\n}\nstruct Peeks {\n  secret: Parts.Secret\n}\nstruct Pending {\n  task: Effect<&i32>\n}\nstruct Callback {\n  call: fn(&i32) -> i32\n}\nstruct View {\n  data: &[u8]\n  name: string\n}\nstruct Mixed<'a> {\n  first: &'a i32\n  second: &i32\n}\nstruct Plain {\n  value: i32\n}\nunion Choice { Empty, Held { payload: &i32 } }\ntuple Pairing(&i32, string<'static>)\nstruct Outer {\n  inner: View\n}\nstruct Nested {\n  outer: Outer\n  written: View<'static, 'static>\n}\ntype Bytes = &[u8]\nstruct Buffer {\n  bytes: Bytes\n}\nstruct Carrier {\n  part: Part\n}\nstruct Chain {\n  next: &Chain\n}\nstruct Linked<'a> {\n  next: &'a Linked<'a>\n}\nstruct Holder<T> {\n  value: T\n}\nstruct List<T> {\n  next: Holder<List<T>>\n}\nfn read(view: View) -> i32 { return 0 }\nfn keep(value: &i32) -> View { return () }\nfn usesBroken(value: Broken) -> i32 { return 0 }\nstruct Scoped<'a, ?R> {\n  value: &'a i32\n}\nstruct UsesScoped {\n  scoped: Scoped<&Store<i32>>\n}\nfn partial<'x>(m: Mixed<'x>) -> i32 { return 0 }\nfn complete<'x, 'y>(m: Mixed<'x, 'y>) -> i32 { return 0 }\n"
  let partsText = "pub struct Part {\n  value: &i32\n}\npub struct Broken {\n  field: Missing\n}\npub type Slice = &[u8]\nstruct Secret {\n  value: i32\n}\npub union Either { Left { value: &i32 }, Right }\n"
  let source = run present(holdersText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partsSource = run present(partsText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let withParts = run Revision.publish(&Revision.make(), &parts, &partsSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&withParts, &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let view = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"View")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mixed = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Mixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let plain = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Plain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let choice = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Choice")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pairing = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Pairing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let viewCount = Shared.with<Result<Answer, NoRejection>, usize>(&view, contractLifetimes)
  let mixedCount = Shared.with<Result<Answer, NoRejection>, usize>(&mixed, contractLifetimes)
  let plainCount = Shared.with<Result<Answer, NoRejection>, usize>(&plain, contractLifetimes)
  let choiceCount = Shared.with<Result<Answer, NoRejection>, usize>(&choice, contractLifetimes)
  let pairingCount = Shared.with<Result<Answer, NoRejection>, usize>(&pairing, contractLifetimes)
  run Testing.expect(
    viewCount == 2 && mixedCount == 2 && plainCount == usize.ZERO && choiceCount == usize.ONE && pairingCount == usize.ONE,
    "each omitted borrowed field lifetime adds one declaration lifetime after the written binders",
  )
  let read = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"read")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let keep = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"keep")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let readInputs = Shared.with<Result<Answer, NoRejection>, usize>(&read, lifetimeCountOf)
  let keepInputs = Shared.with<Result<Answer, NoRejection>, usize>(&keep, lifetimeCountOf)
  run Testing.expect(
    readInputs == 2 && keepInputs == usize.ONE,
    "an omitted holder application elides each generated lifetime like any nominal input or result",
  )
  let outer = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Outer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let buffer = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Buffer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let carrier = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Carrier")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let linked = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Linked")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let list = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"List")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    outer == 2 && nested == 2 && buffer == usize.ONE && carrier == usize.ONE,
    "a nested nominal, alias, or imported field used without lifetimes adds every lifetime it omits",
  )
  run Testing.expect(
    linked == usize.ONE && list == usize.ZERO,
    "explicit recursive lifetimes and recursion that omits none keep finite arity",
  )
  let chain = run Semantic.demandContract(&mut semantic, &mut request, &entry, b"Chain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let broken = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"usesBroken")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unbounded = rejectsFrom(&chain, RejectionCode.Unsupported, offsetOf(holdersText, "&Chain", 0) + 1)
  let importedName = Shared.with<Result<Answer, NoRejection>, bool>(
    &broken,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UnknownName, String.utf8Bytes(partsText), b"Missing")
    },
  )
  run Testing.expect(
    unbounded && importedName,
    "recursion that omits a lifetime on every turn stays unsupported, and an imported field name failure rejects the application",
  )
  let sliced = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Sliced")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let peeks = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Peeks")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pending = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Pending")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callback = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Callback")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    sliced == usize.ONE && qualified == usize.ONE && peeks == usize.ZERO && pending == 2 && callback == usize.ONE,
    "imported aliases, namespace types, Effect environments and payloads, and callable environments count; privacy does not affect arity",
  )
  let peeksIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Peeks")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let peeksType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&peeksIdentity, nominalResult)
  let mut privateMember = false
  if let Option<Shared<Type>>.Some {value: applied} = move peeksType {
    let secret = run Semantic.demandMemberShape(&mut semantic, &mut request, &entry, b"Peeks", 0, &applied)
      |> Effect.provideMut<Allocator>(&mut allocator)
    privateMember = rejectsAt(&secret, RejectionCode.PrivateMember)
  }
  run Testing.expect(privateMember, "a private field type is rejected where the member is demanded")
  let onceTask = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"OnceTask")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let usesStore = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"UsesStore")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stored = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Stored")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let suffixed = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Suffixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let failing = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"Failing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let usesEither = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"UsesEither")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let usesScoped = run contractLifetimeCount(&mut semantic, &mut request, &entry, b"UsesScoped")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    usesScoped == usize.ONE,
    "an elided lifetime binder consumes no argument, so the next argument binds the next binder's kind",
  )
  let partial = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"partial")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let complete = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"complete")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partialArity = Shared.with<Result<Answer, NoRejection>, bool>(&partial, wrongTypeArity)
  let completeInputs = Shared.with<Result<Answer, NoRejection>, usize>(&complete, lifetimeCountOf)
  run Testing.expect(
    partialArity && completeInputs == 2,
    "a written lifetime list supplies every lifetime parameter, including generated ones",
  )
  run Testing.expect(
    onceTask == 2 && usesStore == usize.ZERO && stored == 2 && suffixed == usize.ONE && failing == 2 && usesEither == usize.ONE,
    "run modes, row access markers, row capabilities, failure types, and imported unions follow argument kinds",
  )
  return ()
}

// The lifetime parameter count of a declaration's contract, or `usize.MAX` when it rejects.
effect fn contractLifetimeCount(
  semantic: &mut Semantic,
  request: &mut Request,
  module: &ModuleId,
  name: &[u8],
) -> usize ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let answer = run Semantic.demandContract(&mut semantic.*, &mut request.*, module, name)
  return Shared.with<Result<Answer, NoRejection>, usize>(&answer, contractLifetimes)
}

fn headCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Implementations {heads}} => Vector.length(&heads)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn headAt(answer: &Shared<Result<Answer, NoRejection>>, at: usize) -> Option<Shared<ImplementationHead>> {
  return Shared.with<Result<Answer, NoRejection>, Option<Shared<ImplementationHead>>>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> Option<Shared<ImplementationHead>> {
      return match & value.* {
        Result<Answer, NoRejection>.Success {value: found} => match & found.outcome {
          Outcome.Success {value: Value.Implementations {heads}} => {
            let listed = Vector.asSlice<Shared<ImplementationHead>>(&heads)
            if at < listed.length {
              return Option.some<Shared<ImplementationHead>>(
                Shared.clone<ImplementationHead>(&listed[at]),
              )
            }
            return Option.none<Shared<ImplementationHead>>()
          }
          _ => Option.none<Shared<ImplementationHead>>()
        }
        Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<ImplementationHead>>()
      }
    },
  )
}

// 0 inherent, 1 conformance, 2 sealed Copy, 3 sealed Drop; `usize.MAX` when absent.
fn kindOf(head: &Option<Shared<ImplementationHead>>) -> usize {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, usize>(
      &value,
      fn(found: &ImplementationHead) -> usize {
        return match & found.kind {
          ImplementationKind.Inherent => usize.ZERO
          ImplementationKind.Conformance => usize.ONE
          ImplementationKind.Sealed {property} => match property {
            SealedProperty.Copy => 2
            SealedProperty.Drop => 3
          }
        }
      },
    )
  }
  return usize.MAX
}

// Whether the head's provider is a nominal declared in `module`.
fn providedFrom(head: &Option<Shared<ImplementationHead>>, module: &ModuleId) -> bool {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, bool>(
      &value,
      fn(found: &ImplementationHead) -> bool {
        return providerIn(&found.provider, module)
      },
    )
  }
  return false
}

fn providerIn(provider: &Shared<Type>, module: &ModuleId) -> bool {
  return Shared.with<Type, bool>(
    provider,
    fn(resolved: &Type) -> bool {
      return match & resolved.* {
        Type.Nominal {declaration, ..} => ModuleId.equals(DeclarationId.moduleId(&declaration), module)
        _ => false
      }
    },
  )
}

fn headLifetimes(head: &Option<Shared<ImplementationHead>>) -> usize {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, usize>(
      &value,
      fn(found: &ImplementationHead) -> usize {
        return Vector.length(&found.binders.lifetimeParameters)
      },
    )
  }
  return usize.MAX
}

fn copyBoundOnly(answer: &Result<Answer, NoRejection>) -> bool {
  return onSignature(
    answer,
    fn(signature: &Signature) -> bool {
      let declared = Vector.asSlice<Constraint>(&signature.constraints)
      if declared.length != usize.ONE {
        return false
      }
      return match & declared[usize.ZERO] {
        Constraint.Copyable {..} => true
        _ => false
      }
    },
  )
}

test effect fn implementationHeadsAndConformanceOwners() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run implementationClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn implementationClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let contracts = run module("contracts.silk")
  let model = run module("model.silk")
  let outsider = run module("outsider.silk")
  let services = run module("services.silk")
  let sealed = run module("sealed.silk")
  let provider = run module("provider.silk")
  let notContract = run module("notcontract.silk")
  let values = run module("values.silk")
  let empty = run module("empty.silk")
  let streams = run module("streams.silk")
  let unrelated = run module("unrelated.silk")
  let outsiderText = "import model { User }\nimport contracts { Show }\nimpl Show for User {}\n"
  let providerText = "interface Shown {}\nimpl Shown for &i32 {}\n"
  let notContractText = "struct Plain {}\nstruct Other {}\nimpl Plain for Other {}\n"
  let valuesText = "import contracts { Show }\nfn keep(value: &Show) -> i32 { return 0 }\nfn dup<T: Copy>(value: T) -> T { return move value }\nfn drops<T: Drop>(value: T) -> i32 { return 0 }\n"
  let contractsSource = run present(
    "import model { User }\nimport unrelated { Noise }\npub interface Show {}\npub service Clock {}\nimpl Show for User {}\nimpl Show for i32 {}\nfn unused(value: Noise) -> i32 { return 0 }\n",
  )
  let modelSource = run present(
    "import contracts { Show, Clock }\npub struct User {}\npub struct Box<T> {\n  value: T\n}\nimpl Clock for User {}\nimpl<T> Show for Box<T> {}\nimpl Copy for User {}\nimpl User {\n  fn make() -> Self { return () }\n}\n",
  )
  let outsiderSource = run present(outsiderText)
  let servicesSource = run present("pub service Tick {}\nimpl Tick for i32 {}\n")
  let sealedSource = run present("impl Copy for i32 {}\n")
  let providerSource = run present(providerText)
  let notContractSource = run present(notContractText)
  let valuesSource = run present(valuesText)
  let emptySource = run present("fn nothing() -> i32 { return missing() }\n")
  let streamsSource = run present(
    "struct SliceStream<A> {\n  items: &[A]\n}\ninterface Stream<A> {}\nimpl<A> Stream<A> for SliceStream<A> {}\nimpl<A> SliceStream<A> {\n  fn first(stream: &Self) -> i32 { return 0 }\n}\n",
  )
  let unrelatedSource = run present("pub struct Noise {}\n")
  let membersModule = run module("members.silk")
  let membersText = "interface Pairwise {\n  fn left(value: &Self) -> i32\n  fn right(value: &Self) -> i32\n}\nstruct Item {}\nfn itemRight(value: &Item) -> i32 { return 0 }\nimpl Item {\n  fn width(item: &Self) -> i32 { return 0 }\n}\nimpl Pairwise for Item {\n  fn left(value: &Self) -> i32 { return 1 }\n  right: itemRight\n}\nstruct Other {}\nimpl Pairwise for Other {\n  left: Item.width\n  right: missing\n}\nstruct Dup {}\nimpl Pairwise for Dup {\n  fn left(value: &Self) -> i32 { return 1 }\n  left: itemRight\n}\nstruct Twin {}\nimpl Twin {\n  fn both() -> i32 { return 0 }\n}\nimpl Twin {\n  fn both() -> i32 { return 1 }\n}\nstruct Mapper {}\nimpl Pairwise for Mapper {\n  left: Twin.both\n  right: itemRight\n}\nstruct Sealed {}\nimpl Pairwise for Sealed {\n  left: Intrinsic.replace\n  right: itemRight\n}\nstruct Wrap<T> {\n  value: T\n}\nimpl<'long: 'short, 'short, T: Pairwise + Copy + 'short, F: fn<'static>(i32) -> i32> Pairwise for Wrap<T> {}\n"
  let membersSource = run present(membersText)
  let facade = run module("facade.silk")
  let consumer = run module("consumer.silk")
  let facadeSource = run present("pub import contracts { Show }\n")
  let consumerSource = run present(
    "import facade { Show as Visible }\nimport contracts { Show }\nimport model { User, Box }\nstruct Plain {}\nfn viaFacade<T: Visible>(value: T) -> i32 { return 0 }\nfn direct<T: Show>(value: T) -> i32 { return 0 }\nfn user(value: User) -> i32 { return 0 }\nfn boxed(value: Box<i32>) -> i32 { return 0 }\nfn scalar(value: i32) -> i32 { return 0 }\nfn plain(value: Plain) -> i32 { return 0 }\n",
  )
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractsSource)
  let r2 = run Revision.publish(&r1, &model, &modelSource)
  let r3 = run Revision.publish(&r2, &outsider, &outsiderSource)
  let r4 = run Revision.publish(&r3, &services, &servicesSource)
  let r5 = run Revision.publish(&r4, &sealed, &sealedSource)
  let r6 = run Revision.publish(&r5, &provider, &providerSource)
  let r7 = run Revision.publish(&r6, &notContract, &notContractSource)
  let r8 = run Revision.publish(&r7, &values, &valuesSource)
  let r9 = run Revision.publish(&r8, &empty, &emptySource)
  let r10 = run Revision.publish(&r9, &streams, &streamsSource)
  let r11 = run Revision.publish(&r10, &unrelated, &unrelatedSource)
  let r12 = run Revision.publish(&r11, &facade, &facadeSource)
  let r13 = run Revision.publish(&r12, &consumer, &consumerSource)
  let revision = run Revision.publish(&r13, &membersModule, &membersSource)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let contractHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &contracts)
  let first = headAt(&contractHeads, usize.ZERO)
  let second = headAt(&contractHeads, usize.ONE)
  let contractCount = Shared.with<Result<Answer, NoRejection>, usize>(&contractHeads, headCount)
  let interfaceOwned = kindOf(&first) == usize.ONE && providedFrom(&first, &model) && kindOf(&second) == usize.ONE
  let noiseUnread = reads(Semantic.sourceEvents(&semantic), &unrelated) == usize.ZERO
  run Testing.expect(
    contractCount == 2 && interfaceOwned && noiseUnread,
    "an interface's module owns conformances for imported and scalar providers without reading unrelated imports",
  )
  let modelHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &model)
  let serviceHead = headAt(&modelHeads, usize.ZERO)
  let generic = headAt(&modelHeads, usize.ONE)
  let copy = headAt(&modelHeads, 2)
  let modelCount = Shared.with<Result<Answer, NoRejection>, usize>(&modelHeads, headCount)
  let providerOwned = kindOf(&serviceHead) == usize.ONE && kindOf(&generic) == usize.ONE && providedFrom(
    &generic,
    &model,
  )
  let sealedHead = kindOf(&copy) == 2
  run Testing.expect(
    modelCount == 3 && providerOwned && sealedHead,
    "a provider's module owns its service, interface and sealed heads across an import cycle",
  )
  let make = run signatureNamed(&mut semantic, &mut request, &revision, &model, b"make", 0)
  let made = slotOf(&make, usize.MAX)
  let mut madeUser = false
  if let Option<Shared<Type>>.Some {value} = move made {
    madeUser = Shared.with<Type, bool>(&value, isNominal)
  }
  run Testing.expect(madeUser, "an inherent member's Self is its applied owner")
  let outsiderHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &outsider)
  let serviceHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &services)
  let sealedHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &sealed)
  let providerHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &provider)
  let notContractHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &notContract)
  let unowned = rejectsFrom(
    &outsiderHeads,
    RejectionCode.ConformanceOwner,
    offsetOf(outsiderText, "impl Show", 0),
  )
  let serviceScalar = rejectsAt(&serviceHeads, RejectionCode.ConformanceOwner)
  let sealedScalar = rejectsAt(&sealedHeads, RejectionCode.ConformanceOwner)
  let borrowed = rejectsFrom(
    &providerHeads,
    RejectionCode.InvalidProvider,
    offsetOf(providerText, "&i32", 0),
  )
  let plain = rejectsFrom(
    &notContractHeads,
    RejectionCode.InvalidBound,
    offsetOf(notContractText, "Plain for", 0),
  )
  run Testing.expect(
    unowned && serviceScalar && sealedScalar && borrowed && plain,
    "unowned, scalar-service, scalar-sealed, borrowed-provider and non-contract heads reject",
  )
  let keep = run Semantic.demandSignature(&mut semantic, &mut request, &values, b"keep")
  let dup = run Semantic.demandSignature(&mut semantic, &mut request, &values, b"dup")
  let drops = run Semantic.demandSignature(&mut semantic, &mut request, &values, b"drops")
  let existential = rejectsFrom(&keep, RejectionCode.NotType, offsetOf(valuesText, "&Show", 0))
  let copyBound = Shared.with<Result<Answer, NoRejection>, bool>(&dup, copyBoundOnly)
  let dropBound = rejectsFrom(&drops, RejectionCode.InvalidBound, offsetOf(valuesText, "Drop>", 0))
  run Testing.expect(
    existential && copyBound && dropBound,
    "an interface is not a value type, Copy is a sealed bound and Drop is not a bound",
  )
  let none = run Semantic.demandImplementations(&mut semantic, &mut request, &empty)
  let noneCount = Shared.with<Result<Answer, NoRejection>, usize>(&none, headCount)
  let noBodies = starts(Semantic.eventLog(&semantic), Family.Body) == usize.ZERO
  run Testing.expect(
    noneCount == usize.ZERO && noBodies,
    "a module without implementations observes an empty head list without checking bodies",
  )
  let streamHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &streams)
  let conformance = headAt(&streamHeads, usize.ZERO)
  let conformanceLifetime = headLifetimes(&conformance) == usize.ONE
  let streamMember = run signatureNamed(&mut semantic, &mut request, &revision, &streams, b"first", 0)
  let streamView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&streamMember, inspect)
  let inherentLifetime = streamView.success
  run Testing.expect(
    conformanceLifetime && inherentLifetime,
    "a holder lifetime omitted from an impl head becomes an implementation lifetime",
  )
  let viaFacade = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"viaFacade")
  let direct = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"direct")
  let user = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"user")
  let boxed = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"boxed")
  let scalar = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"scalar")
  let plainSignature = run Semantic.demandSignature(&mut semantic, &mut request, &consumer, b"plain")
  let facadeContract = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&viaFacade, boundContract)
  let directContract = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&direct, boundContract)
  let userProvider = slotOf(&user, usize.ZERO)
  let boxedProvider = slotOf(&boxed, usize.ZERO)
  let scalarProvider = slotOf(&scalar, usize.ZERO)
  let plainProvider = slotOf(&plainSignature, usize.ZERO)
  let facadeCount = run conformanceCount(&mut semantic, &mut request, &facadeContract, &userProvider)
  let directCount = run conformanceCount(&mut semantic, &mut request, &directContract, &userProvider)
  let boxedCount = run conformanceCount(&mut semantic, &mut request, &directContract, &boxedProvider)
  let scalarCount = run conformanceCount(&mut semantic, &mut request, &directContract, &scalarProvider)
  let plainCount = run conformanceCount(&mut semantic, &mut request, &directContract, &plainProvider)
  let converged = run typesEqual(move facadeContract, move directContract)
  run Testing.expect(
    converged && facadeCount == usize.ONE && directCount == usize.ONE,
    "a facade and renamed contract endpoint converge on the canonical conformance owners",
  )
  run Testing.expect(
    boxedCount == usize.ONE && scalarCount == usize.ONE && plainCount == usize.ZERO,
    "provider-owned, contract-owned scalar and absent conformances are observed from permitted modules",
  )
  let itemMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 1)
  let otherMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 2)
  let dupMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 3)
  let itemShape = Shared.with<Result<Answer, NoRejection>, bool>(&itemMembers, inlineThenMapped)
  let otherMissing = rejectsFrom(&otherMembers, RejectionCode.UnknownName, offsetOf(membersText, "missing", 0))
  let dupRepeated = rejectsFrom(&dupMembers, RejectionCode.Collision, offsetOf(membersText, "left: itemRight", 0))
  let dupRelated = Shared.with<Result<Answer, NoRejection>, bool>(&dupMembers, relatesOne)
  run Testing.expect(
    itemShape && otherMissing && dupRepeated && dupRelated,
    "conformance members keep written order, resolve mapped targets from headers and reject repeats",
  )
  let mapperMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 6)
  let sealedMembers = run Semantic.demandImplementationMembers(&mut semantic, &mut request, &membersModule, 7)
  let keptRejection = rejectsAt(&mapperMembers, RejectionCode.Collision)
  let sealedMapping = rejectsFrom(
    &sealedMembers,
    RejectionCode.Unsupported,
    offsetOf(membersText, "Intrinsic.replace", 0),
  )
  let pairwiseHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &membersModule)
  let wrapHead = headAt(&pairwiseHeads, 5)
  // Outlives, conformance, sealed Copy, contents, and representation bounds each yield one span.
  let boundAnchors = boundSpansMatch(&wrapHead, 5, offsetOf(membersText, "Pairwise + Copy", 0))
  run Testing.expect(
    keptRejection && sealedMapping && boundAnchors,
    "a mapped duplicate keeps its rejection, an intrinsic mapping is unsupported, and bound spans follow constraints",
  )
  return ()
}

// Two members: an inline operation, then a mapping to a function named `itemRight`.
fn inlineThenMapped(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ImplementationMembers {members}} => {
        let listed = Vector.asSlice<ImplementationMember>(&members)
        if listed.length != 2 {
          return false
        }
        let first = match & listed[usize.ZERO] {
          ImplementationMember.Inline {..} => true
          _ => false
        }
        let second = match & listed[usize.ONE] {
          ImplementationMember.Mapped {target, ..} => Shared.with<DeclarationId, bool>(&target, mapsItemRight)
          _ => false
        }
        return first && second
      }
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

// A rejection that relates exactly one other declaration.
fn relatesOne(answer: &Result<Answer, NoRejection>) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return Vector.length(&diagnostic.path) == usize.ONE
      },
    )
  }
  return false
}

// Whether a head records `count` constraints with one bound span each, the second at `second`.
fn boundSpansMatch(head: &Option<Shared<ImplementationHead>>, count: usize, second: usize) -> bool {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, bool>(
      &value,
      fn(found: &ImplementationHead) -> bool {
        let spans = Vector.asSlice<Span>(&found.boundSpans)
        return Vector.length(&found.binders.constraints) == count && spans.length == count && spans[usize.ONE].start == second
      },
    )
  }
  return false
}

fn mapsItemRight(target: &DeclarationId) -> bool {
  return DeclarationId.named(target, b"itemRight")
}

fn boundContract(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => {
        let declared = Vector.asSlice<Constraint>(&signature.constraints)
        if declared.length == usize.ONE {
          if let Constraint.Conforms {contract, ..} = &declared[usize.ZERO] {
            return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
          }
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn conformanceHeadCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.ConformanceHeads {heads}} => Vector.length(&heads)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

// The relevant conformance head count for a goal, or `usize.MAX` when either type is absent.
effect fn conformanceCount(
  semantic: &mut Semantic,
  request: &mut Request,
  contract: &Option<Shared<Type>>,
  provider: &Option<Shared<Type>>,
) -> usize ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  if let Option<Shared<Type>>.Some {value: applied} = &contract.* {
    if let Option<Shared<Type>>.Some {value: owner} = &provider.* {
      let heads = run Semantic.demandConformanceHeads(&mut semantic.*, &mut request.*, &applied, &owner)
      return Shared.with<Result<Answer, NoRejection>, usize>(&heads, conformanceHeadCount)
    }
  }
  return usize.MAX
}

fn inherentCount(answer: &Result<Answer, NoRejection>, published: bool) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.InherentMembers {members, rejected}} => {
        if published {
          return Vector.length(&members)
        }
        return Vector.length(&rejected)
      }
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn ownBinderCount(answer: &Result<Answer, NoRejection>) -> usize {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Signature {signature}} => Vector.length(&signature.typeParameters)
      _ => usize.MAX
    }
    Result<Answer, NoRejection>.Failure {error: _} => usize.MAX
  }
}

fn hasKind(declaration: &DeclarationId, kind: OwnerKind) -> bool {
  return match kind {
    OwnerKind.Function => match DeclarationId.kind(declaration) {
      OwnerKind.Function => true
      _ => false
    }
    OwnerKind.Implementation => match DeclarationId.kind(declaration) {
      OwnerKind.Implementation => true
      _ => false
    }
    _ => false
  }
}

// The identity a caller holding the module's source index addresses: the `occurrence`th
// declaration of `kind` in source order, named `name` unless `name` is empty.
effect fn identityOf(
  revision: &Revision,
  module: &ModuleId,
  kind: OwnerKind,
  name: &[u8],
  occurrence: usize,
) -> Option<DeclarationId> ! Cycle | OutOfMemoryError ? &mut Allocator {
  let mut index = SourceIndex.make(run Revision.copy(revision))
  let answer = run SourceIndex.demand(&mut index, module)
  if let Option<&IndexedSource>.Some {value} = move SourceIndex.source(&index, &answer, module) {
    let declarations = ModuleIndex.listDeclarations(IndexedSource.moduleIndex(value))
    let mut seen = usize.ZERO
    let mut at = usize.ZERO
    while at < declarations.length {
      let identity = &declarations[at].identity
      if hasKind(identity, kind) && (name.length == usize.ZERO || DeclarationId.named(identity, name)) {
        if seen == occurrence {
          return Option.some<DeclarationId>(run DeclarationId.copy(identity))
        }
        seen = seen + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return Option.none<DeclarationId>()
}

// The signature of the `occurrence`th function named `name`, addressed by its identity.
effect fn signatureNamed(
  semantic: &mut Semantic,
  request: &mut Request,
  revision: &Revision,
  module: &ModuleId,
  name: &[u8],
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let identity = run requireIdentity(revision, module, OwnerKind.Function, name, occurrence)
  return run Semantic.demandSignatureOf(&mut semantic.*, &mut request.*, &identity)
}

test effect fn coherenceBeforeApplicability() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run coherenceClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// The coherence answer of a module's `occurrence`th `impl`, addressed by its identity.
effect fn coherenceOf(
  semantic: &mut Semantic,
  request: &mut Request,
  revision: &Revision,
  module: &ModuleId,
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let identity = run requireIdentity(revision, module, OwnerKind.Implementation, b"", occurrence)
  return run Semantic.demandCoherence(&mut semantic.*, &mut request.*, &identity)
}

fn coherent(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(value: &Result<Answer, NoRejection>) -> bool {
      return match & value.* {
        Result<Answer, NoRejection>.Success {value: found} => match & found.outcome {
          Outcome.Success {value: result} => match & result {
            Value.Coherent => true
            _ => false
          }
          _ => false
        }
        Result<Answer, NoRejection>.Failure {error: _} => false
      }
    },
  )
}

fn pathIs(path: &Vector<Shared<DeclarationId>>, primary: &DeclarationId, related: &DeclarationId) -> bool {
  let listed = Vector.asSlice<Shared<DeclarationId>>(path)
  if listed.length != 2 {
    return false
  }
  let first = Shared.with<DeclarationId, bool>(
    &listed[usize.ZERO],
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.equals(value, primary)
    },
  )
  let second = Shared.with<DeclarationId, bool>(
    &listed[usize.ONE],
    fn(value: &DeclarationId) -> bool {
      return DeclarationId.equals(value, related)
    },
  )
  return first && second
}

// A conflict anchored at the primary head in `module`, naming the primary then the related head.
fn conflictIs(
  answer: &Shared<Result<Answer, NoRejection>>,
  code: RejectionCode,
  module: &ModuleId,
  start: usize,
  primary: &DeclarationId,
  related: &DeclarationId,
) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == code && ModuleId.equals(&diagnostic.module, module) && diagnostic.span.start == start && pathIs(
          &diagnostic.path,
          primary,
          related,
        )
      },
    )
  }
  return false
}

fn terminatesAt(answer: &Shared<Result<Answer, NoRejection>>, step: TerminationStep, start: usize) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        return diagnostic.code == RejectionCode.NonterminatingConformance && diagnostic.termination == step && diagnostic.span.start == start
      },
    )
  }
  return false
}

// Both heads of a pair report the same conflict: `later` primary, `earlier` related.
effect fn pairConflicts(
  semantic: &mut Semantic,
  request: &mut Request,
  revision: &Revision,
  module: &ModuleId,
  earlier: usize,
  later: usize,
  code: RejectionCode,
  start: usize,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let primary = run requireIdentity(revision, module, OwnerKind.Implementation, b"", later)
  let related = run requireIdentity(revision, module, OwnerKind.Implementation, b"", earlier)
  let first = run coherenceOf(&mut semantic.*, &mut request.*, revision, module, earlier)
  let second = run coherenceOf(&mut semantic.*, &mut request.*, revision, module, later)
  return conflictIs(&first, code, module, start, &primary, &related) && conflictIs(
    &second,
    code,
    module,
    start,
    &primary,
    &related,
  )
}

effect fn pairCoherent(
  semantic: &mut Semantic,
  request: &mut Request,
  revision: &Revision,
  module: &ModuleId,
  earlier: usize,
  later: usize,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> ? &mut Allocator {
  let first = run coherenceOf(&mut semantic.*, &mut request.*, revision, module, earlier)
  let second = run coherenceOf(&mut semantic.*, &mut request.*, revision, module, later)
  return coherent(&first) && coherent(&second)
}

fn providerOf(head: &Option<Shared<ImplementationHead>>) -> Option<Shared<Type>> {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Option.some<Shared<Type>>(
      Shared.with<ImplementationHead, Shared<Type>>(
        &value,
        fn(found: &ImplementationHead) -> Shared<Type> {
          return Shared.clone<Type>(&found.provider)
        },
      ),
    )
  }
  return Option.none<Shared<Type>>()
}

fn contractOf(head: &Option<Shared<ImplementationHead>>) -> Option<Shared<Type>> {
  if let Option<Shared<ImplementationHead>>.Some {value} = &head.* {
    return Shared.with<ImplementationHead, Option<Shared<Type>>>(
      &value,
      fn(found: &ImplementationHead) -> Option<Shared<Type>> {
        if let Option<Shared<Type>>.Some {value: contract} = &found.contract {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&contract))
        }
        return Option.none<Shared<Type>>()
      },
    )
  }
  return Option.none<Shared<Type>>()
}

effect fn coherenceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let local = run module("local.silk")
  let sets = run module("sets.silk")
  let shapes = run module("shapes.silk")
  let contracts = run module("contracts.silk")
  let model = run module("model.silk")
  let facade = run module("facade.silk")
  let unrelated = run module("unrelated.silk")
  let boundSet = run module("bound-set.silk")
  let localText = "struct Box<T> {\n  value: T\n}\nstruct Pair<A, B> {\n  first: A\n  second: B\n}\nstruct Settings {}\nstruct User {}\ninterface Left {}\ninterface Right {}\ninterface Show {}\ninterface Display {}\ninterface Bounded {}\nimpl<T: Left> Bounded for Box<T> {}\nimpl<T: Right> Bounded for Box<T> {}\ninterface Special {}\nimpl<T: Show> Special for Box<T> {}\nimpl Special for Box<i32> {}\ninterface Twice {}\nimpl Twice for User {}\nimpl Twice for User {}\ninterface Occurs {}\nimpl<T> Occurs for Pair<T, T> {}\nimpl<A> Occurs for Pair<A, Box<A>> {}\ninterface Free {}\nimpl<T> Free for User {}\ninterface Pick<T> {}\nimpl<T: Show> Pick<T> for Settings {}\ninterface Eq2<T> {}\nimpl<T: Eq2<Pair<T, T>>> Eq2<T> for Box<T> {}\ninterface Fixed<T> {}\nimpl<T: Fixed<bool>> Fixed<i32> for Box<T> {}\ninterface Convert<T> {}\nimpl Convert<i32> for Settings {}\nimpl Convert<bool> for Settings {}\nimpl<T: Display> Display for Box<T> {}\ninterface Width {}\nimpl Width for Box<i32> {}\nimpl Width for Box<u8> {}\ninterface Permuted {}\nimpl<A, B> Permuted for Pair<A, B> {}\nimpl<X, Y> Permuted for Pair<Y, X> {}\ninterface Consistent<T> {}\nimpl<A, B> Consistent<A> for Pair<A, B> {}\nimpl<X, Y> Consistent<Y> for Pair<X, Y> {}\n"
  let setsText = "struct Box<T> {\n  value: T\n}\nstruct Settings {}\nservice Clock {}\nservice Logger {}\ninterface Absorb {}\nimpl<T> Absorb for Box<T | i32> {}\nimpl Absorb for Box<bool> {}\ninterface Contain {}\nimpl<T> Contain for Box<T | i32> {}\nimpl Contain for Box<i32 | bool> {}\ninterface Nested {}\nimpl<T> Nested for Box<Box<T> | i32> {}\nimpl Nested for Box<Box<u8> | i32> {}\ninterface RowKey<?R> {}\nimpl<?R> RowKey<? &Clock | R> for Settings {}\nimpl RowKey<? &Logger> for Settings {}\ninterface RowAccess<?R> {}\nimpl<?R> RowAccess<? &Clock | R> for Settings {}\nimpl RowAccess<? &mut Clock> for Settings {}\ninterface RowReverse<?R> {}\nimpl<?R> RowReverse<? &mut Clock | R> for Settings {}\nimpl RowReverse<? &Clock> for Settings {}\ninterface DuplicateUnion {}\nimpl<T> DuplicateUnion for Box<T | i32> {}\nimpl<U> DuplicateUnion for Box<U | i32> {}\ninterface DuplicateRow<?R> {}\nimpl<?R> DuplicateRow<? R> for Settings {}\nimpl<?S> DuplicateRow<? S> for Settings {}\ninterface PermutedUnion {}\nimpl<A, B> PermutedUnion for Box<A | B> {}\nimpl<X, Y> PermutedUnion for Box<Y | X> {}\nservice S<'a> {}\ninterface MixedAccess<?R> {}\nimpl<'b, 'c> MixedAccess<? &S<'b> | &mut S<'c>> for Settings {}\nimpl<'z, 'y> MixedAccess<? &mut S<'z> | &S<'y>> for Settings {}\ninterface Collapse<?R> {}\nimpl<'a, 'b> Collapse<? &S<'a> | &mut S<'b>> for Settings {}\nimpl Collapse<? &mut S<'static>> for Settings {}\ninterface DistinctCount<?R> {}\nimpl DistinctCount<? &Clock> for Settings {}\nimpl DistinctCount<? &Clock | &Logger> for Settings {}\nservice Channel<T> {}\ninterface Parameterized<?R> {}\nimpl<T> Parameterized<? &Channel<T>> for Settings {}\nimpl Parameterized<? &Channel<i32>> for Settings {}\nstruct Pair<A, B> {}\ninterface SharedNested {}\nimpl<T> SharedNested for Box<Box<T> | Pair<T, T>> {}\nimpl SharedNested for Box<Box<u8> | Pair<u8, u8>> {}\ninterface SplitNested {}\nimpl<T> SplitNested for Box<Box<T> | Pair<T, T>> {}\nimpl SplitNested for Box<Box<u8> | Pair<u8, bool>> {}\ninterface KeyAccess<?R> {}\nimpl<T> KeyAccess<? &Channel<T>> for Settings {}\nimpl KeyAccess<? &mut Channel<i32>> for Settings {}\n"
  let shapesText = "struct Box<T> {\n  value: T\n}\nstruct View<'a> {\n  value: &'a i32\n}\ninterface Lasting {}\nimpl Lasting for View<'static> {}\nimpl<'a> Lasting for View<'a> {}\ninterface Calls {}\nimpl Calls for Box<fn<'static>(&i32) -> &i32> {}\nimpl Calls for Box<for<'a, 'b> fn<'static>(&'a i32) -> &'b i32> {}\ninterface DuplicateCalls {}\nimpl DuplicateCalls for Box<for<'a> fn<'static>(&'a i32) -> &'a i32> {}\nimpl DuplicateCalls for Box<for<'b> fn<'static>(&'b i32) -> &'b i32> {}\ninterface BoundedLife {}\nimpl<'a: 'static> BoundedLife for View<'a> {}\nimpl<'b> BoundedLife for View<'b> {}\n"
  let contractsText = "import facade { User as Person }\nimport unrelated { Noise }\npub interface Marker {}\nimpl Marker for Person {}\nfn unused(value: Noise) -> i32 { return 0 }\n"
  let modelText = "import contracts { Marker }\npub struct User {}\nimpl Marker for User {}\n"
  let boundSetText = "struct Box<T> { value: T }\nfn left<'a>(value: Box<for<'b: 'a> fn<'static>(&'b i32) -> i32> | bool) -> i32 { return 0 }\nfn right<'c>(value: Box<for<'d: 'c> fn<'static>(&'d i32) -> i32> | bool) -> i32 { return 0 }\nfn retained<'a>(callback: for<'b: 'a> fn<'static>(&'b i32) -> i32) -> i32 { return 0 }\n"
  let localSource = run present(localText)
  let setsSource = run present(setsText)
  let shapesSource = run present(shapesText)
  let contractsSource = run present(contractsText)
  let modelSource = run present(modelText)
  let facadeSource = run present("pub import model { User }\n")
  let unrelatedSource = run present("pub struct Noise {}\n")
  let boundSetSource = run present(boundSetText)
  let r1 = run Revision.publish(&Revision.make(), &local, &localSource)
  let r2 = run Revision.publish(&r1, &sets, &setsSource)
  let r3 = run Revision.publish(&r2, &shapes, &shapesSource)
  let r4 = run Revision.publish(&r3, &contracts, &contractsSource)
  let r5 = run Revision.publish(&r4, &model, &modelSource)
  let r6 = run Revision.publish(&r5, &facade, &facadeSource)
  let r7 = run Revision.publish(&r6, &unrelated, &unrelatedSource)
  let revision = run Revision.publish(&r7, &boundSet, &boundSetSource)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()

  // IMPL-007: bounds never make heads distinct, and neither head of a conflict is admitted.
  let bounded = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &local,
    usize.ZERO,
    usize.ONE,
    RejectionCode.OverlappingConformance,
    offsetOf(localText, "impl<T: Right>", 0),
  )
  run Testing.expect(bounded, "heads that differ only in bounds overlap, and both report the later head")
  let special = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &local,
    2,
    3,
    RejectionCode.OverlappingConformance,
    offsetOf(localText, "impl Special for Box<i32>", 0),
  )
  run Testing.expect(special, "a concrete head overlapping a generic one is not ranked above it")
  let twice = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &local,
    4,
    5,
    RejectionCode.DuplicateConformance,
    offsetOf(localText, "impl Twice for User", 1),
  )
  run Testing.expect(twice, "two unbounded identical heads are duplicates")
  let occurs = run pairCoherent(&mut semantic, &mut request, &revision, &local, 6, 7)
  run Testing.expect(occurs, "heads that could only agree on an infinite type are distinct")
  let free = run coherenceOf(&mut semantic, &mut request, &revision, &local, 8)
  run Testing.expect(
    rejectsFrom(&free, RejectionCode.UnconstrainedImplParameter, offsetOf(localText, "T> Free", 0)),
    "a parameter absent from the head is rejected at its binder",
  )
  let peer = run coherenceOf(&mut semantic, &mut request, &revision, &local, 9)
  let duplicated = run coherenceOf(&mut semantic, &mut request, &revision, &local, 10)
  let fixed = run coherenceOf(&mut semantic, &mut request, &revision, &local, 11)
  run Testing.expect(
    terminatesAt(&peer, TerminationStep.Peer, offsetOf(localText, "Show> Pick", 0)) && terminatesAt(
      &duplicated,
      TerminationStep.DuplicatedParameter,
      offsetOf(localText, "Eq2<Pair<T, T>>", 0),
    ) && terminatesAt(&fixed, TerminationStep.ChangedFixedArgument, offsetOf(localText, "Fixed<bool>>", 0)),
    "peer, duplicating and fixed-argument-rewriting bounds are rejected at the bound",
  )
  let converts = run pairCoherent(&mut semantic, &mut request, &revision, &local, 12, 13)
  let display = run coherenceOf(&mut semantic, &mut request, &revision, &local, 14)
  let widths = run pairCoherent(&mut semantic, &mut request, &revision, &local, 15, 16)
  run Testing.expect(
    converts && coherent(&display) && widths,
    "distinct interface applications, a descending bound and distinct providers are coherent",
  )

  let permuted = run pairConflicts(
    &mut semantic, &mut request, &revision, &local, 17, 18,
    RejectionCode.DuplicateConformance,
    offsetOf(localText, "impl<X, Y> Permuted", 0),
  )
  let inconsistent = run pairConflicts(
    &mut semantic, &mut request, &revision, &local, 19, 20,
    RejectionCode.OverlappingConformance,
    offsetOf(localText, "impl<X, Y> Consistent", 0),
  )
  run Testing.expect(permuted && inconsistent, "alpha maps permute binders and must agree across contract and provider")

  let localHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &local)
  let consistentLeft = headAt(&localHeads, 19)
  let consistentRight = headAt(&localHeads, 20)
  let leftContract = contractOf(&consistentLeft)
  let rightContract = contractOf(&consistentRight)
  let sharedProvider = providerOf(&consistentLeft)
  let mut aliasedMapControl = false
  if let Option<Shared<Type>>.Some {value: fromContract} = move leftContract {
    if let Option<Shared<Type>>.Some {value: toContract} = move rightContract {
      if let Option<Shared<Type>>.Some {value: provider} = move sharedProvider {
        let identity = run Type.alphaEquivalent(&fromContract, &provider, &fromContract, &provider, 2)
        let swapped = run Type.alphaEquivalent(&fromContract, &provider, &toContract, &provider, 2)
        aliasedMapControl = identity && !swapped
      }
    }
  }
  run Testing.expect(aliasedMapControl, "an aliased provider still rejects a nonidentity binder map")

  // Sets decide only their containment fragment; access in a row can strengthen, never weaken.
  let absorbed = run pairCoherent(&mut semantic, &mut request, &revision, &sets, usize.ZERO, usize.ONE)
  let contained = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &sets,
    2,
    3,
    RejectionCode.OverlappingConformance,
    offsetOf(setsText, "impl Contain for Box<i32 | bool>", 0),
  )
  run Testing.expect(absorbed, "an open union does not overlap a set missing its fixed member")
  run Testing.expect(contained, "an open union overlaps a set containing its fixed members")
  let nested = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &sets,
    4,
    5,
    RejectionCode.OverlappingConformance,
    offsetOf(setsText, "impl Nested for Box<Box<u8> | i32>", 0),
  )
  run Testing.expect(
    nested,
    "a union member nested under a nominal parameter overlaps its concrete application",
  )
  let keyed = run pairCoherent(&mut semantic, &mut request, &revision, &sets, 6, 7)
  let strengthened = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &sets,
    8,
    9,
    RejectionCode.OverlappingConformance,
    offsetOf(setsText, "impl RowAccess<? &mut Clock>", 0),
  )
  let weakened = run pairCoherent(&mut semantic, &mut request, &revision, &sets, 10, 11)
  run Testing.expect(
    keyed && strengthened && weakened,
    "an open row covers a closed row only with its keys at no weaker access",
  )

  let duplicateUnion = run pairConflicts(
    &mut semantic, &mut request, &revision, &sets, 12, 13,
    RejectionCode.DuplicateConformance,
    offsetOf(setsText, "impl<U> DuplicateUnion", 0),
  )
  let duplicateRow = run pairConflicts(
    &mut semantic, &mut request, &revision, &sets, 14, 15,
    RejectionCode.DuplicateConformance,
    offsetOf(setsText, "impl<?S> DuplicateRow", 0),
  )
  let permutedUnion = run pairConflicts(
    &mut semantic, &mut request, &revision, &sets, 16, 17,
    RejectionCode.DuplicateConformance,
    offsetOf(setsText, "impl<X, Y> PermutedUnion", 0),
  )
  run Testing.expect(duplicateUnion && duplicateRow && permutedUnion, "alpha-identical open unions and rows are duplicates under binder permutation")
  let mixedAccess = run pairConflicts(
    &mut semantic, &mut request, &revision, &sets, 18, 19,
    RejectionCode.DuplicateConformance,
    offsetOf(setsText, "impl<'z, 'y> MixedAccess", 0),
  )
  run Testing.expect(mixedAccess, "reordered row keys choose a candidate with matching access in both directions")
  let collapsed = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &sets,
    20,
    21,
    RejectionCode.OverlappingConformance,
    offsetOf(setsText, "impl Collapse<? &mut S<'static>>", 0),
  )
  run Testing.expect(
    collapsed,
    "projected lifetime keys collapse to the strongest closed-row access before coherence",
  )
  let distinctCount = run pairCoherent(&mut semantic, &mut request, &revision, &sets, 22, 23)
  run Testing.expect(distinctCount, "closed rows with different keys and no projected collision remain distinct")
  let parameterized = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &sets,
    24,
    25,
    RejectionCode.OverlappingConformance,
    offsetOf(setsText, "impl Parameterized<? &Channel<i32>>", 0),
  )
  run Testing.expect(parameterized, "parameterized row keys share exact evidence across a coherent pairing")
  let repeatedNested = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &sets,
    26,
    27,
    RejectionCode.OverlappingConformance,
    offsetOf(setsText, "impl SharedNested for Box<Box<u8>", 0),
  )
  let splitNested = run pairCoherent(&mut semantic, &mut request, &revision, &sets, 28, 29)
  run Testing.expect(
    repeatedNested && splitNested,
    "repeated variables inside set members share one assignment and reject contradictory evidence",
  )
  let keyAccess = run pairCoherent(&mut semantic, &mut request, &revision, &sets, 30, 31)
  run Testing.expect(keyAccess, "a parameterized closed-row key cannot strengthen fixed shared access")

  // Coherence compares heads with lifetimes erased; their exact identities stay distinct.
  let lasting = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &shapes,
    usize.ZERO,
    usize.ONE,
    RejectionCode.OverlappingConformance,
    offsetOf(shapesText, "impl<'a> Lasting", 0),
  )
  let calls = run pairConflicts(
    &mut semantic,
    &mut request,
    &revision,
    &shapes,
    2,
    3,
    RejectionCode.OverlappingConformance,
    offsetOf(shapesText, "impl Calls for Box<for", 0),
  )
  let duplicateCalls = run pairConflicts(
    &mut semantic, &mut request, &revision, &shapes, 4, 5,
    RejectionCode.DuplicateConformance,
    offsetOf(shapesText, "impl DuplicateCalls for Box<for<'b>", 0),
  )
  let boundedLife = run pairConflicts(
    &mut semantic, &mut request, &revision, &shapes, 6, 7,
    RejectionCode.OverlappingConformance,
    offsetOf(shapesText, "impl<'b> BoundedLife", 0),
  )
  run Testing.expect(duplicateCalls && boundedLife, "quantified callable identity is exact, and outlives bounds prevent duplicate classification")
  let heads = run Semantic.demandImplementations(&mut semantic, &mut request, &shapes)
  let elided = providerOf(&headAt(&heads, 2))
  let quantified = providerOf(&headAt(&heads, 3))
  let mut exactDistinct = false
  if let Option<Shared<Type>>.Some {value: left} = &elided {
    if let Option<Shared<Type>>.Some {value: right} = &quantified {
      exactDistinct = !run Type.equalsShared(&left, &right)
    }
  }
  run Testing.expect(
    lasting && calls && exactDistinct,
    "heads differing only in lifetimes or invocation binders overlap without becoming duplicates",
  )

  let leftSignature = run Semantic.demandSignature(&mut semantic, &mut request, &boundSet, b"left")
  let rightSignature = run Semantic.demandSignature(&mut semantic, &mut request, &boundSet, b"right")
  let leftParameter = slotOf(&leftSignature, usize.ZERO)
  let rightParameter = slotOf(&rightSignature, usize.ZERO)
  let mut boundSetUndetermined = false
  if let Option<Shared<Type>>.Some {value: first} = move leftParameter {
    if let Option<Shared<Type>>.Some {value: second} = move rightParameter {
      let leftOwner = run requireIdentity(&revision, &boundSet, OwnerKind.Function, b"left", usize.ZERO)
      let rightOwner = run requireIdentity(&revision, &boundSet, OwnerKind.Function, b"right", usize.ZERO)
      let mut variables = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(move leftOwner))
      run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(move rightOwner))
      let mut bindings = Vector.make<Binding>()
      let result = run Type.unify(
        &first, &second, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut bindings,
      )
      boundSetUndetermined = match & result {
        Unification.Undetermined {..} => Vector.length<Binding>(&bindings) == usize.ZERO
        _ => false
      }
    }
  }
  run Testing.expect(boundSetUndetermined, "an outer lifetime used by a quantified set member's bound is undecided in exact matching")
  let retainedSignature = run Semantic.demandSignature(&mut semantic, &mut request, &boundSet, b"retained")
  let retainedParameter = slotOf(&retainedSignature, usize.ZERO)
  let mut staticCapture = false
  if let Option<Shared<Type>>.Some {value: callable} = move retainedParameter {
    let owner = run requireIdentity(&revision, &boundSet, OwnerKind.Function, b"retained", usize.ZERO)
    let representations = Vector.make<Option<Shared<Type>>>()
    let mut regions = Vector.make<Shared<Lifetime>>()
    let known = run Type.retainedRegions(
      &callable, &owner, Vector.asSlice<Option<Shared<Type>>>(&representations), &mut regions,
    )
    staticCapture = known && Vector.length<Shared<Lifetime>>(&regions) == usize.ZERO
  }
  run Testing.expect(staticCapture, "a static callable environment retains none of its invocation-bound lifetimes")

  // D09: the interface's and the provider's modules form one bucket, through a facade alias, and
  // the pair reports the canonically later module's head whatever the demand order.
  let modelImpl = run requireIdentity(&revision, &model, OwnerKind.Implementation, b"", usize.ZERO)
  let contractsImpl = run requireIdentity(&revision, &contracts, OwnerKind.Implementation, b"", usize.ZERO)
  let modelStart = offsetOf(modelText, "impl Marker for User", 0)
  let viaContracts = run Semantic.demandCoherence(&mut semantic, &mut request, &contractsImpl)
  let viaModel = run Semantic.demandCoherence(&mut semantic, &mut request, &modelImpl)
  let coldStarts = starts(Semantic.eventLog(&semantic), Family.Coherence)
  let again = run Semantic.demandCoherence(&mut semantic, &mut request, &contractsImpl)
  let warm = starts(Semantic.eventLog(&semantic), Family.Coherence) == coldStarts && hits(
    Semantic.eventLog(&semantic),
    Family.Coherence,
  ) > usize.ZERO
  run Testing.expect(
    conflictIs(&viaContracts, RejectionCode.DuplicateConformance, &model, modelStart, &modelImpl, &contractsImpl) && conflictIs(
      &viaModel,
      RejectionCode.DuplicateConformance,
      &model,
      modelStart,
      &modelImpl,
      &contractsImpl,
    ) && conflictIs(&again, RejectionCode.DuplicateConformance, &model, modelStart, &modelImpl, &contractsImpl) && warm,
    "owner modules of both endpoints conflict through a facade, reported alike cold and warm",
  )
  run Testing.expect(
    reads(Semantic.sourceEvents(&semantic), &unrelated) == usize.ZERO,
    "coherence reads no body-only import of an owner module",
  )
  let mut reversed = Semantic.make(run Revision.copy(&revision))
  let mut reversedRequest = Request.make()
  let modelFirst = run Semantic.demandCoherence(&mut reversed, &mut reversedRequest, &modelImpl)
  let contractsSecond = run Semantic.demandCoherence(&mut reversed, &mut reversedRequest, &contractsImpl)
  run Testing.expect(
    conflictIs(&modelFirst, RejectionCode.DuplicateConformance, &model, modelStart, &modelImpl, &contractsImpl) && conflictIs(
      &contractsSecond,
      RejectionCode.DuplicateConformance,
      &model,
      modelStart,
      &modelImpl,
      &contractsImpl,
    ),
    "the reversed demand order in a fresh store reports the same pair",
  )
  return ()
}

test effect fn inherentHeadsMembersAndRefinements() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run inherentClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn inherentClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let owners = run module("owners.silk")
  let external = run module("external.silk")
  let text = "import external { Foreign }\nstruct Counter {\n  count: i32\n}\nstruct Pair<A, B> {}\ntype Alias = Counter\nenum Status { Ready }\nimpl Counter {\n  fn value(counter: &Self) -> i32 { return 0 }\n  fn count(counter: &Self) -> i32 { return 0 }\n}\nimpl Counter {\n  fn value(other: &Self) -> i32 { return 1 }\n  fn reset() -> Self { return () }\n  measure: Counter.reset\n  fn drop(counter: &mut Self) -> () { return () }\n}\nimpl<A, B> Pair<A, B> {\n  fn first<A: Copy>(pair: &Self, value: A) -> A { return move value }\n  fn left(value: A) -> A { return move value }\n  fn plain() -> i32 { return 0 }\n}\nimpl Pair<i32, bool> {\n  fn special() -> i32 { return 0 }\n}\nimpl<A, B> Pair<B, A> {\n  fn swapped() -> i32 { return 0 }\n}\nimpl<A: Copy, B> Pair<A, B> {\n  fn bounded() -> Self { return () }\n}\nimpl Alias {\n  fn aliased() -> i32 { return 0 }\n}\nimpl Foreign {\n  fn mine() -> i32 { return 0 }\n}\nimpl Status {\n  fn value() -> i32 { return 0 }\n}\nstruct Twice {}\nimpl Twice {\n  fn same() -> i32 { return 0 }\n  fn same() -> bool { return true }\n}\nstruct Rowed<?R> {}\nimpl<?R> Rowed<? R> {\n  fn rowed() -> i32 { return 0 }\n  fn clash<R>() -> i32 { return 0 }\n}\nstruct Held<'a> {\n  value: &'a i32\n}\nimpl<'a> Held<'a> {\n  effect<'a> fn retained() -> i32 { return 0 }\n}\nimpl Copy for Status {}\nservice Clock {}\nrole Primary\nstruct Routed<?H> {}\nimpl<?H> Routed<H> {\n  fn routed() -> i32 { return 0 }\n}\nfn served(value: Routed<&Clock at Primary>) -> i32 { return 0 }\nfn mismatched(value: Routed<i32>) -> i32 { return 0 }\nfn extra(value: Routed<&Clock ? &Clock>) -> i32 { return 0 }\nstatic if true {\n  fn conditional<T>(value: T) -> T { return move value }\n}\n"
  let ownersSource = run present(text)
  let externalSource = run present("pub struct Foreign {}\n")
  let first = run Revision.publish(&Revision.make(), &owners, &ownersSource)
  let revision = run Revision.publish(&first, &external, &externalSource)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let counter = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Counter")
  let counterPublished = Shared.with<Result<Answer, NoRejection>, usize>(
    &counter,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return inherentCount(answer, true)
    },
  )
  let counterRejected = Shared.with<Result<Answer, NoRejection>, usize>(
    &counter,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return inherentCount(answer, false)
    },
  )
  run Testing.expect(
    counterPublished == usize.ONE && counterRejected == 5,
    "duplicates, field collisions, mappings and Drop hooks publish nothing and choose no winner",
  )
  let pair = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Pair")
  let status = run Semantic.demandInherentMembers(&mut semantic, &mut request, &owners, b"Status")
  let pairPublished = Shared.with<Result<Answer, NoRejection>, usize>(
    &pair,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return inherentCount(answer, true)
    },
  )
  let statusRejected = Shared.with<Result<Answer, NoRejection>, usize>(
    &status,
    fn(answer: &Result<Answer, NoRejection>) -> usize {
      return inherentCount(answer, false)
    },
  )
  run Testing.expect(
    pairPublished == 3 && statusRejected == usize.ONE,
    "rejected heads publish no member and a generated enum operation keeps its name",
  )
  let special = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"special", 0)
  let swapped = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"swapped", 0)
  let bounded = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"bounded", 0)
  let aliased = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"aliased", 0)
  let foreign = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"mine", 0)
  let specialAt = rejectsFrom(&special, RejectionCode.InvalidInherentHead, offsetOf(text, "Pair<i32", 0))
  let swappedAt = rejectsFrom(&swapped, RejectionCode.InvalidInherentHead, offsetOf(text, "Pair<B, A>", 0))
  let boundedAt = rejectsFrom(
    &bounded,
    RejectionCode.InvalidInherentHead,
    offsetOf(text, "Pair<A, B> {\n  fn bounded", 0),
  )
  let aliasedAt = rejectsFrom(&aliased, RejectionCode.InvalidInherentHead, offsetOf(text, "Alias {", 0))
  let foreignAt = rejectsFrom(&foreign, RejectionCode.InvalidInherentHead, offsetOf(text, "Foreign {", 0))
  run Testing.expect(
    specialAt && swappedAt && boundedAt && aliasedAt && foreignAt,
    "specialized, reordered, bounded, alias and foreign inherent heads report only the head",
  )
  let refined = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"first", 0)
  // `first` names `Self`, so its contract lists both owner binders and adds no binder of its own.
  let ownerPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&refined, ownBinderCount) == 2
  let refinedBound = Shared.with<Result<Answer, NoRejection>, bool>(&refined, copyBoundOnly)
  run Testing.expect(
    ownerPrefix && refinedBound,
    "an inherent member restating an owner binder bounds the owner's parameter for itself",
  )
  let left = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Pair", b"left")
  let plain = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Pair", b"plain")
  let leftPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&left, ownBinderCount) == usize.ONE
  let plainPrefix = Shared.with<Result<Answer, NoRejection>, usize>(&plain, ownBinderCount) == usize.ZERO
  run Testing.expect(
    leftPrefix && plainPrefix,
    "a member's contract lists only the owner binders it mentions",
  )
  let duplicated = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"value")
  let claimed = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"count")
  let reset = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"reset")
  let absent = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Counter", b"absent")
  let twice = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"same", 0)
  let twiceAgain = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"same", 1)
  let duplicatedAt = rejectsAt(&duplicated, RejectionCode.Collision)
  let claimedAt = rejectsAt(&claimed, RejectionCode.InvalidInherentMember)
  let resetView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&reset, inspect)
  let absentAt = rejectsAt(&absent, RejectionCode.UnknownMember)
  let twiceAt = rejectsFrom(&twice, RejectionCode.Collision, offsetOf(text, "fn same() -> bool", 0)) && rejectsFrom(
    &twiceAgain,
    RejectionCode.Collision,
    offsetOf(text, "fn same() -> bool", 0),
  )
  run Testing.expect(
    duplicatedAt && claimedAt && resetView.success && absentAt && twiceAt,
    "member lookups return the kept rejection for duplicates and claimed names and never a winner",
  )
  let signatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let leftById = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"left", 0)
  let valueAgain = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"value", 1)
  let sameLeft = run resultEquals(&left, &leftById)
  let noRestart = starts(Semantic.eventLog(&semantic), Family.Signature) == signatureStarts
  run Testing.expect(
    sameLeft && noRestart && rejectsAt(&valueAgain, RejectionCode.Collision),
    "an identity-addressed member shares the name lookup's answer, and each duplicate identity rejects",
  )
  let conditional = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"conditional", 0)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&conditional, signatureHasOrdinaryBinder),
    "a function in a static conditional sees no enclosing binders or `Self`",
  )
  let firstValue = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"value", 0)
  let firstCount = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"count", 0)
  let crossDuplicate = rejectsAt(&firstValue, RejectionCode.Collision)
  let fieldClaimed = rejectsAt(&firstCount, RejectionCode.InvalidInherentMember)
  run Testing.expect(
    crossDuplicate && fieldClaimed,
    "an impl-addressed inherent member obeys owner-wide uniqueness across impl blocks",
  )
  let rowed = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"rowed", 0)
  let clash = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"clash", 0)
  let retained = run Semantic.demandInherentMember(&mut semantic, &mut request, &owners, b"Held", b"retained")
  let rowedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&rowed, inspect)
  let clashAt = rejectsFrom(&clash, RejectionCode.DuplicateTypeParameter, offsetOf(text, "clash<R>", 0) + 6)
  let environmentOwner = Shared.with<Result<Answer, NoRejection>, usize>(&retained, lifetimeCountOf) == usize.ONE
  run Testing.expect(
    rowedView.success && clashAt && environmentOwner,
    "row owner binders form a whole family, a restated binder of another kind rejects, and a written environment names owner lifetimes",
  )
  let sealedHeads = run Semantic.demandImplementations(&mut semantic, &mut request, &owners)
  let sealedEnum = rejectsFrom(
    &sealedHeads,
    RejectionCode.InvalidCopyConformance,
    offsetOf(text, "impl Copy for Status", 0),
  )
  run Testing.expect(sealedEnum, "a scalar enum cannot request Copy by implementation")
  let routed = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"routed", 0)
  let suffixed = run signatureNamed(&mut semantic, &mut request, &revision, &owners, b"rowed", 0)
  let served = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"served")
  let mismatched = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"mismatched")
  let routedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&routed, inspect)
  let suffixedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&suffixed, inspect)
  let servedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&served, inspect)
  let mismatchedKind = rejectsFrom(&mismatched, RejectionCode.TypeArgumentKind, offsetOf(text, "i32>) -> i32", 0))
  let extra = run Semantic.demandSignature(&mut semantic, &mut request, &owners, b"extra")
  let extraSuffix = rejectsAt(&extra, RejectionCode.TypeArity)
  run Testing.expect(
    routedView.success && suffixedView.success && servedView.success && mismatchedKind && extraSuffix,
    "a requirement row binder takes a positional or suffixed row argument, and a value type there is a kind error",
  )
  return ()
}

test effect fn importBindingsPreludeAndDemandOrder() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bindingClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bindingClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("bindings.silk")
  let lib = run module("lib.silk")
  let other = run module("other.silk")
  let clashing = run module("clashing.silk")
  let entryText = "import lib { Item }\nimport lib { Item }\nimport lib as lib\nimport lib\nfn twice(value: Item) -> i32 { return 0 }\nfn qualified(value: lib.Item) -> i32 { return 0 }\nfn prelude(value: Option<i32>) -> i32 { return 0 }\neffect fn fails<E>() -> i32 ! E { return 0 }\nfn marked<!E>() -> i32 { return 0 }\n"
  let clashingText = "import lib { Item }\nimport other { Item }\nfn clash(value: Item) -> i32 { return 0 }\n"
  let entrySource = run present(entryText)
  let libSource = run present("pub struct Item {}\n")
  let otherSource = run present("pub struct Item {}\n")
  let clashingSource = run present(clashingText)
  let r1 = run Revision.publish(&Revision.make(), &lib, &libSource)
  let r2 = run Revision.publish(&r1, &other, &otherSource)
  let r3 = run Revision.publish(&r2, &clashing, &clashingSource)
  let revision = run Revision.publish(&r3, &entry, &entrySource)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let twice = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"twice")
  let qualified = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"qualified")
  let clash = run Semantic.demandSignature(&mut semantic, &mut request, &clashing, b"clash")
  let twiceView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&twice, inspect)
  let qualifiedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&qualified, inspect)
  let sameItem = run answersEqual(&twice, &qualified, usize.ZERO)
  let stillClashes = rejectsAt(&clash, RejectionCode.Collision)
  run Testing.expect(
    twiceView.success && qualifiedView.success && sameItem && stillClashes,
    "a repeated identical import and a redundant alias are one binding; different imports still collide",
  )
  let prelude = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"prelude")
  let fails = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"fails")
  let marked = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"marked")
  let noPrelude = rejectsFrom(&prelude, RejectionCode.UnknownName, offsetOf(entryText, "Option<i32>", 0))
  let failsView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&fails, inspect)
  let markedView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&marked, inspect)
  run Testing.expect(
    noPrelude && failsView.success && !markedView.success,
    "no library name is implicit, and an ordinary failure parameter needs no `!E` binder",
  )
  let mut reversed = Semantic.make(move revision)
  let mut reversedRequest = Request.make()
  let clashFirst = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &clashing, b"clash")
  let qualifiedFirst = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &entry, b"qualified")
  let twiceLast = run Semantic.demandSignature(&mut reversed, &mut reversedRequest, &entry, b"twice")
  let reversedClash = rejectsAt(&clashFirst, RejectionCode.Collision)
  let reversedSame = run answersEqual(&twiceLast, &qualifiedFirst, usize.ZERO)
  let reversedTwice = run answersEqual(&twiceLast, &twice, usize.ZERO)
  run Testing.expect(
    reversedClash && reversedSame && reversedTwice,
    "binding answers do not depend on demand order",
  )
  return ()
}

test effect fn requestApplicationImportKeepsSelectionsSeparate() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run applicationImportClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn applicationImportClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("application-client.silk")
  let idle = run module("application-idle.silk")
  let namespace = run module("application-namespace.silk")
  let first = run module("runtime-first.silk")
  let second = run module("runtime-second.silk")
  let private = run module("runtime-private.silk")
  let entryText = "import Intrinsic.application { Item }\nfn consume(value: Item) -> i32 { return 0 }\n"
  let entrySource = run present(entryText)
  let idleSource = run present(
    "import Intrinsic.application { Item }\nfn idle(value: i32) -> i32 { return value }\n",
  )
  let namespaceSource = run present(
    "import Intrinsic.application\nfn consume(value: application.Item) -> i32 { return 0 }\n",
  )
  let firstSource = run present("pub struct Item {}\n")
  let secondSource = run present("pub struct Item {}\n")
  let privateSource = run present("struct Item {}\n")
  let r1 = run Revision.publish(&Revision.make(), &first, &firstSource)
  let r2 = run Revision.publish(&r1, &second, &secondSource)
  let r3 = run Revision.publish(&r2, &private, &privateSource)
  let r4 = run Revision.publish(&r3, &idle, &idleSource)
  let r5 = run Revision.publish(&r4, &namespace, &namespaceSource)
  let revision = run Revision.publish(&r5, &entry, &entrySource)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut firstRequest = Request.forApplication(run ModuleId.copy(&first))
  let mut secondRequest = Request.forApplication(run ModuleId.copy(&second))
  let mut absentRequest = Request.make()
  let firstUse = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &entry, b"consume")
  let namespaceUse = run Semantic.demandSignature(&mut semantic, &mut firstRequest, &namespace, b"consume")
  let secondUse = run Semantic.demandSignature(&mut semantic, &mut secondRequest, &entry, b"consume")
  let absentUse = run Semantic.demandSignature(&mut semantic, &mut absentRequest, &entry, b"consume")
  let distinct = !run answersEqual(&firstUse, &secondUse, usize.ZERO)
  let sameNamespace = run answersEqual(&firstUse, &namespaceUse, usize.ZERO)
  let missing = rejectsFrom(
    &absentUse,
    RejectionCode.MissingModule,
    offsetOf(entryText, "Intrinsic.application", usize.ZERO),
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&firstUse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&secondUse, inspect).success && sameNamespace && distinct && missing,
    "namespace and selective imports choose the request application; other bindings and absence stay separate",
  )
  let beforeHits = hits(Semantic.eventLog(&semantic), Family.Signature)
  let mut repeatRequest = Request.forApplication(run ModuleId.copy(&first))
  let firstAgain = run Semantic.demandSignature(&mut semantic, &mut repeatRequest, &entry, b"consume")
  let same = run answersEqual(&firstUse, &firstAgain, usize.ZERO)
  run Testing.expect(
    same && hits(Semantic.eventLog(&semantic), Family.Signature) > beforeHits,
    "an identical selected application reuses its completed signature",
  )
  let idleUse = run Semantic.demandSignature(&mut semantic, &mut absentRequest, &idle, b"idle")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&idleUse, inspect).success,
    "an unused application import does not demand a binding",
  )
  let mut privateRequest = Request.forApplication(run ModuleId.copy(&private))
  let privateUse = run Semantic.demandSignature(&mut semantic, &mut privateRequest, &entry, b"consume")
  run Testing.expect(
    rejectsAt(&privateUse, RejectionCode.PrivateMember),
    "selected application members obey ordinary import visibility",
  )
  let removed = run present("pub struct Other {}\n")
  let changed = run Revision.publish(&revision, &first, &removed)
  Semantic.revise(&mut semantic, move changed)
  let mut changedRequest = Request.forApplication(run ModuleId.copy(&first))
  let missingItem = run Semantic.demandSignature(&mut semantic, &mut changedRequest, &entry, b"consume")
  run Testing.expect(
    rejectsAt(&missingItem, RejectionCode.UnknownMember),
    "a selected application edit invalidates its imported member",
  )
  return ()
}

// Whether a signature records the sealed `wanted` property on some parameter.
fn recordsProperty(answer: &Result<Answer, NoRejection>, wanted: IntrinsicProperty) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let declared = Vector.asSlice<Constraint>(&signature.constraints)
      let mut at = usize.ZERO
      while at < declared.length {
        if let Constraint.Property {property, ..} = &declared[at] {
          let matches = match property {
            IntrinsicProperty.Detached => match wanted {
              IntrinsicProperty.Detached => true
              IntrinsicProperty.NonParking => false
            }
            IntrinsicProperty.NonParking => match wanted {
              IntrinsicProperty.Detached => false
              IntrinsicProperty.NonParking => true
            }
          }
          if matches {
            return true
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn parameterOwnedBy(answer: &Result<Answer, NoRejection>, slot: usize, name: &[u8]) -> bool {
  if let Option<Shared<Type>>.Some {value} = move typeAt(answer, slot) {
    return Shared.with<Type, bool>(
      &value,
      fn(found: &Type) -> bool {
        return match & found.* {
          Type.Parameter {declaration, ..} => DeclarationId.named(&declaration, name)
          _ => false
        }
      },
    )
  }
  return false
}

// The `occurrence`th identity of `kind` named `name` (any name when empty), or a failed expectation.
effect fn requireIdentity(
  revision: &Revision,
  module: &ModuleId,
  kind: OwnerKind,
  name: &[u8],
  occurrence: usize,
) -> DeclarationId ! Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let found = run identityOf(revision, module, kind, name, occurrence)
  if let Option<DeclarationId>.Some {value} = move found {
    return move value
  }
  run Testing.expect(false, "the fixture declares the addressed declaration")
  // Unreachable: the failed expectation has already ended the test.
  return run requireIdentity(revision, module, kind, name, occurrence)
}

test effect fn operationSignaturesUnderImplementations() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run operationUnderClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn operationUnderClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let contracts = run module("contracts.silk")
  let model = run module("model.silk")
  let witness = run module("witness.silk")
  let contractsText = "pub interface Convert<T> {\n  fn convert<U>(value: Self, other: U) -> T\n}\npub interface Hold<'a> {\n  fn hold(value: &Self) -> &'a i32\n}\npub service Clock {}\npub interface Needs<?R> {\n  fn pending(value: &Self) -> Effect<'static; i32 ? R>\n}\npub interface Other {\n  fn other(value: &Self) -> i32\n}\nstruct Hidden {}\npub interface Leaks {\n  fn leak(value: &Self) -> Hidden\n}\ninterface Quiet {\n  fn quiet(value: &Self) -> Hidden\n}\n"
  let modelText = "import contracts { Convert, Hold, Needs, Clock, Other }\nimport witness\npub struct Box<T> {\n  value: T\n}\npub struct Plain {}\nimpl Convert<i32> for Box<bool> {\n  convert: witness.convertBool\n}\nimpl Convert<bool> for Box<i32> {}\nimpl Hold<'static> for Plain {}\nimpl Needs<&Clock> for Plain {}\nimpl Other for Plain {}\nfn expectBoxBool(value: Box<bool>) -> i32 { return 0 }\nfn expectInt() -> i32 { return 0 }\nfn expectBool() -> bool { return true }\nfn expectStatic() -> &'static i32 { return () }\nfn expectPending() -> Effect<'static; i32 ? &Clock> { return () }\n"
  let contractsSource = run present(contractsText)
  let modelSource = run present(modelText)
  let witnessSource = run present("pub fn convertBool(value: i32) -> i32 { return 0 }\n")
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractsSource)
  let r2 = run Revision.publish(&r1, &model, &modelSource)
  let first = run Revision.publish(&r2, &witness, &witnessSource)
  let mut semantic = Semantic.make(run Revision.copy(&first))
  let mut request = Request.make()
  let boxBool = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 0)
  let boxInt = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 1)
  let plainHold = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 2)
  let plainNeeds = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 3)
  let plainOther = run requireIdentity(&first, &model, OwnerKind.Implementation, b"", 4)
  let convert = run requireIdentity(&first, &contracts, OwnerKind.Function, b"convert", 0)
  let hold = run requireIdentity(&first, &contracts, OwnerKind.Function, b"hold", 0)
  let pending = run requireIdentity(&first, &contracts, OwnerKind.Function, b"pending", 0)
  let other = run requireIdentity(&first, &contracts, OwnerKind.Function, b"other", 0)
  let underBool = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let underInt = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxInt, &convert)
  let expectBoxBool = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectBoxBool")
  let expectInt = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectInt")
  let expectBool = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectBool")
  let selfBound = run answersEqual(&underBool, &expectBoxBool, usize.ZERO)
  let resultInt = run resultEquals(&underBool, &expectInt)
  let resultBool = run resultEquals(&underInt, &expectBool)
  let distinct = !(run resultEquals(&underBool, &underInt))
  let ownRigid = Shared.with<Result<Answer, NoRejection>, bool>(
    &underBool,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return parameterOwnedBy(answer, usize.ONE, b"convert")
    },
  )
  run Testing.expect(
    selfBound && resultInt && resultBool && distinct && ownRigid,
    "each conformance head binds the contract's T and Self in one operation while its own U stays its parameter",
  )
  let underHold = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainHold, &hold)
  let underNeeds = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainNeeds, &pending)
  let expectStatic = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectStatic")
  let expectPending = run Semantic.demandSignature(&mut semantic, &mut request, &model, b"expectPending")
  let staticBound = run resultEquals(&underHold, &expectStatic)
  let rowBound = run resultEquals(&underNeeds, &expectPending)
  let foreign = run Semantic.demandOperationUnder(&mut semantic, &mut request, &plainOther, &convert)
  let foreignAt = rejectsFrom(&foreign, RejectionCode.UnknownMember, offsetOf(modelText, "Other for Plain", 0))
  run Testing.expect(
    staticBound && rowBound && foreignAt,
    "contract lifetime and row arguments bind too, and another contract's operation is not a member",
  )
  let named = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Convert", b"convert")
  let signatureStarts = starts(Semantic.eventLog(&semantic), Family.Signature)
  let byIdentity = run Semantic.demandSignatureOf(&mut semantic, &mut request, &convert)
  let sameAnswer = run resultEquals(&named, &byIdentity)
  let noRestart = starts(Semantic.eventLog(&semantic), Family.Signature) == signatureStarts
  let leak = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Leaks", b"leak")
  let quiet = run Semantic.demandOperation(&mut semantic, &mut request, &contracts, b"Quiet", b"quiet")
  let quietView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&quiet, inspect)
  run Testing.expect(
    sameAnswer && noRestart && rejectsAt(&leak, RejectionCode.PrivateTypeExposure) && quietView.success,
    "an identity-addressed operation shares its name lookup's answer, and a public contract's operation cannot expose a private type",
  )
  let underStarts = starts(Semantic.eventLog(&semantic), Family.OperationUnder)
  let underHits = hits(Semantic.eventLog(&semantic), Family.OperationUnder)
  let editedWitness = run present("pub fn convertBool(value: i32) -> i32 { return 1 }\n")
  let second = run Revision.publish(&first, &witness, &editedWitness)
  Semantic.revise(&mut semantic, run Revision.copy(&second))
  let afterBody = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let bodyReused = starts(Semantic.eventLog(&semantic), Family.OperationUnder) == underStarts && hits(
    Semantic.eventLog(&semantic),
    Family.OperationUnder,
  ) == underHits + usize.ONE && (run resultEquals(&afterBody, &expectInt))
  let editedContracts = run present(
    "pub interface Convert<T> {\n  fn convert<U>(value: Self, other: U) -> U\n}\npub interface Hold<'a> {\n  fn hold(value: &Self) -> &'a i32\n}\npub service Clock {}\npub interface Needs<?R> {\n  fn pending(value: &Self) -> Effect<'static; i32 ? R>\n}\npub interface Other {}\nstruct Hidden {}\npub interface Leaks {\n  fn leak(value: &Self) -> Hidden\n}\ninterface Quiet {\n  fn quiet(value: &Self) -> Hidden\n}\n",
  )
  let third = run Revision.publish(&second, &contracts, &editedContracts)
  Semantic.revise(&mut semantic, run Revision.copy(&third))
  let afterHeader = run Semantic.demandOperationUnder(&mut semantic, &mut request, &boxBool, &convert)
  let headerRecomputed = starts(Semantic.eventLog(&semantic), Family.OperationUnder) == underStarts + usize.ONE && Shared.with<
    Result<Answer, NoRejection>,
    bool,
  >(
    &afterHeader,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return parameterOwnedBy(answer, usize.MAX, b"convert")
    },
  )
  let deleted = run Semantic.demandSignatureOf(&mut semantic, &mut request, &other)
  run Testing.expect(
    bodyReused && headerRecomputed && rejectsWith(&deleted, RejectionCode.UnknownMember),
    "a witness body edit reuses the answer, a contract header edit recomputes it, and a deleted identity rejects",
  )
  return ()
}

test effect fn witnessContractCompatibility() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let contracts = run module("wcontracts.silk")
  let model = run module("wmodel.silk")
  let contractsText = "pub struct LoadError {}\npub struct IoError {}\npub service Clock {}\npub service Logger {}\npub service Ticker {\n  fn tick(value: Self) -> i32\n}\npub interface Info {\n  fn decode(value: Self) -> i32\n  fn width(value: Self) -> i32\n}\npub interface Load {\n  effect<'static> fn load(value: Self) -> i32 ! LoadError ? &Clock\n}\npub interface Shift {\n  fn shift(value: Self, amount: i32) -> i32\n}\npub interface Look {\n  fn look(value: &'static Self) -> i32\n}\npub interface Poke {\n  fn poke(value: &'static mut Self) -> i32\n}\npub interface Spread {\n  fn spread(value: Self, items: &'static [i32]) -> i32\n}\npub interface Risky {\n  unsafe fn risky(value: Self) -> i32\n}\npub interface Pick<'x, 'y> {\n  effect<'x> fn pick(value: Self) -> i32\n}\nfn shiftInt(value: i32, amount: i32) -> i32 { return value }\nimpl Info for i32 {\n  fn decode(value: Self) -> i32 { return value }\n  fn width(value: Self) -> i32 { return 32 }\n}\nimpl Shift for i32 {\n  shift: shiftInt\n}\n"
  let modelText = "import wcontracts { Info, Load, LoadError, IoError, Clock, Logger, Ticker, Shift, Look, Poke, Spread, Risky, Pick }\npub struct Schema {}\nfn schemaWidth(value: Schema) -> i32 { return 32 }\nimpl Info for Schema {\n  fn decode(value: Self) -> i32 { return 42 }\n  width: schemaWidth\n}\nstruct Lacking {}\nimpl Info for Lacking {\n  fn decode(value: Self) -> i32 { return 0 }\n}\nstruct Misnamed {}\nimpl Info for Misnamed {\n  fn decodeSchema(value: Self) -> i32 { return 0 }\n  fn decode(value: Self) -> i32 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Twice {}\nfn twiceDecode(value: Twice) -> i32 { return 0 }\nimpl Info for Twice {\n  fn decode(value: Self) -> i32 { return 0 }\n  decode: twiceDecode\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Eager {}\nimpl Load for Eager {\n  fn load(value: Self) -> i32 { return 0 }\n}\nstruct Lazy {}\nimpl Info for Lazy {\n  effect fn decode(value: Self) -> i32 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Hazard {}\nimpl Info for Hazard {\n  unsafe fn decode(value: Self) -> i32 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Careful {}\nimpl Risky for Careful {\n  fn risky(value: Self) -> i32 { return 0 }\n}\nstruct Grabby {}\nimpl Look for Grabby {\n  fn look(value: &'static mut Self) -> i32 { return 0 }\n}\nstruct Taker {}\nimpl Look for Taker {\n  fn look(value: Self) -> i32 { return 0 }\n}\nstruct Reader {}\nimpl Poke for Reader {\n  fn poke(value: &'static Self) -> i32 { return 0 }\n}\nstruct Single {}\nimpl Spread for Single {\n  fn spread(value: Self, items: &'static i32) -> i32 { return 0 }\n}\nstruct Wide {}\nimpl Shift for Wide {\n  fn shift(value: Self, amount: i64) -> i32 { return 0 }\n}\nstruct Nested {}\nimpl Look for Nested {\n  fn look(value: &'static &'static Self) -> i32 { return 0 }\n}\nstruct Long {}\nimpl Info for Long {\n  fn decode(value: Self) -> i64 { return 0 }\n  fn width(value: Self) -> i32 { return 0 }\n}\nstruct Deferred {}\nimpl Load for Deferred {\n  effect fn load(value: Self) -> Effect<'static; i32> { return () }\n}\nstruct Noisy {}\nimpl Load for Noisy {\n  effect fn load(value: Self) -> i32 ! LoadError | IoError { return 0 }\n}\nstruct Chatty {}\nimpl Load for Chatty {\n  effect fn load(value: Self) -> i32 ? &Logger { return 0 }\n}\nstruct Writer {}\nimpl Load for Writer {\n  effect fn load(value: Self) -> i32 ? &mut Clock { return 0 }\n}\nstruct Quiet {}\nimpl Load for Quiet {\n  effect fn load(value: Self) -> i32 { return 0 }\n}\nstruct Broken {}\nfn brokenWidth(value: Missing) -> i32 { return 0 }\nimpl Info for Broken {\n  fn decode(value: Self) -> i32 { return 0 }\n  width: brokenWidth\n}\nstruct Loose {}\nfn looseWidth(value: Loose) -> i32 { return true }\nimpl Info for Loose {\n  fn decode(value: Self) -> i32 { return 0 }\n  width: looseWidth\n}\nstruct Two<'a> {\n  value: &'a i32\n}\nimpl<'a> Pick<'a, 'a> for Two<'a> {\n  effect fn pick(value: Self) -> i32 { return 0 }\n}\nstruct Three<'a> {\n  value: &'a i32\n}\nimpl<'a, 'b, 'c> Pick<'b, 'c> for Three<'a> {\n  effect<'c> fn pick(value: Self) -> i32 { return 0 }\n}\nstruct Four<'a> {\n  value: &'a i32\n}\nimpl<'a, 'b: 'c, 'c: 'a> Pick<'a, 'b> for Four<'a> {\n  effect<'b> fn pick(value: Self) -> i32 { return 0 }\n}\nstruct Borrower {}\nimpl Look for Borrower {\n  fn look(value: &Self) -> i32 { return 0 }\n}\nimpl Ticker for Schema {\n  fn tick(value: Self) -> i32 { return 0 }\n}\n"
  let contractsSource = run present(contractsText)
  let modelSource = run present(modelText)
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractsSource)
  let revision = run Revision.publish(&r1, &model, &modelSource)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let schema = run witnessesOf(&mut semantic, &mut request, &revision, &model, 0)
  let schemaPair = Shared.with<Result<Answer, NoRejection>, bool>(&schema, inlineThenMappedWitnesses)
  let serviceWitness = run witnessesOf(&mut semantic, &mut request, &revision, &model, 26)
  let scalarInline = run witnessesOf(&mut semantic, &mut request, &revision, &contracts, 0)
  run Testing.expect(
    schemaPair && succeeded(&serviceWitness) && succeeded(&scalarInline),
    "inline and mapped members supply operations in contract order for interfaces, services and scalars",
  )
  let lacking = run witnessesOf(&mut semantic, &mut request, &revision, &model, 1)
  let misnamed = run witnessesOf(&mut semantic, &mut request, &revision, &model, 2)
  let twice = run witnessesOf(&mut semantic, &mut request, &revision, &model, 3)
  let scalarMapped = run witnessesOf(&mut semantic, &mut request, &revision, &contracts, 1)
  run Testing.expect(
    rejectsWitness(&lacking, offsetOf(modelText, "impl Info for Lacking", 0), 0, usize.MAX) && rejectsWitness(
      &misnamed,
      offsetOf(modelText, "fn decodeSchema", 0),
      1,
      usize.MAX,
    ) && rejectsFrom(&twice, RejectionCode.Collision, offsetOf(modelText, "decode: twiceDecode", 0)) && rejectsWitness(
      &scalarMapped,
      offsetOf(contractsText, "shift: shiftInt", 0),
      2,
      usize.MAX,
    ),
    "a missing, unknown or repeated member, or a mapped scalar source function, is rejected at its anchor",
  )
  let eager = run witnessesOf(&mut semantic, &mut request, &revision, &model, 4)
  let lazy = run witnessesOf(&mut semantic, &mut request, &revision, &model, 5)
  let hazard = run witnessesOf(&mut semantic, &mut request, &revision, &model, 6)
  let careful = run witnessesOf(&mut semantic, &mut request, &revision, &model, 7)
  run Testing.expect(
    rejectsWitness(&eager, offsetOf(modelText, "fn load(value: Self) -> i32 { return 0 }", 0), 3, usize.MAX),
    "an ordinary function cannot implement an effect operation",
  )
  run Testing.expect(
    rejectsWitness(&lazy, offsetOf(modelText, "effect fn decode", 0), 3, usize.MAX),
    "an effect function cannot implement an ordinary operation",
  )
  run Testing.expect(
    rejectsWitness(&hazard, offsetOf(modelText, "unsafe fn decode", 0), 4, usize.MAX),
    "an unsafe function cannot implement a safe operation",
  )
  run Testing.expect(succeeded(&careful), "a safe function can implement an unsafe operation")
  let grabby = run witnessesOf(&mut semantic, &mut request, &revision, &model, 8)
  let taker = run witnessesOf(&mut semantic, &mut request, &revision, &model, 9)
  let reader = run witnessesOf(&mut semantic, &mut request, &revision, &model, 10)
  let single = run witnessesOf(&mut semantic, &mut request, &revision, &model, 11)
  let wide = run witnessesOf(&mut semantic, &mut request, &revision, &model, 12)
  let nested = run witnessesOf(&mut semantic, &mut request, &revision, &model, 13)
  run Testing.expect(
    rejectsWitness(&grabby, offsetOf(modelText, "fn look(value: &'static mut Self)", 0), 6, 0) && rejectsWitness(
      &taker,
      offsetOf(modelText, "fn look(value: Self)", 0),
      6,
      0,
    ) && succeeded(&reader) && rejectsWitness(&single, offsetOf(modelText, "fn spread", 0), 7, 1) && rejectsWitness(
      &wide,
      offsetOf(modelText, "fn shift(value: Self, amount: i64)", 0),
      8,
      1,
    ) && rejectsWitness(&nested, offsetOf(modelText, "fn look(value: &'static &'static Self)", 0), 8, 0),
    "operand modes are literal: weaker access is allowed, stronger or consuming access, a slice for a reference, and another type are not",
  )
  let long = run witnessesOf(&mut semantic, &mut request, &revision, &model, 14)
  let deferred = run witnessesOf(&mut semantic, &mut request, &revision, &model, 15)
  let noisy = run witnessesOf(&mut semantic, &mut request, &revision, &model, 16)
  let chatty = run witnessesOf(&mut semantic, &mut request, &revision, &model, 17)
  let writer = run witnessesOf(&mut semantic, &mut request, &revision, &model, 18)
  let quiet = run witnessesOf(&mut semantic, &mut request, &revision, &model, 19)
  run Testing.expect(
    rejectsWitness(&long, offsetOf(modelText, "fn decode(value: Self) -> i64", 0), 9, usize.MAX) && rejectsWitness(
      &deferred,
      offsetOf(modelText, "effect fn load(value: Self) -> Effect", 0),
      9,
      usize.MAX,
    ) && rejectsWitness(&noisy, offsetOf(modelText, "effect fn load(value: Self) -> i32 ! LoadError | IoError", 0), 10, usize.MAX) && rejectsWitness(
      &chatty,
      offsetOf(modelText, "effect fn load(value: Self) -> i32 ? &Logger", 0),
      11,
      usize.MAX,
    ) && rejectsWitness(&writer, offsetOf(modelText, "effect fn load(value: Self) -> i32 ? &mut Clock", 0), 12, usize.MAX) && succeeded(&quiet),
    "results match exactly, while failures and requirements may only narrow the promised channels",
  )
  let loadIdentity = run requireIdentity(&revision, &model, OwnerKind.Implementation, b"", 19)
  let loadOperation = run requireIdentity(&revision, &contracts, OwnerKind.Function, b"load", 0)
  let promised = run Semantic.demandOperationUnder(&mut semantic, &mut request, &loadIdentity, &loadOperation)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&promised, promisesLoadChannels),
    "a narrower witness leaves the operation contract that callers see unchanged",
  )
  let bodies = starts(Semantic.eventLog(&semantic), Family.Body)
  let broken = run witnessesOf(&mut semantic, &mut request, &revision, &model, 20)
  let loose = run witnessesOf(&mut semantic, &mut request, &revision, &model, 21)
  run Testing.expect(
    rejectsFrom(&broken, RejectionCode.UnknownName, offsetOf(modelText, "Missing", 0)) && succeeded(&loose) && bodies == usize.ZERO && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == usize.ZERO,
    "a mapped header is checked, and no member body is read or checked",
  )
  let retained = run witnessesOf(&mut semantic, &mut request, &revision, &model, 22)
  let unrelated = run witnessesOf(&mut semantic, &mut request, &revision, &model, 23)
  // Staged for unit3: 'b covers 'a only through the chain 'b: 'c: 'a.
  let chained = run witnessesOf(&mut semantic, &mut request, &revision, &model, 24)
  // Staged for exact matching in this unit: the elided borrow is the witness's own binder.
  let elided = run witnessesOf(&mut semantic, &mut request, &revision, &model, 25)
  run Testing.expect(succeeded(&retained), "the retained environment can implement its matching operation")
  run Testing.expect(
    rejectsWitness(&unrelated, offsetOf(modelText, "effect<'c> fn pick", 0), 14, usize.MAX),
    "an unrelated witness environment cannot cover the promised one",
  )
  run Testing.expect(
    rejectsFrom(&chained, RejectionCode.Unsupported, offsetOf(modelText, "effect<'b> fn pick", 0)),
    "a chain of lifetime bounds remains unsupported",
  )
  run Testing.expect(
    succeeded(&elided) && witnessArgumentCount(&elided) == usize.ONE,
    "an elided witness-owned lifetime matches the promised borrow and records its argument",
  )
  return ()
}

test effect fn witnessOwnBinders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessOwnBinderClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessOwnBinderClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let module = run module("wbinders.silk")
  let text = "interface Plain {\n  fn plain(value: Self) -> i32\n}\nstruct Extra {}\nimpl Plain for Extra {\n  fn plain<T>(value: Self) -> i32 { return 0 }\n}\ninterface Display {\n  fn display(value: Self) -> i32\n}\nstruct View<'a> { value: &'a i32 }\nimpl Display for View {\n  fn display(value: Self) -> i32 { return 0 }\n}\ninterface Show {}\ninterface Bound {\n  fn use<U: Show>(value: U) -> i32\n}\nstruct Candidate {}\nimpl Bound for Candidate {\n  fn use<T: Show>(value: T) -> i32 { return 0 }\n}\nservice Clock {}\ninterface Rowed {\n  effect<'static> fn load<?R>(value: Self) -> i32 ? &mut Clock | R\n}\nstruct Reader {}\nimpl Rowed for Reader {\n  effect<'static> fn load<?W>(value: Self) -> i32 ? &Clock | W { return 0 }\n}\ninterface Lend {\n  fn take(value: Self) -> i32\n}\nstruct Borrow {}\nimpl Lend for Borrow {\n  fn take(value: &Self) -> i32 { return 0 }\n}\ninterface Peek {\n  fn peek(value: Self) -> &'static Self\n}\nstruct Leaker {}\nimpl Peek for Leaker {\n  fn peek(value: &Self) -> &Self { return () }\n}\ninterface Later {\n  fn later(value: Self) -> Effect<'static; i32>\n}\nstruct Deferred {}\nimpl Later for Deferred {\n  fn later<'a>(value: &'a Self) -> Effect<'a; i32> { return () }\n}\ninterface Repeat {\n  fn repeat(value: Self, other: &'static Self) -> i32\n}\nstruct Reused {}\nimpl Repeat for Reused {\n  fn repeat<'a>(value: &'a Self, other: &'a Self) -> i32 { return 0 }\n}\ninterface StaticTake {\n  fn take(value: Self) -> i32\n}\nstruct Fixed {}\nimpl StaticTake for Fixed {\n  fn take(value: &'static Self) -> i32 { return 0 }\n}\ninterface Carry<'a> {\n  effect<'a> fn carry(value: Self) -> i32\n}\nstruct Stored<'a> { value: &'a i32 }\nimpl<'a> Carry<'a> for Stored<'a> {\n  effect<'w> fn carry<'w>(value: Self) -> i32 { return 0 }\n}\ninterface TwoEnv<'a, 'b> {\n  effect<'a & 'b> fn hold(value: Self) -> i32\n}\nstruct PairStored<'a, 'b> { first: &'a i32, second: &'b i32 }\nimpl<'a, 'b> TwoEnv<'a, 'b> for PairStored<'a, 'b> {\n  effect<'w> fn hold<'w>(value: Self) -> i32 { return 0 }\n}\n"
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &module, &source)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let unused = run witnessesOf(&mut semantic, &mut request, &revision, &module, 0)
  let headLifetime = run witnessesOf(&mut semantic, &mut request, &revision, &module, 1)
  let alphaBound = run witnessesOf(&mut semantic, &mut request, &revision, &module, 2)
  let row = run witnessesOf(&mut semantic, &mut request, &revision, &module, 3)
  let lent = run witnessesOf(&mut semantic, &mut request, &revision, &module, 4)
  let escaped = run witnessesOf(&mut semantic, &mut request, &revision, &module, 5)
  let nested = run witnessesOf(&mut semantic, &mut request, &revision, &module, 6)
  let reused = run witnessesOf(&mut semantic, &mut request, &revision, &module, 7)
  let fixed = run witnessesOf(&mut semantic, &mut request, &revision, &module, 8)
  let environment = run witnessesOf(&mut semantic, &mut request, &revision, &module, 9)
  let intersection = run witnessesOf(&mut semantic, &mut request, &revision, &module, 10)
  run Testing.expect(
    rejectsFrom(&unused, RejectionCode.Unsupported, offsetOf(text, "fn plain<T>", 0)),
    "an unbound witness-owned type parameter never publishes witness arguments",
  )
  run Testing.expect(succeeded(&headLifetime), "a generated lifetime in the implementation head remains in scope")
  run Testing.expect(
    succeeded(&alphaBound) && witnessArgumentCount(&alphaBound) == usize.ONE,
    "the operation's own bound implies the matched witness bound and records its argument",
  )
  run Testing.expect(
    rejectsFrom(&row, RejectionCode.Unsupported, offsetOf(text, "effect<'static> fn load<?W>", 0)),
    "a row with a fixed service beside an open witness row remains unsupported until set matching",
  )
  run Testing.expect(
    succeeded(&lent) && witnessArgumentCount(&lent) == usize.ONE,
    "an owned contract operand can be lent to an elided witness borrow with a recorded lifetime",
  )
  run Testing.expect(
    rejectsWitness(&escaped, offsetOf(text, "fn peek(value: &Self)", 0), 9, usize.MAX),
    "a lent borrow cannot escape through the witness result",
  )
  run Testing.expect(
    rejectsWitness(&nested, offsetOf(text, "fn later<'a>", 0), 9, usize.MAX),
    "a lent borrow cannot escape through a returned Effect environment",
  )
  run Testing.expect(
    rejectsWitness(&reused, offsetOf(text, "fn repeat<'a>", 0), 8, 1),
    "a lent borrow cannot be reused by another operand",
  )
  run Testing.expect(
    rejectsWitness(&fixed, offsetOf(text, "fn take(value: &'static Self)", 0), 8, 0),
    "a fixed lifetime cannot stand in for a witness-owned lent borrow",
  )
  run Testing.expect(
    succeeded(&environment) && witnessArgumentCount(&environment) == usize.ONE,
    "a witness-owned lifetime used only by its effect environment matches the promised region",
  )
  run Testing.expect(
    rejectsFrom(&intersection, RejectionCode.Unsupported, offsetOf(text, "effect<'w> fn hold<'w>", 0)),
    "an environment intersection does not bind a free witness lifetime by positional guessing",
  )
  return ()
}

fn witnessArgumentCount(answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  return Shared.with<Result<Answer, NoRejection>, usize>(
    answer,
    fn(resolved: &Result<Answer, NoRejection>) -> usize {
      if let Result<Answer, NoRejection>.Success {value} = &resolved.* {
        if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
          let entries = Vector.asSlice<Witness>(&witnesses)
          if entries.length > usize.ZERO {
            return Vector.length<Argument>(&entries[usize.ZERO].arguments)
          }
        }
      }
      return usize.MAX
    },
  )
}

// The witnesses of the `occurrence`th implementation of a module.
effect fn witnessesOf(
  semantic: &mut Semantic,
  request: &mut Request,
  revision: &Revision,
  module: &ModuleId,
  occurrence: usize,
) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let implementation = run requireIdentity(revision, module, OwnerKind.Implementation, b"", occurrence)
  return run Semantic.demandWitnesses(&mut semantic.*, &mut request.*, &implementation)
}

fn succeeded(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(resolved: &Result<Answer, NoRejection>) -> bool {
      return match & resolved.* {
        Result<Answer, NoRejection>.Success {value} => match & value.outcome {
          Outcome.Success {value: _} => true
          Outcome.Rejected {diagnostic: _} => false
        }
        Result<Answer, NoRejection>.Failure {error: _} => false
      }
    },
  )
}

// Position of a component in `WitnessProblem`'s declaration order.
fn problemOrdinal(problem: &WitnessProblem) -> usize {
  return match & problem.* {
    WitnessProblem.Missing => 0
    WitnessProblem.Unknown => 1
    WitnessProblem.ScalarMapping => 2
    WitnessProblem.Kind => 3
    WitnessProblem.Safety => 4
    WitnessProblem.OperandCount => 5
    WitnessProblem.OperandAccess {..} => 6
    WitnessProblem.OperandShape {..} => 7
    WitnessProblem.OperandType {..} => 8
    WitnessProblem.ResultType => 9
    WitnessProblem.Failure => 10
    WitnessProblem.Requirement => 11
    WitnessProblem.RequirementAccess => 12
    WitnessProblem.RequirementParameter => 13
    WitnessProblem.Environment => 14
  }
}

fn problemOperand(problem: &WitnessProblem) -> usize {
  return match & problem.* {
    WitnessProblem.OperandAccess {operand} => operand
    WitnessProblem.OperandShape {operand} => operand
    WitnessProblem.OperandType {operand} => operand
    _ => usize.MAX
  }
}

// An `IncompatibleWitness` rejection at `start` naming the component and, for an operand, its position.
fn rejectsWitness(answer: &Shared<Result<Answer, NoRejection>>, start: usize, problem: usize, operand: usize) -> bool {
  if !rejectsFrom(answer, RejectionCode.IncompatibleWitness, start) {
    return false
  }
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(
      &value,
      fn(diagnostic: &Rejection) -> bool {
        if let Option<WitnessProblem>.Some {value: named} = &diagnostic.witness {
          return problemOrdinal(&named) == problem && problemOperand(&named) == operand
        }
        return false
      },
    )
  }
  return false
}

// Two witnesses in operation order: `decode` inline, then `width` mapped to `schemaWidth`.
fn inlineThenMappedWitnesses(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Witnesses {witnesses}} = &value.outcome {
      let listed = Vector.asSlice<Witness>(&witnesses)
      if listed.length != 2 {
        return false
      }
      return spelledAs(&listed[0].operation, b"decode") && spelledAs(&listed[0].implementation, b"decode") && spelledAs(
        &listed[1].operation,
        b"width",
      ) && spelledAs(&listed[1].implementation, b"schemaWidth")
    }
  }
  return false
}

fn spelledAs(identity: &Shared<DeclarationId>, name: &[u8]) -> bool {
  return Shared.with<DeclarationId, bool>(
    identity,
    fn(declaration: &DeclarationId) -> bool {
      return sameBytes(DeclarationId.spelling(declaration), name)
    },
  )
}

// The promised `load` keeps its `LoadError` failure and one `Clock` requirement.
fn promisesLoadChannels(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let failure = Shared.with<Type, bool>(
        &signature.failure,
        fn(ty: &Type) -> bool {
          return match & ty.* {
            Type.Nominal {..} => true
            _ => false
          }
        },
      )
      let entries = Shared.with<Row, usize>(
        &signature.requirements,
        fn(row: &Row) -> usize {
          return Vector.length<Requirement>(&row.entries)
        },
      )
      return signature.isEffect && failure && entries == 1
    }
  }
  return false
}

test effect fn intrinsicPropertiesAndSealedNamespace() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("intrinsics.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "effect fn detached<A, F: once Effect<A> + Intrinsic.Detached>(pending: F) -> A { return run pending }\neffect fn attached<A, F: once Effect<A>>(pending: F) -> A { return run pending }\nfn nonParking<F: fn<'static>(i32) -> i32 + Intrinsic.NonParking>(callback: F) -> i32 { return 0 }\nfn plainDetached<T: Intrinsic.Detached>(value: T) -> i32 { return 0 }\nfn execution(value: Intrinsic.Execution<i32>) -> i32 { return 0 }\nfn unknownFamily<T: Intrinsic.Replace>(value: T) -> i32 { return 0 }\nstruct Intrinsic {}\npub struct Plain {}\nfn usesReserved(value: Intrinsic) -> i32 { return 0 }\nstruct Holds {\n  execution: Intrinsic.Execution<i32>\n}\nfn holds() -> Holds { return () }\n"
  let aliased = run module("aliased.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let namespaced = run module("namespaced.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasedText = "import intrinsics { Plain as Intrinsic }\nfn viaAlias(value: Intrinsic) -> i32 { return 0 }\n"
  let namespacedText = "import intrinsics as Intrinsic\nfn viaNamespace(value: Intrinsic.Plain) -> i32 { return 0 }\nimpl Intrinsic {\n  fn reopened() -> i32 { return 0 }\n}\nfn calls() -> i32 { return Intrinsic.replace(1, 2) }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasedSource = run present(aliasedText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let namespacedSource = run present(namespacedText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let withEntry = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let withAliased = run Revision.publish(&withEntry, &aliased, &aliasedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&withAliased, &namespaced, &namespacedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(
    run Revision.copy(&revision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut request = Request.make()
  let detached = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"detached")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let attached = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"attached")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let detachedStatic = Shared.with<Result<Answer, NoRejection>, bool>(&detached, staticEnvironment)
  let attachedStatic = Shared.with<Result<Answer, NoRejection>, bool>(&attached, staticEnvironment)
  let detachedRecorded = Shared.with<Result<Answer, NoRejection>, bool>(
    &detached,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return recordsProperty(answer, IntrinsicProperty.Detached)
    },
  )
  run Testing.expect(
    detachedStatic && !attachedStatic && detachedRecorded,
    "a Detached representation retains no region in an effect environment, unlike an ordinary one",
  )
  let nonParking = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nonParking")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let plainDetached = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"plainDetached")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonParkingRecorded = Shared.with<Result<Answer, NoRejection>, bool>(
    &nonParking,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return recordsProperty(answer, IntrinsicProperty.NonParking)
    },
  )
  let plainRecorded = Shared.with<Result<Answer, NoRejection>, bool>(
    &plainDetached,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return recordsProperty(answer, IntrinsicProperty.Detached)
    },
  )
  run Testing.expect(
    nonParkingRecorded && plainRecorded,
    "sealed properties are recorded as witness-free bounds without an interface or proof",
  )
  let execution = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"execution")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownFamily = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unknownFamily")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reserved = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Intrinsic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let executionAt = rejectsFrom(&execution, RejectionCode.Unsupported, offsetOf(text, "Intrinsic.Execution", 0))
  let familyAt = rejectsFrom(&unknownFamily, RejectionCode.Unsupported, offsetOf(text, "Intrinsic.Replace", 0))
  let reservedAt = rejectsAt(&reserved, RejectionCode.Collision)
  run Testing.expect(
    executionAt && familyAt && reservedAt,
    "unimplemented intrinsic families stay unsupported and no declaration can claim the sealed name",
  )
  let usesReserved = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"usesReserved")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let viaAlias = run Semantic.demandSignature(&mut semantic, &mut request, &aliased, b"viaAlias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let namespace = run Semantic.demandIdentity(&mut semantic, &mut request, &namespaced, b"Intrinsic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsAt(&usesReserved, RejectionCode.Collision) && rejectsAt(&viaAlias, RejectionCode.Collision) && rejectsAt(
      &namespace,
      RejectionCode.Collision,
    ),
    "a declaration, member alias or namespace alias named Intrinsic collides wherever the binding is looked up",
  )
  let holds = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"holds")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let viaNamespace = run Semantic.demandSignature(&mut semantic, &mut request, &namespaced, b"viaNamespace")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reopened = run signatureNamed(&mut semantic, &mut request, &revision, &namespaced, b"reopened", 0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let calls = run Semantic.demandBody(&mut semantic, &mut request, &namespaced, b"calls")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldAt = rejectsFrom(&holds, RejectionCode.Unsupported, offsetOf(text, "Intrinsic.Execution", 1))
  let sealedAt = rejectsFrom(&viaNamespace, RejectionCode.Unsupported, offsetOf(namespacedText, "Intrinsic.Plain", 0))
  let reopenedAt = rejectsFrom(&reopened, RejectionCode.Unsupported, offsetOf(namespacedText, "Intrinsic {", 0))
  let callAt = rejectsFrom(&calls, RejectionCode.Unsupported, offsetOf(namespacedText, "Intrinsic.replace", 0))
  run Testing.expect(
    fieldAt && sealedAt && reopenedAt && callAt,
    "Intrinsic paths in fields, types and calls never reach module lookup, and the namespace cannot be reopened",
  )
  return ()
}

test effect fn referenceModifiersAndLifetimeIdentities() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("views.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "type Ref<'a, T> = &'a T\ntype Borrow = &i32\nstruct View<'a, T> { value: &'a T }\nfn same<'a>(value: &'a i32) -> &'a i32 { return value }\nfn sameOther<'a>(value: &'a i32) -> &'a i32 { return value }\nfn different<'a>(value: &'a i32) -> &'static i32 { return value }\nfn alias<'a, T>(left: Ref<'a, T>, right: &'a T) -> &'a T { return right }\nfn aliasElided(value: Borrow) -> Borrow { return value }\nfn nominal<'a>(value: View<'a, i32>) -> View<'a, i32> { return value }\nfn implicit(value: &i32) -> &i32 { return value }\nfn separate(left: &i32, right: &i32) -> i32 { return 0 }\nfn ambiguous(left: &i32, right: &i32) -> &i32 { return left }\nfn unknown(value: &'missing i32) -> i32 { return 0 }\nfn duplicate<'a, 'a>(value: &'a i32) -> i32 { return 0 }\nfn reserved<'static>(value: &'static i32) -> i32 { return 0 }\nfn shared(value: &'static i32) -> &'static i32 { return value }\nfn exclusive(value: &'static mut i32) -> &'static mut i32 { return value }\nfn slice(value: &'static [i32]) -> &'static [i32] { return value }\nfn text(value: string<'static>) -> string<'static> { return value }\nfn pointer() -> *const i32 { return () }\nfn pointerAgain() -> *const i32 { return () }\nfn pointerMut() -> *mut i32 { return () }\nfn pointerNull() -> ?*const i32 { return () }\nfn pointerMany() -> [*]const i32 { return () }\nfn aligned() -> *const align(8) u8 { return () }\nfn alignedAgain() -> *const align(8) addrspace(0) u8 { return () }\nfn maxAlign() -> *const align(536870912) u8 { return () }\nfn tooLargeAlign() -> *const align(1073741824) u8 { return () }\nfn badAlign() -> *const align(3) u8 { return () }\nfn badSpace() -> *const addrspace(3) u8 { return () }\nfn namedPointer() -> *const View<'static, i32> { return () }\nfn missingPointer() -> *const Missing { return () }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let same = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"same")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameOther = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"sameOther")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"different")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aliasElided = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"aliasElided",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nominal = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"nominal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let implicit = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"implicit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let separate = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"separate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    (run signatureReferencesAgree(&same)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run signatureReferencesAgree(&different)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&same, &sameOther)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureArgumentsAgree(&alias)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureReferencesAgree(&nominal)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureReferencesAgree(
      &aliasElided,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureReferencesAgree(&implicit)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run signatureArgumentsDiffer(&separate)
      |> Effect.provideMut<Allocator>(&mut allocator)),
    "written and elided lifetimes keep their declaration-owned relationships",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &alias,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Alias)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &nominal,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Identity)
      },
    ),
    "view applications keep their alias and nominal dependencies",
  )
  let shared = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"shared")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let exclusive = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"exclusive")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let slice = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"slice")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"text")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointer = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pointer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerAgain = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"pointerAgain",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerMut = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pointerMut")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerNull = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"pointerNull",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerMany = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"pointerMany",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aligned = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"aligned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alignedAgain = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"alignedAgain",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let maxAlign = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"maxAlign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&shared, signatureSucceeded) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&exclusive, signatureSucceeded) && Shared.with<Result<Answer, NoRejection>, bool>(
      &slice,
      signatureSucceeded,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(&text, signatureSucceeded) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&pointerMut, signatureSucceeded) && Shared.with<Result<Answer, NoRejection>, bool>(
      &pointerNull,
      signatureSucceeded,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(&pointerMany, signatureSucceeded) && !(run resultEquals(
      &shared,
      &exclusive,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&shared, &slice)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&slice, &text)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run resultEquals(&pointer, &pointerAgain)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&pointer, &pointerMut)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&pointer, &pointerNull)
      |> Effect.provideMut<Allocator>(&mut allocator)) && !(run resultEquals(&pointer, &pointerMany)
      |> Effect.provideMut<Allocator>(&mut allocator)) && (run resultEquals(&aligned, &alignedAgain)
      |> Effect.provideMut<Allocator>(&mut allocator)) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&maxAlign, signatureSucceeded),
    "access, view form, pointer extent, nullability and alignment shape type identity",
  )
  let ambiguous = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"ambiguous")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknown = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unknown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let reserved = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"reserved")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badAlign = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"badAlign")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooLargeAlign = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"tooLargeAlign",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badSpace = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"badSpace")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingPointer = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"missingPointer",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &ambiguous,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.AmbiguousLifetime)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &unknown,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.UnknownLifetime)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &duplicate,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.DuplicateLifetimeParameter)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &reserved,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidLifetime)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badAlign,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidPointerQualifier)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooLargeAlign,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidPointerQualifier)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badSpace,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.InvalidPointerQualifier)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &missingPointer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectedTypeApplication(answer, RejectionCode.UnknownName) && hasTypeLookup(
          answer,
          Family.Name,
        )
      },
    ),
    "invalid references, lifetime names and pointer qualifiers reject at written spans",
  )
  let namedPointer = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &entry,
    b"namedPointer",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &namedPointer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return hasTypeLookup(answer, Family.Identity)
      },
    ),
    "a pointer's named pointee retains its transitive identity dependency",
  )
  return ()
}

fn constantInteger(answer: &Result<Answer, NoRejection>, digits: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared.with<ConstantValue, bool>(
        &found,
        fn(constant: &ConstantValue) -> bool {
          return match & constant.* {
            ConstantValue.Integer {sign: _, magnitude} => sameBytes(
              Bytes.asSlice(&magnitude),
              digits,
            )
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn constantTrue(answer: &Result<Answer, NoRejection>) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Initializer {value: found}} => Shared.with<ConstantValue, bool>(
        &found,
        fn(constant: &ConstantValue) -> bool {
          return match & constant.* {
            ConstantValue.Boolean {value: truth} => truth
            _ => false
          }
        },
      )
      _ => false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

fn staticString(resolved: &Type) -> bool {
  return match & resolved.* {
    Type.String {lifetime} => Shared.with<Lifetime, bool>(
      &lifetime,
      fn(value: &Lifetime) -> bool {
        return match & value.* {
          Lifetime.Static => true
          _ => false
        }
      },
    )
    _ => false
  }
}

fn staticStringConstant(answer: &Result<Answer, NoRejection>) -> bool {
  let resolved = nominalResult(answer)
  if let Option<Shared<Type>>.Some {value} = move resolved {
    return Shared.with<Type, bool>(&value, staticString)
  }
  return false
}

effect fn initializerRejects(
  semantic: &mut Semantic,
  request: &mut Request,
  entry: &ModuleId,
  name: &[u8],
  code: RejectionCode,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let answer = run Semantic.demandInitializer(&mut semantic.*, &mut request.*, entry, name)
  return Shared.with<Result<Answer, NoRejection>, bool>(
    &answer,
    fn(found: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(found, code)
    },
  )
}

fn cycleOfThree(answer: &Result<Answer, NoRejection>) -> bool {
  let found = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, isCycle) && Shared.with<Rejection, usize>(
      &value,
      cyclePathLength,
    ) == 3
  }
  return false
}

fn dependsOnName(answer: &Result<Answer, NoRejection>, name: &[u8]) -> bool {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => {
      let edges = Vector.asSlice<Dependency>(&value.dependencies)
      let mut at = usize.ZERO
      while at < edges.length {
        if edges[at].family == Family.Name {
          if let Option<Bytes>.Some {value: written} = &edges[at].name {
            if sameBytes(Bytes.asSlice(&written), name) {
              return true
            }
          }
        }
        at = at + usize.ONE
      }
      return false
    }
    Result<Answer, NoRejection>.Failure {error: _} => false
  }
}

effect fn constantClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("constants.silk")
  let library = run module("library.silk")
  let librarySource = run present("pub const base: u8 = 7\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let written = "import library { base }\nconst limit: u8 = 255\nconst copied: u8 = limit\nconst imported: u8 = base\nconst first: i32 = second\nconst second: i32 = first\nconst flag: bool = true\nconst ratio: f64 = 1.5\nconst label: string = \"x\"\nconst wide: u8 = 256\nconst wrong: bool = 1\nconst mismatch: bool = limit\nconst pointer: &i32 = 1\nconst sized: usize = 1\nfn helper() -> i32 { return 1 }\nconst called: i32 = helper()\nfn reads() -> u8 { return limit }\nfn absent() -> u8 { return nowhere }\n"
  let source = run present(written)
  let revision = run Revision.publish(&first, &entry, &source)
  let mut semantic = Semantic.make(run Revision.copy(&revision))
  let mut request = Request.make()
  let limitType = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"limit")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&limitType, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Initializer,
    ) == 0,
    "a constant type resolves without demanding its initializer",
  )
  let copied = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"copied")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &copied,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return constantInteger(answer, b"255")
      },
    ) && starts(Semantic.eventLog(&semantic), Family.Initializer) == 2 && starts(
      Semantic.eventLog(&semantic),
      Family.Constant,
    ) == 2 && reads(Semantic.sourceEvents(&semantic), &library) == 0,
    "a named constant demands the referenced type and value edges only",
  )
  let imported = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"imported")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &imported,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return constantInteger(answer, b"7")
      },
    ) && Request.hasDemand(&request, Family.Import, &entry) && Request.hasDemand(
      &request,
      Family.Initializer,
      &library,
    ),
    "a selected imported constant records import and value evidence",
  )
  let cycle = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"first")
  let secondValue = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"second")
  let secondType = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"second")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&cycle, cycleOfThree) && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(&secondValue, cycleOfThree) && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &secondType,
      inspect,
    ).success,
    "an initializer cycle publishes no value while both constant types remain available",
  )
  let mut reversed = Semantic.make(move revision)
  let mut reversedRequest = Request.make()
  let reversedSecond = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"second",
  )
  let reversedFirst = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"first",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &cycle,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.Cycle, String.utf8Bytes(written), b"second")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &secondValue,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.Cycle, String.utf8Bytes(written), b"first")
      },
    ) && rotatedPair(&cycle, &secondValue) && sameCycleAnswers(&cycle, &reversedFirst) && sameCycleAnswers(
      &secondValue,
      &reversedSecond,
    ),
    "each initializer cycle member rejects at its own reference in either demand order",
  )
  let flag = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"flag")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&flag, constantTrue),
    "a Boolean literal is its constant value",
  )
  let label = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"label")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&label, staticStringConstant),
    "an omitted constant string lifetime is static",
  )
  let ratioType = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"ratio")
  let unsupported = RejectionCode.Unsupported
  let floating = run initializerRejects(&mut semantic, &mut request, &entry, b"ratio", unsupported)
  let text = run initializerRejects(&mut semantic, &mut request, &entry, b"label", unsupported)
  let sized = run initializerRejects(&mut semantic, &mut request, &entry, b"sized", unsupported)
  let called = run initializerRejects(&mut semantic, &mut request, &entry, b"called", unsupported)
  run Testing.expect(
    floating && text && sized && called,
    "an initializer needing static execution publishes no value",
  )
  let invalid = RejectionCode.InvalidConstant
  let wide = run initializerRejects(&mut semantic, &mut request, &entry, b"wide", invalid)
  let wrong = run initializerRejects(&mut semantic, &mut request, &entry, b"wrong", invalid)
  run Testing.expect(wide && wrong, "an initializer literal outside the declared type is anchored")
  let pointer = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"pointer")
  let mismatch = run Semantic.demandInitializer(&mut semantic, &mut request, &entry, b"mismatch")
  let notConstant = run Semantic.demandConstant(&mut semantic, &mut request, &entry, b"helper")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&ratioType, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &pointer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.InvalidConstant)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &mismatch,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &notConstant,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.Unsupported)
      },
    ),
    "constant types, referenced-type mismatches, and non-constants have distinct outcomes",
  )
  let valueStarts = starts(Semantic.eventLog(&semantic), Family.Initializer)
  let reads = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"reads")
  let absent = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"absent")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &reads,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.Unsupported,
          String.utf8Bytes(written),
          b"limit",
        ) && dependsOnName(answer, b"limit")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &absent,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(written),
          b"nowhere",
        ) && dependsOnName(answer, b"nowhere")
      },
    ) && starts(Semantic.eventLog(&semantic), Family.Initializer) == valueStarts,
    "a body read of a declared constant is an explicit boundary, not an unknown name",
  )
  return ()
}

// Demands one fixed set of constant facts. `copied` and `pending` hold the expected digits; an
// empty slice expects the anchored rejection at that name instead.
effect fn constantFacts(
  semantic: &mut Semantic,
  entry: &ModuleId,
  text: &[u8],
  copied: &[u8],
  pending: &[u8],
  cycle: bool,
) -> bool ! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch ? &mut Allocator {
  let mut request = Request.make()
  let copiedValue = run Semantic.demandInitializer(&mut semantic.*, &mut request, entry, b"copied")
  let firstValue = run Semantic.demandInitializer(&mut semantic.*, &mut request, entry, b"first")
  let firstType = run Semantic.demandConstant(&mut semantic.*, &mut request, entry, b"first")
  let laterValue = run Semantic.demandInitializer(&mut semantic.*, &mut request, entry, b"later")
  let copiedHolds = Shared.with<Result<Answer, NoRejection>, bool>(
    &copiedValue,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if copied.length == usize.ZERO {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, text, b"base")
      }
      return constantInteger(answer, copied)
    },
  )
  let laterHolds = Shared.with<Result<Answer, NoRejection>, bool>(
    &laterValue,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if pending.length == usize.ZERO {
        return rejectionSpells(answer, RejectionCode.UnknownName, text, b"pending")
      }
      return constantInteger(answer, pending)
    },
  )
  let firstHolds = Shared.with<Result<Answer, NoRejection>, bool>(
    &firstValue,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      if cycle {
        return cycleOfThree(answer)
      }
      return constantInteger(answer, b"3")
    },
  )
  return copiedHolds && laterHolds && firstHolds && Shared.with<
    Result<Answer, NoRejection>,
    AnswerView,
  >(&firstType, inspect).success
}

effect fn constantRevisionClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("values.silk")
  let library = run module("library.silk")
  let text = "import library { base }\nconst copied: u8 = base\nconst first: i32 = second\nconst second: i32 = 3\nconst later: u8 = pending\nfn unrelated() -> i32 { return 1 }\n"
  let entrySource = run present(text)
  let librarySource = run present("pub const base: u8 = 7\n")
  let first = run Revision.publish(&Revision.make(), &library, &librarySource)
  let held = run Revision.publish(&first, &entry, &entrySource)
  let mut semantic = Semantic.make(run Revision.copy(&held))
  let cold = run constantFacts(&mut semantic, &entry, String.utf8Bytes(text), b"7", b"", false)
  let mut request = Request.make()
  let unrelated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unrelated")
  run Testing.expect(
    cold && Shared.with<Result<Answer, NoRejection>, AnswerView>(&unrelated, inspect).success,
    "initial constant values, a missing name, and an unrelated body",
  )
  let valueSource = run present("pub const base: u8 = 9\n")
  let valueRevision = run Revision.publish(&held, &library, &valueSource)
  Semantic.revise(&mut semantic, run Revision.copy(&valueRevision))
  let valueStarts = starts(Semantic.eventLog(&semantic), Family.Initializer)
  let typeStarts = starts(Semantic.eventLog(&semantic), Family.Constant)
  let warmValue = run constantFacts(&mut semantic, &entry, String.utf8Bytes(text), b"9", b"", false)
  let mut again = Request.make()
  let kept = run Semantic.demandBody(&mut semantic, &mut again, &entry, b"unrelated")
  let mut freshValue = Semantic.make(run Revision.copy(&valueRevision))
  let coldValue = run constantFacts(
    &mut freshValue,
    &entry,
    String.utf8Bytes(text),
    b"9",
    b"",
    false,
  )
  run Testing.expect(
    warmValue && coldValue && Shared.with<Result<Answer, NoRejection>, AnswerView>(&kept, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Initializer,
    ) == valueStarts + 2 && starts(Semantic.eventLog(&semantic), Family.Constant) == typeStarts + 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 1,
    "an imported value edit restarts only its value consumers, not their type facts or unrelated bodies",
  )
  let typeSource = run present("pub const base: bool = true\n")
  let typeRevision = run Revision.publish(&valueRevision, &library, &typeSource)
  Semantic.revise(&mut semantic, run Revision.copy(&typeRevision))
  let warmType = run constantFacts(&mut semantic, &entry, String.utf8Bytes(text), b"", b"", false)
  let mut freshType = Semantic.make(run Revision.copy(&typeRevision))
  let coldType = run constantFacts(&mut freshType, &entry, String.utf8Bytes(text), b"", b"", false)
  run Testing.expect(
    warmType && coldType,
    "an imported type edit rejects the consumer value at its reference",
  )
  let shiftedText = "// shifted\nimport library { base }\nconst copied: u8 = base\nconst first: i32 = second\nconst second: i32 = first\nconst later: u8 = pending\nconst pending: u8 = 4\nfn unrelated() -> i32 { return 1 }\n"
  let shiftedSource = run present(shiftedText)
  let shifted = run Revision.publish(&typeRevision, &entry, &shiftedSource)
  Semantic.revise(&mut semantic, run Revision.copy(&shifted))
  let warmShifted = run constantFacts(
    &mut semantic,
    &entry,
    String.utf8Bytes(shiftedText),
    b"",
    b"4",
    true,
  )
  let mut freshShifted = Semantic.make(run Revision.copy(&shifted))
  let coldShifted = run constantFacts(
    &mut freshShifted,
    &entry,
    String.utf8Bytes(shiftedText),
    b"",
    b"4",
    true,
  )
  let mut warmRequest = Request.make()
  let warmFirst = run Semantic.demandInitializer(&mut semantic, &mut warmRequest, &entry, b"first")
  let warmSecond = run Semantic.demandInitializer(
    &mut semantic,
    &mut warmRequest,
    &entry,
    b"second",
  )
  let mut reversed = Semantic.make(run Revision.copy(&shifted))
  let mut reversedRequest = Request.make()
  let reversedSecond = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"second",
  )
  let reversedFirst = run Semantic.demandInitializer(
    &mut reversed,
    &mut reversedRequest,
    &entry,
    b"first",
  )
  run Testing.expect(
    warmShifted && coldShifted && sameCycleAnswers(&warmFirst, &reversedFirst) && sameCycleAnswers(
      &warmSecond,
      &reversedSecond,
    ) && starts(Semantic.eventLog(&semantic), Family.Body) == 1,
    "a new cycle, a newly present name, and moved references use current values and spans",
  )
  let recoveredText = "// shifted\nimport library { base }\nconst copied: u8 = base\nconst first: i32 = second\nconst second: i32 = 3\nconst later: u8 = pending\nconst pending: u8 = 4\nfn unrelated() -> i32 { return 1 }\n"
  let recoveredSource = run present(recoveredText)
  let recovered = run Revision.publish(&shifted, &entry, &recoveredSource)
  Semantic.revise(&mut semantic, run Revision.copy(&recovered))
  let warmRecovered = run constantFacts(
    &mut semantic,
    &entry,
    String.utf8Bytes(recoveredText),
    b"",
    b"4",
    false,
  )
  let mut freshRecovered = Semantic.make(move recovered)
  let coldRecovered = run constantFacts(
    &mut freshRecovered,
    &entry,
    String.utf8Bytes(recoveredText),
    b"",
    b"4",
    false,
  )
  run Testing.expect(
    warmRecovered && coldRecovered,
    "breaking the cycle publishes the value again instead of a cached rejection",
  )
  return ()
}

test effect fn constantTypesAndInitializerDemands() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run constantClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
  return run constantRevisionClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn bodyChecksDemandedScalarReturnsAndReplaysEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bodies.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "type Byte = u8\nfn answer() -> i32 { return 42 }\nfn broken() -> i32 { return missing }\nfn fits() -> u8 { return 255 }\nfn tooLarge() -> u8 { return 256 }\nfn alias() -> Byte { return 255 }\nfn echo(value: i32) -> i32 { return value }\nfn inferred() -> u8 { let value = 255 return value }\nfn annotated() -> u8 { let value: Byte = 255 return value }\nfn localChain() -> i32 { let first = 1 let second = first return second }\nfn shadow(value: i32) -> i32 { let value = value return value }\nfn unitLocal() { let value = () return value }\nfn duplicate() -> i32 { let value = 1 let value = 2 return value }\nfn duplicateParameters(value: i32, value: i32) -> i32 { return value }\nfn forward() -> i32 { let first = later let later = 1 return first }\nfn selfRead() -> i32 { let value = value return value }\nfn tooLargeLocal() -> u8 { let value: u8 = 256 return value }\nfn incompatibleLocal() -> bool { let value: bool = 1 return value }\nfn discard() { 7 }\nfn empty() {}\nfn bare() { return }\nfn explicit() -> () { return () }\nfn mismatch() -> bool { return 1 }\nfn noReturn() -> i32 { true }\nfn unsupported() -> i32 { return 1 + 2 }\n"
  let held = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &held)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()

  let answer = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"answer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let answerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &answer,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move answerBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"i32") && TypedBody.nodeSlice(body).length == 3 && TypedBody.runtimeBodies(
            body,
          ).length == 0 && TypedBody.signatureDependencies(body).length == 1
        },
      ),
      "demanded answer has a complete typed return and signature dependency",
    )
  } else {
    run Testing.expect(false, "demanded answer has a checked body")
  }
  run Testing.expect(
    starts(Semantic.eventLog(&semantic), Family.Body) == 1 && Request.hasDemand(
      &request,
      Family.Signature,
      &entry,
    ) && Request.hasDiscovered(&request, &entry),
    "demanding answer does not start the broken body and retains its source",
  )
  let priorStarts = starts(Semantic.eventLog(&semantic), Family.Body)
  let mut fresh = Request.make()
  let replayed = run Semantic.demandBody(&mut semantic, &mut fresh, &entry, b"answer")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == priorStarts && hits(Semantic.eventLog(&semantic), Family.Body) == 1 && Request.hasRoot(
      &fresh,
      Family.Body,
      &entry,
      b"answer",
    ) && Request.hasDemand(&fresh, Family.Signature, &entry) && Request.hasDiscovered(
      &fresh,
      &entry,
    ),
    "a fresh request reuses and replays the completed body answer",
  )

  let broken = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"broken")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &broken,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.UnknownName, String.utf8Bytes(text), b"missing")
      },
    ),
    "the demanded unresolved parameter name is rejected at its source span",
  )

  let fits = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"fits")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooLarge = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooLarge")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fitsBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &fits,
    checkedBody,
  )
  let aliasBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &alias,
    checkedBody,
  )
  let mut typedAsU8 = false
  if let Option<Shared<TypedBody>>.Some {value} = move fitsBody {
    typedAsU8 = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyFirstIntegerType(body, b"u8")
      },
    )
  }
  if let Option<Shared<TypedBody>>.Some {value} = move aliasBody {
    typedAsU8 = typedAsU8 && Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyFirstIntegerType(body, b"u8")
      },
    )
  } else {
    typedAsU8 = false
  }
  run Testing.expect(
    typedAsU8 && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooLarge,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.IntegerOutOfRange)
      },
    ),
    "the immediate return context selects u8 through an alias and checks exact range",
  )

  let echo = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"echo")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let echoBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &echo,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move echoBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyReadsParameter),
      "parameter read keeps its authored binder identity",
    )
  } else {
    run Testing.expect(false, "parameter read has a checked body")
  }
  let inferred = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferred")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let annotated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"annotated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let localChain = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"localChain")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shadow = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"shadow")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unitLocal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unitLocal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &inferred,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"value")
      },
    ),
    "a later u8 return cannot retype an inferred i32 local",
  )
  let annotatedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &annotated,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move annotatedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"u8") && TypedBody.localSlice(body).length == 1
        },
      ),
      "an alias annotation selects u8 while the literal is still exact",
    )
  } else {
    run Testing.expect(false, "annotated local has a checked body")
  }
  let chainBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &localChain,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move chainBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyReadsLocalChain),
      "each immutable local has a body-owned identity and is available to later initializers",
    )
  } else {
    run Testing.expect(false, "local chain has a checked body")
  }
  let shadowBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &shadow,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move shadowBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyShadowsParameter),
      "the local initializer reads the parameter before the local shadows it",
    )
  } else {
    run Testing.expect(false, "parameter shadow has a checked body")
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&unitLocal, inspect).success,
    "unit locals can be read by a unit return",
  )
  let duplicate = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicateParameters = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"duplicateParameters",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forward = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"forward")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selfRead = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"selfRead")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooLargeLocal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooLargeLocal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let incompatibleLocal = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"incompatibleLocal",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &duplicate,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.Collision, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &duplicateParameters,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.Collision, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &forward,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.UnknownName, String.utf8Bytes(text), b"later")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &selfRead,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.UnknownName, String.utf8Bytes(text), b"value")
      },
    ),
    "duplicate locals and parameters reject, and missing initializer names retain exact use spans",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &tooLargeLocal,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          value,
          RejectionCode.IntegerOutOfRange,
          String.utf8Bytes(text),
          b"256",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &incompatibleLocal,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(value, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"1")
      },
    ),
    "an annotated initializer checks exact range and type at the initializer",
  )
  let discard = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"discard")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let discardBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &discard,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move discardBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyFirstIntegerType(body, b"i32")
        },
      ),
      "an integer without immediate context defaults to i32",
    )
  } else {
    run Testing.expect(false, "unit expression body is checked")
  }
  let empty = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"empty")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bare = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bare")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicit = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&empty, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&bare, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &explicit,
      inspect,
    ).success,
    "empty, bare-return, and explicit-unit bodies satisfy unit contracts",
  )
  let mismatch = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mismatch")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noReturn = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noReturn")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unsupported = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unsupported")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &mismatch,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.TypeMismatch)
      },
    ),
    "incompatible return has a type-mismatch rejection",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &noReturn,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.MissingReturn)
      },
    ),
    "reachable non-unit fallthrough has a missing-return rejection",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &unsupported,
      fn(value: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(value, RejectionCode.Unsupported)
      },
    ),
    "an operator has an unsupported-syntax rejection",
  )
  return ()
}

test effect fn bodyChecksRuntimeBranchesAndReachableReturns() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("branches.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn choose(flag: bool) -> i32 { if flag { return 1 } else { return 2 } }\nfn constantBad() -> i32 { if true { return 1 } else { return missing } }\nfn falseBad() -> i32 { if false { return missing } else { return 2 } }\nfn callerKnown() -> i32 { return badByFlag(true) }\nfn badByFlag(flag: bool) -> i32 { if flag { return 1 } else { return missing } }\nfn missingArm(flag: bool) -> i32 { if flag { return 1 } else { true } }\nfn partial(flag: bool) -> i32 { if flag { return 1 } }\nfn nonBool() -> i32 { if 1 { return 1 } else { return 2 } }\nfn badReturn(flag: bool) -> i32 { if flag { return true } else { return 2 } }\nfn branchScope() -> i32 { if true { let scoped = 1 } return scoped }\nfn branchDuplicate() -> i32 { if true { let value = 1 let value = 2 } return 0 }\nfn branchReuse() -> i32 { if true { let value = 1 } let value = 2 return value }\nfn bothLocals(flag: bool) -> i32 { if flag { let value = 1 return value } else { let value = 2 return value } }\nfn unreachableBad() -> i32 { return 1 if true { return missing } }\nfn unreachableValid() -> i32 { return 1 if true {} }\nfn laterReturn(flag: bool) -> i32 { if flag { return 1 } return 2 }\nfn unitFallthrough(flag: bool) { if flag { return } }\nfn chained(first: bool, second: bool) -> i32 { if first { return 1 } else if second { return 2 } else { return 3 } }\nfn callee() -> i32 { return missing }\nfn branchCall(flag: bool) -> i32 { if flag { return callee() } else { return 2 } }\nfn staticDeferred() -> i32 { static if true { return 1 } else { return 2 } }\n"
  let held = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &held)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let choose = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"choose")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &choose,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyHasCompleteBranch),
      "both returning arms retain typed branch and completion facts",
    )
  } else {
    run Testing.expect(false, "both returning arms produce a checked body")
  }
  let constantBad = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"constantBad")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let falseBad = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"falseBad")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callerKnown = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"callerKnown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badByFlag = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"badByFlag")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingArm = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingArm")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let partial = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"partial")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonBool = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nonBool")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badReturn = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"badReturn")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &constantBad,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &falseBad,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badByFlag,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&callerKnown, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &missingArm,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return missingReturnAtFunctionClose(answer, String.utf8Bytes(text), b"missingArm")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &partial,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return missingReturnAtFunctionClose(answer, String.utf8Bytes(text), b"partial")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &nonBool,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.ConditionNotBool, String.utf8Bytes(text), b"1")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &badReturn,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ),
    "constant and caller-known conditions do not hide bad arms; invalid exits reject",
  )
  let branchScope = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"branchScope")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let branchDuplicate = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"branchDuplicate",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let branchReuse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"branchReuse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bothLocals = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bothLocals")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let armLocals = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &bothLocals,
    checkedBody,
  )
  let mut distinct = false
  if let Option<Shared<TypedBody>>.Some {value} = move armLocals {
    distinct = Shared.with<TypedBody, bool>(&value, bodyHasDistinctArmLocals)
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &branchScope,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.UnknownName, String.utf8Bytes(text), b"scoped")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &branchDuplicate,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.Collision, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&branchReuse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&bothLocals, inspect).success && distinct,
    "branch bindings are lexical, duplicate only in their own block, and have body-local IDs",
  )
  let unreachableBad = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unreachableBad",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unreachableValid = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unreachableValid",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let laterReturn = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"laterReturn")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unitFallthrough = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unitFallthrough",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let chained = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"chained")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &unreachableBad,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"missing",
        )
      },
    ) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&unreachableValid, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&laterReturn, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &unitFallthrough,
      inspect,
    ).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(&chained, inspect).success,
    "later source is checked while only reachable paths govern fallthrough",
  )
  let branchCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"branchCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let branchBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &branchCall,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move branchBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, usize.ZERO)
        },
      ),
      "a call inside a runtime arm retains its signature and body obligation",
    )
  } else {
    run Testing.expect(false, "a call in a runtime arm produces a checked body")
  }
  let deferred = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"staticDeferred")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &deferred,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.Unsupported)
      },
    ) && starts(Semantic.eventLog(&semantic), Family.Body) == 20,
    "static selection remains unsupported and no callee body is demanded",
  )
  return ()
}

test effect fn operandEvidenceFillsNestedLifetimeAndRows() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run operandEvidenceClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn operandEvidenceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("operand-evidence.silk")
  let text = "service Clock {}\nservice Logger {}\nservice Channel<T> {}\nstruct Box<T> {}\nstruct Left<?R> {}\nstruct Right<?S> {}\nfn takeNested<T>(value: Box<T>) -> i32 { return 0 }\nfn useNested(value: Box<i32>) -> i32 { return takeNested(value) }\nfn takeSet<T>(value: Box<Box<T> | i32>) -> i32 { return 0 }\nfn useSet(value: Box<Box<u8> | i32>) -> i32 { return takeSet(value) }\nfn takeExact(value: Box<i32>) -> i32 { return 0 }\nfn wrongNested(value: Box<bool>) -> i32 { return takeExact(value) }\nfn wrongScalar(value: Box<i32>) -> i32 { return value }\nfn takeRegion<'a>(value: &'a i32) -> i32 { return 0 }\nfn useRegion(value: &'static i32) -> i32 { return takeRegion(value) }\nfn takeRows<?R, ?S>(first: Left<? R>, second: Right<? S>) -> i32 { return 0 }\nfn useRows(first: Left<&Clock>, second: Right<&Logger>) -> i32 { return takeRows(first, second) }\nfn takeRowKey<T>(value: Left<&Channel<T>>) -> i32 { return 0 }\nfn useRowKey(value: Left<&Channel<i32>>) -> i32 { return takeRowKey(value) }\nfn takeRepeated<?R>(first: Left<? R>, second: Left<? R>) -> i32 { return 0 }\nfn conflictingRows(first: Left<&Clock>, second: Left<&Logger>) -> i32 { return takeRepeated(first, second) }\n"
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useNested")
  let set = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useSet")
  let region = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRegion")
  let rows = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRows")
  let rowKey = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRowKey")
  let conflict = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictingRows")
  let wrongNested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongNested")
  let wrongScalar = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongScalar")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &nested,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1) && checkedNominalOperand(answer)
      },
    ),
    "a nested nominal operand fixes its type binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &region,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "a borrowed operand fixes its lifetime binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &set,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "one nested union member fixes its type binder without set subtraction",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &rows,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 2)
      },
    ),
    "independent operands fix two requirement rows",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &rowKey,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "one parameterized row key fixes its ordinary type binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &conflict,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongNested,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongScalar,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ),
    "conflicting row and nominal operands reject, and a nominal local cannot satisfy a scalar return",
  )
  return ()
}

test effect fn witnessRowResidualUsesFixedCoverage() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("witness-row-residual.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "service Clock {}\nservice Logger {}\nfn promised<?R>(value: Effect<'static; i32 ? &mut Clock | R>) -> i32 { return 0 }\nfn witness<?W>(value: Effect<'static; i32 ? &Clock | W>) -> i32 { return 0 }\nfn extra<?W>(value: Effect<'static; i32 ? &Logger | W>) -> i32 { return 0 }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let witnessOwner = run requireIdentity(&revision, &entry, OwnerKind.Function, b"witness", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extraOwner = run requireIdentity(&revision, &entry, OwnerKind.Function, b"extra", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let promised = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"promised")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let witness = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"witness")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extra = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"extra")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let promisedValue = slotOf(&promised, usize.ZERO)
  let witnessValue = slotOf(&witness, usize.ZERO)
  let extraValue = slotOf(&extra, usize.ZERO)
  if let Option<Shared<Type>>.Some {value: allowed} = move promisedValue {
    if let Option<Shared<Type>>.Some {value: required} = move witnessValue {
      let witnessDeclaration = run Shared.make<DeclarationId>(move witnessOwner)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut bindable = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(&mut bindable, move witnessDeclaration)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut ordinary = Vector.make<Binding>()
      let exact = run Type.unify(
        &allowed,
        &required,
        Vector.asSlice<Shared<DeclarationId>>(&bindable),
        Comparison.Exact,
        &mut ordinary,
      ) |> Effect.provideMut<Allocator>(&mut allocator)
      let mut bindings = Vector.make<Binding>()
      let residual = run Type.bindWitnessResidual(
        &allowed,
        &required,
        Vector.asSlice<Shared<DeclarationId>>(&bindable),
        &mut bindings,
      ) |> Effect.provideMut<Allocator>(&mut allocator)
      let ordinaryUnknown = match & exact {
        Unification.Undetermined {..} => Vector.length<Binding>(&ordinary) == usize.ZERO
        _ => false
      }
      let mut boundToPromisedRow = false
      let matched = match & residual {
        Unification.Unified => true
        _ => false
      }
      if matched {
        let values = Vector.asSlice<Binding>(&bindings)
        if values.length == usize.ONE {
          if let Argument.Row {value} = &values[usize.ZERO].value {
            boundToPromisedRow = Shared.with<Row, bool>(
              &value,
              fn(row: &Row) -> bool {
                return Vector.length(&row.parameters) == usize.ONE && Vector.length<Requirement>(
                  &row.entries,
                ) == usize.ZERO
              },
            )
          }
        }
      }
      run Testing.expect(
        ordinaryUnknown && boundToPromisedRow,
        "a covered fixed witness key leaves its open row bound to the promised row parameter without changing Exact equality",
      )
      if let Option<Shared<Type>>.Some {value: uncovered} = move extraValue {
        let extraDeclaration = run Shared.make<DeclarationId>(move extraOwner)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut extraBindable = Vector.make<Shared<DeclarationId>>()
        run Vector.append<Shared<DeclarationId>>(&mut extraBindable, move extraDeclaration)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut extraBindings = Vector.make<Binding>()
        let failed = run Type.bindWitnessResidual(
          &allowed,
          &uncovered,
          Vector.asSlice<Shared<DeclarationId>>(&extraBindable),
          &mut extraBindings,
        ) |> Effect.provideMut<Allocator>(&mut allocator)
        let uncoveredRejected = match & failed {
          Unification.Distinct => Vector.length<Binding>(&extraBindings) == usize.ZERO
          _ => false
        }
        run Testing.expect(uncoveredRejected, "an open witness row cannot conceal an uncovered fixed requirement")
      } else {
        run Testing.expect(false, "the uncovered witness has a source-resolved row")
      }
    } else {
      run Testing.expect(false, "the witness has a source-resolved row")
    }
  } else {
    run Testing.expect(false, "the promise has a source-resolved row")
  }
  return ()
}

fn checkedCallGenericCount(answer: &Result<Answer, NoRejection>, count: usize) -> bool {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(
      &value,
      fn(checked: &TypedBody) -> bool {
        return bodyCallGenericCount(checked, count)
      },
    )
  }
  return false
}

fn nominalType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {..} => true
    _ => false
  }
}

fn checkedNominalOperand(answer: &Result<Answer, NoRejection>) -> bool {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(
      &value,
      fn(checked: &TypedBody) -> bool {
        let locals = TypedBody.localSlice(checked)
        if locals.length != 1 || !Shared.with<Type, bool>(&locals[0].ty, nominalType) {
          return false
        }
        let nodes = TypedBody.nodeSlice(checked)
        let mut at = usize.ZERO
        while at < nodes.length {
          if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {arguments, ..}, ..} = &nodes[at].kind {
            let supplied = Vector.asSlice<BodyNodeId>(&arguments)
            if supplied.length == 1 {
              if let BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} = &nodes[supplied[usize.ZERO].index].kind {
                return local.index == usize.ZERO && Shared.with<Type, bool>(&ty, nominalType)
              }
            }
          }
          at = at + usize.ONE
        }
        return false
      },
    )
  }
  return false
}

test effect fn bodyChecksDirectCallsWithoutDemandingCalleeBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run module("missing.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "import library as Library { leaf as selected }\nimport missing as Missing\nservice Clock {}\nfn leaf() -> i32 { return missing }\nfn caller() -> i32 { let value = leaf() return value }\nfn pair(first: u8, second: i32) -> i32 { return second }\nfn contextual() -> i32 { return pair(255, 1) }\nfn nested() -> i32 { return pair(255, leaf()) }\nfn incompatible() -> i32 { return pair(true, 1) }\nfn fixedLocal() -> i32 { let value = 255 return pair(value, 1) }\nfn tooMany() -> i32 { return pair(1, 2, 3) }\nfn section() -> i32 { return pair(1) }\nfn invalidSection() -> i32 { return pair(true) }\nfn emptyCall() -> i32 { return pair() }\nfn nonCallable() -> i32 { let value = 1 return value() }\nfn generic<A, B>(first: A, second: B) -> i32 { return 0 }\nfn excessPrefix() -> i32 { return generic<i32, bool, u8>(1, true) }\nfn wrongPrefixKind() -> i32 { return generic<'static>(1, true) }\nfn unknownPrefixType() -> i32 { return generic<MissingType>(1, true) }\nfn nongenericPrefix() -> i32 { return leaf<i32>() }\nfn choose<A, B>(first: A, second: B) -> A { return move first }\nfn inferUse() -> i32 { return choose(42, true) }\nfn explicitUse() -> i32 { return choose<i32>(42, true) }\nfn conflictUse() -> i32 { return choose<bool>(42, true) }\nfn repeated<T>(first: T, second: T) -> T { return move first }\nfn repeatedConflict() -> i32 { return repeated(42, true) }\nfn resultOnly<T>() -> T { return 0 }\nfn unknownResult() -> i32 { return resultOnly() }\nfn lifetimeFirst<'a, T>(value: T) -> T { return move value }\nfn lifetimePrefix() -> i32 { return lifetimeFirst<'static>(42) }\nfn missingLifetime() -> i32 { return lifetimeFirst(42) }\nfn twoRows<?R, ?S>(value: i32) -> i32 { return value }\nfn positionalRows() -> i32 { return twoRows<&Clock, never>(1) }\nfn missingSecondRow() -> i32 { return twoRows<&Clock>(1) }\nfn left() -> i32 { return right() }\nfn right() -> i32 { return left() }\nfn imported() -> i32 { return selected() }\nfn qualified() -> i32 { return Library.leaf() }\nfn absent() -> i32 { return Library.absent() }\nfn missingCall() -> i32 { return Missing.leaf() }\n"
  let entrySource = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("pub fn leaf() -> i32 { return missing }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(move revision)
  let mut request = Request.make()
  let caller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &caller,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move callerBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, usize.ZERO)
        },
      ) && starts(Semantic.eventLog(&semantic), Family.Body) == 1,
      "a caller keeps its callee signature and runtime obligation without checking the broken leaf",
    )
  } else {
    run Testing.expect(false, "the direct caller has a checked body")
  }
  let contextual = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"contextual")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let contextualBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &contextual,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move contextualBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, 2) && bodyFirstIntegerType(body, b"u8")
        },
      ),
      "source-ordered arguments receive their own immediate parameter contexts",
    )
  } else {
    run Testing.expect(false, "the contextual call has a checked body")
  }
  let nested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &nested,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move nestedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyNestedCalls),
      "nested calls retain each runtime body in argument evaluation order",
    )
  } else {
    run Testing.expect(false, "the nested call has a checked body")
  }
  let incompatible = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"incompatible")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fixedLocal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"fixedLocal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooMany = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooMany")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let section = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"section")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidSection = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"invalidSection",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"emptyCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonCallable = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nonCallable")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &incompatible,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &fixedLocal,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooMany,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.CallArity)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &section,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.Unsupported)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &invalidSection,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &emptyCall,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.RedundantCall)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &nonCallable,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.NotCallable)
      },
    ),
    "direct calls distinguish argument types, invalid arity, deferred sections, and non-callables",
  )
  let excessPrefix = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"excessPrefix",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongPrefixKind = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"wrongPrefixKind",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nongenericPrefix = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"nongenericPrefix",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownPrefixType = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unknownPrefixType",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &excessPrefix,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeArity, String.utf8Bytes(text), b"u8")
      },
    ),
    "an excess call prefix rejects at its first extra argument",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongPrefixKind,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.TypeArgumentKind,
          String.utf8Bytes(text),
          b"'static",
        )
      },
    ),
    "a written call prefix checks its binder kind",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &unknownPrefixType,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"MissingType",
        )
      },
    ),
    "a written call prefix resolves its type argument",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &nongenericPrefix,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeArity, String.utf8Bytes(text), b"i32")
      },
    ),
    "a nongeneric function rejects a written type argument",
  )
  let inferUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicitUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicitUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let lifetimePrefix = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"lifetimePrefix")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let positionalRows = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"positionalRows")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingLifetime = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingLifetime")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingSecondRow = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"missingSecondRow",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let conflictUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedConflict = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"repeatedConflict",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownResult = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknownResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&inferUse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&explicitUse, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &lifetimePrefix,
      inspect,
    ).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &positionalRows,
      inspect,
    ).success,
    "supplied operands infer after a fixed prefix, while positional lifetime and row arguments retain their kinds",
  )
  let inferredBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &inferUse,
    checkedBody,
  )
  let rowBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &positionalRows,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: inferredCall} = move inferredBody {
    if let Option<Shared<TypedBody>>.Some {value: rowCall} = move rowBody {
      run Testing.expect(
        Shared.with<TypedBody, bool>(
          &inferredCall,
          fn(body: &TypedBody) -> bool { return bodyCallGenericCount(body, 2) },
        ) && Shared.with<TypedBody, bool>(
          &rowCall,
          fn(body: &TypedBody) -> bool { return bodyCallGenericCount(body, 2) },
        ),
        "typed calls retain completed ordinary and row applications",
      )
    } else {
      run Testing.expect(false, "row call has a checked body")
    }
  } else {
    run Testing.expect(false, "inferred call has a checked body")
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &missingLifetime,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "an omitted lifetime binder without operand evidence remains uninferred",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &missingSecondRow,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "an omitted second row binder without operand evidence remains uninferred",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &conflictUse,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &repeatedConflict,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &unknownResult,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "conflicting operand evidence and result-only parameters reject without result inference",
  )
  let left = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"left")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"right")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&left, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&right, inspect).success,
    "written signatures let mutually recursive bodies check without a body-query cycle",
  )
  let imported = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"imported")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let absent = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"absent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let importedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &imported,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move importedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &library, usize.ZERO)
        },
      ),
      "selected imports keep the canonical imported callee",
    )
  } else {
    run Testing.expect(false, "the selected imported call has a checked body")
  }
  let qualifiedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &qualified,
    checkedBody,
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&qualified, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &absent,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownMember,
          String.utf8Bytes(text),
          b"absent",
        )
      },
    ) && Request.hasDiscovered(&request, &library) && Request.hasDemand(
      &request,
      Family.Signature,
      &library,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &missingCall,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
          answer,
          &missing,
        )
      },
    ) && starts(Semantic.eventLog(&semantic), Family.Body) == 29,
    "imported calls retain positive and negative name evidence without demanding library bodies",
  )
  if let Option<Shared<TypedBody>>.Some {value} = move qualifiedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &library, usize.ZERO)
        },
      ),
      "qualified imports use the same canonical callee",
    )
  }
  let mut fresh = Request.make()
  let replayed = run Semantic.demandBody(&mut semantic, &mut fresh, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut freshNegative = Request.make()
  let replayedAbsence = run Semantic.demandBody(
    &mut semantic,
    &mut freshNegative,
    &entry,
    b"absent",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let replayedMissing = run Semantic.demandBody(
    &mut semantic,
    &mut freshNegative,
    &entry,
    b"missingCall",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && Request.hasDiscovered(
      &fresh,
      &library,
    ) && Request.hasDemand(&fresh, Family.Signature, &library) && Request.hasDemand(
      &fresh,
      Family.Import,
      &entry,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &replayedAbsence,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UnknownMember)
      },
    ) && Request.hasDiscovered(&freshNegative, &library) && Request.hasDemand(
      &freshNegative,
      Family.Name,
      &library,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &replayedMissing,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
          answer,
          &missing,
        )
      },
    ) && Request.hasDemand(&freshNegative, Family.Import, &entry) && hits(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) > 0,
    "fresh caller hits replay imported signature and source discoveries",
  )
  return ()
}

test effect fn bodyReusesValidatedCallerAcrossControlledEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("controlled.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &initial)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut coldRequest = Request.make()
  let cold = run Semantic.demandBody(&mut semantic, &mut coldRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut warmRequest = Request.make()
  let warm = run Semantic.demandBody(&mut semantic, &mut warmRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let coldBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &cold,
    checkedBody,
  )
  let mut coldCallsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move coldBody {
    coldCallsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &entry, usize.ZERO)
      },
    )
  }
  run Testing.expect(
    coldCallsLeaf && Shared.with<Result<Answer, NoRejection>, AnswerView>(&cold, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &warm,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return bodyHasCurrentSource(answer, &first)
      },
    ) && Request.hasRoot(&warmRequest, Family.Body, &entry, b"caller") && Request.hasDemand(
      &warmRequest,
      Family.Signature,
      &entry,
    ) && hits(Semantic.eventLog(&semantic), Family.Body) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 1,
    "cold and warm caller demands agree while the leaf body remains undemanded",
  )
  let changedBody = run present(
    "fn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &entry, &changedBody)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut editedRequest = Request.make()
  let edited = run Semantic.demandBody(&mut semantic, &mut editedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let currentSource = Shared.with<Result<Answer, NoRejection>, bool>(
    &edited,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return bodyHasCurrentSource(answer, &second)
    },
  )
  let reuseCount = reused(Semantic.eventLog(&semantic))
  let bodyStarts = starts(Semantic.eventLog(&semantic), Family.Body)
  let bodyHits = hits(Semantic.eventLog(&semantic), Family.Body)
  let hasRoot = Request.hasRoot(&editedRequest, Family.Body, &entry, b"caller")
  let hasSignature = Request.hasDemand(&editedRequest, Family.Signature, &entry)
  let editedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &edited,
    checkedBody,
  )
  let mut editedCallsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move editedBody {
    editedCallsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &entry, usize.ZERO)
      },
    )
  }
  run Testing.expect(
    currentSource && editedCallsLeaf && reuseCount == 1 && bodyStarts == 2 && bodyHits == 1 && hasRoot && hasSignature,
    "same-file leaf implementation edit validates and retains the caller payload with current evidence",
  )
  let collisionSource = run present(
    "fn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\nfn leaf() -> i32 { return 3 }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let collision = run Revision.publish(&second, &entry, &collisionSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&collision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut ambiguousRequest = Request.make()
  let ambiguous = run Semantic.demandBody(&mut semantic, &mut ambiguousRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let collisionRejected = Shared.with<Result<Answer, NoRejection>, bool>(
    &ambiguous,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.Collision)
    },
  )
  run Testing.expect(
    collisionRejected && reused(Semantic.eventLog(&semantic)) == 1,
    "ambiguous callee declaration mapping checks the caller afresh",
  )
  let shiftedSource = run present(
    "\nfn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shifted = run Revision.publish(&collision, &entry, &shiftedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&shifted)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut shiftedRequest = Request.make()
  let shiftedAnswer = run Semantic.demandBody(&mut semantic, &mut shiftedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &shiftedAnswer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return bodyHasCurrentSource(answer, &shifted)
      },
    ) && reused(Semantic.eventLog(&semantic)) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 4,
    "a source offset change checks a fresh caller instead of keeping old syntax positions",
  )
  let changedSignatureText = "\nfn leaf() -> bool { return true }\nfn caller() -> i32 { let value = leaf() return value }\n"
  let changedSignature = run present(changedSignatureText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fourth = run Revision.publish(&shifted, &entry, &changedSignature)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move fourth)
  let mut invalidRequest = Request.make()
  let invalid = run Semantic.demandBody(&mut semantic, &mut invalidRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &invalid,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.TypeMismatch,
          String.utf8Bytes(changedSignatureText),
          b"value",
        )
      },
    ) && reused(Semantic.eventLog(&semantic)) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 5,
    "a changed leaf signature invalidates the checked caller",
  )
  return ()
}

test effect fn bodyRechecksImportedPathAndDeclarationEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("importing.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "import library as Library\nfn caller() -> i32 { return Library.leaf() }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.make(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut missingRequest = Request.make()
  let missing = run Semantic.demandBody(&mut semantic, &mut missingRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pathMissing = Shared.with<Result<Answer, NoRejection>, bool>(
    &missing,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
        answer,
        &library,
      )
    },
  )
  run Testing.expect(pathMissing, "an absent imported path rejects its actual caller")

  let empty = run present("")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &library, &empty)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut absentRequest = Request.make()
  let absent = run Semantic.demandBody(&mut semantic, &mut absentRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let declarationMissing = Shared.with<Result<Answer, NoRejection>, bool>(
    &absent,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.UnknownMember)
    },
  )
  run Testing.expect(
    declarationMissing,
    "a newly present path still rejects its missing declaration",
  )

  let exported = run present("pub fn leaf() -> i32 { return 1 }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run Revision.publish(&second, &library, &exported)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&third)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut foundRequest = Request.make()
  let found = run Semantic.demandBody(&mut semantic, &mut foundRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let foundBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &found,
    checkedBody,
  )
  let mut callsLibrary = false
  if let Option<Shared<TypedBody>>.Some {value} = move foundBody {
    callsLibrary = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &library, usize.ZERO)
      },
    )
  }
  let foundSignature = Request.hasDemand(&foundRequest, Family.Signature, &library)
  run Testing.expect(
    callsLibrary && foundSignature,
    "adding the imported declaration checks the caller and records its runtime obligation",
  )

  let fourth = run Revision.publish(&third, &library, &empty)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&fourth)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut removedRequest = Request.make()
  let removed = run Semantic.demandBody(&mut semantic, &mut removedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let removedDeclaration = Shared.with<Result<Answer, NoRejection>, bool>(
    &removed,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.UnknownMember)
    },
  )
  run Testing.expect(
    removedDeclaration,
    "removing the imported declaration invalidates the checked caller",
  )

  let fifth = run Revision.publish(&fourth, &library, &Option.none<Bytes>())
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move fifth)
  let mut removedPathRequest = Request.make()
  let removedPath = run Semantic.demandBody(
    &mut semantic,
    &mut removedPathRequest,
    &entry,
    b"caller",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pathGone = Shared.with<Result<Answer, NoRejection>, bool>(
    &removedPath,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
        answer,
        &library,
      )
    },
  )
  let allRechecked = starts(Semantic.eventLog(&semantic), Family.Body) == 5 && reused(
    Semantic.eventLog(&semantic),
  ) == 0
  run Testing.expect(
    pathGone && allRechecked && Request.hasRoot(&removedPathRequest, Family.Body, &entry, b"caller"),
    "removing the imported path records current negative evidence without retaining an old body",
  )
  return ()
}
