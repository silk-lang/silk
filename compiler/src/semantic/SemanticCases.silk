effect fn genericStagingClaims(text: string<'static>, selected: bool, twoTypes: bool) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("generic-staging.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && genericStagingCalls(&store, &caller, false, twoTypes),
    "stages directly call the original complete target and append field one before field zero")
  if let Option<Shared<Type>>.Some {value: ty} = move genericStagingEnvironment(&store, &caller) {
    run Testing.expect(!Type.hasOpenRuntimeParameters(&ty) && Shared.with<Type, bool>(&ty,
      fn(value: &Type) -> bool { return genericStagingMetadata(value, selected) }),
      "staging keeps original binder ordinals, selected evidence and capture construction order without publishing a fresh inference owner")
    let layout = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let selectedLayout = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&layout, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move selectedLayout {
      if let Option<Shared<BackendLayout>>.Some {value} = move Semantic.layoutAt(&store, index) {
        run Testing.expect(Shared.with<BackendLayout, bool>(&value, genericStagingRecord),
          "staging lays out only bool then i32 captures, without an adapter, code pointer or nested section environment")
        return ()
      }
    }
  }
  run Testing.expect(false, "a generic stage retains its exact two-capture record layout")
}

fn genericStagingFieldCount(value: &Type) -> usize {
  return match &value.* {
    Type.CallableSchema {captures, ..} => Vector.length<Shared<Type>>(&captures)
    Type.CallableValue {captures, ..} => Vector.length<Shared<Type>>(&captures)
    _ => usize.ZERO
  }
}
fn genericStagingEnvironment(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if Shared.with<Type, usize>(&locals[at].ty, genericStagingFieldCount) == 2 {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[at].ty))
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<Type>>()
}
fn genericStagingInput(value: &CallableFieldInput, parameter: usize) -> bool {
  return match &value.* { CallableFieldInput.Argument {parameter: at} => at == parameter _ => false }
}
fn genericStagingMetadata(value: &Type, selected: bool) -> bool {
  if let Type.CallableValue {application, captures, fieldInputs, ..} = &value.* {
    if !selected || !genericStagingCaptureOrder(&captures, &fieldInputs) { return false }
    return Shared.with<SpecializationApplication, bool>(&application, fn(target: &SpecializationApplication) -> bool {
      return Vector.length<ScopeBinding>(&target.scopes) == usize.ZERO && Vector.length<StaticSlot>(&target.statics) == usize.ZERO
        && genericSectionApplication(target, b"select", usize.ZERO, usize.ZERO) == usize.ONE
    })
  }
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    if selected || !genericStagingCaptureOrder(&captures, &fieldInputs) { return false }
    return Shared.with<SectionSchema, bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      let evidence = Vector.asSlice<Binding>(&recipe.selected)
      let deferred = Vector.asSlice<usize>(&recipe.deferred)
      return evidence.length == usize.ZERO && deferred.length == usize.ONE && deferred[usize.ZERO] == usize.ZERO
    })
  }
  return false
}
fn genericStagingCaptureOrder(captures: &Vector<Shared<Type>>, fieldInputs: &Vector<CallableFieldInput>) -> bool {
  let inputs = Vector.asSlice<CallableFieldInput>(fieldInputs)
  return Vector.length<Shared<Type>>(captures) == 2 && inputs.length == 2
    && genericStagingInput(&inputs[usize.ZERO], 2) && genericStagingInput(&inputs[usize.ONE], usize.ONE)
}
fn genericStagingRecord(value: &BackendLayout) -> bool {
  if let LayoutStorage.Record {fields} = &value.storage {
    let listed = Vector.asSlice<LayoutField>(&fields)
    return listed.length == 2 && listed[usize.ZERO].offset == usize.ZERO && listed[usize.ONE].offset == 4
      && Shared.with<Type, bool>(&listed[usize.ZERO].ty, fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"bool") })
      && Shared.with<Type, bool>(&listed[usize.ONE].ty, fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"i32") })
  }
  return false
}
fn genericStagingCalls(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, moved: bool, twoTypes: bool) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut integer = false
  let mut boolean = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value _ => { return false }
          }
          let kind = Shared.with<SpecializationApplication, usize>(&application,
            fn(value: &SpecializationApplication) -> usize { return genericSectionApplication(value, b"select", usize.MAX, usize.ZERO) })
          let values = Vector.asSlice<MirOperand>(&arguments)
          if kind == usize.ZERO || values.length != 3 || !genericStagingOperand(&values[usize.ONE], usize.ONE, moved)
            || !genericStagingOperand(&values[2], usize.ZERO, moved) { return false }
          if kind == usize.ONE { integer = true }
          if kind == 2 { boolean = true }
        }
        at = at + usize.ONE
      }
    }
  }
  return integer && boolean == twoTypes
}
fn genericStagingOperand(value: &MirOperand, field: usize, moved: bool) -> bool {
  if moved {
    if let MirOperand.Move {place} = &value.* {
      return Vector.length<MirProjection>(&place.projections) == usize.ONE && lastProjectionCode(&place.projections) == field
    }
    return false
  }
  return sectionStoredField(value, field)
}

test effect fn genericSectionsStageOwnedCapturesWithOneCleanupOwner() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run genericOwnedStagingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn genericOwnedStagingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("generic-owned-staging.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn select<T>(value: T, token: Token, enabled: bool) -> T { drop token return move value }
fn main(token: Token) -> i32 {
  let base = select(true)
  let staged = base(move token)
  return staged(42)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && genericStagingCalls(&store, &caller, true, false)
    && glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
    "staging transfers a moved capture to the original target exactly once, leaving no caller cleanup")
  if let Option<Shared<Type>>.Some {value: ty} = move genericStagingEnvironment(&store, &caller) {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ONE,
      "an unused staged environment drops its owned capture through ordinary capture glue")
  } else { run Testing.expect(false, "owned staging retains its exact capture record") }
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &caller, b"select") {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target) && glueFact(&store, &target, usize.ZERO) == usize.ONE,
      "the invoked original target owns the sole moved-capture cleanup")
    return ()
  }
  run Testing.expect(false, "owned staging has an ordinary complete target application")
}

// A named value has storage but no hidden receiver ABI. Construction must not execute its target.
fn namedValueConstruction(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut empty = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {..} = &blocks[at].terminator { return false }
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Aggregate {fields}, ..} = &statements[statementAt] {
            if Vector.length<MirAggregateField>(&fields) == usize.ZERO { empty = true }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
      return empty
    }
  }
  return false
}

fn namedValueDirectCalls(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut constructor = false
      let mut original = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          if let MirCallee.Instance {key} = &callee {
            let identity = InstanceKey.identity(&key)
            let creates = Shared.with<DeclarationId, bool>(&identity,
              fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"makeNamedZero") })
            let invokes = Shared.with<DeclarationId, bool>(&identity,
              fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"namedZero") })
            if (!creates && !invokes) || Vector.length<MirOperand>(&arguments) != usize.ZERO { return false }
            if creates { constructor = true }
            if invokes { original = true }
          } else { return false }
        }
        at = at + usize.ONE
      }
      return constructor && original
    }
  }
  return false
}

test effect fn namedFunctionValuesConstructEmptyEnvironmentsAndReturnExactTypes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run namedFunctionValueClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn namedFunctionValueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("named-function-values.silk")
  let text = """
fn namedZero() -> i32 { return 7 }
fn makeNamedZero() -> typeof(namedZero) { return namedZero }
fn main() -> i32 { let callback = makeNamedZero() return callback() }
unsafe fn unsafeNamedZero() -> i32 { return 7 }
fn storeUnsafeNamed() -> typeof(unsafeNamedZero) { return unsafeNamedZero }
fn invokeUnsafeNamed() -> i32 { let callback = unsafeNamedZero return callback() }
unsafe extern "C" fn foreignNamedZero() -> i32
fn storeForeignNamed() -> () { let invalid = foreignNamedZero }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let construct = run Semantic.demandMir(&mut store, &mut request, &id, b"makeNamedZero")
  let invoke = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&construct) && namedValueConstruction(&store, &construct),
    "returning typeof(namedZero) constructs an empty environment without invoking its zero-arity target")
  run Testing.expect(succeeded(&invoke) && namedValueDirectCalls(&store, &invoke),
    "a returned named value calls its original ordinary function with no hidden environment operand or adapter")
  let unsafeConstruction = run Semantic.demandBody(&mut store, &mut request, &id, b"storeUnsafeNamed")
  let unsafeInvocation = run Semantic.demandBody(&mut store, &mut request, &id, b"invokeUnsafeNamed")
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"storeForeignNamed")
  run Testing.expect(succeeded(&unsafeConstruction)
    && rejectsSpan(&unsafeInvocation, RejectionCode.UnsafeAcknowledgement, text, "callback()", usize.ONE),
    "even a zero-arity unsafe function requires acknowledgement only when its stored value is invoked")
  run Testing.expect(rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass, text, "foreignNamedZero", usize.ONE),
    "a zero-arity foreign function cannot become an ordinary stored callable (SEM0189)")
}

fn genericNamedValueTargets(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let found = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move found {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut integer = false
      let mut boolean = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value
            _ => { return false }
          }
          let kind = Shared.with<SpecializationApplication, usize>(&application,
            fn(value: &SpecializationApplication) -> usize {
              return genericSectionApplication(value, b"namedIdentity", usize.MAX, usize.ZERO)
            })
          if kind == usize.ZERO || Vector.length<MirOperand>(&arguments) != usize.ONE { return false }
          if kind == usize.ONE { integer = true }
          if kind == 2 { boolean = true }
        }
        at = at + usize.ONE
      }
      return integer && boolean
    }
  }
  return false
}

