}

test effect fn contractReuseRevisionChangedOperation() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("operation-edited.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "interface Mark { fn value(item: Self) -> i32 }\nstruct Item {}\nimpl Mark for Item { fn value(item: Self) -> i32 { return 1 } }\nfn caller(item: Item) -> i32 { return Mark.value(move item) }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let changedSource = run present(
    "interface Mark { fn value(item: Self) -> bool }\nstruct Item {}\nimpl Mark for Item { fn value(item: Self) -> i32 { return 1 } }\nfn caller(item: Item) -> i32 { return Mark.value(move item) }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
