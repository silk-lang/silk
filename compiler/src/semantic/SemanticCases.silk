  }) && Shared.with<Result<Answer, NoRejection>, bool>(&nested, nestedAnonymousBodyFacts),
    "both ordinary anonymous bodies retain their own exact Copy capture of the lexical seed")
}

test effect fn anonymousBorrowedCallableCapturesRetainOneCleanupOwner() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run borrowedCallableCaptureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn borrowedCallableCaptureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("borrowed-callable-capture.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn take(token: Token) -> i32 { return token.value }
fn peek(callback: &once fn<'static>() -> i32) -> i32 { return 42 }
fn main() -> i32 {
  let token = Token { value: 40 }
  let inner = fn() -> i32 { return take(move token) }
  let outer = fn() -> i32 { return peek(&inner) }
  return outer()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&source, checkedBody)
  let environment = match move selected {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, Option<Shared<Type>>>(&value, borrowedCallableCaptureBody)
    _ => Option.none<Shared<Type>>()
  }
  run Testing.expect(match &environment { Option<Shared<Type>>.Some {..} => true _ => false },
    "shared capture of an owned callable stores a loan and dereferences its environment alias")
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && borrowedCallableCaptureMir(&store, &caller)
    && glueFact(&store, &caller, usize.ZERO) == usize.ONE,
    "construction borrows the original callable place and leaves one environment cleanup owner")
  if let Option<Shared<Type>>.Some {value} = move environment {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &value)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ZERO,
      "dropping the borrowing outer environment cannot drop the owned inner captures")
  }
}

fn ownedInnerCallable(value: &Type) -> bool {
  if let Type.CallableValue {contract, captures, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return Shared.with<Type, CallableMode>(&contract, captureContractMode) == CallableMode.Once
      && fields.length == usize.ONE && Shared.with<Type, bool>(&fields[usize.ZERO], ownedCaptureToken)
  }
  return false
}

fn sharedInnerCallableLoan(value: &Type) -> bool {
  if let Type.Reference {access, referent, ..} = &value.* {
    return access == Access.Shared && Shared.with<Type, bool>(&referent, ownedInnerCallable)
  }
  return false
}

fn ownedCaptureToken(value: &Type) -> bool {
  return match &value.* {
    Type.Nominal {declaration, arguments, ..} => DeclarationId.named(&declaration, b"Token")
      && Vector.length<Argument>(&arguments) == usize.ZERO
    _ => false
  }
}

fn borrowedOuterCallable(value: &Type) -> bool {
  if let Type.CallableValue {contract, captures, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    return Shared.with<Type, CallableMode>(&contract, captureContractMode) == CallableMode.Shared
      && fields.length == usize.ONE && Shared.with<Type, bool>(&fields[usize.ZERO], sharedInnerCallableLoan)
  }
  return false
}

fn borrowedCallableAlias(body: &TypedBody) -> bool {
  let available = TypedBody.environmentOf(body)
  if let Option<BodyEnvironment>.Some {value} = &available.* {
    let fields = Vector.asSlice<BodyEnvironmentCapture>(&value.captures)
    return fields.length == usize.ONE && fields[usize.ZERO].dereference
  }
  return false
}

fn borrowedCallableCaptureBody(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {fields, body: anonymous}} = &nodes[at].kind {
      if Shared.with<Type, bool>(&ty, borrowedOuterCallable) {
        let captured = Vector.asSlice<BodyAggregateField>(&fields)
        if captured.length != usize.ONE || !Shared.with<TypedBody, bool>(&anonymous, borrowedCallableAlias) {
          return Option.none<Shared<Type>>()
        }
        if let BodyNodeKind.Expression {ty: loan, form: BodyExpression.Borrow {access, value}} = &nodes[captured[usize.ZERO].value.index].kind {
          if access == Access.Shared && Shared.with<Type, bool>(&loan, sharedInnerCallableLoan) {
            if let BodyNodeKind.Expression {ty: owner, form: BodyExpression.Local {..}} = &nodes[value.index].kind {
              if Shared.with<Type, bool>(&owner, ownedInnerCallable) { return Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) }
            }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn borrowedCallableCaptureMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return borrowedCallableAggregate(function)
    }
  }
  return false
}

fn borrowedCallableAggregate(function: &MirFunction) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, ..} = &statements[statement] {
        if Shared.with<Type, bool>(&locals[destination.local].ty, borrowedOuterCallable) {
          let captured = Vector.asSlice<MirAggregateField>(&fields)
          if captured.length != usize.ONE { return false }
          let source = borrowedCallableFieldLocal(&captured[usize.ZERO].value)
          return source != usize.MAX && Shared.with<Type, bool>(&locals[source].ty, sharedInnerCallableLoan)
            && borrowedCallableReference(function, source)
        }
      }
      statement = statement + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn borrowedCallableFieldLocal(value: &MirOperand) -> usize {
  return match &value.* {
    MirOperand.Copy {place} => place.local
    MirOperand.Move {place} => place.local
    _ => usize.MAX
  }
}

fn borrowedCallableReference(function: &MirFunction, local: usize) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut statement = usize.ZERO
    while statement < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Ref {access, place}, ..} = &statements[statement] {
        if destination.local == local && access == Access.Shared && Vector.length<MirProjection>(&place.projections) == usize.ZERO {
          return borrowedCallableOriginalOwner(&locals[place.local])
        }
      }
      statement = statement + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn borrowedCallableOriginalOwner(local: &MirLocal) -> bool {
  if let MirLocalKind.User {index} = &local.kind {
    return index == usize.ONE && Shared.with<Type, bool>(&local.ty, ownedInnerCallable)
  }
  return false
}

fn firstCallableEnvironment(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Callable {..}} = &nodes[at].kind {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&ty))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

fn callableEnvironment(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match move checkedBody(answer) {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, Option<Shared<Type>>>(&value, firstCallableEnvironment)
    Option<Shared<TypedBody>>.None => Option.none<Shared<Type>>()
  }
}

fn paddedEnvironmentSmall(ty: &Type) -> bool { return witnessPrimitive(ty, b"u8") }
fn paddedEnvironmentWide(ty: &Type) -> bool { return witnessPrimitive(ty, b"i64") }
fn paddedEnvironmentRecord(record: &BackendLayout) -> bool {
  if let LayoutStorage.Record {fields} = &record.storage {
    let stored = Vector.asSlice<LayoutField>(&fields)
    return stored.length == 2 && stored[0].offset == usize.ZERO && stored[1].offset == 8
      && record.size == 16 && record.alignment == 8 && record.abi == LayoutAbi.Indirect
      && Shared.with<Type, bool>(&stored[0].ty, paddedEnvironmentSmall)
      && Shared.with<Type, bool>(&stored[1].ty, paddedEnvironmentWide)
  }
  return false
}

// Production layout demands must retain capture order and padding; a code/environment pointer
// pair, sorted capture fields, or a missing empty environment would fail these record claims.
test effect fn anonymousEnvironmentsUseCaptureOrderedRecords() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousEnvironmentLayoutClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousEnvironmentLayoutClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("environment-layout.silk")
  let text = """
fn padded(small: u8, wide: i64) -> () {
  let callable = fn() -> i64 { let observed = small return wide }
}
fn empty() -> () { let callable = fn() -> i32 { return 1 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let padded = run Semantic.demandBody(&mut store, &mut request, &id, b"padded")
  let empty = run Semantic.demandBody(&mut store, &mut request, &id, b"empty")
  let paddedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&padded, callableEnvironment)
  let emptyType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&empty, callableEnvironment)
  let mut paddedRecord = false
  if let Option<Shared<Type>>.Some {value: ty} = move paddedType {
    // LLVM layout lookup compares exact environment handles, including a copy that shares the
    // cached runtime key. These comparisons must not take two loans of that shared buffer.
    let copied = run Shared.make<Type>(run Type.copy(&ty))
    let sameRuntime = run Type.runtimeEqualsShared(&ty, &ty)
    let copiedRuntime = run Type.runtimeEqualsShared(&ty, &copied)
    let copiedIdentity = run Type.equalsShared(&ty, &copied)
    run Testing.expect(sameRuntime && copiedRuntime && copiedIdentity, "closure identity comparison accepts aliased runtime keys")
    let demanded = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let selectedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&demanded, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move selectedIndex {
      if let Option<Shared<BackendLayout>>.Some {value: layout} = move Semantic.layoutAt(&store, index) {
        paddedRecord = Shared.with<BackendLayout, bool>(&layout, paddedEnvironmentRecord)
      }
    }
  }
  let mut emptyRecord = false
  if let Option<Shared<Type>>.Some {value: ty} = move emptyType {
    let demanded = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let selectedIndex = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&demanded, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move selectedIndex {
      if let Option<Shared<BackendLayout>>.Some {value: layout} = move Semantic.layoutAt(&store, index) {
        emptyRecord = Shared.with<BackendLayout, bool>(&layout, fn(record: &BackendLayout) -> bool {
          return match &record.storage {
            LayoutStorage.Record {fields} => Vector.length<LayoutField>(&fields) == usize.ZERO
              && record.size == usize.ZERO && record.alignment == usize.ONE && record.abi == LayoutAbi.Indirect
            _ => false
          }
        })
      }
    }
  }
  run Testing.expect(paddedRecord && emptyRecord, "exact environments are capture-ordered records, including an empty record")
  return ()
}

// Layout alone cannot prove ownership: environment glue must clean an owned field exactly once
// while a retained reference field never drops its referent.
test effect fn anonymousEnvironmentGlueCleansOwnedCaptures() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousEnvironmentGlueClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousEnvironmentGlueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("environment-glue.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn owned(token: Token) -> () { let callable = fn() -> () { drop token } }
fn borrowed(token: Token) -> () { let callable = fn() -> i32 { return token.value } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"owned")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  let ownedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&owned, callableEnvironment)
  let borrowedType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&borrowed, callableEnvironment)
  let mut ownedFields = false
  if let Option<Shared<Type>>.Some {value: ty} = move ownedType {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty)
    ownedFields = glueFact(&store, &glue, usize.ZERO) == usize.ONE && glueFact(&store, &glue, 3) == usize.ZERO
      && glueFact(&store, &glue, usize.ONE) == usize.ZERO && glueFact(&store, &glue, 6) == usize.ONE
  }
  let mut borrowedFields = false
  if let Option<Shared<Type>>.Some {value: ty} = move borrowedType {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty)
    borrowedFields = succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ZERO
      && glueFact(&store, &glue, 6) == usize.ZERO
  }
  run Testing.expect(ownedFields && borrowedFields, "environment glue cleans each owned capture field and leaves borrowed referents live")
  return ()
}

fn anonymousFunctionKey(key: &InstanceKey) -> bool {
  if let InstanceKey.Function {..} = &key.* {
    let identity = InstanceKey.identity(key)
    return Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool {
      return DeclarationId.kind(value) == OwnerKind.Anonymous
    })
  }
  return false
}

fn anonymousMirApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<SpecializationApplication>> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        if anonymousFunctionKey(&references[at].key) {
          return InstanceKey.application(&references[at].key)
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}

fn anonymousReceiverType(ty: &Type, mode: CallableMode) -> bool {
  if mode == CallableMode.Once { return match &ty.* { Type.CallableValue {..} => true _ => false } }
  if let Type.Reference {access, referent, ..} = &ty.* {
    let expected = match mode { CallableMode.Mutable => Access.Mutable _ => Access.Shared }
    return access == expected && Shared.with<Type, bool>(&referent, exactCallableEnvironment)
  }
  return false
}
fn exactCallableEnvironment(ty: &Type) -> bool {
  return match &ty.* { Type.CallableValue {..} => true _ => false }
}

fn anonymousTargetParameter(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, mode: CallableMode, count: usize) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let parameters = Vector.asSlice<Shared<Type>>(&function.parameters)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      return anonymousFunctionKey(&function.key) && !function.safetyChecked && parameters.length == count
        && locals.length > count && Shared.with<Type, bool>(&parameters[0],
          fn(ty: &Type) -> bool { return anonymousReceiverType(ty, mode) })
    }
  }
  return false
}

fn anonymousMutableReceiverIsStored(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Ref {access: selected, place}, ..} = &statements[statementAt] {
            if selected == Access.Mutable && place.local == 2 && Vector.length<MirProjection>(&place.projections) == usize.ZERO { return true }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// These use production MIR demands and follow the retained ordinary Function reference. They
// distinguish each environment ABI mode without fresh native compilations or adapter fixtures.
effect fn anonymousDirectModeClaims(text: string, mode: CallableMode, count: usize) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("direct-closure.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let application = anonymousMirApplication(&store, &caller)
  run Testing.expect(succeeded(&caller), "closure construction and invocation lower to MIR")
  if mode == CallableMode.Mutable {
    run Testing.expect(anonymousMutableReceiverIsStored(&store, &caller), "mutable invocation borrows the original stored environment")
  }
  if mode == CallableMode.Once {
    run Testing.expect(glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
      "once invocation transfers the environment and returned owner without caller cleanup")
  }
  if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
    let exact = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &exact)
    run Testing.expect(anonymousTargetParameter(&store, &target, mode, count),
      "the ordinary anonymous function receives its exact environment at parameter zero")
    if mode == CallableMode.Once {
      run Testing.expect(glueFact(&store, &target, usize.ZERO) == 2
        && glueFact(&store, &target, 3) == 2 && glueFact(&store, &target, 4) == usize.ONE,
        "each returning branch drops only the other owned capture and skips its moved capture")
    }
    return ()
  }
  run Testing.expect(false, "direct invocation retains an ordinary anonymous Function instance")
}

test effect fn anonymousSharedInvocationHasEnvironmentParameter() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn main(seed: i32) -> i32 {
  let closure = fn(value: i32) -> i32 { return seed + value }
  return closure(1)
}
"""
  return run anonymousDirectModeClaims(text, CallableMode.Shared, 2) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn anonymousMutableInvocationHasEnvironmentParameter() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn main() -> i32 {
  let mut counter = 1
  let mut closure = fn(value: i32) -> i32 { counter = counter + value return counter }
  return closure(3)
}
"""
  return run anonymousDirectModeClaims(text, CallableMode.Mutable, 2) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn anonymousOnceInvocationOwnsEnvironmentParameter() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn main(takeFirst: bool, first: Token, second: Token) -> Token {
  let closure = fn() -> Token {
    if takeFirst { return move first }
    return move second
  }
  return closure()
}
"""
  return run anonymousDirectModeClaims(text, CallableMode.Once, usize.ONE) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn firstAnonymousBody(body: &TypedBody) -> Option<Shared<TypedBody>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Callable {body: child, ..}, ..} = &nodes[at].kind {
      return Option.some<Shared<TypedBody>>(Shared.clone<TypedBody>(&child))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<TypedBody>>()
}
fn checkedAnonymousBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  let checked = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    return Shared.with<TypedBody, Option<Shared<TypedBody>>>(&value, firstAnonymousBody)
  }
  return Option.none<Shared<TypedBody>>()
}
fn consumedFieldStep(step: &BodyPlaceStep, field: usize) -> bool {
  return match &step.* { BodyPlaceStep.Field {index} => index == field _ => false }
}
fn consumedEnvironmentField(consumed: &Option<BodyConsumedPlace>, field: usize) -> bool {
  if let Option<BodyConsumedPlace>.Some {value} = &consumed.* {
    if let BodyPlaceRoot.Local {local} = &value.root {
      let steps = Vector.asSlice<BodyPlaceStep>(&value.steps)
      if local.index == usize.ZERO && steps.length == usize.ONE {
        return consumedFieldStep(&steps[0], field)
      }
    }
  }
  return false
}
fn anonymousConsumedFields(body: &TypedBody) -> bool {
  if TypedBody.localSlice(body).length != usize.ONE { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut dropped = false
  let mut moved = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Drop {consumed, ..} = &nodes[at].kind { dropped = consumedEnvironmentField(&consumed, usize.ZERO) }
    if let BodyNodeKind.Expression {form: BodyExpression.Move {consumed, ..}, ..} = &nodes[at].kind { moved = consumedEnvironmentField(&consumed, usize.ONE) }
    at = at + usize.ONE
  }
  return dropped && moved && TypedBody.borrowStatus(body) == BodyBorrowStatus.NotChecked
}

test effect fn anonymousConsumedCapturesBelongToEnvironmentOwner() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run anonymousConsumedFieldClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn anonymousConsumedFieldClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("consumed-environment.silk")
  let text = """
struct Token { value: i32 }
fn proof(first: Token, second: Token) -> () {
  let closure = fn() -> Token { drop first return move second }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, b"proof")
  let anonymous = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&answer, checkedAnonymousBody)
  let mut remapped = false
  if let Option<Shared<TypedBody>>.Some {value} = move anonymous {
    remapped = Shared.with<TypedBody, bool>(&value, anonymousConsumedFields)
  }
  run Testing.expect(remapped, "both capture consumptions name environment zero and its exact fields, with no lexical ghost locals")
}

fn sectionStoredField(operand: &MirOperand, field: usize) -> bool {
  if let MirOperand.Copy {place} = &operand.* {
    return Vector.length<MirProjection>(&place.projections) == usize.ONE
      && lastProjectionCode(&place.projections) == field
  }
  return false
}
fn sectionSnapshot(statements: &[MirStatement], locals: &[MirLocal]) -> usize {
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[at] {
      if Vector.length<MirProjection>(&place.projections) == usize.ZERO
        && Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
        if Shared.with<Type, bool>(&locals[destination.local].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableValue {..} => true _ => false }
        }) { return destination.local }
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}
fn sectionFieldFrom(operand: &MirOperand, field: usize, snapshot: usize) -> bool {
  if let MirOperand.Copy {place} = &operand.* {
    return place.local == snapshot && sectionStoredField(operand, field)
  }
  return false
}
fn namedSectionArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut snapshot = usize.MAX
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared.with<DeclarationId, bool>(&identity,
            fn(declaration: &DeclarationId) -> bool { return DeclarationId.named(declaration, b"combine") })
          let written = Shared.with<DeclarationId, bool>(&identity,
            fn(declaration: &DeclarationId) -> bool { return DeclarationId.named(declaration, b"written") })
          if written { snapshot = sectionSnapshot(Vector.asSlice<MirStatement>(&blocks[at].statements), Vector.asSlice<MirLocal>(&function.locals)) }
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if named && operands.length == 3 && snapshot != usize.MAX {
            if let MirOperand.Copy {place} = &operands[usize.ZERO] {
              return Vector.length<MirProjection>(&place.projections) == usize.ZERO
                && sectionFieldFrom(&operands[usize.ONE], usize.ZERO, snapshot)
                && sectionFieldFrom(&operands[2], usize.ONE, snapshot)
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn namedSectionsAppendStoredArgumentsDirectly() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run namedSectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn namedSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("named-section.silk")
  let text = """
fn combine(first: i32, second: i32, third: i32) -> i32 { return first * 100 + second * 10 + third }
fn written() -> i32 { return 2 }
fn main() -> i32 { let section = combine(4, 3) return section(written()) }
unsafe extern "C" fn foreignProbe(left: i32, right: i32) -> i32
fn invalidForeignSection() -> () { let invalid = foreignProbe(40) }
fn select<T>(first: T, last: i32) -> T { return move first }
fn deferredSection() -> () { let unapplied = select(3) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidForeignSection")
  let deferred = run Semantic.demandBody(&mut store, &mut request, &id, b"deferredSection")
  run Testing.expect(succeeded(&answer) && namedSectionArguments(&store, &answer),
    "a section snapshots its fields before written arguments and appends them to its original direct target")
  run Testing.expect(rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass,
    text, "foreignProbe(40)", usize.ZERO), "foreign functions reject sections at construction (SEM0189)")
  run Testing.expect(succeeded(&deferred),
    "a section may retain its leading generic binder for later invocation without selecting a runtime instance")
}

fn sectionCaptureOperand(operand: &MirOperand, consumes: bool) -> bool {
  if consumes {
    if let MirOperand.Move {place} = &operand.* {
      return Vector.length<MirProjection>(&place.projections) == usize.ONE
        && lastProjectionCode(&place.projections) == usize.ZERO
    }
    return false
  }
  return sectionStoredField(operand, usize.ZERO)
}

fn sectionInvocationCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], consumes: bool) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, target) })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if named && operands.length == 2 && sectionCaptureOperand(&operands[usize.ONE], consumes) { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

test effect fn namedMutableSectionsRetainExclusiveReferents() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run mutableSectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn mutableSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("mutable-section.silk")
  let text = """
fn edit(amount: i32, counter: &mut i32) -> i32 { counter.* = counter.* + amount return counter.* }
fn main() -> i32 {
  let mut counter = 0
  let mut editStep = edit(&mut counter)
  let first = editStep(1)
  return first + editStep(2)
}
fn immutableUse() -> i32 { let mut counter = 0 let readOnlyStep = edit(&mut counter) return readOnlyStep(1) }
fn movedExclusive<'a>(value: &'a mut i32) -> i32 { let ownedStep = edit(move value) return ownedStep(1) }
fn repeatedExclusive<'a>(value: &'a mut i32) -> i32 {
  let movedStep = edit(move value)
  let first = movedStep(1)
  return first + movedStep(2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let rejected = run Semantic.demandBody(&mut store, &mut request, &id, b"immutableUse")
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"movedExclusive")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeatedExclusive")
  run Testing.expect(succeeded(&answer) && sectionInvocationCount(&store, &answer, b"edit", false) == 2,
    "mutable sections repeatedly pass their stored exclusive descriptor to the original target")
  run Testing.expect(rejectsSpan(&rejected, RejectionCode.InvalidCallableInvocationAccess,
    text, "readOnlyStep", usize.ONE), "a mutable section requires a writable callable binding (SEM0077)")
  run Testing.expect(succeeded(&owned) && sectionInvocationCount(&store, &owned, b"edit", true) == usize.ONE,
    "moving an exclusive view makes its section once and permits an immutable callable binding")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.UseAfterMove, text, "movedStep", 2),
    "a second invocation of a moved-exclusive section rejects its consumed callee (OWN0001)")
}

test effect fn namedOnceSectionsTransferAndCleanOwnedCaptures() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run onceSectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
fn sectionEnvironmentCleanupOnExit(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          if sectionExitDrops(Vector.asSlice<MirStatement>(&blocks[at].statements), Vector.asSlice<MirLocal>(&function.locals)) { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}
fn sectionExitDrops(statements: &[MirStatement], locals: &[MirLocal]) -> bool {
  let mut returnsNine = false
  let mut dropsEnvironment = false
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, ..} = &statements[at] {
      let digits = Bytes.asSlice(&decimal)
      if destination.local == usize.ZERO && Vector.length<MirProjection>(&destination.projections) == usize.ZERO
        && !negative && digits.length == usize.ONE && digits[usize.ZERO] == 57 { returnsNine = true }
    }
    if let MirStatement.Drop {destination, ..} = &statements[at] {
      if Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
        if Shared.with<Type, bool>(&locals[destination.local].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableValue {..} => true _ => false }
        }) { dropsEnvironment = true }
      }
    }
    at = at + usize.ONE
  }
  return returnsNine && dropsEnvironment
}
effect fn onceSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("once-section.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn take(amount: i32, token: Token) -> i32 { return amount + token.value }
fn main(token: Token, choice: i32) -> i32 {
  let takeStep = take(move token)
  return takeStep(match choice { 0 => { return 9 } _ => 2 })
}
fn repeated(token: Token) -> i32 {
  let singleStep = take(move token)
  let first = singleStep(1)
  return first + singleStep(2)
}
fn constructionOnly(spentToken: Token) -> () { let removed = move spentToken let invalid = take(move spentToken) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let target = run Semantic.demandMir(&mut store, &mut request, &id, b"take")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"repeated")
  let construction = run Semantic.demandBody(&mut store, &mut request, &id, b"constructionOnly")
  run Testing.expect(succeeded(&caller) && succeeded(&target)
    && sectionInvocationCount(&store, &caller, b"take", true) == usize.ONE
    && glueFact(&store, &caller, usize.ZERO) == usize.ONE && sectionEnvironmentCleanupOnExit(&store, &caller)
    && glueFact(&store, &target, usize.ZERO) == usize.ONE,
    "once sections transfer their field on the call edge and drop their pending environment only on argument exit")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.UseAfterMove, text, "singleStep", 2),
    "a second once-section call rejects its consumed callee (OWN0001)")
  run Testing.expect(rejectsSpan(&construction, RejectionCode.UseAfterMove, text, "move spentToken", usize.ONE),
    "a construction-only section rejects an already moved argument (OWN0001)")
}

fn stagedNamedArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let original = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"combine") })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if original && operands.length == 3 {
            return sectionStoredField(&operands[usize.ONE], usize.ONE)
              && sectionStoredField(&operands[2], usize.ZERO)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn stagedNamedSectionsFlattenCaptureOrder() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stagedNamedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn stagedNamedClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("staged-named-section.silk")
  let text = """
fn combine(first: i32, second: i32, third: i32) -> i32 { return first * 100 + second * 10 + third }
fn main() -> i32 { let firstStage = combine(3) let secondStage = firstStage(2) return secondStage(1) }
fn nestedApplication() -> i32 { return combine(3)(2)(1) }
fn emptyApplication() -> () { let emptyStep = combine(3) let invalid = emptyStep() }
fn excessiveApplication() -> () { let excessStep = combine(3) let invalid = excessStep(1, 2, 3) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let nested = run Semantic.demandMir(&mut store, &mut request, &id, b"nestedApplication")
  let empty = run Semantic.demandBody(&mut store, &mut request, &id, b"emptyApplication")
  let excess = run Semantic.demandBody(&mut store, &mut request, &id, b"excessiveApplication")
  run Testing.expect(succeeded(&answer) && stagedNamedArguments(&store, &answer),
    "staged fields retain capture order while the original direct call appends them in parameter order")
  run Testing.expect(succeeded(&nested) && stagedNamedArguments(&store, &nested),
    "nested callable expressions retain inner target discovery and lower the same direct original call with ordered suffix fields")
  run Testing.expect(rejectsSpan(&empty, RejectionCode.CallArity, text, "emptyStep()", usize.ZERO)
    && rejectsSpan(&excess, RejectionCode.CallArity, text, "excessStep(1, 2, 3)", usize.ZERO),
    "empty and excessive applications reject the full callable application (SEM0007)")
}

test effect fn enclosingOwnerSectionsRetainTheirClosedParameterTypes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run enclosingOwnerSectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn enclosingOwnerSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("enclosing-owner-section.silk")
  let text = """
struct Box<T> { value: T }
impl<T> Box<T> {
  fn select(self: Self, fallback: T) -> T { drop fallback return move self.value }
  fn pick<T: Copy>(self: &Self, index: usize) -> T { return self.value }
}
union Choice<T> { Present { value: T }, Absent }
impl<T> Choice<T> {
  fn present(value: T) -> Choice<T> { return Choice<T>.Present { value: move value } }
  fn absent() -> Choice<T> { return Choice<T>.Absent }
}
fn checked<R>(value: u8, present: once fn(u8) -> R, absent: once fn() -> R) -> R { drop absent return present(value) }
fn stored() -> i32 { let selected = Box.select(0) return selected(Box {value: 42}) }
fn piped() -> i32 { return Box {value: 42} |> Box.select(0) }
fn borrowed() -> i32 { let boxed = Box {value: 42} return &boxed |> Box.pick<i32>(1) }
fn carriers() -> Choice<u8> { return checked<Choice<u8>>(7, Choice.present, Choice.absent) }
fn unapplied() -> () { let bare = Choice.present }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let stored = run Semantic.demandMir(&mut store, &mut request, &id, b"stored")
  let piped = run Semantic.demandMir(&mut store, &mut request, &id, b"piped")
  run Testing.expect(succeeded(&stored) && sectionInvocationCount(&store, &stored, b"select", false) == usize.ONE,
    "a closed section substitutes enclosing impl evidence into its stored leading parameter and calls the original target")
  run Testing.expect(succeeded(&piped) && sectionInvocationCount(&store, &piped, b"select", false) == usize.ONE,
    "pipeline application uses the same closed leading parameter without retaining a raw enclosing owner binder")
  let borrowed = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowed")
  let picked = match move namedMirApplication(&store, &borrowed, b"pick") {
    Option<Shared<SpecializationApplication>>.Some {value} => Shared.with<SpecializationApplication, bool>(&value,
      fn(application: &SpecializationApplication) -> bool { return implScopeApplication(application, b"i32") })
    Option<Shared<SpecializationApplication>>.None => false
  }
  run Testing.expect(succeeded(&borrowed) && sectionInvocationCount(&store, &borrowed, b"pick", false) == usize.ONE && picked,
    "a deferred section over an impl member keeps the written impl argument as selected evidence and lets the piped borrow supply its own lifetime")
  let carriers = run Semantic.demandBody(&mut store, &mut request, &id, b"carriers")
  run Testing.expect(succeeded(&carriers) && implScopedValues(&carriers, b"u8") == 3,
    "generic impl members used as values take their impl binder from the promised parameter and result of the callable contract")
  let unapplied = run Semantic.demandBody(&mut store, &mut request, &id, b"unapplied")
  run Testing.expect(rejectsSpan(&unapplied, RejectionCode.Unsupported, text, "Choice.present", usize.ONE),
    "without a contract an impl member value would defer its impl binder, which a section schema does not represent")
}

// Whether an application binds exactly one enclosing impl slot, to the named primitive.
fn implScopeApplication(value: &SpecializationApplication, primitive: &[u8]) -> bool {
  let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
  if scopes.length != usize.ONE { return false }
  let arguments = Vector.asSlice<Argument>(&scopes[usize.ZERO].arguments)
  return arguments.length == usize.ONE && applicationArgumentIs(&arguments[usize.ZERO], primitive)
}

// The closed `present` (1) and `absent` (2) callable values whose own application is empty and
// whose one impl slot is the primitive, as a set of flags.
fn implScopedValues(answer: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> usize {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, usize>(&value, fn(checked: &TypedBody) -> usize {
      return implScopedFlags(TypedBody.nodeSlice(checked), primitive)
    })
  }
  return usize.ZERO
}

fn implScopedFlags(nodes: &[BodyNode], primitive: &[u8]) -> usize {
  let mut present = false
  let mut absent = false
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      if Shared.with<Type, bool>(&ty, fn(found: &Type) -> bool { return implScopedValue(found, b"present", primitive) }) {
        present = true
      }
      if Shared.with<Type, bool>(&ty, fn(found: &Type) -> bool { return implScopedValue(found, b"absent", primitive) }) {
        absent = true
      }
    }
    at = at + usize.ONE
  }
  let mut flags = usize.ZERO
  if present { flags = flags + usize.ONE }
  if absent { flags = flags + 2 }
  return flags
}

fn implScopedValue(value: &Type, target: &[u8], primitive: &[u8]) -> bool {
  if let Type.CallableValue {application, ..} = &value.* {
    return Shared.with<SpecializationApplication, bool>(&application, fn(selected: &SpecializationApplication) -> bool {
      return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), target)
        && Vector.length<Argument>(&selected.arguments) == usize.ZERO && implScopeApplication(selected, primitive)
    })
  }
  return false
}

fn movedEnvironmentField(operand: &MirOperand, field: usize) -> bool {
  if let MirOperand.Move {place} = &operand.* {
    let path = Vector.asSlice<MirProjection>(&place.projections)
    if path.length != usize.ONE { return false }
    if let MirProjection.Field {index} = &path[usize.ZERO] { return index == field }
  }
  return false
}

fn stagedReceiver(operand: &MirOperand, locals: &[MirLocal], mode: CallableMode) -> bool {
  if mode == CallableMode.Once { return movedEnvironmentField(operand, usize.ZERO) }
  if let MirOperand.Copy {place} = &operand.* {
    return Vector.length<MirProjection>(&place.projections) == usize.ZERO
      && Shared.with<Type, bool>(&locals[place.local].ty,
        fn(value: &Type) -> bool { return anonymousReceiverType(value, mode) })
  }
  return false
}

fn stagedMutableStorage(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if stagedMutableRef(Vector.asSlice<MirStatement>(&blocks[at].statements), locals) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}
fn stagedMutableRef(statements: &[MirStatement], locals: &[MirLocal]) -> bool {
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {value: MirRvalue.Ref {access, place}, ..} = &statements[at] {
      if access == Access.Mutable && Vector.length<MirProjection>(&place.projections) == usize.ONE {
        if let MirProjection.Field {index} = &Vector.asSlice<MirProjection>(&place.projections)[usize.ZERO] {
          if let MirLocalKind.User {index: original} = &locals[place.local].kind {
            if index == usize.ZERO && original == 2 { return true }
          }
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn stagedAnonymousArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, mode: CallableMode) -> bool {
  return stagedAnonymousFields(store, answer, mode, mode == CallableMode.Once)
}

fn stagedAnonymousFields(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, environmentMode: CallableMode, movesSuffix: bool) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if anonymousFunctionKey(&key) && operands.length == 3 {
            let receiver = stagedReceiver(&operands[usize.ZERO], locals, environmentMode)
            let mut suffix = sectionStoredField(&operands[2], usize.ONE)
            if movesSuffix { suffix = movedEnvironmentField(&operands[2], usize.ONE) }
            return receiver && suffix
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn stagedSharedSectionsLendOriginalEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn main() -> i32 {
  let base = 10
  let original = fn(first: i32, last: i32) -> i32 { return base + first + last }
  let next = original(2)
  return next(1)
}
"""
  return run stagedAnonymousClaims(text, CallableMode.Shared) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn stagedMutableSectionsTransferAndBorrowOriginalStorage() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
fn main() -> i32 {
  let mut counter = 0
  let mut original = fn(first: i32, last: i32) -> i32 { counter = counter + first + last return counter }
  let mut next = original(2)
  let first = next(1)
  return first + next(3)
}
fn reusedMutable() -> i32 {
  let mut counter = 0
  let mut transferred = fn(first: i32, last: i32) -> i32 { counter = counter + first + last return counter }
  let mut next = transferred(2)
  return transferred(1, 3)
}
"""
  return run stagedAnonymousClaims(text, CallableMode.Mutable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn stagedOnceSectionsMoveNestedEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn main(token: Token) -> i32 {
  let original = fn(first: i32, last: i32) -> i32 { let owned = move token return owned.value + first + last }
  let next = original(2)
  return next(1)
}
"""
  return run stagedAnonymousClaims(text, CallableMode.Once) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stagedAnonymousClaims(text: string, mode: CallableMode) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("staged-anonymous.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && stagedAnonymousArguments(&store, &caller, mode),
    "the staged direct literal call keeps its original environment mode and appends its suffix field")
  if mode == CallableMode.Mutable {
    let reused = run Semantic.demandBody(&mut store, &mut request, &id, b"reusedMutable")
    run Testing.expect(stagedMutableStorage(&store, &caller), "mutable staging borrows the stored nested environment rather than a copied snapshot")
    run Testing.expect(rejectsSpan(&reused, RejectionCode.UseAfterMove, text, "transferred", 2),
      "staging transfers an exclusive old callable even when the new callable remains exclusive (OWN0001)")
  }
  if mode == CallableMode.Once {
    run Testing.expect(glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
      "once staging transfers its nested environment without retaining caller cleanup")
  }
}

fn stagedExitOwners(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
          if sectionExitDrops(statements, locals) && stagedExitDropCount(statements) == 2 { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}
fn stagedExitDropCount(statements: &[MirStatement]) -> usize {
  let mut count = usize.ZERO
  let mut first = usize.MAX
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Drop {destination, ..} = &statements[at] {
      if Vector.length<MirProjection>(&destination.projections) == usize.ZERO && destination.local != first {
        if first == usize.MAX { first = destination.local }
        count = count + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return count
}

test effect fn stagedConstructionCleansPendingOwnersOnExit() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run stagedExitClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn stagedExitClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("staged-exit.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn main(base: Token, suffix: Token, choice: i32) -> i32 {
  let original = fn(first: i32, middle: Token, last: i32) -> i32 {
    let captured = move base
    return captured.value + middle.value + first + last
  }
  let next = original(move suffix, match choice { 0 => { return 9 } _ => 2 })
  return next(1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && stagedExitOwners(&store, &caller)
    && glueFact(&store, &caller, usize.ZERO) == 2,
    "an exiting later suffix drops the transferred base and earlier owned suffix exactly on the exit edge")
  let selected = anonymousMirApplication(&store, &caller)
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target) && glueFact(&store, &target, usize.ZERO) == 2,
      "on the ordinary call edge the target owns both captures and the caller retains neither cleanup owner")
    return ()
  }
  run Testing.expect(false, "staged invocation keeps its original anonymous target")
}

fn namedMirApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> Option<Shared<SpecializationApplication>> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: selected} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, selected) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        let identity = InstanceKey.identity(&references[at].key)
        let matches = Shared.with<DeclarationId, bool>(&identity,
          fn(value: &DeclarationId) -> bool { return sameBytes(DeclarationId.spelling(value), name) })
        if matches {
          // Capture glue can share the target's owner identity without being a function application.
          let application = InstanceKey.application(&references[at].key)
          if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
            return Option.some<Shared<SpecializationApplication>>(move value)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}

test effect fn callableParameterInfersExactRepresentationAndSignature() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run callableParameterInferenceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn callableParameterInferenceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("callable-parameter.silk")
  let text = """
fn apply<T, F: fn<'static>(T) -> T>(callback: F, value: T) -> T { return callback(move value) }
fn main() -> i32 {
  let base = 40
  let add = fn(value: i32) -> i32 { return base + value }
  return apply(add, 2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "a callable argument infers its exact representation and signature type parameter")
  let selected = namedMirApplication(&store, &caller, b"apply")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target),
      "the monomorphized callable-valued parameter calls the original anonymous body directly")
    let nested = anonymousMirApplication(&store, &target)
    if let Option<Shared<SpecializationApplication>>.Some {value: original} = move nested {
      let literal = run SpecializationApplication.copyShared(&original)
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &literal)
      run Testing.expect(anonymousTargetParameter(&store, &implementation, CallableMode.Shared, 2),
        "the selected anonymous body keeps its exact environment and shared hidden parameter")
    } else { run Testing.expect(false, "the callable parameter retains a direct anonymous Function instance") }
    return ()
  }
  run Testing.expect(false, "the named caller retains the exact generic application")
}

test effect fn callableParameterRejectsUninferredContractsAtCall() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run callableParameterRejectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn callableParameterRejectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("callable-parameter-rejection.silk")
  let text = """
fn accepts<F: fn<'static>(i32) -> i32>(callback: F) -> () { return () }
fn wrongResult() -> () {
  let booleanResult = fn(value: i32) -> bool { return true }
  accepts(booleanResult)
}
fn wrongMode(token: i32) -> () {
  let mut counter = token
  let mutableArgument = fn(value: i32) -> i32 { counter = value return counter }
  accepts(mutableArgument)
}
fn wrongArity() -> () {
  let twoInputs = fn(first: i32, last: i32) -> i32 { return first + last }
  accepts(twoInputs)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let result = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongResult")
  let mode = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongMode")
  let arity = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongArity")
  run Testing.expect(rejectsSpan(&result, RejectionCode.TypeArgumentInference, text, "accepts(booleanResult)", usize.ZERO),
    "an incompatible callable result prevents specialization (SEM0052 on the whole call)")
  run Testing.expect(rejectsSpan(&mode, RejectionCode.TypeArgumentInference, text, "accepts(mutableArgument)", usize.ZERO),
    "an incompatible invocation mode prevents specialization at the call span")
  run Testing.expect(rejectsSpan(&arity, RejectionCode.TypeArgumentInference, text, "accepts(twoInputs)", usize.ZERO),
    "an incompatible callable arity prevents specialization at the call span")
}

test effect fn callableParameterKeepsInvocationRigidsAndBorrowedOwnersOutOfInference() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run callableParameterBoundaryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn callableParameterBoundaryClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("callable-parameter-boundaries.silk")
  let text = """
fn acceptAny<T, F: for<'a> fn<'static>(&'a i32) -> T>(callback: F) -> () { return () }
fn escapingResult() -> () {
  let quantifiedIdentity = fn(value: &i32) -> &i32 { return value }
  acceptAny(quantifiedIdentity)
}
fn namedIdentity<'a>(value: &'a i32) -> &'a i32 { return value }
fn namedEscaping() -> () { acceptAny(namedIdentity) }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn acceptOwned<G: once fn<'static>() -> i32>(callback: G) -> () { return () }
fn borrowedOwner(token: Token) -> () {
  let ownedCallback = fn() -> i32 { let selected = move token return selected.value }
  acceptOwned(&ownedCallback)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let escaping = run Semantic.demandBody(&mut store, &mut request, &id, b"escapingResult")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedOwner")
  let named = run Semantic.demandBody(&mut store, &mut request, &id, b"namedEscaping")
  run Testing.expect(rejectsSpan(&named, RejectionCode.TypeArgumentInference, text, "acceptAny(namedIdentity)", usize.ZERO),
    "a named schema's comparison-local invocation result never becomes an outer selected type argument")
  run Testing.expect(rejectsSpan(&escaping, RejectionCode.TypeArgumentInference, text, "acceptAny(quantifiedIdentity)", usize.ZERO),
    "comparison-local invocation binders never escape into an outer generic argument")
  run Testing.expect(rejectsSpan(&borrowed, RejectionCode.TypeArgumentInference, text, "acceptOwned(&ownedCallback)", usize.ZERO),
    "a shared reference cannot become an owned once-callable representation")
  let protectedUnused = run quantifiedUnusedNestedMetadata()
  run Testing.expect(protectedUnused,
    "an independently bound nested metadata contract remains a quantifier barrier even when its binder has no occurrences")
}


effect fn quantifiedUnusedNestedMetadata() -> bool ! OutOfMemoryError ? &mut Allocator {
  // Source normalization erases unused authored binders. Proof metadata still permits an
  // independently bound contract whose count is nonzero and has no lifetime occurrences.
  let scalar = run specializationPrimitive(b"i32")
  let empty = run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()})
  let inner = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: Shared.clone<Intersection>(&empty), invocationBinders: usize.ONE,
    invocationBounds: Vector.make<Outlives>(), parameters: Vector.make<Shared<Type>>(), result: Shared.clone<Type>(&scalar)})
  let mut parameters = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut parameters, move inner)
  let outer = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: move empty, invocationBinders: usize.ZERO, invocationBounds: Vector.make<Outlives>(),
    parameters: move parameters, result: move scalar})
  return Type.containsInvocationQuantifier(&outer)
}

