// The schema is shared by the consumer instances. Inspect their retained MIR rather than
// choosing an executable target from the comparison contract used during admission.
effect fn contextualGenericSectionClaims(text: string<'static>, selected: usize, deferred: usize) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("contextual-generic-section.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "closed consumers admit the exact reusable section environment")
  let environment = genericSectionEnvironment(&store, &caller)
  if let Option<Shared<Type>>.Some {value: ty} = move environment {
    run Testing.expect(!Type.hasOpenRuntimeParameters(&ty)
      && Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        return genericSectionBlueprint(value, selected, deferred, b"bool")
      }), "consumer inference leaves the original target binder deferred and the physical capture unchanged")
  } else { run Testing.expect(false, "contextual admission retains the original schema value") }
  let mut integer = false
  let mut boolean = false
  let selectedMir = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&caller, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selectedMir {
    let mut applications = Vector.make<Shared<SpecializationApplication>>()
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, ..} = &blocks[at].terminator {
          if let MirCallee.Instance {key} = &callee {
            if let Option<Shared<SpecializationApplication>>.Some {value} = move InstanceKey.application(&key) {
              run Vector.append<Shared<SpecializationApplication>>(&mut applications, move value)
            } else { run Testing.expect(false, "consumer calls retain ordinary complete function applications") }
          } else { run Testing.expect(false, "consumer calls are direct") }
        }
        at = at + usize.ONE
      }
    }
    let consumers = Vector.asSlice<Shared<SpecializationApplication>>(&applications)
    let mut at = usize.ZERO
    while at < consumers.length {
      let application = run SpecializationApplication.copyShared(&consumers[at])
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
      run Testing.expect(succeeded(&implementation), "each exact consumer lowers its section from closed invocation operands")
      let kind = contextualGenericSectionTarget(&store, &implementation, selected, deferred, false)
      run Testing.expect(kind != usize.ZERO, "each consumer calls select directly with the stored suffix appended")
      if kind == usize.ONE { integer = true }
      if kind == 2 { boolean = true }
      at = at + usize.ONE
    }
  }
  run Testing.expect(integer && boolean, "one schema selects independent i32 and bool original-target instances across consumers")
}

fn contextualGenericSectionTarget(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  selected: usize, deferred: usize, moved: bool) -> usize {
  let selectedMir = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selectedMir {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return usize.ZERO } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value _ => { return usize.ZERO }
          }
          let kind = Shared.with<SpecializationApplication, usize>(&application,
            fn(value: &SpecializationApplication) -> usize { return genericSectionApplication(value, b"select", selected, deferred) })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if kind == usize.ZERO || operands.length != 2 || !sectionCaptureOperand(&operands[usize.ONE], moved) {
            return usize.ZERO
          }
          return kind
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.ZERO
}

test effect fn contextualGenericSectionsRejectUnsatisfiedTargetContracts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run contextualGenericSectionDiagnosticClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn contextualGenericSectionDiagnosticClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("contextual-generic-section-diagnostics.silk")
  let text = """
interface Permit {}
impl Permit for i32 {}
fn select<T>(value: T, enabled: bool) -> T { return move value }
fn permitted<T: Permit>(value: T, enabled: bool) -> T { return move value }
fn exclusive<T>(value: &'static mut T, enabled: bool) -> () { return () }
fn boolean(callback: fn<'static>(bool) -> bool) -> bool { return callback(true) }
fn mismatch(callback: fn<'static>(i32) -> bool) -> bool { return callback(1) }
fn shared(callback: fn<'static>(&'static i32) -> ()) -> () { return () }
fn badBound() -> bool { let boundSection = permitted(true) return boolean(boundSection) }
fn badSignature() -> bool { let signatureSection = select(true) return mismatch(signatureSection) }
fn badAccess() -> () { let accessSection = exclusive(true) shared(accessSection) }
fn good() -> bool { let validSection = select(true) return boolean(validSection) }
fn repeated<A, B>(value: A, left: B, right: B, last: i32) -> A { drop left drop right return move value }
fn stageRepeated<F: fn<'static>(i32, i32, bool) -> i32>(callback: F) -> i32 {
  let next = callback(1, true)
  return next(42)
}
fn badRepeated() -> i32 { let repeatedSection = repeated(0) return stageRepeated(repeatedSection) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"badBound")
  let signature = run Semantic.demandBody(&mut store, &mut request, &id, b"badSignature")
  let access = run Semantic.demandBody(&mut store, &mut request, &id, b"badAccess")
  let good = run Semantic.demandBody(&mut store, &mut request, &id, b"good")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"badRepeated")
  run Testing.expect(rejectsSpan(&bound, RejectionCode.IncompatibleCallableSignature, text, "boundSection", usize.ONE),
    "a target with an unsatisfied deferred bound cannot satisfy the inferred callable promise at the argument span")
  run Testing.expect(rejectsSpan(&signature, RejectionCode.IncompatibleCallableSignature, text, "signatureSection", usize.ONE),
    "a schema cannot independently choose inconsistent parameter and result types")
  run Testing.expect(rejectsSpan(&access, RejectionCode.IncompatibleCallableSignature, text, "accessSection", usize.ONE),
    "referent inference cannot make an exclusive-reference target accept a shared-reference promise")
  run Testing.expect(succeeded(&good), "failed contextual admission does not specialize or poison another schema")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.TypeArgumentInference, text, "stageRepeated(repeatedSection)", usize.ZERO),
    "a repeated target binder cannot admit inconsistent stored suffix types through a contextual promise")
}

