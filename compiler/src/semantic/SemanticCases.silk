test effect fn boundedCallsRejectMissingAndConflictingEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("bounded-rejected.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
interface Label<A> {}
interface First<A> {}
interface Second<B> {}
struct Input {}
struct Other {}
struct Many {}
impl Label<i32> for Input {}
impl First<i32> for Input {}
impl Second<bool> for Input {}
impl Label<i32> for Many {}
impl Label<bool> for Many {}
fn select<C: Label<A>, A>(value: C) -> i32 { return 0 }
fn selectWith<C: Label<A>, A>(value: C, hint: A) -> i32 { return 0 }
fn selectSame<C: First<A> + Second<A>, A>(value: C) -> i32 { return 0 }
fn missing(value: Other) -> i32 { return select<Other, i32>(value) }
fn conflicting(value: Input) -> i32 { return select<Input, bool>(value) }
fn conflictingBounds(value: Input) -> i32 { return selectSame(value) }
fn operandConflict(value: Input) -> i32 { return selectWith(value, true) }
fn ambiguous(value: Many) -> i32 { return select(value) }
fn unknown<C>(value: C) -> i32 { return select(value) }
"""
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let conflicting = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflicting")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let conflictingBounds = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictingBounds")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let operandConflict = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"operandConflict")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ambiguous = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"ambiguous")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknown = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&missing, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"select<Other, i32>(value)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&conflicting, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"select<Input, bool>(value)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&operandConflict, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"selectWith(value, true)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&ambiguous, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UninferredParameter, String.utf8Bytes(text), b"select(value)")
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&unknown, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UninferredParameter, String.utf8Bytes(text), b"select(value)")
    }),
    "bounded calls reject absent and conflicting conformances; an unknown provider cannot invent evidence",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&conflictingBounds, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.MissingConformance, String.utf8Bytes(text), b"selectSame(value)")
    }),
    "two bounds cannot replace a binder fixed by the first bound's unique evidence",
  )
  return ()
}

effect fn operandEvidenceClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let entry = run module("operand-evidence.silk")
  let text = "service Clock {}\nservice Logger {}\nservice Channel<T> {}\nstruct Box<T> {}\nstruct Left<?R> {}\nstruct Right<?S> {}\nfn takeNested<T>(value: Box<T>) -> i32 { return 0 }\nfn useNested(value: Box<i32>) -> i32 { return takeNested(value) }\nfn takeSet<T>(value: Box<Box<T> | i32>) -> i32 { return 0 }\nfn useSet(value: Box<Box<u8> | i32>) -> i32 { return takeSet(value) }\nfn takeExact(value: Box<i32>) -> i32 { return 0 }\nfn wrongNested(value: Box<bool>) -> i32 { return takeExact(value) }\nfn wrongScalar(value: Box<i32>) -> i32 { return value }\nfn takeRegion<'a>(value: &'a i32) -> i32 { return 0 }\nfn useRegion(value: &'static i32) -> i32 { return takeRegion(value) }\nfn takeRows<?R, ?S>(first: Left<? R>, second: Right<? S>) -> i32 { return 0 }\nfn useRows(first: Left<&Clock>, second: Right<&Logger>) -> i32 { return takeRows(first, second) }\nfn takeRowKey<T>(value: Left<&Channel<T>>) -> i32 { return 0 }\nfn useRowKey(value: Left<&Channel<i32>>) -> i32 { return takeRowKey(value) }\nfn takeRepeated<?R>(first: Left<? R>, second: Left<? R>) -> i32 { return 0 }\nfn conflictingRows(first: Left<&Clock>, second: Left<&Logger>) -> i32 { return takeRepeated(first, second) }\n"
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let nested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useNested")
  let set = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useSet")
  let region = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRegion")
  let rows = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRows")
  let rowKey = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"useRowKey")
  let conflict = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictingRows")
  let wrongNested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongNested")
  let wrongScalar = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongScalar")
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &nested,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1) && checkedNominalOperand(answer)
      },
    ),
    "a nested nominal operand fixes its type binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &region,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "a borrowed operand fixes its lifetime binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &set,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "one nested union member fixes its type binder without set subtraction",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &rows,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 2)
      },
    ),
    "independent operands fix two requirement rows",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &rowKey,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return checkedCallGenericCount(answer, 1)
      },
    ),
    "one parameterized row key fixes its ordinary type binder",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &conflict,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongNested,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongScalar,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ),
    "conflicting row and nominal operands reject, and a nominal local cannot satisfy a scalar return",
  )
  return ()
}

test effect fn witnessRowResidualUsesFixedCoverage() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("witness-row-residual.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "service Clock {}\nservice Logger {}\nfn promised<?R>(value: Effect<'static; i32 ? &mut Clock | R>) -> i32 { return 0 }\nfn witness<?W>(value: Effect<'static; i32 ? &Clock | W>) -> i32 { return 0 }\nfn extra<?W>(value: Effect<'static; i32 ? &Logger | W>) -> i32 { return 0 }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let witnessOwner = run requireIdentity(&revision, &entry, OwnerKind.Function, b"witness", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extraOwner = run requireIdentity(&revision, &entry, OwnerKind.Function, b"extra", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let promised = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"promised")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let witness = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"witness")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let extra = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"extra")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let promisedValue = slotOf(&promised, usize.ZERO)
  let witnessValue = slotOf(&witness, usize.ZERO)
  let extraValue = slotOf(&extra, usize.ZERO)
  if let Option<Shared<Type>>.Some {value: allowed} = move promisedValue {
    if let Option<Shared<Type>>.Some {value: required} = move witnessValue {
      let witnessDeclaration = run Shared.make<DeclarationId>(move witnessOwner)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut bindable = Vector.make<Shared<DeclarationId>>()
      run Vector.append<Shared<DeclarationId>>(&mut bindable, move witnessDeclaration)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut ordinary = Vector.make<Binding>()
      let exact = run Type.unify(
        &allowed,
        &required,
        Vector.asSlice<Shared<DeclarationId>>(&bindable),
        Comparison.Exact,
        &mut ordinary,
      ) |> Effect.provideMut<Allocator>(&mut allocator)
      let mut bindings = Vector.make<Binding>()
      let residual = run Type.bindWitnessResidual(
        &allowed,
        &required,
        Vector.asSlice<Shared<DeclarationId>>(&bindable),
        &mut bindings,
      ) |> Effect.provideMut<Allocator>(&mut allocator)
      let ordinaryUnknown = match & exact {
        Unification.Undetermined {..} => Vector.length<Binding>(&ordinary) == usize.ZERO
        _ => false
      }
      let mut boundToPromisedRow = false
      let matched = match & residual {
        Unification.Unified => true
        _ => false
      }
      if matched {
        let values = Vector.asSlice<Binding>(&bindings)
        if values.length == usize.ONE {
          if let Argument.Row {value} = &values[usize.ZERO].value {
            boundToPromisedRow = Shared.with<Row, bool>(
              &value,
              fn(row: &Row) -> bool {
                return Vector.length(&row.parameters) == usize.ONE && Vector.length<Requirement>(
                  &row.entries,
                ) == usize.ZERO
              },
            )
          }
        }
      }
      run Testing.expect(
        ordinaryUnknown && boundToPromisedRow,
        "a covered fixed witness key leaves its open row bound to the promised row parameter without changing Exact equality",
      )
      if let Option<Shared<Type>>.Some {value: uncovered} = move extraValue {
        let extraDeclaration = run Shared.make<DeclarationId>(move extraOwner)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut extraBindable = Vector.make<Shared<DeclarationId>>()
        run Vector.append<Shared<DeclarationId>>(&mut extraBindable, move extraDeclaration)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut extraBindings = Vector.make<Binding>()
        let failed = run Type.bindWitnessResidual(
          &allowed,
          &uncovered,
          Vector.asSlice<Shared<DeclarationId>>(&extraBindable),
          &mut extraBindings,
        ) |> Effect.provideMut<Allocator>(&mut allocator)
        let uncoveredRejected = match & failed {
          Unification.Distinct => Vector.length<Binding>(&extraBindings) == usize.ZERO
          _ => false
        }
        run Testing.expect(uncoveredRejected, "an open witness row cannot conceal an uncovered fixed requirement")
      } else {
        run Testing.expect(false, "the uncovered witness has a source-resolved row")
      }
    } else {
      run Testing.expect(false, "the witness has a source-resolved row")
    }
  } else {
    run Testing.expect(false, "the promise has a source-resolved row")
  }
  return ()
}

fn checkedCallGenericCount(answer: &Result<Answer, NoRejection>, count: usize) -> bool {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(
      &value,
      fn(checked: &TypedBody) -> bool {
        return bodyCallGenericCount(checked, count)
      },
    )
  }
  return false
}

fn nominalType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {..} => true
    _ => false
  }
}

fn checkedNominalOperand(answer: &Result<Answer, NoRejection>) -> bool {
  let body = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, bool>(
      &value,
      fn(checked: &TypedBody) -> bool {
        let locals = TypedBody.localSlice(checked)
        if locals.length != 1 || !Shared.with<Type, bool>(&locals[0].ty, nominalType) {
          return false
        }
        let nodes = TypedBody.nodeSlice(checked)
        let mut at = usize.ZERO
        while at < nodes.length {
          if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {arguments, ..}, ..} = &nodes[at].kind {
            let supplied = Vector.asSlice<BodyNodeId>(&arguments)
            if supplied.length == 1 {
              if let BodyNodeKind.Expression {ty, form: BodyExpression.Local {local}} = &nodes[supplied[usize.ZERO].index].kind {
                return local.index == usize.ZERO && Shared.with<Type, bool>(&ty, nominalType)
              }
            }
          }
          at = at + usize.ONE
        }
        return false
      },
    )
  }
  return false
}

test effect fn bodyChecksDirectCallsWithoutDemandingCalleeBodies() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missing = run module("missing.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "import library as Library { leaf as selected }\nimport missing as Missing\nservice Clock {}\nfn leaf() -> i32 { return missing }\nfn caller() -> i32 { let value = leaf() return value }\nfn pair(first: u8, second: i32) -> i32 { return second }\nfn contextual() -> i32 { return pair(255, 1) }\nfn nested() -> i32 { return pair(255, leaf()) }\nfn incompatible() -> i32 { return pair(true, 1) }\nfn fixedLocal() -> i32 { let value = 255 return pair(value, 1) }\nfn tooMany() -> i32 { return pair(1, 2, 3) }\nfn section() -> i32 { return pair(1) }\nfn invalidSection() -> i32 { return pair(true) }\nfn emptyCall() -> i32 { return pair() }\nfn nonCallable() -> i32 { let value = 1 return value() }\nfn generic<A, B>(first: A, second: B) -> i32 { return 0 }\nfn excessPrefix() -> i32 { return generic<i32, bool, u8>(1, true) }\nfn wrongPrefixKind() -> i32 { return generic<'static>(1, true) }\nfn unknownPrefixType() -> i32 { return generic<MissingType>(1, true) }\nfn nongenericPrefix() -> i32 { return leaf<i32>() }\nfn choose<A, B>(first: A, second: B) -> A { return move first }\nfn inferUse() -> i32 { return choose(42, true) }\nfn explicitUse() -> i32 { return choose<i32>(42, true) }\nfn conflictUse() -> i32 { return choose<bool>(42, true) }\nfn repeated<T>(first: T, second: T) -> T { return move first }\nfn repeatedConflict() -> i32 { return repeated(42, true) }\nfn resultOnly<T>() -> T { return 0 }\nfn unknownResult() -> i32 { return resultOnly() }\nfn lifetimeFirst<'a, T>(value: T) -> T { return move value }\nfn lifetimePrefix() -> i32 { return lifetimeFirst<'static>(42) }\nfn missingLifetime() -> i32 { return lifetimeFirst(42) }\nfn twoRows<?R, ?S>(value: i32) -> i32 { return value }\nfn positionalRows() -> i32 { return twoRows<&Clock, never>(1) }\nfn missingSecondRow() -> i32 { return twoRows<&Clock>(1) }\nfn left() -> i32 { return right() }\nfn right() -> i32 { return left() }\nfn imported() -> i32 { return selected() }\nfn qualified() -> i32 { return Library.leaf() }\nfn absent() -> i32 { return Library.absent() }\nfn missingCall() -> i32 { return Missing.leaf() }\n"
  let entrySource = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let librarySource = run present("pub fn leaf() -> i32 { return missing }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &library, &librarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let caller = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let callerBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &caller,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move callerBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, usize.ZERO)
        },
      ) && starts(Semantic.eventLog(&semantic), Family.Body) == 1,
      "a caller keeps its callee signature and runtime obligation without checking the broken leaf",
    )
  } else {
    run Testing.expect(false, "the direct caller has a checked body")
  }
  let contextual = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"contextual")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let contextualBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &contextual,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move contextualBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &entry, 2) && bodyFirstIntegerType(body, b"u8")
        },
      ),
      "source-ordered arguments receive their own immediate parameter contexts",
    )
  } else {
    run Testing.expect(false, "the contextual call has a checked body")
  }
  let nested = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nestedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &nested,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move nestedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, bodyNestedCalls),
      "nested calls retain each runtime body in argument evaluation order",
    )
  } else {
    run Testing.expect(false, "the nested call has a checked body")
  }
  let incompatible = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"incompatible")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fixedLocal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"fixedLocal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tooMany = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"tooMany")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let section = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"section")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidSection = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"invalidSection",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"emptyCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nonCallable = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"nonCallable")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &incompatible,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &fixedLocal,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"value")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &tooMany,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.CallArity)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &section,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.Unsupported)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &invalidSection,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeMismatch, String.utf8Bytes(text), b"true")
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &emptyCall,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.RedundantCall)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &nonCallable,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.NotCallable)
      },
    ),
    "direct calls distinguish argument types, invalid arity, deferred sections, and non-callables",
  )
  let excessPrefix = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"excessPrefix",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongPrefixKind = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"wrongPrefixKind",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nongenericPrefix = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"nongenericPrefix",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownPrefixType = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"unknownPrefixType",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &excessPrefix,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeArity, String.utf8Bytes(text), b"u8")
      },
    ),
    "an excess call prefix rejects at its first extra argument",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &wrongPrefixKind,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.TypeArgumentKind,
          String.utf8Bytes(text),
          b"'static",
        )
      },
    ),
    "a written call prefix checks its binder kind",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &unknownPrefixType,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownName,
          String.utf8Bytes(text),
          b"MissingType",
        )
      },
    ),
    "a written call prefix resolves its type argument",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &nongenericPrefix,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(answer, RejectionCode.TypeArity, String.utf8Bytes(text), b"i32")
      },
    ),
    "a nongeneric function rejects a written type argument",
  )
  let inferUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"inferUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let explicitUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"explicitUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let lifetimePrefix = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"lifetimePrefix")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let positionalRows = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"positionalRows")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingLifetime = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingLifetime")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingSecondRow = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"missingSecondRow",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let conflictUse = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"conflictUse")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeatedConflict = run Semantic.demandBody(
    &mut semantic,
    &mut request,
    &entry,
    b"repeatedConflict",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownResult = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknownResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&inferUse, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&explicitUse, inspect).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &lifetimePrefix,
      inspect,
    ).success && Shared.with<Result<Answer, NoRejection>, AnswerView>(
      &positionalRows,
      inspect,
    ).success,
    "supplied operands infer after a fixed prefix, while positional lifetime and row arguments retain their kinds",
  )
  let inferredBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &inferUse,
    checkedBody,
  )
  let rowBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &positionalRows,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: inferredCall} = move inferredBody {
    if let Option<Shared<TypedBody>>.Some {value: rowCall} = move rowBody {
      run Testing.expect(
        Shared.with<TypedBody, bool>(
          &inferredCall,
          fn(body: &TypedBody) -> bool { return bodyCallGenericCount(body, 2) },
        ) && Shared.with<TypedBody, bool>(
          &rowCall,
          fn(body: &TypedBody) -> bool { return bodyCallGenericCount(body, 2) },
        ),
        "typed calls retain completed ordinary and row applications",
      )
    } else {
      run Testing.expect(false, "row call has a checked body")
    }
  } else {
    run Testing.expect(false, "inferred call has a checked body")
  }
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &missingLifetime,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "an omitted lifetime binder without operand evidence remains uninferred",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &missingSecondRow,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "an omitted second row binder without operand evidence remains uninferred",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &conflictUse,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &repeatedConflict,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.TypeMismatch)
      },
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &unknownResult,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UninferredParameter)
      },
    ),
    "conflicting operand evidence and result-only parameters reject without result inference",
  )
  let left = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"left")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let right = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"right")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&left, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      AnswerView,
    >(&right, inspect).success,
    "written signatures let mutually recursive bodies check without a body-query cycle",
  )
  let imported = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"imported")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let absent = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"absent")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let missingCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missingCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let importedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &imported,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value} = move importedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &library, usize.ZERO)
        },
      ),
      "selected imports keep the canonical imported callee",
    )
  } else {
    run Testing.expect(false, "the selected imported call has a checked body")
  }
  let qualifiedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &qualified,
    checkedBody,
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&qualified, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &absent,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.UnknownMember,
          String.utf8Bytes(text),
          b"absent",
        )
      },
    ) && Request.hasDiscovered(&request, &library) && Request.hasDemand(
      &request,
      Family.Signature,
      &library,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &missingCall,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
          answer,
          &missing,
        )
      },
    ) && starts(Semantic.eventLog(&semantic), Family.Body) == 29,
    "imported calls retain positive and negative name evidence without demanding library bodies",
  )
  if let Option<Shared<TypedBody>>.Some {value} = move qualifiedBody {
    run Testing.expect(
      Shared.with<TypedBody, bool>(
        &value,
        fn(body: &TypedBody) -> bool {
          return bodyCalls(body, &library, usize.ZERO)
        },
      ),
      "qualified imports use the same canonical callee",
    )
  }
  let mut fresh = Request.make()
  let replayed = run Semantic.demandBody(&mut semantic, &mut fresh, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut freshNegative = Request.make()
  let replayedAbsence = run Semantic.demandBody(
    &mut semantic,
    &mut freshNegative,
    &entry,
    b"absent",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let replayedMissing = run Semantic.demandBody(
    &mut semantic,
    &mut freshNegative,
    &entry,
    b"missingCall",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&replayed, inspect).success && Request.hasDiscovered(
      &fresh,
      &library,
    ) && Request.hasDemand(&fresh, Family.Signature, &library) && Request.hasDemand(
      &fresh,
      Family.Import,
      &entry,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &replayedAbsence,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.UnknownMember)
      },
    ) && Request.hasDiscovered(&freshNegative, &library) && Request.hasDemand(
      &freshNegative,
      Family.Name,
      &library,
    ) && Shared.with<Result<Answer, NoRejection>, bool>(
      &replayedMissing,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
          answer,
          &missing,
        )
      },
    ) && Request.hasDemand(&freshNegative, Family.Import, &entry) && hits(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) > 0,
    "fresh caller hits replay imported signature and source discoveries",
  )
  return ()
}

test effect fn qualifiedInherentCallUsesAppliedMemberSignature() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run qualifiedInherentCallClaims()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn inherentReceiverCallKeepsQualifiedTargetAndOwnerPrecedence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("inherent-receiver-calls.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Rescue { fn read(value: Self, item: i32) -> i32 }\nstruct Counter {}\nimpl Rescue for Counter { fn read(value: Self, item: i32) -> i32 { return item } }\nimpl Counter { fn read(self: Self) -> i32 { return 42 } fn touch(self: &mut Self) -> i32 { return 1 } }\nfn qualified(value: Counter) -> i32 { return Counter.read(move value) }\nfn receiver(value: Counter) -> i32 { return value.read() }\nfn mutReceiver(value: &mut Counter) -> i32 { return value.touch() }\nfn wrongArity(value: Counter) -> i32 { return value.read(7) }\nstruct Associated {}\nimpl Rescue for Associated { fn read(value: Self, item: i32) -> i32 { return item } }\nimpl Associated { fn read() -> i32 { return 0 } }\nfn associated(value: Associated) -> i32 { return value.read(7) }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let qualified = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"qualified")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let receiver = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"receiver")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mutReceiver = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mutReceiver")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongArity = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongArity")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let associated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"associated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let qualifiedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &qualified, checkedBody,
  )
  let receiverBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &receiver, checkedBody,
  )
  let mutableBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &mutReceiver, checkedBody,
  )
  let mut sameInherent = false
  if let Option<Shared<TypedBody>>.Some {value} = move qualifiedBody {
    sameInherent = Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyCalls(body, &entry, usize.ONE)
    })
  }
  if let Option<Shared<TypedBody>>.Some {value} = move receiverBody {
    sameInherent = sameInherent && Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyCalls(body, &entry, usize.ONE)
    })
  } else {
    sameInherent = false
  }
  let mut retainedMode = false
  if let Option<Shared<TypedBody>>.Some {value} = move mutableBody {
    retainedMode = Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyRetainsReceiverPass(body, BodyReceiverPass.Mutable)
    })
  }
  run Testing.expect(
    sameInherent && retainedMode && rejectsFrom(&wrongArity, RejectionCode.CallArity, offsetOf(text, "value.read(7)", usize.ZERO))
      && rejectsFrom(&associated, RejectionCode.AssociatedFunctionOnValue, offsetOf(text, "read(7)", usize.ONE)),
    "inherent receiver spelling keeps the qualified target and owner errors before conformance",
  )
  return ()
}

effect fn qualifiedInherentCallClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static>
? &mut Allocator {
  let sourceModule = run module("inherent-call.silk")
  let source = run present("struct Counter {}\nimpl Counter { fn answer() -> i32 { return 42 } }\nfn caller() -> i32 { return Counter.answer() }\n")
  let revision = run Revision.publish(&Revision.make(), &sourceModule, &source)
  let memberId = run requireIdentity(&revision, &sourceModule, OwnerKind.Function, b"answer", usize.ZERO)
  let mut semantic = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let owner = run Semantic.demandIdentity(&mut semantic, &mut request, &sourceModule, b"Counter")
  let member = run Semantic.demandInherentMember(
    &mut semantic, &mut request, &sourceModule, b"Counter", b"answer",
  )
  let mut sameContract = false
  let provider = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &owner,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value} = move provider {
    let applied = run Semantic.demandAppliedInherent(&mut semantic, &mut request, &value, &memberId)
    sameContract = run answersEqual(&applied, &member, usize.MAX)
  }
  let body = run Semantic.demandBody(&mut semantic, &mut request, &sourceModule, b"caller")
  let checked = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &body,
    checkedBody,
  )
  let mut selected = false
  if let Option<Shared<TypedBody>>.Some {value} = move checked {
    selected = Shared.with<TypedBody, bool>(
      &value,
      fn(typed: &TypedBody) -> bool {
        return bodyCalls(typed, &sourceModule, usize.ZERO)
      },
    )
  }
  run Testing.expect(
    sameContract && selected,
    "qualified inherent call retains the published member's applied signature and body",
  )
  return ()
}

test effect fn bodyReusesValidatedCallerAcrossControlledEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("controlled.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = run present(
    "fn leaf() -> i32 { return 1 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &initial)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut coldRequest = Request.make()
  let cold = run Semantic.demandBody(&mut semantic, &mut coldRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut warmRequest = Request.make()
  let warm = run Semantic.demandBody(&mut semantic, &mut warmRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let coldBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &cold,
    checkedBody,
  )
  let mut coldCallsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move coldBody {
    coldCallsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &entry, usize.ZERO)
      },
    )
  }
  run Testing.expect(
    coldCallsLeaf && Shared.with<Result<Answer, NoRejection>, AnswerView>(&cold, inspect).success && Shared.with<
      Result<Answer, NoRejection>,
      bool,
    >(
      &warm,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return bodyHasCurrentSource(answer, &first)
      },
    ) && Request.hasRoot(&warmRequest, Family.Body, &entry, b"caller") && Request.hasDemand(
      &warmRequest,
      Family.Signature,
      &entry,
    ) && hits(Semantic.eventLog(&semantic), Family.Body) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 1,
    "cold and warm caller demands agree while the leaf body remains undemanded",
  )
  let changedBody = run present(
    "fn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &entry, &changedBody)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut editedRequest = Request.make()
  let edited = run Semantic.demandBody(&mut semantic, &mut editedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let currentSource = Shared.with<Result<Answer, NoRejection>, bool>(
    &edited,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return bodyHasCurrentSource(answer, &second)
    },
  )
  let reuseCount = reused(Semantic.eventLog(&semantic))
  let bodyStarts = starts(Semantic.eventLog(&semantic), Family.Body)
  let bodyHits = hits(Semantic.eventLog(&semantic), Family.Body)
  let hasRoot = Request.hasRoot(&editedRequest, Family.Body, &entry, b"caller")
  let hasSignature = Request.hasDemand(&editedRequest, Family.Signature, &entry)
  let editedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &edited,
    checkedBody,
  )
  let mut editedCallsLeaf = false
  if let Option<Shared<TypedBody>>.Some {value} = move editedBody {
    editedCallsLeaf = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &entry, usize.ZERO)
      },
    )
  }
  run Testing.expect(
    currentSource && editedCallsLeaf && reuseCount == 1 && bodyStarts == 2 && bodyHits == 1 && hasRoot && hasSignature,
    "same-file leaf implementation edit validates and retains the caller payload with current evidence",
  )
  let collisionSource = run present(
    "fn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\nfn leaf() -> i32 { return 3 }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let collision = run Revision.publish(&second, &entry, &collisionSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&collision)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut ambiguousRequest = Request.make()
  let ambiguous = run Semantic.demandBody(&mut semantic, &mut ambiguousRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let collisionRejected = Shared.with<Result<Answer, NoRejection>, bool>(
    &ambiguous,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.Collision)
    },
  )
  run Testing.expect(
    collisionRejected && reused(Semantic.eventLog(&semantic)) == 1,
    "ambiguous callee declaration mapping checks the caller afresh",
  )
  let shiftedSource = run present(
    "\nfn leaf() -> i32 { return 2 }\nfn caller() -> i32 { let value = leaf() return value }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let shifted = run Revision.publish(&collision, &entry, &shiftedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&shifted)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut shiftedRequest = Request.make()
  let shiftedAnswer = run Semantic.demandBody(&mut semantic, &mut shiftedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &shiftedAnswer,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return bodyHasCurrentSource(answer, &shifted)
      },
    ) && reused(Semantic.eventLog(&semantic)) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 4,
    "a source offset change checks a fresh caller instead of keeping old syntax positions",
  )
  let changedSignatureText = "\nfn leaf() -> bool { return true }\nfn caller() -> i32 { let value = leaf() return value }\n"
  let changedSignature = run present(changedSignatureText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fourth = run Revision.publish(&shifted, &entry, &changedSignature)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move fourth)
  let mut invalidRequest = Request.make()
  let invalid = run Semantic.demandBody(&mut semantic, &mut invalidRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(
      &invalid,
      fn(answer: &Result<Answer, NoRejection>) -> bool {
        return rejectionSpells(
          answer,
          RejectionCode.TypeMismatch,
          String.utf8Bytes(changedSignatureText),
          b"value",
        )
      },
    ) && reused(Semantic.eventLog(&semantic)) == 1 && starts(
      Semantic.eventLog(&semantic),
      Family.Body,
    ) == 5,
    "a changed leaf signature invalidates the checked caller",
  )
  return ()
}

test effect fn bodyRechecksImportedPathAndDeclarationEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("importing.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let library = run module("library.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(
    "import library as Library\nfn caller() -> i32 { return Library.leaf() }\n",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(
    run Revision.copy(&first)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut missingRequest = Request.make()
  let missing = run Semantic.demandBody(&mut semantic, &mut missingRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pathMissing = Shared.with<Result<Answer, NoRejection>, bool>(
    &missing,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
        answer,
        &library,
      )
    },
  )
  run Testing.expect(pathMissing, "an absent imported path rejects its actual caller")

  let empty = run present("")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Revision.publish(&first, &library, &empty)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&second)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut absentRequest = Request.make()
  let absent = run Semantic.demandBody(&mut semantic, &mut absentRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let declarationMissing = Shared.with<Result<Answer, NoRejection>, bool>(
    &absent,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.UnknownMember)
    },
  )
  run Testing.expect(
    declarationMissing,
    "a newly present path still rejects its missing declaration",
  )

  let exported = run present("pub fn leaf() -> i32 { return 1 }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run Revision.publish(&second, &library, &exported)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&third)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut foundRequest = Request.make()
  let found = run Semantic.demandBody(&mut semantic, &mut foundRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let foundBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &found,
    checkedBody,
  )
  let mut callsLibrary = false
  if let Option<Shared<TypedBody>>.Some {value} = move foundBody {
    callsLibrary = Shared.with<TypedBody, bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return bodyCalls(body, &library, usize.ZERO)
      },
    )
  }
  let foundSignature = Request.hasDemand(&foundRequest, Family.Signature, &library)
  run Testing.expect(
    callsLibrary && foundSignature,
    "adding the imported declaration checks the caller and records its runtime obligation",
  )

  let fourth = run Revision.publish(&third, &library, &empty)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(
    &mut semantic,
    run Revision.copy(&fourth)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let mut removedRequest = Request.make()
  let removed = run Semantic.demandBody(&mut semantic, &mut removedRequest, &entry, b"caller")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let removedDeclaration = Shared.with<Result<Answer, NoRejection>, bool>(
    &removed,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.UnknownMember)
    },
  )
  run Testing.expect(
    removedDeclaration,
    "removing the imported declaration invalidates the checked caller",
  )

  let fifth = run Revision.publish(&fourth, &library, &Option.none<Bytes>())
    |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move fifth)
  let mut removedPathRequest = Request.make()
  let removedPath = run Semantic.demandBody(
    &mut semantic,
    &mut removedPathRequest,
    &entry,
    b"caller",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pathGone = Shared.with<Result<Answer, NoRejection>, bool>(
    &removedPath,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingModule) && answerHasAbsentSource(
        answer,
        &library,
      )
    },
  )
  let allRechecked = starts(Semantic.eventLog(&semantic), Family.Body) == 5 && reused(
    Semantic.eventLog(&semantic),
  ) == 0
  run Testing.expect(
    pathGone && allRechecked && Request.hasRoot(&removedPathRequest, Family.Body, &entry, b"caller"),
    "removing the imported path records current negative evidence without retaining an old body",
  )
  return ()
}

effect fn specializationOf(declaration: &DeclarationId, argument: &Shared<Type>) -> SpecializationApplication
! OutOfMemoryError ? &mut Allocator {
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: Shared.clone<Type>(argument)})
  return run specializationWithArguments(declaration, move arguments)
}

effect fn specializationWithArguments(declaration: &DeclarationId, arguments: Vector<Argument>) -> SpecializationApplication
! OutOfMemoryError ? &mut Allocator {
  return SpecializationApplication {
    target: SpecializationTarget.Named {declaration: run DeclarationId.copy(declaration)},
    arguments: move arguments,
  }
}

effect fn specializationPrimitive(name: &[u8]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)})
}

effect fn specializationNominal(declaration: &DeclarationId, arguments: Vector<Argument>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Nominal {
    declaration: run DeclarationId.copy(declaration), isPublic: false, arguments: move arguments,
  })
}

effect fn specializationRepresentation(declaration: &DeclarationId) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.NamedRepresentation {
    declaration: run DeclarationId.copy(declaration), isPublic: false, arguments: Vector.make<Argument>(),
  })
}

effect fn specializationParameter(declaration: &DeclarationId, ordinal: usize) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Parameter {declaration: run DeclarationId.copy(declaration), ordinal: ordinal})
}

effect fn specializationLifetime(declaration: &DeclarationId, ordinal: usize) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(declaration), ordinal: ordinal})
}

test effect fn closedSpecializationSharesRuntimeCodeButKeepsValidityAndEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("specialization-identity.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("struct Box<T> { value: T }\nservice Clock {}\nfn apply<'a, T>(value: T) -> T { return move value }\nfn other<'a, T>(value: T) -> T { return move value }\nfn row<?R>() -> i32 { return 0 }\nfn compare<T>(value: T) -> T { return move value }\nfn sourceA() -> i32 { return 1 }\nfn sourceB() -> i32 { return 2 }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = run identityOf(&revision, &entry, OwnerKind.Function, b"apply", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alternate = run identityOf(&revision, &entry, OwnerKind.Function, b"other", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<DeclarationId>.Some {value: apply} = move selected {
    if let Option<DeclarationId>.Some {value: other} = move alternate {
      let integer = run specializationPrimitive(b"i32")
        |> Effect.provideMut<Allocator>(&mut allocator)
      let boolean = run specializationPrimitive(b"bool")
        |> Effect.provideMut<Allocator>(&mut allocator)
      let staticRegion = run Shared.make<Lifetime>(Lifetime.Static)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let localRegion = run specializationLifetime(&apply, usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut firstArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut firstArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&staticRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut firstArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let first = run specializationWithArguments(&apply, move firstArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut secondArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut secondArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&localRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut secondArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let second = run specializationWithArguments(&apply, move secondArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut pool = SpecializationPool.make()
      let firstId = run SpecializationPool.intern(&mut pool, &first)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let repeated = run SpecializationPool.intern(&mut pool, &first)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let secondId = run SpecializationPool.intern(&mut pool, &second)
        |> Effect.provideMut<Allocator>(&mut allocator)
      if let Option<SpecializationIdentity>.Some {value: original} = move firstId {
        if let Option<SpecializationIdentity>.Some {value: again} = move repeated {
          if let Option<SpecializationIdentity>.Some {value: lifetimeOnly} = move secondId {
            run Testing.expect(
              original.semantic == again.semantic && original.runtime == again.runtime && original.semantic != lifetimeOnly.semantic && original.runtime == lifetimeOnly.runtime,
              "equal applications reuse both identities while validity lifetimes share runtime code",
            )
          } else { run Testing.expect(false, "lifetime-only application is closed") }
        } else { run Testing.expect(false, "repeated application is closed") }
      } else { run Testing.expect(false, "first application is closed") }
      let mut changedArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut changedArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&staticRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut changedArguments, Argument.Type {value: Shared.clone<Type>(&boolean)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let differentType = run specializationWithArguments(&apply, move changedArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let mut ownerArguments = Vector.make<Argument>()
      run Vector.append<Argument>(&mut ownerArguments, Argument.Lifetime {value: Shared.clone<Lifetime>(&staticRegion)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector.append<Argument>(&mut ownerArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
        |> Effect.provideMut<Allocator>(&mut allocator)
      let differentDeclaration = run specializationWithArguments(&other, move ownerArguments)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let _typeId = run SpecializationPool.intern(&mut pool, &differentType)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let _ownerId = run SpecializationPool.intern(&mut pool, &differentDeclaration)
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(
        SpecializationPool.semanticCount(&pool) == 4 && SpecializationPool.runtimeCount(&pool) == 3,
        "type and declaration evidence retain distinct specialization identities",
      )
      let rowOwner = run identityOf(&revision, &entry, OwnerKind.Function, b"row", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let clockOwner = run identityOf(&revision, &entry, OwnerKind.Service, b"Clock", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let compareOwner = run identityOf(&revision, &entry, OwnerKind.Function, b"compare", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let firstSource = run identityOf(&revision, &entry, OwnerKind.Function, b"sourceA", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      let secondSource = run identityOf(&revision, &entry, OwnerKind.Function, b"sourceB", usize.ZERO)
        |> Effect.provideMut<Allocator>(&mut allocator)
      if let Option<DeclarationId>.Some {value: rowDeclaration} = move rowOwner {
        if let Option<DeclarationId>.Some {value: clock} = move clockOwner {
          let capability = run specializationNominal(&clock, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let emptyRow = run Shared.make<Row>(Row.empty())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut required = Row.empty()
          run Row.require(&mut required, Requirement {
            capability: move capability, roleType: Option.none<Shared<Type>>(), access: Access.Shared,
          })
            |> Effect.provideMut<Allocator>(&mut allocator)
          let clockRow = run Shared.make<Row>(move required)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut emptyArguments = Vector.make<Argument>()
          run Vector.append<Argument>(&mut emptyArguments, Argument.Row {value: move emptyRow})
            |> Effect.provideMut<Allocator>(&mut allocator)
          let noService = run specializationWithArguments(&rowDeclaration, move emptyArguments)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut clockArguments = Vector.make<Argument>()
          run Vector.append<Argument>(&mut clockArguments, Argument.Row {value: move clockRow})
            |> Effect.provideMut<Allocator>(&mut allocator)
          let withService = run specializationWithArguments(&rowDeclaration, move clockArguments)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut evidence = SpecializationPool.make()
          let _empty = run SpecializationPool.intern(&mut evidence, &noService)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let _clock = run SpecializationPool.intern(&mut evidence, &withService)
            |> Effect.provideMut<Allocator>(&mut allocator)
          run Testing.expect(SpecializationPool.runtimeCount(&evidence) == 2, "closed requirement rows keep different runtime identities")
        } else { run Testing.expect(false, "Clock service has a canonical identity") }
      } else { run Testing.expect(false, "row function has a canonical identity") }
      if let Option<DeclarationId>.Some {value: compare} = move compareOwner {
        if let Option<DeclarationId>.Some {value: sourceA} = move firstSource {
          if let Option<DeclarationId>.Some {value: sourceB} = move secondSource {
            let representationA = run specializationRepresentation(&sourceA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let representationB = run specializationRepresentation(&sourceB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let applicationA = run specializationOf(&compare, &representationA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let applicationB = run specializationOf(&compare, &representationB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let mut evidence = SpecializationPool.make()
            let _first = run SpecializationPool.intern(&mut evidence, &applicationA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let _second = run SpecializationPool.intern(&mut evidence, &applicationB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            run Testing.expect(SpecializationPool.runtimeCount(&evidence) == 2, "exact named representations remain different code identities")
            let selectedA = SpecializationApplication {
              target: SpecializationTarget.Operation {
                contract: Shared.clone<Type>(&integer),
                provider: Shared.clone<Type>(&representationA),
                operation: run DeclarationId.copy(&compare)
                  |> Effect.provideMut<Allocator>(&mut allocator),
                implementation: run DeclarationId.copy(&sourceA)
                  |> Effect.provideMut<Allocator>(&mut allocator),
              },
              arguments: Vector.make<Argument>(),
            }
            let selectedB = SpecializationApplication {
              target: SpecializationTarget.Operation {
                contract: Shared.clone<Type>(&integer),
                provider: Shared.clone<Type>(&representationA),
                operation: run DeclarationId.copy(&compare)
                  |> Effect.provideMut<Allocator>(&mut allocator),
                implementation: run DeclarationId.copy(&sourceB)
                  |> Effect.provideMut<Allocator>(&mut allocator),
              },
              arguments: Vector.make<Argument>(),
            }
            let mut operations = SpecializationPool.make()
            let _selectedA = run SpecializationPool.intern(&mut operations, &selectedA)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let _selectedB = run SpecializationPool.intern(&mut operations, &selectedB)
              |> Effect.provideMut<Allocator>(&mut allocator)
            run Testing.expect(SpecializationPool.runtimeCount(&operations) == 2, "selected operation implementations remain different code identities")
            let abstractType = run specializationParameter(&compare, usize.ZERO)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let abstractApplication = run specializationOf(&compare, &abstractType)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let unclosed = run SpecializationPool.intern(&mut evidence, &abstractApplication)
              |> Effect.provideMut<Allocator>(&mut allocator)
            let mut refused = false
            if let Option<SpecializationIdentity>.None = move unclosed {
              refused = true
            }
            run Testing.expect(refused && SpecializationPool.runtimeCount(&evidence) == 2, "abstract source parameters never become runtime identities")
          } else { run Testing.expect(false, "sourceB has a canonical identity") }
        } else { run Testing.expect(false, "sourceA has a canonical identity") }
      } else { run Testing.expect(false, "compare has a canonical identity") }
    } else { run Testing.expect(false, "other function has a canonical identity") }
  } else { run Testing.expect(false, "applied function has a canonical identity") }
  return ()
}

test effect fn specializationAdmissionRejectsGrowthAndAllowsFiniteWitnessDescent() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("specialization-recursion.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("struct Box<T> { value: T }\nfn walk<T>(value: T) -> T { return move value }\nfn helper<T>(value: T) -> T { return move value }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let walkId = run identityOf(&revision, &entry, OwnerKind.Function, b"walk", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let helperId = run identityOf(&revision, &entry, OwnerKind.Function, b"helper", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxId = run identityOf(&revision, &entry, OwnerKind.Struct, b"Box", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<DeclarationId>.Some {value: walk} = move walkId {
    if let Option<DeclarationId>.Some {value: helper} = move helperId {
      if let Option<DeclarationId>.Some {value: boxDeclaration} = move boxId {
        let integer = run specializationPrimitive(b"i32")
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut boxArguments = Vector.make<Argument>()
        run Vector.append<Argument>(&mut boxArguments, Argument.Type {value: Shared.clone<Type>(&integer)})
          |> Effect.provideMut<Allocator>(&mut allocator)
        let boxType = run specializationNominal(&boxDeclaration, move boxArguments)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut largerArguments = Vector.make<Argument>()
        run Vector.append<Argument>(&mut largerArguments, Argument.Type {value: Shared.clone<Type>(&boxType)})
          |> Effect.provideMut<Allocator>(&mut allocator)
        let largerType = run specializationNominal(&boxDeclaration, move largerArguments)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let outer = run specializationOf(&walk, &boxType)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let larger = run specializationOf(&walk, &largerType)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let smaller = run specializationOf(&walk, &integer)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let helperApplication = run specializationOf(&helper, &boxType)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mut admission = SpecializationAdmission.make()
        let entered = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let repeated = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let grown = run SpecializationAdmission.enter(&mut admission, &larger, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let direct = match move grown {
          SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
          _ => false
        }
        let same = match move repeated {
          SpecializationDecision.Reused {ancestor} => ancestor == usize.ZERO
          _ => false
        }
        let initial = match move entered {
          SpecializationDecision.Entered => true
          _ => false
        }
        run Testing.expect(initial && same && direct, "same application reuses its frame and direct growth rejects with the path")
        let mutual = run SpecializationAdmission.enter(&mut admission, &helperApplication, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let mutualGrowth = run SpecializationAdmission.enter(&mut admission, &larger, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let across = match move mutualGrowth {
          SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 3
          _ => false
        }
        let helperDirect = match move mutual {
          SpecializationDecision.Entered => true
          _ => false
        }
        run Testing.expect(helperDirect && across, "mutual growth rejects with the full application path")
        SpecializationAdmission.leave(&mut admission)
        let helperEntered = run SpecializationAdmission.enter(&mut admission, &helperApplication, SpecializationEdge.Witness)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let descent = run SpecializationAdmission.enter(&mut admission, &smaller, SpecializationEdge.Direct)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let finite = match move descent {
          SpecializationDecision.Entered => true
          _ => false
        }
        let witness = match move helperEntered {
          SpecializationDecision.Entered => true
          _ => false
        }
        run Testing.expect(witness && finite, "a concrete witness may delegate through a helper to a strict type subterm")
        let returnsToLarger = run SpecializationAdmission.enter(&mut admission, &outer, SpecializationEdge.Witness)
          |> Effect.provideMut<Allocator>(&mut allocator)
        let disallowed = match move returnsToLarger {
          SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
          _ => false
        }
        run Testing.expect(disallowed, "a witness descent cannot grow back to an older cached application")
        SpecializationAdmission.leave(&mut admission)
        SpecializationAdmission.leave(&mut admission)
        SpecializationAdmission.leave(&mut admission)
      } else { run Testing.expect(false, "Box has a canonical identity") }
    } else { run Testing.expect(false, "helper has a canonical identity") }
  } else { run Testing.expect(false, "walk has a canonical identity") }
  return ()
}

test effect fn specializationAdmissionUsesResolvedConcreteFieldDescent() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("specialization-field-descent.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present("struct Inner { value: i32 }\nstruct Outer { inner: Inner }\nstruct Other { value: i32 }\nfn walk<T>(value: T) -> T { return move value }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(run Revision.copy(&revision)
    |> Effect.provideMut<Allocator>(&mut allocator))
  let owner = run identityOf(&revision, &entry, OwnerKind.Struct, b"Outer", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let member = run identityOf(&revision, &entry, OwnerKind.Struct, b"Inner", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unrelated = run identityOf(&revision, &entry, OwnerKind.Struct, b"Other", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let function = run identityOf(&revision, &entry, OwnerKind.Function, b"walk", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<DeclarationId>.Some {value: outerId} = move owner {
    if let Option<DeclarationId>.Some {value: innerId} = move member {
      if let Option<DeclarationId>.Some {value: otherId} = move unrelated {
        if let Option<DeclarationId>.Some {value: walkId} = move function {
          let outerType = run specializationNominal(&outerId, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let innerType = run specializationNominal(&innerId, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let otherType = run specializationNominal(&otherId, Vector.make<Argument>())
            |> Effect.provideMut<Allocator>(&mut allocator)
          let outerCall = run specializationOf(&walkId, &outerType)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let innerCall = run specializationOf(&walkId, &innerType)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let otherCall = run specializationOf(&walkId, &otherType)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut request = Request.make()
          let checked = run SpecializationFieldDescent.fromMember(
            &mut semantic, &mut request, &outerId, &outerType, usize.ZERO,
          )
            |> Effect.provideMut<Allocator>(&mut allocator)
          let mut admission = SpecializationAdmission.make()
          let _outer = run SpecializationAdmission.enter(&mut admission, &outerCall, SpecializationEdge.Direct)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let unproven = run SpecializationAdmission.enter(&mut admission, &innerCall, SpecializationEdge.Witness)
            |> Effect.provideMut<Allocator>(&mut allocator)
          let noArbitraryNominalDescent = match move unproven {
            SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
            _ => false
          }
          if let Option<SpecializationFieldDescent>.Some {value: field} = move checked {
            let wrongField = run SpecializationAdmission.enter(&mut admission, &otherCall, SpecializationEdge.FieldWitness {field: field})
              |> Effect.provideMut<Allocator>(&mut allocator)
            let noUnrelatedNominalDescent = match move wrongField {
              SpecializationDecision.Rejected {path} => Vector.length<SpecializationApplication>(&path) == 2
              _ => false
            }
            let checkedAgain = run SpecializationFieldDescent.fromMember(
              &mut semantic, &mut request, &outerId, &outerType, usize.ZERO,
            )
              |> Effect.provideMut<Allocator>(&mut allocator)
            if let Option<SpecializationFieldDescent>.Some {value: proven} = move checkedAgain {
              let descent = run SpecializationAdmission.enter(&mut admission, &innerCall, SpecializationEdge.FieldWitness {field: proven})
                |> Effect.provideMut<Allocator>(&mut allocator)
              let accepted = match move descent {
                SpecializationDecision.Entered => true
                _ => false
              }
              run Testing.expect(accepted && noArbitraryNominalDescent && noUnrelatedNominalDescent, "only the selected concrete field permits nongeneric nominal descent")
            } else { run Testing.expect(false, "resolved field can be requested again") }
          } else { run Testing.expect(false, "Outer.inner has a concrete field shape") }
        } else { run Testing.expect(false, "walk has a canonical identity") }
      } else { run Testing.expect(false, "Other has a canonical identity") }
    } else { run Testing.expect(false, "Inner has a canonical identity") }
  } else { run Testing.expect(false, "Outer has a canonical identity") }
  return ()
}

fn staticBodyShape(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut binding = false
  let mut assignment = false
  let mut loop = false
  let mut exit = false
  let mut at = usize.ZERO
  while at < nodes.length {
    match &nodes[at].kind {
      BodyNodeKind.MutableBinding {..} => { binding = true }
      BodyNodeKind.Assignment {..} => { assignment = true }
      BodyNodeKind.While {..} => { loop = true }
      BodyNodeKind.Break => { exit = true }
      _ => ()
    }
    at = at + usize.ONE
  }
  return binding && assignment && loop && exit && bodyIsFullyChecked(body)
}

fn bodyIntegersHaveType(body: &TypedBody, spelling: &[u8], count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Integer {..}} = &nodes[at].kind {
      let matches = Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        return match &value.* {
          Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), spelling)
          _ => false
        }
      })
      if !matches { return false }
      found = found + usize.ONE
    }
    at = at + usize.ONE
  }
  return found == count
}

fn bodyHasLogicalAnd(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.ConcreteInfix {operator, ..}, ..} = &nodes[at].kind {
      if operator == InfixOperator.And { return true }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn staticBodiesRetainCheckedControlAndRejectPlaceMutation() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-bodies.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """struct Box { value: u32 }
static fn countTo(limit: u32) -> u32 { let mut current: u32 = 0 while current < limit { if current == 2 { break } current = current + 1 } return current }
static fn logical(left: bool, right: bool) -> bool { return left && right }
fn runtimeLogical(left: bool, right: bool) -> bool { return left && right }
static fn field(boxed: Box) -> u32 { let mut current = boxed current.value = 1 return 0 }
fn runtime() -> u32 { let mut current: u32 = 0 return current }
fn runtimeCall() -> u32 { return 1 }
static fn invalidCall() -> u32 { return runtimeCall() }
fn mixed(static flag: bool, value: u32) -> u32 { return value }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let count = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"countTo")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let typed = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&count, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move typed {
    run Testing.expect(
      Shared.with<TypedBody, bool>(&value, staticBodyShape),
      "a static body retains checked mutable binding, replacement, loop and break nodes",
    )
  } else {
    run Testing.expect(false, "a static function has a checked body")
  }
  let field = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"field")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let runtime = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"runtime")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let logical = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"logical")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let runtimeLogical = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"runtimeLogical")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidCall = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"invalidCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mixed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"mixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let logicalBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&logical, checkedBody)
  let mut checkedLogical = false
  if let Option<Shared<TypedBody>>.Some {value} = move logicalBody {
    checkedLogical = Shared.with<TypedBody, bool>(&value, bodyHasLogicalAnd)
  }
  run Testing.expect(checkedLogical, "logical and is checked in static bodies")
  run Testing.expect(
    rejectsFrom(&runtimeLogical, RejectionCode.MissingOperator, offsetOf(text, "&&", 1)),
    "logical and remains unavailable in runtime bodies",
  )
  run Testing.expect(
    rejectsFrom(&field, RejectionCode.StaticPhaseViolation, offsetOf(text, "current.value", usize.ZERO)),
    "static bodies reject field mutation at the place span",
  )
  run Testing.expect(
    rejectsFrom(&runtime, RejectionCode.Unsupported, offsetOf(text, "let mut", 2)),
    "runtime bodies do not accept evaluator-local mutation",
  )
  run Testing.expect(
    rejectsFrom(&invalidCall, RejectionCode.StaticPhaseViolation, offsetOf(text, "runtimeCall()", 1)),
    "static bodies reject runtime calls at the call span",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&mixed, inspect).success,
    "static parameters have checked signatures",
  )
  return ()
}

test effect fn staticBodyContextSelectsPointerSizedLiteralsOnBothTargets() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-context.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """static fn id(value: usize) -> usize { return value }
static fn sum() -> usize { return 1 + 2 }
static fn nested() -> usize { return (1 + 2) + (3 + 4) }
static fn passed() -> usize { return id(1) }
static fn wide() -> usize { return 4294967296 }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = Semantic.make(
    run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.Wasm32UnknownUnknown),
  )
  let mut native = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut wasmRequest = Request.make()
  let mut nativeRequest = Request.make()
  let wasmSum = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"sum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeSum = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"sum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmNested = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmPassed = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"passed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmWide = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"wide")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeWide = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"wide")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&wasmSum, checkedBody)
  let second = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&nativeSum, checkedBody)
  let argument = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&wasmPassed, checkedBody)
  let nested = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&wasmNested, checkedBody)
  let mut selected = false
  if let Option<Shared<TypedBody>>.Some {value: wasmBody} = move first {
    if let Option<Shared<TypedBody>>.Some {value: nativeBody} = move second {
      selected = Shared.with<TypedBody, bool>(&wasmBody, fn(body: &TypedBody) -> bool {
        return bodyIntegersHaveType(body, b"usize", 2)
      }) && Shared.with<TypedBody, bool>(&nativeBody, fn(body: &TypedBody) -> bool {
        return bodyIntegersHaveType(body, b"usize", 2)
      })
    }
  }
  let mut parameterContext = false
  if let Option<Shared<TypedBody>>.Some {value} = move argument {
    parameterContext = Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyIntegersHaveType(body, b"usize", 1)
    })
  }
  let mut nestedContext = false
  if let Option<Shared<TypedBody>>.Some {value} = move nested {
    nestedContext = Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyIntegersHaveType(body, b"usize", 4)
    })
  }
  run Testing.expect(
    selected && parameterContext && nestedContext && rejectsFrom(&wasmWide, RejectionCode.IntegerOutOfRange, offsetOf(text, "4294967296", usize.ZERO)) && Shared.with<Result<Answer, NoRejection>, AnswerView>(&nativeWide, inspect).success,
    "return expressions and call arguments retain target-contextual usize literals",
  )
  return ()
}

fn bodyHasIntrinsic(body: &TypedBody, wanted: IntrinsicMember, arguments: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.IntrinsicCall {member, arguments: checked}, ..} = &nodes[at].kind {
      if member == wanted && Vector.length<BodyNodeId>(&checked) == arguments { return true }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn staticBodiesSelectSealedIntrinsicMembersWithCheckedTypes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-intrinsics.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """static fn bits() -> u32 { let value = Intrinsic.targetPointerBits() return value }
static fn length() -> usize { return Intrinsic.staticTextByteLength("abc") }
fn invalid() -> u32 { return Intrinsic.targetPointerBits() }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let bits = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bits")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let length = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"length")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"invalid")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBits = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&bits, checkedBody)
  let selectedLength = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&length, checkedBody)
  let mut valid = false
  if let Option<Shared<TypedBody>>.Some {value: bitsBody} = move selectedBits {
    if let Option<Shared<TypedBody>>.Some {value: lengthBody} = move selectedLength {
      valid = Shared.with<TypedBody, bool>(&bitsBody, fn(body: &TypedBody) -> bool {
        return bodyHasIntrinsic(body, IntrinsicMember.TargetPointerBits, usize.ZERO)
      }) && Shared.with<TypedBody, bool>(&lengthBody, fn(body: &TypedBody) -> bool {
        return bodyHasIntrinsic(body, IntrinsicMember.StaticTextByteLength, usize.ONE)
      })
    }
  }
  run Testing.expect(
    valid && rejectsFrom(&invalid, RejectionCode.StaticPhaseViolation, offsetOf(text, "Intrinsic.targetPointerBits()", 1)),
    "static calls retain sealed member identity while runtime calls are rejected",
  )
  return ()
}

test effect fn staticIntrinsicContractsRejectUnknownMembersAndMismatches() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-intrinsic-errors.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """static fn unknown() -> u32 { return Intrinsic.missing() }
static fn wrongArgument() -> usize { return Intrinsic.staticTextByteLength(1) }
static fn wrongResult() -> usize { return Intrinsic.targetPointerBits() }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let unknown = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unknown")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let argument = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongArgument")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&unknown, RejectionCode.UnknownMember, offsetOf(text, "missing", usize.ZERO)) && rejectsFrom(&argument, RejectionCode.TypeMismatch, offsetOf(text, "Intrinsic.staticTextByteLength(1)", usize.ZERO)) && rejectsFrom(&result, RejectionCode.TypeMismatch, offsetOf(text, "Intrinsic.targetPointerBits()", usize.ZERO)),
    "sealed intrinsic selection reports unknown members and typed contract mismatches at source spans",
  )
  return ()
}

effect fn registeredParameterClaims() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static>
? &mut Allocator {
  let entry = run module("registered-parameters.silk")
  let source = run present(
    "pub param workers: u32 = 1\nparam local: bool = false\nparam missing: bool\npub param borrowed: &u32\n",
  )
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut semantic = makeSemantic(move revision)
  let mut absent = Request.make()
  let denied = run Semantic.demandParameterSchema(&mut semantic, &mut absent, &entry, b"workers")
  run Testing.expect(
    rejectsWith(&denied, RejectionCode.UnregisteredParameter) && reads(Semantic.sourceEvents(&semantic), &entry) == usize.ZERO,
    "unregistered schemas reject before reading their source",
  )
  let mut request = Request.make()
  run Request.registerSchemaModule(&mut request, &entry)
  run Request.registerSchemaModule(&mut request, &entry)
  run Testing.expect(Request.registeredSchemaModules(&request).length == usize.ONE, "registration is canonical and idempotent")
  let conflicting = run ModuleId.make(b"different-source", b"example", b"registered-parameters.silk")
  let duplicatePackage = run Effect.result(Request.registerSchemaModule(&mut request, &conflicting))
  let rejectedPackage = match move duplicatePackage {
    Result<(), RegistrationClosed | ConflictingPackageSource | OutOfMemoryError>.Failure {error} => match move error {
      ConflictingPackageSource {} => true
      _ => false
    }
    _ => false
  }
  run Testing.expect(rejectedPackage && Request.registeredSchemaModules(&request).length == usize.ONE, "unequal sources cannot claim one package identity")
  let public = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"workers")
  let late = run ModuleId.make(b"source", b"example", b"late.silk")
  let afterDemand = run Effect.result(Request.registerSchemaModule(&mut request, &late))
  let closed = match move afterDemand {
    Result<(), RegistrationClosed | ConflictingPackageSource | OutOfMemoryError>.Failure {error} => match move error {
      RegistrationClosed {} => true
      _ => false
    }
    _ => false
  }
  run Testing.expect(closed, "schema registration closes at the first semantic demand")
  let private = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"local")
  let missing = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"missing")
  let borrowed = run Semantic.demandParameterSchema(&mut semantic, &mut request, &entry, b"borrowed")
  let publicHeader = Shared.with<Result<Answer, NoRejection>, Option<Shared<ParameterSchema>>>(&public, schemaHeader)
  let privateHeader = Shared.with<Result<Answer, NoRejection>, Option<Shared<ParameterSchema>>>(&private, schemaHeader)
  let mut valid = false
  if let Option<Shared<ParameterSchema>>.Some {value: selected} = move publicHeader {
    valid = Shared.with<ParameterSchema, bool>(&selected, fn(schema: &ParameterSchema) -> bool {
      return schema.isPublic && schema.hasDefault && DeclarationId.named(&schema.declaration, b"workers")
    })
  }
  if let Option<Shared<ParameterSchema>>.Some {value: selected} = move privateHeader {
    valid = valid && Shared.with<ParameterSchema, bool>(&selected, fn(schema: &ParameterSchema) -> bool {
      return !schema.isPublic && schema.hasDefault && DeclarationId.named(&schema.declaration, b"local")
    })
  } else {
    valid = false
  }
  run Testing.expect(
    valid && rejectsWith(&missing, RejectionCode.InvalidParameterSchema) &&
    rejectsWith(&borrowed, RejectionCode.InvalidParameterSchema),
    "registered headers retain identity and reject missing private defaults or address-bearing types",
  )
  let mut schemas = Vector.make<Shared<ParameterSchema>>()
  let visibleSchema = Shared.with<Result<Answer, NoRejection>, Option<Shared<ParameterSchema>>>(&public, schemaHeader)
  let hiddenSchema = Shared.with<Result<Answer, NoRejection>, Option<Shared<ParameterSchema>>>(&private, schemaHeader)
  if let Option<Shared<ParameterSchema>>.Some {value} = move visibleSchema {
    run Vector.append<Shared<ParameterSchema>>(&mut schemas, move value)
  }
  if let Option<Shared<ParameterSchema>>.Some {value} = move hiddenSchema {
    run Vector.append<Shared<ParameterSchema>>(&mut schemas, move value)
  }
  let workers = run exampleBinding(b"workers")
  let local = run exampleBinding(b"local")
  let unknown = run exampleBinding(b"unknown")
  let alias = AcceptedBinding {
    package: run Bytes.copy(b"example"),
    module: run Bytes.copy(b"Alias"),
    parameter: run Bytes.copy(b"workers"),
    value: BindingInput.Integer {decimal: run Bytes.copy(b"7")},
    provenance: BindingProvenance.Literal,
    tier: BindingTier.Project,
  }
  let found = bindingHeader(&workers, Vector.asSlice<Shared<ParameterSchema>>(&schemas))
  let hidden = bindingHeader(&local, Vector.asSlice<Shared<ParameterSchema>>(&schemas))
  let absentBinding = bindingHeader(&unknown, Vector.asSlice<Shared<ParameterSchema>>(&schemas))
  let aliased = bindingHeader(&alias, Vector.asSlice<Shared<ParameterSchema>>(&schemas))
  let foundPublic = match move found {
    Result<Shared<ParameterSchema>, BindingHeaderError>.Success {value: _} => true
    _ => false
  }
  let rejectsPrivate = match move hidden {
    Result<Shared<ParameterSchema>, BindingHeaderError>.Failure {error} => error == BindingHeaderError.PrivateParameter
    _ => false
  }
  let rejectsUnknown = match move absentBinding {
    Result<Shared<ParameterSchema>, BindingHeaderError>.Failure {error} => error == BindingHeaderError.UnknownParameter
    _ => false
  }
  let rejectsAlias = match move aliased {
    Result<Shared<ParameterSchema>, BindingHeaderError>.Failure {error} => error == BindingHeaderError.UnknownParameter
    _ => false
  }
  run Testing.expect(foundPublic && rejectsPrivate && rejectsUnknown && rejectsAlias, "bindings use canonical identity rather than import aliases")
  let listed = Vector.asSlice<Shared<ParameterSchema>>(&schemas)
  if listed.length > usize.ZERO {
    let shape = BindingShape.Integer {kind: StaticIntegerType.U32, bits: 32}
    let lower = run exampleIntegerBinding(b"4294967296", BindingTier.Project)
    let higher = run exampleIntegerBinding(b"7", BindingTier.Override)
    let invalid = run checkBinding(move lower, Shared.clone<ParameterSchema>(&listed[usize.ZERO]), &shape)
    let valid = run checkBinding(move higher, Shared.clone<ParameterSchema>(&listed[usize.ZERO]), &shape)
    let invalidLoses = match move invalid {
      Result<CheckedBinding, BindingCheckError>.Failure {error} => error == BindingCheckError.WrongType
      _ => false
    }
    let mut equalTierConflict = false
    if let Result<CheckedBinding, BindingCheckError>.Success {value: selected} = move valid {
      let other = run exampleIntegerBinding(b"7", BindingTier.Override)
      let checked = run checkBinding(move other, Shared.clone<ParameterSchema>(&listed[usize.ZERO]), &shape)
      if let Result<CheckedBinding, BindingCheckError>.Success {value: duplicate} = move checked {
        equalTierConflict = match move bindingOutranks(&selected, &duplicate) {
          Result<bool, BindingSameTierConflict>.Failure {error: _} => true
          _ => false
        }
      }
    }
    run Testing.expect(invalidLoses && equalTierConflict, "invalid losing binding and equal same-tier binding both reject")
    run bindingBatchClaims(Shared.clone<ParameterSchema>(&listed[usize.ZERO]))
    if listed.length > usize.ONE {
      let privateRejected = run privateBindingClaim(Shared.clone<ParameterSchema>(&listed[usize.ONE]))
      run Testing.expect(privateRejected, "binding batch rejects a private parameter")
    }
  } else { run Testing.expect(false, "the public parameter supplies a binding schema") }
  let discovered = run Semantic.demandRegisteredParameters(&mut semantic, &mut request)
  let complete = match move discovered {
    Result<Vector<RegisteredParameter>, Shared<Rejection>>.Success {value} => Vector.length<RegisteredParameter>(&value) == 4
    Result<Vector<RegisteredParameter>, Shared<Rejection>>.Failure {error: _} => false
  }
  run Testing.expect(complete && reads(Semantic.sourceEvents(&semantic), &entry) == usize.ONE, "explicit registration enumerates all headers with one source read")
  return ()
}

test effect fn profileBindingRegisteredHeaders() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | RegistrationClosed | ConflictingPackageSource | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run registeredParameterClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn acceptedInteger(binding: AcceptedBinding) -> bool {
  return match move binding.value {
    BindingInput.Integer {decimal} => Bytes.asSlice(&decimal).length == 2
    _ => false
  }
}

effect fn bindingProvenanceClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let secret = SuppliedBinding {
    package: run Bytes.copy(b"example@1"),
    module: run Bytes.copy(b"config.silk"),
    parameter: run Bytes.copy(b"token"),
    value: BindingInput.String {text: run Bytes.copy(b"must-never-leak")},
    provenance: BindingProvenance.Secret,
    tier: BindingTier.Override,
  }
  let rejected = admitBinding(move secret)
  let noValue = match move rejected {
    Result<AcceptedBinding, ProhibitedProvenance>.Failure {error: _} => true
    _ => false
  }
  let physical = admitBinding(run suppliedInteger(b"workers", b"2", BindingTier.Project, BindingProvenance.PhysicalSupply))
  let runtime = admitBinding(run suppliedInteger(b"workers", b"3", BindingTier.Project, BindingProvenance.Runtime))
  let noPhysical = match move physical {
    Result<AcceptedBinding, ProhibitedProvenance>.Failure {error: _} => true
    _ => false
  }
  let noRuntime = match move runtime {
    Result<AcceptedBinding, ProhibitedProvenance>.Failure {error: _} => true
    _ => false
  }
  let literal = SuppliedBinding {
    package: run Bytes.copy(b"example@1"),
    module: run Bytes.copy(b"config.silk"),
    parameter: run Bytes.copy(b"workers"),
    value: BindingInput.Integer {decimal: run Bytes.copy(b"42")},
    provenance: BindingProvenance.Literal,
    tier: BindingTier.Project,
  }
  let accepted = admitBinding(move literal)
  let allowed = match move accepted {
    Result<AcceptedBinding, ProhibitedProvenance>.Success {value: binding} => acceptedInteger(move binding)
    _ => false
  }
  let translated = admitBinding(run suppliedInteger(
    b"workers", b"42", BindingTier.Project,
    BindingProvenance.TranslatedPublic {translator: run Bytes.copy(b"public-config@1")},
  ))
  let publicValue = match move translated {
    Result<AcceptedBinding, ProhibitedProvenance>.Success {value: binding} => acceptedInteger(move binding)
    _ => false
  }
  run Testing.expect(noValue && noPhysical && noRuntime && allowed && publicValue, "only literal and identified public translations enter semantic binding work")
  return ()
}

test effect fn profileBindingProvenance() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bindingProvenanceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn bindingShapeClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let positive = BindingInput.Integer {decimal: run Bytes.copy(b"127")}
  let overflow = BindingInput.Integer {decimal: run Bytes.copy(b"128")}
  let minimum = BindingInput.Integer {decimal: run Bytes.copy(b"-128")}
  let negativeZero = BindingInput.Integer {decimal: run Bytes.copy(b"-0")}
  let narrow = BindingShape.Integer {kind: StaticIntegerType.I8, bits: 8}
  run Testing.expect(
    bindingFits(&positive, &narrow) && bindingFits(&minimum, &narrow) &&
    !bindingFits(&overflow, &narrow) && bindingFits(&negativeZero, &narrow),
    "integer binding uses exact decimal range and accepts negative zero as zero",
  )
  let widest = BindingShape.Integer {kind: StaticIntegerType.U64, bits: 64}
  let maximum = BindingInput.Integer {decimal: run Bytes.copy(b"18446744073709551615")}
  let beyond = BindingInput.Integer {decimal: run Bytes.copy(b"18446744073709551616")}
  run Testing.expect(bindingFits(&maximum, &widest) && !bindingFits(&beyond, &widest), "integer binding preserves the full u64 range without numeric rounding")
  let mut invalidUtf8 = run Bytes.zeroed(1)
  let mut invalidBytes = Bytes.asMutSlice(&mut invalidUtf8)
  invalidBytes[usize.ZERO] = u8.toU8(255)
  let text = BindingShape.String
  let invalidText = BindingInput.String {text: move invalidUtf8}
  let validText = BindingInput.String {text: run Bytes.copy(b"hello")}
  run Testing.expect(bindingFits(&validText, &text) && !bindingFits(&invalidText, &text), "string binding accepts only UTF-8")
  // Wire matching reads names; U8 fills each member's canonical static enum value.
  let mut cases = Vector.make<BindingEnumMember>()
  run Vector.append<BindingEnumMember>(&mut cases, BindingEnumMember {
    name: run Bytes.copy(b"Open"), value: run Shared.make<StaticData>(StaticData.Unit),
  })
  run Vector.append<BindingEnumMember>(&mut cases, BindingEnumMember {
    name: run Bytes.copy(b"Closed"), value: run Shared.make<StaticData>(StaticData.Unit),
  })
  let enumeration = BindingShape.Enum {canonical: run Bytes.copy(b"pkg@1/mod.silk/Choice"), members: move cases}
  let selected = BindingInput.Enum {nominal: run Bytes.copy(b"pkg@1/mod.silk/Choice"), member: run Bytes.copy(b"Closed")}
  let wrongType = BindingInput.Enum {nominal: run Bytes.copy(b"pkg@1/mod.silk/Other"), member: run Bytes.copy(b"Closed")}
  let wrongCase = BindingInput.Enum {nominal: run Bytes.copy(b"pkg@1/mod.silk/Choice"), member: run Bytes.copy(b"Missing")}
  run Testing.expect(
    bindingFits(&selected, &enumeration) && !bindingFits(&wrongType, &enumeration) && !bindingFits(&wrongCase, &enumeration),
    "enum binding checks canonical type identity and member spelling",
  )
  let boolType = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"bool")})
  let optional = BindingShape.Optional {
    absent: 0, present: 1, elementType: Shared.clone<Type>(&boolType),
    element: run Box.make<BindingShape>(BindingShape.Boolean),
  }
  let none = BindingInput.None
  let some = BindingInput.Some {value: run Box.make<BindingInput>(BindingInput.Boolean {value: true})}
  let badSome = BindingInput.Some {value: run Box.make<BindingInput>(BindingInput.Integer {decimal: run Bytes.copy(b"1")})}
  run Testing.expect(
    bindingFits(&none, &optional) && bindingFits(&some, &optional) && !bindingFits(&badSome, &optional),
    "structural optional checks both variants and payload type",
  )
  let mut values = Vector.make<Box<BindingInput>>()
  run Vector.append<Box<BindingInput>>(&mut values, run Box.make<BindingInput>(BindingInput.Boolean {value: true}))
  run Vector.append<Box<BindingInput>>(&mut values, run Box.make<BindingInput>(BindingInput.Boolean {value: false}))
  let array = BindingInput.Array {values: move values}
  let pair = BindingShape.Array {length: 2, elementType: Shared.clone<Type>(&boolType), element: run Box.make<BindingShape>(BindingShape.Boolean)}
  let triple = BindingShape.Array {length: 3, elementType: Shared.clone<Type>(&boolType), element: run Box.make<BindingShape>(BindingShape.Boolean)}
  run Testing.expect(bindingFits(&array, &pair) && !bindingFits(&array, &triple), "array binding checks exact length")
  let borrowed = run Shared.make<Type>(Type.Reference {
    referent: Shared.clone<Type>(&boolType), access: Access.Shared,
    lifetime: run Shared.make<Lifetime>(Lifetime.Static),
  })
  let borrowedArray = run Shared.make<Type>(Type.Array {element: Shared.clone<Type>(&borrowed), extent: run Bytes.copy(b"1")})
  let forgedChild = BindingShape.Array {
    length: 1, elementType: Shared.clone<Type>(&borrowed),
    element: run Box.make<BindingShape>(BindingShape.Boolean),
  }
  let wrongRoot = !run bindingCorrespondsToType(&boolType, &narrow)
  let wrongChild = !run bindingCorrespondsToType(&borrowedArray, &forgedChild)
  run Testing.expect(
    wrongRoot && wrongChild,
    "schema type correspondence rejects a mismatched root and a borrowed aggregate child",
  )
  let mut fields = Vector.make<BindingNamedShape>()
  run Vector.append<BindingNamedShape>(&mut fields, BindingNamedShape {name: run Bytes.copy(b"first"), ty: Shared.clone<Type>(&boolType), value: run Box.make<BindingShape>(BindingShape.Boolean)})
  run Vector.append<BindingNamedShape>(&mut fields, BindingNamedShape {name: run Bytes.copy(b"second"), ty: Shared.clone<Type>(&boolType), value: run Box.make<BindingShape>(BindingShape.Boolean)})
  let record = BindingShape.Record {fields: move fields}
  let mut reversed = Vector.make<BindingField>()
  run Vector.append<BindingField>(&mut reversed, BindingField {name: run Bytes.copy(b"second"), value: run Box.make<BindingInput>(BindingInput.Boolean {value: true})})
  run Vector.append<BindingField>(&mut reversed, BindingField {name: run Bytes.copy(b"first"), value: run Box.make<BindingInput>(BindingInput.Boolean {value: false})})
  let correct = BindingInput.Record {fields: move reversed}
  let mut duplicate = Vector.make<BindingField>()
  run Vector.append<BindingField>(&mut duplicate, BindingField {name: run Bytes.copy(b"first"), value: run Box.make<BindingInput>(BindingInput.Boolean {value: true})})
  run Vector.append<BindingField>(&mut duplicate, BindingField {name: run Bytes.copy(b"first"), value: run Box.make<BindingInput>(BindingInput.Boolean {value: false})})
  let repeated = BindingInput.Record {fields: move duplicate}
  run Testing.expect(bindingFits(&correct, &record) && !bindingFits(&repeated, &record), "record binding ignores field order but rejects duplicates")
  return ()
}

test effect fn profileBindingPortableShapes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run bindingShapeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nominalBindingShapeClaims() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let entry = run module("shape-kind.silk")
  let source = run present("""
struct Card {}
enum Choice { Open }
union Maybe { None, Some { value: bool } }
""")
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let card = run requireIdentity(&revision, &entry, OwnerKind.Struct, b"Card", usize.ZERO)
  let choice = run requireIdentity(&revision, &entry, OwnerKind.Enumeration, b"Choice", usize.ZERO)
  let cardType = run Shared.make<Type>(Type.Nominal {
    declaration: move card, isPublic: false, arguments: Vector.make<Argument>(),
  })
  let choiceType = run Shared.make<Type>(Type.Nominal {
    declaration: run DeclarationId.copy(&choice), isPublic: false, arguments: Vector.make<Argument>(),
  })
  let boolType = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"bool")})
  let optional = BindingShape.Optional {
    absent: 0, present: 1, elementType: Shared.clone<Type>(&boolType),
    element: run Box.make<BindingShape>(BindingShape.Boolean),
  }
  let record = BindingShape.Record {fields: Vector.make<BindingNamedShape>()}
  let mut cases = Vector.make<BindingEnumMember>()
  run Vector.append<BindingEnumMember>(&mut cases, BindingEnumMember {
    name: run Bytes.copy(b"Open"),
    value: run Shared.make<StaticData>(StaticData.Enum {
      declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&choice)),
      member: 0, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
    }),
  })
  let enumeration = BindingShape.Enum {
    canonical: run Bytes.copy(b"example/shape-kind.silk/Choice"), members: move cases,
  }
  let correctEnum = run bindingCorrespondsToType(&choiceType, &enumeration)
  let enumAsRecord = run bindingCorrespondsToType(&choiceType, &record)
  let structAsOptional = run bindingCorrespondsToType(&cardType, &optional)
  let structAsEnum = run bindingCorrespondsToType(&cardType, &enumeration)
  let wrongKind = !enumAsRecord && !structAsOptional && !structAsEnum
  let mut forgedCases = Vector.make<BindingEnumMember>()
  run Vector.append<BindingEnumMember>(&mut forgedCases, BindingEnumMember {
    name: run Bytes.copy(b"Open"),
    value: run Shared.make<StaticData>(StaticData.Enum {
      declaration: run Shared.make<DeclarationId>(move choice),
      member: 0, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
    }),
  })
  let wrongCanonical = BindingShape.Enum {
    canonical: run Bytes.copy(b"example/shape-kind.silk/Other"), members: move forgedCases,
  }
  let acceptedWrongCanonical = run bindingCorrespondsToType(&choiceType, &wrongCanonical)
  run Testing.expect(
    correctEnum && wrongKind && !acceptedWrongCanonical,
    "nominal shapes use declaration kind and canonical enum identity",
  )
  return ()
}

test effect fn profileBindingNominalIdentity() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nominalBindingShapeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
