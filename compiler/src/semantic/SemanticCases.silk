test effect fn nominalUnionsDiagNegatives() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("nominal-unions.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
union Shape { Circle { radius: i32 }, Rect { width: i32, height: i64 }, Empty }
union Generic<T> { Some { value: T }, None }
struct Holder { shape: Shape }
fn make(kind: i32) -> Shape {
  if kind == 0 { return Shape.Circle { radius: 3 } }
  return Shape.Empty
}
fn area(shape: &Shape) -> i32 {
  return match &shape.* {
    Shape.Circle { radius } => radius
    Shape.Rect { width, .. } if width > 10 => width
    Shape.Rect { width, height } => width
    Shape.Empty => 0
  }
}
pub fn main() -> i32 { let shape = make(0) return area(&shape) }
fn missing(shape: Shape) -> i32 { return match move shape { Shape.Circle { radius } => radius Shape.Empty => 0 } }
fn duplicate(shape: Shape) -> i32 { return match move shape { Shape.Empty => 0 Shape.Empty => 1 _ => 2 } }
fn unknownField() -> Shape { return Shape.Circle { size: 1 } }
fn fieldCount() -> Shape { return Shape.Rect { width: 1 } }
fn payloadUnit() -> Shape { return Shape.Rect }
fn unitPattern(shape: Shape) -> i32 { return match move shape { Shape.Rect => 1 _ => 0 } }
fn nested(holder: Holder) -> i32 { return match move holder { Holder { shape: Shape.Empty {} } => 0 } }
fn generic() -> i32 { let value = Generic.Some { value: 1 } return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let duplicate = run Semantic.demandBody(&mut store, &mut request, &id, b"duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknownField = run Semantic.demandBody(&mut store, &mut request, &id, b"unknownField")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fieldCount = run Semantic.demandBody(&mut store, &mut request, &id, b"fieldCount")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let payloadUnit = run Semantic.demandBody(&mut store, &mut request, &id, b"payloadUnit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unitPattern = run Semantic.demandBody(&mut store, &mut request, &id, b"unitPattern")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.MissingUnionMember, text, "match move shape { Shape.Circle { radius } => radius Shape.Empty => 0 }", 0), "a missing variant is uncovered")
  run Testing.expect(rejectsSpan(&duplicate, RejectionCode.DuplicateMatchPattern, text, "Shape.Empty", 4), "a repeated unit variant is duplicate")
  run Testing.expect(rejectsSpan(&unknownField, RejectionCode.UnknownMember, text, "size", 0), "a constructor names only variant fields")
  run Testing.expect(rejectsSpan(&fieldCount, RejectionCode.CallArity, text, "Shape.Rect { width: 1 }", 0), "a constructor initializes every field")
  run Testing.expect(rejectsSpan(&payloadUnit, RejectionCode.CallArity, text, "Shape.Rect", 3), "a payload variant needs its fields")
  run Testing.expect(rejectsSpan(&unitPattern, RejectionCode.InvalidRecordPattern, text, "Shape.Rect", 4), "a payload variant pattern names its fields")
  run Testing.expect(rejectsSpan(&nested, RejectionCode.RefutableSubpattern, text, "Shape.Empty {}", 0), "a nested variant pattern is refutable")
  run Testing.expect(rejectsSpan(&generic, RejectionCode.UnionFormUnavailable, text, "Generic.Some { value: 1 }", 0), "a generic union keeps its named deferral")
  return ()
}

// Temporary reduction of the native abort: a shared destructure binding a scalar and a vector from
// one variant, then a nested shared if-let on an element of that vector.
union ReproSelector { Unit, Selected {tag: usize} }
struct ReproArm { pattern: ReproSelector }
union ReproOuter { Other, Pair {count: usize, items: Vector<ReproArm>} }
union ReproOwning { Unit, Owning {member: Option<Shared<usize>>}, Selected {tag: usize} }
struct ReproOwningArm { pattern: ReproOwning }
union ReproOwningOuter { Other, Pair {count: usize, items: Vector<ReproOwningArm>} }
union ReproForm { Other, Match {subject: usize, place: bool, count: usize, items: Vector<ReproOwningArm>} }
union ReproKind { Statement, Expression {ty: Shared<usize>, form: ReproForm} }

fn reproMinimal(values: &[ReproOuter]) -> usize {
  let mut at = usize.ZERO
  while at < values.length {
    if let ReproOuter.Pair {count, items} = &values[at] {
      let written = Vector.asSlice<ReproArm>(&items)
      let mut best = count
      let mut arm = usize.ZERO
      while arm < written.length {
        let mut selected: usize = 9
        if let ReproSelector.Selected {tag} = &written[arm].pattern { selected = tag }
        if selected > best { best = selected }
        arm = arm + usize.ONE
      }
      return best
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn reproOwning(values: &[ReproOwningOuter]) -> usize {
  let mut at = usize.ZERO
  while at < values.length {
    if let ReproOwningOuter.Pair {count, items} = &values[at] {
      let written = Vector.asSlice<ReproOwningArm>(&items)
      let mut best = count
      let mut arm = usize.ZERO
      while arm < written.length {
        let mut selected: usize = 9
        if let ReproOwning.Selected {tag} = &written[arm].pattern { selected = tag }
        if selected > best { best = selected }
        arm = arm + usize.ONE
      }
      return best
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn reproNested(values: &[ReproKind]) -> usize {
  let mut at = usize.ZERO
  while at < values.length {
    if let ReproKind.Expression {form: ReproForm.Match {count, items, ..}, ..} = &values[at] {
      let written = Vector.asSlice<ReproOwningArm>(&items)
      let mut best = count
      let mut arm = usize.ZERO
      while arm < written.length {
        let mut selected: usize = 9
        if let ReproOwning.Selected {tag} = &written[arm].pattern { selected = tag }
        if selected > best { best = selected }
        arm = arm + usize.ONE
      }
      return best
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

test effect fn reproTrap1Minimal() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut items = Vector.make<ReproArm>()
  run Vector.append<ReproArm>(&mut items, ReproArm {pattern: ReproSelector.Selected {tag: usize.ONE}}) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<ReproArm>(&mut items, ReproArm {pattern: ReproSelector.Unit}) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<ReproArm>(&mut items, ReproArm {pattern: ReproSelector.Selected {tag: 7}}) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut values = Vector.make<ReproOuter>()
  run Vector.append<ReproOuter>(&mut values, ReproOuter.Pair {count: 3, items: move items}) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(reproMinimal(Vector.asSlice<ReproOuter>(&values)) == 7, "minimal paired destructure with nested if-let")
  return ()
}

