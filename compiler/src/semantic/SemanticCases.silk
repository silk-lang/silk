effect fn opaqueReturnStorageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-return-storage.silk")
  let text = """
fn add(value: i32, offset: i32) -> i32 { return value + offset }
fn make(offset: i32) -> some<F: fn<'static>(i32) -> i32> F { return add(offset) }
fn discarded(value: i32) -> i32 { return value }
fn early() -> some<Live: fn<'static>(i32) -> i32> Live { return add(20) return discarded }
fn returnedNever() -> some<Exit: fn<'static>(i32) -> i32> Exit {
  return match true { _ => { return add(20) } }
}
fn main() -> i32 {
  let callback = make(20)
  let first = callback(1)
  return first + callback(1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "an opaque callable result has a finite runtime environment")
  run Testing.expect(sectionInvocationCount(&store, &entry, b"add", false) == 2,
    "each opaque invocation directly calls the original target with the stored suffix")
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"make")
  run Testing.expect(succeeded(&producer) && opaqueSectionResult(&store, &producer),
    "the producer returns its exact one-field section environment through the same ABI as its caller")
  let early = run Semantic.demandMir(&mut store, &mut request, &id, b"early")
  run Testing.expect(succeeded(&early) && opaqueSectionResult(&store, &early),
    "an unreachable retained return cannot invent a divergent representation")
  let exits = run Semantic.demandMir(&mut store, &mut request, &id, b"returnedNever")
  run Testing.expect(succeeded(&exits) && opaqueSectionResult(&store, &exits),
    "a never-typed outer operand establishes no leaf beyond its inner returned construction")
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"make")
  let source = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature, signatureResult)
  if let Option<Shared<Type>>.Some {value} = move source {
    run Testing.expect(Shared.with<Type, bool>(&value,
      fn(ty: &Type) -> bool { return match &ty.* { Type.OpaqueRepresentation {..} => true _ => false } }),
      "runtime realization leaves the authored producer family intact")
  } else { run Testing.expect(false, "the producer retains its source result") }
}

fn opaqueSectionResult(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Shared.with<Type, bool>(&function.result, opaqueSectionResultType)
    }
  }
  return false
}

fn opaqueSectionResultType(value: &Type) -> bool {
  if let Type.CallableValue {application, captures, ..} = &value.* {
    return Vector.length<Shared<Type>>(&captures) == usize.ONE
      && Shared.with<SpecializationApplication, bool>(&application,
        fn(selected: &SpecializationApplication) -> bool {
          return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), b"add")
        })
  }
  return false
}

test effect fn opaqueCallableReturnsRejectDivergenceAndLeaflessCycles() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueReturnFailureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn opaqueReturnFailureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-return-failures.silk")
  let text = """
fn positive(value: i32) -> i32 { return value + 1 }
fn negative(value: i32) -> i32 { return value - 1 }
fn divergent(choice: bool) -> some<Different: fn<'static>(i32) -> i32> Different {
  if choice { return positive }
  return negative
}
fn cycle() -> some<Recursive: fn<'static>() -> i32> Recursive { return cycle() }
fn inlineCycle() -> some<Inline: once fn<'static>() -> i32> Inline {
  let previous = inlineCycle()
  return fn() -> i32 { return previous() }
}
fn missing() -> some<Absent: fn<'static>(i32) -> i32> Absent | i32 { return 42 }
fn wrong() -> some<Wrong: fn<'static>(i32) -> i32> Wrong { return fn(value: bool) -> bool { return value } }
fn deferred() -> some<Pending: Effect<'static; i32>> Pending { return effect { return 42 } }
fn opaqueEffectUse() -> i32 { return run deferred() }
fn anonymousEffectUse() -> i32 {
  let pending = fn() -> i32 { return run deferred() }
  return pending()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let divergent = run Semantic.demandMir(&mut store, &mut request, &id, b"divergent")
  let cycle = run Semantic.demandMir(&mut store, &mut request, &id, b"cycle")
  let inlineCycle = run Semantic.demandMir(&mut store, &mut request, &id, b"inlineCycle")
  let missing = run Semantic.demandMir(&mut store, &mut request, &id, b"missing")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  let opaqueEffectUse = run Semantic.demandBody(&mut store, &mut request, &id, b"opaqueEffectUse")
  let anonymousEffectUse = run Semantic.demandBody(&mut store, &mut request, &id, b"anonymousEffectUse")
  run Testing.expect(rejectsSpan(&divergent, RejectionCode.DivergentOpaqueRealization, text,
    "some<Different: fn<'static>(i32) -> i32> Different", usize.ZERO),
    "incompatible returned targets reject at the producer's opaque result")
  run Testing.expect(rejectsRelated(&divergent, RejectionCode.DivergentOpaqueRealization,
    offsetOf(text, "some<Different: fn<'static>(i32) -> i32> Different", usize.ZERO), offsetOf(text, "positive", usize.ONE)),
    "divergence retains the first returned construction as a related source site")
  run Testing.expect(rejectsSpan(&cycle, RejectionCode.OpaqueRealizationCycle, text,
    "some<Recursive: fn<'static>() -> i32> Recursive", usize.ZERO),
    "a recursive forwarding family without a concrete leaf rejects at its opaque result")
  run Testing.expect(rejectsSpan(&inlineCycle, RejectionCode.InlineOpaqueLayoutCycle, text,
    "some<Inline: once fn<'static>() -> i32> Inline", usize.ZERO),
    "a returned environment that captures its own family rejects as an inline layout cycle")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.MissingOpaqueRealization, text,
    "some<Absent: fn<'static>(i32) -> i32> Absent | i32", usize.ZERO),
    "an ordinary union alternative supplies no opaque representation evidence")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.ReturnTypeMismatch, text,
    "fn(value: bool) -> bool { return value }", usize.ZERO),
    "an invalid offered callable contract rejects at the returned construction")
  run Testing.expect(succeeded(&opaqueEffectUse) && succeeded(&anonymousEffectUse),
    "an opaque Effect result runs through its contract, also from an anonymous body")
}

test effect fn opaqueCallableReturnsRequireAffineTransfers() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueReturnTransferClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn opaqueReturnTransferClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-return-transfers.silk")
  let text = """
fn copied<F: once fn<'static>() -> i32>(owned: F) -> some<Copied: once fn<'static>() -> i32> Copied { return owned }
fn transferred<F: once fn<'static>() -> i32>(taken: F) -> some<Taken: once fn<'static>() -> i32> Taken { return move taken }
fn borrowed<F: once fn<'static>() -> i32>(loan: &F) -> some<Borrowed: once fn<'static>() -> i32> Borrowed { return loan.* }
fn copiedArms<F: once fn<'static>() -> i32>(choice: bool, armOwned: F) -> some<Arms: once fn<'static>() -> i32> Arms {
  return match choice { _ if choice => armOwned _ => armOwned }
}
fn transferredArms<F: once fn<'static>() -> i32>(choice: bool, armTaken: F) -> some<MovedArms: once fn<'static>() -> i32> MovedArms {
  return match choice { _ if choice => move armTaken _ => move armTaken }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  let transferred = run Semantic.demandBody(&mut store, &mut request, &id, b"transferred")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  let copiedArms = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedArms")
  let transferredArms = run Semantic.demandBody(&mut store, &mut request, &id, b"transferredArms")
  run Testing.expect(rejectsSpan(&copied, RejectionCode.ExplicitMoveRequired, text, "owned", usize.ONE),
    "a producer cannot copy an affine environment out of a retained parameter")
  run Testing.expect(rejectsSpan(&borrowed, RejectionCode.BorrowedExtraction, text, "loan.*", usize.ZERO),
    "a producer cannot extract an affine environment from a borrowed referent")
  run Testing.expect(rejectsSpan(&copiedArms, RejectionCode.ExplicitMoveRequired, text, "armOwned", usize.ONE),
    "each value-producing match arm must transfer its own affine environment")
  let armBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&transferredArms, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move armBody {
    run Testing.expect(Shared.with<TypedBody, bool>(&body, opaqueReturnArmMovesOwners),
      "explicit arm transfers preserve each branch's consumed parameter place")
  } else { run Testing.expect(false, "explicit arm transfers satisfy the opaque callable contract") }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&transferred, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move selected {
    run Testing.expect(Shared.with<TypedBody, bool>(&body, opaqueReturnMovesOwner),
      "an explicit return move retains the consumed parameter place for cleanup")
  } else { run Testing.expect(false, "a moved opaque construction satisfies its declared contract") }
}

fn opaqueReturnMovesOwner(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Return {value: returned} = &nodes[at].kind {
      if let Option<BodyNodeId>.Some {value} = &returned {
        if opaqueMoveOfLocal(nodes, value, usize.ZERO) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn opaqueMoveOfLocal(nodes: &[BodyNode], node: BodyNodeId, owner: usize) -> bool {
  if let BodyNodeKind.Expression {form: BodyExpression.Move {consumed, ..}, ..} = &nodes[node.index].kind {
    if let Option<BodyConsumedPlace>.Some {value: place} = &consumed {
      if let BodyPlaceRoot.Local {local} = &place.root {
        return local.index == owner && Vector.length<BodyPlaceStep>(&place.steps) == usize.ZERO
      }
    }
  }
  return false
}

fn opaqueReturnArmMovesOwners(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Return {value: returned} = &nodes[at].kind {
      if let Option<BodyNodeId>.Some {value} = &returned {
        if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[value.index].kind {
          let listed = Vector.asSlice<BodyMatchArm>(&arms)
          return listed.length == 2 && opaqueMoveOfLocal(nodes, listed[usize.ZERO].result, usize.ONE)
            && opaqueMoveOfLocal(nodes, listed[usize.ONE].result, usize.ONE)
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn callableReturnFlowExcludesMembersWithExitingGuards() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run returnGuardFlowClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn returnGuardFlowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("return-guard-flow.silk")
  let text = """
enum Choice { A, B }
enum Only { One }
fn choose(choice: Choice) -> i32 {
  match choice {
    Choice.A if match true { _ if true => { return 11 } _ => false } => { return 22 }
    Choice.A => { return 33 }
    Choice.B => { return 44 }
  }
}
fn exhausted(choice: Only) -> i32 {
  match choice {
    Only.One if match true { _ if true => { return 55 } _ => false } => { return 66 }
    _ => { return 77 }
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"choose")
  let exhausted = run Semantic.demandBody(&mut store, &mut request, &id, b"exhausted")
  let exhaustedBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&exhausted, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move exhaustedBody {
    let values = run ReturnFlow.collect(&body)
    let listed = Vector.asSlice<BodyNodeId>(&values)
    run Testing.expect(listed.length == usize.ONE, "exhausting every finite member excludes a later universal arm")
    if listed.length == usize.ONE {
      let returned = listed[usize.ZERO]
      run Testing.expect(Shared.with<TypedBody, bool>(&body, fn(value: &TypedBody) -> bool {
        let nodes = TypedBody.nodeSlice(value)
        return nodes[returned.index].origin.span.start == offsetOf(text, "55", usize.ZERO)
          && nodes[returned.index].origin.span.end == offsetOf(text, "55", usize.ZERO) + 2
      }), "the sole reachable result is the exiting guard operand")
    }
  } else { run Testing.expect(false, "the finite-domain guard control retains a checked body") }
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&source, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move selected {
    let values = run ReturnFlow.collect(&body)
    let listed = Vector.asSlice<BodyNodeId>(&values)
    run Testing.expect(listed.length == 2, "only the exiting guard and the remaining enum member return")
    if listed.length == 2 {
      let first = listed[usize.ZERO]
      let second = listed[usize.ONE]
      let exact = Shared.with<TypedBody, bool>(&body, fn(value: &TypedBody) -> bool {
        let nodes = TypedBody.nodeSlice(value)
        return nodes[first.index].origin.span.start == offsetOf(text, "11", usize.ZERO)
          && nodes[first.index].origin.span.end == offsetOf(text, "11", usize.ZERO) + 2
          && nodes[second.index].origin.span.start == offsetOf(text, "44", usize.ZERO)
          && nodes[second.index].origin.span.end == offsetOf(text, "44", usize.ZERO) + 2
      })
      run Testing.expect(exact, "a terminating guard excludes both its own arm result and later arms for that member")
    }
    return ()
  }
  run Testing.expect(false, "the guard control retains a checked body")
}

test effect fn plainCallableReturnsKeepOriginalStorageAndPublicContracts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run plainCallableReturnStorageClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableReturnStorageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("plain-callable-return.silk")
  let text = """
fn inc2(value: i32) -> i32 { return value + 2 }
fn add(value: i32, offset: i32) -> i32 { return value + offset }
fn named() -> fn<'static>(i32) -> i32 { return inc2 }
fn anonymous(offset: i32) -> fn<'static>(i32) -> i32 {
  return fn(value: i32) -> i32 { return value + offset }
}
fn section(offset: i32) -> fn<'static>(i32) -> i32 { return add(offset) }
fn pass<'env>(operation: fn<'env>(i32) -> i32) -> fn<'env>(i32) -> i32 { return operation }
fn main() -> i32 {
  let namedValue = named()
  let anonymousValue = anonymous(2)
  let sectionValue = section(2)
  return namedValue(1) + anonymousValue(1) + sectionValue(1) + pass(inc2)(33)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "plain callable results retain their original direct environment ABI")
  let named = run Semantic.demandMir(&mut store, &mut request, &id, b"named")
  let anonymous = run Semantic.demandMir(&mut store, &mut request, &id, b"anonymous")
  let section = run Semantic.demandMir(&mut store, &mut request, &id, b"section")
  run Testing.expect(plainCallableMirResult(&store, &named, b"inc2", usize.ZERO, false)
    && plainCallableMirResult(&store, &anonymous, b"", usize.ONE, true)
    && plainCallableMirResult(&store, &section, b"add", usize.ONE, false),
    "named, anonymous and section producers return their exact original capture records")
  run Testing.expect(sectionInvocationCount(&store, &entry, b"add", false) == usize.ONE,
    "a plain returned section appends its stored original target argument")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &entry, b"pass") {
    let application = run SpecializationApplication.copyShared(&value)
    let forwarded = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(plainCallableMirResult(&store, &forwarded, b"inc2", usize.ZERO, false),
      "the complete relay application selects its hidden original callable representation")
  } else { run Testing.expect(false, "the relay retains its complete ordinary application") }
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"named")
  let written = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&signature, signatureResult)
  if let Option<Shared<Type>>.Some {value} = move written {
    run Testing.expect(Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Callable {..} => true _ => false }
    }), "ordinary callable signatures retain their authored contract without a generative opaque family")
  } else { run Testing.expect(false, "the ordinary source result is retained") }
}

fn plainCallableMirResult(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], captures: usize, anonymous: bool) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Shared.with<Type, bool>(&function.result, fn(value: &Type) -> bool {
        return plainCallableResultType(value, target, captures, anonymous)
      })
    }
  }
  return false
}

fn plainCallableResultType(value: &Type, target: &[u8], captures: usize, anonymous: bool) -> bool {
  if let Type.CallableValue {application, captures: fields, ..} = &value.* {
    if Vector.length<Shared<Type>>(&fields) != captures { return false }
    return Shared.with<SpecializationApplication, bool>(&application,
      fn(selected: &SpecializationApplication) -> bool {
        let identity = SpecializationApplication.bodyDeclaration(selected)
        if anonymous { return DeclarationId.kind(identity) == OwnerKind.Anonymous }
        return DeclarationId.named(identity, target)
      })
  }
  return false
}

test effect fn plainCallableOriginsUnifyAcrossProducers() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run plainCallableOriginIdentityClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableOriginIdentityClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("plain-callable-origin.silk")
  let text = """
fn original(value: i32) -> i32 { return value }
fn different(value: i32) -> i32 { return value + 1 }
fn first() -> fn<'static>(i32) -> i32 { return original }
fn second() -> fn<'static>(i32) -> i32 { return original }
fn other() -> fn<'static>(i32) -> i32 { return different }
fn same<F>(left: F, right: F) -> i32 { drop left drop right return 42 }
fn main() -> i32 { return same(first(), second()) + same(first(), original) }
fn mismatch() -> i32 { return same(first(), other()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let accepted = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let mismatch = run Semantic.demandBody(&mut store, &mut request, &id, b"mismatch")
  run Testing.expect(succeeded(&accepted),
    "equal original environments unify across two producers and a directly named value")
  run Testing.expect(rejectsSpan(&mismatch, RejectionCode.TypeMismatch, text, "other()", usize.ONE),
    "equal public contracts cannot unify different original callable targets")
}

test effect fn plainCallableViewsKeepWeakerInvocationPermissions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run plainCallableViewPermissionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableViewPermissionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("plain-callable-view.silk")
  let text = """
fn inc2(value: i32) -> i32 { return value + 2 }
fn returnedOnce() -> once fn<'static>(i32) -> i32 { return inc2 }
fn useShared<F: fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(40) }
fn main() -> i32 { let taken = returnedOnce() return taken(40) }
fn denied() -> i32 { let refused = returnedOnce() return useShared(move refused) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&body, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    run Testing.expect(Shared.with<TypedBody, bool>(&value, plainReturnedOnceView),
      "the returned value retains Once permissions over its original Shared storage")
  } else { run Testing.expect(false, "the weaker public view has a checked body") }
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"returnedOnce")
  run Testing.expect(succeeded(&entry) && plainCallableMirResult(&store, &producer, b"inc2", usize.ZERO, false),
    "source consuming permission retains the original Shared named target ABI")
  let denied = run Semantic.demandBody(&mut store, &mut request, &id, b"denied")
  run Testing.expect(rejectsSpan(&denied, RejectionCode.TypeArgumentInference, text, "useShared(move refused)", usize.ZERO),
    "a public Once result cannot gain Shared permission from its capable hidden target")
}

fn plainReturnedOnceView(body: &TypedBody) -> bool {
  let locals = TypedBody.localSlice(body)
  if locals.length != usize.ONE { return false }
  return Shared.with<Type, bool>(&locals[usize.ZERO].ty, plainOnceViewType)
}

fn plainOnceViewType(value: &Type) -> bool {
  if let Type.CallableView {representation, contract} = &value.* {
    return Shared.with<Type, bool>(&contract, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Callable {mode, ..} => mode == CallableMode.Once _ => false }
    }) && Shared.with<Type, bool>(&representation, plainSharedOriginType)
  }
  return false
}

fn plainSharedOriginType(ty: &Type) -> bool {
  if let Type.CallableValue {contract, ..} = &ty.* {
    return Shared.with<Type, bool>(&contract,
      fn(source: &Type) -> bool { return match &source.* { Type.Callable {mode, ..} => mode == CallableMode.Shared _ => false } })
  }
  return false
}


test effect fn plainCallableViewStagingRetainsPublicModeAndArgumentOrder() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run plainCallableViewStagingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableViewStagingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("plain-callable-view-staging.silk")
  let text = """
fn add3(first: i32, middle: i32, last: i32) -> i32 { return first + middle + last }
fn make() -> once fn<'static>(i32, i32, i32) -> i32 { return add3 }
fn useShared<F: fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(1) }
fn main() -> i32 { let staged = make()(2, 3) return staged(1) }
fn denied() -> i32 { let refused = make()(2, 3) return useShared(move refused) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&body, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    run Testing.expect(Shared.with<TypedBody, bool>(&value, plainStagedOnceView),
      "staging retains the public Once promise over Shared physical storage and ordered supplied fields")
  } else { run Testing.expect(false, "the returned view staging control has a checked body") }
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && plainStagedOriginalCall(&store, &entry),
    "the original target receives the invocation argument followed by stored fields zero and one")
  let denied = run Semantic.demandBody(&mut store, &mut request, &id, b"denied")
  run Testing.expect(rejectsSpan(&denied, RejectionCode.TypeArgumentInference, text, "useShared(move refused)", usize.ZERO),
    "staging cannot strengthen a returned Once promise to Shared")
}

fn plainStagedOnceView(body: &TypedBody) -> bool {
  let locals = TypedBody.localSlice(body)
  if locals.length != usize.ONE { return false }
  return Shared.with<Type, bool>(&locals[usize.ZERO].ty, plainStagedOnceType)
}

fn plainStagedOnceType(value: &Type) -> bool {
  if !plainOnceViewType(value) { return false }
  if let Type.CallableView {representation, ..} = &value.* {
    return Shared.with<Type, bool>(&representation, plainStagedOriginalFields)
  }
  return false
}

fn plainStagedOriginalFields(value: &Type) -> bool {
  if let Type.CallableValue {captures, fieldInputs, ..} = &value.* {
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    return Vector.length<Shared<Type>>(&captures) == 2 && inputs.length == 2
      && genericStagingInput(&inputs[usize.ZERO], usize.ONE)
      && genericStagingInput(&inputs[usize.ONE], 2)
  }
  return false
}

fn plainStagedOriginalCall(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let original = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"add3") })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if original && operands.length == 3 {
            return sectionStoredField(&operands[usize.ONE], usize.ZERO)
              && sectionStoredField(&operands[2], usize.ONE)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}


test effect fn plainCallableResultsFromStoredProducersAndMethodsUseOriginalTargets() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run plainCallableProducerCallClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableProducerCallClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("plain-callable-producer-calls.silk")
  let text = """
fn inc2(value: i32) -> i32 { return value + 2 }
fn add(value: i32, offset: i32) -> i32 { return value + offset }
fn named() -> fn<'static>(i32) -> i32 { return inc2 }
fn buildSection(ignored: i32, offset: i32) -> fn<'static>(i32) -> i32 { return add(offset) }
struct Factory { offset: i32 }
impl Factory {
  fn build(self: &Factory) -> fn<'static>(i32) -> i32 { return add(self.offset) }
}
fn main() -> i32 {
  let producer = named
  let selected = producer()
  let sectionProducer = buildSection(2)
  let sectionResult = sectionProducer(0)
  let factory = Factory { offset: 2 }
  let methodResult = factory.build()
  return selected(10) + sectionResult(10) + methodResult(10) + named()(4)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && sectionInvocationCount(&store, &entry, b"add", false) == 2,
    "stored named and section producers and an inherent method return their original direct environments")
  let section = run Semantic.demandMir(&mut store, &mut request, &id, b"buildSection")
  run Testing.expect(plainCallableMirResult(&store, &section, b"add", usize.ONE, false),
    "invoking a producer section uses the same original result storage as its definition")
}

test effect fn plainOnceCallableReturnsTransferCaptureCleanupExactlyOnce() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run plainCallableReturnCleanupClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableReturnCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("plain-callable-return-cleanup.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn consume(amount: i32, token: Token) -> i32 { drop token return amount }
fn make(token: Token) -> once fn<'static>(i32) -> i32 { return consume(move token) }
fn main() -> i32 { let operation = make(Token { value: 42 }) return operation(42) }
fn abandoned() -> i32 { let unused = make(Token { value: 42 }) return 42 }
fn invalid(token: Token) -> once fn<'static>(i32) -> i32 {
  let owned = consume(move token)
  return owned
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"make")
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let target = run Semantic.demandMir(&mut store, &mut request, &id, b"consume")
  let abandoned = run Semantic.demandMir(&mut store, &mut request, &id, b"abandoned")
  run Testing.expect(succeeded(&producer) && succeeded(&entry) && succeeded(&target) && succeeded(&abandoned)
    && sectionInvocationCount(&store, &entry, b"consume", true) == usize.ONE,
    "a returned affine environment retains original storage through transfer, invocation and abandonment")
  run Testing.expect(glueFact(&store, &producer, usize.ZERO) == usize.ZERO
    && glueFact(&store, &entry, usize.ZERO) == usize.ZERO
    && glueFact(&store, &target, usize.ZERO) == usize.ONE
    && glueFact(&store, &abandoned, usize.ZERO) == usize.ONE,
    "producer and invoking caller relinquish cleanup while the target or unused caller owns it once")
  if let Option<Shared<Type>>.Some {value} = move plainCallableMirResultType(&store, &producer) {
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &value)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ONE,
      "the returned environment glue drops its stored capture through ordinary exact child glue")
    let mut members = Vector.make<Shared<Type>>()
    run Vector.append<Shared<Type>>(&mut members, Shared.clone<Type>(&value))
    run Vector.append<Shared<Type>>(&mut members, run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"i32")}))
    let unionType = run Shared.make<Type>(Type.Union {members: move members})
    let unionGlue = run Semantic.demandGlueMir(&mut store, &mut request, &unionType)
    run Testing.expect(succeeded(&unionGlue) && run callableUnionGlueSelectsCapturedMember(&store, &unionGlue, &value, &unionType),
      "a callable union drops only its active captured environment through that environment's exact glue")
  } else { run Testing.expect(false, "the plain producer has an exact physical result") }
  let invalid = run Semantic.demandBody(&mut store, &mut request, &id, b"invalid")
  run Testing.expect(rejectsSpan(&invalid, RejectionCode.ExplicitMoveRequired, text, "owned", usize.ONE),
    "a plain return cannot copy a locally owned affine environment (OWN0003)")
}

fn plainCallableMirResultType(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&function.result))
    }
  }
  return Option.none<Shared<Type>>()
}


