//! Where each declaration of a module starts in its source, kept from one build to the next.
//!
//! # When to use
//! A build with line tables emits markers whose lines are counted from the first token of their
//! function's declaration (`SourceLocations.relativePlace`), so a function that only moved keeps
//! its MIR, its text and its place in a pack. Whoever writes the line tables then needs the place
//! that token has now: its origin. [`Origins`] answers that for any declaration of a module from
//! a table made once from the module's parsed source, and a cache keeps the tables
//! ([`Origins.encode`]) so a later build asks about a module it never parses.
//!
//! # Details
//! A table belongs to one module at one source digest. A build that finds the module's bytes read
//! otherwise makes the table again from its parse, which an edited module has anyway. A
//! declaration is named by `DeclarationId.hash`, which reads its module and owner chain and no
//! position. A literal's origin is that of the named declaration whose anchor it uses.
//!
//! Every word is big-endian and every byte run is length-delimited, as `StableKey` reads them.
//! Malformed bytes decode to no tables.

import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {ModuleId}
import semantic.RuntimeEncoding as Encoding
import semantic.StableKey
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.num.u64
import silk.num.usize

// Changes whenever the layout below changes.
const FORMAT: u64 = 1

/// The origins of one module's declarations, as its source read at `source`.
pub struct ModuleOrigins {
  pub module: ModuleId,
  /// The digest of the module's bytes the table was made from.
  pub source: ContentHash,
  // Each declaration's `DeclarationId.hash` and, beside it, the place (`line << 24 | column`) of
  // the first token of its anchor declaration.
  keys: List<u64>,
  places: List<u64>,
  lookup: InternIndex,
  // Whether a build asked about the module since the tables were decoded.
  used: bool,
  // The round ([`Origins.begin`]) the table was last found to be the module's current one in.
  round: u64,
}

impl ModuleOrigins {
  /// A table with no declaration yet, for [`ModuleOrigins.add`] to fill.
  pub fn make(module: ModuleId, source: ContentHash) -> ModuleOrigins {
    return ModuleOrigins {module: move module, source: source, keys: List<u64>.make(), places: List<u64>.make(),
      lookup: InternIndex.make(), used: true, round: 0}
  }

  /// Adds the declaration whose `DeclarationId.hash` is `key`, which starts at `place`.
  pub effect fn add(self: &mut Self, key: u64, place: u64) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<u64>.append(&mut self.keys, key)
    run List<u64>.append(&mut self.places, place)
    return run InternIndex.record(&mut self.lookup, key)
  }

  /// The origin of the declaration whose `DeclarationId.hash` is `key`, or zero when the module
  /// declares none.
  pub fn find(self: &Self, key: u64) -> u64 {
    let at = InternIndex.first(&self.lookup, key)
    if at == usize.MAX { return 0 }
    return List<u64>.get(&self.places, at)
  }
}

/// The tables of the modules a build's definitions belong to.
pub struct Origins {
  modules: List<ModuleOrigins>,
  lookup: InternIndex,
  // Whether a table was made or replaced since the tables were decoded.
  dirty: bool,
  // Counts the assemblies that asked, so each compares a module's bytes once.
  round: u64,
}

impl Origins {
  pub fn make() -> Origins {
    return Origins {modules: List<ModuleOrigins>.make(), lookup: InternIndex.make(), dirty: false, round: 0}
  }

  /// The position of `module`'s table, or `usize.MAX` when there is none.
  pub fn position(self: &Self, module: &ModuleId) -> usize {
    let listed = List<ModuleOrigins>.asSlice(&self.modules)
    let mut at = InternIndex.first(&self.lookup, ModuleId.hash(module))
    while at != usize.MAX {
      if ModuleId.equals(&listed[at].module, module) { return at }
      at = InternIndex.after(&self.lookup, at)
    }
    return usize.MAX
  }

  /// Starts a round of questions: one assembly's. Within it a module's table is compared with the
  /// module's bytes once ([`Origins.confirm`]).
  pub fn begin(self: &mut Self) -> () {
    self.round = self.round + 1
    return ()
  }

  /// The position of `module`'s table when this round confirmed or placed it, else `usize.MAX`.
  pub fn current(self: &Self, module: &ModuleId) -> usize {
    let found = Origins.position(self, module)
    if found != usize.MAX && List<ModuleOrigins>.asSlice(&self.modules)[found].round == self.round { return found }
    return usize.MAX
  }

  /// Whether the table at `position` was made from bytes whose digest is `source`, which then
  /// makes it current for this round.
  pub fn confirm(self: &mut Self, position: usize, source: ContentHash) -> bool {
    let listed = List<ModuleOrigins>.asMutSlice(&mut self.modules)
    if !ContentHash.equals(listed[position].source, source) { return false }
    listed[position].used = true
    listed[position].round = self.round
    return true
  }

  /// The origin of the declaration whose `DeclarationId.hash` is `key` in the table at
  /// `position`, or zero when its module declares none.
  pub fn find(self: &Self, position: usize, key: u64) -> u64 {
    return ModuleOrigins.find(&List<ModuleOrigins>.asSlice(&self.modules)[position], key)
  }

  /// Keeps `table` as its module's, in place of any earlier one, and answers its position.
  pub effect fn place(self: &mut Self, table: ModuleOrigins) -> usize ! OutOfMemoryError ? &mut Allocator {
    self.dirty = true
    let mut table = move table
    table.round = self.round
    let found = Origins.position(&self.*, &table.module)
    if found != usize.MAX {
      let listed = List<ModuleOrigins>.asMutSlice(&mut self.modules)
      listed[found] = move table
      return found
    }
    let hash = ModuleId.hash(&table.module)
    run List<ModuleOrigins>.append(&mut self.modules, move table)
    run InternIndex.record(&mut self.lookup, hash)
    return List<ModuleOrigins>.length(&self.modules) - usize.ONE
  }

  /// Whether a table was made or replaced since [`Origins.decode`], so a cache should store
  /// [`Origins.encode`] again.
  pub fn changed(self: &Self) -> bool { return self.dirty }

  /// The tables as bytes [`Origins.decode`] reads back. A table no build asked about since it was
  /// decoded is left out: its module is no longer built here.
  pub effect fn encode(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let listed = List<ModuleOrigins>.asSlice(&self.modules)
    let mut kept: u64 = 0
    let mut at = usize.ZERO
    while at < listed.length {
      if listed[at].used { kept = kept + 1 }
      at = at + usize.ONE
    }
    let mut output = Bytes.make()
    run Encoding.word(&mut output, FORMAT)
    run Encoding.word(&mut output, kept)
    at = usize.ZERO
    while at < listed.length {
      let table = &listed[at]
      at = at + usize.ONE
      if !table.used { continue }
      let mut named = Bytes.make()
      run StableKey.module(&mut named, &table.module)
      run Encoding.field(&mut output, Bytes.asSlice(&named))
      run Encoding.word(&mut output, table.source.high)
      run Encoding.word(&mut output, table.source.low)
      let keys = List<u64>.asSlice(&table.keys)
      let places = List<u64>.asSlice(&table.places)
      run Encoding.word(&mut output, usize.toU64(keys.length))
      let mut each = usize.ZERO
      while each < keys.length {
        run Encoding.word(&mut output, keys[each])
        run Encoding.word(&mut output, places[each])
        each = each + usize.ONE
      }
    }
    return move output
  }

  /// The tables [`Origins.encode`] wrote into `bytes`, or none when the bytes are not that.
  pub effect fn decode(bytes: &[u8]) -> Origins ! OutOfMemoryError ? &mut Allocator {
    let mut origins = Origins.make()
    let mut reader = StableKey.reader()
    if StableKey.readWord(bytes, &mut reader) != FORMAT { return Origins.make() }
    let count = StableKey.readWord(bytes, &mut reader)
    if StableKey.failed(&reader) || count > usize.toU64(bytes.length) { return Origins.make() }
    let mut at: u64 = 0
    while at < count {
      let named = StableKey.readField(bytes, &mut reader)
      let high = StableKey.readWord(bytes, &mut reader)
      let low = StableKey.readWord(bytes, &mut reader)
      let declared = StableKey.readWord(bytes, &mut reader)
      if StableKey.failed(&reader) || declared > usize.toU64(bytes.length) { return Origins.make() }
      let mut inner = StableKey.reader()
      let spelled = StableKey.view(bytes, named)
      let module = match move run StableKey.readModule(spelled, &mut inner) {
        Option<ModuleId>.Some {value} => move value
        Option<ModuleId>.None => { return Origins.make() }
      }
      if !StableKey.finished(spelled, &inner) { return Origins.make() }
      let mut table = ModuleOrigins.make(move module, ContentHash {high: high, low: low})
      table.used = false
      let mut each: u64 = 0
      while each < declared {
        let key = StableKey.readWord(bytes, &mut reader)
        let place = StableKey.readWord(bytes, &mut reader)
        if StableKey.failed(&reader) { return Origins.make() }
        run ModuleOrigins.add(&mut table, key, place)
        each = each + 1
      }
      drop run Origins.place(&mut origins, move table)
      at = at + 1
    }
    if !StableKey.finished(bytes, &reader) { return Origins.make() }
    origins.dirty = false
    return move origins
  }
}
