effect fn opaqueCallableRecordRoleClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-callable-record-roles.silk")
  let text = """
struct Wrap<T: once fn<'static>() -> i32> { callback: T }
fn rawOnce(callback: once fn<'static>() -> i32) -> some<F: once fn<'static>() -> i32> Wrap<F> {
  return Wrap { callback: move callback }
}
fn rawMutable(callback: mut fn<'static>() -> i32) -> some<F: once fn<'static>() -> i32> Wrap<F> {
  return Wrap { callback: move callback }
}
fn authored<F: once fn<'static>() -> i32>(callback: F) -> some<H: once fn<'static>() -> i32> Wrap<H> {
  return Wrap { callback: move callback }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let onceAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"rawOnce")
  let mutable = run Semantic.demandBody(&mut store, &mut request, &id, b"rawMutable")
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"authored")
  run Testing.expect(rejectsSpan(&onceAnswer, RejectionCode.UnknownOwnedCallableReturn, text, "Wrap { callback: move callback }", usize.ZERO)
    && rejectsSpan(&mutable, RejectionCode.UnknownOwnedCallableReturn, text, "Wrap { callback: move callback }", usize.ONE),
    "a record cannot establish an owned opaque family from a generated raw Once or Mutable parameter")
  run Testing.expect(succeeded(&owned), "an authored constrained F retains ownership through an inferred record field")
}

test effect fn opaqueCallableRecordsTransferExactCaptureGlue() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueCallableRecordGlueClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn opaqueCallableRecordGlueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-callable-record-glue.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Wrap<T: once fn<'static>(i32) -> i32> { callback: T }
fn consume(value: i32, token: Token) -> i32 { return value + token.value }
fn make(token: Token) -> some<F: once fn<'static>(i32) -> i32> Wrap<F> {
  return Wrap { callback: consume(move token) }
}
fn abandon() -> i32 {
  let unused = make(Token { value: 42 })
  return 42
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let maker = run Semantic.demandMir(&mut store, &mut request, &id, b"make")
  let abandon = run Semantic.demandMir(&mut store, &mut request, &id, b"abandon")
  let record = plainCallableMirResultType(&store, &maker)
  let storage = match move record {
    Option<Shared<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the record producer has exact physical storage") return () }
  }
  let field = Shared.with<Type, Option<Shared<Type>>>(&storage, opaqueRecordCallback)
  let environment = match move field {
    Option<Shared<Type>>.Some {value} => move value
    _ => { run Testing.expect(false, "the record's field has its original environment") return () }
  }
  run Testing.expect(succeeded(&maker) && glueFact(&store, &maker, usize.ZERO) == usize.ZERO
    && succeeded(&abandon) && glueFact(&store, &abandon, usize.ZERO) == usize.ONE
    && run higherOrderAbandonDropUsesEnvironment(&store, &abandon, &storage),
    "construction transfers the capture and abandonment names the exact record glue once")
  let recordGlue = run Semantic.demandGlueMir(&mut store, &mut request, &storage)
  run Testing.expect(succeeded(&recordGlue) && glueFact(&store, &recordGlue, usize.ZERO) == usize.ONE
    && run opaqueRecordDropUsesField(&store, &recordGlue, &environment),
    "record glue drops field zero through the original exact environment's glue")
  let captureGlue = run Semantic.demandGlueMir(&mut store, &mut request, &environment)
  run Testing.expect(succeeded(&captureGlue) && glueFact(&store, &captureGlue, usize.ZERO) == usize.ONE,
    "the field environment drops its moved Token capture once")
}

effect fn opaqueRecordDropUsesField(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, environment: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut item = usize.ZERO
        while item < statements.length {
          if let MirStatement.Drop {destination, glue, ..} = &statements[item] {
            let target = InstanceKey.glueType(&glue)
            if let Option<Shared<Type>>.Some {value} = move target {
              if run Type.equalsShared(&value, environment) {
                return destination.local == usize.ONE && opaqueRecordGluePath(&destination.projections)
              }
            }
          }
          item = item + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn opaqueRecordGluePath(projections: &Vector<MirProjection>) -> bool {
  if Vector.length<MirProjection>(projections) != 2 || lastProjectionCode(projections) != usize.ZERO { return false }
  let path = Vector.asSlice<MirProjection>(projections)
  return match &path[usize.ZERO] { MirProjection.Deref => true _ => false }
}

