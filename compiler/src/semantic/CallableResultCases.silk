test effect fn interfaceCallableWitnessEvidenceRetainsOriginalSlots() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run interfaceCallableWitnessClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn interfaceCallableWitnessClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("interface-callable-evidence.silk")
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"producer")), occurrence: usize.ZERO})
  let owner = DeclarationId.fromParts(run ModuleId.copy(&id), move owners)
  let leaf = run specializationRepresentation(&owner)
  let contract = match move run Type.copy(&leaf) { Type.CallableValue {contract, ..} => move contract
    _ => { run Testing.expect(false, "the actor leaf has a callable contract") return () } }
  let provider = run Shared.make<Type>(Type.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: 3})
  let region = run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: 7})
  let mut bindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut bindings, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: 5, value: Argument.Lifetime {value: Shared.clone<Lifetime>(&region)}})
  let mut rowParameters = Vector.make<RowParameter>()
  run Vector.append<RowParameter>(&mut rowParameters, RowParameter {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)), ordinal: 11})
  run Vector.append<Binding>(&mut bindings, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: 13, value: Argument.Row {value: run Shared.make<Row>(Row {entries: Vector.make<Requirement>(), parameters: move rowParameters})}})
  let mut arguments = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut arguments, Shared.clone<Type>(&provider))
  let mut loans = Vector.make<WitnessLoan>()
  run Vector.append<WitnessLoan>(&mut loans, WitnessLoan {region: Option.some<Shared<Lifetime>>(run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: 9}))})
  let recipe = run Shared.make<Type>(Type.CallableWitnessResult {witness: run Shared.make<WitnessRecipe>(WitnessRecipe {
    operation: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)), contract: run Shared.make<Type>(Type.Unit),
    provider: move provider, result: move contract, bindings: run Shared.make<Vector<Binding>>(move bindings),
    arguments: run Shared.make<Vector<Shared<Type>>>(move arguments), loans: run Shared.make<Vector<WitnessLoan>>(move loans)})})
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(&recipe, &owner, &mut types, &mut lifetimes, &mut rows)
  run Testing.expect(Type.containsCallableWitness(&recipe) && Vector.length<usize>(&types) == usize.ONE
    && Vector.get<usize>(&types, usize.ZERO) == 3 && Vector.length<usize>(&lifetimes) == 2
    && Vector.get<usize>(&lifetimes, usize.ZERO) == 7 && Vector.get<usize>(&lifetimes, usize.ONE) == 9 && Vector.length<usize>(&rows) == usize.ONE
    && Vector.get<usize>(&rows, usize.ZERO) == 11, "free provider and selected/transport lifetime evidence retain sparse owner ordinals")
  let mut substituted = Vector.make<Binding>()
  run Vector.append<Binding>(&mut substituted, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: 3, value: Argument.Type {value: run specializationPrimitive(b"i32")}})
  run Vector.append<Binding>(&mut substituted, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: 7, value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)}})
  run Vector.append<Binding>(&mut substituted, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: 9, value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)}})
  run Vector.append<Binding>(&mut substituted, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: 11, value: Argument.Row {value: run Shared.make<Row>(Row {entries: Vector.make<Requirement>(), parameters: Vector.make<RowParameter>()})}})
  let closed = run Type.applyBindings(&recipe, Vector.asSlice<Binding>(&substituted), true)
  let copied = run Shared.make<Type>(run Type.copy(&closed))
  run Testing.expect(!Type.hasOpenParameters(&closed) && (run Type.equalsShared(&closed, &copied))
    && !(run Type.equalsShared(&recipe, &closed)), "copy preserves source evidence and substitution closes free values")
  let snapshot = match move run Type.copy(&closed) { Type.CallableWitnessResult {witness} => Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
    _ => { run Testing.expect(false, "substitution retains the source-only recipe variant") return () } }
  let binding = CallableWitness.bindingAt(&snapshot, usize.ZERO)
  run Testing.expect(binding.ordinal == 5 && Shared.with<DeclarationId, bool>(&binding.declaration,
    fn(declaration: &DeclarationId) -> bool { return DeclarationId.equals(declaration, &owner) }),
    "substitution rewrites assignment values without renumbering the original operation slots")
  let loanRegion = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&owner), ordinal: 12})
  let distinctLoan = run interfaceWitnessWithLoan(&closed, Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&loanRegion)))
  let noLoan = run interfaceWitnessWithLoan(&closed, Option.none<Shared<Lifetime>>())
  run Testing.expect(!(run Type.equalsShared(&closed, &distinctLoan)) && (run Type.runtimeEqualsShared(&closed, &distinctLoan))
    && !(run Type.equalsShared(&closed, &noLoan)),
    "loan-only lifetime values and optional presence are independently exact source evidence")
  let firstOpen = run interfaceWitnessWithLoan(&recipe, Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&loanRegion)))
  let secondRegion = run Shared.make<Lifetime>(Lifetime.Local {declaration: run DeclarationId.copy(&owner), ordinal: 14})
  let secondOpen = run interfaceWitnessWithLoan(&recipe, Option.some<Shared<Lifetime>>(Shared.clone<Lifetime>(&secondRegion)))
  let openOrigins = [Shared.clone<Type>(&firstOpen), Shared.clone<Type>(&secondOpen)]
  let pending = run CallableOrigin.common(&openOrigins)
  run Testing.expect(!(run Type.equalsShared(&firstOpen, &secondOpen))
    && match &pending { Option<Shared<Type>>.Some {..} => true _ => false },
    "pending environment comparison separates transient Local transport without changing ordinary equality")
  let otherClosed = run interfaceWitnessWithLoan(&closed, Option.some<Shared<Lifetime>>(move secondRegion))
  let closedOrigins = [Shared.clone<Type>(&distinctLoan), move otherClosed]
  let rejected = run CallableOrigin.common(&closedOrigins)
  run Testing.expect(match &rejected { Option<Shared<Type>>.None => true _ => false },
    "closed witness equations never use pending transport equivalence")
  let firstSchema = run interfaceWitnessSchema(&owner, &firstOpen, run Shared.make<Lifetime>(Lifetime.Static))
  let secondSchema = run interfaceWitnessSchema(&owner, &secondOpen, run Shared.make<Lifetime>(Lifetime.Local {
    declaration: run DeclarationId.copy(&owner), ordinal: 19}))
  let headers = run Type.comparisonChildren(&firstSchema, &secondSchema)
  let schemaOrigins = [move firstSchema, move secondSchema]
  let differentSchema = run CallableOrigin.common(&schemaOrigins)
  run Testing.expect(match &headers { Option<Vector<ComparisonChild>>.None => true _ => false }
    && match &differentSchema { Option<Shared<Type>>.None => true _ => false },
    "pending free child comparison cannot bypass a schema's exact selected lifetime header")
  let callable = run CallableContract.ofType(&closed)
  run Testing.expect(match &callable { Option<CallableContract.CallableContract>.Some {..} => true _ => false },
    "source contract consumers see the recipe's public invocation permission")
}

effect fn interfaceWitnessWithLoan(value: &Shared<Type>, loan: Option<Shared<Lifetime>>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let original = match move run Type.copy(value) {
    Type.CallableWitnessResult {witness} => Shared.with<WitnessRecipe, WitnessRecipe>(&witness, CallableWitness.copy)
    _ => { return Shared.clone<Type>(value) }
  }
  let mut loans = Vector.make<WitnessLoan>()
  run Vector.append<WitnessLoan>(&mut loans, WitnessLoan {region: move loan})
  return run Shared.make<Type>(Type.CallableWitnessResult {witness: run Shared.make<WitnessRecipe>(WitnessRecipe {
    operation: move original.operation, contract: move original.contract, provider: move original.provider, result: move original.result,
    bindings: move original.bindings, arguments: move original.arguments, loans: run Shared.make<Vector<WitnessLoan>>(move loans)})})
}

effect fn interfaceWitnessSchema(owner: &DeclarationId, capture: &Shared<Type>, region: Shared<Lifetime>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let leaf = run specializationRepresentation(owner)
  let contract = match move run Type.copy(&leaf) { Type.CallableValue {contract, ..} => move contract _ => { return Shared.clone<Type>(capture) } }
  let mut selected = Vector.make<Binding>()
  run Vector.append<Binding>(&mut selected, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(owner)),
    ordinal: 5, value: Argument.Lifetime {value: move region}})
  let schema = run Shared.make<SectionSchema>(SectionSchema {target: run Shared.make<DeclarationId>(run DeclarationId.copy(owner)),
    contract: move contract, selected: move selected, deferred: Vector.make<usize>()})
  let mut captures = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut captures, Shared.clone<Type>(capture))
  let mut inputs = Vector.make<CallableFieldInput>()
  run Vector.append<CallableFieldInput>(&mut inputs, CallableFieldInput.Argument {parameter: usize.ZERO})
  return run Type.callableSchema(move schema, move captures, move inputs)
}

test effect fn interfaceCallableResultsRetainWitnessBorrowRegions() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run interfaceCallableBorrowClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn interfaceCallableBorrowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("interface-callable-witness-borrow.silk")
  let text = """
interface Factory { fn make(self: Self) -> fn<'static>(i32) -> i32 }
struct Marker {}
impl Copy for Marker {}
fn add(value: i32) -> i32 { return value + 2 }
impl Factory for Marker { fn make(self: &Self) -> fn<'static>(i32) -> i32 { return add } }
fn through<T: Factory + Copy>(provider: T) -> fn<'static>(i32) -> i32 { return provider.make() }
fn main() -> i32 { return through(Marker {})(40) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && originalCallableInvocationCount(&store, &entry, b"add", usize.ONE) == usize.ONE,
    "a borrowed implementation receiver still reveals the original returned callable")
  let application = match move namedMirApplication(&store, &entry, b"through") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { run Testing.expect(false, "the borrowed producer has an original application") return () }
  }
  let symbolic = run Semantic.demandBody(&mut store, &mut request, &id, b"through")
  let typed = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&symbolic, checkedBody)
  let syntax = match move typed {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, usize>(&value, interfaceCallableReceiverSyntax)
    _ => usize.MAX
  }
  let producer = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&producer, selectedMirIndex)
  let mut loan = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      loan = interfaceCallableBorrowTarget(function, SpecializationApplication.bodyDeclaration(&application), syntax)
        && interfaceCallableBorrowTemporary(function)
    }
  }
  run Testing.expect(succeeded(&producer) && loan,
    "the witnessed implementation's original lifetime slot receives the actual through operand region")
}
fn interfaceCallableBorrowTarget(value: &MirFunction, caller: &DeclarationId, syntax: usize) -> bool {
  let references = Vector.asSlice<MirReference>(&value.references)
  let mut at = usize.ZERO
  while at < references.length {
    let selected = InstanceKey.application(&references[at].key)
    if let Option<Shared<SpecializationApplication>>.Some {value: application} = move selected {
      if Shared.with<SpecializationApplication, bool>(&application,
        fn(target: &SpecializationApplication) -> bool { return interfaceCallableBorrowApplication(target, caller, syntax) }) { return true }
    }
    at = at + usize.ONE
  }
  return false
}
fn interfaceCallableBorrowApplication(value: &SpecializationApplication, caller: &DeclarationId, syntax: usize) -> bool {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"make") { return false }
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Lifetime {value: region} = &arguments[at] {
      if Shared.with<Lifetime, bool>(&region,
        fn(lifetime: &Lifetime) -> bool { return interfaceCallableThroughLoan(lifetime, caller, syntax) }) { return true }
    }
    at = at + usize.ONE
  }
  return false
}
fn interfaceCallableThroughLoan(value: &Lifetime, caller: &DeclarationId, syntax: usize) -> bool {
  if let Lifetime.Local {declaration, ordinal} = &value.* { return ordinal == syntax && syntax != usize.MAX && DeclarationId.equals(&declaration, caller) }
  return false
}

fn interfaceCallableReceiverSyntax(value: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(value)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {arguments, ..}, ..} = &nodes[at].kind {
      let listed = Vector.asSlice<BodyNodeId>(&arguments)
      if listed.length != usize.ZERO { return nodes[listed[usize.ZERO].index].origin.syntax.index }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}
fn interfaceCallableBorrowTemporary(value: &MirFunction) -> bool {
  let blocks = Vector.asSlice<MirBlock>(&value.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {value: MirRvalue.Ref {place, ..}, ..} = &statements[position] {
        if Vector.length<MirProjection>(&place.projections) == usize.ZERO
          && higherOrderTemporaryParameter(value, at, place.local, usize.ZERO) { return true }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn interfaceCallableResultsReplayOwnedTransportReturns() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run interfaceCallableOwnedReturnClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn interfaceCallableOwnedReturnClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("interface-callable-owned-returns.silk")
  let text = """
interface Factory { fn make(value: Self) -> fn<'static>(i32) -> i32 }
fn add(value: i32) -> i32 { return value + 2 }
impl Factory for i32 { fn make(value: Self) -> fn<'static>(i32) -> i32 { return add } }
fn choose<P: Factory + Copy>(provider: P, flag: bool) -> fn<'static>(i32) -> i32 {
  if flag { return Factory.make(provider) }
  return Factory.make(provider)
}
fn main() -> i32 { return choose(0, true)(40) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && originalCallableInvocationCount(&store, &entry, b"add", usize.ONE) == usize.ONE,
    "strict source replay retains both owned-operation transport equations before exact selected leaf agreement")
}
