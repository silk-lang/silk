struct Wrap<F: fn<'static>(i32) -> i32> { callback: F }
fn factory() -> some<F: fn<'static>(i32) -> i32> Wrap<F> { return .{ callback: leaf } }
fn main() -> i32 { let value = factory() return value.callback(40) }
"""
  return run contextualOpaqueStorageClaims("contextual-opaque-record.silk", text, OwnerKind.Struct) |> Effect.provideMut<Allocator>(&mut allocator)
}

