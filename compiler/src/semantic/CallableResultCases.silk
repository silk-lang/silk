test effect fn finiteCallableOriginsTraverseUnionFreeChannelsAndMergeEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteCallableGraphActorClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn finiteCallableGraphActorClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("finite-callable-graph-actor.silk")
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"producer")), occurrence: usize.ZERO})
  let owner = run DeclarationId.fromParts(run ModuleId.copy(&id), move owners)
  let leaf = run specializationRepresentation(&owner)
  let contract = match move run Type.copy(&leaf) {
    Type.CallableValue {contract, ..} => move contract
    _ => { run Testing.expect(false, "the actor leaf has a checked public contract") return () }
  }
  let inner = run Shared.make<SpecializationApplication>(run specializationWithArguments(&owner, Vector.make<Argument>()))
  let edge = run Shared.make<Type>(Type.CallableOrigin {application: Shared.clone<SpecializationApplication>(&inner), contract: Shared.clone<Type>(&contract)})
  let mut arguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut arguments, Argument.Type {value: move edge})
  let outer = run Shared.make<SpecializationApplication>(run specializationWithArguments(&owner, move arguments))
  let wrapper = run Shared.make<Type>(Type.CallableOrigin {application: Shared.clone<SpecializationApplication>(&outer), contract: Shared.clone<Type>(&contract)})
  let mut members = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut members, Shared.clone<Type>(&wrapper))
  run Vector.append<Shared<Type>>(&mut members, run specializationPrimitive(b"i32"))
  let unionType = run Shared.make<Type>(Type.Union {members: move members})
  let edges = run Type.callableOriginApplications(&unionType)
  let listed = Vector.asSlice<Shared<SpecializationApplication>>(&edges)
  run Testing.expect(listed.length == 2, "both outer and nested original producer edges are discovered")
  let first = run SpecializationApplication.copyShared(&listed[usize.ZERO])
  let second = run SpecializationApplication.copyShared(&listed[usize.ONE])
  let wantedOuter = run SpecializationApplication.copyShared(&outer)
  let wantedInner = run SpecializationApplication.copyShared(&inner)
  run Testing.expect(Type.containsCallableOrigin(&unionType) && listed.length == 2
    && (run SpecializationApplication.equals(&first, &wantedOuter))
    && (run SpecializationApplication.equals(&second, &wantedInner)),
    "union discovery descends beneath a Forward application's free channels without erasing exact keys")
  let mut producers = Vector.make<CallableOrigin.Producer>()
  let firstProducer = run finiteCallableActorProducer(&inner, &contract, &leaf, &wrapper)
  let secondProducer = run finiteCallableActorProducer(&inner, &contract, &leaf, &unionType)
  let firstAdded = run CallableOrigin.appendProducer(&mut producers, move firstProducer)
  let secondAdded = run CallableOrigin.appendProducer(&mut producers, move secondProducer)
  let values = Vector.asSlice<CallableOrigin.Producer>(&producers)
  run Testing.expect(firstAdded && secondAdded && values.length == usize.ONE, "canonical producers converge to one exact entry")
  run Testing.expect(Vector.length<Shared<Type>>(&values[usize.ZERO].returns) == 2
    && Vector.length<Shared<Type>>(&values[usize.ZERO].demands) == 2,
    "one canonical producer retains both source returns and independent validation dependencies")
}
effect fn finiteCallableActorProducer(application: &Shared<SpecializationApplication>, contract: &Shared<Type>,
  returned: &Shared<Type>, demanded: &Shared<Type>) -> CallableOrigin.Producer ! OutOfMemoryError ? &mut Allocator {
  let mut returns = Vector.make<Shared<Type>>()
  let mut demands = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut returns, Shared.clone<Type>(returned))
  run Vector.append<Shared<Type>>(&mut demands, Shared.clone<Type>(demanded))
  return CallableOrigin.Producer {application: Shared.clone<SpecializationApplication>(application),
    contract: Shared.clone<Type>(contract), returns: move returns, demands: move demands}
}

test effect fn finiteCallableOriginsPublishCanonicalRootWithoutChangingRequest() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteCallableRootClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn finiteCallableRootClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("finite-callable-root.silk")
  let text = """
fn leaf() -> i32 { return 42 }
fn factory() -> fn<'static>() -> i32 { return leaf }
fn pass(callback: fn<'static>() -> i32) -> fn<'static>() -> i32 { return callback }
fn main() -> i32 { return pass(leaf)() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let selected = namedMirApplication(&store, &entry, b"pass")
  let mut application = match move selected {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { run Testing.expect(false, "the checked pass call retains its complete original application") return () }
  }
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"factory")), occurrence: usize.ZERO})
  let producer = run DeclarationId.fromParts(run ModuleId.copy(&id), move owners)
  let leafEnvironment = run specializationRepresentation(&producer)
  let contract = match move run Type.copy(&leafEnvironment) {
    Type.CallableValue {contract, ..} => move contract
    _ => { run Testing.expect(false, "the result recipe has an authored callable contract") return () }
  }
  let sourceContract = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()}),
    invocationBinders: usize.ZERO, invocationUse: usize.MAX, invocationBounds: Vector.make<Outlives>(),
    parameters: Vector.make<Shared<Type>>(), result: Shared.clone<Type>(&contract)})
  let producerValue = run Type.callableValue(true,
    run Shared.make<SpecializationApplication>(run specializationWithArguments(&producer, Vector.make<Argument>())),
    move sourceContract, Vector.make<Shared<Type>>(), Vector.make<CallableFieldInput>())
  let recipe = run Shared.make<Type>(Type.CallableResult {producer: move producerValue, contract: move contract,
    arguments: Vector.make<Shared<Type>>(), selected: Vector.make<Argument>(), selectedOrdinals: Vector.make<usize>()})
  let mut slots = Vector.asMutSlice<Argument>(&mut application.arguments)
  run Testing.expect(slots.length == usize.ONE, "the selected source representation keeps its original one-slot schema")
  slots[usize.ZERO] = Argument.Type {value: Shared.clone<Type>(&recipe)}
  let result = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
  let storage = plainCallableMirResultType(&store, &result)
  let originalLeaf = match move storage {
    Option<Shared<Type>>.Some {value} => finiteCallableLeaf(&value)
    _ => false
  }
  run Testing.expect(originalLeaf, "the canonical root solution is published under an immutable recipe-bearing request")
  let original = Vector.asSlice<Argument>(&application.arguments)
  let preserved = match &original[usize.ZERO] {
    Argument.Type {value} => run Type.equalsShared(&value, &recipe)
    _ => false
  }
  run Testing.expect(preserved, "normalization leaves the requested complete source application unchanged")
}

test effect fn finiteCallableOriginsReplayAuthoredParameterIdentity() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteCallableParameterClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn finiteCallableParameterClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("finite-callable-authored-parameter.silk")
  let text = """
fn leaf() -> i32 { return 42 }
fn same<H: fn<'static>() -> i32>(first: H, second: H) -> i32 { return first() + second() }
fn relay<F: fn<'static>() -> i32>(callback: F, depth: i32) -> fn<'static>() -> i32 {
  if depth == 0 { return callback }
  let next = relay(callback, depth - 1)
  let ignored = same(callback, next)
  return callback
}
fn main() -> i32 { return relay(leaf, 0)() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && originalCallableInvocationCount(&store, &entry, b"leaf", usize.ZERO) == usize.ONE,
    "symbolic and selected replay preserve a callable parameter's original identity across recursion")
}

