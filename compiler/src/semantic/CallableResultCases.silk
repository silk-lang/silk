effect fn contextualOpaqueStorageClaims(path: string, text: string, kind: OwnerKind) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module(path)
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let factory = run Semantic.demandMir(&mut store, &mut request, &id, b"factory")
  let result = plainCallableMirResultType(&store, &factory)
  let destination = higherOrderCallResultType(&store, &entry, b"factory")
  let mut exact = false
  if let Option<Shared<Type>>.Some {value: returned} = move result {
    let named = Shared.with<Type, bool>(&returned, fn(value: &Type) -> bool {
      return match &value.* { Type.Nominal {declaration, ..} => DeclarationId.kind(&declaration) == kind && DeclarationId.named(&declaration, b"Wrap") _ => false }
    })
    let callback = Shared.with<Type, Option<Shared<Type>>>(&returned, opaqueRecordCallback)
    if let Option<Shared<Type>>.Some {value} = move callback {
      if let Option<Shared<Type>>.Some {value: received} = move destination {
        exact = named && Shared.with<Type, bool>(&value, contextualOpaqueLeaf) && (run Type.equalsShared(&returned, &received))
      }
    }
  }
  run Testing.expect(succeeded(&entry) && succeeded(&factory) && exact
    && originalCallableInvocationCount(&store, &entry, b"leaf", usize.ONE) == usize.ONE,
    "the contextual nominal result contains the original leaf and reaches its direct target without a descriptor or adapter")
}
fn contextualOpaqueLeaf(value: &Type) -> bool { return anonymousNamedRepresentation(value, b"leaf") }

fn contextualOpaqueOuter(value: &Type) -> bool {
  if let Type.Nominal {declaration, arguments, ..} = &value.* {
    let slots = Vector.asSlice<Argument>(&arguments)
    if !DeclarationId.named(&declaration, b"Outer") || slots.length != 2 { return false }
    let inner = contextualOpaqueArgument(&slots[usize.ZERO], contextualOpaqueInner)
    let fixed = contextualOpaqueArgument(&slots[usize.ONE], contextualOpaqueU8)
    return inner && fixed
  }
  return false
}
fn contextualOpaqueInner(value: &Type) -> bool {
  if let Type.Nominal {declaration, arguments, ..} = &value.* {
    let slots = Vector.asSlice<Argument>(&arguments)
    return DeclarationId.named(&declaration, b"Inner") && slots.length == usize.ONE
      && contextualOpaqueArgument(&slots[usize.ZERO], contextualOpaqueLeaf)
  }
  return false
}
fn contextualOpaqueArgument(value: &Argument, predicate: fn<'static>(&Type) -> bool) -> bool {
  return match &value.* { Argument.Type {value: ty} => Shared.with<Type, bool>(&ty, predicate) _ => false }
}
fn contextualOpaqueU8(value: &Type) -> bool {
  return match &value.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"u8") _ => false }
}

test effect fn contextualOpaqueNestedFieldsKeepSourceShapeAndWrittenOrder() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run contextualOpaqueNestedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn contextualOpaqueNestedClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("contextual-opaque-nested.silk")
  let text = """
fn leaf(value: i32) -> i32 { return value + 2 }
struct Inner<F: fn<'static>(i32) -> i32> { callback: F }
struct Outer<T, S> { marker: S
  inner: T }
fn factory() -> some<F: fn<'static>(i32) -> i32> Outer<Inner<F>, u8> { return .{ inner: .{ callback: leaf }, marker: 1 } }
fn explicitChild() -> some<F: fn<'static>(i32) -> i32> Outer<Inner<F>, u8> { return .{ inner: Inner { callback: leaf }, marker: 1 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let factory = run Semantic.demandBody(&mut store, &mut request, &id, b"factory")
  let explicit = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitChild")
  let result = higherOrderSourceReturnType(&factory)
  let other = higherOrderSourceReturnType(&explicit)
  let mut exact = false
  if let Option<Shared<Type>>.Some {value} = move result {
    if let Option<Shared<Type>>.Some {value: nonliteral} = move other {
      exact = Shared.with<Type, bool>(&value, contextualOpaqueOuter) && (run Type.equalsShared(&value, &nonliteral))
    }
  }
  run Testing.expect(succeeded(&factory) && succeeded(&explicit) && exact && contextualOpaqueFieldOrder(&factory),
    "nested literals retain Inner's shape and fixed u8; explicit children keep ordinary inference; fields evaluate in written order")
}
fn contextualOpaqueFieldOrder(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    return Shared.with<TypedBody, bool>(&value, contextualOpaqueFieldOrderBody)
  }
  return false
}
fn contextualOpaqueFieldOrderBody(body: &TypedBody) -> bool {
  let returned = higherOrderSourceReturnIndex(body)
  let nodes = TypedBody.nodeSlice(body)
  if returned >= nodes.length { return false }
  if let BodyNodeKind.Expression {form: BodyExpression.Aggregate {fields}, ..} = &nodes[returned].kind {
    let operands = Vector.asSlice<BodyAggregateField>(&fields)
    if operands.length != 2 || operands[usize.ZERO].index != usize.ONE || operands[usize.ONE].index != usize.ZERO { return false }
    let innerNode = operands[usize.ZERO].value.index
    let markerNode = operands[usize.ONE].value.index
    if innerNode >= nodes.length || markerNode >= nodes.length || innerNode >= markerNode { return false }
    return contextualOpaqueBodyNode(&nodes[innerNode], contextualOpaqueInner) && contextualOpaqueBodyNode(&nodes[markerNode], contextualOpaqueU8)
  }
  return false
}
fn contextualOpaqueBodyNode(node: &BodyNode, predicate: fn<'static>(&Type) -> bool) -> bool {
  return match &node.kind { BodyNodeKind.Expression {ty, ..} => Shared.with<Type, bool>(&ty, predicate) _ => false }
}


test effect fn contextualOpaqueConstructionPreservesContractsAndAuthority() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run contextualOpaqueRejectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn contextualOpaqueRejectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("contextual-opaque-rejections.silk")
  let text = """
fn leaf(value: i32) -> i32 { return value + 2 }
fn other(value: i32) -> i32 { return value + 3 }
fn wrong(value: bool) -> bool { return value }
struct Wrap<F: fn<'static>(i32) -> i32> { callback: F }
struct Pair<A: fn<'static>(i32) -> i32, B: fn<'static>(i32) -> i32> { first: A
  second: B }
fn invalidContract() -> some<F: fn<'static>(i32) -> i32> Wrap<F> { return .{ callback: wrong } }
fn repeatedFamily() -> some<F: fn<'static>(i32) -> i32> Pair<F, F> { return .{ first: leaf, second: other } }
fn ordinaryAssignment(flag: bool) -> some<F: fn<'static>(i32) -> i32> Wrap<F> {
  if flag { return .{ callback: leaf } }
  let mut saved = ordinaryAssignment(true)
  saved = .{ callback: other }
  return move saved
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidContract")
  let repeated = run Semantic.demandMir(&mut store, &mut request, &id, b"repeatedFamily")
  let assignment = run Semantic.demandBody(&mut store, &mut request, &id, b"ordinaryAssignment")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.IncompatibleCallableSignature, text, ".{ callback: wrong }", usize.ZERO),
    "contextual construction proves the original callback's authored contract")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.DivergentOpaqueRealization, text, "some<F: fn<'static>(i32) -> i32> Pair<F, F>", usize.ZERO),
    "equal callable signatures cannot select two original families for one opaque slot")
  run Testing.expect(rejectsSpan(&assignment, RejectionCode.TypeMismatch, text, "other", 2),
    "ordinary assignment cannot acquire producer construction permission or replace a selected family")
}


test effect fn namedLifetimeSectionsSelectOriginalTargetAtInvocation() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run namedLifetimeSectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn namedLifetimeSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("named-lifetime-section.silk")
  let text = """
fn combine(input: &i32, left: i32, right: i32) -> i32 { return input.* + left + right }
fn main() -> i32 {
  let suffix = combine(2)
  let staged = suffix(20)
  let input = 20
  let first = staged(&input)
  let other = 10
  return first + staged(&other)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  let typed = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&source, checkedBody)
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(&entry, selectedMirIndex)
  let mut original = false
  let mut shared = false
  if let Option<Shared<TypedBody>>.Some {value: body} = move typed {
    if let Option<usize>.Some {value: index} = move selected {
      if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
        original = Shared.with<TypedBody, bool>(&body,
          fn(value: &TypedBody) -> bool { return namedLifetimeSectionMir(function, value) })
        let keys = run namedSectionCombineKeys(function)
        let listed = Vector.asSlice<InstanceKey>(&keys)
        if listed.length == 2 { shared = run InstanceKey.sameApplication(&listed[usize.ZERO], &listed[usize.ONE]) }
      }
    }
  }
  run Testing.expect(succeeded(&entry) && original,
    "two staged invocations lend distinct caller call loans as Borrow arguments, and append left/right from stored fields 1/0")
  run Testing.expect(shared,
    "both staged invocations select one canonical combine instance whose loan is its first caller region")
}
struct NamedSectionInvocationSite {
  syntax: usize
  borrowSyntax: usize
  argument: Shared<Type>
}
fn namedLifetimeInvocationAt(body: &TypedBody, wanted: usize) -> Option<NamedSectionInvocationSite> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  let mut found = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.CallableCall {arguments, ..}, ..} = &nodes[at].kind {
      let listed = Vector.asSlice<BodyNodeId>(&arguments)
      if listed.length == usize.ONE && listed[usize.ZERO].index < nodes.length {
        let argument = &nodes[listed[usize.ZERO].index]
        if let BodyNodeKind.Expression {form: BodyExpression.Borrow {..}, ty} = &argument.kind {
          if found == wanted { return Option.some<NamedSectionInvocationSite>(NamedSectionInvocationSite {
            syntax: nodes[at].origin.syntax.index, borrowSyntax: argument.origin.syntax.index, argument: Shared.clone<Type>(&ty)}) }
          found = found + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return Option.none<NamedSectionInvocationSite>()
}
fn namedSectionCallLoan(site: &NamedSectionInvocationSite, caller: &DeclarationId) -> bool {
  return Shared.with<Type, bool>(&site.argument,
    fn(value: &Type) -> bool { return namedSectionLoanType(value, caller, site.syntax) })
}
fn namedSectionLoanType(value: &Type, caller: &DeclarationId, syntax: usize) -> bool {
  if let Type.Reference {lifetime, ..} = &value.* {
    return Shared.with<Lifetime, bool>(&lifetime,
      fn(region: &Lifetime) -> bool { return callerCallLoan(region, caller, syntax) })
  }
  return false
}
fn namedLifetimeSectionMir(function: &MirFunction, body: &TypedBody) -> bool {
  let first = match move namedLifetimeInvocationAt(body, usize.ZERO) { Option<NamedSectionInvocationSite>.Some {value} => move value _ => { return false } }
  let second = match move namedLifetimeInvocationAt(body, usize.ONE) { Option<NamedSectionInvocationSite>.Some {value} => move value _ => { return false } }
  if first.syntax == second.syntax || first.borrowSyntax == second.borrowSyntax
    || !namedSectionCallLoan(&first, TypedBody.declarationId(body)) || !namedSectionCallLoan(&second, TypedBody.declarationId(body)) { return false }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  let mut count = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
      if let Option<Shared<SpecializationApplication>>.Some {value: application} = move InstanceKey.application(&key) {
        let selected = Shared.with<SpecializationApplication, bool>(&application,
          fn(value: &SpecializationApplication) -> bool { return DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"combine") })
        if selected {
          if !Shared.with<SpecializationApplication, bool>(&application, namedSectionInvocationLifetime) { return false }
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if operands.length != 3 { return false }
          if let MirOperand.Copy {place: left} = &operands[usize.ONE] {
            if let MirOperand.Copy {place: right} = &operands[2] {
              if left.local != right.local || !namedSectionCaptureField(&left, usize.ONE) || !namedSectionCaptureField(&right, usize.ZERO) { return false }
            } else { return false }
          } else { return false }
          count = count + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return count == 2
}
fn namedSectionCaptureField(place: &MirPlace, field: usize) -> bool {
  let projections = Vector.asSlice<MirProjection>(&place.projections)
  if projections.length != usize.ONE { return false }
  return match &projections[usize.ZERO] { MirProjection.Field {index} => index == field _ => false }
}
// Each canonical `combine` instance numbers its caller call loan as its first caller region.
fn namedSectionInvocationLifetime(application: &SpecializationApplication) -> bool {
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  let ordinals = Vector.asSlice<usize>(&application.argumentOrdinals)
  if arguments.length != usize.ONE || ordinals.length != usize.ONE || ordinals[usize.ZERO] != usize.ZERO { return false }
  return match &arguments[usize.ZERO] {
    Argument.Lifetime {value} => Shared.with<Lifetime, bool>(&value, firstCallerRegion)
    _ => false
  }
}
// The instance key of every MIR call to `combine`, in block order.
effect fn namedSectionCombineKeys(function: &MirFunction) -> Vector<InstanceKey> ! OutOfMemoryError ? &mut Allocator {
  let mut keys = Vector.make<InstanceKey>()
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
      let identity = InstanceKey.identity(&key)
      if Shared.with<DeclarationId, bool>(&identity, fn(found: &DeclarationId) -> bool { return DeclarationId.named(found, b"combine") }) {
        run Vector.append<InstanceKey>(&mut keys, InstanceKey.copy(&key))
      }
    }
    at = at + usize.ONE
  }
  return move keys
}

// Quantified admission must reach the original invocation recipe, not merely a comparison view.
test effect fn quantifiedNamedCallbacksRetainTheirInvocationRecipes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run quantifiedNamedCallbackClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn quantifiedNamedCallbackClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("quantified-named-callbacks.silk")
  let text = """
fn read(value: &i32) -> i32 { return value.* }
struct Reader {}
impl Reader { fn probe(value: &i32) -> i32 { return value.* } }
fn combine(input: &i32, left: i32, right: i32) -> i32 { return input.* + left + right }
fn twice<F: for<'a> fn<'static>(&'a i32) -> i32>(callback: F) -> i32 {
  let first = 20
  let left = callback(&first)
  let second = 10
  return left + callback(&second)
}
fn named() -> i32 { return twice(read) }
fn qualified() -> i32 { return twice(Reader.probe) }
fn staged() -> i32 { let suffix = combine(2) let saved = suffix(20) return twice(saved) }
fn mixed<T, 'a>(input: &'a i32, suffix: T) -> i32 { drop suffix return input.* }
fn mixedStaged() -> i32 { let saved = mixed(20) return twice(saved) }
fn onceApply(callback: for<'a> once fn<'static>(&'a i32) -> i32) -> i32 {
  let value = 1
  return callback(&value)
}
fn onceNamed() -> i32 { return onceApply(read) }
fn fixed(value: &'static i32) -> i32 { return value.* }
fn bounded<'a: 'static>(value: &'a i32) -> i32 { return value.* }
fn safe(callback: for<'a> fn<'static>(&'a i32) -> i32) -> () { drop callback }
fn fixedRejected() -> () { safe(fixed) }
fn boundRejected() -> () { safe(bounded) }
fn ordered<'a: 'b, 'b>(first: &'a i32, second: &'b i32) -> i32 { return first.* + second.* }
fn boundGiven(callback: for<'a: 'b, 'b> fn<'static>(&'a i32, &'b i32) -> i32) -> () { drop callback }
fn boundAbsent(callback: for<'a, 'b> fn<'static>(&'a i32, &'b i32) -> i32) -> () { drop callback }
fn boundReversed(callback: for<'a, 'b: 'a> fn<'static>(&'a i32, &'b i32) -> i32) -> () { drop callback }
fn correctBound() -> () { boundGiven(ordered) }
fn missingBound() -> () { boundAbsent(ordered) }
fn reversedBound() -> () { boundReversed(ordered) }
fn exclusive(value: &mut i32) -> i32 { return value.* }
fn unsigned(callback: for<'a> fn<'static>(&'a mut u32) -> i32) -> () { drop callback }
fn exclusiveRejected() -> () { unsigned(exclusive) }
fn exclusiveStatic(value: &mut &'static i32) -> i32 { return value.*.* }
fn exclusiveBorrowed(callback: for<'a, 'b: 'a> fn<'static>(&'a mut &'b i32) -> i32) -> () { drop callback }
fn invariantRejected() -> () { exclusiveBorrowed(exclusiveStatic) }
unsafe fn unchecked(value: &i32) -> i32 { return value.* }
fn unsafeRejected() -> () { safe(unchecked) }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn consuming(input: &i32, stored: Token) -> i32 { drop stored return input.* }
fn modeRejected() -> () { let section = consuming(Token { value: 1 }) safe(move section) }
fn generic<T>(value: T) -> i32 { drop value return 1 }
fn embeddedRejected() -> () { safe(generic) }
fn lending<'env, 'call>(input: &'call i32, captured: &'env i32) -> i32 { return input.* + captured.* }
fn environmentRejected<'env>(captured: &'env i32) -> () { let retained = lending(captured) safe(retained) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let named = run Semantic.demandMir(&mut store, &mut request, &id, b"named")
  let qualified = run Semantic.demandMir(&mut store, &mut request, &id, b"qualified")
  let staged = run Semantic.demandMir(&mut store, &mut request, &id, b"staged")
  let namedRecipe = run quantifiedNamedRecipe(&mut store, &mut request, &named, b"read", false)
  let qualifiedRecipe = run quantifiedNamedRecipe(&mut store, &mut request, &qualified, b"probe", false)
  let stagedRecipe = run quantifiedNamedRecipe(&mut store, &mut request, &staged, b"combine", true)
  let mixed = run Semantic.demandMir(&mut store, &mut request, &id, b"mixedStaged")
  let mixedRecipe = run quantifiedNamedRecipe(&mut store, &mut request, &mixed, b"mixed", true)
  run Testing.expect(succeeded(&named) && namedRecipe && succeeded(&qualified) && qualifiedRecipe,
    "bare and namespace callbacks retain the original lifetime ordinal and two independent invocation loans through concrete consumer MIR")
  run Testing.expect(succeeded(&staged) && stagedRecipe,
    "quantified staged admission preserves deferred slot 0, capture inputs 2/1, direct target calls and stored field order 1/0")
  run Testing.expect(succeeded(&mixed) && mixedRecipe,
    "a mixed target retains selected type slot 0 and deferred lifetime slot 1 even though the promised invocation binder is 0")
  let onceResult = run Semantic.demandMir(&mut store, &mut request, &id, b"onceNamed")
  let onceStorage = run quantifiedOnceStorage(&mut store, &mut request, &onceResult)
  let supplied = run Semantic.demandBody(&mut store, &mut request, &id, b"correctBound")
  run Testing.expect(succeeded(&onceResult) && onceStorage && succeeded(&supplied),
    "a shared callback supports once use, and an authored directed promise bound proves the target's corresponding obligation")
  let fixed = run Semantic.demandBody(&mut store, &mut request, &id, b"fixedRejected")
  let bounded = run Semantic.demandBody(&mut store, &mut request, &id, b"boundRejected")
  let missing = run Semantic.demandBody(&mut store, &mut request, &id, b"missingBound")
  let reversed = run Semantic.demandBody(&mut store, &mut request, &id, b"reversedBound")
  run Testing.expect(rejectsSpan(&fixed, RejectionCode.IncompatibleCallableSignature, text, "fixed", 2),
    "an authored static input cannot become universally callable over arbitrary invocation regions")
  run Testing.expect(rejectsSpan(&bounded, RejectionCode.Unsupported, text, "bounded", usize.ONE)
    && rejectsSpan(&missing, RejectionCode.Unsupported, text, "ordered", 2)
    && rejectsSpan(&reversed, RejectionCode.Unsupported, text, "ordered", 3),
    "unproved target obligations retain an Unsupported result; missing and reversed premises cannot admit a callback")
  let exclusive = run Semantic.demandBody(&mut store, &mut request, &id, b"exclusiveRejected")
  let invariant = run Semantic.demandBody(&mut store, &mut request, &id, b"invariantRejected")
  let unsafeValue = run Semantic.demandBody(&mut store, &mut request, &id, b"unsafeRejected")
  let mode = run Semantic.demandBody(&mut store, &mut request, &id, b"modeRejected")
  let embedded = run Semantic.demandBody(&mut store, &mut request, &id, b"embeddedRejected")
  run Testing.expect(rejectsSpan(&exclusive, RejectionCode.IncompatibleCallableSignature, text, "exclusive", 2)
    && rejectsSpan(&unsafeValue, RejectionCode.IncompatibleCallableSignature, text, "unchecked", usize.ONE)
    && rejectsSpan(&mode, RejectionCode.IncompatibleCallableSignature, text, "move section", usize.ZERO),
    "quantified admission preserves exclusive contents, unsafe authority and captured once storage mode")
  run Testing.expect(rejectsSpan(&invariant, RejectionCode.IncompatibleCallableSignature, text, "exclusiveStatic", usize.ONE),
    "an authored inner static lifetime remains fixed under a quantified exclusive input")
  run Testing.expect(rejectsSpan(&embedded, RejectionCode.Unsupported, text, "generic", usize.ONE),
    "a deferred type binding cannot embed private invocation regions without an invocation recipe proof")
  let environment = run Semantic.demandBody(&mut store, &mut request, &id, b"environmentRejected")
  run Testing.expect(rejectsSpan(&environment, RejectionCode.UnsatisfiedLifetimeBound, text, "retained", usize.ONE),
    "a retained local capture environment cannot satisfy a static quantified promise")

}

effect fn quantifiedNamedRecipe(store: &mut Semantic, request: &mut Request,
  entry: &Shared<Result<Answer, NoRejection>>, target: &[u8], captured: bool) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let application = match move namedMirApplication(&store.*, entry, b"twice") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if captured {
    let representation = match move SpecializationApplication.typeAt(&application, usize.ZERO) {
      Option<Shared<Type>>.Some {value} => move value _ => { return false }
    }
    let retained = Shared.with<Type, bool>(&representation,
      fn(value: &Type) -> bool {
        if sameBytes(target, b"mixed") { return quantifiedMixedRepresentation(value) }
        return quantifiedStagedRepresentation(value)
      })
    if !retained { return false }
  }
  let selected = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &application)
  let source = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &application)
  let body = match move Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&source, checkedBody) {
    Option<Shared<TypedBody>>.Some {value} => move value _ => { return false }
  }
  let index = match move Shared.with<Result<Answer, NoRejection>, Option<usize>>(&selected, selectedMirIndex) {
    Option<usize>.Some {value} => value _ => { return false }
  }
  let valid = match move Semantic.mirAt(&store.*, index) {
    Option<&MirFunction>.Some {value: function} => Shared.with<TypedBody, bool>(&body,
      fn(value: &TypedBody) -> bool { return quantifiedNamedMir(function, value, target, captured) })
    _ => false
  }
  if !valid { return false }
  let callback = match move namedMirApplication(&store.*, &selected, target) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let invoked = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &callback)
  return succeeded(&invoked)
}
fn quantifiedNamedMir(function: &MirFunction, body: &TypedBody, target: &[u8], captured: bool) -> bool {
  if captured && !sameBytes(target, b"mixed") {
    if !namedLifetimeSectionMir(function, body) { return false }
  }
  let first = match move namedLifetimeInvocationAt(body, usize.ZERO) { Option<NamedSectionInvocationSite>.Some {value} => move value _ => { return false } }
  let second = match move namedLifetimeInvocationAt(body, usize.ONE) { Option<NamedSectionInvocationSite>.Some {value} => move value _ => { return false } }
  if first.syntax == second.syntax || first.borrowSyntax == second.borrowSyntax
    || !namedSectionCallLoan(&first, TypedBody.declarationId(body)) || !namedSectionCallLoan(&second, TypedBody.declarationId(body)) { return false }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut count = usize.ZERO
  let mut firstLocal = usize.MAX
  let mut secondLocal = usize.MAX
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, origin, ..} = &blocks[at].terminator {
      if let Option<Shared<SpecializationApplication>>.Some {value: application} = move InstanceKey.application(&key) {
        if Shared.with<SpecializationApplication, bool>(&application,
          fn(value: &SpecializationApplication) -> bool { return DeclarationId.named(SpecializationApplication.bodyDeclaration(value), target) }) {
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if operands.length == usize.ZERO { return false }
          if origin.syntax.index == first.syntax {
            if firstLocal != usize.MAX { return false }
            firstLocal = quantifiedBorrowLocal(function, &operands[usize.ZERO], first.borrowSyntax)
            if firstLocal == usize.MAX { return false }
          } else {
            if origin.syntax.index != second.syntax || secondLocal != usize.MAX { return false }
            secondLocal = quantifiedBorrowLocal(function, &operands[usize.ZERO], second.borrowSyntax)
            if secondLocal == usize.MAX { return false }
          }
          if sameBytes(target, b"mixed") {
            if operands.length != 2 || !Shared.with<SpecializationApplication, bool>(&application, quantifiedMixedApplication) { return false }
            if let MirOperand.Copy {place} = &operands[usize.ONE] {
              if !namedSectionCaptureField(&place, usize.ZERO) { return false }
            } else { return false }
          } else {
            let mut expected = usize.ONE
            if captured { expected = 3 }
            if operands.length != expected || !Shared.with<SpecializationApplication, bool>(&application, namedSectionInvocationLifetime) { return false }
          }
          count = count + usize.ONE
        }
      }
    }
    at = at + usize.ONE
  }
  return count == 2 && firstLocal != usize.MAX && secondLocal != usize.MAX && firstLocal != secondLocal
}
// Borrow lowering allocates the argument temporary at the source Borrow's origin. Its identity
// must match this exact target call; two otherwise valid calls cannot share the first loan.
fn quantifiedBorrowLocal(function: &MirFunction, operand: &MirOperand, borrowSyntax: usize) -> usize {
  if let MirOperand.Copy {place} = &operand.* {
    let locals = Vector.asSlice<MirLocal>(&function.locals)
    if Vector.length<MirProjection>(&place.projections) == usize.ZERO && place.local < locals.length
      && locals[place.local].origin.syntax.index == borrowSyntax { return place.local }
  }
  return usize.MAX
}
fn quantifiedStagedRepresentation(value: &Type) -> bool {
  if let Type.CallableView {representation, ..} = &value.* {
    return Shared.with<Type, bool>(&representation, quantifiedStagedRepresentation)
  }
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if fields.length != 2 || inputs.length != 2
      || !Shared.with<Type, bool>(&fields[usize.ZERO], opaqueUnionI32)
      || !Shared.with<Type, bool>(&fields[usize.ONE], opaqueUnionI32) { return false }
    let first = match &inputs[usize.ZERO] { CallableFieldInput.Argument {parameter} => parameter == 2 _ => false }
    let second = match &inputs[usize.ONE] { CallableFieldInput.Argument {parameter} => parameter == usize.ONE _ => false }
    return first && second && Shared.with<SectionSchema, bool>(&schema, quantifiedStagedSchema)
  }
  return false
}
fn quantifiedStagedSchema(value: &SectionSchema) -> bool {
  let deferred = Vector.asSlice<usize>(&value.deferred)
  return deferred.length == usize.ONE && deferred[usize.ZERO] == usize.ZERO
    && Shared.with<DeclarationId, bool>(&value.target,
      fn(target: &DeclarationId) -> bool { return DeclarationId.named(target, b"combine") })
    && Shared.with<Type, bool>(&value.contract, quantifiedBlueprintUnquantified)
}

fn quantifiedBlueprintUnquantified(value: &Type) -> bool {
  return match &value.* { Type.Callable {invocationBinders, ..} => invocationBinders == usize.ZERO _ => false }
}

effect fn quantifiedOnceStorage(store: &mut Semantic, request: &mut Request,
  entry: &Shared<Result<Answer, NoRejection>>) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator {
  let application = match move namedMirApplication(&store.*, entry, b"onceApply") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  let representation = match move SpecializationApplication.typeAt(&application, usize.ZERO) {
    Option<Shared<Type>>.Some {value} => move value _ => { return false }
  }
  if !Shared.with<Type, bool>(&representation, quantifiedSharedStorage) { return false }
  let selected = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &application)
  if !succeeded(&selected) || originalCallableInvocationCount(&store.*, &selected, b"read", usize.ONE) != usize.ONE { return false }
  let callback = match move namedMirApplication(&store.*, &selected, b"read") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !namedSectionInvocationLifetime(&callback) { return false }
  let implementation = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &callback)
  return succeeded(&implementation)
}
fn quantifiedSharedStorage(value: &Type) -> bool {
  if let Type.CallableView {representation, ..} = &value.* {
    return Shared.with<Type, bool>(&representation, quantifiedSharedStorage)
  }
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    if Vector.length<Shared<Type>>(&captures) != usize.ZERO || Vector.length<CallableFieldInput>(&fieldInputs) != usize.ZERO { return false }
    return Shared.with<SectionSchema, bool>(&schema,
      fn(recipe: &SectionSchema) -> bool { return Shared.with<Type, bool>(&recipe.contract, quantifiedSharedContract) })
  }
  return false
}
fn quantifiedSharedContract(value: &Type) -> bool {
  return match &value.* { Type.Callable {mode, ..} => mode == CallableMode.Shared _ => false }
}

fn quantifiedMixedRepresentation(value: &Type) -> bool {
  if let Type.CallableView {representation, ..} = &value.* {
    return Shared.with<Type, bool>(&representation, quantifiedMixedRepresentation)
  }
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if fields.length != usize.ONE || inputs.length != usize.ONE
      || !Shared.with<Type, bool>(&fields[usize.ZERO], opaqueUnionI32) { return false }
    let position = match &inputs[usize.ZERO] { CallableFieldInput.Argument {parameter} => parameter == usize.ONE _ => false }
    return position && Shared.with<SectionSchema, bool>(&schema, quantifiedMixedSchema)
  }
  return false
}
fn quantifiedMixedSchema(value: &SectionSchema) -> bool {
  let deferred = Vector.asSlice<usize>(&value.deferred)
  let selected = Vector.asSlice<Binding>(&value.selected)
  if deferred.length != usize.ONE || deferred[usize.ZERO] != usize.ONE
    || selected.length != usize.ONE || selected[usize.ZERO].ordinal != usize.ZERO
    || !Shared.with<Type, bool>(&value.contract, quantifiedBlueprintUnquantified) { return false }
  if !Shared.with<DeclarationId, bool>(&value.target,
    fn(target: &DeclarationId) -> bool { return DeclarationId.named(target, b"mixed") }) { return false }
  return match &selected[usize.ZERO].value {
    Argument.Type {value: supplied} => Shared.with<Type, bool>(&supplied, opaqueUnionI32)
    _ => false
  }
}
fn quantifiedMixedApplication(value: &SpecializationApplication) -> bool {
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  let ordinals = Vector.asSlice<usize>(&value.argumentOrdinals)
  if arguments.length != 2 || ordinals.length != 2
    || ordinals[usize.ZERO] != usize.ZERO || ordinals[usize.ONE] != usize.ONE { return false }
  let selected = match &arguments[usize.ZERO] {
    Argument.Type {value: supplied} => Shared.with<Type, bool>(&supplied, opaqueUnionI32) _ => false }
  let region = match &arguments[usize.ONE] {
    Argument.Lifetime {value: supplied} => Shared.with<Lifetime, bool>(&supplied, firstCallerRegion) _ => false }
  return selected && region
}


test effect fn namedLifetimeSectionsKeepEffectProviderBoundary() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run namedLifetimeEffectBoundaryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn namedLifetimeEffectBoundaryClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("named-lifetime-effect-boundary.silk")
  let text = """
import silk.effect {Effect}
fn makeEffect<'life>(input: &'life i32, suffix: i32) -> some<F: Effect<'life; i32>> F {
  return effect { return input.* + suffix }
}
fn withheld() -> i32 { let section = makeEffect(2) return 42 }
fn keepEffect<'life, F: Effect<'static; i32>>(input: &'life i32, value: F) -> F { return move value }
fn keepUnion<'life, F: Effect<'static; i32>>(input: &'life i32, value: F) -> F | i32 { return move value }
fn selectedEffect() -> i32 {
  let literal = effect { return 42 }
  let section = keepEffect(move literal)
  return 42
}
fn selectedUnion() -> i32 {
  let literal = effect { return 42 }
  let section = keepUnion(move literal)
  return 42
}
fn keepUnbounded<'life, F>(input: &'life i32, value: F) -> F { return move value }
fn callerBound<G: Effect<'static; i32>>(value: G) -> i32 {
  let section = keepUnbounded(move value)
  return 42
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"withheld")
  let selected = run Semantic.demandBody(&mut store, &mut request, &id, b"selectedEffect")
  let unionResult = run Semantic.demandBody(&mut store, &mut request, &id, b"selectedUnion")
  let caller = run Semantic.demandBody(&mut store, &mut request, &id, b"callerBound")
  run Testing.expect(rejectsSpan(&body, RejectionCode.Unsupported, text, "makeEffect(2)", usize.ZERO)
    && rejectsSpan(&selected, RejectionCode.Unsupported, text, "keepEffect(move literal)", usize.ZERO)
    && rejectsSpan(&unionResult, RejectionCode.Unsupported, text, "keepUnion(move literal)", usize.ZERO)
    && rejectsSpan(&caller, RejectionCode.Unsupported, text, "keepUnbounded(move value)", usize.ZERO),
    "ordinary lifetime deferral preserves opaque, selected, union-member, and caller-bound Effect result boundaries")
}

test effect fn effectSectionsRunTheirTarget() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectSectionRunClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn effectSectionRunClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-sections.silk")
  let text = """
struct Problem { code: i32 }
effect fn scaled(value: i32, factor: i32) -> i32 ! Problem {
  if factor == 0 { fail Problem { code: value } }
  return value * factor
}
effect fn closed() -> i32 ! Problem { return run 6 |> scaled(7) }
fn addTwo(value: i32) -> i32 { return value + 2 }
effect fn mapped<'env, A, B, E, ?R>(self: once Effect<'env; A ! E ? R>, onSuccess: once fn<'env>(A) -> B) -> B ! E ? R {
  let value = run move self
  return onSuccess(move value)
}
effect fn generic() -> i32 ! Problem { return run scaled(6, 7) |> mapped(addTwo) }
effect fn chained() -> i32 ! Problem { return run scaled(6, 7) |> mapped(addTwo) |> mapped(addTwo) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let closed = run Semantic.demandMir(&mut store, &mut request, &id, b"closed")
  run Testing.expect(succeeded(&closed) && originalCallableInvocationCount(&store, &closed, b"scaled", 2) == usize.ONE,
    "running a closed effect fn section calls its target with the piped operand and the captured suffix")
  let generic = run Semantic.demandMir(&mut store, &mut request, &id, b"generic")
  run Testing.expect(succeeded(&generic) && originalCallableInvocationCount(&store, &generic, b"mapped", 2) == usize.ONE,
    "a generic effect fn section infers its deferred type and row binders from the invocation")
  let chained = run Semantic.demandMir(&mut store, &mut request, &id, b"chained")
  run Testing.expect(succeeded(&chained) && constructedEffectCount(&store, &chained, b"mapped") == usize.ONE
    && originalCallableInvocationCount(&store, &chained, b"mapped", 2) == usize.ONE,
    "a section invoked without run constructs its target's exact Effect, which only the enclosing run calls")
}

test effect fn effectSectionsNameDeferredRelations() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectSectionDeferralClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn effectSectionDeferralClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-section-deferrals.silk")
  let text = """
fn addTwo(value: i32) -> i32 { return value + 2 }
effect fn read(value: &i32) -> i32 { return value.* }
effect fn mapped<'env, A, B, E, ?R>(self: once Effect<'env; A ! E ? R>, onSuccess: once fn<'env>(A) -> B) -> B ! E ? R {
  let value = run move self
  return onSuccess(move value)
}
fn local() -> i32 {
  let x = 40
  return run read(&x) |> mapped(addTwo)
}
service Clock {}
service Other {}
struct FixedClock { marker: i32 }
impl Clock for FixedClock {}
effect fn now() -> i32 ? &Clock { return 1 }
effect fn provided<'env, ?S, A, P, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: &'env P) -> A ! E ? Without<R, S>
where &'env P provides S from R {
  return run Intrinsic.bindRequirement<S>(move self, provider)
}
fn clocked() -> i32 {
  let clock = FixedClock { marker: 0 }
  return run now() |> provided<Clock>(&clock)
}
service Calendar {}
struct FixedCalendar { marker: i32 }
impl Calendar for FixedCalendar {}
effect fn dated() -> i32 ? &Clock | &Calendar { return 1 }
fn nested() -> i32 {
  let clock = FixedClock { marker: 0 }
  let calendar = FixedCalendar { marker: 0 }
  return run dated() |> provided<Clock>(&clock) |> provided<Calendar>(&calendar)
}
effect fn stamped(value: &i32) -> i32 ? &Clock { return value.* }
fn borrowedClock() -> i32 {
  let clock = FixedClock { marker: 0 }
  let x = 40
  return run stamped(&x) |> provided<Clock>(&clock)
}
effect fn stampedFrom<'p>(value: &'p i32, extra: &i32) -> i32 ? &Clock { return value.* + extra.* }
fn declaredClock<'p>(value: &'p i32) -> i32 {
  let clock = FixedClock { marker: 0 }
  let x = 2
  return run stampedFrom(value, &x) |> provided<Clock>(&clock)
}
effect fn runOnce<'env>(pending: once Effect<'env; i32>) -> i32 { return run move pending }
fn passedOn() -> i32 {
  let clock = FixedClock { marker: 0 }
  let provision = now() |> provided<Clock>(&clock)
  return run runOnce(provision)
}
fn unprovided() -> i32 { return run now() |> mapped(addTwo) }
effect fn keyed<'env, E, ?R>(self: once Effect<'env; i32 ! E ? R>, key: string<'env>) -> i32 ! E ? R { return run move self }
effect fn paired<'env, T, E, ?R>(self: once Effect<'env; i32 ! E ? R>, other: &'env T) -> i32 ! E ? R { return run move self }
effect fn pinned<'env, E, ?R>(self: once Effect<'env; i32 ! E ? R>, key: &mut string<'env>) -> i32 ! E ? R { return run move self }
fn staticKey(value: &i32) -> i32 { return run read(value) |> keyed("x") }
fn declaredPair(value: &i32, other: &i32) -> i32 { return run read(value) |> paired(other) }
fn chainedKey(value: &i32) -> i32 { return run read(value) |> keyed("x") |> keyed("y") }
fn pinnedKey(value: &i32) -> i32 {
  let mut key = "x"
  return run read(value) |> pinned(&mut key)
}
fn selected() -> i32 {
  let clock = FixedClock { marker: 0 }
  return run now() |> provided(&clock)
}
fn absentKey() -> i32 {
  let clock = FixedClock { marker: 0 }
  return run now() |> provided<Other>(&clock)
}
fn unmatched() -> i32 {
  let calendar = FixedCalendar { marker: 0 }
  return run now() |> provided(&calendar)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let local = run Semantic.demandBody(&mut store, &mut request, &id, b"local")
  run Testing.expect(retainsRegionRelation(&local, text, "read(&x) |> mapped(addTwo)", 0),
    "a section environment fixed by a 'static callable and a caller-local Effect relate as an open obligation")
  let clocked = run Semantic.demandMir(&mut store, &mut request, &id, b"clocked")
  run Testing.expect(succeeded(&clocked) && originalCallableInvocationCount(&store, &clocked, b"provided", 2) == usize.ONE,
    "a provision section with a written selector proves its bound once the invocation infers the source row")
  let nested = run Semantic.demandMir(&mut store, &mut request, &id, b"nested")
  run Testing.expect(succeeded(&nested) && constructedEffectCount(&store, &nested, b"provided") == usize.ONE
    && originalCallableInvocationCount(&store, &nested, b"provided", 2) == usize.ONE,
    "a provision section invoked without run constructs the Effect whose remaining row the next provision serves")
  let borrowedClock = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowedClock")
  run Testing.expect(retainsRegionRelation(&borrowedClock, text, "stamped(&x) |> provided<Clock>(&clock)", 0),
    "a provider loan and a distinct caller-local Effect relate as an open obligation that the invocation's bounds assume")
  let borrowedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowedClock")
  run Testing.expect(succeeded(&borrowedMir) && originalCallableInvocationCount(&store, &borrowedMir, b"provided", 2) == usize.ONE,
    "lowering selects the section's application under the relations its operand retained")
  let declaredClock = run Semantic.demandBody(&mut store, &mut request, &id, b"declaredClock")
  run Testing.expect(retainsRegionRelation(&declaredClock, text, "stampedFrom(value, &x) |> provided<Clock>(&clock)", 0),
    "the caller's own lifetime in a piped Effect outlives the provider loan, so only its caller-local loan relates")
  let passedOn = run Semantic.demandMir(&mut store, &mut request, &id, b"passedOn")
  run Testing.expect(succeeded(&passedOn) && constructedEffectCount(&store, &passedOn, b"provided") == usize.ONE,
    "an invoked section's Effect whose stored arguments are Copy is Copy, so passing its place copies the construction")
  let selected = run Semantic.demandMir(&mut store, &mut request, &id, b"selected")
  run Testing.expect(succeeded(&selected) && originalCallableInvocationCount(&store, &selected, b"provided", 2) == usize.ONE,
    "a provision section infers its omitted selector once the invocation infers the source row")
  let unmatched = run Semantic.demandBody(&mut store, &mut request, &id, b"unmatched")
  run Testing.expect(rejectsSpan(&unmatched, RejectionCode.MissingProvidedKey, text, "now() |> provided(&calendar)", 0),
    "an omitted selector the provider serves no entry of the piped Effect's row for is a missing key at the invocation")
  let absentKey = run Semantic.demandBody(&mut store, &mut request, &id, b"absentKey")
  run Testing.expect(rejectsSpan(&absentKey, RejectionCode.MissingProvidedKey, text, "now() |> provided<Other>(&clock)", 0),
    "a written selector absent from the piped Effect's row fails the provides bound at the invocation")
  let unprovided = run Semantic.demandBody(&mut store, &mut request, &id, b"unprovided")
  run Testing.expect(rejectsSpan(&unprovided, RejectionCode.UnhandledRequirement, text, "run now() |> mapped(addTwo)", 0),
    "a generic section invocation closes the inferred requirement row, which the run must cover")
  let staticKey = run Semantic.demandBody(&mut store, &mut request, &id, b"staticKey")
  let declaredPair = run Semantic.demandBody(&mut store, &mut request, &id, b"declaredPair")
  run Testing.expect(succeeded(&staticKey) && succeeded(&declaredPair),
    "a section environment fixed by a 'static or declared operand shortens to the piped Effect's declared region")
  let staticMir = run Semantic.demandMir(&mut store, &mut request, &id, b"staticKey")
  let declaredMir = run Semantic.demandMir(&mut store, &mut request, &id, b"declaredPair")
  let chainedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"chainedKey")
  run Testing.expect(succeeded(&staticMir) && succeeded(&declaredMir) && succeeded(&chainedMir)
    && constructedEffectCount(&store, &chainedMir, b"keyed") == usize.ONE,
    "lowering selects a section's application under its shortened environment binder, including an invoked construction")
  let pinnedKey = run Semantic.demandBody(&mut store, &mut request, &id, b"pinnedKey")
  run Testing.expect(rejectsSpan(&pinnedKey, RejectionCode.TypeArgumentInference, text, "read(value) |> pinned(&mut key)", 0),
    "an environment binder behind an exclusive reference keeps its 'static evidence")
  let nestedId = run module("nested-provisions.silk")
  let nestedText = """
effect fn provided<'env, ?S, A, P, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: &'env P) -> A ! E ? Without<R, S>
where &'env P provides S from R {
  return run Intrinsic.bindRequirement<S>(move self, provider)
}
service Clock {}
service Calendar {}
struct FixedClock { marker: i32 }
struct FixedCalendar { marker: i32 }
impl Clock for FixedClock {}
impl Calendar for FixedCalendar {}
effect fn dated() -> i32 ? &Clock | &Calendar { return 1 }
effect fn inner() -> i32 ? &Clock | &Calendar {
  let clock = FixedClock { marker: 1 }
  let calendar = FixedCalendar { marker: 1 }
  return run dated() |> provided<Clock>(&clock) |> provided<Calendar>(&calendar)
}
pub fn main() -> i32 {
  let clock = FixedClock { marker: 0 }
  let calendar = FixedCalendar { marker: 0 }
  return run inner() |> provided<Clock>(&clock) |> provided<Calendar>(&calendar)
}
"""
  let mut nestedStore = run staticSemantic(&nestedId, nestedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut nestedRequest = Request.make()
  let provisions = run Semantic.buildMain(&mut nestedStore, &mut nestedRequest, &nestedId, staticClosureNodes)
  run Testing.expect(match &provisions { BackendBuild.Module {..} => true _ => false },
    "a provision reached again below an argument-free body is not specialization growth")
}

test effect fn effectSectionsKeepWrittenRegionsAndOwnership() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run effectSectionContractClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn effectSectionContractClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("effect-section-contracts.silk")
  let text = """
effect fn read(value: &i32) -> i32 { return value.* }
effect fn pinned(self: once Effect<'static; i32>, extra: i32) -> i32 { return run move self }
fn written() -> i32 {
  let x = 40
  return run read(&x) |> pinned(2)
}
effect fn peek(value: &i32, extra: i32) -> i32 { return value.* + extra }
effect fn held(self: once Effect<'static; i32>) -> i32 { return run move self }
fn borrowed() -> i32 {
  let y = 40
  return run held(&y |> peek(2))
}
struct Token { value: i32 }
effect fn spend(extra: i32, token: Token) -> i32 { return token.value + extra }
fn twice() -> i32 {
  let pending = spend(Token { value: 40 })
  let first = run pending(1)
  let second = run pending(1)
  return first + second
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"written")
  run Testing.expect(rejectsSpan(&written, RejectionCode.IncompatibleCallableSignature, text, "read(&x)", 0),
    "a written 'static Effect environment rejects a caller-local Effect instead of deferring the region")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  run Testing.expect(rejectsSpan(&borrowed, RejectionCode.Unsupported, text, "peek(2)", 0),
    "a borrowed piped operand stays a deferred section lifetime, so no caller-local region reaches the Effect")
  let twice = run Semantic.demandBody(&mut store, &mut request, &id, b"twice")
  run Testing.expect(rejectsSpan(&twice, RejectionCode.UseAfterMove, text, "pending", 2),
    "a section capturing an affine value constructs its Effect at most once")
}
