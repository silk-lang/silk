    run Testing.expect(succeeded(&target) && originalCallableInvocationCount(&store, &target, b"add", usize.ONE) == usize.ONE,
      "a staged schema producer resolves its original returned leaf before later direct invocation")
  } else { run Testing.expect(false, "the staged schema caller retains its selected application") }
