//! Higher-order callable result selection, exact origins and capture cleanup.

import hir.Hir {CallableMode, OwnerKind}
import backend.InstanceKey {InstanceKey}
import backend.Mir {Reference as MirReference, Callee as MirCallee, Block as MirBlock, Local as MirLocal, LocalKind as MirLocalKind, MirFunction, Projection as MirProjection, Operand as MirOperand, Statement as MirStatement, Terminator as MirTerminator, Rvalue as MirRvalue}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.CallableWitness
import semantic.CallableWitness {CallableWitness as WitnessRecipe, OperandLoan as WitnessLoan}
import semantic.CallableContract
import semantic.CallableOrigin
import semantic.CallableSchema {CallableSchema as SectionSchema}
import semantic.Lifetime {Intersection, Lifetime, Member as LifetimeMember}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Semantic {Answer, Outcome, Semantic, Request, Value}
import semantic.FinalProfile {FinalProfile}
import semantic.SourceIndex {NoRejection, RevisionMismatch}
import semantic.Rejection {Rejection, RejectionCode}
import semantic.SourceRevision {Revision}
import semantic.Specialization {Application as SpecializationApplication, ScopeBinding, StaticSlot, Target as SpecializationTarget}
import semantic.Type {Argument, Binding, Comparison, ComparisonChild, CallableFieldInput, Outlives, Requirement, Row, RowParameter, Type, Unification}
import semantic.Target {Id as TargetId, Target as MachineTarget}
import semantic.TypedBody {Expression as BodyExpression, NodeKind as BodyNodeKind, NodeId as BodyNodeId, TypedBody}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.u8
import silk.usize
import silk.vector {Vector}

effect fn staticSemantic(id: &ModuleId, text: string, target: MachineTarget) -> Semantic
! OutOfMemoryError
? &mut Allocator {
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), id, &source)
  return Semantic.make(move revision, target, Option.none<FinalProfile>())
}

fn rejection(answer: &Result<Answer, NoRejection>) -> Option<Shared<Rejection>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Rejected {diagnostic} => Option.some<Shared<Rejection>>(
        Shared.clone<Rejection>(&diagnostic),
      )
      Outcome.Success {value: _} => Option.none<Shared<Rejection>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Rejection>>()
  }
}

fn checkedBody(answer: &Result<Answer, NoRejection>) -> Option<Shared<TypedBody>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Body {body, source: _}} => Option.some<Shared<TypedBody>>(
        Shared.clone<TypedBody>(&body),
      )
      _ => Option.none<Shared<TypedBody>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<TypedBody>>()
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn module(path: string) -> ModuleId ! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  return run ModuleId.make(b"memory", b"example", String.utf8Bytes(path))
}

effect fn present(text: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return Option.some<Bytes>(run Bytes.copy(String.utf8Bytes(text)))
}

fn offsetOf(text: string, needle: string, occurrence: usize) -> usize {
  let haystack = String.utf8Bytes(text)
  let wanted = String.utf8Bytes(needle)
  let mut seen = usize.ZERO
  let mut at = usize.ZERO
  while at + wanted.length <= haystack.length {
    let mut matched = true
    let mut inner = usize.ZERO
    while inner < wanted.length {
      if haystack[at + inner] != wanted[inner] {
        matched = false
      }
      inner = inner + usize.ONE
    }
    if matched {
      if seen == occurrence {
        return at
      }
      seen = seen + usize.ONE
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

fn rejectsSpan(
  answer: &Shared<Result<Answer, NoRejection>>,
  code: RejectionCode,
  text: string,
  spelling: string,
  occurrence: usize,
) -> bool {
  let start = offsetOf(text, spelling, occurrence)
  if start == usize.MAX { return false }
  let end = start + String.utf8Bytes(spelling).length
  let found = Shared.with<Result<Answer, NoRejection>, Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    return Shared.with<Rejection, bool>(&value, fn(diagnostic: &Rejection) -> bool {
      return diagnostic.code == code && diagnostic.span.start == start && diagnostic.span.end == end
    })
  }
  return false
}

fn succeeded(answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  return Shared.with<Result<Answer, NoRejection>, bool>(
    answer,
    fn(resolved: &Result<Answer, NoRejection>) -> bool {
      return match & resolved.* {
        Result<Answer, NoRejection>.Success {value} => match & value.outcome {
          Outcome.Success {value: Value.Unsupported {..}} => false
          Outcome.Success {value: _} => true
          Outcome.Rejected {diagnostic: _} => false
        }
        Result<Answer, NoRejection>.Failure {error: _} => false
      }
    },
  )
}

fn nominalType(value: &Type) -> bool {
  return match & value.* {
    Type.Nominal {..} => true
    _ => false
  }
}

effect fn specializationWithArguments(declaration: &DeclarationId, arguments: Vector<Argument>) -> SpecializationApplication
! OutOfMemoryError ? &mut Allocator {
  return SpecializationApplication {
    target: SpecializationTarget.Named {declaration: run DeclarationId.copy(declaration)},
    argumentOrdinals: run SpecializationApplication.denseOrdinals(Vector.length<Argument>(&arguments)),
    scopes: Vector.make<ScopeBinding>(),
    arguments: move arguments,
    statics: Vector.make<StaticSlot>(),
  }
}

effect fn specializationPrimitive(name: &[u8]) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(name)})
}

effect fn specializationRepresentation(declaration: &DeclarationId) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator {
  let application = run specializationWithArguments(declaration, Vector.make<Argument>())
  let result = run specializationPrimitive(b"i32")
  let regions = Vector.make<Shared<Lifetime>>()
  let contract = run Shared.make<Type>(Type.Callable {mode: CallableMode.Shared, isUnsafe: false,
    environment: run Shared.make<Intersection>(run Intersection.of(Vector.asSlice<Shared<Lifetime>>(&regions))),
    invocationBinders: usize.ZERO, invocationBounds: Vector.make<Outlives>(),
    parameters: Vector.make<Shared<Type>>(), result: move result})
  return run Type.callableValue(false, run Shared.make<SpecializationApplication>(move application), move contract,
    Vector.make<Shared<Type>>(), Vector.make<CallableFieldInput>())
}

fn selectedMirIndex(answer: &Result<Answer, NoRejection>) -> Option<usize> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.Mir {index}} => Option.some<usize>(index)
      _ => Option.none<usize>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<usize>()
  }
}

fn glueFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if fact == 6 {
        let references = Vector.asSlice<MirReference>(&function.references)
        let mut glued = usize.ZERO
        let mut at = usize.ZERO
        while at < references.length {
          if let Option<Shared<Type>>.Some {..} = move InstanceKey.glueType(&references[at].key) { glued = glued + usize.ONE }
          at = at + usize.ONE
        }
        return glued
      }
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut drops = usize.ZERO
      let mut calls = usize.ZERO
      let mut switches = usize.ZERO
      let mut branches = usize.ZERO
      let mut first = usize.MAX
      let mut second = usize.MAX
      let mut firstCall = usize.MAX
      let mut firstDrop = usize.MAX
      let mut nominalPayload = false
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Drop {destination, ..} = &statements[position] {
            let code = lastProjectionCode(&destination.projections)
            if drops == usize.ZERO {
              first = code
              firstDrop = at
              nominalPayload = nominalPayloadStep(&destination.projections)
            }
            if drops == usize.ONE { second = code }
            drops = drops + usize.ONE
          }
          position = position + usize.ONE
        }
        if let MirTerminator.Call {..} = &blocks[at].terminator {
          if calls == usize.ZERO { firstCall = at }
          calls = calls + usize.ONE
        }
        if let MirTerminator.Switch {..} = &blocks[at].terminator { switches = switches + usize.ONE }
        if let MirTerminator.Branch {..} = &blocks[at].terminator { branches = branches + usize.ONE }
        at = at + usize.ONE
      }
      if fact == usize.ZERO { return drops }
      if fact == usize.ONE { return calls }
      if fact == 2 { return switches }
      if fact == 3 { return first }
      if fact == 4 { return second }
      if fact == 7 {
        if firstCall < firstDrop { return usize.ONE }
        return usize.ZERO
      }
      if fact == 8 {
        if nominalPayload { return usize.ONE }
        return usize.ZERO
      }
      return branches
    }
  }
  return usize.MAX
}

fn nominalPayloadStep(projections: &Vector<MirProjection>) -> bool {
  let listed = Vector.asSlice<MirProjection>(projections)
  if listed.length == usize.ZERO { return false }
  return match &listed[listed.length - usize.ONE] {
    MirProjection.Payload {ty, ..} => Shared.with<Type, bool>(&ty, nominalType)
    _ => false
  }
}

fn lastProjectionCode(projections: &Vector<MirProjection>) -> usize {
  let listed = Vector.asSlice<MirProjection>(projections)
  if listed.length == usize.ZERO { return usize.MAX }
  return match &listed[listed.length - usize.ONE] {
    MirProjection.Field {index} => index
    MirProjection.Index {..} => 1000
    MirProjection.Payload {index, ..} => 2000 + index
    MirProjection.VariantField {variant, field} => 3000 + 10 * variant + field
    _ => usize.MAX - usize.ONE
  }
}

fn sectionStoredField(operand: &MirOperand, field: usize) -> bool {
  if let MirOperand.Copy {place} = &operand.* {
    return Vector.length<MirProjection>(&place.projections) == usize.ONE
      && lastProjectionCode(&place.projections) == field
  }
  return false
}

fn sectionCaptureOperand(operand: &MirOperand, consumes: bool) -> bool {
  if consumes {
    if let MirOperand.Move {place} = &operand.* {
      return Vector.length<MirProjection>(&place.projections) == usize.ONE
        && lastProjectionCode(&place.projections) == usize.ZERO
    }
    return false
  }
  return sectionStoredField(operand, usize.ZERO)
}

fn sectionInvocationCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], consumes: bool) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, target) })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if named && operands.length == 2 && sectionCaptureOperand(&operands[usize.ONE], consumes) { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

fn namedMirApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> Option<Shared<SpecializationApplication>> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: selected} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, selected) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        let identity = InstanceKey.identity(&references[at].key)
        let matches = Shared.with<DeclarationId, bool>(&identity,
          fn(value: &DeclarationId) -> bool { return sameBytes(DeclarationId.spelling(value), name) })
        if matches {
          // Capture glue can share the target's owner identity without being a function application.
          let application = InstanceKey.application(&references[at].key)
          if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
            return Option.some<Shared<SpecializationApplication>>(move value)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}

fn plainCallableMirResultType(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&function.result))
    }
  }
  return Option.none<Shared<Type>>()
}

fn originalCallableInvocationCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], arity: usize) -> usize {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, target) })
          if named && Vector.length<MirOperand>(&arguments) == arity {
            if let Option<Shared<SpecializationApplication>>.Some {..} = move InstanceKey.application(&key) { count = count + usize.ONE }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

test effect fn higherOrderCallableResultsKeepSelectedProducerAndLeafTargets() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run higherOrderCallableTargetClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn higherOrderCallableTargetClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("higher-order-callable-targets.silk")
  let text = """
fn addTwo(value: i32) -> i32 { return value + 2 }
fn addThree(value: i32) -> i32 { return value + 3 }
fn producerTwo() -> fn<'static>(i32) -> i32 { return addTwo }
fn producerThree() -> fn<'static>(i32) -> i32 { return addThree }
fn relay<P: fn<'static>() -> fn<'static>(i32) -> i32>(factory: P) -> i32 {
  let callback = factory()
  return callback(40)
}
fn main() -> i32 { return relay(producerTwo) + relay(producerThree) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"relay")
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&generic, checkedBody)
  let mut deferred = false
  if let Option<Shared<TypedBody>>.Some {value} = move body { deferred = Shared.with<TypedBody, bool>(&value, hasDeferredCallableResult) }
  run Testing.expect(deferred,
    "a generic callable producer retains checked result provenance instead of a raw function pointer contract")
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "both concrete producer applications are admitted")
  let mut at = usize.ZERO
  while at < 2 {
    let mut producerName = b"producerTwo"
    let mut leafName = b"addTwo"
    if at == usize.ONE { producerName = b"producerThree" leafName = b"addThree" }
    let application = namedMirApplicationForProducer(&store, &entry, b"relay", producerName)
    if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
      let closedApplication = run SpecializationApplication.copyShared(&value)
      let selected = run Semantic.demandApplicationMir(&mut store, &mut request, &closedApplication)
      run Testing.expect(succeeded(&selected)
        && originalCallableInvocationCount(&store, &selected, producerName, usize.ZERO) == usize.ONE
        && originalCallableInvocationCount(&store, &selected, leafName, usize.ONE) == usize.ONE,
        "each specialization calls its own original producer and returned leaf directly")
    } else { run Testing.expect(false, "each producer retains its own relay application") }
    at = at + usize.ONE
  }
}

fn hasDeferredCallableResult(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      if Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool { return match &value.* { Type.CallableResult {..} => true _ => false } }) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn higherOrderApplicationProducer(application: &SpecializationApplication, name: &[u8]) -> bool {
  let arguments = Vector.asSlice<Argument>(&application.arguments)
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {value} = &arguments[at] {
      if Shared.with<Type, bool>(&value, fn(ty: &Type) -> bool { return higherOrderProducerType(ty, name) }) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn higherOrderProducerType(value: &Type, name: &[u8]) -> bool {
  return match &value.* {
    Type.CallableValue {application, ..} => Shared.with<SpecializationApplication, bool>(&application,
      fn(selected: &SpecializationApplication) -> bool { return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), name) })
    Type.CallableView {representation, ..} => Shared.with<Type, bool>(&representation,
      fn(nested: &Type) -> bool { return higherOrderProducerType(nested, name) })
    _ => false
  }
}

fn namedMirApplicationForProducer(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: &[u8], producer: &[u8])
  -> Option<Shared<SpecializationApplication>> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: selected} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, selected) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        let identity = InstanceKey.identity(&references[at].key)
        if Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool { return sameBytes(DeclarationId.spelling(value), name) }) {
          if let Option<Shared<SpecializationApplication>>.Some {value} = move InstanceKey.application(&references[at].key) {
            let selected = Shared.with<SpecializationApplication, bool>(&value,
              fn(application: &SpecializationApplication) -> bool { return higherOrderApplicationProducer(application, producer) })
            if selected { return Option.some<Shared<SpecializationApplication>>(move value) }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<SpecializationApplication>>()
}


test effect fn higherOrderCallableReturnsForwardOpenOriginsWithoutUnusedStorageDemands() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run higherOrderCallableForwardClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn higherOrderCallableForwardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("higher-order-callable-forward.silk")
  let text = """
fn add(value: i32) -> i32 { return value + 2 }
fn producer() -> fn<'static>(i32) -> i32 { return add }
fn forward<P: fn<'static>() -> fn<'static>(i32) -> i32>(factory: P) -> fn<'static>(i32) -> i32 { return factory() }
fn chosen<P: fn<'static>() -> fn<'static>(i32) -> i32>(factory: P) -> fn<'static>(i32) -> i32 { drop factory() return add }
fn outer<P: fn<'static>() -> fn<'static>(i32) -> i32>(factory: P) -> i32 { return forward(move factory)(40) }
fn outerChosen<P: fn<'static>() -> fn<'static>(i32) -> i32>(factory: P) -> i32 { return chosen(move factory)(40) }
fn main() -> i32 { return outer(producer) + outerChosen(producer) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let outer = run Semantic.demandBody(&mut store, &mut request, &id, b"outer")
  let chosen = run Semantic.demandBody(&mut store, &mut request, &id, b"outerChosen")
  run Testing.expect(succeeded(&outer) && succeeded(&chosen),
    "open forwarding retains its recipe and an unrelated unused recipe cannot poison a known return origin")
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "closed outer callers resolve original result storage")
  let first = namedMirApplication(&store, &entry, b"outer")
  let second = namedMirApplication(&store, &entry, b"outerChosen")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move first {
    let closedApplication = run SpecializationApplication.copyShared(&value)
    let selected = run Semantic.demandApplicationMir(&mut store, &mut request, &closedApplication)
    run Testing.expect(succeeded(&selected) && originalCallableInvocationCount(&store, &selected, b"add", usize.ONE) == usize.ONE,
      "the forwarded result calls the original add target")
  } else { run Testing.expect(false, "the forwarded outer application is retained") }
  if let Option<Shared<SpecializationApplication>>.Some {value} = move second {
    let closedApplication = run SpecializationApplication.copyShared(&value)
    let selected = run Semantic.demandApplicationMir(&mut store, &mut request, &closedApplication)
    run Testing.expect(succeeded(&selected) && originalCallableInvocationCount(&store, &selected, b"add", usize.ONE) == usize.ONE,
      "known return evidence remains independent of the unused producer invocation")
  } else { run Testing.expect(false, "the chosen outer application is retained") }
}


test effect fn higherOrderCallableSchemaResultsNormalizeBeforeExactInference() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run higherOrderCallableSchemaClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn higherOrderCallableSchemaClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("higher-order-callable-schema.silk")
  let text = """
fn add(value: i32) -> i32 { return value + 2 }
fn different(value: i32) -> i32 { return value + 3 }
fn makerA<T>(unused: T) -> fn<'static>(i32) -> i32 { drop unused return add }
fn makerB<T>(unused: T) -> fn<'static>(i32) -> i32 { drop unused return add }
fn makerOther<T>(unused: T) -> fn<'static>(i32) -> i32 { drop unused return different }
fn same<F: fn<'static>(i32) -> i32>(first: F, second: F) -> i32 { return first(20) + second(18) }
fn main() -> i32 { let a = makerA let b = makerB return same(a(1), b(1)) }
fn invalid() -> i32 { let a = makerA let other = makerOther return same(a(1), other(1)) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "distinct selected schema producers returning add infer one exact original F")
  let common = namedMirApplication(&store, &entry, b"same")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move common {
    let closedApplication = run SpecializationApplication.copyShared(&value)
    let selected = run Semantic.demandApplicationMir(&mut store, &mut request, &closedApplication)
    run Testing.expect(succeeded(&selected) && originalCallableInvocationCount(&store, &selected, b"add", usize.ONE) == 2,
      "both arguments invoke the shared original leaf without a producer-specific adapter")
  } else { run Testing.expect(false, "the common exact consumer application is retained") }
  let invalid = run Semantic.demandBody(&mut store, &mut request, &id, b"invalid")
  run Testing.expect(rejectsSpan(&invalid, RejectionCode.TypeArgumentInference, text, "same(a(1), other(1))", usize.ZERO),
    "equal public promises cannot unify two different original returned leaf targets")
}

test effect fn deferredCallableResultRetainsSelectedLifetimeEvidence() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run deferredCallableLifetimeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn deferredCallableLifetimeClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("callable-result-lifetime.silk")
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"producer")), occurrence: usize.ZERO})
  let owner = DeclarationId.fromParts(run ModuleId.copy(&id), move owners)
  let producer = run specializationRepresentation(&owner)
  let contract = match move run Type.copy(&producer) {
    Type.CallableValue {contract, ..} => move contract
    _ => { run Testing.expect(false, "the actor producer has a callable contract") return () }
  }
  let region = run Shared.make<Lifetime>(Lifetime.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: 3})
  let mut selected = Vector.make<Argument>()
  run Vector.append<Argument>(&mut selected, Argument.Lifetime {value: move region})
  let mut ordinals = Vector.make<usize>()
  run Vector.append<usize>(&mut ordinals, usize.ZERO)
  let recipe = run Shared.make<Type>(Type.CallableResult {producer: move producer, contract: move contract,
    arguments: Vector.make<Shared<Type>>(), selected: move selected, selectedOrdinals: move ordinals})
  let mut types = Vector.make<usize>()
  let mut lifetimes = Vector.make<usize>()
  let mut rows = Vector.make<usize>()
  run Type.collectOwned(&recipe, &owner, &mut types, &mut lifetimes, &mut rows)
  run Testing.expect(Type.hasOpenParameters(&recipe) && Vector.length<usize>(&types) == usize.ZERO
    && Vector.length<usize>(&rows) == usize.ZERO && Vector.length<usize>(&lifetimes) == usize.ONE
    && Vector.get<usize>(&lifetimes, usize.ZERO) == 3,
    "selected-only lifetime evidence remains a free original owner slot")
  let representations = Vector.make<Option<Shared<Type>>>()
  let mut retained = Vector.make<Shared<Lifetime>>()
  let known = run Type.retainedRegions(&recipe, &owner,
    Vector.asSlice<Option<Shared<Type>>>(&representations), &mut retained)
  run Testing.expect(known && Vector.length<Shared<Lifetime>>(&retained) == usize.ZERO,
    "invocation proof evidence does not become a physical captured region")
  let mut substitutions = Vector.make<Binding>()
  run Vector.append<Binding>(&mut substitutions, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: 3, value: Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)}})
  let closed = run Type.applyBindings(&recipe, Vector.asSlice<Binding>(&substitutions), true)
  let copied = run Shared.make<Type>(run Type.copy(&closed))
  let sameCopy = run Type.equalsShared(&closed, &copied)
  let unchanged = run Type.equalsShared(&recipe, &closed)
  run Testing.expect(!Type.hasOpenParameters(&closed) && sameCopy && !unchanged, "copy preserves selected evidence and substitution closes it exactly")
  let mut variables = Vector.make<Shared<DeclarationId>>()
  run Vector.append<Shared<DeclarationId>>(&mut variables, run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)))
  let mut solved = Vector.make<Binding>()
  let unified = run Type.unify(&recipe, &closed, Vector.asSlice<Shared<DeclarationId>>(&variables), Comparison.Exact, &mut solved)
  let success = match &unified { Unification.Unified => true _ => false }
  let applied = run Type.applyBindings(&recipe, Vector.asSlice<Binding>(&solved), true)
  let exact = run Type.equalsShared(&applied, &closed)
  run Testing.expect(success && Vector.length<Binding>(&solved) == usize.ONE && exact,
    "exact unification solves selected lifetime evidence instead of rigidly comparing its shape")
}

