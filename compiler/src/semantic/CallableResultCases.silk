  let id = run module("finite-callable-convergence.silk")
  let text = """
fn leaf(value: i32) -> i32 { return value + 2 }
fn factory() -> fn<'static>(i32) -> i32 { return leaf }
fn pass(callback: fn<'static>(i32) -> i32) -> fn<'static>(i32) -> i32 { return callback }
fn choose(flag: bool) -> fn<'static>(i32) -> i32 {
  if flag { return pass(factory()) }
  return pass(leaf)
}
fn main() -> i32 { return choose(false)(40) }
"""
