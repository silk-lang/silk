    _ => false
  }
  run Testing.expect(leaf,
    "different draft producer arguments converge to one exact application and original leaf")
}

test effect fn finiteCallableOriginsReplayNestedGenericInference() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteCallableNestedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn finiteCallableNestedClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("finite-callable-nested.silk")
  let text = """
struct Box<T> { value: T }
fn leaf(value: i32) -> i32 { return value + 2 }
fn same<T>(first: T, second: T) -> i32 { drop first drop second return 0 }
fn make(depth: i32) -> fn<'static>(i32) -> i32 {
  if depth == 0 { return leaf }
  let ignored = same(Box {value: make(depth - 1)}, Box {value: leaf})
  return leaf
}
fn main() -> i32 { return make(0)(40) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let selected = run Semantic.demandMir(&mut store, &mut request, &id, b"make")
  run Testing.expect(succeeded(&selected), "nested draft evidence is replayed under one exact selected leaf type")
  let consumer = namedMirApplication(&store, &selected, b"same")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move consumer {
    let application = run SpecializationApplication.copyShared(&value)
    let arguments = Vector.asSlice<Argument>(&application.arguments)
    run Testing.expect(arguments.length == usize.ONE, "the generic consumer has one selected source type")
    let exact = match &arguments[usize.ZERO] {
      Argument.Type {value: ty} => !Type.containsCallableOrigin(&ty) && !Type.containsClosedCallableRecipe(&ty)
      _ => false
    }
    run Testing.expect(arguments.length == usize.ONE && exact, "the original generic consumer stores no provisional origin evidence")
  } else { run Testing.expect(false, "the exact generic consumer application is retained") }
}

test effect fn finiteCallableOriginsRejectUnequalLeavesOnReplay() -> ()
