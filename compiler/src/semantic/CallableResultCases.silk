fn leaf(value: i32) -> i32 { return value + 2 }
fn other(value: i32) -> i32 { return value + 3 }
fn same<F: fn<'static>(i32) -> i32>(first: F, second: F) -> i32 { drop first drop second return 0 }
fn make(depth: i32) -> fn<'static>(i32) -> i32 {
