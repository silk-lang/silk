effect fn opaqueUnionProjectedGrowingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-projected-growing-pointer-family.silk")
  let text = """
fn leaf() -> i32 { return 42 }
type Leaf = typeof(leaf)
struct Box<T> { value: T }
struct Node<T, F: fn<'static>() -> i32> { next: &'static Node<Box<T>, F> }
struct Wrap<T> { value: T }
fn forward<F: fn<'static>() -> i32>(value: &'static Node<i32, F>) -> some<G: fn<'static>() -> i32> Wrap<&'static Node<i32, G>> { return Wrap { value: value } }
fn entry(value: &'static Node<i32, Leaf>) -> i32 { drop forward(value) return 42 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"entry")
  run Testing.expect(succeeded(&answer),
    "projected nominal arguments retain finite owner proof for union-free growing descriptor families")
}

