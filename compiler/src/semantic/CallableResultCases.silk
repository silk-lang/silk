  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && originalCallableInvocationCount(&store, &entry, b"add", usize.ONE) == usize.ONE,
    "strict source replay retains both owned-operation transport equations before exact selected leaf agreement")
}


test effect fn opaqueUnionReturnsInjectOriginalPayloadsAfterProof() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueUnionReturnClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionReturnClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-return-payloads.silk")
  let text = """
fn leaf() -> i32 { return 42 }
fn make(flag: bool) -> some<F: fn<'static>() -> i32> F | i32 {
  if flag { return leaf }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"make")
  let result = plainCallableMirResultType(&store, &answer)
  let mut leafTag = usize.MAX
  let mut physical = Option.none<Shared<Type>>()
  if let Option<Shared<Type>>.Some {value: resultType} = move result {
    let ordered = run Type.canonicalUnionMembers(&resultType)
    if let Option<Vector<Shared<Type>>>.Some {value: alternatives} = move ordered {
      let listed = Vector.asSlice<Shared<Type>>(&alternatives)
      let mut at = usize.ZERO
      while at < listed.length {
        if listed.length == 2 && Shared.with<Type, bool>(&listed[at], opaqueUnionOriginalLeaf) { leafTag = at }
        at = at + usize.ONE
      }
      physical = Option.some<Shared<Type>>(move resultType)
    }
  }
  let mut injected = false
  if let Option<Shared<Type>>.Some {value: resultType} = move physical {
    injected = run opaqueUnionInjectionFacts(&store, &answer, &resultType, leafTag)
  }
  run Testing.expect(succeeded(&answer) && leafTag != usize.MAX && injected,
    "owned union returns prove original leaf evidence, then inject named and scalar payloads under their physical tags")
}

effect fn opaqueUnionInjectionFacts(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  result: &Shared<Type>, leafTag: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut count = usize.ZERO
  let mut original = false
  let mut ordinary = false
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Inject {tag, value}, ..} = &statements[position] {
        if destination.local >= locals.length || Vector.length<MirProjection>(&destination.projections) != usize.ZERO
          || !(run Type.equalsShared(&locals[destination.local].ty, result)) { return false }
        count = count + usize.ONE
        if tag == leafTag {
          if let MirOperand.Move {place} = &value {
            if place.local >= locals.length || Vector.length<MirProjection>(&place.projections) != usize.ZERO { return false }
            original = Shared.with<Type, bool>(&locals[place.local].ty, opaqueUnionOriginalLeaf)
          } else { return false }
        } else { ordinary = true }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return count == 2 && original && ordinary
}

test effect fn opaqueUnionRootMatchUsesPhysicalTagAndPayload() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueUnionRootMatchClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionRootMatchClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-root-match.silk")
  let text = """
fn leaf() -> i32 { return 42 }
fn make(flag: bool) -> some<F: fn<'static>() -> i32> F | i32 { if flag { return leaf } return 0 }
fn entry() -> i32 { let value = make(true) return match move value { i32 number => number _ => 42 } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"entry")
  let result = higherOrderCallResultType(&store, &answer, b"make")
  let mut tag = usize.MAX
  let mut payload = Option.none<Shared<Type>>()
  if let Option<Shared<Type>>.Some {value} = move result {
    let ordered = run Type.canonicalUnionMembers(&value)
    if let Option<Vector<Shared<Type>>>.Some {value: alternatives} = move ordered {
      let listed = Vector.asSlice<Shared<Type>>(&alternatives)
      let mut at = usize.ZERO
      while at < listed.length {
        if listed.length == 2 && Shared.with<Type, bool>(&listed[at], opaqueUnionI32) {
          tag = at
          payload = Option.some<Shared<Type>>(Shared.clone<Type>(&listed[at]))
        }
        at = at + usize.ONE
      }
    }
  }
  let mut physical = false
  if let Option<Shared<Type>>.Some {value} = move payload {
    physical = run opaqueUnionMatchFacts(&store, &answer, tag, &value)
  }
  run Testing.expect(succeeded(&answer) && tag != usize.MAX && physical,
    "an opaque root match routes the scalar case and recovered payload through its canonical physical tag")
}
fn opaqueUnionI32(value: &Type) -> bool {
  return match &value.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"i32") _ => false }
}
effect fn opaqueUnionMatchFacts(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  tag: usize, payload: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let decimal = run Type.extentText(tag)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut switched = false
  let mut recovered = false
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Switch {cases, ..} = &blocks[at].terminator {
      let listed = Vector.asSlice<MirSwitchCase>(&cases)
      if listed.length != usize.ONE || listed[usize.ZERO].negative
        || !sameBytes(Bytes.asSlice(&listed[usize.ZERO].decimal), Bytes.asSlice(&decimal)) { return false }
      switched = true
    }
    let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {value: MirRvalue.Use {value}, ..} = &statements[position] {
        let place = match &value {
          MirOperand.Copy {place} => Option.some<&[MirProjection]>(Vector.asSlice<MirProjection>(&place.projections))
          MirOperand.Move {place} => Option.some<&[MirProjection]>(Vector.asSlice<MirProjection>(&place.projections))
          _ => Option.none<&[MirProjection]>()
        }
        if let Option<&[MirProjection]>.Some {value: steps} = move place {
          let mut step = usize.ZERO
          while step < steps.length {
            if let MirProjection.Payload {index: physical, ty} = &steps[step] {
              if physical != tag || !(run Type.equalsShared(&ty, payload)) { return false }
              recovered = true
            }
            step = step + usize.ONE
          }
        }
      }
      position = position + usize.ONE
    }
    at = at + usize.ONE
  }
  return switched && recovered
}

test effect fn opaqueUnionNestedTestUsesPhysicalTagAndPayload() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueUnionNestedTestClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionNestedTestClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-nested-member-test.silk")
  let text = """
struct Wrap<T> { value: T }
struct Marker { value: i32 }
fn leaf() -> i32 { return 42 }
type Leaf = typeof(leaf)
fn inspect<F: fn<'static>() -> i32>(record: Wrap<F | Marker>) -> i32 {
  return match move record { Wrap<F | Marker> { value: Marker { value } } => value _ => 42 }
}
fn entry() -> i32 { let value: Leaf | Marker = Marker { value: 42 } return inspect<Leaf>(Wrap { value: move value }) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"entry")
  let application = match move namedMirApplication(&store, &entry, b"inspect") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { run Testing.expect(false, "the nested member test has its original inspect application") return () }
  }
  let answer = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
  let expected = run opaqueUnionParameterMember(&store, &answer, true, b"Marker")
  let mut physical = false
  if let Option<UnionProjection.Member>.Some {value} = move expected {
    physical = run opaqueUnionMatchFacts(&store, &answer, value.tag, &value.ty)
  }
  run Testing.expect(succeeded(&answer) && physical,
    "a nested structural test and its recovered field use the physical nominal tag after callable substitution")
}

test effect fn opaqueUnionPartialCleanupUsesPhysicalTagAndExactGlue() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueUnionPartialCleanupClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionPartialCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-partial-cleanup.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Pair { first: Token second: Token }
fn consume(value: Token) -> i32 { return value.value }
fn leaf() -> i32 { return 42 }
type Leaf = typeof(leaf)
fn inspect<F: fn<'static>() -> i32>(subject: F | Pair) -> i32 {
  return match move subject { Pair { first, .. } => consume(move first) _ => 0 }
}
fn entry(subject: Leaf | Pair) -> i32 { return inspect<Leaf>(move subject) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"entry")
  let application = match move namedMirApplication(&store, &entry, b"inspect") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { run Testing.expect(false, "partial cleanup retains the original inspect application") return () }
  }
  let answer = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
  let expected = run opaqueUnionParameterMember(&store, &answer, false, b"Pair")
  let identity = run Semantic.demandIdentity(&mut store, &mut request, &id, b"Token")
  let token = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&identity, opaqueUnionResolvedType)
  let mut retained = false
  if let Option<UnionProjection.Member>.Some {value} = move expected {
    if let Option<Shared<Type>>.Some {value: tokenType} = move token {
      retained = run opaqueUnionRemainderFacts(&store, &answer, value.tag, &value.ty, &tokenType)
    }
  }
  run Testing.expect(succeeded(&answer) && retained,
    "moving first leaves exactly second under the physical payload tag and selects its exact Token glue")
}

// Derive expectations from the concrete definition parameter, independently of the ordinal map.
effect fn opaqueUnionParameterMember(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  wrapped: bool, name: &[u8]) -> Option<UnionProjection.Member> ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return Option.none<UnionProjection.Member>() } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return Option.none<UnionProjection.Member>() } }
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let mut ty = Option.none<Shared<Type>>()
  let mut at = usize.ZERO
  while at < locals.length {
    if let MirLocalKind.Parameter {index: ordinal} = &locals[at].kind {
      if ordinal == usize.ZERO { ty = Option.some<Shared<Type>>(Shared.clone<Type>(&locals[at].ty)) }
    }
    at = at + usize.ONE
  }
  let mut subject = match move ty { Option<Shared<Type>>.Some {value} => move value _ => { return Option.none<UnionProjection.Member>() } }
  if wrapped {
    subject = match move run Type.copy(&subject) {
      Type.Nominal {arguments, ..} => match &Vector.asSlice<Argument>(&arguments)[usize.ZERO] {
        Argument.Type {value} => Shared.clone<Type>(&value)
        _ => { return Option.none<UnionProjection.Member>() }
      }
      _ => { return Option.none<UnionProjection.Member>() }
    }
  }
  let canonical = match move run Type.canonicalUnionMembers(&subject) {
    Option<Vector<Shared<Type>>>.Some {value} => move value _ => { return Option.none<UnionProjection.Member>() }
  }
  let listed = Vector.asSlice<Shared<Type>>(&canonical)
  at = usize.ZERO
  while at < listed.length {
    if listed.length == 2 && Shared.with<Type, bool>(&listed[at], fn(value: &Type) -> bool {
      return match &value.* { Type.Nominal {declaration, ..} => DeclarationId.named(&declaration, name) _ => false }
    }) { return Option.some<UnionProjection.Member>(UnionProjection.Member {tag: at, ty: Shared.clone<Type>(&listed[at])}) }
    at = at + usize.ONE
  }
  return Option.none<UnionProjection.Member>()
}

fn opaqueUnionResolvedType(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Type {resolved}} = &value.outcome {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&resolved))
    }
  }
  return Option.none<Shared<Type>>()
}

// Inspect only the selected Pair path; the untouched wildcard arm has a different cleanup owner.
effect fn opaqueUnionRemainderFacts(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  tag: usize, member: &Shared<Type>, token: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  let index = match move selected { Option<usize>.Some {value} => value _ => { return false } }
  let function = match move Semantic.mirAt(store, index) { Option<&MirFunction>.Some {value} => value _ => { return false } }
  let decimal = run Type.extentText(tag)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut current = opaqueUnionSelectedArm(blocks, Bytes.asSlice(&decimal))
  let mut traversed = usize.ZERO
  let mut retained = usize.ZERO
  let mut extracted = usize.ZERO
  let mut called = usize.ZERO
  let mut root = usize.MAX
  let mut first = Vector.make<usize>()
  while current < blocks.length && traversed < blocks.length {
    let statements = Vector.asSlice<MirStatement>(&blocks[current].statements)
    let mut position = usize.ZERO
    while position < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Use {value: operand}, ..} = &statements[position] {
        // Pattern bindings and explicit moves may materialize through Copy temporaries. These
        // preserve byte provenance; only the final consuming call proves the ownership transfer.
        let source = match &operand {
          MirOperand.Copy {place} => Option.some<&MirPlace>(&place)
          MirOperand.Move {place} => Option.some<&MirPlace>(&place)
          _ => Option.none<&MirPlace>()
        }
        if let Option<&MirPlace>.Some {value: place} = move source {
          if Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
            let selectedFirst = run opaqueUnionMemberField(&place.projections, tag, member, usize.ZERO)
            if selectedFirst {
              extracted = extracted + usize.ONE
              root = place.local
              run Vector.append<usize>(&mut first, destination.local)
            } else if Vector.length<MirProjection>(&place.projections) == usize.ZERO
              && opaqueUnionContainsLocal(Vector.asSlice<usize>(&first), place.local) {
              run Vector.append<usize>(&mut first, destination.local)
            }
          }
        }
      }
      if let MirStatement.Drop {destination, glue, ..} = &statements[position] {
        let dropped = match move InstanceKey.glueType(&glue) {
          Option<Shared<Type>>.Some {value} => move value _ => { return false }
        }
        if destination.local != root || !(run opaqueUnionMemberField(&destination.projections, tag, member, usize.ONE))
          || !(run Type.equalsShared(&dropped, token)) { return false }
        retained = retained + usize.ONE
      }
      position = position + usize.ONE
    }
    match &blocks[current].terminator {
      MirTerminator.Goto {target, ..} => { current = target }
      MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, normal, ..} => {
        let identity = InstanceKey.identity(&key)
        if !Shared.with<DeclarationId, bool>(&identity, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"consume") }) { return false }
        let listed = Vector.asSlice<MirOperand>(&arguments)
        if listed.length != usize.ONE { return false }
        if let MirOperand.Move {place} = &listed[usize.ZERO] {
          if run opaqueUnionMemberField(&place.projections, tag, member, usize.ZERO) {
            extracted = extracted + usize.ONE
            root = place.local
          } else if Vector.length<MirProjection>(&place.projections) != usize.ZERO
            || !opaqueUnionContainsLocal(Vector.asSlice<usize>(&first), place.local) { return false }
        } else { return false }
        called = called + usize.ONE
        current = normal
      }
      MirTerminator.Return {..} => { return retained == usize.ONE && extracted == usize.ONE && called == usize.ONE }
      _ => { return false }
    }
    traversed = traversed + usize.ONE
  }
  return false
}

fn opaqueUnionSelectedArm(blocks: &[MirBlock], decimal: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Switch {cases, ..} = &blocks[at].terminator {
      let listed = Vector.asSlice<MirSwitchCase>(&cases)
      let mut position = usize.ZERO
      while position < listed.length {
        if !listed[position].negative && sameBytes(Bytes.asSlice(&listed[position].decimal), decimal) { return listed[position].target }
        position = position + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}
fn opaqueUnionContainsLocal(locals: &[usize], local: usize) -> bool {
  let mut at = usize.ZERO
  while at < locals.length { if locals[at] == local { return true } at = at + usize.ONE }
  return false
}
effect fn opaqueUnionMemberField(projections: &Vector<MirProjection>, tag: usize,
  member: &Shared<Type>, field: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let steps = Vector.asSlice<MirProjection>(projections)
  if steps.length != 2 { return false }
  let payload = match &steps[usize.ZERO] {
    MirProjection.Payload {index: physical, ty} => Option.some<UnionProjection.Member>(
      UnionProjection.Member {tag: physical, ty: Shared.clone<Type>(&ty)})
    _ => Option.none<UnionProjection.Member>()
  }
  let selectedField = match &steps[usize.ONE] { MirProjection.Field {index: fieldIndex} => fieldIndex == field _ => false }
  if let Option<UnionProjection.Member>.Some {value} = move payload {
    return selectedField && value.tag == tag && run Type.equalsShared(&value.ty, member)
  }
  return false
}

// These carried-layout controls contain no tag-bearing operation. They distinguish storage
// proof from the strict original-ordinal checks on injection, matching and payload projection.
test effect fn opaqueUnionStorageAllowsOrdinaryAliasCollapse() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueUnionOrdinaryCollapseClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionOrdinaryCollapseClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-ordinary-alias-collapse.silk")
  let text = """
fn hold<'a, T>(value: &'a (T | i32)) -> i32 { return 42 }
fn entry<'a>(value: &'a i32) -> i32 { return hold<'a, i32>(value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"entry")
  run Testing.expect(succeeded(&answer), "ordinary T=i32 alias collapse precedes carried-union projection proof")
}

