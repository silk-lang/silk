fn forward<P: fn<'static>(i32, i32) -> fn<'static>(i32) -> i32>(p: P) -> fn<'static>(i32) -> i32 {
  let staged = p(2)
  return staged(1)
}
fn outer<P: fn<'static>(i32, i32) -> fn<'static>(i32) -> i32>(p: P) -> i32 { return forward(move p)(40) }
fn main() -> i32 { let produce = factory return outer(produce) }
