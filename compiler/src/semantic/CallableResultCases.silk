fn add(value: i32) -> i32 { return value + 2 }
fn factory() -> fn<'static>(i32) -> i32 { return add }
fn consume(mut cb: mut fn<'static>() -> fn<'static>(i32) -> i32) -> fn<'static>(i32) -> i32 { return cb() }
fn relay(mut cb: mut fn<'static>() -> fn<'static>(i32) -> i32) -> i32 { let out = consume(cb) return out(40) }
