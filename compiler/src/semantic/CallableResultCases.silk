interface Factory { fn make(value: &Self) -> fn<'static>() -> i32 }
struct Marker {}
fn leaf() -> i32 { return 42 }
impl Factory for Marker { fn make(value: &Self) -> fn<'static>() -> i32 { return leaf } }
fn bad<T: Factory, F: fn<'static>() -> i32>(provider: &T, callback: F) -> fn<'static>() -> i32 {
