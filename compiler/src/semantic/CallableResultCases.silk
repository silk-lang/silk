! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueCallableRecordUnionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn opaqueCallableRecordUnionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-callable-record-union-tags.silk")
  let text = """
struct Wrap<T> { value: T }
fn leaf() -> i32 { return 42 }
type Add = typeof(leaf)
fn borrowed<'a>(value: &'a (Add | i32)) -> some<F: fn<'static>() -> i32> Wrap<&'a (F | i32)> {
  return Wrap { value: value }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"borrowed")
  let result = plainCallableMirResultType(&store, &answer)
  let mut preserved = false
  if let Option<Shared<Type>>.Some {value} = move result {
    let field = Shared.with<Type, Option<Shared<Type>>>(&value, opaqueRecordCallback)
    if let Option<Shared<Type>>.Some {value: descriptor} = move field {
      let referent = Shared.with<Type, Option<Shared<Type>>>(&descriptor, fn(ty: &Type) -> Option<Shared<Type>> {
        return match &ty.* { Type.Reference {referent, ..} => Option.some<Shared<Type>>(Shared.clone<Type>(&referent))
          _ => Option.none<Shared<Type>>() }
      })
      if let Option<Shared<Type>>.Some {value: unionType} = move referent {
        let members = run Type.canonicalUnionMembers(&unionType)
        if let Option<Vector<Shared<Type>>>.Some {value: alternatives} = move members {
          let listed = Vector.asSlice<Shared<Type>>(&alternatives)
          let mut at = usize.ZERO
          while at < listed.length {
            if Shared.with<Type, bool>(&listed[at], opaqueUnionOriginalLeaf) { preserved = listed.length == 2 }
            at = at + usize.ONE
          }
        }
      }
    }
  }
  run Testing.expect(succeeded(&answer) && preserved,
    "an existing descriptor union keeps two physical members and the original callable leaf after opaque record realization")
}


fn opaqueUnionOriginalLeaf(ty: &Type) -> bool {
  if let Type.CallableValue {application, captures, ..} = &ty.* {
    if Vector.length<Shared<Type>>(&captures) != usize.ZERO { return false }
    return Shared.with<SpecializationApplication, bool>(&application, fn(value: &SpecializationApplication) -> bool {
      return DeclarationId.named(SpecializationApplication.bodyDeclaration(value), b"leaf")
    })
  }
  return false
}

test effect fn opaqueUnionSourceOrdinalsMapToCompletePhysicalMembers() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueUnionMapClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn opaqueUnionMapClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-union-source-map.silk")
  let mut owners = Vector.make<OwnerStep>()
  run Vector.append<OwnerStep>(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option.some<Bytes>(run Bytes.copy(b"map")), occurrence: usize.ZERO})
  let owner = run DeclarationId.fromParts(run ModuleId.copy(&id), move owners)
  let parameter = run Shared.make<Type>(Type.Parameter {declaration: run DeclarationId.copy(&owner), ordinal: usize.ZERO})
  let first = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"i32")})
  let second = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"u32")})
  let mut members = Vector.make<Shared<Type>>()
  run Vector.append<Shared<Type>>(&mut members, Shared.clone<Type>(&parameter))
  run Vector.append<Shared<Type>>(&mut members, Shared.clone<Type>(&first))
  let source = run Shared.make<Type>(Type.Union {members: move members})
  let mut bindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut bindings, Binding {declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)),
    ordinal: usize.ZERO, value: Argument.Type {value: Shared.clone<Type>(&second)}})
  let projections = Vector.make<RuntimeProjection>()
  let mapped = run UnionProjection.map(&source, Vector.asSlice<Binding>(&bindings), Vector.asSlice<RuntimeProjection>(&projections))
  let mut reordered = false
  if let Option<Vector<UnionProjection.Member>>.Some {value} = move mapped {
    let listed = Vector.asSlice<UnionProjection.Member>(&value)
    if listed.length == 2 {
      reordered = listed[usize.ZERO].tag == usize.ONE && listed[usize.ONE].tag == usize.ZERO
        && (run Type.equalsShared(&listed[usize.ZERO].ty, &second)) && (run Type.equalsShared(&listed[usize.ONE].ty, &first))
    }
  }
  run Testing.expect(reordered, "authored source ordinals map onto their actual reordered canonical payload types")
  let mut collisionBindings = Vector.make<Binding>()
  run Vector.append<Binding>(&mut collisionBindings, Binding {
    declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(&owner)), ordinal: usize.ZERO,
    value: Argument.Type {value: Shared.clone<Type>(&first)}})
  let collapsed = run UnionProjection.map(&source, Vector.asSlice<Binding>(&collisionBindings), Vector.asSlice<RuntimeProjection>(&projections))
  run Testing.expect(match move collapsed { Option<Vector<UnionProjection.Member>>.None => true _ => false },
    "equal physical members cannot collapse the complete source union map")
}

test effect fn interfaceCallableResultsKeepSelectedOriginalTargets() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run interfaceCallableTargetClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn interfaceCallableTargetClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("interface-callable-targets.silk")
  let text = """
interface Factory { fn make(value: Self) -> fn<'static>(i32) -> i32 }
struct Marker {}
struct Other {}
fn add(value: i32) -> i32 { return value + 2 }
fn other(value: i32) -> i32 { return value + 3 }
impl Factory for Marker { fn make(value: Self) -> fn<'static>(i32) -> i32 { return add } }
impl Factory for Other { fn make(value: Self) -> fn<'static>(i32) -> i32 { return other } }
fn through<T: Factory>(provider: T) -> fn<'static>(i32) -> i32 { return Factory.make(move provider) }
fn main() -> i32 { return through(Marker {})(20) + through(Other {})(17) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry)
    && originalCallableInvocationCount(&store, &entry, b"add", usize.ONE) == usize.ONE
    && originalCallableInvocationCount(&store, &entry, b"other", usize.ONE) == usize.ONE,
    "each selected provider reveals its own original direct leaf rather than one public signature target")
  let selected = match move namedMirApplication(&store, &entry, b"through") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { run Testing.expect(false, "the selected producer retains its application") return () }
  }
  let producer = run Semantic.demandApplicationMir(&mut store, &mut request, &selected)
  let result = plainCallableMirResultType(&store, &producer)
  run Testing.expect(succeeded(&producer) && originalCallableInvocationCount(&store, &producer, b"make", usize.ONE) == usize.ONE,
    "the producer invokes the original witnessed implementation directly")
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(!Type.containsCallableWitness(&value) && !Type.containsCallableOrigin(&value)
      && Shared.with<Type, bool>(&value, interfaceCallableOriginalLeaf),
      "only the exact zero-capture leaf environment reaches result storage")
  } else { run Testing.expect(false, "the selected producer has concrete result storage") }
  let symbolic = run Semantic.demandBody(&mut store, &mut request, &id, b"through")
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&symbolic, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    run Testing.expect(Shared.with<TypedBody, bool>(&value, interfaceCallableBodyRecipe),
      "the authored generic body retains its operation selection until provider substitution")
  } else { run Testing.expect(false, "the authored generic producer is checked") }
}
fn interfaceCallableOriginalLeaf(value: &Type) -> bool {
  if let Type.CallableValue {application, captures, ..} = &value.* {
    if Vector.length<Shared<Type>>(&captures) != usize.ZERO { return false }
    return Shared.with<SpecializationApplication, bool>(&application, interfaceCallableLeafTarget)
  }
  return false
}
fn interfaceCallableLeafTarget(value: &SpecializationApplication) -> bool {
  let declaration = SpecializationApplication.bodyDeclaration(value)
  return DeclarationId.named(declaration, b"add") || DeclarationId.named(declaration, b"other")
}
fn interfaceCallableBodyRecipe(value: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(value)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind { if Type.containsCallableWitness(&ty) { return true } }
    at = at + usize.ONE
  }
  return false
}

