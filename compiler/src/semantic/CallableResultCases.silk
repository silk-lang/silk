effect fn finiteCallableSourceRejection() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("finite-callable-source-rejection.silk")
  let text = """
fn leaf() -> i32 { return 42 }
fn factory() -> fn<'static>() -> i32 { return leaf }
fn bad<F: fn<'static>() -> i32>(callback: F) -> fn<'static>() -> i32 {
  let substituted: F = factory()
  return callback
}
fn main() -> i32 { return bad(leaf)() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  run Testing.expect(rejectsSpan(&entry, RejectionCode.TypeMismatch, text, "factory()", usize.ONE),
    "selecting F as leaf cannot validate an assignment that is invalid for arbitrary authored F")
}

fn higherOrderSourceCallType(answer: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> Option<Shared<Type>> {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, Option<Shared<Type>>>(&value, fn(body: &TypedBody) -> Option<Shared<Type>> {
      let nodes = TypedBody.nodeSlice(body)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form: BodyExpression.DirectCall {declaration, ..}} = &nodes[at].kind {
          if DeclarationId.named(&declaration, name) { return Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) }
        }
        at = at + usize.ONE
      }
      return Option.none<Shared<Type>>()
    })
  }
  return Option.none<Shared<Type>>()
}

fn higherOrderPublicOnce(value: &Type) -> bool {
  return match &value.* {
    Type.Callable {mode, ..} => mode == CallableMode.Once
    Type.CallableView {contract, ..} => Shared.with<Type, bool>(&contract, higherOrderPublicOnce)
    Type.CallableValue {contract, ..} => Shared.with<Type, bool>(&contract, higherOrderPublicOnce)
    Type.CallableSchema {schema, ..} => Shared.with<SectionSchema, bool>(&schema,
      fn(value: &SectionSchema) -> bool { return Shared.with<Type, bool>(&value.contract, higherOrderPublicOnce) })
    _ => false
  }
}

fn higherOrderSourceConsumerType(answer: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> Option<Shared<Type>> {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, Option<Shared<Type>>>(&value, fn(body: &TypedBody) -> Option<Shared<Type>> {
      let nodes = TypedBody.nodeSlice(body)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, application, arguments, ..}, ..} = &nodes[at].kind {
          if DeclarationId.named(&declaration, name) && Vector.length<BodyNodeId>(&arguments) == 2 {
            return Shared.with<SpecializationApplication, Option<Shared<Type>>>(&application,
              higherOrderFirstTypeArgument)
          }
        }
        at = at + usize.ONE
      }
      return Option.none<Shared<Type>>()
    })
  }
  return Option.none<Shared<Type>>()
}

fn higherOrderFirstTypeArgument(value: &SpecializationApplication) -> Option<Shared<Type>> {
  return SpecializationApplication.typeAt(value, usize.ZERO)
}

fn higherOrderSourceNestedCapture(value: &Type) -> Option<Shared<Type>> {
  if let Type.CallableView {representation, ..} = &value.* {
    return Shared.with<Type, Option<Shared<Type>>>(&representation, higherOrderSourceNestedCapture)
  }
  return higherOrderNestedCapture(value)
}

fn higherOrderSourceStageCapture(value: &Type) -> bool {
  if let Type.CallableView {representation, ..} = &value.* {
    return Shared.with<Type, bool>(&representation, higherOrderSourceStageCapture)
  }
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let original = Shared.with<SectionSchema, bool>(&schema, higherOrderBinarySchema)
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let inputs = Vector.asSlice<CallableFieldInput>(&fieldInputs)
    if !original || fields.length != usize.ONE || inputs.length != usize.ONE { return false }
    if let CallableFieldInput.Argument {parameter} = &inputs[usize.ZERO] {
      return parameter == usize.ONE && Shared.with<Type, bool>(&fields[usize.ZERO],
        fn(value: &Type) -> bool {
          if let Type.Primitive {name} = &value.* { return sameBytes(Bytes.asSlice(&name), b"i32") }
          return false
        })
    }
  }
  return false
}

fn higherOrderBinarySchema(value: &SectionSchema) -> bool {
  return Shared.with<DeclarationId, bool>(&value.target, higherOrderBinaryDeclaration)
}

fn higherOrderBinaryDeclaration(value: &DeclarationId) -> bool {
  return DeclarationId.named(value, b"binary")
}

// Inspect the actual destination of an original direct call, without demanding a second body.
fn higherOrderCallResultType(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8]) -> Option<Shared<Type>> {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, destination, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, target) })
          if named && Vector.length<MirProjection>(&destination.projections) == usize.ZERO {
            return Option.some<Shared<Type>>(Shared.clone<Type>(&locals[destination.local].ty))
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return Option.none<Shared<Type>>()
}

test effect fn opaqueCallableRecordsProjectOriginalFieldEnvironments() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run opaqueCallableRecordClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn opaqueCallableRecordClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("opaque-callable-records.silk")
  let text = """
struct Wrap<T: fn<'static>(i32) -> i32> { callback: T }
fn add(value: i32) -> i32 { return value + 2 }
fn named() -> some<F: fn<'static>(i32) -> i32> Wrap<F> { return Wrap { callback: add } }
fn literal() -> some<F: fn<'static>(i32) -> i32> Wrap<F> {
  return Wrap { callback: fn(value: i32) -> i32 { return value + 3 } }
}
fn forwarded() -> some<F: fn<'static>(i32) -> i32> Wrap<F> {
  let stored = named()
  return move stored
}
fn main() -> i32 {
  let first = named()
  let second = literal()
  let third = forwarded()
  return first.callback(10) + second.callback(10) + third.callback(15)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && originalCallableInvocationCount(&store, &entry, b"add", usize.ONE) == 2,
    "opaque record fields call their original named environment after ordinary field projection")
  let mut at = usize.ZERO
  while at < 3 {
    let mut name = b"named"
    if at == usize.ONE { name = b"literal" }
    if at == 2 { name = b"forwarded" }
    let found = namedMirApplication(&store, &entry, name)
    let application = match move found {
      Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
      _ => { run Testing.expect(false, "each record producer retains its original application") return () }
    }
    let answer = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    let result = plainCallableMirResultType(&store, &answer)
    let mut originalField = false
    if let Option<Shared<Type>>.Some {value} = move result {
      let field = Shared.with<Type, Option<Shared<Type>>>(&value, opaqueRecordCallback)
      if let Option<Shared<Type>>.Some {value: callback} = move field {
        originalField = Shared.with<Type, bool>(&callback, fn(ty: &Type) -> bool {
          return opaqueRecordOriginalField(ty, at)
        })
      }
    }
    run Testing.expect(succeeded(&answer) && originalField,
      "public opaque record slots project to exact original named or anonymous field storage")
    at = at + usize.ONE
  }
}

test effect fn storedCallableFieldsShareInvocationAndPipelineChecking() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
