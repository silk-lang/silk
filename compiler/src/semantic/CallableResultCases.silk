test effect fn higherOrderAffineArgumentsAndOnceResultsHaveOneCleanupOwner() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run higherOrderAffineResultClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn higherOrderAffineResultClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("higher-order-affine-result.silk")
  let text = """
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn consume(amount: i32, token: Token) -> i32 { drop token return amount }
fn factory(token: Token) -> once fn<'static>(i32) -> i32 { return consume(move token) }
fn relay<P: once fn<'static>(Token) -> once fn<'static>(i32) -> i32>(p: P, token: Token) -> i32 {
  let operation = p(move token)
  return operation(42)
}
fn abandon<P: once fn<'static>(Token) -> once fn<'static>(i32) -> i32>(p: P, token: Token) -> i32 {
  let unused = p(move token)
  return 42
}
fn main() -> i32 { return relay(factory, Token { value: 42 }) + abandon(factory, Token { value: 42 }) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"factory")
  let invoked = namedMirApplication(&store, &entry, b"relay")
  let unused = namedMirApplication(&store, &entry, b"abandon")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move invoked {
    let application = run SpecializationApplication.copyShared(&value)
    let relay = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&relay) && originalCallableInvocationCount(&store, &relay, b"factory", usize.ONE) == usize.ONE
      && higherOrderMovesOriginalParameter(&store, &relay, b"factory", usize.ONE)
      && sectionInvocationCount(&store, &relay, b"consume", true) == usize.ONE
      && glueFact(&store, &relay, usize.ZERO) == usize.ZERO,
      "an affine producer argument and its returned Once capture transfer to their original direct targets")
  } else { run Testing.expect(false, "the invoking relay retains its original selected application") }
  if let Option<Shared<SpecializationApplication>>.Some {value} = move unused {
    let application = run SpecializationApplication.copyShared(&value)
    let abandoned = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    let environment = plainCallableMirResultType(&store, &producer)
    let mut exactDrop = false
    if let Option<Shared<Type>>.Some {value: returned} = move environment {
      exactDrop = run higherOrderAbandonDropUsesEnvironment(&store, &abandoned, &returned)
    }
    run Testing.expect(succeeded(&abandoned) && higherOrderMovesOriginalParameter(&store, &abandoned, b"factory", usize.ONE)
      && glueFact(&store, &abandoned, usize.ZERO) == usize.ONE && exactDrop,
      "abandonment drops the returned environment once after moving the original Token argument")
  } else { run Testing.expect(false, "the abandoning relay retains its original selected application") }
  let target = run Semantic.demandMir(&mut store, &mut request, &id, b"consume")
  run Testing.expect(succeeded(&producer) && succeeded(&target) && glueFact(&store, &producer, usize.ZERO) == usize.ZERO
    && glueFact(&store, &target, usize.ZERO) == usize.ONE,
    "the factory transfers cleanup and the invoked original target drops its Token once")
  let environment = plainCallableMirResultType(&store, &producer)
  if let Option<Shared<Type>>.Some {value} = move environment {
    let owner = run resultGlueSourceOwner(&store, &producer, &id, b"factory")
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &value, &owner)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ONE,
      "the abandoned returned environment's exact glue drops its one capture")
  } else { run Testing.expect(false, "the original factory retains exact returned capture storage") }
}

fn higherOrderMovesOriginalParameter(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], parameter: usize) -> bool {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let named = Shared.with<DeclarationId, bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, target) })
          let operands = Vector.asSlice<MirOperand>(&arguments)
          if named && operands.length == usize.ONE {
            if let MirOperand.Move {place} = &operands[usize.ZERO] {
              if Vector.length<MirProjection>(&place.projections) != usize.ZERO { return false }
              return higherOrderTemporaryParameter(function, at, place.local, parameter)
            }
            return false
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// Follow only preceding, unprojected Use assignments through fresh MIR temporaries.
// The final call operand must still be Move, and cleanup assertions prove transfer.
fn higherOrderTemporaryParameter(function: &MirFunction, before: usize, local: usize, parameter: usize) -> bool {
  let locals = Vector.asSlice<MirLocal>(&function.locals)
  let blocks = Vector.asSlice<MirBlock>(&function.blocks)
  let mut current = local
  let mut block = before
  let mut statement = Vector.length<MirStatement>(&blocks[block].statements)
  let mut remaining = locals.length
  while remaining != usize.ZERO && current < locals.length {
    if let MirLocalKind.Parameter {index} = &locals[current].kind { return index == parameter }
    let temporary = match &locals[current].kind { MirLocalKind.Temp => true _ => false }
    if !temporary { return false }
    let mut found = false
    while !found {
      if statement == usize.ZERO {
        if block == usize.ZERO { return false }
        block = block - usize.ONE
        statement = Vector.length<MirStatement>(&blocks[block].statements)
      } else {
        statement = statement - usize.ONE
        let statements = Vector.asSlice<MirStatement>(&blocks[block].statements)
        if let MirStatement.Assign {destination, value, ..} = &statements[statement] {
          if destination.local == current {
            if Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
            if let MirRvalue.Use {value: operand} = &value {
              let whole = match &operand {
                MirOperand.Copy {place} => Vector.length<MirProjection>(&place.projections) == usize.ZERO
                MirOperand.Move {place} => Vector.length<MirProjection>(&place.projections) == usize.ZERO
                _ => false
              }
              if !whole { return false }
              let next = match &operand {
                MirOperand.Copy {place} => place.local
                MirOperand.Move {place} => place.local
                _ => { return false }
              }
              current = next
              found = true
            } else { return false }
          }
        }
      }
    }
    remaining = remaining - usize.ONE
  }
  return false
}

test effect fn higherOrderNestedCaptureOriginsNormalizeOriginalApplicationChannels() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run higherOrderNestedOriginClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn higherOrderNestedOriginClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("higher-order-nested-origin.silk")
  let text = """
fn add(value: i32) -> i32 { return value + 2 }
fn factory() -> fn<'static>(i32) -> i32 { return add }
fn wrap(callback: fn<'static>(i32) -> i32) -> fn<'static>(i32) -> i32 {
  return fn(value: i32) -> i32 { let held = move callback return held(value) }
}
fn via<P: fn<'static>() -> fn<'static>(i32) -> i32>(producer: P) -> fn<'static>(i32) -> i32 { return wrap(producer()) }
fn same<F: fn<'static>(i32) -> i32>(first: F, second: F) -> i32 { return first(20) + second(18) }
fn main() -> i32 { return same(via(factory), wrap(factory())) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let selected = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&selected),
    "exact F inference agrees on the direct and higher-order original nested environment")
  let result = higherOrderCallResultType(&store, &selected, b"via")
  let direct = higherOrderCallResultType(&store, &selected, b"wrap")
  if let Option<Shared<Type>>.Some {value: first} = &result {
    if let Option<Shared<Type>>.Some {value: second} = &direct {
      run Testing.expect(run Type.equalsShared(&first, &second),
        "both constructed results retain one exact original anonymous application and capture")
    } else { run Testing.expect(false, "the direct wrapper result has exact storage") }
  }
  let leaf = higherOrderCallResultType(&store, &selected, b"factory")
  if let Option<Shared<Type>>.Some {value: environment} = move result {
    if let Option<Shared<Type>>.Some {value: originalLeaf} = move leaf {
      let capture = Shared.with<Type, Option<Shared<Type>>>(&environment, higherOrderNestedCapture)
      if let Option<Shared<Type>>.Some {value: captured} = move capture {
        run Testing.expect(run Type.equalsShared(&captured, &originalLeaf),
          "the canonical returned closure captures the original add environment rather than a producer recipe")
        return ()
      }
    }
  }
  run Testing.expect(false, "the selected common result retains one original anonymous captured environment")
}

fn higherOrderNestedCapture(value: &Type) -> Option<Shared<Type>> {
  if let Type.CallableValue {captures, application, ..} = &value.* {
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    let anonymous = Shared.with<SpecializationApplication, bool>(&application, higherOrderNestedAnonymous)
    if anonymous && fields.length == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[usize.ZERO])) }
  }
  return Option.none<Shared<Type>>()
}

fn higherOrderNestedAnonymous(selected: &SpecializationApplication) -> bool {
  return DeclarationId.kind(SpecializationApplication.bodyDeclaration(selected)) == OwnerKind.Anonymous
}

effect fn higherOrderAbandonDropUsesEnvironment(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  environment: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let locals = Vector.asSlice<MirLocal>(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[at].statements)
        let mut item = usize.ZERO
        while item < statements.length {
          if let MirStatement.Drop {destination, glue, ..} = &statements[item] {
            if Vector.length<MirProjection>(&destination.projections) != usize.ZERO { return false }
            let exact = run Type.equalsShared(&locals[destination.local].ty, environment)
            let dropped = InstanceKey.glueType(&glue)
            if let Option<Shared<Type>>.Some {value: captureStorage} = move dropped {
              let sameGlue = run Type.equalsShared(&captureStorage, environment)
              return exact && sameGlue
            }
            return false
          }
          item = item + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn higherOrderStagedSuffixRecipesNormalizeBeforeSchemaSelection() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run higherOrderStagedSuffixClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn higherOrderStagedSuffixClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("higher-order-staged-suffix.silk")
  let text = """
fn add(value: i32) -> i32 { return value + 2 }
fn other(value: i32) -> i32 { return value + 3 }
fn factory() -> fn<'static>(i32) -> i32 { return add }
fn invoke(value: i32, callback: fn<'static>(i32) -> i32) -> i32 { return callback(value) }
fn stage<P: fn<'static>(i32, fn<'static>(i32) -> i32) -> i32, Q: fn<'static>() -> fn<'static>(i32) -> i32>(p: P, q: Q) -> fn<'static>(i32) -> i32 { return p(q()) }
fn choose(flag: bool) -> fn<'static>(i32) -> i32 { if flag { return stage(invoke, factory) } return invoke(add) }
fn same<F: fn<'static>(i32) -> i32>(first: F, second: F) -> i32 { return first(20) + second(18) }
fn invalidSuffix() -> i32 { return same(choose(false), invoke(other)) }
fn main() -> i32 { return choose(false)(20) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let factory = run Semantic.demandBody(&mut store, &mut request, &id, b"factory")
  run Testing.expect(succeeded(&entry) && succeeded(&factory),
    "staged and direct suffix construction agree on one original exact schema")
  run Testing.expect(succeeded(&entry)
    && originalCallableInvocationCount(&store, &entry, b"invoke", 2) == usize.ONE,
    "the canonical returned section calls the original invoke target with its supplied suffix")
  let different = run Semantic.demandBody(&mut store, &mut request, &id, b"invalidSuffix")
  run Testing.expect(rejectsSpan(&different, RejectionCode.TypeArgumentInference, text,
    "same(choose(false), invoke(other))", usize.ZERO),
    "completed stages retain exact callback identity instead of unifying equal public contracts")
  let environment = higherOrderCallResultType(&store, &entry, b"choose")
  let leaf = higherOrderSourceReturnType(&factory)
  if let Option<Shared<Type>>.Some {value: staged} = move environment {
    if let Option<Shared<Type>>.Some {value: original} = move leaf {
      let capture = Shared.with<Type, Option<Shared<Type>>>(&staged, higherOrderStagedSuffixCapture)
      if let Option<Shared<Type>>.Some {value: selected} = move capture {
        let projections = Vector.make<RuntimeProjection>()
        let originalStorage = run RuntimeType.project(&original, Vector.asSlice<RuntimeProjection>(&projections))
        run Testing.expect(run Type.equalsShared(&selected, &originalStorage),
          "schema inference stores the original add environment after normalizing the suffix result recipe")
        return ()
      }
    }
  }
  run Testing.expect(false, "the canonical staged schema retains its original target and one captured suffix")
}

// A source-return identity oracle does not need a second feature-local MIR pipeline.
fn higherOrderSourceReturnType(answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    return Shared.with<TypedBody, Option<Shared<Type>>>(&value, fn(selected: &TypedBody) -> Option<Shared<Type>> {
      let index = higherOrderSourceReturnIndex(selected)
      let nodes = TypedBody.nodeSlice(selected)
      if index < nodes.length {
        if let BodyNodeKind.Expression {ty, ..} = &nodes[index].kind { return Option.some<Shared<Type>>(Shared.clone<Type>(&ty)) }
      }
      return Option.none<Shared<Type>>()
    })
  }
  return Option.none<Shared<Type>>()
}
fn higherOrderSourceReturnIndex(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut selected = usize.MAX
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Return {value} = &nodes[at].kind {
      if let Option<BodyNodeId>.Some {value: returned} = &value {
        if selected != usize.MAX { return usize.MAX }
        selected = returned.index
      }
    }
    at = at + usize.ONE
  }
  return selected
}

fn higherOrderStagedSuffixCapture(value: &Type) -> Option<Shared<Type>> {
  if let Type.CallableValue {application, captures, ..} = &value.* {
    let original = Shared.with<SpecializationApplication, bool>(&application,
      fn(selected: &SpecializationApplication) -> bool { return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), b"invoke") })
    let fields = Vector.asSlice<Shared<Type>>(&captures)
    if original && fields.length == usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&fields[usize.ZERO])) }
  }
  return Option.none<Shared<Type>>()
}




test effect fn higherOrderStagedResultsPreservePublicOnceViews() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run higherOrderStagedOnceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn higherOrderStagedOnceClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("higher-order-staged-once.silk")
  let text = """
fn binary<T>(first: T, last: i32) -> i32 { drop first return last }
fn factory() -> once fn<'static>(i32, i32) -> i32 { return binary }
fn wrap(callback: once fn<'static>(i32) -> i32) -> once fn<'static>(i32) -> i32 {
  return fn(value: i32) -> i32 { return callback(value) }
}
fn via<P: fn<'static>() -> once fn<'static>(i32, i32) -> i32>(p: P) -> once fn<'static>(i32) -> i32 {
  return wrap(p()(2))
}
fn same<F: once fn<'static>(i32) -> i32>(first: F, second: F) -> i32 { return first(42) + second(0) }
fn main() -> i32 { return same(via(factory), wrap(factory()(2))) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let selected = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&selected),
    "exact F inference preserves public Once permission across direct and higher-order staged results")
  let result = higherOrderSourceCallType(&selected, b"via")
  let direct = higherOrderSourceCallType(&selected, b"wrap")
  if let Option<Shared<Type>>.Some {value: first} = &result {
    if let Option<Shared<Type>>.Some {value: second} = &direct {
      run Testing.expect(run Type.equalsShared(&first, &second),
        "both Once constructions retain the same original application and staged capture storage")
      let inferred = higherOrderSourceConsumerType(&selected, b"same")
      if let Option<Shared<Type>>.Some {value} = move inferred {
        let firstMatches = run Type.equalsShared(&first, &value)
        let secondMatches = run Type.equalsShared(&second, &value)
        run Testing.expect(firstMatches && secondMatches,
          "both independently recorded operands agree with the consumer's selected exact F")
      } else { run Testing.expect(false, "the exact-F consumer records its selected type argument") }
      run Testing.expect(Shared.with<Type, bool>(&first, higherOrderPublicOnce)
        && Shared.with<Type, bool>(&second, higherOrderPublicOnce),
        "both source paths preserve the public Once permission before storage projection")
    } else { run Testing.expect(false, "the direct Once wrapper has exact storage") }
  }
  if let Option<Shared<Type>>.Some {value: environment} = move result {
    let capture = Shared.with<Type, Option<Shared<Type>>>(&environment, higherOrderSourceNestedCapture)
    let mut exactCapture = false
    if let Option<Shared<Type>>.Some {value} = move capture {
      exactCapture = Shared.with<Type, bool>(&value, higherOrderPublicOnce)
        && Shared.with<Type, bool>(&value, higherOrderSourceStageCapture)
    }
    run Testing.expect(exactCapture,
      "the common origin captures the original binary schema, supplied trailing argument and public Once permission")
    return ()
  }
  run Testing.expect(false, "the selected Once result has exact original environment storage")
}

// A seeded recursive graph must publish the original leaf, with no draft forward reaching MIR.
test effect fn finiteCallableOriginsSeedMutualAndSelfCalls() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteCallableSeedClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
effect fn finiteCallableSeedClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let id = run module("finite-callable-seeds.silk")
  let text = """
fn leaf(value: i32) -> i32 { return value + 2 }
fn left(depth: i32) -> fn<'static>(i32) -> i32 {
  if depth == 0 { return leaf }
  if depth == 1 { return left(0) }
  return right(depth - 1)
}
fn right(depth: i32) -> fn<'static>(i32) -> i32 { return left(depth) }
fn main() -> i32 { return right(2)(40) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry)
    && originalCallableInvocationCount(&store, &entry, b"right", usize.ONE) == usize.ONE
    && originalCallableInvocationCount(&store, &entry, b"leaf", usize.ONE) == usize.ONE,
    "self and mutual forwarding close to the original direct leaf target")
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"left")
  let result = plainCallableMirResultType(&store, &producer)
  if let Option<Shared<Type>>.Some {value} = move result {
    run Testing.expect(finiteCallableLeaf(&value) && !Type.containsCallableOrigin(&value)
      && !Type.containsClosedCallableRecipe(&value), "only the exact original leaf environment reaches MIR")
  } else { run Testing.expect(false, "the recursive producer has retained result storage") }
}
fn finiteCallableLeaf(value: &Shared<Type>) -> bool {
  return Shared.with<Type, bool>(value, finiteCallableLeafNode)
}
fn finiteCallableLeafNode(node: &Type) -> bool {
  if let Type.CallableValue {application, captures, ..} = &node.* {
    return Vector.length<Shared<Type>>(&captures) == usize.ZERO && Shared.with<SpecializationApplication, bool>(&application, finiteCallableLeafTarget)
  }
  return false
}
fn finiteCallableLeafTarget(selected: &SpecializationApplication) -> bool {
  return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), b"leaf")
}

